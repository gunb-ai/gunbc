module gunbc.spark.v41_engram_row_store

import std.types { String, Bool, List, NonEmptyStr, Int, Map }
import std.nat { Nat }
import std.integer { UInt8, qualified_octet_members }
import extdeps.numeric.base16 { base16_decode_lower }
import std.bytes { bytes_octets, utf8_encode_bytes }
import std.decl_ref { DeclarationRef, declaration_ref_display_key }
import std.content_hash { ContentHash, Sha256Hash, Sha256Digest, Sha256DigestHex, sha256_hex_digest, serialize_content_hash }
import std.artifact_store { ArtifactRealizationInput, artifact_realization_digest }
import std.measure { ByteSize, byte_size, byte_size_count, measure_add }
import v2.std.optional { Present, Absent }
import extdeps.safetensors.format {
  SafetensorsEntry, SafetensorsDtype,
  safetensors_dtype_byte_width, safetensors_dtype_token,
  SafetensorsShardedEntry, SafetensorsShardFile, safetensors_entry_span, safetensors_shard_declared_overhead,
  ShardBoundsResolved, ShardBoundsDuplicated, ShardBoundsAbsent, safetensors_shard_bounds_resolution,
}
import extdeps.toolchain.architecture_profile { Endianness, LittleEndian, endianness_token }
import extdeps.vllm.engram_layout { VllmEngramRankRows, vllm_engram_head_sizes, vllm_engram_rank_rows, vllm_engram_sum, vllm_engram_every_rank_has_heads, vllm_engram_count_up }
import extdeps.deepseek.deepseek_v4_1_flash { DeepseekV41EngramTables, deepseek_v4_1_flash_engram }
import gunbc.spark.v41_identity_input { V41EngramResidencyPartition, v41_input }
import gunbc.fabric.engram_materialization { engram_component_identity }

// ── A RANK-LOCAL ENGRAM ROW STORE, AS ITS CONSUMER READS IT ────────────────────────────────────
//
// THE CONSUMER CONTRACT, and every choice below answers to it rather than to taste:
//
//   dag/gunbc/spark/patches/d2d649e6/engram_file_backed.py.patch  FileBackedEngramStorage
//     - opens ONE path per instance, checks the SHA-256 OF THE WHOLE FILE against rank_digest_hex,
//       then checks the file begins with expected.magic;
//     - fetch_rows(offsets, nbytes) copies nbytes contiguous bytes from each offset into one staging
//       row, so a row's weight and scale are ONE contiguous record.
//   vllm d2d649e6 vllm/models/deepseek_v4_1/nvidia/engram.py   Engram._create_embedding
//     - one ParallelEngramEmbedding per Engram LAYER, so a store is per (layer, rank).
//   vllm d2d649e6 vllm/models/deepseek_v4_1/common/engram.py   BaseParallelEngramEmbedding
//     - rank k holds the CONTIGUOUS bucket rows [vocab_start, vocab_end) of its hash heads, and the
//       lookup indexes local = row - vocab_start (extdeps.vllm.engram_layout derives the ranges).
//
// So a store is: v41_row_store_magic, then for local row 0, 1, 2, ... of that rank's range the
// record weight_row || scale_row, packed with no padding. Its identity is the SHA-256 of exactly
// those bytes -- the check open() performs -- carried as std.content_hash Sha256Hash.
//
// WHAT THIS REPLACED (2026-09-22). The first model interleaved rows by global_row % rank_count,
// placed each TENSOR's row as its own record at the full record stride, put both layers in one
// store, carried payloads as strings and keyed a rank by an FNV-1a structural hash of that string.
// Every one of those disagreed with the consumer above: a row-%-4 store serves the wrong rows at
// token time, a per-tensor record is not what fetch_rows reads, and no file's SHA-256 can equal an
// FNV of a string. The FNV rank digest is deleted, not kept beside the new one.
//
// THE PATH EACH STORE IS OPENED AT is decided by its consumer, not here: this module keys stores by
// (layer, rank), and gunbc.spark.v41_engram_store_manifest derives the launch manifest the file-backed
// overlay reads -- each store's path from gunbc.spark.v41_row_store_encode v41_store_out_path and its
// digest from v41_published_store_readings.
data v41_row_store_format_revision: Nat = 2
data v41_row_store_endianness: Endianness = LittleEndian
data v41_row_store_rank_count: Nat = 4
data v41_row_store_magic: NonEmptyStr = "ENGR1\n" as NonEmptyStr

// THE PARTITION RULE IS THE PLACER, and it is upstream's. The reserved arms keep the scheme a closed
// type that placement and the key both match on; they place nothing and are refused by name.
type V41RowStorePartition
  = ContiguousHeadBuckets
  | RankMapReservedUninhabited

type V41RowStoreOrder
  = LocalAscendingWithinRankRange
  | RowOrderReservedUninhabited

data v41_row_store_partition: V41RowStorePartition = ContiguousHeadBuckets
data v41_row_store_order: V41RowStoreOrder = LocalAscendingWithinRankRange

fn v41_partition_token(p: V41RowStorePartition) -> NonEmptyStr {
  match p {
    ContiguousHeadBuckets => "contiguous-head-buckets" as NonEmptyStr
    RankMapReservedUninhabited => "rank-map-reserved-uninhabited" as NonEmptyStr
  }
}

fn v41_order_token(o: V41RowStoreOrder) -> NonEmptyStr {
  match o {
    LocalAscendingWithinRankRange => "local-ascending-within-rank-range" as NonEmptyStr
    RowOrderReservedUninhabited => "row-order-reserved-uninhabited" as NonEmptyStr
  }
}

fn v41_uninhabited_scheme_defects(spec: V41RowStoreEncodingSpec) -> List<NonEmptyStr> {
  concat(
    match spec.rank_map {
      ContiguousHeadBuckets => [] as List<NonEmptyStr>
      RankMapReservedUninhabited => ["rank map ReservedUninhabited is not a placement rule; a rank is refused rather than fabricated" as NonEmptyStr]
    },
    match spec.row_order {
      LocalAscendingWithinRankRange => [] as List<NonEmptyStr>
      RowOrderReservedUninhabited => ["row order ReservedUninhabited is not a concatenation rule; a store is refused rather than emptied" as NonEmptyStr]
    })
}

// ── THE RECORD, DERIVED FROM THE TENSOR SHAPES ─────────────────────────────────────────────────

type V41RowGeometry sole_constructor {
  weight_dtype: SafetensorsDtype
  scale_dtype: SafetensorsDtype
  weight_width: Nat
  scale_width: Nat
}

fn v41_row_geometry_of(weight_dtype: SafetensorsDtype, scale_dtype: SafetensorsDtype, weight_width: Nat, scale_width: Nat) -> V41RowGeometry {
  V41RowGeometry { weight_dtype: weight_dtype, scale_dtype: scale_dtype, weight_width: weight_width, scale_width: scale_width }
}

fn weight_bytes(g: V41RowGeometry) -> ByteSize {
  byte_size(count: g.weight_width * byte_size_count(b: safetensors_dtype_byte_width(d: g.weight_dtype)))
}

fn scale_bytes(g: V41RowGeometry) -> ByteSize {
  byte_size(count: g.scale_width * byte_size_count(b: safetensors_dtype_byte_width(d: g.scale_dtype)))
}

fn v41_row_bytes(g: V41RowGeometry) -> ByteSize {
  byte_size(count: byte_size_count(b: weight_bytes(g: g)) + byte_size_count(b: scale_bytes(g: g)))
}

fn v41_geometry_eq(a: V41RowGeometry, b: V41RowGeometry) -> Bool {
  (safetensors_dtype_token(d: a.weight_dtype) as String) == (safetensors_dtype_token(d: b.weight_dtype) as String)
    && (safetensors_dtype_token(d: a.scale_dtype) as String) == (safetensors_dtype_token(d: b.scale_dtype) as String)
    && a.weight_width == b.weight_width && a.scale_width == b.scale_width
}

// ── ONE LAYER'S TABLE AND ITS RANK RANGES ──────────────────────────────────────────────────────

type V41LayerTable sole_constructor {
  layer: Nat
  weight: NonEmptyStr
  scale: NonEmptyStr
  rows: Nat
  ranks: List<VllmEngramRankRows>
}

fn v41_layer_table(layer: Nat, weight: NonEmptyStr, scale: NonEmptyStr, rows: Nat, ranks: List<VllmEngramRankRows>) -> V41LayerTable {
  V41LayerTable { layer: layer, weight: weight, scale: scale, rows: rows, ranks: ranks }
}

fn v41_layer_index_from_tensor_name(name: NonEmptyStr) -> Nat? {
  let parts = split(s: name as String, delimiter: ".")
  match get(xs: parts, index: 0) {
    Absent => none
    Present { value: head } =>
      if head != "layers" || length(parts) < 3 {
        none
      } else {
        match get(xs: parts, index: 1) {
          Absent => none
          Present { value: idx } => match parse_int(s: idx) {
            Absent => none
            Present { value: n } => if n < 0 { none } else { Present { value: n } }
          }
        }
      }
  }
}

fn v41_dim(e: SafetensorsEntry, index: Nat) -> Nat? {
  get(xs: e.shape, index: index)
}

fn v41_entry_in_layer(e: SafetensorsEntry, layer: Nat) -> Bool {
  match v41_layer_index_from_tensor_name(name: e.name) {
    Present { value: l } => l == layer
    Absent => false
  }
}

fn v41_dim_is(e: SafetensorsEntry, index: Nat, n: Nat) -> Bool {
  match v41_dim(e: e, index: index) {
    Present { value: d } => d == n
    Absent => false
  }
}

fn v41_is_scale_name(name: NonEmptyStr) -> Bool {
  (name as String).ends_with(suffix: ".scale")
}

// ── THE ENCODING SPEC ──────────────────────────────────────────────────────────────────────────

type V41RowStoreEncodingSpec sole_constructor {
  component: DeclarationRef
  partition: V41EngramResidencyPartition
  layers: List<V41LayerTable>
  geometry: V41RowGeometry
  rank_count: Nat
  format_revision: Nat
  endianness: Endianness
  row_order: V41RowStoreOrder
  rank_map: V41RowStorePartition
}

fn v41_encoding_spec_of_layers(partition: V41EngramResidencyPartition, layers: List<V41LayerTable>, geometry: V41RowGeometry) -> V41RowStoreEncodingSpec {
  V41RowStoreEncodingSpec {
    component: engram_component_identity,
    partition: partition,
    layers: layers,
    geometry: geometry,
    rank_count: v41_row_store_rank_count,
    format_revision: v41_row_store_format_revision,
    endianness: v41_row_store_endianness,
    row_order: v41_row_store_order,
    rank_map: v41_row_store_partition,
  }
}

fn v41_encoding_spec_override_endianness(spec: V41RowStoreEncodingSpec, endianness: Endianness) -> V41RowStoreEncodingSpec {
  V41RowStoreEncodingSpec { component: spec.component, partition: spec.partition, layers: spec.layers, geometry: spec.geometry, rank_count: spec.rank_count, format_revision: spec.format_revision, endianness: endianness, row_order: spec.row_order, rank_map: spec.rank_map }
}

fn v41_encoding_spec_override_rank_map(spec: V41RowStoreEncodingSpec, rank_map: V41RowStorePartition) -> V41RowStoreEncodingSpec {
  V41RowStoreEncodingSpec { component: spec.component, partition: spec.partition, layers: spec.layers, geometry: spec.geometry, rank_count: spec.rank_count, format_revision: spec.format_revision, endianness: spec.endianness, row_order: spec.row_order, rank_map: rank_map }
}

fn v41_encoding_spec_override_row_order(spec: V41RowStoreEncodingSpec, row_order: V41RowStoreOrder) -> V41RowStoreEncodingSpec {
  V41RowStoreEncodingSpec { component: spec.component, partition: spec.partition, layers: spec.layers, geometry: spec.geometry, rank_count: spec.rank_count, format_revision: spec.format_revision, endianness: spec.endianness, row_order: row_order, rank_map: spec.rank_map }
}

type V41RowStoreSpecStanding
  = V41RowStoreSpecAdmitted { spec: V41RowStoreEncodingSpec }
  | V41RowStoreSpecRefused { defects: List<NonEmptyStr> }

// THE LIVE SPEC, DERIVED. A layer with no storage-backed tensor has no store; the bucket layout is
// still drawn over EVERY configured layer, because upstream's primes are never reused across layers.
// The storage-backed names select a weight and a scale entry per layer; the
// record geometry is read off their dtypes and second dimensions; the rank ranges are vLLM's layout
// recomputed from the config facts. The derived bucket rows must equal each layer's published row
// count -- the two come from different authorities, so a disagreement refuses rather than choosing one.
// THE SELECTION DEFECTS, which need no bucket layout: a storage-backed name the population lacks, a
// name that is not layers.<index>.*, or a layer the Engram config does not declare. Split out so a
// consumer can refuse on them before it pays for the layout.
fn v41_row_store_selection_defects(population: List<SafetensorsEntry>, partition: V41EngramResidencyPartition, tables: DeepseekV41EngramTables) -> List<NonEmptyStr> {
  let selected = v41_selected_entries(population: population, partition: partition)
  let missing = map(
    filter(partition.storage_backed, n => !any(population, e => (e.name as String) == (n as String))),
    n => join(["storage-backed tensor ", n as String, " is not in the supplied population; a missing member is not an empty store"], "") as NonEmptyStr)
  let unnamed = map(filter(selected, e => match v41_layer_index_from_tensor_name(name: e.name) { Present { value: _ } => false  Absent => true }),
    e => join(["tensor ", e.name as String, " does not decompose as layers.<index>.*; an unrecognized name is not a default layer"], "") as NonEmptyStr)
  let unconfigured = map(filter(selected, e => match v41_layer_index_from_tensor_name(name: e.name) {
      Present { value: l } => !any(tables.layer_ids, x => x == l)
      Absent => false
    }),
    e => join(["tensor ", e.name as String, " names a layer the Engram config does not declare; it has no bucket layout and is refused rather than dropped"], "") as NonEmptyStr)
  concat(concat(missing, unnamed), unconfigured)
}

fn v41_selected_entries(population: List<SafetensorsEntry>, partition: V41EngramResidencyPartition) -> List<SafetensorsEntry> {
  filter(population, e => any(partition.storage_backed, n => (n as String) == (e.name as String)))
}

// THE LIVE BUCKET LAYOUT: vLLM's draw over the Engram config's own facts. It is the expensive half of
// the spec (a Miller-Rabin search), so the spec takes the head sizes as an input and the live callers
// pass this; a witness about the spec supplies them and test.claim.vllm.vllm_engram_layout_witness
// runs the draw itself.
fn v41_live_head_sizes(tables: DeepseekV41EngramTables) -> List<List<Int>> {
  vllm_engram_head_sizes(layer_count: length(tables.layer_ids), max_ngram_size: tables.max_ngram_size, n_heads: tables.n_heads, vocab_size: tables.vocab_size)
}

fn v41_row_store_spec(population: List<SafetensorsEntry>, partition: V41EngramResidencyPartition, tables: DeepseekV41EngramTables, head_sizes: List<List<Int>>) -> V41RowStoreSpecStanding {
  let selection = v41_row_store_selection_defects(population: population, partition: partition, tables: tables)
  if length(selection) != 0 {
    V41RowStoreSpecRefused { defects: selection }
  } else {
    let selected = v41_selected_entries(population: population, partition: partition)
    let per_layer = map(filter(enumerate(tables.layer_ids), p => any(selected, e => v41_entry_in_layer(e: e, layer: p.second))), p => v41_layer_from_entries(layer: p.second, entries: filter(selected, e => v41_entry_in_layer(e: e, layer: p.second)), head_sizes: get(xs: head_sizes, index: p.first)))
    let defects = flat_map(per_layer, r => r.defects)
    if length(defects) != 0 {
      V41RowStoreSpecRefused { defects: defects }
    } else {
      let layers = flat_map(per_layer, r => r.layer)
      let geometries = flat_map(per_layer, r => r.geometry)
      match first(geometries) {
        Absent => V41RowStoreSpecRefused { defects: ["no storage-backed layer was selected; an empty row store is not a store" as NonEmptyStr] }
        Present { value: g } =>
          if !all(geometries, x => v41_geometry_eq(a: x, b: g)) {
            V41RowStoreSpecRefused { defects: ["the storage-backed layers disagree on record geometry; one record stride cannot serve both" as NonEmptyStr] }
          } else {
            V41RowStoreSpecAdmitted { spec: v41_encoding_spec_of_layers(partition: partition, layers: layers, geometry: g) }
          }
      }
    }
  }
}

type V41LayerDerivation sole_constructor {
  layer: List<V41LayerTable>
  geometry: List<V41RowGeometry>
  defects: List<NonEmptyStr>
}

fn v41_layer_refused(defect: String) -> V41LayerDerivation {
  V41LayerDerivation { layer: [] as List<V41LayerTable>, geometry: [] as List<V41RowGeometry>, defects: [defect as NonEmptyStr] }
}

fn v41_layer_from_entries(layer: Nat, entries: List<SafetensorsEntry>, head_sizes: List<Int>?) -> V41LayerDerivation {
  let scales = filter(entries, e => v41_is_scale_name(name: e.name))
  let weights = filter(entries, e => !v41_is_scale_name(name: e.name))
  if length(scales) != 1 || length(weights) != 1 {
    v41_layer_refused(defect: join(["layer ", to_string(layer), " selects ", to_string(length(weights)), " weight and ", to_string(length(scales)), " scale tensors; a record needs exactly one of each"], ""))
  } else {
    match first(weights) {
      Absent => v41_layer_refused(defect: "unreachable: one weight was counted")
      Present { value: w } => match first(scales) {
        Absent => v41_layer_refused(defect: "unreachable: one scale was counted")
        Present { value: s } =>
          match v41_dim(e: w, index: 0) {
            Absent => v41_layer_refused(defect: join(["tensor ", w.name as String, " has no row extent; a missing extent is not zero rows"], ""))
            Present { value: rows } => match v41_dim(e: w, index: 1) {
              Absent => v41_layer_refused(defect: join(["tensor ", w.name as String, " has no row width"], ""))
              Present { value: ww } => match v41_dim(e: s, index: 1) {
                Absent => v41_layer_refused(defect: join(["tensor ", s.name as String, " has no row width"], ""))
                Present { value: sw } =>
                  if !v41_dim_is(e: s, index: 0, n: rows) {
                    v41_layer_refused(defect: join(["layer ", to_string(layer), " weight and scale disagree on row count; a record pairs row i of each"], ""))
                  } else {
                    match head_sizes {
                      Absent => v41_layer_refused(defect: join(["layer ", to_string(layer), " has no derived bucket layout"], ""))
                      Present { value: hs } =>
                        if vllm_engram_sum(xs: hs) != rows {
                          v41_layer_refused(defect: join(["layer ", to_string(layer), ": vLLM's derived bucket layout sums to ", to_string(vllm_engram_sum(xs: hs)), " rows and the published table has ", to_string(rows), "; the rank ranges are not grounded"], ""))
                        } else if !vllm_engram_every_rank_has_heads(n_hash_cols: length(hs), tp_size: v41_row_store_rank_count) {
                          v41_layer_refused(defect: join(["layer ", to_string(layer), ": ", to_string(length(hs)), " hash heads leave a rank empty at tp ", to_string(v41_row_store_rank_count)], ""))
                        } else {
                          V41LayerDerivation {
                            layer: [v41_layer_table(layer: layer, weight: w.name, scale: s.name, rows: rows, ranks: vllm_engram_rank_rows(head_sizes: hs, tp_size: v41_row_store_rank_count))],
                            geometry: [v41_row_geometry_of(weight_dtype: w.dtype, scale_dtype: s.dtype, weight_width: ww, scale_width: sw)],
                            defects: [] as List<NonEmptyStr>,
                          }
                        }
                    }
                  }
              }
            }
          }
      }
    }
  }
}

fn v41_layer_inputs(t: V41LayerTable) -> List<ArtifactRealizationInput> {
  concat(
    [
      v41_input(identity: join(["layer.", to_string(t.layer), ".weight"], ""), value: t.weight as String),
      v41_input(identity: join(["layer.", to_string(t.layer), ".scale"], ""), value: t.scale as String),
      v41_input(identity: join(["layer.", to_string(t.layer), ".rows"], ""), value: to_string(t.rows)),
    ],
    map(t.ranks, r => v41_input(identity: join(["layer.", to_string(t.layer), ".rank.", to_string(r.rank), ".rows"], ""), value: join([to_string(r.start), "..", to_string(r.end)], ""))))
}

fn v41_encoding_spec_inputs(spec: V41RowStoreEncodingSpec) -> List<ArtifactRealizationInput> {
  concat(concat([
    v41_input(identity: "component", value: declaration_ref_display_key(ref: spec.component) as String),
    v41_input(identity: "format_revision", value: to_string(spec.format_revision)),
    v41_input(identity: "magic", value: v41_row_store_magic as String),
    v41_input(identity: "endianness", value: endianness_token(e: spec.endianness) as String),
    v41_input(identity: "row_order", value: v41_order_token(o: spec.row_order) as String),
    v41_input(identity: "rank_map", value: v41_partition_token(p: spec.rank_map) as String),
    v41_input(identity: "rank_count", value: to_string(spec.rank_count)),
    v41_input(identity: "weight_dtype", value: safetensors_dtype_token(d: spec.geometry.weight_dtype) as String),
    v41_input(identity: "scale_dtype", value: safetensors_dtype_token(d: spec.geometry.scale_dtype) as String),
    v41_input(identity: "weight_width", value: to_string(spec.geometry.weight_width)),
    v41_input(identity: "scale_width", value: to_string(spec.geometry.scale_width)),
  ], flat_map(spec.partition.storage_backed.sort_by(n => n as String), n => [v41_input(identity: join(["storage.", n as String], ""), value: "storage-backed")])),
    flat_map(spec.layers.sort_by(t => t.layer), t => v41_layer_inputs(t: t)))
}

fn v41_encoding_spec_key(spec: V41RowStoreEncodingSpec) -> ContentHash {
  artifact_realization_digest(inputs: v41_encoding_spec_inputs(spec: spec))
}

// ── A STORE'S IDENTITY: (LAYER, RANK, SHA-256 OF THE FILE) ─────────────────────────────────────

// THE DIGEST IS A SHA-256 BY TYPE, because the consumer compares the file's SHA-256 and nothing else;
// a digest of another family is not writable here rather than refused later.
type V41RankStoreIdentity sole_constructor {
  layer: Nat
  rank: Nat
  digest: Sha256Digest
}

fn v41_rank_store_identity(layer: Nat, rank: Nat, digest: Sha256Digest) -> V41RankStoreIdentity {
  V41RankStoreIdentity { layer: layer, rank: rank, digest: digest }
}

type V41RowStoreEncoding
  = V41RowStoreEncodingIdentified {
      spec: V41RowStoreEncodingSpec
      spec_key: ContentHash
      rank_stores: List<V41RankStoreIdentity>
      content_digest: ContentHash
    }
  | V41RowStoreEncodingUnestablished { obligation: NonEmptyStr }
  | V41RowStoreEncodingRefused { defects: List<NonEmptyStr> }

fn v41_store_key(layer: Nat, rank: Nat) -> String {
  join(["layer.", to_string(layer), ".rank.", to_string(rank)], "")
}

fn v41_ordered_stores(stores: List<V41RankStoreIdentity>) -> List<V41RankStoreIdentity> {
  stores.sort_by(s => s.rank).sort_by(s => s.layer)
}

fn v41_rank_store_inputs(stores: List<V41RankStoreIdentity>) -> List<ArtifactRealizationInput> {
  map(v41_ordered_stores(stores: stores), s => v41_input(identity: join([v41_store_key(layer: s.layer, rank: s.rank), ".sha256"], ""), value: serialize_content_hash(hash: Sha256Hash(s.digest)) as String))
}

// THE DECLARED STORE POPULATION: one (layer, rank) per spec layer per rank, as keys.
fn v41_declared_store_keys(spec: V41RowStoreEncodingSpec) -> List<String> {
  flat_map(spec.layers, t => map(vllm_engram_count_up(n: spec.rank_count), k => v41_store_key(layer: t.layer, rank: k)))
}

// HOW MANY TIMES EACH KEY OCCURS, as one pass into a map, so every membership and multiplicity test
// below is a lookup rather than a scan of the other list.
fn v41_key_counts(keys: List<String>) -> Map<String, Int> {
  fold(keys, init: empty_map(), f: (acc, k) => map_insert(acc, k, v41_key_count(index: acc, key: k) + 1))
}

fn v41_key_count(index: Map<String, Int>, key: String) -> Int {
  match map_get(index, key) {
    Present { value: n } => n
    Absent => 0
  }
}

// IDENTIFIED ONLY OVER THE EXACT DECLARED POPULATION. A missing store, a duplicated one, or a store the
// spec does not declare refuses; that each digest is a SHA-256 is the identity's type.
fn v41_identify_row_store(spec: V41RowStoreEncodingSpec, rank_stores: List<V41RankStoreIdentity>) -> V41RowStoreEncoding {
  let scheme = v41_uninhabited_scheme_defects(spec: spec)
  let declared = v41_declared_store_keys(spec: spec)
  let supplied = map(rank_stores, s => v41_store_key(layer: s.layer, rank: s.rank))
  let declared_index = v41_key_counts(keys: declared)
  let supplied_index = v41_key_counts(keys: supplied)
  let missing = map(filter(declared, k => v41_key_count(index: supplied_index, key: k) == 0), k => join(["declared store ", k, " carries no digest; a missing store is not a store"], "") as NonEmptyStr)
  let foreign = map(filter(supplied, s => v41_key_count(index: declared_index, key: s) == 0), s => join(["store ", s, " is not declared by the encoding spec"], "") as NonEmptyStr)
  let duplicated = map(filter(declared, k => v41_key_count(index: supplied_index, key: k) > 1), k => join(["store ", k, " carries more than one digest"], "") as NonEmptyStr)
  let defects = concat(concat(concat(scheme, missing), foreign), duplicated)
  if length(defects) != 0 {
    V41RowStoreEncodingRefused { defects: defects }
  } else {
    let spec_key = v41_encoding_spec_key(spec: spec)
    V41RowStoreEncodingIdentified {
      spec: spec,
      spec_key: spec_key,
      rank_stores: v41_ordered_stores(stores: rank_stores),
      content_digest: artifact_realization_digest(inputs: concat(
        [v41_input(identity: "spec", value: serialize_content_hash(hash: spec_key) as String)],
        v41_rank_store_inputs(stores: rank_stores))),
    }
  }
}

// ── PLACEMENT: ONE PUBLISHED ROW TO ONE RECORD AT ONE OFFSET OF ONE STORE ──────────────────────

// A SOURCE ROW IS BYTES: row `global_row` of a layer's weight table and of its scale table.
type V41SourceRow sole_constructor {
  layer: Nat
  global_row: Nat
  weight: List<UInt8>
  scale: List<UInt8>
}

fn v41_source_row(layer: Nat, global_row: Nat, weight: List<UInt8>, scale: List<UInt8>) -> V41SourceRow {
  V41SourceRow { layer: layer, global_row: global_row, weight: weight, scale: scale }
}

type V41PlacedRow sole_constructor {
  layer: Nat
  global_row: Nat
  rank: Nat
  local_row: Nat
  offset: ByteSize
  record: List<UInt8>
}

fn v41_placed_row_with_record(p: V41PlacedRow, record: List<UInt8>) -> V41PlacedRow {
  V41PlacedRow { layer: p.layer, global_row: p.global_row, rank: p.rank, local_row: p.local_row, offset: p.offset, record: record }
}

type V41Placement
  = V41Placed { row: V41PlacedRow }
  | V41PlacementRefused { defect: NonEmptyStr }

fn v41_magic_octets() -> List<UInt8> {
  bytes_octets(b: utf8_encode_bytes(s: v41_row_store_magic as String))
}

fn v41_row_store_magic_size() -> ByteSize {
  byte_size(count: length(v41_magic_octets()))
}

fn v41_layer_of(spec: V41RowStoreEncodingSpec, layer: Nat) -> V41LayerTable? {
  first(filter(spec.layers, t => t.layer == layer))
}

// WHERE A ROW LIVES, without its bytes: the rank whose contiguous range holds it, its local row and
// its byte offset in that store. The host realization reads at exactly this offset.
type V41RowAddress sole_constructor {
  layer: Nat
  global_row: Nat
  rank: Nat
  local_row: Nat
  offset: ByteSize
}

fn v41_row_address(spec: V41RowStoreEncodingSpec, layer: Nat, global_row: Nat) -> V41RowAddress? {
  match spec.rank_map {
    RankMapReservedUninhabited => none
    ContiguousHeadBuckets => match v41_layer_of(spec: spec, layer: layer) {
      Absent => none
      Present { value: t } => match first(filter(t.ranks, r => r.start <= global_row && global_row < r.end)) {
        Absent => none
        Present { value: r } => {
          let local = global_row - r.start
          Present { value: V41RowAddress {
            layer: layer, global_row: global_row, rank: r.rank, local_row: local,
            offset: byte_size(count: byte_size_count(b: v41_row_store_magic_size()) + local * byte_size_count(b: v41_row_bytes(g: spec.geometry))),
          } }
        }
      }
    }
  }
}

fn v41_place_row(row: V41SourceRow, spec: V41RowStoreEncodingSpec) -> V41Placement {
  if length(row.weight) != byte_size_count(b: weight_bytes(g: spec.geometry)) {
    V41PlacementRefused { defect: join(["row ", to_string(row.global_row), " of layer ", to_string(row.layer), " carries ", to_string(length(row.weight)), " weight bytes; the geometry declares ", to_string(byte_size_count(b: weight_bytes(g: spec.geometry)))], "") as NonEmptyStr }
  } else if length(row.scale) != byte_size_count(b: scale_bytes(g: spec.geometry)) {
    V41PlacementRefused { defect: join(["row ", to_string(row.global_row), " of layer ", to_string(row.layer), " carries ", to_string(length(row.scale)), " scale bytes; the geometry declares ", to_string(byte_size_count(b: scale_bytes(g: spec.geometry)))], "") as NonEmptyStr }
  } else {
    match v41_row_address(spec: spec, layer: row.layer, global_row: row.global_row) {
      Absent => V41PlacementRefused { defect: join(["row ", to_string(row.global_row), " of layer ", to_string(row.layer), " is in no declared rank range"], "") as NonEmptyStr }
      Present { value: a } => V41Placed { row: V41PlacedRow {
        layer: a.layer, global_row: a.global_row, rank: a.rank, local_row: a.local_row, offset: a.offset,
        record: concat(row.weight, row.scale),
      } }
    }
  }
}

// ── A COMPLETE STORE'S BYTES ────────────────────────────────────────────────────────────────────
//
// THE DIGEST IS NOT TAKEN HERE. A store's identity is the SHA-256 of these bytes, the check open()
// performs, and it is read where the bytes exist: sha256sum on the host that holds the store, supplied
// to v41_identify_row_store as a Sha256Hash. This module owns the bytes exactly; the hash function is
// extdeps.crypto.sha2's and sha256sum's, and is witnessed there.
//
// Defined only over a COMPLETE store: every local row of the rank's range placed exactly once. The
// published stores are hundreds of millions of rows and are never built here; this is the definition
// a host realization is differentially checked against, exercised in full over small spec fixtures.

type V41CompleteStore sole_constructor {
  layer: Nat
  rank: Nat
  bytes: List<UInt8>
}

type V41StoreBytes
  = V41StoreComplete { store: V41CompleteStore }
  | V41StoreIncomplete { defect: NonEmptyStr }

fn v41_store_bytes(placed: List<V41PlacedRow>, spec: V41RowStoreEncodingSpec, layer: Nat, rank: Nat) -> V41StoreBytes {
  match spec.row_order {
    RowOrderReservedUninhabited => V41StoreIncomplete { defect: "row order ReservedUninhabited has no concatenation" as NonEmptyStr }
    LocalAscendingWithinRankRange => match v41_layer_of(spec: spec, layer: layer) {
      Absent => V41StoreIncomplete { defect: join(["layer ", to_string(layer), " is not declared"], "") as NonEmptyStr }
      Present { value: t } => match first(filter(t.ranks, r => r.rank == rank)) {
        Absent => V41StoreIncomplete { defect: join(["rank ", to_string(rank), " has no range in layer ", to_string(layer)], "") as NonEmptyStr }
        Present { value: r } => {
          let mine = filter(placed, p => p.layer == layer && p.rank == rank).sort_by(p => p.local_row)
          let expected = r.end - r.start
          if length(mine) != expected || !all(enumerate(mine), p => p.second.local_row == p.first) {
            V41StoreIncomplete { defect: join(["store ", v41_store_key(layer: layer, rank: rank), " holds ", to_string(length(mine)), " placed rows of its ", to_string(expected), "-row range, not each local row exactly once"], "") as NonEmptyStr }
          } else {
            V41StoreComplete { store: V41CompleteStore { layer: layer, rank: rank, bytes: concat(v41_magic_octets(), flat_map(mine, p => p.record)) } }
          }
        }
      }
    }
  }
}

// ── THE FIXTURE TRANSFORM: EVERY SUPPLIED ROW PLACED, EVERY STORE COMPLETE, EVERY DIGEST SHA-256 ─

type V41TransformSubject
  = V41FixtureRows { row_count: Nat, how: NonEmptyStr }
  | V41PublishedEngramShards

type V41TransformResult
  = V41FixtureCorrespondenceHolds {
      subject: V41FixtureRows
      placed: List<V41PlacedRow>
      stores: List<V41CompleteStore>
    }
  | V41PublishedTransformUnestablished { obligation: NonEmptyStr }
  | V41TransformUnfaithful { defects: List<NonEmptyStr> }

fn v41_place_all(rows: List<V41SourceRow>, spec: V41RowStoreEncodingSpec) -> List<V41Placement> {
  map(rows, r => v41_place_row(row: r, spec: spec))
}

fn v41_placed_rows(placements: List<V41Placement>) -> List<V41PlacedRow> {
  flat_map(placements, p => match p { V41Placed { row: r } => [r]  V41PlacementRefused { defect: _ } => [] as List<V41PlacedRow> })
}

fn v41_placement_defects(placements: List<V41Placement>) -> List<NonEmptyStr> {
  flat_map(placements, p => match p { V41Placed { row: _ } => [] as List<NonEmptyStr>  V41PlacementRefused { defect: d } => [d] })
}

// A SOURCE ROW'S IMAGE: the placed record at its address must be exactly weight || scale. Placed rows
// are indexed once by (layer, global_row) with their multiplicity, so each source row is one lookup.
type V41PlacedIndexEntry sole_constructor {
  count: Int
  record: List<UInt8>
}

fn v41_row_key(layer: Nat, global_row: Nat) -> String {
  join([to_string(layer), "#", to_string(global_row)], "")
}

fn v41_placed_index(placed: List<V41PlacedRow>) -> Map<String, V41PlacedIndexEntry> {
  fold(placed, init: empty_map(), f: (acc, p) => {
    let k = v41_row_key(layer: p.layer, global_row: p.global_row)
    map_insert(acc, k, V41PlacedIndexEntry { count: v41_placed_count(index: acc, key: k) + 1, record: p.record })
  })
}

fn v41_placed_count(index: Map<String, V41PlacedIndexEntry>, key: String) -> Int {
  match map_get(index, key) {
    Present { value: e } => e.count
    Absent => 0
  }
}

fn v41_lost_image_defects(source: List<V41SourceRow>, placed: List<V41PlacedRow>) -> List<NonEmptyStr> {
  let index = v41_placed_index(placed: placed)
  flat_map(source, s => {
    let exact = match map_get(index, v41_row_key(layer: s.layer, global_row: s.global_row)) {
      Present { value: e } => e.count == 1 && e.record == concat(s.weight, s.scale)
      Absent => false
    }
    if exact {
      [] as List<NonEmptyStr>
    } else {
      [join(["source row ", to_string(s.layer), "#", to_string(s.global_row), " has no exact placed image"], "") as NonEmptyStr]
    }
  })
}

fn v41_assess_placed(source: List<V41SourceRow>, spec: V41RowStoreEncodingSpec, placed: List<V41PlacedRow>) -> V41TransformResult {
  let scheme = v41_uninhabited_scheme_defects(spec: spec)
  let lost = v41_lost_image_defects(source: source, placed: placed)
  let count = if length(source) == length(placed) { [] as List<NonEmptyStr> } else { [join(["placed ", to_string(length(placed)), " rows from ", to_string(length(source)), " source rows"], "") as NonEmptyStr] }
  let early = concat(concat(scheme, lost), count)
  if length(early) != 0 {
    V41TransformUnfaithful { defects: early }
  } else {
    let stores = flat_map(spec.layers, t => map(vllm_engram_count_up(n: spec.rank_count), k => v41_store_bytes(placed: placed, spec: spec, layer: t.layer, rank: k)))
    let incomplete = flat_map(stores, s => match s { V41StoreIncomplete { defect: d } => [d]  V41StoreComplete { store: _ } => [] as List<NonEmptyStr> })
    if length(incomplete) != 0 {
      V41TransformUnfaithful { defects: incomplete }
    } else {
      V41FixtureCorrespondenceHolds {
        subject: V41FixtureRows { row_count: length(source), how: "supplied fixture rows over a fixture spec; not the published Engram tables" as NonEmptyStr },
        placed: placed,
        stores: flat_map(stores, s => match s { V41StoreComplete { store: c } => [c]  V41StoreIncomplete { defect: _ } => [] as List<V41CompleteStore> }),
      }
    }
  }
}

fn v41_transform_fixture(source: List<V41SourceRow>, spec: V41RowStoreEncodingSpec) -> V41TransformResult {
  let placements = v41_place_all(rows: source, spec: spec)
  let refused = v41_placement_defects(placements: placements)
  if length(refused) != 0 {
    V41TransformUnfaithful { defects: refused }
  } else {
    v41_assess_placed(source: source, spec: spec, placed: v41_placed_rows(placements: placements))
  }
}

fn v41_tampered_record_is_unfaithful(source: List<V41SourceRow>, spec: V41RowStoreEncodingSpec, tamper: List<UInt8>) -> Bool {
  let placed = v41_placed_rows(placements: v41_place_all(rows: source, spec: spec))
  match v41_assess_placed(source: source, spec: spec, placed: map(placed, p => if p.global_row == 0 { v41_placed_row_with_record(p: p, record: tamper) } else { p })) {
    V41TransformUnfaithful { defects: d } => any(d, x => (x as String).contains("no exact placed image"))
    V41FixtureCorrespondenceHolds { subject: _, placed: _, stores: _ } => false
    V41PublishedTransformUnestablished { obligation: _ } => false
  }
}

fn v41_dropped_source_row_is_unfaithful(source: List<V41SourceRow>, spec: V41RowStoreEncodingSpec) -> Bool {
  match v41_assess_placed(source: source, spec: spec, placed: filter(v41_placed_rows(placements: v41_place_all(rows: source, spec: spec)), p => p.global_row != 0)) {
    V41TransformUnfaithful { defects: d } => any(d, x => (x as String).contains("no exact placed image"))
    V41FixtureCorrespondenceHolds { subject: _, placed: _, stores: _ } => false
    V41PublishedTransformUnestablished { obligation: _ } => false
  }
}

// THE PUBLISHED TABLES HAVE NO CONSTRUCTOR HERE, AND THE RUNG THAT COSTS IS DECLARED. Their stores are
// built on the host from the materialized shards by the program gunbc.spark.v41_row_store_encode drives,
// a realization of v41_place_row / v41_store_bytes that receives every layout fact from this spec. Its
// output is admitted by DIFFERENTIAL agreement with this fold over a real published sample
// (test.claim.spark.v41_row_store_encode_witness), which is weaker than the fold producing the bytes
// itself: gunbc.rung_drop v41_row_store_host_realized_by_sample records the drop and its trigger (the
// emitted .dag encoder encoding all eight stores). Identified is then minted by v41_identify_row_store
// from the host's per-store sha256 (v41_published_store_readings, beside the row-store encoding key).
fn v41_published_transform_standing() -> V41TransformResult {
  V41PublishedTransformUnestablished {
    obligation: "the published Engram stores (layers 1 and 14, four ranks each) have not been produced: a host realization of v41_place_row over the materialized shards, admitted by a differential claim over real published rows, is the only producer this module admits" as NonEmptyStr,
  }
}

// ── READS ──────────────────────────────────────────────────────────────────────────────────────

fn v41_encoding_digest_of(e: V41RowStoreEncoding) -> ContentHash? {
  match e {
    V41RowStoreEncodingIdentified { spec: _, spec_key: _, rank_stores: _, content_digest: d } => Present { value: d }
    V41RowStoreEncodingUnestablished { obligation: _ } => none
    V41RowStoreEncodingRefused { defects: _ } => none
  }
}

fn v41_encoding_spec_of(e: V41RowStoreEncoding) -> V41RowStoreEncodingSpec? {
  match e {
    V41RowStoreEncodingIdentified { spec: s, spec_key: _, rank_stores: _, content_digest: _ } => Present { value: s }
    V41RowStoreEncodingUnestablished { obligation: _ } => none
    V41RowStoreEncodingRefused { defects: _ } => none
  }
}

fn v41_encoding_spec_key_of(e: V41RowStoreEncoding) -> ContentHash? {
  match e {
    V41RowStoreEncodingIdentified { spec: _, spec_key: k, rank_stores: _, content_digest: _ } => Present { value: k }
    V41RowStoreEncodingUnestablished { obligation: _ } => none
    V41RowStoreEncodingRefused { defects: _ } => none
  }
}

fn v41_rank_stores_of(e: V41RowStoreEncoding) -> List<V41RankStoreIdentity> {
  match e {
    V41RowStoreEncodingIdentified { spec: _, spec_key: _, rank_stores: rs, content_digest: _ } => rs
    V41RowStoreEncodingUnestablished { obligation: _ } => [] as List<V41RankStoreIdentity>
    V41RowStoreEncodingRefused { defects: _ } => [] as List<V41RankStoreIdentity>
  }
}

fn v41_rank_digest_of(e: V41RowStoreEncoding, layer: Nat, rank: Nat) -> ContentHash? {
  match first(filter(v41_rank_stores_of(e: e), r => r.layer == layer && r.rank == rank)) {
    Present { value: row } => Present { value: Sha256Hash(row.digest) }
    Absent => none
  }
}

// ── THE PUBLISHED ROW-STORE ENCODING KEY: THE TRANSFORM'S INPUT, READ, PLUS ITS SPEC ──────────
//
// WHAT THE CANDIDATE'S row_store_encoding AXIS IS KEYED BY (ruling, proud-deer-538, 2026-09-21). The
// encoding is a deterministic function of two things: the bytes of the storage-backed tensors in the
// published shards, and this module's encoding spec. So the key is sha256 over one canonical text
// naming the spec key and, for each storage-backed tensor, the shard, the file span and the sha256 of
// exactly those bytes, read on a Spark from the materialized shard. A different table set changes both
// the spec key and the set of spans, and a reading over any other region refuses, so the key names
// this realization and nothing near it.
//
// THIS IS NOT THE FOUR ROW-STORE IDENTITIES, and the two must not be read as one fact. The rank files
// are the encoder's PRODUCED artifacts. They are digested by whole-file sha256, which is what the
// file-backed patch checks on open, and D1 authorizes over them as a readback of the encoder's output.
// This key is the keyed side of that split, the same keyed-versus-produced split the runtime lane
// keeps for the image digest. No encoder over the published shards exists yet, and this key does not
// stand in for one.

// WHERE EACH STORAGE-BACKED TENSOR'S BYTES ARE, DERIVED FROM THE PUBLISHER'S HEADER ROWS. A span's file
// offset is the 8-byte length prefix plus the shard's JSON header plus the entry's payload-relative
// begin; its length is the entry's span. The mode that reads the host consumes this same plan, so the
// region read and the region admitted come from one derivation.
type V41PublishedSpan {
  tensor: NonEmptyStr
  shard: NonEmptyStr
  file_offset: ByteSize
  length: ByteSize
}

type V41PublishedSpanPlan
  = V41PublishedSpansPlanned { spans: List<V41PublishedSpan> }
  | V41PublishedSpansUnplannable { defects: List<NonEmptyStr> }

// ONE ENTRY'S SPAN, OR WHY IT HAS NONE. The shard-bounds relation is extdeps.safetensors.format's
// (safetensors_shard_bounds_resolution), and its three arms are kept apart here: a duplicated bound row
// is a contradiction in the supplied shard files, an absent one is a thing not yet read. Rendering
// both as one sentence would erase a distinction the upstream model carries.
type V41SpanResolution
  = V41SpanResolved { span: V41PublishedSpan }
  | V41SpanUnresolved { defect: NonEmptyStr }

fn v41_published_span_of(e: SafetensorsShardedEntry, shards: List<SafetensorsShardFile>) -> V41SpanResolution {
  match safetensors_shard_bounds_resolution(shards: shards, shard: e.shard) {
    ShardBoundsResolved { shard: _, file: f } => V41SpanResolved { span: V41PublishedSpan {
      tensor: e.entry.name,
      shard: e.shard,
      file_offset: measure_add(a: safetensors_shard_declared_overhead(header_bytes: f.header_bytes), b: byte_size(count: e.entry.begin_offset)),
      length: safetensors_entry_span(e: e.entry),
    } }
    ShardBoundsDuplicated { shard: sd, rows: n } => V41SpanUnresolved { defect: join([
      "shard ", sd as String, " of ", e.entry.name as String, " has ", to_string(n),
      " shard file rows, so it carries that many header lengths and the span's file offset is contradicted",
    ], "") as NonEmptyStr }
    ShardBoundsAbsent { shard: sd } => V41SpanUnresolved { defect: join([
      "shard ", sd as String, " of ", e.entry.name as String,
      " has no shard file row, so its header length and the span's file offset are unread",
    ], "") as NonEmptyStr }
  }
}

// EACH SELECTED ENTRY IS RESOLVED ONCE, and that one list of outcomes is folded into both the defects
// and the spans (DESIGN section 2: the shared ancestor carries the value rather than re-deriving it).
fn v41_published_span_plan(partition: V41EngramResidencyPartition, sharded: List<SafetensorsShardedEntry>, shards: List<SafetensorsShardFile>) -> V41PublishedSpanPlan {
  let missing = map(
    filter(partition.storage_backed, n => length(filter(sharded, e => (e.entry.name as String) == (n as String))) != 1),
    n => join(["storage-backed tensor ", n as String, " is not exactly one header row in the published population, so there is no span to read"], "") as NonEmptyStr)
  let selected = filter(sharded, e => any(partition.storage_backed, n => (n as String) == (e.entry.name as String)))
  let resolved = map(selected, e => v41_published_span_of(e: e, shards: shards))
  let unbound = flat_map(resolved, r => match r {
    V41SpanResolved { span: _ } => [] as List<NonEmptyStr>
    V41SpanUnresolved { defect: d } => [d]
  })
  let defects = concat(missing, unbound)
  if length(defects) != 0 { V41PublishedSpansUnplannable { defects: defects } } else {
    V41PublishedSpansPlanned { spans: flat_map(resolved, r => match r {
      V41SpanResolved { span: sp } => [sp]
      V41SpanUnresolved { defect: _ } => [] as List<V41PublishedSpan>
    }).sort_by(sp => sp.tensor as String) }
  }
}

// ONE SPAN'S READING: the region that was read and the sha256 of exactly its bytes.
type V41PublishedSpanDigest {
  span: V41PublishedSpan
  sha256: Sha256Digest
}

// THE RECEIPT OF A HOST READ. Unread is the standing until a dispatched read's receipt is transcribed
// here from gunbc.spark.v41_checkpoint_materialize's receipt file, with the host and time it names.
type V41PublishedSpanReadings
  = V41PublishedSpansRead { host: NonEmptyStr, observed_at: NonEmptyStr, spans: List<V41PublishedSpanDigest> }
  | V41PublishedSpansUnread { obligation: NonEmptyStr }

type V41PublishedRowStoreKey
  = V41PublishedRowStoreKeyed { digest: ContentHash }
  | V41PublishedRowStoreUnestablished { obligation: NonEmptyStr }
  | V41PublishedRowStoreRefused { defects: List<NonEmptyStr> }

fn v41_span_eq(a: V41PublishedSpan, b: V41PublishedSpan) -> Bool {
  (a.tensor as String) == (b.tensor as String) && (a.shard as String) == (b.shard as String) && byte_size_count(b: a.file_offset) == byte_size_count(b: b.file_offset) && byte_size_count(b: a.length) == byte_size_count(b: b.length)
}

// THE READINGS ARE JOINED TO THE PLAN BY IDENTITY, NOT COUNTED. Every planned span must be read
// exactly once, over exactly its region; a reading of a tensor the plan does not name, or of the right
// tensor over another region, refuses. That is the RED the brief names: a digest over a different table
// set cannot key.
// HOW MANY READINGS A PLANNED SPAN HAS. Counted once per plan row; the unread and twice arms read the count.
type V41SpanReadCount {
  span: V41PublishedSpan
  readings: Nat
}

fn v41_span_reading_defects(plan: List<V41PublishedSpan>, read: List<V41PublishedSpanDigest>) -> List<NonEmptyStr> {
  let counted = map(plan, sp => V41SpanReadCount { span: sp, readings: length(filter(read, r => v41_span_eq(a: r.span, b: sp))) })
  let unread = map(filter(counted, c => c.readings == 0),
    c => join(["the planned span of ", c.span.tensor as String, " (", c.span.shard as String, " at ", to_string(byte_size_count(b: c.span.file_offset)), " for ", to_string(byte_size_count(b: c.span.length)), " bytes) was not read"], "") as NonEmptyStr)
  let twice = map(filter(counted, c => c.readings > 1),
    c => join(["the span of ", c.span.tensor as String, " was read more than once, so which digest is its reading is undecided"], "") as NonEmptyStr)
  let foreign = map(filter(read, r => !any(plan, sp => v41_span_eq(a: r.span, b: sp))),
    r => join(["a reading of ", r.span.tensor as String, " (", r.span.shard as String, " at ", to_string(byte_size_count(b: r.span.file_offset)), " for ", to_string(byte_size_count(b: r.span.length)), " bytes) is not a span this partition stores"], "") as NonEmptyStr)
  concat(concat(unread, twice), foreign)
}

// ── THE ROW-STORE ENCODING KEY: THE EIGHT ENCODED STORES, WITH THEIR INPUT JOINED ────────────
//
// WHAT KEYS THE CANDIDATE'S row_store_encoding AXIS (ruling, proud-deer-538, 2026-09-23): the ENCODED
// stores, one per (layer, rank), each the SHA-256 the consumer checks on open. The key IS
// v41_identify_row_store's content_digest -- the one derivation over the spec key and the ordered store
// digests -- and not a second serialization of the same facts (review 70467). The source spans are the
// encoder's INPUT identity, not the key: they must be read and joined to v41_published_span_plan by
// identity (every planned span exactly once, over exactly its region) before a key is minted, so "the
// stores were encoded from exactly these spans" is a join rather than an assumption, but their bytes do
// not enter the key text. This replaces a key over the span digests alone (#12010), which keyed the
// transform's input and not its output; the name changed with the meaning.

// ONE STORE AS READ ON THE HOST: its identity (layer, rank, sha256) and the size of the file. The size is
// the cheap cross-check that the encoder obeyed the derived layout: a store whose size is not
// magic + rows x record bytes would be keyed by a digest over a file FileBackedEngramStorage cannot
// open (proud-deer-538, 2026-09-24), so the key refuses it before identifying.
type V41ObservedRankStore {
  identity: V41RankStoreIdentity
  size: ByteSize
}

// THE SIZE OF A STORE OF `rows` RECORDS: the magic, then one record per row. The one formula; the key's
// check below and the encode plan's expected size (gunbc.spark.v41_row_store_encode) both call it.
fn v41_store_size(spec: V41RowStoreEncodingSpec, rows: Nat) -> ByteSize {
  byte_size(count: byte_size_count(b: v41_row_store_magic_size()) + rows * byte_size_count(b: v41_row_bytes(g: spec.geometry)))
}

// THE SIZE A (layer, rank) STORE MUST HAVE, from the spec: v41_store_size over the rank's range.
fn v41_store_derived_size(spec: V41RowStoreEncodingSpec, layer: Nat, rank: Nat) -> ByteSize? {
  match v41_layer_of(spec: spec, layer: layer) {
    Absent => none
    Present { value: t } => match first(filter(t.ranks, r => r.rank == rank)) {
      Absent => none
      Present { value: r } => Present { value: v41_store_size(spec: spec, rows: r.end - r.start) }
    }
  }
}

fn v41_store_size_defects(spec: V41RowStoreEncodingSpec, stores: List<V41ObservedRankStore>) -> List<NonEmptyStr> {
  flat_map(stores, o => match v41_store_derived_size(spec: spec, layer: o.identity.layer, rank: o.identity.rank) {
    Absent => [join(["store ", v41_store_key(layer: o.identity.layer, rank: o.identity.rank), " has no derived size: the spec declares no such store"], "") as NonEmptyStr]
    Present { value: d } =>
      if byte_size_count(b: d) == byte_size_count(b: o.size) { [] as List<NonEmptyStr> } else {
        [join(["store ", v41_store_key(layer: o.identity.layer, rank: o.identity.rank), " is ", to_string(byte_size_count(b: o.size)), " bytes and the layout derives ", to_string(byte_size_count(b: d)), "; its digest is not keyed"], "") as NonEmptyStr]
      }
  })
}

type V41PublishedStoreReadings
  = V41PublishedStoresRead { host: NonEmptyStr, observed_at: NonEmptyStr, stores: List<V41ObservedRankStore> }
  | V41PublishedStoresUnread { obligation: NonEmptyStr }

// THE HEAD SIZES ARRIVE AS A DEFERRED VALUE, computed only once both readings exist: an unread axis
// costs no bucket-layout search, and the selection defects are still refused before any obligation.
fn v41_row_store_encoding_key(partition: V41EngramResidencyPartition, sharded: List<SafetensorsShardedEntry>, shards: List<SafetensorsShardFile>, spans: V41PublishedSpanReadings, stores: V41PublishedStoreReadings, head_sizes: fn() -> List<List<Int>>) -> V41PublishedRowStoreKey {
  let selection = v41_row_store_selection_defects(population: map(sharded, e => e.entry), partition: partition, tables: deepseek_v4_1_flash_engram)
  if length(selection) != 0 { V41PublishedRowStoreRefused { defects: selection } } else {
    match v41_published_span_plan(partition: partition, sharded: sharded, shards: shards) {
      V41PublishedSpansUnplannable { defects: d } => V41PublishedRowStoreRefused { defects: d }
      V41PublishedSpansPlanned { spans: plan } =>
        match spans {
          V41PublishedSpansUnread { obligation: o } => V41PublishedRowStoreUnestablished { obligation: match stores {
            V41PublishedStoresUnread { obligation: so } => join([so as String, "; and ", o as String], "") as NonEmptyStr
            V41PublishedStoresRead { host: _, observed_at: _, stores: _ } => o
          } }
          V41PublishedSpansRead { host: _, observed_at: _, spans: read } => {
            let span_defects = v41_span_reading_defects(plan: plan, read: read)
            if length(span_defects) != 0 { V41PublishedRowStoreRefused { defects: span_defects } } else {
              match stores {
                V41PublishedStoresUnread { obligation: o } => V41PublishedRowStoreUnestablished { obligation: o }
                V41PublishedStoresRead { host: _, observed_at: _, stores: st } =>
                  match v41_row_store_spec(population: map(sharded, e => e.entry), partition: partition, tables: deepseek_v4_1_flash_engram, head_sizes: head_sizes()) {
                    V41RowStoreSpecRefused { defects: sd } => V41PublishedRowStoreRefused { defects: sd }
                    V41RowStoreSpecAdmitted { spec: spec } => {
                      let size_defects = v41_store_size_defects(spec: spec, stores: st)
                      if length(size_defects) != 0 { V41PublishedRowStoreRefused { defects: size_defects } } else {
                        match v41_identify_row_store(spec: spec, rank_stores: map(st, o => o.identity)) {
                          V41RowStoreEncodingRefused { defects: d } => V41PublishedRowStoreRefused { defects: d }
                          V41RowStoreEncodingUnestablished { obligation: o } => V41PublishedRowStoreUnestablished { obligation: o }
                          V41RowStoreEncodingIdentified { spec: _, spec_key: _, rank_stores: _, content_digest: d } => V41PublishedRowStoreKeyed { digest: d }
                        }
                      }
                    }
                  }
              }
            }
          }
        }
    }
  }
}

// THE LIVE READINGS. The spans are read by spark_v41_checkpoint_materialize after the shards verify; the
// stores by the encode run over them. Each stays Unread until its run's receipt is transcribed, and the
// candidate's row_store_encoding axis stays Unestablished on whichever is still unread.
// srv5's storage-backed spans, read by spark_v41_checkpoint_materialize after every shard verified against
// its manifest row (fleet-converge run 35840493821, main eb6bf6c, reported by sleek-bee-348 2026-09-23).
data v41_published_span_readings: V41PublishedSpanReadings = V41PublishedSpansRead {
  host: "srv5" as NonEmptyStr,
  observed_at: "fleet-converge run 35840493821" as NonEmptyStr,
  spans: [
    V41PublishedSpanDigest { span: V41PublishedSpan { tensor: "layers.1.engram.embed.weight" as NonEmptyStr, shard: "model-00047-of-00048.safetensors" as NonEmptyStr, file_offset: byte_size(count: 664), length: byte_size(count: 98305579008) }, sha256: Sha256Digest { hex: "ada3f1b35065e3088b6cc8d45cde49320f25a1b884287d55c428618321310329" as Sha256DigestHex } },
    V41PublishedSpanDigest { span: V41PublishedSpan { tensor: "layers.1.engram.embed.scale" as NonEmptyStr, shard: "model-00047-of-00048.safetensors" as NonEmptyStr, file_offset: byte_size(count: 98305579672), length: byte_size(count: 3072049344) }, sha256: Sha256Digest { hex: "75a1a0818a4e512dc1e298027fc70637d92df02c0534de9c3c311c87da2e392d" as Sha256DigestHex } },
    V41PublishedSpanDigest { span: V41PublishedSpan { tensor: "layers.14.engram.embed.weight" as NonEmptyStr, shard: "model-00048-of-00048.safetensors" as NonEmptyStr, file_offset: byte_size(count: 672), length: byte_size(count: 98308270592) }, sha256: Sha256Digest { hex: "7b386ab53a08afb08a72907e4ab28456dece22f71d63ab4c9382c88896fda768" as Sha256DigestHex } },
    V41PublishedSpanDigest { span: V41PublishedSpan { tensor: "layers.14.engram.embed.scale" as NonEmptyStr, shard: "model-00048-of-00048.safetensors" as NonEmptyStr, file_offset: byte_size(count: 98308271264), length: byte_size(count: 3072133456) }, sha256: Sha256Digest { hex: "5d5ed18e6bf6f87254bd0e02c8131446b0c44144c465cd2e48d5b3bbba70b47b" as Sha256DigestHex } },
  ],
}

// THE STORE READINGS' INSTRUMENT: the spark_v41_row_store_encode fleet-converge mode
// (gunbc.spark.v41_row_store_encode_run v41_row_store_encode_ci_wet). Its receipt, printed into that step's
// log, carries one `store layer.L.rank.K sha256=... size_bytes=...` line per store, each already checked
// against the derived size. A Read row is transcribed from one run's log, names that run (observed_at)
// and the host it read, and carries every store's size, which the key checks again.
// The eight stores as read on srv5 by spark_v41_row_store_encode (fleet-converge run 36023830860, main
// 86659c7, 2026-09-24): every store present, every size_bytes equal to its derived size. The digests
// repeat run 35998756420's (the first encode) exactly.
data v41_published_store_readings: V41PublishedStoreReadings = V41PublishedStoresRead {
  host: "srv5" as NonEmptyStr,
  observed_at: "fleet-converge run 36023830860" as NonEmptyStr,
  stores: [
    V41ObservedRankStore { identity: v41_rank_store_identity(layer: 1, rank: 0, digest: Sha256Digest { hex: "408fc45afaab71f7ae79af76636e031ca453f8d3a26c416a18baee6c0275de23" as Sha256DigestHex }), size: byte_size(count: 25344148902) },
    V41ObservedRankStore { identity: v41_rank_store_identity(layer: 1, rank: 1, digest: Sha256Digest { hex: "ca2b254506628fa5e292022f184ebae50de62875e96dc3d73008724905201a3f" as Sha256DigestHex }), size: byte_size(count: 25344310470) },
    V41ObservedRankStore { identity: v41_rank_store_identity(layer: 1, rank: 2, digest: Sha256Digest { hex: "15461f3def1f5ef66c6335756135be45a896be50735224a3c6246d6fc69a79e8" as Sha256DigestHex }), size: byte_size(count: 25344505302) },
    V41ObservedRankStore { identity: v41_rank_store_identity(layer: 1, rank: 3, digest: Sha256Digest { hex: "b4ddf62c433427c0f6ad5d5ef053656a0ccf6bbb823d5d7cb5e3f9b4870a7f71" as Sha256DigestHex }), size: byte_size(count: 25344663702) },
    V41ObservedRankStore { identity: v41_rank_store_identity(layer: 14, rank: 0, digest: Sha256Digest { hex: "b8227f2105cbd74195fbf1b1066b812456b8808c60e603d067821c688e181657" as Sha256DigestHex }), size: byte_size(count: 25344806262) },
    V41ObservedRankStore { identity: v41_rank_store_identity(layer: 14, rank: 1, digest: Sha256Digest { hex: "f59d2f01751827ce5dd74400b4904ec8fccda0bb17fa1fcbc527ec6be564030b" as Sha256DigestHex }), size: byte_size(count: 25345045974) },
    V41ObservedRankStore { identity: v41_rank_store_identity(layer: 14, rank: 2, digest: Sha256Digest { hex: "20da211045f113916088fede485cd1fa4058a9efe6fc21b9ba58bbb99a5dde91" as Sha256DigestHex }), size: byte_size(count: 25345200678) },
    V41ObservedRankStore { identity: v41_rank_store_identity(layer: 14, rank: 3, digest: Sha256Digest { hex: "02450652d87576ab116348f1b3182540dc43d0eb1c1134d7d629eb287e378fb9" as Sha256DigestHex }), size: byte_size(count: 25345351158) },
  ],
}

// ── THE BOUNDARY-STRATIFIED READBACK: THE REAL STORES' BYTES AT EVERY SEAM, AGAINST v41_place_row ──
//
// The digests above say WHICH bytes the eight stores hold; they do not say those bytes are the model's.
// The differential that admitted the host program (#12122) ran over two adjacent layer-1 rows, which
// cannot see a wiring error: a wrong first or last row for one rank, an off-by-one rank boundary, layer
// 14 handed layer 1's offsets, one rank's plan handed to another, a wrong termination
// (proud-deer-538, 2026-09-24). So the produced stores are read back at exactly the rows where those
// errors live -- each store's magic, its first and its last record -- and the published source rows at
// the same global rows (which, rank by rank, are row 0, the last row, and both sides of every rank
// boundary), and each store record must equal what v41_place_row makes of its source row, at the rank
// and local row the spec assigns. Termination is the size check the key already makes (v41_store_size).
// The sample is DERIVED from the admitted spec, never authored: a spec whose ranges move moves it.
//
// A SHIFT THAT CANNOT BE SEEN MUST REFUSE, NOT PASS: where the source rows on both sides of a boundary are
// byte-identical, a store shifted by one row there would read back equal, so the readback refuses as
// undiscriminating rather than calling it verified.

type V41ReadbackSample
  = V41SampleMagic { layer: Nat, rank: Nat }
  | V41SampleStoreRecord { layer: Nat, rank: Nat, local_row: Nat }
  | V41SampleSourceWeight { layer: Nat, global_row: Nat }
  | V41SampleSourceScale { layer: Nat, global_row: Nat }

fn v41_readback_sample_key(s: V41ReadbackSample) -> String {
  match s {
    V41SampleMagic { layer: l, rank: r } => join(["magic ", v41_store_key(layer: l, rank: r)], "")
    V41SampleStoreRecord { layer: l, rank: r, local_row: k } => join(["record ", v41_store_key(layer: l, rank: r), " row ", to_string(k)], "")
    V41SampleSourceWeight { layer: l, global_row: g } => join(["weight layer.", to_string(l), " row ", to_string(g)], "")
    V41SampleSourceScale { layer: l, global_row: g } => join(["scale layer.", to_string(l), " row ", to_string(g)], "")
  }
}

// WHERE A SAMPLE LIVES: a byte region of one store, or of one layer's weight or scale table (the offset is
// from the table's start; the host run adds the published span's file offset).
type V41ReadbackRegion
  = V41RegionInStore { layer: Nat, rank: Nat, offset: ByteSize, length: ByteSize }
  | V41RegionInWeight { layer: Nat, offset: ByteSize, length: ByteSize }
  | V41RegionInScale { layer: Nat, offset: ByteSize, length: ByteSize }

fn v41_readback_region(spec: V41RowStoreEncodingSpec, s: V41ReadbackSample) -> V41ReadbackRegion {
  let record = v41_row_bytes(g: spec.geometry)
  match s {
    V41SampleMagic { layer: l, rank: r } => V41RegionInStore { layer: l, rank: r, offset: byte_size(count: 0), length: v41_row_store_magic_size() }
    V41SampleStoreRecord { layer: l, rank: r, local_row: k } => V41RegionInStore { layer: l, rank: r, offset: byte_size(count: byte_size_count(b: v41_row_store_magic_size()) + k * byte_size_count(b: record)), length: record }
    V41SampleSourceWeight { layer: l, global_row: g } => V41RegionInWeight { layer: l, offset: byte_size(count: g * byte_size_count(b: weight_bytes(g: spec.geometry))), length: weight_bytes(g: spec.geometry) }
    V41SampleSourceScale { layer: l, global_row: g } => V41RegionInScale { layer: l, offset: byte_size(count: g * byte_size_count(b: scale_bytes(g: spec.geometry))), length: scale_bytes(g: spec.geometry) }
  }
}

fn v41_region_length(r: V41ReadbackRegion) -> ByteSize {
  match r {
    V41RegionInStore { layer: _, rank: _, offset: _, length: n } => n
    V41RegionInWeight { layer: _, offset: _, length: n } => n
    V41RegionInScale { layer: _, offset: _, length: n } => n
  }
}

// THE GLOBAL ROWS A RANK'S STORE IS SAMPLED AT: its first and its last (one, when the range is one row).
fn v41_rank_edge_rows(r: VllmEngramRankRows) -> List<Int> {
  if r.end - r.start == 1 { [r.start] } else { [r.start, r.end - 1] }
}

fn v41_rank_samples(layer: Nat, r: VllmEngramRankRows) -> List<V41ReadbackSample> {
  concat([V41SampleMagic { layer: layer, rank: r.rank } as V41ReadbackSample],
    flat_map(v41_rank_edge_rows(r: r), g => [
      V41SampleStoreRecord { layer: layer, rank: r.rank, local_row: g - r.start } as V41ReadbackSample,
      V41SampleSourceWeight { layer: layer, global_row: g } as V41ReadbackSample,
      V41SampleSourceScale { layer: layer, global_row: g } as V41ReadbackSample,
    ]))
}

// EVERY SAMPLE THE SPEC OWES, in spec order. A rank with no rows owes none (its store is magic only, and
// the spec admits no such rank: vllm_engram_every_rank_has_heads).
fn v41_readback_samples(spec: V41RowStoreEncodingSpec) -> List<V41ReadbackSample> {
  flat_map(spec.layers, t => flat_map(filter(t.ranks, r => r.end > r.start), r => v41_rank_samples(layer: t.layer, r: r)))
}

type V41ReadbackReading {
  sample: V41ReadbackSample
  hex: String
}

type V41StoreReadbackReadings
  = V41StoreReadbackRead { host: NonEmptyStr, observed_at: NonEmptyStr, readings: List<V41ReadbackReading> }
  | V41StoreReadbackReadingsUnread { obligation: NonEmptyStr }

type V41StoreReadback
  = V41StoreReadbackVerified { host: NonEmptyStr, observed_at: NonEmptyStr, samples: Nat }
  | V41StoreReadbackUnread { obligation: NonEmptyStr }
  | V41StoreReadbackRefused { defects: List<NonEmptyStr> }

fn v41_readback_octets(hex: String) -> List<UInt8>? {
  match base16_decode_lower(hex: hex) {
    Absent => none
    Present { value: q } => Present { value: qualified_octet_members(q: q) }
  }
}

// THE READINGS, JOINED TO THE SAMPLE BY IDENTITY: every owed sample exactly once, nothing foreign, every
// reading exactly its region's length. A reading that is not lowercase hex decodes to no bytes, which
// v41_place_row and the magic check then refuse: each reading is decoded once, where it is compared.
fn v41_readback_join_defects(spec: V41RowStoreEncodingSpec, owed: List<V41ReadbackSample>, readings: List<V41ReadbackReading>) -> List<NonEmptyStr> {
  let owed_index = v41_key_counts(keys: map(owed, s => v41_readback_sample_key(s: s)))
  let read_index = v41_key_counts(keys: map(readings, r => v41_readback_sample_key(s: r.sample)))
  let missing = map(filter(owed, s => v41_key_count(index: read_index, key: v41_readback_sample_key(s: s)) == 0), s => join(["the readback owes ", v41_readback_sample_key(s: s), " and it was not read"], "") as NonEmptyStr)
  let twice = map(filter(owed, s => v41_key_count(index: read_index, key: v41_readback_sample_key(s: s)) > 1), s => join(["", v41_readback_sample_key(s: s), " was read more than once"], "") as NonEmptyStr)
  let foreign = map(filter(readings, r => v41_key_count(index: owed_index, key: v41_readback_sample_key(s: r.sample)) == 0), r => join(["a reading of ", v41_readback_sample_key(s: r.sample), " is not a sample the spec owes"], "") as NonEmptyStr)
  let malformed = map(filter(readings, r => string_length(r.hex) != 2 * byte_size_count(b: v41_region_length(r: v41_readback_region(spec: spec, s: r.sample)))),
    r => join(["the reading of ", v41_readback_sample_key(s: r.sample), " is not ", to_string(2 * byte_size_count(b: v41_region_length(r: v41_readback_region(spec: spec, s: r.sample)))), " hex digits (", to_string(byte_size_count(b: v41_region_length(r: v41_readback_region(spec: spec, s: r.sample)))), " bytes)"], "") as NonEmptyStr)
  concat(concat(concat(missing, twice), foreign), malformed)
}

fn v41_reading_hex(index: Map<String, String>, s: V41ReadbackSample) -> String {
  match map_get(index, v41_readback_sample_key(s: s)) {
    Present { value: h } => h
    Absent => ""
  }
}

fn v41_reading_octets(index: Map<String, String>, s: V41ReadbackSample) -> List<UInt8> {
  match v41_readback_octets(hex: v41_reading_hex(index: index, s: s)) {
    Present { value: o } => o
    Absent => [] as List<UInt8>
  }
}

// ONE STORE RECORD AGAINST v41_place_row OF ITS SOURCE ROW: the placement must land at this rank and
// local row, and its record must be the store's bytes there.
fn v41_record_defects(spec: V41RowStoreEncodingSpec, index: Map<String, String>, layer: Nat, r: VllmEngramRankRows, g: Int) -> List<NonEmptyStr> {
  let at = join([v41_store_key(layer: layer, rank: r.rank), " row ", to_string(g - r.start), " (global row ", to_string(g), ")"], "")
  let row = v41_source_row(layer: layer, global_row: g,
    weight: v41_reading_octets(index: index, s: V41SampleSourceWeight { layer: layer, global_row: g }),
    scale: v41_reading_octets(index: index, s: V41SampleSourceScale { layer: layer, global_row: g }))
  match v41_place_row(row: row, spec: spec) {
    V41PlacementRefused { defect: d } => [join(["store ", at, ": v41_place_row refused its source row: ", d as String], "") as NonEmptyStr]
    V41Placed { row: p } =>
      if p.rank != r.rank || p.local_row != g - r.start {
        [join(["store ", at, ": v41_place_row places this row at ", v41_store_key(layer: layer, rank: p.rank), " row ", to_string(p.local_row)], "") as NonEmptyStr]
      } else if p.record != v41_reading_octets(index: index, s: V41SampleStoreRecord { layer: layer, rank: r.rank, local_row: g - r.start }) {
        [join(["store ", at, ": the stored record is not v41_place_row of the published source row"], "") as NonEmptyStr]
      } else { [] as List<NonEmptyStr> }
  }
}

fn v41_magic_defects(index: Map<String, String>, layer: Nat, r: VllmEngramRankRows) -> List<NonEmptyStr> {
  if v41_reading_octets(index: index, s: V41SampleMagic { layer: layer, rank: r.rank }) == v41_magic_octets() { [] as List<NonEmptyStr> } else {
    [join(["store ", v41_store_key(layer: layer, rank: r.rank), ": the header is not the row-store magic"], "") as NonEmptyStr]
  }
}

// A BOUNDARY WHOSE TWO SOURCE ROWS ARE BYTE-IDENTICAL CANNOT SEE A SHIFT ACROSS IT.
fn v41_undiscriminated_boundaries(index: Map<String, String>, t: V41LayerTable) -> List<NonEmptyStr> {
  map(filter(filter(t.ranks, r => r.start > 0 && r.end > r.start), r =>
      v41_reading_hex(index: index, s: V41SampleSourceWeight { layer: t.layer, global_row: r.start - 1 }) == v41_reading_hex(index: index, s: V41SampleSourceWeight { layer: t.layer, global_row: r.start })
        && v41_reading_hex(index: index, s: V41SampleSourceScale { layer: t.layer, global_row: r.start - 1 }) == v41_reading_hex(index: index, s: V41SampleSourceScale { layer: t.layer, global_row: r.start })),
    r => join(["layer ", to_string(t.layer), " rows ", to_string(r.start - 1), " and ", to_string(r.start), " (the rank ", to_string(r.rank), " boundary) are byte-identical, so a shift across it cannot be seen; the readback is undiscriminating there"], "") as NonEmptyStr)
}

fn v41_readback_content_defects(spec: V41RowStoreEncodingSpec, index: Map<String, String>) -> List<NonEmptyStr> {
  flat_map(spec.layers, t => concat(
    v41_undiscriminated_boundaries(index: index, t: t),
    flat_map(filter(t.ranks, r => r.end > r.start), r => concat(
      v41_magic_defects(index: index, layer: t.layer, r: r),
      flat_map(v41_rank_edge_rows(r: r), g => v41_record_defects(spec: spec, index: index, layer: t.layer, r: r, g: g))))))
}

// THE VERDICT: Unread until a readback run's receipt is transcribed; any join or content defect refuses.
fn v41_store_readback(spec: V41RowStoreEncodingSpec, readings: V41StoreReadbackReadings) -> V41StoreReadback {
  match readings {
    V41StoreReadbackReadingsUnread { obligation: o } => V41StoreReadbackUnread { obligation: o }
    V41StoreReadbackRead { host: h, observed_at: at, readings: rs } => {
      let owed = v41_readback_samples(spec: spec)
      let join_defects = v41_readback_join_defects(spec: spec, owed: owed, readings: rs)
      if length(join_defects) != 0 { V41StoreReadbackRefused { defects: join_defects } } else {
        let index = fold(rs, init: empty_map(), f: (acc, r) => map_insert(acc, v41_readback_sample_key(s: r.sample), r.hex))
        let content = v41_readback_content_defects(spec: spec, index: index)
        if length(content) != 0 { V41StoreReadbackRefused { defects: content } } else {
          V41StoreReadbackVerified { host: h, observed_at: at, samples: length(owed) }
        }
      }
    }
  }
}

// THE LIVE READBACK. Its instrument is the spark_v41_row_store_readback fleet-converge mode
// (gunbc.spark.v41_row_store_readback_run v41_row_store_readback_ci_wet), which reads every owed sample on
