module gunbc.spark.native_cutover

import std.types { Bool, List, NonEmptyStr, String }
import std.nat { Nat }
import product.placement_supply { HostIdentity, host_identity_eq }
import extdeps.network.ipv4 { Ipv4Address, render_ipv4_address }
import gunbc.spark.serving_arm_launch {
  ArmLaunchPlan, ArmLaunchPlanned, ArmLaunchRefused,
  ArmNodeLaunch, ArmNode, glm_native_tp4_launch_plan,
  glm_native_container_name, glm_native_serve_port, glm_native_master_port,
}
import gunbc.spark.native_deployment_readback {
  NativeDeploymentObserved, DeploymentAcceptance, DeploymentAccepted, DeploymentRejected,
  DeploymentUnverified, DeploymentUnverifiable,
  inspect_native_deployment, accept_deployment,
}

// ── WHY A CUTOVER IS A TRANSACTION AND NOT A SEQUENCE OF STEPS ─────────────────────────────────
//
// The first native launch attempt on 2026-09-10 stopped a serving engine, failed to start its
// replacement, and left the fleet with no GLM endpoint for about ninety minutes. Every individual step
// was reasonable; what was missing was that the steps had no JOINT contract. Nothing had established
// beforehand that the replacement could start, nothing held a claim that would have made a second actor
// refuse, and nothing was obliged to put the incumbent back.
//
// SO THE PRECONDITIONS ARE A CLOSED ROSTER CHECKED BEFORE ANYTHING IS TOUCHED, and the roster is the
// point rather than its individual members. A precondition discovered halfway through is not a
// precondition; it is an outage with a diagnosis. The list below is written from what the failed attempt
// actually needed and did not have -- the image present on every rank being the one that cost the
// endpoint, since a 20 GB pull on two hosts outran the rendezvous window while two ranks waited.
//
// AND THE INCUMBENT IS RETAINED RATHER THAN REPLACED. Stopping without deleting is what makes the
// rollback a restart of a known-good container instead of a reconstruction from a model that has just
// been shown wrong. That is not a redundancy objective -- it is bounded rollback for one transaction,
// and it ends when the native arm has passed promotion.

type CutoverPrecondition
  = NativeSnapshotVerifiedOnEveryRank
  | RuntimeImageDigestPresentOnEveryRank
  | EveryRankHostReachable
  | NoStaleNativeContainers
  | MasterPortAvailable
  | ServingPortAvailable
  | FabricAddressesResolved
  | StaticRuntimeIntegrationObserved
  | IncumbentObservedAndRetainable
  | ExperimentAuthorizationClaimed

fn precondition_wire(p: CutoverPrecondition) -> NonEmptyStr {
  match p {
    NativeSnapshotVerifiedOnEveryRank => "the native snapshot is verified present on every rank" as NonEmptyStr
    RuntimeImageDigestPresentOnEveryRank => "the exact runtime image digest is present on every rank, so no rank pulls inside the rendezvous window" as NonEmptyStr
    EveryRankHostReachable => "every rank host answers" as NonEmptyStr
    NoStaleNativeContainers => "no stale native container or rank process survives from a previous attempt" as NonEmptyStr
    MasterPortAvailable => "the rendezvous port is free on the head" as NonEmptyStr
    ServingPortAvailable => "the serving port is free on every rank" as NonEmptyStr
    FabricAddressesResolved => "every rank's fabric rail address resolves" as NonEmptyStr
    StaticRuntimeIntegrationObserved => "the runtime's integration is observed by static probe at the exact digest" as NonEmptyStr
    IncumbentObservedAndRetainable => "the incumbent engine is observed and can be restarted without reconstruction" as NonEmptyStr
    ExperimentAuthorizationClaimed => "the experiment authorisation is granted and durably claimed" as NonEmptyStr
  }
}

// THE FULL ROSTER, WHICH IS WHAT MAKES "ALL PRECONDITIONS MET" A CHECKABLE CLAIM. A caller cannot assert
// readiness by naming the ones it happened to check: the fold below compares what was SATISFIED against
// this roster and names every member that is missing, so an unchecked precondition reads as unmet rather
// than as absent from the question.
data cutover_preconditions: List<CutoverPrecondition> = [
  NativeSnapshotVerifiedOnEveryRank,
  RuntimeImageDigestPresentOnEveryRank,
  EveryRankHostReachable,
  NoStaleNativeContainers,
  MasterPortAvailable,
  ServingPortAvailable,
  FabricAddressesResolved,
  StaticRuntimeIntegrationObserved,
  IncumbentObservedAndRetainable,
  ExperimentAuthorizationClaimed,
]

fn precondition_eq(a: CutoverPrecondition, b: CutoverPrecondition) -> Bool {
  (precondition_wire(p: a) as String) == (precondition_wire(p: b) as String)
}

fn precondition_satisfied(satisfied: List<CutoverPrecondition>, p: CutoverPrecondition) -> Bool {
  count(filter(satisfied, s => precondition_eq(a: s, b: p))) > 0
}

type CutoverStanding
  = CutoverAdmitted { plan: ArmLaunchPlan }
  | CutoverWithheld { unmet: List<NonEmptyStr> }

// A REFUSED PLAN WITHHOLDS EVEN WITH EVERY PRECONDITION MET, because the preconditions describe the
// WORLD and the plan describes what would be done to it. An arm whose runtime standing does not admit it
// has nothing to launch however ready the hosts are, and reporting that as a precondition failure would
// point a reader at the fleet when the refusal is in the model.
fn admit_cutover(plan: ArmLaunchPlan, satisfied: List<CutoverPrecondition>) -> CutoverStanding {
  let unmet = flat_map(cutover_preconditions, p =>
    if precondition_satisfied(satisfied: satisfied, p: p) { [] } else { [precondition_wire(p: p)] })
  match unmet.first() {
    Present { value: _ } => CutoverWithheld { unmet: unmet }
    Absent =>
      match plan {
        ArmLaunchRefused { cause: c } => CutoverWithheld { unmet: [c] }
        ArmLaunchPlanned { lines: _, master: _ } => CutoverAdmitted { plan: plan }
      }
  }
}

// ── THE TRANSACTION'S ORDERED STEPS, AS A MODELLED SEQUENCE ────────────────────────────────────
//
// THE ORDER IS THE SAFETY PROPERTY, so it is a value rather than the shape of some function's body. Two
// orderings differ in exactly one place that matters: whether the incumbent is stopped before or after
// everything that could refuse has refused. The failed attempt stopped it fourth of five; here it is
// stopped only after admission, and admission requires the roster above.
type CutoverStep
  = ReadClock
  | ClaimAuthorization
  | ObserveIncumbent
  | StopIncumbentRetainingIt
  | LaunchEveryRank
  | AwaitEndpointReadiness
  | ReadBackDeployment
  | RunSemanticRequest
  | CompleteClaim

data cutover_steps: List<CutoverStep> = [
  ReadClock,
  ClaimAuthorization,
  ObserveIncumbent,
  StopIncumbentRetainingIt,
  LaunchEveryRank,
  AwaitEndpointReadiness,
  ReadBackDeployment,
  RunSemanticRequest,
  CompleteClaim,
]

fn step_wire(s: CutoverStep) -> NonEmptyStr {
  match s {
    ReadClock => "read the clock" as NonEmptyStr
    ClaimAuthorization => "win the durable authorisation claim" as NonEmptyStr
    ObserveIncumbent => "observe the incumbent engine and record its launch line" as NonEmptyStr
    StopIncumbentRetainingIt => "stop the incumbent WITHOUT deleting it" as NonEmptyStr
    LaunchEveryRank => "launch every rank" as NonEmptyStr
    AwaitEndpointReadiness => "await endpoint readiness within the declared timeout" as NonEmptyStr
    ReadBackDeployment => "read back the exact deployment on every rank" as NonEmptyStr
    RunSemanticRequest => "run a real semantic request" as NonEmptyStr
    CompleteClaim => "complete the authorisation claim" as NonEmptyStr
  }
}

// THE INVARIANT THAT MATTERS, STATED AS A PREDICATE RATHER THAN AS PROSE: nothing destructive precedes
// the claim, and the incumbent is not stopped before it has been observed. A reordering that broke either
// would still typecheck, so this is the check that the ordering above is the intended one.
fn stop_follows_observation_and_claim(steps: List<CutoverStep>) -> Bool {
  let before_stop = steps_before(steps: steps, s: StopIncumbentRetainingIt)
  count(filter(before_stop, x => (step_wire(s: x) as String) == (step_wire(s: ClaimAuthorization) as String))) == 1
    && count(filter(before_stop, x => (step_wire(s: x) as String) == (step_wire(s: ObserveIncumbent) as String))) == 1
}

type StepScan sole_constructor {
  seen: List<CutoverStep>
  stopped: Bool
}

fn steps_before(steps: List<CutoverStep>, s: CutoverStep) -> List<CutoverStep> {
  fold(steps, init: StepScan { seen: [], stopped: false }, f: (acc, x) =>
    if acc.stopped { acc }
    else {
      if (step_wire(s: x) as String) == (step_wire(s: s) as String) { StepScan { seen: acc.seen, stopped: true } }
      else { StepScan { seen: concat(acc.seen, [x]), stopped: false } }
    }).seen
}

// ── THE OUTCOME, AND WHAT EACH ARM OBLIGES ────────────────────────────────────────────────────
//
// EVERY FAILING ARM CARRIES THE ROLLBACK OBLIGATION EXPLICITLY, because "restore the incumbent" is the
// step most easily lost in a failure path -- it is the one nobody is waiting for when something has just
// gone wrong. An outcome type that could describe a failed cutover WITHOUT saying what happened to the
// incumbent is the shape that produced a ninety-minute outage.
type CutoverOutcome
  = CutoverWithheldBeforeActing { unmet: List<NonEmptyStr> }
  | CutoverServingAndAccepted { receipt: NonEmptyStr }
  | CutoverRolledBack { failed_at: NonEmptyStr, incumbent_restored: Bool, detail: NonEmptyStr }
  | CutoverRolledBackAndIncumbentLost { failed_at: NonEmptyStr, detail: NonEmptyStr }

fn cutover_outcome_text(o: CutoverOutcome) -> String {
  match o {
    CutoverWithheldBeforeActing { unmet: us } =>
      join(["WITHHELD before acting; nothing was touched. Unmet: ", join(map(us, u => u as String), "; ")], "")
    CutoverServingAndAccepted { receipt: r } =>
      join(["the native arm is serving and its deployment was read back and accepted: ", r as String], "")
    CutoverRolledBack { failed_at: f, incumbent_restored: ok, detail: d } =>
      join([
        "ROLLED BACK at ", f as String, ": ", d as String,
        if ok { " -- the incumbent was restarted and observed serving" } else { " -- THE INCUMBENT WAS NOT CONFIRMED SERVING" },
      ], "")
    CutoverRolledBackAndIncumbentLost { failed_at: f, detail: d } =>
      join(["ROLLED BACK at ", f as String, " AND THE INCUMBENT IS DOWN, which is an outage requiring a person: ", d as String], "")
  }
}

// AN ACCEPTANCE THAT IS NOT AGREEMENT ROLLS BACK. Indeterminate is not a weaker yes: it means a fact the
// receipt would assert was never established, and the transaction has a running engine it cannot vouch
// for. Rolling back on it is what keeps the receipt honest, at the cost of occasionally discarding a
// deployment that was fine but unread.
fn acceptance_settles_cutover(a: DeploymentAcceptance) -> Bool {
  match a {
    DeploymentAccepted { receipt: _ } => true
    DeploymentRejected { deviations: _ } => false
    DeploymentUnverified { unknowns: _ } => false
    DeploymentUnverifiable { cause: _ } => false
  }
}

fn cutover_succeeded(o: CutoverOutcome) -> Bool {
  match o {
    CutoverServingAndAccepted { receipt: _ } => true
    CutoverWithheldBeforeActing { unmet: _ } => false
    CutoverRolledBack { failed_at: _, incumbent_restored: _, detail: _ } => false
    CutoverRolledBackAndIncumbentLost { failed_at: _, detail: _ } => false
  }
}

// AND A ROLLBACK THAT LEFT THE INCUMBENT DOWN IS NOT A SUCCESSFUL ROLLBACK, which is worth its own
// predicate because the failure path has two very different endings and only one of them is recoverable
// without a person.
fn cutover_left_an_outage(o: CutoverOutcome) -> Bool {
  match o {
    CutoverRolledBackAndIncumbentLost { failed_at: _, detail: _ } => true
    CutoverRolledBack { failed_at: _, incumbent_restored: ok, detail: _ } => !ok
    CutoverServingAndAccepted { receipt: _ } => false
    CutoverWithheldBeforeActing { unmet: _ } => false
  }
}

// ── THE FLEET'S OWN CUTOVER, PLANNED AND NOT PERFORMED ────────────────────────────────────────
//
// THE EFFECTFUL ROOT IS A DECLARED FRONTIER AND ITS TRIGGER IS NAMED. What is missing is not modelling
// but two things outside this module: the exact-head required floor passing, and an operator go-ahead for
// a destructive cutover. Until both, this module decides and reports and touches nothing -- which is the
// honest state for a transaction whose first destructive step stops a live service.
//
// SUFFICIENT FOR: the wet root is admissible once `admit_cutover` returns CutoverAdmitted from receipts
// gathered on the real hosts, the floor is green at the exact head, and the operator has authorised the
// displacement. It consumes THIS decision rather than re-deriving one, so the thing reviewed here is the
// thing that runs.
fn glm_native_cutover_standing(satisfied: List<CutoverPrecondition>) -> CutoverStanding {
  admit_cutover(plan: glm_native_tp4_launch_plan(), satisfied: satisfied)
}

// NOTHING IS SATISFIED YET, AND THIS ROW SAYS SO RATHER THAN LEAVING IT TO BE INFERRED. Several members
// have real receipts already -- the snapshot is verified on all four ranks, the digest resolves
// identically on all four, the addresses derive, the static probe passed -- but a receipt gathered by a
// person reading a terminal is not the same as one this fold consumed, and recording them here as
// satisfied would assert a join that has not happened.
data glm_native_cutover_satisfied_today: List<CutoverPrecondition> = []
