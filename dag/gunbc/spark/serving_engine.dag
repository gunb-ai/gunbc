module gunbc.spark.serving_engine

import std.types { Bool, List, NonEmptyStr, String }
import std.nat { Nat }
import std.measure { TokenCount, Percent, PositiveSlotCount, Millisecond }
import std.types { Port }
import extdeps.memory.types { MemoryKind, UnifiedShared, Dram, Hbm }
import extdeps.vllm.engine_args { VllmEngineArgs, VllmDistributedExecutorBackend, ExecutorRay, ExecutorMp, ExecutorExternalLauncher }
import extdeps.ray.threshold_memory_monitor {
  RayBuiltMonitor, ThresholdMonitorBuilt, EventMonitorBuilt, NoopMonitorBuilt,
  ray_linux_built_monitors, ray_built_monitor_enforces
}

type SparkServingBindListen {
  host: NonEmptyStr
  port: Port
}


// THE VALUES THE OLLAMA PROCESS WILL ACTUALLY CONSUME.
//
// This replaces `InferenceCapacityPolicy` + `SparkServingServingPolicy`, which bundled two facts of
// different kinds: a runtime LAUNCH PARAMETER the server reads at startup, and a
// `shared_memory_budget_bytes` ADMISSION CONSTRAINT that no reconciliation path ever consumed. The
// bundle is why "capacity is declared" read as true when only one half could ever be causal -- the
// dead field sat behind the live one. The admission constraint is deleted rather than carried
// forward unread, on the same ruling that removed this module's endpoint credential: a required
// field with no consumer is not a placeholder for a future check, it is a fact the model asserts
// and never verifies.
//
// The old context field was named `max_model_len`, which is vLLM's flag. The only runtime modeled
// here is Ollama, whose grounded name is OLLAMA_CONTEXT_LENGTH -- so the field was named for a
// runtime this deployment does not serve, and would have read as authority the moment a second
// runtime landed.
//
// `TokenCount` rather than a bare `Nat`: std.measure already owns the token-count family beside
// HardwareThreadCount and CharacterCount, so a bare Nat here would be a fourth spelling of a
// quantity the measure authority names.
//
// The profile is a VALUE, not a second serialized identity. Its canonical identity is the content
// identity of the rendered unit bytes (gunbc.spark.serving_unit_render
// spark_serving_user_unit_content_identity), which the desired and observed sides already share --
// enumerating these fields into another hand-maintained hash tree would put one fact in two
// identity domains.
fn spark_serving_bind_listen_wire(bind: SparkServingBindListen) -> String {
  join([bind.host as String, ":", to_string(bind.port)], "")
}

type OllamaServingLaunchProfile {
  bind: SparkServingBindListen
  default_context: TokenCount
  serving_slots: PositiveSlotCount
}

// THE ENGINE AXIS. `what is served` and `how it is served` were one row, and this separates them.
//
// THE FUSION THIS REPLACES. `gunbc.spark.serving_desired` declared its desired state as an
// `OllamaResolvedManifest` plus an `OllamaServingLaunchProfile`, so the ARTIFACT and the RUNTIME were
// a single fact whose only inhabitant was Ollama. `gunbc.spark.serving_release` already recorded the
// consequence from inside: its context field had to be renamed off `max_model_len` because that
// spelling "would have read as authority the moment a second runtime landed". The second runtime has
// landed, so the axis is cut here rather than by widening the Ollama profile -- which is the move
// `extdeps.ollama.api` forbids in its own header.
//
// WHY THE ENUMERATION LIVES IN GUNBC AND NOT IN EXTDEPS. DESIGN section 3 lets a generic hub define
// agnostic shapes but forbids it from enumerating concrete products or dispatching among their
// authorities. Ollama and vLLM are independently governed upstreams with their own extdeps modules;
// the CHOICE between them is this repository's policy, and the dispatch that selects a realization
// is itself realization, so it sits here at the periphery and never inside either citation.
type ServingEngine
  = OllamaServing { profile: OllamaServingLaunchProfile }
  | VllmServing { args: VllmEngineArgs }

fn serving_engine_label(engine: ServingEngine) -> NonEmptyStr {
  match engine {
    OllamaServing { profile: _ } => "ollama" as NonEmptyStr
    VllmServing { args: _ } => "vllm" as NonEmptyStr
  }
}

// ── ONE POOL, ONE ENGINE ───────────────────────────────────────────────────────────────────────
//
// A UNIFIED POOL HAS NO ARBITER, WHICH IS A STRUCTURAL FACT AND NOT A TUNING PREFERENCE.
// `gunbc.spark.cell_role` already states that two roles on one unified pool have no arbiter; this is
// that sentence made refusable. On a discrete-VRAM host two engines contend for VRAM and the driver
// arbitrates. On a GB10 the pool is UNIFIED: a second launcher's allocation comes out of the same
// bytes the first engine's weights and the KERNEL are living in, so the failure is not a slow
// neighbour but a starved host.
//
// MEASURED, TWICE, AND BOTH TIMES THE HOST DID NOT SURVIVE IT. A checkpoint whose weights exceed the
// usable pool starves the host in tens of seconds and needs a physical power cycle -- there is no
// software recovery path, which is why this is a refusal and not a warning. The second occurrence had
// a different proximate cause and the same shape: a launcher's free-memory probe failed, fell back to
// a STALE reading, and loaded on top of a live engine. A probe that can answer from a stale reading
// is not an arbiter, so co-tenancy is refused by construction rather than guarded by a check.
type SparkEngineSlotVerdict
  = EngineSlotAvailable
  | EngineSlotRefused { cause: SparkEngineSlotRefusal }

// ONE ARM, BECAUSE ONE ARM HAS A PRODUCER. A `WeightsExceedUsablePool` arm stood here and was never
// emitted by any function in this module. The fact it named is real and measured -- a checkpoint
// whose weights exceed a Spark's usable pool starves the host in tens of seconds -- but DECIDING it
// needs two facts this module does not have yet: the host's usable pool (a GB10 hardware row) and
// the artifact's weight bytes (a checkpoint row). Until both exist the arm could only ever be
// constructed by hand, which makes it a fact the model asserts and never verifies.
//
// `gunbc.spark.serving_release` already made this ruling against itself, deleting a
// `shared_memory_budget_bytes` admission constraint that no reconciliation path consumed, on the
// ground that "a required field with no consumer is not a placeholder for a future check". Carrying
// a never-produced arm here would have reproduced that defect inside the change that cites it.
// It returns with its producer, not before.
type SparkEngineSlotRefusal
  = UnifiedPoolAlreadyOccupied { incumbent: NonEmptyStr, applicant: NonEmptyStr }

// The host memory kind DECIDES this, so the rule is derived from the observed hardware row rather
// than asserted per host. A discrete-memory host is genuinely out of this rule's scope; saying so
// explicitly keeps the refusal honest instead of universal-by-accident.
fn spark_engine_slot_admits(
  memory_kind: MemoryKind,
  incumbent: ServingEngine?,
  applicant: ServingEngine,
) -> SparkEngineSlotVerdict {
  match memory_kind {
    Dram => EngineSlotAvailable
    Hbm => EngineSlotAvailable
    UnifiedShared =>
      match incumbent {
        Absent => EngineSlotAvailable
        Present { value: held } =>
          EngineSlotRefused {
            cause: UnifiedPoolAlreadyOccupied {
              incumbent: serving_engine_label(engine: held),
              applicant: serving_engine_label(engine: applicant)
            }
          }
      }
  }
}

// ── EXACTLY ONE MEMORY ENFORCER, AND WHAT IT COUNTS IS DERIVED FROM WHAT IT IS ─────────────────
//
// TWO ENFORCERS WITH DIFFERENT DEFINITIONS OF "USED" KILL YOU WITH THE ONE YOU WERE NOT WATCHING.
// Measured: Ray's threshold monitor counts the GPU reservation as node memory, so at a high
// utilization the node reads near its kill line with ZERO requests in flight, and the monitor
// SIGKILLs the largest worker -- no traceback, no Python exception, and the kernel's own oom_kill
// counter stays at zero, which is what makes the death look unexplained. A second enforcer keyed on
// MemAvailable sat BELOW that line and therefore could never fire first.
//
// WHAT IS COUNTED IS A PROPERTY OF THE ENFORCER, SO IT IS DERIVED AND NOT DECLARED. A
// `counts_device_reservation: Bool` field stood here beside `kind` and was read by nothing. It was
// two defects at once: a second authority for a fact `kind` already decides, and -- worse -- a
// required field with no consumer, which is a fact the model asserts and never verifies. It is now
// a total function of the kind, so a caller cannot declare that one of Ray's monitors ignores the
// device reservation. A `swap_aware` field is deleted outright rather than derived: it had no
// consumer AND no measurement behind it for any kind, and deriving it would have been invention.
// RAY'S THRESHOLD MONITOR IS TWO SUBJECTS, NOT ONE, AND THE FORK IS THE ISOLATION FLAG. The tagged
// header says it plainly: with resource isolation enabled the threshold monitor "will only monitor
// user application memory usage", and with it disabled it reads node memory. Those observe different
// populations, so they cannot share one accounting answer. The measurement this module was built
// around -- a node-memory reading that includes the GPU reservation -- is about the NON-isolated
// path; nothing here establishes that a resource-isolated user slice charges that reservation the
// same way. Collapsing them would have extended a measured fact to an unmeasured subject, which is
// the defect the event-monitor arm just closed, reappearing one kind over.
//
// RAY'S MONITORS ARE SEPARATE KINDS, BECAUSE THEY MEASURE DIFFERENT THINGS. An earlier revision had
// a single `RayThresholdMonitor` standing for "Ray is enforcing", which forced every live Ray
// configuration to be reported as the threshold monitor -- including the one where the factory
// builds no threshold monitor at all. A refusal that names the wrong one is a fabricated cause,
// which is worse than no refusal because it will be read as a finding. HOW each one triggers is a
// property of Ray's implementations and is stated by the citation, not restated here.
type MemoryEnforcerKind
  = RayHostThresholdMonitor
  | RayUserSliceThresholdMonitor
  | RayEventMonitor
  | HostMemGuard
  | KernelOomKiller

// WHETHER AN ENFORCER SEES THE DEVICE RESERVATION HAS THREE ANSWERS, AND THE THIRD IS NOT A `false`.
//
// ESTABLISHED -- ONE KIND, NOT THE WHOLE THRESHOLD FAMILY. The NON-ISOLATED host threshold monitor
// polls a node byte total that includes the reservation; that is the measured asymmetry and the whole
// reason a unified pool tolerates some of these and not others. The host guard is keyed on
// MemAvailable and the kernel killer on resident pages, and neither can see a reservation that was
// never faulted in.
//
// UNESTABLISHED -- TWO KINDS, AND NAMING ONLY ONE OF THEM WAS ITSELF A DEFECT. An earlier version of
// this paragraph presented the EVENT monitor as the sole unknown while speaking of "the threshold
// monitor" as a single counting subject. That re-fused in prose the two threshold subjects the type
// had just been split into, so the annotation and the executable partition disagreed about the very
// distinction the split existed to make. Both the ISOLATED user-slice threshold monitor and the event
// monitor are unknown: nothing read for this module says whether either accounting includes a device
// reservation on a unified pool, and no mechanism story is asserted here to explain why, because a
// borrowed explanation would be a citation to a file nobody here read.
//
// A `Bool` has nowhere to put that: returning `false` would assert it is safe on the strength of not
// having checked, which is the fabricated-plausible-answer failure, and returning `true` would invent
// the measurement. So the answer is a third arm, and on a unified pool it REFUSES -- an enforcer whose
// accounting is unknown is exactly as unsafe to admit as one known to double-count, and the
// difference belongs in the CAUSE, not in the verdict.
type DeviceReservationAccounting = CountsReservation | ExcludesReservation | AccountingUnestablished

fn memory_enforcer_device_reservation_accounting(kind: MemoryEnforcerKind) -> DeviceReservationAccounting {
  match kind {
    RayHostThresholdMonitor => CountsReservation
    RayUserSliceThresholdMonitor => AccountingUnestablished
    RayEventMonitor => AccountingUnestablished
    HostMemGuard => ExcludesReservation
    KernelOomKiller => ExcludesReservation
  }
}

type EnforcerVerdict
  = EnforcerAdmitted { enforcer: MemoryEnforcerKind }
  | EnforcerRefused { cause: EnforcerRefusal }

type EnforcerRefusal
  = NoEnforcerDeclared
  | MoreThanOneEnforcer { count: Nat }
  | DeviceReservationCountingEnforcerOnUnifiedPool { kind: MemoryEnforcerKind }
  | UnestablishedReservationAccountingOnUnifiedPool { kind: MemoryEnforcerKind }

// AN IMPLIED ENFORCER IS STILL AN ENFORCER, SO IT JOINS THE LIST INSTEAD OF BECOMING A SEPARATE ARM.
// A Ray-backed executor brings a memory monitor with it whether or not anyone declared it -- WHICH
// monitor depends on the configuration and is read from the citation, not assumed to be the
// threshold one. That
// used to be decided in the refusal function from the `backend` argument, which meant the rule was
// keyed on the applicant's launch flag rather than on the enforcers actually live -- so a
// `RayThresholdMonitor` sitting in the DECLARED list with the flag off was admitted, and a Ray
// launch with an empty declared list refused as `NoEnforcerDeclared`, naming the wrong fact. Making
// the implied monitor a real member of the list dissolves both: there is one population and one set
// of rules over it.
// WHETHER RAY IS ENFORCING IS READ FROM RAY, NOT RE-DECIDED HERE. This function took a
// `ray_monitor_disabled: Bool` produced by nobody, which was a second authority for a question
// `extdeps.ray.threshold_memory_monitor` already answers from pinned `ray-2.58.0` source -- and the
// two AGREED ONLY BY ACCIDENT. "Disabled" is spelled as a zero refresh interval, and at a zero
// interval the factory does NOT stop enforcing: it swaps the threshold monitor for a Noop while the
// EVENT monitor, pushed before the interval is ever read, keeps enforcing. So the Bool answered []
// for a host that has a live enforcer, and the refusal below would have reported
// `NoEnforcerDeclared` against a host that was being enforced -- naming the wrong fact, which is the
// exact defect the declared-population rewrite above was meant to end.
//
// THE SELECTION INPUTS ARE THE FACTORY'S, so they are the parameters: the same two arguments
// `ray_linux_built_monitors` selects on. A caller can no longer assert Ray's enforcement state; it
// supplies what Ray was configured with and the citation decides.
//
// RAY CONTRIBUTES AT MOST ONE MEMBER, WHICH IS NOT THE SAME AS ONE MONITOR. With isolation on and a
// live interval the factory builds TWO enforcing monitors, event and threshold. Mapping monitors to
// members one-for-one would hand `MoreThanOneEnforcer { count: 2 }` to every ordinary Ray host,
// turning a correct citation into a refusal of the normal case. The population this module counts is
// ENFORCING SUBSYSTEMS over one pool, and Ray is one of those however many objects it builds
// internally -- so the cardinality join is `any`, not a map.
//
// BUT THE MEMBER MUST NAME WHAT WAS ACTUALLY BUILT. A first version of this derivation answered
// `[RayThresholdMonitor]` whenever anything enforced, and at a zero interval with isolation on the
// factory builds `[Event, Noop]` -- NO THRESHOLD MONITOR. That labelled the event monitor as the
// threshold monitor and then inherited the threshold monitor's device-reservation accounting for it,
// so the refusal named a mechanism that was not present. Right host, invented cause. Whether
// anything enforces is read from `ray_built_monitor_enforces`; WHICH enforcer it is comes from the
// composition, so the two questions stay separate.
fn ray_implied_enforcers(
  backend: VllmDistributedExecutorBackend,
  resource_isolation_enabled: Bool,
  monitor_refresh: Millisecond,
) -> List<MemoryEnforcerKind> {
  match backend {
    ExecutorMp => []
    ExecutorExternalLauncher => []
    ExecutorRay =>
      ray_enforcing_member(
        built: ray_linux_built_monitors(
          resource_isolation_enabled: resource_isolation_enabled,
          refresh: monitor_refresh,
        ),
        resource_isolation_enabled: resource_isolation_enabled,
      )
  }
}

fn ray_built_monitor_is_threshold(m: RayBuiltMonitor) -> Bool {
  match m {
    ThresholdMonitorBuilt => true
    EventMonitorBuilt => false
    NoopMonitorBuilt => false
  }
}

// THE ISOLATION FLAG SURVIVES THE SELECTION, BECAUSE IT NAMES THE THRESHOLD MONITOR'S SUBJECT. An
// earlier version consumed it only to decide WHICH monitors the factory builds and then dropped it,
// so every threshold monitor got the node-memory accounting answer whether it was reading node
// memory or a user slice. The flag is threaded through to the member instead.
fn ray_enforcing_member(
  built: List<RayBuiltMonitor>,
  resource_isolation_enabled: Bool,
) -> List<MemoryEnforcerKind> {
  match any(built, m => ray_built_monitor_enforces(m: m)) {
    false => []
    true =>
      match any(built, m => ray_built_monitor_is_threshold(m: m)) {
        false => [RayEventMonitor]
        true =>
          match resource_isolation_enabled {
            true => [RayUserSliceThresholdMonitor]
            false => [RayHostThresholdMonitor]
          }
      }
  }
}

// `enforcers` IS THE DECLARED POPULATION, AND A FUTURE PRODUCER MUST KEEP IT THAT WAY. The implied
// monitor is added HERE, so a caller that also observes the running Ray monitor and lists it would
// supply one physical enforcer twice and get `MoreThanOneEnforcer { count: 2 }` for a host that has
// one. The rule is therefore that this parameter carries what was DECLARED and never what was
// observed to be running: an observation of one of Ray's monitors is evidence that the backend is
// Ray, which
// this function already implies from, not a second member. Recorded here rather than left to the
// first producer to rediscover, because the shape admits the mistake silently.
//
// THE IMPLICATION BELONGS INSIDE THIS FUNCTION AND NOT AT ITS CALLERS. Pushing it outward makes
// every caller responsible for remembering that a live Ray backend brings a monitor, which is
// exactly how the `NoEnforcerDeclared` misdiagnosis this function used to give becomes representable
// again -- one caller forgets, and the refusal names the declaration instead of the host.
//
// ONE POPULATION, THREE RULES, IN ORDER. None, more than one, and -- on a unified pool only -- an
// enforcer that counts the device reservation. The third is a refusal rather than a warning because
// trading KV pool for headroom underneath a mis-calibrated counter spends the resource the
// deployment exists to provide in order to appease a measurement of the wrong thing.
fn spark_memory_enforcer_admits(
  memory_kind: MemoryKind,
  enforcers: List<MemoryEnforcerKind>,
  resource_isolation_enabled: Bool,
  monitor_refresh: Millisecond,
  backend: VllmDistributedExecutorBackend,
) -> EnforcerVerdict {
  let live = concat(
    enforcers,
    ray_implied_enforcers(
      backend: backend,
      resource_isolation_enabled: resource_isolation_enabled,
      monitor_refresh: monitor_refresh,
    ),
  )
  match first(live) {
    Absent => EnforcerRefused { cause: NoEnforcerDeclared }
    Present { value: e } =>
      match length(live) > 1 {
        true => EnforcerRefused { cause: MoreThanOneEnforcer { count: length(live) } }
        false =>
          unified_pool_accounting_verdict(memory_kind: memory_kind, kind: e)
      }
  }
}

// A DISCRETE HOST IS OUTSIDE THIS RULE. There the device reservation and the host's own memory are
// separately accounted, so a monitor that counts the reservation is merely conservative rather than
// wrong -- the refusal is about a UNIFIED pool, where the two are the same bytes.
fn unified_pool_accounting_verdict(memory_kind: MemoryKind, kind: MemoryEnforcerKind) -> EnforcerVerdict {
  match memory_kind {
    Dram => EnforcerAdmitted { enforcer: kind }
    Hbm => EnforcerAdmitted { enforcer: kind }
    UnifiedShared =>
      match memory_enforcer_device_reservation_accounting(kind: kind) {
        ExcludesReservation => EnforcerAdmitted { enforcer: kind }
        CountsReservation =>
          EnforcerRefused { cause: DeviceReservationCountingEnforcerOnUnifiedPool { kind: kind } }
        AccountingUnestablished =>
          EnforcerRefused { cause: UnestablishedReservationAccountingOnUnifiedPool { kind: kind } }
      }
  }
}
