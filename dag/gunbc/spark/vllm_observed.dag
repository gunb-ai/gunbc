module gunbc.spark.vllm_observed

import std.types { Bool, List, NonEmptyStr, String }
import product.placement_supply { HostIdentity }
import gunbc.fleet_intent_network { operator_host_srv6 }
import extdeps.vllm.server {
  VllmRoute,
  VllmRouteAvailability,
  AlwaysServed,
  ServedOnlyUnderDevelopmentMode,
  VllmCacheCapacityAuthority,
  GroupAwareStartupLogLine,
}

// A DATED OBSERVATION OF ONE vLLM FRONT DOOR, AND A REFUSAL TO CALL IT A TENSOR-PARALLEL REALIZATION.
//
// This module exists because gunbc.spark.serving_desired names an Ollama runtime for hosts that were
// running something else, and gunbc.spark.serving_convergence_withholding refuses to converge them
// until the corpus can describe what is there. This is the first half of describing it: what was
// actually read back, and -- the load-bearing half -- what that readback is NOT sufficient to claim.
//
// THE OBSERVATION IS HISTORICAL BY THE TIME YOU READ IT, and that is a property of the subject rather
// than staleness in the record. The front door answered on 2026-09-03 and had stopped answering
// within the hour. So this is a receipt about one incarnation, not a description of a service, and
// nothing here may be read as "what is running".
type VllmObservedRuntime sole_constructor {
  front_door_host: HostIdentity
  server_version: NonEmptyStr
  served_model_id: NonEmptyStr
  model_artifact_root: NonEmptyStr
  max_model_len: NonEmptyStr
  kv_cache_dtype: NonEmptyStr
  gpu_memory_utilization: NonEmptyStr
  prefix_caching_enabled: Bool
}

// EVERY FIELD HERE WAS READ OFF THE WIRE, which is the only reason each one is present.
//
// server_version and served_model_id and model_artifact_root come from /version and /v1/models; the
// remaining four from the vllm:cache_config_info gauge on /metrics. The artifact root is carried
// because it is what SETTLES a question the served id cannot: the id reads "iq3s-split", which names
// a quantisation this deployment is not running -- it is a --served-model-name alias chosen so the
// router's model name matched the other pair. The root points at the official checkpoint snapshot.
// A reader who has only the id will conclude the wrong thing about the weights, and did.
data vllm_observed_runtime_2026_09_03: VllmObservedRuntime = VllmObservedRuntime {
  front_door_host: operator_host_srv6,
  server_version: "0.21.1rc1.dev339+g1967a5627bc3" as NonEmptyStr,
  served_model_id: "deepseek-v4-flash:iq3s-split" as NonEmptyStr,
  model_artifact_root: "models--deepseek-ai--DeepSeek-V4-Flash/snapshots/60d8d70770c6776ff598c94bb586a859a38244f1" as NonEmptyStr,
  max_model_len: "262144" as NonEmptyStr,
  kv_cache_dtype: "fp8_ds_mla" as NonEmptyStr,
  gpu_memory_utilization: "0.86" as NonEmptyStr,
  prefix_caching_enabled: true,
}

// WHY THERE IS NO TENSOR-PARALLEL REALIZATION IN THIS MODULE.
//
// The obvious next step is a VllmTpRealization carrying a parallel degree and a worker population.
// It is not authorable from this readback, and the reason is not that the observation was sloppy --
// it is that the evidence for a distributed population is not on the surface that was read.
//
// THE REFUSAL NAMES THE MISSING POSITIVE FACT, NOT A MISSING RESPONSE. It would be easy to refuse
// because the second host did not answer on the front-door port. That would be modelling the absence
// of something never promised: a tensor-parallel worker is NOT required to expose its own
// OpenAI-compatible server, and one front door is the normal shape. Refusing on a silent port
// invents a contract in order to fail it, and would go green the moment someone published an
// unrelated server there.
//
// What is actually missing is a POSITIVE JOINED-RANK POPULATION RECEIPT: evidence that this front
// door belongs to an engine incarnation whose resolved topology is tensor-parallel and whose worker
// set contains every expected rank on the selected hosts. One coordinator front door CAN establish
// that -- but only by carrying rank-local evidence, or by completing execution whose construction
// necessarily involved every rank. A configured world size, a front-end summary, a generic health
// check, or a silent port cannot.
//
// AND THE ROUTES THAT COULD ANSWER IT WERE NOT SERVED. The development-mode population
// (extdeps.vllm.server: /server_info, /get_world_size, /collective_rpc) is where resolved parallel
// configuration and per-worker fan-out live. All three returned 404, which under that module's route
// split means the server was launched without development mode.
//
// THAT IS NOT A REASON TO RELAUNCH IT. /collective_rpc executes an arbitrary named method across
// every worker and upstream documents development mode as unfit for production. Restarting a live
// serving deployment with a dangerous endpoint exposed in order to satisfy a receipt would be
// spending a real safety property to buy a modelling convenience -- and the withholding this feeds
// already holds without it. The receipt waits for a vantage that does not require the mutation.
// THE REFUSAL IS NOT A VERDICT, AND MODELLING IT AS ONE WOULD BE THE LIE. A verdict type implies a
// reachable admission arm; this readback has none, so the function returns a refusal outright rather
// than a two-arm result whose second arm no evidence in this repository can build.
//
// THE STAGE MATTERS AND IS WHY THIS IS A COPRODUCT. The population question is downstream of the
// configuration question: you cannot ask whether every expected rank is present until you know how
// many ranks are expected, and the expected set must be DERIVED from resolved parallel configuration
// rather than supplied by whoever is asking -- otherwise the caller authors both sides of its own
// join. Because the development-mode routes were absent, this observation did not even reach the
// configuration stage, so it refuses at the earlier arm. Recording that distinction is what tells a
// later reader whether the next step is one call or two.
type VllmTpRealizationMissingEvidence
  = ResolvedParallelConfigurationNotObserved
  | JoinedRankPopulationNotObserved

type VllmTpRealizationRefusal sole_constructor {
  front_door_host: HostIdentity
  missing: VllmTpRealizationMissingEvidence
}

fn vllm_tp_realization_missing_wire(missing: VllmTpRealizationMissingEvidence) -> String {
  match missing {
    ResolvedParallelConfigurationNotObserved =>
      "the resolved parallel configuration was not observed, so the expected rank set is not even derivable yet"
    JoinedRankPopulationNotObserved =>
      "the resolved parallel configuration is known but no receipt places every expected rank on the selected hosts"
  }
}

fn vllm_tp_realization_refusal_cause(refusal: VllmTpRealizationRefusal) -> String {
  join([
    "vllm tensor-parallel realization refused for the front door on ",
    refusal.front_door_host as String,
    ": ",
    vllm_tp_realization_missing_wire(missing: refusal.missing),
    ". This is a missing positive fact, not an unanswered port: a tensor-parallel worker is not ",
    "required to serve its own front door, so refusing on a silent port would invent a contract in ",
    "order to fail it",
  ], "")
}

data vllm_tp_realization_2026_09_03: VllmTpRealizationRefusal = VllmTpRealizationRefusal {
  front_door_host: operator_host_srv6,
  missing: ResolvedParallelConfigurationNotObserved,
}

// THE CAPACITY FIELD THIS MODULE DELIBERATELY DOES NOT CARRY.
//
// The gauge also exposed num_gpu_blocks (23191) and a resolved minimum block_size (16), and their
// product was computed, called the live token pool, and published. It is not one:
// extdeps.vllm.server vllm_cache_capacity_authority records why -- the gauge reports configuration,
// the engine computes capacity group-aware for multi-group cache layouts, and the answer appears in
// a startup log line rather than in any metric.
//
// The two numbers are real observations and could be carried honestly. They are omitted anyway,
// because a block count sitting in a serving-capacity carrier will be multiplied by the next person
// who finds it -- the same move, made again, by someone with less context. The field returns when
// the startup log line does.
type VllmObservedCapacity
  = CapacityNotObserved
  | CapacityFromGroupAwareStartupLog { pool_tokens: NonEmptyStr }

data vllm_observed_capacity_2026_09_03: VllmObservedCapacity = CapacityNotObserved

fn vllm_observed_capacity_authority() -> VllmCacheCapacityAuthority { GroupAwareStartupLogLine }
