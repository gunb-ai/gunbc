module gunbc.spark.vllm_observed

import std.types { Bool, List, NonEmptyStr, String }
import product.placement_supply { HostIdentity }
import gunbc.fleet_intent_network { operator_host_srv6 }
import extdeps.vllm.server {
  vllm_build_identity,
  VllmRoute,
  VllmRoutePopulation,
  OrdinarilyRegistered,
  RegisteredOnlyUnderDevelopmentMode,
  VllmBuildIdentity,
  vllm_parallel_evidence_routes,
  VllmEvidenceKind,
  VllmEvidenceRoute,
  vllm_evidence_kind_establishes_configuration,
  VllmCapacityEvidenceProposal,
  CacheConfigBlockFields,
  GroupAwareStartupLogCapture,
  VllmCapacityEvidenceVerdict,
  CapacityEvidenceAdmitted,
  CapacityEvidenceRefused,
  decide_vllm_capacity_evidence,
}

// A DATED READBACK OF ONE vLLM FRONT DOOR, AND A REFUSAL TO CALL IT A TENSOR-PARALLEL REALIZATION.
//
// gunbc.spark.serving_desired names an Ollama runtime for hosts that were running something else,
// and gunbc.spark.serving_convergence_withholding refuses to converge them until the corpus can
// describe what is there. This is the first half of describing it -- and the load-bearing half is
// what the readback is NOT sufficient to claim.
//
// THE OBSERVATION IS HISTORICAL, AND THAT IS A PROPERTY OF THE SUBJECT. The front door answered on
// 2026-09-03 and had stopped answering within the hour. This is a receipt about one acquisition, not
// a description of a service, and nothing here may be read as "what is running".

// FIELDS ARE GROUPED BY THE ROUTE THEY CAME FROM, WHICH IS NOT TIDINESS -- IT IS A CORRECTION.
//
// A single flat runtime record let the pull request attribute max_model_len to the cache-config
// gauge. It came from /v1/models; the gauge never reported it. One record with a prose sentence
// about provenance is exactly the shape that lets provenance drift from the value, so provenance is
// now structural: a field cannot be described as coming from a route it does not sit under.
type VllmModelsRouteReadback sole_constructor {
  served_model_id: NonEmptyStr
  configured_model_path: NonEmptyStr
  max_model_len: NonEmptyStr
}

// THE PATH IS A CONFIGURED PATH, NOT A CONTENT IDENTITY, AND THE FIELD NAME NOW SAYS SO.
//
// An earlier name, model_artifact_root, invited the reading that this ESTABLISHES which weights are
// loaded -- and I published exactly that reading upward, saying the official checkpoint was
// confirmed first-hand. It is not confirmed. /v1/models reports the path the server was configured
// with. That is strong evidence about intent and no evidence about bytes: nothing here digests the
// weights, and a path can name a directory whose contents were replaced.
//
// What the field DOES settle is narrower and still worth having: the served id advertises a
// quantisation the configured path contradicts, which is enough to refuse the id as an artifact
// claim without asserting anything about what is actually on disk.
type VllmVersionRouteReadback sole_constructor {
  server_version: NonEmptyStr
}

type VllmCacheConfigGaugeReadback sole_constructor {
  kv_cache_dtype: NonEmptyStr
  gpu_memory_utilization: NonEmptyStr
  prefix_caching_enabled: Bool
}

// AN ACQUISITION IS ONE READ OF ONE INCARNATION, and every fact below belongs to it.
//
// The reviewer's rule that killed the previous shape: a historical readback must be bound to an
// incarnation and to one acquisition, or a later observation of a DIFFERENT launch can be joined to
// it and inherit its standing. That is not hypothetical here -- the 1,048,576-context launch that
// was measured earlier is a different incarnation of the same pair, and treating its numbers as
// current is the precise error this module exists downstream of.
type VllmReadbackAcquisition sole_constructor {
  front_door_host: HostIdentity
  observed_on: NonEmptyStr
  build: VllmBuildIdentity
}

// THE REFUSAL IS NOT A VERDICT, AND MODELLING IT AS ONE WOULD BE THE LIE. A verdict type implies a
// reachable admission arm; this readback has none, so the transaction carries a refusal outright.
//
// THE STAGE MATTERS AND IS WHY THIS IS A COPRODUCT. The population question is downstream of the
// configuration question: you cannot ask whether every expected rank is present until you know how
// many are expected, and that expected set must be DERIVED from resolved parallel configuration
// rather than supplied by whoever is asking, or the caller authors both sides of its own join.
type VllmTpRealizationMissingEvidence
  = ResolvedParallelConfigurationNotObserved
  | JoinedRankPopulationNotObserved

type VllmTpRealizationRefusal sole_constructor {
  front_door_host: HostIdentity
  missing: VllmTpRealizationMissingEvidence
}

// AN EVIDENCE ROUTE THAT DID NOT ANSWER, AND THE CONCLUSION IT DOES NOT SUPPORT.
//
// The three parallel-evidence routes returned 404. The pull request said this means "the server was
// launched without development mode". It does not. A 404 establishes that the route was not
// available at that moment; it does not read a launch flag, and it cannot distinguish an unset flag
// from a build without the route, a proxy stripping it, or a path that moved between versions.
//
// What the 404 DOES establish is the only thing this module needs: the evidence was unreachable.
// The refusal rests on that and not on the inferred cause, so it survives the inference being wrong.
type VllmEvidenceRouteOutcome sole_constructor {
  route: VllmEvidenceRoute
  answered: Bool
}

// THE TRANSACTION IS WHY THESE CANNOT DISAGREE.
//
// Previously the readback and the refusal were separate rows that each named a host, so the host in
// one could be edited to srv5 while the other still said srv6 and every witness stayed green. The
// refusal is now DERIVED from the acquisition inside the constructor, so a divergent pair has no
// constructor at all -- construction over validation, rather than a witness that checks two rows
// agree.
type VllmReadbackTransaction sole_constructor {
  acquisition: VllmReadbackAcquisition
  models_route: VllmModelsRouteReadback
  version_route: VllmVersionRouteReadback
  cache_config_gauge: VllmCacheConfigGaugeReadback
  parallel_evidence_outcomes: List<VllmEvidenceRouteOutcome>
  realization: VllmTpRealizationRefusal
}

fn vllm_readback_transaction(
  acquisition: VllmReadbackAcquisition,
  models_route: VllmModelsRouteReadback,
  version_route: VllmVersionRouteReadback,
  cache_config_gauge: VllmCacheConfigGaugeReadback,
  parallel_evidence_outcomes: List<VllmEvidenceRouteOutcome>,
) -> VllmReadbackTransaction {
  VllmReadbackTransaction {
    acquisition: acquisition,
    models_route: models_route,
    version_route: version_route,
    cache_config_gauge: cache_config_gauge,
    parallel_evidence_outcomes: parallel_evidence_outcomes,
    realization: VllmTpRealizationRefusal {
      front_door_host: acquisition.front_door_host,
      missing: vllm_missing_evidence_for(outcomes: parallel_evidence_outcomes),
    },
  }
}

// SMART CONSTRUCTORS, because sole_constructor keeps the record literal inside this module. That is
// the annotation doing its job: every one of these shapes is reachable from outside only through a
// named function here, so a caller cannot assemble a readback whose parts came from different reads.
fn vllm_readback_acquisition(
  front_door_host: HostIdentity,
  observed_on: NonEmptyStr,
  build: VllmBuildIdentity,
) -> VllmReadbackAcquisition {
  VllmReadbackAcquisition { front_door_host: front_door_host, observed_on: observed_on, build: build }
}

fn vllm_models_route_readback(
  served_model_id: NonEmptyStr,
  configured_model_path: NonEmptyStr,
  max_model_len: NonEmptyStr,
) -> VllmModelsRouteReadback {
  VllmModelsRouteReadback {
    served_model_id: served_model_id,
    configured_model_path: configured_model_path,
    max_model_len: max_model_len,
  }
}

fn vllm_version_route_readback(server_version: NonEmptyStr) -> VllmVersionRouteReadback {
  VllmVersionRouteReadback { server_version: server_version }
}

fn vllm_cache_config_gauge_readback(
  kv_cache_dtype: NonEmptyStr,
  gpu_memory_utilization: NonEmptyStr,
  prefix_caching_enabled: Bool,
) -> VllmCacheConfigGaugeReadback {
  VllmCacheConfigGaugeReadback {
    kv_cache_dtype: kv_cache_dtype,
    gpu_memory_utilization: gpu_memory_utilization,
    prefix_caching_enabled: prefix_caching_enabled,
  }
}

fn vllm_evidence_route_outcome(route: VllmEvidenceRoute, answered: Bool) -> VllmEvidenceRouteOutcome {
  VllmEvidenceRouteOutcome { route: route, answered: answered }
}

// THE STAGE IS DERIVED FROM THE OUTCOMES RATHER THAN ASSERTED, which is what makes the earlier arm a
// consequence instead of a claim: if no evidence route answered, the configuration stage was never
// reached, so the refusal is the earlier one. If some answered, the configuration may be in hand and
// the open question becomes the population.
// THE STAGE FOLLOWS THE CONFIGURATION-BEARING ROUTE, NOT ANY ANSWER AT ALL.
//
// An earlier version advanced to the population question whenever ANY evidence route answered. That
// is wrong, and wrong in the direction that overstates what is known: /get_world_size returns a
// product consistent with TP=2, PP=2 and DP=2 alike, and /collective_rpc reports population without
// saying how the parallelism decomposes. Either could answer while the resolved configuration stayed
// entirely unobserved, and the refusal would then claim the configuration was in hand.
//
// Only the configuration-bearing kind moves the stage, which is why the kind lives with the route in
// extdeps rather than being decided here by path matching.
fn vllm_missing_evidence_for(
  outcomes: List<VllmEvidenceRouteOutcome>,
) -> VllmTpRealizationMissingEvidence {
  if any(outcomes, o =>
       o.answered
         && vllm_evidence_kind_establishes_configuration(kind: o.route.kind)) {
    JoinedRankPopulationNotObserved
  } else {
    ResolvedParallelConfigurationNotObserved
  }
}

fn vllm_tp_realization_missing_wire(missing: VllmTpRealizationMissingEvidence) -> String {
  match missing {
    ResolvedParallelConfigurationNotObserved =>
      "the resolved parallel configuration was not observed, so the expected rank set is not even derivable yet"
    JoinedRankPopulationNotObserved =>
      "the resolved parallel configuration is known but no receipt places every expected rank on the selected hosts"
  }
}

fn vllm_tp_realization_refusal_cause(refusal: VllmTpRealizationRefusal) -> String {
  join([
    "vllm tensor-parallel realization refused for the front door on ",
    refusal.front_door_host as String,
    ": ",
    vllm_tp_realization_missing_wire(missing: refusal.missing),
    ". This is a missing positive fact, not an unanswered port: a tensor-parallel worker is not ",
    "required to serve its own front door, so refusing on a silent port would invent a contract in ",
    "order to fail it",
  ], "")
}

data vllm_readback_acquisition_2026_09_03: VllmReadbackAcquisition = vllm_readback_acquisition(
  front_door_host: operator_host_srv6,
  observed_on: "2026-09-03" as NonEmptyStr,
  build: vllm_build_identity(version_string: "0.21.1rc1.dev339+g1967a5627bc3" as NonEmptyStr))

data vllm_readback_2026_09_03: VllmReadbackTransaction = vllm_readback_transaction(
  acquisition: vllm_readback_acquisition_2026_09_03,
  models_route: vllm_models_route_readback(
    served_model_id: "deepseek-v4-flash:iq3s-split" as NonEmptyStr,
    configured_model_path: "models--deepseek-ai--DeepSeek-V4-Flash/snapshots/60d8d70770c6776ff598c94bb586a859a38244f1" as NonEmptyStr,
    max_model_len: "262144" as NonEmptyStr),
  version_route: vllm_version_route_readback(
    server_version: "0.21.1rc1.dev339+g1967a5627bc3" as NonEmptyStr),
  cache_config_gauge: vllm_cache_config_gauge_readback(
    kv_cache_dtype: "fp8_ds_mla" as NonEmptyStr,
    gpu_memory_utilization: "0.86" as NonEmptyStr,
    prefix_caching_enabled: true),
  parallel_evidence_outcomes: map(
    vllm_parallel_evidence_routes,
    r => vllm_evidence_route_outcome(route: r, answered: false)),
)

// CAPACITY IS ABSENT FROM THIS TRANSACTION, AND THE LAW SAYING WHY IS EXECUTABLE.
//
// The gauge also carried a block count and a resolved minimum block size. Their product was computed,
// called the live token pool, and published upward before the error was caught. The transaction
// carries no capacity field, and extdeps.vllm.server decide_vllm_capacity_evidence carries the rule
// as a decision with both directions reachable -- rather than as a coproduct arm that could only ever
// be asserted.
//
// The two numbers are real observations and are omitted anyway: a block count sitting in a
// serving-capacity carrier will be multiplied again by the next person who finds it.
fn vllm_capacity_from_cache_config_fields() -> VllmCapacityEvidenceVerdict {
  decide_vllm_capacity_evidence(proposal: CacheConfigBlockFields)
}
