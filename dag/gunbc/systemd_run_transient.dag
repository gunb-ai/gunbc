module gunbc.systemd_run_transient

data systemd_run_transient_path: String = "dag/extdeps/systemd/systemd_run.dag"
data systemd_run_transient_service: String = "systemd.SystemdRun"
data systemd_run_transient_operation: String = "RunTransient"

type SystemdRunTransientOutcome =
    SystemdRunTransientStarted { stdout: String }
  | SystemdRunTransientRefused { reason: String }

fn systemd_run_transient_operation_argv(unit: std.types.NonEmptyStr, command_argv: List<String>) -> v2.std.operation_argv.ArgvMaterialization {
  shell_materialize_operation_argv(
    systemd_run_transient_path,
    systemd_run_transient_service,
    systemd_run_transient_operation,
    [
      v2.std.operation_argv.operation_argv_bind_text(name: "unit", text: unit as String),
      v2.std.operation_argv.operation_argv_bind_text_list(name: "command_argv", items: command_argv),
    ]
  )
}

fn systemd_run_transient_outcome_from_result(success: Bool, stdout: String, stderr: String) -> SystemdRunTransientOutcome {
  if success {
    SystemdRunTransientStarted { stdout: stdout }
  } else {
    SystemdRunTransientRefused { reason: stderr }
  }
}

fn systemd_run_transient_local(unit: std.types.NonEmptyStr, command_argv: List<String>) -> SystemdRunTransientOutcome {
  let result = systemd.SystemdRun.RunTransient(unit: unit, command_argv: command_argv)
  systemd_run_transient_outcome_from_result(success: result.success, stdout: result.stdout, stderr: result.stderr)
}

fn systemd_run_transient_outcome_from_exec(outcome: gunbc.typed_argv_exec.TypedArgvExecOutcome) -> SystemdRunTransientOutcome {
  match outcome {
    TypedArgvExecConverged { result: r } =>
      systemd_run_transient_outcome_from_result(success: r.success, stdout: r.stdout, stderr: r.stderr)
    TypedArgvExecRefused { reason: why } => SystemdRunTransientRefused { reason: why }
  }
}

fn systemd_run_transient_ssh_argv(host: std.types.NonEmptyStr, argv: List<String>) -> SystemdRunTransientOutcome {
  match gunbc.typed_argv_exec.typed_argv_shell_safe_refusal_argv(argv: argv) {
    Present { value: why } => SystemdRunTransientRefused { reason: why }
    Absent => systemd_run_transient_outcome_from_exec(outcome: gunbc.typed_argv_exec.typed_argv_exec_over_ssh(host: host, argv: argv))
  }
}

fn systemd_run_transient_ssh(host: std.types.NonEmptyStr, unit: std.types.NonEmptyStr, command_argv: List<String>) -> SystemdRunTransientOutcome {
  match systemd_run_transient_operation_argv(unit: unit, command_argv: command_argv) {
    ArgvMaterialized { argv: argv } => systemd_run_transient_ssh_argv(host: host, argv: argv)
    ArgvMaterializationRefused { at: _, cause: c } =>
      SystemdRunTransientRefused { reason: v2.std.operation_argv.operation_argv_cause_label(cause: c) }
  }
}

fn systemd_run_transient_fleet_ssh(
  target: gunbc.fleet_known_hosts_anchor.SshTarget,
  context: gunbc.fleet_known_hosts_anchor.FleetSshExecutionContext,
  unit: std.types.NonEmptyStr,
  command_argv: List<String>,
) -> SystemdRunTransientOutcome {
  match systemd_run_transient_operation_argv(unit: unit, command_argv: command_argv) {
    ArgvMaterialized { argv: argv } =>
      systemd_run_transient_outcome_from_exec(
        outcome: gunbc.typed_argv_exec.typed_argv_exec_over_fleet_ssh(target: target, context: context, argv: argv),
      )
    ArgvMaterializationRefused { at: _, cause: c } =>
      SystemdRunTransientRefused { reason: v2.std.operation_argv.operation_argv_cause_label(cause: c) }
  }
}

fn systemd_run_transient_read(
  transport: gunbc.host_effect.HostEffectTransport,
  unit: std.types.NonEmptyStr,
  command_argv: List<String>,
) -> SystemdRunTransientOutcome {
  match transport {
    LocalShell => systemd_run_transient_local(unit: unit, command_argv: command_argv)
    SshShell { ssh_host: h } => systemd_run_transient_ssh(host: h, unit: unit, command_argv: command_argv)
    FleetSsh { target: t, context: c } => systemd_run_transient_fleet_ssh(target: t, context: c, unit: unit, command_argv: command_argv)
    EmitArtifactThenThinRun { bootstrap: _, invocation: _ } =>
      SystemdRunTransientRefused {
        reason: "systemd-run transient start refused EmitArtifactThenThinRun transport",
      }
  }
}

fn systemd_run_transient_operation_argv_matches_authority(unit: std.types.NonEmptyStr, command_argv: List<String>) -> Bool {
  let authority = fold(
    command_argv,
    init: ["systemd-run", concat("--unit=", unit as String), "--collect", "--"],
    f: (acc, arg) => list_push(acc, arg),
  )
  match systemd_run_transient_operation_argv(unit: unit, command_argv: command_argv) {
    ArgvMaterialized { argv: materialized } => join(materialized, " ") == join(authority, " ")
    ArgvMaterializationRefused { at: _, cause: _ } => false
  }
}
