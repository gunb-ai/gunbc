module gunbc.stage0_crate_layout_emit


fn escape_dag_string_body(s: String) -> String {
  replace(replace(replace(s, "\\", "\\\\"), "\"", "\\\""), "\n", "\\n")
}

fn escape_rust_string_literal_body(s: String) -> String {
  replace(replace(replace(s, "\\", "\\\\"), "\"", "\\\""), "\n", "\\n")
}

fn render_dag_string_list_items(xs: List<String>) -> String {
  fold_list(xs, empty: "", cons: fn(acc, item) {
    let line = concat("  \"", item, "\"")
    if acc == "" {
      line
    } else {
      concat(acc, concat(",\n", line))
    }
  })
}

fn render_dag_string_list(xs: List<String>) -> String {
  concat("[\n", concat(render_dag_string_list_items(xs: xs), "\n]"))
}

fn render_rust_str_slice_items(xs: List<String>) -> String {
  fold_list(xs, empty: "", cons: fn(acc, item) {
    let line = concat("    \"", escape_rust_string_literal_body(s: item), "\"")
    if acc == "" {
      line
    } else {
      concat(acc, concat(",\n", line))
    }
  })
}

fn expected_stage0_crate_layout_generated_dag() -> String {
  let pub_mod_block = emit_hand_maintained_pub_mod_block()
  let pub_mod_basenames = hand_maintained_pub_mod_basenames()
  let stage0_filenames = hand_maintained_stage0_filenames()
  let stage0_dirs = hand_maintained_stage0_dirs()
  concat(
    "module gunbc.stage0_crate_layout_generated\n\n",
    "import std.types { List, String }\n\n",
    "data stage0_crate_layout_generated_note: String = \"Generated by gunbc stage0_crate_layout_emit — do not hand-edit. Authority: v2.compiler.self_host.frontier; regen via dag/tools/generated_artifact_gate.dag main_wet.\"\n\n",
    "data generated_pub_mod_block: String = \"",
    escape_dag_string_body(s: pub_mod_block),
    "\"\n\n",
    "data generated_pub_mod_basenames: List<String> = ",
    render_dag_string_list(xs: pub_mod_basenames),
    "\n\n",
    "data generated_stage0_filenames: List<String> = ",
    render_dag_string_list(xs: stage0_filenames),
    "\n\n",
    "data generated_stage0_dirs: List<String> = ",
    render_dag_string_list(xs: stage0_dirs),
    "\n"
  )
}

fn expected_stage0_crate_layout_generated_rs() -> String {
  let stage0_filenames = hand_maintained_stage0_filenames()
  let stage0_dirs = hand_maintained_stage0_dirs()
  concat(
    "// Generated by gunbc stage0_crate_layout_emit — do not hand-edit.\n",
    "// Authority: v2.compiler.self_host.frontier; regen via dag/tools/generated_artifact_gate.dag main_wet.\n\n",
    "#[rustfmt::skip]\n",
    "pub const HAND_MAINTAINED_STAGE0_FILES: &[&str] = &[\n",
    render_rust_str_slice_items(xs: stage0_filenames),
    "\n];\n\n",
    "#[rustfmt::skip]\n",
    "pub const HAND_MAINTAINED_STAGE0_DIRS: &[&str] = &[\n",
    render_rust_str_slice_items(xs: stage0_dirs),
    "\n];\n"
  )
}
