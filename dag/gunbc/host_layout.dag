module gunbc.host_layout

import std.types { String, NonEmptyStr, FilePath }
import product.placement_supply { HostIdentity }
import gunbc.provider_account {
  codex_account_state_root,
  codex_roadmap_account_selection,
}
import gunbc.fleet_intent_network {
  operator_host_srv1,
  operator_host_srv2,
  operator_host_srv3,
  operator_host_srv4,
}
import gunbc.codex_runtime_paths {
  srv1_codex_runtime_release_root,
  codex_bundled_executable_at_current_link,
}
import gunbc.package_delivery { codex_linux_arm64_native_executable_rel }

data host_layout_note: String = "The ONE authority for the srv1 gunbc host paths (docs/plans/gunbc-served-dashboard-design.md section 5; lane agreement with royal-carp-451, 2026-07-20). Five facts must agree with their consumers or in-process dispatch breaks: srv1_gunbc_repo_root is BOTH the tree `gunbc serve` loads AND the repo the belt runs `git worktree add` from; srv1_dispatch_worktree_root is where those worktrees land; srv1_dispatch_attempt_state_root is where the belt publishes attempt evidence before it launches a provider; srv1_gunbc_serve_binary is the deployed seed binary; srv1_roadmap_codex_home is the dedicated Codex state root whose auth/config/session state the Codex provider preflights and invokes through CODEX_HOME. gunbc.roadmap_belt_actuate and gunbc.roadmap_dispatch_actuator project these rows, while gunbc.live_deploy.spec owns convergence of the filesystem/runtime membership. Interim: the parent lane hand-provisions srv1 to these exact paths; that hand-provisioning dissolves when live_deploy formally carries every member, including the provider state-root existence/ownership check (credentials themselves remain user-authored secret state, never deployment payload)."

data attempt_state_root_layout_admission_note: String = "srv1_dispatch_attempt_state_root JOINED THIS AUTHORITY ON AN INCIDENT (2026-07-30), and the incident is the argument for the row existing. #7368 made a published attempt-state directory a hard precondition of every dispatch, but the path was written as a bare literal inside gunbc.roadmap_dashboard_instance's srv1 row and nowhere else. live_deploy's owned-artifact roster therefore never carried it, so no deploy created it, so `install -d /opt/gunbc/attempt-state` ran as the service user against a root-owned parent and refused with EACCES — after `git worktree add` had already succeeded. Every dispatch since produced an orphan branch and worktree, no session, and a progress row that read `legacy attempt`. The defect was NOT the permission: it was that a path load-bearing for two consumers had one spelling and one owner, so adding the requirement to one consumer could not reach the other. The general rule the row restates: a host path the belt WRITES is a deployment member, and a deployment member is projected from here — never spelled at its point of use. Dissolution: when live_deploy takes a GunbcHostLayout row as a parameter, this flat row folds into the record literal with its siblings (gunbc_host_layout_note's trigger)."

data srv1_gunbc_repo_root: FilePath = "/opt/gunbc/gunbc" as FilePath

data srv1_gunbc_serve_binary: FilePath = "/opt/gunbc/bin/gunbc" as FilePath

data srv1_dispatch_worktree_root: FilePath = "/opt/gunbc/dispatch-worktrees" as FilePath

data roadmap_codex_account_note: String = "THE DASHBOARD'S CODEX HOME IS DERIVED FROM AN ACCOUNT SELECTION, not spelled as a path. It used to be the literal /home/briansrls/.codex@gunbc-roadmap, which encoded three separate facts in one string with no way to read any of them back: the user's home directory, codex's own default-root name, and the @label convention that distinguishes this account from the two others on the same machine.\\n\\nDeriving it makes each fact answerable at its own layer. gunbc.provider_account owns both the suffix convention and the identity of the dashboard's account, extdeps.llm.codex_auth owns the fact that CODEX_HOME selects an isolated store at all, and what THIS module still states is only the machine-local half: which home directory the roots hang under.\\n\\nTHE FIRST VERSION OF THIS DECOMPOSITION FORKED THE ACCOUNT (review 45207). It named the label a second time here, as roadmap_codex_account_label beside a roadmap_codex_account() constructor, while gunbc.provider_account already carried codex_roadmap_account_label and codex_roadmap_account_selection() for the same account — two names for one concept in two modules, each spelling the same literal, which is exactly the nickname §3 forbids. Worse, neither local name had a consumer: the path rows below still inlined the literal a third and fourth time, so the module declared an authority and then ignored it. The fork is deleted rather than wired up, because the account's home is provider_account — this module's business is host paths.\\n\\nThe derived value is byte-identical to the literal it replaces, which the witness asserts — the point is provenance, not a new value."

data operator_home_root: FilePath = "/home/briansrls" as FilePath

data srv1_dispatch_attempt_state_root: FilePath = "/opt/gunbc/attempt-state" as FilePath

data devboot_root_layout_admission_note: String = "THE BUILD SERVICE'S HOST ROOT JOINS THIS AUTHORITY BEFORE ITS FIRST CONSUMER EXISTS, which is the whole point of the ordering. srv1_dispatch_attempt_state_root joined it AFTER an incident (attempt_state_root_layout_admission_note): a path load-bearing for two consumers was spelled as a bare literal inside one of them, so live_deploy's owned-artifact roster never carried it, so no deploy created it, and `install -d` refused with EACCES against a root-owned parent AFTER the dispatch had already half-run. This row is the same shape of fact -- a host path the service WRITES -- and it is declared here first so that roster can carry it from the start rather than after the equivalent failure.\\n\\nWHY ONE ROOT AND NOT TWO. An earlier revision admitted a second root to hold request records, the producer lease and terminal outcomes, on the assumption that this service would keep durable state in a database beside the artifacts. Re-observation found no such store realization in the tree, and found that the artifact store already provides everything the second root was for: a bare Git repository IS the content-addressed object database, its refs ARE durable named state, and its exact-old-value ref update IS the atomic compare-and-swap a producer lease needs. The second root would have been a second durable representation of one fact set, so it is retired rather than left standing with nothing writing to it (see devboot_state_root_retirement_note).\\n\\nWHAT THIS ROW DOES NOT SAY. It is a declaration, not an observation -- the same distinction srv2_host_layout_note draws. The path is not asserted to exist; the deployment creates it and a preflight refuses on the difference. A service that found no store and quietly built into a temp directory would be the absorbing fallback DESIGN section 5 forbids, so the refusal carries the exact path."

data srv1_devboot_artifact_store_root: FilePath = "/var/lib/gunbc/artifacts.git" as FilePath


data srv1_roadmap_codex_home: FilePath = codex_account_state_root(
  home: operator_home_root,
  selection: codex_roadmap_account_selection(),
) as String as FilePath

data gunbc_host_layout_note: String = "THE HOST FACTS AN INSTANCE CANNOT DERIVE FROM ITS OWN ROOT, carried as one row per host instead of one name per host. An isolated dashboard instance derives most of its paths from its instance root — source, attempts, attempt-state and local origin are all children of it — but three belong to the machine rather than the instance: which seed binary serves, where the provider's authenticated state root lives, and which local worktree seeds the source bundle. Those cannot come from the root, so before this row they were written as srv1 literals inside the shared constructor.\\n\\nBE PRECISE ABOUT WHAT THAT DEFECT WAS, because overstating it would be its own false claim. No value was wrong. srv1 and srv2 run the same layout convention, so both rows below carry byte-identical paths, and a home-directory path denotes a different file on each machine anyway. The defect was representational: the constructor took host_identity as a parameter and then pinned the other three facts, so a host whose layout DIVERGED could not be expressed at all. A second host was nameable without being describable, and the name silently carried the first host's body.\\n\\nThat is precisely why it survived review — there was no wrong output to notice. It is a latent fabrication, not a live one: the first host to install its binary elsewhere would have gotten srv1's path under its own name, with the mismatch appearing as an unexplained refusal against a path nobody wrote for it.\\n\\nOne row per host beats a second set of srv2_-prefixed names, because a prefix bakes the instance into the concept and the next host repeats the exercise. The flat srv1_ rows above stay as the field values of srv1's row — they have live consumers in live_deploy and the actuators — so each path is still written exactly once. Dissolution trigger: when live_deploy takes a layout row as a parameter, those flat rows fold into the record literal and the prefix disappears."

type GunbcHostLayout {
  host_identity: NonEmptyStr
  gunbc_serve_binary: FilePath
  roadmap_codex_home: FilePath
  controller_repo: FilePath
  codex_bundled_executable: FilePath?
}

data srv1_dashboard_controller_repo: FilePath = "/home/briansrls/.worktrees/gunbc/codex-provider-feedback-v0" as FilePath

data gunbc_host_layout_codex_executable_note: String = "The bundled Codex executable path is derived through codex_bundled_executable_for_host, not stored as an independent layout literal. GunbcHostLayout.codex_bundled_executable is FilePath? so Absent has no fabricated path constructor — executors refuse when the committed-lock placement is unavailable. Witness: srv1_committed_lock_bundled_executable_is_present."

fn srv1_codex_bundled_executable() -> FilePath? {
  codex_bundled_executable_for_host(host: "srv1" as HostIdentity)
}

fn srv2_codex_bundled_executable() -> FilePath? {
  codex_bundled_executable_for_host(host: "srv2" as HostIdentity)
}

fn srv1_host_layout() -> GunbcHostLayout {
  GunbcHostLayout {
    host_identity: "srv1" as NonEmptyStr,
    gunbc_serve_binary: srv1_gunbc_serve_binary,
    roadmap_codex_home: srv1_roadmap_codex_home,
    controller_repo: srv1_dashboard_controller_repo,
    codex_bundled_executable: srv1_codex_bundled_executable(),
  }
}

data srv2_host_layout_note: String = "srv2's own row, where a DECLARATION and an OBSERVATION are deliberately different things. A preflight exists to compare what this row says against what the machine holds and refuse on the difference, so a path may legitimately be declared before it exists — an apply that found no binary and quietly served something else, or found no auth root and dispatched unauthenticated, is the absorbing fallback; refusing with the exact path is the whole mechanism.\\n\\nSTATE AS OF 2026-07-30, and this row is the wrong place to keep tracking it: /opt/gunbc/bin/gunbc does not exist on srv2 (only /opt/gunbc/gunbc, a hand-made symlink into a session worktree), while the Codex state root now DOES exist and is authenticated — an earlier version of this note said it had never been created, and that sentence was already false within the hour. Prose describing mutable host state goes stale silently, which is why liveness belongs to the readiness probe that observes it and this row states only intent.\\n\\nThe codex home derives from the same account selection srv1 uses, so the two hosts share the convention rather than each spelling it. The controller repo exists because the preview instance these rows grew out of was authored on this machine."

data srv2_gunbc_serve_binary: FilePath = "/opt/gunbc/bin/gunbc" as FilePath

data srv2_roadmap_codex_home: FilePath = codex_account_state_root(
  home: operator_home_root,
  selection: codex_roadmap_account_selection(),
) as String as FilePath

data srv2_dashboard_controller_repo: FilePath = "/home/briansrls/.worktrees/gunbc/codex-provider-feedback-v0" as FilePath

fn srv2_host_layout() -> GunbcHostLayout {
  GunbcHostLayout {
    host_identity: "srv2" as NonEmptyStr,
    gunbc_serve_binary: srv2_gunbc_serve_binary,
    roadmap_codex_home: srv2_roadmap_codex_home,
    controller_repo: srv2_dashboard_controller_repo,
    codex_bundled_executable: srv2_codex_bundled_executable(),
  }
}
data managed_compile_pool_slice_note: String = "The ONE authority for the managed compile-pool slice unit name, homed here for the same reason as the paths above: it is a fact about how a HOST is laid out, not about any one consumer of it. Its live consumers are gunbc.build_cache_instance `ci_cache_instance` and `session_cache_instance`, which carry it as each deployed instance's `intended_compile_pool`, plus the `managed_compile_pool_slice_fixture` row in gunbc.host_build_cache_provision. STATE, stated so this row is not read as a description of the fleet: NOTHING PROVISIONS THIS SLICE YET. No observed host has it — the 2026-08-01 placement receipt found every CI cache endpoint owned by a runner-slot process, never by a managed unit inside a compile pool — so the name is declared intent that an observation is checked against, and gunbc.fleet_host_budget's `CompilePoolInRunnerSlots` correspondingly derives a ZERO pool today. CORRECTED 2026-08-01 (review 46182, and the review understated it — all three of this note's claims had gone stale in one edit, which is the §3 citation class this repo keeps paying for): it previously cited `ServerUnitOwned.slice_unit` in gunbc.host_build_cache_provision, said the emitted shell in gunbc.host_build_cache_provision_script greps the observed cgroup for this value, and justified its homing by an import cycle between those two consumers. `ServerUnitOwned` no longer exists (it is `ServerManagedUnitOwned { unit }` in gunbc.build_cache_instance, and placement is decided against the instance's `intended_unit` — a service, not this slice); the script carries no compile-pool reference at all, because the branch's emitted placement probe was deliberately not landed (that module is an A5 census row whose emitted shell may shrink but not grow); and with that consumer absent the two-consumer drift hazard and the cycle rationale describe a mechanism that is not in the tree."

data gunbc_managed_compile_pool_slice: NonEmptyStr = "gunbc-compile-pool.slice" as NonEmptyStr

data belt_spawn_workdir_env_var_note: String = "The ONE authority for the environment variable that carries a belt tick's spawn root, homed here for the same reason as the compile-pool slice name above: it is a fact about how a HOST is laid out and it has TWO consumers on opposite sides of a boundary, so neither may own it. gunbc.roadmap_belt_actuate READS it in belt_run_once_cli; gunbc.live_deploy.emit WRITES it as the Environment= line of the belt unit it installs. A literal in either place is the same string in two files, and the failure it produces is silent rather than loud: the writer and the reader would simply stop meeting, the reader would refuse for a missing variable, and nothing would say which of the two spellings was wrong.\\n\\nHoming it in either consumer would also drag one into the other's closure. The deploy emitter needs exactly one string from the belt; importing gunbc.roadmap_belt_actuate to get it would put the belt's whole implementation — tmux, git worktrees, the Claude provider preflight — behind every emission of a deploy script, for a name. That is the coupling this module exists to prevent."

data belt_spawn_workdir_env_var: NonEmptyStr = "GUNBC_BELT_SPAWN_WORKDIR" as NonEmptyStr

// The ONE authority for the fleet converge-receipt directory path, homed here for the
// two-consumers-across-a-boundary reason: gunbc.fleet_converge_cli publishes under it;
// gunbc.fleet_receipt_collector reads back. Homing the path in either consumer would drag
// the other's closure behind an import cycle.
data fleet_converge_receipt_dir: String = "/opt/gunbc/receipts"

// THE PER-INSTANCE RECEIPTS DIRECTORY, derived from an instance root rather than spelled.
// Every instance publishes its receipts beside its own root, so two slots on one host cannot
// fuse their receipts under one path — the same identity separation the deployed-tree remote
// member keeps for `origin` (gunbc.deployed_tree_remote). That matters here specifically
// because the srv1 pair is DispatchStateHostShared: blue and green share one dispatch
// attempt-state root, so the attempt-state root is NOT available as a per-instance home and a
// receipt written there would be one file answering for two instances.
//
// fleet_converge_receipt_dir above is byte-identical to instance_receipts_dir applied to
// production's instance root ("/opt/gunbc"), which is the half-parameterization
// live_deploy.emit serve_binary_parent_was_a_literal_note describes: the value that varies
// became a parameter and the directory holding it stayed a literal. That fork is PRE-EXISTING
// and is not created here — gunbc.fleet_converge_cli is parameterized by host, not by
// instance, so de-forking it needs an instance on that path and is not this change's scope.
fn instance_receipts_dir(instance_root: String) -> String {
  join([instance_root, "/receipts"], "")
}

// srv1 observation (2026-08-13, parent eager-koi-458): directory already briansrls-owned;
// EACCES was a root-owned STALE FILE from the pre-b1 unit user, not the directory.
// Publication authority is atomic rename in gunbc.fleet_converge_cli — NOT live_deploy
// install-d on this path and NOT per-run elevation.
data fleet_converge_receipt_atomic_publish_note: String = "Receipt publication is gunbc.fleet_converge_cli converge_cli_atomic_receipt_write: Filesystem.Write to a same-directory *.staging file, then shell.Move.File over the final path. rename(2) takes permission from the containing directory, not the file being replaced, so a root-owned stale receipt is superseded without elevation when the service principal owns the directory. In-place Filesystem.Write on the target path fails EACCES on stale root-owned files and is crash-unsafe (truncated receipts). Deploy install-d on fleet_converge_receipt_dir (live_deploy emit FleetConvergeTimerUnit apply) ensures the directory exists and is owned by the service principal on fresh hosts; that bootstrap is orthogonal to publication — per-run sudo install on individual receipt files is not the publication fix when the directory is already service-user-owned."

data provider_runtime_placement_note: String = "ONE host-parameterized placement for provider package/exec release trees, mutable provider state, and private wire-evidence roots. Parallel to GunbcHostLayout: a second host must be describable without minting a second set of path concepts. Claude/Cursor/Codex lanes consume this record; they do not re-author /opt/... roots. The flat srv1_* path data below are the once-written field values of srv1's row — the same dissolution pattern as gunbc_host_layout_note."

type ProviderRuntimePlacement {
  runtime_release_root: FilePath
  runtime_mutable_state_root: FilePath
  wire_evidence_root: FilePath
}

data srv1_codex_runtime_mutable_state_root: FilePath = "/opt/gunbc/provider-runtime/codex-state" as FilePath

data srv1_provider_wire_evidence_root: FilePath = "/opt/gunbc/provider-runtime/evidence" as FilePath

fn srv1_provider_runtime_placement() -> ProviderRuntimePlacement {
  ProviderRuntimePlacement {
    runtime_release_root: srv1_codex_runtime_release_root,
    runtime_mutable_state_root: srv1_codex_runtime_mutable_state_root,
    wire_evidence_root: srv1_provider_wire_evidence_root,
  }
}

fn provider_runtime_placement_for_host(host: HostIdentity) -> ProviderRuntimePlacement? {
  if host == operator_host_srv1
    || host == operator_host_srv2
    || host == operator_host_srv3
    || host == operator_host_srv4
  {
    Present { value: srv1_provider_runtime_placement() }
  } else {
    none
  }
}

data provider_runtime_placement_shared_row_note: String = "srv1..srv4 currently project srv1_provider_runtime_placement() — paths are convention-uniform today, not derived per-host. dissolve-on: each host's GunbcHostLayout row carries its own ProviderRuntimePlacement when a fleet host diverges from the srv1-shaped paths."

fn codex_bundled_executable_for_host(host: HostIdentity) -> FilePath? {
  match provider_runtime_placement_for_host(host: host) {
    Absent => none
    Present { value: placement } =>
      match codex_linux_arm64_native_executable_rel() {
        Absent => none
        Present { value: rel } =>
          Present {
            value: codex_bundled_executable_at_current_link(
              release_parent: placement.runtime_release_root,
              native_executable_rel: rel,
            )
          }
      }
  }
}
