module gunbc.rung_drop_amendment

import std.types { String, NonEmptyStr, List, Bool }

// A LATER RULING AMENDING A STANDING RUNG DROP -- THE ONE THING gunbc.rung_drop COULD NOT CARRY.
// A DESIGN section 4b(3) declaration is written once, at the moment the guarantee falls: previous
// rung, temporary rung, reason, population, restoration trigger. It has no field for what happens
// NEXT while the row still stands -- and the world does move under a standing drop. gunbc#11774
// discovered that the hard way: its author had a fact the ruling depended on (the carrier redesign
// had already landed hours earlier, so the ruling was pricing the gate and not only its billing),
// no field to put it in, and wrote it into docs/design-rung-drops.md -- a PROJECTION of
// gunbc.rung_drop. Two lanes then met the unexplained deletion in their regeneration diff
// (gunbc#11732 reverted it, gunbc#11786 was left holding nothing else and was closed), and the
// third regeneration, gunbc#11789, carried the deletion and the reasoning left the corpus. That is
// DESIGN section 6's manual application committed as source, and the repair is not to re-hand-edit
// the bytes: it is this carrier.
//
// WHY THIS IS NOT A COMMENTARY FIELD. An amendment is not a note. It is a specific claim with a
// specific consequence, and the consequence is the field that makes it one: a later event that
// bears on a standing drop either leaves its restoration trigger whole or replaces it, and there
// is no third answer that does not silently rewrite the trigger. DESIGN section 4b(3) says a drop
// is retired BY ITS TRIGGER AND BY NOTHING ELSE, so an amendment that could quietly change what
// restores the guarantee, without saying so, is the one thing this carrier must refuse to express.
// `AmendedTrigger` is therefore closed and both arms are load-bearing: `TriggerStandsWhole` asserts
// the declaration below it is unchanged, and `TriggerSuperseded` names what replaced it.
//
// WHY IT IS A SEPARATE CARRIER RATHER THAN A FIELD ON `RungDrop`. The precedent is inside
// gunbc.rung_drop itself: gunbc.deleted_cadence_reference_census carried `lost_with` BESIDE a drop
// rather than widening the shared record. The same two reasons hold here and one more. Most drops
// are never amended, so the field would be empty on 70-odd rows; the rows are one file each
// precisely so that separate lanes append without rewriting each other's file, and widening the
// record rewrites every one of them in a single diff; and an amendment is appended by a DIFFERENT
// change, at a different time, from the one that declared the drop -- which is the same argument
// DESIGN section 4b(3) makes for keeping the drop roster and the failure-mode ledger apart.
//
// THE JOIN IS THE RESIDUAL RISK AND IT IS WALLED. A row keyed by `drop_identity` can name a drop
// that does not exist, or one that was renamed. test.claim.rung_drop_amendment_witness_test joins
// every amendment against gunbc.rung_drop.roster at identity grain and refuses a dangling key, with
// a control amendment naming no drop to keep the assertion discriminating.

// WHAT A LATER RULING DID TO THE STANDING DECLARATION BELOW IT. Closed, two arms, no default: see
// the note above on why a silent third answer is the state this type exists to make unwritable.
type AmendedTrigger
  = TriggerStandsWhole
  | TriggerSuperseded { replacement: NonEmptyStr }

type RungDropAmendment {
  drop_identity: NonEmptyStr
  amended: String
  later_event: NonEmptyStr
  bearing: NonEmptyStr
  trigger: AmendedTrigger
}

// THE ONE RENDERING, for the same reason gunbc.rung_drop carries exactly one: a consumer that spelled
// the amendment itself would be a second authority for it and the two would drift.
fn rung_drop_amendment_message(a: RungDropAmendment) -> String {
  concat(
    concat(concat("AMENDED ", a.amended), concat(": ", (a.later_event as String))),
    concat(
      concat("; ", (a.bearing as String)),
      concat(". ", amended_trigger_sentence(t: a.trigger))
    )
  )
}

fn amended_trigger_sentence(t: AmendedTrigger) -> String {
  match t {
    TriggerStandsWhole => "The restoration trigger above stands whole."
    TriggerSuperseded { replacement: r } => concat("The restoration trigger above is superseded: ", concat((r as String), "."))
  }
}

// THE JOIN, AS A PREDICATE OVER BOTH POPULATIONS. Held here rather than in the roster so the
// witness can call it with a control amendment that names no drop.
fn every_amendment_names_a_rostered_drop(amendments: List<RungDropAmendment>, drop_identities: List<String>) -> Bool {
  fold(amendments, init: true, f: fn(acc, a) {
    acc && length(xs: filter(drop_identities, i => i == (a.drop_identity as String))) == 1
  })
}
