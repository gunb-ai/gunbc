module gunbc.kernel_grounding_interpreter_seed_growth

import std.decl_ref { DeclarationRef, WholeDeclaration }
import gunbc.roadmap_model { RoadmapNodeId }
import gunbc.seed_growth { SeedGrowthJustification }

// Seed-growth obligation for the hand-authored interpreter items the Nat de-fork modifies (operator
// ruling A, 2026-09-30). The change is a NET DELETION from the seed interpreter: the #5428 arms that
// grounded any constructor spelled Zero or Succ onto a host integer -- in eval_record_lit and in
// match_pattern, keyed on the spelling and therefore grounding a user-declared Peano type too -- are
// removed, because v1.compiler.infer ground_kernel_views now folds a kernel-grounded carrier's
// constructors out of the tree before the interpreter sees it. What is ADDED is the residue that
// keeps the deletion fail-closed and keeps a structural Peano type structural.
data kernel_grounding_interpreter_seed_growth_justification: SeedGrowthJustification = SeedGrowthJustification {
  hand_authored_declarations: [
    DeclarationRef { module_path: "v1_compiler.v1_interpreter", decl_name: "eval_expr_inner", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.v1_interpreter", decl_name: "eval_match", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.v1_interpreter", decl_name: "eval_record_lit", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.v1_interpreter", decl_name: "match_pattern", field: WholeDeclaration },
  ],
  reason: "The subject is the seed interpreter's own evaluation of three tree forms, which no .dag program can reach: eval_record_lit and match_pattern LOSE their spelling-keyed Zero/Succ arms (a deletion); eval_expr_inner evaluates a Peano-unfolded elaborated literal as its constructor image instead of as the kernel literal, because a Peano unfolding's destination is structural on every route now that a kernel-realized carrier never reaches that arm; and eval_match refuses, located, a constructor pattern matched against a host integer, because with the grounding arms gone such a match could only fall through to a later wildcard silently. The fold that replaces the deleted arms is .dag (v1.compiler.infer ground_kernel_views), so the only hand Rust this adds is the refusal and the image evaluation.",
  owning_dissolution_lane: "v1-hand-queue-drain" as RoadmapNodeId,
  trigger: "Delete the eval_match refusal and the eval_expr_inner image arm when match and literal evaluation are realized by the self-emitted interpreter, which reads the same folded tree and has no constructor-versus-integer case to refuse. Equivalently, when the seed interpreter's pattern matcher returns a typed refusal instead of an Optional, so an unfolded constructor pattern over an integer is refused where it is matched rather than by a pre-check in eval_match. Rewording the refusal or widening its exempt constructor list does not dissolve this row. The exemption (kernel_raw_payload_constructor) is keyed on the pattern's parent carrier spelling, Optional or Witness, because the seed's MatchPattern carries no DeclarationRef (review 73985); a DeclarationRef on the pattern is the next rung for that key.",
  current_boundary: "src/v1/stage0/src/v1_interpreter.rs eval_expr_inner, eval_match, eval_record_lit, match_pattern; src/v1/04_infer.dag ground_kernel_views; dag/gunbc/kernel_grounding_interpreter_seed_growth.dag",
}
