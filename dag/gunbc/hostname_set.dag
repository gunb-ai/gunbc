module gunbc.hostname_set


type HostnameSetCasOutcome
  = HostnameSetCasApplied
  | HostnameSetCasReadRefused { reason: String }
  | HostnameSetCasBaseMismatch { observed: String, base: extdeps.dns.domain_name.DnsLabel }
  | HostnameSetCasApplyFailed { stderr: String }

fn hostname_set_operation_argv(desired: extdeps.dns.domain_name.DnsLabel) -> List<String> {
  hostname_set_argv(desired: desired)
}

fn hostname_set_privileged_operation_argv(
  hostnamectl_path: std.types.NonEmptyStr,
  desired: extdeps.dns.domain_name.DnsLabel,
) -> List<String> {
  ["sudo", "-n", hostnamectl_path as String, "set-hostname", desired as String]
}

fn hostname_set_operation_argv_matches_authority(desired: extdeps.dns.domain_name.DnsLabel) -> Bool {
  let materialized = hostname_set_operation_argv(desired: desired)
  let authority = hostname_set_argv(desired: desired)
  join(materialized, " ") == join(authority, " ")
}

fn hostname_set_privileged_operation_argv_matches_fleet_grant(
  hostnamectl_path: std.types.NonEmptyStr,
  desired: extdeps.dns.domain_name.DnsLabel,
) -> Bool {
  join(
    hostname_set_privileged_operation_argv(hostnamectl_path: hostnamectl_path, desired: desired),
    " ",
  ) == concat(
    concat("sudo -n ", hostnamectl_path as String),
    concat(" set-hostname ", desired as String),
  )
}

fn hostname_set_local(desired: extdeps.dns.domain_name.DnsLabel) -> HostnameSetCasOutcome {
  let result = os.Hostname.Set(desired: desired)
  if result.success {
    HostnameSetCasApplied
  } else {
    HostnameSetCasApplyFailed { stderr: result.stderr }
  }
}

// The outcome handler is shared, but note the refusal arm: a leg that was never attempted must not
// render as HostnameSetCasApplyFailed with an empty stderr, because "we refused to try" and "the
// host rejected it" call for different responses. It carries the refusal reason as the stderr so the
// distinction survives into whatever reads it -- the field is the only channel this type has.
fn hostname_set_cas_from_outcome(outcome: TypedArgvExecOutcome) -> HostnameSetCasOutcome {
  match outcome {
    gunbc.typed_argv_exec.TypedArgvExecConverged { result: r } =>
      if r.success { HostnameSetCasApplied } else { HostnameSetCasApplyFailed { stderr: r.stderr } }
    gunbc.typed_argv_exec.TypedArgvExecRefused { reason: why } =>
      HostnameSetCasApplyFailed { stderr: concat("leg NOT attempted: ", why) }
  }
}

fn hostname_set_fleet_ssh(
  hostnamectl_path: std.types.NonEmptyStr,
  target: gunbc.fleet_known_hosts_anchor.SshTarget,
  context: gunbc.fleet_known_hosts_anchor.FleetSshExecutionContext,
  desired: extdeps.dns.domain_name.DnsLabel,
) -> HostnameSetCasOutcome {
  hostname_set_cas_from_outcome(
    outcome: gunbc.typed_argv_exec.typed_argv_exec_over_fleet_ssh(
      target: target,
      context: context,
      argv: hostname_set_privileged_operation_argv(hostnamectl_path: hostnamectl_path, desired: desired),
    ),
  )
}

fn hostname_set_ssh(
  hostnamectl_path: std.types.NonEmptyStr,
  host: std.types.NonEmptyStr,
  desired: extdeps.dns.domain_name.DnsLabel,
) -> HostnameSetCasOutcome {
  let argv = hostname_set_privileged_operation_argv(hostnamectl_path: hostnamectl_path, desired: desired)
  match gunbc.typed_argv_exec.typed_argv_shell_safe_refusal_argv(argv: argv) {
    Present { value: _ } => HostnameSetCasApplyFailed { stderr: "typed argv shell-safe refusal" }
    Absent =>
      match gunbc.typed_argv_exec.typed_argv_exec_over_ssh(host: host, argv: argv) {
        gunbc.typed_argv_exec.TypedArgvExecConverged { result: r } =>
          if r.success {
            HostnameSetCasApplied
          } else {
            HostnameSetCasApplyFailed { stderr: r.stderr }
          }
        gunbc.typed_argv_exec.TypedArgvExecRefused { reason: why } => HostnameSetCasApplyFailed { stderr: why }
      }
  }
}

fn hostname_set_apply(
  hostnamectl_path: std.types.NonEmptyStr,
  transport: gunbc.host_effect.HostEffectTransport,
  desired: extdeps.dns.domain_name.DnsLabel,
) -> HostnameSetCasOutcome {
  match transport {
    gunbc.host_effect.LocalShell => hostname_set_local(desired: desired)
    gunbc.host_effect.SshShell { ssh_host: h } => hostname_set_ssh(hostnamectl_path: hostnamectl_path, host: h, desired: desired)
    FleetSsh { target: t, context: c } => hostname_set_fleet_ssh(hostnamectl_path: hostnamectl_path, target: t, context: c, desired: desired)
    gunbc.host_effect.EmitArtifactThenThinRun { bootstrap: _, invocation: _ } =>
      HostnameSetCasApplyFailed { stderr: "EmitArtifactThenThinRun unsupported for hostname set" }
  }
}

fn hostname_set_cas(
  hostnamectl_path: std.types.NonEmptyStr,
  transport: gunbc.host_effect.HostEffectTransport,
  base: extdeps.dns.domain_name.DnsLabel,
  desired: extdeps.dns.domain_name.DnsLabel,
) -> HostnameSetCasOutcome {
  match gunbc.hostname_read.hostname_short_read(transport: transport) {
    gunbc.hostname_read.HostnameShortCaptured { value: observed } =>
      if observed == (base as String) {
        hostname_set_apply(hostnamectl_path: hostnamectl_path, transport: transport, desired: desired)
      } else {
        HostnameSetCasBaseMismatch { observed: observed, base: base }
      }
    gunbc.hostname_read.HostnameShortCaptureRefused { reason: why } => HostnameSetCasReadRefused { reason: why }
  }
}
