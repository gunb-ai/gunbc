module gunbc.merge_lifecycle

import std.types { CommitSha, String, List, Bool, Int }
import std.content_hash { content_hash_atom, content_hash_tagged_structural }
import extdeps.github.checks { Success }
import extdeps.git.object_store { GitObjectId, git_sha1_object_id, GitSha1ObjectId }
import std.content_hash { Sha1Digest, Sha1DigestHex }
import gunbc.merge_admission {
  MergeAdmissionReceipt,
  AdmissionPolicy,
  policy_admits,
  mint_merge_admission_receipt,
  GateRosterHash,
  merge_admission_fixture_git_tree_from_tagged,
}

// Lifecycle DYNAMICS over the gunbc.merge_admission authority — no second admission predicate
// (DESIGN 2: derive, never restate). gunbc.merge_admission owns the static question (is THIS
// receipt admissible against THIS target tree and roster); this module owns the temporal one (does
// a merge PROCESS whose merge step consults policy_admits ever advance main to a tree the process
// never verified). Squash semantics per gunbc.plans.branch_merge_admission_model section 1: the
// landed tree is the PR applied to CURRENT main at merge time (squash_result_tree), never the base
// the receipt recorded — which is exactly why staleness is expressible at all. Trees and rosters
// are symbolic fixture identities (content_hash_atom roots advanced by content_hash_tagged,
// injective in tag x payload), the same fixture idiom test.claim.merge_admission_witness already
// uses for its b0/b1/r0/r1 hashes.

// Grounding incident (2026-07-16, the #6663 x #6686 main-red): PR #6663 went green on run
// 29459154549 against a pre-#6686 base; #6686 landed during that window; the squash union — never
// tested — reddened every main push at floor resolve with 28 missing-field errors (first red: run
// 29461044828) until the root fix #6701. In this module's vocabulary: RunPrCi(#6663) minted a
// receipt at tip0; MergePr(#6686) advanced the tip; MergePr(#6663) then landed
// squash_result_tree(#6663, tip1) with only a tip0 receipt — admitted under PerPrGateOnly (the live
// policy: GitHub strict_required_status_checks false, no merge queue), refused under KeyedReceipt
// as MergeDeniedStaleBase. The incident trace is the permanent RED fixture in
// test.claim.merge_lifecycle_interleaving_witness.

// SEMANTIC MERGE BREAKS ARE KNOWINGLY ACCEPTED DEBT, NOT AN UNOWNED GAP (operator ruling,
// 2026-08-27, relayed through the parent lane). THE CLASS: one PR widens a closed coproduct,
// another adds or holds a match total over it, neither touches the other lines. Git merges clean
// because MERGEABLE is a claim about TEXT, and the composed tree then carries a non-exhaustive
// match that neither source branch contained. Silent at textual integration, loud at semantic
// acceptance -- the closed coproduct and the total match do their job, but only after the merge is
// irreversible. THE INCIDENT NOTE ABOVE IS THE SAME LIFECYCLE SHAPE with a different break kind:
// 2026-07-16 landed 28 missing-field errors by the identical route, so the staleness this module
// models is not specific to exhaustiveness. Two further instances, both verified rather than
// relayed: gunbc PR 9343 (merged 2026-08-26, MAIN WENT RED -- 9227 adds a match over
// ClaimDisposition, 9263 widens ClaimDisposition, both green, both clean, refused at strict
// preparation the moment they met) and gunbc PR 9283 (caught pre-merge only because the merge
// touched a file the author also changed, which is a habit rather than a mechanism). IN THIS MODULE
// VOCABULARY the class is exactly lifecycle_admits_unverified_tip: MergePr advances the tip, a
// later MergePr lands squash_result_tree against a receipt minted at the older tip. PerPrGateOnly
// admits it; KeyedReceipt refuses it as MergeDeniedStaleBase. So the remedy is already modeled here
// and is simply not the live policy. WHY IT IS DEBT RATHER THAN A DEFECT TO FIX NOW: the required
// run is about 50 minutes, so a pre-merge current-base rerun would serialize the merge queue behind
// a full floor for every PR, and the operator expects the better answer to come from technology
// under construction -- SCM giving real ancestry and v2 lenses giving cheaper corpus questions --
// rather than from another pre-merge gate. That is a priced decision, not an oversight. THE RUNG IS
// HONEST ONLY IF THE DIVERGENCE IS STATED: merge_admission_enforcement_policy declares
// KeyedReceipt, its only consumer in the corpus is a witness asserting that it equals KeyedReceipt,
// and merge-admission stamping sits on the DESIGN unguarded list after the floor cut. So the
// declared policy is not the enforced one, and a reader must not take the declaration as evidence
// that stale bases are refused. NEXT INSTANCE: add a line here rather than escalating. The class is
// owned, the remedy is named, and re-escalation costs a lane its afternoon to reach this same
// ruling.

// The interleaving witness enumerates EVERY event sequence of exact length 4 over its alphabet (no
// sampling, no silent cap — the witness asserts the full count so truncation cannot read as
// coverage, DESIGN 5). The alphabet includes the same PR number at two different heads: the
// ordinary auto-heal transition where generated artifacts are committed after an earlier head
// earned evidence. The violation flag LATCHES in LifecycleState, so every shorter lifecycle is
// covered as a prefix of some length-4 sequence. 4 suffices for the grounded incident (4 events),
// for the roster axis (3 events: RunPrCi, RosterBump, MergePr), and for the heal axis (2 events:
// RunPrCi(old head), MergePr(healed head)); widening the window or alphabet is priced only when a
// concrete interleaving class needs it (DESIGN 6).

type PrIdentity {
  number: Int
  head_sha: CommitSha
  squash_tag: String
}

type LifecycleEvent
  = RunPrCi { pr: PrIdentity }
  | MergePr { pr: PrIdentity }
  | RosterBump

type VerifiedRun {
  tree: GitObjectId
  roster: GateRosterHash
}

type LifecycleState {
  main_tip: GitObjectId
  current_roster: GateRosterHash
  verified: List<VerifiedRun>
  receipts: List<MergeAdmissionReceipt>
  unverified_tip_seen: Bool
}

fn squash_result_tree(pr: PrIdentity, base: GitObjectId) -> GitObjectId {
  merge_admission_fixture_git_tree_from_tagged(tag: pr.squash_tag as NonEmptyStr, base: base)
}

fn initial_lifecycle_state() -> LifecycleState {
  let tip0 = match git_sha1_object_id(hex: "0000000000000000000000000000000000000001") {
    Present { value: oid } => oid
    Absent =>
      GitSha1ObjectId {
        digest: Sha1Digest {
          hex: "0000000000000000000000000000000000000001" as Sha1DigestHex,
        },
      }
  }
  let roster0 = content_hash_atom(value: "merge-lifecycle-roster-0")
  LifecycleState {
    main_tip: tip0,
    current_roster: roster0,
    verified: [VerifiedRun { tree: tip0, roster: roster0 }],
    receipts: [],
    unverified_tip_seen: false,
  }
}

fn receipt_is_for_pr_head(r: MergeAdmissionReceipt, pr: PrIdentity) -> Bool {
  match r.pr_number {
    Present { value } => value == pr.number && r.head_sha == pr.head_sha
    Absent => false
  }
}

fn latest_receipt_for(receipts: List<MergeAdmissionReceipt>, pr: PrIdentity) -> List<MergeAdmissionReceipt> {
  fold(receipts, init: [], f: fn(acc, r) {
    if receipt_is_for_pr_head(r: r, pr: pr) { [r] } else { acc }
  })
}

// latest_receipt_for keeps the LAST minted receipt for the exact (PR number, head SHA) pair. GitHub
// required checks attach evidence to a commit, not to a mutable PR number: after auto-heal pushes a
// new head, the old head's green is historical evidence and the new head has no admissible receipt
// until CI re-runs. Joining on number alone admitted RunPrCi(old head) then MergePr(healed head),
// the exact stale-evidence class the heal transition creates.

fn merge_enabled(
  policy: AdmissionPolicy,
  receipts: List<MergeAdmissionReceipt>,
  pr: PrIdentity,
  tip: GitObjectId,
  roster: GateRosterHash,
) -> Bool {
  fold(latest_receipt_for(receipts: receipts, pr: pr), init: false, f: fn(acc, r) {
    acc || policy_admits(
      policy: policy,
      receipt: r,
      merge_target_tree_hash: tip,
      current_roster_hash: roster,
    )
  })
}

fn verified_contains(xs: List<VerifiedRun>, probe: VerifiedRun) -> Bool {
  fold(xs, init: false, f: fn(acc, v) {
    acc || (v.tree == probe.tree && v.roster == probe.roster)
  })
}

fn apply_lifecycle_event(policy: AdmissionPolicy, state: LifecycleState, ev: LifecycleEvent) -> LifecycleState {
  match ev {
    RunPrCi { pr } =>
      let tested = squash_result_tree(pr: pr, base: state.main_tip)
      let receipt = mint_merge_admission_receipt(
        pr_number: Present { value: pr.number },
        head_sha: pr.head_sha,
        base_tree_hash: state.main_tip,
        gate_roster_hash: state.current_roster,
        conclusion: Success,
      )
      LifecycleState {
        main_tip: state.main_tip,
        current_roster: state.current_roster,
        verified: concat(state.verified, [VerifiedRun { tree: tested, roster: state.current_roster }]),
        receipts: concat(state.receipts, [receipt]),
        unverified_tip_seen: state.unverified_tip_seen,
      }
    MergePr { pr } =>
      if merge_enabled(policy: policy, receipts: state.receipts, pr: pr, tip: state.main_tip, roster: state.current_roster) {
        let landed = squash_result_tree(pr: pr, base: state.main_tip)
        LifecycleState {
          main_tip: landed,
          current_roster: state.current_roster,
          verified: state.verified,
          receipts: state.receipts,
          unverified_tip_seen: state.unverified_tip_seen
            || !verified_contains(xs: state.verified, probe: VerifiedRun { tree: landed, roster: state.current_roster }),
        }
      } else {
        state
      }
    RosterBump =>
      LifecycleState {
        main_tip: state.main_tip,
        current_roster: content_hash_tagged_structural(
          tag: "merge-lifecycle-roster-bump",
          payload: state.current_roster
        ),
        verified: state.verified,
        receipts: state.receipts,
        unverified_tip_seen: state.unverified_tip_seen,
      }
  }
}

// The unverified_tip_seen latch is checked ONLY where main ADVANCES (an admitted MergePr): the quantified property is that the merge step never lands a tree unverified under the roster current at landing. A RosterBump alone does not latch — criteria drift over a standing tip is the stale-ROSTER admission question the static gunbc.merge_admission witnesses already discriminate, not a merge-step fault; a disabled merge is a refusal, and a refusal is never a violation.
fn simulate_lifecycle(policy: AdmissionPolicy, events: List<LifecycleEvent>) -> LifecycleState {
  fold(events, init: initial_lifecycle_state(), f: fn(acc, ev) {
    apply_lifecycle_event(policy: policy, state: acc, ev: ev)
  })
}

fn lifecycle_admits_unverified_tip(policy: AdmissionPolicy, events: List<LifecycleEvent>) -> Bool {
  simulate_lifecycle(policy: policy, events: events).unverified_tip_seen
}

fn singleton_sequences(alphabet: List<LifecycleEvent>) -> List<List<LifecycleEvent>> {
  fold(alphabet, init: [], f: fn(acc, ev) { concat(acc, [[ev]]) })
}

fn extend_event_sequences(seqs: List<List<LifecycleEvent>>, alphabet: List<LifecycleEvent>) -> List<List<LifecycleEvent>> {
  fold(seqs, init: [], f: fn(acc, seq) {
    concat(acc, fold(alphabet, init: [], f: fn(acc2, ev) {
      concat(acc2, [concat(seq, [ev])])
    }))
  })
}

fn event_sequences_of_length_4(alphabet: List<LifecycleEvent>) -> List<List<LifecycleEvent>> {
  extend_event_sequences(
    seqs: extend_event_sequences(
      seqs: extend_event_sequences(
        seqs: singleton_sequences(alphabet: alphabet),
        alphabet: alphabet,
      ),
      alphabet: alphabet,
    ),
    alphabet: alphabet,
  )
}

fn count_unverified_admitting_sequences(policy: AdmissionPolicy, seqs: List<List<LifecycleEvent>>) -> Int {
  fold(seqs, init: 0, f: fn(acc, seq) {
    if lifecycle_admits_unverified_tip(policy: policy, events: seq) { acc + 1 } else { acc }
  })
}
