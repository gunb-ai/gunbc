module gunbc.class_b_import_closure_overlay

import extdeps.filesystem.filesystem_io
import extdeps.shell
import std.types { String, Bool, Int, List, NonEmptyStr }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import gunbc.seed_growth { SeedGrowthJustification }
import gunbc.roadmap_model { RoadmapNodeId }

data class_b_overlay_note: String = "Derives the Class B stripped entry overlay from the live rust_test_fixtures.dag at execution time (#7817 strip_import_block property, moved to the executing transport/witness path). No checked-in copy of the live corpus file — the overlay is read from disk, the declared rust import block removed under a typed strip receipt, and written under a caller-supplied overlay root so pool-membership coincidence cannot drift silently."

data class_b_entry_rel: String = "src/v2/extdeps/languages/rust_test_fixtures.dag"
data class_b_rust_import_prefix: String = "import v2.extdeps.languages.rust"

data class_b_declared_import_pool_roots_note: String = "Minimal explicit pool for Class B rows 1-2 (#7835): the declared-import-closure footprint for rust_test_fixtures — entry plus v2.extdeps.languages.rust and its transitive std/extdeps dependencies — NOT witness_layer_roots. Stronger control: binding is observed with no unrelated ambient modules that could accidentally supply rust symbols; row 2 prepends fixtures/class_b_import_closure/perturbation_overlay to this baseline only. Rows 3-4 on the transport gate keep witness_layer_roots for stripped-entry pool-coincidence pressure."

data class_b_accidental_coverage_seed_growth_justification: SeedGrowthJustification = SeedGrowthJustification {
  hand_authored_declarations: [
    DeclarationRef {
      module_path: "v1_compiler.cli_run",
      decl_name: "CLASS_B_ACCIDENTAL_COVERAGE_EXCEPTIONS",
      field: WholeDeclaration
    },
    DeclarationRef {
      module_path: "v1_compiler.cli_run",
      decl_name: "class_b_diagnostic_is_named_exception",
      field: WholeDeclaration
    },
    DeclarationRef {
      module_path: "v1_compiler.cli_run",
      decl_name: "declared_import_closure_exempted_diagnostic_count",
      field: WholeDeclaration
    }
  ],
  reason: "The exception roster and its join live in Rust because that is where the diagnostics exist. The substrate cannot decide this today: the observation seam hands .dag a Bool, which collapses refused and genuinely-unlisted into one false, and the refusal cause is a String. So a .dag-side exception could only have matched on text or on a COUNT THRESHOLD — and a threshold is exactly the pattern the operator ruling forbade, because it would absorb any future breakage that happened to fit under the number. Naming the diagnostics at the seam is what made an exact (file, type) roster possible at all; the three declarations are that roster, its pair predicate, and the counter that keeps every exemption visible.\n\nENUMERATED RATHER THAN COUNTED, per the failure the stage0 census records: these are every hand-authored item this change adds, not the ones I happened to look at. No Display impl or trait method is involved, so the citable count and the real count are both three.\n\nDeclared even though nothing would have caught it — gunbc.seed_growth_admission's join is NOT enrolled (diff candidates absent until rust_item_host_observation), and the reviewer on this PR explicitly recorded no hand-Rust concern. An undeclared row that no gate checks is the invisible state this roster exists to end.",
  owning_dissolution_lane: "v1-hand-queue-drain" as RoadmapNodeId,
  trigger: "Delete all three when the closure-independent binding fix or the provable-coverage construction check lands and the roster goes to zero rows — the same dissolve-on the exception note carries. If the observation seam gains a typed outcome carrying diagnostic identities to .dag before that, the roster and its join migrate to the substrate and only the seam projection remains.",
  current_boundary: "gunbc.class_b_import_closure_overlay class_b_accidental_coverage_exception_note -> v1_compiler.cli_run CLASS_B_ACCIDENTAL_COVERAGE_EXCEPTIONS -> v1_compiler.cli_run declared_import_closure_binding_observation_from_resolved"
}

data class_b_accidental_coverage_exception_note: String = "THE ONE NAMED ACCIDENTAL-COVERAGE EXCEPTION for the Class B declared-import-closure observation (operator ruling 2026-08-09). src/v2/std/grounding.dag carries ZERO imports and reaches v2.std.host_run.EmitHostRunReceipt (twice) and v2.std.verdict.VerdictTally by dotted path, so those bind only when some unrelated importer has already pulled those modules into the assembled closure — a live Class B pool-membership-coincidence specimen, the class the import-strip witness-discovery cascade names as the blocker on further dag/** stripping.\n\nTWO ALTERNATIVES WERE REJECTED, and recording why is the point of this row. Widening class_b_declared_import_pool_roots would promote pool-coincidence to gate policy and blind the gate to precisely the class it exists to observe. Restoring grounding.dag's import closure would UN-STRIP an already-stripped module — motion against the namespace lane whose terminal state is deleting the import grammar outright, paid now and unwound later. The third option is the only one leaving both the gate's meaning and the lane's direction intact: the file becomes a COUNTED member of the accidental-coverage population instead of an invisible one, which is strictly more honest than the prior state where it sat in the same condition with nobody counting it.\n\nIT IS A ROSTER OF EXACT (file, type) PAIRS AND NEVER A PATTERN, so it cannot weaken the observation for any other file. Proven by execution rather than asserted: planting a FOURTH unresolved type in that same file returns the gate to false while the three named rows stay exempt, and every exemption is counted and printed at the seam rather than silently dropped — an exemption leaving no trace would be indistinguishable from a clean compile. The realization roster lives at v1_compiler.cli_run CLASS_B_ACCIDENTAL_COVERAGE_EXCEPTIONS, where the diagnostics exist; this row is the authority for WHY it exists and when it dies.\n\nWHAT THE POPULATION IS ACTUALLY REACHED BY, corrected 2026-08-09 (proud-ferret evidence, folded in on operator consolidation). The cascade diagnosis frames this class as a blocker on IMPORT-STRIPPING, which reads as though only a deliberate strip can surface it. It does not: ORDINARY AFFECTED-SET SELECTION reaches it too, because selection narrows the assembled pool, and a bare reference that binds under a wide pool stops binding under a narrow one. That makes the class reachable by any change that shifts which modules a run assembles — a routine PR, not just a strip wave — and it is why the live specimens showed up as CI reds on unrelated lanes rather than during stripping work. The consequence for this roster: its size is NOT a measure of how much stripping has happened, and a quiet corpus is not evidence the population is small. Only a closure-independent binding fix or the provable-coverage check makes the count meaningful.\n\n🟡 dissolve-on: the closure-independent binding fix, or the provable-coverage construction check, that the import-strip cascade names as the unblock condition for dag/** stripping. When either lands, grounding.dag binds from its own declared closure and the roster goes to zero rows."

data class_b_declared_import_pool_roots: List<String> = [
  "dag/std",
  "dag/extdeps",
  "src/v2/extdeps/languages",
  "src/v2/std"
]

type StripImportFoldState {
  skipping: Bool
  blocks_found: Int
  blocks_removed: Int
  out: List<String>
}

fn strip_import_line_fold(acc: StripImportFoldState, line: String) -> StripImportFoldState {
  if starts_with(s: line, prefix: class_b_rust_import_prefix) {
    StripImportFoldState {
      skipping: true,
      blocks_found: acc.blocks_found + 1,
      blocks_removed: acc.blocks_removed,
      out: acc.out
    }
  } else if acc.skipping {
    if line == "}" {
      StripImportFoldState {
        skipping: false,
        blocks_found: acc.blocks_found,
        blocks_removed: acc.blocks_removed + 1,
        out: acc.out
      }
    } else {
      acc
    }
  } else {
    StripImportFoldState {
      skipping: false,
      blocks_found: acc.blocks_found,
      blocks_removed: acc.blocks_removed,
      out: concat(acc.out, [line])
    }
  }
}

type StripImportBlockReceipt
  = StripImportValid { content: String }
  | StripImportRefused { cause: NonEmptyStr }

fn strip_rust_test_fixtures_import_block(content: String) -> StripImportBlockReceipt {
  let final_state = fold(
    split(s: content, delimiter: "\n"),
    init: StripImportFoldState { skipping: false, blocks_found: 0, blocks_removed: 0, out: [] },
    f: fn(acc, line) { strip_import_line_fold(acc: acc, line: line) }
  )
  if final_state.blocks_found != 1 {
    StripImportRefused { cause: "expected exactly one rust import block" as NonEmptyStr }
  } else if final_state.blocks_removed != 1 {
    StripImportRefused { cause: "rust import block opened but not closed" as NonEmptyStr }
  } else if final_state.skipping {
    StripImportRefused { cause: "strip terminated inside import block" as NonEmptyStr }
  } else {
    StripImportValid { content: join(final_state.out, "\n") }
  }
}

type ClassBOverlayMaterialization
  = OverlayMaterialized { overlay_entry_path: String }
  | OverlayMaterializationRefused { phase: NonEmptyStr, cause: NonEmptyStr }

func class_b_materialize_stripped_entry_overlay(root: String, overlay_dir: String) -> ClassBOverlayMaterialization {
  let live_path = concat(root, "/", class_b_entry_rel)
  let overlay_path = concat(overlay_dir, "/", class_b_entry_rel)
  let read = Filesystem.Read(path: live_path)
  if read.success {
    match strip_rust_test_fixtures_import_block(content: read.content) {
      StripImportValid { content } => {
        let parents = shell.Mkdir.Parents(path: overlay_path)
        if parents.success {
          let write = Filesystem.Write(path: overlay_path, content: content)
          if write.success {
            OverlayMaterialized { overlay_entry_path: overlay_path }
          } else {
            OverlayMaterializationRefused {
              phase: "write" as NonEmptyStr,
              cause: "overlay write refused" as NonEmptyStr
            }
          }
        } else {
          OverlayMaterializationRefused {
            phase: "mkdir" as NonEmptyStr,
            cause: "overlay parent mkdir refused" as NonEmptyStr
          }
        }
      }
      StripImportRefused { cause } => OverlayMaterializationRefused {
        phase: "strip" as NonEmptyStr,
        cause: cause
      }
    }
  } else {
    OverlayMaterializationRefused {
      phase: "read" as NonEmptyStr,
      cause: "live rust_test_fixtures read refused" as NonEmptyStr
    }
  }
}
