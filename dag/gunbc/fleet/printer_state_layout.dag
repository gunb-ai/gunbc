module gunbc.fleet.printer_state_layout

import std.types { List }
import gunbc.owned_directory { OwnedDirectoryTarget }
import gunbc.host_state_root { HostStateTree }
import gunbc.fleet.printer_workflow_artifact { printer_starts_directory, print_run_directory_target }
import gunbc.fleet.print_record_stores { print_request_directory_target, print_completion_directory_target }
import gunbc.fleet.printer_actuation { printer_start_claim_directory_target }
import gunbc.fleet.printer_start_evidence_store { start_evidence_directory_target }
import product.printed_chassis.assembly_inventory_store { cassette_inventory_directory_target }

// THE PRINTER STATE TREE'S LAYOUT: the directories a printer pass demands. The one-time step that carried the
// flat layout the printer-starts directory held until 2026-10-30 onto the per-store members was retired on
// 2026-11-09 together with the printer execution hold (operator ruling): once the parent became root-owned
// 0755 (security ruling 2026-11-05) the de-privileged job user could no longer write there, so the move and the
// hold release it depended on could never complete. The remaining flat entries were removed by hand on srv1 at the operator's direction.

// THE DIRECTORIES A PRINTER PASS DEMANDS, each derived from the declaration of the module that owns the store.
fn printer_state_directories(tree: HostStateTree) -> List<OwnedDirectoryTarget> {
  [
    printer_starts_directory(tree: tree),
    start_evidence_directory_target(tree: tree),
    print_request_directory_target(tree: tree),
    print_completion_directory_target(tree: tree),
    printer_start_claim_directory_target(tree: tree),
    cassette_inventory_directory_target(tree: tree),
    print_run_directory_target(tree: tree),
  ]
}
