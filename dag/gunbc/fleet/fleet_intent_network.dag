// 🟡 dissolve-on: the NetworkEndpoint.address / NetworkSegment.cidr / gateway literals in this file
// are still bare `"192.168.1.x"` / CIDR strings even though this same lane grounded the address
// leaves (extdeps.network.ipv4 Ipv4Address = 4 bounded Octets, extdeps.network.address IpAddress =
// IpV4|IpV6, and the DHCP lease rows migrated to the ipv4_address constructor). The octet
// decomposition is half-consumed here: product.network_topology.NetworkEndpoint.address is typed
// String, so grounding these sites means re-typing that field to extdeps.network.address.IpAddress
// (and cidr/gateway to their grounded carriers) and migrating every NetworkEndpoint/NetworkSegment
// consumer — a product-layer field change, not a gunbc-local edit, so it is deliberately deferred
// rather than half-done. DISSOLVES WHEN NetworkEndpoint.address re-grounds onto IpAddress; until
// then these literals are the §3 residual the reach lane closes, tracked here so the loop is
// visible rather than silently forked. The grounded rows the reach lane already built —
// gunbc.fleet_reach.srv2_lan_ipv4 / srv3_lan_ipv4 (extdeps.network.ipv4.Ipv4Address, consumed by
// srv3_reach) — are the CONVERGENCE TARGET these bare strings dissolve onto, not an independent
// second grounding: srv2/srv3's address becomes those rows when the field re-types, so the
// transitional dual representation is marked debt heading toward one authority, not a permanent
// fork.

data operator_lan_segment: NetworkSegment = NetworkSegment {
  cidr: "192.168.1.0/24",
  gateway: Present { value: "192.168.1.1" },
  locality: Lan,
}

data operator_docker_bridge_default_segment: NetworkSegment = NetworkSegment {
  cidr: "172.17.0.0/16",
  gateway: none,
  locality: DockerBridge,
}

data operator_docker_bridge_secondary_srv1_segment: NetworkSegment = NetworkSegment {
  cidr: "172.18.0.0/16",
  gateway: none,
  locality: DockerBridge,
}

