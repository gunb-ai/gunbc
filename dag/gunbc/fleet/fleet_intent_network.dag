// THE PRINTER IS AN APPLIANCE ON THE OPERATOR LAN, NOT A HOST. `host` is absent because no
// HostIdentity names it and inventing one would be a second name for printer_01. Its reachability
// zone is HostLan, which network_reachability already says ContainerRunner cannot reach -- so every
// route from this repo to this address is brokered through a host on the segment, by the model and
// not by a workaround.
data printer_01_lan_endpoint: NetworkEndpoint = NetworkEndpoint {
  label: "printer-01-lan",
  subject: EndpointAsset { asset: printer_01 },
  address: "192.168.1.234",
  role: FabricationAppliance,
  locality: Lan,
}

// BOTH PRINTER RESERVATIONS, TRANSCRIBED FROM THE OPERATOR'S LIVE CR1000A TABLE ON 2026-09-04. The
// table reports Static, Active and expiry Never for both bindings. These rows carry MAC and status;
// each endpoint projects the same address into the topology until NetworkEndpoint.address reaches
// the grounded IpAddress carrier named by the dissolve-on row.
data printer_01_lan_reservation: Cr1000aDhcpLeaseRow = Cr1000aDhcpLeaseRow {
  mac_address: "68:EE:8F:66:2A:28" as MacAddress,
  ipv4_address: ipv4_address(octet1: 192, octet2: 168, octet3: 1, octet4: 234),
  lease: StaticDhcpReservation {
    reservation_label: "printer-01" as NonEmptyStr,
    status: Active,
  },
}

data printer_02_lan_reservation: Cr1000aDhcpLeaseRow = Cr1000aDhcpLeaseRow {
  mac_address: "68:EE:8F:60:AC:14" as MacAddress,
  ipv4_address: ipv4_address(octet1: 192, octet2: 168, octet3: 1, octet4: 235),
  lease: StaticDhcpReservation {
    reservation_label: "printer-02" as NonEmptyStr,
    status: Active,
  },
}

data printer_02_lan_endpoint: NetworkEndpoint = NetworkEndpoint {
  label: "printer-02-lan",
  subject: EndpointAsset { asset: printer_02 },
  address: "192.168.1.235",
  role: FabricationAppliance,
  locality: Lan,
}

data fleet_intent_network: NetworkTopology = NetworkTopology {
  tailnet_domain: Present { value: "tailecbe08.ts.net" },
  segments: [
    operator_lan_segment,
    operator_docker_bridge_default_segment,
    operator_docker_bridge_secondary_srv1_segment,
  ],
  endpoints: [
    operator_lan_gateway_endpoint,
    srv1_host_lan_endpoint,
    srv2_host_lan_endpoint,
    srv3_host_lan_endpoint,
    srv4_host_lan_endpoint,
    srv5_host_lan_endpoint,
    srv6_host_lan_endpoint,
    srv7_host_lan_endpoint,
    srv8_host_lan_endpoint,
    srv9_host_lan_endpoint,
    srv10_host_lan_endpoint,
    srv11_host_lan_endpoint,
    srv1_bmc_endpoint,
    srv2_bmc_endpoint,
    srv3_bmc_endpoint,
    srv4_bmc_endpoint,
    srv1_tailscale_endpoint,
    srv2_tailscale_endpoint,
    printer_01_lan_endpoint,
    printer_02_lan_endpoint,
  ],
}

fn fleet_intent_network_topology() -> NetworkTopology {
  fleet_intent_network
}
