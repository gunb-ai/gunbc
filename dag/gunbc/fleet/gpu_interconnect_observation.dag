// A NAME, not a summary. The controls are the rows above and each carries its own `open` flag; anything that
// wants to know how many are open or what was closed reads the list. A row that restated the count or the status
// here would be a second source for one fact, held in sync by a check -- which is exactly what the model is for.
data srv1_collective_read_obligation: NonEmptyStr = "The controls on the srv1 collective-transport lane are the rows of srv1_collective_read_follow_ups_2026_11_09, each carrying its own open flag; this row exists only so the task has one addressable name." as NonEmptyStr

// THE RUN RECORD, with the identity that makes it checkable as FIELDS: which units had to be stopped, which
// containers were removed, when the window was open, when the numbers were actually taken, the instrument and the
// log that back them. It is a separate row from the obligation so an open task cannot read as closed while
// keeping its name, and it carries no verdict field: what the run SHOWS is arithmetic over the reading rows.
type Srv1CollectiveReadRun {
  // THE INSTANTS ARE THE PARTS, NOT TEXT. A stored `NonEmptyStr` instant accepts `2026-11-9T22:3:4Z` until a
  // consumer asks for a span and gets an absent answer; over the calendar's instant type the parts are typed and
  // the span is a subtraction, so a bad instant cannot sit in a record unnoticed.
  window_start: Iso8601UtcInstant,
  window_end: Iso8601UtcInstant,
  measurement_start: Iso8601UtcInstant,
  measurement_end: Iso8601UtcInstant,
  units_stopped: List<NonEmptyStr>,
  containers_removed: List<NonEmptyStr>,
  instrument_sha256: NonEmptyStr,
  results_log_path: NonEmptyStr,
  results_log_sha256: NonEmptyStr,
  // What this run MEANS is not a field. A conclusion is an arithmetic claim over the reading rows the run
  // produced (the witness claims on the two runs), not a sentence a consumer has to trust and a substring
  // test has to grep. The record holds only what cannot be re-derived: which units were stopped and removed,
  // the instrument and its digest, the log and its digest, and the instants the spans are computed from.
}

data srv1_collective_read_executed_2026_11_09: Srv1CollectiveReadRun = Srv1CollectiveReadRun {
  window_start: Iso8601UtcInstant { date: Iso8601CivilDate { year: 2026, month: 11, day: 9 }, hour: 22, minute: 39, second: 48 },
  window_end: Iso8601UtcInstant { date: Iso8601CivilDate { year: 2026, month: 11, day: 9 }, hour: 22, minute: 47, second: 37 },
  measurement_start: Iso8601UtcInstant { date: Iso8601CivilDate { year: 2026, month: 11, day: 9 }, hour: 22, minute: 40, second: 35 },
  measurement_end: Iso8601UtcInstant { date: Iso8601CivilDate { year: 2026, month: 11, day: 9 }, hour: 22, minute: 40, second: 51 },
  units_stopped: ["lil-replica@0" as NonEmptyStr, "lil-replica@1" as NonEmptyStr],
  containers_removed: ["lil-flash-next" as NonEmptyStr, "lil-flash-next-1" as NonEmptyStr],
  instrument_sha256: "702a2bce83cb6c76ca51699457822fb06e840c37ba377bb0b5247a8b2653b1cc" as NonEmptyStr,
  results_log_path: "/home/briansrls/jh_nccl_results_20261109T224035Z.log" as NonEmptyStr,
  results_log_sha256: "8788e3353eb939847982a51053aefd9f6aa1c32b2705417cdc078e720238b6e1" as NonEmptyStr,
}

// THE INSTANTS ARE THE FACT; A DURATION IS COMPUTED FROM THEM. The span of a collective read is the difference
// of two instants in extdeps.units.iso8601_calendar's own arithmetic -- there is no second subtraction of a
// date-time anywhere in this lane, and no duration stored beside the pair it comes from. A reversed pair answers
// Absent; it never falls back to a number someone remembered. This is not ceremony: making the two dependent
// caught a real 7 s drift between a kill instant and a ready duration elsewhere in this window, where both had
// been written by hand.

// The spans of a collective read, derived from its own record. The router-window row in
// gunbc.serving.srv1_serving_replica_layout reads these instead of typing the same two durations out again, so
// correcting an instant here moves the number there, or turns it red if the instants stop naming a span.
fn srv1_collective_read_window_duration(run: Srv1CollectiveReadRun) -> Second? {
  iso8601_utc_instant_seconds_between(earlier: run.window_start, later: run.window_end)
}

fn srv1_collective_read_measurement_duration(run: Srv1CollectiveReadRun) -> Second? {
  iso8601_utc_instant_seconds_between(earlier: run.measurement_start, later: run.measurement_end)
}

// The two arms of every srv1 collective read, named ONCE. Both the 2026-11-08 loaded sweep and the
// 2026-11-09 unloaded re-run say which arm a row belongs to by referencing these values, so a claim can ask
// "the same arm, in both runs" without spelling a string, and a row that renames an arm stops matching
// instead of quietly comparing different runs.
data srv1_nccl_arm_default: NonEmptyStr = "no-flag default" as NonEmptyStr
data srv1_nccl_arm_p2p_disabled: NonEmptyStr = "NCCL_P2P_DISABLE=1" as NonEmptyStr

// THE SAME INSTRUMENT, ONE CLAUSE DIFFERENT. The 2026-11-09 re-run used the identical docker/torchrun command as
// the 2026-11-08 sweep -- same image digest, same two --device pins, same ports, same debug subsys -- with one
// difference that is the whole point of the run: neither serving replica was holding memory. It is written as a
// second line rather than an edit of the first because both readings are kept side by side; a reader comparing
// them should see exactly one clause change and nothing else. The arm is named the same way the harness named
// it (-e ARM=...), and the row-level env_arm field carries the shared arm label.
fn nccl_unloaded_arm_instrument(arm: NonEmptyStr, port: NonEmptyStr, printed: NonEmptyStr) -> NonEmptyStr {
  string_concat_join(
    fields: [
      "docker run --rm --network host --ipc host --shm-size=2g --device nvidia.com/gpu=GPU-7b58568e-8bc9-4e4b-bc6c-c414b08936c3 --device nvidia.com/gpu=GPU-96b749dc-e2ea-5b6f-2e45-ee868b1a9750 -v /home/briansrls/lil:/lil:ro -e ARM=",
      arm as String,
      " -e MASTER_ADDR=127.0.0.1 -e MASTER_PORT=",
      port as String,
      " -e NCCL_DEBUG=INFO -e NCCL_DEBUG_SUBSYS=INIT,P2P,SHM,NET --entrypoint torchrun 2ad6245e058d --nnodes=1 --nproc-per-node=2 --master_addr=127.0.0.1 --master_port=",
      port as String,
      " /lil/nccl_test.py on srv1 (image 2ad6245e058d, torch 2.14.0a0+4fdf77b940.nv26.08, CUDA 13.4; rank 0 was cuda 0 = GPU-7b58568e, rank 1 cuda 1 = GPU-96b749dc). NEITHER serving replica loaded: lil-replica@0 and lil-replica@1 were stopped and their containers removed for the window 2026-11-09T22:39:48Z..22:47:37Z, which is the confounder this re-run removes relative to the 2026-11-08 sweep. Printed line: ",
      printed as String,
    ],
    separator: "",
  ) as NonEmptyStr
}

