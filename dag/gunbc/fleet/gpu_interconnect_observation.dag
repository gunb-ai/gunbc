// ACS is read at the ROOT PORTS, because that is where a request between the two functions would be
// redirected. ACSCtl read SrcValid+ TransBlk- ReqRedir+ CmpltRedir+ UpstreamFwd+ EgressCtrl- DirectTrans- on
// both ports; ACSCap advertised all bits, so the control state is a choice this host is making, not a cap the
// silicon lacks.
data srv1_acs_redirection_readings: List<AcsRedirectionReading> = [
  AcsRedirectionReading {
    host: operator_host_srv1,
    root_port: "0001:00:01.0" as PciAddress,
    source_validation: true,
    req_redir: true,
    cmplt_redir: true,
    upstream_forwarding: true,
    egress_control: false,
    direct_translation: false,
    warrant: ReadByThisSession {
      read_on: "2026-11-08" as NonEmptyStr,
      instrument: "sudo lspci -vv -s 0001:00:01.0 on srv1 (Ampere Altra PCIe Root Port rev 04; ACSCap all +, ACSCtl as carried)" as NonEmptyStr,
    },
  },
  AcsRedirectionReading {
    host: operator_host_srv1,
    root_port: "0004:00:01.0" as PciAddress,
    source_validation: true,
    req_redir: true,
    cmplt_redir: true,
    upstream_forwarding: true,
