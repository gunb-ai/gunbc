// ONE OBLIGATION LEFT ON THIS READING, and it is not a missing cell: the arms differ by about 2x at 256 KiB
// and above while naming the same transport, on a machine whose GPUs were serving. Re-running both arms with
// neither lil-flash-next replica loaded settles whether the delta is NCCL's SHM path or the load.
data srv1_collective_read_obligation: NonEmptyStr = "re-run both arms with the exact command in each row's instrument, with neither lil-flash-next replica loaded (operator window), and keep the four printed lines of each arm; the claim under test is the 2x delta at 256 KiB and above" as NonEmptyStr

// WHAT IS NOT A FACT HERE. Every row names the observation that would settle it, and none of them is allowed
// to be read as a premise by a consumer (and see the note above the standing joins: there is no `is_fact`
// predicate here, because one that matches every arm to `false` guards nothing the type has not already blocked). The 2026-11-08 22:22 UTC run
// retired one relayed premise (that the NCCL arms behave the same) and promoted nothing in its place.
data srv1_interconnect_explanations: List<InterconnectExplanation> = [
  InterconnectExplanation {
    host: operator_host_srv1,
    subject: "missing peer access explains the whole TP=2 vs 2xTP=1 margin" as NonEmptyStr,
    standing: Hypothesis {
      claim: "the absence of GPU-to-GPU peer access on srv1 is what puts the whole difference between TP=2 and 2xTP=1 there, and what reverses the fork's TP=2-wins rows; the claim is about the chipset, not about NCCL, because NCCL never had a P2P path here to lose (both arms print SHM/direct), and the relayed assertion that the two NCCL arms behave identically did NOT survive the 22:22 UTC run" as NonEmptyStr,
      would_be_settled_by: "a host where the same two boards DO have peer access, measured with this same harness (the same engine revision, prompt, 8 warm sessions and 150k pool, gunbc.serving.srv1_serving_bench), showing TP=2 ahead; and the two NCCL arms above re-run with neither serving replica loaded, which is the window `srv1_collective_read_obligation` names" as NonEmptyStr,
    },
  },
  InterconnectExplanation {
    host: operator_host_srv1,
    subject: "a PCIe switch card would restore peer access on srv1" as NonEmptyStr,
    standing: Bet {
      claim: "putting the two boards behind a PCIe switch, instead of under two Altra host bridges whose root ports redirect with ACS while the SMMU translates, would let the chipset answer the peer-access query yes" as NonEmptyStr,
      would_be_settled_by: "the switch installed and `nvidia-smi topo -p2p r` answering OK for both directions on this host -- the same instrument whose CNS answer is recorded above; the relayed community account of Altra P2P across host bridges is NOT that observation and has not been retrieved by this session" as NonEmptyStr,
    },
  },
  // THE ONE THING THE 22:22 UTC RUN OPENED RATHER THAN CLOSED. NCCL named the same transport in both arms and
  // still ran about twice as fast without the P2P override, at every size from 256 KiB up. That is a reading on
  // a loaded machine, not a mechanism: the SHM path may differ between the arms, or the load may have moved
  // between the two runs. It is typed as a hypothesis so no consumer reads "SHM/direct in both arms" as
  // "therefore the arms are interchangeable" -- the numbers say they are not, and say nothing yet about why.
  InterconnectExplanation {
    host: operator_host_srv1,
    subject: "why NCCL_P2P_DISABLE=1 costs about half the bandwidth when neither arm has P2P" as NonEmptyStr,
    standing: Hypothesis {
      claim: "with the chipset already refusing peer access, NCCL_P2P_DISABLE=1 still changes which copy path NCCL takes -- the default arm reaches 4.79/12.24/12.45 GB/s at 256 KiB/4 MiB/64 MiB and the disabled arm 1.79/5.17/5.83 GB/s, while both print every channel as SHM/direct" as NonEmptyStr,
      would_be_settled_by: "both arms re-run with neither lil-flash-next replica loaded (srv1_collective_read_obligation), and if the delta survives, the NCCL debug log at NCCL_DEBUG_SUBSYS=TRANSPORT for each arm showing what each channel actually opened" as NonEmptyStr,
    },
  },
]

// ------------------------------------------------------------------ consumers' joins

// EVERY DIRECTION REFUSED AND EVERY DIRECTION READ. A pair has peer access absent only when a reading exists
// in each direction and every one of them refuses; an Unread or a yes anywhere makes this false, so a missing
// reading never reads as absence (and never reads as presence either -- it reads as not-absent).
fn gpu_pair_peer_access_is_absent(
  host: HostIdentity,
  left_board: PhysicalAssetIdentity,
  right_board: PhysicalAssetIdentity,
) -> Bool {
  let directed = filter(srv1_gpu_peer_access_readings, r =>
    host_identity_eq(a: r.host, b: host)
      && ((physical_asset_identity_eq(a: r.from_board, b: left_board) && physical_asset_identity_eq(a: r.to_board, b: right_board))
        || (physical_asset_identity_eq(a: r.from_board, b: right_board) && physical_asset_identity_eq(a: r.to_board, b: left_board))))
  let both_directions = directed.any(r => physical_asset_identity_eq(a: r.from_board, b: left_board) && physical_asset_identity_eq(a: r.to_board, b: right_board))
    && directed.any(r => physical_asset_identity_eq(a: r.from_board, b: right_board) && physical_asset_identity_eq(a: r.to_board, b: left_board))
  both_directions && directed.all(r => peer_access_is_absent(r: r))
}

// THE READING THAT gate TP=2 admission asks for: this host's own P2P answer read first-hand, and its own
// collective answer read first-hand. The collective half is FALSE today because every collective row is
// relayed or unread, which is the state of the world rather than a missing row -- the obligation rows above
// are what closes it.
fn gpu_pair_interconnect_readings_complete(host: HostIdentity, left_board: PhysicalAssetIdentity, right_board: PhysicalAssetIdentity) -> Bool {
  let p2p_read = srv1_gpu_peer_access_readings.any(r =>
    host_identity_eq(a: r.host, b: host)
      && physical_asset_identity_eq(a: r.from_board, b: left_board)
      && physical_asset_identity_eq(a: r.to_board, b: right_board)
      && srv1_reading_is_read(w: r.warrant))
  let collective_read = srv1_collective_transport_readings.any(c =>
    host_identity_eq(a: c.host, b: host) && srv1_reading_is_read(w: c.warrant))
  p2p_read && collective_read
}

fn interconnect_explanations_on(host: HostIdentity) -> List<InterconnectExplanation> {
  filter(srv1_interconnect_explanations, e => host_identity_eq(a: e.host, b: host))
}

// WHY THERE IS NO `is_fact` PREDICATE HERE. An earlier version of this module carried
// `interconnect_explanation_is_fact`, matching both arms of HypothesisStanding to `false`. It could never fail,
// which is another way of saying it guarded nothing (see gunbc.design_argument::guarantee_ladder on a check whose
// forbidden state is expressible nowhere it runs: green by construction, later cited as coverage). What keeps an
// explanation out of a premise is the TYPE: InterconnectExplanation.standing has no established arm, so a row
// cannot be written as a fact -- a consumer that wants a premise has to go find one in a reading row, and the
// witnesses pin the table's distribution (three rows, one Bet, two Hypothesis) so a silent retyping fails.

fn srv1_acs_redirects_at_both_root_ports() -> Bool {
  let ports = filter(srv1_acs_redirection_readings, a => host_identity_eq(a: a.host, b: operator_host_srv1))
  ports.length() == 2 && ports.all(a => a.req_redir && a.cmplt_redir && srv1_reading_is_read(w: a.warrant))
}

fn srv1_iommu_translates_both_gpu_groups() -> Bool {
  let groups = filter(srv1_gpu_iommu_readings, g => host_identity_eq(a: g.host, b: operator_host_srv1))
  groups.length() == 2 && groups.all(g => match g.group_type {
    Translated => srv1_reading_is_read(w: g.warrant)
    Passthrough => false
    Identity => false
    IommuDomainModeNotRead { read_obligation: _ } => false
  })
}
