module gunbc.fleet.gpu_interconnect_observation

// WHAT ONE HOST'S GPU PAIR CAN DO TO ITSELF OVER ITS PCIe PATH: the reading that says whether two GPUs in
// one box can talk to each other directly, how the platform routes them, and what the collective library
// ends up using. It is the observing layer's half of what gunbc.plans.fleet_hardware_fact_consumption's
// "topology and benchmark applicability" row waits on: a TP=2 result measured on another host's interconnect
// cannot qualify this host's, so this host's own P2P, NCCL and serving readings have to exist before TP=2 is
// admitted anywhere that consumes them.
//
// WHAT THIS MODULE IS NOT. Not the boards (gunbc.fleet.fleet_physical_inventory), not the devices nvidia-smi
// enumerates (gunbc.fleet.gpu_device_observation), not the throughput comparison itself
// (gunbc.serving.srv1_topology_comparison, #16104), not the collective library's vendor semantics
// (extdeps.nvidia.nccl). It carries one kind of fact: what a named instrument said, on a named subject, on a
// dated read.
//
// THE CAUSAL SENTENCE IS NOT A READING. "GPU-to-GPU peer access is absent" is something an instrument
// answered; "therefore TP=2 loses to 2xTP=1 by the whole margin, and the fork's TP=2-wins rows reverse here"
// is an explanation sitting on top of that reading plus a benchmark carried by
// gunbc.serving.srv1_topology_comparison (it arrived on #16104 and has been on main since 2026-11-09).
// It is carried as HypothesisStanding, never as a fact, and the bet that a PCIe switch card would fix it is
// carried as a bet with the observation that would settle it named. DESIGN.md, "Epistemic humility": a
// reading whose shape is known but whose answer is not in hand is refused, never filled from memory -- which
// is why the sweep below was re-run here rather than completed from the numbers that came to this session
// truncated, and why the one thing those numbers got wrong -- the two NCCL arms are NOT equivalent -- is
// carried as a hypothesis with an obligation instead of smoothed over. `Unread` stays an arm of
// `Srv1ReadingWarrant` for a reading not yet taken; every row of this module is read today, and the re-run the
// loaded machine forces is carried as `srv1_collective_read_obligation`.

import std.nat { Nat }
import std.types { Bool, List, NonEmptyStr }
import std.algebra { string_concat_join }
import std.optional { Absent, Present }
import std.measure { Bandwidth, ByteSize, Microsecond, bandwidth, byte_size, microsecond }
import product.host_identity { HostIdentity, host_identity_eq }
import product.placement_supply { PhysicalAssetIdentity, physical_asset_identity_eq }
import extdeps.pci.identity { PciAddress }
import extdeps.storage.types { PcieGeneration, PcieLink, Gen1, Gen2, Gen3, Gen4, Gen5 }
import gunbc.fleet.fleet_host_identity { operator_host_srv1 }
import gunbc.fleet.fleet_asset_identity { gpu_board_01, gpu_board_04 }

// HOW A ROW IS WARRANTED, in the three ways a hardware reading can be warranted here. READ BY THIS SESSION
// is the strongest and names the instrument that was run. RELAYED is a reading first-hand to someone who is
// not this session, with the ask dated and the answer quoted; it is not a synonym for believed, and a row
// stays relayed until someone runs the instrument. UNREAD is the honest arm for a value whose shape is known
// and whose answer is not in hand: it carries the obligation as data, so a gap is visible to a consumer
// instead of being filled with a plausible figure.
type Srv1ReadingWarrant
  = ReadByThisSession { read_on: NonEmptyStr, instrument: NonEmptyStr }
  | Relayed { asked_of: NonEmptyStr, answered_on: NonEmptyStr, said: NonEmptyStr, read_obligation: NonEmptyStr }
  | Unread { read_obligation: NonEmptyStr }

fn srv1_reading_is_read(w: Srv1ReadingWarrant) -> Bool {
  match w {
    ReadByThisSession { read_on: _, instrument: _ } => true
    Relayed { asked_of: _, answered_on: _, said: _, read_obligation: _ } => false
    Unread { read_obligation: _ } => false
  }
}

fn srv1_reading_obligation(w: Srv1ReadingWarrant) -> NonEmptyStr? {
  match w {
    ReadByThisSession { read_on: _, instrument: _ } => Absent
    Relayed { asked_of: _, answered_on: _, said: _, read_obligation: o } => Present { value: o }
    Unread { read_obligation: o } => Present { value: o }
  }
}

// PEER ACCESS, PER DIRECTION. nvidia-smi's matrix answers with a token per ordered pair; its legend in the
// same output spells the tokens ("OK peer-to-peer transaction is possible with this link type", "NS not
// supported by the link type", "CNS not supported by the chipset"), so the token is carried verbatim and the
// verdict arm is what the token MEANS. A peer-access API answer is a different instrument and gets its own
// row: the chipset saying "no" and the driver saying "no" are two reports, not one restated.
//
// And the second half of that sentence is the reason there is an UNATTRIBUTED arm. cudaDeviceCanAccessPeer
// answers can-yes-or-can-no and nothing else: it has no reason field, no token, no cause. Recording its "no"
// under PeerToPeerRefusedByChipset would be the CNS reading's cause leaking into a row the CNS reading did not
// produce, and would leave the module with two "confirmations" of a cause only one instrument named. The CUDA
// rows therefore carry the refusal without a cause; the cause stays where it was read.
type PeerAccessVerdict
  = PeerToPeerPossible { token: NonEmptyStr }
  | PeerToPeerRefusedByChipset { token: NonEmptyStr }
  | PeerToPeerRefusedByLinkType { token: NonEmptyStr }
  | PeerToPeerRefusedUnattributed { token: NonEmptyStr }
  | PeerToPeerVerdictNotAnswered { token: NonEmptyStr }

type GpuPeerAccessReading {
  host: HostIdentity
  from_board: PhysicalAssetIdentity
  to_board: PhysicalAssetIdentity
  instrument: NonEmptyStr
  verdict: PeerAccessVerdict
  warrant: Srv1ReadingWarrant
}

fn peer_access_is_absent(r: GpuPeerAccessReading) -> Bool {
  match r.verdict {
    PeerToPeerRefusedByChipset { token: _ } => true
    PeerToPeerRefusedByLinkType { token: _ } => true
    // A "no" that brings no reason is still a "no": absence is about the answer, attribution is about the
    // cause, and collapsing the first because the second is missing would lose the reading.
    PeerToPeerRefusedUnattributed { token: _ } => true
    PeerToPeerPossible { token: _ } => false
    PeerToPeerVerdictNotAnswered { token: _ } => false
  }
}

// THE PLATFORM ROUTING, as the topology instrument names it. The code is what the tool printed; `meaning` is
// the tool's OWN legend text for that code, not this repository's gloss. `separate_host_bridges` is the
// reading that the two functions sit under different root ports in different PCI domains -- the fact that
// makes the missing peer access a platform-routing question rather than a driver setting.
type GpuPairTopologyReading {
  host: HostIdentity
  left_board: PhysicalAssetIdentity
  right_board: PhysicalAssetIdentity
  link_code: NonEmptyStr
  meaning: NonEmptyStr
  left_root_port: PciAddress
  right_root_port: PciAddress
  separate_host_bridges: Bool
  cpu_affinity: NonEmptyStr
  numa_affinity: NonEmptyStr
  warrant: Srv1ReadingWarrant
}

// THE LINK, AT BOTH ENDS. `endpoint_advertises` is the device's own LnkCap and `negotiated` is LnkSta; where
// they differ, the narrower one is the ceiling in force. Carrying only LnkSta would hide that the card is
// capable of more than the slot delivers, which is the fact that makes the switch-card bet legible.
type GpuPcieLinkReading {
  host: HostIdentity
  board: PhysicalAssetIdentity
  pci_address: PciAddress
  upstream_root_port: PciAddress
  endpoint_advertises: PcieLink
  negotiated: PcieLink
  warrant: Srv1ReadingWarrant
}

fn gpu_pcie_link_is_narrower_than_the_endpoint(k: GpuPcieLinkReading) -> Bool {
  pcie_generation_rank(g: k.negotiated.generation) < pcie_generation_rank(g: k.endpoint_advertises.generation)
    || k.negotiated.lane_count < k.endpoint_advertises.lane_count
}

fn pcie_generation_rank(g: PcieGeneration) -> Nat {
  match g {
    Gen1 => 1
    Gen2 => 2
    Gen3 => 3
    Gen4 => 4
    Gen5 => 5
  }
}

// THE IOMMU AND THE ACCESS-CONTROL REDIRECTION, both of which sit in the path a peer access would take. The
// SMMU's default domain type answers whether DMA addresses are translated; ACS redirection controls whether a
// request between two functions is sent upstream to be checked instead of passed through. Both are read from
// the host, both are states of the platform, and NEITHER is a conclusion about peer access.
type IommuDomainMode
  = Translated
  | Passthrough
  | Identity
  | IommuDomainModeNotRead { read_obligation: NonEmptyStr }

type GpuIommuReading {
  host: HostIdentity
  board: PhysicalAssetIdentity
  pci_address: PciAddress
  iommu_group: Nat
  group_type: IommuDomainMode
  group_members: List<PciAddress>
  iommu_driver: NonEmptyStr
  smmu_instances: Nat
  kernel_command_line_terms: List<NonEmptyStr>
  warrant: Srv1ReadingWarrant
}

type AcsRedirectionReading {
  host: HostIdentity
  root_port: PciAddress
  source_validation: Bool
  req_redir: Bool
  cmplt_redir: Bool
  upstream_forwarding: Bool
  egress_control: Bool
  direct_translation: Bool
  warrant: Srv1ReadingWarrant
}

// THE COLLECTIVE LIBRARY: what transport it said it used, and what an all-reduce cost. The instrument is the
// operator's own script on srv1 (path, sha256 and sizes carried), so the row names the thing to re-run
// instead of quoting a number that no one can reproduce. `env_arm` names the environment the arm ran under,
// verbatim ("default" for no override).
type CollectiveTransportReading {
  host: HostIdentity
  instrument_path: NonEmptyStr
  instrument_sha256: NonEmptyStr
  sizes: List<ByteSize>
  env_arm: NonEmptyStr

  // The three measured cells are optional rather than zero-filled: an Unread row says Absent for each, so a
  // consumer cannot mistake a placeholder 0 W / 0 us / empty transport for a measurement of nothing.
  transport: NonEmptyStr?
  message_bytes: ByteSize?
  elapsed: Microsecond?
  bus_bandwidth: Bandwidth?
  warrant: Srv1ReadingWarrant
}

// AN EXPLANATION, TYPED AS AN EXPLANATION. Both arms name the observation that would settle them, and the
// consumer-facing join below refuses to treat either as fact.
type HypothesisStanding
  = Hypothesis { claim: NonEmptyStr, would_be_settled_by: NonEmptyStr }
  | Bet { claim: NonEmptyStr, would_be_settled_by: NonEmptyStr }

type InterconnectExplanation {
  host: HostIdentity
  subject: NonEmptyStr
  standing: HypothesisStanding
}

