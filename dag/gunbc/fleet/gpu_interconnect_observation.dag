    bus_bandwidth: bandwidth(12110000000),
    warrant: ReadByThisSession {
      read_on: "2026-11-09T22:40:35Z..22:40:51Z (both lil replicas stopped)" as NonEmptyStr,
      instrument: nccl_unloaded_arm_instrument(arm: "p2pdisabled" as NonEmptyStr, port: "29602" as NonEmptyStr, printed: "p2pdisabled allreduce 4096 KiB: 346.5 us busbw= 12.11 GB/s" as NonEmptyStr),
    },
  },

  CollectiveTransportReading {
    host: operator_host_srv1,
    instrument_path: "/home/briansrls/lil/nccl_test.py" as NonEmptyStr,
    instrument_sha256: "702a2bce83cb6c76ca51699457822fb06e840c37ba377bb0b5247a8b2653b1cc" as NonEmptyStr,
    sizes: [byte_size(16 * 1024), byte_size(256 * 1024), byte_size(4 * 1024 * 1024), byte_size(64 * 1024 * 1024)],
    env_arm: srv1_nccl_arm_p2p_disabled,
    transport: "SHM/direct" as NonEmptyStr,
    message_bytes: byte_size(64 * 1024 * 1024),
    elapsed: microsecond(count: 5404),
    bus_bandwidth: bandwidth(12420000000),
    warrant: ReadByThisSession {
      read_on: "2026-11-09T22:40:35Z..22:40:51Z (both lil replicas stopped)" as NonEmptyStr,
      instrument: nccl_unloaded_arm_instrument(arm: "p2pdisabled" as NonEmptyStr, port: "29602" as NonEmptyStr, printed: "p2pdisabled allreduce 65536 KiB: 5404.0 us busbw= 12.42 GB/s" as NonEmptyStr),
    },
