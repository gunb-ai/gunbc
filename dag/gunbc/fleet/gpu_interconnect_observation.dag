// ONE TASK PER ROW. Each control this reading lane owes -- or owed -- is a row: what it is, what it would
// settle, how it is run, what it costs, and whether it is still open. Tracked as one prose string instead, a
// control could be finished while the string still read as wholly open, a witness could only grep the sentence,
// and nothing recorded how expensive each answer is. The discharged control stays in the list with open: false
// rather than being deleted or described in a sentence elsewhere: the list is then the whole history of the
// lane, and the count of open work is a fold over it, never a number written twice.
type Srv1CollectiveReadFollowUp {
  control: NonEmptyStr,
  what_it_settles: NonEmptyStr,
  how_to_run: NonEmptyStr,
  cost: NonEmptyStr,
  open: Bool,
}

data srv1_collective_read_follow_ups_2026_11_09: List<Srv1CollectiveReadFollowUp> = [
  Srv1CollectiveReadFollowUp {
    control: "the same instrument read across BOTH serving topologies on this host: a TP=2 group and a 2xTP=1 pair" as NonEmptyStr,
    what_it_settles: "the claim that the missing P2P path explains the serving gap between TP=2 and 2xTP=1 -- no reading in this module crosses the two topologies, so the claim stays a Hypothesis" as NonEmptyStr,
    how_to_run: "nccl_test.py against a TP=2 process group, then the same bytes against the two standalone replicas' interconnect, same host, same image" as NonEmptyStr,
