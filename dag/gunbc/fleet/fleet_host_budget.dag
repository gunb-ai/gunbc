type HeadroomPolicy
  = HeadroomSet { bytes: ByteSize }
  | HeadroomUnset

data gunbc_fleet_headroom_policy: HeadroomPolicy = HeadroomUnset


type HeadroomResolution
  = HeadroomResolved { bytes: ByteSize }
  | HeadroomUnsound { reason: String }

fn resolve_headroom(policy: HeadroomPolicy, floor: ByteSize) -> HeadroomResolution {
  match policy {
    HeadroomUnset => HeadroomUnsound { reason: "headroom policy unset" }
    HeadroomSet { bytes: b } =>
      if byte_size_count(b: b) >= byte_size_count(b: floor) {
        HeadroomResolved { bytes: b }
      } else {
        HeadroomUnsound { reason: "below oomd actuation floor" }
      }
  }
}

// OOMD GROUNDING IS A PER-HOST QUESTION AND WAS ASKED FLEET-WIDE. The thresholds it checks the
// installed configuration against are a per-session ceiling and a PARENT SLICE CAP, and the slice
// cap is exactly the host aggregate that gunbc.session_reservation_policy now answers per host --
// srv1 at 52 GiB, srv2 unestablished. One fleet-wide row could only have been right by accident.
//
// WHAT THIS DOES NOT CLAIM: gunbc_oomd_show_effective_read is ReadAbsent, so no live systemctl
// show-effective or oomctl read has ever run against these hosts and gunbc_oomd_fleet_evidence
// returns OomdUnverified for ANY thresholds. Threading the host through does not make the answer
// per-host in any observable way today; it makes the INPUT honest so that the first live read is
// grounded against the reservation that host actually owes, rather than against a literal every
// host shared. The evidence stays OomdUnverified either way, which is the fail-closed direction.
fn gunbc_fleet_oomd_evidence_for(host: HostIdentity) -> OomdEnforcementEvidence {
  match session_admission_oomd_ceiling(p: gunbc_session_admission_policy) {
    Absent => OomdUnverified
    Present { value: ceiling } =>
      gunbc_oomd_fleet_evidence(req: OomdGroundingThresholds {
        per_session_cap: ceiling,
        parent_slice_cap: session_reservation_bytes(host: host),
        pressure_limit: gunbc_oomd_sessions_pressure_limit,
        pressure_action: gunbc_oomd_sessions_policy.managed_oom_memory_pressure,
      })
  }
}

// THE COMPILE POOL IS A CLAIM ON HOST RAM THAT THE PER-SLOT MODEL DID NOT SEE.
// extdeps.cache.sccache.sccache_server_process_facts cites that cache-miss compiles execute as
// CHILDREN OF THE SCCACHE SERVER. So compile RSS is charged to the SERVER's cgroup, not to the
// runner slot that issued the compile, and a per-slot memory cap therefore does NOT bound compile
// memory. Measured consequence on srv1, 2026-08-01: the CI server was lazily auto-spawned inside
// slot srv1-10's cgroup -- that slot's unit was inactive and disabled at the time -- and kept alive
// by SCCACHE_IDLE_TIMEOUT=0, so the five slots srv1 then served ran their compiles under one
// disabled slot's 15G high / 16G max caps and accumulated 229780 memory.max breach events and 12
// oom_kills. THAT SENTENCE IS DATED BECAUSE NEITHER HALF OF IT DESCRIBES THE HOST NOW: measured
// 2026-08-25T18:43Z, srv1 serves 21 contiguous slots srv1-01..21 with srv1-10 ACTIVE and ENABLED
// among them, and no sccache process runs on the host at all -- the CI socket is present with zero
// listeners behind it. The MECHANISM this paragraph exists for is untouched by that, which is why
// the sentence is corrected rather than dropped: cache-miss compiles are children of whichever
// server holds the endpoint, so that server's cgroup bounds them wherever it lands. A separate pool
// has no sizing authority since the jobserver was retired (compile_pool_bytes_for below).


type CompilePoolResolution
  = CompilePoolDerived { bytes: ByteSize }
  | CompilePoolUnresolved { reason: String }

// THE SEPARATE COMPILE POOL HAS NO SIZING AUTHORITY, AND THAT IS THE ANSWER (operator ruling
// 2026-10-14 (b), A2). It was sized as jobserver tokens x mib_per_job from extdeps.jobserver, which
// is deleted with the ctrl-jobserver realization. Under CompilePoolInRunnerSlots compiler children
// run inside each slot's own memory and CPU ceilings and the host charge is zero; a placement that
// declares a separate pool slice refuses here rather than charging a pool nothing sizes.
fn compile_pool_bytes_for(placement: CompilePoolPlacement) -> CompilePoolResolution {
  match placement {
    CompilePoolInRunnerSlots => CompilePoolDerived { bytes: byte_size(0) }
    CompilePoolSliceDeclared { slice_unit: u } =>
      CompilePoolUnresolved { reason: concat("a separate compile-pool slice is declared and nothing sizes it since the jobserver token derivation was retired: ", u) }
  }
}

// THE HOST RESERVE IS A POLICY PICK, NOT A MEASUREMENT. Overseer policy, 2026-10-14, reported to
// the operator and revisable: eight threads stay outside every runner slot and the sessions slice,
// for the host's own daemons. It is the one host-reserve figure both gunbc.ci.ci_runner_placement
// host_cpu_allocation and this module's effective runner CPU cap read.
data host_cpu_reserve_threads: HardwareThreadCount = hardware_thread_count(count: 8)

fn appropriation_of(b: ByteSize) -> Appropriation<Memory, One> {
  Appropriation { ceiling: b }
}

fn overhead_claim(overhead: ByteSize) -> BudgetClaim {
  BudgetClaim {
    item: LineItem { purpose: "host_fixed_overhead", amount: overhead },
    priority: Guaranteed,
  }
}

fn child_node(name: String, b: ByteSize) -> BudgetNode {
  BudgetNode {
    name: name,
    appropriation: appropriation_of(b: b),
    claims: [],
    children: [],
  }
}

data gunbc_per_runner_memory_cap: ByteSize = gunbc_runner_slot_desired().memory_max

// gunbc_session_container_memory (byte_size(1073741824)), session_pool_bytes and
// max_concurrent_sessions are DELETED. No capacity value moved; an unconsumed carrier with no
// decidable policy meaning was removed.
//
// WHY IT GOES, stated without claiming it nicknamed anything. It had no provenance — a bare literal
// with no note and no citation, in a module where every other figure carries its derivation. It had
// no production consumer: the census at deletion found only
// test.claim.host.host_allocation_conservation. And its two helpers merely multiplied and divided by it,
// so the only witness over them divided by the same constant it had just multiplied by and held for
// every value of that constant, including the wrong one it was reading.
//
// WHAT IS DELIBERATELY NOT CLAIMED, because an earlier revision of this note claimed it and was
// wrong. This row is NOT established as a second name for the host aggregate reservation. A
// per-session amount and a per-host aggregate slice are different axes, as are the per-session OOMD
// eviction ceiling and the ctrl-visible per-container cap; asserting that this literal nicknamed
// host_session_slice_bytes would repeat the per-container-versus-aggregate fusion this program
// exists to remove. The literal is deleted because it is groundless and unconsumed, and the
// question of which legitimate session-capacity axis eventually replaces it is left open here.
//
// NOR IS ANY LIVE VERDICT ATTRIBUTED TO IT. Nothing consumed it, so it cannot have produced a wrong
// production answer. The claim is counterfactual: had a budget consumed it, a 1 GiB per-session
// charge would have undercharged against the per-session peaks cited at this seam (min 0.28 /
// median ~2.06 / max 8.27 GiB) — below the median. The live sessions aggregate is and remains the
// Regime-2 row in gunbc.ci.ci_floor_measurement, untouched by this change.

// fabric_control_plane_pool IS A NAMED CHILD RATHER THAN AN ADDITION TO fixed_overhead, because the
// resident it charges has an exact identity, an exact placement, an explicit lifecycle, a measurable
// envelope and a later migration path. Folding it into overhead erases all five and makes a future
// MOVE indistinguishable from a drift in miscellaneous OS usage -- and it would double-charge the
// moment overhead is next measured on a host where the service is running.
// served_deployment_pool IS A NAMED CHILD FOR THE REASON fabric_control_plane_pool IS ONE, and it
// closes a hole rather than adding a term. The roadmap deployment's slice is the declared MemoryMax
// at gunbc.live_deploy.slice_bounds live_deploy_slice_memory_max, which systemd lets four units
// hold on srv1, and it appeared in NONE of the terms below:
// the verdict answered "this host conserves" for a machine on which that allowance had already been
// written by gunbc.live_deploy. The approval-broker split adds a second served slice, so the moment
// to charge them is the moment there are two (gunbc.live_deploy.served_slice_charge).
fn host_allocation_tree(
  host: ByteSize,
  overhead: ByteSize,
  headroom: ByteSize,
  runner_pool: ByteSize,
  session_pool: ByteSize,
  compile_pool: ByteSize,
  control_plane: ByteSize,
  served_deployment: ByteSize
) -> BudgetNode {
  BudgetNode {
    name: "host_allocation",
    appropriation: appropriation_of(b: host),
    claims: [overhead_claim(overhead: overhead)],
    children: [
      child_node(name: "runner_pool", b: runner_pool),
      child_node(name: "session_pool", b: session_pool),
      child_node(name: "compile_pool", b: compile_pool),
      child_node(name: "fabric_control_plane_pool", b: control_plane),
      child_node(name: "served_deployment_pool", b: served_deployment),
      child_node(name: "headroom", b: headroom),
    ],
  }
}

type HostAllocationVerdict
  = HostAllocationConserves
  | HostAllocationOversubscribed
  | HostAllocationUnchargeable { cause: String }

// THE VERDICT IS A COPRODUCT BECAUSE A Bool CANNOT SAY WHY IT IS false. "The declared claims exceed
// the host" and "one resident's size is unknown so no sum can be formed" are different states with
// different remedies -- the first is a capacity decision, the second is a measurement someone has to
// go and take -- and a shared false merges them into a plan that looks oversubscribed when it is
// merely unmeasured. A Bool projection over this verdict used to sit beside it
// and is DELETED rather than kept: gunbc.ci.ci_runner_placement, its only production caller, now
// matches the verdict directly, and a spare yes/no left in this module is how the collapse would
// come back -- the next caller wanting a Bool would find one already written and would silently
// drop the remedy again. The witnesses that legitimately ask a yes/no question declare their own
// projection in test.claim.host.host_allocation_conservation, where a production import of it would be
// visibly wrong.
fn host_allocation_verdict(
  host: ByteSize,
  overhead: ByteSize,
  headroom: ByteSize,
  runner_pool: ByteSize,
  session_pool: ByteSize,
  compile_pool: ByteSize,
  control_plane: HostFabricControlPlaneClaim,
  served_deployment: HostServedDeploymentClaim
) -> HostAllocationVerdict {
  match control_plane {
    ControlPlaneClaimUnmeasured { cause: c } => HostAllocationUnchargeable { cause: c }
    ControlPlaneNotPlaced =>
      host_allocation_verdict_served(
        host: host, overhead: overhead, headroom: headroom, runner_pool: runner_pool,
        session_pool: session_pool, compile_pool: compile_pool, control_plane: byte_size(0),
        served_deployment: served_deployment
      )
    ControlPlaneClaimResolved { memory: m } =>
      host_allocation_verdict_served(
        host: host, overhead: overhead, headroom: headroom, runner_pool: runner_pool,
        session_pool: session_pool, compile_pool: compile_pool, control_plane: m,
        served_deployment: served_deployment
      )
  }
}

// EACH UNMEASURED CLAIM REFUSES IN ITS OWN NAME. Folding the two claims into one match would make
// "unchargeable" unable to say WHICH resident's size is unknown, and the remedy is a different
// measurement in each case -- which is the whole reason HostAllocationUnchargeable carries a cause
// rather than being a false.
fn host_allocation_verdict_served(
  host: ByteSize,
  overhead: ByteSize,
  headroom: ByteSize,
  runner_pool: ByteSize,
  session_pool: ByteSize,
  compile_pool: ByteSize,
  control_plane: ByteSize,
  served_deployment: HostServedDeploymentClaim
) -> HostAllocationVerdict {
  match served_deployment {
    ServedDeploymentClaimUnmeasured { cause: c } => HostAllocationUnchargeable { cause: c }
    ServedDeploymentNotPlaced =>
      host_allocation_verdict_charged(
        host: host, overhead: overhead, headroom: headroom, runner_pool: runner_pool,
        session_pool: session_pool, compile_pool: compile_pool, control_plane: control_plane,
        served_deployment: byte_size(0)
      )
    ServedDeploymentClaimResolved { memory: m } =>
      host_allocation_verdict_charged(
        host: host, overhead: overhead, headroom: headroom, runner_pool: runner_pool,
        session_pool: session_pool, compile_pool: compile_pool, control_plane: control_plane,
        served_deployment: m
      )
  }
}

fn host_allocation_verdict_charged(
  host: ByteSize,
  overhead: ByteSize,
  headroom: ByteSize,
  runner_pool: ByteSize,
  session_pool: ByteSize,
  compile_pool: ByteSize,
  control_plane: ByteSize,
  served_deployment: ByteSize
) -> HostAllocationVerdict {
  if node_conserves(node: host_allocation_tree(
    host: host,
    overhead: overhead,
    headroom: headroom,
    runner_pool: runner_pool,
    session_pool: session_pool,
    compile_pool: compile_pool,
    control_plane: control_plane,
    served_deployment: served_deployment
  )) {
    HostAllocationConserves
  } else {
    HostAllocationOversubscribed
  }
}

// THE CLAIM IS A PARAMETER RATHER THAN A DEFAULT, AND THE FIRST VERSION OF THIS GOT IT WRONG. It
// passed ControlPlaneNotPlaced here, which is TRUE TODAY and would have stayed silently true after
// someone placed the control plane -- this function takes host BYTES, not a host identity, so it
// cannot derive the claim and would have gone on answering about a fleet that no longer existed.
// That is the unfirable wall in its purest form, three declarations below the annotation warning
// about it. Making it a parameter means every caller must say which host's claim it is charging,
// and the ones that cannot say so stop compiling -- which is the census, not an inconvenience.

// This still divides the declared pool by the declared per-slot cap rather than reading
// gunbc.runner.runner_slot_allocation gunbc_runner_committed_width directly, and the redundancy is now
// GONE rather than merely tolerated. The pool is derived as slots × MemoryMax
// (gunbc_runner_slice_cap_for_width), so floor(pool ÷ MemoryMax) returns that same slot count by
// construction — the two agree because one is the other's inverse, not because an author kept them
// coherent. The old note admitted the difference: it said 80 ÷ 16 = 5 was 'coherent with
// slots_per_host by construction at these values', which is a coincidence with a caveat attached,
// and the caveat was doing the work.

fn runner_slice_cap(host: ByteSize, overhead: ByteSize, session_slice: ByteSize, headroom: ByteSize, compile_pool: ByteSize) -> ByteSize {
  let after_overhead = byte_size_saturating_sub(total: host, reserved: overhead)
  let after_session = byte_size_saturating_sub(total: after_overhead, reserved: session_slice)
  let after_headroom = byte_size_saturating_sub(total: after_session, reserved: headroom)
  byte_size_saturating_sub(total: after_headroom, reserved: compile_pool)
}

fn runner_slice_node(runner_slice: ByteSize, runner_baseline: ByteSize) -> BudgetNode {
  BudgetNode {
    name: "runner_slice",
    appropriation: appropriation_of(b: runner_slice),
    claims: [],
    children: [child_node(name: "runner_idle_baseline", b: runner_baseline)],
  }
}

fn fleet_host_budget_tree(
  name: String,
  host: ByteSize,
  overhead: ByteSize,
  runner_baseline: ByteSize,
  session_slice: ByteSize,
  headroom: ByteSize,
  runner_slice: ByteSize,
  compile_pool: ByteSize
) -> BudgetNode {
  BudgetNode {
    name: name,
    appropriation: appropriation_of(b: host),
    claims: [overhead_claim(overhead: overhead)],
    children: [
      child_node(name: "session_worstcase_reservation", b: session_slice),
      child_node(name: "headroom", b: headroom),
      child_node(name: "compile_pool", b: compile_pool),
      runner_slice_node(runner_slice: runner_slice, runner_baseline: runner_baseline),
    ],
  }
}

fn runner_slice_cap_drifted(disk_cap: ByteSize, effective: RunnerSliceCapEffectiveness) -> Bool {
  match effective {
    CapUnbounded => true
    CapEffective { bytes: b } => !(byte_size_count(b: disk_cap) == byte_size_count(b: b))
  }
}

type FleetHostPlan
  = FleetHostPlanDerived {
      name: String,
      tree: BudgetNode,
      runner_slice_cap: ByteSize,
      effective_runner_cpu_cap: HardwareThreadCount,
    }
  | FleetHostPlanUnsound { reason: String }

fn fleet_host_plan_for(
  name: String,
  host: ByteSize,
  overhead: ByteSize,
  nproc: HardwareThreadCount,
  runner: FleetContainerType,
  session_slice: ByteSize,
  policy: HeadroomPolicy,
  oomd: OomdEnforcementEvidence
) -> FleetHostPlan {
  match oomd {
    OomdUnverified =>
      FleetHostPlanUnsound { reason: "oomd enforcement unverified: systemd-oomd is the eviction backstop (srv2-reboot fix + the conservation keystone); refuse to derive a host plan without it (fail closed)" }
    OomdEnforced =>
          match container_baseline_bytes(c: runner) {
            BaselineUnmeasured { reason: r } => FleetHostPlanUnsound { reason: r }
            BaselineResolved { bytes: rb } => {
              let floor = oomd_actuation_floor(host: host)
              match resolve_headroom(policy: policy, floor: floor) {
                HeadroomUnsound { reason: r } => FleetHostPlanUnsound { reason: r }
                HeadroomResolved { bytes: hr } =>
                  match compile_pool_bytes_for(placement: gunbc_compile_pool_placement) {
                    CompilePoolUnresolved { reason: cr } => FleetHostPlanUnsound { reason: cr }
                    CompilePoolDerived { bytes: compile_pool } => {
                      let slice = runner_slice_cap(host: host, overhead: overhead, session_slice: session_slice, headroom: hr, compile_pool: compile_pool)
                      let tree = fleet_host_budget_tree(name: name, host: host, overhead: overhead, runner_baseline: rb, session_slice: session_slice, headroom: hr, runner_slice: slice, compile_pool: compile_pool)
                      FleetHostPlanDerived {
                        name: name,
                        tree: tree,
                        runner_slice_cap: slice,
                        effective_runner_cpu_cap: cpu_cores_available(nproc: nproc, margin: host_cpu_reserve_threads),
                      }
                    }
                  }
              }
            }
          }
  }
}

fn fleet_host_plan() -> FleetHostPlan {
  fleet_host_plan_for(
    name: "fleet_host",
    host: byte_size(134217728000),
    overhead: byte_size(17179869184),
    nproc: hardware_thread_count(count: 128),
    runner: gha_runner_container,
    session_slice: byte_size(0),
    policy: gunbc_fleet_headroom_policy,
    oomd: OomdUnverified
  )
}

fn fleet_host_plan_for_offer(
  offer: ComputeOffer,
  overhead: ByteSize,
  session_slice: ByteSize,
  policy: HeadroomPolicy,
  oomd: OomdEnforcementEvidence
) -> FleetHostPlan {
  match compute_host_primary_cpu(host: offer.supply.physical) {
    Absent =>
      FleetHostPlanUnsound { reason: "compute offer has no primary CPU facts: refuse to derive a host plan without a measured core count (the CPU-core runner cap needs nproc; fail closed)" }
    Present { value: cpu } =>
      fleet_host_plan_for(
        name: offer.supply.physical.identity,
        host: host_usable_ram_ceiling_bytes(host: offer.supply.physical.identity),
        overhead: overhead,
        nproc: cpu_facts_threads(cpu: cpu),
        runner: gha_runner_container,
        session_slice: session_slice,
        policy: policy,
        oomd: oomd
      )
  }
}
