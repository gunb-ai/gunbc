import product.supplier.hetzner { hetzner_nuremberg_route, hetzner_helsinki_route }
import product.fabric.provider_route { ProviderRoute }
import extdeps.cloud.gcp.gcp { ServiceAccountEmail }
import gunbc.fleet.fleet_host_backing {
  HostBacking,
  OwnedMachine,
  ProviderGuest,
  ProviderResourceAcquired,
  ProviderResourceBinding,
  backing_microvm_forbidding_offer,
  provisioning_over_bmc_via_virtual_media,
  provisioning_over_bmc_via_ram_image,
}
import gunbc.fleet.fleet_machine_unit_binding { machine_unit_standing }
import gunbc.fleet.hetzner_cloud_guest { hetzner_cloud_guest_entitlement }
import gunbc.fleet.hetzner_cloud_acquisition { hetzner_cax41_nbg1_1_acquisition, hetzner_cax41_hel1_1_acquisition }
import gunbc.fleet.fleet_host_identity {
  operator_host_srv1,
  operator_host_srv2,
  operator_host_srv3,
  operator_host_srv4,
  operator_host_srv14,
  operator_host_mtcollins1,
  operator_host_183527,
  operator_host_3dde7f,
}

// THE FLEET'S ENROLLMENT ROOT. Which hosts are in the fleet, what each is for and what supplies it
// are declared ONCE, here, and every fleet population is derived from this roster -- the standup
// phase matrix (gunbc.host.host_phase_status), the runner population, capacity control and session
// residency's denominator. Before this module the same membership was re-listed as literal srv1-srv4
// lists in several consumers, and adding a machine meant finding every list; now it is one row.
// This module is deliberately light: a consumer that only needs WHO is enrolled imports it without
// pulling in standup programs, provider APIs, physical inventory or convergence.

// Participation is what a host DOES for the fleet, and it is a LIST because the axes are
// independent rather than exclusive: nothing in the model forbids a host that both runs CI and
// serves inference, and a coproduct would have forced a third fused variant the first time that
// happened. It is deliberately NOT a host KIND enum (AltraRunner | SparkAppliance) -- kind is
// hardware, participation is role, and binding obligations to hardware would mean a future Altra
// dedicated to serving inherits BMC obligations because of what it is made of rather than what it
// is for. srv5 and srv6 stay opaque host identities for the same reason: the identity survives a
// role change or a hardware replacement, and DGX Spark remains a product fact recorded elsewhere,
// never part of the host's permanent name.

type FleetParticipation
  = CiRunnerParticipation
  | InferenceServingParticipation
  | InteractiveSessionParticipation

fn fleet_participation_label(p: FleetParticipation) -> String {
  match p {
    CiRunnerParticipation => "ci-runner"
    InferenceServingParticipation => "inference-serving"
    InteractiveSessionParticipation => "interactive-session"
  }
}

fn fleet_participation_eq(a: FleetParticipation, b: FleetParticipation) -> Bool {
  fleet_participation_label(p: a) == fleet_participation_label(p: b)
}

// THE ENROLLMENT POLICY COLUMNS (R4, gunbc.plans.fleet_machine_authority). Three things the fleet
// DECIDES about a host were written as arms comparing the host against a named machine in the code
// that consumes them, so a second machine needed a code edit: which reload mode its converge runs use,
// whether the fleet may reach it for recovery work at all, and the names its run-scoped branch
// federation is minted under. Each is now a column, stated on the host's own row, and the consumer
// reads the row. A host the roster does not carry is not given a plausible default -- the consumer
// answers it with a typed refusal naming the roster (gunbc.design_argument::root_generalization).

// How a host's converge is applied: a fresh standup builds the tree from nothing, a quiescent host
// reloads the tree it already has. Re-homed here from gunbc.host.host_converge, whose knob now reads
// this column instead of naming srv3.
type ConvergeApplyMode
  = FreshStandup
  | ExistingHostQuiescentReload

fn converge_apply_mode_label(m: ConvergeApplyMode) -> String {
  match m {
    FreshStandup => "fresh_standup"
    ExistingHostQuiescentReload => "existing_host_quiescent"
  }
}

// What the enrollment PERMITS about reaching this host for recovery work. This is the POLICY a row
// states -- it does NOT name the host: the row's own `host` column already does, and restating it here
// would let a row say "this is srv4" while refusing "srv3". The identity-bearing verdict --
// gunbc.runner.runner_broker_progress_watchdog's `HostReachAdmission`, which gunbc.runner.runner_connectivity_recovery
// reports -- is BUILT from the host actually asked about, so the machine a refusal names is the machine
// that was queried (gunbc.design_argument::single_authority, gunbc.design_argument::fail_closed).
type HostReachPolicy
  = HostKeyLoginAdmitted
  | HostKeyLoginRefused { reason: NonEmptyStr }

// WHY srv3 AND srv4 ARE NOT REACHABLE for recovery work: host-key login is unavailable on those two
// machines, so a recovery route that reached them over SSH would fail closed at the transport anyway
// and be charged as a connectivity failure. Stated once, carried on their rows.
data host_key_login_unavailable_reason: NonEmptyStr = "host key login unavailable; located reach refusal while siblings continue"

// The federation a branch run of this host signs in under: which dispatch mode carries it, which
// service account it is, and the names it is provisioned with. A host whose branch runs do not get
// their own short-lived federation SAYS SO on its row, rather than being defaulted into one.
// gunbc.auth.branch_dispatch_federation mints these through its one generic `fleet_run_scoped_federation`
// from these names, so giving a second host a run-scoped route is a row edit.
type HostRunScopedFederation
  = NoRunScopedFederation
  | RunScopedFederationNames {
      mode: NonEmptyStr
      label: String
      service_account_id: NonEmptyStr
      service_account: ServiceAccountEmail
      display_name: String
    }

// THE MT. COLLINS BOOT'S RUN-SCOPED ACCOUNT, declared on its own row: same WIF pool as the other
// branch-run federations (gunbc.auth.branch_dispatch_federation supplies the pool, provider, attribute
// mapping and impersonation for every one of them), its own account, and grants taken from the
// admitted boot federation's one secret_grants list. A second pin on this account is unwritable
// because there is no second list; rotation of either version is one edit on ManagedHostBootFederation,
// one converge, both SAs. It is a column now, so the next host given a run-scoped route is a row edit
// and not a new copy of the mint.
data mtcollins1_boot_run_scoped_federation_names: HostRunScopedFederation = RunScopedFederationNames {
  mode: "mtcollins1_boot" as NonEmptyStr,
  label: "mtcollins1 boot (approved branch runs)",
  service_account_id: "mtcollins1-boot-run" as NonEmptyStr,
  service_account: "mtcollins1-boot-run@gunbai-secrets.iam.gserviceaccount.com",
  display_name: "Mt. Collins boot (run-scoped, WIF-only, no keys)",
}

// An enrollment joins three separate facts about one stable identity: what the host is FOR
// (participation), and what SUPPLIES it (backing, gunbc.fleet.fleet_host_backing), and what the fleet
// PERMITS it (apply_mode, reach_policy and run_scoped_federation above). Its allocated names live
// in gunbc.hostname_allocation and are not repeated here. A known identity can exist without a
// participation, a participation can exist before its readiness is established, and only the
// applicable admission downstream produces runnable capacity.
type HostEnrollmentIntent {
  host: HostIdentity
  participation: List<FleetParticipation>
  backing: HostBacking
  apply_mode: ConvergeApplyMode
  reach_policy: HostReachPolicy
  run_scoped_federation: HostRunScopedFederation
}

fn participation_list_contains(ps: List<FleetParticipation>, wanted: FleetParticipation) -> Bool {
  filter(ps, p => fleet_participation_eq(a: p, b: wanted)).length() > 0
}

// The CI-runner program is the identity anchor for the refactor: it must select the WHOLE spine,
// because every phase authored to date exists to serve runner hosts. If a later phase is added that
// no participation claims, or one that CI does not claim, this equality breaks and the witness reds
// -- which is the intended alarm, not a maintenance burden. It is the discriminating control that
// distinguishes 'the refactor preserved srv1-srv4 exactly' from 'the refactor produced a
// plausible-looking matrix'.

data ci_runner_enrollment_participation: List<FleetParticipation> = [CiRunnerParticipation]

data inference_serving_enrollment_participation: List<FleetParticipation> = [InferenceServingParticipation]

// Interactive agent sessions are their own participation, not an attribute of CI: which hosts run
// session containers is the fact that charges a host a sessions reservation (gunbc.session_residency)
// and scopes CLI-provider capacity control (gunbc.fleet.fleet_capacity_control). It coincided with the CI
// hosts on srv1-srv4, and the coincidence was carried as copies of the same four-host list; a rented
// CI guest runs no sessions, so the two are separate rows the first time they differ.
data ci_runner_and_session_enrollment_participation: List<FleetParticipation> = [
  CiRunnerParticipation,
  InteractiveSessionParticipation,
]

data both_participation_enrollment_participation: List<FleetParticipation> = [
  InferenceServingParticipation,
  CiRunnerParticipation,
]

// THE TWO HETZNER CLOUD CAX41 GUESTS (ordered by the operator 2026-10-07 and recreated 2026-10-08: one in Nuremberg, one in Helsinki). Their
// participation is the CI runner role the operator intends for them; whether that role can RUN is
// not decided here -- the entitlement says nested virtualization is unavailable on Hetzner Cloud, so
// the Firecracker execution path downstream refuses on it with that cause. Each is bound to its
// provider resource id (gunbc.fleet.hetzner_cloud_acquisition), never to a console display name, because a
// display name is not the resource an operation may target.
fn cax41_guest(route: ProviderRoute, resource: ProviderResourceBinding) -> HostBacking {
  ProviderGuest {
    route: route,
    entitlement: hetzner_cloud_guest_entitlement(
      row: cax41_catalog,
      offer: decl_ref(module_path: "extdeps.cloud.hetzner", decl_name: "cax41_catalog"),
    ),
    resource: resource,
  }
}

// The enrolled fleet. gunbc.host.host_phase_status reads it rather than re-listing it, so the standup
// matrix can never disagree with the roster about WHICH hosts exist. This is also
// the enrollment prerequisite the srv4 OOM incident priced (fleet_subsumption_manual_gaps section
// C): a host takes no fleet work until it is an intent row, so a host absent from this list has no
// cells at all, and one that appears gains a full column of UnknownRefused cells — the work
// becoming visible the moment the host is enrolled, which is the behaviour the incident wanted.

data fleet_enrollments: List<HostEnrollmentIntent> = [
  HostEnrollmentIntent { host: operator_host_srv1, participation: ci_runner_and_session_enrollment_participation, backing: OwnedMachine { provisioning: provisioning_over_bmc_via_virtual_media(), unit: machine_unit_standing(machine: operator_host_srv1) },
    apply_mode: ExistingHostQuiescentReload, reach_policy: HostKeyLoginAdmitted, run_scoped_federation: NoRunScopedFederation },
  HostEnrollmentIntent { host: operator_host_srv2, participation: ci_runner_and_session_enrollment_participation, backing: OwnedMachine { provisioning: provisioning_over_bmc_via_virtual_media(), unit: machine_unit_standing(machine: operator_host_srv2) },
    apply_mode: ExistingHostQuiescentReload, reach_policy: HostKeyLoginAdmitted, run_scoped_federation: NoRunScopedFederation },
  HostEnrollmentIntent { host: operator_host_srv3, participation: ci_runner_and_session_enrollment_participation, backing: OwnedMachine { provisioning: provisioning_over_bmc_via_virtual_media(), unit: machine_unit_standing(machine: operator_host_srv3) },
    apply_mode: FreshStandup, reach_policy: HostKeyLoginRefused { reason: host_key_login_unavailable_reason }, run_scoped_federation: NoRunScopedFederation },
  HostEnrollmentIntent { host: operator_host_srv4, participation: ci_runner_and_session_enrollment_participation, backing: OwnedMachine { provisioning: provisioning_over_bmc_via_virtual_media(), unit: machine_unit_standing(machine: operator_host_srv4) },
    apply_mode: ExistingHostQuiescentReload, reach_policy: HostKeyLoginRefused { reason: host_key_login_unavailable_reason }, run_scoped_federation: NoRunScopedFederation },
  // srv14/butch: CI-ONLY (operator 2026-11-10 -- CiRunnerParticipation, NO interactive sessions), so it
  // carries ci_runner_enrollment_participation, NOT the session-bearing participation srv1-4 carry. Added
  // as a CI runner it does NOT change the sessions population the host_phase_status witness pins at 4
  // runners; it joins the CI-runner population only. Its backing is the BMC route's virtual-media constructor: installed 2026-10-30 from ubuntu-24.04.3-live-server-arm64 over the BMC's
  // USB virtual-media gadget (installer block device "Linux File-Stor_Gadget", ds=nocloud;s=/cdrom/nocloud/)
  // -- NOT PXE, so no new delivery variant is needed (the parent's site_pxe_edge_converge lane is unrelated
  // to how butch was delivered). Its unit is read from the one physical-binding admission like every owned row; its board
  // facts bind via gunbc.fleet.machine_board (srv14_baseboard -> fleet_intent_board).
  HostEnrollmentIntent { host: operator_host_srv14, participation: ci_runner_enrollment_participation, backing: OwnedMachine { provisioning: provisioning_over_bmc_via_virtual_media(), unit: machine_unit_standing(machine: operator_host_srv14) },
    apply_mode: ExistingHostQuiescentReload, reach_policy: HostKeyLoginAdmitted, run_scoped_federation: NoRunScopedFederation },
  // mtcollins1 boots a RAM image over its BMC: controlled (Bmc), never installed (RamImageBoot). Every
  // owned row's unit is read from the one physical-binding admission (gunbc.fleet.fleet_machine_unit_binding,
  // A2 of gunbc.plans.fleet_machine_authority): Absent until that machine's board serial is observed.
  HostEnrollmentIntent {
    host: operator_host_mtcollins1,
    participation: ci_runner_enrollment_participation,
    backing: OwnedMachine { provisioning: provisioning_over_bmc_via_ram_image(), unit: machine_unit_standing(machine: operator_host_mtcollins1) },
    apply_mode: ExistingHostQuiescentReload, reach_policy: HostKeyLoginAdmitted, run_scoped_federation: mtcollins1_boot_run_scoped_federation_names,
  },
  HostEnrollmentIntent {
    host: operator_host_183527,
    participation: ci_runner_enrollment_participation,
    backing: cax41_guest(
      route: hetzner_nuremberg_route(),
      resource: ProviderResourceAcquired { acquisition: hetzner_cax41_nbg1_1_acquisition },
    ),
    apply_mode: ExistingHostQuiescentReload, reach_policy: HostKeyLoginAdmitted, run_scoped_federation: NoRunScopedFederation,
  },
  HostEnrollmentIntent {
    host: operator_host_3dde7f,
    participation: ci_runner_enrollment_participation,
    backing: cax41_guest(
      route: hetzner_helsinki_route(),
      resource: ProviderResourceAcquired { acquisition: hetzner_cax41_hel1_1_acquisition },
    ),
    apply_mode: ExistingHostQuiescentReload, reach_policy: HostKeyLoginAdmitted, run_scoped_federation: NoRunScopedFederation,
  },
]

// THE ENROLLMENT GATE, AND WHY IT IS GONE. There used to be one: admit_enrollment ran
// admit_owned_provisioning over each intent's owned {control, delivery} pair, refused the pair naming a
// state that cannot occur, and `fleet_enrollments` was what survived that filter while
// `fleet_enrollment_refusals` carried what did not. The pair is now sealed at its type -- an intent can
// only be WRITTEN through a route constructor of gunbc.fleet.fleet_host_backing, and no constructor names
// a medium its route cannot run -- so a filter over it could never refuse anything: a check for a state
// the model cannot spell is a stall, not a guarantee, and it is dissolved on the climb
// (gunbc.design_argument::guarantee_ladder, gunbc.rung_drop::
// owned_provisioning_impossible_pair_admitted_at_enrolment). The roster below IS the enrollment; every
// population downstream reads it unchanged, and it can no longer hold the pair the gate used to catch.

// The hosts enrolled for one participation, in roster order. Every per-role population a consumer
// needs is this one filter, so a consumer can never hold a host list that disagrees with the roster.
fn hosts_enrolled_among(intents: List<HostEnrollmentIntent>, wanted: FleetParticipation) -> List<HostIdentity> {
  map(
    filter(intents, e => participation_list_contains(ps: e.participation, wanted: wanted)),
    e => e.host,
  )
}

fn hosts_enrolled_for(wanted: FleetParticipation) -> List<HostIdentity> {
  hosts_enrolled_among(intents: fleet_enrollments, wanted: wanted)
}

// THE RUNNER-EXECUTOR POPULATION: hosts enrolled for CI whose backing does not forbid the microVM
// execution path. It is narrower than the CI enrollment on purpose -- a CAX guest is enrolled for CI
// and refused execution by its provider, so it is a member of hosts_enrolled_for(CiRunnerParticipation)
// (its refusal is visible there) and NOT of this set, which is what a pinned runner, a workflow host
// choice or a slot census walks. A provider whose offer permits nesting joins it with no edit here.
fn runner_executor_hosts() -> List<HostIdentity> {
  map(
    filter(fleet_enrollments, e =>
      participation_list_contains(ps: e.participation, wanted: CiRunnerParticipation)
        && match backing_microvm_forbidding_offer(backing: e.backing) {
          Present { value: _ } => false
          Absent => true
        }
    ),
    e => e.host,
  )
}

fn enrollment_for_host(host: HostIdentity) -> HostEnrollmentIntent? {
  filter(fleet_enrollments, e => (e.host as String) == (host as String)).first()
}

// THE POLICY COLUMNS, as projections of the roster. Each answers `Absent` for a host the roster does
// not carry, which is the consumer's cue to give a typed refusal -- never a plausible default. A host
// outside srv1-srv4 that IS enrolled gets its row's real answer, which is the point of the columns:
// srv14/butch and the CAX guests were each invisible to the code these projections replace, and every
// one of them was answered by an `else` branch that had never been asked about them.

fn apply_mode_for_host(host: HostIdentity) -> ConvergeApplyMode? {
  match enrollment_for_host(host: host) {
    Present { value: e } => Present { value: e.apply_mode }
    Absent => Absent
  }
}

fn reach_policy_for_host(host: HostIdentity) -> HostReachPolicy? {
  match enrollment_for_host(host: host) {
    Present { value: e } => Present { value: e.reach_policy }
    Absent => Absent
  }
}

fn host_run_scoped_federation(host: HostIdentity) -> HostRunScopedFederation? {
  match enrollment_for_host(host: host) {
    Present { value: e } => Present { value: e.run_scoped_federation }
    Absent => Absent
  }
}

// THE HOSTS THAT HAVE A RUN-SCOPED FEDERATION AT ALL, as their rows state it. gunbc.auth.branch_dispatch_federation
// folds this to mint each one's federation and to stand up its dispatch mode, so a host that has none
// is not silently minted one and a host that gains one needs no new code.
fn hosts_with_run_scoped_federation() -> List<HostEnrollmentIntent> {
  filter(fleet_enrollments, e =>
    match e.run_scoped_federation {
      NoRunScopedFederation => false
      RunScopedFederationNames { mode: _, label: _, service_account_id: _, service_account: _, display_name: _ } =>
        true
    }
  )
}

