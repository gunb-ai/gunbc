module gunbc.fleet.fleet_converge_executor_subject_split
import std.types { String, List, Bool }
import std.algebra { string_contains }
import v2.std.node { Node }
import v2.std.diagnostic { Outcome, Accepted, Rejected }
import v2.workflow.bash_emit { bash_emit_stmts }
import v2.extdeps.languages.bash_build { bash_build_word_lit, bash_build_word_var, bash_build_command_with_words, bash_build_test_bracket, bash_build_or_else, bash_build_and_then, bash_build_with_redir, bash_build_exit, bash_build_if_from_stmts, BracketQuoted }
import gunbc.actions_run_binding { actions_variable_read, ActionsVariablePresent, ActionsVariableAbsent, fleet_converge_subject_host_env_name, fleet_converge_expected_host_env_name, fleet_converge_mode_env_name }
import gunbc.ci.ci_deploy_target_host { runner_name_proves_host_identity }
import product.host_identity { HostIdentity }

// THE EXECUTOR/SUBJECT SPLIT (operator ruling 2026-10-24, after refused run 40085967610).
//
// The host-file modes (converge, withdraw, restore) pin their job to a fleet host -- the EXECUTOR --
// and act on a DIFFERENT host, the SUBJECT, over the FleetSsh edge. The reason is the drain: the cap
// bracket drains every slot of its subject, and when the executor slot lives on the subject, that
// drain waits for the job's own executor slot to finish, which never happens -- srv3's converge died
// waiting on actions-runner@srv3-13, the slot running the converge itself. So the split is not a
// convention: a mode whose executor equals its subject is REFUSED, as a typed refusal, before any
// drain or mask actuation.
//
// Three walls, each independently checked:
//   1. the WORKFLOW PRECONDITION STEP (fleet_converge_executor_subject_split_gate_step) is the first
//      mode step and runs on every dispatch of an act mode; its script refuses (exit 1) when either
//      name is empty or the two are equal -- no drain, no mask leg can have run when it fires;
//   2. the PRODUCTION ENTRIES re-check the runner identity (the SAME proving relation the deploy gate
//      uses, runner_name_proves_host_identity from gunbc.ci.ci_deploy_target_host) before any subject
//      resolution or edge call, so a hand-run of the entry refuses with the same typed value;
//   3. READBACK STAYS AN EDGE READ: every observation of the subject's state goes through the FleetSsh
//      transport, so a subject that lies about itself cannot certify its own withdrawal.

// The executor's own identity, as GitHub reports it to the runner process. Absent means the entry is
// not running on a registered self-hosted runner at all, which is its own refusal -- an unregistered
// process cannot prove it is NOT the subject.
data fleet_converge_executor_runner_name_env_name: String = "RUNNER_NAME"

data fleet_converge_split_refusal_marker: String = "REFUSED: fleet-converge self-subject"

data fleet_converge_split_missing_subject_marker: String = "REFUSED: fleet-converge subject absent"

data fleet_converge_split_missing_executor_marker: String = "REFUSED: fleet-converge executor identity absent"

type SplitPrecheck = SplitOk { executor_runner_name: String, subject_host: String } | SplitRefused { reason: SplitRefusalReason }

type SplitRefusalReason = SelfSubject { executor_runner_name: String, subject_host: String } | SubjectAbsent | ExecutorIdentityAbsent

// THE PREDICATE, as one function both walls call. The executor side uses the SAME proving relation
// the deploy gate uses (a slot named actions-runner@srv3-13 proves it lives on srv3), so "executor
// equals subject" covers the exact-host case and the slot-name case. Anything the prover can prove
// about the executor's belonging is acted on; an identity that names nothing is refused outright,
// because fail-open there is exactly the srv3 deadlock.
fn fleet_converge_split_precheck(executor_runner_name: String?, subject_host: String?) -> SplitPrecheck {
  match subject_host {
    Absent => SplitRefused { reason: SubjectAbsent }
    Present { value: subject } =>
      if subject == "" {
        SplitRefused { reason: SubjectAbsent }
      } else {
        match executor_runner_name {
          Absent => SplitRefused { reason: ExecutorIdentityAbsent }
          Present { value: name } =>
            if name == "" || runner_name_proves_host_identity(runner_name: name, host: subject as HostIdentity) {
              SplitRefused { reason: SelfSubject { executor_runner_name: name, subject_host: subject } }
            } else {
              SplitOk { executor_runner_name: name, subject_host: subject }
            }
        }
      }
  }
}

// Read the two halves from the process environment. The subject arrives as its OWN name -- it is not
// the expected host, and conflating the two is exactly the confusion that deadlocked the bracket.
fn fleet_converge_split_read() -> SplitPrecheck {
  let subject = match actions_variable_read(name: fleet_converge_subject_host_env_name) {
    ActionsVariablePresent { value: v } => Present { value: v }
    ActionsVariableAbsent => none
  }
  let executor = match actions_variable_read(name: fleet_converge_executor_runner_name_env_name) {
    ActionsVariablePresent { value: v } => Present { value: v }
    ActionsVariableAbsent => none
  }
  fleet_converge_split_precheck(executor_runner_name: executor, subject_host: subject)
}

fn fleet_converge_split_refusal_line(reason: SplitRefusalReason) -> String {
  match reason {
    SelfSubject { executor_runner_name: name, subject_host: subject } =>
      join([fleet_converge_split_refusal_marker, ": the executor runner (", name, ") is a slot on the subject ", subject, ": the bracket drains every slot of its subject and would wait for this job's own executor forever (refused run 40085967610, actions-runner@srv3-13). Dispatch with host (executor) != subject_host."], "")
    SubjectAbsent =>
      join([fleet_converge_split_missing_subject_marker, ": FLEET_CONVERGE_SUBJECT_HOST is unset; a host-file mode acts on a named subject, never on an inferred one."], "")
    ExecutorIdentityAbsent =>
      join([fleet_converge_split_missing_executor_marker, ": RUNNER_NAME is unset; an unregistered process cannot prove it is not the subject, and fail-open here is the srv3 deadlock."], "")
  }
}

// THE RULE, PER MODE (operator ruling 2026-11-20). The two split refusals were written for the DRAIN
// trio, where acting on the machine the job stands on drains the bracket that holds the job itself.
// A mode that only INSTALLS files on a host has no such deadlock: remote_build_serving_observe /
// converge write an account, a checkout, a toolchain and a serve binary, and srv1 converging its OWN
// serving is the shape run 44656574939 already used (executor srv3, served host srv3). Refusing that
// pair by the drain rule would make it impossible to converge a host that has no other lane.
// So ONE gate and ONE precheck carry a rule, and the mode picks it:
//   SubjectRequiredAndDistinct            -- the drain trio: a named subject, never the executor.
//   SubjectMayBeTheExecutorsOwnMachine    -- the serving pair: a named subject, or the machine the
//                                            job stands on, which is what an unnamed subject has
//                                            always meant for these modes.
// An unlisted mode gets the DRAIN rule: the default is the stricter one, so a new mode that forgets
// to declare its rule is refused rather than served by accident (gunbc.design_argument::fail_closed).
type SplitSubjectRule = SubjectRequiredAndDistinct | SubjectMayBeTheExecutorsOwnMachine

// The modes whose rule is the install rule, in their dispatch wire spelling. The witness ties this
// list to the workflow roster (fleet_converge_modes_naming_a_subject), so the gate's `if:`, the
// script's rule test and the entries cannot drift apart.
data fleet_converge_install_rule_mode_wires: List<String> = ["remote_build_serving_observe", "remote_build_serving_converge"]

fn fleet_converge_split_rule_for_mode(mode: String) -> SplitSubjectRule {
  if any(fleet_converge_install_rule_mode_wires, w => w == mode) {
    SubjectMayBeTheExecutorsOwnMachine
  } else {
    SubjectRequiredAndDistinct
  }
}

// WHAT THE SERVING ENTRIES NEED: the subject if the dispatch named one, and otherwise the machine the
// job stands on -- named by the executor's own expected-host identity, never inferred from a slot
// name. Both arms are a NAMED machine; what is refused is a run that names no machine at all, and a
// process that cannot name its own lane. The drain refusal (executor proves subject) cannot occur
// under this rule and so is not returned here.
type InstallSubjectOutcome =
    InstallSubjectOnNamedSubject { executor_runner_name: String, subject_host: String }
  | InstallSubjectOnExecutorsOwnMachine { executor_runner_name: String, host: String }
  | InstallSubjectRefused { reason: SplitRefusalReason }

fn fleet_converge_install_subject_read() -> InstallSubjectOutcome {
  fleet_converge_install_subject_decision(
    executor_runner_name: env_text_or_empty(name: fleet_converge_executor_runner_name_env_name),
    named_subject: env_text_or_empty(name: fleet_converge_subject_host_env_name),
    own_host: env_text_or_empty(name: fleet_converge_expected_host_env_name)
  )
}

fn env_text_or_empty(name: String) -> String {
  match actions_variable_read(name: name) {
    ActionsVariablePresent { value: v } => v
    ActionsVariableAbsent => ""
  }
}

// THE DECISION, pure, so the rule is a fact a witness can drive: an executor name, a subject the
// dispatch named ("" when it named none), and the executor's own machine from the expected-host input.
fn fleet_converge_install_subject_decision(executor_runner_name: String, named_subject: String, own_host: String) -> InstallSubjectOutcome {
  let executor = executor_runner_name
  let named = named_subject
  let own = own_host
  if executor == "" {
    InstallSubjectRefused { reason: ExecutorIdentityAbsent }
  } else if named != "" {
    InstallSubjectOnNamedSubject { executor_runner_name: executor, subject_host: named }
  } else if own != "" {
    InstallSubjectOnExecutorsOwnMachine { executor_runner_name: executor, host: own }
  } else {
    InstallSubjectRefused { reason: SubjectAbsent }
  }
}

// THE REFUSAL LINE for the install rule. Same markers as the drain rule -- one vocabulary for "this
// dispatch did not name the machine it means" -- but the sentence is the one true for a mode that may
// serve the machine it stands on: it names BOTH env names, because under this rule either of them
// satisfies the subject and neither was given.
fn fleet_converge_install_refusal_line(reason: SplitRefusalReason) -> String {
  match reason {
    SubjectAbsent =>
      join([fleet_converge_split_missing_subject_marker, ": neither ", fleet_converge_subject_host_env_name, " nor ", fleet_converge_expected_host_env_name, " names a machine; a serving mode converges the host the dispatch names, and never one it has to guess."], "")
    ExecutorIdentityAbsent =>
      join([fleet_converge_split_missing_executor_marker, ": RUNNER_NAME is unset; a host mutation performed by a process no registered lane owns has no executor to attribute it to."], "")
    SelfSubject { executor_runner_name: name, subject_host: subject } =>
      join([fleet_converge_split_refusal_marker, ": ", name, " on ", subject, " is not a refusal under the install rule; this line is unreachable for a serving mode."], "")
  }
}

// THE WORKFLOW PRECONDITION STEP's script, TYPED. It is built from bash_build statement nodes and
// rendered by v2.workflow.bash_emit -- never assembled as a string. (A join([...]) of hand-written
// shell here shipped three syntax errors past the controls: a missing space before `]`, a stray `]`,
// and an echo whose quote never closed, so bash died on a parse error before the refusal marker ever
// printed -- review 38602 and review 386096 both caught it. String-built shell has no type to get
// wrong; a syntax error is neither success nor a typed diagnostic, so gunbc.design_argument::fail_closed forbids it; the
// fold admits only statements its grammar parses, and the generation gate refuses emission when the
// fold refuses (fleet_converge_split_gate_script_admitted).)
//
// It reads ONLY its two bound env names and decides both refusals; it contains no entry invocation,
// so a refusing run performed zero actuation. The step's `if:` is only the act-mode disjunction, so
// every act dispatch executes it and the decision is never made by an expression that can skip it
// (review 86194). The control asserts its ORDERING before every actuation step, its refusal text, the
// absence of any entry invoke in it, and the evaluated `if:` across the input cases.
// THE DRAIN TEST, as a bash condition built from the SAME list the entries read
// (fleet_converge_install_rule_mode_wires): "the dispatched mode is not one of the install-rule
// modes". Spelled as chained `!=` bracket tests because the fold has no negation-of-a-group node, and
// a chained test is exactly the rule the entry applies. Folding over the list means a fourth
// install-rule mode cannot be added to the entries without appearing here too.
fn fleet_converge_gate_mode_is_drain_test(mode_env_name: String) -> Node {
  fold(
    fleet_converge_install_rule_mode_wires,
    init: bash_build_test_bracket(words: [bash_build_word_lit(text: "1"), bash_build_word_lit(text: "="), bash_build_word_lit(text: "1")], spelling: BracketQuoted),
    f: fn(acc, wire) {
      bash_build_and_then(
        left: acc,
        right: bash_build_test_bracket(words: [bash_build_word_var(name: mode_env_name), bash_build_word_lit(text: "!="), bash_build_word_lit(text: wire)], spelling: BracketQuoted)
      )
    }
  )
}

fn fleet_converge_split_gate_statements(executor_env_name: String, subject_env_name: String, mode_env_name: String) -> List<Node> {
  [
    // (0) A DRAIN-mode dispatch with either name empty: an unnamed process cannot prove it is not the
    // subject, and an unnamed subject is actuation on an inferred host. Fail closed, both arms in ONE
    // test. Tested FIRST, as fleet_converge_split_precheck does, so two empty names report absence,
    // not self-subject. The mode test in front is the rule, read from the mode the dispatch named --
    // for a serving mode an unnamed subject is legal (it means the machine the job stands on), and the
    // executor half is checked in (0b) for every mode.
    bash_build_if_from_stmts(
      cond: bash_build_and_then(
        left: fleet_converge_gate_mode_is_drain_test(mode_env_name: mode_env_name),
        right: bash_build_or_else(
          left: bash_build_test_bracket(words: [bash_build_word_lit(text: "-z"), bash_build_word_var(name: subject_env_name)], spelling: BracketQuoted),
          right: bash_build_test_bracket(words: [bash_build_word_lit(text: "-z"), bash_build_word_var(name: executor_env_name)], spelling: BracketQuoted)
        )
      ),
      then_stmts: [
        bash_build_with_redir(
          inner: bash_build_command_with_words(words: [
            bash_build_word_lit(text: "echo"),
            bash_build_word_lit(text: join([fleet_converge_split_missing_subject_marker, ": a mode that drains its subject must name both"], "")),
          ]),
          redir: ^bash_production_fold_redir_stdout_to_stderr,
        ),
        bash_build_exit(code: "1"),
      ]
    ),
    // (0b) NO mode runs without an executor: the job must know which lane it is standing on, both to
    // decide the drain rule and to attribute the act. Checked on its own so the serving pair -- whose
    // subject may be unnamed -- still refuses a run with no identity at all.
    bash_build_if_from_stmts(
      cond: bash_build_test_bracket(words: [bash_build_word_lit(text: "-z"), bash_build_word_var(name: executor_env_name)], spelling: BracketQuoted),
      then_stmts: [
        bash_build_with_redir(
          inner: bash_build_command_with_words(words: [
            bash_build_word_lit(text: "echo"),
            bash_build_word_lit(text: join([fleet_converge_split_missing_executor_marker, ": the dispatch named no executor lane"], "")),
          ]),
          redir: ^bash_production_fold_redir_stdout_to_stderr,
        ),
        bash_build_exit(code: "1"),
      ]
    ),
    // (1) Equal names, for a mode under the DRAIN rule: the executor is a slot on its own subject, so
    // the drain would wait for this very job's executor forever (refused run 40085967610,
    // actions-runner@srv3-13). For a mode under the INSTALL rule the same pair is ADMITTED -- a file
    // install drains nothing -- which is what the mode test in front of this condition says.
    bash_build_if_from_stmts(
      cond: bash_build_and_then(
        left: fleet_converge_gate_mode_is_drain_test(mode_env_name: mode_env_name),
        right: bash_build_test_bracket(words: [
          bash_build_word_var(name: executor_env_name),
          bash_build_word_lit(text: "="),
          bash_build_word_var(name: subject_env_name),
        ], spelling: BracketQuoted)
      ),
      then_stmts: [
        bash_build_with_redir(
          inner: bash_build_command_with_words(words: [
            bash_build_word_lit(text: "echo"),
            bash_build_word_lit(text: fleet_converge_split_refusal_marker),
          ]),
          redir: ^bash_production_fold_redir_stdout_to_stderr,
        ),
        bash_build_exit(code: "1"),
      ]
    ),
    // The holding line: reached only when both names are present and distinct.
    bash_build_command_with_words(words: [
      bash_build_word_lit(text: "echo"),
      bash_build_word_lit(text: "split precondition holds for the dispatched mode's rule"),
    ]),
  ]
}

fn fleet_converge_split_gate_script(executor_env_name: String, subject_env_name: String, mode_env_name: String) -> Outcome<String> {
  bash_emit_stmts(statements: fleet_converge_split_gate_statements(executor_env_name: executor_env_name, subject_env_name: subject_env_name, mode_env_name: mode_env_name), set_e: true)
}

// THE WORKFLOW PRECONDITION STEP's script text. bash_emit refusing means NO workflow is emitted --
// the generation gate (fleet_converge_split_gate_script_admitted) fails closed rather than shipping
// a step with a broken script.
fn fleet_converge_split_gate_step_run(executor_env_name: String, subject_env_name: String, mode_env_name: String) -> String {
  match fleet_converge_split_gate_script(executor_env_name: executor_env_name, subject_env_name: subject_env_name, mode_env_name: mode_env_name) {
    Accepted { value: script, diagnostics: _ } => script
    Rejected { diagnostics: _ } => ""
  }
}

// GENERATION GATE: the gate step's script must be a program bash_emit accepts. A refusal here stops
// fleet-converge.yml from being emitted at all, instead of shipping the review-found syntax error.
fn fleet_converge_split_gate_script_admitted() -> Bool {
  match fleet_converge_split_gate_script(executor_env_name: "FLEET_CONVERGE_EXPECTED_HOST", subject_env_name: "FLEET_CONVERGE_SUBJECT_HOST", mode_env_name: "FLEET_CONVERGE_MODE") {
    Accepted { value: script, diagnostics: _ } =>
      string_contains(s: script, pattern: fleet_converge_split_refusal_marker)
        && string_contains(s: script, pattern: fleet_converge_split_missing_subject_marker)
        && string_contains(s: script, pattern: "exit 1")
    Rejected { diagnostics: _ } => false
  }
}
