// ─────────────────────────────────────────────────────────────────────────────────────────────
// THE STATUS, DERIVED (2.1: "A status that is added has Registered, Active and Retired arms at least, and
// a retired handle is never reissued"). The concept graph was searched before minting it:
// gunbc.fleet.fleet_lifecycle_observation observes PROCESS envelopes -- a collector run against a host --
// not a machine's standing, and no other home in the graph models one, so the arms are minted here beside
// the transitions that are the only thing that changes them.
//
// THE ORDER IS THE PLAN'S, NOT A PREFERENCE. A retired machine that still has a registry row and an
// enrollment reads Retired, because retirement is what happened to it; the row and the name STAY (2.5:
// retiring "leaves the handle retired forever" and releases the name only by an explicit transition), so
// the status has to be able to outrank a row that is still present.
// ─────────────────────────────────────────────────────────────────────────────────────────────

type MachineLifecycleStatus
  = Registered
  | Active
  | Retired

type MachineLifecycleStanding
  = MachineStanding { machine: HostIdentity, status: MachineLifecycleStatus }
  | UnregisteredMachine { machine: HostIdentity }

// THE LEDGER ROW. `artifacts` is the derived list the retirement carries, so a machine cannot be entered in
// the ledger without its artifacts having been listed -- the acceptance's "its artifacts are listed for
// retirement" is enforced by the mint, not by a convention a caller can skip. One mint: retired_ledger_with.
type MachineRetirement sole_constructor {
  machine: HostIdentity
  artifacts: List<RetirementArtifact>
}

// Empty, because no machine has been retired yet. A row appears here only as the output of the Retire
// transition; nothing in a production path writes it, and no live machine is retired from here.
data machine_retirement_ledger: List<MachineRetirement> = []

fn retired_machines(ledger: List<MachineRetirement>) -> List<HostIdentity> {
  map(ledger, r => r.machine)
}

fn machine_is_retired_in(ledger: List<MachineRetirement>, machine: HostIdentity) -> Bool {
  any(retired_machines(ledger: ledger), m => host_identity_eq(a: m, b: machine))
}

fn machine_is_retired(machine: HostIdentity) -> Bool {
  machine_is_retired_in(ledger: machine_retirement_ledger, machine: machine)
}

fn machine_is_enrolled(machine: HostIdentity) -> Bool {
  any(admitted_enrollments(intents: fleet_enrollment_intents), e => host_identity_eq(a: e.host, b: machine))
}

fn machine_is_registered(machine: HostIdentity) -> Bool {
  any(fleet_machine_registry, a => host_identity_eq(a: a.fleet_slot, b: machine))
}

fn machine_lifecycle_standing_in(ledger: List<MachineRetirement>, machine: HostIdentity) -> MachineLifecycleStanding {
  match machine_is_registered(machine: machine) {
    false => UnregisteredMachine { machine: machine }
    true =>
      match machine_is_retired_in(ledger: ledger, machine: machine) {
        true => MachineStanding { machine: machine, status: Retired }
        false =>
          match machine_is_enrolled(machine: machine) {
            true => MachineStanding { machine: machine, status: Active }
            false => MachineStanding { machine: machine, status: Registered }
          }
      }
  }
}

fn machine_lifecycle_standing(machine: HostIdentity) -> MachineLifecycleStanding {
  machine_lifecycle_standing_in(ledger: machine_retirement_ledger, machine: machine)
}

// THE FLEET'S STANDING READ, OVER THE WHOLE REGISTRY, so a claim like "no registered machine reads Retired
// while nothing has been retired" is made about the population and not about a machine someone remembered.
fn machine_lifecycle_standings() -> List<MachineLifecycleStanding> {
  map(fleet_machine_registry, a => machine_lifecycle_standing(machine: a.fleet_slot))
}

// ─────────────────────────────────────────────────────────────────────────────────────────────
// THE ARTIFACTS A RETIRED MACHINE LEAVES, DERIVED. 2.5: retiring "leaves the handle retired forever,
// releases the name only by an explicit transition, and retires every old live artifact per S4". S4 is the
// host-replacement gap list -- a shadowed secret, a stale known_hosts row, an offline runner registration,
// an OAuth URI left pointing at the old name -- and each arm below is one of those gaps made into a value a
// route can consume, read from the producer that owns the artifact today. A kind the fleet has no
// derivation site for is said as ArtifactKindUndeclared rather than skipped: a retirement list that
// silently omits the kinds nobody has modeled is the misleading-value failure the rung ladder exists to
// catch, and S4's whole point is that what a host carries OUTLIVES the decision to replace it.
// ─────────────────────────────────────────────────────────────────────────────────────────────

type RetirementArtifact
  = AllocatedName { machine: HostIdentity, name: NonEmptyStr }
  | PendingName { machine: HostIdentity, name: NonEmptyStr }
  | KnownHostsRow { machine: HostIdentity, fingerprint: NonEmptyStr }
  | BmcHealthReaderSecret { machine: HostIdentity, secret_id: NonEmptyStr }
  | RunnerRegistration { machine: HostIdentity, label: NonEmptyStr }
  | TailscaleMachineName { machine: HostIdentity, name: NonEmptyStr }
  | ArtifactKindUndeclared { machine: HostIdentity, kind: NonEmptyStr }

// THE KINDS S4 NAMES THAT HAVE NO DERIVATION SITE YET, each carrying the PR that lands the derivation or the
// fact that no PR owns it. They ride in the SAME list as the derived ones rather than in a comment: an
// operator retiring a machine reads one list, and an undeclared kind is as visible in it as a derived one.
// P4 lands the projected-name derivations of 2.3 (the BMC admin secret id, the per-host /etc/gunbc path, the
// tailnet name); the OAuth redirect URI and the offline runner registration name no owner, and saying so
// here IS the gap report -- a hand-maintained row for them would be the thing this plan forbids.
data undeclared_retirement_artifact_kind_names: List<NonEmptyStr> = [
  "bmc-admin-secret-id: literal per host today, derived from the human name by P4",
  "etc-gunbc-machine-path: no derivation site yet, P4 owns the projected paths of 2.3",
  "oauth-redirect-uri: S4 gap, no derivation site and no owning PR",
  "offline-runner-registration: S4 gap, no derivation site and no owning PR",
]

fn undeclared_retirement_artifact_kinds(machine: HostIdentity) -> List<RetirementArtifact> {
  map(undeclared_retirement_artifact_kind_names, k => ArtifactKindUndeclared { machine: machine, kind: k })
}

// ONE MACHINE'S RETIREMENT LIST. The pending name is read from the same field the rename route consumes, so
// what a rename would have promoted is exactly what a retirement leaves unclaimed; the Tailscale name is the
// registry's canonical name, which is the value P8c converges to; the known_hosts row is read by HANDLE, so
// a key enrolled under another spelling cannot hide from a retirement.
fn retirement_artifacts(machine: HostIdentity) -> List<RetirementArtifact> {
  let names = match machine_registry_row(machine: machine) {
    Absent => []
    Present { value: a } =>
      concat(
        [AllocatedName { machine: machine, name: canonical_of(allocation: a) }],
        match a.next_name {
          Absent => []
          Present { value: pending } => [PendingName { machine: machine, name: canonical_name_of(name: pending) }]
        },
      )
  }
  let tailnet = match canonical_hostname_for_fleet_slot(fleet_slot: machine) {
    Absent => []
    Present { value: label } => [TailscaleMachineName { machine: machine, name: label as NonEmptyStr }]
  }
  let known_hosts = map(
    filter(fleet_known_hosts_rows(), k => host_identity_eq(a: k.host, b: machine)),
    k => KnownHostsRow { machine: machine, fingerprint: k.sha256_fingerprint as NonEmptyStr },
  )
  let runner = match any(runner_population_labels(intents: fleet_enrollment_intents), l => l == (machine as NonEmptyStr)) {
    true => [RunnerRegistration { machine: machine, label: machine as NonEmptyStr }]
    false => []
  }
  concat(
    concat(names, concat(tailnet, known_hosts)),
    concat(
      [BmcHealthReaderSecret { machine: machine, secret_id: bmc_health_reader_secret_id(host: machine) }],
      concat(runner, undeclared_retirement_artifact_kinds(machine: machine)),
    ),
  )
}

fn machine_registry_row(machine: HostIdentity) -> HostnameAllocation? {
  filter(fleet_machine_registry, a => host_identity_eq(a: a.fleet_slot, b: machine)).first()
}

fn canonical_of(allocation: HostnameAllocation) -> NonEmptyStr {
  match allocation.name {
    LegacyHostname { label: l } => l as NonEmptyStr
    DrawnHumanName { name: n, draw: _ } => human_name_canonical_hostname(name: n) as NonEmptyStr
  }
}

fn canonical_name_of(name: AllocatedHostName) -> NonEmptyStr {
  match name {
    LegacyHostname { label: l } => l as NonEmptyStr
    DrawnHumanName { name: n, draw: _ } => human_name_canonical_hostname(name: n) as NonEmptyStr
  }
}

fn current_name(machine: HostIdentity) -> NonEmptyStr? {
  match machine_registry_row(machine: machine) {
    Absent => Absent
    Present { value: a } => Present { value: canonical_of(allocation: a) }
  }
}

// ─────────────────────────────────────────────────────────────────────────────────────────────
// THE TRANSITIONS (2.5). A coproduct with one arm per transition, so "what can happen to a machine" is a
// closed set a consumer must handle, and there is no arm for a change that changes nothing about a machine.
// Each arm carries ONLY what a person legitimately holds at that step -- which machine, and the observation
// they made (the replacement board's readings, the participation wanted). The name a rename promotes is NOT
// an input: it is read from the row's own pending field, so a name nobody drew cannot enter the fleet
// through the rename route. Nothing here is a hand step: the authority is the input, the effect is derived.
// ─────────────────────────────────────────────────────────────────────────────────────────────

type MachineTransition
  = Rename { machine: HostIdentity }
  | ReleaseName { machine: HostIdentity }
  | RebindAfterBoardSwap { machine: HostIdentity, replacement: MachineUnitEvidence, held_receipts: List<MachineIntakeSubject> }
  | Reprovision { machine: HostIdentity }
  | ChangeParticipation { machine: HostIdentity, to: List<FleetParticipation> }
  | Retire { machine: HostIdentity }
  | ReplaceRetiredMachine { retired: HostIdentity, replacement: HostIdentity }

fn machine_transition_machines(t: MachineTransition) -> List<HostIdentity> {
  match t {
    Rename { machine: m } => [m]
    ReleaseName { machine: m } => [m]
    RebindAfterBoardSwap { machine: m, replacement: _, held_receipts: _ } => [m]
    Reprovision { machine: m } => [m]
    ChangeParticipation { machine: m, to: _ } => [m]
    Retire { machine: m } => [m]
    ReplaceRetiredMachine { retired: r, replacement: n } => [r, n]
  }
}

// THE O4 POPULATION: one transition per arm, over the machine and the fixtures the caller supplies. A witness
// claims P13's Done condition over this list rather than case-by-case, so a sixth arm added to the coproduct
// without a route reds the population claim instead of going unexamined.
fn o4_transition_population(
  machine: HostIdentity,
  replacement: MachineUnitEvidence,
  held_receipts: List<MachineIntakeSubject>,
  successor: HostIdentity,
) -> List<MachineTransition> {
  [
    Rename { machine: machine },
    ReleaseName { machine: machine },
    RebindAfterBoardSwap { machine: machine, replacement: replacement, held_receipts: held_receipts },
    Reprovision { machine: machine },
    ChangeParticipation { machine: machine, to: [CiRunnerParticipation] },
    Retire { machine: machine },
    ReplaceRetiredMachine { retired: machine, replacement: successor },
  ]
}

// ─────────────────────────────────────────────────────────────────────────────────────────────
// THE ROUTES. A leg names the producer that realizes the step: RealProducer for one live in the corpus
// today -- cited as a DeclarationRef a checker can resolve, the same citation a witness uses to bind a claim
// to the entry that ran -- or PlannedProducer, which carries the module, the declaration and the PR that
// lands it. There is NO arm meaning "someone does this by hand", so P13's Done condition ("each O4 transition
// has a modeled route; none is a hand step") is structural on the type and witnessed over the population: a
// route is modeled when it has legs, and a leg is named when its producer's module, declaration and (for a
// planned one) PR are all non-empty.
// ─────────────────────────────────────────────────────────────────────────────────────────────

type TransitionProducer
  = RealProducer { ref: DeclarationRef, detail: NonEmptyStr }
  | PlannedProducer { module_path: NonEmptyStr, decl: NonEmptyStr, lands_in: NonEmptyStr }

type TransitionLeg {
  what: NonEmptyStr
  producer: TransitionProducer
}

type MachineTransitionRoute
  = ModeledRoute { legs: List<TransitionLeg> }
  | NoModeledRoute { gap: NonEmptyStr }

fn real_producer(module_path: String, decl: String, detail: String) -> TransitionProducer {
  RealProducer { ref: decl_ref(module_path: module_path, decl_name: decl), detail: detail as NonEmptyStr }
}

fn planned_producer(module_path: String, decl: String, lands_in: String) -> TransitionProducer {
  PlannedProducer { module_path: module_path as NonEmptyStr, decl: decl as NonEmptyStr, lands_in: lands_in as NonEmptyStr }
}

fn leg_producer_is_named(leg: TransitionLeg) -> Bool {
  match leg.producer {
    RealProducer { ref: _, detail: d } => (d as String) != ""
    PlannedProducer { module_path: mp, decl: d, lands_in: p } => (mp as String) != "" && (d as String) != "" && (p as String) != ""
  }
}

fn route_is_modeled(r: MachineTransitionRoute) -> Bool {
  match r {
    ModeledRoute { legs: ls } => ls.length() > 0 && all(ls, leg => leg_producer_is_named(leg: leg))
    NoModeledRoute { gap: _ } => false
  }
}

fn route_legs(r: MachineTransitionRoute) -> List<TransitionLeg> {
  match r {
    ModeledRoute { legs: ls } => ls
    NoModeledRoute { gap: _ } => []
  }
}

fn transition_is_modeled(t: MachineTransition) -> Bool {
  route_is_modeled(r: machine_transition_route(t: t))
}

fn every_o4_transition_is_modeled(
  machine: HostIdentity,
  replacement: MachineUnitEvidence,
  held_receipts: List<MachineIntakeSubject>,
  successor: HostIdentity,
) -> Bool {
  all(
    o4_transition_population(machine: machine, replacement: replacement, held_receipts: held_receipts, successor: successor),
    t => transition_is_modeled(t: t),
  )
}

// THE FIVE TRANSITIONS OF 2.5, EACH AS THE ROUTE ITS PRODUCERS ACTUALLY RUN. Legs are cited in the order a
// route would run them, and each names the declaration that would be called -- not a paraphrase of it. A leg
// whose producer has not landed is cited as planned WITH ITS PR, which is a gap report inside the model
// rather than a green claim: the hostname-set converge is P8a (being re-landed), the projected-name sites are
// P4, the network-boot actuation is P12.
fn machine_transition_route(t: MachineTransition) -> MachineTransitionRoute {
  match t {
    Rename { machine: _ } =>
      ModeledRoute {
        legs: [
          TransitionLeg {
            what: "read the row's pending name: a name nobody drew cannot be promoted",
            producer: real_producer(module_path: "gunbc.hostname_allocation", decl: "next_name_for_fleet_slot", detail: "the pending field of the machine's own row, answered from an admitted roster"),
          },
          TransitionLeg {
            what: "seal the renamed row against the registry admission",
            producer: real_producer(module_path: "gunbc.hostname_allocation", decl: "hostname_allocation_admission", detail: "A1: the handle and every spelling of the name stay unique across the rename"),
          },
          TransitionLeg {
            what: "converge the machine's own hostname to the new name, over the transport the fleet uses",
            producer: real_producer(module_path: "gunbc.hostname_set", decl: "hostname_set_fleet_ssh", detail: "the hostname CAS through fleet SSH"),
          },
          TransitionLeg {
            what: "converge the Tailscale machine name inside the window the pending field opens",
            producer: real_producer(module_path: "gunbc.tailscale_machine_name_converge", decl: "tailscale_machine_name_plan_for", detail: "P8c, live; the window gate is this transition's pending field"),
          },
          TransitionLeg {
            what: "re-derive the member spelling and the provider endpoint from the renamed row",
            producer: real_producer(module_path: "gunbc.fleet.fleet_naming", decl: "linux_hostname", detail: "the projected Linux hostname, read from the allocation rather than stored beside it"),
          },
          TransitionLeg {
            what: "re-derive the remaining projected names of 2.3 (secret ids, per-host paths, tailnet name) that are still literal per host",
            producer: planned_producer(module_path: "gunbc.fleet.fleet_naming", decl: "the projected names of 2.3", lands_in: "P4 (one derivation site per projected name)"),
          },
        ],
      }
    ReleaseName { machine: _ } =>
      ModeledRoute {
        legs: [
          TransitionLeg {
            what: "read the name the row holds, so what is released is what was issued",
            producer: real_producer(module_path: "gunbc.hostname_allocation", decl: "fleet_machine_registry", detail: "the machine's own row"),
          },
          TransitionLeg {
            what: "read the pending field, so a release does not leave a drawn name waiting to be promoted",
            producer: real_producer(module_path: "gunbc.hostname_allocation", decl: "next_name_for_fleet_slot", detail: "the row's pending field at the release point"),
          },
          TransitionLeg {
            what: "re-seal the roster, so a released name is not claimed twice while it is still in use elsewhere",
            producer: real_producer(module_path: "gunbc.hostname_allocation", decl: "hostname_allocation_admission", detail: "A1's secondary key covers current and pending spellings"),
          },
        ],
      }
    RebindAfterBoardSwap { machine: _, replacement: _, held_receipts: _ } =>
      ModeledRoute {
        legs: [
          TransitionLeg {
            what: "read the replacement board and mint its key against every other unit the fleet has claimed",
            producer: real_producer(module_path: "gunbc.machine_intake.subject", decl: "bind_unit_key", detail: "the only mint of UnitKey, fed the fleet's other claims"),
          },
          TransitionLeg {
            what: "re-run the fleet fold with the replacement evidence, so the handle keeps one entry and a serial held elsewhere refuses with A2's own cause",
            producer: real_producer(module_path: "gunbc.fleet.fleet_machine_unit_binding", decl: "admit_machine_units", detail: "the A2 fold"),
          },
          TransitionLeg {
            what: "refuse every receipt still sealed against the superseded board",
            producer: real_producer(module_path: "gunbc.host.physical_machine_binding", decl: "physical_machine_admission", detail: "carries the subject/unit disagreement; a receipt that still seals refuses this transition"),
          },
        ],
      }
    Reprovision { machine: m } =>
      ModeledRoute {
        legs: concat(
          [
            TransitionLeg {
              what: "hold the handle and the name: 2.5 says a reprovision changes neither",
              producer: real_producer(module_path: "gunbc.hostname_allocation", decl: "canonical_hostname_for_fleet_slot", detail: "the same row before and after"),
            },
            TransitionLeg {
              what: "read the machine's admitted backing, whose delivery arm decides the rest of the route",
              producer: real_producer(module_path: "gunbc.fleet.fleet_enrollment", decl: "admitted_enrollments", detail: "the A3 fold: an unadmitted row stops the route here"),
            },
          ],
          reprovision_delivery_legs(machine: m),
        ),
      }
    ChangeParticipation { machine: _, to: _ } =>
      ModeledRoute {
        legs: [
          TransitionLeg {
            what: "edit the handle-keyed participation row; 2.5: no code changes",
            producer: real_producer(module_path: "gunbc.fleet.fleet_enrollment", decl: "fleet_enrollment_intents", detail: "the machine's own enrollment row"),
          },
          TransitionLeg {
            what: "re-admit the enrollment population, which is what makes an unadmittable change visible",
            producer: real_producer(module_path: "gunbc.fleet.fleet_enrollment", decl: "admitted_enrollments", detail: "the A3 admission fold"),
          },
          TransitionLeg {
            what: "re-derive the runner population from the changed row through the producer that derives it",
            producer: real_producer(module_path: "gunbc.runner.runner_host_deploy", decl: "runner_host_resolutions_among", detail: "the derived runner population, not a hand-written list"),
          },
          TransitionLeg {
            what: "leave every other derived population reading the unchanged rows",
            producer: real_producer(module_path: "gunbc.fleet.fleet_enrollment", decl: "hosts_enrolled_among", detail: "the other reads over the same rows"),
          },
        ],
      }
    Retire { machine: _ } =>
      ModeledRoute {
        legs: [
          TransitionLeg {
            what: "enter the handle in the retirement ledger, which is what makes it never reissuable",
            producer: real_producer(module_path: "gunbc.fleet.machine_lifecycle", decl: "retired_ledger_with", detail: "the ledger's only mint"),
          },
          TransitionLeg {
            what: "list every live artifact the machine leaves, each derived from the producer that owns it",
            producer: real_producer(module_path: "gunbc.fleet.machine_lifecycle", decl: "retirement_artifacts", detail: "the derived retirement list, undeclared kinds included"),
          },
          TransitionLeg {
            what: "keep the handle's row and name in place: retirement is a status, not a deletion",
            producer: real_producer(module_path: "gunbc.hostname_allocation", decl: "fleet_machine_registry", detail: "the row stays; only the ledger changes"),
          },
        ],
      }
    ReplaceRetiredMachine { retired: _, replacement: _ } =>
      ModeledRoute {
        legs: [
          TransitionLeg {
            what: "confirm the retired handle is retired, so a replacement never reissues it",
            producer: real_producer(module_path: "gunbc.fleet.machine_lifecycle", decl: "machine_is_retired", detail: "the ledger"),
          },
          TransitionLeg {
            what: "issue the successor its own handle, with no fact carried over unless a transition says so",
            producer: real_producer(module_path: "gunbc.hostname_allocation", decl: "hostname_allocation_admission", detail: "A1 refuses a repeated handle or name, so a reissue cannot be spelled"),
          },
          TransitionLeg {
            what: "read the successor's own bindings and enrollment, never the retired machine's",
            producer: real_producer(module_path: "gunbc.fleet.fleet_machine_unit_binding", decl: "machine_unit_standing", detail: "keyed by handle, so the retired machine's entry is unreachable from the new handle"),
          },
        ],
      }
  }
}

// WHICH LEGS A REPROVISION RUNS IS DECIDED BY THE BACKING THE MACHINE ACTUALLY HAS: a RAM-image machine
// re-boots its image, a virtual-media or appliance machine re-runs its provisioning arm, a provider guest
// re-images through its provider. The network-boot arm is cited once, as the leg P12 lands -- the arm does
// not exist in OwnedOsDelivery yet (O2), and naming the PR is how this module says so without pretending the
// route is complete.
fn reprovision_delivery_legs(machine: HostIdentity) -> List<TransitionLeg> {
  let network_boot_leg = TransitionLeg {
    what: "the network-boot delivery arm, which OwnedOsDelivery does not have yet (O2)",
    producer: planned_producer(module_path: "gunbc.provisioning.network_boot_actuation", decl: "network_boot_actuation", lands_in: "P12 (network-boot reprovision, exercised live on srv4)"),
  }
  match admitted_enrollment_for(machine: machine) {
    Absent => [
      TransitionLeg {
        what: "no admitted enrollment: the route stops where the real admission refuses it",
        producer: real_producer(module_path: "gunbc.fleet.fleet_enrollment", decl: "admitted_enrollments", detail: "the A3 fold that refuses an unadmitted row"),
      },
    ]
    Present { value: e } =>
      match e.backing {
        OwnedMachine { provisioning: p, unit: _ } =>
          concat(
            match p.delivery {
              RamImageBoot => [
                TransitionLeg {
                  what: "re-bake and boot the RAM image for the same unit",
                  producer: real_producer(module_path: "gunbc.machine_intake.ram_image_arrival", decl: "ram_image_arrival_plan", detail: "the RAM-image arrival route"),
                },
              ]
              InstalledViaVirtualMedia => [
                TransitionLeg {
                  what: "re-mount the install media and re-run the arm's install",
                  producer: real_producer(module_path: "gunbc.provisioning.provisioning_arm", decl: "derive_virtual_media", detail: "the virtual-media provisioning arm"),
                },
              ]
              ApplianceImage => [
                TransitionLeg {
                  what: "re-run the appliance image arm",
                  producer: real_producer(module_path: "gunbc.provisioning.provisioning_arm", decl: "provisioning_arm_derive", detail: "the appliance delivery arm"),
                },
              ]
            },
            [network_boot_leg],
          )
        ProviderGuest { route: _, entitlement: _, resource: _ } => [
          TransitionLeg {
            what: "re-image through the provider API the guest's backing names",
            producer: planned_producer(module_path: "extdeps.cloud.hetzner", decl: "server_rebuild", lands_in: "unowned: no provider re-image producer is modeled yet"),
          },
        ]
      }
  }
}

// ─────────────────────────────────────────────────────────────────────────────────────────────
// THE ADMISSION: ONE TOTAL FUNCTION, returning the effect and route or the refusal. Guards run in the plan's
// order -- the handle must exist, then it must not be retired, then the transition's own precondition, then
// the real producer's admission -- and every refusal is carried in the producer's own type except the two
// this module legitimately owns: the machine is not in the registry, and the handle is retired.
// ─────────────────────────────────────────────────────────────────────────────────────────────

type MachineTransitionRefusal
  = MachineNotRegistered { machine: HostIdentity }
  | MachineAlreadyRetired { machine: HostIdentity }
  | MachineNotRetired { machine: HostIdentity }
  | RenameWithoutPendingName { machine: HostIdentity }
  | RebindWithoutCurrentBinding { machine: HostIdentity }
  | RebindKeyRefused { machine: HostIdentity, cause: UnitKeyRefusalCause }
  | RebindToSameUnit { machine: HostIdentity, unit: UnitKey }
  | StaleReceiptStillSeals { machine: HostIdentity, receipt_unit: UnitKey }
  | ReprovisionWithoutEnrollment { machine: HostIdentity }
  | ParticipationUnchanged { machine: HostIdentity }
  | ParticipationNotAdmitted { machine: HostIdentity }
  | RetiredHandleReissued { machine: HostIdentity }

type MachineTransitionAdmission
  = TransitionAdmitted { transition: MachineTransition, effect: TransitionEffect, route: MachineTransitionRoute }
  | TransitionRefused { transition: MachineTransition, cause: MachineTransitionRefusal }

type TransitionEffect
  = NameAdvanced { machine: HostIdentity, from: NonEmptyStr, to: NonEmptyStr }
  | NameReleased { machine: HostIdentity, released: NonEmptyStr }
  | UnitRebound { machine: HostIdentity, superseded: UnitKey, replacement: UnitKey, receipts_now_refused: List<NonEmptyStr> }
  | MachineProvisioned { machine: HostIdentity, handle_held: NonEmptyStr, name_held: NonEmptyStr }
  | ParticipationAltered {
      machine: HostIdentity,
      from: List<FleetParticipation>,
      to: List<FleetParticipation>,
      runner_population_before: List<NonEmptyStr>,
      runner_population_after: List<NonEmptyStr>,
      enrolled_population_unchanged: Bool,
    }
  | MachineRetired { machine: HostIdentity, artifacts: List<RetirementArtifact> }
  | MachineReplaced { retired: HostIdentity, replacement: HostIdentity, inherited_facts: List<NonEmptyStr> }

fn admitted_enrollment_for(machine: HostIdentity) -> HostEnrollmentIntent? {
  filter(admitted_enrollments(intents: fleet_enrollment_intents), e => host_identity_eq(a: e.host, b: machine)).first()
}

fn machine_unit_key(machine: HostIdentity) -> UnitKey? {
  match machine_unit_standing(machine: machine) {
    Absent => Absent
    Present { value: u } =>
      match u {
        UnitKeyBound { key: k } => Present { value: k }
        UnitKeyRefused { cause: _ } => Absent
      }
  }
}

// THE FLEET'S EVIDENCE WITH ONE MACHINE'S BOARD REPLACED -- the fold a rebind would actually run. Every other
// machine's readings are unchanged, so a replacement serial that belongs to another machine is refused by the
// fold that owns that claim, not by a check invented beside it.
fn evidence_with_board_replaced(machine: HostIdentity, replacement: MachineUnitEvidence) -> List<MachineUnitEvidence> {
  concat(
    filter(fleet_machine_unit_evidence, e => !host_identity_eq(a: e.machine, b: machine)),
    [replacement],
  )
}

// THE PARTICIPATION CHANGE AS A VALUE: the row with one machine's participation replaced and every other row
// byte-identical, handed to the producers that derive populations from it. Nothing else is touched, which is
// what makes "alters only the runner population derived from it" a checkable claim rather than a hope.
fn intents_with_participation(intents: List<HostEnrollmentIntent>, machine: HostIdentity, to: List<FleetParticipation>) -> List<HostEnrollmentIntent> {
  map(intents, e =>
    match host_identity_eq(a: e.host, b: machine) {
      true => HostEnrollmentIntent { host: e.host, participation: to, backing: e.backing }
      false => HostEnrollmentIntent { host: e.host, participation: e.participation, backing: e.backing }
    }
  )
}

// THE RUNNER POPULATION, DERIVED AND NOT LISTED: the resolution every consumer of the CI population reads,
// walked to the host each resolution is about. A refused or unmodeled host stays a member of the population
// (runner_host_deploy's own ruling: a refused width is a member, not an absence), which is what makes this
// the right thing to compare across a participation change.
fn runner_population_labels(intents: List<HostEnrollmentIntent>) -> List<NonEmptyStr> {
  map(runner_host_resolutions_among(intents: intents), r => runner_resolution_label(r: r))
}

fn runner_resolution_label(r: RunnerHostDeployResolution) -> NonEmptyStr {
  match r {
    RunnerHostDeployFound { deploy: d } => d.host_label
    RunnerHostDeployUnmodeled { host: h } => h as NonEmptyStr
    RunnerHostDeployZeroWidth { spec: s } => s.host_label
    RunnerHostDeployRefused { host: h, cause: _ } => h as NonEmptyStr
  }
}

fn populations_equal(a: List<HostIdentity>, b: List<HostIdentity>) -> Bool {
  a.length() == b.length() && all(a, x => any(b, y => host_identity_eq(a: x, b: y)))
}

fn current_participation(machine: HostIdentity) -> List<FleetParticipation> {
  match admitted_enrollment_for(machine: machine) {
    Absent => []
    Present { value: e } => e.participation
  }
}

// THE ADMITTED VERDICT OVER THE CHANGED POPULATION: an enrollment row the real A3 admission would refuse
// refuses the transition, naming the machine the fold dropped rather than paraphrasing the fold's reason.
fn participation_change_refusal(intents: List<HostEnrollmentIntent>, machine: HostIdentity) -> MachineTransitionRefusal? {
  match filter(admitted_enrollments(intents: intents), e => host_identity_eq(a: e.host, b: machine)).first() {
    Absent => Present { value: ParticipationNotAdmitted { machine: machine } }
    Present { value: _ } => Absent
  }
}

// ONE TRANSITION, ONE VERDICT.
fn admit_machine_transition_in(ledger: List<MachineRetirement>, t: MachineTransition) -> MachineTransitionAdmission {
  let subjects = machine_transition_machines(t: t)
  let unregistered = filter(subjects, m => !machine_is_registered(machine: m)).first()
  match unregistered {
    Present { value: m } => TransitionRefused { transition: t, cause: MachineNotRegistered { machine: m } }
    Absent => admit_registered_transition(ledger: ledger, t: t)
  }
}

// RETIRE-AND-REPLACE IS THE ONE TRANSITION WHOSE SUBJECT IS SUPPOSED TO BE RETIRED, so the retired guard
// runs per arm rather than across the population: for every other transition a retired subject refuses; for
// this one a retired `retired` is the precondition, and a retired `replacement` is the reissue this plan
// forbids.
fn admit_registered_transition(ledger: List<MachineRetirement>, t: MachineTransition) -> MachineTransitionAdmission {
  match t {
    ReplaceRetiredMachine { retired: r, replacement: n } =>
      match machine_is_retired_in(ledger: ledger, machine: r) {
        false => TransitionRefused { transition: t, cause: MachineNotRetired { machine: r } }
        true =>
          match machine_is_retired_in(ledger: ledger, machine: n) {
            true => TransitionRefused { transition: t, cause: RetiredHandleReissued { machine: n } }
            false => TransitionAdmitted {
              transition: t,
              effect: MachineReplaced { retired: r, replacement: n, inherited_facts: [] },
              route: machine_transition_route(t: t),
            }
          }
      }
    _ =>
      match filter(machine_transition_machines(t: t), m => machine_is_retired_in(ledger: ledger, machine: m)).first() {
        Present { value: m } => TransitionRefused { transition: t, cause: MachineAlreadyRetired { machine: m } }
        Absent => admit_transition_body(t: t)
      }
  }
}

fn admit_machine_transition(t: MachineTransition) -> MachineTransitionAdmission {
  admit_machine_transition_in(ledger: machine_retirement_ledger, t: t)
}

fn admit_transition_body(t: MachineTransition) -> MachineTransitionAdmission {
  match t {
    // A NAME NOBODY DREW CANNOT BE RENAMED TO: the promotion target is the row's own pending field, and the
    // name it replaces is read from the same row -- neither is an input a person can type.
    Rename { machine: m } =>
      match machine_registry_row(machine: m) {
        Absent => TransitionRefused { transition: t, cause: MachineNotRegistered { machine: m } }
        Present { value: row } =>
          match next_name_for_fleet_slot(fleet_slot: m) {
            Absent => TransitionRefused { transition: t, cause: RenameWithoutPendingName { machine: m } }
            Present { value: pending } =>
              match roster_admits_renamed(machine: m, to: canonical_name_of(name: pending)) {
                false => TransitionRefused { transition: t, cause: RetiredHandleReissued { machine: m } }
                true => TransitionAdmitted {
                  transition: t,
                  effect: NameAdvanced {
                    machine: m,
                    from: canonical_of(allocation: row),
                    to: canonical_name_of(name: pending),
                  },
                  route: machine_transition_route(t: t),
                }
              }
          }
      }
    ReleaseName { machine: m } =>
      match current_name(machine: m) {
        Absent => TransitionRefused { transition: t, cause: MachineNotRegistered { machine: m } }
        Present { value: held } => TransitionAdmitted {
          transition: t,
          effect: NameReleased { machine: m, released: held },
          route: machine_transition_route(t: t),
        }
      }
    RebindAfterBoardSwap { machine: m, replacement: e, held_receipts: receipts } =>
      admit_rebind(transition: t, machine: m, replacement: e, held_receipts: receipts)
    Reprovision { machine: m } =>
      match admitted_enrollment_for(machine: m) {
        Absent => TransitionRefused { transition: t, cause: ReprovisionWithoutEnrollment { machine: m } }
        Present { value: _ } =>
          match current_name(machine: m) {
            Absent => TransitionRefused { transition: t, cause: MachineNotRegistered { machine: m } }
            Present { value: held } => TransitionAdmitted {
              transition: t,
              effect: MachineProvisioned { machine: m, handle_held: m as NonEmptyStr, name_held: held },
              route: machine_transition_route(t: t),
            }
          }
      }
    ChangeParticipation { machine: m, to: ps } => admit_participation(transition: t, machine: m, to: ps)
    Retire { machine: m } => TransitionAdmitted {
      transition: t,
      effect: MachineRetired { machine: m, artifacts: retirement_artifacts(machine: m) },
      route: machine_transition_route(t: t),
    }
    ReplaceRetiredMachine { retired: r, replacement: _ } =>
      TransitionRefused { transition: t, cause: MachineNotRetired { machine: r } }
  }
}

// THE ROSTER ADMITS THE RENAMED ROW. A1's own admission is re-run over the registry with the row renamed (the
// pending value promoted, the pending field cleared), so a promotion that would collide -- with another
// handle, or with another machine's current or pending spelling, including a name released elsewhere -- is
// refused by the admission that owns those keys rather than by a check invented beside it.
fn roster_admits_renamed(machine: HostIdentity, to: NonEmptyStr) -> Bool {
  let renamed = map(fleet_machine_registry, a =>
    match host_identity_eq(a: a.fleet_slot, b: machine) {
      true => HostnameAllocation { fleet_slot: a.fleet_slot, name: legacy_name_of(label: to), next_name: Absent }
      false => HostnameAllocation { fleet_slot: a.fleet_slot, name: a.name, next_name: a.next_name }
    }
  )
  match hostname_allocation_admission(allocations: renamed) {
    AllocationAdmitted { roster: _ } => true
    AllocationPrimaryKeyRepeated { key: _ } => false
    AllocationSecondaryKeyRepeated { key: _ } => false
  }
}

// The one place this module builds an AllocatedHostName, and it builds only the spelling it was handed: the
// promotion target keeps the shape the pending field carried.
fn legacy_name_of(label: NonEmptyStr) -> AllocatedHostName {
  LegacyHostname { label: label as DnsLabel }
}

// THE BOARD SWAP. Three things must hold, each read from the producer that owns it: the machine holds a
// binding today, the post-swap fold admits the replacement board (a serial held by another machine refuses
// with A2's own cause, contradictory readings with bind_unit_key's), and every receipt the operator still
// holds -- sealed against the board being replaced -- REFUSES to seal against the new unit. A stale receipt
// that STILL seals is the red case: the transition refuses rather than reporting a rebind whose old receipts
// keep working (2.5: an old-assembly receipt must refuse against the new subject).
fn admit_rebind(
  transition: MachineTransition,
  machine: HostIdentity,
  replacement: MachineUnitEvidence,
  held_receipts: List<MachineIntakeSubject>,
) -> MachineTransitionAdmission {
  let after = admit_machine_units(evidence: evidence_with_board_replaced(machine: machine, replacement: replacement))
  match machine_unit_key(machine: machine) {
    Absent => TransitionRefused { transition: transition, cause: RebindWithoutCurrentBinding { machine: machine } }
    Present { value: superseded } =>
      match machine_unit_standing_in(admission: after, machine: machine) {
        Absent => TransitionRefused { transition: transition, cause: RebindKeyRefused { machine: machine, cause: BoardSerialAbsent } }
        Present { value: standing } =>
          match standing {
            UnitKeyRefused { cause: c } => TransitionRefused { transition: transition, cause: RebindKeyRefused { machine: machine, cause: c } }
            UnitKeyBound { key: new_key } =>
              match (new_key as String) == (superseded as String) {
                true => TransitionRefused { transition: transition, cause: RebindToSameUnit { machine: machine, unit: new_key } }
                false =>
                  match filter(held_receipts, r => receipt_still_seals(machine: machine, admission: after, receipt: r)).first() {
                    Present { value: stale } => TransitionRefused {
                      transition: transition,
                      cause: StaleReceiptStillSeals { machine: machine, receipt_unit: stale.subject.unit_key },
                    }
                    Absent => TransitionAdmitted {
                      transition: transition,
                      effect: UnitRebound {
                        machine: machine,
                        superseded: superseded,
                        replacement: new_key,
                        receipts_now_refused: map(held_receipts, r => r.subject.unit_key as NonEmptyStr),
                      },
                      route: machine_transition_route(t: transition),
                    }
                  }
              }
          }
      }
  }
}

// DOES AN OLD RECEIPT STILL SEAL? Asked of the real admission over the post-swap fold, never of a copy: it
// seals when that admission still ACCEPTS a subject built for the superseded board against the machine's new
// unit. A machine with no standing after the swap seals nothing, so an absent standing is not "still seals".
fn receipt_still_seals(machine: HostIdentity, admission: MachineUnitAdmission, receipt: MachineIntakeSubject) -> Bool {
  match machine_unit_standing_in(admission: admission, machine: machine) {
    Absent => false
    Present { value: standing } =>
      match physical_machine_admission(
        host: machine,
        unit_standing: standing,
        current_subject: Present { value: receipt },
        fleet: Absent,
        control: Absent,
      ) {
        PhysicalMachineAdmitted { binding: _ } => true
        PhysicalMachineRefused { cause: _ } => false
      }
  }
}

// A PARTICIPATION CHANGE MUST CHANGE THE PARTICIPATION, and the effect it reports is the one the acceptance
// names: the runner population re-derived through the producer that derives it, and the enrolled-host
// population -- the other read over the same rows -- shown unchanged.
fn admit_participation(transition: MachineTransition, machine: HostIdentity, to: List<FleetParticipation>) -> MachineTransitionAdmission {
  let before = current_participation(machine: machine)
  let changed = intents_with_participation(intents: fleet_enrollment_intents, machine: machine, to: to)
  match participation_lists_equal(a: before, b: to) {
    true => TransitionRefused { transition: transition, cause: ParticipationUnchanged { machine: machine } }
    false =>
      match participation_change_refusal(intents: changed, machine: machine) {
        Present { value: cause } => TransitionRefused { transition: transition, cause: cause }
        Absent => TransitionAdmitted {
          transition: transition,
          effect: ParticipationAltered {
            machine: machine,
            from: before,
            to: to,
            runner_population_before: runner_population_labels(intents: fleet_enrollment_intents),
            runner_population_after: runner_population_labels(intents: changed),
            enrolled_population_unchanged: populations_equal(
              a: map(admitted_enrollments(intents: fleet_enrollment_intents), e => e.host),
              b: map(admitted_enrollments(intents: changed), e => e.host),
            ),
          },
          route: machine_transition_route(t: transition),
        }
      }
  }
}

fn participation_lists_equal(a: List<FleetParticipation>, b: List<FleetParticipation>) -> Bool {
  a.length() == b.length()
    && all(a, p => participation_list_contains(ps: b, wanted: p))
    && all(b, p => participation_list_contains(ps: a, wanted: p))
}

// THE RETIREMENT, PRODUCED HERE AND NOWHERE ELSE: the ledger row carries the derived artifact list.
fn retired_ledger_with(ledger: List<MachineRetirement>, machine: HostIdentity) -> List<MachineRetirement> {
  match machine_is_retired_in(ledger: ledger, machine: machine) {
    true => ledger
    false => concat(ledger, [MachineRetirement { machine: machine, artifacts: retirement_artifacts(machine: machine) }])
  }
}

fn retire_machine(machine: HostIdentity) -> MachineTransitionAdmission {
  admit_machine_transition_in(ledger: machine_retirement_ledger, t: Retire { machine: machine })
}

// A RETIRED HANDLE IS NEVER REISSUED. The ledger is consulted BEFORE the roster: a reissue is refused because
// the ledger holds the handle, and could not be spelled past A1's key checks even if the ledger were empty.
// A registry-side consumer calls this with the rows it is about to admit; P13's witness runs it over a
// fixture ledger, because no machine has been retired in production yet.
fn registry_reissue_admission(ledger: List<MachineRetirement>, rows: List<HostnameAllocation>) -> MachineTransitionRefusal? {
  let reissued = filter(rows, r => machine_is_retired_in(ledger: ledger, machine: r.fleet_slot)).first()
  match reissued {
    Present { value: r } => Present { value: RetiredHandleReissued { machine: r.fleet_slot } }
    Absent => Absent
  }
}

// THE FIXTURE BOARD SWAP: the readings a replacement board gives, in the same BoardSerialObservation shape
// A2's witness uses. It is a fixture and says so -- the fleet's real evidence rows are untouched, and
// nothing here is applied to a live machine.
fn fixture_board_swap_evidence(machine: HostIdentity, swapped_serial: String) -> MachineUnitEvidence {
  MachineUnitEvidence {
    machine: machine,
    inputs: UnitIdentityInputs {
      bmc_endpoint: mtcollins1_unit_identity_inputs.bmc_endpoint,
      board_serial_observations: [
        BoardSerialObservation { source: BmcFru, serial: swapped_serial as NonEmptyStr },
        BoardSerialObservation { source: HostSmbios, serial: swapped_serial as NonEmptyStr },
      ],
    },
  }
}
