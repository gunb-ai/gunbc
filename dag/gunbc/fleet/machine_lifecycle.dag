  fleet_machine_registry,
  hostname_allocation_admission,
  human_name_canonical_hostname,
  next_name_for_fleet_slot,
}
import gunbc.fleet.fleet_machine_unit_binding {
  MachineUnitAdmission,
  MachineUnitEvidence,
  admit_machine_units,
  fleet_machine_unit_evidence,
  machine_unit_standing,
