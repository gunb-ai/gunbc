import std.algebra { list_flat_map }
import std.decl_ref { DeclarationRef, decl_ref, declaration_ref_display_key }
import std.annotation_reference { segment_is_identifier, segment_is_module_path }
import product.host_identity { HostIdentity, host_identity_eq }
import gunbc.hostname_allocation {
  AllocatedHostName,
  AllocationAdmitted,
  AllocationPrimaryKeyRepeated,
  AllocationSecondaryKeyRepeated,
  DrawnHumanName,
  HostnameAllocation,
  LegacyHostname,
  canonical_hostname_for_fleet_slot,
  fleet_machine_registry,
  hostname_allocation_admission,
  human_name_canonical_hostname,
  next_name_for_fleet_slot,
}
import gunbc.fleet.fleet_machine_unit_binding {
  MachineUnitAdmission,
  MachineUnitEvidence,
  admit_machine_units,
  fleet_machine_unit_evidence,
  machine_unit_standing,
  machine_unit_standing_in,
}
import gunbc.machine_intake.subject {
  BoardSerialAbsent,
  UnitKey,
  MachineIntakeSubject,
  UnitKeyBound,
  UnitKeyRefusalCause,
  UnitKeyRefused,
  unit_key_equal,
}
import gunbc.host.physical_machine_binding {
  PhysicalMachineAdmitted,
  PhysicalMachineRefused,
  physical_machine_admission,
}
import gunbc.fleet.fleet_enrollment {
  CiRunnerParticipation,
  FleetParticipation,
  HostEnrollmentIntent,
  fleet_enrollments,
  participation_list_contains,
}
import gunbc.fleet.fleet_host_backing {
  ApplianceImage,
  InstalledViaVirtualMedia,
  OwnedMachine,
  ProviderGuest,
  RamImageBoot,
}
import gunbc.runner.runner_host_deploy {
