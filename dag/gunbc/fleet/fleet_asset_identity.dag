module gunbc.fleet_asset_identity

import product.placement_supply { PhysicalAssetIdentity }

// EVERY PHYSICAL ASSET IDENTITY THE OPERATOR FLOOR HOLDS, IN ONE MODULE UPSTREAM OF BOTH ITS USERS.
//
// These constants lived in gunbc.fleet_physical_inventory, which imports gunbc.fleet_intent_network
// for the host identities. That was fine while only the inventory named an asset. It stopped being
// fine when review 59815 required the printer's network endpoint to bind to printer_01
// structurally: the endpoint lives in fleet_intent_network, so that binding would have made the two
// modules import each other, and DESIGN section 3 states the import graph's ONE structural law is
// acyclicity.
//
// The cycle is the signal, not the obstacle. An identity is not a fact ABOUT an inventory row or
// ABOUT a network endpoint -- it is the name both of them index, so it belongs beneath both rather
// than inside either. Splitting it out is what lets the endpoint and the inventory row refer to one
// declaration instead of agreeing by string.

data chassis_srv1: PhysicalAssetIdentity = "chassis-srv1" as PhysicalAssetIdentity
data chassis_srv2: PhysicalAssetIdentity = "chassis-srv2" as PhysicalAssetIdentity
data chassis_srv3: PhysicalAssetIdentity = "chassis-srv3" as PhysicalAssetIdentity
data chassis_srv4: PhysicalAssetIdentity = "chassis-srv4" as PhysicalAssetIdentity
data chassis_srv5_placeholder: PhysicalAssetIdentity = "chassis-srv5-placeholder" as PhysicalAssetIdentity
data chassis_srv6_placeholder: PhysicalAssetIdentity = "chassis-srv6-placeholder" as PhysicalAssetIdentity
data switch_01: PhysicalAssetIdentity = "switch-01" as PhysicalAssetIdentity
data printer_01: PhysicalAssetIdentity = "printer-01" as PhysicalAssetIdentity
data ams_01: PhysicalAssetIdentity = "ams-01" as PhysicalAssetIdentity
data pdu_01: PhysicalAssetIdentity = "pdu-01" as PhysicalAssetIdentity
data pi_controller: PhysicalAssetIdentity = "pi-controller" as PhysicalAssetIdentity
data cooler_srv3: PhysicalAssetIdentity = "cooler-srv3" as PhysicalAssetIdentity
data cooler_srv4: PhysicalAssetIdentity = "cooler-srv4" as PhysicalAssetIdentity
