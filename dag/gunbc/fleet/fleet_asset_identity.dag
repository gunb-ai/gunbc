module gunbc.fleet.fleet_asset_identity

import product.placement_supply { PhysicalAssetIdentity }

// EVERY PHYSICAL ASSET IDENTITY THE OPERATOR FLOOR HOLDS, IN ONE MODULE UPSTREAM OF BOTH ITS USERS.
//
// These constants lived in gunbc.fleet.fleet_physical_inventory, which imports gunbc.fleet.fleet_intent_network
// for the host identities. That was fine while only the inventory named an asset. It stopped being
// fine when review 59815 required the printer's network endpoint to bind to printer_01
// structurally: the endpoint lives in fleet_intent_network, so that binding would have made the two
// modules import each other, and gunbc.design_argument::single_authority states the import graph's ONE structural law is
// acyclicity.
//
// The cycle is the signal, not the obstacle. An identity is not a fact ABOUT an inventory row or
// ABOUT a network endpoint -- it is the name both of them index, so it belongs beneath both rather
// than inside either. Splitting it out is what lets the endpoint and the inventory row refer to one
// declaration instead of agreeing by string.

// CHASSIS AND COOLERS ARE NUMBERED, NOT NAMED FOR A HOST (operator, D6 of gunbc.plans.fleet_machine_authority,
// 2026-11-10), as the GPU boards are: a host is renamed and a chassis can be reused, and which chassis sits
// under which machine is a containment row in gunbc.fleet.fleet_host_assembly, never a spelling here.
data chassis_01: PhysicalAssetIdentity = "chassis-01" as PhysicalAssetIdentity
data chassis_02: PhysicalAssetIdentity = "chassis-02" as PhysicalAssetIdentity
data chassis_03: PhysicalAssetIdentity = "chassis-03" as PhysicalAssetIdentity
data chassis_04: PhysicalAssetIdentity = "chassis-04" as PhysicalAssetIdentity
data switch_01: PhysicalAssetIdentity = "switch-01" as PhysicalAssetIdentity
data printer_01: PhysicalAssetIdentity = "printer-01" as PhysicalAssetIdentity
data printer_02: PhysicalAssetIdentity = "printer-02" as PhysicalAssetIdentity
data ams_01: PhysicalAssetIdentity = "ams-01" as PhysicalAssetIdentity
data pdu_01: PhysicalAssetIdentity = "pdu-01" as PhysicalAssetIdentity
data pi_controller: PhysicalAssetIdentity = "pi-controller" as PhysicalAssetIdentity
data cooler_01: PhysicalAssetIdentity = "cooler-01" as PhysicalAssetIdentity
data cooler_02: PhysicalAssetIdentity = "cooler-02" as PhysicalAssetIdentity

// GPU BOARDS (2026-10-30). Numbered, not named for a host: a card moves between hosts, and where it sits
// is a containment row in gunbc.fleet.fleet_physical_inventory, never a spelling here.
data gpu_board_01: PhysicalAssetIdentity = "gpu-board-01" as PhysicalAssetIdentity
data gpu_board_02: PhysicalAssetIdentity = "gpu-board-02" as PhysicalAssetIdentity
data gpu_board_03: PhysicalAssetIdentity = "gpu-board-03" as PhysicalAssetIdentity
data gpu_board_04: PhysicalAssetIdentity = "gpu-board-04" as PhysicalAssetIdentity
data gpu_board_05: PhysicalAssetIdentity = "gpu-board-05" as PhysicalAssetIdentity
data gpu_board_06: PhysicalAssetIdentity = "gpu-board-06" as PhysicalAssetIdentity
// srv14/butch's four NVIDIA A2 cards, read on butch 2026-11-10 (nvidia-smi over ssh from the session,
// driver 595.91.07): gpu-board-07 = GPU0 0000:01:00.0 slot PCIE5 serial 1321522057289; gpu-board-08 =
// GPU1 0001:01:00.0 slot PCIE4 serial 1321522058306; gpu-board-09 = GPU2 0004:01:00.0 slot PCIE7 serial
// 1321522036087; gpu-board-10 = GPU3 0004:02:00.0 slot PCIE6 serial 1321522057766. Device bindings are
// the typed rows in gunbc.fleet.gpu_device_observation, not restated here.
data gpu_board_07: PhysicalAssetIdentity = "gpu-board-07" as PhysicalAssetIdentity
data gpu_board_08: PhysicalAssetIdentity = "gpu-board-08" as PhysicalAssetIdentity
data gpu_board_09: PhysicalAssetIdentity = "gpu-board-09" as PhysicalAssetIdentity
data gpu_board_10: PhysicalAssetIdentity = "gpu-board-10" as PhysicalAssetIdentity
// ken (the third Supermicro H11SSL-i, gunbc.fleet.fleet_host_identity::operator_host_e2d4b7) carries three
// NVIDIA GPU functions, read ON THE CARDS 2026-11-18 by `nvidia-smi --query-gpu=pci.bus_id,uuid,serial`
// (artifacts/host-observations/ken-gpu-read-2026-11-18/gpu_identity_query.txt): gpu-board-11 = 0000:01:00.0
// uuid GPU-c4177907-3dc8-12be-4146-431ea120f818 serial 1322720003956; gpu-board-12 = 0000:81:00.0 uuid
// GPU-8327ce9a-6011-f8cf-0012-4af9596c3124 serial 1323619011509; gpu-board-13 = 0000:c1:00.0 uuid
// GPU-a56f81eb-df65-ec75-e5ee-06c01ce8509e serial 1323019027149. The numbering continues gpu_board_01..10;
// it is an identity, not a slot. TWO STATEMENTS ON THE MACHINE pair bus to slot and agree with each other --
// the cap script's header says "SLOT4 01:00.0, SLOT6 81:00.0, SLOT2 c1:00.0", and the operator's own 2026-11-17
// session named the "third card: serial 1323019027149, in SLOT2 (c1:00.0)" -- but neither is a read through a
// modeled route, and the corpus has no route that pairs a bus id to a chassis slot at all (the register row that
// owed this half says so). The slot pairing therefore stays unmodeled here; the two statements are cited on the
// intake rows that carry them.
// The driver prints an 8-digit domain (00000000:01:00.0); sysfs lists these functions without one. Device
// bindings are the typed rows in gunbc.fleet.gpu_device_observation, not restated here.
data gpu_board_11: PhysicalAssetIdentity = "gpu-board-11" as PhysicalAssetIdentity
data gpu_board_12: PhysicalAssetIdentity = "gpu-board-12" as PhysicalAssetIdentity
data gpu_board_13: PhysicalAssetIdentity = "gpu-board-13" as PhysicalAssetIdentity
// john (the fourth Supermicro H11SSL, gunbc.fleet.fleet_host_identity::operator_host_ba61f9) carries three
// NVIDIA GPU functions, read ON THE CARDS 2026-11-28 by `nvidia-smi --query-gpu=...uuid,serial,pci.bus_id...`
// (artifacts/host-observations/john-gpu-power-2026-11-28/gpu_identity_power_query.csv): gpu-board-14 =
// 0000:01:00.0 "Tesla V100-SXM2-16GB" uuid GPU-d36a26ba-52e6-3e47-e7fa-a9ca371c97b9 serial 1562520002708;
// gpu-board-15 = 0000:81:00.0 "Tesla P100-PCIE-16GB" uuid GPU-08e9f79b-1389-b4e8-e3e3-b3eb6f2c4a27 serial
// 0323216058317; gpu-board-16 = 0000:c1:00.0 "Tesla PG500-216" uuid GPU-4c63477e-61ff-9348-7969-4b0c3bb9fd01
// serial 1561621019629. The numbering continues gpu_board_01..13 and is an identity, not a slot.
data gpu_board_14: PhysicalAssetIdentity = "gpu-board-14" as PhysicalAssetIdentity
data gpu_board_15: PhysicalAssetIdentity = "gpu-board-15" as PhysicalAssetIdentity
data gpu_board_16: PhysicalAssetIdentity = "gpu-board-16" as PhysicalAssetIdentity


// Inventory identity is independent of a host-slot or router-observation binding.
// Consumer: fleet_physical_inventory.dgx_spark_asset_identities, exercised by
// test.claim.dgx_spark_inventory_witness through the inventory population witness.
data dgx_spark_01: PhysicalAssetIdentity = "dgx-spark-01" as PhysicalAssetIdentity
data dgx_spark_02: PhysicalAssetIdentity = "dgx-spark-02" as PhysicalAssetIdentity
data dgx_spark_03: PhysicalAssetIdentity = "dgx-spark-03" as PhysicalAssetIdentity
data dgx_spark_04: PhysicalAssetIdentity = "dgx-spark-04" as PhysicalAssetIdentity
data dgx_spark_05: PhysicalAssetIdentity = "dgx-spark-05" as PhysicalAssetIdentity
data dgx_spark_06: PhysicalAssetIdentity = "dgx-spark-06" as PhysicalAssetIdentity
data dgx_spark_07: PhysicalAssetIdentity = "dgx-spark-07" as PhysicalAssetIdentity
data dgx_spark_08: PhysicalAssetIdentity = "dgx-spark-08" as PhysicalAssetIdentity

// The GH200 hardware bought 2026-10-04 (product.superchip_assembly_qualification). Allocated before
// the units arrive so qualification evidence binds to a physical asset from the first receipt: two
// modules of ONE part number are two assets, and a part number is never an instance identifier.
data gh200_dv5_a: PhysicalAssetIdentity = "gh200-dv5-a" as PhysicalAssetIdentity
data gh200_dv5_b: PhysicalAssetIdentity = "gh200-dv5-b" as PhysicalAssetIdentity
data p4261_k1_a: PhysicalAssetIdentity = "p4261-k1-a" as PhysicalAssetIdentity
// The second carrier, allocated 2026-10-15 when bench readings were first taken on it: the operator
// reads its model label as revision E1 and believes it is the baseboard bought from Central Valley.
// Its sticker, read 2026-10-16, carries S/N 1583323120274 (product.p4261.e1_b
// p4261_e1_layout); the asset keeps this identity, and the serial is the reading that names the board.
data p4261_e1_b: PhysicalAssetIdentity = "p4261-e1-b" as PhysicalAssetIdentity
// The opened pair's E1 from the lot of ten, allocated 2026-11-08 before its first recorded reading, as the
// GH200 units were before they arrived: the comparison reads the P4261 sheets ask of it bind to this
// asset from the first one, never to "the lot board". E1 is the operator's reading of its label; once its
// sticker is read, the serial is recorded on its rows and is the reading that names the board. Before its
// first new measurement, a label or photograph reading must tell this board apart from the other lot
// boards; and the allocation attaches nothing retroactively -- an earlier lot observation that named no
// board stays unattributed rather than becoming this asset's.
// BOUND 2026-11-13, at its first recorded reading: this is the lot E1 whose sticker the operator reads as
// S/N 1583323120148, the board the J68 chain scan was taken on (product.p4261.readings
// p4261_j68_chain_scans). Whether it is the E1 of the pair opened and powered on 2026-11-04 the operator
// could not say, so that standby reading stays unattributed, as the rule above has it.
data p4261_e1_c: PhysicalAssetIdentity = "p4261-e1-c" as PhysicalAssetIdentity
// The untouched lot E1 that the comparison after the 2026-11-13 enable attempt on p4261_e1_c reads,
// allocated 2026-11-14 before its first recorded reading and named by its serial, so that none of its
// readings can become a state of p4261_e1_c: the operator read its sticker as S/N 1583323120218 when the
// lot's E1s were unpacked on 2026-11-09, and S/N 1583323120229 stays the untouched reserve. Before its first
// new measurement its label is photographed again, so that the reading names this board and not another
// lot board. Its first consumer is that comparison's readings, recorded when they are taken.
data p4261_e1_s1583323120218: PhysicalAssetIdentity = "p4261-e1-s1583323120218" as PhysicalAssetIdentity
// The E4833 controller carrier the operator holds, bought second-hand about 2026-10-17 with no HMC in
// its J5 socket. A second E4833 was ordered on 2026-11-09 and takes its own identity when it arrives, so a
// reading binds to the card it was taken on (product.e4833.unit_a holds this one's).
data e4833_a: PhysicalAssetIdentity = "e4833-a" as PhysicalAssetIdentity
