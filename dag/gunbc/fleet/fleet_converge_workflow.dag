  }
}

fn fleet_converge_spark_bootstrap_step() -> Step {
  RunStep {
    name: Present { value: "Spark managed-access bootstrap (creates gunbc-automation, installs the fleet key, proves key-only auth, lays the narrow grants; one target per run)" },
    id: Present { value: "spark_bootstrap" },
    run: gunbc_ci_spark_bootstrap_invoke(),
    shell: none,
    env: Present {
      value: [
        kv(key: "SPARK_CONVERGE_TARGET", value: yaml_string(s: "${{ github.event.inputs.target }}")),
        kv(key: "WIF_ACCESS_TOKEN", value: yaml_string(s: "${{ steps.wif_auth.outputs.access_token }}")),
      ]
