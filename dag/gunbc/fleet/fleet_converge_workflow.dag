// THE ATTEMPT IDENTITY IS A WORKFLOW FACT AND IS OWNED HERE; THE DIRECTORY SHAPE IS THE MINT'S.
// A self-hosted runner's /tmp survives across attempts, so an always() uploader over a shared path
// could collect a PREVIOUS attempt's orphan receipt as this attempt's evidence -- and an operator
// reads that receipt to decide which live Cloudflare token to revoke. These two expressions are the
// only part of the path this module knows; everything around them comes from r2_mint_receipt_glob_in,
// and the mint composes the SAME scope from GITHUB_RUN_ID / GITHUB_RUN_ATTEMPT on the runner.
fn fleet_converge_r2_mint_receipt_scope() -> R2MintReceiptAttemptScoped {
  R2MintReceiptAttemptScoped {
    scope: r2_mint_receipt_scope(
      run_id: "${{ github.run_id }}",
      run_attempt: "${{ github.run_attempt }}",
    ),
  }
}

// THE GLOB IS NOW DERIVED, NOT HAND-SPELLED, AND THE EARLIER ANNOTATION DEFENDED ONLY HALF OF IT.
// It argued the wildcard avoids re-spelling the bucket name -- true -- while the prefix and suffix
// around it were typed here and owned by gunbc.cloudflare.r2_token_mint_run (review 66010). Both
// ends now come from r2_mint_receipt_glob, so a rename of the producer's path moves this with it.
//
// THE RECEIPT IS UPLOADED WITH always() AND ITS PATH IS A GLOB. always(), because a mint that
// created a token and then failed to store it is the run whose receipt matters most and the run
// that fails -- and that arm now WRITES one: gunbc.cloudflare.r2_token_mint_run
// refuse_with_orphan_receipt records the live token's id before failing, so always() has something
// real to collect. It did not, for one revision of this PR: the success path wrote token_id and the
// store-refusal path wrote nothing, so this step claimed to cover the orphan case while the only
// receipt it could ever find belonged to a run that did not need one. A glob, because the receipt is named for the bucket the mint ran against
// (gunbc.cloudflare.r2_token_mint_run r2_origin_token_name) and re-spelling that name here would be
// a second authority for it -- the §3 decay that an edit to the allocation roster would silently
// invalidate. if-no-files-found is warn rather than error for the same reason the condition is
// always(): a refusal before the Create writes no receipt, and that is the correct outcome, not a
// missing artifact.
fn fleet_converge_r2_object_write_mint_receipt_upload_step() -> Step {
  UsesStep {
    name: Present { value: "Upload R2 object-write mint receipt (token id + custody version resource; no secret)" },
    id: Present { value: "r2_object_write_mint_receipt_upload" },
    uses: upload_artifact_action,
    with: Present { value: [
      kv(key: "name", value: yaml_string(s: "r2-object-write-mint-receipt")),
      kv(key: "path", value: yaml_string(s: r2_mint_receipt_glob_in(
        scope: fleet_converge_r2_mint_receipt_scope(),
        profile: R2OriginObjectWrite,
      ))),
      kv(key: "if-no-files-found", value: yaml_string(s: "warn")),
      kv(key: "retention-days", value: yaml_int(n: 30)),
    ] },
    env: none,
    if_condition: Present { value: join(["always() && ", fleet_converge_r2_object_write_mint_step_if], "") },
    continue_on_error: none,
    timeout_minutes: Present { value: gunbc_ci_artifact_transfer_step_timeout_minutes }
  }
}

fn fleet_converge_app_control_plane_receipt_upload_step() -> Step {
  UsesStep {
