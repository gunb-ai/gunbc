// THE CONTROLLER APP KEY MODE (gunbc.microvm_controller_app_key_converge). A step in the host-pinned
// job like the password-session mode, but NOT through fleet_converge_runner_host_file_step: it reads
// the key from Secret Manager in-process, so it carries the run's workload-identity token beside the
// host binding. Dispatching it delivers custody only; nothing selects the microVM path for the floor
// job.
data fleet_converge_microvm_controller_app_key_converge_step_if: String = fleet_converge_mode_step_if(mode: MicrovmControllerAppKeyConverge)

fn fleet_converge_microvm_controller_app_key_converge_step() -> Step {
  RunStep {
    name: Present { value: "MicroVM controller App key: deliver root:root 0400 from Secret Manager, read owner, mode, bytes and staging back" },
    id: Present { value: "microvm_controller_app_key_converge" },
    run: gunbc_ci_microvm_controller_app_key_converge_invoke(),
    shell: none,
    env: Present {
      value: [
        kv(key: fleet_converge_expected_host_env_name, value: yaml_string(s: "${{ github.event.inputs.host }}")),
        kv(key: "WIF_ACCESS_TOKEN", value: yaml_string(s: "${{ steps.wif_auth.outputs.access_token }}")),
      ]
    },
    working_directory: none,
    if_condition: Present { value: fleet_converge_microvm_controller_app_key_converge_step_if },
    continue_on_error: none,
    timeout_minutes: Present { value: gunbc_ci_runner_host_file_step_timeout_minutes }
  }
}

