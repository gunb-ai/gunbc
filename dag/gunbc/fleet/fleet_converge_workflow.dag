    if_condition: Present { value: fleet_converge_spark_grants_step_if },
    continue_on_error: none,
    timeout_minutes: Present { value: gunbc_ci_spark_serving_step_timeout_minutes }
  }
}

fn fleet_converge_spark_bootstrap_step() -> Step {
  RunStep {
    name: Present { value: "Spark managed-access bootstrap (creates gunbc-automation, installs the fleet key, proves key-only auth, lays the narrow grants; one target per run)" },
    id: Present { value: "spark_bootstrap" },
    run: gunbc_ci_spark_bootstrap_invoke(),
    shell: none,
    env: Present {
      value: [
        kv(key: "SPARK_CONVERGE_TARGET", value: yaml_string(s: "${{ github.event.inputs.target }}")),
        kv(key: "WIF_ACCESS_TOKEN", value: yaml_string(s: "${{ steps.wif_auth.outputs.access_token }}")),
      ]
    },
    working_directory: none,
    if_condition: Present { value: fleet_converge_spark_bootstrap_step_if },
    continue_on_error: none,
    timeout_minutes: Present { value: gunbc_ci_spark_serving_step_timeout_minutes }
  }
}

// THE PAIR-SERVING APPLY. Same prelude as the bootstrap and the grant install -- the job's fleet-key
// agent plus the per-target administrator credential materialized to one file -- so the three cannot
// drift on how a Spark is reached or authenticated. The entry converges the promoted fabric groups'
// vLLM units, workers before heads.
fn fleet_converge_spark_serving_apply_step() -> Step {
  RunStep {
    name: Present { value: "Spark pair serving apply (promoted fabric groups' vLLM units over the password session, workers before heads)" },
    id: Present { value: "spark_serving_apply" },
    run: gunbc_ci_spark_serving_apply_invoke(),
    shell: none,
    env: Present {
      value: [
        kv(key: "SPARK_CONVERGE_TARGET", value: yaml_string(s: "${{ github.event.inputs.target }}")),
        kv(key: "WIF_ACCESS_TOKEN", value: yaml_string(s: "${{ steps.wif_auth.outputs.access_token }}")),
      ]
    },
    working_directory: none,
    if_condition: Present { value: fleet_converge_spark_serving_apply_step_if },
    continue_on_error: none,
    timeout_minutes: Present { value: gunbc_ci_spark_serving_step_timeout_minutes }
  }
}

// THE NATIVE ARM'S APPLY, UNDER ITS OWN MODE. The pair step converges the promoted fabric groups'
// pair units; this step converges group B's native four-rank arm (gunbc.spark.native_serving_apply)
// over the same password session, and it runs exactly when the operator asks for
// `spark_native_serving_apply` and never otherwise. THE HEAD IS APPLIED BEFORE THE WORKERS, which is
// what the source does: the head's engine opens the rendezvous store every worker's restart then
// joins, and workers restarted first were observed (2026-09-16) joining the PREVIOUS epoch's store
// while the head crash-looped on DistStoreError. An earlier revision of this text said "workers
// before the head" while the source did the opposite -- a generated description that contradicted the
// thing it described, which is worse than none because an operator plans the blast radius from it.
fn fleet_converge_spark_native_serving_apply_step() -> Step {
  RunStep {
    name: Present { value: "Spark native serving apply (group B's native four-rank arm as one bounded transaction over the password session: all-host preflight that mutates nothing, the incumbent unit preserved, head before workers, a readback of the complete realization bound to each rank's own incarnation, then commit or roll the whole arm back)" },
    id: Present { value: "spark_native_serving_apply" },
    run: gunbc_ci_spark_native_serving_apply_invoke(),
    shell: none,
    env: Present {
      value: [
        kv(key: "SPARK_CONVERGE_TARGET", value: yaml_string(s: "${{ github.event.inputs.target }}")),
        kv(key: "WIF_ACCESS_TOKEN", value: yaml_string(s: "${{ steps.wif_auth.outputs.access_token }}")),
      ]
    },
    working_directory: none,
    if_condition: Present { value: fleet_converge_spark_native_serving_apply_step_if },
    continue_on_error: none,
    timeout_minutes: Present { value: gunbc_ci_spark_serving_step_timeout_minutes }
  }
}

// A MODE, NOT A JOB. This is a step inside the existing dispatch-only fleet job, gated by the same
// mode conditional every other spark_* step uses, so it costs nothing on a push and adds no standing
// claim on a runner -- which is the bar the job roster is closed to growth against. It shares the
// job's prelude, so it authenticates the way the bootstrap, the grant install and the serving apply
// already do.
//
// IT RUNS HERE BECAUSE THE CREDENTIAL DOES. Docker's socket on a Spark is root-owned and the managed
// executor is in no docker group, so the only modeled route to that daemon is the administrator
// credential materialized inside this boundary. An authoring session cannot hold it, which is the
// whole reason the probe is a dispatched mode rather than something anyone runs from a laptop.
fn fleet_converge_spark_runtime_image_probe_step() -> Step {
  RunStep {
    name: Present { value: "Spark runtime image probe (pull the pinned image on the selected Spark and ask it, inside its own digest, what it registers and what it admits)" },
    id: Present { value: "spark_runtime_image_probe" },
    run: gunbc_ci_spark_runtime_image_probe_invoke(),
    shell: none,
    env: Present {
      value: [
        kv(key: "SPARK_CONVERGE_TARGET", value: yaml_string(s: "${{ github.event.inputs.target }}")),
        kv(key: "WIF_ACCESS_TOKEN", value: yaml_string(s: "${{ steps.wif_auth.outputs.access_token }}")),
      ]
    },
    working_directory: none,
    if_condition: Present { value: fleet_converge_spark_runtime_image_probe_step_if },
    continue_on_error: none,
    timeout_minutes: Present { value: gunbc_ci_spark_serving_step_timeout_minutes }
  }
}

// EVERY JOB CHECKS OUT R, THE REVISION THE OPERATOR NAMED, NOT WHATEVER main IS WHEN THE RUNNER
// FINALLY PICKS THE JOB UP. The run-revision guard in gunbc.fleet_converge_plan_cli compares the
// checked-out tree to RLM_EXPECTED_REVISION and refuses on mismatch; with a plain branch checkout
// that guard was satisfied only when main stayed still for the whole queue wait, and on a busy day
// it failed three dispatches in a row (2026-09-04, RunRevisionRefused on srv2/srv3/srv4) for a
// reason that had nothing to do with the fleet. Binding the checkout to the same input the guard
// reads makes the guard a check on the workflow's own consistency rather than a race with the
// merge queue. When no expected_revision is given the dispatched ref is checked out, exactly as
// before. There is no expected_healed_sha preflight here (unlike ci.yml heal revalidation), so the
// ci_artifact_consumer_prelude_steps paste-through is still not used.
data fleet_converge_checkout_ref_expr: String = "${{ github.event.inputs.expected_revision || github.ref }}"

fn fleet_converge_checkout_step() -> Step {
  UsesStep {
    name: Present { value: "Checkout" },
    id: none,
    uses: checkout_action,
    with: Present {
      value: [
        kv(key: "fetch-depth", value: yaml_int(n: 0)),
        kv(key: "ref", value: yaml_string(s: fleet_converge_checkout_ref_expr)),
      ]
    },
    env: none,
    if_condition: none,
    continue_on_error: none,
    timeout_minutes: none
  }
}

fn fleet_converge_consumer_prelude_steps() -> List<Step> {
  [fleet_converge_checkout_step()]
}

fn fleet_converge_job() -> Job {
  Job {
    id: "fleet-converge",
    name: none,
    runner: fleet_converge_host_pinned_runner_spec(),
    steps: concat(
      concat(
        fleet_converge_consumer_prelude_steps(),
        [
          ci_release_bins_download_step(),
          ci_release_bins_unpack_verify_step(),
          ci_fleet_wif_auth_step(),
          ci_fleet_key_agent_step_when(if_condition: Present { value: fleet_converge_fleet_ssh_key_step_if }),
        ]
      ),
      [
        fleet_converge_plan_step(),
        fleet_converge_launch_environment_plan_step(),
        fleet_converge_allocation_store_plan_step(),
        fleet_converge_plan_upload_step(),
        fleet_converge_plan_download_step(),
        fleet_converge_apply_step(),
        fleet_converge_apply_receipt_upload_step(),
        fleet_converge_org_actions_step(),
        fleet_converge_org_actions_receipt_upload_step(),
        fleet_converge_org_runner_roster_step(),
        fleet_converge_org_runner_roster_receipt_upload_step(),
        fleet_converge_app_control_plane_step(),
        fleet_converge_app_control_plane_receipt_upload_step(),
        fleet_converge_mtcollins1_fan_observe_step(),
        fleet_converge_mtcollins1_fan_observe_receipt_upload_step(),
        fleet_converge_r2_mint_preflight_step(),
        fleet_converge_r2_mint_preflight_receipt_upload_step(),
        fleet_converge_r2_object_write_mint_step(),
        fleet_converge_r2_object_write_mint_receipt_upload_step(),
        fleet_converge_approval_keyring_converge_step(),
        fleet_converge_mtcollins1_boot_step(),
        fleet_converge_mtcollins1_boot_receipt_upload_step(),
        fleet_converge_guest_image_observe_step(),
        fleet_converge_guest_image_converge_step(),
        fleet_converge_guest_image_receipt_upload_step(),
        fleet_converge_microvm_host_converge_step(),
        fleet_converge_microvm_host_standing_upload_step(),
        fleet_converge_microvm_boot_probe_step(),
        fleet_converge_microvm_boot_probe_receipt_upload_step(),
        fleet_converge_spark_grants_step(),
        fleet_converge_spark_bootstrap_step(),
        fleet_converge_spark_serving_apply_step(),
        fleet_converge_spark_native_serving_apply_step(),
        fleet_converge_spark_runtime_image_probe_step(),
        fleet_converge_runner_host_file_observe_step(),
        fleet_converge_runner_host_file_converge_step(),
        fleet_converge_runner_password_session_tool_converge_step(),
        fleet_converge_runner_password_session_tool_receipt_upload_step(),
        fleet_converge_runner_host_file_receipt_upload_step(),
        fleet_converge_site_pxe_edge_observe_step(),
        fleet_converge_site_pxe_edge_converge_step(),
        fleet_converge_site_pxe_edge_receipt_upload_step(),
        ci_fleet_key_agent_cleanup_step(),
      ]
    ),
    needs: ["build"],
    env: none,
    outputs: none,
    if_condition: none,
    timeout_minutes: Present { value: gunbc_ci_fleet_job_backstop_timeout_minutes() },
    continue_on_error: none,
    concurrency: Present {
      value: ConcurrencyMappingQueueNotMax {
        group: fleet_converge_mutation_concurrency_group_expression,
        cancel_in_progress: Present { value: CancelInProgressBool { value: false } },
        explicit_single: none
      }
    },
    permissions: Present {
      value: WorkflowPermissions {
        contents: Present { value: PermRead },
        pull_requests: none,
        issues: none,
        actions: Present { value: PermRead },
        id_token: Present { value: PermWrite },
      }
    }
  }
}

// THE RLM-2 RECEIPT MODE (RLM-2a deliverable 10): the fourth run of the transaction. Its own job
// for the same reason the dashboard deploy is -- it must sit in the host mutation concurrency
// domain so it never reads a host mid-mutation -- and it carries the WIF/key-agent prelude the
// converge job carries, because the deployed-tree readback reaches srv1 through the sealed FleetSsh
// locus. It downloads the three predecessor receipts by the run ids the operator typed and uploads
// its own receipt with always(), so an Incomplete verdict is preserved as evidence.
fn fleet_converge_rlm_receipt_step() -> Step {
  RunStep {
    name: Present { value: "Roadmap launch deployment receipt (rlm_launch_deployment_receipt_wet)" },
    id: Present { value: "rlm_receipt" },
    run: gunbc_ci_rlm_launch_deployment_receipt_invoke(),
    shell: none,
    env: Present {
      value: [
        kv(key: rlm_expected_revision_env_name, value: yaml_string(s: "${{ github.event.inputs.expected_revision }}")),
        kv(key: rlm_plan_run_id_env_name, value: yaml_string(s: "${{ github.event.inputs.plan_workflow_run_id }}")),
        kv(key: rlm_apply_run_id_env_name, value: yaml_string(s: "${{ github.event.inputs.apply_workflow_run_id }}")),
        kv(key: rlm_dashboard_run_id_env_name, value: yaml_string(s: "${{ github.event.inputs.dashboard_workflow_run_id }}")),
      ]
    },
    working_directory: none,
    if_condition: none,
    continue_on_error: none,
    timeout_minutes: Present { value: gunbc_ci_aux_step_timeout_minutes }
  }
}

fn fleet_converge_rlm_launch_deployment_receipt_job() -> Job {
  Job {
    id: "rlm-launch-deployment-receipt",
    name: none,
    runner: fleet_converge_host_pinned_runner_spec(),
    steps: concat(
      concat(
        fleet_converge_consumer_prelude_steps(),
        [
          ci_release_bins_download_step(),
          ci_release_bins_unpack_verify_step(),
          ci_fleet_wif_auth_step(),
          ci_fleet_key_agent_step(),
        ]
      ),
      [
        fleet_converge_receipt_download_step(
          id: "rlm_plan_download",
          name: "Download fleet converge plan artifact (plan run)",
          artifact: gunbc_fleet_converge_plan_artifact_name,
          path: fleet_converge_plan_artifact_dir,
          run_id_expression: "${{ github.event.inputs.plan_workflow_run_id }}",
        ),
        fleet_converge_receipt_download_step(
          id: "rlm_apply_download",
          name: "Download fleet converge apply receipt (apply run)",
          artifact: gunbc_fleet_converge_apply_receipt_artifact_name,
          path: gunbc_fleet_converge_apply_receipt_artifact_dir,
          run_id_expression: "${{ github.event.inputs.apply_workflow_run_id }}",
        ),
        fleet_converge_receipt_download_step(
          id: "rlm_dashboard_download",
          name: "Download live-deploy transaction receipt (dashboard run)",
          artifact: gunbc_live_deploy_receipt_artifact_name,
          path: gunbc_live_deploy_receipt_artifact_dir,
          run_id_expression: "${{ github.event.inputs.dashboard_workflow_run_id }}",
        ),
        fleet_converge_rlm_receipt_step(),
        fleet_converge_receipt_upload_step(
          id: "rlm_receipt_upload",
          name: "Upload roadmap launch deployment receipt",
          artifact: gunbc_rlm_launch_deployment_receipt_artifact_name,
          path: gunbc_rlm_launch_deployment_receipt_artifact_dir,
          if_condition: "always()",
        ),
        ci_fleet_key_agent_cleanup_step(),
      ]
    ),
    needs: ["build"],
    env: none,
    outputs: none,
    if_condition: Present { value: fleet_converge_rlm_receipt_step_if },
    timeout_minutes: Present { value: minute_count(gunbc_ci_rlm_launch_deployment_receipt_job_backstop_timeout()) },
    continue_on_error: none,
    concurrency: Present {
      value: ConcurrencyMappingQueueNotMax {
        group: fleet_host_mutation_concurrency_group_expression,
        cancel_in_progress: Present { value: CancelInProgressBool { value: false } },
        explicit_single: none
      }
    },
    permissions: Present {
      value: WorkflowPermissions {
        contents: Present { value: PermRead },
        pull_requests: none,
        issues: none,
        actions: Present { value: PermRead },
        id_token: Present { value: PermWrite },
      }
    }
  }
}

data fleet_converge_workflow: Workflow = Workflow {
  name: "fleet-converge",
  run_name: Present { value: "fleet-converge ${{ inputs.mode }} ${{ inputs.host }} nonce=${{ inputs.transaction_nonce }}" },
  on: [
    WorkflowDispatch {
      inputs: [
        DispatchInput {
          name: "host",
          description: Present { value: "Executor fleet host (runner pinned here; plan mode observes this host)" },
          required: true,
          default: none,
          type: InputChoice { options: fleet_converge_enrolled_host_options },
        },
        DispatchInput {
          name: "mode",
          description: Present { value: "plan shows membership hunks; apply executes a prior plan artifact; org_actions_observe validates the org credential and refuses on runner-group drift; org_runner_roster_observe reads the organization's self-hosted runner registrations to exhaustion under the same token and refuses unless the roster is complete; app_control_plane_observe reads the gunbai-ci App registration and webhook config with a short-lived App JWT and refuses on hook-config drift; microvm_host_converge installs the cited Firecracker release on the selected host and refuses the kvm grant by name; guest_image_observe reports the micro-VM base artifacts and their measured digests on the selected host and builds nothing; guest_image_converge builds the runner guest image there; microvm_boot_probe boots that image and reads its serial console; spark_grants and spark_bootstrap prepare the selected Spark; spark_serving_apply applies the promoted fabric groups' pair vLLM units over the password session, workers before heads; spark_native_serving_apply relaunches group B's native four-rank arm as ONE BOUNDED TRANSACTION -- an all-host preflight that mutates nothing and refuses on any unresolved artifact from an earlier run, the incumbent UNIT preserved (plus a diagnostic inspect of the incumbent container -- the container itself cannot outlive its unit, because these run --rm in the foreground under systemd), the head applied BEFORE the workers so every rank joins the head's new rendezvous store, then a readback of the COMPLETE realization through each container's own inspect -- every field the create spec states, the effective --node-rank off that container's argv, and NCCL's typed transport verdict on that incarnation -- plus the head's front door answering with this arm's served model, and then commit or a rollback of the whole arm -- and it is a separate mode because it reloads a 328 GB arm and nobody should reach it by asking for the pair units; spark_runtime_image_probe pulls the pinned runtime image on the selected Spark and reads its capabilities from inside its own digest, changing nothing; host_reset_return drives a rostered reset subject through its controller and measures the return FROM A PEER, and takes reset_observer rather than host because the observer must not be the subject; runner_host_file_observe reads the runner teardown drop-in, the needrestart deferral and the loaded teardown on the selected host as its administrator and writes nothing; runner_host_file_converge writes whichever of those two files differs, reloads systemd only if the drop-in changed, and refuses unless the manager then reports the declared teardown" },
          required: true,
          default: none,
          type: InputChoice { options: fleet_converge_mode_options },
        },
        DispatchInput {
          name: "target",
          description: Present { value: fleet_converge_spark_target_description() },
          required: false,
          default: none,
          type: InputChoice { options: fleet_converge_spark_target_options },
        },
        DispatchInput {
          name: "reset_observer",
          description: Present { value: "host_reset_return only: the PEER that observes the reset. The subject is NOT an input -- it is derived from this observer through the modeled pairing, so a job cannot be pointed at the host it is resetting" },
          required: false,
          default: none,
          type: InputChoice { options: fleet_converge_reset_observer_options },
        },
        DispatchInput {
          name: "plan_artifact_hash",
          description: Present { value: "Fnv1a64Structural bundle digest of plan.txt + apply.sh — required for apply (printed by plan step)." },
          required: false,
          default: none,
          type: InputString,
        },
        DispatchInput {
          name: "plan_workflow_run_id",
          description: Present { value: "Workflow run id that produced the plan artifact — required for apply, dashboard_deploy and rlm_launch_deployment_receipt" },
          required: false,
          default: none,
          type: InputString,
        },
        DispatchInput {
          name: "expected_revision",
          description: Present { value: "R — the exact main revision this transaction installs and proves; every run of the transaction must execute at it (RLM_EXPECTED_REVISION). Required for dashboard_deploy and rlm_launch_deployment_receipt" },
          required: false,
          default: none,
          type: InputString,
        },
        DispatchInput {
          name: "apply_workflow_run_id",
          description: Present { value: "Workflow run id of the fleet apply — required for dashboard_deploy and rlm_launch_deployment_receipt" },
          required: false,
          default: none,
          type: InputString,
        },
        DispatchInput {
          name: "dashboard_workflow_run_id",
          description: Present { value: "Workflow run id of the dashboard deploy — required for rlm_launch_deployment_receipt" },
          required: false,
          default: none,
          type: InputString,
        },
        DispatchInput {
          name: "runner_ids",
          description: Present { value: "org_runner_roster_observe only: comma-separated captured runner registration ids to observe individually (present / absent / unobserved) in the gunbai-ci organization" },
          required: false,
          default: none,
          type: InputString,
        },
        DispatchInput {
          name: "roster_page_size",
          description: Present { value: "org_runner_roster_observe only: page size for the first roster request (1..100, default 100); later pages follow the authority's own continuation links" },
          required: false,
          default: none,
          type: InputString,
        },
        DispatchInput {
          name: "transaction_nonce",
          description: Present { value: "Operator-minted unique nonce for one RLM transaction; echoed into run-name so each dispatched run is API-selectable by its displayTitle, closing the run-id correlation gap (review 5062738052 B4). Not consumed by any step" },
          required: false,
          default: none,
          type: InputString,
        },
      ]
    }
  ],
  concurrency: none,
  env: none,
  permissions: none,
  jobs: [fleet_converge_build_job(), fleet_converge_job(), fleet_converge_host_reset_return_job(), fleet_converge_dashboard_deploy_job(), fleet_converge_rlm_launch_deployment_receipt_job()],
}

type FleetConvergeYamlGenerationOutcome
  = FleetConvergeYamlGenerated { content: String }
  | FleetConvergeYamlGenerationRefused { reason: String }

// TWO REFUSAL CAUSES, ONE TYPED OUTCOME. main added the timeout-ceiling refusal and this branch
// added the capability-closure refusal; they are peers, not alternatives, so the merge keeps the
// typed outcome and gives the closure its own arm rather than picking a side. Emission REFUSES
// rather than reporting: this is the workflow whose build job carries the hand-written cargo
// resolve circuit, so a closure that only tests consult would be specification-without-execution
// on the exact file it matters for.
//
// The closure is checked FIRST because it is a fact about the steps themselves, while the timeout
// is a fact about the job that contains them -- a job whose steps cannot satisfy their own
// capabilities has nothing worth checking a budget against.
data fleet_converge_capability_closure_refusal: String = "REFUSED gunbc.fleet_converge_workflow: a step consumes a capability that no preceding step provides (gunbc.workflow_capability_closure). No workflow yaml was emitted. Fix the step roles in ci_prelude_bound_steps_with_checkout / fleet_converge_build_job_annotations, or the order of the steps themselves."

fn expected_fleet_converge_yml() -> FleetConvergeYamlGenerationOutcome {
  match admit_workflow_action_uses(workflow: fleet_converge_workflow) {
    WorkflowActionUsesRefused { refusals: rs } =>
      FleetConvergeYamlGenerationRefused { reason: workflow_action_uses_refusal_reason(workflow_module: "gunbc.fleet_converge_workflow", refusals: rs) }
    WorkflowActionUsesAdmitted =>
      match admit_workflow_toolchain_homes(workflow: fleet_converge_workflow) {
        WorkflowToolchainHomeRefused { job_id: j, refusal: r } =>
          FleetConvergeYamlGenerationRefused { reason: toolchain_home_refusal_reason(job_id: j, refusal: r) }
        WorkflowToolchainHomesAdmitted => fleet_converge_yml_after_toolchain_admission()
      }
  }
}

// THE ASSIGNMENT IS CHECKED BEFORE ANYTHING IS SERIALIZED, because an unmintable observer pairing
// leaves fleet_converge_reset_observer_options empty and an empty choice list is a dispatch form that
// silently cannot run the mode. A refusal that names its cause is the only honest arm: emitting a
// workflow whose reset mode is unselectable would be the absorbing fallback DESIGN section 5 forbids,
// with the loss denominated in the roster rather than in the change that caused it.
fn fleet_converge_reset_assignment_refusal_reason(cause: ResetDispatchAssignmentRefusalCause) -> String {
  match cause {
    ObserverAssignedToTwoSubjects { observer: o, first_subject: a, second_subject: b } =>
      join([
        "REFUSED gunbc.fleet_converge_workflow: the reset observer ", o as String,
        " is assigned to two subjects (", a as String, " and ", b as String,
        "), so runs-on could not say which machine the job is watching. The dispatch input carries the OBSERVER and the subject is derived from it, which requires that mapping to be a function. Encode the pair in the option value, or give each subject its own peer.",
      ], "")
    AssignmentPairingRefused { cause: inner } =>
      match inner {
        ObserverIsSubject { host: h } =>
          join(["REFUSED gunbc.fleet_converge_workflow: ", h as String, " is rostered as BOTH a reset subject and a reset observer, so the two rosters disagree about what that machine is. gunbc.host_reset_subject_roster derives subjects from BMC power-control admission and peers from fleet_hosts(); a host in both needs one of those two answers withdrawn."], "")
        SubjectNotRostered { subject: sname } =>
          join(["REFUSED gunbc.fleet_converge_workflow: ", sname as String, " is not an admitted reset subject (gunbc.host_reset_subject_roster admits a host only when a landed BMC access observation and its capability row admit power control)."], "")
        ObserverNotRostered { observer: o } =>
          join(["REFUSED gunbc.fleet_converge_workflow: ", o as String, " is not an executor fleet host, so no runner carries its label and no job could be scheduled on it."], "")
        NoPeerAvailable { subject: sname } =>
          join(["REFUSED gunbc.fleet_converge_workflow: ", sname as String, " has no peer that could observe its reset. gunbc.host_reset_subject_roster reset_observer_peer_roster is derived from fleet_hosts(); a subject cannot observe its own return, so the mode cannot be offered until an executor host exists to watch from."], "")
      }
    NoResetSubjectRostered =>
      "REFUSED gunbc.fleet_converge_workflow: no host is an admitted reset subject, so the reset_observer choice input would carry zero options. gunbc.host_reset_subject_roster admits a host only when a landed BMC access observation and its capability row admit power control; if that roster is empty the mode has no subject and must not be offered as if it did."
  }
}

fn fleet_converge_yml_after_toolchain_admission() -> FleetConvergeYamlGenerationOutcome {
  match fleet_converge_reset_assignment {
    DispatchAssignmentRefused { cause: c } =>
      FleetConvergeYamlGenerationRefused { reason: fleet_converge_reset_assignment_refusal_reason(cause: c) }
    DispatchAssignment { pairings: ps } =>
      if list_length(ps) == 0 {
        FleetConvergeYamlGenerationRefused {
          reason: "REFUSED gunbc.fleet_converge_workflow: the reset observer assignment admitted no pairing at all, so the reset_observer choice input would carry zero options -- a mode nobody can select. gunbc.host_reset_return reset_dispatch_pairings is supposed to refuse both routes to this state (an empty subject roster, and a subject with no admissible peer); reaching here means a third route exists and it is silent.",
        }
      } else {
        fleet_converge_yml_after_reset_assignment()
      }
  }
}

fn fleet_converge_yml_after_reset_assignment() -> FleetConvergeYamlGenerationOutcome {
  if fleet_converge_build_job_capability_closure_holds() {
    match checked_job_timeout_minutes(computed: gunbc_ci_fleet_job_backstop_timeout_minutes()) {
      JobTimeoutExceedsCeiling { minutes: _, ceiling: _ } =>
        FleetConvergeYamlGenerationRefused { reason: "fleet-converge job backstop timeout exceeds extdeps.github.actions max_job_timeout_minutes — split the job or reduce a tier's per-step budget, do not raise past the platform ceiling (see gunbc_ci_fleet_job_backstop_timeout_note in gunbc.fleet_workflow_steps)" }
      JobTimeoutWithinCeiling { minutes: _ } =>
        FleetConvergeYamlGenerated {
          content: serialize_yaml(v: project_workflow_to_yaml(workflow: fleet_converge_workflow))
        }
    }
  } else {
    FleetConvergeYamlGenerationRefused { reason: fleet_converge_capability_closure_refusal }
  }
}
