// THE CONSOLE RECEIPT IS UPLOADED ON FAILURE TOO, and that is the point of uploading it at all. A
// guest that did not boot wrote the reason to its serial console and nowhere else -- the VM is gone
// and took its journal with it -- so an upload conditioned on success would discard the evidence in
// exactly the case somebody needs it.
fn fleet_converge_microvm_boot_probe_receipt_upload_step() -> Step {
  UsesStep {
    name: Present { value: "Upload runner micro-VM boot probe console receipt" },
    id: Present { value: "microvm_boot_probe_receipt_upload" },
    uses: upload_artifact_action,
    with: Present { value: [
      kv(key: "name", value: yaml_string(s: "runner-microvm-boot-probe")),
      kv(key: "path", value: yaml_string(s: "target/runner-microvm-boot-probe.txt")),
      kv(key: "if-no-files-found", value: yaml_string(s: "error")),
      kv(key: "retention-days", value: yaml_int(n: 30)),
    ] },
    env: none,
    if_condition: Present { value: concat("always() && (", concat(fleet_converge_microvm_boot_probe_step_if, ")")) },
    continue_on_error: none,
    timeout_minutes: Present { value: gunbc_ci_artifact_transfer_step_timeout_minutes }
  }
}

