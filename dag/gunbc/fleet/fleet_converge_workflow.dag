      kv(key: "path", value: yaml_string(s: "target/runner-microvm-boot-probe.txt")),
      kv(key: "if-no-files-found", value: yaml_string(s: "error")),
      kv(key: "retention-days", value: yaml_int(n: 30)),
    ] },
    env: none,
    if_condition: Present { value: concat("always() && (", concat(fleet_converge_microvm_boot_probe_step_if, ")")) },
    continue_on_error: none,
    timeout_minutes: Present { value: gunbc_ci_artifact_transfer_step_timeout_minutes }
  }
}

