// Emitted on-demand fleet converge workflow (operator directive 2026-08-13, sleek-heron-218).
// workflow_dispatch with host=srv1|srv2|srv3|srv4 (executor runner pin) and
// mode includes plan, apply, org_actions_observe, dashboard_deploy, rlm_launch_deployment_receipt, and the spark modes: plan observes the RUNNER
// host; apply downloads a prior plan artifact; org_actions_observe validates the separately held
// org-admin credential and performs only a read/diff; spark_linger runs executor-on-runner → target-on-spark (srv5|srv6) typed argv over
// FleetSsh via run_typed_argv_transport. Replaces the retired 15-minute ctrl-fleet-converge.timer
// cadence on every enrolled CI host (timer install route is TimerRetired fleet-wide). Standalone
// dispatch carries its own build job (release-bins pack/upload) so the converge job never downloads
// an artifact the current run did not produce.
data fleet_converge_enrolled_host_options: List<String> = ["srv1", "srv2", "srv3", "srv4"]

data fleet_converge_spark_target_options: List<String> = ["srv5", "srv6"]

data fleet_converge_mode_options: List<String> = ["plan", "launch_environment_plan", "spark_serving_plan", "allocation_store_plan", "apply", "org_actions_observe", "guest_image_observe", "guest_image_converge", "spark_linger", "spark_observe", "spark_reboot", "spark_grants", "spark_durability", "dashboard_deploy", "rlm_launch_deployment_receipt"]

data fleet_converge_host_runner_expression: String = "${{ fromJSON(format('[\"self-hosted\",\"linux\",\"arm64\",\"{0}\"]', github.event.inputs.host)) }}"

fn gunbc_fleet_converge_build_job_backstop_timeout_minutes() -> Int {
  gunbc_ci_release_build_step_timeout_minutes + gunbc_ci_aux_step_timeout_minutes + gunbc_ci_artifact_transfer_step_timeout_minutes + gunbc_ci_prelude_allowance_minutes
}

// The build job is the prelude plus three steps of its own. The release build CONSUMES cargo; the
// pack and upload steps handle files the build produced and need no toolchain. Annotated here
// rather than in fleet_workflow_steps because these are this job's steps, not the shared prelude's.
fn fleet_converge_build_job_annotations() -> List<CapabilityAnnotatedStep> {
  concat(
    ci_prelude_annotations(),
    [
      CapabilityAnnotatedStep {
        step_name: "Build release binaries",
        role: consumes_only(capabilities: [CargoCapability]),
      },
      CapabilityAnnotatedStep { step_name: "Pack release bins", role: capability_neutral },
      CapabilityAnnotatedStep { step_name: "Upload release bins", role: capability_neutral },
    ],
  )
}

fn fleet_converge_build_job_capability_closure_holds() -> Bool {
  capability_closure_is_closed(
    v: workflow_job_capability_closure(steps: fleet_converge_build_job_annotations()),
  )
}

fn fleet_converge_build_job() -> Job {
  Job {
    id: "build",
    name: none,
    runner: gunbc_ci_runner_spec(),
    steps: concat(
      ci_prelude_steps_with_checkout(checkout: fleet_converge_checkout_step(), exact_head_preflight: []),
      [ci_release_build_step(), ci_release_bins_pack_step(), ci_release_bins_upload_step()],
    ),
    needs: [],
    env: none,
    outputs: none,
    if_condition: none,
    timeout_minutes: Present { value: gunbc_fleet_converge_build_job_backstop_timeout_minutes() },
    continue_on_error: none,
    concurrency: none,
    permissions: none,
  }
}

fn fleet_converge_host_pinned_runner_spec() -> RunnerSpec {
  RunsOnExpression { expression: fleet_converge_host_runner_expression }
}

data fleet_converge_plan_step_if: String = "github.event.inputs.mode == 'plan'"
data fleet_converge_launch_environment_plan_step_if: String = "github.event.inputs.mode == 'launch_environment_plan'"
data fleet_converge_spark_serving_plan_step_if: String = "github.event.inputs.mode == 'spark_serving_plan'"
data fleet_converge_allocation_store_plan_step_if: String = "github.event.inputs.mode == 'allocation_store_plan'"
data fleet_converge_any_plan_step_if: String = "github.event.inputs.mode == 'plan' || github.event.inputs.mode == 'launch_environment_plan' || github.event.inputs.mode == 'spark_serving_plan' || github.event.inputs.mode == 'allocation_store_plan'"
data fleet_converge_apply_step_if: String = "github.event.inputs.mode == 'apply'"
data fleet_converge_org_actions_step_if: String = "github.event.inputs.mode == 'org_actions_observe'"
// THE TWO MICRO-VM MODES ARE HOST-PINNED FOR THE SAME REASON EVERY MODE IN THIS WORKFLOW IS: the
// image is built on the host that will boot it, out of an install root that host owns, so the
// question "which host" is not a parameter of the operation but its subject.
data fleet_converge_guest_image_observe_step_if: String = "github.event.inputs.mode == 'guest_image_observe'"

data fleet_converge_guest_image_converge_step_if: String = "github.event.inputs.mode == 'guest_image_converge'"

data fleet_converge_guest_image_any_step_if: String = "github.event.inputs.mode == 'guest_image_observe' || github.event.inputs.mode == 'guest_image_converge'"

data fleet_converge_spark_linger_step_if: String = "github.event.inputs.mode == 'spark_linger'"

data fleet_converge_spark_observe_step_if: String = "github.event.inputs.mode == 'spark_observe'"

data fleet_converge_spark_reboot_step_if: String = "github.event.inputs.mode == 'spark_reboot'"

data fleet_converge_spark_durability_step_if: String = "github.event.inputs.mode == 'spark_durability'"

data fleet_converge_spark_grants_step_if: String = "github.event.inputs.mode == 'spark_grants'"

data fleet_converge_dashboard_deploy_step_if: String = "github.event.inputs.mode == 'dashboard_deploy'"

data fleet_converge_rlm_receipt_step_if: String = "github.event.inputs.mode == 'rlm_launch_deployment_receipt'"

fn fleet_converge_plan_upload_step() -> Step {
  UsesStep {
    name: Present { value: "Upload fleet converge plan artifact" },
    id: Present { value: "plan_upload" },
    uses: upload_artifact_action,
    with: Present {
      value: [
        kv(key: "name", value: yaml_string(s: gunbc_fleet_converge_plan_artifact_name)),
        kv(key: "path", value: yaml_string(s: fleet_converge_plan_artifact_dir)),
        kv(key: "if-no-files-found", value: yaml_string(s: "error")),
        kv(key: "retention-days", value: yaml_int(n: 30)),
        kv(key: "compression-level", value: yaml_int(n: 0)),
      ]
    },
    env: none,
    if_condition: Present { value: fleet_converge_any_plan_step_if },
    continue_on_error: none,
    timeout_minutes: Present { value: gunbc_ci_artifact_transfer_step_timeout_minutes }
  }
}

fn fleet_converge_plan_download_step() -> Step {
  UsesStep {
    name: Present { value: "Download fleet converge plan artifact" },
    id: Present { value: "plan_download" },
    uses: download_artifact_action,
    with: Present {
      value: [
        kv(key: "name", value: yaml_string(s: gunbc_fleet_converge_plan_artifact_name)),
        kv(key: "path", value: yaml_string(s: fleet_converge_plan_artifact_dir)),
        kv(key: "github-token", value: yaml_string(s: "${{ secrets.GITHUB_TOKEN }}")),
        kv(key: "run-id", value: yaml_string(s: "${{ github.event.inputs.plan_workflow_run_id }}")),
      ]
    },
    env: none,
    if_condition: Present { value: fleet_converge_apply_step_if },
    continue_on_error: none,
    timeout_minutes: Present { value: gunbc_ci_artifact_transfer_step_timeout_minutes }
  }
}

fn fleet_converge_plan_step() -> Step {
  RunStep {
    name: Present { value: "Fleet converge plan (membership_reconcile → artifact)" },
    id: Present { value: "plan" },
    run: gunbc_ci_fleet_converge_plan_invoke(),
    shell: none,
    env: Present {
      value: [
        kv(key: fleet_converge_expected_host_env_name, value: yaml_string(s: "${{ github.event.inputs.host }}")),
        kv(key: rlm_expected_revision_env_name, value: yaml_string(s: "${{ github.event.inputs.expected_revision }}")),
      ]
    },
    working_directory: none,
    if_condition: Present { value: fleet_converge_plan_step_if },
    continue_on_error: none,
    timeout_minutes: Present { value: gunbc_ci_aux_step_timeout_minutes }
  }
}

// THE LAUNCH-ENVIRONMENT PLAN CARRIES THE SAME TWO ENV ROWS AS THE FULL-HOST PLAN because it mints
// the same run-bound plan receipt: RLM-2's join pairs a plan receipt with an apply receipt at one
// expected revision, and a plan mode that skipped the expected-host or expected-revision binding
// would produce a receipt naming a revision nobody selected.
fn fleet_converge_launch_environment_plan_step() -> Step {
  RunStep {
    name: Present { value: "Fleet converge plan — scope:launch-environment (legacy fleet-converge timer retirement)" },
    id: Present { value: "launch_environment_plan" },
    run: gunbc_ci_fleet_converge_launch_environment_plan_invoke(),
    shell: none,
    env: Present {
      value: [
        kv(key: fleet_converge_expected_host_env_name, value: yaml_string(s: "${{ github.event.inputs.host }}")),
        kv(key: rlm_expected_revision_env_name, value: yaml_string(s: "${{ github.event.inputs.expected_revision }}")),
      ]
    },
    working_directory: none,
    if_condition: Present { value: fleet_converge_launch_environment_plan_step_if },
    continue_on_error: none,
    timeout_minutes: Present { value: gunbc_ci_aux_step_timeout_minutes }
  }
}

// THE SPARK PLAN STEP CARRIES THE TWO RLM ENV ROWS AND THE TARGET. The first two bind the run to the
// executor and the revision like every other plan; the third names the subject, because a Spark plan
// is minted on srv1..srv4 about srv5 or srv6, and apply later reads that subject off the artifact
// rather than off the environment.
fn fleet_converge_spark_serving_plan_step() -> Step {
  RunStep {
    name: Present { value: "Fleet converge plan — scope:spark-serving (executor→target FleetSsh observation, typed rows frozen in the bundle)" },
    id: Present { value: "spark_serving_plan" },
    run: gunbc_ci_fleet_converge_spark_serving_plan_invoke(),
    shell: none,
    env: Present {
      value: [
        kv(key: fleet_converge_expected_host_env_name, value: yaml_string(s: "${{ github.event.inputs.host }}")),
        kv(key: rlm_expected_revision_env_name, value: yaml_string(s: "${{ github.event.inputs.expected_revision }}")),
        kv(key: "SPARK_CONVERGE_TARGET", value: yaml_string(s: "${{ github.event.inputs.target }}")),
      ]
    },
    working_directory: none,
    if_condition: Present { value: fleet_converge_spark_serving_plan_step_if },
    continue_on_error: none,
    timeout_minutes: Present { value: gunbc_ci_spark_serving_step_timeout_minutes }
  }
}

fn fleet_converge_allocation_store_plan_step() -> Step {
  RunStep {
    name: Present { value: "Fleet allocation-store substrate plan" },
    id: Present { value: "allocation_store_plan" },
    run: gunbc_ci_fleet_converge_allocation_store_plan_invoke(),
