// Emitted on-demand fleet converge workflow (operator directive 2026-08-13, sleek-heron-218).
// workflow_dispatch with host=srv1|srv2|srv3|srv4 (executor runner pin) and
// mode includes plan, apply, org_actions_observe, dashboard_deploy, rlm_launch_deployment_receipt, and the spark modes: plan observes the RUNNER
// host; apply downloads a prior plan artifact; org_actions_observe validates the separately held
// org-admin credential and performs only a read/diff; spark_serving_apply applies the promoted
// fabric groups' vLLM units over the password session, workers before heads. Replaces the retired 15-minute ctrl-fleet-converge.timer
// cadence on every enrolled CI host (timer install route is TimerRetired fleet-wide). Standalone
// dispatch carries its own build job (release-bins pack/upload) so the converge job never downloads
// an artifact the current run did not produce.
// THE ENROLLED HOST CHOICES ARE DERIVED, NOT SPELLED, for the reason the Spark target list beside
// this one already records. The literal that stood here was gunbc.fleet_runner_connectivity
// fleet_hosts() written out a second time -- a §3 fork that happened to agree, which is the only
// state in which a fork is cheap to remove. It is now the same list its consumers fold as the
// eligible executor set, so enrolling or retiring an executor host moves this input with it and
// nobody can dispatch against a host the fleet does not think it has. Each option is the host's
// runner label (gunbc.runner_slot_allocation runner_host_label), the same projection its runners
// register under, because fleet_converge_host_runner_expression interpolates the chosen option into
// runs-on verbatim.
data fleet_converge_enrolled_host_options: List<String> = map(fleet_hosts(), h => runner_host_label(host: h))

// THE TARGET CHOICES ARE THE ROSTERED SPARKS, DERIVED, NOT SPELLED. The literal pair here refused the
// first bootstrap dispatch against srv7 with an HTTP 422 from GitHub -- the workflow admitted two of
// seven enrolled units because the list was typed when there were two. The choice list is now the
// administrator credential roster (gunbc.spark.credential_workflow), which is itself an identity join
// with procurement, so enrolling a Spark makes it dispatchable and nothing else can.
data fleet_converge_spark_target_options: List<String> = map(spark_administrator_credential_roster_hosts(), h => h as String)

// ONE NAME PER MODE, SPELLED ONCE. The dispatch options and every `if:` expression that selects on
// them used to spell every mode name independently: once as a bare String in the options
// list, and again inside each hand-written "github.event.inputs.mode == '<name>'". Seventeen such
// rows, so a mode's name was authored at least twice and a rename could land in one place and not
// the other -- the second naming account section 3 refuses, in a shape no lens could see because
// both halves are ordinary Strings.
//
// The wire form is now derived from the closed vocabulary, and the expressions are derived from the
// wire form, so the name exists in exactly one place.
type FleetConvergeWorkflowMode
  = FullHostPlan
  | LaunchEnvironmentPlan
  | AllocationStorePlan
  | FleetApply
  | OrgActionsObserve
  | AppControlPlaneObserve
  | MicrovmHostConverge
  | GuestImageObserve
  | GuestImageConverge
  | MicrovmBootProbe
  | SparkGrants
  | SparkBootstrap
  | SparkServingApply
  | SparkNativeServingApply
  | SparkRuntimeImageProbe
  | DashboardDeploy
  | RlmLaunchDeploymentReceipt
  | HostResetReturn
  | RunnerHostFileObserve
  | RunnerHostFileConverge
  | SitePxeEdgeObserve
  | SitePxeEdgeConverge
  | RunnerPasswordSessionToolConverge
  | R2MintPreflight
  | R2ObjectWriteMint
  | ApprovalKeyringConverge
  | MtCollins1Boot
  | MtCollins1FanObserve
  | OrgRunnerRosterObserve

fn fleet_converge_workflow_mode_wire(mode: FleetConvergeWorkflowMode) -> String {
  match mode {
    FullHostPlan => "plan"
    LaunchEnvironmentPlan => "launch_environment_plan"
    AllocationStorePlan => "allocation_store_plan"
    FleetApply => "apply"
    OrgActionsObserve => "org_actions_observe"
    AppControlPlaneObserve => "app_control_plane_observe"
    MicrovmHostConverge => "microvm_host_converge"
    GuestImageObserve => "guest_image_observe"
    GuestImageConverge => "guest_image_converge"
    MicrovmBootProbe => "microvm_boot_probe"
    SparkGrants => "spark_grants"
    SparkBootstrap => "spark_bootstrap"
    SparkServingApply => "spark_serving_apply"
    SparkNativeServingApply => "spark_native_serving_apply"
    SparkRuntimeImageProbe => "spark_runtime_image_probe"
    DashboardDeploy => "dashboard_deploy"
    RlmLaunchDeploymentReceipt => "rlm_launch_deployment_receipt"
    HostResetReturn => "host_reset_return"
    RunnerHostFileObserve => "runner_host_file_observe"
    RunnerHostFileConverge => "runner_host_file_converge"
    SitePxeEdgeObserve => "site_pxe_edge_observe"
    SitePxeEdgeConverge => "site_pxe_edge_converge"
    RunnerPasswordSessionToolConverge => "runner_password_session_tool_converge"
    R2MintPreflight => "r2_mint_preflight"
    R2ObjectWriteMint => "r2_object_write_mint"
    ApprovalKeyringConverge => "approval_keyring_converge"
    MtCollins1Boot => "mtcollins1_boot"
    MtCollins1FanObserve => "mtcollins1_fan_observe"
    OrgRunnerRosterObserve => "org_runner_roster_observe"
  }
}

// THE ROSTER RE-ENUMERATES THE COPRODUCT, and that is a known stall rather than an oversight
// (gunbc.guarantee_stall.roster_re_enumerates_its_own_rows_stall): nothing reflects over a closed
// vocabulary to produce its members, so the dispatch options need a hand-written order. What the
// roster CANNOT get wrong any more is a member's NAME -- that comes from the wire function -- and a
// member missing from this list is missing from the dispatch menu, which is visible, rather than
// silently misspelled, which was not.
// THE HOST LIST IN THE DISPATCH MENU IS DERIVED, BECAUSE THE SPELLED ONE HAD ALREADY ROTTED. This
// description read "any rostered Spark, srv5..srv11" while the roster it describes --
// gunbc.spark.credential_workflow's administrator roster, which is what
// spark_converge_target_selection actually resolves against -- carries srv5 through srv12. A
// dispatcher reading the menu would have believed srv12 was not a legal target; the resolution would
// have accepted it. That is the §3 positional-citation decay in prose: a second spelling of a roster,
// invalidated by an edit somewhere else, with nothing to catch it. It is now joined from the roster.
fn fleet_converge_spark_target_description() -> String {
  join([
    "Spark target host for the spark_* modes, naming the administrator credential the run materializes (any rostered Spark: ",
    join(map(spark_administrator_credential_roster_hosts(), h => h as String), ", "),
    "); apply reads the subject off the plan artifact",
  ], "")
}

data fleet_converge_workflow_modes: List<FleetConvergeWorkflowMode> = [FullHostPlan, LaunchEnvironmentPlan, AllocationStorePlan, FleetApply, OrgActionsObserve, AppControlPlaneObserve, MicrovmHostConverge, GuestImageObserve, GuestImageConverge, MicrovmBootProbe, SparkGrants, SparkBootstrap, SparkServingApply, SparkNativeServingApply, SparkRuntimeImageProbe, DashboardDeploy, RlmLaunchDeploymentReceipt, HostResetReturn, RunnerHostFileObserve, RunnerHostFileConverge, SitePxeEdgeObserve, SitePxeEdgeConverge, RunnerPasswordSessionToolConverge, R2MintPreflight, R2ObjectWriteMint, OrgRunnerRosterObserve, ApprovalKeyringConverge, MtCollins1Boot, MtCollins1FanObserve]

// WHICH SCOPE A MODE SELECTS, WHERE IT SELECTS ONE AT ALL.
//
// EVERY MODE IS NAMED, AND THE WILDCARD IS DELIBERATELY ABSENT. A `_ => none` would read the same
// today and undo the totality this vocabulary exists for: the sixteenth mode would silently inherit
// "no scope" instead of forcing this projection to decide what it means. Each arm below is a
// decision someone made.
//
// WHAT `none` DOES AND DOES NOT SAY, stated because the distinction is NOT in the return type.
// Optional carries one absence, and two different facts land on it here: a mode that is inherently
// outside fleet convergence (the spark, micro-VM and guest-image modes select other subjects
// entirely), and a mode that belongs in this projection but whose production dispatch does not yet
// call this function. DashboardDeploy is the second case: this cut maps it to LiveDeploy so C4
// can route when that job's dispatch surface moves. Until C4 consumes this function, the only
// executing reader is workflow_dispatch_input_witness_test — a declared frontier, not a silent
// residue. Deleting it here would remove the carrier C4 needs.
//
// THIS FUNCTION HAS NO PRODUCTION CALLER TODAY. Production dashboard_deploy reaches
// live_deploy_apply_srv1_transaction_wet, not this mapping and not observe_fleet_converge_request_wet.
// Wet observe still cannot mint LiveDeployConverge from a hostname; that arm is constructed
// from DesiredDeployment.selected_identity plus LiveDeployMemberBasis.
fn fleet_converge_mode_scope(mode: FleetConvergeWorkflowMode) -> FleetConvergeScope? {
  match mode {
    FullHostPlan => Present { value: FullHost }
    LaunchEnvironmentPlan => Present { value: LaunchEnvironment }
    AllocationStorePlan => Present { value: FabricAllocationStoreOnly }
    FleetApply => none
    OrgActionsObserve => none
    AppControlPlaneObserve => none
    MicrovmHostConverge => none
    GuestImageObserve => none
    GuestImageConverge => none
    MicrovmBootProbe => none
    SparkGrants => none
    SparkBootstrap => none
    SparkServingApply => none
    SparkNativeServingApply => none
    SparkRuntimeImageProbe => none
    DashboardDeploy => Present { value: LiveDeploy }
    RlmLaunchDeploymentReceipt => none
    HostResetReturn => none
    RunnerHostFileObserve => none
    RunnerHostFileConverge => none
    SitePxeEdgeObserve => none
    SitePxeEdgeConverge => none
    RunnerPasswordSessionToolConverge => none
    R2MintPreflight => none
    R2ObjectWriteMint => none
    ApprovalKeyringConverge => none
    MtCollins1Boot => none
    MtCollins1FanObserve => none
    OrgRunnerRosterObserve => none
  }
}

fn fleet_converge_mode_step_if(mode: FleetConvergeWorkflowMode) -> String {
  join(["github.event.inputs.mode == '", fleet_converge_workflow_mode_wire(mode: mode), "'"], "")
}

fn fleet_converge_any_mode_step_if(modes: List<FleetConvergeWorkflowMode>) -> String {
  join(map(modes, m => fleet_converge_mode_step_if(mode: m)), " || ")
}

// WHICH MODES CONSUME HOST SSH AUTHORITY is declared per mode, exhaustively, so a new mode cannot
// inherit the fleet key by omission. The fleet-converge job materializes the fleet key only for a
// dispatch whose mode consumes it: an API-only read (the org credential observe and the org runner
// roster read, both of which reach GitHub over gh and open no host session) must not hold host SSH
// authority it never uses. Three modes are established as not consuming it: the two API-only reads,
// and the Mt. Collins boot, whose route is BMC/IPMI, SOL and HTTP approval submission with no fleet
// SSH operation. Every mode that predates this declaration keeps the key it held before, which is
// the status quo rather than a finding that it needs it; a mode added AFTER it has no prior standing
// to keep, so its arm is derived from its operation route (the approval keyring converge executes
// over fleet SSH to srv1 and consumes it).
type FleetSshKeyDemand = FleetSshKeyConsumed | FleetSshKeyNotConsumed

fn fleet_converge_mode_fleet_ssh_key_demand(mode: FleetConvergeWorkflowMode) -> FleetSshKeyDemand {
  match mode {
    OrgActionsObserve => FleetSshKeyNotConsumed
    OrgRunnerRosterObserve => FleetSshKeyNotConsumed
    FullHostPlan => FleetSshKeyConsumed
    LaunchEnvironmentPlan => FleetSshKeyConsumed
    AllocationStorePlan => FleetSshKeyConsumed
    FleetApply => FleetSshKeyConsumed
    AppControlPlaneObserve => FleetSshKeyConsumed
    MicrovmHostConverge => FleetSshKeyConsumed
    GuestImageObserve => FleetSshKeyConsumed
    GuestImageConverge => FleetSshKeyConsumed
    MicrovmBootProbe => FleetSshKeyConsumed
    SparkGrants => FleetSshKeyConsumed
    SparkBootstrap => FleetSshKeyConsumed
    SparkServingApply => FleetSshKeyConsumed
    SparkNativeServingApply => FleetSshKeyConsumed
    SparkRuntimeImageProbe => FleetSshKeyConsumed
    DashboardDeploy => FleetSshKeyConsumed
    RlmLaunchDeploymentReceipt => FleetSshKeyConsumed
    HostResetReturn => FleetSshKeyConsumed
    RunnerHostFileObserve => FleetSshKeyConsumed
    RunnerHostFileConverge => FleetSshKeyConsumed
    SitePxeEdgeObserve => FleetSshKeyConsumed
    SitePxeEdgeConverge => FleetSshKeyConsumed
    RunnerPasswordSessionToolConverge => FleetSshKeyConsumed
    R2MintPreflight => FleetSshKeyConsumed
    R2ObjectWriteMint => FleetSshKeyConsumed
    ApprovalKeyringConverge => FleetSshKeyConsumed
    MtCollins1Boot => FleetSshKeyNotConsumed
    MtCollins1FanObserve => FleetSshKeyNotConsumed
  }
}

fn fleet_ssh_key_demand_consumed(d: FleetSshKeyDemand) -> Bool {
  match d {
    FleetSshKeyConsumed => true
    FleetSshKeyNotConsumed => false
  }
}

data fleet_converge_fleet_ssh_key_modes: List<FleetConvergeWorkflowMode> = filter(fleet_converge_workflow_modes, m => fleet_ssh_key_demand_consumed(d: fleet_converge_mode_fleet_ssh_key_demand(mode: m)))

data fleet_converge_fleet_ssh_key_step_if: String = fleet_converge_any_mode_step_if(modes: fleet_converge_fleet_ssh_key_modes)

data fleet_converge_mode_options: List<String> = map(fleet_converge_workflow_modes, m => fleet_converge_workflow_mode_wire(mode: m))


// ── the host reset-return mode ─────────────────────────────────────────────────────────────────

// THIS MODE CANNOT LIVE IN THE HOST-PINNED JOB, AND THAT IS THE WHOLE REASON IT HAS ITS OWN. Every
// other host-scoped mode is an if-gated step inside `fleet-converge`, whose runner is
// fleet_converge_host_pinned_runner_spec() -- pinned to a runner ON the selected host. A job running
// on the host it is resetting dies at the reset and cannot observe the return; worse, whatever it
// wrote before dying is exactly the empty value that would then read as a positive answer.
//
// AND A SEPARATE JOB IS NECESSARY BUT NOT SUFFICIENT. gunbc_ci_runner_spec() is the shared
// self-hosted arm64 pool, and the subject IS a self-hosted arm64 machine, so an unpinned observer can
// land on its subject by ordinary scheduling.
//
// SO THE INPUT IS INVERTED: the dispatch field carries the OBSERVER label, runs-on consumes it
// directly, and the SUBJECT is not a dispatch field at all -- gunbc.host_reset_return_run reads the
// CARRIED LABEL back out of the environment and looks it up in the assignment below. The invalid
// pairing is not rejected downstream; there is no form field in which to state it.
//
// NOT FROM THE MACHINE IT IS RUNNING ON, which is what this paragraph said until review 61989 caught
// it -- the collapsed design review 61761 had already removed from the code, left standing in the
// prose beside it. Keying the entry on `hostname -s` made the label that decided WHERE the job ran
// and the name the machine ANSWERS TO one reading, so a mislabelled or unconverged runner failed the
// assignment lookup and never reached the identity check; the walls were then fixture-only on the
// production route. The entry now refuses rather than falling back to its own hostname, and the
// hostname is the independent second reading that must agree. A stale account of that is not a
// wording slip: it is one fact with two incompatible spellings (DESIGN section 3's meaning fork), and
// the one a later worker would most plausibly act on is the one that disarms the corroboration.
// gunbc.host_reset_return carries the full argument, above reset_return_verdict_of_mint.
data fleet_converge_reset_assignment: ResetDispatchAssignment = reset_dispatch_pairings(
  subject_roster: reset_subject_roster(),
  peer_roster: reset_observer_peer_roster(),
)

// THE OPTION LIST IS DERIVED FROM THE ASSIGNMENT. The empty list is never serialized, and the reason
// is the assignment rather than this row: reset_dispatch_pairings refuses an empty subject roster and
// constructs NoPeerAvailable for a subject with no admissible peer, so an empty pairings list is not
// a reachable DispatchAssignment. An earlier version of this note claimed the GATE caught the empty
// case, which was false -- an empty pairings list is DispatchAssignment, not DispatchAssignmentRefused,
// so the gate passed and a choice input with zero options would have been serialized. The gate now
// also refuses an empty list, which is the belt to the assignment's braces rather than the mechanism.
data fleet_converge_reset_observer_options: List<String> = match fleet_converge_reset_assignment {
  DispatchAssignment { pairings: ps } => reset_dispatch_observer_labels(pairings: ps)
  DispatchAssignmentRefused { cause: _ } => []
}

// THE RESET JOB BELONGS TO ITS SUBJECT'S MUTATION DOMAIN, NOT ITS OBSERVER'S, and it landed in
// neither until review 62030. gunbc.fleet_workflow_steps
// fleet_host_mutation_concurrency_group_expression states the rule -- ONE MUTATION DOMAIN PER HOST,
// SHARED BY EVERY JOB THAT CONVERGES OR READS BACK THAT HOST (RLM-2 ruling section 9) -- and the
// reason it gives is this mode's exact subject: a readback observing another transaction's mutation.
// This is the most mutating job in the workflow, because it power-cycles a physical machine, and it
// was the only host-touching one carrying no group at all. A section 3b divergence in the
// leasing/locking domain with no stated reason, which is the only red that section admits.
//
// THE FABRICATION IT ADMITS IS THE ONE THIS MODULE EXISTS TO REFUSE. Two dispatches naming different
// observers can resolve to the SAME subject; B's power cycle then lands inside A's watch window, and
// A mints HostObservedDownThenBack for a return it did not cause. The pre-issuance baseline cannot
// see it, because B issues while the subject is still up during A's handoff -- so the reading arrives
// through the one route SubjectNotUpBeforeIssuance is blind to, and a receipt would carry a measured
// downtime for someone else's reboot.
//
// THE GROUP KEYS ON THE SUBJECT, WHICH THE DISPATCH DOES NOT CARRY, so the observer-to-subject map is
// emitted from the same assignment the option list comes from and indexed by the dispatch input. It
// is derived rather than spelled: a pairing this mint refused cannot appear in it, and an observer
// absent from the map yields an empty subject, which cannot collide with a real host's domain.
// THE MAP GOES THROUGH THE JSON EMITTER, NOT THROUGH concat. It hand-built the object with string
// literals until review 62097, which is the medium-as-string shape and a section 2 re-invention: the
// authority already exists at extdeps.languages.json.emit, and this module already consumes its YAML
// sibling, so reaching for the JSON one is the same move rather than a new dependency.
//
// THE CONCRETE FAILURE IT REMOVES IS NOT HYPOTHETICAL IN SHAPE. Quoting and escaping were unmodeled,
// and nothing in NonEmptyStr or HostIdentity forbids a label carrying a quote or a backslash. Such a
// label emitted malformed JSON, fromJSON failed at JOB-SETUP time before any step existed, and the
// reset job died with no receipt and no upload -- the same silent-stall class this workflow's own
// dispatch-admission gate was added to close, reintroduced one function away from it by the fix.
// serialize_json escapes through escape_json_string, so the emitter owns that fact and this row does
// not restate it.
// TAKING THE PAIRINGS AS AN ARGUMENT IS WHAT MAKES THE ESCAPING CHECK AUTHORABLE. Reading the module
// data row directly left no way to hand this function a hostile label, so a witness could only have
// restated what the emitter does -- permanently green by construction, which section 4b calls a
// decoration and worse than absent. Split so the fold is exercisable and the data row is one call.
fn reset_subject_map_json(pairings: List<ResetObserverPairing>) -> String {
  serialize_json(
    v: json_object(
      members: map(pairings, pr => json_kv(key: pr.observer as String, value: json_string(s: pr.subject as String))),
    ),
  )
}

fn fleet_converge_reset_subject_map_json() -> String {
  match fleet_converge_reset_assignment {
    DispatchAssignmentRefused { cause: _ } => reset_subject_map_json(pairings: [])
    DispatchAssignment { pairings: ps } => reset_subject_map_json(pairings: ps)
  }
}

// WHAT THIS DOES NOT COVER, STATED BECAUSE A CONCURRENCY GROUP IS EXACTLY THE ARTIFACT A LATER READER
// CITES AS THE SERIALIZATION AUTHORITY. GitHub admits ONE group per job, and this job needs two
// domains: the SUBJECT's, because it reboots that machine, and the OBSERVER's, because a
// mode=apply or dashboard_deploy dispatch naming the observer can reboot the watcher mid-watch. The
// subject's is the one taken, because a fabricated down-then-back reading is a WRONG RECEIPT while a
// rebooted observer is a LOST one -- the watch dies with the runner and the upload never happens, so
// that failure is loud and this one would not have been.
//
// THE RESIDUAL IS THE OBSERVER SIDE AND IT IS NOT CLOSABLE HERE. Its trigger is already named one
// module over: gunbc.fleet_workflow_steps records that the host lease exists and is witnessed and
// that this workflow does not yet acquire it, and a lease can hold two hosts where a group holds one.
// Binding the mutating ingresses to that lease closes the observer side and this row becomes belt
// rather than braces; until then the observer exposure is real and undefended, and saying so is the
// difference between a declared gap and the silent one review 62030 found.
data fleet_converge_reset_subject_mutation_concurrency_group_expression: String = join([
  fleet_host_mutation_group_prefix, "${{ fromJSON('",
  fleet_converge_reset_subject_map_json(),
  "')[github.event.inputs.reset_observer] }}",
], "")

data fleet_converge_reset_observer_runner_expression: String = "${{ fromJSON(format('[\"self-hosted\",\"linux\",\"arm64\",\"{0}\"]', github.event.inputs.reset_observer)) }}"

fn fleet_converge_reset_observer_runner_spec() -> RunnerSpec {
  RunsOnExpression { expression: fleet_converge_reset_observer_runner_expression }
}

data fleet_converge_host_reset_return_step_if: String = fleet_converge_mode_step_if(mode: HostResetReturn)

// THE JOB'S OWN if GATE, not just the step's. A job whose only step is skipped still occupies a
// runner on the observer host for the length of a checkout and a build download, which is a standing
// cost on every dispatch of every other mode.
fn fleet_converge_host_reset_return_job() -> Job {
  Job {
    id: "host-reset-return",
    name: none,
    runner: fleet_converge_reset_observer_runner_spec(),
    steps: concat(
      concat(
        fleet_converge_consumer_prelude_steps(),
        [ci_release_bins_download_step(), ci_release_bins_unpack_verify_step()]
      ),
      [fleet_converge_host_reset_return_step(), fleet_converge_host_reset_return_receipt_upload_step()]
    ),
    needs: ["build"],
    env: none,
    outputs: none,
    if_condition: Present { value: fleet_converge_host_reset_return_step_if },
    timeout_minutes: Present { value: gunbc_ci_fleet_job_backstop_timeout_minutes() },
    continue_on_error: none,
    concurrency: Present {
      value: ConcurrencyMappingQueueNotMax {
        group: fleet_converge_reset_subject_mutation_concurrency_group_expression,
        cancel_in_progress: Present { value: CancelInProgressBool { value: false } },
        explicit_single: none
      }
    },
    permissions: none,
  }
}

// THE OBSERVER LABEL IS HANDED TO THE PROCESS, and the step's env row is the only route it has:
// gunbc_run_command carries no --arg, so a converge step passes a value to an entry through the
// environment or not at all. Carrying it matters because the entry must NOT re-derive its own
// label from its hostname -- that would make the label and the machine one reading and disarm
// the corroboration between them, which is what review 61761 found.
fn fleet_converge_host_reset_return_step() -> Step {
  RunStep {
    name: Present { value: "Host reset-return: drive the subject through its controller and measure the return from a peer" },
    id: Present { value: "host_reset_return" },
    run: gunbc_ci_host_reset_return_invoke(),
    shell: none,
    env: Present {
      value: [kv(key: host_reset_observer_label_env as String, value: yaml_string(s: "${{ github.event.inputs.reset_observer }}"))]
    },
    working_directory: none,
    if_condition: Present { value: fleet_converge_host_reset_return_step_if },
    continue_on_error: none,
    timeout_minutes: Present { value: gunbc_ci_runner_guest_image_step_timeout_minutes }
  }
}

// THE RECEIPT IS UPLOADED ON FAILURE TOO, for the reason the boot-probe receipt beside it is: the
// refused case is the one somebody needs to read, and an upload conditioned on success discards the
// evidence exactly then.
fn fleet_converge_host_reset_return_receipt_upload_step() -> Step {
  UsesStep {
    name: Present { value: "Upload host reset-return attempt receipt" },
    id: Present { value: "host_reset_return_receipt_upload" },
    uses: upload_artifact_action,
    with: Present { value: [
      kv(key: "name", value: yaml_string(s: "host-reset-return")),
      kv(key: "path", value: yaml_string(s: host_reset_return_receipt_path as String)),
      kv(key: "if-no-files-found", value: yaml_string(s: "error")),
      kv(key: "retention-days", value: yaml_int(n: 30)),
    ] },
    env: none,
    if_condition: Present { value: concat("always() && (", concat(fleet_converge_host_reset_return_step_if, ")")) },
    continue_on_error: none,
    timeout_minutes: Present { value: gunbc_ci_artifact_transfer_step_timeout_minutes }
  }
}

data fleet_converge_host_runner_expression: String = "${{ fromJSON(format('[\"self-hosted\",\"linux\",\"arm64\",\"{0}\"]', github.event.inputs.host)) }}"

// THE BACKSTOP NOW DERIVES FROM THE STEPS IT GUARDS, rather than restating their budgets in a
// hand-kept sum. It was such a sum, and review 61958 found what that costs: this change inserted a
// fourth step into the build job carrying its own five-minute budget and did not add a term, so the
// job backstop could fire while every step was still inside its declared budget -- a timeout that no
// longer derives the job it guards, and one that reads as a hung build rather than as a miscount.
//
// A SUM OVER THE STEP LIST CANNOT MISS A STEP, which is the point: the invalid state is not caught by
// a check, it stops being writable, because adding a step to fleet_converge_build_job_steps() is the
// same act as adding its budget. The step list is bound once here and consumed by both the job and
// this sum, so the two cannot disagree; a step with no declared budget contributes nothing and is
// visible as such rather than silently costing the prelude allowance.
fn fleet_converge_build_job_steps() -> List<Step> {
  concat(
    ci_prelude_steps_with_checkout(checkout: fleet_converge_checkout_step(), exact_head_preflight: []),
    [
      ci_release_build_step(),
      fleet_converge_reset_observer_dispatch_admission_step(),
      ci_release_bins_pack_step(),
      ci_release_bins_upload_step(),
    ],
  )
}

fn step_declared_timeout_minutes(st: Step) -> Int {
  match st {
    RunStep { name: _, id: _, run: _, shell: _, env: _, working_directory: _, if_condition: _, continue_on_error: _, timeout_minutes: tm } =>
      match tm { Present { value: v } => v  Absent => 0 }
    UsesStep { name: _, id: _, uses: _, with: _, env: _, if_condition: _, continue_on_error: _, timeout_minutes: tm } =>
      match tm { Present { value: v } => v  Absent => 0 }
  }
}

fn gunbc_fleet_converge_build_job_backstop_timeout_minutes() -> Int {
  fold(
    fleet_converge_build_job_steps(),
    init: gunbc_ci_prelude_allowance_minutes,
    f: (acc, st) => acc + step_declared_timeout_minutes(st: st),
  )
}

// The build job is the prelude plus four steps of its own. The dispatch admission gate reads two
// dispatch inputs and touches nothing else; the release build CONSUMES cargo; the pack and upload
// steps handle files the build produced and need no toolchain. Annotated here
// rather than in fleet_workflow_steps because these are this job's steps, not the shared prelude's.
fn fleet_converge_build_job_annotations() -> List<CapabilityAnnotatedStep> {
  concat(
    ci_prelude_annotations(),
    [
      CapabilityAnnotatedStep {
        step_name: "Build release binaries",
        role: consumes_only(capabilities: [CargoCapability]),
      },
      CapabilityAnnotatedStep {
        step_name: "Reset-return dispatch admission: refuse an unnamed observer before anything is scheduled",
        role: capability_neutral,
      },
      CapabilityAnnotatedStep { step_name: "Pack release bins", role: capability_neutral },
      CapabilityAnnotatedStep { step_name: "Upload release bins", role: capability_neutral },
    ],
  )
}

fn fleet_converge_build_job_capability_closure_holds() -> Bool {
  capability_closure_is_closed(
    v: workflow_job_capability_closure(steps: fleet_converge_build_job_annotations()),
  )
}

// THE ONE PAIRING STATE REACHABLE AT DISPATCH TIME, REFUSED WHERE IT CAN STILL BE HEARD. Review 61950
// found the hole: reset_observer is required:false because it is meaningful for exactly one mode, and
// its value is interpolated into the reset job's runs-on. A dispatch of mode=host_reset_return that
// omits it -- which an API or `gh workflow run` dispatch does by supplying "" -- passes the job's if:
// gate and asks for labels ["self-hosted","linux","arm64",""]. No runner carries an empty label, so
// the job QUEUES until the 105-minute backstop and then dies with no diagnostic, no receipt and no
// upload; the upload step never runs, so not even its if-no-files-found: error fires.
//
// WHY THE CHECK CANNOT LIVE IN THE RESET JOB. runs-on is resolved before any step of that job exists,
// so a refusal step inside it is unreachable in precisely the state it would diagnose. The build job
// is this workflow's only always-schedulable job -- generic labels, no interpolation -- and every
// host-scoped job needs it, so a refusal here stops the line before anything is scheduled.
//
// IT IS A MODELED ENTRY AND NOT A HAND-SHELL GATE, WHICH IS THE SECOND VERSION OF THIS STEP. The
// first was a concat-built `run:` carrying a net-new dissolution obligation and no operator verdict,
// which the scaffold-admission doctrine calls a hard reject -- and the doctrine's own test decided
// it rather than any judgement of mine: the modeled route existed, so the scaffold bought nothing
// but authoring, review, maintenance, deletion and review of the deletion. The obligation is gone
// with the shell; there is no marker here because there is no debt to mark.
//
// THE COST OF DOING IT MODELED, STATED SO NOBODY REDISCOVERS IT AS A REGRESSION: the gate needs the
// gunbc binary, so it runs AFTER the release build rather than before it, and a malformed dispatch
// therefore wastes one build. The safety property is unchanged -- the reset job needs `build` either
// way, so it is never scheduled in the state this refuses.
//
// WHY NOT A DEFAULT ON THE INPUT, which was the review's other arm. Defaulting the observer would
// make an omitted field silently select a machine and POWER-CYCLE ITS PAIRED SUBJECT. A default is
// the right shape for a preference and the wrong one for an effect nobody asked for. Refusing costs
// a re-dispatch; defaulting costs a reboot.
fn fleet_converge_reset_observer_dispatch_admission_step() -> Step {
  RunStep {
    name: Present { value: "Reset-return dispatch admission: refuse an unnamed observer before anything is scheduled" },
    id: Present { value: "reset_observer_dispatch_admission" },
    run: gunbc_ci_host_reset_dispatch_admission_invoke(),
    shell: none,
    env: Present {
      value: [
        kv(key: host_reset_dispatch_mode_env as String, value: yaml_string(s: "${{ github.event.inputs.mode }}")),
        kv(key: host_reset_observer_label_env as String, value: yaml_string(s: "${{ github.event.inputs.reset_observer }}")),
      ]
    },
    working_directory: none,
    if_condition: none,
    continue_on_error: none,
    timeout_minutes: Present { value: gunbc_ci_aux_step_timeout_minutes }
  }
}

fn fleet_converge_build_job() -> Job {
  Job {
    id: "build",
    name: none,
    runner: gunbc_ci_runner_spec(),
    steps: fleet_converge_build_job_steps(),
    needs: [],
    env: none,
    outputs: none,
    if_condition: none,
    timeout_minutes: Present { value: gunbc_fleet_converge_build_job_backstop_timeout_minutes() },
    continue_on_error: none,
    concurrency: none,
    permissions: none,
  }
}

fn fleet_converge_host_pinned_runner_spec() -> RunnerSpec {
  RunsOnExpression { expression: fleet_converge_host_runner_expression }
}

data fleet_converge_plan_step_if: String = fleet_converge_mode_step_if(mode: FullHostPlan)
data fleet_converge_launch_environment_plan_step_if: String = fleet_converge_mode_step_if(mode: LaunchEnvironmentPlan)
data fleet_converge_allocation_store_plan_step_if: String = fleet_converge_mode_step_if(mode: AllocationStorePlan)
data fleet_converge_any_plan_step_if: String = fleet_converge_any_mode_step_if(modes: [FullHostPlan, LaunchEnvironmentPlan, AllocationStorePlan])
data fleet_converge_apply_step_if: String = fleet_converge_mode_step_if(mode: FleetApply)
data fleet_converge_org_actions_step_if: String = fleet_converge_mode_step_if(mode: OrgActionsObserve)
data fleet_converge_org_runner_roster_step_if: String = fleet_converge_mode_step_if(mode: OrgRunnerRosterObserve)

data fleet_converge_app_control_plane_step_if: String = fleet_converge_mode_step_if(mode: AppControlPlaneObserve)

// THE RECEIPT UPLOAD MUST SURVIVE THE REFUSAL, which is the whole point of this phase. The
// converge step writes the observation receipt BEFORE it diffs, then refuses on drift - and a
// bare mode condition would skip the upload on exactly that path, destroying the observation
// precisely when it is most informative. Today the expected first outcome IS a refusal: no
// webhook has ever been configured on this App, so HookSecretAbsent is the likely verdict and
// its receipt is what the next slice starts from. Same reasoning as the launch-receipt upload
// below - preserve the evidence of an unsuccessful verdict, do not condition it on success.
data fleet_converge_app_control_plane_receipt_if: String = join(["always() && ", fleet_converge_mode_step_if(mode: AppControlPlaneObserve)], "")

// THE TWO MICRO-VM MODES ARE HOST-PINNED FOR THE SAME REASON EVERY MODE IN THIS WORKFLOW IS: the
// image is built on the host that will boot it, out of an install root that host owns, so the
// question "which host" is not a parameter of the operation but its subject.
data fleet_converge_guest_image_observe_step_if: String = fleet_converge_mode_step_if(mode: GuestImageObserve)

data fleet_converge_guest_image_converge_step_if: String = fleet_converge_mode_step_if(mode: GuestImageConverge)

data fleet_converge_guest_image_any_step_if: String = fleet_converge_any_mode_step_if(modes: [GuestImageObserve, GuestImageConverge])

data fleet_converge_microvm_boot_probe_step_if: String = fleet_converge_mode_step_if(mode: MicrovmBootProbe)

data fleet_converge_microvm_host_converge_step_if: String = fleet_converge_mode_step_if(mode: MicrovmHostConverge)





data fleet_converge_runner_host_file_observe_step_if: String = fleet_converge_mode_step_if(mode: RunnerHostFileObserve)

data fleet_converge_runner_host_file_converge_step_if: String = fleet_converge_mode_step_if(mode: RunnerHostFileConverge)

data fleet_converge_runner_host_file_any_step_if: String = fleet_converge_any_mode_step_if(modes: [RunnerHostFileObserve, RunnerHostFileConverge])

data fleet_converge_site_pxe_edge_observe_step_if: String = fleet_converge_mode_step_if(mode: SitePxeEdgeObserve)

data fleet_converge_site_pxe_edge_converge_step_if: String = fleet_converge_mode_step_if(mode: SitePxeEdgeConverge)

data fleet_converge_site_pxe_edge_any_step_if: String = fleet_converge_any_mode_step_if(modes: [SitePxeEdgeObserve, SitePxeEdgeConverge])

// THE MODE THAT CLOSES #11061'S REFUSAL. That change made a password-session leg refuse with a
// typed cause naming sshpass; this mode is the route that makes the refusal stop being true. It is
// a STEP in the existing host-pinned fleet-converge job rather than a job of its own, because the
// two own-job precedents here each state a reason that does not apply to it: host reset kills its
// own runner, and dashboard deploy needs the mutation concurrency domain. An apt ensure needs
// neither.
data fleet_converge_runner_password_session_tool_converge_step_if: String = fleet_converge_mode_step_if(mode: RunnerPasswordSessionToolConverge)

// THE RECEIPT IS UPLOADED ON FAILURE TOO. FailFast means the step's cat never runs when the
// ensure refuses, which is exactly when the body names the cause. always() is what keeps that
// body reachable after the job has already failed.
fn fleet_converge_runner_password_session_tool_receipt_upload_step() -> Step {
  UsesStep {
    name: Present { value: "Upload password-session tool converge receipt" },
    id: Present { value: "runner_password_session_tool_receipt_upload" },
    uses: upload_artifact_action,
    with: Present { value: [
      kv(key: "name", value: yaml_string(s: "runner-password-session-tool-converge-receipt")),
      kv(key: "path", value: yaml_string(s: "target/runner-password-session-tool-converge-receipt.txt")),
      kv(key: "if-no-files-found", value: yaml_string(s: "error")),
      kv(key: "retention-days", value: yaml_int(n: 30)),
    ] },
    env: none,
    if_condition: Present { value: concat("always() && (", concat(fleet_converge_runner_password_session_tool_converge_step_if, ")")) },
    continue_on_error: none,
    timeout_minutes: Present { value: gunbc_ci_artifact_transfer_step_timeout_minutes }
  }
}

data fleet_converge_spark_grants_step_if: String = fleet_converge_mode_step_if(mode: SparkGrants)

data fleet_converge_spark_bootstrap_step_if: String = fleet_converge_mode_step_if(mode: SparkBootstrap)

data fleet_converge_spark_serving_apply_step_if: String = fleet_converge_mode_step_if(mode: SparkServingApply)

// ── THE NATIVE ARM GETS ITS OWN MODE, BECAUSE IT IS ITS OWN ACTUATION ─────────────────────────
//
// WHAT THE SHARED MODE DID. One `spark_serving_apply` dispatch ran BOTH the pair apply and the native
// arm's apply. Those are two different subjects with two different blast radii: the pair apply is
// conditional and bounces a converged DeepSeek engine only when its roster moved, while the native
// apply unconditionally restarts four ranks and reloads a 328 GB arm into a new rendezvous epoch. An
// operator asking to converge the pair units could not decline the second, and nothing in the mode's
// name said the second existed. A destructive actuation reachable only as a side effect of asking for
// a different one is the escape hatch inverted: not a way to skip a refusal, but a way to trigger an
// effect nobody selected.
//
// SO THE SUBJECT IS EXPLICIT AND THE DEFAULT IS TO DO NOTHING. `spark_native_serving_apply` names the
// arm it relaunches; `spark_serving_apply` no longer reaches it.
data fleet_converge_spark_native_serving_apply_step_if: String = fleet_converge_mode_step_if(mode: SparkNativeServingApply)

// ── THIS JOB'S MUTATION DOMAIN IS THE EXECUTOR'S, EXCEPT FOR THE ONE MODE WHOSE SUBJECT IS NOT ─
//
// gunbc.fleet_workflow_steps fleet_host_mutation_concurrency_group_expression keys the domain to the
// `host` input, which names the EXECUTOR. Every other mode in this job mutates that executor, so the
// two coincide. `spark_native_serving_apply` does not: it reaches out from whichever executor was
// selected and relaunches Group B's four cage-2 hosts, so two dispatches naming different executors
// would land in different domains and queue behind nothing while reloading the same 328 GB arm. Its
// group is therefore constant for the arm.
//
// AND THIS IS BELT, NOT THE WALL, which is worth saying because a reader could take it for the
// protection. Actions concurrency cannot help a direct CLI invocation, which is how this entry is
// actually run today, and a job carries exactly ONE group -- so keying the native mode to the arm
// means it no longer queues behind an ordinary converge of a Group-B host, a real and stated trade.
// The wall is the source-level lock: gunbc.spark.native_serving_apply acquires an O_EXCL fence per
// unit carrying a kernel-UUID transaction identity, and every leg that removes an artifact refuses
// unless it owns that identity.
data fleet_converge_mutation_concurrency_group_expression: String = join([
  "${{ github.event.inputs.mode == '",
  fleet_converge_workflow_mode_wire(mode: SparkNativeServingApply),
  "' && '", fleet_arm_mutation_group_glm_group_b_native,
  "' || format('", fleet_host_mutation_group_prefix, "{0}', ", fleet_host_input_expression, ") }}",
], "")
data fleet_converge_spark_runtime_image_probe_step_if: String = fleet_converge_mode_step_if(mode: SparkRuntimeImageProbe)

data fleet_converge_dashboard_deploy_step_if: String = fleet_converge_mode_step_if(mode: DashboardDeploy)

data fleet_converge_rlm_receipt_step_if: String = fleet_converge_mode_step_if(mode: RlmLaunchDeploymentReceipt)

fn fleet_converge_plan_upload_step() -> Step {
  UsesStep {
    name: Present { value: "Upload fleet converge plan artifact" },
    id: Present { value: "plan_upload" },
    uses: upload_artifact_action,
    with: Present {
      value: [
        kv(key: "name", value: yaml_string(s: gunbc_fleet_converge_plan_artifact_name)),
        kv(key: "path", value: yaml_string(s: fleet_converge_plan_artifact_dir)),
        kv(key: "if-no-files-found", value: yaml_string(s: "error")),
        kv(key: "retention-days", value: yaml_int(n: 30)),
        kv(key: "compression-level", value: yaml_int(n: 0)),
      ]
    },
    env: none,
    if_condition: Present { value: fleet_converge_any_plan_step_if },
    continue_on_error: none,
    timeout_minutes: Present { value: gunbc_ci_artifact_transfer_step_timeout_minutes }
  }
}

fn fleet_converge_plan_download_step() -> Step {
  UsesStep {
    name: Present { value: "Download fleet converge plan artifact" },
    id: Present { value: "plan_download" },
    uses: download_artifact_action,
    with: Present {
      value: [
        kv(key: "name", value: yaml_string(s: gunbc_fleet_converge_plan_artifact_name)),
        kv(key: "path", value: yaml_string(s: fleet_converge_plan_artifact_dir)),
        kv(key: "github-token", value: yaml_string(s: "${{ secrets.GITHUB_TOKEN }}")),
        kv(key: "run-id", value: yaml_string(s: "${{ github.event.inputs.plan_workflow_run_id }}")),
      ]
    },
    env: none,
    if_condition: Present { value: fleet_converge_apply_step_if },
    continue_on_error: none,
    timeout_minutes: Present { value: gunbc_ci_artifact_transfer_step_timeout_minutes }
  }
}

fn fleet_converge_plan_step() -> Step {
  RunStep {
    name: Present { value: "Fleet converge plan (membership_reconcile → artifact)" },
    id: Present { value: "plan" },
    run: gunbc_ci_fleet_converge_plan_invoke(),
    shell: none,
    env: Present {
      value: [
        kv(key: fleet_converge_expected_host_env_name, value: yaml_string(s: "${{ github.event.inputs.host }}")),
        kv(key: rlm_expected_revision_env_name, value: yaml_string(s: "${{ github.event.inputs.expected_revision }}")),
      ]
    },
    working_directory: none,
    if_condition: Present { value: fleet_converge_plan_step_if },
    continue_on_error: none,
    timeout_minutes: Present { value: gunbc_ci_fleet_converge_plan_step_timeout_minutes }
  }
}

// THE LAUNCH-ENVIRONMENT PLAN CARRIES THE SAME TWO ENV ROWS AS THE FULL-HOST PLAN because it mints
// the same run-bound plan receipt: RLM-2's join pairs a plan receipt with an apply receipt at one
// expected revision, and a plan mode that skipped the expected-host or expected-revision binding
// would produce a receipt naming a revision nobody selected.
fn fleet_converge_launch_environment_plan_step() -> Step {
