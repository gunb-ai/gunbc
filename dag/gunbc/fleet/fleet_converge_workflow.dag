// ── THE R2 OBJECT-WRITE MINT, AS TWO DISPATCH-ONLY MODES ──────────────────────────────────────
// WHY THIS IS A MODE AND NOT A JOB. The brief that requested this asked for one workflow_dispatch
// job. A job is a standing claim on a paid runner and a new emission to enrol in the
// generated-artifact roster; a mode is neither. This job is ALREADY dispatch-only, already pinned to
// a self-hosted arm64 runner, already carries the WIF auth step that federates to
// fleet-cloud-convergence@, and already downloads verified release bins rather than building gunbc
// on the runner -- which is strictly better evidence than a build, because the binary is the one CI
// verified. So the mint is two steps in the ceremony workflow that already exists. The operator
// signed off on a dispatch-only addition for this purpose on 2026-09-12.
//
// THE PREFLIGHT IS SEPARATE FROM THE MINT AND THAT SEPARATION IS THE WHOLE SAFETY ARGUMENT.
// AccountTokens.Create is non-idempotent and returns its value once. Reachability to
// api.cloudflare.com and secretmanager.googleapis.com from this runner class is a fact to OBSERVE,
// not to assume, and observing it by attempting the mint would mean learning that the runner cannot
// reach Secret Manager only after a live credential exists on the account with nobody holding it.
// r2_mint_preflight reads the pinned bootstrap version and lists the account's permission groups:
// both hosts, no mutation. Dispatched BEFORE the operator's IAM grant lands it refuses typed and
// located -- "THE BOOTSTRAP TOKEN COULD NOT BE READ: ..." -- with nothing spent, which is the
// discriminating red for the whole federated route.
//
// NEITHER STEP TAKES A TOKEN AS AN INPUT, AND THAT IS A POSTURE RATHER THAN AN OMISSION. The estate
// holds zero user-managed service-account keys. The only credential either step carries is the
// short-lived access token the WIF auth step mints for THIS run, read in-process by
// gunbc.auth.access_token_source rather than interpolated into a command line.
data fleet_converge_r2_mint_preflight_step_if: String = fleet_converge_mode_step_if(mode: R2MintPreflight)
data fleet_converge_r2_bucket_ensure_step_if: String = fleet_converge_mode_step_if(mode: R2BucketEnsure)
data fleet_converge_r2_bucket_admin_mint_step_if: String = fleet_converge_mode_step_if(mode: R2BucketAdminMint)
data fleet_converge_r2_object_write_mint_step_if: String = fleet_converge_mode_step_if(mode: R2ObjectWriteMint)

// ── THE APP-KEY VERSION VERIFIER ─────────────────────────────────────────────────────────────
// A MODE AND NOT A JOB, for the reason the R2 mint gives above: this job is already dispatch-only,
// already federated to the principal that reads ci-github-app-private-key, and already runs the
// verified release bins. It costs nothing on any run that does not select it, and there is no
// toggle that skips it inside the mode: the mode IS the request to verify.
//
// It is the restore test gunbc.auth.ci_app_key_rotation ci_app_key_contract owes and the consumer
// evidence that subject's rotation needs before any prior version may be disabled. It mints one
// installation token -- the ordinary credential mint the org-admin step already performs -- and
// mutates nothing: no add-version, no disable, no destroy, no GitHub write.
//
// The verdict step runs on always(), so a refused mint still gets a typed verdict and a receipt,
// and the receipt upload survives the refusal for the same reason the App control-plane one does.
data fleet_converge_app_key_version_verify_step_if: String = fleet_converge_mode_step_if(mode: AppKeyVersionVerify)
data fleet_converge_app_key_version_verify_always_if: String = join(["always() && ", fleet_converge_mode_step_if(mode: AppKeyVersionVerify)], "")

// THE TWO STEPS BIND THE SAME TWO VALUES, SO THE VALUES ARE SPELLED ONCE. The mint WRITES the
// observation record and the verdict READS it, which is exactly the pair a split literal breaks
// silently: moving the record off runner.temp in one place leaves the mint writing path A and the
// verdict reading path B, and the run then refuses AppKeyMintObservationAbsent -- fail-closed, but
// pointing the reader at the mint step rather than at the two spellings. The dispatch input is the
// same fact twice over for the same reason. Their NAMES already come from one row each in
// gunbc.auth.ci_app_key_rotation; this is their VALUES. (review 69158)
data fleet_converge_app_key_verify_record_path_expression: String = "${{ runner.temp }}/app-key-verify-record"

data fleet_converge_app_key_version_input_expression: String = "${{ github.event.inputs.app_key_version }}"

fn fleet_converge_app_key_verify_subject_env() -> List<YamlKeyValue> {
  [
    kv(key: app_key_version_env_name as String, value: yaml_string(s: fleet_converge_app_key_version_input_expression)),
    kv(key: app_key_verify_record_env_name as String, value: yaml_string(s: fleet_converge_app_key_verify_record_path_expression)),
  ]
}

fn fleet_converge_app_key_version_verify_env() -> List<YamlKeyValue> {
  concat(
    [kv(key: "WIF_ACCESS_TOKEN", value: yaml_string(s: "${{ steps.wif_auth.outputs.access_token }}"))],
    fleet_converge_app_key_verify_subject_env()
  )
}

fn fleet_converge_app_key_version_verify_mint_step() -> Step {
  RunStep {
    name: Present { value: "App key version verify: mint an installation token with the exact version" },
    id: Present { value: "app_key_version_verify_mint" },
    run: gunbc_ci_app_key_version_verify_mint_script(),
    shell: none,
    env: Present { value: fleet_converge_app_key_version_verify_env() },
    working_directory: none,
    if_condition: Present { value: fleet_converge_app_key_version_verify_step_if },
    continue_on_error: none,
    timeout_minutes: Present { value: gunbc_ci_aux_step_timeout_minutes }
  }
}

// THE MT. COLLINS FAN OBSERVATION MODE, WHICH IS READ-ONLY AND IS THE ONLY MODE IN THIS WORKFLOW
// THAT TOUCHES THAT UNIT WITHOUT THE BOOT LANE'S KNOWLEDGE.
//
// WHY IT IS A MODE RATHER THAN A HAND-RUN. The question it answers - does this controller hold a
// fixed fan output, and does that output move when the host starts publishing thermals - is a
// MEASUREMENT, and a measurement pasted into a message is not a receipt anybody can re-derive. As a
// mode it carries its own credential prelude, writes its series to an artifact the run uploads, and
// can be dispatched again against a later revision to see whether the answer changed.
//
// WHY IT MUST NOT RUN BESIDE A BOOT DISPATCH. Nothing here writes chassis state, but the boot lane
// does, and a fan series taken across somebody else's power cycle is a series whose power column
// changed for a reason the series cannot see. That is a scheduling constraint between two dispatches
// of one workflow, which this repository has no lock for, so it is stated and coordinated rather
// than claimed as enforced.
data fleet_converge_mtcollins1_fan_observe_step_if: String = fleet_converge_mode_step_if(mode: MtCollins1FanObserve)

fn fleet_converge_mtcollins1_fan_observe_step() -> Step {
  RunStep {
    name: Present { value: "Mt. Collins fan observation: IPMI SDR fan + temperature time series with power state (reads only)" },
    id: Present { value: "mtcollins1_fan_observe" },
    run: gunbc_ci_mtcollins1_fan_observe_invoke(),
    shell: none,
    env: Present { value: [
      kv(key: "WIF_ACCESS_TOKEN", value: yaml_string(s: "${{ steps.wif_auth.outputs.access_token }}")),
    ] },
    working_directory: none,
    if_condition: Present { value: fleet_converge_mtcollins1_fan_observe_step_if },
    continue_on_error: none,
    timeout_minutes: Present { value: gunbc_ci_aux_step_timeout_minutes }
  }
}

// THE READING THE WRITER-ROSTER WALL WAITS FOR (gunbc.fabric_writer_identity_observe): from the
// fleet host the dispatch names, through tailscale serve, what Tailscale-User-Login the fabric DB's
// door sees. Reads only; the receipt is the roster's ground. Dispatched once per fleet host.
data fleet_converge_fabric_writer_identity_observe_step_if: String = fleet_converge_mode_step_if(mode: FabricWriterIdentityObserve)

// THE RECEIPT IS UPLOADED WHETHER OR NOT THE OBSERVATION SUCCEEDED. The observer writes its
// receipt and then exits failure for an unproxied or unread reading -- the placed host's own
// reading is exactly that -- and a step condition with no status function is implicitly
// success(), which would skip the upload on the one run whose receipt matters most.
data fleet_converge_fabric_writer_identity_observe_receipt_if: String = join(["always() && ", fleet_converge_mode_step_if(mode: FabricWriterIdentityObserve)], "")

fn fleet_converge_fabric_writer_identity_observe_step() -> Step {
