  // day after the operator's statement). Why it does not enumerate is unread -- whether its 16-pin (12V-2x6) feed is
  // connected, and whether its slot is enabled, were not observed -- so the cause says only what was seen.
  GpuDeviceNotEnumerated {
    host: operator_host_6ce85c,
    board: gpu_board_03,
    cause: "installed (operator, 2026-11-12) and no second 1002:7551 function is on the bus; its power feed and slot state are unread" as NonEmptyStr,
    read_on: "2026-11-12 host-6ce85c lspci and amdgpu sysfs" as NonEmptyStr,
  },
  // ken (host-e2d4b7), read ON THE CARDS 2026-11-18 in one admitted read-only session: `nvidia-smi -q -d
  // POWER` for the ranges and the current limit, `nvidia-smi --query-gpu=pci.bus_id,uuid,serial` for the
  // identities (artifacts/host-observations/ken-gpu-read-2026-11-18/: unit_read3.txt is the power output,
  // gpu_identity_query.txt the identities, SHA256SUMS pins both). All three functions report the SAME range
  // -- 100 W floor, 150 W ceiling, 150 W default -- and all three sit at 100 W now, which is what the
  // hand-written `t10-power-cap` unit on that machine leaves behind at boot (see gunbc.machine_intake.
  // supermicro_h11ssl_unit3_intake_observation::supermicro_h11ssl_unit3_power_cap_setter_prior_life). The
  // driver addresses each card by UUID and takes a power-limit write through `nvidia-smi -pl`, which is the
  // NvidiaSmiPowerLimit control below -- the same route srv1's Max-Q card uses, no new instrument. The
  // `-q -d POWER` block prints each field twice: the second set reads N/A, which is an instantaneous-draw
  // field, not a limit; the four limits above are the first set.
  GpuDeviceEnumerated {
    host: operator_host_e2d4b7,
    board: gpu_board_11,
    gpu_uuid: Present { value: "GPU-c4177907-3dc8-12be-4146-431ea120f818" },
    pci_address: "0000:01:00.0",
    power_limit_minimum: watt(count: 100),
    power_limit_maximum: watt(count: 150),
    power_limit_current: watt(count: 100),
    power_limit_default: Present { value: watt(count: 150) },
    power_limit_control: NvidiaSmiPowerLimit,
    read_on: "2026-11-18 ken nvidia-smi -q -d POWER and --query-gpu=pci.bus_id,uuid,serial" as NonEmptyStr,
  },
  GpuDeviceEnumerated {
    host: operator_host_e2d4b7,
    board: gpu_board_12,
    gpu_uuid: Present { value: "GPU-8327ce9a-6011-f8cf-0012-4af9596c3124" },
    pci_address: "0000:81:00.0",
    power_limit_minimum: watt(count: 100),
    power_limit_maximum: watt(count: 150),
    power_limit_current: watt(count: 100),
    power_limit_default: Present { value: watt(count: 150) },
    power_limit_control: NvidiaSmiPowerLimit,
    read_on: "2026-11-18 ken nvidia-smi -q -d POWER and --query-gpu=pci.bus_id,uuid,serial" as NonEmptyStr,
  },
  GpuDeviceEnumerated {
    host: operator_host_e2d4b7,
    board: gpu_board_13,
    gpu_uuid: Present { value: "GPU-a56f81eb-df65-ec75-e5ee-06c01ce8509e" },
    pci_address: "0000:c1:00.0",
    power_limit_minimum: watt(count: 100),
