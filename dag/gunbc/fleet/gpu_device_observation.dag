import gunbc.fleet.fleet_asset_identity { gpu_board_01, gpu_board_02, gpu_board_03, gpu_board_04, gpu_board_05, gpu_board_06, gpu_board_07, gpu_board_08, gpu_board_09, gpu_board_10 , gpu_board_11, gpu_board_12, gpu_board_13 }

// WHAT THE INSTALLED GPU DEVICES REPORT: the observed half of a card, kept apart from the three facts it is
// easily confused with (operator review of 2026-11-07, "keep four power facts distinct"):
//   1. the vendor's specification -- extdeps.gpu.* board rows (rated board power, published ranges);
//   2. the device's observed capability -- THIS module: the GPU UUID, the PCI function it enumerated at,
//      and the power-limit range the driver reports for it;
//   3. the desired setting -- gunbc.serving.gpu_power_state_policy (the operator's decision);
//   4. the applied setting -- a readback of the current limit for this device in this boot, which is read
//      by gunbc.fleet.gpu_power_cap_converge (gunbc.plans.gpu_card_host_program (deleted 2026-11-08) N10's
//      readback). The power_limit_current below is NOT that readback: it is what nvidia-smi reported as the
//      limit in force at the instant of the enumeration reading, and it is not by itself evidence that any
//      unit applied it. What is installed to make a cap survive a boot, and what that mechanism claims in
//      its own journal, are the two observations of gunbc.fleet.gpu_power_cap_boot_state.
//
// THE BINDING RUNS FROM THE PHYSICAL ASSET TO THE DEVICE, never the reverse. A board is an inventory asset
// (gunbc.fleet.fleet_physical_inventory); a device is what one driver enumeration shows on that board. A
// multi-GPU board (the A16) has several devices, so a board may own several rows here; NVIDIA states that
// board serials can be shared across the GPUs of one board and that enumeration indexes can change, so a
// device is addressed by its UUID and located by its PCI address, and no index is carried.
//
// INSTALLED IS NOT AVAILABLE. A card can sit in its host and not enumerate (no power cable, a disabled
// slot, a fault). That is GpuDeviceNotEnumerated, an ordinary state with its cause, never an absent row.
//
// STANDING. Each row is a transcription of one reading, dated and named in read_on; no receipt module
// reads nvidia-smi's identity and power fields on a schedule yet, so these are not sealed receipts. A row
// is superseded by a newer reading of the same board. WHERE A RETIRED READING GOES: it moves to
// retired_gpu_device_observations below, TYPED and unchanged -- never into an annotation. An earlier draft of
// this note sent authors to "the inventory annotation as history", citing fleet_physical_inventory's
// gpu_board_01_asset as keeping a 2026-10-30 reading; that instruction was wrong and the precedent it cited
// does not exist, so neither is repeated here: gunbc.design_argument::source_annotations puts receipts in typed
// carriers, forbids an annotation restating what a declaration says, and reserves the project's right to delete
// any comment at any time. A dated reading is a receipt; retirement changes who folds it, not what holds it.
type GpuDeviceObservation
  = GpuDeviceEnumerated {
      host: HostIdentity
      board: PhysicalAssetIdentity
      gpu_uuid: NonEmptyStr?
      pci_address: PciAddress
      power_limit_minimum: Watt
      power_limit_maximum: Watt
      power_limit_current: Watt
      // The factory default limit nvidia-smi reports as power.default_limit -- what the card comes back with
      // after a boot or a reset with nobody touching it. It is a separate fact from power_limit_current:
      // current says what is in force now (which may be somebody's cap) and default says what would be in
      // force if nobody had capped it, and it is the only thing that can tell a cap apart from a card that
      // simply never needed one. Optional because a survey that recorded min/max/current without a default
      // leaves this unread -- see the srv4 rows -- and an unread default is reported as unread.
      power_limit_default: Watt?
      // WHICH DRIVER CONTROL SETS THIS DEVICE'S LIMIT. The range and current/default figures above are read
      // through it, and a cap can only be realized through it: nvidia-smi -pl for an NVIDIA device, the amdgpu
      // hwmon power1_cap attribute for an AMD one. Admission (gunbc.serving.gpu_power_state_policy) reads it
      // to tell a cap the modeled converge can apply from one it cannot.
      power_limit_control: GpuPowerLimitControl
      read_on: NonEmptyStr
    }
  | GpuDeviceNotEnumerated {
      host: HostIdentity
      board: PhysicalAssetIdentity
      cause: NonEmptyStr
      read_on: NonEmptyStr
    }

// THE CONTROL A DEVICE'S POWER LIMIT IS READ AND SET THROUGH. Selecting between the two is realization: each
// arm names its upstream (extdeps.nvidia.system_management_interface SetPowerLimit; extdeps.linux.amdgpu_hwmon
// power1_cap), and neither upstream module knows the other exists.
type GpuPowerLimitControl
  = NvidiaSmiPowerLimit
  | AmdgpuHwmonPowerCap { attribute: AmdgpuHwmonPowerAttribute }

fn gpu_device_observation_board(o: GpuDeviceObservation) -> PhysicalAssetIdentity {
  match o {
    GpuDeviceEnumerated { host: _, board: b, gpu_uuid: _, pci_address: _, power_limit_minimum: _, power_limit_maximum: _, power_limit_current: _, power_limit_default: _, power_limit_control: _, read_on: _ } => b
    GpuDeviceNotEnumerated { host: _, board: b, cause: _, read_on: _ } => b
  }
}

fn gpu_device_observation_host(o: GpuDeviceObservation) -> HostIdentity {
  match o {
    GpuDeviceEnumerated { host: h, board: _, gpu_uuid: _, pci_address: _, power_limit_minimum: _, power_limit_maximum: _, power_limit_current: _, power_limit_default: _, power_limit_control: _, read_on: _ } => h
    GpuDeviceNotEnumerated { host: h, board: _, cause: _, read_on: _ } => h
  }
}

// The default limit, which is what a cap has to be compared against before the word "capped" means anything.
// Absent for a board whose default was never read, and for a board that does not enumerate at all.
fn gpu_device_observation_default(o: GpuDeviceObservation) -> Watt? {
  match o {
    GpuDeviceEnumerated { host: _, board: _, gpu_uuid: _, pci_address: _, power_limit_minimum: _, power_limit_maximum: _, power_limit_current: _, power_limit_default: d, power_limit_control: _, read_on: _ } => d
    GpuDeviceNotEnumerated { host: _, board: _, cause: _, read_on: _ } => Absent
  }
}

// THE CURRENT READING OF EACH INSTALLED BOARD WHOSE DEVICE HAS BEEN LOOKED FOR.
data current_gpu_device_observations: List<GpuDeviceObservation> = [
  // srv1's Max-Q, re-read 2026-11-08 (nvidia-smi: name, UUID, serial 1793526019879, VBIOS 98.02.6A.00.03,
  // pci.bus_id, power.limit/min/max/default, ecc off, 97887 MiB, driver 580.178.04). It enumerated at
  // 0005:01:00.0 on 2026-11-07 and at 0001:01:00.0 on 2026-11-08; whether the card was moved or the
  // platform renumbered its root-port domains is NOT read, so the inventory keeps the slot unread. Its
  // current limit (300 W) equals its own default limit, so nothing is capped on this board.
  GpuDeviceEnumerated {
    host: operator_host_srv1,
    board: gpu_board_04,
    gpu_uuid: Present { value: "GPU-7b58568e-8bc9-4e4b-bc6c-c414b08936c3" as NonEmptyStr },
    pci_address: "0001:01:00.0" as PciAddress,
    power_limit_minimum: watt(count: 250),
    power_limit_maximum: watt(count: 325),
    power_limit_current: watt(count: 300),
    power_limit_default: Present { value: watt(count: 300) },
    power_limit_control: NvidiaSmiPowerLimit,
    read_on: "2026-11-08 srv1 nvidia-smi" as NonEmptyStr,
  },
  // srv1's Workstation card, re-read 2026-11-08: it NOW ENUMERATES -- UUID
  // GPU-96b749dc-e2ea-5b6f-2e45-ee868b1a9750, serial 1792726101367, VBIOS 98.02.81.00.07, 97887 MiB, ECC
  // off, range 150..600 W, current limit 300 W with a default limit of 600 W. The 2026-11-07
  // GpuDeviceNotEnumerated row (installed without its power cable, operator statement) is superseded; its
  // history stays on gpu_board_01_asset in gunbc.fleet.fleet_physical_inventory.
  GpuDeviceEnumerated {
    host: operator_host_srv1,
    board: gpu_board_01,
    gpu_uuid: Present { value: "GPU-96b749dc-e2ea-5b6f-2e45-ee868b1a9750" as NonEmptyStr },
    pci_address: "0004:01:00.0" as PciAddress,
    power_limit_minimum: watt(count: 150),
    power_limit_maximum: watt(count: 600),
    power_limit_current: watt(count: 300),
    power_limit_default: Present { value: watt(count: 600) },
    power_limit_control: NvidiaSmiPowerLimit,
    read_on: "2026-11-08 srv1 nvidia-smi" as NonEmptyStr,
  },
  // srv4's RTX 2000 Ada pair, 2026-11-07 15:35Z (fleet survey, jolly-moth-61). The UUIDs were not read.
  GpuDeviceEnumerated {
    host: operator_host_srv4,
    board: gpu_board_05,
    gpu_uuid: Absent,
    pci_address: "0000:01:00.0" as PciAddress,
    power_limit_minimum: watt(count: 30),
    power_limit_maximum: watt(count: 70),
    power_limit_current: watt(count: 40),
    power_limit_default: Absent,
    power_limit_control: NvidiaSmiPowerLimit,
    read_on: "2026-11-07 srv4 nvidia-smi (fleet survey)" as NonEmptyStr,
  },
  GpuDeviceEnumerated {
    host: operator_host_srv4,
    board: gpu_board_06,
    gpu_uuid: Absent,
    pci_address: "0004:01:00.0" as PciAddress,
    power_limit_minimum: watt(count: 30),
    power_limit_maximum: watt(count: 70),
    power_limit_current: watt(count: 40),
    power_limit_default: Absent,
    power_limit_control: NvidiaSmiPowerLimit,
    read_on: "2026-11-07 srv4 nvidia-smi (fleet survey)" as NonEmptyStr,
  },
  // srv14/butch's four NVIDIA A2 readings (gpu_board_07..10, read 2026-11-10) are NOT in this list and never
  // will be again: the operator's 2026-11-17 report says all four cards were physically removed from butch to
  // be sold and that butch is CI only, no serving, corroborated by the operator's session read at
  // 2026-11-16T22:36Z (no NVIDIA driver loaded, a2-power-cap.service FAILED, strata-pool@a/@b inactive). This
  // list is read as CURRENT state by every one of its consumers -- current_gpu_device_observations_of,
  // current_gpu_device_for_host in gunbc.serving.gpu_power_state_policy (which admit_gpu_cap_against uses to
  // admit a cap), and the converge and boot-state paths in gunbc.fleet.gpu_power_cap_converge and
  // gunbc.fleet.gpu_power_cap_boot_state -- so a kept row would assert that butch enumerates four A2s today and
  // would hold a cap-admission path open against cards that are no longer in the box. WHAT WAS NOT DONE, and
  // why: the readings were not deleted, nor retyped into annotations. A dated observation is a receipt, and
  // gunbc.design_argument::source_annotations puts receipts in a typed carrier and forbids an annotation from
  // restating what a declaration says -- "the project reserves the right to delete any comment at any time", so
  // @ref(gunbc.fleet.gpu_device_observation::retired_gpu_device_observations) below, which no current-state consumer
  // folds. DO NOT "FIX" THE ABSENCE HERE BY ADDING GpuDeviceNotEnumerated ROWS FOR srv14: not-enumerated is the
  // state of a card that IS seated and fails to show up, and these cards are seated nowhere -- the honest
  // current state is no row, not a device with a fault.
  // host-6ce85c (h11-a16)'s Radeon AI PRO R9700, read 2026-11-12T16:31Z by read_r9700_device.sh
  // (artifacts/host-observations/h11-r9700-2026-11-12/r9700_device_reading.txt, pinned in that directory's
  // SHA256SUMS): PCI 1002:7551, subsystem 1458:242f (Gigabyte), VBIOS 113-R9700AT-F50, 34208743424 bytes of VRAM,
  // amdgpu on kernel 7.0.0-43-generic. The hwmon reads power1_cap_min 210 W, power1_cap_max 300 W,
  // power1_cap_default 300 W and power1_cap 210 W -- the 210 W is the operator's cap, written by hand to
  // power1_cap earlier the same day, which is why current differs from default. NO NVIDIA UUID EXISTS for this device; the
  // driver's own stable identifier is sysfs unique_id d503384f1b8b8afe (the kernel's "unique ID for the GPU that
  // will persist from machine to machine", docs.kernel.org/gpu/amdgpu/driver-misc.html), which is a different
  // identifier and is not written into gpu_uuid. THE SLOT RUNS IT AT PCIe 3.0: the endpoint and the card's own
  // switch (81:00.0/82:00.0) advertise 32 GT/s x16, and the root port above them, 0000:80:01.1 (AMD
  // Starship/Matisse GPP bridge), reads LnkCap and LnkSta 8 GT/s x16.
  GpuDeviceEnumerated {
    host: operator_host_6ce85c,
    board: gpu_board_02,
    gpu_uuid: Absent,
    pci_address: "0000:83:00.0" as PciAddress,
    power_limit_minimum: watt(count: 210),
    power_limit_maximum: watt(count: 300),
    power_limit_current: watt(count: 210),
    power_limit_default: Present { value: watt(count: 300) },
    power_limit_control: AmdgpuHwmonPowerCap { attribute: Power1Cap },
    read_on: "2026-11-12 host-6ce85c amdgpu sysfs/hwmon (read_r9700_device.sh)" as NonEmptyStr,
  },
  // host-6ce85c's SECOND R9700: installed (operator, 2026-11-12) and absent from the bus. Every 1002:7551 function
