// THE RETIRED READINGS, TYPED. A dated observation is a receipt, and receipts live in typed carriers, not in
// annotations (gunbc.design_argument::source_annotations: "Nothing may depend on a comment for correctness"; an
// annotation "must not restate what the declaration says"). These four are the last readings taken of butch's
// NVIDIA A2 cards while they were seated, kept verbatim from the rows that were in
// current_gpu_device_observations until the operator's 2026-11-17 report removed the cards from the box to sell
// them. Nothing about them is current: the read is pinned by each row's own read_on, and NO CURRENT-STATE
// CONSUMER FOLDS THIS LIST -- not current_gpu_device_observations_of, not current_gpu_device_for_host, not the
// cap-admission path, not the converge or boot-state generators. That separation is the whole reason this list
// exists rather than the rows staying above: the readings are true of 2026-11-10 and false of today, and the
// two must not share one population. The consumer that keeps this list honest is the claim
// witness_the_retired_butch_a2_readings_survive_typed_in_no_current_state_list, which reds if a row is dropped,
// if a field drifts, or if any of these boards reappears in the current list while unseated.
data retired_gpu_device_observations: List<GpuDeviceObservation> = [
  GpuDeviceEnumerated {
    host: operator_host_srv14,
    board: gpu_board_07,
    gpu_uuid: Present { value: "GPU-c7080fc0-73f7-5c2d-0412-c5041edd95f4" as NonEmptyStr },
    pci_address: "0000:01:00.0" as PciAddress,
    power_limit_minimum: watt(count: 35),
    power_limit_maximum: watt(count: 60),
    power_limit_current: watt(count: 35),
    power_limit_default: Present { value: watt(count: 60) },
    power_limit_control: NvidiaSmiPowerLimit,
    read_on: "2026-11-10 srv14/butch nvidia-smi -q -d POWER (driver 595.91.07)" as NonEmptyStr,
  },
  GpuDeviceEnumerated {
    host: operator_host_srv14,
    board: gpu_board_08,
    gpu_uuid: Present { value: "GPU-d6551356-b835-59e5-8ea9-542098216e6f" as NonEmptyStr },
    pci_address: "0001:01:00.0" as PciAddress,
    power_limit_minimum: watt(count: 35),
    power_limit_maximum: watt(count: 60),
    power_limit_current: watt(count: 35),
    power_limit_default: Present { value: watt(count: 60) },
    power_limit_control: NvidiaSmiPowerLimit,
    read_on: "2026-11-10 srv14/butch nvidia-smi -q -d POWER (driver 595.91.07)" as NonEmptyStr,
  },
  GpuDeviceEnumerated {
    host: operator_host_srv14,
    board: gpu_board_09,
    gpu_uuid: Present { value: "GPU-63e42447-95fe-67cb-afde-3e2e80e4e389" as NonEmptyStr },
    pci_address: "0004:01:00.0" as PciAddress,
    power_limit_minimum: watt(count: 35),
    power_limit_maximum: watt(count: 60),
    power_limit_current: watt(count: 35),
    power_limit_default: Present { value: watt(count: 60) },
    power_limit_control: NvidiaSmiPowerLimit,
    read_on: "2026-11-10 srv14/butch nvidia-smi -q -d POWER (driver 595.91.07)" as NonEmptyStr,
  },
  GpuDeviceEnumerated {
    host: operator_host_srv14,
    board: gpu_board_10,
    gpu_uuid: Present { value: "GPU-b44c2926-091a-b3ac-3d11-bda9613c67fb" as NonEmptyStr },
    pci_address: "0004:02:00.0" as PciAddress,
    power_limit_minimum: watt(count: 35),
    power_limit_maximum: watt(count: 60),
    power_limit_current: watt(count: 35),
    power_limit_default: Present { value: watt(count: 60) },
    power_limit_control: NvidiaSmiPowerLimit,
    read_on: "2026-11-10 srv14/butch nvidia-smi -q -d POWER (driver 595.91.07)" as NonEmptyStr,
  },
]

fn retired_gpu_device_observations_of(board: PhysicalAssetIdentity) -> List<GpuDeviceObservation> {
  filter(retired_gpu_device_observations, o => physical_asset_identity_eq(a: gpu_device_observation_board(o: o), b: board))
}

fn current_gpu_device_observations_of(board: PhysicalAssetIdentity) -> List<GpuDeviceObservation> {
  filter(current_gpu_device_observations, o => physical_asset_identity_eq(a: gpu_device_observation_board(o: o), b: board))
}
