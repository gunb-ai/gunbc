  srv1_host_smbios_unit_identity_inputs,
  srv2_host_smbios_unit_identity_inputs,
  srv4_host_smbios_unit_identity_inputs,
  srv1_out_of_band_arm,
  srv2_out_of_band_arm,
  srv4_out_of_band_arm,
  OutOfBandArm,
  OutOfBandNeverTaken,
  OutOfBandVerified,
  OutOfBandCaptureRefused,
  out_of_band_observations,
  BmcFruCaptureStanding,
}
