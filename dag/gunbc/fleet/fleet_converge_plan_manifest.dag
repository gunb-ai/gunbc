module gunbc.fleet_converge_plan_manifest

import std.types { String, Bool, Int, NonEmptyStr, List }
import std.algebra { trim }
import v2.std.optional { Present, Absent }
import gunbc.fleet_converge_receipt { FleetConvergePlanReceipt }
import gunbc.fleet_converge_plan {
  FleetConvergeScope,
  ScopeDecoded,
  ScopeUndecodable,
  fleet_converge_scope_of_wire,
  fleet_converge_scope_wire,
  fleet_converge_plan_body_path,
  fleet_converge_plan_content_hash_path,
  fleet_converge_plan_apply_shell_path,
  fleet_converge_plan_subject_host_path,
  fleet_converge_plan_subject_scope_path,
  fleet_converge_plan_member_set_fp_path,
  fleet_converge_plan_baseline_hex_path,
  fleet_converge_plan_prior_generation_path,
  fleet_converge_plan_generation_path,
  fleet_converge_parse_nonneg_generation_text,
  fleet_converge_plan_bundle_digest_hex,
}

// EVERY VALUE APPLY TRUSTS, JUDGED IN ONE PLACE AGAINST ONE RUN-BOUND ANCHOR.
//
// THE HOLE THIS CLOSES, stated as the attack rather than as a property. The plan writes seven files
// into /tmp/fleet-converge-plan. plan_content.hex covers exactly two of them -- plan.txt and
// apply.sh -- and subject_scope.txt, subject_host.txt, subject_member_set.txt,
// observed_baseline.hex and the two generation files were covered by nothing. Apply then read the
// SCOPE out of subject_scope.txt and used it for BOTH halves of its own admission: it was the
// planned scope handed to fleet_converge_apply_artifact_admits AND the selector deciding which
// observers ran to build the re-observation it was compared against. A value compared only against
// itself always agrees, so a coordinated substitution -- scope, member-set fingerprint and baseline
// replaced together and coherently -- admitted the ORIGINAL, REVIEWED apply.sh under a DIFFERENT
// re-observation scope, with the bundle hash still matching because none of the substituted files
// was in the bundle.
//
// THE REPAIR IS NOT A BIGGER HASH, IT IS A DIFFERENT DIRECTION OF TRUST. The scope apply routes on
// is now taken from the PLAN RECEIPT, which the plan run mints, which is bound to that run's id and
// revision, and which apply already carries for the plan-binding check. The on-disk sidecar is no
// longer an input to routing at all: it is an artifact whose AGREEMENT with the receipt is checked,
// and a disagreement is a typed refusal. Substituting it cannot steer anything, because nothing
// downstream reads it for a decision. That is construction over validation -- the file LOST its
// authority rather than gaining a guard in front of it.
//
// SO THE RECEIPT IS THE MANIFEST, AND THIS MODULE DOES NOT MINT A SECOND ONE. A separate manifest
// record carrying host, scope, fingerprint, baseline, generations, lease and terminal would be a
// second representation of fields FleetConvergePlanReceipt already carries and already folds into
// its identity hash, and two records of one subject drift in the ordinary direction -- someone adds
// a field, one gets it. What this module adds is the half the receipt did not cover: a TOTAL
// admission that judges the whole on-disk population against the receipt in one decision, rather
// than at six call sites that each chose what to check -- including the recomputation of the bundle
// digest over the actual bytes, so that a doctored plan body and a doctored hex file are two
// different, separately named refusals instead of one covering for the other.

// EVERY PERSISTED MEMBER, CLASSIFIED, WITH NO ROOM FOR A FOURTH ANSWER.
//
// The rule this encodes: a persisted file need not be in the authority digest, but only when apply
// no longer TRUSTS it for any decision -- it may not select the observer arm, the baseline
// population, the member-set fingerprint authority, the terminal, the apply shell, or the receipt
// subject. Before this PR, subject_scope.txt failed that test while sitting outside the digest, and
// the gap was invisible because nothing in the repository stated which category each file was in.
//
// THREE ARMS AND NO WILDCARD, so the classification is exhaustive by construction. There is
// deliberately no arm for "covered incidentally by some other fingerprint": that is the sentence
// under which subject_member_set.txt and observed_baseline.hex went unexamined -- they were each
// folded into a hash somewhere, so nobody asked whether apply READ them, and it did.
type FleetConvergePersistedMemberAuthority
  = ReceiptBoundMember { receipt_field: String }
  | DerivedFromBoundAuthority { recomputed_into: String }
  | NonAuthoritativePresentation { justification: String }

// TOTAL OVER THE PATH, and the refusal arm is what makes it total honestly: a path this fold does
// not recognize is UnclassifiedPersistedMember rather than a default category, so adding an eighth
// sidecar without classifying it is a loud failure at the witness rather than a silent third rail.
type FleetConvergePersistedMemberClassification
  = PersistedMemberClassified { path: String, authority: FleetConvergePersistedMemberAuthority }
  | UnclassifiedPersistedMember { path: String }

fn fleet_converge_persisted_member_authority(path: String) -> FleetConvergePersistedMemberClassification {
  if path == fleet_converge_plan_subject_host_path {
    PersistedMemberClassified { path: path, authority: ReceiptBoundMember { receipt_field: "observed_host" } }
  } else if path == fleet_converge_plan_subject_scope_path {
    PersistedMemberClassified { path: path, authority: ReceiptBoundMember { receipt_field: "scope_wire" } }
  } else if path == fleet_converge_plan_member_set_fp_path {
    PersistedMemberClassified { path: path, authority: ReceiptBoundMember { receipt_field: "member_set_fingerprint_hex" } }
  } else if path == fleet_converge_plan_baseline_hex_path {
    PersistedMemberClassified { path: path, authority: ReceiptBoundMember { receipt_field: "observed_baseline_hex" } }
  } else if path == fleet_converge_plan_prior_generation_path {
    PersistedMemberClassified { path: path, authority: ReceiptBoundMember { receipt_field: "prior_generation" } }
  } else if path == fleet_converge_plan_generation_path {
    PersistedMemberClassified { path: path, authority: ReceiptBoundMember { receipt_field: "planned_generation" } }
  } else if path == fleet_converge_plan_content_hash_path {
    PersistedMemberClassified { path: path, authority: ReceiptBoundMember { receipt_field: "plan_artifact_hash" } }
  } else if path == fleet_converge_plan_body_path {
    PersistedMemberClassified { path: path, authority: DerivedFromBoundAuthority { recomputed_into: "plan_artifact_hash" } }
  } else if path == fleet_converge_plan_apply_shell_path {
    PersistedMemberClassified { path: path, authority: DerivedFromBoundAuthority { recomputed_into: "plan_artifact_hash" } }
  } else {
    UnclassifiedPersistedMember { path: path }
  }
}

// THE PERSISTED POPULATION, AS A ROSTER. The classification above answers per path; this states
// WHICH paths the plan writes, so the two together are a closed map rather than a lookup nobody
// enumerates. The witness joins them at identity grain.
data fleet_converge_persisted_member_paths: List<String> = [
  fleet_converge_plan_subject_host_path,
  fleet_converge_plan_subject_scope_path,
  fleet_converge_plan_member_set_fp_path,
  fleet_converge_plan_baseline_hex_path,
  fleet_converge_plan_prior_generation_path,
  fleet_converge_plan_generation_path,
  fleet_converge_plan_content_hash_path,
  fleet_converge_plan_body_path,
  fleet_converge_plan_apply_shell_path,
]

// CATEGORY THREE IS EMPTY TODAY, AND THAT IS AN OBSERVATION RATHER THAN AN OMISSION. Every file the
// plan writes is either compared to the run-bound receipt directly or recomputed into a value that
// is. The arm exists because a future presentation-only sidecar is a legitimate thing to add -- but
// it must be classified as one deliberately, which is the point of the fold having no default.
// THE ON-DISK POPULATION APPLY READS, AS ONE VALUE.
//
// It is a record rather than nine parameters because the admission below must be TOTAL over it: a
// caller able to pass eight of nine would be back in the shape that produced the hole, where each
// site chose which facts it carried. Every field is the raw TEXT read from disk and never a parsed
// value, because parsing before admitting is what let a corrupt generation file reach a comparison
// at all.
type FleetConvergeApplyPayload {
  subject_host_text: String
  subject_scope_text: String
  subject_member_set_text: String
  observed_baseline_hex_text: String
  prior_generation_text: String
  planned_generation_text: String
  plan_body: String
  apply_shell: String
  plan_content_hex: String
}

// ONE ARM PER DIVERGING FACT. These fail for reasons with different operator remedies, and
// collapsing them to a Bool makes one message answer for six causes -- the state-space conflation
// this repository keeps paying for. The sidecar arm names the FIELD, the receipt value and the
// on-disk value, because whoever reads it is deciding between ordinary drift, a truncated write,
// and a substitution.
type FleetConvergeApplyPayloadAdmission
  = PayloadAdmitted { routed_scope: FleetConvergeScope }
  | PayloadScopeUndecodableInReceipt { cause: String }
  | PayloadSidecarDiverged { field: String, receipt_value: String, on_disk_value: String }
  | PayloadGenerationTextCorrupt { field: String, on_disk_value: String }
  | PayloadBundleDigestMismatch { receipt_value: String, on_disk_value: String }
  | PayloadDigestUncomputable { path: String }

// THE ORDER OF THESE CHECKS IS THE SAFETY PROPERTY AND IS NOT COSMETIC.
//
// The routed scope is decoded from the RECEIPT first and is returned FROM THE ADMITTED ARM, so a
// caller cannot route on anything else: no arm of this type yields a scope taken from disk, so
// there is no spelling in which the selector and the substituted file are the same value. The
// payload bundle is then judged against the receipt's hash, then every sidecar against its receipt
// field. Only a population agreeing with the run-bound receipt on all of them reaches
// PayloadAdmitted, and the scope it carries came from the receipt rather than from the files it
// just finished validating.
fn fleet_converge_apply_payload_admits(
  receipt: FleetConvergePlanReceipt,
  payload: FleetConvergeApplyPayload,
) -> FleetConvergeApplyPayloadAdmission {
  match fleet_converge_scope_of_wire(wire: receipt.scope_wire) {
    ScopeUndecodable { cause: why } => PayloadScopeUndecodableInReceipt { cause: why }
    ScopeDecoded { scope: routed } =>
      if trim(s: payload.plan_content_hex) != receipt.plan_artifact_hash {
        PayloadBundleDigestMismatch {
          receipt_value: receipt.plan_artifact_hash,
          on_disk_value: trim(s: payload.plan_content_hex),
        }
      } else if trim(s: payload.subject_host_text) != receipt.observed_host {
        PayloadSidecarDiverged {
          field: fleet_converge_plan_subject_host_path,
          receipt_value: receipt.observed_host,
          on_disk_value: trim(s: payload.subject_host_text),
        }
      } else if trim(s: payload.subject_scope_text) != receipt.scope_wire {
        PayloadSidecarDiverged {
          field: fleet_converge_plan_subject_scope_path,
          receipt_value: receipt.scope_wire,
          on_disk_value: trim(s: payload.subject_scope_text),
        }
      } else if trim(s: payload.subject_member_set_text) != receipt.member_set_fingerprint_hex {
        PayloadSidecarDiverged {
          field: fleet_converge_plan_member_set_fp_path,
          receipt_value: receipt.member_set_fingerprint_hex,
          on_disk_value: trim(s: payload.subject_member_set_text),
        }
      } else if trim(s: payload.observed_baseline_hex_text) != receipt.observed_baseline_hex {
        PayloadSidecarDiverged {
          field: fleet_converge_plan_baseline_hex_path,
          receipt_value: receipt.observed_baseline_hex,
          on_disk_value: trim(s: payload.observed_baseline_hex_text),
        }
      } else {
        payload_generation_admits(receipt: receipt, payload: payload, routed: routed)
      }
  }
}

fn payload_generation_admits(
  receipt: FleetConvergePlanReceipt,
  payload: FleetConvergeApplyPayload,
  routed: FleetConvergeScope,
) -> FleetConvergeApplyPayloadAdmission {
  match fleet_converge_parse_nonneg_generation_text(content: payload.prior_generation_text) {
    Absent => PayloadGenerationTextCorrupt {
      field: fleet_converge_plan_prior_generation_path,
      on_disk_value: trim(s: payload.prior_generation_text),
    }
    Present { value: prior } =>
      match fleet_converge_parse_nonneg_generation_text(content: payload.planned_generation_text) {
        Absent => PayloadGenerationTextCorrupt {
          field: fleet_converge_plan_generation_path,
          on_disk_value: trim(s: payload.planned_generation_text),
        }
        Present { value: planned } =>
          if prior != receipt.prior_generation {
            PayloadSidecarDiverged {
              field: fleet_converge_plan_prior_generation_path,
              receipt_value: to_string(receipt.prior_generation),
              on_disk_value: to_string(prior),
            }
          } else if planned != receipt.planned_generation {
            PayloadSidecarDiverged {
              field: fleet_converge_plan_generation_path,
              receipt_value: to_string(receipt.planned_generation),
              on_disk_value: to_string(planned),
            }
          } else {
            payload_digest_admits(receipt: receipt, payload: payload, routed: routed)
          }
      }
  }
}

// THE DIGEST STEP RECOMPUTES FROM THE BYTES, WHICH IS THE ONLY VERSION OF IT WORTH HAVING.
//
// An earlier cut of this function computed a path-tagged digest over each payload member and then
// DISCARDED every value, matching only on whether the hash succeeded. That is specification without
// execution inside the admission itself: the step looked load-bearing and its result went nowhere,
// so the annotation beside it claimed a binding the code did not enforce (review 57966, and the
// finding is correct). It also minted a SECOND digest scheme beside the bundle digest this
// repository already owns -- two answers to "are these the planned bytes", which is the fork §3
// forbids and which would drift the moment either side gained a member.
//
// So the tagged digest is gone and the real question is asked instead: recompute the canonical
// bundle digest OVER THE ACTUAL BYTES and compare it to the hash the run-bound receipt minted. The
// sidecar check above compares the on-disk plan_content.hex CLAIM to the receipt; this compares the
// BYTES to the receipt. They are different failures -- a doctored hex file versus doctored plan or
// apply bytes -- and collapsing them would let one cover for the other.
fn payload_digest_admits(
  receipt: FleetConvergePlanReceipt,
  payload: FleetConvergeApplyPayload,
  routed: FleetConvergeScope,
) -> FleetConvergeApplyPayloadAdmission {
  match fleet_converge_plan_bundle_digest_hex(
    plan_body: payload.plan_body,
    apply_shell: payload.apply_shell,
  ) {
    Absent => PayloadDigestUncomputable { path: fleet_converge_plan_body_path }
    Present { value: computed } =>
      if (computed as String) != receipt.plan_artifact_hash {
        PayloadBundleDigestMismatch {
          receipt_value: receipt.plan_artifact_hash,
          on_disk_value: computed as String,
        }
      } else {
        PayloadAdmitted { routed_scope: routed }
      }
  }
}

fn fleet_converge_apply_payload_refusal_text(a: FleetConvergeApplyPayloadAdmission) -> String {
  match a {
    PayloadAdmitted { routed_scope: s } =>
      join(["admitted; routing on ", fleet_converge_scope_wire(scope: s)], "")
    PayloadScopeUndecodableInReceipt { cause: why } =>
      join([
        "PlanReceiptScopeUndecodable — ", why,
        "; the run-bound receipt names a scope this build cannot decode, so no observer may be selected",
      ], "")
    PayloadSidecarDiverged { field: f, receipt_value: r, on_disk_value: o } =>
      join([
        "PlanArtifactDivergedFromReceipt — ", f, " holds ", o,
        " and the run-bound plan receipt says ", r,
        "; the artifact on disk is not the one this receipt was minted for",
      ], "")
    PayloadGenerationTextCorrupt { field: f, on_disk_value: o } =>
      join(["PlanGenerationTextCorrupt — ", f, " holds ", o, "; refuse rather than coerce to 0"], "")
    PayloadBundleDigestMismatch { receipt_value: r, on_disk_value: o } =>
      join(["PlanBundleDigestMismatch — plan_content.hex holds ", o, " and the plan receipt minted ", r], "")
    PayloadDigestUncomputable { path: p } =>
      join(["PlanPayloadDigestUncomputable — ", p, " did not hash as Fnv1a64Structural"], "")
  }
}
