module gunbc.fleet.organization_runner_roster_ci_step

// The org runner roster observe fleet run step, moved verbatim from gunbc.ci.ci_spec (P2 fleet mode
// decomposition). It reads the GitHub self-hosted runner roster (organization_runner_roster_read) under
// the org-admin installation token, so it sits beside that read in gunbc.fleet; ci_spec keeps only the
// run-step roster and imports this target into it. The prelude is shared with the org-actions step
// (gunbc.auth.github_app_credential_step), minted in-run and held only in this step's environment.

import std.types { String }
import gunbc.ci.ci_layer_roots { witness_layer_roots }
import gunbc.ci.ci_run_step_target { GunbcRunStepTarget }
import gunbc.auth.github_app_credential_step { gunbc_ci_org_admin_app_token_prelude }
import v2.workflow.gunbc_invoke_step_emit { gunbc_run_step_script_with_prelude }

data gunbc_ci_org_runner_roster_observe_target: GunbcRunStepTarget = GunbcRunStepTarget {
  entry: "dag/gunbc/fleet/organization_runner_roster_read.dag",
  function: "organization_runner_roster_observe_wet",
}
// SAME PRELUDE AS THE ORG-ACTIONS STEP: the roster read needs the same org-scoped installation token,
// minted in-run and held only in this step's environment.
fn gunbc_ci_org_runner_roster_observe_invoke() -> String {
  gunbc_run_step_script_with_prelude(
    prelude: gunbc_ci_org_admin_app_token_prelude(),
    source_roots: witness_layer_roots,
    entry: gunbc_ci_org_runner_roster_observe_target.entry,
    function: gunbc_ci_org_runner_roster_observe_target.function,
    claim_run: false,
    receipt_rel: none
  )
}
