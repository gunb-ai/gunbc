module gunbc.fleet.fleet_main_revision

import std.types { String, Bool, Int }
import extdeps.git.object_store { GitObjectId, git_object_id_eq, git_object_id_from_untagged_hex, git_object_id_wire_hex }
import extdeps.git.inspect {
  MergeBaseOutcome,
  MergeBaseReported,
  NoCommonAncestor,
  MergeBaseRefused,
  merge_base_outcome,
}
import gunbc.live_deploy.revision {
  DeployRevisionRelation,
  revision_relation_from_ancestry_facts,
  SameRevision,
  DeployedIsAncestor,
  CandidateIsAncestor,
  UnrelatedHistories,
  DivergedHistories,
  RelationUnverifiable,
}

// After fleet-desired withdrawal the admitted revision is what has landed on origin/main.
// Every landing passed the required witnesses job on its PR. Standing is ancestry against
// that head, not a second ref the fleet advances.

data fleet_landed_main_ref_name: String = "refs/heads/main"

type ObservedRemoteRevision
  = RemoteRevisionPresent { revision: GitObjectId }
  | RemoteRevisionAbsent
  | RemoteRevisionUndecodable { advertised: String }
  | RemoteRevisionUnobserved { cause: String }

fn observed_remote_revision_target(d: ObservedRemoteRevision) -> GitObjectId? {
  match d {
    RemoteRevisionPresent { revision: r } => Present { value: r }
    RemoteRevisionAbsent => none
    RemoteRevisionUndecodable { advertised: _ } => none
    RemoteRevisionUnobserved { cause: _ } => none
  }
}

fn converge_target_revision(observed: ObservedRemoteRevision) -> GitObjectId? {
  observed_remote_revision_target(d: observed)
}

type FleetRevisionRelationObservation {
  current: GitObjectId
  accepted: GitObjectId
  relation: DeployRevisionRelation
}

fn fleet_revision_relation_from_merge_base(
  current: GitObjectId,
  accepted: GitObjectId,
  exit_code: Int,
  base_hex: String,
  stderr: String,
) -> FleetRevisionRelationObservation {
  FleetRevisionRelationObservation {
    current: current,
    accepted: accepted,
    relation: merge_base_relation(
      current: current,
      accepted: accepted,
      exit_code: exit_code,
      base_hex: base_hex,
      stderr: stderr,
    ),
  }
}

fn merge_base_relation(
  current: GitObjectId,
  accepted: GitObjectId,
  exit_code: Int,
  base_hex: String,
  stderr: String,
) -> DeployRevisionRelation {
  if git_object_id_eq(left: current, right: accepted) {
    SameRevision
  } else {
    match merge_base_outcome(exit_code: exit_code, stdout: base_hex, stderr: stderr) {
      NoCommonAncestor => UnrelatedHistories
      MergeBaseReported { base_hex: hex } =>
        match git_object_id_from_untagged_hex(hex: hex) {
          Present { value: base } =>
            relation_from_merge_base_oid(current: current, accepted: accepted, base: base)
          none =>
            RelationUnverifiable {
              cause: concat("git merge-base succeeded but its output is not a decodable object id: ", hex),
            }
        }
      MergeBaseRefused { exit_code: _, stderr: why } =>
        RelationUnverifiable {
          cause: concat("git merge-base could not answer for this pair: ", why),
        }
    }
  }
}

fn relation_from_merge_base_oid(
  current: GitObjectId,
  accepted: GitObjectId,
  base: GitObjectId,
) -> DeployRevisionRelation {
  revision_relation_from_ancestry_facts(
    same: git_object_id_eq(left: current, right: accepted),
    deployed_is_ancestor_of_candidate: git_object_id_eq(left: base, right: current),
    candidate_is_ancestor_of_deployed: git_object_id_eq(left: base, right: accepted),
  )
}

// current is the local (or candidate) tree; accepted is origin/main head.
// Landed = equal to main, or an ancestor of main (behind tip, still on the landed line).
// Not landed = ahead of main, diverged, or unrelated. Unverifiable is not a landing
// verdict: the merge-base was not observed, so the answer is unobserved, not "not on main".
type LandedOnMainVerdict
  = RevisionLandedOnMain
  | RevisionNotLandedOnMain { relation: DeployRevisionRelation }
  | RevisionLandedUnobserved { cause: String }

fn classify_landed_on_main(relation: DeployRevisionRelation) -> LandedOnMainVerdict {
  match relation {
    SameRevision => RevisionLandedOnMain
    DeployedIsAncestor => RevisionLandedOnMain
    CandidateIsAncestor => RevisionNotLandedOnMain { relation: relation }
    UnrelatedHistories => RevisionNotLandedOnMain { relation: relation }
    DivergedHistories => RevisionNotLandedOnMain { relation: relation }
    RelationUnverifiable { cause: c } => RevisionLandedUnobserved { cause: c as String }
  }
}

// THE UNGATED FLEET-DESIRED ADVANCE WAS DELETED, and the deletion is the point. What stood in
// gunbc.srv1_tasks_observation_step (a module deleted unconsumed at gunbc.plans.closure_consolidation
// P5, which also carried this receipt) was gunbc_ci_advance_fleet_desired_script, a concat-built shell step that pushed $GITHUB_SHA
// onto refs/fleet/desired — with a compare-and-swap on the observed prior on the advance branch,
// and on the CREATE branch a bare `git push origin "$GITHUB_SHA:$DESIRED_REF"` carrying no lease at
// all, the branch that runs when the ref does not yet exist.
//
// The CAS half was correct. The ADMISSION half did not exist: gunbc.fleet.fleet_main_revision requires
// the desired revision to derive from merged, FLOOR-GREEN main and models that gate as
// decide_fleet_desired_advance, and this script never called it — so the gate's only caller was its
// own witness test while the unproven path ran on every push to main. That is exactly the raw-HEAD
// advance the authority names as its prevented class, and it reached further than the ref:
// gunbc.roadmap.roadmap_belt_actuate gates worker dispatch on revision standing, so a desired ref equal to
// whatever last landed made that gate agree unconditionally, in silence.
//
// The replacement was gunbc.fleet.fleet_desired_admission; that module is withdrawn and admission is landed origin/main. Its decision consulted the modeled gate with a
// floor conclusion observed from the floor run's own workflow_run payload, and renders the
// authorized push itself so the surrounding shell carries no ref, revision or prior. It is cut at
// the root rather than kept beside the replacement: two answers to how the fleet's admitted
// revision advances is the fork gunbc.design_argument::single_authority forbids, and the weaker one was live. A function
// that can still render the raw form leaves the unsafe spelling one call site from returning. The
// script's only other consumers were gunbc.live_deploy_workflow and its witness file, both deleted
// with the deploy workflow authority.
//
// The Scaffold disposition and dissolution trigger tracking this script's medium-as-string debt
// went with it — the replacement's actuation is a model-rendered script, so that debt is
// re-declared where the remaining shell lives, not inherited here.
//
// This annotation was itself a merge conflict: the root cut and the admission change each deleted
// this script and each wrote its own account. Two annotations for one deletion is the duplication
// gunbc.design_argument::single_authority forbids, so they are merged here, and the accompanying `data ..._deleted_note: String`
// row is dropped — a String declaration whose sole purpose is commentary is the misplaced data
// gunbc.design_argument::source_annotations names.
//
// THIS RECEIPT TRAVELS: it was relocated from gunbc.srv1_tasks_observation_step, whose last two
// declarations (the srv1 tasks observation target and invoke) were deleted unconsumed at
// gunbc.plans.closure_consolidation P5, and it lives here beside the fleet desired-revision domain.
