// ONE JOIN of procurement lots the operator owns. Spark lots stay in
// gunbc.fleet_physical_inventory; this module continues that allocator and adds the
// remaining completed purchases plus tax standing. Completeness is this list, not a count.
//
// THIS POPULATION IS A FLOOR. Closing it requires: (1) dredged component receipts for
// srv1-srv4 assemblies, (2) acquisition records for switch/printers/AMS/PDU/pi/coolers,
// (3) a tax line for the eBay Spark pair and the DIMM lot, (4) unit identities for the
// Mt. Collins twenty and the Q80 sixty-two once serials are read. Until then a tax review
// over this join is still a floor in DESIGN section 5's sense.

type AcquisitionCensusStanding
  = CensusClosed
  | CensusFloor { close_by: NonEmptyStr }

data fleet_acquisition_census_standing: AcquisitionCensusStanding = CensusFloor {
  close_by: "Dredge srv1-srv4 component receipts; read peripheral purchase records; transcribe the eBay Spark and DIMM tax lines; bind Mt. Collins and Q80 units to identities after serials are read" as NonEmptyStr,
}

data nyc_use_tax_residual: UseTaxResidualStanding = ResidualUseTaxOwed {
  destination_jurisdiction: "New York City" as NonEmptyStr,
  destination_combined_rate: nyc_combined_sales_tax_rate,
}

fn private_received_lot(
  identity: InventoryLotIdentity,
  catalog: LotCatalogIdentity,
  display_label: NonEmptyStr,
  quantity_acquired: Nat,
) -> ProcurementLot {
  ProcurementLot {
    identity: identity,
    receipt: ReceiptHeldPrivately,
    catalog: catalog,
    display_label: display_label,
    quantity_acquired: quantity_acquired,
    landed_cost: LandedCostHeldPrivately,
  }
}

fn acquired_and_received(lot: ProcurementLot) -> List<InventoryEvent> {
  [
    LotAcquired { lot: lot.identity },
    LotReceived { lot: lot.identity, quantity: lot.quantity_acquired },
  ]
}

