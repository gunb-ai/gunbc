data dimm_lot_tax: LotTaxEvidence = LotTaxEvidence {
  lot: dimm_lot_64gib_32x.identity,
  standing: SalesTaxTreatmentUnrecorded {
    read_obligation: "DIMM lot tax treatment is not in the public corpus and was not relayed; read the held receipt" as NonEmptyStr,
  },
}

data spark_micro_center_lot_tax: LotTaxEvidence = LotTaxEvidence {
  lot: dgx_spark_micro_center_lot.identity,
  standing: SalesTaxCollected {
    collection: RateTranscribedFromNamedReceiptLine {
      jurisdiction: "New Jersey Urban Enterprise Zone" as NonEmptyStr,
      rate: nj_uez_reduced_sales_tax_rate,
      receipt_line_label: "New Jersey UEZ Tax" as NonEmptyStr,
    },
    residual: nyc_use_tax_residual,
  },
}

data spark_ebay_lot_tax: LotTaxEvidence = LotTaxEvidence {
  lot: dgx_spark_ebay_pair_lot.identity,
  standing: SalesTaxIncludedJurisdictionUnread {
    read_obligation: "Marketplace-collected tax; jurisdiction and rate unverified. Do not assume the Micro Center UEZ rate" as NonEmptyStr,
  },
}

data mt_collins_lot_tax: LotTaxEvidence = LotTaxEvidence {
  lot: mt_collins_lot_identity,
  standing: SalesTaxCollected {
    collection: RateDerivedFromReceiptBaseAndTax {
      jurisdiction: "New Jersey statewide" as NonEmptyStr,
      rate: nj_statewide_sales_tax_rate,
    },
    residual: nyc_use_tax_residual,
  },
}

data q80_lot_tax: LotTaxEvidence = LotTaxEvidence {
  lot: q80_lot_identity,
  standing: SalesTaxAttestedIncluded {
    jurisdiction: "New York" as NonEmptyStr,
    residual: ResidualUseTaxNone,
    attestation: "Operator attests New York tax was paid. The private corpus also has an all-in planning figure that divides by the NYC rate; that is not a receipt tax line" as NonEmptyStr,
  },
}

data altrad8ud_board_lot_tax: LotTaxEvidence = LotTaxEvidence {
  lot: altrad8ud_board_lot_identity,
  standing: SalesTaxAttestedIncluded {
    jurisdiction: "New York" as NonEmptyStr,
    residual: ResidualUseTaxNone,
    attestation: "Operator attests New York tax was paid. The private corpus states in its own words that whether the displayed Newegg total includes tax was not recorded; a receipt reading has not been done" as NonEmptyStr,
  },
}

fn unrecorded_tax(lot: InventoryLotIdentity) -> LotTaxEvidence {
  LotTaxEvidence {
    lot: lot,
    standing: SalesTaxTreatmentUnrecorded { read_obligation: tax_treatment_unread },
  }
}

data fleet_lot_tax_evidence: List<LotTaxEvidence> = [
  dimm_lot_tax,
  spark_micro_center_lot_tax,
  spark_ebay_lot_tax,
  mt_collins_lot_tax,
  q80_lot_tax,
  altrad8ud_board_lot_tax,
  unrecorded_tax(lot: switch_lot_identity),
  unrecorded_tax(lot: printer_01_lot_identity),
  unrecorded_tax(lot: printer_02_lot_identity),
  unrecorded_tax(lot: ams_lot_identity),
  unrecorded_tax(lot: pdu_lot_identity),
  unrecorded_tax(lot: pi_controller_lot_identity),
  unrecorded_tax(lot: cooler_srv3_lot_identity),
  unrecorded_tax(lot: cooler_srv4_lot_identity),
]

fn fleet_ledger_identities() -> List<InventoryLotIdentity> {
  map(fleet_acquisition_ledgers, e => e.lot.identity)
}

data fleet_residual_owed_lots: List<InventoryLotIdentity> = [
  dgx_spark_micro_center_lot.identity,
  mt_collins_lot_identity,
]

data fleet_attested_lots: List<InventoryLotIdentity> = [
  q80_lot_identity,
  altrad8ud_board_lot_identity,
]

data fleet_unread_tax_lots: List<InventoryLotIdentity> = [
  dimm_lot_64gib_32x.identity,
  dgx_spark_ebay_pair_lot.identity,
  switch_lot_identity,
  printer_01_lot_identity,
  printer_02_lot_identity,
  ams_lot_identity,
  pdu_lot_identity,
  pi_controller_lot_identity,
  cooler_srv3_lot_identity,
  cooler_srv4_lot_identity,
]

fn fleet_tax_join_covers_every_ledger() -> Bool {
  match lot_tax_covers_ledgers(lots: fleet_ledger_identities(), tax: fleet_lot_tax_evidence) {
    LotTaxJoinCovered { rows: rows } =>
      lot_identities_cover(held: residual_owed_lots(rows: rows), expected: fleet_residual_owed_lots)
        && lot_identities_cover(held: attested_lots(rows: rows), expected: fleet_attested_lots)
        && lot_identities_cover(held: unread_or_unrecorded_lots(rows: rows), expected: fleet_unread_tax_lots)
    LedgerMissingTax { lot: _ } => false
    TaxWithoutLedger { lot: _ } => false
    LotTaxJoinRepeatedLot { lot: _, first_ordinal: _, ledger_ordinal: _ } => false
  }
}
