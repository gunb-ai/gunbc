  approval_poll_overrun_ticks, approval_poll_no_post_decision_work, approval_credential_bounded_window,
}

// HOW LONG THE OPERATOR HAS TO DECIDE THE PRINT-START BED-CLEAR CARD.
//
// THE DECISION WINDOW IS NOT STATED HERE: it is one row in the module that owns approvals
// (gunbc.auth.approval_gate approval_request_window, four hours by operator ruling 2026-11-05), and
// this module READS it. The 900 s this row used to carry was the operator request of 2026-11-10 --
// the bed-clear card for printer-01 (run 42919682079) closed fifteen minutes after it was filed,
// while nobody was watching the inbox, and the print died as `ApprovalExpired` on a decision nobody
// had refused. Four hours is what the fleet decided a human gets; a card that grants less than the
// policy in one place is the restated-literal bug DESIGN's worked example on the seven submit
// deadlines names: two values that agree are two chances to disagree.
//
// WHAT MAKES THIS A SITE-LOCAL DERIVATION AND NOT A COPY is the credential the run presents AFTER the
// decision. The CI route's credential source is the Secret Manager arm (gunbc.fleet.printer_workflow_run
// printer_secret_manager_credential_source), so the post-admission path reads the printer's access code
// from Secret Manager with the job's workload-identity token -- and that token was minted by the WIF
// auth step BEFORE this function began to poll (gunbc.fleet.fleet_converge_workflow
// fleet_converge_printer_job passes steps.wif_auth.outputs.access_token into the step's environment).
// A Google access token lives 3600 s (gunbc.auth.access_token_source
// workload_identity_access_token_lifetime) and nothing in our workflow asks for more. So the card may
// stay open only as long as the credential that acts on the decision still works: open it longer and
// the operator's YES is answered by a 401, which is #16160's ACCESS_TOKEN_EXPIRED failure with a
// human's approval behind it -- worse than an expired card, because the human believes they acted.
// The honest alternatives are to mint after the decision (split the run so the credential is federated
// once the grant exists, as gunbc.auth.gcp_iam_converge_run's actuation auth step and
// gunbc.fleet.srv1_root_mutation_approval_run's admitted-only mint already do) or to hold no Google
// identity at all on this path (the host-custody arm). Both are structural; neither is this change.
// Until one lands, the ceiling below is what this card honestly offers, and the claim in
// dag/test/claim/fleet/operator_approval_window_witness.dag is RED if the window ever exceeds
// the credential that has to survive it.
data printer_approval_pre_decision_allowance: Second = second(count: 300)
// WHAT THE RUN SPENDS AFTER THE DECISION BEFORE THE TOKEN IS PRESENTED: the state re-read
// (start_authorized refuses if the bed moved while the operator was deciding -- the re-check that makes
// a long window safe at all), the Secret Manager credential read, the claim, the upload and the start.
// SIZED, not measured: 300 s is the order of a Secret Manager read plus a LAN start, and the same row
// is what the step timeout is built from, so a run that needs longer is caught by the step bound
// before it is caught by an expired token. MEASURE IT on the first hours-long card and correct this row.
data printer_approval_post_decision_allowance: Second = second(count: 300)

// THE POLL'S CADENCE IS A SITE FACT, not the window: how often this run re-reads its own filing. Ten
// seconds is how quickly an operator's tap turns into a print; the tick BUDGET below is derived from
// the window and this cadence and is never counted off independently.
data printer_operator_approval_poll_cadence: Second = second(count: 10)

// WHAT THE RUN SPENDS BEFORE IT EVEN ASKS, on the token's clock: CAD and slicing on this host. It needs no
// Google identity, and it is lived entirely by the token that will be presented after the tap, because
// fleet_converge_printer_job federates at its WIF auth step and the run step that follows prepares, files,
// waits and then reads. MOVED HERE from gunbc.fleet.fleet_converge_workflow, which still reads it for the
// step bound: it used to live where the ceiling could not see it, and that is how 1800 s of preparation got
// a card's whole credential budget spent twice over (review 93521 on gunbc#16304). One row, one home; the
// step bound and the ceiling both read it. 1800 s is the preparation share of the retired 45-minute budget,
// SIZED from that budget rather than measured, and printer_preparation_timeout_minutes is the operation's
// own bound.
data printer_converge_preparation_allowance: Second = second(count: 1800)

// WHAT THE TOKEN AGES THROUGH BEFORE THE OPERATOR ANSWERS: the preparation above, then the filing of the
// card. Both are after the mint, so the ceiling pays for both.
fn printer_approval_credential_pre_decision_spend() -> Second {
  let before_the_ask = nat_to_int(n: second_count(s: printer_converge_preparation_allowance)) +
    nat_to_int(n: second_count(s: printer_approval_pre_decision_allowance))
  second(count: nat_magnitude(a: before_the_ask))
}

// The credential ceiling on the window: the token's life, minus everything it ages through before the
// operator answers (preparation, then the filing), minus what is spent after the grant arrives, AND minus
// the reserve the poll is granted past its own deadline -- one rule, in the module that owns the poll budget
// (gunbc.auth.approval_gate approval_credential_bounded_window), so the ceiling and the tick budget cannot
// disagree about how late a poll may still answer. Each term has been omitted once and each omission is a
// bug: without the reserve a boundary YES was answered 3640 s into a 3600 s token; without the preparation
// the card assumed a token that had already spent half an hour slicing (review 93521). Today's honest
// ceiling is 3600 - 1800 - 300 - 300 - 40 = 1,160 s, 19 min 20 s: 4 min 20 s LONGER than the hand-written
// 900 s on main, and the first value this card has had that is bounded by the credential rather than by a
// deadline someone typed. Main was not over its token -- 900 + 1800 + 300 + 300 + 40 = 3,340 of the 3,600
// available -- so the over-budget card was introduced by this PR's first ceiling, which could not see the
// preparation, and it is closed by this one. It is not hours, and it cannot be while the token is
// federated at the top of the job: minting after the decision is what restores the policy row.
// No absorbing default: a ceiling that computes to zero or below stays zero, which turns the claim RED and
// stops the card rather than silently handing the operator a window the credential cannot honour.
fn printer_approval_credential_ceiling() -> Second {
  approval_credential_bounded_window(
    lifetime: workload_identity_access_token_lifetime,
    pre_decision_allowance: printer_approval_credential_pre_decision_spend(),
    post_decision_allowance: printer_approval_post_decision_allowance,
    cadence: printer_operator_approval_poll_cadence,
    overrun_ticks: approval_poll_overrun_ticks
  )
}

fn printer_operator_approval_window() -> Second {
  if nat_to_int(n: second_count(s: approval_request_window))
    <= nat_to_int(n: second_count(s: printer_approval_credential_ceiling())) {
    approval_request_window
  } else {
    printer_approval_credential_ceiling()
  }
}

// THE RESERVE, and the rule that spends it, are the fleet's now, not this module's:
// gunbc.auth.approval_gate approval_poll_overrun_ticks / approval_poll_tick_budget /
// approval_poll_step_timeout_minutes. What stays local is what is genuinely local -- the cadence an
// operator's tap turns into a print, and the two allowances the Secret Manager read and the print itself
// need around the wait.

// TICKETS ARE DERIVED, never restated: ceiling(window / cadence) covers the whole window -- the 90 this
// call site used to hand-write was 900 s over a 10 s cadence, a second copy of a number the window
// already owns -- and the overrun covers the deadline read itself.
fn printer_operator_approval_poll_tick_budget() -> Int {
  approval_poll_tick_budget(
    window: printer_operator_approval_window(),
    cadence: printer_operator_approval_poll_cadence,
    overrun_ticks: approval_poll_overrun_ticks
  )
}

// WHAT THE RUNNER IS TOLD TO WAIT: prelude + window + the overrun reads + the post-decision delivery +
// margin. The step bound is a CEILING, not the run's duration, so it is allowed -- required -- to cover
// the whole window; the run ends early the moment the operator answers.
data printer_approval_step_margin: Second = second(count: 180)

fn printer_approval_step_timeout_minutes() -> Minute {
  approval_poll_step_timeout_minutes(
    window: printer_operator_approval_window(),
    cadence: printer_operator_approval_poll_cadence,
    overrun_ticks: approval_poll_overrun_ticks,
    pre_decision_allowance: printer_approval_pre_decision_allowance,
    post_decision_allowance: printer_approval_post_decision_allowance,
    step_margin: printer_approval_step_margin
  )
}

// The ntfy approval adapter: it files the start request, polls for the signed grant and hands
// that grant to gunbc.fleet.printer_actuation start_authorized, which owns every physical effect.
// The human approves the printer state read before filing; start_authorized re-reads it and
// refuses if it moved.
fn approve_and_print(claims: PrinterStartClaims, evidence: StartEvidenceStore, printer: String, path: String, digest: String, version: String, attempt: String, credential_source: PrinterCredentialSource, ams_tray: BambuAmsTray) -> ProcessExit {
  let host=os.Hostname.ReadShort()
  if !host.success || trim(s:host.value)!=(printer_lan_host_identity() as String) {
    return exit_failure(reason:"Print starts must run on the modeled printer LAN host so approvals share one durable claim store")
  }
  if path == "" || attempt == "" || !print_inputs_admitted(version: version, digest: digest) {
    return exit_failure(reason: "Print requires a path, digest, numeric credential version and attempt")
  }
  if !printer_mqtt_tool_ready() { return exit_failure(reason: "MQTT tool is not ready; nothing requested or sent") }
  let p = match select_printer(name: printer) { PrinterSelected { printer: x } => x PrinterSelectionRefused => return exit_failure(reason: "Unknown printer") }
  let session = match read_existing_printer_session(printer:p,version:version as NonEmptyStr,credential_source:credential_source) {
    PrinterSessionRefused {cause:c}=>return exit_failure(reason:c as String)
    PrinterSessionReady {session:s}=>s
  }
  let report = match report_using_session(session:session) {
    ProcessOutputPresent {text:t}=>t
    ProcessOutputAbsent=>return exit_failure(reason:"Printer report empty; no approval requested")
    ProcessRefused {exit_code:_,stderr:_}=>return exit_failure(reason:"Printer report unreadable; no approval requested")
  }
  if !report_allows_start(text:report) { return exit_failure(reason:"Printer is not ready; no approval requested") }
  let state = match printer_state_generation(text:report) {Present {value:g}=>g Absent=>return exit_failure(reason:"Printer state cannot be identified; no approval requested")}
  match print_request(printer: p, digest: digest, version: version, attempt: attempt, printer_state: state, ams_slot: ams_tray.index + 1) {
    Absent => exit_failure(reason: "Cannot identify print request")
    Present { value: request } => match approval_instant_now() {
      Absent => exit_failure(reason: "Cannot read clock")
      Present { value: now } => {
        let expires = approval_expires_at(issued: now, window: printer_operator_approval_window())
        let stored = stored_request_from_authorization(request: request, issued_at: now, expires_at: expires)
        match approval_file_stored_request(stored: stored, body_file_name: concat(printer, "-approval.json"), submit_timeout: second(count: 30)) {
          ApprovalFilingRefused { reason: r } => exit_failure(reason: r)
          ApprovalFiled => match approval_poll_ticks(remaining: printer_operator_approval_poll_tick_budget(), cadence: printer_operator_approval_poll_cadence, escalation_id: request.escalation_id, expires_at: expires) {
            PollClockUnreadable => exit_failure(reason: "Cannot read approval clock")
            PollBudgetExhausted { escalation_id: _, observed_at: _ } => exit_failure(reason: "Print approval did not arrive; nothing sent")
            PollObservedAt { standing: s, observed_at: at } => match approval_gate_from_poll(poll: s, request: request, observed_at: at) {
              GateRefused { cause: c } => exit_failure(reason: approval_refusal_text(cause: c))
              GateAdmitted { authorization: authorization } =>
                start_authorized(claims:claims,evidence:evidence,printer:p,path:path,digest:digest,version:version as NonEmptyStr,credential_source:credential_source,session:session,authorization:authorization,request:request,ams_tray:ams_tray)
            }
          }
        }
      }
    }
  }
}

// Called only behind current, job-bound approval of a physically cleared bed.
// Neither IDLE nor FINISH establishes bed clearance; the approval owns that evidence.
