module gunbc.fleet.organization_runner_roster_read_credential

import std.types { List, String }
import extdeps.github.app {
  GitHubAppInstallationId, GitHubAppPermission, GitHubInstallationTokenRequest, SelectedPermissions,
  RepositoryNarrowingOmitted, OrganizationSelfHostedRunnersAxis, AppAccessRead, installation_token_request_body
}

// THE ROSTER READ NEEDS ONE PERMISSION AT ONE ACCESS: organization_self_hosted_runners READ. The in-run mint
// of the gunbai-ci installation token asks GitHub for exactly that, so a step that only reads the org
// roster holds a token that cannot register or delete a runner. The unnarrowed mint
// (gunbc.ci.ci_spec org_admin_app_token_mint) carries the installation's full permissions, including the
// organization_self_hosted_runners WRITE that GenerateOrganizationJitConfig needs; a reader that took it
// would hold authority its read does not use.
//
// The permission set is this module's single fact; the request body is rendered by the upstream's own
// renderer (extdeps.github.app installation_token_request_body), never spelled inline. gunbc.auth does not
// yet model permission profiles (access_token_source selects a token SOURCE, not a scope), so the profile
// lives with the consumer that states what it needs; when gunbc.auth gains a permission-profile selection
// this row moves under it.
data organization_runner_roster_read_permissions: List<GitHubAppPermission> = [
  GitHubAppPermission { name: OrganizationSelfHostedRunnersAxis, access: AppAccessRead }
]

fn organization_runner_roster_read_token_request(installation: GitHubAppInstallationId) -> GitHubInstallationTokenRequest {
  GitHubInstallationTokenRequest {
    installation_id: installation,
    repositories: RepositoryNarrowingOmitted,
    permissions: SelectedPermissions { permissions: organization_runner_roster_read_permissions }
  }
}

fn organization_runner_roster_read_token_request_body(installation: GitHubAppInstallationId) -> String {
  installation_token_request_body(request: organization_runner_roster_read_token_request(installation: installation))
}
