module gunbc.fleet.fleet_host_truth_sources

// THE READ HAS SOURCES. gunbc.fleet.fleet_host_truth_read judges a read against a declaration and never goes
// to the machine itself, on purpose: a comparison that also owned the route to the host could not be checked
// without the host, which is how the report's tiers got found by collision instead of by a schedule. The
// reads still have to come from somewhere, and that somewhere already exists in this repository. The
// memory-envelope read-back prints a host's cgroup leaf caps and its swap backing
// (gunbc.host.host_memory_envelope_observe). The fleet host-key enrollment is the authority on which
// fingerprint each host is supposed to present (gunbc.fleet.fleet_host_key_enrollment). This module turns
// what those carriers captured into the read sum that module judges. It reads no host of its own: each of
// those modules owns its route, and re-deriving what they read would set up a second authority over a fact
// that already has one (gunbc.design_argument::single_authority).
//
// WHAT IT DOES WHEN A SOURCE HAS NO ANSWER is the report's tier 4 applied to this module: a source that came
// back empty is a typed refusal, never a zero, never an empty column, never agreement. So a cgroup property
// unset at the leaf refuses (an inherited limit is neither zero nor infinity), a slice the envelope did not
// report refuses, and a host that presented nothing is the blank arm rather than a fingerprint of the empty
// string. And the two ways a cgroup property fails to answer -- it printed nothing, or it printed something
// nobody can read -- are kept apart, by host_truth_absent_cause below, because a refusal that names the wrong
// one is a fabricated located cause even though it still refuses.
//
// THREE OF THE FIVE AXES are inhabited here, the three the report's own specimens named: the cap that
// surfaced as 5.1 tok/s with 41.5 GB read per request instead of refusing (3.2, srv4's leaf), the swap
// backing the envelope refuses on (3.3, butch's 8 GiB /swap.img at priority -2), and the identity pinned to
// an address (2.1, butch at .238 holding another machine's host key).
//
// THE TWO AXES NOT INHABITED HERE -- the PCI class count and the enabled-unit list -- are a DECLARED
// FRONTIER, not a dangling declaration (gunbc.design_argument::consumption): the observe-only converge mode
// authorized by gunbc.design_ruling::fleet_truth_read_rides_the_converge_timer_2026_11_21 reads both at the
// same firing it takes the three here, and the inhabitance claims for them fall due with that mode, together
// with the roster admission that consumes the verdict (the -rosters-consume-the-read item in
// gunbc.roadmap.roadmap_authority). A per-axis producer that is not written yet is absent from this module;
// nothing here answers for it.

import std.types { NonEmptyStr, String }
import std.measure { ByteSize }
import std.nat { Nat }
import std.optional { Present, Absent }
import extdeps.systemd {
  SystemdCgroupPropertyAnswer,
  PropertyLimit,
  PropertyUnbounded,
  PropertyPrintedNothing,
  PropertyUndecodable,
}
import gunbc.fleet.fleet_host_key_enrollment { enrolled_fingerprint_for }
import gunbc.fleet.fleet_host_truth_read {
  HostTruthAxis,
  HostTruthExpectation,
  HostTruthRead,
  HostTruthValue,
  TruthSize,
  TruthUnbounded,
  TruthMarking,
  HostTruthObserved,
  HostTruthReadBlank,
  HostTruthReadRefused,
  HostTruthDeclared,
  HostTruthNothingDeclared,
  HostTruthReadCause,
  HostTruthNoValueAtThatPath,
  HostTruthOutputUnparseable,
  TruthCapBindsDeclaredWorkingSet,
  TruthSlotSwapBackingDeclared,
  TruthIdentityAnchoredNotAddressed,
  host_truth_host_text,
}

// THE SOURCE, SAID OUT LOUD IN EVERY RECEIPT. A read that cannot say which carrier produced it is the empty
// power column again: the number arrives, and nobody can tell a zero the machine answered from a probe that
// never ran. Each function below stamps the carrier module and the receipt path it read from.
fn host_truth_source_receipt(carrier: String) -> String {
  "gunbc.fleet.fleet_host_truth_sources <- " + carrier
}

// ONE PROPERTY, FOUR ANSWERS, AND NOT ONE OF THEM DECIDED HERE. systemd's cgroup property can print a
// number, print "infinity", print nothing, or print something nobody can read. The first two are values; the
// last two are both "no" and they are not the same fact -- a leaf that set nothing inherits its limit from
// the parent slice, while unreadable output says nothing at all about what the limit is. Saying "printed no
// value" about a machine that printed "8G" would be a fabricated located cause even inside a refusal
// (gunbc.design_argument::epistemic_humility: "Do not assert as deduced what is only inferred";
// gunbc.design_argument::fail_closed: "a wrong answer is a loud, typed, located error, never a plausible
// fabrication").
//
// WHICH OF THE FOUR IT WAS is decided exactly once, in the module that owns systemd's output:
// extdeps.systemd::parse_systemd_cgroup_property_shown, beside the parser whose answer it reads, and next to
// the cpu-quota sum in that file that already keeps absent and undecodable apart. What follows is an adapter
// from that typed answer to this read's own cause sum -- a translation of names, not a second reading of the
// text. That is deliberate: gunbc.design_argument::single_authority refuses "a second place that
// independently decides" the meaning, so these reads take ONE input the parser produced rather than a parsed
// value plus the raw text a caller could pair wrongly.
//
// THE ARM THAT IS OWED, and not taken here: an undecodable arm on SystemdCgroupMemoryLimit itself, which
// would put the distinction in the sum every one of the ten modules matching on it sees. That ripple reaches
// files with other lanes' PRs in flight, and each of those consumers has to decide what unreadable output
// means for its own refusal, so the arm is owed and tracked -- by
// gunbc.recurring_failure_mode::failed_value_read_scored_as_value_absent, whose receipt names it, the matchers
// involved and this function as the standing workaround -- rather than landed quietly from the serving lane.

// WHAT THE PATH-NAMING CAUSE SAYS, once the parser has already said which "no" it was: the property, whose
// leaf, and what the machine actually did -- print nothing -- and therefore what follows (the unit sets none,
// so the limit comes from its parent slice). A unit that does not exist at all is refused upstream, by
// systemd_unit_status_exists_show, before either read is reached.
fn host_truth_cgroup_no_value_path(property: String, host: NonEmptyStr) -> String {
  property + " at " + host_truth_host_text(host: host) + "'s leaf: systemctl show printed no value, so the unit sets none and the limit is inherited from its parent slice"
}

// A CGROUP LIMIT, AS THE VALUE ITS AXIS RELATES. systemd's four answers stay four here: a number,
// "infinity", printed nothing, and unreadable output. Collapsing the third or fourth into the first two is
// the fail-open move the report's tier 4 names, in the opposite direction: srv4's leaf would have been
// "unbounded" (so the 5x cliff passes) or "zero" (so a healthy host is refused), and neither is what the
// machine said. The caller hands over what the parser answered, whole.
fn host_truth_cap_read(host: NonEmptyStr, at_run: NonEmptyStr, answer: SystemdCgroupPropertyAnswer) -> HostTruthRead {
  match answer {
    PropertyLimit { bytes: b } => HostTruthObserved {
      host: host,
      axis: TruthCapBindsDeclaredWorkingSet,
      observed: TruthSize { size: b },
      at_run: at_run,
      receipt: host_truth_source_receipt(carrier: "gunbc.host.host_memory_envelope_observe memory.high")
    }
    PropertyUnbounded => HostTruthObserved {
      host: host,
      axis: TruthCapBindsDeclaredWorkingSet,
      observed: TruthUnbounded,
      at_run: at_run,
      receipt: host_truth_source_receipt(carrier: "gunbc.host.host_memory_envelope_observe memory.high=infinity")
    }
    PropertyPrintedNothing => HostTruthReadRefused {
      host: host,
      axis: TruthCapBindsDeclaredWorkingSet,
      cause: HostTruthNoValueAtThatPath { path: host_truth_cgroup_no_value_path(property: "memory.high", host: host) }
    }
    PropertyUndecodable { raw: r } => HostTruthReadRefused {
      host: host,
      axis: TruthCapBindsDeclaredWorkingSet,
      cause: HostTruthOutputUnparseable { raw: r }
    }
  }
}

// THE SWAP CEILING A LEAF CARRIES, from the same reading. This is the cgroup's side of the swap question;
// the host's own backing is below, and the two are different facts about different places.
fn host_truth_leaf_swap_read(host: NonEmptyStr, at_run: NonEmptyStr, answer: SystemdCgroupPropertyAnswer) -> HostTruthRead {
  match answer {
    PropertyLimit { bytes: b } => HostTruthObserved {
      host: host,
      axis: TruthSlotSwapBackingDeclared,
      observed: TruthSize { size: b },
      at_run: at_run,
      receipt: host_truth_source_receipt(carrier: "gunbc.host.host_memory_envelope_observe memory.swap.max")
    }
    PropertyUnbounded => HostTruthObserved {
      host: host,
      axis: TruthSlotSwapBackingDeclared,
      observed: TruthUnbounded,
      at_run: at_run,
      receipt: host_truth_source_receipt(carrier: "gunbc.host.host_memory_envelope_observe memory.swap.max=infinity")
    }
    PropertyPrintedNothing => HostTruthReadRefused {
      host: host,
      axis: TruthSlotSwapBackingDeclared,
      cause: HostTruthNoValueAtThatPath { path: host_truth_cgroup_no_value_path(property: "memory.swap.max", host: host) }
    }
    PropertyUndecodable { raw: r } => HostTruthReadRefused {
      host: host,
      axis: TruthSlotSwapBackingDeclared,
      cause: HostTruthOutputUnparseable { raw: r }
    }
  }
}

// THE SWAP THE HOST ACTUALLY CARRIES. The report's 3.3 is about a backing that exists where the model says
// none does: butch came up with an 8 GiB /swap.img at priority -2 while its slot declared no swap at all. A
// zero here is a real answer rather than an absence, which is why it is a value and not a refusal -- the
// envelope reads /proc/meminfo, so "0" means the machine said 0.
fn host_truth_host_swap_read(host: NonEmptyStr, at_run: NonEmptyStr, swap_total: ByteSize) -> HostTruthRead {
  HostTruthObserved {
    host: host,
    axis: TruthSlotSwapBackingDeclared,
    observed: TruthSize { size: swap_total },
    at_run: at_run,
    receipt: host_truth_source_receipt(carrier: "gunbc.host.host_memory_envelope_observe SwapTotal from /proc/meminfo")
  }
}

// THE ANCHOR, TAKEN FROM THE AUTHORITY THAT OWNS IT. The enrolled fingerprint is desired state and the
// fingerprint a host presents is the machine's answer; keeping them apart is the whole of the report's 2.1,
// where butch's new address held another machine's key and the failure was indistinguishable from a man in
// the middle until the two were put side by side. A host with no enrolled row is not compared against
// nothing: the expectation comes back as the model's own gap, so the host lands in the undeclared class and
// is not admitted. That is report 5.3's shape -- a key outside the enrolled roster -- answered by a refusal
// to conclude rather than by a pass, and it is what the -enrolled-key-roster-closed item closes.
fn host_truth_identity_expectation(host: NonEmptyStr, declared_by: String) -> HostTruthExpectation {
  match enrolled_fingerprint_for(host: host_truth_host_text(host: host)) {
    Present { value: fingerprint } => HostTruthDeclared {
      host: host,
      axis: TruthIdentityAnchoredNotAddressed,
      expected: TruthMarking { text: fingerprint },
      declared_by: declared_by
    }
    Absent => HostTruthNothingDeclared {
      host: host,
      axis: TruthIdentityAnchoredNotAddressed,
      because: "no enrolled host-key row for " + host_truth_host_text(host: host) + " in gunbc.fleet.fleet_host_key_enrollment -- an unenrolled key is the model's gap to name, not the host's to fail"
    }
  }
}

// THE FINGERPRINT THE HOST PRESENTED, PROJECTED. The scan step (gunbc.fleet.fleet_host_key_step, whose
// receipt is fleet_host_key_scan_receipt_path) already reads the third field of the known_hosts line through
// extdeps.ssh.known_hosts, so this module takes the projected fingerprint rather than parsing the line a
// second time -- a second parser would be a second authority over which field is the key. An empty
// fingerprint is the blank arm: the read happened and answered nothing, which is a different fact from a
// refusal and both are different from a fingerprint of the empty string.
fn host_truth_identity_read(host: NonEmptyStr, at_run: NonEmptyStr, presented: String) -> HostTruthRead {
  if presented == "" {
    HostTruthReadBlank { host: host, axis: TruthIdentityAnchoredNotAddressed }
  } else {
    HostTruthObserved {
      host: host,
      axis: TruthIdentityAnchoredNotAddressed,
      observed: TruthMarking { text: presented },
      at_run: at_run,
      receipt: host_truth_source_receipt(carrier: "gunbc.fleet.fleet_host_key_step scan receipt, third field of the known_hosts line")
    }
  }
}
