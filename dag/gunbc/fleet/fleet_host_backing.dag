module gunbc.fleet.fleet_host_backing

import std.types { Bool, NonEmptyStr }
import std.decl_ref { DeclarationRef }
import std.measure { ByteSize, HardwareThreadCount }
import extdeps.toolchain.types { Architecture }
import product.fabric.provider_route { ProviderRoute }
import gunbc.fleet.provider_acquisition { ProviderResourceAcquisition }
import gunbc.machine_intake.subject { UnitKey, UnitKeyRefusalCause, UnitKeyStanding }
import gunbc.guarantee_stall { NextRungTrigger, climbs_when }

// WHAT SUPPLIES A FLEET HOST, as a fact separate from what the host is FOR. Backing, provisioning and
// service intent were one fact in practice -- a CI host was assumed to be an owned machine with a BMC
// to converge and an OS to install -- and the assumption made a rented guest owe operations it has no
// subject for. Backing answers only "what physical or provider resource is this host", and the
// facts a rented guest is entitled to travel WITH it, because they are the provider's offer rather
// than anything this repository observes: an Altra package's thread count is not a CAX guest's vCPU
// allocation, and nested virtualization is a property of the provider's product, not of the silicon
// underneath it. What the running guest actually exposes is an observation, carried downstream of
// adoption, never authored here.
//
// This module enumerates no provider. A provider's adapter (gunbc.fleet.hetzner_cloud_guest) builds a
// GuestEntitlement from that provider's cited catalog row, so adding a provider is a new adapter
// beside the others and never a new arm here.

type GuestEntitlement {
  offer: DeclarationRef
  architecture: Architecture
  vcpus: HardwareThreadCount
  memory: ByteSize
  disk: ByteSize
  nested_virtualization: Bool
  self_identity_url: String
}

// THE EXACT PROVIDER RESOURCE. An operation is bound to a provider's resource identifier, never to
// the display name the provider shows, because a display name can be edited, reused or duplicated.
// The binding IS the acquisition (gunbc.fleet.provider_acquisition): the identifier, the account it is held
// under and the credential that drives it arrive together, so no consumer pairs one server's id
// with another account's credential. A host enrolled before its acquisition is recorded carries that
// as a typed obligation naming what would ground it (DESIGN section 4d), so adoption refuses on it
// instead of guessing.
type ProviderResourceBinding
  = ProviderResourceAwaited { read_obligation: NonEmptyStr }
  | ProviderResourceAcquired { acquisition: ProviderResourceAcquisition }

// HOW AN OWNED MACHINE'S OPERATING SYSTEM ARRIVES. This is not implied by ownership: an Ampere
// Altra server is installed over its BMC's virtual media, while an appliance such as a DGX Spark has
// no BMC to converge and provisions itself through its own first boot. A provider guest has no arm
// here because its OS always arrives as the provider's image -- that is what ProviderGuest means --
// so a rented guest owing a BMC operation has no constructor.
type OwnedProvisioning
  = BmcVirtualMediaInstall
  | ApplianceFirstBoot

type HostBacking
  // The `unit` fact is the host-to-hardware allocation: the UnitKey this owned machine
  // is bound to. It is an Optional because a backing row exists the moment a machine is
  // provisioned, but its board serial (the identity that grounds the UnitKey) is only
  // read on first out-of-band observation. Absent means "no board-serial observation has
  // been taken for this row"; Present carries bind_unit_key's standing, which itself keeps
  // UnitKeyBound from UnitKeyRefused (a read serial that duplicates or contradicts is a
  // different fact from a never-read one). An owned machine whose serial was read and found
  // duplicated is not the same fact as one never read.
  = OwnedMachine { provisioning: OwnedProvisioning, unit: UnitKeyStanding? }
  | ProviderGuest { route: ProviderRoute, entitlement: GuestEntitlement, resource: ProviderResourceBinding }

// THE ONE RULE FOR WHETHER A BACKING CAN HOST THE FLEET'S MICROVM EXECUTION PATH, before anything is
// observed: an owned machine can (its readiness is then observed), and a provider guest can only when
// its offer permits nested virtualization. Present names the cited offer that forbids it. Adoption,
// fabric supply and the runner-executor population all read this, so no consumer restates it.
fn backing_microvm_forbidding_offer(backing: HostBacking) -> DeclarationRef? {
  match backing {
    OwnedMachine { provisioning: _ } => none
    ProviderGuest { route: _, entitlement: e, resource: _ } =>
      if e.nested_virtualization { none } else { Present { value: e.offer } }
  }
}

// THE UNIT-KEY ALLOCATION, read off an owned machine's backing row. This is the join between fleet
// identity (the HostIdentity that owns the row) and the physical unit it is bound to. A board swap is
// a change to the row's `unit` standing, and it is what makes a receipt bound to the old unit refuse
// against the new one. The three outcomes are kept distinct -- resolved (the serial was read and
// uniquely bound a key), refused (it was read but the standing is UnitKeyRefused, carrying its cause),
// and unobserved (no board-serial observation has been taken for this row) -- because each has a
// different remedy: resolved is the only outcome from which a unit may be resolved, a refused row
// refuses with its cause, and an unobserved row names the read obligation.
type HostUnitAllocationStanding
  = HostUnitResolved { unit: UnitKey }
  | HostUnitRefused { cause: UnitKeyRefusalCause }
  | HostUnitUnobserved {
      // §4b: A FRONTIER BELOW CEILING NAMES ITS NEXT-RUNG TRIGGER ON A CARRIER, NOT IN PROSE.
      // The old field was a NonEmptyStr the fold matched with `_` -- an obligation only a reader
      // of this file could see. The carrier is the repository's own NextRungTrigger (gunbc.guarantee_stall):
      // the capability names the observation that lifts the row out of unobserved, and `awaiting`
      // stays empty because no OTHER LANE is owed -- the producer is the machine-intake arrival lane:
      // the same identity_bind_provisional derivation gunbc.machine_intake.arrival_converge runs for
      // mtcollins1/mtjade1 (it derives the UnitKey from committed FRU and SMBIOS captures). srv1-4's
      // serials are NOT invented (their observation is the named frontier); when that read lands, the
      // row flips from Unobserved{trigger} to Resolved/Refused at the next bind_unit_key.
      trigger: NextRungTrigger,
    }
  | HostUnitNotOwned

// Provider guests are not physical machines: they carry no UnitKey, and that is correct -- there is
// no board serial to read. They are therefore neither resolved nor unobserved.
fn resolve_host_unit(backing: HostBacking) -> HostUnitAllocationStanding {
  match backing {
    OwnedMachine { provisioning: _, unit: unit_standing } =>
      match unit_standing {
        Absent => HostUnitUnobserved {
          // THE TRAVELLING FORM OF THE OBLIGATION: what observation lifts this row out of
          // unobserved, and who produces it. The capability names the read; the producer is the
          // machine-intake arrival lane -- gunbc.machine_intake.arrival_converge's
          // identity_bind_provisional derives the UnitKey from committed FRU and SMBIOS captures
          // (that is how mtcollins1/mtjade1 got theirs), and srv1-4 reach it the same way once
          // their observation is taken. `awaiting: []` because no other lane is owed first
          // (climbs_when, not climbs_when_awaiting); NO SRV SERIAL IS INVENTED meanwhile.
          trigger: climbs_when("read the owned host's board serial (SMBIOS type 2, or the FRU through its controller) and run bind_unit_key on it, as gunbc.machine_intake.arrival_converge identity_bind_provisional does for the enrolled machines that already have one"),
        }
        Present { value: standing } =>
          match standing {
            UnitKeyBound { key: k } => HostUnitResolved { unit: k }
            UnitKeyRefused { cause: c } => HostUnitRefused { cause: c }
          }
      }
    ProviderGuest { route: _, entitlement: _, resource: _ } =>
      // A provider guest is not a physical machine: there is no board serial to read and no unit to
      // bind, so the allocation is not "unobserved" (which would owe a read) and not "refused" (which
      // would carry a cause) -- it is simply not an owned machine. Naming it keeps a refactor that
      // reclassified a rented guest as a unit visible.
      HostUnitNotOwned
  }
}
