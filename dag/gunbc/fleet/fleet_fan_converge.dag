module gunbc.fleet.fleet_fan_converge

import std.types { Bool, Int, NonEmptyStr, String }
import std.content_hash { ContentHash }
import std.optional { Absent, Present }
import std.decl_ref { DeclarationRef, decl_ref }
import std.dissolution { DissolutionCondition, bound_dissolution }
import product.fan_policy_standing { ConvergeRouteBound, ConvergeRouteUnbound }
import gunbc.fleet.fleet_fan_converge_routes { fan_converge_route_for_family }
import extdeps.bmc.endpoint { AmiMegaRac, BmcFirmwareFamily, OpenBmc }
import extdeps.bmc.megarac_fan_policy { MegaRacFanPwmAllAdmitted, MegaRacFanPwmAllRefused, megarac_fan_pwm_all_of }
import product.host_identity { HostIdentity, host_identity_eq }
import gunbc.machine_intake.fan_observe { FanObserveHost }
import product.fleet_fan_policy { FirmwareAutomatic, FleetFanControl, FleetFanPolicy, HeldAtDutyFloor }

// THE FLEET FAN CONVERGENCE FOLD: desired (product.fleet_fan_policy) against observed, deciding
// Noop / Refuse, then a standing read from an INDEPENDENT second observation.
//
// SELECTION PRECEDES CONVERGENCE (DESIGN 3d): this fold takes ONE host's family and ONE
// observation. Which hosts exist comes from the managed-host registry, not from here.
//
// BOOT IS A CONSUMER AND NEVER A WRITER. Nothing here is imported by a boot path in this change; the
// admission gate that reads FleetFanConvergenceStanding is a separate change that waits on the
// post-power-on fan read.
//
// NO WRITE EXISTS HERE, SO THERE IS NO APPLY ARM. A divergence refuses with a typed cause read from
// the family's own converge route (fleet_fan_no_projection): the route's read_obligation for the
// unbound MegaRAC route, and a "no projection from FleetFanControl to the family writer target" text
// for the bound OpenBMC route. The write change
// derives the OpenBMC config (OpenBmcFanConfigDesired) and the MegaRAC plan from FleetFanPolicy
// and, in that same change, retires the overlapping authorities: gunbc.bmc.bmc_intent
// fleet_bmc_valid_state's fan fields (it becomes derived), and megarac_fan_boot_phase_desire (the boot
// change deletes it). Until then this fold is the single policy and those are the named leftovers.
//
// gunbc.bmc.bmc_fan_converge SURVIVES as the per-host apply realization (BmcFanRequestedAction and its
// backup/restore receipts); it is not a second decision. This fold decides Noop/Refuse from the fleet
// policy and consumes the SAME per-family route, gunbc.fleet.fleet_fan_converge_routes
// fan_converge_route_for_family, that bmc_fan_route_admission judges; the write change makes the
// BmcFanRequestedAction derived from FleetFanPolicy rather than authored beside it.
//
// ADMISSION PRECEDES EVERYTHING: the desired control is admitted for the family first, so an
// inexpressible target can never be Noop or Converged by happening to equal an observation.
// SUBJECT IDENTITY IS THE BOUND HOST, NOT A CALLER STRING: an observation is sealed and carries the
// gunbc.machine_intake.fan_observe FanObserveHost (host identity, controller endpoint, observed firmware
// family, account) plus a read receipt (attempt ordinal and the raw response hash). The family comes off
// the subject, never a separate argument. A decision is sealed and carries its subject, desired control
// and outcome, and Noop alone carries the deciding receipt; the standing CONSUMES the decision, so no
// separately authored deciding id exists. Every standing arm names its host. Remaining frontier: the adapter that mints the receipt
// from a wire read; until it lands the observation mint is sealed to named terminal fixtures (see
// fleet_fan_observed), so standings here are over SUPPLIED evidence.

type FleetFanReadReceipt {
  attempt: Int
  raw_response: ContentHash
}

type FleetFanReading
  = FleetFanControlObserved { control: FleetFanControl }
  | FleetFanControlUnobservable { cause: NonEmptyStr }

type FleetFanObserved sole_constructor {
  subject: FanObserveHost
  receipt: FleetFanReadReceipt
  reading: FleetFanReading
}

// THE ONLY MINT OF AN OBSERVATION. It is sealed to NAMED callers: the named terminal fixtures. There is
// no production mint yet: gunbc.fleet.fleet_fan_wire_read is a pure decoder over supplied bodies and
// mints nothing; the mint is the future reader of the actual operation observations
// (fleet_fan_wire_read_adapter_frontier), which joins this roster when it exists.
fn fleet_fan_observed(subject: FanObserveHost, receipt: FleetFanReadReceipt, reading: FleetFanReading) -> FleetFanObserved
  admit_callers: [
    decl_ref(module_path: "test.claim.fleet_fan_converge_witness", decl_name: "read"),
  ]
{
  FleetFanObserved { subject: subject, receipt: receipt, reading: reading }
}

// THE DECIDING RECEIPT EXISTS ONLY ON NOOP, which is minted only for an observation of the SAME
// subject, so a foreign or refused observation's receipt can never be a decision's deciding read.
type FleetFanOutcome
  = FleetFanNoop { deciding: FleetFanReadReceipt }
  | FleetFanRefuse { cause: NonEmptyStr }

type FleetFanDecision sole_constructor {
  subject: FanObserveHost
  desired: FleetFanControl
  outcome: FleetFanOutcome
}

// THE SUCCESSFUL ARM IS SEALED: Converged carries evidence minted only by fleet_fan_standing.
type FleetFanConvergedEvidence sole_constructor {
  host: HostIdentity
  control: FleetFanControl
  readback: FleetFanReadReceipt
}

fn fleet_fan_converged_evidence(host: HostIdentity, control: FleetFanControl, readback: FleetFanReadReceipt) -> FleetFanConvergedEvidence
  admit_callers: [
    decl_ref(module_path: "gunbc.fleet.fleet_fan_converge", decl_name: "fleet_fan_standing"),
  ]
{
  FleetFanConvergedEvidence { host: host, control: control, readback: readback }
}

type FleetFanConvergenceStanding
  = FleetFanConverged { evidence: FleetFanConvergedEvidence }
  | FleetFanDiverged { host: HostIdentity, observed: FleetFanControl }
  | FleetFanUnobservable { host: HostIdentity, cause: NonEmptyStr }
  | FleetFanRefused { host: HostIdentity, cause: NonEmptyStr }

fn fleet_fan_family_of(subject: FanObserveHost) -> BmcFirmwareFamily {
  subject.observation.identity.firmware.family
}

// WHAT A FAMILY'S UPSTREAM CAN EXPRESS. Automatic is the firmware default and every family has it.
// A held floor is refused unless the family's upstream is read to express it: MegaRAC by its closed
// admitted-wire set, OpenBMC until its phosphor zone-floor expressibility is read (a typed bet,
// DESIGN 4d, so the answer is a refusal and not a guess).
fn fleet_fan_family_refusal(family: BmcFirmwareFamily, control: FleetFanControl) -> NonEmptyStr? {
  match control {
    FirmwareAutomatic => Absent
    HeldAtDutyFloor { floor: f } => match family {
      AmiMegaRac => match megarac_fan_pwm_all_of(duty: f) {
        MegaRacFanPwmAllAdmitted { wire: _ } => Absent
        MegaRacFanPwmAllRefused { duty: _ } =>
          Present { value: "MegaRAC fan_pwm_all admits only the closed 20..100 step-5 duty set" as NonEmptyStr }
      }
      OpenBmc =>
        Present { value: "read obligation: whether phosphor-fan zone config expresses a held duty floor on this board is unread" as NonEmptyStr }
    }
  }
}

// SAME SUBJECT = same host identity, same controller endpoint, same observed family.
fn fleet_fan_same_subject(a: FanObserveHost, b: FanObserveHost) -> Bool {
  host_identity_eq(a: a.host, b: b.host)
    && a.observation.endpoint == b.observation.endpoint
    && fleet_fan_family_of(subject: a) == fleet_fan_family_of(subject: b)
}

// A DIVERGENCE CAN ONLY BE CLOSED BY THE FAMILY'S CONVERGE ROUTE, so the refusal names what that route
// lacks: the family's own read obligation when the route is unbound (MegaRAC today), and the missing
// FleetFanControl projection when it is bound (OpenBMC). The route per family is the single authority
// of gunbc.fleet.fleet_fan_converge_routes; nothing here restates it.
fn fleet_fan_no_projection(family: BmcFirmwareFamily) -> NonEmptyStr {
  match fan_converge_route_for_family(family: family) {
    ConvergeRouteUnbound { authority: _, read_obligation: o } => o
    ConvergeRouteBound { authority: _, write_operation: _, transport: _, readback: _ } =>
      "no projection from FleetFanControl to the family writer target exists yet" as NonEmptyStr
  }
}

fn fleet_fan_outcome(policy: FleetFanPolicy, subject: FanObserveHost, observed: FleetFanObserved) -> FleetFanOutcome {
  match fleet_fan_family_refusal(family: fleet_fan_family_of(subject: subject), control: policy.control) {
    Present { value: why } => FleetFanRefuse { cause: why }
    Absent =>
      if !fleet_fan_same_subject(a: subject, b: observed.subject) {
        FleetFanRefuse { cause: "observation is for a different host, controller or family than the one being converged" as NonEmptyStr }
      } else {
        match observed.reading {
          FleetFanControlUnobservable { cause: c } => FleetFanRefuse { cause: c }
          FleetFanControlObserved { control: seen } =>
            if seen == policy.control {
              FleetFanNoop { deciding: observed.receipt }
            } else {
              FleetFanRefuse { cause: fleet_fan_no_projection(family: fleet_fan_family_of(subject: subject)) }
            }
        }
      }
  }
}

fn fleet_fan_decide(policy: FleetFanPolicy, subject: FanObserveHost, observed: FleetFanObserved) -> FleetFanDecision {
  FleetFanDecision {
    subject: subject,
    desired: policy.control,
    outcome: fleet_fan_outcome(policy: policy, subject: subject, observed: observed),
  }
}

fn fleet_fan_refusal_standing(decision: FleetFanDecision, cause: NonEmptyStr) -> FleetFanConvergenceStanding {
  FleetFanRefused { host: decision.subject.host, cause: cause }
}

// THE STANDING IS DECISION-GATED AND CONSUMES THE DECISION AND A READBACK. A Refuse decision can
// never become Converged: it is a Refused standing carrying the decision's own cause. Only a Noop
// decision (same subject, its own deciding receipt) lets a readback be judged, and independence is
// that readback's attempt ordinal strictly after the deciding receipt, for the same subject. There
// is no parameter an apply result could be passed in. This is CONTROL-STATE standing: it speaks of
// FleetFanControl, not of the whole FleetFanPolicy revision (guard), so a
// consumer re-reads the current policy authority afresh and does not take this as proof that a
// policy revision was admitted.
fn fleet_fan_standing(decision: FleetFanDecision, readback: FleetFanObserved) -> FleetFanConvergenceStanding {
  match decision.outcome {
    FleetFanRefuse { cause: why } => fleet_fan_refusal_standing(decision: decision, cause: why)
    FleetFanNoop { deciding: deciding } =>
      if !fleet_fan_same_subject(a: decision.subject, b: readback.subject) {
        fleet_fan_refusal_standing(decision: decision, cause: "readback is for a different host, controller or family than the decision" as NonEmptyStr)
      } else {
        if readback.receipt.attempt <= deciding.attempt {
          fleet_fan_refusal_standing(decision: decision, cause: "readback is not a later read than the deciding observation" as NonEmptyStr)
        } else {
          match readback.reading {
            FleetFanControlUnobservable { cause: c } => FleetFanUnobservable { host: decision.subject.host, cause: c }
            FleetFanControlObserved { control: seen } =>
              if seen == decision.desired {
                FleetFanConverged { evidence: fleet_fan_converged_evidence(host: decision.subject.host, control: decision.desired, readback: readback.receipt) }
              } else {
                FleetFanDiverged { host: decision.subject.host, observed: seen }
              }
          }
        }
      }
  }
}

// THE FIRST CONSUMER IS TWO TRIGGERS, SO TWO ROWS, each bound to the exact declaration whose appearance
// retires it. Until then fleet_fan_decide and fleet_fan_standing execute only in
// test.claim.fleet_fan_converge_witness, over supplied evidence. A host merely appearing in the
// managed-host registry retires neither row.
// (1) the boot admission gate reads FleetFanConvergenceStanding as a CONSUMER, never a writer, after the
// post-power-on fan read lands;
// (2) a wire-read adapter mints FleetFanObserved from a real BMC response, retiring the sole-constructor
// admission to the witness.
data fleet_fan_boot_gate_ref: DeclarationRef = decl_ref(module_path: "gunbc.fleet.fleet_fan_boot_gate", decl_name: "fleet_fan_boot_admission")

data fleet_fan_wire_read_ref: DeclarationRef = decl_ref(module_path: "gunbc.fleet.fleet_fan_megarac_reader", decl_name: "megarac_fan_observation_read")

data fleet_fan_boot_gate_consumer_frontier: DissolutionCondition = bound_dissolution(ref: fleet_fan_boot_gate_ref)

data fleet_fan_wire_read_adapter_frontier: DissolutionCondition = bound_dissolution(ref: fleet_fan_wire_read_ref)
