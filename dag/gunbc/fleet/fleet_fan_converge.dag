module gunbc.fleet.fleet_fan_converge

import std.types { NonEmptyStr, String }
import std.optional { Absent, Present }
import extdeps.bmc.endpoint { AmiMegaRac, BmcFirmwareFamily, OpenBmc }
import extdeps.bmc.megarac_fan_policy { MegaRacFanPwmAllAdmitted, MegaRacFanPwmAllRefused, megarac_fan_pwm_all_of }
import product.host_identity { HostIdentity, host_identity_eq }
import product.fleet_fan_policy { FirmwareAutomatic, FleetFanControl, FleetFanPolicy, HeldAtDutyFloor }

// THE FLEET FAN CONVERGENCE FOLD: desired (product.fleet_fan_policy) against observed, deciding
// Noop / Refuse, then a standing read from an INDEPENDENT second observation.
//
// SELECTION PRECEDES CONVERGENCE (DESIGN 3d): this fold takes ONE host's family and ONE
// observation. Which hosts exist comes from the managed-host registry, not from here.
//
// BOOT IS A CONSUMER AND NEVER A WRITER. Nothing here is imported by a boot path in this change; the
// admission gate that reads FleetFanConvergenceStanding is a separate change that waits on the
// post-power-on fan read.
//
// NO WRITE EXISTS HERE, SO THERE IS NO APPLY ARM. A divergence refuses with a typed "no projection
// from FleetFanControl to the family's writer target" cause for BOTH families. The write change
// derives the OpenBMC config (OpenBmcFanConfigDesired) and the MegaRAC plan from FleetFanPolicy
// and, in that same change, retires the overlapping authorities: gunbc.bmc.bmc_intent
// fleet_bmc_valid_state's fan fields (it becomes derived), and megarac_fan_boot_phase_desire (the boot
// change deletes it). Until then this fold is the single policy and those are the named leftovers.
//
// ADMISSION PRECEDES EVERYTHING: the desired control is admitted for the family first, so an
// inexpressible target can never be Noop or Converged by happening to equal an observation.
// SUBJECT IDENTITY: an observation names its host and a fresh observation id; a decision or standing
// for another host, or a readback that reuses the deciding observation's id, refuses.

type FleetFanReading
  = FleetFanControlObserved { control: FleetFanControl }
  | FleetFanControlUnobservable { cause: NonEmptyStr }

type FleetFanObserved {
  host: HostIdentity
  observation_id: NonEmptyStr
  reading: FleetFanReading
}

type FleetFanDecision
  = FleetFanNoop
  | FleetFanRefuse { cause: NonEmptyStr }

type FleetFanConvergenceStanding
  = FleetFanConverged
  | FleetFanDiverged { observed: FleetFanControl }
  | FleetFanUnobservable { cause: NonEmptyStr }
  | FleetFanRefused { cause: NonEmptyStr }

// WHAT A FAMILY'S UPSTREAM CAN EXPRESS. Automatic is the firmware default and every family has it.
// A held floor is refused unless the family's upstream is read to express it: MegaRAC by its closed
// admitted-wire set, OpenBMC until its phosphor zone-floor expressibility is read (a typed bet,
// DESIGN 4d, so the answer is a refusal and not a guess).
fn fleet_fan_family_refusal(family: BmcFirmwareFamily, control: FleetFanControl) -> NonEmptyStr? {
  match control {
    FirmwareAutomatic => Absent
    HeldAtDutyFloor { floor: f } => match family {
      AmiMegaRac => match megarac_fan_pwm_all_of(duty: f) {
        MegaRacFanPwmAllAdmitted { wire: _ } => Absent
        MegaRacFanPwmAllRefused { duty: _ } =>
          Present { value: "MegaRAC fan_pwm_all admits only the closed 20..100 step-5 duty set" as NonEmptyStr }
      }
      OpenBmc =>
        Present { value: "read obligation: whether phosphor-fan zone config expresses a held duty floor on this board is unread" as NonEmptyStr }
    }
  }
}

fn fleet_fan_subject_refusal(expected: HostIdentity, observed: FleetFanObserved) -> NonEmptyStr? {
  if host_identity_eq(a: expected, b: observed.host) {
    Absent
  } else {
    Present { value: "observation is for a different host than the one being converged" as NonEmptyStr }
  }
}

fn fleet_fan_no_projection() -> NonEmptyStr {
  "no projection from FleetFanControl to the family writer target exists yet" as NonEmptyStr
}

fn fleet_fan_decide(policy: FleetFanPolicy, family: BmcFirmwareFamily, host: HostIdentity, observed: FleetFanObserved) -> FleetFanDecision {
  match fleet_fan_family_refusal(family: family, control: policy.control) {
    Present { value: why } => FleetFanRefuse { cause: why }
    Absent => match fleet_fan_subject_refusal(expected: host, observed: observed) {
      Present { value: why } => FleetFanRefuse { cause: why }
      Absent => match observed.reading {
        FleetFanControlUnobservable { cause: c } => FleetFanRefuse { cause: c }
        FleetFanControlObserved { control: seen } =>
          if seen == policy.control {
            FleetFanNoop
          } else {
            FleetFanRefuse { cause: fleet_fan_no_projection() }
          }
      }
    }
  }
}

// THE STANDING TAKES ONLY A READBACK OBSERVATION and the id of the observation the decision used;
// a reused id is not independent. There is no parameter an apply result could be passed in.
fn fleet_fan_standing(policy: FleetFanPolicy, family: BmcFirmwareFamily, host: HostIdentity, decided_observation_id: NonEmptyStr, readback: FleetFanObserved) -> FleetFanConvergenceStanding {
  match fleet_fan_family_refusal(family: family, control: policy.control) {
    Present { value: why } => FleetFanRefused { cause: why }
    Absent => match fleet_fan_subject_refusal(expected: host, observed: readback) {
      Present { value: why } => FleetFanRefused { cause: why }
      Absent =>
        if (readback.observation_id as String) == (decided_observation_id as String) {
          FleetFanRefused { cause: "readback reuses the deciding observation id and is not independent" as NonEmptyStr }
        } else {
          match readback.reading {
            FleetFanControlUnobservable { cause: c } => FleetFanUnobservable { cause: c }
            FleetFanControlObserved { control: seen } =>
              if seen == policy.control {
                FleetFanConverged
              } else {
                FleetFanDiverged { observed: seen }
              }
          }
        }
    }
  }
}
