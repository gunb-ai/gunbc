module gunbc.fleet.fleet_site_locale

import std.types { NonEmptyStr, Bool, List, Int }
import extdeps.posix.locale { PosixLocaleId, locale_en_us }
import extdeps.iana.time_zone_database {
  IanaTimeZoneId,
  TzdataRelease,
  zone_etc_utc,
  zone_america_new_york,
  tzdata_2026c,
}

// WHERE A MACHINE'S CIVIL TIME COMES FROM, and why it is not a constant in a provisioning
// workflow.
//
// The operator's ruling is that language and timezone "need to be inherited from a physical
// location". That is a modeling instruction, not a value: a unit's zone is a consequence of
// where the unit physically sits, so the authority is the SITE, and any workflow that wants a
// zone derives one rather than carrying its own. Moving a rack then changes one row here, and
// every consumer follows; a literal in the onboarding workflow would have to be found and
// edited per consumer, which is the parallel authority §3 forbids.

type SiteIdentity = NonEmptyStr where brand("SiteIdentity")

// A site's zone is the zone of its JURISDICTION, which is a fact about the world and not a
// preference. This is the half that is genuinely "inherited from a physical location".
type PhysicalSite {
  identity: SiteIdentity
  civil_time_zone: IanaTimeZoneId
  civil_locale: PosixLocaleId
}

data site_us_east_operator_premises: PhysicalSite = PhysicalSite {
  identity: "us-east-operator-premises" as SiteIdentity,
  civil_time_zone: zone_america_new_york,
  civil_locale: locale_en_us,
}

// THE SECOND HALF, AND THE REASON THIS IS TWO FACTS RATHER THAN ONE. A site's civil zone is
// where the machine IS; the zone a machine is CONFIGURED to is a separate decision, and this
// fleet demonstrably makes it differently on different hosts. Measured 2026-09-02 across four
// reachable hosts at one site: srv4 and spark-a3ee report Etc/UTC, while spark-3bd5 and pi1
// report America/New_York. The two already-onboarded Sparks disagree WITH EACH OTHER.
//
// That is the evidence that a single derived value would have been wrong: a model that read the
// zone straight off the site would have silently declared half the fleet misconfigured, and a
// model that hardcoded UTC would have silently declared the other half misconfigured. Neither
// is a finding this repository has earned -- nobody has ruled which is intended.
//
// So the policy is its own axis with an explicit UNDECIDED arm. HostZonePolicyUnruled is
// ⊥-as-ignorance and is kept distinct from both answers (DESIGN §5): a consumer that needs a
// zone must refuse against it rather than pick the arm that happens to be convenient.
type HostZonePolicy
  = HostFollowsSiteCivilZone
  | HostRunsCoordinatedUniversalTime
  | HostZonePolicyUnruled

// RULED 2026-09-02 by the operator, who is the authority on where the fleet physically sits:
// the site drives every other decision, and the standing requirement is that when the site
// moves, THAT ONE ROW re-derives the convergence changes rather than a human editing per-host
// settings. HostFollowsSiteCivilZone is the arm that makes the site load-bearing; the UTC arm
// would have pinned every host to a constant and made the site row decorative.
//
// The ruling is what turns the fleet's measured disagreement from an open question into a
// CONVERGENCE OBLIGATION: hosts observed at Etc/UTC are now divergent from the derived zone,
// and that divergence is computed below rather than listed, so relocating the site
// re-derives it.
data fleet_host_zone_policy: HostZonePolicy = HostFollowsSiteCivilZone

type ProvisionedTimeZone
  = ProvisionedZone { zone: IanaTimeZoneId }
  | ZoneRefusedPolicyUnruled

// The derivation a provisioning workflow calls. It never returns a default: with the policy
// unruled it REFUSES, which is what stops the DGX Spark onboarding wizard from being handed a
// zone nobody chose. The refusal is the point -- the workflow stopping and naming the missing
// ruling is cheaper than eight more units configured to a guess.
fn provisioned_time_zone(site: PhysicalSite, policy: HostZonePolicy) -> ProvisionedTimeZone {
  match policy {
    HostFollowsSiteCivilZone => ProvisionedZone { zone: site.civil_time_zone }
    HostRunsCoordinatedUniversalTime => ProvisionedZone { zone: zone_etc_utc }
    HostZonePolicyUnruled => ZoneRefusedPolicyUnruled
  }
}

// The LOCALE has no such ambiguity and is therefore derived without a policy axis: every host
// observed at this site runs an en-US userland, and nothing in the measurement suggests a second
// arm exists. Adding one when a site needs it is a row, not a redesign.
fn provisioned_locale(site: PhysicalSite) -> PosixLocaleId {
  site.civil_locale
}

// The release the zone identifiers were read against. A zone identifier without the database
// release it came from is a name with no version behind it, and jurisdictions do rename zones.
data fleet_observed_tzdata_release: TzdataRelease = tzdata_2026c


// ------------------------------------------------------------------------------------------
// CONVERGENCE: what the ruling obligates, derived rather than listed.
//
// The operator's requirement is explicit -- one row moves and the proper convergence changes
// re-derive. So nothing below names a zone: each host carries only what was OBSERVED on it, and
// whether that host is converged is computed against provisioned_time_zone(site, policy). Change
// site_us_east_operator_premises.civil_time_zone and every verdict here moves with it, with no
// second edit anywhere. That is the property that makes this a single authority rather than the
// dual representation the operator identified.

type HostIdentity = NonEmptyStr where brand("HostIdentity")

type ObservedHostZone {
  host: HostIdentity
  observed_zone: IanaTimeZoneId
}

// Read 2026-09-02 over ssh from the four reachable hosts at this site. These are OBSERVATIONS,
// so they record what each machine reports and never what it ought to report -- the ought is the
// derivation's job, and fusing them would rebuild the fork.
data observed_host_zones: List<ObservedHostZone> = [
  ObservedHostZone { host: "srv4" as HostIdentity, observed_zone: zone_etc_utc },
  ObservedHostZone { host: "spark-a3ee" as HostIdentity, observed_zone: zone_etc_utc },
  ObservedHostZone { host: "spark-3bd5" as HostIdentity, observed_zone: zone_america_new_york },
  ObservedHostZone { host: "pi1" as HostIdentity, observed_zone: zone_america_new_york },
]

type HostZoneConvergence
  = HostZoneConverged
  | HostZoneDivergent { observed: IanaTimeZoneId, desired: IanaTimeZoneId }
  | HostZoneUndecidable

fn host_zone_convergence(
  observed: ObservedHostZone,
  site: PhysicalSite,
  policy: HostZonePolicy,
) -> HostZoneConvergence {
  match provisioned_time_zone(site: site, policy: policy) {
    ZoneRefusedPolicyUnruled => HostZoneUndecidable
    ProvisionedZone { zone: desired } =>
      if observed.observed_zone == desired {
        HostZoneConverged
      } else {
        HostZoneDivergent { observed: observed.observed_zone, desired: desired }
      }
  }
}

// The count of hosts needing a change under the current site and ruling. It is a DERIVED
// number: it is not a debt list anyone maintains, and it drops to zero by converging hosts or
// changes wholesale when the site moves.
// The fold matches the convergence coproduct directly rather than routing through an
// is_converged Bool. Re-exposing a three-arm discriminant as two-valued loses the arm that
// matters most here -- HostZoneUndecidable is not "not converged", it is "no ruling exists to
// decide" -- and a caller handed a Bool cannot tell those apart. Counting them together is
// deliberate and is stated at the arm, not hidden behind a predicate's name.
fn divergent_host_count(site: PhysicalSite, policy: HostZonePolicy) -> Int {
  fold(
    observed_host_zones,
    init: 0,
    f: (n, h) => match host_zone_convergence(observed: h, site: site, policy: policy) {
      HostZoneConverged => n
      HostZoneDivergent { observed: _, desired: _ } => n + 1
      HostZoneUndecidable => n + 1
    }
  )
}
