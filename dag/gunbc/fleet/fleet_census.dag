module gunbc.fleet.fleet_census

// THE FLEET COMPLETION CENSUS: a fold over the identified population (operator_hosts) that gives
// every physical machine a standing. No machine is silently absent. The standing is derived from
// the enrollment model and the runner-executor population -- never from a hand-written list.
//
// Witness: the census leaves no machine without a standing. A fifth enrolled fixture host is
// planned without code change. An unsizable host stays visible with its cause.

import std.types { String, Bool, List }
import std.algebra { list_push, length }
import product.host_identity { HostIdentity }
import gunbc.fleet.fleet_host_identity { operator_hosts }
import gunbc.fleet.fleet_enrollment {
  fleet_enrollments,
  fleet_enrollment_refusals,
  runner_executor_hosts,
  enrollment_for_host,
  HostEnrollmentIntent,
  EnrollmentAdmission,
  EnrollmentRefused,
  participation_list_contains,
  CiRunnerParticipation,
}
import gunbc.fleet.fleet_host_backing { backing_microvm_forbidding_offer }

type CensusStanding
  = CensusEligible { host: HostIdentity }
  | CensusBlocked { host: HostIdentity, cause: String }
  | CensusExcluded { host: HostIdentity, reason: String }

// CAPACITY AS AN OBSERVED OUTCOME: a host counts as available runner capacity only after ALL
// four conditions are met. The standing is not granted by enrollment or planning alone -- it
// requires evidence of actual execution. A host that has not run a real CI job is NOT counted
// as available capacity, regardless of its enrollment or plan status.
type RunnerCapacityStanding
  = CapacityAvailable { host: HostIdentity }
  | CapacityNotYetAvailable { host: HostIdentity, missing: List<String> }

type CapacityEvidence {
  services_healthy: Bool
  registrations_observed: Bool
  resource_admission_resolved: Bool
  job_executed: Bool
}

fn capacity_standing(host: HostIdentity, evidence: CapacityEvidence) -> RunnerCapacityStanding {
  let missing = capacity_missing_conditions(evidence: evidence)
  if length(missing) == 0 {
    CapacityAvailable { host: host }
  } else {
    CapacityNotYetAvailable { host: host, missing: missing }
  }
}

fn capacity_missing_conditions(evidence: CapacityEvidence) -> List<String> {
  let m1 = if evidence.services_healthy { [] } else { ["runner services not healthy"] }
  let m2 = if evidence.registrations_observed { [] } else { ["registrations not observed in org roster"] }
  let m3 = if evidence.resource_admission_resolved { [] } else { ["resource admission unresolved"] }
  let m4 = if evidence.job_executed { [] } else { ["no CI job executed on this host"] }
  concat(concat(m1, m2), concat(m3, m4))
}

type CensusFoldAccum {
  rows: List<CensusStanding>
}

fn host_is_enrolled_for_ci(host: HostIdentity) -> Bool {
  match enrollment_for_host(host: host) {
    Present { value: e } => participation_list_contains(ps: e.participation, wanted: CiRunnerParticipation)
    Absent => false
  }
}

fn host_is_runner_executor(host: HostIdentity) -> Bool {
  fold(runner_executor_hosts(), init: false, f: (acc, h) => acc || (h as String) == (host as String))
}

fn host_enrollment_refusal_reason(host: HostIdentity) -> String? {
  fold(
    fleet_enrollment_refusals,
    init: none,
    f: (acc, r) =>
      match acc {
        Present { value: _ } => acc
        Absent =>
          match r {
            EnrollmentRefused { host: h, provisioning: _ } =>
              if (h as String) == (host as String) {
                Present { value: "enrollment refused: owned provisioning state cannot occur" }
              } else {
                Absent
              }
            _ => Absent
          }
      }
  )
}

fn host_microvm_forbidding_reason(host: HostIdentity) -> String? {
  match enrollment_for_host(host: host) {
    Present { value: e } =>
      match backing_microvm_forbidding_offer(backing: e.backing) {
        Present { value: _ } => Present { value: "provider backing forbids microVM execution" }
        Absent => none
      }
    Absent => none
  }
}

fn census_standing_for_host(host: HostIdentity) -> CensusStanding {
  if host_is_runner_executor(host: host) {
    CensusEligible { host: host }
  } else if host_is_enrolled_for_ci(host: host) {
    match host_microvm_forbidding_reason(host: host) {
      Present { value: reason } => CensusBlocked { host: host, cause: reason }
      Absent => CensusBlocked { host: host, cause: "enrolled for CI but not in runner-executor population" }
    }
  } else {
    match host_enrollment_refusal_reason(host: host) {
      Present { value: reason } => CensusExcluded { host: host, reason: reason }
      Absent => CensusExcluded { host: host, reason: "not enrolled for any fleet participation" }
    }
  }
}

fn fleet_census() -> List<CensusStanding> {
  fold(
    operator_hosts,
    init: CensusFoldAccum { rows: [] },
    f: (acc, h) =>
      CensusFoldAccum { rows: list_push(acc.rows, census_standing_for_host(host: h)) },
  ).rows
}

fn census_covers_all_identified_hosts() -> Bool {
  let rows = fleet_census()
  length(rows) == length(operator_hosts)
}

fn census_host_standing(host: HostIdentity) -> CensusStanding? {
  fold(
    fleet_census(),
    init: none,
    f: (acc, row) =>
      match acc {
        Present { value: _ } => acc
        Absent =>
          match row {
            CensusEligible { host: h } => if (h as String) == (host as String) { Present { value: row } } else { Absent }
            CensusBlocked { host: h, cause: _ } => if (h as String) == (host as String) { Present { value: row } } else { Absent }
            CensusExcluded { host: h, reason: _ } => if (h as String) == (host as String) { Present { value: row } } else { Absent }
          }
      }
  )
}
