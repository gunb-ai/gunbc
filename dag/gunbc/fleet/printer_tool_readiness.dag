module gunbc.fleet.printer_tool_readiness

import std.types { Bool }
import extdeps.tools.mosquitto_pub { mosquitto_pub_cli_tool, mosquitto_pub_help_command, mosquitto_pub_help_supports_private_options }
import gunbc.host_cli_dependency { observe_host_cli_dependency, HostCliDependencyPresent, HostCliDependencyAbsent }
import gunbc.command_runner { run_shell_command_capture }
import extdeps.exec.command { LocalExec }
import extdeps.shell.exec { ProcessOutputPresent, ProcessOutputAbsent, ProcessRefused }

fn printer_mqtt_tool_ready() -> Bool {
  match observe_host_cli_dependency(tool: mosquitto_pub_cli_tool) {
    HostCliDependencyAbsent { absence: _ } => false
    HostCliDependencyPresent => match run_shell_command_capture(command: mosquitto_pub_help_command(), transport: LocalExec) {
      ProcessOutputPresent { text: t } => mosquitto_pub_help_supports_private_options(stdout: t)
      ProcessOutputAbsent => false
      ProcessRefused { exit_code: _, stderr: _ } => false
    }
  }
}
