// THE FIRST ONBOARDING SEGMENT'S EDGE, CONVERGED ON srv4 THROUGH THE FLEET-CONVERGE WORKFLOW.
// Operator ruling (PXE-FABRIC 0C, via sleek-carp-159): the serving host is a converged executor on
// Mt. Collins's /24, srv4 unless srv3 is measurably freer, and no fact says it is. A peer of
// gunbc.runner.runner_host_file_converge rather than an axis of gunbc.fleet.fleet_converge_plan: that plan's
// request coproduct carries runner and fabric populations and has no file or daemon axis, and the
// parent ruled out stretching it to fake one.
//
// WHAT CONVERGE ESTABLISHES AND WHAT IT DOES NOT. A converged run says srv4 holds the declared
// config and unit bytes, the unit is active, and the chainloader at the TFTP root hashes to the
// pinned digest. It does NOT establish the edge: gunbc.site_pxe_edge mints standing only
// from an observed boot offer reaching a client. A daemon that started is not an offer that arrived.
data site_pxe_edge_host: HostIdentity = "srv4" as HostIdentity

// THE SEGMENT IS gunbc.fleet.fleet_intent_network operator_lan_segment, parsed from its cidr's network part
// rather than re-typed; a failure to parse is a gate cause, never a guessed network.
data site_pxe_edge_segment_network: Ipv4ParseResult = match split(s: operator_lan_segment.cidr as String, delimiter: "/").first() {
  Present { value: network } => parse_ipv4_address(text: network)
  Absent => parse_ipv4_address(text: "")
}

data site_pxe_edge_unit_name: NonEmptyStr = "gunbc-site-pxe-edge.service"

data site_pxe_edge_unit_path: FilePath = join([systemd_system_unit_directory as String, "/", site_pxe_edge_unit_name as String], "") as FilePath

data site_pxe_edge_config_path: FilePath = "/etc/gunbc-site-pxe-edge.dnsmasq.conf"

// The TFTP root holds exactly one file, the chainloader. Converge never writes into it: the binary's
// bytes have no producer in this repository yet, so it is observed at its pinned digest or refused.
data site_pxe_edge_tftp_root: NonEmptyStr = "/srv/gunbc-site-pxe-edge/tftp"

data site_pxe_edge_dnsmasq_binary: NonEmptyStr = "/usr/sbin/dnsmasq"

// typed_remote_file_write stages beside its destination and creates no parents, so every desired file's
// write first creates its parent (site_pxe_edge_file_parent_argv); a per-client seed directory has no other producer.
data site_pxe_edge_file_scope: FileTreeScope = FileTreeScope { root_path: "/etc" as NonEmptyStr }

// THE CHAINLOADER PIN IS A BUILD RECEIPT, and the gate checks every field of it. A filename and a digest
// alone admit any binary that happens to share a basename, including an x86 build; the receipt names
// the upstream revision it was built from, the exact extdeps.firmware.ipxe build target, the
// architecture, the digest of the built file, the name it is installed under in the TFTP root and the
// standing of the Secure Boot check. The chainloader is THIS edge's artifact (the global boot origin
// carries kernel, initrd and images, not the chainloader); a guessed URL or filename with no digest is
// exactly what may not be served. Unpinned stays a variant for the day a rebuild invalidates a pin.

// SECURE BOOT IS A CHECK WITH THREE STANDINGS, NOT A BOOL. "Not accepted because nobody signed it or
// looked" and "not accepted because a firmware was observed refusing it" have different remedies (observe
// vs. sign/enroll), and a Bool cannot tell them apart. Observed carries the verdict AND the evidence that
// settled it (a firmware observed refusing the image is Observed with SecureBootVerdictRejected, never
// Refused); Unobserved is the honest default for an artifact no firmware has been shown; Refused means
// only that the operator declines to attempt the check, so no firmware was shown the image by choice.
// There is no stored or parallel Bool: acceptance IS the absence of a Secure Boot cause in
// site_pxe_edge_gate_causes, the one fold that decides it. A new settling source
// (an enrolled certificate, a second firmware family) is a new evidence value, not a new variant.
type SitePxeEdgeSecureBootVerdict
  = SecureBootVerdictBooted
  | SecureBootVerdictRejected

type SitePxeEdgeSecureBootStanding
  = SecureBootObserved { verdict: SitePxeEdgeSecureBootVerdict, evidence: NonEmptyStr }
  | SecureBootUnobserved { why: NonEmptyStr }
  | SecureBootRefused { why: NonEmptyStr }

// embedded_revision is the DECISION field: the exact five hex characters iPXE's Makefile appends as "(g<5>)"
// to the version it prints into the image, which is the only revision the artefact itself can testify to.
// built_from_commit is the full upstream SHA kept as build provenance for a reader reproducing the build;
// NO gate reads it, because the image cannot confirm the other 35 characters, so a gate on it would be a
// check the artefact cannot answer. Gating on the full SHA would need a source the image does not carry.
// THE COMMITTED IMAGE A RECEIPT IS ABOUT, BY IDENTITY: its checkout path and digest. The receipt's digest IS this
// artifact's, so the bytes the srv4 placement and readback pin are the bytes the real-execution witness
// (test.claim.fleet.site_pxe_edge_chainloader_real_execution_witness) hashes and reads the revision of. The revision
// is a property of those bytes, so a srv4 digest match carries it; reading it again on srv4 was redundant work.
type SitePxeEdgeCommittedArtifact {
  path: NonEmptyStr
  digest: ContentHash
}

data site_pxe_edge_committed_ipxe_arm64: SitePxeEdgeCommittedArtifact = SitePxeEdgeCommittedArtifact {
  path: "artifacts/ipxe/snponly-arm64.efi",
  digest: Sha256Hash(Sha256Digest { hex: "18b1cbd27420fb4961e7a58d266e98a66cba49b3047e6abfc2c697733aaa7e05" }),
}

type SitePxeEdgeChainloaderBuildReceipt sole_constructor {
  embedded_revision: NonEmptyStr
  built_from_commit: NonEmptyStr
  build_target: IpxeBuildTarget
  architecture: Architecture
  artifact: SitePxeEdgeCommittedArtifact
  digest: ContentHash
  installed_filename: NonEmptyStr
  secure_boot: SitePxeEdgeSecureBootStanding
}

// The digest is the artifact's, never a second argument that could name other bytes.
fn site_pxe_edge_chainloader_build_receipt(
  embedded_revision: NonEmptyStr,
  built_from_commit: NonEmptyStr,
  build_target: IpxeBuildTarget,
  architecture: Architecture,
  artifact: SitePxeEdgeCommittedArtifact,
  installed_filename: NonEmptyStr,
  secure_boot: SitePxeEdgeSecureBootStanding,
) -> SitePxeEdgeChainloaderBuildReceipt {
  SitePxeEdgeChainloaderBuildReceipt {
    embedded_revision: embedded_revision,
    built_from_commit: built_from_commit,
    build_target: build_target,
    architecture: architecture,
    artifact: artifact,
    digest: artifact.digest,
    installed_filename: installed_filename,
    secure_boot: secure_boot,
  }
}

type SitePxeEdgeChainloaderPin
  = SitePxeEdgeChainloaderPinned { build: SitePxeEdgeChainloaderBuildReceipt }
  | SitePxeEdgeChainloaderUnpinned { obligation: NonEmptyStr }

// BUILD PROVENANCE (annotation, not a stored fact: the command is derived from build_target, so a second copy could disagree with it):
// `make ARCH=arm64 CROSS_COMPILE=aarch64-linux-gnu- bin-arm64-efi/snponly.efi` with aarch64-linux-gnu-gcc 14.2.0 (Debian 14.2.0-19),
// GNU Make 4.4.1, GNU ld 2.44. A future requirement to gate on toolchain identity adds typed tool entries to the receipt then.
// THE COMMITTED IMAGE IS GUARDED BY REAL EXECUTION, OFF THE REQUIRED PATH: the witness
// test.claim.fleet.site_pxe_edge_chainloader_real_execution_witness runs `sha256sum` and
// `grep -a -o -E "[(]g[0-9a-f]{5}[)]"` over site_pxe_edge_committed_ipxe_arm64's path and checks the digest and the
// pinned embedded revision, so a swapped blob or flipped marker bytes red there; srv4 is checked by digest only. It is a LocalRepoWetLane exclusion in
// gunbc.ci.ci_layer_roots witness_exclusion_frontier, so it is not merge-blocking; the wet placement step's digest
// check against this pin is the other guard.
// BUILT, NOT YET PLACED. The committed image's consumer is the wet placement step (the srv4 TFTP write run
// by swift-wren-451 after operator approval), which must verify its sha256 against this pin before copying;
// that step is the declared later change, triggered by operator approval of the srv4 write.
// Evidence: the sha256 (337920 bytes) of the committed artifacts/ipxe/snponly-arm64.efi, built from the upstream revision below with ipxe.org's
// documented `make <platform>/<image>` grammar (extdeps.firmware.ipxe). The file is NOT on srv4: the
// gate still closes on the chainloader observation until a wet step places it at
// site_pxe_edge_chainloader_path and the post-placement sha256 agrees with this digest.
// Secure Boot is Unobserved: the image is self-built, signed by no key a firmware trusts by default, and
// no Altra board's Secure Boot state has been read. Settling it takes an enrolled certificate or an
// observed boot attempt, recorded as SecureBootObserved evidence.
data site_pxe_edge_chainloader_pin: SitePxeEdgeChainloaderPin = SitePxeEdgeChainloaderPinned {
  build: site_pxe_edge_chainloader_build_receipt(
    embedded_revision: "c51ca",
    built_from_commit: "c51ca76a6e56c5627aea6dc32da4c18d5e6cf394",
    build_target: ipxe_arm64_efi_snponly,
    architecture: Aarch64,
    artifact: site_pxe_edge_committed_ipxe_arm64,
    installed_filename: ipxe_arm64_efi_snponly.image,
    secure_boot: SecureBootUnobserved { why: "self-built iPXE is unsigned and no Altra board's Secure Boot state has been read; an enrolled certificate or an observed boot attempt would settle it" },
  ),
}

fn site_pxe_edge_chainloader_target(pin: SitePxeEdgeChainloaderPin) -> SitePxeEdgeChainloaderBuildReceipt? {
  match pin {
    SitePxeEdgeChainloaderUnpinned { obligation: _ } => Absent
    SitePxeEdgeChainloaderPinned { build: b } => Present { value: b }
  }
}

fn site_pxe_edge_chainloader_path(target: SitePxeEdgeChainloaderBuildReceipt) -> NonEmptyStr {
  join([site_pxe_edge_tftp_root as String, "/", target.installed_filename as String], "") as NonEmptyStr
}

// ── Served chains, pinned ────────────────────────────────────────────────────────────────────────
// WHAT EACH SERVED MEMBER'S BYTES ARE AND WHERE THEIR PIN CAME FROM. An iPXE member is this edge's own
// build, checked against its build receipt (revision, target, filename, Secure Boot). A media member is
// a file extracted from the verified Ubuntu ISO, checked against the observer's pin
// (gunbc.provisioning.ubuntu_network_origin_observation). A rendered member (grub.cfg) is this edge's
// own rendering: its digest is the digest of that rendering, and it reaches srv4 as a desired file that
// the converge writes and reads back, never as a placed blob.
type SitePxeEdgeMemberSource
  = IpxeBuildSource { build: SitePxeEdgeChainloaderBuildReceipt }
  | VerifiedMediaSource { media: UbuntuInstallMediaArtifactRow, source: UbuntuNetworkBootMemberSource, pin: PinnedArtefact, digest: ContentHash }
  | RenderedSource { content: String, digest: ContentHash }

type SitePxeEdgePinnedMember {
  member: NetworkBootLoaderMember
  source: SitePxeEdgeMemberSource
}

fn site_pxe_edge_member_digest(m: SitePxeEdgePinnedMember) -> ContentHash {
  match m.source {
    IpxeBuildSource { build: b } => b.digest
    VerifiedMediaSource { media: _, source: _, pin: _, digest: d } => d
    RenderedSource { content: _, digest: d } => d
  }
}

fn site_pxe_edge_member_is_rendered(m: SitePxeEdgePinnedMember) -> Bool {
  match m.source {
    IpxeBuildSource { build: _ } => false
    VerifiedMediaSource { media: _, source: _, pin: _, digest: _ } => false
    RenderedSource { content: _, digest: _ } => true
  }
}

fn site_pxe_edge_rendered_digest(content: String) -> ContentHash {
  Sha256Hash(sha256_computed_digest(message: bytes_octets(b: utf8_encode_bytes(s: content))))
}

type SitePxeEdgePinnedChain {
  architecture: Architecture
  audience: SiteEdgeChainAudience
  members: FreeSemigroup<SitePxeEdgePinnedMember>
  citation: NonEmptyStr
}

fn site_pxe_edge_pinned_members(chain: SitePxeEdgePinnedChain) -> List<SitePxeEdgePinnedMember> {
  non_empty_to_list(xs: chain.members)
}

fn site_pxe_edge_member_path(member: SitePxeEdgePinnedMember) -> NonEmptyStr {
  join([site_pxe_edge_tftp_root as String, "/", member.member.served_path as String], "") as NonEmptyStr
}

// A CHAIN IS PINNED WHOLE OR NOT AT ALL: one member with no pin leaves the chain Unpinned with the
// missing member named, so no edge ever serves part of a chain.
type SitePxeEdgeChainPin
  = SitePxeEdgeChainPinned { chain: SitePxeEdgePinnedChain }
  | SitePxeEdgeChainUnpinned { architecture: Architecture, audience: SiteEdgeChainAudience, obligation: NonEmptyStr }

// THE ARM ROW: the aarch64 chain is the landed iPXE build. The chain's architecture is the ROW's, not
// copied from the receipt, so a receipt naming another architecture is checked against it and refused.
fn site_pxe_edge_arm64_ipxe_chain_pin(pin: SitePxeEdgeChainloaderPin) -> SitePxeEdgeChainPin {
  match pin {
    SitePxeEdgeChainloaderUnpinned { obligation: o } => SitePxeEdgeChainUnpinned { architecture: Aarch64, audience: EveryKnownClient, obligation: o }
    SitePxeEdgeChainloaderPinned { build: b } => SitePxeEdgeChainPinned {
      chain: SitePxeEdgePinnedChain {
        architecture: Aarch64,
        audience: EveryKnownClient,
        members: FreeSemigroup {
          head: SitePxeEdgePinnedMember {
            member: NetworkBootLoaderMember { role: FirstStageLoader, served_path: b.installed_filename, verifier: NotAuthenticated },
            source: IpxeBuildSource { build: b },
          },
          tail: [],
        },
        citation: site_pxe_edge_ipxe_chain_citation(target: b),
      },
    }
  }
}

type SitePxeEdgeMemberPinning
  = MemberPinned { member: SitePxeEdgePinnedMember }
  | MemberUnpinned { obligation: NonEmptyStr }

fn site_pxe_edge_ubuntu_member_pinning(media: UbuntuInstallMediaArtifactRow, m: UbuntuNetworkBootMember, pins: List<UbuntuNetworkBootMemberPin>, rendered_configuration: String?) -> SitePxeEdgeMemberPinning {
  match m.source {
    RenderedByConsumer =>
      match rendered_configuration {
        Absent => MemberUnpinned { obligation: join([m.member.served_path as String, " is rendered by the edge and no rendering is bound"], "") as NonEmptyStr }
        Present { value: c } => MemberPinned { member: SitePxeEdgePinnedMember { member: m.member, source: RenderedSource { content: c, digest: site_pxe_edge_rendered_digest(content: c) } } }
      }
    IsoMember { iso_path: _ } => site_pxe_edge_blob_member_pinning(media: media, m: m, pins: pins)
    PoolPackageMember { package: _, version: _, pool_path: _, deb_sha256: _, member_path: _ } => site_pxe_edge_blob_member_pinning(media: media, m: m, pins: pins)
  }
}

fn site_pxe_edge_blob_member_pinning(media: UbuntuInstallMediaArtifactRow, m: UbuntuNetworkBootMember, pins: List<UbuntuNetworkBootMemberPin>) -> SitePxeEdgeMemberPinning {
  match first_where(xs: pins, keep: p => (p.served_path as String) == (m.member.served_path as String)) {
    Absent => MemberUnpinned { obligation: join(["no observer pin for ", m.member.served_path as String], "") as NonEmptyStr }
    Present { value: p } =>
      match sha256_digest_content_hash(digest: p.pin.digest) {
        Absent => MemberUnpinned { obligation: join(["the pin for ", m.member.served_path as String, " is not a sha256 digest"], "") as NonEmptyStr }
        Present { value: d } => MemberPinned { member: SitePxeEdgePinnedMember { member: m.member, source: VerifiedMediaSource { media: media, source: m.source, pin: p.pin, digest: d } } }
      }
  }
}

// THE ISA A MEDIA ROW BUILDS FOR, from Canonical's port name (Debian's: arm64 is AArch64, amd64 is x86-64). Read
// off the row's own wire spelling, so no architecture is authored beside the media; a port name outside these is
// absence and leaves the chain Unpinned rather than guessed.
fn site_pxe_edge_media_architecture(media: UbuntuInstallMediaArtifactRow) -> Architecture? {
  let port = ubuntu_install_media_architecture_wire(arch: media.architecture) as String
  if port == "amd64" { Present { value: X86_64 } } else if port == "arm64" { Present { value: Aarch64 } } else { Absent }
}

// THE ROW DECLARES ITS ARCHITECTURE, as the arm64 row does, and the media it serves must build for it: a row
// whose media is another architecture's is Unpinned on that disagreement, never re-labelled.
fn site_pxe_edge_ubuntu_chain_pin(row_architecture: Architecture, audience: SiteEdgeChainAudience, chain: UbuntuNetworkBootChain, pins: List<UbuntuNetworkBootMemberPin>, rendered_configuration: String?, citation: NonEmptyStr) -> SitePxeEdgeChainPin {
  match site_pxe_edge_media_architecture(media: chain.media) {
    Present { value: arch } =>
      if arch == row_architecture {
        site_pxe_edge_ubuntu_chain_pin_for(arch: arch, audience: audience, chain: chain, pins: pins, rendered_configuration: rendered_configuration, citation: citation)
      } else {
        SitePxeEdgeChainUnpinned { architecture: row_architecture, audience: audience, obligation: "the row's media builds for another architecture" }
      }
    Absent => SitePxeEdgeChainUnpinned { architecture: row_architecture, audience: audience, obligation: "the row's media port name maps to no architecture" }
  }
}

fn site_pxe_edge_ubuntu_chain_pin_for(arch: Architecture, audience: SiteEdgeChainAudience, chain: UbuntuNetworkBootChain, pins: List<UbuntuNetworkBootMemberPin>, rendered_configuration: String?, citation: NonEmptyStr) -> SitePxeEdgeChainPin {
  let head = site_pxe_edge_ubuntu_member_pinning(media: chain.media, m: chain.members.head, pins: pins, rendered_configuration: rendered_configuration)
  let tail = map(chain.members.tail, m => site_pxe_edge_ubuntu_member_pinning(media: chain.media, m: m, pins: pins, rendered_configuration: rendered_configuration))
  match first_where(xs: [head] + tail, keep: x => match x { MemberUnpinned { obligation: _ } => true MemberPinned { member: _ } => false }) {
    Present { value: MemberUnpinned { obligation: o } } => SitePxeEdgeChainUnpinned { architecture: arch, audience: audience, obligation: o }
    Present { value: MemberPinned { member: _ } } => SitePxeEdgeChainUnpinned { architecture: arch, audience: audience, obligation: "unreachable: a pinned member was selected as unpinned" }
    Absent =>
      match head {
        MemberUnpinned { obligation: o } => SitePxeEdgeChainUnpinned { architecture: arch, audience: audience, obligation: o }
        MemberPinned { member: h } => SitePxeEdgeChainPinned {
          chain: SitePxeEdgePinnedChain {
            architecture: arch,
            audience: audience,
            members: FreeSemigroup { head: h, tail: flat_map(tail, x => match x { MemberPinned { member: pm } => [pm] MemberUnpinned { obligation: _ } => [] }) },
            citation: citation,
          },
        }
      }
  }
}

// THE CHAINS THIS EDGE SERVES, one per (architecture, audience). The Ubuntu rows' grub/grub.cfg is the
// FALLBACK configuration: GRUB reads grub/grub.cfg-01-<mac> before it (the GRUB manual, Network), so a host
// with an install binding gets its own configuration and every other host returns to its next boot device.
// Both GRUB builds embed the prefix /grub, so the two Ubuntu chains share that one file with identical bytes.
// aarch64 keeps the iPXE row as its default chain (EveryKnownClient); its Ubuntu chain is offered only to a
// client an install binding names (InstallBoundClients), so an unbound arm64 client never reaches an
// installer. Nothing that a client reaches by default installs anything.
data site_pxe_edge_chain_pins: List<SitePxeEdgeChainPin> = [
  site_pxe_edge_arm64_ipxe_chain_pin(pin: site_pxe_edge_chainloader_pin),
  site_pxe_edge_ubuntu_chain_pin(
    row_architecture: X86_64,
    audience: EveryKnownClient,
    chain: noble_numbat_2404_3_amd64_uefi_network_boot_chain,
    pins: ubuntu_noble_amd64_network_boot_member_pins(),
    rendered_configuration: Present { value: site_pxe_edge_fallback_grub_cfg },
    citation: join(["Ubuntu 24.04.3 amd64 signed shim and network GRUB per ", ubuntu_amd64_netboot_authority.uri.locator as String], "") as NonEmptyStr,
  ),
  site_pxe_edge_ubuntu_chain_pin(
    row_architecture: Aarch64,
    audience: InstallBoundClients,
    chain: noble_numbat_2404_3_arm64_uefi_network_boot_chain,
    pins: ubuntu_noble_2404_3_arm64_network_boot_member_pins(),
    rendered_configuration: Present { value: site_pxe_edge_fallback_grub_cfg },
    citation: join(["Ubuntu 24.04.3 arm64 signed shim and network GRUB per ", ubuntu_arm64_netboot_authority.uri.locator as String], "") as NonEmptyStr,
  ),
]

// THE INSTALLS REQUESTED OF THIS EDGE, and the observation that srv4's name resolves from the segment. A request
// names its client by a MAC parse and its user-data as a document; the run admits each through the public seed
// authority, so a list of already-admitted seeds (which could only be authored by dropping refusals) never exists.
data site_pxe_edge_install_requests: List<SitePxeEdgeInstallRequest> = [
  SitePxeEdgeInstallRequest {
    client: srv14_install_client,
    user_data: autoinstall_user_data_document(payload: site_pxe_edge_key_only_autoinstall),
    architecture: Aarch64,
  },
  SitePxeEdgeInstallRequest {
    client: srv15_install_client,
    user_data: autoinstall_user_data_document(payload: site_pxe_edge_key_only_autoinstall),
    architecture: Aarch64,
  },
]

data srv14_install_client: MacParseResult = parse_mac_address(text: srv14_host_nic_mac as String)

data srv15_install_client: MacParseResult = parse_mac_address(text: srv15_host_nic_mac as String)

// THE ONE INSTALL THIS EDGE SERVES: the fleet's key-only account, no identity section, and the direct layout over
// the installer's chosen disk, which replaces whatever OS the NVMe carried before. Nothing in it names a host (the
// seed's instance-id comes from the request's MAC), so every request shares it rather than copying it per host.
// The seed travels over NoCloud-net from this edge's seed root; the per-client directory under it is the edge's to
// name from the admitted binding.
data site_pxe_edge_key_only_autoinstall: UbuntuAutoinstallPayload = UbuntuAutoinstallPayload {
  autoinstall_version: 1,
  delivery: NoCloudNet { seed_url: site_pxe_edge_seed_root_uri },
  fully_automated: true,
  target_distribution: NobleNumbat2404Lts,
  identity_posture: UserDataOnly { users: srv_fleet_key_only_install_account },
  locale: "en_US.UTF-8",
  keyboard_layout: "us",
  ssh: Present { value: AutoinstallSshServer { authorized_keys: fleet_authorized_keys, password_auth: false } },
  storage_policy: StoragePolicyDirectLayout,
}

// THE CLIENTS THE EDGE KNOWS, each parsed from a measured observation of the client's NIC, never retyped.
data site_pxe_edge_known_client_observations: List<MacParseResult> = [
  first_onboarding_known_client_mac,
  srv14_install_client,
  srv15_install_client,
]

data site_pxe_edge_seed_origin_resolution: BootNetworkProbe = site_pxe_edge_seed_origin_probe(
  answer: parse_ipv4_address(text: srv4_segment_resolver_answer as String),
  origin: site_pxe_edge_tftp_server_address,
  observation: decl_ref(module_path: "gunbc.fleet.srv4_segment_name_resolution_observation", decl_name: "srv4_segment_resolver_answer"),
  observed_at: srv4_segment_resolver_observed_at,
)

// The segment resolves the seed origin's name only if it answers with the address the edge serves from; any other
// answer, or one that does not parse, is a failed probe.
fn site_pxe_edge_seed_origin_probe(answer: Ipv4ParseResult, origin: Ipv4ParseResult, observation: DeclarationRef, observed_at: EpochMs) -> BootNetworkProbe {
  match answer {
    Ipv4Parsed { address: a } =>
      match origin {
        Ipv4Parsed { address: o } =>
          if (a == o) {
            BootNetworkProbeSucceeded { observation: observation, observed_at: observed_at }
          } else {
            BootNetworkProbeFailed { observation: observation, observed_at: observed_at }
          }
        Ipv4ParseFailed { error: _ } => BootNetworkProbeFailed { observation: observation, observed_at: observed_at }
      }
    Ipv4ParseFailed { error: _ } => BootNetworkProbeFailed { observation: observation, observed_at: observed_at }
  }
}

// ── Per-chain standing (pure) ────────────────────────────────────────────────────────────────────

type SitePxeEdgeMemberObservation {
  served_path: NonEmptyStr
  digest: SitePxeEdgeChainloaderObservation
}


// WHY ONE CHAIN IS WITHHELD, typed and located on the member. A withheld chain gets no pxe-service line,
// so a member whose bytes differ from its pin is never offered to any client.
type SitePxeEdgeChainCause
  = ChainUnpinned { obligation: NonEmptyStr }
  | MemberUnobservable { served_path: NonEmptyStr, reason: String }
  | MemberDigestMismatch { served_path: NonEmptyStr, observed: ContentHash, pinned: ContentHash }
  | IpxeArtifactNotTheCheckedArtifact { pinned: NonEmptyStr, checked: NonEmptyStr }
  | IpxeBuildTargetMismatch { pinned: IpxeBuildTarget, expected: IpxeBuildTarget }
  | IpxeBuildArchitectureMismatch { build: Architecture, chain: Architecture }
  | IpxeInstalledFilenameMismatch { pinned: NonEmptyStr, expected: NonEmptyStr }
  | IpxeSecureBootUnobserved { why: NonEmptyStr }
  | IpxeSecureBootRefused { why: NonEmptyStr }
  | IpxeSecureBootRejected { evidence: NonEmptyStr }

type SitePxeEdgeChainStanding
  = SitePxeEdgeChainServable { chain: SitePxeEdgePinnedChain }
  | SitePxeEdgeChainWithheld { architecture: Architecture, audience: SiteEdgeChainAudience, causes: FreeSemigroup<SitePxeEdgeChainCause> }

// WHAT SECURE BOOT SAYS ABOUT A CHAIN, one authority read by this edge's chain causes and by the provisioning
// arm (gunbc.provisioning.provisioning_arm). Only an iPXE member carries a Secure Boot standing: it is
// self-built and unsigned, so a firmware enforcing Secure Boot refuses it unless a verdict says otherwise. A
// chain with no iPXE member (the Ubuntu signed chain) has no unsigned image for Secure Boot to reject, so
// it is NoUnsignedMember; whether the unit enforced Secure Boot, and so whether the chain's verifiers ran,
// is measured on the unit and recorded on the attempt's receipt, never assumed here.
type SitePxeEdgeChainSecureBoot
  = ChainSecureBootNoUnsignedMember
  | ChainSecureBootBooted { evidence: NonEmptyStr }
  | ChainSecureBootUnobserved { why: NonEmptyStr }
  | ChainSecureBootRefused { why: NonEmptyStr }
  | ChainSecureBootRejected { evidence: NonEmptyStr }

fn site_pxe_edge_build_secure_boot(build: SitePxeEdgeChainloaderBuildReceipt) -> SitePxeEdgeChainSecureBoot {
  match build.secure_boot {
    SecureBootObserved { verdict: SecureBootVerdictBooted, evidence: e } => ChainSecureBootBooted { evidence: e }
    SecureBootObserved { verdict: SecureBootVerdictRejected, evidence: e } => ChainSecureBootRejected { evidence: e }
    SecureBootUnobserved { why: w } => ChainSecureBootUnobserved { why: w }
    SecureBootRefused { why: w } => ChainSecureBootRefused { why: w }
  }
}

fn site_pxe_edge_chain_build_secure_boots(chain: SitePxeEdgePinnedChain) -> List<SitePxeEdgeChainSecureBoot> {
  flat_map(site_pxe_edge_pinned_members(chain: chain), m => match m.source {
    IpxeBuildSource { build: b } => [site_pxe_edge_build_secure_boot(build: b)]
    VerifiedMediaSource { media: _, source: _, pin: _, digest: _ } => []
    RenderedSource { content: _, digest: _ } => []
  })
}

fn site_pxe_edge_secure_boot_blocks(sb: SitePxeEdgeChainSecureBoot) -> Bool {
  match sb {
    ChainSecureBootNoUnsignedMember => false
    ChainSecureBootBooted { evidence: _ } => false
    ChainSecureBootUnobserved { why: _ } => true
    ChainSecureBootRefused { why: _ } => true
    ChainSecureBootRejected { evidence: _ } => true
  }
}

// The first blocking standing of any unsigned member; otherwise a member's Booted verdict; otherwise the
// chain has no unsigned member at all.
fn site_pxe_edge_chain_secure_boot(chain: SitePxeEdgePinnedChain) -> SitePxeEdgeChainSecureBoot {
  let standings = site_pxe_edge_chain_build_secure_boots(chain: chain)
  match first_where(xs: standings, keep: sb => site_pxe_edge_secure_boot_blocks(sb: sb)) {
    Present { value: blocking } => blocking
    Absent =>
      match standings.first() {
        Present { value: booted } => booted
        Absent => ChainSecureBootNoUnsignedMember
      }
  }
}

// THE iPXE BUILD'S OWN CHECKS, for an iPXE member only: the receipt names the arm64 snponly target, an
// architecture equal to the chain's, the served filename, and a settled Secure Boot verdict. These were
// the edge-wide gate's chainloader causes when the edge had one chain.
fn site_pxe_edge_ipxe_build_causes(build: SitePxeEdgeChainloaderBuildReceipt, member: SitePxeEdgePinnedMember, chain_architecture: Architecture) -> List<SitePxeEdgeChainCause> {
  (if build.artifact == site_pxe_edge_committed_ipxe_arm64 {
    []
  } else {
    [IpxeArtifactNotTheCheckedArtifact { pinned: build.artifact.path, checked: site_pxe_edge_committed_ipxe_arm64.path }]
  }) + (if build.build_target == ipxe_arm64_efi_snponly {
    []
  } else {
    [IpxeBuildTargetMismatch { pinned: build.build_target, expected: ipxe_arm64_efi_snponly }]
  }) + (if build.architecture == chain_architecture {
    []
  } else {
    [IpxeBuildArchitectureMismatch { build: build.architecture, chain: chain_architecture }]
  }) + (if (build.installed_filename as String) == (member.member.served_path as String) && (build.installed_filename as String) == (ipxe_arm64_efi_snponly.image as String) {
    []
  } else {
    [IpxeInstalledFilenameMismatch { pinned: build.installed_filename, expected: ipxe_arm64_efi_snponly.image }]
  }) + (match site_pxe_edge_build_secure_boot(build: build) {
    ChainSecureBootBooted { evidence: _ } => []
    ChainSecureBootNoUnsignedMember => []
    ChainSecureBootRejected { evidence: e } => [IpxeSecureBootRejected { evidence: e }]
    ChainSecureBootUnobserved { why: w } => [IpxeSecureBootUnobserved { why: w }]
    ChainSecureBootRefused { why: w } => [IpxeSecureBootRefused { why: w }]
  })
}

fn site_pxe_edge_digest_causes(member: SitePxeEdgePinnedMember, observations: List<SitePxeEdgeMemberObservation>) -> List<SitePxeEdgeChainCause> {
  match first_where(xs: observations, keep: o => (o.served_path as String) == (member.member.served_path as String)) {
    Absent => [MemberUnobservable { served_path: member.member.served_path, reason: "no digest was taken of this member" }]
    Present { value: o } =>
      match o.digest {
        ChainloaderDigestUnobservable { reason: r } => [MemberUnobservable { served_path: member.member.served_path, reason: r }]
        ChainloaderDigestObserved { digest: d } =>
          if content_hash_equal(left: d, right: site_pxe_edge_member_digest(m: member)) { [] } else { [MemberDigestMismatch { served_path: member.member.served_path, observed: d, pinned: site_pxe_edge_member_digest(m: member) }] }
      }
  }
}

// A RENDERED MEMBER HAS NO DIGEST CAUSE HERE: it is a desired file, and its readback is the file write's
// own comparison; gating the chain on it would withhold the chain whose rendering has not been written yet.
fn site_pxe_edge_member_causes(member: SitePxeEdgePinnedMember, chain_architecture: Architecture, observations: List<SitePxeEdgeMemberObservation>) -> List<SitePxeEdgeChainCause> {
  match member.source {
    RenderedSource { content: _, digest: _ } => []
    VerifiedMediaSource { media: _, source: _, pin: _, digest: _ } => site_pxe_edge_digest_causes(member: member, observations: observations)
    IpxeBuildSource { build: b } =>
      site_pxe_edge_digest_causes(member: member, observations: observations)
        + site_pxe_edge_ipxe_build_causes(build: b, member: member, chain_architecture: chain_architecture)
  }
}

fn site_pxe_edge_chain_standing(pin: SitePxeEdgeChainPin, observations: List<SitePxeEdgeMemberObservation>) -> SitePxeEdgeChainStanding {
  match pin {
    SitePxeEdgeChainUnpinned { architecture: a, audience: au, obligation: o } => SitePxeEdgeChainWithheld { architecture: a, audience: au, causes: FreeSemigroup { head: ChainUnpinned { obligation: o }, tail: [] } }
    SitePxeEdgeChainPinned { chain: c } =>
      match flat_map(site_pxe_edge_pinned_members(chain: c), m => site_pxe_edge_member_causes(member: m, chain_architecture: c.architecture, observations: observations)).first() {
        Absent => SitePxeEdgeChainServable { chain: c }
        Present { value: first } => SitePxeEdgeChainWithheld {
          architecture: c.architecture,
          audience: c.audience,
          causes: FreeSemigroup {
            head: first,
            tail: skip(xs: flat_map(site_pxe_edge_pinned_members(chain: c), m => site_pxe_edge_member_causes(member: m, chain_architecture: c.architecture, observations: observations)), n: 1),
          },
        }
      }
  }
}

fn site_pxe_edge_servable_chains(standings: List<SitePxeEdgeChainStanding>) -> List<SitePxeEdgePinnedChain> {
  flat_map(standings, st => match st {
    SitePxeEdgeChainServable { chain: c } => [c]
    SitePxeEdgeChainWithheld { architecture: _, audience: _, causes: _ } => []
  })
}

fn site_pxe_edge_chain_cause_is_unobserved(cause: SitePxeEdgeChainCause) -> Bool {
  match cause {
    MemberUnobservable { served_path: _, reason: _ } => true
    ChainUnpinned { obligation: _ } => false
    MemberDigestMismatch { served_path: _, observed: _, pinned: _ } => false
    IpxeArtifactNotTheCheckedArtifact { pinned: _, checked: _ } => false
    IpxeBuildTargetMismatch { pinned: _, expected: _ } => false
    IpxeBuildArchitectureMismatch { build: _, chain: _ } => false
    IpxeInstalledFilenameMismatch { pinned: _, expected: _ } => false
    IpxeSecureBootUnobserved { why: _ } => false
    IpxeSecureBootRefused { why: _ } => false
    IpxeSecureBootRejected { evidence: _ } => false
  }
}

fn site_pxe_edge_chain_cause_text(cause: SitePxeEdgeChainCause) -> String {
  match cause {
    ChainUnpinned { obligation: o } => concat("chain-unpinned: ", o as String)
    MemberUnobservable { served_path: p, reason: r } => join(["member-unobservable ", p as String, ": ", r], "")
    MemberDigestMismatch { served_path: p, observed: o, pinned: q } => join(["member-digest-mismatch ", p as String, ": observed ", serialize_content_hash(hash: o) as String, ", pinned ", serialize_content_hash(hash: q) as String], "")
    IpxeArtifactNotTheCheckedArtifact { pinned: p, checked: c } => join(["ipxe-artifact-not-the-checked-artifact: the pin names ", p as String, ", the real-execution witness checks ", c as String], "")
    IpxeBuildTargetMismatch { pinned: p, expected: e } => join(["ipxe-build-target-mismatch: pinned ", ipxe_build_target_path(target: p) as String, ", expected ", ipxe_build_target_path(target: e) as String], "")
    IpxeBuildArchitectureMismatch { build: _, chain: _ } => "ipxe-build-architecture-mismatch: the pinned build is not for the chain's architecture"
    IpxeInstalledFilenameMismatch { pinned: p, expected: e } => join(["ipxe-installed-filename-mismatch: pinned ", p as String, ", expected ", e as String], "")
    IpxeSecureBootUnobserved { why: w } => concat("ipxe-secure-boot-unobserved: ", w as String)
    IpxeSecureBootRefused { why: w } => concat("ipxe-secure-boot-refused: ", w as String)
    IpxeSecureBootRejected { evidence: e } => concat("ipxe-secure-boot-rejected: ", e as String)
  }
}

fn site_pxe_edge_chain_label(architecture: Architecture, audience: SiteEdgeChainAudience) -> String {
  concat(architecture_diagnostic_name(arch: architecture) as String, match audience { EveryKnownClient => "" InstallBoundClients => " install" })
}

fn site_pxe_edge_chain_standing_text(standing: SitePxeEdgeChainStanding) -> String {
  match standing {
    SitePxeEdgeChainServable { chain: c } => join(["chain ", site_pxe_edge_chain_label(architecture: c.architecture, audience: c.audience), " servable\n"], "")
    SitePxeEdgeChainWithheld { architecture: a, audience: au, causes: cs } =>
      join(map(non_empty_to_list(xs: cs), c => join(["chain ", site_pxe_edge_chain_label(architecture: a, audience: au), " withheld ", site_pxe_edge_chain_cause_text(cause: c), "\n"], "")), "")
  }
}

// ── Desired files (pure) ─────────────────────────────────────────────────────────────────────────

type SitePxeEdgeFile {
  subject: NonEmptyStr
  path: FilePath
  content: String
  scope: FileTreeScope
}

// THE TFTP SERVER ADDRESS IS srv4's MODELED LAN ENDPOINT, parsed rather than re-typed; a failure to
// parse is a gate cause, never a guessed address.
data site_pxe_edge_tftp_server_address: Ipv4ParseResult = parse_ipv4_address(text: srv4_host_lan_endpoint.address as String)

// THE EDGE ROSTER THIS HOST SERVES, from the pinned transport's digest and TFTP route plus the parsed
// known clients: the same SiteEdgeRoster type admission gates on, so the written config and a later
// admission read one authored value.
// THE iPXE CHAIN IS ONE MEMBER: the self-built snponly image, unsigned (NotAuthenticated), fetching every
// later stage over global HTTPS. Its citation is the iPXE build path and the chainloading how-to.
fn site_pxe_edge_ipxe_chain_citation(target: SitePxeEdgeChainloaderBuildReceipt) -> NonEmptyStr {
  join(["iPXE ", ipxe_build_target_path(target: target.build_target) as String, " per ", ipxe_chainloading_authority.uri.locator as String], "") as NonEmptyStr
}

fn site_pxe_edge_served_chain_of(chain: SitePxeEdgePinnedChain) -> SiteEdgeServedChain? {
  site_edge_served_chain(
    architecture: chain.architecture,
    audience: chain.audience,
    members: FreeSemigroup {
      head: SiteEdgeServedMember { member: chain.members.head.member, digest: site_pxe_edge_member_digest(m: chain.members.head) },
      tail: map(chain.members.tail, m => SiteEdgeServedMember { member: m.member, digest: site_pxe_edge_member_digest(m: m) }),
    },
    citation: chain.citation,
  )
}

// THE EDGE ROSTER THIS HOST SERVES, from the servable chains plus the parsed known clients: the same
// SiteEdgeRoster type admission gates on, so the written config and a later admission read one value. A
// chain the edge model does not admit is absence of the whole roster, never a quietly shorter one.
fn site_pxe_edge_roster(chains: FreeSemigroup<SitePxeEdgePinnedChain>, known_client_macs: List<Eui48Address>, install_client_macs: List<Eui48Address>, tftp_server_address: Ipv4Address) -> SiteEdgeRoster? {
  let served = map(non_empty_to_list(xs: chains), c => site_pxe_edge_served_chain_of(chain: c))
  if any(served, x => match x { Absent => true Present { value: _ } => false }) {
    Absent
  } else {
    let present = flat_map(served, x => match x { Present { value: c } => [c] Absent => [] })
    match present.first() {
      Absent => Absent
      Present { value: head } => Present { value: SiteEdgeRoster {
        site: operator_site,
        served_chains: FreeSemigroup { head: head, tail: skip(xs: present, n: 1) },
        tftp_server_name: site_pxe_edge_host as NonEmptyStr,
        tftp_server_address: tftp_server_address,
        known_client_macs: known_client_macs,
        install_client_macs: install_client_macs,
      } }
    }
  }
}

fn site_pxe_edge_config_file(roster: SiteEdgeRoster, network: Ipv4Address) -> SitePxeEdgeFile {
  SitePxeEdgeFile {
    subject: "dnsmasq-proxy-dhcp-config",
    path: site_pxe_edge_config_path,
    content: site_edge_proxy_dhcp_config(
      network_address: network,
      roster: roster,
      tftp_directory: site_pxe_edge_tftp_root,
    ),
    scope: site_pxe_edge_file_scope,
  }
}

data site_pxe_edge_unit: SystemdUnitFile = ServiceUnitFile {
  unit: [
    Description { text: "gunbc site PXE edge: ProxyDHCP + TFTP, one served chain per UEFI client class and audience" },
    After { target: "network-online.target" },
    Wants { target: "network-online.target" },
  ],
  service: [
    ServiceType { mode: SimpleMode },
    ExecStart { command: join([site_pxe_edge_dnsmasq_binary as String, " --keep-in-foreground --conf-file=", site_pxe_edge_config_path as String], "") as NonEmptyStr },
    Restart { policy: "on-failure" },
  ],
  install: Installable { directives: [WantedBy { target: "multi-user.target" }] },
}

fn site_pxe_edge_unit_file() -> SitePxeEdgeFile {
  SitePxeEdgeFile {
    subject: "systemd-unit",
    path: site_pxe_edge_unit_path,
    content: serialize_systemd_unit_file(file: site_pxe_edge_unit),
    scope: site_pxe_edge_file_scope,
  }
}

// ONE DERIVATION OF THE DESIRED CONFIG'S INPUTS, read by the file list and answerable beside the gate:
// the roster and the segment the config renders exist exactly when the pin, every known-client MAC, the
// TFTP server address and the segment all parsed, which is the same set site_pxe_edge_gate_causes types.
// Deriving it twice is how an apply could have no causes and still narrow to the unit file alone. The
// install-bound MACs are the bindings' clients that are also known: a binding for an unknown client tags
// nothing, and its standing says InstallClientNotOnRoster.
type SitePxeEdgeDesiredInputs {
  roster: SiteEdgeRoster
  network: Ipv4Address
  chains: List<SitePxeEdgePinnedChain>
}

fn site_pxe_edge_parsed_macs(observations: List<MacParseResult>) -> List<Eui48Address>? {
  if any(observations, o => match o { MacParseFailed { error: _ } => true MacParsed { address: _ } => false }) {
    Absent
  } else {
    Present { value: flat_map(observations, o => match o { MacParsed { address: a } => [a] MacParseFailed { error: _ } => [] }) }
  }
}

fn site_pxe_edge_desired_inputs(
  servable: List<SitePxeEdgePinnedChain>,
  known: List<MacParseResult>,
  bindings: List<SitePxeEdgeInstallBinding>,
  tftp_server: Ipv4ParseResult,
  segment: Ipv4ParseResult,
) -> SitePxeEdgeDesiredInputs? {
  match servable.first() {
    Absent => Absent
    Present { value: first } =>
      match site_pxe_edge_parsed_macs(observations: known) {
        Absent => Absent
        Present { value: macs } =>
          match tftp_server {
            Ipv4ParseFailed { error: _ } => Absent
            Ipv4Parsed { address: server } =>
              match segment {
                Ipv4ParseFailed { error: _ } => Absent
                Ipv4Parsed { address: network } =>
                  match site_pxe_edge_roster(
                    chains: FreeSemigroup { head: first, tail: skip(xs: servable, n: 1) },
                    known_client_macs: macs,
                    install_client_macs: filter(map(bindings, b => site_pxe_edge_binding_mac(binding: b)), m => any(macs, k => k == m)),
                    tftp_server_address: server,
                  ) {
                    Absent => Absent
                    Present { value: r } => Present { value: SitePxeEdgeDesiredInputs { roster: r, network: network, chains: servable } }
                  }
              }
          }
      }
  }
}

// A RENDERED MEMBER IS A DESIRED FILE in the TFTP root, scoped to that root; the placement step that puts
// the blob members there also creates the directories they sit in (typed_remote_file_write creates none).
fn site_pxe_edge_rendered_member_files(chains: List<SitePxeEdgePinnedChain>) -> List<SitePxeEdgeFile> {
  flat_map(chains, c => flat_map(site_pxe_edge_pinned_members(chain: c), m => match m.source {
    RenderedSource { content: body, digest: _ } => [SitePxeEdgeFile { subject: concat("rendered-member ", m.member.served_path as String), path: site_pxe_edge_member_path(member: m) as FilePath, content: body, scope: site_pxe_edge_tftp_scope }]
    IpxeBuildSource { build: _ } => []
    VerifiedMediaSource { media: _, source: _, pin: _, digest: _ } => []
  }))
}

data site_pxe_edge_tftp_scope: FileTreeScope = FileTreeScope { root_path: site_pxe_edge_tftp_root }

// THE FALLBACK GRUB CONFIGURATION, served at grub/grub.cfg: it boots nothing and installs nothing. GRUB's
// `exit` returns to the firmware, which tries the next boot device.
data site_pxe_edge_fallback_grub_cfg: String = "# gunbc.fleet.site_pxe_edge_converge: no install binding for this client; return to the next boot device\nexit\n"

// ── The install surface: the HTTP-served installer image and per-host install bindings ────────────
// merry-fox-82's conditions (msg_42e15131), each realized here: the HTTP unit binds srv4's onboarding address
// only, read back from its listening socket; a host's seed is served under its roster MAC, which its grub
// configuration names; the installer image is checked against Canonical's digest at
// readback and a mismatch withholds every install binding; grub configurations name srv4 by its host
// identity, never an address, and a binding is refused until that name was observed resolving from the
// segment. SEEDS ARE PUBLIC: http.server authenticates no client, so any host on the segment that names a seed's
// URL receives it, and the MAC in the URL routes a client to its seed without restricting who may fetch it. No
// confidentiality is claimed for a seed anywhere; what makes publishing it safe is that the binding carries only a
// gunbc.provisioning.public_nocloud_seed PublicNoCloudSeed, whose one mint refuses any credential.
data site_pxe_edge_http_root: NonEmptyStr = "/srv/gunbc-site-pxe-edge/http"

data site_pxe_edge_http_scope: FileTreeScope = FileTreeScope { root_path: site_pxe_edge_http_root }

data site_pxe_edge_http_port: Port = 8080

data site_pxe_edge_http_unit_name: NonEmptyStr = "gunbc-site-pxe-edge-http.service"

data site_pxe_edge_http_unit_path: FilePath = join([systemd_system_unit_directory as String, "/", site_pxe_edge_http_unit_name as String], "") as FilePath

data site_pxe_edge_python_binary: NonEmptyStr = "/usr/bin/python3"

// THE SEED ORIGIN IS NAMED BY srv4's HOST IDENTITY, which the operator ruled is how hosts are named (stable
// hostnames, not IPs; work item adhoc-37e2c372-ad5). Whether the installer's DHCP-provided resolver answers for
// it is an observation, required before any binding renders.
data site_pxe_edge_seed_origin_name: NonEmptyStr = site_pxe_edge_host as NonEmptyStr

fn site_pxe_edge_http_unit(bind: Ipv4Address) -> SystemdUnitFile {
  ServiceUnitFile {
    unit: [
      Description { text: "gunbc site PXE edge: install seeds and the verified installer image over HTTP, onboarding segment only" },
      After { target: "network-online.target" },
      Wants { target: "network-online.target" },
    ],
    service: [
      ServiceType { mode: SimpleMode },
      ServiceUser { name: "nobody" },
      ExecStart { command: http_server_command_line(invocation: HttpServerInvocation { interpreter: site_pxe_edge_python_binary, bind_address: render_ipv4_address(addr: bind), port: site_pxe_edge_http_port, directory: site_pxe_edge_http_root }) },
      Restart { policy: "on-failure" },
    ],
    install: Installable { directives: [WantedBy { target: "multi-user.target" }] },
  }
}

fn site_pxe_edge_http_unit_file(bind: Ipv4Address) -> SitePxeEdgeFile {
  SitePxeEdgeFile {
    subject: "systemd-unit-http",
    path: site_pxe_edge_http_unit_path,
    content: serialize_systemd_unit_file(file: site_pxe_edge_http_unit(bind: bind)),
    scope: site_pxe_edge_file_scope,
  }
}

// THE INSTALLER IMAGE the edge serves, pinned to the media row's own digest: Canonical's SHA256SUMS line under
// the CD signing key (extdeps.provisioning.ubuntu_install_media), never a figure of ours.
type SitePxeEdgeInstallerImage {
  media: UbuntuInstallMediaArtifactRow
  served_path: NonEmptyStr
  digest: ContentHash
}

fn site_pxe_edge_installer_image(media: UbuntuInstallMediaArtifactRow) -> SitePxeEdgeInstallerImage? {
  match sha256_hex_digest(hex: media.content_sha256 as String) {
    Absent => Absent
    Present { value: d } => Present { value: SitePxeEdgeInstallerImage { media: media, served_path: concat("iso/", ubuntu_install_media_filename(artifact: media) as String) as NonEmptyStr, digest: Sha256Hash(d) } }
  }
}

fn site_pxe_edge_installer_image_path(image: SitePxeEdgeInstallerImage) -> NonEmptyStr {
  join([site_pxe_edge_http_root as String, "/", image.served_path as String], "") as NonEmptyStr
}

fn site_pxe_edge_http_uri(name: NonEmptyStr, path: String) -> Uri {
  Uri { scheme: Http, locator: join([name as String, ":", to_string(site_pxe_edge_http_port), "/", path], "") as NonEmptyStr }
}

// ONE HOST'S INSTALL, as the provisioning attempt hands it over: its PUBLIC NoCloud seed, admitted for the client's NIC MAC
// admitted secret-free by gunbc.provisioning.public_nocloud_seed admit_public_nocloud_seed from the seed renderer's
// documents, and the client's architecture, which selects the chain it installs through. The edge serves the seed's
// bytes and never authors them; a raw document string has no way in.
type SitePxeEdgeInstallBinding {
  seed: PublicNoCloudSeed
  architecture: Architecture
}

// ONE INSTALL AS REQUESTED, before admission: the client's MAC as parsed from its observation, the seed renderer's
// user-data document, and the architecture. Admission is the only route from a request to a binding.
type SitePxeEdgeInstallRequest {
  client: MacParseResult
  user_data: YamlValue
  architecture: Architecture
}

// WHAT ADMISSION MADE OF ONE REQUEST. A refused seed withholds that host's install by name and leaves the edge
// serving everyone else; an unparseable client MAC names no host to withhold, so it closes the gate instead.
type SitePxeEdgeRequestAdmission
  = RequestBound { binding: SitePxeEdgeInstallBinding }
  | RequestWithheld { standing: SitePxeEdgeInstallStanding }
  | RequestClientUnparseable { error: MacParseError }

fn site_pxe_edge_request_admission(request: SitePxeEdgeInstallRequest) -> SitePxeEdgeRequestAdmission {
  match request.client {
    MacParseFailed { error: e } => RequestClientUnparseable { error: e }
    MacParsed { address: mac } =>
      match admit_public_nocloud_seed(client_mac: mac, user_data: request.user_data) {
        PublicSeedAdmitted { seed: sd } => RequestBound { binding: SitePxeEdgeInstallBinding { seed: sd, architecture: request.architecture } }
        PublicSeedRefused { findings: fs } => RequestWithheld { standing: InstallWithheld { mac: mac, refusals: FreeSemigroup { head: InstallSeedRefused { findings: fs }, tail: [] } } }
      }
  }
}

fn site_pxe_edge_request_bindings(admissions: List<SitePxeEdgeRequestAdmission>) -> List<SitePxeEdgeInstallBinding> {
  flat_map(admissions, a => match a {
    RequestBound { binding: b } => [b]
    RequestWithheld { standing: _ } => []
    RequestClientUnparseable { error: _ } => []
  })
}

fn site_pxe_edge_request_withheld(admissions: List<SitePxeEdgeRequestAdmission>) -> List<SitePxeEdgeInstallStanding> {
  flat_map(admissions, a => match a {
    RequestBound { binding: _ } => []
    RequestWithheld { standing: st } => [st]
    RequestClientUnparseable { error: _ } => []
  })
}

fn site_pxe_edge_request_gate_causes(admissions: List<SitePxeEdgeRequestAdmission>) -> List<SitePxeEdgeGateCause> {
  flat_map(admissions, a => match a {
    RequestBound { binding: _ } => []
    RequestWithheld { standing: _ } => []
    RequestClientUnparseable { error: e } => [InstallRequestClientUnparseable { error: e }]
  })
}

// THE CHAIN AN ARCHITECTURE INSTALLS THROUGH: its chain that carries install media (a kernel, an initrd and
// the ISO they were extracted from). The iPXE chain carries none, so it is never an install chain; amd64's
// one Ubuntu chain and aarch64's install-bound Ubuntu chain each are.
type SitePxeEdgeInstallChain {
  chain: SitePxeEdgePinnedChain
  kernel: NonEmptyStr
  initrd: NonEmptyStr
  image: SitePxeEdgeInstallerImage
}

fn site_pxe_edge_role_path(chain: SitePxeEdgePinnedChain, role: NetworkBootLoaderRole) -> NonEmptyStr? {
  match first_where(xs: site_pxe_edge_pinned_members(chain: chain), keep: m => m.member.role == role) {
    Absent => Absent
    Present { value: m } => Present { value: m.member.served_path }
  }
}

fn site_pxe_edge_install_chain_of(chain: SitePxeEdgePinnedChain) -> SitePxeEdgeInstallChain? {
  match site_pxe_edge_chain_media(chain: chain) {
    ChainMediaRefused { cause: _ } => Absent
    ChainMediaOne { media: md } =>
      match site_pxe_edge_installer_image(media: md) {
        Absent => Absent
        Present { value: image } =>
          match site_pxe_edge_role_path(chain: chain, role: KernelImage) {
            Absent => Absent
            Present { value: k } =>
              match site_pxe_edge_role_path(chain: chain, role: InitrdImage) {
                Absent => Absent
                Present { value: i } => Present { value: SitePxeEdgeInstallChain { chain: chain, kernel: k, initrd: i, image: image } }
              }
          }
      }
  }
}

fn site_pxe_edge_install_chain(architecture: Architecture, chains: List<SitePxeEdgePinnedChain>) -> SitePxeEdgeInstallChain? {
  flat_map(filter(chains, c => c.architecture == architecture), c => match site_pxe_edge_install_chain_of(chain: c) {
    Present { value: ic } => [ic]
    Absent => []
  }).first()
}

// ONE BINDING READY TO SERVE: admitted, with the install chain and the image standing it was admitted over.
type SitePxeEdgeInstallServe {
  binding: SitePxeEdgeInstallBinding
  install: SitePxeEdgeInstallChain
}

// The binding's client is its seed's: the seed was admitted for that MAC (its meta-data instance-id is derived from
// it), so the routing MAC and the seed cannot name two different clients.
fn site_pxe_edge_binding_mac(binding: SitePxeEdgeInstallBinding) -> Eui48Address {
  public_nocloud_seed_client_mac(seed: binding.seed)
}

type SitePxeEdgeImageStanding
  = InstallerImageServable { image: SitePxeEdgeInstallerImage }
  | InstallerImageUnplaced { reason: String }
  | InstallerImageDigestMismatch { observed: ContentHash, pinned: ContentHash }

fn site_pxe_edge_image_standing(image: SitePxeEdgeInstallerImage, observation: SitePxeEdgeChainloaderObservation) -> SitePxeEdgeImageStanding {
  match observation {
    ChainloaderDigestUnobservable { reason: r } => InstallerImageUnplaced { reason: r }
    ChainloaderDigestObserved { digest: d } =>
      if content_hash_equal(left: d, right: image.digest) { InstallerImageServable { image: image } } else { InstallerImageDigestMismatch { observed: d, pinned: image.digest } }
  }
}

// WHY ONE HOST'S BINDING IS WITHHELD. A withheld binding renders no grub.cfg-01-<mac> and no seed, so that
// host reaches the fallback configuration and boots its next device.
type SitePxeEdgeInstallRefusal
  = InstallClientNotOnRoster { mac: Eui48Address }
  | InstallImageNotServable { standing: SitePxeEdgeImageStanding }
  | SeedOriginNameUnresolved { name: NonEmptyStr, probe: BootNetworkProbe }
  | InstallChainNotServable
  | InstallSeedRefused { findings: FreeSemigroup<PublicSeedFinding> }

fn site_pxe_edge_install_refusals(binding: SitePxeEdgeInstallBinding, roster: SiteEdgeRoster, install: SitePxeEdgeInstallChain?, image: SitePxeEdgeImageStanding, name_resolution: BootNetworkProbe) -> List<SitePxeEdgeInstallRefusal> {
  (if roster.known_client_macs |> any(m => m == site_pxe_edge_binding_mac(binding: binding)) { [] } else { [InstallClientNotOnRoster { mac: site_pxe_edge_binding_mac(binding: binding) }] })
    + (match image {
      InstallerImageServable { image: _ } => []
      InstallerImageUnplaced { reason: _ } => [InstallImageNotServable { standing: image }]
      InstallerImageDigestMismatch { observed: _, pinned: _ } => [InstallImageNotServable { standing: image }]
    })
    + (match name_resolution {
      BootNetworkProbeSucceeded { observation: _, observed_at: _ } => []
      BootNetworkProbeFailed { observation: _, observed_at: _ } => [SeedOriginNameUnresolved { name: site_pxe_edge_seed_origin_name, probe: name_resolution }]
      BootNetworkProbeUnobserved => [SeedOriginNameUnresolved { name: site_pxe_edge_seed_origin_name, probe: name_resolution }]
    })
    + (match install { Present { value: _ } => [] Absent => [InstallChainNotServable] })
}

// GRUB's per-MAC configuration name: "01-" (the Ethernet hardware type) and the MAC in lower-case hex, dashes
// between octets (the GRUB manual, Network).
fn site_pxe_edge_grub_mac_path(mac: Eui48Address) -> NonEmptyStr {
  concat("grub/grub.cfg-01-", join(split(s: render_mac_address(addr: mac) as String, delimiter: ":"), "-")) as NonEmptyStr
}

data site_pxe_edge_seed_root: String = "seed/"

data site_pxe_edge_seed_root_uri: Uri = site_pxe_edge_http_uri(name: site_pxe_edge_seed_origin_name, path: site_pxe_edge_seed_root)

fn site_pxe_edge_seed_path(mac: Eui48Address) -> String {
  concat(site_pxe_edge_seed_root, join(split(s: render_mac_address(addr: mac) as String, delimiter: ":"), "-"))
}

// ONE HOST'S GRUB CONFIGURATION: the casper kernel and initrd from this TFTP root, the verified installer image
// and this host's seed from srv4 over HTTP by name. cloud-config-url=/dev/null keeps cloud-init from reading the
// url= image as a cloud-config (Canonical's netboot how-to). The configuration is extdeps.bootloader.grub's model,
// rendered by grub_config_render, so the ds= argument (built from its NoCloudNet carrier by extdeps.os.ubuntu_autoinstall
// nocloud_net_ds_kernel_arg) is quoted by grub_cmdline_arg_render's one rule for GRUB's ';' (review 86171).
fn site_pxe_edge_host_kernel_cmdline(binding: SitePxeEdgeInstallBinding, image: SitePxeEdgeInstallerImage) -> List<KernelCmdlineArg> {
  let seed = NoCloudNet { seed_url: site_pxe_edge_http_uri(name: site_pxe_edge_seed_origin_name, path: concat(site_pxe_edge_seed_path(mac: site_pxe_edge_binding_mac(binding: binding)), "/")) }
  concat(
    [
      KernelKeyValue { key: "ip", value: "dhcp" },
      KernelKeyValue { key: "cloud-config-url", value: "/dev/null" },
      KernelKeyValue { key: "url", value: uri_wire(uri: site_pxe_edge_http_uri(name: site_pxe_edge_seed_origin_name, path: image.served_path as String)) as String },
      KernelFlag { name: "autoinstall" },
    ],
    concat(
      match nocloud_net_ds_kernel_arg(delivery: seed) {
        Present { value: a } => [a]
        Absent => []
      },
      [KernelFlag { name: "---" }],
    ),
  )
}

fn site_pxe_edge_host_grub_cfg(binding: SitePxeEdgeInstallBinding, install: SitePxeEdgeInstallChain) -> String {
  join([
    "# gunbc.fleet.site_pxe_edge_converge: install binding for ", render_mac_address(addr: site_pxe_edge_binding_mac(binding: binding)) as String, "\n",
    grub_config_render(cfg: GrubConfig {
      timeout_seconds: 1,
      default_entry: 0,
      entries: [
        GrubMenuEntry {
          title: "gunbc autoinstall",
          linux_image: concat("/", install.kernel as String),
          linux_cmdline: site_pxe_edge_host_kernel_cmdline(binding: binding, image: install.image),
          initrd_image: concat("/", install.initrd as String),
        },
      ],
    }),
    "\n",
  ], "")
}

fn site_pxe_edge_binding_files(binding: SitePxeEdgeInstallBinding, install: SitePxeEdgeInstallChain) -> List<SitePxeEdgeFile> {
  let seed_dir = join([site_pxe_edge_http_root as String, "/", site_pxe_edge_seed_path(mac: site_pxe_edge_binding_mac(binding: binding))], "")
  [
    SitePxeEdgeFile { subject: concat("install-grub ", render_mac_address(addr: site_pxe_edge_binding_mac(binding: binding)) as String) as NonEmptyStr, path: join([site_pxe_edge_tftp_root as String, "/", site_pxe_edge_grub_mac_path(mac: site_pxe_edge_binding_mac(binding: binding)) as String], "") as FilePath, content: site_pxe_edge_host_grub_cfg(binding: binding, install: install), scope: site_pxe_edge_tftp_scope },
    SitePxeEdgeFile { subject: concat("install-user-data ", render_mac_address(addr: site_pxe_edge_binding_mac(binding: binding)) as String) as NonEmptyStr, path: concat(seed_dir, "/user-data") as FilePath, content: public_nocloud_seed_user_data(seed: binding.seed), scope: site_pxe_edge_http_scope },
    SitePxeEdgeFile { subject: concat("install-meta-data ", render_mac_address(addr: site_pxe_edge_binding_mac(binding: binding)) as String) as NonEmptyStr, path: concat(seed_dir, "/meta-data") as FilePath, content: public_nocloud_seed_meta_data(seed: binding.seed), scope: site_pxe_edge_http_scope },
  ]
}

// The install files for every admitted binding, plus the HTTP unit when at least one is admitted; no binding,
// no HTTP server. A serve exists only for a binding admitted over a servable image, so the image standing has
// already been decided by the time a file is rendered.
fn site_pxe_edge_install_files(serves: List<SitePxeEdgeInstallServe>, bind: Ipv4Address) -> List<SitePxeEdgeFile> {
  if length(serves) == 0 { [] } else { [site_pxe_edge_http_unit_file(bind: bind)] + flat_map(serves, sv => site_pxe_edge_binding_files(binding: sv.binding, install: sv.install)) }
}

// THE LISTENING SOCKET, READ BACK: stdout of `ss -ltnH`, every TCP listener (the fleet SSH edge admits no word
// carrying a space, so the port filter is applied here, not passed to ss). Of the listeners on the HTTP port,
// the local address must be exactly the bound onboarding address; a wildcard (0.0.0.0, * or [::]) or any other
// address is refused, and no listener on the port is its own finding.
type SitePxeEdgeHttpListenStanding
  = HttpListenBoundTo { address: String }
  | HttpListenWildcard { local: String }
  | HttpListenOtherAddress { local: String }
  | HttpListenAbsent
  | HttpListenUnobservable { reason: String }

// THE LISTENER IS READ AFTER A RESTART THAT RETURNS BEFORE THE SERVER BINDS: srv4's run 40835829838 read ABSENT while
// the same port answered 200. So the readback samples until the socket is there or the budget is spent; only ABSENT
// is retried, because every other finding is already the answer.
data site_pxe_edge_http_listen_samples: Int = 10

data site_pxe_edge_http_listen_interval: Second = second(count: 1)

fn site_pxe_edge_http_listen_poll_settled(standing: SitePxeEdgeHttpListenStanding, remaining: Int) -> Bool {
  remaining <= 1 || (match standing {
    HttpListenAbsent => false
    HttpListenBoundTo { address: _ } => true
    HttpListenWildcard { local: _ } => true
    HttpListenOtherAddress { local: _ } => true
    HttpListenUnobservable { reason: _ } => true
  })
}

fn observe_site_pxe_edge_http_listen(target: SshTarget, context: FleetSshExecutionContext, bind: Ipv4Address) -> SitePxeEdgeHttpListenStanding {
  match typed_argv_exec_over_fleet_ssh(target: target, context: context, argv: ["ss", "-ltnH"]) {
    TypedArgvExecRefused { reason: why } => HttpListenUnobservable { reason: why }
    TypedArgvExecConverged { result: r } =>
      if r.success { site_pxe_edge_http_listen_standing(output: r.stdout, bind: bind) }
      else { HttpListenUnobservable { reason: join(["ss -ltnH exit=", to_string(r.exit_code), " ", trim(s: r.stderr)], "") } }
  }
}

fn site_pxe_edge_http_listen_poll(target: SshTarget, context: FleetSshExecutionContext, bind: Ipv4Address, remaining: Int) -> SitePxeEdgeHttpListenStanding
  admit_callers: [
    decl_ref(module_path: "gunbc.fleet.site_pxe_edge_converge", decl_name: "run_site_pxe_edge"),
    decl_ref(module_path: "gunbc.fleet.site_pxe_edge_converge", decl_name: "site_pxe_edge_http_listen_poll"),
  ]
{
  let sample = observe_site_pxe_edge_http_listen(target: target, context: context, bind: bind)
  if site_pxe_edge_http_listen_poll_settled(standing: sample, remaining: remaining) {
    sample
  } else {
    let _paced = sleep_delay_seconds_second_carrier_projection(duration: site_pxe_edge_http_listen_interval)
    site_pxe_edge_http_listen_poll(target: target, context: context, bind: bind, remaining: remaining - 1)
  }
}

fn site_pxe_edge_http_listen_standing(output: String, bind: Ipv4Address) -> SitePxeEdgeHttpListenStanding {
  let expected = concat(concat(render_ipv4_address(addr: bind) as String, ":"), to_string(site_pxe_edge_http_port))
  let port_suffix = concat(":", to_string(site_pxe_edge_http_port))
  let locals = filter(flat_map(filter(split(s: output, delimiter: "\n"), l => trim(s: l) != ""), l => match get(xs: filter(split(s: trim(s: l), delimiter: " "), w => w != ""), index: 3) {
    Present { value: w } => [w]
    Absent => []
  }), w => ends_with(s: w, suffix: port_suffix))
  match first_where(xs: locals, keep: w => w != expected) {
    Present { value: w } =>
      if starts_with(s: w, prefix: "0.0.0.0:") || starts_with(s: w, prefix: "*:") || starts_with(s: w, prefix: "[::]:") { HttpListenWildcard { local: w } } else { HttpListenOtherAddress { local: w } }
    Absent =>
      match locals.first() {
        Present { value: w } => HttpListenBoundTo { address: w }
        Absent => HttpListenAbsent
      }
  }
}

fn site_pxe_edge_desired_files(roster: SiteEdgeRoster, network: Ipv4Address, chains: List<SitePxeEdgePinnedChain>) -> List<SitePxeEdgeFile> {
  [site_pxe_edge_config_file(roster: roster, network: network), site_pxe_edge_unit_file()] + site_pxe_edge_rendered_member_files(chains: chains)
}

// ── The gate (pure) ──────────────────────────────────────────────────────────────────────────────

// A PROBE THAT RAN AND FOUND NO IS A FINDING; A PROBE THAT COULD NOT RUN IS A FAILURE TO OBSERVE. The
// two are different arms, so an observe run can report the first and must refuse on the second.
type SitePxeEdgeProbe
  = SitePxeEdgeProbeHeld
  | SitePxeEdgeProbeObservedNegative { reason: String }
  | SitePxeEdgeProbeUnobservable { reason: String }
  | SitePxeEdgeProbeNotAttempted { reason: String }

// THE REVISION THE BINARY ITSELF CARRIES. iPXE prints its git abbreviation into the image ("2.0.0+ (gc51ca)"),
// so the pinned embedded_revision is checkable against the artefact rather than trusted: a digest says WHICH
// bytes, the embedded revision says the receipt's claim about where they came from is not a different build's.
// Unobservable is its own arm because "the image carries no revision" and "grep could not run" are both a
// failure to read, never a mismatch.
// ITS CONSUMER IS THE LOCAL CHECK OF THE COMMITTED ARTIFACT (test.claim.fleet.site_pxe_edge_chainloader_real_execution_witness):
// srv4 is checked by digest alone, which carries the revision because the pinned digest is that artifact's.
type SitePxeEdgeEmbeddedRevision
  = EmbeddedRevisionRead { abbreviated: NonEmptyStr }
  | EmbeddedRevisionUnobservable { reason: String }

type SitePxeEdgeChainloaderObservation
  = ChainloaderDigestObserved { digest: ContentHash }
  | ChainloaderDigestUnobservable { reason: String }

// EVERY REASON TO WITHHOLD THE DAEMON, COUNTED, NOT THE FIRST ONE. A daemon offering a filename the
// TFTP root cannot serve, or a digest nobody pinned, is an edge that answers wrongly; so any cause
// here closes the gate and nothing is written or started.
// EVERY REASON THE GATE STAYS CLOSED, TYPED. A closed set of causes with their payloads (the parse
// errors, both digests, both filenames) kept as values; site_pxe_edge_run_text renders them, and no
// consumer has to recover a cause from prose. Probe refusals stay a String: that is open-ended stderr.
type SitePxeEdgeGateCause
  = TftpServerAddressUnparseable { error: Ipv4ParseError }
  | SegmentNetworkUnparseable { error: Ipv4ParseError }
  | KnownClientMacUnparseable { error: MacParseError }
  | InstallRequestClientUnparseable { error: MacParseError }
  | NoChainServable
  | ServedPathCollision { served_path: NonEmptyStr }
  | DnsmasqBinaryAbsent { reason: String }
  | DnsmasqBinaryUnobservable { reason: String }
  | AdministratorPrivilegeRefused { reason: String }
  | AdministratorPrivilegeUnobservable { reason: String }

// THE EDGE-WIDE GATE: what keeps the daemon from being written or started at all. Which chains it offers
// is the per-chain standing above; the gate closes when none is servable, so the edge never answers with
// an empty boot list.
fn site_pxe_edge_gate_causes(
  tftp_server: Ipv4ParseResult,
  segment: Ipv4ParseResult,
  known: List<MacParseResult>,
  servable: List<SitePxeEdgePinnedChain>,
  collisions: List<NonEmptyStr>,
  dnsmasq_binary: SitePxeEdgeProbe,
  privilege: SitePxeEdgeProbe,
) -> List<SitePxeEdgeGateCause> {
  (match tftp_server {
    Ipv4Parsed { address: _ } => []
    Ipv4ParseFailed { error: e } => [TftpServerAddressUnparseable { error: e }]
  }) + (match segment {
    Ipv4Parsed { address: _ } => []
    Ipv4ParseFailed { error: e } => [SegmentNetworkUnparseable { error: e }]
  }) + flat_map(known, k => match k {
    MacParsed { address: _ } => []
    MacParseFailed { error: e } => [KnownClientMacUnparseable { error: e }]
  }) + (if length(servable) == 0 { [NoChainServable] } else { [] })
    + map(collisions, p => ServedPathCollision { served_path: p })
    + (match dnsmasq_binary {
    SitePxeEdgeProbeHeld => []
    SitePxeEdgeProbeObservedNegative { reason: r } => [DnsmasqBinaryAbsent { reason: r }]
    SitePxeEdgeProbeUnobservable { reason: r } => [DnsmasqBinaryUnobservable { reason: r }]
    SitePxeEdgeProbeNotAttempted { reason: r } => [DnsmasqBinaryUnobservable { reason: concat("not attempted: ", r) }]
  }) + (match privilege {
    SitePxeEdgeProbeHeld => []
    SitePxeEdgeProbeObservedNegative { reason: r } => [AdministratorPrivilegeRefused { reason: r }]
    SitePxeEdgeProbeUnobservable { reason: r } => [AdministratorPrivilegeUnobservable { reason: r }]
    SitePxeEdgeProbeNotAttempted { reason: r } => [AdministratorPrivilegeUnobservable { reason: concat("not attempted: ", r) }]
  })
}

// A NOT-ATTEMPTED INPUT PROBE CLOSES THE GATE AS UNOBSERVABLE, and carries "not attempted: " on the
// reason so the finer fact survives in the payload. SitePxeEdgeProbe is one type across the input
// legs and the activation leg, but only the activation leg is ever minted NotAttempted; the dnsmasq
// and privilege legs are observed before the gate and are always attempted. The arm exists because
// the type is shared and the match must be total, not because the producer can reach it. What it may
// never do is mint an ObservedNegative -- a leg that never ran is not a leg that ran and said no,
// which is the distinction the gate is here to keep.
// The three Secure Boot causes are false here: they are a property of the pinned receipt, not a leg that
// failed to execute, so observe reports them as findings.
// WHICH GATE CAUSES MEAN THE RUN COULD NOT LOOK, as opposed to what it saw when it did. Only the four
// Unobservable arms are true: a leg that never executed. A sudo -n that RAN and answered no privilege,
// like an absent dnsmasq or an unpinned chainloader, is a finding an observe dispatch reports and
// still succeeds on.
fn site_pxe_edge_gate_cause_is_unobserved(cause: SitePxeEdgeGateCause) -> Bool {
  match cause {
    DnsmasqBinaryUnobservable { reason: _ } => true
    AdministratorPrivilegeUnobservable { reason: _ } => true
    AdministratorPrivilegeRefused { reason: _ } => false
    TftpServerAddressUnparseable { error: _ } => false
    SegmentNetworkUnparseable { error: _ } => false
    KnownClientMacUnparseable { error: _ } => false
    InstallRequestClientUnparseable { error: _ } => false
    NoChainServable => false
    ServedPathCollision { served_path: _ } => false
    DnsmasqBinaryAbsent { reason: _ } => false
  }
}

fn site_pxe_edge_gate_cause_text(cause: SitePxeEdgeGateCause) -> String {
  match cause {
    TftpServerAddressUnparseable { error: _ } => "tftp-server-address-unparseable: srv4_host_lan_endpoint.address is not an IPv4 address"
    SegmentNetworkUnparseable { error: _ } => "segment-network-unparseable: operator_lan_segment.cidr has no IPv4 network part"
    KnownClientMacUnparseable { error: _ } => "known-client-mac-unparseable: the measured host NIC observation does not parse as an EUI-48 address"
    InstallRequestClientUnparseable { error: _ } => "install-request-client-unparseable: an install request's client MAC does not parse as an EUI-48 address"
    NoChainServable => "no-chain-servable: every served chain is withheld (see the chain lines)"
    ServedPathCollision { served_path: p } => concat("served-path-collision: two served chains claim ", p as String)
    DnsmasqBinaryAbsent { reason: r } => concat("dnsmasq-binary-absent: ", r)
    DnsmasqBinaryUnobservable { reason: r } => concat("dnsmasq-binary-unobservable: ", r)
    AdministratorPrivilegeRefused { reason: r } => concat("administrator-privilege-refused: ", r)
    AdministratorPrivilegeUnobservable { reason: r } => concat("administrator-privilege-unobservable: ", r)
  }
}

fn site_pxe_edge_digest_observation(path: NonEmptyStr, success: Bool, line: String) -> SitePxeEdgeChainloaderObservation {
  match sha256sum_digest_from_line(path: path, success: success, line: line) {
    Sha256FileDigestUnavailable { path: _, reason: r } => ChainloaderDigestUnobservable { reason: r }
    Sha256FileDigest { digest: d } =>
      match sha256_digest_content_hash(digest: d) {
        Absent => ChainloaderDigestUnobservable { reason: "sha256sum printed a field that is not a sha256 digest" }
        Present { value: h } => ChainloaderDigestObserved { digest: h }
      }
  }
}

// THE ONE PATH THAT READS A REVISION, shared by production and the witness. `output` is stdout of
// `grep -a -o -E "[(]g[0-9a-f]{5}[)]"` over the image. iPXE prints the same "(g<5>)" into the image
// several times (version string, SBOM), so repeated IDENTICAL matches are one reading; no match, a match
// that is not exactly five characters, or two DISTINCT matches are unobservable, never a guess at which
// one is the build's.
fn site_pxe_edge_embedded_revision(success: Bool, output: String) -> SitePxeEdgeEmbeddedRevision {
  if success == false {
    EmbeddedRevisionUnobservable { reason: "grep found no embedded iPXE revision in the image" }
  } else {
    let lines = split(s: trim(s: output), delimiter: "\n")
    match get(xs: lines, index: 0) {
      Absent => EmbeddedRevisionUnobservable { reason: "grep printed no line" }
      Present { value: first } =>
        if !all(lines, l => l == first) {
          EmbeddedRevisionUnobservable { reason: "the image carries more than one distinct embedded revision" }
        } else {
          match get(xs: split(s: first, delimiter: "(g"), index: 1) {
            Absent => EmbeddedRevisionUnobservable { reason: "embedded revision line has no (g<hex>) group" }
            Present { value: rest } =>
              match get(xs: split(s: rest, delimiter: ")"), index: 0) {
                Absent => EmbeddedRevisionUnobservable { reason: "embedded revision group is not closed" }
                Present { value: hex } =>
                  if hex.length() == 5 {
                    EmbeddedRevisionRead { abbreviated: hex as NonEmptyStr }
                  } else {
                    EmbeddedRevisionUnobservable { reason: "embedded revision is not exactly five characters" }
                  }
              }
          }
        }
    }
  }
}

// ── Subject ──────────────────────────────────────────────────────────────────────────────────────

type SitePxeEdgeSubjectAdmission
  = SitePxeEdgeSubjectAdmitted { target: SshTarget }
  | SitePxeEdgeSubjectRefused { cause: String }

fn site_pxe_edge_subject(host: HostIdentity) -> SitePxeEdgeSubjectAdmission {
  if (host as String) != (site_pxe_edge_host as String) {
    SitePxeEdgeSubjectRefused {
      cause: join(["site_pxe_edge_converge: ", host as String, " is not the site edge host (", site_pxe_edge_host as String, "); the edge lives on one executor per segment"], ""),
    }
  } else {
    match fleet_ssh_target_at_standard_port(endpoint: fleet_probe_endpoint_for(host: host as String), principal: executor_bootstrap_principal.login) {
      SshTargetRefused { endpoint: e, refusal: why } =>
        SitePxeEdgeSubjectRefused { cause: join(["site_pxe_edge_converge: ", ssh_target_refusal_text(endpoint: e, refusal: why)], "") }
      SshTargetResolved { target: target } => SitePxeEdgeSubjectAdmitted { target: target }
    }
  }
}

// ── The dnsmasq-base ensure step ─────────────────────────────────────────────────────────────────

// AUTHORITY: operator escalation msg_af2a60f0 (approved by default at its timeout), relayed by merry-fox-82.
// It authorizes installing the package dnsmasq-base ONLY (never the dnsmasq package, whose postinst would
// enable and start a competing resolver on srv4). It does NOT open the Secure Boot gate: this step runs
// whatever the gate says, and the gate then reads the binary it produced, so a closed gate still means
// no config file, no unit and no serving.
data site_pxe_edge_package: NonEmptyStr = package_dnsmasq_base
data site_pxe_edge_package_authority: String = "operator escalation msg_af2a60f0, relayed by merry-fox-82: install dnsmasq-base only; the Secure Boot gate stays separate and closed"

// THE PACKAGE'S STANDING DECIDES THE ACTION, and only a uniquely decoded dpkg answer may authorize the
// install (extdeps.package_managers.dpkg: undecidable is never read as absent).
type SitePxeEdgePackageAction
  = PackageActionNone
  | PackageActionInstall
  | PackageActionRefuse { reason: String }

fn site_pxe_edge_package_action(state: DpkgInstalledState) -> SitePxeEdgePackageAction {
  match state {
    DpkgPackageInstalled => PackageActionNone
    DpkgPackageUnknown => PackageActionInstall
    DpkgPackageNotInstalled { status: _ } => PackageActionInstall
    DpkgQueryUndecidable { reason: r } => PackageActionRefuse { reason: r }
  }
}

// The hash of the binary the package left at the path the gate and the unit execute. Recorded as OBSERVED:
// no digest of the Ubuntu build is pinned in this repository, so nothing is compared, and the receipt says
// which bytes were read rather than claiming they are the expected ones.
type SitePxeEdgePackageBinaryDigest
  = PackageBinaryDigestRead { digest: ContentHash }
  | PackageBinaryDigestUnread { reason: String }

type SitePxeEdgePackageOutcome
  = PackageHeld { binary: SitePxeEdgePackageBinaryDigest }
  | PackageObservedMissing
  | PackageInstalledAndReadBack { binary: SitePxeEdgePackageBinaryDigest }
  | PackageInstallRefused { step: String, reason: String }
  | PackageReadBackFailed { reason: String, rolled_back: SitePxeEdgeProbe }
  | PackageUndecidable { reason: String }
  | PackageNotAttempted { reason: String }

fn site_pxe_edge_package_binary_digest(observation: SitePxeEdgeChainloaderObservation) -> SitePxeEdgePackageBinaryDigest {
  match observation {
    ChainloaderDigestObserved { digest: d } => PackageBinaryDigestRead { digest: d }
    ChainloaderDigestUnobservable { reason: r } => PackageBinaryDigestUnread { reason: r }
  }
}

// THE READBACK AFTER AN INSTALL: dpkg must now say installed AND the binary must have been hashed off
// srv4. Either missing is a failed readback, which the caller answers with the rollback.
fn site_pxe_edge_package_readback_failure(state: DpkgInstalledState, binary: SitePxeEdgePackageBinaryDigest) -> String? {
  match state {
    DpkgPackageInstalled =>
      match binary {
        PackageBinaryDigestRead { digest: _ } => none
        PackageBinaryDigestUnread { reason: r } => Present { value: concat("binary not hashed after install: ", r) }
      }
    DpkgPackageUnknown => Present { value: "dpkg does not know the package after install" }
    DpkgPackageNotInstalled { status: st } => Present { value: concat("dpkg status after install: ", st) }
    DpkgQueryUndecidable { reason: r } => Present { value: concat("dpkg status undecidable after install: ", r) }
  }
}

// THE ROLLBACK, STAGED BEFORE THE WRITE AND RECORDED IN THE RECEIPT, in the order that leaves no running
// daemon without its files: stop and disable the unit, remove the unit, the config and the TFTP root,
// daemon-reload, then remove the package. The unit, config and root are written by the later steps, so a
// rollback of THIS step alone is its last leg (package_leg); the earlier legs are the rollback of a
// completed converge. apt's --no-remove install means nothing else was removed to be restored.
// NEEDRESTART_MODE=l (list only) in both package commands means needrestart never restarts a service
// on its own; a daemon left stale by the library change is reported, not bounced.
type SitePxeEdgeRollbackStep { step: String, argv: List<String> }

fn site_pxe_edge_package_install_argv() -> List<String>? {
  match apt_exact_non_removing_install_command(selection: site_pxe_edge_package) {
    AptGetInstallCommandReady { command: c } => Present { value: argv_words(command: c) }
    AptGetInstallCommandRefused { cause: _ } => none
  }
}

fn site_pxe_edge_package_remove_argv() -> List<String>? {
  match apt_remove_command(package: site_pxe_edge_package) {
    AptGetInstallCommandReady { command: c } => Present { value: argv_words(command: c) }
    AptGetInstallCommandRefused { cause: _ } => none
  }
}

fn site_pxe_edge_package_leg() -> SitePxeEdgeRollbackStep? {
  match site_pxe_edge_package_remove_argv() {
    Absent => none
    Present { value: argv } => Present { value: SitePxeEdgeRollbackStep { step: "apt-get remove dnsmasq-base", argv: elevated_argv(command: argv) } }
  }
}

fn site_pxe_edge_rollback_steps() -> List<SitePxeEdgeRollbackStep> {
  let package_leg = match site_pxe_edge_package_leg() {
    Absent => []
    Present { value: leg } => [leg]
  }
  concat([
    SitePxeEdgeRollbackStep { step: "disable --now unit", argv: elevated_argv(command: systemctl_disable_now_argv(unit: site_pxe_edge_unit_name)) },
    SitePxeEdgeRollbackStep { step: "remove unit and config", argv: elevated_argv(command: ["rm", "-f", "--", site_pxe_edge_unit_path as String, site_pxe_edge_config_path as String]) },
    SitePxeEdgeRollbackStep { step: "remove tftp root", argv: elevated_argv(command: ["rm", "-rf", "--", site_pxe_edge_tftp_root as String]) },
    SitePxeEdgeRollbackStep { step: "daemon-reload", argv: elevated_argv(command: systemctl_daemon_reload_argv()) },
  ], package_leg)
}

fn site_pxe_edge_package_outcome_settled(outcome: SitePxeEdgePackageOutcome) -> Bool {
  match outcome {
    PackageHeld { binary: _ } => true
    PackageInstalledAndReadBack { binary: _ } => true
    PackageObservedMissing => false
    PackageInstallRefused { step: _, reason: _ } => false
    PackageReadBackFailed { reason: _, rolled_back: _ } => false
    PackageUndecidable { reason: _ } => false
    PackageNotAttempted { reason: _ } => false
  }
}

fn site_pxe_edge_package_binary_wire(binary: SitePxeEdgePackageBinaryDigest) -> String {
  match binary {
    PackageBinaryDigestRead { digest: d } => concat("sha256 observed ", serialize_content_hash(hash: d) as String)
    PackageBinaryDigestUnread { reason: r } => concat("UNREAD ", r)
  }
}

fn site_pxe_edge_package_outcome_wire(outcome: SitePxeEdgePackageOutcome) -> String {
  match outcome {
    PackageHeld { binary: b } => concat("held ", site_pxe_edge_package_binary_wire(binary: b))
    PackageObservedMissing => "missing (observe-only, nothing installed)"
    PackageInstalledAndReadBack { binary: b } => concat("installed-and-read-back ", site_pxe_edge_package_binary_wire(binary: b))
    PackageInstallRefused { step: st, reason: why } => join(["REFUSED step=", st, " ", why], "")
    PackageReadBackFailed { reason: r, rolled_back: rb } => join(["READBACK-FAILED ", r, "; rollback ", site_pxe_edge_probe_wire(probe: rb)], "")
    PackageUndecidable { reason: r } => concat("UNDECIDABLE ", r)
    PackageNotAttempted { reason: r } => concat("not-attempted ", r)
  }
}

// ── Observation (effectful) ──────────────────────────────────────────────────────────────────────

fn site_pxe_edge_argv_probe(target: SshTarget, context: FleetSshExecutionContext, argv: List<String>, what: String) -> SitePxeEdgeProbe
{
  match typed_argv_exec_over_fleet_ssh(target: target, context: context, argv: argv) {
    TypedArgvExecRefused { reason: why } => SitePxeEdgeProbeUnobservable { reason: why }
    TypedArgvExecConverged { result: r } =>
      if r.success {
        SitePxeEdgeProbeHeld
      } else {
        SitePxeEdgeProbeObservedNegative { reason: join([what, " exit=", to_string(r.exit_code), " ", trim(s: r.stderr)], "") }
      }
  }
}


fn observe_site_pxe_edge_member(target: SshTarget, context: FleetSshExecutionContext, member: SitePxeEdgePinnedMember) -> SitePxeEdgeMemberObservation
{
  let path = site_pxe_edge_member_path(member: member)
  SitePxeEdgeMemberObservation {
    served_path: member.member.served_path,
    digest: match typed_argv_exec_over_fleet_ssh(target: target, context: context, argv: ["sha256sum", path as String]) {
      TypedArgvExecRefused { reason: why } => ChainloaderDigestUnobservable { reason: why }
      TypedArgvExecConverged { result: r } => site_pxe_edge_digest_observation(path: path, success: r.success, line: r.stdout)
    },
  }
}

// EVERY PLACED BLOB MEMBER OF EVERY PINNED CHAIN IS DIGESTED; a rendered member is a desired file and is
// compared by the file write instead.
fn site_pxe_edge_blob_members(pins: List<SitePxeEdgeChainPin>) -> List<SitePxeEdgePinnedMember> {
  flat_map(pins, p => match p {
    SitePxeEdgeChainUnpinned { architecture: _, audience: _, obligation: _ } => []
    SitePxeEdgeChainPinned { chain: c } => filter(site_pxe_edge_pinned_members(chain: c), m => site_pxe_edge_member_is_rendered(m: m) == false)
  })
}


type SitePxeEdgeFileStanding
  = EdgeFileIdentical
  | EdgeFileDiffers
  | EdgeFileAbsent
  | EdgeFileUnobservable { reason: String }

fn site_pxe_edge_file_admission(file: SitePxeEdgeFile) -> TypedRemoteFileWriteAdmission {
  typed_remote_file_write_seal(path: file.path, content: file.content, allowed_scope: file.scope)
}

// The comparison is typed_remote_file_write's own far-side `cmp -s -`, so the plan's "identical" and
// the write's read-back are one judgment.
fn observe_site_pxe_edge_file(target: SshTarget, context: FleetSshExecutionContext, file: SitePxeEdgeFile) -> SitePxeEdgeFileStanding
{
  match typed_argv_exec_over_fleet_ssh(target: target, context: context, argv: ["test", "-e", file.path as String]) {
    TypedArgvExecRefused { reason: why } => EdgeFileUnobservable { reason: why }
    TypedArgvExecConverged { result: presence } =>
      if presence.exit_code == 1 {
        EdgeFileAbsent
      } else if presence.exit_code != 0 {
        EdgeFileUnobservable { reason: join(["presence test exit=", to_string(presence.exit_code), " ", trim(s: presence.stderr)], "") }
      } else {
        match site_pxe_edge_file_admission(file: file) {
          TypedRemoteFileWriteAdmissionRefused { cause: c } => EdgeFileUnobservable { reason: c as String }
          TypedRemoteFileWriteAdmitted { write: w } =>
            match typed_remote_file_step(target: target, context: context, raws: typed_remote_file_compare_argv(write: w), stdin_payload: w.content) {
              TypedRemoteFileStepArgvRefused => EdgeFileUnobservable { reason: "comparison argv refused as non-portable" }
              TypedRemoteFileStepLegRefused { cause: why } => EdgeFileUnobservable { reason: why as String }
              TypedRemoteFileStepRan { result: back } =>
                match classify_typed_remote_file_comparison(write: w, compare_exit_code: back.exit_code, compare_stderr: back.stderr) {
                  ComparisonIdentical => EdgeFileIdentical
                  ComparisonDiffers { reason: _ } => EdgeFileDiffers
                  ComparisonUnavailable { reason: r } => EdgeFileUnobservable { reason: r }
                }
            }
        }
      }
  }
}

fn observe_site_pxe_edge_unit_active(target: SshTarget, context: FleetSshExecutionContext) -> SitePxeEdgeProbe
{
  match typed_argv_exec_over_fleet_ssh(target: target, context: context, argv: systemctl_show_property_argv(unit: site_pxe_edge_unit_name, property: ActiveState)) {
    TypedArgvExecRefused { reason: why } => SitePxeEdgeProbeUnobservable { reason: why }
    TypedArgvExecConverged { result: r } =>
      if (r.success == false) {
        SitePxeEdgeProbeUnobservable { reason: join(["systemctl show exit=", to_string(r.exit_code), " ", trim(s: r.stderr)], "") }
      } else {
        site_pxe_edge_unit_active_standing(capture: systemctl_show_property_value_from_stdout(success: r.success, stdout: r.stdout))
      }
  }
}

// The argv asks for `--value`, so the answer is the bare state word; the shared decoder reads that line.
fn site_pxe_edge_unit_active_standing(capture: SystemdPropertyCapture) -> SitePxeEdgeProbe {
  match capture {
    SystemdPropertyCaptured { value: v } =>
      if v == "active" { SitePxeEdgeProbeHeld } else { SitePxeEdgeProbeObservedNegative { reason: join(["unit ", site_pxe_edge_unit_name as String, " ActiveState=", v], "") } }
    SystemdPropertyBlank => SitePxeEdgeProbeUnobservable { reason: join(["unit ", site_pxe_edge_unit_name as String, " ActiveState blank"], "") }
    SystemdPropertyCaptureRefused { reason: why } => SitePxeEdgeProbeUnobservable { reason: why }
  }
}

fn observe_site_pxe_edge_package(target: SshTarget, context: FleetSshExecutionContext) -> DpkgInstalledState
{
  match typed_argv_exec_over_fleet_ssh(target: target, context: context, argv: dpkg_query_status_argv(package: site_pxe_edge_package)) {
    TypedArgvExecRefused { reason: why } => DpkgQueryUndecidable { reason: why }
    TypedArgvExecConverged { result: r } => dpkg_query_status_verdict_of(exit_code: r.exit_code, stdout: r.stdout, stderr: r.stderr)
  }
}

fn observe_site_pxe_edge_package_binary(target: SshTarget, context: FleetSshExecutionContext) -> SitePxeEdgePackageBinaryDigest
{
  match typed_argv_exec_over_fleet_ssh(target: target, context: context, argv: ["sha256sum", site_pxe_edge_dnsmasq_binary as String]) {
    TypedArgvExecRefused { reason: why } => PackageBinaryDigestUnread { reason: why }
    TypedArgvExecConverged { result: r } =>
      site_pxe_edge_package_binary_digest(observation: site_pxe_edge_digest_observation(path: site_pxe_edge_dnsmasq_binary, success: r.success, line: r.stdout))
  }
}

// THE ENSURE STEP: observe dpkg, install only on an Absent/NotInstalled verdict in apply mode, then read the
// package state and the binary hash back off srv4. A failed readback runs the package leg of the staged
// rollback and says whether it held. Privilege is the caller's probe: refused or unobservable privilege
// attempts nothing.
fn ensure_site_pxe_edge_package(target: SshTarget, context: FleetSshExecutionContext, mode: SitePxeEdgeMode, privilege: SitePxeEdgeProbe) -> SitePxeEdgePackageOutcome
{
  let before = observe_site_pxe_edge_package(target: target, context: context)
  match site_pxe_edge_package_action(state: before) {
    PackageActionRefuse { reason: r } => PackageUndecidable { reason: r }
    PackageActionNone => PackageHeld { binary: observe_site_pxe_edge_package_binary(target: target, context: context) }
    PackageActionInstall =>
      match mode {
        SitePxeEdgeObserveOnly => PackageObservedMissing
        SitePxeEdgeApply =>
          if site_pxe_edge_probe_held(probe: privilege) == false {
            PackageNotAttempted { reason: "administrator privilege not held" }
          } else {
            match site_pxe_edge_package_install_argv() {
              Absent => PackageInstallRefused { step: "install argv", reason: "the apt InstallExactNonRemoving row did not materialize" }
              Present { value: argv } =>
                match site_pxe_edge_argv_probe(target: target, context: context, argv: elevated_argv(command: argv), what: "apt-get install dnsmasq-base") {
                  SitePxeEdgeProbeHeld => {
                    let after = observe_site_pxe_edge_package(target: target, context: context)
                    let binary = observe_site_pxe_edge_package_binary(target: target, context: context)
                    match site_pxe_edge_package_readback_failure(state: after, binary: binary) {
                      Absent => PackageInstalledAndReadBack { binary: binary }
                      Present { value: why } => PackageReadBackFailed { reason: why, rolled_back: rollback_site_pxe_edge_package(target: target, context: context) }
                    }
                  }
                  SitePxeEdgeProbeObservedNegative { reason: r } => PackageInstallRefused { step: "install", reason: r }
                  SitePxeEdgeProbeUnobservable { reason: r } => PackageInstallRefused { step: "install", reason: r }
                  SitePxeEdgeProbeNotAttempted { reason: r } => PackageInstallRefused { step: "install", reason: r }
                }
            }
          }
      }
  }
}

fn rollback_site_pxe_edge_package(target: SshTarget, context: FleetSshExecutionContext) -> SitePxeEdgeProbe
{
  match site_pxe_edge_package_leg() {
    Absent => SitePxeEdgeProbeNotAttempted { reason: "the apt Remove row did not materialize" }
    Present { value: leg } => site_pxe_edge_argv_probe(target: target, context: context, argv: leg.argv, what: leg.step)
  }
}

// ── Plan and apply ───────────────────────────────────────────────────────────────────────────────

type SitePxeEdgeMode
  = SitePxeEdgeObserveOnly
  | SitePxeEdgeApply

type SitePxeEdgeFileOutcome
  = EdgeFileLeftInPlace
  | EdgeFileWrittenAndReadBack
  | EdgeFileWriteRefused { step: String, reason: String }
  | EdgeFileNotApplied { reason: String }

type SitePxeEdgeFileResult {
  file: SitePxeEdgeFile
  before: SitePxeEdgeFileStanding
  outcome: SitePxeEdgeFileOutcome
}

// EVERY SERVED BLOB IS READ AGAIN AFTER ACTIVATION. The gate's digests were taken before files were
// written and the daemon restarted, so the bytes the daemon now serves are digested once more and must
// still be their pins before an apply may call itself converged; the first that differs is named.
type SitePxeEdgePostActivation
  = PostActivationNotRead { reason: String }
  | PostActivationDigestHeld
  | PostActivationDigestDiffers { served_path: NonEmptyStr, observed: ContentHash, pinned: ContentHash }
  | PostActivationUnobservable { reason: String }

fn site_pxe_edge_post_activation(chains: List<SitePxeEdgePinnedChain>, observations: List<SitePxeEdgeMemberObservation>) -> SitePxeEdgePostActivation {
  let causes = flat_map(chains, c => flat_map(filter(site_pxe_edge_pinned_members(chain: c), m => site_pxe_edge_member_is_rendered(m: m) == false), m => site_pxe_edge_digest_causes(member: m, observations: observations)))
  match causes.first() {
    Absent => if length(chains) == 0 { PostActivationNotRead { reason: "no servable chain" } } else { PostActivationDigestHeld }
    Present { value: MemberDigestMismatch { served_path: p, observed: o, pinned: q } } => PostActivationDigestDiffers { served_path: p, observed: o, pinned: q }
    Present { value: MemberUnobservable { served_path: p, reason: r } } => PostActivationUnobservable { reason: join([p as String, ": ", r], "") }
    Present { value: other } => PostActivationUnobservable { reason: site_pxe_edge_chain_cause_text(cause: other) }
  }
}

// ONE HOST'S INSTALL BINDING, AS THIS RUN JUDGED IT.
// ONE BINDING'S DECISION IN A RUN: the install chain its architecture resolved to, and its standing.
type SitePxeEdgeInstallDecision {
  binding: SitePxeEdgeInstallBinding
  install: SitePxeEdgeInstallChain?
  standing: SitePxeEdgeInstallStanding
}

fn site_pxe_edge_install_serves(decisions: List<SitePxeEdgeInstallDecision>) -> List<SitePxeEdgeInstallServe> {
  flat_map(decisions, d => match d.standing {
    InstallWithheld { mac: _, refusals: _ } => []
    InstallAdmitted { mac: _ } => match d.install {
      Absent => []
      Present { value: ic } => [SitePxeEdgeInstallServe { binding: d.binding, install: ic }]
    }
  })
}

type SitePxeEdgeInstallStanding
  = InstallAdmitted { mac: Eui48Address }
  | InstallWithheld { mac: Eui48Address, refusals: FreeSemigroup<SitePxeEdgeInstallRefusal> }

fn site_pxe_edge_install_standing(binding: SitePxeEdgeInstallBinding, roster: SiteEdgeRoster, install: SitePxeEdgeInstallChain?, image: SitePxeEdgeImageStanding, name_resolution: BootNetworkProbe) -> SitePxeEdgeInstallStanding {
  let refusals = site_pxe_edge_install_refusals(binding: binding, roster: roster, install: install, image: image, name_resolution: name_resolution)
  match refusals.first() {
    Absent => InstallAdmitted { mac: site_pxe_edge_binding_mac(binding: binding) }
    Present { value: first } => InstallWithheld { mac: site_pxe_edge_binding_mac(binding: binding), refusals: FreeSemigroup { head: first, tail: skip(xs: refusals, n: 1) } }
  }
}

// THE HTTP LEG AFTER ACTIVATION: not read when no binding was admitted (there is no HTTP unit then).
type SitePxeEdgeHttpLeg
  = HttpLegNotNeeded
  | HttpLegActivation { activation: SitePxeEdgeProbe, listen: SitePxeEdgeHttpListenStanding }
  | HttpLegNotRead { reason: String }

type SitePxeEdgeRun {
  mode: SitePxeEdgeMode
  package: SitePxeEdgePackageOutcome
  chains: List<SitePxeEdgeChainStanding>
  gate_causes: List<SitePxeEdgeGateCause>
  installs: List<SitePxeEdgeInstallStanding>
  placement: SitePxeEdgePlacementOutcome
  files: List<SitePxeEdgeFileResult>
  activation: SitePxeEdgeProbe
  unit_active: SitePxeEdgeProbe
  post_activation: SitePxeEdgePostActivation
  http: SitePxeEdgeHttpLeg
}

fn site_pxe_edge_file_outcome_settled(outcome: SitePxeEdgeFileOutcome) -> Bool {
  match outcome {
    EdgeFileLeftInPlace => true
    EdgeFileWrittenAndReadBack => true
    EdgeFileWriteRefused { step: _, reason: _ } => false
    EdgeFileNotApplied { reason: _ } => false
  }
}

fn apply_site_pxe_edge_file(target: SshTarget, context: FleetSshExecutionContext, file: SitePxeEdgeFile, before: SitePxeEdgeFileStanding) -> SitePxeEdgeFileOutcome
{
  match before {
    EdgeFileIdentical => EdgeFileLeftInPlace
    EdgeFileUnobservable { reason: r } => EdgeFileNotApplied { reason: concat("unobservable before write: ", r) }
    EdgeFileDiffers => write_site_pxe_edge_file(target: target, context: context, file: file)
    EdgeFileAbsent => write_site_pxe_edge_file(target: target, context: context, file: file)
  }
}

fn site_pxe_edge_file_parent_argv(file: SitePxeEdgeFile) -> List<String> {
  ["mkdir", "-p", "--", path_parent_directory(path: file.path as String)]
}

fn write_site_pxe_edge_file(target: SshTarget, context: FleetSshExecutionContext, file: SitePxeEdgeFile) -> SitePxeEdgeFileOutcome
{
  match site_pxe_edge_posix_leg(target: target, context: context, argv: site_pxe_edge_file_parent_argv(file: file), step: "mkdir parent") {
    Present { value: why } => EdgeFileWriteRefused { step: "parent directory", reason: why }
    Absent =>
      match converge_typed_remote_file(
        target: target,
        context: context,
        admission: site_pxe_edge_file_admission(file: file),
        mode: RemoteFileModeOwnerReadWriteWorldRead,
        privilege: RemoteFileViaNonInteractiveSudo,
        validation: NoValidation,
      ) {
        TypedRemoteFileConvergenceRefused { step: st, reason: why } => EdgeFileWriteRefused { step: st, reason: why }
        TypedRemoteFileConverged { converged: _ } => EdgeFileWrittenAndReadBack
      }
  }
}

// daemon-reload, enable, restart -- restart and not start, so a rewritten config is actually the one
// running. Refused at the first failing step, by name.
fn activate_site_pxe_edge_unit(target: SshTarget, context: FleetSshExecutionContext) -> SitePxeEdgeProbe
{
  activate_site_pxe_edge_named_unit(target: target, context: context, unit: site_pxe_edge_unit_name)
}

fn activate_site_pxe_edge_named_unit(target: SshTarget, context: FleetSshExecutionContext, unit: NonEmptyStr) -> SitePxeEdgeProbe
{
  match site_pxe_edge_argv_probe(target: target, context: context, argv: elevated_argv(command: systemctl_daemon_reload_argv()), what: "daemon-reload") {
    SitePxeEdgeProbeObservedNegative { reason: r } => SitePxeEdgeProbeObservedNegative { reason: r }
    SitePxeEdgeProbeUnobservable { reason: r } => SitePxeEdgeProbeUnobservable { reason: r }
    SitePxeEdgeProbeNotAttempted { reason: r } => SitePxeEdgeProbeNotAttempted { reason: r }
    SitePxeEdgeProbeHeld =>
      match site_pxe_edge_argv_probe(target: target, context: context, argv: elevated_argv(command: systemctl_enable_argv(unit: unit)), what: "enable") {
        SitePxeEdgeProbeObservedNegative { reason: r } => SitePxeEdgeProbeObservedNegative { reason: r }
        SitePxeEdgeProbeUnobservable { reason: r } => SitePxeEdgeProbeUnobservable { reason: r }
        SitePxeEdgeProbeNotAttempted { reason: r } => SitePxeEdgeProbeNotAttempted { reason: r }
        SitePxeEdgeProbeHeld =>
          site_pxe_edge_argv_probe(target: target, context: context, argv: elevated_argv(command: systemctl_restart_argv(unit: unit)), what: "restart")
      }
  }
}

// ── Placement (effectful, apply mode only) ──────────────────────────────────────────────────────
// PLACEMENT PUTS A PINNED UBUNTU CHAIN'S BLOB MEMBERS AND THE INSTALLER IMAGE ON srv4 FROM THE VERIFIED ISO, and
// verifies twice: the ISO against Canonical's SHA256SUMS digest (the media row) before anything is taken from it, each
// pool .deb against its Packages digest before it is unpacked, and each placed member against its pin after it is
// written -- a member that disagrees is removed again, so a mismatch is never left servable. The readback of the next
// observation is the third check. The .deb names carry '+', which the bare word alphabet refuses, so the legs go
// through gunbc.typed_argv_exec typed_argv_exec_over_fleet_ssh_posix which reads the principal's login shell in
// the same call as each leg and quotes only under the proof that read mints for this target.
data site_pxe_edge_staging_root: NonEmptyStr = "/var/lib/gunbc-site-pxe-edge/staging"

data site_pxe_edge_iso_mount: NonEmptyStr = "/mnt/gunbc-site-pxe-edge-iso"

// THE IMAGE IS STAGED BESIDE THE HTTP ROOT, NOT IN IT, so the bytes being fetched and checked are never servable,
// and under the same parent so the publishing hard link can reach the served directory. Same parent is not same
// filesystem; the link is what proves it: link(2) across filesystems fails with EXDEV, and the leg refuses rather
// than copying (gunbc.machine_intake.boot_image_fetch states the same argument for its export).
data site_pxe_edge_image_staging_root: NonEmptyStr = "/srv/gunbc-site-pxe-edge/staging"

type SitePxeEdgePlacementOutcome
  = PlacementNotNeeded
  | PlacementNotAttempted { reason: String }
  | PlacementRefused { step: String, reason: String }
  | PlacementVerified { placed: List<NonEmptyStr> }

fn site_pxe_edge_posix_leg(target: SshTarget, context: FleetSshExecutionContext, argv: List<String>, step: String) -> String? {
  match typed_argv_exec_over_fleet_ssh_posix(target: target, context: context, argv: elevated_argv(command: argv)) {
    TypedArgvExecRefused { reason: why } => Present { value: why }
    TypedArgvExecConverged { result: r } => if r.success { Absent } else { Present { value: join([step, " exit=", to_string(r.exit_code), " ", trim(s: r.stderr)], "") } }
  }
}

fn site_pxe_edge_posix_digest(target: SshTarget, context: FleetSshExecutionContext, path: NonEmptyStr) -> SitePxeEdgeChainloaderObservation {
  match typed_argv_exec_over_fleet_ssh_posix(target: target, context: context, argv: elevated_argv(command: ["sha256sum", path as String])) {
    TypedArgvExecRefused { reason: why } => ChainloaderDigestUnobservable { reason: why }
    TypedArgvExecConverged { result: r } => site_pxe_edge_digest_observation(path: path, success: r.success, line: r.stdout)
  }
}

fn site_pxe_edge_digest_agrees(observation: SitePxeEdgeChainloaderObservation, pinned: ContentHash) -> Bool {
  match observation {
    ChainloaderDigestObserved { digest: d } => content_hash_equal(left: d, right: pinned)
    ChainloaderDigestUnobservable { reason: _ } => false
  }
}

// ONE MEMBER: where its bytes are inside the mounted ISO (unpacking a pool .deb first), then install, then verify.
fn site_pxe_edge_place_member(target: SshTarget, context: FleetSshExecutionContext, member: SitePxeEdgePinnedMember) -> SitePxeEdgePlacementOutcome {
  let dest = site_pxe_edge_member_path(member: member)
  let source = match member.source {
    VerifiedMediaSource { media: _, source: IsoMember { iso_path: p }, pin: _, digest: _ } => Present { value: join([site_pxe_edge_iso_mount as String, "/", p as String], "") }
    VerifiedMediaSource { media: _, source: PoolPackageMember { package: pkg, version: _, pool_path: pool, deb_sha256: deb_hex, member_path: inner }, pin: _, digest: _ } => {
      let deb = join([site_pxe_edge_iso_mount as String, "/", pool as String], "") as NonEmptyStr
      let unpacked = join([site_pxe_edge_staging_root as String, "/deb-", pkg as String], "")
      match sha256_hex_digest(hex: deb_hex as String) {
        Absent => Absent
        Present { value: deb_digest } =>
          if site_pxe_edge_digest_agrees(observation: site_pxe_edge_posix_digest(target: target, context: context, path: deb), pinned: Sha256Hash(deb_digest)) {
            match site_pxe_edge_posix_leg(target: target, context: context, argv: ["dpkg-deb", "-x", deb as String, unpacked], step: "dpkg-deb -x") {
              Present { value: _ } => Absent
              Absent => Present { value: join([unpacked, "/", inner as String], "") }
            }
          } else {
            Absent
          }
      }
    }
    VerifiedMediaSource { media: _, source: RenderedByConsumer, pin: _, digest: _ } => Absent
    IpxeBuildSource { build: _ } => Absent
    RenderedSource { content: _, digest: _ } => Absent
  }
  match source {
    Absent => PlacementRefused { step: concat("source ", member.member.served_path as String), reason: "the member's bytes could not be located in the verified ISO (a .deb digest disagreed, an unpack failed, or the member is not media-sourced)" }
    Present { value: src } =>
      match site_pxe_edge_posix_leg(target: target, context: context, argv: ["install", "-m", "0644", "-D", src, dest as String], step: "install") {
        Present { value: why } => PlacementRefused { step: concat("install ", member.member.served_path as String), reason: why }
        Absent =>
          if site_pxe_edge_digest_agrees(observation: site_pxe_edge_posix_digest(target: target, context: context, path: dest), pinned: site_pxe_edge_member_digest(m: member)) {
            PlacementVerified { placed: [member.member.served_path] }
          } else {
            let removed = site_pxe_edge_posix_leg(target: target, context: context, argv: ["rm", "-f", dest as String], step: "rm")
            PlacementRefused { step: concat("verify ", member.member.served_path as String), reason: match removed { Absent => "the placed bytes differ from the pin; removed" Present { value: why } => concat("the placed bytes differ from the pin, and removing them failed: ", why) } }
          }
      }
  }
}

// PUBLISHING A VERIFIED STAGED IMAGE, atomically (merry-fox-82's side-chat review). The staged file is hard-linked
// into the served directory under the staging sibling name (gunbc.machine_intake.boot_image_fetch
// boot_image_staging_path: not .iso, and holding only the verified inode), then renamed over the served name: rename(2)
// within one directory replaces it in one step, so a reader sees the prior image or the verified one and never a
// partial file. Until that rename the prior image is untouched. A leftover link from an interrupted run is removed
// first, since link(2) will not replace a name.
fn site_pxe_edge_publish_staged_image(target: SshTarget, context: FleetSshExecutionContext, staged: NonEmptyStr, served: NonEmptyStr) -> String? {
  let link = boot_image_staging_path(published_path: served)
  match site_pxe_edge_posix_leg(target: target, context: context, argv: ["rm", "-f", link as String], step: "rm stale link") {
    Present { value: why } => Present { value: why }
    Absent => match site_pxe_edge_posix_leg(target: target, context: context, argv: ["ln", staged as String, link as String], step: "ln (staging must share the served root's filesystem)") {
      Present { value: why } => Present { value: why }
      Absent => site_pxe_edge_posix_leg(target: target, context: context, argv: ["mv", "-fT", link as String, served as String], step: "mv -T")
    }
  }
}

// THE IMAGE: fetched from Canonical's publishing mirror into staging only when the served copy does not already hold
// the media row's digest, verified THERE, outside the served root, and published only after it agrees; a fetch that
// disagrees is removed from staging and the prior served image stays as it was.
fn site_pxe_edge_place_image(target: SshTarget, context: FleetSshExecutionContext, image: SitePxeEdgeInstallerImage) -> SitePxeEdgePlacementOutcome {
  let served = site_pxe_edge_installer_image_path(image: image)
  if site_pxe_edge_digest_agrees(observation: site_pxe_edge_posix_digest(target: target, context: context, path: served), pinned: image.digest) {
    PlacementVerified { placed: [image.served_path] }
  } else {
    let staged = join([site_pxe_edge_image_staging_root as String, "/", ubuntu_install_media_filename(artifact: image.media) as String], "") as NonEmptyStr
    let url = ubuntu_install_media_mirror_url(artifact: image.media, mirror: ubuntu_install_media_publishing_mirror(arch: image.media.architecture))
    match site_pxe_edge_posix_leg(target: target, context: context, argv: ["curl", "-fL", "--retry", "3", "-o", staged as String, url as String], step: "curl") {
      Present { value: why } => PlacementRefused { step: "fetch installer image", reason: why }
      Absent =>
        if site_pxe_edge_digest_agrees(observation: site_pxe_edge_posix_digest(target: target, context: context, path: staged), pinned: image.digest) == false {
          let removed = site_pxe_edge_posix_leg(target: target, context: context, argv: ["rm", "-f", staged as String], step: "rm")
          PlacementRefused { step: "verify installer image", reason: match removed { Absent => "the fetched image's sha256 is not the SHA256SUMS line; removed" Present { value: why } => concat("the fetched image's sha256 is not the SHA256SUMS line, and removing it failed: ", why) } }
        } else {
          match site_pxe_edge_publish_staged_image(target: target, context: context, staged: staged, served: served) {
            Present { value: why } => PlacementRefused { step: "publish installer image", reason: why }
            Absent => {
              let unstaged = site_pxe_edge_posix_leg(target: target, context: context, argv: ["rm", "-f", staged as String], step: "rm staged")
              if site_pxe_edge_digest_agrees(observation: site_pxe_edge_posix_digest(target: target, context: context, path: served), pinned: image.digest) {
                match unstaged {
                  Absent => PlacementVerified { placed: [image.served_path] }
                  Present { value: why } => PlacementRefused { step: "unstage installer image", reason: concat("the image is published and verified, but its staging name remains: ", why) }
                }
              } else {
                let removed = site_pxe_edge_posix_leg(target: target, context: context, argv: ["rm", "-f", served as String], step: "rm")
                PlacementRefused { step: "verify served installer image", reason: match removed { Absent => "the served image read back differs from the SHA256SUMS line after publishing; removed" Present { value: why } => concat("the served image read back differs from the SHA256SUMS line after publishing, and removing it failed: ", why) } }
              }
            }
          }
        }
    }
  }
}

fn site_pxe_edge_placement_join(left: SitePxeEdgePlacementOutcome, right: SitePxeEdgePlacementOutcome) -> SitePxeEdgePlacementOutcome {
  match left {
    PlacementVerified { placed: a } =>
      match right {
        PlacementVerified { placed: b } => PlacementVerified { placed: a + b }
        PlacementNotNeeded => left
        PlacementNotAttempted { reason: r } => PlacementNotAttempted { reason: r }
        PlacementRefused { step: st, reason: r } => PlacementRefused { step: st, reason: r }
      }
    PlacementNotNeeded => right
    PlacementNotAttempted { reason: r } => PlacementNotAttempted { reason: r }
    PlacementRefused { step: st, reason: r } => PlacementRefused { step: st, reason: r }
  }
}

// THE WHOLE PLACEMENT, in order, stopping at the first refusal: directories, image, mount, members,
// unmount (attempted whatever the members' fate once the mount held).
fn place_site_pxe_edge_ubuntu_chain(target: SshTarget, context: FleetSshExecutionContext, chain: SitePxeEdgePinnedChain, image: SitePxeEdgeInstallerImage) -> SitePxeEdgePlacementOutcome {
      match site_pxe_edge_posix_leg(target: target, context: context, argv: ["mkdir", "-p", site_pxe_edge_staging_root as String, site_pxe_edge_image_staging_root as String, site_pxe_edge_iso_mount as String, concat(site_pxe_edge_tftp_root as String, "/grub"), concat(site_pxe_edge_http_root as String, "/iso")], step: "mkdir") {
        Present { value: why } => PlacementRefused { step: "directories", reason: why }
        Absent =>
          match site_pxe_edge_place_image(target: target, context: context, image: image) {
            PlacementVerified { placed: img } =>
              match site_pxe_edge_posix_leg(target: target, context: context, argv: ["mount", "-o", "loop,ro", site_pxe_edge_installer_image_path(image: image) as String, site_pxe_edge_iso_mount as String], step: "mount") {
                Present { value: why } => PlacementRefused { step: "mount installer image", reason: why }
                Absent => {
                  let members = fold(filter(site_pxe_edge_pinned_members(chain: chain), m => site_pxe_edge_member_is_rendered(m: m) == false), init: PlacementVerified { placed: img }, f: (acc, m) => match acc {
                    PlacementVerified { placed: _ } => site_pxe_edge_placement_join(left: acc, right: site_pxe_edge_place_member(target: target, context: context, member: m))
                    PlacementNotNeeded => acc
                    PlacementNotAttempted { reason: _ } => acc
                    PlacementRefused { step: _, reason: _ } => acc
                  })
                  let unmounted = site_pxe_edge_posix_leg(target: target, context: context, argv: ["umount", site_pxe_edge_iso_mount as String], step: "umount")
                  match unmounted {
                    Absent => members
                    Present { value: why } => match members {
                      PlacementRefused { step: st, reason: r } => PlacementRefused { step: st, reason: concat(r, concat("; and umount failed: ", why)) }
                      PlacementVerified { placed: _ } => PlacementRefused { step: "umount", reason: why }
                      PlacementNotNeeded => PlacementRefused { step: "umount", reason: why }
                      PlacementNotAttempted { reason: _ } => PlacementRefused { step: "umount", reason: why }
                    }
                  }
                }
              }
            PlacementRefused { step: st, reason: r } => PlacementRefused { step: st, reason: r }
            PlacementNotAttempted { reason: r } => PlacementNotAttempted { reason: r }
            PlacementNotNeeded => PlacementNotNeeded
          }
      }
}

// THE ONE ISO A CHAIN'S MEDIA MEMBERS ARE TAKEN FROM, read off the members' own sources (review 86920): the chain's
// pins already say which media each member was extracted from, so placement and the install surface take the image
// from there and never name a point release of their own. A chain with no media member, or with members from two
// media, has no single image and refuses.
type SitePxeEdgeChainMediaRefusal
  = ChainMediaNone
  | ChainMediaMixed { first: UbuntuInstallMediaArtifactRow, other: UbuntuInstallMediaArtifactRow }

type SitePxeEdgeChainMedia
  = ChainMediaOne { media: UbuntuInstallMediaArtifactRow }
  | ChainMediaRefused { cause: SitePxeEdgeChainMediaRefusal }

fn site_pxe_edge_chain_media(chain: SitePxeEdgePinnedChain) -> SitePxeEdgeChainMedia {
  let medias = flat_map(site_pxe_edge_pinned_members(chain: chain), m => match m.source {
    VerifiedMediaSource { media: md, source: _, pin: _, digest: _ } => [md]
    IpxeBuildSource { build: _ } => []
    RenderedSource { content: _, digest: _ } => []
  })
  match medias.first() {
    Absent => ChainMediaRefused { cause: ChainMediaNone }
    Present { value: first } => match first_where(xs: medias, keep: md => md != first) {
      Absent => ChainMediaOne { media: first }
      Present { value: other } => ChainMediaRefused { cause: ChainMediaMixed { first: first, other: other } }
    }
  }
}

fn site_pxe_edge_chain_media_refusal_text(cause: SitePxeEdgeChainMediaRefusal) -> String {
  match cause {
    ChainMediaNone => "the chain has no member taken from install media"
    ChainMediaMixed { first: a, other: b } => join(["the chain's members come from two install media: ", ubuntu_install_media_filename(artifact: a) as String, " and ", ubuntu_install_media_filename(artifact: b) as String], "")
  }
}

// The pinned chains that carry install media: each is placed from its own ISO.
fn site_pxe_edge_media_chains(pins: List<SitePxeEdgeChainPin>) -> List<SitePxeEdgePinnedChain> {
  flat_map(pins, p => match p {
    SitePxeEdgeChainPinned { chain: c } => match site_pxe_edge_chain_media(chain: c) { ChainMediaOne { media: _ } => [c] ChainMediaRefused { cause: _ } => [] }
    SitePxeEdgeChainUnpinned { architecture: _, audience: _, obligation: _ } => []
  })
}

// ONE CHAIN'S PLACEMENT from its own media's image.
fn site_pxe_edge_place_media_chain(target: SshTarget, context: FleetSshExecutionContext, chain: SitePxeEdgePinnedChain) -> SitePxeEdgePlacementOutcome {
  match site_pxe_edge_chain_media(chain: chain) {
    ChainMediaRefused { cause: why } => PlacementRefused { step: "installer image", reason: site_pxe_edge_chain_media_refusal_text(cause: why) }
    ChainMediaOne { media: md } => match site_pxe_edge_installer_image(media: md) {
      Absent => PlacementRefused { step: "installer image", reason: "the media row's digest is not a sha256 digest" }
      Present { value: image } => place_site_pxe_edge_ubuntu_chain(target: target, context: context, chain: chain, image: image)
    }
  }
}

// WHICH CHAINS PLACEMENT RUNS FOR: apply mode with privilege held, every pinned media chain whose ONLY causes are its
// own members (unplaced or differing), in roster order, stopping at the first refusal. A chain withheld for any
// other cause is not placed into, and the ARM default chain's committed iPXE image is placed by a separate,
// operator-approved step.
fn site_pxe_edge_placement_for(target: SshTarget, context: FleetSshExecutionContext, mode: SitePxeEdgeMode, privilege: SitePxeEdgeProbe, pins: List<SitePxeEdgeChainPin>, standings: List<SitePxeEdgeChainStanding>) -> SitePxeEdgePlacementOutcome {
  match mode {
    SitePxeEdgeObserveOnly => PlacementNotAttempted { reason: "observe-only" }
    SitePxeEdgeApply =>
      if site_pxe_edge_probe_held(probe: privilege) == false {
        PlacementNotAttempted { reason: "administrator privilege not held" }
      } else {
        fold(filter(site_pxe_edge_media_chains(pins: pins), c => site_pxe_edge_withheld_only_on_members(architecture: c.architecture, audience: c.audience, standings: standings)), init: PlacementNotNeeded, f: (acc, c) => match acc {
          PlacementRefused { step: _, reason: _ } => acc
          PlacementNotAttempted { reason: _ } => acc
          PlacementNotNeeded => site_pxe_edge_place_media_chain(target: target, context: context, chain: c)
          PlacementVerified { placed: _ } => site_pxe_edge_placement_join(left: acc, right: site_pxe_edge_place_media_chain(target: target, context: context, chain: c))
        })
      }
  }
}

fn site_pxe_edge_withheld_only_on_members(architecture: Architecture, audience: SiteEdgeChainAudience, standings: List<SitePxeEdgeChainStanding>) -> Bool {
  any(standings, st => match st {
    SitePxeEdgeChainServable { chain: _ } => false
    SitePxeEdgeChainWithheld { architecture: a, audience: au, causes: cs } => a == architecture && au == audience && all(non_empty_to_list(xs: cs), c => match c {
      MemberUnobservable { served_path: _, reason: _ } => true
      MemberDigestMismatch { served_path: _, observed: _, pinned: _ } => true
      ChainUnpinned { obligation: _ } => false
      IpxeArtifactNotTheCheckedArtifact { pinned: _, checked: _ } => false
      IpxeBuildTargetMismatch { pinned: _, expected: _ } => false
      IpxeBuildArchitectureMismatch { build: _, chain: _ } => false
      IpxeInstalledFilenameMismatch { pinned: _, expected: _ } => false
      IpxeSecureBootUnobserved { why: _ } => false
      IpxeSecureBootRefused { why: _ } => false
      IpxeSecureBootRejected { evidence: _ } => false
    })
  })
}

fn site_pxe_edge_placement_wire(placement: SitePxeEdgePlacementOutcome) -> String {
  match placement {
    PlacementNotNeeded => "not-needed"
    PlacementNotAttempted { reason: r } => concat("not-attempted ", r)
    PlacementRefused { step: st, reason: r } => join(["REFUSED step=", st, " ", r], "")
    PlacementVerified { placed: ps } => concat("placed-and-verified ", join(map(ps, p => p as String), ","))
  }
}

fn site_pxe_edge_file_results(
  target: SshTarget,
  context: FleetSshExecutionContext,
  mode: SitePxeEdgeMode,
  gate_open: Bool,
  files: List<SitePxeEdgeFile>,
) -> List<SitePxeEdgeFileResult>
{
  map(files, f => {
    let before = observe_site_pxe_edge_file(target: target, context: context, file: f)
    SitePxeEdgeFileResult {
      file: f,
      before: before,
      outcome: match mode {
        SitePxeEdgeObserveOnly => EdgeFileNotApplied { reason: "observe-only" }
        SitePxeEdgeApply =>
          if gate_open {
            apply_site_pxe_edge_file(target: target, context: context, file: f, before: before)
          } else {
            EdgeFileNotApplied { reason: "gate closed" }
          }
      },
    }
  })
}

// ORDER: privilege, dnsmasq binary, every placed member's digest (the per-chain standings and the gate), then every desired file, then activation only when the gate is open
// and every file settled, then the unit's active state read back. A closed gate still observes the files,
// so an observe dispatch says what WOULD be written. Every effect is sequenced by a let.
fn run_site_pxe_edge(target: SshTarget, context: FleetSshExecutionContext, mode: SitePxeEdgeMode) -> SitePxeEdgeRun
{
  let pins = site_pxe_edge_chain_pins
  let privilege = site_pxe_edge_argv_probe(target: target, context: context, argv: elevated_argv(command: ["true"]), what: "non-interactive sudo")
  let package = ensure_site_pxe_edge_package(target: target, context: context, mode: mode, privilege: privilege)
  let binary = site_pxe_edge_argv_probe(target: target, context: context, argv: ["test", "-x", site_pxe_edge_dnsmasq_binary as String], what: "test -x dnsmasq")
  let first_observations = map(site_pxe_edge_blob_members(pins: pins), m => observe_site_pxe_edge_member(target: target, context: context, member: m))
  let first_standings = map(pins, p => site_pxe_edge_chain_standing(pin: p, observations: first_observations))
  let placement = site_pxe_edge_placement_for(target: target, context: context, mode: mode, privilege: privilege, pins: pins, standings: first_standings)
  let observations = match placement {
    PlacementVerified { placed: _ } => map(site_pxe_edge_blob_members(pins: pins), m => observe_site_pxe_edge_member(target: target, context: context, member: m))
    PlacementNotNeeded => first_observations
    PlacementNotAttempted { reason: _ } => first_observations
    PlacementRefused { step: _, reason: _ } => first_observations
  }
  let standings = map(pins, p => site_pxe_edge_chain_standing(pin: p, observations: observations))
  let servable = site_pxe_edge_servable_chains(standings: standings)
  let admissions = map(site_pxe_edge_install_requests, r => site_pxe_edge_request_admission(request: r))
  let bindings = site_pxe_edge_request_bindings(admissions: admissions)
  let inputs = site_pxe_edge_desired_inputs(servable: servable, known: site_pxe_edge_known_client_observations, bindings: bindings, tftp_server: site_pxe_edge_tftp_server_address, segment: site_pxe_edge_segment_network)
  let collisions = match inputs {
    Absent => []
    Present { value: i } => site_edge_served_path_collisions(roster: i.roster)
  }
  let causes = site_pxe_edge_gate_causes(tftp_server: site_pxe_edge_tftp_server_address, segment: site_pxe_edge_segment_network, known: site_pxe_edge_known_client_observations, servable: servable, collisions: collisions, dnsmasq_binary: binary, privilege: privilege)
    + site_pxe_edge_request_gate_causes(admissions: admissions)
  let decisions = map(bindings, b => {
    let install = site_pxe_edge_install_chain(architecture: b.architecture, chains: servable)
    let image = match install {
      Absent => InstallerImageUnplaced { reason: "no servable install chain for the binding's architecture" }
      Present { value: ic } => site_pxe_edge_image_standing(image: ic.image, observation: match typed_argv_exec_over_fleet_ssh(target: target, context: context, argv: ["sha256sum", site_pxe_edge_installer_image_path(image: ic.image) as String]) {
        TypedArgvExecRefused { reason: why } => ChainloaderDigestUnobservable { reason: why }
        TypedArgvExecConverged { result: r } => site_pxe_edge_digest_observation(path: site_pxe_edge_installer_image_path(image: ic.image), success: r.success, line: r.stdout)
      })
    }
    SitePxeEdgeInstallDecision {
      binding: b,
      install: install,
      standing: match inputs {
        Absent => InstallWithheld { mac: site_pxe_edge_binding_mac(binding: b), refusals: FreeSemigroup { head: InstallChainNotServable, tail: [] } }
        Present { value: i } => site_pxe_edge_install_standing(binding: b, roster: i.roster, install: install, image: image, name_resolution: site_pxe_edge_seed_origin_resolution)
      },
    }
  })
  let installs = site_pxe_edge_request_withheld(admissions: admissions) + map(decisions, d => d.standing)
  let serves = site_pxe_edge_install_serves(decisions: decisions)
  let admitted = map(serves, sv => sv.binding)
  let files = match inputs {
    Absent => [site_pxe_edge_unit_file()]
    Present { value: i } => site_pxe_edge_desired_files(roster: i.roster, network: i.network, chains: i.chains) + match site_pxe_edge_tftp_server_address {
      Ipv4Parsed { address: bind } => site_pxe_edge_install_files(serves: serves, bind: bind)
      Ipv4ParseFailed { error: _ } => []
    }
  }
  let results = site_pxe_edge_file_results(target: target, context: context, mode: mode, gate_open: length(causes) == 0, files: files)
  let activation = match mode {
    SitePxeEdgeObserveOnly => SitePxeEdgeProbeNotAttempted { reason: "observe-only" }
    SitePxeEdgeApply =>
      if length(causes) == 0 && all(results, r => site_pxe_edge_file_outcome_settled(outcome: r.outcome)) {
        activate_site_pxe_edge_unit(target: target, context: context)
      } else {
        SitePxeEdgeProbeNotAttempted { reason: "gate closed or a file did not settle" }
      }
  }
  let unit_active = observe_site_pxe_edge_unit_active(target: target, context: context)
  let post_activation = match mode {
    SitePxeEdgeObserveOnly => PostActivationNotRead { reason: "observe-only" }
    SitePxeEdgeApply =>
      if site_pxe_edge_probe_held(probe: activation) {
        site_pxe_edge_post_activation(
          chains: servable,
          observations: map(flat_map(servable, c => filter(site_pxe_edge_pinned_members(chain: c), m => site_pxe_edge_member_is_rendered(m: m) == false)), m => observe_site_pxe_edge_member(target: target, context: context, member: m)),
        )
      } else {
        PostActivationNotRead { reason: "activation did not hold" }
      }
  }
  let http = if length(admitted) == 0 {
    HttpLegNotNeeded
  } else {
    match mode {
      SitePxeEdgeObserveOnly => HttpLegNotRead { reason: "observe-only" }
      SitePxeEdgeApply =>
        if site_pxe_edge_probe_held(probe: activation) {
          let http_activation = activate_site_pxe_edge_named_unit(target: target, context: context, unit: site_pxe_edge_http_unit_name)
          match site_pxe_edge_tftp_server_address {
            Ipv4ParseFailed { error: _ } => HttpLegNotRead { reason: "the bind address does not parse" }
            Ipv4Parsed { address: bind } =>
              HttpLegActivation {
                activation: http_activation,
                listen: site_pxe_edge_http_listen_poll(target: target, context: context, bind: bind, remaining: site_pxe_edge_http_listen_samples),
              }
          }
        } else {
          HttpLegNotRead { reason: "the edge unit did not activate" }
        }
    }
  }
  SitePxeEdgeRun {
    mode: mode,
    package: package,
    chains: standings,
    gate_causes: causes,
    installs: installs,
    placement: placement,
    files: results,
    activation: activation,
    unit_active: unit_active,
    post_activation: post_activation,
    http: http,
  }
}

// Observe succeeds when it could SEE everything; drift and a closed gate are its findings. Apply
// succeeds only when the gate was open, every file settled, activation held and the unit reads active.
fn site_pxe_edge_run_succeeded(run: SitePxeEdgeRun) -> Bool {
  match run.mode {
    SitePxeEdgeObserveOnly =>
      !any(run.gate_causes, c => site_pxe_edge_gate_cause_is_unobserved(cause: c))
        && !any(run.chains, st => match st {
          SitePxeEdgeChainServable { chain: _ } => false
          SitePxeEdgeChainWithheld { architecture: _, audience: _, causes: cs } => any(non_empty_to_list(xs: cs), c => site_pxe_edge_chain_cause_is_unobserved(cause: c))
        })
        && (match run.package {
          PackageUndecidable { reason: _ } => false
          PackageHeld { binary: _ } => true
          PackageObservedMissing => true
          PackageInstalledAndReadBack { binary: _ } => true
          PackageInstallRefused { step: _, reason: _ } => true
          PackageReadBackFailed { reason: _, rolled_back: _ } => true
          PackageNotAttempted { reason: _ } => true
        })
        && site_pxe_edge_probe_observable(probe: run.unit_active)
        && !any(run.files, r => match r.before {
          EdgeFileUnobservable { reason: _ } => true
          EdgeFileIdentical => false
          EdgeFileDiffers => false
          EdgeFileAbsent => false
        })
    SitePxeEdgeApply =>
      length(run.gate_causes) == 0
        && site_pxe_edge_package_outcome_settled(outcome: run.package)
        && all(run.files, r => site_pxe_edge_file_outcome_settled(outcome: r.outcome))
        && site_pxe_edge_probe_held(probe: run.activation)
        && site_pxe_edge_probe_held(probe: run.unit_active)
        && (match run.placement {
          PlacementRefused { step: _, reason: _ } => false
          PlacementNotAttempted { reason: _ } => true
          PlacementNotNeeded => true
          PlacementVerified { placed: _ } => true
        })
        && (match run.http {
          HttpLegNotNeeded => true
          HttpLegNotRead { reason: _ } => false
          HttpLegActivation { activation: a, listen: l } =>
            site_pxe_edge_probe_held(probe: a) && (match l { HttpListenBoundTo { address: _ } => true HttpListenWildcard { local: _ } => false HttpListenOtherAddress { local: _ } => false HttpListenAbsent => false HttpListenUnobservable { reason: _ } => false })
        })
        && (match run.post_activation {
          PostActivationDigestHeld => true
          PostActivationNotRead { reason: _ } => false
          PostActivationDigestDiffers { served_path: _, observed: _, pinned: _ } => false
          PostActivationUnobservable { reason: _ } => false
        })
  }
}

fn site_pxe_edge_probe_held(probe: SitePxeEdgeProbe) -> Bool {
  match probe {
    SitePxeEdgeProbeHeld => true
    SitePxeEdgeProbeObservedNegative { reason: _ } => false
    SitePxeEdgeProbeUnobservable { reason: _ } => false
    SitePxeEdgeProbeNotAttempted { reason: _ } => false
  }
}

fn site_pxe_edge_probe_observable(probe: SitePxeEdgeProbe) -> Bool {
  match probe {
    SitePxeEdgeProbeHeld => true
    SitePxeEdgeProbeObservedNegative { reason: _ } => true
    SitePxeEdgeProbeUnobservable { reason: _ } => false
    SitePxeEdgeProbeNotAttempted { reason: _ } => false
  }
}

fn site_pxe_edge_probe_wire(probe: SitePxeEdgeProbe) -> String {
  match probe {
    SitePxeEdgeProbeHeld => "held"
    SitePxeEdgeProbeObservedNegative { reason: r } => concat("no ", r)
    SitePxeEdgeProbeUnobservable { reason: r } => concat("UNOBSERVABLE ", r)
    SitePxeEdgeProbeNotAttempted { reason: r } => concat("not-attempted ", r)
  }
}

fn site_pxe_edge_file_standing_wire(standing: SitePxeEdgeFileStanding) -> String {
  match standing {
    EdgeFileIdentical => "identical"
    EdgeFileDiffers => "differs"
    EdgeFileAbsent => "absent"
    EdgeFileUnobservable { reason: r } => concat("UNOBSERVABLE ", r)
  }
}

fn site_pxe_edge_file_outcome_wire(outcome: SitePxeEdgeFileOutcome) -> String {
  match outcome {
    EdgeFileLeftInPlace => "left-in-place"
    EdgeFileWrittenAndReadBack => "written-and-read-back"
    EdgeFileWriteRefused { step: st, reason: why } => join(["REFUSED step=", st, " ", why], "")
    EdgeFileNotApplied { reason: why } => concat("not-applied ", why)
  }
}

fn site_pxe_edge_post_activation_wire(post: SitePxeEdgePostActivation) -> String {
  match post {
    PostActivationNotRead { reason: r } => concat("not-read ", r)
    PostActivationDigestHeld => "held"
    PostActivationDigestDiffers { served_path: f, observed: o, pinned: p } => join(["DIFFERS ", f as String, " observed ", serialize_content_hash(hash: o) as String, ", pinned ", serialize_content_hash(hash: p) as String], "")
    PostActivationUnobservable { reason: r } => concat("UNOBSERVABLE ", r)
  }
}

fn site_pxe_edge_http_leg_wire(http: SitePxeEdgeHttpLeg) -> String {
  match http {
    HttpLegNotNeeded => "not-needed"
    HttpLegNotRead { reason: r } => concat("not-read ", r)
    HttpLegActivation { activation: a, listen: l } => join(["activation ", site_pxe_edge_probe_wire(probe: a), " listen ", match l {
      HttpListenBoundTo { address: addr } => concat("bound ", addr)
      HttpListenWildcard { local: w } => concat("WILDCARD ", w)
      HttpListenOtherAddress { local: o } => concat("OTHER-ADDRESS ", o)
      HttpListenAbsent => "ABSENT"
      HttpListenUnobservable { reason: r } => concat("UNOBSERVABLE ", r)
    }], "")
  }
}

fn site_pxe_edge_run_text(run: SitePxeEdgeRun) -> String {
  join([
    "mode=", match run.mode { SitePxeEdgeObserveOnly => "observe" SitePxeEdgeApply => "apply" }, "\n",
    "package=", site_pxe_edge_package_outcome_wire(outcome: run.package), " authority=", site_pxe_edge_package_authority, "\n",
    join(map(site_pxe_edge_rollback_steps(), r => join(["rollback-staged ", r.step, ": ", join(r.argv, " "), "\n"], "")), ""),
    "placement=", site_pxe_edge_placement_wire(placement: run.placement), "\n",
    join(map(run.chains, st => site_pxe_edge_chain_standing_text(standing: st)), ""),
    join(map(run.gate_causes, c => join(["gate-closed ", site_pxe_edge_gate_cause_text(cause: c), "\n"], "")), ""),
    join(map(run.files, r => join(["file ", r.file.subject as String, " path=", r.file.path as String, " before=", site_pxe_edge_file_standing_wire(standing: r.before), " outcome=", site_pxe_edge_file_outcome_wire(outcome: r.outcome), "\n"], "")), ""),
    "activation=", site_pxe_edge_probe_wire(probe: run.activation), "\n",
    "unit-active=", site_pxe_edge_probe_wire(probe: run.unit_active), "\n",
    "post-activation-members=", site_pxe_edge_post_activation_wire(post: run.post_activation), "\n",
    "http=", site_pxe_edge_http_leg_wire(http: run.http), "\n",
    "terminal=", if site_pxe_edge_run_succeeded(run: run) { "succeeded" } else { "REFUSED" }, "\n",
  ], "")
}

// ── The CI entries ───────────────────────────────────────────────────────────────────────────────

data site_pxe_edge_converge_attempt_raw: String = "site-pxe-edge-converge-ci"


fn site_pxe_edge_ci_wet(mode: SitePxeEdgeMode) -> ProcessExit
{
  match actions_variable_read(name: fleet_converge_expected_host_env_name) {
    ActionsVariableAbsent { variable: v, detail: d } =>
      exit_failure(reason: join(["site_pxe_edge_converge: ", v, " ", d, "; one host per run, named by the dispatch"], ""))
    ActionsVariablePresent { value: raw_host } =>
      match site_pxe_edge_subject(host: raw_host as HostIdentity) {
        SitePxeEdgeSubjectRefused { cause: c } => exit_failure(reason: c)
        SitePxeEdgeSubjectAdmitted { target: target } =>
          match prepare_fleet_ssh_agent_context(attempt_raw: site_pxe_edge_converge_attempt_raw) {
            FleetSshContextRefused { cause: c } => exit_failure(reason: c)
            FleetSshContextReady { context: context, receipt: context_receipt } => {
              let run = run_site_pxe_edge(target: target, context: context, mode: mode)
              let body = join([
                "site_pxe_edge_converge host=", raw_host, " probed_at=", probed_at_word(reading: clock_now_probed_at()) as String, "\n",
                context_receipt,
                site_pxe_edge_run_text(run: run),
              ], "")
              let w = Filesystem.Write(path: site_pxe_edge_converge_receipt_path, content: body)
              if w.success == false {
                exit_failure(reason: join(["site_pxe_edge_converge: receipt write failed: ", w.error, "\n", body], ""))
              } else if site_pxe_edge_run_succeeded(run: run) == false {
                exit_failure(reason: body)
              } else {
                ExitSuccess
              }
            }
          }
      }
  }
}

fn site_pxe_edge_observe_ci_wet() -> ProcessExit
{
  site_pxe_edge_ci_wet(mode: SitePxeEdgeObserveOnly)
}

fn site_pxe_edge_converge_ci_wet() -> ProcessExit
{
  site_pxe_edge_ci_wet(mode: SitePxeEdgeApply)
}
