module gunbc.managed_principal_provider

import std.types { String, Bool, List, NonEmptyStr }
import std.nat { Nat }
import std.algebra { trim }
import extdeps.ssh { SshPublicKey, ssh_public_key_line }
import std.realization_dependency {
  CapabilityRequirement, requirement_key,
  CapabilityProvider,
  DependencyClosureStanding, DependencyClosureResolved,
  RequirementWithoutProvider, RequirementWithMultipleProviders, DependencyCycle,
  ProviderExecutionStanding, ProviderScheduleExecutable, ProviderHandlerMissing, admit_provider_schedule,
}
import gunbc.managed_principal_session {
  FleetCredentialIdentity,
  PosixAccountReadback, AuthorizedKeyReadback,
  ManagedPrincipalAuthenticationReceipt,
  ManagedPosixAccountReady, ManagedPosixAccountAdmission, ManagedPosixAccountAdmitted, ManagedPosixAccountRefused,
  admit_managed_posix_account,
  ManagedAuthorizedKeyReady, ManagedAuthorizedKeyAdmission, ManagedAuthorizedKeyAdmitted,
  ManagedAuthorizedKeyRefusedLine, ManagedAuthorizedKeyRefusedOwnership, admit_managed_authorized_key,
  FleetPrivateKeyBindingReady,
  ManagedPrincipalSessionReady, ManagedPrincipalSessionAdmission, ManagedPrincipalSessionAdmitted,
  ManagedPrincipalSessionRefusedPrincipal, ManagedPrincipalSessionRefusedCredentialSplit,
  ManagedPrincipalSessionRefusedCredentialUsed, ManagedPrincipalSessionRefusedMembership,
  ManagedPrincipalSessionRefusedUnreachable,
}

// ── THE CLOSED PROVIDER VOCABULARY, WHICH IS WHAT MAKES A MISSING HANDLER A COMPILE ERROR ──────
//
// THE GENERIC RESOLVER MUST NOT KNOW HOW AN ACCOUNT OR A KEY IS INSTALLED, and it does not: std.realization_
// dependency binds requirements to provider ROWS and asks a caller-supplied predicate whether each row has a
// handler. What makes that predicate trustworthy rather than a promise is this coproduct: the executor matches
// it EXHAUSTIVELY, so adding a provider kind without implementing its handler fails to compile instead of
// silently producing a row nothing can run.
//
// AN EARLIER SHAPE HAD FOUR PROVIDER ROWS AND ZERO HANDLERS, and the closure resolved. A caller reading only
// the closure standing would have held a resolved graph that could realize nothing -- which is exactly the
// conflation the three standings exist to prevent, and the reason this module exists at all rather than the
// providers being anonymous strings.
type ManagedProviderKind
  = BootstrapAdministratorSessionProvider
  | FleetPrivateKeyBindingProvider
  | ManagedAccountProvider
  | ManagedAuthorizedKeyProvider
  | ManagedMembershipProvider
  | ManagedPrincipalSessionProvider

fn managed_provider_kind_label(k: ManagedProviderKind) -> NonEmptyStr {
  match k {
    BootstrapAdministratorSessionProvider => "bootstrap-administrator-session" as NonEmptyStr
    FleetPrivateKeyBindingProvider => "fleet-private-key-binding" as NonEmptyStr
    ManagedAccountProvider => "managed-posix-account-upsert" as NonEmptyStr
    ManagedAuthorizedKeyProvider => "authorized-keys-reconcile" as NonEmptyStr
    ManagedMembershipProvider => "managed-membership-upsert" as NonEmptyStr
    ManagedPrincipalSessionProvider => "key-only-authentication-probe" as NonEmptyStr
  }
}

// EVERY KIND ANSWERS WHETHER IT HAS A HANDLER, and the answer is per-kind rather than a blanket `true`. Today
// the membership provider has none: nothing in this repository upserts a supplementary group, so its honest
// answer is false and a graph requiring a membership is NOT executable. Saying so is the point -- a blanket
// yes would have made standing two decorative.
//
// NEXT-RUNG TRIGGER for the membership arm: a group-membership upsert with its own readback, at which point
// this arm flips and the graph that requires `docker` becomes executable.
fn managed_provider_has_handler(k: ManagedProviderKind) -> Bool {
  match k {
    BootstrapAdministratorSessionProvider => true
    FleetPrivateKeyBindingProvider => true
    ManagedAccountProvider => true
    ManagedAuthorizedKeyProvider => true
    ManagedMembershipProvider => false
    ManagedPrincipalSessionProvider => true
  }
}

// THE PROVIDER ROW'S IDENTITY CARRIES ITS KIND AS A PREFIX, which is how a resolved binding is mapped back to
// a handler. A parallel roster keyed by requirement would be a second authority for the same mapping, so the
// identity the graph already carries is what gets read.
fn managed_provider_kind_of(provider_identity: NonEmptyStr) -> ManagedProviderKind? {
  if string_contains(s: provider_identity as String, pattern: "bootstrap-administrator-session") { Present { value: BootstrapAdministratorSessionProvider } }
  else { if string_contains(s: provider_identity as String, pattern: "fleet-private-key-binding") { Present { value: FleetPrivateKeyBindingProvider } }
  else { if string_contains(s: provider_identity as String, pattern: "managed-posix-account-upsert") { Present { value: ManagedAccountProvider } }
  else { if string_contains(s: provider_identity as String, pattern: "authorized-keys-reconcile") { Present { value: ManagedAuthorizedKeyProvider } }
  else { if string_contains(s: provider_identity as String, pattern: "managed-membership-upsert") { Present { value: ManagedMembershipProvider } }
  else { if string_contains(s: provider_identity as String, pattern: "key-only-authentication-probe") { Present { value: ManagedPrincipalSessionProvider } }
  else { none } } } } } }
}

// AN UNRECOGNISED PROVIDER IDENTITY HAS NO HANDLER RATHER THAN A DEFAULT ONE, which keeps the wall fail-closed
// against a row this module has never seen: a provider authored elsewhere cannot borrow executability from the
// fact that its name is unfamiliar.
fn provider_row_has_handler(p: CapabilityProvider) -> Bool {
  match managed_provider_kind_of(provider_identity: p.identity) {
    Absent => false
    Present { value: k } => managed_provider_has_handler(k: k)
  }
}

fn admit_managed_schedule(standing: DependencyClosureStanding) -> ProviderExecutionStanding? {
  admit_provider_schedule(standing: standing, has_handler: provider_row_has_handler)
}

// ── WHAT EACH PROVIDER PRODUCES, AS ONE TERMINAL STANDING PER NODE ─────────────────────────────
//
// THE THREE OUTCOMES ARE REALIZED, REFUSED AND UNATTEMPTED, and the third is what the hand-sequenced apply
// could not express. A provider whose prerequisite did not realize asserts NOTHING about its own effect: it
// names the node that blocked it and stops. That is the difference between a receipt showing one cause with
// three consequences and a receipt showing four broken things.
type ManagedProviderOutcome
  = ProviderRealized { kind: ManagedProviderKind, detail: NonEmptyStr }
  | ProviderRefused { kind: ManagedProviderKind, cause: NonEmptyStr }
  | ProviderUnattempted { kind: ManagedProviderKind, blocked_by: ManagedProviderKind }

fn provider_outcome_kind(o: ManagedProviderOutcome) -> ManagedProviderKind {
  match o {
    ProviderRealized { kind: k, detail: _ } => k
    ProviderRefused { kind: k, cause: _ } => k
    ProviderUnattempted { kind: k, blocked_by: _ } => k
  }
}

fn provider_outcome_realized(o: ManagedProviderOutcome) -> Bool {
  match o {
    ProviderRealized { kind: _, detail: _ } => true
    ProviderRefused { kind: _, cause: _ } => false
    ProviderUnattempted { kind: _, blocked_by: _ } => false
  }
}

fn provider_outcome_label(o: ManagedProviderOutcome) -> String {
  match o {
    ProviderRealized { kind: k, detail: d } => join([managed_provider_kind_label(k: k) as String, "  realized  ", d as String], "")
    ProviderRefused { kind: k, cause: c } => join([managed_provider_kind_label(k: k) as String, "  REFUSED  ", c as String], "")
    ProviderUnattempted { kind: k, blocked_by: b } =>
      join([managed_provider_kind_label(k: k) as String, "  unattempted (blocked by ", managed_provider_kind_label(k: b) as String, ")"], "")
  }
}

// ── THE ACCOUNT PROVIDER'S TERMINAL: THE HANDLE OR THE REASON THERE IS NONE ────────────────────
//
// EACH OF THESE PAIRS A READY HANDLE WITH THE OUTCOME THAT PRODUCED IT, so a caller cannot read a realized
// outcome and then look up a handle that was never minted. The handle is an Optional on the SAME value as the
// outcome rather than a parallel list -- two lists would let them disagree.
type AccountProviderTerminal sole_constructor {
  outcome: ManagedProviderOutcome
  ready: ManagedPosixAccountReady?
}

// THE PROVIDER OBSERVES AFTER APPLY, WHICH IS THE WHOLE OF ITS CONTRACT. `apply_succeeded` says the useradd
// script exited zero; the READBACK says what the host reports. A provider that returned the handle on the
// first fact would be the "exit status is the capability" mistake, and the admission it delegates to refuses a
// missing home for exactly that reason.
fn realize_managed_account(
  host: NonEmptyStr,
  principal: NonEmptyStr,
  bootstrap_realized: Bool,
  apply_succeeded: Bool,
  apply_detail: NonEmptyStr,
  readback: PosixAccountReadback,
) -> AccountProviderTerminal {
  if !bootstrap_realized {
    AccountProviderTerminal {
      outcome: ProviderUnattempted { kind: ManagedAccountProvider, blocked_by: BootstrapAdministratorSessionProvider },
      ready: none,
    }
  } else {
    if !apply_succeeded {
      AccountProviderTerminal {
        outcome: ProviderRefused { kind: ManagedAccountProvider, cause: apply_detail },
        ready: none,
      }
    } else {
      match admit_managed_posix_account(host: host, expected_principal: principal, readback: readback) {
        ManagedPosixAccountRefused { expected: e, cause: c } =>
          AccountProviderTerminal {
            outcome: ProviderRefused {
              kind: ManagedAccountProvider,
              cause: join(["the account script succeeded and the readback disagrees for ", e as String, ": ", c as String], "") as NonEmptyStr,
            },
            ready: none,
          }
        ManagedPosixAccountAdmitted { ready: r } =>
          AccountProviderTerminal {
            outcome: ProviderRealized {
              kind: ManagedAccountProvider,
              detail: join(["the host reports ", r.principal as String, " with home ", r.home as String], "") as NonEmptyStr,
            },
            ready: Present { value: r },
          }
      }
    }
  }
}

// ── THE KEY PROVIDER ──────────────────────────────────────────────────────────────────────────
type KeyProviderTerminal sole_constructor {
  outcome: ManagedProviderOutcome
  ready: ManagedAuthorizedKeyReady?
}

// A WRITE THAT SUCCEEDED AND A READBACK THAT DISAGREES IS A REFUSAL, NOT A REALIZATION, and it is the case the
// ruling singled out: `grep -qxF || printf` exits zero having appended the line, and the file can still be
// group-writable or owned by root, in which case sshd ignores it. So the write and the readback are separate
// facts and only the second produces the handle.
fn realize_managed_authorized_key(
  account_ready: ManagedPosixAccountReady?,
  credential: FleetCredentialIdentity,
  expected_key: SshPublicKey,
  apply_succeeded: Bool,
  apply_detail: NonEmptyStr,
  readback: AuthorizedKeyReadback,
) -> KeyProviderTerminal {
  match account_ready {
    Absent => KeyProviderTerminal {
      outcome: ProviderUnattempted { kind: ManagedAuthorizedKeyProvider, blocked_by: ManagedAccountProvider },
      ready: none,
    }
    Present { value: account } =>
      if !apply_succeeded {
        KeyProviderTerminal {
          outcome: ProviderRefused { kind: ManagedAuthorizedKeyProvider, cause: apply_detail },
          ready: none,
        }
      } else {
        match admit_managed_authorized_key(account: account, credential: credential, expected_key: expected_key, readback: readback) {
          ManagedAuthorizedKeyRefusedLine { expected_line: e, observed_line: o } =>
            KeyProviderTerminal {
              outcome: ProviderRefused {
                kind: ManagedAuthorizedKeyProvider,
                cause: join(["the write succeeded and the line read back is not the declared key. expected ", e as String, ", observed ", o as String], "") as NonEmptyStr,
              },
              ready: none,
            }
          ManagedAuthorizedKeyRefusedOwnership { expected_owner: e, observed_owner: o, observed_mode: m } =>
            KeyProviderTerminal {
              outcome: ProviderRefused {
                kind: ManagedAuthorizedKeyProvider,
                cause: join([
                  "the write succeeded and the file cannot authenticate: expected owner ", e as String,
                  ", observed owner ", o as String, " at mode ", m as String,
                  ". sshd ignores a group- or world-writable authorized_keys and one it does not own",
                ], "") as NonEmptyStr,
              },
              ready: none,
            }
          ManagedAuthorizedKeyAdmitted { ready: r } =>
            KeyProviderTerminal {
              outcome: ProviderRealized {
                kind: ManagedAuthorizedKeyProvider,
                detail: join(["the exact declared line is present for ", r.principal as String, ", owned by it, at the required mode"], "") as NonEmptyStr,
              },
              ready: Present { value: r },
            }
        }
      }
  }
}

// ── THE SESSION PROVIDER, WHICH IS THE ONLY MINTER OF THE TERMINAL HANDLE ──────────────────────
type SessionProviderTerminal sole_constructor {
  outcome: ManagedProviderOutcome
  ready: ManagedPrincipalSessionReady?
}

// IT MUST NOT REUSE THE PRIVILEGED BOOTSTRAP CONNECTION. The receipt it consumes comes from a NEW key-only
// session; inferring reachability from the administrator session that just wrote the key would prove that the
// administrator can reach the host, which was already known and is not this capability.
//
// AND IT IS UNATTEMPTED, NOT REFUSED, WHERE EITHER PREREQUISITE HANDLE IS ABSENT. A session probe run after a
// failed key install would fail for a reason that is not about the session, and reporting that as a session
// refusal is how one cause becomes two findings.
fn realize_managed_principal_session(
  account_ready: ManagedPosixAccountReady?,
  key_ready: ManagedAuthorizedKeyReady?,
  binding: FleetPrivateKeyBindingReady,
  admission: ManagedPrincipalSessionAdmission,
) -> SessionProviderTerminal {
  match account_ready {
    Absent => SessionProviderTerminal {
      outcome: ProviderUnattempted { kind: ManagedPrincipalSessionProvider, blocked_by: ManagedAccountProvider },
      ready: none,
    }
    Present { value: _ } =>
      match key_ready {
        Absent => SessionProviderTerminal {
          outcome: ProviderUnattempted { kind: ManagedPrincipalSessionProvider, blocked_by: ManagedAuthorizedKeyProvider },
          ready: none,
        }
        Present { value: _ } =>
          match admission {
            ManagedPrincipalSessionAdmitted { ready: r } =>
              SessionProviderTerminal {
                outcome: ProviderRealized {
                  kind: ManagedPrincipalSessionProvider,
                  detail: join(["a fresh key-only session authenticated as ", r.principal as String, " on ", r.host as String], "") as NonEmptyStr,
                },
                ready: Present { value: r },
              }
            ManagedPrincipalSessionRefusedPrincipal { expected: e, observed: o } =>
              SessionProviderTerminal {
                outcome: ProviderRefused {
                  kind: ManagedPrincipalSessionProvider,
                  cause: join(["the session authenticated as ", o as String, " and not ", e as String, "; an exit status would have read this as success"], "") as NonEmptyStr,
                },
                ready: none,
              }
            ManagedPrincipalSessionRefusedCredentialSplit { installed: i, in_use: u } =>
              SessionProviderTerminal {
                outcome: ProviderRefused {
                  kind: ManagedPrincipalSessionProvider,
                  cause: join(["the installed key ", i as String, " is not the bound key ", u as String, "; both facts were true and they are not one fleet key"], "") as NonEmptyStr,
                },
                ready: none,
              }
            ManagedPrincipalSessionRefusedCredentialUsed { declared: d, used: u } =>
              SessionProviderTerminal {
                outcome: ProviderRefused {
                  kind: ManagedPrincipalSessionProvider,
                  cause: join(["the session used credential ", u as String, " where the binding declares ", d as String], "") as NonEmptyStr,
                },
                ready: none,
              }
            ManagedPrincipalSessionRefusedMembership { required: r, observed: o } =>
              SessionProviderTerminal {
                outcome: ProviderRefused {
                  kind: ManagedPrincipalSessionProvider,
                  cause: join(["the session did not observe required membership ", r as String, " (saw ", to_string(count(o)), " group(s))"], "") as NonEmptyStr,
                },
                ready: none,
              }
            ManagedPrincipalSessionRefusedUnreachable { cause: c } =>
              SessionProviderTerminal {
                outcome: ProviderRefused { kind: ManagedPrincipalSessionProvider, cause: c },
                ready: none,
              }
          }
      }
  }
}

// ── THE CHAIN'S TERMINAL REPORT ───────────────────────────────────────────────────────────────
//
// ONE OUTCOME PER PROVIDER, AND THE SESSION HANDLE ONLY WHERE THE SESSION PROVIDER MINTED IT. A caller reads
// the handle to run work and the outcomes to explain why there is none; neither is derivable from the other,
// which is why both are carried.
type ManagedAccessRealization sole_constructor {
  outcomes: List<ManagedProviderOutcome>
  session: ManagedPrincipalSessionReady?
}

fn managed_access_realized(r: ManagedAccessRealization) -> Bool {
  match r.session {
    Present { value: _ } => true
    Absent => false
  }
}

fn managed_access_first_refusal(r: ManagedAccessRealization) -> NonEmptyStr? {
  match (filter(r.outcomes, o => match o {
    ProviderRefused { kind: _, cause: _ } => true
    ProviderRealized { kind: _, detail: _ } => false
    ProviderUnattempted { kind: _, blocked_by: _ } => false
  })).first() {
    Absent => none
    Present { value: o } => Present { value: provider_outcome_label(o: o) as NonEmptyStr }
  }
}

fn managed_access_report_text(r: ManagedAccessRealization) -> String {
  join(map(r.outcomes, o => join(["  ", provider_outcome_label(o: o), "\n"], "")), "")
}

// THE FOLD FROM THE THREE TERMINALS, which is where the chain becomes structural: each terminal's handle is
// the next one's argument, so a refusal upstream leaves the downstream provider with an Absent to match on and
// no way to attempt anything.
fn fold_managed_access(
  bootstrap: ManagedProviderOutcome,
  binding: ManagedProviderOutcome,
  account: AccountProviderTerminal,
  key: KeyProviderTerminal,
  session: SessionProviderTerminal,
) -> ManagedAccessRealization {
  ManagedAccessRealization {
    outcomes: [bootstrap, binding, account.outcome, key.outcome, session.outcome],
    session: session.ready,
  }
}
