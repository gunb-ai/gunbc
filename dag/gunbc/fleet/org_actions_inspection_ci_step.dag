module gunbc.fleet.org_actions_inspection_ci_step

// THE CI RUN-STEP LEAF OF THE ORG ACTIONS INSPECTION DOMAIN: the `gunbc run` target and
// invoke of the org_actions_inspect step, beside the domain whose entry module it invokes
// (gunbc.fleet.org_actions_inspection). The shared run-step machinery is
// v2.workflow.gunbc_invoke_step_emit, gunbc.ci.ci_layer_roots and
// gunbc.ci.ci_run_step_target, plus the one GitHub-App credential prelude from
// gunbc.auth.github_app_credential_step. The roster stays in gunbc.ci.ci_spec, which imports
// the target. A step module imports the shared machinery, never ci_spec.

import std.types { String }
import v2.workflow.gunbc_invoke_step_emit { gunbc_run_step_script_with_prelude }
import gunbc.ci.ci_run_step_target { GunbcRunStepTarget }
import gunbc.ci.ci_layer_roots { witness_layer_roots }
import gunbc.auth.github_app_credential_step {
  gunbc_ci_org_admin_app_token_prelude
}

data gunbc_ci_org_actions_inspect_target: GunbcRunStepTarget = GunbcRunStepTarget {
  entry: "dag/gunbc/fleet/org_actions_inspection.dag",
  function: "org_actions_inspect_wet",
}

fn gunbc_ci_org_actions_inspect_invoke() -> String {
  gunbc_run_step_script_with_prelude(
    prelude: gunbc_ci_org_admin_app_token_prelude(),
    source_roots: witness_layer_roots,
    entry: gunbc_ci_org_actions_inspect_target.entry,
    function: gunbc_ci_org_actions_inspect_target.function,
    claim_run: false,
    receipt_rel: none
  )
}
