// Read-only status request/response. Topic/endpoint/credential all join through the same fleet identity.
// It observes current state, not causality or an acknowledgement of a particular start.
// What the credential cleanup did after a report attempt. The credential-bound options file
// lives in the directory the placed binding holds (its own Mktemp directory, binding.dir),
// NOT under the CA workspace, so removing the CA workspace does not remove it: the standing
// of the two cleanups is kept apart and travels with the capture verdict, never replacing it.
type PrinterCleanupStanding
  = PrinterCleanupClean
  | PrinterCleanupOutstanding { detail: NonEmptyStr }

// The outcome of one printer report attempt: the child's capture verdict and the cleanup
// standing, carried separately. A cleanup failure never rewrites the real child verdict, and
// a captured success never hides a leaked credential-bearing file -- the caller must refuse
// (or report the cleanup outstanding) when the standing is Outstanding.
type PrinterReportCapture
  = PrinterReported { outcome: ProcessCaptureOutcome, cleanup: PrinterCleanupStanding }
  // ALL ADMITTED FRESH CAPTURES RAN AND NONE HELD A COMPLETE STATE/ERROR REPORT. The last REAL
  // capture is kept: dressing exhaustion as ProcessOutputAbsent would fabricate "the child ran and
  // printed nothing" over a stream that DID print -- eight partial telemetry deltas that never
  // completed. Consumers refuse in the printer domain with these words; nothing here is an exit code.
  | PrinterReportExhausted { last: ProcessCaptureOutcome, cleanup: PrinterCleanupStanding }

// Words for the last capture an exhausted attempt budget returned. Every arm is a fact the capture
// itself carries (the spawner's refusal, an exit the child reported, output that stayed unread).
fn printer_report_last_words(capture: ProcessCaptureOutcome) -> String {
  match capture {
    ProcessCaptureNotSpawned { program: p, cause: why } => join(["never spawned: ", p, " -- ", why], "")
    ProcessCaptured { outcome: ProcessRefused { exit_code: e, stderr: x } } => join(["exited ", to_string(e), ": ", x], "")
    ProcessCaptured { outcome: ProcessOutputAbsent } => "returned no output"
    ProcessCaptured { outcome: ProcessOutputPresent { text: t } } => join(["printed ", to_string(string_length(s: t)), " bytes that never completed into a state/error report"], "")
  }
}

// THE FINAL DIAGNOSIS FOR AN EXHAUSTED BUDGET, decided once so the witness drives the consumer's
// exact exit: a refusal naming the incompleteness and the last capture's own facts, never a
// fabricated verdict, and a credential-bound leak still refuses over silence.
fn printer_report_exhaustion_refusal(last: ProcessCaptureOutcome, cleanup: PrinterCleanupStanding) -> ProcessExit {
  match cleanup {
    PrinterCleanupOutstanding { detail: d } => exit_failure(reason: join(["Printer report incomplete after all admitted captures (last: ", printer_report_last_words(capture: last), ") AND its credential-bound cleanup leaked: ", d], ""))
    PrinterCleanupClean => exit_failure(reason: join(["Printer report incomplete after all admitted captures (last: ", printer_report_last_words(capture: last), ")"], ""))
  }
}

// One attempt under a pinned CA bundle: whether options were placed (a placed binding must be
// shredded) and what the child returned.
type ReportCredentialAttempt
  = PrinterCredentialAttempt { outcome: ProcessCaptureOutcome, options_outstanding: Bool, options_placed: Bool }

fn report(printer: PhysicalAssetIdentity, version: NonEmptyStr, token_source: AccessTokenSource) -> PrinterReportCapture {
  match read_existing_printer_session(printer:printer,version:version,credential_source:SecretManagerCredentialSource {token_source:token_source}) {
   // The report client was never spawned: the session's own refusal is the fact, not an
   // exit code no child returned.
   PrinterSessionRefused {cause:c}=>PrinterReported { outcome: ProcessCaptureNotSpawned {program:"mosquitto_rr" as NonEmptyStr,cause:join(["printer session refused: ",c as String],"") as NonEmptyStr}, cleanup: PrinterCleanupClean }
   PrinterSessionReady {session:s}=>report_using_session(session:s)
  }
}
fn report_using_session(session:PrinterCredentialSession) -> PrinterReportCapture {
 report_session_attempts(session:session,remaining:8)
}

// Reconciliation owns its retry budget; do not multiply it by the readiness retry loop.
fn report_once_using_session(session:PrinterCredentialSession) -> PrinterReportCapture {
 report_session_attempts(session:session,remaining:1)
}
fn report_session_attempts(session:PrinterCredentialSession,remaining:Int) -> PrinterReportCapture {
 let printer=session_printer(s:session)
 match printer_serial(printer:printer) {
  PrinterSerialFound {serial:serial}=>match printer_endpoint_address(printer:printer) {
   PrinterAddressFound {address:a}=>if remaining==1 {report_with_credential(serial:serial,address:a,credential:session_credential(s:session))} else {complete_report_with_credential(serial:serial,address:a,credential:session_credential(s:session),remaining:remaining)}
   // No address means no endpoint to dial: the client was never spawned.
   PrinterAddressUnknown {printer:_}=>PrinterReported { outcome: ProcessCaptureNotSpawned {program:"mosquitto_rr" as NonEmptyStr,cause:"printer address absent or ambiguous"}, cleanup: PrinterCleanupClean } PrinterAddressAmbiguous {printer:_}=>PrinterReported { outcome: ProcessCaptureNotSpawned {program:"mosquitto_rr" as NonEmptyStr,cause:"printer address absent or ambiguous"}, cleanup: PrinterCleanupClean } PrinterAddressWrongClass {printer:_}=>PrinterReported { outcome: ProcessCaptureNotSpawned {program:"mosquitto_rr" as NonEmptyStr,cause:"printer address absent or ambiguous"}, cleanup: PrinterCleanupClean }
  }
  // No serial means no topics to subscribe: the client was never spawned.
  PrinterSerialUnknown {printer:_}=>PrinterReported { outcome: ProcessCaptureNotSpawned {program:"mosquitto_rr" as NonEmptyStr,cause:"printer serial absent or ambiguous"}, cleanup: PrinterCleanupClean } PrinterSerialUnrecorded {printer:_}=>PrinterReported { outcome: ProcessCaptureNotSpawned {program:"mosquitto_rr" as NonEmptyStr,cause:"printer serial absent or ambiguous"}, cleanup: PrinterCleanupClean } PrinterSerialAmbiguous {printer:_}=>PrinterReported { outcome: ProcessCaptureNotSpawned {program:"mosquitto_rr" as NonEmptyStr,cause:"printer serial absent or ambiguous"}, cleanup: PrinterCleanupClean }
 }
}

fn report_with_credential(serial: NonEmptyStr, address: NonEmptyStr, credential: Secret) -> PrinterReportCapture {
  match acquire_pinned_ca_bundle() {
    // Without the pinned CA bundle the client is never launched; nothing was placed, so there
    // is nothing of ours left behind to clean.
    CaBundleRefused { cause: c } => PrinterReported { outcome: ProcessCaptureNotSpawned { program: "mosquitto_rr" as NonEmptyStr, cause: join(["CA bundle refused: ", c as String], "") as NonEmptyStr }, cleanup: PrinterCleanupClean }
    // Refused with residue left behind: the client never launched AND our own files remain --
    // the capture says never-spawned, the standing says outstanding.
    CaBundleRefusedResidueRemains { cause: c } => PrinterReported { outcome: ProcessCaptureNotSpawned { program: "mosquitto_rr" as NonEmptyStr, cause: join(["CA bundle refused with residue: ", c as String], "") as NonEmptyStr }, cleanup: PrinterCleanupOutstanding { detail: join(["CA bundle residue remains after refusal: ", c as String], "") as NonEmptyStr } }
    CaBundlePinned { bundle: bundle, workspace: workspace } => {
      let attempt = match place_mosquitto_rr_options_privately(login: bambu_lan_mqtt_user, password: credential) {
        // Without placed RR options the client is never launched.
        MosquittoOptionsRefused { cause: c } => PrinterCredentialAttempt { outcome: ProcessCaptureNotSpawned { program: "mosquitto_rr" as NonEmptyStr, cause: join(["mosquitto RR options refused: ", c as String], "") as NonEmptyStr }, options_outstanding: false, options_placed: false }
        MosquittoOptionsRefusedResidueRemains { cause: c } => PrinterCredentialAttempt { outcome: ProcessCaptureNotSpawned { program: "mosquitto_rr" as NonEmptyStr, cause: join(["mosquitto RR options refused with residue: ", c as String], "") as NonEmptyStr }, options_outstanding: true, options_placed: false }
        MosquittoOptionsPlaced { binding: b } => PrinterCredentialAttempt {
          outcome: run_shell_command_capture(command: env_prefixed_command(bindings: mosquitto_options_env(binding: b), command: mosquitto_snapshot_command(
            endpoint: bambu_lan_mqtt_endpoint(host: address), topic: bambu_report_topic(serial: serial), request_topic: bambu_request_topic(serial: serial), payload: bambu_status_snapshot_payload(), ca_bundle: pinned_ca_bundle_path(bundle: bundle))), transport: LocalExec),
          // The capture is the run's verdict; a shred failure does not undo a spawn -- it makes
          // the credential-bound options directory (the binding's own Mktemp directory,
          // binding.dir, NOT the CA workspace below) leak, which travels as Outstanding.
          options_outstanding: !shred_mosquitto_options_binding(binding: b),
          options_placed: true
        }
      }
      let ca_removed = shell.Remove.RecursiveForce(path: workspace).success
      // The CA workspace removal failing leaks the CA workspace; it never rewrites the run's
      // captured verdict. Both leakages, if both happen, are named in one standing.
      match attempt {
        PrinterCredentialAttempt { outcome: outcome, options_outstanding: lo, options_placed: lp } =>
          if lo && lp && !ca_removed {
            PrinterReported { outcome: outcome, cleanup: PrinterCleanupOutstanding { detail: "credential-bound options directory (binding.dir) AND the CA workspace both leaked after forced removal" } }
          } else if lo && lp {
            PrinterReported { outcome: outcome, cleanup: PrinterCleanupOutstanding { detail: "credential-bound options directory (binding.dir) leaked: shred of the placed binding directory failed" } }
          } else if lo {
            PrinterReported { outcome: outcome, cleanup: PrinterCleanupOutstanding { detail: join(["placed options refusal residue remains in the private options directory (binding.dir), NOT the CA workspace -- forced removal did not clear it"], "") as NonEmptyStr } }
          } else if !ca_removed {
            PrinterReported { outcome: outcome, cleanup: PrinterCleanupOutstanding { detail: join(["CA workspace ", workspace, " leaked after forced removal"], "") as NonEmptyStr } }
          } else {
            PrinterReported { outcome: outcome, cleanup: PrinterCleanupClean }
          }
      }
    }
  }
}

fn run(printer: String, version: String, output: String) -> ProcessExit {
  match select_printer(name: printer) {
    PrinterSelectionRefused => exit_failure(reason: "Unknown printer")
    PrinterSelected { printer: p } => match read_supplied_access_token() {
      SuppliedTokenUnavailable { cause: c } => exit_failure(reason: c as String)
      SuppliedTokenReady { token: t } => match report(printer: p, version: version as NonEmptyStr, token_source: OperatorSuppliedToken { token: t }) {
        // Exhaustion refuses in the printer domain with the last capture's own facts -- the CLI never
        // writes a partial report and never hears a fabricated "No printer report received".
        PrinterReportExhausted { last: last_capture, cleanup: cleanup } => printer_report_exhaustion_refusal(last: last_capture, cleanup: cleanup)
        PrinterReported { outcome: observed_capture, cleanup: cleanup } => match cleanup {
          // A credential-bound leak after the attempt is a refusal in its own right: the child's
          // real verdict is kept in the result and never replaced, but it never passes silently
          // either -- the operator hears what leaked.
          PrinterCleanupOutstanding { detail: d } => exit_failure(reason: join(["Printer report cleanup outstanding: ", d], ""))
          PrinterCleanupClean => match observed_capture {
            ProcessCaptured { outcome: observed } => match observed {
              ProcessRefused { exit_code: _, stderr: e } => exit_failure(reason: e)
              ProcessOutputAbsent => exit_failure(reason: "No printer report received")
              ProcessOutputPresent { text: text } =>
                if Filesystem.Write(path: output, content: text).success { ExitSuccess }
                else { exit_failure(reason: "Cannot retain printer report") }
            }
            // The report client was never spawned, so the printer's state is unknown and the operator
            // hears the spawner's own cause -- not an exit code no child ever returned.
            ProcessCaptureNotSpawned { program: pp, cause: why } =>
              exit_failure(reason: join(["Printer report was never spawned: ", pp, " -- ", why], ""))
          }
        }
      }
    }
  }
}

fn observe_both(printer_01_version: String, printer_02_version: String, directory: String) -> ProcessExit {
  match run(printer: printer_01 as String, version: printer_01_version, output: concat(directory, "/printer-01.json")) {
    ExitSuccess => run(printer: printer_02 as String, version: printer_02_version, output: concat(directory, "/printer-02.json"))
    other => other
  }
}

// Bambu sends partial telemetry deltas. Only a single fresh message containing both
// state and error is complete enough for start admission; never infer missing fields.
fn report_has_state_and_error(text: String) -> Bool {
  match parse_json_document(s: text) {
    JsonDocumentParsed { value: root } => match json_object_unique_member(v: root, key: "print") {
      JsonMemberFound { value: p } => {
        let state = match json_object_unique_member(v: p, key: "gcode_state") {
          JsonMemberFound { value: JsonString { value: _ } } => true
          JsonMemberFound {value:JsonNull}=>false JsonMemberFound {value:JsonBool {value:_}}=>false JsonMemberFound {value:JsonNumber {lexeme:_}}=>false JsonMemberFound {value:JsonArray {elements:_}}=>false JsonMemberFound {value:JsonObject {members:_}}=>false JsonMemberAbsent=>false JsonMemberNotAnObject=>false JsonMemberDuplicated {count:_}=>false
        }
        let error = match json_object_unique_member(v: p, key: "print_error") {
          JsonMemberFound { value: JsonNumber { lexeme: _ } } => true
          JsonMemberFound {value:JsonNull}=>false JsonMemberFound {value:JsonBool {value:_}}=>false JsonMemberFound {value:JsonString {value:_}}=>false JsonMemberFound {value:JsonArray {elements:_}}=>false JsonMemberFound {value:JsonObject {members:_}}=>false JsonMemberAbsent=>false JsonMemberNotAnObject=>false JsonMemberDuplicated {count:_}=>false
        }
        state && error
      }
      JsonMemberAbsent=>false JsonMemberNotAnObject=>false JsonMemberDuplicated {count:_}=>false
    }
    JsonDocumentUnreadable {gap:_}=>false
  }
}

fn complete_report_with_credential(serial: NonEmptyStr, address: NonEmptyStr, credential: Secret, remaining: Int) -> PrinterReportCapture {
  match report_with_credential(serial: serial, address: address, credential: credential) {
    PrinterReported { outcome: ProcessCaptured { outcome: ProcessOutputPresent { text: text } }, cleanup: cleanup } =>
      if report_has_state_and_error(text: text) { PrinterReported { outcome: ProcessCaptured { outcome: ProcessOutputPresent { text: text } }, cleanup: cleanup } }
      // THE BUDGET IS OUT AND THIS WAS THE LAST REAL CAPTURE: keep it under the exhaustion marker --
      // the caller refuses in the printer domain. Fabricating ProcessOutputAbsent here would report
      // "ran, printed nothing" over a stream that DID print, just never completely.
      else if remaining <= 1 { PrinterReportExhausted { last: ProcessCaptured { outcome: ProcessOutputPresent { text: text } }, cleanup: cleanup } }
      // Retrying discards THIS attempt's capture, but a leaked credential-bearing file must not
      // be discarded with it: the standing is folded into whatever the later attempts return.
      else { fold_cleanup(previous: cleanup, next: complete_report_with_credential(serial: serial, address: address, credential: credential, remaining: remaining - 1)) }
    // A report that never ran is not an incomplete report: retrying a program the spawner refused
    // would only answer the same refusal eight times.
    other => other
  }
}

// Carry an earlier attempt's outstanding cleanup across a retry that replaces the capture.
fn fold_standings(previous: PrinterCleanupStanding, next: PrinterCleanupStanding) -> PrinterCleanupStanding {
  match previous {
    PrinterCleanupClean => next
    PrinterCleanupOutstanding { detail: p } => match next {
      PrinterCleanupClean => PrinterCleanupOutstanding { detail: p as NonEmptyStr }
      PrinterCleanupOutstanding { detail: d } => PrinterCleanupOutstanding { detail: join([p, "; ", d], "") as NonEmptyStr }
    }
  }
}

fn fold_cleanup(previous: PrinterCleanupStanding, next: PrinterReportCapture) -> PrinterReportCapture {
  match next {
    PrinterReportExhausted { last: last, cleanup: cleanup } =>
      PrinterReportExhausted { last: last, cleanup: fold_standings(previous: previous, next: cleanup) }
    PrinterReported { outcome: outcome, cleanup: PrinterCleanupClean } =>
      match previous {
        PrinterCleanupClean => PrinterReported { outcome: outcome, cleanup: PrinterCleanupClean }
        PrinterCleanupOutstanding { detail: d } => PrinterReported { outcome: outcome, cleanup: PrinterCleanupOutstanding { detail: d } }
      }
    PrinterReported { outcome: outcome, cleanup: PrinterCleanupOutstanding { detail: d } } =>
      match previous {
        PrinterCleanupClean => PrinterReported { outcome: outcome, cleanup: PrinterCleanupOutstanding { detail: d } }
        PrinterCleanupOutstanding { detail: p } => PrinterReported { outcome: outcome, cleanup: PrinterCleanupOutstanding { detail: join([p, "; ", d], "") as NonEmptyStr } }
      }
  }
}
