module gunbc.fleet.fleet_converge_descending_main_admit

import std.types { String, Bool, List }
import std.algebra { Cons, Empty, FreeMonoid, contains, fold_list, is_empty }
import v2.lens.module_graph { path_matches_touched }

// ============================================================================
// DESCENDING-MAIN APPLY ADMISSION
//
// WHAT THIS DECIDES. At apply time the plan-revision job runs at the dispatch's event sha M while
// the plan was made at revision P. Today admission admits only when M == P (a pointer admission
// refuses M != P by name). This module extends admission: when M != P, the apply is admitted
// exactly when M DESCENDS from P (P is an ancestor of M, proven by git merge-base) AND the diff
// P..M touches NOTHING in the plan's source closure (the transitive import set of the plan CLI's
// entry module, computed at plan-production time and recorded in the plan receipt).
//
// WHY THE CLOSURE COMES FROM THE PLAN'S OWN MODELED READS. The plan CLI produces its output by
// reading DAG source files through its transitive import chain (v2.lens.module_graph
// import_closure_live). Those files are what the plan reads from repo bytes at P; no other repo
// file is consulted (every Filesystem.Read in the plan CLI targets /tmp/fleet-converge-plan/
// runtime artifacts). So the import closure IS the plan's source closure, derived from the plan
// artifact's own modeled reads, not a hand-maintained path list.
//
// WHAT THIS MODULE DOES NOT DO. It does not perform IO: the caller observes the merge base and the
// changed-path list through extdeps.git.Core (MergeBase, DiffNameOnlyMerge) and passes them here.
// It does not weaken any existing refusal: when M == P the existing path admits exactly as before.
// When the receipt carries no source_closure (a plan made before this field existed), this module
// refuses the descending case, preserving the strict M == P requirement for old plans.
// ============================================================================

type DescendingMainAdmission
  = DescendingMainAdmitted { checkout: String, plan_revision: String }
  | DescendingMainNotDescendant { checkout: String, plan_revision: String, merge_base: String }
  | DescendingMainTouchesClosure { checkout: String, plan_revision: String, offending_path: String }
  | DescendingMainClosureAbsent { plan_revision: String }
  | DescendingMainClosureMisattributed { expected_entry: String, recorded_entry: String }

// THE ENTRY THE PLAN CLI IS BUILT FROM: recorded in the receipt alongside the closure so admission
// can re-verify the closure was computed from this entry (not hand-typed or from a different entry).
data plan_cli_entry_path: String = "dag/gunbc/fleet/fleet_converge_plan_cli.dag"
data plan_cli_pool_roots: List<String> = ["dag", "src/v2"]

// THE PURE DECISION. Given the merge base and changed paths (observed externally), decide whether
// the apply at M is safe. The fast path (M == P) short-circuits to Admitted with no further checks.
//
// RE-VERIFICATION: before trusting the closure, confirm that the receipt's recorded entry_path and
// pool_roots match what we expect the plan CLI's entry and pool roots to be. A receipt with an
// empty closure or a closure attributed to a different entry cannot admit.
fn admit_descending_main(
  checkout: String,
  plan_revision: String,
  merge_base: String,
  changed_paths: List<String>,
  source_closure: List<String>,
  source_closure_entry_path: String,
  source_closure_pool_roots: List<String>,
) -> DescendingMainAdmission {
  if checkout == plan_revision {
    DescendingMainAdmitted { checkout: checkout, plan_revision: plan_revision }
  } else if source_closure_entry_path != plan_cli_entry_path {
    DescendingMainClosureMisattributed {
      expected_entry: plan_cli_entry_path,
      recorded_entry: source_closure_entry_path,
    }
  } else if !pool_roots_match(recorded: source_closure_pool_roots, expected: plan_cli_pool_roots) {
    DescendingMainClosureMisattributed {
      expected_entry: plan_cli_entry_path,
      recorded_entry: source_closure_entry_path,
    }
  } else if is_empty(xs: source_closure) {
    DescendingMainClosureAbsent { plan_revision: plan_revision }
  } else if merge_base != plan_revision {
    DescendingMainNotDescendant { checkout: checkout, plan_revision: plan_revision, merge_base: merge_base }
  } else {
    match first_touched_closure_path(paths: changed_paths, closure: source_closure) {
      AbsentString => DescendingMainAdmitted { checkout: checkout, plan_revision: plan_revision }
      PresentString(p) => DescendingMainTouchesClosure {
        checkout: checkout,
        plan_revision: plan_revision,
        offending_path: p,
      }
    }
  }
}

// THE INTERSECTION TEST. For each changed path, check whether it matches any closure path using
// v2.lens.module_graph path_matches_touched (the model's own vocabulary for "does this change touch
// the closure"). Returns the first offending changed path if any match; returns the no-match
// sentinel if none do.
fn first_touched_closure_path(paths: List<String>, closure: List<String>) -> StringOption {
  fold_list(
    xs: paths,
    empty: AbsentString as StringOption,
    cons: fn(acc: StringOption, path: String) -> StringOption {
      match acc {
        PresentString(_) => acc
        AbsentString => {
          if closure_contains_path(closure: closure, path: path) {
            PresentString(v: path)
          } else {
            AbsentString
          }
        }
      }
    },
  )
}

// fold over the closure list checking whether any closure entry matches the touched path.
fn closure_contains_path(closure: List<String>, path: String) -> Bool {
  fold_list(
    xs: closure,
    empty: false,
    cons: fn(acc: Bool, c: String) -> Bool {
      if acc { true } else { path_matches_touched(closure_path: c, touched_path: path) }
    },
  )
}

// pool_roots_match compares two List<String> by set membership (same elements, order-independent).
fn pool_roots_match(recorded: List<String>, expected: List<String>) -> Bool {
  let all_expected_in_recorded = fold_list(
    xs: expected,
    empty: true,
    cons: fn(acc: Bool, e: String) -> Bool {
      if !acc { false } else { contains(xs: recorded, item: e, eq: string_eq) }
    },
  )
  let all_recorded_in_expected = fold_list(
    xs: recorded,
    empty: true,
    cons: fn(acc: Bool, r: String) -> Bool {
      if !acc { false } else { contains(xs: expected, item: r, eq: string_eq) }
    },
  )
  all_expected_in_recorded && all_recorded_in_expected
}

fn string_eq(a: String, b: String) -> Bool {
  a == b
}

// StringOption sentinel for the first-touched-path fold result.
type StringOption
  = PresentString { v: String }
  | AbsentString
