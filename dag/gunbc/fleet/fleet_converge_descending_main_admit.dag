module gunbc.fleet.fleet_converge_descending_main_admit

import std.types { String, Bool, List }
import v2.std.text { string_eq }
import std.algebra { Cons, Empty, FreeMonoid, contains, fold_list, is_empty }
import std.optional { Optional, Present, Absent }
import v2.lens.module_graph { path_matches_touched }
import gunbc.fleet.fleet_converge_receipt { FleetConvergePlanSourceClosure }

// ============================================================================
// DESCENDING-MAIN APPLY ADMISSION
//
// WHAT THIS DECIDES. At apply time the plan-revision job runs at the dispatch's event sha M while
// the plan was made at revision P. Today admission admits only when M == P (a pointer admission
// refuses M != P by name). This module extends admission: when M != P, the apply is admitted
// exactly when M DESCENDS from P (P is an ancestor of M, proven by git merge-base) AND the diff
// P..M touches NOTHING in the plan's source closure (the transitive import set of the plan CLI's
// entry module, computed at plan-production time via import_closure_live and recorded in the plan
// receipt by the plan CLI's receipt constructor).
//
// THE ENTRY AND POOL ROOTS ARE DERIVED, not hand-typed. The consumer derives them from the plan
// CLI's CI target module field and witness_layer_roots (the existing authority in
// gunbc.ci.ci_layer_roots). This module takes them as parameters to admit_descending_main.
//
// WHAT THIS MODULE DOES NOT DO. It does not perform IO: the caller observes the merge base and the
// changed-path list through extdeps.git (git.Inspect.MergeBase, git.Core.DiffNameOnlyMerge) and
// passes them here. It does not weaken any existing refusal: when M == P the existing path admits
// exactly as before. When the receipt carries no source_closure (a plan made before this field
// existed), this module refuses the descending case, preserving the strict M == P requirement.
// ============================================================================

type DescendingMainAdmission
  = DescendingMainAdmitted { checkout: String, plan_revision: String }
  | DescendingMainNotDescendant { checkout: String, plan_revision: String, merge_base: String }
  | DescendingMainTouchesClosure { checkout: String, plan_revision: String, offending_path: String }
  | DescendingMainClosureAbsent { plan_revision: String }
  | DescendingMainClosureEmpty { plan_revision: String }
  | DescendingMainEntryMismatch { expected: String, recorded: String }
  | DescendingMainPoolRootsMismatch { expected: String, recorded: String }

// THE PURE DECISION. Given the merge base and changed paths (observed externally by the caller
// through extdeps.git), and the expected entry path and pool roots (derived by the caller from the
// plan CI target and witness_layer_roots), decide whether the apply may reuse the plan while the
// dispatch names a later main tip. The fast path (M == P) short-circuits to Admitted.
//
// THE RECORDED TRIPLE IS TYPED, NOT SENTINEL-BACKED: the receipt's members arrive as Optional, so
// "never recorded" (Absent, a v1 receipt) is distinct from "recorded empty" (Present([])), and each
// refuses on its own arm. A closure recorded without its attribution never reaches this decision at
// all: the receipt's typed Optional members refuse at the decoder (FleetConvergePlanReceiptUnreadable),
// because the attribution is what ties the closure to the entry module it was computed from.
//
// RE-VERIFICATION: before trusting the closure, confirm the recorded entry path and pool roots match
// the derived expectations, each mismatch on its own variant. The receipt's own identity covers
// these fields (fleet-converge-plan-receipt/v2), so tampering is refused before this decision runs;
// this re-verification is the second, independent check that the closure is the one the plan CLI's
// entry would produce today.
fn admit_descending_main(
  checkout: String,
  plan_revision: String,
  merge_base: String,
  changed_paths: List<String>,
  source_closure: Optional<FleetConvergePlanSourceClosure>,
  expected_entry_path: String,
  expected_pool_roots: List<String>,
) -> DescendingMainAdmission {
  if checkout == plan_revision {
    DescendingMainAdmitted { checkout: checkout, plan_revision: plan_revision }
  } else {
    match source_closure {
      Absent =>
        // A receipt that never recorded a closure (minted before this field existed) cannot support
        // the descending case: the strict M == P requirement stands, refusal text unchanged.
        DescendingMainClosureAbsent { plan_revision: plan_revision }
      Present { value: c } =>
        if is_empty(xs: c.paths) {
          // Recorded-empty is a materially different case from never-recorded: a real import
          // closure of a real module is never empty, so this receipt is not one.
          DescendingMainClosureEmpty { plan_revision: plan_revision }
        } else if c.entry_path != expected_entry_path {
          DescendingMainEntryMismatch { expected: expected_entry_path, recorded: c.entry_path }
        } else if !pool_roots_match(recorded: c.pool_roots, expected: expected_pool_roots) {
          DescendingMainPoolRootsMismatch {
            expected: pool_roots_wire(xs: expected_pool_roots),
            recorded: pool_roots_wire(xs: c.pool_roots),
          }
        } else if merge_base != plan_revision {
          DescendingMainNotDescendant { checkout: checkout, plan_revision: plan_revision, merge_base: merge_base }
        } else {
          match first_touched_closure_path(paths: changed_paths, closure: c.paths) {
            Absent => DescendingMainAdmitted { checkout: checkout, plan_revision: plan_revision }
            Present { value: p } => DescendingMainTouchesClosure {
              checkout: checkout,
              plan_revision: plan_revision,
              offending_path: p,
            }
          }
        }
    }
  }
}

// THE INTERSECTION TEST. For each changed path, check whether it matches any closure path using
// v2.lens.module_graph path_matches_touched. Returns the first offending path, or Absent.
fn first_touched_closure_path(paths: List<String>, closure: List<String>) -> Optional<String> {
  fold_list(
    xs: paths,
    empty: Absent,
    cons: fn(acc, path) {
      match acc {
        Present { value: _ } => acc
        Absent => {
          if closure_contains_path(closure: closure, path: path) {
            Present { value: path }
          } else {
            Absent
          }
        }
      }
    },
  )
}

// fold over the closure list checking whether any closure entry matches the touched path.
fn closure_contains_path(closure: List<String>, path: String) -> Bool {
  fold_list(
    xs: closure,
    empty: false,
    cons: fn(acc, c) {
      if acc { true } else { path_matches_touched(closure_path: c, touched_path: path) }
    },
  )
}

// pool_roots_match compares two List<String> by set membership (same elements, order-independent).
fn pool_roots_match(recorded: List<String>, expected: List<String>) -> Bool {
  let all_expected_in_recorded = fold_list(
    xs: expected,
    empty: true,
    cons: fn(acc, e) {
      if !acc { false } else { contains(xs: recorded, item: e, eq: string_eq) }
    },
  )
  let all_recorded_in_expected = fold_list(
    xs: recorded,
    empty: true,
    cons: fn(acc, r) {
      if !acc { false } else { contains(xs: expected, item: r, eq: string_eq) }
    },
  )
  all_expected_in_recorded && all_recorded_in_expected
}


// Render pool roots for an error message.
fn pool_roots_wire(xs: List<String>) -> String {
  fold_list(
    xs: xs,
    empty: "",
    cons: fn(acc, r) {
      if acc == "" { r } else { join([acc, ",", r], "") }
    },
  )
}
