  AwsCliRead, AwsCliReadOk, AwsCliReadRefused, AwsS3PrefixCensus,
  aws_cli_get_caller_identity, aws_cli_read_account, aws_cli_describe_default_vpcs, aws_cli_read_vpc_ids,
  aws_cli_describe_security_group_named, aws_cli_read_security_group_ids, aws_cli_create_security_group, aws_cli_read_group_id,
  aws_cli_authorize_ingress_tcp, aws_cli_duplicate_permission,
  aws_cli_create_queue, aws_cli_get_queue_url, aws_cli_read_queue_url, aws_cli_get_queue_arn, aws_cli_read_queue_arn, aws_cli_set_queue_attributes,
  aws_cli_put_rule, aws_cli_read_rule_arn, aws_cli_put_target, aws_cli_read_put_targets,
  aws_cli_head_bucket, aws_cli_bucket_absent, aws_cli_create_bucket, aws_cli_block_public_access, aws_cli_put_bucket_tagging,
