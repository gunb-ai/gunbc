module gunbc.fleet.fleet_plan_apply_ci_step

// THE CI RUN-STEP LEAF OF THE FLEET PLAN/APPLY DOMAIN: the `gunbc run` target, invoke and
// mode-only preludes of the fleet-converge plan, apply, plan-revision, checkout-verify and
// run-pointer admission steps, beside the domain whose entry modules they invoke
// (gunbc.fleet.fleet_converge_plan_cli, gunbc.fleet.fleet_converge_plan_revision). The shared
// run-step machinery is v2.workflow.gunbc_invoke_step_emit, gunbc.ci.ci_layer_roots and
// gunbc.ci.ci_run_step_target; the roster that joins every step target stays in
// gunbc.ci.ci_spec, which imports these targets. A step module imports the shared machinery,
// never ci_spec.

import std.types { List, String }
import std.dissolution { DissolutionCondition, unbound_dissolution }
import v2.std.orchestration { Do, PipelineStep }
import v2.workflow.gunbc_invoke_step_emit {
  gunbc_run_step_script_for_target,
  gunbc_run_step_script_with_prelude_for_target,
}
import gunbc.ci.ci_run_step_target {
  gunbc_run_step_target,
  GunbcRunStepTarget,
}
import gunbc.ci.ci_layer_roots { witness_layer_roots }
import gunbc.ci.ci_retry { ci_retry_body_run }

data gunbc_ci_fleet_converge_plan_target: GunbcRunStepTarget = gunbc_run_step_target(
  module: "gunbc.fleet.fleet_converge_plan_cli",
  function: "fleet_converge_plan_wet",
)

data gunbc_ci_fleet_converge_launch_environment_plan_target: GunbcRunStepTarget = gunbc_run_step_target(
