data gunbc_ci_fleet_converge_plan_artifact_hash_env_name: String = "EXPECTED_HASH"

fn gunbc_ci_fleet_converge_apply_plan_hash_prelude() -> List<PipelineStep> {
  [
    Do { run: ci_retry_body_run(command: "set -euo pipefail") },
    Do { run: ci_retry_body_run(command: "ACTUAL=\"$(cat \"$\{GUNBC_FLEET_CONVERGE_PLAN_ANCHOR\}/plan_content.hex\")\"") },
    Do {
      run: ci_retry_body_run(
        command: "if [ -z \"$\{EXPECTED_HASH:-\}\" ] || [ \"$EXPECTED_HASH\" != \"$ACTUAL\" ]; then echo \"::error::PlanArtifactHashMismatch expected=$EXPECTED_HASH actual=$ACTUAL\" >&2; exit 1; fi"
      )
    }
  ]
}

