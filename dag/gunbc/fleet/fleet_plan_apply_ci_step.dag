// THE RUN POINTER ADMISSIONS (gunbc.fleet.fleet_converge_plan_revision). Each admits what a
// hand-typed predecessor run id NAMES -- that run exists, is a completed successful dispatch of
// THIS workflow, and carries the artifact about to be downloaded -- before actions/download-artifact
// is the first thing to touch the pointer. Refusing by name is the whole step.
data gunbc_ci_admit_plan_run_pointer_target: GunbcRunStepTarget = gunbc_run_step_target(
  module: "gunbc.fleet.fleet_converge_plan_revision",
  function: "admit_plan_run_pointer",
)

data gunbc_ci_admit_apply_run_pointer_target: GunbcRunStepTarget = gunbc_run_step_target(
  module: "gunbc.fleet.fleet_converge_plan_revision",
  function: "admit_apply_run_pointer",
)

// THE DISPATCH-INPUT FAIL-FAST. The four inputs the dashboard transaction will later refuse on
// (empty hash, malformed revision, malformed pointers) are refused HERE, in seconds, instead of
// after the pair build and the ten-minute fold resolve that paid them in runs 39177393512 and
// 36719161144. It asserts no truth the fold does not also assert; it only moves the same refusal
// earlier, where it is cheap.
data gunbc_ci_admit_dashboard_deploy_inputs_target: GunbcRunStepTarget = gunbc_run_step_target(
  module: "gunbc.fleet.fleet_converge_plan_revision",
  function: "admit_dashboard_deploy_dispatch_inputs",
)

// THE FLEET-TIMER SELF-INSTALL WIRE IS DELETED (2026-08-18). It emitted a GitHub Actions `run:`
// step invoking `gunbc.fleet_converge_timer_install fleet_timer_self_install_wet`, and its own
// comment recorded that the step existed because the self-install route otherwise "had zero
// callers, a disconnected mechanism". That step lived in `ci.yml`, which #8283 deleted, so the wire
// returned to being exactly the disconnected mechanism it was added to prevent: at deletion,
// `gunbc_ci_fleet_timer_install_invoke` had no consumer but the `DeclarationRef` inside its own
// `Scaffold` row, and `fleet_timer_self_install` appears in neither surviving workflow.
//
// Its registered `Scaffold` and unbound `DissolutionCondition` go with it. Both described a
// concat-built foreign-executor shell awaiting bash-emit; deleting the emitter discharges the
// obligation instead of carrying it, and an unbound condition whose subject no longer exists can
// never report itself fired.
fn gunbc_ci_fleet_converge_plan_invoke() -> String {
  gunbc_run_step_script_for_target(
    source_roots: witness_layer_roots,
    target: gunbc_ci_fleet_converge_plan_target,
    claim_run: false,
    receipt_rel: none
  )
}

fn gunbc_ci_fleet_converge_launch_environment_plan_invoke() -> String {
