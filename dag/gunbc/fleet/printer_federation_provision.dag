module gunbc.fleet.printer_federation_provision

import std.types { List }
import gunbc.auth.heal_publisher_provision { DedicatedFederation }
import gunbc.auth.gcp_secret_access { secret_accessor_grant }
import gunbc.auth.github_gcp_federation { federated_service_account_member }
import gunbc.fleet_printer_access { printer_access_code_loci }
import gunbc.fleet.printer_federation {
  printer_wif_pool_id, printer_wif_provider_id, printer_attribute_mapping,
  printer_attribute_condition, printer_principal_set, printer_service_account,
}

// Desired IAM state for the shared ntfy-approved estate converge. No secret create,
// version write, deletion or policy-write permission is granted to the print worker.
fn printer_dedicated_federation() -> DedicatedFederation {
  DedicatedFederation {
    label: "Printer LAN credential reader",
    pool_id: printer_wif_pool_id,
    pool_display_name: "Printer LAN",
    provider_id: printer_wif_provider_id,
    attribute_mapping: printer_attribute_mapping,
    attribute_condition: printer_attribute_condition(),
    principal_set: printer_principal_set(),
    service_account: printer_service_account,
    service_account_id: "printer-lan",
    service_account_display_name: "Printer LAN credential reader",
    service_account_member: federated_service_account_member(email: printer_service_account),
    secret_grants: map(printer_access_code_loci, locus => secret_accessor_grant(target: locus.secret)),
  }
}
