module gunbc.fleet.printer_credential_source

import std.types { String, NonEmptyStr, Bool, Secret }
import std.algebra { trim }
import extdeps.filesystem.filesystem_io { Filesystem, FilesystemReadOutcome, FilesystemReadRefused, FilesystemReadSucceeded, filesystem_read_outcome }
import extdeps.languages.json.emit { json_object, json_kv, json_string, serialize_json }
import extdeps.languages.json.parse { parse_json_document, JsonDocumentParsed, JsonDocumentUnreadable, json_field_string, FieldRead, FieldAbsent, FieldMalformed }
import extdeps.cloud.gcp.secret_manager {
  SmResolvedVersionIdentity, decode_sm_resolved_version_identity_wire,
  SmResolvedVersionIdentityDecoded, SmResolvedVersionIdentityDecodeRefused,
}
import extdeps.cloud.gcp.secret_manager { sm_resolved_version_id, SmVersionIdProjected, SmVersionIdNotAVersionResource }
import gunbc.auth.access_token_source { AccessTokenSource }
import gunbc.auth.federated_workload_credential { FederatedWorkloadCredentialMint }
import product.placement_supply { PhysicalAssetIdentity }

// WHERE THE PRINTER LAN ACCESS CODE COMES FROM, A SELECTION AND NOT A TOKEN (operator rulings
// 2026-11-05, gunbc.design_ruling printer_credential_is_held_in_host_custody). The workflow route reads
// Secret Manager under a workload-identity token. The shell route (gunbc.fleet.printer_shell_run)
// reads the host custody copy on srv1 and holds no Google identity at all. A custody read is NOT an
// AccessTokenSource arm: nothing in it is a bearer token, and widening that coproduct would make a file
// read pass as one (a meaning fork, @ref(gunbc.design_argument::single_authority)).
// MintAtUseCredentialSource is a third arm for the workflow route: it carries no token, only the mint
// parameters for the three-legged federation. The mint fires at the call site (after the operator's tap),
// so the token's clock starts when the token is used, not before the 4h wait. It is not an AccessTokenSource
// arm because an AccessTokenSource is a source of a token that already exists; MintAtUse is an instruction to
// mint a fresh one each time, and its arms differ in who owns the identity, not what token is held
// (@ref(gunbc.design_argument::single_authority)).
type PrinterCredentialSource
  = SecretManagerCredentialSource { token_source: AccessTokenSource }
  | MintAtUseCredentialSource { mint: FederatedWorkloadCredentialMint }
  | HostCustodyCredentialSource { run_id: String }

// THE GOOGLE ARMS, AS A TYPE OF THEIR OWN (review gunb-ai/gunbc#16325, 94058: a resolver over the
// full coproduct must either answer HostCustody with an unreachable refusal or lean on a wildcard,
// and both weaken the dispatch). The two Google arms -- a token already held, and an instruction to
// mint one at use -- are one type; a HostCustody source reaching the Google resolver is a TYPE
// ERROR, not a runtime arm. Call sites dispatch on PrinterCredentialSource exhaustively (three
// arms, no wildcard): custody to the custody reader, either Google arm wrapped into this type and
// handed to gunbc.fleet.printer_mint_at_use resolve_printer_google_token. Behaviour-neutral: the
// same two arms resolve exactly as before; only the illegible fourth case is removed.
type GooglePrinterCredentialSource
  = PrinterGoogleTokenSource { token_source: AccessTokenSource }
  | PrinterGoogleMintAtUse { mint: FederatedWorkloadCredentialMint }

// The directory the custody converge places the printer records in (gunbc.fleet.host_credential_custody_converge
// rows Printer01AccessCode and Printer02AccessCode): root:gunbc-fleet, so only the print runner principal
// that already owns the printer state reads them.
data printer_custody_directory: NonEmptyStr = "/etc/gunbc-printer-credentials" as NonEmptyStr

fn printer_custody_path(printer: PhysicalAssetIdentity) -> NonEmptyStr {
  join([printer_custody_directory as String, "/", printer as String, ".json"], "") as NonEmptyStr
}

// THE CUSTODY RECORD IS {code, sm_resolved}. The approval subject binds the credential VERSION
// (gunbc.fleet.printer_actuation print_subject), and a bare code has none, so the copy records the
// Secret Manager version resource it was read at; the version the operator approves is that version.
fn printer_custody_record_text(code: String, resolved: String) -> String {
  serialize_json(v: json_object(members: [
    json_kv(key: "code", value: json_string(s: code)),
    json_kv(key: "sm_resolved", value: json_string(s: resolved)),
  ]))
}

type PrinterCustodyRecord {
  code: Secret
  resolved: SmResolvedVersionIdentity
}

type PrinterCustodyRead
  = PrinterCustodyPresent { record: PrinterCustodyRecord }
  | PrinterCustodyRefused { path: String, cause: String }

fn parse_printer_custody_record(path: String, text: String) -> PrinterCustodyRead {
  match parse_json_document(s: text) {
    JsonDocumentUnreadable { gap: _ } => PrinterCustodyRefused { path: path, cause: "the custody record is not JSON" }
    JsonDocumentParsed { value: root } =>
      match json_field_string(obj: root, key: "code") {
        FieldAbsent => PrinterCustodyRefused { path: path, cause: "the custody record has no code" }
        FieldMalformed { cause: c } => PrinterCustodyRefused { path: path, cause: c }
        FieldRead { value: code } =>
          if trim(s: code) == "" { PrinterCustodyRefused { path: path, cause: "the custody record's code is empty" } } else {
            match json_field_string(obj: root, key: "sm_resolved") {
              FieldAbsent => PrinterCustodyRefused { path: path, cause: "the custody record names no credential version" }
              FieldMalformed { cause: c } => PrinterCustodyRefused { path: path, cause: c }
              FieldRead { value: resolved } =>
                match decode_sm_resolved_version_identity_wire(name: resolved) {
                  SmResolvedVersionIdentityDecodeRefused { cause: _ } => PrinterCustodyRefused { path: path, cause: "the custody record's credential version is not a version resource" }
                  SmResolvedVersionIdentityDecoded { identity: i } => PrinterCustodyPresent { record: PrinterCustodyRecord { code: code as Secret, resolved: i } }
                }
            }
          }
      }
  }
}

// THE ONE SPELLING of a custody refusal, shared by the converge, workflow and access routes.
fn printer_custody_refusal_cause(path: String, cause: String) -> String {
  join(["PrinterCustodyAbsent: ", path, " ", cause], "")
}

// A custody that is absent or unreadable refuses with a typed cause naming the path; nothing falls
// back to Secret Manager, because the shell route has no Google identity to fall back with.
fn read_printer_custody(printer: PhysicalAssetIdentity) -> PrinterCustodyRead {
  let path = printer_custody_path(printer: printer) as String
  let read = Filesystem.Read(path: path)
  match filesystem_read_outcome(content: read.content, success: read.success, error: read.error) {
    FilesystemReadRefused { error: e } => PrinterCustodyRefused { path: path, cause: concat("custody record unreadable (the one-time copy by fleet-converge custody has not placed it, or this principal cannot read it): ", e) }
    FilesystemReadSucceeded { content: c } => parse_printer_custody_record(path: path, text: c)
  }
}

// THE ONE READ OF THE VERSION THE CUSTODY COPY WAS TAKEN AT, shared by the converge, observe and session
// routes: custody read, then the version projected from the recorded resource, each failure with one
// spelling. The version is the non-empty id a signed approval subject binds.
type PrinterCustodyVersionRead
  = PrinterCustodyVersionPresent { version: NonEmptyStr, record: PrinterCustodyRecord }
  | PrinterCustodyVersionRefused { cause: String }

fn read_printer_custody_version(printer: PhysicalAssetIdentity) -> PrinterCustodyVersionRead {
  match read_printer_custody(printer: printer) {
    PrinterCustodyRefused { path: p, cause: c } => PrinterCustodyVersionRefused { cause: printer_custody_refusal_cause(path: p, cause: c) }
    PrinterCustodyPresent { record: r } => match sm_resolved_version_id(identity: r.resolved) {
      SmVersionIdProjected { version: v } => PrinterCustodyVersionPresent { version: v, record: r }
      SmVersionIdNotAVersionResource { supplied: _ } => PrinterCustodyVersionRefused { cause: "The custody record's credential version is not a version resource" }
    }
  }
}
