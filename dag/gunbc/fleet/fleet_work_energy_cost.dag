module gunbc.fleet.fleet_work_energy_cost

import std.types { NonEmptyStr, Bool, Int, List }
import std.nat { Nat }
import std.measure {
  Watt, watt_count, Second, second_count, Hertz,
  MoneyAmountMicro, MoneyPerKilowattHour,
  money_amount_micro, money_amount_micro_count, money_per_kilowatt_hour_micros,
}
import std.dissolution { DissolutionCondition, unbound_dissolution }
import extdeps.currency.currency { Usd }
import extdeps.energy.con_edison { el1_marginal_volumetric_rate }
import extdeps.cpu.ampere { altra_max_m12830_catalog }
import gunbc.fleet.fleet_host_power {
  HostPowerProfile, PowerProvenance, MeasuredOnHost, InferredFromSimilarBuild,
  host_power_profile, power_is_measured,
  confounded_host_power_readings, host_figure_is_still_inferred,
}
// THE CAP STATE A POWER FIGURE HAS TO BE ATTRIBUTABLE TO. Read here rather than restated: the watts a host drew
// mean nothing until the state it was drawn under is known, and the two caps that state consists of -- the GPU
// power cap and the CPU frequency ceiling -- are owned elsewhere. The frequency ceiling's standing is the load-
// bearing one: the operator applied 2.0 GHz on 2026-11-24 and what became of it that day is reported in two
// directions, so this module has to price work on a host whose clock it cannot name. It does so by CARRYING that
// gap on the cost instead of answering the question either way.
import gunbc.fleet.cpu_freq_cap_boot_state {
  CpuFreqCapMechanism, CeilingStands, CeilingSuperseded, CeilingStandingUnsaid,
  cpu_freq_cap_mechanisms_on, cpu_freq_cap_applied_on,
  cpu_freq_cap_standing_discharge_read, cpu_freq_ceiling_standing_read,
  ceiling_sits_below_the_parts_nominal_clock,
}
import gunbc.fleet.fleet_host_assembly { host_installed_components }
import product.placement_supply { PhysicalAssetIdentity, physical_asset_identity_eq }
import product.host_identity { HostIdentity }
import std.list { list_cover }

// THE MARGINAL ENERGY COST OF RUNNING WORK ON OWNED HARDWARE.
//
//     micro-USD  =  watts x seconds x (micro-USD per kWh) / 3_600_000
//
// The divisor converts watt-seconds to kilowatt-hours: 1 kWh = 1000 W x 3600 s = 3.6e6 W.s. The
// arithmetic is integer throughout because MoneyAmountMicro is Nat-denominated, so the result
// TRUNCATES -- a sub-micro-dollar remainder is dropped, which for a short job is most of the
// figure. That direction is stated on the carrier rather than left for a reader to discover: this
// derivation UNDERSTATES cost, and it understates it most for the cheapest work.
//
// WHY THIS IS MARGINAL AND NOT TOTAL. con_edison.el1_marginal_volumetric_rate deliberately excludes
// the fixed monthly service charge, because that charge is paid whether or not a job runs and
// pricing a decision-invariant cost into a decision is the same error as amortizing sunk capacity
// rent per job. The operator's framing was exactly this: the servers' capacity cost is already
// committed, so what a job actually costs at the margin is the electricity it causes to be burned.
//
// WHAT THIS IS NOT. It is not the cost of the job to the business (that would include the committed
// capacity, the network, the operator's time), and it is not a price. It is one input a supplier
// offer may quote against, and the fabric's selection layer owns what to do with it.

data watt_seconds_per_kilowatt_hour: Nat = 3600000

type EnergyCostBasis
  = MarginalEnergyOnly { rate: MoneyPerKilowattHour }

// The provenance of the POWER figure survives into the cost, because a cost derived from an
// inferred draw is itself inferred. A consumer that may not price work on an unmeasured host can
// refuse on this without re-deriving where the wattage came from.
type WorkEnergyCost {
  host: NonEmptyStr
  duration: Second
  draw: Watt
  amount: MoneyAmountMicro
  power_provenance: PowerProvenance
  // Whether the draw figure is attributable to the host's POWER STATE as this model has it -- the caps it runs
  // under and the clock its cores are held at. Distinct from `power_provenance`, which answers where the WATTAGE
  // came from: a figure can be first-hand measured on a host whose clock state is unread, and an inferred figure
  // can sit on a host whose state is fully known. Both answers are needed, so both are carried.
  power_state_attribution: DrawPowerStateAttribution
}

// THE GAP BETWEEN A DRAW FIGURE AND THE POWER STATE IT WAS TAKEN UNDER. A power figure is evidence only about the
// state it was read in: srv1's 94 W was read on a host with no GPU cap and its cores at the clock its part is
// rated to, and on srv3 and srv4 both of those have been changed by hand (a 30 W per-card GPU cap, and a CPU
// ceiling applied at 2.0 GHz whose standing the operator's own reports leave unsettled). Refusing to price would
// throw away the only draw figure the roster has; pricing without saying so bills a machine that is not the one
// that was measured. So the gap travels with the cost, typed, with the read that closes it.
type DrawAttributionGap
  = CpuCeilingNotReadHolding {
      host: NonEmptyStr
      // The unit holding the ceiling, so a reader can see WHICH mechanism is unanswered without this module
      // restating the cap module's rows.
      unit_path: NonEmptyStr
      applied_on: NonEmptyStr
      applied_ceiling: Hertz
      // The clock the installed part is catalogued to sustain, carried because a ceiling that had quietly risen
      // back to it would stop being a cap and this row would stop being a gap.
      parts_rated_clock: Hertz
      sits_below_the_parts_rated_clock: Bool
      // The one read that would make the figure attributable: the host's current CPU scaling limit, read and
      // recorded as standing. Carried from the row's own standing rather than authored here.
      what_would_make_it_attributable: NonEmptyStr
    }
  | HostFigureStillInferredWhilePowerStateMoved {
      host: NonEmptyStr
      // Whose figure is being carried, read off the profile's provenance.
      basis_host: NonEmptyStr
      // The confounded pair the operator read either side of the caps going in: when, and what else moved under
      // it. Both halves are needed by a reader deciding whether either number is usable.
      observed_on: NonEmptyStr
      confound: NonEmptyStr
    }

type DrawPowerStateAttribution
  = DrawAttributableToHostPowerState { host: NonEmptyStr }
  | DrawNotAttributableToHostPowerState { host: NonEmptyStr, gaps: List<DrawAttributionGap> }

// WHY A TYPED CAUSE. The old outcome carried a free-text reason; a refusal that only says "no profile"
// cannot tell a reader that the real gap is a MISSING MEASUREMENT on the host's current hardware.
// ReadingAppliesToSupersededAssembly is that typed cause: it names the measurement we need, so the gap is
// visible instead of being papered over with a plausible number -- a cap off a nameplate, a fleet average,
// or srv1's 2026-09-05 figure repriced against a machine that has since gained two accelerator boards and a
// new PSU.
type EnergyCostRefusal
  = NoPowerProfileDeclared { host: NonEmptyStr }
  | ReadingAppliesToSupersededAssembly {
      host: NonEmptyStr
      provenance: PowerProvenance
      measure_against: List<PhysicalAssetIdentity>
    }

type WorkEnergyCostOutcome
  = EnergyCostDerived { cost: WorkEnergyCost }
  | EnergyCostRefused { cause: EnergyCostRefusal }

fn marginal_energy_micros(draw: Watt, duration: Second) -> Nat {
  let watt_seconds = watt_count(w: draw) * second_count(s: duration)
  let rate_micros = money_per_kilowatt_hour_micros(q: el1_marginal_volumetric_rate())
  (watt_seconds * rate_micros) / watt_seconds_per_kilowatt_hour
}

// THE CLOCK GAP, IF THIS HOST HAS ONE. A mechanism whose standing is `CeilingStands` is a clock read holding on
// that host, and a figure taken under it is attributable; every other standing -- superseded, or the unsaid
// standing srv3 and srv4 carry -- leaves the host's clock unanswered, and no draw figure describes a machine whose
// clock nobody can name. The gap is built from the cap module's own row through its accessors, never from a copy
// of its fields, so promoting a standing cannot leave a stale sentence here.
fn cpu_ceiling_gap_for(m: CpuFreqCapMechanism, host: NonEmptyStr) -> DrawAttributionGap {
  let rated = altra_max_m12830_catalog.nominal_sustained_per_thread_hz
  CpuCeilingNotReadHolding {
    host: host,
    unit_path: m.unit_path,
    applied_on: cpu_freq_cap_applied_on(m: m),
    applied_ceiling: m.ceiling,
    parts_rated_clock: rated,
    sits_below_the_parts_rated_clock: ceiling_sits_below_the_parts_nominal_clock(m: m, nominal: rated),
    // The read the row already carries when the figure is unread; when a figure has landed by other means, the
    // standing itself still needs reading, which is the same obligation named on the cap module.
    what_would_make_it_attributable: match cpu_freq_cap_standing_discharge_read(m: m) {
      Present { value: owed } => owed
      Absent => cpu_freq_ceiling_standing_read,
    },
  }
}

fn cpu_ceiling_gap_on(host: NonEmptyStr) -> DrawAttributionGap? {
  match cpu_freq_cap_mechanisms_on(host: host as HostIdentity).first() {
    Absent => Absent
    Present { value: m } =>
      match m.standing {
        CeilingStands { applied_on: _ } => Absent
        CeilingSuperseded {
          applied_on: _, superseded_on: _, superseded_by: _, figure_standing_today: _, why: _,
        } => Present { value: cpu_ceiling_gap_for(m: m, host: host) }
        CeilingStandingUnsaid {
          applied_on: _, unsaid_because: _, competing_reports: _, figure_standing_today: _,
        } => Present { value: cpu_ceiling_gap_for(m: m, host: host) }
      }
  }
}

// THE WATTAGE GAP, IF THIS HOST HAS ONE. The operator's 2026-11-24 pair (srv4 101 W then 39-42 W, srv3 65 W then
// 29-31 W) moved together with the load, so neither half describes the capped machine at work; and those hosts'
// roster figure is still srv1's carried inference. Either fact alone leaves the other harmless -- a measured
// figure on a host whose load moved is still a measurement of something, and an inferred figure on a host whose
// state is known is what the roster says it is -- so both are required before this gap is claimed, and the basis
// is read off the profile rather than restated.
fn moved_power_state_gap_on(host: NonEmptyStr, profile: HostPowerProfile) -> DrawAttributionGap? {
  if host_figure_is_still_inferred(host: host) {
    match filter(confounded_host_power_readings, r => (r.host as String) == (host as String)).first() {
      Absent => Absent
      Present { value: r } =>
        match profile.provenance {
          InferredFromSimilarBuild { basis_host, basis_reason: _ } =>
            Present { value: HostFigureStillInferredWhilePowerStateMoved {
              host: host,
              basis_host: basis_host,
              observed_on: r.observed_on,
              confound: r.confound,
            } }
          // Unreachable through the guard above, and written out rather than defaulted: a measured profile has no
          // basis host to name, and inventing one here would be the fabrication this type refuses.
          MeasuredOnHost { sample_count: _, sensor: _, observed_on: _ } => Absent
        }
    }
  } else {
    Absent
  }
}

// THE ATTRIBUTION A COST CARRIES. Empty gaps is the model saying this host's power state is known well enough for
// its figure to describe it; one gap or two is the model pricing anyway and showing its work. Both halves are
// asked of every host rather than short-circuited, because a host can carry both -- srv3 and srv4 today do -- and
// a consumer deciding whether to quote against the figure needs to see both.
fn host_draw_power_state_attribution(host: NonEmptyStr, profile: HostPowerProfile) -> DrawPowerStateAttribution {
  let gaps = concat(
    match cpu_ceiling_gap_on(host: host) {
      Absent => []
      Present { value: g } => [g]
    },
    match moved_power_state_gap_on(host: host, profile: profile) {
      Absent => []
      Present { value: g } => [g]
    },
  )
  if gaps.length() == 0 {
    DrawAttributableToHostPowerState { host: host }
  } else {
    DrawNotAttributableToHostPowerState { host: host, gaps: gaps }
  }
}

// An unknown host REFUSES rather than defaulting to a fleet-average draw. A default here would be
// the absorbing fallback gunbc.design_argument::fail_closed names: it answers every question, including the ones
// about hosts nobody has modeled, and destroys the signal that a host is missing from the roster.
// THE BYPASS THIS REMOVES. Before this, a profile was selected by host name alone and priced: srv1's 94 W
// of 2026-09-05 billed work on a machine that has since gained two RTX PRO 6000 boards and a new PSU. The
// reading is not deleted -- it stays declared as history, still queryable via gunbc.fleet.fleet_host_power
// host_power_profile -- but it no longer silently prices a host it was not taken against.
//
// THE JOIN (#gunbc.design_argument::single_authority: consume the authority, do not restate it). The host's CURRENT installed components
// come from gunbc.fleet.fleet_host_assembly host_installed_components, which joins the assembly authority's
// own containment edges with the installed accelerator boards the physical inventory owns. A reading prices
// only while its declared configuration is covered by that current set (std.list list_cover is bidirectional
// set equality, so a missing unit OR a stale extra both break the match). Removing this join -- the whole
// integration -- must make the witness that srv1 now refuses go RED, not let the stale figure bill.
fn work_energy_cost(host: NonEmptyStr, duration: Second) -> WorkEnergyCostOutcome {
  match host_power_profile(host: host) {
    Absent => EnergyCostRefused { cause: NoPowerProfileDeclared { host: host } }
    Present { value } =>
      if list_cover(
        held: host_installed_components(host: host as HostIdentity),
        expected: value.applies_to,
        eq: physical_asset_identity_eq,
      ) {
        EnergyCostDerived {
          cost: WorkEnergyCost {
            host: host,
            duration: duration,
            draw: value.draw,
            amount: money_amount_micro(count: marginal_energy_micros(draw: value.draw, duration: duration)),
            power_provenance: value.provenance,
            power_state_attribution: host_draw_power_state_attribution(host: host, profile: value),
          }
        }
      } else {
        EnergyCostRefused { cause: superseded_reading_cause(host: host, provenance: value.provenance, current: host_installed_components(host: host as HostIdentity)) }
      }
  }
}

// THE CAUSE CARRIES WHAT THE MISSING MEASUREMENT MUST COVER, as data a consumer can act on: the reading's own
// PowerProvenance (a MeasuredOnHost date or an InferredFromSimilarBuild basis, typed, never a string whose
// meaning changes by branch) and measure_against, the host's CURRENT installed components -- the configuration
// a fresh MeasuredOnHost profile must be taken against, and so the applies_to it will carry. What kind of
// measurement is needed is the variant's own meaning (a sampled measured draw, never an inferred figure and
// never a configured power ceiling), so it is stated here and not repeated as a string in every refusal
// (review 91873; #gunbc.design_argument::minimize_redundancy).
fn superseded_reading_cause(host: NonEmptyStr, provenance: PowerProvenance, current: List<PhysicalAssetIdentity>) -> EnergyCostRefusal {
  ReadingAppliesToSupersededAssembly {
    host: host,
    provenance: provenance,
    measure_against: current,
  }
}

fn cost_rests_on_measured_power(c: WorkEnergyCost) -> Bool {
  match c.power_provenance {
    MeasuredOnHost { sample_count: _, sensor: _, observed_on: _ } => true
    InferredFromSimilarBuild { basis_host: _, basis_reason: _ } => false
  }
}

fn cost_micros(c: WorkEnergyCost) -> Nat {
  money_amount_micro_count(m: c.amount)
}

data whole_host_attribution_note: NonEmptyStr = "This charges a job the WHOLE host's draw for its duration, which is correct only when the job has the host to itself. srv1 runs eleven concurrent runner slots today, so eleven concurrent jobs would each be charged the full 94 W and the host would appear to cost eleven times what it draws. Fixing that needs either per-job power attribution (which the hwmon sensors cannot provide -- they meter the board, not the cgroup) or a declared concurrency divisor. Until one exists this figure is an UPPER bound per job and its sum across concurrent jobs is not a fleet total."

data cost_derivation_dissolution: DissolutionCondition = unbound_dissolution(
  description: "dissolve-on: an idle-versus-loaded draw pair exists for each host, making the true marginal delta derivable rather than the whole-host draw standing in for it, AND a concurrency divisor or per-cgroup attribution exists so concurrent jobs on one host do not each carry the full board draw. Both are named in whole_host_attribution_note and gunbc.fleet.fleet_host_power per_host_measurement_trigger; neither is discharged by measuring more hosts at one operating point."
)
