module gunbc.fleet.flex_pass_ci_step

// THE CI RUN-STEP LEAF OF THE FLEX PASS DOMAIN: the `gunbc run` target and invoke of the
// flex_pass step, beside the domain whose entry module it invokes
// (gunbc.fleet.flex_pass_run). The shared run-step machinery is
// v2.workflow.gunbc_invoke_step_emit, gunbc.ci.ci_layer_roots and
// gunbc.ci.ci_run_step_target; the roster stays in gunbc.ci.ci_spec, which imports the
// target. A step module imports the shared machinery, never ci_spec.

import std.types { String }
import v2.workflow.gunbc_invoke_step_emit { gunbc_run_step_script }
import gunbc.ci.ci_run_step_target { GunbcRunStepTarget }
import gunbc.ci.ci_layer_roots { witness_layer_roots }

data gunbc_ci_flex_pass_target: GunbcRunStepTarget = GunbcRunStepTarget {
  entry: "dag/gunbc/fleet/flex_pass_run.dag",
  function: "pass",
}

fn gunbc_ci_flex_pass_invoke() -> String {
  gunbc_run_step_script(
    source_roots: witness_layer_roots,
    entry: gunbc_ci_flex_pass_target.entry,
    function: gunbc_ci_flex_pass_target.function,
    claim_run: false,
    receipt_rel: none
  )
}
