module gunbc.fleet.host_credential_custody_roster

// THE HOST CREDENTIAL CUSTODY ROSTER: the DATA the custody layer declares -- which credential exists,
// at which host path, under which owner, with which mode, on which host, over which medium, owing which
// export receipt. This leaf is deliberately separate from gunbc.fleet.host_credential_custody_converge:
// the converge and install logic there reaches gunbc.live_deploy.apply_legs (via the host effect realize
// chain), so the deploy-artifact gate could not ask "does fleet custody declare this secret path?" without
// a cycle. The roster is pure data and reads only the credential/owner/host/secret constants it declares.
// Its one consumer for the gate is custody_roster_declares (gunbc.live_deploy.apply_legs, PR #16587).

import std.types { Bool, List, NonEmptyStr, String }
import extdeps.cloud.gcp.secret_ref { SecretRef }
import extdeps.posix.identity { PosixOwnerNames }
import product.host_identity { HostIdentity, host_identity_eq }
import gunbc.fabric.fabric_storage_state_policy { fabric_state_key_secret_ref }
import gunbc.fabric.fabric_storage_state_location { fabric_state_key_host_path }
import gunbc.worker_turn_snapshot_custody { claude_worker_turn_snapshot_custody, cursor_worker_turn_snapshot_custody, snapshot_custody_ownership }
import gunbc.auth.tracker_web_oauth_client { tracker_web_stage_oauth_client_secret_host_path, tracker_web_stage_oauth_client_secret_ref, tracker_web_test_oauth_client_secret_host_path, tracker_web_test_oauth_client_secret_ref }
import gunbc.flex_vast_credential { flex_vast_api_key_custody_host, flex_vast_api_key_host_path, flex_vast_api_key_secret_ref }
import gunbc.fleet.fleet_posix_accounts { fleet_posix_operator_user, fleet_posix_root_user }
import gunbc.fleet.fleet_host_identity { operator_host_mtcollins1, operator_host_srv1, operator_host_srv14 }
import gunbc.fleet.fleet_ssh_access { mtcollins1_ssh_host_key_secret }
import gunbc.codex_harness_credential { codex_auth_harness_secret_ref, codex_worker_turn_auth_host_path, codex_worker_turn_custody_host }
import gunbc.tailscale_fleet_auth_key { tailscale_fleet_auth_key_secret_ref, tailscale_fleet_auth_key_host_path }
import gunbc.auth.github_apps { gunbai_bot_app_pem_secret, gunbai_bot_host_signing_key, gunbai_ci_app_pem_secret }
import gunbc.oracle_oci.api { oci_api_signing_key, oci_api_signing_key_secret_ref }
import gunbc.secret_provision { secret_ref_pin_version }
import gunbc.fleet.printer_credential_source { printer_custody_path }
import gunbc.fleet.fleet_printer_access { printer_access_code_desired_ref }
import gunbc.fleet.fleet_asset_identity { printer_01, printer_02 }
import gunbc.fleet.printer_workflow_artifact { printer_state_group }
import product.placement_supply { PhysicalAssetIdentity }
import gunbc.managed_directory { DeclaredDirectoryMode, DirectoryOwnerAllGroupTraverse, DirectoryOwnerOnly }
import gunbc.auth.approval_apns_publish { approval_apns_auth_key, approval_apns_auth_key_secret_ref }
import gunbc.github_effect_perform { lifecycle_controller_app_key, service_slot_app_key }
import extdeps.auth.jws { HostKeyFile, JwsSigningKeyRef }
import gunbc.live_deploy.spec { gunbc_publication_principal_name }
import gunbc.runner.runner_unit_file { runner_host_app_pem_path }

// ── The closed roster (pure) ─────────────────────────────────────────────────────────────────────

// A CLOSED COPRODUCT, NOT A STRING. The dispatch input is a choice whose options are this roster's
// wire names, and the entry maps the chosen word back through the roster, so an unrostered word is
// a typed refusal and there is no free-text path to a SecretRef.
type HostCustodyCredential
  = ControllerAppKey
  | FabricStateWriterKey
  | CursorWorkerTurnApiKey
  | CodexWorkerTurnAuth
  | OracleOciApiSigningKey
  | ClaudeCodeOauthHarnessToken
  | TrackerWebTestOauthClientSecret
  | TrackerWebStageOauthClientSecret
  | GunbaiBotPublicationAppKey
  | FlexVastApiKey
  | ServiceSlotAppKey
  | Mtcollins1SshHostKey
  | ApprovalApnsAuthKey
  | Printer01AccessCode
  | Printer02AccessCode
  // The fleet's TAILSCALE ENROLLMENT credential: the reusable auth key that lets a converge bring a host
  // onto the tailnet without a human approving each device in a web console. It is a custody row and not a
  // temporary download because the placement needs the same guarantees every other row here carries -- the
  // path, the owner, the mode, and WHICH PINNED SECRET VERSION the file holds are decided by this ledger
  // rather than by whichever caller got there first -- and because the consequence of getting them wrong is
  // a fleet-wide reusable enrollment credential readable by an account that is not root. Its consumer is
  // gunbc.tailscale_join_converge; what the key IS (kind, tag, expiry) is gunbc.tailscale_fleet_auth_key,
  // and where the join's argv is built is extdeps.tailscale.join.
  | TailscaleFleetAuthKey

  // THE CI APP PEM THE RUNNER UNIT READS TO MINT ITS OWN REGISTRATION TOKEN. butch (srv14) only for
  // now: srv1-srv4 keep the ctrl-installed copy until each one's B3d listener cutover, which extends
  // this row's scope at its root (the scope is row DATA, not a per-host code path). The path datum is
  // the SAME one the slot unit's Environment= writes (runner_host_app_pem_path), so custody and
  // consumer cannot drift. EXTENDING the scope to a host must retire that host's other writer of the
  // same path: ctrl install-actions-runner.sh installs its own 0600 runner-user copy there, and srv1-
  // srv4 run it under ctrl's own deploy route (outside this model; the gunbc.runner.runner_host_deploy
  // argv builder that names CTRL_RUNNER_APP_PEM_SRC has no wet caller in this model -- only witnesses
  // consume it, and the ctrl citations there are void legacy pointers per
  // gunbc.runner.runner_lifecycle_ctrl_void_note). That cutover pairs with the wrapper's two-authority
  // concern (gunbc.integration_concern) at the same per-host motion.
  | RunnerCiAppPemKey

// The ledger's own enumeration of every credential it can vouch for. Both arms added by in-flight work
// -- TailscaleFleetAuthKey (tailscale join) and RunnerCiAppPemKey (runner token mint) -- are here; the
// custody witness's w_roster_covers_every_credential is what keeps a future arm from being minted
// without a row.
data host_custody_credential_roster: List<HostCustodyCredential> = [ControllerAppKey, FabricStateWriterKey, CursorWorkerTurnApiKey, CodexWorkerTurnAuth, OracleOciApiSigningKey, ClaudeCodeOauthHarnessToken, TrackerWebTestOauthClientSecret, TrackerWebStageOauthClientSecret, GunbaiBotPublicationAppKey, FlexVastApiKey, ServiceSlotAppKey, Mtcollins1SshHostKey, ApprovalApnsAuthKey, Printer01AccessCode, Printer02AccessCode, TailscaleFleetAuthKey, RunnerCiAppPemKey]

// THE FILE'S MODE ARM. Each arm derives the write mode, the exact-mode leg, the forbidden-bits leg,
// and whether it grants the group read -- four facts, one match each, no octal parameter anywhere.
type CustodyFileMode
  = CustodyFileOwnerRead
  | CustodyFileOwnerReadWrite
  | CustodyFileOwnerReadWriteGroupRead

// Principals by NAME (extdeps.posix.identity PosixOwnerNames), because find(1)'s -user/-group and
// chown(1) both take names and a service account's numeric ids are allocated per host
// (gunbc.fleet.fleet_posix_accounts), not declared.
type CustodyHostScope
  = CustodyAnyRunnerHost
  | CustodyOnlyOnHost { host: HostIdentity }

// WHETHER THIS ROW PUBLISHES A STORE-AUTHORITATIVE EXPORT RECEIPT. A field of the row, not a Bool
// predicate over HostCustodyCredential: a new roster variant must name the obligation or the row
// does not typecheck. Cursor and Claude owe one (snapshot take must join the generation). Codex
// does not (host-authoritative after placement). Other store-authoritative rows have no take that
// must join the generation.
type CustodyExportReceiptStanding
  = CustodyExportReceiptOwed
  | CustodyExportReceiptNotOwed

// WHAT BACKS THE PATH, AS A FACT OF THE ROW. A disk-backed row lives under the host's configuration tree
// (fleet_host_file_scope). A tmpfs-only row holds a secret that must never reach a disk (operator ruling
// gunbc.design_ruling mtcollins1_in_memory_app_credential_per_boot): it is placed only below the
// tmpfs mount root, so a path on the persistent filesystem is refused by custody_row_placement before
// anything is written, and the readback asks the host which filesystem holds the file
// (the mount holding it, read from /proc/self/mountinfo), so a bind mount or a remount that put the path
// back on disk is a refusal, never a held credential.
//
// TMPFS ALONE IS NOT THE MEDIUM, BECAUSE A TMPFS CAN SWAP. The ruling says in memory only, and tmpfs pages
// are written to swap under pressure; the only arm that holds a secret is a tmpfs mounted `noswap`
// (extdeps.linux.tmpfs, Linux 6.4+). The readback asks for that option, and a kernel without it reports
// none, so such a host REFUSES rather than admitting a swappable location from its version number.
type CustodyMedium
  = CustodyDiskBacked
  | CustodyTmpfsNoSwap

type HostCredentialCustodyRow {
  credential: HostCustodyCredential
  secret: SecretRef
  path: NonEmptyStr
  host_scope: CustodyHostScope
  file_ownership: PosixOwnerNames
  file_mode: CustodyFileMode
  dir_ownership: PosixOwnerNames
  dir_mode: DeclaredDirectoryMode
  export_receipt: CustodyExportReceiptStanding
  medium: CustodyMedium
}

// The controller key's path is the signer's own key reference (gunbc.github_effect_perform
// lifecycle_controller_app_key), never re-spelled; HostKeyFile is the only arm that names a file.
fn signing_key_file_path(key: JwsSigningKeyRef) -> NonEmptyStr {
  match key {
    HostKeyFile { path: p } => p
  }
}

data custody_root_only: PosixOwnerNames = PosixOwnerNames {
  user: fleet_posix_root_user.name,
  group: fleet_posix_root_user.name,
}

// THE FABRIC STATE KEY'S READER GROUP. The key was root:<operator> 0640, so reading it meant being
// the operator's group, and the deploy principal (the CI job user, ghrunner) got there by a hand
// `usermod -aG <operator> ghrunner` that made it a member of the service user's whole group. The key
// is now owned by a group that exists for it alone; custody_reader_set declares who is in it and the
// converge reads that membership back.
data fabric_state_key_reader_group: NonEmptyStr = "gunbc-fabric-state-key"

data gunbai_bot_publication_key_reader_group: NonEmptyStr = gunbc_publication_principal_name

data custody_root_owned_publication_key_group: PosixOwnerNames = PosixOwnerNames {
  user: fleet_posix_root_user.name,
  group: gunbai_bot_publication_key_reader_group,
}

data custody_root_owned_fabric_state_key_group: PosixOwnerNames = PosixOwnerNames {
  user: fleet_posix_root_user.name,
  group: fabric_state_key_reader_group,
}

// THE GROUP THAT EXISTS FOR THE RUNNER'S APP PEM ALONE (the fabric precedent: a dedicated group,
// membership declared and read back -- never an account's primary group, whose membership this
// converge would not own). Its one declared member is the listener account the scoped host's
// RunnerHostSpec names (gunbc_runner_listener_principal), asserted by a witness claim so the reader
// and the unit's User= cannot drift.
data runner_ci_app_key_reader_group: NonEmptyStr = "gunbc-runner-app-key"

data custody_root_owned_runner_app_key_group: PosixOwnerNames = PosixOwnerNames {
  user: fleet_posix_root_user.name,
  group: runner_ci_app_key_reader_group,
}

data custody_operator_only: PosixOwnerNames = PosixOwnerNames {
  user: fleet_posix_operator_user.name,
  group: fleet_posix_operator_user.name,
}

// THE WORKER-TURN CREDENTIALS. Cursor's key lives on srv2, the host the declared Cursor offer
// dispatches on. Codex remains operator-owned: its directory IS the turn's CODEX_HOME, so the
// harness must write auth.json, sessions and logs beneath it.

// OracleOciApiSigningKey signs every OCI request gunbc.oracle_oci.compartment_ensure makes, through
// the signer's own key reference, never re-spelled. It is delivered to srv1 only, root-owned and
// owner-read, because srv1 is where the OCI converge runs and nothing else signs with it.
fn host_credential_custody_row(c: HostCustodyCredential) -> HostCredentialCustodyRow {
  match c {
    FabricStateWriterKey => HostCredentialCustodyRow {
      credential: c, secret: fabric_state_key_secret_ref, path: fabric_state_key_host_path,
      host_scope: CustodyAnyRunnerHost,
      file_ownership: custody_root_owned_fabric_state_key_group,
      file_mode: CustodyFileOwnerReadWriteGroupRead,
      dir_ownership: custody_root_owned_fabric_state_key_group,
      dir_mode: DirectoryOwnerAllGroupTraverse,
      export_receipt: CustodyExportReceiptNotOwed,
      medium: CustodyDiskBacked,
    }

    ControllerAppKey => HostCredentialCustodyRow {
      credential: c,
      secret: gunbai_ci_app_pem_secret,
      path: signing_key_file_path(key: lifecycle_controller_app_key),
      host_scope: CustodyAnyRunnerHost,
      file_ownership: custody_root_only,
      file_mode: CustodyFileOwnerRead,
      dir_ownership: custody_root_only,
      dir_mode: DirectoryOwnerOnly,
      export_receipt: CustodyExportReceiptNotOwed,
      medium: CustodyDiskBacked,
    }
    CursorWorkerTurnApiKey => HostCredentialCustodyRow {
      credential: c,
      secret: cursor_worker_turn_snapshot_custody.secret,
      path: cursor_worker_turn_snapshot_custody.path,
      host_scope: CustodyOnlyOnHost { host: cursor_worker_turn_snapshot_custody.host },
      file_ownership: snapshot_custody_ownership(declaration: cursor_worker_turn_snapshot_custody),
      file_mode: CustodyFileOwnerReadWriteGroupRead,
      dir_ownership: snapshot_custody_ownership(declaration: cursor_worker_turn_snapshot_custody),
      dir_mode: DirectoryOwnerAllGroupTraverse,
      export_receipt: CustodyExportReceiptOwed,
      medium: CustodyDiskBacked,
    }
    CodexWorkerTurnAuth => HostCredentialCustodyRow {
      credential: c,
      secret: codex_auth_harness_secret_ref,
      path: codex_worker_turn_auth_host_path,
      host_scope: CustodyOnlyOnHost { host: codex_worker_turn_custody_host },
      file_ownership: custody_operator_only,
      file_mode: CustodyFileOwnerReadWrite,
      dir_ownership: custody_operator_only,
      dir_mode: DirectoryOwnerOnly,
      export_receipt: CustodyExportReceiptNotOwed,
      medium: CustodyDiskBacked,
    }
    OracleOciApiSigningKey => HostCredentialCustodyRow {
      credential: c,
      secret: oci_api_signing_key_secret_ref,
      path: signing_key_file_path(key: oci_api_signing_key),
      host_scope: CustodyOnlyOnHost { host: operator_host_srv1 },
      file_ownership: custody_root_only,
      file_mode: CustodyFileOwnerRead,
      dir_ownership: custody_root_only,
      dir_mode: DirectoryOwnerOnly,
      export_receipt: CustodyExportReceiptNotOwed,
      medium: CustodyDiskBacked,
    }
    ClaudeCodeOauthHarnessToken => HostCredentialCustodyRow {
      credential: c,
      secret: claude_worker_turn_snapshot_custody.secret,
      path: claude_worker_turn_snapshot_custody.path,
      host_scope: CustodyOnlyOnHost { host: claude_worker_turn_snapshot_custody.host },
      file_ownership: snapshot_custody_ownership(declaration: claude_worker_turn_snapshot_custody),
      file_mode: CustodyFileOwnerReadWriteGroupRead,
      dir_ownership: snapshot_custody_ownership(declaration: claude_worker_turn_snapshot_custody),
      dir_mode: DirectoryOwnerAllGroupTraverse,
      export_receipt: CustodyExportReceiptOwed,
      medium: CustodyDiskBacked,
    }
    TrackerWebTestOauthClientSecret => HostCredentialCustodyRow {
      credential: c,
      secret: tracker_web_test_oauth_client_secret_ref,
      path: tracker_web_test_oauth_client_secret_host_path,
      host_scope: CustodyOnlyOnHost { host: operator_host_srv1 },
      file_ownership: custody_operator_only,
      file_mode: CustodyFileOwnerRead,
      dir_ownership: custody_operator_only,
      dir_mode: DirectoryOwnerOnly,
      export_receipt: CustodyExportReceiptNotOwed,
      medium: CustodyDiskBacked,
    }
    TrackerWebStageOauthClientSecret => HostCredentialCustodyRow {
      credential: c,
      secret: tracker_web_stage_oauth_client_secret_ref,
      path: tracker_web_stage_oauth_client_secret_host_path,
      host_scope: CustodyOnlyOnHost { host: operator_host_srv1 },
      file_ownership: custody_operator_only,
      file_mode: CustodyFileOwnerRead,
      dir_ownership: custody_operator_only,
      dir_mode: DirectoryOwnerOnly,
      export_receipt: CustodyExportReceiptNotOwed,
      medium: CustodyDiskBacked,
    }
    GunbaiBotPublicationAppKey => HostCredentialCustodyRow {
      credential: c,
      secret: gunbai_bot_app_pem_secret,
      path: signing_key_file_path(key: gunbai_bot_host_signing_key),
      host_scope: CustodyOnlyOnHost { host: operator_host_srv1 },
      file_ownership: custody_root_owned_publication_key_group,
      file_mode: CustodyFileOwnerReadWriteGroupRead,
      dir_ownership: custody_root_owned_publication_key_group,
      dir_mode: DirectoryOwnerAllGroupTraverse,
      export_receipt: CustodyExportReceiptNotOwed,
      medium: CustodyDiskBacked,
    }
    TailscaleFleetAuthKey => HostCredentialCustodyRow {
      credential: c,
      secret: tailscale_fleet_auth_key_secret_ref,
      path: tailscale_fleet_auth_key_host_path,
      // Any enrolled host may be the one that needs joining, which is the entire point of a REUSABLE key;
      // naming the four hosts that need it today would make the fifth a code change, and the fifth is already
      // scheduled (the new H11SSL-i and srv15). The scope says which hosts MAY hold it, and the caller -- a
      // converge that has planned a join for exactly this host -- says which one does.
      host_scope: CustodyAnyRunnerHost,
      file_ownership: custody_root_only,
      file_mode: CustodyFileOwnerRead,
      dir_ownership: custody_root_only,
      dir_mode: DirectoryOwnerOnly,
      export_receipt: CustodyExportReceiptNotOwed,
      // Disk, deliberately, rather than the tmpfs-no-swap discipline the boot-time rows above use. The reason
      // is a fact about the join, not a relaxation: the daemon reads this file at the moment of `up`, which is
      // a run, not a boot, and the same host's own node key already lives root-only on that same disk under
      // /var/lib/tailscale. A row that refused every host without a 6.4+ noswap tmpfs would refuse to enroll
      // h11 -- the host that has never had the package at all -- which is the outcome this row exists to end.
      // The exposure that follows is what the row and the converge together declare, nothing more: root:root
      // 0400 under a 0700 directory WHILE A JOIN IS IN FLIGHT -- the converge's removal leg deletes this
      // path once the read-back proves membership (gunbc.tailscale_join_converge::
      // tailscale_join_remove_key_leg), reached by execution through the wet entry
      // tailscale_join_converge_ci_wet and the fleet workflow's tailscale_join_converge dispatch; and even
      // a copy left behind by an interrupted run carries no join power past the key's own 90-day expiry
      // (gunbc.tailscale_fleet_auth_key: an expired auth key "will not work after that date").
      medium: CustodyDiskBacked,
    }
    RunnerCiAppPemKey => HostCredentialCustodyRow {
      credential: c,
      secret: gunbai_ci_app_pem_secret,
      path: runner_host_app_pem_path,
      host_scope: CustodyOnlyOnHost { host: operator_host_srv14 },
      file_ownership: custody_root_owned_runner_app_key_group,
      file_mode: CustodyFileOwnerReadWriteGroupRead,
      dir_ownership: custody_root_owned_runner_app_key_group,
      dir_mode: DirectoryOwnerAllGroupTraverse,
      export_receipt: CustodyExportReceiptNotOwed,
      medium: CustodyDiskBacked,
    }
    FlexVastApiKey => HostCredentialCustodyRow {
      credential: c,
      secret: flex_vast_api_key_secret_ref,
      path: flex_vast_api_key_host_path,
      host_scope: CustodyOnlyOnHost { host: flex_vast_api_key_custody_host },
      file_ownership: custody_operator_only,
      file_mode: CustodyFileOwnerRead,
      dir_ownership: custody_operator_only,
      dir_mode: DirectoryOwnerOnly,
      export_receipt: CustodyExportReceiptNotOwed,
      medium: CustodyDiskBacked,
    }
    ServiceSlotAppKey => HostCredentialCustodyRow {
      credential: c,
      secret: gunbai_ci_app_pem_secret,
      path: signing_key_file_path(key: service_slot_app_key),
      host_scope: CustodyOnlyOnHost { host: operator_host_mtcollins1 },
      file_ownership: custody_root_only,
      file_mode: CustodyFileOwnerRead,
      dir_ownership: custody_root_only,
      dir_mode: DirectoryOwnerOnly,
      export_receipt: CustodyExportReceiptNotOwed,
      medium: CustodyTmpfsNoSwap,
    }
    // The stable host key's PRIVATE half, delivered to mtcollins1 in memory on every boot (operator
    // option A, 2026-10-22). Same discipline as the App credential row directly above — that is the
    // route this reuses, keyed on the credential arm rather than on the host: root:root 0400 under
    // /run (CustodyTmpfsNoSwap, so placement refuses any path outside the tmpfs scope and a swap
    // device refuses the row), never on disk across boot, never in argv, never logged, and its
    // export receipt is not owed because nothing mints an exportable artifact — the file IS the
    // delivery. THE TRUTH about the path: no boot route consumes it yet -- the RAM image has no sshd
    // in this slice ("no network or sshd exists in this slice", runner_host_first_boot_receipt). When a
    // boot route arrives it must start sshd pointing at exactly this HostKey, and a live boot proving
    // sshd serves exactly this key is the read obligation on gunbc.host.anchored_host_transport, still
    // open until merry-fox-82 gives the go. The absent consumer is carried as a frontier row with its
    // trigger (anchored_host_transport_frontier_rows in that module), not papered over here.
    Mtcollins1SshHostKey => HostCredentialCustodyRow {
      credential: c,
      secret: mtcollins1_ssh_host_key_secret,
      path: "/run/gunbc-ssh/ssh_host_ed25519_key" as NonEmptyStr,
      host_scope: CustodyOnlyOnHost { host: operator_host_mtcollins1 },
      file_ownership: custody_root_only,
      file_mode: CustodyFileOwnerRead,
      dir_ownership: custody_root_only,
      dir_mode: DirectoryOwnerOnly,
      export_receipt: CustodyExportReceiptNotOwed,
      medium: CustodyTmpfsNoSwap,
    }
    // The approval broker's APNs auth key (gunbc.auth.approval_apns_publish approval_apns_auth_key):
    // an EC P-256 .p8 that the broker, running as the operator account, hands by path to openssl to
    // sign the APNs provider token. Operator-only 0400 in an operator-only directory, like the
    // tracker-web client secret: the broker is its only reader, so there is no reader set to declare.
    ApprovalApnsAuthKey => HostCredentialCustodyRow {
      credential: c,
      secret: approval_apns_auth_key_secret_ref,
      path: signing_key_file_path(key: approval_apns_auth_key),
      host_scope: CustodyOnlyOnHost { host: operator_host_srv1 },
      file_ownership: custody_operator_only,
      file_mode: CustodyFileOwnerRead,
      dir_ownership: custody_operator_only,
      dir_mode: DirectoryOwnerOnly,
      export_receipt: CustodyExportReceiptNotOwed,
      medium: CustodyDiskBacked,
    }

    // THE PRINTER LAN ACCESS CODES, copied ONCE from Secret Manager into host custody so the shell print
    // route (gunbc.fleet.printer_shell_run) reads a file and holds no Google identity (operator ruling
    // 2026-11-05, gunbc.design_ruling printer_credential_is_held_in_host_custody). root:gunbc-fleet 0640 in
    // a root:gunbc-fleet directory: the print runner principal (ghrunner, group gunbc-fleet) that already
    // owns the printer state reads it, and nobody else. The stored bytes are the JSON record
    // custody_payload shapes ({code, sm_resolved}), because the approval subject binds the credential
    // VERSION and a bare code has none. Store-authoritative: Secret Manager stays the source and a re-run
    // refreshes the copy.
    Printer01AccessCode => printer_access_code_custody_row(c: c, printer: printer_01)
    Printer02AccessCode => printer_access_code_custody_row(c: c, printer: printer_02)
  }
}

data custody_root_owned_printer_state_group: PosixOwnerNames = PosixOwnerNames {
  user: fleet_posix_root_user.name,
  group: printer_state_group(),
}

fn printer_access_code_custody_row(c: HostCustodyCredential, printer: PhysicalAssetIdentity) -> HostCredentialCustodyRow {
  HostCredentialCustodyRow {
    credential: c,
    secret: secret_ref_pin_version(ref: printer_access_code_desired_ref(printer: printer), version: "latest" as NonEmptyStr),
    path: printer_custody_path(printer: printer),
    host_scope: CustodyOnlyOnHost { host: operator_host_srv1 },
    file_ownership: custody_root_owned_printer_state_group,
    file_mode: CustodyFileOwnerReadWriteGroupRead,
    dir_ownership: custody_root_owned_printer_state_group,
    dir_mode: DirectoryOwnerAllGroupTraverse,
    export_receipt: CustodyExportReceiptNotOwed,
    medium: CustodyDiskBacked,
  }
}

// ── The read-only roster predicate (for the deploy-artifact gate) ──────────────────────────────

// DOES FLEET CUSTODY DECLARE THIS HOST'S READING OF THIS PATH? The deploy-artifact gate
// (gunbc.live_deploy.apply_legs, PR #16587) asks this so an OIDC client-secret file that custody
// already converges is not also demanded as a verifiable deploy artifact. It is read-only and total:
// a CustodyAnyRunnerHost row declares the path on any host, a CustodyOnlyOnHost row only on its named
// host, and an unrostered path is false.
fn custody_roster_declares(host: HostIdentity, path: String) -> Bool {
  fold(host_custody_credential_roster, init: false, f: (acc, c) =>
    if acc { true } else { custody_row_declares(c: c, host: host, path: path) }
  )
}

fn custody_row_declares(c: HostCustodyCredential, host: HostIdentity, path: String) -> Bool {
  let row = host_credential_custody_row(c: c)
  let hosts = custody_row_hosts(row: row, host: host)
  if hosts { custody_row_path(row: row, path: path) } else { false }
}

// ONE READING OF WHAT A HOST SCOPE MEANS, SHARED BY THE DEPLOY GATE AND BY CONVERGE. THE EXECUTOR IS
// WHERE THE DISPATCH PLACED THE RUN; THE TARGET IS WHERE THE ROW DELIVERS. The dispatch's host is the
// runner label the job ran under (FLEET_CONVERGE_EXPECTED_HOST, as for
// gunbc.machine_intake.arrival_admission arrival_admit_executor), and the custody target is read off the
// row: a row scoped to one host delivers there from any executor, over the administrator edge
// gunbc.fleet.host_credential_custody_converge custody_host already resolves, and a row for any runner
// host delivers to the executor itself. The two used to be one reading, so a row scoped to a host with
// no runner slots (srv2, whose width refuses: gunbc.runner.runner_host_deploy) could never be placed --
// its job waited for a runner that does not exist. The dispatch also cannot name a wrong destination any
// more: before, that was a refusal; now no dispatch input reaches the target at all. converge resolves
// its install target through this, and the roster coverage predicate below is derived from it, so the
// gate's answer can never disagree about which host a row lands on.
fn custody_target_host(row: HostCredentialCustodyRow, executor: HostIdentity) -> HostIdentity {
  match row.host_scope {
    CustodyAnyRunnerHost => executor
    CustodyOnlyOnHost { host: only } => only
  }
}

// A row covers a host exactly when the host it would deliver to, run on that host, is that host: derived
// from custody_target_host rather than matching the scope again, so the gate's answer cannot drift from
// where converge installs. Any runner host delivers to the executing host itself, so it covers every
// host; a row scoped to one host covers only that host.
fn custody_row_hosts(row: HostCredentialCustodyRow, host: HostIdentity) -> Bool {
  let target = custody_target_host(row: row, executor: host)
  host_identity_eq(a: target, b: host)
}

fn custody_row_path(row: HostCredentialCustodyRow, path: String) -> Bool {
  let row_path: String = row.path as String
  row_path == path
}
