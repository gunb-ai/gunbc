module gunbc.fleet.host_credential_custody_step

// THE HOST CREDENTIAL CUSTODY CONVERGE RUN STEP lives here, beside host_credential_custody_converge
// which owns the custody convergence it drives, not in the central ci_spec. The machinery it borrows
// is shared and imported, never reached through ci_spec: gunbc_run_step_script from
// v2.workflow.gunbc_invoke_step_emit and witness_layer_roots from gunbc.ci.ci_layer_roots.

import std.types { String }
import v2.workflow.gunbc_invoke_step_emit { gunbc_run_step_script }
import gunbc.ci.ci_layer_roots { witness_layer_roots }
import gunbc.ci.ci_run_step_target { GunbcRunStepTarget }

data gunbc_ci_host_credential_custody_converge_target: GunbcRunStepTarget = GunbcRunStepTarget {
  entry: "dag/gunbc/fleet/host_credential_custody_converge.dag",
  function: "host_credential_custody_converge_ci_wet",
}

fn gunbc_ci_host_credential_custody_converge_invoke() -> String {
  gunbc_run_step_script(
    source_roots: witness_layer_roots,
    entry: gunbc_ci_host_credential_custody_converge_target.entry,
    function: gunbc_ci_host_credential_custody_converge_target.function,
    claim_run: false,
    receipt_rel: "target/host-credential-custody-converge-receipt.txt"
  )
}
