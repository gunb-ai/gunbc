module gunbc.fleet.machine_board

import std.types { List, NonEmptyStr }
import std.decl_ref { DeclarationRef, decl_ref }
import product.host_identity { HostIdentity }
import extdeps.boards.types { BaseboardCatalogRow }
import extdeps.boards.asrock_rack { asrock_altrad8ud_1l2t_catalog }
import extdeps.boards.supermicro_h11ssl { supermicro_h11ssl_catalog }
import gunbc.fleet.fleet_host_identity {
  operator_host_srv1, operator_host_srv2, operator_host_srv3, operator_host_srv4,
  operator_host_mtcollins1, operator_host_mtjade1,
  operator_host_srv9, operator_host_srv10, operator_host_srv11, operator_host_srv12,
  operator_host_srv13, operator_host_srv14, operator_host_srv15, operator_host_srv16,
  operator_host_183527, operator_host_3dde7f, operator_host_6ce85c,
}
import gunbc.fleet.fleet_intent { srv1_baseboard, srv2_baseboard, srv3_baseboard, srv4_baseboard, srv13_baseboard, srv14_baseboard, srv15_baseboard }

// WHICH BOARD EACH MACHINE IN THE ROSTER CARRIES, for every member of
// gunbc.fleet.fleet_host_identity operator_hosts, enrolled or not. Naming is not enrollment, and
// neither is this: a row here licenses nothing, and it does not widen fleet_intent_known_hosts or any
// other operational population. It exists so that the board-function plans (gunbc.fleet.
// board_function_admission) can say, for every machine the operator holds, what its board admits and
// how the rest is switched off, including the machines not yet converged.
//
// A board fact already held elsewhere is cited, never restated: srv1-4, srv13 and srv15 take the
// catalog from their ServerBaseboard rows in gunbc.fleet.fleet_intent. The rest are the operator's
// statements recorded on the identity rows, cited by the identity row that records them.
type MachineBoardStanding
  = MachineBoardCatalogued { catalog: BaseboardCatalogRow, source: DeclarationRef }
  | MachineBoardUncatalogued { board: NonEmptyStr, obligation: NonEmptyStr }
  | MachineBoardProviderOwned { provider: NonEmptyStr }

type MachineBoardRow {
  host: HostIdentity
  board: MachineBoardStanding
}

fn fleet_intent_board(host: HostIdentity, decl_name: NonEmptyStr, catalog: BaseboardCatalogRow) -> MachineBoardRow {
  MachineBoardRow {
    host: host,
    board: MachineBoardCatalogued { catalog: catalog, source: decl_ref(module_path: "gunbc.fleet.fleet_intent", decl_name: decl_name) },
  }
}

fn identity_stated_board(host: HostIdentity, decl_name: NonEmptyStr, catalog: BaseboardCatalogRow) -> MachineBoardRow {
  MachineBoardRow {
    host: host,
    board: MachineBoardCatalogued { catalog: catalog, source: decl_ref(module_path: "gunbc.fleet.fleet_host_identity", decl_name: decl_name) },
  }
}

fn uncatalogued(host: HostIdentity, board: NonEmptyStr) -> MachineBoardRow {
  MachineBoardRow {
    host: host,
    board: MachineBoardUncatalogued {
      board: board,
      obligation: "a BaseboardCatalogRow for the board and a reading of its manual for how each board function is switched off",
    },
  }
}

fn provider_owned(host: HostIdentity) -> MachineBoardRow {
  MachineBoardRow {
    host: host,
    board: MachineBoardProviderOwned { provider: "Hetzner Cloud CAX41 guest (gunbc.fleet.fleet_enrollment): the provider owns the board, so no board function is the fleet's to admit or switch off" },
  }
}

data machine_board_rows: List<MachineBoardRow> = [
  fleet_intent_board(host: operator_host_srv1, decl_name: "srv1_baseboard", catalog: srv1_baseboard.catalog),
  fleet_intent_board(host: operator_host_srv2, decl_name: "srv2_baseboard", catalog: srv2_baseboard.catalog),
  fleet_intent_board(host: operator_host_srv3, decl_name: "srv3_baseboard", catalog: srv3_baseboard.catalog),
  fleet_intent_board(host: operator_host_srv4, decl_name: "srv4_baseboard", catalog: srv4_baseboard.catalog),
  uncatalogued(host: operator_host_mtcollins1, board: "Foxconn Ampere Mt. Collins"),
  uncatalogued(host: operator_host_mtjade1, board: "Foxconn Ampere Mt. Jade"),
  uncatalogued(host: operator_host_srv9, board: "NVIDIA DGX Spark"),
  uncatalogued(host: operator_host_srv10, board: "NVIDIA DGX Spark"),
  uncatalogued(host: operator_host_srv11, board: "NVIDIA DGX Spark"),
  uncatalogued(host: operator_host_srv12, board: "NVIDIA DGX Spark"),
  fleet_intent_board(host: operator_host_srv13, decl_name: "srv13_baseboard", catalog: srv13_baseboard.catalog),
  fleet_intent_board(host: operator_host_srv14, decl_name: "srv14_baseboard", catalog: srv14_baseboard.catalog),
  fleet_intent_board(host: operator_host_srv15, decl_name: "srv15_baseboard", catalog: srv15_baseboard.catalog),
  identity_stated_board(host: operator_host_srv16, decl_name: "operator_host_srv16", catalog: asrock_altrad8ud_1l2t_catalog),
  provider_owned(host: operator_host_183527),
  provider_owned(host: operator_host_3dde7f),
  identity_stated_board(host: operator_host_6ce85c, decl_name: "operator_host_6ce85c", catalog: supermicro_h11ssl_catalog),
]
