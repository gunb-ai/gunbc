module gunbc.fleet.cpu_freq_cap_boot_state

// A CPU FREQUENCY CEILING HELD ON A HOST BY A MECHANISM SOMEONE INSTALLED: the ceiling, the unit and script
// that hold it, what that pair read back when it finished, and -- the part that carries weight -- whether the
// ceiling still stands, and what stands in its place if it does not.
//
// WHY THIS MODULE EXISTS BEFORE ANY ACTUATOR. The fleet already has a CPU frequency ceiling on two hosts and no
// type that could say so: gunbc.plans.host_thermal_operating_point lists `ReadCpuOperatingLimits` ("governor
// and per-core limits, any power cap") as a read it PLANS to model, and nothing until now held the fact a read
// would fill. So this module declares the shape first and the rows second, and the rows that exist say what was
// read on 2026-11-24 and nothing more. No actuator, unit template or converge lives here: a ceiling the operator
// applied by hand is recorded, not reproduced. Adding the mechanism would mean a unit file, sudoers grants and a
// fleet-converge mode, and each gets modelled when there is a decision to act on, not before.
//
// WHAT THIS MODULE DOES NOT OWN.
//   - the part's own numbers -- core count, nominal sustained per-thread clock, TDP -- are the catalog row in
//     extdeps.cpu.ampere, joined here rather than restated; a ceiling is only meaningful against them, which is
//     why the witness compares the two;
//   - the watts a host draws is gunbc.fleet.fleet_host_power's, and the readings taken while this cap went in
//     are named there as confounded (load moved between them), so none of them priced anything;
//   - the decision to apply a ceiling, or to raise one, is the operator's and is recorded in
//     gunbc.design_ruling; this module reports the standing a ruling leaves behind, it cannot create one;
//   - the boot mechanism's file contents and whole content hashes are unread; each digest carries, on itself,
//     the read that would discharge it (`CapUnitDigestMarkedOnly.what_would_discharge_it` in
//     gunbc.fleet.gpu_power_cap_boot_state), rather than a second roster saying the same thing.
//
// THE STANDING IS THE LOAD-BEARING FIELD. A ceiling standing on a host today, a ceiling the model wants on that
// host, and a ceiling that was applied and has since been replaced are three facts, and the two hosts recorded
// here are exactly where they come apart: the operator applied 2.0 GHz on 2026-11-24 and the same day moved to
// raise it, because heal's build lane ran out at its 60-minute limit with the cores held there. So `ceiling`
// names the figure that was APPLIED, `standing` says it no longer holds, and the figure that replaced it is
// unread until a read or an operator statement lands. A consumer that pushes desired state at a host must not
// push either the applied figure or an invented replacement: `cpu_freq_caps_to_converge` answers empty, and
// `host_cpu_freq_ceiling` answers what stands today, which for these hosts is nothing this model has read.

import std.types { Bool, Int, List, NonEmptyStr }
import std.optional { Absent, Present }
import product.host_identity { HostIdentity, host_identity_eq }
import std.measure { Hertz, hertz, hertz_count }
import gunbc.fleet.fleet_host_identity { operator_host_srv3, operator_host_srv4 }
// The cap-unit digest standing is the same question gunbc.fleet.gpu_power_cap_boot_state first modelled for the
// GPU cap units, so it is spelled once there and imported here -- the type and the discharge read -- rather than
// minted a second time beside it.
import gunbc.fleet.gpu_power_cap_boot_state {
  CapUnitContentDigest, CapUnitDigestMarkedOnly, declared_path_host_hash_read,
}

// What the mechanism's own script reported when it finished. The script writes the ceiling to every core and
// reads each one back, and it FAILS if any core misses -- so the count it reports is the mechanism grading its
// own work, and it is a different reading from an outside observer ticking cores over ssh.
type CpuCoreFrequencyReadBack
  = EveryCoreSeenAtCeiling { cores_read_back: Int }
  | SomeCoresMissedAtCeiling { cores_read_back: Int, cores_expected: Int }
  | ReadBackNotReported { why: NonEmptyStr }

// WHETHER THE CEILING STILL STANDS. The arms are not a workflow status and not a to-do: they are what the host
// is under. `CeilingStands` is a ceiling read holding today; `CeilingSuperseded` is a ceiling that was applied
// and has since been changed, with the change's authorship and date on it, and with the replacement carried as a
// standing of its own rather than as a blank.
type CpuFreqCapStanding
  = CeilingStands { applied_on: NonEmptyStr }
  | CeilingSuperseded {
      applied_on: NonEmptyStr
      superseded_on: NonEmptyStr
      // Whose act replaced it, in their terms rather than this module's inference.
      superseded_by: NonEmptyStr
      replacement_ceiling: ReplacementCeilingStanding
      // Why it went. Held on the row because a ceiling lifted for a build lane and a ceiling lifted for power
      // are different history, and the second reads as a policy about the hardware otherwise.
      why: NonEmptyStr
    }

// THE FIGURE THAT REPLACED A SUPERSEDED CEILING, as it stands for this model. `ReplacementUnread` is the
// frontier: a new ceiling exists on those hosts and has not been read here, so the row says what would close it
// and supplies no digits. `ReplacementStated` is what a read or an operator statement lands as -- and once one
// exists, it, not the applied figure, is what the host is under.
type ReplacementCeilingStanding
  = ReplacementStated { ceiling: Hertz }
  | ReplacementUnread { what_would_discharge_it: NonEmptyStr }

// A frequency ceiling held on a host by an installed mechanism. The unit runs the script; both paths are the
// operator's, and both digests are as-reported markings until a host hash read lands.
type CpuFreqCapMechanism {
  host: HostIdentity
  unit_path: NonEmptyStr
  unit_digest: CapUnitContentDigest
  script_path: NonEmptyStr
  script_digest: CapUnitContentDigest
  // The ceiling the mechanism writes to each core. cpufreq's scaling_max_freq counts kilohertz; this carries
  // hertz, the unit the catalog's nominal clock uses, so the two compare without a scale silently changing.
  // This is the figure that was APPLIED -- what stands today is `standing`'s to answer.
  ceiling: Hertz
  read_back: CpuCoreFrequencyReadBack
  // Reboot-persistence as the operator stated it -- an enabled boot unit. NOT a `systemctl is-enabled` read;
  // nothing here reports what systemd says about the unit.
  persists_across_boot: Bool
  standing: CpuFreqCapStanding
  read_on: NonEmptyStr
}

// THE READ THAT WOULD TELL THIS MODEL WHAT THE HOSTS ARE UNDER NOW. Spelled once here and carried by both rows,
// because the two rows are blocked on the same missing read: no observe mode this repository models reads a CPU
// frequency limit on a host, and the only figure ever reported -- 128 of 128 cores at 2000000 kHz -- came from
// the mechanism's own script read by the operator by hand.
data cpu_freq_ceiling_replacement_read: NonEmptyStr = "a read of what the ceiling on each host IS now, either a fleet-converge observe leg that reads the CPU scaling limit on the subject host (no such mode exists today, and the first read of this mechanism was the operator's hand read rather than a modeled one) or the operator stating the figure. Until one of those lands the replacement figure is unread, and writing a number here would be inventing a host's clock." as NonEmptyStr

// THE TWO HOSTS THE OPERATOR HELD AT 2.0 GHZ ON 2026-11-24, and no longer. The operator installed one unit and
// one script on each host that day; the applied ceiling is half the M128-30's nominal sustained per-thread
// clock, and the script's own read-back reported every core of 128 at it. The same day the operator moved to
// raise that ceiling, so both rows carry `CeilingSuperseded`: the applied figure and its read-back stay on the
// record, and the figure that replaced it is unread. Both rows carry the same digest markings because the
// operator quoted one head-and-tail per file for both hosts -- whether the two hosts' copies are byte-identical
// is itself unread, and a hash read run on each host separately is what would settle that too.
data srv3_cpu_freq_cap: CpuFreqCapMechanism = CpuFreqCapMechanism {
  host: operator_host_srv3,
  unit_path: "/etc/systemd/system/cpu-freq-cap.service" as NonEmptyStr,
  unit_digest: CapUnitDigestMarkedOnly {
    head: "35b24e44" as NonEmptyStr,
    tail: "08630" as NonEmptyStr,
    what_would_discharge_it: declared_path_host_hash_read,
  },
  script_path: "/usr/local/sbin/cpu-freq-cap.sh" as NonEmptyStr,
  script_digest: CapUnitDigestMarkedOnly {
    head: "4a940fd5" as NonEmptyStr,
    tail: "3f027" as NonEmptyStr,
    what_would_discharge_it: declared_path_host_hash_read,
  },
  ceiling: hertz(count: 2000000000),
  read_back: EveryCoreSeenAtCeiling { cores_read_back: 128 },
  persists_across_boot: true,
  standing: CeilingSuperseded {
    applied_on: "2026-11-24" as NonEmptyStr,
    superseded_on: "2026-11-24" as NonEmptyStr,
    superseded_by: "the operator, who said on 2026-11-24 they were raising the srv3/srv4 CPU frequency cap -- gunbc.design_ruling::operator_superseded_srv3_srv4_cpu_freq_cap_2026_11_24; the change on the hosts is theirs, and no read of its result has landed here" as NonEmptyStr,
    replacement_ceiling: ReplacementUnread {
      what_would_discharge_it: cpu_freq_ceiling_replacement_read,
    },
    why: "heal's build lane timed out at its 60-minute limit six times with the cores held at 2.0 GHz and went green at 42m once the ceiling was raised, so the ceiling applied to trim power was standing between the fleet and a green build" as NonEmptyStr,
  },
  read_on: "2026-11-24, applied and read by the operator by hand over the admin route; the operator's words are gunbc.design_ruling::operator_hand_applied_srv3_srv4_power_caps_2026_11_24" as NonEmptyStr,
}

data srv4_cpu_freq_cap: CpuFreqCapMechanism = CpuFreqCapMechanism {
  host: operator_host_srv4,
  unit_path: "/etc/systemd/system/cpu-freq-cap.service" as NonEmptyStr,
  unit_digest: CapUnitDigestMarkedOnly {
    head: "35b24e44" as NonEmptyStr,
    tail: "08630" as NonEmptyStr,
    what_would_discharge_it: declared_path_host_hash_read,
  },
  script_path: "/usr/local/sbin/cpu-freq-cap.sh" as NonEmptyStr,
  script_digest: CapUnitDigestMarkedOnly {
    head: "4a940fd5" as NonEmptyStr,
    tail: "3f027" as NonEmptyStr,
    what_would_discharge_it: declared_path_host_hash_read,
  },
  ceiling: hertz(count: 2000000000),
  read_back: EveryCoreSeenAtCeiling { cores_read_back: 128 },
  persists_across_boot: true,
  standing: CeilingSuperseded {
    applied_on: "2026-11-24" as NonEmptyStr,
    superseded_on: "2026-11-24" as NonEmptyStr,
    superseded_by: "the operator, who said on 2026-11-24 they were raising the srv3/srv4 CPU frequency cap -- gunbc.design_ruling::operator_superseded_srv3_srv4_cpu_freq_cap_2026_11_24; the change on the hosts is theirs, and no read of its result has landed here" as NonEmptyStr,
    replacement_ceiling: ReplacementUnread {
      what_would_discharge_it: cpu_freq_ceiling_replacement_read,
    },
    why: "heal's build lane timed out at its 60-minute limit six times with the cores held at 2.0 GHz and went green at 42m once the ceiling was raised, so the ceiling applied to trim power was standing between the fleet and a green build" as NonEmptyStr,
  },
  read_on: "2026-11-24, applied and read by the operator by hand over the admin route; the operator's words are gunbc.design_ruling::operator_hand_applied_srv3_srv4_power_caps_2026_11_24" as NonEmptyStr,
}

data cpu_freq_cap_mechanisms: List<CpuFreqCapMechanism> = [ srv3_cpu_freq_cap, srv4_cpu_freq_cap ]

// WHICH CEILINGS THE MODEL IS TO LEAVE ALONE. A consumer converging desired CPU state asks this and nothing
// else: a superseded ceiling is a record of what was, never a target, and pushing it would reinstall a unit the
// operator has already raised past.
fn cpu_freq_caps_to_converge() -> List<CpuFreqCapMechanism> {
  filter(cpu_freq_cap_mechanisms, m =>
    match m.standing {
      CeilingStands { applied_on: _ } => true
      CeilingSuperseded {
        applied_on: _, superseded_on: _, superseded_by: _, replacement_ceiling: _, why: _,
      } => false
    })
}

fn cpu_freq_cap_mechanisms_on(host: HostIdentity) -> List<CpuFreqCapMechanism> {
  filter(cpu_freq_cap_mechanisms, m => host_identity_eq(a: m.host, b: host))
}

// THE CEILING A MECHANISM LEAVES STANDING: the applied figure while it stands, the operator-stated replacement
// once one has landed, and NOTHING while a replacement is unread. Answering the applied figure here would be
// the failure this type exists to prevent -- a host whose clock was raised on 2026-11-24 still reporting the
// figure that was raised away from, with no read behind it.
fn cpu_freq_ceiling_standing_on(m: CpuFreqCapMechanism) -> Hertz? {
  match m.standing {
    CeilingStands { applied_on: _ } => Present { value: m.ceiling }
    CeilingSuperseded {
      applied_on: _, superseded_on: _, superseded_by: _, replacement_ceiling: replacement, why: _,
    } =>
      match replacement {
        ReplacementStated { ceiling } => Present { value: ceiling }
        ReplacementUnread { what_would_discharge_it: _ } => Absent
      }
  }
}

// The ceiling a host runs under, as this model knows. Absent means this model has not read what stands there
// now -- for srv3 and srv4 today that is literally true, their applied ceiling having been superseded by a
// change nothing here has read.
fn host_cpu_freq_ceiling(host: HostIdentity) -> Hertz? {
  match cpu_freq_cap_mechanisms_on(host: host).first() {
    Absent => Absent
    Present { value: m } => cpu_freq_ceiling_standing_on(m: m)
  }
}

// THE OPEN READ A CEILING'S RECORD CARRIES: what would tell this model what the replacement figure is. Absent
// when the ceiling still stands or the replacement has already landed. This is the frontier, and it lives in the
// standing rather than beside it, so a figure cannot be stated in one place while another row still calls the
// ceiling unread.
fn cpu_freq_cap_replacement_discharge_read(m: CpuFreqCapMechanism) -> NonEmptyStr? {
  match m.standing {
    CeilingStands { applied_on: _ } => Absent
    CeilingSuperseded {
      applied_on: _, superseded_on: _, superseded_by: _, replacement_ceiling: replacement, why: _,
    } =>
      match replacement {
        ReplacementUnread { what_would_discharge_it } => Present { value: what_would_discharge_it }
        ReplacementStated { ceiling: _ } => Absent
      }
  }
}

// Is the APPLIED figure below the clock the installed part is rated to sustain? Asked of the catalog row rather
// than of a number typed into a row, so a ceiling that quietly rose to the part's nominal clock would stop being
// called a cap. This compares what was applied on 2026-11-24; it says nothing about what stands today, which is
// `cpu_freq_ceiling_standing_on`'s to answer.
fn ceiling_sits_below_the_parts_nominal_clock(m: CpuFreqCapMechanism, nominal: Hertz) -> Bool {
  hertz_count(h: m.ceiling) < hertz_count(h: nominal)
}
