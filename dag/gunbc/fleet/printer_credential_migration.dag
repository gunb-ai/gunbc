module gunbc.fleet.printer_credential_migration

import std.types { Bool, String, NonEmptyStr, FilePath, Secret, List }
import std.resources { Network }
import extdeps.shell
import extdeps.cloud.gcp.secret_ref { SecretRef, secret_ref_secret_resource }
import extdeps.cloud.gcp.gcp { GcpProjectId }

// AUTHORIZATION TO DESTROY IS A VALUE, NOT AN INFERENCE FROM AN OBSERVATION, and this type exists
// because the obvious alternative is actively dangerous. The state that says "this container exists
// but no verification records its version" is exactly the state a CRASHED RUN leaves behind: a
// process that minted VerifiedVersionForAttempt and died before delivery owns no verification on
// restart, so the remote looks identical to an out-of-band container. If the orchestrator read that
// observation as permission to delete, every crash in that window would escalate itself into an
// irreversible destruction of a working credential, and the liveness gap accepted for the first
// print would quietly become a safety gap.
//
// SO THE AUTHORIZATION NAMES ITS SUBJECT AND IS CHECKED AGAINST THE RESOLVED LOCUS. It is not a
// boolean, not a flag, and not a mode: a bare "yes, delete" would authorize destroying whichever
// container the run happened to resolve, which is the argument-position confusion the snapshot
// carrier exists to prevent one layer down. The operator authorizes ONE resource by name.
type ContainerMigrationAuthorization sole_constructor {
  secret_resource: NonEmptyStr
}

fn authorized_resource(a: ContainerMigrationAuthorization) -> NonEmptyStr { a.secret_resource }

type MigrationAuthorizationOutcome
  = MigrationAuthorized { authorization: ContainerMigrationAuthorization }
  | MigrationUnauthorized
  | MigrationAuthorizationNamesAnotherSecret { supplied: String, resolved: String }

// THE SUPPLIED NAME MUST EQUAL THE RESOLVED LOCUS EXACTLY. An authorization for one printer's secret
// must not license deleting another's, and the comparison is against what the LOCUS resolved to
// rather than what the caller believes it asked for -- the same request-versus-response discipline
// the credential fetch now enforces, applied to the one operation in this chain that cannot be
// undone.
fn classify_migration_authorization(
  supplied: String,
  desired: SecretRef,
) -> MigrationAuthorizationOutcome {
  let resolved = secret_ref_secret_resource(ref: desired)
  if supplied == "" {
    MigrationUnauthorized
  } else if supplied != resolved {
    MigrationAuthorizationNamesAnotherSecret { supplied: supplied, resolved: resolved }
  } else {
    MigrationAuthorized {
      authorization: ContainerMigrationAuthorization { secret_resource: resolved as NonEmptyStr },
    }
  }
}

// A DELETION'S OUTCOME IS THREE-WAY FOR THE SAME REASON THE OTHER MUTATIONS ARE, and the third arm
// is the one that matters most here. A transport loss or a server error leaves the deletion's commit
// state unknown, and the tempting recovery -- issue DELETE again -- is forbidden: deletion is
// addressed BY NAME, and a same-name secret may have been created in the interval, so a replay can
// destroy a container this run never observed. An unknown deletion is reconciled by READING, never
// by repeating the write.
type ContainerDeletionOutcome
  = ContainerDeleted
  | ContainerDeletionRefused { cause: NonEmptyStr }
  | ContainerDeletionOutcomeUnknown { cause: NonEmptyStr }

fn deletion_may_be_replayed(o: ContainerDeletionOutcome) -> Bool {
  match o {
    ContainerDeleted => false
    ContainerDeletionRefused { cause: _ } => false
    ContainerDeletionOutcomeUnknown { cause: _ } => false
  }
}

// A SUCCESSFUL DELETE IS NOT AN ABSENCE ORACLE, which is the whole reason this step is separate from
// the deletion itself. Secret Manager documents strong consistency for exactly one sequence -- add a
// version, then access that exact version -- and everything else, deletion included, is eventually
// consistent. So "the API accepted my DELETE" does not entitle the next line to assume the container
// is gone; only a read does, and if the read still reports the container present the run STOPS
// rather than deleting again or creating over it.
type PostDeletionObservation
  = PostDeletionAbsent
  | PostDeletionStillPresent { resource: String }
  | PostDeletionUnobserved { cause: NonEmptyStr }

fn absence_is_established(o: PostDeletionObservation) -> Bool {
  match o {
    PostDeletionAbsent => true
    PostDeletionStillPresent { resource: _ } => false
    PostDeletionUnobserved { cause: _ } => false
  }
}

// THE DELETE IS FENCED TO THE GENERATION THAT WAS OBSERVED AND AUTHORIZED, not to a name. Secret
// Manager accepts an etag on delete as an optimistic-concurrency fence: the deletion commits only if
// the etag still matches what is stored. Without one, DELETE removes whatever occupies that name at
// arrival, and there is a real window even on the FIRST attempt -- observe Secret A, do local work,
// and if something replaces A with a same-name Secret B in between, an unfenced delete removes B.
// The operator authorized destroying the out-of-band object that was observed, not whatever later
// occupies that string.
//
// SO NAME AND ETAG TRAVEL TOGETHER IN ONE SEALED VALUE, and delete_observed_secret takes only that
// value. This is the same argument-position discipline as OwnedCredentialSnapshot, applied to the
// one operation in this chain that cannot be undone: there is no call site at which a caller can
// pair one secret's name with another generation's etag, because there is no such pair to write.
type ObservedSecretForDeletion sole_constructor {
  resource: NonEmptyStr
  etag: NonEmptyStr
}

fn observed_resource(o: ObservedSecretForDeletion) -> NonEmptyStr { o.resource }
fn observed_etag(o: ObservedSecretForDeletion) -> NonEmptyStr { o.etag }

type DeletionSubjectObservation
  = DeletionSubjectObserved { observed: ObservedSecretForDeletion }
  | DeletionSubjectNamesAnotherResource { returned: String, expected: String }
  | DeletionSubjectHasNoEtag { resource: String }
  | DeletionSubjectUnobserved { cause: NonEmptyStr }

// A MISSING ETAG REFUSES RATHER THAN FALLING BACK TO AN UNFENCED DELETE, which is the whole point.
// The tempting arm -- "no etag, so delete by name" -- is the absorbing fallback DESIGN section 5
// names: it converts an inability to fence into permission to proceed unfenced, and it does so
// exactly when the service told us something we did not expect.
//
// THE RETURNED RESOURCE IS CHECKED AGAINST THE EXPECTED ONE for the same reason the credential fetch
// checks its response identity: a capability minted from an answer about a different object would
// authorize destroying that object.
fn classify_deletion_subject(
  returned_resource: String,
  returned_etag: String,
  expected_resource: String,
) -> DeletionSubjectObservation {
  if returned_resource != expected_resource {
    DeletionSubjectNamesAnotherResource { returned: returned_resource, expected: expected_resource }
  } else if returned_etag == "" {
    DeletionSubjectHasNoEtag { resource: returned_resource }
  } else {
    DeletionSubjectObserved {
      observed: ObservedSecretForDeletion {
        resource: returned_resource as NonEmptyStr,
        etag: returned_etag as NonEmptyStr,
      },
    }
  }
}
