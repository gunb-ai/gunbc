module gunbc.fleet.printer_credential_migration

import std.types { Bool, String, NonEmptyStr, FilePath, Secret, List }
import std.resources { Network }
import extdeps.shell
import extdeps.cloud.gcp.secret_ref { SecretRef, secret_ref_secret_resource, gcp_resource_names_this_secret, gcp_secret_resource_by_number }
import gunbc.auth.github_gcp_federation { fleet_secrets_project_number }
import extdeps.cloud.gcp.gcp { GcpProjectId }
import extdeps.cloud.gcp.secret_manager
import extdeps.transports.rest {
  RestOk, RestStatusRefused, RestTransportRefused, RestBodyUndecodable,
  classify_rest_outcome,
  RestExchangeSucceeded, RestExchangeStatusRefused, RestExchangeCommitAmbiguous,
  RestExchangeUnreached, RestExchangeUndecodable, RestMutationExchange,
}

// AUTHORIZATION TO DESTROY IS A VALUE, NOT AN INFERENCE FROM AN OBSERVATION, and this type exists
// because the obvious alternative is actively dangerous. The state that says "this container exists
// but no verification records its version" is exactly the state a CRASHED RUN leaves behind: a
// process that minted VerifiedVersionForAttempt and died before delivery owns no verification on
// restart, so the remote looks identical to an out-of-band container. If the orchestrator read that
// observation as permission to delete, every crash in that window would escalate itself into an
// irreversible destruction of a working credential, and the liveness gap accepted for the first
// print would quietly become a safety gap.
//
// SO THE AUTHORIZATION NAMES ITS SUBJECT AND IS CHECKED AGAINST THE RESOLVED LOCUS. It is not a
// boolean, not a flag, and not a mode: a bare "yes, delete" would authorize destroying whichever
// container the run happened to resolve, which is the argument-position confusion the snapshot
// carrier exists to prevent one layer down. The operator authorizes ONE resource by name.
type ContainerMigrationAuthorization sole_constructor {
  secret_resource: NonEmptyStr
}

fn authorized_resource(a: ContainerMigrationAuthorization) -> NonEmptyStr { a.secret_resource }

type MigrationAuthorizationOutcome
  = MigrationAuthorized { authorization: ContainerMigrationAuthorization }
  | MigrationUnauthorized
  | MigrationAuthorizationNamesAnotherSecret { supplied: String, resolved: String }

// THE SUPPLIED NAME MUST EQUAL THE RESOLVED LOCUS EXACTLY. An authorization for one printer's secret
// must not license deleting another's, and the comparison is against what the LOCUS resolved to
// rather than what the caller believes it asked for -- the same request-versus-response discipline
// the credential fetch now enforces, applied to the one operation in this chain that cannot be
// undone.
// THE AUTHORIZATION IS ACCEPTED IN EITHER SPELLING AND STORED IN ONE, WHICH ARE TWO SEPARATE FIXES
// FOR ONE MEASUREMENT.
//
// This function used to compare the operator's text to secret_ref_secret_resource -- the PROJECT ID
// spelling, because that is how a caller addresses a secret -- and then carry that same text into
// the deletion fence. Both halves were wrong in the same way, and the second half is the one that
// actually bit: a live run passed this check (the operator typed the ID spelling, so it matched) and
// then refused at the fence, where the carried ID spelling was compared against the resource GCP
// RETURNED, which is always the project NUMBER. The fence was comparing two spellings of one secret
// and reporting them as two different secrets.
//
// So acceptance widens to either fully-qualified spelling -- an operator may reasonably paste either,
// and refusing the number form would refuse a correct authorization -- and the CARRIER is normalized
// to the canonical form the service itself uses. Normalizing at the mint rather than loosening the
// comparison at the fence is what keeps the fence an exact string equality: the alternative,
// teaching delete_observed_secret to accept two spellings, would have required handing it the
// project and secret as parameters, and the note above that function exists precisely to say that
// neither a name nor an etag may be a parameter there.
//
// WIDENING IS NOT LOOSENING. Both accepted forms are FULLY QUALIFIED and name this project. A suffix
// comparison would also have made the live run pass, and would have accepted
// projects/<any-other-project>/secrets/<same-name> -- re-opening the cross-project hole this guard
// exists to close.
fn classify_migration_authorization(
  supplied: String,
  desired: SecretRef,
) -> MigrationAuthorizationOutcome {
  let resolved = secret_ref_secret_resource(ref: desired)
  let canonical = gcp_secret_resource_by_number(
    project_number: fleet_secrets_project_number, secret: desired.secret)
  if supplied == "" {
    MigrationUnauthorized
  } else if !gcp_resource_names_this_secret(
              returned: supplied,
              project: desired.project,
              project_number: fleet_secrets_project_number,
              secret: desired.secret) {
    MigrationAuthorizationNamesAnotherSecret { supplied: supplied, resolved: resolved }
  } else {
    MigrationAuthorized {
      authorization: ContainerMigrationAuthorization { secret_resource: canonical as NonEmptyStr },
    }
  }
}

// A DELETION'S OUTCOME IS THREE-WAY FOR THE SAME REASON THE OTHER MUTATIONS ARE, and the third arm
// is the one that matters most here. A transport loss or a server error leaves the deletion's commit
// state unknown, and the tempting recovery -- issue DELETE again -- is forbidden: deletion is
// addressed BY NAME, and a same-name secret may have been created in the interval, so a replay can
// destroy a container this run never observed. An unknown deletion is reconciled by READING, never
// by repeating the write.
type ContainerDeletionOutcome
  = ContainerDeleted
  | ContainerDeletionRefused { cause: NonEmptyStr }
  | ContainerDeletionOutcomeUnknown { cause: NonEmptyStr }

fn deletion_may_be_replayed(o: ContainerDeletionOutcome) -> Bool {
  match o {
    ContainerDeleted => false
    ContainerDeletionRefused { cause: _ } => false
    ContainerDeletionOutcomeUnknown { cause: _ } => false
  }
}

// A SUCCESSFUL DELETE IS NOT AN ABSENCE ORACLE, which is the whole reason this step is separate from
// the deletion itself. Secret Manager documents strong consistency for exactly one sequence -- add a
// version, then access that exact version -- and everything else, deletion included, is eventually
// consistent. So "the API accepted my DELETE" does not entitle the next line to assume the container
// is gone; only a read does, and if the read still reports the container present the run STOPS
// rather than deleting again or creating over it.
type PostDeletionObservation
  = PostDeletionAbsent
  | PostDeletionStillPresent { resource: String }
  | PostDeletionUnobserved { cause: NonEmptyStr }

fn absence_is_established(o: PostDeletionObservation) -> Bool {
  match o {
    PostDeletionAbsent => true
    PostDeletionStillPresent { resource: _ } => false
    PostDeletionUnobserved { cause: _ } => false
  }
}

// THE DELETE IS FENCED TO THE GENERATION THAT WAS OBSERVED AND AUTHORIZED, not to a name. Secret
// Manager accepts an etag on delete as an optimistic-concurrency fence: the deletion commits only if
// the etag still matches what is stored. Without one, DELETE removes whatever occupies that name at
// arrival, and there is a real window even on the FIRST attempt -- observe Secret A, do local work,
// and if something replaces A with a same-name Secret B in between, an unfenced delete removes B.
// The operator authorized destroying the out-of-band object that was observed, not whatever later
// occupies that string.
//
// SO NAME AND ETAG TRAVEL TOGETHER IN ONE SEALED VALUE, and delete_observed_secret takes only that
// value. This is the same argument-position discipline as OwnedCredentialSnapshot, applied to the
// one operation in this chain that cannot be undone: there is no call site at which a caller can
// pair one secret's name with another generation's etag, because there is no such pair to write.
type ObservedSecretForDeletion sole_constructor {
  resource: NonEmptyStr
  etag: NonEmptyStr
}

fn observed_resource(o: ObservedSecretForDeletion) -> NonEmptyStr { o.resource }
fn observed_etag(o: ObservedSecretForDeletion) -> NonEmptyStr { o.etag }

type DeletionSubjectObservation
  = DeletionSubjectObserved { observed: ObservedSecretForDeletion }
  | DeletionSubjectNamesAnotherResource { returned: String, expected: String }
  | DeletionSubjectHasNoEtag { resource: String }
  | DeletionSubjectUnobserved { cause: NonEmptyStr }

// A MISSING ETAG REFUSES RATHER THAN FALLING BACK TO AN UNFENCED DELETE, which is the whole point.
// The tempting arm -- "no etag, so delete by name" -- is the absorbing fallback DESIGN section 5
// names: it converts an inability to fence into permission to proceed unfenced, and it does so
// exactly when the service told us something we did not expect.
//
// THE RETURNED RESOURCE IS CHECKED AGAINST THE EXPECTED ONE for the same reason the credential fetch
// checks its response identity: a capability minted from an answer about a different object would
// authorize destroying that object.
// THE OBSERVED CARRIER IS NORMALIZED FOR THE SAME REASON THE AUTHORIZATION ONE IS, and leaving it
// verbatim was a residue of the fix one function up. This predicate ACCEPTS either fully-qualified
// spelling and then stored returned_resource exactly as the service sent it, while
// classify_migration_authorization normalizes its side -- so delete_observed_secret, which
// exact-compares the two carriers, would admit an ID-spelled response here and refuse it one
// function later. GCP's measured behaviour is to answer in the number spelling, so the live route
// never took that path; the asymmetry was a latent disagreement between two guards that must agree,
// which is precisely the shape that produced the four spelling sites in the first place.
//
// NORMALIZING FROM THE CALLER'S secret RATHER THAN FROM returned_resource IS DELIBERATE. The
// returned value has already been checked to name this secret; re-deriving the canonical form from
// the subject the caller asked about means the carrier cannot inherit a spelling defect from the
// response, and the etag beside it still comes from the response that established the object exists.
fn classify_deletion_subject(
  returned_resource: String,
  returned_etag: String,
  expected_resource: String,
  project: GcpProjectId,
  secret: NonEmptyStr,
) -> DeletionSubjectObservation {
  if !gcp_resource_names_this_secret(
       returned: returned_resource,
       project: project,
       project_number: fleet_secrets_project_number,
       secret: secret) {
    DeletionSubjectNamesAnotherResource { returned: returned_resource, expected: expected_resource }
  } else if returned_etag == "" {
    DeletionSubjectHasNoEtag { resource: returned_resource }
  } else {
    DeletionSubjectObserved {
      observed: ObservedSecretForDeletion {
        resource: gcp_secret_resource_by_number(
          project_number: fleet_secrets_project_number, secret: secret) as NonEmptyStr,
        etag: returned_etag as NonEmptyStr,
      },
    }
  }
}

// OBSERVE THE SUBJECT AND MINT THE FENCE IN ONE PLACE, because the capability is only meaningful if
// it was derived from the answer that established the object exists. A separate "get the etag"
// helper would let a caller pair an etag from one read with a name from another.
fn observe_secret_for_deletion(
  project: GcpProjectId,
  secret: NonEmptyStr,
  expected_resource: String,
  token: Secret,
) -> DeletionSubjectObservation uses net: Network {
  let seen = gcp.SecretManager.GetSecret(
    access_token: token,
    project_id: project,
    secret: secret,
  )
  match seen.outcome {
    RestOk =>
      classify_deletion_subject(
        returned_resource: seen.name,
        returned_etag: seen.etag,
        expected_resource: expected_resource,
        project: project,
        secret: secret,
      )
    RestStatusRefused { status: _, body: body } =>
      DeletionSubjectUnobserved {
        cause: concat("the container could not be read, so no deletion fence exists: ", body) as NonEmptyStr,
      }
    RestTransportRefused { cause: cause } =>
      DeletionSubjectUnobserved {
        cause: concat("no response arrived for GetSecret, so the deletion subject was never observed: ", cause as String) as NonEmptyStr,
      }
    RestBodyUndecodable { status: _, cause: cause } =>
      DeletionSubjectUnobserved {
        cause: concat("GetSecret answered with a body this client could not decode: ", cause as String) as NonEmptyStr,
      }
  }
}

// THE DELETE TAKES THE CAPABILITY AND THE AUTHORIZATION, AND NOTHING ELSE. Neither a name nor an
// etag is a parameter here, so there is no call site at which they can be mismatched, and the
// authorization is checked against the SAME carrier that supplies the name -- an authorization for
// one secret cannot be spent on another's fence.
//
// EVERY NON-SUCCESS IS TERMINAL FOR THIS RUN. A refusal is a decision; an unknown is unknown; and
// neither authorizes a second DELETE, because deletion is addressed by name and a same-name secret
// may occupy it by the time a replay arrives. Reconciliation is by READING, never by repeating.
fn delete_observed_secret(
  observed: ObservedSecretForDeletion,
  authorization: ContainerMigrationAuthorization,
  token: Secret,
) -> ContainerDeletionOutcome uses net: Network {
  if (authorized_resource(a: authorization) as String) != (observed_resource(o: observed) as String) {
    ContainerDeletionRefused {
      cause: concat(concat(
        "the migration authorization names ", authorized_resource(a: authorization) as String),
        concat(" but the observed deletion subject is ", observed_resource(o: observed) as String)) as NonEmptyStr,
    }
  } else {
    let removed = gcp.SecretManager.DeleteSecret(
      access_token: token,
      secret_name: observed_resource(o: observed) as String,
      etag: observed_etag(o: observed) as String,
    )
    match classify_rest_outcome(standing: RestMutationExchange { rest: removed.outcome }) {
      RestExchangeSucceeded => ContainerDeleted
      RestExchangeStatusRefused { status: _, body: body } =>
        ContainerDeletionRefused {
          cause: concat("the service refused to delete the container: ", body) as NonEmptyStr,
        }
      RestExchangeCommitAmbiguous { detail } =>
        ContainerDeletionOutcomeUnknown { cause: detail }
      RestExchangeUnreached { cause } =>
        ContainerDeletionOutcomeUnknown { cause: cause }
      RestExchangeUndecodable { status: _, cause } =>
        ContainerDeletionOutcomeUnknown { cause: cause }
    }
  }
}

// ONLY A 404 ESTABLISHES ABSENCE; EVERY OTHER NON-SUCCESS IS AN UNANSWERED QUESTION. A 403 means the
// caller was not allowed to look, a 401 that it was not authenticated, a transport refusal that
// nothing was reached at all -- and none of those are evidence the container is gone. Mapping any of
// them to Absent would be the absorbing fallback: an inability to observe converted into permission
// to create over whatever is actually there.
//
// THIS READ EXISTS BECAUSE A SUCCESSFUL DELETE IS NOT AN ABSENCE ORACLE. Secret Manager documents
// strong consistency for exactly one sequence -- add a version, then access THAT version -- so a
// 200 from DeleteSecret entitles the next step to nothing. If this read still reports the container
// present, the run STOPS: it does not delete again, and it does not create over it.
fn observe_container_absence(
  project: GcpProjectId,
  secret: NonEmptyStr,
  token: Secret,
) -> PostDeletionObservation uses net: Network {
  let seen = gcp.SecretManager.GetSecret(
    access_token: token,
    project_id: project,
    secret: secret,
  )
  match seen.outcome {
    RestOk => PostDeletionStillPresent { resource: seen.name }
    RestStatusRefused { status: status, body: body } =>
      if status == 404 {
        PostDeletionAbsent
      } else {
        PostDeletionUnobserved {
          cause: concat("the container's absence could not be established: ", body) as NonEmptyStr,
        }
      }
    RestTransportRefused { cause: cause } =>
      PostDeletionUnobserved {
        cause: concat("no response arrived, so absence was never observed: ", cause as String) as NonEmptyStr,
      }
    RestBodyUndecodable { status: _, cause: cause } =>
      PostDeletionUnobserved {
        cause: concat("the absence probe answered with a body this client could not decode: ", cause as String) as NonEmptyStr,
      }
  }
}
