  snapshot_credential, CredentialSnapshotTaken, CredentialSnapshotRefused,
  CredentialSnapshotRefusedResidueRemains,
  OwnedCredentialSnapshot, VerifiedVersionForAttempt,
  create_secret_for_attempt, SecretCreatedForAttempt, SecretCreationRefused, SecretCreationOutcomeUnknown,
  add_initial_version, VersionAddedAndVerified, VersionAdditionRefused, VersionAdditionOutcomeUnknown,
  VersionAddedButUnverified,
}
