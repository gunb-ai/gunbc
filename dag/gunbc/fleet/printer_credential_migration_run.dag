  classify_migration_authorization, MigrationAuthorized, MigrationUnauthorized,
  MigrationAuthorizationNamesAnotherSecret,
  observe_secret_for_deletion, DeletionSubjectObserved, DeletionSubjectNamesAnotherResource,
  DeletionSubjectHasNoEtag, DeletionSubjectUnobserved,
  delete_observed_secret, ContainerDeleted, ContainerDeletionRefused, ContainerDeletionOutcomeUnknown,
  observe_container_absence, PostDeletionAbsent, PostDeletionStillPresent, PostDeletionUnobserved,
}

// THE ONE-INVOCATION MIGRATION, ORDERED SO THAT NOTHING IRREVERSIBLE HAPPENS BEFORE ITS PRECONDITION
// IS ESTABLISHED. Every step that can fail WITHOUT mutating anything runs first: resolve the
// printer, resolve its locus, check the authorization against what the locus resolved to, obtain the
// token, and capture the replacement credential into an OwnedCredentialSnapshot including its
// cleanup. Only once this run demonstrably POSSESSES replacement bytes does it spend the one
// operation that cannot be undone.
//
// THE ALTERNATIVE ORDERING IS THE OBVIOUS ONE AND IT IS WRONG: delete first, then discover the
// operator source file cannot be read, or its digest does not validate, or the token is absent. The
// container would be gone and the credential unrecoverable, having learned nothing that could not
// have been learned beforehand.
//
// THE PAYLOAD IS IDENTIFIED LAST, after a verified version exists. Delivery copies and hashes the
// .3mf into a private realization; doing that before provisioning means building and destroying a
// project realization only to discover the credential needs writing.
data migrate_authorization_env: NonEmptyStr = "PRINT_N_MIGRATE_SECRET"
data credential_source_env: NonEmptyStr = "PRINT_N_CREDENTIAL_SOURCE"
data printer_env: NonEmptyStr = "PRINT_N_WET_PRINTER"
data payload_env: NonEmptyStr = "PRINT_N_WET_PAYLOAD"

type MigrationStage
  = MigrationRefused { reason: NonEmptyStr }
  | MigrationVerified { verified: VerifiedVersionForAttempt }

type MigrationPrinterSelection
  = MigrationPrinterSelected { printer: PhysicalAssetIdentity }
  | MigrationPrinterUnrecognized { supplied: String }

fn select_printer(supplied: String) -> MigrationPrinterSelection {
  if supplied == (printer_01 as String) {
    MigrationPrinterSelected { printer: printer_01 }
  } else if supplied == (printer_02 as String) {
    MigrationPrinterSelected { printer: printer_02 }
  } else {
    MigrationPrinterUnrecognized { supplied: supplied }
  }
}

// CREATE, WRITE, AND VERIFY -- reached only from an OBSERVED absence, never from a delete's success.
// Every non-verified arm is terminal for this run: an unknown creation or addition may already have
// committed, so retrying would be a second write against a container this run can no longer reason
// about, and a version that landed but failed its read-back holds content this attempt did not
// intend and must be investigated rather than overwritten.
func provision_verified_version(
  printer: PhysicalAssetIdentity,
  desired: SecretRef,
  snapshot: OwnedCredentialSnapshot,
  token: Secret,
) -> MigrationStage uses net: Network {
  let attempt = concat("printer-credential-migration:", desired.secret as String) as SecretProvisionAttemptIdentity
  match create_secret_for_attempt(
    attempt: attempt,
    project: desired.project,
    secret_id: desired.secret,
    snapshot: snapshot,
    token: token,
  ) {
    SecretCreationRefused { cause: cause } =>
      MigrationRefused { reason: concat("CREATE REFUSED, and the old container is already gone: ", cause as String) as NonEmptyStr }
    SecretCreationOutcomeUnknown { cause: cause } =>
      MigrationRefused {
        reason: concat(concat("CREATE OUTCOME UNKNOWN: ", cause as String),
          " -- this run will not create again; reconcile by reading the container") as NonEmptyStr,
      }
    SecretCreatedForAttempt { capability: capability } =>
      match add_initial_version(capability: capability, token: token) {
        VersionAdditionRefused { cause: cause } =>
          MigrationRefused { reason: concat("ADD VERSION REFUSED: ", cause as String) as NonEmptyStr }
        VersionAdditionOutcomeUnknown { cause: cause } =>
          MigrationRefused {
            reason: concat(concat("ADD VERSION OUTCOME UNKNOWN: ", cause as String),
              " -- a version may hold this payload already; this run will not write again") as NonEmptyStr,
          }
        VersionAddedButUnverified { version: version, cause: cause } =>
          MigrationRefused {
            reason: concat(concat(concat("A VERSION LANDED AT ", version as String), " BUT DID NOT VERIFY: "),
              concat(cause as String, " -- disable that version rather than rewriting it")) as NonEmptyStr,
          }
        VersionAddedAndVerified { verified: verified } =>
          MigrationVerified { verified: verified }
      }
  }
}

// THE PROVISIONING HALF, returning either a sealed verification or a reason. It is separate from the
// delivery half so that the payload is never touched until a verified version exists.
//
// THE SNAPSHOT COMES BEFORE THE DELETE, which is the ordering this whole function exists to enforce.
// Possession of replacement bytes -- copied, digested, read, and its workspace removed -- is
// established while nothing has been mutated, because the deletion cannot be undone once spent. The
// opposite ordering discovers an unreadable source file or an invalid digest only after the
// credential is already unrecoverable.
func migrate_printer_credential(
  printer: PhysicalAssetIdentity,
  desired: SecretRef,
  supplied_authorization: String,
  source: FilePath,
  token: Secret,
) -> MigrationStage uses net: Network {
  match classify_migration_authorization(supplied: supplied_authorization, desired: desired) {
    MigrationUnauthorized =>
      MigrationRefused {
        reason: concat(concat(
          "NOT AUTHORIZED: set ", migrate_authorization_env as String),
          concat(" to exactly ", concat(secret_ref_secret_resource(ref: desired),
            " to authorize destroying that container; absence of authorization refuses so that a crashed run cannot escalate itself into a delete"))) as NonEmptyStr,
      }
    MigrationAuthorizationNamesAnotherSecret { supplied: supplied, resolved: resolved } =>
      MigrationRefused {
        reason: concat(concat("AUTHORIZATION NAMES ANOTHER SECRET: authorized ", supplied),
          concat(" but this printer's locus resolves to ", resolved)) as NonEmptyStr,
      }
    MigrationAuthorized { authorization: authorization } =>
      match snapshot_credential(source: source) {
        CredentialSnapshotRefused { cause: cause } =>
          MigrationRefused {
            reason: concat("NO REPLACEMENT CREDENTIAL, NOTHING DELETED: ", cause as String) as NonEmptyStr,
          }
        CredentialSnapshotRefusedResidueRemains { workspace: workspace, cause: cause } =>
          MigrationRefused {
            reason: concat(concat(
              "NO REPLACEMENT CREDENTIAL, NOTHING DELETED, AND PLAINTEXT MAY REMAIN AT ", workspace as String),
              concat(": ", cause as String)) as NonEmptyStr,
          }
        CredentialSnapshotTaken { snapshot: snapshot } =>
          match observe_secret_for_deletion(
            project: desired.project,
            secret: desired.secret,
            expected_resource: secret_ref_secret_resource(ref: desired),
            token: token,
          ) {
            DeletionSubjectUnobserved { cause: cause } =>
              MigrationRefused { reason: concat("DELETION SUBJECT NOT OBSERVED, NOTHING DELETED: ", cause as String) as NonEmptyStr }
            DeletionSubjectHasNoEtag { resource: resource } =>
              MigrationRefused {
                reason: concat(concat(
                  "NO DELETION FENCE AVAILABLE FOR ", resource),
                  ": the service returned no etag, and deleting by name alone would remove whatever occupies that name on arrival rather than the object that was observed") as NonEmptyStr,
              }
            DeletionSubjectNamesAnotherResource { returned: returned, expected: expected } =>
              MigrationRefused {
                reason: concat(concat("THE CONTAINER READ BACK AS ", returned), concat(" but this run expected ", expected)) as NonEmptyStr,
              }
            DeletionSubjectObserved { observed: observed } =>
              match delete_observed_secret(observed: observed, authorization: authorization, token: token) {
                ContainerDeletionRefused { cause: cause } =>
                  MigrationRefused { reason: concat("DELETE REFUSED: ", cause as String) as NonEmptyStr }
                ContainerDeletionOutcomeUnknown { cause: cause } =>
                  MigrationRefused {
                    reason: concat(concat("DELETE OUTCOME UNKNOWN, AND THIS RUN WILL NOT REPEAT IT: ", cause as String),
                      " -- reconcile by reading the container's state; a replay is addressed by name and could destroy a same-name secret created since") as NonEmptyStr,
                  }
                ContainerDeleted =>
                  match observe_container_absence(project: desired.project, secret: desired.secret, token: token) {
                    PostDeletionUnobserved { cause: cause } =>
                      MigrationRefused {
                        reason: concat("THE CONTAINER WAS DELETED BUT ITS ABSENCE COULD NOT BE ESTABLISHED, SO NOTHING WAS CREATED: ", cause as String) as NonEmptyStr,
                      }
                    PostDeletionStillPresent { resource: resource } =>
                      MigrationRefused {
                        reason: concat(concat(
                          "DELETE REPORTED SUCCESS BUT THE CONTAINER STILL READS AS PRESENT AT ", resource),
                          ": this run stops rather than deleting again or creating over it") as NonEmptyStr,
                      }
                    PostDeletionAbsent =>
                      provision_verified_version(
                        printer: printer, desired: desired, snapshot: snapshot, token: token)
                  }
              }
          }
      }
  }
}

// THE ENTRY POINT. Everything a person must supply is named by an environment variable and REFUSED
// when absent, because every default this actuator could invent is a guess about which machine to
// touch, which file holds a credential, or which container to destroy.
//
// THE SEALED VERIFICATION IS HANDED TO DELIVERY AS A ONE-ELEMENT POPULATION, and this is the moment
// B4 pays for itself: that value exists only because this process performed the write and read it
// back, so delivery's credential resolution is grounded in an effect this run actually caused rather
// than in an authored row anyone could have appended.
func run() -> ProcessExit uses net: Network {
  let requested_printer = shell.Env.Get(name: printer_env)
  match requested_printer.value {
    Absent =>
      exit_failure(reason: concat(concat("NO PRINTER: set ", printer_env as String), " to a declared printer identity"))
    Present { value: printer_name } =>
  match select_printer(supplied: printer_name) {
    MigrationPrinterUnrecognized { supplied: supplied } =>
      exit_failure(reason: concat("UNRECOGNIZED PRINTER: no declared asset identity matches ", supplied))
    MigrationPrinterSelected { printer: printer } =>
  match printer_access_code_locus(printer: printer) {
    PrinterAccessCodeLocusUnknown { printer: _ } =>
      exit_failure(reason: "NO LOCUS: this printer declares no access code locus")
    PrinterAccessCodeLocusConflict { printer: _, matches: _ } =>
      exit_failure(reason: "AMBIGUOUS LOCUS: more than one row declares this printer's access code")
    PrinterAccessCodeDesiredLocusFound { locus: locus } => {
      let supplied_authorization = shell.Env.Get(name: migrate_authorization_env)
      let source_path = shell.Env.Get(name: credential_source_env)
      let payload_locator = shell.Env.Get(name: payload_env)
      match source_path.value {
        Absent =>
          exit_failure(reason: concat(concat(
            "NO CREDENTIAL SOURCE: set ", credential_source_env as String),
            " to the path of the operator-held file holding this printer's access code"))
        Present { value: source } =>
      match payload_locator.value {
        Absent =>
          exit_failure(reason: concat(concat(
            "NO PAYLOAD: set ", payload_env as String),
            " to the .3mf this run will deliver. It is checked HERE, before anything irreversible, because a run that discovers it after the delete has spent the destructive operation to learn something it could have read first"))
        Present { value: payload_path } =>
      match read_supplied_access_token() {
        SuppliedTokenUnavailable { cause: cause } =>
          exit_failure(reason: concat("NO TOKEN: ", cause as String))
        SuppliedTokenReady { token: operator_token } =>
          match migrate_printer_credential(
            printer: printer,
            desired: locus.secret,
            supplied_authorization: authorization_text(supplied: supplied_authorization.value),
            source: source as FilePath,
            token: operator_token,
          ) {
            MigrationRefused { reason: reason } => exit_failure(reason: reason as String)
            MigrationVerified { verified: verified } =>
              deliver_after_provisioning(
                printer: printer,
                verified: verified,
                payload_path: payload_path as NonEmptyStr,
                token_source: OperatorSuppliedToken { token: operator_token })
          }
      }
      }
      }
    }
  }
  }
  }
}

// AN ABSENT AUTHORIZATION IS THE EMPTY STRING, WHICH classify_migration_authorization READS AS
// UNAUTHORIZED. Collapsing absent-and-empty here is safe in exactly one direction: both mean "no
// authorization was given", and both must refuse. The classifier owns that meaning rather than this
// projection inventing a second one.
fn authorization_text(supplied: String?) -> String {
  match supplied {
    Absent => ""
    Present { value: text } => text
  }
}

// THE PAYLOAD IS IDENTIFIED HERE AND NOWHERE EARLIER. Delivery copies the .3mf into a private
// realization and hashes THAT COPY; doing it before provisioning means building and destroying a
// project realization only to learn the credential still needed writing.
//
// THE SEALED VERIFICATION IS THE WHOLE POPULATION, and this is where B4 pays for itself. That value
// exists only because THIS process performed the write and read it back, so delivery's credential
// resolution is grounded in an effect this run caused rather than in a row anyone could have
// authored. A delivery-only entry point cannot construct one, which is exactly why the standalone
// wet run correctly reaches PROVISION REQUIRED.
// DELIVERY IS NOT THE END OF THE CHAIN ANY MORE, and this function no longer returns after it. A
// Bambu printer in LAN-only mode does not begin a job when a file lands on its card, so a run that
// stopped at ProjectDelivered reported success for a print that never started, and the remaining
// step was performed by a hand-written client outside the substrate. gunbc.fleet.printer_job_start
// models it, so the delivered arm continues into the start rather than exiting.
//
// THE SEQUENCE ID IS NO LONGER PASSED FROM HERE, and this is where the defect was. This function
// handed receipt_remote_name for both remote_name and sequence_id, which reads as economical and is
// a conflation: remote_name is derived from the payload's DIGEST, so every legitimate reprint of the
// same .3mf would carry the same attempt id, and a report from an earlier print could be joined to a
// later invocation. The attempt identity is now minted inside the start leg, which is the only scope
// that knows which execution is asking.
//
// THE PAYLOAD LOCATOR IS A PARAMETER NOW AND IS NO LONGER READ HERE. It used to be fetched from the
// environment at this point -- AFTER the etag-fenced delete and the re-provision -- so a run with the
// variable unset spent the one irreversible operation to discover a missing input it could have read
// first. Its refusal then advised rerunning delivery alone, which is impossible: the
// VerifiedVersionForAttempt that delivery resolves against exists only because THIS process
// performed the write, and it is gone when the invocation exits. The check moved into run()'s
// preflight, beside the printer, the locus, the authorization and the credential source, and the
// arm that could report that impossible remedy no longer exists to be reached.
func deliver_after_provisioning(
  printer: PhysicalAssetIdentity,
  verified: VerifiedVersionForAttempt,
  payload_path: NonEmptyStr,
  token_source: AccessTokenSource,
) -> ProcessExit uses net: Network {
      match identify_project_payload(payload: PrinterProjectPayload { local_path: payload_path }) {
        PayloadIdentificationRefused { local_path: p, cause: cause } =>
          exit_failure(reason: concat(concat("IDENTIFY REFUSED for ", p as String), concat(": ", cause as String)))
        PayloadIdentificationRefusedResidueRemains { local_path: p, residue_path: rp, cause: cause } =>
          exit_failure(reason: concat(
            concat(concat("IDENTIFY REFUSED, RESIDUE MAY REMAIN AT ", rp as String), concat(" for ", p as String)),
            concat(": ", cause as String)))
        PayloadIdentified { payload: identified } =>
          match deliver_project_to_printer(
            printer: printer,
            payload: identified,
            token_source: token_source,
            materializations: [verified],
          ) {
            ProjectDeliveryUnattempted { printer: _, cause: cause } =>
              exit_failure(reason: concat("UNATTEMPTED: ", cause as String))
            ProjectDeliveryRefused { printer: _, cause: cause } =>
              exit_failure(reason: concat("REFUSED: ", cause as String))
            ProjectDeliveryRefusedResidueRemains { printer: _, cause: cause } =>
              exit_failure(reason: concat("REFUSED, RESIDUE MAY REMAIN ON DISK: ", cause as String))
            ProjectDeliveryUnattemptedResidueRemains { printer: _, cause: cause } =>
              exit_failure(reason: concat("UNATTEMPTED, RESIDUE MAY REMAIN ON DISK: ", cause as String))
            ProjectDeliveryProvisionRequired { printer: _, desired: _ } =>
              exit_failure(reason: "PROVISION REQUIRED AFTER PROVISIONING: the verification this run minted did not satisfy the credential lookup, which is a defect in the threading rather than a missing credential")
            ProjectDeliveryProvisionRequiredResidueRemains { printer: _, desired: _, cause: cause } =>
              exit_failure(reason: concat("PROVISION REQUIRED AFTER PROVISIONING, RESIDUE MAY REMAIN: ", cause as String))
            ProjectTransferredCleanupRefused { receipt: r, cause: cause } =>
              exit_failure(reason: concat(
                concat("TRANSFERRED BUT CLEANUP REFUSED, remote=", receipt_remote_name(r: r) as String),
                concat(": ", cause as String)))
            ProjectDelivered { receipt: r } =>
              match start_print_on_printer(
                printer: printer,
                remote_name: receipt_remote_name(r: r),
                token_source: token_source,
                materializations: [verified],
              ) {
                PrintStartRefused { printer: _, cause: cause } =>
                  exit_failure(reason: concat(
                    concat("DELIVERED BUT NOT STARTED, remote=", receipt_remote_name(r: r) as String),
                    concat(": ", cause as String)))
                PrintStartOutcomeUnknown { printer: _, cause: cause } =>
                  exit_failure(reason: concat(
                    concat("DELIVERED, START OUTCOME UNKNOWN, remote=", receipt_remote_name(r: r) as String),
                    concat(": ", cause as String)))
                PrintStartOutcomeUnknownResidueRemains { printer: _, cause: cause } =>
                  exit_failure(reason: concat(
                    concat("DELIVERED, START OUTCOME UNKNOWN, RESIDUE MAY REMAIN, remote=", receipt_remote_name(r: r) as String),
                    concat(": ", cause as String)))
                PrintStartRefusedResidueRemains { printer: _, cause: cause } =>
                  exit_failure(reason: concat(
                    concat("DELIVERED BUT NOT STARTED, RESIDUE MAY REMAIN, remote=", receipt_remote_name(r: r) as String),
                    concat(": ", cause as String)))
                PrintStartPublishedCleanupRefused { receipt: _, cause: cause } =>
                  exit_failure(reason: concat("START PUBLISHED BUT CLEANUP REFUSED: ", cause as String))
                PrintStartPublished { receipt: _ } => ExitSuccess
              }
          }
      }
}
