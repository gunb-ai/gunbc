import gunbc.auth.approval_decision_store {
  grant_from_store,GrantDerivation,GrantDerived,GrantStillPending,GrantEscalationNotFiled,GrantForAnotherIntent,GrantStoreUnreadable,
  approval_decision_store_root,
}

// One fleet controller owns scheduling; printer lifetimes overlap inside that hold.
// Existing single starts also acquire it, so a legacy entry cannot race a batch.
// A crashed/uncertain owner remains held until the existing dead-holder recovery
// protocol establishes recovery; merely using the same owner text does not re-enter.
data hold_key:NonEmptyStr = "fleet-print-controller"

// THE OWNER NAME IS THE AUTHORIZATION PLUS THE PROCESS THAT TOOK THE SLOT, the pattern
// gunbc.host.managed_host_unit_hold and extdeps.realization.materialization_store_local already
// write: <escalation_id> ++ process_hold_text. The escalation id keeps the slot readable as an
// authorization (the reconciliation census matches on it); the process part is what makes the
// holder observable at all, so a controller that died can be proven dead instead of leaving the
// slot held forever. Where this host cannot name its own process (/proc unreadable), the owner
// falls back to the authorization ALONE, which is exactly the shape of the pre-existing holds; the
// recovery arm below treats that as unobservable rather than letting an unidentifiable holder
// conclude anything about itself.
fn printer_execution_hold_owner_text(escalation_id:NonEmptyStr) -> NonEmptyStr {
  match self_process_identity() {
    SelfIdentified{process:p,pid_namespace:n}=>concat(escalation_id as String,process_hold_text(p:p,pid_namespace:n)) as NonEmptyStr
    SelfUnidentified{cause:_}=>escalation_id
  }
}

// THE RENDERED OWNER'S PROCESS PART, decoded back or named as unobservable. The marker splits the
// authorization from the process fields (same split the other roots use), and a holder with no
// marker names no process at all: that is not a corruption, it is a hold written before owners
// carried a process, and the caller decides what an unobservable holder is worth.
type PrinterExecutionHoldHolder
  = PrinterExecutionHoldHolderProcess { escalation_id:NonEmptyStr, process:ProcessIdentity, pid_namespace:NonEmptyStr }
  | PrinterExecutionHoldHolderUnobservable { cause:NonEmptyStr }

fn printer_execution_hold_holder(holder:DurableHoldOwnerRef) -> PrinterExecutionHoldHolder {
  let halves = split(s:holder as String,delimiter:process_hold_marker)
  if count(halves) != 2 || text_at(xs:halves,i:0) == "" {
    PrinterExecutionHoldHolderUnobservable { cause:"the holder's owner names no process this module can observe (it was written without one, or not by this module)" as NonEmptyStr }
  } else {
    match process_hold_decode(text:concat("boot=",text_at(xs:halves,i:1))) {
      Present{value:h}=>PrinterExecutionHoldHolderProcess { escalation_id:text_at(xs:halves,i:0) as NonEmptyStr, process:h.process, pid_namespace:h.pid_namespace }
      Absent=>PrinterExecutionHoldHolderUnobservable { cause:"the holder's owner carries a process part this module cannot decode" as NonEmptyStr }
    }
  }
}
// HOW THIS ROOT OBSERVES ITS HOLDER'S LIVENESS. A holder that names a process is answered from
// procfs by gunbc.process_hold_identity's root-agnostic probe; one that names no process is named
// unobservable, never assumed dead. Passed BY NAME to the store's one generalized recovery -- the
// same shape gunbc.host.managed_host_unit_hold passes its systemd-unit probe. This is the only
// thing that differs between roots; the observe-prove-release sequence itself lives once in
// gunbc.durable_exclusive_hold_file_store.
fn printer_execution_hold_live_owner(holder:DurableHoldOwnerRef) -> DurableHoldHolderLiveness {
  match printer_execution_hold_holder(holder:holder) {
    PrinterExecutionHoldHolderProcess {escalation_id:_,process:p,pid_namespace:n}=>holder_process_liveness(p:p,pid_namespace:n)
    PrinterExecutionHoldHolderUnobservable {cause:c}=>HolderLivenessUnobservable {cause:c}
  }
}

// WHAT THE OPERATOR IS ASKED TO OBSERVE, as a request the approval route can file and decide. It
// names the escalation whose converge must not be running and the device that must be idle, and its
// SUBJECT is the exact hold being freed -- root/slot, holder, generation -- which is precisely what
// std.durable_exclusive_hold checks a grant against (durable_hold_nonholder_subject_refusal): an
// approval filed to release any other hold cannot reach this one. The verb is the filesystem Write
// over the claim directory this hold lives in, the action says non-holder release, and
// destructive:true is the truth -- releasing a live holder's slot would stop a print mid-layer.
data printer_operator_observation_verb:AuthorizationScope = AuthorizationScope {
  verb: Write,
  resource: NamespacePosition { tree: FilesystemPathTree, path: ["hold","printer-start-claim"] },
  action: "hold.release-non-holder" as AuthorizedAction,
}

data printer_operator_observation_attempt:AttemptIdentity = ("printer-start-stale-hold-release" as NonEmptyStr) as AttemptIdentity

// THE SENTENCE THE OPERATOR READS ON THE PHONE. It states what they are attesting to -- no controller
// driving this printer, the printer idle -- and what approving frees. It is NOT the intent: the intent
// is the hashed (root, slot, holder, generation) below, and this line is allowed to be reworded
// without invalidating a decision already made.
data printer_operator_observation_purpose:NonEmptyStr = "no fleet controller is driving printer-01 and the printer is idle; approving frees the stale printer-start hold on the fleet print-controller slot"

// THE INTENT IS THE PLANNED ACTION ITSELF: which slot, under which root, over which holder and
// generation. Hashing a constant label here would let an observation approved for ANY hold release
// EVERY hold (the revision is that hash, and the derived grant's subject comes from the request), so
// consent would be a flag, not a decision about one specific hold. Same shape as
// gunbc.serving.serving_key_grant / rented_host_grant: intent text of the subject, then hashed.
fn printer_operator_observation_intent_text(hold_root:NonEmptyStr,hold_slot:NonEmptyStr,holder:DurableHoldOwnerRef,generation:CasGeneration) -> NonEmptyStr {
  join(["printer-start-stale-hold-release-v1 root=",hold_root as String," slot=",hold_slot as String," holder=",holder as String," generation=",int_to_decimal_string(value:cas_generation_count(g:generation))],"") as NonEmptyStr
}

// THE ESCALATION THE OBSERVATION IS FILED AND DECIDED UNDER, derived from the HOLD itself -- root,
// slot, holder, generation -- and NOT from the escalation of the converge that happened to meet the
// hold. One escalation slot carries exactly ONE request: file_approval_request publishes
// ExpectSlotAbsent, and grant_from_store answers a slot decided under another revision as
// GrantForAnotherIntent. By the time the release arm below runs, the print-start approval has already
// occupied the print request's escalation id, so an observation filed there could only ever be
// answered AnotherIntent -- the route would be reachable only from a witness that writes the store by
// hand. Deriving the id from the hold is also what lets a LATER dispatch redeem the decision the
// operator already made: the print escalation id moves with every new request id, this one does not
// move until the hold itself does (a new holder or generation re-asks; the same stale hold does not).
fn printer_hold_observation_escalation_id(hold_root:NonEmptyStr,hold_slot:NonEmptyStr,holder:DurableHoldOwnerRef,generation:CasGeneration) -> NonEmptyStr {
  join(["printer-hold-release-",sha256_hex(message:bytes_octets(b:utf8_encode_bytes(s:printer_operator_observation_intent_text(hold_root:hold_root,hold_slot:hold_slot,holder:holder,generation:generation) as String)))],"") as NonEmptyStr
}

fn printer_operator_observation_request(hold_root:NonEmptyStr,hold_slot:NonEmptyStr,holder:DurableHoldOwnerRef,generation:CasGeneration) -> AuthorizationRequest<DurableHoldSubject> {
  AuthorizationRequest {
    escalation_id: printer_hold_observation_escalation_id(hold_root:hold_root,hold_slot:hold_slot,holder:holder,generation:generation),
    scopes: [printer_operator_observation_verb],
    subject: DurableHoldSubject { hold:file_hold_ref(root:hold_root,slot_key:hold_slot), holder:holder, generation:generation },
    purpose: printer_operator_observation_purpose,
    attempt: printer_operator_observation_attempt,
    intent_hash: content_hash_of_value(value:printer_operator_observation_intent_text(hold_root:hold_root,hold_slot:hold_slot,holder:holder,generation:generation)),
    destructive: true,
  }
}

type PrinterExecutionHold sole_constructor {owner:DurableHoldOwnerRef,generation:CasGeneration}
fn hold_current(hold:PrinterExecutionHold) -> Bool {
 match observe_file_hold(root:printer_start_claim_directory,key:hold_key) {
  HoldSlotHeld {owner:o,generation:g}=>durable_hold_owner_equal(left:o,right:hold.owner) && cas_generation_count(g:g)==cas_generation_count(g:hold.generation)
  HoldSlotAbsent=>false HoldSlotFree {generation:_,released_by:_}=>false HoldSlotUndecodable {generation:_,detail:_}=>false HoldObservationUnavailable {cause:_}=>false
 }
}
fn store_failure_detail(cause:CasStoreFailure) -> String {
 match cause {
  CasSlotObservationRefused {cause:u}=>concat("read refused -- ",cas_unreadable_slot_detail(cause:u))
  CasGenerationPublicationRefused {detail:d}=>concat("write refused -- ",d as String)
  CasGenerationSpaceExhausted {head:h}=>concat("generation space exhausted at head generation ",int_to_decimal_string(value: cas_generation_count(g:h)))
 }
}
// WHAT THE SLOT SAID, in the store's own words. The holder text and generation are admission
// evidence, not secrets: an operator reading the run log should never need a root shell on srv1 to
// learn who holds the controller. (Before this, one masked sentence for every refusal made a
// 4.5-day stale hold a cross-machine forensic hunt.)
fn printer_hold_slot_text(slot_key:NonEmptyStr,holder:DurableHoldOwnerRef,generation:CasGeneration) -> String {
  join(["owner '",holder as String,"' (slot ",slot_key as String,", generation ",int_to_decimal_string(value: cas_generation_count(g:generation)),") "],"")
}

// THE ACQUIRE-USE-RELEASE DANCE, spelled ONCE and used by the first attempt and by every retry
// after a recovery -- because the one thing the retries must not change is the discipline that only
// the holder it just won may free its own slot, at the generation it won.
fn printer_hold_run_acquired(root:NonEmptyStr,slot_key:NonEmptyStr,owner:NonEmptyStr,held:PrinterExecutionHold,use:fn(PrinterExecutionHold)->ProcessExit) -> ProcessExit {
   let result=use(held)
   match result {
    ExitSuccess=>match file_hold_release_assess(root:root,slot_key:slot_key,owner:held.owner,acquired_generation:held.generation,released_by:owner as DurableHoldReleaseRef) {
     FileHoldReleasePlanned {plan:p}=>match file_hold_release_commit(plan:p) {FileHoldReleased {slot_key:_,generation:_}=>ExitSuccess FileHoldReleaseLost {slot_key:_}=>exit_failure(reason:"Printer controller hold release failed; do not start another controller") FileHoldReleaseStoreUnavailable {slot_key:_,cause:_}=>exit_failure(reason:"Printer controller hold release failed; do not start another controller") FileHoldReleaseKeyNotSlotAddressable {slot_key:_}=>exit_failure(reason:"Printer controller hold release failed; do not start another controller")}
     FileHoldReleaseNotEligible {slot_key:_,refusal:_}=>exit_failure(reason:"Printer controller hold changed before release")
    }
    other=>other
   }
}

// THE ONE RETRY, after a release committed. The slot is free and unheld, so the next acquire either
// wins or meets a BRAND-NEW holder -- which is a live-controller story and refuses live, because a
// second controller took the slot in the meantime: it is NOT dead by the evidence that freed the
// first one, and re-running recovery off the old verdict would release a slot whose current holder
// was never observed at all.
fn printer_hold_retry_after_release(root:NonEmptyStr,slot_key:NonEmptyStr,owner:NonEmptyStr,use:fn(PrinterExecutionHold)->ProcessExit,prior:NonEmptyStr) -> ProcessExit {
  match file_hold_acquire(root:root,slot_key:slot_key,requested_owner:owner as DurableHoldOwnerRef) {
    FileHoldAcquired {slot_key:_,owner:o2,generation:g2}=>printer_hold_run_acquired(root:root,slot_key:slot_key,owner:owner,held:PrinterExecutionHold {owner:o2,generation:g2},use:use)
    FileHoldOccupied {slot_key:k,holder:h,generation:g}=>exit_failure(reason:join(["Printer fleet controller: ",prior as String,"; the retry then met a LIVE occupant ",printer_hold_slot_text(slot_key:k,holder:h,generation:g),". Never a second controller."],""))
    FileHoldAcquireLost {slot_key:k}=>exit_failure(reason:join(["Printer fleet controller claim on slot ",k as String," was lost to a racing controller after the stale hold was freed; no second controller admitted."],""))
    FileHoldAcquireStoreUnavailable {slot_key:k,cause:c}=>exit_failure(reason:concat(concat("Printer fleet controller store on slot ",concat(k as String," is unavailable after the stale hold was freed: ")),store_failure_detail(cause:c)))
    FileHoldSlotUndecodable {slot_key:k,generation:g,detail:d}=>exit_failure(reason:join(["Printer fleet controller slot ",k as String," is undecodable at generation ",int_to_decimal_string(value: cas_generation_count(g:g)),": ",d as String," after the stale hold was freed; no second controller admitted."],""))
    FileHoldKeyNotSlotAddressable {slot_key:k}=>exit_failure(reason:join(["Printer fleet controller slot key '",k as String,"' is not slot-addressable after the stale hold was freed; no second controller admitted."],""))
  }
}

// THE OPERATOR-OBSERVED RELEASE, for a holder this root cannot observe. The consent is not this
// module's to invent: it is looked up in gunbc.auth.approval_gate's decision store -- the same
// route gunbc.auth.approval_device_redemption.redeem_device_over_store commits to -- under the
// escalation id the HOLD carries (printer_hold_observation_escalation_id: root, slot, holder,
// generation; see why below), and the authorization is taken over that grant by
// std.scoped_authorization's own `authorize` at a real clock instant, so expiry is the std rule and
// not a local guess. The request's subject NAMES the exact hold being freed (root/slot, holder,
// generation), which is what std checks the grant against: an approval filed to release a different
// hold, holder or generation cannot reach this one. Nothing here reads a flag and nothing here
// shells out; without a decided observation the hold STAYS HELD and the refusal names the missing
// thing by type -- not filed, pending, decided for another intent, store unreadable, expired,
// refused -- each its own sentence.
// WHY THE CONSENT DOES NOT LIVE UNDER THE PRINT ESCALATION: this function is handed the print
// escalation id, and one escalation slot carries exactly ONE request (file_approval_request publishes
// ExpectSlotAbsent; a slot decided under another revision answers GrantForAnotherIntent). By the time
// this arm runs, that slot already carries the print-start approval the same converge filed and the
// operator already decided -- so an observation filed there could only ever be answered
// AnotherIntent, and the release would be reachable only from a witness that writes the store by
// hand. The print id remains what the freed slot is NAMED for (printer_execution_hold_owner_text) and
// what the refusal quotes, because that is the converge the operator is being asked about.
fn printer_hold_release_on_operator_observation(root:NonEmptyStr,approvals_root:NonEmptyStr,hold_slot:NonEmptyStr,escalation_id:NonEmptyStr,holder:DurableHoldOwnerRef,generation:CasGeneration,cause:NonEmptyStr,use:fn(PrinterExecutionHold)->ProcessExit) -> ProcessExit {
  match approval_instant_now() {
    Absent=>exit_failure(reason:"Cannot read the clock; an operator observation cannot be checked for expiry, and the stale printer-start hold stays held")
    Present{value:now}=>
      match printer_hold_operator_grant(root:root,approvals_root:approvals_root,hold_slot:hold_slot,holder:holder,generation:generation,observed_at:now) {
        PrinterHoldOperatorGrantMissing {cause:mc}=>exit_failure(reason:join(["Printer fleet controller is held by an UNOBSERVABLE holder: ",printer_hold_slot_text(slot_key:hold_slot,holder:holder,generation:generation),cause as String," ",printer_hold_operator_grant_missing_detail(cause:mc),". Nothing released."],""))
        PrinterHoldOperatorGrantHeld {decision:d}=>
          match printer_hold_nonholder_assess(root:root,hold_slot:hold_slot,request:ReleasedByOperator {authorization:d},released_by:join(["operator-observed-release:",holder as String],"") as DurableHoldReleaseRef) {
            FileHoldNonHolderReleasePlanned {plan:p,released_holder:rh,basis:_}=>
              match file_hold_release_commit(plan:p) {
                FileHoldReleased {slot_key:_,generation:_}=>printer_hold_retry_after_release(root:root,slot_key:hold_slot,owner:printer_execution_hold_owner_text(escalation_id:escalation_id),use:use,prior:join(["the stale printer-start hold on slot ",hold_slot as String," (holder ",rh as String,") was released on the operator's approved observation"],""))
                FileHoldReleaseLost {slot_key:_}=>exit_failure(reason:join(["the stale printer-start hold on slot ",hold_slot as String," moved under the operator-observed release; nothing released, re-run"],""))
                FileHoldReleaseStoreUnavailable {slot_key:_,cause:cs}=>exit_failure(reason:join(["the printer-start claim store refused the operator-observed release on slot ",hold_slot as String,": ",store_failure_detail(cause:cs)],""))
                FileHoldReleaseKeyNotSlotAddressable {slot_key:_}=>exit_failure(reason:join(["the printer-start hold slot key ",hold_slot as String," is not slot-addressable; the operator-observed release did not commit"],""))
              }
            FileHoldNonHolderReleaseNotEligible {slot_key:_,refusal:r}=>exit_failure(reason:join(["the operator observation did not release this hold: ",printer_hold_slot_text(slot_key:hold_slot,holder:holder,generation:generation),"-- ",printer_nonholder_refusal_detail(refusal:r)],""))
          }
      }
  }
}

// THE OPERATOR'S OBSERVATION, PINNED TO A TYPE. std's non-holder-release protocol is generic in what
// a consumer's observation means; here the operator's claim is a sentence about this escalation and
// this device, so the observation type is NonEmptyStr and the ONLY arm this module ever builds is
// ReleasedByOperator -- the evidence arm (NonHolderReleaseOnEvidence) is the other consumer's route
// and is never constructed here, so a stale hold can never be freed by "evidence" this module itself
// produced. Admission lives on the store's admit_callers for this function.
fn printer_hold_nonholder_assess(root:NonEmptyStr,hold_slot:NonEmptyStr,request:DurableHoldNonHolderRelease<NonEmptyStr>,released_by:DurableHoldReleaseRef) -> FileHoldNonHolderReleaseAssessment<NonEmptyStr> {
  file_hold_nonholder_release_assess(root:root,slot_key:hold_slot,request:request,released_by:released_by)
}

// WHAT A NON-HOLDER-RELEASE REFUSAL MEANS, every arm in its own words, so the operator reading the
// run log knows whether to wait (section incomplete), to look (unobservable), or to file a different
// observation (the subject named a different hold, holder or generation).
fn printer_nonholder_refusal_detail(refusal:DurableHoldNonHolderReleaseRefusal<NonEmptyStr>) -> NonEmptyStr {
  match refusal {
    NonHolderReleaseNothingHeld=>"nothing was held when the release looked" as NonEmptyStr
    NonHolderReleaseForAnotherHold {hold:h,subject:s}=>join(["the approved observation is for hold ",s as String," but this is ",h as String],"") as NonEmptyStr
    NonHolderReleaseForAnotherHolder {holder:h,subject:s}=>join(["the approved observation names holder ",s as String," but the slot is held by ",h as String],"") as NonEmptyStr
    NonHolderReleaseSlotMoved {subject:_,observed:_}=>"the slot moved since the observation was decided; the observation is about a hold that no longer stands" as NonEmptyStr
    NonHolderReleaseSectionIncomplete {generation:_,holder:_,observation:o}=>join(["the operator's observation says the converge section is still incomplete: ",o as String],"") as NonEmptyStr
    NonHolderReleaseCompletionUnobservable {generation:_,holder:_,cause:c}=>join(["the converge completion could not be observed: ",c as String],"") as NonEmptyStr
    NonHolderReleaseNotAuthorized {generation:_,holder:_,cause:c}=>join(["the operator authorization does not reach this release: ",authorization_refusal_reason(cause:c)],"") as NonEmptyStr
    NonHolderReleaseSlotUndecodable {generation:g,detail:d}=>join(["the slot is undecodable at generation ",int_to_decimal_string(value: cas_generation_count(g:g)),": ",d as String],"") as NonEmptyStr
    NonHolderReleaseObservationUnavailable {cause:c}=>join(["the slot could not be read: ",cas_unreadable_slot_detail(cause:c)],"") as NonEmptyStr
  }
}

// WHAT A DEAD-HOLDER RECOVERY REFUSAL MEANS, in the store's own words, for the run log.
fn printer_recovery_refusal_detail(refusal:DurableHoldRecoveryRefusal) -> NonEmptyStr {
  match refusal {
    HoldRecoveryNothingHeld=>"the slot was no longer held when recovery looked" as NonEmptyStr
    HoldRecoveryHolderLive {generation:_,holder:h,evidence:e}=>join(["holder ",h as String," was observed live: ",e as String],"") as NonEmptyStr
    HoldRecoveryHolderUnobservable {generation:_,holder:h,cause:c}=>join(["holder ",h as String," is unobservable: ",c as String],"") as NonEmptyStr
    HoldRecoverySlotMoved {reported:_,observed:_}=>"the slot moved since the liveness observation; the report is about a hold that no longer stands" as NonEmptyStr
    HoldRecoveryReportForAnotherHolder {holder:h,reported:r}=>join(["the liveness report names holder ",r as String," but the slot is held by ",h as String],"") as NonEmptyStr
    HoldRecoverySlotUndecodable {generation:g,detail:d}=>join(["the slot is undecodable at generation ",int_to_decimal_string(value: cas_generation_count(g:g)),": ",d as String],"") as NonEmptyStr
    HoldRecoveryObservationUnavailable {cause:c}=>join(["the slot could not be read: ",cas_unreadable_slot_detail(cause:c)],"") as NonEmptyStr
  }
}

// THE OPERATOR'S OBSERVATION, read back from the approval decision store. The gate is the store's
// own: the escalation must be FILED and APPROVED for this module's intent hash, and std's `authorize`
// then decides the grant against the request at `now` (expiry included). Both arms below: Held is the
// ONLY one that can release; every Missing answer keeps the hold held and carries its own typed
// cause, defined next.
type PrinterHoldOperatorGrant
  = PrinterHoldOperatorGrantHeld { decision: AuthorizationDecision<DurableHoldSubject> }
  | PrinterHoldOperatorGrantMissing { cause: PrinterHoldOperatorGrantCause }

// THE MISSING ANSWER KEEPS THE STORE'S TYPE. Pending, not-filed, decided-for-another-intent,
// unreadable and refused-by-authorize are five different facts, and the operator reading the refusal
// needs to know WHICH step to take next (decide it, file it, re-file it for this hold, fix the
// store). Collapsing them at the arm is how a deny becomes a re-notification loop; the sentence is
// rendered only at the refusal site, so no consumer ever string-matches to tell them apart.
type PrinterHoldOperatorGrantCause
  = PrinterHoldGrantStillPending { escalation_id: NonEmptyStr }
  | PrinterHoldGrantNotFiled { escalation_id: NonEmptyStr }
  | PrinterHoldGrantAnotherIntent { requested_revision: NonEmptyStr, decided_revision: NonEmptyStr }
  | PrinterHoldGrantStoreUnreadable { detail: NonEmptyStr }
  | PrinterHoldGrantAuthorizeRefused { cause: AuthorizationRefusalCause }

fn printer_hold_operator_grant_missing_detail(cause:PrinterHoldOperatorGrantCause) -> NonEmptyStr {
  match cause {
    PrinterHoldGrantStillPending {escalation_id:e}=>join(["the operator observation for escalation ",e as String," is filed but nobody has decided it yet"],"") as NonEmptyStr
    PrinterHoldGrantNotFiled {escalation_id:e}=>join(["no operator observation is filed for escalation ",e as String,"; the stale printer-start hold stays held"],"") as NonEmptyStr
    PrinterHoldGrantAnotherIntent {requested_revision:r,decided_revision:d}=>join(["the decided observation for this escalation was decided for a different intent (requested ",r as String,", decided ",d as String,"); nothing released"],"") as NonEmptyStr
    PrinterHoldGrantStoreUnreadable {detail:d}=>join(["the approval decision store is unreadable: ",d as String],"") as NonEmptyStr
    PrinterHoldGrantAuthorizeRefused {cause:c}=>authorization_refusal_reason(cause:c) as NonEmptyStr
  }
}

fn printer_hold_operator_grant(root:NonEmptyStr,approvals_root:NonEmptyStr,hold_slot:NonEmptyStr,holder:DurableHoldOwnerRef,generation:CasGeneration,observed_at:Timestamp) -> PrinterHoldOperatorGrant {
  let request = printer_operator_observation_request(hold_root:root,hold_slot:hold_slot,holder:holder,generation:generation)
  match grant_from_store(root:approvals_root,request:request) {
    GrantDerived {authorization:a}=>
      match authorize(authorization:a,request:request,observed_at:observed_at) {
        AuthorizationPermitted {grant:g} => PrinterHoldOperatorGrantHeld { decision: AuthorizationPermitted { grant: g } }
        AuthorizationRefused {cause:c} => PrinterHoldOperatorGrantMissing { cause: PrinterHoldGrantAuthorizeRefused { cause: c } }
      }
    GrantStillPending {escalation_id:e}=>PrinterHoldOperatorGrantMissing {cause:PrinterHoldGrantStillPending {escalation_id:e}}
    GrantEscalationNotFiled {escalation_id:e}=>PrinterHoldOperatorGrantMissing {cause:PrinterHoldGrantNotFiled {escalation_id:e}}
    GrantForAnotherIntent {requested_revision:r,decided_revision:d}=>PrinterHoldOperatorGrantMissing {cause:PrinterHoldGrantAnotherIntent {requested_revision:r,decided_revision:d}}
    GrantStoreUnreadable {detail:d}=>PrinterHoldOperatorGrantMissing {cause:PrinterHoldGrantStoreUnreadable {detail:d}}
  }
}

// THE PRINTER ROOT'S ENTRY, PRODUCTION WIRING: the real claim directory, the real hold slot and the
// real approval store. Everything below is the SAME code the witnesses run -- they only name
// different roots -- so no witness ever exercises a second copy of this policy.
fn with_execution_hold(escalation_id:NonEmptyStr,use:fn(PrinterExecutionHold)->ProcessExit) -> ProcessExit {
  printer_hold_enter(escalation_id:escalation_id,use:use,root:printer_start_claim_directory,slot_key:hold_key,approvals_root:approval_decision_store_root)
}

// THE HOLD PROTOCOL ITSELF, ROOT- AND SLOT-PARAMETERIZED (DESIGN.md §6b: one generalization, not a
// copy per root). A print arrives, tries to claim the slot, and each outcome is a typed sentence:
//   - ACQUIRED: run the print under the held slot.
//   - OCCUPIED: this is where main died -- it printed one sentence and exited, so a hold whose holder
//     died (a killed converge, a rebooted host) locked the printer forever. It now calls the ONE
//     recovery the store owns, handing over this root's own liveness probe, and each recovery outcome
//     is its own typed sentence: a holder OBSERVED DEAD is released and the print retries once; a
//     holder observed LIVE is refused as live (wait -- something is printing); a holder that cannot be
//     observed at all goes to the operator-observation arm, because the only thing that makes a release
//     sound is an observation someone actually made, and here nobody can make one.
fn printer_hold_enter(escalation_id:NonEmptyStr,use:fn(PrinterExecutionHold)->ProcessExit,root:NonEmptyStr,slot_key:NonEmptyStr,approvals_root:NonEmptyStr) -> ProcessExit {
  let owner = printer_execution_hold_owner_text(escalation_id:escalation_id)
  match file_hold_acquire(root:root,slot_key:slot_key,requested_owner:owner as DurableHoldOwnerRef) {
    FileHoldAcquired {slot_key:_,owner:o,generation:g}=>printer_hold_run_acquired(root:root,slot_key:slot_key,owner:owner,held:PrinterExecutionHold {owner:o,generation:g},use:use)
    FileHoldOccupied {slot_key:k,holder:h,generation:g}=>
      match file_hold_recover_dead_holder(root:root,slot_key:k,holder:h,generation:g,released_by:join(["recovered-dead-holder:",h as String],"") as DurableHoldReleaseRef,live_owner:printer_execution_hold_live_owner) {
        FileHoldDeadHolderRecovered {dead_holder:d,evidence:e}=>printer_hold_retry_after_release(root:root,slot_key:slot_key,owner:owner,use:use,prior:join(["the dead holder ",d as String," was released on observed evidence (",e as String,")"],""))
        FileHoldDeadHolderHolderLive {holder:hl,evidence:e}=>exit_failure(reason:join(["Printer fleet controller is held by a LIVE controller: ",printer_hold_slot_text(slot_key:k,holder:hl,generation:g),"evidence: ",e as String,". Wait for it to finish; never a second controller."],""))
        FileHoldDeadHolderHolderUnobservable {holder:hu,cause:c}=>printer_hold_release_on_operator_observation(root:root,approvals_root:approvals_root,hold_slot:k,escalation_id:escalation_id,holder:hu,generation:g,cause:join([": ",c as String,"."],""),use:use)
        FileHoldDeadHolderNotEligible {refusal:r}=>exit_failure(reason:join(["Printer fleet controller is held and recovery refused: ",printer_hold_slot_text(slot_key:k,holder:h,generation:g),"-- ",printer_recovery_refusal_detail(refusal:r),"; never a second controller."],""))
        FileHoldDeadHolderReleaseLost=>exit_failure(reason:join(["the stale printer-start hold on slot ",k as String," moved under the recovery; nothing was released, re-run."],""))
        FileHoldDeadHolderReleaseStoreUnavailable {cause:cs}=>exit_failure(reason:join(["the printer-start claim store refused the dead-holder release on slot ",k as String,": ",cs as String],""))
        FileHoldDeadHolderReleaseKeyNotAddressable=>exit_failure(reason:join(["the printer-start hold slot key ",k as String," is not slot-addressable; no recovery committed."],""))
      }
    FileHoldAcquireLost {slot_key:k}=>exit_failure(reason:join(["Printer fleet controller claim on slot ",k as String," was lost to a racing controller; no second controller admitted."],""))
    FileHoldAcquireStoreUnavailable {slot_key:k,cause:c}=>exit_failure(reason:concat(concat("Printer fleet controller store on slot ",concat(k as String," is unavailable: ")),store_failure_detail(cause:c)))
    FileHoldSlotUndecodable {slot_key:k,generation:g,detail:d}=>exit_failure(reason:join(["Printer fleet controller slot ",k as String," is undecodable at generation ",int_to_decimal_string(value: cas_generation_count(g:g)),": ",d as String,"; no second controller admitted."],""))
    FileHoldKeyNotSlotAddressable {slot_key:k}=>exit_failure(reason:join(["Printer fleet controller slot key '",k as String,"' is not slot-addressable; no second controller admitted."],""))
  }
}

// HOW LONG THE OPERATOR HAS TO DECIDE THE PRINT-START BED-CLEAR CARD, declared ONCE. The card is
// filed and answered inside the run that filed it (it polls), so its window is that run's poll
// budget: 90 ticks at a 10 s cadence.
data printer_operator_approval_window:Second = second(count:900)

// HOW LONG THE OPERATOR HAS TO DECIDE THE STALE-HOLD OBSERVATION. It is NOT the same figure as the
// bed-clear card above, and the difference is the shape of the route, not a mood: the bed-clear card
// is answered by the run that filed it, while this card is filed by one dispatch and REDEEMED by a
// later one -- the window has to cover a CI queue, a build and the next dispatch reaching the hold
// arm, not just a thumb on a phone. The figure is the one this codebase already declares twice for
// exactly that shape (gunbc.auth.branch_run_grant.branch_run_grant_file_window and
// gunbc.auth.gcp_iam_converge_run.gcp_iam_converge_file_window, both 1800 s), so it is a reused
// constant, not a new one. A longer window is safe here because the consent is pinned to the hold's
// (root, slot, holder, generation): if any controller takes the slot in the meantime the generation
// moves, the derived escalation moves with it, and the old answer cannot reach the new hold.
data printer_hold_observation_file_window:Second = second(count:1800)

// WHAT ASKING THE OPERATOR ENDED UP DOING, as a type rather than an exit code. The caller has to know
// WHICH of these happened -- a card was filed, a card was already on file, nothing is held, or the
// ask was refused -- because the printer workflow records the difference in its durable receipt, and
// an operator deciding what to do next reads that receipt, not a stack of look-alike successes.
type PrinterHoldReleaseRequest
  = HoldReleaseNothingHeld { detail: NonEmptyStr }
  | HoldReleaseCardFiled { escalation_id: NonEmptyStr }
  | HoldReleaseCardOnFile { escalation_id: NonEmptyStr, detail: NonEmptyStr }
  | HoldReleaseRefused { reason: NonEmptyStr }

fn printer_hold_release_request_detail(outcome:PrinterHoldReleaseRequest) -> NonEmptyStr {
  match outcome {
    HoldReleaseNothingHeld {detail:d}=>d as NonEmptyStr
    HoldReleaseCardFiled {escalation_id:e}=>join(["an operator-observation card for this stale printer-start hold is now filed under escalation ",e as String,"; NOTHING HAS BEEN RELEASED -- approve the card, then re-dispatch the print, and the converge that meets the hold releases it under that decision"],"") as NonEmptyStr
    HoldReleaseCardOnFile {escalation_id:e,detail:d}=>join(["escalation ",e as String," already carries this hold's operator observation: ",d as String],"") as NonEmptyStr
    HoldReleaseRefused {reason:r}=>r as NonEmptyStr
  }
}

// THE FILER THE RELEASE ROUTE WAS MISSING. A release route nobody can file is not a route: the arm
// above only READS a decision, and the only code that ever FILED an observation wrote the approval
// store by hand -- a path no operator can take, because the Approve app only DECIDES requests and
// filing one requires the submission key (gunbc.auth.approval_request_client). This is the filer. It
// files the observation for THIS hold -- root, slot, holder, generation, under the hold's own
// escalation id -- through the canonical approval route, the same one a print start files its
// bed-clear card through, so the card lands in the deck the operator already reads and the decision
// lands in the store the release arm already reads.
//
// It releases NOTHING, and that is why it is a separate operation from the release arm rather than a
// step inside it. Asking is its only effect: the release stays behind std.scoped_authorization in
// printer_hold_release_on_operator_observation, taken by the next converge that actually meets the
// hold, so a decision can never be spent on a hold that has since moved.
fn printer_hold_release_request() -> PrinterHoldReleaseRequest {
  printer_hold_release_request_at(root:printer_start_claim_directory,slot_key:hold_key,approvals_root:approval_decision_store_root)
}

// ROOT-, SLOT- AND STORE-PARAMETERIZED (DESIGN.md §6b: one generalization, not a copy per root), so
// the witnesses run THIS code against throwaway roots exactly as `printer_hold_enter` does.
fn printer_hold_release_request_at(root:NonEmptyStr,slot_key:NonEmptyStr,approvals_root:NonEmptyStr) -> PrinterHoldReleaseRequest {
  match observe_file_hold(root:root,key:slot_key) {
    HoldSlotAbsent=>HoldReleaseNothingHeld {detail:join(["the printer-start hold slot ",slot_key as String," is absent: nothing is held, so there is nothing to release and no card to file"],"") as NonEmptyStr}
    HoldSlotFree {generation:_,released_by:_}=>HoldReleaseNothingHeld {detail:join(["the printer-start hold slot ",slot_key as String," is free: nothing is held, so there is nothing to release and no card to file"],"") as NonEmptyStr}
    HoldSlotHeld {generation:g,owner:o}=>
      match printer_execution_hold_holder(holder:o) {
        // A holder that NAMES a process is observable, and observable holders are the converge's own
        // business: file_hold_recover_dead_holder proves it dead or refuses it live. Filing an operator
        // card for a holder that can be checked would ask a human to stand in for evidence -- exactly
        // the substitution the unobservable arm exists to refuse.
        PrinterExecutionHoldHolderProcess {escalation_id:e,process:_,pid_namespace:_}=>HoldReleaseRefused {reason:join(["the printer-start hold on slot ",slot_key as String," names a process -- ",printer_hold_slot_text(slot_key:slot_key,holder:o,generation:g),"-- so its holder is observable and the converge's own dead-holder recovery decides it; no operator card is filed. Holder escalation ",e as String,"."],"") as NonEmptyStr}
        PrinterExecutionHoldHolderUnobservable {cause:c}=>printer_hold_release_request_filing(root:root,slot_key:slot_key,approvals_root:approvals_root,holder:o,generation:g,cause:c)
      }
    HoldSlotUndecodable {generation:g,detail:d}=>HoldReleaseRefused {reason:join(["the printer-start hold slot ",slot_key as String," is undecodable at generation ",int_to_decimal_string(value:cas_generation_count(g:g)),": ",d as String,"; no card was filed"],"") as NonEmptyStr}
    HoldObservationUnavailable {cause:cs}=>HoldReleaseRefused {reason:join(["the printer-start hold slot ",slot_key as String," could not be observed: ",cas_unreadable_slot_detail(cause:cs),"; no card was filed"],"") as NonEmptyStr}
  }
}

// THE FILING, once the slot is known to be held by a holder this root cannot observe. The standing is
// read FIRST, through the SAME grant lookup the release arm uses, so a card is never filed twice and
// an operator who has already answered this hold is never asked again (the broker's own
// ExpectSlotAbsent would refuse a re-file anyway; reading first is what turns that refusal into a
// sentence about what is already on file).
fn printer_hold_release_request_filing(root:NonEmptyStr,slot_key:NonEmptyStr,approvals_root:NonEmptyStr,holder:DurableHoldOwnerRef,generation:CasGeneration,cause:NonEmptyStr) -> PrinterHoldReleaseRequest {
  let escalation = printer_hold_observation_escalation_id(hold_root:root,hold_slot:slot_key,holder:holder,generation:generation)
  match approval_instant_now() {
    Absent=>HoldReleaseRefused {reason:"Cannot read the clock; the operator-observation request for the stale printer-start hold cannot be filed with an expiry, and the hold stays held" as NonEmptyStr}
    Present{value:now}=>
      match printer_hold_operator_grant(root:root,approvals_root:approvals_root,hold_slot:slot_key,holder:holder,generation:generation,observed_at:now) {
        // Decided already -- the operator has answered THIS hold. Whether the answer permits the
        // release is the release arm's to conclude, at its own clock, against the hold it meets; this
        // route only reports what stands on file and files nothing.
        PrinterHoldOperatorGrantHeld {decision:_}=>HoldReleaseCardOnFile {escalation_id:escalation,detail:"already decided; the next converge that meets the hold acts on that decision" as NonEmptyStr}
        PrinterHoldOperatorGrantMissing {cause:PrinterHoldGrantNotFiled {escalation_id:_}}=>{
          let stored = stored_request_from_authorization(request:printer_operator_observation_request(hold_root:root,hold_slot:slot_key,holder:holder,generation:generation),issued_at:now,expires_at:approval_expires_at(issued:now,window:printer_hold_observation_file_window))
          match approval_file_stored_request(stored:stored,body_file_name:"printer-hold-release-submit.json",submit_timeout:second(count:30)) {
            ApprovalFiled=>HoldReleaseCardFiled {escalation_id:escalation}
            ApprovalFilingRefused {reason:r}=>HoldReleaseRefused {reason:join(["the Approve broker refused the operator-observation request for the stale printer-start hold on slot ",slot_key as String,": ",r as String,"; no card was filed and the hold stays held"],"") as NonEmptyStr}
          }
        }
        // Filed and undecided, decided for another intent, unreadable, or refused by authorize: the
        // same typed detail the release arm gives. Pending and already-decided mean the operator has
        // the card in front of them (or has answered it), so they are reported, not refused; the rest
        // are refusals, because the next step belongs to the store, not to the operator.
        PrinterHoldOperatorGrantMissing {cause:PrinterHoldGrantStillPending {escalation_id:e}}=>HoldReleaseCardOnFile {escalation_id:e,detail:"filed and awaiting the operator; nothing new was filed" as NonEmptyStr}
        PrinterHoldOperatorGrantMissing {cause:mc}=>HoldReleaseRefused {reason:join(["no new operator-observation card was filed for the stale printer-start hold on slot ",slot_key as String,": ",printer_hold_operator_grant_missing_detail(cause:mc),"; the hold stays held"],"") as NonEmptyStr}
      }
  }
}
