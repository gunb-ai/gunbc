// One fleet controller owns scheduling; printer lifetimes overlap inside that hold.
// Existing single starts also acquire it, so a legacy entry cannot race a batch.
// A crashed/uncertain owner remains held until the existing dead-holder recovery
// protocol establishes recovery; merely using the same owner text does not re-enter.
data hold_key:NonEmptyStr = "fleet-print-controller"

// THE OWNER NAME IS THE AUTHORIZATION PLUS THE PROCESS THAT TOOK THE SLOT, the pattern
// gunbc.host.managed_host_unit_hold and extdeps.realization.materialization_store_local already
// write: <escalation_id> ++ process_hold_text. The escalation id keeps the slot readable as an
// authorization (the reconciliation census matches on it); the process part is what makes the
// holder observable at all, so a controller that died can be proven dead instead of leaving the
// slot held forever. Where this host cannot name its own process (/proc unreadable), the owner
// falls back to the authorization ALONE, which is exactly the shape of the pre-existing holds; the
// recovery arm below treats that as unobservable rather than letting an unidentifiable holder
// conclude anything about itself.
fn printer_execution_hold_owner_text(escalation_id:NonEmptyStr) -> NonEmptyStr {
  match self_process_identity() {
    SelfIdentified{process:p,pid_namespace:n}=>concat(escalation_id as String,process_hold_text(p:p,pid_namespace:n)) as NonEmptyStr
    SelfUnidentified{cause:_}=>escalation_id
  }
}

// THE RENDERED OWNER'S PROCESS PART, decoded back or named as unobservable. The marker splits the
// authorization from the process fields (same split the other roots use), and a holder with no
// marker names no process at all: that is not a corruption, it is a hold written before owners
// carried a process, and the caller decides what an unobservable holder is worth.
type PrinterExecutionHoldHolder
  = PrinterExecutionHoldHolderProcess { escalation_id:NonEmptyStr, process:ProcessIdentity, pid_namespace:NonEmptyStr }
  | PrinterExecutionHoldHolderUnobservable { cause:NonEmptyStr }

fn printer_execution_hold_holder(holder:DurableHoldOwnerRef) -> PrinterExecutionHoldHolder {
  let halves = split(s:holder as String,delimiter:process_hold_marker)
  if count(halves) != 2 || text_at(xs:halves,i:0) == "" {
    PrinterExecutionHoldHolderUnobservable { cause:"the holder's owner names no process this module can observe (it was written without one, or not by this module)" as NonEmptyStr }
  } else {
    match process_hold_decode(text:concat("boot=",text_at(xs:halves,i:1))) {
      Present{value:h}=>PrinterExecutionHoldHolderProcess { escalation_id:text_at(xs:halves,i:0) as NonEmptyStr, process:h.process, pid_namespace:h.pid_namespace }
      Absent=>PrinterExecutionHoldHolderUnobservable { cause:"the holder's owner carries a process part this module cannot decode" as NonEmptyStr }
    }
  }
}
type PrinterExecutionHold sole_constructor {owner:DurableHoldOwnerRef,generation:CasGeneration}
fn hold_current(hold:PrinterExecutionHold) -> Bool {
 match observe_file_hold(root:printer_start_claim_directory,key:hold_key) {
  HoldSlotHeld {owner:o,generation:g}=>durable_hold_owner_equal(left:o,right:hold.owner) && cas_generation_count(g:g)==cas_generation_count(g:hold.generation)
  HoldSlotAbsent=>false HoldSlotFree {generation:_,released_by:_}=>false HoldSlotUndecodable {generation:_,detail:_}=>false HoldObservationUnavailable {cause:_}=>false
 }
}
fn store_failure_detail(cause:CasStoreFailure) -> String {
 match cause {
  CasSlotObservationRefused {cause:u}=>concat("read refused -- ",cas_unreadable_slot_detail(cause:u))
  CasGenerationPublicationRefused {detail:d}=>concat("write refused -- ",d as String)
  CasGenerationSpaceExhausted {head:h}=>concat("generation space exhausted at head generation ",int_to_decimal_string(value: cas_generation_count(g:h)))
 }
}
fn with_execution_hold(owner:NonEmptyStr,use:fn(PrinterExecutionHold)->ProcessExit) -> ProcessExit {
 match file_hold_acquire(root:printer_start_claim_directory,slot_key:hold_key,requested_owner:owner as DurableHoldOwnerRef) {
  FileHoldAcquired {slot_key:_,owner:o,generation:g}=>{
   let result=use(PrinterExecutionHold {owner:o,generation:g})
   match result {
    ExitSuccess=>match file_hold_release_assess(root:printer_start_claim_directory,slot_key:hold_key,owner:o,acquired_generation:g,released_by:owner as DurableHoldReleaseRef) {
     FileHoldReleasePlanned {plan:p}=>match file_hold_release_commit(plan:p) {FileHoldReleased {slot_key:_,generation:_}=>ExitSuccess FileHoldReleaseLost {slot_key:_}=>exit_failure(reason:"Printer controller hold release failed; do not start another controller") FileHoldReleaseStoreUnavailable {slot_key:_,cause:_}=>exit_failure(reason:"Printer controller hold release failed; do not start another controller") FileHoldReleaseKeyNotSlotAddressable {slot_key:_}=>exit_failure(reason:"Printer controller hold release failed; do not start another controller")}
     FileHoldReleaseNotEligible {slot_key:_,refusal:_}=>exit_failure(reason:"Printer controller hold changed before release")
    }
    other=>other
   }
  }
  // Each refusal says WHAT the slot said, in its own words. One masked sentence for all five arms
  // made a 4.5-day stale hold (2026-10-26 pass 2) a cross-machine forensic hunt: the holder text
  // and generation are admission evidence, not secrets, and an operator reading the run log
  // should never need a root shell on srv1 to learn who holds the controller.
  FileHoldOccupied {slot_key:k,holder:h,generation:g}=>exit_failure(reason:join(["Printer fleet controller is held by owner '",h as String,"' (slot ",k as String,", generation ",int_to_decimal_string(value: cas_generation_count(g:g)),"). If that owner is dead, recover it through the dead-holder protocol (file_hold_recovery_assess); never a second controller."],""))
  FileHoldAcquireLost {slot_key:k}=>exit_failure(reason:join(["Printer fleet controller claim on slot ",k as String," was lost to a racing controller; no second controller admitted."],""))
  FileHoldAcquireStoreUnavailable {slot_key:k,cause:c}=>exit_failure(reason:concat(concat("Printer fleet controller store on slot ",concat(k as String," is unavailable: ")),store_failure_detail(cause:c)))
  FileHoldSlotUndecodable {slot_key:k,generation:g,detail:d}=>exit_failure(reason:join(["Printer fleet controller slot ",k as String," is undecodable at generation ",int_to_decimal_string(value: cas_generation_count(g:g)),": ",d as String,"; no second controller admitted."],""))
  FileHoldKeyNotSlotAddressable {slot_key:k}=>exit_failure(reason:join(["Printer fleet controller slot key '",k as String,"' is not slot-addressable; no second controller admitted."],""))
 }
}
