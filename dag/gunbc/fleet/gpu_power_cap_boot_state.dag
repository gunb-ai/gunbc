module gunbc.fleet.gpu_power_cap_boot_state

// THE POWER-CAP BOOT MECHANISM AS IT STANDS ON A HOST: what is installed to make a decided cap survive a
// reboot, and what that mechanism said in its own journal. Two readings, held apart, and deliberately nothing
// else -- the third reading this module used to carry, what the device says its limit IS, is not this module's
// to hold (see WHAT THIS MODULE DOES NOT OWN).
//
// WHY THE MECHANISM AND ITS CLAIM ARE TWO ROWS AND NOT ONE. The desired cap is the operator's decision
// (gunbc.serving.gpu_power_state_policy, 2026-11-07). The boot mechanism is a unit installed on the host: its
// presence, its enablement and the order it runs in say that someone ASKED for the cap at boot, and nothing
// more -- ordering a unit After= another unit, or an oneshot reporting success, does not establish that any
// limit landed on any device. The unit's journal line is the applying tool grading its own homework: it
// reports a transition, for the boot it ran in, from the side that did the applying. Neither can say the cap
// IS in force. This module therefore states no realization at all.
//
// WHAT THIS MODULE DOES NOT OWN. Two things, and both have owners on main:
//   - the device's own report of its limit, its default and its accepted range, per enumeration, is
//     gunbc.fleet.gpu_device_observation's (its power_limit_current / _minimum / _maximum / _default fields);
//   - whether an admitted cap is REALIZED is gunbc.fleet.gpu_power_cap_converge's verdict (#16047, landed as
//     d79a9db7addb): it writes each admitted cap, then issues a separate post-write QUERY by GPU UUID and
//     compares the returned power.limit with the admitted cap, refusing when they disagree or when the device
//     withholds the field; gunbc.live_deploy.srv1_gpu_power_cap_unit runs it at every boot and the serving
//     engine carries Requires= and After= on that unit. Nothing here re-decides that question, and a consumer
//     that wants it calls the converge. An earlier shape of this module joined the unit, its claim and a
//     readback into a `CapRealization` of its own; that join is gone, because a module that was not the
//     converge could only ever have produced an answer the converge disagreed with.
//
// WHAT THIS MODULE HOLDS BESIDE SRV1'S TRANSCRIBED UNIT (2026-11-24, closed up at the final-state pass). srv3,
// srv4 and ken carry caps the operator applied by hand, and those readings have a different shape: a path, a
// rule, a wattage, a persistence claim and a digest -- no systemctl state, and no transcription except where the
// operator's final-state ssh pass of 2026-11-24 22:03-22:05 UTC quoted one. They are held as
// `hand_applied_cap_mechanisms`, sibling rows to `srv1_power_cap_boot_units`. That pass returned whole sha256s
// for all three mechanisms and the full bytes of two of their files, which this module now EMITS rather than
// restates: srv4's unit through extdeps.systemd.unit_file (srv4_gpu_power_cap_unit) and ken's cap script as a
// transcribed line list (ken_t10_power_cap_script_lines), each folded against the host's digest. What stays
// unread stays named: srv3's drop-in bytes (digest read, the file moved under the day) and ken's cap-unit bytes. Both reach every card on their host, which is why they answer a consumer asking "what cap does
// this host put on its cards?" through `host_wide_gpu_cap_watts`, while srv1's one-card unit answers no such question.
//
// DISPOSITION OF #16047 (landed 2026-11-08 as d79a9db7addb, after this PR was opened). This module consumes it
// rather than duplicating it: the apply-and-read-back path and the generated `gunbc-srv1-gpu-power-cap.service`
// are theirs, and what is kept here is the part their model does not describe -- the unit actually installed on
// srv1 today, which is NOT theirs. `sudo ls /etc/systemd/system/gunbc-srv1-gpu-power-cap.service` returns no
// such file as of 2026-11-08, so the cap standing on the Workstation card comes from the operator's
// hand-written unit below, and the cap standing on the Max-Q card is that card's own factory default. When the
// gunbc unit is installed, the rows here are superseded by it and this module's reason to exist narrows to
// recording that fact.

import std.types { Bool, List, NonEmptyStr, String }
import std.optional { Absent, Optional, Present, optional_is_absent }
import std.measure { Hertz, Watt, hertz, watt, watt_count }
import std.content_hash { sha256_hex_of_text }
import product.host_identity { HostIdentity, host_identity_eq }
import product.placement_supply { PhysicalAssetIdentity }
import gunbc.fleet.fleet_host_identity {
  operator_host_e2d4b7, operator_host_srv1, operator_host_srv3, operator_host_srv4,
}
import extdeps.systemd.unit_file {
  SystemdUnitFile, ServiceUnitFile, Description, After, Requires, ServiceType, OneshotMode, RemainAfterExit,
  ExecStart, Installable, WantedBy, serialize_systemd_unit_file,
}
import gunbc.fleet.gpu_device_observation {
  GpuDeviceObservation, GpuDeviceEnumerated, GpuDeviceNotEnumerated,
  current_gpu_device_observations, current_gpu_device_observations_of,
  gpu_device_observation_board, gpu_device_observation_default,
}

// A LINE AS SYSTEMD WILL RUN IT, with the two prefixes recorded as the separate facts they are. systemd gives
// them different jobs: `-` means ignore this line's exit status, and `+` means run it with full privileges even
// when sandboxing is on. Only the first decides whether the unit can fail, and neither says anything about a
// device -- so both are carried rather than inferred from a paraphrase of the file.
type BootCommandLine {
  as_written: NonEmptyStr
  tolerates_failure: Bool
  runs_with_full_privileges: Bool
}

// THE MECHANISM, AS INSTALLED. Read by sudo cat, sha256sum and systemctl on the host; every field is what the
// file says, including what it does not do.
type BootCapCommand {
  addressed_gpu_uuid: NonEmptyStr
  target_watts: Watt
  line: BootCommandLine
}

type PowerCapBootUnit {
  host: HostIdentity
  unit_path: NonEmptyStr
  content_sha256: NonEmptyStr
  description: NonEmptyStr
  unit_type: NonEmptyStr
  wants: List<NonEmptyStr>
  after: List<NonEmptyStr>
  wanted_by: List<NonEmptyStr>
  // Lines that run before the cap lines, verbatim. They matter to the failure story below, so they are not
  // summarized away: the unit loads the driver module and turns persistence mode on before it caps.
  pre_commands: List<BootCommandLine>
  persistence_requested: Bool
  cap_commands: List<BootCapCommand>
  enabled: Bool
  active_state: NonEmptyStr
  since: NonEmptyStr
  read_on: NonEmptyStr
}

// WHAT THE MECHANISM CLAIMED, in its own words. A journal line from the tool the unit ran: it reports a
// transition, and it reports it for the boot the unit ran in. Kept separate from the unit row because an
// oneshot's own optimism is not evidence about a device.
type CapApplicationClaim {
  host: HostIdentity
  addressed_pci: NonEmptyStr
  from_watts: Watt
  to_watts: Watt
  said_by: NonEmptyStr
  read_on: NonEmptyStr
}

fn cap_boot_unit_for(host: HostIdentity) -> PowerCapBootUnit? {
  filter(srv1_power_cap_boot_units, u => host_identity_eq(a: u.host, b: host)).first()
}

// Comparison by text, the way the repo compares two branded values (product.host_identity's own helper is
// `a as String == b as String`). Callers hand this the UUID the DEVICE ROW carries, never one retyped here:
// a unit that happens to match a literal the test author already knew is not evidence the unit and the
// device were ever joined.
fn boot_unit_addresses(unit: PowerCapBootUnit, gpu_uuid: NonEmptyStr) -> BootCapCommand? {
  filter(unit.cap_commands, c => (c.addressed_gpu_uuid as String) == (gpu_uuid as String)).first()
}

// CAN THIS UNIT FAIL? True only when no line carries systemd's `-` prefix, which is what makes a unit that
// reports success while its commands did nothing. This is a fact about the unit's text, not a claim that any
// limit reached a device -- that question belongs to gunbc.fleet.gpu_power_cap_converge.
fn unit_lines_can_fail(unit: PowerCapBootUnit) -> Bool {
  unit.pre_commands.all(l => !l.tolerates_failure)
    && unit.cap_commands.all(c => !c.line.tolerates_failure)
}

// DOES ANY LINE ESCAPE THE SANDBOX? The `+` prefix, kept distinct from the failure prefix above because the
// two are routinely confused and only one of them decides whether a failure is survivable.
fn unit_lines_run_with_full_privileges(unit: PowerCapBootUnit) -> Bool {
  unit.pre_commands.any(l => l.runs_with_full_privileges)
    || unit.cap_commands.any(c => c.line.runs_with_full_privileges)
}

fn cap_application_claims_on(host: HostIdentity) -> List<CapApplicationClaim> {
  filter(srv1_cap_application_claims, c => host_identity_eq(a: c.host, b: host))
}

// THE QUESTION THIS MODULE IS ALLOWED TO ANSWER: does the installed mechanism issue a cap command for this
// board, yes or no -- a fact about the unit, not a verdict about the device. The board's UUID is taken from
// the device observation (gunbc.fleet.gpu_device_observation), never from this module, because a board is
// inventory and a UUID is what a driver enumeration showed.
// The device row's `gpu_uuid` field is itself optional -- #16045 declares it `NonEmptyStr?`, because an
// enumeration can see a device without giving up a UUID -- so this returns that optionality, not an extra
// layer of it. Wrapping it in a second Present is not a style slip: the consumer would then be handed an
// Optional where it expects text, and the cast reports a runtime carrier error rather than a missing uuid.
fn device_uuid_of(host: HostIdentity, board: PhysicalAssetIdentity) -> NonEmptyStr? {
  match current_gpu_device_observations_of(board: board).first() {
    Absent => Absent
    Present { value: o } => match o {
      GpuDeviceEnumerated { host: h, board: _, gpu_uuid: u, pci_address: _, power_limit_minimum: _, power_limit_maximum: _, power_limit_current: _, power_limit_default: _, power_limit_control: _, read_on: _ } =>
        if host_identity_eq(a: h, b: host) { u } else { Absent }
      GpuDeviceNotEnumerated { host: _, board: _, cause: _, read_on: _ } => Absent
    }
  }
}

fn installed_unit_addresses_board(host: HostIdentity, board: PhysicalAssetIdentity) -> Bool {
  match device_uuid_of(host: host, board: board) {
    Absent => false
    Present { value: uuid } => match cap_boot_unit_for(host: host) {
      Absent => false
      Present { value: u } => match boot_unit_addresses(unit: u, gpu_uuid: uuid) {
        Absent => false
        Present { value: _ } => true
      }
    }
  }
}

// THE MECHANISM GUNBC DESIGNS IS NOT THE MECHANISM INSTALLED. gunbc.live_deploy.srv1_gpu_power_cap_unit
// generates /etc/systemd/system/gunbc-srv1-gpu-power-cap.service, whose ExecStart runs the converge and whose
// failure the serving engine is gated on. As of the reading below it is not on srv1's unit directory, which is
// the difference between "the policy is realized by a mechanism that reads itself back" and "a hand-written
// unit runs and nothing checks it".
type BootMechanismPresence
  = GunbcCapUnitAbsent { observed_by: NonEmptyStr, read_on: NonEmptyStr }
  | GunbcCapUnitPresent { observed_by: NonEmptyStr, read_on: NonEmptyStr }
  | GunbcCapUnitUnread { read_obligation: NonEmptyStr }

data srv1_gunbc_cap_unit_presence: BootMechanismPresence = GunbcCapUnitAbsent {
  observed_by: "sudo ls /etc/systemd/system/gunbc-srv1-gpu-power-cap.service on srv1: No such file or directory; the gunbc-* units present there are the roadmap, green-belt, converge and lab-feedback units, none of them a power-cap unit" as NonEmptyStr,
  read_on: "2026-11-08 srv1" as NonEmptyStr,
}

fn gunbc_cap_unit_is_installed(p: BootMechanismPresence) -> Bool {
  match p {
    GunbcCapUnitPresent { observed_by: _, read_on: _ } => true
    GunbcCapUnitAbsent { observed_by: _, read_on: _ } => false
    GunbcCapUnitUnread { read_obligation: _ } => false
  }
}

// ------------------------------------------------------------------ srv1, read 2026-11-08

// The unit the operator installed. Its body, transcribed as read by `sudo cat`, sha256
// 473372180065e6b313dc6266a477e37cc6845b386789eb407bff2fc77b6f4e2a:
//   [Unit]      Description=Cap RTX PRO 6000 Workstation (non-Max-Q) to 300W + enable persistence mode
//               After=systemd-modules-load.service   Wants=systemd-modules-load.service
//   [Service]   Type=oneshot   RemainAfterExit=yes
//               ExecStartPre=/sbin/modprobe nvidia
//               ExecStartPre=/usr/bin/nvidia-smi -pm 1
//               # Workstation Edition, selected by UUID so a slot change does not move the cap to the wrong card
//               ExecStart=/usr/bin/nvidia-smi -i GPU-96b749dc-e2ea-5b6f-2e45-ee868b1a9750 -pl 300
//   [Install]   WantedBy=multi-user.target
//
// WHAT THE PREFIX ON THOSE LINES DOES, said correctly, because it is the difference between a unit that can
// fail and one that cannot. systemd gives the two prefixes different jobs: `-` means ignore this line's exit
// status, and `+` means run the line with full privileges even when sandboxing is on. THIS UNIT USES NEITHER:
// all three lines are unprefixed, so a failing `nvidia-smi -pm 1` or `-pl 300` fails the oneshot, and the
// unit's own exit status is an honest report of the attempt. What the unit still lacks is not a failure path
// but a CHECK -- it never queries power.limit afterwards, and no other unit is Requires=-gated on it, so its
// success is not consumed by anything. An earlier draft of this comment claimed the lines were prefixed to be
// tolerated and that the unit therefore had no failure path; the host says otherwise and is what is recorded.
//
// IT CAPS ONE BOARD, by UUID: the Workstation card, whose default limit is 600 W. The Max-Q is not addressed,
// because its own default limit already is the decided 300 W (its device range is 250-325 W) -- so on that
// card the decision holds by factory setting, not by any act of this unit.
data srv1_power_cap_boot_units: List<PowerCapBootUnit> = [
  PowerCapBootUnit {
    host: operator_host_srv1,
    unit_path: "/etc/systemd/system/gpu-power-limit.service" as NonEmptyStr,
    content_sha256: "473372180065e6b313dc6266a477e37cc6845b386789eb407bff2fc77b6f4e2a" as NonEmptyStr,
    description: "Cap RTX PRO 6000 Workstation (non-Max-Q) to 300W + enable persistence mode" as NonEmptyStr,
    unit_type: "oneshot" as NonEmptyStr,
    wants: ["systemd-modules-load.service" as NonEmptyStr],
    after: ["systemd-modules-load.service" as NonEmptyStr],
    wanted_by: ["multi-user.target" as NonEmptyStr],
    pre_commands: [
      BootCommandLine {
        as_written: "/sbin/modprobe nvidia" as NonEmptyStr,
        tolerates_failure: false,
        runs_with_full_privileges: false,
      },
      BootCommandLine {
        as_written: "/usr/bin/nvidia-smi -pm 1" as NonEmptyStr,
        tolerates_failure: false,
        runs_with_full_privileges: false,
      },
    ],
    persistence_requested: true,
    cap_commands: [
      BootCapCommand {
        addressed_gpu_uuid: "GPU-96b749dc-e2ea-5b6f-2e45-ee868b1a9750" as NonEmptyStr,
        target_watts: watt(count: 300),
        line: BootCommandLine {
          as_written: "/usr/bin/nvidia-smi -i GPU-96b749dc-e2ea-5b6f-2e45-ee868b1a9750 -pl 300" as NonEmptyStr,
          tolerates_failure: false,
          runs_with_full_privileges: false,
        },
      },
    ],
    enabled: true,
    active_state: "active (exited)" as NonEmptyStr,
    since: "2026-11-08 18:39:25 UTC" as NonEmptyStr,
    read_on: "2026-11-08 srv1 sudo cat, sha256sum, systemctl is-enabled and is-active" as NonEmptyStr,
  },
]

// THE UNIT'S OWN ACCOUNT of the boot it ran in, from journalctl -u gpu-power-limit.service. It names the
// transition -- 300.00 W from 600.00 W, on 00000004:01:00.0 -- and it is the applying side's report. It is not
// a readback: the reading that could confirm the limit now lives with the device observation and, as a
// post-write verdict, with gunbc.fleet.gpu_power_cap_converge.
data srv1_cap_application_claims: List<CapApplicationClaim> = [
  CapApplicationClaim {
    host: operator_host_srv1,
    addressed_pci: "00000004:01:00.0" as NonEmptyStr,
    from_watts: watt(count: 600),
    to_watts: watt(count: 300),
    said_by: "nvidia-smi, in gpu-power-limit.service's journal at 2026-11-08 18:39:25 UTC: \"Power limit for GPU 00000004:01:00.0 was set to 300.00 W from 600.00 W. All done.\"" as NonEmptyStr,
    read_on: "2026-11-08 srv1 journalctl -u gpu-power-limit.service" as NonEmptyStr,
  },
]

// WHAT THE OPERATOR APPLIED BY HAND, AND HOW MUCH OF IT WAS READ (2026-11-24). srv3, srv4 and ken carry GPU
// power caps gunbc never installed: the operator edited a unit on srv4, added a drop-in on srv3, and left ken's
// install-time script-and-unit pair in place; they reported what they applied, and the final-state pass read
// what stands. That report is a DIFFERENT reading from the srv1
// unit above. The srv1 row came from `sudo cat`, `sha256sum` and `systemctl` on the host, so every field of
// PowerCapBootUnit is the file's own text. The hand-applied rows carry the fields their readings produced and no
// others: no `systemctl is-enabled` or `is-active` state was ever taken against them, and srv3's file still has
// no quoted line -- which is why they stand as siblings to srv1_power_cap_boot_units in their own type rather
// than as PowerCapBootUnit rows, where Description=, ordering and ExecStart= verbatim would have to be invented.
// Where the final-state pass DID quote bytes -- srv4's unit, ken's script -- the row says so (`lines_read: true`)
// and the bytes come from this module, folded against the host's digest, not from prose.
//
// THE DIGEST IS WHERE THE READINGS DIFFER MOST, and it is why the digest has a type of its own. When the
// operator's 2026-11-24 report first arrived it quoted each file's sha256 with the middle elided, and no read
// this repository models could produce the whole value: the one fleet-converge mode that walks a host's files,
// `runner_host_file_observe`, visits only the files the model DECLARES
// (gunbc.runner.runner_host_file_converge runner_host_file_desired_population_from_uid_reading) and reports each
// one's standing against model-declared content (observe_fleet_host_file_content) -- it never hashes an arbitrary
// path, and none of these files sits in any declared population. The operator's own final-state pass then
// supplied what the model's instruments could not: whole digests for all three mechanisms (CapUnitDigestRead on
// every row today) and the bytes of two files, which the folds below compare against those digests. The
// marked-only arm survives for the shape of the gap, not for a row: it is what a digest looks like before the
// hash read lands, and it carries that read on itself (`declared_path_host_hash_read`, spelled once below), so a
// future unread file is recorded honestly without this module waiting for a new type. srv3's row keeps the
// frontier visible the other way: a whole digest whose BYTES nobody quoted
// (`cap_mechanisms_with_unread_lines`), which no render fold may absorb.

// How the mechanism sits on the host: a unit of its own, or a line the operator added to a unit gunbc runs.
type CapMechanismPlacement
  = CapUnitOfItsOwn { unit_path: NonEmptyStr }
  | CapDropInOnUnit {
      drop_in_path: NonEmptyStr
      // The unit the drop-in belongs to. srv3's cap line runs before that unit starts, which is why the operator
      // put it there rather than in a unit of its own.
      modifies_unit: NonEmptyStr
      runs_before_the_units_own_start: Bool
    }

// Whether the report says a copy of the pre-change file sits beside the mechanism. "Not said" is its own arm: an
// unreported backup is not a read absence, and the reversal cost of the change turns on which of the three it is.
type ReportedPresence
  = ReportedPresent { detail: NonEmptyStr }
  | ReportedAbsent
  | ReportedUnsaid { why: NonEmptyStr }

// How much of a file's content hash the reading took: the whole value, or only the head and tail someone quoted.
//
// THE OPEN READ LIVES IN THE VALUE, NOT BESIDE IT. A marking carries what would turn it into a value, because
// "this hash is unread" and "this is the read that would close it" are one fact about one file: keeping them in
// two places means a check to keep the places agreeing, and a check that restates a constraint the model already
// carries is a second representation of it (gunbc.design_argument::fail_closed). So there is no unread-digest
// roster in this module, and the out-of-sync state -- a whole digest typed while a frontier row still names it --
// cannot be written at all.
type CapUnitContentDigest
  = CapUnitDigestRead { sha256: NonEmptyStr }
  | CapUnitDigestMarkedOnly {
      head: NonEmptyStr
      tail: NonEmptyStr
      // What would turn this marking into a read value. Not a to-do note in a comment: the marking is the
      // unreadness, so the obligation to read travels on it.
      what_would_discharge_it: NonEmptyStr
    }

// THE ONE DISCHARGE READ, spelled here and named by every marking rather than reworded row by row. It is written
// out once because every cap-unit file in this model is unread for the SAME reason: the observe modes this
// repository models cannot hash a path outside the declared runner population.
data declared_path_host_hash_read: NonEmptyStr = "a fleet-converge observe leg that runs sha256sum at a DECLARED path on the subject host and returns the value. Mode runner_host_file_observe visits only the files the model declares (gunbc.runner.runner_host_file_converge runner_host_file_desired_population_from_uid_reading) and reports standing against declared content, never a hash of an arbitrary path, and none of these cap-unit files is in any declared population. Typing more characters into a row is NOT the discharge: an invented digest is worse than an unread one." as NonEmptyStr

// Which cards the mechanism reaches. A cap line without a `-i` selector reaches every card the host enumerates,
// which is what the 2026-11-24 reading showed on both hosts: every card there reported the same limit. srv1's
// transcribed unit is the one-card form and stays in srv1_power_cap_boot_units.
type CapCardReach
  = EveryCardOnTheHost
  | OneCardByUuid { gpu_uuid: NonEmptyStr }

// THE SM CLOCK CEILING, if the mechanism carries one. It is a field and not a suffix on cap_marking because the
// 2026-11-24 evening added exactly this kind of line to two of the three mechanisms: `nvidia-smi -lgc LOW,HIGH`,
// applied with the watt cap so a capped card boosts to a known ceiling instead of boosting and then throttling
// under load. The choice is an operator decision bought with a locked-clock sweep under live serving traffic
// (clocksweep.sh on srv4, kensweep.sh on ken: 150 s per level, reading nvidia-smi power.draw, clocks.sm,
// utilization and clocks_throttle_reasons once a second, decode from the engine's progress lines or /metrics
// totals); the figures behind `chosen_from` are single window averages of that sweep, not an envelope, and the
// sweep's own note says the per-window decode rate was too noisy to decide on -- so it is carried with that
// standing (gunbc.design_argument::epistemic_humility; the standing type is
// extdeps.external_authority::CitedFigureStanding's subject). `SmClockUnlocked` is a fact too: srv1's workstation
// card held 2.2-2.8 GHz without collapsing and h11's R9700 cannot be locked at all until the kernel carries the
// amdgpu OverDrive bit (gunbc.integration_concern::amdgpu_ppfeaturemask_lacks_the_overdrive_bit_a_clock_ceiling_needs),
// so a lock is recorded only where one was actually applied.
type SmClockCeiling
  = SmClockLocked {
      low: Hertz
      high: Hertz
      // What the lock bought, in the sweep's own figures, with the instrument named -- a choice written down
      // without its measurement is a preference wearing a number.
      chosen_from: NonEmptyStr
      decided_on: NonEmptyStr
    }
  | SmClockUnlocked { why: NonEmptyStr }

// A cap the operator applied by hand whose EFFECTING lines live in a script a unit runs, rather than in the unit
// itself. ken's T10 mechanism is this shape: the unit's own bytes have never been read, and the rule -- cap each
// card at the minimum THAT CARD reports, fail unless EXPECT=3 are seen, lock each SM clock to 300,$CLOCK_MAX --
// lives in /usr/local/sbin/t10-power-cap.sh. The lines are carried so the digest claim can be checked against
// what this model emits, and their absence would be the honest state for a file nobody opened.
type HandAppliedScript {
  path: NonEmptyStr
  content_digest: CapUnitContentDigest
  lines: List<NonEmptyStr>
  // Who ran it and how it was read: t10-power-cap.service executes it; the sha256sum and the lines are the
  // operator's 2026-11-24 22:03-22:05 UTC ssh pass.
  instrument: NonEmptyStr
}

// A cap mechanism the operator applied by hand, as their own read of the host reported it. The fields are the
// ones the report names; what it did not transcribe is absent from this type rather than filled in with an empty
// list, which would be a total enumeration this reading never made.
type HandAppliedCapMechanism {
  host: HostIdentity
  placement: CapMechanismPlacement
  content_digest: CapUnitContentDigest
  // The flag and value as the operator gave them. Not the unit's line verbatim: the line was never read, so no
  // `as_written` claim is made about its path, its prefix or its selector -- EXCEPT where `lines_read` says the
  // file was transcribed, which upgrades the claim for that row and only that row.
  cap_marking: NonEmptyStr
  target_watts: Watt
  reaches: CapCardReach
  // Reboot-persistence as the operator stated it. This is NOT a `systemctl is-enabled` read: nothing here says
  // what systemd reports about the unit, only that the operator made the change survive a boot.
  persists_across_boot: Bool
  backup_copy_beside: ReportedPresence
  // Whether the mechanism's own lines have been read. true means the file behind `content_digest` has been
  // quoted byte for byte and the digest folds in this module can compare what the hosts hashed against what the
  // model emits; false is srv3's state -- its digest was READ at the final pass, but the bytes never were, and
  // `cap_mechanisms_with_unread_lines` keeps that from reading as verified.
  lines_read: Bool
  sm_clock: SmClockCeiling
  // Present when the effecting lines are in a script behind the unit, rather than in the unit file itself.
  runs_script: Optional<HandAppliedScript>
  read_on: NonEmptyStr
}

data srv4_hand_applied_gpu_cap: HandAppliedCapMechanism = HandAppliedCapMechanism {
  host: operator_host_srv4,
  placement: CapUnitOfItsOwn { unit_path: "/etc/systemd/system/gpu-power-cap.service" as NonEmptyStr },
  // The operator's evening pass quoted the unit's exact bytes, and the model now emits them through
  // extdeps.systemd.unit_file -- srv4_gpu_power_cap_unit below digests to this value, so this row and the host
  // hold one file with one producer, checked by srv4_cap_unit_render_is_the_host_file rather than by assertion.
  content_digest: CapUnitDigestRead {
    sha256: "2c8966d65ee15a83d13c25d1c6898321e53b98db4443c6a5c985379950b23e2a" as NonEmptyStr,
  },
  cap_marking: "-pl 30" as NonEmptyStr,
  target_watts: watt(count: 30),
  reaches: EveryCardOnTheHost,
  persists_across_boot: true,
  backup_copy_beside: ReportedPresent {
    detail: "the operator reports a backup of the pre-cap unit sitting beside it; the backup's file name was not read" as NonEmptyStr,
  },
  lines_read: true,
  sm_clock: SmClockLocked {
    low: hertz(count: 210000000),
    high: hertz(count: 1500000000),
    chosen_from: "clocksweep.sh under live serving traffic, 150 s per level (nvidia-smi power.draw, clocks.sm, utilization, clocks_throttle_reasons at 1 Hz; decode from the engine's per-second progress lines): unlocked 29.1 W at 869 MHz average and 96% of the time power-capped; locked to 1500 MHz, 27.0 W at 906 MHz and 87%; the sweep's chosen level. The per-window decode medians (26.1 tok/s locked against 28.0 unlocked) were too noisy to decide on -- the sweep's own note -- so those numbers are recorded, not used, and every figure here is a single window average, not an envelope.",
    decided_on: "2026-11-24 ~22:45 UTC",
  },
  runs_script: Absent,
  read_on: "applied by the operator by hand on 2026-11-24 (their words: gunbc.design_ruling::operator_hand_applied_srv3_srv4_power_caps_2026_11_24); re-read at the operator's final-state ssh pass of 2026-11-24 22:03-22:05 UTC, which brought back the unit's exact bytes and its sha256sum" as NonEmptyStr,
}

// srv3's cap is a drop-in on the serving engine's own unit, so it rides the engine's start rather than a unit
// of its own. The cards' limit arriving at 30 W was what the operator saw afterwards; whether systemd reports
// the drop-in's unit enabled is not read here.
data srv3_hand_applied_gpu_cap: HandAppliedCapMechanism = HandAppliedCapMechanism {
  host: operator_host_srv3,
  placement: CapDropInOnUnit {
    drop_in_path: "/etc/systemd/system/strata-pool.service.d/power-cap.conf" as NonEmptyStr,
    modifies_unit: "strata-pool.service" as NonEmptyStr,
    runs_before_the_units_own_start: true,
  },
  // The digest is the operator's final-state read; the BYTES are not, and this is the one mechanism in the fleet
  // where that is the state: the 22:03-22:05 pass hashed the file and quoted a same-day predecessor's contents,
  // while the file standing at the end of the day moved on from that. No rendering is attempted -- inventing the
  // lines to match a digest would be the one act worse than the silence -- and
  // `cap_mechanisms_with_unread_lines` names this row so no fold reads its digest as a checked file. The
  // superseded versions are deliberately not rendered either: a row describing bytes the host no longer holds
  // would be a second authority over a replaced state (gunbc.design_argument::single_authority).
  content_digest: CapUnitDigestRead {
    sha256: "253ba1cb38070757ea89b64e8fe8d3c07939f617057ee5ea2b313254cb187636" as NonEmptyStr,
  },
  cap_marking: "-pl 40" as NonEmptyStr,
  target_watts: watt(count: 40),
  reaches: EveryCardOnTheHost,
  persists_across_boot: true,
  backup_copy_beside: ReportedUnsaid {
    why: "the 2026-11-24 report names no backup beside the drop-in, and its absence was not checked" as NonEmptyStr,
  },
  lines_read: false,
  sm_clock: SmClockUnlocked {
    why: "the day moved under this file: 30 W (~09:34), 40 W (~19:24), 30 W (~22:02), and a same-evening version carrying a 210-1500 MHz lock like srv4's; the final-state read is 40 W with NO clock lock, so the lock the evening applied is not what stands. The nvidia-smi power.limit readings of ~06:10 UTC on 2026-11-25 saw 40 W on both cards, agreeing. Whether the lock returns is the operator's; the readings behind srv4's chosen level were taken on srv4's cards, not these." as NonEmptyStr,
  },
  runs_script: Absent,
  read_on: "applied by the operator by hand on 2026-11-24 (their words: gunbc.design_ruling::operator_hand_applied_srv3_srv4_power_caps_2026_11_24); final digest and final wattage from the operator's final-state ssh pass of 2026-11-24 22:03-22:05 UTC, confirmed by the nvidia-smi power.limit re-read of the 2026-11-25 ~06:10 UTC pass" as NonEmptyStr,
}

// KEN'S T10 MECHANISM, added 2026-11-24/25 from the operator's final-state pass. The shape is the reason it is a
// new row rather than an update to the two above: the cap rule is not in a unit file at all, it is in
// /usr/local/sbin/t10-power-cap.sh, which t10-power-cap.service runs -- and the script caps each card at the
// minimum THAT CARD reports (`power.min_limit`, which these three T10s report as 100 W), fails unless it sees
// EXPECT=3 cards, and locks each SM clock to 300,$CLOCK_MAX. The host is host-e2d4b7, the Supermicro H11SSL unit
// 3 the hostname registry (gunbc.hostname_allocation::fleet_machine_registry) approved under the name "ken" on
// 2026-11-16; the brief's shorthand "h11" for a T10 fact means THIS host, not host-6ce85c, whose Radeon AI PRO
// R9700 is a different machine on a different board. The unit's own bytes have never been read, and that is the
// open ask gunbc.integration_concern::h11ssl_unit3_t10_cap_applied_by_a_unit_the_model_cannot_express exists to
// close -- including its 2026-11-24 sighting of the clock ceiling this row records.
data ken_t10_hand_applied_gpu_cap: HandAppliedCapMechanism = HandAppliedCapMechanism {
  host: operator_host_e2d4b7,
  placement: CapUnitOfItsOwn { unit_path: "/etc/systemd/system/t10-power-cap.service" as NonEmptyStr },
  // The digest on this row is the SCRIPT's -- the file the pass hashed and quoted; the unit's bytes carry no
  // digest at all, and the concern row above owns that frontier rather than this field pretending.
  content_digest: CapUnitDigestRead {
    sha256: "a3ce006ba5f283b47c99a0419ed14d9725dc14befb6d62984cc16d6fcf825a0a" as NonEmptyStr,
  },
  cap_marking: "-pl $min (each card's own power.min_limit; these three T10s report 100 W), per enumerated index" as NonEmptyStr,
  target_watts: watt(count: 100),
  reaches: EveryCardOnTheHost,
  persists_across_boot: true,
  backup_copy_beside: ReportedUnsaid {
    why: "the pass named no backup beside the script or its unit, and their absence was not checked" as NonEmptyStr,
  },
  lines_read: true,
  sm_clock: SmClockLocked {
    low: hertz(count: 300000000),
    high: hertz(count: 1000000000),
    chosen_from: "kensweep.sh under live serving traffic, 150 s per level: unlocked, the cards swung 510-1575 MHz pinned at the cap at 92-96 W; locked at 1000 MHz the two cooler cards held ~990 MHz power-capped only 1% of the time at 68-80 W, while GPU1 (81:00.0, 82 C) stayed power-bound at every level (~790 MHz at 83 W, 83-88 W even at 600-800 MHz -- leakage) and set the pace for the 3-way split. Single readings under live load, not averages; the window decode rate was too noisy to decide on, the sweep's own note.",
    decided_on: "2026-11-24 ~22:45 UTC",
  },
  runs_script: Present {
    value: HandAppliedScript {
      path: "/usr/local/sbin/t10-power-cap.sh" as NonEmptyStr,
      content_digest: CapUnitDigestRead {
        sha256: "a3ce006ba5f283b47c99a0419ed14d9725dc14befb6d62984cc16d6fcf825a0a" as NonEmptyStr,
      },
      lines: ken_t10_power_cap_script_lines,
      instrument: "t10-power-cap.service executes it; sha256sum over ssh and the quoted lines are the operator's 2026-11-24 22:03-22:05 UTC pass" as NonEmptyStr,
    },
  },
  read_on: "the script was applied earlier and re-read at the operator's final-state ssh pass of 2026-11-24 22:03-22:05 UTC; the unit is left in place even though the T10 ENGINE service h11-strata-t10.service was stopped and disabled ~09:30 UTC 2026-11-24 -- is-enabled and is-active were not re-run against the cap unit, so persists_across_boot carries the install-time word, not a fresh systemctl read" as NonEmptyStr,
}

data hand_applied_cap_mechanisms: List<HandAppliedCapMechanism> = [
  srv4_hand_applied_gpu_cap, srv3_hand_applied_gpu_cap, ken_t10_hand_applied_gpu_cap,
]

// THE OPEN READ A DIGEST CARRIES, when it carries one. Absent means the whole value has been read. This is the
// module's whole frontier: it is read off the digest rather than kept beside it, so a digest cannot be promoted
// by typing while some other row still calls it unread -- there is no other row.
fn cap_unit_digest_discharge_read(d: CapUnitContentDigest) -> NonEmptyStr? {
  match d {
    CapUnitDigestMarkedOnly { head: _, tail: _, what_would_discharge_it } => Present { value: what_would_discharge_it }
    CapUnitDigestRead { sha256: _ } => Absent
  }
}

// Which card the mechanism's cap line addresses, where it addresses one. Absent is not "unread" and not
// "uncapped": it is the line the operator reported, `nvidia-smi -pl 30` with no `-i` selector, which reaches
// every card the host enumerates.
fn cap_card_selector(m: HandAppliedCapMechanism) -> NonEmptyStr? {
  match m.reaches {
    EveryCardOnTheHost => Absent
    OneCardByUuid { gpu_uuid } => Present { value: gpu_uuid }
  }
}

fn hand_applied_cap_mechanisms_on(host: HostIdentity) -> List<HandAppliedCapMechanism> {
  filter(hand_applied_cap_mechanisms, m => host_identity_eq(a: m.host, b: host))
}

// THE CAP A HOST SETS ON EVERY CARD IT CARRIES, where a hand-applied mechanism has been read doing exactly
// that. Absent means no such mechanism has been read on that host -- NOT that the host's cards run uncapped:
// srv1's cap is a one-card unit and lives in srv1_power_cap_boot_units, and h11 has no cap mechanism read at
// all. A consumer that needs the difference asks the two rosters separately.
fn host_wide_gpu_cap_watts(host: HostIdentity) -> Watt? {
  match filter(hand_applied_cap_mechanisms, m =>
    host_identity_eq(a: m.host, b: host)
      && optional_is_absent(opt: cap_card_selector(m: m))).first() {
    Absent => Absent
    Present { value: m } => Present { value: m.target_watts }
  }
}

// THE DEFAULT LIMIT IS WHAT MAKES "CAPPED" MEAN ANYTHING, so these joins compare against it rather than
// leaving the comparison in prose. Each can fail: a unit that caps a card at or above its own default is not
// capping it, and a board whose current limit is not its default is not resting on its default.

// Which board presents the device this unit addresses? Searched through the device rows, because the unit
// addresses a UUID and a board is not a UUID.
fn board_addressed_by(unit: PowerCapBootUnit, uuid: NonEmptyStr) -> PhysicalAssetIdentity? {
  match current_gpu_device_observations.filter(o => device_row_is_this_device(o: o, host: unit.host, uuid: uuid)).first() {
    Absent => Absent
    Present { value: o } => Present { value: gpu_device_observation_board(o: o) }
  }
}

// Does the device row name this host and this UUID? Split out so the searches above read as one question each.
fn device_row_is_this_device(o: GpuDeviceObservation, host: HostIdentity, uuid: NonEmptyStr) -> Bool {
  match o {
    GpuDeviceEnumerated { host: h, board: _, gpu_uuid: u, pci_address: _, power_limit_minimum: _, power_limit_maximum: _, power_limit_current: _, power_limit_default: _, power_limit_control: _, read_on: _ } =>
      host_identity_eq(a: h, b: host) && match u {
        Present { value: uu } => (uu as String) == (uuid as String)
        Absent => false
      }
    GpuDeviceNotEnumerated { host: _, board: _, cause: _, read_on: _ } => false
  }
}

// The default the device row carries for the device this unit addresses by this UUID. Absent when no device row
// carries that UUID, and Absent when the row exists but the default was never read -- a survey that recorded
// min/max/current without a default leaves this unread.
fn installed_cap_boot_unit_device_default(unit: PowerCapBootUnit, uuid: NonEmptyStr) -> Watt? {
  match board_addressed_by(unit: unit, uuid: uuid) {
    Absent => Absent
    Present { value: b } => match current_gpu_device_observations_of(board: b).first() {
      Absent => Absent
      Present { value: o } => gpu_device_observation_default(o: o)
    }
  }
}

// Does this unit's cap actually LOWER the card it addresses? True only when the device row for that UUID
// reports a default AND every cap command sits strictly below it. Without a read default the answer is false:
// "capped" is not licensed by the number looking small.
fn boot_cap_actually_reduces_the_device_default(unit: PowerCapBootUnit) -> Bool {
  unit.cap_commands.all(c => match installed_cap_boot_unit_device_default(unit: unit, uuid: c.addressed_gpu_uuid) {
    Absent => false
    Present { value: d } => watt_count(w: c.target_watts) < watt_count(w: d)
  })
}

// A board rests on its OWN DEFAULT when the device row says current equals default AND no installed boot
// mechanism addresses its UUID. This is the checkable form of "nothing is capped on this board" for the Max-Q:
// both halves must hold, so a stray cap command, or a current limit that has drifted from the default, makes
// it false.
fn board_rests_on_its_own_default(board: PhysicalAssetIdentity) -> Bool {
  match current_gpu_device_observations_of(board: board).first() {
    Absent => false
    Present { value: o } => match o {
      GpuDeviceEnumerated { host: h, board: _, gpu_uuid: u, pci_address: _, power_limit_minimum: _, power_limit_maximum: _, power_limit_current: c, power_limit_default: d, power_limit_control: _, read_on: _ } =>
        match u {
          Absent => false
          Present { value: uu } => match d {
            Absent => false
            Present { value: dv } =>
              watt_count(w: c) == watt_count(w: dv)
                && !srv1_power_cap_boot_units.any(unit => boot_unit_has_command_for(unit: unit, uuid: uu) && host_identity_eq(a: unit.host, b: h))
          }
        }
      GpuDeviceNotEnumerated { host: _, board: _, cause: _, read_on: _ } => false
    }
  }
}

// Does this unit issue a cap command addressing this UUID? Written as a match rather than an `is Present` so
// the answer is the same shape everywhere it is asked.
fn boot_unit_has_command_for(unit: PowerCapBootUnit, uuid: NonEmptyStr) -> Bool {
  match boot_unit_addresses(unit: unit, gpu_uuid: uuid) {
    Absent => false
    Present { value: _ } => true
  }
}

// The journal's own "set to 300.00 W FROM 600.00 W" is compared, here and only here, against the default the
// DEVICE ROW carries for that card. Two rows read by two instruments agreeing is a corroboration; one row
// agreeing with itself, as cap_realization used to do, is not a check.
fn cap_application_claim_starts_from_the_device_default(claim: CapApplicationClaim) -> Bool {
  match default_for_pci(host: claim.host, pci: claim.addressed_pci) {
    Absent => false
    Present { value: dv } => watt_count(w: claim.from_watts) == watt_count(w: dv)
  }
}

// The default limit reported for the device at this PCI function. The journal names a PCI function and the
// device row names one too, so this is the only join that can line them up -- but the two instruments print the
// SAME function at different widths: nvidia-smi's set-limit line says 00000004:01:00.0 (full 8-digit domain)
// and --query-gpu prints pci.bus_id as 0004:01:00.0. The containment test is therefore on purpose, not a
// shortcut: an exact string_eq here would report "no such device" for the device it is looking for.
fn default_for_pci(host: HostIdentity, pci: NonEmptyStr) -> Watt? {
  match current_gpu_device_observations.filter(o => device_row_is_on_host_at_pci(o: o, host: host, pci: pci)).first() {
    Absent => Absent
    Present { value: o } => gpu_device_observation_default(o: o)
  }
}

fn device_row_is_on_host_at_pci(o: GpuDeviceObservation, host: HostIdentity, pci: NonEmptyStr) -> Bool {
  match o {
    GpuDeviceEnumerated { host: h, board: _, gpu_uuid: _, pci_address: p, power_limit_minimum: _, power_limit_maximum: _, power_limit_current: _, power_limit_default: _, power_limit_control: _, read_on: _ } =>
      host_identity_eq(a: h, b: host) && string_contains(s: pci as String, pattern: p as String)
    GpuDeviceNotEnumerated { host: _, board: _, cause: _, read_on: _ } => false
  }
}

// ---------------------------------------------------------------------------------------------
// The bytes the 2026-11-24 22:03-22:05 UTC final-state pass quoted, rendered BY THIS MODEL rather than
// transcribed beside it, for the two mechanisms whose file it gave in full. srv3's is deliberately absent: its
// final digest came without bytes, and `cap_mechanisms_with_unread_lines` keeps that row out of these folds.
// The unit grammar is extdeps.systemd.unit_file -- the same authority the CPU-frequency cap rows render
// through (gunbc.fleet.cpu_freq_cap_boot_state::cpu_freq_cap_unit) -- so one serialization answers for every
// systemd file this fleet records; nothing here opens a second spelling of a unit.
// ---------------------------------------------------------------------------------------------

data srv4_gpu_power_cap_unit: SystemdUnitFile = ServiceUnitFile {
  unit: [
    Description {
      text: "Cap the RTX 2000 Ada GPUs at 30 W (operator 2026-10-26 noise/heat at 40 W; lowered to 30 W 2026-11-24 for power after surge-strip trips; matches srv3); SM clock locked to 210-1500 MHz 2026-11-24 so it does not boost then throttle at 30 W (measured: avg 906 vs 869 MHz unlocked at 27.0 vs 29.1 W). Hand edit, recorded for gunbc.plans.gpu_card_host_program." as NonEmptyStr,
    },
    After { target: "nvidia-persistenced.service" as NonEmptyStr },
    Requires { target: "nvidia-persistenced.service" as NonEmptyStr },
  ],
  service: [
    ServiceType { mode: OneshotMode },
    RemainAfterExit { active: true },
    ExecStart { command: "/usr/bin/nvidia-smi -pl 30" as NonEmptyStr },
    ExecStart { command: "/usr/bin/nvidia-smi -lgc 210,1500" as NonEmptyStr },
  ],
  install: Installable { directives: [WantedBy { target: "multi-user.target" as NonEmptyStr }] },
}

fn srv4_gpu_power_cap_unit_bytes() -> String {
  serialize_systemd_unit_file(file: srv4_gpu_power_cap_unit)
}

fn srv4_gpu_power_cap_unit_sha256() -> String {
  sha256_hex_of_text(text: srv4_gpu_power_cap_unit_bytes())
}

// ken's cap script, transcribed exactly -- the operator's pass quoted every line. A line dropped, a space lost,
// a quote mistyped moves the digest and reds ken_t10_script_transcription_is_the_host_file.
data ken_t10_power_cap_script_lines: List<NonEmptyStr> = [
  "#!/bin/sh" as NonEmptyStr,
  "# Cap every NVIDIA GPU at its own minimum power limit (operator 2026-11-15: \"lower their power as low as possible\"), read back, fail if not applied." as NonEmptyStr,
  "# ken carries three Tesla T10s since 2026-11-17 (SLOT4 01:00.0, SLOT6 81:00.0, SLOT2 c1:00.0); fewer than EXPECT fails the unit." as NonEmptyStr,
  "set -eu" as NonEmptyStr,
  "EXPECT=3" as NonEmptyStr,
  "# SM clock ceiling (2026-11-24): at 100 W the T10s boost to 1575 then throttle to ~500; locked at 1000 the cool cards hold ~990 MHz" as NonEmptyStr,
  "# at 68-80 W instead of 92-96 W, and the hot one is power-bound either way." as NonEmptyStr,
  "CLOCK_MAX=1000" as NonEmptyStr,
  "nvidia-smi -pm 1 >/dev/null" as NonEmptyStr,
  "n=0" as NonEmptyStr,
  "for i in $(nvidia-smi --query-gpu=index --format=csv,noheader); do" as NonEmptyStr,
  "  min=$(nvidia-smi -i $i --query-gpu=power.min_limit --format=csv,noheader,nounits | cut -d. -f1)" as NonEmptyStr,
  "  nvidia-smi -i $i -pl $min >/dev/null" as NonEmptyStr,
  "  got=$(nvidia-smi -i $i --query-gpu=power.limit --format=csv,noheader,nounits | cut -d. -f1)" as NonEmptyStr,
  "  echo \"gpu $i ($(nvidia-smi -i $i --query-gpu=pci.bus_id --format=csv,noheader)): limit $got W (min $min W)\"" as NonEmptyStr,
  "  [ \"$got\" = \"$min\" ] || { echo \"gpu $i readback $got != $min\" >&2; exit 1; }" as NonEmptyStr,
  "  nvidia-smi -i $i -lgc 300,$CLOCK_MAX >/dev/null" as NonEmptyStr,
  "  echo \"gpu $i: SM clock locked to 300-$CLOCK_MAX MHz\"" as NonEmptyStr,
  "  n=$((n+1))" as NonEmptyStr,
  "done" as NonEmptyStr,
  "[ $n -eq $EXPECT ] || { echo \"expected $EXPECT GPUs, saw $n\" >&2; exit 1; }" as NonEmptyStr,
]

fn ken_t10_power_cap_script_bytes() -> String {
  join(map(ken_t10_power_cap_script_lines, l => l as String), "\n") + "\n"
}

fn ken_t10_power_cap_script_sha256() -> String {
  sha256_hex_of_text(text: ken_t10_power_cap_script_bytes())
}

// Which mechanisms' digests are READ (full sha256) rather than marked-only, and so can enter a render fold.
fn hand_applied_digest_read(m: HandAppliedCapMechanism) -> String? {
  match m.content_digest {
    CapUnitDigestRead { sha256 } => Present { value: sha256 as String }
    CapUnitDigestMarkedOnly { head: _, tail: _, what_would_discharge_it: _ } => Absent
  }
}

// The row whose file has never been quoted: srv3's drop-in today. A fold that compares emitted bytes against
// host digests must exclude it -- its digest is a fact about a file the model does not describe, not a render
// target. Naming it here is what keeps `lines_read: false` from being decoration on the type.
fn cap_mechanisms_with_unread_lines() -> List<HandAppliedCapMechanism> {
  filter(hand_applied_cap_mechanisms, m => !m.lines_read)
}

// THE RENDER IS THE HOST'S FILE. srv4's unit digest is the digest this grammar emits, byte for byte: an edit to
// a directive here, or drift between the row and what the host hashed, goes red.
fn srv4_cap_unit_render_is_the_host_file() -> Bool {
  match hand_applied_digest_read(m: srv4_hand_applied_gpu_cap) {
    Absent => false
    Present { value: read } => read == srv4_gpu_power_cap_unit_sha256()
  }
}

// THE TRANSCRIPTION IS THE HOST'S FILE, to the same standard -- the script the unit runs, not the unit itself,
// whose bytes remain the frontier gunbc.integration_concern::h11ssl_unit3_t10_cap_applied_by_a_unit_the_model_cannot_express
// exists to close.
fn ken_t10_script_transcription_is_the_host_file() -> Bool {
  match ken_t10_hand_applied_gpu_cap.runs_script {
    Absent => false
    Present { value: s } =>
      match s.content_digest {
        CapUnitDigestRead { sha256 } => sha256 as String == ken_t10_power_cap_script_sha256()
        CapUnitDigestMarkedOnly { head: _, tail: _, what_would_discharge_it: _ } => false
      }
  }
}

// The unread-lines row is exactly the one whose digest no render fold can reach: if srv3 ever gets its bytes,
// this goes red and the frontier closes in the open, without any fold quietly absorbing the new file.
fn the_unread_lines_row_is_the_unreachable_digest() -> Bool {
  let unread = cap_mechanisms_with_unread_lines()
  unread.all(m =>
    match hand_applied_digest_read(m: m) {
      // srv3's digest IS read -- that is the point: a full sha with nothing to render against.
      Present { value: _ } => true
      Absent => false
    })
    && unread.length() == 1
    && match unread.first() {
      Present { value: m } => host_identity_eq(a: m.host, b: operator_host_srv3)
      Absent => false
    }
}
