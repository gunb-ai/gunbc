module gunbc.fleet.fleet_tailnet

import std.types { NonEmptyStr, String, Port }
import extdeps.dns.domain_name { DnsLabel }
import product.host_identity { HostIdentity }
import gunbc.hostname_allocation { canonical_hostname_for_fleet_slot, allocated_canonical_hostname, HostnameAllocation }

// THE FLEET'S TAILNET DOMAIN, as a leaf. gunbc.fleet.fleet_intent_network fleet_intent_network carries it
// as its topology's tailnet_domain, and the approval broker composes its public address from it
// (gunbc.auth.approval_broker_endpoint approval_broker_base_url_on); a reader of the domain does not
// import the topology's assets, segments and endpoints.
// THE AUTHORITARY FORM IS THE LABEL LIST; the dotted string is JOINED FROM IT, so the tailnet zone is
// declared once (P4, gunbc.plans.fleet_machine_authority 2.3). A host's full tailnet labels are
// fleet_tailnet_name: its registry name's canonical label followed by these zone labels. The
// machine's handle is never read here (decision D12) — a rename in the registry moves the address.
data fleet_tailnet_zone_labels: List<DnsLabel> = ["tailecbe08" as DnsLabel, "ts" as DnsLabel, "net" as DnsLabel]
data fleet_tailnet_domain: NonEmptyStr? = Present { value: join(map(fleet_tailnet_zone_labels, label => (label as String)), ".") as NonEmptyStr }

// THE ONE TAILNET HOST COMPOSITION: a machine's tailnet address labels are its canonical registry NAME
// followed by the fleet tailnet zone labels. Every consumer that names a machine on the tailnet derives
// the host from here -- the known_hosts rows via `fleet_tailnet_name` (the registry-row form) and the
// broker's public address via `tailnet_host_from` (the run-time handle form) -- so the tailnet host string
// is BUILT AT EXACTLY ONE SITE (gunbc.design_argument::single_authority; review 94196 F2). It spells the
// machine's NAME (a `DnsLabel`), never its handle (D12), and appends the ONE zone declaration above.
fn tailnet_host_labels(name: DnsLabel) -> List<DnsLabel> {
  concat([name], fleet_tailnet_zone_labels)
}

// A machine's full tailnet address labels: the canonical hostname derived from its REGISTRY NAME, then the
// fleet tailnet zone labels. Total over a registry row (the name is total there); the absent domain can
// never yield a wrong address because the zone labels are concrete here. This is the tailnet-name authority
// for known_hosts rows (plan 2.3 "known_hosts address ... from fleet_tailnet_name(machine)").
fn fleet_tailnet_name(machine: HostnameAllocation) -> List<DnsLabel> {
  tailnet_host_labels(name: allocated_canonical_hostname(allocation: machine))
}

// THE ADDRESS IS JOINED FROM THE AUTHORITIES THAT ALREADY OWN ITS PARTS, not spelled as one
// literal. An earlier revision of the ntfy binding (gunbc.auth.approval_ntfy_deployment, now
// retired by gunbc.fleet.approval_ntfy_retirement) wrote
// "https://srv1.tailecbe08.ts.net:8443", which re-minted two facts the corpus owns elsewhere -- the
// tailnet domain (fleet_tailnet_domain above) and the host's identity, which each caller passes as
// `host` from its own authority (gunbc.fleet.fleet_host_identity operator_host_srv1 for the ntfy
// front door,
// the serving host for the broker, gunbc.auth.approval_broker_endpoint approval_broker_serving_base_url). Renaming the
// tailnet or the host would have left that string stale while every modeled consumer moved.
//
// The address a CLIENT dials is a different fact from the address the SERVER listens on
// (the ntfy server's listen address, held to loopback by policy and gone with the retirement);
// tailscale serve is what joins them,
// and each is asserted for its own job.
//
// THE ABSENT ARM FAILS CLOSED, NOT PLAUSIBLY. There is no free domain input that could be undeclared: the
// tailnet zone is declared ONCE above (fleet_tailnet_zone_labels) and folded into the one host composition,
// so the ONLY absent arm is an unregistered machine -- no name, therefore no address. The old form
// fabricated a host in the RFC 2606 `.invalid` TLD for an undeclared-domain case that should never have been
// a caller input; that plausible-looking fabricated default DESIGN.md rejects is gone, and the caller
// refuses with its own cause rather than substituting a host that cannot resolve
// (gunbc.design_argument::fail_closed). THE HOST IS THE MACHINE'S CANONICAL REGISTRY NAME composed with the
// ONE zone above by `tailnet_host_labels` -- the SAME site the known_hosts rows build through
// `fleet_tailnet_name` -- so the broker's public host and the known_hosts address are the same fact and
// cannot drift, and there is no second host spelling and no free domain parameter (review 94196 F2).
//
// ONE COMPOSITION FOR EVERY SERVICE TAILSCALE SERVE PUBLISHES: the host and port are the parameters;
// on srv1 the port is the only fact that differs between the retired ntfy address and the roadmap
// server's
// (which the approval links point at, gunbc.auth.approval_request_submission). Absent means the
// default TLS port and no `:port` suffix, which is how tailscale serve renders the 443 listener.
// THE HOST IS ITS OWN FACT, read by a client that composes the URL itself: the approvals app sets
// scheme, host and path on URLComponents separately (gunbc.approve_ios_swift_wire ServerConfig), so
// it needs the bare host and not the base URL. The base URL below is built FROM this, so the two
// cannot disagree.
fn tailnet_host_from(machine: HostIdentity) -> NonEmptyStr? {
  match canonical_hostname_for_fleet_slot(fleet_slot: machine) {
    Absent => Absent
    Present { value: name } =>
      Present { value: join(map(tailnet_host_labels(name: name), label => (label as String)), ".") as NonEmptyStr }
  }
}

fn tailnet_base_url_from(machine: HostIdentity, port: Port?) -> NonEmptyStr? {
  match tailnet_host_from(machine: machine) {
    Present { value: h } =>
      Present {
        value: join([
          "https://",
          h as String,
          match port { Present { value: p } => concat(":", to_string(p))  Absent => "" },
        ], "") as NonEmptyStr
      }
    Absent => Absent
  }
}
