fn ci_fleet_wif_auth_step() -> Step {
  UsesStep {
    name: Present { value: "WIF auth (OIDC -> fleet-cloud-convergence SA, access token only)" },
    id: Present { value: "wif_auth" },
    uses: google_auth_action,
    with: Present {
      value: [
        kv(key: "workload_identity_provider", value: yaml_string(s: probe_identity_secret_access_requirement.wif_provider_resource)),
        kv(key: "service_account", value: yaml_string(s: probe_identity_secret_access_requirement.service_account)),
        kv(key: "token_format", value: yaml_string(s: "access_token")),
        kv(key: "create_credentials_file", value: yaml_bool(b: false))
      ]
    },
    env: none,
    if_condition: none,
    continue_on_error: none,
    timeout_minutes: Present { value: gunbc_ci_aux_step_timeout_minutes }
  }
}

fn ci_fleet_key_agent_step() -> Step {
  ci_fleet_key_agent_step_when(if_condition: none)
}

// A job whose dispatches do not all consume host SSH authority passes the condition under which
// they do, so a run that never opens a fleet session never holds the key (least access).
fn ci_fleet_key_agent_step_when(if_condition: String?) -> Step {
  RunStep {
    name: Present { value: "Materialize fleet key in-run (SM versions/1 pinned -> RUNNER_TEMP 0600 -> ssh-agent -> wipe file)" },
    id: none,
    run: gunbc_ci_fleet_key_agent_script(),
    shell: none,
    env: Present {
      value: [kv(key: "WIF_ACCESS_TOKEN", value: yaml_string(s: "${{ steps.wif_auth.outputs.access_token }}"))]
    },
    working_directory: none,
    if_condition: if_condition,
    continue_on_error: none,
    timeout_minutes: Present { value: gunbc_ci_aux_step_timeout_minutes }
  }
}

fn ci_fleet_key_agent_cleanup_step() -> Step {
  RunStep {
    name: Present { value: "Kill the in-run ssh-agent (key never outlives the job)" },
    id: none,
    run: gunbc_ci_fleet_key_agent_cleanup_script(),
    shell: none,
    env: none,
    working_directory: none,
    if_condition: Present { value: "always()" },
    continue_on_error: none,
    timeout_minutes: Present { value: gunbc_ci_aux_step_timeout_minutes }
  }
}

data ci_native_cache_derive_step_name: String = "Derive native-cache root (rustc-version segment; after setup-rust-toolchain)"

// Adjacency-as-proxy ordering witness (not a structural Step-order predicate):
// ci_native_cache_prelude_order_bridge builds the setup-rust HOME env line immediately followed by
// the native-cache step name at the emitter's six-space yaml indent.
// witness_prelude_native_cache_root_step_follows_setup_rust asserts expected_ci_yml/falsifier_yml
// contain that substring. The real invariant is only that segment derivation runs after
// setup-rust-toolchain installs rustc; this check over-constrains to textual adjacency and can
// false-RED on a legitimate step inserted between setup-rust and native-cache, emitter yaml
// reformatting, or setup-rust gaining fields after HOME — but not false-green if ordering
// regresses. A hand-rolled match on Step would be the structural alternative; non-fold-residue
// forbids the wildcard arms that predicate would need (receipt: nfr floor on 14bc815db4). Dissolves
// when prelude ordering is witnessed without coproduct-residue match arms.
data ci_release_bins_artifact_name: String = "release-bins"

data gunbc_ci_aux_step_timeout_minutes: Duration = 5

// Fleet-converge PLAN is not an aux no-op: it typechecks the closure then observes every required
// retiree (srv1's 50-wide prior is 38 identities, each a UnitFileState + ActiveState + cgroup
// occupancy). Run 35230228049 wrote plan.txt and apply.sh and then the shared 5m aux budget killed
// the step before artifact upload. This budget is an envelope for that observe, not a measurement
// of typecheck. Raising gunbc_ci_aux_step_timeout_minutes would multiply across every aux step
// and the job backstop; this constant is the one step.
data gunbc_ci_fleet_converge_plan_step_timeout_minutes: Duration = 15

data gunbc_ci_spark_serving_step_timeout_minutes: Duration = 60

data gunbc_ci_spark_serving_step_timeout_note: String = "Spark serving converge/observe step budget, raised from the shared aux 5m (operator authorization 2026-08-19). STATED AS AN ENVELOPE, NOT A MEASUREMENT, because the neighbouring gates in this module earn their numbers and this one cannot yet. What IS modeled: the ollama runtime archive at 1542416321 bytes, cited on extdeps.ollama.binary_release. What is NOT: the model blob closure has no modeled byte size at all — the desired model is identified by its manifest digest rather than a size — and throughput from the executor to a spark target has never been measured. So a cold install downloads a ~1.5GB runtime plus a model of unmodeled size over a link of unmeasured bandwidth, and no honest derivation produces a minute count from that. 5m was not a considered budget for this step, it was the shared aux default, and it cannot cover a cold install under any plausible bandwidth.

WHAT IS OBSERVED, and why this is not a hypothetical envelope: run 32213195686 (2026-08-19T03:49:56Z, read-only spark_observe) reports state=absent for BOTH spark targets — on srv6 the user unit is-active exits 4, the api/version and api/tags probes exit 7 against a refused connection, and the runtime receipt file does not exist. So the first canary is a guaranteed cold install of the full closure rather than a converged no-op, and the step budget has to cover acquisition of an unmodeled model closure on a host observed to hold none of it. The 5m default would have killed that install mid-download every time, and because publication is split from acquisition it would have done so silently-safely — dying in the attempt workspace, publishing nothing, and looking like a timeout rather than a budget defect.

Why the step needed its own constant rather than a bump to gunbc_ci_aux_step_timeout_minutes: that value is multiplied by the step count in the fleet job backstop, so raising it would inflate every unrelated aux step and the job cap together — a per-site cost paid fleet-wide to fix one step.

STEADY STATE IS SECONDS, NOT MINUTES. A converged host plans zero rows and the slice returns without transferring anything; this envelope is paid only on a cold or drifted target. A run that approaches it is therefore evidence about the install path, not a budget to raise again.

DISSOLVE-ON: the first successful srv6 canary produces the measurement this envelope stands in for — replace the number with that receipt, dated and cited to its run id, per the rule the v1-compiler test-targets gate states one constant down (raising a budget needs a measurement, not a round number)."

data gunbc_ci_runner_guest_image_step_timeout_minutes: Duration = 30

data gunbc_ci_runner_guest_image_step_timeout_note: String = "Runner micro-VM guest image observe/converge step budget, raised from the shared aux 5m. It is its own constant rather than a bump to gunbc_ci_aux_step_timeout_minutes for the reason the Spark serving envelope one section up already records: that value is multiplied by the step count in the fleet job backstop, so raising it inflates every unrelated aux step and the job cap together.

STATED AS AN ENVELOPE, NOT A MEASUREMENT, and the honest reason is that NONE of the three inputs has a modeled size. extdeps.virtualization.firecracker carries the CI kernel and the Ubuntu 24.04 rootfs by URL ONLY -- the vendor publishes no digest beside them, which is the same gap gunbc.runner_guest_image opens its first-observed provenance rows for, and a URL that does not carry a digest does not carry a byte count either. The Actions runner tarball is pinned by digest on extdeps.github.actions_runner and still has no modeled size. Nor has throughput from a runner host to either origin ever been measured. So no honest derivation produces a minute count, and 5m was never a considered budget for this step -- it was the shared aux default inherited by construction.

WHY BOTH MODES CARRY IT rather than only the converge: observe FETCHES the base artifacts before it can hash them, so it pays the same unmodeled download on a cold host. What it does not pay is the extraction and the mke2fs population of an 8192 MiB image, which is why the converge is the arm that would actually approach this envelope.

STEADY STATE IS SECONDS, NOT MINUTES. A host that already holds the base artifacts re-hashes files it has and returns; this envelope is paid on a cold host only. A run that approaches it is therefore evidence about the fetch or the build path, not a budget to raise again.

DISSOLVE-ON: the first successful guest_image_converge on a cold host produces the measurement this envelope stands in for -- replace the number with that receipt, dated and cited to its run id, per the rule stated one constant down that raising a budget needs a measurement rather than a round number."

// Runner host file observe/converge step budget, raised from the shared aux 5m for a measured reason:
// the step is one `gunbc run` whose closure resolve dominates, and the fleet plan step -- the nearest
// resolve of comparable size -- took 3m55s to 4m18s on runs of 2026-09-04 against that same 5m, so the
// aux budget would make a slow resolve read as a converge failure. The remote legs are a dozen short
// ssh execs. Its own constant for the reason the Spark envelope records: the aux value is multiplied by
// the step count in the fleet job backstop.
data gunbc_ci_runner_host_file_step_timeout_minutes: Duration = 15

data gunbc_ci_v1_compiler_tests_compile_gate_timeout_minutes: Duration = 15

// v1-compiler-tests retained-kernel execution gate step budget. Originally a compile-contract gate
// (operator ruling 2026-08-05, PR A / fierce-heron-177): reordered after the release build and
// switched to cargo test --release --no-run so v1-compiler compiles once per job. --no-run removed
// 2026-08-11 with the suite cutover; the crate shrank from 98 modules / 740 tests to the 9 declared
// retained modules / 30 tests, which execute rather than only compile. Warm runs should complete in
// seconds once the release artifact is warm; 15m retains the prior cold-host envelope without
// raising the cap.
data gunbc_ci_stage0_partition_compile_gate_timeout_minutes: Duration = 15

// stage0 partition compile gate step budget (sharp-fox-403 C1): seven sequential cargo check -p
// v1-stage0-* partition crates enrolled as the build-job compile backstop over
// stage0_partition_crate_rows. Cold-host envelope matches v1-compiler-tests compile gate until a
// dedicated receipt exists; warm partition crates are smaller than the monolith test crate.
data gunbc_ci_v1_compiler_test_targets_compile_gate_timeout_minutes: Duration = 10

// v1-compiler test-targets compile gate step budget. 10 minutes against 67s MEASURED for this
// step's exact argv (cargo check -p v1-compiler --all-targets, cold, remote runner, on the repaired
// tree after gunbc#8167 / gunbc#8173 landed the lib-test compile fix). The earlier figure recorded
// here was 99s from cargo check --workspace --all-targets, which was an upper BOUND rather than
// this step's cost — it was all that could be measured while main's lib test target did not
// compile, and it is superseded rather than kept beside the real number. Deliberately BELOW the 15m
// carried by the v1-compiler-tests and partition gates rather than copied from them: those two
// inherited a cold-host envelope with no dedicated receipt, and repeating a number nobody measured
// is how an unmeasured envelope becomes precedent. The gate runs AFTER the release build for the
// same reason the retained-kernel gate does — v1-compiler is already compiled in release with the
// shared feature set, so the check reuses that artifact instead of forcing a second compile.
// Raising this needs a measurement, not a round number.
data gunbc_ci_artifact_transfer_step_timeout_minutes: Duration = 10

// Cross-job handoff of the release bins (operator job-split ruling 2026-07-11): the build job packs
// ci_floor_required_artifact_names into one tgz (tar preserves the executable bits a raw artifact
// zip would drop) and uploads it; the ci floor job downloads, unpacks into target/release, and
// re-verifies via claim_executor --verify-build-artifacts before any step consumes a bin
// (fail-closed: a missing or truncated artifact reds the job at the verify, never as a mid-floor
// bin fallback). 10m is the transfer envelope for a ~200MB archive under fleet pressure; upload
// uses if-no-files-found: error so an empty pack is loud.
data gunbc_ci_prelude_allowance_minutes: Duration = 5

data gunbc_ci_release_build_step_timeout_minutes: Duration = 45

// Its own tier rather than a borrowed one. The aux tier (5m) is sized for a small command and this
// step rsyncs a tree, writes a unit, restarts and waits on readiness; the spark tier (60m) is the
// right magnitude but wrong name, and spending a `spark_serving` constant on a dashboard deploy
// would be the second-name-for-one-concept violation DESIGN section 3 forbids. 30m is a ceiling on a
// hung deploy, not a budget: the observe-then-cutover path either converges or refuses well inside
// it, and exceeding it means the host mutation is stuck rather than slow.
data gunbc_ci_live_deploy_step_timeout_minutes: Duration = 30

// WHY THIS GROUP EXISTS, STATED AGAINST THE DEPLOYMENT THAT ACTUALLY RUNS TODAY. An earlier
// revision of this reason said blue/green selection is observe-then-mutate, so two jobs could both
// observe blue active and the second would restart what had become the active green slot. THAT
// MECHANISM DOES NOT EXIST: blue/green was deleted at the root on 2026-08-19 by operator directive
// (annotated on gunbc.live_deploy.apply live_deploy_fold), and apply now converges deployment_spec_srv1 IN
// PLACE. The conclusion survived the deletion and its stated reason did not, which is the §3
// stale-citation failure -- and it is the load-bearing kind, because a reader who checks the cited
// mechanism finds it gone and can correctly conclude the group is obsolete.
//
// THE CURRENT REASON IS INTERLEAVING ON ONE TARGET, and in-place convergence makes it stronger
// rather than weaker. Two candidate transactions write the same source tree, the same binary path,
// the same unit, the same process and the same readiness subject, so each transaction's readback can
// observe artifacts the other installed:
//
//   A observes candidate A -> B observes candidate B -> A installs tree A -> B installs tree B
//   -> A installs binary A -> B restarts on a mixed pair -> A's readiness gate observes B's process
//
// The gate then reports a healthy service that is not the one A published. Job-grain concurrency
// with cancel_in_progress=false serializes the whole window; QueueNotMax may replace an older
// PENDING deployment, but never interrupts the one holding the host.
//
// WHAT THIS GROUP DOES NOT ESTABLISH, named so it is not mistaken for a wall it is not:
// serialization is not ORDERING -- a slow build of an older revision can acquire the lease after a
// fast build of a newer one and install backwards -- and it is not COMPLETE INGRESS, because
// `gunbc.apply` DashboardSrv1 reaches live_deploy_apply_srv1_wet directly and never traverses a
// GitHub concurrency group at all. The first is open. The second's closing construction NOW EXISTS:
// `gunbc.deploy_transition` `acquire_transition_lease` is the host-local lease, an O_EXCL create
// under the deployment's own instance root, so both ingresses contend for one file and the loser
// takes a typed refusal naming the holder. GitHub owns only one transport into the critical
// section, which is why the wall could never live in a concurrency group. WHAT IS NOT CLAIMED: the
// lease exists and is witnessed, and this workflow does not yet acquire it -- binding it into the
// mutating ingresses is a separate change, so the bypass is closable rather than closed. Recorded here rather than left implicit because a concurrency group is exactly the kind
// of artifact a later reader cites as the serialization authority.
// ONE MUTATION DOMAIN PER HOST, SHARED BY EVERY JOB THAT CONVERGES OR READS BACK THAT HOST (RLM-2
// ruling section 9). The group used to be the literal "srv1-dashboard-deploy" and applied to the
// dashboard job alone, so a fleet apply and a dashboard deploy could interleave on srv1, and a
// final readback could observe a host mid-mutation. The group is now derived from the `host`
// input, so plan/apply, dashboard deploy and the launch-deployment receipt of ONE host queue behind
// each other while different hosts stay independent. Expression-valued because the host is a
// dispatch input, not a constant of the workflow.
// ONE MUTATION-DOMAIN PRODUCER, SPELLED ONCE. Three rows named this domain and differed only in the
// GHA expression that resolves the host: a plain dispatch input twice, and a map lookup for the reset
// observer. The prose beside them asserted they were the SAME `gunbc-host-mutation-<host>` domain,
// and prose is not an edge -- the domain name is only load-bearing if two jobs keying the same host
// CANNOT drift apart, and three hand-spelled prefixes can. The producer takes the host expression
// because that is the part that genuinely differs; the prefix and the `${{ }}` wrapping are the fact
// being shared.
fn host_mutation_concurrency_group_expression(host_expression: String) -> String {
  join(["gunbc-host-mutation-${{ ", host_expression, " }}"], "")
}

data fleet_host_mutation_concurrency_group_expression: String = host_mutation_concurrency_group_expression(host_expression: "github.event.inputs.host")

// The Int->Nat crossing is admitted at a function RETURN position (std.checked_arithmetic's own
// note), so the sum of the positive per-step allowances crosses here and the public fn carries the
// std.measure Minute duration rather than a bare scalar (review 57760 finding 1).
fn gunbc_ci_rlm_launch_deployment_receipt_job_backstop_minute_count() -> Nat {
  gunbc_ci_prelude_allowance_minutes
    + (4 * gunbc_ci_artifact_transfer_step_timeout_minutes)
    + (5 * gunbc_ci_aux_step_timeout_minutes)
    + gunbc_ci_artifact_transfer_step_timeout_minutes
}

fn gunbc_ci_rlm_launch_deployment_receipt_job_backstop_timeout() -> Minute {
  minute(count: gunbc_ci_rlm_launch_deployment_receipt_job_backstop_minute_count())
}

fn gunbc_ci_build_job_backstop_timeout_minutes() -> Int {
  gunbc_ci_aux_step_timeout_minutes + gunbc_ci_v1_compiler_tests_compile_gate_timeout_minutes + gunbc_ci_stage0_partition_compile_gate_timeout_minutes + gunbc_ci_v1_compiler_test_targets_compile_gate_timeout_minutes + gunbc_ci_release_build_step_timeout_minutes + gunbc_ci_aux_step_timeout_minutes + gunbc_ci_artifact_transfer_step_timeout_minutes + gunbc_ci_prelude_allowance_minutes
}

data gunbc_ci_fleet_job_always_run_aux_step_count: Int = 5

data gunbc_ci_fleet_job_always_run_artifact_transfer_step_count: Int = 1

data gunbc_ci_fleet_job_worst_case_mode_aux_step_count: Int = 1

data gunbc_ci_fleet_job_worst_case_mode_spark_step_count: Int = 1

// SUPERSEDES the 2026-08-21 first correction (prelude + 7*aux + 3*transfer + 5*spark = 370m), which
// fixed the tier miscount in the prior 11*aux+2*spark formula but kept its structural error:
// summing every tier-step COUNT as though every step in fleet_converge_job() executes in one run.
// It does not. The job's steps are gated by the single-select `mode` DispatchInput (InputChoice,
// exactly one value per dispatch — fleet_converge_workflow.dag DispatchInput "mode"), so
// plan/apply/spark_linger/spark_grants/spark_observe/spark_reboot/spark_durability are MUTUALLY
// EXCLUSIVE per run, not concurrent tiers to sum. Recounted from fleet_converge_job()'s actual step
// list (gunbc.fleet_converge_workflow fleet_converge_job) by what a single dispatch can actually execute:
// ALWAYS-RUN, no if_condition or if_condition: always() — ci_release_bins_download_step (transfer),
// ci_release_bins_unpack_verify_step, ci_fleet_wif_auth_step, ci_fleet_key_agent_step,
// ci_spark_admin_credential_cleanup_step, ci_fleet_key_agent_cleanup_step (5 aux + 1 transfer,
// always). MODE-GATED, at most one bundle applies per dispatch: mode=plan adds
// fleet_converge_plan_step(aux)+fleet_converge_plan_upload_step(transfer)=15m; mode=apply adds
// fleet_converge_plan_download_step(transfer)+fleet_converge_apply_step(aux)+fleet_converge_apply_receipt_upload_step(transfer)=25m
// (the typed apply receipt upload, RLM-2a);
// mode=spark_linger/spark_observe/spark_reboot/spark_durability each add exactly one spark
// step=60m; mode=spark_grants adds
// ci_spark_admin_credential_step(aux)+fleet_converge_spark_grants_step(spark)=65m, the WORST CASE
// because it is the only mode combining an aux-tier step with a spark-tier step. Worst-case
// single-run total: 5 + (5+1)*5 + 1*10 + 1*60 = 105m, comfortably inside extdeps.github.actions
// max_job_timeout_minutes (360m) — the >360 conflict raised on review of the first correction
// (bright-ferret-335, gunbc#8782) dissolves under the corrected model rather than needing a
// rounded-down number or a job split; checked_job_timeout_minutes below still guards the class for
// any future per-tier raise. The mode roster shrank on 2026-08-27 when the session-container lane
// was deleted; session_demand_observe was one aux-tier-shaped step under a spark-tier budget,
// strictly below the spark_grants worst case, so removing it does not move this figure either --
// the value derives from the always-run counts plus that worst case and never from the roster size.
// These counts remain hand-authored cardinals against fleet_converge_job()'s step list
// (fleet_workflow_steps cannot import fleet_converge_workflow without a cycle), so this note is the
// single authority to update alongside any change to that job's step composition, if_condition
// gating, or mode set. UPDATED for the dashboard_deploy mode, which was added after that deletion:
// THIS job's bound is unchanged, and the reason is the load-bearing part rather than the
// arithmetic. dashboard_deploy does not add a step to fleet_converge_job() at all -- it is a
// separate job (fleet_converge_workflow fleet_converge_dashboard_deploy_job), because
// fleet_host_mutation_concurrency_group_expression requires JOB-GRAIN concurrency that a step
// inside this job could not carry. So the mode is gated by that job's own if_condition and budgeted
// by its own backstop (gunbc_ci_dashboard_deploy_job_backstop_timeout_minutes, a straight sum
// because every step in it runs on every dispatch of it), and the 105m worst case here still
// belongs to spark_grants. A future reader checking whether a new mode moved this bound should ask
// FIRST whether the mode added a step to this job: adding a mode and adding a step to this job are
// different events, and only the second one moves this number. The rlm_launch_deployment_receipt
// mode (RLM-2a) is, like dashboard_deploy, its OWN job (fleet_converge_workflow
// fleet_converge_rlm_launch_deployment_receipt_job) with its own backstop
// (gunbc_ci_rlm_launch_deployment_receipt_job_backstop_timeout_minutes), so it does not move this
// figure either. The runner_host_file_observe and runner_host_file_converge modes DO add steps to
// this job -- one gated run step each plus one shared receipt upload -- and still do not move the
// bound: a dispatch of either runs one step at gunbc_ci_runner_host_file_step_timeout_minutes and one
// transfer-tier upload, which is below the spark_grants branch that sets the worst case.
type JobTimeoutBudget
  = JobTimeoutWithinCeiling { minutes: Int }
  | JobTimeoutExceedsCeiling { minutes: Int, ceiling: Int }

// Consumes extdeps.github.actions max_job_timeout_minutes by construction (operator review,
// bright-ferret-335, gunbc#8782): a computed backstop that would exceed GitHub Actions' platform
// ceiling must refuse rather than emit a timeout-minutes value the platform will reject or silently
// clamp — clamping is the fabricated-plausible-output failure one layer up, since the job would
// then die at the clamped cap while the model believed it had the computed value. This is a wall on
// any future per-tier raise, not evidence the current backstop is at risk: see
// gunbc_ci_fleet_job_backstop_timeout_note for why the honest worst-case-single-run total sits well
// under the ceiling today.
fn checked_job_timeout_minutes(computed: Int) -> JobTimeoutBudget {
  if computed <= max_job_timeout_minutes {
    JobTimeoutWithinCeiling { minutes: computed }
  } else {
    JobTimeoutExceedsCeiling { minutes: computed, ceiling: max_job_timeout_minutes }
  }
}

// The deploy job's own backstop, derived the same way and kept SEPARATE from the converge job's.
// The two are different jobs with different step lists, so one number cannot answer for both, and
// folding the deploy into the converge backstop would inflate a bound that already documents itself
// as a hand-authored cardinal count over one specific step list.
//
// Composition, from fleet_converge_dashboard_deploy_job(): the consumer prelude (allowance), the
// release-bins download (transfer tier), the unpack-and-verify (aux tier), and the deploy itself
// (live-deploy tier). Every step in that job runs on every dispatch of it -- there is no mode gating
// WITHIN the job, because the mode gate is the job's own if_condition -- so unlike the converge
// job's bound this really is a straight sum rather than a worst-case-branch selection.
fn gunbc_ci_dashboard_deploy_job_backstop_timeout_minutes() -> Int {
  gunbc_ci_prelude_allowance_minutes
    + gunbc_ci_artifact_transfer_step_timeout_minutes
    + gunbc_ci_aux_step_timeout_minutes
    + gunbc_ci_live_deploy_step_timeout_minutes
}

fn gunbc_ci_fleet_job_backstop_timeout_minutes() -> Int {
  gunbc_ci_prelude_allowance_minutes
    + ((gunbc_ci_fleet_job_always_run_aux_step_count + gunbc_ci_fleet_job_worst_case_mode_aux_step_count) * gunbc_ci_aux_step_timeout_minutes)
    + (gunbc_ci_fleet_converge_plan_step_timeout_minutes - gunbc_ci_aux_step_timeout_minutes)
    + (gunbc_ci_fleet_job_always_run_artifact_transfer_step_count * gunbc_ci_artifact_transfer_step_timeout_minutes)
    + (gunbc_ci_fleet_job_worst_case_mode_spark_step_count * gunbc_ci_spark_serving_step_timeout_minutes)
}


// ── THE RELEASE-BINS HANDOFF, JUDGED BY WHAT THE STEPS DO ─────────────────────────────────────
//
// A consumer that admits "this job of this workflow was handed the build job's executable" needs
// the WORKFLOW MODEL to establish that handoff, and a witness over it must discriminate behaviour,
// not display names: a step called "Download release-bins artifact" that runs `true` delivers
// nothing, and a download that names the right artifact but adds `run-id:` or `repository:`
// fetches it from a different run (gunbc#11693 review, twice). So the premise below binds each
// transfer step to its CANONICAL CONSTRUCTOR on every field that bears behaviour -- the cited
// action, the whole `with:` list (so an added selector is a difference, not an ignored extra), the
// run body, shell, working directory, env, `if:` and `continue-on-error:` -- excluding only the
// cosmetic name, id and timeout. There is no second list of expected strings: the canonical
// constructors ARE the expectation, and a change to the handoff changes both sides at once.
//
// THE CHAIN, link by link. In the producer: the pack step writes the archive
// (ci_release_bins_pack_step, `$ROOT/<archive>`), then the upload step ships exactly that path as
// the artifact (ci_release_bins_upload_step `with: path`), in that order. In the consumer, which
// must `need` the producer: the download step fetches the artifact from THIS run into the
// workspace root (ci_release_bins_download_step carries no `path:`, `run-id:` or `repository:`;
// any of them is a different `with:` and refuses), then the verify step unpacks `$ROOT/<archive>`
// into the release-bin directory and verifies every declared bin there
// (ci_release_bins_unpack_verify_step; a `working-directory:` moves `$ROOT` resolution and refuses
// as a different step), then the consuming step -- itself bound to its canonical constructor --
// invokes the gunbc at that same release-bin directory: its run text is required to carry the
// invocation path gunbc.cli_invoke release_bin_rel_path renders and the verify script is required
// to extract into release_bin_dir_rel, so the executable the assessment runs is the one just
// verified, by the one authority both spell it from. Order is part of the claim throughout.
type ReleaseBinsDeliveryPremise
  = ReleaseBinsDelivered { producer_job: String, consumer_job: String, consumer_step: String }
  | ReleaseBinsDeliveryRefused { cause: String }

// Scalar YAML equality for `with:` and `env:` entries. A sequence or mapping value is not a scalar
// and two of them never compare equal here, which refuses rather than guesses.
fn yaml_scalar_text(v: YamlValue) -> String? {
  match v {
    YamlString { value: s } => Present { value: concat("s:", s) }
    YamlInt { lexeme: l } => Present { value: concat("i:", l) }
    YamlFloat { lexeme: l } => Present { value: concat("f:", l) }
    YamlBool { value: b } => Present { value: if b { "b:true" } else { "b:false" } }
    YamlNull => Present { value: "null" }
    YamlSequence { elements: _ } => none
    YamlMapping { entries: _ } => none
  }
}

fn kv_equal(a: YamlKeyValue, b: YamlKeyValue) -> Bool {
  a.key == b.key
    && (match yaml_scalar_text(v: a.value) {
      Absent => false
      Present { value: x } =>
        match yaml_scalar_text(v: b.value) {
          Absent => false
          Present { value: y } => x == y
        }
    })
}

type KvZip { index: Int, equal: Bool }

fn kv_lists_equal(a: List<YamlKeyValue>, b: List<YamlKeyValue>) -> Bool {
  list_length(a) == list_length(b)
    && (fold(a, init: KvZip { index: 0, equal: true }, f: (acc, x) =>
      KvZip {
        index: acc.index + 1,
        equal: acc.equal && (match b[acc.index] { Absent => false  Present { value: y } => kv_equal(a: x, b: y) }),
      })).equal
}

fn optional_kv_lists_equal(a: List<YamlKeyValue>?, b: List<YamlKeyValue>?) -> Bool {
  match a {
    Absent => (match b { Absent => true  Present { value: _ } => false })
    Present { value: xs } => (match b { Absent => false  Present { value: ys } => kv_lists_equal(a: xs, b: ys) })
  }
}

fn optional_strings_equal(a: String?, b: String?) -> Bool {
  match a {
    Absent => (match b { Absent => true  Present { value: _ } => false })
    Present { value: x } => (match b { Absent => false  Present { value: y } => x == y })
  }
}

fn optional_bools_equal(a: Bool?, b: Bool?) -> Bool {
  match a {
    Absent => (match b { Absent => true  Present { value: _ } => false })
    Present { value: x } => (match b { Absent => false  Present { value: y } => x == y })
  }
}

fn shell_type_text(s: ShellType) -> String {
  match s { Bash => "bash"  Sh => "sh"  Pwsh => "pwsh"  Python => "python"  Cmd => "cmd" }
}

fn optional_shells_equal(a: ShellType?, b: ShellType?) -> Bool {
  match a {
    Absent => (match b { Absent => true  Present { value: _ } => false })
    Present { value: x } => (match b { Absent => false  Present { value: y } => shell_type_text(s: x) == shell_type_text(s: y) })
  }
}

// A step REALIZES its canonical constructor when every behaviour-bearing field agrees. Name, id
// and timeout are cosmetic and excluded; everything else -- including an `if:` or
// `continue-on-error:` the canonical step does not carry -- is a difference.
fn step_realizes(step: Step, canonical: Step) -> Bool {
  match step {
    RunStep { name: _, id: _, run: r, shell: sh, env: e, working_directory: wd, if_condition: c, continue_on_error: coe, timeout_minutes: _ } =>
      match canonical {
        UsesStep { name: _, id: _, uses: _, with: _, env: _, if_condition: _, continue_on_error: _, timeout_minutes: _ } => false
        RunStep { name: _, id: _, run: r2, shell: sh2, env: e2, working_directory: wd2, if_condition: c2, continue_on_error: coe2, timeout_minutes: _ } =>
          r == r2
            && optional_shells_equal(a: sh, b: sh2)
            && optional_kv_lists_equal(a: e, b: e2)
            && optional_strings_equal(a: wd, b: wd2)
            && optional_strings_equal(a: c, b: c2)
            && optional_bools_equal(a: coe, b: coe2)
      }
    UsesStep { name: _, id: _, uses: u, with: w, env: e, if_condition: c, continue_on_error: coe, timeout_minutes: _ } =>
      match canonical {
        RunStep { name: _, id: _, run: _, shell: _, env: _, working_directory: _, if_condition: _, continue_on_error: _, timeout_minutes: _ } => false
        UsesStep { name: _, id: _, uses: u2, with: w2, env: e2, if_condition: c2, continue_on_error: coe2, timeout_minutes: _ } =>
          action_release_same_producer(a: u, b: u2)
            && optional_kv_lists_equal(a: w, b: w2)
            && optional_kv_lists_equal(a: e, b: e2)
            && optional_strings_equal(a: c, b: c2)
            && optional_bools_equal(a: coe, b: coe2)
      }
  }
}

fn step_run_text(step: Step) -> String? {
  match step {
    RunStep { name: _, id: _, run: r, shell: _, env: _, working_directory: _, if_condition: _, continue_on_error: _, timeout_minutes: _ } => Present { value: r }
    UsesStep { name: _, id: _, uses: _, with: _, env: _, if_condition: _, continue_on_error: _, timeout_minutes: _ } => none
  }
}

// The position of the first step satisfying `pred`, or Absent. Positions are what make order a
// decidable claim rather than a reading of the YAML.
type StepScan { index: Int, found: Int? }

fn first_step_index(steps: List<Step>, pred: fn(Step) -> Bool) -> Int? {
  let scan = fold(steps, init: StepScan { index: 0, found: none }, f: (acc, s) =>
    match acc.found {
      Present { value: _ } => StepScan { index: acc.index + 1, found: acc.found }
      Absent => StepScan { index: acc.index + 1, found: if pred(s) { Present { value: acc.index } } else { none } }
    })
  scan.found
}

// The invocation path the consumer must carry and the extraction directory the verify script
// must use, both rendered from gunbc.cli_invoke so the link is one authority's, not a string
// authored here.
fn release_gunbc_invocation_shell() -> String {
  join(["\"$ROOT/", release_bin_rel_path(bin_name: gunbc_bin_name), "\""], "")
}

fn release_bin_extraction_shell() -> String {
  join(["-C \"$ROOT/", release_bin_dir_rel, "\""], "")
}

fn release_bins_delivery_premise(producer: Job, consumer: Job, consumer_step: Step) -> ReleaseBinsDeliveryPremise {
  if !(consumer.needs |> any(n => n == producer.id)) {
    ReleaseBinsDeliveryRefused { cause: join(["job ", consumer.id, " does not need job ", producer.id, ", so its download would race the upload"], "") }
  } else {
    match first_step_index(steps: producer.steps, pred: s => step_realizes(step: s, canonical: ci_release_bins_pack_step())) {
      Absent => ReleaseBinsDeliveryRefused { cause: join(["job ", producer.id, " has no step realizing ci_release_bins_pack_step, so nothing declares the packed output the upload ships"], "") }
      Present { value: pack_at } =>
        match first_step_index(steps: producer.steps, pred: s => step_realizes(step: s, canonical: ci_release_bins_upload_step())) {
          Absent => ReleaseBinsDeliveryRefused { cause: join(["job ", producer.id, " has no step realizing ci_release_bins_upload_step (cited upload action, artifact ", ci_release_bins_artifact_name, ", path ", ci_release_bins_archive_name, ", unconditional)"], "") }
          Present { value: upload_at } =>
            if !(pack_at < upload_at) {
              ReleaseBinsDeliveryRefused { cause: join(["job ", producer.id, " uploads at position ", to_string(upload_at), " before packing at ", to_string(pack_at)], "") }
            } else {
              match first_step_index(steps: consumer.steps, pred: s => step_realizes(step: s, canonical: ci_release_bins_download_step())) {
                Absent => ReleaseBinsDeliveryRefused { cause: join(["job ", consumer.id, " has no step realizing ci_release_bins_download_step (cited download action, artifact ", ci_release_bins_artifact_name, " from this run, workspace root, unconditional); a download carrying run-id, repository or path is a different step"], "") }
                Present { value: download_at } =>
                  match first_step_index(steps: consumer.steps, pred: s => step_realizes(step: s, canonical: ci_release_bins_unpack_verify_step())) {
                    Absent => ReleaseBinsDeliveryRefused { cause: join(["job ", consumer.id, " has no step realizing ci_release_bins_unpack_verify_step in the workspace root; a verify under another working directory or script is a different step"], "") }
                    Present { value: verify_at } =>
                      match first_step_index(steps: consumer.steps, pred: s => step_realizes(step: s, canonical: consumer_step)) {
                        Absent => ReleaseBinsDeliveryRefused { cause: join(["job ", consumer.id, " has no step realizing the consuming step to deliver to"], "") }
                        Present { value: consumer_at } =>
                          if !(download_at < verify_at && verify_at < consumer_at) {
                            ReleaseBinsDeliveryRefused { cause: join(["job ", consumer.id, " orders download, verify and the consumer as positions ", to_string(download_at), ", ", to_string(verify_at), ", ", to_string(consumer_at), "; the consumer must run after the verified download"], "") }
                          } else if !string_contains(s: ci_release_bins_unpack_verify_script(), pattern: release_bin_extraction_shell()) {
                            ReleaseBinsDeliveryRefused { cause: join(["the release-bins verify script does not extract into ", release_bin_dir_rel, ", the directory the consumer invokes from"], "") }
                          } else {
                            match step_run_text(step: consumer_step) {
                              Absent => ReleaseBinsDeliveryRefused { cause: "the consuming step is not a run step, so what executable it runs cannot be read" }
                              Present { value: run } =>
                                if !string_contains(s: run, pattern: release_gunbc_invocation_shell()) {
                                  ReleaseBinsDeliveryRefused { cause: join(["the consuming step does not invoke ", release_gunbc_invocation_shell(), ", the gunbc the verify step unpacked"], "") }
                                } else {
                                  ReleaseBinsDelivered { producer_job: producer.id, consumer_job: consumer.id, consumer_step: (match step_named_id(step: consumer_step) { Present { value: i } => i  Absent => "(unnamed)" }) }
                                }
                            }
                          }
                      }
                  }
              }
            }
        }
    }
  }
}

fn step_named_id(step: Step) -> String? {
  match step {
    RunStep { name: _, id: i, run: _, shell: _, env: _, working_directory: _, if_condition: _, continue_on_error: _, timeout_minutes: _ } => i
    UsesStep { name: _, id: i, uses: _, with: _, env: _, if_condition: _, continue_on_error: _, timeout_minutes: _ } => i
  }
}
