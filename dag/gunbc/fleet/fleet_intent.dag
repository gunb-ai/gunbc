type IsolationBoundary = SharedHostHome | PerJobFilesystem | ContainerHermetic | Vm

// ContainerRuntime IS GONE. It read
//     type ContainerRuntime = Docker | Podman | Gvisor | Ubicloud | GcloudRun
// and it was three concepts in one enum. Docker and Podman are container ENGINES -- independently
// versioned upstream products. gVisor is a SANDBOX whose whole value is the isolation guarantee it
// adds, and what a tenant is promised about isolation is product.fabric.isolation's IsolationProfile,
// which deliberately names no mechanism. Ubicloud and Google Cloud Run are SUPPLIERS: companies that
// rent a machine, whose homes are extdeps.cloud.ubicloud and product.supplier. So adding an engine
// and adding a supplier both widened one enum -- the case DESIGN's external-decomposition section
// rules out -- and no member of it could be added without an edit here.
//
// The engine half is replaced by extdeps.container.engine's ContainerEngineDeployment: a cited
// product row plus the privilege mode this host actually runs it in. FOUR MEMBERS GET NO REPLACEMENT
// ROW AND THAT IS DELETE-FIRST WORKING, NOT A LOSS: Podman, gVisor, Ubicloud and GcloudRun had zero
// constructors anywhere in the corpus, so nothing refused when they went. Podman becomes one new
// file in extdeps whenever a host runs it; gVisor is a guarantee question, not an engine name; the
// two suppliers already have their own authorities and never belonged in a runtime enum.

type WorkUnitId = NonEmptyStr where brand("WorkUnitId")

type ProviderIdentity = NonEmptyStr where brand("ProviderIdentity")

type MemoryDevice {
  capacity: ByteSize
  memory_kind: MemoryKind
  bandwidth: Bandwidth?
}

type StorageMount {
  mount_path: NonEmptyStr
  device: StorageDevice
  lifecycle: PersistenceKind
}

type ProcessorKind
  = CpuProcessor { cpu: CpuFacts }
  | GpuProcessor { gpu: GpuFacts }
  | AcceleratorProcessor { accelerator: AcceleratorFacts }

type ExecutionSurface {
  os: OperatingSystemSurface
  isolation: IsolationBoundary
  container_engine: ContainerEngineDeployment?
  toolchains: List<ToolchainCapability>
  mounted_storage: List<StorageMount>
  network: List<NetworkInterface>
}

type ComputeHost {
  identity: HostIdentity
  baseboard: ServerBaseboard?
  bmc_intent: BmcControlPlaneIntent?
  processors: List<ProcessorKind>
  memory: List<MemoryDevice>
  storage: List<StorageDevice>
  network_interfaces: List<NetworkInterface>
}

// WHETHER EACH AXIS OF THIS BOARD HAS BEEN READ. A ComputeHost's processor/memory/storage lists are a census only
// when somebody has read the board, and EACH AXIS IS READ OR UNREAD ON ITS OWN: mtcollins1's row carries a processor
// row and an empty memory list, and that empty list is not a measurement of zero DIMMs -- nobody read that board's
// memory, so the RAM read must refuse rather than fold to byte_size(0) (fail_closed; the cardinality/absence domain's
// absent-is-not-zero). The question is asked ONCE per axis, here, and every read derives its refusal from its own
// axis rather than testing emptiness as its own sibling leaf (gunbc.design_argument::root_generalization): a rule
// repeated at each consumer is a rule each future consumer can forget.
//
// WHAT THIS SHAPE CANNOT YET SAY is "the axis WAS read, and it really holds nothing": an empty list reads as Unread
// for every axis. A host whose memory had been surveyed and found absent would need the axis standing DECLARED on
// the row instead of derived from its list. No host in this corpus makes that claim, so the shape is not stretched
// to cover one; it is recorded on gunbc.integration_concern::h11ssl_unit3_empty_census_lists_still_read_as_measured_nothing.
// The census covers the two axes something reads today. The DISK axis joins it WITH its consumer: no fold reads a
// ComputeHost's storage list yet, so a StorageAxis would be a case nothing consumes
// (gunbc.design_argument::consumption) -- the lsblk/sfdisk read this unit's intake rows name brings both the axis and
// the read that answers it. ComputeHost's storage list itself is unchanged.
fn host_hardware_census_of(host: ComputeHost) -> HostHardwareCensus {
  HostHardwareCensus {
    processors: processor_axis(rows: host.processors),
    memory: memory_axis(rows: host.memory),
  }
}

type HostHardwareCensus {
  processors: ProcessorAxis
  memory: MemoryAxis
}

type ProcessorAxis
  = ProcessorsSurveyed { rows: List<ProcessorKind> }
  // NOBODY HAS READ THIS BOARD'S PROCESSORS -- not "the board carries none".
  | ProcessorsUnread

type MemoryAxis
  = MemorySurveyed { rows: List<MemoryDevice> }
  // NOBODY HAS READ THIS BOARD'S MEMORY. mtcollins1 sits here today: its row lists a CPU and no DIMM row, and its
  // nominal DRAM is catalogued elsewhere (the Redfish population its witness reads) without ever being admitted as a
  // memory axis of the supply facts.
  | MemoryUnread


fn processor_axis(rows: List<ProcessorKind>) -> ProcessorAxis {
  match rows.first() {
    Absent => ProcessorsUnread
    Present { value: _ } => ProcessorsSurveyed { rows: rows }
  }
}

fn memory_axis(rows: List<MemoryDevice>) -> MemoryAxis {
  match rows.first() {
    Absent => MemoryUnread
    Present { value: _ } => MemorySurveyed { rows: rows }
  }
}


// THE THREAD FOLD OF A READ PROCESSOR AXIS. The CPU width axis reads the census ONCE and folds threads out of the
// axis it established; leaving the fold private to compute_host_cpu_threads would force the axis to ask the census
// again and re-test emptiness on the way (gunbc.design_argument::root_generalization). Only reached with a read axis,
// so its init: 0 is the start of a real sum, not an answer.
fn processor_rows_thread_total(rows: List<ProcessorKind>) -> HardwareThreadCount {
  hardware_thread_count(count: fold(rows, init: 0, f: (acc, kind) =>
    match kind {
      CpuProcessor { cpu: c } => acc + hardware_thread_count_value(t: cpu_facts_threads(cpu: c))
      GpuProcessor { gpu: _ } => acc
      AcceleratorProcessor { accelerator: _ } => acc
    }
  ))
}

// WHICH CPU THE HOST IS BUILT FROM -- AND WHETHER ANYBODY READ IT. Absent-from-survey and never-surveyed are
// different facts that used to land in the same `none`, which is how a board nobody has read came to be described
// as having no CPU (review 96379). The refusal now states which of the two it is. Consumers that can only carry
// an option still answer none; what changes is that they no longer have to claim a reason they did not read.
type PrimaryCpuStanding
  = PrimaryCpuMeasured { cpu: CpuFacts }
  | PrimaryCpuAbsentFromSurvey { host: HostIdentity }
  | PrimaryCpuCensusUnread { host: HostIdentity }

fn compute_host_primary_cpu(host: ComputeHost) -> PrimaryCpuStanding {
  let census = host_hardware_census_of(host: host)
  match census.processors {
    ProcessorsUnread => PrimaryCpuCensusUnread { host: host.identity }
    ProcessorsSurveyed { rows: rows } =>
      match rows.first() {
        Absent => PrimaryCpuAbsentFromSurvey { host: host.identity }
        Present { value: kind } =>
          match kind {
            CpuProcessor { cpu: c } => PrimaryCpuMeasured { cpu: c }
            GpuProcessor { gpu: _ } => PrimaryCpuAbsentFromSurvey { host: host.identity }
            AcceleratorProcessor { accelerator: _ } => PrimaryCpuAbsentFromSurvey { host: host.identity }
          }
      }
  }
}

// EVERY CPU PROCESSOR THE HOST CARRIES, NOT THE FIRST ONE. A ComputeHost lists one CpuProcessor per
// populated socket, so a two-socket host and a one-socket host of the same part differ here and
// nowhere else; compute_host_primary_cpu answers which part, this answers how many threads. THE PROCESSOR
// AXIS IS ASKED BEFORE THE FOLD: the fold starts at init: 0, so a host whose processors were never read would
// arrive as "a machine of zero threads" -- a measurement the fleet never took.
type CpuThreadRead
  = CpuThreadsMeasured { threads: HardwareThreadCount }
  | CpuThreadsCensusUnread { host: HostIdentity }

fn compute_host_cpu_threads(host: ComputeHost) -> CpuThreadRead {
  let census = host_hardware_census_of(host: host)
  match census.processors {
    ProcessorsUnread => CpuThreadsCensusUnread { host: host.identity }
    ProcessorsSurveyed { rows: rows } =>
      CpuThreadsMeasured { threads: processor_rows_thread_total(rows: rows) }
  }
}

// HOW MUCH RAM THE MEMORY AXIS COUNTS, IF ANYBODY READ IT. Unread is ABSENCE, not zero (the cardinality/absence
// domain), and the memory axis is its OWN question: a host may have a read processor axis and an unread memory axis
// (mtcollins1 is that host today), and this read refuses for it rather than answering byte_size(0) to a placement,
// budget or capacity reader that cannot tell "no DIMM row was ever admitted" from "the board has no memory"
// (review 96379; the controls live in test.claim.fleet.fleet_intent_memory_witness).
type HostRamRead
  = HostRamMeasured { bytes: ByteSize }
  | HostRamCensusUnread { host: HostIdentity }

fn compute_host_ram_bytes_total(host: ComputeHost) -> HostRamRead {
  let census = host_hardware_census_of(host: host)
  match census.memory {
    MemoryUnread => HostRamCensusUnread { host: host.identity }
    MemorySurveyed { rows: rows } =>
      HostRamMeasured {
        bytes: byte_size(
          rows
            |> fold(
              init: 0,
              f: (acc, dev) => acc + byte_size_count(dev.capacity),
            ),
        )
      }
  }
}

fn memory_devices_from_population(pop: HostMemoryPopulation) -> List<MemoryDevice> {
  pop.rows
    |> map(
      row =>
        MemoryDevice {
          capacity: memory_population_row_bytes(row: row),
          memory_kind: Dram,
          bandwidth: none,
        }
    )
}

type MeasurementConfidence
  = SingleSample
  | Range { low: Float, high: Float }
  | DistributionSummary { mean: Float, variance: Float }

type PerformanceReceipt {
  provider: ProviderIdentity
  work_shape: WorkUnitId
  cost: CostAccount<Nano>
  cpu_seconds: Float?
  sample_count: Int
  measurement_context: ExecutionSurface
  confidence: MeasurementConfidence
  cache_state_summary: NonEmptyStr?
}

data host_v1_interpreter_provider: ProviderIdentity = "host:v1-interpreter"

data host_v1_interpreter_execution_surface: ExecutionSurface = ExecutionSurface {
  os: OperatingSystemSurface {
    kernel: Linux,
    distro_or_product: none,
    version: none,
    filesystem_semantics: Posix,
    process_semantics: PosixProcess,
  },
  isolation: SharedHostHome,
  container_engine: none,
  toolchains: [],
  mounted_storage: [],
  network: [],
}

fn performance_receipt_host_single_sample(
  work_shape: WorkUnitId,
  wall_time: Nanosecond,
  space: ByteSize,
) -> PerformanceReceipt {
  PerformanceReceipt {
    provider: host_v1_interpreter_provider,
    work_shape: work_shape,
    cost: cost_account_measured_from_time_and_space(time: wall_time, space: space),
    cpu_seconds: none,
    sample_count: 1,
    measurement_context: host_v1_interpreter_execution_surface,
    confidence: SingleSample,
    cache_state_summary: none,
  }
}

// A TOTAL OVER RECEIPTS IS ONLY AS ESTABLISHED AS ITS WEAKEST TERM, AND THE TOTAL'S BASIS SAYS SO.
// Three cases, each of which was previously answered with a measured number:
//   - one receipt whose axis was never measured makes the sum UNKNOWN, not smaller; adding zero
//     for it reports a total that is confidently wrong and indistinguishable from a faster run;
//   - NO receipts at all is not a measurement of zero, it is the absence of any measurement, so an
//     empty roster yields CostAxisUnestablished rather than a measured zero;
//   - a sum containing a PREDICTED term is not a measurement. review 61676 is right that the first
//     revision of this function decided that case silently by stamping every established total
//     Measured, which is the same class this change exists to close. It is decided here instead of
//     deferred: the total carries the WEAKEST established basis among its terms, because a claim is
//     only as good as the softest fact it rests on. What C5 still owns is the richer
//     Derived / PredictedFromCalibration vocabulary, not this meet.
fn performance_receipts_total_time(receipts: List<PerformanceReceipt>) -> CostTimeAxis<Nano> {
  if receipts.length() == 0 {
    CostTimeUnestablished
  } else {
    fold(
      receipts,
      init: CostTimeMeasured { value: nanosecond(count: 0) },
      f: (acc, receipt) => cost_axis_add_time(acc: acc, term: receipt.cost.time)
    )
  }
}

fn performance_receipts_peak_space(receipts: List<PerformanceReceipt>) -> CostAxis<ByteSize> {
  if receipts.length() == 0 {
    CostAxisUnestablished
  } else {
    fold(
      receipts,
      init: CostAxisMeasured { value: byte_size(count: 0) },
      f: (acc, receipt) => cost_axis_peak_space(acc: acc, term: receipt.cost.space)
    )
  }
}

// The rollup no longer RESTAMPS anything: each axis carries out of the fold with the basis the
// fold derived, so there is no place left where an established-ness claim is minted rather than
// propagated.
fn cost_account_from_performance_receipts(receipts: List<PerformanceReceipt>) -> CostAccount<Nano> {
  CostAccount {
    time: performance_receipts_total_time(receipts: receipts),
    space: performance_receipts_peak_space(receipts: receipts),
    power: CostAxisUnestablished,
  }
}

