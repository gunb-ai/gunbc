module gunbc.altra_firmware_library

import std.types { NonEmptyStr, List, Bool }
import std.measure { ByteSize, byte_size }
import std.optional { Present }
import extdeps.crypto.hash { Digest, sha256_digest }
import extdeps.uri { Uri, uri_https }
import extdeps.firmware.types { FirmwareReleaseRow, BmcController }
import extdeps.bmc.capability { BmcFirmwareObservation }
import gunbc.fleet_bmc_observation { srv3_bmc_firmware_observation, srv4_bmc_firmware_observation }
import extdeps.boards.asrock_rack {
  asrock_altrad8ud_bios_3_10_instant_flash_release,
  asrock_altrad8ud_bmc_3_22_00_release, asrock_altrad8ud_download_authority,
}
import extdeps.boards.asrock_altrad8ud_beta_firmware {
  AsrockAltrad8udBetaFirmwareListing, asrock_altrad8ud_beta_firmware_listings,
  asrock_altrad8ud_beta_disclaimer, AsrockBetaFirmwareVersion,
  SemanticFirmwareVersion, ScpBuildVersion,
}
import extdeps.ampere.altra_ssif_patch {
  AltraSsifPatchBundle, altra_ssif_v6,
}

// Our Drive locations belong to the fleet library, not ASRock's upstream facts.
// All archive byte counts and SHA-256 values were measured from authenticated
// Drive downloads on 2026-10-07. They identify the ZIP, never its flashable member.
// The BIOS ZIP matched the existing vendor-download digest. BMC ZIP contains
// altrad8ud-1l2t_3.22.00.static.mtd.tar; ROM ZIP contains ALTRAD8UD-1L2T_3.10.ROM.
// A Drive /view link is for human retrieval, not an unauthenticated raw download.
type AltraLibraryArchiveSubject
  = FirmwareDistribution { firmware_release: FirmwareReleaseRow }
  | SsifKernelPatchBundle

type AltraLibraryArchive {
  subject: AltraLibraryArchiveSubject
  archive_name: NonEmptyStr
  human_retrieval: Uri
  archive_bytes: ByteSize
  archive_digest: Digest?
}

data altra_firmware_drive_archives: List<AltraLibraryArchive> = [
  AltraLibraryArchive {
    subject: FirmwareDistribution { firmware_release: asrock_altrad8ud_bios_3_10_instant_flash_release },
    archive_name: "ALTRAD8UD-1L2T(3.10)ROM.zip",
    human_retrieval: uri_https(locator: "drive.google.com/file/d/1qnoi3fVvDYoQy3NLfF0dhQIghIWZxC41/view"),
    archive_bytes: asrock_altrad8ud_bios_3_10_instant_flash_release.image_bytes,
    archive_digest: asrock_altrad8ud_bios_3_10_instant_flash_release.image_digest,
  },
  AltraLibraryArchive {
    subject: FirmwareDistribution { firmware_release: asrock_altrad8ud_bmc_3_22_00_release },
    archive_name: "ALTRAD8UD-1L2T(03.22.00)BMC.zip",
    human_retrieval: uri_https(locator: "drive.google.com/file/d/19e4kjCDcDMmkYaEbt1juPsvMCR2l4e4R/view"),
    archive_bytes: byte_size(count: 29060210),
    archive_digest: Present { value: sha256_digest(hex: "0c1f458c396aff76ae0259509ea05c53eef57809fa202721875586792fa807bb") },
  },
  AltraLibraryArchive {
    subject: SsifKernelPatchBundle,
    archive_name: "SSIF_PATCH_V6.zip",
    human_retrieval: uri_https(locator: "drive.google.com/file/d/1TdY8pJ86LwNVktYzrf0oGICwqElcUj5F/view"),
    archive_bytes: byte_size(count: 5697),
    archive_digest: Present { value: sha256_digest(hex: "74ca2343e20b682f419f3240006dfc55ed391978e57c86bdce698e8b72ee0531") },
  },
]

type AltraFirmwareReferenceReport {
  drive_archives: List<AltraLibraryArchive>
  ssif_patch_bundle: AltraSsifPatchBundle
  beta_reference: Uri
  beta_disclaimer: NonEmptyStr
  beta_listings: List<AsrockAltrad8udBetaFirmwareListing>
  bmc_version_comparisons: List<AltraBmcBetaVersionComparison>
  qualification: AltraFixQualification
}

type AltraFixQualification = | AwaitingAffectedBehaviorTest

type AltraBmcBetaVersionComparison {
  observation: BmcFirmwareObservation
  beta_version: AsrockBetaFirmwareVersion
  same_version: Bool
}

// Version equality is only a join of recorded identities, never proof that the
// affected behavior was fixed or that the underlying image bytes are identical.
fn beta_bmc_version_comparisons(
  observations: List<BmcFirmwareObservation>,
) -> List<AltraBmcBetaVersionComparison> {
  flat_map(
    filter(asrock_altrad8ud_beta_firmware_listings, row => row.target == BmcController),
    fn(row) {
      map(observations, fn(observation) {
        AltraBmcBetaVersionComparison {
          observation: observation,
          beta_version: row.version,
          same_version: match row.version {
            SemanticFirmwareVersion { value } => value == observation.firmware.version
            ScpBuildVersion { major: _, minor: _, build_date: _ } => false
          },
        }
      })
    },
  )
}

// Operator discovery entry: gunbc run --source-root dag --source-root src/v2
// --entry dag/gunbc/fleet/altra_firmware_library.dag --function reference_report
// Returns typed references without selecting a release or authorizing a flash.
fn reference_report() -> AltraFirmwareReferenceReport {
  AltraFirmwareReferenceReport {
    drive_archives: altra_firmware_drive_archives,
    ssif_patch_bundle: altra_ssif_v6,
    beta_reference: asrock_altrad8ud_download_authority.uri,
    beta_disclaimer: asrock_altrad8ud_beta_disclaimer,
    beta_listings: asrock_altrad8ud_beta_firmware_listings,
    bmc_version_comparisons: beta_bmc_version_comparisons(
      observations: [srv3_bmc_firmware_observation, srv4_bmc_firmware_observation],
    ),
    qualification: AwaitingAffectedBehaviorTest,
  }
}
