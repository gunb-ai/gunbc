// THE FLASHABLE MEMBER INSIDE EACH FIRMWARE ARCHIVE. An archive digest identifies
// the download; a flash consumes the member, a different byte sequence. Where the
// member is an OpenBMC push tar its MANIFEST version is recorded as read, because it
// need not equal the archive's name: the SCP archive named 2.10.20260210 carries
// obmc-scp-altrad8ud-1l2t-4.01.tar whose MANIFEST reads version=4.01, Type=scp, so a
// BMC reading back that push reports 4.01. Measured 2026-10-08.
type AltraLibraryMemberManifest
  = OpenBmcManifestVersion { version: NonEmptyStr }
  | NoOpenBmcManifest

type AltraLibraryMember {
  archive_name: NonEmptyStr
  member_name: NonEmptyStr
  member_bytes: ByteSize
  member_digest: Digest
  manifest: AltraLibraryMemberManifest
}

