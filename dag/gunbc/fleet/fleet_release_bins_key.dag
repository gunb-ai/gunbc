  RequiredLensContractAxis,
  generation_axes,
}
import extdeps.git { TreeObj }
import extdeps.git.object_store { git_object_type_wire_name }
import gunbc.ci_release_bins { ci_floor_required_artifact_names }
import gunbc.ci_spec { ci_release_build_line, ci_release_bins_archive_name }

// THE RELEASE-BINS PACK IS A CONTENT-ADDRESSED MATERIALIZATION, KEYED BEFORE IT IS BUILT (operator
// ruling 2026-09-27, route B chosen by eager-owl-205: the fleet-converge build job is the keyed
// producer, building only on a miss). Every fleet-converge dispatch rebuilt the sixteen-bin pack --
// 4m23s in run 36253081549 -- although repeated dispatches at one revision (plan, apply, the deploy
// and receipt modes that name expected_revision) ask for the same computation.
//
// NO NEW KEY RELATION IS MINTED HERE. What identifies a compiler build before its artifact exists is
// already owned by v2.compiler.self_host.generation PreMaterializationIdentity: the causal axes,
// with MaterializedArtifactAxis excluded because it is earned from bytes afterwards. The preimage
// below has exactly one line per pre-materialization axis, in generation_axes order, and the line's
// label is the axis. What varies per build is only the VALUE the realization reads (a git tree id,
// rustc -vV), because those facts exist on the runner and nowhere earlier. The address is SHA-256
// over that preimage: std.materialization_provider admits Sha256Family for CrossRunScope and
// refuses the structural fingerprint there, and release_bins_key_family_admission consumes that
// admission rather than restating it.
//
// THE SOURCE CLOSURE IS THE WHOLE COMMITTED TREE, deliberately a superset. The crates read files
// far outside their own directories (include_str! into dag/ and tools/), so a hand list of "the
// crates' inputs" would be complete only until the next include_str!, and an incomplete source axis
// serves a stale binary silently -- the one failure a key exists to rule out. HEAD^\{tree} is
// complete by construction; the price is that the key moves on every commit, so reuse is across
// dispatches at one revision (the brief's case), not across revisions. Narrowing it to the rustc
// dep-info closure is a hit-rate improvement, not a correctness one, and is left unbuilt.
//
// THE BINARY IS STAMPED WITH THE SAME TREE. src/v1/stage0/build.rs embeds a build identity; left
// to itself it embeds the checkout's COMMIT, which would make a reused binary report whichever
// commit first built it. The key step exports GUNBC_MATERIALIZED_TREE_IDENTITY (the build script's
// existing materialized-tree channel, gunbc.build_identity) set to the source-closure value, so the
// embedded identity is a function of the key and reuse cannot misreport provenance.
//
// IDENTITY UP TO BUILD LOCATION, as generation.dag's own note says of every axis set: the runner's
// workspace path is not an axis. A release binary embeds source paths only in panic locations, so a
// pack built under another runner's workspace behaves identically; it is not byte-identical.
//
// THE REQUEST, THE OUTPUT AND THE DISPATCH ARE THREE IDENTITIES, joined only by a receipt. The
// REQUEST identity is the key above. The OUTPUT identity is the SHA-256 of the pack's member manifest
// (one sha256 per member of gunbc.ci_release_bins ci_floor_required_artifact_names, in roster order),
// fixed by the producer after its own build verified. The DISPATCH identity is the run and attempt
// that consumed it. A reuse prints ReleaseBinsReuseReceipt joining all three plus the producing cache
// entry; it never prints a build receipt, because nothing was built.
//
// A STATED DEPARTURE FROM std.materialization_provider (DESIGN section 3b, keys row). The contract's
// NativeCompilerArtifactRequest carries the same axes as in-model Hash digests, and the model cannot
// evaluate those here: the axis VALUES exist only on the runner, before any gunbc binary exists to
// fold them (the hit path must not need one). So the realization reads each axis value and addresses
// the preimage with the family the contract admits for CrossRunScope. What is persisted is the
// executable pack and its manifest; build diagnostics are not persisted, so this is not yet a
// provider_serve-complete artifact of that family, and joining it to that request family is the
// trigger that retires this departure.
//
// TRUST, stated at the grain it holds. actions/cache is UNSIGNED: whoever can write an entry can put
// any bytes under any key. The ADMITTED PRODUCER is therefore defined by who can write, not by what
// the payload says: an entry is admitted only when GitHub's own cache API reports it under
// refs/heads/main or under the ref this dispatch itself runs on. Only workflows executing on a ref
// can write that ref's scope, and whoever can push the dispatch's own ref can already rewrite this
// workflow on it, so admitting that ref adds no principal the run did not already trust; any other
// ref's entry is not admitted. Before ANY restored binary executes, the job (1) recomputes the
// preimage independently and requires the stored one to equal it byte for byte, (2) requires the
// stored manifest to name exactly the derived roster in order, and (3) checks every member's sha256
// against that manifest in an isolated staging directory. Only then are members copied into
// target/release. The restored claim_executor never vouches for itself.
//
// THE LOOKUP IS NOT THE TRANSPORT. The lookup is GitHub's cache API filtered to EXACT key equality
// under an admitted ref; actions/cache can restore a PREFIX match even with no restore-keys, so its
// restore is only the transport, into staging, and the outcome is release_bins_decide over the two
// observations (see ReleaseBinsOutcome). A lookup that fails or answers incompletely refuses as
// LookupTransportFailed or LookupAnswerUnusable; it is never absence. A dispatch on a branch
// publishes into that branch's scope, which main never reads.
// Publication is actions/cache's post step, which saves only when the probe was not an exact hit and
// the job succeeded. Concurrent producers of one key are FIRST-WRITER-WINS by the cache service's
// reservation: the second save is refused by the service and logged, never overwrites. A requested save
// is NOT persistence: this job never claims it; the next dispatch's lookup is the only evidence.
//
// RETENTION AND CAPACITY. GitHub evicts an entry not accessed for 7 days, and evicts
// least-recently-used entries once the repository exceeds its cache quota (10 GB by default), which the
// Cache Cargo target/ entries share. Eviction is established absence: a rebuild, announced by name.
data release_bins_key_prefix: String = "release-bins-"
data release_bins_preimage_name: String = "release-bins.preimage"
data release_bins_manifest_name: String = "release-bins.manifest"
data release_bins_staging_dir: String = ".release-bins-staging"
data release_bins_key_kind: String = "gunbc.fleet_release_bins"
data release_bins_admitted_producer_ref: String = "refs/heads/main"

// Step ids bound once, consumed by the steps that carry them AND by every expression that reads
// them (gunbc.fleet_workflow_steps records why a hand-spelled steps.<id> is a silent-false class).
data release_bins_key_step_id: String = "release_bins_key"
data release_bins_lookup_step_id: String = "release_bins_lookup"
data release_bins_cache_step_id: String = "release_bins_cache"
data release_bins_outcome_step_id: String = "release_bins_outcome"
data release_bins_key_job_output: String = "release_bins_key"

fn release_bins_key_expression() -> String {
  join(["$", "{{ steps.", release_bins_key_step_id, ".outputs.key }}"], "")
}

fn release_bins_consumer_key_expression() -> String {
  join(["$", "{{ needs.build.outputs.", release_bins_key_job_output, " }}"], "")
}

fn release_bins_lookup_standing_expression() -> String {
  join(["$", "{{ steps.", release_bins_lookup_step_id, ".outputs.standing }}"], "")
}

fn release_bins_lookup_entry_expression() -> String {
  join(["$", "{{ steps.", release_bins_lookup_step_id, ".outputs.entry }}"], "")
}

fn release_bins_cache_hit_expression() -> String {
  join(["$", "{{ steps.", release_bins_cache_step_id, ".outputs.cache-hit }}"], "")
}

fn release_bins_build_condition() -> String {
  join(["steps.", release_bins_outcome_step_id, ".outputs.outcome != '", release_bins_reuse_wire, "'"], "")
}

fn release_bins_key_family_admission() -> HashFamilyScopeAdmission {
  admit_hash_family_for_scope(family: Sha256Family, scope: CrossRunScope)
}

fn release_bins_key_family_admitted() -> Bool {
  match release_bins_key_family_admission() {
    HashFamilyAdmittedForScope { family: _, scope: _ } => true
    StructuralFingerprintRefusedAsStoreKey { family: _, scope: _ } => false
    FamilyNotAdmittedForRelation { family: _, scope: _ } => false
  }
}

// ── THE RUNNERS ARE BASH NODE TREES RENDERED BY v2.workflow.bash_emit ────────────────────────────
// Every reader (git, rustc, cc, ld, ldd, sha256sum, curl, tar) is a bash_build command node and the
// scripts are emitted through the grammar fold when the workflow YAML is generated, so no shell text
// is authored here and nothing runs gunbc at dispatch time. Two conventions keep the fold's spellings
// safe: a command substitution is always ASSIGNED to a variable first and read back as "$var"
// (the fold renders a substitution argument unquoted), and the fold has no append redirect, so an
// output line reaches $GITHUB_OUTPUT / $GITHUB_ENV through `tee -a` with stdout sent to /dev/null (the
// serializer has no stdout-null redirect row either). The no-op command is `: no-op` (a one-word statement has no production; a literal
// word `true` also reaches the grammar as a Bool atom).

fn lit(t: String) -> Node { bash_build_word_lit(text: t) }
fn var(n: String) -> Node { bash_build_word_var(name: n) }
fn words(ws: List<Node>) -> Node { bash_build_word_concat_from_nodes(parts: ws) }
fn cmd(ws: List<Node>) -> Node { bash_build_command_with_words(words: ws) }
fn cmdl(ls: List<String>) -> Node { bash_build_command_from_lits(lits: ls) }
fn assign_sub(name: String, body: Node) -> Node {
  bash_build_assign(name: name, value: bash_build_word_cmdsubst(body: body))
}
fn test_words(ws: List<Node>) -> Node { bash_build_test_bracket(words: ws) }
fn staged(file: String) -> Node { words(ws: [var(n: "STAGE"), lit(t: join(["/", file], ""))]) }
fn rooted(file: String) -> Node { words(ws: [var(n: "ROOT"), lit(t: join(["/", file], ""))]) }
fn temp(file: String) -> Node { words(ws: [var(n: "RUNNER_TEMP"), lit(t: join(["/", file], ""))]) }

fn append_line(file_var: String, line: Node) -> Node {
  bash_build_with_redir_to_file(
    inner: bash_build_pipe(
      left: cmd(ws: [lit(t: "echo"), line]),
      right: cmd(ws: [lit(t: "tee"), lit(t: "-a"), var(n: file_var)]),
    ),
    path: lit(t: "/dev/null"),
  )
}

fn release_bins_roster_text() -> String {
  join(ci_floor_required_artifact_names(), " ")
}

fn release_bins_roster_lines() -> String {
  fold(ci_floor_required_artifact_names(), init: "", f: (acc, name) => join([acc, name, "\n"], ""))
}

// EVERY WAY THE MATERIALIZATION REFUSES, as one closed type: a refusal the job prints is one of these
// variants by name, so a new refusal is a new row the match must answer, never a free string.
type ReleaseBinsRefusal
  = AddressFamilyNotAdmitted
  | SourceTreeDirty
  | AxisValueUnread { variable: String }
  | LookupTransportFailed
  | LookupAnswerUnusable
  | OutcomeInputsMissing
  | StoreTransportDisagreeAbsentHit
  | StoreTransportDisagreePresentMiss
  | StoredEntryIncomplete { file: String }
  | StoredPreimageDiffers
  | StoredPreimageKeyMismatch
  | StoredManifestRosterMismatch
  | StoredPackMembersNotRoster
  | StoredMemberDigestMismatch
  | ConsumerKeyMissing
  | ConsumerFileMissing { file: String }
  | ConsumerPreimageKeyMismatch
  | ConsumerSourceTreeMismatch
  | ConsumerManifestRosterMismatch
  | ConsumerMemberDigestMismatch

fn release_bins_refusal_name(refusal: ReleaseBinsRefusal) -> String {
  match refusal {
    AddressFamilyNotAdmitted => "AddressFamilyNotAdmitted"
    SourceTreeDirty => "SourceTreeDirty"
    AxisValueUnread { variable: _ } => "AxisValueUnread"
    LookupTransportFailed => "LookupTransportFailed"
    LookupAnswerUnusable => "LookupAnswerUnusable"
    OutcomeInputsMissing => "OutcomeInputsMissing"
    StoreTransportDisagreeAbsentHit => "StoreTransportDisagreeAbsentHit"
    StoreTransportDisagreePresentMiss => "StoreTransportDisagreePresentMiss"
    StoredEntryIncomplete { file: _ } => "StoredEntryIncomplete"
    StoredPreimageDiffers => "StoredPreimageDiffers"
    StoredPreimageKeyMismatch => "StoredPreimageKeyMismatch"
    StoredManifestRosterMismatch => "StoredManifestRosterMismatch"
    StoredPackMembersNotRoster => "StoredPackMembersNotRoster"
    StoredMemberDigestMismatch => "StoredMemberDigestMismatch"
    ConsumerKeyMissing => "ConsumerKeyMissing"
    ConsumerFileMissing { file: _ } => "ConsumerFileMissing"
    ConsumerPreimageKeyMismatch => "ConsumerPreimageKeyMismatch"
    ConsumerSourceTreeMismatch => "ConsumerSourceTreeMismatch"
    ConsumerManifestRosterMismatch => "ConsumerManifestRosterMismatch"
    ConsumerMemberDigestMismatch => "ConsumerMemberDigestMismatch"
  }
}

fn release_bins_refusal_message(refusal: ReleaseBinsRefusal) -> String {
  match refusal {
    AddressFamilyNotAdmitted => "std.materialization_provider no longer admits sha256 at CrossRunScope; the release-bins address has no admitted family"
    AxisValueUnread { variable: v } => join(["the key input ", v, " read back empty, so the key would not name the build; refusing to key"], "")
    SourceTreeDirty => "tracked files differ from HEAD, so HEAD^\{tree} does not name the build input; refusing to key"
    LookupTransportFailed => "the cache API lookup FAILED (unreachable or refused); this is not absence, so neither reuse nor rebuild is decided"
    LookupAnswerUnusable => "the cache API answer was unreadable or incomplete; it is not treated as absence"
    OutcomeInputsMissing => "the lookup standing or the transport exactness is missing, so no outcome can be decided"
    StoreTransportDisagreeAbsentHit => "the cache API holds no exact admitted entry for this key but the transport reported an exact hit; the store and its transport disagree"
    StoreTransportDisagreePresentMiss => "the cache API holds an exact admitted entry for this key but the transport did not restore it exactly; refusing rather than rebuilding over a present entry"
    StoredEntryIncomplete { file: f } => join(["the stored entry is incomplete: ", f, " is missing"], "")
    StoredPreimageDiffers => "the stored preimage differs from this run's independently derived preimage"
    StoredPreimageKeyMismatch => "the stored preimage does not hash to the probed key"
    StoredManifestRosterMismatch => "the stored manifest does not name exactly the gunbc.ci_release_bins roster in order"
    StoredPackMembersNotRoster => "the stored pack's members are not exactly the roster"
    StoredMemberDigestMismatch => "a stored member's sha256 differs from the manifest; refusing before any restored binary runs"
    ConsumerKeyMissing => "the build job published no release-bins key"
    ConsumerFileMissing { file: f } => join(["the release-bins artifact is missing ", f], "")
    ConsumerPreimageKeyMismatch => "the downloaded preimage does not hash to the build job's key"
    ConsumerSourceTreeMismatch => "the pack was keyed on a different source tree than this job's checkout"
    ConsumerManifestRosterMismatch => "the downloaded manifest does not name exactly the gunbc.ci_release_bins roster"
    ConsumerMemberDigestMismatch => "a downloaded member's sha256 differs from the manifest"
  }
}

// A refusal is a subshell that prints the typed annotation and exits 1; under set -e the failed
// subshell stops the step, including when it is the right side of `||`.
fn refuse(r: ReleaseBinsRefusal) -> Node {
  bash_build_subshell_from_stmts(stmts: [
    cmd(ws: [lit(t: "echo"), lit(t: join(["::error title=release-bins ", release_bins_refusal_name(refusal: r), "::", release_bins_refusal_message(refusal: r)], ""))]),
    bash_build_exit(code: "1"),
  ])
}

fn or_refuse(check: Node, r: ReleaseBinsRefusal) -> Node {
  bash_build_or_else(left: check, right: refuse(r: r))
}

// THE OUTCOME PARTITION AS A TYPE. The lookup's standing and the transport's exactness are two closed
// observations; release_bins_decide is total over their product, and the job's decision chain is
// RENDERED from it (release_bins_outcome_chain), so an unhandled combination is a match the compiler
// refuses rather than a missing shell arm.
type ReleaseBinsLookupStanding = LookupEntryPresent | LookupEntryAbsent
type ReleaseBinsTransportExactness = TransportExactHit | TransportNotExact

type ReleaseBinsOutcome
  = ReuseAfterVerification
  | BuildAfterEstablishedAbsence
  | RefuseOutcome { refusal: ReleaseBinsRefusal }

fn release_bins_decide(
  standing: ReleaseBinsLookupStanding,
  transport: ReleaseBinsTransportExactness,
) -> ReleaseBinsOutcome {
  match standing {
    LookupEntryPresent => match transport {
      TransportExactHit => ReuseAfterVerification
      TransportNotExact => RefuseOutcome { refusal: StoreTransportDisagreePresentMiss }
    }
    LookupEntryAbsent => match transport {
      TransportExactHit => RefuseOutcome { refusal: StoreTransportDisagreeAbsentHit }
      TransportNotExact => BuildAfterEstablishedAbsence
    }
  }
}

fn release_bins_standing_wire(standing: ReleaseBinsLookupStanding) -> String {
  match standing {
    LookupEntryPresent => "present"
    LookupEntryAbsent => "absent"
  }
}

data release_bins_standings: List<ReleaseBinsLookupStanding> = [LookupEntryPresent, LookupEntryAbsent]
data release_bins_transports: List<ReleaseBinsTransportExactness> = [TransportExactHit, TransportNotExact]

data release_bins_reuse_wire: String = "reuse"
data release_bins_build_wire: String = "build"

// actions/cache reports cache-hit 'true' only for an exact key match; anything else (false, empty, a
// prefix restore) is not exact.
fn release_bins_transport_test(transport: ReleaseBinsTransportExactness) -> Node {
  match transport {
    TransportExactHit => test_words(ws: [var(n: "CACHE_HIT"), lit(t: "="), lit(t: "true")])
    TransportNotExact => test_words(ws: [var(n: "CACHE_HIT"), lit(t: "!="), lit(t: "true")])
  }
}

fn release_bins_outcome_arm(outcome: ReleaseBinsOutcome) -> Node {
  match outcome {
    ReuseAfterVerification => bash_build_stmt_list_from_nodes(stmts: [cmdl(ls: [":", "no-op"])])
    BuildAfterEstablishedAbsence => bash_build_stmt_list_from_nodes(stmts: [
      cmd(ws: [lit(t: "rm"), lit(t: "-rf"), var(n: "STAGE")]),
      cmd(ws: [lit(t: "mkdir"), lit(t: "-p"), var(n: "STAGE")]),
      append_line(file_var: "GITHUB_OUTPUT", line: lit(t: join(["outcome=", release_bins_build_wire], ""))),
      bash_build_exit(code: "0"),
    ])
    RefuseOutcome { refusal: r } => bash_build_stmt_list_from_nodes(stmts: [refuse(r: r)])
  }
}

fn release_bins_outcome_cell_test(c: ReleaseBinsDecisionCell) -> Node {
  bash_build_and_then(
    left: test_words(ws: [var(n: "LOOKUP_STANDING"), lit(t: "="), lit(t: release_bins_standing_wire(standing: c.standing))]),
    right: release_bins_transport_test(transport: c.transport),
  )
}

type ReleaseBinsDecisionCell {
  standing: ReleaseBinsLookupStanding
  transport: ReleaseBinsTransportExactness
}

fn release_bins_decision_cells() -> List<ReleaseBinsDecisionCell> {
  fold(release_bins_standings, init: [], f: (acc, st) => fold(release_bins_transports, init: acc, f: (acc2, tr) =>
    concat(acc2, [ReleaseBinsDecisionCell { standing: st, transport: tr }])))
}

// The chain is built innermost-first: folding over the cells in REVERSE wraps each earlier cell
// around the later ones, so the first cell is the outermost test and the final else refuses.
fn release_bins_outcome_chain() -> Node {
  fold(
    fold(release_bins_decision_cells(), init: [], f: (acc, c) => concat([c], acc)),
    init: refuse(r: OutcomeInputsMissing),
    f: (inner, c) => bash_build_if_else(
      cond: release_bins_outcome_cell_test(c: c),
      then_body: release_bins_outcome_arm(outcome: release_bins_decide(standing: c.standing, transport: c.transport)),
      else_body: bash_build_stmt_list_from_nodes(stmts: [inner]),
    ),
  )
}

// THE RECEIPTS AS TYPES. Request, output and dispatch are three identities; a receipt kind names what
// it joins and asserts, and the line is rendered from it, so a reuse can only ever print built=no.
type ReleaseBinsReceiptKind = ReleaseBinsReuseReceipt | ReleaseBinsBuildReceipt

fn release_bins_receipt_name(kind: ReleaseBinsReceiptKind) -> String {
  match kind {
    ReleaseBinsReuseReceipt => "ReleaseBinsReuseReceipt"
    ReleaseBinsBuildReceipt => "ReleaseBinsBuildReceipt"
  }
}

fn release_bins_receipt_tail(kind: ReleaseBinsReceiptKind) -> List<Node> {
  match kind {
    ReleaseBinsReuseReceipt => [lit(t: " producer=["), var(n: "LOOKUP_ENTRY"), lit(t: "] built=no")]
    ReleaseBinsBuildReceipt => [lit(t: " built=yes publish=requested-not-yet-persisted scope="), var(n: "GITHUB_REF")]
  }
}

fn release_bins_receipt_statements(kind: ReleaseBinsReceiptKind) -> List<Node> {
  concat(digest_of(name: "OUTPUT_DIGEST", path: staged(file: release_bins_manifest_name)), [
    cmd(ws: [lit(t: "echo"), words(ws: concat([
      lit(t: join([release_bins_receipt_name(kind: kind), ": request="], "")), var(n: "RELEASE_BINS_KEY"),
      lit(t: " output=sha256:"), var(n: "OUTPUT_DIGEST"),
      lit(t: " dispatch="), var(n: "GITHUB_RUN_ID"), lit(t: "/"), var(n: "GITHUB_RUN_ATTEMPT"),
    ], release_bins_receipt_tail(kind: kind)))]),
  ])
}

fn root_statement() -> Node {
  assign_sub(name: "ROOT", body: cmdl(ls: ["git", "rev-parse", "--show-toplevel"]))
}

fn stage_statement() -> Node {
  bash_build_assign(name: "STAGE", value: rooted(file: release_bins_staging_dir))
}

// The source closure: the committed tree, qualified by the repository's object format.
fn source_closure_statements() -> List<Node> {
  [
    assign_sub(name: "OBJECT_FORMAT", body: cmd(ws: [lit(t: "git"), lit(t: "-C"), var(n: "ROOT"), lit(t: "rev-parse"), lit(t: "--show-object-format")])),
    assign_sub(name: "SOURCE_TREE", body: cmd(ws: [lit(t: "git"), lit(t: "-C"), var(n: "ROOT"), lit(t: "rev-parse"), lit(t: "HEAD^\{tree}")])),
    read_nonempty(variable: "OBJECT_FORMAT"),
    read_nonempty(variable: "SOURCE_TREE"),
    bash_build_assign(name: "SOURCE_CLOSURE", value: words(ws: [
      lit(t: join([git_object_type_wire_name(object_type: TreeObj), ":"], "")), var(n: "OBJECT_FORMAT"), lit(t: ":"), var(n: "SOURCE_TREE"),
    ])),
  ]
}

// C7 [producer-status-pipeline] IS CLOSED HERE BY CONSTRUCTION, not recorded: no producer runs in a
// pipeline (see seq / produce_to below), so a failing producer stops the step under set -e even if it
// printed part of its output. The only pipeline left is append_line's `echo | tee -a`, whose producer
// is the shell builtin echo writing a model-rendered line and whose last stage (tee) set -e does check.
// An axis that reads back empty still refuses by name, because a producer can succeed and print nothing.
fn read_nonempty(variable: String) -> Node {
  or_refuse(check: test_words(ws: [lit(t: "-n"), var(n: variable)]), r: AxisValueUnread { variable: variable })
}

// NO PRODUCER RUNS INSIDE A PIPELINE. The fold emits `set -e` without pipefail, so a producer's
// status is only observed when the producer is its own statement: each one writes its output to a
// file under RUNNER_TEMP (the statement set -e checks), and a second command reads that file as an
// argument. A producer that fails, even after printing part of its output, stops the step.
fn seq(parts: List<List<Node>>) -> List<Node> {
  fold(parts, init: [], f: (acc, p) => concat(acc, p))
}

fn produce_to(file: String, command: Node) -> Node {
  bash_build_with_redir_to_file(inner: command, path: temp(file: file))
}

fn read_back(name: String, file: String, reader: List<String>) -> Node {
  assign_sub(name: name, body: cmd(ws: concat(map(reader, r => lit(t: r)), [temp(file: file)])))
}

fn first_line_of(name: String, argv: List<String>) -> List<Node> {
  [
    produce_to(file: join([name, ".out"], ""), command: cmdl(ls: argv)),
    read_back(name: name, file: join([name, ".out"], ""), reader: ["head", "-n", "1"]),
  ]
}

// One preimage line per pre-materialization axis, in generation_axes order. An axis that is not an
// input of a seed cargo build says so in its own line rather than being dropped.
fn axis_reads(axis: GenerationAxis) -> List<Node> {
  match axis {
    SourceClosureAxis => []
    ToolchainAxis => [
      produce_to(file: "rustc-vV.out", command: cmdl(ls: ["rustc", "-vV"])),
      read_back(name: "AXIS_TOOLCHAIN", file: "rustc-vV.out", reader: ["paste", "-s", "-d", ";"]),
      read_nonempty(variable: "AXIS_TOOLCHAIN"),
    ]
    ProducerCompilerAxis => [
      assign_sub(name: "AXIS_PRODUCER", body: cmd(ws: [var(n: "CARGO_BIN"), lit(t: "-V")])),
      read_nonempty(variable: "AXIS_PRODUCER"),
    ]
    TargetModelAxis => seq(parts: [[
      produce_to(file: "rustc-host.out", command: cmdl(ls: ["rustc", "-vV"])),
      read_back(name: "AXIS_HOST", file: "rustc-host.out", reader: ["sed", "-n", "s/^host: //p"]),
    ], seq(parts: [
      first_line_of(name: "AXIS_CC", argv: ["cc", "--version"]),
      first_line_of(name: "AXIS_LD", argv: ["ld", "--version"]),
      first_line_of(name: "AXIS_LIBC", argv: ["ldd", "--version"]),
    ]), [
      read_nonempty(variable: "AXIS_HOST"),
      read_nonempty(variable: "AXIS_CC"),
      read_nonempty(variable: "AXIS_LD"),
      read_nonempty(variable: "AXIS_LIBC"),
    ]])
    BuildConfigurationAxis => []
    RequiredLensContractAxis => []
    MaterializedArtifactAxis => []
  }
}

fn axis_line(axis: GenerationAxis) -> List<Node> {
  match axis {
    SourceClosureAxis => [cmd(ws: [lit(t: "printf"), lit(t: "source_closure=%s\\n"), var(n: "SOURCE_CLOSURE")])]
    ToolchainAxis => [cmd(ws: [lit(t: "printf"), lit(t: "toolchain=%s\\n"), var(n: "AXIS_TOOLCHAIN")])]
    ProducerCompilerAxis => [cmd(ws: [lit(t: "printf"), lit(t: "producer_compiler=%s\\n"), var(n: "AXIS_PRODUCER")])]
    TargetModelAxis => [cmd(ws: [lit(t: "printf"), lit(t: "target_model=%s;cc=%s;ld=%s;libc=%s\\n"), var(n: "AXIS_HOST"), var(n: "AXIS_CC"), var(n: "AXIS_LD"), var(n: "AXIS_LIBC")])]
    BuildConfigurationAxis => [cmd(ws: [
      lit(t: "printf"),
      lit(t: "build_configuration=%s;embedded_build_identity=%s;RUSTFLAGS=%s;CARGO_ENCODED_RUSTFLAGS=%s;CC=%s;CFLAGS=%s;LDFLAGS=%s;roster=%s\\n"),
      lit(t: ci_release_build_line()), var(n: "SOURCE_CLOSURE"),
      var(n: "RUSTFLAGS"), var(n: "CARGO_ENCODED_RUSTFLAGS"), var(n: "CC"), var(n: "CFLAGS"), var(n: "LDFLAGS"),
      lit(t: release_bins_roster_text()),
    ])]
    RequiredLensContractAxis => [cmdl(ls: ["printf", "required_lens_contract=none (a seed cargo build admits no lens contract)\\n"])]
    MaterializedArtifactAxis => []
  }
}

fn preimage_statements() -> List<Node> {
  concat(
    fold(generation_axes, init: [], f: (acc, axis) => concat(acc, axis_reads(axis: axis))),
    [bash_build_with_redir_to_file(
      inner: bash_build_subshell_from_stmts(stmts: concat(
        [
          cmdl(ls: ["printf", "kind=%s\\n", release_bins_key_kind]),
          cmdl(ls: ["printf", "address=sha256 scope=cross_run\\n"]),
        ],
        fold(generation_axes, init: [], f: (acc, axis) => concat(acc, axis_line(axis: axis))),
      )),
      path: var(n: "EXPECTED"),
    )],
  )
}

fn digest_of(name: String, path: Node) -> List<Node> {
  [
    produce_to(file: join([name, ".out"], ""), command: cmd(ws: [lit(t: "sha256sum"), path])),
    read_back(name: name, file: join([name, ".out"], ""), reader: ["cut", "-d", " ", "-f", "1"]),
  ]
}

fn key_matches(digest_var: String) -> Node {
  test_words(ws: [words(ws: [lit(t: release_bins_key_prefix), var(n: digest_var)]), lit(t: "="), var(n: "RELEASE_BINS_KEY")])
}

fn roster_file_statement() -> Node {
  bash_build_with_redir_to_file(
    inner: cmdl(ls: ["printf", "%s", release_bins_roster_lines()]),
    path: temp(file: "release-bins.roster"),
  )
}

fn manifest_roster_check(manifest: Node, r: ReleaseBinsRefusal) -> List<Node> {
  [
    produce_to(file: "manifest-names.out", command: cmd(ws: [lit(t: "cut"), lit(t: "-c"), lit(t: "67-"), manifest])),
    or_refuse(check: cmd(ws: [lit(t: "cmp"), lit(t: "-s"), temp(file: "manifest-names.out"), temp(file: "release-bins.roster")]), r: r),
  ]
}

fn member_digest_check(dir: Node, manifest: Node, r: ReleaseBinsRefusal) -> Node {
  or_refuse(
    check: bash_build_subshell_from_stmts(stmts: [bash_build_and_then(
      left: cmd(ws: [lit(t: "cd"), dir]),
      right: cmd(ws: [lit(t: "sha256sum"), lit(t: "--quiet"), lit(t: "-c"), manifest]),
    )]),
    r: r,
  )
}

fn entry_files() -> List<String> {
  [release_bins_preimage_name, release_bins_manifest_name, ci_release_bins_archive_name]
}

// KEY: recompute the preimage into RUNNER_TEMP (outside anything a restore can write), address it,
// bind the embedded build identity, and empty the staging directory.
fn release_bins_key_statements() -> List<Node> {
  if !release_bins_key_family_admitted() {
    [refuse(r: AddressFamilyNotAdmitted)]
  } else {
    concat(
      concat([
        root_statement(),
        assign_sub(name: "DIRTY", body: cmd(ws: [lit(t: "git"), lit(t: "-C"), var(n: "ROOT"), lit(t: "status"), lit(t: "--porcelain"), lit(t: "--untracked-files=no")])),
        or_refuse(check: test_words(ws: [lit(t: "-z"), var(n: "DIRTY")]), r: SourceTreeDirty),
      ], source_closure_statements()),
      concat(
        concat([bash_build_assign(name: "EXPECTED", value: temp(file: join([release_bins_preimage_name, ".expected"], "")))], preimage_statements()),
        concat(digest_of(name: "PREIMAGE_DIGEST", path: var(n: "EXPECTED")), [
          bash_build_assign(name: "KEY", value: words(ws: [lit(t: release_bins_key_prefix), var(n: "PREIMAGE_DIGEST")])),
          cmd(ws: [lit(t: "rm"), lit(t: "-rf"), rooted(file: release_bins_staging_dir)]),
          cmd(ws: [lit(t: "mkdir"), lit(t: "-p"), rooted(file: release_bins_staging_dir)]),
          cmd(ws: [lit(t: "echo"), words(ws: [lit(t: "release-bins request key "), var(n: "KEY"), lit(t: " over preimage:")])]),
          cmd(ws: [lit(t: "cat"), var(n: "EXPECTED")]),
          append_line(file_var: "GITHUB_OUTPUT", line: words(ws: [lit(t: "key="), var(n: "KEY")])),
          append_line(file_var: "GITHUB_ENV", line: words(ws: [lit(t: "GUNBC_MATERIALIZED_TREE_IDENTITY="), var(n: "SOURCE_CLOSURE")])),
        ]),
      ),
    )
  }
}

// LOOKUP: GitHub's cache API is the authority for whether an exact entry exists under an admitted
// producer ref. The JSON is read by a python3 program whose only output is the standing and entry
// lines; every failure to get a complete answer refuses, and only an answered empty set is absence.
fn release_bins_lookup_reader_program() -> String {
  join([
    "import os,sys,json\n",
    "d=json.load(open(sys.argv[1]))\n",
    "k=sys.argv[2]\n",
    "refs=sys.argv[3:]\n",
    "c=d[\"actions_caches\"]\n",
    "assert d[\"total_count\"]==len(c), \"incomplete answer\"\n",
    "m=[e for e in c if e[\"key\"]==k and e[\"ref\"] in refs]\n",
    "o=open(os.environ[\"GITHUB_OUTPUT\"],\"a\")\n",
    "if m:\n",
    "  e=m[0]\n",
    "  o.write(\"standing=", release_bins_standing_wire(standing: LookupEntryPresent), "\\nentry=id=%s ref=%s created=%s size=%s\\n\" % (e[\"id\"], e[\"ref\"], e[\"created_at\"], e[\"size_in_bytes\"]))\n",
    "  print(\"release-bins entry: id=%s ref=%s created=%s size=%s\" % (e[\"id\"], e[\"ref\"], e[\"created_at\"], e[\"size_in_bytes\"]))\n",
    "else:\n",
    "  o.write(\"standing=", release_bins_standing_wire(standing: LookupEntryAbsent), "\\n\")\n",
    "  print(\"::notice title=release-bins::no admitted entry for this key (never published, or evicted); this dispatch builds\")\n",
  ], "")
}

fn release_bins_lookup_statements() -> List<Node> {
  [
    bash_build_assign(name: "BODY", value: temp(file: "release-bins-lookup.json")),
    or_refuse(
      check: cmd(ws: [
        lit(t: "curl"), lit(t: "-sSf"),
        lit(t: "-H"), words(ws: [lit(t: "Authorization: Bearer "), var(n: "GH_TOKEN")]),
        lit(t: "-H"), lit(t: "Accept: application/vnd.github+json"),
        words(ws: [var(n: "GITHUB_API_URL"), lit(t: "/repos/"), var(n: "GITHUB_REPOSITORY"), lit(t: "/actions/caches?per_page=100&key="), var(n: "RELEASE_BINS_KEY")]),
        lit(t: "-o"), var(n: "BODY"),
      ]),
      r: LookupTransportFailed,
    ),
    or_refuse(
      check: cmd(ws: [
        lit(t: "python3"), lit(t: "-c"), lit(t: release_bins_lookup_reader_program()),
        var(n: "BODY"), var(n: "RELEASE_BINS_KEY"), lit(t: release_bins_admitted_producer_ref), var(n: "GITHUB_REF"),
      ]),
      r: LookupAnswerUnusable,
    ),
  ]
}

// OUTCOME: join the lookup's standing with the transport's exactness, verify a reuse candidate
// completely BEFORE any restored byte executes, and publish the outcome.
fn release_bins_outcome_statements() -> List<Node> {
  concat(
    concat(
      [
        root_statement(),
        stage_statement(),
        bash_build_assign(name: "EXPECTED", value: temp(file: join([release_bins_preimage_name, ".expected"], ""))),
        release_bins_outcome_chain(),
      ],
      map(entry_files(), f => or_refuse(check: test_words(ws: [lit(t: "-f"), staged(file: f)]), r: StoredEntryIncomplete { file: f })),
    ),
    concat(
      seq(parts: [[
        bash_build_or_else(
          left: cmd(ws: [lit(t: "cmp"), lit(t: "-s"), var(n: "EXPECTED"), staged(file: release_bins_preimage_name)]),
          right: bash_build_subshell_from_stmts(stmts: [
            bash_build_or_else(left: cmd(ws: [lit(t: "diff"), var(n: "EXPECTED"), staged(file: release_bins_preimage_name)]), right: cmdl(ls: [":", "no-op"])),
            refuse(r: StoredPreimageDiffers),
          ]),
        ),
      ], digest_of(name: "STORED_DIGEST", path: staged(file: release_bins_preimage_name)), [
        or_refuse(check: key_matches(digest_var: "STORED_DIGEST"), r: StoredPreimageKeyMismatch),
        roster_file_statement(),
      ], manifest_roster_check(manifest: staged(file: release_bins_manifest_name), r: StoredManifestRosterMismatch), [
        cmd(ws: [lit(t: "rm"), lit(t: "-rf"), staged(file: "unpacked")]),
        cmd(ws: [lit(t: "mkdir"), lit(t: "-p"), staged(file: "unpacked")]),
        cmd(ws: [lit(t: "tar"), lit(t: "-xzf"), staged(file: ci_release_bins_archive_name), lit(t: "-C"), staged(file: "unpacked")]),
        produce_to(file: "members.out", command: cmd(ws: [lit(t: "ls"), lit(t: "-A"), staged(file: "unpacked")])),
        read_back(name: "MEMBERS", file: "members.out", reader: ["sort"]),
        assign_sub(name: "ROSTER_SORTED", body: cmd(ws: [lit(t: "sort"), temp(file: "release-bins.roster")])),
        or_refuse(check: test_words(ws: [var(n: "MEMBERS"), lit(t: "="), var(n: "ROSTER_SORTED")]), r: StoredPackMembersNotRoster),
        member_digest_check(dir: staged(file: "unpacked"), manifest: staged(file: release_bins_manifest_name), r: StoredMemberDigestMismatch),
        cmd(ws: [lit(t: "mkdir"), lit(t: "-p"), rooted(file: "target/release")]),
        cmd(ws: [lit(t: "cp"), lit(t: "-pR"), staged(file: "unpacked/."), rooted(file: "target/release/")]),
        cmd(ws: [lit(t: "rm"), lit(t: "-rf"), staged(file: "unpacked")]),
      ]]),
      concat(
        release_bins_receipt_statements(kind: ReleaseBinsReuseReceipt),
        [append_line(file_var: "GITHUB_OUTPUT", line: lit(t: join(["outcome=", release_bins_reuse_wire], "")))],
      ),
    ),
  )
}

// PACK (build outcomes only): the manifest is taken from target/release after the build step's own
// verification, the preimage is this run's, and all three land in staging, which is both the upload
// source and the path actions/cache publishes.
fn release_bins_pack_statements() -> List<Node> {
  concat(
    [
      root_statement(),
      stage_statement(),
      cmd(ws: [lit(t: "mkdir"), lit(t: "-p"), var(n: "STAGE")]),
      bash_build_with_redir_to_file(
        inner: bash_build_subshell_from_stmts(stmts: [bash_build_and_then(
          left: cmd(ws: [lit(t: "cd"), rooted(file: "target/release")]),
          right: cmd(ws: concat([lit(t: "sha256sum")], map(ci_floor_required_artifact_names(), n => lit(t: n)))),
        )]),
        path: staged(file: release_bins_manifest_name),
      ),
      cmd(ws: concat(
        [lit(t: "tar"), lit(t: "-czf"), staged(file: ci_release_bins_archive_name), lit(t: "-C"), rooted(file: "target/release")],
        map(ci_floor_required_artifact_names(), n => lit(t: n)),
      )),
      cmd(ws: [lit(t: "cp"), temp(file: join([release_bins_preimage_name, ".expected"], "")), staged(file: release_bins_preimage_name)]),
    ],
    release_bins_receipt_statements(kind: ReleaseBinsBuildReceipt),
  )
}

// CONSUMER: a downstream job holds the key its build job published and refuses, before executing
// anything it downloaded, a pack whose preimage hashes elsewhere, names another source tree, or whose
// members do not match the manifest.
fn release_bins_consumer_statements() -> List<Node> {
  concat(
    concat(
      [
        root_statement(),
        or_refuse(check: test_words(ws: [lit(t: "-n"), var(n: "RELEASE_BINS_KEY")]), r: ConsumerKeyMissing),
      ],
      map(entry_files(), f => or_refuse(check: test_words(ws: [lit(t: "-f"), rooted(file: f)]), r: ConsumerFileMissing { file: f })),
    ),
    concat(
      concat(
        concat(
          digest_of(name: "DOWNLOADED_DIGEST", path: rooted(file: release_bins_preimage_name)),
          [or_refuse(check: key_matches(digest_var: "DOWNLOADED_DIGEST"), r: ConsumerPreimageKeyMismatch)],
        ),
        source_closure_statements(),
      ),
      seq(parts: [[
        or_refuse(
          check: cmd(ws: [lit(t: "grep"), lit(t: "-qxF"), words(ws: [lit(t: "source_closure="), var(n: "SOURCE_CLOSURE")]), rooted(file: release_bins_preimage_name)]),
          r: ConsumerSourceTreeMismatch,
        ),
        roster_file_statement(),
      ], manifest_roster_check(manifest: rooted(file: release_bins_manifest_name), r: ConsumerManifestRosterMismatch), [
        bash_build_assign(name: "CHECK", value: temp(file: "release-bins-check")),
        cmd(ws: [lit(t: "rm"), lit(t: "-rf"), var(n: "CHECK")]),
        cmd(ws: [lit(t: "mkdir"), lit(t: "-p"), var(n: "CHECK")]),
        cmd(ws: [lit(t: "tar"), lit(t: "-xzf"), rooted(file: ci_release_bins_archive_name), lit(t: "-C"), var(n: "CHECK")]),
        member_digest_check(dir: var(n: "CHECK"), manifest: rooted(file: release_bins_manifest_name), r: ConsumerMemberDigestMismatch),
        cmd(ws: [lit(t: "rm"), lit(t: "-rf"), var(n: "CHECK")]),
      ]]),
    ),
  )
}

// THE EMITTED SCRIPTS, and the one admission the workflow generation consumes: if the fold refuses any
// of them, gunbc.fleet_converge_workflow refuses to emit the workflow rather than emitting a step with
// no script.
fn release_bins_emitted(statements: List<Node>) -> Outcome<String> {
  bash_emit_stmts(statements: statements, set_e: true)
}

fn release_bins_script_text(outcome: Outcome<String>) -> String {
  match outcome {
    Accepted { value: v, diagnostics: _ } => v
    Rejected { diagnostics: _ } => ""
  }
}

fn release_bins_script_accepted(outcome: Outcome<String>) -> Bool {
  match outcome {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn release_bins_key_script() -> String { release_bins_script_text(outcome: release_bins_emitted(statements: release_bins_key_statements())) }
fn release_bins_lookup_script() -> String { release_bins_script_text(outcome: release_bins_emitted(statements: release_bins_lookup_statements())) }
fn release_bins_outcome_script() -> String { release_bins_script_text(outcome: release_bins_emitted(statements: release_bins_outcome_statements())) }
fn release_bins_pack_manifest_script() -> String { release_bins_script_text(outcome: release_bins_emitted(statements: release_bins_pack_statements())) }
fn release_bins_consumer_key_check_script() -> String { release_bins_script_text(outcome: release_bins_emitted(statements: release_bins_consumer_statements())) }

fn release_bins_scripts_admitted() -> Bool {
  fold(
    [
      release_bins_script_accepted(outcome: release_bins_emitted(statements: release_bins_key_statements())),
      release_bins_script_accepted(outcome: release_bins_emitted(statements: release_bins_lookup_statements())),
      release_bins_script_accepted(outcome: release_bins_emitted(statements: release_bins_outcome_statements())),
      release_bins_script_accepted(outcome: release_bins_emitted(statements: release_bins_pack_statements())),
      release_bins_script_accepted(outcome: release_bins_emitted(statements: release_bins_consumer_statements())),
    ],
    init: true,
    f: (acc, b) => acc && b,
  )
}
