// ONE CONVERGENCE PASS OVER ONE PRINT REQUEST. Each pass reads the durable records and the printer
// afresh, derives the standing (gunbc.fleet.print_request print_standing) and takes the one action
// that standing permits, then returns. A pass that stops at a wait is re-run, never resumed; an
// ambiguous start stops and is left to a person. Request records share the start claims' directory
// and failure domain: if that host state is lost, a request refuses (its record or claim cannot be
// read), and absence is never reconstructed as permission to start.
// THE STATE ROOTS ARE CONVERGED BEFORE ANY STANDING IS READ, through the one owned-directory provider
// (observe, decide, install elevated, independent re-stat). A refusal stops the pass: a missing or
// foreign directory never reads as an absent record.
// The job principal holds the fleet account's group (idempotent; a membership added here first takes
// effect for the next job's process, so a pass that just added it refuses below on the unreadable root).
fn ensure_printer_state_directories(tree: HostStateTree) -> String? {
  if !run_argv_transport_succeeded(outcome: run_argv_over_host_effect_transport(command: executor_privileged_operation_elevated_command(op: EnsureSupplementaryGroupMembership { login: srv1_runner_host_spec.job_user, group: printer_state_group() }), transport: LocalShell)) { return Present { value: concat("the job user could not be ensured in group ", printer_state_group() as String) } }
  fold(printer_state_directories(tree: tree), init: none, f: (refused, d) => match refused {
    Present { value: r } => Present { value: r }
    Absent => {
      let outcome = live_deploy_apply_ensure_directory_on_host(target: d, transport: LocalShell)
      if owned_directory_outcome_converged(o: outcome) { none } else { Present { value: owned_directory_outcome_detail(o: outcome) } }
    }
  })
}

// THE PREPARING PASS. The root's committed plate plan (artifacts/printing/<root>/plate.json) is the
// placement; the recipe is the machine and process; the request is the physical printer. It needs no
// credential and never contacts the printer.
fn prepare_and_record(tree: HostStateTree, requests: PrintRequestStore, request: PrintRequest, source_revision: NonEmptyStr, run_id: String) -> RecordRead {
  let output = join([print_run_directory(tree: tree) as String, "/", request_record_name(request_id: request.request_id), "-", run_id], "")
  match prepare_request_plate(plate_file: join(["artifacts/printing/", request.root as String, "/plate.json"], ""), output: output, recipe: request.recipe as String, source_revision: source_revision as String, root: request.root as String) {
    RequestPlateRefused { cause: c } => RecordRefused { cause: concat("Preparation refused: ", c) }
    RequestPlatePrepared { artifact: a, path: located } => {
      let record = PrintRequestRecord { request: request, source_revision: source_revision, artifact_sha256: a, artifact_location: located as NonEmptyStr, attempt_id: print_attempt_id(request: request, artifact_sha256: a) }
      print_request_record(store: requests, record: record)
    }
  }
}

// The credential version a start uses is the registry's latest, resolved when the start is selected;
// it is sealed into that attempt's signed subject, which the claim file holds.
fn resolve_credential_version(printer: PhysicalAssetIdentity, token_source: AccessTokenSource) -> NonEmptyStr? {
  match printer_access_code_locus(printer: printer) {
    PrinterAccessCodeLocusUnknown { printer: _ } => none
    PrinterAccessCodeLocusConflict { printer: _, matches: _ } => none
    PrinterAccessCodeDesiredLocusFound { locus: locus } =>
      match fetch_secret_ref_credential(secret_ref: secret_ref_pin_version(ref: locus.secret, version: "latest"), token_source: token_source) {
        SecretCredentialReady { credential: c, resolved_version: version } => if (c as String) == "" { none } else {
          match sm_resolved_version_id(identity: version) { SmVersionIdProjected { version: v } => Present { value: v as NonEmptyStr } SmVersionIdNotAVersionResource { supplied: _ } => none }
        }
        SecretCredentialAccessUpsertRequired { plan: _ } => none
        SecretCredentialWireDecodeRefused { identity_cause: _, payload_cause: _ } => none
        SecretCredentialFetchRefused { reason: _ } => none
        SecretCredentialResolvedVersionMismatch { requested: _, resolved: _ } => none
      }
  }
}

// The recorded file is copied to this pass's working path and re-hashed there; only bytes that hash
// to the recorded digest reach the printer.
fn copy_verified(record: PrintRequestRecord, path: String) -> Bool {
  shell.Copy.File(source: record.artifact_location as FilePath, destination: path as FilePath).success &&
  (match sha256sum_file_digest_via_shell(path: path as NonEmptyStr) {
    Sha256FileDigest { digest: d } => (d.hex as String) == (record.artifact_sha256.hex as String)
    Sha256FileDigestUnavailable { path: _, reason: _ } => false
  })
}

fn session_report(printer: PhysicalAssetIdentity, version: NonEmptyStr, token_source: AccessTokenSource) -> String? {
  match read_existing_printer_session(printer: printer, version: version, token_source: token_source) {
    PrinterSessionRefused { cause: _ } => none
    PrinterSessionReady { session: s } => match report_using_session(session: s) { ProcessOutputPresent { text: t } => Present { value: t } ProcessOutputAbsent => none ProcessRefused { exit_code: _, stderr: _ } => none }
  }
}

// WHICH CODE MAY START A PRINT (operator ruling 2026-10-25, design A). A run at any ref may prepare
// and record a request: that pass needs no printer credential and never contacts the printer. Every
// pass over a RECORDED request reads the printer credential and may file the bed-clear approval and
// start, so it runs only reviewed main's code; off main it refuses here, decided from the run's ref
// before any credential read, observation or start. A branch-designed part prints by a branch run
// recording it and a main run starting the recorded, digest-verified artifact.
type PrintPassRef = ReviewedMainRef | OffReviewedMainRef { ref: String }

fn print_pass_ref(github_ref: String) -> PrintPassRef {
  if github_ref == concat("refs/heads/", gunbc_default_branch_name) { ReviewedMainRef } else { OffReviewedMainRef { ref: github_ref } }
}

type PrintPassRoute
  = PrintPassPrepare
  | PrintPassStartRecorded { record: PrintRequestRecord }
  | PrinterStartRefusedOffReviewedMain { ref: String }
  | PrintPassRecordRefused { cause: String }

fn print_pass_route(pass_ref: PrintPassRef, record: RecordRead) -> PrintPassRoute {
  match record {
    RecordRefused { cause: c } => PrintPassRecordRefused { cause: c }
    RecordAbsent => PrintPassPrepare
    RecordPresent { record: r } => match pass_ref {
      ReviewedMainRef => PrintPassStartRecorded { record: r }
      OffReviewedMainRef { ref: x } => PrinterStartRefusedOffReviewedMain { ref: x }
    }
  }
}

fn print_pass_refusal_text(route: PrintPassRoute) -> String {
  match route {
    PrinterStartRefusedOffReviewedMain { ref: x } => join(["PrinterStartRefusedOffReviewedMain: ", x, " recorded this request; approval and start run only from reviewed main (dispatch the same request at main)"], "")
    PrintPassRecordRefused { cause: c } => c
    PrintPassPrepare => ""
    PrintPassStartRecorded { record: _ } => ""
  }
}

fn converge_print(tree: HostStateTree, request: PrintRequest, pass_ref: PrintPassRef, source_revision: NonEmptyStr, run_id: String, token_source: AccessTokenSource) -> ProcessExit {
  let host = os.Hostname.ReadShort()
  if !host.success || trim(s: host.value) != (printer_lan_host_identity() as String) { return exit_failure(reason: "Print convergence runs on the modeled printer LAN host") }
  match ensure_printer_state_directories(tree: tree) { Present { value: r } => return exit_failure(reason: concat("Printer state directory not converged: ", r)) Absent => {} }
  match printer_state_move(tree: tree) { PrinterStateMoveRefused { cause: c } => return exit_failure(reason: concat("Printer state layout not converged: ", c)) PrinterStateMoved => {} }
  let requests = match print_request_store(tree: tree) { PrintRequestStoreReady { store: x } => x PrintRequestStoreUnready { detail: d } => return exit_failure(reason: concat("Print request records unavailable: ", d)) }
  let completions = match print_completion_store(tree: tree) { PrintCompletionStoreReady { store: x } => x PrintCompletionStoreUnready { detail: d } => return exit_failure(reason: concat("Print completion records unavailable: ", d)) }
  let claims = match printer_start_claims(tree: tree) { PrinterStartClaimsReady { store: x } => x PrinterStartClaimsUnready { detail: d } => return exit_failure(reason: concat("Printer start claims unavailable: ", d)) }
  let start_evidence = match start_evidence_store(tree: tree) { StartEvidenceStoreReady { store: x } => x StartEvidenceStoreUnready { detail: d } => return exit_failure(reason: concat("Printer start evidence unavailable: ", d)) }
  let holds = match printer_execution_hold_store(tree: tree) { PrinterExecutionHoldStoreReady { store: x } => x PrinterExecutionHoldStoreUnready { detail: d } => return exit_failure(reason: concat("Printer execution hold unavailable: ", d)) }
  let route = print_pass_route(pass_ref: pass_ref, record: print_request_read(store: requests, request: request))
  let record = match route {
    PrintPassRecordRefused { cause: _ } => return exit_failure(reason: print_pass_refusal_text(route: route))
    PrinterStartRefusedOffReviewedMain { ref: _ } => return exit_failure(reason: print_pass_refusal_text(route: route))
    PrintPassStartRecorded { record: r } => r
    PrintPassPrepare => match print_action(s: print_standing(evidence: NoRequestRecord)) {
      Prepare => match prepare_and_record(tree: tree, requests: requests, request: request, source_revision: source_revision, run_id: run_id) {
        RecordPresent { record: r } => return write_receipt(printer: r.request.printer, standing: "prepared", version: "", remote: "", digest: r.artifact_sha256.hex as String, token_source: token_source)
        RecordRefused { cause: c } => return exit_failure(reason: c)
        RecordAbsent => return exit_failure(reason: "Preparation produced no record")
      }
      _ => return exit_failure(reason: "An unrecorded request admits only preparation")
    }
  }
  let claim_key = attempt_claim_key(attempt: record.attempt_id as String)
  let remote = remote_name_for_attempt(content: sha256_digest(hex: record.artifact_sha256.hex as NonEmptyStr), attempt: record.attempt_id)
  let completed = match print_completion_presence(store: completions, claim_key: claim_key) { CompletionListed => true CompletionNotListed => false CompletionPresenceUnreadable { cause: _ } => return exit_failure(reason: "Print completion records unreadable; standing cannot be derived") }
  let claimed = match printer_start_claim_listed(claims: claims, key: claim_key) { Present { value: b } => b Absent => return exit_failure(reason: "Start claims unreadable; standing cannot be derived") }
  let version = if claimed {
    match printer_start_claim_version(claims: claims, key: claim_key) { Present { value: v } => v Absent => return exit_failure(reason: "The attempt's claim does not carry a readable credential version; inspect it") }
  } else {
    match resolve_credential_version(printer: record.request.printer, token_source: token_source) { Present { value: v } => v Absent => return exit_failure(reason: "Printer credential version could not be resolved from the registry") }
  }
  // The report that derives this pass's standing is the one any completion record retains; the
  // record never carries a second, later observation that nothing checked.
  let observed = if completed { none } else {
    match session_report(printer: record.request.printer, version: version, token_source: token_source) { Present { value: t } => Present { value: t } Absent => return exit_failure(reason: "Printer observation unavailable; standing cannot be derived and nothing was sent") }
  }
  let evidence = match observed {
    Absent => match print_completion_standing(store: completions, claim_key: claim_key, record: record, remote: remote) {
      CompletionMatchesRequest => CompletionRecorded
      CompletionDoesNotMatchRequest => CompletionRecordMismatched
      CompletionUnreadable { cause: c } => return exit_failure(reason: concat("Completion record unreadable, standing cannot be derived: ", c))
    }
    Present { value: report } => if claimed { ClaimedObserved { job: observe_job(text: report, remote: remote as String) } } else { RecordedNotClaimed { printer_ready: report_allows_start(text: report) } }
  }
  let standing = print_standing(evidence: evidence)
  let name = print_standing_name(s: standing)
  match print_action(s: standing) {
    Prepare => exit_failure(reason: "A recorded request cannot need preparation")
    ObserveOnly => write_receipt(printer: record.request.printer, standing: name, version: version as String, remote: remote as String, digest: record.artifact_sha256.hex as String, token_source: token_source)
    Stop => match write_receipt(printer: record.request.printer, standing: name, version: version as String, remote: remote as String, digest: record.artifact_sha256.hex as String, token_source: token_source) {
      _ => exit_failure(reason: concat(name, ": a person must inspect the printer and the attempt's records; this request will not start again"))
    }
    RecordCompletion => {
      let report = match observed { Present { value: t } => t Absent => return exit_failure(reason: "Completion standing without the observation that derived it") }
      match print_completion_record(store: completions, claim_key: claim_key, text: completion_text(record: record, remote: remote, run_id: run_id, report: report)) {
        CompletionWriteRefused { cause: c } => return exit_failure(reason: concat("Completion observed but its record cannot be written: ", c))
        CompletionWritten => {}
      }
      write_receipt(printer: record.request.printer, standing: "completed", version: version as String, remote: remote as String, digest: record.artifact_sha256.hex as String, token_source: token_source)
    }
    RequestBedClearThenStart => {
      let path = join([print_run_directory(tree: tree) as String, "/", record.attempt_id as String, "-", run_id, ".3mf"], "")
      if !copy_verified(record: record, path: path) { return exit_failure(reason: "The recorded artifact is missing or no longer hashes to its recorded digest; prepare under a new request id") }
      approve_and_print(printer: record.request.printer as String, hold_store: holds, claims: claims, evidence: start_evidence, path: path, digest: record.artifact_sha256.hex as String, version: version as String, attempt: record.attempt_id as String, token_source: token_source)
    }
  }
}
