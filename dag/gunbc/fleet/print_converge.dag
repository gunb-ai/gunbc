import std.process { ProcessExit, ExitSuccess, ExitFailure, exit_failure }
import std.algebra { trim }
import extdeps.shell
import extdeps.tools.hostname
import extdeps.filesystem.filesystem_io { Filesystem, listed_entry_presence, FilesystemEntryAbsent, FilesystemEntryListed, FilesystemEntryPresenceIndeterminate, FilesystemEntrySubjectRefused }
import extdeps.shell.exec { ProcessOutputPresent, ProcessOutputAbsent, ProcessRefused }
import extdeps.crypto.hash { sha256_digest }
import extdeps.languages.json.emit { JsonValue, json_object, json_kv, json_string, serialize_json }
import extdeps.languages.json.parse { parse_json_document, JsonDocumentParsed, JsonDocumentUnreadable, json_field_string, json_field, FieldRead, FieldAbsent, FieldMalformed }
import extdeps.languages.json.emit { JsonArray, JsonNull, JsonBool, JsonNumber, JsonString, JsonObject }
import gunbc.fleet.fleet_asset_identity { PhysicalAssetIdentity }
import gunbc.fleet.printer_federation { printer_lan_host_identity }
import gunbc.fleet.printer_workflow_artifact { printer_start_claim_directory }
import gunbc.fleet.fleet_printer_access { read_existing_printer_session, PrinterSessionReady, PrinterSessionRefused }
import gunbc.fleet.printer_report { report_using_session }
import gunbc.fleet.printer_job_monitor { observe_job }
import gunbc.fleet.printer_project_delivery { remote_name_for_digest }
