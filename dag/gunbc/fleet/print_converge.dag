// ONE CONVERGENCE PASS OVER ONE PRINT REQUEST. Each pass reads the durable records and the printer
// afresh, derives the standing (gunbc.fleet.print_request print_standing) and takes the one action
// that standing permits, then returns. A pass that stops at a wait is re-run, never resumed; an
// ambiguous start stops and is left to a person. Request records share the start claims' directory
// and failure domain: if that host state is lost, a request refuses (its record or claim cannot be
// read), and absence is never reconstructed as permission to start.
fn request_directory() -> String { concat(printer_start_claim_directory as String, "/requests") }
data print_run_directory: String = "/var/lib/gunbc/print-runs"

fn record_path(request: PrintRequest) -> String { join([request_directory(), "/", request_record_name(request_id: request.request_id)], "") }
fn completion_name(claim_file: String) -> String { concat(claim_file, ".completed.json") }

fn record_json(r: PrintRequestRecord) -> String {
  serialize_json(v: json_object(members: [
    json_kv(key: "schema", value: json_string(s: "gunbc.print-request-record.v2")),
    json_kv(key: "request_id", value: json_string(s: r.request.request_id as String)),
    json_kv(key: "root", value: json_string(s: r.request.root as String)),
    json_kv(key: "recipe", value: json_string(s: r.request.recipe as String)),
    json_kv(key: "printer", value: json_string(s: r.request.printer as String)),
    json_kv(key: "source_revision", value: json_string(s: r.source_revision as String)),
    json_kv(key: "preparation_key_digest", value: json_string(s: r.preparation_key_digest.hex as String)),
    json_kv(key: "artifact_sha256", value: json_string(s: r.artifact_sha256.hex as String)),
    json_kv(key: "attempt_id", value: json_string(s: r.attempt_id as String)),
  ]))
}

// A field that is absent, malformed or empty is a refusal of the whole record, never a default.
fn field(v: JsonValue, key: String) -> NonEmptyStr? {
  match json_field_string(obj: v, key: key) { FieldRead { value: s } => if s == "" { none } else { Present { value: s as NonEmptyStr } } FieldAbsent => none FieldMalformed { cause: _ } => none }
}
fn field_is(v: JsonValue, key: String, expected: String) -> Bool {
  match field(v: v, key: key) { Present { value: s } => (s as String) == expected Absent => false }
}
fn digest_field(v: JsonValue, key: String) -> Sha256Digest? {
  match field(v: v, key: key) { Present { value: s } => sha256_hex_digest(hex: s as String) Absent => none }
}

type RecordRead = RecordAbsent | RecordPresent { record: PrintRequestRecord } | RecordRefused { cause: String }

fn missing(name: String) -> RecordRead { RecordRefused { cause: join(["Request record field ", name, " is absent or malformed"], "") } }

fn read_record(request: PrintRequest) -> RecordRead {
  match listed_entry_presence(directory: request_directory(), name: request_record_name(request_id: request.request_id)) {
    FilesystemEntryAbsent(_) => RecordAbsent
    FilesystemEntryPresenceIndeterminate { cause: c } => RecordRefused { cause: concat("Request records unreadable: ", c) }
    FilesystemEntrySubjectRefused { directory: _, name: _, cause: c } => RecordRefused { cause: c }
    FilesystemEntryListed { directory: _, name: _ } => {
      let read = Filesystem.Read(path: record_path(request: request))
      if !read.success { return RecordRefused { cause: "Request record listed but unreadable" } }
      match parse_json_document(s: read.content) {
        JsonDocumentUnreadable { gap: _ } => RecordRefused { cause: "Request record is not JSON" }
        JsonDocumentParsed { value: v } => {
          let request_id = match field(v: v, key: "request_id") { Present { value: x } => x Absent => return missing(name: "request_id") }
          let root = match field(v: v, key: "root") { Present { value: x } => x Absent => return missing(name: "root") }
          let recipe = match field(v: v, key: "recipe") { Present { value: x } => x Absent => return missing(name: "recipe") }
          let printer = match field(v: v, key: "printer") { Present { value: x } => x Absent => return missing(name: "printer") }
          let revision = match field(v: v, key: "source_revision") { Present { value: x } => x Absent => return missing(name: "source_revision") }
          let key = match digest_field(v: v, key: "preparation_key_digest") { Present { value: x } => x Absent => return missing(name: "preparation_key_digest") }
          let artifact = match digest_field(v: v, key: "artifact_sha256") { Present { value: x } => x Absent => return missing(name: "artifact_sha256") }
          let attempt = match field(v: v, key: "attempt_id") { Present { value: x } => x Absent => return missing(name: "attempt_id") }
          let recorded = PrintRequestRecord {
            request: PrintRequest { request_id: request_id, root: root, recipe: recipe, printer: printer as PhysicalAssetIdentity },
            source_revision: revision, preparation_key_digest: key, artifact_sha256: artifact, attempt_id: attempt,
          }
          if !record_matches(record: recorded, request: request) { RecordRefused { cause: "This request id is recorded for a different root, recipe or printer; use a new request id" } }
          else { if recorded.attempt_id != print_attempt_id(request: request, artifact_sha256: recorded.artifact_sha256) { RecordRefused { cause: "Recorded attempt does not derive from the recorded request and artifact" } }
          else { RecordPresent { record: recorded } } }
        }
      }
    }
  }
}

// THE PREPARING PASS. The root's committed plate plan (artifacts/printing/<root>/plate.json) is the
// placement; the recipe is the machine and process; the request is the physical printer. It needs no
// credential and never contacts the printer.
fn prepare_and_record(request: PrintRequest, source_revision: NonEmptyStr, run_id: String) -> RecordRead {
  let output = join([print_run_directory, "/", request_record_name(request_id: request.request_id), "-", run_id], "")
  match prepare_request_plate(plate_file: join(["artifacts/printing/", request.root as String, "/plate.json"], ""), output: output, recipe: request.recipe as String, source_revision: source_revision as String, root: request.root as String) {
    RequestPlateRefused { cause: c } => RecordRefused { cause: concat("Preparation refused: ", c) }
    RequestPlatePrepared { artifact: a, key: k } => {
      let record = PrintRequestRecord { request: request, source_revision: source_revision, preparation_key_digest: k, artifact_sha256: a, attempt_id: print_attempt_id(request: request, artifact_sha256: a) }
      if !shell.Mkdir.Parents(path: request_directory() as FilePath).success || !Filesystem.WriteCreateNew(path: record_path(request: request), content: record_json(r: record)).success {
        RecordRefused { cause: "Cannot write the request record, or another pass wrote it first; re-run" }
      } else { RecordPresent { record: record } }
    }
  }
}

fn listed(name: String) -> Bool? {
  match listed_entry_presence(directory: printer_start_claim_directory as String, name: name) {
    FilesystemEntryListed { directory: _, name: _ } => Present { value: true }
    FilesystemEntryAbsent(_) => Present { value: false }
    FilesystemEntryPresenceIndeterminate { cause: _ } => none
    FilesystemEntrySubjectRefused { directory: _, name: _, cause: _ } => none
  }
}

// The credential version a start uses is the registry's latest, resolved when the start is selected;
// it is sealed into that attempt's signed subject, which the claim file holds.
fn resolve_credential_version(printer: PhysicalAssetIdentity, token_source: AccessTokenSource) -> NonEmptyStr? {
  match printer_access_code_locus(printer: printer) {
    PrinterAccessCodeLocusUnknown { printer: _ } => none
    PrinterAccessCodeLocusConflict { printer: _, matches: _ } => none
    PrinterAccessCodeDesiredLocusFound { locus: locus } =>
      match fetch_secret_ref_credential(secret_ref: secret_ref_pin_version(ref: locus.secret, version: "latest"), token_source: token_source) {
        SecretCredentialReady { credential: c, resolved_version: version } => if (c as String) == "" { none } else {
          match sm_resolved_version_id(identity: version) { SmVersionIdProjected { version: v } => Present { value: v as NonEmptyStr } SmVersionIdNotAVersionResource { supplied: _ } => none }
        }
        SecretCredentialAccessUpsertRequired { plan: _ } => none
        SecretCredentialWireDecodeRefused { identity_cause: _, payload_cause: _ } => none
        SecretCredentialFetchRefused { reason: _ } => none
        SecretCredentialResolvedVersionMismatch { requested: _, resolved: _ } => none
      }
  }
}

// A claimed attempt's version is the one its signed subject sealed, read back from the claim.
fn claimed_version(claim_path: String) -> NonEmptyStr? {
  let read = Filesystem.Read(path: claim_path)
  if !read.success { return none }
  match parse_json_document(s: read.content) { JsonDocumentParsed { value: v } => field(v: v, key: "credential_version") JsonDocumentUnreadable { gap: _ } => none }
}

fn completion_text(record: PrintRequestRecord, remote: NonEmptyStr, run_id: String, report: String) -> String {
  serialize_json(v: json_object(members: [
    json_kv(key: "schema", value: json_string(s: "gunbc.print-completion.v2")),
    json_kv(key: "request_id", value: json_string(s: record.request.request_id as String)),
    json_kv(key: "printer", value: json_string(s: record.request.printer as String)),
    json_kv(key: "attempt_id", value: json_string(s: record.attempt_id as String)),
    json_kv(key: "artifact_sha256", value: json_string(s: record.artifact_sha256.hex as String)),
    json_kv(key: "remote_name", value: json_string(s: remote as String)),
    json_kv(key: "run_id", value: json_string(s: run_id)),
    json_kv(key: "printer_report", value: json_string(s: report)),
    json_kv(key: "meaning", value: json_string(s: "the printer finished this attempt; fit and visual acceptance are separate observations")),
  ]))
}

// Completion counts only when the record restates this request, printer, attempt, artifact and job.
fn completion_matches(text: String, record: PrintRequestRecord, remote: NonEmptyStr) -> Bool {
  match parse_json_document(s: text) {
    JsonDocumentUnreadable { gap: _ } => false
    JsonDocumentParsed { value: v } =>
      field_is(v: v, key: "schema", expected: "gunbc.print-completion.v2") &&
      field_is(v: v, key: "request_id", expected: record.request.request_id as String) &&
      field_is(v: v, key: "printer", expected: record.request.printer as String) &&
      field_is(v: v, key: "attempt_id", expected: record.attempt_id as String) &&
      field_is(v: v, key: "artifact_sha256", expected: record.artifact_sha256.hex as String) &&
      field_is(v: v, key: "remote_name", expected: remote as String)
  }
}

fn session_report(printer: PhysicalAssetIdentity, version: NonEmptyStr, token_source: AccessTokenSource) -> String? {
  match read_existing_printer_session(printer: printer, version: version, token_source: token_source) {
    PrinterSessionRefused { cause: _ } => none
    PrinterSessionReady { session: s } => match report_using_session(session: s) { ProcessOutputPresent { text: t } => Present { value: t } ProcessOutputAbsent => none ProcessRefused { exit_code: _, stderr: _ } => none }
  }
}

fn converge_print(request: PrintRequest, source_revision: NonEmptyStr, run_id: String, token_source: AccessTokenSource) -> ProcessExit {
  let host = os.Hostname.ReadShort()
  if !host.success || trim(s: host.value) != (printer_lan_host_identity() as String) { return exit_failure(reason: "Print convergence runs on the modeled printer LAN host") }
  let record = match read_record(request: request) {
    RecordRefused { cause: c } => return exit_failure(reason: c)
    RecordPresent { record: r } => r
    RecordAbsent => match print_action(s: print_standing(evidence: NoRequestRecord)) {
      Prepare => match prepare_and_record(request: request, source_revision: source_revision, run_id: run_id) {
        RecordPresent { record: r } => return write_receipt(printer: r.request.printer, standing: "prepared", version: "", remote: "", digest: r.artifact_sha256.hex as String, token_source: token_source)
        RecordRefused { cause: c } => return exit_failure(reason: c)
        RecordAbsent => return exit_failure(reason: "Preparation produced no record")
      }
      _ => return exit_failure(reason: "An unrecorded request admits only preparation")
    }
  }
  let claim_key = attempt_claim_key(attempt: record.attempt_id as String)
  let claim_path = start_claim_path(key: claim_key)
  let claim_file = start_claim_name(key: claim_key)
  let remote = remote_name_for_attempt(content: sha256_digest(hex: record.artifact_sha256.hex as NonEmptyStr), attempt: record.attempt_id)
  let completed = match listed(name: completion_name(claim_file: claim_file)) { Present { value: b } => b Absent => return exit_failure(reason: "Start claims unreadable; standing cannot be derived") }
  let claimed = match listed(name: claim_file) { Present { value: b } => b Absent => return exit_failure(reason: "Start claims unreadable; standing cannot be derived") }
  let version = if claimed {
    match claimed_version(claim_path: claim_path) { Present { value: v } => v Absent => return exit_failure(reason: "The attempt's claim does not carry a readable credential version; inspect it") }
  } else {
    match resolve_credential_version(printer: record.request.printer, token_source: token_source) { Present { value: v } => v Absent => return exit_failure(reason: "Printer credential version could not be resolved from the registry") }
  }
  let evidence = if completed {
    let read = Filesystem.Read(path: concat(printer_start_claim_directory as String, concat("/", completion_name(claim_file: claim_file))))
    if read.success && completion_matches(text: read.content, record: record, remote: remote) { CompletionRecorded } else { CompletionRecordMismatched }
  } else {
    let report = match session_report(printer: record.request.printer, version: version, token_source: token_source) { Present { value: t } => t Absent => return exit_failure(reason: "Printer observation unavailable; standing cannot be derived and nothing was sent") }
    if claimed { ClaimedObserved { job: observe_job(text: report, remote: remote as String) } } else { RecordedNotClaimed { printer_ready: report_allows_start(text: report) } }
  }
  let standing = print_standing(evidence: evidence)
  let name = print_standing_name(s: standing)
  match print_action(s: standing) {
    Prepare => exit_failure(reason: "A recorded request cannot need preparation")
    ObserveOnly => write_receipt(printer: record.request.printer, standing: name, version: version as String, remote: remote as String, digest: record.artifact_sha256.hex as String, token_source: token_source)
    Stop => match write_receipt(printer: record.request.printer, standing: name, version: version as String, remote: remote as String, digest: record.artifact_sha256.hex as String, token_source: token_source) {
      _ => exit_failure(reason: concat(name, ": a person must inspect the printer and the attempt's records; this request will not start again"))
    }
    RecordCompletion => {
      let report = match session_report(printer: record.request.printer, version: version, token_source: token_source) { Present { value: t } => t Absent => return exit_failure(reason: "Printer observation unavailable at completion") }
      if !Filesystem.WriteCreateNew(path: concat(printer_start_claim_directory as String, concat("/", completion_name(claim_file: claim_file))), content: completion_text(record: record, remote: remote, run_id: run_id, report: report)).success { return exit_failure(reason: "Completion observed but its record cannot be written") }
      write_receipt(printer: record.request.printer, standing: "completed", version: version as String, remote: remote as String, digest: record.artifact_sha256.hex as String, token_source: token_source)
    }
    RequestBedClearThenStart => {
      let path = join([print_run_directory, "/", record.attempt_id as String, "-", run_id, ".3mf"], "")
      if !shell.Mkdir.Parents(path: print_run_directory as FilePath).success || !materialize_artifact(sha256: record.artifact_sha256, path: path) { return exit_failure(reason: "Cannot materialize the recorded artifact from the prepared store") }
      approve_and_print(printer: record.request.printer as String, path: path, digest: record.artifact_sha256.hex as String, version: version as String, attempt: record.attempt_id as String, token_source: token_source)
    }
  }
}
