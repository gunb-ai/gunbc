fn enrolled_fingerprint_for(host: String) -> String? {
  fold(fleet_host_key_enrollments, init: none, f: fn(acc, k) {
    match acc {
      Present { value: _ } => acc
      _ => if (k.host as String) == host { Present { value: k.sha256_fingerprint } } else { none }
    }
  })
}

fn known_hosts_line(k: KnownHostKeyRow) -> String {
  join([k.endpoint, " ", k.key_type, " ", k.public_key_base64], "")
}

// The honest provenance label carried into the enroll receipt so a reader sees WHAT
// grounds each pinned key — trust-on-first-use vs an independent anchor — rather than
// reading "found" and inferring verification the row does not claim.
fn host_key_provenance_label(p: HostKeyEnrollmentProvenance) -> String {
  match p {
    ScannedFirstContact { scanned_from: _ } => "scanned-first-contact"
    IndependentlyAnchored { authority: _ } => "independently-anchored"
  }
}

data fleet_host_key_scan_receipt_path: String = "target/fleet-host-key-scan-receipt.txt"

// One host's scan: keyscan at the modeled endpoint (ed25519 — the key type both
// bold-eagle measurements and OpenSSH defaults lead with), then fingerprint the scanned
// line. Both captures ride the receipt VERBATIM with a per-host outcome label; a
// refusing scan is a typed absent line, never an empty fabrication.
// Post-apply verification. Hoisted out of the apply arms so both admitted arms share one route,
// and matched rather than read: the old code did concat("outcome=", trim(verify.stdout)), so a
// verify that REFUSED emitted the literal receipt line "outcome=" -- a fabricated plausible output
// standing where the answer was unknown, written into a receipt someone would later read as fact.
// THE AUTHORIZED-KEYS PRESENCE DECISION, PURE OVER A SUPPLIED READ. The shell asked
// `grep -qxF "<key line>" "$H/.ssh/authorized_keys"`: fixed string (-F), whole line (-x), quiet
// (-q). The read-then-decide form asks the same question of a captured file: the key line is
// present iff some RAW line of the file EQUALS it -- no trimming on either side, exactly the
// whole-line comparison grep -x makes, so a line padded with leading or trailing whitespace (or a
// trailing CR from a file edited on Windows) is NOT the enrolled line. Substring containment (the
// scan-side test) is deliberately not enough here, because a line that merely CONTAINS the key
// material is not the enrolled line the registry wrote. A witness supplies both values; nothing
// here runs a process.
fn authorized_keys_admits_line(content: String, line: String) -> Bool {
  any(
    split(s: content, delimiter: "\n"),
    predicate: fn(l) { l == line },
  )
}

// THE KEY LINE HAS ONE SOURCE. The staged target/fleet-authorized-key-line file was WRITTEN from
// fleet_automation_authorized_keys_line(); the deleted script recovered the same text with
// `cat ... | head -1` inside a substitution. Calling the source directly is not a new decision --
// it is the same fact without the file round-trip that could silently drift from what was staged.
// The verification consumes the passwd home the caller already established -- the deleted script
// re-derived it here with a SECOND whoami/getent pair that could disagree with the first -- so the
// passwd decision runs once per self-enroll and this fn only reads back and judges.
fn verify_enrollment_outcome(ph: String) -> String
{
  let line = fleet_automation_authorized_keys_line()
  match run_shell_command_capture(
    command: cat_command(path: concat(ph, "/.ssh/authorized_keys")),
    transport: LocalExec,
  ) {
    ProcessOutputPresent { text: content } =>
      if authorized_keys_admits_line(content: content, line: line) {
        "outcome=enrolled"
      } else {
        "outcome=ABSENT-after-apply"
      }
    ProcessOutputAbsent => "outcome=ABSENT-after-apply"
    ProcessRefused { exit_code: _, stderr: e } => join(["outcome=UNKNOWN cause=verify refused: ", trim(s: e)], "")
  }
}

// ProcessOutputPresent already means admitted-and-non-empty, so the old
// `scan.success && trim(scan.stdout) != ""` correlation is the variant itself rather than a
// condition the caller must remember to write. ProcessOutputAbsent is now a NAMED outcome --
// ssh-keyscan exiting 0 with no key is a different fact from ssh-keyscan failing, and the old
// shape reported both as "refused" with an empty cause.

// The old code fabricated a ShellCaptureResult here to stand in for a FILESYSTEM failure --
// a process result for something that was never a process, with an invented success: false.
// The coproduct makes that unwritable, which is the point: a write failure is not a process
// outcome and now has to be said in its own words.

fn scan_host_key_lines(host: String) -> String {
  let endpoint = fleet_probe_endpoint_for(host: host)
  match run_shell_command_capture(
    command: ssh_keyscan_command(host: endpoint, key_type: "ed25519", timeout_seconds: 5),
    transport: LocalExec,
  ) {
    ProcessOutputPresent { text: key_text } => {
      let key_file = join(["target/fleet-host-key-scan-", host, ".pub"], "")
      let w = Filesystem.Write(path: key_file, content: key_text)
      let fingerprint_text = if w.success {
        process_outcome_receipt_text(
          outcome: run_shell_command_capture(
            command: ssh_keygen_fingerprint_command(key_file: key_file),
            transport: LocalExec,
          )
        )
      } else {
        join(["(not computed: staging write refused: ", w.error, ")"], "")
      }
      join([
        "scan host=", host, " endpoint=", endpoint, " outcome=observed\n",
        "key ", trim(s: key_text), "\n",
        "fingerprint ", fingerprint_text, "\n",
      ], "")
    }
    ProcessOutputAbsent =>
      join([
        "scan host=", host, " endpoint=", endpoint, " outcome=no-key-offered cause=scan admitted but returned no key\n",
      ], "")
    ProcessRefused { exit_code: _, stderr: e } =>
      join([
        "scan host=", host, " endpoint=", endpoint, " outcome=refused cause=", trim(s: e), "\n",
      ], "")
  }
}

fn fleet_host_key_scan_wet() -> ProcessExit
{
  let body = join(map(fleet_reach_probe_targets, h => scan_host_key_lines(host: h)), "")
  let w = Filesystem.Write(path: fleet_host_key_scan_receipt_path, content: body)
  if w.success {
    ExitSuccess
  } else {
    exit_failure(reason: concat("fleet_host_key_scan: receipt publication failed — ", w.error))
  }
}

data fleet_host_key_enroll_receipt_path: String = "target/fleet-host-key-enroll-receipt.txt"

// The ENROLL apply: registry rows -> a staged enrolled-ONLY known_hosts fragment -> a
// SCOPED ssh config that PINS the probe to that fragment for the fleet endpoints ->
// per-host independent readback (ssh-keygen -F against the fragment), which is the
// success criterion — never the write's exit code. Refuses loudly when the registry is
// empty: enrolling nothing must not read as enrolled.
//
// HOST-KEY ANCHOR PIN (host-key audit, witty-raven-412 / bold-eagle-107 cross-check,
// 2026-08-10): the earlier form APPENDED the fragment to $HOME/.ssh/known_hosts with no
// StrictHostKeyChecking, so ssh accepted a host key matching ANY line — including a
// pre-existing AMBIENT entry of unaudited provenance (OOBE / prior manual TOFU). That
// left every host-scoped observation anchored to whatever the runner account already
// trusted rather than to this registry: observed_principal/observed_short_hostname were
// genuine remote readbacks, but from a machine verified against something we do not
// control. The pin closes it non-destructively: a scoped `Host <fleet endpoints>` block
// sets UserKnownHostsFile to the enrolled-ONLY fragment and StrictHostKeyChecking yes, so
// for fleet hosts ssh consults ONLY this registry and REFUSES an unknown or mismatched
// key (a key change now trips ProbeHostKeyMismatch instead of silently passing). It is
// scoped to the fleet endpoints so non-fleet ssh (e.g. git) is untouched even on a
// durable HOME, and marker-guarded (`# gunbc-fleet-pin`) so a repeated run appends once.
// The enrolled baseline itself is ScannedFirstContact for srv1..srv4 (see
// HostKeyEnrollmentProvenance) — the pin lifts the anchor from ambient-unaudited to
// this-registry, NOT to an externally-verified key; that ceiling is carried by the
// provenance type, not hidden. The banked probe run 31346260819 PRE-DATES this pin and
// rode ambient known_hosts; the enrolled-anchored re-observe lands post-merge (probe
// jobs run on main/dispatch, skip on PR) in the same window as the host-receipt item.
//
// MEASURED CORRECTION (runs 31323572188): enrollment is NOT durable host state on a CI
// runner — GitHub Actions overrides HOME to a per-job temp directory, so a separate
// enroll job writes into an ephemeral HOME discarded at job end, and a probe job reads
// its OWN temp HOME. The registry is therefore materialized into the CURRENT process's
// HOME by fleet_host_key_enroll_apply, which the probe entry calls FIRST — enrollment
// rides with every probe run instead of pretending to persist.
// THE PIN, ONE DECLARED SEQUENCE OVER THE PROCESS'S OWN HOME. The deleted script ran a shell to do
// five things -- mkdir -p, touch, grep for the marker, append four lines with $(pwd) inside a
// substitution, chmod 600 -- and folded "config unreadable" into "config unpinned". Each step is
// now its own declared carrier: the home is the process's own environment (shell.Env.Get; unset
// refuses, where the shell would have built /.ssh at the filesystem root), the working directory is
// a captured pwd (so the fragment path stays absolute, which is why the substitution existed -- ssh
// resolves UserKnownHostsFile against the user's home, not the invoking directory), touch is the
// put-if-absent create whose occupied arm says "read what is there", the marker check is a content
// question over the read, the append is a modeled read-then-write of the SAME bytes `>>` would have
// added, and the mode is a typed chmod. The fragment path is built once, from one capture, so the
// pinned line and the staged file cannot disagree about where the fragment lives.
fn fleet_host_key_enroll_apply() -> String
{
  if length(fleet_host_key_enrollments) == 0 {
    "enroll outcome=refused cause=registry-empty\n"
  } else {
    let fragment = join(map(fleet_host_key_enrollments, k => concat(known_hosts_line(k: k), "\n")), "")
    let staged = "target/fleet-known-hosts-fragment"
    let endpoints = join(map(fleet_host_key_enrollments, k => k.endpoint), " ")
    let w = Filesystem.Write(path: staged, content: fragment)
    if w.success {
      let home = match shell.Env.Get(name: "HOME" as NonEmptyStr).value {
        Absent => ""
        Present { value: raw } => trim(s: raw)
      }
      if home == "" {
        "enroll outcome=refused cause=HOME unset: the registry rides with the process's own home, and there is none to pin\n"
      } else {
        let ssh_dir = concat(home, "/.ssh")
        let cfg = concat(ssh_dir, "/config")
        let fragment_path = join([trim(s: cwd_capture_stdout(outcome: run_shell_command_capture(command: pwd_command(), transport: LocalExec))), "/target/fleet-known-hosts-fragment"], "")
        if fragment_path == "/target/fleet-known-hosts-fragment" {
          "enroll outcome=refused cause=working directory unavailable: the pinned fragment path must be absolute\n"
        } else {
          let prepared = run_shell_commands(
            commands: [ mkdir_parents_command(path: ssh_dir) ],
            transport: LocalExec,
          )
          match prepared {
            ExitFailure { code: _, reason: why } => join(["enroll outcome=refused cause=ssh-directory staging: ", why, "\n"], "")
            ExitSuccess => {
              let touch = Filesystem.WriteCreateNew(path: cfg, content: "")
              match filesystem_create_new(path: cfg, success: touch.success, error: touch.error, error_kind: touch.error_kind) {
                FilesystemCreateRefused { path: _, kind: _, error: e } =>
                  join(["enroll outcome=refused cause=ssh-config create: ", e, "\n"], "")
                FilesystemCreateKindUnrecognized { path: _, observed: o, error: e } =>
                  join(["enroll outcome=refused cause=ssh-config create (host error kind ", o, " unrecognized): ", e, "\n"], "")
                FilesystemCreated { path: _ } =>
                  fleet_host_key_enroll_apply_after_create(cfg: cfg, endpoints: endpoints, fragment_path: fragment_path, staged: staged)
                FilesystemCreateTargetOccupied { path: _ } =>
                  fleet_host_key_enroll_apply_after_create(cfg: cfg, endpoints: endpoints, fragment_path: fragment_path, staged: staged)
              }
            }
          }
        }
      }
    } else {
      join(["enroll outcome=refused cause=ssh-config staging write: ", w.error, "\n"], "")
    }
  }
}

// THE CONFIG'S PUT-IF-ABSENT PROCEED ARM. Created and TargetOccupied are the same next move --
// read what is there and pin the four lines once -- which is the idempotence the shell's `touch`
// provided. The staged-write refusal that follows the successful write is named above: the
// fragment is staged but not pinned, and the receipt says so.
fn fleet_host_key_enroll_apply_after_create(cfg: String, endpoints: String, fragment_path: String, staged: String) -> String
{
  {
    let r = Filesystem.Read(path: cfg)
    match filesystem_read_outcome(content: r.content, success: r.success, error: r.error) {
      FilesystemReadRefused { error: e } =>
        join(["enroll outcome=refused cause=ssh-config unreadable, not appending: ", e, "\n"], "")
      FilesystemReadSucceeded { content: existing } =>
        match pinned_config_content(existing: existing, endpoints: endpoints, fragment_path: fragment_path) {
          PinConfigAlreadyPinned =>
            match run_shell_commands(
              commands: [ chmod_set_mode_command(chmod_program: chmod_binary_path, mode: "600", path: cfg) ],
              transport: LocalExec,
            ) {
              ExitFailure { code: _, reason: why } => join(["enroll outcome=refused cause=ssh-config mode: ", why, "\n"], "")
              ExitSuccess => pin_readback_block(staged: staged)
            }
          PinConfigNextContent { payload: fragment } => {
            match run_shell_command_stdin_local(
              command: tee_append_command(path: cfg),
              stdin_payload: fragment,
            ) {
              ExitFailure { code: _, reason: why } => join(["enroll outcome=refused cause=ssh-config append: ", why, "\n"], "")
              ExitSuccess => {
                match run_shell_commands(
                  commands: [ chmod_set_mode_command(chmod_program: chmod_binary_path, mode: "600", path: cfg) ],
                  transport: LocalExec,
                ) {
                  ExitFailure { code: _, reason: why } => join(["enroll outcome=refused cause=ssh-config mode: ", why, "\n"], "")
                  ExitSuccess => pin_readback_block(staged: staged)
                }
              }
            }
          }
        }
    }
  }
}

// THE PINNED-CONFIG DECISION, PURE OVER A SUPPLIED READ. The marker is a content question: does
// the config already carry the fleet pin? Already-pinned answers PinConfigAlreadyPinned -- no
// write happens, and the read's bytes are left exactly as they were. Otherwise the answer is the
// APPEND PAYLOAD: the four pin lines with the leading blank line the shell's first `echo`
// contributed, in the same order the shell's grouped echo-redirect added them, with the fragment
// path absolute from one pwd capture. The caller appends the payload (tee -a, O_APPEND), so the
// config's other lines are never rewritten and a pin another process adds meanwhile survives; the
// payload begins with a newline so a config that does not end in one is not glued to the pin. A
// witness supplies every value; nothing here reads a file or runs a process.
type PinnedConfigDecision
  = PinConfigAlreadyPinned
  | PinConfigNextContent { payload: String }

fn pinned_config_content(existing: String, endpoints: String, fragment_path: String) -> PinnedConfigDecision {
  if string_contains(s: existing, pattern: "gunbc-fleet-pin") {
    PinConfigAlreadyPinned
  } else {
    PinConfigNextContent {
      payload: join([
        "\n# gunbc-fleet-pin\nHost ",
        endpoints,
        "\n  StrictHostKeyChecking yes\n  UserKnownHostsFile ",
        fragment_path,
        "\n",
      ], ""),
    }
  }
}

// THE CAPTURED CWD AS A PATH PREFIX, PURE OVER A SUPPLIED OUTCOME. pwd prints one line and nothing
// else (coreutils pwd(1)); anything else is a refusal to build an absolute path from, and the
// caller refuses rather than pin a relative UserKnownHostsFile ssh would resolve against the user's
// home.
fn cwd_capture_stdout(outcome: ProcessOutcome) -> String {
  match outcome {
    ProcessOutputPresent { text: t } => trim(s: t)
    ProcessOutputAbsent => ""
    ProcessRefused { exit_code: _, stderr: _ } => ""
  }
}

// THE READBACK, SHARED BY BOTH PIN ARMS. After the sequence converges (freshly written or already
// pinned), each enrolled endpoint is read back out of the staged fragment with the same typed
// ssh-keygen -F the entry point has always used: found means the pin really pinned it.
fn pin_readback_block(staged: String) -> String {
  join(map(fleet_host_key_enrollments, k => {
    let f = run_shell_command_capture(
      command: ssh_keygen_known_hosts_find_command(host: k.endpoint, known_hosts_file: staged),
      transport: LocalExec,
    )
    join([
      "enroll host=", k.host as String, " endpoint=", k.endpoint,
      " provenance=", host_key_provenance_label(p: k.provenance),
      if process_outcome_admitted(outcome: f) { " readback=found-in-pinned-fragment" } else { " readback=ABSENT" }, "\n",
    ], "")
  }), "")
}

fn fleet_host_key_enroll_wet() -> ProcessExit
{
  let receipt = fleet_host_key_enroll_apply()
  let wr = Filesystem.Write(path: fleet_host_key_enroll_receipt_path, content: receipt)
  if wr.success {
    if string_contains(s: receipt, pattern: "outcome=refused") {
      exit_failure(reason: concat("fleet_host_key_enroll: apply refused — ", receipt))
    } else {
      ExitSuccess
    }
  } else {
    exit_failure(reason: concat("fleet_host_key_enroll: receipt publication failed — ", wr.error))
  }
}

// Ruling msg_43a8fd77 item 1: AUTHORIZED-KEY SELF-ENROLLMENT is self-service — a
// dispatched job runs AS the runner account on its host, so writing the fleet PUBLIC
// key into that account's ~/.ssh/authorized_keys needs no sudo and no secret access
// (the same self-install pattern as the timer). Idempotent by exact-line presence
// check (grep -qxF), never an appended duplicate; dir/file created 0700/0600 when
// absent. Asymmetry stated honestly: this grants fleet-key holders login as the runner
// account — the intended design (the fleet key IS fleet automation's credential), and
// reversible by removing the line. The receipt carries whoami — which is also the
// recorded EXISTENCE proof for the runner account on each host the job lands on.
data fleet_authorized_key_enroll_receipt_path: String = "target/fleet-authorized-key-enroll-receipt.txt"

// Re-grounded on the extdeps.ssh.keys authority (review 51659): this join re-spelled the line
// construction that module already owns, and hardcoded an algorithm token it already serializes.
fn fleet_automation_authorized_keys_line() -> String {
  ssh_public_key_line(k: fleet_automation_ssh_key)
}

// THE BOOTSTRAP APPLY, ONE DECLARED SEQUENCE OVER THE HOME THE CHECK ESTABLISHED. The deleted
// script chained five steps with && and folded every failure into one string: mkdir -p the .ssh
// directory, mode it 700, touch the key file into existence, mode it 600, append the key line.
// Each step keeps its carrier and its own refusal: the directory steps are typed commands (the
// builders the extdeps modules own), touch is the put-if-absent create whose occupied arm
// PRESERVES keys already present (where the shell's touch did the same by being idempotent), the
// mode is a typed chmod before any key byte lands, and the append is a modeled read-then-write of
// exactly the bytes `>>` added -- existing content first, the key line last, newline-terminated.
// The sequence runs only after the presence check refused to key an already-pinned home, so its
// effect is the same idempotence the shell version had: enrolled stays enrolled, with the same
// line, in the same place, under the same modes.
// THE PRESENCE VERDICT, PURE OVER A SUPPLIED READ. The deleted script's
// `grep -qxF ... 2>/dev/null && echo present || echo absent` answered absent for a missing key
// file -- grep's exit 2 folded into the same `||` -- and its apply branch then created it: a
// fresh home enrolls. The typed read keeps that route (Absent applies) and refuses only what the
// old script never distinguished: a file that exists but cannot be read, and a host error the
// kind table does not know. The bytes the verdict judges are bound from the read itself -- the
// fn takes no separate content, so it cannot inspect anything but what was actually read.
// Witnesses pin each verdict; nothing here reads a file or runs a process.
type SelfEnrollPresenceDecision
  = SelfEnrollAlreadyPresent
  | SelfEnrollApply
  | SelfEnrollRefuse { cause: String }

fn self_enroll_presence_decision(observed: FilesystemExactRead, line: String) -> SelfEnrollPresenceDecision
{
  match observed {
    FilesystemExactPathRead { path: _, content: content } =>
      if authorized_keys_admits_line(content: content, line: line) {
        SelfEnrollAlreadyPresent
      } else {
        SelfEnrollApply
      }
    FilesystemExactPathAbsent { path: _ } => SelfEnrollApply
    FilesystemExactPathUnreadable { path: _, kind: _, error: e } =>
      SelfEnrollRefuse { cause: join(["presence-probe unreadable, not applying: ", e], "") }
    FilesystemExactPathKindUnrecognized { path: _, observed: o, error: e } =>
      SelfEnrollRefuse { cause: join(["presence-probe host error kind ", o, " unrecognized, not applying: ", e], "") }
  }
}

fn self_enroll_apply(home: String, line: String) -> String {
  let ssh_dir = concat(home, "/.ssh")
  let ak_path = concat(ssh_dir, "/authorized_keys")
  match run_shell_commands(
    commands: [ mkdir_parents_command(path: ssh_dir), chmod_set_mode_command(chmod_program: chmod_binary_path, mode: "700", path: ssh_dir) ],
    transport: LocalExec,
  ) {
    ExitFailure { code: _, reason: why } => join(["outcome=refused cause=ssh-directory staging: ", why], "")
    ExitSuccess => {
      let touch = Filesystem.WriteCreateNew(path: ak_path, content: "")
      match filesystem_create_new(path: ak_path, success: touch.success, error: touch.error, error_kind: touch.error_kind) {
        FilesystemCreateRefused { path: _, kind: _, error: e } => join(["outcome=refused cause=authorized-keys create: ", e], "")
        FilesystemCreateKindUnrecognized { path: _, observed: o, error: e } => join(["outcome=refused cause=authorized-keys create (host error kind ", o, " unrecognized): ", e], "")
        FilesystemCreated { path: _ } => self_enroll_apply_after_create(ak_path: ak_path, home: home, line: line)
        FilesystemCreateTargetOccupied { path: _ } => self_enroll_apply_after_create(ak_path: ak_path, home: home, line: line)
      }
    }
  }
}

// THE PUT-IF-ABSENT'S PROCEED ARM. Created and TargetOccupied are the same next move -- append
// the key line once -- which is the create-or-append the shell's touch-then-`>>` did; a new key
// file and an existing one reach this fn alike. THE APPEND IS tee(1) -a WITH THE KEY LINE ON
// STDIN: the shell's `echo "$line" >> "$f"` carried the line through argv, and tee -a opens the
// file for append (O_APPEND) so a key another process appends between our verdict and this write
// is PRESERVED, not erased by a whole-file rewrite. The key line rides stdin, never argv. The
// mode 600 is in force before the append, as the shell's chmod-before-echo order was. The
// verification consumes the passwd home the wet fn already established: the probe ran once, in
// the caller; no second whoami/getent pair re-derives it here.
fn self_enroll_apply_after_create(ak_path: String, home: String, line: String) -> String
{
  match run_shell_commands(
    commands: [ chmod_set_mode_command(chmod_program: chmod_binary_path, mode: "600", path: ak_path) ],
    transport: LocalExec,
  ) {
    ExitFailure { code: _, reason: why } => join(["outcome=refused cause=authorized-keys mode: ", why], "")
    ExitSuccess => {
      match run_shell_command_stdin_local(
        command: tee_append_command(path: ak_path),
        stdin_payload: join([line, "\n"], ""),
      ) {
        ExitFailure { code: _, reason: why } => join(["outcome=refused cause=authorized-keys append: ", why], "")
        ExitSuccess => verify_enrollment_outcome(ph: home)
      }
    }
  }
}

// THE DEFECT THIS MIGRATION EXISTS FOR. The old test was `trim(check.stdout) == "present"`
// with no consultation of success, so a probe that FAILED produced "" -- not "present" -- and
// fell through to the else branch, which APPLIES. A refusal to read the file was therefore
// indistinguishable from the key being absent, and the remedy for the two states is opposite:
// absent means write it, unreadable means stop and say so. Matching the arms makes the third
// state impossible to fall through: a refusal now refuses instead of mutating the file.

// THE PRESENCE CHECK AND THE APPLY, OVER THE SAME ESTABLISHED HOME. The deleted pair of scripts
// each re-derived H with `getent passwd "$(whoami)" | cut -d: -f6` inside a substitution -- two
// independent pipelines that could disagree -- and recovered the key line by re-reading the file
// this same fn had just staged. One passwd decision serves both: the probe runs here once
// (passwd_probe_for_user) and its home feeds the decision, the apply, and the post-apply verify;
// the key line is called from its source. The verdict is self_enroll_presence_decision, pure over
// a supplied read: an admitted read whose lines admit the key answers already-present; an
// admitted read without the key falls to the apply; a MISSING key file falls to the apply too --
// the deleted grep folded not-found into its `|| echo absent` and the apply branch then created
// it, so a fresh home enrolls here exactly as it did; only a file that exists but cannot be read,
// or a host error the kind table does not know, REFUSES -- the state the old script never
// distinguished from absent, where the remedy is opposite. Nothing is created before the verdict:
// the check does not touch the file, so a refused check still means a byte-identical home.
fn fleet_authorized_key_self_enroll_wet() -> ProcessExit
{
  let user = run_shell_command_capture(command: whoami_command(), transport: LocalExec)
  let hostname = run_shell_command_capture(command: hostname_read_command(), transport: LocalExec)
  let line = fleet_automation_authorized_keys_line()
  let staged = "target/fleet-authorized-key-line"
  let w = Filesystem.Write(path: staged, content: concat(line, "\n"))
  let outcome = if w.success {
    let passwd_probe = passwd_probe_for_user(user: user)
    let ph = passwd_home_of(obs: passwd_home_observation(user: user, passwd: passwd_probe))
    if ph == "" {
      "outcome=refused cause=passwd home unavailable, not applying"
    } else {
      let ak_path = concat(ph, "/.ssh/authorized_keys")
      let rc = Filesystem.Read(path: ak_path)
      match self_enroll_presence_decision(
        observed: filesystem_exact_read(path: ak_path, content: rc.content, success: rc.success, error: rc.error, error_kind: rc.error_kind),
        line: line,
      ) {
        SelfEnrollAlreadyPresent => "outcome=already-present"
        SelfEnrollApply => self_enroll_apply(home: ph, line: line)
        SelfEnrollRefuse { cause: c } => join(["outcome=refused cause=", c], "")
      }
    }
  } else {
    join(["outcome=refused cause=staging: ", w.error], "")
  }
  let body = join([
    "authorized-key-self-enroll host=", process_outcome_receipt_text(outcome: hostname),
    " user=", process_outcome_receipt_text(outcome: user), " ", outcome, "\n",
  ], "")
  let wr = Filesystem.Write(path: fleet_authorized_key_enroll_receipt_path, content: body)
  if wr.success {
    if string_contains(s: outcome, pattern: "refused") || string_contains(s: outcome, pattern: "ABSENT-after-apply") {
      exit_failure(reason: concat("fleet_authorized_key_self_enroll: ", body))
    } else {
      ExitSuccess
    }
  } else {
    exit_failure(reason: concat("fleet_authorized_key_self_enroll: receipt publication failed — ", wr.error))
  }
}

// Ruling msg_43a8fd77 item 3 (A2), CROSSED by the operator 2026-08-09 (parent
// msg_72e2dcee): the GCP side is PROVISIONED and these are the observed facts, not a
// request. The service account is WIF-only (no keys exist and none may ever be minted);
// its sole grant is secretmanager.secretAccessor on the one named secret. The secret
// already held the fleet key as version 1 (ENABLED, created 2026-07-21T21:16:13Z;
// payload fingerprint matches the enrolled public key's SHA256:mGT7qJsh36VsVb8OPh3m8b
// r3oHedQHxRukRkW5P0CoQ) — version 1 is BLESSED as-is, nothing was minted, and
// consumers PIN versions/1, never the moving `latest` alias (SECRET-VERSION-LIFECYCLE-0
// wall: evidence must name a version). An OBSERVED PRIOR grant to
// serviceAccount:fleet-automation@gunbai-secrets.iam.gserviceaccount.com (July-era)
// exists on the same secret — recorded here, deliberately untouched. Rotation of the
// key to a version 2 is a REGISTERED FOLLOW-UP through the rotation kernel, not this
// lane. Closure evidence for A2 = the first dispatched probe run that authenticates.
type ProbeIdentitySecretAccessRequirement {
  secret_project: String
  secret_name: String
  pinned_version: String
  service_account: String
  service_account_unique_id: String
  wif_principal_set: String
  wif_provider_resource: String
  access: String
  observed_prior_grant: String
  consumer_jobs: List<String>
  materialization: String
}

data probe_identity_secret_access_requirement: ProbeIdentitySecretAccessRequirement = ProbeIdentitySecretAccessRequirement {
  secret_project: fleet_automation_ssh_privkey_secret.project as String,
  secret_name: fleet_automation_ssh_privkey_secret.secret as String,
  pinned_version: fleet_automation_privkey_version_segment(),
  service_account: "fleet-cloud-convergence@gunbai-secrets.iam.gserviceaccount.com",
  service_account_unique_id: "115150029926436834504",
  wif_principal_set: "principalSet://iam.googleapis.com/projects/582015116396/locations/global/workloadIdentityPools/github-actions/attribute.repository/gunb-ai/gunbc",
  wif_provider_resource: "projects/582015116396/locations/global/workloadIdentityPools/github-actions/providers/github-oidc",
  access: "roles/secretmanager.secretAccessor on this one secret only; identity reached exclusively via GitHub OIDC -> WIF exchange (id-token: write on the consumer jobs) — the SA is WIF-only, no SA keys exist or may be minted",
  observed_prior_grant: "serviceAccount:fleet-automation@gunbai-secrets.iam.gserviceaccount.com holds secretAccessor on the same secret (July-era, pre-existing) — recorded, not modified",
  consumer_jobs: ["fleet"],
  materialization: "in-run only: versions/1 accessed per-run into RUNNER_TEMP, mode 0600, loaded into an ssh-agent and the file wiped before any probe executes; never durable HOME, never echoed; the agent is killed when the job ends; receipts carry the identity NAME and outcome only — no key bytes, no payload digests",
}
