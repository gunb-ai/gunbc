// THE GITHUB APP'S CONTROL PLANE, INSPECTED -- NOT CONVERGED. This module replaced
// gunbc.fleet.app_control_plane_converge, which called itself convergence while every GitHub call
// it made was a GET, and carried its own Converged/Diverged/Unobserved vocabulary.
// gunbc.host_convergence_census classified it RenameOutOfConvergence onto std.goal_assessment;
// this is that rename carried out as a REBIND. Two inspections, each composed only through
// inspect_goal: the App's REGISTRATION, then its WEBHOOK (configuration and delivery log).
//
// History of the subject (operator direction 2026-09-05: "get our github
// app into convergence, as well as to get it on webhooks"). gunbc.auth.github_apps has
// carried a full GitHubAppControlPlaneState machine since it landed, but every one of its
// observation producers was ObservationProducerAbsent, so control_plane_next_action could
// only ever answer BindObservationProducer. This module is that binding for gunbai-ci:
// the App's own registration and webhook configuration, read with an App JWT.
//
// WHAT THIS MODULE MAY NOT DECIDE YET. The webhook URL our App SHOULD point at is not
// declarable until a receiver exists to point it at. Declaring one now would be a desired
// state no observation could ever agree with, so the URL is OBSERVED AND REPORTED and its
// convergence is the typed dissolution row at the bottom of this file - never a fabricated
// literal standing in for a service that has not been built.

data app_control_plane_receipt_path: String = "target/app-control-plane-observation-receipt.txt"
data app_jwt_header_file_env_name: NonEmptyStr = "GUNBC_APP_JWT_HEADER_FILE"

// ---------------------------------------------------------------------------------------------
// Desired state - the parts decidable WITHOUT a receiver.
// ---------------------------------------------------------------------------------------------

// TLS verification off would let anything that can answer our DNS name deliver signed-looking
// traffic; it is never correct for a control plane and is not a per-environment preference.
data desired_hook_tls: GitHubAppHookTlsVerification = HookTlsVerified

// Our decoder reads JSON. `form` would arrive urlencoded and silently fail to decode.
data desired_hook_content_type: GitHubAppHookContentType = HookContentTypeJson

// An unset secret means unsigned deliveries: intake could not authenticate anything. Note
// this is a PRESENCE requirement and structurally cannot be a value comparison - GitHub
// masks the secret on readback (extdeps.github.app GitHubAppHookSecretReadback).
data desired_hook_secret: GitHubAppHookSecretReadback = HookSecretConfigured

// ---------------------------------------------------------------------------------------------
// Observation - typed by how it was seen.
// ---------------------------------------------------------------------------------------------

type HookConfigDecode
  = HookConfigDecoded { config: GitHubAppHookConfig }
  | HookConfigDecodeRefused { reason: NonEmptyStr }

fn json_member_string(v: JsonValue, key: String) -> NonEmptyStr? {
  match json_object_unique_member(v: v, key: key) {
    JsonMemberFound { value: JsonString { value } } =>
      if value == "" { none } else { Present { value: value as NonEmptyStr } }
    _ => none
  }
}

// THE OBSERVED URL IS PARSED, NEVER CONSTRUCTED. `uri_https(locator: url)` is a CONSTRUCTOR: it
// stamps scheme Https and keeps the locator verbatim, and `uri_wire` renders scheme ++ locator. So
// handing it GitHub's absolute URL produced a Uri that renders as `https://https://host/...`, and
// stamped Https onto an `http://` observation that was never https. The receipt hid the first by
// printing `.locator` directly; the typed value was wrong either way. A scheme-free locator is the
// Uri contract every other construction site in this repository honours.
type HookUrlDecode
  = HookUrlDecoded { url: Uri }
  | HookUrlRefused { reason: NonEmptyStr }

fn strip_scheme_prefix(raw: NonEmptyStr, scheme: UriScheme) -> String {
  let prefix_len = string_length(s: uri_scheme_wire(s: scheme) as String)
  substring(s: raw as String, start: prefix_len, end: string_length(s: raw as String))
}

// Only the two schemes a webhook delivery can actually use are admitted. A relative, unknown, or
// non-HTTP scheme is a refusal rather than a coerced Https, because the whole point of this axis is
// to report what IS configured.
fn decode_hook_url(raw: NonEmptyStr) -> HookUrlDecode {
  match parse_href_scheme(url: raw as String) {
    RelativeHref => HookUrlRefused {
      reason: concat("app hook config url is not absolute: ", raw as String) as NonEmptyStr
    }
    UnknownHref => HookUrlRefused {
      reason: concat("app hook config url carries no modeled scheme: ", raw as String) as NonEmptyStr
    }
    HrefScheme { scheme } => {
      let rest = strip_scheme_prefix(raw: raw, scheme: scheme)
      if rest == "" {
        HookUrlRefused {
          reason: concat("app hook config url carries a scheme and no authority: ", raw as String) as NonEmptyStr
        }
      } else {
        match scheme {
          Https => HookUrlDecoded { url: Uri { scheme: Https, locator: rest as NonEmptyStr } }
          Http => HookUrlDecoded { url: Uri { scheme: Http, locator: rest as NonEmptyStr } }
          _ => HookUrlRefused {
            reason: concat("app hook config url scheme is not http(s): ", raw as String) as NonEmptyStr
          }
        }
      }
    }
  }
}

// ---------------------------------------------------------------------------------------------
// R2: PRESENCE MUST ITSELF BE ESTABLISHED, NOT INFERRED FROM A KEY EXISTING.
//
// The first cut answered HookSecretConfigured for ANY member value, so `"secret": null`, `""`,
// `false`, an array or an object all read as configured -- and a DUPLICATED member collapsed to
// HookSecretAbsent, converting an ambiguous response into a confident negative. Presence being the
// only honest fact does not excuse failing to establish presence: this field is the one that
// decides whether deliveries are signed at all.
//
// GitHub returns the secret MASKED (a fixed asterisk run) when one is set and omits the member
// when none is. So a non-empty string is the configured representation, an absent member is
// established absence, and everything else -- null, empty, wrong type, duplicated -- refuses.
type HookSecretDecode
  = HookSecretDecoded { secret: GitHubAppHookSecretReadback }
  | HookSecretRefused { reason: NonEmptyStr }

fn decode_hook_secret(doc: JsonValue) -> HookSecretDecode {
  match json_object_unique_member(v: doc, key: "secret") {
    JsonMemberAbsent => HookSecretDecoded { secret: HookSecretAbsent }
    JsonMemberDuplicated { count: _ } => HookSecretRefused {
      reason: "app hook config secret member is duplicated, so the response is ambiguous rather than absent"
    }
    JsonMemberNotAnObject => HookSecretRefused {
      reason: "app hook config response is not a JSON object"
    }
    JsonMemberFound { value: JsonString { value } } =>
      if value == "" {
        HookSecretRefused { reason: "app hook config secret is an empty string, which is neither the masked configured form nor established absence" }
      } else {
        HookSecretDecoded { secret: HookSecretConfigured }
      }
    JsonMemberFound { value: JsonNull } => HookSecretRefused {
      reason: "app hook config secret is null, which GitHub does not use for either configured or absent"
    }
    JsonMemberFound { value: _ } => HookSecretRefused {
      reason: "app hook config secret is present with a non-string value"
    }
  }
}

fn decode_hook_config_json(body: String) -> HookConfigDecode {
  match parse_json_document(s: body) {
    JsonDocumentUnreadable { gap } => HookConfigDecodeRefused {
      reason: concat("app hook config response is ", json_document_gap_text(gap: gap)) as NonEmptyStr
    }
    JsonDocumentParsed { value: doc } => match json_member_string(v: doc, key: "url") {
      Absent => HookConfigDecodeRefused { reason: "app hook config carries no non-empty url" }
      Present { value: url } => match json_member_string(v: doc, key: "content_type") {
        Absent => HookConfigDecodeRefused { reason: "app hook config carries no non-empty content_type" }
        Present { value: ct_wire } => match hook_content_type_from_wire(name: ct_wire) {
          Absent => HookConfigDecodeRefused {
            reason: concat("app hook config content_type is not a modeled value: ", ct_wire as String) as NonEmptyStr
          }
          Present { value: content_type } => match json_member_string(v: doc, key: "insecure_ssl") {
            Absent => HookConfigDecodeRefused { reason: "app hook config carries no non-empty insecure_ssl" }
            Present { value: tls_wire } => match hook_tls_from_wire(value: tls_wire) {
              Absent => HookConfigDecodeRefused {
                reason: concat("app hook config insecure_ssl is not a modeled value: ", tls_wire as String) as NonEmptyStr
              }
              Present { value: tls } => match decode_hook_url(raw: url) {
                HookUrlRefused { reason } => HookConfigDecodeRefused { reason: reason }
                HookUrlDecoded { url: parsed } => match decode_hook_secret(doc: doc) {
                  HookSecretRefused { reason } => HookConfigDecodeRefused { reason: reason }
                  HookSecretDecoded { secret } => HookConfigDecoded {
                    config: GitHubAppHookConfig {
                      url: parsed,
                      content_type: content_type,
                      secret: secret,
                      tls: tls
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

// ---------------------------------------------------------------------------------------------
// R1: THE REGISTRATION READBACK, WHICH MUST ACTUALLY BE READ -- AND READ GOAL-BLIND.
//
// The first cut called GetAppRegistrationJson, checked only `.success`, and threw the body away,
// so a 200 from a JWT signed by ANY App produced a receipt labelled gunbai-ci.
//
// The repair of that took `expected: DeclaredGitHubApp` INTO THE DECODER and compared identities
// there, which filed a perfectly readable 200 describing ANOTHER App as a decode refusal. That is
// laundered non-observation: a KNOWN mismatch routed through the arm that means "nothing was
// learned". std.goal_assessment exists to make that route unwritable, and this module now takes it:
// the decoder has no goal-typed parameter, so it can only report which App answered, and the
// comparison with the App we MEANT happens in assess_registration, where a mismatch is GoalDiverged.
// A decode refusal now means only what it says -- the body could not be read.
type RegistrationReadRefusal
  = RegistrationReadRefused { stderr: String }
  | RegistrationUndecodable { reason: NonEmptyStr }

fn render_registration_read_refusal(cause: RegistrationReadRefusal) -> String {
  match cause {
    RegistrationReadRefused { stderr } => concat("AppRegistrationReadRefused: ", stderr)
    RegistrationUndecodable { reason } => concat("AppRegistrationUndecodable: ", reason as String)
  }
}

fn json_member_int(v: JsonValue, key: String) -> Int? {
  match json_object_unique_member(v: v, key: key) {
    JsonMemberFound { value: JsonNumber { lexeme } } => parse_int(s: lexeme as String)
    _ => none
  }
}

fn decode_permission_access(v: JsonValue) -> GitHubAppPermissionAccess? {
  match v {
    JsonString { value } =>
      if value == "read" { Present { value: AppAccessRead } }
      else if value == "write" { Present { value: AppAccessWrite } }
      else { none }
    _ => none
  }
}

// The permissions object is decoded per MEMBER rather than by enumerating the axes we care about:
// an axis this repository does not model must not silently vanish from the observation, because
// the assessment reads absence as "not requested".
fn decode_registration_permissions(doc: JsonValue) -> List<ObservedGitHubPermission>? {
  match json_object_unique_member(v: doc, key: "permissions") {
    JsonMemberAbsent => Present { value: [] }
    JsonMemberFound { value: JsonObject { members } } => {
      let decoded = map(members, m => match decode_permission_access(v: m.value) {
        Absent => none
        Present { value: access } => Present {
          value: ObservedGitHubPermission {
            name: ObservedGitHubPermissionName { wire_name: m.key as NonEmptyStr },
            access: access
          }
        }
      })
      if any(decoded, d => match d { Absent => true, Present { value: _ } => false }) {
        none
      } else {
        Present { value: flat_map(decoded, d => match d {
          Present { value } => [value]
          Absent => []
        }) }
      }
    }
    _ => none
  }
}

// A permission named twice is an ambiguous response, not a readable one: which access the App
// holds on that axis is undetermined, and picking the first would let the assessment answer over
// a value nobody established.
fn decode_registration_json(body: String) -> ObservationAttempt<ObservedAppRegistration, RegistrationReadRefusal> {
  match parse_json_document(s: body) {
    JsonDocumentUnreadable { gap } => ObservationRefused { cause: RegistrationUndecodable {
      reason: concat("app registration response is ", json_document_gap_text(gap: gap)) as NonEmptyStr
    } }
    JsonDocumentParsed { value: doc } => match json_member_int(v: doc, key: "id") {
      Absent => ObservationRefused { cause: RegistrationUndecodable { reason: "app registration response carries no integer id" } }
      Present { value: observed_id } => match decode_registration_permissions(doc: doc) {
        Absent => ObservationRefused { cause: RegistrationUndecodable {
          reason: "app registration permissions object carries a member whose access is not read or write"
        } }
        Present { value: perms } => match first_duplicated_observed_permission(perms: perms) {
          Present { value: dup } => ObservationRefused { cause: RegistrationUndecodable {
            reason: concat("app registration permissions name one axis twice: ", dup.wire_name as String) as NonEmptyStr
          } }
          Absent => ObservationEstablished { observed: AppRegistrationReadback {
            app_id: GitHubAppId { value: observed_id },
            requested_permissions: perms
          } }
        }
      }
    }
  }
}

type AppJwtReadRequest { jwt_header_file: String }

// The response-to-attempt step, apart from the effect so its refusal arm is reachable by a
// supplied value: a refused request (network, auth, a JWT GitHub rejects) never reaches the
// decoder, and an answered one never reaches the refusal arm on the transport's account.
fn registration_attempt_of_response(
  success: Bool,
  stdout: String,
  stderr: String,
) -> ObservationAttempt<ObservedAppRegistration, RegistrationReadRefusal> {
  if !success {
    ObservationRefused { cause: RegistrationReadRefused { stderr: stderr } }
  } else {
    decode_registration_json(body: stdout)
  }
}

fn observe_app_registration(
  app: NonEmptyStr,
  request: AppJwtReadRequest,
) -> ObservationAttempt<ObservedAppRegistration, RegistrationReadRefusal> {
  let response = github.CliAppRegistration.GetAppRegistrationJson(jwt_header_file: request.jwt_header_file)
  registration_attempt_of_response(success: response.success, stdout: response.stdout, stderr: response.stderr)
}

// THE REGISTRATION GOAL: which App we meant, and what it must be able to do. The permissions are
// DERIVED, not listed here: gunbai-ci's job is minting just-in-time runner configurations
// (gunbc.runner.runner_jit_mint performs GenerateOrganizationJitConfig), so its registration must
// request what extdeps.github.effect says that effect requires, plus the metadata baseline every
// installation credential carries (gunbc.auth.github_credential). A new gunbai-ci effect widens
// this goal by being added here as an effect, never as a hand-typed permission row.
type AppRegistrationGoal {
  app: DeclaredGitHubApp
  required_permissions: List<GitHubAppPermission>
}

data gunbai_ci_registration_goal: AppRegistrationGoal = AppRegistrationGoal {
  app: gunbai_ci_declared,
  required_permissions: concat(
    [app_installation_metadata_baseline],
    github_effect_required_permissions(effect: GenerateOrganizationJitConfig {
      organization: GitHubOrganizationRef { login: gunbai_ci_declared.owner_login }
    })
  ),
}

type RegistrationDeviation
  = RegistrationNamesAnotherApp { observed: GitHubAppId, expected: GitHubAppId }
  | RegistrationPermissionShort { required: GitHubAppPermission, held: GitHubAppPermissionAccess? }

type RegistrationUnknown
  = | RegistrationReadbackNotCarried

fn permission_deviations(required: List<GitHubAppPermission>, held: List<ObservedGitHubPermission>) -> List<RegistrationDeviation> {
  flat_map(required, r => match observed_access_for(perms: held, axis: r.name) {
    Absent => [RegistrationPermissionShort { required: r, held: none }]
    Present { value: access } =>
      if permission_access_at_least(held: access, requested: r.access) { [] } else {
        [RegistrationPermissionShort { required: r, held: Present { value: access } }]
      }
  })
}

// Identity is compared FIRST and, on mismatch, is the only deviation reported: the permissions
// observed belong to another App, so comparing them with this App's requirement would be a
// statement about nothing we asked.
fn assess_registration(
  goal: AppRegistrationGoal,
  observed: ObservedAppRegistration,
) -> GoalAssessment<GitHubAppId, RegistrationDeviation, RegistrationUnknown, Never> {
  match observed {
    AppRegistrationReadbackUnavailable => assess_by_deviations_and_unknowns(
      evidence: goal.app.app_id,
      deviations: [],
      unknowns: [RegistrationReadbackNotCarried],
    )
    AppRegistrationReadback { app_id, requested_permissions } =>
      if app_id.value != goal.app.app_id.value {
        assess_by_deviations(
          evidence: app_id,
          deviations: [RegistrationNamesAnotherApp { observed: app_id, expected: goal.app.app_id }],
        )
      } else {
        assess_by_deviations(
          evidence: app_id,
          deviations: permission_deviations(required: goal.required_permissions, held: requested_permissions),
        )
      }
  }
}

fn access_wire(a: GitHubAppPermissionAccess) -> String {
  match a {
    AppAccessRead => "read"
    AppAccessWrite => "write"
  }
}

fn held_access_wire(held: GitHubAppPermissionAccess?) -> String {
  match held {
    Absent => "none"
    Present { value: a } => access_wire(a: a)
  }
}

fn registration_deviation_text(d: RegistrationDeviation) -> String {
  match d {
    RegistrationNamesAnotherApp { observed, expected } =>
      join(["app_identity:observed=", to_string(observed.value), ",expected=", to_string(expected.value)], "")
    RegistrationPermissionShort { required, held } =>
      join([
        "permission:", permission_axis_wire_name(axis: required.name) as String,
        ":required=", access_wire(a: required.access),
        ",held=", held_access_wire(held: held)
      ], "")
  }
}

fn registration_unknown_text(u: RegistrationUnknown) -> String {
  match u {
    RegistrationReadbackNotCarried => "registration_readback_not_carried"
  }
}

fn registration_observed_app_id(r: ObservedAppRegistration) -> Int? {
  match r {
    AppRegistrationReadbackUnavailable => none
    AppRegistrationReadback { app_id, requested_permissions: _ } => Present { value: app_id.value }
  }
}

// ---------------------------------------------------------------------------------------------
// THE WEBHOOK: configuration, and whether the endpoint it names takes deliveries.
// ---------------------------------------------------------------------------------------------

// REACHABILITY, AND THE DEFECT THAT MADE IT NECESSARY.
//
// An earlier cut answered converged for a webhook whose endpoint DID NOT EXIST. Measured
// 2026-09-05 against the live App: the configured URL named a Cloud Run service
// (github-runner-autoscaler) that returns a Google frontend 404 byte-identical to a control URL
// for a service that never existed. TLS verification, content type and secret presence are
// CONFIGURATION properties, and configuration remains perfectly well-formed after the thing it
// points at is deleted.
//
// The repair is not a liveness probe of our own -- a probe must assume a path and a method the
// receiver never promised. GitHub already records the status code IT received for every delivery
// it made, so reachability is answered by the delivering party from its own log.
type HookDelivery {
  guid: NonEmptyStr
  event: NonEmptyStr
  status_code: Int
}

type DeliveryReadRefusal
  = DeliveriesReadRefused { stderr: String }
  | DeliveriesUndecodable { reason: NonEmptyStr }

fn decode_delivery(v: JsonValue) -> HookDelivery? {
  match json_member_string(v: v, key: "guid") {
    Absent => none
    Present { value: guid } => match json_member_string(v: v, key: "event") {
      Absent => none
      Present { value: event } => match json_member_int(v: v, key: "status_code") {
        Absent => none
        Present { value: code } => Present {
          value: HookDelivery { guid: guid, event: event, status_code: code }
        }
      }
    }
  }
}

fn decode_deliveries_json(body: String) -> ObservationAttempt<List<HookDelivery>, DeliveryReadRefusal> {
  match parse_json_document(s: body) {
    JsonDocumentUnreadable { gap } => ObservationRefused { cause: DeliveriesUndecodable {
      reason: concat("app hook deliveries response is ", json_document_gap_text(gap: gap)) as NonEmptyStr
    } }
    JsonDocumentParsed { value: JsonArray { elements } } => {
      let decoded = map(elements, e => decode_delivery(v: e))
      if any(decoded, d => match d { Absent => true, Present { value: _ } => false }) {
        ObservationRefused { cause: DeliveriesUndecodable {
          reason: "app hook deliveries contains an element without exact guid/event/status_code fields"
        } }
      } else {
        ObservationEstablished { observed: flat_map(decoded, d => match d {
          Present { value } => [value]
          Absent => []
        }) }
      }
    }
    JsonDocumentParsed { value: _ } => ObservationRefused { cause: DeliveriesUndecodable {
      reason: "app hook deliveries response is not a JSON array"
    } }
  }
}

// ONE SNAPSHOT, TWO READS. The configuration read is the snapshot's anchor: without it there is no
// webhook to speak of, so its failure refuses the whole observation. The delivery log is read after
// it and carried as its OWN attempt, because a configuration that was read is established whether
// or not its log could be -- and the assessment must then report the log as an UNKNOWN fact beside
// whatever configuration drift it proved, not suppress the one with the other.
type HookObserved {
  config: GitHubAppHookConfig
  deliveries: ObservationAttempt<List<HookDelivery>, DeliveryReadRefusal>
}

type HookConfigReadRefusal
  = HookConfigReadRefused { stderr: String }
  | HookConfigUndecodable { reason: NonEmptyStr }

fn render_hook_config_read_refusal(cause: HookConfigReadRefusal) -> String {
  match cause {
    HookConfigReadRefused { stderr } => concat("AppHookConfigReadRefused: ", stderr)
    HookConfigUndecodable { reason } => concat("AppHookConfigUndecodable: ", reason as String)
  }
}

fn observe_app_hook(app: NonEmptyStr, request: AppJwtReadRequest) -> ObservationAttempt<HookObserved, HookConfigReadRefusal> {
  let response = github.CliAppRegistration.GetAppHookConfigJson(jwt_header_file: request.jwt_header_file)
  if !response.success {
    ObservationRefused { cause: HookConfigReadRefused { stderr: response.stderr } }
  } else {
    match decode_hook_config_json(body: response.stdout) {
      HookConfigDecodeRefused { reason } => ObservationRefused { cause: HookConfigUndecodable { reason: reason } }
      HookConfigDecoded { config } => {
        let deliveries_response = github.CliAppRegistration.GetAppHookDeliveriesJson(jwt_header_file: request.jwt_header_file)
        ObservationEstablished { observed: HookObserved {
          config: config,
          deliveries: if !deliveries_response.success {
            ObservationRefused { cause: DeliveriesReadRefused { stderr: deliveries_response.stderr } }
          } else {
            decode_deliveries_json(body: deliveries_response.stdout)
          },
        } }
      }
    }
  }
}

// The decidable parts of the desired hook, WITHOUT a receiver. The URL is not among them: see
// app_hook_url_converge_trigger.
type AppHookGoal {
  tls: GitHubAppHookTlsVerification
  content_type: GitHubAppHookContentType
  secret: GitHubAppHookSecretReadback
}

data gunbai_ci_hook_goal: AppHookGoal = AppHookGoal {
  tls: desired_hook_tls,
  content_type: desired_hook_content_type,
  secret: desired_hook_secret,
}

type HookDeviation
  = HookTlsDiverges { observed: GitHubAppHookTlsVerification, desired: GitHubAppHookTlsVerification }
  | HookContentTypeDiverges { observed: GitHubAppHookContentType, desired: GitHubAppHookContentType }
  | HookSecretDiverges { observed: GitHubAppHookSecretReadback, desired: GitHubAppHookSecretReadback }
  | HookDeliveriesRejected { failing: Int, sampled: Int }

// THE TWO WAYS REACHABILITY GOES UNESTABLISHED, KEPT APART. The shape this replaced filed both
// under one DeliveriesUnobserved string, merging "the log could not be read" with "the log was read
// and holds nothing". They have different owners: the first is an access or contract fault here,
// the second is a true observation that nobody has exercised the webhook inside GitHub's retention
// window -- and an empty window must never read as healthy, because that is exactly the state of a
// webhook pointing at nothing that nobody triggers.
type HookUnknown
  = DeliveryLogUnread { cause: DeliveryReadRefusal }
  | DeliveryWindowEmpty

fn hook_secret_eq(a: GitHubAppHookSecretReadback, b: GitHubAppHookSecretReadback) -> Bool {
  match a {
    HookSecretConfigured => match b { HookSecretConfigured => true, HookSecretAbsent => false }
    HookSecretAbsent => match b { HookSecretConfigured => false, HookSecretAbsent => true }
  }
}

fn hook_config_deviations(goal: AppHookGoal, config: GitHubAppHookConfig) -> List<HookDeviation> {
  concat(
    concat(
      if hook_tls_eq(a: config.tls, b: goal.tls) { [] } else {
        [HookTlsDiverges { observed: config.tls, desired: goal.tls }]
      },
      if hook_content_type_eq(a: config.content_type, b: goal.content_type) { [] } else {
        [HookContentTypeDiverges { observed: config.content_type, desired: goal.content_type }]
      }
    ),
    if hook_secret_eq(a: config.secret, b: goal.secret) { [] } else {
      [HookSecretDiverges { observed: config.secret, desired: goal.secret }]
    }
  )
}

fn delivery_accepted(d: HookDelivery) -> Bool {
  d.status_code >= 200 && d.status_code < 300
}

fn delivery_deviations(deliveries: ObservationAttempt<List<HookDelivery>, DeliveryReadRefusal>) -> List<HookDeviation> {
  match deliveries {
    ObservationRefused { cause: _ } => []
    ObservationEstablished { observed } => {
      let failing = count(filter(observed, d => !delivery_accepted(d: d)))
      if failing == 0 { [] } else { [HookDeliveriesRejected { failing: failing, sampled: count(observed) }] }
    }
  }
}

fn delivery_unknowns(deliveries: ObservationAttempt<List<HookDelivery>, DeliveryReadRefusal>) -> List<HookUnknown> {
  match deliveries {
    ObservationRefused { cause } => [DeliveryLogUnread { cause: cause }]
    ObservationEstablished { observed } => if count(observed) == 0 { [DeliveryWindowEmpty] } else { [] }
  }
}

// Evidence of a satisfied hook is the number of deliveries the endpoint accepted: satisfaction is
// unreachable with zero, because an empty window is an unknown.
fn assess_app_hook(goal: AppHookGoal, observed: HookObserved) -> GoalAssessment<Int, HookDeviation, HookUnknown, Never> {
  assess_by_deviations_and_unknowns(
    evidence: match observed.deliveries {
      ObservationEstablished { observed: ds } => count(ds)
      ObservationRefused { cause: _ } => 0
    },
    deviations: concat(hook_config_deviations(goal: goal, config: observed.config), delivery_deviations(deliveries: observed.deliveries)),
    unknowns: delivery_unknowns(deliveries: observed.deliveries),
  )
}

fn hook_deviation_text(d: HookDeviation) -> String {
  match d {
    HookTlsDiverges { observed: _, desired: _ } => "hook_tls_verification"
    HookContentTypeDiverges { observed: _, desired: _ } => "hook_content_type"
    HookSecretDiverges { observed: _, desired: _ } => "hook_secret_presence"
    HookDeliveriesRejected { failing, sampled } =>
      join(["deliveries_rejected:", to_string(failing), "/", to_string(sampled)], "")
  }
}

fn delivery_read_refusal_text(cause: DeliveryReadRefusal) -> String {
  match cause {
    DeliveriesReadRefused { stderr } => concat("delivery log read refused: ", stderr)
    DeliveriesUndecodable { reason } => concat("delivery log undecodable: ", reason as String)
  }
}

fn hook_unknown_text(u: HookUnknown) -> String {
  match u {
    DeliveryLogUnread { cause } => concat("delivery_log_unread: ", delivery_read_refusal_text(cause: cause))
    DeliveryWindowEmpty => "delivery_window_empty: the upstream delivery window holds no deliveries for this App, so reachability is unestablished rather than healthy"
  }
}

// ---------------------------------------------------------------------------------------------
// R4: THE RECEIPT CARRIES THE OBSERVATIONS THE VERDICT IS COMPUTED FROM.
//
// An earlier cut recorded app, app_id, endpoint, hook_url and observed_at -- none of which are the
// axes the verdict consults, so a satisfied run and one refused for disabled TLS verification
// produced IDENTICAL receipt bytes. Every axis that decides the verdict is serialized here, both
// sides of it, and so is the verdict itself.
// ---------------------------------------------------------------------------------------------
fn hook_secret_wire(s: GitHubAppHookSecretReadback) -> String {
  match s {
    HookSecretConfigured => "configured"
    HookSecretAbsent => "absent"
  }
}

fn hook_assessment_wire(a: GoalAssessment<Int, HookDeviation, HookUnknown, Never>) -> String {
  match a {
    GoalSatisfied { evidence: _ } => "satisfied"
    GoalDiverged { deviations } =>
      join(["diverged:", join(map(non_empty_to_list(xs: deviations), d => hook_deviation_text(d: d)), ",")], "")
    GoalIndeterminate { known_deviations, unknowns } =>
      join([
        "indeterminate:known=", join(map(known_deviations, d => hook_deviation_text(d: d)), ","),
        ";unknown=", join(map(non_empty_to_list(xs: unknowns), u => hook_unknown_text(u: u)), ",")
      ], "")
    GoalAssessmentRefused { cause: _ } => "assessment_refused"
  }
}

fn deliveries_wire(deliveries: ObservationAttempt<List<HookDelivery>, DeliveryReadRefusal>) -> String {
  match deliveries {
    ObservationRefused { cause: _ } => "unread"
    ObservationEstablished { observed } =>
      if count(observed) == 0 { "empty_window" } else {
        join([
          "accepted:", to_string(count(filter(observed, d => delivery_accepted(d: d)))),
          "/", to_string(count(observed))
        ], "")
      }
  }
}

fn optional_int_wire(v: Int?) -> String {
  match v {
    Absent => "unavailable"
    Present { value } => to_string(value)
  }
}

fn app_control_plane_receipt_text(
  registration: ObservedAppRegistration,
  hook: HookObserved,
  assessment: GoalAssessment<Int, HookDeviation, HookUnknown, Never>,
  observed_on: NonEmptyStr
) -> String {
  join([
    "app=", gunbai_ci_declared.slug as String,
    " declared_app_id=", to_string(gunbai_ci_declared.app_id.value),
    " observed_app_id=", optional_int_wire(v: registration_observed_app_id(r: registration)),
    " endpoint=GET-/app/hook/config",
    " hook_url_scheme=", uri_scheme_wire(s: hook.config.url.scheme) as String,
    " hook_url=", hook.config.url.locator as String,
    " observed_content_type=", hook_content_type_wire_name(t: hook.config.content_type) as String,
    " desired_content_type=", hook_content_type_wire_name(t: gunbai_ci_hook_goal.content_type) as String,
    " observed_insecure_ssl=", hook_tls_wire_name(t: hook.config.tls) as String,
    " desired_insecure_ssl=", hook_tls_wire_name(t: gunbai_ci_hook_goal.tls) as String,
    " observed_secret=", hook_secret_wire(s: hook.config.secret),
    " desired_secret=", hook_secret_wire(s: gunbai_ci_hook_goal.secret),
    " standing=", hook_assessment_wire(a: assessment),
    " deliveries=", deliveries_wire(deliveries: hook.deliveries),
    " observed_at=", observed_on as String, "\n"
  ], "")
}

// ---------------------------------------------------------------------------------------------
// The CLI edge.
// ---------------------------------------------------------------------------------------------

type RegistrationInspection = GoalInspection<NonEmptyStr, AppRegistrationGoal, AppJwtReadRequest, ObservedAppRegistration, GitHubAppId, RegistrationDeviation, RegistrationUnknown, RegistrationReadRefusal, Never>

type HookInspection = GoalInspection<NonEmptyStr, AppHookGoal, AppJwtReadRequest, HookObserved, Int, HookDeviation, HookUnknown, HookConfigReadRefusal, Never>

fn registration_assessment_wire(a: GoalAssessment<GitHubAppId, RegistrationDeviation, RegistrationUnknown, Never>) -> String {
  match a {
    GoalSatisfied { evidence: _ } => "satisfied"
    GoalDiverged { deviations } =>
      join(["diverged:", join(map(non_empty_to_list(xs: deviations), d => registration_deviation_text(d: d)), ",")], "")
    GoalIndeterminate { known_deviations, unknowns } =>
      join([
        "indeterminate:known=", join(map(known_deviations, d => registration_deviation_text(d: d)), ","),
        ";unknown=", join(map(non_empty_to_list(xs: unknowns), u => registration_unknown_text(u: u)), ",")
      ], "")
    GoalAssessmentRefused { cause: _ } => "assessment_refused"
  }
}

// The JWT's absence is refused before either join: without it no request can be formed, which is
// not an observation of the App. The registration is inspected first and the webhook is read ONLY
// when it is satisfied: a JWT that authenticates as another App would attribute that App's webhook
// to gunbai-ci, and a registration short of its permissions is already a refusal whose remedy is
// on the App's settings page, not its webhook. Every verdict below is inspect_goal's; ProcessExit
// is only its projection onto a process status, as in gunbc.ensure.
fn app_control_plane_inspect_wet() -> ProcessExit {
  let header_file = shell.Env.Get(name: app_jwt_header_file_env_name)
  match header_file.value {
    Absent => exit_failure(reason: "AppJwtHeaderFileMissing: GUNBC_APP_JWT_HEADER_FILE is absent -- GET /app and GET /app/hook/config authenticate as the APP and an installation access token reaches neither. The fleet-converge step mints a short-lived App JWT in-run from the gunbai-ci key (gunbc.ci_spec gunbc_ci_app_jwt_prelude); outside that step there is no credential to read")
    Present { value: jwt_header_file } => {
      let request = AppJwtReadRequest { jwt_header_file: jwt_header_file }
      let registration: RegistrationInspection = inspect_goal(
        subject: gunbai_ci_declared.slug,
        goal: gunbai_ci_registration_goal,
        request: request,
        observe: observe_app_registration,
        assess: assess_registration,
      )
      match registration {
        GoalObservationRefused { subject: _, goal: _, request: _, cause } =>
          exit_failure(reason: render_registration_read_refusal(cause: cause))
        GoalInspected { subject: _, goal: _, request: _, observed: observed_registration, assessment: GoalSatisfied { evidence: _ } } => {
          let hook: HookInspection = inspect_goal(
            subject: gunbai_ci_declared.slug,
            goal: gunbai_ci_hook_goal,
            request: request,
            observe: observe_app_hook,
            assess: assess_app_hook,
          )
          match hook {
            GoalObservationRefused { subject: _, goal: _, request: _, cause } =>
              exit_failure(reason: render_hook_config_read_refusal(cause: cause))
            GoalInspected { subject: _, goal: _, request: _, observed, assessment } => {
              let receipt = app_control_plane_receipt_text(
                registration: observed_registration,
                hook: observed,
                assessment: assessment,
                observed_on: clock_now_probed_at_or_unknown()
              )
              let wrote = Filesystem.Write(path: app_control_plane_receipt_path, content: receipt)
              if !wrote.success {
                exit_failure(reason: concat("AppControlPlaneReceiptWriteRefused: ", wrote.error))
              } else {
                match assessment {
                  GoalSatisfied { evidence: _ } => ExitSuccess
                  GoalDiverged { deviations: _ } =>
                    exit_failure(reason: concat("AppHookDiverged ", hook_assessment_wire(a: assessment)))
                  GoalIndeterminate { known_deviations: _, unknowns: _ } =>
                    exit_failure(reason: concat("AppHookIndeterminate ", hook_assessment_wire(a: assessment)))
                  GoalAssessmentRefused { cause: _ } =>
                    exit_failure(reason: "AppHookAssessmentRefused: unreachable for this binding, whose AssessRefusal is Never")
                }
              }
            }
          }
        }
        GoalInspected { subject: _, goal: _, request: _, observed: _, assessment } =>
          exit_failure(reason: concat("AppRegistration ", registration_assessment_wire(a: assessment)))
      }
    }
  }
}

// The webhook URL is observed and reported, never assessed, because no receiver exists to point it
// at. THE LOCK THIS PHASE DOES NOT YET NEED, recorded against the trigger that will need it: the
// fleet-converge job serializes on fleet_host_mutation_concurrency_group_expression, which keys the
// EXECUTOR HOST, not the resource. That is harmless while every operation here is a GET and stops
// being harmless the instant a PATCH exists.
data app_hook_url_converge_trigger: DissolutionCondition = unbound_dissolution(
  description: "dissolve-on: a webhook receiver exists as a converged fleet service with a declared address, at which point AppHookGoal gains a URL axis and a separate write authority may apply it and read it back through assess_app_hook. Until then the URL is carried in the receipt for a human to read and this module assesses only the axes it can decide without a receiver: TLS verification, content type, secret presence and delivery acceptance. Write authority additionally requires a concurrency group keyed by App identity rather than by executor host, because a PATCH from two concurrently dispatched runs would interleave where the current GETs cannot."
)
