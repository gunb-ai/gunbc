module gunbc.fleet_scp

import std.types { Bool, Int, List, NonEmptyStr, String }
import extdeps.ssh.scp { shape_scp_operands, scp_remote_operand, scp_copy_portable_words, ScpCopyResult }
import gunbc.fleet_known_hosts_anchor {
  FleetSshExecutionContext, FleetSshAttemptIdentity, SshTarget, PortableRemoteWord, portable_remote_word, fleet_ssh_key_session_client_words,
}
import gunbc.fleet_bootstrap_principal_session {
  FleetSshPrincipalSession, FleetSshKeySession, FleetSshPasswordSession, fleet_ssh_session_for_principal,
}

// A FILE COPY TO OR FROM A FLEET HOST, UNDER THE SAME TRUST AND CREDENTIAL AS THE EXEC LEG IT PAIRS WITH.
//
// Payload bytes cross by scp(1), never through a remote shell word or a stdin-fed write, and the client
// options are gunbc.fleet_known_hosts_anchor fleet_ssh_key_session_client_words over the sealed
// context - one derivation for exec and copy, so a copy cannot pin a different known_hosts anchor or
// offer a different key than the exec that later reads the bytes back.
//
// ONLY THE KEY SESSION COPIES. The bootstrap principal authenticates by password and is the
// administrator's first-contact leg; moving payload bytes as that account is not a route this module
// offers, so it refuses before any process runs rather than falling back to the password transport.
//
// A COPY THAT RAN IS NOT A COPY THAT ARRIVED. The outcome distinguishes a copy never attempted, a copy
// whose client exited zero, and a copy whose client failed - and the middle arm is named for what it is,
// the client's report. It carries the exact target and the attempt identity of the context it ran under,
// so a consumer can bind what it reads next to the leg that produced it. Whether the far side holds the intended bytes is decided only by a digest taken
// there, never by this exit status.
//
// PATHS ARE ADMITTED, NOT QUOTED. The remote path is read by the far side (a shell under the legacy
// protocol, the SFTP server under the default one), so it must be an absolute portable remote word; the
// local path is argv to a local process with no shell, but scp reads a colon before any slash as a host,
// so it must be absolute. The endpoint must not contain a colon, which scp would split as host:path.

type FleetScpDirection
  = FleetScpCopyTo
  | FleetScpCopyFrom

type FleetScpLocalPath sole_constructor {
  value: NonEmptyStr
}

type FleetScpRemotePath sole_constructor {
  word: PortableRemoteWord
}

type FleetScpCopyOutcome
  = FleetScpCopyNotAttempted { cause: NonEmptyStr }
  | FleetScpCopyRanAndReportedSuccess { direction: FleetScpDirection, target: SshTarget, attempt: FleetSshAttemptIdentity, local: FleetScpLocalPath, remote: FleetScpRemotePath }
  | FleetScpCopyRanAndFailed { direction: FleetScpDirection, exit_code: Int, stderr: String }

fn fleet_scp_local_path(raw: String) -> FleetScpLocalPath? {
  if starts_with(raw, "/") && !contains(raw, "\n") {
    Present { value: FleetScpLocalPath { value: raw as NonEmptyStr } }
  } else {
    none
  }
}

fn fleet_scp_remote_path(raw: String) -> FleetScpRemotePath? {
  if !starts_with(raw, "/") {
    none
  } else {
    match portable_remote_word(raw: raw) {
      Present { value: w } => Present { value: FleetScpRemotePath { word: w } }
      Absent => none
    }
  }
}

fn fleet_scp_operands(target: SshTarget, direction: FleetScpDirection, local: FleetScpLocalPath, remote: FleetScpRemotePath) -> List<String> {
  let far = scp_remote_operand(host: target.endpoint, path: remote.word.value)
  match direction {
    FleetScpCopyTo => shape_scp_operands(source: local.value as String, target: far)
    FleetScpCopyFrom => shape_scp_operands(source: far, target: local.value as String)
  }
}

fn shape_fleet_scp_copy(
  context: FleetSshExecutionContext,
  target: SshTarget,
  direction: FleetScpDirection,
  local: FleetScpLocalPath,
  remote: FleetScpRemotePath,
) -> List<String> {
  concat(
    fleet_ssh_key_session_client_words(context: context, target: target),
    fleet_scp_operands(target: target, direction: direction, local: local, remote: remote),
  )
}

// PURE: whether a copy may be attempted at all, before any process runs.
fn fleet_scp_refusal(target: SshTarget) -> NonEmptyStr? {
  match fleet_ssh_session_for_principal(principal: target.principal) {
    FleetSshPasswordSession => Present {
      value: join(["the copy was NOT attempted: ", target.principal as String, " authenticates by password, and payload bytes move only over the key session"], "") as NonEmptyStr,
    }
    FleetSshKeySession =>
      if contains(target.endpoint as String, ":") {
        Present { value: join(["the copy was NOT attempted: endpoint ", target.endpoint as String, " contains a colon, which scp reads as host:path"], "") as NonEmptyStr }
      } else {
        none
      }
  }
}

fn fleet_scp_copy_outcome(direction: FleetScpDirection, target: SshTarget, attempt: FleetSshAttemptIdentity, local: FleetScpLocalPath, remote: FleetScpRemotePath, result: ScpCopyResult) -> FleetScpCopyOutcome {
  if result.success && result.exit_code == 0 {
    FleetScpCopyRanAndReportedSuccess { direction: direction, target: target, attempt: attempt, local: local, remote: remote }
  } else {
    FleetScpCopyRanAndFailed { direction: direction, exit_code: result.exit_code, stderr: result.stderr }
  }
}

fn fleet_scp_copy(
  context: FleetSshExecutionContext,
  target: SshTarget,
  direction: FleetScpDirection,
  local: String,
  remote: String,
) -> FleetScpCopyOutcome {
  match fleet_scp_refusal(target: target) {
    Present { value: cause } => FleetScpCopyNotAttempted { cause: cause }
    Absent => match fleet_scp_local_path(raw: local) {
      Absent => FleetScpCopyNotAttempted { cause: join(["the copy was NOT attempted: local path '", local, "' is not absolute"], "") as NonEmptyStr }
      Present { value: l } => match fleet_scp_remote_path(raw: remote) {
        Absent => FleetScpCopyNotAttempted { cause: join(["the copy was NOT attempted: remote path '", remote, "' is not an absolute portable remote word"], "") as NonEmptyStr }
        Present { value: r } => fleet_scp_copy_outcome(
          direction: direction, target: target, attempt: context.attempt, local: l, remote: r,
          result: scp_copy_portable_words(client_args: shape_fleet_scp_copy(context: context, target: target, direction: direction, local: l, remote: r)),
        )
      }
    }
  }
}
