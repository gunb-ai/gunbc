module gunbc.fleet.fleet_host_power

import std.types { NonEmptyStr, Bool, Int, List }
import std.measure { Watt, watt, watt_count }
import std.dissolution { DissolutionCondition, unbound_dissolution }
import product.placement_supply { PhysicalAssetIdentity }
import gunbc.fleet.fleet_host_assembly {
  srv1_assembly_as_measured, srv2_assembly_as_measured, srv3_assembly_as_measured, srv4_assembly_as_measured,
}

// WHAT A FLEET HOST DRAWS, AND HOW WE KNOW IT.
//
// This is the power half of the marginal cost of running work on owned hardware: the money half is
// extdeps.energy.con_edison, and neither is useful without the other. It is a gunbc fact rather
// than an extdeps one because it is an OBSERVATION THIS REPOSITORY MADE about hosts it operates --
// gunbc.design_argument::single_authority's external-decomposition rule puts observations in the observing layer, never
// authored back into the upstream module as a property of the hardware. The Ampere part's rated
// TDP belongs to extdeps.cpu.ampere; what our srv1 actually pulled at a moment does not.

// PROVENANCE IS PART OF THE FIGURE, NOT METADATA BESIDE IT.
//
// Only srv1 is reachable from this session: srv2 refuses the operator key, and the fleet key
// authenticates as ghrunner on srv3/srv4 but that account is nologin, so no reading can be taken
// there. The operator's direction was to carry srv1's figure across the fleet on the grounds that
// the builds are alike, which is a reasonable engineering call and is followed here -- but a
// measurement and an inference from similarity are different epistemic objects, and flattening
// them would let three unmeasured hosts report as measured. A consumer that must not price work on
// an inferred figure can then still refuse, and the roster shows exactly which hosts to measure
// when access exists.
// WHAT CHANGED ON 2026-11-24, AND WHAT THE PARAGRAPH ABOVE NO LONGER MEANS UNQUALIFIED.
//
// The paragraph above was true of the session that wrote it: this repository's key authenticates as
// ghrunner on srv3/srv4 and that account is nologin, so from here no reading could be taken. On
// 2026-11-24 a pass that did have a shell-capable path read both hosts over ssh and brought back CPU
// power from the same apm_xgene sensor, so srv3 and srv4 are no longer carried on srv1's similarity: their
// rows are MeasuredOnHost now, and they carry the CAPPED operating point the fleet runs at rather than
// srv1's 2026-09 uncapped one. srv2 still refuses the key and stays inferred, which is what
// per_host_measurement_trigger now exists for. Two consequences a consumer should see coming: the roster is
// no longer one operating point read four ways (cpu_ceiling_mhz says which point each figure is), and the
// srv3/srv4 figures are single readings taken while the hosts were serving -- their bands are held beside
// the figure in cpu_power_cap_readings, not smoothed into it, because averaging two single readings of
// differing load would manufacture a precision the instrument never produced
// (gunbc.design_argument::epistemic_humility).
//
type PowerProvenance
  = MeasuredOnHost {
      sample_count: Int
      sensor: NonEmptyStr
      observed_on: NonEmptyStr
    }
  | InferredFromSimilarBuild {
      basis_host: NonEmptyStr
      basis_reason: NonEmptyStr
    }

type HostPowerProfile {
  host: NonEmptyStr
  draw: Watt
  // THE CLOCK CEILING THE HOST WAS RUNNING UNDER WHEN THE FIGURE WAS TAKEN, in MHz of scaling_max_freq. It
  // belongs in the figure and not in a comment because 94 W at a 3.0 GHz ceiling and 31 W at a 2.0 GHz
  // ceiling are not two measurements of one quantity: they are two different machines' habits, and a
  // consumer comparing them without the ceiling would be pricing work on a difference in configuration.
  // Nothing installed the ceilings this field reports -- gunbc.fleet.cpu_frequency_cap_boot_state is the
  // authority on the mechanism, and this row only says what was true of the host at the read.
  cpu_ceiling_mhz: Nat
  provenance: PowerProvenance
  // THE CONFIGURATION THIS FIGURE APPLIES TO: the physical units installed in the host when the figure was
  // taken, named by the single-authority unit identities the assembly module enumerates (it declares them in
  // srv1_assembly_as_measured and its siblings) rather than minting new names. gunbc.fleet.fleet_work_energy_cost
  // joins it against the host's CURRENT installed components (gunbc.fleet.fleet_host_assembly
  // host_installed_components) and REFUSES a reading that no longer matches, so a host rebuilt around
  // different units is never priced on a figure of some other build. A configured power ceiling is never a
  // substitute for a measured draw.
  applies_to: List<PhysicalAssetIdentity>
}

// THE OPERATING POINT IS PART OF THE OBSERVATION AND IS NOT A DUTY-CYCLE AVERAGE.
//
// srv1 read 100/93/95/94/89 W across five samples two seconds apart while its one-minute load
// average was 42.77 on 128 cores -- roughly a third of the machine busy. That is a MODERATELY
// LOADED operating point, not idle and not saturated, so the mean below bounds neither end. A true
// marginal figure is the DIFFERENCE between loaded and idle draw, which needs an idle reading this
// session could not take without quiescing a host that is serving production CI.
data srv1_observed_draw_note: NonEmptyStr = "Five samples at two-second intervals on srv1, 2026-09-05, from /sys/class/hwmon/hwmon1 power1_input + power2_input (sensor apm_xgene): 100, 93, 95, 94, 89 W, mean 94 W, taken while the one-minute load average was 42.77 across 128 cores. This is a single loaded operating point, NOT an idle-to-peak envelope and NOT a duty-cycle average."

data srv1_power: HostPowerProfile = HostPowerProfile {
  host: "srv1",
  draw: watt(count: 94),
  cpu_ceiling_mhz: 3000,
  provenance: MeasuredOnHost {
    sample_count: 5,
    sensor: "hwmon apm_xgene power1_input + power2_input",
    observed_on: "2026-09-05",
  },
  applies_to: srv1_assembly_as_measured,
}

data similar_build_basis: NonEmptyStr = "same asrock_altrad8ud_1l2t baseboard catalog as srv1 in gunbc.fleet.fleet_intent, same Ampere Altra class part; operator direction 2026-09-05 to carry srv1's figure across the fleet pending per-host access"

data srv2_power: HostPowerProfile = HostPowerProfile {
  host: "srv2",
  draw: watt(count: 94),
  // Inherited from srv1's 2026-09 read, which was taken BEFORE the fleet-wide 2.0 GHz cap of 2026-11-24 was
  // installed -- and srv2 runs that cap today (same two files, same digest, on all four Altra hosts). So this
  // row is an inference from an operating point its own host no longer has, the stalest figure in the roster,
  // and the reason per_host_measurement_trigger is still bound.
  cpu_ceiling_mhz: 3000,
  provenance: InferredFromSimilarBuild { basis_host: "srv1", basis_reason: similar_build_basis },
  applies_to: srv2_assembly_as_measured,
}

data srv3_power: HostPowerProfile = HostPowerProfile {
  host: "srv3",
  // The upper end of the 29-31 W band, so a consumer pricing work on it cannot under-price. The band and the
  // 3.0 GHz figure it came down from are the rows below, with the instrument each was read by.
  draw: watt(count: 31),
  cpu_ceiling_mhz: 2000,
  provenance: MeasuredOnHost {
    sample_count: 2,
    sensor: "hwmon apm_xgene \"CPU power\" over ssh; single readings, not averages",
    observed_on: "2026-11-24 ~09:3x UTC under serving load, CPU capped at 2.0 GHz; band 29-31 W",
  },
  applies_to: srv3_assembly_as_measured,
}

data srv4_power: HostPowerProfile = HostPowerProfile {
  host: "srv4",
  // The upper end of the 39-42 W band, for the same reason srv3 carries its upper end.
  draw: watt(count: 42),
  cpu_ceiling_mhz: 2000,
  provenance: MeasuredOnHost {
    sample_count: 2,
    sensor: "hwmon apm_xgene \"CPU power\" over ssh; single readings, not averages",
    observed_on: "2026-11-24 ~09:3x UTC under serving load, CPU capped at 2.0 GHz; band 39-42 W",
  },
  applies_to: srv4_assembly_as_measured,
}

// THE PAIRED READINGS BEHIND THOSE TWO FIGURES. A profile row holds one wattage, and the fact the pass
// produced was a pair -- a host's draw at its full 3.0 GHz ceiling and its draw at the 2.0 GHz cap the
// operator installed that morning, both read once on the apm_xgene "CPU power" input over ssh. Holding the
// pair rather than only the survivor is what lets the drop be stated at all, and stating it honestly needs
// the bias named: the load also changed between the two reads, so the arithmetic below is an UPPER bound on
// what the cap saves, not the saving. srv1 and srv2 have no rows here because their 3.0 GHz reads predate
// the cap by nearly three months and were never repeated.
type CpuPowerCapReading {
  host: NonEmptyStr
  ceiling_mhz: Nat
  low_watts: Watt
  high_watts: Watt
  instrument: NonEmptyStr
  read_on: NonEmptyStr
}

data cpu_power_cap_readings: List<CpuPowerCapReading> = [
  CpuPowerCapReading {
    host: "srv3", ceiling_mhz: 3000, low_watts: watt(count: 65), high_watts: watt(count: 65),
    instrument: "hwmon apm_xgene \"CPU power\" read over ssh; a single reading, not an average",
    read_on: "2026-11-24 ~09:3x UTC, before the CPU cap was applied that morning",
  },
  CpuPowerCapReading {
    host: "srv3", ceiling_mhz: 2000, low_watts: watt(count: 29), high_watts: watt(count: 31),
    instrument: "hwmon apm_xgene \"CPU power\" read over ssh; single readings bracketing the band, not averages",
    read_on: "2026-11-24 ~09:3x UTC, under serving load with scaling_max_freq read back at 2000000 kHz",
  },
  CpuPowerCapReading {
    host: "srv4", ceiling_mhz: 3000, low_watts: watt(count: 101), high_watts: watt(count: 101),
    instrument: "hwmon apm_xgene \"CPU power\" read over ssh; a single reading, not an average",
    read_on: "2026-11-24 ~09:3x UTC, before the CPU cap was applied that morning",
  },
  CpuPowerCapReading {
    host: "srv4", ceiling_mhz: 2000, low_watts: watt(count: 39), high_watts: watt(count: 42),
    instrument: "hwmon apm_xgene \"CPU power\" read over ssh; single readings bracketing the band, not averages",
    read_on: "2026-11-24 ~09:3x UTC, under serving load with scaling_max_freq read back at 2000000 kHz",
  },
]

// THE UPPER BOUND ON WHAT THE 2.0 GHz CAP SAVED, per host: the lowest uncapped reading minus the highest
// capped one. Deliberately the least favourable subtraction available -- the load differed between the two
// reads and a lighter load at the capped point flatters the cap, so the true saving is somewhat smaller than
// this. A consumer that wants the difference quoted as a fact instead of a bound should ask for the paired
// idle-to-loaded reading the trigger below names, which nobody has been able to take on a host that serves.
fn reported_saving_upper_bound(host: NonEmptyStr) -> Watt? {
  let uncapped = filter(cpu_power_cap_readings, r => r.host == host && r.ceiling_mhz == 3000).first()
  let capped = filter(cpu_power_cap_readings, r => r.host == host && r.ceiling_mhz == 2000).first()
  match uncapped {
    Absent => Absent
    Present { value: u } => match capped {
      Absent => Absent
      Present { value: c } =>
        if watt_count(w: u.low_watts) > watt_count(w: c.high_watts) {
          Present { value: watt(count: watt_count(w: u.low_watts) - watt_count(w: c.high_watts)) }
        } else {
          Absent
        }
    }
  }
}

data fleet_host_power_roster: List<HostPowerProfile> = [srv1_power, srv2_power, srv3_power, srv4_power]

// A READING THAT COULD NOT PRICE ANYTHING, and the reason it could not. On 2026-11-24 the operator read each
// Strata host's CPU package power on either side of the power caps going in: srv4 101 W and then 39-42 W, srv3
// 65 W and then 29-31 W. The load on the host moved between the two readings, so the step belongs to the caps and
// the quieter machine together and to neither cleanly -- which is precisely why neither figure replaces the
// profile's inferred draw above. The rows exist so the numbers survive AND so the reason they were not used
// survives with them: a later session that finds 39 W on srv4 should find this row saying why 39 W is not srv4's
// figure, not rediscover the confound from scratch. A figure joins the roster only when it is read UNDER a named
// cap state with the load held; that read supersedes both the inferred figure and the row here.
type ConfoundedHostPowerReading {
  host: NonEmptyStr
  // What the reading was taken from, in the operator's own words: the CPU package power.
  sensor: NonEmptyStr
  earlier_watts: Watt
  later_low_watts: Watt
  later_high_watts: Watt
  observed_on: NonEmptyStr
  // What moved besides the thing being measured. This is the field that makes the reading unusable for pricing,
  // so it is a field and not a comment.
  confound: NonEmptyStr
}

data srv4_confounded_cpu_power_reading_2026_11_24: ConfoundedHostPowerReading = ConfoundedHostPowerReading {
  host: "srv4",
  sensor: "CPU package power",
  earlier_watts: watt(count: 101),
  later_low_watts: watt(count: 39),
  later_high_watts: watt(count: 42),
  observed_on: "2026-11-24, operator hand read around the GPU cap and the CPU frequency cap going in",
  confound: "the load on the host changed between the two readings, so the 101 W to 39-42 W step is not attributable to the caps alone",
}

data srv3_confounded_cpu_power_reading_2026_11_24: ConfoundedHostPowerReading = ConfoundedHostPowerReading {
  host: "srv3",
  sensor: "CPU package power",
  earlier_watts: watt(count: 65),
  later_low_watts: watt(count: 29),
  later_high_watts: watt(count: 31),
  observed_on: "2026-11-24, operator hand read around the GPU cap and the CPU frequency cap going in",
  confound: "the load on the host changed between the two readings, so the 65 W to 29-31 W step is not attributable to the caps alone",
}

data confounded_host_power_readings: List<ConfoundedHostPowerReading> = [
  srv4_confounded_cpu_power_reading_2026_11_24, srv3_confounded_cpu_power_reading_2026_11_24,
]

// Is this host's roster figure still the inference, while a confounded reading of that host exists? The witness
// asks it of both rows at once: the reading and the provenance are one standing, and a session that upgrades the
// figure on the strength of these numbers trips it.
fn host_figure_is_still_inferred(host: NonEmptyStr) -> Bool {
  match host_power_profile(host: host) {
    Absent => false
    Present { value: p } => !power_is_measured(p: p)
  }
}

fn power_is_measured(p: HostPowerProfile) -> Bool {
  match p.provenance {
    MeasuredOnHost { sample_count: _, sensor: _, observed_on: _ } => true
    InferredFromSimilarBuild { basis_host: _, basis_reason: _ } => false
  }
}

fn measured_host_count() -> Int {
  count(filter(fleet_host_power_roster, p => power_is_measured(p: p)))
}

fn inferred_host_count() -> Int {
  count(filter(fleet_host_power_roster, p => !power_is_measured(p: p)))
}

fn host_power_profile(host: NonEmptyStr) -> HostPowerProfile? {
  fold(fleet_host_power_roster, init: none, f: fn(acc, p) {
    match acc {
      Present { value: _ } => acc
      Absent => if p.host == host { Present { value: p } } else { none }
    }
  })
}

data per_host_measurement_trigger: DissolutionCondition = unbound_dissolution(
  description: "PARTLY SATISFIED 2026-11-24: srv3 and srv4 were read over ssh and their rows became MeasuredOnHost, so this trigger now names srv2 only -- the host that still refuses the operator key, whose 94 W figure is inherited from a srv1 read taken at a 3.0 GHz ceiling srv2 itself has not run since 2026-11-24. Dissolve-on: a shell-capable path exists for srv2 and its row is replaced by its own MeasuredOnHost reading, bringing inferred_host_count to zero. Separately and not covered by that trigger: every row here is a single LOADED operating point, so the idle-to-loaded DIFFERENCE that a true marginal figure needs is still unobserved, and obtaining it requires quiescing a host that currently serves production CI."
)
