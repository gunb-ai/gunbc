// ONE AWS PASS: observe the policy's region, read the queued notices, decide (product.fabric.flex_aws_apply),
// perform AT MOST ONE write, and write a receipt. The pass is the effectful shell around a pure decision,
// so every branch of the decision is witnessed without AWS and this module only sequences reads and the
// write. Run once per tick (gunbc run --entry dag/gunbc/fleet/flex_aws_pass.dag --function pass
// --arg mode=plan|apply --arg cards=N --arg router=on|off; with router=on, N is the ceiling and the
// router's stranded demand decides how many; run_loop adds --arg ticks=T --arg interval_seconds=S); a pass that cannot read a fact it needs refuses and writes nothing.

fn flex_aws_pass_receipt_path() -> String { flex_aws_custody_path(name: "flex-aws-pass-receipt.txt") }

// The base image: AWS's Deep Learning Base OSS Nvidia Driver GPU AMI for Ubuntu 24.04, read per region from
// its public parameter. Its description (read 2026-11-25) lists G7e among the supported instance types; the
// driver it carries is read on the card (the onstart refuses below 580).
data flex_aws_ami_parameter: NonEmptyStr = "/aws/service/deeplearning/ami/x86_64/base-oss-nvidia-driver-gpu-ubuntu-24.04/latest/ami-id" as NonEmptyStr

fn flex_aws_boot_policy() -> FlexEc2BootPolicy {
  FlexEc2BootPolicy {
    ssm_key_prefix: join([flex_aws_parameter_prefix as String, "/pool-key"], "") as NonEmptyStr,
    cert_prefix: join([flex_aws_parameter_prefix as String, "/card-cert"], "") as NonEmptyStr,
    bucket_parameter: join([flex_aws_parameter_prefix as String, "/weights-bucket"], "") as NonEmptyStr,
    key_wait: second(count: 600),
    heartbeat_parameter: join([flex_aws_parameter_prefix as String, "/heartbeat"], "") as NonEmptyStr,
    heartbeat_stale: second(count: 1800),
    root_volume_gib: 150,
    instance_profile: AwsEc2IamInstanceProfileByName { name: flex_aws_card_role_name },
  }
}

fn flex_aws_snapshot() -> FlexEc2PinnedSnapshot {
  FlexEc2PinnedSnapshot { repo: qwen3_8_flash_next_hub_repo, revision: qwen3_8_flash_next_pinned_revision, files: qwen3_8_flash_next_pin_roster() }
}

// The admitted policy of gunbc.design_ruling aws_spot_cheapest_single_gpu_blackwell_2026_11_25,
// aws_spot_lowest_price_globally_2026_11_25, aws_spot_burn_ceiling_2026_11_25 and
// aws_spot_idle_release_and_dead_man_2026_11_25: single-GPU g7e spot in whichever scanned region is cheapest,
// at most 5 USD per hour across every card, a card released after 30 minutes unused. The write mode is the
// caller's.
// OUR OWN CEILING, independent of AWS's quota (operator ruling aws_spot_three_card_ceiling_2026_11_25): at most
// this many cards run at once, across every region. A caller's `cards` argument can lower it, never raise it;
// the effective maximum is the smaller of this and what the applied quotas allow.
data flex_aws_card_ceiling: Int = 3

fn flex_aws_ceiling(asked: Int) -> Int { if asked < flex_aws_card_ceiling { asked } else { flex_aws_card_ceiling } }

fn flex_aws_admitted_policy(mode: ApplyMode) -> FlexAwsApplyPolicy {
  FlexAwsApplyPolicy {
    actuation: mode,
    gpus_per_card: 1,
    burn_ceiling: MoneyPerHour { amount: money_amount_micro(count: 5000000), currency: Usd },
    idle_window: second(count: 1800),
    drain_timeout: second(count: 600),
    boot_deadline: second(count: 2700),
  }
}

fn flex_aws_credentials() -> FilePath { flex_aws_credentials_host_path as String as FilePath }

// A write that succeeded may print nothing (delete-parameter, delete-message): exit 0 is the answer.
fn flex_aws_done(outcome: ProcessOutcome) -> AwsCliRead<String> {
  match outcome {
    ProcessOutputPresent { text: t } => AwsCliReadOk { value: t }
    ProcessOutputAbsent => AwsCliReadOk { value: "" }
    ProcessRefused { exit_code: c, stderr: e } => AwsCliReadRefused { cause: join(["the CLI exited ", to_string(c), ": ", flex_aws_one_line(text: e)], "") }
  }
}

fn flex_aws_read_param(region: NonEmptyStr, name: NonEmptyStr) -> AwsCliRead<NonEmptyStr> {
  match flex_aws_outcome_text(outcome: run_shell_command_capture(command: aws_cli_get_parameter(credentials_file: flex_aws_credentials(), region: region, name: name), transport: LocalExec)) {
    AwsCliReadRefused { cause: c } => AwsCliReadRefused { cause: concat(concat(name as String, ": "), c) }
    AwsCliReadOk { value: t } => aws_cli_read_parameter_value(stdout: t)
  }
}

type FlexAwsQueue
  = FlexAwsQueueRead { url: NonEmptyStr, messages: List<AwsCliQueuedMessage> }
  | FlexAwsQueueRefused { cause: String }

// receive-message with nothing queued prints nothing; that is the empty answer (aws_cli_read_messages). Apply
// takes the messages for a minute (it marks the cards, then deletes each message); Plan only looks, with a
// zero visibility timeout, so a Plan pass never hides a notice from the loop.
fn flex_aws_read_queue(region: NonEmptyStr, apply: Bool) -> FlexAwsQueue {
  match flex_aws_outcome_text(outcome: run_shell_command_capture(command: aws_cli_get_queue_url(credentials_file: flex_aws_credentials(), region: region, queue_name: flex_aws_notice_queue), transport: LocalExec)) {
    AwsCliReadRefused { cause: c } => FlexAwsQueueRefused { cause: c }
    AwsCliReadOk { value: t } => match aws_cli_read_queue_url(stdout: t) {
      AwsCliReadRefused { cause: c } => FlexAwsQueueRefused { cause: c }
      AwsCliReadOk { value: url } =>
        match flex_aws_done(outcome: run_shell_command_capture(command: aws_cli_receive_messages(credentials_file: flex_aws_credentials(), region: region, queue_url: url, visibility_seconds: if apply { 60 } else { 0 }), transport: LocalExec)) {
          AwsCliReadRefused { cause: c } => FlexAwsQueueRefused { cause: c }
          AwsCliReadOk { value: body } => match aws_cli_read_messages(stdout: body) {
            AwsCliReadRefused { cause: c } => FlexAwsQueueRefused { cause: c }
            AwsCliReadOk { value: ms } => FlexAwsQueueRead { url: url, messages: ms }
          }
        }
    }
  }
}

fn flex_aws_notices(messages: List<AwsCliQueuedMessage>) -> List<FlexAwsNotice> {
  flat_map(messages, m => match flex_aws_read_notice(body: m.body) {
    FlexAwsNoticeParsed { notice: n } => [n]
    _ => []
  })
}

fn flex_aws_notice_line(m: AwsCliQueuedMessage) -> String {
  match flex_aws_read_notice(body: m.body) {
    FlexAwsNoticeParsed { notice: FlexAwsInterruptionWarning { instance_id: i, action: _ } } => concat("notice interruption-warning ", i as String)
    FlexAwsNoticeParsed { notice: FlexAwsRebalanceRecommendation { instance_id: i } } => concat("notice rebalance-recommendation ", i as String)
    FlexAwsNoticeForeign { detail_type: d } => concat("notice foreign ", d)
    FlexAwsNoticeUnreadable { cause: c } => concat("notice unreadable ", c)
  }
}

fn flex_aws_drain_wire(w: FlexAwsDrainWhy) -> String {
  match w {
    FlexAwsDrainIdle { idle_seconds: a } => concat("idle idle_s=", to_string(a))
    FlexAwsDrainSurplus { live: l, ceiling: c } => join(["surplus live=", to_string(l), " ceiling=", to_string(c)], "")
    FlexAwsDrainMarkUnreadable { key: k, value: v } => join(["mark-unreadable ", k as String, "=", v], "")
  }
}

fn flex_aws_terminate_wire(w: FlexAwsTerminateWhy) -> String {
  match w {
    FlexAwsTerminateDrained { drain_seconds: a } => concat("drained drain_s=", to_string(a))
    FlexAwsTerminateDrainTimedOut { drain_seconds: a } => concat("drain-timed-out drain_s=", to_string(a))
    FlexAwsTerminateDrainMarkUnreadable { value: v } => concat("drain-mark-unreadable ", v)
    FlexAwsTerminateNeverReady { unready_seconds: a } => concat("never-ready unready_s=", to_string(a))
  }
}

// ---- the writes -------------------------------------------------------------------------------------

// A card and the region it was observed in: every write about a card is made in its own region.
type FlexAwsOwnedIn {
  region: NonEmptyStr
  instance: AwsEc2Instance
}

fn flex_aws_region_of(owned: List<FlexAwsOwnedIn>, instance_id: NonEmptyStr) -> NonEmptyStr? {
  match first_where(owned, o => (o.instance.instance_id as String) == (instance_id as String)) {
    Present { value: o } => Present { value: o.region }
    Absent => none
  }
}

// TERMINATE: terminate, then delete the card's key and certificate parameters, then the queued notices for
// it. The key outliving the card would be a credential with no consumer; the notices outliving it would
// be read again next pass. Reached only once a card is drained, or was never in the router.
fn flex_aws_terminate(region: NonEmptyStr, instance_id: NonEmptyStr, queue: FlexAwsQueue) -> String {
  match flex_aws_outcome_text(outcome: run_shell_command_capture(command: aws_cli_terminate_instances(credentials_file: flex_aws_credentials(), region: region, instance_ids: [instance_id]), transport: LocalExec)) {
    AwsCliReadRefused { cause: c } => concat("write=terminate REFUSED: ", c)
    AwsCliReadOk { value: _ } => {
      let key = flex_aws_done(outcome: run_shell_command_capture(command: aws_cli_delete_parameter(credentials_file: flex_aws_credentials(), region: region, name: join([flex_aws_boot_policy().ssm_key_prefix as String, "/", instance_id as String], "") as NonEmptyStr), transport: LocalExec))
      let cert = flex_aws_done(outcome: run_shell_command_capture(command: aws_cli_delete_parameter(credentials_file: flex_aws_credentials(), region: region, name: join([flex_aws_boot_policy().cert_prefix as String, "/", instance_id as String], "") as NonEmptyStr), transport: LocalExec))
      let cleared = match queue {
        FlexAwsQueueRead { url: url, messages: ms } =>
          count(filter(ms, m => match flex_aws_read_notice(body: m.body) {
            FlexAwsNoticeParsed { notice: n } => ((flex_aws_notice_instance(n: n) as String) == (instance_id as String))
              && match flex_aws_done(outcome: run_shell_command_capture(command: aws_cli_delete_message(credentials_file: flex_aws_credentials(), region: region, queue_url: url, receipt_handle: m.receipt_handle), transport: LocalExec)) { AwsCliReadOk { value: _ } => true  AwsCliReadRefused { cause: _ } => false }
            _ => false
          }))
        FlexAwsQueueRefused { cause: _ } => 0
      }
      join([
        "write=terminate ", instance_id as String,
        " key=", match key { AwsCliReadOk { value: _ } => "deleted"  AwsCliReadRefused { cause: c } => concat("NOT-deleted ", c) },
        " cert=", match cert { AwsCliReadOk { value: _ } => "deleted"  AwsCliReadRefused { cause: c } => concat("NOT-deleted ", c) },
        " notices_cleared=", to_string(cleared),
      ], "")
    }
  }
}

// DRAIN: set the card's drain mark. The router converge of the next pass withdraws its row (a draining card
// is never enrolled), the turns already on it finish, and the decision terminates it once the router shows
// none in flight (product.fabric.flex_aws_apply flex_aws_drain_settled).
fn flex_aws_drain(region: NonEmptyStr, instance_id: NonEmptyStr, now_unix: Int) -> String {
  match flex_aws_done(outcome: run_shell_command_capture(command: aws_cli_create_tags(credentials_file: flex_aws_credentials(), region: region, resource_ids: [instance_id], tags: [AwsEc2Tag { key: flex_aws_mark_drain, value: to_string(now_unix) }]), transport: LocalExec)) {
    AwsCliReadRefused { cause: c } => concat("write=drain REFUSED: ", c)
    AwsCliReadOk { value: _ } => concat("write=drain marked ", instance_id as String)
  }
}

// ONE MARK, written in its card's region; one receipt line.
fn flex_aws_mark_write(owned: List<FlexAwsOwnedIn>, m: FlexAwsMarkWrite) -> String {
  match m {
    FlexAwsMarkSet { instance_id: i, key: k, unix: t } => match flex_aws_region_of(owned: owned, instance_id: i) {
      Absent => join(["mark ", i as String, " ", k as String, " REFUSED no region"], "")
      Present { value: r } => match flex_aws_done(outcome: run_shell_command_capture(command: aws_cli_create_tags(credentials_file: flex_aws_credentials(), region: r, resource_ids: [i], tags: [AwsEc2Tag { key: k, value: to_string(t) }]), transport: LocalExec)) {
        AwsCliReadRefused { cause: c } => join(["mark ", i as String, " set ", k as String, " REFUSED ", c], "")
        AwsCliReadOk { value: _ } => join(["mark ", i as String, " set ", k as String, "=", to_string(t)], "")
      }
    }
    FlexAwsMarkClear { instance_id: i, key: k } => match flex_aws_region_of(owned: owned, instance_id: i) {
      Absent => join(["mark ", i as String, " ", k as String, " REFUSED no region"], "")
      Present { value: r } => match flex_aws_done(outcome: run_shell_command_capture(command: aws_cli_delete_tags(credentials_file: flex_aws_credentials(), region: r, resource_ids: [i], keys: [k]), transport: LocalExec)) {
        AwsCliReadRefused { cause: c } => join(["mark ", i as String, " clear ", k as String, " REFUSED ", c], "")
        AwsCliReadOk { value: _ } => join(["mark ", i as String, " clear ", k as String], "")
      }
    }
  }
}

// THE HEARTBEAT the cards' dead-man watches (product.fabric.flex_ec2_boot flex_ec2_deadman): this pass's
// clock, written in every region where we hold a live card AND every region whose ownership this pass could
// not read (the dead-man bounds a dead LOOP; a live loop that cannot see a region must not starve its cards).
// A card whose region's heartbeat is older than the stale window terminates itself.
fn flex_aws_heartbeat(owned: List<FlexAwsOwnedIn>, blind: List<String>, now_unix: Int) -> String {
  let regions = distinct_by_key(xs: concat(map(owned |> filter(o => flex_aws_live(i: o.instance)), o => o.region as String), blind), key: r => r)
  if count(regions) == 0 { "heartbeat=none (no live card)" } else {
    join(["heartbeat=", to_string(now_unix), " ", join(map(regions, r => match flex_aws_done(outcome: run_shell_command_capture(command: aws_cli_put_string_parameter(credentials_file: flex_aws_credentials(), region: r as NonEmptyStr, name: flex_aws_boot_policy().heartbeat_parameter, value: to_string(now_unix) as NonEmptyStr), transport: LocalExec)) {
      AwsCliReadOk { value: _ } => concat(r, ":ok")
      AwsCliReadRefused { cause: c } => join([r, ":REFUSED ", c], "")
    }), " ")], "")
  }
}

fn flex_aws_first_id(read: AwsCliRead<List<NonEmptyStr>>, what: String) -> AwsCliRead<NonEmptyStr> {
  match read {
    AwsCliReadRefused { cause: c } => AwsCliReadRefused { cause: c }
    AwsCliReadOk { value: ids } => match ids.first() {
      Present { value: i } => if count(ids) == 1 { AwsCliReadOk { value: i } } else { AwsCliReadRefused { cause: concat("more than one ", what) } }
      Absent => AwsCliReadRefused { cause: concat("no ", what) }
    }
  }
}

fn flex_aws_subnet(region: NonEmptyStr, zone: NonEmptyStr) -> AwsCliRead<NonEmptyStr> {
  match flex_aws_outcome_text(outcome: run_shell_command_capture(command: aws_cli_describe_subnets_in_default_vpc(credentials_file: flex_aws_credentials(), region: region, zone: zone), transport: LocalExec)) {
    AwsCliReadRefused { cause: c } => AwsCliReadRefused { cause: c }
    AwsCliReadOk { value: t } => flex_aws_first_id(read: aws_cli_read_subnet_ids(stdout: t), what: concat("default subnet in ", zone as String))
  }
}

fn flex_aws_security_group(region: NonEmptyStr) -> AwsCliRead<NonEmptyStr> {
  match flex_aws_outcome_text(outcome: run_shell_command_capture(command: aws_cli_describe_security_group_named(credentials_file: flex_aws_credentials(), region: region, group_name: flex_aws_card_role_name), transport: LocalExec)) {
    AwsCliReadRefused { cause: c } => AwsCliReadRefused { cause: c }
    AwsCliReadOk { value: t } => flex_aws_first_id(read: aws_cli_read_security_group_ids(stdout: t), what: "gunbc-flex-card security group")
  }
}

// THE POOL KEY: 32 random bytes, base64, written owner-only under the custody directory, CREATED ONCE as a
// SecureString keyed by the instance id from that file, then the file is deleted. The value never enters argv
// or the receipt. Create-once, because a replayed RunInstances (same client token, same minute) answers with
// the SAME instance: a second key would overwrite the one the card may already hold while the router reads
// the new one (review of fb2594de). An existing key is kept. A failure after RunInstances leaves a card that
// refuses at boot (no key after its bounded wait) and is terminated at its boot deadline.
fn flex_aws_deliver_key(region: NonEmptyStr, instance_id: NonEmptyStr) -> String {
  let key = trim(Urandom.ReadBytes(count: 32).octets_b64)
  if key == "" {
    "key=REFUSED no entropy"
  } else {
    let path = flex_aws_custody_path(name: concat("pool-key-", instance_id as String))
    let written = Filesystem.WriteOwnerOnly(path: path, content: key)
    if !written.success {
      concat("key=REFUSED write ", written.error)
    } else {
      let put = match flex_aws_card_arn(region: region, instance_id: instance_id) {
        AwsCliReadRefused { cause: c } => AwsCliReadRefused { cause: concat("the card's ARN: ", c) }
        AwsCliReadOk { value: arn } => flex_aws_outcome_text(outcome: run_shell_command_capture(command: aws_cli_create_secure_parameter(credentials_file: flex_aws_credentials(), region: region, name: join([flex_aws_boot_policy().ssm_key_prefix as String, "/", instance_id as String], "") as NonEmptyStr, value_file: path as FilePath, tags: [AwsEc2Tag { key: flex_ec2_card_instance_tag_key, value: arn }]), transport: LocalExec))
      }
      let removed = Filesystem.Delete(path: path)
      join([
        match put { AwsCliReadOk { value: _ } => "key=delivered"  AwsCliReadRefused { cause: c } => if c.contains(aws_cli_parameter_exists) { "key=present (kept, a replayed launch)" } else { concat("key=REFUSED put ", c) } },
        if removed.success { "" } else { concat(" key-file=NOT-removed ", removed.error) },
      ], "")
    }
  }
}

// The card's instance ARN, which its key is tagged with so only that card's role can read it
// (gunbc.flex_aws_iam CardReadOwnKey). The account is read from the loop's own credentials, never written.
fn flex_aws_card_arn(region: NonEmptyStr, instance_id: NonEmptyStr) -> AwsCliRead<String> {
  match flex_aws_outcome_text(outcome: run_shell_command_capture(command: aws_cli_get_caller_identity(credentials_file: flex_aws_credentials(), region: region), transport: LocalExec)) {
    AwsCliReadRefused { cause: c } => AwsCliReadRefused { cause: c }
    AwsCliReadOk { value: t } => match aws_cli_read_account(stdout: t) {
      AwsCliReadRefused { cause: c } => AwsCliReadRefused { cause: c }
      AwsCliReadOk { value: a } => AwsCliReadOk { value: join(["arn:aws:ec2:", region as String, ":", a as String, ":instance/", instance_id as String], "") }
    }
  }
}

// THE LAUNCH, over the ranked candidates: the AMI, the security group and the user data are read once;
// each candidate is asked for at ITS OWN rate as MaxPrice, in its zone's default subnet. Only a capacity
// refusal moves to the next candidate (a refused RunInstances wrote nothing); any other refusal ends the
// pass with its cause, because it would refuse the next candidate for the same reason.
data flex_aws_capacity_refusal: String = "InsufficientInstanceCapacity"

fn flex_aws_launch(attempts: List<FlexAwsCandidate>, now_unix: Int) -> String {
  match flex_ec2_user_data(image: flex_lil_serving_image, files: flex_aws_snapshot(), policy: flex_aws_boot_policy()) {
    FlexEc2UserDataRefused { cause: c } => concat("write=launch REFUSED user data: ", c as String)
    FlexEc2UserDataRendered { text: ud } => {
      let tried = fold(attempts, init: FlexAwsAttempts { lines: [], settled: false }, f: (acc, c) =>
        if acc.settled { acc } else {
          match flex_aws_launch_one(candidate: c, user_data: ud, now_unix: now_unix) {
            FlexAwsCapacityRefused { line: l } => FlexAwsAttempts { lines: concat(acc.lines, [l]), settled: false }
            FlexAwsLaunchSettled { line: l } => FlexAwsAttempts { lines: concat(acc.lines, [l]), settled: true }
          }
        })
      if count(tried.lines) == 0 { "write=launch REFUSED no candidate" } else { join(tried.lines, " ; ") }
    }
  }
}

type FlexAwsAttempts {
  lines: List<String>
  settled: Bool
}

// A capacity refusal is the one outcome that moves to the next candidate; a launch, an unreadable answer,
// or any other refusal settles the pass.
type FlexAwsLaunchOne
  = FlexAwsCapacityRefused { line: String }
  | FlexAwsLaunchSettled { line: String }

// One attempt, in the candidate's OWN region: its AMI id (a per-region public parameter), its security
// group and its default subnet are read there. A region without the card's setup refuses settled -- it is
// not a capacity answer, so the pass does not keep walking other regions past a setup gap.
fn flex_aws_launch_one(candidate: FlexAwsCandidate, user_data: String, now_unix: Int) -> FlexAwsLaunchOne {
  let region = candidate.region
  match flex_aws_read_param(region: region, name: flex_aws_ami_parameter) {
    AwsCliReadRefused { cause: c } => FlexAwsLaunchSettled { line: join(["write=launch REFUSED ami in ", region as String, ": ", c], "") }
    AwsCliReadOk { value: ami } => match flex_aws_security_group(region: region) {
      AwsCliReadRefused { cause: c } => FlexAwsLaunchSettled { line: join(["write=launch REFUSED security group in ", region as String, ": ", c], "") }
      AwsCliReadOk { value: sg } => flex_aws_launch_in(region: region, candidate: candidate, ami: ami, sg: sg, user_data: user_data, now_unix: now_unix)
    }
  }
}

fn flex_aws_launch_in(region: NonEmptyStr, candidate: FlexAwsCandidate, ami: NonEmptyStr, sg: NonEmptyStr, user_data: String, now_unix: Int) -> FlexAwsLaunchOne {
  match candidate.rate {
    Absent => FlexAwsLaunchSettled { line: join(["write=launch REFUSED ", candidate.zone as String, " has no rate"], "") }
    Present { value: rate } => match flex_aws_subnet(region: region, zone: candidate.zone) {
      AwsCliReadRefused { cause: c } => FlexAwsLaunchSettled { line: join(["write=launch REFUSED subnet ", candidate.zone as String, ": ", c], "") }
      AwsCliReadOk { value: subnet } => {
        // The token is the intent: the zone and the minute it was decided in. A retried call within the
        // same minute returns the same reservation rather than a second card.
        let token = join(["gunbc-flex-", candidate.zone as String, "-", to_string(now_unix / 60)], "") as NonEmptyStr
        let request = flex_aws_run_request(candidate: candidate, max_price: rate, ami: ami, user_data: user_data, boot: flex_aws_boot_policy(), subnet_id: subnet, security_group_id: sg, client_token: token)
        match flex_aws_outcome_text(outcome: run_shell_command_capture(command: aws_cli_run_instances(credentials_file: flex_aws_credentials(), region: region, request: request), transport: LocalExec)) {
          AwsCliReadRefused { cause: e } => {
            let line = join(["write=launch REFUSED ", candidate.zone as String, ": ", e], "")
            if e.contains(flex_aws_capacity_refusal) { FlexAwsCapacityRefused { line: line } } else { FlexAwsLaunchSettled { line: line } }
          }
          AwsCliReadOk { value: t } => match aws_cli_read_run_instances(stdout: t) {
            AwsCliReadRefused { cause: e } => FlexAwsLaunchSettled { line: concat("write=launch ANSWER-UNREADABLE (a card may exist; the roster will show it): ", e) }
            AwsCliReadOk { value: instances } => match instances.first() {
              Absent => FlexAwsLaunchSettled { line: "write=launch ANSWER-EMPTY" }
              Present { value: i } => FlexAwsLaunchSettled { line: join(["write=launch ", i.instance_id as String, " ", candidate.zone as String, " max_price_micros=", to_string(money_per_hour_micros(q: rate)), " ami=", ami as String, " ", flex_aws_deliver_key(region: region, instance_id: i.instance_id)], "") }
            }
          }
        }
      }
    }
  }
}

// ---- demand (on the router's host only) --------------------------------------------------------------

// The router's own stats, read as the operator route reads the router: its origin, its pinned server
// certificate and the client key from their custody (gunbc.harness.harness_operator_route). The header
// carrying the key is written owner-only and deleted after the read.
fn flex_aws_router_demand(max_cards: Int, instance_ids: List<NonEmptyStr>) -> AwsCliRead<FlexAwsDemand> {
  match operator_credential_path(route: harness_router_operator_route) {
    Absent => AwsCliReadRefused { cause: "the router client key has no custody path" }
    Present { value: key_path } => match operator_certificate_path(route: harness_router_operator_route) {
      Absent => AwsCliReadRefused { cause: "the router certificate has no custody path" }
      Present { value: ca_path } => {
        let key = Filesystem.Read(path: key_path as String)
        match operator_header_line_from_key_text(text: if key.success { key.content } else { "" }) {
          Absent => AwsCliReadRefused { cause: concat("the router client key is unreadable or empty: ", key.error) }
          Present { value: header } => {
            let header_path = flex_aws_custody_path(name: "router-stats.header")
            let wrote = Filesystem.WriteOwnerOnly(path: header_path, content: concat(header as String, "\n"))
            if !wrote.success {
              AwsCliReadRefused { cause: concat("the stats header could not be written: ", wrote.error) }
            } else {
              let answer = flex_aws_done(outcome: run_shell_command_capture(command: curl_cacert_get_with_header_file_command(url: join([operator_router_origin() as String, "/router/stats"], ""), ca_file: ca_path as String, header_file: header_path, max_time: second(count: 10)), transport: LocalExec))
              let removed = Filesystem.Delete(path: header_path)
              match answer {
                AwsCliReadRefused { cause: c } => AwsCliReadRefused { cause: concat("router stats: ", c) }
                AwsCliReadOk { value: body } => match flex_aws_read_router_stats(body: body, instance_ids: instance_ids) {
                  FlexAwsStatsReadOk { reading: r } => AwsCliReadOk { value: FlexAwsDemandRouter { router: r, max_cards: max_cards } }
                  FlexAwsStatsRefused { cause: c } => AwsCliReadRefused { cause: c }
                }
              }
            }
          }
        }
      }
    }
  }
}

fn flex_aws_demand_line(d: FlexAwsDemand) -> String {
  match d {
    FlexAwsDemandFixed { cards: n } => concat("demand=fixed cards=", to_string(n))
    FlexAwsDemandRouter { router: r, max_cards: m } => join([
      "demand=router waiting=", to_string(r.waiting), " rented_full=", if r.full { "yes" } else { "no" }, " rented_rows=", to_string(r.rented_rows), " max_cards=", to_string(m),
      join(map(r.cards, u => join([" use ", u.instance_id as String, " enrolled=", if u.enrolled { "yes" } else { "no" }, " in_flight=", to_string(u.in_flight), " seen_recent=", to_string(u.seen_recent)], "")), ""),
    ], "")
  }
}

// ---- router enrollment (on the router's host only) ---------------------------------------------------

// The srv1 vLLM row's serving facts, which this card shares (gunbc.serving.flex_aws_router_rows
// FlexAwsRowFacts says why). The model id is the one the image serves; the first enrolled card's
// /v1/models answer is the reading that confirms it.
data flex_aws_row_facts: FlexAwsRowFacts = FlexAwsRowFacts { model: "Qwen3.8-Flash-Next" as NonEmptyStr, max_model_len: 229376, port: 18000, sni: "pool-card" as NonEmptyStr, cap: 4, retain: 8, tier: 0 }

type FlexAwsProbe
  = FlexAwsProbeReady { card: FlexAwsEnrollable }
  | FlexAwsProbeNotReady { instance_id: NonEmptyStr, why: String }

fn flex_aws_card_cert_path(instance_id: NonEmptyStr) -> String { flex_aws_custody_path(name: join(["card-", instance_id as String, ".pem"], "")) }

// A card is ready to route when it has an address, has published its certificate, answers /health over
// THAT certificate, and its pool key reads back. Each missing fact is named; none is assumed.
fn flex_aws_probe(region: NonEmptyStr, i: AwsEc2Instance) -> FlexAwsProbe {
  match i.public_ip_address {
    Absent => FlexAwsProbeNotReady { instance_id: i.instance_id, why: "no public address yet" }
    Present { value: ip } => match flex_aws_read_param(region: region, name: join([flex_aws_boot_policy().cert_prefix as String, "/", i.instance_id as String], "") as NonEmptyStr) {
      AwsCliReadRefused { cause: c } => FlexAwsProbeNotReady { instance_id: i.instance_id, why: concat("no certificate published: ", c) }
      AwsCliReadOk { value: pem } => {
        let pem_path = flex_aws_card_cert_path(instance_id: i.instance_id)
        let wrote = Filesystem.Write(path: pem_path, content: pem as String)
        if !wrote.success {
          FlexAwsProbeNotReady { instance_id: i.instance_id, why: concat("certificate not written: ", wrote.error) }
        } else {
          let port = to_string(flex_aws_row_facts.port)
          let sni = flex_aws_row_facts.sni as String
          match flex_aws_done(outcome: run_shell_command_capture(command: curl_pinned_get_command(url: join(["https://", sni, ":", port, "/health"], ""), ca_file: pem_path, connect_to: join([sni, ":", port, ":", ip, ":", port], ""), connect_timeout: second(count: 3), max_time: second(count: 8)), transport: LocalExec)) {
            AwsCliReadRefused { cause: c } => FlexAwsProbeNotReady { instance_id: i.instance_id, why: concat("not healthy over its pinned certificate: ", c) }
            AwsCliReadOk { value: _ } => match flex_aws_outcome_text(outcome: run_shell_command_capture(command: aws_cli_get_secure_parameter(credentials_file: flex_aws_credentials(), region: region, name: join([flex_aws_boot_policy().ssm_key_prefix as String, "/", i.instance_id as String], "") as NonEmptyStr), transport: LocalExec)) {
              AwsCliReadRefused { cause: c } => FlexAwsProbeNotReady { instance_id: i.instance_id, why: concat("pool key unreadable: ", c) }
              AwsCliReadOk { value: t } => match aws_cli_read_parameter_value(stdout: t) {
                AwsCliReadRefused { cause: c } => FlexAwsProbeNotReady { instance_id: i.instance_id, why: concat("pool key unreadable: ", c) }
                AwsCliReadOk { value: key } => FlexAwsProbeReady { card: FlexAwsEnrollable { instance_id: i.instance_id, public_ip: ip as NonEmptyStr, cert_pem: pem as String, pool_key: key as String } }
              }
            }
          }
        }
      }
    }
  }
}

// "" when the write succeeded, else its error.
fn flex_aws_write_error(path: String, content: String) -> String {
  let w = Filesystem.Write(path: path, content: content)
  if w.success { "" } else { concat(concat(path, ": "), w.error) }
}

// What the router converge did: its receipt lines, the cards it wants routed (by instance id), and whether it
// rewrote the files and signalled the router this pass.
type FlexAwsRouterConverge {
  lines: List<String>
  desired: List<String>
  reloaded: Bool
}

fn flex_aws_hup() -> String {
  let hup = DockerCli.Signal(docker: "docker" as NonEmptyStr, name: router_dev_srv1_container_name(), signal: SignalHangup)
  if hup.exit_code == 0 { "ok" } else { concat("FAILED ", hup.stderr) }
}

// THE ROUTER CONVERGE: the steady cards that answer over their pinned certificate are routed; a withdrawn card
// (drain mark, set by our release or by a notice) is not. Both files are backed up before either is written,
// the CA bundle is written before the rows that need it, and one HUP reloads both. `keep` names rows of cards
// whose region could not be read this pass: they pass through untouched.
fn flex_aws_router_converge(owned: List<FlexAwsOwnedIn>, keep: List<String>, now_unix: Int) -> FlexAwsRouterConverge {
  let steady = flex_aws_steady(owned: map(owned, o => o.instance))
  let probes = flat_map(owned |> filter(o => any(steady, i => (i.instance_id as String) == (o.instance.instance_id as String))), o => [flex_aws_probe(region: o.region, i: o.instance)])
  let ready = flat_map(probes, p => match p { FlexAwsProbeReady { card: c } => [c]  FlexAwsProbeNotReady { instance_id: _, why: _ } => [] })
  let desired = map(ready, c => c.instance_id as String)
  let probe_lines = map(probes, p => match p {
    FlexAwsProbeReady { card: c } => concat("router-probe ready ", c.instance_id as String)
    FlexAwsProbeNotReady { instance_id: i, why: w } => join(["router-probe not-ready ", i as String, " ", w], "")
  })
  let dir = router_dev_srv1_host_state_dir()
  let rows_read = Filesystem.Read(path: dir + "/upstreams.json")
  let ca_read = Filesystem.Read(path: dir + "/upstream_ca.pem")
  if !rows_read.success || !ca_read.success {
    FlexAwsRouterConverge { lines: concat(probe_lines, [join(["router=REFUSED unreadable: ", rows_read.error, " ", ca_read.error], "")]), desired: desired, reloaded: false }
  } else {
    match flex_aws_rows_converge(current: rows_read.content, cards: ready, facts: flex_aws_row_facts, keep: map(keep, k => flex_aws_row_name(instance_id: k as NonEmptyStr))) {
      FlexAwsRowsRefused { cause: c } => FlexAwsRouterConverge { lines: concat(probe_lines, [concat("router=REFUSED ", c)]), desired: desired, reloaded: false }
      FlexAwsRowsConverged { text: rows, added: added, removed: removed, changed: rows_changed } => {
        let ca = flex_aws_ca_converge(current: ca_read.content, cards: ready, keep_ids: keep)
        let kept_line = if count(keep) == 0 { "" } else { concat(" kept-unseen=", join(keep, ",")) }
        if !rows_changed && !ca.changed {
          FlexAwsRouterConverge { lines: concat(probe_lines, [concat("router=unchanged", kept_line)]), desired: desired, reloaded: false }
        } else {
          let stamp = to_string(now_unix)
          let b1 = Filesystem.Write(path: join([dir, "/upstreams.json.bak-flex-", stamp], ""), content: rows_read.content)
          let b2 = Filesystem.Write(path: join([dir, "/upstream_ca.pem.bak-flex-", stamp], ""), content: ca_read.content)
          if !b1.success || !b2.success {
            FlexAwsRouterConverge { lines: concat(probe_lines, [concat("router=REFUSED backup failed: ", concat(b1.error, b2.error))]), desired: desired, reloaded: false }
          } else {
            // Only a file whose meaning changed is written; the other is not touched. The CA bundle goes
            // first, so a row never names a card whose certificate the router does not yet trust.
            let ca_error = if ca.changed { flex_aws_write_error(path: dir + "/upstream_ca.pem", content: ca.text) } else { "" }
            let rows_error = if (ca_error == "") && rows_changed { flex_aws_write_error(path: dir + "/upstreams.json", content: rows) } else { "" }
            if (ca_error != "") || (rows_error != "") {
              FlexAwsRouterConverge { lines: concat(probe_lines, [join(["router=REFUSED write failed (backups at *.bak-flex-", stamp, "): ", ca_error, rows_error], "")]), desired: desired, reloaded: false }
            } else {
              FlexAwsRouterConverge { lines: concat(probe_lines, [join([
                "router=written added=", join(added, ","), " removed=", join(removed, ","), " hup=", flex_aws_hup(), " backup=", stamp, kept_line,
              ], "")]), desired: desired, reloaded: true }
            }
          }
        }
      }
    }
  }
}

// THE ROUTER'S ACKNOWLEDGEMENT (review of fb2594de: a failed HUP, or a crash between the file writes and the
// HUP, left the files right and the running router stale, and the next pass saw unchanged files and never
// signalled again). The running router reports which of our cards it routes; when that differs from what this
// pass wants routed and the pass did not just rewrite and signal, the reload is still owed and is sent again.
fn flex_aws_reload_owed(desired: List<String>, reading: FlexAwsRouterReading, known: List<String>) -> Bool {
  let routed = map(reading.cards |> filter(u => u.enrolled), u => u.instance_id as String)
  any(desired, d => !any(routed, r => r == d)) || any(routed, r => any(known, k => k == r) && !any(desired, d => d == r))
}

// ---- the pass ---------------------------------------------------------------------------------------

// THE REGIONS SCANNED: every region that offered g7e on 2026-11-25 (DescribeInstanceTypeOfferings at
// region grain, all opted-in regions). A region that starts offering the family later is not scanned until
// it is added here; the scan's own receipt names the regions it read.
data flex_aws_scan_regions: List<NonEmptyStr> = [
  "us-east-1" as NonEmptyStr, "us-east-2" as NonEmptyStr, "us-west-2" as NonEmptyStr,
  "eu-north-1" as NonEmptyStr, "eu-west-2" as NonEmptyStr, "eu-central-1" as NonEmptyStr,
  "ap-south-1" as NonEmptyStr, "ap-northeast-1" as NonEmptyStr, "ap-northeast-2" as NonEmptyStr,
]

// ONE REGION OF THE SCAN. OWNERSHIP IS READ IN EVERY REGION, independently of whether it can launch (review of
// fb2594de: a region whose quota or observation failed used to contribute no cards, so a transient read
// failure withdrew healthy cards and let a launch through against an understated count and burn). A region
// with quota is also observed for candidates; its notice queue is part of its setup, and a region whose queue
// cannot be read offers no candidates, because a card launched there would have no notice path.
type FlexAwsRegionScan {
  region: NonEmptyStr
  owned: AwsCliRead<List<AwsEc2Instance>>
  launchable: FlexAwsRegionLaunchable
}

type FlexAwsRegionLaunchable
  = FlexAwsRegionSkipped { why: String }
  | FlexAwsRegionScanned { quota: Int, observation: FlexAwsRegionObservation, queue: FlexAwsQueue }

fn flex_aws_read_owned(region: NonEmptyStr) -> AwsCliRead<List<AwsEc2Instance>> {
  match flex_aws_outcome_text(outcome: run_shell_command_capture(command: aws_cli_describe_owned_instances(credentials_file: flex_aws_credentials(), region: region, tag_key: flex_aws_owner_tag_key, owner: flex_aws_owner_tag_value), transport: LocalExec)) {
    AwsCliReadRefused { cause: c } => AwsCliReadRefused { cause: c }
    AwsCliReadOk { value: t } => aws_cli_read_instances(stdout: t)
  }
}

fn flex_aws_scan_region(region: NonEmptyStr, apply: Bool, now_unix: Int) -> FlexAwsRegionScan {
  match flex_aws_quota(credentials: flex_aws_credentials(), region: region, code: aws_quota_code_g_vt_spot_vcpus) {
    AwsCliReadRefused { cause: c } => FlexAwsRegionScan { region: region, owned: flex_aws_read_owned(region: region), launchable: FlexAwsRegionSkipped { why: concat("quota unreadable: ", c) } }
    AwsCliReadOk { value: q } =>
      if q <= 0 { FlexAwsRegionScan { region: region, owned: flex_aws_read_owned(region: region), launchable: FlexAwsRegionSkipped { why: "no spot quota" } } }
      else {
        let o = flex_aws_observe_region(credentials: flex_aws_credentials(), region: region, now_epoch_seconds: now_unix)
        // The observation reads the owned roster itself; it is reused when it succeeded, read alone otherwise.
        let owned = match o {
          FlexAwsRegionObserved { region: _, offerings: _, types: _, prices: _, spot_quota_vcpus: _, on_demand_quota_vcpus: _, owned: ow } => AwsCliReadOk { value: ow }
          _ => flex_aws_read_owned(region: region)
        }
        FlexAwsRegionScan { region: region, owned: owned, launchable: FlexAwsRegionScanned { quota: q, observation: o, queue: flex_aws_read_queue(region: region, apply: apply) } }
      }
  }
}

fn flex_aws_scan_line(s: FlexAwsRegionScan) -> String {
  let owned = match s.owned { AwsCliReadOk { value: ow } => concat(" owned=", to_string(count(ow)))  AwsCliReadRefused { cause: c } => concat(" owned=UNREADABLE ", c) }
  match s.launchable {
    FlexAwsRegionSkipped { why: w } => join(["scan ", s.region as String, " skipped: ", w, owned], "")
    FlexAwsRegionScanned { quota: _, observation: o, queue: qu } => join([flex_aws_region_line(o: o), " notices=", match qu { FlexAwsQueueRead { url: _, messages: ms } => to_string(count(ms))  FlexAwsQueueRefused { cause: c } => concat("REFUSED ", c) }, owned], "")
  }
}

fn flex_aws_scan_owned(s: FlexAwsRegionScan) -> List<FlexAwsOwnedIn> {
  match s.owned { AwsCliReadOk { value: ow } => map(ow, i => FlexAwsOwnedIn { region: s.region, instance: i })  AwsCliReadRefused { cause: _ } => [] }
}

fn flex_aws_scan_blind(s: FlexAwsRegionScan) -> List<String> {
  match s.owned { AwsCliReadOk { value: _ } => []  AwsCliReadRefused { cause: _ } => [s.region as String] }
}

fn flex_aws_scan_candidates(s: FlexAwsRegionScan) -> List<FlexAwsCandidate> {
  match s.launchable {
    FlexAwsRegionScanned { quota: _, observation: o, queue: FlexAwsQueueRead { url: _, messages: _ } } => flex_aws_candidates(observation: o, recipe: flex_serving_recipe, names: flex_aws_gpu_names)
    _ => []
  }
}

fn flex_aws_scan_messages(s: FlexAwsRegionScan) -> List<FlexAwsRegionMessage> {
  match s.launchable {
    FlexAwsRegionScanned { quota: _, observation: _, queue: FlexAwsQueueRead { url: u, messages: ms } } => map(ms, m => FlexAwsRegionMessage { region: s.region, queue_url: u, message: m })
    _ => []
  }
}

type FlexAwsRegionMessage {
  region: NonEmptyStr
  queue_url: NonEmptyStr
  message: AwsCliQueuedMessage
}

fn flex_aws_scan_queue(scans: List<FlexAwsRegionScan>, region: NonEmptyStr) -> FlexAwsQueue {
  match first_where(scans, x => (x.region as String) == (region as String)) {
    Present { value: x } => match x.launchable { FlexAwsRegionScanned { quota: _, observation: _, queue: q } => q  FlexAwsRegionSkipped { why: _ } => FlexAwsQueueRefused { cause: concat("no queue read in ", region as String) } }
    Absent => FlexAwsQueueRefused { cause: concat("no scan of ", region as String) }
  }
}

fn flex_aws_scan_quota(s: FlexAwsRegionScan) -> List<FlexAwsRegionQuota> {
  match s.launchable {
    FlexAwsRegionScanned { quota: q, observation: _, queue: _ } => [FlexAwsRegionQuota { region: s.region, spot_vcpus: q }]
    _ => []
  }
}

// THE NOTICE ACKNOWLEDGEMENT: a notice is deleted from its queue only once it can no longer matter -- its
// card's withdrawal marks are written, or the card is not one of ours that is live (gone already, or never
// ours). A notice whose marks failed, or whose card's region could not be read, stays queued for the next pass.
fn flex_aws_ack_notices(messages: List<FlexAwsRegionMessage>, owned: List<AwsEc2Instance>, written: List<FlexAwsMarkWrite>, blind: List<String>) -> List<String> {
  flat_map(messages, rm => match flex_aws_read_notice(body: rm.message.body) {
    FlexAwsNoticeParsed { notice: n } => {
      let iid = flex_aws_notice_instance(n: n) as String
      let card = first_where(owned, i => (i.instance_id as String) == iid)
      let withdrawn = match card { Present { value: i } => flex_aws_draining(i: i)  Absent => false }
      let live = match card { Present { value: i } => flex_aws_live(i: i)  Absent => false }
      let marked_now = any(written, w => match w { FlexAwsMarkSet { instance_id: x, key: k, unix: _ } => ((x as String) == iid) && ((k as String) == (flex_aws_mark_drain as String))  _ => false })
      if count(blind) > 0 && !live { [concat("notice kept (a region is unreadable) ", iid)] }
      else if withdrawn || marked_now || !live {
        match flex_aws_done(outcome: run_shell_command_capture(command: aws_cli_delete_message(credentials_file: flex_aws_credentials(), region: rm.region, queue_url: rm.queue_url, receipt_handle: rm.message.receipt_handle), transport: LocalExec)) {
          AwsCliReadOk { value: _ } => [concat("notice acknowledged ", iid)]
          AwsCliReadRefused { cause: c } => [join(["notice ack REFUSED ", iid, " ", c], "")]
        }
      } else { [concat("notice kept (marks not written) ", iid)] }
    }
    _ => []
  })
}

// THE MARK WRITES, and the roster as the written ones leave it.
type FlexAwsMarked {
  lines: List<String>
  written: List<FlexAwsMarkWrite>
}

fn flex_aws_write_marks(owned: List<FlexAwsOwnedIn>, marks: List<FlexAwsMarkWrite>) -> FlexAwsMarked {
  let results = map(marks, m => FlexAwsMarkResult { mark: m, line: flex_aws_mark_write(owned: owned, m: m) })
  FlexAwsMarked {
    lines: map(results, r => r.line),
    written: map(results |> filter(r => !r.line.contains("REFUSED")), r => r.mark),
  }
}

type FlexAwsMarkResult {
  mark: FlexAwsMarkWrite
  line: String
}

// CLEANUP AFTER AN EVICTION (review of fb2594de): a card AWS reclaimed never passes through our terminate, so
// its key and certificate parameters are deleted here, from the terminated roster entry AWS keeps visible for
// about an hour. A parameter already gone is the answer wanted, and is not reported.
fn flex_aws_cleanup_terminated(owned: List<FlexAwsOwnedIn>) -> List<String> {
  flat_map(owned |> filter(o => match o.instance.state.name { AwsEc2Terminated => true  _ => false }), o => {
    let names = [
      join([flex_aws_boot_policy().ssm_key_prefix as String, "/", o.instance.instance_id as String], ""),
      join([flex_aws_boot_policy().cert_prefix as String, "/", o.instance.instance_id as String], ""),
    ]
    flat_map(names, n => match flex_aws_done(outcome: run_shell_command_capture(command: aws_cli_delete_parameter(credentials_file: flex_aws_credentials(), region: o.region, name: n as NonEmptyStr), transport: LocalExec)) {
      AwsCliReadOk { value: _ } => [join(["cleanup ", o.instance.instance_id as String, " deleted ", n], "")]
      AwsCliReadRefused { cause: c } => if c.contains(aws_cli_parameter_absent) { [] } else { [join(["cleanup ", o.instance.instance_id as String, " REFUSED ", n, " ", c], "")] }
    })
  })
}

// THE PASS, GLOBAL (operator ruling aws_spot_lowest_price_globally_2026_11_25): scan every region, decide once
// over all of them, and make the one decision write in the region it is about. In order: notices become marks
// (and only then are acknowledged); the router is converged from the marked roster; the router's reading gives
// demand and each card's use; the clocks are marked; the reload is re-sent if the router has not taken it; the
// heartbeat is renewed; then the decision, over the roster as every written mark left it. A region whose
// ownership could not be read keeps its cards' rows and heartbeat, and blocks every launch.
fn flex_aws_pass_text(policy: FlexAwsApplyPolicy, router: Bool, cards: Int, now_unix: Int) -> String {
  let apply = match policy.actuation { Apply => true  Plan => false }
  let scans = map(flex_aws_scan_regions, r => flex_aws_scan_region(region: r, apply: apply, now_unix: now_unix))
  let owned_in = flat_map(scans, x => flex_aws_scan_owned(s: x))
  let blind = flat_map(scans, x => flex_aws_scan_blind(s: x))
  let candidates = flat_map(scans, x => flex_aws_scan_candidates(s: x))
  let messages = flat_map(scans, x => flex_aws_scan_messages(s: x))
  let notices = flex_aws_notices(messages: map(messages, m => m.message))
  let quotas = flat_map(scans, x => flex_aws_scan_quota(s: x))
  // 1. Notices to marks, then acknowledgement.
  let noticed = if apply { flex_aws_write_marks(owned: owned_in, marks: flex_aws_notice_marks(owned: map(owned_in, o => o.instance), notices: notices, now_unix: now_unix)) } else { FlexAwsMarked { lines: [], written: [] } }
  let acked = if apply { flex_aws_ack_notices(messages: messages, owned: map(owned_in, o => o.instance), written: noticed.written, blind: blind) } else { [] }
  let owned1 = map(owned_in, o => FlexAwsOwnedIn { region: o.region, instance: match flex_aws_with_marks(owned: [o.instance], written: noticed.written).first() { Present { value: i } => i  Absent => o.instance } })
  // 2. The router, from the marked roster; rows of cards in unreadable regions are kept.
  let keep = if count(blind) == 0 { [] } else { flex_aws_unseen_rows(owned: owned1) }
  let converged = if router && apply { flex_aws_router_converge(owned: owned1, keep: keep, now_unix: now_unix) } else { FlexAwsRouterConverge { lines: ["router=skipped"], desired: [], reloaded: false } }
  // 3. The router's reading.
  let live_ids = map(owned1 |> filter(o => flex_aws_live(i: o.instance)), o => o.instance.instance_id)
  let demand_read = if router { flex_aws_router_demand(max_cards: cards, instance_ids: live_ids) } else { AwsCliReadOk { value: FlexAwsDemandFixed { cards: cards } } }
  let demand_line = match demand_read { AwsCliReadOk { value: d } => flex_aws_demand_line(d: d)  AwsCliReadRefused { cause: c } => concat("demand=REFUSED ", c) }
  // 4. The clocks.
  let clocked = if !apply { FlexAwsMarked { lines: [], written: [] } } else {
    match demand_read {
      AwsCliReadOk { value: d } => flex_aws_write_marks(owned: owned1, marks: flex_aws_marks(demand: d, owned: map(owned1, o => o.instance), now_unix: now_unix))
      AwsCliReadRefused { cause: _ } => FlexAwsMarked { lines: [], written: [] }
    }
  }
  let owned2 = map(owned1, o => FlexAwsOwnedIn { region: o.region, instance: match flex_aws_with_marks(owned: [o.instance], written: clocked.written).first() { Present { value: i } => i  Absent => o.instance } })
  // 5. A reload the router has not taken is sent again.
  let reload_line = if !(router && apply) || converged.reloaded { "" } else {
    match demand_read {
      AwsCliReadOk { value: FlexAwsDemandRouter { router: r, max_cards: _ } } =>
        if flex_aws_reload_owed(desired: converged.desired, reading: r, known: map(live_ids, i => i as String)) { concat("router=reload-resent (the running router does not route what the files say) hup=", flex_aws_hup()) } else { "" }
      _ => ""
    }
  }
  // 6. The heartbeat, in every region holding a live card and every region whose ownership is unknown.
  let heartbeat_line = if apply { flex_aws_heartbeat(owned: owned2, blind: blind, now_unix: now_unix) } else { "heartbeat=none (plan)" }
  let cleanup_lines = if apply { flex_aws_cleanup_terminated(owned: owned2) } else { [] }
  // 7. The decision, over the roster as the marks left it. An incomplete inventory launches nothing.
  let owned = map(owned2, o => o.instance)
  let decided_raw = match demand_read {
    AwsCliReadOk { value: d } => flex_aws_decide(policy: policy, demand: d, candidates: candidates, owned: owned, quotas: quotas, now_unix: now_unix)
    AwsCliReadRefused { cause: c } => FlexAwsHold { why: concat("demand unreadable: ", c) }
  }
  let decision = flex_aws_inventory_gate(decision: decided_raw, blind: blind)
  let owned_lines = map(owned2, o => join(["owned ", o.instance.instance_id as String, " ", o.instance.instance_type as String, " ", o.instance.placement.availability_zone as String, " launched=", o.instance.launch_time, " ip=", match o.instance.public_ip_address { Present { value: a } => a  Absent => "-" }], ""))
  let decided = match decision {
    FlexAwsDrain { instance_id: i, why: w } => join(["decision=drain ", i as String, " ", flex_aws_drain_wire(w: w)], "")
    FlexAwsTerminate { instance_id: i, why: w } => join(["decision=terminate ", i as String, " ", flex_aws_terminate_wire(w: w)], "")
    FlexAwsLaunch { candidate: c, max_price: m, fallbacks: f } => join(["decision=launch ", c.instance_type as String, " ", c.zone as String, " rate_micros=", to_string(money_per_hour_micros(q: m)), " fallbacks=", join(map(f, x => join([x.instance_type as String, "@", x.zone as String], "")), ",")], "")
    FlexAwsHold { why: w } => concat("decision=hold ", w)
  }
  let written = if !apply { "write=none (plan)" } else {
    match decision {
      FlexAwsDrain { instance_id: i, why: _ } => match flex_aws_region_of(owned: owned2, instance_id: i) {
        Present { value: r } => flex_aws_drain(region: r, instance_id: i, now_unix: now_unix)
        Absent => concat("write=drain REFUSED no region for ", i as String)
      }
      FlexAwsTerminate { instance_id: i, why: _ } => match flex_aws_region_of(owned: owned2, instance_id: i) {
        Present { value: r } => flex_aws_terminate(region: r, instance_id: i, queue: flex_aws_scan_queue(scans: scans, region: r))
        Absent => concat("write=terminate REFUSED no region for ", i as String)
      }
      FlexAwsLaunch { candidate: c, max_price: _, fallbacks: f } => flex_aws_launch(attempts: concat([c], f), now_unix: now_unix)
      FlexAwsHold { why: _ } => "write=none (hold)"
    }
  }
  join(concat(concat(
    [join(["aws-pass mode=", if apply { "apply" } else { "plan" }, " now=", to_string(now_unix)], ""), demand_line],
    concat(map(scans, x => flex_aws_scan_line(s: x)), concat(owned_lines, map(messages, m => flex_aws_notice_line(m: m.message))))),
    concat(flex_aws_ranked_lines(cs: candidates), concat(concat(concat(noticed.lines, acked), concat(converged.lines, if reload_line == "" { [] } else { [reload_line] })), concat(concat(clocked.lines, concat([heartbeat_line], cleanup_lines)), [decided, written])))), "\n")
}

// AN INCOMPLETE INVENTORY LAUNCHES NOTHING: a card in a region whose ownership could not be read may exist, so
// neither the card ceiling nor the burn can be counted; letting go of a card that WAS seen stays admitted.
fn flex_aws_inventory_gate(decision: FlexAwsDecision, blind: List<String>) -> FlexAwsDecision {
  match decision {
    FlexAwsLaunch { candidate: _, max_price: _, fallbacks: _ } => if count(blind) > 0 { FlexAwsHold { why: concat("inventory incomplete, no launch: ownership unreadable in ", join(blind, ",")) } } else { decision }
    _ => decision
  }
}

// THE ROWS TO KEEP when some region could not be read: every row of ours in the router's file whose card is not
// in the roster that WAS read, by instance id.
fn flex_aws_unseen_rows(owned: List<FlexAwsOwnedIn>) -> List<String> {
  let rows_read = Filesystem.Read(path: router_dev_srv1_host_state_dir() + "/upstreams.json")
  if !rows_read.success { [] } else {
    flex_aws_row_instance_ids(current: rows_read.content) |> filter(i => !any(owned, o => (o.instance.instance_id as String) == i))
  }
}

// The candidate lines, cheapest first, so the receipt reads as the global price ladder.
fn flex_aws_ranked_lines(cs: List<FlexAwsCandidate>) -> List<String> {
  map(flex_aws_ranked(cs: cs), c => flex_aws_candidate_line(c: c))
}

type FlexAwsTickArgs
  = FlexAwsTickArgsRead { policy: FlexAwsApplyPolicy, router: Bool, cards: Int }
  | FlexAwsTickArgsRefused { cause: String }

fn flex_aws_tick_args(mode: String, cards: String, router: String) -> FlexAwsTickArgs {
  match parse_apply_mode(value: mode) {
    ModeParseRefused { reason: r } => FlexAwsTickArgsRefused { cause: r }
    ModeParsed { mode: m } => match parse_int(s: cards) {
      Absent => FlexAwsTickArgsRefused { cause: concat("cards must be a whole number, not ", cards) }
      Present { value: n } =>
        if n < 0 { FlexAwsTickArgsRefused { cause: "cards must not be negative" } }
        else if (router != "on") && (router != "off") { FlexAwsTickArgsRefused { cause: concat("router must be on or off, not ", router) } }
        else { FlexAwsTickArgsRead { policy: flex_aws_admitted_policy(mode: m), router: router == "on", cards: flex_aws_ceiling(asked: n) } }
    }
  }
}

// One tick: read the clock, run the pass, write its receipt. "" on success, else the refusal.
fn flex_aws_tick(policy: FlexAwsApplyPolicy, router: Bool, cards: Int) -> String {
  match observer_clock_read() {
    ObserverClockUnreadable { detail: d } => concat("THE CLOCK COULD NOT BE READ: ", d)
    ObserverClockObserved { instant: at } => {
      let text = flex_aws_pass_text(policy: policy, router: router, cards: cards, now_unix: observer_instant_millis(instant: at) / milliseconds_per_second())
      let written = Filesystem.Write(path: flex_aws_pass_receipt_path(), content: text)
      if written.success { "" } else { concat("THE RECEIPT COULD NOT BE WRITTEN: ", written.error) }
    }
  }
}

fn pass(mode: String, cards: String, router: String) -> ProcessExit {
  match flex_aws_tick_args(mode: mode, cards: cards, router: router) {
    FlexAwsTickArgsRefused { cause: c } => exit_failure(reason: c)
    FlexAwsTickArgsRead { policy: p, router: r, cards: n } => {
      let refused = flex_aws_tick(policy: p, router: r, cards: n)
      if refused == "" { ExitSuccess } else { exit_failure(reason: refused) }
    }
  }
}

// THE RESIDENT LOOP: resolve once, then run the pass every interval for a bounded number of ticks, and
// exit so the unit restarts it with a fresh read of the source. A single pass resolves for minutes on
// these hosts (measured 2026-11-25), which is longer than AWS's two-minute interruption warning; a tick of
// a resolved loop reads the notices and acts in seconds. A tick that refuses stops the loop with its cause
// rather than ticking on past it.
fn run_loop(mode: String, cards: String, router: String, ticks: String, interval_seconds: String) -> ProcessExit {
  match flex_aws_tick_args(mode: mode, cards: cards, router: router) {
    FlexAwsTickArgsRefused { cause: c } => exit_failure(reason: c)
    FlexAwsTickArgsRead { policy: p, router: r, cards: c } => match parse_int(s: ticks) {
      Absent => exit_failure(reason: concat("ticks must be a whole number, not ", ticks))
      Present { value: n } => match parse_int(s: interval_seconds) {
        Absent => exit_failure(reason: concat("interval_seconds must be a whole number, not ", interval_seconds))
        Present { value: wait } =>
          match checked_int_to_nat(n: n) {
            Absent => exit_failure(reason: "ticks must not be negative")
            Present { value: ticks_n } => match checked_int_to_nat(n: wait) {
              Absent => exit_failure(reason: "interval_seconds must not be negative")
              Present { value: wait_n } =>
                if (n < 1) || (wait < 1) {
                  exit_failure(reason: "ticks and interval_seconds must both be at least 1")
                } else {
                  let refused = fold(nat_range_inclusive(lo: 1, hi: ticks_n), init: "", f: (acc, k) =>
                    if acc != "" { acc } else {
                      let result = flex_aws_tick(policy: p, router: r, cards: c)
                      if (result == "") && ((k as Int) < n) {
                        if sleep_delay_seconds_second_carrier_projection(duration: second(count: wait_n)) { "" } else { "THE SLEEP REFUSED" }
                      } else { result }
                    })
                  if refused == "" { ExitSuccess } else { exit_failure(reason: refused) }
                }
            }
          }
      }
    }
  }
}
