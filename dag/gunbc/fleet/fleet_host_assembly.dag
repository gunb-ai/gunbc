// Cooler-to-host containments for srv3/srv4 already live in gunbc.fleet_physical_inventory
// installed_cooler_containments. They are not restated here.
data srv_assembly_containments: List<PhysicalContainment> = [
  ChassisContainsHost { chassis: chassis_srv1, host: operator_host_srv1 },
  ChassisContainsHost { chassis: chassis_srv2, host: operator_host_srv2 },
  ChassisContainsHost { chassis: chassis_srv3, host: operator_host_srv3 },
  ChassisContainsHost { chassis: chassis_srv4, host: operator_host_srv4 },
  HostContainsComponent { host: operator_host_srv1, component: board_srv1 },
  HostContainsComponent { host: operator_host_srv2, component: board_srv2 },
  HostContainsComponent { host: operator_host_srv3, component: board_srv3 },
  HostContainsComponent { host: operator_host_srv4, component: board_srv4 },
  HostContainsComponent { host: operator_host_srv1, component: processor_srv1 },
  HostContainsComponent { host: operator_host_srv2, component: processor_srv2 },
  HostContainsComponent { host: operator_host_srv3, component: processor_srv3 },
  HostContainsComponent { host: operator_host_srv4, component: processor_srv4 },
  HostContainsComponent { host: operator_host_srv1, component: memory_population_srv1 },
  HostContainsComponent { host: operator_host_srv2, component: memory_population_srv2 },
  HostContainsComponent { host: operator_host_srv3, component: memory_population_srv3 },
  HostContainsComponent { host: operator_host_srv4, component: memory_population_srv4 },
  HostContainsComponent { host: operator_host_srv1, component: psu_srv1 },
  HostContainsComponent { host: operator_host_srv2, component: psu_srv2 },
  HostContainsComponent { host: operator_host_srv3, component: psu_srv3 },
  HostContainsComponent { host: operator_host_srv4, component: psu_srv4 },
  HostContainsComponent { host: operator_host_srv1, component: drive_srv1 },
  HostContainsComponent { host: operator_host_srv2, component: drive_srv2 },
  HostContainsComponent { host: operator_host_srv3, component: drive_srv3 },
  HostContainsComponent { host: operator_host_srv4, component: drive_srv4 },
]

fn recorded_component_lot_is_admitted(lot: InventoryLotIdentity) -> Bool {
  inventory_lot_identity_eq(left: lot, right: altrad8ud_board_lot_identity)
    || inventory_lot_identity_eq(left: lot, right: cooler_srv3_lot_identity)
    || inventory_lot_identity_eq(left: lot, right: cooler_srv4_lot_identity)
}

fn every_recorded_component_lot_is_admitted(rows: List<AssembledComponent>) -> Bool {
  fold(rows, init: true, f: fn(acc, row) {
    acc && match row.acquisition {
      ComponentAcquiredFromLot { lot: lot } => recorded_component_lot_is_admitted(lot: lot)
      ComponentAcquisitionUnrecorded { read_obligation: _ } => true
    }
  })
}

fn component_acquired_from_lot(rows: List<AssembledComponent>, component: PhysicalAssetIdentity, lot: InventoryLotIdentity) -> Bool {
  list_any(xs: rows, p: fn(row) {
    physical_asset_identity_eq(a: row.component, b: component)
      && match row.acquisition {
        ComponentAcquiredFromLot { lot: bound } => inventory_lot_identity_eq(left: lot, right: bound)
        ComponentAcquisitionUnrecorded { read_obligation: _ } => false
      }
  })
}

fn every_board_component_is_from_the_four_board_lot(rows: List<AssembledComponent>) -> Bool {
  component_acquired_from_lot(rows: rows, component: board_srv1, lot: altrad8ud_board_lot_identity)
    && component_acquired_from_lot(rows: rows, component: board_srv2, lot: altrad8ud_board_lot_identity)
    && component_acquired_from_lot(rows: rows, component: board_srv3, lot: altrad8ud_board_lot_identity)
    && component_acquired_from_lot(rows: rows, component: board_srv4, lot: altrad8ud_board_lot_identity)
}

fn every_cooler_component_is_from_its_lot(rows: List<AssembledComponent>) -> Bool {
  component_acquired_from_lot(rows: rows, component: cooler_srv3, lot: cooler_srv3_lot_identity)
    && component_acquired_from_lot(rows: rows, component: cooler_srv4, lot: cooler_srv4_lot_identity)
}

fn assembly_covers_component_roster(rows: List<AssembledComponent>) -> Bool {
  list_cover(held: map(rows, r => r.component), expected: srv_assembly_component_roster, eq: physical_asset_identity_eq)
}

data srv_assembly_component_roster: List<PhysicalAssetIdentity> = [
  chassis_srv1, chassis_srv2, chassis_srv3, chassis_srv4,
  board_srv1, board_srv2, board_srv3, board_srv4,
  processor_srv1, processor_srv2, processor_srv3, processor_srv4,
  memory_population_srv1, memory_population_srv2, memory_population_srv3, memory_population_srv4,
  psu_srv1, psu_srv2, psu_srv3, psu_srv4,
  drive_srv1, drive_srv2, drive_srv3, drive_srv4,
  cooler_srv3, cooler_srv4,
]

fn is_cooler_asset(id: PhysicalAssetIdentity) -> Bool {
  physical_asset_identity_eq(a: id, b: cooler_srv3) || physical_asset_identity_eq(a: id, b: cooler_srv4)
}

fn containment_has_chassis(containments: List<PhysicalContainment>, chassis: PhysicalAssetIdentity, host: HostIdentity) -> Bool {
  list_any(xs: containments, p: fn(c) {
    match c {
      ChassisContainsHost { chassis: ch, host: h } =>
        physical_asset_identity_eq(a: ch, b: chassis) && host_identity_eq(a: h, b: host)
      HostContainsComponent { host: _, component: _ } => false
      SiteContainsRoom { site: _, room: _ } => false
      RoomContainsRack { room: _, rack: _ } => false
      RackContainsPlacement { rack: _, asset: _ } => false
    }
  })
}

fn containment_has_component(containments: List<PhysicalContainment>, host: HostIdentity, component: PhysicalAssetIdentity) -> Bool {
  list_any(xs: containments, p: fn(c) {
    match c {
      HostContainsComponent { host: h, component: comp } =>
        host_identity_eq(a: h, b: host) && physical_asset_identity_eq(a: comp, b: component)
      ChassisContainsHost { chassis: _, host: _ } => false
      SiteContainsRoom { site: _, room: _ } => false
      RoomContainsRack { room: _, rack: _ } => false
      RackContainsPlacement { rack: _, asset: _ } => false
    }
  })
}

fn assembly_containments_join(rows: List<AssembledComponent>, containments: List<PhysicalContainment>) -> Bool {
  containment_has_chassis(containments: containments, chassis: chassis_srv1, host: operator_host_srv1)
    && containment_has_chassis(containments: containments, chassis: chassis_srv2, host: operator_host_srv2)
    && containment_has_chassis(containments: containments, chassis: chassis_srv3, host: operator_host_srv3)
    && containment_has_chassis(containments: containments, chassis: chassis_srv4, host: operator_host_srv4)
    && fold(rows, init: true, f: fn(acc, row) {
      acc && (
        is_cooler_asset(id: row.component)
          || containment_has_component(containments: containments, host: row.host, component: row.component)
      )
    })
    && fold(containments, init: true, f: fn(acc, c) {
      acc && match c {
        ChassisContainsHost { chassis: ch, host: h } =>
          (physical_asset_identity_eq(a: ch, b: chassis_srv1) && host_identity_eq(a: h, b: operator_host_srv1))
            || (physical_asset_identity_eq(a: ch, b: chassis_srv2) && host_identity_eq(a: h, b: operator_host_srv2))
            || (physical_asset_identity_eq(a: ch, b: chassis_srv3) && host_identity_eq(a: h, b: operator_host_srv3))
            || (physical_asset_identity_eq(a: ch, b: chassis_srv4) && host_identity_eq(a: h, b: operator_host_srv4))
        HostContainsComponent { host: h, component: comp } =>
          !is_cooler_asset(id: comp)
            && list_any(xs: rows, p: fn(row) {
              host_identity_eq(a: row.host, b: h)
                && physical_asset_identity_eq(a: row.component, b: comp)
            })
        SiteContainsRoom { site: _, room: _ } => false
        RoomContainsRack { room: _, rack: _ } => false
        RackContainsPlacement { rack: _, asset: _ } => false
      }
    })
}
