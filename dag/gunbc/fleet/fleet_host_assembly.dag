  HostContainsComponent { host: operator_host_srv2, component: board_srv2 },
  HostContainsComponent { host: operator_host_srv3, component: board_srv3 },
  HostContainsComponent { host: operator_host_srv4, component: board_srv4 },
  HostContainsComponent { host: operator_host_srv1, component: processor_srv1 },
  HostContainsComponent { host: operator_host_srv2, component: processor_srv2 },
