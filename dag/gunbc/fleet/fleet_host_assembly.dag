  InventoryLotIdentity,
  LotCatalogIdentity,
  CatalogRowExact,
  CatalogRowUnread,
  inventory_lot_identity_eq,
}
import std.decl_ref { DeclarationRef, WholeDeclaration }
import gunbc.fleet_intent_network {
  operator_host_srv1,
  operator_host_srv2,
