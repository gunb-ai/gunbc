  cooler_srv4_lot_identity,
}

// SRV1 THROUGH SRV4 ARE ASSEMBLIES, NOT ACQUISITIONS. There is no single lot and no receipt
// to cite for the host identity. Component-grain identities and an assembly relation bind
// parts to the host they were built into. Component PURCHASES are not fabricated: an unknown
// acquisition is an obligation naming the read, not an omitted row.

type ComponentAcquisition
  = ComponentAcquiredFromLot { lot: InventoryLotIdentity }
  | ComponentAcquisitionUnrecorded { read_obligation: NonEmptyStr }

type AssembledComponent {
  host: HostIdentity
  component: PhysicalAssetIdentity
  catalog: LotCatalogIdentity
  acquisition: ComponentAcquisition
}

data board_srv1: PhysicalAssetIdentity = "board-srv1" as PhysicalAssetIdentity
data board_srv2: PhysicalAssetIdentity = "board-srv2" as PhysicalAssetIdentity
data board_srv3: PhysicalAssetIdentity = "board-srv3" as PhysicalAssetIdentity
data board_srv4: PhysicalAssetIdentity = "board-srv4" as PhysicalAssetIdentity

data processor_srv1: PhysicalAssetIdentity = "processor-srv1" as PhysicalAssetIdentity
data processor_srv2: PhysicalAssetIdentity = "processor-srv2" as PhysicalAssetIdentity
data processor_srv3: PhysicalAssetIdentity = "processor-srv3" as PhysicalAssetIdentity
data processor_srv4: PhysicalAssetIdentity = "processor-srv4" as PhysicalAssetIdentity

data psu_srv1: PhysicalAssetIdentity = "psu-srv1" as PhysicalAssetIdentity
data psu_srv2: PhysicalAssetIdentity = "psu-srv2" as PhysicalAssetIdentity
data psu_srv3: PhysicalAssetIdentity = "psu-srv3" as PhysicalAssetIdentity
data psu_srv4: PhysicalAssetIdentity = "psu-srv4" as PhysicalAssetIdentity

data drive_srv1: PhysicalAssetIdentity = "drive-srv1" as PhysicalAssetIdentity
data drive_srv2: PhysicalAssetIdentity = "drive-srv2" as PhysicalAssetIdentity
data drive_srv3: PhysicalAssetIdentity = "drive-srv3" as PhysicalAssetIdentity
data drive_srv4: PhysicalAssetIdentity = "drive-srv4" as PhysicalAssetIdentity

data memory_population_srv1: PhysicalAssetIdentity = "memory-population-srv1" as PhysicalAssetIdentity
data memory_population_srv2: PhysicalAssetIdentity = "memory-population-srv2" as PhysicalAssetIdentity
data memory_population_srv3: PhysicalAssetIdentity = "memory-population-srv3" as PhysicalAssetIdentity
data memory_population_srv4: PhysicalAssetIdentity = "memory-population-srv4" as PhysicalAssetIdentity

data receipts_must_be_dredged: NonEmptyStr = "Operator states component receipts would have to be dredged up; no component purchase is recorded in the public corpus. Do not invent a lot."

data asrock_altrad8ud_catalog_ref: DeclarationRef = DeclarationRef {
  module_path: "extdeps.boards.asrock_rack",
  decl_name: "asrock_altrad8ud_1l2t_catalog",
  field: WholeDeclaration,
}

data altra_max_m12830_catalog_ref: DeclarationRef = DeclarationRef {
  module_path: "extdeps.cpu.ampere",
  decl_name: "altra_max_m12830_catalog",
  field: WholeDeclaration,
}

data rosewill_r4000u_catalog_ref: DeclarationRef = DeclarationRef {
  module_path: "extdeps.chassis.rosewill",
  decl_name: "rosewill_rsv_r4000u_catalog",
  field: WholeDeclaration,
}

data rosewill_z2600u_catalog_ref: DeclarationRef = DeclarationRef {
  module_path: "extdeps.chassis.rosewill",
  decl_name: "rosewill_rsv_z2600u_catalog",
  field: WholeDeclaration,
}

data dynatron_w1_catalog_ref: DeclarationRef = DeclarationRef {
  module_path: "extdeps.cooling.dynatron",
  decl_name: "dynatron_w1_catalog",
  field: WholeDeclaration,
}

fn lot_component(
  host: HostIdentity,
  component: PhysicalAssetIdentity,
  catalog: LotCatalogIdentity,
  lot: InventoryLotIdentity,
) -> AssembledComponent {
  AssembledComponent {
    host: host,
    component: component,
    catalog: catalog,
    acquisition: ComponentAcquiredFromLot { lot: lot },
  }
}

fn unrecorded_component(
  host: HostIdentity,
  component: PhysicalAssetIdentity,
  catalog: LotCatalogIdentity,
) -> AssembledComponent {
  AssembledComponent {
    host: host,
    component: component,
    catalog: catalog,
    acquisition: ComponentAcquisitionUnrecorded { read_obligation: receipts_must_be_dredged },
  }
}

fn unread_family(family: NonEmptyStr, obligation: NonEmptyStr) -> LotCatalogIdentity {
  CatalogRowUnread { observed_family: family, read_obligation: obligation }
}

data srv_assembly_components: List<AssembledComponent> = [
