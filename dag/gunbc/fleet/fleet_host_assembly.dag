fn every_non_board_acquisition_is_unrecorded(rows: List<AssembledComponent>) -> Bool {
  fold(rows, init: true, f: fn(acc, row) {
    acc && match row.acquisition {
      ComponentAcquiredFromLot { lot: lot } => inventory_lot_identity_eq(left: lot, right: altrad8ud_board_lot_identity)
      ComponentAcquisitionUnrecorded { read_obligation: _ } => true
    }
  })
}

fn board_components_bound_to_the_four_board_lot(rows: List<AssembledComponent>) -> Nat {
  fold(rows, init: 0, f: fn(acc, row) {
    match row.acquisition {
      ComponentAcquiredFromLot { lot: lot } =>
        if inventory_lot_identity_eq(left: lot, right: altrad8ud_board_lot_identity) { acc + 1 } else { acc }
      ComponentAcquisitionUnrecorded { read_obligation: _ } => acc
    }
  })
}
