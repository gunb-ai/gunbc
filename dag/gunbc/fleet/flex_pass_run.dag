// THE SRV1 FLEET-CONVERGE ENTRY OF THE FLEX TIER: ONE PASS of product.fabric.flex_vast_loop flex_run_pass
// over LIVE Vast reads. It reads the key (Secret Manager, under the run's own federated identity), walks our
// account's instances and charges to the end, searches interruptible offers under the recipe's query,
// screens and quotes them, takes the cheapest member as the pass's one intent, and runs the pass under
// flex_trial_policy, whose actuation is Plan: the receipt records the write the pass WOULD make and every
// wall in front of it, and no write is performed. The policy is the one switch; this entry passes it whole.
//
// The receipt carries no secret: the key is used and dropped, the create request carries none.
// `gunbc run --source-root dag --source-root src/v2 --entry dag/gunbc/fleet/flex_pass_run.dag --function pass`

data flex_pass_receipt_path: String = "target/flex-pass-receipt.txt"

// The page budget of one walk. A walk that has not ended by then is Partial, which every consumer refuses.
data flex_walk_page_budget: Int = 40

// ---- THE KEY.
type FlexVastKey
  = FlexVastKeyReady { key: Secret, resolved_version: NonEmptyStr }
  | FlexVastKeyRefused { cause: NonEmptyStr }

fn flex_vast_key() -> FlexVastKey uses net: Network {
  match resolve_access_token() {
    AccessTokenUpsertRequired { plan: plan } =>
      FlexVastKeyRefused { cause: concat("NO GCP ACCESS TOKEN: ", access_token_upsert_required_reason(plan: plan)) as NonEmptyStr }
    AccessTokenEnsureRefused { reason: reason } =>
      FlexVastKeyRefused { cause: concat("NO GCP ACCESS TOKEN: ", reason as String) as NonEmptyStr }
    AccessTokenReady { token: gcp_token } =>
      match fetch_secret_ref_credential_with_token(secret_ref: flex_vast_api_key_secret_ref, access_token: gcp_token) {
        SecretCredentialAccessUpsertRequired { plan: _ } =>
          FlexVastKeyRefused { cause: "THE VAST KEY COULD NOT BE READ: the access ensure requires an interactive authentication this run cannot perform" as NonEmptyStr }
        SecretCredentialFetchRefused { reason: reason } =>
          FlexVastKeyRefused { cause: concat("THE VAST KEY COULD NOT BE READ: ", reason as String) as NonEmptyStr }
        SecretCredentialWireDecodeRefused { identity_cause: _, payload_cause: _ } =>
          FlexVastKeyRefused { cause: "THE VAST KEY COULD NOT BE READ: the access response did not decode" as NonEmptyStr }
        SecretCredentialResolvedVersionMismatch { requested: requested, resolved: resolved } =>
          FlexVastKeyRefused { cause: join(["THE VAST KEY READ ANSWERED ABOUT ANOTHER VERSION: asked for ", requested, ", answered about ", resolved], "") as NonEmptyStr }
        SecretCredentialReady { credential: k, resolved_version: v } => FlexVastKeyReady { key: k, resolved_version: v }
      }
  }
}

fn flex_rest_refusal_text(r: RestRefusal) -> String {
  match r {
    RestStatusRefused { status: s, body: _ } => concat("status ", int_to_decimal_string(value: s))
    RestTransportRefused { cause: c } => concat("transport: ", c as String)
    RestBodyUndecodable { status: s, cause: c } => join(["status ", int_to_decimal_string(value: s), " undecodable: ", c as String], "")
  }
}

// ---- THE WALKS. Each page request names the token the previous page returned; the fold judges the chain.
// A refused page ends the walk with its cause, and the standing is Unreadable (never a partial count).
type FlexInstanceWalk {
  pages: List<FlexInstancesPageTurn>
  refused: String?
}

fn flex_walk_instances(key: Secret, after: String?, walk: FlexInstanceWalk, budget: Int) -> FlexInstanceWalk uses net: Network {
  if budget <= 0 {
    walk
  } else {
    match vast_ai.Instances.Show(api_key: key, select_filters: vast_ai_instances_unfiltered, limit: vast_ai_keyset_page_limit, after_token: after) {
      RestRefused { refusal: r } => FlexInstanceWalk { pages: walk.pages, refused: Present { value: flex_rest_refusal_text(r: r) } }
      RestAnswered { answer: a } =>
        let turn = FlexInstancesPageTurn {
          after_token: after,
          page: VastAiInstances { success: true, instances_found: length(a.instances), total_instances: a.total_instances, next_token: a.next_token, instances: a.instances },
        }
        let next = FlexInstanceWalk { pages: concat(walk.pages, [turn]), refused: none }
        match a.next_token {
          Absent => next
          Present { value: n } => flex_walk_instances(key: key, after: Present { value: n }, walk: next, budget: budget - 1)
        }
    }
  }
}

fn flex_instances_standing(walk: FlexInstanceWalk) -> FlexInstancesStanding {
  match walk.refused {
    Present { value: _ } => FlexInstancesUnreadable
    Absent => flex_fold_instance_pages(pages: walk.pages)
  }
}

type FlexChargeWalk {
  pages: List<FlexChargesPageTurn>
  refused: String?
}

fn flex_walk_charges(key: Secret, filter: String, after: String?, walk: FlexChargeWalk, budget: Int) -> FlexChargeWalk uses net: Network {
  if budget <= 0 {
    walk
  } else {
    match vast_ai.Charges.Show(api_key: key, select_filters: filter, limit: vast_ai_keyset_page_limit, after_token: after) {
      RestRefused { refusal: r } => FlexChargeWalk { pages: walk.pages, refused: Present { value: flex_rest_refusal_text(r: r) } }
      RestAnswered { answer: a } =>
        let turn = FlexChargesPageTurn {
          after_token: after,
          page: VastAiCharges { success: true, count: length(a.results), total: a.total, next_token: a.next_token, results: a.results },
        }
        let next = FlexChargeWalk { pages: concat(walk.pages, [turn]), refused: none }
        match a.next_token {
          Absent => next
          Present { value: n } => flex_walk_charges(key: key, filter: filter, after: Present { value: n }, walk: next, budget: budget - 1)
        }
    }
  }
}

fn flex_charges_standing(walk: FlexChargeWalk) -> FlexChargesStanding {
  match walk.refused {
    Present { value: _ } => FlexChargesUnreadable
    Absent => flex_fold_charge_pages(pages: walk.pages)
  }
}

// ---- THE OFFERS. One search under the recipe's query; every offer screened and quoted.
type FlexOfferSearch
  = FlexOffersAnswered { offers: List<VastAiOffer>, hosts: List<VastAiOfferHostResources> }
  | FlexOffersRefused { cause: String }

fn flex_search(key: Secret, q: VastAiOfferQuery) -> FlexOfferSearch uses net: Network {
  match vast_ai.SearchOffers.Search(
    api_key: key, search_type: q.search_type, limit: q.limit,
    gpu_ram_min_mb: vast_ai_wire_mb(b: q.gpu_ram_min), cuda_max_good_min: q.cuda_max_good_min as Int, cpu_ram_min_mb: vast_ai_wire_mb(b: q.cpu_ram_min),
    inet_down_min_mbps: vast_ai_wire_mbps(b: q.inet_down_min), verified: q.verified, num_gpus: q.num_gpus as Int,
  ) {
    RestAnswered { answer: a } => FlexOffersAnswered { offers: a.offers, hosts: a.hosts }
    RestRefused { refusal: r } => FlexOffersRefused { cause: flex_rest_refusal_text(r: r) }
  }
}

type FlexScreenedOffer {
  offer: VastAiOffer
  entry: FlexShadowFieldEntry
  quote: ServingSelectionQuote
}

fn flex_entry_member(entry: FlexShadowFieldEntry) -> Bool {
  match entry {
    ShadowEntryEstablished => true
    ShadowEntryEstimated { provisional_member: m, standings: _ } => m
    ShadowEntryExcluded => false
  }
}

// The cheapest member by bid floor (min_bid). A tie keeps the earlier offer in the answer's order.
// ---- NO SELECTION HERE. Choosing which offer to rent is a matching decision, owned by product.fabric.selection
// select_supply under std.decision (DESIGN 3b, 3d); this entry never ranks members itself. That route is the
// declared frontier product.fabric.flex_vast_loop flex_select_supply_consumer_frontier: no bid attempt is
// built and no member's quote is established, so a selection would answer needs-evidence. Until it lands,
// the pass is run with NO intent and the receipt reports, for EVERY member, the create it would ask for and
// every wall in front of it (flex_create_walls), so the walls are read without choosing a card.
type FlexMemberWalls {
  screened: FlexScreenedOffer
  admission_built: Bool
  walls: List<FlexCreateRefusal>
}

fn flex_member_intent(s: FlexScreenedOffer) -> FlexCreateIntent? {
  match flex_offer_admission_unattempted(offer: s.offer, account: flex_vast_account) {
    Absent => none
    Present { value: admission } =>
      Present {
        value: FlexCreateIntent {
          offer: s.offer,
          entry: s.entry,
          quote: s.quote,
          admission: admission,
          placement: FlexPlacementUnread { obligation: flex_placement_unread_obligation() },
        },
      }
  }
}

fn flex_member_walls(input: FlexPassInput, s: FlexScreenedOffer) -> FlexMemberWalls {
  match flex_member_intent(s: s) {
    Absent => FlexMemberWalls { screened: s, admission_built: false, walls: [] }
    Present { value: intent } =>
      FlexMemberWalls {
        screened: s,
        admission_built: true,
        walls: concat(
          flex_create_walls(policy: input.policy, observation: input.observation, intent: intent, recipe: input.recipe, hashes: input.template_hashes),
          flex_wet_gate_wall(gates: input.gates),
        ),
      }
  }
}

// ---- THE RECEIPT.
fn flex_entry_wire(entry: FlexShadowFieldEntry) -> String {
  match entry {
    ShadowEntryEstablished => "established"
    ShadowEntryEstimated { provisional_member: m, standings: ss } => join(["estimated member=", if m { "true" } else { "false" }, " uncited=", int_to_decimal_string(value: length(ss))], "")
    ShadowEntryExcluded => "excluded"
  }
}

fn flex_quote_wire(q: ServingSelectionQuote) -> String {
  match q {
    SelectionQuoteEstablished { amount: a, currency: _ } => concat("established micro_usd_per_mtok=", int_to_decimal_string(value: money_amount_micro_count(m: a)))
    SelectionQuoteRefusedEstimated { standings: ss } => concat("estimated uncited=", int_to_decimal_string(value: length(ss)))
    SelectionQuoteRefusedUnavailable => "unavailable"
  }
}

fn flex_screened_line(s: FlexScreenedOffer) -> String {
  join([
    "offer id=", int_to_decimal_string(value: s.offer.id), " machine=", int_to_decimal_string(value: s.offer.machine_id),
    " gpu=", s.offer.gpu_name, " x", int_to_decimal_string(value: s.offer.num_gpus),
    " min_bid=", int_to_decimal_string(value: s.offer.min_bid.units), "e-", int_to_decimal_string(value: s.offer.min_bid.fraction_digits),
    " entry=", flex_entry_wire(entry: s.entry), " quote=", flex_quote_wire(q: s.quote),
  ], "")
}

fn flex_walk_refusal_wire(refused: String?) -> String {
  match refused {
    Absent => ""
    Present { value: c } => concat(" refused: ", c)
  }
}

fn flex_instances_wire(s: FlexInstancesStanding) -> String {
  match s {
    FlexInstancesUnobserved => "instances=unobserved"
    FlexInstancesUnreadable => "instances=unreadable"
    FlexInstancesPartial { next_token: _, observed: o, total: t } => join(["instances=partial observed=", int_to_decimal_string(value: length(o)), " total=", int_to_decimal_string(value: t)], "")
    FlexInstancesComplete { roster: r } => concat("instances=complete total=", int_to_decimal_string(value: r.total))
  }
}

fn flex_charges_wire(s: FlexChargesStanding) -> String {
  match s {
    FlexChargesUnobserved => "charges=unobserved"
    FlexChargesUnreadable => "charges=unreadable"
    FlexChargesPartial { next_token: _, observed: o, total: t } => join(["charges=partial observed=", int_to_decimal_string(value: length(o)), " total=", int_to_decimal_string(value: t)], "")
    FlexChargesComplete { roster: r } => concat("charges=complete rows=", int_to_decimal_string(value: r.total))
  }
}

fn flex_member_line(m: FlexMemberWalls) -> String {
  join([
    flex_screened_line(s: m.screened),
    // The bracket here is cosmetic. What this site actually taught is the OTHER thing: an argument list
    // left open reports 'expected RParen, found RBrace' at the CLOSING BRACE OF THE ENCLOSING BLOCK --
    // several lines below the call, naming no call and no argument -- and the reported line MOVES as you
    // edit above it. That is how a single missing ')' here cost an hour of hand-bisection and produced a
    // wrong theory about the lexer before the real cause was found. Filed as
    // gunbc.recurring_failure_mode.an_unclosed_call_reports_at_the_enclosing_blocks_closing_brace.
    if m.admission_built {
      concat(" walls=[", concat(join(map(m.walls, w => flex_create_refusal_wire(r: w)), ", "), "]"))
    } else {
      " walls=unbuilt (candidates derived but no bid attempt is built)"
    },
  ], "")
}

// ---- THE CARRY: WHAT THIS PASS LEAVES FOR THE NEXT ONE. The pass is stateless by construction -- it
// reads the account and decides -- but TWO of its inputs are not on the Vast wire, and without them the
// loop cannot close:
//   the age of a loading card (GET /api/v1/instances/ carries no time field at all: VastAiInstance has
//   none), and
//   the standing of the last create ask (its answer can be lost in transit; a pass that cannot see the
//   ask cannot reconcile it, and would rent a second card on top of the one it already pays for).
// So the pass keeps a carry file beside the receipt, under the same authority that writes the receipt.
// It is line-based and re-readable: a line this pass cannot parse is SKIPPED, never guessed at, and a
// missing file is a first pass, not a failure. It carries no secret -- an ask id, a contract id, a
// machine id and two instants.
//
// The path is a literal target/ path, the same choice the receipt already makes (see this module's row in
// gunbc.realization_census_rows: "CI receipt written by direct Filesystem.Write to a literal target/
// path"). A SCHEDULED wet dispatch must move both files under the fleet-converge state root; that is the
// go-wet slice's decision, not this one's, and it is named here so it is not lost.
data flex_pass_carry_path: String = "target/flex-pass-carry.txt"
// The SAME path split into the two parts a filesystem observation needs: the directory that is listed (which
// is what establishes absence) and the entry name inside it. The invariant that these three literals denote
// one path is pinned by a claim in test.claim.fabric.flex_pass_carry_witness, not left to convention.
data flex_pass_carry_directory: String = "target"
data flex_pass_carry_name: String = "flex-pass-carry.txt"

data flex_carry_header: String = "flex-carry v1"
data flex_carry_line_sightings_complete: String = "sightings complete"
data flex_carry_line_sightings_incomplete: String = "sightings incomplete"
data flex_carry_prefix_cooldown: String = "cooldown "
data flex_carry_prefix_loading: String = "loading "
data flex_carry_prefix_answered: String = "create answered "
data flex_carry_prefix_lost: String = "create lost "
data flex_carry_prefix_refused: String = "create refused "
// The TRAILER: the last line, "end <n>" where n is the number of lines before it. A write cut off anywhere
// loses it or mismatches it, so a truncated carry reads unread instead of as a shorter, well-formed one.
// Filesystem.Write is not atomic, so the trailer is the only thing that says the file was written whole.
data flex_carry_prefix_end: String = "end "
// The remedy an operator owes whenever the standing of the last ask is not established: the pass cannot
// repair it (an ask that has produced no instance yet is invisible to the roster), so the route is named.
data flex_carry_remedy: String = "REMEDY: an operator reads the account asks and instances, then writes target/flex-pass-carry.txt as the four lines flex-carry v1, sightings incomplete, standing none, end 3 once the account is known clear"
data flex_carry_absent_reason: String = "no carry file exists, and a missing file does not say that no ask is in flight (cargo clean, a fresh worktree or another runner loses it); an operator must restate the standing before a create is planned"
// The standing of the last ask is written as a WHOLE line, one of these two. A carry that states no standing
// at all reads untrusted rather than defaulting to "no ask in flight".
data flex_carry_line_standing_none: String = "standing none"
data flex_carry_line_standing_unknown: String = "standing unknown"

type FlexCarry {
  cooldown: FlexRentCooldown?
  // The sightings AND the basis they were taken on. "complete" means the walk that wrote them read the
  // WHOLE account, which is the only premise under which a loading id absent from them may be read as "at
  // least 0 seconds old". Anything less, and every absent id reads UNREAD.
  basis: FlexSightingsBasis
  sightings: List<FlexLoadingSighting>
  standing: FlexCarryStanding
}

// THE STANDING OF THE LAST ASK, AS THE CARRY RECORDS IT. Three states, because there are three facts: no ask
// is in flight (positively recorded by a pass that looked), an ask is in flight with this verdict, or the
// standing is UNKNOWN. The third is the one that has to survive the write. A pass that could not read its
// carry used to fold that into `standing: none` and then write a well-formed file over the corrupt one, so
// ONE pass was enough to launder "I cannot tell" into "nothing is in flight", and the next pass planned a
// second rent on top of a card the account was already paying for (review 89235 of gunbc#15462). Unknown now
// round-trips through the file and keeps the create gate shut. The pass cannot repair it: it cannot tell
// whether an ask it never saw is still going to land, and a complete roster walk does not settle that either,
// because an ask that has produced no instance yet is invisible to the roster. The way out is a human: read
// the account's asks and instances, then restate the standing (or write `standing none` once the account is
// known clear).
type FlexCarryStanding
  = FlexCarryNoAsk
  | FlexCarryAsk { ask: FlexCreateStanding }
  | FlexCarryStandingUnknown { reason: NonEmptyStr }

type FlexCarryLine
  = FlexCarrySightingsBasis { basis: FlexSightingsBasis }
  | FlexCarryCooldown { asked_at: EpochMs, until: EpochMs }
  | FlexCarryLoading { instance_id: Int, first_sampled_loading_ms: EpochMs }
  | FlexCarryAnswered { instance_id: Int, machine_id: Int, ask_id: Int }
  | FlexCarryLost { machine_id: Int, ask_id: Int }
  | FlexCarryRefused { machine_id: Int, ask_id: Int }
  | FlexCarryHeader
  | FlexCarryNoAskLine
  | FlexCarryStandingUnknownLine
  | FlexCarryTrailer { count: Int }
  | FlexCarryLineUnread { text: String }

// THE GRAMMAR IS EXACT. A line is its keyword, then exactly the integers it declares, separated by single
// spaces: a token that is not an integer, a missing token, an extra token or a doubled space makes the line
// unread, never a shorter or a longer record. (The first cut skipped non-integer tokens and ignored extras,
// so a write cut off mid-number, "loading 42 1792", still parsed, with an instant in 1970.)
fn flex_carry_push(acc: List<Int>?, token: String) -> List<Int>? {
  match acc {
    Absent => none
    Present { value: xs } =>
      match parse_int(s: token) {
        Absent => none
        Present { value: n } => Present { value: concat(xs, [n]) }
      }
  }
}

// The integers of the tokens after the keyword, when there are exactly `arity` of them and every one parses.
fn flex_carry_ints(line: String, keyword_tokens: Int, arity: Int) -> List<Int>? {
  let rest = split(s: line, delimiter: " ").skip(n: keyword_tokens)
  if length(rest) != arity {
    none
  } else {
    fold(rest, init: Present { value: [] }, f: (acc, token) => flex_carry_push(acc: acc, token: token))
  }
}

fn flex_carry_unread_line(line: String) -> FlexCarryLine {
  FlexCarryLineUnread { text: line }
}

fn flex_carry_cooldown_line(line: String) -> FlexCarryLine {
  match flex_carry_ints(line: line, keyword_tokens: 1, arity: 2) {
    Absent => flex_carry_unread_line(line: line)
    Present { value: ns } =>
      match ns {
        [asked, until] => FlexCarryCooldown { asked_at: asked, until: until }
        _ => flex_carry_unread_line(line: line)
      }
  }
}

fn flex_carry_loading_line(line: String) -> FlexCarryLine {
  match flex_carry_ints(line: line, keyword_tokens: 1, arity: 2) {
    Absent => flex_carry_unread_line(line: line)
    Present { value: ns } =>
      match ns {
        [id, at] => FlexCarryLoading { instance_id: id, first_sampled_loading_ms: at }
        _ => flex_carry_unread_line(line: line)
      }
  }
}

fn flex_carry_answered_line(line: String) -> FlexCarryLine {
  match flex_carry_ints(line: line, keyword_tokens: 2, arity: 3) {
    Absent => flex_carry_unread_line(line: line)
    Present { value: ns } =>
      match ns {
        [id, machine, ask] => FlexCarryAnswered { instance_id: id, machine_id: machine, ask_id: ask }
        _ => flex_carry_unread_line(line: line)
      }
  }
}

fn flex_carry_lost_line(line: String) -> FlexCarryLine {
  match flex_carry_ints(line: line, keyword_tokens: 2, arity: 2) {
    Absent => flex_carry_unread_line(line: line)
    Present { value: ns } =>
      match ns {
        [machine, ask] => FlexCarryLost { machine_id: machine, ask_id: ask }
        _ => flex_carry_unread_line(line: line)
      }
  }
}

fn flex_carry_refused_line(line: String) -> FlexCarryLine {
  match flex_carry_ints(line: line, keyword_tokens: 2, arity: 2) {
    Absent => flex_carry_unread_line(line: line)
    Present { value: ns } =>
      match ns {
        [machine, ask] => FlexCarryRefused { machine_id: machine, ask_id: ask }
        _ => flex_carry_unread_line(line: line)
      }
  }
}

fn flex_carry_trailer_line(line: String) -> FlexCarryLine {
  match flex_carry_ints(line: line, keyword_tokens: 1, arity: 1) {
    Absent => flex_carry_unread_line(line: line)
    Present { value: ns } =>
      match ns {
        [n] => FlexCarryTrailer { count: n }
        _ => flex_carry_unread_line(line: line)
      }
  }
}

fn flex_carry_line(line: String) -> FlexCarryLine {
  if line == flex_carry_header {
    FlexCarryHeader
  } else if line == flex_carry_line_sightings_complete {
    FlexCarrySightingsBasis { basis: FlexSightingsBaselineComplete }
  } else if line == flex_carry_line_sightings_incomplete {
    FlexCarrySightingsBasis { basis: FlexSightingsBaselineIncomplete }
  } else if line == flex_carry_line_standing_none {
    FlexCarryNoAskLine
  } else if line == flex_carry_line_standing_unknown {
    FlexCarryStandingUnknownLine
  } else if starts_with(s: line, prefix: flex_carry_prefix_cooldown) {
    flex_carry_cooldown_line(line: line)
  } else if starts_with(s: line, prefix: flex_carry_prefix_loading) {
    flex_carry_loading_line(line: line)
  } else if starts_with(s: line, prefix: flex_carry_prefix_answered) {
    flex_carry_answered_line(line: line)
  } else if starts_with(s: line, prefix: flex_carry_prefix_lost) {
    flex_carry_lost_line(line: line)
  } else if starts_with(s: line, prefix: flex_carry_prefix_refused) {
    flex_carry_refused_line(line: line)
  } else if starts_with(s: line, prefix: flex_carry_prefix_end) {
    flex_carry_trailer_line(line: line)
  } else {
    flex_carry_unread_line(line: line)
  }
}

// A MISSING OR UNREADABLE CARRY IS TYPED, NOT DEFAULTED. The carry is durable state in a build directory:
// a cargo clean, a fresh worktree, or a different runner loses it, and two passes racing on it is the
// compare-and-set case. So the read yields a typed standing, and the two consumers of it refuse rather
// than default: the age of every loading card becomes UNREAD (product.fabric.flex_vast_shadow
// FlexSightingsUnread), which means the loading cut CANNOT fire, and no cooldown is claimed. The pass keeps
// cards it cannot age and holds off on nothing else -- the alternative is a pass that destroys a card on
// the strength of a file it never read, or that rents a second one because it forgot it asked for the first.
// The state repairs itself: the next pass that reads a COMPLETE roster writes a fresh baseline.
//
// WHY A FILE AND NOT std.durable_compare_and_set OR A FABRIC STORE SLOT, stated because it is a real
// limitation: this pass is dispatched by hand (fleet-converge mode flex_pass, no schedule), on one host,
// and it already writes its receipt through the same authority to the same directory -- so today there is
// exactly one writer and no race to arbitrate. A CAS or store slot needs a store root and an identity this
// entry does not yet hold, and inventing one here would be a second authority over the pass's own state.
// The go-wet slice (the schedule) is what creates the race, and it must move BOTH this file and the receipt
// under the fleet-converge state root and take the CAS route; that obligation is named on this module's
// census row and in the go-wet slice's scope, not hidden here.
// THREE FACTS, NOT TWO. "There is no carry file" and "there is a carry file and it cannot be read" are
// different facts, and collapsing them is the same mistake as laundering an unread standing into a clean
// file, at the other end of this file: a fresh worktree would be indistinguishable from a corrupted carry,
// so either the autoscaler can never start or a corrupted carry reads as a fresh start. Absence here is
// ESTABLISHED, by listing the directory through extdeps.filesystem.filesystem_io (FilesystemFileAbsent),
// never by a read that failed. The repo already refuses this collapse: test.claim.ci_app_key_rotation_witness
// an_unreadable_mint_record_is_refused_as_unreadable_never_collapsed_into_absent.
type FlexCarryReading
  = FlexCarryLoaded { carry: FlexCarry }
  | FlexCarryAbsent
  | FlexCarryUnread { reason: NonEmptyStr }

// What the pass may conclude from its carry. An unread reading, or a loaded carry whose standing is recorded
// UNKNOWN, makes the create gate refuse: the standing of the last ask is unknown, and unknown is not "nothing
// in flight".
fn flex_carry_trust(reading: FlexCarryReading) -> FlexCarryTrust {
  match reading {
    FlexCarryAbsent => FlexCarryUntrusted { reason: flex_carry_absent_reason as NonEmptyStr }
    FlexCarryLoaded { carry: c } =>
      match c.standing {
        FlexCarryStandingUnknown { reason: r } => FlexCarryUntrusted { reason: r }
        FlexCarryNoAsk => FlexCarryTrusted
        FlexCarryAsk { ask: _ } => FlexCarryTrusted
      }
    FlexCarryUnread { reason: r } => FlexCarryUntrusted { reason: r }
  }
}

fn flex_carry_cooldown(reading: FlexCarryReading) -> FlexRentCooldown? {
  match reading {
    FlexCarryLoaded { carry: c } => c.cooldown
    FlexCarryAbsent => none
    FlexCarryUnread { reason: _ } => none
  }
}

// The basis is CHECKED, not assumed: a carry whose sightings were written from a partial or unreadable
// walk yields UNREAD bounds, because the premise that makes "absent means at least 0" true -- the previous
// pass read the whole account -- does not hold for it.
fn flex_carry_sightings(reading: FlexCarryReading) -> FlexLoadingSightings {
  match reading {
    FlexCarryLoaded { carry: c } =>
      match c.basis {
        FlexSightingsBaselineComplete => FlexSightingsKnown { sightings: c.sightings }
        FlexSightingsBaselineIncomplete =>
          FlexSightingsUnread { reason: "the sightings baseline was not taken from a complete roster walk" as NonEmptyStr }
      }
    FlexCarryAbsent =>
      FlexSightingsUnread { reason: "no carry has ever been written, so no loading sighting has ever been taken" as NonEmptyStr }
    FlexCarryUnread { reason: r } => FlexSightingsUnread { reason: r }
  }
}

// The planner still sees the two-valued question it asks ("is an ask in flight, and with what verdict?"), and
// UNKNOWN answers it with `none` ONLY because the create gate is shut by flex_carry_trust before the planner
// is reached. That is why trust is a separate input on FlexPassInput and not something the planner infers from
// this Option: inferring it here would put the refusal one indirection away from the call that must not happen.
fn flex_carry_standing(reading: FlexCarryReading) -> FlexCreateStanding? {
  match reading {
    FlexCarryLoaded { carry: c } =>
      match c.standing {
        FlexCarryAsk { ask: ask } => Present { value: ask }
        FlexCarryNoAsk => none
        FlexCarryStandingUnknown { reason: _ } => none
      }
    FlexCarryAbsent => none
    FlexCarryUnread { reason: _ } => none
  }
}

fn flex_carry_basis_word(carry: FlexCarry) -> String {
  match carry.basis {
    FlexSightingsBaselineComplete => " basis=complete"
    FlexSightingsBaselineIncomplete => " basis=INCOMPLETE (absent loading ids read UNREAD, not 0)"
  }
}

fn flex_carry_standing_word(carry: FlexCarry) -> String {
  match carry.standing {
    FlexCarryAsk { ask: _ } => " standing=yes"
    FlexCarryNoAsk => " standing=no"
    FlexCarryStandingUnknown { reason: _ } => concat(" standing=UNKNOWN (the create gate stays shut; ", concat(flex_carry_remedy, ")"))
  }
}

fn flex_carry_wire(reading: FlexCarryReading) -> String {
  match reading {
    FlexCarryLoaded { carry: c } =>
      concat(
        concat("carry=read sightings=", int_to_decimal_string(value: length(c.sightings))),
        concat(flex_carry_basis_word(carry: c), flex_carry_standing_word(carry: c)),
      )
    // The leading space in " ) --" is cosmetic, not a workaround: the parse failure this site went through
    // was an argument list left open, which the parser locates at the enclosing block's closing brace and
    // not at the call (see the note on flex_member_line and the recurring_failure_mode row filed for it).
    FlexCarryAbsent =>
      concat("carry=absent (no carry file at that path, established by listing the directory; absence is not a record that no ask is in flight, so the create gate stays shut; ", concat(flex_carry_remedy, ")"))
    FlexCarryUnread { reason: r } =>
      concat("carry=UNREAD (", concat(r, concat(" ) -- loading ages unread, the loading cut cannot fire, no cooldown claimed, the create gate stays shut; ", flex_carry_remedy)))
  }
}

// The read is a TYPED FILESYSTEM OBSERVATION, not a success flag: presence is established by listing the
// directory the carry lives in, so "no carry has ever been written" and "a carry is there and cannot be read"
// reach the pass as different facts. The fold used is the repo's own (extdeps.filesystem.filesystem_io), which
// also refuses the case where the listing says absent and the read still returned bytes.
fn flex_carry_read(path: String) -> FlexCarryReading {
  let listed = Filesystem.List(path: flex_pass_carry_directory)
  let read = Filesystem.Read(path: path)
  flex_carry_reading_of(
    listing: filesystem_listing_observation(
      directory: flex_pass_carry_directory,
      success: listed.success,
      entries: listed.entries,
      error: listed.error,
    ),
    read: filesystem_read_outcome(content: read.content, success: read.success, error: read.error),
    path: path,
  )
}

// THE FOLD OVER THE TWO OBSERVATIONS, apart from the effects that make them, so a witness supplies the
// observations and runs THIS mapping rather than constructing its result.
fn flex_carry_reading_of(listing: FilesystemListingObservation, read: FilesystemReadOutcome, path: String) -> FlexCarryReading {
  match filesystem_file_observation(listing: listing, name: flex_pass_carry_name, path: path, read: read) {
    FilesystemFileAbsent(absence) => FlexCarryAbsent
    FilesystemFileRead { content: content, path: _ } => flex_carry_gate(content: content)
    FilesystemFileIndeterminate { cause: c } => FlexCarryUnread { reason: c as NonEmptyStr }
    FilesystemFileObservationsDisagree { cause: c, path: _ } => FlexCarryUnread { reason: c as NonEmptyStr }
    FilesystemFileSubjectRefused { cause: c, directory: _, name: _ } => FlexCarryUnread { reason: c as NonEmptyStr }
  }
}

// TRUE when a line failed to parse. A named function, because a match inside a call argument does not
// parse in this grammar.
fn flex_carry_line_unread(l: FlexCarryLine) -> Bool {
  match l {
    FlexCarryLineUnread { text: _ } => true
    _ => false
  }
}

fn flex_carry_is_trailer(l: FlexCarryLine) -> Bool {
  match l {
    FlexCarryTrailer { count: _ } => true
    _ => false
  }
}

fn flex_carry_is_header(l: FlexCarryLine) -> Bool {
  match l {
    FlexCarryHeader => true
    _ => false
  }
}

fn flex_carry_is_standing(l: FlexCarryLine) -> Bool {
  match l {
    FlexCarryNoAskLine => true
    FlexCarryStandingUnknownLine => true
    FlexCarryAnswered { instance_id: _, machine_id: _, ask_id: _ } => true
    FlexCarryLost { machine_id: _, ask_id: _ } => true
    FlexCarryRefused { machine_id: _, ask_id: _ } => true
    _ => false
  }
}

fn flex_carry_is_basis(l: FlexCarryLine) -> Bool {
  match l {
    FlexCarrySightingsBasis { basis: _ } => true
    _ => false
  }
}

fn flex_carry_is_cooldown(l: FlexCarryLine) -> Bool {
  match l {
    FlexCarryCooldown { asked_at: _, until: _ } => true
    _ => false
  }
}

// The trailer is the LAST line and its count is the number of lines before it.
fn flex_carry_trailer_agrees(parsed: List<FlexCarryLine>, lines: Int) -> Bool {
  match parsed.skip(n: length(parsed) - 1).first() {
    Absent => false
    Present { value: l } =>
      match l {
        FlexCarryTrailer { count: n } => n == lines - 1
        _ => false
      }
  }
}

// THE GATE BEFORE THE FOLD. A carry is LOADED only when its first line is the declared header AND every
// line parsed; anything else is the typed unread standing, COUNTED. Two reasons, both from review 89192:
// the header was written but never checked, so a file in some other format read as valid v1; and a line
// the parser could not read was dropped silently, so a truncated file or a changed line format made the
// standing of the last create read as none - which is not "no ask in flight", it is "the pass cannot
// tell", and reading it as the first authorizes the second rent the carry exists to prevent. DESIGN 5: a
// failure arm refuses, never widens, and every degradation is typed, located and countable.
fn flex_carry_gate(content: String) -> FlexCarryReading {
  // A blank line is a separator, not a record: the writer's trailing newline must not read as an
  // unreadable record and refuse a carry that is fine. Every NON-BLANK line still has to parse, or the
  // whole carry reads unread -- that is the part that keeps a truncated write from reading as "no ask in
  // flight", which is the widening that authorizes a second rent on top of a card being paid for.
  let lines = filter(split(s: content, delimiter: "\n"), l => length(l) > 0)
  let parsed = map(lines, flex_carry_line)
  let unread = length(filter(parsed, flex_carry_line_unread))
  let trailers = length(filter(parsed, flex_carry_is_trailer))
  match first(lines) {
    Absent => FlexCarryUnread { reason: "the carry file is empty" as NonEmptyStr }
    Present { value: head } =>
      if !starts_with(s: head, prefix: flex_carry_header) {
        FlexCarryUnread { reason: concat("the carry header is not ", flex_carry_header) as NonEmptyStr }
      } else if unread > 0 {
        FlexCarryUnread {
          reason: concat(
            int_to_decimal_string(value: unread),
            " carry line(s) the pass could not parse",
          ) as NonEmptyStr,
        }
      } else if trailers != 1 || !flex_carry_trailer_agrees(parsed: parsed, lines: length(lines)) {
        FlexCarryUnread { reason: "the carry does not end with one `end <count>` trailer naming the number of lines before it, so it may have been cut off mid-write" as NonEmptyStr }
      } else if length(filter(parsed, flex_carry_is_header)) != 1 || length(filter(parsed, flex_carry_is_standing)) > 1 || length(filter(parsed, flex_carry_is_basis)) > 1 || length(filter(parsed, flex_carry_is_cooldown)) > 1 {
        FlexCarryUnread { reason: "the carry states a header, standing, basis or cooldown line more than once" as NonEmptyStr }
      } else {
        flex_carry_loaded(lines: lines)
      }
  }
}

// The fold, reached only through the gate above. The unread arm stays because the TYPE admits it; the gate
// has already refused that case, and the arm's answer is "contribute nothing" rather than a guess about
// what an unread line meant.
fn flex_carry_loaded(lines: List<String>) -> FlexCarryReading {
  FlexCarryLoaded {
    carry: fold(
      lines,
        init: FlexCarry {
          cooldown: none,
          basis: FlexSightingsBaselineIncomplete,
          sightings: [],
          // A carry that never states its standing does NOT default to "no ask in flight": it reads UNKNOWN,
          // which keeps the create gate shut. Every file this module writes states a standing line, so the
          // only way to reach this init is a hand-edited or truncated file.
          standing: FlexCarryStandingUnknown { reason: "the carry states no standing line, so the standing of the last ask is not recorded" },
        },
        f: (acc, line) =>
          match flex_carry_line(line: line) {
            FlexCarryHeader => acc
            FlexCarrySightingsBasis { basis: basis } =>
              FlexCarry { cooldown: acc.cooldown, basis: basis, sightings: acc.sightings, standing: acc.standing }
            FlexCarryCooldown { asked_at: asked_at, until: until } =>
              FlexCarry {
                cooldown: Present { value: FlexRentCooldown { asked_at: asked_at, until: until } },
                basis: acc.basis,
                sightings: acc.sightings,
                standing: acc.standing,
              }
            FlexCarryLoading { instance_id: instance_id, first_sampled_loading_ms: first_sampled_loading_ms } =>
              FlexCarry {
                cooldown: acc.cooldown,
                basis: acc.basis,
                sightings: concat(acc.sightings, [FlexLoadingSighting { instance_id: instance_id, first_sampled_loading_ms: first_sampled_loading_ms }]),
                standing: acc.standing,
              }
            FlexCarryNoAskLine =>
              FlexCarry { cooldown: acc.cooldown, basis: acc.basis, sightings: acc.sightings, standing: FlexCarryNoAsk }
            FlexCarryStandingUnknownLine =>
              FlexCarry {
                cooldown: acc.cooldown,
                basis: acc.basis,
                sightings: acc.sightings,
                standing: FlexCarryStandingUnknown { reason: "the carry records the standing of the last ask as unknown; a human must reconcile the account before a create is planned" },
              }
            FlexCarryAnswered { instance_id: instance_id, machine_id: machine_id, ask_id: ask_id } =>
              FlexCarry {
                cooldown: acc.cooldown,
                basis: acc.basis,
                sightings: acc.sightings,
                standing: FlexCarryAsk { ask: FlexCreateAnswered { instance_id: instance_id, machine_id: machine_id, ask_id: ask_id } },
              }
            FlexCarryLost { machine_id: machine_id, ask_id: ask_id } =>
              FlexCarry {
                cooldown: acc.cooldown,
                basis: acc.basis,
                sightings: acc.sightings,
                standing: FlexCarryAsk { ask: FlexCreateLost { ask_id: ask_id, machine_id: machine_id } },
              }
            FlexCarryRefused { machine_id: machine_id, ask_id: ask_id } =>
              FlexCarry {
                cooldown: acc.cooldown,
                basis: acc.basis,
                sightings: acc.sightings,
                standing: FlexCarryAsk { ask: FlexCreateRefused { ask_id: ask_id, machine_id: machine_id } },
              }
            FlexCarryTrailer { count: _ } => acc
            FlexCarryLineUnread { text: _ } => acc
          },
      ),
    }
}

fn flex_carry_prior_sightings(reading: FlexCarryReading) -> List<FlexLoadingSighting> {
  match reading {
    FlexCarryLoaded { carry: c } => c.sightings
    FlexCarryAbsent => []
    FlexCarryUnread { reason: _ } => []
  }
}

fn flex_carry_render(carry: FlexCarry) -> String {
  let basis_line = match carry.basis {
    FlexSightingsBaselineComplete => [flex_carry_line_sightings_complete]
    FlexSightingsBaselineIncomplete => [flex_carry_line_sightings_incomplete]
  }
  let cooldown_lines = match carry.cooldown {
    Absent => []
    Present { value: c } =>
      [concat(concat(flex_carry_prefix_cooldown, int_to_decimal_string(value: c.asked_at)), concat(" ", int_to_decimal_string(value: c.until)))]
  }
  let loading_lines = map(carry.sightings, s =>
    concat(concat(flex_carry_prefix_loading, int_to_decimal_string(value: s.instance_id)), concat(" ", int_to_decimal_string(value: s.first_sampled_loading_ms))))
  // Exactly one standing line is always written: the file states its standing or it does not load trusted.
  // The UNKNOWN reason is not round-tripped as text -- the line records the STATE, and the reason the pass
  // that found the corruption printed is in that pass's receipt; re-deriving a cause string from a file that
  // lost the cause would be a fabricated explanation.
  let standing_lines = match carry.standing {
    FlexCarryNoAsk => [flex_carry_line_standing_none]
    FlexCarryStandingUnknown { reason: _ } => [flex_carry_line_standing_unknown]
    FlexCarryAsk { ask: FlexCreateAnswered { instance_id: id, machine_id: machine, ask_id: ask } } =>
      [concat(concat(flex_carry_prefix_answered, int_to_decimal_string(value: id)), concat(concat(" ", int_to_decimal_string(value: machine)), concat(" ", int_to_decimal_string(value: ask))))]
    FlexCarryAsk { ask: FlexCreateLost { ask_id: ask, machine_id: machine } } =>
      [concat(concat(flex_carry_prefix_lost, int_to_decimal_string(value: machine)), concat(" ", int_to_decimal_string(value: ask)))]
    FlexCarryAsk { ask: FlexCreateRefused { ask_id: ask, machine_id: machine } } =>
      [concat(concat(flex_carry_prefix_refused, int_to_decimal_string(value: machine)), concat(" ", int_to_decimal_string(value: ask)))]
  }
  let body = concat([flex_carry_header], concat(basis_line, concat(cooldown_lines, concat(loading_lines, standing_lines))))
  join(concat(body, [concat(flex_carry_prefix_end, int_to_decimal_string(value: length(body)))]), "\n")
}

// WHAT THE NEXT PASS READS. A create this pass PERFORMED supersedes the standing carried in: there is
// only ever one ask in flight, because the cooldown blocks a second until it expires. Otherwise the
// standing survives, and only one verdict retires it -- FlexMayAcquire, the roster showing nothing that
// matches the ask, which is the end of what there is to reconcile (and the cooldown that was recorded at
// ASK time still covers the window in which a lost answer could land). An instance the roster DOES show
// stays carried: it is held, and the allocation slice is what consumes that standing. An expired
// cooldown is dropped, not rewritten: it has done its work.
fn flex_carry_after(
  prior: FlexCarryReading,
  roster: FlexInstancesStanding,
  carried: FlexSightingsCarried,
  outcome: FlexPassOutcome,
  now: EpochMs,
) -> FlexCarry {
  let known = match prior {
    FlexCarryLoaded { carry: c } => c
    // An absent prior is NOT a first pass with nothing in flight: the file's absence does not say the last ask
    // is gone, so the UNKNOWN standing is written forward exactly as an unread prior's is.
    FlexCarryAbsent =>
      FlexCarry { cooldown: none, basis: FlexSightingsBaselineIncomplete, sightings: [], standing: FlexCarryStandingUnknown { reason: flex_carry_absent_reason as NonEmptyStr } }
    // The unread prior does NOT become an empty carry: the standing it could not state is written forward as
    // UNKNOWN, so the next pass reads the same fact this pass read (review 89235). The sightings and cooldown
    // this pass observed are still written -- losing those would freeze the loading cut and stop the pass
    // destroying a card it can already see is dead.
    FlexCarryUnread { reason: r } =>
      FlexCarry {
        cooldown: none,
        basis: FlexSightingsBaselineIncomplete,
        sightings: [],
        standing: FlexCarryStandingUnknown { reason: r },
      }
  }
  let standing = match outcome {
    FlexPassCreated { standing: s, cooldown: _, allocation: _ } => FlexCarryAsk { ask: s }
    _ =>
      match known.standing {
        FlexCarryNoAsk => FlexCarryNoAsk
        FlexCarryStandingUnknown { reason: r } => FlexCarryStandingUnknown { reason: r }
        FlexCarryAsk { ask: s } =>
          match flex_reconcile_acquisition(standing: s, roster: roster) {
            FlexMayAcquire => FlexCarryNoAsk
            _ => FlexCarryAsk { ask: s }
          }
      }
  }
  let cooldown = match outcome {
    FlexPassCreated { standing: _, cooldown: c, allocation: _ } => Present { value: c }
    _ =>
      match known.cooldown {
        Absent => none
        Present { value: c } => if (c.until > now) { Present { value: c } } else { none }
      }
  }
  FlexCarry { cooldown: cooldown, basis: carried.basis, sightings: carried.sightings, standing: standing }
}

fn flex_cards_list(c: FlexRosterCards) -> List<FlexOwnedCard> {
  match c {
    FlexRosterCardsBuilt { cards: cards, unread: _ } => cards
    _ => []
  }
}

fn flex_cards_wire(c: FlexRosterCards) -> String {
  match c {
    FlexRosterCardsBuilt { cards: cards, unread: unread } =>
      concat(concat(concat("cards=built n=", int_to_decimal_string(value: length(cards))), " unread="), int_to_decimal_string(value: length(unread)))
    FlexRosterCardsUnobserved => "cards=unobserved (the instance walk never began, so nothing is held)"
    FlexRosterCardsUnreadable => "cards=unreadable (the instance walk was refused, so what is held is unknown)"
    FlexRosterCardsNeedsExhaustedRoster => "cards=partial (the instance walk did not finish, so what is held is under-counted)"
  }
}

fn flex_reconcile_wire(reading: FlexCarryReading, roster: FlexInstancesStanding) -> String {
  match flex_carry_standing(reading: reading) {
    Absent => "reconcile=no-ask (no create standing carried)"
    Present { value: s } =>
      match flex_reconcile_acquisition(standing: s, roster: roster) {
        FlexAlreadyHeld { instance: i } =>
          concat(concat("reconcile=already-held instance=", int_to_decimal_string(value: i.id)), " (the create landed: the cap counts it, no second create is planned)")
        FlexAcquisitionUnknown => "reconcile=unknown (the account could not be read; the ask may still land, the cooldown holds)"
        FlexMayAcquire => "reconcile=not-held (nothing in the account matches the ask)"
        FlexReconcileNeedsExhaustedRoster => "reconcile=partial (the instance walk did not finish)"
      }
  }
}

// ---- THE PASS.
// Whether the pass managed to record what the NEXT pass needs. A create that lands while its ask goes
// unrecorded is the double-rent hazard: the next pass reads a stale carry, concludes nothing is in flight,
// and rents again on top of a card the account is already paying for. So a failed carry write is a typed
// failure the dispatch sees, not a word inside the receipt (review 89192): the effect the pass already
// performed stays in the receipt, and the run itself stops failing.
type FlexCarryWrite
  = FlexCarryWritten
  | FlexCarryWriteSkipped { because: NonEmptyStr }
  | FlexCarryWriteFailed { error: String }

type FlexPassReport { receipt: String, carry: FlexCarryWrite }

fn flex_pass_with_key(key: Secret, resolved_version: NonEmptyStr, now: EpochMs) -> FlexPassReport uses net: Network {
  let instance_walk = flex_walk_instances(key: key, after: none, walk: FlexInstanceWalk { pages: [], refused: none }, budget: flex_walk_page_budget)
  let instances = flex_instances_standing(walk: instance_walk)
  let filter = vast_ai_charges_day_filter(range: VastAiChargesDayRange { gte: flex_trial_charges_from / milliseconds_per_second(), lte: now / milliseconds_per_second() })
  let charge_walk = flex_walk_charges(key: key, filter: filter, after: none, walk: FlexChargeWalk { pages: [], refused: none }, budget: flex_walk_page_budget)
  let charges = flex_charges_standing(walk: charge_walk)
  // THE OBSERVED STATE, READ BEFORE THE DECISION: what the labelled roster says we hold, aged by the
  // sightings an earlier pass left, and the standing of the last create ask. Both come from the carry
  // file, because neither is on the Vast wire.
  let carry = flex_carry_read(path: flex_pass_carry_path)
  let cards = flex_cards_from_roster(
    ours: flex_owner_label_gunbc_flex,
    roster: instances,
    sightings: flex_carry_sightings(reading: carry),
    now: now,
  )
  match flex_vast_offer_query(recipe: flex_serving_recipe) {
    Absent =>
      FlexPassReport { receipt: join(["key=live secret_manager version=", resolved_version as String, "\n", flex_instances_wire(s: instances), flex_walk_refusal_wire(refused: instance_walk.refused), "\n", flex_charges_wire(s: charges), "\noffers=unsearched (the recipe has no Vast host filters)"], ""), carry: FlexCarryWriteSkipped { because: "the pass made no decision to carry: the recipe has no Vast host filters, so no offer search ran" as NonEmptyStr } }
    Present { value: query } =>
  match flex_search(key: key, q: query) {
    FlexOffersRefused { cause: c } =>
      FlexPassReport { receipt: join(["key=live secret_manager version=", resolved_version as String, "\n", flex_instances_wire(s: instances), flex_walk_refusal_wire(refused: instance_walk.refused), "\n", flex_charges_wire(s: charges), "\noffers=refused ", c], ""), carry: FlexCarryWriteSkipped { because: "the pass made no decision to carry: the offers refused" as NonEmptyStr } }
    FlexOffersAnswered { offers: offers, hosts: hosts } =>
      let screened = map(offers, o => FlexScreenedOffer {
        offer: o,
        entry: match first_where(hosts, h => h.id == o.id) {
          Absent => ShadowEntryExcluded
          Present { value: h } => flex_offer_in_shadow_field(offer: o, host: h, search_type: query.search_type)
        },
        quote: flex_offer_quote(offer: o, recipe: flex_serving_recipe),
      })
      let input = FlexPassInput {
          policy: flex_trial_policy,
          recipe: flex_serving_recipe,
          gates: FlexWetGates { key: FlexKeyLive { route: FlexKeyFromSecretManager { resolved_version: resolved_version } } },
          now: now,
          cooldown: flex_carry_cooldown(reading: carry),
          carry: flex_carry_trust(reading: carry),
          observation: FlexPassObservation { roster: instances, charges: charges },
          cards: flex_cards_list(c: cards),
          allocations: [],
          intent: none,
          template_hashes: flex_vast_template_hashes,
          no_room: false,
          replacement_serving: false,
        }
      let members = map(screened |> filter(s => flex_entry_member(entry: s.entry)), s => flex_member_walls(input: input, s: s))
      let outcome = flex_run_pass(input: input, api_key: key, releasing: none)
      // THE CARRY FOR THE NEXT PASS: the sightings this pass took (first-sighting times kept, new
      // loadings sighted now, anything no longer loading dropped), the standing of the ask this pass
      // made or inherited, and the cooldown it recorded. Written whether or not the pass wrote to Vast:
      // the observations it made are what the next pass needs either way.
      let prior_sightings = flex_carry_prior_sightings(reading: carry)
      let carry_out = flex_carry_after(
        prior: carry,
        roster: instances,
        carried: flex_loading_sightings_after(
          ours: flex_owner_label_gunbc_flex,
          roster: instances,
          prior: prior_sightings,
          now: now,
        ),
        outcome: outcome,
        now: now,
      )
      let carry_written = Filesystem.Write(path: flex_pass_carry_path, content: flex_carry_render(carry: carry_out))
      let carry_write = if carry_written.success {
        FlexCarryWritten
      } else {
        FlexCarryWriteFailed { error: carry_written.error }
      }
      let carry_write_word = match carry_write {
        FlexCarryWritten => concat("written ", flex_pass_carry_path)
        FlexCarryWriteSkipped { because: b } => concat("skipped: ", b)
        FlexCarryWriteFailed { error: e } => concat("WRITE FAILED: ", e)
      }
      FlexPassReport { receipt: join([
        "key=live secret_manager version=", resolved_version as String, "\n",
        flex_instances_wire(s: instances), flex_walk_refusal_wire(refused: instance_walk.refused), "\n",
        flex_charges_wire(s: charges), flex_walk_refusal_wire(refused: charge_walk.refused), "\n",
        "offers=", int_to_decimal_string(value: length(offers)), " members=", int_to_decimal_string(value: length(members)), "\n",
        join(map(members, m => flex_member_line(m: m)), "\n"), "\n",
        flex_cards_wire(c: cards), " ", flex_reconcile_wire(reading: carry, roster: instances), "\n",
        "selection=needs-evidence (select_supply unwired: product.fabric.flex_vast_loop flex_select_supply_consumer_frontier)\n",
        "outcome=", flex_pass_outcome_wire(outcome: outcome), "\n",
        "carry=", carry_write_word,
      ], ""), carry: carry_write }
  }
  }
}

// The exit the dispatch sees: a pass that could not record its own carry fails the run, a skipped write
// does not (it made no decision to carry).
fn flex_pass_exit(carry: FlexCarryWrite) -> ProcessExit {
  match carry {
    FlexCarryWriteFailed { error: e } => exit_failure(reason: concat("THE PASS COULD NOT RECORD ITS CARRY: ", e))
    FlexCarryWritten => ExitSuccess
    FlexCarryWriteSkipped { because: _ } => ExitSuccess
  }
}

fn pass() -> ProcessExit uses net: Network {
  match observer_clock_read() {
    ObserverClockUnreadable { detail: d } => exit_failure(reason: concat("THE CLOCK COULD NOT BE READ: ", d))
    ObserverClockObserved { instant: at } =>
      match flex_vast_key() {
        FlexVastKeyRefused { cause: cause } => exit_failure(reason: cause as String)
        FlexVastKeyReady { key: key, resolved_version: v } => {
          let report = flex_pass_with_key(key: key, resolved_version: v, now: observer_instant_millis(instant: at))
          let written = Filesystem.Write(path: flex_pass_receipt_path, content: report.receipt)
          if !written.success {
            exit_failure(reason: concat("THE RECEIPT COULD NOT BE WRITTEN: ", written.error))
          } else {
            // The receipt is written either way, so the effect the pass performed is on record. But a pass
            // that could not record its OWN carry must not report success: the next pass would read a stale
            // carry and treat an ask that may still land as no ask at all. Failing the run is the typed
            // refusal; proceeding would be the escape hatch DESIGN 5 forbids.
            flex_pass_exit(carry: report.carry)
          }
        }
      }
  }
}
