module gunbc.fleet.approval_ntfy_retirement

// THE RETIREMENT OF THE srv1 PUSH TRANSPORT, as one actuation.
//
// WHAT IS RETIRED, AND WHY IT MAY BE. The approval route an operator uses is the Approve app: a
// device-signed decision read back from the broker's own store (gunbc.design_ruling
// one_approval_route_for_every_privileged_action). The push transport that used to carry an approval
// link to a phone -- an ntfy server on srv1, its tailscale front door, its service account, its
// publisher token and its subscriber grant -- stopped being consulted when that route closed
// (#15146, 3ccb6e4, deleted the publish side). What remained was the server itself: installed,
// enabled, fronted, and holding a database of grants nobody reads. A retired route whose carrier is
// still running is a standing effect with no purpose, and an unattended listener on a production
// host is exactly the surface the corpus keeps shrinking.
//
// THE FRONTIER THAT NAMED THIS CHANGE lived in the deployment module as
// approval_ntfy_retirement_frontier: one change that uninstalls the server, reads its absence back,
// and deletes the deployment model with it. This module is that change's ACTUATION arm; the model
// it dissolves is gone from the corpus, and the paths below are the removal roster, restated here
// because the module that used to own them no longer exists to be read.
//
// HOW IT RUNS, AND WHO SAYS YES. The uninstall is a root mutation on srv1, so it runs as a kind of
// the existing fleet-converge job (gunbc.fleet.fleet_converge_workflow ApprovalNtfyRetire), under
// the same inherited approval as every other srv1 root-mutation arm: the job files one signed broker
// request, the operator approves it on the phone, and nothing on the host happens until that
// standing reads as admitted (gunbc.fleet.srv1_root_mutation_approval_run
// srv1_root_mutation_inherited_grant). No step runs on an unapproved run, and no step runs by hand:
// the operator's GO authorizes this actuation, not a session typing ssh.
//
// WHY THE READBACK IS PART OF THE ACT. An uninstall that reports "the commands exited 0" has not
// shown the thing is gone -- a leg can succeed against an already-absent member and say nothing, and
// a member can survive a leg that succeeded. So the run reads each member back by its own absence
// (unit LoadState not-found, the account unresolvable, the paths untestable, the front-door route
// absent from tailscale's own status) and prints the verdicts as the receipt. The receipt is what the
// operator sees after the fact; the approval is what they saw before it.

import std.types { NonEmptyStr, String, Bool, List, Int, Port }
import std.process { ProcessExit, ExitSuccess, exit_failure }
import std.algebra { list_at_optional }
import extdeps.filesystem.filesystem_io { Filesystem }
import std.optional { Present, Absent }
import std.scoped_authorization { AuthorizationScope }
import gunbc.fleet.fleet_host_identity { operator_host_srv1 }
import gunbc.fleet.fleet_bootstrap_principal { executor_bootstrap_principal }
import gunbc.fleet.fleet_reach_endpoint { fleet_probe_endpoint_for }
import gunbc.fleet.fleet_known_hosts_anchor {
  SshTarget, SshTargetResolution, SshTargetRefused, SshTargetResolved, FleetSshExecutionContext,
  fleet_ssh_target_at_standard_port, ssh_target_refusal_text,
}
import gunbc.fleet.fleet_ssh_locus { prepare_fleet_ssh_agent_context, FleetSshContextReady, FleetSshContextRefused }
import gunbc.typed_argv_exec { typed_argv_exec_over_fleet_ssh, TypedArgvExecConverged, TypedArgvExecRefused }
import extdeps.ssh.session { SshSessionExecResult }
import gunbc.fleet.srv1_root_mutation_approval_run {
  srv1_root_mutation_inherited_grant, Srv1InheritedGrantAdmitted, Srv1InheritedGrantRefused,
  approval_ntfy_retire_root_scopes,
}
import gunbc.actions_run_binding { actions_variable_trimmed }
import extdeps.sudo.elevation { sudo_elevate }
import extdeps.systemd.systemctl {
  systemctl_stop_argv, systemctl_disable_now_argv, systemctl_daemon_reload_argv, systemctl_show_load_state_argv,
}
import extdeps.tools.gnu_coreutils { coreutils_rm_force_argv, coreutils_rm_force_recursive_argv }
import extdeps.shadow.account_deletion {
  userdel_remove_account_argv, userdel_user_not_found_exit, groupdel_remove_group_argv,
  groupdel_group_not_found_exit,
}
import extdeps.tailscale.serve {
  TailscaleServeEndpoint, TailscaleServeMount, ServeRootMount, tailscale_serve_off_command,
  tailscale_serve_status_json_command, tailscale_serve_status_route_proxy_targets, tailscale_serve_route_key,
  TailscaleServeStatusProjection, ServeStatusProxies, ServeStatusUnreadable,
}
// THE PROGRAM NAME IS NOT THIS MODULE'S TO SPELL. tailscale's own argv builders return the arguments
// WITHOUT the binary (the systemctl builders spell theirs), so the off command and the status command
// are taken as ArgvCommand and rendered with argv_words -- the same way gunbc.live_deploy.tailnet_door_cutover_host
// reads the serve status. A hand-written ["serve", ...] under `sudo -n --` asks sudo to run a program
// named `serve`, which is exactly how the first actuation of this retirement failed.
import extdeps.exec.command { argv_words }
import extdeps.posix.getent { getent_key_not_found_exit, getent_group_command }

// ── The removal roster ─────────────────────────────────────────────────────────────────────────
// EVERY MEMBER THE FRONTIER NAMED, with the path the host actually carries -- read off srv1 on
// 2026-10-30 before this change, not restated from memory. The roster is a LIST so the run's
// completeness is checkable against it: a member that is neither removed nor read back is a gap a
// witness can count.

data ntfy_retire_unit_name: NonEmptyStr = "gunbc-ntfy.service"
data ntfy_retire_unit_path: NonEmptyStr = "/etc/systemd/system/gunbc-ntfy.service"
data ntfy_retire_account_name: NonEmptyStr = "gunbc-ntfy"
// THE GROUP THE ACCOUNT LEFT BEHIND, named because removing the identity does not remove it.
// userdel(8) deletes the user; a group of the same name survives whenever it has another member, and
// this one does: srv1 still carries `gunbc-ntfy:x:984:briansrls` (gid 984, the same number the account
// had as its primary gid) after the account was retired, because the fleet administrator was listed in
// it while the publisher ran. An operator-approved retirement of ntfy that stops at the account would
// leave a group named after a retired transport on a production host, and a future `useradd gunbc-ntfy`
// would silently re-adopt gid 984 and its memberships. So the group is a member of the roster in its own
// right, read by `getent group` and removed by groupdel -- never inferred from the account's absence,
// which is precisely the state that proves the inference wrong. The name coincides with the account's
// because useradd(8) creates a private group of the user's name by default (USERGROUPS_ENAB); the two
// are stated SEPARATELY because the group is read and removed by its own name and its lifetime is its
// own, and the coincidence is something the witness checks rather than something this module leans on.
data ntfy_retire_group_name: NonEmptyStr = "gunbc-ntfy"
data ntfy_retire_config_dir: NonEmptyStr = "/etc/gunbc-ntfy"
data ntfy_retire_state_root: NonEmptyStr = "/var/lib/gunbc-ntfy"
data ntfy_retire_binary_path: NonEmptyStr = "/usr/local/bin/ntfy"

// THE FRONT DOOR, as tailscale names it: the HTTPS port and the root mount that proxied to the
// server's loopback listener. The backend word is what the handler was configured with; `off` is
// addressed by port and mount, and the backend is carried here because this module's endpoint form
// requires it, not because removal needs it.
data ntfy_retire_front_door_port: Port = 8443
data ntfy_retire_listen_backend: NonEmptyStr = "http://127.0.0.1:2586"

data ntfy_retire_front_door_endpoint: TailscaleServeEndpoint = TailscaleServeEndpoint {
  https_port: ntfy_retire_front_door_port,
  mount: ServeRootMount,
  backend: ntfy_retire_listen_backend,
}

// THE ROSTER, in the order the members come off. Removal order matters: the unit is stopped and
// disabled before its file goes, the file before daemon-reload, the account before its directories,
// so no leg leaves a running process holding a tree it is about to delete. The GROUP comes off right
// after the account it was named for: while the account exists the group is its primary gid, and a
// groupdel that ran first would be refused for owning a live user's primary group -- a refusal this
// module reads as divergence, which is right but wasteful when the ordered legs make it impossible.
data ntfy_retire_members: List<NtfyRetireMember> = [
  MemberUnit,
  MemberFrontDoor,
  MemberAccount,
  MemberGroup,
  MemberConfigDir,
  MemberStateRoot,
  MemberBinary,
]

// ── What the operator is asked to approve ──────────────────────────────────────────────────────
// THE SCOPES THIS ARM REQUIRES live with the job's approval root, in
// gunbc.fleet.srv1_root_mutation_approval_run approval_ntfy_retire_root_scopes: the same value is
// what the census row cites and what this run checks its inherited grant against, so the two cannot
// drift. They are REMOVAL actions on the roster's own paths -- not the install actions the root
// already carries -- because an approval to put something on the host is not an approval to take it
// off. The run below inherits through srv1_root_mutation_inherited_grant, which refuses any leg the
// approved root does not cover.

// ── The legs ───────────────────────────────────────────────────────────────────────────────────
// EVERY LEG IS ABSOLUTE-PATH ARGV THROUGH THE SAME ELEVATED TRANSPORT the other srv1 arms use: the
// fleet administrator over SSH, sudo -n in front, no shell metacharacters (gunbc.typed_argv_exec's
// portable-word rule). The unit is stopped and disabled BY NAME -- no process is signalled by
// pattern, no package manager is invoked: the binary was installed by hand, so it comes off by hand.

fn ntfy_retire_stop_unit_argv() -> List<String> {
  systemctl_stop_argv(unit: ntfy_retire_unit_name)
}

// disable --now, not bare disable: the stop leg above is what the operator's ruling named, and the
// disable carries --now so a unit that came back between the two legs is stopped by the same leg
// that removes it from the boot set.
fn ntfy_retire_disable_unit_argv() -> List<String> {
  systemctl_disable_now_argv(unit: ntfy_retire_unit_name)
}

// THE REMOVALS AS DATA. Each removal names the path it removes and whether it is a tree, and the
// legs are BUILT from this list -- so the target a leg removes and the target the discipline below
// checks are the same value, and there is no second list for a witness to hold equal to the first.
data ntfy_retire_roster_paths: List<String> = [
  ntfy_retire_unit_path as String,
  ntfy_retire_config_dir as String,
  ntfy_retire_state_root as String,
  ntfy_retire_binary_path as String,
]

type NtfyRetireRemoval {
  target: String
  recursive: Bool
}

data ntfy_retire_removals: List<NtfyRetireRemoval> = [
  NtfyRetireRemoval { target: ntfy_retire_unit_path as String, recursive: false },
  NtfyRetireRemoval { target: ntfy_retire_config_dir as String, recursive: true },
  NtfyRetireRemoval { target: ntfy_retire_state_root as String, recursive: true },
  NtfyRetireRemoval { target: ntfy_retire_binary_path as String, recursive: false },
]

// A REMOVAL TARGET MUST BE A ROSTER LITERAL: non-empty, absolute, and one of the paths the roster
// states. An empty target is the classic way a recursive removal eats a host, a relative one is
// read against whatever directory the leg happens to land in, and a target DERIVED from a roster
// path -- its parent, its mount point, "/" -- is a different tree than the one the operator approved
// under a name the approval never used. This is checked before any leg runs, not only witnessed.
fn ntfy_retire_removal_target_is_stated(target: String) -> Bool {
  string_length(s: target) > 0
    && substring(s: target, start: 0, end: 1) == "/"
    && any(ntfy_retire_roster_paths, p => p == target)
}

fn ntfy_retire_removals_are_stated() -> Bool {
  all(ntfy_retire_removals, r => ntfy_retire_removal_target_is_stated(target: r.target))
}

fn ntfy_retire_removal_argv(r: NtfyRetireRemoval) -> List<String> {
  if r.recursive {
    coreutils_rm_force_recursive_argv(path: r.target as NonEmptyStr)
  } else {
    coreutils_rm_force_argv(paths: [r.target])
  }
}

fn ntfy_retire_remove_unit_file_argv() -> List<String> {
  ntfy_retire_removal_argv(r: NtfyRetireRemoval { target: ntfy_retire_unit_path as String, recursive: false })
}

fn ntfy_retire_daemon_reload_argv() -> List<String> {
  systemctl_daemon_reload_argv()
}

fn ntfy_retire_remove_account_argv() -> List<String> {
  userdel_remove_account_argv(account: ntfy_retire_account_name)
}

// The group leg's argv is the group's OWN name, not the account's: the two strings happen to be equal
// today (and a witness says so), but the leg removes a group database entry, so it is spelled from the
// roster's group member.
fn ntfy_retire_remove_group_argv() -> List<String> {
  groupdel_remove_group_argv(group: ntfy_retire_group_name)
}

fn ntfy_retire_remove_config_dir_argv() -> List<String> {
  ntfy_retire_removal_argv(r: NtfyRetireRemoval { target: ntfy_retire_config_dir as String, recursive: true })
}

fn ntfy_retire_remove_state_root_argv() -> List<String> {
  ntfy_retire_removal_argv(r: NtfyRetireRemoval { target: ntfy_retire_state_root as String, recursive: true })
}

fn ntfy_retire_remove_binary_argv() -> List<String> {
  ntfy_retire_removal_argv(r: NtfyRetireRemoval { target: ntfy_retire_binary_path as String, recursive: false })
}

fn ntfy_retire_front_door_off_argv() -> List<String> {
  argv_words(command: tailscale_serve_off_command(endpoint: ntfy_retire_front_door_endpoint))
}

// THE ROSTER MEMBERS ARE A CLOSED SET, so they are a coproduct and not six strings. A leg's subject
// and a verdict's member are the SAME type, which is what makes the resume rule decidable: the join in
// ntfy_retire_leg_decision cannot be fed a spelling the readback never emits, so "nothing was read
// about this member" stops being a state reachable by accident. DESIGN.md 5: "Stronger than catching a
// wrong state is making it unwritable -- correctness by construction, not validation." A typo in a
// string roster row would have skipped nothing and said nothing; it would only have made every leg for
// that member run on every pass -- the very failure this module exists to survive.
type NtfyRetireMember
  = MemberUnit
  | MemberFrontDoor
  | MemberAccount
  | MemberGroup
  | MemberConfigDir
  | MemberStateRoot
  | MemberBinary

// THE LEGS IN ORDER, each named. The name is what a refusal says: "unit-stop refused: ..." is a
// locator, where an unnamed chain of legs would leave the operator reading exit codes. SUBJECT is the
// roster member the leg removes: the pre-leg reads decide whether it has anything to do (see
// ntfy_retire_leg_should_run), so the subject must be the member the readback attests, not a free text.
type NtfyRetireLeg {
  name: String
  argv: List<String>
  subject: NtfyRetireMember
  // The exit code this leg's tool returns when the thing it was told to remove is NOT on the host at
  // all. Most tools have no such answer -- systemctl stops a unit that is not running without
  // complaint, `rm -f` and `tailscale serve --https=8443 off` report nothing -- so they declare
  // NoSubjectAbsentAnswer and any non-zero exit is a plain failure. userdel(8) is the one leg that
  // answers "that user does not exist" (exit 6), and that answer is a DIVERGENCE, not a success: the
  // roster this retirement was approved against lists the account as installed, so a host that says
  // otherwise has been changed by something outside this corpus. The leg refuses, and refuses with the
  // divergence named, rather than reporting a removal it did not perform or swallowing it as success.
  subject_absent: NtfyRetireSubjectAbsentAnswer
}

type NtfyRetireSubjectAbsentAnswer
  = NoSubjectAbsentAnswer
  | SubjectAbsentExit { exit_code: Int }

data ntfy_retire_legs: List<NtfyRetireLeg> = [
  NtfyRetireLeg { name: "unit-stop", subject: MemberUnit, argv: ntfy_retire_stop_unit_argv(), subject_absent: NoSubjectAbsentAnswer },
  NtfyRetireLeg { name: "unit-disable", subject: MemberUnit, argv: ntfy_retire_disable_unit_argv(), subject_absent: NoSubjectAbsentAnswer },
  NtfyRetireLeg { name: "unit-file-remove", subject: MemberUnit, argv: ntfy_retire_remove_unit_file_argv(), subject_absent: NoSubjectAbsentAnswer },
  NtfyRetireLeg { name: "daemon-reload", subject: MemberUnit, argv: ntfy_retire_daemon_reload_argv(), subject_absent: NoSubjectAbsentAnswer },
  NtfyRetireLeg { name: "account-remove", subject: MemberAccount, argv: ntfy_retire_remove_account_argv(), subject_absent: SubjectAbsentExit { exit_code: userdel_user_not_found_exit } },
  // The group is removed by its own leg, on its own subject, with groupdel's "group does not exist"
  // declared as the answer that is NOT success: if this leg runs and gets it, the `getent group` read
  // that said the group was there has diverged from the group database between the two, and the run
  // refuses rather than calling a vanished group a retirement.
  NtfyRetireLeg { name: "group-remove", subject: MemberGroup, argv: ntfy_retire_remove_group_argv(), subject_absent: SubjectAbsentExit { exit_code: groupdel_group_not_found_exit } },
  NtfyRetireLeg { name: "config-dir-remove", subject: MemberConfigDir, argv: ntfy_retire_remove_config_dir_argv(), subject_absent: NoSubjectAbsentAnswer },
  NtfyRetireLeg { name: "state-root-remove", subject: MemberStateRoot, argv: ntfy_retire_remove_state_root_argv(), subject_absent: NoSubjectAbsentAnswer },
  NtfyRetireLeg { name: "binary-remove", subject: MemberBinary, argv: ntfy_retire_remove_binary_argv(), subject_absent: NoSubjectAbsentAnswer },
  NtfyRetireLeg { name: "front-door-off", subject: MemberFrontDoor, argv: ntfy_retire_front_door_off_argv(), subject_absent: NoSubjectAbsentAnswer },
]

// ── The readback ───────────────────────────────────────────────────────────────────────────────
// ABSENCE IS READ BY EACH MEMBER'S OWN TEST, not by the exit code of the leg that removed it, and
// every test here has THREE outcomes: the member is ABSENT, the member is STILL PRESENT, or the read
// is UNREADABLE and says nothing about the member at all. The third is neither of the other two, and
// printing it as either one -- above all as absence -- is the fabricated default DESIGN.md 5 refuses:
// a run that observed nothing must not report a retirement.

// A PATH PROBE: `test -e <path>` over the elevated transport. test(1) exits 0 when the operand is
// there and 1 when it is not; it exits 2 on its OWN error -- a parent it cannot stat, an operand it
// cannot parse -- and `sudo -n` exits 1 when it refuses to run non-interactively. So the exit code by
// itself cannot separate "the path is gone" from "the probe never ran", and treating any non-zero
// exit as absence is a silent widen: it prints `absent:` for a read that never happened. Only exit 1
// is absence, and the elevation control below is what makes exit 1 worth believing.
fn ntfy_retire_path_probe_argv(path: NonEmptyStr) -> List<String> {
  ["test", "-e", path as String]
}

data ntfy_retire_present_path_exit: Int = 0
data ntfy_retire_absent_path_exit: Int = 1

// THE ELEVATION CONTROL, run before any absence is claimed. A probe that answers "not there" is only
// evidence if the same probe could have answered "there", and `/` is always there: `test -d /` over
// the same elevated transport must exit 0. When it does not, sudo refused, the transport is broken,
// or the host is not the host the roster describes -- and in every one of those cases the run refuses
// to read ANY absence rather than reporting a retirement it never observed. This is also what keeps a
// sudo refusal (exit 1, the same code as absence) from being mistaken for a retired member.
data ntfy_retire_elevation_control_argv: List<String> = ["test", "-d", "/"]

fn ntfy_retire_elevation_control_is_proven(exit_code: Int) -> Bool {
  exit_code == ntfy_retire_present_path_exit
}

// ONE READ OUTCOME, shared by every prober in this module: the read answered "the member is there",
// answered "the member is gone", or did not answer about the member at all. ONE type, because the
// alternative -- a pair of Bool predicates per prober -- makes the answer depend on the ORDER of the
// checks in each verdict: swap two branches and an unread read is reported as an absent one. Here the
// prober returns which of the three it got, and the verdict is a total match over that. The evidence
// travels with the state, so the receipt prints the test that decided it rather than a restatement.
type NtfyRetireRead
  = ReadPresent { evidence: String }
  | ReadAbsent { evidence: String }
  | ReadUnreadable { evidence: String }

// THE PATH PROBER. test(1) exits 0 when the operand is there and 1 when it is not; it exits 2 on its
// OWN error -- a parent it cannot stat, an operand it cannot parse -- and `sudo -n` exits 1 when it
// refuses to run non-interactively. So the exit code by itself cannot separate "the path is gone" from
// "the probe never ran", and treating any non-zero exit as absence is a silent widen: it prints
// `absent:` for a read that never happened. Only exit 1 is absence, and the elevation control below is
// what makes exit 1 worth believing.
fn ntfy_retire_path_read(exit_code: Int) -> NtfyRetireRead {
  if exit_code == ntfy_retire_present_path_exit {
    ReadPresent { evidence: "test -e exited 0: the path is still there" }
  } else if exit_code == ntfy_retire_absent_path_exit {
    ReadAbsent { evidence: "test -e exited 1: the path is not there" }
  } else {
    ReadUnreadable { evidence: concat("test -e exited ", concat(to_string(exit_code), ": a probe error, not an absence")) }
  }
}

// The two LoadState words this model understands: not-found is systemd's own answer for a unit it
// cannot load, loaded is its answer for a unit that exists. Anything else it answers is a read this
// model does not interpret, and is reported as unreadable rather than being voted into one of the
// three states by a substring test.
data ntfy_retire_unit_load_state_absent: String = "not-found"
data ntfy_retire_unit_load_state_loaded: String = "loaded"

// THE SYSTEMD PROBER. systemd answers for a unit it cannot load with LoadState=not-found and exit 0,
// so the answer is read from the property VALUE the read asks for (--value prints the value alone),
// not from the exit code. Only the two LoadState words this model understands answer anything: a
// non-zero exit, or a value that is neither not-found nor loaded (masked, failed, active, a usage
// line, a truncated pipe), is a read this model does not interpret -- and an uninterpreted read is
// not an absent unit.
fn ntfy_retire_load_state_read(read: SshSessionExecResult) -> NtfyRetireRead {
  if read.exit_code != ntfy_retire_present_path_exit {
    ReadUnreadable {
      evidence: concat("systemctl LoadState read failed with exit ", concat(to_string(read.exit_code), ": not a LoadState answer")),
    }
  } else if string_contains(s: read.stdout, pattern: ntfy_retire_unit_load_state_absent) {
    ReadAbsent { evidence: "systemd LoadState is not-found" }
  } else if string_contains(s: read.stdout, pattern: ntfy_retire_unit_load_state_loaded) {
    ReadPresent { evidence: "systemd still answers for the unit" }
  } else {
    ReadUnreadable { evidence: concat("systemctl answered a LoadState this model does not interpret: ", read.stdout) }
  }
}

// THE GETENT PROBER. getent exits with its not-found code and prints nothing when the name resolves to
// no passwd entry, and prints the entry with exit 0 when it does. Its usage error (exit 2 WITH a
// usage line), exit 0 with an empty stdout, and every other exit are neither a resolved account nor
// an absent one.
fn ntfy_retire_account_read(read: SshSessionExecResult) -> NtfyRetireRead {
  if read.exit_code == getent_key_not_found_exit && read.stdout == "" {
    ReadAbsent { evidence: "getent passwd resolves no entry" }
  } else if read.exit_code == ntfy_retire_present_path_exit && read.stdout != "" {
    ReadPresent { evidence: "getent passwd still resolves the account" }
  } else {
    ReadUnreadable {
      evidence: concat("getent passwd exited ", concat(to_string(read.exit_code), ": neither a resolved entry nor a not-found answer")),
    }
  }
}

// THE GROUP PROBER, the account read's shape over the GROUP database, because the group survives the
// account and so must be read on its own. Same three answers, same discipline: only "not-found exit with
// nothing printed" says absent and only "exit 0 with a line" says present; anything else -- a usage line,
// exit 0 printing nothing, another exit -- is a database this model did not read, and an uninterpreted
// read is not an absent group. getent(1) exits 2 when a supplied key is not in the database whatever the
// database is, so the not-found code is the account read's own constant; it is compared on THIS read's
// exit, never borrowed from the account's.
fn ntfy_retire_group_read(read: SshSessionExecResult) -> NtfyRetireRead {
  if read.exit_code == getent_key_not_found_exit && read.stdout == "" {
    ReadAbsent { evidence: "getent group resolves no entry by the retired transport's name" }
  } else if read.exit_code == ntfy_retire_present_path_exit && read.stdout != "" {
    ReadPresent { evidence: "getent group still resolves the group" }
  } else {
    ReadUnreadable {
      evidence: concat("getent group exited ", concat(to_string(read.exit_code), ": neither a resolved entry nor a not-found answer")),
    }
  }
}

// THE TAILSCALE PROBER. tailscale's status is the account of what is served; the route key is the port
// and mount the handler was configured at, and an absent handler projects to no targets at all. An
// unreadable status is NOT read as absence -- a parse gap must not retire a listener.
fn ntfy_retire_front_door_read(status_read: SshSessionExecResult) -> NtfyRetireRead {
  // THE EXIT CODE IS PART OF THE READ. A `tailscale serve status` that never ran -- sudo refused, the
  // program was not where it is cataloged, the daemon was down -- prints nothing, and an empty document
  // parses to "no routes". Reading that as an ABSENT front door is the fabricated default DESIGN.md 5
  // refuses: the run would certify a closed listener it never observed. Only a status that exited 0 is
  // a status.
  if status_read.exit_code != ntfy_retire_present_path_exit {
    ReadUnreadable {
      evidence: concat("tailscale serve status exited ", concat(to_string(status_read.exit_code), ": not a status answer, so the listener's state is unknown")),
    }
  } else {
    match tailscale_serve_status_route_proxy_targets(
      status_json: status_read.stdout,
    key: tailscale_serve_route_key(endpoint: ntfy_retire_front_door_endpoint),
  ) {
    ServeStatusProxies { targets: targets } =>
      if count(targets) == 0 {
        ReadAbsent { evidence: "tailscale serve status lists no route on the retired port" }
      } else {
        ReadPresent { evidence: "tailscale serve status still lists a route" }
      }
    ServeStatusUnreadable =>
      ReadUnreadable { evidence: "tailscale serve status did not parse: the listener's state is unknown" }
  }
  }
}

// TWO READS OF ONE MEMBER MEET UNDER ONE RULE, because a member can be attested by more than one
// probe -- the unit is both a loaded systemd unit and a file on disk, and a retirement that read only
// one of them would call a member retired on half the evidence. PRESENT wins outright: a member seen
// anywhere is on the host, whatever another probe said about it. Otherwise UNREADABLE wins over
// ABSENT: half a silence and half a "gone" is not a retirement. Only when every read says gone is the
// member gone.
fn ntfy_retire_reads_meet(a: NtfyRetireRead, b: NtfyRetireRead) -> NtfyRetireRead {
  match a {
    ReadPresent { evidence: ea } => ReadPresent { evidence: ea }
    ReadAbsent { evidence: ea } => match b {
      ReadPresent { evidence: eb } => ReadPresent { evidence: eb }
      ReadAbsent { evidence: eb } => ReadAbsent { evidence: concat(ea, concat("; ", eb)) }
      ReadUnreadable { evidence: eb } => ReadUnreadable { evidence: eb }
    }
    ReadUnreadable { evidence: ea } => match b {
      ReadPresent { evidence: eb } => ReadPresent { evidence: eb }
      ReadAbsent { evidence: _ } => ReadUnreadable { evidence: ea }
      ReadUnreadable { evidence: eb } => ReadUnreadable { evidence: concat(ea, concat("; ", eb)) }
    }
  }
}

// THE UNIT IS READ BY BOTH ITS PROBES: systemd's LoadState and the unit file's own path. A unit whose
// file is gone but which systemd still has loaded (deleted under a running unit, or a unit that was
// never stopped) is PRESENT, and so is a unit that is not loaded while its file is still on disk --
// which is the state a `stop`+`disable` that never removed the file leaves behind.
fn ntfy_retire_unit_read(load_state: SshSessionExecResult, unit_path_exit: Int) -> NtfyRetireRead {
  ntfy_retire_reads_meet(
    a: ntfy_retire_load_state_read(read: load_state),
    b: ntfy_retire_path_read(exit_code: unit_path_exit),
  )
}

// ── The receipt ────────────────────────────────────────────────────────────────────────────────
// THE RUN'S ANSWER, one line per member, each naming the test that decided it. This is what the
// operator reads after the fact, and what a later reader of the run log reads instead of a claim.

// THREE STATES, because the reads have three states. A member whose read could not be understood is
// reported as UNREADABLE and fails the run: it is not absent, and calling it still-present would be
// just as much a claim about the host as calling it gone.
type NtfyRetireVerdict
  = RetireMemberAbsent { member: NtfyRetireMember, evidence: String }
  | RetireMemberPresent { member: NtfyRetireMember, evidence: String }
  | RetireMemberUnreadable { member: NtfyRetireMember, evidence: String }

fn ntfy_retire_verdict_text(v: NtfyRetireVerdict) -> String {
  match v {
    RetireMemberAbsent { member: m, evidence: e } =>
      concat("absent: ", concat(member_text(member: m), concat(" -- ", e)))
    RetireMemberPresent { member: m, evidence: e } =>
      concat("STILL PRESENT: ", concat(member_text(member: m), concat(" -- ", e)))
    RetireMemberUnreadable { member: m, evidence: e } =>
      concat("UNREADABLE: ", concat(member_text(member: m), concat(" -- ", e)))
  }
}

// ONE VERDICT FUNCTION, total over the read sum, shared by every member. The run has no other way to
// make a verdict: a construction site that named a state by hand -- `RetireMemberAbsent { ... }` with
// the condition only inside its evidence -- would print and count a member as absent whatever the host
// answered, which is the exact shape this module was reviewed for once.
// gunbc.test.claim.approval_ntfy_retirement_witness
// red_a_read_that_was_never_made_never_becomes_an_absent_verdict pins that the classifiers, not the
// printing, decide the state.
fn ntfy_retire_verdict_from_read(member: NtfyRetireMember, read: NtfyRetireRead) -> NtfyRetireVerdict {
  match read {
    ReadAbsent { evidence: e } => RetireMemberAbsent { member: member, evidence: e }
    ReadPresent { evidence: e } => RetireMemberPresent { member: member, evidence: e }
    ReadUnreadable { evidence: e } => RetireMemberUnreadable { member: member, evidence: e }
  }
}

fn ntfy_retire_receipt_text(vs: List<NtfyRetireVerdict>) -> String {
  join(parts: map(vs, v => ntfy_retire_verdict_text(v: v)), separator: "\n")
}

// THE RECEIPT IS CLEAN ONLY WHEN EVERY ROSTER MEMBER IS READ ABSENT AND READ EXACTLY ONCE. A member
// missing from the verdicts is as unretired as a member found present: the roster is the standard,
// not the count of legs that ran.
fn ntfy_retire_receipt_is_clean(vs: List<NtfyRetireVerdict>) -> Bool {
  let absent = filter(vs, v => match v {
    RetireMemberAbsent { member: m, evidence: _ } => true
    RetireMemberPresent { member: _, evidence: _ } => false
    RetireMemberUnreadable { member: _, evidence: _ } => false
  })
  all(ntfy_retire_members, m => count(filter(absent, v => match v {
    RetireMemberAbsent { member: seen, evidence: _ } => seen == m
    RetireMemberPresent { member: _, evidence: _ } => false
    RetireMemberUnreadable { member: _, evidence: _ } => false
  })) == 1)
}

// THE ONE PLACE THE MEMBERS ARE SPOKEN: the receipt and the leg decisions print through here, so the
// words belong to the coproduct rather than to whatever string a caller brought.
fn member_text(member: NtfyRetireMember) -> String {
  match member {
    MemberUnit => "unit"
    MemberFrontDoor => "front door"
    MemberAccount => "account"
    MemberGroup => "group"
    MemberConfigDir => "config directory"
    MemberStateRoot => "state root"
    MemberBinary => "binary"
  }
}

// THE RECEIPT IS WRITTEN TO THE STEP'S OWN SUMMARY, the artifact a run leaves that a later reader
// sees without opening the log: one line per roster member, each naming the test that decided it.
// An unset or unreadable summary is a FAILED write, and a failed write fails the step -- a retirement
// whose receipt could not be recorded is not a retirement anyone can check afterwards.
data ntfy_retire_step_summary_variable: NonEmptyStr = "GITHUB_STEP_SUMMARY"

type NtfyRetireReceiptWrite
  = RetireReceiptWritten { path: NonEmptyStr }
  | RetireReceiptWriteFailed { reason: String }

fn ntfy_retire_receipt_write(text: String) -> NtfyRetireReceiptWrite
  uses fs: std.resources.Filesystem
{
  let path = actions_variable_trimmed(name: ntfy_retire_step_summary_variable)
  if path == "" {
    RetireReceiptWriteFailed { reason: "GITHUB_STEP_SUMMARY is unset" }
  } else {
    let prior = Filesystem.Read(path: path)
    if prior.success || prior.error_kind == "not_found" {
      let body = concat(if prior.success { prior.content } else { "" }, concat(text, "\n"))
      let w = Filesystem.Write(path: path, content: body)
      if w.success {
        RetireReceiptWritten { path: path }
      } else {
        RetireReceiptWriteFailed { reason: w.error }
      }
    } else {
      RetireReceiptWriteFailed { reason: concat("the step summary could not be read: ", prior.error) }
    }
  }
}

// ── The run ────────────────────────────────────────────────────────────────────────────────────
// THE ACTUATION STEP of the approval_ntfy_retire kind. It inherits the job's approval, refuses
// without it, and only then opens the transport. The gate step that FILED the request is the shared
// srv1 root-mutation gate (gunbc.fleet.fleet_converge_workflow
// fleet_converge_srv1_root_mutation_job_if); this step re-reads the standing and checks its own
// scopes against it, so a run whose approval lapsed between the gate and this step stops here.

data approval_ntfy_retire_attempt_raw: String = "approval-ntfy-retire-ci"

fn approval_ntfy_retire_wet() -> ProcessExit
  uses net: std.resources.Network, fs: std.resources.Filesystem
{
  match srv1_root_mutation_inherited_grant(required: approval_ntfy_retire_root_scopes) {
    Srv1InheritedGrantRefused { reason: why } =>
      exit_failure(reason: concat("approval ntfy retirement: ", why))
    Srv1InheritedGrantAdmitted { grant: _ } =>
      // PRE-FLIGHT, before a single leg runs: a removal target that is not a stated roster literal
      // refuses the run. The check is here rather than only in a witness because the cost of getting
      // it wrong is a tree the operator never approved removing, and a witness that passes today does
      // not run on the host.
      if !ntfy_retire_removals_are_stated() {
        exit_failure(reason: "approval ntfy retirement: a removal target is not a stated roster path")
      } else {
      match prepare_fleet_ssh_agent_context(attempt_raw: approval_ntfy_retire_attempt_raw) {
        FleetSshContextRefused { cause: c } =>
          exit_failure(reason: concat("approval ntfy retirement: ", c))
        FleetSshContextReady { context: context, receipt: _ } =>
          match fleet_ssh_target_at_standard_port(
            endpoint: fleet_probe_endpoint_for(host: operator_host_srv1 as String),
            principal: executor_bootstrap_principal.login,
          ) {
            SshTargetRefused { endpoint: e, refusal: why } =>
              exit_failure(reason: concat("approval ntfy retirement: ", ssh_target_refusal_text(endpoint: e, refusal: why)))
            SshTargetResolved { target: target } =>
              match ntfy_retire_verdict_reads(target: target, context: context) {
                ReadsRefused { reason: why } => exit_failure(reason: why)
                ReadsObserved { verdicts: pre } =>
                  // A member whose state the probes could not read is not a member the run may
                  // remove, because it cannot then tell whether it removed anything or proved nothing.
                  // Refuse before the first leg, while the host is still the host the operator approved.
                  ntfy_retire_proceed_after_reads(target: target, context: context, pre: pre)
              }
          }
      }
      }
  }
}

// THE LEGS, run in order, each through the elevated transport -- but a leg runs only when the read
// before the legs says its subject is still on the host. This is a retirement, so its target state is
// ABSENCE, and a run that has to be resumed after a half-finished pass (the first actuation of this
// retirement died at the front door with everything else already removed) would otherwise fail on the
// first leg it re-ran and could never close what is left: `systemctl stop` of a unit systemd no longer
// knows is an error, not a no-op. Skipping is not guessing: the skip is decided by the member's own
// three-state read, it is recorded in the receipt next to the evidence that justified it, and the
// readback still has to find every member absent for the step to pass. A leg whose subject is read
// PRESENT, or on which nothing was read at all, runs -- and any leg that does not exit 0 stops the
// run, because a half-removed member is exactly what the readback exists to catch.
type NtfyRetireLegRun
  = LegsRefused { reason: String }
  | LegsDone { decisions: List<String> }

// WHAT A LEG DECIDES TO DO, with the sentence the receipt prints for it. A skip quotes the read that
// justified it, so the receipt is evidence rather than a claim: "skipped -- binary already read absent:
// test -e exited 1" can be checked against the probe, where "skipped: nothing to do" could not.
type NtfyRetireLegDecision
  = LegDecisionRun { note: String }
  | LegDecisionSkip { note: String }

fn ntfy_retire_leg_decision(leg: NtfyRetireLeg, verdicts: List<NtfyRetireVerdict>) -> NtfyRetireLegDecision {
  let for_subject = filter(verdicts, v => match v {
    RetireMemberAbsent { member: m, evidence: _ } => (m == leg.subject)
    RetireMemberPresent { member: m, evidence: _ } => (m == leg.subject)
    RetireMemberUnreadable { member: m, evidence: _ } => (m == leg.subject)
  })
  match list_at_optional(xs: for_subject, index: 0) {
    // NOTHING WAS READ ABOUT THIS MEMBER. With the members a coproduct this arm is no longer
    // reachable by a mismatched spelling -- a leg's subject and a verdict's member are the same type,
    // and the actuation reads every roster member before the first leg. It stays as the conservative
    // answer for the only gap that remains: a verdict list that genuinely omits a member. The run does
    // not conclude the member is gone -- the roster is the standard -- it removes it and lets the
    // readback judge the host.
    Absent => LegDecisionRun { note: concat("leg ", concat(leg.name, ": ran (nothing was read about its subject)")) }
    Present { value: v } => match v {
      RetireMemberAbsent { member: m, evidence: e } =>
        LegDecisionSkip {
          note: concat("leg ", concat(leg.name, concat(": skipped -- ", concat(member_text(member: m), concat(" already read absent: ", e))))),
        }
      RetireMemberPresent { member: m, evidence: e } =>
        LegDecisionRun {
          note: concat("leg ", concat(leg.name, concat(": ran -- ", concat(member_text(member: m), concat(" read present: ", e))))),
        }
      // The actuation refuses the run before any leg when a member reads unreadable, so this arm is
      // defensive; the conservative answer is to attempt the removal, never to skip on a gap.
      RetireMemberUnreadable { member: m, evidence: e } =>
        LegDecisionRun {
          note: concat("leg ", concat(leg.name, concat(": ran (its subject read unreadable: ", e), ")")),
        }
    }
  }
}

// WHICH MEMBERS THE READS COULD NOT ANSWER FOR. This used to answer Bool, which is the shape this
// repository's review policy flags: it collapses one gap and every gap into the same answer, and it
// throws away WHICH member -- so the refusal could only say "a roster member's state was unreadable",
// leaving the operator to re-derive which one from the log. The list is the answer; the refusal below
// prints the members with the evidence each read gave.
fn ntfy_retire_unreadable_members(vs: List<NtfyRetireVerdict>) -> List<NtfyRetireVerdict> {
  filter(vs, v => match v {
    RetireMemberAbsent { member: _, evidence: _ } => false
    RetireMemberPresent { member: _, evidence: _ } => false
    RetireMemberUnreadable { member: _, evidence: _ } => true
  })
}

fn ntfy_retire_unreadable_report(gaps: List<NtfyRetireVerdict>) -> String {
  join(map(gaps, v => match v {
    RetireMemberUnreadable { member: m, evidence: e } => concat(member_text(member: m), concat(": ", e))
    RetireMemberAbsent { member: m, evidence: _ } => member_text(member: m)
    RetireMemberPresent { member: m, evidence: _ } => member_text(member: m)
  }), separator: "; ")
}

// THE GATE BEFORE THE FIRST LEG. No removal starts while any roster member's state is unknown: a
// member nobody could read is not a member the run may remove, because it could then neither prove it
// removed anything nor prove there was nothing to remove. Refusing here happens while the host is still
// the host the operator approved, and the refusal names the members it could not read.
fn ntfy_retire_proceed_after_reads(
  target: SshTarget,
  context: FleetSshExecutionContext,
  pre: List<NtfyRetireVerdict>,
) -> ProcessExit
  uses net: std.resources.Network
{
  let gaps = ntfy_retire_unreadable_members(vs: pre)
  if count(gaps) == 0 {
    match ntfy_retire_legs_outcome(target: target, context: context, verdicts: pre) {
      LegsRefused { reason: why } => exit_failure(reason: why)
      LegsDone { decisions: decisions } =>
        ntfy_retire_readback(target: target, context: context, decisions: decisions)
    }
  } else {
    let core = concat(
      to_string(count(gaps)),
      concat(" of ", concat(to_string(count(ntfy_retire_members)), " roster members: ")),
    )
    exit_failure(reason: concat(
      "approval ntfy retirement: the pre-removal reads could not answer for ",
      concat(core, concat(ntfy_retire_unreadable_report(gaps: gaps), "; the run will not remove on a read that said nothing")),
    ))
  }
}

// THE LEGS, run in order; each one's own decision is made by ntfy_retire_leg_decision.
fn ntfy_retire_legs_outcome(
  target: SshTarget,
  context: FleetSshExecutionContext,
  verdicts: List<NtfyRetireVerdict>,
) -> NtfyRetireLegRun
  uses net: std.resources.Network
{
  ntfy_retire_leg_step(target: target, context: context, index: 0, decisions: [], verdicts: verdicts)
}

// A leg chain written as an explicit index walk rather than a fold, because the language's total
// recursion over a list cannot carry the transport effect through each arm.
fn ntfy_retire_leg_step(
  target: SshTarget,
  context: FleetSshExecutionContext,
  index: Int,
  decisions: List<String>,
  verdicts: List<NtfyRetireVerdict>,
) -> NtfyRetireLegRun
  uses net: std.resources.Network
{
  match list_at_optional(xs: ntfy_retire_legs, index: index) {
    Absent => LegsDone { decisions: decisions }
    Present { value: leg } => match ntfy_retire_leg_decision(leg: leg, verdicts: verdicts) {
      LegDecisionRun { note: note } =>
        match ntfy_retire_elevated_exec(target: target, context: context, leg: leg) {
          LegSucceeded =>
            ntfy_retire_leg_step(target: target, context: context, index: index + 1, decisions: concat(decisions, [note]), verdicts: verdicts)
          LegRefused { reason: why } => LegsRefused { reason: why }
        }
      LegDecisionSkip { note: note } =>
        ntfy_retire_leg_step(target: target, context: context, index: index + 1, decisions: concat(decisions, [note]), verdicts: verdicts)
    }
  }
}

fn ntfy_retire_elevated_argv(command: List<String>) -> List<String> {
  let inv = sudo_elevate(command: command)
  concat([inv.bin_path], inv.args)
}

// A LEG ANSWERS WITH A VALUE, not with a step exit: the walk that runs the legs has to report what it
// did -- which legs ran, which were skipped -- and a leg that stopped the run has to carry its reason
// up to the one place that turns a reason into a failed step.
type NtfyRetireLegResult
  = LegSucceeded
  | LegRefused { reason: String }

fn ntfy_retire_elevated_exec(
  target: SshTarget,
  context: FleetSshExecutionContext,
  leg: NtfyRetireLeg,
) -> NtfyRetireLegResult
  uses net: std.resources.Network
{
  match typed_argv_exec_over_fleet_ssh(target: target, context: context, argv: ntfy_retire_elevated_argv(command: leg.argv)) {
    TypedArgvExecRefused { reason: why } =>
      LegRefused { reason: concat("approval ntfy retirement: ", concat(leg.name, concat(" refused: ", why))) }
    TypedArgvExecConverged { result: r } =>
      if r.success {
        LegSucceeded
      } else if ntfy_retire_leg_answers_subject_absent(leg: leg, exit_code: r.exit_code) {
        LegRefused { reason: ntfy_retire_subject_absent_reason(leg: leg, exit_code: r.exit_code) }
      } else {
        LegRefused { reason: concat("approval ntfy retirement: ", concat(leg.name, concat(" exited ", to_string(r.exit_code)))) }
      }
  }
}

// Does this exit code mean "the subject was not on the host"? Only for a leg that declares such an
// answer, and only at the exact code. A leg that declares none never reads ANY exit that way -- a
// missing answer is not a licence to guess which exit would have meant it.
fn ntfy_retire_leg_answers_subject_absent(leg: NtfyRetireLeg, exit_code: Int) -> Bool {
  match leg.subject_absent {
    NoSubjectAbsentAnswer => false
    SubjectAbsentExit { exit_code: expected } => exit_code == expected
  }
}

fn ntfy_retire_subject_absent_reason(leg: NtfyRetireLeg, exit_code: Int) -> String {
  concat(
    "approval ntfy retirement: ",
    concat(
      leg.name,
      concat(
        " found its subject already gone (exit ",
        concat(to_string(exit_code), "): the host does not match the roster this retirement was approved against, so the run refuses rather than reporting a removal it did not perform"),
      ),
    ),
  )
}

// THE READS, one probe per roster member, returned as values. The SAME chain runs twice in a pass:
// once before the legs, to decide which of them has anything to remove, and once after, as the receipt.
// It answers with a value rather than failing the step because the two uses decide differently -- the
// actuation refuses before touching the host when a member reads unreadable, the readback fails the run
// when a member is found still present -- and a function that exits cannot serve both.
type NtfyRetireVerdictReads
  = ReadsRefused { reason: String }
  | ReadsObserved { verdicts: List<NtfyRetireVerdict> }

fn ntfy_retire_verdict_reads(target: SshTarget, context: FleetSshExecutionContext) -> NtfyRetireVerdictReads
  uses net: std.resources.Network
{
  // THE ELEVATION CONTROL RUNS FIRST. Every absence below comes from a probe whose answer is "not
  // there"; this one asks about a directory that is always there, so a non-zero answer means the
  // elevated channel is not working -- sudo refused (which exits 1, the SAME code absence exits
  // with), the transport is broken, or the host is not the roster's host -- and then no probe result
  // says anything about the roster at all. The run stops there rather than printing six absences it
  // never read.
  match ntfy_retire_probe_exec(target: target, context: context, command: ntfy_retire_elevation_control_argv, step: "elevation-control") {
    TypedArgvExecRefused { reason: why } =>
      ReadsRefused { reason: concat("approval ntfy retirement: the elevation control probe could not reach the host: ", why) }
    TypedArgvExecConverged { result: control } =>
      if !ntfy_retire_elevation_control_is_proven(exit_code: control.exit_code) {
        ReadsRefused { reason: concat("approval ntfy retirement: the elevated probe channel did not prove itself (test -d / exited ", concat(to_string(control.exit_code), "): no absence is read from a probe that never ran")) }
      } else {
        match ntfy_retire_probe_exec(target: target, context: context, command: systemctl_show_load_state_argv(unit: ntfy_retire_unit_name), step: "unit-load-state-read") {
        TypedArgvExecRefused { reason: why } => ReadsRefused { reason: concat("approval ntfy retirement: ", why) }
        TypedArgvExecConverged { result: unit_read } =>
          match ntfy_retire_probe_exec(target: target, context: context, command: ["getent", "passwd", ntfy_retire_account_name as String], step: "account-read") {
            TypedArgvExecRefused { reason: why } => ReadsRefused { reason: concat("approval ntfy retirement: ", why) }
            TypedArgvExecConverged { result: account_read } =>
              match ntfy_retire_probe_exec(target: target, context: context, command: argv_words(command: tailscale_serve_status_json_command()), step: "serve-status-read") {
                TypedArgvExecRefused { reason: why } => ReadsRefused { reason: concat("approval ntfy retirement: ", why) }
                TypedArgvExecConverged { result: serve_read } =>
                  match ntfy_retire_path_probe(target: target, context: context, path: ntfy_retire_unit_path) {
                    PathProbeTransportRefused { reason: _ } =>
                      ReadsRefused { reason: "approval ntfy retirement: the unit path probe could not reach the host" }
                    PathProbeObserved { exit_code: unit_path_exit } =>
                      match ntfy_retire_path_probe(target: target, context: context, path: ntfy_retire_config_dir) {
                        PathProbeTransportRefused { reason: _ } =>
                          ReadsRefused { reason: "approval ntfy retirement: the config directory probe could not reach the host" }
                        PathProbeObserved { exit_code: config_exit } =>
                          match ntfy_retire_path_probe(target: target, context: context, path: ntfy_retire_state_root) {
                            PathProbeTransportRefused { reason: _ } =>
                              ReadsRefused { reason: "approval ntfy retirement: the state root probe could not reach the host" }
                            PathProbeObserved { exit_code: state_exit } =>
                              match ntfy_retire_path_probe(target: target, context: context, path: ntfy_retire_binary_path) {
                                PathProbeTransportRefused { reason: _ } =>
                                  ReadsRefused { reason: "approval ntfy retirement: the binary probe could not reach the host" }
                                PathProbeObserved { exit_code: binary_exit } =>
                                  // THE GROUP READ TAKES THE PROGRAM FROM THE MODULE THAT OWNS getent
                                  // (extdeps.posix.getent getent_group_command, rendered by argv_words),
                                  // the way the tailscale reads do. The account read above still spells its
                                  // own argv -- it predates that builder and works, and rewriting a probe
                                  // that is not what this change is about is how a retirement PR ends up
                                  // changing two things at once. The words are the same shape; only who
                                  // spells them differs, and the witness for the group read pins this one.
                                  match ntfy_retire_probe_exec(target: target, context: context, command: argv_words(command: getent_group_command(key: ntfy_retire_group_name)), step: "group-read") {
                                    TypedArgvExecRefused { reason: why } => ReadsRefused { reason: concat("approval ntfy retirement: ", why) }
                                    TypedArgvExecConverged { result: group_read } => {
                                      // EVERY VERDICT IS CHOSEN BY THE READ, through the prober's own
                                      // classifier and one shared verdict function. Nothing here names a
                                      // state by hand. A probe that exits with its own error, and anything
                                      // the elevation control above did not rule out, lands as UNREADABLE
                                      // and fails the run.
                                      let verdicts: List<NtfyRetireVerdict> = [
                                        ntfy_retire_verdict_from_read(
                                          member: MemberUnit,
                                          read: ntfy_retire_unit_read(load_state: unit_read, unit_path_exit: unit_path_exit),
                                        ),
                                        ntfy_retire_verdict_from_read(
                                          member: MemberFrontDoor,
                                          read: ntfy_retire_front_door_read(status_read: serve_read),
                                        ),
                                        ntfy_retire_verdict_from_read(
                                          member: MemberAccount,
                                          read: ntfy_retire_account_read(read: account_read),
                                        ),
                                        ntfy_retire_verdict_from_read(
                                          member: MemberGroup,
                                          read: ntfy_retire_group_read(read: group_read),
                                        ),
                                        ntfy_retire_verdict_from_read(
                                          member: MemberConfigDir,
                                          read: ntfy_retire_path_read(exit_code: config_exit),
                                        ),
                                        ntfy_retire_verdict_from_read(
                                          member: MemberStateRoot,
                                          read: ntfy_retire_path_read(exit_code: state_exit),
                                        ),
                                        ntfy_retire_verdict_from_read(
                                          member: MemberBinary,
                                          read: ntfy_retire_path_read(exit_code: binary_exit),
                                        ),
                                      ]
                                      ReadsObserved { verdicts: verdicts }
                                    }
                                  }
                              }
                          }
                  }
              }
          }
        }
      }
  }
  }
}

// THE READBACK: the same reads, taken again after the legs, turned into the receipt the step passes
// on. A member found still present fails the run -- the receipt is not a report the operator may agree
// with, it is the condition the step passes on -- and the legs' own decisions are printed beside the
// verdicts, so a pass says both what was removed and what was found already gone.
fn ntfy_retire_readback(
  target: SshTarget,
  context: FleetSshExecutionContext,
  decisions: List<String>,
) -> ProcessExit
  uses net: std.resources.Network
{
  match ntfy_retire_verdict_reads(target: target, context: context) {
    ReadsRefused { reason: why } => exit_failure(reason: why)
    ReadsObserved { verdicts: verdicts } =>
      match ntfy_retire_receipt_write(text: ntfy_retire_receipt_text_with_legs(vs: verdicts, decisions: decisions)) {
        RetireReceiptWritten { path: _ } =>
          if ntfy_retire_receipt_is_clean(vs: verdicts) {
            ExitSuccess
          } else {
            exit_failure(reason: "approval ntfy retirement: the readback did not read every roster member absent")
          }
        RetireReceiptWriteFailed { reason: why } =>
          exit_failure(reason: concat("approval ntfy retirement: the readback receipt could not be written: ", why))
      }
  }
}

// THE RECEIPT IS THE MEMBERS' VERDICTS PLUS THE LEGS' DECISIONS. The verdicts are the condition; the
// decisions are the account of what this pass did, and they are only trustworthy because each one names
// the read it was decided by.
fn ntfy_retire_receipt_text_with_legs(vs: List<NtfyRetireVerdict>, decisions: List<String>) -> String {
  let members = ntfy_retire_receipt_text(vs: vs)
  if count(decisions) == 0 {
    members
  } else {
    concat(members, concat("\n", join(parts: decisions, separator: "\n")))
  }
}

// A path probe returns its exit code, or nothing when the transport refused: a refused probe is not
// an absent member, and the run says so rather than reading the gap as success.
// A probe either OBSERVES an exit code or reports that the transport refused; the second is not a
// verdict about the path, and the run stops rather than reading a transport gap as an absent member.
type NtfyRetirePathProbe
  = PathProbeObserved { exit_code: Int }
  | PathProbeTransportRefused { reason: String }

fn ntfy_retire_path_probe(target: SshTarget, context: FleetSshExecutionContext, path: NonEmptyStr) -> NtfyRetirePathProbe
  uses net: std.resources.Network
{
  match ntfy_retire_probe_exec(target: target, context: context, command: ntfy_retire_path_probe_argv(path: path), step: "path-probe") {
    TypedArgvExecRefused { reason: why } => PathProbeTransportRefused { reason: why }
    TypedArgvExecConverged { result: r } => PathProbeObserved { exit_code: r.exit_code }
  }
}

// A readback probe runs elevated (the paths and tailscale's status are root's to read) but its exit
// code is the ANSWER, not a failure: the transport refusing is the only failure here.
fn ntfy_retire_probe_exec(
  target: SshTarget,
  context: FleetSshExecutionContext,
  command: List<String>,
  step: String,
) -> TypedArgvExecOutcome
  uses net: std.resources.Network
{
  typed_argv_exec_over_fleet_ssh(target: target, context: context, argv: ntfy_retire_elevated_argv(command: command))
}
