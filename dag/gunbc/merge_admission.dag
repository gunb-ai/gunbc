module gunbc.merge_admission



type MergeStrategy
  = SquashMerge
  | MergeCommit
  | RebaseMerge

type RepoStandard {
  default_branch: String
  allowed_strategies: List<MergeStrategy>
  require_up_to_date: Bool
  merge_queue_required: Bool
  branch_name_convention: String
}

type GateRosterHash = std.content_hash.Fnv1a64Structural where brand("GateRosterHash")

fn gate_roster_hash_from_structural(structural: std.content_hash.Fnv1a64Structural) -> GateRosterHash {
  structural
}

type MergeAdmissionReceipt {
  pr_number: Int?
  head_sha: std.types.CommitSha
  base_tree_hash: extdeps.git.object_store.GitObjectId
  gate_roster_hash: GateRosterHash
  conclusion: extdeps.github.checks.CheckConclusion
}

type AdmissionPolicy
  = PerPrGateOnly
  | RequireUpToDateBase
  | KeyedReceipt

data gunbc_repo_standard: RepoStandard = RepoStandard {
  default_branch: gunbc_default_branch_name,
  allowed_strategies: [SquashMerge],
  require_up_to_date: false,
  merge_queue_required: false,
  branch_name_convention: "session/<id>",
}

data gate_content_hash_variant_tag_scaffold: std.disposition.Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: std.decl_ref.DeclarationRef {
    module_path: "gunbc.merge_admission",
    decl_name: "gate_content_hash",
    field: WholeDeclaration
  }
}

fn gate_content_hash_structural(g: gunbc.ci_gate.Gate) -> std.content_hash.Fnv1a64Structural {
  match g {
    EmitHostGate => content_hash_atom(value: "EmitHostGate")
    CheapClaimPoolGate => content_hash_atom(value: "CheapClaimPoolGate")
    ExtdepsExternalAuthorityGate => content_hash_atom(value: "ExtdepsExternalAuthorityGate")
    DagCompileCleanGate => content_hash_atom(value: "DagCompileCleanGate")
    GeneratedArtifactDriftGate => content_hash_atom(value: "GeneratedArtifactDriftGate")
    ExtdepsScopePlacementGate => content_hash_atom(value: "ExtdepsScopePlacementGate")
    ProseRowIntroductionGate => content_hash_atom(value: "ProseRowIntroductionGate")
    SourceRootIngestGate => content_hash_atom(value: "SourceRootIngestGate")
    RegenVerifyGate => content_hash_atom(value: "RegenVerifyGate")
    SelfHostReadsRealBytesGate => content_hash_atom(value: "SelfHostReadsRealBytesGate")
    SelfHostStalenessGate => content_hash_atom(value: "SelfHostStalenessGate")
  }
}

fn gate_content_hash(g: gunbc.ci_gate.Gate) -> std.content_hash.ContentHash {
  as_content_hash_structural(structural: gate_content_hash_structural(g: g))
}

fn witness_fn_list_hash_structural(fns: List<String>) -> std.content_hash.Fnv1a64Structural {
  fold(fns, init: content_hash_atom(value: "witness-fn-list"), f: fn(acc, fn_name) {
    content_hash_combine_structural(acc, content_hash_atom(value: fn_name))
  })
}

fn witness_fn_list_hash(fns: List<String>) -> std.content_hash.ContentHash {
  as_content_hash_structural(structural: witness_fn_list_hash_structural(fns: fns))
}

fn witness_kind_content_hash_structural(kind: std.realization_schedule.WitnessKind) -> std.content_hash.Fnv1a64Structural {
  match kind {
    CorpusWitnessKind => content_hash_atom(value: "CorpusWitnessKind")
    ExecutionWitnessKind => content_hash_atom(value: "ExecutionWitnessKind")
    NativeBundleWitnessKind => content_hash_atom(value: "NativeBundleWitnessKind")
  }
}

fn witness_kind_content_hash(kind: std.realization_schedule.WitnessKind) -> std.content_hash.ContentHash {
  as_content_hash_structural(structural: witness_kind_content_hash_structural(kind: kind))
}

fn witness_seam_content_hash_structural(seam: std.realization_schedule.WitnessSeam) -> std.content_hash.Fnv1a64Structural {
  content_hash_combine_structural(
    content_hash_atom(value: seam.producer),
    content_hash_atom(value: seam.consumer)
  )
}

fn witness_seam_content_hash(seam: std.realization_schedule.WitnessSeam) -> std.content_hash.ContentHash {
  as_content_hash_structural(structural: witness_seam_content_hash_structural(seam: seam))
}

fn clock_basis_content_hash_structural(clock: std.measure.ClockBasis) -> std.content_hash.Fnv1a64Structural {
  match clock {
    WallClock => content_hash_atom(value: "WallClock")
    CpuClock => content_hash_atom(value: "CpuClock")
  }
}

fn witness_cost_basis_content_hash_structural(basis: std.realization_schedule.WitnessCostBasis) -> std.content_hash.Fnv1a64Structural {
  match basis {
    MeasuredAtExactSubject { clock, duration, receipt } =>
      content_hash_combine_structural(
        left: content_hash_combine_structural(
          left: clock_basis_content_hash_structural(clock: clock),
          right: content_hash_tagged_structural(
            tag: "MeasuredAtExactSubject",
            payload: content_hash_atom(value: receipt)
          )
        ),
        right: content_hash_atom(value: concat("", millisecond_count(m: duration)))
      )
    EstimatedFromSiblingClass { clock, source_witness, basis } =>
      content_hash_combine_structural(
        left: content_hash_combine_structural(
          left: clock_basis_content_hash_structural(clock: clock),
          right: content_hash_tagged_structural(
            tag: "EstimatedFromSiblingClass",
            payload: content_hash_atom(value: source_witness)
          )
        ),
        right: content_hash_atom(value: basis)
      )
  }
}

fn scheduled_witness_envelope_content_hash_structural(envelope: std.realization_schedule.ScheduledWitnessEnvelope) -> std.content_hash.Fnv1a64Structural {
  content_hash_combine_structural(
    left: content_hash_combine_structural(
      left: witness_consumer_cadence_content_hash_structural(cadence: envelope.path_classification),
      right: content_hash_atom(value: concat("", millisecond_count(m: envelope.wall_budget)))
    ),
    right: content_hash_atom(value: concat("", millisecond_count(m: envelope.max_staleness)))
  )
}

fn witness_span_content_hash_structural(span: std.realization_schedule.WitnessSpan) -> std.content_hash.Fnv1a64Structural {
  match span {
    SpanUndeclared => content_hash_atom(value: "SpanUndeclared")
    SpanSeams { seams } =>
      fold(seams, init: content_hash_atom(value: "SpanSeams"), f: fn(acc, seam) {
        content_hash_combine_structural(
          acc,
          witness_seam_content_hash_structural(seam: seam)
        )
      })
    SpanEnrolled { seams, cost_basis, envelope } =>
      content_hash_combine_structural(
        left: content_hash_combine_structural(
          left: fold(seams, init: content_hash_atom(value: "SpanEnrolled"), f: fn(acc, seam) {
            content_hash_combine_structural(
              acc,
              witness_seam_content_hash_structural(seam: seam)
            )
          }),
          right: witness_cost_basis_content_hash_structural(basis: cost_basis)
        ),
        right: scheduled_witness_envelope_content_hash_structural(envelope: envelope)
      )
  }
}

fn witness_span_content_hash(span: std.realization_schedule.WitnessSpan) -> std.content_hash.ContentHash {
  as_content_hash_structural(structural: witness_span_content_hash_structural(span: span))
}

fn check_kind_content_hash_structural(check: gunbc.commit_workflow.CommitCheckKind) -> std.content_hash.Fnv1a64Structural {
  match check {
    CommitSpecGate { gate: g } =>
      content_hash_tagged_structural(tag: "CommitSpecGate", payload: gate_content_hash_structural(g: g))
    CommitWitnessClaim { entry, check_fns, kind, span } =>
      content_hash_combine_structural(
        left: content_hash_combine_structural(
          left: content_hash_tagged_structural(
            tag: "CommitWitnessClaim",
            payload: content_hash_atom(value: entry)
          ),
          right: witness_fn_list_hash_structural(fns: check_fns)
        ),
        right: content_hash_combine_structural(
          left: witness_kind_content_hash_structural(kind: kind),
          right: witness_span_content_hash_structural(span: span)
        )
      )
    CommitCargoFmtCheck =>
      content_hash_atom(value: "CommitCargoFmtCheck")
  }
}

fn check_kind_content_hash(check: gunbc.commit_workflow.CommitCheckKind) -> std.content_hash.ContentHash {
  as_content_hash_structural(structural: check_kind_content_hash_structural(check: check))
}

fn enrollment_content_hash_structural(e: gunbc.commit_workflow.CommitCheckEnrollment) -> std.content_hash.Fnv1a64Structural {
  check_kind_content_hash_structural(check: e.check)
}

fn enrollment_content_hash(e: gunbc.commit_workflow.CommitCheckEnrollment) -> std.content_hash.ContentHash {
  check_kind_content_hash(check: e.check)
}

fn gate_roster_content_hash(roster: List<gunbc.commit_workflow.CommitCheckEnrollment>) -> GateRosterHash {
  fold(roster, init: content_hash_atom(value: "gate-roster-v1"), f: fn(acc, row) {
    content_hash_combine_structural(
      acc,
      enrollment_content_hash_structural(e: row)
    )
  })
}

fn merge_admission_fixture_tree_wire_hex(structural: std.content_hash.Fnv1a64Structural) -> std.types.NonEmptyStr {
  let digits = structural.digest as String
  if digits.length() >= 40 {
    substring(s: digits, start: 0, end: 40) as std.types.NonEmptyStr
  } else {
    zero_pad_left(digits: digits, width: 40) as std.types.NonEmptyStr
  }
}

fn merge_admission_witness_git_tree_wire(label: std.types.NonEmptyStr) -> std.types.NonEmptyStr {
  let s = label as String
  if s == "merge-admission-witness-base-b0" {
    "b000000000000000000000000000000000000001" as std.types.NonEmptyStr
  } else if s == "merge-admission-witness-base-b1" {
    "b000000000000000000000000000000000000002" as std.types.NonEmptyStr
  } else if s == "merge-admission-enforce-base-b0" {
    "e000000000000000000000000000000000000001" as std.types.NonEmptyStr
  } else if s == "merge-admission-enforce-base-b1" {
    "e000000000000000000000000000000000000002" as std.types.NonEmptyStr
  } else if s == "merge-admission-deployed-gate-control-base-b0" {
    "d000000000000000000000000000000000000001" as std.types.NonEmptyStr
  } else if s == "merge-admission-deployed-gate-control-base-b1" {
    "d000000000000000000000000000000000000002" as std.types.NonEmptyStr
  } else if s == "merge-admission-producer-base" {
    "a000000000000000000000000000000000000001" as std.types.NonEmptyStr
  } else if s == "tree-base-current" {
    "c000000000000000000000000000000000000001" as std.types.NonEmptyStr
  } else if s == "tree-base-stale" {
    "c000000000000000000000000000000000000002" as std.types.NonEmptyStr
  } else {
    merge_admission_fixture_tree_wire_hex(
      structural: content_hash_atom(value: label)
    )
  }
}

fn merge_admission_fixture_git_sha1(hex: std.types.NonEmptyStr) -> extdeps.git.object_store.GitObjectId {
  match git_sha1_object_id(hex: hex as String) {
    Present { value: oid } => oid
    Absent =>
      GitSha1ObjectId {
        digest: std.content_hash.Sha1Digest { hex: hex as std.content_hash.Sha1DigestHex },
      }
  }
}

fn merge_admission_fixture_git_tree_from_structural(structural: std.content_hash.Fnv1a64Structural) -> extdeps.git.object_store.GitObjectId {
  merge_admission_fixture_git_sha1(hex: merge_admission_fixture_tree_wire_hex(structural: structural))
}

fn merge_admission_fixture_git_tree_from_tagged(tag: std.types.NonEmptyStr, base: extdeps.git.object_store.GitObjectId) -> extdeps.git.object_store.GitObjectId {
  merge_admission_fixture_git_tree_from_structural(
    structural: content_hash_tagged_structural(
      tag: tag,
      payload: content_hash_atom(value: git_object_id_wire_hex(oid: base))
    )
  )
}

fn merge_admission_witness_git_tree(label: std.types.NonEmptyStr) -> extdeps.git.object_store.GitObjectId {
  merge_admission_fixture_git_sha1(hex: merge_admission_witness_git_tree_wire(label: label))
}

fn merge_admission_witness_gate_roster(label: std.types.NonEmptyStr) -> GateRosterHash {
  content_hash_atom(value: label)
}

data current_gate_roster_hash: GateRosterHash = gate_roster_content_hash(roster: commit_gate_roster)

type CoveredGateConclusion {
  gate: std.content_hash.ContentHash
  conclusion: extdeps.github.checks.CheckConclusion
}

type CheckCoverage
  = CheckCoverageAbsent {
      required_head: std.types.CommitSha,
      required_roster: std.content_hash.ContentHash
    }
  | CheckCoverageRunning {
      head: std.types.CommitSha,
      roster: std.content_hash.ContentHash,
      run: std.types.NonEmptyStr
    }
  | CheckCoverageStopped {
      head: std.types.CommitSha,
      roster: std.content_hash.ContentHash,
      completed: List<CoveredGateConclusion>,
      unexecuted: List<std.content_hash.ContentHash>,
      cause: std.types.NonEmptyStr
    }
  | CheckCoverageComplete {
      head: std.types.CommitSha,
      roster: std.content_hash.ContentHash,
      conclusions: List<CoveredGateConclusion>
    }
  | CheckCoverageStale {
      observed_head: std.types.CommitSha,
      required_head: std.types.CommitSha,
      observed_roster: std.content_hash.ContentHash,
      required_roster: std.content_hash.ContentHash
    }

data check_coverage_subject_universe_note: String = "CHECK COVERAGE IS A TOTAL CLASSIFICATION OVER AN EXPLICIT SUBJECT UNIVERSE (operator mandate 2026-08-01). The subject is (required PR head, required gate-roster identity, nonempty required gate population). No check runs is CheckCoverageAbsent, never an empty list that all() can call green. A run still executing is Running. A dependency stop is Stopped and carries both the completed and UNEXECUTED populations plus a cause, so batch-1 drift stopping the witness batches cannot masquerade as a witness verdict. Complete is the only arm admission examines for success. Stale carries both observed and required identities; it is not repaired by relabeling the observation. Adding a coverage state requires a new coproduct arm and turns every exhaustive consumer red until classified — unclassified is structurally unavailable."

data check_coverage_external_consumer_boundary_note: String = "BOUNDARY, NOT AN END-TO-END CLOSURE CLAIM. This module is the repository's admission authority and now makes the correct semantics representable and executable. The live fail-open observed 2026-08-01 was in the external dashboard readout: it reported no failing or pending checks with ok=true when the healed head had NO run. That consumer is ctrl session-dashboard: scripts/session-dashboard/lib/summarize_checks.mjs supplies the check classification consumed by pr_merge_ready_digest.mjs and server.mjs. It lives outside this repository and is not changed here. Until it conforms to classify_check_coverage_admission, the operational rule is stricter than its readout: never merge unless an executing run explicitly names the current PR head and reaches every required witness; an auto-heal head with no subsequent run is untested."

data check_coverage_external_consumer_adoption_receipt_in_flight: String = "ADOPTION IN FLIGHT, NOT COMPLETE (observed 2026-08-01). gunb-ai/ctrl PR #1922, Adopt gunbc exact-head CI admission semantics in dashboard checks, is OPEN, non-draft, and mergeStateStatus CLEAN. It maps CANCELLED runs to superseded rather than failed, an empty check rollup to none rather than passing, and permits the merge gate only when checksState is passing. This receipt closes only after #1922 is merged AND the live session-dashboard consumer is observed reading those semantics. gunbc records that external obligation but does not own or claim completion of the ctrl change. The repeated cancelled-run false negatives observed while validating gunbc PR #7544 are the live symptom this adoption removes."

type CheckCoverageAdmissionVerdict
  = CheckCoverageAdmitted
  | CheckCoverageDeniedAbsent { required_head: std.types.CommitSha, required_roster: std.content_hash.ContentHash }
  | CheckCoverageDeniedRunning { head: std.types.CommitSha, roster: std.content_hash.ContentHash, run: std.types.NonEmptyStr }
  | CheckCoverageDeniedStopped {
      head: std.types.CommitSha,
      roster: std.content_hash.ContentHash,
      completed: List<CoveredGateConclusion>,
      unexecuted: List<std.content_hash.ContentHash>,
      cause: std.types.NonEmptyStr
    }
  | CheckCoverageDeniedStale {
      observed_head: std.types.CommitSha,
      required_head: std.types.CommitSha,
      observed_roster: std.content_hash.ContentHash,
      required_roster: std.content_hash.ContentHash
    }
  | CheckCoverageDeniedHeadMismatch { observed: std.types.CommitSha, required: std.types.CommitSha }
  | CheckCoverageDeniedRosterMismatch { observed: std.content_hash.ContentHash, required: std.content_hash.ContentHash }
  | CheckCoverageDeniedEmptyRequiredPopulation
  | CheckCoverageDeniedDuplicateRequiredGate { gate: std.content_hash.ContentHash }
  | CheckCoverageDeniedExecutionCardinality { gate: std.content_hash.ContentHash, observed_count: Int }
  | CheckCoverageDeniedGateFailed { gate: std.content_hash.ContentHash, conclusion: extdeps.github.checks.CheckConclusion }

fn gate_identity_count(gates: List<std.content_hash.ContentHash>, gate: std.content_hash.ContentHash) -> Int {
  fold(gates, init: 0, f: fn(acc, row) {
    if row == gate { acc + 1 } else { acc }
  })
}

fn first_duplicate_required_gate(required_gates: List<std.content_hash.ContentHash>) -> std.content_hash.ContentHash? {
  fold(required_gates, init: none, f: fn(acc, gate) {
    match acc {
      Present { value: _ } => acc
      Absent =>
        if gate_identity_count(gates: required_gates, gate: gate) > 1 {
          Present { value: gate }
        } else {
          none
        }
    }
  })
}

fn covered_gate_count(conclusions: List<CoveredGateConclusion>, gate: std.content_hash.ContentHash) -> Int {
  fold(conclusions, init: 0, f: fn(acc, row) {
    if row.gate == gate { acc + 1 } else { acc }
  })
}

fn first_gate_with_wrong_execution_cardinality(
  required_gates: List<std.content_hash.ContentHash>,
  conclusions: List<CoveredGateConclusion>,
) -> std.content_hash.ContentHash? {
  fold(required_gates, init: none, f: fn(acc, gate) {
    match acc {
      Present { value: _ } => acc
      Absent =>
        if covered_gate_count(conclusions: conclusions, gate: gate) == 1 {
          none
        } else {
          Present { value: gate }
        }
    }
  })
}

fn first_required_gate_failure(
  required_gates: List<std.content_hash.ContentHash>,
  conclusions: List<CoveredGateConclusion>,
) -> CoveredGateConclusion? {
  fold(required_gates, init: none, f: fn(acc, gate) {
    match acc {
      Present { value: _ } => acc
      Absent =>
        fold(conclusions, init: none, f: fn(found, row) {
          match found {
            Present { value: _ } => found
            Absent =>
              if row.gate == gate && !check_conclusion_admits_merge_admission_floor(c: row.conclusion) {
                Present { value: row }
              } else {
                none
              }
          }
        })
    }
  })
}

fn classify_check_coverage_admission(
  coverage: CheckCoverage,
  required_head: std.types.CommitSha,
  required_roster: std.content_hash.ContentHash,
  required_gates: List<std.content_hash.ContentHash>,
) -> CheckCoverageAdmissionVerdict {
  match coverage {
    CheckCoverageAbsent { required_head: absent_head, required_roster: absent_roster } =>
      CheckCoverageDeniedAbsent {
        required_head: absent_head,
        required_roster: absent_roster
      }
    CheckCoverageRunning { head, roster, run } =>
      CheckCoverageDeniedRunning { head: head, roster: roster, run: run }
    CheckCoverageStopped { head, roster, completed, unexecuted, cause } =>
      CheckCoverageDeniedStopped {
        head: head,
        roster: roster,
        completed: completed,
        unexecuted: unexecuted,
        cause: cause
      }
    CheckCoverageStale {
      observed_head, required_head: stale_required_head,
      observed_roster, required_roster: stale_required_roster
    } =>
      CheckCoverageDeniedStale {
        observed_head: observed_head,
        required_head: stale_required_head,
        observed_roster: observed_roster,
        required_roster: stale_required_roster
      }
    CheckCoverageComplete { head, roster, conclusions } =>
      if head != required_head {
        CheckCoverageDeniedHeadMismatch { observed: head, required: required_head }
      } else if roster != required_roster {
        CheckCoverageDeniedRosterMismatch { observed: roster, required: required_roster }
      } else if length(required_gates) == 0 {
        CheckCoverageDeniedEmptyRequiredPopulation
      } else {
        match first_duplicate_required_gate(required_gates: required_gates) {
          Present { value: gate } =>
            CheckCoverageDeniedDuplicateRequiredGate { gate: gate }
          Absent =>
            match first_gate_with_wrong_execution_cardinality(
              required_gates: required_gates,
              conclusions: conclusions
            ) {
              Present { value: gate } =>
                CheckCoverageDeniedExecutionCardinality {
                  gate: gate,
                  observed_count: covered_gate_count(conclusions: conclusions, gate: gate)
                }
              Absent =>
                match first_required_gate_failure(
                  required_gates: required_gates,
                  conclusions: conclusions
                ) {
                  Present { value: failed } =>
                    CheckCoverageDeniedGateFailed {
                      gate: failed.gate,
                      conclusion: failed.conclusion
                    }
                  Absent => CheckCoverageAdmitted
                }
            }
        }
      }
  }
}

fn check_coverage_admits(
  coverage: CheckCoverage,
  required_head: std.types.CommitSha,
  required_roster: std.content_hash.ContentHash,
  required_gates: List<std.content_hash.ContentHash>,
) -> Bool {
  match classify_check_coverage_admission(
    coverage: coverage,
    required_head: required_head,
    required_roster: required_roster,
    required_gates: required_gates
  ) {
    CheckCoverageAdmitted => true
    CheckCoverageDeniedAbsent { required_head: _, required_roster: _ } => false
    CheckCoverageDeniedRunning { head: _, roster: _, run: _ } => false
    CheckCoverageDeniedStopped { head: _, roster: _, completed: _, unexecuted: _, cause: _ } => false
    CheckCoverageDeniedStale { observed_head: _, required_head: _, observed_roster: _, required_roster: _ } => false
    CheckCoverageDeniedHeadMismatch { observed: _, required: _ } => false
    CheckCoverageDeniedRosterMismatch { observed: _, required: _ } => false
    CheckCoverageDeniedEmptyRequiredPopulation => false
    CheckCoverageDeniedDuplicateRequiredGate { gate: _ } => false
    CheckCoverageDeniedExecutionCardinality { gate: _, observed_count: _ } => false
    CheckCoverageDeniedGateFailed { gate: _, conclusion: _ } => false
  }
}

fn mint_merge_admission_receipt(
  pr_number: Int?,
  head_sha: std.types.CommitSha,
  base_tree_hash: extdeps.git.object_store.GitObjectId,
  gate_roster_hash: GateRosterHash,
  conclusion: extdeps.github.checks.CheckConclusion,
) -> MergeAdmissionReceipt {
  MergeAdmissionReceipt {
    pr_number: pr_number,
    head_sha: head_sha,
    base_tree_hash: base_tree_hash,
    gate_roster_hash: gate_roster_hash,
    conclusion: conclusion,
  }
}

type MergeAdmissionVerdict
  = MergeAdmitted
  | MergeDeniedStaleBase
  | MergeDeniedStaleRoster
  | MergeDeniedNotSuccess
  | MergeDeniedWrongAttempt
  | MergeDeniedSubjectMismatch

data merge_admission_enforcement_policy: AdmissionPolicy = KeyedReceipt

fn check_conclusion_admits_merge_admission_floor(c: extdeps.github.checks.CheckConclusion) -> Bool {
  match c {
    Success => true
    Skipped => false
    ActionRequired => false
    Cancelled => false
    Failure => false
    Neutral => false
    Stale => false
    TimedOut => false
  }
}

fn classify_merge_admission_verdict(
  receipt: MergeAdmissionReceipt,
  merge_target_tree_hash: extdeps.git.object_store.GitObjectId,
  current_roster_hash: GateRosterHash,
) -> MergeAdmissionVerdict {
  if !check_conclusion_admits_merge_admission_floor(c: receipt.conclusion) {
    MergeDeniedNotSuccess
  } else if !git_object_id_eq(left: receipt.base_tree_hash, right: merge_target_tree_hash) {
    MergeDeniedStaleBase
  } else if !content_hash_eq_structural(left: receipt.gate_roster_hash, right: current_roster_hash) {
    MergeDeniedStaleRoster
  } else {
    MergeAdmitted
  }
}

data merge_admission_attempt_scope_note: String = "ATTEMPT SCOPE (ruling 2026-07-30): the receipt carries the walk-attempt identity in the PAYLOAD, not just the path, and the gate requires receipt.attempt_id == current — path identity alone is not enough, because a misrouted read must fail on the content too. A receipt from another attempt is neither stale nor fresh: it is NOT THE SUBJECT, so MergeDeniedWrongAttempt is checked FIRST, before conclusion, base, and roster — asking whether a foreign receipt's base is current would be answering a question about the wrong run. The identity derives from GITHUB_RUN_ID + GITHUB_RUN_ATTEMPT + GITHUB_JOB on GitHub; non-GitHub execution must supply GUNBC_WALK_ATTEMPT_ID explicitly or the walk-side composition refuses — never a silent constant like a bare local, which would make every local run one attempt and the wrong-attempt refusal unreachable off CI. Deleting or recreating the attempt directory at walk start remains hygiene; correctness never depends on cleaning a shared path."

data git_object_id_grounding_note: String = "The tested base tree is a GitObjectId, not a ContentHash. DESIGN's own §3 residue records that ContentHash is one brand over two unrelated hash families (structural fnv1a64 fingerprints and cited cryptographic digests) with no modeled discriminant; a Git tree object id is a THIRD domain, and admitting it into the same brand would let a gate-roster structural fingerprint inhabit the tested-tree field and typecheck. extdeps.git.object_store.GitObjectId is the existing single authority and already models the SHA-1/SHA-256 repository-format transition, so this grounds on it rather than minting a GitTreeOid nickname beside it (§3). Equality and the validating textual constructors live THERE, not here: both are generic Git behaviour, and holding them in this consumer was a fork this module briefly carried (review 2026-07-30)."

type MergeAdmissionReceiptV2 {
  attempt_id: gunbc.merge_admission_subject.WalkAttemptId
  pr_number: Int?
  tested_head_sha: std.types.CommitSha
  tested_base_tree_hash: extdeps.git.object_store.GitObjectId
  gate_roster_hash: GateRosterHash
  conclusion: extdeps.github.checks.CheckConclusion
}

data merge_admission_subject_binding_note: String = "THE GATE CONSUMES THE CAPTURED SUBJECT, not merely a self-describing receipt (review 2026-07-30). The v2 receipt carried tested_head_sha from the start, and nothing read it: the classifier checked attempt, conclusion, base, roster, so a receipt was free to RESTATE which subject it allegedly certified and be believed. The subject is captured before the floor runs and is the independent fact; the receipt is the floor's claim about it. Three bindings are therefore required BEFORE any freshness question — same attempt, same head, same base tree — and a mismatch is MergeDeniedSubjectMismatch, its own state: the receipt is well-formed and from this attempt, but it describes work on something other than what was captured, which is neither staleness (a fact about the world moving) nor a wrong attempt (a fact about which run). Asking whether such a receipt's base is current would be answering a question about the wrong subject, which is exactly why WrongAttempt is first and SubjectMismatch is second."

fn classify_merge_admission_verdict_v2(
  current_attempt_id: gunbc.merge_admission_subject.WalkAttemptId,
  tested_subject: gunbc.merge_admission_subject.TestedSubject,
  receipt: MergeAdmissionReceiptV2,
  merge_target_tree_hash: extdeps.git.object_store.GitObjectId,
  current_roster_hash: GateRosterHash,
) -> MergeAdmissionVerdict {
  if !walk_attempt_id_eq(left: receipt.attempt_id, right: current_attempt_id) {
    MergeDeniedWrongAttempt
  } else if !walk_attempt_id_eq(left: tested_subject.attempt_id, right: current_attempt_id) {
    MergeDeniedWrongAttempt
  } else if !(receipt.tested_head_sha == tested_subject.head_sha) {
    MergeDeniedSubjectMismatch
  } else if !git_object_id_eq(left: receipt.tested_base_tree_hash, right: tested_subject.base_tree_hash) {
    MergeDeniedSubjectMismatch
  } else if !check_conclusion_admits_merge_admission_floor(c: receipt.conclusion) {
    MergeDeniedNotSuccess
  } else if !git_object_id_eq(left: receipt.tested_base_tree_hash, right: merge_target_tree_hash) {
    MergeDeniedStaleBase
  } else if !content_hash_eq_structural(left: receipt.gate_roster_hash, right: current_roster_hash) {
    MergeDeniedStaleRoster
  } else {
    MergeAdmitted
  }
}

fn merge_admission_verdict_label(v: MergeAdmissionVerdict) -> String {
  match v {
    MergeAdmitted => "admitted"
    MergeDeniedStaleBase => "stale base tree — re-run CI against current main"
    MergeDeniedStaleRoster => "stale gate roster — re-run CI after criteria change"
    MergeDeniedNotSuccess => "receipt conclusion is not success"
    MergeDeniedWrongAttempt => "receipt belongs to a different walk attempt — not the subject; re-run CI"
    MergeDeniedSubjectMismatch => "receipt describes a different head or base tree than this attempt captured — not the subject; re-run CI"
  }
}

data merge_admission_current_context_staging_note: String = "STAGED INVOCABLE ENTRY, NOT A LIVE CONSUMER (review 46238, incident 2026-08-01). tools.merge_admission_current_context can fetch the current merge target, read attempt-scoped TestedSubject and MergeAdmissionReceiptV2 wires, and classify them against current_gate_roster_hash, but no production path invokes the entry and no production path mints either V2 wire. It therefore closes no runtime admission gap today. What IS delivered and executing is the discovery-corpus control pair: classify_merge_admission_verdict_v2 refuses a receipt carrying a synthetic changed-roster hash against the current roster, and admits a receipt minted under the current roster. A correctly computed but uninvoked verdict is staging, not a warning and not a wall."

data merge_admission_v2_production_wires_dissolution_trigger: std.dissolution.DissolutionCondition = unbound_dissolution(description: "FIRST DISSOLVE-ON: production captures TestedSubject before the floor, mints MergeAdmissionReceiptV2 after the floor, and persists both through merge_admission_tested_subject_path and merge_admission_floor_receipt_path for the same WalkAttemptId. Until both producers execute, tools.merge_admission_current_context has no production subject or evidence to consume and cannot be called live.")

data merge_admission_required_check_binding_dissolution_trigger: std.dissolution.DissolutionCondition = unbound_dissolution(description: "SECOND DISSOLVE-ON, after merge_admission_v2_production_wires_dissolution_trigger: gunbc.ci_failure_class.merge_freshness_gating_status changes from GatingComputedDeferred to the existing GatingEnforced arm after operator sign-off and the ci_failure_class prerequisites named by gunbc.plans.merge_admission_gate_shape_proposal. That transition binds the V2 current-context verdict into the approved merge-time consumption path so a denial refuses rather than merely being invocable. The later policy-content increment is already declared by gate_content_hash_variant_tag_scaffold: replacing gate_content_hash's variant-tag placeholder fires that SingleAuthority dissolution; it is not part of this staged increment.")

fn merge_admission_verdict_would_block(v: MergeAdmissionVerdict) -> Bool {
  match v {
    MergeAdmitted => false
    MergeDeniedStaleBase => true
    MergeDeniedStaleRoster => true
    MergeDeniedNotSuccess => true
    MergeDeniedWrongAttempt => true
    MergeDeniedSubjectMismatch => true
  }
}

fn merge_admission_would_block(
  receipt: MergeAdmissionReceipt,
  merge_target_tree_hash: extdeps.git.object_store.GitObjectId,
  current_roster_hash: GateRosterHash,
) -> Bool {
  merge_admission_verdict_would_block(
    v: classify_merge_admission_verdict(
      receipt: receipt,
      merge_target_tree_hash: merge_target_tree_hash,
      current_roster_hash: current_roster_hash,
    )
  )
}

fn receipt_is_admissible(
  receipt: MergeAdmissionReceipt,
  merge_target_tree_hash: extdeps.git.object_store.GitObjectId,
  current_roster_hash: GateRosterHash,
) -> Bool {
  match classify_merge_admission_verdict(
    receipt: receipt,
    merge_target_tree_hash: merge_target_tree_hash,
    current_roster_hash: current_roster_hash,
  ) {
    MergeAdmitted => true
    MergeDeniedStaleBase => false
    MergeDeniedStaleRoster => false
    MergeDeniedNotSuccess => false
    MergeDeniedWrongAttempt => false
    MergeDeniedSubjectMismatch => false
  }
}

fn policy_admits(
  policy: AdmissionPolicy,
  receipt: MergeAdmissionReceipt,
  merge_target_tree_hash: extdeps.git.object_store.GitObjectId,
  current_roster_hash: GateRosterHash,
) -> Bool {
  match policy {
    PerPrGateOnly => check_conclusion_is_success(c: receipt.conclusion)
    RequireUpToDateBase =>
      check_conclusion_is_success(c: receipt.conclusion)
        && git_object_id_eq(left: receipt.base_tree_hash, right: merge_target_tree_hash)
    KeyedReceipt =>
      receipt_is_admissible(
        receipt: receipt,
        merge_target_tree_hash: merge_target_tree_hash,
        current_roster_hash: current_roster_hash,
      )
  }
}
