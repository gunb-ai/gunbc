module gunbc.falsifier_run_control


type FalsifierControlRole
  = AffectedSetPredictOnlyCold
  | CompileCleanWholeTreeCold
  | NativeCacheCold

data falsifier_run_control_note: String = "Closed population of required falsifier control roles (F0, operator mandate 2026-08-04, corrected 2026-08-04 msg_f71d6501). A control cannot silently vanish because a step was renamed or moved — the roster is the authority the totality receipt (F1) and alert router consume. This module owns the RUN-LEVEL control model for the falsifier cadence: cold controls execute after the affected-set control CONCLUDES (always + release_build success), not only when it succeeds — verified defect on run 30935833427 where steps 13-14 SKIPPED while step 12 receipt upload PASSED. RETRACTED: per-PR compile-clean containment on the ci job — measured receipts proved the falsifier is correctly reporting main is red (witness redness, not infrastructure failure); containing an unreliable control was the wrong frame. floor_component_receipt owns batch-grain rows inside the affected-set control."

fn falsifier_control_role_label(role: FalsifierControlRole) -> NonEmptyStr {
  match role {
    AffectedSetPredictOnlyCold => "affected-set predict-only cold" as NonEmptyStr
    CompileCleanWholeTreeCold => "compile-clean whole-tree cold" as NonEmptyStr
    NativeCacheCold => "native-cache cold" as NonEmptyStr
  }
}

data falsifier_required_control_roles: List<FalsifierControlRole> = [
  AffectedSetPredictOnlyCold,
  CompileCleanWholeTreeCold,
  NativeCacheCold
]

data falsifier_release_build_step_id: String = "release_build"

data falsifier_control_prerequisite_if: String = concat("always() && !cancelled() && steps.", concat(ci_release_bins_step_id, ".outcome == 'success'"))

data falsifier_control_prerequisite_note: String = "Cold controls execute after the affected-set control CONCLUDES, not after it succeeds — provided checkout, toolchain, and release binaries succeeded. always() lifts the default success() gate that skipped compile-clean and native-cache whenever the predict-only floor reddened (verified run 30935833427: steps 13-14 SKIPPED while step 12 receipt upload PASSED via its own always()). The prerequisite refuses when binaries were never unpacked/verified into this job; it does NOT require the floor step to succeed. THIS IS THE THIRD REPAIR OF THIS CONTROL, NOT THE SECOND, AND THE DARK WINDOW PREDATES #7812 (corrected 2026-08-06, parent session still-bat-561 msg_7ae919df — the prior form of this note read the defect as starting at commit 491ee01d/#7812, which understates it). BEFORE #7812, the controls were ALREADY dark: the inherited default success() gate skipped both cold controls whenever the predict-only floor reddened, and the floor WAS red on every scheduled run checked in that earlier window. #7812 was itself a repair attempt for that earlier defect (adding always()), but it introduced a NEW bug — citing steps.release_build.outcome, a cross-job step id — that made the controls go from conditionally-skipped to UNCONDITIONALLY skipped regardless of upstream outcome, strictly worse than what it repaired. GITHUB ACTIONS steps.<id> IS JOB-SCOPED (found 2026-08-06): falsifier_build_job() (gunbc.falsifier_workflow) owns ci_release_build_step() with id falsifier_release_build_step_id (\"release_build\"), but the cold-control steps this if_condition gates live in the SEPARATE falsifier_floor_job() alongside ci_release_bins_unpack_verify_step() (id ci_release_bins_step_id, \"release_bins\") — a cross-job steps.release_build reference resolves to null and the comparison is unconditionally false. The immediately-following #7839 fixed the step's own id but not this cross-job reference, so the unconditional-skip bug from #7812 persisted through it. Fixed here (#7894) to cite ci_release_bins_step_id, the correct same-job step. falsifier_release_build_step_id is retained: falsifier_build_job's own steps (ci_selection_control_step et al.) legitimately reference it within that job. THE MEASURED DAMAGE WINDOW IS AT LEAST SIXTEEN DAYS, NOT ONE: a second session (merry-wren-185, PR #7908) independently traced the underlying corpus diagnostics these controls exist to catch to a namespace-resolution change merged 2026-07-20T17:26:51Z — sixteen days before this note's previously-stated window start — and by the time #7894 lands, that corpus damage is measured at 19 hard self-compile diagnostics across nvidia.dag, generated_artifact_drift_test.dag, complexity.dag, enforcement/receipts.dag, rust_test_fixtures.dag, and 06_translate.dag (cleared separately by PR #7908, not by this fix). So: this control has not been reliably executing for at least sixteen days, across at least two repair attempts, and the corpus damage it failed to catch during that window is the 19-diagnostic count above with the oldest cause dating to 2026-07-20 — #7894 is the third fix, and whether it is the one that sticks is proven only by a real scheduled run, not by this argument (see falsifier_control_prerequisite_execution_proof_note). HONEST BOUND (operator ruling 2026-08-05): step-level always() does not survive total runner/job loss — if the runner dies or the job is cancelled before a cold control is reached, that step cannot execute. Follow-up, explicitly not a #7812 blocker: split independent controls into serially dependent jobs that consume the build artifact but not each other's success outcome."

data falsifier_control_prerequisite_execution_proof_note: String = "EXECUTION-PROVING EVIDENCE, NOT CONDITION SHAPE (operator ruling 2026-08-06, parent session still-bat-561 msg_7ae919df): the two repairs before this one (the pre-#7812 inherited success() gate, and #7812's cross-job steps.release_build reference) both shipped WITH shape-based witnesses — assertions on the literal if_condition string — while the control itself stayed dark on every real run. A witness that checks condition SHAPE cannot distinguish a correct always()-based prerequisite from one that references a step id which will resolve to null at runtime; both produce an identical string. falsifier_run_control_witness_test.dag's five witnesses are exactly this shape class (they assert falsifier_control_prerequisite_if equals/contains expected substrings) and remain useful for catching a regression to the OLD string, but none of them can prove the step actually ran. That proof requires a real scheduled falsifier run: after this fix merges, the acceptance gate is the FIRST scheduled falsifier run afterward — inspect its job's compile-clean and native-cache cold-control steps via gh run view --json jobs and confirm each step's conclusion is 'success' or 'failure', never 'skipped'. This fix is not entitled to be declared done at merge time; it is declared done when that first post-merge run shows both cold controls concluding non-skipped. If a subsequent run shows either step skipped again, the corrected root cause is still wrong and this is a fourth repair, not a completed third one."

data gunbc_falsifier_compile_clean_cold_control_timeout_minutes: Int = 30

data gunbc_falsifier_compile_clean_cold_control_note: String = "Compile-clean whole-tree cold control (2026-07-16, lands with the per-PR import-closure scoping in tools.dag_compile_clean_scope): PR floors now compile only the affected entry closure, and main pushes already skip on an empty diff — so this step is the deterministic whole-tree execution of the compile-clean gate, on the falsifier cadence, mirroring how the predict-only cold run controls witness selection. GUNBC_CI_COMPILE_CLEAN_COLD_CONTROL=1 forces the scope plan to WholeTree before any diff observation (a widen-to-more-checking control arm, not an escape hatch — it can only force the gate to run in full). Plan function gunbc_ci_plan_artifact_batches is batch 1 of the floor schedule: exactly the compile-clean anchor through the same executor path that installs and consumes the in-run compile receipt. F0 (2026-08-04): if_condition uses falsifier_control_prerequisite_if so this control runs even when the predict-only floor reddens."

fn compile_clean_cold_control_invoke() -> String {
  concat(
    concat("ROOT=", concat(ci_repo_root_shell(), "\n")),
    claim_executor_run_plan_shell(
      source_roots: witness_layer_roots,
      plan_entry: "src/v2/workflow/ci_floor_plan.dag",
      plan_function: CiPlanArtifactPlan,
      notice_title: Absent,
      rooted: false
    )
  )
}

fn compile_clean_cold_control_step() -> Step {
  RunStep {
    name: Present { value: "compile-clean whole-tree cold control (scoped-PR admission counterpart)" },
    id: none,
    run: compile_clean_cold_control_invoke(),
    shell: none,
    env: Present {
      value: [kv(key: "GUNBC_CI_COMPILE_CLEAN_COLD_CONTROL", value: yaml_string(s: "1"))]
    },
    working_directory: none,
    if_condition: Present { value: falsifier_control_prerequisite_if },
    continue_on_error: none,
    timeout_minutes: Present { value: gunbc_falsifier_compile_clean_cold_control_timeout_minutes }
  }
}

data gunbc_falsifier_native_cache_cold_control_timeout_minutes: Int = 30

data gunbc_falsifier_native_cache_cold_control_note: String = "Native-cache cold control (P6 durable-cache rail, 2026-07-21): the nightly Wet emit-on-demand/self-host receipt batch re-executed with GUNBC_CI_NATIVE_CACHE_COLD_CONTROL=1, which makes emit_host_run_transport_cached ignore every .native_ready marker — the full emit+cargo+run chain runs cold on the falsifier cadence while the main falsifier_step's run of the same batch stays warm (the warm-rate receipt the per-PR enrollment decision reads). Widen-to-more-checking control arm, not an escape hatch: the env can only force the transport to do MORE work, never skip it. Mirrors compile_clean_cold_control_step. F0 (2026-08-04): if_condition uses falsifier_control_prerequisite_if so this control runs even when the predict-only floor reddens. SERIAL after compile-clean — must not compete for memory with the dying floor control."

fn native_cache_cold_control_invoke() -> String {
  concat(
    concat("ROOT=", concat(ci_repo_root_shell(), "\n")),
    claim_executor_run_plan_shell(
      source_roots: witness_layer_roots,
      plan_entry: "src/v2/workflow/ci_floor_plan.dag",
      plan_function: FalsifierNativeCacheColdPlan,
      notice_title: Absent,
      rooted: false
    )
  )
}

fn native_cache_cold_control_step() -> Step {
  RunStep {
    name: Present { value: "native-cache cold control (warm-tier admission counterpart)" },
    id: none,
    run: native_cache_cold_control_invoke(),
    shell: none,
    env: Present {
      value: [kv(key: "GUNBC_CI_NATIVE_CACHE_COLD_CONTROL", value: yaml_string(s: "1"))]
    },
    working_directory: none,
    if_condition: Present { value: falsifier_control_prerequisite_if },
    continue_on_error: none,
    timeout_minutes: Present { value: gunbc_falsifier_native_cache_cold_control_timeout_minutes }
  }
}

data ci_release_bins_step_id: String = "release_bins"
