module gunbc.githooks_pre_push_plan

import gunbc.commit_workflow {
  commit_gate_roster,
  project_local_tidy_checks,
  LocalTidyCheck,
  LocalTidyWitnessCheck,
  LocalTidyCargoFmtCheck,
}
import gunbc.local_tidy_spec {
  local_tidy_trigger_globs,
  local_tidy_path_matches_glob,
  LocalTidyFmtOutcome,
  FmtToolUnavailable,
  local_tidy_fmt_outcome_recipe,
  local_tidy_fmt_outcome_of_exit_status,
  local_tidy_fmt_outcome_blocks,
  local_tidy_fmt_pre_push_drift_recipe,
}
import gunbc.ci_layer_roots { witness_layer_roots }
import tools.rust_stage0_gates { path_is_rust_monolith }
import extdeps.git.hooks { pre_push_zero_sha }

type PrePushGateKind
  = DocWitnessRun { entry: String, function: String }
  | CargoFmtCheck

type PrePushGateBinding {
  kind: PrePushGateKind
  trigger_globs: List<String>
}

data pre_push_check_only_note: String = "Pre-push gates refuse with a fix recipe on drift (no auto-commit / auto-stage). Aligns with commit-hook check-only policy: failure arms refuse instead of mutating the tree silently."

data pre_push_fmt_recipe_defork_note: String = "CargoFmtCheck previously carried a pre-baked fail_recipe field holding a byte-identical copy of the row in gunbc.githooks_pre_push_emit — one string, two authorities (DESIGN section 3). The payload is deleted rather than repointed: a failure message is not a property of WHICH gate fired, it is a projection of the outcome that gate OBSERVED, so pre_push_fmt_outcome_recipe derives it from the exit status through the single authority in gunbc.local_tidy_spec. A pre-baked recipe on the binding is precisely what let a could-not-run outcome render a drift remedy."

fn pre_push_fmt_outcome(status: Int) -> LocalTidyFmtOutcome {
  local_tidy_fmt_outcome_of_exit_status(program: "cargo", status: status)
}

fn pre_push_fmt_outcome_recipe(status: Int) -> String {
  local_tidy_fmt_outcome_recipe(
    outcome: pre_push_fmt_outcome(status: status),
    drift_recipe: local_tidy_fmt_pre_push_drift_recipe
  )
}

fn pre_push_fmt_outcome_blocks(status: Int) -> Bool {
  local_tidy_fmt_outcome_blocks(outcome: pre_push_fmt_outcome(status: status))
}

fn pre_push_fmt_spawn_refusal_recipe(cause: String) -> String {
  local_tidy_fmt_outcome_recipe(
    outcome: FmtToolUnavailable { program: "cargo", cause: cause },
    drift_recipe: local_tidy_fmt_pre_push_drift_recipe
  )
}

// THE WITNESS-CORPUS PRE-PUSH GATE IS DELETED, 2026-08-26, AND ITS TWO HALVES DIED OF
// DIFFERENT CAUSES. Its EMISSION died on 2026-07-25: pre_push_fmt_only_note records the
// operator ruling that made the hook fmt-only, and the emitted .githooks/pre-push has
// carried no corpus step since. Its INVOCATION died on 2026-08-25: the transport built
// `claim_executor --plan-entry src/v2/workflow/ci_floor_plan.dag --plan-function
// gunbc_ci_witness_corpus_only_batches`, an entry the 2026-08-15 floor cut deleted and
// flags claim_executor no longer parses, so the one path that still reached it would have
// spent minutes cargo-building the executor in order to exit 2.
//
// It is deleted rather than repointed at --required-ci for the reason the fmt-only ruling
// already gives and this cut does not relitigate: a hook is opt-in per clone, bypassable
// with --no-verify, and absent in container worktrees, so it enforces nothing while
// costing a push its wall time. The `pre_push_witness_trigger_globs` fan-out over
// witness_layer_roots went with it, which is why an ordinary dag/ or src/v2/ push no
// longer arms any gate but fmt.
fn pre_push_source_roots() -> List<String> {
  witness_layer_roots
}

fn pre_push_path_hits_globs(path: String, globs: List<String>) -> Bool {
  any(globs, g => local_tidy_path_matches_glob(path: path, glob: g))
}

fn pre_push_path_hits_binding(path: String, binding: PrePushGateBinding) -> Bool {
  match binding.kind {
    CargoFmtCheck => path_is_rust_monolith(path: path)
    _ => pre_push_path_hits_globs(path: path, globs: binding.trigger_globs)
  }
}

fn pre_push_all_bindings() -> List<PrePushGateBinding> {
  pre_push_bindings()
}

fn pre_push_bindings() -> List<PrePushGateBinding> {
  fold(project_local_tidy_checks(roster: commit_gate_roster), init: [], f: fn(acc, check) {
    match check {
      LocalTidyWitnessCheck { entry, check_fns } =>
        fold(check_fns, init: acc, f: fn(inner, fn_name) {
          concat(inner, [PrePushGateBinding {
            kind: DocWitnessRun { entry: entry, function: fn_name },
            trigger_globs: local_tidy_trigger_globs(check: check)
          }])
        })
      LocalTidyCargoFmtCheck =>
        concat(acc, [PrePushGateBinding {
          kind: CargoFmtCheck,
          trigger_globs: local_tidy_trigger_globs(check: check)
        }])
    }
  })
}

fn pre_push_binding_active(
  binding: PrePushGateBinding,
  changed_paths: List<String>
) -> Bool {
  any(
    changed_paths,
    p => pre_push_path_hits_binding(path: p, binding: binding)
  )
}

fn pre_push_active_kinds(changed_paths: List<String>) -> List<PrePushGateKind> {
  fold(pre_push_all_bindings(), init: [], f: fn(acc, b) {
    if pre_push_binding_active(binding: b, changed_paths: changed_paths) {
      concat(acc, [b.kind])
    } else {
      acc
    }
  })
}

fn pre_push_zero_sha_authority() -> String {
  pre_push_zero_sha
}

