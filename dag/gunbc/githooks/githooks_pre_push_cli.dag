module gunbc.githooks_pre_push_cli

import std.disposition { Disposition, Terminal }
import gunbc.githooks_pre_push_plan { pre_push_active_kinds, pre_push_source_roots }
import extdeps.git.hooks { PrePushStdinRow, pre_push_zero_sha, pre_push_stdin_field_names }

data githooks_pre_push_cli_stage0_receiver_disposition: Disposition = Terminal {
  reason: "stage0's `claim_batch --pre-push` argv dispatch (src/v1/stage0/src/pre_push.rs via cli_run::handle_pre_push) is the CLI transport handler for this interface (DESIGN §3 transport-is-a-handler): stdin parse and git diff collection are transport; gate policy is the typed plan in gunbc.githooks_pre_push_plan (pre_push_active_kinds derived from commit_gate_roster + local_tidy_trigger_globs + witness-corpus binding from #6706); the binary interprets the returned PrePushGateKind rows and emits typed receipts — no opaque imperative policy fork. NO LONGER HOOK-INVOKED as of 2026-07-25 (operator ruling, gunbc.commit_workflow githooks_pre_push_slimmed_to_fmt_disposition): the emitted `.githooks/pre-push` is fmt-only and does not reference claim_batch at all, so this transport is now an ON-DEMAND LOCAL RUNNER — `claim_batch --pre-push` still works for a developer who wants the affected-set corpus locally, it is simply not on the push path. It is deliberately NOT deleted in that change: src/v1/stage0/src/pre_push.rs is a row in gunbc.stage0_crate_layout_generated, so removing it cascades into the emitted-crate-partition machinery (DESIGN open thread) rather than being a hook-scoped edit. 🟡 dissolve-on: delete this module, gunbc.githooks_pre_push_plan, pre_push.rs and the `--pre-push` argv row together when the emitted crate partition lands — or sooner if the on-demand runner is found to have no users, which is a census question, not a hook question."
}
