module gunbc.spark_serving_boot_provenance

import std.types { String, NonEmptyStr, List, Bool, Int }
import std.algebra { trim }
import extdeps.ssh.session { SshSessionExecResult }
import extdeps.systemd.systemctl { systemctl_show_property_argv }
import extdeps.systemd { ActiveEnterTimestampMonotonic }
import gunbc.spark_serving_unit_identity { spark_serving_unit_name }

// DURABILITY IS OBSERVED, NOT CAUSED, and that is the whole point of this module.
//
// THE PROBLEM IT REPLACES. "Does the serving unit survive a reboot" was going to be answered by
// rebooting the host: issue `systemctl reboot`, wait, replan, require empty. That needs the managed
// account to hold reboot authority it does not have, and the alternative offered was a human
// rebooting the machine by hand -- out-of-band actuation, which is the failure this repository names
// rather than a cautious choice. Either way the receipt exists only on runs where somebody rebooted.
//
// WHAT REBOOT-TESTING IS ACTUALLY A PROXY FOR. Not "the machine can restart" -- nobody doubts that.
// It is "was this unit started BY SYSTEMD AT BOOT, or by a hand that will not be there next time".
// That is the enablement fact, and it is exactly what an enable-without-start cannot deliver and a
// start-without-enable fakes until the next power cycle.
//
// AND THAT FACT IS DIRECTLY READABLE. systemd records when a unit entered the active state, in
// microseconds on the monotonic clock, which is zeroed at boot. A unit that entered active a few
// seconds into the boot was brought up by the manager during startup; one that entered active hours
// in was started by something else, later. No reboot is required to read it, no privilege is
// required to read it, and both reads are already classified INERT in gunbc.readback_independence
// (`systemctl show` reads the manager's recorded state and starts nothing), so the probe cannot
// establish what it reports.
//
// WHAT THIS BUYS BEYOND THE REBOOT TEST. Any reboot becomes evidence -- an operator's, a power cut,
// a kernel update -- rather than only the ones automation caused. The receipt lands on EVERY
// converge instead of on the rare runs that power-cycled something. And the fleet stops needing a
// standing authority to destroy host availability in order to answer a question about a unit file.
//
// THE HONEST LIMIT, stated because it is real: this establishes that the unit came up WITH THE
// CURRENT BOOT. It cannot manufacture a boot, so a host that has not restarted since the unit was
// enabled reports exactly that -- BootProvenanceUnitPredatesNoBoot -- which is an honest "not yet
// established", never a pass. What it removes is the need to CAUSE the boot, not the need for one to
// happen.

type SparkServingBootProvenance
  = UnitStartedByManagerAtBoot { active_enter_monotonic_us: Int, uptime_us: Int }
  | UnitStartedAfterBoot { active_enter_monotonic_us: Int, uptime_us: Int }
  | UnitNotActiveAtAll
  | BootProvenanceUnobserved { cause: NonEmptyStr }

fn spark_serving_active_enter_probe_argv() -> List<String> {
  concat(
    ["systemctl", "--user"],
    skip(systemctl_show_property_argv(
      unit: spark_serving_unit_name as NonEmptyStr,
      property: ActiveEnterTimestampMonotonic,
    ), n: 1),
  )
}

fn spark_serving_uptime_probe_argv() -> List<String> {
  ["cat", "/proc/uptime"]
}

// THE WINDOW, and it is a declared policy rather than a discovered constant.
//
// A unit brought up by the manager during startup enters active within the boot transaction. Ten
// seconds is generous for that on these hosts and far below any plausible hand-start, which happens
// minutes or hours in. It is stated as a number with a reason rather than tuned against an
// observation, because a threshold fitted to the current tree is a snapshot of today's boot rather
// than a statement about what boot-start means.
data spark_serving_boot_start_window_us: Int = 10000000

// systemd reports the monotonic timestamp as bare microseconds; /proc/uptime reports seconds with
// two decimals. Both are converted to microseconds so the comparison is between like magnitudes
// rather than between a number and a string that happens to sort.
fn spark_serving_classify_boot_provenance(
  active_enter: SshSessionExecResult,
  uptime: SshSessionExecResult,
) -> SparkServingBootProvenance {
  if active_enter.success == false {
    BootProvenanceUnobserved {
      cause: join([
        "ActiveEnterTimestampMonotonic probe failed exit=", to_string(active_enter.exit_code),
        " stderr=", active_enter.stderr,
      ], "") as NonEmptyStr,
    }
  } else if uptime.success == false {
    BootProvenanceUnobserved {
      cause: join([
        "/proc/uptime probe failed exit=", to_string(uptime.exit_code),
        " stderr=", uptime.stderr,
      ], "") as NonEmptyStr,
    }
  } else {
    match parse_int(s: trim(s: active_enter.stdout)) {
      Absent =>
        if trim(s: active_enter.stdout) == "0" || trim(s: active_enter.stdout) == "" {
          UnitNotActiveAtAll
        } else {
          BootProvenanceUnobserved {
            cause: join([
              "ActiveEnterTimestampMonotonic is not a monotonic microsecond count: ",
              trim(s: active_enter.stdout),
            ], "") as NonEmptyStr,
          }
        }
      Present { value: entered_us } =>
        if entered_us == 0 {
          UnitNotActiveAtAll
        } else {
          match spark_serving_uptime_microseconds(stdout: uptime.stdout) {
            Absent =>
              BootProvenanceUnobserved {
                cause: join(["/proc/uptime is not parseable: ", trim(s: uptime.stdout)], "") as NonEmptyStr,
              }
            Present { value: up_us } =>
              if entered_us <= spark_serving_boot_start_window_us {
                UnitStartedByManagerAtBoot { active_enter_monotonic_us: entered_us, uptime_us: up_us }
              } else {
                UnitStartedAfterBoot { active_enter_monotonic_us: entered_us, uptime_us: up_us }
              }
          }
        }
    }
  }
}

// /proc/uptime is "SECONDS.FF IDLE\n". Only the whole-second part is taken and scaled: the
// hundredths carry no information at the resolution this comparison works at, and parsing a decimal
// to keep them would be inventing precision the decision does not use.
fn spark_serving_uptime_microseconds(stdout: String) -> Int? {
  match split(trim(s: stdout), " ").first() {
    Absent => none
    Present { value: secs_field } =>
      match split(secs_field, ".").first() {
        Absent => none
        Present { value: whole } =>
          match parse_int(s: whole) {
            Absent => none
            Present { value: n } => Present { value: n * 1000000 }
          }
      }
  }
}

// THE ONLY ARM THAT ESTABLISHES DURABILITY, and the three that do not are distinct on purpose. A
// unit started after boot has NOT been shown to survive one; a unit that is not active has not been
// shown to do anything; an unobserved probe has shown nothing at all. Collapsing any of them into
// "not durable" would report a measurement nobody took.
fn spark_serving_boot_provenance_establishes_durability(p: SparkServingBootProvenance) -> Bool {
  match p {
    UnitStartedByManagerAtBoot { active_enter_monotonic_us: _, uptime_us: _ } => true
    UnitStartedAfterBoot { active_enter_monotonic_us: _, uptime_us: _ } => false
    UnitNotActiveAtAll => false
    BootProvenanceUnobserved { cause: _ } => false
  }
}

fn spark_serving_boot_provenance_wire(p: SparkServingBootProvenance) -> String {
  match p {
    UnitStartedByManagerAtBoot { active_enter_monotonic_us: e, uptime_us: u } =>
      join([
        "boot-provenance=started-by-manager-at-boot active_enter_us=", to_string(e),
        " uptime_us=", to_string(u),
        " -- the unit came up WITH this boot, so enablement is doing its job",
      ], "")
    UnitStartedAfterBoot { active_enter_monotonic_us: e, uptime_us: u } =>
      join([
        "boot-provenance=started-after-boot active_enter_us=", to_string(e),
        " uptime_us=", to_string(u),
        " -- the unit is running but did NOT come up with this boot; durability is not established by this boot",
      ], "")
    UnitNotActiveAtAll => "boot-provenance=unit-not-active"
    BootProvenanceUnobserved { cause: c } =>
      join(["boot-provenance=unobserved ", c as String], "")
  }
}
