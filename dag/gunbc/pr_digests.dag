module gunbc.pr_digests


type MergeReadinessVerdict
  = Ready
  | NotReady { first_reason: String, more_reasons: List<String> }

type AttachedUrl {
  url: std.types.NonEmptyStr
  container: AttachedUrlContainer
  context: AttachedUrlTextContext
}

type AttachedUrlContainer
  = PrBody
  | PullReviewBody
  | ReviewCommentBody

type AttachedUrlTextContext
  = Prose
  | InlineCode

type RestFallbackReason
  = GraphqlIncomplete
  | GraphqlRateLimited
  | GraphqlSchemaUnknown

service gunbc.PrDigests {
  operation ExtractAttachedUrls {
    input {
      pr: extdeps.github.pulls.PullRequest
      reviews: List<extdeps.github.pulls.PullReview>
      review_line_comments: List<extdeps.github.pulls.ReviewComment>
    }
    output {
      urls: List<AttachedUrl>
    }
    readonly
  }

  operation RenderPrSummaryLine {
    input {
      pr: extdeps.github.pulls.PullRequest
    }
    output {
      line: String
    }
    readonly
  }

  operation JudgeMergeReadiness {
    input {
      pr: extdeps.github.pulls.PullRequest
      reviews: List<extdeps.github.pulls.PullReview>
    }
    output {
      verdict: MergeReadinessVerdict
    }
    readonly
  }

  operation ClassifyRestFallback {
    input {
      error: extdeps.github.errors.GitHubErrorShape
    }
    output {
      reason: RestFallbackReason?
    }
    readonly
  }
}
