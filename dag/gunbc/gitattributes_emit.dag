module gunbc.gitattributes_emit

import gunbc.generated_artifact {
  committed_generated_artifact_paths
}

data gitattributes_emit_authority_note: String = "THE committed byte projection through which Git receives the relevant subset of the modeled repository-path policy (generated-file conflict policy charter, lane 2, operator-ruled 2026-08-01). Presentation-policy rows (linguist) and integration-policy rows (merge driver attribute) are orthogonal facts derived from separate authorities — generated provenance does not imply linguist-hidden, and neither row is hand-authored in the committed file. The merge-attribute population is committed_generated_artifact_paths() verbatim until lane 3 (#7609, merry-deer-815): deterministic_generated_projection_paths() replaces it in generated_projection_merge_policy_lines() only, with duplicate-path refusal before row emission; committed_generated_artifact_paths() stays the heal/registry authority. .gitattributes classifies itself through the same derivation with no handwritten self-row. The merge-driver DEFINITION lives in repository-local Git config (gunbc.repo_local_git_config), not in this file."

data generated_projection_paths_join_seam_note: String = "Seam for #7609 (operator sequence step 4, crisp-bat-830 2026-08-01): merry-deer-815 owns deterministic_generated_projection_paths() = committed_generated_artifact_paths ++ stage0-derived repo paths. Single consumer: generated_projection_merge_policy_lines() below. Duplicate refusal is fail-closed inside that fn (counted diagnostic), not silent dedup. still-carp-272 does not author a parallel join — reviews the stacked #7609 change only."

data dag_linguist_presentation_policy_pattern: String = "**/*.dag"
data dag_linguist_presentation_policy_attribute: String = "linguist-language=Rust"
data generated_projection_merge_attribute: String = "merge=generated-artifact"

fn gitattributes_header_lines() -> List<String> {
  [
    "# gunbc .gitattributes — generated from dag/gunbc/gitattributes_emit.dag — do not hand-edit.",
    "# Authority: docs/plans/generated-file-conflict-policy.md (lane 2).",
    ""
  ]
}

fn presentation_policy_lines() -> List<String> {
  [
    "# Presentation policy — linguist classification is independent of merge/integration policy.",
    concat(concat(dag_linguist_presentation_policy_pattern, " "), dag_linguist_presentation_policy_attribute),
    ""
  ]
}

fn generated_projection_merge_policy_lines() -> List<String> {
  let paths = committed_generated_artifact_paths()
  let header = [
    "# Integration policy — deterministic generated projections: provisional ours during merge,",
    "# then regenerate from merged authorities before commit (charter four-case policy row 1).",
    ""
  ]
  concat(header, map(paths, p => concat(concat(p, " "), generated_projection_merge_attribute)))
}

fn gitattributes_body_lines() -> List<String> {
  concat(
    concat(gitattributes_header_lines(), presentation_policy_lines()),
    generated_projection_merge_policy_lines()
  )
}

fn join_lines(lines: List<String>) -> String {
  fold(lines, init: "", f: fn(acc, line) {
    if acc == "" { line } else { concat(concat(acc, "\n"), line) }
  })
}

fn expected_gitattributes() -> String {
  concat(join_lines(lines: gitattributes_body_lines()), "\n")
}

fn gitattributes_drifted(committed: String) -> Bool {
  !(committed == expected_gitattributes())
}

fn gitattributes_has_merge_row_for(path: String) -> Bool {
  string_contains(
    s: expected_gitattributes(),
    pattern: concat(concat(path, " "), generated_projection_merge_attribute)
  )
}

fn all_committed_paths_have_merge_rows() -> Bool {
  all(committed_generated_artifact_paths(), p => gitattributes_has_merge_row_for(path: p))
}
