data forecast_is_projection_not_observation_note: String = "A forecast projects what may happen; a CycleTimeObservation records what did happen. They are separate nominal record types with no conversion in either direction. ScheduleForecast exposes ForecastInstant and ForecastInterval; its epoch value is sealed inside ForecastInstant and never appears as a bare Timestamp/EpochMs observation, RoadmapAcceptanceReceipt, Signoff, or done/accepted stage. The only operation that can produce a ScheduleForecast is schedule_forecast, and its result is a ScheduleForecastResult whose refusal arm is exhaustive. Therefore a date can neither accept a roadmap node nor inhabit the observation input used to calibrate later forecasts. Estimates project; only evidence promotes."

data schedule_method_note: String = "This is a roadmap instantiation of the cited GAO critical-path and three-point-estimate methods, not a new scheduling vocabulary. Dependencies determine the path of longest median duration. Historical minimum/median/maximum remain an interval throughout; the small sample is never collapsed to a point. ReviewCycleCount states how many normalized historical open-to-merge cycles to budget, and OperatorMergeLatencyAssumption is added once per node. Worker concurrency is carried explicitly because dependency-only CPM assumes the declared cap is available; resource-constrained scheduling below that cap is outside this slice and is not fabricated here."

data critical_path_method_used: CriticalPathMethod = critical_path_method
data three_point_estimate_method_used: ThreePointEstimateMethod = three_point_estimate_method

type SizingCell {
  intricacy: Intricacy
  volume: Volume
}

fn sizing_cell_eq(a: SizingCell, b: SizingCell) -> Bool {
  a.intricacy == b.intricacy && a.volume == b.volume
}

fn sizing_cell_of(sizing: NodeSizing) -> SizingCell? {
  match sizing {
    Unsized => Absent
    Sized { intricacy, volume, repo: _, acceptance: _ } =>
      Present { value: SizingCell { intricacy: intricacy, volume: volume } }
  }
}

type AcceptedNodePullLink {
  node: RoadmapNodeId
  pull_number: Int
}

data accepted_node_pull_link_note: String = "The business join between a durable roadmap acceptance and its implementation/acceptance pull request. Pull timing facts stay in extdeps.github.pull_timing_history; acceptance stays in gunbc.roadmap_authority. This list says only which PR supplied the accepted node's observed open-to-merge interval. Several nodes may deliberately share one PR because that PR delivered them together; calibration remains at accepted-node grain, matching the authored sizing cell."

fn accepted_node_pull_links() -> List<AcceptedNodePullLink> {
  [
    AcceptedNodePullLink { node: "2-scm-git-upstream-model", pull_number: 7405 },
    AcceptedNodePullLink { node: "2-scm-mercurial-upstream-model", pull_number: 7405 },
    AcceptedNodePullLink { node: "2-scm-pijul-upstream-model", pull_number: 7405 },
    AcceptedNodePullLink { node: "2-claim-indexed-evidence", pull_number: 7405 },
    AcceptedNodePullLink { node: "2-scm-compatibility-shape", pull_number: 7431 },
    AcceptedNodePullLink { node: "2-scm-p0-landing-spine", pull_number: 7542 },
    AcceptedNodePullLink { node: "namespace-occurrence-transport", pull_number: 7393 },
    AcceptedNodePullLink { node: "pderive-typesafe-nullary-reflection", pull_number: 7393 },
    AcceptedNodePullLink { node: "pderive-static-supplemental-contract", pull_number: 7429 },
    AcceptedNodePullLink { node: "v1-test-hygiene-producer-retirement", pull_number: 7441 },
  ]
}

fn cited_pull_timings() -> List<CitedPullTiming> {
  [
    gunbc_pr_7393_timing,
    gunbc_pr_7405_timing,
