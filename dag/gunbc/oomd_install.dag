module gunbc.oomd_install



data gunbc_oomd_sessions_slice: std.types.NonEmptyStr = "sessions.slice"


data gunbc_oomd_sessions_policy: extdeps.systemd.oomd.UnitManagedOomPolicy = extdeps.systemd.oomd.UnitManagedOomPolicy {
  scope_unit: gunbc_oomd_sessions_slice,
  managed_oom_swap: extdeps.systemd.oomd.ManagedOomKill,
  managed_oom_memory_pressure: extdeps.systemd.oomd.ManagedOomKill,
  managed_oom_memory_pressure_limit: std.measure.percent(60),
  managed_oom_memory_pressure_duration: std.measure.second(20),
}

type OomdApplyEffect {
  install_package: std.types.NonEmptyStr
  configured_policy: extdeps.systemd.oomd.UnitManagedOomPolicy
}

data gunbc_oomd_apply_effect: OomdApplyEffect = OomdApplyEffect {
  install_package: extdeps.apt.package_systemd_oomd_defaults,
  configured_policy: gunbc_oomd_sessions_policy,
}

type OomdInstallPlan {
  install_package: std.types.NonEmptyStr
  global_config: extdeps.systemd.oomd.OomdGlobalConfig
  dropin: extdeps.systemd.oomd.OomdDropIn
  service_unit: std.types.NonEmptyStr
  verify_property: std.types.NonEmptyStr
}

data gunbc_oomd_install_plan: OomdInstallPlan = OomdInstallPlan {
  install_package: extdeps.apt.package_systemd_oomd_defaults,
  global_config: extdeps.systemd.oomd.oomd_default_global_config,
  dropin: extdeps.systemd.oomd.OomdDropIn {
    target_unit: gunbc_oomd_sessions_slice,
    policy: gunbc_oomd_sessions_policy,
  },
  service_unit: extdeps.systemd.oomd.systemd_oomd_unit,
  verify_property: extdeps.systemd.oomd.oomd_managed_oom_memory_pressure_property,
}

type SliceMembershipSignal {
  sessions_in_slice: std.nat.Nat
  sessions_legacy_flat: std.nat.Nat
}

type OomdEffectiveRead {
  slice_present: Bool
  unit_active: extdeps.systemd.SystemdUnitActiveState
  unit_file_state: extdeps.systemd.systemctl.UnitFileState
  effective_managed_oom_memory_pressure: extdeps.systemd.oomd.ManagedOomAction
  effective_per_session_memory_max: gunbc.ci_floor_measurement.RunnerSliceCapEffectiveness
  effective_parent_slice_memory_max: gunbc.ci_floor_measurement.RunnerSliceCapEffectiveness
  effective_managed_oom_memory_pressure_limit: std.measure.Percent
  oomctl_manages_slice: Bool
  membership: SliceMembershipSignal
}

type OomdGroundingThresholds {
  per_session_cap: std.measure.ByteSize
  parent_slice_cap: gunbc.ci_floor_measurement.SessionAggregateReservation
  pressure_limit: std.measure.Percent
}

type OomdGroundingCheck
  = GroundingPass
  | GroundingFail { reason: String }

fn grounding_check(ok: Bool, reason: String) -> OomdGroundingCheck {
  if ok { GroundingPass } else { GroundingFail { reason: reason } }
}

fn unit_is_active(s: extdeps.systemd.SystemdUnitActiveState) -> Bool {
  match s {
    extdeps.systemd.Active => true
    extdeps.systemd.Inactive => false
    extdeps.systemd.Activating => false
    extdeps.systemd.Deactivating => false
    extdeps.systemd.Reloading => false
    extdeps.systemd.Failed => false
  }
}

fn unit_is_enabled(s: extdeps.systemd.systemctl.UnitFileState) -> Bool {
  match s {
    extdeps.systemd.systemctl.UnitEnabled => true
    extdeps.systemd.systemctl.UnitEnabledRuntime => false
    extdeps.systemd.systemctl.UnitLinked => false
    extdeps.systemd.systemctl.UnitMasked => false
    extdeps.systemd.systemctl.UnitStatic => false
    extdeps.systemd.systemctl.UnitDisabled => false
    extdeps.systemd.systemctl.UnitIndirect => false
    extdeps.systemd.systemctl.UnitGenerated => false
    extdeps.systemd.systemctl.UnitTransient => false
    extdeps.systemd.systemctl.UnitBad => false
  }
}

fn pressure_is_kill(a: extdeps.systemd.oomd.ManagedOomAction) -> Bool {
  match a {
    extdeps.systemd.oomd.ManagedOomKill => true
    extdeps.systemd.oomd.ManagedOomAuto => false
  }
}

fn cap_equals(eff: gunbc.ci_floor_measurement.RunnerSliceCapEffectiveness, target: std.measure.ByteSize) -> Bool {
  match eff {
    gunbc.ci_floor_measurement.CapUnbounded => false
    gunbc.ci_floor_measurement.CapEffective { bytes } => std.measure.byte_size_count(b: bytes) == std.measure.byte_size_count(b: target)
  }
}

fn parent_slice_cap_ok(eff: gunbc.ci_floor_measurement.RunnerSliceCapEffectiveness, agg: gunbc.ci_floor_measurement.SessionAggregateReservation) -> Bool {
  match agg {
    gunbc.ci_floor_measurement.SessionAggregateUnmeasured => false
    gunbc.ci_floor_measurement.SessionAggregateMeasured { bytes } => cap_equals(eff: eff, target: bytes)
  }
}

fn membership_grounding_check(m: SliceMembershipSignal) -> OomdGroundingCheck {
  if m.sessions_in_slice > 0 {
    GroundingPass
  } else {
    if m.sessions_legacy_flat > 0 {
      GroundingFail { reason: "100%-legacy migration state: all running session containers (sessions_legacy_flat > 0) are flat docker-*.scope under system.slice and none are parented under sessions.slice (sessions_in_slice == 0) — oomd's managed cgroup has no members; the eviction backstop is hollow (sessions.slice exists, systemd-oomd is active, but the managed set is empty because all session traffic bypasses it)" }
    } else {
      GroundingFail { reason: "empty managed cgroup: sessions.slice has no session-container children and no legacy sessions are running (sessions_in_slice == 0, sessions_legacy_flat == 0) — nothing for oomd to evict; the unit is active and the slice is configured but the managed set is empty because no sessions are currently running" }
    }
  }
}

fn grounding_checks(read: OomdEffectiveRead, req: OomdGroundingThresholds) -> List<OomdGroundingCheck> {
  [
    grounding_check(ok: read.slice_present, reason: "managed sessions slice does not exist: systemd-oomd has no managed cgroup to evict within under aggregate pressure (active oomd with no managed slice = zero protection)"),
    grounding_check(ok: unit_is_active(s: read.unit_active), reason: "systemd-oomd.service is not active"),
    grounding_check(ok: unit_is_enabled(s: read.unit_file_state), reason: "systemd-oomd.service is not enabled: the eviction backstop will not survive a reboot"),
    grounding_check(ok: pressure_is_kill(a: read.effective_managed_oom_memory_pressure), reason: "effective ManagedOOMMemoryPressure is auto, not kill: eviction is not guaranteed on the sessions slice"),
    grounding_check(ok: cap_equals(eff: read.effective_per_session_memory_max, target: req.per_session_cap), reason: "per-session memory.max does not equal the C eviction ceiling (or MemoryMax is infinity — an inert cap)"),
    grounding_check(ok: parent_slice_cap_ok(eff: read.effective_parent_slice_memory_max, agg: req.parent_slice_cap), reason: "parent sessions.slice MemoryMax does not equal the measured aggregate reservation (or the aggregate is unmeasured / MemoryMax is infinity)"),
    grounding_check(ok: std.measure.percent_count(p: read.effective_managed_oom_memory_pressure_limit) == std.measure.percent_count(p: req.pressure_limit), reason: "ManagedOOMMemoryPressureLimit (PSI percent) does not equal the intended threshold"),
    grounding_check(ok: read.oomctl_manages_slice, reason: "oomctl does not list the sessions slice in the systemd-oomd managed set"),
    membership_grounding_check(m: read.membership),
  ]
}

fn first_grounding_failure(checks: List<OomdGroundingCheck>) -> String? {
  fold(checks, init: none, f: fn(acc, c) {
    match acc {
      Present { value: _ } => acc
      Absent => match c {
        GroundingPass => none
        GroundingFail { reason: r } => Present { value: r }
      }
    }
  })
}

fn ground_oomd_from_read(read: OomdEffectiveRead, req: OomdGroundingThresholds) -> std.realization_reconcile.Grounding<gunbc.ci_floor_measurement.OomdEnforcementEvidence> {
  match first_grounding_failure(checks: grounding_checks(read: read, req: req)) {
    Absent => std.realization_reconcile.Grounds { evidence: gunbc.ci_floor_measurement.OomdEnforced }
    Present { value: reason } => std.realization_reconcile.DoesNotGround { reason: reason }
  }
}

fn reconcile_oomd(read: std.realization_reconcile.ShowEffectiveRead<OomdEffectiveRead>, req: OomdGroundingThresholds) -> std.realization_reconcile.Reconciliation<OomdApplyEffect, gunbc.ci_floor_measurement.OomdEnforcementEvidence> {
  match read {
    std.realization_reconcile.ReadAbsent { reason: why } =>
      std.realization_reconcile.reconcile_grounded(
        apply_effect: gunbc_oomd_apply_effect,
        show_read: read,
        grounding: std.realization_reconcile.DoesNotGround { reason: why }
      )
    std.realization_reconcile.ReadObserved { value: observed } =>
      std.realization_reconcile.reconcile_grounded(
        apply_effect: gunbc_oomd_apply_effect,
        show_read: read,
        grounding: ground_oomd_from_read(read: observed, req: req)
      )
  }
}

fn oomd_evidence_from_reconciliation(r: std.realization_reconcile.Reconciliation<OomdApplyEffect, gunbc.ci_floor_measurement.OomdEnforcementEvidence>) -> gunbc.ci_floor_measurement.OomdEnforcementEvidence {
  match r {
    std.realization_reconcile.Converged { evidence: e, applied: _ } => e
    std.realization_reconcile.NotConverged { reason: _, applied: _ } => gunbc.ci_floor_measurement.OomdUnverified
  }
}

data gunbc_oomd_show_effective_read: std.realization_reconcile.ShowEffectiveRead<OomdEffectiveRead> = std.realization_reconcile.ReadAbsent {
  reason: "no live systemctl show-effective / oomctl read has run on the fleet hosts yet; pure .dag model, the live verify is the later increment"
}

fn gunbc_oomd_install_evidence() -> gunbc.ci_floor_measurement.OomdEnforcementEvidence {
  match gunbc_oomd_show_effective_read {
    std.realization_reconcile.ReadAbsent { reason: _ } => gunbc.ci_floor_measurement.OomdUnverified
    std.realization_reconcile.ReadObserved { value: _ } => gunbc.ci_floor_measurement.OomdUnverified
  }
}


fn gunbc_oomd_fleet_evidence(req: OomdGroundingThresholds) -> gunbc.ci_floor_measurement.OomdEnforcementEvidence {
  oomd_evidence_from_reconciliation(r: reconcile_oomd(read: gunbc_oomd_show_effective_read, req: req))
}
