module gunbc.emitted_build_seed_constants_emit

import extdeps.languages.rust.string_literal { escape_rust_cooked_string_literal_body }
import gunbc.repo.repo_self_emitted_build { repo_self_emitted_cargo_build_flags }
import std.types { String }

// THE EMITTED CRATE'S BUILD ARGV, PROJECTED INTO THE SEED SO THE SEED STOPS MIRRORING IT.
//
// The v2-native build probe (src/v1/stage0/src/emitted_closure_compile_host.rs
// probe_cargo_build_flags) and the release job that packs an emitted entry
// (gunbc.repo.repo_self_emitted_build repo_self_emitted_crate_build_command) must build one binary
// under one flag set. The probe held a hand-written copy and a Rust test compared it with this row's
// source text (the gunbc#14570 scaffold). That is a drift DETECTOR over two authors; this removes the
// second author: the probe reads the generated constant, so a row that moves moves the probe's argv at
// the next regeneration, and a hand edit of the generated file is refused by the generated-artifact
// drift wall. Construction over validation (DESIGN section 5). Reasoning shared with
// gunbc.release_locus_seed_constants_emit.
//
// WHY A DEDICATED ARTIFACT. Its subject is the emitted crate's build contract; appending it to a file
// whose subject is another contract would be the DESIGN section 3 fork those files' notes name.
//
// THE ARGUMENTS ARE NOT AUTHORED HERE. This emitter evaluates the row, escapes each element and
// renders it as a slice element; no argument spelling appears in this module.
fn emitted_build_seed_constants_argument_element(argument: String) -> String {
  concat("    \"", concat(escape_rust_cooked_string_literal_body(s: argument), "\",\n"))
}

fn expected_emitted_build_seed_constants_generated_rs() -> String {
  concat(
    concat(
      "// Generated by gunbc emitted_build_seed_constants_emit — do not hand-edit.\n",
      "// Authority: gunbc.repo.repo_self_emitted_build repo_self_emitted_cargo_build_flags. The argv after\n// the cargo binary of an emitted crate's build, rendered so the seed's probe reads it rather than\n// mirroring it: regenerate rather than edit.\n",
    ),
    concat(
      "pub(crate) const EMITTED_CARGO_BUILD_FLAGS: &[&str] = &[\n",
      concat(join(map(repo_self_emitted_cargo_build_flags, a => emitted_build_seed_constants_argument_element(argument: a)), ""), "];\n"),
    ),
  )
}
