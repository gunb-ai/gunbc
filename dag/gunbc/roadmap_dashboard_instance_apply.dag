module gunbc.roadmap_dashboard_instance_apply

data dashboard_instance_apply_note: String = "The wet path is an interpreter of HostDashboardInstance, not a parallel provisioning script. Its high-level provision plan is pure and browser-visible; this module projects each operation to typed argv, executes locally or through the instance's explicit SSH transport, records a typed receipt, and performs a second independent observation before claiming convergence. Preflight resolves the modeled controller ref once and carries that exact CommitSha through initial observation and post-apply read-back; a target checkout that is clean against its own origin but stale against the requested commit derives Apply, never false convergence. Codex runtime identity (`--version` must realize `codex-cli`) and OAuth state (`login status`) are separate observations and provision steps, so a broken npm/Node launcher cannot masquerade as an auth refusal; successful stderr is retained in receipts rather than dropping runtime warnings. Source transport has no handoff gap: inspect shallow state -> hydrate from the modeled remote when needed -> mktemp directory -> git bundle -> metadata verify -> import into a new empty bare repository -> scp to .next -> target mv -> local cleanup. The empty-repository import is the closure proof; target mutation does not begin until it succeeds. A matching ownership-marker filename gates every mutation of an existing isolated source clone. Production is read before mutation and again after; repo HEAD plus /healthz must remain byte-identical. Recursive deletion is confined to the fresh controller-side mktemp directory minted by this invocation; no instance or target state is recursively deleted by apply."

data dashboard_host_program_literal_scaffold_note: String = "DECLARED SCAFFOLD (review 44058, DESIGN 6). This module pins ~42 absolute /usr/bin/* program literals while the SAME programs are already realized once, with identity probes and Ensure policies, in gunbc.roadmap_dashboard_instance.dashboard_execution_environment — a DESIGN 3 fork. It is marked rather than substituted because the substitution is not mechanical: the sites split across TWO hosts (dashboard_local_exec runs on the controller, dashboard_target_exec on the instance) and only the target host has an environment to resolve against, while the controller-side residue (cp, scp, mv, test, sleep, nc, sudo, chown) names provisioning tools that are deliberately NOT dispatch capabilities — adding them to ExecutionCapability would put provisioning tools on the roster dispatch admission requires. Picking the right carrier is a model decision (which layer owns a host program token: the tool's extdeps model, the OS/host-layout layer, or a second CapabilityRealization environment for the controller), and DESIGN 6 says that lands model-first, not improvised inside this change. DISSOLVES ON: a controller DispatchHostEnvironment resolved through the existing dispatch_capability_program — one concept at both breadths (DESIGN 2 horizontal) — at which point every literal here becomes a resolver call and this row deletes."

data dashboard_exec_result_carrier_note: String = "DECLARED SCAFFOLD (review 44058, DESIGN 5). DashboardExecResult carries failure as success: Bool plus prose, and every stage dispatches on `if !r.success` and repackages through dashboard_exec_refused(detail: String). That is a Bool where the typed refusal carriers this same PR introduces (gunbc.ensure's UpsertDecision/Refuse, DashboardApplyRefused) already exist — a parallel error representation, not a missing one. It is marked rather than migrated because the carrier threads through every stage of the apply pipeline in one piece: the fold is sequential and each stage returns the previous result on failure, so converting the carrier converts the pipeline, and doing that inside this change would bury the recursive-workflow model it exists to land. What is NOT deferred is fail-closedness: no arm fabricates success, every refusal carries its own located detail, and the refusal reaches the caller as DashboardApplyRefused. DISSOLVES ON: the apply pipeline folding over a typed step outcome — Converged, or Refused carrying its cause — instead of a Bool, with dashboard_exec_refused deleted and the per-cause arms named — the same shape roadmap_dispatch_environment already uses for admission. dispatch_capability_program's unrealized-capability marker (roadmap_dispatch_actuator) closes with it."

type DashboardExecResult {
  success: Bool
  stdout: String
  stderr: String
}

fn dashboard_exec_ok(stdout: String) -> DashboardExecResult {
  DashboardExecResult { success: true, stdout: stdout, stderr: "" }
}

fn dashboard_exec_refused(detail: String) -> DashboardExecResult {
  DashboardExecResult { success: false, stdout: "", stderr: detail }
}

fn dashboard_local_exec(
  workdir: std.types.FilePath,
  program: std.types.FilePath,
  args: List<String>,
) -> DashboardExecResult {
  let result = gunbc.WitnessBin.Run(
    workdir: workdir,
    bin_path: program,
    args: args,
    expect: OutcomeIsData,
  )
  DashboardExecResult {
    success: result.success,
    stdout: result.stdout,
    stderr: result.stderr,
  }
}

fn dashboard_target_exec(
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
  program: std.types.FilePath,
  args: List<String>,
) -> DashboardExecResult {
  match instance.provision_transport {
    DashboardLocalProvision =>
      dashboard_local_exec(
        workdir: dashboard_instance_controller_workdir(instance: instance),
        program: program,
        args: args,
      )
    DashboardSshProvision { host } =>
      match typed_argv_exec_over_ssh(
        host: host,
        argv: concat([program as String], args),
      ) {
        TypedArgvExecConverged { result } =>
          DashboardExecResult {
            success: result.success,
            stdout: result.stdout,
            stderr: result.stderr,
          }
        TypedArgvExecRefused { reason } =>
          dashboard_exec_refused(detail: reason)
      }
  }
}

fn dashboard_target_probe(
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
  program: std.types.FilePath,
  args: List<String>,
) -> DashboardExecResult {
  match instance.provision_transport {
    DashboardLocalProvision =>
      dashboard_local_exec(
        workdir: dashboard_instance_controller_workdir(instance: instance),
        program: program,
        args: args,
      )
    DashboardSshProvision { host } =>
      match typed_argv_probe_over_ssh(
        host: host,
        argv: concat([program as String], args),
      ) {
        TypedArgvExecConverged { result } =>
          DashboardExecResult {
            success: result.success,
            stdout: result.stdout,
            stderr: result.stderr,
          }
        TypedArgvExecRefused { reason } =>
          dashboard_exec_refused(detail: reason)
      }
  }
}

type DashboardArgv {
  program: std.types.FilePath
  args: List<String>
}

fn dashboard_run_target_argvs(
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
  commands: List<DashboardArgv>,
) -> DashboardExecResult {
  fold(
    commands,
    init: dashboard_exec_ok(stdout: ""),
    f: (acc, command) =>
      if acc.success {
        dashboard_target_exec(
          instance: instance,
          program: command.program,
          args: command.args,
        )
      } else {
        acc
      },
  )
}

data path_observation_preserves_refusal_note: String = "THE THREE-VALUED PROBE THE TWO-VALUED ONE COLLAPSED. `test -d` exiting non-zero means the path is absent; a transport that could not deliver the test at all means nothing is known. dashboard_target_path_present returned .success for both, so the second became the first.\\n\\nThe SSH arm distinguishes them already — TypedArgvExecRefused carries a reason — and the local arm distinguishes them through the same program-availability question belt_exec asks before running anything: a probe whose own binary is missing has not observed a negative, it has failed to observe. Both are recoverable here because dashboard_exec_refused marks a refusal with empty stdout and a populated stderr, which is the signal the collapse discarded.\\n\\nTHIS OBSERVATION IS NOW THE ONLY WAY TO ASK. The first version of this fix left the collapsing predicate in place for callers that wanted a Bool, on the reasoning that the refusal was recorded on a channel those callers could consult — and review 45213 found the two that did not, in the preflight paths that produce operator instructions. A discipline nothing enforces is not a wall, and the leak reappeared one layer below the one it was introduced to close. See observation_present_bit_scope_note for what survived and why."

type DashboardPathObservation
  = PathObservedPresent
  | PathObservedAbsent
  | PathObservationRefused { reason: String }

data exec_refusal_reason_note: String = "The same distinction the path observation makes, applied to the probes that are not path tests. A provider runtime or auth probe whose transport refused produces empty stdout with populated stderr — the dashboard_exec_refused signature — and that is categorically different from `codex login status` running and reporting no session. Without the split, an unreachable host and an unauthenticated provider are the same value, and the operator is told to log in on a machine they cannot reach."

fn dashboard_exec_refusal_reason(label: String, r: DashboardExecResult) -> List<String> {
  if r.success {
    []
  } else if trim(r.stdout) == "" && !(trim(r.stderr) == "") {
    [join([label, " observation could not run: ", trim(r.stderr)], "")]
  } else {
    []
  }
}

fn dashboard_target_path_observe(
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
  flag: String,
  path: std.types.FilePath,
) -> DashboardPathObservation {
  let r = dashboard_target_probe(
    instance: instance,
    program: "/usr/bin/test" as std.types.FilePath,
    args: [flag, path as String],
  )
  if r.success {
    PathObservedPresent
  } else if trim(r.stdout) == "" && !(trim(r.stderr) == "") {
    PathObservationRefused {
      reason: join([
        "path observation could not run for ",
        path as String,
        ": ",
        trim(r.stderr),
      ], ""),
    }
  } else {
    PathObservedAbsent
  }
}

fn dashboard_path_observation_refusal(obs: DashboardPathObservation) -> List<String> {
  match obs {
    PathObservedPresent => []
    PathObservedAbsent => []
    PathObservationRefused { reason } => [reason]
  }
}

data observation_present_bit_scope_note: String = "THE ONE PERMITTED COLLAPSE, named for what it is and scoped to the one place it is sound. This projection answers false for absent AND for refused, which is the exact loss review 45153 was raised about — so it exists only to fill the Bool fields of DashboardInstanceObservation, whose refusal channel is populated by the SAME fold that fills them and which consumers must read first.\\n\\nAN EARLIER VERSION OF THIS MODULE KEPT A SECOND, UNSCOPED COLLAPSE BESIDE IT (review 45213). dashboard_target_path_present probed and returned .success, never constructing an observation at all, and two preflight consumers read it bare: a refused transport made a required executable report as missing, and made a bootstrap parent report as not writable. Both then produced actionable remediation for a condition nobody observed — the same fabricated-verdict shape as 45153, one layer down, in the fix for 45153.\\n\\nThe note that shipped with that version said callers wanting a Bool could keep the collapsing predicate because the refusal was recorded on a channel elsewhere. That was documenting a leak rather than closing it: nothing made a caller consult the channel, and the two that mattered did not. The predicate is deleted, the preflight consumers take the observation and carry its refusal, and what remains is this projection with the word bit in its name, so a future use outside the record fold reads as the collapse it is."

fn dashboard_observation_present_bit(obs: DashboardPathObservation) -> Bool {
  match obs {
    PathObservedPresent => true
    PathObservedAbsent => false
    PathObservationRefused { reason: _ } => false
  }
}

fn dashboard_target_directory_present(
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
  path: std.types.FilePath,
) -> Bool {
  dashboard_observation_present_bit(
    obs: dashboard_target_path_observe(instance: instance, flag: "-d", path: path),
  )
}

fn dashboard_target_file_present(
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
  path: std.types.FilePath,
) -> Bool {
  dashboard_observation_present_bit(
    obs: dashboard_target_path_observe(instance: instance, flag: "-f", path: path),
  )
}

fn dashboard_next_path(path: std.types.FilePath) -> std.types.FilePath {
  concat(path as String, ".next") as std.types.FilePath
}

fn dashboard_copy_to_target_atomically(
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
  controller_workdir: std.types.FilePath,
  local_path: std.types.FilePath,
  remote_path: std.types.FilePath,
) -> DashboardExecResult {
  let next = dashboard_next_path(path: remote_path)
  let copied = match instance.provision_transport {
    DashboardLocalProvision =>
      dashboard_local_exec(
        workdir: controller_workdir,
        program: "/usr/bin/cp" as std.types.FilePath,
        args: [local_path as String, next as String],
      )
    DashboardSshProvision { host } =>
      dashboard_local_exec(
        workdir: controller_workdir,
        program: "/usr/bin/scp" as std.types.FilePath,
        args: shape_scp_copy_to_argv(
          host: host,
          local_path: local_path,
          remote_path: next,
        ),
      )
  }
  if copied.success {
    dashboard_target_exec(
      instance: instance,
      program: "/usr/bin/mv" as std.types.FilePath,
      args: [next as String, remote_path as String],
    )
  } else {
    copied
  }
}

fn dashboard_hydrate_controller_history(
  controller_repo: std.types.FilePath,
  history_remote: std.types.NonEmptyStr,
) -> DashboardExecResult {
  let shallow = dashboard_local_exec(
    workdir: controller_repo,
    program: "/usr/bin/git" as std.types.FilePath,
    args: shape_git_is_shallow_repository_argv(repo: controller_repo),
  )
  if !shallow.success {
    shallow
  } else if trim(shallow.stdout) == "false" {
    dashboard_exec_ok(stdout: "controller history already complete")
  } else if trim(shallow.stdout) == "true" {
    dashboard_local_exec(
      workdir: controller_repo,
      program: "/usr/bin/git" as std.types.FilePath,
      args: shape_git_fetch_unshallow_argv(
        repo: controller_repo,
        remote: history_remote,
      ),
    )
  } else {
    dashboard_exec_refused(detail: join([
      "git returned an unknown shallow-repository state: ",
      shallow.stdout,
      shallow.stderr,
    ], ""))
  }
}

fn dashboard_prepare_bundle(
  controller_repo: std.types.FilePath,
  anchor_ref: std.types.NonEmptyStr,
  temp_bundle: std.types.FilePath,
  temp_verify_repo: std.types.FilePath,
) -> DashboardExecResult {
  let created = dashboard_local_exec(
    workdir: controller_repo,
    program: "/usr/bin/git" as std.types.FilePath,
    args: shape_git_bundle_create_argv(
      repo: controller_repo,
      bundle: temp_bundle,
      source_ref: anchor_ref as std.types.GitRef,
    ),
  )
  if !created.success {
    created
  } else {
    let metadata_verified = dashboard_local_exec(
      workdir: controller_repo,
      program: "/usr/bin/git" as std.types.FilePath,
      args: shape_git_bundle_verify_argv(bundle: temp_bundle),
    )
    if !metadata_verified.success {
      metadata_verified
    } else {
      let verifier_initialized = dashboard_local_exec(
        workdir: controller_repo,
        program: "/usr/bin/git" as std.types.FilePath,
        args: shape_git_init_bare_argv(path: temp_verify_repo),
      )
      if !verifier_initialized.success {
        verifier_initialized
      } else {
        let imported = dashboard_local_exec(
          workdir: controller_repo,
          program: "/usr/bin/git" as std.types.FilePath,
          args: shape_git_bare_fetch_argv(
            repo: temp_verify_repo,
            bundle: temp_bundle,
            source_ref: anchor_ref as std.types.GitRef,
          ),
        )
        if imported.success {
          dashboard_exec_ok(
            stdout: "bundle imported into a new empty bare repository",
          )
        } else {
          dashboard_exec_refused(detail: join([
            "bundle failed empty-repository import closure proof: ",
            imported.stderr,
            imported.stdout,
          ], ""))
        }
      }
    }
  }
}

fn dashboard_stage_bundle(
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
  controller_repo: std.types.FilePath,
  staged_bundle: std.types.FilePath,
  temp_bundle: std.types.FilePath,
) -> DashboardExecResult {
  dashboard_copy_to_target_atomically(
    instance: instance,
    controller_workdir: controller_repo,
    local_path: temp_bundle,
    remote_path: staged_bundle,
  )
}

data serve_binary_copy_refusal_note: String = "THE SOURCE IS CHECKED BEFORE THE COPY so a missing build refuses by its own path rather than through cp's error. An absent target/release/gunbc is the ordinary state of a fresh controller checkout — nobody has built yet — and it is the single most likely reason this step fails, so it earns a refusal that names the file it looked for instead of a generic copy failure the reader has to decode.\\n\\nThe destination directory is created first because the instance's bin/ has no other creator: serve_binary is derived as a child of the instance root, and every other ensured directory in the plan is a sibling. Relying on the copy to imply its parent would fail on a fresh instance in a way that reads like a permissions problem.\\n\\nThe executable bit is set explicitly rather than inherited. cp preserves mode from the source, which is correct today and silently wrong the moment the build lands non-executable or the copy path changes — and a serve binary that exists but cannot execute produces a service that fails to start with no indication the provisioner is why."

fn dashboard_ensure_serve_binary(
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
  controller_repo: std.types.FilePath,
  built_binary: std.types.FilePath,
  path: std.types.FilePath,
) -> DashboardExecResult {
  let present = dashboard_local_exec(
    workdir: controller_repo,
    program: "/usr/bin/test" as std.types.FilePath,
    args: ["-f", built_binary as String],
  )
  if !present.success {
    dashboard_exec_refused(detail: join([
      "controller seed binary absent: ",
      built_binary as String,
      " — build it before apply; this step copies, it never builds",
    ], ""))
  } else {
    let parent = dashboard_target_exec(
      instance: instance,
      program: "/usr/bin/dirname" as std.types.FilePath,
      args: [path as String],
    )
    if !parent.success {
      parent
    } else {
      let made = dashboard_target_exec(
        instance: instance,
        program: "/usr/bin/mkdir" as std.types.FilePath,
        args: ["-p", trim(parent.stdout)],
      )
      if !made.success {
        made
      } else {
        let copied = dashboard_copy_to_target_atomically(
          instance: instance,
          controller_workdir: controller_repo,
          local_path: built_binary,
          remote_path: path,
        )
        if !copied.success {
          copied
        } else {
          dashboard_target_exec(
            instance: instance,
            program: chmod_binary_path as String as FilePath,
            args: ["0755", path as String],
          )
        }
      }
    }
  }
}

fn dashboard_ensure_local_origin(
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
  bundle: std.types.FilePath,
  origin: std.types.FilePath,
  source_ref: std.types.NonEmptyStr,
  publish_ref: std.types.NonEmptyStr,
) -> DashboardExecResult {
  dashboard_run_target_argvs(instance: instance, commands: [
    DashboardArgv {
      program: "/usr/bin/git" as std.types.FilePath,
      args: shape_git_init_bare_argv(path: origin),
    },
    DashboardArgv {
      program: "/usr/bin/git" as std.types.FilePath,
      args: shape_git_bare_fetch_argv(
        repo: origin,
        bundle: bundle,
        source_ref: source_ref as std.types.GitRef,
      ),
    },
    DashboardArgv {
      program: "/usr/bin/git" as std.types.FilePath,
      args: shape_git_bare_update_ref_argv(
        repo: origin,
        publish_ref: publish_ref as std.types.GitRef,
      ),
    },
  ])
}

fn dashboard_ensure_source_repo(
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
  origin: std.types.FilePath,
  repo: std.types.FilePath,
  anchor_ref: std.types.NonEmptyStr,
) -> DashboardExecResult {
  let git_dir = concat(repo as String, "/.git") as std.types.FilePath
  match dashboard_target_path_observe(instance: instance, flag: "-d", path: git_dir) {
    PathObservationRefused { reason } => dashboard_exec_refused(detail: reason)
    PathObservedAbsent =>
    dashboard_target_exec(
      instance: instance,
      program: "/usr/bin/git" as std.types.FilePath,
      args: shape_git_clone_branch_argv(
        origin: origin,
        repo: repo,
        branch: dashboard_instance_checkout_branch(instance: instance),
      ),
    )
    PathObservedPresent => {
    let status = dashboard_target_exec(
      instance: instance,
      program: "/usr/bin/git" as std.types.FilePath,
      args: shape_git_status_porcelain_argv(repo: repo),
    )
    if !status.success {
      status
    } else if trim(status.stdout) != "" {
      dashboard_exec_refused(
        detail: join([
          "owned source repo is dirty; refusing reset: ",
          repo as String,
          " status=",
          status.stdout,
        ], ""),
      )
    } else {
      dashboard_run_target_argvs(instance: instance, commands: [
        DashboardArgv {
          program: "/usr/bin/git" as std.types.FilePath,
          args: shape_git_fetch_remote_argv(
            repo: repo,
            remote: "origin" as std.types.NonEmptyStr,
          ),
        },
        DashboardArgv {
          program: "/usr/bin/git" as std.types.FilePath,
          args: shape_git_reset_hard_argv(
            repo: repo,
            target: anchor_ref as std.types.GitRef,
          ),
        },
      ])
    }
  }
}
}

fn dashboard_ensure_service(
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
) -> DashboardExecResult {
  let service_session = dashboard_instance_service_session_name(instance: instance)
  let present = dashboard_target_probe(
    instance: instance,
    program: "/usr/bin/tmux" as std.types.FilePath,
    args: shape_tmux_has_session_argv_for(
      scope: instance.tmux_server,
      session_name: service_session as String,
    ),
  ).success
  let stopped = if present {
    dashboard_target_exec(
      instance: instance,
      program: "/usr/bin/tmux" as std.types.FilePath,
      args: shape_tmux_kill_session_argv_for(
        scope: instance.tmux_server,
        session_name: service_session as String,
      ),
    )
  } else {
    dashboard_exec_ok(stdout: "service session absent")
  }
  if !stopped.success {
    stopped
  } else {
    dashboard_target_exec(
      instance: instance,
      program: "/usr/bin/tmux" as std.types.FilePath,
      args: shape_tmux_new_session_argv_for(
        scope: instance.tmux_server,
        session_name: service_session as String,
        working_dir: instance.repo_root as String,
        inner_argv: concat(
          [instance.serve_binary as String],
          dashboard_instance_serve_argv(instance: instance),
        ),
      ),
    )
  }
}

data dashboard_health_loopback_host: String = "127.0.0.1"

data dashboard_health_path: String = "/instance.json"

fn dashboard_instance_health_uri(instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance) -> extdeps.uri.Uri {
  extdeps.uri.Uri {
    scheme: extdeps.uri.Http,
    locator: join([
      dashboard_health_loopback_host,
      ":",
      to_string(instance.listen_port),
      dashboard_health_path,
    ], "") as std.types.NonEmptyStr,
  }
}

fn dashboard_instance_health_url(instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance) -> String {
  uri_wire(uri: dashboard_instance_health_uri(instance: instance)) as String
}

fn dashboard_read_instance_health(
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
) -> DashboardExecResult {
  dashboard_target_probe(
    instance: instance,
    program: "/usr/bin/curl" as std.types.FilePath,
    args: ["-fsS", dashboard_instance_health_url(instance: instance)],
  )
}

data dashboard_health_identity_note: String = "Health readback identifies the served document POSITIONALLY, never by scanning it: the body must parse as one JSON value and START with the emitter's own schema+instance_id prefix (gunbc.roadmap_dashboard_instance.dashboard_instance_health_identity_prefix). The scan this replaces accepted the fragment from any nested value, so a foreign or stale server answering the polled port — or a document merely mentioning the instance id — could report a converged apply that never happened (DESIGN 5). Same rule as the dispatch admission receipt; one reading, two consumers."

fn dashboard_health_names_instance(
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
  result: DashboardExecResult,
) -> Bool {
  result.success
    && json_text_parseable(s: result.stdout)
    && starts_with(
      s: result.stdout,
      prefix: dashboard_instance_health_identity_prefix(
        instance_id: instance.instance_id as String,
      ),
    )
}

data dashboard_health_poll_attempts: Int = 31
data dashboard_health_poll_seconds: std.types.Seconds = 2

fn dashboard_verify_health_after_attempts(
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
  remaining: Int,
) -> DashboardExecResult {
  let health = dashboard_read_instance_health(instance: instance)
  if dashboard_health_names_instance(instance: instance, result: health) {
    health
  } else if remaining <= 1 {
    dashboard_exec_refused(
      detail: join([
        "health did not name intended instance ",
        instance.instance_id as String,
        " within ",
        to_string(dashboard_health_poll_attempts),
        " probes; stdout=",
        health.stdout,
        "; stderr=",
        health.stderr,
      ], ""),
    )
  } else {
    let delay = dashboard_local_exec(
      workdir: dashboard_instance_controller_workdir(instance: instance),
      program: "/usr/bin/sleep" as std.types.FilePath,
      args: [to_string(dashboard_health_poll_seconds)],
    )
    if delay.success {
      dashboard_verify_health_after_attempts(
        instance: instance,
        remaining: remaining - 1,
      )
    } else {
      dashboard_exec_refused(
        detail: join(["health retry delay failed: ", delay.stderr], ""),
      )
    }
  }
}

fn dashboard_verify_health(instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance) -> DashboardExecResult {
  dashboard_verify_health_after_attempts(
    instance: instance,
    remaining: dashboard_health_poll_attempts,
  )
}

fn dashboard_apply_provision_op(
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
  op: gunbc.roadmap_dashboard_instance.DashboardInstanceProvisionOp,
  temp_bundle: std.types.FilePath,
  temp_verify_repo: std.types.FilePath,
) -> DashboardExecResult {
  match op {
    DashboardHydrateControllerHistory { controller_repo, history_remote } =>
      dashboard_hydrate_controller_history(
        controller_repo: controller_repo,
        history_remote: history_remote,
      )
    DashboardPrepareGitBundle { controller_repo, anchor_ref } =>
      dashboard_prepare_bundle(
        controller_repo: controller_repo,
        anchor_ref: anchor_ref,
        temp_bundle: temp_bundle,
        temp_verify_repo: temp_verify_repo,
      )
    DashboardStageGitBundle { controller_repo, staged_bundle } =>
      dashboard_stage_bundle(
        instance: instance,
        controller_repo: controller_repo,
        staged_bundle: staged_bundle,
        temp_bundle: temp_bundle,
      )
    DashboardEnsureDirectory { path } =>
      dashboard_target_exec(
        instance: instance,
        program: "/usr/bin/mkdir" as std.types.FilePath,
        args: ["-p", path as String],
      )
    DashboardEnsureProviderStateRoot { path } =>
      dashboard_target_exec(
        instance: instance,
        program: "/usr/bin/mkdir" as std.types.FilePath,
        args: ["-p", path as String],
      )
    DashboardEnsureServeBinary { controller_repo, built_binary, path } =>
      dashboard_ensure_serve_binary(
        instance: instance,
        controller_repo: controller_repo,
        built_binary: built_binary,
        path: path,
      )
    DashboardEnsureOwnershipMarker { path, instance_id: _ } =>
      dashboard_target_exec(
        instance: instance,
        program: "/usr/bin/touch" as std.types.FilePath,
        args: [path as String],
      )
    DashboardEnsureLocalOrigin { bundle, origin, source_ref, publish_ref } =>
      dashboard_ensure_local_origin(
        instance: instance,
        bundle: bundle,
        origin: origin,
        source_ref: source_ref,
        publish_ref: publish_ref,
      )
    DashboardEnsureSourceRepo { origin, repo, anchor_ref } =>
      dashboard_ensure_source_repo(
        instance: instance,
        origin: origin,
        repo: repo,
        anchor_ref: anchor_ref,
      )
    DashboardEnsureService {
      instance_id: _,
      binary: _,
      workdir: _,
      handler: _,
      host: _,
      port: _,
      tmux_server: _,
    } =>
      dashboard_ensure_service(instance: instance)
    DashboardVerifyProviderRuntime { executable, state_root } => {
      let result = dashboard_target_exec(
        instance: instance,
        program: dashboard_environment_binding_executable,
        args: shape_codex_version_env_args_for_program(
          program: executable as String,
          codex_home: state_root as String,
        ),
      )
      if result.success
          && codex_runtime_version_identity_satisfied(
            combined_output: join([result.stdout, "\n", result.stderr], ""),
          ) {
        result
      } else {
        DashboardExecResult {
          success: false,
          stdout: result.stdout,
          stderr: join([
            "provider runtime identity did not realize ",
            codex_runtime_version_identity_marker(),
            if result.stderr == "" { "" } else { join([": ", result.stderr], "") },
          ], ""),
        }
      }
    }
    DashboardVerifyProviderAuth { executable, state_root } =>
      dashboard_target_exec(
        instance: instance,
        program: dashboard_environment_binding_executable,
        args: shape_codex_login_status_env_args_for_program(
          program: executable as String,
          codex_home: state_root as String,
        ),
      )
    DashboardVerifyHealth { host: _, port: _ } =>
      dashboard_verify_health(instance: instance)
  }
}

type DashboardProvisionStepReceipt {
  kind: std.types.NonEmptyStr
  target: String
  success: Bool
  detail: String
}

type DashboardApplyFold {
  running: Bool
  receipts: List<DashboardProvisionStepReceipt>
  refused_step: String
  refused_detail: String
}

fn dashboard_apply_plan(
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
  plan: List<gunbc.roadmap_dashboard_instance.DashboardInstanceProvisionOp>,
  temp_bundle: std.types.FilePath,
  temp_verify_repo: std.types.FilePath,
) -> DashboardApplyFold {
  fold(
    plan,
    init: DashboardApplyFold {
      running: true,
      receipts: [],
      refused_step: "",
      refused_detail: "",
    },
    f: (acc, op) => {
      let row = dashboard_instance_provision_op_row(op: op)
      if !acc.running {
        acc
      } else {
        let result = dashboard_apply_provision_op(
          instance: instance,
          op: op,
          temp_bundle: temp_bundle,
          temp_verify_repo: temp_verify_repo,
        )
        let detail = if result.success {
          trim(join([result.stdout, "\n", result.stderr], ""))
        } else {
          join([result.stderr, result.stdout], "\n")
        }
        DashboardApplyFold {
          running: result.success,
          receipts: concat(acc.receipts, [
            DashboardProvisionStepReceipt {
              kind: row.kind,
              target: row.target,
              success: result.success,
              detail: detail,
            },
          ]),
          refused_step: if result.success { "" } else { row.kind as String },
          refused_detail: if result.success { "" } else { detail },
        }
      }
    },
  )
}

type DashboardProductionSnapshot {
  observed: Bool
  head: String
  health: String
  detail: String
}

fn dashboard_production_snapshot(
  production: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
) -> DashboardProductionSnapshot {
  let head = dashboard_target_probe(
    instance: production,
    program: "/usr/bin/git" as std.types.FilePath,
    args: shape_git_rev_parse_argv(
      repo: production.repo_root,
      target: "HEAD" as std.types.GitRef,
    ),
  )
  let health = dashboard_target_probe(
    instance: production,
    program: "/usr/bin/curl" as std.types.FilePath,
    args: [
      "-fsS",
      join(["http://127.0.0.1:", to_string(production.listen_port), "/healthz"], ""),
    ],
  )
  DashboardProductionSnapshot {
    observed: head.success && health.success,
    head: trim(head.stdout),
    health: trim(health.stdout),
    detail: join([head.stderr, health.stderr], "\n"),
  }
}

fn dashboard_production_snapshots_equal(
  before: DashboardProductionSnapshot,
  after: DashboardProductionSnapshot,
) -> Bool {
  before.observed
    && after.observed
    && before.head == after.head
    && before.health == after.health
}

data dashboard_production_peer_note: String = "PRODUCTION IS A PEER ON THE APPLYING HOST, and until this type existed the parameter forced every apply to name one whether the host had one or not. Both uses assume locality without saying so: the isolation check compares owned paths on one filesystem, and the liveness read-back curls 127.0.0.1 at production's declared port. Passing a remote instance satisfies neither — it compares this machine's paths against another machine's declarations, then probes a loopback port nobody here is serving.\\n\\nThat is exactly how srv2's first apply failed. srv1-live was passed as production because the parameter demanded an instance; its repo_root happened to exist here as a hand-made symlink so the git half of the probe SUCCEEDED, and the refusal surfaced only as a curl connection error against port 8080 — a true message about a check that should never have run. The remedy for that refusal is not to start a server; it is to stop claiming srv1 is a peer of anything on srv2.\\n\\nNoProductionPeer is a DECLARATION, not a skipped check. A host with no production dashboard has nothing to be disjoint from and nothing whose liveness could be disturbed, so both obligations are discharged by the shape of the argument rather than silently bypassed inside the checks — and the reading below stays type-distinct across before and after, so an apply cannot pair a real snapshot with an absent one and call the difference untouched."

type DashboardProductionPeer
  = ProductionPeer { instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance }
  | NoProductionPeer { host: std.types.NonEmptyStr }

type DashboardProductionReading
  = ProductionRead { snapshot: DashboardProductionSnapshot }
  | ProductionUnpeered { host: std.types.NonEmptyStr }

fn dashboard_peer_isolation_ok(
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
  peer: DashboardProductionPeer,
) -> Bool {
  match peer {
    ProductionPeer { instance: production } =>
      dashboard_instances_have_disjoint_owned_paths(a: instance, b: production)
        && !(instance.listen_port == production.listen_port)
    NoProductionPeer { host: _ } => true
  }
}

fn dashboard_production_read(peer: DashboardProductionPeer) -> DashboardProductionReading {
  match peer {
    ProductionPeer { instance: production } =>
      ProductionRead { snapshot: dashboard_production_snapshot(production: production) }
    NoProductionPeer { host } => ProductionUnpeered { host: host }
  }
}

fn dashboard_production_reading_refused(reading: DashboardProductionReading) -> Bool {
  match reading {
    ProductionRead { snapshot } => !snapshot.observed
    ProductionUnpeered { host: _ } => false
  }
}

fn dashboard_production_reading_detail(reading: DashboardProductionReading) -> String {
  match reading {
    ProductionRead { snapshot } => snapshot.detail
    ProductionUnpeered { host } => join(["no production peer on ", host as String], "")
  }
}

fn dashboard_production_readings_equal(
  before: DashboardProductionReading,
  after: DashboardProductionReading,
) -> Bool {
  match before {
    ProductionRead { snapshot: b } =>
      match after {
        ProductionRead { snapshot: a } =>
          dashboard_production_snapshots_equal(before: b, after: a)
        ProductionUnpeered { host: _ } => false
      }
    ProductionUnpeered { host: bh } =>
      match after {
        ProductionRead { snapshot: _ } => false
        ProductionUnpeered { host: ah } => bh == ah
      }
  }
}

fn dashboard_source_anchor_matches(
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
) -> Bool {
  if !dashboard_target_directory_present(
    instance: instance,
    path: concat(instance.repo_root as String, "/.git") as std.types.FilePath,
  ) {
    false
  } else {
    let head = dashboard_target_probe(
      instance: instance,
      program: "/usr/bin/git" as std.types.FilePath,
      args: shape_git_rev_parse_argv(
        repo: instance.repo_root,
        target: "HEAD" as std.types.GitRef,
      ),
    )
    let base = dashboard_target_probe(
      instance: instance,
      program: "/usr/bin/git" as std.types.FilePath,
      args: shape_git_rev_parse_argv(
        repo: instance.repo_root,
        target: instance.dispatch_base_ref as std.types.GitRef,
      ),
    )
    head.success && base.success && trim(head.stdout) == trim(base.stdout)
  }
}

fn dashboard_source_revision_readback(
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
  desired_source_revision: std.types.CommitSha,
) -> DashboardExecResult {
  let head = dashboard_target_probe(
    instance: instance,
    program: "/usr/bin/git" as std.types.FilePath,
    args: shape_git_rev_parse_argv(
      repo: instance.repo_root,
      target: "HEAD" as std.types.GitRef,
    ),
  )
  let observed = trim(head.stdout)
  if !head.success {
    dashboard_exec_refused(detail: join([
      "git rev-parse HEAD refused: ",
      head.stderr,
      head.stdout,
    ], ""))
  } else if desired_source_revision == "" {
    dashboard_exec_refused(detail: "controller source revision is empty")
  } else if observed == desired_source_revision {
    dashboard_exec_ok(stdout: observed)
  } else {
    DashboardExecResult {
      success: true,
      stdout: observed,
      stderr: join([
        "source revision drift: desired=",
        desired_source_revision,
        " observed=",
        observed,
      ], ""),
    }
  }
}

fn dashboard_instance_observe(
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
  production_untouched: Bool,
  desired_source_revision: std.types.CommitSha,
) -> gunbc.roadmap_dashboard_instance.DashboardInstanceObserved {
  let health = dashboard_read_instance_health(instance: instance)
  let provider_runtime = match dashboard_instance_provider_executable(instance: instance) {
    Absent =>
      dashboard_exec_refused(
        detail: dashboard_instance_provider_executable_refusal_detail(instance: instance),
      )
    Present { value: codex_program } =>
      dashboard_target_probe(
        instance: instance,
        program: dashboard_environment_binding_executable,
        args: shape_codex_version_env_args_for_program(
          program: codex_program as String,
          codex_home: dashboard_instance_provider_state_root(instance: instance) as String,
        ),
      )
  }
  let provider = match dashboard_instance_provider_executable(instance: instance) {
    Absent =>
      dashboard_exec_refused(
        detail: dashboard_instance_provider_executable_refusal_detail(instance: instance),
      )
    Present { value: codex_program } =>
      dashboard_target_probe(
        instance: instance,
        program: dashboard_environment_binding_executable,
        args: shape_codex_login_status_env_args_for_program(
          program: codex_program as String,
          codex_home: dashboard_instance_provider_state_root(instance: instance) as String,
        ),
      )
  }
  let service = dashboard_target_probe(
    instance: instance,
    program: "/usr/bin/tmux" as std.types.FilePath,
    args: shape_tmux_has_session_argv_for(
      scope: instance.tmux_server,
      session_name: dashboard_instance_service_session_name(instance: instance) as String,
    ),
  )
  let bundle_present = match instance.source_seed {
    DashboardExistingRepo { anchor_ref: _ } => true
    DashboardGitBundle {
      controller_repo: _,
      staged_bundle,
      anchor_ref: _,
      history_remote: _,
    } =>
      dashboard_target_file_present(instance: instance, path: staged_bundle)
  }
  let source_revision = dashboard_source_revision_readback(
    instance: instance,
    desired_source_revision: desired_source_revision,
  )
  let obs_root = dashboard_target_path_observe(instance: instance, flag: "-d", path: instance.instance_root)
  let obs_marker = dashboard_target_path_observe(instance: instance, flag: "-f", path: dashboard_instance_ownership_marker_path(instance: instance))
  let obs_origin = dashboard_target_path_observe(instance: instance, flag: "-d", path: instance.local_origin_root)
  let obs_source = dashboard_target_path_observe(instance: instance, flag: "-d", path: instance.repo_root)
  let obs_attempts = dashboard_target_path_observe(instance: instance, flag: "-d", path: dashboard_instance_dispatch_worktree_root(instance: instance))
  let obs_attempt_state = dashboard_target_path_observe(instance: instance, flag: "-d", path: dashboard_instance_dispatch_attempt_state_root(instance: instance))
  let probe_refusals = fold(
    [
      dashboard_exec_refusal_reason(label: "provider runtime", r: provider_runtime),
      dashboard_exec_refusal_reason(label: "provider auth", r: provider),
      dashboard_exec_refusal_reason(label: "service session", r: service),
    ],
    init: [],
    f: fn(acc, rs) { concat(acc, rs) },
  )
  let path_refusals = fold(
    [obs_root, obs_marker, obs_origin, obs_source, obs_attempts, obs_attempt_state],
    init: [],
    f: fn(acc, o) { concat(acc, dashboard_path_observation_refusal(obs: o)) },
  )
  gunbc.roadmap_dashboard_instance.DashboardInstanceObserved {
    observation_refusals: concat(path_refusals, probe_refusals),
    root_present: dashboard_observation_present_bit(obs: obs_root),
    ownership_marker_present: dashboard_observation_present_bit(obs: obs_marker),
    bundle_present: bundle_present,
    origin_present: dashboard_observation_present_bit(obs: obs_origin),
    source_present: dashboard_observation_present_bit(obs: obs_source),
    source_revision_observed: source_revision.success,
    source_revision_current: source_revision.success
      && trim(source_revision.stdout) == desired_source_revision,
    source_revision_detail: trim(join([
      source_revision.stdout,
      "\n",
      source_revision.stderr,
    ], "")),
    attempts_present: dashboard_observation_present_bit(obs: obs_attempts),
    attempt_state_present: dashboard_observation_present_bit(obs: obs_attempt_state),
    provider_runtime_ready: provider_runtime.success
      && codex_runtime_version_identity_satisfied(
        combined_output: join([provider_runtime.stdout, "\n", provider_runtime.stderr], ""),
      ),
    provider_runtime_detail: trim(join([
      provider_runtime.stdout,
      "\n",
      provider_runtime.stderr,
    ], "")),
    provider_authenticated: provider.success,
    provider_auth_detail: trim(join([
      provider.stdout,
      "\n",
      provider.stderr,
    ], "")),
    service_present: service.success,
    health_current: dashboard_health_names_instance(instance: instance, result: health),
    production_untouched: production_untouched,
    source_anchor_matches: dashboard_source_anchor_matches(instance: instance),
  }
}

data preflight_provider_deadlock_note: String = "A FRESH HOST COULD NOT REACH THE STEP THAT UNBLOCKS IT. Preflight ran in full before any plan operation, and it refuses when the provider is unauthenticated — but the operation that CREATES the state root a login writes into is a plan operation. So on a genuinely new instance the sequence was: preflight refuses at provider-auth, the ensure-state-root op never runs, the operator types codex login, and the CLI exits with 'that path does not exist'. The only way out was to create the directory by hand, which is the workaround this repository treats as a line-stop (review, 2026-07-30).\\n\\nsrv2 did not hit it because the login had already happened before the ensure op existed. That is precisely the masking condition worth recording: the deadlock is invisible on every host that was provisioned by hand first, and appears only on the first host that was not.\\n\\nDashboardApplyPreflightBootstrapPending is the third outcome the two-valued result could not express. Everything a deployment can do WITHOUT a credential — directories, the state root itself, the serve binary — is genuinely ready; only the provider is not. Reporting that as a flat refusal conflates 'this cannot proceed' with 'this can proceed up to the point a human is required', and those have different next actions: one is a defect, the other is an escalation."

type DashboardApplyPreflightResult
  = DashboardApplyPreflightReady {
      instance_id: std.types.NonEmptyStr,
      source_revision: std.types.CommitSha,
    }
  | DashboardApplyPreflightBootstrapPending {
      instance_id: std.types.NonEmptyStr,
      source_revision: std.types.CommitSha,
      state_root: std.types.FilePath,
      remediation: String,
    }
  | DashboardApplyPreflightRefused {
      instance_id: std.types.NonEmptyStr,
      step: std.types.NonEmptyStr,
      detail: String,
    }

fn dashboard_apply_preflight_refused(
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
  step: String,
  detail: String,
) -> DashboardApplyPreflightResult {
  DashboardApplyPreflightRefused {
    instance_id: instance.instance_id,
    step: step as std.types.NonEmptyStr,
    detail: detail,
  }
}

fn dashboard_source_preflight_decision(
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
  ref_read: DashboardExecResult,
  status_read: DashboardExecResult,
  shallow_read: DashboardExecResult,
  history_remote_read: DashboardExecResult,
) -> DashboardApplyPreflightResult {
  if !ref_read.success {
    dashboard_apply_preflight_refused(
      instance: instance,
      step: "controller-source-ref",
      detail: join([
        "source ref is not bundleable: ",
        ref_read.stderr,
        ref_read.stdout,
      ], ""),
    )
  } else if !status_read.success {
    dashboard_apply_preflight_refused(
      instance: instance,
      step: "controller-source-status",
      detail: join([
        "source worktree status could not be read: ",
        status_read.stderr,
        status_read.stdout,
      ], ""),
    )
  } else if trim(ref_read.stdout) == "" {
    dashboard_apply_preflight_refused(
      instance: instance,
      step: "controller-source-ref",
      detail: "source ref resolved successfully but returned an empty revision",
    )
  } else if trim(status_read.stdout) != "" {
    dashboard_apply_preflight_refused(
      instance: instance,
      step: "controller-source-dirty",
      detail: join([
        "git bundle carries committed objects only; commit or otherwise model these source changes before apply: ",
        status_read.stdout,
      ], ""),
    )
  } else if !shallow_read.success {
    dashboard_apply_preflight_refused(
      instance: instance,
      step: "controller-history-state",
      detail: join([
        "could not determine whether controller history is shallow: ",
        shallow_read.stderr,
        shallow_read.stdout,
      ], ""),
    )
  } else if trim(shallow_read.stdout) != "true"
      && trim(shallow_read.stdout) != "false" {
    dashboard_apply_preflight_refused(
      instance: instance,
      step: "controller-history-state",
      detail: join([
        "git returned an unknown shallow-repository state: ",
        shallow_read.stdout,
      ], ""),
    )
  } else if trim(shallow_read.stdout) == "true"
      && !history_remote_read.success {
    dashboard_apply_preflight_refused(
      instance: instance,
      step: "controller-history-remote",
      detail: join([
        "controller history is shallow but the modeled hydration remote is unavailable: ",
        history_remote_read.stderr,
      ], ""),
    )
  } else {
    DashboardApplyPreflightReady {
      instance_id: instance.instance_id,
      source_revision: trim(ref_read.stdout) as std.types.CommitSha,
    }
  }
}

// THE SERVE BINARY LEFT THIS ROSTER BECAUSE IT STOPPED BEING A PRECONDITION. This list is what must ALREADY EXIST on the target for provisioning to be possible — git to clone, tmux to run the service, mkdir and mv and cp to place things, the provider executable to preflight auth. The serve binary used to qualify because instances borrowed production's, which was installed by a different mechanism and always present.\n\nMaking it instance-owned turned it into an OUTPUT of the very plan this preflight gates, and the two facts together are a deadlock: preflight refuses because the binary is absent, and the only thing that installs it is the apply preflight is refusing to admit. Observed exactly that way on srv2 — a refusal naming a path that nothing but the blocked apply could ever create.\n\nThe distinction the roster now holds is precondition versus deliverable, and it is worth stating because the deadlock is invisible while every path happens to pre-exist. dirname and chmod join for the same reason the binary leaves: the install step runs them, so they are genuinely required beforehand. Whether the binary landed is answered AFTER apply by the readback, which is where an output belongs.
fn dashboard_required_target_executables(
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
) -> List<std.types.FilePath> {
  let provider_paths = match dashboard_instance_provider_executable(instance: instance) {
    Present { value: executable } => [executable]
    Absent => []
  }
  fold(
    concat(
      concat(
        [
          "/usr/bin/git" as FilePath,
          "/usr/bin/tmux" as FilePath,
          "/usr/bin/curl" as FilePath,
          "/usr/bin/mkdir" as FilePath,
          "/usr/bin/touch" as FilePath,
          "/usr/bin/mv" as FilePath,
          "/usr/bin/nc" as FilePath,
          "/usr/bin/dirname" as FilePath,
          chmod_binary_path as String as FilePath,
        ],
        provider_paths,
      ),
      dashboard_instance_dispatch_platform_executables(instance: instance),
    ),
    init: [],
    f: fn(acc, path) {
      if any(acc, existing => existing == path) {
        acc
      } else {
        append(acc, [path])
      }
    },
  )
}

data executable_survey_note: String = "ABSENT AND UNOBSERVED ARE DIFFERENT ANSWERS ABOUT A REQUIRED EXECUTABLE, and this survey is the fold that stopped conflating them (review 45213). The predecessor filtered the required paths on a Bool that was false for both, so a refused transport reported every required executable as missing — a list of real paths, each of which may well exist, handed to an operator as the thing to go install.\\n\\nThe survey refuses on the FIRST unobservable path rather than continuing, because the refusal is a property of the transport and not of the path: once a probe could not be delivered, the remaining probes carry no information either, and a partial missing-list assembled from the ones that happened to answer is exactly the partial observation that looks complete. Carrying the path alongside the reason keeps the refusal located — which probe stopped the line — rather than reporting only that something went wrong."

type DashboardExecutableSurvey
  = ExecutablesSurveyed { missing: List<std.types.FilePath> }
  | ExecutableSurveyRefused { path: std.types.FilePath, reason: String }

fn dashboard_survey_target_executables(
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
) -> DashboardExecutableSurvey {
  match dashboard_instance_provider_executable(instance: instance) {
    Absent =>
      ExecutableSurveyRefused {
        path: dashboard_environment_binding_executable,
        reason: dashboard_instance_provider_executable_refusal_detail(instance: instance),
      }
    Present { value: _ } =>
      fold(
        dashboard_required_target_executables(instance: instance),
        ExecutablesSurveyed { missing: [] },
        f: fn(acc, path) {
          match acc {
            ExecutableSurveyRefused { path: _, reason: _ } => acc
            ExecutablesSurveyed { missing } =>
              match dashboard_target_path_observe(instance: instance, flag: "-x", path: path) {
                PathObservedPresent => acc
                PathObservedAbsent => ExecutablesSurveyed { missing: append(missing, [path]) }
                PathObservationRefused { reason } =>
                  ExecutableSurveyRefused { path: path, reason: reason }
              }
          }
        },
      )
  }
}

data bootstrap_unobserved_is_its_own_verdict_note: String = "THE THIRD VERDICT, because absent, unwritable and unobservable call for three different actions (review 45213). This decision took three Bools, and the writability one came from the collapsing predicate, so a refused transport arrived here as bootstrap_writable: false and the operator was told the nearest modeled bootstrap parent is not writable — a claim about permissions on a directory nobody managed to stat.\\n\\nBoth pre-existing arms are ACTIONABLE and that is what made the collapse harmful rather than merely imprecise: absent says create it, not-writable says fix its mode, and each sends someone to do something specific on evidence that was never gathered. The new arm deliberately carries no instruction at all, only the path whose observation failed and the reason it failed, because nothing about the bootstrap parent is known when the probe did not run.\\n\\nIt is a separate variant rather than a reason string on the existing refusal so that consumers must decide what to do with it — a match that forgot the case does not compile, which is the wall the Bool never was."

type DashboardBootstrapPreflight
  = DashboardBootstrapReady { bootstrap_root: std.types.FilePath }
  | DashboardBootstrapRefused {
      bootstrap_root: std.types.FilePath,
      reason: std.types.NonEmptyStr,
    }
  | DashboardBootstrapUnobserved {
      path: std.types.FilePath,
      reason: String,
    }

fn dashboard_bootstrap_preflight_decision(
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
  root: DashboardPathObservation,
  bootstrap_present: DashboardPathObservation,
  bootstrap_writable: DashboardPathObservation,
) -> DashboardBootstrapPreflight {
  match root {
    PathObservationRefused { reason } =>
      DashboardBootstrapUnobserved { path: instance.instance_root, reason: reason }
    PathObservedPresent =>
      dashboard_bootstrap_parent_decision(
        bootstrap_root: instance.instance_root,
        bootstrap_present: bootstrap_present,
        bootstrap_writable: bootstrap_writable,
      )
    PathObservedAbsent =>
      dashboard_bootstrap_parent_decision(
        bootstrap_root: instance.provision_parent_root,
        bootstrap_present: bootstrap_present,
        bootstrap_writable: bootstrap_writable,
      )
  }
}

fn dashboard_bootstrap_parent_decision(
  bootstrap_root: std.types.FilePath,
  bootstrap_present: DashboardPathObservation,
  bootstrap_writable: DashboardPathObservation,
) -> DashboardBootstrapPreflight {
  match bootstrap_present {
    PathObservationRefused { reason } =>
      DashboardBootstrapUnobserved { path: bootstrap_root, reason: reason }
    PathObservedAbsent =>
      DashboardBootstrapRefused {
        bootstrap_root: bootstrap_root,
        reason: "nearest modeled bootstrap parent is absent" as std.types.NonEmptyStr,
      }
    PathObservedPresent =>
      match bootstrap_writable {
        PathObservationRefused { reason } =>
          DashboardBootstrapUnobserved { path: bootstrap_root, reason: reason }
        PathObservedAbsent =>
          DashboardBootstrapRefused {
            bootstrap_root: bootstrap_root,
            reason: "nearest modeled bootstrap parent is not writable" as std.types.NonEmptyStr,
          }
        PathObservedPresent => DashboardBootstrapReady { bootstrap_root: bootstrap_root }
      }
  }
}

fn dashboard_instance_apply_preflight(
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
  production: DashboardProductionPeer,
) -> DashboardApplyPreflightResult {
  if !dashboard_instance_paths_are_owned(instance: instance)
      || !dashboard_peer_isolation_ok(instance: instance, peer: production) {
    dashboard_apply_preflight_refused(
      instance: instance,
      step: "isolation-preflight",
      detail: "instance path or port isolation failed",
    )
  } else {
    let production_read = dashboard_production_read(peer: production)
    if dashboard_production_reading_refused(reading: production_read) {
      dashboard_apply_preflight_refused(
        instance: instance,
        step: "production-preflight",
        detail: join([
          "production read-back refused: ",
          dashboard_production_reading_detail(reading: production_read),
        ], ""),
      )
    } else {
      let root_obs = dashboard_target_path_observe(
        instance: instance,
        flag: "-d",
        path: instance.instance_root,
      )
      let bootstrap_root = match root_obs {
        PathObservedPresent => instance.instance_root
        PathObservedAbsent => instance.provision_parent_root
        PathObservationRefused { reason: _ } => instance.instance_root
      }
      let bootstrap = dashboard_bootstrap_preflight_decision(
        instance: instance,
        root: root_obs,
        bootstrap_present: dashboard_target_path_observe(
          instance: instance,
          flag: "-d",
          path: bootstrap_root,
        ),
        bootstrap_writable: dashboard_target_path_observe(
          instance: instance,
          flag: "-w",
          path: bootstrap_root,
        ),
      )
      match bootstrap {
        DashboardBootstrapUnobserved { path: unobserved, reason } =>
          dashboard_apply_preflight_refused(
            instance: instance,
            step: "instance-bootstrap-parent",
            detail: join([
              "bootstrap parent could not be observed at ",
              unobserved as String,
              ": ",
              reason,
            ], ""),
          )
        DashboardBootstrapRefused { bootstrap_root: refused_root, reason } =>
          dashboard_apply_preflight_refused(
            instance: instance,
            step: "instance-bootstrap-parent",
            detail: join([
              reason as String,
              ": ",
              refused_root as String,
            ], ""),
          )
        DashboardBootstrapReady { bootstrap_root: _ } =>
      match instance.source_seed {
        DashboardExistingRepo { anchor_ref: _ } =>
          dashboard_apply_preflight_refused(
            instance: instance,
            step: "source-seed",
            detail: "isolated instance apply requires a modeled Git-bundle seed",
          )
        DashboardGitBundle {
          controller_repo,
          staged_bundle: _,
          anchor_ref,
          history_remote,
        } => {
          let source = dashboard_source_preflight_decision(
            instance: instance,
            ref_read: dashboard_local_exec(
              workdir: controller_repo,
              program: "/usr/bin/git" as std.types.FilePath,
              args: shape_git_rev_parse_argv(
                repo: controller_repo,
                target: anchor_ref as std.types.GitRef,
              ),
            ),
            status_read: dashboard_local_exec(
              workdir: controller_repo,
              program: "/usr/bin/git" as std.types.FilePath,
              args: shape_git_status_porcelain_argv(repo: controller_repo),
            ),
            shallow_read: dashboard_local_exec(
              workdir: controller_repo,
              program: "/usr/bin/git" as std.types.FilePath,
              args: shape_git_is_shallow_repository_argv(repo: controller_repo),
            ),
            history_remote_read: dashboard_local_exec(
              workdir: controller_repo,
              program: "/usr/bin/git" as std.types.FilePath,
              args: shape_git_remote_get_url_argv(
                repo: controller_repo,
                remote: history_remote,
              ),
            ),
          )
          match source {
            DashboardApplyPreflightRefused { instance_id: _, step: _, detail: _ } =>
              source
            DashboardApplyPreflightBootstrapPending {
              instance_id: _,
              source_revision: _,
              state_root: _,
              remediation: _,
            } =>
              source
            DashboardApplyPreflightReady {
              instance_id: _,
              source_revision,
            } => {
              match dashboard_survey_target_executables(instance: instance) {
                ExecutableSurveyRefused { path: unobserved, reason } =>
                  dashboard_apply_preflight_refused(
                    instance: instance,
                    step: "target-dependencies",
                    detail: join([
                      "required executable could not be observed at ",
                      unobserved as String,
                      ": ",
                      reason,
                    ], ""),
                  )
                ExecutablesSurveyed { missing } =>
              if count(missing) > 0 {
                dashboard_apply_preflight_refused(
                  instance: instance,
                  step: "target-dependencies",
                  detail: join([
                    "required executable paths absent: ",
                    join(map(missing, p => p as String), ", "),
                  ], ""),
                )
              } else {
                let observed = dashboard_instance_observe(
                  instance: instance,
                  production_untouched: true,
                  desired_source_revision: source_revision,
                )
                match dashboard_instance_reconcile(instance: instance, observed: observed) {
                  DashboardInstanceRefused { reason } =>
                    dashboard_apply_preflight_refused(
                      instance: instance,
                      step: "initial-reconcile",
                      detail: reason as String,
                    )
                  _ => {
                    let listener = dashboard_target_probe(
                      instance: instance,
                      program: "/usr/bin/nc" as std.types.FilePath,
                      args: [
                        "-z",
                        "127.0.0.1",
                        to_string(instance.listen_port),
                      ],
                    )
                    if listener.success && !observed.health_current {
                      dashboard_apply_preflight_refused(
                        instance: instance,
                        step: "listen-port-conflict",
                        detail: join([
                          "port ",
                          to_string(instance.listen_port),
                          " already accepts TCP but does not identify as this dashboard instance",
                        ], ""),
                      )
                    } else if !observed.provider_runtime_ready {
                      dashboard_apply_preflight_refused(
                        instance: instance,
                        step: "provider-runtime-unrealized",
                        detail: join([
                          "codex --version did not realize ",
                          codex_runtime_version_identity_marker(),
                          " through ",
                          dashboard_environment_binding_executable as String,
                          if observed.provider_runtime_detail == "" {
                            ""
                          } else {
                            join([": ", observed.provider_runtime_detail], "")
                          },
                        ], ""),
                      )
                    } else if !observed.provider_authenticated {
                      match dashboard_instance_provider_executable(instance: instance) {
                        Absent =>
                          dashboard_apply_preflight_refused(
                            instance: instance,
                            step: "provider-executable-placement",
                            detail: dashboard_instance_provider_executable_refusal_detail(
                              instance: instance,
                            ),
                          )
                        Present { value: codex_program } =>
                          DashboardApplyPreflightBootstrapPending {
                            instance_id: instance.instance_id,
                            source_revision: source_revision,
                            state_root: dashboard_instance_provider_state_root(instance: instance),
                            remediation: dashboard_provider_device_login_command(
                              instance: instance,
                              codex_program: codex_program,
                            ),
                          }
                      }
                    } else {
                      DashboardApplyPreflightReady {
                        instance_id: instance.instance_id,
                        source_revision: source_revision,
                      }
                    }
                  }
                }
              }
              }
            }
          }
        }
      }
      }
    }
  }
}

fn dashboard_apply_preflight_json_value(
  result: DashboardApplyPreflightResult,
) -> extdeps.languages.json.emit.JsonValue {
  match result {
    DashboardApplyPreflightReady { instance_id, source_revision } =>
      json_object(members: [
        json_kv(key: "schema", value: json_string(s: "dashboard-instance-preflight/v1")),
        json_kv(key: "instance_id", value: json_string(s: instance_id as String)),
        json_kv(key: "status", value: json_string(s: "ready")),
        json_kv(key: "source_revision", value: json_string(s: source_revision)),
      ])
    DashboardApplyPreflightBootstrapPending {
      instance_id,
      source_revision,
      state_root,
      remediation,
    } =>
      json_object(members: [
        json_kv(key: "schema", value: json_string(s: "dashboard-instance-preflight/v1")),
        json_kv(key: "instance_id", value: json_string(s: instance_id as String)),
        json_kv(key: "status", value: json_string(s: "bootstrap-pending")),
        json_kv(key: "source_revision", value: json_string(s: source_revision)),
        json_kv(key: "state_root", value: json_string(s: state_root as String)),
        json_kv(key: "remediation", value: json_string(s: remediation)),
      ])
    DashboardApplyPreflightRefused { instance_id, step, detail } =>
      json_object(members: [
        json_kv(key: "schema", value: json_string(s: "dashboard-instance-preflight/v1")),
        json_kv(key: "instance_id", value: json_string(s: instance_id as String)),
        json_kv(key: "status", value: json_string(s: "refused")),
        json_kv(key: "step", value: json_string(s: step as String)),
        json_kv(key: "detail", value: json_string(s: detail)),
      ])
  }
}

type DashboardInstanceApplyResult
  = DashboardApplyConverged {
      instance_id: std.types.NonEmptyStr,
      receipts: List<DashboardProvisionStepReceipt>,
      observed: gunbc.roadmap_dashboard_instance.DashboardInstanceObserved,
    }
  | DashboardApplyRefused {
      instance_id: std.types.NonEmptyStr,
      step: std.types.NonEmptyStr,
      detail: String,
      receipts: List<DashboardProvisionStepReceipt>,
    }

fn dashboard_apply_result_json_value(
  result: DashboardInstanceApplyResult,
) -> extdeps.languages.json.emit.JsonValue {
  match result {
    DashboardApplyConverged { instance_id, receipts, observed } =>
      json_object(members: [
        json_kv(key: "schema", value: json_string(s: "dashboard-instance-apply/v1")),
        json_kv(key: "instance_id", value: json_string(s: instance_id as String)),
        json_kv(key: "status", value: json_string(s: "converged")),
        json_kv(key: "health_current", value: extdeps.languages.json.emit.json_bool(b: observed.health_current)),
        json_kv(key: "production_untouched", value: extdeps.languages.json.emit.json_bool(b: observed.production_untouched)),
        json_kv(key: "source_revision_current", value: extdeps.languages.json.emit.json_bool(b: observed.source_revision_current)),
        json_kv(key: "source_revision_detail", value: json_string(s: observed.source_revision_detail)),
        json_kv(key: "steps", value: json_array(elements: receipts |> map(r =>
          dashboard_step_receipt_json_value(receipt: r)))),
      ])
    DashboardApplyRefused { instance_id, step, detail, receipts } =>
      json_object(members: [
        json_kv(key: "schema", value: json_string(s: "dashboard-instance-apply/v1")),
        json_kv(key: "instance_id", value: json_string(s: instance_id as String)),
        json_kv(key: "status", value: json_string(s: "refused")),
        json_kv(key: "step", value: json_string(s: step as String)),
        json_kv(key: "detail", value: json_string(s: detail)),
        json_kv(key: "steps", value: json_array(elements: receipts |> map(r =>
          dashboard_step_receipt_json_value(receipt: r)))),
      ])
  }
}

fn dashboard_step_receipt_json_value(
  receipt: DashboardProvisionStepReceipt,
) -> extdeps.languages.json.emit.JsonValue {
  json_object(members: [
    json_kv(key: "kind", value: json_string(s: receipt.kind as String)),
    json_kv(key: "target", value: json_string(s: receipt.target)),
    json_kv(key: "success", value: extdeps.languages.json.emit.json_bool(b: receipt.success)),
    json_kv(key: "detail", value: json_string(s: receipt.detail)),
  ])
}

fn dashboard_apply_refused(
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
  step: String,
  detail: String,
  receipts: List<DashboardProvisionStepReceipt>,
) -> DashboardInstanceApplyResult {
  DashboardApplyRefused {
    instance_id: instance.instance_id,
    step: step as std.types.NonEmptyStr,
    detail: detail,
    receipts: receipts,
  }
}

fn dashboard_instance_apply_after_preflight(
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
  production: DashboardProductionPeer,
  desired_source_revision: std.types.CommitSha,
) -> DashboardInstanceApplyResult {
  if !dashboard_instance_paths_are_owned(instance: instance)
      || !dashboard_peer_isolation_ok(instance: instance, peer: production) {
    dashboard_apply_refused(
      instance: instance,
      step: "isolation-preflight",
      detail: "instance path or port isolation failed before any mutation",
      receipts: [],
    )
  } else {
    let production_before = dashboard_production_read(peer: production)
    if dashboard_production_reading_refused(reading: production_before) {
      dashboard_apply_refused(
        instance: instance,
        step: "production-preflight",
        detail: join([
          "production read-back refused before mutation: ",
          dashboard_production_reading_detail(reading: production_before),
        ], ""),
        receipts: [],
      )
    } else {
      let before = dashboard_instance_observe(
        instance: instance,
        production_untouched: true,
        desired_source_revision: desired_source_revision,
      )
      match dashboard_instance_reconcile(instance: instance, observed: before) {
        DashboardInstanceConverged =>
          DashboardApplyConverged {
            instance_id: instance.instance_id,
            receipts: [],
            observed: before,
          }
        DashboardInstanceRefused { reason } =>
          dashboard_apply_refused(
            instance: instance,
            step: "initial-reconcile",
            detail: reason as String,
            receipts: [],
          )
        DashboardInstanceApply { plan } => {
          let temp = shell.Mktemp.Dir()
          if !temp.success {
            dashboard_apply_refused(
              instance: instance,
              step: "source-temp",
              detail: "mktemp -d failed before source materialization",
              receipts: [],
            )
          } else {
            let temp_bundle = join([temp.path as String, "/source.bundle"], "") as std.types.FilePath
            let temp_verify_repo = join([temp.path as String, "/verify.git"], "") as std.types.FilePath
            let applied = dashboard_apply_plan(
              instance: instance,
              plan: plan,
              temp_bundle: temp_bundle,
              temp_verify_repo: temp_verify_repo,
            )
            let cleaned = shell.Remove.RecursiveForce(path: temp.path)
            if !applied.running {
              dashboard_apply_refused(
                instance: instance,
                step: applied.refused_step,
                detail: applied.refused_detail,
                receipts: applied.receipts,
              )
            } else if !cleaned.success {
              dashboard_apply_refused(
                instance: instance,
                step: "source-temp-cleanup",
                detail: "provision operations completed but temporary source bundle cleanup failed",
                receipts: applied.receipts,
              )
            } else {
              let production_after = dashboard_production_read(peer: production)
              let untouched = dashboard_production_readings_equal(
                before: production_before,
                after: production_after,
              )
              let after = dashboard_instance_observe(
                instance: instance,
                production_untouched: untouched,
                desired_source_revision: desired_source_revision,
              )
              match dashboard_instance_reconcile(instance: instance, observed: after) {
                DashboardInstanceConverged =>
                  DashboardApplyConverged {
                    instance_id: instance.instance_id,
                    receipts: applied.receipts,
                    observed: after,
                  }
                DashboardInstanceRefused { reason } =>
                  dashboard_apply_refused(
                    instance: instance,
                    step: "readback-reconcile",
                    detail: reason as String,
                    receipts: applied.receipts,
                  )
                DashboardInstanceApply { plan: remaining } =>
                  dashboard_apply_refused(
                    instance: instance,
                    step: "readback-incomplete",
                    detail: join([
                      "post-apply observation did not converge; remaining desired operations=",
                      to_string(count(remaining)),
                    ], ""),
                    receipts: applied.receipts,
                  )
              }
            }
          }
        }
      }
    }
  }
}

data bootstrap_then_escalate_note: String = "THE ARM THAT BREAKS THE DEADLOCK: run everything a credential is not required for, then stop and say what a human must do. The credential-free prefix is exactly the operations whose absence blocked the login — the instance root, the attempts and attempt-state directories, the provider state root, and the serve binary — none of which reads or writes a secret.\\n\\nIt is an ESCALATION, not a success and not a defect. dashboard_apply_refused is reused as the carrier because the deployment did not converge and must not report that it did, but the step name and the remediation say plainly that the remaining work is a human's device-code login rather than a broken deployment. Returning Converged here would be the fabricated verdict; returning a bare refusal is what created the deadlock, because it left the directory uncreated.\\n\\nThe receipts from the bootstrap operations are carried through, so a reader can see WHICH prerequisites were satisfied before the stop. That distinguishes 'stopped at the credential with everything else in place' from 'stopped early for an unrelated reason', which a refusal with an empty receipt list cannot."

// dashboard_apply_plan takes the two controller-side temp paths because its bundle operations need them; the bootstrap subset contains no bundle operation, so neither value is ever read. Passing a named marker rather than a plausible-looking /tmp path is deliberate — a realistic path would read as though a temp directory had been created and was being used, and the next reader would look for the mktemp that never ran. If a bundle op ever reaches this fold, the marker appears in the emitted argv and fails loudly instead of silently writing somewhere real.
data dashboard_bootstrap_unused_temp_path: std.types.FilePath = "/nonexistent/gunbc-bootstrap-has-no-temp-dir" as std.types.FilePath

fn dashboard_bootstrap_only_ops(
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
) -> List<gunbc.roadmap_dashboard_instance.DashboardInstanceProvisionOp> {
  dashboard_instance_provision_plan(instance: instance)
    |> filter(op => match op {
      DashboardEnsureDirectory { path: _ } => true
      DashboardEnsureProviderStateRoot { path: _ } => true
      DashboardEnsureServeBinary { controller_repo: _, built_binary: _, path: _ } => true
      _ => false
    })
}

fn dashboard_apply_bootstrap_then_escalate(
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
  state_root: std.types.FilePath,
  remediation: String,
) -> DashboardInstanceApplyResult {
  let applied = dashboard_apply_plan(
    instance: instance,
    plan: dashboard_bootstrap_only_ops(instance: instance),
    temp_bundle: dashboard_bootstrap_unused_temp_path,
    temp_verify_repo: dashboard_bootstrap_unused_temp_path,
  )
  dashboard_apply_refused(
    instance: instance,
    step: "provider-auth-required",
    detail: join([
      "credential-free bootstrap complete; the provider state root ",
      state_root as String,
      " now exists and awaits an operator device-code login: ",
      remediation,
    ], ""),
    receipts: applied.receipts,
  )
}

fn dashboard_instance_apply(
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
  production: DashboardProductionPeer,
) -> DashboardInstanceApplyResult {
  match dashboard_instance_apply_preflight(
    instance: instance,
    production: production,
  ) {
    DashboardApplyPreflightRefused { instance_id: _, step, detail } =>
      dashboard_apply_refused(
        instance: instance,
        step: step as String,
        detail: detail,
        receipts: [],
      )
    DashboardApplyPreflightBootstrapPending {
      instance_id: _,
      source_revision: _,
      state_root,
      remediation,
    } =>
      dashboard_apply_bootstrap_then_escalate(
        instance: instance,
        state_root: state_root,
        remediation: remediation,
      )
    DashboardApplyPreflightReady {
      instance_id: _,
      source_revision,
    } =>
      dashboard_instance_apply_after_preflight(
        instance: instance,
        production: production,
        desired_source_revision: source_revision,
      )
  }
}

fn srv1_lab_dashboard_apply() -> DashboardInstanceApplyResult {
  dashboard_instance_apply(
    instance: srv1_lab_dashboard_instance(),
    production: ProductionPeer { instance: srv1_live_dashboard_instance() },
  )
}

fn srv1_lab_dashboard_preflight() -> DashboardApplyPreflightResult {
  dashboard_instance_apply_preflight(
    instance: srv1_lab_dashboard_instance(),
    production: ProductionPeer { instance: srv1_live_dashboard_instance() },
  )
}

fn srv1_lab_dashboard_preflight_json() -> String {
  serialize_json(v: dashboard_apply_preflight_json_value(
    result: srv1_lab_dashboard_preflight(),
  ))
}

func srv1_lab_dashboard_preflight_wet() -> std.process.ProcessExit {
  let result = srv1_lab_dashboard_preflight()
  match result {
    DashboardApplyPreflightReady {
      instance_id: _,
      source_revision: _,
    } => std.process.ExitSuccess
    DashboardApplyPreflightBootstrapPending {
      instance_id: _,
      source_revision: _,
      state_root: _,
      remediation: _,
    } =>
      exit_failure(reason: serialize_json(v: dashboard_apply_preflight_json_value(
        result: result,
      )))
    DashboardApplyPreflightRefused { instance_id: _, step: _, detail: _ } =>
      exit_failure(reason: serialize_json(v: dashboard_apply_preflight_json_value(
        result: result,
      )))
  }
}

fn srv1_lab_dashboard_apply_json() -> String {
  serialize_json(v: dashboard_apply_result_json_value(result: srv1_lab_dashboard_apply()))
}

func srv1_lab_dashboard_apply_wet() -> std.process.ProcessExit {
  let result = srv1_lab_dashboard_apply()
  match result {
    DashboardApplyConverged { instance_id: _, receipts: _, observed: _ } => std.process.ExitSuccess
    DashboardApplyRefused { instance_id: _, step: _, detail: _, receipts: _ } =>
      exit_failure(reason: serialize_json(v: dashboard_apply_result_json_value(result: result)))
  }
}

data srv2_lab_apply_entry_note: String = "BEFORE THIS BLOCK THIS MODULE CONTAINED THE STRING srv2 ZERO TIMES. Roughly sixteen hundred lines of observe/preflight/apply/converge with typed refusals throughout, and every wet entry bound srv1's lab — so srv2's declared instance had no provisioner anywhere in the tree. Its directories could not be created by anything, which is why every git and tmux observation on that page refused against paths naming a source root, an attempts root and a tmux socket that no code was able to bring into existence.\\n\\nThat is the coverage-by-illusion shape one level up from a witness: the mechanism was real, general, and complete, and it was simply never bound to the second instance. An instance row declared without an actuation entry reads exactly like one that has been provisioned and is refusing for a good reason, and the page cannot tell the operator which it is looking at.\\n\\nsrv1's lab passes srv1_live as its peer; srv2's lab passes NoProductionPeer, and the difference is not a convenience. An earlier draft of this very row asserted the opposite — that srv1_live was the right peer for both labs because /opt/gunbc exists on this machine too — and that reasoning was wrong in the way dashboard_production_peer_note now records: the paths here are hand-made symlinks, not a production dashboard, so the isolation check compared srv2's paths against srv1's declarations and the liveness probe curled a loopback port nobody serves. Being disjoint from something that is not there is not a property worth checking; declaring that it is not there is."

fn srv2_lab_dashboard_apply() -> DashboardInstanceApplyResult {
  dashboard_instance_apply(
    instance: srv2_lab_dashboard_instance(),
    production: NoProductionPeer { host: "srv2" as std.types.NonEmptyStr },
  )
}

fn srv2_lab_dashboard_preflight() -> DashboardApplyPreflightResult {
  dashboard_instance_apply_preflight(
    instance: srv2_lab_dashboard_instance(),
    production: NoProductionPeer { host: "srv2" as std.types.NonEmptyStr },
  )
}

fn srv2_lab_dashboard_preflight_json() -> String {
  serialize_json(v: dashboard_apply_preflight_json_value(
    result: srv2_lab_dashboard_preflight(),
  ))
}

func srv2_lab_dashboard_preflight_wet() -> std.process.ProcessExit {
  let result = srv2_lab_dashboard_preflight()
  match result {
    DashboardApplyPreflightReady {
      instance_id: _,
      source_revision: _,
    } => std.process.ExitSuccess
    DashboardApplyPreflightBootstrapPending {
      instance_id: _,
      source_revision: _,
      state_root: _,
      remediation: _,
    } =>
      exit_failure(reason: serialize_json(v: dashboard_apply_preflight_json_value(
        result: result,
      )))
    DashboardApplyPreflightRefused { instance_id: _, step: _, detail: _ } =>
      exit_failure(reason: serialize_json(v: dashboard_apply_preflight_json_value(
        result: result,
      )))
  }
}

fn srv2_lab_dashboard_apply_json() -> String {
  serialize_json(v: dashboard_apply_result_json_value(result: srv2_lab_dashboard_apply()))
}

func srv2_lab_dashboard_apply_wet() -> std.process.ProcessExit {
  let result = srv2_lab_dashboard_apply()
  match result {
    DashboardApplyConverged { instance_id: _, receipts: _, observed: _ } => std.process.ExitSuccess
    DashboardApplyRefused { instance_id: _, step: _, detail: _, receipts: _ } =>
      exit_failure(reason: serialize_json(v: dashboard_apply_result_json_value(result: result)))
  }
}

data provider_readiness_readback_note: String = "THE PAGE SHOWED WHAT WAS DESIRED AND NEVER WHAT WAS TRUE. /instance.json renders desired_provision_plan, which INCLUDES the verify-provider-auth row — so a reader saw that authentication is required and nothing about whether it holds. The first anyone learned of a missing login was a shell error in an operator's terminal, which is the observation gap DESIGN 5 calls specification-without-execution: the check existed, was correct, and was bound to no surface (operator, 2026-07-30: 'the roadmap website can just send me the status/details to log in').\\n\\nTHE THREE STATES ARE SEPARATE BECAUSE THEIR REMEDIES ARE. An absent state root is fixed by creating a directory; an unavailable runtime is a packaging or PATH problem; an unauthenticated runtime needs an interactive OAuth flow only a human can complete. Collapsing them into one ready: Bool would report 'not ready' for all three and leave the reader to guess which — the state-space conflation this repository names, and the reason the apply already keeps runtime and auth as independent probes so a broken npm launcher cannot masquerade as an auth refusal.\\n\\nTHE REMEDIATION COMMAND IS DERIVED FROM THE SAME SHAPE THE PROBE RUNS, never spelled a second time. A hand-written instruction string is a parallel representation of the invocation: it drifts the moment the env var, the program path, or the state root changes, and it drifts silently because nothing executes prose. Building it from shape_codex_login_status_env_args_for_program's own inputs means the line the page prints and the line the model checks cannot disagree about where the credentials live."

data codex_probe_stream_note: String = "codex SPLITS ITS VERDICTS ACROSS STREAMS, and reading one of them reported a ready provider with no evidence attached. `codex --version` writes codex-cli 0.145.0 to stdout; `codex login status` writes 'Logged in using ChatGPT' to STDERR. Verified per-stream on srv2 by redirecting each independently: stdout alone is empty for login status, stderr alone carries the line.\\n\\nThe way this hid is worth recording, because it is the same error twice in one session. The first check of the login ran `login status 2>&1 | tail -3`, which MERGES the streams — so the verdict appeared, the probe looked correct, and which stream it came from was exactly the fact the merge destroyed. A verification that erases the distinction the code depends on cannot detect the code getting it wrong; the same shape as confirming an HTTP fix with a client that never exercises the failing path.\\n\\nSo the detail is read from whichever stream carried it, and an empty result stays visibly empty rather than being reported as a successful probe with nothing to show. This is not leniency about failure — success is still decided by the exit status alone, exactly as before; only the human-readable evidence is gathered from both places, which is what dashboard_instance_apply_note already requires when it says successful stderr is retained rather than dropped."

fn codex_probe_detail(out: String, err: String) -> String {
  let o = trim(out)
  let e = trim(err)
  if o == "" { e } else if e == "" { o } else { join([o, e], " | ") }
}

data readiness_refusal_is_not_a_negative_note: String = "AN UNREACHABLE HOST WAS PRODUCING REMEDIATION ADVICE (review 45153). Every branch of this readiness fold asked a two-valued question of a three-valued observation. dashboard_target_directory_present answers false for an absent path AND for a probe that could not run — this module's own path_observation_preserves_refusal_note says so in as many words — so an SSH transport refusal became ProviderStateRootAbsent, complete with a device-login command for the operator to type. The two probe branches did the same through the success Bool: a refused runtime probe became ProviderRuntimeUnavailable naming an executable nobody managed to ask about, and a refused auth probe became ProviderUnauthenticated telling someone to log in on a machine they cannot reach.\n\nThat is the fabricated-verdict shape rather than a missing feature, and it is worse than a wrong status because it is ACTIONABLE: the reader is handed a specific command that addresses a condition never observed. exec_refusal_reason_note in this same module already states the rule for the probe case — an unreachable host and an unauthenticated provider are the same value without the split — and the readiness fold was the caller that ignored it.\n\nThe fix is the fourth arm, and it deliberately carries NO remediation. Nothing is known about the provider when the transport did not deliver the question, so there is no correct instruction to give; what the operator needs is the reason the observation failed, which is what the arm carries. The vocabulary was already here — DashboardPathObservation's refused variant and dashboard_exec_refusal_reason — so this is the fold consuming the discrimination the module already made rather than new machinery."

type DashboardProviderReadiness
  = ProviderReady {
      runtime_detail: String,
      auth_detail: String,
    }
  | ProviderStateRootAbsent {
      state_root: std.types.FilePath,
      remediation: String,
    }
  | ProviderRuntimeUnavailable {
      executable: std.types.FilePath,
      detail: String,
    }
  | ProviderUnauthenticated {
      state_root: std.types.FilePath,
      detail: String,
      remediation: String,
    }
  | ProviderReadinessRefused {
      stage: std.types.NonEmptyStr,
      reason: String,
    }

data provider_login_command_projects_the_shaper_note: String = "THIS PROJECTS extdeps.llm.cli's DEVICE-AUTH SHAPER AND USED TO CONTRADICT IT. The readiness surface hand-concatenated `CODEX_HOME=… codex login` — the plain browser flow — in the same change that modeled shape_codex_device_login_env_args_for_program and recorded that a headless host MUST use --device-auth because the plain flow's callback resolves to localhost on the server rather than the operator's machine (review, 2026-07-30).\\n\\nSo the emitted instruction was the one proven not to work, spelled a second time beside the shaper built to prevent exactly that. Two representations of one invocation, and the prose one drifts silently because nothing executes it.\\n\\nJoining the shaper's own argv keeps the printed line and the modeled invocation the same object. If the env var, the program path or the flag changes, both move together — and the operator is never handed a command this repository has already established cannot complete."

fn dashboard_provider_device_login_command(
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
  codex_program: std.types.FilePath,
) -> String {
  join(
    shape_codex_device_login_env_args_for_program(
      program: codex_program as String,
      codex_home: dashboard_instance_provider_state_root(instance: instance) as String,
    ),
    " ",
  )
}

data state_root_remediation_is_now_the_apply_note: String = "The remediation no longer tells the operator to mkdir. Creating the state root is DashboardEnsureProviderStateRoot's job and the apply reaches it now that provider absence yields BootstrapPending instead of a refusal — so instructing a human to run mkdir would be asking them to perform a step the deployment already owns, and the hand-run directory would then differ in ownership from the one the plan creates.\\n\\nWhat remains is the part only a human can do: the device-code login. Both arms therefore project the same shaper, and the difference between them is which state the reader is in rather than which command they should type."

fn dashboard_probe_refused(r: DashboardExecResult) -> Bool {
  !r.success && trim(r.stdout) == "" && !(trim(r.stderr) == "")
}

fn dashboard_provider_readiness(
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
) -> DashboardProviderReadiness {
  match dashboard_instance_provider_executable(instance: instance) {
    Absent =>
      ProviderReadinessRefused {
        stage: "provider-executable-placement" as std.types.NonEmptyStr,
        reason: dashboard_instance_provider_executable_refusal_detail(instance: instance),
      }
    Present { value: codex_program } => {
  let state_root = dashboard_instance_provider_state_root(instance: instance)
  match dashboard_target_path_observe(
    instance: instance,
    flag: "-d",
    path: state_root,
  ) {
    PathObservationRefused { reason } =>
      ProviderReadinessRefused {
        stage: "provider-state-root" as std.types.NonEmptyStr,
        reason: reason,
      }
    PathObservedAbsent =>
      ProviderStateRootAbsent {
        state_root: state_root,
        remediation: dashboard_provider_device_login_command(
          instance: instance,
          codex_program: codex_program,
        ),
      }
    PathObservedPresent => {
      let runtime = dashboard_target_probe(
        instance: instance,
        program: dashboard_environment_binding_executable,
        args: shape_codex_version_env_args_for_program(
          program: codex_program as String,
          codex_home: state_root as String,
        ),
      )
      if dashboard_probe_refused(r: runtime) {
        ProviderReadinessRefused {
          stage: "provider-runtime" as std.types.NonEmptyStr,
          reason: trim(runtime.stderr),
        }
      } else if !runtime.success {
        ProviderRuntimeUnavailable {
          executable: codex_program,
          detail: trim(runtime.stderr),
        }
      } else {
        let auth = dashboard_target_probe(
          instance: instance,
          program: dashboard_environment_binding_executable,
          args: shape_codex_login_status_env_args_for_program(
            program: codex_program as String,
            codex_home: state_root as String,
          ),
        )
        if dashboard_probe_refused(r: auth) {
          ProviderReadinessRefused {
            stage: "provider-auth" as std.types.NonEmptyStr,
            reason: trim(auth.stderr),
          }
        } else if !auth.success {
          ProviderUnauthenticated {
            state_root: state_root,
            detail: trim(auth.stderr),
            remediation: dashboard_provider_device_login_command(
              instance: instance,
              codex_program: codex_program,
            ),
          }
        } else {
          ProviderReady {
            runtime_detail: codex_probe_detail(out: runtime.stdout, err: runtime.stderr),
            auth_detail: codex_probe_detail(out: auth.stdout, err: auth.stderr),
          }
        }
      }
    }
  }
  }
  }
}

fn dashboard_provider_readiness_json(instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance) -> String {
  serialize_json(v: json_object(members: concat(
    [json_kv(key: "schema", value: json_string(s: "roadmap-provider-readiness/v1"))],
    match dashboard_provider_readiness(instance: instance) {
      ProviderReady { runtime_detail, auth_detail } => [
        json_kv(key: "status", value: json_string(s: "ready")),
        json_kv(key: "runtime_detail", value: json_string(s: runtime_detail)),
        json_kv(key: "auth_detail", value: json_string(s: auth_detail)),
      ]
      ProviderStateRootAbsent { state_root, remediation } => [
        json_kv(key: "status", value: json_string(s: "state-root-absent")),
        json_kv(key: "state_root", value: json_string(s: state_root as String)),
        json_kv(key: "remediation", value: json_string(s: remediation)),
      ]
      ProviderReadinessRefused { stage, reason } => [
        json_kv(key: "status", value: json_string(s: "readiness-refused")),
        json_kv(key: "stage", value: json_string(s: stage as String)),
        json_kv(key: "reason", value: json_string(s: reason)),
      ]
      ProviderRuntimeUnavailable { executable, detail } => [
        json_kv(key: "status", value: json_string(s: "runtime-unavailable")),
        json_kv(key: "executable", value: json_string(s: executable as String)),
        json_kv(key: "detail", value: json_string(s: detail)),
      ]
      ProviderUnauthenticated { state_root, detail, remediation } => [
        json_kv(key: "status", value: json_string(s: "unauthenticated")),
        json_kv(key: "state_root", value: json_string(s: state_root as String)),
        json_kv(key: "detail", value: json_string(s: detail)),
        json_kv(key: "remediation", value: json_string(s: remediation)),
      ]
    }
  )))
}
