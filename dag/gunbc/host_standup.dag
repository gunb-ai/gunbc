module gunbc.host_standup


type HostStandupPrefixPhase
  = BmcCredentialConverge
  | OsInstallMechanismResolved
  | OsInstallActuated
  | HostConvergePolicyDerived

type HostStandupAssimilationPhase
  = HostIdentityConverge
  | ReachSecretsNetwork
  | RunnerDeploySlot
  | BuildCacheProvision
  | CodexRuntimeProvision
  | ComputeFabricEnroll
  | GreenPlaceReadiness
  | SessionPlacementEnrollment
  | StandupAssimilationComplete

type HostStandupPhase
  = Prefix { phase: HostStandupPrefixPhase }
  | Assimilation { phase: HostStandupAssimilationPhase }

type PhaseDisposition
  = ModeledCompose { authorities: List<std.decl_ref.DeclarationRef> }
  | DeclaredGap {
      interim_realization: String
      refusal: String
    }

type HostStandupStep {
  phase: HostStandupPhase
  label: std.types.NonEmptyStr
  disposition: PhaseDisposition
  effect_evidence: std.effects.IdempotencyEvidence
}

type GapLedgerRow {
  phase_label: String
  modeling: String
  authority_or_interim: String
}

type AssimilationCompleteInput
  = NodeRegistered
  | ResourcesPresent
  | GreenPlacePinCoherent
  | RunnerSlotHealthy

type AssimilationInputWitness
  = InputSatisfied
  | InputRefused { input: AssimilationCompleteInput, reason: String }
  | InputGap { input: AssimilationCompleteInput, interim_realization: String }

type AssimilationObligation {
  input: AssimilationCompleteInput
  witness: AssimilationInputWitness
}

type GreenPlacePinCoherentWitness
  = GreenPlaceFromGunbcGate {
      noop_satisfied_authority: std.decl_ref.DeclarationRef
      marker_satisfied_authority: std.decl_ref.DeclarationRef
      desired_pin_authority: std.decl_ref.DeclarationRef
      gate_verdict: Bool
    }
  | GreenPlacePinRefused { reason: String }
  | GreenPlacePinGap { interim_realization: String }

type AssimilationCompleteGate {
  obligations: List<AssimilationObligation>
}

type AssimilationCompleteVerdict
  = AssimilationComplete
  | AssimilationIncomplete { input: AssimilationCompleteInput, reason: String }

data host_standup_p3_gunbc_pinned_tree_landing_gate: String = "gunbc.host_converge.GunbcPinnedTree (#5948 merged)"

data host_standup_p3_gunbc_pinned_tree_landed: Bool = true

data host_standup_p3_green_place_scaffold: std.disposition.Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: std.decl_ref.DeclarationRef {
    module_path: "gunbc.host_converge",
    decl_name: "GunbcPinnedTree",
    field: WholeDeclaration
  }
}

data host_standup_p5_green_place_noop_gate_authority: std.decl_ref.DeclarationRef = std.decl_ref.DeclarationRef {
  module_path: "gunbc.host_converge",
  decl_name: "gunbc_pinned_noop_satisfied",
  field: WholeDeclaration,
}

data host_standup_p5_green_place_marker_gate_authority: std.decl_ref.DeclarationRef = std.decl_ref.DeclarationRef {
  module_path: "gunbc.host_converge",
  decl_name: "gunbc_green_place_marker_satisfied",
  field: WholeDeclaration,
}

data host_standup_p5_desired_pin_authority: std.decl_ref.DeclarationRef = std.decl_ref.DeclarationRef {
  module_path: "gunbc.host_converge",
  decl_name: "gunbc_ctrl_read_pin_script",
  field: WholeDeclaration,
}

data host_standup_p5_green_place_pin_scaffold: std.disposition.Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: host_standup_p5_green_place_noop_gate_authority
}

data host_standup_p5_composite_gate_scaffold: std.disposition.Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: std.decl_ref.DeclarationRef {
    module_path: "gunbc.host_standup",
    decl_name: "AssimilationCompleteGate",
    field: WholeDeclaration
  }
}

fn host_standup_prefix_step(
  phase: HostStandupPrefixPhase,
  label: std.types.NonEmptyStr,
  authorities: List<std.decl_ref.DeclarationRef>,
  effect_evidence: std.effects.IdempotencyEvidence
) -> HostStandupStep {
  HostStandupStep {
    phase: Prefix { phase: phase },
    label: label,
    disposition: ModeledCompose { authorities: authorities },
    effect_evidence: effect_evidence,
  }
}

fn host_standup_assimilation_step(
  phase: HostStandupAssimilationPhase,
  label: std.types.NonEmptyStr,
  disposition: PhaseDisposition,
  effect_evidence: std.effects.IdempotencyEvidence
) -> HostStandupStep {
  HostStandupStep {
    phase: Assimilation { phase: phase },
    label: label,
    disposition: disposition,
    effect_evidence: effect_evidence,
  }
}

fn host_standup_prefix_gap_step(
  phase: HostStandupPrefixPhase,
  label: std.types.NonEmptyStr,
  interim_realization: String,
  refusal: String,
  effect_evidence: std.effects.IdempotencyEvidence
) -> HostStandupStep {
  HostStandupStep {
    phase: Prefix { phase: phase },
    label: label,
    disposition: DeclaredGap {
      interim_realization: interim_realization,
      refusal: refusal,
    },
    effect_evidence: effect_evidence,
  }
}

