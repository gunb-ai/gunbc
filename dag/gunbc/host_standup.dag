data srv3_host_standup_target: product.placement_supply.HostIdentity = operator_host_srv3

fn host_standup_spine_length() -> Int {
  host_standup_spine.length()
}

fn host_standup_step_is_gap(step: HostStandupStep) -> Bool {
  match step.disposition {
    DeclaredGap { interim_realization: _, refusal: _ } => true
    ModeledCompose { authorities: _ } => false
  }
}

fn host_standup_step_is_effective_gap(step: HostStandupStep) -> Bool {
  host_standup_step_is_effective_gap_at_actuation_verdict(
    step: step,
    verdict: srv3_pre_install_actuation_verdict(elapsed: millisecond(count: 0)),
  )
}

fn host_standup_step_is_effective_gap_at_actuation_verdict(
  step: HostStandupStep,
  verdict: std.upsert_decision.ObservationVerdict,
) -> Bool {
  match step.phase {
    Prefix { phase: OsInstallActuated } =>
      !deduce_os_install_actuated_satisfied(verdict: verdict)
        && host_standup_step_is_gap(step: step)
    Prefix { phase: _ } => host_standup_step_is_gap(step: step)
    Assimilation { phase: GreenPlaceReadiness } =>
      !host_standup_p3_gunbc_pinned_tree_landed || host_standup_step_is_gap(step: step)
    Assimilation { phase: _ } => host_standup_step_is_gap(step: step)
  }
}

fn host_standup_gap_phase_count() -> Int {
  filter(host_standup_spine, s => host_standup_step_is_gap(step: s)).length()
}

fn host_standup_gap_count_at_actuation_verdict(verdict: std.upsert_decision.ObservationVerdict) -> Int {
  fold(
    host_standup_spine,
    init: 0,
    f: (acc, s) =>
      if host_standup_step_is_effective_gap_at_actuation_verdict(step: s, verdict: verdict) {
        acc + 1
      } else {
        acc
      }
  )
}

fn host_standup_p3_green_place_input_witness() -> GreenPlacePinCoherentWitness {
  if host_standup_p3_gunbc_pinned_tree_landed {
    host_standup_p5_default_green_place_gate_verdict()
  } else {
    GreenPlacePinGap {
      interim_realization: host_standup_p3_gunbc_pinned_tree_landing_gate
    }
  }
}

fn host_standup_p5_default_green_place_gate_verdict() -> GreenPlacePinCoherentWitness {
  GreenPlaceFromGunbcGate {
    noop_satisfied_authority: host_standup_p5_green_place_noop_gate_authority,
    marker_satisfied_authority: host_standup_p5_green_place_marker_gate_authority,
    desired_pin_authority: host_standup_p5_desired_pin_authority,
    gate_verdict: false,
  }
}

fn green_place_pin_coherent_satisfied(w: GreenPlacePinCoherentWitness) -> Bool {
  match w {
    GreenPlaceFromGunbcGate { gate_verdict: v, noop_satisfied_authority: _, marker_satisfied_authority: _, desired_pin_authority: _ } => v
    GreenPlacePinRefused { reason: _ } => false
    GreenPlacePinGap { interim_realization: _ } => false
  }
}

fn assimilation_input_witness_from_green_place(w: GreenPlacePinCoherentWitness) -> AssimilationInputWitness {
  match w {
    GreenPlaceFromGunbcGate { gate_verdict: true, noop_satisfied_authority: _, marker_satisfied_authority: _, desired_pin_authority: _ } =>
      InputSatisfied
    GreenPlaceFromGunbcGate { gate_verdict: false, noop_satisfied_authority: _, marker_satisfied_authority: _, desired_pin_authority: _ } =>
      InputRefused {
        input: GreenPlacePinCoherent,
        reason: "host_standup:P5:green_place_pin_coherent: gunbc gate verdict false or unread — fail-closed, no pin re-derivation in spine"
      }
    GreenPlacePinRefused { reason: r } =>
      InputRefused { input: GreenPlacePinCoherent, reason: r }
    GreenPlacePinGap { interim_realization: path } =>
      InputGap { input: GreenPlacePinCoherent, interim_realization: path }
  }
}

fn assimilation_complete_input_eq(a: AssimilationCompleteInput, b: AssimilationCompleteInput) -> Bool {
  match a {
    NodeRegistered => match b { NodeRegistered => true, _ => false }
    ResourcesPresent => match b { ResourcesPresent => true, _ => false }
    GreenPlacePinCoherent => match b { GreenPlacePinCoherent => true, _ => false }
    RunnerSlotHealthy => match b { RunnerSlotHealthy => true, _ => false }
  }
}

fn assimilation_obligation_for_input(
  gate: AssimilationCompleteGate,
  wanted: AssimilationCompleteInput,
) -> AssimilationObligation? {
  filter(
    gate.obligations,
    o => assimilation_complete_input_eq(a: o.input, b: wanted)
  ) |> first
}

fn assimilation_input_is_required(
  required: List<AssimilationCompleteInput>,
  wanted: AssimilationCompleteInput,
) -> Bool {
  fold_list(
    xs: required,
    empty: false,
    cons: fn(acc, r) {
      if acc {
        true
      } else {
        assimilation_complete_input_eq(a: r, b: wanted)
      }
    }
  )
}

fn assimilation_gate_unrequired_obligation_refusal(
  gate: AssimilationCompleteGate,
  required: List<AssimilationCompleteInput>,
) -> AssimilationCompleteVerdict? {
  match filter(
    gate.obligations,
    o => !assimilation_input_is_required(required: required, wanted: o.input)
  ) |> first {
    Present { value: o } =>
      Present {
        value: AssimilationIncomplete {
          input: o.input,
          reason: "host_standup:P5:unrequired-obligation-present"
        }
      }
    Absent => Absent
  }
}

fn assimilation_gate_missing_required_refusal(
  gate: AssimilationCompleteGate,
  required: List<AssimilationCompleteInput>,
) -> AssimilationCompleteVerdict? {
  match filter(
    required,
    wanted_input =>
      match assimilation_obligation_for_input(gate: gate, wanted: wanted_input) {
        Present { value: _ } => false
        Absent => true
      }
  ) |> first {
    Present { value: wanted_input } =>
      Present {
        value: AssimilationIncomplete {
          input: wanted_input,
          reason: "host_standup:P5:required-obligation-missing"
        }
      }
    Absent => Absent
  }
}

fn assimilation_gate_roster_refusal(
  gate: AssimilationCompleteGate,
  required: List<AssimilationCompleteInput>,
) -> AssimilationCompleteVerdict? {
  match assimilation_gate_unrequired_obligation_refusal(gate: gate, required: required) {
    Present { value: v } => Present { value: v }
    Absent => assimilation_gate_missing_required_refusal(gate: gate, required: required)
  }
}

fn host_standup_gap_count() -> Int {
  host_standup_gap_count_at_actuation_verdict(
    verdict: srv3_pre_install_actuation_verdict(elapsed: millisecond(count: 0)),
  )
}

fn assimilation_input_satisfied(w: AssimilationInputWitness) -> Bool {
  match w {
    InputSatisfied => true
    InputRefused { input: _, reason: _ } => false
    InputGap { input: _, interim_realization: _ } => false
  }
}

fn assimilation_input_failure(w: AssimilationInputWitness) -> AssimilationCompleteVerdict? {
  match w {
    InputSatisfied => Absent
    InputRefused { input: i, reason: r } =>
      Present { value: AssimilationIncomplete { input: i, reason: r } }
    InputGap { input: i, interim_realization: path } =>
      Present {
        value: AssimilationIncomplete {
          input: i,
          reason: concat("host_standup:P5:gap-refused:", path)
        }
      }
  }
}

fn assimilation_obligation_failure(o: AssimilationObligation) -> AssimilationCompleteVerdict? {
  assimilation_input_failure(w: o.witness)
}

fn assimilation_complete_first_failure(
  gate: AssimilationCompleteGate,
  required: List<AssimilationCompleteInput>,
) -> AssimilationCompleteVerdict? {
  fold_list(
    xs: required,
    empty: Absent,
    cons: fn(acc, wanted_input) {
      match acc {
        Present { value: _ } => acc
        Absent =>
          match assimilation_obligation_for_input(gate: gate, wanted: wanted_input) {
            Present { value: o } => assimilation_obligation_failure(o: o)
            Absent =>
              Present {
                value: AssimilationIncomplete {
                  input: wanted_input,
                  reason: "host_standup:P5:required-obligation-missing"
                }
              }
          }
      }
    }
  )
}

fn assimilation_complete(
  gate: AssimilationCompleteGate,
  required: List<AssimilationCompleteInput>,
) -> AssimilationCompleteVerdict {
  match assimilation_gate_roster_refusal(gate: gate, required: required) {
    Present { value: v } => v
    Absent =>
      match assimilation_complete_first_failure(gate: gate, required: required) {
        Present { value: v } => v
        Absent => AssimilationComplete
      }
  }
}

fn assimilation_complete_all_satisfied(
  gate: AssimilationCompleteGate,
  required: List<AssimilationCompleteInput>,
) -> Bool {
  match assimilation_gate_roster_refusal(gate: gate, required: required) {
    Present { value: _ } => false
    Absent =>
      fold_list(
        xs: required,
        empty: true,
        cons: fn(acc, wanted_input) {
          if !acc {
            false
          } else {
            match assimilation_obligation_for_input(gate: gate, wanted: wanted_input) {
              Present { value: o } => assimilation_input_satisfied(w: o.witness)
              Absent => false
            }
          }
        }
      )
  }
}

// NO SILENT FALLBACK — the same claim as before, now carried by the refusal.
// This read "is nbd-proxy, no fallback" while srv3 ran 2.07.00; the load-bearing
// half was always the second one, that a solver finding no virtual media must not
// quietly answer PXE. srv3 on 3.22.00 has no catalogued delivery mechanism, so
// the fallback arm is exactly where a defective solver would land — and refusing
// is the proof it does not. A Selected of any kind here means the fallback fired.
fn srv3_install_mechanism_refuses_rather_than_falling_back() -> Bool {
  match srv3_install_mechanism_solution {
    OsInstallMechanismRefused { cause: _ } => true
    OsInstallMechanismSelected { mechanism: _ } => false
  }
}

fn credential_probe_maps_factory_default(probe: gunbc.bmc_onboarding.BmcCredentialProbeResult) -> Bool {
  match bmc_credential_probe_to_phase(probe: probe) {
    Present { value: FactoryDefault } => true
    Present { value: _ } => false
    Absent => false
  }
}

fn credential_probe_maps_credentials_rotated(probe: gunbc.bmc_onboarding.BmcCredentialProbeResult) -> Bool {
  match bmc_credential_probe_to_phase(probe: probe) {
    Present { value: CredentialsRotated } => true
    Present { value: _ } => false
    Absent => false
  }
}

fn host_standup_fleet_converge_policy() -> gunbc.host_converge.ConvergePolicy {
  fleet_converge_policy()
}
