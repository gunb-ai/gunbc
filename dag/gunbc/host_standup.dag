module gunbc.host_standup


type HostStandupPrefixPhase
  = BmcCredentialConverge
  | BmcFirmwareConverge
  | BmcSurfaceRediscover
  | BmcFanPolicyConverge
  | BmcThermalSafetyVerify
  | OsInstallMechanismResolved
  | OsInstallActuated
  | HostConvergePolicyDerived

type HostStandupAssimilationPhase
  = HostIdentityConverge
  | ReachSecretsNetwork
  | RunnerDeploySlot
  | BuildCacheProvision
  | ComputeFabricEnroll
  | GreenPlaceReadiness
  | SessionPlacementEnrollment
  | StandupAssimilationComplete

type HostStandupPhase
  = Prefix { phase: HostStandupPrefixPhase }
  | Assimilation { phase: HostStandupAssimilationPhase }

type PhaseGap {
  gap_id: NonEmptyStr
  missing: NonEmptyStr
  refusal: NonEmptyStr
}

type PhaseDisposition {
  authorities: List<DeclarationRef>
  gaps: List<PhaseGap>
}

type HostStandupStep {
  phase: HostStandupPhase
  label: NonEmptyStr
  disposition: PhaseDisposition
  effect_evidence: IdempotencyEvidence
}

type HostStandupGapRow {
  phase: HostStandupPhase
  phase_label: String
  gap: PhaseGap
}

type AssimilationCompleteInput
  = NodeRegistered
  | ResourcesPresent
  | GreenPlacePinCoherent
  | RunnerSlotHealthy

type AssimilationInputWitness
  = InputSatisfied
  | InputRefused { input: AssimilationCompleteInput, reason: String }
  | InputGap { input: AssimilationCompleteInput, interim_realization: String }

type GreenPlacePinCoherentWitness
  = GreenPlaceFromGunbcGate {
      noop_satisfied_authority: DeclarationRef
      marker_satisfied_authority: DeclarationRef
      desired_pin_authority: DeclarationRef
      gate_verdict: Bool
    }
  | GreenPlacePinRefused { reason: String }
  | GreenPlacePinGap { interim_realization: String }

type AssimilationCompleteGate {
  node_registered: AssimilationInputWitness
  resources_present: AssimilationInputWitness
  green_place_pin_coherent: GreenPlacePinCoherentWitness
  runner_healthy: AssimilationInputWitness
}

type AssimilationCompleteVerdict
  = AssimilationComplete
  | AssimilationIncomplete { input: AssimilationCompleteInput, reason: String }

data host_standup_p3_gunbc_pinned_tree_landing_gate: String = "gunbc.host_converge.GunbcPinnedTree (#5948 merged)"

data host_standup_p3_gunbc_pinned_tree_landed: Bool = true

data host_standup_p3_green_place_scaffold: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.host_converge",
    decl_name: "GunbcPinnedTree",
    field: WholeDeclaration
  }
}

data host_standup_p5_green_place_noop_gate_authority: DeclarationRef = DeclarationRef {
  module_path: "gunbc.host_converge",
  decl_name: "gunbc_pinned_noop_satisfied",
  field: WholeDeclaration,
}

data host_standup_p5_green_place_marker_gate_authority: DeclarationRef = DeclarationRef {
  module_path: "gunbc.host_converge",
  decl_name: "gunbc_green_place_marker_satisfied",
  field: WholeDeclaration,
}

data host_standup_p5_desired_pin_authority: DeclarationRef = DeclarationRef {
  module_path: "gunbc.host_converge",
  decl_name: "gunbc_ctrl_read_pin_script",
  field: WholeDeclaration,
}

data host_standup_p5_green_place_pin_scaffold: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: host_standup_p5_green_place_noop_gate_authority
}

data host_standup_p5_composite_gate_scaffold: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.host_standup",
    decl_name: "AssimilationCompleteGate",
    field: WholeDeclaration
  }
}

fn host_standup_prefix_step(
  phase: HostStandupPrefixPhase,
  label: NonEmptyStr,
  authorities: List<DeclarationRef>,
  effect_evidence: IdempotencyEvidence
) -> HostStandupStep {
  HostStandupStep {
    phase: Prefix { phase: phase },
    label: label,
    disposition: PhaseDisposition {
      authorities: authorities,
      gaps: [],
    },
    effect_evidence: effect_evidence,
  }
}

fn host_standup_assimilation_step(
  phase: HostStandupAssimilationPhase,
  label: NonEmptyStr,
  disposition: PhaseDisposition,
  effect_evidence: IdempotencyEvidence
) -> HostStandupStep {
  HostStandupStep {
    phase: Assimilation { phase: phase },
    label: label,
    disposition: disposition,
    effect_evidence: effect_evidence,
  }
}

fn decl_ref(module_path: String, decl_name: String) -> DeclarationRef {
  DeclarationRef {
    module_path: module_path as NonEmptyStr,
    decl_name: decl_name as NonEmptyStr,
    field: WholeDeclaration,
  }
}

fn host_standup_prefix_partial_step(
  phase: HostStandupPrefixPhase,
  label: NonEmptyStr,
  authorities: List<DeclarationRef>,
  gaps: List<PhaseGap>,
  effect_evidence: IdempotencyEvidence
) -> HostStandupStep {
  HostStandupStep {
    phase: Prefix { phase: phase },
    label: label,
    disposition: PhaseDisposition {
      authorities: authorities,
      gaps: gaps,
    },
    effect_evidence: effect_evidence,
  }
}

