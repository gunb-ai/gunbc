module gunbc.site.gunb_ai_layout

import std.types { Bool, Int, List, String }
import std.algebra { string_contains }
import std.markup { Fragment, Element, Attribute, attr }
import extdeps.languages.html { try_serialize_html_source, EmitOk, EmitRejected }
import extdeps.languages.css.values { CssLength, Px, css_length_wire }
import extdeps.languages.css.properties {
  Background, Border, BorderBottom, Color, Display, FontFamily, FontSize, Gap,
  GridTemplateColumns, LineHeight, MarginBottom, MarginLeft, MarginRight, MarginTop,
  MaxWidth, Padding, RawProperty, CustomProperty,
}
import extdeps.languages.css.selectors { SelectorSubject, ElementSelector, ClassSelector, PseudoSuffix }
import extdeps.languages.css.media_queries { MediaCondition, MediaMaxWidth }
import gunbc.design.material { CssDecl, BuildRule, StaticRule, MediaRule, decl, serialize_rules }
import gunbc.design.scale {
  ScaleToken, scale_var, scale_border, scale_decl, border_1, named_length_token,
}
import gunbc.site.markup { el, el_class, txt }
import gunbc.site.gunb_ai_tokens {
  TokenSwatch, token_canvas, token_canvas_raised, token_canvas_raised2, token_border,
  token_border_strong, token_text, token_text_body, token_text_dim, token_text_faint,
  token_accent, token_accent_deep, token_callout, token_callout_deep,
  token_highlight, token_highlight_deep,
  gunb_measure_page, measure_prose,
  gap_sm, gap_md, gap_lg, gap_xl, scale_body, scale_heading, scale_label, font_body,
  role_var, token_swatches, token_root_decls,
}
import gunbc.design.palette { Swatch, swatch_paint }
import gunbc.design.gunb_ai_hues {
  warm_white, off_white, near_black, umber, taupe, moss_deep, clay_deep, brass_deep,
}

// The LAYOUT layer of the gunb.ai projection (carrier: gunbc.plans.gunb_ai_projection).
// Composes on the tokens layer and nothing else: every colour is a role_var(t: …)
// reference into gunbc.site.gunb_ai_tokens' bindings and every magnitude a
// scale_var(t: …) reference into ScaleToken rows, so this module cannot introduce a
// colour or a size of its own, and the tokens witness's reference-resolution property
// extends to every rule emitted here (same serialize path, same traversal).
//
// THREE INDEPENDENT AXES (operator ballot, relayed by swift-badger-498 2026-10-17):
// grid, breakpoints, light/dark. Each is a typed choice; layout_rules takes all three
// and ANY combination renders — that independence is the contract the content-model and
// page layers consume: they ask for rules, never for a preset.
//
// Consumers (DESIGN §3c): gunbc.site.gunb_ai_layout_review (writes the ballot to the
// srv1 review site) and test.claim.site_gunb_ai_layout_witness (claim-run over the
// RENDERED combinations).

// ------------------------------------------------------------------ axis 1: the grid

type GridChoice
  = FlowStack
  | FixedColumns { count: Int }
  | AutoFillTracks { min: ScaleToken }

data grid_flow: GridChoice = FlowStack
data grid_fixed_3: GridChoice = FixedColumns { count: 3 }
data grid_autofill: GridChoice = AutoFillTracks { min: card_min }

// The floor an auto-filled card track may not fall below. named_length_token: the
// name is the fact ("a card is unreadable narrower than this"), not a number encoding.
data card_min: ScaleToken = named_length_token(name: "card-min", px: 200)
data column_count_max: Int = 4

// Track lists are CssDecl VALUES, the same shape gunbc.roadmap writes
// ("var(--space-16) minmax(0, 1fr)"): material's contract is a typed property beside a
// string value, and extdeps.languages.css.values models no minmax()/repeat()
// production. SCAFFOLD with a dissolution trigger — each list is written ONCE here and
// read by every rule; when values.dag grows the <track-list> grammar these become
// typed and these functions delete.
fn tracks_fixed(count: Int) -> String {
  join(["repeat(", to_string(count), ", minmax(0, 1fr))"], "")
}

fn tracks_autofill(min: ScaleToken) -> String {
  join(["repeat(auto-fill, minmax(var(--", min.name, "), 1fr))"], "")
}

fn tracks_single() -> String {
  "1fr"
}

fn grid_tracks(choice: GridChoice) -> String {
  match choice {
    FlowStack => tracks_single()
    FixedColumns { count: c } => tracks_fixed(count: c)
    AutoFillTracks { min: m } => tracks_autofill(min: m)
  }
}

// A column count outside 1..column_count_max is a modelling error, not a render: the
// ballot REFUSES (typed, labelled) rather than emitting a grid nobody chose.
fn grid_choice_admissible(choice: GridChoice) -> Bool {
  match choice {
    FlowStack => true
    FixedColumns { count: c } => c >= 1 && c <= column_count_max
    AutoFillTracks { min: m } => token_name_is_wellformed(name: m.name)
  }
}

// ----------------------------------------------------------- axis 2: the breakpoints

// What the live page does at each width — instrument, and read it rather than trusting
// this paraphrase:
//   curl -s https://gunb.ai/assets/site.css | grep -n "@media" -A 8
//   760 stacks .hero-spine and caps .hero-left h1 at 18ch; 700 stacks .specimen-body and
//   turns .story-ledger into a scroller; 540 stacks .card-receipt-row; 480 tightens
//   .masthead margins and .carved-rule.
// Only the card grid is modelled here, because the card grid is what this layer owns.
// 760 and 540 are NOT modelled: they restack .hero-spine and .card-receipt-row, elements
// this layer does not model — they belong to the primitives and pages layers, and go on
// that layer's parity list rather than being silently dropped. They are not redundant with
// the 700 rule; the instrument above shows each width targets different selectors.
//
// The 480 point also does NOT repeat the 700 rule. An earlier draft emitted the
// single-column rule at both widths; every viewport under 480 is under 700 too, so the
// second rule could never fire anything the first had not — duplicated work (§2), and on a
// ballot a fabricated choice, since the two options rendered identically while the caption
// claimed the tighter one did something (§5, "no plausible output is fabricated"). A
// response point therefore carries WHAT it changes, not only where. The tightening below is
// this layer's proposal for its own element (.cards), put to the operator on the ballot; the
// live site's 480 rules touch .masthead and .carved-rule, which arrive with the primitives
// layer.

type ResponsePoint {
  condition: MediaCondition
  subject: SelectorSubject
  decls: List<CssDecl>
}

// Below 700: the card tracks collapse to one column — the response the live site hand-
// wrote for that width.
data stack_point: ResponsePoint = ResponsePoint {
  condition: MediaMaxWidth { max: CssLength { n: 700, unit: Px } },
  subject: ClassSelector { name: "cards" },
  decls: [decl(prop: GridTemplateColumns, value: tracks_single())]
}

// Below 480: the measure narrows the room it needs — the card gutter and the card's own
// padding drop one step on the gap scale. Same fact shape as the live site's compact
// tier (spacing, not tracks), read from the same gap scale the rest of the layer uses.
data compact_point: ResponsePoint = ResponsePoint {
  condition: MediaMaxWidth { max: CssLength { n: 480, unit: Px } },
  subject: ClassSelector { name: "cards" },
  decls: [
    decl(prop: Gap, value: scale_var(t: gap_sm)),
    decl(prop: Padding, value: scale_var(t: gap_sm)),
  ]
}

type BreakpointChoice
  = AdoptLiveBreakpoints
  | StackOnly

data breakpoints_adopt_live: BreakpointChoice = AdoptLiveBreakpoints
data breakpoints_stack_only: BreakpointChoice = StackOnly

// The points each option asks for. A point is typed end to end: its condition is the
// MediaCondition the rule consumes, so "a breakpoint that is not a length" is not a value
// this language can express (§5, correctness by construction) — there is no runtime
// admissibility check over ScaleValue arms and no sentinel condition standing in for a
// case the type already excludes. Lengths and property names are named once, here, and
// both the page and the witness derive their text from these rows through the upstream
// wires. Consumer: layout_rules, and test.claim.site_gunb_ai_layout_witness
// (witness_breakpoints_come_from_the_axis, witness_ballot_options_are_distinguishable).
fn breakpoint_points(choice: BreakpointChoice) -> List<ResponsePoint> {
  match choice {
    AdoptLiveBreakpoints => [stack_point, compact_point]
    StackOnly => [stack_point]
  }
}

// ---------------------------------------------------------- axis 3: light and dark

type SchemeChoice
  = DarkOnly
  | LightAlternative

data scheme_dark_only: SchemeChoice = DarkOnly
data scheme_light_alt: SchemeChoice = LightAlternative

// The light alternative, bound role-for-role against the night bindings. Every day
// value is a swatch that ALREADY EXISTS in gunbc.design.gunb_ai_hues, read through
// swatch_paint — no new colours (operator pick A: palette is the only colour
// authority). The accent family takes its *_deep rows because the mids are tuned for a
// night canvas; where a day text pairing is still under AA, that is visible on the
// ballot page itself for the operator to judge, not hidden by a default.
type DayBinding {
  night: TokenSwatch
  day: Swatch
}

data day_bindings_rows: List<DayBinding> = [
  DayBinding { night: token_canvas, day: warm_white },
  DayBinding { night: token_canvas_raised, day: off_white },
  DayBinding { night: token_canvas_raised2, day: off_white },
  DayBinding { night: token_border, day: umber },
  DayBinding { night: token_border_strong, day: taupe },
  DayBinding { night: token_text, day: near_black },
  DayBinding { night: token_text_body, day: near_black },
  DayBinding { night: token_text_dim, day: umber },
  DayBinding { night: token_text_faint, day: taupe },
  DayBinding { night: token_accent, day: moss_deep },
  DayBinding { night: token_accent_deep, day: moss_deep },
  DayBinding { night: token_callout, day: clay_deep },
  DayBinding { night: token_callout_deep, day: clay_deep },
  DayBinding { night: token_highlight, day: brass_deep },
  DayBinding { night: token_highlight_deep, day: brass_deep },
]

// The light variant must bind EXACTLY the roles the night bindings bind — an identity
// join over rows, not a count: a role added to the tokens layer without a day value
// reddens day_bindings_complete instead of rendering light-on-light.
fn day_bindings_complete() -> Bool {
  all(token_swatches, t => day_row_exists(role: t.role))
    && all(day_bindings_rows, b => day_row_matches_night(role: b.night.role))
}

fn day_row_exists(role: String) -> Bool {
  fold(day_bindings_rows, init: false, f: (acc, b) => acc || b.night.role == role)
}

fn day_row_matches_night(role: String) -> Bool {
  fold(token_swatches, init: false, f: (acc, t) => acc || t.role == role)
}

// The scope class for the light variant. THE SCHEME GAP, stated not hidden:
// extdeps.languages.css.media_queries' MediaCondition has NO prefers-color-scheme arm
// (its bounded grain is pointer / max-width / prefers-reduced-motion, each cited to its
// spec anchor), so this layer cannot emit an OS-following light block. The only code
// that emits prefers-color-scheme today is gunbc.design.theme.theme_scoped_blocks, as
// raw joined text beside the bounded grammar. The light option is therefore scoped to
// a typed CLASS selector (modelled, checkable), and the OS-following wiring is a named
// gap with a dissolution trigger: when MediaCondition grows a prefers-color-scheme arm
// (Media Queries Level 5 already defines it), the class scope is replaced by MediaRule
// and this comment, the ballot wording, and the witness's scope clause change together.
data day_scope_class: String = "gunb-day"

// Custom properties REBIND BY NAME inside a scope: the day block must define the SAME
// names the rules read (role_var(t: …) emits var(--gunb-text) etc.), so descendants of
// body.gunb-day inherit the light values. An earlier draft defined --gunb-text-DAY
// names here — nothing read them, so the page stayed dark: a silent no-op the witness
// below now refuses.
fn day_bindings() -> List<CssDecl> {
  map(day_bindings_rows, b =>
    decl(prop: CustomProperty { name: b.night.role }, value: swatch_paint(sw: b.day)))
}

// ---------------------------------------------------------- the composed rule set

fn layout_rules(grid: GridChoice, breakpoints: BreakpointChoice, scheme: SchemeChoice) -> List<BuildRule> {
  concat(
    concat(
      shell_rules(grid: grid),
      map(breakpoint_points(choice: breakpoints), pt => response_rule(point: pt))
    ),
    scheme_rules(scheme: scheme)
  )
}

fn shell_rules(grid: GridChoice) -> List<BuildRule> {
  [
    StaticRule { selector: ElementSelector { tag: "body" }, decls: [
      decl(prop: Background, value: role_var(t: token_canvas)),
      decl(prop: Color, value: role_var(t: token_text_body)),
      decl(prop: FontFamily, value: scale_var(t: font_body)),
      decl(prop: FontSize, value: scale_var(t: scale_body)),
      // "1.55" is a CssDecl VALUE in material's own contract — the same shape
      // gunbc.design.typography writes ("1.55", "normal"). The typed route is the
      // rule around it; a prose line-height is not yet a ScaleValue arm.
      decl(prop: LineHeight, value: "1.55"),
    ] },
    StaticRule { selector: ElementSelector { tag: "header" }, decls: concat(concat([
      decl(prop: MaxWidth, value: scale_var(t: gunb_measure_page)),
      decl(prop: Padding, value: scale_var(t: gap_lg)),
      decl(prop: BorderBottom, value: scale_border(w: border_1, color_var: role_var(t: token_border))),
    ], center_margin()), margin_top_bottom(top: zero_wire(), bottom: zero_wire())) },
    StaticRule { selector: ElementSelector { tag: "main" }, decls: concat(concat([
      decl(prop: MaxWidth, value: scale_var(t: gunb_measure_page)),
      decl(prop: Padding, value: scale_var(t: gap_lg)),
    ], center_margin()), margin_top_bottom(top: zero_wire(), bottom: zero_wire())) },
    StaticRule { selector: ElementSelector { tag: "footer" }, decls: concat(concat(concat([
      decl(prop: Color, value: role_var(t: token_text_faint)),
      decl(prop: Padding, value: scale_var(t: gap_lg)),
      // border-top is not in extdeps.languages.css.properties' enum (it carries
      // Border/BorderBottom/BorderLeft only). RawProperty is the repo's own escape
      // hatch (roadmap_surface_style writes overflow-x the same way), so the property
      // NAME stays a value-shaped string here rather than the rule becoming a string.
      decl(prop: RawProperty { name: "border-top" }, value: scale_border(w: border_1, color_var: role_var(t: token_border))),
    ], center_margin()), margin_top_bottom(top: scale_var(t: gap_xl), bottom: zero_wire()))) },
    StaticRule { selector: ElementSelector { tag: "a" }, decls: [
      decl(prop: Color, value: role_var(t: token_accent)),
    ] },
    StaticRule { selector: ClassSelector { name: "h1" }, decls: [
      decl(prop: FontSize, value: scale_var(t: scale_heading)),
      decl(prop: Color, value: role_var(t: token_text)),
    ] },
    StaticRule { selector: ClassSelector { name: "lede" }, decls: [
      decl(prop: MaxWidth, value: scale_var(t: measure_prose)),
      decl(prop: Color, value: role_var(t: token_text_dim)),
    ] },
    StaticRule { selector: ClassSelector { name: "cards" }, decls: [
      decl(prop: Display, value: "grid"),
      decl(prop: Gap, value: scale_var(t: gap_md)),
      decl(prop: GridTemplateColumns, value: grid_tracks(choice: grid)),
    ] },
    StaticRule { selector: ClassSelector { name: "card" }, decls: concat([
      decl(prop: Background, value: role_var(t: token_canvas_raised)),
      decl(prop: Padding, value: scale_var(t: gap_md)),
      decl(prop: Border, value: scale_border(w: border_1, color_var: role_var(t: token_border))),
    ], margin_top_bottom(top: zero_wire(), bottom: scale_var(t: gap_md))) },
    StaticRule { selector: ClassSelector { name: "card-title" }, decls: [
      decl(prop: Color, value: role_var(t: token_text)),
      decl(prop: MarginBottom, value: scale_var(t: gap_sm)),
    ] },
    StaticRule { selector: ClassSelector { name: "card-body" }, decls: [
      decl(prop: Color, value: role_var(t: token_text_dim)),
    ] },
    StaticRule { selector: ClassSelector { name: "tag" }, decls: [
      decl(prop: Color, value: role_var(t: token_highlight)),
      decl(prop: FontSize, value: scale_var(t: scale_label)),
    ] },
  ]
}

// A response point becomes a MediaRule over the modelled MediaCondition, through
// material's typed rule. The point is handed in whole, so this function cannot be given a
// condition without its effect or an effect without its condition.
fn response_rule(point: ResponsePoint) -> BuildRule {
  MediaRule {
    condition: point.condition,
    selector: point.subject,
    decls: point.decls,
  }
}

fn scheme_rules(scheme: SchemeChoice) -> List<BuildRule> {
  match scheme {
    DarkOnly => []
    LightAlternative => [StaticRule {
      selector: ClassSelector { name: day_scope_class },
      decls: day_bindings(),
    }]
  }
}

// ----------------------------------------------------------------- small shared parts

fn center_margin() -> List<CssDecl> {
  [
    decl(prop: MarginLeft, value: auto_wire()),
    decl(prop: MarginRight, value: auto_wire()),
  ]
}

fn margin_top_bottom(top: String, bottom: String) -> List<CssDecl> {
  [
    decl(prop: MarginTop, value: top),
    decl(prop: MarginBottom, value: bottom),
  ]
}

// "0" and "auto" are CSS keyword values — material's value contract is a String
// (design/typography.dag writes "normal" the same way). The zero is DERIVED from
// extdeps' length wire, so its shape is not authored here.
fn zero_wire() -> String {
  css_length_wire(l: CssLength { n: 0, unit: Px })
}

fn auto_wire() -> String {
  "auto"
}

// The scale tokens this layer reads, named in one place so the witness can check every
// var() reference in the rendered rules against upstream rows rather than a copied list
// (§3: one home; a token read here but not listed is a witness gap, and the list is
// derived from the same rows the rules use, so it cannot drift).
fn layout_scale_tokens() -> List<ScaleToken> {
  [gunb_measure_page, measure_prose, gap_sm, gap_md, gap_lg, gap_xl,
   scale_body, scale_heading, scale_label, font_body, border_1, card_min]
}

fn token_name_is_wellformed(name: String) -> Bool {
  !string_contains(s: name, pattern: " ")
    && !string_contains(s: name, pattern: "(")
    && !string_contains(s: name, pattern: ")")
    && !string_contains(s: name, pattern: "{")
    && !string_contains(s: name, pattern: "}")
    && !string_contains(s: name, pattern: ";")
    && !string_contains(s: name, pattern: ":")
}

// ------------------------------------------------------------------- the ballot

type BallotRequest {
  slug: String
  axis: String
  label: String
  note: String
  grid: GridChoice
  breakpoints: BreakpointChoice
  scheme: SchemeChoice
}

type BallotRender
  = BallotHtml { html: String, slug: String }
  | BallotRefused { reason: String }

// The declarations this layer OWNS — the rows it mints that no other layer declares.
// Every other reference in a layout rule points at a row the token layer's :root block
// already declares, so re-declaring the pool here would give one fact two homes and the
// artifact two declarations of the same custom property. Consumer: ballot_css, and
// test.claim.site_gunb_ai_layout_witness.witness_layer_owns_only_its_own_declarations.
fn layout_owned_decls() -> List<CssDecl> {
  map(layout_owned_tokens(), t => scale_decl(t: t))
}

// The rows this layer mints itself, checked for ownership (not membership by copy) by
// witness_layer_owns_only_its_own_declarations.
fn layout_owned_tokens() -> List<ScaleToken> {
  [card_min]
}

// A page composes the token layer's :root declarations with this layer's own
// declarations and rules, through the one upstream serializer. A var() written here
// resolves against a declaration the artifact carries — which is what
// test.claim.site_gunb_ai_layout_witness.ballot_references_resolve checks against the
// rendered page, not against this module's source.
fn ballot_css(req: BallotRequest) -> String {
  serialize_rules(rules: concat(
    [StaticRule {
      selector: PseudoSuffix { base: "", pseudo: "root" },
      decls: concat(token_root_decls(), layout_owned_decls())
    }],
    layout_rules(grid: req.grid, breakpoints: req.breakpoints, scheme: req.scheme)
  ))
}

fn layout_css(grid: GridChoice, breakpoints: BreakpointChoice, scheme: SchemeChoice) -> String {
  serialize_rules(rules: layout_rules(grid: grid, breakpoints: breakpoints, scheme: scheme))
}

fn ballot_render(req: BallotRequest) -> BallotRender {
  if !grid_choice_admissible(choice: req.grid) {
    BallotRefused { reason: join(["[", req.slug, "] grid choice inadmissible: fixed column count outside 1..", to_string(column_count_max)], "") }
  } else if !day_bindings_complete() {
    BallotRefused { reason: join(["[", req.slug, "] light variant incomplete: a bound role has no day row"], "") }
  } else {
    match try_serialize_html_source(node: ballot_page(req: req)) {
      EmitOk { html: h } => BallotHtml { html: concat("<!DOCTYPE html>\n", h), slug: req.slug }
      EmitRejected { reason: r } => BallotRefused { reason: join(["[", req.slug, "] emit refused: ", r], "") }
    }
  }
}

fn ballot_page(req: BallotRequest) -> Fragment {
  Element { tag: "html", attributes: [ attr(name: "lang", value: "en") ], children: [
    el("head", [
      Element { tag: "meta", attributes: [ attr(name: "charset", value: "utf-8") ], children: [] },
      Element { tag: "meta", attributes: [
        attr(name: "name", value: "viewport"),
        attr(name: "content", value: "width=device-width, initial-scale=1"),
      ], children: [] },
      el("title", [ txt(join(["gunb.ai layout — ", req.label], "")) ]),
      el("style", [ txt(ballot_css(req: req)) ]),
    ]),
    Element { tag: "body", attributes: ballot_body_attrs(scheme: req.scheme), children: [
      el("header", [
        el_class("div", "tag", [ txt(join(["axis: ", req.axis], "")) ]),
        el_class("div", "h1", [ txt(req.label) ]),
        el_class("div", "lede", [ txt(req.note) ]),
      ]),
      el("main", [
        el_class("div", "cards", [
          ballot_card(
            title: "Cards",
            body: "The card track is what the grid axis changes. Resize the window: the breakpoint axis decides when it stacks."),
          ballot_card(
            title: "Independent axes",
            body: "Grid, breakpoints and light/dark are three typed choices — any combination renders, so one axis can be picked without pre-committing the others."),
          ballot_card(
            title: "Tokens only",
            body: "Every colour and size here is a reference into the tokens layer; no literal in this module could survive the witness. Links use the accent role, footer text the faint role."),
          ballot_card(
            title: req.slug,
            body: "The slug of this ballot entry, so a screenshot cannot be mistaken for another entry."),
        ]),
      ]),
      el("footer", [ txt("gunbc · gunbc.site.gunb_ai_layout · generated, not hand-maintained") ]),
    ] },
  ] }
}

fn ballot_body_attrs(scheme: SchemeChoice) -> List<Attribute> {
  match scheme {
    DarkOnly => []
    LightAlternative => [ attr(name: "class", value: day_scope_class) ]
  }
}

fn ballot_card(title: String, body: String) -> Fragment {
  el_class("div", "card", [
    el_class("div", "card-title", [ txt(title) ]),
    el_class("div", "card-body", [ txt(body) ]),
  ])
}
