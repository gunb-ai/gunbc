    StaticRule { selector: RawSelector { text: ".site-avatar-mark" }, decls: [
      decl(prop: Display, value: "block"),
      decl(prop: Width, value: scale_var(t: space_16)),
      decl(prop: Height, value: scale_var(t: space_16))
    ] },
    StaticRule { selector: RawSelector { text: ".site-avatar-default" }, decls: [
      decl(prop: Background, value: "var(--border)"),
      decl(prop: Color, value: "var(--text-dim)")
    ] },
    StaticRule { selector: RawSelector { text: ".site-avatar-workflow" }, decls: [
      decl(prop: Background, value: "var(--canvas)"),
      decl(prop: Color, value: "var(--text-dim)")
    ] }
  ]
}
