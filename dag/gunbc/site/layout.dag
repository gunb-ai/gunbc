      decl(prop: Color, value: "var(--text)")
    ] },
    StaticRule { selector: RawSelector { text: ".site-brand-mark" }, decls: [
      decl(prop: Width, value: "var(--h-compact-face)"),
      decl(prop: Height, value: "var(--h-compact-face)")
    ] },
    ResponseRule { subject: RawSelector { text: ".site-brand" }, shape: SelfResponse, trigger: OnHover, transition_props: "background-color, color, outline-color", timing: respond_fast, base_decls: [], response_decls: [
      decl(prop: Background, value: "var(--canvas)")
    ] },
    ResponseRule { subject: RawSelector { text: ".site-brand" }, shape: SelfResponse, trigger: OnFocusVisible, transition_props: "background-color, color, outline-color", timing: respond_fast, base_decls: [], response_decls: [
      decl(prop: Outline, value: "var(--border-2) solid var(--focus)"),
      decl(prop: RawProperty { name: "outline-offset" }, value: "var(--space-2)")
    ] },
    StaticRule { selector: RawSelector { text: ".site-avatar" }, decls: [
      decl(prop: Display, value: "inline-flex"),
      decl(prop: AlignItems, value: "center"),
      decl(prop: JustifyContent, value: "center"),
      decl(prop: Width, value: scale_var(t: space_24)),
      decl(prop: Height, value: scale_var(t: space_24)),
      decl(prop: BorderRadius, value: scale_var(t: radius_999)),
      decl(prop: FontSize, value: scale_var(t: text_11)),
      decl(prop: FontWeight, value: "500"),
      decl(prop: Color, value: "var(--canvas)"),
      decl(prop: Background, value: "var(--text-dim)"),
