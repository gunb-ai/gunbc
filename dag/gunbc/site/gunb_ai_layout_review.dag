module gunbc.site.gunb_ai_layout_review

import std.types { String, List, Int }
import std.process { ProcessExit, ExitSuccess, exit_failure }
import std.compiler_entry { CompilerEntryDriver, NativeCliDriver }
import std.optional { Absent, Present }
import extdeps.filesystem.filesystem_io { Filesystem }
import gunbc.site.gunb_ai_layout {
  BallotRequest, BallotRender, BallotHtml, BallotRefused, ballot_render,
  grid_flow, grid_fixed_3, grid_autofill,
  breakpoints_adopt_live, breakpoints_two_tier,
  scheme_dark_only, scheme_light_alt,
}

// Writes the LAYOUT ballot to an out-dir for the srv1 tailnet review site
// (`python3 -m http.server <port> --bind <tailnet address>`), one file per option so
// the operator can compare them side by side. Fail closed (DESIGN §5): an emit refusal
// or an inadmissible choice exits non-zero and NOTHING is written — there is no path
// where a refused render lands on disk or exits success.
//
// Invocation (either entry renders identical bytes from the same call):
//   gunbc run --source-root dag --entry dag/gunbc/site/gunb_ai_layout_review.dag \
//     --function v2_cli_main <out-dir>          (NativeCliDriver positional argv)
//   gunbc run --source-root dag --entry dag/gunbc/site/gunb_ai_layout_review.dag \
//     --function ballot_write_arg --arg dir=<out-dir>
//
data compiler_pipeline_entry: CompilerEntryDriver = NativeCliDriver

// Consumers (DESIGN §3c): the operator's browser on the review site, the srv1
// headless-chromium screenshot pass that precedes showing the page, and
// test.claim.site_gunb_ai_layout_witness (which re-renders these requests and checks
// the artifact, so this list is not only a writer's wish list).

// The ballot: three AXES, and the entries are the options within each axis held
// against the same default on the other two. Options are independent by construction
// (layout_rules takes the three choices), so any combination renders — the entries
// below are what the operator is asked to choose between, not a product of axes.
data ballot_entries: List<BallotRequest> = [
  BallotRequest {
    slug: "layout-grid-a-flow",
    axis: "grid (A)",
    label: "A — flow stack",
    note: "One column at every width. The reading-first option: no card ever sits beside another, so measure is the only rhythm.",
    grid: grid_flow,
    breakpoints: breakpoints_adopt_live,
    scheme: scheme_dark_only,
  },
  BallotRequest {
    slug: "layout-grid-b-three",
    axis: "grid (B)",
    label: "B — three equal columns",
    note: "A fixed three-up track that collapses below the stack breakpoint. Predictable rhythm on desktop, three cards per row whatever the content.",
    grid: grid_fixed_3,
    breakpoints: breakpoints_adopt_live,
    scheme: scheme_dark_only,
  },
  BallotRequest {
    slug: "layout-grid-c-autofill",
    axis: "grid (C)",
    label: "C — auto-fill from a token floor",
    note: "As many columns as fit, each at least card-min wide. Density follows the viewport instead of a chosen count; the floor is the token, so the choice is about the floor, not the count.",
    grid: grid_autofill,
    breakpoints: breakpoints_adopt_live,
    scheme: scheme_dark_only,
  },
  BallotRequest {
    slug: "layout-bp-a-live",
    axis: "breakpoints (A)",
    label: "A — the live site's two",
    note: "Stacks at 700, tightens at 480 — the widths gunb.ai already breaks at. The 540/760 rules in the hand-written CSS re-stack what 700 already stacks, so they are not modelled; parity is judged on rendered pages.",
    grid: grid_fixed_3,
    breakpoints: breakpoints_adopt_live,
    scheme: scheme_dark_only,
  },
  BallotRequest {
    slug: "layout-bp-b-twotier",
    axis: "breakpoints (B)",
    label: "B — two tiers",
    note: "One stack breakpoint at 700 and nothing below it. Fewer rules, one behaviour per tier; the compact tier is whatever the fluid track does on its own.",
    grid: grid_fixed_3,
    breakpoints: breakpoints_two_tier,
    scheme: scheme_dark_only,
  },
  BallotRequest {
    slug: "layout-scheme-a-dark",
    axis: "light/dark (A)",
    label: "A — dark only (parity)",
    note: "What gunb.ai serves today: no prefers-color-scheme support in the live CSS at all, so this is the no-change option.",
    grid: grid_fixed_3,
    breakpoints: breakpoints_adopt_live,
    scheme: scheme_dark_only,
  },
  BallotRequest {
    slug: "layout-scheme-b-light",
    axis: "light/dark (B)",
    label: "B — light alternative",
    note: "The same 15 roles rebound to light values taken from the SAME hue set (palette is the only colour authority). Scoped to a class for now: extdeps' MediaCondition has no prefers-color-scheme arm, so an OS-following block is a named gap, not a default. Judge the accent/callout pairs on this page.",
    grid: grid_fixed_3,
    breakpoints: breakpoints_adopt_live,
    scheme: scheme_light_alt,
  },
]

type BallotRun
  = BallotWritten { paths: List<String> }
  | BallotRefusedRun { reason: String }

// A run stops at the first entry that is refused or fails to write, keeping that
// entry's cause — the shape gunbc.design.brand_mark_assets_cli's brand_assets_write
// uses for the same job (fold over targets, a stopped arm that absorbs the rest). A
// partial ballot is never published.
fn ballot_write(dir: String) -> BallotRun {
  fold(ballot_entries, init: BallotWritten { paths: [] }, f: (run, entry) => match run {
    BallotRefusedRun { reason: _ } => run
    BallotWritten { paths } => match ballot_render(req: entry) {
      BallotRefused { reason: r } => BallotRefusedRun { reason: r }
      BallotHtml { html: h, slug: slug } => {
        let path = join([dir, "/", slug, ".html"], "")
        let wrote = Filesystem.Write(path: path, content: h)
        if wrote.success { BallotWritten { paths: concat(paths, [path]) } } else { BallotRefusedRun { reason: join([path, ": ", wrote.error], "") } }
      }
    }
  })
}

fn ballot_exit(run: BallotRun) -> ProcessExit {
  match run {
    BallotWritten { paths: p } => ExitSuccess
    BallotRefusedRun { reason: r } => exit_failure(reason: join(["layout ballot refused: ", r], ""))
  }
}

// Named-arg entry, for `gunbc run --function ballot_write_arg --arg dir=<out>`.
fn ballot_write_arg(dir: String) -> ProcessExit {
  ballot_exit(run: ballot_write(dir: dir))
}

// Positional NativeCliDriver entry: renders identical bytes to the named-arg entry.
fn v2_cli_main(argv: List<String>) -> ProcessExit {
  match get(argv, 0) {
    Present { value: dir } => ballot_exit(run: ballot_write(dir: dir))
    Absent => exit_failure(reason: "usage: gunb_ai_layout_review <out-dir>")
  }
}
