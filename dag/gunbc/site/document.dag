module gunbc.site.document
import extdeps.auth.oidc { OidcLoginPromptSelectAccount, oidc_login_prompt_label }
import gunbc.roadmap_auth_route_paths { auth_login_route_path, auth_logout_route_path }
import gunbc.site.brand { site_brand_link, site_favicon_nodes }
import gunbc.site.layout { site_layout_rules }

import std.types { String, List }
import std.markup { Fragment, Element, attr }
import gunbc.site.markup { txt, el, el_attrs, el_class }
import gunbc.site.controls { site_client_path, sound_toggle_class, theme_toggle_class, theme_toggle_label_prefix, theme_toggle_auto_value }
import gunbc.design.material { BuildRule, CssDecl, serialize_rules, reduced_motion_block }
import gunbc.design.scale { scale_root_css }
import gunbc.site.web_fonts { web_font_stylesheet_path }
import gunbc.design.theme { day_theme, night_theme, theme_root_css, theme_scoped_blocks }

type SiteShell = ApplicationShell | ApprovalShell

type SiteThemeDecls { day: List<CssDecl>, night: List<CssDecl> }
type SiteStyles { rules: List<BuildRule>, themes: List<SiteThemeDecls> }
fn site_styles(rules: List<BuildRule>) -> SiteStyles { SiteStyles { rules: rules, themes: [] } }
fn site_extend_styles(base: SiteStyles, rules: List<BuildRule>, themes: List<SiteThemeDecls> = []) -> SiteStyles {
  SiteStyles { rules: concat(base.rules, rules), themes: concat(base.themes, themes) }
}
fn site_styles_rules(styles: SiteStyles) -> List<BuildRule> { concat(site_layout_rules(), styles.rules) }

fn site_styles_theme_css(styles: SiteStyles) -> String {
  join([theme_root_css(base: day_theme, alternate: night_theme),
    join(map(styles.themes, d => theme_scoped_blocks(base: day_theme, alternate: night_theme, decls_for: t => if t.name == night_theme.name { d.night } else { d.day })), "\n")], "\n")
}
fn site_styles_css(styles: SiteStyles) -> String {
  join([scale_root_css(), site_styles_theme_css(styles: styles),
    serialize_rules(rules: site_styles_rules(styles: styles)), reduced_motion_block(rules: site_styles_rules(styles: styles))], "\n")
}
fn site_document(title: String, heading: String, styles: SiteStyles, content: List<Fragment>, navigation: List<Fragment> = site_navigation()) -> Fragment {
  site_document_over(title: title, heading: heading, styles: styles, content: content, navigation: navigation, shell: ApplicationShell)
}
fn site_document_over(title: String, heading: String, styles: SiteStyles, content: List<Fragment>, navigation: List<Fragment>, shell: SiteShell) -> Fragment {
  el_attrs("html", [attr(name: "lang", value: "en")], [
    el("head", concat([
      el_attrs("meta", [attr(name: "charset", value: "utf-8")], []),
      el_attrs("meta", [attr(name: "name", value: "viewport"), attr(name: "content", value: "width=device-width, initial-scale=1")], []),
      el("title", [txt(title)]),
    ], concat(site_font_stylesheet_nodes(shell: shell), concat([el("style", [txt(site_styles_css(styles: styles))])], site_favicon_nodes())))),
    el("body", concat([site_header_over(page: heading, navigation: navigation, shell: shell)], concat(match shell { ApplicationShell => [el_attrs("script", [attr(name: "src", value: site_client_path), attr(name: "defer", value: "")], [])] ApprovalShell => [] }, content))),
  ])
}

// The self-hosted faces (gunbc.site.web_fonts) are linked once, ahead of the page's own styles, by
// their content-addressed path. Only the application shell links them: it is the shell the
// roadmap server answers, and that server serves the stylesheet route; the approval shell is
// answered by the approval broker, which does not, so linking there would be a dangling request.
fn site_font_stylesheet_nodes(shell: SiteShell) -> List<Fragment> {
  match shell {
    ApplicationShell => [el_attrs("link", [attr(name: "rel", value: "stylesheet"), attr(name: "href", value: web_font_stylesheet_path())], [])]
    ApprovalShell => []
  }
}

fn sound_toggle_control() -> Fragment {
  el_attrs("button", [
    attr(name: "class", value: join([sound_toggle_class, " site-button-compact"], "") ),
    attr(name: "type", value: "button" ),
  ], [ txt("sound") ])
}

fn theme_toggle_control() -> Fragment {
  el_attrs("button", [
    attr(name: "class", value: join([theme_toggle_class, " site-button-compact"], "") ),
    attr(name: "type", value: "button" ),
  ], [ txt(join([theme_toggle_label_prefix, theme_toggle_auto_value], "")) ])
}

fn header_account_nodes() -> List<Fragment> {
  let signin = el_attrs("a", [
    attr(name: "class", value: "header-account header-account-signin" ),
    attr(name: "href", value: auth_login_route_path ),
    attr(name: "data-account-signin", value: "" ),
    attr(name: "title", value: "sign in with Google" ),
  ], [ txt("Sign in") ])
  let avatar = el_attrs("span", [
    attr(name: "class", value: "site-avatar" ),
    attr(name: "data-account-avatar", value: "" ),
    attr(name: "data-avatar", value: "absent" ),
  ], [])
  let name = el_attrs("span", [
    attr(name: "class", value: "header-account-name" ),
    attr(name: "data-account-name", value: "" ),
  ], [])
  let trigger = el_attrs("button", [
    attr(name: "class", value: "header-account-trigger" ),
    attr(name: "type", value: "button" ),
    attr(name: "data-account-trigger", value: "" ),
    attr(name: "aria-haspopup", value: "menu" ),
    attr(name: "aria-expanded", value: "false" ),
  ], [ avatar, name ])
  let switch_item = el_attrs("a", [
    attr(name: "class", value: "header-account-menu-item" ),
    attr(name: "href", value: join([auth_login_route_path, "?prompt=", oidc_login_prompt_label(prompt: OidcLoginPromptSelectAccount) as String], "") ),
    attr(name: "role", value: "menuitem" ),
  ], [ txt("Switch account") ])
  let signout_btn = el_attrs("button", [
    attr(name: "class", value: "header-account-menu-item header-account-signout-btn" ),
    attr(name: "type", value: "submit" ),
    attr(name: "role", value: "menuitem" ),
  ], [ txt("Sign out") ])
  let signout_form = el_attrs("form", [
    attr(name: "class", value: "header-account-signout" ),
    attr(name: "method", value: "post" ),
    attr(name: "action", value: auth_logout_route_path ),
  ], [ signout_btn ])
  let menu = el_attrs("span", [
    attr(name: "class", value: "header-account-menu" ),
    attr(name: "data-account-menu", value: "" ),
    attr(name: "role", value: "menu" ),
    attr(name: "hidden", value: "" ),
  ], [ switch_item, signout_form ])
  let session = el_attrs("span", [
    attr(name: "class", value: "header-account header-account-session" ),
    attr(name: "data-account-session", value: "" ),
    attr(name: "hidden", value: "" ),
  ], [ trigger, menu ])
  [ el_class("span", "header-account-slot", [ signin, session ]) ]
}

fn header_surface_link(label: String, href: String) -> Fragment {
  el_attrs("a", [ attr(name: "href", value: href ), attr(name: "class", value: "surface-link" ) ], [ txt(label) ])
}

fn site_header(page: String, navigation: List<Fragment> = site_navigation()) -> Fragment {
  site_header_over(page: page, navigation: navigation, shell: ApplicationShell)
}
fn site_header_over(page: String, navigation: List<Fragment>, shell: SiteShell) -> Fragment {
  el("header", [el_class("div", "header-inner", concat(
    [site_brand_link(), el("h1", [txt(page)])],
    concat(navigation, match shell { ApplicationShell => [el_class("div", "header-utilities", concat([sound_toggle_control(), theme_toggle_control()], header_account_nodes()))] ApprovalShell => [] })
  ))])
}

fn site_navigation() -> List<Fragment> { [
        header_surface_link(label: "workspace", href: "/"),
        header_surface_link(label: "fleet", href: "/fleet"),
        header_surface_link(label: "allocations", href: "/allocations"),
  ] }
