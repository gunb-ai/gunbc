// The specimen: every element of the internal tools frontend in every variant, built only from
// the production element functions, on one page. It is where an element is looked at before a
// page adopts it, and it is the first consumer of the foundations (the measured upstream facts,
// the palette, the tokens, the text roles). The classes declared here place and caption the
// specimens; none of them reaches inside an element.
data specimen_route_path: String = "/specimen"

data specimen_page_class: String = "specimen-page"
data specimen_row_class: String = "specimen-row"
data specimen_note_class: String = "specimen-note"
data specimen_role_class: String = "specimen-role"
data specimen_text_class: String = "specimen-text"
data specimen_text_role_attribute: String = "data-text-role"
data specimen_height_class: String = "specimen-height"
data specimen_height_attribute: String = "data-height"

fn specimen_row(children: List<Fragment>) -> Fragment {
  el_attrs("div", [attr(name: "class", value: specimen_row_class)], children)
}

fn specimen_note(text: String) -> Fragment {
  el_attrs("p", [attr(name: "class", value: specimen_note_class)], [txt(text)])
}

fn specimen_section(label: String, body: List<Fragment>) -> Fragment {
  card(input: Card {
    edge: CardEdgePlain,
    label_row: Present { value: CardLabelRow { label: label, trailing: [] } },
    body: body,
  })
}

fn specimen_source_text(c: IssueTrackerVisualCapture) -> String {
  join([
    "Measured on ", c.origin.uri.locator as String, ", ", c.session as String, ", at ",
    to_string(c.viewport_width_px), " by ", to_string(c.viewport_height_px),
    " CSS px, captured ", c.captured_on as String, ". Captures: ", c.local_copy.uri.locator as String,
    "; shared copy: https://", c.shared_copy.uri.locator as String, ". Upstream model version ",
    issue_tracker_interface_version as String, ".",
  ], "")
}

fn specimen_source_section() -> Fragment {
  specimen_section(label: "Source", body: [
    el_attrs("p", [], [txt(specimen_source_text(c: issue_tracker_visual_capture))]),
  ])
}

fn specimen_text_row(role: ElementText) -> Fragment {
  el_attrs("div", [attr(name: "class", value: specimen_role_class)], [
    specimen_note(text: element_text_name(role: role)),
    el_attrs("span", [
      attr(name: "class", value: specimen_text_class),
      attr(name: specimen_text_role_attribute, value: element_text_name(role: role)),
    ], [txt("Issue tracker specimen text 0123456789")]),
  ])
}

fn specimen_text_section() -> Fragment {
  specimen_section(label: "Text roles", body: map(element_text_roles, r => specimen_text_row(role: r)))
}

fn specimen_status_section() -> Fragment {
  specimen_section(label: "Status chip", body: [
    specimen_row(children: map(issue_display_statuses, s => status_chip(status: s))),
  ])
}

data specimen_button_idioms: List<IssueActionButtonIdiom> = [IssueButtonContainedPrimary, IssueButtonOutlined, IssueButtonText]

fn specimen_button_label(idiom: IssueActionButtonIdiom) -> String {
  match idiom {
    IssueButtonContainedPrimary => "Filled"
    IssueButtonOutlined => "Outlined"
    IssueButtonText => "Text"
  }
}

fn specimen_button_row(size: ButtonSize, availability: IssueActionAvailability) -> Fragment {
  specimen_row(children: map(specimen_button_idioms, i => button(input: Button {
    label: specimen_button_label(idiom: i),
    idiom: i,
    size: size,
    availability: availability,
  })))
}

fn specimen_button_section() -> Fragment {
  specimen_section(label: "Button", body: [
    specimen_note(text: "Regular"),
    specimen_button_row(size: ButtonRegular, availability: IssueActionEnabled),
    specimen_note(text: "Regular, unavailable"),
    specimen_button_row(size: ButtonRegular, availability: IssueActionDisabled),
    specimen_note(text: "Small"),
    specimen_button_row(size: ButtonSmall, availability: IssueActionEnabled),
    specimen_note(text: "Small, unavailable"),
    specimen_button_row(size: ButtonSmall, availability: IssueActionDisabled),
  ])
}

fn specimen_heading_section() -> Fragment {
  specimen_section(label: "Section heading", body: [
    section_heading(input: SectionHeading { text: "Acceptance criteria", count: SectionUncounted }),
    section_heading(input: SectionHeading { text: "Parent", count: SectionCounted { n: 1 } }),
    section_heading(input: SectionHeading { text: "Sub-issues", count: SectionCountedOfTotal { n: 1, total: 3 } }),
  ])
}

fn specimen_card_body(text: String) -> List<Fragment> {
  [el_attrs("p", [], [txt(text)])]
}

fn specimen_card_section() -> Fragment {
  specimen_section(label: "Card", body: [
    specimen_row(children: [
      card(input: Card { edge: CardEdgePlain, label_row: Absent, body: specimen_card_body(text: "A plain card.") }),
      card(input: Card { edge: CardEdgeBar, label_row: Absent, body: specimen_card_body(text: "A card with a leading bar.") }),
      card(input: Card {
        edge: CardEdgePlain,
        label_row: Present { value: CardLabelRow { label: "Description", trailing: [] } },
        body: specimen_card_body(text: "A card with a label row."),
      }),
      card(input: Card {
        edge: CardEdgeBar,
        label_row: Present { value: CardLabelRow { label: "Status update", trailing: [
          button(input: Button { label: "More details", idiom: IssueButtonText, size: ButtonSmall, availability: IssueActionEnabled }),
        ] } },
        body: specimen_card_body(text: "A card with a leading bar, a label row and a trailing control."),
      }),
    ]),
  ])
}

fn specimen_measured_text(measured_px: Int?) -> String {
  match measured_px {
    Present { value: px } => join([to_string(px), "px measured"], "")
    Absent => "no upstream measurement"
  }
}

fn specimen_height_text(row: ElementHeightRow) -> String {
  join([row.label, ": ", scale_value_wire(v: row.token.value), " adopted, ", specimen_measured_text(measured_px: row.measured_px)], "")
}

fn specimen_height_row(row: ElementHeightRow) -> Fragment {
  el_attrs("div", [
    attr(name: "class", value: specimen_height_class),
    attr(name: specimen_height_attribute, value: row.token.name),
  ], [txt(specimen_height_text(row: row))])
}

fn specimen_height_section() -> Fragment {
  specimen_section(label: "Heights", body: map(element_height_rows(), r => specimen_height_row(row: r)))
}

// The composite: one card with a leading bar and a label row carrying a trailing control, holding
// a section heading, a chip for every status and a row of buttons.
fn specimen_composite() -> Fragment {
  card(input: Card {
    edge: CardEdgeBar,
    label_row: Present { value: CardLabelRow { label: "Composite", trailing: [
      button(input: Button { label: "More details", idiom: IssueButtonText, size: ButtonSmall, availability: IssueActionEnabled }),
    ] } },
    body: [
      section_heading(input: SectionHeading { text: "Sub-issues", count: SectionCountedOfTotal { n: 1, total: 3 } }),
      specimen_row(children: map(issue_display_statuses, s => status_chip(status: s))),
      specimen_row(children: [
        button(input: Button { label: "Add", idiom: IssueButtonContainedPrimary, size: ButtonSmall, availability: IssueActionEnabled }),
        button(input: Button { label: "Add parent", idiom: IssueButtonOutlined, size: ButtonSmall, availability: IssueActionEnabled }),
        button(input: Button { label: "Display 3 more", idiom: IssueButtonText, size: ButtonSmall, availability: IssueActionEnabled }),
      ]),
    ],
  })
}

// THE HIERARCHY FIXTURE. Every node below is planted here; the specimen reads no declared roadmap
// row. Routes come from the one route construction, so a fixture link has the shape a real one has.
data specimen_issue_header_class: String = "specimen-issue-header"
data specimen_issue_title_class: String = "specimen-issue-title"
data specimen_relations_class: String = "specimen-relations"
data specimen_rows_class: String = "specimen-rows"

fn specimen_node(slug: String, title: String, status: NodeStatus, priority: RoadmapPriority) -> NodePresentation {
  NodePresentation {
    slug: slug,
    title: title,
    status: status,
    priority: DerivedPriority { priority: priority, source: "", reason: "specimen fixture" },
    route: issue_page_path(node_id: slug),
  }
}

fn specimen_root() -> NodePresentation {
  specimen_node(slug: "gunbc-project-root", title: "gunbc: one substrate, every scale", status: node_status_derived(status: DisplayActive), priority: PriorityP1)
}

fn specimen_project() -> NodePresentation {
  specimen_node(slug: "dp-m2-shell-residue-retired", title: "Retire the shell residue behind typed invocations", status: node_status_derived(status: DisplayActive), priority: PriorityP1)
}

fn specimen_parent() -> NodePresentation {
  specimen_node(slug: "shell-typed-invocation", title: "Every shell call is a typed invocation", status: node_status_derived(status: DisplayActive), priority: PriorityP1)
}

fn specimen_self() -> NodePresentation {
  specimen_node(slug: "invocation-argv-model", title: "Model the argv of an invocation as typed parts", status: node_status_derived(status: DisplayBlocked), priority: PriorityP2)
}

// One node that is both a sub-issue of the fixture issue and one of its blockers: it is the same
// presentation under both relations.
fn specimen_shared() -> NodePresentation {
  specimen_node(slug: "argv-quoting-rules", title: "State the quoting rules an argv part obeys", status: node_status_derived(status: DisplayBlocked), priority: PriorityP2)
}

fn specimen_chain_short() -> NodeChain {
  NodeChainRooted { ancestors: [specimen_root(), specimen_project(), specimen_parent()], self_node: specimen_self() }
}

fn specimen_chain_long() -> NodeChain {
  NodeChainRooted {
    ancestors: [
      specimen_root(),
      specimen_node(slug: "debt-payoff", title: "Pay off the standing debt", status: node_status_derived(status: DisplayActive), priority: PriorityP1),
      specimen_project(),
      specimen_node(slug: "namespace-unique-on-chain", title: "A name is unique along its chain", status: node_status_derived(status: DisplayReview), priority: PriorityP2),
      specimen_node(slug: "typed-effects", title: "Effects are declared, not discovered", status: node_status_derived(status: DisplayReady), priority: PriorityP2),
      specimen_parent(),
    ],
    self_node: specimen_self(),
  }
}

fn specimen_chain_refused() -> NodeChain {
  NodeChainRefused { refusal: LineageNoParent { walked: ["invocation-argv-model", "orphaned-arc"], at: "orphaned-arc" } }
}

fn specimen_relation_parent() -> NodeRelation {
  NodeRelation { kind: RelationParent, rows: [RelationRow { node: specimen_parent(), children: RowChildrenNotCarried }], undeclared: [] }
}

fn specimen_relation_blocked_by() -> NodeRelation {
  NodeRelation {
    kind: RelationBlockedBy,
    rows: [
      RelationRow { node: specimen_shared(), children: RowChildrenNotCarried },
      RelationRow { node: specimen_node(slug: "process-spawn-effect", title: "Spawning a process is a declared effect", status: node_status_derived(status: DisplayDone), priority: PriorityP3), children: RowChildrenNotCarried },
    ],
    undeclared: ["retired-shell-probe"],
  }
}

fn specimen_relation_sub_issues() -> NodeRelation {
  NodeRelation {
    kind: RelationSubIssues,
    rows: [
      RelationRow { node: specimen_node(slug: "argv-part-vocabulary", title: "Name the closed vocabulary of argv parts", status: node_status_derived(status: DisplayReady), priority: PriorityP0), children: RowChildrenExpandable { count: 0 } },
      RelationRow { node: specimen_shared(), children: RowChildrenExpandable { count: 3 } },
      RelationRow { node: specimen_node(slug: "argv-emit-posix", title: "Emit a typed argv for a POSIX shell, with a title long enough to show how a row behaves when its title runs well past the width a short one needs", status: node_status_derived(status: DisplayReview), priority: PriorityP2), children: RowChildrenExpandable { count: 12 } },
      RelationRow { node: specimen_node(slug: "argv-literal-census", title: "Count the argv literals still written by hand", status: node_status_derived(status: DisplayDone), priority: PriorityP3), children: RowChildrenExpandable { count: 0 } },
      RelationRow { node: specimen_node(slug: "argv-string-splitting", title: "Split an argv from a string", status: node_status_derived(status: DisplaySuperseded), priority: PriorityP3), children: RowChildrenExpandable { count: 1 } },
      RelationRow { node: specimen_node(slug: "argv-windows-quoting", title: "Quote an argv for a Windows command line", status: NodeStatusUnavailable { reason: "the plan carries no row for this node" }, priority: PriorityP2), children: RowChildrenExpandable { count: 0 } },
    ],
    undeclared: [],
  }
}

// The same rows with every status derived, so the heading reads closed over total.
fn specimen_relation_sub_issues_derived() -> NodeRelation {
  let all = specimen_relation_sub_issues()
  NodeRelation { kind: all.kind, rows: all.rows.take(n: 5), undeclared: all.undeclared }
}

fn specimen_relation_empty() -> NodeRelation {
  NodeRelation { kind: RelationBlocking, rows: [], undeclared: [] }
}

fn specimen_chain_section() -> Fragment {
  specimen_section(label: "Hierarchy: node chain", body: [
    specimen_note(text: "Four levels: every level shown"),
    specimen_row(children: [node_chain(chain: specimen_chain_short())]),
    specimen_note(text: "Seven levels: the first, a counted control for the middle, and the last two"),
    specimen_row(children: [node_chain(chain: specimen_chain_long())]),
    specimen_note(text: "A lineage the view refused"),
    specimen_row(children: [node_chain(chain: specimen_chain_refused())]),
  ])
}

fn specimen_marks_section() -> Fragment {
  specimen_section(label: "Chip and priority mark", body: [
    specimen_row(children: [
      chip(input: Chip { text: "shell-typed-invocation" }),
      chip(input: Chip { text: "dp-m2-shell-residue-retired" }),
      priority_mark(input: PriorityMark { priority: PriorityP0 }),
      priority_mark(input: PriorityMark { priority: PriorityP1 }),
      priority_mark(input: PriorityMark { priority: PriorityP2 }),
      priority_mark(input: PriorityMark { priority: PriorityP3 }),
    ]),
  ])
}

// The row at the grid density, in a bare table of the specimen's own: no production table uses
// this density until the results grid adopts the row.
fn specimen_grid_row_section() -> Fragment {
  specimen_section(label: "Node row, grid density", body: [
    el_attrs("table", [attr(name: "class", value: specimen_rows_class)], [
      el_attrs("thead", [], [node_row_header(density: NodeRowDensityGrid)]),
      el_attrs("tbody", [], map([specimen_parent(), specimen_shared()], n => node_row(input: NodeRow { node: n, place: NodeRowFlat, density: NodeRowDensityGrid }))),
    ]),
  ])
}

fn specimen_relation_section() -> Fragment {
  specimen_section(label: "Hierarchy: relation table", body: [
    el_attrs("div", [attr(name: "class", value: specimen_relations_class)], [
      relation_table(input: RelationTable { relation: specimen_relation_empty(), depth: 0 }),
      relation_table(input: RelationTable { relation: specimen_relation_sub_issues_derived(), depth: 1 }),
    ]),
    specimen_note(text: "Above: a relation with no rows, and sub-issues one level down with every status derived"),
  ])
}

// The hierarchy composite: the head of an issue page (the chain chip over the title) and its
// Dependencies card, the three relations of the fixture issue one relation-section gap apart.
fn specimen_issue_composite() -> List<Fragment> {
  [
    el_attrs("div", [attr(name: "class", value: specimen_issue_header_class)], [
      node_chain(chain: specimen_chain_long()),
      el_attrs("h1", [attr(name: "class", value: specimen_issue_title_class)], [txt(specimen_self().title)]),
    ]),
    card(input: Card {
      edge: CardEdgePlain,
      label_row: Present { value: CardLabelRow { label: "Dependencies", trailing: [] } },
      body: [
        el_attrs("div", [attr(name: "class", value: specimen_relations_class)], [
          relation_table(input: RelationTable { relation: specimen_relation_parent(), depth: 0 }),
          relation_table(input: RelationTable { relation: specimen_relation_blocked_by(), depth: 0 }),
          relation_table(input: RelationTable { relation: specimen_relation_sub_issues(), depth: 0 }),
        ]),
      ],
    }),
  ]
}

// The compact work summary, over planted attempts. Fixtures that only the round ledger can
// describe go through the production derivation (gunbc.roadmap.roadmap_build_meter
// build_meter_view_of), so what is shown is what an attempt with those records would show; the
// two that carry typed operation kinds are supplied as views, because no producer emits those
// kinds yet. One fixture is a real run: its rounds were captured from the attempt's event log by
// issue-tracker-shots/meter/convert-real.cjs and are embedded here unchanged; its stages are
// planted to match its recorded terminal (the harness's 40-step budget).
data specimen_meter_class: String = "specimen-meter"
data specimen_meters_class: String = "specimen-meters"
data specimen_meter_subject: String = "frontend-elements"
data specimen_meter_first_round_ms: Int = 1790694000000
data specimen_meter_round_ms: Int = 47000

