// gunb.ai's DEPLOY: ON A PUSH TO MAIN, RENDER THE SITE FROM ITS TYPED MODULES AND PUBLISH IT TO GITHUB PAGES.
//
// Admitted by gunbc.design_ruling::gunb_ai_deploys_from_gunbc_2026_11_24 for gunbc.plans.gunb_ai_served_from_gunbc.
// It runs only on a push to the default branch: it is not a pull-request or merge-group job, is not a
// required context, and gates no merge. One job builds the seed, renders the served set with
// gunbc.site.gunb_ai_site (which writes nothing unless every file renders), uploads exactly the stage
// directory that module writes, and deploys it. A failed render fails the step, so nothing is uploaded and
// the previous deployment keeps serving.
//
// The job holds `pages: write` and `id-token: write` because actions/deploy-pages requires both, and runs
// in the `github-pages` environment that Pages creates, whose branch rule is the second fence on main.
//
// It is exempt from the Actions wind-down (gunbc.design_ruling::gunb_ai_pages_deploy_is_exempt_from_the_actions_wind_down_2026_11_26): when gunb.ai needs
// more than a static site, the deploy moves to a route that is not GitHub Pages and this module is deleted.

data gunb_ai_pages_workflow_name: String = "gunb-ai-pages"
data gunb_ai_pages_job_id: String = "deploy"
data gunb_ai_pages_build_step_name: String = "Build the seed that renders the site"
data gunb_ai_pages_required_bins: List<String> = ["gunbc"]

// WHERE AND HOW LONG. Both are budgets reserved to the operator by
// gunbc.design_ruling::ci_job_budgets_closed_to_growth; these figures were granted by
// gunbc.design_ruling::gunb_ai_pages_job_runs_on_the_fleet_within_30_minutes_2026_11_24.
data gunb_ai_pages_runner: CiRunnerTarget = FleetSelfHosted
data gunb_ai_pages_timeout: Minute = minute(count: 30)

fn gunb_ai_pages_checkout_step() -> Step {
  UsesStep {
    name: Present { value: "Checkout" },
    id: none,
    uses: checkout_action,
    with: Present { value: [
      kv(key: "fetch-depth", value: yaml_int(n: 1)),
      kv(key: "persist-credentials", value: yaml_bool(b: false))
    ] },
    env: none,
    if_condition: none,
    continue_on_error: none,
    timeout_minutes: none
  }
}

fn gunb_ai_pages_render_step() -> Step {
  RunStep {
    name: Present { value: "Render gunb.ai into the stage directory" },
    id: none,
    run: gunbc_run_step_script_for_target(
      source_roots: witness_layer_roots,
      target: gunbc_run_step_target(module: "gunbc.site.gunb_ai_site", function: "site_write_main"),
      receipt_rel: none
    ),
    shell: none,
    env: none,
    working_directory: none,
    if_condition: none,
    continue_on_error: none,
    timeout_minutes: none
  }
}

fn gunb_ai_pages_upload_step() -> Step {
  UsesStep {
    name: Present { value: "Upload the stage directory as the Pages artifact" },
    id: none,
    uses: upload_pages_artifact_action,
    with: Present { value: upload_pages_artifact_with(inputs: UploadPagesArtifactInputs { path: gunb_ai_site_stage_dir }) },
    env: none,
    if_condition: none,
    continue_on_error: none,
    timeout_minutes: none
  }
}

// THE DEPLOY IS RETRIED, BOUNDED. actions/deploy-pages finds the artifact by listing the run's artifacts,
// and that listing can lag behind the upload that finished a moment before it, so the first deploy can
// report 'No artifacts named "github-pages"' for an artifact that exists (actions/deploy-pages issue 451,
// open, reported against this exact pair of pins; observed here on both attempts of run 45782123533).
// The lookup fails before any deployment is created, so a retry cannot deploy twice. Each earlier try
// continues on error; a later try runs only if every earlier one failed, after its wait; only the last
// try can fail the job. Dissolves when deploy-pages deploys
// by the artifact id upload-pages-artifact outputs, or the listing is consistent after upload.
data gunb_ai_pages_deploy_retry_waits: List<Second> = [second(count: 20), second(count: 60)]

data gunb_ai_pages_deploy_step_name: String = "Deploy to GitHub Pages"

fn gunb_ai_pages_deploy_try_id(n: Int) -> String {
  join(["deploy_try_", to_string(n)], "")
}

fn gunb_ai_pages_deploy_try_name(n: Int) -> String {
  if n == 1 { gunb_ai_pages_deploy_step_name } else { join([gunb_ai_pages_deploy_step_name, " (try ", to_string(n), ")"], "") }
}

// A try's outcome was failure, as a steps-context expression (extdeps.github.expressions).
fn gunb_ai_pages_try_failed(n: Int) -> Expression {
  step_outcome_is(step_id: gunb_ai_pages_deploy_try_id(n: n), outcome: StepOutcomeFailure)
}

fn gunb_ai_pages_deploy_try_step(n: Int, all_failed: Expression?, last: Bool) -> Step {
  UsesStep {
    name: Present { value: gunb_ai_pages_deploy_try_name(n: n) },
    id: Present { value: if last { "deployment" } else { gunb_ai_pages_deploy_try_id(n: n) } },
    uses: deploy_pages_action,
    with: none,
    env: none,
    if_condition: match all_failed { Present { value: e } => Present { value: serialize_expression(expression: e) } Absent => none },
    continue_on_error: if last { none } else { Present { value: true } },
    timeout_minutes: none
  }
}

fn gunb_ai_pages_deploy_wait_step(n: Int, all_failed: Expression, wait: Second) -> Step {
  RunStep {
    name: Present { value: join(["Wait ", to_string(second_count(s: wait)), "s before deploy try ", to_string(n)], "") },
    id: none,
    run: join(["sleep ", to_string(second_count(s: wait))], ""),
    shell: none,
    env: none,
    working_directory: none,
    if_condition: Present { value: serialize_expression(expression: all_failed) },
    continue_on_error: none,
    timeout_minutes: none
  }
}

type GunbAiPagesBoundStep {
  step: Step
  role: StepCapabilityRole
  step_name: String
}

fn gunb_ai_pages_bound_steps() -> List<GunbAiPagesBoundStep> {
  concat(gunb_ai_pages_build_bound_steps(), gunb_ai_pages_deploy_bound_steps())
}

fn gunb_ai_pages_build_bound_steps() -> List<GunbAiPagesBoundStep> {
  [
    GunbAiPagesBoundStep { step: gunb_ai_pages_checkout_step(), role: capability_neutral, step_name: "Checkout" },
    GunbAiPagesBoundStep { step: toolchain_home_isolation_step(), role: capability_neutral, step_name: "Isolate toolchain homes" },
    GunbAiPagesBoundStep {
      step: witness_floor_toolchain_step(),
      role: provides_only(capabilities: [CargoCapability, RustcCapability, RustfmtCapability, RustupCapability]),
      step_name: "Install Rust toolchain",
    },
    GunbAiPagesBoundStep {
      step: toolchain_pin_rustup_default_step(),
      role: consumes_only(capabilities: [RustupCapability, CargoCapability]),
      step_name: "Pin rustup default (isolated RUSTUP_HOME has no default toolchain)",
    },
    GunbAiPagesBoundStep {
      step: witness_floor_build_step(step_name: gunb_ai_pages_build_step_name, build_script: repo_self_build_command(bins: gunb_ai_pages_required_bins)),
      role: consumes_only(capabilities: [CargoCapability]),
      step_name: gunb_ai_pages_build_step_name,
    },
    GunbAiPagesBoundStep { step: gunb_ai_pages_render_step(), role: capability_neutral, step_name: "Render gunb.ai into the stage directory" },
    GunbAiPagesBoundStep { step: gunb_ai_pages_upload_step(), role: capability_neutral, step_name: "Upload the stage directory as the Pages artifact" },
  ]
}

// Try 1, then for each wait: the wait and the next try, so there is one more try than waits. The fold
// carries the steps so far, the next try's number, and the expression that every try so far failed.
type GunbAiPagesDeployFold {
  steps: List<GunbAiPagesBoundStep>
  next: Int
  all_failed: Expression
}

fn gunb_ai_pages_deploy_bound_steps() -> List<GunbAiPagesBoundStep> {
  let tries = fold(gunb_ai_pages_deploy_retry_waits, init: 1, f: fn(acc, _) { acc + 1 })
  let first = GunbAiPagesBoundStep {
    step: gunb_ai_pages_deploy_try_step(n: 1, all_failed: none, last: tries == 1),
    role: capability_neutral,
    step_name: gunb_ai_pages_deploy_try_name(n: 1),
  }
  let done = fold(gunb_ai_pages_deploy_retry_waits,
    init: GunbAiPagesDeployFold { steps: [first], next: 2, all_failed: gunb_ai_pages_try_failed(n: 1) },
    f: fn(acc, wait) {
      GunbAiPagesDeployFold {
        steps: concat(acc.steps, [
          GunbAiPagesBoundStep {
            step: gunb_ai_pages_deploy_wait_step(n: acc.next, all_failed: acc.all_failed, wait: wait),
            role: capability_neutral,
            step_name: join(["Wait before deploy try ", to_string(acc.next)], ""),
          },
          GunbAiPagesBoundStep {
            step: gunb_ai_pages_deploy_try_step(n: acc.next, all_failed: Present { value: acc.all_failed }, last: acc.next == tries),
            role: capability_neutral,
            step_name: gunb_ai_pages_deploy_try_name(n: acc.next),
          },
        ]),
        next: acc.next + 1,
        all_failed: LogicalAnd { left: acc.all_failed, right: gunb_ai_pages_try_failed(n: acc.next) },
      }
    })
  done.steps
}

fn gunb_ai_pages_capability_closure_holds() -> Bool {
  capability_closure_is_closed(
    v: workflow_job_capability_closure(
      steps: list_map(
        xs: gunb_ai_pages_bound_steps(),
        f: fn(b) { CapabilityAnnotatedStep { step_name: b.step_name, role: b.role } },
      )
    ),
  )
}

data gunb_ai_pages_workflow_permissions: WorkflowPermissions = WorkflowPermissions {
  contents: Present { value: PermRead },
  pull_requests: none,
  issues: none,
  actions: none,
  id_token: none,
  pages: none
}

data gunb_ai_pages_job_permissions: WorkflowPermissions = WorkflowPermissions {
  contents: Present { value: PermRead },
  pull_requests: none,
  issues: none,
  actions: none,
  id_token: Present { value: PermWrite },
  pages: Present { value: PermWrite }
}

fn gunb_ai_pages_job() -> Job {
  Job {
    id: gunb_ai_pages_job_id,
    name: none,
    runner: ci_runner_target_spec(target: gunb_ai_pages_runner),
    environment: Present { value: github_pages_environment },
    steps: list_map(xs: gunb_ai_pages_bound_steps(), f: fn(b) { b.step }),
    needs: [],
    env: none,
    outputs: none,
    if_condition: none,
    timeout_minutes: Present { value: minute_count(m: gunb_ai_pages_timeout) },
    continue_on_error: none,
    concurrency: none,
    permissions: Present { value: gunb_ai_pages_job_permissions }
  }
}

// One deployment at a time, and a queued one is never cancelled: a later push waits for the one deploying.
fn gunb_ai_pages_workflow() -> Workflow {
  Workflow {
    name: gunb_ai_pages_workflow_name,
    run_name: none,
    on: [Push { branches: [gunbc_default_branch_name], paths: [] }],
    concurrency: Present { value: ConcurrencyMappingQueueNotMax {
      group: "gunb-ai-pages",
      cancel_in_progress: Present { value: CancelInProgressBool { value: false } },
      explicit_single: none
    } },
    env: Present { value: [
      kv(key: "CARGO_TERM_COLOR", value: yaml_string(s: "always")),
      kv(key: "MALLOC_ARENA_MAX", value: yaml_string(s: "2"))
    ] },
    permissions: Present { value: gunb_ai_pages_workflow_permissions },
    jobs: [gunb_ai_pages_job()]
  }
}

type GunbAiPagesWorkflowGenerationOutcome
  = GunbAiPagesWorkflowGenerated { content: String }
  | GunbAiPagesWorkflowGenerationRefused { reason: String }

data gunb_ai_pages_capability_refusal_reason: String = "REFUSED gunbc.site.gunb_ai_pages_workflow: the job's capability closure does not hold. No workflow yaml was emitted. Fix the step roles in gunb_ai_pages_bound_steps."

fn expected_gunb_ai_pages_workflow_yml() -> GunbAiPagesWorkflowGenerationOutcome {
  match admit_workflow_checkout_refs(workflow: gunb_ai_pages_workflow(), declared: []) {
    WorkflowCheckoutRefsRefused { refusals: crs } =>
      GunbAiPagesWorkflowGenerationRefused { reason: workflow_checkout_refs_refusal_reason(workflow_module: "gunbc.site.gunb_ai_pages_workflow", refusals: crs) }
    WorkflowCheckoutRefsAdmitted =>
      match admit_workflow_toolchain_homes(workflow: gunb_ai_pages_workflow()) {
        WorkflowToolchainHomeRefused { job_id: j, refusal: r } =>
          GunbAiPagesWorkflowGenerationRefused { reason: toolchain_home_refusal_reason(job_id: j, refusal: r) }
        WorkflowToolchainHomesAdmitted =>
          if !gunb_ai_pages_capability_closure_holds() {
            GunbAiPagesWorkflowGenerationRefused { reason: gunb_ai_pages_capability_refusal_reason }
          } else {
            match emit_yaml(v: project_workflow_to_yaml(workflow: gunb_ai_pages_workflow())) {
              EmittedYaml { text: t } => GunbAiPagesWorkflowGenerated { content: t }
              YamlEmitRefused { path: p, reason: r } => GunbAiPagesWorkflowGenerationRefused { reason: yaml_emit_refusal_text(module_path: "gunbc.site.gunb_ai_pages_workflow", path: p, reason: r) }
            }
          }
      }
  }
}

fn gunb_ai_pages_workflow_yaml_artifact_generated() -> ArtifactGenerationOutcome {
  match expected_gunb_ai_pages_workflow_yml() {
      GunbAiPagesWorkflowGenerated { content } => workflow_body_generated(content: content)
      GunbAiPagesWorkflowGenerationRefused { reason } => ArtifactGenerationRefused { reason: reason }
    }
}

fn gunb_ai_pages_workflow_yaml_artifact_extra_valid(_generated: ArtifactGenerationOutcome) -> Bool {
  ci_yml_parses(path: artifact_path(a: GunbAiPagesWorkflowYamlArtifact))
}

data gunb_ai_pages_workflow_yaml_artifact_production: GeneratedArtifactProduction = GeneratedArtifactProduction {
  artifact: GunbAiPagesWorkflowYamlArtifact,
  generate: gunb_ai_pages_workflow_yaml_artifact_generated,
  extra_valid: gunb_ai_pages_workflow_yaml_artifact_extra_valid,
  provenance: Present { value: GeneratedWorkflowProvenance {
    generator: "gunbc.site.gunb_ai_pages_workflow expected_gunb_ai_pages_workflow_yml",
    authority: "gunbc.site.gunb_ai_pages_workflow gunb_ai_pages_workflow",
  } },
}
