module gunbc.site.accent_study


data accent_study_note: String = "Preview-only study page (ninth pass): the accent decision rendered, not debated. Each candidate panel scopes the SAME four figure role vars to one stellar class's materials — the constellation inside is identical fact rows, so the panels differ only in the starlight temperature. The day-atlas exhibit shows the day identity is accent-independent (always ink on paper). The verdigris exhibit shows green entering as patina material on the edges — the only place physics lets green in. Not a committed artifact; the signed class's rows land in tokens.night_theme and this study dissolves."

fn figure_vars_style(figure: gunbc.design.material.Material) -> String {
  join([
    "--figure: ", gunbc.design.material.paint(m: figure),
    "; --figure-lit: ", gunbc.design.material.paint(m: gunbc.site.starlight.lit_variant(m: figure)),
    "; --figure-halo: ", gunbc.design.material.paint_alpha(m: figure, alpha_pct: 14),
    "; --figure-edge: ", gunbc.design.material.paint_alpha(m: gunbc.site.starlight.edge_variant(m: figure), alpha_pct: 50),
  ], "")
}

fn theme_vars_style(t: gunbc.design.theme.Theme) -> String {
  join(map(gunbc.design.theme.theme_var_decls(t: t), d => join([css_property_wire(p: d.prop), ": ", d.value], "")), "; ")
}

fn candidate_panel(r: gunbc.site.starlight.StarlightRender) -> std.markup.Fragment {
  std.markup.Element {
    tag: "div",
    attributes: [
      std.markup.attr(name: "class", value: "panel variant" ),
      std.markup.attr(name: "style", value: figure_vars_style(figure: r.figure) ),
    ],
    children: [
      gunbc.site.constellation.constellation_svg(stars: gunbc.site.constellation.layer_stars, edges: gunbc.site.constellation.layer_import_edges),
      gunbc.site.markup.el_class("p", "mono label", [
        gunbc.site.markup.txt(join([gunbc.site.starlight.render_label(r: r), " · ", gunbc.design.material.paint(m: r.figure)], "")),
      ]),
    ],
  }
}

fn verdigris_panel() -> std.markup.Fragment {
  std.markup.Element {
    tag: "div",
    attributes: [
      std.markup.attr(name: "class", value: "panel variant" ),
      std.markup.attr(name: "style", value: join([
        figure_vars_style(figure: g_figure()),
        "; --figure-edge: ", gunbc.design.material.paint_alpha(m: gunbc.site.starlight.verdigris_patina, alpha_pct: 65),
      ], "") ),
    ],
    children: [
      gunbc.site.constellation.constellation_svg(stars: gunbc.site.constellation.layer_stars, edges: gunbc.site.constellation.layer_import_edges),
      gunbc.site.markup.el_class("p", "mono label", [
        gunbc.site.markup.txt(join([
          "G starlight + verdigris patina on the edges · ", gunbc.design.material.paint(m: gunbc.site.starlight.verdigris_patina),
          " — green enters as material, never as starlight (no green stars exist)",
        ], "")),
      ]),
    ],
  }
}

fn g_figure() -> gunbc.design.material.Material {
  fold(gunbc.site.starlight.study_candidates, init: gunbc.site.starlight.verdigris_patina, f: (acc, r) => {
    let candidate_code = r.spectral.code as String
    if candidate_code == "G" { r.figure } else { acc }
  })
}

fn day_panel() -> std.markup.Fragment {
  std.markup.Element {
    tag: "div",
    attributes: [
      std.markup.attr(name: "class", value: "panel variant day-panel" ),
      std.markup.attr(name: "style", value: theme_vars_style(t: gunbc.design.theme.day_theme) ),
    ],
    children: [
      gunbc.site.constellation.constellation_svg(stars: gunbc.site.constellation.layer_stars, edges: gunbc.site.constellation.layer_import_edges),
      gunbc.site.markup.el_class("p", "mono label", [
        gunbc.site.markup.txt("the day atlas — indigo ink on paper; identical fact rows, accent-independent"),
      ]),
    ],
  }
}

fn study_static_rules() -> List<gunbc.design.material.BuildRule> {
  [
    gunbc.design.material.StaticRule { selector: ElementSelector { tag: "body" }, decls: [
      gunbc.design.theme.role_decl(prop: Background, r: gunbc.design.theme.CanvasRole),
      gunbc.design.theme.role_decl(prop: Color, r: gunbc.design.theme.TextRole),
      gunbc.design.material.decl(prop: FontFamily, value: "'Noto Sans', system-ui, sans-serif"),
      gunbc.design.material.decl(prop: Margin, value: "0"),
      gunbc.design.material.decl(prop: LineHeight, value: "1.55"),
    ] },
    gunbc.design.material.StaticRule { selector: ElementSelector { tag: "main" }, decls: [
      gunbc.design.material.decl(prop: MaxWidth, value: "54rem"),
      gunbc.design.material.decl(prop: Margin, value: "0 auto"),
      gunbc.design.material.decl(prop: Padding, value: "3rem 1.5rem 4rem"),
    ] },
    gunbc.design.material.StaticRule { selector: ElementSelector { tag: "h1" }, decls: [
      gunbc.design.material.decl(prop: FontSize, value: "1.2rem"),
      gunbc.design.material.decl(prop: FontWeight, value: "500"),
    ] },
    gunbc.design.material.StaticRule { selector: ClassSelector { name: "thesis" }, decls: [
      gunbc.design.theme.role_decl(prop: Color, r: gunbc.design.theme.TextDimRole),
      gunbc.design.material.decl(prop: Margin, value: "0.25rem 0 0"),
    ] },
    gunbc.design.material.StaticRule { selector: ElementSelector { tag: "h2" }, decls: [
      gunbc.design.material.decl(prop: FontSize, value: "0.85rem"),
      gunbc.design.material.decl(prop: FontWeight, value: "500"),
      gunbc.design.material.decl(prop: RawProperty { name: "code-spacing" }, value: "0.08em"),
      gunbc.design.material.decl(prop: TextTransform, value: "lowercase"),
      gunbc.design.theme.role_decl(prop: Color, r: gunbc.design.theme.TextDimRole),
      gunbc.design.material.decl(prop: MarginTop, value: "2.2rem"),
    ] },
    gunbc.design.material.StaticRule { selector: ClassSelector { name: "panel" }, decls: [
      gunbc.design.theme.role_decl(prop: Background, r: gunbc.design.theme.SurfaceRole),
      gunbc.design.material.decl(prop: Border, value: "1px solid var(--border)"),
      gunbc.design.material.decl(prop: BorderRadius, value: "3px"),
      gunbc.design.material.decl(prop: Padding, value: "1.1rem 1.25rem"),
      gunbc.design.material.decl(prop: MarginTop, value: "0.8rem"),
    ] },
    gunbc.design.material.StaticRule { selector: ClassSelector { name: "day-panel" }, decls: [
      gunbc.design.material.decl(prop: Background, value: "var(--canvas)"),
      gunbc.design.material.decl(prop: Color, value: "var(--text)"),
    ] },
    gunbc.design.material.StaticRule { selector: ClassSelector { name: "constellation" }, decls: [
      gunbc.design.material.decl(prop: Width, value: "100%"),
      gunbc.design.material.decl(prop: Height, value: "auto"),
    ] },
    gunbc.design.material.StaticRule { selector: ClassSelector { name: "mono" }, decls: [
      gunbc.design.material.decl(prop: FontFamily, value: "'JetBrains Mono', monospace"),
      gunbc.design.material.decl(prop: FontSize, value: "0.78em"),
    ] },
    gunbc.design.material.StaticRule { selector: ClassSelector { name: "label" }, decls: [
      gunbc.design.theme.role_decl(prop: Color, r: gunbc.design.theme.TextDimRole),
      gunbc.design.material.decl(prop: Margin, value: "0.6rem 0 0"),
    ] },
  ]
}

fn study_root_css() -> String {
  join([
    join([":root { ", join(map(gunbc.design.theme.theme_var_decls(t: gunbc.design.theme.night_theme), d => join([css_property_wire(p: d.prop), ": ", d.value], "")), "; "), " }"], ""),
    gunbc.design.material.serialize_rules(rules: concat(study_static_rules(), gunbc.site.moodboard.figure_rules())),
  ], "\n")
}

fn accent_study_page() -> std.markup.Fragment {
  std.markup.Element { tag: "html", attributes: [ std.markup.attr(name: "lang", value: "en" ) ], children: [
    gunbc.site.markup.el("head", [
      std.markup.Element { tag: "meta", attributes: [ std.markup.attr(name: "charset", value: "utf-8" ) ], children: [] },
      gunbc.site.markup.el("title", [ gunbc.site.markup.txt("gunb.ai — starlight accent study (phase 0, preview only)") ]),
      gunbc.site.markup.el("style", [ gunbc.site.markup.txt(study_root_css()) ]),
    ]),
    gunbc.site.markup.el("body", [
      gunbc.site.markup.el("main", [
        gunbc.site.markup.el("h1", [ gunbc.site.markup.txt("starlight accent study") ]),
        gunbc.site.markup.el_class("p", "thesis", [ gunbc.site.markup.txt(gunbc.design.principles.register_thesis) ]),
        gunbc.site.markup.el_class("p", "thesis", [ gunbc.site.markup.txt("the night accent is starlight, so the candidates are stellar classes (Morgan-Keenan); same constellation fact rows in every panel — only the temperature changes. no green panel exists: there are no green stars.") ]),
        gunbc.site.markup.el("h2", [ gunbc.site.markup.txt("candidates — pick a temperature") ]),
        gunbc.site.markup.el("div", map(gunbc.site.starlight.study_candidates, r => candidate_panel(r: r))),
        gunbc.site.markup.el("h2", [ gunbc.site.markup.txt("green, where physics allows it — patina, not starlight") ]),
        verdigris_panel(),
        gunbc.site.markup.el("h2", [ gunbc.site.markup.txt("the day identity is accent-independent") ]),
        day_panel(),
        gunbc.site.markup.el_class("p", "mono label", [ gunbc.site.markup.txt(extdeps.astronomy.stellar_classification.stellar_color_perception_quote) ]),
      ]),
    ]),
  ] }
}

fn accent_study_html() -> String {
  match extdeps.languages.html.try_serialize_html_source(node: accent_study_page()) {
    extdeps.languages.html.EmitOk { html: h } => concat("<!DOCTYPE html>\n", h)
    extdeps.languages.html.EmitRejected { reason: r } => concat("EMIT REJECTED: ", r)
  }
}

fn accent_study_preconditions_hold() -> Bool {
  gunbc.site.starlight.candidates_admissible(rs: gunbc.site.starlight.study_candidates)
}
