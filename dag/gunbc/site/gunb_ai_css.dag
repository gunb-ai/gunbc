fn sheet_var(name: String) -> CssValue {
  ValVar { reference: CssVarRef { name: name } }
}

fn sheet_expr(property: CssPropertyName, value: CssValue) -> SheetDecl {
  SheetDecl { property: property, value: ValueExpr { value: value } }
}

fn sheet_ident(property: CssPropertyName, ident: String) -> SheetDecl {
  sheet_expr(property: property, value: ValIdent { ident: ident })
}

fn single_compound_selector(c: CompoundSelector) -> SelectorList {
  SelectorList { selectors: [ComplexSelector { compounds: [c] }] }
}

fn root_list() -> SelectorList {
  single_compound_selector(c: CompoundSelector { type_selector: Absent, parts: [PseudoClassPart { name: "root" }] })
}

fn universal_compound(parts: List<SimpleSelector>) -> CompoundSelector {
  CompoundSelector { type_selector: Present { value: UniversalType }, parts: parts }
}

fn inline_rule(selector: SelectorList, decls: List<SheetDecl>) -> SheetEntry {
  EntryRule { rule: inline_sheet_rule(selector: selector, decls: decls) }
}

data reset_banner: List<String> = ["╔══ RESET + BASE ══════════════════════════════════════════════════"]

data reset_universal_selector: SelectorList = SelectorList { selectors: [
  ComplexSelector { compounds: [universal_compound(parts: [])] },
  ComplexSelector { compounds: [universal_compound(parts: [PseudoElementPart { name: "before" }])] },
  ComplexSelector { compounds: [universal_compound(parts: [PseudoElementPart { name: "after" }])] },
] }

data html_items: List<SheetItem> = [
  ItemDecls { decls: [
    sheet_expr(property: Background, value: sheet_var(name: "void")),
    sheet_expr(property: Color, value: sheet_var(name: "warm-white-dim")),
    sheet_expr(property: FontFamily, value: sheet_var(name: "font-sans")),
    sheet_expr(property: FontSize, value: ValLength { length: CssDecimalLength { milli: 16000, unit: Px } }),
    sheet_expr(property: LineHeight, value: ValNumber { milli: 1600 }),
    sheet_ident(property: WebkitFontSmoothing, ident: "antialiased"),
    sheet_ident(property: ColorScheme, ident: "dark"),
  ], alignment: Compact },
]

fn sheet_len(milli: Int, unit: CssLengthUnit) -> CssValue {
  ValLength { length: CssDecimalLength { milli: milli, unit: unit } }
}

fn sheet_rem(milli: Int) -> CssValue {
  sheet_len(milli: milli, unit: Rem)
}

fn sheet_space(items: List<CssValue>) -> CssValue {
  ValSpaceList { items: items }
}

fn classes_compound(names: List<String>) -> CompoundSelector {
  CompoundSelector { type_selector: Absent, parts: map(names, n => ClassPart { name: n }) }
}

fn class_list(name: String) -> SelectorList {
  single_compound_selector(c: class_compound(name: name))
}

fn descendant_list(ancestor: CompoundSelector, descendant: CompoundSelector) -> SelectorList {
  SelectorList { selectors: [ComplexSelector { compounds: [ancestor, descendant] }] }
}

fn block_sheet_rule(selector: SelectorList, items: List<SheetItem>) -> SheetRule {
  SheetRule { selector: selector, layout: RuleBlock, items: items }
}

fn block_rule(selector: SelectorList, items: List<SheetItem>) -> SheetEntry {
  EntryRule { rule: block_sheet_rule(selector: selector, items: items) }
}

fn inline_sheet_rule(selector: SelectorList, decls: List<SheetDecl>) -> SheetRule {
  SheetRule { selector: selector, layout: RuleInline, items: [ItemDecls { decls: decls, alignment: Compact }] }
}

fn stacked_rule(selector: SelectorList, decls: List<SheetDecl>) -> SheetEntry {
  EntryRule { rule: SheetRule { selector: selector, layout: RuleInlineStacked, items: [ItemDecls { decls: decls, alignment: Compact }] } }
}

fn max_width_media(max: CssLength, rules: List<SheetRule>) -> SheetEntry {
  EntryMedia { condition: MediaMaxWidth { max: max }, rules: rules }
}

fn compact_decls(decls: List<SheetDecl>) -> SheetItem {
  ItemDecls { decls: decls, alignment: Compact }
}

data font_mono_decl: SheetDecl = sheet_expr(property: FontFamily, value: sheet_var(name: "font-mono"))

data layout_banner: List<String> = ["╔══ LAYOUT ════════════════════════════════════════════════════════"]
data masthead_banner: List<String> = ["╔══ MASTHEAD ══════════════════════════════════════════════════════"]
