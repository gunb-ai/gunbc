  ] },
]
data prose_banner: List<String> = ["╔══ PROSE — generic body paragraphs ══════════════════════════════"]
data measure_banner: List<String> = ["╔══ MEASURE WRAPPERS ═════════════════════════════════════════════", "Width is controlled by section CONTAINERS, not individual components.", "Wrap a section in one of these to clamp its children."]
data carved_banner: List<String> = ["╔══ CARVED RULE — section break with moss diamond notch ═════════", "No max-width: inherits from its container (the section's measure", "wrapper or .page). That keeps it aligned with whatever sits beside", "or below it."]
data command_banner: List<String> = ["╔══ COMMAND PANEL ═════════════════════════════════════════════════"]
data invariant_banner: List<String> = ["╔══ INVARIANT PANEL — clay only here ═════════════════════════════"]
data roles_banner: List<String> = ["╔══ ROLE TOKENS — shared between code spans and graph elements ═", "The visual-correspondence rule: every colored code token has a", "same-colored graph object, and vice versa.", "", "Taxonomy (one color per structural meaning):", "  stable      ordinary structure                    warm-white", "  focus       the source fact this card pivots on   brass", "  derived     directly downstream / 1-2 hops        moss", "  transitive  multi-hop downstream (distant kin)    moss-dim", "  artifact    terminal generated slot               warm-white", "  removed     diff removal                          clay", "  boundary    violation / no artifact emitted       clay", "  context     ambient text without a role           stone", "", "stable and artifact share warm-white intentionally: they are the", "bookends of the system (source root and target slot). The cut-", "corner pentagon shape carries the artifact distinction."]

data reset_base_entries: List<SheetEntry> = [
  EntryComment { lines: header_comment },
  EntryGap { blank_lines: 2 },
  EntryComment { lines: tokens_banner },
  EntryGap { blank_lines: 1 },
  EntryRule { selector: root_list(), layout: RuleBlock, items: tokens_items },
  EntryGap { blank_lines: 2 },
  EntryComment { lines: reset_banner },
  EntryGap { blank_lines: 1 },
  inline_rule(selector: reset_universal_selector, decls: [sheet_ident(property: BoxSizing, ident: "border-box")]),
  EntryGap { blank_lines: 1 },
  EntryRule { selector: single_compound_selector(c: element_compound(tag: "html")), layout: RuleBlock, items: html_items },
  inline_rule(selector: single_compound_selector(c: element_compound(tag: "body")), decls: [sheet_expr(property: Margin, value: ValNumber { milli: 0 })]),
  inline_rule(selector: single_compound_selector(c: element_compound(tag: "a")), decls: [sheet_ident(property: Color, ident: "inherit")]),
  EntryGap { blank_lines: 2 },
]

data later_sections: List<List<SheetEntry>> = [
  masthead_entries, text_roles_entries, hero_entries, prose_entries, measure_entries,
  carved_entries, command_entries, invariant_entries, role_entries,
]

data sheet_entries: List<SheetEntry> = concat(concat(reset_base_entries, layout_entries), fold(later_sections, init: [], f: (acc, section) => concat(acc, concat([EntryGap { blank_lines: 2 }], section))))

fn value_wire(v: SheetValue) -> String {
  match v {
    ValueNumber { n: n } => to_string(n)
    ValuePercent { n: n } => join([to_string(n), "%"], "")
    ValueLength { length: l } => css_decimal_length_wire(l: l)
    ValueFonts { stack: s } => css_font_stack_wire(s: s, quote: DoubleQuote)
    ValueLiveColor { token: t } => css_hsl_wire(c: live_token_css(t: t))
    ValueExpr { value: x } => css_value_wire(v: x)
  }
}

fn decl_name_wire(d: SheetDecl) -> String {
  concat(css_property_wire(p: d.property), ":")
}

fn name_width(d: SheetDecl) -> Int {
  0 + decl_name_wire(d: d).length()
}

fn longest_name(decls: List<SheetDecl>) -> Int {
  fold(decls, init: 0, f: (acc, d) => if name_width(d: d) > acc { name_width(d: d) } else { acc })
}

// The value starts one space after the longest `--name:` of its group.
fn decl_pad(d: SheetDecl, name_column: Int, alignment: DeclAlignment) -> Int {
  match alignment {
    ColumnAligned => name_column + 1 - name_width(d: d)
    Compact => 1
  }
}

fn decl_text(d: SheetDecl, name_column: Int, alignment: DeclAlignment) -> String {
  join([decl_name_wire(d: d), repeat_string(s: " ", n: decl_pad(d: d, name_column: name_column, alignment: alignment)), value_wire(v: d.value), ";"], "")
}

fn decl_line(d: SheetDecl, name_column: Int, alignment: DeclAlignment, indent: Int) -> String {
  concat(repeat_string(s: " ", n: indent), decl_text(d: d, name_column: name_column, alignment: alignment))
}

type CommentAcc {
  text: String
  started: Bool
}

fn comment_line_prefix(acc: CommentAcc, line: String, indent: Int) -> String {
  if !acc.started {
    join([repeat_string(s: " ", n: indent), "/* "], "")
  } else if line == "" {
    "\n"
  } else {
    join(["\n", repeat_string(s: " ", n: indent + 3)], "")
  }
}

// First line opens `/* `; later lines are indented to sit under the first line's text (blank lines
// stay empty); the last line closes ` */`.
fn comment_wire(lines: List<String>, indent: Int) -> String {
  let folded = fold(lines, init: CommentAcc { text: "", started: false }, f: (acc, l) => CommentAcc {
    text: join([acc.text, comment_line_prefix(acc: acc, line: l, indent: indent), l], ""),
    started: true,
  })
  concat(folded.text, " */")
}

fn item_wire(item: SheetItem) -> String {
  match item {
    ItemBlank => ""
    ItemComment { lines: ls } => comment_wire(lines: ls, indent: 2)
    ItemDecls { decls: ds, alignment: a } => join(map(ds, d => decl_line(d: d, name_column: longest_name(decls: ds), alignment: a, indent: 2)), "\n")
    ItemDeclLine { decls: ds } => concat(repeat_string(s: " ", n: 2), join(map(ds, d => decl_text(d: d, name_column: 0, alignment: Compact)), " "))
  }
}

fn inline_item_wire(item: SheetItem) -> String {
  match item {
    ItemBlank => ""
    ItemComment { lines: ls } => comment_wire(lines: ls, indent: 0)
    ItemDecls { decls: ds, alignment: a } => join(map(ds, d => decl_text(d: d, name_column: longest_name(decls: ds), alignment: a)), " ")
    ItemDeclLine { decls: ds } => join(map(ds, d => decl_text(d: d, name_column: 0, alignment: Compact)), " ")
  }
}

fn rule_wire(selector: SelectorList, layout: RuleLayout, items: List<SheetItem>) -> String {
  match layout {
    RuleBlock => join([selector_list_wire(l: selector), " {\n", join(map(items, i => item_wire(item: i)), "\n"), "\n}\n"], "")
    RuleInline => join([selector_list_wire(l: selector), " { ", join(map(items, i => inline_item_wire(item: i)), " "), " }\n"], "")
  }
}

fn selector_width(r: AlignedRule) -> Int {
  0 + selector_list_wire(l: r.selector).length()
}

fn longest_selector(rules: List<AlignedRule>) -> Int {
  fold(rules, init: 0, f: (acc, r) => if selector_width(r: r) > acc { selector_width(r: r) } else { acc })
}

fn aligned_rule_wire(r: AlignedRule, column: Int) -> String {
  join([selector_list_wire(l: r.selector), repeat_string(s: " ", n: column + 1 - selector_width(r: r)), "{ ", join(map(r.decls, d => decl_text(d: d, name_column: 0, alignment: Compact)), " "), " }\n"], "")
}

fn entry_wire(e: SheetEntry) -> String {
  match e {
    EntryComment { lines: ls } => concat(comment_wire(lines: ls, indent: 0), "\n")
    EntryRule { selector: s, layout: l, items: is } => rule_wire(selector: s, layout: l, items: is)
    EntryAlignedRules { rules: rs } => join(map(rs, r => aligned_rule_wire(r: r, column: longest_selector(rules: rs))), "")
    EntryGap { blank_lines: n } => repeat_string(s: "\n", n: n)
  }
}

fn render_sheet() -> String {
  join(map(sheet_entries, e => entry_wire(e: e)), "")
}

type SheetWrite = SheetWritten { path: String } | SheetWriteRefused { reason: String }

fn sheet_write(dir: String) -> SheetWrite {
  let path = join([dir, "/", sheet_output_name], "")
  let wrote = Filesystem.Write(path: path, content: render_sheet())
  if wrote.success { SheetWritten { path: path } } else { SheetWriteRefused { reason: join(["write failed: ", path], "") } }
}

fn sheet_exit(run: SheetWrite) -> ProcessExit {
  match run {
    SheetWritten { path: _ } => ExitSuccess
    SheetWriteRefused { reason: r } => exit_failure(reason: join([page_render_refusal_prefix, r], ""))
  }
}

fn sheet_write_arg(dir: String) -> ProcessExit {
  sheet_exit(run: sheet_write(dir: dir))
}
