data later_sections: List<List<SheetEntry>> = [
  masthead_entries, text_roles_entries, hero_entries, prose_entries, measure_entries,
  carved_entries, command_entries, invariant_entries, role_entries, deck_entries,
  footer_entries, media_entries,
]

data sheet_entries: List<SheetEntry> = concat(concat(reset_base_entries, layout_entries), fold(later_sections, init: [], f: (acc, section) => concat(acc, concat([EntryGap { blank_lines: 2 }], section))))

fn value_wire(v: SheetValue) -> String {
  match v {
    ValueNumber { n: n } => to_string(n)
    ValuePercent { n: n } => join([to_string(n), "%"], "")
    ValueLength { length: l } => css_decimal_length_wire(l: l)
    ValueFonts { stack: s } => css_font_stack_wire(s: s, quote: DoubleQuote)
    ValueLiveColor { token: t } => css_hsl_wire(c: live_token_css(t: t))
    ValueExpr { value: x } => css_value_wire(v: x)
  }
}

fn decl_name_wire(d: SheetDecl) -> String {
  concat(css_property_wire(p: d.property), ":")
}

fn name_width(d: SheetDecl) -> Int {
  0 + decl_name_wire(d: d).length()
}

fn longest_name(decls: List<SheetDecl>) -> Int {
  fold(decls, init: 0, f: (acc, d) => if name_width(d: d) > acc { name_width(d: d) } else { acc })
}

// The value starts one space after the longest `--name:` of its group.
fn decl_pad(d: SheetDecl, name_column: Int, alignment: DeclAlignment) -> Int {
  match alignment {
    ColumnAligned => name_column + 1 - name_width(d: d)
    Compact => 1
  }
}

fn decl_text(d: SheetDecl, name_column: Int, alignment: DeclAlignment) -> String {
  join([decl_name_wire(d: d), repeat_string(s: " ", n: decl_pad(d: d, name_column: name_column, alignment: alignment)), value_wire(v: d.value), ";"], "")
}

fn decl_line(d: SheetDecl, name_column: Int, alignment: DeclAlignment, indent: Int) -> String {
  concat(repeat_string(s: " ", n: indent), decl_text(d: d, name_column: name_column, alignment: alignment))
}

type CommentAcc {
  text: String
  started: Bool
}

fn comment_line_prefix(acc: CommentAcc, line: String, indent: Int) -> String {
  if !acc.started {
    join([repeat_string(s: " ", n: indent), "/* "], "")
  } else if line == "" {
    "\n"
  } else {
    join(["\n", repeat_string(s: " ", n: indent + 3)], "")
  }
}

// First line opens `/* `; later lines are indented to sit under the first line's text (blank lines
// stay empty); the last line closes ` */`.
fn comment_wire(lines: List<String>, indent: Int) -> String {
  let folded = fold(lines, init: CommentAcc { text: "", started: false }, f: (acc, l) => CommentAcc {
    text: join([acc.text, comment_line_prefix(acc: acc, line: l, indent: indent), l], ""),
    started: true,
  })
  concat(folded.text, " */")
}

fn item_wire(item: SheetItem, indent: Int) -> String {
  match item {
    ItemBlank => ""
    ItemComment { lines: ls } => comment_wire(lines: ls, indent: indent)
    ItemDecls { decls: ds, alignment: a } => join(map(ds, d => decl_line(d: d, name_column: longest_name(decls: ds), alignment: a, indent: indent)), "\n")
    ItemDeclLine { decls: ds } => concat(repeat_string(s: " ", n: indent), join(map(ds, d => decl_text(d: d, name_column: 0, alignment: Compact)), " "))
  }
}

fn inline_item_wire(item: SheetItem) -> String {
  match item {
    ItemBlank => ""
    ItemComment { lines: ls } => comment_wire(lines: ls, indent: 0)
    ItemDecls { decls: ds, alignment: a } => join(map(ds, d => decl_text(d: d, name_column: longest_name(decls: ds), alignment: a)), " ")
    ItemDeclLine { decls: ds } => join(map(ds, d => decl_text(d: d, name_column: 0, alignment: Compact)), " ")
  }
}

fn stacked_selector_wire(l: SelectorList, indent: Int) -> String {
  join(map(l.selectors, c => complex_selector_wire(c: c)), concat(",\n", repeat_string(s: " ", n: indent)))
}

fn rule_wire(rule: SheetRule, indent: Int) -> String {
  let pad = repeat_string(s: " ", n: indent)
  match rule.layout {
    RuleBlock => join([pad, selector_list_wire(l: rule.selector), " {\n", join(map(rule.items, i => item_wire(item: i, indent: indent + 2)), "\n"), "\n", pad, "}\n"], "")
    RuleInline => join([pad, selector_list_wire(l: rule.selector), " { ", join(map(rule.items, i => inline_item_wire(item: i)), " "), " }\n"], "")
    RuleInlineStacked => join([pad, stacked_selector_wire(l: rule.selector, indent: indent), " { ", join(map(rule.items, i => inline_item_wire(item: i)), " "), " }\n"], "")
  }
}

fn media_wire(condition: MediaCondition, rules: List<SheetRule>) -> String {
  join(["@media ", media_condition_wire(c: condition), " {\n", join(map(rules, r => rule_wire(rule: r, indent: 2)), ""), "}\n"], "")
}

fn aligned_selector_wire(r: AlignedRule) -> String {
  match r.combinator {
    SingleSpaceCombinator => selector_list_wire(l: r.selector)
    DoubleSpaceCombinator => join(map(r.selector.selectors, c => join(map(c.compounds, k => compound_selector_wire(c: k)), "  ")), ", ")
  }
}

fn selector_width(r: AlignedRule) -> Int {
  0 + aligned_selector_wire(r: r).length()
}

fn longest_selector(rules: List<AlignedRule>) -> Int {
  fold(rules, init: 0, f: (acc, r) => if selector_width(r: r) > acc { selector_width(r: r) } else { acc })
}

type AlignedDeclsAcc {
  text: String
  index: Int
}

fn decl_gap_before(sep: DeclSeparator, index: Int) -> String {
  match sep {
    SingleSpace => if index == 0 { "" } else { " " }
    DoubleSpaceAfterFirst => if index == 0 { "" } else if index == 1 { "  " } else { " " }
  }
}

fn aligned_decls_wire(r: AlignedRule) -> String {
  let folded = fold(r.decls, init: AlignedDeclsAcc { text: "", index: 0 }, f: (acc, d) => AlignedDeclsAcc {
    text: join([acc.text, decl_gap_before(sep: r.separator, index: acc.index), decl_text(d: d, name_column: 0, alignment: Compact)], ""),
    index: acc.index + 1,
  })
  folded.text
}

fn aligned_rule_wire(r: AlignedRule, rules: List<AlignedRule>, spaces_after_longest: Int) -> String {
  join([aligned_selector_wire(r: r), repeat_string(s: " ", n: longest_selector(rules: rules) + spaces_after_longest - selector_width(r: r)), "{ ", aligned_decls_wire(r: r), " }\n"], "")
}

fn entry_wire(e: SheetEntry) -> String {
  match e {
    EntryComment { lines: ls } => concat(comment_wire(lines: ls, indent: 0), "\n")
    EntryRule { rule: r } => rule_wire(rule: r, indent: 0)
    EntryMedia { condition: c, rules: rs } => media_wire(condition: c, rules: rs)
    EntryAlignedRules { rules: rs, spaces_after_longest: g } => join(map(rs, r => aligned_rule_wire(r: r, rules: rs, spaces_after_longest: g)), "")
    EntryGap { blank_lines: n } => repeat_string(s: "\n", n: n)
  }
}

fn render_sheet() -> String {
  join(map(sheet_entries, e => entry_wire(e: e)), "")
}

type SheetWrite = SheetWritten { path: String } | SheetWriteRefused { reason: String }

fn sheet_write(dir: String) -> SheetWrite {
  let path = join([dir, "/", sheet_output_name], "")
  let wrote = Filesystem.Write(path: path, content: render_sheet())
  if wrote.success { SheetWritten { path: path } } else { SheetWriteRefused { reason: join(["write failed: ", path], "") } }
}

fn sheet_exit(run: SheetWrite) -> ProcessExit {
  match run {
    SheetWritten { path: _ } => ExitSuccess
    SheetWriteRefused { reason: r } => exit_failure(reason: join([page_render_refusal_prefix, r], ""))
  }
}

fn sheet_write_arg(dir: String) -> ProcessExit {
  sheet_exit(run: sheet_write(dir: dir))
}
