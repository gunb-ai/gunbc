module gunbc.site.gunb_ai_css

import std.types { String, Int, List, Bool }
import std.optional { Absent, Present }
import std.measure { degree_count, percent_count }
import std.process { ProcessExit, ExitSuccess, exit_failure }
import std.render_repeat_string_bootstrap { repeat_string }
import extdeps.filesystem.filesystem_io { Filesystem }
import gunbc.site.markup { page_render_refusal_prefix }
import extdeps.languages.css.values {
  CssLengthUnit, Px, Rem, Ch, CssDecimalLength, css_decimal_length_wire, css_hsl_wire,
  CssFontStack, CssFontFamily, NamedFamily, GenericFamily, GenericUiMonospace, GenericSystemUi, GenericSansSerif,
  GenericMonospace, css_font_stack_wire, DoubleQuote, CssVarRef,
}
import extdeps.languages.css.properties { CssPropertyName, CustomProperty, css_property_wire, BoxSizing, Background, Color, FontFamily, FontSize, LineHeight, WebkitFontSmoothing, ColorScheme, Margin }
import extdeps.languages.css.complex_selector {
  SelectorList, ComplexSelector, CompoundSelector, TypeSelector, SimpleSelector, UniversalType, ElementType, PseudoClassPart, PseudoElementPart,
  selector_list_wire, element_compound,
}
import extdeps.languages.css.expression {
  CssValue, ValIdent, ValNumber, ValLength, ValVar, css_value_wire,
}
import gunbc.design.gunb_ai_live_scale {
  LiveMeasure, live_measure_page, live_measure_wide, live_measure_prose, live_measure_title,
  live_gap_xs, live_gap_sm, live_gap_md, live_gap_lg, live_gap_xl, live_font_mono, live_font_sans,
}
import gunbc.design.gunb_ai_hues {
  HueDegrees, PercentParameter, LiveColorToken, live_token_border_dark, live_token_border_dark_strong, live_token_brass, live_token_brass_dim, live_token_brass_subtle, live_token_clay, live_token_clay_dim, live_token_clay_subtle, live_token_css, live_token_moss, live_token_moss_dim, live_token_moss_subtle, live_token_stone, live_token_stone_dim, live_token_stone_faint, live_token_void, live_token_void_up, live_token_void_up2, live_token_warm_white, live_token_warm_white_dim,
  live_hue_warm, live_hue_moss, live_hue_clay, live_hue_brass,
  live_accent_saturation, live_accent_lightness,
}

// gunb.ai's assets/site.css, built from typed rows. THIS SLICE: the file header, the :root token
// block and RESET + BASE; later slices append sections to sheet_entries until the whole served file is the render.
//
// THE FILE IS HAND-AUTHORED, SO ITS FORMATTING IS DATA TOO. A comment is content the served bytes
// carry, a blank-line run is a decision, and a declaration group is column-aligned. Alignment is not
// authored here: it is derived (value column = longest `--name:` in the group + 1 space), and the
// witness checks the derivation against the served file, so a group that does not fit the rule
// refuses instead of being padded by hand.
//
// COLOUR AUTHORITY. Every colour value is a gunbc.design.gunb_ai_hues row (live_color_tokens, the hue
// parameters, the accent percentages); this module only names which token a declaration shows and
// where. The measures, gaps and font stacks below are the stylesheet's own values (rem, not the px
// of gunbc.site.gunb_ai_tokens) and are listed in the PR as disagreements, not reconciled.
//
// Consumers (§3c): sheet_write_arg is the build route; test.claim.site_gunb_ai_css_witness executes
// render_sheet. Outside the claim runner:
//   gunbc run --source-root dag --entry dag/gunbc/site/gunb_ai_css.dag \
//     --function sheet_write_arg --arg dir=/tmp/gunbai/assets


data sheet_output_name: String = "site.css"

type SheetValue
  = ValueNumber { n: Int }
  | ValuePercent { n: Int }
  | ValueLiveColor { token: LiveColorToken }
  | ValueLength { length: CssDecimalLength }
  | ValueFonts { stack: CssFontStack }
  | ValueExpr { value: CssValue }

type SheetDecl {
  property: CssPropertyName
  value: SheetValue
}

// A group of declarations is either column-aligned (the :root token groups) or written with one space
// after the colon (the ordinary rules): the served sheet uses both, so the choice is data.
type DeclAlignment = ColumnAligned | Compact

type SheetItem
  = ItemComment { lines: List<String> }
  | ItemDecls { decls: List<SheetDecl>, alignment: DeclAlignment }
  | ItemBlank

// A rule is written either one declaration per line between braces or whole on one line.
type RuleLayout = RuleBlock | RuleInline

type SheetEntry
  = EntryComment { lines: List<String> }
  | EntryRule { selector: SelectorList, layout: RuleLayout, items: List<SheetItem> }
  | EntryGap { blank_lines: Int }

fn sheet_hue(hue: HueDegrees) -> SheetDecl {
  SheetDecl { property: CustomProperty { name: hue.name }, value: ValueNumber { n: 0 + degree_count(d: hue.degrees) } }
}

fn sheet_percentage(parameter: PercentParameter) -> SheetDecl {
  SheetDecl { property: CustomProperty { name: parameter.name }, value: ValuePercent { n: 0 + percent_count(p: parameter.percent) } }
}

fn sheet_live_color(token: LiveColorToken) -> SheetDecl {
  SheetDecl { property: CustomProperty { name: token.name }, value: ValueLiveColor { token: token } }
}

fn sheet_measure(m: LiveMeasure) -> SheetDecl {
  SheetDecl { property: CustomProperty { name: m.name }, value: ValueLength { length: m.length } }
}

fn sheet_fonts(name: String, stack: CssFontStack) -> SheetDecl {
  SheetDecl { property: CustomProperty { name: name }, value: ValueFonts { stack: stack } }
}

data header_comment: List<String> = ["════════════════════════════════════════════════════════════════════", "gunb.ai · canonical design system", "────────────────────────────────────────────────────────────────────", "Tokens, base typography, AND the shared primitive vocabulary.", "", "Every public page composes named primitives from this file.", "Pages should only add inline CSS for genuinely page-specific", "structure (e.g. workpad has dev chrome that doesn't belong in the", "public design system).", "══════════════════════════════════════════════════════════════════"]

data tokens_banner: List<String> = ["╔══ TOKENS ═════════════════════════════════════════════════════════"]

data tokens_items: List<SheetItem> = [
    ItemComment { lines: ["Hue and accent parameters — change once, propagate everywhere"] },
    ItemDecls { decls: [
      sheet_hue(hue: live_hue_warm),
      sheet_hue(hue: live_hue_moss),
      sheet_hue(hue: live_hue_clay),
      sheet_hue(hue: live_hue_brass),
    ], alignment: ColumnAligned },
    ItemDecls { decls: [
      sheet_percentage(parameter: live_accent_saturation),
    ], alignment: ColumnAligned },
    ItemDecls { decls: [
      sheet_percentage(parameter: live_accent_lightness),
    ], alignment: ColumnAligned },
    ItemBlank,
    ItemComment { lines: ["Accents — materials, not status signals.", "moss   = structural continuity / derived / held / re-derived", "clay   = boundary / removed / violated / no artifact emitted", "brass  = human edit focus / selected source fact (rare, narrow)"] },
    ItemDecls { decls: [
      sheet_live_color(token: live_token_moss),
      sheet_live_color(token: live_token_moss_dim),
      sheet_live_color(token: live_token_moss_subtle),
