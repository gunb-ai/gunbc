data hero_banner: List<String> = ["╔══ HERO — field-note split (left identity, right prose + install) ═"]

data layout_entries: List<SheetEntry> = [
  EntryComment { lines: layout_banner },
  EntryGap { blank_lines: 1 },
  block_rule(selector: class_list(name: "page"), items: [compact_decls(decls: [
    sheet_expr(property: Width, value: ValCall { function: FnMin, args: [
      ValCall { function: FnCalc, args: [sheet_space(items: [sheet_len(milli: 100000, unit: Percent), ValOperator { operator: OpSub }, sheet_rem(milli: 2000)])] },
      sheet_var(name: "measure-page"),
    ] }),
    sheet_expr(property: MarginInline, value: ValIdent { ident: "auto" }),
    sheet_expr(property: PaddingBlock, value: ValCall { function: FnClamp, args: [sheet_rem(milli: 2000), sheet_len(milli: 5000, unit: Vw), sheet_rem(milli: 4000)] }),
  ])]),
]

