  ComplexSelector { compounds: [class_with(name: "carved-rule", parts: [PseudoElementPart { name: "after" }])] },
] }

data carved_entries: List<SheetEntry> = [
  EntryComment { lines: carved_banner },
  EntryGap { blank_lines: 1 },
  block_rule(selector: class_list(name: "carved-rule"), items: [compact_decls(decls: [
    sheet_ident(property: Display, ident: "flex"),
    sheet_ident(property: AlignItems, ident: "center"),
    sheet_expr(property: Gap, value: sheet_rem(milli: 700)),
    sheet_expr(property: Width, value: sheet_len(milli: 100000, unit: Percent)),
    sheet_expr(property: Margin, value: sheet_space(items: [sheet_rem(milli: 2750), ValNumber { milli: 0 }])),
  ])]),
  block_rule(selector: carved_rule_pseudo_list, items: [
    ItemDeclLine { decls: [
      sheet_expr(property: Content, value: ValString { text: "" }),
