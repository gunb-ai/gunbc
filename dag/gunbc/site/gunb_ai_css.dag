data role_entries: List<SheetEntry> = [
  EntryComment { lines: roles_banner },
  EntryGap { blank_lines: 1 },
  EntryAlignedRules { spaces_after_longest: 1, rules: [
    colour_rule(name: "map-stable", colour: "warm-white"),
    colour_rule(name: "map-focus", colour: "brass"),
    colour_rule(name: "map-derived", colour: "moss"),
    colour_rule(name: "map-transitive", colour: "warm-white-dim"),
    colour_rule(name: "map-artifact", colour: "warm-white"),
    colour_rule(name: "map-removed", colour: "clay"),
    colour_rule(name: "map-boundary", colour: "clay"),
    colour_rule(name: "map-context", colour: "stone-dim"),
  ] },
]
data prose_banner: List<String> = ["╔══ PROSE — generic body paragraphs ══════════════════════════════"]
data measure_banner: List<String> = ["╔══ MEASURE WRAPPERS ═════════════════════════════════════════════", "Width is controlled by section CONTAINERS, not individual components.", "Wrap a section in one of these to clamp its children."]
data carved_banner: List<String> = ["╔══ CARVED RULE — section break with moss diamond notch ═════════", "No max-width: inherits from its container (the section's measure", "wrapper or .page). That keeps it aligned with whatever sits beside", "or below it."]
data command_banner: List<String> = ["╔══ COMMAND PANEL ═════════════════════════════════════════════════"]
data invariant_banner: List<String> = ["╔══ INVARIANT PANEL — clay only here ═════════════════════════════"]
data roles_banner: List<String> = ["╔══ ROLE TOKENS — shared between code spans and graph elements ═", "The visual-correspondence rule: every colored code token has a", "same-colored graph object, and vice versa.", "", "Taxonomy (one color per structural meaning):", "  stable      ordinary structure                    warm-white", "  focus       the source fact this card pivots on   brass", "  derived     directly downstream / 1-2 hops        moss", "  transitive  multi-hop downstream (distant kin)    moss-dim", "  artifact    terminal generated slot               warm-white", "  removed     diff removal                          clay", "  boundary    violation / no artifact emitted       clay", "  context     ambient text without a role           stone", "", "stable and artifact share warm-white intentionally: they are the", "bookends of the system (source root and target slot). The cut-", "corner pentagon shape carries the artifact distinction."]

data deck_comment_0: List<String> = ["╔══ STORY DECK — one progressive example, four accreting stages ═══", "Rendered by assets/cards.js. Each stage shares the same base graph;", "the visual story builds up layer by layer (lasso, dots, artifacts).", "Navigate via prev/next buttons or ← / → keys."]
data deck_comment_1: List<String> = ["Vertical stack: code and graph each get the full card width. The", "richer system (with the Sessions parallel domain) makes the graph", "wider than the code pane can accommodate when split 50/50; the", "stacked layout keeps the SVG text readable."]
data deck_comment_2: List<String> = ["Code pane — no horizontal scroll. If a line would overflow it", "gets clipped at the panel edge; specs must keep lines short."]
data deck_comment_3: List<String> = ["Graph pane — SVG fills available width, capped at a reasonable", "max-height so a tall viewBox does not push card height to absurd."]
data deck_comment_4: List<String> = ["Nodes are filled with the card-graph background so edges", "underneath are masked at crossings."]
data deck_comment_5: List<String> = ["Artifact (cut-corner) — warm-white so artifacts read as the", "system's terminal bookends, distinct from moss derived nodes.", "Shape and color both carry the structural distinction.", "For artifacts that are present in the model but NOT in this card's", "affected set (e.g. parallel-domain outputs in card 02), apply the", "context role so they render as grey pentagons."]
data deck_comment_6: List<String> = ["Default stroke = stone so an edge with no matching role rule", "is still visible (defensive: failing visibly beats failing silent)."]
data deck_comment_7: List<String> = ["Cost-area cells — per-cell coloring so a single panel can hold both", "budget and overage. Bottom-aligned panels with the budget row at the", "same Y in both: declared (1×n, all budget) sits as the bottom row", "of the observed grid (n×n, with the n-1 rows above as overage).", "The visual claim: observed extends UP past the declared ceiling."]
data deck_comment_8: List<String> = ["Receipt — structured label/value rows.", "The receipt is the card's stamp, not a prose recap. Each row pairs", "a small mono key (stone-faint) with a colored value carried by the", "\{role:text} token system. Card 03's receipt also embeds a code", "block (the suggested replacement shape) — the \"diagnostic\" is just", "another row of the receipt, not a separate panel."]
data deck_comment_9: List<String> = ["Nav (prev/next buttons)"]
data deck_comment_10: List<String> = ["Lasso (dashed moss polygon) and dot markers for accreted layers"]
