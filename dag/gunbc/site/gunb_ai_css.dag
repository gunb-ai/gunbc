      sheet_expr(property: Margin, value: ValNumber { milli: 0 }),
      sheet_expr(property: MaxWidth, value: sheet_len(milli: 24000, unit: Em)),
    ]),
  ]),
  block_rule(selector: class_list(name: "hero-right"), items: [compact_decls(decls: [
    sheet_expr(property: MaxWidth, value: sheet_var(name: "measure-prose")),
    sheet_expr(property: PaddingTop, value: sheet_rem(milli: 350)),
    sheet_ident(property: Display, ident: "grid"),
    sheet_expr(property: Gap, value: sheet_rem(milli: 1150)),
  ])]),
  block_rule(selector: descendant_list(ancestor: class_compound(name: "hero-right"), descendant: element_compound(tag: "p")), items: [compact_decls(decls: [
    sheet_expr(property: Margin, value: ValNumber { milli: 0 }),
    sheet_expr(property: LineHeight, value: ValNumber { milli: 1700 }),
    sheet_expr(property: Color, value: sheet_var(name: "warm-white-dim")),
  ])]),
  inline_rule(
    selector: descendant_list(ancestor: class_compound(name: "hero-right"), descendant: element_compound(tag: "strong")),
    decls: [sheet_expr(property: Color, value: sheet_var(name: "warm-white")), sheet_expr(property: FontWeight, value: ValNumber { milli: 500000 })],
  ),
  block_rule(selector: descendant_list(ancestor: class_compound(name: "hero-right"), descendant: element_compound(tag: "code")), items: [
    ItemDeclLine { decls: [font_mono_decl, sheet_expr(property: FontSize, value: sheet_len(milli: 880, unit: Em))] },
    compact_decls(decls: [sheet_expr(property: Color, value: sheet_var(name: "warm-white"))]),
  ]),
  inline_rule(
    selector: descendant_list(ancestor: class_compound(name: "hero-right"), descendant: class_compound(name: "install")),
    decls: [sheet_expr(property: MarginTop, value: sheet_rem(milli: 350))],
  ),
]

fn sheet_px(milli: Int) -> CssValue {
  sheet_len(milli: milli, unit: Px)
}

fn sheet_border(property: CssPropertyName, colour: String) -> SheetDecl {
  sheet_expr(property: property, value: sheet_space(items: [sheet_px(milli: 1000), ValIdent { ident: "solid" }, sheet_var(name: colour)]))
}

fn element_with(tag: String, parts: List<SimpleSelector>) -> CompoundSelector {
  CompoundSelector { type_selector: Present { value: ElementType { tag: tag } }, parts: parts }
}

fn class_with(name: String, parts: List<SimpleSelector>) -> CompoundSelector {
  CompoundSelector { type_selector: Absent, parts: concat([ClassPart { name: name }], parts) }
}

fn class_descendant(ancestor: String, descendant: String) -> SelectorList {
  descendant_list(ancestor: class_compound(name: ancestor), descendant: class_compound(name: descendant))
}

fn class_element(ancestor: String, tag: String) -> SelectorList {
  descendant_list(ancestor: class_compound(name: ancestor), descendant: element_compound(tag: tag))
}

fn colour_rule(name: String, colour: String) -> AlignedRule {
  AlignedRule { selector: class_list(name: name), decls: [sheet_expr(property: Color, value: sheet_var(name: colour))], separator: SingleSpace, combinator: SingleSpaceCombinator }
}

data prose_entries: List<SheetEntry> = [
  EntryComment { lines: prose_banner },
  EntryGap { blank_lines: 1 },
  inline_rule(selector: class_list(name: "prose"), decls: [sheet_expr(property: MaxWidth, value: sheet_var(name: "measure-prose")), sheet_expr(property: Margin, value: ValNumber { milli: 0 })]),
  block_rule(selector: class_element(ancestor: "prose", tag: "p"), items: [compact_decls(decls: [
    sheet_expr(property: Margin, value: sheet_space(items: [ValNumber { milli: 0 }, ValNumber { milli: 0 }, sheet_rem(milli: 1050)])),
    sheet_expr(property: LineHeight, value: ValNumber { milli: 1700 }),
    sheet_expr(property: Color, value: sheet_var(name: "warm-white-dim")),
  ])]),
  inline_rule(
    selector: descendant_list(ancestor: class_compound(name: "prose"), descendant: element_with(tag: "p", parts: [PseudoClassPart { name: "last-child" }])),
    decls: [sheet_expr(property: MarginBottom, value: ValNumber { milli: 0 })],
  ),
  inline_rule(
    selector: class_element(ancestor: "prose", tag: "strong"),
    decls: [sheet_expr(property: Color, value: sheet_var(name: "warm-white")), sheet_expr(property: FontWeight, value: ValNumber { milli: 500000 })],
  ),
  block_rule(selector: class_element(ancestor: "prose", tag: "code"), items: [
    ItemDeclLine { decls: [font_mono_decl, sheet_expr(property: FontSize, value: sheet_len(milli: 880, unit: Em))] },
    compact_decls(decls: [sheet_expr(property: Color, value: sheet_var(name: "warm-white"))]),
  ]),
]

data measure_entries: List<SheetEntry> = [
  EntryComment { lines: measure_banner },
  EntryGap { blank_lines: 1 },
  EntryAlignedRules { spaces_after_longest: 1, rules: [
    AlignedRule { selector: class_list(name: "measure-prose"), decls: [sheet_expr(property: MaxWidth, value: sheet_var(name: "measure-prose"))], separator: SingleSpace, combinator: SingleSpaceCombinator },
    AlignedRule { selector: class_list(name: "measure-page"), decls: [sheet_expr(property: MaxWidth, value: sheet_var(name: "measure-page"))], separator: SingleSpace, combinator: SingleSpaceCombinator },
    AlignedRule { selector: class_list(name: "measure-wide"), decls: [sheet_expr(property: MaxWidth, value: sheet_var(name: "measure-wide"))], separator: SingleSpace, combinator: SingleSpaceCombinator },
  ] },
]

data carved_rule_pseudo_list: SelectorList = SelectorList { selectors: [
  ComplexSelector { compounds: [class_with(name: "carved-rule", parts: [PseudoElementPart { name: "before" }])] },
  ComplexSelector { compounds: [class_with(name: "carved-rule", parts: [PseudoElementPart { name: "after" }])] },
] }

data carved_entries: List<SheetEntry> = [
  EntryComment { lines: carved_banner },
  EntryGap { blank_lines: 1 },
  block_rule(selector: class_list(name: "carved-rule"), items: [
    ItemDeclLine { decls: [
      sheet_ident(property: Display, ident: "flex"),
