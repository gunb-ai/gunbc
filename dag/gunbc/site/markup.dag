module gunbc.site.markup


fn txt(s: String) -> std.markup.Fragment {
  std.markup.FragmentText { content: s }
}

fn el(tag: String, children: List<std.markup.Fragment>) -> std.markup.Fragment {
  std.markup.Element { tag: tag, attributes: [], children: children }
}

fn el_class(tag: String, cls: String, children: List<std.markup.Fragment>) -> std.markup.Fragment {
  std.markup.Element {
    tag: tag,
    attributes: [ std.markup.attr(name: "class", value: cls ) ],
    children: children,
  }
}

fn el_attrs(tag: String, attributes: List<std.markup.Attribute>, children: List<std.markup.Fragment>) -> std.markup.Fragment {
  std.markup.Element { tag: tag, attributes: attributes, children: children }
}
