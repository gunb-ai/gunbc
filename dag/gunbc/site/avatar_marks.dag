module gunbc.site.avatar_marks

import std.types { String, Bool }
import std.markup { Fragment, Element, attr }
import std.optional { Absent }
import gunbc.design.brand_mark { BrandMark, RobotMark, Stencil, UnderpaintedStencil, brand_mark, brand_mark_figure }

// Missing-picture treatments compose the robot mark without changing its geometry; each figure is
// the mark's 1200-tenth frame, so a placement's scale is a tenth of the 120-unit figure's.
// The host supplies the neutral circular background and foreground through its theme.
// Opaque surface underpaint keeps faces legible and prevents rear figures showing
// through the front figure. Border paint is too close to ink in the night theme.
data avatar_robot: BrandMark = brand_mark(kind: RobotMark)

// THE UNKNOWN-PROFILE AVATAR'S ADAPTATION: the robot without its antenna, so the question mark
// can stand where the antenna would be.
data avatar_robot_without_antenna: BrandMark = BrandMark {
  shell: avatar_robot.shell,
  left_eye: avatar_robot.left_eye,
  right_eye: avatar_robot.right_eye,
  mouth: avatar_robot.mouth,
  antenna: Absent,
}

fn avatar_robot_face(mark: BrandMark, opaque: Bool = false) -> Fragment {
  Element { tag: "g", attributes: [], children: brand_mark_figure(mark: mark, treatment: if opaque { UnderpaintedStencil { underpaint: "var(--surface)" } } else { Stencil }) }
}

fn unknown_avatar_svg(class_name: String, label: String) -> Fragment {
  Element { tag: "svg", attributes: [attr(name: "class", value: class_name), attr(name: "viewBox", value: "0 0 64 64"), attr(name: "role", value: "img"), attr(name: "aria-label", value: label)], children: [
    Element { tag: "g", attributes: [attr(name: "transform", value: "translate(11 20) scale(.035)")], children: [avatar_robot_face(mark: avatar_robot_without_antenna)] },
    Element { tag: "g", attributes: [attr(name: "transform", value: "rotate(-10 33 13)")], children: [
      Element { tag: "path", attributes: [attr(name: "d", value: "M28 10 C28 4 39 4 39 10 C39 14 33 14 33 18"), attr(name: "fill", value: "none"), attr(name: "stroke", value: "currentColor"), attr(name: "stroke-width", value: "3.4"), attr(name: "stroke-linecap", value: "round")], children: [] },
      Element { tag: "circle", attributes: [attr(name: "cx", value: "33"), attr(name: "cy", value: "22"), attr(name: "r", value: "1.8"), attr(name: "fill", value: "currentColor")], children: [] },
    ] },
  ] }
}

// 2026-10-03 owner follow-up: opaque huddle faces must remain readable in both
// themes. Each figure uses theme ink over solid surface paint, not dark border ink.
fn group_avatar_svg(class_name: String, label: String) -> Fragment {
  Element { tag: "svg", attributes: [attr(name: "class", value: class_name), attr(name: "viewBox", value: "0 0 64 64"), attr(name: "role", value: "img"), attr(name: "aria-label", value: label)], children: [
    Element { tag: "g", attributes: [attr(name: "transform", value: "translate(3 14) rotate(-10 17 17) scale(.028)"), attr(name: "color", value: "color-mix(in srgb, currentColor 72%, var(--surface))")], children: [avatar_robot_face(mark: avatar_robot, opaque: true)] },
    Element { tag: "g", attributes: [attr(name: "transform", value: "translate(28 14) rotate(10 17 17) scale(.028)"), attr(name: "color", value: "color-mix(in srgb, currentColor 86%, var(--surface))")], children: [avatar_robot_face(mark: avatar_robot, opaque: true)] },
    Element { tag: "g", attributes: [attr(name: "transform", value: "translate(15 30) scale(.029)")], children: [avatar_robot_face(mark: avatar_robot, opaque: true)] },
  ] }
}

// No assignee is a distinct state from an assigned identity whose profile is unknown.
fn unassigned_avatar() -> Fragment {
  Element { tag: "span", attributes: [attr(name: "class", value: "site-avatar site-avatar-unassigned"), attr(name: "data-avatar", value: "unassigned"), attr(name: "title", value: "Choose an assignee")], children: [
    Element { tag: "svg", attributes: [attr(name: "class", value: "site-avatar-default-mark"), attr(name: "viewBox", value: "0 0 24 24"), attr(name: "role", value: "img"), attr(name: "aria-label", value: "Unassigned")], children: [
      Element { tag: "circle", attributes: [attr(name: "cx", value: "12"), attr(name: "cy", value: "12"), attr(name: "r", value: "8"), attr(name: "fill", value: "none"), attr(name: "stroke", value: "currentColor"), attr(name: "stroke-width", value: "1.5")], children: [] },
      Element { tag: "path", attributes: [attr(name: "d", value: "M10 9.5 C10 7.2 14 7.2 14 9.5 C14 11 12 11 12 13"), attr(name: "fill", value: "none"), attr(name: "stroke", value: "currentColor"), attr(name: "stroke-width", value: "1.5"), attr(name: "stroke-linecap", value: "round")], children: [] },
      Element { tag: "circle", attributes: [attr(name: "cx", value: "12"), attr(name: "cy", value: "15.5"), attr(name: "r", value: ".8"), attr(name: "fill", value: "currentColor")], children: [] },
    ] },
  ] }
}
