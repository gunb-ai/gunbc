module gunbc.site.web_fonts

import std.types { Int, String, List, NonEmptyStr }
import std.content_hash { content_hash_atom }
import extdeps.uri { Uri, Data }
import extdeps.http.server { font_woff2, media_type_wire_label }
import extdeps.fonts.google_fonts { GoogleFontsFamilySource, roboto_source, google_sans_source }
import extdeps.languages.css.font_face {
  FontFaceRule, FontFaceSource, FontStyleNormal, FontDisplaySwap, FontFormatWoff2, font_face_rules_wire,
}

// Ruling R2 (element spec 2026-10-04, revised 5c): Roboto 400/500/700 and Google Sans 400/500,
// served from our origin, no request to Google. Option B of the font-delivery decision
// (2026-10-05): no byte-body capability is added to the seed's `gunbc serve`, so the faces reach
// the browser as data: URLs inside ONE content-addressed text/css stylesheet.
//
// THE FACES ARE THIS REPOSITORY'S DERIVED ARTIFACTS, not upstream facts, so they live here with
// their consumer and cite their upstream source row (extdeps.fonts.google_fonts). Each face was
// derived from its pinned variable source with fontTools at the recorded version, under
// SOURCE_DATE_EPOCH set to the pinned commit's time so the bytes are reproducible (two independent
// runs produced identical digests), by these two commands per face:
//   fonttools varLib.instancer <source_path> <tag>=<value> for each axis pin --static -o face.ttf
//   pyftsubset face.ttf --unicodes=<unicode ranges, comma-joined> <subset flags> --output-file=face.woff2
// The unicode ranges are Basic Latin, Latin-1, and the punctuation and symbols the frontend's
// strings use (dashes, quotes, bullet, ellipsis, angle quotes, arrow, check mark).
//
// WHY THE BYTES LIVE HERE AS BASE64 DATA AND NOT IN A COMMITTED FILE READ AT SERVE TIME: a face row
// then carries its own bytes beside its digest and size, so there is ONE authority for a face and no
// second artifact whose content could drift from its row; the stylesheet and its content-addressed
// path are pure functions of these rows, so every page head can derive the link without a file
// read, and the route has no read-refusal arm to model. The base64 is RFC 4648 standard alphabet
// with padding, and test.claim.web_fonts_witness_test decodes it through std.encoding and checks
// the recorded size and SHA-256.

type FontAxisPin {
  tag: String
  value: Int
}

type WebFontDerivation {
  tool: String
  source_date_epoch: Int
  unicode_ranges: List<String>
  subset_flags: List<String>
}

data web_font_derivation: WebFontDerivation = WebFontDerivation {
  tool: "fonttools 4.66.1 with brotli (python 3.12.3)",
  source_date_epoch: 1791223235,
  unicode_ranges: ["U+0020-007E", "U+00A0-00FF", "U+2013-2014", "U+2018-201A", "U+201C-201E", "U+2022", "U+2026", "U+2039-203A", "U+2192", "U+2713"],
  subset_flags: ["--name-IDs=*", "--name-languages=*", "--flavor=woff2"],
}

type WebFontFace {
  source: GoogleFontsFamilySource
  weight: Int
  axis_pins: List<FontAxisPin>
  woff2_sha256: String
  woff2_byte_size: Int
  woff2_base64: String
}

data web_font_roboto_400: WebFontFace = WebFontFace {
  source: roboto_source,
  weight: 400,
  axis_pins: [FontAxisPin { tag: "wght", value: 400 }, FontAxisPin { tag: "wdth", value: 100 }],
  woff2_sha256: "309bb930fa5686b18794eb4e2f31299ff71cbda98f468dab710c0dc2dc3d49a3",
  woff2_byte_size: 16816,
  woff2_base64: "",
}

data web_font_roboto_500: WebFontFace = WebFontFace {
  source: roboto_source,
  weight: 500,
  axis_pins: [FontAxisPin { tag: "wght", value: 500 }, FontAxisPin { tag: "wdth", value: 100 }],
  woff2_sha256: "8707431a188e2bf388dd028f4f3295b79f41e878a243a2cc8640a3f395bc6810",
  woff2_byte_size: 17064,
  woff2_base64: "",
}

data web_font_roboto_700: WebFontFace = WebFontFace {
  source: roboto_source,
  weight: 700,
  axis_pins: [FontAxisPin { tag: "wght", value: 700 }, FontAxisPin { tag: "wdth", value: 100 }],
  woff2_sha256: "e4f3f1a2420b8bf1100185f84eefd8ad031ed2cc6b569ef7058506c1499b8259",
  woff2_byte_size: 17188,
  woff2_base64: "",
}

data web_font_google_sans_400: WebFontFace = WebFontFace {
  source: google_sans_source,
  weight: 400,
  axis_pins: [FontAxisPin { tag: "wght", value: 400 }, FontAxisPin { tag: "opsz", value: 18 }, FontAxisPin { tag: "GRAD", value: 0 }],
  woff2_sha256: "99475b90eac6d46fdaf740ab58d486fd1948173cca4a68e24f4e8961b9aaf8d2",
  woff2_byte_size: 16680,
  woff2_base64: "",
}

data web_font_google_sans_500: WebFontFace = WebFontFace {
  source: google_sans_source,
  weight: 500,
  axis_pins: [FontAxisPin { tag: "wght", value: 500 }, FontAxisPin { tag: "opsz", value: 18 }, FontAxisPin { tag: "GRAD", value: 0 }],
  woff2_sha256: "a465441181073e87c3d968b4bc08b06f6f30089789537a67282550d33084c12c",
  woff2_byte_size: 17836,
  woff2_base64: "",
}

data web_font_faces: List<WebFontFace> = [
  web_font_roboto_400, web_font_roboto_500, web_font_roboto_700,
  web_font_google_sans_400, web_font_google_sans_500,
]

fn web_font_face_rule(face: WebFontFace) -> FontFaceRule {
  FontFaceRule {
    family: face.source.family,
    weight: face.weight,
    style: FontStyleNormal,
    display: FontDisplaySwap,
    source: FontFaceSource {
      url: Uri { scheme: Data, locator: join([media_type_wire_label(m: font_woff2), ";base64,", face.woff2_base64], "") as NonEmptyStr },
      format: FontFormatWoff2,
    },
  }
}

fn web_font_stylesheet_over(faces: List<WebFontFace>) -> String {
  font_face_rules_wire(rules: map(faces, f => web_font_face_rule(face: f)))
}

// Content-addressed: the path carries the structural content hash of the stylesheet the route
// serves, so a change to any face row that reaches the wire changes the URL, and the immutable
// cache header on the route is true of every URL it is ever served under.
fn web_font_stylesheet_path_over(faces: List<WebFontFace>) -> String {
  let digest = content_hash_atom(value: web_font_stylesheet_over(faces: faces) as NonEmptyStr).digest as String
  join(["/assets/fonts-", digest, ".css"], "")
}

fn web_font_stylesheet() -> String {
  web_font_stylesheet_over(faces: web_font_faces)
}

fn web_font_stylesheet_path() -> String {
  web_font_stylesheet_path_over(faces: web_font_faces)
}

// One year, the conventional ceiling for an immutable, content-addressed asset (RFC 8246).
data web_font_stylesheet_max_age_seconds: Int = 31536000
