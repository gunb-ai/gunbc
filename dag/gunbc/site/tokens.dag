module gunbc.site.tokens

data tokens_note: String = "Layer 2 of the site stack: materials, themes, scales. Three register laws live here as CONSTRUCTION. ChromaByArea: a Material carries its AreaClass; saturation ceilings are per-area. GlareEnvelope (operator seventh pass, 2026-07-20: the bright saturated cyan read as low-taste gamer blue): a material may be bright OR chromatic, never both — quiet_envelope refuses sat>45 AND light>68 together, so the gamer register is inadmissible by row. ThemeCoherence: a Theme is a TOTAL assignment of roles to materials (theme_gaps countable, mirrors interaction coverage), each material's area class must equal the role's declared area class, and every color the page uses routes through a role var — one rule set, N themes; prefers-color-scheme selects, never forks. StillUntilTouched: MotionTrigger has no ambient variant; no animation/keyframes constructor exists."

type AreaClass
  = PointArea
  | HairlineArea
  | TextArea
  | FieldArea

type Material {
  name: String
  hue: Int
  sat_pct: Int
  light_pct: Int
  area: AreaClass
}

fn area_max_sat(area: AreaClass) -> Int {
  match area {
    PointArea => 100
    HairlineArea => 80
    TextArea => 25
    FieldArea => 40
  }
}

fn area_key(area: AreaClass) -> String {
  match area {
    PointArea => "point"
    HairlineArea => "hairline"
    TextArea => "text"
    FieldArea => "field"
  }
}

fn quiet_envelope(m: Material) -> Bool {
  !(m.sat_pct > 45 && m.light_pct > 68)
}

fn chroma_admissible(m: Material) -> Bool {
  m.sat_pct <= area_max_sat(area: m.area)
    && m.sat_pct >= 0
    && m.light_pct >= 0
    && m.light_pct <= 100
    && quiet_envelope(m: m)
}

fn paint(m: Material) -> String {
  join(["hsl(", to_string(m.hue), " ", to_string(m.sat_pct), "% ", to_string(m.light_pct), "%)"], "")
}

fn paint_alpha(m: Material, alpha_pct: Int) -> String {
  join([
    "hsl(", to_string(m.hue), " ", to_string(m.sat_pct), "% ", to_string(m.light_pct),
    "% / ", to_string(alpha_pct), "%)",
  ], "")
}

type ThemeRole
  = CanvasRole
  | SurfaceRole
  | BorderRole
  | TextRole
  | TextDimRole
  | FigureRole
  | FigureLitRole
  | FigureHaloRole
  | FigureEdgeRole
  | FocusRole
  | BoundaryRole

data theme_roles: List<ThemeRole> = [
  CanvasRole, SurfaceRole, BorderRole, TextRole, TextDimRole,
  FigureRole, FigureLitRole, FigureHaloRole, FigureEdgeRole,
  FocusRole, BoundaryRole,
]

fn role_key(r: ThemeRole) -> String {
  match r {
    CanvasRole => "canvas"
    SurfaceRole => "surface"
    BorderRole => "border"
    TextRole => "text"
    TextDimRole => "text-dim"
    FigureRole => "figure"
    FigureLitRole => "figure-lit"
    FigureHaloRole => "figure-halo"
    FigureEdgeRole => "figure-edge"
    FocusRole => "focus"
    BoundaryRole => "boundary"
  }
}

fn role_area(r: ThemeRole) -> AreaClass {
  match r {
    CanvasRole => FieldArea
    SurfaceRole => FieldArea
    BorderRole => HairlineArea
    TextRole => TextArea
    TextDimRole => TextArea
    FigureRole => PointArea
    FigureLitRole => PointArea
    FigureHaloRole => PointArea
    FigureEdgeRole => HairlineArea
    FocusRole => PointArea
    BoundaryRole => HairlineArea
  }
}

fn role_var(r: ThemeRole) -> String {
  join(["var(--", role_key(r: r), ")"], "")
}

type RoleAssignment {
  role: ThemeRole
  material: Material
  alpha_pct: Int
}

type Theme {
  name: String
  scheme: String
  assignments: List<RoleAssignment>
}

fn assign(role: ThemeRole, material: Material) -> RoleAssignment {
  RoleAssignment { role: role, material: material, alpha_pct: 100 }
}

fn assign_alpha(role: ThemeRole, material: Material, alpha_pct: Int) -> RoleAssignment {
  RoleAssignment { role: role, material: material, alpha_pct: alpha_pct }
}

data night_canvas: Material = Material { name: "night-canvas", hue: 226, sat_pct: 30, light_pct: 7, area: FieldArea }
data night_surface: Material = Material { name: "night-surface", hue: 226, sat_pct: 24, light_pct: 10, area: FieldArea }
data night_border: Material = Material { name: "night-border", hue: 224, sat_pct: 18, light_pct: 32, area: HairlineArea }
data night_text: Material = Material { name: "night-text", hue: 35, sat_pct: 14, light_pct: 78, area: TextArea }
data night_text_dim: Material = Material { name: "night-text-dim", hue: 35, sat_pct: 9, light_pct: 55, area: TextArea }
data warm_starlight: Material = Material { name: "warm-starlight", hue: 45, sat_pct: 26, light_pct: 87, area: PointArea }
data warm_starlight_lit: Material = Material { name: "warm-starlight-lit", hue: 45, sat_pct: 34, light_pct: 96, area: PointArea }
data starlight_edge: Material = Material { name: "starlight-edge", hue: 45, sat_pct: 14, light_pct: 64, area: HairlineArea }
data night_brass: Material = Material { name: "night-brass", hue: 42, sat_pct: 48, light_pct: 62, area: PointArea }
data night_clay: Material = Material { name: "night-clay", hue: 8, sat_pct: 52, light_pct: 56, area: HairlineArea }

data day_canvas: Material = Material { name: "day-canvas", hue: 40, sat_pct: 32, light_pct: 95, area: FieldArea }
data day_surface: Material = Material { name: "day-surface", hue: 40, sat_pct: 28, light_pct: 91, area: FieldArea }
data day_border: Material = Material { name: "day-border", hue: 40, sat_pct: 12, light_pct: 45, area: HairlineArea }
data day_ink: Material = Material { name: "day-ink", hue: 230, sat_pct: 14, light_pct: 22, area: TextArea }
data day_ink_dim: Material = Material { name: "day-ink-dim", hue: 230, sat_pct: 8, light_pct: 42, area: TextArea }
data ink_star: Material = Material { name: "ink-star", hue: 226, sat_pct: 44, light_pct: 30, area: PointArea }
data ink_star_lit: Material = Material { name: "ink-star-lit", hue: 226, sat_pct: 58, light_pct: 20, area: PointArea }
data ink_edge: Material = Material { name: "ink-edge", hue: 226, sat_pct: 22, light_pct: 45, area: HairlineArea }
data day_brass: Material = Material { name: "day-brass", hue: 42, sat_pct: 52, light_pct: 38, area: PointArea }
data day_clay: Material = Material { name: "day-clay", hue: 8, sat_pct: 56, light_pct: 44, area: HairlineArea }

data night_theme: Theme = Theme { name: "night", scheme: "dark", assignments: [
  assign(role: CanvasRole, material: night_canvas),
  assign(role: SurfaceRole, material: night_surface),
  assign_alpha(role: BorderRole, material: night_border, alpha_pct: 45),
  assign(role: TextRole, material: night_text),
  assign(role: TextDimRole, material: night_text_dim),
  assign(role: FigureRole, material: warm_starlight),
  assign(role: FigureLitRole, material: warm_starlight_lit),
  assign_alpha(role: FigureHaloRole, material: warm_starlight, alpha_pct: 14),
  assign_alpha(role: FigureEdgeRole, material: starlight_edge, alpha_pct: 50),
  assign(role: FocusRole, material: night_brass),
  assign(role: BoundaryRole, material: night_clay),
] }

data day_theme: Theme = Theme { name: "day", scheme: "light", assignments: [
  assign(role: CanvasRole, material: day_canvas),
  assign(role: SurfaceRole, material: day_surface),
  assign_alpha(role: BorderRole, material: day_border, alpha_pct: 45),
  assign(role: TextRole, material: day_ink),
  assign(role: TextDimRole, material: day_ink_dim),
  assign(role: FigureRole, material: ink_star),
  assign(role: FigureLitRole, material: ink_star_lit),
  assign_alpha(role: FigureHaloRole, material: ink_star, alpha_pct: 12),
  assign_alpha(role: FigureEdgeRole, material: ink_edge, alpha_pct: 45),
  assign(role: FocusRole, material: day_brass),
  assign(role: BoundaryRole, material: day_clay),
] }

data site_themes: List<Theme> = [night_theme, day_theme]

fn role_eq(a: ThemeRole, b: ThemeRole) -> Bool {
  role_key(r: a) == role_key(r: b)
}

fn theme_has_role(t: Theme, r: ThemeRole) -> Bool {
  fold(t.assignments, init: false, f: (acc, a) => acc || role_eq(a: a.role, b: r))
}

fn theme_gaps(t: Theme, roles: List<ThemeRole>) -> List<ThemeRole> {
  fold(roles, init: [], f: (acc, r) =>
    if theme_has_role(t: t, r: r) { acc } else { concat(acc, [r]) })
}

fn theme_total(t: Theme, roles: List<ThemeRole>) -> Bool {
  theme_gaps(t: t, roles: roles).length() == 0
}

fn theme_area_coherent(t: Theme) -> Bool {
  all(t.assignments, a =>
    area_key(area: a.material.area) == area_key(area: role_area(r: a.role)))
}

fn theme_materials_admissible(t: Theme) -> Bool {
  all(t.assignments, a => chroma_admissible(m: a.material))
}

fn assignment_lightness(t: Theme, r: ThemeRole) -> Int {
  fold(t.assignments, init: 0, f: (acc, a) =>
    if role_eq(a: a.role, b: r) { a.material.light_pct } else { acc })
}

fn lightness_gap(a: Int, b: Int) -> Int {
  if a > b { a - b } else { b - a }
}

fn theme_contrast_ok(t: Theme) -> Bool {
  lightness_gap(a: assignment_lightness(t: t, r: TextRole), b: assignment_lightness(t: t, r: CanvasRole)) >= 40
    && lightness_gap(a: assignment_lightness(t: t, r: FigureRole), b: assignment_lightness(t: t, r: CanvasRole)) >= 20
}

fn theme_coherent(t: Theme, roles: List<ThemeRole>) -> Bool {
  theme_total(t: t, roles: roles)
    && theme_area_coherent(t: t)
    && theme_materials_admissible(t: t)
    && theme_contrast_ok(t: t)
}

fn themes_coherent(themes: List<Theme>, roles: List<ThemeRole>) -> Bool {
  themes.length() > 0 && all(themes, t => theme_coherent(t: t, roles: roles))
}

fn assignment_paint(a: RoleAssignment) -> String {
  if a.alpha_pct >= 100 {
    paint(m: a.material)
  } else {
    paint_alpha(m: a.material, alpha_pct: a.alpha_pct)
  }
}

type TimingToken {
  name: String
  duration_ms: Int
  easing: String
}

data respond_fast: TimingToken = TimingToken { name: "respond", duration_ms: 90, easing: "ease-out" }

data reveal_deliberate: TimingToken = TimingToken { name: "reveal", duration_ms: 160, easing: "ease-out" }

data restore_gentle: TimingToken = TimingToken { name: "restore", duration_ms: 240, easing: "ease" }

data reframe_page: TimingToken = TimingToken { name: "reframe", duration_ms: 320, easing: "ease" }

data timing_scale: List<TimingToken> = [respond_fast, reveal_deliberate, restore_gentle, reframe_page]

type MotionTrigger
  = OnHover
  | OnFocusVisible
  | OnActive

fn trigger_pseudo(t: MotionTrigger) -> String {
  match t {
    OnHover => ":hover"
    OnFocusVisible => ":focus-visible"
    OnActive => ":active"
  }
}

type CssDecl {
  prop: String
  value: String
}

fn decl(prop: String, value: String) -> CssDecl {
  CssDecl { prop: prop, value: value }
}

fn role_decl(prop: String, r: ThemeRole) -> CssDecl {
  CssDecl { prop: prop, value: role_var(r: r) }
}

fn transition_decl(props: String, t: TimingToken) -> CssDecl {
  CssDecl {
    prop: "transition",
    value: join([props, " ", to_string(t.duration_ms), "ms ", t.easing], ""),
  }
}

type TriggerShape
  = SelfResponse
  | WithinSubject { target: String }
  | ContainerHas { container: String, target: String }

type BuildRule
  = StaticRule { selector: String, decls: List<CssDecl> }
  | ResponseRule {
      subject: String,
      shape: TriggerShape,
      trigger: MotionTrigger,
      transition_props: String,
      timing: TimingToken,
      base_decls: List<CssDecl>,
      response_decls: List<CssDecl>,
    }

fn response_base_selector(subject: String, shape: TriggerShape) -> String {
  match shape {
    SelfResponse => subject
    WithinSubject { target } => join([subject, " ", target], "")
    ContainerHas { container: _, target } => target
  }
}

fn response_hot_selector(subject: String, shape: TriggerShape, trigger: MotionTrigger) -> String {
  let pseudo = trigger_pseudo(t: trigger)
  match shape {
    SelfResponse => concat(subject, pseudo)
    WithinSubject { target } => join([subject, pseudo, " ", target], "")
    ContainerHas { container, target } =>
      join([container, ":has(", subject, pseudo, ") ", target], "")
  }
}

fn serialize_decls(decls: List<CssDecl>) -> String {
  join(map(decls, d => join([d.prop, ": ", d.value], "")), "; ")
}

fn css_block(selector: String, decls: List<CssDecl>) -> String {
  join([selector, " { ", serialize_decls(decls: decls), " }"], "")
}

fn theme_var_decls(t: Theme) -> List<CssDecl> {
  concat(
    map(t.assignments, a => decl(prop: concat("--", role_key(r: a.role)), value: assignment_paint(a: a))),
    [decl(prop: "color-scheme", value: t.scheme)])
}

fn theme_root_css(base: Theme, alternate: Theme) -> String {
  join([
    css_block(selector: ":root", decls: theme_var_decls(t: base)),
    css_block(
      selector: join([":root[data-theme=\"", alternate.name, "\"]"], ""),
      decls: theme_var_decls(t: alternate)),
    join([
      "@media (prefers-color-scheme: ", alternate.scheme, ") { ",
      css_block(selector: ":root:not([data-theme])", decls: theme_var_decls(t: alternate)),
      " }",
    ], ""),
  ], "\n")
}

fn serialize_rule(rule: BuildRule) -> String {
  match rule {
    StaticRule { selector, decls } => css_block(selector: selector, decls: decls)
    ResponseRule { subject, shape, trigger, transition_props, timing, base_decls, response_decls } =>
      join([
        css_block(
          selector: response_base_selector(subject: subject, shape: shape),
          decls: concat(base_decls, [transition_decl(props: transition_props, t: timing)])),
        css_block(
          selector: response_hot_selector(subject: subject, shape: shape, trigger: trigger),
          decls: response_decls),
      ], "\n")
  }
}

fn serialize_rules(rules: List<BuildRule>) -> String {
  join(map(rules, r => serialize_rule(rule: r)), "\n")
}

fn add_selector_once(selectors: List<String>, s: String) -> List<String> {
  let found = fold(selectors, init: false, f: (acc, x) => acc || x == s)
  if found { selectors } else { concat(selectors, [s]) }
}

fn reduced_motion_block(rules: List<BuildRule>) -> String {
  let selectors = fold(rules, init: [], f: (acc, r) => match r {
    StaticRule { selector: _, decls: _ } => acc
    ResponseRule { subject, shape, trigger: _, transition_props: _, timing: _, base_decls: _, response_decls: _ } =>
      add_selector_once(selectors: acc, s: response_base_selector(subject: subject, shape: shape))
  })
  if selectors.length() == 0 {
    ""
  } else {
    join([
      "@media (prefers-reduced-motion: reduce) { ",
      join(map(selectors, s => css_block(selector: s, decls: [decl(prop: "transition", value: "none")])), " "),
      " }",
    ], "")
  }
}
