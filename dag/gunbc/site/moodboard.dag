module gunbc.site.moodboard


data moodboard_note: String = "Layer 6: the page. Everything visible projects from the layers below — principles (laws) -> tokens (themes/materials/timing) -> interaction (behavior rows) -> mark / constellation (figures) -> this composition. Every color routes through a theme role var: :root carries the night theme, one prefers-color-scheme media block carries the day theme, both derived from the same Theme rows (one rule set, N themes — a hardcoded hsl in a page rule is the fork this construction removes). The stylesheet is DERIVED from the behavior rows via realize_behavior, so a declared behavior with no realization is countable."

data moodboard_elements: List<gunbc.design.interaction.InteractiveElement> = [
  gunbc.design.interaction.InteractiveElement { element: gunbc.design.interaction.StarElement, verbs: [gunbc.design.interaction.Approach] },
  gunbc.design.interaction.InteractiveElement { element: gunbc.design.interaction.HashElement, verbs: [gunbc.design.interaction.Approach] },
  gunbc.design.interaction.InteractiveElement { element: gunbc.design.interaction.SwatchElement, verbs: [gunbc.design.interaction.Approach] },
]

data moodboard_behaviors: List<gunbc.design.interaction.BehaviorRow> = [
  gunbc.design.interaction.BehaviorRow { element: gunbc.design.interaction.StarElement, verb: gunbc.design.interaction.Approach, response: gunbc.design.interaction.Brighten, timing: gunbc.design.material.respond_fast },
  gunbc.design.interaction.BehaviorRow { element: gunbc.design.interaction.StarElement, verb: gunbc.design.interaction.Approach, response: gunbc.design.interaction.Reveal, timing: gunbc.design.material.reveal_deliberate },
  gunbc.design.interaction.BehaviorRow { element: gunbc.design.interaction.HashElement, verb: gunbc.design.interaction.Approach, response: gunbc.design.interaction.Reveal, timing: gunbc.design.material.reveal_deliberate },
  gunbc.design.interaction.BehaviorRow { element: gunbc.design.interaction.SwatchElement, verb: gunbc.design.interaction.Approach, response: gunbc.design.interaction.Brighten, timing: gunbc.design.material.respond_fast },
]

fn approach_triggers() -> List<gunbc.design.material.MotionTrigger> {
  [gunbc.design.material.OnHover, gunbc.design.material.OnFocusVisible]
}

fn star_brighten_rules(timing: gunbc.design.material.TimingToken) -> List<gunbc.design.material.BuildRule> {
  map(approach_triggers(), t =>
    gunbc.design.material.ResponseRule {
      subject: ClassSelector { name: "star" },
      shape: gunbc.design.material.SelfResponse,
      trigger: t,
      transition_props: "fill",
      timing: timing,
      base_decls: [ gunbc.design.theme.role_decl(prop: Fill, r: gunbc.design.theme.FigureRole), gunbc.design.material.decl(prop: extdeps.languages.css.properties.Cursor, value: "pointer") ],
      response_decls: [ gunbc.design.theme.role_decl(prop: Fill, r: gunbc.design.theme.FigureLitRole) ],
    })
}

fn star_legend_reveal_rules(timing: gunbc.design.material.TimingToken) -> List<gunbc.design.material.BuildRule> {
  fold(gunbc.site.constellation.layer_stars, init: [], f: (acc, s) =>
    concat(acc, map(approach_triggers(), t =>
      gunbc.design.material.ResponseRule {
        subject: RawSelector { text: concat(".star-", s.key) },
        shape: gunbc.design.material.ContainerHas { container: ".hero", target: concat(".legend-", s.key) },
        trigger: t,
        transition_props: "opacity",
        timing: timing,
        base_decls: [ gunbc.design.material.decl(prop: Opacity, value: "0.5") ],
        response_decls: [ gunbc.design.material.decl(prop: Opacity, value: "1") ],
      })))
}

fn hash_reveal_rules(timing: gunbc.design.material.TimingToken) -> List<gunbc.design.material.BuildRule> {
  map(approach_triggers(), t =>
    gunbc.design.material.ResponseRule {
      subject: ClassSelector { name: "hash" },
      shape: gunbc.design.material.WithinSubject { target: ".hash-full" },
      trigger: t,
      transition_props: "opacity",
      timing: timing,
      base_decls: [ gunbc.design.material.decl(prop: Opacity, value: "0") ],
      response_decls: [ gunbc.design.material.decl(prop: Opacity, value: "1") ],
    })
}

fn swatch_brighten_rules(timing: gunbc.design.material.TimingToken) -> List<gunbc.design.material.BuildRule> {
  map(approach_triggers(), t =>
    gunbc.design.material.ResponseRule {
      subject: ClassSelector { name: "swatch" },
      shape: gunbc.design.material.SelfResponse,
      trigger: t,
      transition_props: "border-color",
      timing: timing,
      base_decls: [ gunbc.design.material.decl(prop: Border, value: "1px solid var(--border)") ],
      response_decls: [ gunbc.design.theme.role_decl(prop: BorderColor, r: gunbc.design.theme.FigureEdgeRole) ],
    })
}

type RealizedBehavior
  = RealizedRules { rules: List<gunbc.design.material.BuildRule> }
  | UnrealizedBehavior { element: String, verb: String, response: String }

fn realize_behavior(row: gunbc.design.interaction.BehaviorRow) -> RealizedBehavior {
  let e = row.element
  let r = gunbc.design.interaction.response_key(r: row.response)
  if gunbc.design.interaction.element_id_eq(a: e, b: gunbc.design.interaction.StarElement) && r == "brighten" {
    RealizedRules { rules: star_brighten_rules(timing: row.timing) }
  } else if gunbc.design.interaction.element_id_eq(a: e, b: gunbc.design.interaction.StarElement) && r == "reveal" {
    RealizedRules { rules: star_legend_reveal_rules(timing: row.timing) }
  } else if gunbc.design.interaction.element_id_eq(a: e, b: gunbc.design.interaction.HashElement) && r == "reveal" {
    RealizedRules { rules: hash_reveal_rules(timing: row.timing) }
  } else if gunbc.design.interaction.element_id_eq(a: e, b: gunbc.design.interaction.SwatchElement) && r == "brighten" {
    RealizedRules { rules: swatch_brighten_rules(timing: row.timing) }
  } else {
    UnrealizedBehavior { element: element_id_key(id: e), verb: gunbc.design.interaction.verb_key(v: row.verb), response: r }
  }
}

fn unrealized_behaviors(rows: List<gunbc.design.interaction.BehaviorRow>) -> List<RealizedBehavior> {
  fold(rows, init: [], f: (acc, row) => match realize_behavior(row: row) {
    RealizedRules { rules: _ } => acc
    UnrealizedBehavior { element, verb, response } =>
      concat(acc, [UnrealizedBehavior { element: element, verb: verb, response: response }])
  })
}

fn behavior_rules(rows: List<gunbc.design.interaction.BehaviorRow>) -> List<gunbc.design.material.BuildRule> {
  fold(rows, init: [], f: (acc, row) => match realize_behavior(row: row) {
    RealizedRules { rules } => concat(acc, rules)
    UnrealizedBehavior { element: _, verb: _, response: _ } => acc
  })
}

fn figure_rules() -> List<gunbc.design.material.BuildRule> {
  [
    gunbc.design.material.StaticRule { selector: ClassSelector { name: "mark-point" }, decls: [ gunbc.design.theme.role_decl(prop: Fill, r: gunbc.design.theme.FigureRole) ] },
    gunbc.design.material.StaticRule { selector: ClassSelector { name: "mark-sink" }, decls: [ gunbc.design.theme.role_decl(prop: Fill, r: gunbc.design.theme.FocusRole) ] },
    gunbc.design.material.StaticRule { selector: ClassSelector { name: "mark-halo" }, decls: [ gunbc.design.theme.role_decl(prop: Fill, r: gunbc.design.theme.FigureRole), gunbc.design.material.decl(prop: Opacity, value: "0.16") ] },
    gunbc.design.material.StaticRule { selector: ClassSelector { name: "mark-halo-sink" }, decls: [ gunbc.design.theme.role_decl(prop: Fill, r: gunbc.design.theme.FocusRole) ] },
    gunbc.design.material.StaticRule { selector: ClassSelector { name: "mark-edge" }, decls: [ gunbc.design.theme.role_decl(prop: Stroke, r: gunbc.design.theme.FigureEdgeRole) ] },
    gunbc.design.material.StaticRule { selector: ClassSelector { name: "sky-edge" }, decls: [ gunbc.design.theme.role_decl(prop: Stroke, r: gunbc.design.theme.FigureEdgeRole) ] },
    gunbc.design.material.StaticRule { selector: ClassSelector { name: "star-halo" }, decls: [ gunbc.design.theme.role_decl(prop: Fill, r: gunbc.design.theme.FigureRole), gunbc.design.material.decl(prop: Opacity, value: "0.1") ] },
  ]
}

fn static_rules() -> List<gunbc.design.material.BuildRule> {
  [
    gunbc.design.material.StaticRule { selector: ElementSelector { tag: "body" }, decls: [
      gunbc.design.theme.role_decl(prop: Background, r: gunbc.design.theme.CanvasRole),
      gunbc.design.theme.role_decl(prop: Color, r: gunbc.design.theme.TextRole),
      gunbc.design.material.decl(prop: FontFamily, value: "'Noto Sans', system-ui, sans-serif"),
      gunbc.design.material.decl(prop: Margin, value: "0"),
      gunbc.design.material.decl(prop: LineHeight, value: "1.55"),
    ] },
    gunbc.design.material.StaticRule { selector: ElementSelector { tag: "main" }, decls: [
      gunbc.design.material.decl(prop: MaxWidth, value: "54rem"),
      gunbc.design.material.decl(prop: Margin, value: "0 auto"),
      gunbc.design.material.decl(prop: Padding, value: "3rem 1.5rem 4rem"),
    ] },
    gunbc.design.material.StaticRule { selector: ClassSelector { name: "wordmark" }, decls: [
      gunbc.design.material.decl(prop: FontSize, value: "1.4rem"),
      gunbc.design.material.decl(prop: FontWeight, value: "500"),
      gunbc.design.material.decl(prop: LetterSpacing, value: "0.01em"),
    ] },
    gunbc.design.material.StaticRule { selector: ClassSelector { name: "thesis" }, decls: [
      gunbc.design.theme.role_decl(prop: Color, r: gunbc.design.theme.TextDimRole),
      gunbc.design.material.decl(prop: Margin, value: "0.25rem 0 0"),
    ] },
    gunbc.design.material.StaticRule { selector: ElementSelector { tag: "section" }, decls: [
      gunbc.design.material.decl(prop: MarginTop, value: "3rem"),
    ] },
    gunbc.design.material.StaticRule { selector: ElementSelector { tag: "h2" }, decls: [
      gunbc.design.material.decl(prop: FontSize, value: "0.85rem"),
      gunbc.design.material.decl(prop: FontWeight, value: "500"),
      gunbc.design.material.decl(prop: LetterSpacing, value: "0.08em"),
      gunbc.design.material.decl(prop: TextTransform, value: "lowercase"),
      gunbc.design.theme.role_decl(prop: Color, r: gunbc.design.theme.TextDimRole),
    ] },
    gunbc.design.material.StaticRule { selector: ClassSelector { name: "panel" }, decls: [
      gunbc.design.theme.role_decl(prop: Background, r: gunbc.design.theme.SurfaceRole),
      gunbc.design.material.decl(prop: Border, value: "1px solid var(--border)"),
      gunbc.design.material.decl(prop: BorderRadius, value: "3px"),
      gunbc.design.material.decl(prop: Padding, value: "1.1rem 1.25rem"),
    ] },
    gunbc.design.material.StaticRule { selector: ClassSelector { name: "mono" }, decls: [
      gunbc.design.material.decl(prop: FontFamily, value: "'JetBrains Mono', monospace"),
      gunbc.design.material.decl(prop: FontSize, value: "0.82em"),
    ] },
    gunbc.design.material.StaticRule { selector: ClassSelector { name: "mark" }, decls: [
      gunbc.design.material.decl(prop: Height, value: "3rem"),
      gunbc.design.material.decl(prop: MarginRight, value: "1.5rem"),
    ] },
    gunbc.design.material.StaticRule { selector: ClassSelector { name: "constellation" }, decls: [
      gunbc.design.material.decl(prop: Width, value: "100%"),
      gunbc.design.material.decl(prop: Height, value: "auto"),
    ] },
    gunbc.design.material.StaticRule { selector: ClassSelector { name: "hero" }, decls: [
      gunbc.design.material.decl(prop: Margin, value: "0"),
    ] },
    gunbc.design.material.StaticRule { selector: ClassSelector { name: "legend" }, decls: [
      gunbc.design.material.decl(prop: ListStyle, value: "none"),
      gunbc.design.material.decl(prop: Padding, value: "0"),
      gunbc.design.material.decl(prop: FontSize, value: "0.85rem"),
      gunbc.design.theme.role_decl(prop: Color, r: gunbc.design.theme.TextDimRole),
    ] },
    gunbc.design.material.StaticRule { selector: ClassSelector { name: "legend-key" }, decls: [
      gunbc.design.material.decl(prop: FontFamily, value: "'JetBrains Mono', monospace"),
      gunbc.design.theme.role_decl(prop: Color, r: gunbc.design.theme.TextRole),
    ] },
    gunbc.design.material.StaticRule { selector: ClassSelector { name: "swatch" }, decls: [
      gunbc.design.material.decl(prop: Display, value: "inline-block"),
      gunbc.design.material.decl(prop: BorderRadius, value: "3px"),
      gunbc.design.material.decl(prop: Padding, value: "0.3rem"),
      gunbc.design.material.decl(prop: Margin, value: "0 0.5rem 0.25rem 0"),
    ] },
    gunbc.design.material.StaticRule { selector: ClassSelector { name: "chip-inline" }, decls: [
      gunbc.design.material.decl(prop: Display, value: "inline-block"),
      gunbc.design.material.decl(prop: Width, value: "2.4rem"),
      gunbc.design.material.decl(prop: Height, value: "1.2rem"),
      gunbc.design.material.decl(prop: BorderRadius, value: "2px"),
      gunbc.design.material.decl(prop: Border, value: "1px solid var(--border)"),
      gunbc.design.material.decl(prop: VerticalAlign, value: "middle"),
      gunbc.design.material.decl(prop: MarginRight, value: "0.5rem"),
    ] },
    gunbc.design.material.StaticRule { selector: ClassSelector { name: "ledger" }, decls: [
      gunbc.design.material.decl(prop: Width, value: "100%"),
      gunbc.design.material.decl(prop: BorderCollapse, value: "collapse"),
      gunbc.design.material.decl(prop: FontSize, value: "0.85rem"),
    ] },
    gunbc.design.material.StaticRule { selector: RawSelector { text: ".ledger td" }, decls: [
      gunbc.design.material.decl(prop: Padding, value: "0.45rem 0.75rem 0.45rem 0"),
      gunbc.design.material.decl(prop: BorderBottom, value: "1px solid var(--border)"),
      gunbc.design.material.decl(prop: VerticalAlign, value: "top"),
    ] },
    gunbc.design.material.StaticRule { selector: ClassSelector { name: "boundary" }, decls: [
      gunbc.design.material.decl(prop: BorderLeft, value: "2px solid var(--boundary)"),
      gunbc.design.material.decl(prop: PaddingLeft, value: "1rem"),
    ] },
    gunbc.design.material.StaticRule { selector: ClassSelector { name: "foot" }, decls: [
      gunbc.design.material.decl(prop: MarginTop, value: "4rem"),
      gunbc.design.material.decl(prop: FontSize, value: "0.78rem"),
      gunbc.design.theme.role_decl(prop: Color, r: gunbc.design.theme.TextDimRole),
    ] },
  ]
}

fn moodboard_rules() -> List<gunbc.design.material.BuildRule> {
  concat(concat(static_rules(), figure_rules()), behavior_rules(rows: moodboard_behaviors))
}

fn moodboard_css() -> String {
  join([
    gunbc.design.theme.theme_root_css(base: gunbc.design.theme.night_theme, alternate: gunbc.design.theme.day_theme),
    gunbc.design.material.serialize_rules(rules: moodboard_rules()),
    gunbc.design.theme_transition.reframe_css(rules: moodboard_rules()),
    gunbc.design.material.reduced_motion_block(rules: behavior_rules(rows: moodboard_behaviors)),
  ], "\n")
}

fn moodboard_nav_js() -> String {
  gunbc.design.theme_transition.reframe_watcher_js()
}

fn theme_paint_of(t: gunbc.design.theme.Theme, r: gunbc.design.theme.ThemeRole) -> String {
  fold(t.assignments, init: "", f: (acc, a) =>
    if gunbc.design.theme.role_eq(a: a.role, b: r) { gunbc.design.theme.assignment_paint(a: a) } else { acc })
}

fn themes_serialized() -> String {
  join(map(gunbc.design.theme.site_themes, t =>
    join(map(t.assignments, a => join([t.name, ".", gunbc.design.theme.role_key(r: a.role), "=", gunbc.design.theme.assignment_paint(a: a)], "")), ";")), "|")
}

fn moodboard_digest() -> String {
  std.content_hash.content_hash_atom(value: concat(gunbc.design.principles.register_thesis, themes_serialized()) as std.types.NonEmptyStr).digest as String
}

fn short_digest(digest: String) -> String {
  substring(s: digest, start: 0, end: 8)
}

fn masthead() -> std.markup.Fragment {
  gunbc.site.markup.el_class("header", "masthead", [
    gunbc.site.markup.el_class("p", "wordmark", [ gunbc.site.markup.txt("gunb.ai") ]),
    gunbc.site.markup.el_class("p", "thesis", [ gunbc.site.markup.txt(gunbc.design.principles.register_thesis) ]),
  ])
}

fn mark_section() -> std.markup.Fragment {
  gunbc.site.markup.el("section", [
    gunbc.site.markup.el("h2", [ gunbc.site.markup.txt("the mark — one spec, three depths") ]),
    gunbc.site.markup.el_class("div", "panel", [
      gunbc.site.mark.render_mark(depth: 0),
      gunbc.site.mark.render_mark(depth: 1),
      gunbc.site.mark.render_mark(depth: 3),
    ]),
  ])
}

fn hero_section() -> std.markup.Fragment {
  gunbc.site.markup.el("section", [
    gunbc.site.markup.el("h2", [ gunbc.site.markup.txt("the layer dag as an asterism — touch a star") ]),
    gunbc.site.markup.el_class("div", "panel", [ gunbc.site.constellation.constellation_figure() ]),
  ])
}

fn theme_chip(paint_value: String) -> std.markup.Fragment {
  std.markup.Element {
    tag: "span",
    attributes: [
      std.markup.attr(name: "class", value: "chip-inline" ),
      std.markup.attr(name: "style", value: concat("background: ", paint_value) ),
    ],
    children: [],
  }
}

fn theme_cell(t: gunbc.design.theme.Theme, r: gunbc.design.theme.ThemeRole) -> std.markup.Fragment {
  let p = theme_paint_of(t: t, r: r)
  std.markup.Element {
    tag: "td",
    attributes: [],
    children: [
      std.markup.Element {
        tag: "span",
        attributes: [
          std.markup.attr(name: "class", value: "swatch" ),
          std.markup.attr(name: "tabindex", value: "0" ),
        ],
        children: [ theme_chip(paint_value: p), gunbc.site.markup.el_class("span", "mono", [ gunbc.site.markup.txt(p) ]) ],
      },
    ],
  }
}

fn theme_role_row(r: gunbc.design.theme.ThemeRole) -> std.markup.Fragment {
  gunbc.site.markup.el("tr", [
    gunbc.site.markup.el_class("td", "mono", [ gunbc.site.markup.txt(gunbc.design.theme.role_key(r: r)) ]),
    theme_cell(t: gunbc.design.theme.night_theme, r: r),
    theme_cell(t: gunbc.design.theme.day_theme, r: r),
  ])
}

fn themes_section() -> std.markup.Fragment {
  gunbc.site.markup.el("section", [
    gunbc.site.markup.el("h2", [ gunbc.site.markup.txt("themes — one role model, night and day projections") ]),
    gunbc.site.markup.el_class("table", "ledger", concat(
      [ gunbc.site.markup.el("tr", [
          gunbc.site.markup.el_class("td", "mono", [ gunbc.site.markup.txt("role") ]),
          gunbc.site.markup.el_class("td", "mono", [ gunbc.site.markup.txt("night") ]),
          gunbc.site.markup.el_class("td", "mono", [ gunbc.site.markup.txt("day") ]),
        ]) ],
      map(gunbc.design.theme.theme_roles, r => theme_role_row(r: r)))),
  ])
}

fn timing_row(t: gunbc.design.material.TimingToken) -> std.markup.Fragment {
  gunbc.site.markup.el("tr", [
    gunbc.site.markup.el_class("td", "mono", [ gunbc.site.markup.txt(t.name) ]),
    gunbc.site.markup.el_class("td", "mono", [ gunbc.site.markup.txt(join([to_string(t.duration_ms), "ms ", t.easing], "")) ]),
  ])
}

fn timing_section() -> std.markup.Fragment {
  gunbc.site.markup.el("section", [
    gunbc.site.markup.el("h2", [ gunbc.site.markup.txt("the timing scale — three tokens, no other durations exist") ]),
    gunbc.site.markup.el_class("table", "ledger", map(gunbc.design.material.timing_scale, t => timing_row(t: t))),
  ])
}

fn principle_row(p: gunbc.design.principles.RegisterPrinciple) -> std.markup.Fragment {
  gunbc.site.markup.el("tr", [
    gunbc.site.markup.el_class("td", "mono", [ gunbc.site.markup.txt(gunbc.design.principles.principle_id_key(id: p.id)) ]),
    gunbc.site.markup.el("td", [ gunbc.site.markup.txt(p.law) ]),
    gunbc.site.markup.el_class("td", "mono", [ gunbc.site.markup.txt(join([p.enforced_by.module_path, ".", p.enforced_by.decl_name], "")) ]),
  ])
}

fn principles_section() -> std.markup.Fragment {
  gunbc.site.markup.el("section", [
    gunbc.site.markup.el("h2", [ gunbc.site.markup.txt("base principles — each law names its enforcing carrier") ]),
    gunbc.site.markup.el_class("table", "ledger", map(gunbc.design.principles.register_principles, p => principle_row(p: p))),
  ])
}

fn boundary_section() -> std.markup.Fragment {
  gunbc.site.markup.el("section", [
    gunbc.site.markup.el("h2", [ gunbc.site.markup.txt("a boundary — refusal does not glow") ]),
    gunbc.site.markup.el_class("div", "panel boundary", [
      gunbc.site.markup.el_class("p", "mono", [
        gunbc.site.markup.txt("invariant — a bright saturated material fails the glare envelope; the row is inadmissible at the theme witness, no artifact emitted"),
      ]),
    ]),
  ])
}

fn hallmark() -> std.markup.Fragment {
  let digest = moodboard_digest()
  std.markup.Element {
    tag: "footer",
    attributes: [
      std.markup.attr(name: "class", value: "foot hash" ),
      std.markup.attr(name: "tabindex", value: "0" ),
    ],
    children: [
      gunbc.site.markup.el_class("span", "mono", [ gunbc.site.markup.txt(concat("emitted from gunbc.site.moodboard · thesis+themes digest ", short_digest(digest: digest))) ]),
      gunbc.site.markup.el_class("span", "mono hash-full", [ gunbc.site.markup.txt(concat(" · full ", digest)) ]),
    ],
  }
}

fn moodboard_page() -> std.markup.Fragment {
  std.markup.Element { tag: "html", attributes: [ std.markup.attr(name: "lang", value: "en" ) ], children: [
    gunbc.site.markup.el("head", [
      std.markup.Element { tag: "meta", attributes: [ std.markup.attr(name: "charset", value: "utf-8" ) ], children: [] },
      std.markup.Element { tag: "meta", attributes: [
        std.markup.attr(name: "name", value: "viewport" ),
        std.markup.attr(name: "content", value: "width=device-width, initial-scale=1" ),
      ], children: [] },
      gunbc.site.markup.el("title", [ gunbc.site.markup.txt("gunb.ai — register moodboard (phase 0)") ]),
      gunbc.site.markup.el("style", [ gunbc.site.markup.txt(moodboard_css()) ]),
      std.markup.Element { tag: "script", attributes: [
        std.markup.attr(name: "src", value: "assets/nav.js" ),
        std.markup.attr(name: "defer", value: "" ),
      ], children: [] },
    ]),
    gunbc.site.markup.el("body", [
      gunbc.site.markup.el("main", [
        masthead(),
        mark_section(),
        hero_section(),
        themes_section(),
        timing_section(),
        principles_section(),
        boundary_section(),
        hallmark(),
      ]),
    ]),
  ] }
}

fn moodboard_html() -> String {
  match extdeps.languages.html.try_serialize_html_source(node: moodboard_page()) {
    extdeps.languages.html.EmitOk { html: h } => concat("<!DOCTYPE html>\n", h)
    extdeps.languages.html.EmitRejected { reason: r } => concat("EMIT REJECTED: ", r)
  }
}

fn moodboard_preconditions_hold() -> Bool {
  gunbc.design.theme.themes_coherent(themes: gunbc.design.theme.site_themes, roles: gunbc.design.theme.theme_roles)
    && gunbc.design.interaction.coverage_gaps(elements: moodboard_elements, rows: moodboard_behaviors).length() == 0
    && unrealized_behaviors(rows: moodboard_behaviors).length() == 0
    && gunbc.design.theme_transition.unthemed_color_decls(rules: moodboard_rules()).length() == 0
    && gunbc.site.mark.all_forks_rejoin(nodes: gunbc.site.mark.mark_nodes, edges: gunbc.site.mark.mark_edges, source: "a")
}
