module gunbc.site.interaction

import gunbc.site.tokens { TimingToken, respond_fast, reveal_deliberate }

data interaction_note: String = "Layer 3: the closed interaction vocabulary (design section 4l). Verbs x Responses x TimingToken, held as rows. The coverage law is a countable fold: every interactive element must carry a response row for every verb it declares — a dead hover is a LOCATED gap, not a review vibe."

type InteractionVerb
  = Approach
  | Enter
  | StepBack
  | Copy
  | Traverse

type Response
  = Brighten
  | Reveal
  | CounterpartHighlight
  | Receipt

fn verb_key(v: InteractionVerb) -> String {
  match v {
    Approach => "approach"
    Enter => "enter"
    StepBack => "step-back"
    Copy => "copy"
    Traverse => "traverse"
  }
}

fn response_key(r: Response) -> String {
  match r {
    Brighten => "brighten"
    Reveal => "reveal"
    CounterpartHighlight => "counterpart-highlight"
    Receipt => "receipt"
  }
}

type BehaviorRow {
  element: String
  verb: InteractionVerb
  response: Response
  timing: TimingToken
}

type InteractiveElement {
  element: String
  verbs: List<InteractionVerb>
}

type CoverageGap {
  element: String
  verb: InteractionVerb
}

fn interaction_verb_eq(a: InteractionVerb, b: InteractionVerb) -> Bool {
  verb_key(v: a) == verb_key(v: b)
}

fn row_covers(rows: List<BehaviorRow>, element: String, verb: InteractionVerb) -> Bool {
  fold(rows, init: false, f: (acc, r) =>
    acc || (r.element == element && interaction_verb_eq(a: r.verb, b: verb)))
}

fn element_gaps(rows: List<BehaviorRow>, e: InteractiveElement) -> List<CoverageGap> {
  fold(e.verbs, init: [], f: (acc, v) =>
    if row_covers(rows: rows, element: e.element, verb: v) {
      acc
    } else {
      concat(acc, [CoverageGap { element: e.element, verb: v }])
    })
}

fn coverage_gaps(elements: List<InteractiveElement>, rows: List<BehaviorRow>) -> List<CoverageGap> {
  fold(elements, init: [], f: (acc, e) => concat(acc, element_gaps(rows: rows, e: e)))
}

fn coverage_complete(elements: List<InteractiveElement>, rows: List<BehaviorRow>) -> Bool {
  coverage_gaps(elements: elements, rows: rows).length() == 0
}

data moodboard_elements: List<InteractiveElement> = [
  InteractiveElement { element: "star", verbs: [Approach] },
  InteractiveElement { element: "hash", verbs: [Approach] },
  InteractiveElement { element: "swatch", verbs: [Approach] },
]

data moodboard_behaviors: List<BehaviorRow> = [
  BehaviorRow { element: "star", verb: Approach, response: Brighten, timing: respond_fast },
  BehaviorRow { element: "star", verb: Approach, response: Reveal, timing: reveal_deliberate },
  BehaviorRow { element: "hash", verb: Approach, response: Reveal, timing: reveal_deliberate },
  BehaviorRow { element: "swatch", verb: Approach, response: Brighten, timing: respond_fast },
]
