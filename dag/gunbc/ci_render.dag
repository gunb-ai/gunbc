module gunbc.ci_render

import extdeps.render.glyphs { resolve_symbol }
import extdeps.render.terminal { serialize_frame }
import extdeps.unicode.display { string_display_width, truncate_text }
import std.measure { Nanosecond, nanosecond, nanosecond_count }
import std.render { Line, RenderCapability, Span, SpanStyle }
import std.render_repeat_string_bootstrap { repeat_string }
import std.symbols {
  SymbolId,
  Tier,
  Unicode,
  Ascii,
  SemanticColor,
  Dim,
  BoxHorizontal,
  BoxVertical,
  BoxCornerTopLeft,
  BoxCornerTopRight,
  BoxCornerBottomLeft,
  BoxCornerBottomRight,
}

fn glyph_for(id: SymbolId, tier: Tier) -> String {
  match resolve_symbol(id: id, tier: tier) {
    Present { value: s } => s
    Absent => ""
  }
}

fn pad_to(text: String, width: Int) -> String {
  let w = string_display_width(s: text)
  if w >= width {
    text
  } else {
    concat(text, repeat_string(s: " ", n: width - w))
  }
}

fn plain_span(text: String) -> Span {
  Span { text: text, style: SpanStyle { color: none, bold: false, italic: false, symbol: none } }
}

fn dim_span(text: String) -> Span {
  Span { text: text, style: SpanStyle { color: Present { value: Dim }, bold: false, italic: false, symbol: none } }
}


fn line_of(span: Span) -> Line {
  Line { spans: [span], indent: 0, max_width: none }
}

fn box_top(title: String, width: Int, tier: Tier) -> Line {
  let hz = glyph_for(id: BoxHorizontal, tier: tier)
  let tr = glyph_for(id: BoxCornerTopRight, tier: tier)
  let prefix = concat(glyph_for(id: BoxCornerTopLeft, tier: tier), concat(hz, concat(" ", concat(title, " "))))
  let dashes = width - string_display_width(s: prefix) - string_display_width(s: tr)
  line_of(span: dim_span(text: concat(prefix, concat(repeat_string(s: hz, n: dashes), tr))))
}

fn box_bottom(width: Int, tier: Tier) -> Line {
  let hz = glyph_for(id: BoxHorizontal, tier: tier)
  let bl = glyph_for(id: BoxCornerBottomLeft, tier: tier)
  let br = glyph_for(id: BoxCornerBottomRight, tier: tier)
  let dashes = width - string_display_width(s: bl) - string_display_width(s: br)
  line_of(span: dim_span(text: concat(bl, concat(repeat_string(s: hz, n: dashes), br))))
}

fn box_content_line(text: String, width: Int, tier: Tier) -> Line {
  let v = glyph_for(id: BoxVertical, tier: tier)
  let inner_budget = width - (2 * string_display_width(s: v)) - 2
  let inner = pad_to(text: truncate_text(text: text, max_width: inner_budget), width: inner_budget)
  line_of(span: plain_span(text: concat(v, concat(" ", concat(inner, concat(" ", v))))))
}

fn boxed_frame(title: String, body: List<String>, width: Int, tier: Tier) -> std.render.RenderFrame {
  let content = map(body, l => box_content_line(text: l, width: width, tier: tier))
  let all = concat([box_top(title: title, width: width, tier: tier)], concat(content, [box_bottom(width: width, tier: tier)]))
  std.render.RenderFrame { lines: all, cursor_action: Append }
}

fn format_duration(d: Nanosecond) -> String {
  let ns = nanosecond_count(n: d)
  if ns < 1000 {
    concat(to_string(ns), "ns")
  } else if ns < 1000000 {
    concat(to_string(ns / 1000), "us")
  } else if ns < 1000000000 {
    concat(to_string(ns / 1000000), "ms")
  } else {
    concat(to_string(ns / 1000000000), "s")
  }
}

fn timing_cell(label: String, d: Nanosecond) -> String {
  concat(label, concat(": ", format_duration(d: d)))
}

fn percentile_row(p50: Nanosecond, p90: Nanosecond, p95: Nanosecond, p99: Nanosecond, p100: Nanosecond) -> String {
  concat(timing_cell(label: "p50", d: p50),
  concat("  ", concat(timing_cell(label: "p90", d: p90),
  concat("  ", concat(timing_cell(label: "p95", d: p95),
  concat("  ", concat(timing_cell(label: "p99", d: p99),
  concat("  ", timing_cell(label: "max", d: p100)))))))))
}

fn percentile_box_frame(title: String, p50: Nanosecond, p90: Nanosecond, p95: Nanosecond, p99: Nanosecond, p100: Nanosecond, width: Int, tier: Tier) -> std.render.RenderFrame {
  boxed_frame(title: title, body: [percentile_row(p50: p50, p90: p90, p95: p95, p99: p99, p100: p100)], width: width, tier: tier)
}

fn render_capability(color: Bool) -> RenderCapability {
  RenderCapability { color: color, tier: Unicode, cursor_addressable: false }
}

fn percentiles_box_frame_ns(title: String, p50: Int, p90: Int, p95: Int, p99: Int, p100: Int, width: Int, tier: Tier) -> std.render.RenderFrame {
  percentile_box_frame(
    title: title,
    p50: nanosecond(count: p50), p90: nanosecond(count: p90), p95: nanosecond(count: p95),
    p99: nanosecond(count: p99), p100: nanosecond(count: p100),
    width: width, tier: tier
  )
}

fn render_percentile_box(title: String, p50: Int, p90: Int, p95: Int, p99: Int, p100: Int, width: Int, color: Bool) -> String {
  let cap = render_capability(color: color)
  serialize_frame(
    frame: percentiles_box_frame_ns(title: title, p50: p50, p90: p90, p95: p95, p99: p99, p100: p100, width: width, tier: cap.tier),
    cap: cap
  )
}

fn timing_histogram_frame(p50: Int, p90: Int, p95: Int, p99: Int, p100: Int, width: Int) -> std.render.RenderFrame {
  percentiles_box_frame_ns(title: "WITNESS TIMING HISTOGRAM", p50: p50, p90: p90, p95: p95, p99: p99, p100: p100, width: width, tier: Unicode)
}

fn slowest_witness_row(rank: Int, function: String, entry: String, eval_ns: Int, resolve_ns: Int, total_ns: Int) -> String {
  concat(
    pad_to(text: concat(to_string(rank), "."), width: 3),
    concat(" eval=", concat(
      format_duration(d: nanosecond(count: eval_ns)),
      concat(" total=", concat(
        format_duration(d: nanosecond(count: total_ns)),
        concat(" resolve=", concat(
          format_duration(d: nanosecond(count: resolve_ns)),
          concat("  ", concat(function, concat(" @ ", entry)))
        ))
      ))
    ))
  )
}

type HotRowAcc {
  lines: List<Line>
  idx: Int
}

data ansi_red_code: String = "\x1b[38;5;196m"
data ansi_reset_code: String = "\x1b[0m"

fn box_content_line_hot(text: String, width: Int, tier: Tier, hot: Bool, color: Bool) -> Line {
  let v = glyph_for(id: BoxVertical, tier: tier)
  let marked = if hot { concat("🔥 ", text) } else { text }
  let inner_budget = width - (2 * string_display_width(s: v)) - 2
  let inner = pad_to(text: truncate_text(text: marked, max_width: inner_budget), width: inner_budget)
  let painted = if hot && color { concat(ansi_red_code, concat(inner, ansi_reset_code)) } else { inner }
  line_of(span: plain_span(text: concat(v, concat(" ", concat(painted, concat(" ", v))))))
}

fn hot_content_lines(body: List<String>, hot_count: Int, width: Int, tier: Tier, color: Bool) -> List<Line> {
  let acc = fold(body, init: HotRowAcc { lines: [], idx: 0 }, f: (a, text) =>
    HotRowAcc {
      lines: concat(a.lines, [box_content_line_hot(text: text, width: width, tier: tier, hot: a.idx < hot_count, color: color)]),
      idx: a.idx + 1
    }
  )
  acc.lines
}

fn boxed_frame_hot(title: String, body: List<String>, hot_count: Int, width: Int, tier: Tier, color: Bool) -> std.render.RenderFrame {
  let content = hot_content_lines(body: body, hot_count: hot_count, width: width, tier: tier, color: color)
  let all = concat([box_top(title: title, width: width, tier: tier)], concat(content, [box_bottom(width: width, tier: tier)]))
  std.render.RenderFrame { lines: all, cursor_action: Append }
}

fn render_slowest_witnesses_box(body: List<String>, hot_count: Int, width: Int, color: Bool) -> String {
  let cap = render_capability(color: color)
  serialize_frame(
    frame: boxed_frame_hot(title: "TOP SLOWEST WITNESSES (by eval)", body: body, hot_count: hot_count, width: width, tier: cap.tier, color: color),
    cap: cap
  )
}

fn slowest_witness_default_hot_count(body: List<String>) -> Int {
  let n = count(body)
  if n < 3 { n } else { 3 }
}

fn render_slowest_witnesses_box_default(body: List<String>, width: Int, color: Bool) -> String {
  render_slowest_witnesses_box(body: body, hot_count: slowest_witness_default_hot_count(body: body), width: width, color: color)
}
