module gunbc.ci_render


fn glyph_for(id: std.symbols.SymbolId, tier: std.symbols.Tier) -> String {
  match extdeps.render.glyphs.resolve_symbol(id: id, tier: tier) {
    Present { value: s } => s
    Absent => ""
  }
}

fn pad_to(text: String, width: Int) -> String {
  let w = extdeps.unicode.display.string_display_width(s: text)
  if w >= width {
    text
  } else {
    concat(text, std.render_repeat_string_bootstrap.repeat_string(s: " ", n: width - w))
  }
}

fn plain_span(text: String) -> std.render.Span {
  std.render.Span { text: text, style: std.render.SpanStyle { color: none, bold: false, italic: false, symbol: none } }
}

fn dim_span(text: String) -> std.render.Span {
  std.render.Span { text: text, style: std.render.SpanStyle { color: Present { value: std.symbols.Dim }, bold: false, italic: false, symbol: none } }
}


fn line_of(span: std.render.Span) -> std.render.Line {
  std.render.Line { spans: [span], indent: 0, max_width: none }
}

fn box_top(title: String, width: Int, tier: std.symbols.Tier) -> std.render.Line {
  let hz = glyph_for(id: std.symbols.BoxHorizontal, tier: tier)
  let tr = glyph_for(id: std.symbols.BoxCornerTopRight, tier: tier)
  let prefix = concat(glyph_for(id: std.symbols.BoxCornerTopLeft, tier: tier), concat(hz, concat(" ", concat(title, " "))))
  let dashes = width - extdeps.unicode.display.string_display_width(s: prefix) - extdeps.unicode.display.string_display_width(s: tr)
  line_of(span: dim_span(text: concat(prefix, concat(std.render_repeat_string_bootstrap.repeat_string(s: hz, n: dashes), tr))))
}

fn box_bottom(width: Int, tier: std.symbols.Tier) -> std.render.Line {
  let hz = glyph_for(id: std.symbols.BoxHorizontal, tier: tier)
  let bl = glyph_for(id: std.symbols.BoxCornerBottomLeft, tier: tier)
  let br = glyph_for(id: std.symbols.BoxCornerBottomRight, tier: tier)
  let dashes = width - extdeps.unicode.display.string_display_width(s: bl) - extdeps.unicode.display.string_display_width(s: br)
  line_of(span: dim_span(text: concat(bl, concat(std.render_repeat_string_bootstrap.repeat_string(s: hz, n: dashes), br))))
}

fn box_content_line(text: String, width: Int, tier: std.symbols.Tier) -> std.render.Line {
  let v = glyph_for(id: std.symbols.BoxVertical, tier: tier)
  let inner_budget = width - (2 * extdeps.unicode.display.string_display_width(s: v)) - 2
  let inner = pad_to(text: extdeps.unicode.display.truncate_text(text: text, max_width: inner_budget), width: inner_budget)
  line_of(span: plain_span(text: concat(v, concat(" ", concat(inner, concat(" ", v))))))
}

fn boxed_frame(title: String, body: List<String>, width: Int, tier: std.symbols.Tier) -> RenderFrame {
  let content = map(body, l => box_content_line(text: l, width: width, tier: tier))
  let all = concat([box_top(title: title, width: width, tier: tier)], concat(content, [box_bottom(width: width, tier: tier)]))
  RenderFrame { lines: all, cursor_action: Append }
}

fn format_duration(d: std.measure.Nanosecond) -> String {
  let ns = std.measure.nanosecond_count(n: d)
  if ns < 1000 {
    concat(to_string(ns), "ns")
  } else if ns < 1000000 {
    concat(to_string(ns / 1000), "us")
  } else if ns < 1000000000 {
    concat(to_string(ns / 1000000), "ms")
  } else {
    concat(to_string(ns / 1000000000), "s")
  }
}

fn timing_cell(label: String, d: std.measure.Nanosecond) -> String {
  concat(label, concat(": ", format_duration(d: d)))
}

fn percentile_row(p50: std.measure.Nanosecond, p90: std.measure.Nanosecond, p95: std.measure.Nanosecond, p99: std.measure.Nanosecond, p100: std.measure.Nanosecond) -> String {
  concat(timing_cell(label: "p50", d: p50),
  concat("  ", concat(timing_cell(label: "p90", d: p90),
  concat("  ", concat(timing_cell(label: "p95", d: p95),
  concat("  ", concat(timing_cell(label: "p99", d: p99),
  concat("  ", timing_cell(label: "max", d: p100)))))))))
}

fn percentile_box_frame(title: String, p50: std.measure.Nanosecond, p90: std.measure.Nanosecond, p95: std.measure.Nanosecond, p99: std.measure.Nanosecond, p100: std.measure.Nanosecond, width: Int, tier: std.symbols.Tier) -> RenderFrame {
  boxed_frame(title: title, body: [percentile_row(p50: p50, p90: p90, p95: p95, p99: p99, p100: p100)], width: width, tier: tier)
}

fn render_capability(color: Bool) -> std.render.RenderCapability {
  std.render.RenderCapability { color: color, tier: std.symbols.Unicode, cursor_addressable: false }
}

fn percentiles_box_frame_ns(title: String, p50: Int, p90: Int, p95: Int, p99: Int, p100: Int, width: Int, tier: std.symbols.Tier) -> RenderFrame {
  percentile_box_frame(
    title: title,
    p50: std.measure.nanosecond(count: p50), p90: std.measure.nanosecond(count: p90), p95: std.measure.nanosecond(count: p95),
    p99: std.measure.nanosecond(count: p99), p100: std.measure.nanosecond(count: p100),
    width: width, tier: tier
  )
}

fn render_percentile_box(title: String, p50: Int, p90: Int, p95: Int, p99: Int, p100: Int, width: Int, color: Bool) -> String {
  let cap = render_capability(color: color)
  extdeps.render.terminal.serialize_frame(
    frame: percentiles_box_frame_ns(title: title, p50: p50, p90: p90, p95: p95, p99: p99, p100: p100, width: width, tier: cap.tier),
    cap: cap
  )
}

fn timing_histogram_frame(p50: Int, p90: Int, p95: Int, p99: Int, p100: Int, width: Int) -> RenderFrame {
  percentiles_box_frame_ns(title: "WITNESS TIMING HISTOGRAM", p50: p50, p90: p90, p95: p95, p99: p99, p100: p100, width: width, tier: std.symbols.Unicode)
}

fn slowest_witness_row(rank: Int, function: String, entry: String, eval_ns: Int, resolve_ns: Int, total_ns: Int) -> String {
  concat(
    pad_to(text: concat(to_string(rank), "."), width: 3),
    concat(" eval=", concat(
      format_duration(d: std.measure.nanosecond(count: eval_ns)),
      concat(" total=", concat(
        format_duration(d: std.measure.nanosecond(count: total_ns)),
        concat(" resolve=", concat(
          format_duration(d: std.measure.nanosecond(count: resolve_ns)),
          concat("  ", concat(function, concat(" @ ", entry)))
        ))
      ))
    ))
  )
}

type HotRowAcc {
  lines: List<std.render.Line>
  idx: Int
}

data ansi_red_code: String = "\x1b[38;5;196m"
data ansi_reset_code: String = "\x1b[0m"

fn box_content_line_hot(text: String, width: Int, tier: std.symbols.Tier, hot: Bool, color: Bool) -> std.render.Line {
  let v = glyph_for(id: std.symbols.BoxVertical, tier: tier)
  let marked = if hot { concat("🔥 ", text) } else { text }
  let inner_budget = width - (2 * extdeps.unicode.display.string_display_width(s: v)) - 2
  let inner = pad_to(text: extdeps.unicode.display.truncate_text(text: marked, max_width: inner_budget), width: inner_budget)
  let painted = if hot && color { concat(ansi_red_code, concat(inner, ansi_reset_code)) } else { inner }
  line_of(span: plain_span(text: concat(v, concat(" ", concat(painted, concat(" ", v))))))
}

fn hot_content_lines(body: List<String>, hot_count: Int, width: Int, tier: std.symbols.Tier, color: Bool) -> List<std.render.Line> {
  let acc = fold(body, init: HotRowAcc { lines: [], idx: 0 }, f: (a, text) =>
    HotRowAcc {
      lines: concat(a.lines, [box_content_line_hot(text: text, width: width, tier: tier, hot: a.idx < hot_count, color: color)]),
      idx: a.idx + 1
    }
  )
  acc.lines
}

fn boxed_frame_hot(title: String, body: List<String>, hot_count: Int, width: Int, tier: std.symbols.Tier, color: Bool) -> RenderFrame {
  let content = hot_content_lines(body: body, hot_count: hot_count, width: width, tier: tier, color: color)
  let all = concat([box_top(title: title, width: width, tier: tier)], concat(content, [box_bottom(width: width, tier: tier)]))
  RenderFrame { lines: all, cursor_action: Append }
}

fn render_slowest_witnesses_box(body: List<String>, hot_count: Int, width: Int, color: Bool) -> String {
  let cap = render_capability(color: color)
  extdeps.render.terminal.serialize_frame(
    frame: boxed_frame_hot(title: "TOP SLOWEST WITNESSES (by eval)", body: body, hot_count: hot_count, width: width, tier: cap.tier, color: color),
    cap: cap
  )
}

fn slowest_witness_default_hot_count(body: List<String>) -> Int {
  let n = count(body)
  if n < 3 { n } else { 3 }
}

fn render_slowest_witnesses_box_default(body: List<String>, width: Int, color: Bool) -> String {
  render_slowest_witnesses_box(body: body, hot_count: slowest_witness_default_hot_count(body: body), width: width, color: color)
}
