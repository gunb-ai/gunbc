module gunbc.runner_capacity_plan

import std.types { String, NonEmptyStr, Bool, Int, List }
import std.nat { Nat, nat_range_inclusive }
import product.placement_supply { HostIdentity }
import gunbc.build_cache_instance { RunnerSlotIdentity, runner_slot_identity_equal }
import gunbc.fleet_intent_network {
  operator_host_srv3, operator_host_srv4,
}
import gunbc.fleet_runner_connectivity {
  OrganizationRunnerRosterEvidence,
  RosterObserved,
  RosterReadUnavailable,
  runner_slot_connectivity_verdict_for_incarnation,
  materialized_width_for_host,
  local_incarnations_for_host,
  roster_is_converged_seven_fixture,
  SlotConnectivityDetached,
  SlotConnectivityOrphaned,
  SlotConnectivityUnknown,
}
import gunbc.runner_incarnation { LocalRunnerSlotIncarnation }
import gunbc.runner_slot_allocation {
  gunbc_runner_slots_per_host,
  host_github_slot_count,
  host_fabric_slot_count,
  runner_slot_membership,
  committed_slot_identities,
  RunnerSlotMembership,
  CommittedSlotMember,
  SlotOutsideCommittedPopulation,
  RunnerSlotPurpose,
  SlotServesGitHubActions,
  SlotServesFabricExecution,
}

data runner_capacity_plan_authority_note: String = "SINGLE AUTHORITY for RunnerCapacity plan actions and stable slot identities. requested_width, admission, and observed_width are SEPARATE facts — count equality is a POSTCONDITION, never a refusal. Additions are the run of slot indices between observed and the host's GitHub ceiling, DERIVED rather than enumerated, and clamped to the GitHub population so this plan can never add a compute-fabric slot. The admission ceiling DERIVES from gunbc.runner_slot_allocation rather than restating it, so a width no host is admitted to carry is refused instead of admitted and left unfulfilled. The plan is not a circular controller that waits for a receipt before planning actuation. Connectivity repair folds into the same plan: active+offline or active+absent becomes RunnerIncarnationReplace; roster unavailable refuses destructive actions."

type RunnerCapacityAction
  = RunnerSlotAdd { to: RunnerSlotIdentity }
  | RunnerSlotChange { from: RunnerSlotIdentity, to: RunnerSlotIdentity }
  | RunnerSlotRemove { from: RunnerSlotIdentity }
  | RunnerIncarnationReplace { slot: RunnerSlotIdentity, cause: String }

type WidthAdmission
  = WidthAdmitted { width: Int }
  | WidthRefused { requested: Int, cause: String }

type RunnerCapacityHostPlan {
  host: HostIdentity
  requested_width: Int
  admission: WidthAdmission
  observed_width: Int
  actions: List<RunnerCapacityAction>
}

type RunnerCapacityPlan
  = PlanReady { hosts: List<RunnerCapacityHostPlan> }
  | PlanRefused { reason: String }

// THE FIFTH BUCKET, AND THE ONE THAT MADE THE OTHER FOUR ACADEMIC. This recognized exactly "7",
// "5" and "0" and refused everything else, so the production actuator -- gunbc.apply, in both plan
// and apply mode -- could not ask for a width of SIX. Every repair below this point was unreachable
// from the only entry point that drives it: the committed width of the managed hosts was
// unspellable at the CLI boundary, and the refusal arrived before the planner was ever consulted.
//
// It is the same 14GiB-era artifact as the enumerators and the admission ceiling, wearing the shape
// of a parser. A parse is a total decision procedure over its input, not a membership test against
// the widths someone had in mind on the day it was written.
//
// IT ALSO ADMITTED ZERO WHILE ITS OWN CALLER REFUSED IT AS "must be a positive integer". Zero is
// now refused here, which makes that message true rather than merely adjacent: admit_runner_capacity_width
// rejects a non-positive width immediately afterward, so the only thing the zero arm ever bought
// was a refusal at the wrong layer with the wrong reason.
fn parse_positive_width(value: String) -> Int? {
  match parse_int(s: value) {
    Absent => none
    Present { value: n } => if n > 0 { Present { value: n } } else { none }
  }
}

fn runner_slot_identity(host: HostIdentity, slot_index: Nat) -> RunnerSlotIdentity {
  RunnerSlotIdentity { host: host, slot_index: slot_index }
}

data slot_enumeration_narrow_class_note: String = "ERROR CLASS: A PLANNER'S ENUMERATION THAT COULD NOT SPELL A REQUESTED WIDTH ANSWERED 'NOTHING TO DO' (found 2026-08-21, dissolved by this change).\n\nINVALID STATE. desired_slot_indices bucketed a width into hardcoded literal lists — seven_slot_indices, five_slot_indices, one_slot_index — and addition_slot_indices spelled exactly one widening, (observed 5, requested 7). Every other widening fell to empty_nat_list. A twin pair, slot_indices_for_managed_width and local_incarnations_for_host, carried the same buckets in gunbc.fleet_runner_connectivity, so one concept had three implementations and eight duplicate constants across two modules (DESIGN 3).\n\nHARM, AND IT IS NOT THE ARITHMETIC. The 2026-08-17 16GiB ruling moved the managed hosts from width 7 to width 6. Nothing enumerated 6. srv3 and srv4 therefore carried a DECLARED provisioning target that the modeled capacity plan could not reach, and asking it to widen 5 to 6 returned zero actions — indistinguishable from a converged host with no work to do. The measurement: desired_slot_indices(6) yielded exactly FIVE indices, and addition_actions(srv3, requested 6, observed 5) yielded ZERO, while the superseded (5, 7) case still correctly yielded TWO. The enumerator worked only for the width the fleet no longer used.\n\nWHY IT SURVIVED. This is the empty-observation narrow, DESIGN 5: could-not-express rendered as the verdict 'nothing is affected'. It is the mirror of the absorbing fallback and strictly worse — a widen is merely expensive, a narrow is silently uncovered — and it zeroes its own frequency, so nothing ever ranked it for fixing. The existing witness could not see it either: runner_capacity_plan_witness_test asserted only the two NO-OP cases, requested == observed at widths 5 and 7, which stay green no matter what the enumerator can or cannot express. A test that only asks 'does a no-op produce nothing' cannot distinguish a working enumerator from one that produces nothing for everything.\n\nRUNG FOUND AT: mitigatable — nothing detected it, and it was found by executing the enumerator rather than by reading it. RUNG NOW: structurally impossible for this class. The buckets are gone; a run of naturals is derived by std.nat nat_range_inclusive, which is total over its inputs. There is no width the enumerator cannot express, so 'a width that falls through to empty' has no representation to be reached — validation is unnecessary because the state cannot be written (DESIGN 4b top rung).\n\nCEILING, AND WHY IT IS THE TOP. The class is decidable and fully modeled: a slot index run is a fact about the naturals, and nat_range_inclusive is its single authority. An empty list from it now means exactly one thing, a computed empty run, never 'the shape could not say'.\n\nTHE POPULATION WAS FIVE BUCKETS, NOT THREE, AND THE FIFTH MADE THE OTHERS ACADEMIC. Beyond the three enumerators: admit_runner_capacity_width refused above a hardcoded 7 for a hardcoded srv3/srv4 pair — the committed width restated, so it admitted a width no host carries and, because the host pair was hardcoded, gave srv1/srv2 no ceiling at all. And parse_positive_width, the entry point gunbc.apply drives in both plan and apply mode, recognized exactly \"7\", \"5\" and \"0\": the committed width of SIX was unspellable at the CLI boundary, so every repair in this module was unreachable from the only caller that actuates it. Both are dissolved — the ceiling derives from gunbc.runner_slot_allocation, the parse is a total decision over its input.\n\nWHAT THIS ROW DOES NOT COVER, STATED SO IT IS NOT READ AS A CLEAN SWEEP. The OBSERVED side of reconciliation is still a dense width, not a decoded roster: observed_slot_identities synthesizes a local prefix from materialized_width_for_host rather than consuming RosterObserved.registrations, so the production path cannot yet present the equal-count wrong-member observation that reconcile_slot_population is built to refuse. The decision fold is proven by direct witness; the production PRODUCER of that observation is not built. That is a declared residual and the next change on this seam."



fn observed_slot_identities(host: HostIdentity) -> List<RunnerSlotIdentity> {
  map(
    local_incarnations_for_host(host: host, width: materialized_width_for_host(host: host)),
    inc => inc.slot
  )
}

fn slot_identity_eq(a: RunnerSlotIdentity, b: RunnerSlotIdentity) -> Bool {
  runner_slot_identity_equal(a: a, b: b)
}


fn find_local_incarnation_for_slot(slot: RunnerSlotIdentity) -> LocalRunnerSlotIncarnation? {
  fold(
    local_incarnations_for_host(host: slot.host, width: materialized_width_for_host(host: slot.host)),
    init: none,
    f: (acc, inc) =>
      if inc.slot.slot_index == slot.slot_index {
        Present { value: inc }
      } else {
        acc
      }
  )
}

fn connectivity_replace_action(
  slot: RunnerSlotIdentity,
  roster: OrganizationRunnerRosterEvidence,
) -> RunnerCapacityAction? {
  match find_local_incarnation_for_slot(slot: slot) {
    Absent => none
    Present { value: inc } =>
      match runner_slot_connectivity_verdict_for_incarnation(incarnation: inc, roster: roster) {
        SlotConnectivityDetached { slot: s, registration_id: _ } =>
          Present {
            value: RunnerIncarnationReplace {
              slot: s,
              cause: "GitHub registration offline while local unit remains active"
            }
          }
        SlotConnectivityOrphaned { slot: s } =>
          Present {
            value: RunnerIncarnationReplace {
              slot: s,
              cause: "no GitHub registration for active local incarnation"
            }
          }
        SlotConnectivityUnknown { slot: _, reason: _ } => none
        _ => none
      }
  }
}

fn connectivity_actions_for_observed(
  roster: OrganizationRunnerRosterEvidence,
  observed: List<RunnerSlotIdentity>,
) -> List<RunnerCapacityAction>? {
  match roster {
    RosterReadUnavailable { reason: r } => none
    RosterObserved { observed_on: _, registrations: _ } =>
      Present {
        value: flat_map(
          observed,
          slot =>
            match connectivity_replace_action(slot: slot, roster: roster) {
              Present { value: a } => [a]
              Absent => []
            }
        )
      }
  }
}


// ADDITIONS ARE A SET DIFFERENCE ON THE DESIRED SIDE, NOT A DENSE RANGE BELOW A CEILING. The
// earlier form computed a GitHub COUNT and expanded it into a prefix, which is correct only while
// every GitHub member sits immediately below every fabric member. That is true today and is not a
// property of anything: it is the top-index placement of the one fabric slot, restated as an
// assumption in a second place.
//
// THE FAILURE IT REMOVES, WHICH THE EXACT-IDENTITY CARVE MAKES REACHABLE. Suppose srv3 later
// commits 7. The fabric member is srv3-06 and stays srv3-06, so the GitHub members are
// {01..05, 07}. The count is 6, the dense prefix below it is [06], and the planner would have
// proposed adding srv3-06 -- the fabric slot -- while srv3-07, the one actually missing, was never
// planned at all. The lifecycle gate refuses to register srv3-06, so that is fail-closed rather
// than double allocation; but the host could never converge, and the reason would be a planner
// enumerating through a member it was told to skip.
//
// Filtering the committed members by purpose has no such assumption: a fabric slot anywhere in the
// range is simply not in the desired GitHub set, and the missing member is whatever is missing.
//
// THE OBSERVED SIDE IS STILL A DENSE WIDTH AND THAT IS A DECLARED RESIDUAL, not an oversight. A
// true difference needs observed IDENTITIES decoded from the GitHub roster; observed_slot_identities
// synthesizes a dense local prefix from materialized_width_for_host instead. So this closes the
// desired half of the assumption and leaves the observed half open, named here rather than implied
// by the word "set".
fn desired_github_identities(host: HostIdentity, requested_width: Int) -> List<RunnerSlotIdentity> {
  fold(
    committed_slot_identities(host: host),
    init: [],
    f: (acc, id) =>
      if id.slot_index > requested_width {
        acc
      } else {
        match runner_slot_membership(host: host, slot_index: id.slot_index) {
          SlotOutsideCommittedPopulation { identity: _, committed_width: _ } => acc
          CommittedSlotMember { identity: _, purpose: p } =>
            match p {
              SlotServesFabricExecution => acc
              SlotServesGitHubActions => concat(acc, [id])
            }
        }
      }
  )
}

fn addition_actions(
  host: HostIdentity,
  requested_width: Int,
  observed_width: Int,
) -> List<RunnerCapacityAction> {
  fold(
    desired_github_identities(host: host, requested_width: requested_width),
    init: [],
    f: (acc, id) =>
      if id.slot_index > observed_width {
        concat(acc, [RunnerSlotAdd { to: id }])
      } else {
        acc
      }
  )
}

fn admit_runner_capacity_width(host: HostIdentity, requested: Int) -> WidthAdmission {
  let committed = gunbc_runner_slots_per_host(host: host)
  if requested <= 0 {
    WidthRefused { requested: requested, cause: "requested width must be positive" }
  } else if requested > committed {
    WidthRefused { requested: requested, cause: "requested width exceeds the host committed width derived by gunbc.runner_slot_allocation from its memory and disk admission; the ceiling is that authority's fact and is not restated here" }
  } else {
    WidthAdmitted { width: requested }
  }
}

fn observed_materialized_width_for_plan(
  host: HostIdentity,
  roster: OrganizationRunnerRosterEvidence,
) -> Int {
  if roster_is_converged_seven_fixture(roster: roster)
    && ((host as String) == (operator_host_srv3 as String) || (host as String) == (operator_host_srv4 as String)) {
    7
  } else {
    materialized_width_for_host(host: host)
  }
}

type SlotPopulationVerdict
  = SlotPopulationReconciled
  | SlotPopulationRefused { reason: String }

// RECONCILIATION COMPARES POPULATIONS, AND AN EARLIER REVISION OF THIS FUNCTION DID NOT -- IT TOOK
// AN INT. The annotation above it claimed it compared populations while the signature accepted only
// observed_width, which is precisely the proposition this module says counts cannot establish, and
// the comment asserted what the code omitted. It caught the unequal-count case (five expected, six
// observed) and MISSED the equal-count wrong-member case: observed GitHub {1,2,3,4,6} against
// expected {1,2,3,4,5} counts five on both sides and reconciles, while slot 06 -- the fabric
// member -- is occupied by an actions-runner and a legitimate GitHub member is missing.
//
// So it takes the observed identities and folds them. Each observed identity is one of three
// things, and only the first is acceptable: a committed member whose purpose is GitHub Actions; a
// committed member whose purpose is fabric execution, which means an actions-runner is registered
// in the fabric's slot; or an identity outside the committed population, which is
// over-provisioning against the host's own memory admission.
//
// IT REFUSES RATHER THAN REPAIRING, DELIBERATELY. Deregistering a live registered runner is
// destructive and belongs to an operator, not to a planner that inferred the situation from a
// roster read. The line stops, typed, naming the offending identity.
//
// WHAT THIS STILL CANNOT DO, AND IT IS NOT A GAP THIS MODULE CAN CLOSE. GitHub is an external
// authority. The model can make its OWN registration path incapable of creating a runner at a
// fabric slot -- that is structural, via the add-sequence gate -- but it cannot make GitHub
// incapable of ALREADY containing one that a person registered by hand. So desired-state
// disjointness is structural and observed disjointness stays an observation obligation: this
// function is where that observation is adjudicated when it arrives.
fn reconcile_observed_slot_identity(identity: RunnerSlotIdentity) -> SlotPopulationVerdict {
  match runner_slot_membership(host: identity.host, slot_index: identity.slot_index) {
    SlotOutsideCommittedPopulation { identity: _, committed_width: _ } =>
      SlotPopulationRefused {
        reason: "an observed runner slot lies outside the host committed population: the fleet is over-provisioned against its own memory admission, refusing rather than planning against a width this host was never admitted to carry"
      }
    CommittedSlotMember { identity: _, purpose: p } =>
      match p {
        SlotServesFabricExecution =>
          SlotPopulationRefused {
            reason: "a GitHub runner occupies a fabric execution slot: the observed roster registers a slot reserved for the fabric. Refusing rather than reading the host as converged — the counts can agree while the populations do not, and deregistering a live runner is an operator action, not a planner inference"
          }
        SlotServesGitHubActions => SlotPopulationReconciled
      }
  }
}

fn reconcile_slot_population(
  host: HostIdentity,
  observed: List<RunnerSlotIdentity>,
) -> SlotPopulationVerdict {
  fold(
    observed,
    init: SlotPopulationReconciled,
    f: (acc, id) =>
      match acc {
        SlotPopulationRefused { reason: r } => SlotPopulationRefused { reason: r }
        SlotPopulationReconciled => reconcile_observed_slot_identity(identity: id)
      }
  )
}

type HostCapacityPlanOutcome
  = HostCapacityPlanReady { plan: RunnerCapacityHostPlan }
  | HostCapacityPlanRefused { reason: String }

// THE OUTCOME CARRIES ITS REASON RATHER THAN BEING OPTIONAL. This returned RunnerCapacityHostPlan?
// and answered `none` for roster-unavailable, so every future refusal cause would have collapsed
// into that same silent Absent and the caller could only ever say "roster unavailable" -- it would
// have had to fabricate a reason it did not have. That is the state-space conflation DESIGN warns
// about, and the population refusal above is exactly the second cause that would have been
// swallowed by it.
fn plan_runner_capacity_host(
  host: HostIdentity,
  requested_width: Int,
  roster: OrganizationRunnerRosterEvidence,
) -> HostCapacityPlanOutcome {
  let admission = admit_runner_capacity_width(host: host, requested: requested_width)
  let observed_width = observed_materialized_width_for_plan(host: host, roster: roster)
  match admission {
    WidthRefused { requested: _, cause: _ } =>
      HostCapacityPlanReady {
        plan: RunnerCapacityHostPlan {
          host: host,
          requested_width: requested_width,
          admission: admission,
          observed_width: observed_width,
          actions: [],
        }
      }
    WidthAdmitted { width: admitted } =>
      match reconcile_slot_population(host: host, observed: observed_slot_identities(host: host)) {
        SlotPopulationRefused { reason: r } =>
          HostCapacityPlanRefused { reason: r }
        SlotPopulationReconciled =>
          match connectivity_actions_for_observed(roster: roster, observed: observed_slot_identities(host: host)) {
            Absent =>
              HostCapacityPlanRefused {
                reason: "runner roster read unavailable: refusing to plan destructive runner capacity actions against an observation that could not be taken"
              }
            Present { value: repairs } =>
              HostCapacityPlanReady {
                plan: RunnerCapacityHostPlan {
                  host: host,
                  requested_width: requested_width,
                  admission: admission,
                  observed_width: observed_width,
                  actions: concat(
                    repairs,
                    addition_actions(host: host, requested_width: admitted, observed_width: observed_width)
                  ),
                }
              }
          }
      }
  }
}

fn runner_capacity_plan(
  srv3_width: Int,
  srv4_width: Int,
  roster: OrganizationRunnerRosterEvidence,
) -> RunnerCapacityPlan {
  match plan_runner_capacity_host(host: operator_host_srv3, requested_width: srv3_width, roster: roster) {
    HostCapacityPlanRefused { reason: r } => PlanRefused { reason: r }
    HostCapacityPlanReady { plan: srv3 } =>
      match plan_runner_capacity_host(host: operator_host_srv4, requested_width: srv4_width, roster: roster) {
        HostCapacityPlanRefused { reason: r } => PlanRefused { reason: r }
        HostCapacityPlanReady { plan: srv4 } => PlanReady { hosts: [srv3, srv4] }
      }
  }
}

fn runner_capacity_add_count(plan: RunnerCapacityPlan, host: HostIdentity) -> Int {
  match plan {
    PlanRefused { reason: _ } => 0
    PlanReady { hosts: hs } =>
      fold(
        hs,
        init: 0,
        f: (n, h) =>
          if (h.host as String) == (host as String) {
            n + count_matching_actions(actions: h.actions, is_add: true)
          } else {
            n
          }
      )
  }
}

fn count_matching_actions(actions: List<RunnerCapacityAction>, is_add: Bool) -> Int {
  fold(
    actions,
    init: 0,
    f: (n, a) =>
      if is_add {
        match a {
          RunnerSlotAdd { to: _ } => n + 1
          _ => n
        }
      } else {
        match a {
          RunnerIncarnationReplace { slot: _, cause: _ } => n + 1
          _ => n
        }
      }
  )
}
