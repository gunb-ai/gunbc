module gunbc.host_build_cache_provision

import std.types { String, NonEmptyStr, Bool }
import std.cache_identity { CacheInterfaceId }
import std.disposition { Disposition, Scaffold, SingleAuthority, RealizationDispatch, Terminal }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import std.process { ProcessExit, exit_failure }
import std.resources { Network }
import extdeps.cache.sccache { sccache_local_id, sccache_fatal_error_log_fragment }
import gunbc.host_build_cache_catalog_gate {
  provision_build_cache_catalog_gate_verdict,
  ProvisionBuildCacheCatalogRealizable,
  ProvisionBuildCacheCatalogRefused,
}
import gunbc.host_effect { HostEffect, ProvisionBuildCache }
import gunbc.host_toolchain_ensure { host_toolchain_ensure, BuildCache }
import product.placement_supply { HostIdentity }

data provision_build_cache_widen_sketch_note: String = "RED-control fixture modeling the forbidden absorbing fallback (the -u RUSTC_WRAPPER cache-drop). The live instance ci_retry_escalation_level2 was REMOVED 2026-07-23 (STEP 2): the eagain retry now escalates to CARGO_BUILD_JOBS=1 (keep sccache) only, then fails loud via verify-build-artifacts — no cache-drop widen remains. This fixture stays as the RED control guarding the verdict fold against re-introduction; it must never ship as the authority."

data host_build_cache_provision_scope_disposition: Disposition = SingleAuthority

data host_build_cache_provision_realize_scaffold: Disposition = Scaffold {
  dissolves_to: RealizationDispatch,
  bind: DeclarationRef {
    module_path: "gunbc.host_effect_realize",
    decl_name: "realize_provision_build_cache",
    field: WholeDeclaration,
  }
}

data ci_sccache_opportunistic_detect_scaffold: Disposition = Scaffold {
  dissolves_to: RealizationDispatch,
  bind: DeclarationRef {
    module_path: "v2.workflow.ci_materialization_emit",
    decl_name: "ci_sccache_provider_shell_injection",
    field: WholeDeclaration,
  }
}
data build_cache_path_authority_observation_note: String = "CI and ctrl-build sessions consume the cache as bare `sccache` on PATH (RUSTC_WRAPPER=sccache), so provisioning the modeled binary is NOT sufficient — the PATH-visible sccache must BE the modeled one. A second sccache earlier in PATH (a distro package, a stale copy) is precisely the two-authority state this lane exists to remove, and it is invisible to a read-back that probes the absolute path: that read-back greens on the binary we provisioned while the compiler calls a different one. DaemonPathShadowed carries BOTH paths so the refusal is located (which binary won, which one was expected) rather than merely typed. This judgement is modeled HERE, in the verdict fold (proven by design_witness_path_shadow_refuses_fail_closed against a synthetic DaemonPathShadowed observation), not decided by the provisioning shell. Its LIVE observation is STAGED, not emitted: per the shell→dag census this module's script side is an A5 `decompose` row that must not grow its emitted shell surface, so the `command -v sccache` resolve waits for the typed-argv dissolve-on (#5828) rather than landing as hand-shell now (review 42343). The model carries the state and its refusal today; only the live producer is deferred."

data build_cache_supervision_observation_note: String = "A stats read-back CANNOT see whether the daemon it just talked to is supervised — and this is not a gap in the probe, it is the probe's semantics: any sccache invocation AUTO-STARTS a server if none is listening, so `--show-stats` manufactures the very evidence it reports. On srv3 2026-07-25 it printed a full stats table while the modeled unit had been `inactive (dead)` for six hours and no sccache process existed beforehand. Read through the verdict fold as it stood, that host observed DaemonStatsOk and therefore converged: the provisioning act would have reported success over a host with NO durable cache — a fabricated plausible output (§5), and the same shape as DaemonPathShadowed (a read-back that greens on evidence it produced rather than on the state the lane exists to establish). DaemonUnsupervised splits that conflation: 'a daemon answered' and 'the modeled supervisor is running it' are different states with different remedies, so they get different names rather than one Ok. The LIVE observation is STAGED exactly as the PATH-shadow one is — the supervisor read (`systemctl --user is-active`) is not emitted as hand-shell here, because this module's script side is an A5 `decompose` census row that may shrink but must not grow (review 42343); it lands with the typed-argv dissolve-on (#5828). The model carries the state and its refusal today; only the live producer is deferred. Construction covers the case this observation would catch on a host provisioned BY THIS LANE — build_cache_unit_daemon_runs_until_stopped makes the self-exiting unit unwritable — so the observation's standing job is the residue construction cannot reach: a host whose unit was stopped, masked, or replaced out of band."

type BuildCacheDaemonObservation
  = DaemonStatsOk { stats_line: String }
  | DaemonAbsent
  | DaemonUnresponsive { detail: NonEmptyStr }
  | DaemonMisconfigured { matched_fragment: String, detail: NonEmptyStr }
  | DaemonPathShadowed { resolved: String, expected: String }
  | DaemonUnsupervised { unit: String, unit_state: String }

type BuildCacheProvisionRefusal
  = RefusalDaemonAbsent
  | RefusalDaemonUnresponsive
  | RefusalDaemonMisconfigured
  | RefusalPrivilegeDenied
  | RefusalCatalogUnknown
  | RefusalPathShadowed
  | RefusalDaemonUnsupervised

type BuildCacheProvisionVerdict
  = ProvisionConverged { catalog_id: CacheInterfaceId, stats_line: String }
  | ProvisionRefused { cause: BuildCacheProvisionRefusal, reason: NonEmptyStr }

fn provision_build_cache_absorbing_fallback_widen_sketch(
  catalog_id: CacheInterfaceId,
  observed: BuildCacheDaemonObservation,
) -> BuildCacheProvisionVerdict {
  match observed {
    DaemonAbsent =>
      ProvisionConverged {
        catalog_id: catalog_id,
        stats_line: "local-build-without-rustc-wrapper-widen-sketch",
      }
    DaemonStatsOk { stats_line: line } =>
      ProvisionConverged { catalog_id: catalog_id, stats_line: line }
    DaemonUnresponsive { detail: d } =>
      ProvisionRefused { cause: RefusalDaemonUnresponsive, reason: d }
    DaemonMisconfigured { matched_fragment: frag, detail: d } =>
      ProvisionRefused {
        cause: RefusalDaemonMisconfigured,
        reason: concat(concat(concat("host_build_cache_provision: ", frag), ": "), d) as NonEmptyStr,
      }
    DaemonPathShadowed { resolved: r, expected: e } =>
      ProvisionConverged {
        catalog_id: catalog_id,
        stats_line: concat("path-shadow-widen-sketch: ", concat(r, concat(" vs ", e))),
      }
    DaemonUnsupervised { unit: u, unit_state: s } =>
      ProvisionConverged {
        catalog_id: catalog_id,
        stats_line: concat("unsupervised-widen-sketch: ", concat(u, concat(" is ", s))),
      }
  }
}

fn build_cache_provision_gate_accepts(
  verdict: BuildCacheProvisionVerdict,
  observed: BuildCacheDaemonObservation,
) -> Bool {
  match observed {
    DaemonAbsent =>
      match verdict {
        ProvisionRefused { cause: _, reason: _ } => true
        ProvisionConverged { catalog_id: _, stats_line: _ } => false
      }
    DaemonStatsOk { stats_line: _ } =>
      match verdict {
        ProvisionConverged { catalog_id: _, stats_line: _ } => true
        ProvisionRefused { cause: _, reason: _ } => false
      }
    DaemonUnresponsive { detail: _ } =>
      match verdict {
        ProvisionRefused { cause: RefusalDaemonUnresponsive, reason: _ } => true
        ProvisionConverged { catalog_id: _, stats_line: _ } => false
        ProvisionRefused { cause: _, reason: _ } => false
      }
    DaemonMisconfigured { matched_fragment: _, detail: _ } =>
      match verdict {
        ProvisionRefused { cause: RefusalDaemonMisconfigured, reason: _ } => true
        ProvisionConverged { catalog_id: _, stats_line: _ } => false
        ProvisionRefused { cause: _, reason: _ } => false
      }
    DaemonPathShadowed { resolved: _, expected: _ } =>
      match verdict {
        ProvisionRefused { cause: RefusalPathShadowed, reason: _ } => true
        ProvisionConverged { catalog_id: _, stats_line: _ } => false
        ProvisionRefused { cause: _, reason: _ } => false
      }
    DaemonUnsupervised { unit: _, unit_state: _ } =>
      match verdict {
        ProvisionRefused { cause: RefusalDaemonUnsupervised, reason: _ } => true
        ProvisionConverged { catalog_id: _, stats_line: _ } => false
        ProvisionRefused { cause: _, reason: _ } => false
      }
  }
}

fn provision_build_cache_verdict(
  catalog_id: CacheInterfaceId,
  observed: BuildCacheDaemonObservation,
) -> BuildCacheProvisionVerdict {
  match provision_build_cache_catalog_gate_verdict(catalog_id: catalog_id) {
    ProvisionBuildCacheCatalogRefused { reason: reason } =>
      ProvisionRefused {
        cause: RefusalCatalogUnknown,
        reason: reason,
      }
    ProvisionBuildCacheCatalogRealizable =>
      match observed {
        DaemonStatsOk { stats_line: line } =>
          ProvisionConverged { catalog_id: catalog_id, stats_line: line }
        DaemonAbsent =>
          ProvisionRefused {
            cause: RefusalDaemonAbsent,
            reason: "host_build_cache_provision: sccache daemon absent; fail-closed, no local-build fallback" as NonEmptyStr,
          }
        DaemonUnresponsive { detail: d } =>
          ProvisionRefused { cause: RefusalDaemonUnresponsive, reason: d }
        DaemonMisconfigured { matched_fragment: frag, detail: d } =>
          ProvisionRefused {
            cause: RefusalDaemonMisconfigured,
            reason: concat(concat(concat("host_build_cache_provision: ", frag), ": "), d) as NonEmptyStr,
          }
        DaemonPathShadowed { resolved: r, expected: e } =>
          ProvisionRefused {
            cause: RefusalPathShadowed,
            reason: concat(
              concat("host_build_cache_provision: PATH resolves sccache to ", r),
              concat(
                concat(" but the modeled install authority is ", e),
                "; the compiler would call a binary this lane never provisioned. Fail-closed, no local-build fallback.",
              ),
            ) as NonEmptyStr,
          }
        DaemonUnsupervised { unit: u, unit_state: s } =>
          ProvisionRefused {
            cause: RefusalDaemonUnsupervised,
            reason: concat(
              concat("host_build_cache_provision: sccache answers but its supervisor unit ", u),
              concat(
                concat(" is ", s),
                "; the daemon is only alive because an invocation auto-started it, so it exits on its own idle timeout and nothing restarts it. Fail-closed, no local-build fallback.",
              ),
            ) as NonEmptyStr,
          }
      }
  }
}

fn provision_build_cache_effect_for_catalog(catalog_id: CacheInterfaceId) -> HostEffect {
  ProvisionBuildCache { catalog_id: catalog_id }
}

fn provision_build_cache_default_effect() -> HostEffect {
  provision_build_cache_effect_for_catalog(catalog_id: sccache_local_id)
}

fn provision_build_cache_routes_through_host_effect_apply() -> Bool {
  match host_build_cache_provision_realize_scaffold {
    Scaffold {
      dissolves_to: RealizationDispatch,
      bind: DeclarationRef { module_path: m, decl_name: n, field: _ },
    } =>
      m == "gunbc.host_effect_realize" && n == "realize_provision_build_cache"
    Terminal { reason: _ } => false
  }
}

fn daemon_absent_refuses_fail_closed() -> Bool {
  match provision_build_cache_verdict(
    catalog_id: sccache_local_id,
    observed: DaemonAbsent,
  ) {
    ProvisionRefused { cause: RefusalDaemonAbsent, reason: _ } => true
    ProvisionConverged { catalog_id: _, stats_line: _ } => false
  }
}

fn misconfigured_matches_cited_fragment() -> Bool {
  string_contains(
    s: sccache_fatal_error_log_fragment,
    pattern: "fatal error",
  )
}

func provision_build_cache(host: HostIdentity, catalog_id: CacheInterfaceId) -> ProcessExit
  uses net: Network
{
  match provision_build_cache_catalog_gate_verdict(catalog_id: catalog_id) {
    ProvisionBuildCacheCatalogRefused { reason: reason } => exit_failure(reason: reason as String)
    ProvisionBuildCacheCatalogRealizable => host_toolchain_ensure(host: host, kind: BuildCache)
  }
}
