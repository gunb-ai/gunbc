module gunbc.host_spark_serving_provision

import std.types { String, NonEmptyStr, Bool, FilePath }
import std.disposition { Disposition, SingleAuthority }
import std.process { ProcessExit, ExitSuccess, exit_failure }
import std.resources { Network }
import product.placement_supply { HostIdentity }
import extdeps.shell
import gunbc.package_delivery {
  materialize_spark_serving_ollama_runtime_bundle,
  SparkServingOllamaRuntimeMaterialized,
  SparkServingOllamaRuntimeDownloadRefused,
  SparkServingOllamaRuntimeIntegrityRefused,
  SparkServingOllamaRuntimeReceiptWriteRefused,
  SparkServingOllamaRuntimeWorkspaceRefused,
  SparkServingOllamaRuntimeArchiveExtractRefused,
  SparkServingOllamaRuntimeUnitWriteRefused,
  SparkServingOllamaRuntimeUnitEnableRefused,
  SparkServingOllamaRuntimeApiReadyRefused,
  SparkServingOllamaRuntimeModelPullRefused,
}
import gunbc.spark_serving_install_paths {
  spark_serving_runtime_executable,
  spark_serving_user_unit_path,
  spark_serving_models_root,
}

data host_spark_serving_provision_scope_disposition: Disposition = SingleAuthority

data host_spark_serving_provision_note: String = "Local-host Spark serving runtime materialization entry (#8225 runtime-bundle follow-on). Runs package_delivery.materialize_spark_serving_ollama_runtime_bundle on the invoking host as gunbc-automation — extract, place owned closure, write receipt, install user unit, enable service, pull gpt-oss:20b. Operative only when gunbc is present on that host; observed absent on srv5/srv6 2026-08-15 (host_spark_serving_gunbc_layout_note). Remote ensure delegates to this entry via gunbc run on the target (host_spark_serving_provision_script); plan/apply CAS is spark_serving_plan_apply."

data host_spark_serving_provision_realize_dispatch_note: String = "RealizationDispatch scaffold withheld until ProvisionSparkServing lands in gunbc.host_effect_realize as realize_provision_spark_serving (codex precedent: host_codex_runtime_provision_realize_scaffold binds realize_provision_codex_runtime). Interim remote actuation is spark_serving_provision_apply FleetSsh transport only — not realization dispatch; binding that interim path as RealizationDispatch was rung inflation (review 52354)."

fn materialize_spark_serving_on_local_host_refusal(
  outcome: SparkServingOllamaRuntimeMaterialization,
) -> String {
  match outcome {
    SparkServingOllamaRuntimeDownloadRefused { locator: l } =>
      join(["ollama archive download refused: ", l as String], "")
    SparkServingOllamaRuntimeIntegrityRefused { cause: c } => c as String
    SparkServingOllamaRuntimeReceiptWriteRefused { cause: c } => c as String
    SparkServingOllamaRuntimeWorkspaceRefused { cause: c } => c as String
    SparkServingOllamaRuntimeArchiveExtractRefused { cause: c } => c as String
    SparkServingOllamaRuntimeUnitWriteRefused { cause: c } => c as String
    SparkServingOllamaRuntimeUnitEnableRefused { cause: c } => c as String
    SparkServingOllamaRuntimeApiReadyRefused { cause: c } => c as String
    SparkServingOllamaRuntimeModelPullRefused { cause: c } => c as String
    SparkServingOllamaRuntimeMaterialized { receipt: _ } =>
      "host_spark_serving_provision: unexpected materialized outcome in refusal fold"
  }
}

func materialize_spark_serving_on_local_host() -> ProcessExit
  uses net: Network
{
  match materialize_spark_serving_ollama_runtime_bundle() {
    SparkServingOllamaRuntimeMaterialized { receipt: _ } => ExitSuccess
    other =>
      exit_failure(reason: materialize_spark_serving_on_local_host_refusal(outcome: other))
  }
}
