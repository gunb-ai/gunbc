module gunbc.ci_execution_plan


data ci_execution_plan_note: String = "Medium-neutral CI execution plan derived from gunbc.ci_spec gates and stages — NEVER from ci.yml parsing (owned CI control plane v0, docs/plans/owned-ci-control-plane-design.md). GitHub Actions YAML is a temporary sibling projection; this carrier is the scheduling authority for the local executor."

type CiExecutionStage
  = CiBuildStage
  | CiRegenStage
  | CiFloorStage

type CiExecutionSubject
  = PushToMain { head_sha: std.types.CommitSha, base_tree_hash: extdeps.git.object_store.GitObjectId }
  | PullRequestToMain {
      pr_number: Int,
      head_sha: std.types.CommitSha,
      base_ref: String,
      base_tree_hash: extdeps.git.object_store.GitObjectId,
      head_repo_full_name: String,
    }
  | OperatorRerun { head_sha: std.types.CommitSha, base_ref: String, base_tree_hash: extdeps.git.object_store.GitObjectId }
  | ForkPullRequestRefused { pr_number: Int, head_repo_full_name: String, reason: std.types.NonEmptyStr }

type CiExecutionPlan {
  subject: CiExecutionSubject
  stages: List<CiExecutionStage>
  check_name: std.types.NonEmptyStr
  owner: String
  repo: String
  floor_plan_entry: String
  floor_plan_function: String
}

fn ci_execution_default_stages() -> List<CiExecutionStage> {
  [CiBuildStage, CiRegenStage, CiFloorStage]
}

fn ci_execution_stage_wire(stage: CiExecutionStage) -> String {
  match stage {
    CiBuildStage => "build"
    CiRegenStage => "regen"
    CiFloorStage => "floor"
  }
}

fn owned_ci_executor_stage_labels() -> List<String> {
  map(ci_execution_default_stages(), stage => ci_execution_stage_wire(stage: stage))
}

fn ci_execution_plan_for_subject(subject: CiExecutionSubject) -> CiExecutionPlan {
  CiExecutionPlan {
    subject: subject,
    stages: ci_execution_default_stages(),
    check_name: owned_ci_check_name,
    owner: gunbc_repository.owner,
    repo: gunbc_repository.name,
    floor_plan_entry: floor_plan_entry,
    floor_plan_function: plan_function_name(p: CiFloorPlan),
  }
}

fn ci_subject_head_sha(subject: CiExecutionSubject) -> std.types.CommitSha? {
  match subject {
    PushToMain { head_sha: sha, base_tree_hash: _ } => Present { value: sha }
    PullRequestToMain { pr_number: _, head_sha: sha, base_ref: _, base_tree_hash: _, head_repo_full_name: _ } =>
      Present { value: sha }
    OperatorRerun { head_sha: sha, base_ref: _, base_tree_hash: _ } => Present { value: sha }
    ForkPullRequestRefused { pr_number: _, head_repo_full_name: _, reason: _ } => none
  }
}

fn ci_subject_identity_key(subject: CiExecutionSubject) -> String {
  match subject {
    PushToMain { head_sha: sha, base_tree_hash: _ } =>
      concat(concat(gunbc_default_branch_name, ":"), sha)
    PullRequestToMain { pr_number: _, head_sha: sha, base_ref: _, base_tree_hash: _, head_repo_full_name: _ } =>
      concat("pr:", sha)
    OperatorRerun { head_sha: sha, base_ref: _, base_tree_hash: _ } => concat("rerun:", sha)
    ForkPullRequestRefused { pr_number: _, head_repo_full_name: repo, reason: _ } =>
      concat("fork-refused:", repo)
  }
}

fn ci_pull_request_is_same_repo(head_repo_full_name: String) -> Bool {
  head_repo_full_name == gunbc_repository.full_name
}

fn ci_pull_request_targets_merge_branch(base_ref: String) -> Bool {
  base_ref == gunbc_default_branch_name
}
