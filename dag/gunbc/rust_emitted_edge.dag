module gunbc.rust_emitted_edge

import std.types { List, String }

// THE EDGES THE RUST EMITTER WRITES, ONE HOME FOR THEIR PROVENANCE. v1.compiler.emit_rust renders
// module paths; the crate partition (v2.workflow.rust_crate_partition) must see every module edge
// the emitted code carries, not only the edges the source imports declare. A source-acyclic
// closure can still be emitted into a crate graph that does not compile, so an edge whose origin
// is the EMITTER rather than the source is a realization edge the partition consumes with its
// provenance attached. An emitter-added edge that closes a cycle against the source edges is an
// emitter defect and the partition refuses it by name; it is never merged silently.
//
// This module lives under dag/ because the v1 emitter imports it and the v2 partition imports it:
// one producer, two readers, no second list.

// Only the provenances a producer emits are arms. SemanticSourceReference is a use-line the
// emitter derives from the source: an authored import (emit_imports), a reference-derived import
// (reference_derived_use_line_plan), or a service import (emit_module_full). Helper-carrier and
// service/CLI runtime-surface arms land with their producers, not before them. DeclaredImport is
// an authored import of an emitted module, returned whether or not a use-line for it survives: the
// emitted body may still path into that module inline (`crate::<module>::`), and those inline
// paths are not returned as edges (gunbc.guarantee_stall
// emitted_inline_crate_path_edges_unreturned_stall), so the crate partition reads the import as a
// structural over-approximation of the body's reach, computed as the answer. ServiceRuntimeSurface
// is the service runtime the emitter writes into every module that renders a service: the struct's
// `crate::dry_run::DryRunMode` field and constructor (v1.compiler.emit_rust emit_service_struct).
type EmittedEdgeProvenance
  = RuntimePrelude
  | ReexportFacade
  | SemanticSourceReference
  | DeclaredImport
  | ServiceRuntimeSurface

type EmittedEdgeTarget
  = EmittedModuleTarget { module: String }
  | EmittedCrateRootTarget

type EmittedEdge {
  from: String
  to: EmittedEdgeTarget
  provenance: EmittedEdgeProvenance
}

// THE ENDPOINT NAME. An edge row names a module by the basename of the file the emitter writes for
// it, so the projection from a module's dotted name to that basename is this module's fact, not the
// emitter's private one: v1.compiler.emit_rust renders files and paths with it, and a partition
// derived over dotted module names (v2.workflow.emitted_crate_workspace) maps onto edge endpoints
// with the same function. `main` renders as `main_mod` because it collides with the crate's own
// entry file.
fn module_to_filename(name: String) -> String {
  name |> split(delimiter: ".") |> join(separator: "_")
}

fn rust_module_emit_filename(module_name: String) -> String {
  let raw = module_to_filename(name: module_name)
  if raw == "main" { "main_mod" } else { raw }
}

// The runtime-support module every emitted module paths into. emit_prelude renders its prelude
// lines from the rows below, so the module named in the text and the module named by the edge are
// the same value.
data rust_runtime_prelude_module: String = "v1_rt"

fn rust_prelude_emitted_edges(module: String) -> List<EmittedEdge> {
  if module == rust_runtime_prelude_module {
    [
      EmittedEdge { from: module, to: EmittedCrateRootTarget, provenance: ReexportFacade }
    ]
  } else {
    [
      EmittedEdge {
        from: module,
        to: EmittedModuleTarget { module: rust_runtime_prelude_module },
        provenance: RuntimePrelude
      },
      EmittedEdge { from: module, to: EmittedCrateRootTarget, provenance: ReexportFacade }
    ]
  }
}

fn semantic_source_reference_edge(from: String, to_module: String) -> EmittedEdge {
  EmittedEdge { from: from, to: EmittedModuleTarget { module: to_module }, provenance: SemanticSourceReference }
}

fn declared_import_edge(from: String, to_module: String) -> EmittedEdge {
  EmittedEdge { from: from, to: EmittedModuleTarget { module: to_module }, provenance: DeclaredImport }
}

// The module the emitter writes the service runtime into (v1.compiler.emit_rust
// emit_dry_run_module); every service struct paths into it.
data rust_service_runtime_module: String = "dry_run"

fn service_runtime_surface_edge(from: String) -> EmittedEdge {
  EmittedEdge { from: from, to: EmittedModuleTarget { module: rust_service_runtime_module }, provenance: ServiceRuntimeSurface }
}

fn emitted_edge_target_module(edge: EmittedEdge) -> List<String> {
  match edge.to {
    EmittedModuleTarget { module: target } => [target]
    EmittedCrateRootTarget => []
  }
}
