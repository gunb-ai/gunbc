module gunbc.decl_facts_alias_refinement_seed_growth

import gunbc.roadmap.roadmap_model { RoadmapNodeId }
import gunbc.seed_growth { SeedGrowthJustification }
import std.decl_ref { DeclarationRef, WholeDeclaration }

// FORWARD-FREEZE RECEIPT for the hand Rust added so that the decl_facts reflection yields an alias, a
// refinement and a bodyless type as a TypeItem carrying the wrappers v2.std.type_binder already reads
// (type_decl_view, refinement_declaration_of_node). Authored because gunbc.seed_growth_admission
// seed_growth_forward_freeze_policy_note makes unenumerated hand growth in src/v1 a stop-line.
//
// WHAT THE CHANGE IS. Before it, a no-connective type declaration (Timestamp, NonEmptyStr, LeaseToken)
// reflected as an OtherItem over an empty Conj, so no declared carrier chain was readable.
// reflected_item_kind reclassifies it as a TypeItem for the reflection only (v1 item_kind is frozen
// and keeps its answer); marshal_non_connective_type_item builds the alias, bodyless or refinement
// wrapper; predicate_spelling and production_edge_value build the refinement's captured predicates and
// the production edge label type_binder reads.
//
// WHY THE FACT CARRIES A STANDING. The host cannot elaborate a where-predicate, so the captured
// predicates are reflected as source spellings and the DeclFact that carries them says so
// (v2.std.decl_index PredicateStanding, field predicate_standing; reflected_predicate_standing builds
// it). It is a field of the fact, not an edge in the clause tree, because resolve and infer fold every
// child of the captured predicate set as a predicate call. The obligation on the first change that
// reads predicates from reflected facts (Charter 5, the decl door emit_semantic_type_decl): it must
// refuse RefinementPredicatesSourceSpelled, and its own RED lands with it.
//
// WHY IT SERVES v2. The reflected carrier chain is what the Swift wire derivation reads, without a
// per-atom row (gunbc.v1.v1_maintenance_standing v1_seed_standing PURPOSE test).
//
// HAND-ITEM DELTA: +7 citable declarations, all in v1_compiler.coproduct_reflection.
data decl_facts_alias_refinement_seed_growth_justification: SeedGrowthJustification = SeedGrowthJustification {
  hand_authored_declarations: [
    DeclarationRef { module_path: "v1_compiler.coproduct_reflection", decl_name: "marshal_non_connective_type_item", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.coproduct_reflection", decl_name: "predicate_argument_spelling", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.coproduct_reflection", decl_name: "predicate_spelling", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.coproduct_reflection", decl_name: "production_edge_value", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.coproduct_reflection", decl_name: "refinement_rhs", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.coproduct_reflection", decl_name: "reflected_item_kind", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.coproduct_reflection", decl_name: "reflected_predicate_standing", field: WholeDeclaration }
  ],
  reason: "The host reflection is a host walk over the seed's own parsed nodes; an alias, a bodyless type and a refinement's captured predicates can only be turned into the wrapper shapes v2.std.type_binder reads where those parsed nodes are readable. The host cannot elaborate where-predicates, so it stamps their source-spelled standing instead of fabricating an elaboration.",
  owning_dissolution_lane: "v1-hand-queue-drain" as RoadmapNodeId,
  trigger: "Delete all seven when the declaration census is a MODELED operation over a modeled prepared inventory rather than a host walk; reflected_predicate_standing and PredicateStanding are deleted earlier, when the v2 reflection route elaborates where-predicates through body_lowering_fold.",
  current_boundary: "Confined to the type-declaration arm of decl_facts_corpus_walk and concept_decl_node: reflected_item_kind is used only there, and v1 item_kind and the parse-only declaration path are unchanged."
}
