module gunbc.install_media

import std.types { String, NonEmptyStr }
import std.upsert_decision {
  ObservationVerdict,
  Converged,
  Absent,
  Drifted,
  UpsertDecision,
  UpsertClassification,
  Noop,
  Apply,
  Refuse,
}

data install_media_doc: String = "Seeded install-media observation→verdict→plan (gunbc workflow policy). Not std — ISO remaster/fetch/replace semantics live here, not in universal resource namespace."

type SeededInstallMediaObservation
  = MediaAbsent
  | MediaConverged
  | MediaDrifted

type SeededInstallMediaPlan
  = Remaster
  | ReplaceAtomically
  | RefuseStale

fn classify_seeded_install_media(
  obs: SeededInstallMediaObservation,
) -> ObservationVerdict {
  match obs {
    MediaAbsent => Absent
    MediaConverged => Converged
    MediaDrifted => Drifted
  }
}

fn decision_for_seeded_install_media(
  verdict: ObservationVerdict,
) -> UpsertDecision<SeededInstallMediaPlan> {
  match verdict {
    Converged => Noop
    Absent => Apply { plan: ReplaceAtomically }
    Drifted => Apply { plan: Remaster }
    Conflict => Refuse { reason: "seeded install media conflict" as NonEmptyStr }
    Inaccessible => Refuse { reason: "seeded install media inaccessible" as NonEmptyStr }
    UnknownRefused => Refuse { reason: "seeded install media observation refused" as NonEmptyStr }
  }
}

fn classify_seeded_install_media_upsert(
  obs: SeededInstallMediaObservation,
) -> UpsertClassification<SeededInstallMediaPlan> {
  let verdict = classify_seeded_install_media(obs: obs)
  UpsertClassification {
    verdict: verdict,
    decision: decision_for_seeded_install_media(verdict: verdict),
  }
}
