module gunbc.source_layout_namespaces

import std.types { List, String }
import std.algebra { list_flat_map }
import gunbc.layout_namespace_row { LayoutNamespaceRow }
import gunbc.layout_namespace_row.roster { layout_namespace_row_roster }

// THE NAMESPACE ROWS OF THE REPOSITORY'S STORAGE POLICY: every namespace that directly contains a
// module. They are the union of each source tree's own row (gunbc.layout_namespace_row): gunbc's
// tree, and a calling repository's tree when its dag/ is composed into gunbc's. The layout check
// holds the union to the governed files as an identity join in both directions, so a namespace no
// tree declares and a declared namespace no file occupies are both refused. A namespace two trees
// both occupy may be declared by both; the rows are read as a set. Whether a file is generated is
// not recorded: gunbc.generated_artifact_registry is that fact's single authority.
fn layout_namespaces() -> List<String> {
  list_flat_map(xs: layout_namespace_row_roster, f: fn(row) { row.namespaces })
}
