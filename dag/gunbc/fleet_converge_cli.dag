module gunbc.fleet_converge_cli

data gunbc_converge_cli_stage0_receiver_disposition: std.disposition.Disposition = std.disposition.Terminal {  reason: "THERE IS NO STAGE0 RECEIVER, AND THERE WILL NOT BE ONE — that is the terminal state this row records, not a gap awaiting repair. Corrected 2026-08-16 (PR #8286, review 52676) when the cli-run driver cut deleted cli_run handle_converge: until then this row named that handler as the live argv transport, so a canonical disposition asserted a terminal hand-Rust route that no longer existed. The stale half was not the arm but the reason — DESIGN §3's stale-citation class, in a carrier the cut itself falsified.

WHY TERMINAL SURVIVES THE DELETION. Transport is a handler, one of N, never a fact about the interface (DESIGN §3), so removing the stage0 CLI transport does not demote this .dag interface — it removes one binding. All interpretation, the byte-locked receipt grammar, and every typed refusal cause remain modeled here and in gunbc.host_converge / gunbc.fleet_converge_apply, exactly as before; what changed is only which host reaches them.

WHAT REACHES THIS INTERFACE NOW. The modeled convergence spine — gunbc.fleet_converge_timer -> gunbc.fleet_converge_apply -> gunbc.host_effect_realize host_effect_apply — consuming modeled desired state and native host-effect realizations. The stage0 driver refuses the converge and serve verbs with a typed status-2 reason naming that spine.

WHY THE HANDLER WAS NOT REBUILT, since not-rebuilt is a decision and not an omission. The cheapest available implementation while the frozen v1 engine stands is resolve-a-.dag-entry plus build-an-interpreter-context plus run, and that is precisely why it is wrong: it would make the interpreter load-bearing for a capability at the moment two lanes are deleting it, converting removable debt into an architectural dependency (DESIGN §3, the deferred-deletion consequence catalogue). The Rust side carries no converge logic, and this row is not a scaffold pending dissolution: nothing here dissolves, because nothing temporary was built."
}

// SparkManagedAccessUnmeasured is the refusal for a Spark whose managed access nobody has looked
// at. It is distinct from SparkPreEnrollment, whose message says "no converge route exists until
// enrollment" -- srv5 and srv6 ARE enrolled (host_assimilation_program carries them with
// InferenceServingParticipation), so reporting them as pre-enrollment states something false about
// the fleet and points the remedy at the wrong thing. What is missing is a measurement, not an
// enrollment.
type ConvergeCliRefusalCause
  = PolicyUnsound { reason: String }
  | UnknownHost { host: String }
  | SparkPreEnrollment { host: String }
  | SparkManagedAccessUnmeasured { host: String, dissolves_on: String }
  | ComputeInventoryAbsent { host: String }
  | KnobFrontier { reason: String }

fn converge_cli_unknown_host_reason(host: String) -> String {
  concat("gunbc converge: unknown fleet host identity ", host)
}

fn converge_cli_compute_inventory_absent_reason(host: String) -> String {
  concat("gunbc converge: host resolved by fleet converge policy but absent from compute inventory ", host)
}

fn converge_cli_refusal_message(cause: ConvergeCliRefusalCause) -> String {
  match cause {
    PolicyUnsound { reason: why } => concat("gunbc converge: fleet policy unsound — ", why)
    UnknownHost { host: h } => converge_cli_unknown_host_reason(host: h)
    SparkPreEnrollment { host: h } => concat(concat("gunbc converge: ", h), " is a Spark pre-enrollment host — no runner slots or host layout exist yet (SPARK-SERVE-0 owns the repair); reach is probed at its modeled endpoint, and no converge route exists until enrollment")
    SparkManagedAccessUnmeasured { host: h, dissolves_on: trigger } => concat(concat(concat("gunbc converge: ", h), " is enrolled, but its managed automation principal has never been observed — refusing rather than assuming absent. Discharged by: "), trigger)
    ComputeInventoryAbsent { host: h } => converge_cli_compute_inventory_absent_reason(host: h)
    KnobFrontier { reason: why } => why
  }
}

type ConvergeCliReceipt {
  host: String
  applied: Int
  drifted: Int
  verdict: gunbc.host_converge.ConvergeVerdict
  reason: ConvergeCliRefusalCause?
}

fn converge_cli_receipt_line(r: ConvergeCliReceipt) -> String {
  concat(
    concat(concat("converge-receipt host=", r.host), concat(" applied=", to_string(r.applied))),
    concat(concat(" drifted=", to_string(r.drifted)), concat(" verdict=", gunbc.host_converge.converge_verdict_label(v: r.verdict)))
  )
}

fn converge_cli_receipt_converged(r: ConvergeCliReceipt) -> Bool {
  r.verdict == VerdictConverged
}

fn converge_cli_is_fleet_compute_host(host: String) -> Bool {
  host == (gunbc.fleet_intent_network.operator_host_srv1 as String)
    || host == (gunbc.fleet_intent_network.operator_host_srv2 as String)
    || host == (gunbc.fleet_intent_network.operator_host_srv3 as String)
    || host == (gunbc.fleet_intent_network.operator_host_srv4 as String)
}

// Provider-runtime cadence (Option A): srv1–srv4 fleet compute converge runs reconcile the
// pinned Codex bundle via converge_provider_runtime_codex_receipt after slice1/knob-frontier
// work (converge_cli_run_host_knobs) and join the adjunct into the host receipt before
// converge_cli_publish writes the converge-receipt line. The knob is registered in
// fleet_converge_policy (CodexRuntimeBundle). LocalShell is intentional for the per-host
// timer route (`--host self` → kernel hostname); cross-host named-host converge must refuse
// until transport selects SshShell per target — see codex_runtime_converge_local_shell_locus_note.
data codex_runtime_converge_local_shell_locus_note: String = "ProvisionCodexRuntime on the converge adjunct uses LocalShell — the observe/ensure/read-back script runs on the machine executing gunbc, not on a named remote host. Production cadence is the per-host timer (`gunbc converge --host self` resolves kernel hostname before routing). Named-host converge from another machine (e.g. converge_cli_run(\"srv2\") on srv1) must refuse until transport selects SshShell per target (review 51883; dissolve-on: fleet_ssh transport binding for ProvisionCodexRuntime, same class as realize_provision_build_cache SshShell arms)."

fn converge_kernel_short_hostname_from_content(raw: String) -> String {
  std.algebra.trim(s: raw)
}

fn converge_local_kernel_short_hostname() -> String {
  match gunbc.hostname_read.hostname_short_read_local() {
    HostnameShortCaptured { value: v } => v
    HostnameShortCaptureRefused { reason: _ } => ""
  }
}

fn converge_codex_runtime_local_locus_matches_host(host: String) -> Bool {
  let local = converge_local_kernel_short_hostname()
  local != "" && host == local
}

fn converge_provider_runtime_codex_receipt(host: String) -> ConvergeCliReceipt? {
  if !converge_cli_is_fleet_compute_host(host: host) {
    none
  } else {
    let local_hostname = converge_local_kernel_short_hostname()
    if local_hostname == "" || host != local_hostname {
      Present {
        value: ConvergeCliReceipt {
          host: host,
          applied: 0,
          drifted: 0,
          verdict: Absent,
          reason: Present {
            value: KnobFrontier {
              reason: concat(
                "converge_provider_runtime_codex: ProvisionCodexRuntime LocalShell refused — target host ",
                host,
                " does not match local kernel hostname ",
                local_hostname,
                "; cross-host transport is SshShell dissolve-on (review 51883)",
              ),
            },
          },
        },
      }
    } else {
    match gunbc.fleet_converge_apply.fleet_compute_host_for_identity(identity: host as product.placement_supply.HostIdentity) {
      Present { value: compute_host } =>
        Present {
          value: match gunbc.host_effect_realize.host_effect_apply(
            target: gunbc.host_effect.HostOs { node: compute_host },
            effect: gunbc.host_effect.ProvisionCodexRuntime {},
            evidence: gunbc.host_effect.host_effect_identity_evidence,
            transport: gunbc.host_effect.LocalShell,
          ) {
            Converged { evidence: _, applied: _ } =>
              ConvergeCliReceipt {
                host: host,
                applied: 1,
                drifted: 0,
                verdict: VerdictConverged,
                reason: none,
              }
            NotConverged { reason: why, applied: _ } =>
              ConvergeCliReceipt {
                host: host,
                applied: 0,
                drifted: 0,
                verdict: Absent,
                reason: Present { value: KnobFrontier { reason: why } },
              }
          }
        }
      Absent => none
    }
    }
  }
}

// Join semantics: host_knobs is PRIMARY so enrolled knob-frontier/slice1 refusal
// messages survive when the codex adjunct also reports a Present reason.
fn converge_cli_receipt_join_steps(primary: ConvergeCliReceipt, adjunct: ConvergeCliReceipt) -> ConvergeCliReceipt {
  ConvergeCliReceipt {
    host: primary.host,
    applied: primary.applied + adjunct.applied,
    drifted: primary.drifted + adjunct.drifted,
    verdict: gunbc.host_converge.converge_verdict_meet(a: primary.verdict, b: adjunct.verdict),
    reason: match primary.reason {
      Present { value: _ } => primary.reason
      Absent => adjunct.reason
    },
  }
}

fn converge_cli_codex_runtime_knob_registered_for_host(host: product.placement_supply.HostIdentity) -> Bool {
  match gunbc.host_converge.fleet_converge_policy() {
    ConvergePolicyDerived { hosts: hosts } =>
      match host_converge_for_identity(hosts: hosts, identity: host) {
        Present { value: hc } =>
          fold(
            hc.knobs,
            init: false,
            f: (acc, knob) => acc || knob.name == gunbc.host_converge.codex_runtime_bundle_knob(host: host).name,
          )
        Absent => false
      }
    ConvergePolicyUnsound { reason: _ } => false
  }
}

fn host_converge_for_identity(hosts: List<gunbc.host_converge.HostConverge>, identity: product.placement_supply.HostIdentity) -> gunbc.host_converge.HostConverge? {
  gunbc.host_converge.find_by_identity(hosts, identity: identity, key: fn(h) { h.identity })
}

fn converge_cli_routes_to_slice1(host: String) -> Bool {
  host == (gunbc.fleet_intent_network.operator_host_srv1 as String) || host == (gunbc.fleet_intent_network.operator_host_srv3 as String)
}

// APPLICABILITY, total over the fleet (operator verdict on PR 8045, join 3): every
// enrolled host identity has exactly one arm — a real converge route, or a TYPED
// frontier refusal naming what unblocks it. "Applicable" = a slice1 circuit exists for
// the host's knobs today. srv2/srv4 are knob-frontier (whole-host typed refusal, the
// pre-existing arm, dissolving as slice1 realizes their knobs); srv5/srv6 are
// PRE-ENROLLMENT (no runner slots, no host layout yet — SPARK-SERVE-0 owns the repair;
// their reach is probed at the modeled endpoint, gunbc.fleet_reach_endpoint) — a state
// DISTINCT from UnknownHost, which now means only an identity outside the fleet.
// SPARK-SERVE-0: the Sparks now have a ROUTE, and the route carries its own access standing.
// ConvergeSparkPreEnrollment was nullary, so "CONVERGE does not know about this host" and "CONVERGE
// knows about it and cannot act yet" were the same state -- and a state that cannot say what
// unblocks it cannot be discharged, only replaced. ConvergeSparkRoute names the blocker instead:
// today every Spark is SparkManagedAccessAbsent because the measured principal population admits
// only the human bootstrap account, and the grounded arm becomes reachable the moment a managed
// automation principal exists, with no widening edit to this coproduct.
// UNOBSERVED IS NOT ABSENT, and fusing them is what let this seam lie. The two-arm version had no
// state for "nobody has looked", so the only way to be total was to answer Absent -- and Absent
// asserts a measurement. A host we have never contacted and a host we contacted and found bare are
// different states with different remedies: the first is discharged by running a probe, the second
// by provisioning a principal.
type SparkManagedAccessStanding
  = SparkManagedAccessUnobserved { host: String, dissolves_on: String }
  | SparkManagedAccessAbsent { cause: String }
  | SparkManagedAccessGrounded

type FleetConvergeApplicability
  = ConvergeSlice1Route
  | ConvergeKnobFrontier
  | ConvergeSparkRoute { access: SparkManagedAccessStanding }
  | ConvergeOutsideFleet

// MEASURED, not assumed: a read-only probe of srv5 and srv6 found briansrls the only admitted
// principal and every managed-sounding candidate refused. The cause travels with the standing so a
// reader is not left to infer which of several remedies applies.
// THIS FUNCTION DOES NOT OBSERVE, AND NOW SAYS SO. It previously returned SparkManagedAccessAbsent
// with a cause ending "(measured, read-only probe)" -- a constant that ignored its host argument,
// executed nothing, and would keep reporting a measurement after the host changed. The measurement
// it referred to was performed by the hand-authored spark-canary-probe.yml, which has been deleted;
// a claim whose producer no longer exists is not evidence, and prose asserting a guarantee the
// mechanism does not implement is the exact class this repo keeps catching.
//
// It returns Unobserved rather than Absent because the model cannot cite a receipt for either
// answer. Absent would be the same lie one arm over.
fn spark_managed_access_standing(host: String) -> SparkManagedAccessStanding {
  SparkManagedAccessUnobserved {
    host: host,
    dissolves_on: "gunbc.fleet_multi_principal_probe fleet_multi_principal_probe_wet runs with srv5/srv6 in multi_principal_probe_hosts and its typed receipt grounds this standing",
  }
}

fn fleet_converge_applicability(host: String) -> FleetConvergeApplicability {
  if converge_cli_routes_to_slice1(host: host) {
    ConvergeSlice1Route
  } else {
    if host == (gunbc.fleet_intent_network.operator_host_srv2 as String) || host == (gunbc.fleet_intent_network.operator_host_srv4 as String) {
      ConvergeKnobFrontier
    } else {
      if host == (gunbc.fleet_intent_network.operator_host_srv5 as String) || host == (gunbc.fleet_intent_network.operator_host_srv6 as String) {
        ConvergeSparkRoute { access: spark_managed_access_standing(host: host) }
      } else {
        ConvergeOutsideFleet
      }
    }
  }
}

fn converge_cli_slice1_srv3_receipt() -> ConvergeCliReceipt {
  let result = gunbc.host_converge_slice1.host_converge_slice1_converge_srv3()
  if gunbc.host_converge_slice1.host_converge_slice1_host_result_all_valid(result: result) {
    ConvergeCliReceipt {
      host: gunbc.fleet_intent_network.operator_host_srv3 as String,
      applied: gunbc.host_converge_slice1.host_converge_slice1_host_result_applied_count(result: result),
      drifted: 0,
      verdict: VerdictConverged,
      reason: none,
    }
  } else {
    ConvergeCliReceipt {
      host: gunbc.fleet_intent_network.operator_host_srv3 as String,
      applied: gunbc.host_converge_slice1.host_converge_slice1_host_result_applied_count(result: result),
      drifted: 0,
      verdict: Absent,
      reason: Present {
        value: KnobFrontier {
          reason: match gunbc.host_converge_slice1.host_converge_slice1_host_result_refusal_reason(result: result) {
            Present { value: why } => why
            Absent => "host_converge_slice1: srv3 multi-unit convergence receipt validity gate failed"
          },
        },
      },
    }
  }
}

fn converge_cli_slice1_receipt(host: String) -> ConvergeCliReceipt {
  if host == (gunbc.fleet_intent_network.operator_host_srv3 as String) {
    converge_cli_slice1_srv3_receipt()
  } else {
    converge_cli_slice1_srv1_receipt()
  }
}

fn converge_cli_slice1_srv1_receipt() -> ConvergeCliReceipt {
  match gunbc.host_converge_slice1.host_converge_slice1_converge_loop() {
    HostConvergeSlice1Converged { applied_knobs: n, receipt: r } =>
      if gunbc.host_converge_slice1.host_converge_slice1_receipt_is_valid(receipt: r) {
        ConvergeCliReceipt {
          host: gunbc.fleet_intent_network.operator_host_srv1 as String,
          applied: n,
          drifted: 0,
          verdict: VerdictConverged,
          reason: none,
        }
      } else {
        ConvergeCliReceipt {
          host: gunbc.fleet_intent_network.operator_host_srv1 as String,
          applied: 0,
          drifted: 0,
          verdict: Absent,
          reason: Present {
            value: KnobFrontier {
              reason: "host_converge_slice1: receipt validity gate failed (read_back_converged && reapply_noop && verdict=converged)",
            },
          },
        }
      }
    HostConvergeSlice1TasksConverged { applied_knobs: n, receipt: r } =>
      if gunbc.host_converge_slice1.host_converge_slice1_tasks_receipt_is_valid(receipt: r) {
        ConvergeCliReceipt {
          host: gunbc.fleet_intent_network.operator_host_srv1 as String,
          applied: n,
          drifted: 0,
          verdict: VerdictConverged,
          reason: none,
        }
      } else {
        ConvergeCliReceipt {
          host: gunbc.fleet_intent_network.operator_host_srv1 as String,
          applied: 0,
          drifted: 0,
          verdict: Absent,
          reason: Present {
            value: KnobFrontier {
              reason: "host_converge_slice1: tasks receipt validity gate failed (read_back_converged && reapply_noop && verdict=converged)",
            },
          },
        }
      }
    HostConvergeSlice1Refused { reason: why } =>
      ConvergeCliReceipt {
        host: gunbc.fleet_intent_network.operator_host_srv1 as String,
        applied: 0,
        drifted: 0,
        verdict: Absent,
        reason: Present { value: KnobFrontier { reason: why } },
      }
  }
}

fn converge_cli_receipt_for_host(host_converge: gunbc.host_converge.HostConverge) -> ConvergeCliReceipt {
  match gunbc.fleet_converge_apply.converge_apply_for_host(host_converge: host_converge, transport: gunbc.host_effect.LocalShell) {
    Present { value: r } =>
      match r {
        Converged { evidence: _, applied: _ } =>
          ConvergeCliReceipt {
            host: host_converge.identity as String,
            applied: host_converge.knobs.length(),
            drifted: 0,
            verdict: VerdictConverged,
            reason: none,
          }
        NotConverged { reason: why, applied: _ } =>
          ConvergeCliReceipt {
            host: host_converge.identity as String,
            applied: 0,
            drifted: 0,
            verdict: Absent,
            reason: Present { value: KnobFrontier { reason: why } },
          }
      }
    Absent =>
      ConvergeCliReceipt {
        host: host_converge.identity as String,
        applied: 0,
        drifted: 0,
        verdict: Absent,
        reason: Present { value: ComputeInventoryAbsent { host: host_converge.identity as String } },
      }
  }
}

type ConvergeCliOutput {
  line: String
  converged: Bool
  reason: String?
}

fn converge_cli_receipt_from_memory_cap_verify(host: String, result: gunbc.host_runner_memory_cap_verify.RunnerMemoryCapVerifyRunResult) -> ConvergeCliReceipt {
  match result {
    RunnerMemoryCapVerifyObserved { receipt: r } =>
      ConvergeCliReceipt {
        host: host,
        applied: r.tally.converged,
        drifted: r.tally.drifted,
        verdict: r.verdict,
        reason: none,
      }
    RunnerMemoryCapVerifyRefused { host: _, reason: why } =>
      ConvergeCliReceipt {
        host: host,
        applied: 0,
        drifted: 0,
        verdict: Absent,
        reason: Present { value: KnobFrontier { reason: why } },
      }
  }
}

fn converge_cli_routes_to_memory_cap_verify(host: String) -> Bool {
  match gunbc.host_runner_memory_provision.runner_memory_host_converge(host: host as product.placement_supply.HostIdentity) {
    Present { value: _ } => true
    Absent => false
  }
}

fn converge_cli_verify_run(host: String) -> ConvergeCliReceipt {
  if converge_cli_routes_to_memory_cap_verify(host: host) {
    converge_cli_receipt_from_memory_cap_verify(
      host: host,
      result: gunbc.host_runner_memory_cap_verify.runner_memory_cap_verify_run(host: host as product.placement_supply.HostIdentity)
    )
  } else {
    ConvergeCliReceipt {
      host: host,
      applied: 0,
      drifted: 0,
      verdict: Absent,
      reason: Present {
        value: KnobFrontier {
          reason: concat(
            "host_runner_memory_cap_verify: no memory-cap converge knobs in fleet_converge_policy for ",
            host
          ),
        },
      },
    }
  }
}

// Receipt publication (CONVERGE-0 loop leg): on the SELF route — the per-host timer's
// route, where the deployment guarantees the host layout exists — the receipt line is
// WRITTEN to the declared receipts path before being printed, so a fold-side observation
// job can read the host's last converge standing without a new commit. Publication uses
// staging write + rename in the same directory (crash-safe; supersedes root-owned stale
// files when the service principal owns the directory — no elevation). Publication
// failure on that route FAILS CLOSED (converged=false with a typed reason): the loop's
// product is the published receipt, so an unpublished converge must not report success.
// Non-self routes (operator/CI supervised runs against a named host) are unchanged —
// no write is attempted, because nothing guarantees the receipts directory there.
fn fleet_converge_receipt_path(host: String) -> String {
  join([gunbc.host_layout.fleet_converge_receipt_dir, "/", host, "-converge-receipt.txt"], "")
}

// Same directory as the published receipt — POSIX rename permission is on the directory,
// not the file being replaced, so a root-owned stale receipt from the pre-b1 unit user
// can be superseded without elevation when the service principal owns the directory.
fn fleet_converge_receipt_staging_path(host: String) -> String {
  join([gunbc.host_layout.fleet_converge_receipt_dir, "/", host, "-converge-receipt.staging"], "")
}

fn converge_cli_atomic_receipt_write(host: String, content: String) -> String? {
  let staging = fleet_converge_receipt_staging_path(host: host)
  let final_path = fleet_converge_receipt_path(host: host)
  let w = extdeps.filesystem.filesystem_io.Filesystem.Write(path: staging, content: content)
  if !w.success {
    Present { value: concat("gunbc converge: receipt staging write failed — ", w.error) }
  } else {
    let moved = shell.Move.File(source: staging as std.types.FilePath, destination: final_path as std.types.FilePath)
    if moved.success {
      none
    } else {
      Present { value: "gunbc converge: receipt rename failed after staging write (mv over root-owned stale file should succeed when the directory is owned by the service principal)" }
    }
  }
}

// Applied means committed plus independent read-back (DESIGN section 5): rename alone is not the claim.
data converge_cli_receipt_owner_readback_required: Bool = true

// Interim owner readback routes through gunbc.command_runner.stat_owner_name_capture
// (command_runner_scaffold population). Dissolve-on: extdeps.filesystem.filesystem_io
// typed owner observation retires the stat argv arm.
data converge_cli_receipt_owner_readback_interim_note: String = "Owner readback uses command_runner stat_owner_name_capture (command_runner_scaffold) until extdeps.filesystem.filesystem_io carries a typed owner observation; then converge_cli_receipt_owner_readback routes through that extdep."

fn converge_cli_expected_receipt_owner_name() -> String {
  gunbc.fleet_posix_accounts.fleet_posix_operator_user.name
}

fn converge_cli_receipt_owner_readback(host: String) -> String? {
  let path = fleet_converge_receipt_path(host: host)
  let expected = converge_cli_expected_receipt_owner_name()
  match gunbc.command_runner.stat_owner_name_capture(path: path) {
    ProcessRefused { exit_code: _, stderr: e } =>
      Present { value: concat("gunbc converge: receipt owner read-back refused (stat): ", std.algebra.trim(s: e)) }
    ProcessOutputAbsent =>
      Present { value: "gunbc converge: receipt owner read-back refused (stat): admitted exit but no owner name on stdout" }
    ProcessOutputPresent { text: t } => {
      let owner = std.algebra.trim(s: t)
      if owner == expected {
        none
      } else {
        Present {
          value: concat(
            concat("gunbc converge: receipt owner read-back mismatch — expected ", expected),
            concat(" observed ", owner),
          ),
        }      }
    }
  }
}

fn converge_cli_publish(out: ConvergeCliOutput, resolved: String, revision_line: String) -> ConvergeCliOutput {
  let publish_err = converge_cli_atomic_receipt_write(
    host: resolved,
    content: join([out.line, "\n", revision_line, "\n"], ""),
  )
  match publish_err {
    Absent =>
      match converge_cli_receipt_owner_readback(host: resolved) {
        Absent => out
        Present { value: why } =>
          ConvergeCliOutput {
            line: out.line,
            converged: false,
            reason: Present { value: why },
          }
      }
    Present { value: why } =>
      ConvergeCliOutput {
        line: out.line,
        converged: false,
        reason: Present { value: why },
      }
  }
}

// Operator verdict join 1 (2026-08-09; construction rework 2026-08-10, the empty-observation
// narrow §5): the self route is where a host READS the desired ref, and the knob receipt
// alone cannot claim convergence while the deployed tree is not at the admitted revision.
// converge_cli_receipt_join_revision MEETS the knob verdict with the revision standing on
// the ConvergeVerdict lattice (converge_verdict_meet, Absent < Drifted < VerdictConverged)
// BEFORE the receipt line is rendered, so verdict=converged on the published converge-receipt
// line is only constructable when the revision was observed AND matched. RevisionUnobserved
// pulls the joint to Absent — an applied=0/drifted=0 knob run that never observed the desired
// revision can no longer render "converged" (bottom-as-ignorance is no longer written as
// bottom-as-answer). The collector (join 5, fleet_receipt_collector parse_converge_receipt_line)
// reads THIS one joint verdict off the converge-receipt line; converge_cli_revision_line
// carries the revision OBSERVATION as evidence (observed=/drift/unobserved) and no longer a
// second verdict= token, so the receipt holds exactly one verdict and the two cells cannot
// disagree. This REPLACES the former bool-only converge_cli_revision_gate, which demoted the
// converged flag while leaving the rendered line saying verdict=converged — the dual
// representation the collector inherited. Drifted names both sides (desired AND local):
// the catch-up's safe form is a compare-and-swap and so needs the prior. (This clause named
// tree-sync as that realization until 2026-08-21; it is not one -- see the note on
// converge_cli_revision_reason. The CAS-needs-the-prior reason is unaffected and is why the
// arm carries both operands.)
// The repo path is the ONE host_layout convention row.
// DECLARED IMPRECISION, next-rung item (review, 2026-08-10). RevisionUnobserved maps to
// Absent, but converge_verdict (host_converge) already mints Absent for "subject not present
// on the host". So the isolated verdict=absent TOKEN conflates two states with OPPOSITE
// remedies — install/converge the subject, vs fix the desired-ref observation (the srv1 b1
// git-credential defect — different lane). This is the sentinel review 50817 warned about on
// parse_converge_verdict_label, one level down in the value rather than the decode. It is
// fail-closed, not fail-open (both fold not-converged, so acceptance correctly fails and the
// collector is never misled), and the receipt as a WHOLE disambiguates: the self path always
// emits the converge-revision evidence line beside this one, so verdict=absent + "unobserved
// cause=" is the revision case and verdict=absent + "observed=<hex>" is the subject-absent
// case. Only the isolated line-1 token is ambiguous, and only to a human remedy-router who
// ignores line 2. A precise fix is a distinct Unobserved verdict, DEFERRED with the same
// reasoning as the GitObjectId-in-VerdictConverged trigger below: it widens the shared
// ConvergeVerdict enum that knob-only convergence uses and would never emit. That the enum
// cannot carry this without burdening an unrelated consumer is itself the dual-representation
// smell one rung up (the enum doing two jobs) — named here, not fixed here.
fn converge_cli_revision_verdict(standing: gunbc.fleet_desired_observe.FleetRevisionStanding) -> gunbc.host_converge.ConvergeVerdict {
  match standing {
    RevisionConverged { revision: _ } => VerdictConverged
    RevisionDrifted { desired: _, local: _ } => Drifted
    RevisionUnobserved { cause: _ } => Absent
  }
}

fn converge_cli_receipt_join_revision(r: ConvergeCliReceipt, standing: gunbc.fleet_desired_observe.FleetRevisionStanding) -> ConvergeCliReceipt {
  ConvergeCliReceipt {
    host: r.host,
    applied: r.applied,
    drifted: r.drifted,
    verdict: gunbc.host_converge.converge_verdict_meet(a: r.verdict, b: converge_cli_revision_verdict(standing: standing)),
    reason: r.reason,
  }
}

// THE REMEDY THIS NAMES MUST BE ONE ANOTHER MODULE WOULD PERFORM, and until this row it named one
// that `gunbc.live_deploy.deployed_tree_report` BLOCKS: "tree-sync is the catch-up realization".
// A tree-only publication moves the deployed HEAD to the admitted revision and thereby flips
// `roadmap_belt_actuate` `belt_revision_admission` from refusing to admitting WHILE THE INSTALLED
// BINARY IS STILL THE OLD ONE, so the belt's next tick dispatches a mixed realization that was never
// admitted as a release. Two authorities disagreed about one operation and the user-facing one was
// pointing at the unsafe half — the typed verdict was correct the whole time, which is what made it
// survive: nothing that reads the VERDICT is wrong, only the sentence a human acts on.
fn converge_cli_revision_reason(standing: FleetRevisionStanding) -> String? {
  match standing {
    RevisionConverged { revision: _ } => none
    RevisionDrifted { desired: d, local: l } =>
      Present {
        value: join([
          "gunbc converge: revision drift — desired ",
          extdeps.git.object_store.git_object_id_wire_hex(oid: d) as String,
          ", local tree at ",
          git_object_id_wire_hex(oid: l) as String,
          "; full host-release publication is required — tree-only synchronization is NOT convergence",
        ], ""),
      }
    RevisionUnobserved { cause: c } =>
      Present { value: concat("gunbc converge: desired revision unobserved — ", c) }
  }
}

fn converge_cli_revision_line(standing: gunbc.fleet_desired_observe.FleetRevisionStanding) -> String {
  match standing {
    RevisionConverged { revision: r } =>
      concat("converge-revision observed=", extdeps.git.object_store.git_object_id_wire_hex(oid: r) as String)
    RevisionDrifted { desired: d, local: l } =>
      join([
        "converge-revision drift desired=",
        extdeps.git.object_store.git_object_id_wire_hex(oid: d) as String,
        " local=",
        extdeps.git.object_store.git_object_id_wire_hex(oid: l) as String,
      ], "")
    RevisionUnobserved { cause: c } => concat("converge-revision unobserved cause=", c)
  }
}

fn converge_cli_output(host: String) -> ConvergeCliOutput {
  if host == "self" {
    let resolved = converge_cli_resolve_self(host: host)
    let r = converge_cli_run(host: resolved)
    let standing = gunbc.fleet_desired_observe.fleet_revision_standing(repo: gunbc.host_layout.srv1_gunbc_repo_root)
    let joint = converge_cli_receipt_join_revision(r: r, standing: standing)
    let base_reason = match r.reason {
      Present { value: cause } => Present { value: converge_cli_refusal_message(cause: cause) }
      Absent => none
    }
    converge_cli_publish(
      out: ConvergeCliOutput {
        line: converge_cli_receipt_line(r: joint),
        converged: converge_cli_receipt_converged(r: joint),
        reason: match converge_cli_revision_reason(standing: standing) {
          Present { value: why } => Present { value: why }
          Absent => base_reason
        },
      },
      resolved: resolved,
      revision_line: converge_cli_revision_line(standing: standing),
    )
  } else {
    converge_cli_output_with_verify(host: host, verify_only: false)
  }
}

fn converge_cli_verify_output(host: String) -> ConvergeCliOutput {
  converge_cli_output_with_verify(host: host, verify_only: true)
}

// MACHINE-ID HAZARD, checked (msg_1c4e0bce): self identity here derives from the
// kernel hostname — NEVER /etc/machine-id, which both Sparks share from one baked DGX
// image — machine-id is the duplicated non-anchor. Their SSH HOST KEYS ARE DISTINCT
// (bold-eagle measured all three algorithms differing on both hosts, 2026-08-09 — an
// earlier revision of this note claimed identical factory keys, which was FALSE), so
// host-key IS a valid identity anchor for srv5/srv6 today and the fingerprint
// enrollment registry can proceed against the two distinct keys with no repair
// prerequisite; do not plan around host-key regeneration. Hostname is itself only
// sound AFTER P0:host-identity-converge has set it; before that, two machines can
// resolve one name — which is why the fleet fold classifies duplicate receipts for one
// identity as a named ambiguity (never first-wins), so a collision surfaces as
// NotConverged instead of one machine's receipt silently satisfying the other.
// --host self (CONVERGE-0 loop leg): the per-host timer unit converges SELF, so the
// literal "self" resolves to the machine's own short hostname before routing — the ONE
// observation a host can always make about itself, read via extdeps.tools.hostname
// os.Hostname.ReadShort (hermetic mock: localhost), never an env var or a config file a
// deploy could skew. Any other value routes unchanged (the operator/CI form). An
// unresolvable read falls through as the literal, landing in UnknownHost — a typed
// refusal, never a fabricated identity.
fn converge_cli_resolve_self(host: String) -> String {
  if host == "self" {
    let line = converge_local_kernel_short_hostname()
    if line == "" {
      host
    } else {
      line
    }
  } else {
    host
  }
}

fn converge_cli_output_with_verify(host: String, verify_only: Bool) -> ConvergeCliOutput {
  let resolved = converge_cli_resolve_self(host: host)
  let r = if verify_only {
    converge_cli_verify_run(host: resolved)
  } else {
    converge_cli_run(host: resolved)
  }
  ConvergeCliOutput {
    line: converge_cli_receipt_line(r: r),
    converged: converge_cli_receipt_converged(r: r),
    reason: match r.reason {
      Present { value: cause } => Present { value: converge_cli_refusal_message(cause: cause) }
      Absent => none
    },
  }
}

fn converge_cli_run(host: String) -> ConvergeCliReceipt {
  let host_knobs = converge_cli_run_host_knobs(host: host)
  match converge_provider_runtime_codex_receipt(host: host) {
    Present { value: codex } => converge_cli_receipt_join_steps(primary: host_knobs, adjunct: codex)
    Absent => host_knobs
  }
}

fn converge_cli_run_host_knobs(host: String) -> ConvergeCliReceipt {
  match gunbc.host_converge.fleet_converge_policy() {
    ConvergePolicyUnsound { reason: why } =>
      ConvergeCliReceipt {
        host: host,
        applied: 0,
        drifted: 0,
        verdict: Absent,
        reason: Present { value: PolicyUnsound { reason: why } },
      }
    ConvergePolicyDerived { hosts: hosts } =>
      match fleet_converge_applicability(host: host) {
        ConvergeSlice1Route => converge_cli_slice1_receipt(host: host)
        ConvergeSparkRoute { access: SparkManagedAccessUnobserved { host: h, dissolves_on: trigger } } =>
          ConvergeCliReceipt {
            host: host,
            applied: 0,
            drifted: 0,
            verdict: Absent,
            reason: Present { value: SparkManagedAccessUnmeasured { host: h, dissolves_on: trigger } },
          }
        ConvergeSparkRoute { access: SparkManagedAccessAbsent { cause: _ } } =>
          ConvergeCliReceipt {
            host: host,
            applied: 0,
            drifted: 0,
            verdict: Absent,
            reason: Present { value: SparkPreEnrollment { host: host } },
          }
        ConvergeSparkRoute { access: SparkManagedAccessGrounded } =>
          match host_converge_for_identity(hosts: hosts, identity: host as product.placement_supply.HostIdentity) {
            Present { value: hc } => converge_cli_receipt_for_host(host_converge: hc)
            Absent =>
              ConvergeCliReceipt {
                host: host,
                applied: 0,
                drifted: 0,
                verdict: Absent,
                reason: Present { value: SparkPreEnrollment { host: host } },
              }
          }
        _ =>
          match host_converge_for_identity(hosts: hosts, identity: host as product.placement_supply.HostIdentity) {
          Present { value: hc } => converge_cli_receipt_for_host(host_converge: hc)
          Absent =>
            ConvergeCliReceipt {
              host: host,
              applied: 0,
              drifted: 0,
              verdict: Absent,
              reason: Present { value: UnknownHost { host: host } },
            }
          }
      }
  }
}
