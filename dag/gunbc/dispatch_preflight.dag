  DispatchHostEnvironment,
  CapabilityRealization,
}
import gunbc.roadmap_dispatch_environment {
  CapabilityEnsureReceipt,
  capability_ensure_observe,
  capability_ensure_receipt_json,
}
import gunbc.fleet_desired_observe {
  FleetRevisionStanding,
  RevisionConverged,
  RevisionDrifted,
  RevisionUnobserved,
  fleet_revision_standing,
}
