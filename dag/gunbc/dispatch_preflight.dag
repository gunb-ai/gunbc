}
import extdeps.shell

data dispatch_preflight_note: String = "THE CAPABILITY ADMISSION ONLY RUNS INSIDE A SPAWN, AND WHILE THE BELT REFUSES THERE IS NO SPAWN. gunbc.roadmap_dispatch_environment observes every declared CapabilityRealization and grounds it, but its only production caller is the per-attempt spawn path in gunbc.roadmap_belt_actuate. belt_tick_for_instance evaluates the fleet revision standing BEFORE it reaches any spawn, so a host whose deployed tree has drifted from refs/fleet/desired refuses spawn and reap and never once probes an executable. Measured on srv1 2026-08-28: the belt had been answering that refusal on every tick since 2026-08-20 with the deployed tree 664 commits behind main, and the capability roster had therefore not been exercised on the host for eight days. Whether git, tmux, the pipe shell, tee and jq still resolve for the service principal was, over that whole window, unmeasured rather than measured-good.\n\nThis module is the read-only route that answers it independently of whether a spawn is admissible. It observes and it does not actuate: capability_ensure_observe runs shell.Test.IsExecutable and the realization's own declared identity_args (the --version probes), and fleet_revision_standing runs git ls-remote and rev-parse in the deployed tree. No worktree is created, no tmux session is started, no file is written, and there is no flag that opens a write path — a preflight that can also change what it measures is a preflight whose green proves nothing.\n\nTHE SUBJECT IS THE DECLARED ROSTER, NOT A CONTRACT'S REQUIREMENTS. dispatch_environment_admit probes the capabilities one WorkItemExecutionContract requires; a preflight has no work item, and narrowing to some contract's subset would report a green over capabilities the next work item needs. So the subject is environment.realizations itself — everything the instance declares it can realize — which is a superset of any contract's requirement set and is derived from the instance rather than chosen here.\n\nSIBLINGS CONTINUE. Every axis is evaluated and every refusal is carried, because the first refusal is a prefix of the truth and a preflight that returns at the first one reports the producer's patience rather than the host's state. The verdict counts them."

data dispatch_preflight_schema: String = "roadmap-dispatch-preflight/v1"

data dispatch_preflight_provider_auth_gap_note: String = "PROVIDER AUTHENTICATION IS NOT AN AXIS HERE, AND NAMING IT AS A PERMANENTLY-UNOBSERVED ONE WOULD BE WORSE THAN OMITTING IT. gunbc.roadmap_dispatch_environment's own header already draws this line — cached OAuth and upstream quota are provider protocol facts, not executable identity — and gunbc.provider_standing already models the shape the answer would take (ProviderAuthenticationStanding), while gunbc.claude_setup_token_enrollment models the classification (ClaudeCredentialStanding). What does not exist is an OBSERVER: nothing in the corpus reads a credential store and derives either. An arm that could only ever answer Unobserved is a decoration that reads as coverage (DESIGN 4b), so this module carries none.\n\nThe gap is real and was measured rather than assumed. On srv1 2026-08-28 the service principal's Claude credential file was present at 0600 with a refresh token, and its claudeAiOauth.expiresAt was roughly ninety minutes in the past; whether the CLI would have refreshed on first use is untested, because a refresh is a write and that pass was read-only. NEXT-RUNG TRIGGER: a modeled read-then-decode observation over the credential store — extdeps.filesystem.filesystem_io Read into extdeps.languages.json.parse, compared against Clock.Now — producing ClaudeCredentialStanding from live bytes. When that lands it joins this report as a fourth axis and this row dissolves. Until then the honest statement is that this preflight does not answer it."

// One axis of the preflight. The label names WHAT was examined and is the join key a
// reader uses; grounded/refused is the verdict. A refusal carries its own reason so a
// report with several refusals says several different things rather than one.
type PreflightAxisVerdict
  = AxisGrounded { axis_label: String, evidence: String }
  | AxisRefused { axis_label: String, reason: String }


fn axis_verdict_is_refused(verdict: PreflightAxisVerdict) -> Bool {
  match verdict {
    AxisGrounded { axis_label: _, evidence: _ } => false
    AxisRefused { axis_label: _, reason: _ } => true
  }
}

fn axis_verdict_json(verdict: PreflightAxisVerdict) -> JsonValue {
  match verdict {
    AxisGrounded { axis_label, evidence } =>
      json_object(members: [
        json_kv(key: "axis", value: json_string(s: axis_label)),
        json_kv(key: "grounded", value: json_bool(b: true)),
        json_kv(key: "evidence", value: json_string(s: evidence)),
      ])
    AxisRefused { axis_label, reason } =>
      json_object(members: [
        json_kv(key: "axis", value: json_string(s: axis_label)),
        json_kv(key: "grounded", value: json_bool(b: false)),
        json_kv(key: "reason", value: json_string(s: reason)),
      ])
  }
}

data dispatch_preflight_capability_axis_label: String = "capability"
data dispatch_preflight_revision_axis_label: String = "deployed-revision"

// The capability axis is derived from the receipt the shared observer already produced,
// so this module mints no second notion of what grounded means.
fn capability_axis_verdict(receipt: CapabilityEnsureReceipt) -> PreflightAxisVerdict {
  if receipt.grounded {
    AxisGrounded {
      axis_label: join([dispatch_preflight_capability_axis_label, ":", receipt.capability_label], ""),
      evidence: receipt.evidence,
    }
  } else {
    AxisRefused {
      axis_label: join([dispatch_preflight_capability_axis_label, ":", receipt.capability_label], ""),
      reason: receipt.reason,
    }
  }
}

fn preflight_capability_receipts(
  environment: DispatchHostEnvironment,
) -> List<CapabilityEnsureReceipt> {
  map(environment.realizations, realization =>
    capability_ensure_observe(realization: realization))
}

// The revision axis is the one that decides whether ANY spawn can happen, so it is
// reported beside the capabilities rather than ahead of them: a host may be perfectly
// provisioned and still spawn nothing, and a reader needs to see both facts at once.
fn revision_axis_verdict(standing: FleetRevisionStanding) -> PreflightAxisVerdict {
  match standing {
    RevisionConverged { revision } =>
      AxisGrounded {
        axis_label: dispatch_preflight_revision_axis_label,
        evidence: join([
          "deployed tree is the admitted fleet revision ",
          git_object_id_wire_hex(oid: revision) as String,
        ], ""),
      }
    RevisionDrifted { desired, local } =>
      AxisRefused {
        axis_label: dispatch_preflight_revision_axis_label,
        reason: join([
          "deployed tree is not the admitted fleet revision; the belt will withhold spawn and reap on every tick until it converges. desired=",
          git_object_id_wire_hex(oid: desired) as String,
          " local=",
          git_object_id_wire_hex(oid: local) as String,
        ], ""),
      }
    RevisionUnobserved { cause } =>
      AxisRefused {
        axis_label: dispatch_preflight_revision_axis_label,
        reason: join([
          "deployed revision could not be observed; the belt will withhold spawn and reap. cause=",
          cause,
        ], ""),
      }
  }
}

type DispatchPreflightReport {
  instance_id: String
  repo_root: String
  capability_receipts: List<CapabilityEnsureReceipt>
  axes: List<PreflightAxisVerdict>
}

type DispatchPreflight
  = PreflightAdmitted { report: DispatchPreflightReport }
  | PreflightRefused { report: DispatchPreflightReport, refused_axis_count: Int }

fn preflight_report_for_instance(
  instance: HostDashboardInstance,
) -> DispatchPreflightReport {
  let receipts = preflight_capability_receipts(
    environment: instance.execution_environment,
  )
  DispatchPreflightReport {
    instance_id: instance.instance_id as String,
    repo_root: instance.repo_root as String,
    capability_receipts: receipts,
    axes: concat(
      map(receipts, receipt => capability_axis_verdict(receipt: receipt)),
      [
        revision_axis_verdict(
          standing: fleet_revision_standing(repo: instance.repo_root),
        ),
      ],
    ),
  }
}

// The verdict is a fold over EVERY axis, never a return at the first refusal: a first
// refusal bounds the producer's patience rather than the host's state, and an operator
// who repairs the one axis they were shown has no way to learn there were three.
fn preflight_verdict_for_report(report: DispatchPreflightReport) -> DispatchPreflight {
  let refused = count(filter(report.axes, a => axis_verdict_is_refused(verdict: a)))
  if refused == 0 {
    PreflightAdmitted { report: report }
  } else {
    PreflightRefused { report: report, refused_axis_count: refused }
  }
}

fn dispatch_preflight_for_instance(
  instance: HostDashboardInstance,
) -> DispatchPreflight {
  preflight_verdict_for_report(
    report: preflight_report_for_instance(instance: instance),
  )
}


fn dispatch_preflight_json_value(preflight: DispatchPreflight) -> JsonValue {
  match preflight {
    PreflightAdmitted { report } =>
      json_object(members: [
        json_kv(key: "schema", value: json_string(s: dispatch_preflight_schema)),
        json_kv(key: "instance_id", value: json_string(s: report.instance_id)),
        json_kv(key: "repo_root", value: json_string(s: report.repo_root)),
        json_kv(key: "status", value: json_string(s: "admitted")),
        json_kv(key: "refused_axis_count", value: json_int(n: 0)),
        json_kv(
          key: "axes",
          value: json_array(elements: map(report.axes, a => axis_verdict_json(verdict: a))),
        ),
        json_kv(
          key: "capability_receipts",
          value: json_array(elements: map(report.capability_receipts, r =>
            capability_ensure_receipt_json(receipt: r))),
        ),
      ])
    PreflightRefused { report, refused_axis_count } =>
      json_object(members: [
        json_kv(key: "schema", value: json_string(s: dispatch_preflight_schema)),
        json_kv(key: "instance_id", value: json_string(s: report.instance_id)),
        json_kv(key: "repo_root", value: json_string(s: report.repo_root)),
        json_kv(key: "status", value: json_string(s: "refused")),
        json_kv(key: "refused_axis_count", value: json_int(n: refused_axis_count)),
        json_kv(
          key: "axes",
          value: json_array(elements: map(report.axes, a => axis_verdict_json(verdict: a))),
        ),
        json_kv(
          key: "capability_receipts",
          value: json_array(elements: map(report.capability_receipts, r =>
            capability_ensure_receipt_json(receipt: r))),
        ),
      ])
  }
}

data dispatch_preflight_spelling_note: String = "TWO SPELLINGS, ONE IMPLEMENTATION, for the same reason belt_run_once_in exists: dispatch_preflight_json is the surface a reader invokes by hand to SEE the report whatever it says, and dispatch_preflight_cli is the surface a caller invokes to have the line STOP on a refusal. Both route through dispatch_preflight_for_instance, so the printed report and the exit status cannot disagree. The refusal carries the whole report in its reason rather than a summary, because a caller that has just been told the preflight failed needs the axes, not the count.\n\nONLY THE BY-HAND SPELLING DEFAULTS TO PRODUCTION, and the asymmetry is deliberate rather than an oversight in one of the two. dispatch_preflight_json takes no channel and names srv1_live_dashboard_instance directly, exactly as belt_run_once does and for the same reason: it is an inspection surface someone invokes against production, where the subject is what they came for. dispatch_preflight_cli is the SCHEDULED spelling -- the one a unit or another host could invoke -- so it reads the workdir channel and fail-closes on its absence rather than inheriting a default that would silently make a lab caller a production reader."

fn dispatch_preflight_json_for_instance(instance: HostDashboardInstance) -> String {
  serialize_json(v: dispatch_preflight_json_value(
    preflight: dispatch_preflight_for_instance(instance: instance),
  ))
}

fn dispatch_preflight_json() -> String {
  dispatch_preflight_json_for_instance(instance: srv1_live_dashboard_instance())
}

fn dispatch_preflight_cli_for_instance(instance: HostDashboardInstance) -> ProcessExit {
  let preflight = dispatch_preflight_for_instance(instance: instance)
  match preflight {
    PreflightAdmitted { report: _ } => ExitSuccess
    PreflightRefused { report: _, refused_axis_count: _ } =>
      exit_failure(
        reason: serialize_json(v: dispatch_preflight_json_value(preflight: preflight)),
      )
  }
}

type PreflightWorkdirLookup
  = PreflightInstanceResolved { instance: HostDashboardInstance }
  | PreflightUnknownWorkdir { workdir: String }

// The same instance resolution the belt tick performs, and it is deliberately the same
// SHAPE rather than a shared call: importing gunbc.roadmap_belt_actuate for one lookup
// would put the whole belt -- spawn, reap, verify, publish -- behind a read-only probe.
fn preflight_instance_for_workdir(workdir: String) -> PreflightWorkdirLookup {
  if workdir == (srv1_live_dashboard_instance().repo_root as String) {
    PreflightInstanceResolved { instance: srv1_live_dashboard_instance() }
  } else {
    PreflightUnknownWorkdir { workdir: workdir }
  }
}

fn dispatch_preflight_cli_in(spawn_workdir: String) -> ProcessExit {
  match preflight_instance_for_workdir(workdir: spawn_workdir) {
    PreflightUnknownWorkdir { workdir: w } =>
      exit_failure(reason: join([
        "dispatch_preflight_cli: GUNBC_BELT_SPAWN_WORKDIR does not match a known dashboard instance repo root: ",
        w,
      ], ""))
    PreflightInstanceResolved { instance } =>
      dispatch_preflight_cli_for_instance(instance: instance)
  }
}

data dispatch_preflight_workdir_channel_note: String = "THE PREFLIGHT READS THE SAME CHANNEL THE TICK READS, AND FAIL-CLOSES THE SAME WAY, because a preflight that defaults to production's tree answers about a host the caller did not ask about. belt_spawn_workdir_is_a_parameter_note records why the belt refuses a missing or empty GUNBC_BELT_SPAWN_WORKDIR rather than defaulting it; the identical argument applies with the identical force here, and one direction weaker: a preflight that silently probed production would report a green that a lab caller would read as being about their own instance. shell.Env.Get returns Present-but-empty for an unset variable wet, so both fold into one refusal."

fn dispatch_preflight_cli() -> ProcessExit {
  match shell.Env.Get(name: belt_spawn_workdir_env_var).value {
    Absent =>
      exit_failure(reason: "dispatch_preflight_cli: GUNBC_BELT_SPAWN_WORKDIR not set — the preflight subject is a per-deployment fact and defaulting it would report about production's tree (fail-closed)")
    Present { value: workdir } =>
      if string_length(s: workdir) == 0 {
        exit_failure(reason: "dispatch_preflight_cli: GUNBC_BELT_SPAWN_WORKDIR is empty — the preflight subject is a per-deployment fact and defaulting it would report about production's tree (fail-closed)")
      } else {
        dispatch_preflight_cli_in(spawn_workdir: workdir)
      }
  }
}
