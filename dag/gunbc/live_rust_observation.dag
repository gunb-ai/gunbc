module gunbc.live_rust_observation

import gunbc.stage0_rust_host_observation {
  RustSourceHostObservation,
  RustManifestObserved,
  RustManifestReadRefused,
  RustManifestParseRefused,
  GitObservationRefused,
  current_stage0_rust_source_observation
}
import gunbc.stage0_rust_source_lifecycle_scaffold {
  RustSourceManifestStateVerdict,
  rust_source_manifest_state_verdict
}
import std.types { CommitSha, ContentHash, Int, String }
import v2.std.algebra { length }

data live_rust_observation_note: String = "THE CLOSING CONTRACT FOR THE RUST-SOURCE OBSERVATION: proof that a run observed the exact subject it claims to have tested, rather than proof that an observation function is callable.\n\nWHAT MAKES THIS EVIDENCE RATHER THAN A GREEN LIGHT. The expected revision is supplied by the workflow runner (extdeps.github.actions_environment GITHUB_SHA), NOT derived from the repository the observation reads. Deriving both sides with git would compare git to itself -- true by construction, incapable of failing, and exactly the reflection-evidence-for-structural-proof failure DESIGN names. Because the two sides have independent origins, a mismatch is reachable, and a reachable mismatch is what makes the match meaningful.\n\nWHY THE FOLD TAKES THE OBSERVATION AS A PARAMETER. admit_live_rust_observation is pure: it decides an outcome from a request and an observation it is handed. Only live_rust_observation_wet calls the host. That split is deliberate and load-bearing -- it means every control except the revision match can execute HERMETICALLY against constructed observations, at no host cost and with no Git mock anywhere, while the single genuinely-live claim stays in the one wet entry. A contract whose controls all required the host would have to be trusted; this one is mostly decidable.\n\nNO MOCKS, STATED SO IT IS NOT ADDED LATER AS A CONVENIENCE. Publishing static Git mock responses to make the live witness green would let a witness named for liveness pass against a constant sha. The hermetic controls below use constructed RustSourceHostObservation values, which is a different thing: they exercise the FOLD, and none of them claims to have observed anything.\n\nEVERY REFUSAL IS TYPED AND DISTINCT. The three host refusals stay separable (a Git failure is not a manifest read failure is not a TOML parse failure), an empty population is its own cause rather than a quiet success, and a revision mismatch names both sides. A failure arm refuses and never widens (DESIGN 5): there is no arm that accepts a partial population, and no arm that treats an unavailable expectation as satisfied."

type LiveRustObservationRequest {
  expected_repository_revision: CommitSha
}

type LiveObservationRefusalCause
  = LiveGitRefused { detail: String }
  | LiveManifestReadRefused { detail: String }
  | LiveManifestParseRefused { detail: String }
  | LiveRevisionMismatch { expected: CommitSha, observed: CommitSha }
  | LiveExpectationAbsent { detail: String }
  | LiveTrackedPopulationEmpty
  | LivePriorPopulationEmpty
  | LiveCargoTargetsEmpty

type LiveRustObservationReceipt {
  expected_repository_revision: CommitSha
  observed_repository_revision: CommitSha
  manifest_content_identity: ContentHash
  tracked_path_count: Int
  prior_path_count: Int
  cargo_target_count: Int
  verdict: RustSourceManifestStateVerdict
}

type LiveRustObservationOutcome
  = LiveObservationAdmitted { receipt: LiveRustObservationReceipt }
  | LiveObservationRefused { cause: LiveObservationRefusalCause }

fn admit_live_rust_observation(
  request: LiveRustObservationRequest,
  observation: RustSourceHostObservation
) -> LiveRustObservationOutcome {
  match observation {
    GitObservationRefused { detail: detail } =>
      LiveObservationRefused { cause: LiveGitRefused { detail: detail } }
    RustManifestReadRefused { detail: detail } =>
      LiveObservationRefused { cause: LiveManifestReadRefused { detail: detail } }
    RustManifestParseRefused { detail: detail } =>
      LiveObservationRefused { cause: LiveManifestParseRefused { detail: detail } }
    RustManifestObserved {
      repository_revision: observed_revision,
      manifest_content_identity: identity,
      tracked_rust_repo_paths: tracked,
      prior_tracked_rust_repo_paths: prior,
      cargo_bin_repo_paths: cargo
    } =>
      if request.expected_repository_revision == "" {
        LiveObservationRefused {
          cause: LiveExpectationAbsent { detail: "no expected repository revision supplied by the workflow runner" }
        }
      } else if !(observed_revision == request.expected_repository_revision) {
        LiveObservationRefused {
          cause: LiveRevisionMismatch {
            expected: request.expected_repository_revision,
            observed: observed_revision
          }
        }
      } else if length(xs: tracked) == 0 {
        LiveObservationRefused { cause: LiveTrackedPopulationEmpty }
      } else if length(xs: prior) == 0 {
        LiveObservationRefused { cause: LivePriorPopulationEmpty }
      } else if length(xs: cargo) == 0 {
        LiveObservationRefused { cause: LiveCargoTargetsEmpty }
      } else {
        LiveObservationAdmitted {
          receipt: LiveRustObservationReceipt {
            expected_repository_revision: request.expected_repository_revision,
            observed_repository_revision: observed_revision,
            manifest_content_identity: identity,
            tracked_path_count: length(xs: tracked),
            prior_path_count: length(xs: prior),
            cargo_target_count: length(xs: cargo),
            verdict: rust_source_manifest_state_verdict(observation: observation)
          }
        }
      }
  }
}

fn live_rust_observation_wet(expected_repository_revision: CommitSha) -> LiveRustObservationOutcome {
  admit_live_rust_observation(
    request: LiveRustObservationRequest {
      expected_repository_revision: expected_repository_revision
    },
    observation: current_stage0_rust_source_observation()
  )
}
