
module gunbc.generated_artifact_emit

import gunbc.generated_artifact {
  GeneratedArtifact,
  WitnessFloorYamlArtifact, FleetConvergeYamlArtifact, FleetDesiredAdmissionYamlArtifact, GitignoreArtifact, GitattributesArtifact, RoadmapArtifact, DesignArtifact,
  RunnerDeployArtifact, GithooksPrePushArtifact, GithooksPreCommitArtifact, GeneratedArtifactMergeDriverArtifact,
  AutoinstallUserDataArtifact, ProxyDhcpDnsmasqArtifact, PlanArtifact,
  Stage0CrateLayoutGeneratedDagArtifact, Stage0CrateLayoutGeneratedRsArtifact,
  Stage0CratePartitionGeneratedDagArtifact,
  V1InterpreterDispatchGeneratedRsArtifact,
  artifact_path
}
import gunbc.fleet_converge_workflow { expected_fleet_converge_yml }
import gunbc.fleet_desired_admission_workflow { expected_fleet_desired_yml }
import gunbc.witness_floor_workflow { expected_witness_floor_yml }
import gunbc.ci_yaml_validate { ci_yml_parses }
import gunbc.gitignore_emit { expected_gitignore }
import gunbc.gitattributes_emit { GitattributesGenerated, GitattributesGenerationRefused, expected_gitattributes }
import gunbc.roadmap_authority { expected_roadmap_md }
import gunbc.design_document { expected_design_md }
import gunbc.runner_deploy_emit { expected_runner_deploy_manifest }
import gunbc.githooks_pre_push_emit { expected_githooks_pre_push_sh }
import gunbc.githooks_pre_commit_emit { expected_githooks_pre_commit_sh }
import gunbc.generated_artifact_merge_driver { expected_generated_artifact_merge_driver_sh }
import gunbc.ci_spec { ci_heal_author_commit_regen_command }
import gunbc.os_install_emit { autoinstall_user_data }
import gunbc.install_server_emit { install_server_dnsmasq_conf }
import gunbc.plan { expected_plan_md }
import gunbc.stage0_crate_layout_emit {
  expected_stage0_crate_layout_generated_dag,
  expected_stage0_crate_layout_generated_rs
}
import gunbc.stage0_crate_partition_emit {
  expected_stage0_crate_partition_generated_dag
}
import gunbc.v1_interpreter_dispatch_emit {
  expected_v1_interpreter_dispatch_generated_rs,
  V1InterpreterDispatchGenerated,
  V1InterpreterDispatchGenerationRefused,
}

type ArtifactGenerationOutcome
  = ArtifactGenerated { content: String }
  | ArtifactGenerationRefused { reason: String }

fn artifact_generated(content: String) -> ArtifactGenerationOutcome {
  ArtifactGenerated { content: content }
}

fn artifact_generate(a: GeneratedArtifact) -> ArtifactGenerationOutcome {
  match a {
    WitnessFloorYamlArtifact => artifact_generated(content: expected_witness_floor_yml())
    FleetConvergeYamlArtifact => artifact_generated(content: expected_fleet_converge_yml())
    FleetDesiredAdmissionYamlArtifact => artifact_generated(content: expected_fleet_desired_yml())
    GitignoreArtifact => artifact_generated(content: expected_gitignore())
    GitattributesArtifact => match expected_gitattributes() {
      GitattributesGenerated { content } => artifact_generated(content: content)
      GitattributesGenerationRefused => ArtifactGenerationRefused { reason: "generated projection path population refused" }
    }
    RoadmapArtifact => artifact_generated(content: expected_roadmap_md())
    DesignArtifact => artifact_generated(content: expected_design_md())
    GithooksPrePushArtifact => artifact_generated(content: expected_githooks_pre_push_sh())
    GithooksPreCommitArtifact => artifact_generated(content: expected_githooks_pre_commit_sh())
    GeneratedArtifactMergeDriverArtifact => artifact_generated(content: expected_generated_artifact_merge_driver_sh(regen_command: ci_heal_author_commit_regen_command))
    RunnerDeployArtifact => artifact_generated(content: expected_runner_deploy_manifest())
    Stage0CrateLayoutGeneratedDagArtifact => artifact_generated(content: expected_stage0_crate_layout_generated_dag())
    Stage0CrateLayoutGeneratedRsArtifact => artifact_generated(content: expected_stage0_crate_layout_generated_rs())
    Stage0CratePartitionGeneratedDagArtifact => artifact_generated(content: expected_stage0_crate_partition_generated_dag())
    V1InterpreterDispatchGeneratedRsArtifact => match expected_v1_interpreter_dispatch_generated_rs() {
      V1InterpreterDispatchGenerated { content } => artifact_generated(content: content)
      V1InterpreterDispatchGenerationRefused { reason } =>
        ArtifactGenerationRefused { reason: reason }
    }
    AutoinstallUserDataArtifact { spec } => artifact_generated(content: autoinstall_user_data(payload: spec.payload))
    ProxyDhcpDnsmasqArtifact { spec } => artifact_generated(content: install_server_dnsmasq_conf(spec: spec))
    PlanArtifact { plan } => artifact_generated(content: expected_plan_md(p: plan))
  }
}

data artifact_extra_valid_note: String = "P0 (operator-directed, 2026-08-05; loyal-ram-550 review of #7823): takes the ALREADY-COMPUTED generation outcome rather than calling artifact_generate itself. The two variants whose extra check depends on generation success (Stage0EmitPlanGeneratedDagArtifact, V1InterpreterDispatchGeneratedRsArtifact) used to call artifact_generate(a: a) a second time here, discarding the content and keeping only success/failure — one Filesystem.Read, but TWO artifact_generate calls per artifact for those two variants, contradicting gunbc.generated_artifact_observation's 'one artifact_generate per artifact' claim. Every caller now supplies the outcome it already produced (observe_generated_artifact reuses its own match result); no second entry point to generation remains."

fn artifact_extra_valid(a: GeneratedArtifact, generated: ArtifactGenerationOutcome) -> Bool {
  match a {
    WitnessFloorYamlArtifact => ci_yml_parses(path: artifact_path(a: a))
    FleetConvergeYamlArtifact => ci_yml_parses(path: artifact_path(a: a))
    FleetDesiredAdmissionYamlArtifact => ci_yml_parses(path: artifact_path(a: a))
    GitignoreArtifact => true
    GitattributesArtifact => true
    RoadmapArtifact => true
    DesignArtifact => true
    GithooksPrePushArtifact => true
    GithooksPreCommitArtifact => true
    GeneratedArtifactMergeDriverArtifact => true
    RunnerDeployArtifact => true
    Stage0CrateLayoutGeneratedDagArtifact => true
    Stage0CrateLayoutGeneratedRsArtifact => true
    Stage0CratePartitionGeneratedDagArtifact => true
    V1InterpreterDispatchGeneratedRsArtifact => match generated {
      ArtifactGenerated { content: _ } => true
      ArtifactGenerationRefused { reason: _ } => false
    }
    AutoinstallUserDataArtifact { spec: _ } => true
    ProxyDhcpDnsmasqArtifact { spec: _ } => true
    PlanArtifact { plan: _ } => true
  }
}
