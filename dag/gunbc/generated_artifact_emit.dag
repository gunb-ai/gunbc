
module gunbc.generated_artifact_emit

type ArtifactGenerationOutcome
  = ArtifactGenerated { content: String }
  | ArtifactGenerationRefused { reason: String }

fn artifact_generated(content: String) -> ArtifactGenerationOutcome {
  ArtifactGenerated { content: content }
}

fn artifact_generate(a: gunbc.generated_artifact.GeneratedArtifact) -> ArtifactGenerationOutcome {
  match a {
    WitnessFloorYamlArtifact => match gunbc.witness_floor_workflow.expected_witness_floor_yml() {
      WitnessFloorGenerated { content } => artifact_generated(content: content)
      WitnessFloorGenerationRefused => ArtifactGenerationRefused { reason: "witness floor workflow capability closure refused" }
    }
    FleetConvergeYamlArtifact => artifact_generated(content: gunbc.fleet_converge_workflow.expected_fleet_converge_yml())
    FleetDesiredAdmissionYamlArtifact => artifact_generated(content: gunbc.fleet_desired_admission_workflow.expected_fleet_desired_yml())
    GitignoreArtifact => artifact_generated(content: gunbc.gitignore_emit.expected_gitignore())
    GitattributesArtifact => match gunbc.gitattributes_emit.expected_gitattributes() {
      GitattributesGenerated { content } => artifact_generated(content: content)
      GitattributesGenerationRefused => ArtifactGenerationRefused { reason: "generated projection path population refused" }
    }
    RoadmapArtifact => artifact_generated(content: gunbc.roadmap_authority.expected_roadmap_md())
    DesignArtifact => artifact_generated(content: gunbc.design_document.expected_design_md())
    GithooksPrePushArtifact => artifact_generated(content: gunbc.githooks_pre_push_emit.expected_githooks_pre_push_sh())
    GithooksPreCommitArtifact => artifact_generated(content: gunbc.githooks_pre_commit_emit.expected_githooks_pre_commit_sh())
    GeneratedArtifactMergeDriverArtifact => artifact_generated(content: gunbc.generated_artifact_merge_driver.expected_generated_artifact_merge_driver_sh(regen_command: gunbc.ci_spec.ci_heal_author_commit_regen_command))
    RunnerDeployArtifact => artifact_generated(content: gunbc.runner_deploy_emit.expected_runner_deploy_manifest())
    Stage0CrateLayoutGeneratedDagArtifact => artifact_generated(content: gunbc.stage0_crate_layout_emit.expected_stage0_crate_layout_generated_dag())
    Stage0CrateLayoutGeneratedRsArtifact => artifact_generated(content: gunbc.stage0_crate_layout_emit.expected_stage0_crate_layout_generated_rs())
    Stage0CratePartitionGeneratedDagArtifact => artifact_generated(content: gunbc.stage0_crate_partition_emit.expected_stage0_crate_partition_generated_dag())
    V1InterpreterDispatchGeneratedRsArtifact => match gunbc.v1_interpreter_dispatch_emit.expected_v1_interpreter_dispatch_generated_rs() {
      V1InterpreterDispatchGenerated { content } => artifact_generated(content: content)
      V1InterpreterDispatchGenerationRefused { reason } =>
        ArtifactGenerationRefused { reason: reason }
    }
    AutoinstallUserDataArtifact { spec } => artifact_generated(content: gunbc.os_install_emit.autoinstall_user_data(payload: spec.payload))
    ProxyDhcpDnsmasqArtifact { spec } => artifact_generated(content: gunbc.install_server_emit.install_server_dnsmasq_conf(spec: spec))
    PlanArtifact { plan } => artifact_generated(content: gunbc.plan.expected_plan_md(p: plan))
  }
}

data artifact_extra_valid_note: String = "P0 (operator-directed, 2026-08-05; loyal-ram-550 review of #7823): takes the ALREADY-COMPUTED generation outcome rather than calling artifact_generate itself. The two variants whose extra check depends on generation success (Stage0EmitPlanGeneratedDagArtifact, V1InterpreterDispatchGeneratedRsArtifact) used to call artifact_generate(a: a) a second time here, discarding the content and keeping only success/failure — one Filesystem.Read, but TWO artifact_generate calls per artifact for those two variants, contradicting gunbc.generated_artifact_observation's 'one artifact_generate per artifact' claim. Every caller now supplies the outcome it already produced (observe_generated_artifact reuses its own match result); no second entry point to generation remains."

fn artifact_extra_valid(a: gunbc.generated_artifact.GeneratedArtifact, generated: ArtifactGenerationOutcome) -> Bool {
  match a {
    WitnessFloorYamlArtifact => gunbc.ci_yaml_validate.ci_yml_parses(path: gunbc.generated_artifact.artifact_path(a: a))
    FleetConvergeYamlArtifact => gunbc.ci_yaml_validate.ci_yml_parses(path: gunbc.generated_artifact.artifact_path(a: a))
    FleetDesiredAdmissionYamlArtifact => gunbc.ci_yaml_validate.ci_yml_parses(path: gunbc.generated_artifact.artifact_path(a: a))
    GitignoreArtifact => true
    GitattributesArtifact => true
    RoadmapArtifact => true
    DesignArtifact => true
    GithooksPrePushArtifact => true
    GithooksPreCommitArtifact => true
    GeneratedArtifactMergeDriverArtifact => true
    RunnerDeployArtifact => true
    Stage0CrateLayoutGeneratedDagArtifact => true
    Stage0CrateLayoutGeneratedRsArtifact => true
    Stage0CratePartitionGeneratedDagArtifact => true
    V1InterpreterDispatchGeneratedRsArtifact => match generated {
      ArtifactGenerated { content: _ } => true
      ArtifactGenerationRefused { reason: _ } => false
    }
    AutoinstallUserDataArtifact { spec: _ } => true
    ProxyDhcpDnsmasqArtifact { spec: _ } => true
    PlanArtifact { plan: _ } => true
  }
}
