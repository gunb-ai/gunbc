type ArtifactGenerationOutcome
  = ArtifactGenerated { content: String }
  | ArtifactGenerationRefused { reason: String }

fn artifact_generated(content: String) -> ArtifactGenerationOutcome {
  ArtifactGenerated { content: content }
}

fn tier_o_outcome(a: GeneratedArtifact) -> ArtifactGenerationOutcome {
  match tier_o_unadorned_body(a: a) {
    TierOArtifactProduced { content } => artifact_generated(content: content)
    TierOArtifactRefused { reason } => ArtifactGenerationRefused { reason: reason }
    TierOArtifactNotTierO => ArtifactGenerationRefused { reason: "REFUSED gunbc.generated_artifact_emit: an artifact delegated to gunbc.tier_o_artifact_emit is absent from its roster" }
  }
}

fn seed_build_outcome(a: GeneratedArtifact) -> ArtifactGenerationOutcome {
  match seed_build_artifact_body(a: a) {
    SeedBuildArtifactProduced { content } => artifact_generated(content: content)
    SeedBuildArtifactRefused { reason } => ArtifactGenerationRefused { reason: reason }
    SeedBuildArtifactNotSeedBuild => ArtifactGenerationRefused { reason: "REFUSED gunbc.generated_artifact_emit: an artifact delegated to gunbc.seed_build_artifact_emit is absent from its roster" }
  }
}

fn artifact_generate_unadorned(a: GeneratedArtifact) -> ArtifactGenerationOutcome {
  match a {
    RoadmapArtifact => artifact_generated(content: expected_roadmap_md())
    DesignArtifact => artifact_generated(content: expected_design_md())
    DesignFailureModesArtifact => artifact_generated(content: expected_design_failure_modes_md())
    DesignRungDropsArtifact => artifact_generated(content: expected_design_rung_drops_md())
    ContributorOnboardingArtifact => artifact_generated(content: expected_contributor_onboarding_md())
    GeneratedArtifactMergeDriverArtifact => artifact_generated(content: expected_generated_artifact_merge_driver_sh(
      regen_command: generated_artifact_author_regen_command
    ))
    RunnerDeployArtifact => artifact_generated(content: expected_runner_deploy_manifest())
    WholeCorpusCompileMeasuredRootDemandsArtifact => artifact_generated(content: expected_whole_corpus_compile_measured_root_demands_json())
    ApprovalDeviceVectorsArtifact => artifact_generated(content: approval_device_vectors_json())
    ApproveIosProtocolSwiftArtifact => match expected_approve_ios_protocol_swift() {
      SwiftRowEmitted { source } => artifact_generated(content: source)
      SwiftRowEmissionRefused { reason } => ArtifactGenerationRefused { reason: reason as String }
    }
    ApproveIosWireSwiftArtifact => match expected_approve_ios_wire_swift() {
      SwiftRowEmitted { source } => artifact_generated(content: source)
      SwiftRowEmissionRefused { reason } => ArtifactGenerationRefused { reason: reason as String }
    }
    ApproveIosProtocolVectorTestsSwiftArtifact => match expected_approve_ios_protocol_vector_tests_swift() {
      SwiftRowEmitted { source } => artifact_generated(content: source)
      SwiftRowEmissionRefused { reason } => ArtifactGenerationRefused { reason: reason as String }
    }
    ApproveIosEnrolmentMachineSwiftArtifact => match expected_approve_ios_enrolment_machine_swift() {
      SwiftRowEmitted { source } => artifact_generated(content: source)
      SwiftRowEmissionRefused { reason } => ArtifactGenerationRefused { reason: reason as String }
    }
    ApproveIosOperationErrorsSwiftArtifact => match expected_approve_ios_operation_errors_swift() {
      SwiftRowEmitted { source } => artifact_generated(content: source)
      SwiftRowEmissionRefused { reason } => ArtifactGenerationRefused { reason: reason as String }
    }
    ApproveIosEnrolmentMachineTestsSwiftArtifact => match expected_approve_ios_enrolment_machine_tests_swift() {
      SwiftRowEmitted { source } => artifact_generated(content: source)
      SwiftRowEmissionRefused { reason } => ArtifactGenerationRefused { reason: reason as String }
    }
    ApproveIosOperationErrorsTestsSwiftArtifact => match expected_approve_ios_operation_errors_tests_swift() {
      SwiftRowEmitted { source } => artifact_generated(content: source)
      SwiftRowEmissionRefused { reason } => ArtifactGenerationRefused { reason: reason as String }
    }
    ApproveIosProjectYmlArtifact => match expected_approve_ios_project_yml() {
      ApproveIosProjectGenerated { content } => artifact_generated(content: content)
      ApproveIosProjectRefused { reason } => ArtifactGenerationRefused { reason: reason }
    }
    CouponCadQueryProgramArtifact => match expected_coupon_cadquery_program() {
      CouponProgramGenerated { content } => artifact_generated(content: content)
      CouponProgramRefused { reason } => ArtifactGenerationRefused { reason: reason }
    }
    CargoConfigArtifact => seed_build_outcome(a: a)
    Stage0CrateLayoutGeneratedDagArtifact => seed_build_outcome(a: a)
    Stage0CrateLayoutGeneratedRsArtifact => seed_build_outcome(a: a)
    Stage0CratePartitionGeneratedDagArtifact => seed_build_outcome(a: a)
    Stage0ExecutableAssemblyGeneratedDagArtifact => seed_build_outcome(a: a)
    Stage0LinkedPartitionCratesArtifact => seed_build_outcome(a: a)
    SeedRetentionFrontierGeneratedRsArtifact => seed_build_outcome(a: a)
    V1InterpreterDispatchGeneratedRsArtifact => seed_build_outcome(a: a)
    EvaluationBudgetConsequenceGeneratedRsArtifact => seed_build_outcome(a: a)
    ReleaseLocusSeedConstantsGeneratedRsArtifact => seed_build_outcome(a: a)
    FileTransportRealizationGeneratedRsArtifact => seed_build_outcome(a: a)
    NativeRouteSeedBoundaryGeneratedRsArtifact => seed_build_outcome(a: a)
    AutoinstallUserDataArtifact { spec } => match autoinstall_user_data(payload: spec.payload) {
      AutoinstallUserDataRendered { content } => artifact_generated(content: content)
      AutoinstallUserDataRefused { reason } => ArtifactGenerationRefused { reason: reason }
    }
    RunnerHostSudoersArtifact { host: _ } => tier_o_outcome(a: a)
    WitnessFloorYamlArtifact => tier_o_outcome(a: a)
    FleetConvergeYamlArtifact => tier_o_outcome(a: a)
    MicrovmShakedownYamlArtifact => tier_o_outcome(a: a)
    InstrumentDispatchYamlArtifact => tier_o_outcome(a: a)
    HealPublisherWorkflowYamlArtifact => tier_o_outcome(a: a)
    HealWorkflowYamlArtifact => tier_o_outcome(a: a)
    BranchRunGrantBrokerWorkflowYamlArtifact => tier_o_outcome(a: a)
    GitignoreArtifact => tier_o_outcome(a: a)
    GitattributesArtifact => tier_o_outcome(a: a)
    GithooksPrePushArtifact => tier_o_outcome(a: a)
    GithooksPreCommitArtifact => tier_o_outcome(a: a)
    Fci1BoundedExecutionContextArtifact => tier_o_outcome(a: a)
    DriftWatchWorkflowYamlArtifact => tier_o_outcome(a: a)
    PlanArtifact { plan } => match plan_generation(p: plan) {
      PlanGenerated { content } => artifact_generated(content: content)
      PlanGenerationRefused { reason } => ArtifactGenerationRefused { reason: reason }
    }
  }
}

// One bytes boundary owns workflow provenance. A workflow admitted by the commit-policy registry
// without a provenance projection refuses here; non-workflow artifacts pass through unchanged.
// This is a rung-3 wall, not a rung-4 constructor removal: the inconsistent pair remains writable
// in the two authorities, but it cannot produce committed workflow bytes.
fn artifact_generate(a: GeneratedArtifact) -> ArtifactGenerationOutcome {
  let generated = artifact_generate_unadorned(a: a)
  match generated_workflow_provenance_header(a: a) {
    GeneratedWorkflowProvenanceHeaderProduced { content: header } => match generated {
      ArtifactGenerated { content } => artifact_generated(content: concat(header, content))
      ArtifactGenerationRefused { reason } => ArtifactGenerationRefused { reason: reason }
    }
    GeneratedWorkflowProvenanceHeaderNotApplicable => match artifact_commit_policy(a: a) {
      CommitRequired { consumer: GithubActionsWorkflow } => ArtifactGenerationRefused {
        reason: "GithubActionsWorkflow artifact has no generated-workflow provenance projection"
      }
      CommitRequired { consumer: GitProtocol } => generated
      CommitRequired { consumer: CargoToolchain } => generated
      CommitRequired { consumer: ProjectDocumentation } => generated
      CommitRequired { consumer: HostReconciler } => generated
      CommitRequired { consumer: CompilerRunInput } => generated
      CommitRequired { consumer: CrossLanguageClientTest } => generated
      CommitRequired { consumer: XcodeProjectGenerator } => generated
      CommitRequired { consumer: SwiftCompiler } => generated
      NotCommitted => generated
    }
  }
}

// P0 (operator-directed, 2026-08-05; loyal-ram-550 review of #7823): takes the ALREADY-COMPUTED
// generation outcome rather than calling artifact_generate itself. The two variants whose extra
// check depends on generation success (Stage0EmitPlanGeneratedDagArtifact,
// V1InterpreterDispatchGeneratedRsArtifact) used to call artifact_generate(a: a) a second time
// here, discarding the content and keeping only success/failure — one Filesystem.Read, but TWO
// artifact_generate calls per artifact for those two variants, contradicting
// gunbc.generated_artifact_observation's 'one artifact_generate per artifact' claim. Every caller
// now supplies the outcome it already produced (observe_generated_artifact reuses its own match
// result); no second entry point to generation remains.

fn artifact_extra_valid(a: GeneratedArtifact, generated: ArtifactGenerationOutcome) -> Bool {
  match a {
    WitnessFloorYamlArtifact => ci_yml_parses(path: artifact_path(a: a))
    FleetConvergeYamlArtifact => ci_yml_parses(path: artifact_path(a: a))
    MicrovmShakedownYamlArtifact => ci_yml_parses(path: artifact_path(a: a))
    InstrumentDispatchYamlArtifact => ci_yml_parses(path: artifact_path(a: a))
    HealWorkflowYamlArtifact => ci_yml_parses(path: artifact_path(a: a))
    HealPublisherWorkflowYamlArtifact => ci_yml_parses(path: artifact_path(a: a))
    DriftWatchWorkflowYamlArtifact => ci_yml_parses(path: artifact_path(a: a))
    BranchRunGrantBrokerWorkflowYamlArtifact => ci_yml_parses(path: artifact_path(a: a))
    GitignoreArtifact => true
    GitattributesArtifact => true
    CargoConfigArtifact => true
    RoadmapArtifact => true
    DesignArtifact => true
    DesignFailureModesArtifact => true
    DesignRungDropsArtifact => true
    ContributorOnboardingArtifact => true
    GithooksPrePushArtifact => true
    GithooksPreCommitArtifact => true
    GeneratedArtifactMergeDriverArtifact => true
    RunnerDeployArtifact => true
    CouponCadQueryProgramArtifact => true
    WholeCorpusCompileMeasuredRootDemandsArtifact => true
    ApprovalDeviceVectorsArtifact => true
    ApproveIosProjectYmlArtifact => true
    ApproveIosProtocolSwiftArtifact => true
    ApproveIosWireSwiftArtifact => true
    ApproveIosProtocolVectorTestsSwiftArtifact => true
    ApproveIosEnrolmentMachineSwiftArtifact => true
    ApproveIosOperationErrorsSwiftArtifact => true
    ApproveIosEnrolmentMachineTestsSwiftArtifact => true
    ApproveIosOperationErrorsTestsSwiftArtifact => true
    Stage0CrateLayoutGeneratedDagArtifact => true
    Stage0CrateLayoutGeneratedRsArtifact => true
    Stage0CratePartitionGeneratedDagArtifact => true
    Stage0ExecutableAssemblyGeneratedDagArtifact => true
    Stage0LinkedPartitionCratesArtifact => true
    SeedRetentionFrontierGeneratedRsArtifact => true
    EvaluationBudgetConsequenceGeneratedRsArtifact => true
    ReleaseLocusSeedConstantsGeneratedRsArtifact => true
    V1InterpreterDispatchGeneratedRsArtifact => match generated {
      ArtifactGenerated { content: _ } => true
      ArtifactGenerationRefused { reason: _ } => false
    }
    FileTransportRealizationGeneratedRsArtifact => true
    NativeRouteSeedBoundaryGeneratedRsArtifact => true
    Fci1BoundedExecutionContextArtifact => match generated {
      ArtifactGenerated { content: _ } => true
      ArtifactGenerationRefused { reason: _ } => false
    }
    AutoinstallUserDataArtifact { spec: _ } => true
    RunnerHostSudoersArtifact { host: _ } => match generated {
      ArtifactGenerated { content: _ } => true
      ArtifactGenerationRefused { reason: _ } => false
    }
    PlanArtifact { plan: _ } => true
  }
}

// WHY A THIRD STATE. The consumer asks "what is the generated body for this path", and the
// honest answers are three, not two: produced, refused, and NOT A GENERATED ARTIFACT AT ALL.
// Folding the third into ArtifactGenerationRefused would tell a caller holding an ordinary
// mirror path that generation FAILED for it, which is false -- nothing was ever supposed to
// generate it -- and a caller acting on that difference would act wrongly. Two zeros, one
// spelling, is the conflation DESIGN names; the third variant is what keeps them apart.
type GeneratedArtifactPathBody
  = GeneratedArtifactPathBodyProduced { content: String }
  | GeneratedArtifactPathBodyRefused { reason: String }
  | GeneratedArtifactPathNotGenerated

// The generated-artifact population, keyed by path instead of by artifact.
//
// PURELY A PROJECTION. It mints no roster, forks no dispatch, and edits neither authority it
// consults: `committed_generated_artifacts` is the population main_wet folds over, `artifact_path`
// is the artifact->path authority, and `artifact_generate` is the single artifact->content
// dispatch. This asks those three the question a path-holding consumer has, which is the whole
// reason it can exist without becoming a second answer to anything.
fn generated_artifact_body_for_path(path: String) -> GeneratedArtifactPathBody {
  match committed_generated_artifacts() |> filter(a => artifact_path(a: a) == path) |> first {
    Absent => GeneratedArtifactPathNotGenerated
    Present { value: a } =>
      match artifact_generate(a: a) {
        ArtifactGenerated { content } => GeneratedArtifactPathBodyProduced { content: content }
        ArtifactGenerationRefused { reason } => GeneratedArtifactPathBodyRefused { reason: reason }
      }
  }
}
