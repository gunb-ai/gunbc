fn artifact_production(a: GeneratedArtifact) -> GeneratedArtifactProduction {
  match a {
    WitnessFloorYamlArtifact => witness_floor_yaml_artifact_production
    FleetConvergeYamlArtifact => fleet_converge_yaml_artifact_production
    MicrovmShakedownYamlArtifact => microvm_shakedown_yaml_artifact_production
    InstrumentDispatchYamlArtifact => instrument_dispatch_yaml_artifact_production
    HealWorkflowYamlArtifact => heal_workflow_yaml_artifact_production
    HealPublisherWorkflowYamlArtifact => heal_publisher_workflow_yaml_artifact_production
    DriftWatchWorkflowYamlArtifact => drift_watch_workflow_yaml_artifact_production
    GunbAiPagesWorkflowYamlArtifact => gunb_ai_pages_workflow_yaml_artifact_production
    BranchRunGrantBrokerWorkflowYamlArtifact => branch_run_grant_broker_workflow_yaml_artifact_production
    HostedRunnerShadowGateYamlArtifact => hosted_runner_shadow_gate_yaml_artifact_production
    GitignoreArtifact => gitignore_artifact_production
    GitattributesArtifact => gitattributes_artifact_production
    CargoConfigArtifact => cargo_config_artifact_production
    DesignArtifact => design_artifact_production
    DesignFailureModesArtifact => design_failure_modes_artifact_production
    DesignRungDropsArtifact => design_rung_drops_artifact_production
    ContributorOnboardingArtifact => contributor_onboarding_artifact_production
    GithooksPrePushArtifact => githooks_pre_push_artifact_production
    GithooksPreCommitArtifact => githooks_pre_commit_artifact_production
    ReleaseBinsConsumerCheckScriptArtifact => release_bins_consumer_check_script_artifact_production
    GeneratedArtifactMergeDriverArtifact => generated_artifact_merge_driver_artifact_production
    RunnerDeployArtifact => runner_deploy_artifact_production
    Stage0CrateLayoutGeneratedDagArtifact => stage0_crate_layout_generated_dag_artifact_production
    Stage0CrateLayoutGeneratedRsArtifact => stage0_crate_layout_generated_rs_artifact_production
    Stage0CratePartitionGeneratedDagArtifact => stage0_crate_partition_generated_dag_artifact_production
    Stage0ExecutableAssemblyGeneratedDagArtifact => stage0_executable_assembly_generated_dag_artifact_production
    Stage0LinkedPartitionCratesArtifact => stage0_linked_partition_crates_artifact_production
    SeedRetentionFrontierGeneratedRsArtifact => seed_retention_frontier_generated_rs_artifact_production
    V1InterpreterDispatchGeneratedRsArtifact => v1_interpreter_dispatch_generated_rs_artifact_production
    EvaluationBudgetConsequenceGeneratedRsArtifact => evaluation_budget_consequence_generated_rs_artifact_production
    ReleaseLocusSeedConstantsGeneratedRsArtifact => release_locus_seed_constants_generated_rs_artifact_production
    FileTransportRealizationGeneratedRsArtifact => file_transport_realization_generated_rs_artifact_production
    NativeRouteSeedBoundaryGeneratedRsArtifact => native_route_seed_boundary_generated_rs_artifact_production
    InstrumentRegistryGeneratedRsArtifact => instrument_registry_generated_rs_artifact_production
    Fci1BoundedExecutionContextArtifact => fci1_bounded_execution_context_artifact_production
    AutoinstallUserDataArtifact { spec } => autoinstall_user_data_artifact_production(spec: spec)
    RunnerHostSudoersArtifact { host } => runner_host_sudoers_artifact_production(host: host)
    CouponCadQueryProgramArtifact => coupon_cad_query_program_artifact_production
    WholeCorpusCompileMeasuredRootDemandsArtifact => whole_corpus_compile_measured_root_demands_artifact_production
    ApprovalDeviceVectorsArtifact => approval_device_vectors_artifact_production
    ApproveIosProjectYmlArtifact => approve_ios_project_yml_artifact_production
    ApproveIosProtocolSwiftArtifact => approve_ios_protocol_swift_artifact_production
    ApproveIosWireSwiftArtifact => approve_ios_wire_swift_artifact_production
    ApproveIosProtocolVectorTestsSwiftArtifact => approve_ios_protocol_vector_tests_swift_artifact_production
    ApproveIosEnrolmentMachineSwiftArtifact => approve_ios_enrolment_machine_swift_artifact_production
    ApproveIosOperationErrorsSwiftArtifact => approve_ios_operation_errors_swift_artifact_production
    ApproveIosEnrolmentMachineTestsSwiftArtifact => approve_ios_enrolment_machine_tests_swift_artifact_production
    ApproveIosOperationErrorsTestsSwiftArtifact => approve_ios_operation_errors_tests_swift_artifact_production
    RoadmapAuthorityAcceptedScenarioAcceptanceArtifact => roadmap_authority_accepted_scenario_acceptance_artifact_production
    RoadmapAuthoritySupersededScenarioAcceptanceArtifact => roadmap_authority_superseded_scenario_acceptance_artifact_production
    RoadmapAuthoritySupersededScenarioRevocationArtifact => roadmap_authority_superseded_scenario_revocation_artifact_production
    RoadmapAuthoritySupersededScenarioRetiredArtifact => roadmap_authority_superseded_scenario_retired_artifact_production
    RoadmapAuthorityAbsentNodeAcceptanceArtifact => roadmap_authority_absent_node_acceptance_artifact_production
  }
}

fn artifact_generate(a: GeneratedArtifact) -> ArtifactGenerationOutcome {
  let production = artifact_production(a: a)
  if !artifact_eq(a: production.artifact, b: a) {
    ArtifactGenerationRefused {
      reason: concat(concat("the production matched to ", artifact_path(a: a)), concat(" generates ", artifact_path(a: production.artifact)))
    }
  } else {
    artifact_generate_from(a: a, production: production)
  }
}

fn artifact_generate_from(a: GeneratedArtifact, production: GeneratedArtifactProduction) -> ArtifactGenerationOutcome {
  let generated = production.generate()
  match generated_workflow_provenance_header(provenance: production.provenance) {
    GeneratedWorkflowProvenanceHeaderProduced { content: header } => match generated {
      ArtifactGenerated { content } => ArtifactGenerated { content: concat(header, content) }
      ArtifactGenerationRefused { reason } => ArtifactGenerationRefused { reason: reason }
    }
    GeneratedWorkflowProvenanceHeaderNotApplicable => match artifact_commit_policy(a: a) {
      CommitRequired { consumer: GithubActionsWorkflow } => ArtifactGenerationRefused {
        reason: "GithubActionsWorkflow artifact has no generated-workflow provenance projection"
      }
      CommitRequired { consumer: GitProtocol } => generated
      CommitRequired { consumer: CargoToolchain } => generated
      CommitRequired { consumer: ProjectDocumentation } => generated
      CommitRequired { consumer: HostReconciler } => generated
      CommitRequired { consumer: CompilerRunInput } => generated
      CommitRequired { consumer: CrossLanguageClientTest } => generated
      CommitRequired { consumer: XcodeProjectGenerator } => generated
      CommitRequired { consumer: SwiftCompiler } => generated
      NotCommitted => generated
    }
  }
}

fn artifact_extra_valid(a: GeneratedArtifact, generated: ArtifactGenerationOutcome) -> Bool {
  artifact_production(a: a).extra_valid(generated)
}

type GeneratedArtifactPathBody
  = GeneratedArtifactPathBodyProduced { content: String }
  | GeneratedArtifactPathBodyRefused { reason: String }
  | GeneratedArtifactPathNotGenerated

// The generated-artifact population, keyed by path instead of by artifact.
//
// PURELY A PROJECTION. It mints no roster, forks no dispatch, and edits neither authority it
// consults: `committed_generated_artifacts` is the population main_wet folds over, `artifact_path`
// is the artifact->path authority, and `artifact_generate` is the single artifact->content
// dispatch. This asks those three the question a path-holding consumer has, which is the whole
// reason it can exist without becoming a second answer to anything.
fn generated_artifact_body_for_path(path: String) -> GeneratedArtifactPathBody {
  match committed_generated_artifacts() |> filter(a => artifact_path(a: a) == path) |> first {
    Absent => GeneratedArtifactPathNotGenerated
    Present { value: a } =>
      match artifact_generate(a: a) {
        ArtifactGenerated { content } => GeneratedArtifactPathBodyProduced { content: content }
        ArtifactGenerationRefused { reason } => GeneratedArtifactPathBodyRefused { reason: reason }
      }
  }
}
