type ArtifactGenerationOutcome
  = ArtifactGenerated { content: String }
  | ArtifactGenerationRefused { reason: String }

fn artifact_generated(content: String) -> ArtifactGenerationOutcome {
  ArtifactGenerated { content: content }
}

fn artifact_generate_unadorned(a: GeneratedArtifact) -> ArtifactGenerationOutcome {
  match a {
    WitnessFloorYamlArtifact => match expected_witness_floor_yml() {
      WitnessFloorGenerated { content } => artifact_generated(content: content)
      WitnessFloorGenerationRefused { reason } => ArtifactGenerationRefused { reason: reason }
    }
    FleetConvergeYamlArtifact => match expected_fleet_converge_yml() {
      FleetConvergeYamlGenerated { content } => artifact_generated(content: content)
      FleetConvergeYamlGenerationRefused { reason } => ArtifactGenerationRefused { reason: reason }
    }
    FleetDesiredAdmissionYamlArtifact => match expected_fleet_desired_yml() {
      FleetDesiredGenerated { content } => artifact_generated(content: content)
      FleetDesiredGenerationRefused { reason } => ArtifactGenerationRefused { reason: reason }
    }
    GitignoreArtifact => artifact_generated(content: expected_gitignore())
    GitattributesArtifact => match expected_gitattributes() {
      GitattributesGenerated { content } => artifact_generated(content: content)
      GitattributesGenerationRefused => ArtifactGenerationRefused { reason: "generated projection path population refused" }
    }
    RoadmapArtifact => artifact_generated(content: expected_roadmap_md())
    DesignArtifact => artifact_generated(content: expected_design_md())
    DesignLedgersArtifact => artifact_generated(content: expected_design_ledgers_md())
    GithooksPrePushArtifact => artifact_generated(content: expected_githooks_pre_push_sh())
    GithooksPreCommitArtifact => artifact_generated(content: expected_githooks_pre_commit_sh())
    GeneratedArtifactMergeDriverArtifact => artifact_generated(content: expected_generated_artifact_merge_driver_sh(regen_command: ci_heal_author_commit_regen_command))
    RunnerDeployArtifact => artifact_generated(content: expected_runner_deploy_manifest())
    CouponCadQueryProgramArtifact => match expected_coupon_cadquery_program() {
      CouponProgramGenerated { content } => artifact_generated(content: content)
      CouponProgramRefused { reason } => ArtifactGenerationRefused { reason: reason }
    }
    Stage0CrateLayoutGeneratedDagArtifact => artifact_generated(content: expected_stage0_crate_layout_generated_dag())
    Stage0CrateLayoutGeneratedRsArtifact => artifact_generated(content: expected_stage0_crate_layout_generated_rs())
    Stage0CratePartitionGeneratedDagArtifact => artifact_generated(content: expected_stage0_crate_partition_generated_dag())
    Stage0ExecutableAssemblyGeneratedDagArtifact => artifact_generated(content: expected_stage0_executable_assembly_generated_dag())
    V1InterpreterDispatchGeneratedRsArtifact => match expected_v1_interpreter_dispatch_generated_rs() {
      V1InterpreterDispatchGenerated { content } => artifact_generated(content: content)
      V1InterpreterDispatchGenerationRefused { reason } =>
        ArtifactGenerationRefused { reason: reason }
    }
    AutoinstallUserDataArtifact { spec } => artifact_generated(content: autoinstall_user_data(payload: spec.payload))
    RunnerHostSudoersArtifact { host } => match runner_host_deploy_for(host: host) {
      RunnerHostDeployFound { deploy } =>
        artifact_generated(
          content: runner_host_sudoers_content(
            deploy: deploy,
            artifact_path: artifact_path(a: a),
          )
        )
      RunnerHostDeployUnmodeled { host: unmodeled } =>
        ArtifactGenerationRefused {
          reason: concat(
            "no runner host deploy row for enrolled host ",
            unmodeled as String
          )
        }
    }
    PlanArtifact { plan } => artifact_generated(content: expected_plan_md(p: plan))
  }
}

// One bytes boundary owns workflow provenance. A workflow admitted by the commit-policy registry
// without a provenance projection refuses here; non-workflow artifacts pass through unchanged.
// This is a rung-3 wall, not a rung-4 constructor removal: the inconsistent pair remains writable
// in the two authorities, but it cannot produce committed workflow bytes.
fn artifact_generate(a: GeneratedArtifact) -> ArtifactGenerationOutcome {
  let generated = artifact_generate_unadorned(a: a)
  match generated_workflow_provenance_header(a: a) {
    GeneratedWorkflowProvenanceHeaderProduced { content: header } => match generated {
      ArtifactGenerated { content } => artifact_generated(content: concat(header, content))
      ArtifactGenerationRefused { reason } => ArtifactGenerationRefused { reason: reason }
    }
    GeneratedWorkflowProvenanceHeaderNotApplicable => match artifact_commit_policy(a: a) {
      CommitRequired { consumer: GithubActionsWorkflow } => ArtifactGenerationRefused {
        reason: "GithubActionsWorkflow artifact has no generated-workflow provenance projection"
      }
      CommitRequired { consumer: GitProtocol } => generated
      CommitRequired { consumer: ProjectDocumentation } => generated
      CommitRequired { consumer: HostReconciler } => generated
      NotCommitted => generated
    }
  }
}

// P0 (operator-directed, 2026-08-05; loyal-ram-550 review of #7823): takes the ALREADY-COMPUTED
// generation outcome rather than calling artifact_generate itself. The two variants whose extra
// check depends on generation success (Stage0EmitPlanGeneratedDagArtifact,
// V1InterpreterDispatchGeneratedRsArtifact) used to call artifact_generate(a: a) a second time
// here, discarding the content and keeping only success/failure — one Filesystem.Read, but TWO
// artifact_generate calls per artifact for those two variants, contradicting
// gunbc.generated_artifact_observation's 'one artifact_generate per artifact' claim. Every caller
// now supplies the outcome it already produced (observe_generated_artifact reuses its own match
// result); no second entry point to generation remains.

fn artifact_extra_valid(a: GeneratedArtifact, generated: ArtifactGenerationOutcome) -> Bool {
  match a {
    WitnessFloorYamlArtifact => ci_yml_parses(path: artifact_path(a: a))
    FleetConvergeYamlArtifact => ci_yml_parses(path: artifact_path(a: a))
    FleetDesiredAdmissionYamlArtifact => ci_yml_parses(path: artifact_path(a: a))
    GitignoreArtifact => true
    GitattributesArtifact => true
    RoadmapArtifact => true
    DesignArtifact => true
    DesignLedgersArtifact => true
    GithooksPrePushArtifact => true
    GithooksPreCommitArtifact => true
    GeneratedArtifactMergeDriverArtifact => true
    RunnerDeployArtifact => true
    CouponCadQueryProgramArtifact => true
    Stage0CrateLayoutGeneratedDagArtifact => true
    Stage0CrateLayoutGeneratedRsArtifact => true
    Stage0CratePartitionGeneratedDagArtifact => true
    Stage0ExecutableAssemblyGeneratedDagArtifact => true
    V1InterpreterDispatchGeneratedRsArtifact => match generated {
      ArtifactGenerated { content: _ } => true
      ArtifactGenerationRefused { reason: _ } => false
    }
    AutoinstallUserDataArtifact { spec: _ } => true
    RunnerHostSudoersArtifact { host: _ } => match generated {
      ArtifactGenerated { content: _ } => true
      ArtifactGenerationRefused { reason: _ } => false
    }
    PlanArtifact { plan: _ } => true
  }
}

// WHY A THIRD STATE. The consumer asks "what is the generated body for this path", and the
// honest answers are three, not two: produced, refused, and NOT A GENERATED ARTIFACT AT ALL.
// Folding the third into ArtifactGenerationRefused would tell a caller holding an ordinary
// mirror path that generation FAILED for it, which is false -- nothing was ever supposed to
// generate it -- and a caller acting on that difference would act wrongly. Two zeros, one
// spelling, is the conflation DESIGN names; the third variant is what keeps them apart.
type GeneratedArtifactPathBody
  = GeneratedArtifactPathBodyProduced { content: String }
  | GeneratedArtifactPathBodyRefused { reason: String }
  | GeneratedArtifactPathNotGenerated

// The generated-artifact population, keyed by path instead of by artifact.
//
// PURELY A PROJECTION. It mints no roster, forks no dispatch, and edits neither authority it
// consults: `committed_generated_artifacts` is the population main_wet folds over, `artifact_path`
// is the artifact->path authority, and `artifact_generate` is the single artifact->content
// dispatch. This asks those three the question a path-holding consumer has, which is the whole
// reason it can exist without becoming a second answer to anything.
fn generated_artifact_body_for_path(path: String) -> GeneratedArtifactPathBody {
  match committed_generated_artifacts() |> filter(a => artifact_path(a: a) == path) |> first {
    Absent => GeneratedArtifactPathNotGenerated
    Present { value: a } =>
      match artifact_generate(a: a) {
        ArtifactGenerated { content } => GeneratedArtifactPathBodyProduced { content: content }
        ArtifactGenerationRefused { reason } => GeneratedArtifactPathBodyRefused { reason: reason }
      }
  }
}
