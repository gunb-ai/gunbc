
module gunbc.generated_artifact_emit

import gunbc.generated_artifact {
  GeneratedArtifact,
  CiYamlArtifact, FalsifierYamlArtifact, GitignoreArtifact, RoadmapArtifact, DesignArtifact,
  RunnerDeployArtifact, FleetConvergeArtifact, GithooksPrePushArtifact, GithooksPreCommitArtifact,
  AutoinstallUserDataArtifact, ProxyDhcpDnsmasqArtifact, PlanArtifact,
  Stage0CrateLayoutGeneratedDagArtifact, Stage0CrateLayoutGeneratedRsArtifact,
  Stage0CratePartitionGeneratedDagArtifact,
  LiveDeployApplyScriptArtifact, LiveDeployRetractScriptArtifact,
  artifact_path
}
import gunbc.ci_yaml_emit { expected_ci_yml }
import gunbc.falsifier_workflow { expected_falsifier_yml }
import gunbc.ci_yaml_validate { ci_yml_parses }
import gunbc.gitignore_emit { expected_gitignore }
import gunbc.roadmap_authority { expected_roadmap_md }
import gunbc.design_document { expected_design_md }
import gunbc.runner_deploy_emit { expected_runner_deploy_manifest }
import gunbc.fleet_converge_emit { expected_fleet_converge_sh }
import gunbc.githooks_pre_push_emit { expected_githooks_pre_push_sh }
import gunbc.githooks_pre_commit_emit { expected_githooks_pre_commit_sh }
import gunbc.os_install_emit { autoinstall_user_data }
import gunbc.install_server_emit { install_server_dnsmasq_conf }
import gunbc.plan { expected_plan_md }
import gunbc.stage0_crate_layout_emit {
  expected_stage0_crate_layout_generated_dag,
  expected_stage0_crate_layout_generated_rs
}
import gunbc.stage0_crate_partition_emit {
  expected_stage0_crate_partition_generated_dag
}
import gunbc.live_deploy.emit {
  expected_live_deploy_apply_script,
  expected_live_deploy_retract_script
}

fn artifact_generate(a: GeneratedArtifact) -> String {
  match a {
    CiYamlArtifact => expected_ci_yml()
    FalsifierYamlArtifact => expected_falsifier_yml()
    GitignoreArtifact => expected_gitignore()
    RoadmapArtifact => expected_roadmap_md()
    DesignArtifact => expected_design_md()
    GithooksPrePushArtifact => expected_githooks_pre_push_sh()
    GithooksPreCommitArtifact => expected_githooks_pre_commit_sh()
    RunnerDeployArtifact => expected_runner_deploy_manifest()
    FleetConvergeArtifact => expected_fleet_converge_sh()
    Stage0CrateLayoutGeneratedDagArtifact => expected_stage0_crate_layout_generated_dag()
    Stage0CrateLayoutGeneratedRsArtifact => expected_stage0_crate_layout_generated_rs()
    Stage0CratePartitionGeneratedDagArtifact => expected_stage0_crate_partition_generated_dag()
    LiveDeployApplyScriptArtifact => expected_live_deploy_apply_script()
    LiveDeployRetractScriptArtifact => expected_live_deploy_retract_script()
    AutoinstallUserDataArtifact { spec } => autoinstall_user_data(payload: spec.payload)
    ProxyDhcpDnsmasqArtifact { spec } => install_server_dnsmasq_conf(spec: spec)
    PlanArtifact { plan } => expected_plan_md(p: plan)
  }
}

fn artifact_extra_valid(a: GeneratedArtifact) -> Bool {
  match a {
    CiYamlArtifact => ci_yml_parses(path: artifact_path(a: a))
    FalsifierYamlArtifact => ci_yml_parses(path: artifact_path(a: a))
    GitignoreArtifact => true
    RoadmapArtifact => true
    DesignArtifact => true
    GithooksPrePushArtifact => true
    GithooksPreCommitArtifact => true
    RunnerDeployArtifact => true
    FleetConvergeArtifact => true
    Stage0CrateLayoutGeneratedDagArtifact => true
    Stage0CrateLayoutGeneratedRsArtifact => true
    Stage0CratePartitionGeneratedDagArtifact => true
    LiveDeployApplyScriptArtifact => true
    LiveDeployRetractScriptArtifact => true
    AutoinstallUserDataArtifact { spec: _ } => true
    ProxyDhcpDnsmasqArtifact { spec: _ } => true
    PlanArtifact { plan: _ } => true
  }
}
