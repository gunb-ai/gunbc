
module gunbc.generated_artifact_emit


type ArtifactGenerationOutcome
  = ArtifactGenerated { content: String }
  | ArtifactGenerationRefused { reason: String }

fn artifact_generated(content: String) -> ArtifactGenerationOutcome {
  ArtifactGenerated { content: content }
}

fn artifact_generate(a: gunbc.generated_artifact.GeneratedArtifact) -> ArtifactGenerationOutcome {
  match a {
    gunbc.generated_artifact.WitnessFloorYamlArtifact => artifact_generated(content: gunbc.witness_floor_workflow.expected_witness_floor_yml())
    gunbc.generated_artifact.FleetConvergeYamlArtifact => artifact_generated(content: gunbc.fleet_converge_workflow.expected_fleet_converge_yml())
    gunbc.generated_artifact.GitignoreArtifact => artifact_generated(content: gunbc.gitignore_emit.expected_gitignore())
    gunbc.generated_artifact.GitattributesArtifact => match gunbc.gitattributes_emit.expected_gitattributes() {
      gunbc.gitattributes_emit.GitattributesGenerated { content } => artifact_generated(content: content)
      gunbc.gitattributes_emit.GitattributesGenerationRefused => ArtifactGenerationRefused { reason: "generated projection path population refused" }
    }
    gunbc.generated_artifact.RoadmapArtifact => artifact_generated(content: gunbc.roadmap_authority.expected_roadmap_md())
    gunbc.generated_artifact.DesignArtifact => artifact_generated(content: gunbc.design_document.expected_design_md())
    gunbc.generated_artifact.GithooksPrePushArtifact => artifact_generated(content: gunbc.githooks_pre_push_emit.expected_githooks_pre_push_sh())
    gunbc.generated_artifact.GithooksPreCommitArtifact => artifact_generated(content: gunbc.githooks_pre_commit_emit.expected_githooks_pre_commit_sh())
    gunbc.generated_artifact.GeneratedArtifactMergeDriverArtifact => artifact_generated(content: gunbc.generated_artifact_merge_driver.expected_generated_artifact_merge_driver_sh(regen_command: gunbc.ci_spec.ci_heal_author_commit_regen_command))
    gunbc.generated_artifact.RunnerDeployArtifact => artifact_generated(content: gunbc.runner_deploy_emit.expected_runner_deploy_manifest())
    gunbc.generated_artifact.Stage0CrateLayoutGeneratedDagArtifact => artifact_generated(content: gunbc.stage0_crate_layout_emit.expected_stage0_crate_layout_generated_dag())
    gunbc.generated_artifact.Stage0CrateLayoutGeneratedRsArtifact => artifact_generated(content: gunbc.stage0_crate_layout_emit.expected_stage0_crate_layout_generated_rs())
    gunbc.generated_artifact.Stage0CratePartitionGeneratedDagArtifact => artifact_generated(content: gunbc.stage0_crate_partition_emit.expected_stage0_crate_partition_generated_dag())
    gunbc.generated_artifact.V1InterpreterDispatchGeneratedRsArtifact => match gunbc.v1_interpreter_dispatch_emit.expected_v1_interpreter_dispatch_generated_rs() {
      gunbc.v1_interpreter_dispatch_emit.V1InterpreterDispatchGenerated { content } => artifact_generated(content: content)
      gunbc.v1_interpreter_dispatch_emit.V1InterpreterDispatchGenerationRefused { reason } =>
        ArtifactGenerationRefused { reason: reason }
    }
    gunbc.generated_artifact.AutoinstallUserDataArtifact { spec } => artifact_generated(content: gunbc.os_install_emit.autoinstall_user_data(payload: spec.payload))
    gunbc.generated_artifact.ProxyDhcpDnsmasqArtifact { spec } => artifact_generated(content: gunbc.install_server_emit.install_server_dnsmasq_conf(spec: spec))
    gunbc.generated_artifact.PlanArtifact { plan } => artifact_generated(content: gunbc.plan.expected_plan_md(p: plan))
  }
}

data artifact_extra_valid_note: String = "P0 (operator-directed, 2026-08-05; loyal-ram-550 review of #7823): takes the ALREADY-COMPUTED generation outcome rather than calling artifact_generate itself. The two variants whose extra check depends on generation success (Stage0EmitPlanGeneratedDagArtifact, gunbc.generated_artifact.V1InterpreterDispatchGeneratedRsArtifact) used to call artifact_generate(a: a) a second time here, discarding the content and keeping only success/failure — one Filesystem.Read, but TWO artifact_generate calls per artifact for those two variants, contradicting gunbc.generated_artifact_observation's 'one artifact_generate per artifact' claim. Every caller now supplies the outcome it already produced (observe_generated_artifact reuses its own match result); no second entry point to generation remains."

fn artifact_extra_valid(a: gunbc.generated_artifact.GeneratedArtifact, generated: ArtifactGenerationOutcome) -> Bool {
  match a {
    gunbc.generated_artifact.WitnessFloorYamlArtifact => gunbc.ci_yaml_validate.ci_yml_parses(path: gunbc.generated_artifact.artifact_path(a: a))
    gunbc.generated_artifact.FleetConvergeYamlArtifact => gunbc.ci_yaml_validate.ci_yml_parses(path: gunbc.generated_artifact.artifact_path(a: a))
    gunbc.generated_artifact.GitignoreArtifact => true
    gunbc.generated_artifact.GitattributesArtifact => true
    gunbc.generated_artifact.RoadmapArtifact => true
    gunbc.generated_artifact.DesignArtifact => true
    gunbc.generated_artifact.GithooksPrePushArtifact => true
    gunbc.generated_artifact.GithooksPreCommitArtifact => true
    gunbc.generated_artifact.GeneratedArtifactMergeDriverArtifact => true
    gunbc.generated_artifact.RunnerDeployArtifact => true
    gunbc.generated_artifact.Stage0CrateLayoutGeneratedDagArtifact => true
    gunbc.generated_artifact.Stage0CrateLayoutGeneratedRsArtifact => true
    gunbc.generated_artifact.Stage0CratePartitionGeneratedDagArtifact => true
    gunbc.generated_artifact.V1InterpreterDispatchGeneratedRsArtifact => match generated {
      ArtifactGenerated { content: _ } => true
      ArtifactGenerationRefused { reason: _ } => false
    }
    gunbc.generated_artifact.AutoinstallUserDataArtifact { spec: _ } => true
    gunbc.generated_artifact.ProxyDhcpDnsmasqArtifact { spec: _ } => true
    gunbc.generated_artifact.PlanArtifact { plan: _ } => true
  }
}
