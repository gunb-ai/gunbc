module gunbc.parse_verdict_schema

import std.types { Bool, String, List, Map, NonEmptyStr }
import std.optional { Absent, Optional, Present }
import std.algebra { map_lookup }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import std.dissolution { DissolutionCondition, unbound_dissolution }

// THE PARSE-VERDICT RECEIPT WIRE, ONE PLACE. ParseVerdictRequest stays a family of
// std.materialization_provider ArtifactRequest (extracting the variant would fork the coproduct).
// This module is the third import_closure_live entry of the parse-compiler identity: the wire
// a publisher stamps and a consumer reads, not the rest of ArtifactRequest.

data parse_verdict_request_family: String = "parse-verdict"
data parse_verdict_receipt_accepted: String = "Accepted"

fn parse_verdict_stored_accepted_line(source_digest: String, compiler: String) -> String {
  join([parse_verdict_request_family, "\t", source_digest, "\t", compiler, "\t", parse_verdict_receipt_accepted], "")
}

data parse_verdict_receipts_empty_detail: String = "ParseVerdictReceiptsEmpty: compiler-stamped walk produced no Accepted receipts"

// PR-2 is the named consumer of restore-keys and of the saved receipts blob. PR-1 publishes
// and does not restore. The trigger is the restoring step existing on pull_request heads.
type ParseVerdictLaterConsumer {
  declaration: DeclarationRef
  named_consumer: NonEmptyStr
  trigger: DissolutionCondition
}

data parse_verdict_pr2_restore_frontier: ParseVerdictLaterConsumer = ParseVerdictLaterConsumer {
  declaration: DeclarationRef {
    module_path: "gunbc.parse_verdict_schema",
    decl_name: "parse_verdict_request_family",
    field: WholeDeclaration
  },
  named_consumer: "gunbc.parse_verdict_restore — PR-2 restores the GHA prefix gunbc-materialization-parse-verdict-<compiler>- on pull_request and reads receipts.tsv",
  trigger: unbound_dissolution(description: "dissolves when the PR-2 consumer step restores that prefix on pull_request heads and the parse step reuses a receipt only on exact identity, counting every miss by its typed standing")
}

// Named roots of the parse-compiler identity (not the member list). Members are
// v2.lens.module_graph import_closure_live over these paths with pool_roots dag + src/v2.
data parse_compiler_tokenize_entry: String = "src/v2/compiler/tokenize.dag"
data parse_compiler_parse_entry: String = "src/v2/compiler/parse.dag"
data parse_compiler_schema_entry: String = "dag/gunbc/parse_verdict_schema.dag"

fn parse_compiler_identity_entries() -> List<String> {
  [parse_compiler_tokenize_entry, parse_compiler_parse_entry, parse_compiler_schema_entry]
}

// Independent I_base observation: main publishes a tiny identity blob keyed by github.sha
// alone (gunbc-parse-identity-<sha>), content = parse-compiler identity. PR-2 restores
// that exact key for base.sha; it does not infer I_base from a receipts miss.
data parse_compiler_sha_identity_cache_prefix: String = "gunbc-parse-identity-"
data parse_compiler_sha_identity_blob_dir: String = ".gunbc/parse-sha-identity"

fn parse_compiler_sha_identity_cache_key(sha: String) -> String {
  join([parse_compiler_sha_identity_cache_prefix, sha], "")
}

fn parse_compiler_sha_identity_blob_path() -> String {
  join([parse_compiler_sha_identity_blob_dir, "/identity"], "")
}

// THE PER-MODULE REUSE STANDING. A pull-request run reuses a stored Accepted receipt only on EXACT
// identity: the restored base identity equals the head's compiler identity AND the module's own
// receipt line (digest stamped with that identity) is in the restored receipts. Every other state is
// a typed, countable miss that re-parses; none is widened to a near identity, and an absent
// (evicted or never restored) entry is a miss, never Accepted (DESIGN.md section 5). The absence
// misses are one arm each because they ask for different fixes: a missing identity blob means the
// base sha never published, a missing receipts blob means the entry was evicted (GHA caches are
// released after idle and capped per repository, extdeps.cache.github_actions).
type ParseVerdictStanding
  = Reused
  | MissIdentityAbsent
  | MissIdentityMismatch
  | MissEntryAbsent
  | MissDigestUnseen

fn parse_verdict_standing(
  i_head: String,
  i_base: Optional<String>,
  receipt_lines: Optional<Map<String, Bool>>,
  source_digest: String
) -> ParseVerdictStanding {
  match i_base {
    Absent => MissIdentityAbsent
    Present { value: base } =>
      if base != i_head {
        MissIdentityMismatch
      } else {
        match receipt_lines {
          Absent => MissEntryAbsent
          Present { value: lines } =>
            match map_lookup(m: lines, key: parse_verdict_stored_accepted_line(source_digest: source_digest, compiler: i_head)) {
              Present { value: _ } => Reused
              Absent => MissDigestUnseen
            }
        }
      }
  }
}

// The directory a pull-request run restores both base-sha entries into; the verb reads these two
// names under it, so the workflow's restore paths and the reader share one spelling.
data parse_verdict_restore_identity_basename: String = "identity"
data parse_verdict_restore_receipts_basename: String = "receipts.tsv"
