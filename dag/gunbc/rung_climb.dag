module gunbc.rung_climb

import std.types { String }
import gunbc.dashboard_node_uri { dashboard_node_uri_scheme, text_spells_a_dashboard_node_uri }

// THE REFERENT-FREE CORE OF A DESIGN section 4b(2) NEXT-RUNG TRIGGER, shared by every carrier that
// says why a class sits below its ceiling: gunbc.guarantee_stall (a standing stall, whose trigger
// additionally carries the lifecycle referents it asked to deliver) and
// gunbc.recurring_failure_mode (a ledger row). The capability a trigger names is a fact about the
// climb; `awaiting` is a separate fact about who was asked, and a lifecycle referent reaches
// roadmap_model and extdeps.github. A reader of rungs should not import that closure (section 3,
// transitive reach), so the blocker and the capability wall live here and guarantee_stall composes
// them with `awaiting` -- the types are re-used, never mirrored. The rung itself is
// gunbc.guarantee_rung.

// THE THREE-WAY DISTINCTION section 4b(2) NAMES, modeled as a closed coproduct because that is
// what makes "only the first is permanent" a fold rather than a reading. AwaitsOneGrounding
// carries the authority it waits on: a stall that cannot name what it is waiting for is not
// waiting, it is unbuilt, and the two rank differently for work.
type ClimbBlocker
  = CannotClimbFurther { why: String }
  | AwaitsOneGrounding { grounding: String }
  | ClimbableButUnbuilt

fn climb_blocker_label(b: ClimbBlocker) -> String {
  match b {
    CannotClimbFurther { why: w } => concat("cannot climb further: ", w)
    AwaitsOneGrounding { grounding: g } => concat("awaits one grounding: ", g)
    ClimbableButUnbuilt => "climbable now but unbuilt"
  }
}

// THE SECOND WALL OVER THE SAME FIELD, AND IT IS A DIFFERENT SUBJECT FROM THE FIRST. 4b(2) asks
// whether a trigger was NAMED; this asks whether what was named is a capability rather than a
// lifecycle-bounded referent's ending. A row can satisfy the first and fail this one, which is the
// state every migrated row here was in.
type TriggerAdmission
  = TriggerAdmitted
  | TriggerCapabilityEmpty { subject: String }
  | TriggerCapabilitySpellsAReferent { subject: String, scheme: String }

// The wall over a bare capability string; guarantee_stall's wall over a NextRungTrigger delegates here.
fn trigger_capability_admission(subject: String, capability: String) -> TriggerAdmission {
  if capability == "" {
    TriggerCapabilityEmpty { subject: subject }
  } else {
    if text_spells_a_dashboard_node_uri(text: capability) {
      TriggerCapabilitySpellsAReferent { subject: subject, scheme: dashboard_node_uri_scheme }
    } else {
      TriggerAdmitted
    }
  }
}

fn trigger_admission_label(a: TriggerAdmission) -> String {
  match a {
    TriggerAdmitted => "admitted"
    TriggerCapabilityEmpty { subject: subj } => concat("untracked stall, no trigger named: ", subj)
    TriggerCapabilitySpellsAReferent { subject: subj, scheme: sch } =>
      concat(
        concat("trigger rests on a lifecycle-bounded referent spelled into its capability (", sch),
        concat("): ", subj),
      )
  }
}

