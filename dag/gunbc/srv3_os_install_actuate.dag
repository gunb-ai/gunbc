module gunbc.srv3_os_install_actuate


data gunbc_srv3_os_install_actuate_scope_disposition: std.disposition.Disposition = std.disposition.Terminal {
  reason: "prefix:os-install-actuated runnable prep — ISO fetch, derived actuator host, three-step actuator plan (nbd_proxy_serve, boot-once-cd, force-restart) as gunbc run entrypoints. Scope boundary: gunbc.srv3_os_install_actuate_scope (actuator prep + runbook ONLY; seed gap fail-closed; credential debt scaffold). Live mount+boot+install operator-gated; nbd_proxy_serve is a held session via host_effect_apply (systemd transient units)."
}

data srv3_os_install_actuate_shell_runner_scaffold: std.disposition.Disposition = std.disposition.Scaffold {
  dissolves_to: SingleAuthority,
  bind: std.decl_ref.DeclarationRef {
    module_path: "gunbc.live_deploy.emit",
    decl_name: "live_deploy_emit_shell_dissolution_trigger",
    field: WholeDeclaration,
  }
}

data srv3_os_install_actuate_operator_runbook: std.types.NonEmptyStr = "docs/runbooks/srv3-os-install-actuate.md"

fn srv3_bmcweb_login_body_content() -> String {
  let intent = srv3_os_install_actuate_credential_intent()
  bmcweb_login_body_content(
    username: intent.account,
    password: intent.factory_login.published_password as String,
  )
}

fn srv3_bmcweb_login_body_content_for_resolution(resolution: gunbc.srv3_bmc_credential_resolve.BmcCredentialResolution, password: String) -> String {
  match resolution {
    UseFactoryCredential { login: l } =>
      bmcweb_login_body_content(username: l.username, password: password)
    UseRotatedSecretRef { secret_ref: _ } => {
      let intent = srv3_os_install_actuate_credential_intent()
      bmcweb_login_body_content(username: intent.account, password: password)
    }
    CredentialResolutionRefused { reason: _ } => {
      let intent = srv3_os_install_actuate_credential_intent()
      bmcweb_login_body_content(username: intent.account, password: password)
    }
  }
}

func srv3_bmcweb_session_login() -> std.process.ProcessExit
  uses net: std.cache_interface.Network
{
  let resolution = observe_and_resolve_srv3_bmc_credential()
  return match resolution {
    CredentialResolutionRefused { reason: r } =>
      exit_failure(reason: concat("bmcweb-login: credential resolution refused: ", r))
    _ => srv3_bmcweb_session_login_resolved(resolution: resolution)
  }
}

// THE EMPTY-TOKEN CHECK THAT STOOD IN THIS FOLD IS DELETED, NOT MOVED (DESIGN §4b,
// dissolution on climb). It ran shell.Test.IsNonEmpty on srv3_bmcweb_token_path — the file
// the extract step had just written — so it conceded that writing an empty credential file
// was a reachable state and merely reported it afterwards. gunbc.host_effect_realize
// `bmcweb_token_extraction_verdict` now refuses an absent, null or blank token BEFORE
// Filesystem.Write, so a converged extract cannot have produced an empty file and a second
// reading of that file has nothing left to discover.
func srv3_bmcweb_session_login_resolved(resolution: gunbc.srv3_bmc_credential_resolve.BmcCredentialResolution) -> std.process.ProcessExit
  uses net: std.cache_interface.Network
{
  let materialization = materialize_bmc_login_password(resolution: resolution)
  let password = match materialization {
    BmcCredentialMaterialized { password: password } => password
    BmcCredentialAccessUpsertRequired { plan: plan } =>
      return exit_failure(
        reason: concat(
          "bmcweb-login: ",
          access_token_upsert_required_reason(plan: plan),
        ),
      )
    BmcCredentialFetchRefused { reason: reason } =>
      return exit_failure(reason: concat("bmcweb-login: ", reason as String))
  }

  let body_content = srv3_bmcweb_login_body_content_for_resolution(
    resolution: resolution,
    password: password,
  )
  let body_write = Filesystem.Write(
    path: srv3_bmcweb_login_body_path,
    content: body_content,
  )
  if body_write.success == false {
    return exit_failure(reason: concat("bmcweb-login: body write failed: ", body_write.error))
  }

  let login_exit = srv3_reconciliation_to_process_exit(
    r: srv3_bmcweb_session_login_apply(),
    failure_prefix: "bmcweb-login: curl login failed: ",
  )
  match login_exit {
    ExitSuccess => {}
    _ => return login_exit
  }

  let extract_exit = srv3_reconciliation_to_process_exit(
    r: srv3_bmcweb_token_extract_apply(),
    failure_prefix: "bmcweb-login: token extract failed: ",
  )
  match extract_exit {
    ExitSuccess => {}
    _ => return extract_exit
  }

  ExitSuccess
}

func srv3_nbd_proxy_serve() -> std.process.ProcessExit
  uses net: std.cache_interface.Network
{
  srv3_reconciliation_to_process_exit(
    r: srv3_nbd_proxy_serve_apply(),
    failure_prefix: "nbd-proxy-serve: host effect apply refused: ",
  )
}

// The step count was never the subject — that the plan is DERIVED from the solved
// mechanism was. srv3's BMC upgrade propagates through that derivation and the
// plan now refuses, which is the observable that distinguishes a derived plan
// from a hardcoded three-step one: a hardcoded plan would still be Ready.
fn srv3_os_install_actuator_plan_refuses_on_unestablished_path() -> Bool {
  match srv3_os_install_actuator_plan_standing {
    ActuatorPlanRefused { cause: _ } => true
    ActuatorPlanReady { plan: _, intents: _ } => false
  }
}

fn srv3_os_install_actuate_runbook_is_declared() -> Bool {
  string_contains(s: srv3_os_install_actuate_operator_runbook as String, pattern: "srv3-os-install-actuate")
}
