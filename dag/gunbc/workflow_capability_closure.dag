module gunbc.workflow_capability_closure

// WHY THIS SITS ABOVE extdeps.github.actions AND NOT INSIDE IT.
//
// RunStep { run: String } is a FAITHFUL model of the GitHub wire format -- a step really is an
// opaque script to GitHub -- so the string is correct as a wire fact and must not be replaced by
// something richer. The defect is one layer up: product modules construct that wire
// representation directly for operations whose semantics are known, so a step that NEEDS a
// toolchain and a step that PROVIDES one are indistinguishable by the time they are Steps.
//
// This module therefore models the relationship a step has to the capabilities its job needs,
// and leaves Step alone (DESIGN §3: cite the upstream spec, keep its shape; the semantic layer
// is ours, the wire model is theirs).
//
// WHY STRUCTURAL AND NOT TEXTUAL. The same consumption is spelled `cargo build` in one workflow
// and `"$CARGO_BIN" build` in another. No text pattern reliably calls those the same thing --
// measured: a regex over the second form returned a confident ZERO on a file that invokes cargo
// twice, because a closing quote sits between the name and the space. A check that cannot see
// one of the two live spellings is not a weaker check, it is a check whose green means nothing
// for half the corpus.

// PROVIDES AND CONSUMES ARE NOT MUTUALLY EXCLUSIVE, which is why this is a record and not the
// three-variant coproduct it started as. Real steps do both: the rustup pin step CONSUMES rustup
// and PROVIDES the resolved cargo binding the build step later uses. And one step routinely
// provides SEVERAL capabilities -- setup-rust-toolchain installs cargo, rustc and rustfmt in one
// action, so a singular carrier would force either a false Neutral on the steps that consume
// rustc, or a lie about what the action installs.
//
// Discovered by binding a second workflow rather than reasoned in advance: the first bound job
// happened to need exactly one capability, and a model that fits one specimen is not yet a model.
// A neutral step is the empty relation, not a distinct variant.
type StepCapabilityRole {
  provides: List<ExecutionCapability>
  consumes: List<ExecutionCapability>
}

data capability_neutral: StepCapabilityRole = StepCapabilityRole { provides: [], consumes: [] }

fn provides_only(capabilities: List<ExecutionCapability>) -> StepCapabilityRole {
  StepCapabilityRole { provides: capabilities, consumes: [] }
}

fn consumes_only(capabilities: List<ExecutionCapability>) -> StepCapabilityRole {
  StepCapabilityRole { provides: [], consumes: capabilities }
}

type CapabilityAnnotatedStep {
  step_name: String
  role: StepCapabilityRole
}

// A consumer with no provider ORDERED BEFORE IT is refused, and the refusal names the step and
// the capability rather than reporting a bare false.
type CapabilityClosureVerdict
  = CapabilityClosureClosed
  | CapabilityClosureUnprovided {
      step_name: String,
      capability_label: String,
    }

type CapabilityClosureScan {
  provided: List<String>
  verdict: CapabilityClosureVerdict
}

fn capability_label_present(labels: List<String>, wanted: String) -> Bool {
  v2.std.algebra.fold_list(
    xs: labels,
    empty: false,
    cons: fn(acc, l) { acc || l == wanted },
  )
}

// ORDER IS THE POINT, not mere presence. A provider that runs AFTER its consumer is exactly the
// deploy.yml failure with an extra step: the job contains a toolchain somewhere and the cargo
// invocation still resolves nothing. So the fold consumes the step list in order and a capability
// counts as available only once a preceding step has provided it.
fn first_unprovided(
  wanted: List<ExecutionCapability>,
  provided: List<String>,
  step_name: String,
) -> CapabilityClosureVerdict {
  fold_list(
    xs: wanted,
    empty: CapabilityClosureClosed,
    cons: fn(acc, c) {
      match acc {
        CapabilityClosureUnprovided { step_name: _, capability_label: _ } => acc
        CapabilityClosureClosed =>
          if capability_label_present(
            labels: provided,
            wanted: execution_capability_label(capability: c),
          ) {
            acc
          } else {
            CapabilityClosureUnprovided {
              step_name: step_name,
              capability_label: execution_capability_label(capability: c),
            }
          }
      }
    },
  )
}

fn add_provided(provided: List<String>, granted: List<ExecutionCapability>) -> List<String> {
  fold_list(
    xs: granted,
    empty: provided,
    cons: fn(acc, c) {
      list_snoc_item(xs: acc, item: execution_capability_label(capability: c))
    },
  )
}

// ORDER IS THE POINT, not mere presence. A provider that runs AFTER its consumer is exactly the
// deploy.yml failure with an extra step: the job contains a toolchain somewhere and the cargo
// invocation still resolves nothing. So the fold consumes the step list in order and a capability
// counts as available only once a preceding step has provided it.
//
// Within one step, consumes is checked BEFORE provides is granted. A step cannot satisfy its own
// requirement -- otherwise a step declaring both would always close, which is the vacuous answer.
fn workflow_job_capability_closure(steps: List<CapabilityAnnotatedStep>) -> CapabilityClosureVerdict {
  let scanned = fold_list(
    xs: steps,
    empty: CapabilityClosureScan { provided: [], verdict: CapabilityClosureClosed },
    cons: fn(acc, s) {
      match acc.verdict {
        CapabilityClosureUnprovided { step_name: _, capability_label: _ } => acc
        CapabilityClosureClosed =>
          match first_unprovided(
            wanted: s.role.consumes,
            provided: acc.provided,
            step_name: s.step_name,
          ) {
            CapabilityClosureUnprovided { step_name: n, capability_label: l } =>
              CapabilityClosureScan {
                provided: acc.provided,
                verdict: CapabilityClosureUnprovided { step_name: n, capability_label: l },
              }
            CapabilityClosureClosed =>
              CapabilityClosureScan {
                provided: add_provided(provided: acc.provided, granted: s.role.provides),
                verdict: CapabilityClosureClosed,
              }
          }
      }
    },
  )
  scanned.verdict
}

fn capability_closure_is_closed(v: CapabilityClosureVerdict) -> Bool {
  match v {
    CapabilityClosureClosed => true
    CapabilityClosureUnprovided { step_name: _, capability_label: _ } => false
  }
}
