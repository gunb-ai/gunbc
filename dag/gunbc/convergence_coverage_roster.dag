    exclude("gunbc.executor_privileged_operation", "executor_privileged_owned_directory_plan", "executor_privileged_operation", Decide, "references substrate result types, invokes no substrate fold-site directly; substrate symbols in module: [EnsurePlan]; references substrate result types; fold composes through a module-local helper (cross-module discovery join is SubstrateInputsOnly)", "references substrate result types; fold composes through a module-local helper (cross-module discovery join is SubstrateInputsOnly)", "grep importer, consumer"),
    exclude("gunbc.fleet.app_control_plane_inspection", "json_member_string", "app_control_plane_inspection", Observe, "observe-only producer feeding a fold route, not a fold itself; substrate symbols in module: []; observation/readback input feeding a named fold route; invokes no substrate fold-site", "observation/readback input feeding a named fold route; invokes no substrate fold-site", "grep importer, consumer"),
    exclude("gunbc.fleet.convergence_fold", "step_instance_key_eq", "convergence_fold", Decide, "references substrate result types, invokes no substrate fold-site directly; substrate symbols in module: []; references substrate result types; fold composes through a module-local helper (cross-module discovery join is SubstrateInputsOnly)", "references substrate result types; fold composes through a module-local helper (cross-module discovery join is SubstrateInputsOnly)", "grep importer, consumer"),
    exclude("gunbc.fleet.fleet_converge_apply", "converge_apply", "fleet_converge_apply", Decide, "references substrate result types, invokes no substrate fold-site directly; substrate symbols in module: [Converged,NotConverged,Reconciliation,reconciliation_converged]; references substrate result types; fold composes through a module-local helper (cross-module discovery join is SubstrateInputsOnly)", "references substrate result types; fold composes through a module-local helper (cross-module discovery join is SubstrateInputsOnly)", "grep importer, consumer"),
