module gunbc.convergence_coverage_roster

import std.types { Bool, List }
import std.algebra { length }
import std.decl_ref {
  DeclarationRef,
  decl_ref,
  declaration_ref_eq,
}

// ROADMAP node cc-path-census roster carrier: the production convergence-path
// roster the eight cc-* leaves consume as their denominator.
//
// WHAT THIS IS. A roster, one row per production convergence path, each row
// naming a corpus route (a .dag declaration that exists at the base commit),
// its convergence subject, the operation it performs (observe, decide, apply,
// readback, mint), whether the fold SUPPLIES a report or ESTABLISHES a
// prerequisite operand the consumer would be deprived of, and the cc-* leaf
// that covers it (or a named exclusion for a corpus route that is not an
// enforced convergence path at this rung). The roster is the denominator; a
// later cc-* leaf inventing its own list of paths is the displaced cost this
// carrier exists to remove.
//
// ROW UNIT (guard one). A row is a PATH, identified by (module_path, function,
// operation) -- NOT a file. One file can carry several paths. The identity-join
// key is the route DeclarationRef { module_path, decl_name }, not the file
// path. Row count is reported as paths, and the file count is reported beside
// it, so a reader sees the 20 enforced paths spread over 13 files.
//
// DERIVATION (the denominator is re-derivable in one command, not a trusted
// number). The enforced population is the production paths that INVOKE a
// substrate fold-site function. Re-derive from the corpus root with:
//
//   grep -rln "gunbc\.ensure\b\|std\.realization_reconcile\b" --include=*.dag \
//     . | grep -v "/.git/" | grep -v "test/claim" \
//        | grep -v "recurring_failure_mode" | grep -v "integration_concern" \
//     | while read f; do grep -nE \
//       "ensure_decide|ensure_reconcile|ensure_after_grounding|ensure_observation_as_attempt|reconcile_grounded|reconcile_effect_without_read|reconcile_effect\b|reconcile_application_then_ground" \
//       "$f" | grep -v "import "; done
//
// The 65-file importer set splits as: 20 enforced fold-site paths over 13
// files; 45 named-exclusion consumer modules (reference substrate result
// types or compose a fold through a wrapper, invoke no fold-site directly);
// 5 named-exclusion plan/census carriers; 2 named-exclusion substrate modules.
// Enforced vs excluded is a difference in what the completeness check refuses
// on, not a licence to drop a row: every 65-file hit appears in roster_rows().
//
// WHAT THE JOIN CANNOT REACH (guard three; under-claim honestly). This join
// enforces PRESENCE of the 20 derived fold-site routes. It cannot enforce a
// completeness discovery join over independently enumerated host-effect
// declarations so that a missing wrapper-mediated fold refuses: that join is
// SubstrateInputsOnly, the same limitation host_convergence_census records in
// its NEXT-RUNG TRIGGERS ("a discovery join over independently enumerated
// host-effect declarations so a missing mutation identity refuses" is not
// authorable on the current path). A fold that composes entirely through a
// cross-module wrapper without importing a substrate fold-site is therefore an
// acknowledged blind spot of the enforced join, named here rather than hidden.
//
// D14 SECTION 10 (what is being classified against; never pasted into a row).
// The D14 ensure-authority plan file dag/gunbc/plans/ensure_closure_design.dag
// was deleted in commit 970754b2577; its section 10 "Census: what this replaces
// on main" is the On main / Becomes target list the red control names as NOT a
// census row. No row restates it. Where a row traces to D14 it cites the LIVE
// ruling text: dag/gunbc/plans/demand_engine_program.dag line 264.
//
// PRE-SUBSTRATE FINDING. The operator-review first-slice folds
// srv3_ensure_apt, ensure_host_tool and converge_typed_remote_file live in
// modules that do not import the substrate today; they are pre-substrate folds
// D14 names for migration, so they are roster rows classified
// supplied-versus-established and marked PreSubstrate, but they are NOT in the
// enforced fold-site population. The RunArgv family (RunArgv / RunArgvStdin /
// RunArgvOutcome) is Rust substrate reached from the corpus route
// gunbc.host.host_effect_realize.reconcile_shell_exec_observed.

// The convergence operation a fold performs (D14: the lifecycle inside one
// demand node is observe, assess/decide, apply, read back, mint).
type ConvergenceOperation
  = Observe
  | Decide
  | Apply
  | Readback
  | Mint

// Whether removing a prerequisite-producing ensure deprives the consumer of a
// required operand. EstablishedOperand: the fold establishes an operand a
// downstream consumer reads, so removing it starves that consumer.
// SuppliedReport: the fold only reports a status the consumer displays or logs
// and does not consume as a structural operand. NamedExclusion: the corpus
// route references the substrate but is not an enforced convergence path at
// this rung, with the reason carried per row (never a blanket exclusion).
type ConvergenceClassification
  = EstablishedOperand { rationale: String }
  | SuppliedReport { rationale: String }
  | NamedExclusion { reason: String }

// Enforcement status of a row.
type ConvergenceStatus
  = Enforced
  | Excluded
  | PreSubstrate

// The cc-* leaf that covers the row, or a named pending leaf.
type ConvergenceCover
  = CoveredByLeaf { leaf: String }
  | PendingLeaf { leaf: String }

// One roster row. identity is the route DeclarationRef (the identity-join
// key); module_path and route carry it in readable form.
type ConvergenceRosterRow {
  identity: DeclarationRef
  module_path: String
  route: String
  subject: String
  operation: ConvergenceOperation
  status: ConvergenceStatus
  classification: ConvergenceClassification
  cover: ConvergenceCover
  composition: String
  provenance: String
}

// The join outcome: a required route absent from the roster is the fail-closed
// red signal; otherwise the join is covered.
type ConvergenceCensusJoin
  = IdentityMissingFromCensus { identity: DeclarationRef }
  | JoinCovered { covered: List<DeclarationRef> }

fn cite(module_path: String, decl_name: String) -> DeclarationRef {
  decl_ref(module_path: module_path, decl_name: decl_name)
}

fn row(
  identity: DeclarationRef,
  module_path: String,
  route: String,
  subject: String,
  operation: ConvergenceOperation,
  status: ConvergenceStatus,
  classification: ConvergenceClassification,
  cover: ConvergenceCover,
  composition: String,
  provenance: String,
) -> ConvergenceRosterRow {
  ConvergenceRosterRow {
    identity: identity,
    module_path: module_path,
    route: route,
    subject: subject,
    operation: operation,
    status: status,
    classification: classification,
    cover: cover,
    composition: composition,
    provenance: provenance,
  }
}

fn established(rationale: String) -> ConvergenceClassification {
  EstablishedOperand { rationale: rationale }
}

fn supplied(rationale: String) -> ConvergenceClassification {
  SuppliedReport { rationale: rationale }
}

fn excluded(reason: String) -> ConvergenceClassification {
  NamedExclusion { reason: reason }
}

fn covered(leaf: String) -> ConvergenceCover {
  CoveredByLeaf { leaf: leaf }
}

fn pending(leaf: String) -> ConvergenceCover {
  PendingLeaf { leaf: leaf }
}

fn enforce(module_path: String, route: String, subject: String, operation: ConvergenceOperation, classification: ConvergenceClassification, cover: ConvergenceCover, composition: String, provenance: String) -> ConvergenceRosterRow {
  row(
    identity: cite(module_path, route),
    module_path: module_path,
    route: route,
    subject: subject,
    operation: operation,
    status: Enforced,
    classification: classification,
    cover: cover,
    composition: composition,
    provenance: provenance,
  )
}

fn exclude(module_path: String, route: String, subject: String, operation: ConvergenceOperation, reason: String, composition: String, provenance: String) -> ConvergenceRosterRow {
  row(
    identity: cite(module_path, route),
    module_path: module_path,
    route: route,
    subject: subject,
    operation: operation,
    status: Excluded,
    classification: excluded(reason),
    cover: covered("named exclusion (cc-path-census)"),
    composition: composition,
    provenance: provenance,
  )
}

fn pre_substrate(module_path: String, route: String, subject: String, operation: ConvergenceOperation, classification: ConvergenceClassification, cover: ConvergenceCover, composition: String, provenance: String) -> ConvergenceRosterRow {
  row(
    identity: cite(module_path, route),
    module_path: module_path,
    route: route,
    subject: subject,
    operation: operation,
    status: PreSubstrate,
    classification: classification,
    cover: cover,
    composition: composition,
    provenance: provenance,
  )
}

fn roster_row_identity(row: ConvergenceRosterRow) -> DeclarationRef {
  row.identity
}
// THE ENFORCED DENOMINATOR. The 20 substrate fold-site paths, derived by
// the command in the module header; re-derive to check this list.
fn enforced_fold_site_routes() -> List<DeclarationRef> {
  [
    cite("gunbc.fleet.mtcollins_firmware_converge", "pending_step_verdict"),
    cite("gunbc.fleet.mtcollins_firmware_converge", "executed_step_verdict"),
    cite("gunbc.gcp_service_enablement", "decide_service_enablement"),
    cite("gunbc.host.host_effect_realize", "srv3_shell_reconcile"),
    cite("gunbc.host.host_effect_realize", "toolchain_ensure_reconcile"),
    cite("gunbc.host.host_effect_realize", "realize_install_media_fetch_in_process"),
    cite("gunbc.host.host_effect_realize", "realize_install_media_remaster_in_process"),
    cite("gunbc.host.host_effect_realize", "reconcile_shell_exec_observed"),
    cite("gunbc.host.host_effect_realize", "realize_nbd_proxy_session_on_host"),
    cite("gunbc.host.host_hygiene_liveness", "reconcile_fleet_listening"),
    cite("gunbc.host.host_hygiene_reaper", "reconcile_residual_reap"),
    cite("gunbc.host.host_kernel_dependency", "tun_kernel_capability_decision"),
    cite("gunbc.oomd_install", "reconcile_oomd"),
    cite("gunbc.owned_directory", "owned_directory_decide"),
    cite("gunbc.owned_directory", "owned_directory_reconcile"),
    cite("gunbc.repo.repo_ruleset", "repo_ruleset_ensure_decision_for"),
    cite("gunbc.review_sheet_sheets", "review_sheet_ensure_decide"),
    cite("gunbc.roadmap.roadmap_dispatch_environment", "capability_ensure_receipt"),
    cite("gunbc.runner.runner_slot_enforcement", "reconcile_runner_slot"),
    cite("gunbc.product.printing.cad_runtime_converge", "converge_cad_runtime"),
  ]
}
// The 20 enforced route rows (classified supplied vs established).
