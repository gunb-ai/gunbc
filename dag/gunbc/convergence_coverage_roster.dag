// The complete roster: enforced + pre-substrate + named exclusions.
fn roster_rows() -> List<ConvergenceRosterRow> {
  concat(concat(enforced_rows(), pre_substrate_rows()), excluded_rows())
}

fn identity_present(id: DeclarationRef, rows: List<ConvergenceRosterRow>) -> Bool {
  let hits = filter(xs: rows, predicate: fn(r) { declaration_ref_eq(a: r.identity, b: id) })
  length(xs: hits) > 0
}

// identity-join (guard one: the key is the route DeclarationRef, not the file
// path). Mirrors host_convergence_census.census_identity_join: fold over the
// required set; the first required route with no roster row is the fail-closed
// signal.
fn census_identity_join(required: List<DeclarationRef>, rows: List<ConvergenceRosterRow>) -> ConvergenceCensusJoin {
  fold(
    required,
    init: JoinCovered { covered: [] },
    f: fn(acc, id) {
      match acc {
        IdentityMissingFromCensus { identity: m } => IdentityMissingFromCensus { identity: m }
        JoinCovered { covered: cov } =>
          if identity_present(id, rows) { acc } else { IdentityMissingFromCensus { identity: id } }
      }
    },
  )
}

// The census-completeness claim (GREEN witness): true when the roster names
// every enforced fold-site route. Run at the head sha this passes.
fn convergence_coverage_census_is_complete() -> Bool {
  match census_identity_join(enforced_fold_site_routes(), roster_rows()) {
    JoinCovered { covered: cov } => true
    IdentityMissingFromCensus { identity: miss } => false
  }
}

// The RED leg: the SAME join over the roster with the oomd_install.reconcile_oomd
// enforced route removed. This claim is false (the census refuses) because a
// real corpus route is absent from the roster. Run at the SAME sha and with the
// SAME binary as the GREEN leg, with the identical IdentityMissingFromCensus
// signal. A census that cannot be reddened by a planted omission is not a
// census.
fn convergence_coverage_census_red_control() -> Bool {
  match census_identity_join(
    enforced_fold_site_routes(),
    roster_rows_without_planted_omission(),
  ) {
    JoinCovered { covered: cov } => true
    IdentityMissingFromCensus { identity: miss } => false
  }
}

// The planted-omission control: the removal above must be caught as EXACTLY the
// oomd_install.reconcile_oomd identity, not any other. This witness is true
// when the fail-closed signal names the planted route.
fn planted_omission_is_caught() -> Bool {
  match census_identity_join(
    enforced_fold_site_routes(),
    roster_rows_without_planted_omission(),
  ) {
    IdentityMissingFromCensus { identity: ident } =>
      declaration_ref_eq(a: ident, b: cite("gunbc.oomd_install", "reconcile_oomd"))
    JoinCovered { covered: cov } => false
  }
}

fn roster_rows_without_planted_omission() -> List<ConvergenceRosterRow> {
  filter(
    roster_rows(),
    fn(r) { !declaration_ref_eq(a: r.identity, b: cite("gunbc.oomd_install", "reconcile_oomd")) },
  )
}

// Row-count witness: 20 enforced + 3 pre-substrate + 52 named exclusions = 75
// rows, covering every one of the 65 grep-hit files.
fn census_row_count_is_complete() -> Bool {
  length(xs: roster_rows()) == 75
}
