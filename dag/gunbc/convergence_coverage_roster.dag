// The first-slice named folds NOT yet in the substrate population:
// pre-substrate folds D14 names for migration, classified anyway. Their
// RunArgv-family sibling is the enforced route reconcile_shell_exec_observed
// above (the RunArgv family is Rust substrate reached from that route).
fn pre_substrate_rows() -> List<ConvergenceRosterRow> {
  [
    pre_substrate("gunbc.host.host_effect_realize", "srv3_ensure_apt", "apt package (srv3 subject/package split)", Decide, established("srv3_ensure_apt establishes the apt package operand install consumes (install uses package, readback checks subject); pre-substrate: its module does not import gunbc.ensure today (D14 ruling demand_engine_program.dag:264)"), pending("cc-qualified-operands"), "module-local srv3 apt ensure (pre-substrate)", "operator-review first-slice; D14 ruling demand_engine_program.dag:264"),
    pre_substrate("gunbc.runner.runner_microvm_network_apply", "ensure_host_tool", "host tool prerequisite", Decide, established("ensure_host_tool returns a HostToolPrerequisite operand the apply consumes; pre-substrate: its module does not import gunbc.ensure today (D14 ruling demand_engine_program.dag:264)"), pending("cc-qualified-operands"), "module-local host-tool ensure (pre-substrate)", "operator-review first-slice; D14 ruling demand_engine_program.dag:264"),
    pre_substrate("gunbc.typed_remote_file_write", "converge_typed_remote_file", "typed remote file bytes", Apply, established("converge_typed_remote_file establishes the written remote-file operand its readback verifies; pre-substrate: its module does not import std.realization_reconcile today (D14 ruling demand_engine_program.dag:264)"), pending("cc-consumer-operand-starvation"), "module-local typed remote file converge (pre-substrate)", "operator-review first-slice; D14 ruling demand_engine_program.dag:264"),
  ]
}
// Named exclusions: the 2 substrate modules, the 5 plan/census carriers,
// and the 45 consumer modules. Each is argued per row (never a blanket
// exclusion) and names the wrapper or substrate symbols its fold composes
// through. Enforced vs excluded is a difference in what the completeness
// check refuses on, not a licence to drop a row.
fn excluded_rows() -> List<ConvergenceRosterRow> {
  [
    exclude("gunbc.ensure", "ensure_observation_as_attempt", "the gunbc.ensure classifier module itself", Decide, "this row is the gunbc.ensure classifier the population grep searched FOR, not a path that uses it; it is substrate, so it is never an enforced consumer path", "substrate: gunbc.ensure", "substrate module"),
    exclude("std.realization_reconcile", "reconcile_grounded", "the std.realization_reconcile substrate module itself", Apply, "this row is the std.realization_reconcile substrate the grep searched FOR, not a path that uses it; substrate, never an enforced consumer path", "substrate: std.realization_reconcile", "substrate module"),
    exclude("gunbc.host_convergence_census", "admit_host_convergence_census", "host_convergence_census (plan/census carrier)", Decide, "census/plan carrier: the convergence-ONE C0 registry, a census of host-effect subjects classified by disposition, not a production convergence fold; it cites the stack and rewires nothing", "plan/census carrier; invokes no substrate fold-site as a production path", "grep importer, carrier"),
    exclude("gunbc.host_convergence_protocol", "reconcile_from_read_attempt", "host_convergence_protocol (plan/census carrier)", Apply, "plan/protocol carrier: a transition-system spec over convergence subjects, a design carrier not a production fold invocation", "plan/census carrier; invokes no substrate fold-site as a production path", "grep importer, carrier"),
    exclude("gunbc.plans.read_set_convergence", "read_set_convergence_inventory_row", "read_set_convergence (plan/census carrier)", Apply, "plan carrier: a read-set convergence inventory plan, a design document not a production fold", "plan/census carrier; invokes no substrate fold-site as a production path", "grep importer, carrier"),
    exclude("gunbc.plans.demand_engine_program", "demand_engine_program_body", "demand_engine_program (plan/census carrier)", Decide, "plan carrier: the demand-engine program plan (holds the live D14 ruling text); a design document not a production fold", "plan/census carrier; invokes no substrate fold-site as a production path", "grep importer, carrier"),
    exclude("gunbc.roadmap.roadmap_authority", "nid", "roadmap_authority (plan/census carrier)", Decide, "plan carrier: the roadmap authority (roadmap node/edge definitions), not a production fold invocation", "plan/census carrier; invokes no substrate fold-site as a production path", "grep importer, carrier"),
