  [
    enforce("gunbc.fleet.mtcollins_firmware_converge", "pending_step_verdict", "firmware convergence step, pending", Decide, supplied("pending verdict is a status report; the flash operand is carried by the step, not by the verdict"), pending("cc-qualified-operands"), "ensure_decide (gunbc.ensure)", "fold-site grep"),
    enforce("gunbc.fleet.mtcollins_firmware_converge", "executed_step_verdict", "firmware convergence step, executed readback", Apply, established("executed readback establishes the applied-step operand the next step reads"), pending("cc-lifecycle-ownership"), "ensure_reconcile (gunbc.ensure)", "fold-site grep"),
    enforce("gunbc.gcp_service_enablement", "decide_service_enablement", "GCP service enablement plan", Decide, established("EnsurePlan EnableApiPlan is the operand the enable apply consumes; removing it starves that apply"), pending("cc-operand-supply-decision"), "ensure_decide (gunbc.ensure)", "fold-site grep"),
    enforce("gunbc.host.host_effect_realize", "srv3_shell_reconcile", "srv3 shell effect", Apply, established("reconcile establishes the converged shell-effect operand its readback and the next effect read"), pending("cc-consumer-operand-starvation"), "reconcile_grounded (std.realization_reconcile)", "fold-site grep"),
    enforce("gunbc.host.host_effect_realize", "toolchain_ensure_reconcile", "host toolchain prerequisite", Apply, established("HostToolPrerequisite is the operand apply consumes; removing it starves the host effect"), pending("cc-operand-fork"), "reconcile_grounded (std.realization_reconcile)", "fold-site grep"),
    enforce("gunbc.host.host_effect_realize", "realize_install_media_fetch_in_process", "install media fetch", Apply, established("establishes the fetched install media operand the remaster/boot step consumes"), pending("cc-lifecycle-ownership"), "reconcile_grounded (std.realization_reconcile)", "fold-site grep"),
    enforce("gunbc.host.host_effect_realize", "realize_install_media_remaster_in_process", "install media remaster", Apply, established("establishes the remastered image operand the boot read consumes"), pending("cc-lifecycle-ownership"), "reconcile_grounded (std.realization_reconcile)", "fold-site grep"),
    enforce("gunbc.host.host_effect_realize", "reconcile_shell_exec_observed", "RunArgv / RunArgvStdin / RunArgvOutcome shell exec", Readback, established("reconciles RunArgv output into the observed-effect operand a reader consumes; the RunArgv family first-slice fold is reached from this route (D14 ruling demand_engine_program.dag:264)"), pending("cc-consumer-operand-starvation"), "reconcile_grounded (std.realization_reconcile)", "fold-site grep"),
    enforce("gunbc.host.host_effect_realize", "realize_nbd_proxy_session_on_host", "NBD proxy session", Apply, established("establishes the nbd proxy session operand the install fetch consumes"), pending("cc-lifecycle-ownership"), "reconcile_grounded (std.realization_reconcile)", "fold-site grep"),
    enforce("gunbc.host.host_hygiene_liveness", "reconcile_fleet_listening", "fleet listening liveness", Readback, supplied("liveness reconcile only surfaces a listening-status report; no downstream operand is deprived"), pending("cc-attested-consume"), "reconcile_grounded (std.realization_reconcile)", "fold-site grep"),
    enforce("gunbc.host.host_hygiene_reaper", "reconcile_residual_reap", "residual session reap", Readback, supplied("reap reconcile reports reaped residuals; no structural operand is consumed downstream"), pending("cc-attested-consume"), "reconcile_grounded (std.realization_reconcile)", "fold-site grep"),
    enforce("gunbc.host.host_kernel_dependency", "tun_kernel_capability_decision", "tun kernel capability", Decide, supplied("capability decision yields CapabilityEvidence for reporting; the tun operand is supplied by the capability probe itself"), pending("cc-operand-supply-decision"), "ensure_decide (gunbc.ensure)", "fold-site grep"),
    enforce("gunbc.oomd_install", "reconcile_oomd", "oomd daemon install", Apply, established("reconcile establishes the installed oomd operand the daemon read consumes"), pending("cc-lifecycle-ownership"), "reconcile_grounded (std.realization_reconcile)", "fold-site grep"),
    enforce("gunbc.owned_directory", "owned_directory_decide", "owned directory install plan", Decide, established("OwnedDirectoryInstallPlan is the operand owned_directory_reconcile applies"), pending("cc-operand-supply-decision"), "ensure_decide (gunbc.ensure)", "fold-site grep"),
    enforce("gunbc.owned_directory", "owned_directory_reconcile", "owned directory install", Apply, established("establishes the installed owned-directory operand the readback verifies"), pending("cc-consumer-operand-starvation"), "ensure_reconcile (gunbc.ensure)", "fold-site grep"),
    enforce("gunbc.repo.repo_ruleset", "repo_ruleset_ensure_decision_for", "repo ruleset plan", Decide, established("RepoRulesetApplyPlan is the operand the ruleset apply consumes"), pending("cc-operand-supply-decision"), "ensure_decide (gunbc.ensure)", "fold-site grep"),
