module gunbc.devboot.outcome




// The identity of a REQUEST, kept distinct from the identity of what it asks for. Two requesters naming one subject share a subject digest and must share a producer; they do not share a work id, because each still needs to learn its own request's fate. Collapsing the two would make an attach unrepresentable -- the second requester would have nothing of its own to be told about.
type DevbootWorkId = std.types.NonEmptyStr where brand("DevbootWorkId")

// THE ONLY EVIDENCE THAT A BUILD PRODUCED SOMETHING, and it is constructed from a read-back rather than from the builder's own report. This carrier is why 'build succeeded' cannot be reported without retrievable bytes: the available arm of the availability axis takes a StoredArtifact and there is no other way to inhabit it, so an exit-zero cargo invocation whose output nobody could retrieve has no arm to land in.
//
// WHY TWO DIGESTS, WHICH IS NOT A DUAL REPRESENTATION. blob_oid is an ADDRESS: it is how the artifact store is asked for these bytes, and it is Git's identity over a blob header plus content. sha256 is an INDEPENDENT VERIFICATION of the content alone, computed without consulting the store. The preimages genuinely differ, so neither is derivable from the other, and that non-derivability is the point -- a consumer that fetched by oid and then recomputed the oid would be re-reading the store's own answer, which establishes nothing (the read-back independence criterion). Recomputing sha256 over the fetched bytes is a check the store cannot satisfy by agreeing with itself.
//
// subject_digest travels with the artifact as an INDEX, so a candidate can be found. It is not what decides whether the candidate is the right one; see the record below.
type StoredArtifact {
  subject_digest: std.content_hash.ContentHash
  blob_oid: extdeps.git.object_store.GitObjectId
  sha256: std.content_hash.Sha256Digest
  bytes: std.measure.ByteSize
}

// THE FULL TYPED REQUEST, STORED BESIDE THE BYTES, and the reason it exists is that a digest is an index rather than a proof. A structural hash admits collisions; if reuse were decided by comparing digests, two different subjects that happened to collide would trade artifacts, and the failure would be silent, rare, and unreproducible -- a caller would receive a binary built for something else with every visible signal agreeing.
//
// Storing the subject makes the decision procedure lookup, retrieve, then COMPARE: the digest narrows the store to a candidate, and exact structural equality over the whole subject decides. A collision then costs a failed comparison and a redundant build, which is an efficiency loss rather than a correctness one. That is the whole point of the split -- the expensive-but-exact check runs once per candidate, not once per stored artifact, so exactness costs nothing at scale.
type StoredArtifactRecord {
  subject: gunbc.devboot.subject.BuildSubject
  artifact: StoredArtifact
}

type BuildFailureCause
  = CompilationFailed { detail: String }
  | BuildExceededBudget { detail: String }

// REFUSALS THAT ARE NOT THE BUILD'S FAULT, kept apart from BuildFailureCause because the two have different remedies and different meanings for a retry. A compilation failure is a fact about the subject: rebuilding it changes nothing until the source changes. An infrastructure refusal is a fact about this host at this moment, and the same subject may well succeed once the deficit is fixed. Fusing them would make 'retry is pointless' unanswerable.
//
// Every arm is a refusal, never a widen: a missing store does not silently become a temp directory, an unreachable transport does not become a local rebuild, and a lease that cannot be taken does not become a second concurrent producer.
type InfrastructureRefusalCause
  = ArtifactStoreRootAbsent { path: String }
  | ArtifactStoreRootUnwritable { path: String }
  | ProducerLeaseUnavailable { detail: String }
  | SubjectNotFetchable { detail: String }

// TWO AXES ON TWO TIMELINES, split because fusing them made a true state unsayable. Execution is HISTORY: it happened once, it is finished, and nothing that occurs later can change what the compiler did. Availability is a fact about NOW: bytes that existed yesterday can be pruned, corrupted, or made unreadable this morning without anyone rebuilding anything.
//
// The earlier revision carried a single sum in which a record was either produced or unavailable, so 'produced yesterday, bytes missing today' could only be expressed by rewriting the past -- overwriting a genuine success with an unavailability arm, destroying the record that the build had ever run. A status query then could not distinguish a subject that was never built from one whose artifact was pruned, though those need opposite remedies: the first must build, the second must re-fetch or rebuild and knows the source is good.
//
// Carried as a product, both stay true simultaneously and independently: execution Produced, artifact Missing. Neither axis has to lie for the other to be accurate.
type BuildExecutionOutcome
  = ExecutionProduced
  | ExecutionFailed { cause: BuildFailureCause }
  | ExecutionRefused { cause: InfrastructureRefusalCause }
  | ExecutionInterrupted { detail: String }

// WHETHER THE BYTES CAN BE HAD RIGHT NOW, established by observation rather than inferred from history. The available arm carries the artifact itself, so there is no way to report availability without holding the read-back that established it -- the contract law of this vertical, made structural rather than checked.
//
// ArtifactCorrupt is deliberately distinct from ArtifactMissing even though both mean the caller gets nothing. Missing bytes are an absence and may be a routine prune; bytes present that do not match their promised digest are an INTEGRITY failure, and serving them would be the worst outcome this service can produce. Fusing the two would let a corruption be retried as though it were a cache miss, quietly, forever.
type ArtifactAvailability
  = ArtifactAvailable { artifact: StoredArtifact }
  | ArtifactMissing
  | ArtifactCorrupt { expected: std.content_hash.Sha256Digest, observed: std.content_hash.Sha256Digest }
  | ArtifactUnreadable { detail: String }

// What a status query answers: the two independent axes together, plus the request's own identity. A caller reads execution to learn whether the build ever ran and how it went, and availability to learn whether it can fetch bytes this moment. Neither answer is derived from the other.
type DevbootWorkStatus {
  work_id: DevbootWorkId
  subject: gunbc.devboot.subject.BuildSubject
  execution: BuildExecutionOutcome
  availability: ArtifactAvailability
}

// THE SINGLE AUTHORITY FOR 'MAY A CALLER BELIEVE IT HOLDS AN ARTIFACT', and it reads the availability axis ALONE -- deliberately, not by oversight. Execution is history and history cannot make bytes fetchable; only an observation of the store can. So a past success contributes nothing here, which is exactly the hard stop this vertical was given: there is no arm in which a build is reportable as succeeded without retrievable bytes.
//
// The match is total, so a new availability arm cannot inherit a true answer by omission.
fn availability_permits_retrieval(availability: ArtifactAvailability) -> Bool {
  match availability {
    ArtifactAvailable { artifact } => true
    ArtifactMissing => false
    ArtifactCorrupt { expected, observed } => false
    ArtifactUnreadable { detail } => false
  }
}

fn status_reports_retrievable_artifact(status: DevbootWorkStatus) -> Bool {
  availability_permits_retrieval(availability: status.availability)
}

fn execution_is_settled(execution: BuildExecutionOutcome) -> Bool {
  match execution {
    ExecutionProduced => true
    ExecutionFailed { cause } => true
    ExecutionRefused { cause } => true
    ExecutionInterrupted { detail } => false
  }
}

// THE REQUESTED-SUBJECT WALL. A retrieval names a subject; a stored record carries the subject its bytes were built for; serving one for the other is the false-share this whole identity scheme exists to prevent.
//
// IT COMPARES SUBJECTS, NOT DIGESTS, and that is the correction the earlier revision needed. Deciding by digest would make a hash collision a correctness failure -- two unrelated requests trading binaries with every signal agreeing. Deciding by exact structural equality makes a collision merely a candidate that fails to match, which is refused and rebuilt. The digest still does its job, one step earlier and with no authority over the answer: it finds the candidate.
type SubjectMatch
  = SubjectMatches
  | SubjectDiffers

fn record_matches_request(record: StoredArtifactRecord, requested: gunbc.devboot.subject.BuildSubject) -> SubjectMatch {
  if build_subject_equal(left: record.subject, right: requested) {
    SubjectMatches
  } else {
    SubjectDiffers
  }
}

// THE WHOLE REUSE PATH AS ONE TOTAL DECISION, so that no call site can assemble the steps in a different order or skip one. The ordering is the contract the ruling fixed: look up by digest, retrieve the full typed request, compare exactly, and only then reuse.
//
// Every way of not reusing is its own arm rather than a shared false, because their remedies differ completely. No candidate means build. A subject mismatch means the digest found somebody else's artifact and this request must build, and it is worth counting separately because a nonzero rate is evidence of a collision or of a store-keying defect rather than of normal traffic. Unavailable bytes mean the record is right and the store failed, which is neither a build decision nor a match failure.
//
// There is no arm that reuses on a partial answer. Reuse requires a candidate AND an exact subject match AND observed available bytes, so a caller cannot be handed an artifact on the strength of two out of three.
type ReuseDecision
  = ReuseGranted { artifact: StoredArtifact }
  | ReuseNoCandidate
  | ReuseSubjectMismatch { candidate_digest: std.content_hash.ContentHash, requested_digest: std.content_hash.ContentHash }
  | ReuseUnavailable { availability: ArtifactAvailability }

// ONE FOLD, TWO WAYS OF ESTABLISHING THE MATCH, because the callers genuinely differ in what they hold and must not differ in what they DECIDE. A caller with a reconstructed record compares subject values directly. The live producer holds a rendering read out of the store, and compares that against the rendering of the request -- injective, so equal renderings mean equal subjects -- because a value cannot be reconstructed from storage without a parser that could disagree with the writer.
//
// Both arrive at a SubjectMatch and hand it to the same fold, so the ordering the ruling fixed -- candidate, then exact match, then observed bytes -- has exactly one implementation. An earlier revision let the live path reuse on ref presence alone, which is how a model and its realization end up disagreeing about the law the model exists to state: the witnesses exercised this fold while the code that actually served callers never called it.
fn reuse_decision_from_match(
  candidate_digest: std.content_hash.ContentHash?,
  requested: gunbc.devboot.subject.BuildSubject,
  subject_match: SubjectMatch,
  availability: ArtifactAvailability,
) -> ReuseDecision {
  match candidate_digest {
    Absent => ReuseNoCandidate
    Present { value: digest } =>
      match subject_match {
        SubjectDiffers =>
          ReuseSubjectMismatch {
            candidate_digest: digest,
            requested_digest: build_subject_digest(subject: requested),
          }
        SubjectMatches =>
          match availability {
            ArtifactAvailable { artifact } => ReuseGranted { artifact: artifact }
            ArtifactMissing => ReuseUnavailable { availability: availability }
            ArtifactCorrupt { expected, observed } => ReuseUnavailable { availability: availability }
            ArtifactUnreadable { detail } => ReuseUnavailable { availability: availability }
          }
      }
  }
}

fn reuse_decision(
  candidate: StoredArtifactRecord?,
  requested: gunbc.devboot.subject.BuildSubject,
  availability: ArtifactAvailability,
) -> ReuseDecision {
  match candidate {
    Absent =>
      reuse_decision_from_match(
        candidate_digest: none,
        requested: requested,
        subject_match: SubjectDiffers,
        availability: availability,
      )
    Present { value: record } =>
      reuse_decision_from_match(
        candidate_digest: Present { value: record.artifact.subject_digest },
        requested: requested,
        subject_match: record_matches_request(record: record, requested: requested),
        availability: availability,
      )
  }
}

fn reuse_grants_artifact(decision: ReuseDecision) -> Bool {
  match decision {
    ReuseGranted { artifact } => true
    ReuseNoCandidate => false
    ReuseSubjectMismatch { candidate_digest, requested_digest } => false
    ReuseUnavailable { availability } => false
  }
}
