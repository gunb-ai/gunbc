module gunbc.devboot.lease




// WHY THERE IS NO DATABASE HERE, and why that is a correction rather than a shortcut. The dispatch that opened this vertical named durable state as SQLite plus a content-addressed artifact directory. Re-observing before building found no SQLite store realization anywhere in the tree -- extdeps.sql.migration models schema change and extdeps.formats.sql models the language, and neither is a store -- while the artifact store this service already needs is a bare Git repository, whose object database IS the content-addressed directory and whose refs ARE durable named state.
//
// So the store was already present, and adding a database beside it would have been a second durable representation of one fact set: which subjects have artifacts, and who is producing what. That is the parallel representation this program's third law forbids, and it would have been introduced for no capability that Git refs lack.
//
// THE STRONGER REASON IS THE LEASE. A producer lease needs one thing that is hard to get right and easy to fake: an atomic compare-and-swap, so that exactly one requester becomes the producer and the losers learn they lost rather than quietly becoming second producers. Git already provides it as a primitive -- update-ref with an exact expected-old OID -- and this repository already models the decision, with a named arm for losing the race. Implementing a lock over a database would have been a second, weaker realization of a guarantee the substrate already carries structurally.
//
// The consequence for the roots the previous capsule admitted: everything durable lives in the artifact store, so the separate state root has no remaining consumer. It is retired below rather than left standing as an unused path.
// The previous capsule admitted two host-layout roots because the dispatch named two durable stores. One of them was the database's home. With the database dissolved into the artifact store's refs and object database, the state root would be an admitted path that nothing ever writes -- a directory the deploy creates, the teardown removes, and no code consults.
//
// An unused admitted root is not harmless. It reads as though state lives there, so the next author looking for the work records would look in the wrong place, and a reconciliation would keep converging an empty directory forever. It is retired at the same commit that removes its reason to exist, which is the only honest moment to do it: the predecessor is demoted by the capsule that supersedes it, never left beside it.
data lease_ref_namespace: String = "refs/devboot/lease/"

data artifact_ref_namespace: String = "refs/devboot/artifact/"

// ALL FOUR NAMESPACES LIVE HERE, not two here and two at the call site. A ref namespace is one concept -- where this service keeps a kind of fact -- and splitting the rows across modules meant the next kind of fact got spelled wherever it was first needed. That is exactly what happened: the digest ref was introduced as a literal inside the producer while the lease and artifact rows sat here, so the corpus briefly had two authorities for one naming scheme and no way to notice.
//
// Keeping them together is what makes a rename a single edit and a collision visible by reading four adjacent lines.

data subject_ref_namespace: String = "refs/devboot/subject/"

data digest_ref_namespace: String = "refs/devboot/digest/"

// THE REMOTE EXCHANGE ADDS TWO MORE, and they belong beside the other four for the reason the paragraph above gives rather than beside the transport that first needed them. A request ref carries a caller's snapshot INTO the store; a produced ref carries one producer's answer back out. They are the only two namespaces a caller on another host ever names, and a caller never sees either -- the operation spells them, the outcome does not.
data request_ref_namespace: String = "refs/devboot/request/"

data produced_ref_namespace: String = "refs/devboot/produced/"

// A ref name is a PATH, and Git rejects several characters that the natural wire form of a content hash contains -- the sha256 wire form carries a colon, which is illegal in a ref name. So the ref token is derived here rather than reusing serialize_content_hash, and the derivation keeps the one property the wire form has that matters: the FAMILY stays visible.
//
// Dropping the family and keeping only the hex would let two hashes from different families produce the same ref name whenever their hex happened to coincide, which is exactly the cross-family collapse the content-hash family grounding exists to prevent. The token separates family from digest with a hyphen, so the ref namespace inherits the same cross-family distinctness the type carries.
fn content_hash_ref_token(hash: std.content_hash.ContentHash) -> String {
  match hash {
    std.content_hash.Fnv1a64(s) => join(["fnv1a64-", s.digest as String], "")
    std.content_hash.Sha256Hash(d) => join(["sha256-", d.hex as String], "")
    std.content_hash.Sha1Hash(d) => join(["sha1-", d.hex as String], "")
    std.content_hash.Sha512Hash(d) => join(["sha512-", d.hex as String], "")
  }
}

fn lease_ref_for_subject(subject: gunbc.devboot.subject.BuildSubject) -> extdeps.git.object_store.GitRefName {
  join([lease_ref_namespace, content_hash_ref_token(hash: gunbc.devboot.subject.build_subject_digest(subject: subject))], "") as std.types.NonEmptyStr as extdeps.git.object_store.GitRefName
}

fn artifact_ref_for_subject(subject: gunbc.devboot.subject.BuildSubject) -> extdeps.git.object_store.GitRefName {
  join([artifact_ref_namespace, content_hash_ref_token(hash: gunbc.devboot.subject.build_subject_digest(subject: subject))], "") as std.types.NonEmptyStr as extdeps.git.object_store.GitRefName
}

// THE ONLY THREE THINGS A REQUESTER MAY LEARN, and the middle one is why this type exists at all. It won the lease and must build; it lost to a producer that already holds it and must attach to that producer; or the attempt refused for a reason that is neither, and it must not build.
//
// THERE IS NO ARM FOR PROCEEDING ANYWAY. The failure arms do not widen into LeaseAcquired, so a requester that could not establish sole producership has no representable way to become a second producer. That is the exactly-one-producer property held by construction rather than by a check, because the alternative -- observing the lease and then deciding -- leaves the bad state writable in the gap between the two.
//
// LeaseLostToProducer is distinguished from every refusal because its remedy differs completely. Losing the race is a SUCCESS of the protocol: the subject is being produced, and the caller's correct move is to attach and wait. A refusal is a deficit, and the caller's correct move is to surface it. Fusing them would make a healthy race look like a failure and would make every attach path indistinguishable from a broken store.
type LeaseRefusalCause
  = LeaseStoreInvalid { detail: String }
  | LeaseRefNameAmbiguous { name: extdeps.git.object_store.GitRefName }
  | LeaseRefSymbolicCycle { name: extdeps.git.object_store.GitRefName }
  | LeaseObjectFormatMismatch { oid: extdeps.git.object_store.GitObjectId }
  | LeaseTargetUnavailable { oid: extdeps.git.object_store.GitObjectId }
  | LeaseTargetKindRefused { oid: extdeps.git.object_store.GitObjectId }
  | LeaseCreateNotModeled { name: extdeps.git.object_store.GitRefName }

type LeaseOutcome
  = LeaseAcquired { name: extdeps.git.object_store.GitRefName, holder: extdeps.git.object_store.GitObjectId }
  | LeaseLostToProducer { name: extdeps.git.object_store.GitRefName, holder: extdeps.git.object_store.GitObjectId }
  | LeaseRefused { cause: LeaseRefusalCause }

// THE ONE HONEST GAP, named rather than papered over. Acquiring a lease that nobody holds is a CREATE -- in Git, update-ref with an empty expected-old, which refuses if the ref already exists -- and that is a different transition from advancing a ref whose current value is known. The modeled transition in the upstream object store proves the advance case only; a ref that is absent returns its own arm and there is no create-only decision to consume.
//
// So the absent case refuses here with LeaseCreateNotModeled instead of being treated as an acquisition. Treating it as one would be the fabrication this repository forbids most sharply: the requester would be told it holds sole producership on the strength of a transition that was never modeled, and two requesters arriving together would both be told it, which is precisely the invariant the lease exists to hold. A refusal costs a first build; a fabricated acquisition costs the guarantee.
//
// dissolve-on: the upstream object store gains an exact create-only transition (expected-old absent, refusing when the ref exists). At that point this arm is deleted and the absent case becomes a real LeaseAcquired -- the arm is not permanent, and naming its trigger is what separates a staged gap from an accepted one.
fn lease_outcome_from_ref_transition(outcome: extdeps.git.object_store.GitUpdateRefOutcome) -> LeaseOutcome {
  match outcome {
    extdeps.git.object_store.GitRefTransitionModeled { repository, transition } =>
      LeaseAcquired { name: transition.advanced_name, holder: transition.new }
    extdeps.git.object_store.GitRefAdvanceStale { repository, name, expected_old, observed } =>
      LeaseLostToProducer { name: name, holder: observed }
    extdeps.git.object_store.GitRefAdvanceMissing { repository, name } =>
      LeaseRefused { cause: LeaseCreateNotModeled { name: name } }
    extdeps.git.object_store.GitRefAdvanceRepositoryInvalid { repository, cause } =>
      LeaseRefused { cause: LeaseStoreInvalid { detail: "artifact store did not decode as a repository" } }
    extdeps.git.object_store.GitRefAdvanceDuplicate { repository, name, count } =>
      LeaseRefused { cause: LeaseRefNameAmbiguous { name: name } }
    extdeps.git.object_store.GitRefAdvanceSymbolicCycle { repository, name, chain } =>
      LeaseRefused { cause: LeaseRefSymbolicCycle { name: name } }
    extdeps.git.object_store.GitRefAdvanceFormatMismatch { repository, repository_format, oid } =>
      LeaseRefused { cause: LeaseObjectFormatMismatch { oid: oid } }
    extdeps.git.object_store.GitRefAdvanceTargetUnavailable { repository, oid, lookup } =>
      LeaseRefused { cause: LeaseTargetUnavailable { oid: oid } }
    extdeps.git.object_store.GitRefAdvanceTargetKindRefused { repository, name, oid, object_type } =>
      LeaseRefused { cause: LeaseTargetKindRefused { oid: oid } }
  }
}

// The lease decision, composed from the modeled transition rather than from an observation followed by a choice. The caller supplies the value it currently believes the lease holds; winning means that belief was correct at the moment of the swap, and losing means it was not. Nothing between the read and the write can change the answer, because there is nothing between them.
//
// This is the pure decision only. It mints no execution receipt, exactly as the modeled transition it consumes does not: a real producer must perform the update through a transport and read the result back. Promoting this outcome to a claim that the lease is held on a live host would be the specification-without-execution failure -- the model would be green while no process had ever taken a lease.
fn acquire_producer_lease(
  store: extdeps.git.object_store.GitRepositoryState,
  subject: gunbc.devboot.subject.BuildSubject,
  expected_holder: extdeps.git.object_store.GitObjectId,
  claim: extdeps.git.object_store.GitObjectId,
) -> LeaseOutcome {
  lease_outcome_from_ref_transition(
    outcome: extdeps.git.object_store.git_model_update_ref_exact(
      repo: store,
      name: lease_ref_for_subject(subject: subject),
      new_oid: claim,
      expected_old: expected_holder,
    ),
  )
}

fn lease_permits_building(outcome: LeaseOutcome) -> Bool {
  match outcome {
    LeaseAcquired { name, holder } => true
    LeaseLostToProducer { name, holder } => false
    LeaseRefused { cause } => false
  }
}

fn lease_directs_attach(outcome: LeaseOutcome) -> Bool {
  match outcome {
    LeaseAcquired { name, holder } => false
    LeaseLostToProducer { name, holder } => true
    LeaseRefused { cause } => false
  }
}
