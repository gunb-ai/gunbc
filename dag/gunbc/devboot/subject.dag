module gunbc.devboot.subject

import std.types { String, Bool, List, NonEmptyStr }
import std.content_hash {
  ContentHash,
  Fnv1a64Structural,
  content_hash_atom,
  content_hash_combine_structural,
  content_hash_tagged,
  content_hash_tagged_structural,
}

import extdeps.git.object_store { GitObjectId, git_object_id_wire_hex }
import extdeps.toolchain.types {
  TargetTriple,
  ToolchainRequirement,
  Architecture,
  X86_64,
  X86,
  Aarch64,
  Arm,
  Armv7,
  Mips,
  Mipsel,
  Mips64,
  Mips64el,
  Riscv64,
  Wasm32,
  TripleVendor,
  UnknownVendor,
  Pc,
  Apple,
  W64,
  Os,
  Linux,
  Macos,
  Windows,
  Freebsd,
  Android,
  Ios,
  Wasi,
  AbiEnv,
  NoneAbi,
  Gnu,
  GnuEabi,
  GnuEabihf,
  Musl,
  Msvc,
  AndroidAbi,
  Eabi,
  Eabihf,
}
import extdeps.cargo { CargoTarget, Lib, Bin, CargoTest, Example, Bench }

data build_subject_note: String = "WHAT A BUILD IS OF, carried so that two requests naming the same thing are the same request and two requests naming different things never collide. Every field is a fact about the COMPUTATION; nothing here can be a fact about the requester.\\n\\nTHE TREE OID IS THE SOURCE AXIS AND IT IS NOT A COMMIT. A commit names a tree plus history, authorship and time, so two rebases of identical content are different commits and would build twice; the tree alone is the content, so a rebase, a merge result and CI's synthetic merge tree all dedupe for free when their content agrees. It is a GitObjectId rather than text because extdeps.git.object_store already owns Git's identity scheme, including the family discriminant that keeps a SHA-1 and a SHA-256 id from comparing equal on hex alone.\\n\\nWHAT MAY NEVER ENTER THIS KEY, stated as a rule rather than left to reviewer memory: branch name, session name, worktree path, ambient working directory, requester identity, wall-clock time, and a commit sha standing alone. Each of those makes two identical computations look different, which does not merely lose the dedup this service exists to provide -- it makes the store grow without bound while every entry claims to be distinct."

data build_product_note: String = "WHICH ARTIFACT IS BEING ASKED FOR, without which the rest of the subject does not identify a build at all. One tree at one toolchain for one target and profile can produce the CLI, a different binary, the library, or a test harness, and those are different bytes. A key blind to this axis would let a request for one binary be satisfied by another that happened to be built from the same source at the same settings -- the false-share this service exists to prevent, arriving through the one axis nobody thought to name.\\n\\nIT IS CARGO'S OWN TARGET NOTION, NOT A MINTED PRODUCT ENUM. Cargo already decides what a package can produce, and CargoTarget carries exactly that closed vocabulary -- library, binary, test, example, benchmark, each with its name where a name distinguishes it. Coining a devboot-local list of products would be a second authority over a concept upstream already owns, and it would have to be edited every time a new binary appears; the cargo target does not, because the name is a field rather than a variant."

type BuildProduct {
  package: NonEmptyStr
  target: CargoTarget
}

data build_environment_note: String = "THE SETTINGS OUTSIDE THE SOURCE THAT STILL CHANGE THE BYTES. Source, toolchain, target and profile do not determine an artifact on their own: a codegen flag, a different linker, a substituted sysroot, or a cargo configuration entry each change what comes out while every other axis stays identical. A key blind to them would hand a requester an artifact built under settings it did not ask for, and the divergence would be invisible precisely because every named axis agreed.\\n\\nRUSTFLAG ORDER IS SIGNIFICANT AND THAT IS CORRECTNESS, NOT CAUTION. Repeated codegen options resolve last-one-wins in the compiler, so two orderings of the same flags are genuinely two different builds. This is unlike the feature list, where order is carried conservatively because no canonical ordering is computable yet; here, carrying order is the faithful model and canonicalizing would be the error.\\n\\nWHAT THIS CARRIER IS NOT: a claim of hermeticity. It is one exact environment identity, which is the alternative the ruling permits -- the requester states the environment and the digest binds it. Facts genuinely outside it, such as a build script reading the ambient host, are not silently absorbed here; they remain unmodeled and are named in the residue rather than pretended into this record."

type CargoConfigEntry {
  key: NonEmptyStr
  value: String
}

type BuildEnvironmentSpec {
  rustflags: List<NonEmptyStr>
  linker: NonEmptyStr?
  sysroot: NonEmptyStr?
  cargo_config: List<CargoConfigEntry>
}

type BuildSubject {
  tree_oid: GitObjectId
  product: BuildProduct
  toolchain: ToolchainRequirement
  target: TargetTriple
  profile: NonEmptyStr
  features: List<NonEmptyStr>
  environment: BuildEnvironmentSpec
}

data build_subject_admission_note: String = "ADMISSION IS THE ONLY DOOR, and it exists because the fields it fills are non-empty by type while the request that arrives is not. The earlier revision cast raw strings into NonEmptyStr at the digest, which is the fabrication this repository forbids: a cast asserts the property rather than establishing it, so an empty feature name would have travelled into the identity as though it had been checked.\\n\\nNow every string that must be non-empty is admitted here, once, with its own refusal arm, and the subject type carries the property structurally. A caller holding a BuildSubject holds proof the check ran, because there is no other constructor."

data build_subject_feature_order_note: String = "FEATURE ORDER IS PART OF THE SUBJECT, and that is the deliberately conservative choice rather than an oversight. Canonically ordering the list would need a total string comparator, and no ordering primitive over String exists in std today -- so the options were to carry order as significant, or to fabricate a canonical form the substrate cannot yet compute.\\n\\nThe two failure directions are not symmetric, which is what decides it. Treating a reordering as a DIFFERENT subject costs one redundant build: the second request builds instead of dedup'ing, and both artifacts are correct for their request. Treating two genuinely different feature sets as the SAME subject would hand a requester an artifact built from features it did not ask for -- a false share, and the exact class the requested-subject-equals-produced-subject wall exists to make unwritable. A conservative over-approximation computed AS the answer is legitimate (DESIGN section 5 distinguishes it from an absorbing fallback, which widens on a FAILURE state); this one is computed from structure, is loud in the receipt, and never answers wrongly.\\n\\nDUPLICATES ARE STILL REFUSED, because duplicate detection needs only equality, which does exist. A repeated feature is an authoring error whose two spellings would otherwise hash differently while naming one build.\\n\\nDissolve-on: a total String ordering in std. At that point features carry canonically sorted with a constructor that refuses unsorted input, reorderings dedupe, and this note and the order-sensitivity both retire."

type BuildSubjectRefusalCause
  = FeatureNameEmpty
  | DuplicateFeature { name: String }
  | ProfileNameEmpty
  | PackageNameEmpty
  | RustflagEmpty
  | CargoConfigKeyEmpty
  | LinkerEmpty
  | SysrootEmpty

type BuildSubjectAdmission
  = SubjectAdmitted { subject: BuildSubject }
  | SubjectRefused { cause: BuildSubjectRefusalCause }

fn feature_in_list(name: String, names: List<String>) -> Bool {
  fold(names, init: false, f: (acc, candidate) => acc || candidate == name)
}

type FeatureScan {
  seen: List<String>
  refusal: BuildSubjectRefusalCause?
}

fn scan_feature(acc: FeatureScan, name: String) -> FeatureScan {
  match acc.refusal {
    Present { value: _ } => acc
    Absent =>
      if name == "" {
        FeatureScan { seen: acc.seen, refusal: Present { value: FeatureNameEmpty } }
      } else {
        if feature_in_list(name: name, names: acc.seen) {
          FeatureScan {
            seen: acc.seen,
            refusal: Present { value: DuplicateFeature { name: name } },
          }
        } else {
          FeatureScan { seen: concat(acc.seen, [name]), refusal: acc.refusal }
        }
      }
  }
}

type StringListScan {
  refusal: BuildSubjectRefusalCause?
}

fn scan_nonempty(acc: StringListScan, value: String, cause: BuildSubjectRefusalCause) -> StringListScan {
  match acc.refusal {
    Present { value: _ } => acc
    Absent =>
      if value == "" {
        StringListScan { refusal: Present { value: cause } }
      } else {
        acc
      }
  }
}

fn scan_rustflags(flags: List<String>) -> BuildSubjectRefusalCause? {
  fold(
    flags,
    init: StringListScan { refusal: none },
    f: (acc, flag) => scan_nonempty(acc: acc, value: flag, cause: RustflagEmpty),
  ).refusal
}

type RawCargoConfigEntry {
  key: String
  value: String
}

fn scan_cargo_config(entries: List<RawCargoConfigEntry>) -> BuildSubjectRefusalCause? {
  fold(
    entries,
    init: StringListScan { refusal: none },
    f: (acc, entry) => scan_nonempty(acc: acc, value: entry.key, cause: CargoConfigKeyEmpty),
  ).refusal
}

fn admitted_cargo_config(entries: List<RawCargoConfigEntry>) -> List<CargoConfigEntry> {
  entries |> map(entry => CargoConfigEntry { key: entry.key as NonEmptyStr, value: entry.value })
}

fn optional_nonempty_refusal(value: String?, cause: BuildSubjectRefusalCause) -> BuildSubjectRefusalCause? {
  match value {
    Absent => none
    Present { value: text } =>
      if text == "" {
        Present { value: cause }
      } else {
        none
      }
  }
}

fn admitted_optional_nonempty(value: String?) -> NonEmptyStr? {
  match value {
    Absent => none
    Present { value: text } => Present { value: text as NonEmptyStr }
  }
}

fn first_refusal(left: BuildSubjectRefusalCause?, right: BuildSubjectRefusalCause?) -> BuildSubjectRefusalCause? {
  match left {
    Present { value: cause } => Present { value: cause }
    Absent => right
  }
}

fn environment_refusal(
  rustflags: List<String>,
  linker: String?,
  sysroot: String?,
  cargo_config: List<RawCargoConfigEntry>,
) -> BuildSubjectRefusalCause? {
  first_refusal(
    left: scan_rustflags(flags: rustflags),
    right: first_refusal(
      left: optional_nonempty_refusal(value: linker, cause: LinkerEmpty),
      right: first_refusal(
        left: optional_nonempty_refusal(value: sysroot, cause: SysrootEmpty),
        right: scan_cargo_config(entries: cargo_config),
      ),
    ),
  )
}

fn scalar_refusal(package: String, profile: String) -> BuildSubjectRefusalCause? {
  if package == "" {
    Present { value: PackageNameEmpty }
  } else {
    if profile == "" {
      Present { value: ProfileNameEmpty }
    } else {
      none
    }
  }
}

fn admit_build_subject(
  tree_oid: GitObjectId,
  package: String,
  cargo_target: CargoTarget,
  toolchain: ToolchainRequirement,
  target: TargetTriple,
  profile: String,
  features: List<String>,
  rustflags: List<String>,
  linker: String?,
  sysroot: String?,
  cargo_config: List<RawCargoConfigEntry>,
) -> BuildSubjectAdmission {
  match first_refusal(
    left: scalar_refusal(package: package, profile: profile),
    right: first_refusal(
      left: fold(
        features,
        init: FeatureScan { seen: [], refusal: none },
        f: (acc, name) => scan_feature(acc: acc, name: name),
      ).refusal,
      right: environment_refusal(
        rustflags: rustflags,
        linker: linker,
        sysroot: sysroot,
        cargo_config: cargo_config,
      ),
    ),
  ) {
    Present { value: cause } => SubjectRefused { cause: cause }
    Absent =>
      SubjectAdmitted {
        subject: BuildSubject {
          tree_oid: tree_oid,
          product: BuildProduct {
            package: package as NonEmptyStr,
            target: cargo_target,
          },
          toolchain: toolchain,
          target: target,
          profile: profile as NonEmptyStr,
          features: admitted_nonempty_names(values: features),
          environment: BuildEnvironmentSpec {
            rustflags: admitted_nonempty_names(values: rustflags),
            linker: admitted_optional_nonempty(value: linker),
            sysroot: admitted_optional_nonempty(value: sysroot),
            cargo_config: admitted_cargo_config(entries: cargo_config),
          },
        },
      }
  }
}

data admitted_nonempty_names_note: String = "The projection that fills the non-empty-typed list fields, and it is sound only because the scan above already refused on every empty member. It runs strictly after that refusal, on the admitted branch, so the cast rests on an executed check rather than on an assertion -- which is the whole difference between admission and fabrication."

fn admitted_nonempty_names(values: List<String>) -> List<NonEmptyStr> {
  values |> map(value => value as NonEmptyStr)
}

data canonical_identity_tag_note: String = "THESE TAGS DEFINE STORED IDENTITY, WHICH IS WHY THEY ARE NOT THE DIAGNOSTIC NAMES. The earlier revision folded the toolchain module's *_diagnostic_name functions into this digest, and each of those carries a header saying it is for diagnostics only and never a wire label. That restriction is not decoration: a diagnostic spelling exists to be edited when a message reads badly, and an identity spelling must never be edited casually, because every artifact stored under the old spelling is orphaned the moment it changes. Borrowing one for the other fuses two lifetimes that must stay separate.\\n\\nSo the digest owns its own total tag per variant. The tags are deliberately opaque and versioned by this module: they carry no meaning to a reader, they are never displayed, and their only contract is that each closed variant maps to exactly one distinct tag, forever. Renaming a variant in the upstream type now changes nothing here -- which is the property the finding asked for, because a rename is a spelling change and must not orphan a store.\\n\\nWHY A TAG RATHER THAN A POSITION. An ordinal would be smaller, but adding a variant in the middle of a coproduct silently renumbers everything after it, so identity would shift under an edit that looks additive. A tag per variant is stable under insertion by construction."

fn architecture_identity_tag(arch: Architecture) -> NonEmptyStr {
  match arch {
    X86_64 => "arch.v1.x86_64" as NonEmptyStr
    X86 => "arch.v1.x86" as NonEmptyStr
    Aarch64 => "arch.v1.aarch64" as NonEmptyStr
    Arm => "arch.v1.arm" as NonEmptyStr
    Armv7 => "arch.v1.armv7" as NonEmptyStr
    Mips => "arch.v1.mips" as NonEmptyStr
    Mipsel => "arch.v1.mipsel" as NonEmptyStr
    Mips64 => "arch.v1.mips64" as NonEmptyStr
    Mips64el => "arch.v1.mips64el" as NonEmptyStr
    Riscv64 => "arch.v1.riscv64" as NonEmptyStr
    Wasm32 => "arch.v1.wasm32" as NonEmptyStr
  }
}

fn triple_vendor_identity_tag(vendor: TripleVendor) -> NonEmptyStr {
  match vendor {
    UnknownVendor => "vendor.v1.unknown" as NonEmptyStr
    Pc => "vendor.v1.pc" as NonEmptyStr
    Apple => "vendor.v1.apple" as NonEmptyStr
    W64 => "vendor.v1.w64" as NonEmptyStr
  }
}

fn os_identity_tag(os: Os) -> NonEmptyStr {
  match os {
    Linux => "os.v1.linux" as NonEmptyStr
    Macos => "os.v1.macos" as NonEmptyStr
    Windows => "os.v1.windows" as NonEmptyStr
    Freebsd => "os.v1.freebsd" as NonEmptyStr
    Android => "os.v1.android" as NonEmptyStr
    Ios => "os.v1.ios" as NonEmptyStr
    Wasi => "os.v1.wasi" as NonEmptyStr
  }
}

fn abi_env_identity_tag(env: AbiEnv) -> NonEmptyStr {
  match env {
    NoneAbi => "abi.v1.none" as NonEmptyStr
    Gnu => "abi.v1.gnu" as NonEmptyStr
    GnuEabi => "abi.v1.gnueabi" as NonEmptyStr
    GnuEabihf => "abi.v1.gnueabihf" as NonEmptyStr
    Musl => "abi.v1.musl" as NonEmptyStr
    Msvc => "abi.v1.msvc" as NonEmptyStr
    AndroidAbi => "abi.v1.android" as NonEmptyStr
    Eabi => "abi.v1.eabi" as NonEmptyStr
    Eabihf => "abi.v1.eabihf" as NonEmptyStr
  }
}

data build_subject_digest_note: String = "THE SUBJECT DIGEST IS DERIVED FROM STRUCTURE, never from a rendered triple. Rendering would require a canonical spelling of the target, and every upstream spells targets differently; folding one tag per variant needs no spelling to be canonical, only to be total and distinct per variant, which a closed coproduct gives for free.\\n\\nTHE ABI AXIS IS LOAD-BEARING RATHER THAN DECORATIVE. Gnu and Musl differ in exactly the property that decides whether a produced binary runs on a given host, so a digest blind to it would let a musl artifact satisfy a gnu request. An absent env is hashed as its own atom rather than skipped, because skipping would make an unspecified env collide with whatever env sorts first.\\n\\nWHAT THIS DIGEST IS FOR, stated because the previous revision got it wrong. It is an INDEX -- a short key under which a subject's artifact can be found. It is not proof that two subjects are the same, and no reuse decision may rest on it alone, because a structural hash admits collisions and a collision would hand a requester somebody else's bytes. The equality authority is exact structural comparison of the retrieved subject; see the retrieval path in gunbc.devboot.outcome."

fn cargo_target_digest(target: CargoTarget) -> Fnv1a64Structural {
  match target {
    Lib => content_hash_atom(value: "cargo_target.v1.lib" as NonEmptyStr)
    Bin { name } => content_hash_combine_structural(
      left: content_hash_atom(value: "cargo_target.v1.bin" as NonEmptyStr),
      right: content_hash_atom(value: name as NonEmptyStr),
    )
    CargoTest { name } => content_hash_combine_structural(
      left: content_hash_atom(value: "cargo_target.v1.test" as NonEmptyStr),
      right: content_hash_atom(value: name as NonEmptyStr),
    )
    Example { name } => content_hash_combine_structural(
      left: content_hash_atom(value: "cargo_target.v1.example" as NonEmptyStr),
      right: content_hash_atom(value: name as NonEmptyStr),
    )
    Bench { name } => content_hash_combine_structural(
      left: content_hash_atom(value: "cargo_target.v1.bench" as NonEmptyStr),
      right: content_hash_atom(value: name as NonEmptyStr),
    )
  }
}

fn build_product_digest(product: BuildProduct) -> Fnv1a64Structural {
  content_hash_tagged_structural(
    tag: "devboot.subject.product" as NonEmptyStr,
    payload: content_hash_combine_structural(
      left: content_hash_atom(value: product.package),
      right: cargo_target_digest(target: product.target),
    ),
  )
}

fn abi_env_atom(env: AbiEnv?) -> Fnv1a64Structural {
  match env {
    Present { value: e } => content_hash_atom(value: abi_env_identity_tag(env: e))
    Absent => content_hash_atom(value: "abi.v1.absent" as NonEmptyStr)
  }
}

fn target_triple_digest(target: TargetTriple) -> Fnv1a64Structural {
  content_hash_tagged_structural(
    tag: "devboot.subject.target" as NonEmptyStr,
    payload: content_hash_combine_structural(
      left: content_hash_atom(value: architecture_identity_tag(arch: target.arch)),
      right: content_hash_combine_structural(
        left: content_hash_atom(value: triple_vendor_identity_tag(vendor: target.vendor)),
        right: content_hash_combine_structural(
          left: content_hash_atom(value: os_identity_tag(os: target.os)),
          right: abi_env_atom(env: target.env),
        ),
      ),
    ),
  )
}

fn toolchain_digest(toolchain: ToolchainRequirement) -> Fnv1a64Structural {
  content_hash_tagged_structural(
    tag: "devboot.subject.toolchain" as NonEmptyStr,
    payload: content_hash_combine_structural(
      left: content_hash_atom(value: toolchain.name),
      right: content_hash_atom(value: toolchain.version),
    ),
  )
}

fn features_digest(features: List<NonEmptyStr>) -> Fnv1a64Structural {
  fold(
    features,
    init: content_hash_atom(value: "devboot.subject.features" as NonEmptyStr),
    f: (acc, name) => content_hash_combine_structural(
      left: acc,
      right: content_hash_atom(value: name),
    ),
  )
}

fn optional_atom(value: NonEmptyStr?, absent_tag: NonEmptyStr) -> Fnv1a64Structural {
  match value {
    Present { value: text } => content_hash_atom(value: text)
    Absent => content_hash_atom(value: absent_tag)
  }
}

data cargo_config_value_atom_note: String = "A cargo configuration VALUE may legitimately be empty -- only the key is required to name something -- so unlike every other atom here it cannot be cast into the non-empty carrier. Casting it would assert a property the admission deliberately does not check, which is the fabrication class this module just finished removing; skipping the empty value instead would make an entry set to empty collide with the same entry absent, two states whose meanings differ. It hashes as its own distinct atom, so both stay representable and neither is invented."

fn cargo_config_value_atom(value: String) -> Fnv1a64Structural {
  if value == "" {
    content_hash_atom(value: "devboot.subject.cargo_config.empty_value" as NonEmptyStr)
  } else {
    content_hash_atom(value: value as NonEmptyStr)
  }
}

fn cargo_config_digest(entries: List<CargoConfigEntry>) -> Fnv1a64Structural {
  fold(
    entries,
    init: content_hash_atom(value: "devboot.subject.cargo_config" as NonEmptyStr),
    f: (acc, entry) => content_hash_combine_structural(
      left: acc,
      right: content_hash_combine_structural(
        left: content_hash_atom(value: entry.key),
        right: cargo_config_value_atom(value: entry.value),
      ),
    ),
  )
}

fn build_environment_digest(environment: BuildEnvironmentSpec) -> Fnv1a64Structural {
  content_hash_tagged_structural(
    tag: "devboot.subject.environment" as NonEmptyStr,
    payload: content_hash_combine_structural(
      left: features_digest(features: environment.rustflags),
      right: content_hash_combine_structural(
        left: optional_atom(value: environment.linker, absent_tag: "devboot.subject.linker.absent" as NonEmptyStr),
        right: content_hash_combine_structural(
          left: optional_atom(value: environment.sysroot, absent_tag: "devboot.subject.sysroot.absent" as NonEmptyStr),
          right: cargo_config_digest(entries: environment.cargo_config),
        ),
      ),
    ),
  )
}

fn build_subject_digest(subject: BuildSubject) -> ContentHash {
  content_hash_tagged(
    tag: "devboot.subject" as NonEmptyStr,
    payload: content_hash_combine_structural(
      left: content_hash_atom(value: git_object_id_wire_hex(oid: subject.tree_oid)),
      right: content_hash_combine_structural(
        left: build_product_digest(product: subject.product),
        right: content_hash_combine_structural(
          left: toolchain_digest(toolchain: subject.toolchain),
          right: content_hash_combine_structural(
            left: target_triple_digest(target: subject.target),
            right: content_hash_combine_structural(
              left: content_hash_atom(value: subject.profile),
              right: content_hash_combine_structural(
                left: features_digest(features: subject.features),
                right: build_environment_digest(environment: subject.environment),
              ),
            ),
          ),
        ),
      ),
    ),
  )
}

data build_subject_equality_note: String = "THE EQUALITY AUTHORITY, kept apart from the digest on purpose. Reuse and attach decisions consume THIS function, never a digest comparison: the digest finds a candidate, and this decides whether the candidate is actually the thing that was asked for.\\n\\nThe separation is what makes a hash collision harmless. Under digest-only equality, two different subjects that happen to collide would trade artifacts, and the failure would be silent, rare, and impossible to reproduce. Under lookup-then-compare, a collision merely produces a candidate that fails comparison and is refused -- the cost of a collision drops from a wrong binary to a redundant build.\\n\\nIt is exact structural equality over every axis, which the substrate provides directly on these types; spelling out a field-by-field comparison here would be a second definition of equality that could drift from the type as fields are added."

fn build_subject_equal(left: BuildSubject, right: BuildSubject) -> Bool {
  left == right
}
