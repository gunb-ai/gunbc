module gunbc.devboot.subject



// WHAT A BUILD IS OF, carried so that two requests naming the same thing are the same request and two requests naming different things never collide. Every field is a fact about the COMPUTATION; nothing here can be a fact about the requester.
//
// THE TREE OID IS THE SOURCE AXIS AND IT IS NOT A COMMIT. A commit names a tree plus history, authorship and time, so two rebases of identical content are different commits and would build twice; the tree alone is the content, so a rebase, a merge result and CI's synthetic merge tree all dedupe for free when their content agrees. It is a GitObjectId rather than text because extdeps.git.object_store already owns Git's identity scheme, including the family discriminant that keeps a SHA-1 and a SHA-256 id from comparing equal on hex alone.
//
// WHAT MAY NEVER ENTER THIS KEY, stated as a rule rather than left to reviewer memory: branch name, session name, worktree path, ambient working directory, requester identity, wall-clock time, and a commit sha standing alone. Each of those makes two identical computations look different, which does not merely lose the dedup this service exists to provide -- it makes the store grow without bound while every entry claims to be distinct.
// WHICH ARTIFACT IS BEING ASKED FOR, without which the rest of the subject does not identify a build at all. One tree at one toolchain for one target and profile can produce the CLI, a different binary, the library, or a test harness, and those are different bytes. A key blind to this axis would let a request for one binary be satisfied by another that happened to be built from the same source at the same settings -- the false-share this service exists to prevent, arriving through the one axis nobody thought to name.
//
// IT IS CARGO'S OWN TARGET NOTION, NOT A MINTED PRODUCT ENUM. Cargo already decides what a package can produce, and CargoTarget carries exactly that closed vocabulary -- library, binary, test, example, benchmark, each with its name where a name distinguishes it. Coining a devboot-local list of products would be a second authority over a concept upstream already owns, and it would have to be edited every time a new binary appears; the cargo target does not, because the name is a field rather than a variant.
type BuildProduct {
  package: std.types.NonEmptyStr
  target: extdeps.cargo.CargoTarget
}

// THE SETTINGS OUTSIDE THE SOURCE THAT STILL CHANGE THE BYTES. Source, toolchain, target and profile do not determine an artifact on their own: a codegen flag, a different linker, a substituted sysroot, or a cargo configuration entry each change what comes out while every other axis stays identical. A key blind to them would hand a requester an artifact built under settings it did not ask for, and the divergence would be invisible precisely because every named axis agreed.
//
// RUSTFLAG ORDER IS SIGNIFICANT AND THAT IS CORRECTNESS, NOT CAUTION. Repeated codegen options resolve last-one-wins in the compiler, so two orderings of the same flags are genuinely two different builds. This is unlike the feature list, where order is carried conservatively because no canonical ordering is computable yet; here, carrying order is the faithful model and canonicalizing would be the error.
//
// WHAT THIS CARRIER IS NOT: a claim of hermeticity. It is one exact environment identity, which is the alternative the ruling permits -- the requester states the environment and the digest binds it. Facts genuinely outside it, such as a build script reading the ambient host, are not silently absorbed here; they remain unmodeled and are named in the residue rather than pretended into this record.
type CargoConfigEntry {
  key: std.types.NonEmptyStr
  value: String
}

type BuildEnvironmentSpec {
  rustflags: List<std.types.NonEmptyStr>
  linker: std.types.NonEmptyStr?
  sysroot: std.types.NonEmptyStr?
  cargo_config: List<CargoConfigEntry>
  platform_c_library: extdeps.gnu.libc.PlatformCLibrary
}

type BuildSubject {
  tree_oid: extdeps.git.object_store.GitObjectId
  product: BuildProduct
  toolchain: extdeps.toolchain.types.ToolchainRequirement
  target: extdeps.toolchain.types.TargetTriple
  profile: std.types.NonEmptyStr
  features: List<std.types.NonEmptyStr>
  environment: BuildEnvironmentSpec
}

// ADMISSION IS THE ONLY DOOR, and it exists because the fields it fills are non-empty by type while the request that arrives is not. The earlier revision cast raw strings into NonEmptyStr at the digest, which is the fabrication this repository forbids: a cast asserts the property rather than establishing it, so an empty feature name would have travelled into the identity as though it had been checked.
//
// Now every string that must be non-empty is admitted here, once, with its own refusal arm, and the subject type carries the property structurally. A caller holding a BuildSubject holds proof the check ran, because there is no other constructor.
// FEATURE ORDER IS PART OF THE SUBJECT, and that is the deliberately conservative choice rather than an oversight. Canonically ordering the list would need a total string comparator, and no ordering primitive over String exists in std today -- so the options were to carry order as significant, or to fabricate a canonical form the substrate cannot yet compute.
//
// The two failure directions are not symmetric, which is what decides it. Treating a reordering as a DIFFERENT subject costs one redundant build: the second request builds instead of dedup'ing, and both artifacts are correct for their request. Treating two genuinely different feature sets as the SAME subject would hand a requester an artifact built from features it did not ask for -- a false share, and the exact class the requested-subject-equals-produced-subject wall exists to make unwritable. A conservative over-approximation computed AS the answer is legitimate (DESIGN section 5 distinguishes it from an absorbing fallback, which widens on a FAILURE state); this one is computed from structure, is loud in the receipt, and never answers wrongly.
//
// DUPLICATES ARE STILL REFUSED, because duplicate detection needs only equality, which does exist. A repeated feature is an authoring error whose two spellings would otherwise hash differently while naming one build.
//
// Dissolve-on: a total String ordering in std. At that point features carry canonically sorted with a constructor that refuses unsorted input, reorderings dedupe, and this note and the order-sensitivity both retire.
type BuildSubjectRefusalCause
  = FeatureNameEmpty
  | DuplicateFeature { name: String }
  | ProfileNameEmpty
  | PackageNameEmpty
  | RustflagEmpty
  | CargoConfigKeyEmpty
  | LinkerEmpty
  | SysrootEmpty
  | PlatformCLibraryUnobserved

type BuildSubjectAdmission
  = SubjectAdmitted { subject: BuildSubject }
  | SubjectRefused { cause: BuildSubjectRefusalCause }

fn feature_in_list(name: String, names: List<String>) -> Bool {
  fold(names, init: false, f: (acc, candidate) => acc || candidate == name)
}

type FeatureScan {
  seen: List<String>
  refusal: BuildSubjectRefusalCause?
}

fn scan_feature(acc: FeatureScan, name: String) -> FeatureScan {
  match acc.refusal {
    Present { value: _ } => acc
    Absent =>
      if name == "" {
        FeatureScan { seen: acc.seen, refusal: Present { value: FeatureNameEmpty } }
      } else {
        if feature_in_list(name: name, names: acc.seen) {
          FeatureScan {
            seen: acc.seen,
            refusal: Present { value: DuplicateFeature { name: name } },
          }
        } else {
          FeatureScan { seen: concat(acc.seen, [name]), refusal: acc.refusal }
        }
      }
  }
}

type StringListScan {
  refusal: BuildSubjectRefusalCause?
}

fn scan_nonempty(acc: StringListScan, value: String, cause: BuildSubjectRefusalCause) -> StringListScan {
  match acc.refusal {
    Present { value: _ } => acc
    Absent =>
      if value == "" {
        StringListScan { refusal: Present { value: cause } }
      } else {
        acc
      }
  }
}

fn scan_rustflags(flags: List<String>) -> BuildSubjectRefusalCause? {
  fold(
    flags,
    init: StringListScan { refusal: none },
    f: (acc, flag) => scan_nonempty(acc: acc, value: flag, cause: RustflagEmpty),
  ).refusal
}

type RawCargoConfigEntry {
  key: String
  value: String
}

fn scan_cargo_config(entries: List<RawCargoConfigEntry>) -> BuildSubjectRefusalCause? {
  fold(
    entries,
    init: StringListScan { refusal: none },
    f: (acc, entry) => scan_nonempty(acc: acc, value: entry.key, cause: CargoConfigKeyEmpty),
  ).refusal
}

fn admitted_cargo_config(entries: List<RawCargoConfigEntry>) -> List<CargoConfigEntry> {
  entries |> map(entry => CargoConfigEntry { key: entry.key as std.types.NonEmptyStr, value: entry.value })
}

fn optional_nonempty_refusal(value: String?, cause: BuildSubjectRefusalCause) -> BuildSubjectRefusalCause? {
  match value {
    Absent => none
    Present { value: text } =>
      if text == "" {
        Present { value: cause }
      } else {
        none
      }
  }
}

fn admitted_optional_nonempty(value: String?) -> std.types.NonEmptyStr? {
  match value {
    Absent => none
    Present { value: text } => Present { value: text as std.types.NonEmptyStr }
  }
}

fn gunbc.devboot.subject.first_refusal(left: BuildSubjectRefusalCause?, right: BuildSubjectRefusalCause?) -> BuildSubjectRefusalCause? {
  match left {
    Present { value: cause } => Present { value: cause }
    Absent => right
  }
}

// AN UNOBSERVED C LIBRARY REFUSES rather than being admitted as a distinct-looking environment. LibcUnobserved is representable so a consumer must handle it, and the handling is this: an environment whose platform ABI was never measured cannot identify an artifact, because the whole point of the axis is that two hosts differing only in their C library are two environments. Admitting the unobserved value would let every unmeasured host collapse into one identity -- exactly the collision the axis was added to prevent, reintroduced through its own absent case.
fn platform_c_library_refusal(library: extdeps.gnu.libc.PlatformCLibrary) -> BuildSubjectRefusalCause? {
  match library {
    GnuLibc { version } => none
    LibcUnobserved => Present { value: PlatformCLibraryUnobserved }
  }
}

fn environment_refusal(
  rustflags: List<String>,
  linker: String?,
  sysroot: String?,
  cargo_config: List<RawCargoConfigEntry>,
  platform_c_library: extdeps.gnu.libc.PlatformCLibrary,
) -> BuildSubjectRefusalCause? {
  gunbc.devboot.subject.first_refusal(
    left: platform_c_library_refusal(library: platform_c_library),
    right: gunbc.devboot.subject.first_refusal(
    left: scan_rustflags(flags: rustflags),
    right: gunbc.devboot.subject.first_refusal(
      left: optional_nonempty_refusal(value: linker, cause: LinkerEmpty),
      right: gunbc.devboot.subject.first_refusal(
        left: optional_nonempty_refusal(value: sysroot, cause: SysrootEmpty),
        right: scan_cargo_config(entries: cargo_config),
      ),
    ),
  ))
}

fn scalar_refusal(package: String, profile: String) -> BuildSubjectRefusalCause? {
  if package == "" {
    Present { value: PackageNameEmpty }
  } else {
    if profile == "" {
      Present { value: ProfileNameEmpty }
    } else {
      none
    }
  }
}

fn admit_build_subject(
  tree_oid: extdeps.git.object_store.GitObjectId,
  package: String,
  cargo_target: extdeps.cargo.CargoTarget,
  toolchain: extdeps.toolchain.types.ToolchainRequirement,
  target: extdeps.toolchain.types.TargetTriple,
  profile: String,
  features: List<String>,
  rustflags: List<String>,
  linker: String?,
  sysroot: String?,
  cargo_config: List<RawCargoConfigEntry>,
  platform_c_library: extdeps.gnu.libc.PlatformCLibrary,
) -> BuildSubjectAdmission {
  match gunbc.devboot.subject.first_refusal(
    left: scalar_refusal(package: package, profile: profile),
    right: gunbc.devboot.subject.first_refusal(
      left: fold(
        features,
        init: FeatureScan { seen: [], refusal: none },
        f: (acc, name) => scan_feature(acc: acc, name: name),
      ).refusal,
      right: environment_refusal(
        rustflags: rustflags,
        linker: linker,
        sysroot: sysroot,
        cargo_config: cargo_config,
        platform_c_library: platform_c_library,
      ),
    ),
  ) {
    Present { value: cause } => SubjectRefused { cause: cause }
    Absent =>
      SubjectAdmitted {
        subject: BuildSubject {
          tree_oid: tree_oid,
          product: BuildProduct {
            package: package as std.types.NonEmptyStr,
            target: cargo_target,
          },
          toolchain: toolchain,
          target: target,
          profile: profile as std.types.NonEmptyStr,
          features: admitted_nonempty_names(values: features),
          environment: BuildEnvironmentSpec {
            platform_c_library: platform_c_library,
            rustflags: admitted_nonempty_names(values: rustflags),
            linker: admitted_optional_nonempty(value: linker),
            sysroot: admitted_optional_nonempty(value: sysroot),
            cargo_config: admitted_cargo_config(entries: cargo_config),
          },
        },
      }
  }
}

// The projection that fills the non-empty-typed list fields, and it is sound only because the scan above already refused on every empty member. It runs strictly after that refusal, on the admitted branch, so the cast rests on an executed check rather than on an assertion -- which is the whole difference between admission and fabrication.
fn admitted_nonempty_names(values: List<String>) -> List<std.types.NonEmptyStr> {
  values |> map(value => value as std.types.NonEmptyStr)
}

// THESE TAGS DEFINE STORED IDENTITY, WHICH IS WHY THEY ARE NOT THE DIAGNOSTIC NAMES. The earlier revision folded the toolchain module's *_diagnostic_name functions into this digest, and each of those carries a header saying it is for diagnostics only and never a wire label. That restriction is not decoration: a diagnostic spelling exists to be edited when a message reads badly, and an identity spelling must never be edited casually, because every artifact stored under the old spelling is orphaned the moment it changes. Borrowing one for the other fuses two lifetimes that must stay separate.
//
// So the digest owns its own total tag per variant. The tags are deliberately opaque and versioned by this module: they carry no meaning to a reader, they are never displayed, and their only contract is that each closed variant maps to exactly one distinct tag, forever. Renaming a variant in the upstream type now changes nothing here -- which is the property the finding asked for, because a rename is a spelling change and must not orphan a store.
//
// WHY A TAG RATHER THAN A POSITION. An ordinal would be smaller, but adding a variant in the middle of a coproduct silently renumbers everything after it, so identity would shift under an edit that looks additive. A tag per variant is stable under insertion by construction.
fn architecture_identity_tag(arch: extdeps.toolchain.types.Architecture) -> std.types.NonEmptyStr {
  match arch {
    X86_64 => "arch.v1.x86_64" as std.types.NonEmptyStr
    X86 => "arch.v1.x86" as std.types.NonEmptyStr
    Aarch64 => "arch.v1.aarch64" as std.types.NonEmptyStr
    Arm => "arch.v1.arm" as std.types.NonEmptyStr
    Armv7 => "arch.v1.armv7" as std.types.NonEmptyStr
    Mips => "arch.v1.mips" as std.types.NonEmptyStr
    Mipsel => "arch.v1.mipsel" as std.types.NonEmptyStr
    Mips64 => "arch.v1.mips64" as std.types.NonEmptyStr
    Mips64el => "arch.v1.mips64el" as std.types.NonEmptyStr
    Riscv64 => "arch.v1.riscv64" as std.types.NonEmptyStr
    Wasm32 => "arch.v1.wasm32" as std.types.NonEmptyStr
  }
}

fn triple_vendor_identity_tag(vendor: extdeps.toolchain.types.TripleVendor) -> std.types.NonEmptyStr {
  match vendor {
    UnknownVendor => "vendor.v1.unknown" as std.types.NonEmptyStr
    Pc => "vendor.v1.pc" as std.types.NonEmptyStr
    Apple => "vendor.v1.apple" as std.types.NonEmptyStr
    W64 => "vendor.v1.w64" as std.types.NonEmptyStr
  }
}

fn os_identity_tag(os: extdeps.toolchain.types.Os) -> std.types.NonEmptyStr {
  match os {
    Linux => "os.v1.linux" as std.types.NonEmptyStr
    Macos => "os.v1.macos" as std.types.NonEmptyStr
    Windows => "os.v1.windows" as std.types.NonEmptyStr
    Freebsd => "os.v1.freebsd" as std.types.NonEmptyStr
    Android => "os.v1.android" as std.types.NonEmptyStr
    Ios => "os.v1.ios" as std.types.NonEmptyStr
    Wasi => "os.v1.wasi" as std.types.NonEmptyStr
  }
}

fn abi_env_identity_tag(env: extdeps.toolchain.types.AbiEnv) -> std.types.NonEmptyStr {
  match env {
    NoneAbi => "abi.v1.none" as std.types.NonEmptyStr
    Gnu => "abi.v1.gnu" as std.types.NonEmptyStr
    GnuEabi => "abi.v1.gnueabi" as std.types.NonEmptyStr
    GnuEabihf => "abi.v1.gnueabihf" as std.types.NonEmptyStr
    Musl => "abi.v1.musl" as std.types.NonEmptyStr
    Msvc => "abi.v1.msvc" as std.types.NonEmptyStr
    AndroidAbi => "abi.v1.android" as std.types.NonEmptyStr
    Eabi => "abi.v1.eabi" as std.types.NonEmptyStr
    Eabihf => "abi.v1.eabihf" as std.types.NonEmptyStr
  }
}

// THE SUBJECT DIGEST IS DERIVED FROM STRUCTURE, never from a rendered triple. Rendering would require a canonical spelling of the target, and every upstream spells targets differently; folding one tag per variant needs no spelling to be canonical, only to be total and distinct per variant, which a closed coproduct gives for free.
//
// THE ABI AXIS IS LOAD-BEARING RATHER THAN DECORATIVE. Gnu and Musl differ in exactly the property that decides whether a produced binary runs on a given host, so a digest blind to it would let a musl artifact satisfy a gnu request. An absent env is hashed as its own atom rather than skipped, because skipping would make an unspecified env collide with whatever env sorts first.
//
// WHAT THIS DIGEST IS FOR, stated because the previous revision got it wrong. It is an INDEX -- a short key under which a subject's artifact can be found. It is not proof that two subjects are the same, and no reuse decision may rest on it alone, because a structural hash admits collisions and a collision would hand a requester somebody else's bytes. The equality authority is exact structural comparison of the retrieved subject; see the retrieval path in gunbc.devboot.outcome.
fn cargo_target_digest(target: extdeps.cargo.CargoTarget) -> std.content_hash.Fnv1a64Structural {
  match target {
    Lib => content_hash_atom(value: "cargo_target.v1.lib" as std.types.NonEmptyStr)
    Bin { name } => content_hash_combine_structural(
      left: content_hash_atom(value: "cargo_target.v1.bin" as std.types.NonEmptyStr),
      right: content_hash_atom(value: name as std.types.NonEmptyStr),
    )
    CargoTest { name } => content_hash_combine_structural(
      left: content_hash_atom(value: "cargo_target.v1.test" as std.types.NonEmptyStr),
      right: content_hash_atom(value: name as std.types.NonEmptyStr),
    )
    Example { name } => content_hash_combine_structural(
      left: content_hash_atom(value: "cargo_target.v1.example" as std.types.NonEmptyStr),
      right: content_hash_atom(value: name as std.types.NonEmptyStr),
    )
    Bench { name } => content_hash_combine_structural(
      left: content_hash_atom(value: "cargo_target.v1.bench" as std.types.NonEmptyStr),
      right: content_hash_atom(value: name as std.types.NonEmptyStr),
    )
  }
}

fn build_product_digest(product: BuildProduct) -> std.content_hash.Fnv1a64Structural {
  content_hash_tagged_structural(
    tag: "devboot.subject.product" as std.types.NonEmptyStr,
    payload: content_hash_combine_structural(
      left: content_hash_atom(value: product.package),
      right: cargo_target_digest(target: product.target),
    ),
  )
}

fn abi_env_atom(env: extdeps.toolchain.types.AbiEnv?) -> std.content_hash.Fnv1a64Structural {
  match env {
    Present { value: e } => content_hash_atom(value: abi_env_identity_tag(env: e))
    Absent => content_hash_atom(value: "abi.v1.absent" as std.types.NonEmptyStr)
  }
}

fn target_triple_digest(target: extdeps.toolchain.types.TargetTriple) -> std.content_hash.Fnv1a64Structural {
  content_hash_tagged_structural(
    tag: "devboot.subject.target" as std.types.NonEmptyStr,
    payload: content_hash_combine_structural(
      left: content_hash_atom(value: architecture_identity_tag(arch: target.arch)),
      right: content_hash_combine_structural(
        left: content_hash_atom(value: triple_vendor_identity_tag(vendor: target.vendor)),
        right: content_hash_combine_structural(
          left: content_hash_atom(value: os_identity_tag(os: target.os)),
          right: abi_env_atom(env: target.env),
        ),
      ),
    ),
  )
}

fn toolchain_digest(toolchain: extdeps.toolchain.types.ToolchainRequirement) -> std.content_hash.Fnv1a64Structural {
  content_hash_tagged_structural(
    tag: "devboot.subject.toolchain" as std.types.NonEmptyStr,
    payload: content_hash_combine_structural(
      left: content_hash_atom(value: toolchain.name),
      right: content_hash_atom(value: toolchain.version),
    ),
  )
}

fn features_digest(features: List<std.types.NonEmptyStr>) -> std.content_hash.Fnv1a64Structural {
  fold(
    features,
    init: content_hash_atom(value: "devboot.subject.features" as std.types.NonEmptyStr),
    f: (acc, name) => content_hash_combine_structural(
      left: acc,
      right: content_hash_atom(value: name),
    ),
  )
}

fn optional_atom(value: std.types.NonEmptyStr?, absent_tag: std.types.NonEmptyStr) -> std.content_hash.Fnv1a64Structural {
  match value {
    Present { value: text } => content_hash_atom(value: text)
    Absent => content_hash_atom(value: absent_tag)
  }
}

// A cargo configuration VALUE may legitimately be empty -- only the key is required to name something -- so unlike every other atom here it cannot be cast into the non-empty carrier. Casting it would assert a property the admission deliberately does not check, which is the fabrication class this module just finished removing; skipping the empty value instead would make an entry set to empty collide with the same entry absent, two states whose meanings differ. It hashes as its own distinct atom, so both stay representable and neither is invented.
fn cargo_config_value_atom(value: String) -> std.content_hash.Fnv1a64Structural {
  if value == "" {
    content_hash_atom(value: "devboot.subject.cargo_config.empty_value" as std.types.NonEmptyStr)
  } else {
    content_hash_atom(value: value as std.types.NonEmptyStr)
  }
}

fn cargo_config_digest(entries: List<CargoConfigEntry>) -> std.content_hash.Fnv1a64Structural {
  fold(
    entries,
    init: content_hash_atom(value: "devboot.subject.cargo_config" as std.types.NonEmptyStr),
    f: (acc, entry) => content_hash_combine_structural(
      left: acc,
      right: content_hash_combine_structural(
        left: content_hash_atom(value: entry.key),
        right: cargo_config_value_atom(value: entry.value),
      ),
    ),
  )
}

fn build_environment_digest(environment: BuildEnvironmentSpec) -> std.content_hash.Fnv1a64Structural {
  content_hash_tagged_structural(
    tag: "devboot.subject.environment" as std.types.NonEmptyStr,
    payload: content_hash_combine_structural(
      left: content_hash_combine_structural(
        left: features_digest(features: environment.rustflags),
        right: content_hash_atom(value: platform_c_library_identity_tag(library: environment.platform_c_library)),
      ),
      right: content_hash_combine_structural(
        left: optional_atom(value: environment.linker, absent_tag: "devboot.subject.linker.absent" as std.types.NonEmptyStr),
        right: content_hash_combine_structural(
          left: optional_atom(value: environment.sysroot, absent_tag: "devboot.subject.sysroot.absent" as std.types.NonEmptyStr),
          right: cargo_config_digest(entries: environment.cargo_config),
        ),
      ),
    ),
  )
}

// THE OBJECT-ID FAMILY IS PART OF THE IDENTITY, and folding the hex alone threw it away. GitObjectId is a coproduct precisely so a SHA-1 and a SHA-256 object id cannot be compared on their hex -- the note beside that type argues exactly this -- and the digest then discarded the discriminant the type exists to carry, so two tree oids from different object formats whose hex coincided would have produced one subject digest and traded artifacts.
//
// It is not reachable today: this repository's stores are SHA-1, so one family is in play and the collision has no way to occur. That is a fact about the current population, not about the carrier, and the repository is explicitly moving toward SHA-256 object format -- the moment both exist, an identity that ignores which one it is becomes wrong silently.
//
// The fix mirrors the ref token, which already prefixes its family for the same reason, so the two places that turn a hash into an identity string now agree instead of one quietly being weaker. Found by review, and the argument that convinced me is that the adjacent note already made the case -- the code simply did not do what its own reasoning said.
fn tree_oid_identity_atom(oid: extdeps.git.object_store.GitObjectId) -> std.content_hash.ContentHash {
  content_hash_combine_structural(
    left: content_hash_atom(value: git_object_format_identity_tag(format: git_object_id_format(oid: oid))),
    right: content_hash_atom(value: git_object_id_wire_hex(oid: oid)),
  )
}

fn git_object_format_identity_tag(format: extdeps.git.object_store.GitObjectFormat) -> std.types.NonEmptyStr {
  match format {
    GitObjectFormatSha1 => "git.oid.v1.sha1" as std.types.NonEmptyStr
    GitObjectFormatSha256 => "git.oid.v1.sha256" as std.types.NonEmptyStr
  }
}

fn build_subject_digest(subject: BuildSubject) -> std.content_hash.ContentHash {
  content_hash_tagged(
    tag: "devboot.subject" as std.types.NonEmptyStr,
    payload: content_hash_combine_structural(
      left: tree_oid_identity_atom(oid: subject.tree_oid),
      right: content_hash_combine_structural(
        left: build_product_digest(product: subject.product),
        right: content_hash_combine_structural(
          left: toolchain_digest(toolchain: subject.toolchain),
          right: content_hash_combine_structural(
            left: target_triple_digest(target: subject.target),
            right: content_hash_combine_structural(
              left: content_hash_atom(value: subject.profile),
              right: content_hash_combine_structural(
                left: features_digest(features: subject.features),
                right: build_environment_digest(environment: subject.environment),
              ),
            ),
          ),
        ),
      ),
    ),
  )
}

// THE EQUALITY AUTHORITY, kept apart from the digest on purpose. Reuse and attach decisions consume THIS function, never a digest comparison: the digest finds a candidate, and this decides whether the candidate is actually the thing that was asked for.
//
// The separation is what makes a hash collision harmless. Under digest-only equality, two different subjects that happen to collide would trade artifacts, and the failure would be silent, rare, and impossible to reproduce. Under lookup-then-compare, a collision merely produces a candidate that fails comparison and is refused -- the cost of a collision drops from a wrong binary to a redundant build.
//
// It is exact structural equality over every axis, which the substrate provides directly on these types; spelling out a field-by-field comparison here would be a second definition of equality that could drift from the type as fields are added.
fn build_subject_equal(left: BuildSubject, right: BuildSubject) -> Bool {
  left == right
}

// A TOTAL, INJECTIVE RENDERING OF THE WHOLE SUBJECT, which exists so a stored artifact can carry the request it was built for into a future process. The digest cannot do that job: it is an index, and recovering a subject from one is impossible by construction.
//
// WHY A RENDERING RATHER THAN A PARSER. Comparing two subjects exactly needs only that the rendering be injective -- distinct subjects render distinctly -- not that it be reversible. So the stored text is compared against the rendering of the request, and equal renderings mean equal subjects without any need to reconstruct a value. That keeps the reuse law exact while adding one function instead of a serializer and a parser that could disagree.
//
// INJECTIVITY IS WHY EVERY FIELD APPEARS AND WHY THE SEPARATORS ARE NOT SHARED WITH THE DATA. Each axis is emitted with its own label and a newline separator, and list members are indexed, so no reordering or concatenation of one field can impersonate another. A rendering that dropped an axis would silently make two different subjects equal -- the false share this whole identity scheme exists to prevent, reintroduced at the storage layer.
fn render_optional(value: std.types.NonEmptyStr?) -> String {
  match value {
    Present { value: text } => text as String
    Absent => "<absent>"
  }
}

fn render_cargo_target(target: extdeps.cargo.CargoTarget) -> String {
  match target {
    Lib => "lib"
    Bin { name } => concat("bin:", name)
    CargoTest { name } => concat("test:", name)
    Example { name } => concat("example:", name)
    Bench { name } => concat("bench:", name)
  }
}

fn render_indexed_list(label: String, values: List<std.types.NonEmptyStr>) -> String {
  fold(
    values,
    init: IndexedRender { index: 0, text: "" },
    f: (acc, value) =>
      IndexedRender {
        index: acc.index + 1,
        text: join([acc.text, label, ".", to_string(acc.index), "=", value as String, "\n"], ""),
      },
  ).text
}

type IndexedRender {
  index: Int
  text: String
}

fn render_cargo_config(entries: List<CargoConfigEntry>) -> String {
  fold(
    entries,
    init: IndexedRender { index: 0, text: "" },
    f: (acc, entry) =>
      IndexedRender {
        index: acc.index + 1,
        text: join([acc.text, "cargo_config.", to_string(acc.index), "=", entry.key as String, "=", entry.value, "\n"], ""),
      },
  ).text
}

fn render_build_subject(subject: BuildSubject) -> String {
  join([
    "devboot.subject.v1\n",
    "tree=", git_object_id_wire_hex(oid: subject.tree_oid) as String, "\n",
    "package=", subject.product.package as String, "\n",
    "target=", render_cargo_target(target: subject.product.target), "\n",
    "toolchain.name=", subject.toolchain.name as String, "\n",
    "toolchain.version=", subject.toolchain.version as String, "\n",
    "arch=", architecture_identity_tag(arch: subject.target.arch) as String, "\n",
    "vendor=", triple_vendor_identity_tag(vendor: subject.target.vendor) as String, "\n",
    "os=", os_identity_tag(os: subject.target.os) as String, "\n",
    "abi=", render_abi(env: subject.target.env), "\n",
    "profile=", subject.profile as String, "\n",
    render_indexed_list(label: "feature", values: subject.features),
    render_indexed_list(label: "rustflag", values: subject.environment.rustflags),
    "platform_c_library=", render_platform_c_library(library: subject.environment.platform_c_library), "\n",
    "linker=", render_optional(value: subject.environment.linker), "\n",
    "sysroot=", render_optional(value: subject.environment.sysroot), "\n",
    render_cargo_config(entries: subject.environment.cargo_config),
  ], "")
}

fn render_abi(env: extdeps.toolchain.types.AbiEnv?) -> String {
  match env {
    Present { value: e } => abi_env_identity_tag(env: e) as String
    Absent => "absent"
  }
}
