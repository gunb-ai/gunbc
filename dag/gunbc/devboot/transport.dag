module gunbc.devboot.transport

import std.types { String, NonEmptyStr, List, Bool, Int }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.gunbc
import extdeps.tools.mkdir { mkdir_binary_path, mkdir_parents_args }

data devboot_shell_transport_note: String = "Counted retained-transport roster for gunbc.devboot.build and gunbc.devboot.produce WitnessBin.Run sites. Runtime-present devboot modules are not yet on host_effect_apply typed effects; every raw argv site names a RetainedWitnessRun row with reason + dissolve-on = shell→intent Phase 2 (gunbc.host_effect_realize host_effect_apply). No unmarked WitnessBin.Run calls survive review."

data devboot_shell_typed_effects_dissolve_ref: DeclarationRef = DeclarationRef {
  module_path: "gunbc.host_effect_realize",
  decl_name: "host_effect_apply",
  field: WholeDeclaration,
}

type RetainedWitnessRun {
  reason: NonEmptyStr
  dissolves_to: DeclarationRef
}

data retained_devboot_rm_rf: RetainedWitnessRun = RetainedWitnessRun {
  reason: "devboot exchange and request/produced staging clears prior scratch trees and index files" as NonEmptyStr,
  dissolves_to: devboot_shell_typed_effects_dissolve_ref,
}

data retained_devboot_mkdir: RetainedWitnessRun = RetainedWitnessRun {
  reason: "devboot exchange and staging directories are created before git index operations" as NonEmptyStr,
  dissolves_to: devboot_shell_typed_effects_dissolve_ref,
}

data retained_devboot_git_read_tree: RetainedWitnessRun = RetainedWitnessRun {
  reason: "devboot materializes a ref tree or prefixes a source tree into a scratch index" as NonEmptyStr,
  dissolves_to: devboot_shell_typed_effects_dissolve_ref,
}

data retained_devboot_git_checkout_index: RetainedWitnessRun = RetainedWitnessRun {
  reason: "devboot checks out indexed blobs to the exchange directory without piping artifact bytes" as NonEmptyStr,
  dissolves_to: devboot_shell_typed_effects_dissolve_ref,
}

data retained_devboot_git_fetch: RetainedWitnessRun = RetainedWitnessRun {
  reason: "devboot polls the producer answer ref over the git-only transport" as NonEmptyStr,
  dissolves_to: devboot_shell_typed_effects_dissolve_ref,
}

data retained_devboot_sleep: RetainedWitnessRun = RetainedWitnessRun {
  reason: "devboot poll interval waits between fetch attempts" as NonEmptyStr,
