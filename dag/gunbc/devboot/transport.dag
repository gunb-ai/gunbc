module gunbc.devboot.transport


data devboot_shell_transport_note: String = "Counted retained-transport roster for gunbc.devboot.build and gunbc.devboot.produce WitnessBin.Run sites. Runtime-present devboot modules are not yet on host_effect_apply typed effects; every raw argv site names a RetainedWitnessRun row with reason + dissolve-on = shell→intent Phase 2 (gunbc.host_effect_realize host_effect_apply). No unmarked WitnessBin.Run calls survive review."

data devboot_shell_typed_effects_dissolve_ref: std.decl_ref.DeclarationRef = std.decl_ref.DeclarationRef {
  module_path: "gunbc.host_effect_realize",
  decl_name: "host_effect_apply",
  field: WholeDeclaration,
}

type RetainedWitnessRun {
  reason: std.types.NonEmptyStr
  dissolves_to: std.decl_ref.DeclarationRef
}

data retained_devboot_rm_rf: RetainedWitnessRun = RetainedWitnessRun {
  reason: "devboot exchange and request/produced staging clears prior scratch trees and index files" as std.types.NonEmptyStr,
  dissolves_to: devboot_shell_typed_effects_dissolve_ref,
}

data retained_devboot_mkdir: RetainedWitnessRun = RetainedWitnessRun {
  reason: "devboot exchange and staging directories are created before git index operations" as std.types.NonEmptyStr,
  dissolves_to: devboot_shell_typed_effects_dissolve_ref,
}

data retained_devboot_git_read_tree: RetainedWitnessRun = RetainedWitnessRun {
  reason: "devboot materializes a ref tree or prefixes a source tree into a scratch index" as std.types.NonEmptyStr,
  dissolves_to: devboot_shell_typed_effects_dissolve_ref,
}

data retained_devboot_git_checkout_index: RetainedWitnessRun = RetainedWitnessRun {
  reason: "devboot checks out indexed blobs to the exchange directory without piping artifact bytes" as std.types.NonEmptyStr,
  dissolves_to: devboot_shell_typed_effects_dissolve_ref,
}

data retained_devboot_git_fetch: RetainedWitnessRun = RetainedWitnessRun {
  reason: "devboot polls the producer answer ref over the git-only transport" as std.types.NonEmptyStr,
  dissolves_to: devboot_shell_typed_effects_dissolve_ref,
}

data retained_devboot_sleep: RetainedWitnessRun = RetainedWitnessRun {
  reason: "devboot poll interval waits between fetch attempts" as std.types.NonEmptyStr,
  dissolves_to: devboot_shell_typed_effects_dissolve_ref,
}

data retained_devboot_git_init: RetainedWitnessRun = RetainedWitnessRun {
  reason: "devboot prepares a scratch exchange repository under the work root" as std.types.NonEmptyStr,
  dissolves_to: devboot_shell_typed_effects_dissolve_ref,
}

data retained_devboot_git_update_index: RetainedWitnessRun = RetainedWitnessRun {
  reason: "devboot stages request and produced tree entries in a scratch index" as std.types.NonEmptyStr,
  dissolves_to: devboot_shell_typed_effects_dissolve_ref,
}

data retained_devboot_git_push: RetainedWitnessRun = RetainedWitnessRun {
  reason: "devboot publishes a parentless request commit to the producer store" as std.types.NonEmptyStr,
  dissolves_to: devboot_shell_typed_effects_dissolve_ref,
}

data retained_devboot_git_hash_object: RetainedWitnessRun = RetainedWitnessRun {
  reason: "devboot writes staged blobs into the object database before indexing" as std.types.NonEmptyStr,
  dissolves_to: devboot_shell_typed_effects_dissolve_ref,
}

data retained_devboot_git_write_tree: RetainedWitnessRun = RetainedWitnessRun {
  reason: "devboot serializes a staged index to a tree object for commit-tree" as std.types.NonEmptyStr,
  dissolves_to: devboot_shell_typed_effects_dissolve_ref,
}

data retained_devboot_git_commit_tree: RetainedWitnessRun = RetainedWitnessRun {
  reason: "devboot wraps request and produced trees in parentless commits for shallow clones" as std.types.NonEmptyStr,
