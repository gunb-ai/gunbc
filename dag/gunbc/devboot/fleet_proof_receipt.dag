module gunbc.devboot.fleet_proof_receipt

import std.types { String, NonEmptyStr, Int, CommitSha }
import std.content_hash { Sha256Digest, sha256_hex_digest }
import std.disposition { Disposition, Scaffold, SingleAuthority }
import std.decl_ref { DeclarationRef, WholeDeclaration, decl_ref }

// THE PRIOR devboot_fleet_proof_rows TRANSCRIPTION IS RETIRED. Those rows described a two-client proof that used a host shell git loop and devboot_serve_entry semantics — not the modeled devboot_serve_once_entry path exercised here. This module is now the single proof authority for the 2026-08-09 modeled fleet rerun (witty-raven-412 GO msg_b352da23, post-consolidation planning).
data devboot_fleet_proof_transcription_retired_note: String = "RETIRED: devboot_fleet_proof_rows and devboot_fleet_proof_run_provenance described a shell-harness proof (token fnv1a64-0b101ca4d5635461, digest a4cf1e7746...) that did not exercise devboot_serve_once_entry on srv3. Replaced by devboot_modeled_fleet_proof_receipt below, populated from the 2026-08-09T22:07–22:21Z modeled rerun receipts on srv1/srv2/srv3."

type DevbootFleetClientObservation {
  host: NonEmptyStr
  reused: Bool
  executed_exit: Int
  executed_stdout_fingerprint: NonEmptyStr
  receipt_excerpt: String
}

// EXECUTION EVIDENCE for the modeled two-client fleet proof. Fields match the on-host .devboot-receipt prose gunbc build writes and the srv3 modeled-serve.log SERVED line — not inferred from absence of a second log line.
type DevbootModeledFleetProofReceipt {
  producer_served_at: NonEmptyStr
  tested_tree: CommitSha
  mechanism_branch: NonEmptyStr
  request_identity: NonEmptyStr
  producer_host: NonEmptyStr
  producer_served_count: Int
  produced_commit: NonEmptyStr
  artifact_object_id: NonEmptyStr
  artifact_sha256: Sha256Digest
  clients: List<DevbootFleetClientObservation>
  producer_entry: DeclarationRef
  consumer_entry: DeclarationRef
  transport_endpoint: String
}

data devboot_modeled_fleet_proof_note: String = "Producer: srv3 host timer shell invokes ONLY devboot_serve_once_entry (modeled-serve-loop.sh) — no shell git for-each-ref on the path. Clients: srv1 then srv2 each ran gunbc build gunbc --repo-root corpus at tested_tree. Observed: one SERVED at 2026-08-09T22:13:23Z among 72 serve_once invocations (71 IDLE), one produced ref, srv2 reused:true with executed_exit and executed_stdout recorded in the build receipt."

fn devboot_modeled_fleet_proof_receipt() -> DevbootModeledFleetProofReceipt? {
  match sha256_hex_digest(hex: "976728c5d2029799f1d89843dfdd70c3b3ed132211126d2752ef8af23b5c146e") {
    Absent => none
    Present { value: digest } =>
      Present {
        value: DevbootModeledFleetProofReceipt {
          producer_served_at: "2026-08-09T22:13:23Z" as NonEmptyStr,
          tested_tree: "69d07ed69d3a08a6d881a4ed8f3f45e0ec82e8aa",
          mechanism_branch: "session/keen-moth-104" as NonEmptyStr,
          request_identity: "fnv1a64-dfd0b4abb44e30e7" as NonEmptyStr,
          producer_host: "srv3" as NonEmptyStr,
          producer_served_count: 1,
          produced_commit: "180beeb95ef8dab53c7abf8aa59a728ffc00e4e9" as NonEmptyStr,
          artifact_object_id: "bb6463edd3ebdae411755239fa2ae9bcadab23ef" as NonEmptyStr,
          artifact_sha256: digest,
          clients: [
            DevbootFleetClientObservation {
              host: "srv1" as NonEmptyStr,
              reused: false,
              executed_exit: 0,
              executed_stdout_fingerprint: "A causal compiler: write .dag, get Rust/Python/Go." as NonEmptyStr,
              receipt_excerpt: "BUILT ... reused: false executed_exit: 0 executed_stdout: A causal compiler: write .dag, get Rust/Python/Go.",
            },
            DevbootFleetClientObservation {
              host: "srv2" as NonEmptyStr,
              reused: true,
              executed_exit: 0,
              executed_stdout_fingerprint: "A causal compiler: write .dag, get Rust/Python/Go." as NonEmptyStr,
              receipt_excerpt: "BUILT ... reused: true executed_exit: 0 executed_stdout: A causal compiler: write .dag, get Rust/Python/Go.",
            },
          ],
          producer_entry: decl_ref(
            module_path: "gunbc.devboot.serve",
            decl_name: "devboot_serve_once_entry",
          ),
          consumer_entry: decl_ref(
            module_path: "gunbc.devboot.cli",
            decl_name: "devboot_build_cli_output",
          ),
          transport_endpoint: "git://192.168.1.221:19419/store.git",
        },
      }
  }
}

data devboot_fleet_store_ls_remote: String = "refs/devboot/produced/fnv1a64-dfd0b4abb44e30e7 180beeb95ef8dab53c7abf8aa59a728ffc00e4e9\nrefs/devboot/request/fnv1a64-dfd0b4abb44e30e7 a6163bd7f5c101f8f21f758b9edf93068fb47305"

data devboot_fleet_transport_endpoint: String = "git://192.168.1.221:19419/store.git"

// THE FLEET TIMER STILL RUNS A HOST SHELL ONESHOT THAT CALLS devboot_serve_once_entry. Modeled skip-if-produced and client reuse now live in build.dag; the outer belt loop remains host scaffolding until systemd oneshot+timer is enrolled from serve.dag.
data devboot_fleet_shell_loop_scaffold: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.devboot.serve",
    decl_name: "devboot_serve_once_entry",
    field: WholeDeclaration,
  }
}

fn devboot_fleet_proof_digest() -> Sha256Digest? {
  match devboot_modeled_fleet_proof_receipt() {
    Absent => none
    Present { value: receipt } => Present { value: receipt.artifact_sha256 }
  }
}
