// THE FLEET TIMER STILL RUNS A HOST SHELL ONESHOT THAT CALLS devboot_serve_once_entry. Modeled skip-if-produced and client reuse now live in build.dag; the outer belt loop remains host scaffolding until systemd oneshot+timer is enrolled from serve.dag.
data devboot_fleet_shell_loop_scaffold: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.devboot.serve",
    decl_name: "devboot_serve_once_entry",
    field: WholeDeclaration,
  }
}

