module gunbc.devboot.fleet_proof_receipt

import std.types { String, NonEmptyStr, Int }
import std.content_hash { Sha256Digest, sha256_hex_digest }
import std.disposition { Disposition, Scaffold, SingleAuthority }
import std.decl_ref { DeclarationRef, WholeDeclaration }

// TRANSCRIPTION WITH PROVENANCE of the two-client fleet proof independently verified on srv1/srv2 (witty-raven-412 verification msg_123b5569, 2026-08-09). Host-local /tmp artifacts are ephemeral; these rows are the durable copy.
type DevbootFleetProofRunProvenance {
  verified_at: NonEmptyStr
  verifying_session: NonEmptyStr
  branch: NonEmptyStr
  merge_commit: NonEmptyStr
  note: String
}

data devboot_fleet_proof_run_provenance: DevbootFleetProofRunProvenance = DevbootFleetProofRunProvenance {
  verified_at: "2026-08-09T17:18:44Z" as NonEmptyStr,
  verifying_session: "session/keen-moth-104" as NonEmptyStr,
  branch: "session/keen-moth-104" as NonEmptyStr,
  merge_commit: "69d07ed69d3" as NonEmptyStr,
  note: "Proof executed against fleet corpus at 7839285a0a (local fleet checkout); mechanism now on published main via #8049. Re-run from origin/main required for evaluated_head alignment — tracked on #8078.",
}

data devboot_fleet_proof_transcription_scaffold: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.devboot.fleet_proof_receipt",
    decl_name: "devboot_fleet_proof_rows",
    field: WholeDeclaration,
  }
}

