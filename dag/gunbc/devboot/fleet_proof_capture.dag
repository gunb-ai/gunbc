module gunbc.devboot.fleet_proof_capture

import extdeps.filesystem.filesystem_io
import std.types { String, CommitSha, NonEmptyStr }
import gunbc.devboot.fleet_proof_harvest { DevbootFleetProofHarvestBundle }

// PATHS TO OBSERVATION BYTES ON DISK — not pasted prose. A capture step (fleet script or host-effect read) writes these files; harvest reads them.
type DevbootFleetProofObservationSites {
  corpus_head: CommitSha
  mechanism_branch: NonEmptyStr
  transport_endpoint: String
  artifact_object_id: NonEmptyStr
  srv1_client_receipt_path: String
  srv2_client_receipt_path: String
  modeled_serve_log_path: String
  store_for_each_ref_path: String
}

fn read_observation_file(path: String) -> String {
  filesystem_read(path: path).content
}

fn capture_fleet_proof_harvest_bundle(sites: DevbootFleetProofObservationSites) -> DevbootFleetProofHarvestBundle {
  DevbootFleetProofHarvestBundle {
    corpus_head: sites.corpus_head,
    mechanism_branch: sites.mechanism_branch,
    transport_endpoint: sites.transport_endpoint,
    artifact_object_id: sites.artifact_object_id,
    srv1_client_receipt: read_observation_file(path: sites.srv1_client_receipt_path),
    srv2_client_receipt: read_observation_file(path: sites.srv2_client_receipt_path),
    modeled_serve_log: read_observation_file(path: sites.modeled_serve_log_path),
    store_for_each_ref: read_observation_file(path: sites.store_for_each_ref_path),
  }
}

