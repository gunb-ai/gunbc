module gunbc.devboot.serve

import std.types { String, Bool, List, NonEmptyStr }
import std.measure { Second, second, second_count }

import extdeps.gunbc
import extdeps.git { git_ref_missing_exit_code }
import gunbc.devboot.lease {
  request_ref_namespace,
  produced_ref_namespace,
  content_hash_ref_token,
}
import gunbc.devboot.build {
  ServeReport,
  ServeProduced,
  ServeRefused,
  devboot_serve_request,
  ProducerHome,
  request_ref_of,
  produced_ref_of,
  render_sha256_digest,
}

// THE PRODUCER SIDE OF gunbc build, ONE REQUEST PER INVOCATION. The product path is git-only: a caller pushes a parentless request commit under refs/devboot/request/<token> and polls refs/devboot/produced/<token>. This module is the other half — it observes the store, serves any request that has no answer yet, and exits. A long-running accept loop is deliberately not modeled here; the belt timer pattern (oneshot + OnUnitInactiveSec) is the host seam, because a stuck compile must not hold a process that owns the whole service.
//
// NOTHING HERE NAMES A HOST PATH. repo_root is the bare artifact store (--git-dir), work_root is scratch, and the toolchain homes arrive as parameters exactly as devboot_serve_entry already requires.

data serve_poll_note: String = "Each invocation lists every request ref, skips any whose produced ref already exists, and serves the first pending token it finds. Serving more than one request per tick is unnecessary at this grain — a compile dominates the interval — and trying to drain the whole queue in one shot would let one slow subject block every later request without a typed per-subject refusal escaping."

type RequestRefTokenParse
  = RequestRefTokenParsed { token: String }
  | RequestRefTokenMalformed { ref_name: String, cause: String }

fn drop_request_ref_prefix(ref_name: String) -> String {
  substring(
    s: ref_name,
    start: request_ref_namespace.length(),
    end: ref_name.length(),
  )
}

// EXACT PREFIX REMOVAL, NOT POSITIONAL SCANNING. A request ref is refs/devboot/request/<token>; indexing split segments at position 2 returns the literal 'request', not the token.
fn token_from_request_ref(ref_name: String) -> RequestRefTokenParse {
  if !starts_with(s: ref_name, prefix: request_ref_namespace) {
    RequestRefTokenMalformed {
      ref_name: ref_name,
      cause: join(["ref name does not begin with ", request_ref_namespace], ""),
    }
  } else {
    let remainder = drop_request_ref_prefix(ref_name: ref_name)
    if remainder == "" {
      RequestRefTokenMalformed {
        ref_name: ref_name,
        cause: "request ref carries no token suffix",
      }
    } else {
      if string_contains(s: remainder, pattern: "/") {
        RequestRefTokenMalformed {
          ref_name: ref_name,
          cause: "request ref token must not contain a nested slash",
        }
      } else {
        RequestRefTokenParsed { token: remainder }
      }
    }
  }
}

type RefLookup
  = RefPresent
  | RefAbsent
  | RefLookupRefused { detail: String }

fn ref_exists(store_root: String, repo_root: String, ref_name: String) -> RefLookup {
  let out = gunbc.WitnessBin.Run(
    workdir: repo_root,
    bin_path: "git",
    args: [concat("--git-dir=", store_root), "rev-parse", "--verify", "--quiet", ref_name],
  )
  if out.success {
    RefPresent
  } else {
    if out.exit_code == git_ref_missing_exit_code {
      RefAbsent
    } else {
      RefLookupRefused { detail: trim(s: out.stderr) }
    }
  }
}

type RequestPendingStatus
  = RequestPending
  | RequestSettled
  | RequestPendingRefused { cause: String }

fn request_pending_status(store_root: String, repo_root: String, token: String) -> RequestPendingStatus {
  match ref_exists(store_root: store_root, repo_root: repo_root, ref_name: request_ref_of(token: token)) {
    RefPresent =>
      match ref_exists(store_root: store_root, repo_root: repo_root, ref_name: produced_ref_of(token: token)) {
        RefPresent => RequestSettled
        RefAbsent => RequestPending
        RefLookupRefused { detail } => RequestPendingRefused { cause: detail }
      }
    RefAbsent => RequestSettled
    RefLookupRefused { detail } => RequestPendingRefused { cause: detail }
  }
}

type RequestListObservation
  = RequestListObserved { tokens: List<String> }
  | RequestListRefused { cause: String }

type PendingTokenAccum
  = PendingTokenAccumOk { tokens: List<String> }
  | PendingTokenAccumRefused { cause: String }

fn accumulate_pending_token(
  acc: PendingTokenAccum,
  store_root: String,
  repo_root: String,
  ref_name: String,
) -> PendingTokenAccum {
  match acc {
    PendingTokenAccumRefused { cause } => acc
    PendingTokenAccumOk { tokens } =>
      match token_from_request_ref(ref_name: ref_name) {
        RequestRefTokenMalformed { ref_name: bad, cause } =>
          PendingTokenAccumRefused {
            cause: join(["malformed request ref ", bad, ": ", cause], ""),
          }
        RequestRefTokenParsed { token } =>
          match request_pending_status(store_root: store_root, repo_root: repo_root, token: token) {
            RequestPending => PendingTokenAccumOk { tokens: concat(tokens, [token]) }
            RequestSettled => PendingTokenAccumOk { tokens: tokens }
            RequestPendingRefused { cause } => PendingTokenAccumRefused { cause: cause }
          }
      }
  }
}

fn pending_tokens_from_ref_lines(
  store_root: String,
  repo_root: String,
  lines: List<String>,
) -> PendingTokenAccum {
  fold(
    lines,
    init: PendingTokenAccumOk { tokens: [] },
    f: (acc, line) =>
      if line == "" {
        acc
      } else {
        accumulate_pending_token(
          acc: acc,
          store_root: store_root,
          repo_root: repo_root,
          ref_name: line,
        )
      },
  )
}

fn list_request_tokens(store_root: String, repo_root: String) -> RequestListObservation {
  let out = gunbc.WitnessBin.Run(
    workdir: repo_root,
    bin_path: "git",
    args: [
      concat("--git-dir=", store_root),
      "for-each-ref",
      "--format=%(refname)",
      request_ref_namespace,
    ],
  )
  if !out.success {
    RequestListRefused { cause: trim(s: out.stderr) }
  } else {
    match pending_tokens_from_ref_lines(
      store_root: store_root,
      repo_root: repo_root,
      lines: split(s: trim(s: out.stdout), sep: "\n"),
    ) {
      PendingTokenAccumRefused { cause } => RequestListRefused { cause: cause }
      PendingTokenAccumOk { tokens } => RequestListObserved { tokens: tokens }
    }
  }
}

type ServeOnceOutcome
  = ServeOnceIdle
  | ServeOnceHandled { report: ServeReport }
  | ServeOnceRefused { detail: String }

fn devboot_serve_once(
  store_root: String,
  repo_root: String,
  work_root: String,
  cargo_bin: String,
  rustup_home: String,
  cargo_home: String,
  build_jobs: String,
) -> ServeOnceOutcome {
  match list_request_tokens(store_root: store_root, repo_root: repo_root) {
    RequestListRefused { cause } => ServeOnceRefused { detail: cause }
    RequestListObserved { tokens } =>
      if is_empty(tokens) {
        ServeOnceIdle
      } else {
        match tokens.first() {
          Absent =>
            ServeOnceRefused {
              detail: "internal error: pending token list was non-empty but had no first element",
            }
          Present { value: token } =>
            ServeOnceHandled {
              report: devboot_serve_request(
                repo_root: store_root,
                work_root: work_root,
                home: ProducerHome {
                  cargo_bin: cargo_bin,
                  rustup_home: rustup_home,
                  cargo_home: cargo_home,
                  build_jobs: build_jobs,
                },
                token: token,
              ),
            }
        }
      }
  }
}

fn render_serve_once(outcome: ServeOnceOutcome) -> String {
  match outcome {
    ServeOnceIdle => "IDLE"
    ServeOnceHandled { report } =>
      match report {
        ServeProduced { token, sha256 } => join(["SERVED ", token, " sha256=", render_sha256_digest(digest: sha256)], "")
        ServeRefused { token, detail } => join(["SERVE-REFUSED ", token, ": ", detail], "")
      }
    ServeOnceRefused { detail } => join(["REFUSED: ", detail], "")
  }
}

// Flat argv entry for systemd oneshot + timer, matching devboot_serve_entry's toolchain parameters.
fn devboot_serve_once_entry(
  store_root: String,
  repo_root: String,
  work_root: String,
  cargo_bin: String,
  rustup_home: String,
  cargo_home: String,
  build_jobs: String,
) -> String {
  render_serve_once(
    outcome: devboot_serve_once(
      store_root: store_root,
      repo_root: repo_root,
      work_root: work_root,
      cargo_bin: cargo_bin,
      rustup_home: rustup_home,
      cargo_home: cargo_home,
      build_jobs: build_jobs,
    ),
  )
}
