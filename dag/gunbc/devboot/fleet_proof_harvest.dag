  artifact_object_id: "bb6463edd3ebdae411755239fa2ae9bcadab23ef" as NonEmptyStr,
  srv1_client_receipt: "BUILT\npath: /tmp/devboot-fleet/out-srv1\nsha256: 976728c5d2029799f1d89843dfdd70c3b3ed132211126d2752ef8af23b5c146e\nproducer_host: srv3\nreused: false\nexecuted_exit: 0\nexecuted_stdout: A causal compiler: write .dag, get Rust/Python/Go.\nsubject:\ndevboot.subject.v1\ntree=918953e9eb1ccbc60e6b91f64d5612a0fffd4871\npackage=v1-compiler\ntarget=bin:gunbc\ntoolchain.name=rustc\ntoolchain.version=1.93.0\narch=arch.v1.aarch64\nvendor=vendor.v1.unknown\nos=os.v1.linux\nabi=abi.v1.gnu\nprofile=release\nplatform_c_library=glibc-2.39\nlinker=<absent>\nsysroot=<absent>",
