module gunbc.devboot.vertical_receipt


// THE EXECUTION EVIDENCE FOR THE DEVBOOT VERTICAL, IN ONE TYPED HOME RATHER THAN IN A PULL REQUEST BODY. What ran, at which head, which subject it produced and which bytes came back are facts about an execution; a review comment is not a carrier, and a rendered receipt file committed as text would be prose the substrate cannot read. This module follows gunbc.native_witness_transition_receipt, which exists for the same reason and whose exclusions are copied here deliberately.
//
// WHAT IS DELIBERATELY NOT STORED. No timings. The producer took roughly four minutes and the reusing caller two seconds on one host with a warm cargo target directory, and both numbers are properties of that host at that moment rather than of this service -- a transcribed duration is stale immediately and no oracle in this repository could catch it. The DURABLE claim is the ordering, which is structural: the second caller did not build, because an artifact already existed for its subject. No counts either: two callers and two materializations are the shape of the run, not a measurement to ratchet, and a stored integer beside them would be a second representation of what the identities below already say.
//
// WHAT IS STORED IS IDENTITY, because identity is what stays true. The subject ref token, the artifact object id and the artifact's sha256 are exactly reproducible from the same tree at the same settings, and they are what a later reader needs in order to check this claim rather than believe it.
type DevbootVerticalReceipt {
  evaluated_head: std.types.CommitSha
  subject_ref_token: std.types.NonEmptyStr
  artifact_object_id: std.types.NonEmptyStr
  artifact_sha256: std.content_hash.Sha256Digest
  producer_entry: std.decl_ref.DeclarationRef
  consumer_entry: std.decl_ref.DeclarationRef
}

// THE STANDING IS DERIVED, AND IT DELIBERATELY REPORTS THE WEAKER CLAIM. This vertical ran once, by hand, through the ordinary CLI. Nothing in the floor executes it, no cadence schedules it, and a cargo build of this size could not sit on a per-PR path without blowing the witness cost budget -- so the honest standing is manual execution, not enrolled coverage.
//
// Saying so structurally matters more than saying it in prose. A receipt that merely recorded success would read, to anyone scanning for coverage, exactly like a receipt backed by something that re-runs -- the rung inflation DESIGN section 4b names, where a class is described at a rung above the one its evidence establishes. Here the arm itself carries the absence, so a consumer asking whether this behaviour is continuously exercised receives no.
//
// BOTH ARMS ARE ADMISSIBLE. Manual execution is real evidence: the binaries were built, stored, fetched, verified and run. It is simply not evidence that they still are, and the two must not be spelled the same way.
//
// dissolve-on: an enrolled consumer on a cadence that can afford a real build -- the same lane as the witness cost envelope. At that point the second arm gains its inhabitant and cites the consumer that produces it.
type DevbootVerticalStanding
  = VerticalExecutedManuallyOnce
  | VerticalExecutedUnderEnrolledConsumer { consumer: std.decl_ref.DeclarationRef }

fn devboot_vertical_standing() -> DevbootVerticalStanding {
  VerticalExecutedManuallyOnce
}

// THE PREVIOUS INHABITANT WAS RETRACTED, and this one replaces it after the defect it exposed was repaired. The retracted receipt recorded artifact bc16ab0c as built from its named tree; it was not built at all. The cargo invocation asked for --package gunbc, which names no package in this workspace -- gunbc is a BIN inside v1-compiler -- so every build refused, and the bytes stored were the developer ambient target output from an unrelated earlier build.
//
// EVERY DOWNSTREAM CHECK PASSED ANYWAY, which is the part worth carrying forward. The sha256 was genuinely computed over the fetched bytes and genuinely matched; the consumers really did materialize and execute a working binary. An independent digest proves the bytes you fetched are the bytes that were stored, and says nothing about whether the right thing was stored. Production and retrieval are separate claims and the earlier receipt conflated them.
//
// WHAT IS AND IS NOT REPRODUCIBLE HERE, stated because the subject axis is a dirty-worktree snapshot. The artifact object id and its sha256 are reproducible by anyone building these crate sources with this toolchain -- they are facts about the output. The SUBJECT TOKEN is not: it names a tree containing uncommitted working-tree state that existed on one machine at one moment, so no other party can recompute it, and the evaluated head only locates the committed part of it. That is a property of building what an agent is looking at rather than what it has committed, and the token is carried as the identity the run actually used, not as something a reader can independently derive.
//
// THIS INHABITANT IS FROM AN ISOLATED BUILD. The snapshot tree was checked out into its own directory, compiled there with its own target root, and the resulting binary hashed from that isolated output -- so no ambient artifact could have supplied the bytes. The identity is exactly reproducible from the same tree at the same settings, which is what makes this checkable rather than believable.

fn devboot_vertical_receipt() -> DevbootVerticalReceipt? {
  match sha256_hex_digest(hex: "5af0bd8e23a794a5edea9d8cd8d4d0b533b0feab00196ce54c32e83f3339e48e") {
    Absent => none
    Present { value: digest } =>
      Present {
        value: DevbootVerticalReceipt {
          evaluated_head: "eb38c7b704",
          subject_ref_token: "fnv1a64-9c6ddff3327a5dd3" as std.types.NonEmptyStr,
          artifact_object_id: "e503761a12f3d9c0e7d4364e8bfb094ab0bddf6a" as std.types.NonEmptyStr,
          artifact_sha256: digest,
          producer_entry: std.decl_ref.DeclarationRef {
            module_path: "gunbc.devboot.produce",
            decl_name: "devboot_produce_entry",
            field: WholeDeclaration,
          },
          consumer_entry: std.decl_ref.DeclarationRef {
            module_path: "gunbc.devboot.produce",
            decl_name: "devboot_materialize",
            field: WholeDeclaration,
          },
        },
      }
  }
}
