data devboot_produce_note: String = "THE PRODUCER, AND IT IS THE LIVE PATH RATHER THAN A WITNESS. This module is invoked through `gunbc run`, so the first consumer of the identity carriers is the ordinary CLI surface -- a witness suite proving the same functions in isolation would not have established that anything is ever actually built or retrieved.\\n\\nEVERY HOST PATH ARRIVES AS A PARAMETER. The store root is supplied by the caller, never spelled here: on srv1 the deploy supplies the gunbc.host_layout row, and a local run supplies a scratch directory. A literal here would be the layout-admission defect this vertical was explicitly told not to repeat, and it would also make the producer untestable anywhere but one host.\\n\\nTHE ORDER IS THE CONTRACT. Look for an existing artifact first, and only if none exists take the lease and build -- so a subject already produced never builds again, which is the product sentence this service exists to satisfy. The lease is taken with git's exact-value ref update, whose create-only form refuses when the ref already exists, so two callers racing the same subject cannot both become producers."

data producer_lease_realization_note: String = "THE MODELED TRANSITION AND THE REAL ONE, kept honestly apart. gunbc.devboot.lease derives the lease DECISION from the upstream object store's pure transition model, whose exact-old form covers advancing a ref that already exists and returns LeaseCreateNotModeled for the absent case.\\n\\nGit itself does cover that case -- `update-ref <ref> <new> \\\"\\\"` is create-only and fails with 'reference already exists' when it loses -- and that is what this realization calls, verified by execution against a real bare repository: one caller acquired, the second was refused, and the holder did not move. So the gap is in the R0 MODEL, not in the transport, and the refusal arm in the model is a statement about what has been modeled rather than about what git can do. Recording which is which is the whole point; the arm dissolves when the model gains a create-only transition, and the realization does not change when it does."

fn devboot_subject_tree_oid_argv(index_path: String) -> List<String> {
  [concat("GIT_INDEX_FILE=", index_path), "git", "write-tree"]
}

data observed_toolchain_note: String = "THE TOOLCHAIN AND HOST ARE OBSERVED, NOT ASSERTED, and the previous revision asserting them was a live false share rather than a tidiness problem. It declared the toolchain as rustup 1.89.0 and the host as x86_64-unknown-linux-gnu. Measured on the machine that actually ran it: rustc 1.93.0, host aarch64-unknown-linux-gnu. Both hardcoded values were simply wrong.\\n\\nEACH ERROR HAD ITS OWN FAILURE. A fixed toolchain version means upgrading the compiler does not change the subject digest, so the same tree after a rustc upgrade REUSES the binary the old compiler built -- forever, because nothing about the identity ever moves. A fixed host triple is worse: the digest claimed x86_64 while the stored artifact was an aarch64 binary, so a genuine x86_64 consumer fetching that digest would receive something its machine cannot execute, with every identity check agreeing.\\n\\nSo both are read from the toolchain that is about to do the work. The triple is parsed through the cited Rust spelling in extdeps.rust.target_triple, which is partial and refuses anything it does not publish -- an unrecognized host refuses rather than being assembled from parts, because a triple composed by concatenation looks plausible for combinations Rust does not support."

type ObservedToolchain
  = ToolchainObserved { toolchain: ToolchainRequirement, host: TargetTriple }
  | ToolchainObservationRefused { detail: String }

fn second_field(text: String) -> String {
  fold(
    split(s: text, sep: " "),
    init: FieldScan { index: 0, found: "" },
    f: (acc, part) => scan_field(acc: acc, part: part, wanted: 1),
  ).found
}

type FieldScan {
  index: Int
  found: String
}

fn scan_field(acc: FieldScan, part: String, wanted: Int) -> FieldScan {
  if acc.index == wanted {
    FieldScan { index: acc.index + 1, found: part }
  } else {
    FieldScan { index: acc.index + 1, found: acc.found }
  }
}

fn observe_toolchain(repo_root: String) -> ObservedToolchain {
  let version_out = gunbc.WitnessBin.Run(
    workdir: repo_root,
    bin_path: "rustc",
    args: ["--version"],
  )
  let host_out = gunbc.WitnessBin.Run(
    workdir: repo_root,
    bin_path: "rustc",
    args: ["-vV"],
  )
  if !version_out.success {
    ToolchainObservationRefused { detail: "rustc --version could not be read" }
  } else {
    if !host_out.success {
      ToolchainObservationRefused { detail: "rustc -vV could not be read" }
    } else {
      observe_toolchain_from_text(
        version_text: trim(s: version_out.stdout),
        verbose_text: host_out.stdout,
      )
    }
  }
}

fn host_line_triple(verbose_text: String) -> String {
  fold(
    split(s: verbose_text, sep: "\n"),
    init: "",
    f: (acc, line) =>
      if starts_with(s: trim(s: line), prefix: "host: ") {
        trim(s: second_field(text: trim(s: line)))
      } else {
        acc
      },
  )
}

fn observe_toolchain_from_text(version_text: String, verbose_text: String) -> ObservedToolchain {
  let version = second_field(text: version_text)
  let host_spelling = host_line_triple(verbose_text: verbose_text)
  if version == "" {
    ToolchainObservationRefused { detail: concat("could not read a version out of: ", version_text) }
  } else {
    match parse_rust_target_triple(spelling: host_spelling) {
      Absent =>
        ToolchainObservationRefused {
          detail: join(["this host reports the target triple ", host_spelling, ", which extdeps.rust.target_triple does not publish a row for"], ""),
        }
      Present { value: triple } =>
        ToolchainObserved {
          toolchain: ToolchainRequirement { name: "rustc" as NonEmptyStr, version: version as NonEmptyStr },
          host: triple,
        }
    }
  }
}

data devboot_produce_report_note: String = "The report is a rendered String because `gunbc run` prints a value and a caller reads it; the TYPED outcome is what the carriers hold, and this rendering is a projection of it rather than a second representation. It names the subject digest, the decision taken, and the artifact address, which is exactly what a caller needs to fetch."

data store_bootstrap_note: String = "THE SERVICE MAKES THE STORE A REPOSITORY, which until now only the deploy note claimed. The split is stated there and is forced by the privilege boundary: the deploy principal's sudo roster does not grant git, so the deploy can ensure the directory and nothing more, and the account that owns it must do the rest. That left the second half of the sentence unimplemented -- every deploy note said the service initializes the store while the producer's first store touch was a ref lookup against a directory that was not yet a repository.\\n\\nIt failed closed rather than silently, because git refuses a --git-dir that is not a repository and the lookup's own three-valued arm surfaces that as a store deficit. So this is not a repaired fail-open; it is a bootstrap step that the carrier promised and the realization omitted, which meant a freshly deployed host could not reach the ordinary path without someone running git init by hand. A capsule claiming the vertical executes on the ordinary CLI path cannot depend on an out-of-band step.\\n\\ninit --bare IS IDEMPOTENT BY UPSTREAM CONTRACT -- re-running it on an existing repository reinitializes metadata and touches neither refs nor objects -- so it runs on every produce rather than being guarded by an existence check. A check would be a second, weaker representation of a property git already guarantees, and it would introduce the gap between observing and acting that this module removes everywhere else.\\n\\nIT DOES NOT CREATE THE PARENT. If /var/lib/gunbc is absent the init fails and this refuses, which is the correct outcome: the parent is the deploy's responsibility, and silently creating a store outside the ensured location would produce artifacts nobody is converging and nobody would find."

type StoreReadiness
  = StoreReady
  | StoreInitRefused { detail: String }

fn ensure_store_repository(store_root: String, repo_root: String) -> StoreReadiness {
  let init = gunbc.WitnessBin.Run(
    workdir: repo_root,
    bin_path: "git",
    args: ["init", "--bare", "--quiet", store_root],
  )
  if init.success {
    StoreReady
  } else {
    StoreInitRefused {
      detail: join(["artifact store could not be initialized at ", store_root, " (git exit ", to_string(init.exit_code), "): ", trim(s: init.stderr)], ""),
    }
  }
}

fn devboot_produce_report(store_root: String, repo_root: String, index_path: String, caller: String) -> ProduceReport {
  match ensure_store_repository(store_root: store_root, repo_root: repo_root) {
    StoreInitRefused { detail } => ProduceRefused { reason: detail }
    StoreReady =>
      devboot_produce_in_ready_store(
        store_root: store_root,
        repo_root: repo_root,
        index_path: index_path,
        caller: caller,
      )
  }
}

fn devboot_produce_in_ready_store(store_root: String, repo_root: String, index_path: String, caller: String) -> ProduceReport {
  let tree_out = gunbc.WitnessBin.Run(
    workdir: repo_root,
    bin_path: "env",
    args: devboot_subject_tree_oid_argv(index_path: index_path),
    expect: ExpectSuccess,
  )
  let tree_hex = trim(s: tree_out.stdout)
  match observe_toolchain(repo_root: repo_root) {
    ToolchainObservationRefused { detail } => ProduceRefused { reason: detail }
    ToolchainObserved { toolchain, host } =>
      devboot_produce_with_toolchain(
        store_root: store_root,
        repo_root: repo_root,
        caller: caller,
        tree_hex: tree_hex,
        toolchain: toolchain,
        host: host,
      )
  }
}

fn devboot_produce_with_toolchain(
  store_root: String,
  repo_root: String,
  caller: String,
  tree_hex: String,
  toolchain: ToolchainRequirement,
  host: TargetTriple,
) -> ProduceReport {
  match git_object_id_from_untagged_hex(hex: tree_hex) {
    Absent => ProduceRefused { reason: concat("unusable tree oid from git write-tree: ", tree_hex) }
    Present { value: tree_oid } =>
      match admit_build_subject(
        tree_oid: tree_oid,
        package: "gunbc",
        cargo_target: Bin { name: "gunbc" },
        toolchain: toolchain,
        target: host,
        profile: "release",
        features: [],
        rustflags: [],
        linker: none,
        sysroot: none,
        cargo_config: [],
      ) {
        SubjectRefused { cause } =>
          ProduceRefused { reason: build_subject_refusal_reason(cause: cause) }
        SubjectAdmitted { subject } =>
          devboot_produce_admitted(
            store_root: store_root,
            repo_root: repo_root,
            caller: caller,
            host: host,
            subject: subject,
            token: content_hash_ref_token(hash: build_subject_digest(subject: subject)),
          )
      }
  }
}

data subject_ref_namespace: String = "refs/devboot/subject/"

data ref_namespace_single_authority_note: String = "THE NAMESPACES ARE CONSUMED, NOT RESPELLED. An earlier revision wrote the two ref prefixes as literals here while gunbc.devboot.lease already declared them, so one fact had two spellings that could drift apart independently -- and the drift would not have been loud. A producer writing under refs/devboot/artifact/ while the lease module looked under a renamed prefix would simply never find an existing artifact: every request would rebuild, the dedup this service exists to provide would be silently gone, and every individual run would still look correct.\\n\\nThese functions now append the token to the imported namespaces, so there is one authority for where a subject lives in the store and a rename reaches both readers at once."

data admission_refusal_rendering_note: String = "THE TYPED CAUSE SURVIVES TO THE CALLER. An earlier revision matched SubjectRefused and threw the cause away, rendering every admission failure as the same sentence -- so a duplicate feature, an empty profile and an empty package name were indistinguishable to whoever had to fix one. That is the located half of a located refusal discarded at the last step, in a module whose whole subject is that refusals carry their reason.\\n\\nThe match below is total, so a new refusal cause cannot inherit a generic sentence by omission."

fn build_subject_refusal_reason(cause: BuildSubjectRefusalCause) -> String {
  match cause {
    FeatureNameEmpty => "a requested feature name was empty"
    DuplicateFeature { name } => concat("a feature was requested twice: ", name)
    ProfileNameEmpty => "the requested cargo profile was empty"
    PackageNameEmpty => "the requested package name was empty"
    RustflagEmpty => "a requested rustflag was empty"
    CargoConfigKeyEmpty => "a requested cargo config entry had an empty key"
    LinkerEmpty => "the requested linker was empty"
    SysrootEmpty => "the requested sysroot was empty"
  }
}

fn artifact_ref_of(token: String) -> String {
  concat(artifact_ref_namespace, token)
}

fn subject_ref_of(token: String) -> String {
  concat(subject_ref_namespace, token)
}

fn lease_ref_of(token: String) -> String {
  concat(lease_ref_namespace, token)
}

data artifact_lookup_note: String = "THE LOOKUP IS THREE-VALUED, because two of its outcomes mean opposite things and the third means neither. A ref that is absent is the ordinary first-time subject and the correct response is to build. A store that could not be read at all -- a wrong --git-dir, a corrupt repository -- is a deficit, and building would answer it by producing a second artifact nobody can find, then storing it in the same unreadable place.\\n\\nAn earlier revision branched on success alone, so both landed in the build arm. Review judged that acceptable on the grounds that a broken store would red at the very next git call against the same --git-dir, which is true and is why it was not a silent widen. It is still the wrong shape: it makes correctness depend on a LATER step failing rather than on this step answering honestly, and the distinction costs one exit code to keep.\\n\\nGit supplies it directly: `rev-parse --verify --quiet` exits 1 for a ref that is not there and 128 for a repository it could not use. So absence is read from the arm git reserves for absence, and everything else refuses with the store's own message attached."

type ArtifactLookup
  = ArtifactRefPresent { oid: String }
  | ArtifactRefAbsent
  | ArtifactLookupRefused { detail: String }

fn ref_lookup(store_root: String, repo_root: String, ref_name: String) -> ArtifactLookup {
  let existing = gunbc.WitnessBin.Run(
    workdir: repo_root,
    bin_path: "git",
    args: [concat("--git-dir=", store_root), "rev-parse", "--verify", "--quiet", ref_name],
  )
  if existing.success {
    ArtifactRefPresent { oid: trim(s: existing.stdout) }
  } else {
    if existing.exit_code == git_ref_missing_exit_code {
      ArtifactRefAbsent
    } else {
      ArtifactLookupRefused {
        detail: join(["artifact store unreadable (git exit ", to_string(existing.exit_code), "): ", trim(s: existing.stderr)], ""),
      }
    }
  }
}

fn artifact_lookup(store_root: String, repo_root: String, token: String) -> ArtifactLookup {
  ref_lookup(store_root: store_root, repo_root: repo_root, ref_name: artifact_ref_of(token: token))
}

data live_reuse_law_note: String = "THE LIVE PATH DECIDES REUSE THROUGH THE SAME FOLD THE MODEL DEFINES, which it did not before. An earlier revision reused on artifact-ref PRESENCE alone: the ref existed, so the bytes were served. The reuse law this capsule introduced -- retrieve the stored request, compare it exactly, confirm the bytes are there -- was stated in gunbc.devboot.outcome and exercised by witnesses, while the code that actually answered callers never called it. A model and its realization disagreeing about the model own central law is the fork this repository treats as a correctness defect, and the witnesses could not have caught it because they tested the fold rather than the path.\\n\\nWHAT MAKES THE COMPARISON POSSIBLE is that the producer now stores the rendered subject beside the artifact, under its own ref. On reuse, that text is read back and compared with the rendering of the request; the rendering is injective, so equal text means equal subjects. Bytes are then confirmed present in the object database before anything is served. A digest collision therefore costs a rebuild instead of a wrong binary, and a pruned object refuses instead of being reported as retrievable -- both on the live path, not only in the model."

fn stored_record_text(store_root: String, repo_root: String, token: String) -> String {
  let stored = gunbc.WitnessBin.Run(
    workdir: repo_root,
    bin_path: "git",
    args: [concat("--git-dir=", store_root), "cat-file", "blob", subject_ref_of(token: token)],
  )
  if stored.success { stored.stdout } else { "" }
}

fn stored_subject_match(record_text: String, subject: BuildSubject) -> SubjectMatch {
  if record_text == "" {
    SubjectDiffers
  } else {
    if starts_with(s: record_text, prefix: render_build_subject(subject: subject)) {
      SubjectMatches
    } else {
      SubjectDiffers
    }
  }
}

data unpack_temp_file_note: String = "THE TEMPORARY FILE IS REMOVED, because git unpack-file writes it into the CURRENT DIRECTORY and the current directory here is the repository whose tree oid is this service's identity axis. Leaving them behind litters the working tree with one file per verification -- the same class as the lease claim file that was written into the repo root, caught the same way, by looking at git status after a run.\\n\\nIt does not change the subject today, because the index this producer writes its tree from is read from HEAD rather than from the working directory, so untracked files are invisible to it. That is a property of how the subject is computed, not a licence to leave debris in someone else's checkout."

data availability_is_measured_note: String = "AVAILABILITY IS MEASURED, NOT ASSUMED, and that is why this costs a read. The available arm carries a StoredArtifact, and there is no way to inhabit it without the observation that produced it -- so confirming a ref exists is not enough, and constructing an artifact record with an invented digest to satisfy the type would be precisely the fabrication the carrier exists to prevent.\\n\\nSo the bytes are fetched and their sha256 computed over the fetched file, whose preimage is the content alone. That digest is then checked against the one the record stored at production time: equal means available, different means CORRUPT rather than missing, because bytes that are present and wrong are an integrity failure and must never be retried as though they were a cache miss.\\n\\nThe cost is one read of the artifact on the reuse path. That is the honest price of the contract this vertical was given -- a reuse that skipped it would be reporting retrievability it had not established, which is the one thing there is no arm for."

fn observed_artifact_sha256(store_root: String, repo_root: String, oid: String) -> String {
  let unpacked = gunbc.WitnessBin.Run(
    workdir: repo_root,
    bin_path: "git",
    args: [concat("--git-dir=", store_root), "unpack-file", oid],
  )
  if !unpacked.success {
    ""
  } else {
    let temp_name = trim(s: unpacked.stdout)
    let digest = gunbc.WitnessBin.Run(
      workdir: repo_root,
      bin_path: "sha256sum",
      args: [temp_name],
    )
    let removed = gunbc.WitnessBin.Run(
      workdir: repo_root,
      bin_path: "rm",
      args: ["-f", temp_name],
    )
    if digest.success { first_field(text: trim(s: digest.stdout)) } else { "" }
  }
}

fn observe_artifact_availability(
  store_root: String,
  repo_root: String,
  oid: String,
  record_text: String,
  subject: BuildSubject,
) -> ArtifactAvailability {
  let present = gunbc.WitnessBin.Run(
    workdir: repo_root,
    bin_path: "git",
    args: [concat("--git-dir=", store_root), "cat-file", "-e", oid],
  )
  if !present.success {
    ArtifactMissing
  } else {
    let observed = observed_artifact_sha256(store_root: store_root, repo_root: repo_root, oid: oid)
    if observed == "" {
      ArtifactUnreadable { detail: "the artifact blob could not be read back for verification" }
    } else {
      if string_contains(s: record_text, pattern: sha256_record_marker(hex: observed)) {
        observed_stored_artifact(
          subject: subject,
          oid: oid,
          sha256_hex: observed,
          bytes_text: trim(s: gunbc.WitnessBin.Run(
            workdir: repo_root,
            bin_path: "git",
            args: [concat("--git-dir=", store_root), "cat-file", "-s", oid],
          ).stdout),
        )
      } else {
        ArtifactUnreadable {
          detail: "the artifact bytes do not match the sha256 recorded when they were produced",
        }
      }
    }
  }
}

data sha256_record_line_note: String = "THE DIGEST LINE IS SPELLED ONCE AND SEARCHED FOR WITHOUT ITS TERMINATOR, which is a distinction the first version got wrong and paid for immediately. The writer emits the line with a trailing newline, because it is a line. The reader must not look for that newline: the command transport returns process stdout with the trailing newline stripped, so a record whose last line is the digest comes back WITHOUT it, and a search including the terminator never matches.\\n\\nThe symptom was worth the lesson -- a correctly produced and correctly stored artifact was refused on reuse as though its bytes were unretrievable, which is a false refusal rather than a false share, so it fails safe. It still had to be found by running it, because both halves looked right in isolation and only disagreed at the seam.\\n\\nBoth forms come from one marker so the writer and the reader cannot drift apart; only the terminator differs, and it differs for a stated reason."

fn sha256_record_marker(hex: String) -> String {
  concat("artifact.sha256=", hex)
}

fn sha256_record_line(hex: String) -> String {
  join([sha256_record_marker(hex: hex), "\n"], "")
}

data observed_stored_artifact_note: String = "EVERY FIELD IS MEASURED OR THE OBSERVATION REFUSES. A first draft of this function filled the byte count with zero and the subject digest with a hash of the object id, purely so the record would typecheck -- two invented values wearing the shape of measurements, which is the fabrication this whole carrier exists to make impossible, committed in the act of satisfying it.\\n\\nNow the subject digest is the digest of the subject actually requested, the blob id is the address the store answered to, the sha256 is computed over the fetched bytes, and the size comes from the store. Anything that cannot be established refuses through the availability sum instead of being supplied."

fn observed_stored_artifact(
  subject: BuildSubject,
  oid: String,
  sha256_hex: String,
  bytes_text: String,
) -> ArtifactAvailability {
  match git_object_id_from_untagged_hex(hex: oid) {
    Absent => ArtifactUnreadable { detail: concat("the store returned an unusable object id: ", oid) }
    Present { value: blob } =>
      match sha256_hex_digest(hex: sha256_hex) {
        Absent => ArtifactUnreadable { detail: concat("the observed digest is not a sha256: ", sha256_hex) }
        Present { value: digest } =>
          ArtifactAvailable {
            artifact: StoredArtifact {
              subject_digest: build_subject_digest(subject: subject),
              blob_oid: blob,
              sha256: digest,
              bytes: byte_size(count: parse_int(bytes_text)),
            },
          }
      }
  }
}

fn devboot_produce_admitted(store_root: String, repo_root: String, caller: String, host: TargetTriple, subject: BuildSubject, token: String) -> ProduceReport {
  match artifact_lookup(store_root: store_root, repo_root: repo_root, token: token) {
    ArtifactLookupRefused { detail } => ProduceRefused { reason: detail }
    ArtifactRefPresent { oid } =>
      live_reuse_report(
        store_root: store_root,
        repo_root: repo_root,
        caller: caller,
        host: host,
        subject: subject,
        token: token,
        oid: oid,
      )
    ArtifactRefAbsent =>
      devboot_produce_build(store_root: store_root, repo_root: repo_root, caller: caller, host: host, subject: subject, token: token)
  }
}

data devboot_lease_then_build_note: String = "THE LEASE IS TAKEN BEFORE THE BUILD, not after, because a lease acquired afterwards would protect nothing -- both callers would already have paid for the same compile, which is the duplicate work this service exists to remove. Losing the lease is reported as an attach rather than as a failure: the subject IS being produced, and the correct move for the loser is to wait for the winner's artifact, never to start a second build of the same thing."

data lease_claim_placement_note: String = "THE CLAIM OBJECT IS WRITTEN INTO THE SERVICE'S OWN ROOT, PER SUBJECT, never into the source tree and never at a shared name. A lease claim needs to become a git object and the transport has no stdin, so it goes through a file first.\\n\\nAn earlier revision put that file in the repository root, where it dirtied the very tree whose oid is this service's identity axis -- a producer one careless index operation away from changing the subject it is producing. It then used a single fixed filename inside the store, which removed that problem and introduced a subtler one: two producers working on DIFFERENT subjects share the store, so one could overwrite the other's claim file between the write and the hash, and the bytes a lease ref pointed at could name a caller that never took it. Exactly-one-producer still held -- the compare-and-swap is per subject ref -- but the answer to WHO holds it was unreliable exactly when it matters, under concurrency.\\n\\nThe filename now carries the subject token, so two subjects never contend for one path and the claim always names the producer that wrote it."


data lease_failure_disambiguation_note: String = "LOSING THE RACE AND FAILING TO REACH THE STORE ARE NOT THE SAME EVENT, and git's exit code cannot tell them apart -- measured, both are 128. An earlier revision read any failed update-ref as ATTACHED, which reports a specific and reassuring fact: another producer holds the lease and this caller should wait for its artifact. When the real cause was an unwritable or unreachable store, that is a fabricated plausible output of exactly the kind this vertical refuses everywhere else -- the caller waits for a producer that does not exist, and the deficit is invisible because the answer looked like ordinary healthy contention.\\n\\nTHE DISAMBIGUATION IS STRUCTURAL RATHER THAN TEXTUAL. Matching git's message would be a second, fragile representation of its behaviour, tied to wording no upstream promises to keep. Instead the lease ref is READ BACK: if it now exists, some producer really does hold it and attaching is the truth, with the holder named; if it does not exist, the failure was not a race and the store's own message carries the refusal; if the read-back itself cannot be performed, that refuses too. Git's state answers the question git's exit code could not."

fn lease_failure_report(store_root: String, repo_root: String, token: String, detail: String) -> ProduceReport {
  match ref_lookup(store_root: store_root, repo_root: repo_root, ref_name: lease_ref_of(token: token)) {
    ArtifactRefPresent { oid } => ProduceAttached { token: token }
    ArtifactRefAbsent =>
      ProduceRefused {
        reason: join(["lease could not be taken and no producer holds it: ", detail], ""),
      }
    ArtifactLookupRefused { detail: lookup_detail } => ProduceRefused { reason: lookup_detail }
  }
}

fn devboot_produce_build(store_root: String, repo_root: String, caller: String, host: TargetTriple, subject: BuildSubject, token: String) -> ProduceReport {
  let claim_path = join([store_root, "/devboot-lease-claim-", token], "")
  let claim_written = Filesystem.Write(path: claim_path, content: concat("producer=", caller))

  let claim = gunbc.WitnessBin.Run(
    workdir: repo_root,
    bin_path: "git",
    args: [concat("--git-dir=", store_root), "hash-object", "-w", "--", claim_path],
    expect: ExpectSuccess,
  )
  let claim_oid = trim(s: claim.stdout)
  let taken = gunbc.WitnessBin.Run(
    workdir: repo_root,
    bin_path: "git",
    args: [concat("--git-dir=", store_root), "update-ref", lease_ref_of(token: token), claim_oid, ""],
  )
  if !taken.success {
    lease_failure_report(store_root: store_root, repo_root: repo_root, token: token, detail: trim(s: taken.stderr))
  } else {
    devboot_store_built_artifact(store_root: store_root, repo_root: repo_root, caller: caller, host: host, subject: subject, token: token)
  }
}


data build_plan_note: String = "THE BUILD IS DERIVED FROM THE ADMITTED SUBJECT, and the previous revision's failure to do so was a false share of the exact kind the identity carriers exist to prevent. It computed the subject digest faithfully and then ran a fixed `cargo build --release --bin gunbc` regardless of what had been admitted, so a caller asking for the library, a different binary, a debug profile, a feature set or another target would have received the release CLI STORED UNDER ITS OWN SUBJECT'S DIGEST. Every later reuse would then serve those wrong bytes as an exact match, because the record and the request really would agree -- the wall in gunbc.devboot.outcome compares subjects, and both sides would have been the subject nobody built.\\n\\nSO EVERY AXIS EITHER REACHES THE ARGV OR REFUSES. The product picks the cargo target flag and the artifact filename; the profile picks the flag and the output directory; features become --features. What this producer cannot yet realize faithfully is REFUSED with a located cause rather than silently ignored, which is the difference between a bounded capability and a lie: a refusal costs the caller a build it could not have had anyway, while ignoring the axis costs it correctness.\\n\\ndissolve-on, per axis rather than as one lump: cross-target builds land with the session-ABI capsule, which is precisely a request for a target this host is not; rustflags, linker and sysroot land when the environment is threaded into the invocation as configuration rather than argv."

type BuildPlanRefusalCause
  = CargoTargetNotRealized { detail: String }
  | ProfileNotRealized { profile: String }
  | CrossTargetNotRealized { detail: String }
  | BuildEnvironmentNotRealized { detail: String }

type BuildPlan
  = BuildPlanReady { args: List<String>, artifact_path: String }
  | BuildPlanRefused { cause: BuildPlanRefusalCause }

fn cargo_target_flags(target: CargoTarget) -> List<String> {
  match target {
    Lib => ["--lib"]
    Bin { name } => ["--bin", name]
    CargoTest { name } => []
    Example { name } => ["--example", name]
    Bench { name } => []
  }
}

fn cargo_target_artifact_name(target: CargoTarget) -> String {
  match target {
    Lib => ""
    Bin { name } => name
    CargoTest { name } => ""
    Example { name } => name
    Bench { name } => ""
  }
}

fn features_flags(features: List<NonEmptyStr>) -> List<String> {
  if is_empty(features) {
    []
  } else {
    ["--features", join(features |> map(f => f as String), ",")]
  }
}

fn environment_refusal_detail(environment: BuildEnvironmentSpec) -> String {
  if !is_empty(environment.rustflags) {
    "rustflags are carried in the subject identity but not yet threaded into the invocation"
  } else {
    match environment.linker {
      Present { value: l } => "a linker is carried in the subject identity but not yet threaded into the invocation"
      Absent =>
        match environment.sysroot {
          Present { value: r } => "a sysroot is carried in the subject identity but not yet threaded into the invocation"
          Absent =>
            if !is_empty(environment.cargo_config) {
              "cargo config entries are carried in the subject identity but not yet threaded into the invocation"
            } else {
              ""
            }
        }
    }
  }
}

fn profile_output_dir(profile: String) -> String {
  if profile == "release" { "release" } else { "debug" }
}

fn profile_flags(profile: String) -> List<String> {
  if profile == "release" { ["--release"] } else { [] }
}

fn build_plan_for_subject(subject: BuildSubject, host: TargetTriple) -> BuildPlan {
  let env_detail = environment_refusal_detail(environment: subject.environment)
  let artifact_name = cargo_target_artifact_name(target: subject.product.target)
  let profile = subject.profile as String
  if env_detail != "" {
    BuildPlanRefused { cause: BuildEnvironmentNotRealized { detail: env_detail } }
  } else {
    if !(subject.target == host) {
      BuildPlanRefused {
        cause: CrossTargetNotRealized {
          detail: "the requested target is not this host; cross-target production lands with the session-ABI capsule",
        },
      }
    } else {
      if artifact_name == "" {
        BuildPlanRefused {
          cause: CargoTargetNotRealized {
            detail: "only a named binary or example produces a single retrievable artifact file",
          },
        }
      } else {
        if !(profile == "release" || profile == "dev") {
          BuildPlanRefused { cause: ProfileNotRealized { profile: profile } }
        } else {
          BuildPlanReady {
            args: concat(
              ["build"],
              concat(
                profile_flags(profile: profile),
                concat(
                  ["--package", subject.product.package as String],
                  concat(
                    cargo_target_flags(target: subject.product.target),
                    features_flags(features: subject.features),
                  ),
                ),
              ),
            ),
            artifact_path: join(["target/", profile_output_dir(profile: profile), "/", artifact_name], ""),
          }
        }
      }
    }
  }
}

fn build_plan_refusal_reason(cause: BuildPlanRefusalCause) -> String {
  match cause {
    CargoTargetNotRealized { detail } => detail
    ProfileNotRealized { profile } => concat("unrealized cargo profile: ", profile)
    CrossTargetNotRealized { detail } => detail
    BuildEnvironmentNotRealized { detail } => detail
  }
}

fn devboot_store_built_artifact(store_root: String, repo_root: String, caller: String, host: TargetTriple, subject: BuildSubject, token: String) -> ProduceReport {
  match build_plan_for_subject(subject: subject, host: host) {
    BuildPlanRefused { cause } =>
      ProduceRefused { reason: build_plan_refusal_reason(cause: cause) }
    BuildPlanReady { args, artifact_path } =>
      devboot_run_build_plan(
        store_root: store_root,
        repo_root: repo_root,
        caller: caller,
        subject: subject,
        token: token,
        args: args,
        artifact_path: artifact_path,
      )
  }
}

fn devboot_run_build_plan(
  store_root: String,
  repo_root: String,
  caller: String,
  subject: BuildSubject,
  token: String,
  args: List<String>,
  artifact_path: String,
) -> ProduceReport {
  let built = gunbc.WitnessBin.Run(
    workdir: repo_root,
    bin_path: "cargo",
    args: args,
    expect: ExpectSuccess,
  )
  let stored = gunbc.WitnessBin.Run(
    workdir: repo_root,
    bin_path: "git",
    args: [concat("--git-dir=", store_root), "hash-object", "-w", "--", artifact_path],
    expect: ExpectSuccess,
  )
  let blob_oid = trim(s: stored.stdout)
  let artifact_sha256 = observed_artifact_sha256(store_root: store_root, repo_root: repo_root, oid: blob_oid)
  let record_path = join([store_root, "/devboot-record-", token], "")
  let record_written = Filesystem.Write(
    path: record_path,
    content: join([render_build_subject(subject: subject), sha256_record_line(hex: artifact_sha256)], ""),
  )
  let record_blob = gunbc.WitnessBin.Run(
    workdir: repo_root,
    bin_path: "git",
    args: [concat("--git-dir=", store_root), "hash-object", "-w", "--", record_path],
    expect: ExpectSuccess,
  )
  let record_bound = gunbc.WitnessBin.Run(
    workdir: repo_root,
    bin_path: "git",
    args: [concat("--git-dir=", store_root), "update-ref", subject_ref_of(token: token), trim(s: record_blob.stdout), ""],
    expect: ExpectSuccess,
  )
  let bound = gunbc.WitnessBin.Run(
    workdir: repo_root,
    bin_path: "git",
    args: [concat("--git-dir=", store_root), "update-ref", artifact_ref_of(token: token), blob_oid, ""],
    expect: ExpectSuccess,
  )
  ProduceProduced { token: token, artifact: blob_oid }
}

data devboot_materialize_note: String = "THE CONSUMER SIDE, AND IT VERIFIES INDEPENDENTLY. The bytes are fetched out of the object database by address, and then their sha256 is computed over the fetched file -- a digest whose preimage is the content alone, so the store cannot satisfy it by agreeing with itself. Re-deriving the git oid instead would only re-read the store's own answer and would establish nothing.\\n\\nThe caller compares the reported digest against the one it was promised. This function reports what it measured rather than deciding the comparison, because the promise lives with the requester."

fn devboot_materialize(store_root: String, repo_root: String, artifact_oid: String, out_path: String) -> String {
  let unpacked = gunbc.WitnessBin.Run(
    workdir: repo_root,
    bin_path: "git",
    args: [concat("--git-dir=", store_root), "unpack-file", artifact_oid],
    expect: ExpectSuccess,
  )
  let temp_name = trim(s: unpacked.stdout)
  let moved = gunbc.WitnessBin.Run(
    workdir: repo_root,
    bin_path: "mv",
    args: [temp_name, out_path],
    expect: ExpectSuccess,
  )
  let made_executable = gunbc.WitnessBin.Run(
    workdir: repo_root,
    bin_path: "chmod",
    args: ["+x", out_path],
    expect: ExpectSuccess,
  )
  let digest = gunbc.WitnessBin.Run(
    workdir: repo_root,
    bin_path: "sha256sum",
    args: [out_path],
    expect: ExpectSuccess,
  )
  let executed = gunbc.WitnessBin.Run(
    workdir: repo_root,
    bin_path: out_path,
    args: ["--help"],
    expect: ExpectSuccess,
  )
  join([
    "MATERIALIZED path=", out_path,
    " sha256=", first_field(text: trim(s: digest.stdout)),
    " executed_exit=", to_string(executed.exit_code),
  ], "")
}

data materialize_binary_safety_note: String = "THE BYTES NEVER PASS THROUGH A STRING, and that is a correctness constraint rather than a performance one. An earlier draft of this function read the blob to stdout and wrote that value to a file, which would have routed twenty-four megabytes of executable through a text carrier -- any byte sequence that is not valid UTF-8 would have been mangled, and the corruption would have surfaced as a binary that refuses to execute rather than as an error at the point it happened.\\n\\n`git unpack-file` writes the blob to a temporary file itself and prints only the NAME, so the bytes travel from the object database to the filesystem entirely inside git. Verified by execution: the unpacked file's sha256 equals the built binary's exactly.\\n\\nEXECUTION IS PART OF MATERIALIZING, not a separate check a caller may skip. A digest match proves the bytes arrived; it does not prove they run, and this vertical exists to hand an agent a binary it can actually use. So the last step runs the thing and reports its exit code."

fn first_field(text: String) -> String {
  fold(
    split(s: text, sep: " "),
    init: "",
    f: (acc, part) => if acc == "" { part } else { acc },
  )
}

data produce_report_typing_note: String = "THE ENTRY RETURNS A TYPED OUTCOME, NOT A SENTENCE, and the sentence is derived from it. An earlier revision returned the rendered String directly, which had two consequences worth recording. The harness treats a non-ProcessExit return as a refusal, so a run that had genuinely PRODUCED an artifact exited nonzero and printed the word refused -- a success reported as a failure, which is the reporting half of the same honesty rule this vertical enforces everywhere else. And a caller wanting the artifact address had to parse prose.\\n\\nNow the decision is a closed sum, the sentence is one projection of it, and the exit code is another. A caller reads the receipt file for the address; the shell reads the exit code for the verdict; neither is derived by scraping the other."

type ProduceReport
  = ProduceProduced { token: String, artifact: String }
  | ProduceReused { token: String, artifact: String }
  | ProduceAttached { token: String }
  | ProduceRefused { reason: String }

fn render_produce_report(report: ProduceReport, caller: String) -> String {
  match report {
    ProduceProduced { token, artifact } =>
      join(["PRODUCED subject=", token, " artifact=", artifact, " caller=", caller], "")
    ProduceReused { token, artifact } =>
      join(["REUSED subject=", token, " artifact=", artifact, " caller=", caller], "")
    ProduceAttached { token } =>
      join(["ATTACHED subject=", token, " caller=", caller, " (another producer holds the lease)"], "")
    ProduceRefused { reason } => concat("REFUSED: ", reason)
  }
}

fn produce_report_exit(report: ProduceReport) -> ProcessExit {
  match report {
    ProduceProduced { token, artifact } => ExitSuccess
    ProduceReused { token, artifact } => ExitSuccess
    ProduceAttached { token } => ExitSuccess
    ProduceRefused { reason } => exit_failure(reason: reason)
  }
}

data produce_entry_note: String = "The live entry point. It writes the rendered receipt to a caller-supplied path -- there is no stdout facility in the substrate, so a file is how a result leaves a run -- and returns the exit code the verdict implies. The receipt path is a parameter for the same reason the store root is: a path spelled inside the service is a fact about one host smuggled into a program that runs on many."

fn devboot_produce_entry(
  store_root: String,
  repo_root: String,
  index_path: String,
  caller: String,
  receipt_path: String,
) -> ProcessExit {
  let report = devboot_produce_report(
    store_root: store_root,
    repo_root: repo_root,
    index_path: index_path,
    caller: caller,
  )
  let written = Filesystem.Write(
    path: receipt_path,
    content: render_produce_report(report: report, caller: caller),
  )
  produce_report_exit(report: report)
}

data availability_refusal_rendering_note: String = "THE AVAILABILITY ARM SURVIVES INTO THE MESSAGE. An earlier revision rendered every unavailable outcome as the same sentence about bytes not being retrievable, which flattened the one distinction that matters most here: bytes that are ABSENT are a routine prune and a rebuild fixes them, while bytes that are PRESENT AND WRONG are an integrity failure and rebuilding over them without saying so would bury it. The match is total, so a new availability arm cannot inherit a generic sentence."

fn availability_refusal_reason(availability: ArtifactAvailability) -> String {
  match availability {
    ArtifactAvailable { artifact } => "the artifact is available"
    ArtifactMissing => "the artifact ref exists but its bytes are absent from the store"
    ArtifactCorrupt { expected, observed } => "the artifact bytes do not match their recorded digest"
    ArtifactUnreadable { detail } => detail
  }
}

fn live_reuse_report(
  store_root: String,
  repo_root: String,
  caller: String,
  host: TargetTriple,
  subject: BuildSubject,
  token: String,
  oid: String,
) -> ProduceReport {
  match reuse_decision_from_match(
    candidate_digest: Present { value: build_subject_digest(subject: subject) },
    requested: subject,
    subject_match: stored_subject_match(record_text: stored_record_text(store_root: store_root, repo_root: repo_root, token: token), subject: subject),
    availability: observe_artifact_availability(
      store_root: store_root,
      repo_root: repo_root,
      oid: oid,
      record_text: stored_record_text(store_root: store_root, repo_root: repo_root, token: token),
      subject: subject,
    ),
  ) {
    ReuseGranted { artifact } => ProduceReused { token: token, artifact: oid }
    ReuseNoCandidate =>
      devboot_produce_build(store_root: store_root, repo_root: repo_root, caller: caller, host: host, subject: subject, token: token)
    ReuseSubjectMismatch { candidate_digest, requested_digest } =>
      ProduceRefused {
        reason: "the artifact stored under this subject digest was built for a different subject; refusing to serve it",
      }
    ReuseUnavailable { availability } =>
      ProduceRefused { reason: availability_refusal_reason(availability: availability) }
  }
}
