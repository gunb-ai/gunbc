module gunbc.merge_admission_produce

import std.algebra { trim }

import std.types { NonEmptyStr, CommitSha, String, Int, List, Bool, GitRef }
import std.content_hash {
  serialize_content_hash,
  as_content_hash_structural,
  fnv1a64_structural_hex_digest,
}
import extdeps.git
import extdeps.git.inspect
import extdeps.git.object_store {
  GitObjectId,
  git_object_id_from_untagged_hex,
  git_object_id_wire_hex,
}
import extdeps.github.checks {
  CheckConclusion,
  check_conclusion_wire_label,
  parse_check_conclusion,
  Success,
  Failure,
}
import gunbc.merge_admission {
  MergeAdmissionReceiptV2,
  MergeAdmissionReceipt,
  mint_merge_admission_receipt,
  current_gate_roster_hash,
  GateRosterHash,
  gate_roster_hash_from_structural,
}
import gunbc.merge_admission_subject {
  walk_attempt_id,
  render_git_object_id_wire,
  parse_git_object_id_wire,
  receipt_wire_lines,
}

data merge_admission_receipt_schema: String = "gunbc.merge_admission_receipt.v1"

data merge_admission_receipt_rel_path: String = ".gunbc/merge-admission-receipt.wire"

// v2 -> v3 WITH tested_base_commit_sha, under this module's own wire_exact_arity_note rule below.
// The arity moves 6/7 -> 7/8 in the same step, so a stale v2 wire refuses on its tag rather than
// binding six of its seven required fields and leaving the ancestry operand invented.
data merge_admission_receipt_schema_v2: String = "gunbc.merge_admission_receipt.v3"

data wire_exact_arity_note: String = "BOTH v2 parsers require an EXACT line count, and every required field goes through its domain constructor (review 2026-07-30). The first cut accepted a SUPERSET — `length(lines) >= 5` — so trailing content rode along unread, and it validated only that the schema tag and attempt id were nonempty, leaving base ref, tree, and head SHA free to be empty strings that then bound into a receipt as though observed. Worse, the optional PR line converted a MALFORMED present field into an absent one: parse_int returned Absent on garbage and the receipt parsed clean with pr_number: none, which is the state-space conflation §5 forbids — `not supplied` and `supplied but unreadable` are different facts with different remedies. A seventh line that is not an integer now refuses the whole receipt. Exact arity is what makes a format extension VISIBLE: adding a field means bumping the schema tag, not silently appending a line older readers ignore."
data gate_roster_hash_wire_note: String = "Gate roster hash wire is the serialized fnv1a64 structural fingerprint (16 lowercase hex digits — atom_identity_hash / hash_combine wire form). parse_gate_roster_hash_wire routes through std.content_hash.fnv1a64_structural_hex_digest (exact length plus lowercase-hex syntax) before branding as GateRosterHash; blank, malformed, or wrong-length receipt lines refuse the whole receipt (review 45474). An earlier cut cast arbitrary text to NonEmptyStr via structural_content_hash unchecked."
data receipt_wire_v2_note: String = "Wire v2 is SELF-IDENTIFYING: line 1 is the schema tag, so a v1 wire (positional, no tag) read by the v2 parser refuses on the tag line instead of mis-binding fields by position — and a v2 wire read by the v1 parser mis-parses into a conclusion-line mismatch, also a refusal. Lines: schema, attempt_id, tested_base_tree_hash, gate_roster_hash, conclusion, tested_head_sha, then the optional pr number. The v1 wire, path, and type stay until the entry migration completes and the old consumers delete with the emitter web (add-replacement, never in-place mutation of a live format)."

fn render_receipt_wire_v2(receipt: MergeAdmissionReceiptV2) -> String {
  let core = join([
    merge_admission_receipt_schema_v2,
    receipt.attempt_id as String,
    render_git_object_id_wire(oid: receipt.tested_base_tree_hash),
    render_gate_roster_hash_wire(hash: receipt.gate_roster_hash),
    check_conclusion_wire_label(c: receipt.conclusion),
    receipt.tested_head_sha,
    receipt.tested_base_commit_sha,
  ], "\n")
  match receipt.pr_number {
    Present { value: n } => concat(core, concat("
", to_string(n)))
    Absent => core
  }
}

data wire_pr_number_three_states_note: String = "THREE states, named, because two of them are not the same absence: no seventh line at all (the receipt legitimately carries no PR number), a seventh line that parses, and a seventh line that does not. An Optional<Optional<Int>> would spell this with two Absents meaning different things — the state-space conflation DESIGN's failure list names — and the language refuses the spelling anyway, since `??` is the null-coalesce operator token and cannot appear in type position. WirePrMalformed is what makes the whole receipt refuse instead of quietly becoming a receipt with no PR number."

type ReceiptWirePrNumber
  = WirePrAbsent
  | WirePrPresent { value: Int }
  | WirePrMalformed

fn receipt_wire_v2_pr_number(lines: List<String>) -> ReceiptWirePrNumber {
  if length(lines) == 7 {
    WirePrAbsent
  } else {
    match parse_int(s: lines.skip(n: 7).first()) {
      Present { value: n } => WirePrPresent { value: n }
      Absent => WirePrMalformed
    }
  }
}

fn parse_receipt_wire_v2(text: String) -> MergeAdmissionReceiptV2? {
  let lines = receipt_wire_lines(text: text)
  if !((length(lines) == 7) || (length(lines) == 8)) {
    none
  } else if !(lines.first() == merge_admission_receipt_schema_v2) {
    none
  } else if lines.skip(n: 3).first() == "" {
    none
  } else if lines.skip(n: 5).first() == "" {
    none
  } else if lines.skip(n: 6).first() == "" {
    none
  } else {
    match walk_attempt_id(raw: lines.skip(n: 1).first()) {
      Absent => none
      Present { value: attempt } =>
        match parse_git_object_id_wire(raw: lines.skip(n: 2).first()) {
          Absent => none
          Present { value: tree } =>
            match parse_check_conclusion(raw: lines.skip(n: 4).first()) {
              Absent => none
              Present { value: conclusion } =>
                match parse_gate_roster_hash_wire(line: lines.skip(n: 3).first()) {
                  Absent => none
                  Present { value: gate_roster_hash } =>
                    match receipt_wire_v2_pr_number(lines: lines) {
                      WirePrMalformed => none
                      WirePrAbsent =>
                        Present {
                          value: MergeAdmissionReceiptV2 {
                            attempt_id: attempt,
                            pr_number: none,
                            tested_head_sha: lines.skip(n: 5).first(),
                            tested_base_tree_hash: tree,
                            tested_base_commit_sha: lines.skip(n: 6).first(),
                            gate_roster_hash: gate_roster_hash,
                            conclusion: conclusion,
                          }
                        }
                      WirePrPresent { value: n } =>
                        Present {
                          value: MergeAdmissionReceiptV2 {
                            attempt_id: attempt,
                            pr_number: Present { value: n },
                            tested_head_sha: lines.skip(n: 5).first(),
                            tested_base_tree_hash: tree,
                            tested_base_commit_sha: lines.skip(n: 6).first(),
                            gate_roster_hash: gate_roster_hash,
                            conclusion: conclusion,
                          }
                        }
                    }
                }
            }
        }
    }
  }
}

fn merge_admission_receipt_path(root: String) -> String {
  concat(concat(root, "/"), merge_admission_receipt_rel_path)
}

fn shell_stdout_line(raw: String) -> String {
  trim(raw)
}

fn parse_gate_roster_hash_wire(line: String) -> GateRosterHash? {
  match fnv1a64_structural_hex_digest(hex: shell_stdout_line(raw: line)) {
    Present { value: structural } =>
      Present { value: gate_roster_hash_from_structural(structural: structural) }
    Absent => none
  }
}

fn render_gate_roster_hash_wire(hash: GateRosterHash) -> String {
  serialize_content_hash(hash: as_content_hash_structural(structural: hash)) as String
}

type MergeTargetTreeHashObservation
  = MergeTargetTreeHashOk { hash: GitObjectId }
  | MergeTargetTreeHashRefused { ref: String, cause: String }

fn merge_target_tree_hash_show_tree_refusal_cause(stderr: String) -> String {
  let detail = shell_stdout_line(raw: stderr)
  if detail == "" {
    "Invalid ref or not a git repository"
  } else {
    detail
  }
}

fn observe_merge_target_tree_hash(ref: GitRef) -> MergeTargetTreeHashObservation {
  let result = git.Inspect.ShowTree(ref: ref)
  if !result.success {
    MergeTargetTreeHashRefused {
      ref: ref as String,
      cause: merge_target_tree_hash_show_tree_refusal_cause(stderr: result.stderr),
    }
  } else {
    let hash = shell_stdout_line(raw: result.tree)
    if hash == "" {
      MergeTargetTreeHashRefused {
        ref: ref as String,
        cause: "git.Inspect.ShowTree exited 0 but stdout tree hash was empty",
      }
    } else {
      match git_object_id_from_untagged_hex(hex: hash) {
        Present { value: tree_hash } =>
          MergeTargetTreeHashOk { hash: tree_hash }
        Absent =>
          MergeTargetTreeHashRefused {
            ref: ref as String,
            cause: "git.Core.ShowTree stdout is not a canonical git object id",
          }
      }
    }
  }
}

fn merge_target_tree_hash_refusal_reason(prefix: String, ref: String, cause: String) -> String {
  concat(
    concat(prefix, ": git.Inspect.ShowTree refused for ref "),
    concat(ref, concat(": ", cause))
  )
}

fn render_receipt_wire_with_pr_line(receipt: MergeAdmissionReceipt, pr_line: String) -> String {
  concat(
    concat(
      concat(
        concat(git_object_id_wire_hex(oid: receipt.base_tree_hash), "\n"),
        concat(render_gate_roster_hash_wire(hash: receipt.gate_roster_hash), "\n")
      ),
      concat(check_conclusion_wire_label(c: receipt.conclusion), "\n")
    ),
    concat(concat(receipt.head_sha, "\n"), pr_line)
  )
}

fn render_receipt_wire(receipt: MergeAdmissionReceipt) -> String {
  let core = concat(
    concat(
      concat(
        concat(git_object_id_wire_hex(oid: receipt.base_tree_hash), "\n"),
        concat(render_gate_roster_hash_wire(hash: receipt.gate_roster_hash), "\n")
      ),
      concat(check_conclusion_wire_label(c: receipt.conclusion), "\n")
    ),
    receipt.head_sha
  )
  match receipt.pr_number {
    Present { value: n } => render_receipt_wire_with_pr_line(receipt: receipt, pr_line: to_string(n))
    Absent => core
  }
}

fn wire_pr_number_from_lines(lines: List<String>) -> Int? {
  if length(lines) >= 5 {
    parse_int(s: lines.skip(n: 4).first())
  } else {
    none
  }
}

fn parse_receipt_wire(text: String) -> MergeAdmissionReceipt? {
  let lines = receipt_wire_lines(text: text)
  if length(lines) < 4 {
    none
  } else {
    match parse_check_conclusion(raw: lines.skip(n: 2).first()) {
      Present { value: conclusion } =>
        match git_object_id_from_untagged_hex(hex: lines.first()) {
          Present { value: base_tree_hash } =>
            match parse_gate_roster_hash_wire(line: lines.skip(n: 1).first()) {
              Absent => none
              Present { value: gate_roster_hash } =>
                Present {
                  value: MergeAdmissionReceipt {
                    pr_number: wire_pr_number_from_lines(lines: lines),
                    head_sha: lines.skip(n: 3).first(),
                    base_tree_hash: base_tree_hash,
                    gate_roster_hash: gate_roster_hash,
                    conclusion: conclusion,
                  }
                }
            }
          Absent => none
        }
      Absent => none
    }
  }
}

fn ci_repo_root_shell() -> String {
  git_toplevel_shell_subexpr_with_fallback()
}

fn floor_exit_to_check_conclusion(exit_code: Int) -> CheckConclusion {
  if exit_code == 0 { Success } else { Failure }
}

fn stamp_floor_receipt(
  pr_number: Int?,
  head_sha: CommitSha,
  base_tree_hash: GitObjectId,
  floor_exit_code: Int,
) -> MergeAdmissionReceipt {
  stamp_floor_receipt_with_conclusion(
    pr_number: pr_number,
    head_sha: head_sha,
    base_tree_hash: base_tree_hash,
    conclusion: floor_exit_to_check_conclusion(exit_code: floor_exit_code),
  )
}

fn stamp_floor_receipt_with_conclusion(
  pr_number: Int?,
  head_sha: CommitSha,
  base_tree_hash: GitObjectId,
  conclusion: CheckConclusion,
) -> MergeAdmissionReceipt {
  mint_merge_admission_receipt(
    pr_number: pr_number,
    head_sha: head_sha,
    base_tree_hash: base_tree_hash,
    gate_roster_hash: current_gate_roster_hash,
    conclusion: conclusion,
  )
}
