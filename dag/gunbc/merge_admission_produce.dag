module gunbc.merge_admission_produce

import std.types { ContentHash, CommitSha, String, Int, List, Bool, GitRef }
import std.disposition { Disposition, Scaffold, SingleAuthority }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import gunbc.ci_diff_defaults { ci_merge_base_ref }
import extdeps.git
import extdeps.github.checks {
  CheckConclusion,
  check_conclusion_wire_label,
  parse_check_conclusion,
  Success,
  Failure,
  Skipped,
}
import gunbc.merge_admission {
  MergeAdmissionReceipt,
  mint_merge_admission_receipt,
  current_gate_roster_hash,
}
import gunbc.ci_layer_roots { witness_layer_roots, witness_layer_source_flags, witness_layer_source_flags_rooted }

data merge_admission_merge_base_ref: String = ci_merge_base_ref

data merge_admission_receipt_schema: String = "gunbc.merge_admission_receipt.v1"

data merge_admission_receipt_rel_path: String = ".gunbc/merge-admission-receipt.wire"

fn merge_admission_receipt_path(root: String) -> String {
  concat(concat(root, "/"), merge_admission_receipt_rel_path)
}

fn shell_stdout_line(raw: String) -> String {
  trim(raw)
}

type MergeTargetTreeHashObservation
  = MergeTargetTreeHashOk { hash: ContentHash }
  | MergeTargetTreeHashRefused { ref: String, cause: String }

fn merge_target_tree_hash_show_tree_refusal_cause(stderr: String) -> String {
  let detail = shell_stdout_line(raw: stderr)
  if detail == "" {
    "Invalid ref or not a git repository"
  } else {
    detail
  }
}

fn observe_merge_target_tree_hash(ref: GitRef) -> MergeTargetTreeHashObservation {
  let result = git.Core.ShowTree(ref: ref)
  if !result.success {
    MergeTargetTreeHashRefused {
      ref: ref as String,
      cause: merge_target_tree_hash_show_tree_refusal_cause(stderr: result.stderr),
    }
  } else {
    let hash = shell_stdout_line(raw: result.tree)
    if hash == "" {
      MergeTargetTreeHashRefused {
        ref: ref as String,
        cause: "git.Core.ShowTree exited 0 but stdout tree hash was empty",
      }
    } else {
      MergeTargetTreeHashOk { hash: hash as ContentHash }
    }
  }
}

fn merge_target_tree_hash_refusal_reason(prefix: String, ref: String, cause: String) -> String {
  concat(
    concat(prefix, ": git.Core.ShowTree refused for ref "),
    concat(ref, concat(": ", cause))
  )
}

fn render_receipt_wire_with_pr_line(receipt: MergeAdmissionReceipt, pr_line: String) -> String {
  concat(
    concat(
      concat(
        concat(receipt.base_tree_hash, "\n"),
        concat(receipt.gate_roster_hash, "\n")
      ),
      concat(check_conclusion_wire_label(c: receipt.conclusion), "\n")
    ),
    concat(concat(receipt.head_sha, "\n"), pr_line)
  )
}

fn render_receipt_wire(receipt: MergeAdmissionReceipt) -> String {
  let core = concat(
    concat(
      concat(
        concat(receipt.base_tree_hash, "\n"),
        concat(receipt.gate_roster_hash, "\n")
      ),
      concat(check_conclusion_wire_label(c: receipt.conclusion), "\n")
    ),
    receipt.head_sha
  )
  match receipt.pr_number {
    Present { value: n } => render_receipt_wire_with_pr_line(receipt: receipt, pr_line: to_string(n))
    Absent => core
  }
}

fn receipt_wire_lines(text: String) -> List<String> {
  split(s: text, delimiter: "\n")
}

fn wire_pr_number_from_lines(lines: List<String>) -> Int? {
  if length(lines) >= 5 {
    parse_int(s: lines.skip(n: 4).first())
  } else {
    none
  }
}

fn parse_receipt_wire(text: String) -> MergeAdmissionReceipt? {
  let lines = receipt_wire_lines(text: text)
  if length(lines) < 4 {
    none
  } else {
    match parse_check_conclusion(raw: lines.skip(n: 2).first()) {
      Present { value: conclusion } =>
        Present {
          value: MergeAdmissionReceipt {
            pr_number: wire_pr_number_from_lines(lines: lines),
            head_sha: lines.skip(n: 3).first(),
            base_tree_hash: lines.first(),
            gate_roster_hash: lines.skip(n: 1).first(),
            conclusion: conclusion,
          }
        }
      Absent => none
    }
  }
}

fn ci_repo_root_shell() -> String {
  git_toplevel_shell_subexpr_with_fallback()
}

fn gunbc_run_bin_shell() -> String {
  "\"$ROOT/target/release/gunbc\" run"
}

fn merge_admission_v1_tool_source_flags() -> String {
  " --source-root dag"
}

fn merge_admission_stamp_invoke() -> String {
  concat(
    concat(
      concat(gunbc_run_bin_shell(), merge_admission_v1_tool_source_flags()),
      " --entry dag/tools/merge_admission_stamp.dag --function main"
    ),
    "\n"
  )
}

fn merge_admission_gate_invoke() -> String {
  concat(
    concat(
      concat(gunbc_run_bin_shell(), merge_admission_v1_tool_source_flags()),
      " --entry dag/tools/merge_admission_gate.dag --function main"
    ),
    "\n"
  )
}

data merge_admission_shell_emit_disposition: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.live_deploy.emit",
    decl_name: "live_deploy_emit_shell_dissolution_trigger",
    field: WholeDeclaration
  }
}

data ci_documentation_only_gate_skip_prefix_scaffold: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.merge_admission_produce",
    decl_name: "ci_documentation_only_gate_skip_prefix",
    field: WholeDeclaration
  }
}

data ci_documentation_only_gate_skip_prefix_shell_emit_dissolution_trigger: String = "🟡 dissolve-on: ci_documentation_only_gate_skip_prefix — concat-built bash receipt-gate skip predicate over target/ci-floor-disposition.txt (documentation-only floor-not-run); DISSOLVES WHEN bash-emit (#5828 / ROADMAP 6-shell-slice0) realizes documentation-only disposition through orchestration emit and receipt gates read CI_FLOOR_DISPOSITION without a transport scaffold"

fn ci_merge_admission_stamp_script() -> String {
  concat(
    concat("ROOT=", ci_repo_root_shell(), "\n"),
    merge_admission_stamp_invoke()
  )
}

fn ci_merge_admission_gate_script() -> String {
  concat(
    concat(
      concat("ROOT=", ci_repo_root_shell(), "\n"),
      concat(git_fetch_script_for_gate(), "\n")
    ),
    concat(
      ci_documentation_only_gate_skip_prefix(
        gate_name: "merge-admission gate",
        skip_reason: "floor not run; merge-admission stamp already recorded Skipped disposition"
      ),
      merge_admission_gate_invoke()
    )
  )
}

fn ci_documentation_only_gate_skip_prefix(gate_name: String, skip_reason: String) -> String {
  concat(
    concat("# ", concat(ci_documentation_only_gate_skip_prefix_shell_emit_dissolution_trigger, "\n")),
    concat(
      concat(
        concat("if test -f ", ci_floor_disposition_marker_path),
        concat("; then _disp=$(cat ", ci_floor_disposition_marker_path)
      ),
      concat(
        concat(")\nif test \"$_disp\" = \"", merge_admission_floor_disposition_documentation_only_skipped),
        concat(
          "\"; then echo \"",
          concat(
            gate_name,
            concat(": skipped — CI_FLOOR_DISPOSITION=$_disp (", concat(skip_reason, ")\"; exit 0; fi; fi\n"))
          )
        )
      )
    )
  )
}

fn git_fetch_script_for_gate() -> String {
  let parts = git_remote_ref_parts(ref: merge_admission_merge_base_ref as GitRef)
  git_fetch_no_tags_shell(remote: parts.remote, ref_name: parts.ref_name, ignore_failure: false)
}

data merge_admission_floor_disposition_documentation_only_skipped: String = "documentation_only_skipped"

data merge_admission_floor_disposition_floor_running: String = "floor_running"

data ci_floor_disposition_marker_path: String = "target/ci-floor-disposition.txt"

data ci_floor_disposition_marker_init_scaffold: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.merge_admission_produce",
    decl_name: "ci_floor_disposition_marker_init_script",
    field: WholeDeclaration
  }
}

data ci_floor_disposition_marker_init_shell_emit_dissolution_trigger: String = "🟡 dissolve-on: ci_floor_disposition_marker_init_script — concat-built bash floor step opener stamping floor_running into target/ci-floor-disposition.txt (clears stale documentation_only_skipped on persistent self-hosted runners before docs-only branch); DISSOLVES WHEN bash-emit (#5828 / ROADMAP 6-shell-slice0) realizes floor disposition initialization through orchestration emit and the marker init retires without a transport scaffold"

data ci_floor_disposition_marker_init_note: String = "Positive floor-running stamp at the start of every floor step clears stale documentation_only_skipped left in target/ on persistent self-hosted runners (review 37010 / operator ruling 2026-07-11). Receipt gates skip only on an exact documentation_only_skipped match — never on file presence alone."

fn ci_floor_disposition_marker_init_script() -> String {
  concat(
    concat("# ", concat(ci_floor_disposition_marker_init_shell_emit_dissolution_trigger, "\n")),
    concat(
      concat("# ", concat(ci_floor_disposition_marker_init_note, "\n")),
      concat(
        concat("mkdir -p target\n"),
        concat(
          concat("echo ", merge_admission_floor_disposition_floor_running),
          concat(" > ", concat(ci_floor_disposition_marker_path, "\n"))
        )
      )
    )
  )
}

data merge_admission_stamp_documentation_only_skip_policy: String = "CI_FLOOR_DISPOSITION=documentation_only_skipped stamps merge-admission conclusion Skipped (not Success) — floor-not-run ≠ floor-green per §5; distinct from CI_FLOOR_EXIT=0 laundering"

fn floor_exit_to_check_conclusion(exit_code: Int) -> CheckConclusion {
  if exit_code == 0 { Success } else { Failure }
}

fn floor_disposition_to_check_conclusion(disposition: String) -> CheckConclusion? {
  if disposition == merge_admission_floor_disposition_documentation_only_skipped {
    Present { value: Skipped }
  } else {
    none
  }
}

fn stamp_floor_receipt(
  pr_number: Int?,
  head_sha: CommitSha,
  base_tree_hash: ContentHash,
  floor_exit_code: Int,
) -> MergeAdmissionReceipt {
  stamp_floor_receipt_with_conclusion(
    pr_number: pr_number,
    head_sha: head_sha,
    base_tree_hash: base_tree_hash,
    conclusion: floor_exit_to_check_conclusion(exit_code: floor_exit_code),
  )
}

fn stamp_floor_receipt_with_conclusion(
  pr_number: Int?,
  head_sha: CommitSha,
  base_tree_hash: ContentHash,
  conclusion: CheckConclusion,
) -> MergeAdmissionReceipt {
  mint_merge_admission_receipt(
    pr_number: pr_number,
    head_sha: head_sha,
    base_tree_hash: base_tree_hash,
    gate_roster_hash: current_gate_roster_hash,
    conclusion: conclusion,
  )
}

fn ci_floor_stamp_merge_admission_script() -> String {
  concat(
    concat(
      "FLOOR_EXIT=$?\n",
      concat("ROOT=", ci_repo_root_shell(), "\n")
    ),
    concat(
      concat(
        concat("CI_FLOOR_EXIT=$FLOOR_EXIT ", merge_admission_stamp_invoke()),
        "STAMP_EXIT=$?\n"
      ),
      concat(
        "if [ \"$FLOOR_EXIT\" -ne 0 ]; then exit \"$FLOOR_EXIT\"; fi\n",
        "exit \"$STAMP_EXIT\"\n"
      )
    )
  )
}
