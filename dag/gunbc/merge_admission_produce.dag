data merge_admission_merge_base_ref: String = gunbc_merge_target_ref as String

data merge_admission_receipt_schema: String = "gunbc.merge_admission_receipt.v1"

data merge_admission_receipt_rel_path: String = ".gunbc/merge-admission-receipt.wire"

data merge_admission_receipt_schema_v2: String = "gunbc.merge_admission_receipt.v2"

data merge_admission_tested_subject_schema: String = "gunbc.merge_admission_tested_subject.v1"

fn merge_admission_attempt_dir(root: String, attempt_id: NonEmptyStr) -> String {
  concat(concat(root, "/.gunbc/merge-admission/"), attempt_id as String)
}

fn merge_admission_tested_subject_path(root: String, attempt_id: NonEmptyStr) -> String {
  concat(merge_admission_attempt_dir(root: root, attempt_id: attempt_id), "/tested-subject.wire")
}

fn merge_admission_floor_receipt_path(root: String, attempt_id: NonEmptyStr) -> String {
  concat(merge_admission_attempt_dir(root: root, attempt_id: attempt_id), "/floor-receipt.wire")
}

data compose_walk_attempt_id_note: String = "Pure composition of the walk-attempt identity from its parts; the ENV OBSERVATION lives with the wet entry, this fn only joins and refuses. Every part must be nonempty — an empty run id, attempt number, or job name yields Absent, and the caller REFUSES the run rather than substituting a constant: a silent local would make every non-GitHub run one attempt, so the wrong-attempt refusal could never fire off CI, which is exactly the unreachable-arm shape §5 forbids. Non-GitHub execution supplies GUNBC_WALK_ATTEMPT_ID explicitly and it passes through compose_explicit_walk_attempt_id under the same nonempty law."

fn compose_walk_attempt_id(run_id: String, run_attempt: String, job: String) -> NonEmptyStr? {
  if (run_id == "") || (run_attempt == "") || (job == "") {
    none
  } else {
    Present {
      value: concat(concat(concat(concat(run_id, "-"), run_attempt), "-"), job) as NonEmptyStr
    }
  }
}

fn compose_explicit_walk_attempt_id(explicit: String) -> NonEmptyStr? {
  if explicit == "" { none } else { Present { value: explicit as NonEmptyStr } }
}

fn render_tested_subject_wire(subject: TestedSubject) -> String {
  concat(
    concat(
      concat(concat(merge_admission_tested_subject_schema, "
"), concat(subject.attempt_id as String, "
")),
      concat(subject.base_ref, "
")
    ),
    concat(concat(subject.base_tree_hash, "
"), subject.head_sha)
  )
}

fn parse_tested_subject_wire(text: String) -> TestedSubject? {
  let lines = receipt_wire_lines(text: text)
  if length(lines) < 5 {
    none
  } else if !(lines.first() == merge_admission_tested_subject_schema) {
    none
  } else if lines.skip(n: 1).first() == "" {
    none
  } else {
    Present {
      value: TestedSubject {
        attempt_id: lines.skip(n: 1).first() as NonEmptyStr,
        base_ref: lines.skip(n: 2).first(),
        base_tree_hash: lines.skip(n: 3).first(),
        head_sha: lines.skip(n: 4).first(),
      }
    }
  }
}

data receipt_wire_v2_note: String = "Wire v2 is SELF-IDENTIFYING: line 1 is the schema tag, so a v1 wire (positional, no tag) read by the v2 parser refuses on the tag line instead of mis-binding fields by position — and a v2 wire read by the v1 parser mis-parses into a conclusion-line mismatch, also a refusal. Lines: schema, attempt_id, tested_base_tree_hash, gate_roster_hash, conclusion, tested_head_sha, then the optional pr number. The v1 wire, path, and type stay until the entry migration completes and the old consumers delete with the emitter web (add-replacement, never in-place mutation of a live format)."

fn render_receipt_wire_v2(receipt: MergeAdmissionReceiptV2) -> String {
  let core = concat(
    concat(
      concat(concat(merge_admission_receipt_schema_v2, "
"), concat(receipt.attempt_id as String, "
")),
      concat(concat(receipt.tested_base_tree_hash, "
"), concat(receipt.gate_roster_hash, "
"))
    ),
    concat(concat(check_conclusion_wire_label(c: receipt.conclusion), "
"), receipt.tested_head_sha)
  )
  match receipt.pr_number {
    Present { value: n } => concat(core, concat("
", to_string(n)))
    Absent => core
  }
}

fn parse_receipt_wire_v2(text: String) -> MergeAdmissionReceiptV2? {
  let lines = receipt_wire_lines(text: text)
  if length(lines) < 6 {
    none
  } else if !(lines.first() == merge_admission_receipt_schema_v2) {
    none
  } else if lines.skip(n: 1).first() == "" {
    none
  } else {
    match parse_check_conclusion(raw: lines.skip(n: 4).first()) {
      Present { value: conclusion } =>
        Present {
          value: MergeAdmissionReceiptV2 {
            attempt_id: lines.skip(n: 1).first() as NonEmptyStr,
            pr_number: if length(lines) >= 7 { parse_int(s: lines.skip(n: 6).first()) } else { none },
            tested_head_sha: lines.skip(n: 5).first(),
            tested_base_tree_hash: lines.skip(n: 2).first(),
            gate_roster_hash: lines.skip(n: 3).first(),
            conclusion: conclusion,
          }
        }
      Absent => none
    }
  }
}

fn merge_admission_receipt_path(root: String) -> String {
  concat(concat(root, "/"), merge_admission_receipt_rel_path)
}

fn shell_stdout_line(raw: String) -> String {
  trim(raw)
}

type MergeTargetTreeHashObservation
  = MergeTargetTreeHashOk { hash: ContentHash }
  | MergeTargetTreeHashRefused { ref: String, cause: String }

fn merge_target_tree_hash_show_tree_refusal_cause(stderr: String) -> String {
  let detail = shell_stdout_line(raw: stderr)
  if detail == "" {
    "Invalid ref or not a git repository"
  } else {
    detail
  }
}

fn observe_merge_target_tree_hash(ref: GitRef) -> MergeTargetTreeHashObservation {
  let result = git.Core.ShowTree(ref: ref)
  if !result.success {
    MergeTargetTreeHashRefused {
      ref: ref as String,
      cause: merge_target_tree_hash_show_tree_refusal_cause(stderr: result.stderr),
    }
  } else {
    let hash = shell_stdout_line(raw: result.tree)
    if hash == "" {
      MergeTargetTreeHashRefused {
        ref: ref as String,
        cause: "git.Core.ShowTree exited 0 but stdout tree hash was empty",
      }
    } else {
      MergeTargetTreeHashOk { hash: hash as ContentHash }
    }
  }
}

fn merge_target_tree_hash_refusal_reason(prefix: String, ref: String, cause: String) -> String {
  concat(
    concat(prefix, ": git.Core.ShowTree refused for ref "),
    concat(ref, concat(": ", cause))
  )
}

fn render_receipt_wire_with_pr_line(receipt: MergeAdmissionReceipt, pr_line: String) -> String {
  concat(
    concat(
      concat(
        concat(receipt.base_tree_hash, "\n"),
        concat(receipt.gate_roster_hash, "\n")
      ),
      concat(check_conclusion_wire_label(c: receipt.conclusion), "\n")
    ),
    concat(concat(receipt.head_sha, "\n"), pr_line)
  )
}

fn render_receipt_wire(receipt: MergeAdmissionReceipt) -> String {
  let core = concat(
    concat(
      concat(
        concat(receipt.base_tree_hash, "\n"),
        concat(receipt.gate_roster_hash, "\n")
      ),
      concat(check_conclusion_wire_label(c: receipt.conclusion), "\n")
    ),
    receipt.head_sha
  )
  match receipt.pr_number {
    Present { value: n } => render_receipt_wire_with_pr_line(receipt: receipt, pr_line: to_string(n))
    Absent => core
  }
}

fn receipt_wire_lines(text: String) -> List<String> {
  split(s: text, delimiter: "\n")
}

fn wire_pr_number_from_lines(lines: List<String>) -> Int? {
  if length(lines) >= 5 {
    parse_int(s: lines.skip(n: 4).first())
  } else {
    none
  }
}

fn parse_receipt_wire(text: String) -> MergeAdmissionReceipt? {
  let lines = receipt_wire_lines(text: text)
  if length(lines) < 4 {
    none
  } else {
    match parse_check_conclusion(raw: lines.skip(n: 2).first()) {
      Present { value: conclusion } =>
        Present {
          value: MergeAdmissionReceipt {
            pr_number: wire_pr_number_from_lines(lines: lines),
            head_sha: lines.skip(n: 3).first(),
            base_tree_hash: lines.first(),
            gate_roster_hash: lines.skip(n: 1).first(),
            conclusion: conclusion,
          }
        }
      Absent => none
    }
  }
}

fn ci_repo_root_shell() -> String {
  git_toplevel_shell_subexpr_with_fallback()
}

data merge_admission_v1_tool_source_roots: List<String> = ["dag"]

data merge_admission_gate_entry_path: String = "dag/tools/merge_admission_gate.dag"

data merge_admission_gate_entry_function: String = "main"

data merge_admission_gate_policy_note: String = "Gate POLICY, language-blind: which merge base is fetched, which tool entry/function decides admission, which source roots that tool compiles under, and where the release binary sits relative to the repo root. Nothing here spells a command, a flag string, or a shell fragment for the gate — the bash rendering is v2.workflow.ci_merge_admission_gate_emit's business and derives argv from the referenced extdeps operation declarations (git.Core.FetchNoTags, gunbc.WitnessBin.Run), never from a concat builder here. The stamp surfaces below are a SEPARATE, still-raw floor-tail site and keep their shell spellings; both now read the same source-root list and the same release-bin path row, so the two spellings cannot drift apart (§3)."

fn merge_admission_v1_tool_source_flags() -> String {
  source_roots_shell_flags(roots: merge_admission_v1_tool_source_roots, style: SourceRootBare)
}

fn merge_admission_gate_bin_rel_path() -> String {
  release_bin_rel_path(bin_name: gunbc_bin_name)
}

fn merge_admission_gate_tool_args() -> List<String> {
  concat(
    concat(
      ["run"],
      source_root_transport_argv(roots: merge_admission_v1_tool_source_roots)
    ),
    [
      "--entry", merge_admission_gate_entry_path,
      "--function", merge_admission_gate_entry_function
    ]
  )
}

fn merge_admission_gate_fetch_parts() -> GitRemoteRefParts {
  git_remote_ref_parts(ref: merge_admission_merge_base_ref as GitRef)
}

fn gunbc_run_bin_shell() -> String {
  concat(gunbc_bin_shell(), " run")
}

fn merge_admission_stamp_command() -> String {
  concat(
    concat(gunbc_run_bin_shell(), merge_admission_v1_tool_source_flags()),
    " --entry dag/tools/merge_admission_stamp.dag --function main"
  )
}

data merge_admission_shell_emit_disposition: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.live_deploy.emit",
    decl_name: "live_deploy_emit_shell_dissolution_trigger",
    field: WholeDeclaration
  }
}

fn floor_exit_to_check_conclusion(exit_code: Int) -> CheckConclusion {
  if exit_code == 0 { Success } else { Failure }
}

fn stamp_floor_receipt(
  pr_number: Int?,
  head_sha: CommitSha,
  base_tree_hash: ContentHash,
  floor_exit_code: Int,
) -> MergeAdmissionReceipt {
  stamp_floor_receipt_with_conclusion(
    pr_number: pr_number,
    head_sha: head_sha,
    base_tree_hash: base_tree_hash,
    conclusion: floor_exit_to_check_conclusion(exit_code: floor_exit_code),
  )
}

fn stamp_floor_receipt_with_conclusion(
  pr_number: Int?,
  head_sha: CommitSha,
  base_tree_hash: ContentHash,
  conclusion: CheckConclusion,
) -> MergeAdmissionReceipt {
  mint_merge_admission_receipt(
    pr_number: pr_number,
    head_sha: head_sha,
    base_tree_hash: base_tree_hash,
    gate_roster_hash: current_gate_roster_hash,
    conclusion: conclusion,
  )
}

data ci_floor_stamp_merge_admission_shell_emit_scaffold: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "v2.workflow.ci_merge_admission_emit",
    decl_name: "ci_floor_stamp_merge_admission_script",
    field: WholeDeclaration
  }
}

data ci_floor_stamp_merge_admission_shell_emit_dissolution_trigger: String = "🟡 dissolve-on: ci_floor_stamp_merge_admission_script — floor-tail FLOOR_EXIT/STAMP_EXIT capture + merge-admission stamp; PR2a lands ExitStatus carrier for STAMP_EXIT; PR2b dissolves IntNe/Exit concat residue"
