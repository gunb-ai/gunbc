data spark_serving_converge_slice_wet_note: String = "Wet Seam 2 linger slice: observe durable Linger property on each Spark via FleetSsh (endpoint from gunbc.fleet_reach_endpoint.fleet_probe_endpoint_for → gunbc.dgx_spark_procurement OperatorAllocation rows, NOT fleet_intent_network DNS), plan frozen typed rows, derive apply argv. Hermetic witnesses prove logic given linger_enabled input; this entry proves a REAL host was observed."

data spark_serving_converge_slice_wet_receipt_path: String = "target/spark-serving-converge-slice-wet-receipt.txt"

data spark_serving_converge_slice_wet_hosts: List<HostIdentity> = [operator_host_srv5, operator_host_srv6]

fn spark_serving_linger_probe_words() -> List<String> {
  [
    "loginctl",
    "show-user",
    spark_serving_automation_principal_login() as String,
    "-p",
    "Linger",
  ]
}

fn spark_serving_linger_enabled_from_stdout(stdout: String) -> Bool? {
  let line = trim(s: stdout)
  if line == "Linger=yes" {
    Present { value: true }
  } else if line == "Linger=no" {
    Present { value: false }
  } else {
    none
  }
}

fn spark_serving_probe_linger(
  context: FleetSshExecutionContext,
  host: HostIdentity,
) -> SshSessionExecResult? {
  match portable_remote_words(raws: spark_serving_linger_probe_words()) {
    Absent => none
    Present { value: words } => Present {
      value: ssh_session_exec_portable_words(
        client_args: shape_fleet_ssh_exec(
          context: context,
          target: SshTarget {
            endpoint: fleet_probe_endpoint_for(host: host as String) as NonEmptyStr,
            principal: spark_serving_automation_principal_login(),
          },
          words: words,
        ),
      ),
    }
  }
}

fn spark_serving_converge_slice_host_line(
  host: HostIdentity,
  endpoint: String,
  linger_enabled: Bool,
  typed_row_count: Int,
  apply_effect_count: Int,
  apply_argv_len: Int,
  verdict: String,
) -> String {
  join([
    "host=", host as String,
    " endpoint=", endpoint,
    " observed_linger=", if linger_enabled { "yes" } else { "no" },
    " typed_rows=", to_string(typed_row_count),
    " apply_effect_count=", to_string(apply_effect_count),
    " apply_argv_len=", to_string(apply_argv_len),
    " verdict=", verdict,
    "\n",
  ], "")
}

fn spark_serving_converge_slice_ssh_target(host: HostIdentity) -> SshTarget {
  SshTarget {
    endpoint: fleet_probe_endpoint_for(host: host as String) as NonEmptyStr,
    principal: spark_serving_automation_principal_login(),
  }
}

fn spark_serving_converge_slice_would_apply_verdict(
  host: HostIdentity,
  linger_enabled: Bool,
  n: Int,
) -> String {
  join([
    "would-apply typed-argv membership_writes=",
    to_string(membership_write_count(
      plan: spark_serving_linger_membership_plan(
        host: host,
        linger_enabled: linger_enabled,
      ),
    )),
  ], "")
}

fn spark_serving_converge_slice_exec_verdict(
  context: FleetSshExecutionContext,
  host: HostIdentity,
  artifact: FleetConvergePlanArtifact,
  bundle_hex: String,
  effect_count: Int,
) -> String {
  if effect_count == 0 {
    "wet-noop-converged"
  } else {
    match spark_serving_exec_frozen_typed_rows_over_fleet_ssh(
      artifact: artifact,
      claimed_bundle_hex: bundle_hex,
      context: context,
      target: spark_serving_converge_slice_ssh_target(host: host),
    ) {
      SparkServingFrozenRemoteExecRefused { reason: why } =>
        join(["wet-apply-refused ", why], "")
      SparkServingFrozenRemoteExecApplied { exec_outcome } =>
        match exec_outcome {
          TypedArgvExecRefused { reason: why } =>
            join(["wet-apply-exec-refused ", why], "")
          TypedArgvExecConverged { result } =>
            if result.success == false {
              join([
                "wet-apply-exec-failed exit=", to_string(result.exit_code),
                " stderr=", result.stderr,
              ], "")
            } else {
              match spark_serving_probe_linger(context: context, host: host) {
                Absent => "wet-applied-readback-refused probe-did-not-run"
                Present { value: post } =>
                  if post.success == false {
                    join([
                      "wet-applied-readback-refused exit=", to_string(post.exit_code),
                      " stderr=", post.stderr,
                    ], "")
                  } else {
                    match spark_serving_linger_enabled_from_stdout(stdout: post.stdout) {
                      Absent =>
                        join(["wet-applied-readback-refused stdout=", trim(s: post.stdout)], "")
                      Present { value: enabled } =>
                        if enabled {
                          "wet-applied-converged"
                        } else {
                          "wet-applied-readback-mismatch lingering-still-no"
                        }
                    }
                  }
              }
            }
        }
    }
  }
}

fn spark_serving_converge_slice_wet_host_report(
  context: FleetSshExecutionContext,
  host: HostIdentity,
  execute_apply: Bool,
) -> String {
  let endpoint = fleet_probe_endpoint_for(host: host as String)
  match spark_serving_probe_linger(context: context, host: host) {
    Absent =>
      spark_serving_converge_slice_host_line(
        host: host,
        endpoint: endpoint,
        linger_enabled: false,
        typed_row_count: 0,
        apply_effect_count: 0,
        apply_argv_len: 0,
        verdict: "observation-refused probe-did-not-run",
      )
    Present { value: probe } =>
      if probe.success == false {
        spark_serving_converge_slice_host_line(
          host: host,
          endpoint: endpoint,
          linger_enabled: false,
          typed_row_count: 0,
          apply_effect_count: 0,
          apply_argv_len: 0,
          verdict: join([
            "observation-refused exit=", to_string(probe.exit_code),
            " stderr=", probe.stderr,
          ], ""),
        )
      } else {
        match spark_serving_linger_enabled_from_stdout(stdout: probe.stdout) {
          Absent =>
            spark_serving_converge_slice_host_line(
              host: host,
              endpoint: endpoint,
              linger_enabled: false,
              typed_row_count: 0,
              apply_effect_count: 0,
              apply_argv_len: 0,
              verdict: join(["observation-refused stdout=", trim(s: probe.stdout)], ""),
            )
          Present { value: linger_enabled } =>
            match spark_serving_fleet_converge_plan_artifact(
              host: host as NonEmptyStr,
              prior_generation: 0,
              observed_timers: [],
              observed_caps: [],
              linger_enabled: linger_enabled,
            ) {
              Absent =>
                spark_serving_converge_slice_host_line(
                  host: host,
                  endpoint: endpoint,
                  linger_enabled: linger_enabled,
                  typed_row_count: 0,
                  apply_effect_count: 0,
                  apply_argv_len: 0,
                  verdict: "plan-refused",
                )
              Present { value: artifact } =>
                match fleet_converge_plan_artifact_hash(artifact: artifact) {
                  Absent =>
                    spark_serving_converge_slice_host_line(
                      host: host,
                      endpoint: endpoint,
                      linger_enabled: linger_enabled,
                      typed_row_count: length(artifact.spark_serving_typed_actions),
                      apply_effect_count: 0,
                      apply_argv_len: 0,
                      verdict: "plan-hash-refused",
                    )
                  Present { value: hex } =>
                    match spark_serving_apply_reads_frozen_typed_rows(
                      artifact: artifact,
                      claimed_bundle_hex: hex as String,
                    ) {
                      SparkServingFrozenApplyRefused { reason: why } =>
                        spark_serving_converge_slice_host_line(
                          host: host,
                          endpoint: endpoint,
                          linger_enabled: linger_enabled,
                          typed_row_count: length(artifact.spark_serving_typed_actions),
                          apply_effect_count: 0,
                          apply_argv_len: 0,
                          verdict: join(["apply-refused ", why], ""),
                        )
                      SparkServingFrozenApplied { remote_argv: argv, effect_count: n } =>
                        spark_serving_converge_slice_host_line(
                          host: host,
                          endpoint: endpoint,
                          linger_enabled: linger_enabled,
                          typed_row_count: length(artifact.spark_serving_typed_actions),
                          apply_effect_count: n,
                          apply_argv_len: length(argv),
                          verdict: if execute_apply {
                            spark_serving_converge_slice_exec_verdict(
                              context: context,
                              host: host,
                              artifact: artifact,
                              bundle_hex: hex as String,
                              effect_count: n,
                            )
                          } else if n == 0 {
                            "wet-noop-converged"
                          } else {
                            spark_serving_converge_slice_would_apply_verdict(
                              host: host,
                              linger_enabled: linger_enabled,
                              n: n,
                            )
                          },
                        )
                    }
                }
            }
        }
      }
  }
}

func spark_serving_converge_slice_wet() -> ProcessExit
  uses net: Network
{
  match fleet_ssh_attempt_raw_from_env() {
    Absent =>
      exit_failure(
        reason: "spark_serving_converge_slice_wet requires GUNBC_FLEET_SSH_ATTEMPT_RAW or GitHub GITHUB_RUN_ID+GITHUB_RUN_ATTEMPT env",
      )
    Present { value: attempt_raw } =>
      run_with_materialized_fleet_ssh_binding(
        attempt_raw: attempt_raw,
        token_source: GcloudPrintToken,
        body: fn(credential) {
          let now = clock_now_probed_at()
          match fleet_ssh_attempt_identity(raw: attempt_raw) {
            Absent => exit_failure(reason: "attempt identity is not a safe path segment")
            Present { value: attempt } => {
              let materialization = materialize_fleet_known_hosts_anchor(attempt: attempt)
              match fleet_ssh_execution_context_of(outcome: materialization, credential: credential) {
                Absent =>
                  exit_failure(
                    reason: known_hosts_materialization_receipt(outcome: materialization),
                  )
                Present { value: context } => {
                  let execute_apply = spark_converge_execute_apply_from_env()
                  match spark_converge_target_selection(execute_apply: execute_apply) {
                    SparkConvergeTargetRefused { reason: why } => exit_failure(reason: why)
                    SparkConvergeTargetSingle { host: only } =>
                      spark_serving_converge_slice_emit_receipt(
                        context: context,
                        now: now,
                        attempt_raw: attempt_raw,
                        materialization: materialization,
                        hosts: [only],
                        execute_apply: execute_apply,
                      )
                    SparkConvergeTargetAllObserveOnly =>
                      spark_serving_converge_slice_emit_receipt(
                        context: context,
                        now: now,
                        attempt_raw: attempt_raw,
                        materialization: materialization,
                        hosts: spark_serving_converge_slice_wet_hosts,
                        execute_apply: execute_apply,
                      )
                  }
                }
              }
            }
          }
        },
      )
  }
}

// Receipt emission for an ALREADY-SELECTED host population. Selection refuses upstream, so
// this fold never has to decide what "no target" means — the only way to reach it with the
// full host list is the observe-only arm.
fn spark_serving_converge_slice_emit_receipt(
  context: FleetSshExecutionContext,
  now: NonEmptyStr,
  attempt_raw: String,
  materialization: KnownHostsMaterializationOutcome,
  hosts: List<HostIdentity>,
  execute_apply: Bool,
) -> ProcessExit {
                  let body = join(
                    concat(
                      [
                        join(["spark_serving_converge_slice_wet probed_at=", now as String, "\n"], ""),
                        join(["attempt=", attempt_raw, "\n"], ""),
                        join([
                          "execute_apply=",
                          if execute_apply { "yes" } else { "no" },
                          " address_authority=fleet_probe_endpoint_for→dgx_spark_procurement OperatorAllocation\n",
                        ], ""),
                        known_hosts_materialization_receipt(outcome: materialization),
                        "\n",
                      ],
                      map(
                        hosts,
                        h => spark_serving_converge_slice_wet_host_report(
                          context: context,
                          host: h,
                          execute_apply: execute_apply,
                        ),
                      ),
                    ),
                    "",
                  )
                  let w = Filesystem.Write(path: spark_serving_converge_slice_wet_receipt_path, content: body)
                  if w.success {
                    ExitSuccess
                  } else {
                    exit_failure(reason: join(["receipt write failed: ", w.error], ""))
                  }
}
