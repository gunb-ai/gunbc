module gunbc.fleet_fan_population

import std.types { Bool, Int, List, NonEmptyStr }
import std.measure { RevolutionsPerMinute, rpm, rpm_count }
import product.placement_supply { HostIdentity }
import std.process { ProcessExit, ExitSuccess, exit_failure }
import gunbc.fleet_intent_network {
  operator_host_srv1,
  operator_host_srv2,
  operator_host_srv3,
  operator_host_srv4,
}

// WHY THIS MODULE EXISTS, and it is a fact the BMC structurally cannot hold.
// A tachometer that reads nothing is TWO different states: a fan that has failed, and a header
// that no fan was ever plugged into. The BMC reports both as absent-or-zero and marks them
// Critical, because a service processor knows its header count and nothing about what the
// chassis was built to carry. Measured on the live fleet 2026-08-26, both states are present
// simultaneously: srv3's FAN2 reads absent because the 2U chassis has no bay there, while
// srv1's FAN4 reads absent because a fan that IS installed has stopped turning. Reading those
// two as one state is the state-space conflation DESIGN names, and it has a real cost in both
// directions - a nominal gap raised as a fault, and a fault dismissed as a nominal gap.
//
// The discriminator is the DECLARED population, which is a property of the chassis and the
// cooler rather than of the board. So the population is derived from those two authorities and
// the observation is judged against it, instead of a hand-authored tach list standing in for a
// physical fact nobody wrote down.

type FanHeaderRole
  = ProcessorCoolerHeader
  | ChassisBayHeader

// One board fan header and what, if anything, the machine was built to put on it.
// HeaderUnpopulatedByDesign is the arm that does the work: it is the difference between
// "nothing is turning here and that is correct" and "nothing is turning here and it should be".
type FanHeaderPopulation
  = HeaderPopulated { role: FanHeaderRole }
  | HeaderUnpopulatedByDesign

type FanHeaderBinding {
  header: NonEmptyStr
  population: FanHeaderPopulation
}

type HostFanPopulation {
  host: HostIdentity
  headers: List<FanHeaderBinding>
}

// An observation carries the header and whatever the tachometer said. A reading is absent when
// the sensor published no value at all; a reading of zero is a distinct fact and both are
// treated the same way here ONLY because both mean "not turning" - the discrimination that
// matters is against the declared population, not between these two.
type FanTachObservation {
  header: NonEmptyStr
  reading: RevolutionsPerMinute?
}

type FanHeaderVerdict
  = FanNominalSpinning { header: NonEmptyStr, rpm: RevolutionsPerMinute }
  | FanNominalAbsentByDesign { header: NonEmptyStr }
  | FanFailedNotTurning { header: NonEmptyStr, role: FanHeaderRole }
  | FanUnexpectedlyPresent { header: NonEmptyStr, rpm: RevolutionsPerMinute }
  | FanHeaderUndeclared { header: NonEmptyStr }

fn fan_reading_is_turning(reading: RevolutionsPerMinute?) -> Bool {
  match reading {
    none => false
    Present { value } => rpm_count(value) > 0
  }
}

fn fan_binding_for_header(
  population: HostFanPopulation,
  header: NonEmptyStr,
) -> FanHeaderBinding? {
  fold(
    population.headers,
    init: none,
    f: (acc, binding) =>
      match acc {
        Present { value } => Present { value: value }
        none =>
          if binding.header == header {
            Present { value: binding }
          } else {
            none
          }
      },
  )
}

// THE JUDGEMENT. Every arm is reachable and every arm has a different owner:
// FanFailedNotTurning is a hardware ticket, FanNominalAbsentByDesign is nothing at all,
// FanUnexpectedlyPresent means the declared population is wrong (a fan was added and not
// recorded), and FanHeaderUndeclared means this host has no population authority yet.
fn fan_header_verdict(
  population: HostFanPopulation,
  observation: FanTachObservation,
) -> FanHeaderVerdict {
  match fan_binding_for_header(population: population, header: observation.header) {
    none => FanHeaderUndeclared { header: observation.header }
    Present { value: binding } =>
      match binding.population {
        HeaderUnpopulatedByDesign =>
          match observation.reading {
            none => FanNominalAbsentByDesign { header: observation.header }
            Present { value: rpm } =>
              if rpm_count(rpm) > 0 {
                FanUnexpectedlyPresent { header: observation.header, rpm: rpm }
              } else {
                FanNominalAbsentByDesign { header: observation.header }
              }
          }
        HeaderPopulated { role } =>
          match observation.reading {
            none => FanFailedNotTurning { header: observation.header, role: role }
            Present { value: rpm } =>
              if rpm_count(rpm) > 0 {
                FanNominalSpinning { header: observation.header, rpm: rpm }
              } else {
                FanFailedNotTurning { header: observation.header, role: role }
              }
          }
      }
  }
}

fn fan_header_verdicts(
  population: HostFanPopulation,
  observations: List<FanTachObservation>,
) -> List<FanHeaderVerdict> {
  map(
    observations,
    observation => fan_header_verdict(population: population, observation: observation),
  )
}

fn fan_verdict_is_failure(verdict: FanHeaderVerdict) -> Bool {
  match verdict {
    FanFailedNotTurning { header, role } => true
    FanUnexpectedlyPresent { header, rpm } => true
    FanHeaderUndeclared { header } => true
    FanNominalSpinning { header, rpm } => false
    FanNominalAbsentByDesign { header } => false
  }
}

fn fan_population_failure_count(
  population: HostFanPopulation,
  observations: List<FanTachObservation>,
) -> Int {
  fold(
    fan_header_verdicts(population: population, observations: observations),
    init: 0,
    f: (acc, verdict) =>
      if fan_verdict_is_failure(verdict: verdict) { acc + 1 } else { acc },
  )
}

// THE CONTROLLER'S TACH LIST IS DERIVED, NEVER AUTHORED. This is the whole point of the module
// for the fan-control path: gunbc.bmc_intent carries a fleet-wide literal
// ["FAN1","FAN2","FAN3","FAN4"], which matches srv4 and no one else - wrong for srv1/srv2 by
// count and wrong for srv3 by index. A fleet constant cannot express a per-host physical fact.
// Deriving it here means a controller list that disagrees with the hardware is not something a
// reviewer has to notice.
fn controlled_fan_headers(population: HostFanPopulation) -> List<NonEmptyStr> {
  map(
    filter(
      population.headers,
      binding =>
        match binding.population {
          HeaderPopulated { role } => true
          HeaderUnpopulatedByDesign => false
        },
    ),
    binding => binding.header,
  )
}

fn populated_header_count(population: HostFanPopulation) -> Int {
  controlled_fan_headers(population: population).length()
}

fn cooler_header(header: NonEmptyStr) -> FanHeaderBinding {
  FanHeaderBinding {
    header: header,
    population: HeaderPopulated { role: ProcessorCoolerHeader },
  }
}

fn chassis_bay_header(header: NonEmptyStr) -> FanHeaderBinding {
  FanHeaderBinding {
    header: header,
    population: HeaderPopulated { role: ChassisBayHeader },
  }
}

fn unpopulated_header(header: NonEmptyStr) -> FanHeaderBinding {
  FanHeaderBinding {
    header: header,
    population: HeaderUnpopulatedByDesign,
  }
}

// PER-HOST POPULATIONS.
// Each row is an operator-stated chassis/cooler fact CONFIRMED by tach observation on
// 2026-08-26 (five reads per header per host). The observation is corroboration, not the
// authority - a failed fan reads absent, so a population derived from readings alone would
// silently shrink to match its own faults. That is exactly the srv1 case below: FAN4 and FAN5
// are declared populated and read as failures, which is the verdict this module exists to
// produce rather than a reason to drop them from the population.

// srv1/srv2: 4U, Noctua NH-D9 AMP-4926 4U on FAN1 (two NF-A9 fans through the bundled NA-YC1
// splitter, so ONE tach signal for two physical fans), plus four chassis bays on FAN2..FAN5.
data srv1_fan_population: HostFanPopulation = HostFanPopulation {
  host: operator_host_srv1,
  headers: [
    cooler_header(header: "FAN1"),
    chassis_bay_header(header: "FAN2"),
    chassis_bay_header(header: "FAN3"),
    chassis_bay_header(header: "FAN4"),
    chassis_bay_header(header: "FAN5"),
  ],
}

data srv2_fan_population: HostFanPopulation = HostFanPopulation {
  host: operator_host_srv2,
  headers: [
    cooler_header(header: "FAN1"),
    chassis_bay_header(header: "FAN2"),
    chassis_bay_header(header: "FAN3"),
    chassis_bay_header(header: "FAN4"),
    chassis_bay_header(header: "FAN5"),
  ],
}

// srv3/srv4: 2U, Dynatron W1 on FAN1 (a single DF126025BU-PWMH, one fan one tach), plus THREE
// chassis bays. The two hosts populate DIFFERENT INDICES - srv3 skips FAN2 and srv4 skips FAN5 -
// which is why a single fleet-wide list cannot be right for both even though both carry four.
data srv3_fan_population: HostFanPopulation = HostFanPopulation {
  host: operator_host_srv3,
  headers: [
    cooler_header(header: "FAN1"),
    unpopulated_header(header: "FAN2"),
    chassis_bay_header(header: "FAN3"),
    chassis_bay_header(header: "FAN4"),
    chassis_bay_header(header: "FAN5"),
  ],
}

data srv4_fan_population: HostFanPopulation = HostFanPopulation {
  host: operator_host_srv4,
  headers: [
    cooler_header(header: "FAN1"),
    chassis_bay_header(header: "FAN2"),
    chassis_bay_header(header: "FAN3"),
    chassis_bay_header(header: "FAN4"),
    unpopulated_header(header: "FAN5"),
  ],
}

data fleet_fan_populations: List<HostFanPopulation> = [
  srv1_fan_population,
  srv2_fan_population,
  srv3_fan_population,
  srv4_fan_population,
]

fn fan_population_for_host(host: HostIdentity) -> HostFanPopulation? {
  fold(
    fleet_fan_populations,
    init: none,
    f: (acc, population) =>
      match acc {
        Present { value } => Present { value: value }
        none =>
          if population.host == host {
            Present { value: population }
          } else {
            none
          }
      },
  )
}

// LIVE OBSERVATIONS, 2026-08-26, five reads per header per host via BMC Redfish.
// These are the readings the verdict is judged against. srv1's FAN4/FAN5 and srv3's FAN2 all
// read absent; the whole point of this module is that they are NOT the same finding.
data srv1_observed_tachs_2026_08_26: List<FanTachObservation> = [
  FanTachObservation { header: "FAN1", reading: Present { value: rpm(1219) } },
  FanTachObservation { header: "FAN2", reading: Present { value: rpm(942) } },
  FanTachObservation { header: "FAN3", reading: Present { value: rpm(947) } },
  FanTachObservation { header: "FAN4", reading: none },
  FanTachObservation { header: "FAN5", reading: none },
]

data srv3_observed_tachs_2026_08_26: List<FanTachObservation> = [
  FanTachObservation { header: "FAN1", reading: Present { value: rpm(6033) } },
  FanTachObservation { header: "FAN2", reading: none },
  FanTachObservation { header: "FAN3", reading: Present { value: rpm(1578) } },
  FanTachObservation { header: "FAN4", reading: Present { value: rpm(1033) } },
  FanTachObservation { header: "FAN5", reading: Present { value: rpm(1540) } },
]

fn srv1_failure_count() -> Int {
  fan_population_failure_count(
    population: srv1_fan_population,
    observations: srv1_observed_tachs_2026_08_26,
  )
}

fn srv3_failure_count() -> Int {
  fan_population_failure_count(
    population: srv3_fan_population,
    observations: srv3_observed_tachs_2026_08_26,
  )
}

fn srv3_populated_headers() -> Int { populated_header_count(population: srv3_fan_population) }
fn srv1_populated_headers() -> Int { populated_header_count(population: srv1_fan_population) }

// THE DISCRIMINATING WITNESS. Each conjunct fails independently if the model stops making the
// distinction it exists to make. The load-bearing pair is the last two: srv3's FAN2 and srv1's
// FAN4 are BYTE-IDENTICAL observations - both `reading: none` - and they must produce different
// verdicts. Any change that collapses the population arms turns the pair equal and this goes red.
fn fan_population_witness() -> ProcessExit {
  let srv1_headers = populated_header_count(population: srv1_fan_population)
  let srv3_headers = populated_header_count(population: srv3_fan_population)
  let srv4_headers = populated_header_count(population: srv4_fan_population)
  let srv1_failures = fan_population_failure_count(
    population: srv1_fan_population,
    observations: srv1_observed_tachs_2026_08_26,
  )
  let srv3_failures = fan_population_failure_count(
    population: srv3_fan_population,
    observations: srv3_observed_tachs_2026_08_26,
  )
  let srv3_fan2 = fan_header_verdict(
    population: srv3_fan_population,
    observation: FanTachObservation { header: "FAN2", reading: none },
  )
  let srv1_fan4 = fan_header_verdict(
    population: srv1_fan_population,
    observation: FanTachObservation { header: "FAN4", reading: none },
  )
  let srv3_fan2_nominal = match srv3_fan2 {
    FanNominalAbsentByDesign { header } => true
    other => false
  }
  let srv1_fan4_failed = match srv1_fan4 {
    FanFailedNotTurning { header, role } => true
    other => false
  }
  if srv1_headers == 5
    && srv3_headers == 4
    && srv4_headers == 4
    && srv1_failures == 2
    && srv3_failures == 0
    && srv3_fan2_nominal
    && srv1_fan4_failed {
    ExitSuccess
  } else {
    exit_failure(reason: "fan population witness: derived header counts or absent-vs-failed discrimination changed")
  }
}
