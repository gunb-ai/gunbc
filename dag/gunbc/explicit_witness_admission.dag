fn explicit_witness_admission_matches(
  row: ExplicitWitnessAdmission,
  entry: String,
  function: String
) -> Bool {
  (row.witness.entry == entry)
    && ((row.witness.function == function) || (row.witness.function == ""))
}

data explicit_witness_admission_file_grain_note: String = "The empty function is ScheduleWitnessEntry's declared file-grain form (the same authority v1_claim_scoped_witness_batch_note names and expand_explicit_entries realizes for execution): it admits every test declaration in the entry. It is still EXACT — the entry is a path identity, not a substring — which is what separates it from the path policy carrier. Today no known-red row uses it; the arm exists so the derivations stay one fold when a cadence that does use it migrates in."

fn explicit_witness_admission_covers_in(
  rows: List<ExplicitWitnessAdmission>,
  entry: String,
  function: String
) -> Bool {
  fold(
    rows,
    init: false,
    f: fn(found, row) {
      found || explicit_witness_admission_matches(row: row, entry: entry, function: function)
    }
  )
}

fn explicit_witness_admission_covers(entry: String, function: String) -> Bool {
  explicit_witness_admission_covers_in(
    rows: explicit_witness_admissions,
    entry: entry,
    function: function
  )
}

fn explicit_witness_admission_covers_entry(entry: String) -> Bool {
  fold(
    explicit_witness_admissions,
    init: false,
    f: fn(found, row) { found || (row.witness.entry == entry) }
  )
}

fn explicit_witness_admission_count_for_in(
  rows: List<ExplicitWitnessAdmission>,
  entry: String,
  function: String
) -> Int {
  fold(
    rows,
    init: 0,
    f: fn(n, row) {
      if explicit_witness_admission_matches(row: row, entry: entry, function: function) {
        n + 1
      } else {
        n
      }
    }
  )
}

fn explicit_witness_admission_duplicate_count_in(rows: List<ExplicitWitnessAdmission>) -> Int {
  fold(
    rows,
    init: 0,
    f: fn(n, row) {
      if explicit_witness_admission_count_for_in(
        rows: rows,
        entry: row.witness.entry,
        function: row.witness.function
      ) > 1 {
        n + 1
      } else {
        n
      }
    }
  )
}

fn explicit_witness_admission_duplicate_count() -> Int {
  explicit_witness_admission_duplicate_count_in(rows: explicit_witness_admissions)
}

data explicit_witness_admission_polarity_source_note: String = "POLARITY IS READ FROM THE EXPECTATION AXIS, NOT THE CADENCE. This predicate matched row.cadence until the axis split: QuarantineProbeExpectRed => true, every other arm false. That made the batch a witness's polarity — an expensive known-red row moved onto a long batch to obtain its budget silently became expected-GREEN, which is exactly how a witness that is red BY DESIGN reached the falsifier alert as a component failure. Reading row.expected instead means moving a row between consumers cannot change what counts as agreement, and a mixed batch is ordinary rather than a trap."

fn explicit_witness_admission_is_known_red(row: ExplicitWitnessAdmission) -> Bool {
  match row.expected {
    ExpectAssertionFalse => true
    ExpectTypedPreVerdictRefusal { phase: _, cause: _ } => true
    ExpectWitnessHolds => false
  }
}

fn explicit_witness_admission_is_executing_witness(row: ExplicitWitnessAdmission) -> Bool {
  match row.expected {
    ExpectWitnessHolds => true
    ExpectAssertionFalse => false
    ExpectTypedPreVerdictRefusal { phase: _, cause: _ } => false
  }
}

fn explicit_witness_admission_executing_witness_roster() -> List<std.realization_schedule.ScheduleWitnessEntry> {
  reverse(fold(
    explicit_witness_admissions,
    init: Empty,
    f: fn(acc, row) {
      if explicit_witness_admission_is_executing_witness(row: row) {
        Cons { head: row.witness, tail: acc }
      } else {
        acc
      }
    }
  ))
}

fn explicit_witness_admission_requires_long_eval_budget(row: ExplicitWitnessAdmission) -> Bool {
  match row.budget {
    SubstrateLongLaneEvalBudget => true
    FastLaneEvalBudget => false
  }
}

data explicit_witness_admission_long_budget_roster_note: String = "The budget half of the split, derived. gunbc.ci_layer_roots unions this with the long-lane BATCH roster to give the scheduler its ceiling condition, so a row obtains its required eval time from its own declaration and never by joining a second batch. The union is the whole mechanism: batch membership still routes execution, this roster only sizes the ceiling, and the residual (declared by neither) keeps the fast lane so an undeclared lane reds at 5s rather than running unbounded."

fn witness_long_eval_budget_roster() -> List<std.realization_schedule.ScheduleWitnessEntry> {
  reverse(fold(
    explicit_witness_admissions,
    init: Empty,
    f: fn(acc, row) {
      if explicit_witness_admission_requires_long_eval_budget(row: row) {
        Cons { head: row.witness, tail: acc }
      } else {
        acc
      }
    }
  ))
}

fn known_red_probe_roster_of_kind(kind: std.realization_schedule.WitnessKind) -> List<std.realization_schedule.ScheduleWitnessEntry> {
  reverse(fold(
    explicit_witness_admissions,
    init: Empty,
    f: fn(acc, row) {
      if explicit_witness_admission_is_known_red(row: row)
        && witness_kind_eq(a: row.witness.kind, b: kind) {
        Cons { head: row.witness, tail: acc }
      } else {
        acc
      }
    }
  ))
}

fn known_red_entry_is_v1_scoped(entry: String) -> Bool {
  starts_with(s: entry, prefix: "src/v1/")
}

data known_red_v1_envelope_dag_entries: List<String> = []

data known_red_v1_envelope_dag_entries_note: String = "dag/test/claim witnesses that import v1.* AND are enrolled QuarantineProbeExpectRed in explicit_witness_admissions — both are required for known_red_probe_v1_envelope_roster. Path prefix alone cannot detect v1 imports; this list names dag witnesses that need the dag plus src/v1 envelope beside v1_claim_scoped_witness_batch. Empty while no known-red row needs that envelope; enrolling a row here without the companion clamp row in gunbc_ci_floor_batch_clamp_params fails the ENROLLMENT COUPLING clause in v1_claim_scoped_known_red_probe_batch_note. Dissolve-on when closure-independent binding makes the envelope unnecessary."

fn known_red_entry_is_v1_envelope_dag_entry(entry: String) -> Bool {
  fold(
    known_red_v1_envelope_dag_entries,
    init: false,
    f: fn(found, path) { found || (entry == path) }
  )
}

fn known_red_entry_needs_v1_envelope(entry: String) -> Bool {
  known_red_entry_is_v1_scoped(entry: entry)
    || known_red_entry_is_v1_envelope_dag_entry(entry: entry)
}

fn known_red_probe_corpus_roster() -> List<std.realization_schedule.ScheduleWitnessEntry> {
  reverse(fold(
    known_red_probe_roster_of_kind(kind: CorpusWitnessKind),
    init: Empty,
    f: fn(acc, witness) {
      if known_red_entry_needs_v1_envelope(entry: witness.entry) {
        acc
      } else {
        Cons { head: witness, tail: acc }
      }
    }
  ))
}

data known_red_probe_budget_partition_note: String = "The known-red probe lane partitions into BUDGET-HOMOGENEOUS batches, and the partition is DERIVED from each row's declared budget rather than naming any witness (operator ruling, 2026-08-06). The first shape of the budget separation left the lane one mixed batch and let the eval ceiling be armed for it as a whole, because claim_executor scopes a ceiling to a batch; that raised the ceiling for every fast row sharing the batch with one declared-long row — a real widening, disclosed but still a widening, and the ceiling is the only thing standing between a runaway fast witness and the step budget. Two batches over the same roster remove it: each batch is homogeneous in declared budget, so the ceiling it arms is the budget its rows actually declared and no row is widened by a neighbour. Nothing here is a singleton and nothing names direct_rust — the long population is whatever declares SubstrateLongLaneEvalBudget, so it grows and shrinks with the admission rows and an empty side schedules no batch at all. Dissolve-on is unchanged and shared with witness_long_eval_budget_entries_note: per-witness declared cost envelopes replace the lane ceiling entirely, at which point the partition collapses back to one batch because every row carries its own bound."

data known_red_probe_expectation_partition_note: String = "The lane partitions on BOTH axes, and the second half was missing until review caught it (cursor review 50216, 2026-08-07). Budget homogeneity alone still let an ExpectTypedPreVerdictRefusal row share a batch with ExpectAssertionFalse rows, and those two cannot coexist: a pre-verdict row stops the whole batch at RESOLVE, so no per-witness outcome exists for anyone, and the Err arm admits that stop only when EVERY entry declared a pre-verdict refusal. One pre-verdict row in a mixed batch therefore reds its siblings, which were holding quarantine correctly — the batch-wide coupling this PR exists to remove, reintroduced one axis over. So the corpus lane splits first by EXPECTATION KIND and then by DECLARED BUDGET: a batch is homogeneous in the fact that decides its verdict AND in the ceiling it needs. Note the pre-verdict batches are non-green by construction today (a declaration classifies a stop, it does not verify it), so the point of isolating them is not to make them pass — it is that their refusal stays THEIR refusal, located and countable, instead of being spread over rows it says nothing about."

fn known_red_probe_corpus_assertion_false_roster() -> List<std.realization_schedule.ScheduleWitnessEntry> {
  reverse(fold(
    known_red_probe_corpus_roster(),
    init: Empty,
    f: fn(acc, witness) {
      if schedule_witness_entry_roster_contains(
        xs: known_red_pre_verdict_refusal_roster(),
        w: witness
      ) {
        acc
      } else {
        Cons { head: witness, tail: acc }
      }
    }
  ))
}

fn known_red_probe_corpus_pre_verdict_roster() -> List<std.realization_schedule.ScheduleWitnessEntry> {
  reverse(fold(
    known_red_probe_corpus_roster(),
    init: Empty,
    f: fn(acc, witness) {
      if schedule_witness_entry_roster_contains(
        xs: known_red_pre_verdict_refusal_roster(),
        w: witness
      ) {
        Cons { head: witness, tail: acc }
      } else {
        acc
      }
    }
  ))
}

fn known_red_probe_corpus_pre_verdict_long_budget_roster() -> List<std.realization_schedule.ScheduleWitnessEntry> {
  reverse(fold(
    known_red_probe_corpus_pre_verdict_roster(),
    init: Empty,
    f: fn(acc, witness) {
      if schedule_witness_entry_roster_contains(
        xs: witness_long_eval_budget_roster(),
        w: witness
      ) {
        Cons { head: witness, tail: acc }
      } else {
        acc
      }
    }
  ))
}

fn known_red_probe_corpus_pre_verdict_fast_budget_roster() -> List<std.realization_schedule.ScheduleWitnessEntry> {
  reverse(fold(
    known_red_probe_corpus_pre_verdict_roster(),
    init: Empty,
    f: fn(acc, witness) {
      if schedule_witness_entry_roster_contains(
        xs: witness_long_eval_budget_roster(),
        w: witness
      ) {
        acc
      } else {
        Cons { head: witness, tail: acc }
      }
    }
  ))
}

fn known_red_probe_corpus_long_budget_roster() -> List<std.realization_schedule.ScheduleWitnessEntry> {
  reverse(fold(
    known_red_probe_corpus_assertion_false_roster(),
    init: Empty,
    f: fn(acc, witness) {
      if schedule_witness_entry_roster_contains(
        xs: witness_long_eval_budget_roster(),
        w: witness
      ) {
        Cons { head: witness, tail: acc }
      } else {
        acc
      }
    }
  ))
}

fn known_red_probe_corpus_fast_budget_roster() -> List<std.realization_schedule.ScheduleWitnessEntry> {
  reverse(fold(
    known_red_probe_corpus_assertion_false_roster(),
    init: Empty,
    f: fn(acc, witness) {
      if schedule_witness_entry_roster_contains(
        xs: witness_long_eval_budget_roster(),
        w: witness
      ) {
        acc
      } else {
        Cons { head: witness, tail: acc }
      }
    }
  ))
}

fn known_red_pre_verdict_refusal_roster() -> List<std.realization_schedule.ScheduleWitnessEntry> {
  reverse(fold(
    explicit_witness_admissions,
    init: Empty,
    f: fn(acc, row) {
      match row.expected {
        ExpectTypedPreVerdictRefusal { phase: _, cause: _ } => Cons { head: row.witness, tail: acc }
        ExpectAssertionFalse => acc
        ExpectWitnessHolds => acc
      }
    }
  ))
}

fn known_red_probe_v1_envelope_roster() -> List<std.realization_schedule.ScheduleWitnessEntry> {
  reverse(fold(
    known_red_probe_roster_of_kind(kind: CorpusWitnessKind),
    init: Empty,
    f: fn(acc, witness) {
      if known_red_entry_needs_v1_envelope(entry: witness.entry) {
        Cons { head: witness, tail: acc }
      } else {
        acc
      }
    }
  ))
}

fn known_red_probe_execution_roster() -> List<std.realization_schedule.ScheduleWitnessEntry> {
  known_red_probe_roster_of_kind(kind: ExecutionWitnessKind)
}

data explicit_witness_admission_cadence_wall_note: String = "Only a cadence that EXECUTES may appear on an admission row: an admission is the statement that this witness runs somewhere, so DiscoverySelection (which is the absence of an admission), OfflineLocalRecipe and FixtureExplicitRoster (which are path policies, not executing consumers) and NoConsumer (which is the refusal itself) are all refused here by explicit_witness_admission_cadence_executes. Without that arm an author could write an admission whose cadence runs nothing and satisfy the every-witness-has-a-consumer wall with a row that executes nowhere — the coverage-by-illusion tier, one enum arm away."

fn explicit_witness_admission_cadence_executes(cadence: std.witness_admission.WitnessConsumerCadence) -> Bool {
  match cadence {
    QuarantineProbeExpectRed => true
    FalsifierSelfHostWet => true
    FalsifierRehomedBinWet => true
    FalsifierSubstrateLongLane => true
    BinWitnessWet => true
    DiscoverySelection => false
    OfflineLocalRecipe => false
    FixtureExplicitRoster => false
    NoConsumer => false
  }
}

fn explicit_witness_admission_well_formed(row: ExplicitWitnessAdmission) -> Bool {
  !(row.witness.entry == "")
    && explicit_witness_admission_cadence_executes(cadence: row.cadence)
}

fn explicit_witness_admissions_well_formed_in(rows: List<ExplicitWitnessAdmission>) -> Bool {
  fold(
    rows,
    init: true,
    f: fn(ok, row) { ok && explicit_witness_admission_well_formed(row: row) }
  )
}

fn explicit_witness_admissions_well_formed() -> Bool {
  explicit_witness_admissions_well_formed_in(rows: explicit_witness_admissions)
}
