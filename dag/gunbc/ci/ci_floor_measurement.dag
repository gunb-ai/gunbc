]

type SessionOperatingPoint
  = SessionOperatingPointSet { per_session_cap: ByteSize, session_concurrency: Int }
  | SessionOperatingPointUnset

type OomdEnforcementEvidence
  = OomdEnforced
  | OomdUnverified

type RunnerSliceCapEffectiveness
  = CapEffective { bytes: ByteSize }
  | CapUnbounded

// THE REGIME-2 AGGREGATE IS DELETED AT THE ROOT. It declared SessionAggregateMeasured over
// 21474836480 bytes -- a round power of two with no derivation from the thirteen measured
// per-session samples in this same module -- and applied it to every host. Its scaffold marker
// named a dissolution that never came; what replaced it is gunbc.session_reservation_policy, which
// answers the aggregate PER HOST from cited observations, and gunbc.session_admission_policy, which
// carries the per-session ceiling and the concurrency that shared the deleted constructor.
//
// REGIME-1 SURVIVES AND IS NOT A LIVE RESERVATION. It scores candidate (cap, concurrency) pairs for
// the operating curve in gunbc.ci_runner_placement -- a design-space explorer, not an answer about
// any host.
type SessionReservationMode
  = Regime1WorstCase { point: SessionOperatingPoint }
  | SessionReservationModeUnset

data gunbc_ci_footprint_granularity_disposition: Disposition = Terminal { reason: "DESIGN §3 deliberate two-concerns split, revised 2026-07-12: INTER-run whole-run cgroup peak (gunbc_ci_job_peaks) governs co-residence - how many runs share a host, feeding the conserving budget tree; WITHIN-run parallelism is governed at run time by the memory governor against the slot's own cgroup budget (the former within-run per-shard-peak carrier and its width fold are retired). Different granularity, different scheduling decision, different consumer. Do not re-fuse them into one authority." }

data gunbc_ci_footprint_bridge_disposition: Disposition = Terminal { reason: "Deferred unification path (acknowledged, not attempted): INTER-run whole-run peak is plausibly governor-width x measured per-worker residency + base, so the INTER-run footprint could eventually derive from within-run measured receipts (the executor's [measurement]/[governor] lines) - the real single authority. Held back deliberately: derive only from measured receipts, never from authored predictions (the retired width-fold constants are the cautionary receipt)." }


data gunbc_ci_concurrent_runs_conservative_high_disposition: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.ci_runner_placement",
    decl_name: "runner_deployment_plan",
    field: WholeDeclaration
  }
}
