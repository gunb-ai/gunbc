module gunbc.ci.ci_budget_raise

import std.types { Bool, List, String }
import std.measure { Minute, minute, measure_le }
import std.optional { Present, Absent, Optional }
import std.list { first_where }
import gunbc.design_ruling { DesignRuling }

// A CI BUDGET IS CLOSED TO GROWTH (ruling gunbc.design_ruling ci_job_budgets_closed_to_growth): a job or step
// timeout, or the row it derives from, may rise above its previously approved value only on the operator's explicit
// sign-off, recorded as its own ruling row with the operator's words verbatim (the precedents:
// printer_ci_budget_raised_for_the_four_hour_card, serve_entry_verdict_step_raised_to_45_minutes). Until now that
// recording was a comment beside the budget, so a raise with no row behind it was writable and nothing refused it.
// This carrier makes the row the budget's admission, and the admission the value the budget RUNS AT: a budget's
// approvals are declared beside it, oldest first, the value it requires is admitted only under an approval that
// covers it, and the emitted budget is budget_admitted_minutes -- never the required value on its own.
//
// THE APPROVALS, oldest first:
// - IntroducedWithTheStep: the value the budget first landed at. A new step's budget raises no approved value,
//   so its introduction is not a raise; `carried_by` names the change that introduced it.
// - RaisedBySignoff: a raise, carrying the ruling row with the operator's words. There is no pending form: a row in
//   gunbc.design_ruling exists only once the operator's words do, so a raise that has been asked for and not
//   answered has NO approval here, and its admission refuses as BudgetRaiseUnapproved (reviews 96483 on
//   gunb-ai/gunbc#16668 and 96505 on gunb-ai/gunbc#16691). The request lives where it was put to the operator.
type BudgetApproval
  = IntroducedWithTheStep { minutes: Minute, carried_by: String }
  | RaisedBySignoff { minutes: Minute, ruling: DesignRuling }

// THE ADMISSION. The required value is admitted under the FIRST approval, oldest first, whose minutes cover it, so a
// value inside an earlier approval needs no later raise. Covered by nothing: a raise with no row behind it, refused
// naming the highest approved value -- the value the budget runs at instead (budget_admitted_minutes).
type BudgetAdmission
  = BudgetAdmitted { minutes: Minute, approval: BudgetApproval }
  | BudgetRaiseUnapproved { minutes: Minute, highest_approved: Minute }

fn budget_approval_minutes(approval: BudgetApproval) -> Minute {
  match approval {
    IntroducedWithTheStep { minutes: m, carried_by: _ } => m
    RaisedBySignoff { minutes: m, ruling: _ } => m
  }
}

fn budget_highest_approved(approvals: List<BudgetApproval>) -> Minute {
  fold(approvals, init: minute(count: 0), f: fn(acc, a) { if measure_le(a: budget_approval_minutes(approval: a), b: acc) { acc } else { budget_approval_minutes(approval: a) } })
}

fn budget_admission(minutes: Minute, approvals: List<BudgetApproval>) -> BudgetAdmission {
  match first_where(xs: approvals, keep: fn(a) { measure_le(a: minutes, b: budget_approval_minutes(approval: a)) }) {
    Absent => BudgetRaiseUnapproved { minutes: minutes, highest_approved: budget_highest_approved(approvals: approvals) }
    Present { value: a } => BudgetAdmitted { minutes: minutes, approval: a }
  }
}

fn budget_admitted(admission: BudgetAdmission) -> Bool {
  match admission {
    BudgetAdmitted { minutes: _, approval: _ } => true
    BudgetRaiseUnapproved { minutes: _, highest_approved: _ } => false
  }
}

// THE VALUE THE BUDGET RUNS AT. Admitted: the required value. Unapproved: the highest approved value -- the budget
// stays where it was last approved, so an unsigned raise never reaches a generated workflow. That value is NOT a claim
// that it covers the required one: a consumer whose work needs the required value must read the admission and refuse
// while it is unapproved, never run its work under the smaller figure (gunbc.machine_intake.mtcollins1_bmc_cold_reset
// is the first such consumer).
fn budget_admitted_minutes(admission: BudgetAdmission) -> Minute {
  match admission {
    BudgetAdmitted { minutes: m, approval: _ } => m
    BudgetRaiseUnapproved { minutes: _, highest_approved: h } => h
  }
}
