type WorkloadClass
  = BatchLatencyTolerant
  | InteractiveLatencySensitive

data gunbc_ci_cpu_weight_unit_modeling_marker: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "std.measure",
    decl_name: "Measure",
    field: WholeDeclaration
  }
}

fn workload_class_cpu_weight(wc: WorkloadClass) -> Int {
  match wc {
    BatchLatencyTolerant => 100
    InteractiveLatencySensitive => 1000
  }
}

// 🟡 feature:task-count-measure-carrier dissolve-on: TaskCount measure carrier — per_runner_tasks_max is a pids-controller
// COUNT riding a bare Int while its memory siblings carry ByteSize; same dissolution as
// the ConvergeTarget.PerSlotMemoryCap → PerSlotUnitProperty P3 axis rework (a std.measure
// TaskCount, the HardwareThreadCount shape), which also retires the to_string() re-serialization
// at the host_converge knob seam.
// WHAT A RUNNER SLOT IS ENTITLED TO ON THE CPU, AS A CONTRACT AND NOT A HINT.
//
// systemd offers two different promises here and they are not aliases. CPUWeight= is a RELATIVE
// share against sibling cgroups: under contention it decides who yields first and guarantees no
// amount of anything. CPUQuota= is an ABSOLUTE ceiling on CPU time per wall second. AllowedCPUs=
// is a third thing again -- a pinning of the unit to named CPUs.
//
// CapacityQuota is the no-overcommit contract this fleet adopts: each slot may consume at most
// cores_per_slot threads' worth of CPU time, and the sum of the runner, compile-pool and host
// reserve ceilings must fit the machine. Pinning each slot to a pairwise-disjoint SET of named CPUs
// is a stronger contract again, and this fleet does not make it; the block below records why it has
// no constructor rather than a variant.
//
// THE ARM THIS TYPE REPLACES WAS NEITHER OF THEM. cores_per_slot was consumed to decide how many
// units to create and then dropped, so the width was CPU-derived while the units it created carried
// no CPU directive at all -- srv1 and srv2 show MemoryMax as their only resource line, CPUWeight
// unset and CPUQuota infinity. Admission without confinement: the arithmetic said six threads per
// slot and the host was never told.
// THE PINNING CONTRACT HAS NO CONSTRUCTOR, AND THAT IS THE POINT RATHER THAN AN OMISSION.
//
// An earlier revision carried a DisjointCpuSet arm so the promise this fleet does NOT make would have
// a name. Review 57675 was right that naming it that way cost more than it bought: nothing produced
// it, extdeps.systemd carries no AllowedCPUs= to render it, and the emitter answered it with an empty
// knob list -- so a deployment carrying that boundary converged SUCCESSFULLY while the host was never
// told any CPU ceiling at all. A variant whose only realization is silence is a fail-open path
// (DESIGN 5), and labelling it "unemitted" in a manifest does not make the operational path refuse.
//
// So the arm is DELETED rather than answered with a refusal. Both remedies close the hole, and DESIGN
// 4b ranks them: construction over proof. A typed refusal would leave the invalid state writable and
// depend on the refusal executing; deleting the constructor means no Accepted program can carry a
// boundary this emitter cannot realize, which is the higher rung and the smaller change.
//
// The distinction it recorded survives as this annotation, which is where a promise nobody can
// construct belongs. CapacityQuota is a no-overcommit ceiling: each slot may consume at most its
// threads' worth of CPU time, and nothing pins it to particular CPUs. Pairwise-disjoint CPU sets are
// a STRONGER contract and a different systemd directive.
//
// TRIGGER for reinstating it as a variant: an AllowedCPUs directive in extdeps.systemd AND a producer
// that assigns disjoint sets -- both, since either alone reproduces exactly the unrealizable state
// this deletion removes.
type RunnerCpuBoundary
  = CapacityQuota { threads: HardwareThreadCount }

type RunnerCpuBoundaryResolution
  = RunnerCpuBoundaryDerived { boundary: RunnerCpuBoundary }
  | RunnerCpuBoundaryUnchargeable { reason: String }

// THE PER-SLOT CPU CEILING IS A FUNCTION OF WHERE COMPILER WORK IS CHARGED, AND cores_per_slot
// ALONE DOES NOT DETERMINE IT. Under CompilePoolInRunnerSlots the compiler children of a job run
// inside that job's own runner boundary, so the slot's ceiling is exactly its share and the host
// sum is runner_width * cores_per_slot + reserve. Under CompilePoolSliceDeclared those children are
// charged to a separate host pool instead, and the host sum gains a third term -- so the SAME
// per-slot number that conserves under the first topology over-commits under the second.
//
// On this fleet that is not a margin: 21 slots at 6 threads is 126 of 128, which leaves two threads
// for a pool that would then carry every cache-miss rustc on the host.
//
// So the arm REFUSES rather than emitting the quota it cannot justify. compile_pool_bytes_for
// charges the pool in BYTES and there is no CPU charge for it anywhere in the tree, so under the
// declared-slice topology this producer has no conserving allocation to state. The refusal is the
// point: it makes the topology flip impossible to land WITHOUT rederiving the width, rather than
// letting a quota authored under one topology survive silently into the other.
//
// NEXT-RUNG TRIGGER: a compile-pool CPU charge in the host allocation, at which point this arm
// derives a rebalanced width and ceiling instead of refusing.
fn runner_cpu_boundary_for(placement: CompilePoolPlacement, per_slot: HardwareThreadCount) -> RunnerCpuBoundaryResolution {
  match placement {
    CompilePoolInRunnerSlots => RunnerCpuBoundaryDerived { boundary: CapacityQuota { threads: per_slot } }
    CompilePoolSliceDeclared { slice_unit: u } =>
      RunnerCpuBoundaryUnchargeable {
        reason: concat("compile pool is a declared host slice and carries no modeled CPU charge, so a per-slot CPU ceiling derived from cores_per_slot alone would commit the host past its threads once that pool runs: rederive runner width and the per-slot ceiling together with the pool's CPU charge. Slice: ", u)
      }
  }
}

type RunnerHostDeployment {
  identity: HostIdentity
  runner_count: Int
  runner_slice_cap: ByteSize
  per_runner_memory_cap: ByteSize
  per_runner_memory_swap_cap: ByteSize
  per_runner_memory_high_cap: ByteSize
  per_runner_tasks_max: Int
  per_runner_cpu_boundary: RunnerCpuBoundary
  build_tokens: HardwareThreadCount
  runner: RunnerSpec
  workload_class: WorkloadClass
}

// THE REFUSAL CARRIER WAS AT THE WRONG GRAIN, AND RUN 33005091419 IS THE EXECUTION RECEIPT. The
// shape this replaces held ONE fleet-level unsound_reason String: a single host refusing dropped
// that host from the list, set the fleet reason, and made runner_deployment_plan return PlanUnsound
// -- discarding every host that HAD derived correctly. When srv2's session reservation became
// unestablished on measured evidence, 44 witnesses went red across six files, nine of them existing
// only to verify srv3's runner memory cap. srv2's unknown premise cannot establish anything about
// srv3, so absorbing ignorance about one host into a verdict about four is the absorbing fallback
// run in the refusal direction.
//
// The standing is: LOCAL REFUSAL, GLOBAL INCOMPLETENESS, NOT GLOBAL ERASURE.
//
// A single String also retained only the FIRST refusal, so two independently refused hosts could
// never both be reported. The list form fixes that structurally rather than by discipline.
type HostRunnerDeploymentRefusal
  = PrimaryCpuUnavailable { cause: String }
  | UsableRamUnavailable { cause: String }
  | SessionReservationUnestablished { cause: String }
  | FixedOverheadUnavailable { cause: String }
  | CompilePoolUnavailable { cause: String }
  | HostAllocationOversubscribedOnHost { cause: String }
  | HostAllocationUnchargeableOnHost { cause: String }
  | ZeroRunnerWidth
  | JobserverCitationAbsent { cause: String }
  | HostCpuAllocationUnchargeable { cause: String }
  | HostNotEnrolledInFleet

type RefusedHostDeployment {
  host: HostIdentity
  cause: HostRunnerDeploymentRefusal
}

type HostRunnerDeploymentStanding
  = HostRunnerDeploymentDerived { deployment: RunnerHostDeployment }
  | HostRunnerDeploymentRefused { refusal: RefusedHostDeployment }

type RunnerDeploymentPlan {
  hosts: List<HostRunnerDeploymentStanding>
}

// FLEET COMPLETENESS IS DERIVED FROM THE HOST RESULTS, NOT STORED BESIDE THEM. A stored flag is a
// second representation of what the list already says, and the two can disagree.
//
// The incomplete arm's run total is named known_derived_runs rather than fleet_concurrent_runs on
// purpose: it is the sum over the hosts that DID derive, and calling a partial sum by the name of a
// fleet total is how a reader takes it for capacity the fleet does not have.
type FleetDeploymentCompletion
  = FleetDeploymentComplete { deployments: List<RunnerHostDeployment>, fleet_concurrent_runs: Int }
  | FleetDeploymentIncomplete {
      derived_hosts: List<RunnerHostDeployment>,
      refused_hosts: List<RefusedHostDeployment>,
      known_derived_runs: Int,
    }

type SessionSliceResolution
  = SessionSliceResolved { bytes: ByteSize, per_session_cap: ByteSize, concurrency: Int }
  | SessionSliceUnresolved { reason: String }

fn resolve_regime1_slice(c: ByteSize, n: Int) -> SessionSliceResolution {
  if byte_size_count(b: c) == 0 {
    SessionSliceUnresolved { reason: "per-session cap is zero bytes: refuse a degenerate sessions-slice" }
  } else if n <= 0 {
    SessionSliceUnresolved { reason: "session concurrency is non-positive: refuse a degenerate sessions-slice" }
  } else {
    SessionSliceResolved {
      bytes: measure_scale_fraction_floor(m: c, num: n, den: 1),
      per_session_cap: c,
      concurrency: n,
    }
  }
}

// THE REGIME-2 ARM IS DELETED WITH THE FLEET-WIDE AGGREGATE IT READ. What remains is the REGIME-1
// worst-case evaluator, whose only consumer is the operating curve below -- a design-space explorer
// that scores candidate (cap, concurrency) pairs. It never answered a live host's reservation and
// does not now; gunbc.session_reservation_policy owns that question per host. The oomd parameter
// went with the arm: only Regime-2 consulted it, so carrying it here would be a dead input.
fn resolve_session_slice(mode: SessionReservationMode) -> SessionSliceResolution {
  match mode {
    SessionReservationModeUnset =>
      SessionSliceUnresolved {
        reason: "session reservation mode unset: the REGIME-1 worst-case evaluator needs a (cap, concurrency) candidate to score. This is the operating-curve explorer, not a live host reservation -- for that see gunbc.session_reservation_policy host_session_reservation_outcome."
      }
    Regime1WorstCase { point: p } =>
      match p {
        SessionOperatingPointUnset =>
          SessionSliceUnresolved { reason: "REGIME-1 operating point unset: refuse to score a worst-case candidate without a (cap, concurrency) pair" }
        SessionOperatingPointSet { per_session_cap: c, session_concurrency: n } =>
          resolve_regime1_slice(c: c, n: n)
      }
  }
}

data gunbc_ci_runner_count_from_budget_disposition: Disposition = Terminal { reason: "DESIGN conservation model: the runner count divides the DECLARED runner_pool_budget by the DECLARED per_runner_memory_cap (gunbc.fleet_host_budget). Soundness is host_allocation_verdict (node_conserves over runner_pool + session_pool + fixed_overhead + headroom + the control-plane charge <= host RAM), consumed as a coproduct so an unmeasured resident reports a measurement to take rather than a capacity deficit; it replaces the old chicken-and-egg RunnerSlotUnenforced gate (which refused to derive a count premised on a cap not yet enforced live). 'Is the cap live on the host' is no longer a plan-soundness question - it is a converge-receipt question. Session pool is charged from host_session_slice_resolution, and the REFUSAL lives in the accumulator that matches it (accumulate_conservation_deployment sets unsound_reason on SessionSliceUnsized), and host_session_slice_bytes is DELETED. That projection was total and mapped SessionSliceUnsized to byte_size(0); the clause above it claimed the zero was 'safe only under its current caller' while an external caller in test.claim.host_allocation_conservation was already spending it as a grounded charge, so the stated safety condition was false when it was written. It is deleted rather than kept behind a stronger warning, because the warning had already failed once: every consumer now matches host_session_slice_resolution and carries its own refusal arm for the unsized case. THE CLAUSE BEFORE THAT read 'the uniform 1 GiB demand class shared with the ctrl session dashboard', and both halves were false: the ctrl dashboard's per-container cap was a transcribed 31.27 GiB literal, 31x the figure claimed to be shared (since deleted -- it had no consumer in the budget tree), and the 1 GiB figure named a gunbc.fleet_host_budget literal with no derivation and no citation, since deleted. A sentence asserting that two carriers hold one class, where neither carrier claims a relation to the other, is the invented entailment that made an unsourced number look sourced." }

fn host_fixed_overhead_bytes(o: HostFixedOverhead) -> ByteSize {
  match o {
    HostFixedOverheadMeasured { bytes: b, provenance: _ } => b
    HostFixedOverheadAllowance { bytes: b, reason: _ } => b
    HostFixedOverheadUnmeasured => byte_size(0)
  }
}

// host_fixed_overhead_bytes maps Unmeasured to ZERO BYTES, and that arm is a fail-open this module must not consume directly. Zero overhead makes a host look like it has its entire RAM available for runners, which is the most permissive possible answer to a question nobody answered — the absorbing fallback in the input to a conservation wall. The arm is retained because the function is a total projection and callers legitimately fold over it, but accumulate_conservation_deployment refuses on Unmeasured BEFORE reaching it (host_overhead_or_refusal), so the zero is unreachable on the plan path. Retained rather than deleted because deleting it would only move the totality problem to every caller.
type HostOverheadResolution
  = HostOverheadResolved { bytes: ByteSize }
  | HostOverheadUnresolved { reason: String }

fn host_overhead_or_refusal(host: HostIdentity, o: HostFixedOverhead) -> HostOverheadResolution {
  match o {
    HostFixedOverheadMeasured { bytes: b, provenance: _ } => HostOverheadResolved { bytes: b }
    HostFixedOverheadAllowance { bytes: b, reason: _ } => HostOverheadResolved { bytes: b }
    HostFixedOverheadUnmeasured =>
      HostOverheadUnresolved {
        reason: concat("host fixed overhead is unmeasured and carries no operator allowance, so the share of RAM this host spends on residents the budget does not model is unknown: refuse to derive a runner width rather than charge zero (which would silently hand the host its whole RAM) or borrow another host's number. Classify it in gunbc.ci_floor_measurement gunbc_ci_host_fixed_overhead_for. Host: ", host)
      }
  }
}

// build_tokens IS A DERIVED COMPILE-POOL BUDGET AND NOT THE HOST'S THREAD COUNT. This parameter was
// `nproc` and was stored raw, so the compile concurrency written into the jobserver's configuration
// was every hardware thread on the machine -- 128 on this fleet -- while extdeps.jobserver already
// carried the installed daemon's own formula, cited term for term from its defaults:
// min(cores - margin, floor((MemTotal - reserve) / mib_per_job)).
//
// TWO PRODUCERS FOR ONE NUMBER IS THE DEFECT, not the size of either. The compile pool could be
// sized from the derivation while the host was converged to nproc, and nothing joined them. The
// derivation is the one that survives, because it is the one that charges memory: a purely
// core-shaped count admits more concurrent rustc than RAM can hold, which is the class the daemon's
// own header records as the reason the memory bound exists.
fn conservation_host_deployment(offer: ComputeOffer, build_tokens: HardwareThreadCount, cpu_boundary: RunnerCpuBoundary) -> RunnerHostDeployment {
  RunnerHostDeployment {
    identity: offer.supply.physical.identity,
    runner_count: gunbc_runner_slots_per_host(host: offer.supply.physical.identity),
    runner_slice_cap: gunbc_runner_pool_budget_for(host: offer.supply.physical.identity),
    per_runner_memory_cap: gunbc_ci_runner_cgroup_memory_cap,
    per_runner_memory_swap_cap: gunbc_runner_slot_desired().memory_swap_max,
    per_runner_memory_high_cap: gunbc_runner_slot_desired().memory_high,
    per_runner_tasks_max: gunbc_runner_slot_desired().tasks_max,
    per_runner_cpu_boundary: cpu_boundary,
    build_tokens: build_tokens,
    runner: runner_spec_from_offer(offer: offer),
    workload_class: BatchLatencyTolerant,
  }
}

// WHICH HOSTS OWE A SESSIONS RESERVATION comes from gunbc.session_residency, the authority for
// where interactive session containers actually live. It does NOT come from the build-cache roster,
// and the correction is recorded because the proxy came within one cleanup of causing the bug this
// charge exists to prevent.
//
// The original derivation asked whether gunbc.build_cache_instance listed an
// InteractiveSessionCompiles instance for the host. That correlated with session residency and
// nothing more. When ctrl-sccache.service was deleted from srv1 and srv2 on 2026-08-06 as provably
// dead — 29MB in 45 days, zero connections, zero writes in a week, because containers cache to
// their own in-container path — the obvious follow-up of dropping those roster rows would have
// stopped charging both hosts their 20GiB reservation, and the conservation wall would then have
// admitted 7 slots each and overcommitted them by ~17GiB while returning true.
//
// Sessions consume host RAM whether or not a shared build cache exists for them; srv1 and srv2 were
// each running 19 session containers at the moment their session cache was found dead. The charge
// follows residency.
//
// THE RESERVATION SIZE IS NOW A PER-HOST QUESTION WITH A PER-HOST ANSWER, and the paragraph this
// replaces described the fleet-wide row that answered it before. That row --
// gunbc_ci_session_reservation_mode, a Regime-2 aggregate of exactly 21474836480 bytes, a round
// power of two with no derivation from the thirteen measured per-session samples beside it -- is
// DELETED. gunbc.session_reservation_policy answers per host from observed evidence, and the
// sentence is rewritten rather than annotated because a note describing a deleted authority in the
// present tense is premise contamination whichever direction it points.

// AN UNSIZED SESSION SLICE ON A SESSION HOST REFUSES, because the alternative is the bug this
// change exists to remove, re-entering through a different door. The first draft of this function
// returned byte_size(0) whenever the reservation mode could not produce a number —
// SessionAggregateUnmeasured, SessionOperatingPointUnset, SessionReservationModeUnset — which reads
// as 'sessions cost nothing' and is exactly the unconditional zero that let srv1 and srv2 score as
// though 20GiB of reservation were free. Fixing the WHERE (a host carries sessions) while leaving
// the HOW MUCH silently zero would have moved the defect rather than closed it.
//
// The distinction the arms preserve: a host with NO session instance genuinely owes nothing, and
// SessionSliceNotApplicable says so. A host that DOES carry one and cannot size it is unknown, not
// free, and SessionSliceUnsized refuses the whole plan with a located reason. Those are different
// states and one of them is safe.
//
// THE REFUSAL IS NO LONGER DORMANT, and that is the change the host-keyed policy made rather than a
// defect it introduced. The fleet-wide row resolved for every host by construction, so
// SessionSliceUnsized was unreachable; srv2's reservation is now UNESTABLISHED on measured evidence
// -- its session denominator is incomplete -- so this arm fires on a real host today. A
// conservation plan that includes srv2 refuses, which is the correct reading of not knowing the
// largest non-runner claim on this machine, and is exactly what the arm was written for.

type HostSessionSliceResolution
  = SessionSliceCharged { bytes: ByteSize }
  | SessionSliceNotApplicable
  | SessionSliceUnsized { reason: String }

// TWO AUTHORITIES, TWO QUESTIONS, AND THEY ARE DELIBERATELY NOT MERGED. gunbc.session_residency
// owns WHETHER a host carries interactive sessions; gunbc.session_reservation_policy owns HOW MUCH
// is reserved for them. Sourcing both from the reservation table would have made it a second
// answer to the residency question, which is the nicknaming violation DESIGN 3 forbids -- and the
// residency module's unknown arm charges rather than exempts on purpose, a polarity a size table
// has no business re-deciding.
//
// THE DISAGREEMENT ARM IS NOT DEAD CODE. Residency saying "sessions here" while the size table says
// "not applicable" is a contradiction between two live authorities, and the safe reading is the
// expensive one: refuse. Silently taking NotApplicable would drop the largest non-runner claim on a
// host residency says is carrying sessions, which is precisely the overcommit this wall exists to
// stop. It is empty today because the two agree on all four hosts; empty is not unreachable.
// PLACEMENT NO LONGER PERFORMS THE JOIN, it translates the outcome. The earlier shape asked
// residency here with an if, then matched the sizing table inside the true branch only -- so the
// sizing table was never inspected on the residency-false branch and an allowance authored for a
// session-free host was silently ignored. The join in gunbc.session_reservation_policy reads both
// authorities unconditionally and owns all four combinations; this function only maps its verdict
// onto the resolution shape the conservation accumulator consumes.
fn host_session_slice_resolution(host: HostIdentity) -> HostSessionSliceResolution {
  match host_session_reservation_outcome(host: host) {
    SessionReservationCharged { bytes: b, evidence_floor: _ } => SessionSliceCharged { bytes: b }
    SessionReservationNotApplicable { residency_evidence: _ } => SessionSliceNotApplicable
    SessionReservationUnsized { cause: why } =>
      SessionSliceUnsized {
        reason: concat("no session reservation is established for this host, so the largest non-runner claim on it is unknown: refuse to derive a runner width rather than charge zero for it. Cause: ", why, " Host: ", host)
      }
    SessionReservationAuthorityDisagreement { cause: why } =>
      SessionSliceUnsized {
        reason: concat("gunbc.session_residency and gunbc.session_reservation_policy disagree about this host: ", why, " Host: ", host)
      }
  }
}

// CONSERVATION IS CHECKED AGAINST OS-USABLE RAM, NOT THE DIMM TOTAL. compute_host_ram_bytes_total
// sums the populated modules -- nominal capacity -- while the OS sees less after firmware and
// kernel reservations, and gunbc.ci_fleet fleet_host_memory_nominal_vs_usable_note exists
// specifically to say these are two facts that must not be conflated. The margin decides admissions
// rather than being academic: at the 128 GiB nominal / 125 GiB usable population this fleet carried
// until 2026-08-22, an eighth 14 GiB slot summed to 125.6 GiB, which PASSED against nominal and
// FAILED against usable -- so checking the nominal figure would admit a width the machine cannot
// carry, by spending memory that does not exist.
//
// THE UNIFORM-POPULATION PREMISE HAS NOW ACTUALLY FALSIFIED, AND THIS PARAGRAPH IS THE THIRD
// REVISION OF THAT CLAIM -- which is itself the finding. The premise was: every host on the same
// board at the same population, so one figure stands in for all four. It was declared falsified
// once on an in-flight report of a DIMM replacement, then RESTORED when that replacement was
// reported failed (operator, 2026-08-12), with a note saying that marking a true statement
// historical is the same defect as leaving a false one live. Both of those were correct at the
// time. Both are now superseded by measurement: srv3 and srv4 were each read at 512 GiB over BMC
// Redfish on 2026-08-22 (8 x Samsung M393A8G40D40-CRB, one per channel), srv1 was upgraded to the
// same population on operator report, and srv2's identical attempt failed memory training and was
// reverted to 8 x 16 GiB Hynix. The fleet is HETEROGENEOUS as of that date and the premise is dead
// for the first time in this note's history.
//
// WHAT THAT DOES NOT LICENSE, because it is the move this note has always existed to forbid: the
// 512 GiB figure is NOMINAL DIMM CAPACITY read from a management controller. It is NOT OS-usable
// RAM and must not be written into gunbc_ci_host_usable_ram_for. The gap was closed on two hosts
// the only way it can be: srv3 and srv4 now carry MEASURED usable RAM from /proc/meminfo reads
// taken over SSH on 2026-08-22, about 502.25 GiB each -- roughly 10 GiB BELOW their nominal 512,
// which is exactly the firmware-and-kernel reservation this note exists to preserve. THAT GAP IS
// NOW CLOSED ON ALL FOUR HOSTS AND THIS PARAGRAPH'S PREVIOUS REVISION WAS STALE RATHER THAN
// WRONG-AT-THE-TIME. It read that srv1 and srv2 had taken no such read and that their rows remained
// conservative lower bounds; both took ordinary /proc/meminfo reads over SSH on 2026-08-23, so
// gunbc.ci_floor_measurement now carries HostUsableRamMeasured for every host and
// gunbc_ci_conservative_lower_bound_retired_note records the borrowed bound's deletion. The
// correction matters beyond tidiness: a reader sizing srv1 against the retired 125 GiB figure would
// under-admit a host with about four times that much, and a reader who believed the bound was still
// live would look for a measurement obligation that no longer exists. srv2's read is the sharper
// receipt -- it landed about 96 MiB ABOVE the bound it replaced, so that bound was not merely loose
// but on the wrong side, and a lower bound that is too high is not conservative at all. Neither
// read promotes a Redfish nominal number, which stays inadmissible here for the reason
// fleet_host_memory_nominal_vs_usable_note gives.
//
// WHAT THE PER-HOST GRAIN RESTS ON is therefore still not this trigger, and the heterogeneity does
// not retroactively justify the grain. It is that this wall folded over per-host offers and then
// read RAM from a synthetic machine outside that fold, and that an unclassified host borrowed
// rather than refused -- see gunbc.ci_floor_measurement gunbc_ci_host_usable_ram_kind_note. A
// per-host fact belonged at per-host grain when the hosts were identical; it merely became visible
// when they stopped being.

// The grain here is per host, and the reason is not that the hosts differ. This wall folds over
// per-host offers and charges each host its own overhead and session slice, then read RAM from a
// synthetic ComputeHost that is not a member of that fold and does not exist — so the arithmetic
// was right while one of its premises named the wrong subject. A fleet-wide shape was wrong
// because it could not EXPRESS a per-host difference, not because one had appeared.
//
// The unresolved arm refuses rather than borrowing, for the reason the overhead axis beside it
// gives: a fabricated premise under correct arithmetic is the worst place for an absorbing
// fallback, because the wall returns true and the machine OOMs.
type HostUsableRamResolution
  = HostUsableRamResolved { bytes: ByteSize }
  | HostUsableRamUnresolved { reason: String }

fn host_usable_ram_or_refusal(host: HostIdentity, r: HostUsableRam) -> HostUsableRamResolution {
  match r {
    HostUsableRamMeasured { bytes: b, provenance: _ } => HostUsableRamResolved { bytes: b }
    HostUsableRamConservativeLowerBound { bytes: b, basis: _ } => HostUsableRamResolved { bytes: b }
    HostUsableRamUnmeasured =>
      HostUsableRamUnresolved {
        reason: concat("host OS-usable RAM is unclassified, so the ceiling every other charge in this budget is checked against is unknown: refuse to derive a runner width rather than borrow another host's MemTotal (which is how a correct sum acquires a fabricated premise). Classify it in gunbc.ci_floor_measurement gunbc_ci_host_usable_ram_for. Host: ", host)
      }
  }
}

// THE CAUSE RENDERS FROM ITS OWN MODULE so the manifest, the witnesses and any later consumer all
// read one projection rather than each spelling the variants again.
// NAMED FOR ITS SUBJECT BECAUSE A BARE `refusal_cause_text` IS AMBIGUOUS CORPUS-WIDE.
// gunbc.roadmap_instrument_sandbox already declares one over ProgramViewRefusalCause. Modules that
// resolve by bare reference -- the witness tests do -- then see two candidates and refuse, and the
// refusal surfaces only in a whole-corpus resolve, never in a per-entry run whose closure happens
// to contain one of them. The two functions are genuinely different facts, not a nickname pair, so
// the repair is to name this one after the refusal it renders rather than to merge them.
fn host_deployment_refusal_text(c: HostRunnerDeploymentRefusal) -> String {
  match c {
    PrimaryCpuUnavailable { cause: t } => concat("primary_cpu_unavailable ", t)
    UsableRamUnavailable { cause: t } => concat("usable_ram_unavailable ", t)
    SessionReservationUnestablished { cause: t } => concat("session_reservation_unestablished ", t)
    FixedOverheadUnavailable { cause: t } => concat("fixed_overhead_unavailable ", t)
    CompilePoolUnavailable { cause: t } => concat("compile_pool_unavailable ", t)
    HostAllocationOversubscribedOnHost { cause: t } => concat("host_allocation_oversubscribed ", t)
    HostAllocationUnchargeableOnHost { cause: t } => concat("host_allocation_unchargeable ", t)
    ZeroRunnerWidth => "zero_runner_width"
    JobserverCitationAbsent { cause: t } => concat("jobserver_citation_absent ", t)
    HostCpuAllocationUnchargeable { cause: t } => concat("host_cpu_allocation_unchargeable ", t)
    HostNotEnrolledInFleet => "host_not_enrolled_in_fleet"
  }
}

fn refuse_host(host: HostIdentity, cause: HostRunnerDeploymentRefusal) -> HostRunnerDeploymentStanding {
  HostRunnerDeploymentRefused { refusal: RefusedHostDeployment { host: host, cause: cause } }
}

// EACH HOST IS CLASSIFIED INDEPENDENTLY AND THE FOLD IS GONE. What was an accumulator threading a
// fleet-level reason is now a total function from one offer to one standing, so a refusal has no
// carrier through which it could reach another host. That is the per-host grain as a structural
// property rather than as care taken by every arm.
fn host_deployment_standing(offer: ComputeOffer, control_plane_placement: FabricControlPlanePlacement) -> HostRunnerDeploymentStanding {
  let host_id = offer.supply.physical.identity
  match compute_host_primary_cpu(host: offer.supply.physical) {
    Absent =>
      refuse_host(host: host_id, cause: PrimaryCpuUnavailable {
        cause: concat("compute offer has no primary CPU facts: ", host_id)
      })
    Present { value: cpu } =>
      match host_usable_ram_or_refusal(host: host_id, r: gunbc_ci_host_usable_ram_for(host: host_id)) {
        HostUsableRamUnresolved { reason: rr } =>
          refuse_host(host: host_id, cause: UsableRamUnavailable { cause: rr })
        HostUsableRamResolved { bytes: host_ram } =>
          match host_session_slice_resolution(host: host_id) {
            SessionSliceUnsized { reason: sr } =>
              refuse_host(host: host_id, cause: SessionReservationUnestablished { cause: sr })
            SessionSliceNotApplicable =>
              host_standing_with_session_slice(offer: offer, cpu: cpu, host_id: host_id, host_ram: host_ram, headroom: oomd_actuation_floor(host: host_ram), session_pool: byte_size(0), control_plane_placement: control_plane_placement)
            SessionSliceCharged { bytes: session_pool } =>
              host_standing_with_session_slice(offer: offer, cpu: cpu, host_id: host_id, host_ram: host_ram, headroom: oomd_actuation_floor(host: host_ram), session_pool: session_pool, control_plane_placement: control_plane_placement)
          }
      }
  }
}

fn host_standing_with_session_slice(
  offer: ComputeOffer,
  cpu: CpuFacts,
  host_id: HostIdentity,
  host_ram: ByteSize,
  headroom: ByteSize,
  session_pool: ByteSize,
  control_plane_placement: FabricControlPlanePlacement
) -> HostRunnerDeploymentStanding {
  match host_overhead_or_refusal(host: host_id, o: gunbc_ci_host_fixed_overhead_for(host: host_id)) {
    HostOverheadUnresolved { reason: orr } =>
      refuse_host(host: host_id, cause: FixedOverheadUnavailable { cause: orr })
    HostOverheadResolved { bytes: overhead } =>
      match compile_pool_bytes_for(
        placement: gunbc_compile_pool_placement,
        nproc: cpu_facts_threads(cpu: cpu),
        host: host_ram,
        citation: jobserver_config
      ) {
        CompilePoolUnresolved { reason: r } =>
          refuse_host(host: host_id, cause: CompilePoolUnavailable { cause: concat("compile pool unresolved: ", r) })
        CompilePoolDerived { bytes: compile_pool } =>
          match host_allocation_verdict(
            host: host_ram,
            overhead: overhead,
            headroom: headroom,
            runner_pool: gunbc_runner_pool_budget_for(host: host_id),
            session_pool: session_pool,
            compile_pool: compile_pool,
            control_plane: host_fabric_control_plane_claim_under(host: host_id, placement: control_plane_placement)
          ) {
            HostAllocationOversubscribed =>
              refuse_host(host: host_id, cause: HostAllocationOversubscribedOnHost {
                cause: concat("host allocation over-committed (runner_pool + session_pool + compile_pool + overhead + headroom exceeds host RAM): ", host_id)
              })
            HostAllocationUnchargeable { cause: c } =>
              refuse_host(host: host_id, cause: HostAllocationUnchargeableOnHost {
                cause: concat(concat("host allocation unchargeable on ", host_id), concat(": ", c))
              })
            HostAllocationConserves =>
              match jobserver_config {
                JobserverAbsent =>
                  refuse_host(host: host_id, cause: JobserverCitationAbsent {
                    cause: concat("no cited jobserver configuration, so the compile-token budget has no derivation and the host cannot be told a bound it did not compute: ", host_id)
                  })
                JobserverCited { config: jcfg, provenance: _ } =>
                  match runner_cpu_boundary_for(
                    placement: gunbc_compile_pool_placement,
                    per_slot: gunbc_runner_cores_per_slot()
                  ) {
                    RunnerCpuBoundaryUnchargeable { reason: cr } =>
                      refuse_host(host: host_id, cause: HostCpuAllocationUnchargeable { cause: cr })
                    RunnerCpuBoundaryDerived { boundary: cpub } => {
              let dep = conservation_host_deployment(
                offer: offer,
                build_tokens: derive_jobserver_tokens(
                  nproc: cpu_facts_threads(cpu: cpu),
                  mem_total: host_ram,
                  cfg: jcfg
                ),
                cpu_boundary: cpub
              )
              if dep.runner_count == 0 {
                refuse_host(host: host_id, cause: ZeroRunnerWidth)
              } else {
                HostRunnerDeploymentDerived { deployment: dep }
              }
            }
                  }
              }
          }
      }
  }
}

fn runner_deployment_plan() -> RunnerDeploymentPlan {
  runner_deployment_plan_under_placement(control_plane_placement: fabric_control_plane_placement)
}

fn runner_deployment_plan_under_placement(control_plane_placement: FabricControlPlanePlacement) -> RunnerDeploymentPlan {
  RunnerDeploymentPlan {
    hosts: map(fleet_intent_offers, o => host_deployment_standing(offer: o, control_plane_placement: control_plane_placement)),
  }
}

fn plan_derived_deployments(p: RunnerDeploymentPlan) -> List<RunnerHostDeployment> {
  fold(p.hosts, init: [], f: (acc, st) => match st {
    HostRunnerDeploymentDerived { deployment: d } => concat(acc, [d])
    HostRunnerDeploymentRefused { refusal: _ } => acc
  })
}

fn plan_refused_hosts(p: RunnerDeploymentPlan) -> List<RefusedHostDeployment> {
  fold(p.hosts, init: [], f: (acc, st) => match st {
    HostRunnerDeploymentDerived { deployment: _ } => acc
    HostRunnerDeploymentRefused { refusal: r } => concat(acc, [r])
  })
}

fn plan_derived_run_total(p: RunnerDeploymentPlan) -> Int {
  fold(plan_derived_deployments(p: p), init: 0, f: (acc, d) => acc + d.runner_count)
}

// A HOST-TARGETED CONSUMER SELECTS ITS HOST BEFORE ANY COMPLETENESS POLICY APPLIES. Convergence is
// a host-targeted transaction, so srv3 being deployable is a fact about srv3 and stays true while
// srv2 is refused.
fn runner_host_deployment_for(p: RunnerDeploymentPlan, host: HostIdentity) -> HostRunnerDeploymentStanding {
  fold(p.hosts, init: refuse_host(host: host, cause: HostNotEnrolledInFleet), f: (acc, st) => match st {
    HostRunnerDeploymentDerived { deployment: d } =>
      if (d.identity as String) == (host as String) { HostRunnerDeploymentDerived { deployment: d } } else { acc }
    HostRunnerDeploymentRefused { refusal: r } =>
      if (r.host as String) == (host as String) { HostRunnerDeploymentRefused { refusal: r } } else { acc }
  })
}

fn fleet_deployment_completion(p: RunnerDeploymentPlan) -> FleetDeploymentCompletion {
  let refused = plan_refused_hosts(p: p)
  let derived = plan_derived_deployments(p: p)
  if refused.length() == 0 {
    FleetDeploymentComplete { deployments: derived, fleet_concurrent_runs: plan_derived_run_total(p: p) }
  } else {
    FleetDeploymentIncomplete {
      derived_hosts: derived,
      refused_hosts: refused,
      known_derived_runs: plan_derived_run_total(p: p),
    }
  }
}

// ATOMICITY BELONGS TO THE CONSUMER THAT NEEDS AN ATOMIC FLEET, not to every host derivation. A
// consumer that genuinely requires all four hosts asks for completeness explicitly and receives the
// refused roster when it does not hold.
fn require_complete_fleet_plan(p: RunnerDeploymentPlan) -> FleetDeploymentCompletion {
  fleet_deployment_completion(p: p)
}

type RunnersPerHostResolution
  = RunnersPerHostDerived { count: Int }
  | RunnersPerHostUnsound { reason: String }

// A FLEET-WIDE ANSWER EXPLICITLY REQUIRES A COMPLETE FLEET. This one reports the widest runner
// count across the whole fleet, so a partial roster would understate it silently -- the maximum
// over three hosts is not the maximum over four. It therefore asks for completeness rather than
// reading whatever derived, and names the refused hosts when it cannot have it.
fn effective_runners_per_host() -> RunnersPerHostResolution {
  match require_complete_fleet_plan(p: runner_deployment_plan()) {
    FleetDeploymentComplete { deployments: hosts, fleet_concurrent_runs: _ } =>
      RunnersPerHostDerived { count: fold(hosts, init: 0, f: (acc, h) => if h.runner_count > acc { h.runner_count } else { acc }) }
    FleetDeploymentIncomplete { derived_hosts: _, refused_hosts: refused, known_derived_runs: _ } =>
      RunnersPerHostUnsound {
        reason: fold(refused, init: "fleet runner width needs every host and some refused:", f: (acc, r) => concat(acc, concat(" ", r.host)))
      }
  }
}

type SessionHostReservation {
  identity: HostIdentity
  session_count: Int
  per_session_reservation: ByteSize
  workload_class: WorkloadClass
}

type SessionReservationPlan
  = SessionReservationDerived {
      hosts: List<SessionHostReservation>,
      fleet_concurrent_sessions: Int,
      per_session_reservation: ByteSize,
      coverage_count: Int,
      sample_count: Int
    }
  | SessionReservationUnsound { reason: String }

fn samples_covered(cap: ByteSize) -> Int {
  fold(gunbc_ci_per_session_peak_samples, init: 0, f: (acc, s) => if measure_le(a: s, b: cap) { acc + 1 } else { acc })
}

// THE PER-SESSION CEILING AND THE CONCURRENCY ARE ADMISSION POLICY; THE AGGREGATE IS PER HOST.
// This projection formerly took all three from one fleet-wide Regime2 row, which is why it reported
// one session_count and one aggregate for every offer regardless of which hosts carry sessions at
// all. The count carried here is the DECLARED admitted concurrency and nothing divides by it --
// gunbc.session_admission_policy records that no actuator enforces it, so it is intent rather than
// a bound, and any consumer needing a bound must read session_admission_enforced_concurrency.
// AN AUTHORED CONCURRENCY LIMIT IS NOT AN ENFORCED ONE, AND ONLY THE SECOND MAY SIZE A RESERVATION.
// This function matched the admission policy directly and spent admitted_concurrency whatever the
// enforcement arm said, so a limit nothing actuates would have sized the whole fleet's session
// reservation -- a plan premised on a cap that does not exist, which is the fabricated-premise shape
// gunbc.session_admission_policy's ConcurrencyEnforcedBy / ConcurrencyAuthoredUnenforced split was
// authored to make visible. It now routes through session_admission_enforced_concurrency, whose
// none arm IS that refusal, so the distinction the carrier draws is one this consumer must answer.
// Caught by witness_live_session_plan_fail_closed, which was asserting the refusal this had stopped
// producing.
fn session_reservation_plan() -> SessionReservationPlan {
  match session_admission_enforced_concurrency(p: gunbc_session_admission_policy) {
    Absent => SessionReservationUnsound {
      reason: session_admission_unenforced_reason(p: gunbc_session_admission_policy)
    }
    Present { value: enforced } => session_reservation_plan_at_concurrency(n: enforced)
  }
}

fn session_reservation_plan_at_concurrency(n: Int) -> SessionReservationPlan {
  match gunbc_session_admission_policy {
    SessionAdmissionUnestablished { cause: r } => SessionReservationUnsound { reason: r }
    SessionAdmissionDeclared { oomd_eviction_ceiling: c, admitted_concurrency: _, enforcement: _ } =>
      SessionReservationDerived {
        hosts: map(fleet_intent_offers, o => SessionHostReservation {
          identity: o.supply.physical.identity,
          session_count: n,
          per_session_reservation: c,
          workload_class: InteractiveLatencySensitive,
        }),
        fleet_concurrent_sessions: n * fleet_intent_offers.length(),
        per_session_reservation: c,
        coverage_count: samples_covered(cap: c),
        sample_count: gunbc_ci_per_session_peak_samples.length(),
      }
  }
}

data gunbc_ci_count_field_measure_followup: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "std.measure",
    decl_name: "HardwareThreadCount",
    field: WholeDeclaration
  }
}

type OperatingPointRow {
  per_session_cap: ByteSize
  session_concurrency: Int
  sessions_slice: ByteSize
  coverage_count: Int
  sample_count: Int
}

fn evaluate_operating_point(cap: ByteSize, n: Int) -> OperatingPointRow {
  let slice = match resolve_session_slice(mode: Regime1WorstCase { point: SessionOperatingPointSet { per_session_cap: cap, session_concurrency: n } }) {
    SessionSliceResolved { bytes: b, per_session_cap: _, concurrency: _ } => b
    SessionSliceUnresolved { reason: _ } => byte_size(0)
  }
  OperatingPointRow {
    per_session_cap: cap,
    session_concurrency: n,
    sessions_slice: slice,
    coverage_count: samples_covered(cap: cap),
    sample_count: gunbc_ci_per_session_peak_samples.length(),
  }
}

data gunbc_ci_session_operating_curve_candidates: List<SessionOperatingPoint> = [
  SessionOperatingPointSet { per_session_cap: byte_size(2211908157), session_concurrency: 16 },
  SessionOperatingPointSet { per_session_cap: byte_size(4294967296), session_concurrency: 16 },
  SessionOperatingPointSet { per_session_cap: byte_size(8879844884), session_concurrency: 6 },
  SessionOperatingPointSet { per_session_cap: byte_size(10737418240), session_concurrency: 6 },
  SessionOperatingPointSet { per_session_cap: byte_size(8879844884), session_concurrency: 4 },
]

fn operating_curve() -> List<OperatingPointRow> {
  map(gunbc_ci_session_operating_curve_candidates, op => match op {
    SessionOperatingPointSet { per_session_cap: c, session_concurrency: n } => evaluate_operating_point(cap: c, n: n)
    SessionOperatingPointUnset => evaluate_operating_point(cap: byte_size(0), n: 0)
  })
}
