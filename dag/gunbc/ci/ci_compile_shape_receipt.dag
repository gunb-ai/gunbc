module gunbc.ci.ci_compile_shape_receipt

// THE PRODUCER FOR PER-RUNNER BUILD VARIANCE ON THE REQUIRED JOB. Seed `cargo build --release`
// wall on v2-bootstrap is ~4 min on srv1 in every sampled window and ~15 min on srv3/srv4 when
// those hosts are busy (GitHub step timestamps, session witty-crane-693). Cache Cargo restore is
// 6-9s on every host, so the split is not the GHA cache. This step prints the compile SHAPE cargo
// actually inherited so one srv1 run and one loaded srv3/srv4 run settle shared-fifo vs unbounded
// -j128. It does not consume fifo tokens and it does not tune the build.
//
// AXES ARE TYPED ROWS. Each axis names its key, the ordered sources a reader consults, and the
// spelling used when a source does not answer. Each source is one echo (the isolate/pin shape).
// Fallback order is the source list; the script does not collapse sources in shell, so a host
// that cannot read /etc/default/ctrl-jobserver still prints tokens_created from the unit.

import std.types { String, NonEmptyStr, Bool, List }
import std.algebra { list_map, list_flat_map }
import std.optional { Present }
import std.dissolution {
  DissolutionCondition, unbound_dissolution, dissolution_description,
}
import std.disposition { Disposition, Scaffold, SingleAuthority }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.github.actions { Step, RunStep }
import v2.std.orchestration { Pipeline, PipelineStep, FailFast }
import v2.workflow.ci_workflow_run_emit {
  ci_workflow_do, ci_workflow_run_emit_pipeline,
}
import gunbc.host.host_converge {
  gunbc_runner_jobserver_env_file,
  gunbc_runner_jobserver_env_key,
  gunbc_runner_jobserver_service,
  gunbc_runner_jobserver_default_fifo,
}

data compile_shape_receipt_prefix: String = "GUNBC_COMPILE_SHAPE"

data compile_shape_receipt_step_name: String = "Record compile shape"

data compile_shape_receipt_unavailable: String = "unavailable"

type CompileShapeSource {
  id: String
  command: String
}

type CompileShapeAxis {
  axis: String
  absent: String
  sources: List<CompileShapeSource>
}

fn compile_shape_echo(axis: String, value: String) -> String {
  concat(
    "echo \"",
    concat(compile_shape_receipt_prefix, concat(" ", concat(axis, concat("=", concat(value, "\"")))))
  )
}

fn compile_shape_env_value(name: String, absent: String) -> String {
  concat("$\{", concat(name, concat(":-", concat(absent, "}"))))
}

fn compile_shape_cmd_value(cmd: String, absent: String) -> String {
  concat("$(", concat(cmd, concat(" 2>/dev/null || echo ", concat(absent, ")"))))
}

fn compile_shape_env_source(axis: String, id: String, env_name: String, absent: String) -> CompileShapeSource {
  CompileShapeSource {
    id: id,
    command: compile_shape_echo(axis: axis, value: compile_shape_env_value(name: env_name, absent: absent))
  }
}

fn compile_shape_cmd_source(axis: String, id: String, cmd: String, absent: String) -> CompileShapeSource {
  CompileShapeSource {
    id: id,
    command: compile_shape_echo(axis: axis, value: compile_shape_cmd_value(cmd: cmd, absent: absent))
  }
}

fn compile_shape_axis(axis: String, absent: String, sources: List<CompileShapeSource>) -> CompileShapeAxis {
  CompileShapeAxis { axis: axis, absent: absent, sources: sources }
}

fn compile_shape_job_cgroup_file_cmd(filename: String) -> String {
  concat(
    "cat /sys/fs/cgroup$(sed -n 's/^0:://p' /proc/self/cgroup)/",
    filename
  )
}

data compile_shape_receipt_axes: List<CompileShapeAxis> = [
  compile_shape_axis(
    axis: "time_utc",
    absent: compile_shape_receipt_unavailable,
    sources: [compile_shape_cmd_source(
      axis: "time_utc",
      id: "date_utc",
      cmd: "date -u +%Y-%m-%dT%H:%M:%SZ",
      absent: compile_shape_receipt_unavailable
    )]
  ),
  compile_shape_axis(
    axis: "host",
    absent: compile_shape_receipt_unavailable,
    sources: [compile_shape_cmd_source(
      axis: "host",
      id: "hostname",
      cmd: "hostname",
      absent: compile_shape_receipt_unavailable
    )]
  ),
  compile_shape_axis(
    axis: "runner",
    absent: compile_shape_receipt_unavailable,
    sources: [compile_shape_env_source(
      axis: "runner",
      id: "runner_name_env",
      env_name: "RUNNER_NAME",
      absent: compile_shape_receipt_unavailable
    )]
  ),
  compile_shape_axis(
    axis: "nproc",
    absent: compile_shape_receipt_unavailable,
    sources: [compile_shape_cmd_source(
      axis: "nproc",
      id: "nproc",
      cmd: "nproc",
      absent: compile_shape_receipt_unavailable
    )]
  ),
  compile_shape_axis(
    axis: "cargo_build_jobs",
    absent: compile_shape_receipt_unavailable,
    sources: [compile_shape_env_source(
      axis: "cargo_build_jobs",
      id: "cargo_build_jobs_env",
      env_name: "CARGO_BUILD_JOBS",
      absent: compile_shape_receipt_unavailable
    )]
  ),
  compile_shape_axis(
    axis: "rustc_wrapper",
    absent: compile_shape_receipt_unavailable,
    sources: [compile_shape_env_source(
      axis: "rustc_wrapper",
      id: "rustc_wrapper_env",
      env_name: "RUSTC_WRAPPER",
      absent: compile_shape_receipt_unavailable
    )]
  ),
  compile_shape_axis(
    axis: "makeflags",
    absent: compile_shape_receipt_unavailable,
    sources: [compile_shape_env_source(
      axis: "makeflags",
      id: "makeflags_env",
      env_name: "MAKEFLAGS",
      absent: compile_shape_receipt_unavailable
    )]
  ),
  compile_shape_axis(
    axis: "fifo_env",
    absent: compile_shape_receipt_unavailable,
    sources: [compile_shape_env_source(
      axis: "fifo_env",
      id: "ctrl_jobserver_fifo_env",
      env_name: "CTRL_JOBSERVER_FIFO",
      absent: compile_shape_receipt_unavailable
    )]
  ),
  compile_shape_axis(
    axis: "fifo_default",
    absent: compile_shape_receipt_unavailable,
    sources: [compile_shape_cmd_source(
      axis: "fifo_default",
      id: "default_fifo_ls",
      cmd: concat("ls ", gunbc_runner_jobserver_default_fifo),
      absent: compile_shape_receipt_unavailable
    )]
  ),
  compile_shape_axis(
    axis: "tokens_env",
    absent: compile_shape_receipt_unavailable,
    sources: [compile_shape_env_source(
      axis: "tokens_env",
      id: "ctrl_jobserver_tokens_env",
      env_name: gunbc_runner_jobserver_env_key,
      absent: compile_shape_receipt_unavailable
    )]
  ),
  compile_shape_axis(
    axis: "tokens_file",
    absent: compile_shape_receipt_unavailable,
    sources: [compile_shape_cmd_source(
      axis: "tokens_file",
      id: "ctrl_jobserver_env_file",
      cmd: concat(
        concat("sed -n 's/^", concat(gunbc_runner_jobserver_env_key, "=//p' ")),
        gunbc_runner_jobserver_env_file
      ),
      absent: compile_shape_receipt_unavailable
    )]
  ),
  compile_shape_axis(
    axis: "tokens_created",
    absent: compile_shape_receipt_unavailable,
    sources: [compile_shape_cmd_source(
      axis: "tokens_created",
      id: "ctrl_jobserver_unit_environment",
      cmd: concat("systemctl show ", concat(gunbc_runner_jobserver_service, " -p Environment --value")),
      absent: compile_shape_receipt_unavailable
    )]
  ),
  compile_shape_axis(
    axis: "loadavg",
    absent: compile_shape_receipt_unavailable,
    sources: [compile_shape_cmd_source(
      axis: "loadavg",
      id: "proc_loadavg",
      cmd: "tr ' ' ',' < /proc/loadavg",
      absent: compile_shape_receipt_unavailable
    )]
  ),
  compile_shape_axis(
    axis: "cgroup",
    absent: compile_shape_receipt_unavailable,
    sources: [compile_shape_cmd_source(
      axis: "cgroup",
      id: "proc_self_cgroup_unified",
      cmd: "sed -n 's/^0:://p' /proc/self/cgroup",
      absent: compile_shape_receipt_unavailable
    )]
  ),
  compile_shape_axis(
    axis: "cpu.max",
    absent: compile_shape_receipt_unavailable,
    sources: [compile_shape_cmd_source(
      axis: "cpu.max",
      id: "job_cgroup_cpu_max",
      cmd: compile_shape_job_cgroup_file_cmd(filename: "cpu.max"),
      absent: compile_shape_receipt_unavailable
    )]
  ),
  compile_shape_axis(
    axis: "cpu.weight",
    absent: compile_shape_receipt_unavailable,
    sources: [compile_shape_cmd_source(
      axis: "cpu.weight",
      id: "job_cgroup_cpu_weight",
      cmd: compile_shape_job_cgroup_file_cmd(filename: "cpu.weight"),
      absent: compile_shape_receipt_unavailable
    )]
  ),
  compile_shape_axis(
    axis: "cpu.stat",
    absent: compile_shape_receipt_unavailable,
    sources: [compile_shape_cmd_source(
      axis: "cpu.stat",
      id: "job_cgroup_cpu_stat",
      cmd: compile_shape_job_cgroup_file_cmd(filename: "cpu.stat"),
      absent: compile_shape_receipt_unavailable
    )]
  )
]

fn compile_shape_source_is_single_command(command: String) -> Bool {
  !string_contains(s: command, pattern: ";")
    && !string_contains(s: command, pattern: "if ")
    && !string_contains(s: command, pattern: "case ")
}

fn compile_shape_axis_steps(a: CompileShapeAxis) -> List<PipelineStep> {
  list_map(xs: a.sources, f: fn(src) { ci_workflow_do(command: src.command) })
}

data compile_shape_receipt_dissolution: DissolutionCondition = unbound_dissolution(
  description: "dissolve-on: compile_shape_receipt -- orch-emitted foreign-executor observe step printing the compile shape cargo inherited on the required job; leaf echo command rows remain until typed host observation lands on host_effect_apply (v2.std.orchestration orchestration_to_effect_plan_dissolve_on, shell-to-intent). Slot CPUQuota / CARGO_BUILD_JOBS isolation is a different unit and does not dissolve this carrier." as NonEmptyStr
)

data compile_shape_receipt_shell_emit_scaffold: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.ci.ci_compile_shape_receipt",
    decl_name: "compile_shape_receipt_script",
    field: WholeDeclaration
  }
}

fn compile_shape_receipt_intent() -> Pipeline {
  Pipeline {
    steps: list_flat_map(xs: compile_shape_receipt_axes, f: fn(a) { compile_shape_axis_steps(a: a) }),
    on_failure: FailFast
  }
}

fn compile_shape_receipt_script() -> String {
  concat(
    concat("# ", concat(dissolution_description(condition: compile_shape_receipt_dissolution), "\n")),
    ci_workflow_run_emit_pipeline(p: compile_shape_receipt_intent())
  )
}

fn compile_shape_receipt_observes_axes(script: String) -> Bool {
  fold(compile_shape_receipt_axes, init: true, f: fn(acc, a) {
    acc && string_contains(s: script, pattern: concat(" ", concat(a.axis, "=")))
  })
}

fn compile_shape_receipt_leaves_are_single_commands() -> Bool {
  fold(compile_shape_receipt_axes, init: true, f: fn(acc, a) {
    acc && fold(a.sources, init: true, f: fn(inner, src) {
      inner && compile_shape_source_is_single_command(command: src.command)
    })
  })
}

fn compile_shape_receipt_step() -> Step {
  RunStep {
    name: Present { value: compile_shape_receipt_step_name },
    id: none,
    run: compile_shape_receipt_script(),
    shell: none,
    env: none,
    working_directory: none,
    if_condition: none,
    continue_on_error: none,
    timeout_minutes: none
  }
}
