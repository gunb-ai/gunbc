module gunbc.ci.ci_compile_shape_receipt

// THE PRODUCER FOR PER-RUNNER BUILD VARIANCE ON THE REQUIRED JOB. Seed `cargo build --release`
// wall on v2-bootstrap is ~4 min on srv1 in every sampled window and ~15 min on srv3/srv4 when
// those hosts are busy (GitHub step timestamps, session witty-crane-693). Cache Cargo restore is
// 6-9s on every host, so the split is not the GHA cache. This step prints the compile SHAPE cargo
// actually inherited -- nproc, CARGO_BUILD_JOBS, MAKEFLAGS (jobserver auth present or absent),
// the FIFO path and declared token count when readable, RUSTC_WRAPPER, the job cgroup's cpu.max /
// cpu.weight / cpu.stat -- so one srv1 run and one loaded srv3 run settle shared-fifo vs unbounded
// -j128. It does not consume fifo tokens. A later grouping instrument can attribute wall without a
// one-off `gh` fold (DESIGN section 6: name the instrument).
//
// IT DOES NOT TUNE THE BUILD. Fleet-converge isolates MAKEFLAGS and writes CARGO_BUILD_JOBS from
// ci_compile_jobs (gunbc.fleet.fleet_workflow_steps ci_fleet_build_tuning_steps). The required job
// does not: Isolate toolchain homes is toolchain-home isolation only (gunbc.toolchain_workflow_steps),
// so cargo inherits the runner unit's jobserver. CPUQuota on the slot is SlotCpuQuotaUnbounded
// (gunbc.runner.runner_slot_desired); cpu_weight is the relative-share governor. Slot CPU shape
// belongs to the runner-slot-desired lane; this step only records what a job saw.
//
// Shell is a section 6 tell, bounded by the dissolution below. The readings distinguish inherited
// host-wide jobserver tokens from an invocation-local CARGO_BUILD_JOBS, and unbounded cpu.max from
// a quota that would throttle. Identifying contention is not a substitute for a declared per-slot
// width.

import std.types { List, String, NonEmptyStr }
import std.optional { Present }
import std.dissolution {
  DissolutionCondition, unbound_dissolution, dissolution_description,
}
import extdeps.github.actions { Step, RunStep }

data compile_shape_receipt_prefix: String = "GUNBC_COMPILE_SHAPE"

data compile_shape_receipt_step_name: String = "Record compile shape"

data compile_shape_receipt_dissolution: DissolutionCondition = unbound_dissolution(
  description: "dissolve-on: compile_shape_receipt -- delete this required-job step when the required job isolates MAKEFLAGS and CARGO_BUILD_JOBS from the runner unit the way gunbc.fleet.fleet_workflow_steps ci_fleet_build_tuning_steps already does for fleet-converge, AND gunbc.runner.runner_slot_desired cpu_quota is a resolved thread count the live unit emits as CPUQuota, so a job's compile width is the slot's declared shape rather than host nproc plus a shared jobserver. Identifying contention on the shared slot is not a substitute." as NonEmptyStr
)

fn compile_shape_receipt_lines() -> List<String> {
  [
    concat("# ", dissolution_description(condition: compile_shape_receipt_dissolution)),
    concat("GUNBC_COMPILE_SHAPE_PREFIX='", concat(compile_shape_receipt_prefix, "'")),
    "echo \"$GUNBC_COMPILE_SHAPE_PREFIX time_utc=$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || echo unavailable) host=$(hostname 2>/dev/null || echo unavailable) runner=${RUNNER_NAME:-unset}\"",
    "echo \"$GUNBC_COMPILE_SHAPE_PREFIX nproc=$(nproc 2>/dev/null || echo unavailable) cargo_build_jobs=${CARGO_BUILD_JOBS:-unset} rustc_wrapper=${RUSTC_WRAPPER:-unset}\"",
    "echo \"$GUNBC_COMPILE_SHAPE_PREFIX makeflags=${MAKEFLAGS:-unset}\"",
    "GUNBC_COMPILE_SHAPE_JOBSERVER_AUTH=absent",
    "case \"${MAKEFLAGS:-}\" in *jobserver*) GUNBC_COMPILE_SHAPE_JOBSERVER_AUTH=present ;; esac",
    "GUNBC_COMPILE_SHAPE_FIFO=${CTRL_JOBSERVER_FIFO:-}",
    "if [ -z \"$GUNBC_COMPILE_SHAPE_FIFO\" ]; then GUNBC_COMPILE_SHAPE_FIFO=$(printf '%s\\n' \"${MAKEFLAGS:-}\" | sed -n 's/.*jobserver-auth=fifo:\\([^ ]*\\).*/\\1/p' | head -n 1); fi",
    "if [ -z \"$GUNBC_COMPILE_SHAPE_FIFO\" ]; then GUNBC_COMPILE_SHAPE_FIFO=unset; fi",
    "GUNBC_COMPILE_SHAPE_TOKENS=${CTRL_JOBSERVER_TOKENS:-unset}",
    "if [ \"$GUNBC_COMPILE_SHAPE_TOKENS\" = unset ] && [ -r /etc/default/ctrl-jobserver ]; then GUNBC_COMPILE_SHAPE_TOKENS=$(sed -n 's/^CTRL_JOBSERVER_TOKENS=//p' /etc/default/ctrl-jobserver 2>/dev/null | head -n 1); if [ -z \"$GUNBC_COMPILE_SHAPE_TOKENS\" ]; then GUNBC_COMPILE_SHAPE_TOKENS=unset; fi; fi",
    "if [ \"$GUNBC_COMPILE_SHAPE_FIFO\" != unset ] && [ -e \"$GUNBC_COMPILE_SHAPE_FIFO\" ]; then GUNBC_COMPILE_SHAPE_FIFO_EXISTS=yes; else GUNBC_COMPILE_SHAPE_FIFO_EXISTS=no; fi",
    "echo \"$GUNBC_COMPILE_SHAPE_PREFIX jobserver_auth=$GUNBC_COMPILE_SHAPE_JOBSERVER_AUTH fifo=$GUNBC_COMPILE_SHAPE_FIFO fifo_exists=$GUNBC_COMPILE_SHAPE_FIFO_EXISTS tokens=$GUNBC_COMPILE_SHAPE_TOKENS\"",
    "echo \"$GUNBC_COMPILE_SHAPE_PREFIX loadavg=$(tr ' ' ',' < /proc/loadavg 2>/dev/null || echo unavailable)\"",
    "GUNBC_COMPILE_SHAPE_CG=$(sed -n 's/^0:://p' /proc/self/cgroup 2>/dev/null | tail -n 1)",
    "if [ -z \"$GUNBC_COMPILE_SHAPE_CG\" ]; then GUNBC_COMPILE_SHAPE_CG=unavailable; fi",
    "echo \"$GUNBC_COMPILE_SHAPE_PREFIX cgroup=$GUNBC_COMPILE_SHAPE_CG\"",
    "GUNBC_COMPILE_SHAPE_CGDIR=/sys/fs/cgroup$GUNBC_COMPILE_SHAPE_CG",
    "if [ -d \"$GUNBC_COMPILE_SHAPE_CGDIR\" ]; then echo \"$GUNBC_COMPILE_SHAPE_PREFIX cpu.max=$(tr '\\n' ' ' < \"$GUNBC_COMPILE_SHAPE_CGDIR/cpu.max\" 2>/dev/null || echo unavailable) cpu.weight=$(tr '\\n' ' ' < \"$GUNBC_COMPILE_SHAPE_CGDIR/cpu.weight\" 2>/dev/null || echo unavailable) cpu.stat=$(tr '\\n' ' ' < \"$GUNBC_COMPILE_SHAPE_CGDIR/cpu.stat\" 2>/dev/null || echo unavailable)\"; else echo \"$GUNBC_COMPILE_SHAPE_PREFIX cpu.max=unavailable cpu.weight=unavailable cpu.stat=unavailable\"; fi",
  ]
}

fn compile_shape_receipt_script() -> String {
  fold(compile_shape_receipt_lines(), init: "", f: (acc, line) =>
    if acc == "" { line } else { concat(acc, concat("\n", line)) })
}

fn compile_shape_receipt_step() -> Step {
  RunStep {
    name: Present { value: compile_shape_receipt_step_name },
    id: none,
    run: compile_shape_receipt_script(),
    shell: none,
    env: none,
    working_directory: none,
    if_condition: none,
    continue_on_error: none,
    timeout_minutes: none
  }
}
