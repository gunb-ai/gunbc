module gunbc.ci.ci_compile_shape_receipt

// THE PRODUCER FOR PER-RUNNER BUILD VARIANCE ON THE REQUIRED JOB. Seed `cargo build --release`
// wall on v2-bootstrap is ~4 min on srv1 in every sampled window and ~15 min on srv3/srv4 when
// those hosts are busy (GitHub step timestamps, session witty-crane-693). Cache Cargo restore is
// 6-9s on every host, so the split is not the GHA cache. This step prints the compile SHAPE cargo
// actually inherited -- nproc, CARGO_BUILD_JOBS, MAKEFLAGS (jobserver auth present or absent),
// the FIFO path and declared token count when readable, RUSTC_WRAPPER, the job cgroup's cpu.max /
// cpu.weight / cpu.stat -- so one srv1 run and one loaded srv3 run settle shared-fifo vs unbounded
// -j128. It does not consume fifo tokens.
//
// IT DOES NOT TUNE THE BUILD. Fleet-converge isolates MAKEFLAGS and writes CARGO_BUILD_JOBS;
// Isolate toolchain homes does not. CPUQuota is SlotCpuQuotaUnbounded. Slot CPU shape belongs to
// the runner-slot-desired lane; this step only records what a job saw.
//
// COMPOSITION IS THE PIPELINE, not a fold of shell lines (review 79739). Leaves are command rows
// in the same shape as v2.workflow.ci_workflow_run_emit ci_isolate_* / ci_pin_rustup_*, emitted
// through orch_emit_pipeline. The dissolve-on names the bash-emit / host_effect_apply climb
// (v2.std.orchestration orchestration_to_effect_plan_dissolve_on), not the slot-tuning lane.

import std.types { String, NonEmptyStr }
import std.optional { Present }
import std.dissolution {
  DissolutionCondition, unbound_dissolution, dissolution_description,
}
import std.disposition { Disposition, Scaffold, SingleAuthority }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.github.actions { Step, RunStep }
import v2.std.orchestration { Pipeline, FailFast }
import v2.workflow.ci_workflow_run_emit {
  ci_workflow_do, ci_workflow_run_emit_pipeline,
}

data compile_shape_receipt_prefix: String = "GUNBC_COMPILE_SHAPE"

data compile_shape_receipt_step_name: String = "Record compile shape"

data compile_shape_receipt_echo_identity_command: String = "echo \"$GUNBC_COMPILE_SHAPE_PREFIX time_utc=$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || echo unavailable) host=$(hostname 2>/dev/null || echo unavailable) runner=$\{RUNNER_NAME:-unset}\""

data compile_shape_receipt_echo_jobs_command: String = "echo \"$GUNBC_COMPILE_SHAPE_PREFIX nproc=$(nproc 2>/dev/null || echo unavailable) cargo_build_jobs=$\{CARGO_BUILD_JOBS:-unset} rustc_wrapper=$\{RUSTC_WRAPPER:-unset}\""

data compile_shape_receipt_echo_makeflags_command: String = "echo \"$GUNBC_COMPILE_SHAPE_PREFIX makeflags=$\{MAKEFLAGS:-unset}\""

data compile_shape_receipt_jobserver_command: String = "GUNBC_COMPILE_SHAPE_JOBSERVER_AUTH=absent; case \"$\{MAKEFLAGS:-}\" in *jobserver*) GUNBC_COMPILE_SHAPE_JOBSERVER_AUTH=present ;; esac; GUNBC_COMPILE_SHAPE_FIFO=$\{CTRL_JOBSERVER_FIFO:-}; if [ -z \"$GUNBC_COMPILE_SHAPE_FIFO\" ]; then GUNBC_COMPILE_SHAPE_FIFO=$(printf '%s\\n' \"$\{MAKEFLAGS:-}\" | sed -n 's/.*jobserver-auth=fifo:\\([^ ]*\\).*/\\1/p' | head -n 1); fi; if [ -z \"$GUNBC_COMPILE_SHAPE_FIFO\" ]; then GUNBC_COMPILE_SHAPE_FIFO=unset; fi; GUNBC_COMPILE_SHAPE_TOKENS=$\{CTRL_JOBSERVER_TOKENS:-unset}; if [ \"$GUNBC_COMPILE_SHAPE_TOKENS\" = unset ] && [ -r /etc/default/ctrl-jobserver ]; then GUNBC_COMPILE_SHAPE_TOKENS=$(sed -n 's/^CTRL_JOBSERVER_TOKENS=//p' /etc/default/ctrl-jobserver 2>/dev/null | head -n 1); if [ -z \"$GUNBC_COMPILE_SHAPE_TOKENS\" ]; then GUNBC_COMPILE_SHAPE_TOKENS=unset; fi; fi; if [ \"$GUNBC_COMPILE_SHAPE_FIFO\" != unset ] && [ -e \"$GUNBC_COMPILE_SHAPE_FIFO\" ]; then GUNBC_COMPILE_SHAPE_FIFO_EXISTS=yes; else GUNBC_COMPILE_SHAPE_FIFO_EXISTS=no; fi; echo \"$GUNBC_COMPILE_SHAPE_PREFIX jobserver_auth=$GUNBC_COMPILE_SHAPE_JOBSERVER_AUTH fifo=$GUNBC_COMPILE_SHAPE_FIFO fifo_exists=$GUNBC_COMPILE_SHAPE_FIFO_EXISTS tokens=$GUNBC_COMPILE_SHAPE_TOKENS\""

data compile_shape_receipt_echo_loadavg_command: String = "echo \"$GUNBC_COMPILE_SHAPE_PREFIX loadavg=$(tr ' ' ',' < /proc/loadavg 2>/dev/null || echo unavailable)\""

data compile_shape_receipt_cgroup_command: String = "GUNBC_COMPILE_SHAPE_CG=$(sed -n 's/^0:://p' /proc/self/cgroup 2>/dev/null | tail -n 1); if [ -z \"$GUNBC_COMPILE_SHAPE_CG\" ]; then GUNBC_COMPILE_SHAPE_CG=unavailable; fi; echo \"$GUNBC_COMPILE_SHAPE_PREFIX cgroup=$GUNBC_COMPILE_SHAPE_CG\"; GUNBC_COMPILE_SHAPE_CGDIR=/sys/fs/cgroup$GUNBC_COMPILE_SHAPE_CG; if [ -d \"$GUNBC_COMPILE_SHAPE_CGDIR\" ]; then echo \"$GUNBC_COMPILE_SHAPE_PREFIX cpu.max=$(tr '\\n' ' ' < \"$GUNBC_COMPILE_SHAPE_CGDIR/cpu.max\" 2>/dev/null || echo unavailable) cpu.weight=$(tr '\\n' ' ' < \"$GUNBC_COMPILE_SHAPE_CGDIR/cpu.weight\" 2>/dev/null || echo unavailable) cpu.stat=$(tr '\\n' ' ' < \"$GUNBC_COMPILE_SHAPE_CGDIR/cpu.stat\" 2>/dev/null || echo unavailable)\"; else echo \"$GUNBC_COMPILE_SHAPE_PREFIX cpu.max=unavailable cpu.weight=unavailable cpu.stat=unavailable\"; fi"

fn compile_shape_receipt_prefix_assign_command() -> String {
  concat("GUNBC_COMPILE_SHAPE_PREFIX='", concat(compile_shape_receipt_prefix, "'"))
}

data compile_shape_receipt_dissolution: DissolutionCondition = unbound_dissolution(
  description: "dissolve-on: compile_shape_receipt -- orch-emitted foreign-executor observe step printing the compile shape cargo inherited on the required job; leaf echo/nproc/cgroup command rows remain until typed host observation lands on host_effect_apply (v2.std.orchestration orchestration_to_effect_plan_dissolve_on, shell-to-intent). Slot CPUQuota / CARGO_BUILD_JOBS isolation is a different unit and does not dissolve this carrier." as NonEmptyStr
)

data compile_shape_receipt_shell_emit_scaffold: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.ci.ci_compile_shape_receipt",
    decl_name: "compile_shape_receipt_script",
    field: WholeDeclaration
  }
}

fn compile_shape_receipt_intent() -> Pipeline {
  Pipeline {
    steps: [
      ci_workflow_do(command: compile_shape_receipt_prefix_assign_command()),
      ci_workflow_do(command: compile_shape_receipt_echo_identity_command),
      ci_workflow_do(command: compile_shape_receipt_echo_jobs_command),
      ci_workflow_do(command: compile_shape_receipt_echo_makeflags_command),
      ci_workflow_do(command: compile_shape_receipt_jobserver_command),
      ci_workflow_do(command: compile_shape_receipt_echo_loadavg_command),
      ci_workflow_do(command: compile_shape_receipt_cgroup_command)
    ],
    on_failure: FailFast
  }
}

fn compile_shape_receipt_script() -> String {
  concat(
    concat("# ", concat(dissolution_description(condition: compile_shape_receipt_dissolution), "\n")),
    ci_workflow_run_emit_pipeline(p: compile_shape_receipt_intent())
  )
}

fn compile_shape_receipt_observes_axes(script: String) -> Bool {
  string_contains(s: script, pattern: compile_shape_receipt_prefix)
    && string_contains(s: script, pattern: "nproc=")
    && string_contains(s: script, pattern: "cargo_build_jobs=")
    && string_contains(s: script, pattern: "makeflags=")
    && string_contains(s: script, pattern: "jobserver_auth=")
    && string_contains(s: script, pattern: "tokens=")
    && string_contains(s: script, pattern: "cpu.max=")
    && string_contains(s: script, pattern: "cpu.stat=")
}

fn compile_shape_receipt_step() -> Step {
  RunStep {
    name: Present { value: compile_shape_receipt_step_name },
    id: none,
    run: compile_shape_receipt_script(),
    shell: none,
    env: none,
    working_directory: none,
    if_condition: none,
    continue_on_error: none,
    timeout_minutes: none
  }
}
