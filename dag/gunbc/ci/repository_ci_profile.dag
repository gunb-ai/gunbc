module gunbc.ci.repository_ci_profile

import std.types { NonEmptyStr, String, List, Bool, Int }
import std.measure { ByteSize, Minute, minute, minute_count }
import std.optional { Optional, Present, Absent }
import std.dissolution { DissolutionCondition, unbound_dissolution }
import extdeps.cron.schedule_model { CronSchedule, Exact, Listed, Wildcard }
import gunbc.heal_publication_boundary { heal_repair_candidate_artifact_name }
import gunbc.ci.ci_spec {
  gunbc_ci_tier_o_drift_check_target,
  gunbc_ci_heal_publication_admit_target,
  gunbc_ci_heal_publication_publish_target,
}
// THE FEDERATION IS LEASED, NOT RE-SPELLED (DESIGN 3b): the record of which workload identity provider,
// which service account and which secret a publisher federates to belongs to this module's neighbour, so
// the profile row names which federation a publisher uses and never carries those strings itself.
import gunbc.auth.heal_publisher_federation { HealPublisherFederation, public_heal_publisher_federation }
import extdeps.github.actions { PermissionLevel, PermWrite }
import gunbc.ci.ci_layer_roots { witness_layer_roots }
import v2.std.node {
  Node
}

import gunbc.ci.ci_runner_target {
  CiRunnerTarget,
  FleetSelfHostedInDeclaredGroup,
  DeclaredRunnerGroup,
  GithubHostedRunner,
  selected_ci_runner_target,
}
import gunbc.runner.runner_group_restriction_ensure { restricted_runner_groups }
import gunbc.required_ci_contract_epoch { required_ci_context_name }
import gunbc.repo.repo_identity { gunbc_default_branch_name }
import extdeps.github.hosted_runners { github_hosted_ubuntu_2404_arm_public_catalog }

// ONE CI PROFILE ROW PER REPOSITORY, AND WHY THE ROW IS THE UNIT THAT SHARED CI MUST BE CUT FROM.
//
// gunbc and its private mirror were meant to differ in two ways only: the mirror is not public, and it
// carries rows the public repository may not hold. What they actually differ in is about two thousand
// lines of CI EMITTER forked into the mirror, because every fact below was written into a public emitter
// as a constant - which repository is checked out, which branch, which machine class, which entry runs
// the roster, whether a compiler is built from another repository beside the one under test, whether a
// heal publisher exists at all. Forking an emitter to express a difference in data is the expensive
// version of the mistake DESIGN 3 forbids (one authority per subject), and it is the dangerous version
// too: the fork has already drifted from the authority it copies, so a fix to gunbc's required gate does
// not reach the repository whose required check IS the fork.
//
// So the difference moves into a row. RepositoryCiProfile is the fact "what this repository's CI is", and
// the workflow emitters are functions of it: gunbc.witness.compiler_gate_workflow::expected_compiler_gate_yml
// and gunbc.heal_workflow::expected_heal_workflow_yml, gunbc.heal_publisher_workflow::expected_heal_publisher_workflow_yml
// and gunbc.drift_watch_workflow::expected_drift_watch_workflow_yml render gunbc's own four workflows;
// gunbc.witness.repository_witness_workflow::expected_repository_witnesses_yml and
// gunbc.ci.repository_projection_drift_workflow::expected_projection_drift_workflow_yml take a row as an
// argument and render a mirror repository's two. gunbc's own row lives in this module; the mirror's row
// lives IN THE MIRROR and is passed to those two as an argument, so no mirror path, module name or row name
// needs to enter the public corpus - which is the constraint that decides several shapes below.
//
// WHAT THIS ROW DELIBERATELY DOES NOT CARRY:
// - runs-on label strings. A job carries a CiRunnerTarget and its spec PROJECTS from that target
//   (gunbc.ci.ci_runner_target ci_runner_target_spec), so switching a repository's CI to another machine
//   is not an edit to this row either: gunbc's row carries selected_ci_runner_target(), the seam that the
//   CI budget tree, the fleet steps and the instrument dispatch already read. The row says WHICH target a
//   repository's job runs on; for this repository that answer is the one the seam already gives.
//   class stays the one-row edit that authority exists to make, and every derivation - labels, memory
//   regime, RAM budget - follows. Where a job must be confined to a restricted runner group, the target
//   carries the GROUP NAME, which is a row in gunbc.runner.runner_group_restriction_ensure (that module
//   documents the name as the label the group's runners register with), and an undeclared name is
//   refused before a byte is emitted. Selecting a pool and inventing one are different acts.
// - the roster's CONTENT. Entries are rows owned by the repository that has them
//   (gunbc.witness.witness_roster RosterEntry); this row says how a roster is RUN and by whom, not what
//   is in it. Keeping content out is also what lets the public profile row exist without the public
//   repository acquiring mirror subjects.
// - the SUBJECTS that regenerate or publish. Those are DagInvocation rows: an entry path and a function
//   name, named by the repository that owns them.

// AN INVOCATION OF A SUBJECT: which .dag file, which function in it. Carried rather than imported so a
// profile can name a subject the public repository cannot resolve.
type DagInvocation {
  entry: NonEmptyStr
  function: NonEmptyStr
}

// THE PUBLIC SEED: the repository whose compiler runs this repository's claims, when that is not the
// repository under CI. Present only for a mirror that carries content and no compiler; Absent means the
// repository builds itself, which is what a self-compiling repository does and how gunbc's own row reads.
type PublicSeed {
  repository: NonEmptyStr
  checkout_path: NonEmptyStr
  ref_name: NonEmptyStr
  build_command: List<Node>
  seed_binary_relative_path: NonEmptyStr
  record_step_name: NonEmptyStr
  build_step_name: NonEmptyStr
}

// THE COMPOSED ROOT, and the obligations that make the copy a WALL rather than a convenience.
// A mirror's rows are compiled by the seed's compiler over a tree that is neither repository. Until gunbc
// admits a --source-root outside the process workspace roots, that copy is the only way to compose the
// two, and it is deleted by the day such a flag exists - so its dissolution is carried ON the row, and
// the step that performs the copy prints it. The local-runs warning is not ceremony either: composing
// inside a session worktree publishes the mirror's content through the public repository at archive
// time, because auto-push pushes whatever the worktree holds.
type OverlayIngest {
  overlay_dir_name: NonEmptyStr
  entry_prefix: NonEmptyStr
  repo_link_name: NonEmptyStr
  compose_dir_name: NonEmptyStr
  compose_root_env_default: NonEmptyStr
  overlay_copy_dissolves_when: DissolutionCondition
  local_runs_warning: NonEmptyStr
}

// HOW A ROSTER IS RUN. Two routes exist because there is a capability gap, not a style preference: the
// instrument route asks the dispatcher to run one labelled subject per row, which a self-compiling
// repository can afford; the composed-overlay route drives each row through the seed's interpreter over
// the composed root, which is the shape a repository whose claims are executed by ANOTHER repository's
// compiler needs. Neither route spells bash: both emit their statements through
// v2.extdeps.languages.bash_build, so what the arms of the gate do is modelled and only their rendering is
// a fold. What remains admitted as debt is the composition itself, and it carries its own trigger on
// OverlayIngest rather than a second copy here.
type RosterRoute
  = InstrumentLabelRows
  | ComposedOverlayInterpreterRoster {
      overlay: OverlayIngest
      run_roster_step_name: NonEmptyStr
    }

// THE DESIGN 4c STEP: compile the roster's closure and fail when a source annotation has drifted outside
// module-item grain. It gates on the roster's enforced closure rather than every module of the
// repository until its narrowing trigger fires, and it reads exit status plus the reader's classification
// rather than trusting a green compile, so a run that observed nothing is a refusal rather than a pass.
type AnnotationStep {
  step_name: NonEmptyStr
  invocation: DagInvocation
  refusal_prefix: NonEmptyStr
  output_dir_suffix: NonEmptyStr
  subject_banner: NonEmptyStr
  closure_narrowing_dissolves_when: DissolutionCondition
}

// THE REQUIRED GATE: the job whose context must be green. `required_context` is the check name branch
// protection names, and it is kept beside the job id rather than inferred from it, because a repository
// is free to give them different names and branch protection only ever speaks the former.
type RosterGate {
  workflow_file: NonEmptyStr
  workflow_name: NonEmptyStr
  job_id: NonEmptyStr
  job_display_name: NonEmptyStr
  required_context: NonEmptyStr
  runner: CiRunnerTarget
  timeout: Minute
  source_roots: List<String>
  schedule: Optional<CronSchedule>
  memory_budget: Optional<ByteSize>
  route: RosterRoute
  annotation: Optional<AnnotationStep>
}

// THE PROJECTION-DRIFT JOB: check every committed generated file against the bytes its authority emits,
// and (optionally) seal a repair candidate at the same head. Both repositories run one; what differs is
// whether it also seals. A repository that stops committing generated mirrors deletes the job by deleting
// this row - which is the point of making the job's existence data rather than a file in .github.
type ProjectionDrift {
  workflow_file: NonEmptyStr
  workflow_name: NonEmptyStr
  job_id: NonEmptyStr
  job_display_name: NonEmptyStr
  runner: CiRunnerTarget
  timeout: Minute
  // THE CADENCE, and a drift watch that never runs is not a check. Present for a repository that polls
  // (so an infrastructure change is caught by something other than the next commit); Absent for one whose
  // drift is only ever checked at checkout, where the emitter adds no schedule trigger at all.
  cron: Optional<CronSchedule>
  check: DagInvocation
  seal: Optional<HealSeal>
}

// THE HEAL JOB (gunbc's heal.yml): the phase that runs pull-request code, regenerates the committed
// mirrors, and seals a candidate. A repository that commits no generated mirror declares Absent here and
// gets no file emitted. It is distinct from a seal inside the drift job because the two repositories put
// the seal in different places for different reasons, and that placement is exactly the kind of fact a
// fork of an emitter would otherwise encode as a filename.
type HealWorkflowPolicy {
  workflow_file: NonEmptyStr
  workflow_name: NonEmptyStr
  job_id: NonEmptyStr
  job_display_name: NonEmptyStr
  runner: CiRunnerTarget
  timeout: Minute
}

// THE SEAL, living in the drift job rather than in a workflow of its own because the candidate must be
// sealed at the head the check just ran against - and the publisher is a SEPARATE job so that no
// credential is reachable from the run that produced the candidate.
type HealSeal {
  invocation: DagInvocation
  seal_step_id: String
  seal_step_name: NonEmptyStr
  upload_step_name: NonEmptyStr
  head_tree_dir_name: NonEmptyStr
  head_link_name: NonEmptyStr
  compose_dir_name: NonEmptyStr
  candidate_artifact: NonEmptyStr
  banner: NonEmptyStr
}

// THE PUBLISHER: admit a sealed candidate with no credential, federate, fast-forward the branch. Absent
// means the repository commits no generated mirror, so there is nothing to publish and no file to emit -
// a publisher that can only ever fail is not a job, it is a red check with a name.
// WHAT THE PUBLISHER RUNS IS ROWS. The two invocations are the admit and the publish subjects, so the
// emitter never names a repository's module for them; which identity the job federates to and which
// installation the token is minted for are the federation record, owned by gunbc.auth.heal_publisher_federation
// (DESIGN 3b leasing), so this row says WHICH one and never re-spells a provider path, a service account or
// a secret name. What is deliberately NOT here: the overlay a mirror's publisher composes, which is the
// roster route's OverlayIngest read through profile_overlay - the same authority the drift emitter reads,
// because a candidate sealed from one composition and admitted against another is precisely the drift this
// workflow exists to prevent; and any credential-rendering shell, because the mint belongs in the publish
// subject itself (gunbc.github_effect_perform mint_publisher_installation_token), never in a workflow step.
type HealPublisherPolicy {
  workflow_file: NonEmptyStr
  workflow_name: NonEmptyStr
  job_id: NonEmptyStr
  job_display_name: NonEmptyStr
  runner: CiRunnerTarget
  timeout: Minute
  trigger_workflow: NonEmptyStr
  candidate_artifact: NonEmptyStr
  admit_invocation: DagInvocation
  publish_invocation: DagInvocation
  federation: HealPublisherFederation
  pull_requests: PermissionLevel
  build_route: PublisherBuildRoute
}

// HOW THE PUBLISHER OBTAINS THE COMPILER ITS PHASES RUN UNDER. THE TWO WAYS ARE NAMED, NOT IMPLIED. An
// absent seed used to carry this decision, which meant one repository's absence stood for another
// repository's whole policy - toolchain-home isolation, the witness floor's toolchain, the rustup pin and
// a build of this checkout (DESIGN 5's fabricated default, DESIGN 3's meaning fork): a repository with no
// seed silently inherited gunbc's build. `Own_checkout_under_witness_floor` says so and names the binaries;
// `Declared_seed` says the profile's public seed is checked out and built there, the same two steps the
// drift job runs for the seal, and is refused unless a seed is declared. There is deliberately no third
// arm for "no build at all": both phases run `.dag` subjects, so a publisher without a compiler has nothing
// to run, and an arm nobody can inhabit is a default waiting to be selected by mistake.
type PublisherBuildRoute
  = Own_checkout_under_witness_floor { required_bins: List<NonEmptyStr> }
  | Declared_seed

type RepositoryCiProfile {
  repository: String
  default_branch: String
  roster: RosterGate
  public_seed: Optional<PublicSeed>
  heal: Optional<HealWorkflowPolicy>
  drift: Optional<ProjectionDrift>
  publisher: Optional<HealPublisherPolicy>
}

// GUNBC'S OWN ROW. Every value is one the existing gunbc emitters already carry;
// dag/test/claim/repository_ci_profile_witness.dag pins each against the emitter that owns it, so this
// row cannot drift into describing a repository that does not exist while its emitters move on. The
// route is InstrumentLabelRows and the seed is Absent because gunbc IS the compiler's home: it has no
// repository to check out beside itself and no overlay to compose.
fn gunbc_repository_ci_profile() -> RepositoryCiProfile {
  RepositoryCiProfile {
    repository: gunbc_repository_name(),
    default_branch: gunbc_default_branch_name,
    roster: RosterGate {
      workflow_file: "witnesses.yml",
      workflow_name: "witnesses",
      job_id: required_ci_context_name,
      job_display_name: required_ci_context_name,
      required_context: required_ci_context_name,
      runner: selected_ci_runner_target(),
      timeout: minute(90),
      source_roots: witness_layer_roots,
      schedule: Absent,
      memory_budget: Absent,
      route: InstrumentLabelRows,
      annotation: Absent
    },
    public_seed: Absent,
    heal: Present {
      value: HealWorkflowPolicy {
        workflow_file: "heal.yml",
        workflow_name: heal_workflow_authority_name,
        job_id: "heal-generated-artifacts" as NonEmptyStr,
        job_display_name: "heal-generated-artifacts" as NonEmptyStr,
        runner: selected_ci_runner_target(),
        timeout: minute(90)
      }
    },
    drift: Present {
      value: ProjectionDrift {
        workflow_file: "drift-watch.yml",
        workflow_name: drift_watch_authority_name,
        job_id: "tier-o-drift" as NonEmptyStr,
        job_display_name: "tier-o-drift" as NonEmptyStr,
        runner: selected_ci_runner_target(),
        timeout: minute(60),
        cron: Present {
          value: CronSchedule {
            minute: Exact { value: 17 },
            hour: Exact { value: 5 },
            day_of_month: Wildcard,
            month: Wildcard,
            day_of_week: Wildcard
          }
        },
        // THE CHECK SUBJECT, read from its authority (gunbc.ci.ci_spec) rather than re-typed: the drift
        // watch and the CI spec must not hold two copies of which claim polices the generated files.
        check: DagInvocation {
          entry: gunbc_ci_tier_o_drift_check_target.entry,
          function: gunbc_ci_tier_o_drift_check_target.function
        },
        seal: Absent
      }
    },
    publisher: Present {
      value: HealPublisherPolicy {
        workflow_file: "heal-publish.yml",
        workflow_name: heal_publisher_authority_name,
        job_id: "publish" as NonEmptyStr,
        job_display_name: "publish" as NonEmptyStr,
        runner: github_hosted_publisher_runner_target(),
        timeout: minute(45),
        trigger_workflow: heal_workflow_authority_name,
        candidate_artifact: heal_repair_candidate_artifact_name,
        // The two subjects, taken from the targets ci_spec declares for them, which is where the
        // declared-target census folds them. The emitter no longer names either one.
        admit_invocation: DagInvocation {
          entry: gunbc_ci_heal_publication_admit_target.entry,
          function: gunbc_ci_heal_publication_admit_target.function
        },
        publish_invocation: DagInvocation {
          entry: gunbc_ci_heal_publication_publish_target.entry,
          function: gunbc_ci_heal_publication_publish_target.function
        },
        federation: public_heal_publisher_federation(),
        // GUNBC BUILDS ITS OWN PUBLISHER, under the witness floor's toolchain isolation and rustup pin, from
        // the default branch of this checkout. The step shapes are the emitter's; WHICH of the two routes
        // this is, and which binaries it must produce, are here.
        build_route: Own_checkout_under_witness_floor { required_bins: ["gunbc" as NonEmptyStr] },
        // The job token posts the publication receipt comment on the repaired pull request, which is the
        // only write this job performs with its own token; the publication itself goes over the federated
        // identity, minted inside the publish subject rather than in a workflow step. A mirror that
        // publishes with an installation token and leaves its receipts to the App declares `read` here.
        pull_requests: PermWrite
      }
    }
  }
}

// THE NAMES THE TRIGGER AND THE FILE CARRY. Kept as rows rather than read from the emitter modules: the
// emitters read THIS row (gunbc.heal_workflow, gunbc.heal_publisher_workflow and gunbc.drift_watch_workflow
// take their job id, runner and timeout from here), so a rename is one edit here and the emitters follow,
// instead of two authorities that a witness has to keep equal.
data heal_workflow_authority_name: NonEmptyStr = "heal"

data drift_watch_authority_name: NonEmptyStr = "drift-watch"

data heal_publisher_authority_name: NonEmptyStr = "heal-publish"

// THE ACCESSORS THE FOUR GUNBC EMITTERS READ. Each returns an Optional so an emitter that is asked to
// render a job its repository has not declared REFUSES rather than inventing a default: a workflow that
// fires with nothing to publish is exactly the shape these accessors make visible.
fn gunbc_roster_gate() -> RosterGate {
  gunbc_repository_ci_profile().roster
}

// GUNBC'S REQUIRED CONTEXT NAME, for the claims that assert which check must be green to merge and for
// the merge-path list. It is ONE read of the row's field - the emitter module keeps no copy of it, so the
// required job's identity has exactly one spelling: profile.roster.required_context.
fn gunbc_required_context_name() -> String {
  gunbc_roster_gate().required_context as String
}




// THE ACCESSORS THE EMITTERS READ, TYPED AS PRESENCE. A repository that declares no heal job, no drift
// job or no publisher gets `Absent`, and there is NOTHING ELSE those accessors can return: the fabricated
// "no-heal-declared" rows this module used to hand back for an absent arm are deleted, because a row with a
// real-looking job id, a fleet runner and a zero-minute timeout is exactly the fabricated default DESIGN 5
// refuses, and nothing in the type stopped an emitter from rendering one if it forgot to ask first. Each
// emitter now matches on these, so the value it renders is a row its repository declared, and a forgotten
// branch is a resolve error rather than a committed workflow that fires with nothing to do.
fn gunbc_drift_watch_job() -> Optional<ProjectionDrift> {
  gunbc_repository_ci_profile().drift
}

fn gunbc_heal_job() -> Optional<HealWorkflowPolicy> {
  gunbc_repository_ci_profile().heal
}

fn gunbc_heal_publisher_job() -> Optional<HealPublisherPolicy> {
  gunbc_repository_ci_profile().publisher
}

// BOTH HALVES OR NEITHER, read as ONE match over the publisher rather than as an equality between two
// presence Bools: a publisher is legitimate exactly when some job seals a candidate, and its absence is
// legitimate exactly when none does. The seal and the publisher are one transaction split across two jobs
// for credential isolation; one of them alone is a broken transaction, not a partial feature.
fn profile_heal_is_whole(profile: RepositoryCiProfile) -> Bool {
  match profile.publisher {
    Absent => profile_seals_candidate(profile: profile) == false
    Present { value: _ } => profile_seals_candidate(profile: profile)
  }
}

// WHETHER ANY JOB IN THIS PROFILE SEALS A REPAIR CANDIDATE: a heal job of its own (gunbc seals the mirrors
// it regenerates), or the seal inside its drift job (a mirror whose projections are checked by
// projection-drift). Either placement is legitimate. ASKED ONCE, HERE -- the two near-copies this used to
// be (`profile_has_seal`, nested one level shallower, and `profile_has_candidate_source`) were two
// authorities over one fact, which is what let them drift apart in intent while agreeing in text.
fn profile_seals_candidate(profile: RepositoryCiProfile) -> Bool {
  match profile.heal {
    Present { value: _ } => true
    Absent => match profile.drift {
      Present { value: d } => match d.seal {
        Present { value: _ } => true
        Absent => false
      }
      Absent => false
    }
  }
}

// THE PUBLISHER IS TRIGGERED BY THE NAME OF ANOTHER WORKFLOW, so a name no job in this profile emits is
// a publisher that never runs - and the only symptom is a check that stayed pending forever.
fn profile_publisher_trigger_is_declared(profile: RepositoryCiProfile) -> Bool {
  match profile.publisher {
    Absent => true
    Present { value: publisher } => heals_under(profile: profile, trigger: publisher.trigger_workflow)
      || drift_seals_under(profile: profile, trigger: publisher.trigger_workflow)
  }
}

fn heals_under(profile: RepositoryCiProfile, trigger: NonEmptyStr) -> Bool {
  match profile.heal {
    Present { value: heal } => heal.workflow_name == trigger
    Absent => false
  }
}

fn drift_seals_under(profile: RepositoryCiProfile, trigger: NonEmptyStr) -> Bool {
  match profile.drift {
    Present { value: drift } => match drift.seal {
      Present { value: _ } => drift.workflow_name == trigger
      Absent => false
    }
    Absent => false
  }
}

// gunbc's identity as CI sees it: the GitHub slug the required context and every cross-repository
// checkout are compared against. Data rather than an inference from `origin`, because a runner's remote
// is not an authority.
data gunbc_repository_slug: NonEmptyStr = "gunb-ai/gunbc"

fn gunbc_repository_name() -> String {
  gunbc_repository_slug as String
}

// The hosted runner class the public publisher runs on, as a TARGET so its label stays a projection of
// the catalog row (extdeps.github.hosted_runners) rather than a string this row repeats.
fn github_hosted_publisher_runner_target() -> CiRunnerTarget {
  GithubHostedRunner { row: github_hosted_ubuntu_2404_arm_public_catalog }
}

// A FLEET JOB CONFINED TO A DECLARED RUNNER GROUP. The repository naming its own group is the point of
// passing the name in: the mirror's group is not gunbc's business, and gunbc's group name is not the
// mirror's.
fn fleet_runner_group_target(group: NonEmptyStr) -> CiRunnerTarget {
  FleetSelfHostedInDeclaredGroup { group: DeclaredRunnerGroup { name: group } }
}

// THE SEED, when the profile declares one. Emitters that need several seed facts take the row as a
// parameter (admitted once, at the top) rather than unwrapping an Optional at each step builder, so the
// refusal for "no seed declared" happens before any step is rendered.
fn profile_public_seed(profile: RepositoryCiProfile) -> Optional<PublicSeed> {
  profile.public_seed
}

// THE OVERLAY, when the roster runs over a composed root. Same reasoning as the seed: the route carries
// it, and a profile on the instrument route has none.
fn profile_overlay(profile: RepositoryCiProfile) -> Optional<OverlayIngest> {
  match profile.roster.route {
    ComposedOverlayInterpreterRoster { overlay: overlay } => Present { value: overlay }
    InstrumentLabelRows => Absent
  }
}

// THE DISPATCHER RUNS IN THE CHECKOUT THAT ALREADY HOLDS THE COMPILER UNDER TEST. A row that routes its
// roster through it AND declares a seed to build (or an overlay to compose, which only the composed route
// carries) is describing two repositories at once: the gate would report on a binary none of its rows ever
// ran. Read as one match over the route and the seed, because the question is about their combination and
// not about either arm's presence; the emitter that receives the rows asks this and refuses the combination
// rather than emitting a gate that cannot fail.
fn profile_routes_to_dispatcher_while_building_a_second_compiler(profile: RepositoryCiProfile) -> Bool {
  match profile.roster.route {
    InstrumentLabelRows => match profile.public_seed {
      Present { value: _ } => true
      Absent => false
    }
    ComposedOverlayInterpreterRoster { overlay: _ } => false
  }
}

// A PROFILE IS WELL FORMED when its halves agree and no job pins itself to a pool nothing ensures.
// Called by every emitter before it renders a byte, so a mis-shapen row is a refusal at emit time rather
// than a workflow that fails on a runner that was never created, or a seal no publisher will ever read.
fn repository_ci_profile_refusal(profile: RepositoryCiProfile) -> Optional<NonEmptyStr> {
  if profile_heal_is_whole(profile: profile) == false {
    Present { value: "REFUSE: this profile seals repair candidates without a publisher to land them, or publishes candidates that no job sealed. Declare both halves or neither (gunbc.ci.repository_ci_profile profile_heal_is_whole): a seal with no publisher is a candidate no one can land, and a publisher with no seal is a job that can only fail." }
  } else if any(runners_of(profile: profile), t => profile_runner_group_is_declared(target: t) == false) {
    Present { value: "REFUSE: a job pins itself to a runner group that gunbc.runner.runner_group_restriction_ensure does not declare. Ensure the group, or select another CiRunnerTarget (gunbc.ci.ci_runner_target FleetSelfHostedInDeclaredGroup)." }
  } else if profile_publisher_trigger_is_declared(profile: profile) == false {
    Present { value: "REFUSE: the publisher is triggered by the completion of a workflow this profile does not declare, so it can never run with anything to publish. Name the heal or drift workflow that seals the candidate (gunbc.ci.repository_ci_profile profile_publisher_trigger_is_declared)." }
  } else if profile_publisher_build_route_is_coherent(profile: profile) == false {
    Present { value: "REFUSE: the publisher says it builds its compiler from the profile's public seed, and the profile declares no seed to build - a step that would check out nothing and compile nothing. Name the seed, or select Own_checkout_under_witness_floor and build from this checkout (gunbc.ci.repository_ci_profile profile_publisher_build_route_is_coherent)." }
  } else if profile_optional_job_timeouts_are_positive(profile: profile) == false {
    Present { value: "REFUSE: a declared job carries a timeout that is not positive, so it would be killed before it could report a reason. The gate's timeout is refused at zero; heal, drift and publisher timeouts are held to the same bound (gunbc.ci.repository_ci_profile profile_optional_job_timeouts_are_positive)." }
  } else if minute_count(m: profile.roster.timeout) == 0 {
    Present { value: "REFUSE: the required gate declares a timeout that is not positive; it would be killed before it could report a reason." }
  } else if profile_routes_to_dispatcher_while_building_a_second_compiler(profile: profile) {
    Present { value: "REFUSE: this profile routes its roster through the instrument dispatcher while declaring a seed compiler or an overlay to compose. The dispatcher runs every row in the checkout that already holds the compiler under test, so the seed would build a second copy of it and the overlay would compose a root nothing reads. Take the composed route, or declare neither (gunbc.ci.repository_ci_profile RosterRoute)." }
  } else {
    Absent
  }
}

// THE RUNNERS EVERY DECLARED JOB LANDS ON, so the group declaration check covers each job that exists
// rather than the one anyone remembered to check. An undeclared job contributes nothing to the list: there
// is no sentinel target standing in for a job this repository does not have, which would be the same
// fabricated default the accessors refuse.
fn runners_of(profile: RepositoryCiProfile) -> List<CiRunnerTarget> {
  concat(
    [profile.roster.runner],
    concat(
      match profile.heal {
        Present { value: h } => [h.runner]
        Absent => []
      },
      concat(
        match profile.drift {
          Present { value: d } => [d.runner]
          Absent => []
        },
        match profile.publisher {
          Present { value: p } => [p.runner]
          Absent => []
        }
      )
    )
  )
}

// THE GROUP MUST BE A DECLARED GROUP. A restricted runner group is a repository-side resource that an
// ensure job creates; a job pinned to a group nothing ensures is a job that never runs, and the failure
// surfaces as a check that stayed pending forever rather than as a refusal with a reason.
fn profile_runner_group_is_declared(target: CiRunnerTarget) -> Bool {
  match target {
    FleetSelfHostedInDeclaredGroup { group: group } =>
      any(restricted_runner_groups(), g => g.name == group.name)
    _ => true
  }
}

// A ROUTE THAT NAMES A SEED HAS TO HAVE ONE. The route and the seed are separate fields because the seed is
// shared with the drift job and the witness lane - a publisher may build from its own checkout while the
// drift job seals against a seed - so their agreement is a rule rather than a type. Only one direction can
// fail: a route naming a seed the profile does not declare. The other arm checks nothing, because
// `required_bins` is a List<NonEmptyStr> and an empty bin is a state that cannot be written (DESIGN §4b).
fn profile_publisher_build_route_is_coherent(profile: RepositoryCiProfile) -> Bool {
  match profile.publisher {
    Absent => true
    Present { value: p } =>
      match p.build_route {
        Own_checkout_under_witness_floor { required_bins: _ } => true
        Declared_seed =>
          match profile.public_seed {
            Present { value: _ } => true
            Absent => false
          }
      }
  }
}

// BOTH HALVES OF AN INVOCATION ARE WRITABLE-BY-CONSTRUCTION. `DagInvocation`'s entry and function are
// NonEmptyStrs, so an admit or publish phase cannot be declared with an empty half and there is no state
// left for a predicate to catch (DESIGN §5: making a wrong state unwritable beats catching it). An
// invocation whose module or function is absent is therefore a type error, not a runtime refusal.

// A TIMEOUT OF ZERO KILLS A JOB BEFORE IT REPORTS WHY. The roster's own timeout has always been refused
// at zero; the three optional jobs are the same kind of job and get the same bound, so declaring a job at
// `minute(0)` cannot commit a step that is cancelled on arrival.
fn profile_optional_job_timeouts_are_positive(profile: RepositoryCiProfile) -> Bool {
  match profile.heal {
    Present { value: h } => minute_count(m: h.timeout) > 0
    Absent => true
  }
    && match profile.drift {
        Present { value: d } => minute_count(m: d.timeout) > 0
        Absent => true
      }
    && match profile.publisher {
        Present { value: p } => minute_count(m: p.timeout) > 0
        Absent => true
      }
}

// THE ADMISSION THE FOUR GUNBC EMITTERS CALL BEFORE THEY RENDER A BYTE is `repository_ci_profile_refusal`
// applied to THE ROW THEY ARE ABOUT TO RENDER - not to a row rebuilt from this module's own global. An
// earlier shape here read `gunbc_repository_ci_profile()` inside the emitters' admission while the builders
// rendered the profile argument, so an emitter could refuse one repository and commit another's workflow:
// the admission proved nothing about the bytes. Each emitter now matches the check once, at its entrypoint,
// on the profile it was handed, and threads that same profile into every builder. So there is no
// gunbc-shaped wrapper around the check to call by mistake, and the only way an emitter can render is to
// have admitted the very row it renders.
//
// THE ROW UPDATERS A TEST USES TO BREAK ONE FIELD AT A TIME. A control that builds a whole invalid row
// from scratch cannot tell "the emitter refused the undeclared runner group" from "the emitter refused
// because the row had no heal job": the second refusal looks like the first. These four take a VALID row
// - a repository's own, in the witness's case - and change only the runner of one declared job, so the
// difference between the positive and the negative case is the fact under test. Each returns the row
// unchanged when that job is not declared at all; the caller asks the row first, because a control that
// silently mutated nothing would pass by proving nothing.
fn profile_with_roster_runner(profile: RepositoryCiProfile, runner: CiRunnerTarget) -> RepositoryCiProfile {
  RepositoryCiProfile {
    repository: profile.repository,
    default_branch: profile.default_branch,
    roster: RosterGate {
      workflow_file: profile.roster.workflow_file,
      workflow_name: profile.roster.workflow_name,
      job_id: profile.roster.job_id,
      job_display_name: profile.roster.job_display_name,
      required_context: profile.roster.required_context,
      runner: runner,
      timeout: profile.roster.timeout,
      source_roots: profile.roster.source_roots,
      schedule: profile.roster.schedule,
      memory_budget: profile.roster.memory_budget,
      route: profile.roster.route,
      annotation: profile.roster.annotation
    },
    public_seed: profile.public_seed,
    heal: profile.heal,
    drift: profile.drift,
    publisher: profile.publisher
  }
}

// THE ONE UPDATE THAT IS NOT A RUNNER: the required gate's identity. A control that renames the required
// context and moves the job to a hosted runner asks whether the fleet-only conjunct of the capability gate
// sees the JOB THE ROW DECLARES or some other repository's job id.
fn profile_with_required_context(profile: RepositoryCiProfile, name: NonEmptyStr) -> RepositoryCiProfile {
  RepositoryCiProfile {
    repository: profile.repository,
    default_branch: profile.default_branch,
    roster: RosterGate {
      workflow_file: profile.roster.workflow_file,
      workflow_name: profile.roster.workflow_name,
      job_id: profile.roster.job_id,
      job_display_name: profile.roster.job_display_name,
      required_context: name,
      runner: profile.roster.runner,
      timeout: profile.roster.timeout,
      source_roots: profile.roster.source_roots,
      schedule: profile.roster.schedule,
      memory_budget: profile.roster.memory_budget,
      route: profile.roster.route,
      annotation: profile.roster.annotation
    },
    public_seed: profile.public_seed,
    heal: profile.heal,
    drift: profile.drift,
    publisher: profile.publisher
  }
}

fn profile_with_heal_runner(profile: RepositoryCiProfile, runner: CiRunnerTarget) -> RepositoryCiProfile {
  match profile.heal {
    Absent => profile
    Present { value: job } => RepositoryCiProfile {
      repository: profile.repository,
      default_branch: profile.default_branch,
      roster: profile.roster,
      public_seed: profile.public_seed,
      heal: Present {
        value: HealWorkflowPolicy {
          workflow_file: job.workflow_file,
          workflow_name: job.workflow_name,
          job_id: job.job_id,
          job_display_name: job.job_display_name,
          runner: runner,
          timeout: job.timeout
        }
      },
      drift: profile.drift,
      publisher: profile.publisher
    }
  }
}

fn profile_with_drift_runner(profile: RepositoryCiProfile, runner: CiRunnerTarget) -> RepositoryCiProfile {
  match profile.drift {
    Absent => profile
    Present { value: job } => RepositoryCiProfile {
      repository: profile.repository,
      default_branch: profile.default_branch,
      roster: profile.roster,
      public_seed: profile.public_seed,
      heal: profile.heal,
      drift: Present {
        value: ProjectionDrift {
          workflow_file: job.workflow_file,
          workflow_name: job.workflow_name,
          job_id: job.job_id,
          job_display_name: job.job_display_name,
          runner: runner,
          timeout: job.timeout,
          cron: job.cron,
          check: job.check,
          seal: job.seal
        }
      },
      publisher: profile.publisher
    }
  }
}

fn profile_with_publisher_runner(profile: RepositoryCiProfile, runner: CiRunnerTarget) -> RepositoryCiProfile {
  match profile.publisher {
    Absent => profile
    Present { value: job } => RepositoryCiProfile {
      repository: profile.repository,
      default_branch: profile.default_branch,
      roster: profile.roster,
      public_seed: profile.public_seed,
      heal: profile.heal,
      drift: profile.drift,
      publisher: Present {
        value: HealPublisherPolicy {
          workflow_file: job.workflow_file,
          workflow_name: job.workflow_name,
          job_id: job.job_id,
          job_display_name: job.job_display_name,
          runner: runner,
          timeout: job.timeout,
          trigger_workflow: job.trigger_workflow,
          candidate_artifact: job.candidate_artifact,
          admit_invocation: job.admit_invocation,
          publish_invocation: job.publish_invocation,
          federation: job.federation,
          build_route: job.build_route,
          pull_requests: job.pull_requests
        }
      }
    }
  }
}

// A CONTROL'S SINGLE-FIELD EDIT, the same shape as the runner updaters above: a negative is built from
// gunbc's own row with ONLY the publisher's build route changed, so the refusal a control observes is that
// field's refusal and not some other conjunct's. As with the others, applying it to a profile with no
// publisher changes nothing, and the control that uses it asserts the publisher is declared first.
fn profile_with_publisher_build_route(profile: RepositoryCiProfile, route: PublisherBuildRoute) -> RepositoryCiProfile {
  match profile.publisher {
    Absent => profile
    Present { value: job } =>
      RepositoryCiProfile {
        repository: profile.repository,
        default_branch: profile.default_branch,
        roster: profile.roster,
        public_seed: profile.public_seed,
        heal: profile.heal,
        drift: profile.drift,
        publisher: Present {
          value: HealPublisherPolicy {
            workflow_file: job.workflow_file,
            workflow_name: job.workflow_name,
            job_id: job.job_id,
            job_display_name: job.job_display_name,
            runner: job.runner,
            timeout: job.timeout,
            trigger_workflow: job.trigger_workflow,
            candidate_artifact: job.candidate_artifact,
            admit_invocation: job.admit_invocation,
            publish_invocation: job.publish_invocation,
            federation: job.federation,
            build_route: route,
            pull_requests: job.pull_requests
          }
        }
      }
  }
}
