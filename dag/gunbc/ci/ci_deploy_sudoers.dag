// Wave C envelope: /etc/sudoers.d/gunbc-deploy is EMITTED from the roster grants (never
// hand-managed). visudo -c gates install. Generic movers (rsync/chown) are refused in the roster —
// #7011 realization routes tree sync through gunbc-tree-sync.service and ownership through install
// -o/-g. Sudo-grant lint allow-list is DERIVED from fleet_posix_ci_runner_sudo_grants()
// command_path rows — never a parallel path list.

data refused_generic_mover_paths: List<NonEmptyStr> = [
  "/usr/bin/rsync",
  "/usr/bin/chown",
]

fn posix_sudo_grant_is_refused_generic_mover(g: PosixSudoGrant) -> Bool {
  any(refused_generic_mover_paths, p => p == g.command_path)
}

fn posix_sudo_grant_command_paths_match(row: PosixSudoGrant, g: PosixSudoGrant) -> Bool {
  row.command_path == g.command_path
}

fn posix_sudo_grant_is_allowed_roster_command(g: PosixSudoGrant) -> Bool {
  any(
    fleet_posix_ci_runner_sudo_grants(),
    row => posix_sudo_grant_command_paths_match(row: row, g: g)
  )
}

fn posix_sudo_grant_generic_mover_lint_ok(g: PosixSudoGrant) -> Bool {
  if posix_sudo_grant_is_refused_generic_mover(g: g) {
    false
  } else {
    posix_sudo_grant_is_allowed_roster_command(g: g)
  }
}

fn deploy_access_sudo_grants_lint_ok(access: DeployAccess) -> Bool {
  fold_list(
    xs: access.principal.sudo_grants,
    empty: true,
    cons: (acc, g) =>
      if !acc {
        false
      } else {
        posix_sudo_grant_generic_mover_lint_ok(g: g)
      }
  )
}

fn deploy_sudoers_dropin_header() -> String {
  "# GENERATED by dag/gunbc/ci/ci_deploy_sudoers.dag — do not hand-edit"
}

fn deploy_sudoers_line_for_grant(access: DeployAccess, g: PosixSudoGrant) -> String {
  deploy_access_sudoers_line(
    access: access,
    cmd: posix_sudo_grant_to_privileged(g: g)
  )
}

// THE DROP-IN IS HOST-SHARED, SO ITS BODY IS THE UNION OVER EVERY ACCESS THAT DEPLOYS TO THE HOST
// (gunbc.ci.ci_deploy_access deploy_accesses_on_host), not the running access's own grants. Rendering
// from the running access alone made an operator-local apply rewrite the file to the operator's one
// line and delete the CI runner's grants. One line per (principal, grant), first occurrence kept
// in roster order, header first. The heredoc row (v2.workflow.bash_emit bash_emit_heredoc)
// terminates the body itself, so the lines are joined without a trailing newline.
fn deploy_sudoers_dropin_lines_for(accesses: List<DeployAccess>) -> List<String> {
  distinct_by_key(
    xs: list_flat_map(xs: accesses, f: a => map(a.principal.sudo_grants, g => deploy_sudoers_line_for_grant(access: a, g: g))),
    key: l => l,
  )
}

fn deploy_sudoers_dropin_body_for(accesses: List<DeployAccess>) -> String {
  join(concat([deploy_sudoers_dropin_header()], deploy_sudoers_dropin_lines_for(accesses: accesses)), "\n")
}

fn deploy_sudoers_dropin_body(access: DeployAccess) -> String {
  deploy_sudoers_dropin_body_for(accesses: deploy_accesses_on_host(host: access.host))
}

// THE SAME INSTALL, AS A TYPED ARGV — the sibling of deploy_sudoers_install_stmts for the typed route
// (gunbc.host.host_effect_realize live_deploy_apply_preamble_on_host). Both read deploy_sudoers_file_mode
// and coreutils_install_mode_flag, so the `0440` policy is spelled ONCE in this module and neither route
// can drift or be loosened by a caller. The mode is a local constant, not a parameter: a caller that could
// pass a mode could pass 0666. Program identity is argv_command's sealed constructor (this module is a
// named caller), so nothing here can carry a shell metacharacter, and no argv is ever rejoined into a
// string to be re-parsed.
data deploy_sudoers_file_mode: NonEmptyStr = "0440"

fn deploy_sudoers_install_argv(stage: String, dropin: String) -> ArgvCommand {
  let install = ci_runner_sudo_binary_path(b: SudoInstall) as String
  sudo_elevate_command(
    command: [install, coreutils_install_mode_flag as String, deploy_sudoers_file_mode as String, stage, dropin],
  )
}
