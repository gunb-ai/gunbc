module gunbc.ci_deploy_sudoers

import std.types { String, NonEmptyStr, List, Bool }
import v2.std.algebra { fold_list, list_flat_map }
import std.list { distinct_by_key }
import extdeps.sudo.elevation { sudo_elevate_argv }
import v2.extdeps.languages.bash_build {
  bash_build_command_from_lits,
  bash_build_command_with_words,
  bash_build_exit,
  bash_build_if_from_stmts,
  bash_build_negation,
  bash_build_with_redir,
  bash_build_word_concat_from_nodes,
  bash_build_word_lit,
  bash_build_word_var,
}
import v2.workflow.bash_emit { bash_emit_heredoc, bash_emit_program_sequence_script, bash_emit_stmts }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.node { Node }
import extdeps.sudo.nopasswd_execute_probe {
  NopasswdExecuteCheck,
  NopasswdGrantListCheck,
  SudoNopasswdExecuteProbeShape,
  SudoNopasswdGrantListProbeShape,
}
import extdeps.sudo.nopasswd_execute_probe_check_op {
  sudo_nopasswd_execute_probe_shell_condition,
  sudo_nopasswd_grant_list_shell_condition,
}
import gunbc.ci_deploy_access {
  DeployAccess,
  PrivilegedCommand,
  deploy_accesses_on_host,
  gunbc_deploy_sudoers_dropin,
  deploy_access_sudoers_line,
  posix_sudo_grant_to_privileged,
}
import gunbc.fleet_posix_accounts {
  PosixSudoGrant,
  SudoVisudo,
  SudoInstall,
  fleet_posix_ci_runner_sudo_grants,
  ci_runner_sudo_binary_path,
}

// Wave C envelope: /etc/sudoers.d/gunbc-deploy is EMITTED from the roster grants (never
// hand-managed). visudo -c gates install. Generic movers (rsync/chown) are refused in the roster —
// #7011 realization routes tree sync through gunbc-tree-sync.service and ownership through install
// -o/-g. Sudo-grant lint allow-list is DERIVED from fleet_posix_ci_runner_sudo_grants()
// command_path rows — never a parallel path list.

data refused_generic_mover_paths: List<NonEmptyStr> = [
  "/usr/bin/rsync",
  "/usr/bin/chown",
]

fn posix_sudo_grant_is_refused_generic_mover(g: PosixSudoGrant) -> Bool {
  any(refused_generic_mover_paths, p => p == g.command_path)
}

fn posix_sudo_grant_command_paths_match(row: PosixSudoGrant, g: PosixSudoGrant) -> Bool {
  row.command_path == g.command_path
}

fn posix_sudo_grant_is_allowed_roster_command(g: PosixSudoGrant) -> Bool {
  any(
    fleet_posix_ci_runner_sudo_grants(),
    row => posix_sudo_grant_command_paths_match(row: row, g: g)
  )
}

fn posix_sudo_grant_generic_mover_lint_ok(g: PosixSudoGrant) -> Bool {
  if posix_sudo_grant_is_refused_generic_mover(g: g) {
    false
  } else {
    posix_sudo_grant_is_allowed_roster_command(g: g)
  }
}

fn deploy_access_sudo_grants_lint_ok(access: DeployAccess) -> Bool {
  fold_list(
    xs: access.principal.sudo_grants,
    empty: true,
    cons: (acc, g) =>
      if !acc {
        false
      } else {
        posix_sudo_grant_generic_mover_lint_ok(g: g)
      }
  )
}

fn deploy_sudoers_dropin_header() -> String {
  "# GENERATED by dag/gunbc/ci/ci_deploy_sudoers.dag — do not hand-edit"
}

fn deploy_sudoers_line_for_grant(access: DeployAccess, g: PosixSudoGrant) -> String {
  deploy_access_sudoers_line(
    access: access,
    cmd: posix_sudo_grant_to_privileged(g: g)
  )
}

// THE DROP-IN IS HOST-SHARED, SO ITS BODY IS THE UNION OVER EVERY ACCESS THAT DEPLOYS TO THE HOST
// (gunbc.ci_deploy_access deploy_accesses_on_host), not the running access's own grants. Rendering
// from the running access alone made an operator-local apply rewrite the file to the operator's one
// line and delete the CI runner's grants. One line per (principal, grant), first occurrence kept
// in roster order, header first. The heredoc row (v2.workflow.bash_emit bash_emit_heredoc)
// terminates the body itself, so the lines are joined without a trailing newline.
fn deploy_sudoers_dropin_lines_for(accesses: List<DeployAccess>) -> List<String> {
  distinct_by_key(
    xs: list_flat_map(xs: accesses, f: a => map(a.principal.sudo_grants, g => deploy_sudoers_line_for_grant(access: a, g: g))),
    key: l => l,
  )
}

fn deploy_sudoers_dropin_body_for(accesses: List<DeployAccess>) -> String {
  join(concat([deploy_sudoers_dropin_header()], deploy_sudoers_dropin_lines_for(accesses: accesses)), "\n")
}

fn deploy_sudoers_dropin_body(access: DeployAccess) -> String {
  deploy_sudoers_dropin_body_for(accesses: deploy_accesses_on_host(host: access.host))
}

// THE ELEVATION PREFIX IS READ FROM extdeps.sudo.elevation sudo_elevate_argv, not typed here, so the
// two tokens that cross the privilege boundary have one authority in the repository.
fn deploy_sudoers_elevated(command: List<String>, tail: List<Node>) -> Node {
  bash_build_command_with_words(words: concat(map(sudo_elevate_argv(command: command), w => bash_build_word_lit(text: w)), tail))
}

fn deploy_sudoers_stage_word() -> Node {
  bash_build_word_concat_from_nodes(parts: [
    bash_build_word_var(name: "_gunbc_stage"),
    bash_build_word_lit(text: "/gunbc-deploy.sudoers"),
  ])
}

// THE FULL ROSTER IS DEMANDED HERE, AFTER THE INSTALL, AND A MISS STOPS THE SCRIPT BEFORE ANY OTHER
// MUTATION. The pre-mutation gate demands only what the install spends
// (gunbc.ci_deploy_access deploy_access_sudoers_install_scope), because the install is what grants
// the rest; so this is where the rest is required, one probe per privileged command, with the same
// probe kind the roster row declares: an execute check runs the sudo -n argv of
// extdeps.sudo.nopasswd_execute_probe_check_op sudo_nopasswd_execute_probe_argv, and a grant-list
// check (a binary that may not be installed yet) requires an exact NOPASSWD row in `sudo -n -l`, the
// same exact-row reading as sudo_nopasswd_grant_list_line_admits_probe. The refusal is loud and
// exits nonzero; it is not a warning.
data deploy_sudoers_post_install_refusal_prefix: String = "deploy_access: typed refusal after sudoers install, before any other mutation -- roster command not granted by the installed drop-in:"

fn deploy_sudoers_post_install_refusal(cmd: PrivilegedCommand) -> List<Node> {
  [
    bash_build_with_redir(
      inner: bash_build_command_from_lits(lits: ["echo", concat(concat(deploy_sudoers_post_install_refusal_prefix, " "), cmd.grant.command_path as String)]),
      redir: ^bash_production_fold_redir_stdout_to_stderr
    ),
    bash_build_exit(code: "1"),
  ]
}

fn deploy_sudoers_post_install_probe_stmt(cmd: PrivilegedCommand) -> Node {
  let probe = match cmd.grant.probe {
    NopasswdExecuteCheck { check_argv: a } =>
      sudo_nopasswd_execute_probe_shell_condition(probe: SudoNopasswdExecuteProbeShape {
        command_path: cmd.grant.command_path,
        check_argv: a,
      })
    NopasswdGrantListCheck =>
      sudo_nopasswd_grant_list_shell_condition(probe: cmd.grant.command_path as SudoNopasswdGrantListProbeShape)
  }
  bash_build_if_from_stmts(cond: bash_build_negation(inner: probe), then_stmts: deploy_sudoers_post_install_refusal(cmd: cmd))
}

fn deploy_sudoers_post_install_roster_probe_stmts(access: DeployAccess) -> List<Node> {
  map(access.privileged_commands, cmd => deploy_sudoers_post_install_probe_stmt(cmd: cmd))
}

// visudo and install are read from gunbc.fleet_posix_accounts ci_runner_sudo_binary_path, the same
// rows ci_runner_sudoers_install_binaries names, so what this step spends and what the pre-install
// gate demands cannot drift apart.
fn deploy_sudoers_install_stmts(access: DeployAccess) -> List<Node> {
  let visudo = ci_runner_sudo_binary_path(b: SudoVisudo) as String
  let install = ci_runner_sudo_binary_path(b: SudoInstall) as String
  let dropin = gunbc_deploy_sudoers_dropin as String
  concat(
    [
      deploy_sudoers_elevated(command: [visudo, "-cf"], tail: [deploy_sudoers_stage_word()]),
      deploy_sudoers_elevated(command: [install, "-m", "0440"], tail: [deploy_sudoers_stage_word(), bash_build_word_lit(text: dropin)]),
      deploy_sudoers_elevated(command: [visudo, "-cf", dropin], tail: []),
    ],
    deploy_sudoers_post_install_roster_probe_stmts(access: access)
  )
}

// The String seam into gunbc.live_deploy.emit deploy_raw cannot carry diagnostics, so a refused
// emission becomes a marker that is not valid shell and fails the deploy step loudly. It is never a
// partial script (DESIGN 5: refuse, never widen).
data deploy_sudoers_install_refused_poison: String = "__GUNBC_BASH_EMIT_REFUSED__ gunbc.ci_deploy_sudoers deploy_sudoers_install_shell: the bash serializer refused the install program; this marker is not valid shell\n"

fn deploy_sudoers_install_shell(access: DeployAccess) -> String {
  let heredoc = bash_emit_heredoc(
    path_spelling: "\"$_gunbc_stage/gunbc-deploy.sudoers\"",
    delimiter: "GUNBC_SUDOERS_EOF",
    body: deploy_sudoers_dropin_body(access: access)
  )
  match heredoc {
    Rejected { diagnostics: _ } => deploy_sudoers_install_refused_poison
    Accepted { value: dropin_text, diagnostics: _ } =>
      match bash_emit_stmts(statements: deploy_sudoers_install_stmts(access: access), set_e: false) {
        Rejected { diagnostics: _ } => deploy_sudoers_install_refused_poison
        Accepted { value: program, diagnostics: _ } =>
          bash_emit_program_sequence_script(programs: [concat(dropin_text, "\n"), program])
      }
  }
}
