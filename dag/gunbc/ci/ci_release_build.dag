module gunbc.ci.ci_release_build

import std.types { String }
import v2.std.node { Node }
import v2.extdeps.languages.bash_build { bash_build_command_with_words, bash_build_word_concat_from_nodes, bash_build_word_lit, bash_build_word_var }
import extdeps.rust.cargo { cargo_default_release_dir }
import gunbc.ci.ci_release_bins { EmittedReleaseBin, ci_emitted_release_bins, ci_floor_required_artifact_names }
import gunbc.repo.repo_self_emitted_build { repo_self_emitted_crate_build_command }

// The release build: the cargo bins line, each emitted release bin's build line, the pack line
// the fleet release-bins key names, and the verify statement over the built roster. Moved out of
// gunbc.ci.ci_spec unchanged (gunbc.plans.closure_consolidation P1); membership stays with
// gunbc.ci.ci_release_bins and the bash realization with v2.workflow.ci_release_build_emit.

data ci_release_features: String = "text_lookup_work_counter,interp_test_witness,test_hooks"

fn ci_release_build_line() -> String {
  concat(
    concat(
      "\"$CARGO_BIN\" build -p v1-compiler --release --features ",
      ci_release_features
    ),
    fold(
      ci_floor_required_artifact_names(),
      init: "",
      f: (acc, name) => concat(acc, concat(" --bin ", name))
    )
  )
}

// THE BUILD OF ONE EMITTED RELEASE BIN (gunbc.ci.ci_release_bins EmittedReleaseBin), run after the
// cargo bins exist because it needs the gunbc this job just built: emit the entry's Rust closure,
// build the emitted crate under gunbc.repo.repo_self_emitted_build (the flag set the seed's probe
// build also runs), and install the one executable at target/release/<name>. The executable's name
// is read from the emitted crate's own manifest, never assumed to be the probe's package name.
// The line is a shell-transport spelling, like ci_release_build_line beside it: it dissolves onto extdeps.rust.cargo_build
// (and a typed read of cargo's own executable record in place of the sed over its JSON stream) when the ci emit seam can
// bind a typed cargo operation instead of a hand-spelled argv line. Failure is loud on both uses: the job script runs each
// bin as its own statement under the workflow's `set -e`, and an unreadable executable path leaves cp with an empty source.
// ci_release_pack_build_line joins the lines with " ; " only as the TEXT the pack key names; it is never executed.
fn ci_emitted_release_build_line(bin: EmittedReleaseBin) -> String {
  let dir = join(["\"$ROOT/target/emitted/", bin.name, "\""], "")
  let stream = join(["\"$ROOT/target/emitted/", bin.name, ".cargo.json\""], "")
  // The release dir comes from cargo's default-layout home, as in ci_release_artifact_word; with the
  // shell var as build_root the emitted text is byte-identical, so the fleet pack key does not move.
  let release_dir = cargo_default_release_dir(build_root: "$ROOT")
  join([
    "rm -rf ", dir, " && \"", release_dir, "/gunbc\" compile --source-root dag --source-root src/v1 --source-root src/v2 --entry ", bin.entry,
    " --output-dir ", dir, " --target rust && ( cd ", dir, " && ", repo_self_emitted_crate_build_command(cargo: "\"$CARGO_BIN\""), " ) > ", stream,
    " && cp \"$(sed -n 's/.*\"executable\":\"\\([^\"]*\\)\".*/\\1/p' ", stream, " | tail -n 1)\" \"", release_dir, "/", bin.name, "\"",
  ], "")
}

// The whole build the fleet pack's key names: the cargo bins, then each emitted release bin.
fn ci_release_pack_build_line() -> String {
  fold(
    ci_emitted_release_bins(),
    init: ci_release_build_line(),
    f: (acc, bin) => join([acc, " ; ", ci_emitted_release_build_line(bin: bin)], "")
  )
}

// DERIVED pack membership — authority is gunbc.ci.ci_release_bins (ci_floor_invoked_bins ∪
// witness_declared_release_bins). The hand List that lived here was deleted 2026-07-26: fan-out
// (build --bin flags / pack / verify) still folds ci_floor_required_artifact_names(), but
// MEMBERSHIP is no longer a free-floating hand list here. See
// gunbc.ci.ci_release_bins.ci_release_bins_authority_note for the construction wall
// (WitnessBinNotEnrolled) and the dissolve-on for witness_declared_release_bins. Operator job-split
// ruling 2026-07-11 still applies to the handoff shape. The intentionally-absent negative control
// (no_such_witness_bin_zzz) is excluded. The build-if-absent stale-binary class (#6352) is out of
// scope: a same-run artifact is fresh by construction.
fn ci_release_artifact_word(name: String) -> Node {
  bash_build_word_concat_from_nodes(parts: [
    bash_build_word_var(name: "ROOT"),
    // The literal is derived from cargo's default-layout home (extdeps.rust.cargo), not
    // re-spelled: this word is where the CI release-artifact check reads its binaries from, so a
    // hand-written join here is the one leaf that could compile green while pointing the floor's
    // verify at a directory cargo no longer uses. The bash-word medium keeps ROOT as a var node;
    // only the constant segment comes from the fn (empty build_root -> "/target").
    bash_build_word_lit(text: concat(cargo_default_release_dir(build_root: ""), concat("/", name))),
  ])
}

// claim_executor verifies every roster bin it was built beside, itself included.
fn ci_floor_build_verify_stmt() -> Node {
  bash_build_command_with_words(words: concat(
    [ci_release_artifact_word(name: "claim_executor"), bash_build_word_lit(text: "--verify-build-artifacts")],
    map(ci_floor_required_artifact_names(), name => ci_release_artifact_word(name: name))
  ))
}
