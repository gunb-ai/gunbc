module gunbc.ci_bootstrap_pr_open

import std.types { String, NonEmptyStr, Bool, Int, HttpStatus }
import std.credentials { CredentialSource, EnvVar }
import extdeps.github.pulls
import extdeps.github.pulls { PullRequestState, Open, Closed }
import extdeps.transports.rest { RestOutcome, RestOk, RestStatusRefused, RestTransportRefused, RestBodyUndecodable }
import std.process { ProcessExit, ExitSuccess, exit_failure }
import gunbc.repository { gunbc_repository }
import v2.std.optional { Present }

// THE BOOTSTRAP PULL REQUEST: ONE OPERATION, ONE JUDGEMENT, ONE RETRACTION.
//
// The first cut (gunbc#10894, hardened in gunbc#10904) spelled this as a concatenated shell blob
// in the workflow emitter -- curl to resolve a ref, curl to count open pull requests, curl to
// POST, python one-liners to read fields back, string compares for the postconditions. Every
// operation in it was ALREADY MODELLED, so the blob was a second representation of operations
// that already had one: the DESIGN section 6 unmodelled-realization tell.
//
// WHAT THE STRING FORM COST, measured: two defects that each reached a compile.
// `${GITHUB_REPOSITORY%%/*}` parsed as .dag interpolation, and `%\{http_code}` was double-escaped
// into the same trap. Neither is writable here -- there is no medium to escape into.
//
// THEN TWO PRECHECKS WERE DELETED, and this is the shape the operation should always have had.
// It read the branch head with Commits.Get to compare against the pin, and listed pull requests
// to refuse a duplicate. BOTH ARE REDUNDANT READS. The pin is enforced by the POSTCONDITION,
// which checks the sha of what was ACTUALLY CREATED rather than what a prior read predicted; and
// Pulls.Create already answers 422 when a pull request exists on the branch, carrying upstream's
// own message. Two reads that could disagree with the act they preceded are gone, and with them
// the only two calls in this module that had ever failed in CI -- Commits.Get returned a Null
// `detail` on run 34437042493 and crashed the entry before any refusal arm could return.
//
// WHAT THE SIMPLIFICATION GIVES UP, stated because it is a real behavioural difference: on a
// moved head the launcher now CREATES THEN CLOSES rather than never creating. The guarantee is
// unchanged -- no pull request survives that does not match the pin -- but a spurious one exists
// briefly. That is the cost of judging the act instead of predicting it, and it buys a judgement
// that cannot be stale.

data bootstrap_pr_head_branch: NonEmptyStr = "heal-canonical-author-v2"

data bootstrap_pr_expected_head_sha: String = "72d2584a3e0e898e1a6622c7e992696ed4c11366"

data bootstrap_pr_expected_author: String = "github-actions[bot]"

data bootstrap_pr_title: NonEmptyStr = "Heal commit metadata names the account that actually pushes it"

// The Actions job credential. This is what makes the created pull request authored by
// github-actions[bot], which is the entire point of the operation rather than an incidental
// detail of how it authenticates.
data bootstrap_pr_credential: CredentialSource = EnvVar { name: "GITHUB_TOKEN" }

type BootstrapPostcondition
  = PostconditionsMet
  | PostconditionMismatch {
      author_ok: Bool
      head_sha_ok: Bool
      head_ref_ok: Bool
      base_ref_ok: Bool
    }

// CHECKED ON ALL FOUR AXES BECAUSE THE CREATE NAMES A MUTABLE REF. The pin is a sha; the create
// names a branch, and only the response says what was actually created. This is now the ONLY
// enforcement of the pin, which is why it checks the sha rather than trusting an earlier read.
fn check_postconditions(
  observed_author: String,
  observed_head_sha: String,
  observed_head_ref: String,
  observed_base_ref: String,
  expected_author: String,
  expected_head_sha: String,
  expected_head_ref: String,
  expected_base_ref: String
) -> BootstrapPostcondition {
  let author_ok = observed_author == expected_author
  let head_sha_ok = observed_head_sha == expected_head_sha
  let head_ref_ok = observed_head_ref == expected_head_ref
  let base_ref_ok = observed_base_ref == expected_base_ref
  if author_ok && head_sha_ok && head_ref_ok && base_ref_ok {
    PostconditionsMet
  } else {
    PostconditionMismatch {
      author_ok: author_ok,
      head_sha_ok: head_sha_ok,
      head_ref_ok: head_ref_ok,
      base_ref_ok: base_ref_ok
    }
  }
}

fn postcondition_failed_axes(p: BootstrapPostcondition) -> String {
  match p {
    PostconditionsMet => ""
    PostconditionMismatch { author_ok, head_sha_ok, head_ref_ok, base_ref_ok } =>
      join([
        if author_ok { "" } else { " author" },
        if head_sha_ok { "" } else { " head_sha" },
        if head_ref_ok { "" } else { " head_ref" },
        if base_ref_ok { "" } else { " base_ref" }
      ], "")
  }
}

fn rest_ok(outcome: RestOutcome) -> Bool {
  match outcome {
    RestOk => true
    RestStatusRefused { status: _, body: _ } => false
    RestTransportRefused { cause: _ } => false
    RestBodyUndecodable { status: _, cause: _ } => false
  }
}

// A 403 is the organisation setting, not a defect here, and a 422 is upstream saying a pull
// request already exists on this branch -- which is why no precheck lists them. Both are named so
// the reader learns which without reading this module.
fn create_refusal_text(status: HttpStatus, body: String) -> String {
  join([
    "BootstrapPullRequestRefused: GitHub answered status ", to_string(status as Int),
    ". 403 means the organisation setting 'Allow GitHub Actions to create and approve pull requests' is disabled -- a control-plane setting, not a defect in this operation. 422 usually means a pull request already exists for this branch. Body: ",
    body
  ], "")
}

data bootstrap_pr_body: String = "Opened by the Actions job credential, so this pull request is authored by github-actions[bot].\n\nWHAT MERGING THIS ESTABLISHES, exactly one input: that github-actions[bot] has authored a merged pull request in this repository. It does NOT establish that later GITHUB_TOKEN pull_request synchronize runs will stop requiring approval. GitHub documents an approval rule for GITHUB_TOKEN-caused pull_request runs that does not mention contributor standing at all, and in every population measured here the actor and the triggering credential are perfectly correlated, so the measurement cannot separate them. A separate experiment adjudicates that.\n\nEXPECT ONE APPROVAL on this pull request's own runs: a pull request created with GITHUB_TOKEN gets its runs in an approval-required state. That approval is predicted by the documented rule and says nothing by itself about standing.\n\nHead pinned by gunbc.ci_bootstrap_pr_open, which closes this pull request if its author, head sha, head ref or base ref do not match."

// THE WET ENTRY. Create, judge what was created, retract if it does not match.
//
// The close on mismatch is not tidiness. The create has already happened by the time any axis can
// be tested, so an entry that merely refused would leave standing exactly the misattributed pull
// request it declined to vouch for -- and the next reader would find an open bot-authored pull
// request with a passing-looking provenance story.
func bootstrap_pr_open_wet() -> ProcessExit {
  let owner = gunbc_repository.owner as String
  let repo = gunbc_repository.name as String
  let base = gunbc_repository.default_branch as String

  let created = github.Pulls.Create(
    auth_token: bootstrap_pr_credential,
    owner: owner,
    repo: repo,
    title: bootstrap_pr_title,
    head: bootstrap_pr_head_branch,
    base: base as NonEmptyStr,
    body: bootstrap_pr_body,
    draft: false,
  )

  match created.outcome {
    RestStatusRefused { status, body } => exit_failure(reason: create_refusal_text(status: status, body: body))
    RestTransportRefused { cause } => exit_failure(reason: concat("BootstrapPullRequestRefused (transport): ", cause as String))
    RestBodyUndecodable { status: _, cause } => exit_failure(reason: concat("BootstrapPullRequestRefused (undecodable): ", cause as String))
    RestOk => {
      let post = check_postconditions(
        observed_author: created.user.login,
        observed_head_sha: created.head.sha as String,
        observed_head_ref: created.head.ref as String,
        observed_base_ref: created.base.ref as String,
        expected_author: bootstrap_pr_expected_author,
        expected_head_sha: bootstrap_pr_expected_head_sha,
        expected_head_ref: bootstrap_pr_head_branch as String,
        expected_base_ref: base as String,
      )
      match post {
        PostconditionsMet => ExitSuccess
        PostconditionMismatch { author_ok: _, head_sha_ok: _, head_ref_ok: _, base_ref_ok: _ } => {
          let closed = github.Pulls.SetState(
            auth_token: bootstrap_pr_credential,
            owner: owner,
            repo: repo,
            pull_number: created.number,
            state: Closed,
          )
          exit_failure(reason: join([
            "BootstrapPullRequestMisattributed: pull request ", to_string(created.number),
            " did not match its postconditions (", postcondition_failed_axes(p: post),
            " ). Close attempted: ", if rest_ok(outcome: closed.outcome) { "closed" } else { "CLOSE FAILED, it is still open" },
            ". A refused launcher must not leave behind the pull request it refuses to vouch for"
          ], ""))
        }
      }
    }
  }
}
