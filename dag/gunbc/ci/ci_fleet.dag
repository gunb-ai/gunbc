// The owned machines' offers are per-host facts; WHICH of them the CI fleet offers is the enrolled CI
// population (gunbc.fleet_enrollment), so a host leaves or joins the offered set by its enrollment and
// never by an edit here. A provider guest has no offer in this catalog: its supply is its provider's
// entitlement, admitted through gunbc.provider_guest_adoption rather than authored as an owned offer.
// MT. COLLINS UNIT 1 AS A DISKLESS EPHEMERAL CI RUNNER HOST, AT ITS MEASURED ONE-SOCKET SHAPE.
// Operator ruling 2026-10-03: the unit is admissible with socket 1 out (bent pins), so the offer
// carries ONE processor. The board is a two-socket Mt. Collins, and offering its spec would admit
// twice the CPU width the machine can run. Every one-socket boot in
// gunbc.machine_intake_mtcollins1_socket1_investigation_observation read sockets 1, cpus 80,
// numa_nodes 1, and the witness checks this offer's thread count against those readings.
//
// THE PART IDENTITY IS A BET, TYPED ON mtcollins1_socket0_cpu_part_standing (DESIGN §4d), not only
// in this comment. The operator reports an Ampere Altra engineering sample in socket 0
// (mtcollins1_socket_cpus); no model number has been read off it. Q80-30 is the corpus's only
// 80-core Altra row, chosen because its thread count equals the measured 80. Width reads that
// count; catalog model number and Hertz are TranscribedUncited until the census reads them.
//
// NO MEMORY DEVICES ARE LISTED. Nominal DIMM capacity is not what placement charges. Usable RAM
// arrives as HostUsableRamMeasured, read by gunbc.host_memory_observation host_usable_ram_from_capture
// from a census boot's meminfo receipt. Slot count is then gunbc.runner_slot_allocation
// committed_width_of over that reading and gunbc.runner_slot_desired, never a hand-kept number.
//
// NOT IN fleet_owned_compute_offer_catalog, and that is a declared frontier, not an omission.
// Enrolment waits on the one-socket census boot's meminfo receipt (usable RAM and fixed overhead
// from that same reader). Until then gunbc_ci_host_usable_ram_for answers HostUsableRamUnmeasured
// and placement refuses UsableRamUnavailable. The offer is still a consumer of the CPU axis:
// compute_host_cpu_admitted_width reads its processors.
data mtcollins1_socket0_cpu_part_standing: CitedFigureStanding = TranscribedUncited {
  read_obligation: "read the Ampere model number and advertised per-thread frequency off socket 0 on a one-socket census boot (lscpu Model name / dmidecode type 4); until that read, binding altra_q8030_catalog (and its Hertz) is a bet matching the measured 80 threads, not a deduced part identity",
}

data mtcollins1_socket0_cpu: CpuFacts = CpuFacts {
  catalog: altra_q8030_catalog,
  deployment: CpuDeploymentFacts { sustained_per_thread_hz: altra_q8030_catalog.nominal_sustained_per_thread_hz },
}

data mtcollins1_runner_host: ComputeHost = ComputeHost {
  identity: operator_host_mtcollins1,
  baseboard: none,
  bmc_intent: none,
  processors: [CpuProcessor { cpu: mtcollins1_socket0_cpu }],
  memory: [],
  storage: [],
  network_interfaces: [],
}

data mtcollins1_offer: ComputeOffer = ComputeOffer {
  provider: "gunbc-operator-mtcollins1",
  supply: ComputeSupplyFacts {
    physical: mtcollins1_runner_host,
    execution: fleet_intent_execution_surface(),
    cost: Present { value: operator_owned_cost() },
    observed_performance: [],
  },
  available_window: AvailabilityWindow { open: "always-open", close: none },
  cost_quote: none,
}

data fleet_owned_compute_offer_catalog: List<ComputeOffer> = [srv1_offer, srv2_offer, srv3_offer, srv4_offer]

data fleet_intent_offers: List<ComputeOffer> = filter(
  fleet_owned_compute_offer_catalog,
  o => any(hosts_enrolled_for(wanted: CiRunnerParticipation), h => (h as String) == (o.supply.physical.identity as String)),
)

fn fleet_compute_offer_for(host: HostIdentity) -> ComputeOffer? {
  fold(fleet_intent_offers, init: none, f: (acc, o) =>
    if o.supply.physical.identity == host {
      Present { value: o }
    } else {
      acc
    }
  )
}

data gunbc_ci_host_identity: HostIdentity = "gunbc-ci-fleet"

data gunbc_ci_cpu: CpuFacts = CpuFacts {
  catalog: altra_q6430_catalog,
  deployment: CpuDeploymentFacts { sustained_per_thread_hz: hertz(3000000000) },
}

data gunbc_ci_linux_surface: OperatingSystemSurface = OperatingSystemSurface {
  kernel: Linux,
  distro_or_product: none,
  version: none,
  filesystem_semantics: Posix,
  process_semantics: PosixProcess,
}

data gunbc_ci_host_memory_deferral_note: String = fleet_host_memory_nominal_vs_usable_note

data gunbc_ci_host_memory_deferral_disposition: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.ci_fleet",
    decl_name: "gunbc_ci_host",
    field: NamedField { field_name: "memory" },
  },
}

data gunbc_ci_host: ComputeHost = ComputeHost {
  identity: gunbc_ci_host_identity,
  baseboard: none,
  processors: [CpuProcessor { cpu: gunbc_ci_cpu }],
  memory: [MemoryDevice { capacity: byte_size(134217728000), memory_kind: Dram, bandwidth: none }],
  storage: [],
  network_interfaces: [],
}

data gunbc_ci_fleet_offer: ComputeOffer = ComputeOffer {
  provider: "gunbc-ci-fleet",
  supply: ComputeSupplyFacts {
    physical: gunbc_ci_host,
    execution: ExecutionSurface {
      os: gunbc_ci_linux_surface,
      isolation: PerJobFilesystem,
      container_engine: none,
      toolchains: [],
      mounted_storage: [],
      network: [],
    },
    cost: Present { value: operator_owned_cost() },
    observed_performance: [],
  },
  available_window: AvailabilityWindow { open: "always-open", close: none },
  cost_quote: none,
}

