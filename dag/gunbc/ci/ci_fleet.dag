// The owned machines' offers are per-host facts; WHICH of them the CI fleet offers is the enrolled CI
// population (gunbc.fleet.fleet_enrollment), so a host leaves or joins the offered set by its enrollment and
// never by an edit here. A provider guest has no offer in this catalog: its supply is its provider's
// entitlement, admitted through gunbc.host.provider_guest_adoption rather than authored as an owned offer.
// MT. COLLINS UNIT 1 AS A DISKLESS EPHEMERAL CI RUNNER HOST, AT ITS MEASURED ONE-SOCKET SHAPE.
// Operator ruling 2026-10-03: the unit is admissible with socket 1 out (bent pins), so the offer
// carries ONE processor. The board is a two-socket Mt. Collins, and offering its spec would admit
// twice the CPU width the machine can run. Every one-socket boot in
// gunbc.machine_intake.mtcollins1_socket1_investigation_observation read sockets 1, cpus 80,
// numa_nodes 1, and the witness checks this offer's thread count against those readings.
//
// THE PART IDENTITY IS READ, NOT DEDUCED: mtcollins1_socket0_cpu_part_standing is observed by the census
// capture's lscpu BIOS model line (dmidecode, run 39010930690) and falls back to a typed bet (DESIGN §4d)
// if that line stops naming the row. The operator reports an Ampere Altra engineering sample in socket 0
// (mtcollins1_socket_cpus). Q80-30 is the corpus's only
// 80-core Altra row, chosen because its thread count equals the measured 80. Width reads that
// count; catalog model number and Hertz are TranscribedUncited until the census reads them.
//
// NO MEMORY DEVICES ARE LISTED. Nominal DIMM capacity is not what placement charges. Usable RAM
// arrives as HostUsableRamMeasured, read by gunbc.host.host_memory_observation host_usable_ram_from_capture
// from a census boot's meminfo receipt, and only from a HostCaptureBound envelope.
//
// IN fleet_owned_compute_offer_catalog: its committed width is derived through fleet_intent_offers like
// any enrolled host's. The CPU axis has a second consumer on this row: compute_host_cpu_admitted_width
// reads its processors.
// The standing is a fold over the census capture, so a capture whose firmware string does not name the
// catalog row's model number falls back to the typed bet rather than keeping a citation it lost. Only the
// MODEL NUMBER is matched; the catalog's sustained Hertz is the vendor brief's figure, which the line's
// "@ 3.0GHz" corroborates but this fold does not parse.
fn mtcollins1_socket0_cpu_part_standing() -> CitedFigureStanding {
  match mtcollins1_census_cpu_bios_model() {
    ObservationEstablished { observed: line } =>
      if cpu_bios_line_names_part(line: line, model_number: altra_q8030_catalog.model_number) {
        ObservedByReceipt {
          observed: observed_receipt(receipt: decl_ref(
            module_path: "gunbc.host.host_memory_observation",
            decl_name: "mtcollins1_census_cpu_bios_model",
          ))
        }
      } else {
        mtcollins1_socket0_cpu_part_bet()
      }
    ObservationRefused { cause: _ } => mtcollins1_socket0_cpu_part_bet()
  }
}

fn cpu_bios_line_names_part(line: String, model_number: String) -> Bool {
  string_contains(s: line, pattern: concat("Processor ", model_number, " "))
}

fn mtcollins1_socket0_cpu_part_bet() -> CitedFigureStanding {
  TranscribedUncited {
    read_obligation: "read the Ampere model number and advertised per-thread frequency off socket 0 on a one-socket census boot (lscpu Model name / dmidecode type 4); until that read, binding altra_q8030_catalog (and its Hertz) is a bet matching the measured 80 threads, not a deduced part identity",
  }
}

data mtcollins1_socket0_cpu: CpuFacts = CpuFacts {
  catalog: altra_q8030_catalog,
  deployment: CpuDeploymentFacts { sustained_per_thread_hz: altra_q8030_catalog.nominal_sustained_per_thread_hz },
}

data mtcollins1_runner_host: ComputeHost = ComputeHost {
  identity: operator_host_mtcollins1,
  baseboard: none,
  bmc_intent: none,
  processors: [CpuProcessor { cpu: mtcollins1_socket0_cpu }],
  memory: [],
  storage: [],
  network_interfaces: [],
}

data mtcollins1_offer: ComputeOffer = ComputeOffer {
  provider: "gunbc-operator-mtcollins1",
  supply: ComputeSupplyFacts {
    physical: mtcollins1_runner_host,
    execution: fleet_intent_execution_surface(),
    cost: Present { value: operator_owned_cost() },
    observed_performance: [],
  },
  available_window: AvailabilityWindow { open: "always-open", close: none },
  cost_quote: none,
}

data fleet_owned_compute_offer_catalog: List<ComputeOffer> = [srv1_offer, srv2_offer, srv3_offer, srv4_offer, mtcollins1_offer]

data fleet_intent_offers: List<ComputeOffer> = filter(
  fleet_owned_compute_offer_catalog,
  o => any(hosts_enrolled_for(wanted: CiRunnerParticipation), h => (h as String) == (o.supply.physical.identity as String)),
)

// THE PARTITION OF THE ENROLLED OFFERS BY HOW THEIR RUNNER PROGRAM IS REALIZED, stated once here so no
// reader branches on OS delivery: a reader that SSH-applies a host takes the converge-applied arm, the
// image build input takes the image-baked arm. fleet_intent_offers stays the union (width, offer lookup
// and registration read the host whichever way it is realized).
fn offer_realization_is(o: ComputeOffer, wanted: ConvergeRealization) -> Bool {
  match enrollment_for_host(host: o.supply.physical.identity) {
    Absent => false
    Present { value: e } => backing_converge_realization(backing: e.backing) == wanted
  }
}

data fleet_converge_applied_offers: List<ComputeOffer> = filter(fleet_intent_offers, o => offer_realization_is(o: o, wanted: ConvergeApplied))

data fleet_image_baked_offers: List<ComputeOffer> = filter(fleet_intent_offers, o => offer_realization_is(o: o, wanted: ImageBaked))

// THE SAME CLASSIFIER ANSWERS "WHY IS THIS ENROLLED HOST ABSENT FROM THE CONVERGE-APPLIED PLAN": it is
// realized by image, not unenrolled. runner_host_deployment_for reads this for its refusal cause.
fn fleet_host_is_image_baked(host: HostIdentity) -> Bool {
  any(fleet_image_baked_offers, o => (o.supply.physical.identity as String) == (host as String))
}

fn fleet_compute_offer_for(host: HostIdentity) -> ComputeOffer? {
  fold(fleet_intent_offers, init: none, f: (acc, o) =>
    if o.supply.physical.identity == host {
      Present { value: o }
    } else {
      acc
    }
  )
}

data gunbc_ci_host_identity: HostIdentity = "gunbc-ci-fleet"

data gunbc_ci_cpu: CpuFacts = CpuFacts {
  catalog: altra_q6430_catalog,
  deployment: CpuDeploymentFacts { sustained_per_thread_hz: hertz(3000000000) },
}

data gunbc_ci_linux_surface: OperatingSystemSurface = OperatingSystemSurface {
  kernel: Linux,
  distro_or_product: none,
  version: none,
  filesystem_semantics: Posix,
  process_semantics: PosixProcess,
}

data gunbc_ci_host_memory_deferral_note: String = fleet_host_memory_nominal_vs_usable_note

data gunbc_ci_host_memory_deferral_disposition: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.ci.ci_fleet",
    decl_name: "gunbc_ci_host",
    field: NamedField { field_name: "memory" },
  },
}

data gunbc_ci_host: ComputeHost = ComputeHost {
  identity: gunbc_ci_host_identity,
  baseboard: none,
  processors: [CpuProcessor { cpu: gunbc_ci_cpu }],
  memory: [MemoryDevice { capacity: byte_size(134217728000), memory_kind: Dram, bandwidth: none }],
  storage: [],
  network_interfaces: [],
}

data gunbc_ci_fleet_offer: ComputeOffer = ComputeOffer {
  provider: "gunbc-ci-fleet",
  supply: ComputeSupplyFacts {
    physical: gunbc_ci_host,
    execution: ExecutionSurface {
      os: gunbc_ci_linux_surface,
      isolation: PerJobFilesystem,
      container_engine: none,
      toolchains: [],
      mounted_storage: [],
      network: [],
    },
    cost: Present { value: operator_owned_cost() },
    observed_performance: [],
  },
  available_window: AvailabilityWindow { open: "always-open", close: none },
  cost_quote: none,
}

