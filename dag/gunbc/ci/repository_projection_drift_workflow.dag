// repository_projection_drift_workflow.dag — THE ONE drift-check emitter, used by a mirror repository's
// profile. The check is the same question in every repository: is every committed generated artifact
// byte-equal to what its authority emits right now? For a mirror that question has a second half, and it
// is the reason this file exists: the authority is a SEED checked out beside the repository, so the check
// composes the overlay and runs the project's own check target. A repository without a seed gets the same
// steps with the compose folded away.
//
// WHY THIS AND gunbc/drift_watch_workflow.dag ARE SEPARATE FILES, ONE SHAPE. gunbc's drift watch is a
// POLLER: it runs on a cadence, compares committed bytes to emission, and reports — it exists to catch
// what no commit touched. A mirror's drift job runs at every checkout, and additionally SEALS a repair
// candidate at a pull request so the publisher can push the regenerated bytes. The seal and the upload
// are the load-bearing half (an unsealed candidate is not publishable), and they are what a fork was
// writing by hand here. The cadence difference is data (`ProjectionDrift.cron`), and the check target is
// data (`ProjectionDrift.check`); the steps are here.
//
// THE SEAL RUNS AT THE PULL REQUEST HEAD, NOT AT THE MERGE. The publisher pushes to the pull request
// branch, so a candidate generated from anything else is a candidate for a commit nobody submitted.

data projection_drift_no_job_refusal_reason: String = "REFUSED gunbc.ci.repository_projection_drift_workflow: this repository's CI profile declares no drift check (RepositoryCiProfile.drift is Absent), so there is nothing to emit. Declare the job or delete its workflow file."

data projection_drift_no_seed_refusal_reason: String = "REFUSED gunbc.ci.repository_projection_drift_workflow: a drift check that regenerates from a sealed seed needs that seed (RepositoryCiProfile.public_seed is Absent). Emission without the seed it claims to check against is a check that always passes."

data projection_drift_no_overlay_refusal_reason: String = "REFUSED gunbc.ci.repository_projection_drift_workflow: the mirror's drift check and seal run from the composed overlay, so the profile must declare it (RepositoryCiProfile.roster.route.Overlay.composition). Without the row the emitted job could not name the copy it reads, and the copy is exactly the step that must be visible in the YAML."

fn projection_drift_refusal(profile: RepositoryCiProfile) -> Optional<String> {
  if repository_declares_drift_job(profile: profile) == false {
    Present { value: projection_drift_no_job_refusal_reason }
  } else if profile.public_seed == no_seed() {
    Present { value: projection_drift_no_seed_refusal_reason }
  } else if profile_overlay(profile: profile) == no_overlay() {
    Present { value: projection_drift_no_overlay_refusal_reason }
  } else {
    Absent
  }
}

data no_seed() -> Optional<PublicSeed> {
  Absent
}

data no_overlay() -> Optional<OverlayIngest> {
  Absent
}

// THE PROGRAM: what the repository's own voice says at each step. The step NAMES and banners are
// repository voice, the invocation and the artifact are rows.
type DriftProgram {
  checkout_step_name: NonEmptyStr
  seed_checkout_step_name: NonEmptyStr
  record_step_name: NonEmptyStr
  toolchain_step_name: NonEmptyStr
  build_step_name: NonEmptyStr
  check_step_name: NonEmptyStr
  check_authority_banner: NonEmptyStr
}

fn mirror_program() -> DriftProgram {
  DriftProgram {
    checkout_step_name: "Checkout private",
    seed_checkout_step_name: "Checkout public gunbc",
    record_step_name: "Record the public revision the claims were checked against",
    toolchain_step_name: "Install Rust toolchain",
    build_step_name: "Build gunbc from the public seed",
    check_step_name: "Check every committed projection against its authority",
    check_authority_banner: "projection-drift: every committed projection must equal its authority"
  }
}

fn memory_budget_env(profile: RepositoryCiProfile) -> List<(String, String)> {
  match profile.roster.memory_budget_bytes {
    Present { value: budget } => [("GUNBC_MEMORY_BUDGET_BYTES", budget as String)]
    Absent => []
  }
}

// THE CHECK SCRIPT: compose from the checked-out tree, then run the project's own check target from the
// composition. The banner is the first line so a failing run says what it was checking before it says
// anything else.
fn drift_check_script(profile: RepositoryCiProfile, seed: PublicSeed, overlay: OverlayIngest, program: DriftProgram, check: DagInvocation) -> String {
  let roots = composed_source_roots(
    profile_roots: profile.roster.source_roots,
    overlay: overlay
  ) in
    trim(join([
      "set -u",
      compose_preamble(
        seed: seed,
        c: ComposeSpec {
          shell_options: "set -u",
          compose: "COMPOSE=\\\"${RUNNER_TEMP:-" + overlay.compose_root_env_default as String + "}/" + overlay.compose_dir_name as String + "\\\"",
          before_compose: [],
          overlay_source: "\"$PRIVATE_ROOT/dag\"",
          overlay_dir_name: overlay.overlay_dir_name,
          links: [ComposeLink { name: overlay.repo_link_name, target: "\"$PRIVATE_ROOT\"" }],
          notes: [
            overlay_note_line(overlay: overlay),
            local_runs_note(overlay: overlay)
          ]
        }
      ),
      "",
      compose_gunbc_run(overlay: overlay, roots: roots, invocation: check),
      "echo \"" + program.check_authority_banner as String + "\"",
      "exit 0"
    ], "\n"))
}

fn local_runs_note(overlay: OverlayIngest) -> String {
  "LOCAL RUNS: Do NOT create " + overlay.overlay_dir_name as String + " inside the session worktree - archive-time auto-push commits untracked files and leaks the private repo. Use: git worktree add --detach /tmp/claude-1000/SESSION-compose HEAD, put " + overlay.overlay_dir_name as String + "/dag inside that, run gunbc there. A plain /tmp directory is refused because gunbc needs a git checkout, and cp -al across /tmp fails as a cross-device link."
}

// THE SEAL SCRIPT: compose at the pull request HEAD and run the project's regenerate-and-seal target.
// The unset lines are the same discipline as the check: a composition must not inherit a cache from a
// previous tree, or a candidate can be assembled out of bytes that are not in the commit being sealed.
fn heal_seal_script(
  seed: PublicSeed,
  overlay: OverlayIngest,
  seal: HealSeal
) -> String {
  let roots = composed_source_roots(
    profile_roots: profile_roster_roots(),
    overlay: overlay
  ) in
    trim(join(head_tree_compose(
      seed: seed,
      overlay: overlay,
      head_tree_dir_name: seal.head_tree_dir_name,
      head_link_name: seal.head_link_name
    ) ++ [
      "",
      compose_gunbc_run(overlay: overlay, roots: roots, invocation: seal.invocation)
    ], "\n"))
}

// The roots the seal composes are the roots the roster gate declares: one row, read twice, because the
// candidate must be produced by the same set of source trees the gate checks.
fn profile_roster_roots() -> List<String> {
  map(gunbc_roster_gate().source_roots, fn(r) { r as String })
}

fn projection_drift_steps(
  profile: RepositoryCiProfile,
  seed: PublicSeed,
  overlay: OverlayIngest,
  program: DriftProgram
) -> List<Step> {
  let drift = match profile.drift {
    Present { value: d } => d
    Absent => repository_without_drift_job()
  } in
    let budget = memory_budget_env(profile: profile) in
      let check_step = Step {
        name: StepName { value: drift.job_display_name as String == "" ? program.check_step_name as String : program.check_step_name as String },
        run: drift_check_script(
          profile: profile,
          seed: seed,
          overlay: overlay,
          program: program,
          check: drift.check
        ),
        uses: Absent,
        with: [],
        env: Env { bindings: budget },
        condition: Absent,
        working_directory: Absent,
        id: Absent
      } in
        let seal_steps = match drift.seal {
          Present { value: seal } => [
            Step {
              name: StepName { value: seal.seal_step_name as String },
              run: heal_seal_script(seed: seed, overlay: overlay, seal: seal),
              uses: Absent,
              with: [],
              env: Env { bindings: budget ++ heal_seal_env() },
              condition: Present { value: Condition { value: only_at_a_pull_request() } },
              working_directory: Absent,
              id: Present { value: StepId { value: seal.seal_step_id } }
            },
            Step {
              name: StepName { value: seal.upload_step_name as String },
              run: Absent,
              uses: Present { value: Uses { value: Artifact.upload.value } },
              with: [
                ("name", seal.candidate_artifact as String),
                ("path", "${{ runner.temp }}/" + seal.compose_dir_name as String + "/target/" + seal.candidate_artifact as String + "/"),
                ("if-no-files-found", "error")
              ],
              env: Env { bindings: [] },
              condition: Present { value: Condition { value: seal_ran_and_repo_alive() } },
              working_directory: Absent,
              id: Absent
            }
          ]
          Absent => []
        } in
          [
            checkout_repository_step(program: program),
            checkout_seed_step(program: program, seed: seed),
            record_seed_revision_step(program: program, seed: seed),
            toolchain_step(program: program),
            build_seed_step(seed: seed)
          ] ++ [check_step] ++ seal_steps
}

fn projection_drift_job(
  profile: RepositoryCiProfile,
  seed: PublicSeed,
  overlay: OverlayIngest,
  program: DriftProgram
) -> Job {
  let drift = match profile.drift {
    Present { value: d } => d
    Absent => repository_without_drift_job()
  } in
    Job {
      runs_on: ci_runner_target_spec(target: drift.runner),
      timeout_minutes: drift.timeout_minutes,
      needs: [],
      steps: projection_drift_steps(
        profile: profile,
        seed: seed,
        overlay: overlay,
        program: program
      )
    }
}

// THE TRIGGERS. A mirror's drift job runs at every checkout of a mirror commit — the moment the seed
// could have moved — plus workflow_dispatch for a human. The cadence, when the row declares one, is
// added on top: a poller's cadence is a second reason to run the same check, not a different check.
fn projection_drift_triggers(profile: RepositoryCiProfile) -> List<Trigger> {
  let drift = match profile.drift {
    Present { value: d } => d
    Absent => repository_without_drift_job()
  } in
    let branch = profile.default_branch as String in
      let cadence = match drift.cron {
        Present { value: schedule } => [schedule_trigger(schedule: schedule)]
        Absent => []
      } in
        cadence ++ [
          WorkflowDispatch,
          Push { branches: [branch] },
          PullRequest { branches: [branch], types: ["opened", "synchronize", "reopened", "ready_for_review"] }
        ]
}

fn schedule_trigger(schedule: CronSchedule) -> Trigger {
  Schedule { cron: cron_text(schedule: schedule) }
}

fn cron_text(schedule: CronSchedule) -> String {
  let minute = field_text(schedule.minute) in
    let hour = field_text(schedule.hour) in
      let dom = field_text(schedule.day_of_month) in
        let month = field_text(schedule.month) in
          let dow = field_text(schedule.day_of_week) in
            minute + " " + hour + " " + dom + " " + month + " " + dow
}

fn field_text(field: extdeps.cron.schedule_model.CronField) -> String {
  match field {
    Wildcard => "*"
    Exact { value: v } => v as String
    Listed { values: vs } => join(map(vs, fn(v) { v as String }), ",")
  }
}

fn projection_drift_workflow(
  profile: RepositoryCiProfile,
  seed: PublicSeed,
  overlay: OverlayIngest,
  program: DriftProgram
) -> Workflow {
  let drift = match profile.drift {
    Present { value: d } => d
    Absent => repository_without_drift_job()
  } in
    Workflow {
      name: WorkflowName { value: drift.workflow_name as String },
      on: WorkflowEvents { triggers: projection_drift_triggers(profile: profile) },
      permissions: Permissions {
        scopes: [
          (extdeps.github_workflows.model.RepositoryPermission.contents, "read"),
          (extdeps.github_workflows.model.RepositoryPermission.actions, "none")
        ]
      },
      concurrency: Absent,
      env: Env { bindings: [] },
      jobs: Jobs { entries: [(drift.job_id, projection_drift_job(profile: profile, seed: seed, overlay: overlay, program: program))] }
    }
}

fn expected_projection_drift_workflow_yml(
  profile: RepositoryCiProfile,
  seed: PublicSeed,
  overlay: OverlayIngest,
  program: DriftProgram
) -> String {
  emit(
    workflow: projection_drift_workflow(
      profile: profile,
      seed: seed,
      overlay: overlay,
      program: program
    )
  )
}
