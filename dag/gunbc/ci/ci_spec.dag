// THE D0 DOOR'S PRELUDE materializes the submission MAC key alone (the door signs one filing; it
// holds no BMC credential and no capability key): the shared auth header and SM decode, one
// pinned secret version to a 0600 file under RUNNER_TEMP, the trap armed before it touches disk.
// THE KEY IS FIRST-RUN-ONLY, SO ITS ABSENCE DOES NOT STOP THE DOOR: a lifecycle that already holds
// its durable claim resumes under the recorded decision and signs nothing, and the recovery #11555
// made total must not narrow to "recoverable while Secret Manager answers". A fetch that fails
// leaves the key path env unset and the door decides -- a run that must file refuses there with a
// typed cause (gunbc.auth.approval_gate approval_file_stored_request), a resume proceeds. The
// transport is the one shared fetch (gunbc_ci_sm_secret_to_dest_file_command), bounded inside the
// prelude allowance.

// THE MICROVM RUNNER GROUP ENSURE: the org-admin installation token the org-actions step mints,
// then the approval submission MAC key the approval-gated modes fetch. The mint's own cleanup is
// kept and EXTENDED rather than replaced -- a second bare `trap ... EXIT` would drop the mint's
// cleanup and leave the App key's decoded file in RUNNER_TEMP for the rest of the step.
fn gunbc_ci_microvm_runner_group_ensure_prelude() -> List<PipelineStep> {
  gunbc_ci_org_admin_app_token_prelude().concat([
    Do { run: ci_retry_body_run(command: "HDR_FILE=\"$RUNNER_TEMP/microvm-runner-group-auth-header\"") },
    Do { run: ci_retry_body_run(command: "RESP_FILE=\"$RUNNER_TEMP/microvm-runner-group-sm.json\"") },
    Do { run: ci_retry_body_run(command: "SUB_FILE=\"$RUNNER_TEMP/approval-submission-mac-key\"") },
    Do { run: ci_retry_body_run(command: "trap 'cleanup; rm -f \"$HDR_FILE\" \"$RESP_FILE\" \"$SUB_FILE\"' EXIT") },
    Do { run: ci_retry_body_run(command: gunbc_ci_auth_header_file_write_command()) },
    Do { run: ci_retry_body_run(command: join([
      "DEST_FILE=\"$SUB_FILE\"; ", gunbc_ci_sm_secret_to_dest_file_command(url: approval_submission_mac_access_url()),
      " || { echo 'ApprovalSubmissionMacKeyNotMaterialized: the pinned submission MAC key version could not be fetched and decoded; no request can be filed' >&2; exit 1; }",
    ], "")) },
    Do { run: ci_retry_body_run(command: "chmod 600 \"$SUB_FILE\"") },
    Do { run: ci_retry_body_run(command: "rm -f \"$HDR_FILE\" \"$RESP_FILE\"") },
    Do { run: ci_retry_body_run(command: concat("export ", concat(approval_submission_mac_key_path_env as String, "=\"$SUB_FILE\""))) },
    Do { run: ci_retry_body_run(command: "mkdir -p \"$GITHUB_WORKSPACE/artifacts\"") },
  ])
}

data gunbc_ci_microvm_runner_group_ensure_shell_emit_scaffold: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.ci.ci_spec",
    decl_name: "gunbc_ci_microvm_runner_group_ensure_invoke",
    field: WholeDeclaration
  }
}

data gunbc_ci_microvm_runner_group_ensure_shell_emit_dissolution_trigger: DissolutionCondition = unbound_dissolution(description: "🟡 dissolve-on: gunbc_ci_microvm_runner_group_ensure_invoke - orch-emitted foreign-executor (GitHub Actions run:) credential runner: the org-admin installation token prelude (gunbc_ci_org_admin_app_token_prelude) followed by ONE pinned submission-MAC secret version fetched over curl through the shared auth header and SM decode, a 0600 file under RUNNER_TEMP with the mint's cleanup extended in the EXIT trap. The pipeline steps are modeled (gunbc_ci_microvm_runner_group_ensure_prelude) but the runner transport itself remains hand-shell; DISSOLVES WHEN the runner is authored as v2.extdeps.languages.bash_build nodes (typed, grammar-quoted words; command substitution; assignment; pipe; if/test; redirect; || true) emitted by v2.workflow.bash_emit bash_emit_stmts -- a route AVAILABLE today (#12422 retired the sibling pack runner on it), so this migration is unauthored, not blocked on a missing capability; set -euo pipefail, umask, export and trap are ordinary commands on that route, and the trap body is itself built from nodes and passed as one grammar-quoted word, so no new orchestration intent is a prerequisite")

fn gunbc_ci_microvm_runner_group_ensure_invoke() -> String {
  concat(
    concat("# ", concat(dissolution_description(condition: gunbc_ci_microvm_runner_group_ensure_shell_emit_dissolution_trigger), "\n")),
    gunbc_run_step_script_with_prelude(
      prelude: gunbc_ci_microvm_runner_group_ensure_prelude(),
      source_roots: witness_layer_roots,
      entry: gunbc_ci_microvm_runner_group_ensure_target.entry,
      function: gunbc_ci_microvm_runner_group_ensure_target.function,
      claim_run: false,
      receipt_rel: none
    )
  )
}

// THE PUBLISH PRELUDE FOR A REPOSITORY WHOSE PUBLISHER DOES NOT RUN FROM THIS CHECKOUT. gunbc-private's
// publisher composes the public corpus with its own overlay and invokes gunbc there, so it cannot use
// the ROOT-stamped step below; it takes the same cgroup and the same mint, down-scoped to ITS
// repository by its own federation record, as one rendered fragment ahead of its own invocation.
fn heal_publisher_publish_prelude_script(f: HealPublisherFederation) -> String {
  concat(
    gunbc_invoke_step_emit_pipeline(p: Pipeline {
      steps: concat(
        heal_publisher_cgroup_prelude(),
        github_app_installation_token_prelude(
          spec: heal_publisher_token_mint(app: gunbai_bot_declared, installation: gunbai_bot_declared_installation_id, f: f)
        )
      ),
      on_failure: FailFast
    }),
    "\n"
  )
}

