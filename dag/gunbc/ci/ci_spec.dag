}

// THE DISPATCH-INPUT FAIL-FAST. The four inputs the dashboard transaction will later refuse on
// (empty hash, malformed revision, malformed pointers) are refused HERE, in seconds, instead of
// after the pair build and the ten-minute fold resolve that paid them in runs 39177393512 and
// 36719161144. It asserts no truth the fold does not also assert; it only moves the same refusal
// earlier, where it is cheap.
data gunbc_ci_admit_dashboard_deploy_inputs_target: GunbcRunStepTarget = GunbcRunStepTarget {
  entry: "dag/gunbc/fleet/fleet_converge_plan_revision.dag",
  function: "admit_dashboard_deploy_dispatch_inputs",
}

// THE JOB-SIDE EXACTLY-ONE-RECEIPT ASSERTION (gunbc.live_deploy.apply_receipt): the rule -- exactly one
// decodable document, apply XOR refusal, zero never (named), the receipt/conclusion pairing -- lives in
// the receipt module with the documents it counts, not in shell in the workflow (gunbc.design_argument::how_to_work).
data gunbc_ci_assert_dashboard_deploy_receipts_target: GunbcRunStepTarget = GunbcRunStepTarget {
  entry: "dag/gunbc/live_deploy/apply_receipt.dag",
  function: "assert_dashboard_deploy_receipts",
}

