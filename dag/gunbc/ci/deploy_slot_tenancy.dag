module gunbc.ci.deploy_slot_tenancy

import std.types { Bool, List, NonEmptyStr, String }
import std.optional { Absent, Present }
import extdeps.github.actions_jit_runner { JitRunnerGroupId }
import gunbc.repository { gunbc_repository }
import gunbc.generated_artifact { artifact_path, FleetConvergeYamlArtifact }
import gunbc.runner.runner_group_restriction_observation {
  MicrovmRunnerGroupStanding, RunnerGroupRestrictedToWorkflow, RunnerGroupRestrictionRefused,
}
import gunbc.ci.deploy_route_requirement { DeployRouteJobTenancy, SharesJobUidWithPullRequestJobs, SoleTenantOfJobUid }

// ── THE SLOT THAT TAKES ONLY MAIN-PINNED DEPLOY DISPATCHES ──────────────────────────────────────
// gunbc.ci.deploy_route_requirement requires the host-root effects of a deploy to run where no pull
// request job shares the job uid. Two walls make a slot such a tenant, and neither alone does:
//   * ADMISSION: a runner group restricted to exactly one workflow at the default branch
//     (gunbc.runner.runner_group_restriction_observation RestrictedRunnerGroup, minted only by
//     reading the org's groups back). A label alone does not admit or refuse: selection is set
//     membership (runner_labels_satisfy_selector), so any workflow may name any label; the group is
//     what refuses a pull request workflow.
//   * ISOLATION: a job uid no pull request slot runs as. The group controls what is scheduled onto
//     the slot, not whether a same-uid job in ANOTHER slot reaches this slot's in-run ssh-agent or
//     the _work/_temp/fleet-ssh-mux socket, so admission without a distinct uid leaves the arm open.
// gunbc.plans.srv1_deploy_principal_split, D3 precondition.

// The runner group and the runner label are one string (as private_heal_publisher_runner_group_name
// is): the label the deploy job selects is the group that restricts who may use it.
data deploy_slot_runner_group_name: NonEmptyStr = "gunbc-deploy"

// The job uid of the deploy slot, distinct from srv1's pull request job uid. Its grants are the
// narrow per-unit set only; the administrator edge, not this account, holds host-root reach.
data deploy_slot_job_user: NonEmptyStr = "ghdeploy"

fn deploy_slot_selected_workflow() -> NonEmptyStr {
  join([
    gunbc_repository.full_name as String, "/",
    artifact_path(a: FleetConvergeYamlArtifact),
    "@refs/heads/", gunbc_repository.default_branch as String,
  ], "") as NonEmptyStr
}

// THE GROUP'S ID, AS THE ENSURE RUN THAT CREATED IT READ IT BACK. GitHub assigns the id at creation,
// so the repository cannot author it; it reaches the slot's registration only through this receipt of
// gunbc.runner.runner_group_restriction_ensure_run (its `microvm-runner-group=created` line, uploaded
// as the run's microvm-runner-group-ensure-receipts artifact), committed as a row because the slot's
// drop-in is rendered before any job runs. The row records an observation; it admits nothing. The
// deploy route's admission stays deploy_slot_observed_tenancy over a live read.
//
// THE ID IS TRANSCRIBED, AND THIS IS THE BOUNDARY THAT ADMITS IT. The guard below catches a receipt for
// another group name or another workflow, but not the group being deleted and recreated under the same
// name with a new id. A slot rendered from this row would then register with the old id. The expected
// answer is that the JIT registration is refused for a group that no longer exists, so the slot fails to
// register visibly; that is inferred from the API taking a group id, not yet observed. What retires this row is a live read of the slot's group from the
// org's runner groups (the DeploySlotReading readback, which replaces srv1_modeled_deploy_slot_reading),
// once that read can be done at render time.
type RunnerGroupEnsureReceipt {
  run_id: NonEmptyStr
  observed_at: NonEmptyStr
  name: NonEmptyStr
  group: JitRunnerGroupId
  selected_workflow: NonEmptyStr
}

data deploy_slot_runner_group_ensure_receipt: RunnerGroupEnsureReceipt = RunnerGroupEnsureReceipt {
  run_id: "40812313878",
  observed_at: "2026-10-29",
  name: "gunbc-deploy",
  group: JitRunnerGroupId { value: 10 },
  selected_workflow: "gunb-ai/gunbc/.github/workflows/fleet-converge.yml@refs/heads/main",
}

// The id only when the receipt is for THIS group restricted to THIS workflow: a rename of the group
// or of the workflow makes the row a receipt for something else, and it refuses rather than
// registering the slot into a group nobody re-read.
fn deploy_slot_runner_group_id(receipt: RunnerGroupEnsureReceipt) -> JitRunnerGroupId? {
  if (receipt.name as String) == (deploy_slot_runner_group_name as String)
    && (receipt.selected_workflow as String) == (deploy_slot_selected_workflow() as String) {
    Present { value: receipt.group }
  } else {
    Absent
  }
}

// What a read of the deploy slot holds: the group's standing as the sealed observer reports it, the
// uid the deploy slot's jobs run as, and the uid of every other slot on the host.
type DeploySlotReading {
  group: MicrovmRunnerGroupStanding
  deploy_slot_job_user: NonEmptyStr
  other_slot_job_users: List<NonEmptyStr>
}

// SOLE TENANT ONLY WHEN BOTH WALLS HOLD. Anything the observer refused, or a uid shared with another
// slot, reads as shared: absence of the group is not irrelevance.
fn deploy_slot_observed_tenancy(reading: DeploySlotReading) -> DeployRouteJobTenancy {
  match reading.group {
    RunnerGroupRestrictionRefused { name: _, cause: _ } => SharesJobUidWithPullRequestJobs
    RunnerGroupRestrictedToWorkflow { restriction: _ } =>
      if count(filter(reading.other_slot_job_users, u => (u as String) == (reading.deploy_slot_job_user as String))) == 0 {
        SoleTenantOfJobUid
      } else {
        SharesJobUidWithPullRequestJobs
      }
  }
}
