module gunbc.ci.repository_seed_steps

import std.types { Bool, List, String, NonEmptyStr }
import std.optional { Optional, Present, Absent }
import extdeps.languages.yaml.types { yaml_string, yaml_bool, kv, YamlKeyValue }
import extdeps.github.actions {
  Job, RunnerSpec, RunStep, Step, UsesStep, WorkflowPermissions, PermRead,
}
import extdeps.github.expressions { ContextAccess, Expression, Needs, Steps, interpolate }
import gunbc.action_use_admission {
  checkout_action, setup_rust_action, checkout_ref_entry, commit_output_producer_path,
  seed_pin_verifier_producer, seed_pin_verifier_job_id, seed_pin_verifier_output_name,
  seed_pin_verifier_check_step_id,
}
import gunbc.ci.repository_ci_profile { PublicSeed, seed_source_pin, seed_source_refusal_reason }
import gunbc.ci.repository_compose_overlay { command, command_words, word, var_word, path_under, set_strict_stmt }
import gunbc.toolchain_workflow_steps { toolchain_home_isolation_step, toolchain_pin_rustup_default_step }
import v2.std.diagnostic {
  Outcome, Accepted, Rejected, bind_outcome, outcome_accepted, outcome_rejected, module_unavailable_diagnostic,
}
import v2.std.node { Node }
import v2.extdeps.languages.bash_build {
  bash_build_assign, bash_build_word_cmdsubst, bash_build_word_concat_from_nodes, bash_build_test_bracket,
  bash_build_pipe, bash_build_or_else, bash_build_subshell_from_stmts, bash_build_with_redir_to_file, bash_build_exit,
}
import v2.workflow.bash_emit { bash_emit_stmts }

// THE FIVE STEPS EVERY CI JOB IN A MIRROR REPOSITORY HAS, written once. A repository that runs its
// claims under a compiler checked out beside it must: take its own tree, take the seed, say WHICH seed
// revision it judged, install a toolchain, and build the compiler from the seed's source. Both forked
// repositories wrote these five by hand, in two dialects, and the only difference between the two
// versions was the text of the step names -- which is what the caller passes in.
//
// WHY THE NAMES COME IN AS ARGUMENTS AND NOT AS ROWS. A step name is the voice of the job that runs
// the step ("Build gunbc from the public seed" is an explanation, not an identity), and the same job
// body is written by one emitter. Putting them on the profile row would let a repository rename a
// step without touching the emitter that owns what the step DOES, which is the half a row should not
// hold. The seed row DOES carry two of them -- the record and build names -- because those steps
// describe the seed itself, and the seed is data.

// THE REPOSITORY'S OWN TREE. No ref, no `with` at all: a job runs from the commit that triggered it,
// and a checkout that took a ref would let a workflow decide which of its own definitions ran.
fn repository_checkout_step(step_name: NonEmptyStr) -> Step {
  UsesStep {
    name: Present { value: step_name },
    id: none,
    uses: checkout_action,
    with: none,
    env: none,
    if_condition: none,
    continue_on_error: none,
    timeout_minutes: none
  }
}

// THE SEED, CHECKED OUT BESIDE THE REPOSITORY UNDER CI. `ref` is a row rather than "whatever the runner
// happens to have", because the claims are judged by that compiler and an unpinned checkout makes the
// verdict unattributable.
fn seed_checkout_step(seed: PublicSeed) -> Outcome<Step> {
  match seed_pin_checkout_ref_entry(seed: seed) {
    // NO FALLBACK EXISTS ON THIS PATH. Not a branch, not a branch tip, not the event sha, not an empty
    // ref (GitHub reads an empty ref as the default branch, which is the same hazard wearing a hat). The
    // consumer turns this into a refusal of the whole workflow, and the text names the missing fact.
    Absent {  } =>
      outcome_rejected(
        d: module_unavailable_diagnostic(
          reason: seed_source_refusal_reason(source: seed.source),
          module_file: "gunbc.ci.repository_seed_steps"
        )
      )
    Present { value: ref_entry } =>
      outcome_accepted(
        value: UsesStep {
          name: Present { value: join(["Checkout ", seed.repository as String], "") },
          id: none,
          uses: checkout_action,
          with: Present {
            value: [
              kv(key: "repository", value: yaml_string(s: seed.repository as String)),
              ref_entry,
              kv(key: "path", value: yaml_string(s: seed.checkout_path as String))
            ]
          },
          env: none,
          if_condition: none,
          continue_on_error: none,
          timeout_minutes: none
        }
      )
  }
}

// A RUN STEP FROM TYPED STATEMENTS. Every run body in this module is a tree of
// v2.extdeps.languages.bash_build nodes folded by v2.workflow.bash_emit::bash_emit_stmts, so the shape of
// a step is a model rather than a string that happens to be shell. The fold's Refused is carried up as the
// emitter's own refusal, which is why these builders return Outcome.
/// Emit a `run:` step whose body is the fold of `statements` through the typed shell grammar, run in the
/// working directory the row names. THE FOLD LIVES HERE AND ONLY HERE: a caller that names no directory
/// passes Absent, and a step that must run in a tree checked out beside the repository passes that path -
/// either way the script is the model's, never a string pasted out of a row.
fn emit_run_step(
  name: NonEmptyStr,
  statements: List<Node>,
  set_e: Bool,
  env: Optional<List<YamlKeyValue>>,
  if_condition: Optional<String>,
  working_directory: Optional<String>
) -> Outcome<Step> {
  bind_outcome(
    o: bash_emit_stmts(statements: statements, set_e: set_e),
    f: fn(script) {
      Accepted {
        value: RunStep {
          name: Present { value: name },
          id: none,
          run: script,
          shell: none,
          env: env,
          working_directory: working_directory,
          if_condition: if_condition,
          continue_on_error: none,
          timeout_minutes: none
        },
        diagnostics: None
      }
    }
  )
}

// WHICH SEED REVISION WAS JUDGED, printed by the step that judged it. Without this, a green gate is a
// claim about an unnamed compiler, and the first thing an operator does after a regression is guess.
// `git -C <path>` rather than a `cd`: the step must not carry a working directory that the next statement
// silently inherits, and the receipt must be about the seed's checkout even when the job's cwd is elsewhere.
fn record_seed_revision_step(seed: PublicSeed) -> Outcome<Step> {
  emit_run_step(
    name: seed.record_step_name,
    statements: [
      command_words(rest: ["set", "-u"]),
      command_words(rest: ["git", "-C", seed.checkout_path as String, "rev-parse", "HEAD"]),
      command_words(rest: ["git", "-C", seed.checkout_path as String, "log", "-1", "--format='%H %s'"]),
    ],
    set_e: false,
    env: none,
    if_condition: none,
    working_directory: none
  )
}

// THE TOOLCHAIN LANE, ONE ORDER FOR EVERY SEED LANE IN EVERY MIRROR. The install is the upstream setup
// action with its own cache OFF -- the cache key would be the host's, and a job that restores a toolchain
// from a previous job's image is a job whose behaviour depends on which runner it landed on -- and it is
// emitted ONLY between the two steps that make it lawful on a runner whose home outlives the job:
// `toolchain_home_isolation_step()` ahead of it, wiping and rebinding HOME/CARGO_HOME/RUSTUP_HOME under
// RUNNER_TEMP, and `toolchain_pin_rustup_default_step()` behind it, because an isolated RUSTUP_HOME starts
// with no default toolchain for a build to resolve.
//
// WHY THE THREE TRAVEL TOGETHER RATHER THAN BEING COMPOSED BY EACH ROUTE. gunbc.toolchain_home_standing
// classifies a hosted runner's home as private by construction of the runner and a self-hosted one as
// shared with every other slot on the host, which is what made a shared-home install an outage rather
// than a nuisance. A route that took the install on its own was therefore emittable for one kind of
// runner and quietly wrong for the other: gunbc's own lanes run hosted or already compose the pair, so
// the gap showed only when a mirror put its publisher in a declared self-hosted fleet group and the
// standing check refused the emission. The fix is not to teach each route the pair -- the next route
// would forget it again -- but to make the install unavailable except between them. There is no bare
// install builder in this corpus any more; a route that wants a toolchain takes the lane.
type SeedToolchainLane {
  isolation: Step,
  install: Step,
  pin_default: Step,
}

fn seed_toolchain_lane(step_name: NonEmptyStr) -> SeedToolchainLane {
  SeedToolchainLane {
    isolation: toolchain_home_isolation_step(),
    install: UsesStep {
      name: Present { value: step_name },
      id: none,
      uses: setup_rust_action,
      with: Present { value: [kv(key: "cache", value: yaml_bool(b: false))] },
      env: none,
      if_condition: none,
      continue_on_error: none,
      timeout_minutes: none
    },
    pin_default: toolchain_pin_rustup_default_step(),
  }
}

// THE ORDER, IN ONE PLACE. A caller that read the three fields apart could put the pin before the install
// -- an isolated RUSTUP_HOME with no default resolved, then a build against a toolchain nothing selected
// -- and still claim to have composed the pair. Every lane takes this list, so the order has one owner.
fn seed_toolchain_lane_steps(lane: SeedToolchainLane) -> List<Step> {
  [lane.isolation, lane.install, lane.pin_default]
}

// THE COMPILER IS BUILT FROM SOURCE IN THE SEED CHECKOUT rather than downloaded: the claims are about
// this revision of the compiler's own language, and a released binary would be testing the language the
// mirror's rows were written against rather than the one on main.
fn seed_build_step(seed: PublicSeed) -> Outcome<Step> {
  // THE BUILD IS THE ROW'S MODELLED COMMAND, folded through the same typed grammar as every other step in
  // the lane. A row that carried a shell string here could put arbitrary script into a committed workflow
  // without going through the grammar at all.
  return emit_run_step(
    name: seed.build_step_name,
    statements: seed.build_command,
    set_e: true,
    env: none,
    if_condition: none,
    working_directory: Present { value: seed.checkout_path as String }
  )
}

// ── THE SEED-PIN VERIFIER ────────────────────────────────────────────────────────────────────────
//
// WHY THE SEED CHECKOUT'S REF IS A JOB OUTPUT AND NOT A ROW STRING.
// The field this replaces was `ref_name: NonEmptyStr`, and the seed checkout wrote it into `with.ref`
// verbatim. For every mirror that string was a branch -- `main` -- which is not a commit: a publisher
// job waits in the runner queue behind the heal run it follows, so the branch it resolves is whatever
// `main` meant WHEN THE JOB STARTED, and the compiler that judged the seal and the compiler that admits
// the publication can be two different trees. gunbc.action_use_admission::admit_workflow_checkout_refs
// exists to refuse exactly that, and it admits a checkout ref in four forms only: the event sha, the
// pull-request head sha, a declared revision input, or a `needs.<job>.outputs.<name>` naming a job that
// earns the output. A literal is "anything else: refused". The publisher emitter never declared its ref
// and was refused fail-closed at #15631 -- no bad YAML, which is what a wall is for. The witness and
// drift emitters never called that wall at all: the same hazard, with no gate in front of it. Both now
// do, and the only ref a seed checkout can carry is the verifier's declared output.
//
// WHY A JOB AND NOT A STEP. The four admitted forms are contexts the wall reads, and a step-local
// `${{ steps.x.outputs.y }}` is not one of them -- gunbc.action_use_admission
// checkout_expression_context_admitted refuses Steps, Job, Runner, Secrets and Matrix outright. So a
// step beside the checkout cannot hand it a ref the wall will accept, and a run-step that fetched and
// checked out on its own would be the very family the side chat refused (and the family quick-newt-573
// withdrew a zero-job preference over). Only a JOB output, declared by a record the wall itself folds,
// can carry the ref. That record is CommitOutputProducer, and the MODEL owns it (gunbc.action_use_admission
// seed_pin_verifier_producer): a row names which repository, where it lands and what it builds, never the
// verifier's identity.
//
// WHAT IT PROVES, AND WHAT IT REFUSES. It fetches the one pinned object -- by sha, never by branch or
// tag name, never through ls-remote, never `|| github.sha` -- from the url derived from the row's
// `repository` (seed_pin_fetch_url) and no other remote, into an object store under RUNNER_TEMP that nothing else touches and that it deletes
// before creating (a runner whose temp survives a previous job must not hand this job a store it did not
// fetch). Then it requires two things: `git cat-file -t` of the pin says `commit` (an object the pin
// names that is a tag, tree or blob is not a commit), and `git rev-parse` of the pin equals the pin
// (the object's own id, so a nearby object cannot satisfy it -- and `rev-parse` without `^{commit}`,
// because peeling would accept a tag pointing at a commit). Either check failing refuses the step, and
// with it the job, and with it the seed checkout: a mirror never publishes against a tree nobody named.
// The output line is the LAST statement, so a verifier that refused has written nothing -- there is
// nothing for a checkout to read, which is what "refuses with no output" has to mean operationally.
//
// ONE AUTHORITY FOR THE NAME. The job id, the output name and the earning step's id are the single model-owned
// producer record in gunbc.action_use_admission; the store directory is a projection of the job id, made
// here, once; the checkout's ref expression, the job's declared output, the guard's refusal text and the
// allowlist entry the wall admits are all projections of that one record. Nothing in a profile row can move
// one of them away from the others -- which is the form the reviewer's #15631 ruling asked for: an entry is
// earned by a producer record, never hand-written, and never row-supplied either (review 90155).
//
// WHY A JOB PROVES THE PIN WHEN actions/checkout WOULD ALSO FAIL -- the reason review 90180 asked to see
// written down, decided by stern-bat-401 after keen-otter-392 approved this shape (msg_3ccdbb99). A 40-hex
// string that commit_sha_text_holds accepts, rendered straight into `ref:`, is already refused by GitHub
// when no such object lives in the row's `repository`: the checkout step passes `repository:` explicitly, so
// it is that repository and not the workflow's own that is contacted, and a fetch asks for one object by sha,
// so a blob or a tree is not served for it either. The verifier is therefore NOT there to catch a missing
// object. It is there for two things a ref, on its own, cannot do:
//   1. THE WALL ANSWERS "WHO EARNED THIS VALUE", NOT "DOES THIS STRING LOOK LIKE A COMMIT". Admission is a
//      producer record (CommitOutputProducer, folded by the wall itself). A syntactic literal arm would make
//      the answer something any emitter can produce by building a forty-character string, and would be a
//      second path beside the modelled route DESIGN.md section 5 refuses. The property the wall decides has
//      to be provenance, because syntax is the one thing an emitter can always fabricate.
//   2. THE FAILURE NAMES THE FACT, AND IT NAMES IT BEFORE THE TREE IS READ. Each proof is a row carrying a
//      typed refusal -- SeedPinIsNotACommit, SeedPinFetchedObjectIsNotThePin -- with the object it examined
//      and the url it fetched from. `ref: <pin>` would fail inside actions/checkout, where the reason belongs
//      to the action, in the one step that must not run until the fact is established.

fn seed_pin_store_var_name() -> String { "GUNBC_SEED_PIN_STORE" }

// THE PRODUCER PATH -- the string the checkout reads and the wall admits, from one call. No parameter: the
// path is the record's, and a `seed` here would suggest a row could move it (review 90155).
fn seed_pin_verifier_output_path() -> String {
  commit_output_producer_path(producer: seed_pin_verifier_producer())
}

// THE REF THE SEED CHECKOUT NAMES: the verifier job's declared output, as an Expression the wall can
// read. Absent when the row's source is not a proven commit, and there is no branch fallback anywhere
// in this module to catch it.
fn seed_pin_checkout_ref_expression(seed: PublicSeed) -> Optional<Expression> {
  match seed_source_pin(source: seed.source) {
    Present { value: _ } =>
      Present {
        value: ContextAccess {
          context: Needs,
          path: [
            seed_pin_verifier_job_id(),
            "outputs",
            seed_pin_verifier_output_name(),
          ],
        },
      }
    Absent {  } => Absent {  }
  }
}

// THE `ref:` ENTRY, from that same expression. There is one place either is built, so the ref a step
// renders cannot be a different spelling from the Expression its workflow declares -- the identity join
// in gunbc.action_use_admission::step_checkout_ref_refusals refuses exactly that mismatch.
fn seed_pin_checkout_ref_entry(seed: PublicSeed) -> Optional<YamlKeyValue> {
  match seed_pin_checkout_ref_expression(seed: seed) {
    Present { value: e } => Present { value: checkout_ref_entry(ref_expression: e) }
    Absent {  } => Absent {  }
  }
}

// THE LIST A CONSUMER MUST DECLARE TO THE WALL: the ref expression the seed checkout will render, for the
// identity join that refuses a `ref:` which is not the rendering of a declared Expression. The producer is
// NOT passed to the wall -- the wall reads the workflow it is admitting, and the verifier job below is what
// makes the ref admissible, by declaring its own output. A seedless or owed-pin row declares nothing,
// because it emits no checkout and no verifier.
fn seed_pin_verifier_declared_expressions(seed: PublicSeed) -> List<Expression> {
  match seed_pin_checkout_ref_expression(seed: seed) {
    Present { value: e } => [e]
    Absent {  } => []
  }
}

// WHERE THE SEED COMES FROM, spelled ONCE. The checkout step takes `repository:` (an owner/repo) and the
// verifier's fetch takes a URL; had those been two fields on the row they could have named two repositories
// -- the verifier would then have proved a pin in a store fetched from somewhere else while the lane was
// filled with a tree from somewhere else still, which is precisely the trust the verifier exists to supply.
// Deriving it here means the two can only ever disagree if `repository` disagrees with itself. `github.com`
// is spelled in this one place because the whole hosted-CI stack already assumes it (actions/checkout
// resolves a bare owner/repo against the host it runs on); admitting a seed on another host means bringing
// a host authority row, not editing this join.
fn seed_pin_fetch_url(seed: PublicSeed) -> String {
  join(["https://github.com/", seed.repository as String, ".git"], "")
}

// WHAT MAKES A PIN A COMMIT: the facts a verifier must establish, as DATA. Two hand-written `if`s would
// make "the verifier checks the two things" a fact only the shell knows; a control cannot notice one being
// deleted, and a verifier that checks nothing still prints its output. Here each proof carries its own
// query, the value the query must equal, and the refusal that fires when it does not, and the emitted
// script is a fold over this list -- so removing a guard removes a row, which is something the model's
// controls can and do see.
//
// The two rows ask different questions, and neither is answerable from the other. `cat-file -t` asks what
// the object named by the pin IS: nothing there, a tag, a tree or a blob all refuse, because only a commit
// may be built. `rev-parse --verify FETCH_HEAD` asks what the FETCH actually BROUGHT: the store was created
// empty seconds earlier and the only thing in it should be what the fetch from the URL this row's
// `repository` field names delivered, so if the last fetch left FETCH_HEAD naming some other object -- a
// substitute, a ref that resolved elsewhere -- the pin names a commit the lane never received. A proof that
// asked the second question of the pin itself (`rev-parse <pin>`) could not fail: given a full sha, git
// prints that sha back whether or not anything was fetched, which is a check that reads as coverage and is
// decoration (DESIGN 4b). The wrong-repository case is not a proof here at all: it is structural, because
// the fetch URL and the checkout's `repository:` are the same field of this row.
type SeedPinProof {
  name: String
  variable: String
  query: List<String>
  expected: String
  refusal: String
}

fn seed_pin_proofs(seed: PublicSeed, pin: String) -> List<SeedPinProof> {
  let remote = seed_pin_fetch_url(seed: seed)
  [
    SeedPinProof {
      name: "SeedPinIsNotACommit",
      variable: "GUNBC_SEED_PIN_TYPE",
      query: ["cat-file", "-t", pin],
      expected: "commit",
      refusal: join(
        [
          remote, " does not have a commit object at ", pin,
          " (it resolved to ", seed_pin_var_or_nothing(variable: "GUNBC_SEED_PIN_TYPE"),
          "); the pin names something else, or nothing",
        ],
        ""
      ),
    },
    SeedPinProof {
      name: "SeedPinFetchedObjectIsNotThePin",
      variable: "GUNBC_SEED_PIN_FETCHED",
      query: ["rev-parse", "--verify", "--quiet", "FETCH_HEAD"],
      expected: pin,
      refusal: join(
        [
          remote, " @ ", pin, " left FETCH_HEAD at ", seed_pin_var_or_nothing(variable: "GUNBC_SEED_PIN_FETCHED"),
          "; the fetch delivered a different object than the commit this row pins",
        ],
        ""
      ),
    },
  ]
}

// ONE PROOF, AS TWO STATEMENTS: read the query into a variable, then refuse unless it equals what the row
// commits to. The query is assigned through a command substitution guarded by `|| true` and the equality
// is tested separately, because a substitution argument is rendered unquoted by v2.workflow.bash_emit and
// a failure inside a substitution is invisible to the statement that contains it.
fn seed_pin_proof_statements(proof: SeedPinProof, store: Node, git: Node) -> List<Node> {
  let query_words = concat(
    [git, word(text: "-C"), store],
    map(proof.query, q => word(text: q))
  )
  [
    bash_build_assign(
      name: proof.variable,
      value: bash_build_word_cmdsubst(
        body: bash_build_or_else(
          left: command(words: query_words),
          right: command_words(rest: ["true"])
        )
      )
    ),
    bash_build_or_else(
      left: bash_build_test_bracket(words: [
        var_word(name: proof.variable),
        word(text: "="),
        word(text: proof.expected),
      ]),
      right: seed_pin_refusal(name: proof.name, message: proof.refusal)
    ),
  ]
}

// THE FETCH AND ITS PROOFS, as typed shell nodes. `set -e` comes from the fold; strict mode is
// imposed here because a fetch that silently produced nothing must fail rather than leave an empty
// store for the next statement to mistake for success.
fn seed_pin_verification_statements(seed: PublicSeed, pin: String) -> List<Node> {
  let store_name = seed_pin_store_var_name()
  let store = var_word(name: store_name)
  let pin_word = word(text: pin)
  let git = word(text: "git")
  let job_id = seed_pin_verifier_job_id()
  let proof_statements = fold(
    seed_pin_proofs(seed: seed, pin: pin),
    init: [],
    f: fn(acc, proof) { concat(acc, seed_pin_proof_statements(proof: proof, store: store, git: git)) }
  )
  concat(
    [
      set_strict_stmt(),
      bash_build_assign(
        name: store_name,
        value: path_under(name: "RUNNER_TEMP", tail: join(["gunbc-seed-pin/", job_id], ""))
      ),
      command(words: [word(text: "rm"), word(text: "-rf"), word(text: "--"), store]),
      command(words: [word(text: "mkdir"), word(text: "-p"), word(text: "--"), store]),
      command(words: [git, word(text: "init"), word(text: "--bare"), word(text: "--quiet"), word(text: "--"), store]),
      // The pin is fetched BY SHA, from the derived remote and nowhere else: an unavailable pin, or one
      // that exists only in someone's fork, dies here with the remote named in the diagnostic.
      command(words: [
        git, word(text: "-C"), store, word(text: "fetch"), word(text: "--quiet"), word(text: "--no-tags"),
        word(text: "--depth"), word(text: "1"), word(text: seed_pin_fetch_url(seed: seed)), pin_word,
      ]),
    ],
    concat(
      proof_statements,
      [
        // LAST, AND ONLY LAST: the job's output exists exactly when every proof passed.
        bash_build_with_redir_to_file(
          inner: bash_build_pipe(
            left: command(words: [word(text: "echo"), word(text: join([seed_pin_verifier_output_name(), "=", pin], ""))]),
            right: command(words: [word(text: "tee"), word(text: "-a"), var_word(name: "GITHUB_OUTPUT")])
          ),
          path: word(text: "/dev/null")
        ),
      ]
    )
  )
}

// WHAT THE REFUSAL SAYS ABOUT AN ABSENT ANSWER. `set -u` makes an unset variable an error, and a
// diagnostic that errors while explaining an absence is worse than the absence; the variable is named by
// the proof, so the message and the guard cannot name different things.
fn seed_pin_var_or_nothing(variable: String) -> String {
  join(["<", variable, ">"], "")
}

fn seed_pin_refusal(name: String, message: String) -> Node {
  bash_build_subshell_from_stmts(stmts: [
    command(words: [word(text: "echo"), word(text: join(["::error title=seed-pin ", name, "::", message], ""))]),
    bash_build_exit(code: "1"),
  ])
}

// THE VERIFIER STEP. Its `id` is the step id the record names as the one that earns the output -- the same
// value the job's output map reads and the wall looks for when it asks whether the producer is carried.
fn seed_pin_verifier_step(seed: PublicSeed, pin: String) -> Outcome<Step> {
  bind_outcome(
    o: bash_emit_stmts(statements: seed_pin_verification_statements(seed: seed, pin: pin), set_e: true),
    f: fn(script) {
      outcome_accepted(
        value: RunStep {
          name: Present { value: seed.verifier.verification_step_name },
          id: Present { value: seed_pin_verifier_check_step_id() },
          run: script,
          shell: none,
          env: none,
          working_directory: none,
          if_condition: none,
          continue_on_error: none,
          timeout_minutes: none
        }
      )
    }
  )
}

// THE VERIFIER JOB. Read-only permissions and no checkout: it authenticates to nothing, because the
// intended repository is public and a proof that needed a credential would be a proof the publisher's
// admit step could not run -- which is the defect class the heal publisher just learned about the hard
// way (AuthDeclaredButUnwired). `runner` is the consumer's own runner target: the proof is about the
// seed, but it is the consumer that cannot proceed without it, and a verifier scheduled somewhere the
// consumer cannot reach would be a job that proves nothing to anyone.
fn seed_pin_verifier_job(seed: PublicSeed, pin: String, runner: RunnerSpec) -> Outcome<Job> {
  bind_outcome(
    o: seed_pin_verifier_step(seed: seed, pin: pin),
    f: fn(step) {
      outcome_accepted(
        value: Job {
          id: seed_pin_verifier_job_id(),
          name: Present { value: join(["Verify the seed pin ", pin], "") },
          runner: runner,
          environment: none,
          steps: [step],
          needs: [],
          env: none,
          outputs: Present {
            value: [
              kv(
                key: seed_pin_verifier_output_name(),
                value: yaml_string(
                  s: interpolate(
                    expression: ContextAccess {
                      context: Steps,
                      path: [seed_pin_verifier_check_step_id(), "outputs", seed_pin_verifier_output_name()],
                    }
                  )
                )
              )
            ]
          },
          if_condition: none,
          timeout_minutes: none,
          continue_on_error: none,
          concurrency: none,
          permissions: Present {
            value: WorkflowPermissions {
              contents: Present { value: PermRead },
              pull_requests: none,
              issues: none,
              actions: none,
              id_token: none,
            }
          }
        }
      )
    }
  )
}

// THE CONSUMER DOES NOT TAKE THE PRODUCER'S WORD FOR IT. `needs` guarantees that the verifier job RAN and
// succeeded; it does not guarantee that it PRODUCED the output. GitHub can suppress an output without
// failing its job, an unset output renders as the empty string to the consumer, and actions/checkout --
// the release this repository pins -- resolves an empty `ref` with no `commit` against the repository's
// DEFAULT BRANCH. So a producer that succeeded silently would send the lane to `main`, which is the exact
// hazard this row exists to make unwritable, arriving through a path nobody hand-typed. The consuming job
// therefore compares the value it actually received against the pin the row admitted, and fails before
// the checkout runs: an absent value, an empty one, or one that is merely some other commit is refused.
// It is a guard, not a checkout -- the checkout stays an action step under the ref wall.
// WHAT IT IS NOT: it compares the received value to the SAME pin the row already holds, so it discovers no
// new fact about the commit -- its value is the position it occupies (the last step before the seed tree is
// read), the typed reason it prints, and the fact that it can refuse a producer that succeeded while
// producing nothing. Review 90180 read that correctly, and the answer is stated here rather than claimed.
fn seed_pin_consumer_guard_step_name() -> String {
  "Refuse the seed checkout unless the verifier reported the pinned commit"
}

fn seed_pin_consumer_guard_step_id(seed: PublicSeed) -> String {
  join([seed_pin_verifier_job_id(), "-guard"], "")
}

fn seed_pin_consumer_guard_var_name() -> String {
  "GUNBC_SEED_PIN_RECEIVED"
}

// THE ONE EXPRESSION THE GUARD READS, which is the same Expression the checkout's ref is rendered from --
// one producer, one path, read at both ends by name rather than by two spellings.
fn seed_pin_consumer_guard_env(seed: PublicSeed) -> List<YamlKeyValue> {
  match seed_pin_checkout_ref_expression(seed: seed) {
    Present { value: e } => [
      kv(key: seed_pin_consumer_guard_var_name(), value: yaml_string(s: interpolate(expression: e))),
    ]
    Absent {  } => []
  }
}

fn seed_pin_consumer_guard_statements(seed: PublicSeed, pin: String) -> List<Node> {
  let received = var_word(name: seed_pin_consumer_guard_var_name())
  let producer = seed_pin_verifier_producer()
  [
    set_strict_stmt(),
    // Absent and empty are one case in shell terms: both are an unset value at the consumer's edge.
    bash_build_or_else(
      left: bash_build_test_bracket(words: [word(text: "-n"), received]),
      right: seed_pin_refusal(
        name: "SeedPinOutputAbsent",
        message: join(
          [
            "job ", producer.job_id as String, " succeeded without producing ", producer.output_name as String,
            "; refusing to check out ", seed.repository as String, " at ", pin,
            " on a producer that proved nothing",
          ],
          ""
        )
      )
    ),
    // Equality against the ROW's pin: a producer that answered with some other existing commit is refused
    // too, because the row -- not the run -- says which commit this mirror's claims are judged against.
    bash_build_or_else(
      left: bash_build_test_bracket(words: [received, word(text: "="), word(text: pin)]),
      right: seed_pin_refusal(
        name: "SeedPinOutputIsNotThePin",
        message: join(
          [
            "the seed verifier reported ", seed_pin_received_or_nothing(), ", not the pinned commit ", pin,
            "; refusing to judge this repository against a tree its row did not commit to",
          ],
          ""
        )
      )
    ),
  ]
}

fn seed_pin_received_or_nothing() -> String {
  join(["<", seed_pin_consumer_guard_var_name(), ">"], "")
}

fn seed_pin_consumer_guard_step(seed: PublicSeed, pin: String) -> Outcome<Step> {
  bind_outcome(
    o: bash_emit_stmts(statements: seed_pin_consumer_guard_statements(seed: seed, pin: pin), set_e: true),
    f: fn(script) {
      outcome_accepted(
        value: RunStep {
          name: Present { value: seed_pin_consumer_guard_step_name() },
          id: Present { value: seed_pin_consumer_guard_step_id(seed: seed) },
          run: script,
          shell: none,
          env: Present { value: seed_pin_consumer_guard_env(seed: seed) },
          working_directory: none,
          if_condition: none,
          continue_on_error: none,
          timeout_minutes: none
        }
      )
    }
  )
}

// WHAT A LANE THAT JUDGES CLAIMS BY THE SEED CARRIES: the guard, then the checkout, in that order and as
// one value. Passing the two separately is how a lane ends up with the checkout and not the guard -- a
// pair that arrives as a pair cannot be half-emitted.
type SeedLaneSteps {
  guard: Step
  checkout: Step
}

fn seed_lane_steps(seed: PublicSeed, pin: String) -> Outcome<SeedLaneSteps> {
  bind_outcome(
    o: seed_pin_consumer_guard_step(seed: seed, pin: pin),
    f: fn(guard) {
      bind_outcome(
        o: seed_checkout_step(seed: seed),
        f: fn(checkout) {
          outcome_accepted(value: SeedLaneSteps { guard: guard, checkout: checkout })
        }
      )
    }
  )
}
