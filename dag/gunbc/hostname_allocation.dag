// THE MACHINES, DERIVED FROM THE REGISTRY. A spelling resolves to a machine only by joining this
// membership; there is no second roster list to keep in step (it used to be authored beside the rows in
// gunbc.fleet.fleet_host_identity, a restatement of the kind
// gunbc.recurring_failure_mode::a_target_roster_restates_the_labels_its_bindings_name records).
// THE OPERATIONAL ROSTER IS THE ADMITTED REGISTRY, NOT ITS ROWS. Membership is read through
// hostname_allocation_admission like every other read of the registry, so a registry with a colliding
// handle, current name or pending name admits no machine -- not even one outside the collision -- and an
// effect entry that asks for its host is told why (gunbc.design_argument::fail_closed).
type OperatorHostLookup
  = OperatorHostFound { host: HostIdentity }
  | OperatorHostNotRegistered { label: String }
  | OperatorHostRegistryRefused { key: String }

fn operator_host_lookup_in(allocations: List<HostnameAllocation>, label: String) -> OperatorHostLookup {
  match hostname_allocation_admission(allocations: allocations) {
    AllocationPrimaryKeyRepeated { key: k } => OperatorHostRegistryRefused { key: k }
    AllocationSecondaryKeyRepeated { key: k } => OperatorHostRegistryRefused { key: k }
    AllocationAdmitted { roster: _ } =>
      match filter(allocations, m => (m.fleet_slot as String) == label).first() {
        Present { value: m } => OperatorHostFound { host: m.fleet_slot }
        Absent => OperatorHostNotRegistered { label: label }
      }
  }
}

fn operator_host_lookup(label: String) -> OperatorHostLookup {
  operator_host_lookup_in(allocations: fleet_machine_registry, label: label)
}

// WHAT AN EFFECT ENTRY SAYS WHEN IT ADMITS NO HOST, once, so each entry prefixes its own name and none
// writes its own sentence about a refused registry.
fn operator_host_lookup_refusal(lookup: OperatorHostLookup) -> String? {
  match lookup {
    OperatorHostFound { host: _ } => Absent
    OperatorHostNotRegistered { label: l } => Present { value: concat("no operator host is named ", l) }
    OperatorHostRegistryRefused { key: k } =>
      Present { value: join(["the fleet machine registry is refused (", k, " is claimed twice), so no machine is admitted"], "") }
  }
}

data operator_hosts: List<HostIdentity> = match hostname_allocation_admission(allocations: fleet_machine_registry) {
  AllocationAdmitted { roster: _ } => map(fleet_machine_registry, m => m.fleet_slot)
  AllocationPrimaryKeyRepeated { key: _ } => []
  AllocationSecondaryKeyRepeated { key: _ } => []
}

fn operator_host_named(label: NonEmptyStr) -> HostIdentity? {
  match operator_host_lookup(label: label as String) {
    OperatorHostFound { host: h } => Present { value: h }
    OperatorHostNotRegistered { label: _ } => Absent
    OperatorHostRegistryRefused { key: _ } => Absent
  }
}

// A PENDING NAME IS RESERVED BUT NOT ANSWERED TO. An accepted next_name must not be drawn again for
// another machine, so a draw treats it as taken; it is not a selector form, because the machine does
// not answer to it until the rename transition applies it.
fn allocation_pending_forms(allocation: HostnameAllocation) -> List<String> {
  match allocation.next_name {
    Absent => []
    Present { value: n } => match n {
      LegacyHostname { label: l } => [l as String]
      DrawnHumanName { name: h, draw: _ } => [human_name_canonical_hostname(name: h) as String]
    }
  }
}

fn allocation_reserved_forms(allocation: HostnameAllocation) -> List<String> {
  append(allocation_selector_forms(allocation: allocation), allocation_pending_forms(allocation: allocation))
}

// A pending name is read only from an admitted registry, so a colliding one names no rename target.
fn next_name_for_fleet_slot(fleet_slot: HostIdentity) -> AllocatedHostName? {
  match hostname_allocation_admission(allocations: fleet_machine_registry) {
    AllocationPrimaryKeyRepeated { key: _ } => Absent
    AllocationSecondaryKeyRepeated { key: _ } => Absent
    AllocationAdmitted { roster: _ } =>
      match filter(fleet_machine_registry, m => (m.fleet_slot as String) == (fleet_slot as String)).first() {
        Absent => Absent
        Present { value: m } => m.next_name
      }
  }
}

fn canonical_hostname_for_fleet_slot(fleet_slot: HostIdentity) -> DnsLabel? {
  canonical_hostname_in_roster(
    allocations: fleet_machine_registry,
    fleet_slot: fleet_slot,
  )
}

// THE DRAW. One entropy value indexes the first-part list for the first part, the last-part list for
// the last part and the first-part list again for the middle part, so a draw fixes all three forms
// at once and a collision lengthens the SAME name rather than re-rolling a different one. The
// shortest form no existing host answers to is allocated -- shorter names while the fleet is small,
// longer ones only where a collision demands it, with no fleet-size threshold anywhere. A draw whose
// three forms are all taken refuses and names them; a second entropy value is the remedy, never a
// numeric suffix that would be a fourth, unmodeled name shape.
type HumanNameDrawOutcome
  = HumanNameDrawn { name: HumanName }
  | HumanNameDrawExhausted { entropy: Int, taken_forms: List<String> }
  | HumanNameDrawRefused { reason: NonEmptyStr }

fn selector_form_is_taken(taken: List<String>, form: String) -> Bool {
  any(taken, t => t == form)
}

fn first_untaken_human_name(
  forms: List<HumanName>,
  taken: List<String>,
  entropy: Int,
) -> HumanNameDrawOutcome {
  match filter(forms, f => !selector_form_is_taken(taken: taken, form: human_name_canonical_hostname(name: f) as String)).first() {
    Present { value: name } => HumanNameDrawn { name: name }
    Absent => HumanNameDrawExhausted {
      entropy: entropy,
      taken_forms: map(forms, f => human_name_canonical_hostname(name: f) as String),
    }
  }
}

fn draw_human_name(draw: HumanNameDraw, existing: List<HostnameAllocation>) -> HumanNameDrawOutcome {
  let given = host_name_first_parts
  let surnames = gen_z_last_parts
  let n = draw.entropy
  let taken = flat_map(existing, a => allocation_reserved_forms(allocation: a))
  if n < 0 {
    HumanNameDrawRefused { reason: "a name draw needs non-negative entropy; a negative value has no index into the corpus" }
  } else {
    match given.get(index: n % given.length()) {
      Absent => HumanNameDrawRefused { reason: "the given-name corpus is empty" }
      Present { value: first } => match surnames.get(index: (n / given.length()) % surnames.length()) {
        Absent => HumanNameDrawRefused { reason: "the surname corpus is empty" }
        Present { value: last } => match given.get(index: (n / (given.length() * surnames.length())) % given.length()) {
          Absent => HumanNameDrawRefused { reason: "the given-name corpus is empty" }
          Present { value: middle } => first_untaken_human_name(
            forms: [
              FirstOnly { first: first as DnsLabel },
              FirstLast { first: first as DnsLabel, last: last as DnsLabel },
              FirstMiddleLast { first: first as DnsLabel, middle: middle as DnsLabel, last: last as DnsLabel },
            ],
            taken: taken,
            entropy: n,
          )
        }
      }
    }
  }
}

// RESOLVE ONCE, THEN CARRY THE IDENTITY. An operator selector -- a stable identity, an allocated
// hostname, or a shorter form of a drawn name -- resolves here to one HostIdentity, and everything
// after resolution (plan, apply, observation binding) carries that identity, so a rename between plan
// and apply cannot retarget. An exact match on an identity or allocated hostname wins outright,
// because those are injective by the roster; a shorter form resolves only when exactly one host
// answers to it, and otherwise the candidates come back by their full allocated names.
type HostSelectorResolution
  = HostSelectorResolved { host: HostIdentity }
  | HostSelectorAmbiguous { selector: String, candidates: List<DnsLabel> }
  | HostSelectorUnknown { selector: String }
  | HostSelectorRegistryRefused { key: String }

fn resolution_of_matches(selector: String, matches: List<HostnameAllocation>) -> HostSelectorResolution? {
  match matches.first() {
    Absent => Absent
    Present { value: only } =>
      if matches.length() == 1 {
        Present { value: HostSelectorResolved { host: only.fleet_slot } }
      } else {
        Present { value: HostSelectorAmbiguous {
          selector: selector,
          candidates: map(matches, a => allocated_canonical_hostname(allocation: a)),
        } }
      }
  }
}

// A SELECTOR RESOLVES ONLY AGAINST AN ADMITTED REGISTRY, like every other read of it: a registry that
// hostname_allocation_admission refuses resolves nothing and names the colliding key, rather than
// answering Unknown or picking a row by authoring order.
fn resolve_host_selector_in(allocations: List<HostnameAllocation>, selector: String) -> HostSelectorResolution {
  match hostname_allocation_admission(allocations: allocations) {
    AllocationPrimaryKeyRepeated { key: k } => HostSelectorRegistryRefused { key: k }
    AllocationSecondaryKeyRepeated { key: k } => HostSelectorRegistryRefused { key: k }
    AllocationAdmitted { roster: _ } => resolve_host_selector_in_admitted(allocations: allocations, selector: selector)
  }
}

fn resolve_host_selector_in_admitted(allocations: List<HostnameAllocation>, selector: String) -> HostSelectorResolution {
  let exact = filter(allocations, a =>
    (a.fleet_slot as String) == selector || (allocated_canonical_hostname(allocation: a) as String) == selector
  )
  match resolution_of_matches(selector: selector, matches: exact) {
    Present { value: r } => r
    Absent => match resolution_of_matches(
      selector: selector,
      matches: filter(allocations, a => selector_form_is_taken(taken: allocation_selector_forms(allocation: a), form: selector)),
    ) {
      Present { value: r } => r
      Absent => HostSelectorUnknown { selector: selector }
    }
  }
}

fn resolve_host_selector(selector: String) -> HostSelectorResolution {
  resolve_host_selector_in(allocations: fleet_machine_registry, selector: selector)
}

// ---------------------------------------------------------------------------------------------
// THE OBSERVED KERNEL HOSTNAME IS A NAME, NEVER AN IDENTITY
// ---------------------------------------------------------------------------------------------

// WHAT A MACHINE ANSWERS `hostname -s` LOOKS LIKE AN IDENTITY AND IS NOT ONE. The roster already
// disproves the equation: srv14 answers "butch", srv15 answers "bobo", srv9-srv12 answer francis,
// emerson, mil and bastien, mtjade1 answers eric -- and every rename this program performs adds
// another pair. A site that compares or casts the kernel's answer against a HostIdentity therefore
// refuses the hosts whose name and identity differ, and a site that CARRIES it as the identity binds
// the wrong machine silently, today on those hosts and on every renamed one.
// (gunbc.plans.fleet_machine_authority section 4.4 (b*), the comparator census its P1 replaces.)
//
// THE ONE RULE, SHARED BY EVERY SUCH SITE INSTEAD OF THIRTEEN COPIES OF IT: the observed spelling
// resolves through resolve_host_selector above, and only what it resolves to is carried onward. An
// empty answer is its own refusal -- a failed observation is not a name -- and Ambiguous and Unknown
// name the spelling they refused. NOTHING falls back to the raw string: a site that "just" compares
// on a fallback has reinstated the equation this function exists to break, and a comparison against
// a refused spelling is not a check but a coincidence.
//
// IT IS PURE AND IT NEEDS NO HOST: a witness hands it "butch", or a spelling no roster answers to,
// and discriminates the two answers at this one interface (gunbc.design_argument::witness_one_interface).
type ObservedHostIdentity
  = ObservedHostIdentityResolved { host: HostIdentity }
  | ObservedHostIdentityRefused { refusal: ObservedHostIdentityRefusal }

type ObservedHostIdentityRefusal
  = ObservedHostUnnamed { observed: String }
  | ObservedHostAmbiguous { observed: String, candidates: List<DnsLabel> }
  | ObservedHostUnknown { observed: String }

fn observed_host_identity(observed: String) -> ObservedHostIdentity {
  observed_host_identity_in(allocations: gunbc_fleet_hostname_allocations, observed: observed)
}

// THE SAME RULE OVER A GIVEN ROSTER, so a witness can hand it two hosts that answer to one short
// name and see the Ambiguous refusal without editing the fleet (the pattern resolve_host_selector_in
// already sets in this module).
fn observed_host_identity_in(allocations: List<HostnameAllocation>, observed: String) -> ObservedHostIdentity {
  let spelling = trim(s: observed)
  if spelling == "" {
    ObservedHostIdentityRefused { refusal: ObservedHostUnnamed { observed: observed } }
  } else {
    match resolve_host_selector_in(allocations: allocations, selector: spelling) {
      HostSelectorResolved { host: host } => ObservedHostIdentityResolved { host: host }
      HostSelectorAmbiguous { selector: s, candidates: c } =>
        ObservedHostIdentityRefused { refusal: ObservedHostAmbiguous { observed: s, candidates: c } }
      HostSelectorUnknown { selector: s } =>
        ObservedHostIdentityRefused { refusal: ObservedHostUnknown { observed: s } }
    }
  }
}

// WHAT EACH REFUSAL TELLS AN OPERATOR, ONCE. A site prefixes its own context to this; none of them
// writes its own sentence about what an unknown spelling means, because thirteen sentences is
// thirteen chances to say something the selector does not mean.
fn observed_host_identity_refusal_text(refusal: ObservedHostIdentityRefusal) -> String {
  match refusal {
    ObservedHostUnnamed { observed: o } =>
      join(["the kernel named nothing (the raw answer was ", quote_spelling(s: o),
            "); a failed observation is not a host name"], "")
    ObservedHostAmbiguous { observed: o, candidates: c } =>
      join([quote_spelling(s: o), " answers to more than one host (",
            join(map(c, d => d as String), ", "),
            "); a shorter form selects a host only when exactly one answers to it"], "")
    ObservedHostUnknown { observed: o } =>
      join([quote_spelling(s: o),
            " is no host's identity, allocated hostname, or shorter form of its drawn name;",
            " the kernel's answer is a name and is never a HostIdentity"], "")
  }
}

fn quote_spelling(s: String) -> String {
  concat(concat("[", s), "]")
}

// THE JOIN OF THE TWO FACTS EVERY DISPATCH-BOUND SITE HOLDS: what the dispatch or the roster selected,
// and what this machine answered. Both sides are names until this resolves them, and the join holds
// only when both name the SAME HostIdentity. Each side refuses by its own typed cause, so an operator
// is sent to the dispatch or to the roster -- or to both, when they name two different machines.
type ObservedHostSelectorJoin
  = ObservedHostSelectorAgreed { host: HostIdentity }
  | ObservedHostSelectorJoinRefused { cause: ObservedHostJoinRefusal }

type ObservedHostJoinRefusal
  = JoinObservedUnnamed { observed: String }
  | JoinObservedAmbiguous { observed: String, candidates: List<DnsLabel> }
  | JoinObservedUnknown { observed: String }
  | JoinExpectedUnnamed { expected: String }
  | JoinExpectedAmbiguous { expected: String, candidates: List<DnsLabel> }
  | JoinExpectedUnknown { expected: String }
  | JoinHostsDisagree { expected: HostIdentity, observed: HostIdentity }

fn join_refusal_of_observed(r: ObservedHostIdentityRefusal) -> ObservedHostJoinRefusal {
  match r {
    ObservedHostUnnamed { observed: o } => JoinObservedUnnamed { observed: o }
    ObservedHostAmbiguous { observed: o, candidates: c } => JoinObservedAmbiguous { observed: o, candidates: c }
    ObservedHostUnknown { observed: o } => JoinObservedUnknown { observed: o }
  }
}

fn observed_host_selector_join(expected: String, observed: String) -> ObservedHostSelectorJoin {
  observed_host_selector_join_in(
    allocations: gunbc_fleet_hostname_allocations, expected: expected, observed: observed)
}

fn observed_host_selector_join_in(
  allocations: List<HostnameAllocation>, expected: String, observed: String
) -> ObservedHostSelectorJoin {
  match observed_host_identity_in(allocations: allocations, observed: expected) {
    ObservedHostIdentityRefused { refusal: r } =>
      match r {
        ObservedHostUnnamed { observed: e } => ObservedHostSelectorJoinRefused { cause: JoinExpectedUnnamed { expected: e } }
        ObservedHostAmbiguous { observed: e, candidates: c } => ObservedHostSelectorJoinRefused { cause: JoinExpectedAmbiguous { expected: e, candidates: c } }
        ObservedHostUnknown { observed: e } => ObservedHostSelectorJoinRefused { cause: JoinExpectedUnknown { expected: e } }
      }
    ObservedHostIdentityResolved { host: wanted } =>
      match observed_host_identity_in(allocations: allocations, observed: observed) {
        ObservedHostIdentityRefused { refusal: r } =>
          ObservedHostSelectorJoinRefused { cause: join_refusal_of_observed(r: r) }
        ObservedHostIdentityResolved { host: answered } =>
          if (wanted as String) == (answered as String) {
            ObservedHostSelectorAgreed { host: answered }
          } else {
            ObservedHostSelectorJoinRefused { cause: JoinHostsDisagree { expected: wanted, observed: answered } }
          }
      }
  }
}

fn observed_host_join_refusal_text(cause: ObservedHostJoinRefusal) -> String {
  match cause {
    JoinObservedUnnamed { observed: o } =>
      observed_host_identity_refusal_text(refusal: ObservedHostUnnamed { observed: o })
    JoinObservedAmbiguous { observed: o, candidates: c } =>
      observed_host_identity_refusal_text(refusal: ObservedHostAmbiguous { observed: o, candidates: c })
    JoinObservedUnknown { observed: o } =>
      observed_host_identity_refusal_text(refusal: ObservedHostUnknown { observed: o })
    JoinExpectedUnnamed { expected: e } =>
      join(["the dispatch named nothing (the raw selection was ", quote_spelling(s: e),
            "); a dispatch that selects no host runs nothing"], "")
    JoinExpectedAmbiguous { expected: e, candidates: c } =>
      join([quote_spelling(s: e), " answers to more than one host (",
            join(map(c, d => d as String), ", "),
            "); the dispatch must select one"], "")
    JoinExpectedUnknown { expected: e } =>
      join([quote_spelling(s: e),
            " is no host's identity, allocated hostname, or shorter form of its drawn name;",
            " the dispatch selected a host the roster does not have"], "")
    JoinHostsDisagree { expected: e, observed: o } =>
      join(["the dispatch selected ", e as String, " and this machine answers ", quote_spelling(s: o as String),
            "; NOTHING has been fetched, installed or written. A run that continued here would mutate ",
            o as String, " and certify it under ", e as String, "'s name"], "")
  }
}
