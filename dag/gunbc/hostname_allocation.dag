module gunbc.hostname_allocation


type HostnameAllocation {
  fleet_slot: product.placement_supply.HostIdentity
  canonical_hostname: extdeps.dns.domain_name.DnsLabel
}

data gunbc_hostname_allocation_scope_disposition: std.disposition.Disposition = std.disposition.Terminal {
  reason: "Single authority for the canonical hostname a fleet slot is allocated. A slot's HostIdentity is an internal placement identity; the hostname a machine answers to is a separate allocated fact governed by the DNS-label authority (extdeps.dns.domain_name — the DNS grammar is consumed here, never re-minted). Deriving one from the other by parsing the identity string is the §3 nicknaming violation: it makes the hostname a coincidence of how the slot happens to be spelled, so an identity that is not a legal label silently has no hostname and an identity that is one silently claims a hostname nobody allocated. Here the mapping is explicit and the lookup fails closed: an unallocated slot yields Absent, never a name reconstructed from the identity. srv1-srv4 carry LEGACY allocations whose hostname equals the slot spelling — that coincidence is now a stated row rather than a derivation rule, so the four deployed intents stay byte-identical while a fifth slot must be allocated a hostname rather than inheriting one. ROLE INDEPENDENCE is structural rather than witnessed: no function here takes a role, a ComputeHost, or any placement fact, so a role change cannot reach a hostname — there is no argument by which it could, which is why no test asserts it."
}

data gunbc_hostname_allocation_injectivity_disposition: std.disposition.Disposition = std.disposition.Terminal {
  reason: "A hostname is a JOIN KEY that consumers copy — SSH known_hosts, DNS records, runner registrations, Docker contexts, Tailscale, sccache endpoints, certificate SANs — so two fleet slots claiming one canonical hostname is not a tidiness defect, it is two machines answering to one join key and every consumer resolving to whichever converged last. Both directions are refused: a slot allocated twice is an ambiguous desired state, a hostname claimed twice is the collision above. The rung is MECHANICALLY PREVENTABLE, not structural: the roster is an ordinary List literal, so a duplicate row remains WRITABLE and is caught by hostname_allocation_roster_verdict, which every production lookup consults before answering — a violating roster makes canonical_hostname_for_fleet_slot answer Absent for every slot rather than serving one arbitrary winner (§5: the failure arm refuses, it does not pick). ATTAINABLE CEILING is structural impossibility, and its NEXT-RUNG TRIGGER is a duplicate-refusing keyed roster carrier whose construction cannot admit a repeated key — the same shape std.occurrence_binding_candidates already builds with typed duplicate evidence; it is not adopted here because that carrier keys on one axis and this roster must stay injective on TWO."
}

type HostnameAllocationRosterVerdict
  = HostnameAllocationRosterConsistent
  | FleetSlotAllocatedTwice { fleet_slot: product.placement_supply.HostIdentity }
  | CanonicalHostnameClaimedTwice { canonical_hostname: extdeps.dns.domain_name.DnsLabel }

type HostnameAllocationRosterScan {
  seen_slots: Map<String, Bool>
  seen_hostnames: Map<String, Bool>
  verdict: HostnameAllocationRosterVerdict
}

fn hostname_allocation_roster_step(
  scan: HostnameAllocationRosterScan,
  row: HostnameAllocation,
) -> HostnameAllocationRosterScan {
  match scan.verdict {
    HostnameAllocationRosterConsistent =>
      match map_get(scan.seen_slots, row.fleet_slot as String) {
        Present { value: _ } =>
          HostnameAllocationRosterScan {
            seen_slots: scan.seen_slots,
            seen_hostnames: scan.seen_hostnames,
            verdict: FleetSlotAllocatedTwice { fleet_slot: row.fleet_slot },
          }
        Absent =>
          match map_get(scan.seen_hostnames, row.canonical_hostname as String) {
            Present { value: _ } =>
              HostnameAllocationRosterScan {
                seen_slots: scan.seen_slots,
                seen_hostnames: scan.seen_hostnames,
                verdict: CanonicalHostnameClaimedTwice { canonical_hostname: row.canonical_hostname },
              }
            Absent =>
              HostnameAllocationRosterScan {
                seen_slots: map_insert(scan.seen_slots, row.fleet_slot as String, true),
                seen_hostnames: map_insert(scan.seen_hostnames, row.canonical_hostname as String, true),
                verdict: HostnameAllocationRosterConsistent,
              }
          }
      }
    FleetSlotAllocatedTwice { fleet_slot: dup } =>
      HostnameAllocationRosterScan {
        seen_slots: scan.seen_slots,
        seen_hostnames: scan.seen_hostnames,
        verdict: FleetSlotAllocatedTwice { fleet_slot: dup },
      }
    CanonicalHostnameClaimedTwice { canonical_hostname: dup } =>
      HostnameAllocationRosterScan {
        seen_slots: scan.seen_slots,
        seen_hostnames: scan.seen_hostnames,
        verdict: CanonicalHostnameClaimedTwice { canonical_hostname: dup },
      }
  }
}

fn hostname_allocation_roster_verdict(
  allocations: List<HostnameAllocation>,
) -> HostnameAllocationRosterVerdict {
  fold(
    allocations,
    init: HostnameAllocationRosterScan {
      seen_slots: empty_map(),
      seen_hostnames: empty_map(),
      verdict: HostnameAllocationRosterConsistent,
    },
    f: hostname_allocation_roster_step,
  ).verdict
}

fn hostname_allocation_pick(
  acc: extdeps.dns.domain_name.DnsLabel?,
  row: HostnameAllocation,
  fleet_slot: product.placement_supply.HostIdentity,
) -> extdeps.dns.domain_name.DnsLabel? {
  match acc {
    Present { value: found } => Present { value: found }
    Absent =>
      if (row.fleet_slot as String) == (fleet_slot as String) {
        Present { value: row.canonical_hostname }
      } else {
        none
      }
  }
}

fn canonical_hostname_in_roster(
  allocations: List<HostnameAllocation>,
  fleet_slot: product.placement_supply.HostIdentity,
) -> extdeps.dns.domain_name.DnsLabel? {
  match hostname_allocation_roster_verdict(allocations: allocations) {
    HostnameAllocationRosterConsistent =>
      fold(
        allocations,
        init: none,
        f: (acc, row) => hostname_allocation_pick(acc: acc, row: row, fleet_slot: fleet_slot),
      )
    FleetSlotAllocatedTwice { fleet_slot: _ } => none
    CanonicalHostnameClaimedTwice { canonical_hostname: _ } => none
  }
}

data gunbc_fleet_hostname_allocations: List<HostnameAllocation> = [
  HostnameAllocation {
    fleet_slot: gunbc.fleet_intent_network.operator_host_srv1,
    canonical_hostname: "srv1" as extdeps.dns.domain_name.DnsLabel,
  },
  HostnameAllocation {
    fleet_slot: gunbc.fleet_intent_network.operator_host_srv2,
    canonical_hostname: "srv2" as extdeps.dns.domain_name.DnsLabel,
  },
  HostnameAllocation {
    fleet_slot: gunbc.fleet_intent_network.operator_host_srv3,
    canonical_hostname: "srv3" as extdeps.dns.domain_name.DnsLabel,
  },
  HostnameAllocation {
    fleet_slot: gunbc.fleet_intent_network.operator_host_srv4,
    canonical_hostname: "srv4" as extdeps.dns.domain_name.DnsLabel,
  },
]

fn canonical_hostname_for_fleet_slot(fleet_slot: product.placement_supply.HostIdentity) -> extdeps.dns.domain_name.DnsLabel? {
  canonical_hostname_in_roster(
    allocations: gunbc_fleet_hostname_allocations,
    fleet_slot: fleet_slot,
  )
}
