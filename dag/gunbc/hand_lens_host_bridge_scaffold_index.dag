module gunbc.hand_lens_host_bridge_scaffold_index


data transport_script_position_host_bridge_dissolution_trigger: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "v2.lens.host_language_transport_script",
    decl_name: "TransportScriptPositionFact",
    field: WholeDeclaration
  }
}

data extdeps_external_authority_host_bridge_dissolution_trigger: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "v2.lens.mandatory_tag.corpus_scan",
    decl_name: "ExtdepsExternalAuthorityModuleFacts",
    field: WholeDeclaration
  }
}
