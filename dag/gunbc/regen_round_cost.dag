module gunbc.regen_round_cost

import std.types { String, Int, List, Bool }

// ONE REGEN ROUND, PRICED BY PHASE, ON TWO CLOCKS -- the instrument behind
// `claim_executor --regen-round-cost`. A round is the convergence recipe that
// gunbc.generated_artifact_merge_driver generated_artifact_merge_driver_repair_steps prints
// at every stranded author: build the seed, emit the mirrors from it, install what drifted,
// rebuild from the installed seed, and read what changed. Every lane in the self-host program
// pays that recipe on every edit inside the seed closure, and until this carrier existed the
// only figures for it were wall times copied into prose ("~18 min a round") that named no
// producer, no host and no tree -- exactly the transcription DESIGN section 6 forbids.
//
// WHY THIS IS AN EXTENSION OF v1_rt trace_mark AND NOT A SECOND INSTRUMENT. compile.dag already
// stamps compile.frontend / compile.normalize / compile.reconcile / compile.analyses /
// compile.emit through trace_mark, and those marks already print a wall elapsed. What they did
// not have was a CPU clock beside the wall one (std.measure measure_clock_basis_note: two clocks
// on one occurrence, neither substitutes) or any way for a consumer to READ them rather than
// scrape stderr. So the runtime gained a process-tree CPU reading at every mark and an armed
// ledger, the regen host gained marks at its own phase boundaries, and this module folds the
// ledger into the receipt. One producer of every figure, read in one place.
//
// CPU IS THE PROCESS TREE, STATED SO THE NUMBER IS NOT MISREAD. The seed build and the rustfmt
// normalization run in children; the compile runs in this process. A self-only clock would
// price the seed build at zero and a children-only clock would price the emit at zero, so the
// reading is utime+stime+cutime+cstime from the process's own accounting, and a child's CPU
// lands on the mark that reaped it. A phase whose wall is large and whose CPU is near zero is
// therefore waiting, not computing -- the discrimination cli_run's floor heartbeat exists for.
//
// WHERE THE READING CANNOT BE TAKEN IT IS UNREADABLE, NEVER ZERO. CpuUnreadable is the arm for a
// host without process accounting; a fabricated 0 would read as "free", which is the direction
// that looks survivable (gunbc.observation_seed_render seed_heartbeat_unreadable_cause is the
// same refusal one instrument over).

type RegenRoundPhase
  = SeedBuild
  | CorpusLoad
  | CorpusReload
  | Frontend
  | Normalize
  | Reconcile
  | Analyses
  | Emit
  | MirrorWrite
  | CandidateVerify
  | Adjudicate
  | HandVerify
  | Digest
  | Install
  | RebuildFromInstalled
  | Diff

type CpuReading
  = CpuMs { ms: Int }
  | CpuUnreadable

// A drained ledger row. `label` is the trace_mark label with its `.done` suffix removed (a plain
// mark keeps its label whole); `wall_ms` is the elapsed since the matching `.begin`, or since the
// previous mark when no begin was opened, which is the contract trace_mark already had.
type TraceMark {
  label: String
  wall_ms: Int
  cpu: CpuReading
}

type RegenRoundPhaseAttribution
  = Attributed { phase: RegenRoundPhase }
  | Unattributed

type RegenRoundCostReceipt {
  producer: String
  host: String
  tree: String
  tree_dirty: Bool
  seed_build_compiled_crates: Int
  rebuild_compiled_crates: Int
  marks: List<TraceMark>
  changed_paths: List<String>
}

fn regen_round_phase_tag(phase: RegenRoundPhase) -> String {
  match phase {
    SeedBuild => "seed_build"
    CorpusLoad => "corpus_load"
    CorpusReload => "corpus_reload"
    Frontend => "compile.frontend"
    Normalize => "compile.normalize"
    Reconcile => "compile.reconcile"
    Analyses => "compile.analyses"
    Emit => "compile.emit"
    MirrorWrite => "mirror_write"
    CandidateVerify => "candidate_verify"
    Adjudicate => "adjudicate"
    HandVerify => "hand_verify"
    Digest => "digest"
    Install => "install"
    RebuildFromInstalled => "rebuild_from_installed"
    Diff => "diff"
  }
}

// THE LABEL EACH PHASE IS STAMPED UNDER, and the one place both ends read it from. The compile
// labels are compile.dag's existing marks verbatim; the regen.* and round.* labels are the marks
// required_regen_host stamps. A mark under any other label is reported as Unattributed rather
// than dropped -- a sub-mark like compile.emit.dag.collect.done is real time and hiding it
// would make the phase lines sum to less than the round.
fn regen_round_phase_label(phase: RegenRoundPhase) -> String {
  match phase {
    SeedBuild => "round.seed_build"
    CorpusLoad => "regen.corpus_load"
    CorpusReload => "regen.corpus_reload"
    Frontend => "compile.frontend"
    Normalize => "compile.normalize"
    Reconcile => "compile.reconcile"
    Analyses => "compile.analyses"
    Emit => "compile.emit"
    MirrorWrite => "regen.mirror_write"
    CandidateVerify => "regen.candidate_verify"
    Adjudicate => "regen.adjudicate"
    HandVerify => "regen.hand_verify"
    Digest => "regen.digest"
    Install => "round.install"
    RebuildFromInstalled => "round.rebuild_from_installed"
    Diff => "round.diff"
  }
}

fn regen_round_phases() -> List<RegenRoundPhase> {
  [SeedBuild, CorpusLoad, CorpusReload, Frontend, Normalize, Reconcile, Analyses, Emit, MirrorWrite, CandidateVerify, Adjudicate, HandVerify, Digest, Install, RebuildFromInstalled, Diff]
}

fn regen_round_phase_of_label(label: String) -> RegenRoundPhaseAttribution {
  fold(regen_round_phases(), init: Unattributed, f: fn(acc, phase) {
    match acc {
      Attributed { phase: p } => Attributed { phase: p }
      Unattributed =>
        if regen_round_phase_label(phase: phase) == label {
          Attributed { phase: phase }
        } else {
          Unattributed
        }
    }
  })
}

fn regen_round_cpu_text(cpu: CpuReading) -> String {
  match cpu {
    CpuMs { ms: m } => to_string(m)
    CpuUnreadable => "na"
  }
}

fn regen_round_mark_line(mark: TraceMark) -> String {
  let subject = match regen_round_phase_of_label(label: mark.label) {
    Attributed { phase: p } => concat("phase=", regen_round_phase_tag(phase: p))
    Unattributed => concat("unattributed label=", mark.label)
  }
  concat(
    concat("regen-round-cost: ", subject),
    concat(concat(" wall_ms=", to_string(mark.wall_ms)), concat(" cpu_ms=", regen_round_cpu_text(cpu: mark.cpu)))
  )
}

fn regen_round_wall_total_ms(marks: List<TraceMark>) -> Int {
  fold(marks, init: 0, f: fn(acc, mark) { acc + mark.wall_ms })
}

// The CPU total is readable only when every row is; one unreadable row makes the sum a
// fabrication and the total says so instead of summing the rows it could read.
fn regen_round_cpu_total(marks: List<TraceMark>) -> CpuReading {
  fold(marks, init: CpuMs { ms: 0 }, f: fn(acc, mark) {
    match acc {
      CpuUnreadable => CpuUnreadable
      CpuMs { ms: sum } =>
        match mark.cpu {
          CpuUnreadable => CpuUnreadable
          CpuMs { ms: m } => CpuMs { ms: sum + m }
        }
    }
  })
}

fn regen_round_bool_text(b: Bool) -> String {
  if b { "true" } else { "false" }
}

fn regen_round_header_line(receipt: RegenRoundCostReceipt) -> String {
  concat(
    concat(concat("regen-round-cost: producer=", receipt.producer), concat(" host=", receipt.host)),
    concat(
      concat(concat(" tree=", receipt.tree), concat(" tree_dirty=", regen_round_bool_text(b: receipt.tree_dirty))),
      concat(
        concat(" seed_build_compiled_crates=", to_string(receipt.seed_build_compiled_crates)),
        concat(" rebuild_compiled_crates=", to_string(receipt.rebuild_compiled_crates))
      )
    )
  )
}

fn regen_round_total_line(receipt: RegenRoundCostReceipt) -> String {
  concat(
    concat("regen-round-cost: total wall_ms=", to_string(regen_round_wall_total_ms(marks: receipt.marks))),
    concat(" cpu_ms=", regen_round_cpu_text(cpu: regen_round_cpu_total(marks: receipt.marks)))
  )
}

fn regen_round_changed_paths_line(receipt: RegenRoundCostReceipt) -> String {
  let listed = fold(receipt.changed_paths, init: "", f: fn(acc, path) {
    if acc == "" { path } else { concat(concat(acc, ", "), path) }
  })
  concat(
    concat("regen-round-cost: changed_paths=", to_string(count(receipt.changed_paths))),
    concat(concat(" [", listed), "]")
  )
}

// The whole receipt as the lines the host prints, in ledger order. Rendered here and read by
// the host through the interpreter, so there is no Rust mirror of this format to drift.
fn regen_round_cost_render(receipt: RegenRoundCostReceipt) -> String {
  let mark_lines = fold(receipt.marks, init: "", f: fn(acc, mark) {
    concat(concat(acc, regen_round_mark_line(mark: mark)), "\n")
  })
  concat(
    concat(concat(regen_round_header_line(receipt: receipt), "\n"), mark_lines),
    concat(concat(regen_round_total_line(receipt: receipt), "\n"), concat(regen_round_changed_paths_line(receipt: receipt), "\n"))
  )
}
