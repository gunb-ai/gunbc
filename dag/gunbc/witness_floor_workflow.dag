module gunbc.witness_floor_workflow

import extdeps.languages.yaml.types { yaml_string, yaml_int, kv }
import extdeps.languages.yaml.emit { serialize_yaml }
import extdeps.languages.yaml.gha_workflow { project_workflow_to_yaml }
import extdeps.github.actions {
  Workflow, Job, Step, RunStep, UsesStep,
  WorkflowTrigger, Push, PullRequest, WorkflowDispatch,
  PullRequestActivity, Opened, Synchronize, Reopened, ReadyForReview,
  DispatchInput, InputString,
  WorkflowPermissions, PermRead,
  ConcurrencySpec, ConcurrencyMappingQueueNotMax, CancelInProgressBool,
  RunnerSpec,
  checkout_action, setup_rust_action
}
import gunbc.runner_spec_from_offer { gunbc_ci_runner_spec }
import gunbc.repo_identity { gunbc_default_branch_name }
import gunbc.merge_admission_produce { ci_repo_root_shell }
import std.types { List, String, Int }

// THE ONLY CI EMISSION THIS REPOSITORY HAS.
//
// Authored fresh on 2026-08-15 as re-add #1 after the CI wipe, deliberately NOT by reviving
// gunbc.ci_workflow's job-spec architecture. That module emitted six jobs across a build ->
// regen -> ci -> heal -> fleet pipeline with per-step timeout rows, artifact transfer between
// jobs, concurrency expressions, upstream-red refusal arms and a floor step whose plan resolved
// batches, workers and a coordinator. None of it is re-derived here, because none of it follows
// from the obligation this workflow discharges.
//
// The obligation is exactly one sentence: every test witness in the repository executes, on
// every push and pull request, and the run is red if any of them is. From that, one job:
// check out the tree, install the toolchain, build the one binary that folds the witnesses, run
// it once. There is no second job, so there is nothing to sequence, nothing to hand an artifact
// to, and no `needs` edge to get wrong.
//
// WHAT IS DELIBERATELY ABSENT, so that a later reader does not restore it as an oversight:
// regen, heal, the generated-artifact drift gates, the seven effect gates, the fmt gate,
// merge-admission stamping and the falsifier cadence are all real obligations and all currently
// unmet. They return one at a time, each re-derived from its own first principles under its own
// operator agreement. Their absence here is the declared state of the ladder, not a gap in this
// module.

data witness_floor_workflow_job_id: String = "witnesses"

data witness_floor_concurrency_group: String = "witness-floor-${{ github.event.pull_request.number || github.ref }}"

// The binaries the fold actually needs, and only those. `claim_executor` is the fold's entry;
// `gunbc` is the CLI the repository's own tooling invokes. The predecessor build job named
// nineteen binaries, most of which this cut deleted; naming a binary that no step runs buys
// nothing and costs a compile.
data witness_floor_required_bins: List<String> = ["claim_executor", "gunbc"]

fn witness_floor_checkout_step() -> Step {
  UsesStep {
    name: Present { value: "Checkout" },
    id: none,
    uses: checkout_action,
    with: Present {
      value: [kv(key: "fetch-depth", value: yaml_int(n: 0))]
    },
    env: none,
    if_condition: none,
    continue_on_error: none,
    timeout_minutes: none
  }
}

fn witness_floor_toolchain_step() -> Step {
  UsesStep {
    name: Present { value: "Install Rust toolchain" },
    id: none,
    uses: setup_rust_action,
    with: none,
    env: none,
    if_condition: none,
    continue_on_error: none,
    timeout_minutes: none
  }
}

// One cargo invocation, no retry arm. The predecessor carried a fallback that re-ran the build
// with CARGO_BUILD_JOBS=1 and RUSTC_WRAPPER unset when the first attempt failed; that arm made
// an sccache deficit unobservable by construction (DESIGN section 5, the absorbing fallback), so
// it is not re-derived. A build failure is a build failure and stops the line.
fn witness_floor_build_script() -> String {
  fold(
    witness_floor_required_bins,
    init: "cargo build --release -p v1-compiler",
    f: fn(acc, bin) { concat(acc, concat(" --bin ", bin)) }
  )
}

fn witness_floor_build_step() -> Step {
  RunStep {
    name: Present { value: "Build the witness fold" },
    id: none,
    run: concat(witness_floor_build_script(), "\n"),
    shell: none,
    env: none,
    working_directory: none,
    if_condition: none,
    continue_on_error: none,
    timeout_minutes: none
  }
}

// ONE INVOCATION OF OUR OWN BINARY. Everything the run decides -- which witnesses exist, what
// identity each has, which frame it needs, and whether the roster is admissible at all -- is
// decided in .dag by v2.workflow.required_floor. This step passes the two source roots and
// nothing else: there is no plan entry, no plan function, no batch id, no worker role and no
// selection flag, because the fold has no such concepts to configure.
fn witness_floor_run_script() -> String {
  concat(
    concat("ROOT=", concat(ci_repo_root_shell(), "\n")),
    concat(
      "\"$ROOT/target/release/claim_executor\" --required-floor",
      " --source-root \"$ROOT/dag\" --source-root \"$ROOT/src/v2\"\n"
    )
  )
}

fn witness_floor_run_step() -> Step {
  RunStep {
    name: Present { value: "All witnesses (one prepared subject, one fold)" },
    id: none,
    run: witness_floor_run_script(),
    shell: none,
    env: none,
    working_directory: none,
    if_condition: none,
    continue_on_error: none,
    timeout_minutes: none
  }
}

fn witness_floor_job() -> Job {
  Job {
    id: witness_floor_workflow_job_id,
    name: none,
    runner: gunbc_ci_runner_spec(),
    steps: [
      witness_floor_checkout_step(),
      witness_floor_toolchain_step(),
      witness_floor_build_step(),
      witness_floor_run_step()
    ],
    needs: [],
    env: none,
    outputs: none,
    if_condition: none,
    timeout_minutes: none,
    continue_on_error: none,
    concurrency: none,
    permissions: none
  }
}

data witness_floor_workflow: Workflow = {
  name: "witnesses",
  on: [
    WorkflowDispatch { inputs: [] },
    Push { branches: [gunbc_default_branch_name], paths: [] },
    PullRequest {
      branches: [gunbc_default_branch_name],
      types: [Opened, Synchronize, Reopened, ReadyForReview]
    }
  ],
  concurrency: Present {
    value: ConcurrencyMappingQueueNotMax {
      group: witness_floor_concurrency_group,
      cancel_in_progress: Present { value: CancelInProgressBool { value: true } },
      explicit_single: none
    }
  },
  env: Present {
    value: [kv(key: "CARGO_TERM_COLOR", value: yaml_string(s: "always"))]
  },
  permissions: Present {
    value: WorkflowPermissions {
      contents: Present { value: PermRead },
      pull_requests: none,
      issues: none,
      actions: none,
      id_token: none
    }
  },
  jobs: [witness_floor_job()]
}

fn expected_witness_floor_yml() -> String {
  serialize_yaml(v: project_workflow_to_yaml(workflow: witness_floor_workflow))
}
