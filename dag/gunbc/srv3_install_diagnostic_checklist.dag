module gunbc.srv3_install_diagnostic_checklist

import extdeps.shell
import gunbc.retained_shell_script { retained_runtime }
import extdeps.filesystem.filesystem_io { Filesystem }
import gunbc.shell_bash_runner { shell_printf_line }
import gunbc.srv3_os_install_diagnostic {
  srv3_os_install_attempt_intent,
  OsInstallAttemptIntent,
  srv3_install_diagnostic_observe_script_for_intent,
  Srv3InstallDebugObservation,
  Srv3InstallDiagnostic,
  NbdServeObservation,
  BmcWebsocketObservation,
  ServeUnknown,
  ServeObserved,
  WebsocketUpgradeAccepted,
  WebsocketUnavailable,
  WebsocketUnknown,
  diagnose_srv3_install,
  srv3_install_diagnostic_wire,
  srv3_install_diagnostic_recommended_action_wire,
  parse_srv3_install_debug_observation,
}
import gunbc.host_effect {
  Srv3InstallDiagnosticObserve,
  HostOs,
  host_effect_read_evidence,
  LocalShell,
  ShellEffectApplied,
  ConvergePlanApplied,
}
import gunbc.host_effect_realize { host_effect_apply }
import gunbc.os_install_actuator_selection { srv3_os_install_actuator_host }
import std.realization_reconcile {
  Reconciliation,
  Converged,
  NotConverged,
}
import std.process { ProcessExit, ExitSuccess, exit_failure }
import std.types { String }
import std.disposition { Disposition, Scaffold, RealizationDispatch }
import std.decl_ref { DeclarationRef, WholeDeclaration }

type Srv3InstallDiagnosticObserveOutcome
  = Srv3InstallDiagnosticObserved { stdout: String }
  | Srv3InstallDiagnosticObserveRefused { reason: String }

data srv3_install_diagnostic_checklist_receipt_echo_dissolution_trigger: Disposition = Scaffold {
  dissolves_to: RealizationDispatch,
  bind: DeclarationRef {
    module_path: "gunbc.srv3_install_diagnostic_checklist",
    decl_name: "srv3_install_diagnostic_checklist",
    field: WholeDeclaration,
  }
}

data srv3_install_diagnostic_checklist_scaffold: Disposition = Scaffold {
  dissolves_to: RealizationDispatch,
  bind: DeclarationRef {
    module_path: "gunbc.srv3_install_diagnostic_checklist",
    decl_name: "srv3_install_diagnostic_checklist_receipt_echo_dissolution_trigger",
    field: WholeDeclaration,
  }
}

data srv3_install_diagnostic_checklist_shell_runner_dissolution_trigger: String = "dissolved: observe path routes through host_effect_apply Srv3InstallDiagnosticObserve; receipt echo and observe-script oracle remain medium-as-string pending bash-emit (#5828)"

data srv3_install_diagnostic_observe_script_path: String = "/tmp/srv3_install_diagnostic_observe.sh"

func srv3_install_diagnostic_emit_observe_script() -> ProcessExit {
  let script = srv3_install_diagnostic_observe_script_for_intent(intent: srv3_os_install_attempt_intent)
  let write = Filesystem.Write(path: srv3_install_diagnostic_observe_script_path, content: script)
  if write.success {
    ExitSuccess
  } else {
    exit_failure(reason: concat("srv3-install-diagnostic-emit: write failed: ", write.error))
  }
}

fn srv3_install_diagnostic_observe_outcome(
  intent: OsInstallAttemptIntent,
) -> Srv3InstallDiagnosticObserveOutcome {
  let target = HostOs { node: srv3_os_install_actuator_host }
  match host_effect_apply(
    target: target,
    effect: Srv3InstallDiagnosticObserve {
      bmc: intent.bmc_endpoint,
      port: intent.serve_port,
      iso_path: intent.iso_path,
      iso_content_hash: intent.iso_content_hash,
    },
    evidence: host_effect_read_evidence,
    transport: LocalShell,
  ) {
    Converged { evidence: ShellEffectApplied { exit_code: _, stdout: out }, applied: _ } =>
      Srv3InstallDiagnosticObserved { stdout: out }
    Converged { evidence: ConvergePlanApplied { exit_code: _, stdout: _ }, applied: _ } =>
      Srv3InstallDiagnosticObserveRefused {
        reason: "srv3-install-diagnostic-observe: unexpected ConvergePlanApplied evidence for Srv3InstallDiagnosticObserve",
      }
    NotConverged { reason: why, applied: _ } =>
      Srv3InstallDiagnosticObserveRefused { reason: why }
  }
}

fn srv3_install_diagnostic_observe_stdout(
  intent: OsInstallAttemptIntent,
) -> String? {
  match srv3_install_diagnostic_observe_outcome(intent: intent) {
    Srv3InstallDiagnosticObserved { stdout: out } => Present { value: out }
    Srv3InstallDiagnosticObserveRefused { reason: _ } => none
  }
}

func srv3_install_diagnostic_checklist() -> ProcessExit {
  let intent = srv3_os_install_attempt_intent
  match srv3_install_diagnostic_observe_outcome(intent: intent) {
    Srv3InstallDiagnosticObserved { stdout } => {
      let observation = parse_srv3_install_debug_observation(
        stdout: stdout,
        intent: intent,
      )
      let verdict = diagnose_srv3_install(intent: intent, observation: observation)
      let receipt = srv3_install_diagnostic_receipt_line(verdict: verdict, observation: observation)
      let action = srv3_install_diagnostic_recommended_action_wire(verdict: verdict)
      let echo_body = concat(
        shell_printf_line(line: receipt),
        shell_printf_line(line: concat("Srv3InstallDiagnosticAction: ", action)),
      )
      let echo_run = shell.Exec.Run(script: retained_runtime(body: echo_body, reason: "srv3_install_diagnostic receipt + recommended-action printf echo"))
      if echo_run.success {
        ExitSuccess
      } else {
        exit_failure(reason: concat("srv3-install-diagnostic-receipt: ", echo_run.stderr))
      }
    }
    Srv3InstallDiagnosticObserveRefused { reason } =>
      exit_failure(reason: reason)
  }
}

fn srv3_install_diagnostic_receipt_line(
  verdict: Srv3InstallDiagnostic,
  observation: Srv3InstallDebugObservation,
) -> String {
  concat(
    concat("Srv3InstallDiagnosticReceipt: verdict=", srv3_install_diagnostic_wire(verdict: verdict)),
    concat(
      " serve=",
      concat(
        srv3_install_diagnostic_serve_observation_wire(observation: observation.actuator_serve),
        concat(
          " bmc_websocket=",
          srv3_install_diagnostic_websocket_wire(observation: observation.bmc_websocket),
        ),
      ),
    ),
  )
}

fn srv3_install_diagnostic_serve_observation_wire(observation: NbdServeObservation) -> String {
  match observation {
    ServeUnknown => "unknown"
    ServeObserved { process: _, port: _, session: _, iso: _ } => "observed"
  }
}

fn srv3_install_diagnostic_websocket_wire(observation: BmcWebsocketObservation) -> String {
  match observation {
    WebsocketUpgradeAccepted => "upgrade_accepted"
    WebsocketUnavailable => "unavailable"
    WebsocketUnknown => "unknown"
  }
}

fn srv3_install_diagnostic_checklist_entrypoint_is_declared() -> Bool {
  string_contains(s: srv3_install_diagnostic_checklist_shell_runner_dissolution_trigger, pattern: "Srv3InstallDiagnosticObserve")
}
