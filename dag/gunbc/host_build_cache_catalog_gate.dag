module gunbc.host_build_cache_catalog_gate

import std.cache_identity { CacheInterfaceId }
import std.types { NonEmptyStr }
import extdeps.cache.sccache { sccache_local_id }
import extdeps.cache.cache { cache_catalog }

data provision_build_cache_unknown_catalog_fixture: CacheInterfaceId = "gunbc-test-unknown-cache-interface-id"

fn catalog_id_is_known(catalog_id: CacheInterfaceId) -> Bool {
  fold(
    cache_catalog,
    init: false,
    f: (acc, row) => acc || row.identity == catalog_id,
  )
}

fn provision_build_cache_catalog_refusal_reason(catalog_id: CacheInterfaceId) -> NonEmptyStr? {
  if !catalog_id_is_known(catalog_id: catalog_id) {
    Present {
      value: concat("host_build_cache_provision: unknown catalog_id ", catalog_id) as NonEmptyStr,
    }
  } else if catalog_id != sccache_local_id {
    Present {
      value: concat(
        concat("host_build_cache_provision: catalog_id ", catalog_id),
        concat(" not yet realized; only ", sccache_local_id),
      ) as NonEmptyStr,
    }
  } else {
    none
  }
}
