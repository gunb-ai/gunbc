module gunbc.host_build_cache_catalog_gate


data provision_build_cache_unknown_catalog_fixture: std.cache_identity.CacheInterfaceId = "gunbc-test-unknown-cache-interface-id"

type ProvisionBuildCacheCatalogGateVerdict
  = ProvisionBuildCacheCatalogRealizable
  | ProvisionBuildCacheCatalogRefused { reason: std.types.NonEmptyStr }

fn catalog_id_is_known(catalog_id: std.cache_identity.CacheInterfaceId) -> Bool {
  fold(
    extdeps.cache.cache_catalog,
    init: false,
    f: (acc, row) => acc || row.identity == catalog_id,
  )
}

fn provision_build_cache_catalog_gate_verdict(
  catalog_id: std.cache_identity.CacheInterfaceId,
) -> ProvisionBuildCacheCatalogGateVerdict {
  if !catalog_id_is_known(catalog_id: catalog_id) {
    ProvisionBuildCacheCatalogRefused {
      reason: concat("host_build_cache_provision: unknown catalog_id ", catalog_id) as std.types.NonEmptyStr,
    }
  } else if catalog_id != extdeps.cache.sccache.sccache_local_id {
    ProvisionBuildCacheCatalogRefused {
      reason: concat(
        concat("host_build_cache_provision: catalog_id ", catalog_id),
        concat(" not yet realized; only ", extdeps.cache.sccache.sccache_local_id),
      ) as std.types.NonEmptyStr,
    }
  } else {
    ProvisionBuildCacheCatalogRealizable
  }
}
