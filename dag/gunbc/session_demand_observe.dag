  SessionDemandObservationUnavailable, SessionDemandPopulationIncomplete,
  NoConcurrentSessionDemandObserved, SessionDemandObserved,
}
import gunbc.oomd_install { session_membership_standing }

// THE MANAGED SET NEEDS NO NAMING AUTHORITY, and that is what makes this producer writable today.
// A child of the managed slice IS a managed session BY VIRTUE OF WHERE IT WAS FOUND -- the cgroup
// hierarchy is the classifier, so no docker-scope naming convention has to be invented to read it.
//
// The LEGACY side is the half that genuinely needs an attribution authority: a flat scope under
// system.slice may be an agent session container or an unrelated container, and this observation
// cannot tell them apart. Those become SessionPlacementUnclassifiable, which makes the census
// refuse rather than guess -- correct fail-closed behaviour, and on a fully-converged host the
// legacy set is empty so the census completes. Inventing a naming rule to make it complete on a
// mixed host would be exactly the fabrication this carrier exists to prevent.
data session_demand_legacy_attribution_note: String = "The legacy arm is deliberately unclassifiable rather than pattern-matched. A flat docker scope under system.slice cannot be attributed to an agent session from cgroup structure alone, and no authority in this repository models docker scope naming. Until one does, a host carrying flat scopes refuses its census instead of reporting a population it guessed."

data session_demand_collector_revision: NonEmptyStr = "session-demand-observe-v1"

fn system_slice_path() -> NonEmptyStr {
  cgroup_v2_child_path(parent: cgroup_v2_mount_point, child: "system.slice")
}

fn managed_slice_path() -> NonEmptyStr {
  cgroup_v2_slice_path(slice: gunbc_oomd_sessions_slice)
}

// AN EMPTY LISTING IS A COUNTED ZERO, NOT A FAILURE. The find returns success with empty stdout on
// a leaf cgroup -- verified by execution against a real one, which returned 0 children while a
// plain listing of the same directory returned 92 interface files. So success-with-no-lines must
// reach the caller as an observed empty population; treating it as unavailable would be the
// empty-observation narrow, and treating a FAILED read as empty would be worse.
// THE FILTER PRECEDES THE CAST (review 56218). It used to cast every split element to NonEmptyStr
// and filter empties AFTERWARDS, so an empty element -- a blank line anywhere in find's output --
// was cast to NonEmptyStr before anything removed it. That inverts construction-before-validation,
// and its current safety depends on the cast NOT being enforced: the ragged-input witness passes
// today precisely because the cast does not refuse "", which means this code was relying on a
// substrate gap and would have started KILLING THE OBSERVATION the day that wall landed.
// Filtering first makes the empty case unreachable at the cast rather than tolerated past it.
fn cgroup_child_names(stdout: String) -> List<NonEmptyStr> {
  map(
    filter(map(split(s: trim(stdout), delimiter: "\n"), l => trim(l)), l => l != ""),
    l => l as NonEmptyStr
  )
}

fn observe_cgroup_children(
  transport: HostEffectTransport,
  host: HostIdentity,
  cgroup_path: NonEmptyStr,
) -> SessionContainerInventory {
  match host_operation_exec(
    transport: transport,
    operation: CgroupListChildren { cgroup_path: cgroup_path },
  ) {
    HostOperationObserved { stdout: out, success: ok, stderr: _ } =>
      if ok {
        SessionContainerInventoryObserved { host: host, identities: cgroup_child_names(stdout: out) }
      } else {
        SessionContainerInventoryUnavailable {
          host: host,
          cause: concat("cgroup child enumeration exited unsuccessfully for ", cgroup_path as String),
        }
      }
    HostOperationRefused { operation: _, reason: why } =>
      SessionContainerInventoryUnavailable {
        host: host,
        cause: concat("cgroup child enumeration refused: ", why),
      }
  }
}

// A COUNTER THAT COULD NOT BE READ IS NOT A ZERO, AND IT IS NOT MALFORMED EITHER. This used to
// return a String and manufacture "<read failed: memory.current>" on failure, which the PARSER then
// classified as Unparseable -- a body this repository invented, occupying the arm reserved for
// bytes the kernel actually wrote. It now returns whether a body was obtained, and nothing
// downstream can confuse the two.
type CgroupInterfaceRead
  = CgroupInterfaceBody { body: String }
  | CgroupInterfaceReadFailed { cause: String }

fn read_interface_file(
  transport: HostEffectTransport,
  cgroup_path: NonEmptyStr,
  file: NonEmptyStr,
) -> CgroupInterfaceRead {
  match host_operation_exec(
    transport: transport,
    operation: CgroupReadInterfaceFile {
      file_path: cgroup_v2_child_path(parent: cgroup_path, child: file),
    },
  ) {
    HostOperationObserved { stdout: out, success: ok, stderr: _ } =>
      if ok {
        CgroupInterfaceBody { body: out }
      } else {
        CgroupInterfaceReadFailed {
          cause: concat("cat exited unsuccessfully for ", file as String),
        }
      }
    HostOperationRefused { operation: _, reason: why } =>
      CgroupInterfaceReadFailed { cause: why }
  }
}

// The two adapters that carry the read outcome into the observation carriers. A failed read
// becomes Unread with its cause; a body that WAS obtained is handed to the parse authority and
// keeps whatever that authority says about it, including the bytes the kernel really wrote when it
// is malformed.
fn observed_memory_count(r: CgroupInterfaceRead) -> ObservedMemoryCount {
  match r {
    CgroupInterfaceReadFailed { cause: why } => MemoryCountUnread { cause: why }
    CgroupInterfaceBody { body: b } =>
      match parse_cgroup_memory_count(body: b) {
        CgroupMemoryCount { bytes: n } => MemoryCountRead { bytes: n }
        CgroupMemoryCountUnparseable { body: raw } => MemoryCountMalformed { body: raw }
      }
  }
}

fn observed_memory_limit(r: CgroupInterfaceRead) -> ObservedMemoryLimit {
  match r {
    CgroupInterfaceReadFailed { cause: why } => MemoryLimitUnread { cause: why }
    CgroupInterfaceBody { body: b } =>
      match parse_cgroup_memory_limit(body: b) {
        CgroupMemoryLimited { bytes: n } => MemoryLimitRead { bytes: n }
        CgroupMemoryUnlimited => MemoryLimitUnlimited
        CgroupMemoryLimitUnparseable { body: raw } => MemoryLimitMalformed { body: raw }
      }
  }
}

fn observe_session_memory_demand(
  transport: HostEffectTransport,
  parent: NonEmptyStr,
  identity: NonEmptyStr,
) -> SessionMemoryDemand {
  let cgroup = cgroup_v2_child_path(parent: parent, child: identity)
  SessionMemoryDemand {
    identity: identity,
    cgroup: cgroup,
    memory_current: observed_memory_count(
      r: read_interface_file(
        transport: transport,
        cgroup_path: cgroup,
        file: cgroup_memory_interface_file_name(f: MemoryCurrent),
      )
    ),
  }
}

fn observe_parent_slice_demand(
  transport: HostEffectTransport,
  parent: NonEmptyStr,
) -> ParentSliceDemand {
  ParentSliceDemand {
    cgroup: parent,
    memory_current: observed_memory_count(
      r: read_interface_file(transport: transport, cgroup_path: parent, file: cgroup_memory_interface_file_name(f: MemoryCurrent))
    ),
    memory_peak: observed_memory_count(
      r: read_interface_file(transport: transport, cgroup_path: parent, file: cgroup_memory_interface_file_name(f: MemoryPeak))
    ),
    memory_peak_epoch: "cgroup lifetime since creation or last reset; this observation did not reset it and cannot bound it to its own window",
    memory_max: observed_memory_limit(
      r: read_interface_file(transport: transport, cgroup_path: parent, file: cgroup_memory_interface_file_name(f: MemoryMax))
    ),
  }
}

// THE FABRICATING PROJECTION IS DELETED RATHER THAN GUARDED (review 56217, and the reviewer is
// right). It answered `[]` for an inventory that COULD NOT BE READ, which is indistinguishable
// from an inventory that was read and found empty -- so a failed system.slice enumeration
// contributed no flat candidates, the census completed, and the entry reported AllSessionsManaged
// and exited SUCCESS while claiming an aggregate may be established over a host whose flat
// population was never observed. That is the empty-observation narrow in the one arm that GRANTS
// the aggregate, and it is strictly worse than the widen DESIGN already forbids.
//
// It is worth recording HOW it survived: the deleted function carried an annotation asserting that
// "the entry refuses on it separately". That was true of the managed arm and false of the legacy
// one, and the sentence bought exactly the reviewer confidence it had not earned. An annotation
// claiming a protection is worse than no annotation when the protection is partial.
//
// The repair is construction rather than a second check: there is now no expression that turns an
// unavailable inventory into a population at all, so the verdict and the exit status are derived
// from ONE value and cannot disagree about whether the population was established.
fn session_population(
  managed: SessionContainerInventory,
  legacy: SessionContainerInventory,
) -> SessionPopulation {
  match managed {
    SessionContainerInventoryUnavailable { host: _, cause: why } =>
      SessionPopulationUnavailable {
        cause: concat("the managed slice could not be enumerated: ", why),
      }
    SessionContainerInventoryObserved { host: _, identities: managed_ids } =>
      match legacy {
        SessionContainerInventoryUnavailable { host: _, cause: why } =>
          SessionPopulationUnavailable {
            cause: concat("system.slice could not be enumerated, so whether any session runs FLAT outside the managed slice is unknown; the managed count alone cannot establish the population: ", why),
          }
        SessionContainerInventoryObserved { host: _, identities: legacy_ids } =>
          SessionPopulationEstablished {
            placements: concat(
              managed_placements(identities: managed_ids),
              legacy_placements(identities: legacy_ids)
            )
          }
      }
  }
}

fn managed_placements(identities: List<NonEmptyStr>) -> List<SessionPlacement> {
  map(identities, i => ManagedSession {
    identity: i,
    cgroup: cgroup_v2_child_path(parent: managed_slice_path(), child: i),
  })
}

// NOT-A-SESSION AND UNCLASSIFIABLE ARE DIFFERENT STATES, and collapsing them is the
// not-applicable-rendered-as-malformed failure DESIGN names. system.slice is mostly ORDINARY
// SYSTEMD UNITS -- measured on srv1: 37 children, of which cron.service, containerd.service,
// systemd-networkd.service and the rest are not containers at all. Those are not in the session
// population and must not enter it; rendering cron.service as an unclassifiable SESSION would
// refuse the census of every converged host in the fleet, for a reason that has nothing to do
// with sessions.
//
// A candidate flat session is a docker scope. THIS NAMING IS OBSERVED, NOT INVENTED: the managed
// slice on srv1 holds 23 children and every one is docker-<64 hex>.scope, which is the receipt
// this branch took before asserting the convention. A docker scope found FLAT under system.slice
// is a candidate that cgroup structure still cannot attribute to an agent session, so it stays
// Unclassifiable and refuses the census -- which is the arm that matters, and which measured ZERO
// on srv1 because that host is fully converged.
fn cgroup_name_is_docker_scope(name: NonEmptyStr) -> Bool {
  starts_with(name as String, "docker-") && ends_with(name as String, ".scope")
}

fn flat_session_candidates(identities: List<NonEmptyStr>) -> List<NonEmptyStr> {
  filter(identities, i => cgroup_name_is_docker_scope(name: i))
}

fn legacy_placements(identities: List<NonEmptyStr>) -> List<SessionPlacement> {
  map(flat_session_candidates(identities: identities), i => SessionPlacementUnclassifiable {
    identity: i,
    cause: "flat docker scope under system.slice: it is a container rather than a systemd unit, but cgroup structure alone cannot attribute it to an agent session, so it refuses the census rather than being counted as either managed or legacy",
  })
}

// THE CI ENTRY. It runs on a runner PINNED to the target host, so LocalShell reads that host's own
// cgroups -- no ssh, no new credential surface, and no fleet key. Every read it performs is a
// find/cat against /sys/fs/cgroup; it mutates nothing.
data session_demand_observe_receipt_path: String = "target/session-demand-observe-receipt.txt"

// THE HOST IS OBSERVED, NOT SUPPLIED. Taking the host from the dispatch input would let the receipt
// name a machine it did not read; HostnameReadShort is already a modeled operation, so the receipt
// binds to the host that actually answered.
fn observed_host_identity(transport: HostEffectTransport) -> HostIdentity? {
  match host_operation_exec(transport: transport, operation: HostnameReadShort) {
    HostOperationObserved { stdout: out, success: ok, stderr: _ } =>
      if ok && trim(out) != "" { Present { value: trim(out) as HostIdentity } } else { none }
    HostOperationRefused { operation: _, reason: _ } => none
  }
}

fn count_value_word(v: ObservedMemoryCount) -> String {
  match v {
    MemoryCountRead { bytes: b } => to_string(byte_size_count(b: b))
    MemoryCountMalformed { body: raw } => concat("MALFORMED(", concat(trim(raw), ")"))
    MemoryCountUnread { cause: why } => concat("UNREAD(", concat(why, ")"))
  }
}

fn limit_value_word(v: ObservedMemoryLimit) -> String {
  match v {
    MemoryLimitRead { bytes: b } => to_string(byte_size_count(b: b))
    MemoryLimitUnlimited => "max"
    MemoryLimitMalformed { body: raw } => concat("MALFORMED(", concat(trim(raw), ")"))
    MemoryLimitUnread { cause: why } => concat("UNREAD(", concat(why, ")"))
  }
}

fn session_demand_line(d: SessionMemoryDemand) -> String {
  join(["session\t", d.identity as String, "\t", d.cgroup as String, "\t", count_value_word(v: d.memory_current), "\n"], "")
}

fn parent_slice_lines(p: ParentSliceDemand) -> String {
  join([
    "parent_slice\t", p.cgroup as String, "\n",
    "parent_memory_current\t", count_value_word(v: p.memory_current), "\n",
    "parent_memory_peak\t", count_value_word(v: p.memory_peak), "\n",
    "parent_memory_peak_epoch\t", p.memory_peak_epoch, "\n",
    "parent_memory_max\t", limit_value_word(v: p.memory_max), "\n",
  ], "")
}

// THE CLASSIFICATION IS EXERCISED, NOT JUST THE ENUMERATION. A receipt that printed rows and
// stopped would leave the census and the membership gate unexecuted on real hosts, so the one
// thing this cut claims -- that a COMPLETE observation can be established -- would rest on
// fixtures. Running it here makes a converged host and a mixed host produce visibly different
// verdicts from the same code path.
//
// COMPLETED IS STAMPED AFTER EVERY READ AND AFTER THE VERDICT, NOWHERE EARLIER (review 56218). It
// previously sat in the header, which is bound BEFORE the per-session memory.current reads, so the
// receipt named a completion time that did not bound the observation it described. The header is
// therefore assembled last; the ordering IS the guarantee, and it is not restated inside the body
// because DESIGN 4c admits annotations only at module-item grain.
//
// THE RECEIPT RECORDS WHAT WAS READ AND WHERE, INCLUDING THE EMPTY CASES. A host with no sessions
// emits a receipt with zero session rows and says so, which is a counted zero; a host whose
// enumeration refused emits the refusal cause instead. The two are different lines, never the same
// absence.
func session_demand_observe_ci_wet() -> ProcessExit {
  let transport = LocalShell
  let started = clock_now_probed_at_or_unknown()
  match observed_host_identity(transport: transport) {
    Absent =>
      exit_failure(reason: "session_demand_observe_ci_wet: could not read the host's own name, so no receipt can be bound to a host")
    Present { value: host } => {
      let managed_parent = managed_slice_path()
      let managed = observe_cgroup_children(transport: transport, host: host, cgroup_path: managed_parent)
      let legacy = observe_cgroup_children(transport: transport, host: host, cgroup_path: system_slice_path())
      let slice = observe_parent_slice_demand(transport: transport, parent: managed_parent)
      let managed_body = match managed {
        SessionContainerInventoryObserved { host: _, identities: ids } =>
          join([
            join(["managed_population\t", to_string(count(ids)), "\n"], ""),
            join(map(ids, i => session_demand_line(
              d: observe_session_memory_demand(transport: transport, parent: managed_parent, identity: i)
            )), ""),
          ], "")
        SessionContainerInventoryUnavailable { host: _, cause: why } =>
          join(["managed_population\tUNAVAILABLE\t", why, "\n"], "")
      }
      let legacy_body = match legacy {
        SessionContainerInventoryObserved { host: _, identities: ids } =>
          join([
            join(["system_slice_children\t", to_string(count(ids)), "\n"], ""),
            join(map(ids, i => join(["system_slice_child\t", i as String, "\n"], "")), ""),
          ], "")
        SessionContainerInventoryUnavailable { host: _, cause: why } =>
          join(["system_slice_children\tUNAVAILABLE\t", why, "\n"], "")
      }
      let population = session_population(managed: managed, legacy: legacy)
      let verdict = match population {
        SessionPopulationUnavailable { cause: why } =>
          join(["census\tUNAVAILABLE\t", why, "\n"], "")
        SessionPopulationEstablished { placements: placements } =>
          match session_placement_census(placements: placements) {
            SessionPlacementCensusIncomplete { unclassifiable: us } =>
              join(["census\tINCOMPLETE\t", to_string(count(us)), " unattributable flat docker scope(s); no aggregate may be established over this host\n"], "")
            SessionPlacementCensusComplete { placements: ps } =>
              match census_membership_signal(c: session_placement_census(placements: placements)) {
                Absent => "census\tCOMPLETE\tbut no membership signal could be projected\n"
                Present { value: sig } =>
                  match session_demand_membership_gate(host: host, m: session_membership_standing(m: sig)) {
                    MembershipAdmitsAggregate { managed_count: _ } =>
                      join(["census\tCOMPLETE\tAllSessionsManaged over ", to_string(count(ps)), " session(s); an aggregate may be established\n"], "")
                    MembershipRefusesAggregate { observation: o } => match o {
                      SessionDemandPopulationIncomplete { host: _, membership: _, cause: why } =>
                        join(["census\tCOMPLETE\tbut membership refuses the aggregate: ", why, "\n"], "")
                      NoConcurrentSessionDemandObserved { host: _ } =>
                        "census\tCOMPLETE\tNoConcurrentSessionDemandObserved: the read ran and counted zero sessions\n"
                      SessionDemandObservationUnavailable { host: _, cause: why } =>
                        join(["census\tUNAVAILABLE\t", why, "\n"], "")
                      SessionDemandObserved { receipt: _ } => "census\tOBSERVED\n"
                    }
                  }
              }
          }
      }
      let header = join([
        "collector\t", session_demand_collector_revision as String, "\n",
        "host\t", host as String, "\n",
        "observation_started\t", started as String, "\n",
        "observation_completed\t", clock_now_probed_at_or_unknown() as String, "\n",
      ], "")
      let body = join([header, parent_slice_lines(p: slice), managed_body, legacy_body, verdict], "")
      let w = Filesystem.Write(path: session_demand_observe_receipt_path, content: body)
      if w.success == false {
        exit_failure(reason: join(["session-demand receipt write failed: ", w.error], ""))
      } else {
        match population {
          SessionPopulationUnavailable { cause: why } =>
            exit_failure(reason: join(["session_demand_observe_ci_wet: no population was established, so nothing here may be read as an observation of this host: ", why, "\n", body], ""))
          SessionPopulationEstablished { placements: _ } => ExitSuccess
        }
      }
    }
  }
}
