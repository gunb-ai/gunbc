]

fn registration_membership_is_standard(r: RosterRegistration) -> Bool {
  match r.membership {
    ByContainment => true
    ByDerivation { predicate: _ } => true
    DeclaredFrontier { reason: reason, dissolution: d } =>
      !(reason == "") && !(std.dissolution.dissolution_description(condition: d) == "")
  }
}
