  RosterRegistration {
    roster: roster_decl(module_path: "v2.workflow.ci_floor_plan", decl_name: "gunbc_ci_cheap_floor_gate_membership"),
    unit_kind: "cheap-floor gate",
    membership: DeclaredFrontier {
      reason: "explicit cheap-batch gate membership, deliberately NOT inferred from gate profile fields so enrollment changes are counted roster edits rather than silent drift (the carrier's own membership note); these gates also serve as floor_resource_anchor nodes whose batch-0 placement avoids a scheduler deadlock, so membership carries a structural obligation beyond cost. The carrier already declares Disposition Scaffold dissolves_to SingleAuthority, and this row is that declaration made countable at the registry grain",
      dissolution: std.dissolution.unbound_dissolution(description: "per-gate cost attribution lands and membership derives from measurement rather than assertion (the carrier's own declared trigger); then the literal list and this row delete")
    }
  },
  RosterRegistration {
