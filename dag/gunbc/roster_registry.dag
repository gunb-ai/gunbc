      dissolve_on: "per entry: the owning lane greens the witness locally and the entry deletes (greening is a counted un-quarantine event)"
    }
  },
  RosterRegistration {
    roster: roster_decl(module_path: "gunbc.ci_layer_roots", decl_name: "resolution_divergence_census_roster_excluded_module_prefixes"),
