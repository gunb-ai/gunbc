      dissolve_on: "the meta-exec heavy-sequestration milestone lands (module-isolated bottom transport or symbol-level import visibility); rows delete as their sites migrate"
    }
  },
  RosterRegistration {
    roster: roster_decl(module_path: "v2.lens.realization_vocabulary_containment", decl_name: "realization_vocab_exception_roster"),
