fn registration_membership_is_standard(r: RosterRegistration) -> Bool {
  match r.membership {
    ByContainment => true
    ByDerivation { predicate: _ } => true
    DeclaredFrontier { reason: reason, dissolve_on: dissolve_on } =>
      !(reason == "") && !(dissolve_on == "")
  }
}
