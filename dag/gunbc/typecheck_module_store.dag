module gunbc.typecheck_module_store

// THE TYPECHECK MODULE STORE SESSION: the admitted consumer of
// extdeps.realization.materialization_store_local local_store_held_session.
// Inhabitance is n_commits_under_one_held_session_acquire_the_hold_once_by_real_execution.
// Production cutover trigger: the typecheck compile driver that still brackets each write
// through local_store_commit switches those writes to typecheck_module_store_session.
// This module is the seal's inhabitant, not a second store.

import std.cache_identity { ArtifactKindId }
import extdeps.realization.materialization_store_local {
  LocalStoreCapability, LocalStoreFamilyHeld, LocalStoreBracket,
  local_store_held_session,
}

fn typecheck_module_store_session<T>(capability: LocalStoreCapability, family: ArtifactKindId, run: fn(LocalStoreFamilyHeld) -> T) -> LocalStoreBracket<T> {
  local_store_held_session(capability: capability, family: family, run: run)
}
