module gunbc.typecheck_module_store

// THE TYPECHECK MODULE STORE SESSION: the admitted consumer of
// extdeps.realization.materialization_store_local local_store_held_session.
// neat-carp-75 (C2) will drive lookups and commits through this fold. This
// module is the seal's inhabitant, not a second store.

import std.types { List }
import std.cache_identity { ArtifactKindId }
import std.materialization_provider { ArtifactRequest }
import std.materialization_object { ArtifactPayload, StoreLookup }
import extdeps.realization.materialization_store_local {
  LocalStoreCapability, LocalStoreFamilyHeld, LocalStoreBracket, LocalStoreCommit,
  LocalStoreStagedPart,
  local_store_held_session, local_store_commit_under, local_store_lookup,
}

fn typecheck_module_store_session<T>(capability: LocalStoreCapability, family: ArtifactKindId, run: fn(LocalStoreFamilyHeld) -> T) -> LocalStoreBracket<T> {
  local_store_held_session(capability: capability, family: family, run: run)
}

fn typecheck_module_store_lookup(capability: LocalStoreCapability, req: ArtifactRequest) -> StoreLookup {
  local_store_lookup(capability: capability, req: req)
}

fn typecheck_module_store_commit_under(
  held: LocalStoreFamilyHeld,
  req: ArtifactRequest,
  payloads: List<ArtifactPayload>,
  parts: List<LocalStoreStagedPart>
) -> LocalStoreCommit {
  local_store_commit_under(held: held, req: req, payloads: payloads, parts: parts)
}
