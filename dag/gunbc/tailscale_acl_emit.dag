module gunbc.tailscale_acl_emit

import std.types { NonEmptyStr, List }
import extdeps.languages.json.emit {
  JsonValue, JsonKeyValue,
  serialize_json,
  json_string,
  json_array,
  json_object,
  json_kv,
}
import extdeps.tailscale.acl {
  TailscaleGrant,
  TailscaleSshRule,
  TailscaleNodeAttr,
  TailscaleTagOwnerRow,
  TailscaleAclSelector,
  TailscaleAclPolicy,
  render_tailscale_acl_selector,
  operator_tailscale_acl_policy,
}

fn selector_array_json(items: List<TailscaleAclSelector>) -> JsonValue {
  json_array(elements: items |> map(s => json_string(s: render_tailscale_acl_selector(s: s))))
}

fn string_array_json(items: List<NonEmptyStr>) -> JsonValue {
  json_array(elements: items |> map(s => json_string(s: s)))
}

fn grant_json(g: TailscaleGrant) -> JsonValue {
  json_object(members: [
    json_kv(key: "src", value: selector_array_json(items: g.src)),
    json_kv(key: "dst", value: selector_array_json(items: g.dst)),
    json_kv(key: "ip", value: selector_array_json(items: g.ip)),
  ])
}

fn ssh_rule_json(r: TailscaleSshRule) -> JsonValue {
  json_object(members: [
    json_kv(key: "action", value: json_string(s: r.action)),
    json_kv(key: "src", value: selector_array_json(items: r.src)),
    json_kv(key: "dst", value: selector_array_json(items: r.dst)),
    json_kv(key: "users", value: selector_array_json(items: r.users)),
  ])
}

fn node_attr_json(n: TailscaleNodeAttr) -> JsonValue {
  json_object(members: [
    json_kv(key: "target", value: string_array_json(items: n.target)),
    json_kv(key: "attr", value: string_array_json(items: n.attr)),
  ])
}

fn tag_owner_json(row: TailscaleTagOwnerRow) -> JsonKeyValue {
  json_kv(key: row.tag, value: string_array_json(items: row.owners))
}

fn tailscale_acl_policy_json(policy: TailscaleAclPolicy) -> JsonValue {
  json_object(members: [
    json_kv(key: "grants", value: json_array(elements: policy.grants |> map(g => grant_json(g: g)))),
    json_kv(key: "ssh", value: json_array(elements: policy.ssh |> map(r => ssh_rule_json(r: r)))),
    json_kv(key: "nodeAttrs", value: json_array(elements: policy.node_attrs |> map(n => node_attr_json(n: n)))),
    json_kv(key: "tagOwners", value: json_object(members: policy.tag_owners |> map(row => tag_owner_json(row: row)))),
  ])
}

fn expected_tailscale_acl_json() -> String {
  concat(serialize_json(v: tailscale_acl_policy_json(policy: operator_tailscale_acl_policy)), "\n")
}
