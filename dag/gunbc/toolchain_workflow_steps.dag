module gunbc.toolchain_workflow_steps

// THE ONE STEP VOCABULARY EVERY WORKFLOW THAT INSTALLS A RUST TOOLCHAIN NEEDS, AND NOTHING ELSE.
//
// This module exists because a shared $HOME took the fleet down. Each host runs many runner slots
// under one /home/ghrunner, and every job began by installing rustup into it, so one slot's
// install rewrote a toolchain another slot was executing: rustfmt refused with ETXTBSY on srv4-11
// and srv3-11 seven minutes apart, and srv1-15 resolved rustc while cargo had vanished. The
// repository already contained the construction that prevents this -- per-job HOME, CARGO_HOME and
// RUSTUP_HOME under RUNNER_TEMP -- but it was reachable only from the fleet-converge prelude.
//
// WHY A THIRD MODULE RATHER THAN AN IMPORT BETWEEN THE TWO THAT NEED IT. gunbc.fleet_workflow_steps
// is a cross-job artifact-transfer vocabulary; gunbc.witness_floor_workflow is one cargo invocation
// with no handoff. Making the witness workflow import the fleet prelude to reach one concept would
// borrow an architecture it does not have, which is the reason those two were kept apart in the
// first place. Duplicating the shell strings into the witness module would be the DESIGN 3
// nicknaming violation. The concept that is genuinely common is narrower than either module: where
// an external toolchain gets installed.
//
// WHAT IS DELIBERATELY NOT HERE. MAKEFLAGS, CARGO_BUILD_JOBS and the sccache binding rode in the
// same fleet step and are fleet-build TUNING, not toolchain-home isolation. CARGO_BUILD_JOBS in
// particular derives from the selected runner target's RAM-speed budget, so a consumer that
// imported it would inherit a number computed for a different subject. They stay in
// v2.workflow.ci_workflow_run_emit ci_fleet_build_tuning_steps, composed by the fleet prelude.

import extdeps.github.actions { Step, RunStep }
import v2.workflow.ci_workflow_run_emit {
  ci_toolchain_home_isolation_script,
  ci_pin_rustup_default_script,
}
import v2.std.optional { Present }

// THE STEP NAME IS NOT "Isolate toolchain dirs". That name is load-bearing elsewhere --
// gunbc.ci_materialization ci_cost_floor_exempt_step_names_note keys the cost-floor exempt roster
// BY STEP NAME against the live workflow -- so reusing it here would silently enrol a second,
// differently-scoped script under an existing acceptance. A distinct name keeps the two decidable
// apart at the gate.
fn toolchain_home_isolation_step() -> Step {
  RunStep {
    name: Present { value: "Isolate toolchain homes" },
    id: none,
    run: ci_toolchain_home_isolation_script(),
    shell: none,
    env: none,
    working_directory: none,
    if_condition: none,
    continue_on_error: none,
    timeout_minutes: none
  }
}

// PINNING IS PART OF ISOLATING, NOT A SEPARATE COURTESY. An isolated RUSTUP_HOME starts with no
// default toolchain -- the step's own name has said so since fleet-converge hit it -- so a consumer
// that isolates without pinning has traded a race for a missing default. The two travel together,
// which is why this constructor moved here from gunbc.fleet_workflow_steps rather than being
// copied: name and script are unchanged, so fleet-converge.yml does not move a byte, and there is
// exactly one definition of the step for both consumers.
fn toolchain_pin_rustup_default_step() -> Step {
  RunStep {
    name: Present { value: "Pin rustup default (isolated RUSTUP_HOME has no default toolchain)" },
    id: none,
    run: ci_pin_rustup_default_script(),
    shell: none,
    env: none,
    working_directory: none,
    if_condition: none,
    continue_on_error: none,
    timeout_minutes: none
  }
}

// THE HOSTILE CONTROL MUST NOT COOPERATE WITH THE ISOLATED READERS. Two private readers alone
// also pass under #9281's superseded PATH/snapshot protocol, so they discriminate nothing. This
// script runs two readers from private homes while a third actor repeatedly unlinks and reinstalls
// a dispatcher in a legacy shared-home fixture. The readers never consult that directory and must
// finish unaffected. Both unlink/rename-shaped ENOENT and in-place-write-shaped ETXTBSY incidents
// are covered by the same fact: the mutable directory is no longer shared.
//
// RUNNER_TEMP is GitHub's job-scoped temporary directory and is emptied at the beginning and end
// of each job. That upstream lifecycle is why a rerun receives a different mutable home without a
// hand-authored run-id/attempt/job suffix, and why this fixture cannot accumulate on the host.
fn hostile_legacy_writer_discriminator_script() -> String {
  join([
    "set -eu\n",
    "LEGACY_HOME=\"$RUNNER_TEMP/legacy-shared-toolchain\"\n",
    "PRIVATE_A=\"$RUNNER_TEMP/private-toolchain-a\"\n",
    "PRIVATE_B=\"$RUNNER_TEMP/private-toolchain-b\"\n",
    "mkdir -p \"$LEGACY_HOME/bin\" \"$PRIVATE_A/bin\" \"$PRIVATE_B/bin\"\n",
    "cp \"$CARGO_HOME/bin/rustup\" \"$PRIVATE_A/bin/rustup\"\n",
    "cp \"$CARGO_HOME/bin/rustup\" \"$PRIVATE_B/bin/rustup\"\n",
    "( i=0; while [ \"$i\" -lt 64 ]; do \"$PRIVATE_A/bin/rustup\" --version >/dev/null; i=$((i + 1)); done ) & A_PID=$!\n",
    "( i=0; while [ \"$i\" -lt 64 ]; do \"$PRIVATE_B/bin/rustup\" --version >/dev/null; i=$((i + 1)); done ) & B_PID=$!\n",
    "( i=0; while [ \"$i\" -lt 64 ]; do rm -f \"$LEGACY_HOME/bin/rustup\"; cp \"$CARGO_HOME/bin/rustup\" \"$LEGACY_HOME/bin/rustup\"; i=$((i + 1)); done ) & C_PID=$!\n",
    "wait \"$A_PID\"\nwait \"$B_PID\"\nwait \"$C_PID\"\n",
  ], "")
}

fn hostile_legacy_writer_discriminator_step() -> Step {
  RunStep {
    name: Present { value: "Hostile legacy shared-home writer discriminator" },
    id: none,
    run: hostile_legacy_writer_discriminator_script(),
    shell: none,
    env: none,
    working_directory: none,
    if_condition: none,
    continue_on_error: none,
    timeout_minutes: none
  }
}
