    DeclarationRef { module_path: "v1_compiler.cli_run.demand_acquire", decl_name: "module_graph_facts_from_acquired", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.cli_run.demand_acquire", decl_name: "tests", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.cli_run.demand_acquire.tests", decl_name: "FIXTURE", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.cli_run.demand_acquire.tests", decl_name: "repo_root", field: WholeDeclaration },
