    DeclarationRef { module_path: "v1_compiler.cli_run.demand_acquire.tests", decl_name: "demand_matches_whole_tree_resolve_on_selected_entries", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.cli_run.source_layout_lookup", decl_name: "module_storage_relative", field: WholeDeclaration },
