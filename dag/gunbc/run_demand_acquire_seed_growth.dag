module gunbc.run_demand_acquire_seed_growth

import gunbc.roadmap.roadmap_model { RoadmapNodeId }
import gunbc.seed_growth { SeedGrowthJustification }
import std.decl_ref { DeclarationRef, WholeDeclaration }

// Ctrl receipt (review 80383) for the hand-Rust that makes plain `gunbc run` acquire an
// entry through gunbc.source_layout instead of tokenizing every --source-root file.
// Dissolution is the native compiler owning that lookup (v2.compiler.source_authority
// module_file / v2.compiler.module_acquisition), not a smaller seed rewrite of the same walk.
data run_demand_acquire_seed_growth_justification: SeedGrowthJustification = SeedGrowthJustification {
  hand_authored_declarations: [
    DeclarationRef { module_path: "v1_compiler.cli_run.demand_acquire", decl_name: "resolve_entry_graph_demand_acquired", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.cli_run.demand_acquire", decl_name: "build_demand_acquired_index", field: WholeDeclaration },
