    DeclarationRef { module_path: "v1_compiler.cli_run.source_layout_lookup.tests", decl_name: "v2_namespace_alone_has_no_file", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.cli_run.source_layout_lookup.tests", decl_name: "layout_tree_directory_literals_match_policy_source", field: WholeDeclaration },
