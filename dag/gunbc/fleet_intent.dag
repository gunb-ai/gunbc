module gunbc.fleet_intent

type IsolationBoundary = SharedHostHome | PerJobFilesystem | ContainerHermetic | Vm
type ContainerRuntime = Docker | Podman | Gvisor | Ubicloud | GcloudRun

type WorkUnitId = std.types.NonEmptyStr where brand("WorkUnitId")

type ProviderIdentity = std.types.NonEmptyStr where brand("ProviderIdentity")

type MemoryDevice {
  capacity: std.measure.ByteSize
  memory_kind: extdeps.memory.types.MemoryKind
  bandwidth: std.measure.Bandwidth?
}

type StorageMount {
  mount_path: std.types.NonEmptyStr
  device: extdeps.storage.types.StorageDevice
  lifecycle: extdeps.storage.types.PersistenceKind
}

type ProcessorKind
  = CpuProcessor { cpu: extdeps.cpu.types.CpuFacts }
  | GpuProcessor { gpu: extdeps.gpu.types.GpuFacts }
  | AcceleratorProcessor { accelerator: extdeps.gpu.types.AcceleratorFacts }

type ExecutionSurface {
  os: std.os.types.OperatingSystemSurface
  isolation: IsolationBoundary
  container_runtime: ContainerRuntime?
  toolchains: List<extdeps.toolchain.types.ToolchainCapability>
  mounted_storage: List<StorageMount>
  network: List<product.network_topology.NetworkInterface>
}

type ComputeHost {
  identity: product.placement_supply.HostIdentity
  baseboard: extdeps.boards.types.ServerBaseboard?
  bmc_intent: gunbc.bmc_intent.BmcControlPlaneIntent?
  processors: List<ProcessorKind>
  memory: List<MemoryDevice>
  storage: List<extdeps.storage.types.StorageDevice>
  network_interfaces: List<product.network_topology.NetworkInterface>
}

fn compute_host_primary_cpu(host: ComputeHost) -> extdeps.cpu.types.CpuFacts? {
  match host.processors.first() {
    Absent => none
    Present { value: kind } =>
      match kind {
        CpuProcessor { cpu: c } => Present { value: c }
        GpuProcessor { gpu: _ } => none
        AcceleratorProcessor { accelerator: _ } => none
      }
  }
}

fn compute_host_ram_bytes_total(host: ComputeHost) -> std.measure.ByteSize {
  std.measure.byte_size(
    host.memory
      |> fold(
        init: 0,
        f: (acc, dev) => acc + std.measure.byte_size_count(dev.capacity),
      ),
  )
}

fn memory_devices_from_population(pop: extdeps.memory.types.HostMemoryPopulation) -> List<MemoryDevice> {
  pop.rows
    |> map(
      row =>
        MemoryDevice {
          capacity: extdeps.memory.memory_population_row_bytes(row: row),
          memory_kind: extdeps.memory.types.Dram,
          bandwidth: none,
        }
    )
}

type MeasurementConfidence
  = SingleSample
  | Range { low: std.float.Float, high: std.float.Float }
  | DistributionSummary { mean: std.float.Float, variance: std.float.Float }

type PerformanceReceipt {
  provider: ProviderIdentity
  work_shape: WorkUnitId
  cost: std.realization_schedule.CostAccount<std.measure.Nano>
  cpu_seconds: std.float.Float?
  sample_count: Int
  measurement_context: ExecutionSurface
  confidence: MeasurementConfidence
  cache_state_summary: std.types.NonEmptyStr?
}

data host_v1_interpreter_provider: ProviderIdentity = "host:v1-interpreter"

data host_v1_interpreter_execution_surface: ExecutionSurface = ExecutionSurface {
  os: std.os.types.OperatingSystemSurface {
    kernel: std.os.types.Linux,
    distro_or_product: none,
    version: none,
    filesystem_semantics: std.os.types.Posix,
    process_semantics: std.os.types.PosixProcess,
  },
  isolation: SharedHostHome,
  container_runtime: none,
  toolchains: [],
  mounted_storage: [],
  network: [],
}

fn performance_receipt_host_single_sample(
  work_shape: WorkUnitId,
  wall_time: std.measure.Nanosecond,
  space: std.measure.ByteSize,
) -> PerformanceReceipt {
  PerformanceReceipt {
    provider: host_v1_interpreter_provider,
    work_shape: work_shape,
    cost: std.realization_measurement.cost_account_measured_from_time_and_space(time: wall_time, space: space),
    cpu_seconds: none,
    sample_count: 1,
    measurement_context: host_v1_interpreter_execution_surface,
    confidence: SingleSample,
    cache_state_summary: none,
  }
}

fn performance_receipts_total_time(receipts: List<PerformanceReceipt>) -> std.measure.Nanosecond {
  std.measure.nanosecond(
    count: fold(
      receipts,
      init: 0,
      f: (acc, receipt) => acc + std.measure.measure_count(m: receipt.cost.time)
    )
  )
}

fn cost_account_from_performance_receipts(receipts: List<PerformanceReceipt>) -> std.realization_schedule.CostAccount<std.measure.Nano> {
  std.realization_measurement.cost_account_measured_from_time_and_space(
    time: performance_receipts_total_time(receipts: receipts),
    space: std.realization_measurement.space_measure_list_seq(spaces: map(receipts, receipt => receipt.cost.space))
  )
}

data fleet_intent_cpu: extdeps.cpu.types.CpuFacts = extdeps.cpu.types.CpuFacts {
  catalog: extdeps.cpu.ampere.altra_max_m12830_catalog,
  deployment: extdeps.cpu.types.CpuDeploymentFacts { sustained_per_thread_hz: std.measure.hertz(3000000000) },
}

data fleet_intent_os_surface: std.os.types.OperatingSystemSurface = std.os.types.OperatingSystemSurface {
