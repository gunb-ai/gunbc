type FleetHostMemoryPopulationDeferral {
  host: HostIdentity
  bmc_host: NonEmptyStr
  cause: NonEmptyStr
  dissolution_trigger: NonEmptyStr
}

data srv4_memory_population_deferral: FleetHostMemoryPopulationDeferral = FleetHostMemoryPopulationDeferral {
  host: operator_host_srv4,
  bmc_host: "192.168.1.195",
  cause: "per-DIMM Redfish observation not yet taken: srv4 BMC credential is rotated and stored (bmc-srv4-admin) but this session has no reach-secrets path to authenticate the read (fleet_subsumption_manual_gaps A2)",
  dissolution_trigger: "authenticated read of 192.168.1.195 /redfish/v1/Systems/system/Memory — cite srv4_memory_population rows against the sk_hynix catalog (decode part numbers, never assume srv1's uniform AFR4N population), replace srv4_host.memory literal with memory_devices_from_population(pop: srv4_memory_population), and retire this deferral exactly as srv1/srv2's were at their 2026-07-16 observations (fleet_host_memory_nominal_vs_usable_note governs the usable-vs-nominal split)",
}

data srv4_memory_population_deferral_disposition: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.fleet_intent",
    decl_name: "srv4_memory_population",
    field: WholeDeclaration,
  },
}

data srv4_host: ComputeHost = ComputeHost {
  identity: operator_host_srv4,
  baseboard: Present { value: srv4_baseboard },
  processors: [CpuProcessor { cpu: fleet_intent_cpu }],
  memory: [MemoryDevice { capacity: gibibyte_to_byte_size(g: gibibyte(128)), memory_kind: Dram, bandwidth: none }],
  storage: [srv4_nvme0],
  network_interfaces: [],
}

data fleet_intent_known_hosts: List<ComputeHost> = [srv1_host, srv2_host, srv3_host, srv4_host]

fn fleet_intent_execution_surface() -> ExecutionSurface {
  ExecutionSurface {
    os: fleet_intent_os_surface,
    isolation: PerJobFilesystem,
    container_runtime: Present { value: Docker },
    toolchains: [sccache_toolchain_capability],
    mounted_storage: [],
    network: [],
  }
}

