module gunbc.host_disk_observation


data host_disk_observation_authority_disposition: std.disposition.Disposition = std.disposition.SingleAuthority

// DISK FREE SPACE IS AN OBSERVATION AXIS, not a hand-authored width cap.
// gunbc.runner_slot_allocation.host_disk_admitted_width admits width only for srv4 from a deploy row;
// srv1–srv3 carry DiskWidthUnconstrained because nobody measured them. This module owns the PRODUCER
// that will return typed free-space observations through shell transport; until it lands,
// host_disk_observed_producer returns DiskUnobserved with a located reason — never fabricated df output.

type HostDiskObservation
  = DiskObserved { free_bytes: std.measure.ByteSize, observed_on: std.types.NonEmptyStr }
  | DiskObservationRefused { detail: std.types.NonEmptyStr }
  | DiskUnobserved { reason: String }

fn host_disk_observed_producer(host: product.placement_supply.HostIdentity) -> HostDiskObservation {
  match gunbc.fleet_shell_transport_observation.fleet_shell_transport_observation(host: host) {
    gunbc.fleet_shell_transport_observation.ShellTransportSucceeded { observed_on: _, principal: _, detail: _ } =>
      DiskUnobserved {
        reason: "shell transport available but df/free-space read has no host_effect producer yet; dissolve-on HostEffectTransport",
      }
    gunbc.fleet_shell_transport_observation.ShellTransportReachRefused { observed_on: _, principal: _, detail: d, gap: _ } =>
      DiskUnobserved {
        reason: concat("disk observation refused: shell transport failed: ", d as String),
      }
    gunbc.fleet_shell_transport_observation.ShellTransportUnobserved { reason: r } =>
      DiskUnobserved { reason: concat("disk observation unobserved: ", r) }
  }
}

fn host_disk_observation(host: product.placement_supply.HostIdentity) -> HostDiskObservation {
  host_disk_observed_producer(host: host)
}

data host_disk_observed_producer_dissolve_on: std.disposition.Disposition = std.disposition.Scaffold {
  dissolves_to: std.disposition.SingleAuthority,
  bind: std.decl_ref.DeclarationRef {
    module_path: "gunbc.host_effect",
    decl_name: "HostEffectTransport",
    field: std.decl_ref.WholeDeclaration,
  }
}
