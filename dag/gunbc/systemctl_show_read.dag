module gunbc.systemctl_show_read



data systemctl_show_property_capture_note: String = "The read answers a two-armed capture, never a bare String?: an argv materialization that REFUSES is a typed, located fact about the declaration, and collapsing it into the same `none` that means empty stdout, a failed exec, or an unsupported transport is the state-space conflation DESIGN 5 names (review 42946). Every non-value arm carries WHY, mirroring gunbc.systemctl_status_read's UnitStatusCapture."

type SystemdPropertyCapture =
    SystemdPropertyCaptured { value: String }
  | SystemdPropertyCaptureRefused { reason: String }

fn systemctl_show_property_value_from_stdout(success: Bool, stdout: String) -> SystemdPropertyCapture {
  if success {
    let trimmed = trim(stdout)
    if trimmed == "" {
      SystemdPropertyCaptureRefused { reason: "systemctl show returned empty stdout" }
    } else {
      SystemdPropertyCaptured { value: trimmed }
    }
  } else {
    SystemdPropertyCaptureRefused { reason: "systemctl show exited unsuccessfully" }
  }
}

// One dispatch, in the realization layer. See gunbc.systemctl_is_active_read for the same shape
// commented in full.
fn systemctl_show_property_read(
  transport: gunbc.host_effect.HostEffectTransport,
  unit: std.types.NonEmptyStr,
  property: extdeps.systemd.SystemdUnitProperty,
) -> SystemdPropertyCapture {
  match host_operation_exec(
    transport: transport,
    operation: SystemctlShowProperty { unit: unit, property: property },
  ) {
    HostOperationObserved { stdout: out, success: ok, stderr: _ } =>
      systemctl_show_property_value_from_stdout(success: ok, stdout: out)
    HostOperationRefused { operation: _, reason: why } =>
      SystemdPropertyCaptureRefused { reason: why }
  }
}

fn systemctl_show_property_operation_argv_matches_transport(
  unit: std.types.NonEmptyStr,
  property: extdeps.systemd.SystemdUnitProperty,
) -> Bool {
  let authority = systemctl_show_property_argv(unit: unit, property: property)
  match host_operation_materialize_argv(operation: SystemctlShowProperty { unit: unit, property: property }) {
    ArgvMaterialized { argv: materialized } => join(materialized, " ") == join(authority, " ")
    ArgvMaterializationRefused { at: _, cause: _ } => false
  }
}

// THE LOAD-STATE READ IS A SIBLING OF THE PROPERTY READ, NOT A SPECIAL CASE OF IT. It shares the
// capture type because the shape of the answer is identical -- one `--value` line, or a located
// refusal -- but it cannot share the operation: extdeps.systemd.systemctl's own annotation records
// that SystemdUnitProperty is numeric cgroup evidence with one numeric mock, and `not-found` is not
// a magnitude. Sharing the operation would have meant widening that coproduct with a member whose
// mock lies about every other member's shape.
//
// WHY A CONSUMER NEEDS IT AT ALL: `systemctl show <unit> --property=MemoryMax --value` answers
// `infinity` for a unit the manager has never heard of, exactly as it does for a loaded unit with no
// ceiling. Reading only the limits therefore cannot tell an ABSENT slice from an UNBOUNDED one --
// two states whose remedies are opposite (install it vs refuse and report the drift). LoadState is
// the discriminator, so it is read first and the limits are read only under a loaded unit.
fn systemctl_show_load_state_operation_argv(unit: NonEmptyStr) -> ArgvMaterialization {
  shell_materialize_operation_argv(
    systemctl_show_property_path,
    systemctl_show_property_service,
    systemctl_show_load_state_operation,
    [operation_argv_bind_text(name: "unit", text: unit as String)]
  )
}

data systemctl_show_load_state_operation: String = "ShowLoadState"

fn systemctl_show_load_state_read_local(unit: NonEmptyStr) -> SystemdPropertyCapture {
  let result = systemd.Systemctl.ShowLoadState(unit: unit)
  systemctl_show_property_value_from_stdout(success: result.success, stdout: result.value)
}

fn systemctl_show_load_state_read_ssh(host: NonEmptyStr, unit: NonEmptyStr) -> SystemdPropertyCapture {
  match systemctl_show_load_state_operation_argv(unit: unit) {
    ArgvMaterialized { argv: argv } =>
      systemctl_show_property_read_ssh_argv(host: host, argv: argv)
    ArgvMaterializationRefused { at: _, cause: c } =>
      SystemdPropertyCaptureRefused { reason: operation_argv_cause_label(cause: c) }
  }
}

fn systemctl_show_load_state_read_fleet_ssh(
  target: SshTarget,
  context: FleetSshExecutionContext,
  unit: NonEmptyStr,
) -> SystemdPropertyCapture {
  match systemctl_show_load_state_operation_argv(unit: unit) {
    ArgvMaterialized { argv: argv } =>
      systemd_property_capture_from_outcome(
        outcome: typed_argv_exec_over_fleet_ssh(target: target, context: context, argv: argv),
      )
    ArgvMaterializationRefused { at: _, cause: c } =>
      SystemdPropertyCaptureRefused { reason: operation_argv_cause_label(cause: c) }
  }
}

fn systemctl_show_load_state_read(
  transport: HostEffectTransport,
  unit: NonEmptyStr,
) -> SystemdPropertyCapture {
  match transport {
    LocalShell => systemctl_show_load_state_read_local(unit: unit)
    SshShell { ssh_host: h } => systemctl_show_load_state_read_ssh(host: h, unit: unit)
    FleetSsh { target: t, context: c } => systemctl_show_load_state_read_fleet_ssh(target: t, context: c, unit: unit)
    EmitArtifactThenThinRun { bootstrap: _, invocation: _ } =>
      SystemdPropertyCaptureRefused {
        reason: "systemctl show LoadState refused EmitArtifactThenThinRun transport",
      }
  }
}

fn systemctl_show_load_state_operation_argv_matches_transport(unit: NonEmptyStr) -> Bool {
  let authority = systemctl_show_load_state_argv(unit: unit)
  match systemctl_show_load_state_operation_argv(unit: unit) {
    ArgvMaterialized { argv: materialized } => join(materialized, " ") == join(authority, " ")
    ArgvMaterializationRefused { at: _, cause: _ } => false
  }
}
