module gunbc.systemctl_show_read

import std.types { String, NonEmptyStr, List }
import extdeps.systemd.systemctl
import extdeps.systemd { SystemdUnitProperty, systemd_unit_property_wire }
import gunbc.host_effect { HostEffectTransport, LocalShell, SshShell }
import v2.std.operation_argv {
  ArgvMaterialization,
  ArgvMaterialized,
  ArgvMaterializationRefused,
  operation_argv_bind_text,
}
import gunbc.typed_argv_exec {
  typed_argv_exec_over_ssh,
  typed_argv_shell_safe_refusal_argv,
  TypedArgvExecConverged,
  TypedArgvExecRefused,
}

data systemctl_show_property_path: String = "dag/extdeps/systemd/systemctl.dag"
data systemctl_show_property_service: String = "systemd.Systemctl"
data systemctl_show_property_operation: String = "ShowProperty"

fn systemctl_show_property_operation_argv(unit: NonEmptyStr, property: SystemdUnitProperty) -> ArgvMaterialization {
  shell_materialize_operation_argv(
    systemctl_show_property_path,
    systemctl_show_property_service,
    systemctl_show_property_operation,
    [
      operation_argv_bind_text(name: "unit", text: unit as String),
      operation_argv_bind_text(name: "property", text: systemd_unit_property_wire(property: property) as String)
    ]
  )
}

fn systemctl_show_property_value_from_stdout(success: Bool, stdout: String) -> String? {
  if success {
    let trimmed = trim(stdout)
    if trimmed == "" {
      none
    } else {
      Present { value: trimmed }
    }
  } else {
    none
  }
}

fn systemctl_show_property_read_local(unit: NonEmptyStr, property: SystemdUnitProperty) -> String? {
  let result = systemd.Systemctl.ShowProperty(unit: unit, property: property)
  systemctl_show_property_value_from_stdout(success: result.success, stdout: result.value)
}

fn systemctl_show_property_read_ssh_argv(host: NonEmptyStr, argv: List<String>) -> String? {
  match typed_argv_shell_safe_refusal_argv(argv: argv) {
    Present { value: _ } => none
    Absent =>
      match typed_argv_exec_over_ssh(host: host, argv: argv) {
        TypedArgvExecConverged { result: r } =>
          systemctl_show_property_value_from_stdout(success: r.success, stdout: r.stdout)
        TypedArgvExecRefused { reason: _ } => none
      }
  }
}

fn systemctl_show_property_read_ssh(
  host: NonEmptyStr,
  unit: NonEmptyStr,
  property: SystemdUnitProperty,
) -> String? {
  match systemctl_show_property_operation_argv(unit: unit, property: property) {
    ArgvMaterialized { argv: argv } =>
      systemctl_show_property_read_ssh_argv(host: host, argv: argv)
    ArgvMaterializationRefused { at: _, cause: _ } => none
  }
}

fn systemctl_show_property_read(
  transport: HostEffectTransport,
  unit: NonEmptyStr,
  property: SystemdUnitProperty,
) -> String? {
  match transport {
    LocalShell => systemctl_show_property_read_local(unit: unit, property: property)
    SshShell { ssh_host: h } => systemctl_show_property_read_ssh(host: h, unit: unit, property: property)
    EmitArtifactThenThinRun { bootstrap: _, invocation: _ } => none
  }
}

fn systemctl_show_property_operation_argv_matches_transport(
  unit: NonEmptyStr,
  property: SystemdUnitProperty,
) -> Bool {
  let authority = systemctl_show_property_argv(unit: unit, property: property)
  match systemctl_show_property_operation_argv(unit: unit, property: property) {
    ArgvMaterialized { argv: materialized } => join(materialized, " ") == join(authority, " ")
    ArgvMaterializationRefused { at: _, cause: _ } => false
  }
}
