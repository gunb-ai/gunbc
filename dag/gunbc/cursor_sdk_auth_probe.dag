module gunbc.cursor_sdk_auth_probe


data cursor_sdk_auth_probe_note: String = "Modeled SDK auth probe: classifies a terminal RunResult reconcile into authentication standing inputs only. authentication_error is the sole credential-rejection code; rate_limit_error and other terminal codes are auth-axis-neutral (credentials may still be valid — limits/turn axes own those failures). No live SDK call in this slice — witnesses supply fixture JSON. Never mints ProviderAuthenticated literals; AuthenticationAuthenticated is derived only from CursorSdkAuthProbeAuthenticated or auth-neutral terminal errors."

type CursorSdkAuthProbeResult
  = CursorSdkAuthProbeAuthenticated
  | CursorSdkAuthProbeCredentialsRejected {
      code: extdeps.llm.cursor_sdk_errors.CursorSdkErrorCode
    }
  | CursorSdkAuthProbeTerminalNonAuthenticationError {
      code: extdeps.llm.cursor_sdk_errors.CursorSdkErrorCode
    }
  | CursorSdkAuthProbeUnclassified { reason: std.types.NonEmptyStr }

fn cursor_sdk_auth_probe_from_reconcile(
  reconcile: extdeps.llm.cursor_stream.CursorSdkStreamTerminalReconcile,
) -> CursorSdkAuthProbeResult {
  match reconcile {
    extdeps.llm.cursor_stream.CursorSdkStreamTerminalsReconciled { status: extdeps.llm.cursor_stream.CursorSdkTerminalFinished, error: _, raw: _ } =>
      CursorSdkAuthProbeAuthenticated
    extdeps.llm.cursor_stream.CursorSdkStreamTerminalsReconciled { status: extdeps.llm.cursor_stream.CursorSdkTerminalError, error: err, raw: _ } =>
      match err {
        extdeps.llm.cursor_stream.CursorSdkTerminalErrorObserved { message: _, code: code } =>
          if extdeps.llm.cursor_sdk_errors.cursor_sdk_error_code_is_authentication_failure(code: code) {
            CursorSdkAuthProbeCredentialsRejected { code: code }
          } else {
            CursorSdkAuthProbeTerminalNonAuthenticationError { code: code }
          }
        extdeps.llm.cursor_stream.CursorSdkTerminalErrorAbsent =>
          CursorSdkAuthProbeUnclassified {
            reason: "terminal error status without error object" as std.types.NonEmptyStr,
          }
      }
    extdeps.llm.cursor_stream.CursorSdkStreamTerminalsReconciled { status: _, error: _, raw: _ } =>
      CursorSdkAuthProbeUnclassified {
        reason: "non-error terminal status is not an auth probe" as std.types.NonEmptyStr,
      }
    extdeps.llm.cursor_stream.CursorSdkStreamTerminalsUnclassified { reason: reason, raw: _ } =>
      CursorSdkAuthProbeUnclassified { reason: reason }
  }
}

fn cursor_sdk_auth_probe_from_run_result(raw: String) -> CursorSdkAuthProbeResult {
  cursor_sdk_auth_probe_from_reconcile(
    reconcile: extdeps.llm.cursor_stream.cursor_sdk_stream_reconcile_run_result(raw: raw),
  )
}

fn cursor_sdk_auth_probe_rejection_wire_code(probe: CursorSdkAuthProbeResult) -> String {
  match probe {
    CursorSdkAuthProbeCredentialsRejected { code: code } => extdeps.llm.cursor_sdk_errors.cursor_sdk_error_code_label(code: code)
    CursorSdkAuthProbeTerminalNonAuthenticationError { code: code } =>
      extdeps.llm.cursor_sdk_errors.cursor_sdk_error_code_label(code: code)
    CursorSdkAuthProbeAuthenticated => ""
    CursorSdkAuthProbeUnclassified { reason: _ } => ""
  }
}
