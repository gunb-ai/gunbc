module gunbc.roadmap.roadmap_authority_fixture

import std.types { String, List, Bool, NonEmptyStr }
import std.optional { Present, Absent }
import std.content_hash { Fnv1a64Structural }
import std.dissolution { DissolutionCondition, unbound_dissolution }
import gunbc.principal_projection { PrincipalRef }
import gunbc.roadmap.roadmap_model {
  RoadmapNodeId,
  RoadmapNode,
  RoadmapNodeIdentity,
  RoadmapAcceptanceReceipt,
  AcceptanceNodeRemainsSuperseded,
  roadmap_criteria_digest,
  Dispatchable,
  PrsMerged,
}
import gunbc.roadmap.roadmap_status {
  TicketLine,
  TicketFields,
  RedControlExecuted,
  HandbackDelivered,
}
import gunbc.roadmap.roadmap_execution_contract { ExecutionContractUnspecified }
import gunbc.roadmap.roadmap_event_log {
  RoadmapEvent,
  RoadmapEventKind,
  RoadmapEventId,
  RoadmapNodeStanding,
  NodeOpen,
  NodeClaimed,
  NodeInProgress,
  NodeBlocked,
  NodeHandedBack,
  NodeRetired,
  NodeAccepted,
  NodeReadyForReview,
  NodeForked,
  NodeHistoryIncomplete,
  roadmap_node_standing_key,
  EventPrincipalAuthenticated,
  AcceptancePrEvidence,
  AcceptanceRecordedEvent,
  AcceptanceRevokedEvent,
  Retired,
  EarnedByPullRequest,
  roadmap_event_envelope,
  roadmap_event_id,
  roadmap_event_wire_text,
  roadmap_event_schema,
}

// THE COMMITTED ROADMAP-AUTHORITY EVENT LOG, AS A GENERATED ARTIFACT.
//
// Five JSON files under fixtures/roadmap_authority/events, checked into the tree so a hermetic witness can
// walk a REAL event log through the floor's checkout carve-out (Filesystem.List + Filesystem.Read) instead of
// having the log handed to it. What the walk proves is the carrier: one directory walk, one decode, the fold's
// typed answers. Nothing here touches a filesystem, a command transport, or a clock -- the bytes are produced
// by the log's own emitter, and the gate
// (gunbc.instruments.generated_artifact_gate::write_generated_artifact) is the only thing that puts them on
// disk, under the roster row that names each path (gunbc.generated_artifact, five
// RoadmapAuthority*Artifact variants; gunbc.generated_artifact_registry lists them).
//
// WHY THESE FIVE FILES EXIST AT ALL. A witness that is handed its envelopes in process tests the fold; it does
// not test the carrier that turns bytes on disk into those envelopes. The 21 scenario witnesses cover the
// fold, and these files exist so the carrier and the fold are joined by something real: the reader is asked to
// read a directory nobody fabricated at runtime. DESIGN gunbc.design_argument::witness_one_interface: supplying
// inputs may never remove the last execution of the real path.
//
// WHY THE ROWS ARE ROSTERED AND NOT WRITTEN HERE. The route for a committed generated file is the gate behind
// the roster: it refuses an unrostered path with a typed refusal naming it
// (gunbc.generated_artifact::GeneratedArtifactPathUnrostered), it creates the parent directory, and it reports
// a false Filesystem.Write as an exit failure naming the artifact path -- so a partial log can never be
// reported as a fixture. A second writer beside that route would be a fork over one decision
// (gunbc.design_argument::single_authority), which is what an earlier revision of this change had and what
// review 96472, 96474 and 96479 each blocked. The ruling (neat-badger-614, 2026-11-18) is that adding a member
// to the roster's population is ordinary extension, not a fork, and the local writer is deleted.
//
// WHAT THE BYTE WITNESS STILL OWNS. gunbc.roadmap.roadmap_authority_fixture is pure, so the witness can call
// these same five functions and compare the result to what Filesystem.Read returns, byte for byte. That is the
// drift gate: regenerate the roster and forget to commit, or edit a file by hand, and the witness reddens.

// ── The one spelling of the directory ───────────────────────────────────────
// THE ONE SPELLING OF THE DIRECTORY ON THE READER'S SIDE. The roster rows name their own locations
// (gunbc.generated_artifact artifact_location), and the witness DERIVES its walk root from those rows; this is
// the constant the witness uses to recognise which roster rows belong to the fixture at all. A witness that
// re-spelled the whole path would drift from the roster silently -- so it spells this one prefix and a witness
// (test.claim.roadmap.roadmap_authority witness_committed_fixture_is_the_rosters_five_rows) demands that every
// fixture row's rostered path live under it.
data roadmap_authority_fixture_worktree_dir: String = "fixtures/roadmap_authority"

fn roadmap_authority_fixture_worktree_root() -> String { roadmap_authority_fixture_worktree_dir }

// ── The scenario the log is about, OWNED HERE ───────────────────────────────
// THE FIXTURE DECLARES ITS OWN NODES AND ITS OWN ACCEPTANCE CRITERIA. It does not read the plan.
// DESIGN gunbc.design_argument::planning_has_one_home: "no build or generated output may depend on it …
// No compiler build input and no generated product may depend on plan content, so a change that edits only
// plans invalidates neither the compiler nor any mirror." These five files are a CommitRequired generated
// product (gunbc.generated_artifact, the RoadmapAuthority*Artifact rows), so an earlier revision that took
// each receipt's criteria_digest off the live roadmap row was breaking that rule: editing one node's
// acceptance criteria would have invalidated a committed generated file, and the drift witness would have
// reddened on a plan-only edit. Review 96520 caught it; this is the fix.
//
// The scenario is therefore fiction with one home, in this module: two nodes, their criteria, and the row
// the scenario does NOT declare. The node ids are legibly the fixture's and cannot collide with a real
// roadmap row — a fixture that shadowed a live row would put a second, contradicting statement of that
// row's terms in the tree, which is the same defect wearing different clothes. The digest is the model's
// OWN criteria law (gunbc.roadmap.roadmap_model roadmap_criteria_digest) applied to the fixture's own
// ticket fields, so the receipt is valid for the reason the model says receipts are valid, not because a
// number was guessed. There is no fallback branch and nothing is fabricated: a receipt is built from a
// scenario row that exists here, and a witness (test.claim.roadmap.roadmap_authority
// witness_fixture_digests_are_declared_or_borrowed) demands the committed bytes carry exactly those
// digests, and that no fixture node is a real roadmap row at all.

type RoadmapAuthorityFixtureScenario {
  node: RoadmapNodeId
  identity: RoadmapNodeIdentity
  brief: String
  red_control: String
  handback: String
}

fn roadmap_authority_fixture_accepted_scenario() -> RoadmapAuthorityFixtureScenario {
  RoadmapAuthorityFixtureScenario {
    node: "roadmap-authority-scenario-accepted" as NonEmptyStr as RoadmapNodeId,
    identity: "roadmap-authority-fixture-accepted" as NonEmptyStr as RoadmapNodeIdentity,
    brief: "The fixture's own accepted row: its only purpose is to be a node the log accepted on terms this module states.",
    red_control: "A receipt whose criteria_digest differs from this row's criteria is not admitted by the fold.",
    handback: "The committed acceptance event under fixtures/roadmap_authority/events/roadmap-authority-scenario-accepted.",
  }
}

fn roadmap_authority_fixture_superseded_scenario() -> RoadmapAuthorityFixtureScenario {
  RoadmapAuthorityFixtureScenario {
    node: "roadmap-authority-scenario-superseded" as NonEmptyStr as RoadmapNodeId,
    identity: "roadmap-authority-fixture-superseded" as NonEmptyStr as RoadmapNodeIdentity,
    brief: "The fixture's own remains-superseded row: accepted, taken back, then retired by the log.",
    red_control: "A remains-superseded revocation on a node the log never retired refuses the join.",
    handback: "The three committed events under fixtures/roadmap_authority/events/roadmap-authority-scenario-superseded.",
  }
}

// THE SCENARIO ROWS, in the order the files are filed. Two rows, five files: the absent node is not here,
// that is the whole point of it.
fn roadmap_authority_fixture_scenarios() -> List<RoadmapAuthorityFixtureScenario> {
  [roadmap_authority_fixture_accepted_scenario(), roadmap_authority_fixture_superseded_scenario()]
}

fn roadmap_authority_fixture_scenario_node_id(s: String) -> RoadmapNodeId { s as NonEmptyStr as RoadmapNodeId }

// THE ROW THE SCENARIO DOES NOT DECLARE. The fixture carries an acceptance for it precisely so the
// fail-closed path is exercised by the committed route rather than argued about: a log may name a node the
// scenario has never heard of, and nothing may be admitted on it -- and nothing may crash on it either.
fn roadmap_authority_fixture_absent_node() -> RoadmapNodeId {
  roadmap_authority_fixture_scenario_node_id(s: "roadmap-authority-scenario-absent-node")
}

fn roadmap_authority_fixture_accepted_node() -> RoadmapNodeId {
  roadmap_authority_fixture_accepted_scenario().node
}

fn roadmap_authority_fixture_superseded_node() -> RoadmapNodeId {
  roadmap_authority_fixture_superseded_scenario().node
}

// ── The scenario's rows, receipts, digests and evidence ─────────────────────
// A receipt only survives the fold if its criteria_digest is the one its row's criteria derive from AND its
// evidence is delivered; anything else is dropped, and a dropped acceptance silently changes what every
// witness sees. So the digest is DERIVED, from the fixture's own ticket fields, by the model's own criteria
// law -- the same law the live model applies to live rows (gunbc.roadmap.roadmap_model
// receipt_matches_node), which is what makes an admissible fixture receipt admissible for the real reason.
fn roadmap_authority_fixture_ticket(s: RoadmapAuthorityFixtureScenario) -> TicketFields {
  TicketFields {
    headline: "Roadmap-authority fixture scenario row",
    brief: s.brief,
    displaced_cost: "none: the fixture exists only to be read by a witness",
    current_state: "fixture",
    first_slice: "the committed event file this row is accepted by",
    red_control: s.red_control,
    out_of_scope: "anything outside fixtures/roadmap_authority/events",
    handback: s.handback,
    updates: [],
    authored_on: "2026-11-18",
    last_verified_on: "2026-11-18",
  }
}

// THE SCENARIO'S OWN DECLARED GRAPH, and the only document the committed-fixture witnesses fold against.
// The fold validates a receipt against the document it is handed (roadmap_model receipt_matches_node), so
// the fixture's receipts need the fixture's rows -- which is also why those rows live here rather than
// being read off the plan.
fn roadmap_authority_fixture_declared_row(s: RoadmapAuthorityFixtureScenario) -> RoadmapNode {
  RoadmapNode {
    identity: s.identity,
    node: s.node,
    line: TicketLine { ticket: roadmap_authority_fixture_ticket(s: s) },
    carriers: [],
    dispatch: Dispatchable { repo: "gunbc", acceptance: PrsMerged },
    execution: ExecutionContractUnspecified,
    owner: "briansrls",
    parent: Absent,
    centering: Absent,
  }
}

fn roadmap_authority_fixture_declared_rows() -> List<RoadmapNode> {
  roadmap_authority_fixture_scenarios() |> map(s => roadmap_authority_fixture_declared_row(s: s))
}

fn roadmap_authority_fixture_digest(s: RoadmapAuthorityFixtureScenario) -> Fnv1a64Structural {
  roadmap_criteria_digest(t: roadmap_authority_fixture_ticket(s: s))
}

// A RECEIPT FOR A NODE, ON THE TERMS A SCENARIO ROW STATES. `node` and `terms` are separate arguments
// because the fixture needs exactly one receipt whose node is NOT the row that states the terms: the
// undeclared node's acceptance, which borrows a declared row's terms verbatim so that the only thing wrong
// with it is the thing under test.
fn roadmap_authority_fixture_receipt(
  node: RoadmapNodeId,
  terms: RoadmapAuthorityFixtureScenario,
) -> RoadmapAcceptanceReceipt {
  RoadmapAcceptanceReceipt {
    node: node,
    criteria_digest: roadmap_authority_fixture_digest(s: terms),
    red_control: RedControlExecuted {
      witness_module: "test.fixture",
      witness_fn: "fixture_red_control",
      executed_on: "2026-07-28",
    },
    handback: HandbackDelivered { first_artifact: "fixture-handback", further_artifacts: [] },
    accepted_by: "operator",
    accepted_on: "2026-07-28",
  }
}

// THE ACCEPTANCE WAS EARNED BY A PULL REQUEST, legibly the scenario's: a real-shaped url, merge time and
// head, and a url whose number cannot be read as anybody's work.
fn roadmap_authority_fixture_evidence() -> AcceptancePrEvidence {
  EarnedByPullRequest {
    pr_url: "https://github.com/gunb-ai/gunbc/pull/0" as NonEmptyStr,
    merged_at: "2026-11-18T00:00:00Z" as NonEmptyStr,
    head_sha: "0000000000000000000000000000000000000000" as NonEmptyStr,
  }
}

fn roadmap_authority_fixture_principal() -> EventPrincipalAuthenticated {
  EventPrincipalAuthenticated { ref: PrincipalRef {
    authority: "google-oidc" as NonEmptyStr,
    namespace: "accounts" as NonEmptyStr,
    subject: "sub-roadmap-authority-scenario" as NonEmptyStr,
  } }
}

// ONE SCENARIO EVENT, recorded at the same instant as every other one, so the ordering a witness relies on is
// always the chain -- the parent an event names -- never a timestamp nobody read.
fn roadmap_authority_fixture_event(
  node: RoadmapNodeId,
  parent: RoadmapEventId?,
  kind: RoadmapEventKind,
) -> RoadmapEvent {
  RoadmapEvent {
    node: node, author: roadmap_authority_fixture_principal(), parent: parent, kind: kind,
    recorded_at: "2026-11-18T00:00:00Z",
  }
}

fn roadmap_authority_fixture_acceptance_kind(s: RoadmapAuthorityFixtureScenario) -> RoadmapEventKind {
  AcceptanceRecordedEvent {
    receipt: roadmap_authority_fixture_receipt(node: s.node, terms: s),
    evidence: roadmap_authority_fixture_evidence(),
  }
}

// ── The five files, each as one event ───────────────────────────────────────
// THE TABLE IS THE ROSTER, ONE ROW PER FILE. Each of these functions is what a roster row's producer
// declaration names (gunbc.generated_artifact artifact_producer), so "what the committed bytes are" has exactly
// one home. The witness reads the same functions and compares them to Filesystem.Read.

// The accepted row: one acceptance, which is what puts it on the active frontier at all.
fn expected_roadmap_authority_accepted_scenario_acceptance_json() -> String {
  let s = roadmap_authority_fixture_accepted_scenario()
  roadmap_event_wire_text(env: roadmap_event_envelope(e: roadmap_authority_fixture_event(
    node: s.node, parent: Absent, kind: roadmap_authority_fixture_acceptance_kind(s: s),
  )))
}

// The superseded row, event 1 of 3: accepted, so it exists on the frontier to begin with.
fn expected_roadmap_authority_superseded_scenario_acceptance_json() -> String {
  let s = roadmap_authority_fixture_superseded_scenario()
  roadmap_event_wire_text(env: roadmap_event_envelope(e: roadmap_authority_fixture_event(
    node: s.node, parent: Absent, kind: roadmap_authority_fixture_acceptance_kind(s: s),
  )))
}

// Event 2 of 3: the acceptance is taken back and the node STAYS SUPERSEDED. Its receipt is the same bytes as
// event 1's, which is what makes it a revocation of that acceptance rather than a second opinion about it.
fn expected_roadmap_authority_superseded_scenario_revocation_json() -> String {
  let s = roadmap_authority_fixture_superseded_scenario()
  let opened = roadmap_authority_fixture_event(
    node: s.node, parent: Absent, kind: roadmap_authority_fixture_acceptance_kind(s: s))
  roadmap_event_wire_text(env: roadmap_event_envelope(e: roadmap_authority_fixture_event(
    node: s.node,
    parent: Present { value: roadmap_event_id(e: opened) },
    kind: AcceptanceRevokedEvent {
      receipt: roadmap_authority_fixture_receipt(node: s.node, terms: s),
      disposition: AcceptanceNodeRemainsSuperseded {},
      revoked_by: "operator" as NonEmptyStr,
      revoked_on: "2026-11-18" as NonEmptyStr,
      reason: "the scenario took the acceptance back" as NonEmptyStr,
    },
  )))
}

// Event 3 of 3: the node is retired. A remains-superseded revocation on a node that was never retired is
// inadmissible (gunbc.roadmap.roadmap_model remains_superseded_revocations_join refuses it), so this event is
// what makes the row's chain a legal log rather than a refusal that would empty the fixture.
fn expected_roadmap_authority_superseded_scenario_retired_json() -> String {
  let s = roadmap_authority_fixture_superseded_scenario()
  let opened = roadmap_authority_fixture_event(
    node: s.node, parent: Absent, kind: roadmap_authority_fixture_acceptance_kind(s: s))
  let taken_back = roadmap_authority_fixture_event(
    node: s.node,
    parent: Present { value: roadmap_event_id(e: opened) },
    kind: AcceptanceRevokedEvent {
      receipt: roadmap_authority_fixture_receipt(node: s.node, terms: s),
      disposition: AcceptanceNodeRemainsSuperseded {},
      revoked_by: "operator" as NonEmptyStr,
      revoked_on: "2026-11-18" as NonEmptyStr,
      reason: "the scenario took the acceptance back" as NonEmptyStr,
    })
  roadmap_event_wire_text(env: roadmap_event_envelope(e: roadmap_authority_fixture_event(
    node: s.node,
    parent: Present { value: roadmap_event_id(e: taken_back) },
    kind: Retired { reason: "the scenario closed the node" as NonEmptyStr },
  )))
}

// THE ROW THAT IS NOT DECLARED, given a receipt whose digest is copied from a declared row so that the only
// thing wrong with it is the thing under test: the authority does not declare the node the receipt is about.
fn expected_roadmap_authority_absent_node_acceptance_json() -> String {
  let stranger = roadmap_authority_fixture_absent_node()
  let terms = roadmap_authority_fixture_accepted_scenario()
  roadmap_event_wire_text(env: roadmap_event_envelope(e: roadmap_authority_fixture_event(
    node: stranger,
    parent: Absent,
    kind: AcceptanceRecordedEvent {
      // THE BORROW IS EXPLICIT: the node is the stranger, the terms are verbatim the accepted row's, so the
      // only thing wrong with this event is the one thing under test.
      receipt: roadmap_authority_fixture_receipt(node: stranger, terms: terms),
      evidence: roadmap_authority_fixture_evidence(),
    },
  )))
}

// WHAT A WRITTEN EVENT FILE MUST CONTAIN, checked by the gate before it will call a write a success
// (gunbc.generated_artifact_emit artifact_extra_valid). Not a shapeless "non-empty": the two members the
// carrier itself keys on -- the schema tag and the node the file is filed under -- must both be present, so a
// generator that emitted the wrong node's bytes into this path reddens at the gate instead of putting a
// misfiled event in the log.
fn roadmap_authority_fixture_json_is_a_written_event(content: String, node: String) -> Bool {
  content.contains(fragment: concat("\"schema\": \"", roadmap_event_schema))
    && content.contains(fragment: concat("\"node\": \"", node))
    && content.contains(fragment: "\"id\": ")
}

// ONE SAMPLE PER STANDING, and the vocabulary derived from it. `roadmap_node_standing_key` in
// gunbc.roadmap.roadmap_event_log is the one authority for what a standing is called -- mentioned,
// not cited, the way the other consumers of that module write it; the machine-checked link is this
// file's own import of the declaration, which is what makes the derivation below a use and not a
// claim. A consumer that needs the CLOSED LIST of those words -- today the ctrl roadmap bridge
// `scripts/session-dashboard/dag/roadmap_spawner_bridge.dag` in gunb-ai/ctrl#2495, which refuses an
// unknown key instead of reading a node as absent (named per
// #gunbc.design_argument::consumption; the bridge's own text names the condition that deletes it) --
// must not answer by writing the ten words out a second time, which is a second place that
// independently decides them (#gunbc.design_argument::single_authority). So the list is the fold
// MAPPED OVER samples: it cannot hold a word the fold never emits.
//
// WHY THE SAMPLES SIT IN A FIXTURE MODULE AND NOT BESIDE THE FOLD. A sample of `NodeAccepted` carries
// an acceptance receipt, and a receipt is executed-acceptance evidence: minting one next to the fold
// would put fabricated evidence in the production module (#gunbc.design_argument::fail_closed: "no
// plausible output is fabricated"). The fields a standing's NAME reads are the ones a sample has to
// supply at all -- who signed it and what its receipt said are irrelevant to what the standing is
// called -- so they come from this module's own declared fixture suppliers, the same
// `roadmap_authority_fixture_principal` and `roadmap_authority_fixture_receipt` every witness already
// builds its scenarios with. Nothing here is read as evidence of anything: no reader takes a receipt
// from this list, and the fold discards the fields. Building the samples in the production module
// instead was not available: this module imports that one, so the dependency would have been a cycle.
//
// WHAT NOBODY ENFORCES, said plainly rather than claimed as a guarantee. `roadmap_node_standing_samples`
// is a hand-written list. Adding an eleventh variant forces the fold's no-wildcard match to grow, so
// the WORD gets written -- but nothing forces the new variant into this list, and a variant missing
// from it simply leaves the export one word short. `dag/test/claim/roadmap/roadmap_event_log_witness.dag`
// checks this list against the witness's own independent copy, which catches the two copies
// disagreeing and not a gap in both. The rung established is "the export is the fold over the samples
// written", not "one entry per constructor"; the reader's failure mode for the residual is the bridge
// refusing, not mis-staffing. The next rung -- the language handing a witness the constructors of a
// closed sum, so the list is checked rather than asserted. That rung is carried as data, not only as
// prose: `roadmap_node_standing_keys_next_rung` below, whose dissolution description names the issue.
// A condition that lives only in a comment is a condition nobody can ask the tree about.
fn roadmap_authority_fixture_standing_samples() -> List<RoadmapNodeStanding> {
  [
    NodeOpen,
    NodeClaimed { by: roadmap_authority_fixture_principal(), since: "2026-07-28" },
    NodeInProgress { by: roadmap_authority_fixture_principal(), last_note: "fixture-sample" as NonEmptyStr },
    NodeBlocked { by: roadmap_authority_fixture_principal(), reason: "fixture-sample" as NonEmptyStr },
    NodeHandedBack { by: roadmap_authority_fixture_principal(), reason: "fixture-sample" as NonEmptyStr },
    NodeRetired { by: roadmap_authority_fixture_principal(), reason: "fixture-sample" as NonEmptyStr },
    NodeAccepted {
      by: roadmap_authority_fixture_principal(),
      receipt: roadmap_authority_fixture_receipt(
        node: roadmap_authority_fixture_accepted_node(),
        terms: roadmap_authority_fixture_accepted_scenario(),
      ),
    },
    NodeReadyForReview {
      by: roadmap_authority_fixture_principal(),
      pr: "0" as NonEmptyStr,
      head: "0000000" as NonEmptyStr,
    },
    // Non-empty on purpose: an empty list here leaves the element type unjudged at this pair, and the
    // values are fixtures the fold discards -- a sample states that the variant EXISTS, nothing more.
    NodeForked { heads: ["fixture-head-1" as RoadmapEventId, "fixture-head-2" as RoadmapEventId] },
    NodeHistoryIncomplete { missing_parents: ["fixture-missing-parent" as RoadmapEventId] },
  ]
}

// THE EXPORT: the fold over the samples above, in their order. Order is part of the contract -- the
// ctrl bridge serves readiness in the authority's declaration order and compares lists positionally.
data roadmap_node_standing_keys: List<String> =
  map(roadmap_authority_fixture_standing_samples(), s => roadmap_node_standing_key(s: s))

// THE RUNG ABOVE THIS PAIR, carried in the repo's own carrier for a condition that ought to delete
// some scaffolding, so the gap is answerable from the tree instead of only from a comment. It is
// unbound because the capability it waits for is in the language, not in a declaration this corpus can
// name: when a witness can be handed the constructors of a closed sum, the two sample lists (this one
// and `dag/test/claim/roadmap/roadmap_event_log_witness.dag`) are derived from the type instead of
// written, the gap both describe closes, and THIS declaration goes away with them.
// Tracker: gunb-ai/gunbc#16925.
data roadmap_node_standing_keys_next_rung: DissolutionCondition = unbound_dissolution(
  description: "dissolve-on: the language enumerating the constructors of a closed sum type (gunb-ai/gunbc#16925), so a per-variant sample list is derived from the sum instead of written by hand. SUFFICIENT FOR deleting roadmap_node_standing_samples and the matching list in dag/test/claim/roadmap/roadmap_event_log_witness.dag, and for deleting this declaration: the export is already the fold over the samples, so what remains hand-written is only the enumeration of the samples.",
)
