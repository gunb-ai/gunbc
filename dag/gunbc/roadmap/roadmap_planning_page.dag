module gunbc.roadmap_planning_page

import std.types { String }

fn planning_editor_html() -> String {
  "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Plan issue changes</title><style>body\{font:16px system-ui;margin:2rem auto;max-width:58rem;padding:0 1rem;background:#111;color:#eee}a\{color:#8bc4ff}label\{display:block;margin-top:1rem}input,textarea,button\{font:inherit;box-sizing:border-box}input,textarea\{width:100%;padding:.6rem;background:#222;color:#eee;border:1px solid #777;border-radius:4px}textarea\{min-height:6rem}button\{margin:1rem .6rem 0 0;padding:.6rem 1rem;cursor:pointer}button:disabled\{cursor:wait;opacity:.6}pre\{white-space:pre-wrap;overflow-wrap:anywhere;border:1px solid #555;padding:1rem}section\{margin-bottom:2rem}#status\{white-space:pre-wrap}h1\{font-size:1.6rem}</style><script defer src=\"/planning-client.js\"></script></head><body><a id=\"back\">Back to issue</a><h1>Plan issue changes</h1><p>Propose changes, review them, then accept. Only the accountable human can accept.</p><p id=\"status\" role=\"status\" aria-live=\"polite\">Loading current issue…</p><form id=\"editor\" hidden><section id=\"fields\"></section><label>Parent issue ID (empty means no parent)<input id=\"parent\"></label><label>Blocked by issue IDs (one per line)<textarea id=\"blockers\"></textarea></label><h2>Draft children</h2><div id=\"children\"></div><button id=\"add-child\" type=\"button\">Add draft child</button><p><button id=\"propose\" type=\"submit\">Save proposal for review</button></p></form><section id=\"review\" hidden><h2>Review proposed changes</h2><div id=\"differences\"></div><button id=\"accept\" type=\"button\">Accept changes</button></section><button id=\"reload\" type=\"button\">Start again from current issue</button></body></html>"
}

fn planning_editor_script() -> String {
  "\"use strict\";\n(()=>\{\n const base=location.pathname.replace(/\\/planning.*$/,\"\");\n const fields=[[\"brief\",\"Description\"],[\"displaced_cost\",\"Problem / displaced cost\"],[\"current_state\",\"Current state\"],[\"first_slice\",\"Plan\"],[\"red_control\",\"Acceptance control\"],[\"out_of_scope\",\"Out of scope\"],[\"handback\",\"Hand-back conditions\"]];\n const $=id=>document.getElementById(id); let context=null, saved=null, pending=null;\n const status=t=>\{$(\"status\").textContent=t;};\n $(\"back\").href=base;\n async function request(path,body)\{const r=await fetch(base+\"/planning\"+path,\{credentials:\"same-origin\",headers:body?\{\"Content-Type\":\"application/json\"}:\{},method:body?\"POST\":\"GET\",body:body?JSON.stringify(body):undefined,cache:\"no-store\"});let data;try\{data=await r.json();}catch(e)\{throw Error(\"The server returned an unreadable response. Your proposal remains available for retry.\");}if(!r.ok)throw Error(data.reason||(\"Request refused (\"+r.status+\")\"));return data;}\n function input(name,label,value,container)\{const l=document.createElement(\"label\");l.textContent=label;const t=document.createElement(\"textarea\");t.name=name;t.value=value||\"\";l.append(t);container.append(l);return t;}\n async function load()\{status(\"Loading current issue…\");context=await request(\"/context\");saved=null;pending=null;$(\"fields\").replaceChildren();$(\"children\").replaceChildren();for(const [key,label] of fields)input(key,label,context.snapshot.ticket[key],$(\"fields\"));$(\"parent\").value=context.snapshot.parent;$(\"blockers\").value=context.snapshot.blockers.join(\"\\n\");$(\"editor\").hidden=false;$(\"review\").hidden=true;$(\"propose\").disabled=false;status(\"Editing \"+context.snapshot.ticket.headline+\". Saving a proposal does not change the issue.\");}\n $(\"add-child\").onclick=()=>\{const group=document.createElement(\"fieldset\");group.dataset.identity=crypto.randomUUID();const legend=document.createElement(\"legend\");legend.textContent=\"Draft child\";group.append(legend);input(\"headline\",\"Title\",\"\",group);for(const [key,label]of fields)input(key,label,\"\",group);const remove=document.createElement(\"button\");remove.type=\"button\";remove.textContent=\"Remove child\";remove.onclick=()=>group.remove();group.append(remove);$(\"children\").append(group);};\n function build()\{const s=context.snapshot;const changes=fields.map(([field])=>(\{field,value:$(\"fields\").querySelector('[name=\"'+field+'\"]').value})).filter(c=>c.value!==s.ticket[c.field]);const relations=[];const parent=$(\"parent\").value.trim();if(parent!==s.parent)relations.push(\{kind:\"set_parent\",parent});const blockers=$(\"blockers\").value.split(/\\r?\\n/).map(x=>x.trim()).filter(Boolean);if(JSON.stringify(blockers)!==JSON.stringify(s.blockers))relations.push(\{kind:\"set_blockers\",blockers});const children=Array.from($(\"children\").children).map(g=>\{const ticket=\{...s.ticket,updates:[],last_verified_on:\"\",authored_on:context.authored_on};for(const f of [\"headline\",...fields.map(x=>x[0])])ticket[f]=g.querySelector('[name=\"'+f+'\"]').value;return\{identity:g.dataset.identity,ticket};});return\{schema:\"planning-candidate/v1\",identity:context.identity,issue:s.issue,base_issue_revision:s,author:context.author,work_request:context.work_request,proposed_field_changes:changes,proposed_relation_changes:relations,proposed_draft_children:children};}\n function difference(label,before,after)\{const section=document.createElement(\"section\"),h=document.createElement(\"h3\"),old=document.createElement(\"pre\"),next=document.createElement(\"pre\");h.textContent=label;old.textContent=\"Before\\n\"+before;next.textContent=\"Proposed\\n\"+after;section.append(h,old,next);$(\"differences\").append(section);}\n async function review(id)\{const data=await request(\"/candidate/\"+encodeURIComponent(id));saved=data.candidate;$(\"differences\").replaceChildren();for(const c of saved.proposed_field_changes)difference(fields.find(x=>x[0]===c.field)?.[1]||c.field,saved.base_issue_revision.ticket[c.field],c.value);for(const r of saved.proposed_relation_changes)difference(r.kind===\"set_parent\"?\"Parent\":\"Blocked by\",JSON.stringify(r.kind===\"set_parent\"?saved.base_issue_revision.parent:saved.base_issue_revision.blockers),JSON.stringify(r.kind===\"set_parent\"?r.parent:r.blockers));for(const child of saved.proposed_draft_children)difference(\"New child: \"+child.ticket.headline,\"\",[\"Title: \"+child.ticket.headline,...fields.filter(([key])=>child.ticket[key]).map(([key,label])=>label+\"\\n\"+child.ticket[key])].join(\"\\n\\n\"));$(\"editor\").hidden=true;$(\"review\").hidden=false;$(\"accept\").disabled=!data.can_accept;status(data.reason||\"Proposal saved. Review every change before accepting.\");history.replaceState(null,\"\",base+\"/planning?candidate=\"+encodeURIComponent(id));}\n $(\"editor\").onsubmit=async e=>\{e.preventDefault();$(\"propose\").disabled=true;try\{pending=pending||build();const result=await request(\"/propose\",\{csrf_token:context.csrf_token,candidate:pending});await review(result.identity);}catch(e)\{status(e.message+\" Retry preserves the same proposal identity and payload.\");$(\"propose\").disabled=false;}};\n $(\"accept\").onclick=async()=>\{$(\"accept\").disabled=true;try\{const result=await request(\"/accept\",\{csrf_token:context.csrf_token,identity:saved.identity});status(\"Accepted revision \"+result.revision+\". \"+(result.refresh_reason||\"The issue and worker inputs now use the accepted revision.\"));}catch(e)\{status(e.message);$(\"accept\").disabled=false;}};\n $(\"reload\").onclick=()=>\{history.replaceState(null,\"\",base+\"/planning\");load().catch(e=>status(e.message));};\n load().then(()=>\{const id=new URLSearchParams(location.search).get(\"candidate\");if(id)return review(id);}).catch(e=>status(e.message));\n})();"
}
