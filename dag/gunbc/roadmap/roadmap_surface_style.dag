module gunbc.roadmap_surface_style
import gunbc.design.typography { interface_text_decls, InterfaceBody, InterfaceLabel, InterfaceMetadata, InterfaceHeading, InterfaceSectionHeading }
import gunbc.roadmap_component { roadmap_row_height }
import extdeps.google.issue_tracker { issue_results_columns, IssueColumnPriority, IssueColumnTitle, IssueColumnAssignee, IssueColumnStatus, IssueColumnLastModified }
import gunbc.design.material { BuildRule, StaticRule, ResponseRule, SelfResponse, WithinSubject, PseudoElementOfSubject, OnHover, OnFocusVisible, respond_fast, decl }
import extdeps.languages.css.selectors { RawSelector }
import extdeps.languages.css.properties { CustomProperty, AlignItems, Background, Border, BorderBottom, BorderLeft, BorderRadius, BoxShadow, Color, Cursor, Display, Fill, Flex, FlexDirection, FlexWrap, FontFamily, FontSize, FontWeight, Gap, GridColumn, GridTemplateColumns, Height, Inset, JustifyContent, LetterSpacing, LineHeight, ListStyle, Margin, MarginBottom, MarginLeft, MarginRight, MarginTop, MaxWidth, MinHeight, MinWidth, Opacity, Outline, Overflow, Padding, PaddingLeft, Position, Stroke, TextDecoration, TextTransform, Transform, WhiteSpace, Width, RawProperty }
import gunbc.design.scale { scale_var, scale_pair, scale_triple, scale_border, height_control, control_geometry, CompactChoice, RichIdentity, space_0, space_1, space_2, space_4, space_6, space_8, space_12, space_16, space_24, text_11, text_12, text_13, text_14, text_15, text_18, font_sans, font_mono, radius_surface, radius_999, border_1, border_2, width_status, height_compact_face }
import gunbc.design.theme { role_decl, TextRole, TextDimRole, SurfaceRole, CanvasRole, FocusRole }

// Local control geometry needs wider priority badges and an intrinsic modified heading.
// Keep the upstream column roster; do not change the observed upstream layout model.
fn workspace_issue_tracks() -> String {
  join(map(issue_results_columns, c => match c.kind {
    IssueColumnPriority => "minmax(6ch, max-content)"
    IssueColumnLastModified => "max-content"
    IssueColumnTitle => c.track as String
    IssueColumnAssignee => c.track as String
    IssueColumnStatus => c.track as String
  }), " ")
}

fn roadmap_surface_rules() -> List<BuildRule> {
  [
    StaticRule { selector: RawSelector { text: ".roadmap" }, decls: [
      decl(prop: MinWidth, value: "0"),
      decl(prop: MaxWidth, value: "100%"),
      decl(prop: Padding, value: "var(--space-24)")
    ] },
    StaticRule { selector: RawSelector { text: ".hardware-detail" }, decls: [
      role_decl(prop: Color, r: TextDimRole),
      decl(prop: MinWidth, value: "0"),
      decl(prop: RawProperty { name: "overflow-wrap" }, value: "anywhere")
    ] },
    StaticRule { selector: RawSelector { text: ".fleet-capacity-panel" }, decls: [
      role_decl(prop: Background, r: SurfaceRole),
      decl(prop: Border, value: scale_border(w: border_1, color_var: "var(--border)")),
      decl(prop: BorderRadius, value: scale_var(t: radius_surface)),
      decl(prop: Padding, value: scale_pair(a: space_12, b: space_16)),
      decl(prop: MaxWidth, value: "100%"),
      decl(prop: MinWidth, value: "0"),
      decl(prop: RawProperty { name: "overflow-x" }, value: "auto")
    ] },
    StaticRule { selector: RawSelector { text: ".daily-workspace" }, decls: [
      decl(prop: MinWidth, value: "0"),
      decl(prop: MaxWidth, value: "100%"),
      decl(prop: Padding, value: "var(--space-24)")
    ] },
    StaticRule { selector: RawSelector { text: ".workspace-meta, .workspace-toolbar" }, decls: [
      decl(prop: Display, value: "flex"),
      decl(prop: FlexWrap, value: "wrap"),
      decl(prop: AlignItems, value: "center"),
      decl(prop: Gap, value: scale_pair(a: space_4, b: space_12))
    ] },
    StaticRule { selector: RawSelector { text: ".workspace-meta .program-progress" }, decls: [
      decl(prop: MarginLeft, value: "auto")
    ] },
    StaticRule { selector: RawSelector { text: ".issue-hidden-summary" }, decls: concat([
      role_decl(prop: Color, r: TextDimRole)
    ], interface_text_decls(role: InterfaceMetadata)) },
    StaticRule { selector: RawSelector { text: ".issue-sort-undo[hidden], .issue-sort-status:empty" }, decls: [
      decl(prop: Display, value: "none")
    ] },
    StaticRule { selector: RawSelector { text: ".issue-controls" }, decls: [
      decl(prop: Display, value: "flex"),
      decl(prop: Flex, value: "1 1 40ch"),
      decl(prop: MinWidth, value: "0"),
      decl(prop: AlignItems, value: "center"),
      decl(prop: Gap, value: scale_var(t: space_6)),
      decl(prop: FlexWrap, value: "wrap")
    ] },
    StaticRule { selector: RawSelector { text: ".issue-search" }, decls: concat([
      role_decl(prop: Color, r: TextRole),
      role_decl(prop: Background, r: SurfaceRole),
      decl(prop: Border, value: scale_border(w: border_1, color_var: "var(--border)")),
      decl(prop: BorderRadius, value: scale_var(t: radius_surface)),
      decl(prop: Padding, value: scale_pair(a: space_4, b: space_12)),
      decl(prop: MinHeight, value: scale_var(t: height_control)),
      decl(prop: Flex, value: "1 1 30ch"),
      decl(prop: MinWidth, value: "0")
    ], interface_text_decls(role: InterfaceBody)) },
    StaticRule { selector: RawSelector { text: ".issue-table-scroll" }, decls: [
      decl(prop: MinWidth, value: "0"),
      decl(prop: MaxWidth, value: "100%"),
      decl(prop: RawProperty { name: "overflow-x" }, value: "auto"),
      decl(prop: Border, value: scale_border(w: border_1, color_var: "var(--border)")),
      decl(prop: BorderRadius, value: scale_var(t: radius_surface)),
      role_decl(prop: Background, r: SurfaceRole)
    ] },
    StaticRule { selector: RawSelector { text: ".issue-table" }, decls: [
      decl(prop: Display, value: "grid"),
      decl(prop: GridTemplateColumns, value: workspace_issue_tracks()),
      decl(prop: Gap, value: scale_var(t: space_0)),
