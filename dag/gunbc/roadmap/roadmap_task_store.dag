module gunbc.roadmap_task_store

import std.types { String, NonEmptyStr, Bool, List, EpochSecs }
import std.nat { Nat }
import std.decl_ref { decl_ref }
import std.content_hash { content_hash_of_value, serialize_content_hash }
import gunbc.fabric_storage_client { FabricStorageBinding }
import gunbc.fabric_event_log { PartitionRead, PartitionReadOk, PartitionReadRefused, EventAppend, EventAppended, EventAppendStale, EventAppendRefused, event_log_read_partition_with, event_log_append_with, event_log_read_budget }
import product.capacity.event_chain { PartitionId, ChainEvent, ChainWalked, ChainIncomplete, ChainBudgetExhausted, HeadExpectation, HeadAt, HeadAbsent, EventDecode, EventDecoded, EventUndecodable }
import product.capacity.event_json { chain_event_wire_text, chain_event_decode, member_nonempty }
import extdeps.languages.json.emit { JsonValue, json_kv, json_string }
import extdeps.languages.json.parse { json_object_unique_member, JsonMemberFound }
import gunbc.roadmap_model { RoadmapNode, RoadmapNodeId, RoadmapNodeIdentity }
import gunbc.roadmap_task_record { roadmap_task_json, roadmap_task_from_json }

// THE RUNTIME TASK STORE. A task created at runtime is one immutable object in the fabric DB's
// authenticated state namespace, linked to the task created before it: the roster IS the chain
// (partition roadmap-tasks, gunbc.fabric_event_log), read as one closure from the head.
//
// ROSTER SHAPE, DECIDED. The wire has no listing, so something must enumerate the tasks. Two
// shapes were weighed. (1) A ledger slot: one CAS head whose value is the whole roster, one
// generation per write, never reclaimed -- every create rewrites O(n) bytes and the store keeps all
// n prefixes, quadratic in total. (2) A chain partition in the fabric_event_log shape: one object per
// task linked to its parent, one head advanced by compare-and-set on the expected head -- O(1) per
// create, the store keeps each task once, and a read is one closure. The chain is chosen, and it
// subsumes the per-task slot the brief also names: a record is IMMUTABLE once created (status and
// acceptance live on the event carrier, one authority), so a second per-task slot would be a second
// copy of a fact that never changes. This diverges from the brief on purpose.
//
// The binding is the caller's: production passes fabric_state_storage_binding(), the authenticated
// state namespace, exactly as gunbc.workspace_allocation_store does; a witness passes a local file
// root. IDEMPOTENCY: the operation key is carried in the event, the identity is minted from it, and
// a retry of the same key with the same fields is a replay answering the committed record, while
// the same key with different fields is refused.

data roadmap_task_partition: String = "roadmap-tasks"
data roadmap_task_event_schema: String = "gunbc.roadmap-task-event/v1"

type RuntimeTaskEvent { operation_key: NonEmptyStr, task: RoadmapNode }

type RuntimeTaskRoster = RuntimeTaskRosterRead { head: HeadExpectation, events: List<RuntimeTaskEvent> } | RuntimeTaskRosterUnreadable { reason: String }
type RuntimeTaskCreate = RuntimeTaskCreated { task: RoadmapNode } | RuntimeTaskReplayed { task: RoadmapNode } | RuntimeTaskConflict | RuntimeTaskRefused { reason: String }

fn roadmap_task_partition_id() -> PartitionId { roadmap_task_partition as NonEmptyStr as String as PartitionId }

// Identity and node id are minted from the operation key, never from the title or slug.
fn roadmap_task_identity_of(operation_key: NonEmptyStr) -> NonEmptyStr {
  join(["task-", serialize_content_hash(hash: content_hash_of_value(value: operation_key)) as String], "") as NonEmptyStr
}

fn roadmap_task_minted(operation_key: NonEmptyStr, draft: RoadmapNode) -> RoadmapNode {
  let id = roadmap_task_identity_of(operation_key: operation_key)
  RoadmapNode { identity: id as RoadmapNodeIdentity, node: id as RoadmapNodeId, line: draft.line, carriers: draft.carriers, dispatch: draft.dispatch, execution: draft.execution, owner: draft.owner, signoff: draft.signoff, parent: draft.parent, centering: draft.centering }
}

fn roadmap_task_event_text(event: ChainEvent<RuntimeTaskEvent>) -> String {
  match roadmap_task_json(node: event.payload.task) {
    Absent => ""
    Present { value: task } => chain_event_wire_text(schema: roadmap_task_event_schema, e: event, kind: "created", members: [
      json_kv(key: "operation_key", value: json_string(s: event.payload.operation_key as String)),
      json_kv(key: "task", value: task),
    ])
  }
}

fn roadmap_task_event_kind_decode(doc: JsonValue, word: String) -> RuntimeTaskEvent? {
  if word != "created" { none } else {
    match member_nonempty(doc: doc, key: "operation_key") { Absent => none Present { value: key } =>
      match json_object_unique_member(v: doc, key: "task") {
        JsonMemberFound { value: t } => match roadmap_task_from_json(value: t) {
          Absent => none
          Present { value: task } => if (task.identity as String) == (roadmap_task_identity_of(operation_key: key) as String) { Present { value: RuntimeTaskEvent { operation_key: key, task: task } } } else { none }
        }
        other => none
      }
    }
  }
}

fn roadmap_task_event_decode(text: String) -> EventDecode<RuntimeTaskEvent> {
  chain_event_decode(text: text, schema: roadmap_task_event_schema, kind_decode: fn(doc, word) { roadmap_task_event_kind_decode(doc: doc, word: word) })
}

fn roadmap_task_roster(store: FabricStorageBinding) -> RuntimeTaskRoster {
  match event_log_read_partition_with(store: store, partition: roadmap_task_partition_id(), budget: event_log_read_budget(), decode: fn(t) { roadmap_task_event_decode(text: t) }) {
    PartitionReadRefused { cause: _ } => RuntimeTaskRosterUnreadable { reason: "task roster could not be read" }
    PartitionReadOk { head: head, walk: walk } => match walk {
      ChainWalked { oldest_first: envs } => RuntimeTaskRosterRead { head: head, events: map(envs, e => e.event.payload) }
      ChainIncomplete { missing: _, newest_first_so_far: _ } => RuntimeTaskRosterUnreadable { reason: "task roster chain has a missing link" }
      ChainBudgetExhausted { at: _ } => RuntimeTaskRosterUnreadable { reason: "task roster exceeds the read budget" }
    }
  }
}

// The tasks, oldest first: the VALUE the plan union folds in (piece 4).
fn roadmap_tasks_listed(store: FabricStorageBinding) -> List<RoadmapNode>? {
  match roadmap_task_roster(store: store) {
    RuntimeTaskRosterUnreadable { reason: _ } => none
    RuntimeTaskRosterRead { head: _, events: events } => Present { value: map(events, e => e.task) }
  }
}

fn roadmap_task_create(store: FabricStorageBinding, actor: NonEmptyStr, at: EpochSecs, operation_key: NonEmptyStr, draft: RoadmapNode) -> RuntimeTaskCreate {
  let task = roadmap_task_minted(operation_key: operation_key, draft: draft)
  match roadmap_task_json(node: task) {
    Absent => RuntimeTaskRefused { reason: "task has no wire form" }
    Present { value: _ } => match roadmap_task_roster(store: store) {
      RuntimeTaskRosterUnreadable { reason: reason } => RuntimeTaskRefused { reason: reason }
      RuntimeTaskRosterRead { head: head, events: events } => match filter(events, e => (e.operation_key as String) == (operation_key as String)).first() {
        Present { value: prior } => if roadmap_task_event_text(event: ChainEvent { partition: roadmap_task_partition_id(), parent: none, recorded_at: 0, actor: actor, payload: prior }) == roadmap_task_event_text(event: ChainEvent { partition: roadmap_task_partition_id(), parent: none, recorded_at: 0, actor: actor, payload: RuntimeTaskEvent { operation_key: operation_key, task: task } }) {
          RuntimeTaskReplayed { task: prior.task }
        } else { RuntimeTaskRefused { reason: "operation key already names a different task" } }
        Absent => roadmap_task_append(store: store, head: head, actor: actor, at: at, event: RuntimeTaskEvent { operation_key: operation_key, task: task })
      }
    }
  }
}

fn roadmap_task_append(store: FabricStorageBinding, head: HeadExpectation, actor: NonEmptyStr, at: EpochSecs, event: RuntimeTaskEvent) -> RuntimeTaskCreate
  admit_callers: [decl_ref(module_path: "gunbc.roadmap_task_store", decl_name: "roadmap_task_create")]
{
  let parent = match head { HeadAt { id: i } => Present { value: i } HeadAbsent => none }
  match event_log_append_with(store: store, partition: roadmap_task_partition_id(), event: ChainEvent { partition: roadmap_task_partition_id(), parent: parent, recorded_at: at, actor: actor, payload: event }, expected: head, encode: fn(e) { roadmap_task_event_text(event: e) }) {
    EventAppended { id: _ } => RuntimeTaskCreated { task: event.task }
    EventAppendStale { expected: _, observed: _ } => RuntimeTaskConflict
    EventAppendRefused { cause: _ } => RuntimeTaskRefused { reason: "task publication refused" }
  }
}
