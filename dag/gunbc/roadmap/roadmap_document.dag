module gunbc.roadmap_document

import std.markdown { MarkdownDocument, MarkdownBlock }
import gunbc.roadmap_model { RoadmapNode, RoadmapEdge, RoadmapMembership, SectionElement, Prose, Group }
import gunbc.roadmap_emit { project_roadmap_section }

type RoadmapSection {
  title: String
  elements: List<SectionElement>
}

type RoadmapDocument {
  memberships: List<RoadmapMembership>
  preamble: List<MarkdownBlock>
  lead_lanes: List<RoadmapSection>
  sections: List<RoadmapSection>
}

fn section_blocks(s: RoadmapSection, merged: List<Int>) -> List<MarkdownBlock> {
  project_roadmap_section(title: s.title, elements: s.elements, merged: merged).blocks
}

fn lead_lane_blocks(s: RoadmapSection, merged: List<Int>) -> List<MarkdownBlock> {
  project_roadmap_section(title: concat("✦ ", s.title), elements: s.elements, merged: merged).blocks
}

fn project_roadmap_to_markdown(doc: RoadmapDocument, merged: List<Int>) -> MarkdownDocument {
  let after_lanes = fold(doc.lead_lanes, init: doc.preamble, f: fn(acc, s) {
    concat(acc, lead_lane_blocks(s: s, merged: merged))
  })
  MarkdownDocument {
    blocks: fold(doc.sections, init: after_lanes, f: fn(acc, s) {
      concat(acc, section_blocks(s: s, merged: merged))
    })
  }
}

fn element_nodes(e: SectionElement) -> List<RoadmapNode> {
  match e {
    Prose { prose: _ } => []
    Group { group } => group.nodes
  }
}

fn element_edges(e: SectionElement) -> List<RoadmapEdge> {
  match e {
    Prose { prose: _ } => []
    Group { group } => group.edges
  }
}

fn section_nodes(s: RoadmapSection) -> List<RoadmapNode> {
  fold(s.elements, init: [], f: (acc, e) => concat(acc, element_nodes(e: e)))
}

fn section_edges(s: RoadmapSection) -> List<RoadmapEdge> {
  fold(s.elements, init: [], f: (acc, e) => concat(acc, element_edges(e: e)))
}

fn doc_all_nodes(doc: RoadmapDocument) -> List<RoadmapNode> {
  let lane_nodes = fold(doc.lead_lanes, init: [], f: (acc, s) => concat(acc, section_nodes(s: s)))
  fold(doc.sections, init: lane_nodes, f: (acc, s) => concat(acc, section_nodes(s: s)))
}

fn doc_all_edges(doc: RoadmapDocument) -> List<RoadmapEdge> {
  let lane_edges = fold(doc.lead_lanes, init: [], f: (acc, s) => concat(acc, section_edges(s: s)))
  fold(doc.sections, init: lane_edges, f: (acc, s) => concat(acc, section_edges(s: s)))
}
