module gunbc.roadmap_acceptance_history_carrier

import extdeps.filesystem.filesystem_io { Filesystem }
import gunbc.roadmap_model { RoadmapAcceptanceEvent }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import std.disposition { Disposition, RealizationDispatch, Scaffold }
import v2.std.collection { List }
import v2.std.text { String }

// Append-only JSONL carrier for roadmap acceptance events. gunbc.roadmap_authority loads current history from this file; gunbc.roadmap_acceptance_history_observation git.Core.Shows the same path at HEAD and merge-base and parses each revision independently. When the carrier is absent at merge-base (introduction on main), observation bootstraps prior_history from inline authority history via gunbc.roadmap_acceptance_history_projection. Authored seal count/digest in roadmap_authority.dag are deleted; prefix law is enforced by observed prior_history.
data roadmap_acceptance_event_history_carrier_repo_path: String = "dag/gunbc/roadmap/roadmap_acceptance_event_history.jsonl"

type RoadmapAcceptanceEventHistoryParse
  = RoadmapAcceptanceEventHistoryParsed { events: List<RoadmapAcceptanceEvent> }
  | RoadmapAcceptanceEventHistoryParseRefused { detail: String }

type RoadmapAcceptanceEventHistoryLoad
  = RoadmapAcceptanceEventHistoryLoaded { events: List<RoadmapAcceptanceEvent> }
  | RoadmapAcceptanceEventHistoryLoadRefused { detail: String }

fn parse_roadmap_acceptance_event_history_carrier(text: String) -> RoadmapAcceptanceEventHistoryParse {
  parse_roadmap_acceptance_event_history_jsonl(text: text)
}

fn load_roadmap_acceptance_event_history_from_carrier_text(text: String) -> RoadmapAcceptanceEventHistoryLoad {
  match parse_roadmap_acceptance_event_history_carrier(text: text) {
    RoadmapAcceptanceEventHistoryParsed { events: events } =>
      RoadmapAcceptanceEventHistoryLoaded { events: events }
    RoadmapAcceptanceEventHistoryParseRefused { detail: detail } =>
      RoadmapAcceptanceEventHistoryLoadRefused { detail: detail }
  }
}

fn load_roadmap_acceptance_event_history(path: String) -> RoadmapAcceptanceEventHistoryLoad {
  let read = Filesystem.Read(path: path)
  if !read.success {
    RoadmapAcceptanceEventHistoryLoadRefused {
      detail: concat("carrier read refused: ", read.error),
    }
  } else {
    load_roadmap_acceptance_event_history_from_carrier_text(text: read.content)
  }
}

// THE BRIDGE IS A CODEC, NOT A PARSER, and this description was corrected when the SCM excision
// added a disposition arm and had to edit BOTH directions. The seed module owns JSON -> typed value
// in event_value AND typed value -> JSON in event_to_json; calling it a parser hid half the surface,
// and a dissolution trigger that names less than the whole boundary retires while the capability is
// still dead (DESIGN section 4b(3)). The three modified items carry their own item-grain
// dispositions in gunbc.roadmap_acceptance_codec_seed_disposition.
//
// THE TRIGGER IS CAPABILITY-SHAPED, not artifact-shaped: this bridge dissolves when a generated or
// ordinary .dag realization can PARSE AND SERIALIZE every RoadmapAcceptanceEvent arm between JSONL
// and typed values without the seed. A realization covering only the read direction, or only the
// arms that exist today, does not retire it.
data roadmap_acceptance_event_history_jsonl_parser_seed_scaffold: Disposition = Scaffold {
  dissolves_to: RealizationDispatch,
  bind: DeclarationRef {
    module_path: "v1_compiler.cli_run.roadmap_acceptance_history_carrier",
    decl_name: "parse_roadmap_acceptance_event_history_jsonl_builtin",
    field: WholeDeclaration,
  }
}
