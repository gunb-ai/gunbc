module gunbc.roadmap.roadmap_acceptance_history_carrier

import std.types { List }
import gunbc.roadmap.roadmap_model { RoadmapAcceptanceEvent }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import std.disposition { Disposition, RealizationDispatch, Scaffold }
import v2.std.text { String }

// THE OPERATOR'S ACCEPTANCE LINE — the grammar of ONE line the operator dictates ("I accept node X
// on receipt …") and of its revocation, parsed by the same native law the JSONL seed used to be read
// with. This module owns NO FACT: the durable home of an acceptance and of a retirement is
// gunbc.roadmap.roadmap_event_log, where the close route appends through
// gunbc.roadmap.roadmap_issue_command issue_command_apply and where every reader goes through
// gunbc.roadmap.roadmap_operator_acceptance roadmap_operator_acceptance_history_load. What stays here
// is the LINE, because a line is an input the route parses (the migration replays the deleted seed's
// lines through it too), and a grammar belongs to one module.
// The file this module used to read at a repo path — the append-only JSONL seed — is deleted along
// with its reader and its git-revision observer; the operator's ruling
// gunbc.design_ruling::plans_reset_and_audit_recommendations_2026_11_08, step 2(d).

type RoadmapAcceptanceEventHistoryParse
  = RoadmapAcceptanceEventHistoryParsed { events: List<RoadmapAcceptanceEvent> }
  | RoadmapAcceptanceEventHistoryParseRefused { detail: String }

type RoadmapAcceptanceEventHistoryLoad
  = RoadmapAcceptanceEventHistoryLoaded { events: List<RoadmapAcceptanceEvent> }
  | RoadmapAcceptanceEventHistoryLoadRefused { detail: String }

fn parse_roadmap_acceptance_event_history_carrier(text: String) -> RoadmapAcceptanceEventHistoryParse {
  parse_roadmap_acceptance_event_history_jsonl(text: text)
}

fn load_roadmap_acceptance_event_history_from_carrier_text(text: String) -> RoadmapAcceptanceEventHistoryLoad {
  match parse_roadmap_acceptance_event_history_carrier(text: text) {
    RoadmapAcceptanceEventHistoryParsed { events: events } =>
      RoadmapAcceptanceEventHistoryLoaded { events: events }
    RoadmapAcceptanceEventHistoryParseRefused { detail: detail } =>
      RoadmapAcceptanceEventHistoryLoadRefused { detail: detail }
  }
}

data roadmap_acceptance_event_history_jsonl_parser_seed_scaffold: Disposition = Scaffold {
  dissolves_to: RealizationDispatch,
  bind: DeclarationRef {
    module_path: "v1_compiler.cli_run.roadmap_acceptance_history_carrier",
    decl_name: "parse_roadmap_acceptance_event_history_jsonl_builtin",
    field: WholeDeclaration,
  }
}
