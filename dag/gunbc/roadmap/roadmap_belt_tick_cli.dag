}

fn belt_integrate_one_result_json(r: BeltIntegrationCoreStep) -> JsonValue {
  match r {
    IntegrationCoreIntegrated { project_key } =>
      json_object(members: [
        json_kv(key: "schema", value: json_string(s: "roadmap-integrate-one/v1")),
        json_kv(key: "status", value: json_string(s: "integrated")),
        json_kv(key: "project", value: json_string(s: project_key)),
      ])
    IntegrationCoreBlocked { detail } =>
      json_object(members: [
        json_kv(key: "schema", value: json_string(s: "roadmap-integrate-one/v1")),
        json_kv(key: "status", value: json_string(s: "blocked")),
        json_kv(key: "detail", value: json_string(s: detail)),
      ])
    IntegrationCoreDeferred { reason } =>
      json_object(members: [
        json_kv(key: "schema", value: json_string(s: "roadmap-integrate-one/v1")),
        json_kv(key: "status", value: json_string(s: "deferred")),
        json_kv(key: "reason", value: json_string(s: reason)),
      ])
    IntegrationCoreUnreadable { detail } =>
      json_object(members: [
        json_kv(key: "schema", value: json_string(s: "roadmap-integrate-one/v1")),
        json_kv(key: "status", value: json_string(s: "unreadable")),
        json_kv(key: "detail", value: json_string(s: detail)),
      ])
  }
}

fn belt_integrate_one_cli(repo_root: String, node_id: String, attempt_key: String, receipt_path: String) -> ProcessExit {
  match dashboard_instance_for_repo_root(repo_root: repo_root) {
    DashboardInstanceRootUnknown { repo_root: w } => exit_failure(reason: join(["belt_integrate_one_cli: no dashboard instance is rooted at ", w], ""))
    DashboardInstanceResolved { instance } => {
      let document = serialize_json(v: belt_integrate_one_result_json(
        r: belt_integrate_candidate_core_for_instance(instance: instance, node_id: node_id, attempt_key: attempt_key),
      ))
      let w = Filesystem.Write(path: receipt_path, content: document)
      if !w.success { exit_failure(reason: join(["belt_integrate_one_cli: receipt could not be written: ", w.error, "; result was ", document], "")) } else { ExitSuccess }
    }
  }
}


// ------------------------------------------------------------------------------------------------
// THE OBLIGATION ENTRIES (dogfood interventions #6 and #4, gunbc#13124).
// The belt tick is demoted to launch: admission, spawn,
// teardown and discovery. Everything it used to run after those is an obligation with its own unit,
// started by the event that made it owed:
//   - belt_attempt_obligations_cli  one attempt's capture, verify, review, audit and publish
//                                   (gunbc.roadmap.roadmap_belt_actuate belt_attempt_obligations_run)
//   - belt_instance_obligation_cli  one instance fold: launch, served observation, result return,
//                                   metering, dogfood start record, snapshot census
//   - belt_exit_drain_cli           hands each recorded unit exit to its attempt's unit
//   - belt_exit_stall_analyze_cli   read-only: why a stalled exit spool's entries cannot leave
//   - belt_exit_stall_release_cli   re-claims the stalled entries, clears the stall record, re-arms the path unit
//   - belt_discover_once_cli        the bounded anti-entropy pass: discovers and queues, never works
//   - belt_launch_enqueue_cli       what the deployment's belt service runs: queue the one launch
// Every entry resolves its instance from GUNBC_BELT_SPAWN_WORKDIR, as belt_run_once_cli does and for
// that function's fail-closed reason.
// ------------------------------------------------------------------------------------------------

fn belt_instance_from_env(entry: String, continuation: fn(HostDashboardInstance) -> ProcessExit) -> ProcessExit {
  match shell.Env.Get(name: belt_spawn_workdir_env_var).value {
    Absent => exit_failure(reason: join([entry, ": GUNBC_BELT_SPAWN_WORKDIR not set -- the instance is a per-deployment fact (fail-closed)"], ""))
    Present { value: workdir } =>
      if string_length(s: workdir) == 0 {
        exit_failure(reason: join([entry, ": GUNBC_BELT_SPAWN_WORKDIR is empty -- the instance is a per-deployment fact (fail-closed)"], ""))
      } else {
        match dashboard_instance_for_repo_root(repo_root: workdir) {
          DashboardInstanceRootUnknown { repo_root: w } => exit_failure(reason: join([entry, ": GUNBC_BELT_SPAWN_WORKDIR does not match a known dashboard instance repo root: ", w], ""))
          DashboardInstanceResolved { instance } => continuation(instance)
        }
      }
  }
}

// A QUEUE HAND-OFF THAT WAS REFUSED FAILS THE CALLER, LOCATED; started and held succeed.
fn belt_obligations_enqueued_exit(context: String, enqueues: List<BeltObligationEnqueue>) -> ProcessExit {
  let refused = enqueues |> flat_map(e => match e {
    BeltObligationEnqueueRefused { unit, reason } => [join([unit as String, ": ", reason], "")]
    BeltObligationStarted { unit: _ } => [] as List<String>
    BeltObligationHeld { unit: _ } => [] as List<String>
  })
  if count(refused) == 0 { ExitSuccess } else { exit_failure(reason: join([context, ": ", to_string(value: count(refused)), " obligation(s) could not be handed to their unit: ", join(refused, "; ")], "")) }
}

// ONE PASS IS: CLAIM the attempt's queued exits, RUN, WRITE the receipt that names the claim, SETTLE
// exactly that claim. A pass that left an unclaimed arrival queued runs again -- bounded, so a
// hot attempt cannot hold its unit forever; what the bound leaves queued is the queued level's, which
// starts the drain, whose sweep hands the attempt to a new run once this unit is gone.
data belt_attempt_obligation_pass_bound: Int = 3

fn belt_attempt_obligations_pass(instance: HostDashboardInstance, node_id: String, attempt_key: String, passes_left: Int) -> List<String> {
  match belt_exit_entries_claim(instance: instance, node_id: node_id, attempt_key: attempt_key) {
    BeltExitClaimRefused { reason } => [reason]
    BeltExitClaimed { entries: claimed } => {
      let observed_at = belt_tick_observed_at()
      let run = belt_attempt_obligations_run(instance: instance, node_id: node_id, attempt_key: attempt_key)
      match belt_attempt_obligation_receipt_write(instance: instance, run: run, node_id: node_id, attempt_key: attempt_key, observed_at: observed_at, claimed: claimed) {
        BeltPassFailed { reason } => [join([serialize_json(v: belt_attempt_obligation_run_json(run: run, observed_at: observed_at, claimed: claimed)), "\n", reason], "")]
        BeltPassDeferred { reason } => [reason]
        BeltPassRefused { reason } => [reason]
        BeltPassRecorded => {
          let unsettled = belt_exit_entries_settle(instance: instance, claimed: claimed)
          let own = match belt_attempt_obligation_run_failure(run: run) { Present { value: f } => [f] Absent => [] as List<String> }
          let failures = concat(own, unsettled |> map(u => join(["exit entry not settled: ", u], "")))
          if count(failures) > 0 || passes_left <= 1 {
            failures
          } else {
            match belt_exit_entries_pending_at(root: instance.instance_root as String, node_id: node_id, attempt_key: attempt_key) {
              BeltExitClaimRefused { reason } => [reason]
              BeltExitClaimed { entries: pending } =>
                if count(pending) == 0 { failures } else { belt_attempt_obligations_pass(instance: instance, node_id: node_id, attempt_key: attempt_key, passes_left: passes_left - 1) }
            }
          }
        }
      }
    }
  }
}

fn belt_attempt_obligations_cli(node_id: String, attempt_key: String) -> ProcessExit {
  belt_instance_from_env(entry: "belt_attempt_obligations_cli", continuation: instance => {
    let run_failures = belt_attempt_obligations_pass(instance: instance, node_id: node_id, attempt_key: attempt_key, passes_left: belt_attempt_obligation_pass_bound)
    let tail = belt_obligations_enqueued_exit(
      context: "after the attempt's obligations",
      enqueues: belt_record_moved_obligation_kinds |> map(k => belt_instance_obligation_enqueue(instance: instance, kind: k)),
    )
    let failures = concat(run_failures, match tail { ExitSuccess => [] as List<String> ExitFailure { code: _, reason } => [reason] })
    if count(failures) == 0 { ExitSuccess } else { exit_failure(reason: join(failures, "\n")) }
  })
}

fn belt_instance_obligation_cli(kind: String) -> ProcessExit {
  match belt_instance_obligation_kind_of_key(key: kind) {
    Absent => exit_failure(reason: join(["belt_instance_obligation_cli: no instance obligation is named ", kind], ""))
    Present { value: k } =>
      belt_instance_from_env(entry: "belt_instance_obligation_cli", continuation: instance => belt_instance_obligation_run(instance: instance, kind: k))
  }
}

fn belt_instance_obligation_run(instance: HostDashboardInstance, kind: BeltInstanceObligationKind) -> ProcessExit {
  let observed_at = belt_tick_observed_at()
  match kind {
    LaunchObligation => belt_run_once_cli_in(spawn_workdir: instance.repo_root as String)
    ServedObservationObligation => belt_served_observation_exit(instance: instance, observed_at: observed_at)
    ResultReturnObligation => {
      let returned = result_return_attempts_for_instance(instance: instance, recorded_at: observed_at)
      belt_tick_exit_with_snapshot_closes(exit: result_return_pass_exit(pass: returned.pass), closes: returned.closes)
    }
    MeteringObligation =>
      match belt_metering_pass_outcome_from(outcomes: belt_metering_attempts_for_instance(instance: instance)) {
        BeltPassRecorded => ExitSuccess
        BeltPassFailed { reason } => exit_failure(reason: reason)
        BeltPassDeferred { reason } => exit_failure(reason: reason)
        BeltPassRefused { reason } => exit_failure(reason: reason)
      }
    DogfoodStartRecordObligation => belt_start_record_exit(start: dogfood_start_record_for_instance(instance: instance))
    SnapshotCensusObligation => belt_tick_exit_with_snapshot_census(exit: ExitSuccess, census: roadmap_snapshot_census_for_instance(instance: instance, observed_at: observed_at))
  }
}

fn belt_exit_drain_cli() -> ProcessExit {
  belt_instance_from_env(entry: "belt_exit_drain_cli", continuation: instance => {
    let drained = belt_exit_drain_for_instance(instance: instance)
    let failures = concat(belt_exit_drain_failures(d: drained), belt_exit_stall_failures(root: instance.instance_root as String, d: drained))
    if count(failures) == 0 { ExitSuccess } else { exit_failure(reason: join([serialize_json(v: belt_exit_drain_json(d: drained)), "\n", join(failures, "\n")], "")) }
  })
}

// THE OPERATOR ROUTE OUT OF AN EXIT-SPOOL STALL (gunbc.roadmap.roadmap_belt_actuate spool_stall_record_at).
// Both verbs run as the drain's principal. `analyze` is read-only and exits non-zero while a stall is held,
// printing why each recorded entry cannot leave. `release` re-attempts every recorded claim, and only when none
// is still unmovable deletes the stall record and re-arms the failed path unit (the one privileged effect;
// belt_exit_stall_rearm_at). It is idempotent: with no record held it still re-arms, so a refused re-arm is
// retried by running `release` again once the privilege is in place.
fn belt_exit_stall_analyze_cli() -> ProcessExit {
  belt_instance_from_env(entry: "belt_exit_stall_analyze_cli", continuation: instance => {
    let report = belt_exit_stall_analyze_at(root: instance.instance_root as String, whoami: belt_exit_stall_whoami())
    exit_failure(reason: join(report, "\n"))
  })
}

// THE CLEAR for an EMPTY foreign-owned entry (belt_exit_stall_clear_at). It runs as the drain's principal with no
// privilege: it creates the entry in the recorded move's target stage and removes the foreign one, the claim's own
// outcome, then `release` re-arms the trigger. A non-empty, unrecorded or symlinked entry is refused with a cause.
fn belt_exit_stall_clear_cli(entry: String) -> ProcessExit {
  belt_instance_from_env(entry: "belt_exit_stall_clear_cli", continuation: instance =>
    match belt_exit_stall_clear_at(root: instance.instance_root as String, entry: entry, whoami: belt_exit_stall_whoami()) {
      BeltExitClearFailed { reason } => exit_failure(reason: join(["belt_exit_stall_clear_cli: refused ", entry, ": ", reason], ""))
      BeltExitCleared { to_path: _ } => ExitSuccess
    })
}

fn belt_exit_stall_release_cli() -> ProcessExit {
  belt_instance_from_env(entry: "belt_exit_stall_release_cli", continuation: instance =>
    match desired_deployment_for_instance_id(instance_id: instance.instance_id as String) {
      DesiredDeploymentRosterRefused { refusal: r } =>
        exit_failure(reason: join(["belt_exit_stall_release_cli: desired roster refused: ", desired_roster_refusal_detail(refusal: r)], ""))
      DesiredDeploymentUnknownInstanceId { instance_id: id } =>
        exit_failure(reason: join(["belt_exit_stall_release_cli: no desired deployment for instance ", id], ""))
      DesiredDeploymentFound { row: row } => {
        let rearm = fn() {
          match belt_exit_stall_rearm_at(path_unit: deployment_belt_exit_path_unit_name(names: row.names)) {
            BeltExitStallRearmed => ExitSuccess
            BeltExitStallRearmRefused { argv, reason } => exit_failure(reason: join(["belt_exit_stall_release_cli: the stall record is cleared but the re-arm was refused (", reason, "); a privileged operator runs: ", join(argv, " ")], ""))
          }
        }
        match belt_exit_stall_release_at(root: instance.instance_root as String, move: belt_exit_entry_move_at) {
          BeltExitStallNotHeld => rearm()
          BeltExitStallReleased { reclaimed: _ } => rearm()
          BeltExitStallStillUnmovable { entries } =>
            exit_failure(reason: join(["belt_exit_stall_release_cli: still unmovable, the stall record is kept: ", join(entries |> map(e => join([e.entry, " (", spool_stall_step_text(step: e.step), ": ", e.cause, ")"], "")), "; ")], ""))
          BeltExitStallReleaseRefused { reason } => exit_failure(reason: join(["belt_exit_stall_release_cli: ", reason], ""))
        }
      }
    })
}

// THE ATTEMPT-UNIT SPOOL'S ROUTE OUT OF A STALL: ONE verb, one privileged effect. The drain re-claims every
// request when it runs again, so there is nothing for release to claim itself: it clears the record
// (stalled/ is group-writable by the service principal, like requests/) and re-arms the failed path unit with
// belt_exit_stall_rearm_at, the same census site as the exit spool's (the effect is identical: reset-failed
// and start one named system path unit). If a request is still unmovable the drain stalls again at once,
// writing a fresh record: unlike the exit spool's release (belt_exit_stall_release_at refuses while anything is
// unmovable), the drain's next pass is this verb's verification (see gunbc.roadmap.spool_stall). A refused clear skips the re-arm; a refused re-arm is typed with the exact argv.
fn attempt_unit_stall_release_cli() -> ProcessExit {
  belt_instance_from_env(entry: "attempt_unit_stall_release_cli", continuation: instance =>
    match desired_deployment_for_instance_id(instance_id: instance.instance_id as String) {
      DesiredDeploymentRosterRefused { refusal: r } =>
        exit_failure(reason: join(["attempt_unit_stall_release_cli: desired roster refused: ", desired_roster_refusal_detail(refusal: r)], ""))
      DesiredDeploymentUnknownInstanceId { instance_id: id } =>
        exit_failure(reason: join(["attempt_unit_stall_release_cli: no desired deployment for instance ", id], ""))
      DesiredDeploymentFound { row: row } =>
        match spool_stall_clear_at(record_path: attempt_unit_spool_stall_record_path(instance_root: instance.instance_root as String)) {
          SpoolStallClearRefused { reason } => exit_failure(reason: join(["attempt_unit_stall_release_cli: the stall record was not cleared: ", reason], ""))
          SpoolStallCleared =>
            match belt_exit_stall_rearm_at(path_unit: deployment_attempt_unit_drain_path_unit_name(names: row.names)) {
              BeltExitStallRearmed => ExitSuccess
              BeltExitStallRearmRefused { argv, reason } =>
                exit_failure(reason: join(["attempt_unit_stall_release_cli: the stall record is cleared but the re-arm was refused (", reason, "); run as a privileged operator: ", join(argv, " ")], ""))
            }
        }
    })
}

fn belt_credential_reader_for(instance: HostDashboardInstance, node_id: String, attempt_key: String) -> CredentialReaderStanding {
  credential_reader_standing(process: attempt_process_for_node(
    instance: instance,
    panes: belt_attempt_panes_observe_for_instance(instance: instance),
    node_id: node_id,
    attempt_key: attempt_key,
  ))
}

fn belt_credential_recovery_cli() -> ProcessExit {
  belt_instance_from_env(entry: "belt_credential_recovery_cli", continuation: instance =>
    match desired_deployment_for_instance_id(instance_id: instance.instance_id as String) {
      DesiredDeploymentRosterRefused { refusal: r } =>
        exit_failure(reason: join(["belt_credential_recovery_cli: desired roster refused: ", desired_roster_refusal_detail(refusal: r)], ""))
      DesiredDeploymentUnknownInstanceId { instance_id: id } =>
        exit_failure(reason: join(["belt_credential_recovery_cli: no desired deployment for instance ", id], ""))
      DesiredDeploymentFound { row: row } =>
        match now_epoch_seconds() {
          Absent => exit_failure(reason: "belt_credential_recovery_cli: host clock unreadable")
          Present { value: now } => {
            let unit = deployment_belt_service_unit_name(names: row.names)
            let root = credential_acquisition_slots_root(instance_root: instance.instance_root as String)
            let recovered = credential_recover_root(root: root, now: now, reader_for: rec =>
              belt_credential_reader_for(instance: instance, node_id: rec.node_id, attempt_key: rec.identity))
            let receipt = serialize_json(v: json_object(members: [
              json_kv(key: "unit", value: json_string(s: unit as String)),
              json_kv(key: "slots_root", value: json_string(s: root as String)),
              json_kv(key: "recovered", value: json_string(s: credential_root_recovery_report(r: recovered))),
            ]))
            let receipt_path = join([instance.instance_root as String, "/credential-acquisition-recovery.json"], "")
            if string_length(s: receipt) == 0 {
              exit_failure(reason: "belt_credential_recovery_cli: receipt was empty")
            } else if !Filesystem.Write(path: receipt_path, content: receipt).success {
              exit_failure(reason: join(["belt_credential_recovery_cli: receipt write failed: ", receipt_path, "\n", receipt], ""))
            } else {
              match recovered {
                CredentialRootOk { report: _ } => ExitSuccess
                CredentialRootFailed { report: _ } =>
                  exit_failure(reason: join(["belt_credential_recovery_cli:\n", receipt], ""))
              }
            }
          }
        }
    })
}

fn belt_discover_once_cli() -> ProcessExit {
  belt_instance_from_env(entry: "belt_discover_once_cli", continuation: instance => {
    let discovered = belt_discover_for_instance(instance: instance)
    match belt_discovery_pass_outcome(discovery: discovered) {
      BeltPassRecorded => ExitSuccess
      BeltPassFailed { reason } => exit_failure(reason: join([serialize_json(v: belt_discovery_json(discovery: discovered)), "\n", reason], ""))
      BeltPassDeferred { reason } => exit_failure(reason: reason)
      BeltPassRefused { reason } => exit_failure(reason: reason)
    }
  })
}

fn belt_publication_answer_drain_cli() -> ProcessExit {
  belt_instance_from_env(entry: "belt_publication_answer_drain_cli", continuation: instance => {
    let dir = publication_answer_dir(instance_root: instance.instance_root as String)
    let listing = Filesystem.List(path: dir)
    if !listing.success {
      exit_failure(reason: join(["belt_publication_answer_drain_cli: publication answer directory unreadable: ", dir, " (", listing.error, ")"], ""))
    } else {
      let names = filter(xs: split(s: listing.entries, delimiter: "\n"), f: e => trim(e) != "")
      let failures = names |> flat_map(n => {
        let path = join([dir, "/", trim(n)], "")
        let read = Filesystem.Read(path: path)
        if !read.success {
          [join(["unreadable answer ", path, ": ", read.error], "")]
        } else {
          match publication_receipt_decode(receipt: read.content) {
            ReceiptUndecodable { reason } => [join(["undecodable answer ", path, ": ", reason], "")]
            ReceiptDecoded { receipt } =>
              match belt_attempt_obligations_enqueue(instance: instance, node_id: receipt.subject.node_id, attempt_key: receipt.subject.attempt_key) {
                BeltObligationEnqueueRefused { unit: u, reason: r } => [join([u as String, ": ", r], "")]
                BeltObligationStarted { unit: _ } => [] as List<String>
                BeltObligationHeld { unit: _ } => [] as List<String>
              }
          }
        }
      })
      if count(failures) == 0 { ExitSuccess } else { exit_failure(reason: join(failures, "\n")) }
    }
  })
}

fn belt_launch_enqueue_cli() -> ProcessExit {
  belt_instance_from_env(entry: "belt_launch_enqueue_cli", continuation: instance =>
    belt_obligations_enqueued_exit(context: "belt_launch_enqueue_cli", enqueues: [belt_instance_obligation_enqueue(instance: instance, kind: LaunchObligation)]))
}
