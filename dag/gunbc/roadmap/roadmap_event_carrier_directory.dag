module gunbc.roadmap.roadmap_event_carrier_directory

import std.types { String, NonEmptyStr }
import gunbc.roadmap_dashboard_instance { HostDashboardInstance, dashboard_instance_shared_directory }
import gunbc.owned_directory { OwnedDirectoryTarget }

// The event carrier's directory demand, split out of gunbc.roadmap.roadmap_event_carrier so that
// gunbc.roadmap.dashboard_instance_directories can list it without importing the carrier and,
// through it, the dispatch actuator: that edge closed an import cycle through gunbc.host_standup,
// gunbc.host_effect and gunbc.live_deploy.spec.
data roadmap_events_worktree_child: String = "roadmap-events"

// THE DIRECTORY THE CARRIER DEMANDS: the worktree it checks the event branch out into, under the instance
// root. The carrier's `git worktree add` cannot create it where the instance root is not the service
// principal's to write (srv1's /opt/gunbc is root-owned), which is what answered every issue page 503;
// so the directory is a target both deployment routes ensure (gunbc.roadmap.dashboard_instance_directories)
// and the layout's worktree is read off it. The worktree is checked out INTO the ensured directory --
// roadmap_event_carrier_ensure treats an empty directory as one to check out into, not as a worktree.
fn roadmap_event_carrier_directory(instance: HostDashboardInstance) -> OwnedDirectoryTarget {
  dashboard_instance_shared_directory(instance: instance, member: "roadmap-events" as NonEmptyStr, child: roadmap_events_worktree_child)
}
