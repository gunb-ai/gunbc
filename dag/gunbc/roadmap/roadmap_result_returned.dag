// WHAT AN ATTEMPT FINALLY CAME TO, AS THE REQUESTER IS OWED IT. The classification is not made
// here: it is gunbc.roadmap.roadmap_submission CandidateHandoffState, the state the attempt row
// already shows, read off the progress carrier. This fold only says which of those states are FINAL
// -- no later observation of the same attempt can move past them -- because a result is appended
// once and never revised. Published is final (a pull request offers this exact head); a failed
// verification is final (a verdict was read for this head); a worker's own declaration that it is
// blocked or needs context is final (the declaration is captured for this head).
//
// EVERYTHING ELSE IS PENDING, INCLUDING STATES THAT LOOK LIKE ENDINGS. Evidence the belt could not
// read may become readable; a blocked integration or publication may be repaired or re-observed;
// and a worker that ended with no captured submission (yielded) has ended a TURN, not answered the
// request -- its lineage continues through a continuation turn or its supervisor. Returning any of
// those would put an answer on the log that a later tick contradicts.
// DECLARED FRONTIER: a lineage that ends without a candidate (a supervisor's plan-defect or stuck
// verdict, an exhausted escalation) IS a final answer and is owed a result; no handoff state
// carries it, so this fold cannot return it. The trigger is the change that gives the result pass
// the lineage's terminal verdict as an input.
//
// Unstatable is the refusal arm: a published state with no pull request or head to name cannot be
// spelled as a result, and inventing either would be the fabricated answer.
type AttemptResultStanding
  = AttemptResultTerminal { outcome: AttemptResultOutcome }
  | AttemptResultPending { handoff: String }
  | AttemptResultUnstatable { reason: String }

fn attempt_result_standing(handoff: CandidateHandoffState) -> AttemptResultStanding {
  match handoff {
    HandoffAwaitingWorker => AttemptResultPending { handoff: candidate_handoff_state_key(state: handoff) }
    HandoffSubmitted { head_sha: _ } => AttemptResultPending { handoff: candidate_handoff_state_key(state: handoff) }
    HandoffAwaitingIntegration { head_sha: _ } => AttemptResultPending { handoff: candidate_handoff_state_key(state: handoff) }
    HandoffPublicationOwed { head_sha: _ } => AttemptResultPending { handoff: candidate_handoff_state_key(state: handoff) }
    HandoffYielded { reason: _ } => AttemptResultPending { handoff: candidate_handoff_state_key(state: handoff) }
    HandoffEvidenceRefused { reason: _ } => AttemptResultPending { handoff: candidate_handoff_state_key(state: handoff) }
    HandoffBlockedOnIntegration { head_sha: _, cause: _ } => AttemptResultPending { handoff: candidate_handoff_state_key(state: handoff) }
    HandoffBlockedOnPublication { head_sha: _, cause: _ } => AttemptResultPending { handoff: candidate_handoff_state_key(state: handoff) }
    HandoffPublished { head_sha, pr_number: _, url } =>
      if url == "" || head_sha == "" {
        AttemptResultUnstatable { reason: "the attempt reads as published but its pull request or head is empty, so there is no result to name" }
      } else {
        AttemptResultTerminal { outcome: ResultPublished { pr: url as NonEmptyStr, head: head_sha as NonEmptyStr } }
      }
    HandoffVerificationFailed { head_sha, verdict_key } =>
      if head_sha == "" {
        AttemptResultUnstatable { reason: "verification failed for a head that is empty, so the result has no subject to name" }
      } else {
        AttemptResultTerminal { outcome: ResultVerificationFailed {
          head: head_sha as NonEmptyStr,
          cause: join(["verdict ", verdict_key], "") as NonEmptyStr,
        } }
      }
    HandoffDeclaredBlocked { head_sha, readiness, explanation } =>
      AttemptResultTerminal { outcome: ResultHandedBack {
        reason: join(["the worker declared ", submission_readiness_key(r: readiness), " at ", head_sha, ": ", explanation], "") as NonEmptyStr,
      } }
  }
}

fn result_history_refusal(node_envelopes: List<RoadmapEventEnvelope>) -> String? {
  let standing = roadmap_node_standing(envs: node_envelopes)
  let key = roadmap_node_standing_key(s: standing)
  if key == "forked" || key == "history_incomplete" { Present { value: roadmap_node_standing_text(s: standing) } } else { none }
}

// THE REQUEST AN ATTEMPT ANSWERS, JOINED THROUGH ITS LAUNCH BINDING AND NOTHING ELSE. Joined is a
// claim event on THIS issue's history that is a Claimed, with the return_to that event states; the
// issue's current assignment is never consulted, so a later claim or a release changes nothing
// about who this attempt answers. No request is an attempt that was launched unclaimed or before
// bindings were recorded: it has no requester and never will. Unjoinable is a binding that names a
// claim the issue's history does not carry as a Claimed (absent, another issue's, another kind),
// or a launch that could not read the log: a result cannot be addressed and is not addressed.
// Unreadable is a binding file that is there and cannot be read, which may clear.
type ResultRequestJoin
  = ResultRequestJoined { claim: RoadmapEventId, return_to: EventPrincipal }
  | ResultRequestNone { reason: String }
  | ResultRequestUnjoinable { reason: String }
  | ResultRequestUnreadable { reason: String }

fn result_claim_join(node_envelopes: List<RoadmapEventEnvelope>, claim: RoadmapEventId) -> ResultRequestJoin {
  match filter(node_envelopes, e => (e.id as String) == (claim as String)).first() {
    Absent => ResultRequestUnjoinable { reason: join(["the attempt is bound to claim ", claim as String, ", which is not an event on this issue's history"], "") }
    Present { value: env } =>
      match env.event.kind {
        Claimed { assignee: _, return_to } => ResultRequestJoined { claim: env.id, return_to: return_to }
        Released => ResultRequestUnjoinable { reason: join(["the attempt is bound to event ", claim as String, ", which is not a claim"], "") }
        Progress { note: _ } => ResultRequestUnjoinable { reason: join(["the attempt is bound to event ", claim as String, ", which is not a claim"], "") }
        Blocked { reason: _ } => ResultRequestUnjoinable { reason: join(["the attempt is bound to event ", claim as String, ", which is not a claim"], "") }
        HandedBack { reason: _ } => ResultRequestUnjoinable { reason: join(["the attempt is bound to event ", claim as String, ", which is not a claim"], "") }
        ReceiptReferenced { obligation: _, address: _, verdict: _ } => ResultRequestUnjoinable { reason: join(["the attempt is bound to event ", claim as String, ", which is not a claim"], "") }
        CommentCreated { comment: _, body: _, visibility: _, parent_comment: _ } => ResultRequestUnjoinable { reason: join(["the attempt is bound to event ", claim as String, ", which is not a claim"], "") }
        CommentEdited { comment: _, body: _ } => ResultRequestUnjoinable { reason: join(["the attempt is bound to event ", claim as String, ", which is not a claim"], "") }
        CommentDeleted { comment: _ } => ResultRequestUnjoinable { reason: join(["the attempt is bound to event ", claim as String, ", which is not a claim"], "") }
        ResultReturned { attempt: _, claim: _, outcome: _ } => ResultRequestUnjoinable { reason: join(["the attempt is bound to event ", claim as String, ", which is not a claim"], "") }
      }
  }
}

fn result_request_join(binding: AttemptRequestBindingRead, node_envelopes: List<RoadmapEventEnvelope>) -> ResultRequestJoin {
  match binding {
    RequestBindingAbsent => ResultRequestNone { reason: "the attempt recorded no request binding at launch, so no request is known for it" }
    RequestBindingUnreadable { reason } => ResultRequestUnreadable { reason: join(["the attempt's request binding could not be read: ", reason], "") }
    RequestBindingRead { binding: RequestClaimAbsent } => ResultRequestNone { reason: "the attempt was launched on an issue nobody had claimed, so there is no requester" }
    RequestBindingRead { binding: RequestClaimUnobserved { reason } } => ResultRequestUnjoinable { reason: join(["the attempt's request was not observed at launch: ", reason], "") }
    RequestBindingRead { binding: RequestClaimBound { claim } } => result_claim_join(node_envelopes: node_envelopes, claim: claim)
  }
}

// THE WRITE DECISION, PURE, OVER THE NODE'S HISTORY AS READ AND THE JOINED REQUEST. An attempt has
// ONE final result. If the history carries none for the attempt, the result is appended, naming the
// bound claim, authored by the workflow principal, chained on the single head. If it carries
// exactly the event this decision would write -- same attempt, same claim, same outcome -- it is
// already returned and nothing is written. If it carries a result
// that differs in ANY of those, the decision refuses: a second answer for one attempt is the thing
// that must not exist, and deriving one means either the first was not final or the binding moved,
// both of which someone has to look at. A forked or incomplete history refuses, because appending
// on a head the writer could not single out is how a fork becomes three.
type ResultReturnDecision
  = ResultReturnAppend { event: RoadmapEvent }
  | ResultAlreadyReturned { id: RoadmapEventId }
  | ResultReturnRefused { reason: String }

fn result_return_decision(
  node: RoadmapNodeId,
  attempt_key: String,
  claim: RoadmapEventId,
  outcome: AttemptResultOutcome,
  node_envelopes: List<RoadmapEventEnvelope>,
  recorded_at: String,
) -> ResultReturnDecision {
  if attempt_key == "" {
    ResultReturnRefused { reason: "the attempt has no key, so a result could not be addressed to it" }
  } else {
    match result_history_refusal(node_envelopes: node_envelopes) {
      Present { value: why } => ResultReturnRefused { reason: join(["the issue history cannot take a result: ", why], "") }
      Absent => {
        let wanted = ResultReturned { attempt: attempt_key as NonEmptyStr, claim: claim, outcome: outcome }
        let existing = roadmap_results_for_attempt(envs: node_envelopes, attempt: attempt_key)
        match existing.first() {
          Present { value: prior } =>
            if count(existing) == 1 && prior.event.kind == wanted {
              ResultAlreadyReturned { id: prior.id }
            } else {
              ResultReturnRefused { reason: join(["attempt ", attempt_key, " already has a final result on this issue (event ", prior.id as String, ") that differs from the one now derived (", attempt_result_outcome_text(o: outcome), " for claim ", claim as String, "); a second result is not written"], "") }
            }
          Absent =>
            ResultReturnAppend {
              event: roadmap_result_returned_event(
                node: node,
                attempt: attempt_key as NonEmptyStr,
                claim: claim,
                outcome: outcome,
                author: EventPrincipalAuthenticated { ref: fabric_workflow_principal },
                parent: match roadmap_event_heads(envs: node_envelopes).first() { Present { value: h } => Present { value: h.id }  Absent => none },
                recorded_at: recorded_at,
              ),
            }
        }
      }
    }
  }
}

// ONE ATTEMPT'S PASS OUTCOME, every arm a named state. Recorded and already-recorded are delivered.
// Not-terminal is an attempt still in motion and stays eligible. No-request and unjoinable are the
// PERMANENT refusals: both are derived from the attempt's durable launch binding on every pass, so
// the record that settles them is that binding and nothing is written beside it. Failed is a result
// that is owed and was not delivered, and stays eligible.
type ResultReturnOutcome
  = ResultReturnRecorded { node_id: String, attempt_key: String, event: String, outcome_word: String }
  | ResultReturnAlreadyRecorded { node_id: String, attempt_key: String, event: String }
  | ResultReturnNotTerminal { node_id: String, attempt_key: String, handoff: String }
  | ResultReturnNoRequest { node_id: String, attempt_key: String, reason: String }
  | ResultReturnUnjoinable { node_id: String, attempt_key: String, reason: String }
  | ResultReturnFailed { node_id: String, attempt_key: String, step: String, reason: String }

fn result_envelopes_of_node(envelopes: List<RoadmapEventEnvelope>, node_id: String) -> List<RoadmapEventEnvelope> {
  filter(envelopes, e => (e.event.node as String) == node_id)
}

// THE ATTEMPTS STILL OWED A LOOK: every attempt in the durable history that has a key and no
// result on the log. The population is the HISTORY (one ref per attempt ever dispatched), not the
// node's current attempt, so an attempt whose result could not be appended -- a refused push, a
// process that died between the tick's receipt and this pass -- is still here on the next pass
// after a newer attempt of the same node has become current.
fn result_return_open_attempts(attempts: List<DispatchAttemptRef>, envelopes: List<RoadmapEventEnvelope>) -> List<DispatchAttemptRef> {
  filter(attempts, a => a.attempt_key != "" && count(roadmap_results_for_attempt(envs: envelopes, attempt: a.attempt_key)) == 0)
}

fn result_return_for_progress(
  layout: RoadmapEventCarrierLayout,
  progress: WorkflowAttemptProgress,
  claim: RoadmapEventId,
  node_envelopes: List<RoadmapEventEnvelope>,
  recorded_at: String,
) -> ResultReturnOutcome {
  match attempt_result_standing(handoff: progress.handoff) {
    AttemptResultPending { handoff } =>
      ResultReturnNotTerminal { node_id: progress.node_id, attempt_key: progress.attempt_key, handoff: handoff }
    AttemptResultUnstatable { reason } =>
      ResultReturnFailed { node_id: progress.node_id, attempt_key: progress.attempt_key, step: "outcome", reason: reason }
    AttemptResultTerminal { outcome } =>
      match result_return_decision(
        node: progress.node_id as NonEmptyStr as RoadmapNodeId,
        attempt_key: progress.attempt_key,
        claim: claim,
        outcome: outcome,
        node_envelopes: node_envelopes,
        recorded_at: recorded_at,
      ) {
        ResultAlreadyReturned { id } =>
          ResultReturnAlreadyRecorded { node_id: progress.node_id, attempt_key: progress.attempt_key, event: id as String }
        ResultReturnRefused { reason } =>
          ResultReturnFailed { node_id: progress.node_id, attempt_key: progress.attempt_key, step: "decision", reason: reason }
        ResultReturnAppend { event } =>
          match roadmap_event_append(layout: layout, event: event) {
            EventAppended { id } =>
              ResultReturnRecorded { node_id: progress.node_id, attempt_key: progress.attempt_key, event: id as String, outcome_word: attempt_result_outcome_word(o: outcome) }
            EventAlreadyPresent { id } =>
              ResultReturnAlreadyRecorded { node_id: progress.node_id, attempt_key: progress.attempt_key, event: id as String }
            EventAppendRefused { id: _, step, reason } =>
              ResultReturnFailed { node_id: progress.node_id, attempt_key: progress.attempt_key, step: step, reason: reason }
          }
      }
  }
}

// One attempt of the history. The request is joined FIRST, from the binding file alone, so an
// attempt with no request costs one small read and its evidence is never gathered; only an attempt
// that answers a request has its evidence read, by its own key.
fn result_return_attempt(
  instance: HostDashboardInstance,
  layout: RoadmapEventCarrierLayout,
  panes: BeltAttemptPanes,
  attempt: DispatchAttemptRef,
  envelopes: List<RoadmapEventEnvelope>,
  recorded_at: String,
) -> ResultReturnOutcome {
  let node_id = attempt.node_id as String
  let node_envelopes = result_envelopes_of_node(envelopes: envelopes, node_id: node_id)
  match result_request_join(
    binding: attempt_request_binding_read_for_instance(instance: instance, node_id: attempt.node_id as RoadmapNodeId, attempt_key: attempt.attempt_key),
    node_envelopes: node_envelopes,
  ) {
    ResultRequestNone { reason } => ResultReturnNoRequest { node_id: node_id, attempt_key: attempt.attempt_key, reason: reason }
    ResultRequestUnjoinable { reason } => ResultReturnUnjoinable { node_id: node_id, attempt_key: attempt.attempt_key, reason: reason }
    ResultRequestUnreadable { reason } => ResultReturnFailed { node_id: node_id, attempt_key: attempt.attempt_key, step: "request-binding", reason: reason }
    ResultRequestJoined { claim, return_to: _ } =>
      result_return_for_progress(
        layout: layout,
        progress: workflow_attempt_progress(evidence: belt_workflow_attempt_evidence_for_key(instance: instance, panes: panes, attempt: attempt, current_key: attempt.attempt_key)),
        claim: claim,
        node_envelopes: node_envelopes,
        recorded_at: recorded_at,
      )
  }
}

// THE PASS. Ran carries one outcome per attempt it considered; Withheld is an instance that must
// not write (observe-only); Refused is a pass that could not read what it decides over, named by
// the step, never an empty roster.
type ResultReturnPass
  = ResultReturnPassRan { outcomes: List<ResultReturnOutcome> }
  | ResultReturnPassWithheld { reason: String }
  | ResultReturnPassRefused { step: String, reason: String }

// THE BELT'S RESULT-RETURN RECONCILIATION, run by every tick (gunbc.roadmap_belt_tick_cli
// belt_run_once_cli_in) whether or not the tick's other passes ran: an outstanding result is a
// durable obligation, and a launch or authority refusal elsewhere does not discharge it. It reads
// the event log once and the attempt refs once, and considers every attempt of the history that
// has no result on the log. Nothing is remembered between passes -- delivery is whatever the log
// says, so a pass that failed, or never ran, is repeated by the next one.
fn result_return_attempts_for_instance(instance: HostDashboardInstance, recorded_at: String) -> ResultReturnPass {
  match instance.actuation {
    DashboardObserveOnly =>
      ResultReturnPassWithheld { reason: join(["dashboard instance ", instance.instance_id as String, " is observe-only, so no result was appended"], "") }
    DashboardActuating => {
      let layout = roadmap_event_carrier_layout_for_instance(instance: instance)
      match roadmap_events_read_all(layout: layout) {
        AllEventsReadRefused { step, reason } => ResultReturnPassRefused { step: join(["events/", step], ""), reason: reason }
        AllEventsRead { envelopes } =>
          match belt_attempts_observe_for_instance(instance: instance) {
            AttemptsRefused { reason } => ResultReturnPassRefused { step: "attempts", reason: reason }
            AttemptsObserved { attempts } => {
              let open = result_return_open_attempts(attempts: attempts, envelopes: envelopes)
              if count(open) == 0 {
                ResultReturnPassRan { outcomes: [] }
              } else {
                let panes = belt_attempt_panes_observe_for_instance(instance: instance)
                ResultReturnPassRan {
                  outcomes: map(open, a => result_return_attempt(instance: instance, layout: layout, panes: panes, attempt: a, envelopes: envelopes, recorded_at: recorded_at)),
                }
              }
            }
          }
      }
    }
  }
}

fn result_return_outcome_failure_line(o: ResultReturnOutcome) -> String? {
  match o {
    ResultReturnFailed { node_id, attempt_key, step, reason } =>
      Present { value: join([node_id, " attempt ", attempt_key, " (", step, "): ", reason], "") }
    ResultReturnRecorded { node_id: _, attempt_key: _, event: _, outcome_word: _ } => none
    ResultReturnAlreadyRecorded { node_id: _, attempt_key: _, event: _ } => none
    ResultReturnNotTerminal { node_id: _, attempt_key: _, handoff: _ } => none
    ResultReturnNoRequest { node_id: _, attempt_key: _, reason: _ } => none
    ResultReturnUnjoinable { node_id: _, attempt_key: _, reason: _ } => none
  }
}

// WHAT THE PASS OWES THE TICK'S EXIT: absent when everything owed was delivered or is honestly not
// owed yet, present with every undelivered attempt and its step when something was not.
fn result_return_pass_failure(pass: ResultReturnPass) -> String? {
  match pass {
    ResultReturnPassWithheld { reason: _ } => none
    ResultReturnPassRefused { step, reason } =>
      Present { value: join(["result return could not run (", step, "): ", reason], "") }
    ResultReturnPassRan { outcomes } => {
      let failures = fold(outcomes, init: [], f: (acc, o) => match result_return_outcome_failure_line(o: o) {
        Present { value: line } => concat(acc, [line])
        Absent => acc
      })
      if count(failures) > 0 {
        Present { value: join([to_string(value: count(failures)), " attempt result(s) could not be returned: ", join(failures, "; ")], "") }
      } else {
        none
      }
    }
  }
}

// A RESULT THAT IS OWED AND WAS NOT DELIVERED STOPS THE LINE: a nonzero exit naming each attempt and
// the step that refused. Not-terminal, no-request and unjoinable are counted outcomes, never
// failures.
fn result_return_pass_exit(pass: ResultReturnPass) -> ProcessExit {
  match result_return_pass_failure(pass: pass) {
    Present { value: reason } => exit_failure(reason: reason)
    Absent => ExitSuccess
  }
}

// WHAT A READER OF ONE ATTEMPT GETS. Observed is the attempt's one result, with the issue it is on,
// the event that states it, the claim it answers and the principal that claim returns to. Not
// returned is a readable log with no result for this attempt -- an absence, not a refusal.
// Ambiguous is one attempt key answered on more than one issue, which no attempt can be.
// Unobserved is everything that is neither: a log that could not be read, a history that cannot be
// ordered, more than one result for the attempt, or a result whose claim the history does not
// carry -- each named by its step.
type ResultReturnedObservation
  = ResultReturnedObserved { node: RoadmapNodeId, event: RoadmapEventId, claim: RoadmapEventId, return_to: EventPrincipal, outcome: AttemptResultOutcome, recorded_at: String }
  | ResultNotReturned { attempt_key: String }
  | ResultReturnedAmbiguous { attempt_key: String, nodes: List<String> }
  | ResultReturnedUnobserved { step: String, reason: String }

fn result_distinct_nodes(envelopes: List<RoadmapEventEnvelope>) -> List<String> {
  fold(envelopes, init: [], f: (acc, e) => if any(acc, n => n == (e.event.node as String)) { acc } else { concat(acc, [e.event.node as String]) })
}

// The result event joined to its claim: the event carries no principal, so the return_to the reader
// answers with IS the claim's, and a result whose claim the history does not carry as a Claimed has
// no recipient to report.
fn result_returned_observation_of_envelope(env: RoadmapEventEnvelope, node_envelopes: List<RoadmapEventEnvelope>) -> ResultReturnedObservation {
  match env.event.kind {
    ResultReturned { attempt: _, claim, outcome } =>
      match result_claim_join(node_envelopes: node_envelopes, claim: claim) {
        ResultRequestJoined { claim: joined, return_to } =>
          ResultReturnedObserved { node: env.event.node, event: env.id, claim: joined, return_to: return_to, outcome: outcome, recorded_at: env.event.recorded_at }
        ResultRequestUnjoinable { reason } => ResultReturnedUnobserved { step: "claim", reason: reason }
        ResultRequestNone { reason } => ResultReturnedUnobserved { step: "claim", reason: reason }
        ResultRequestUnreadable { reason } => ResultReturnedUnobserved { step: "claim", reason: reason }
      }
    Claimed { assignee: _, return_to: _ } => ResultReturnedUnobserved { step: "kind", reason: "the selected event is not a result" }
    Released => ResultReturnedUnobserved { step: "kind", reason: "the selected event is not a result" }
    Progress { note: _ } => ResultReturnedUnobserved { step: "kind", reason: "the selected event is not a result" }
    Blocked { reason: _ } => ResultReturnedUnobserved { step: "kind", reason: "the selected event is not a result" }
    HandedBack { reason: _ } => ResultReturnedUnobserved { step: "kind", reason: "the selected event is not a result" }
    ReceiptReferenced { obligation: _, address: _, verdict: _ } => ResultReturnedUnobserved { step: "kind", reason: "the selected event is not a result" }
    CommentCreated { comment: _, body: _, visibility: _, parent_comment: _ } => ResultReturnedUnobserved { step: "kind", reason: "the selected event is not a result" }
    CommentEdited { comment: _, body: _ } => ResultReturnedUnobserved { step: "kind", reason: "the selected event is not a result" }
    CommentDeleted { comment: _ } => ResultReturnedUnobserved { step: "kind", reason: "the selected event is not a result" }
  }
}

// THE READ, PURE OVER THE LOG AS READ, so a witness drives it with constructed envelopes while the
// carrier read stays in result_returned_observe_for_attempt. The attempt key is the join: the result
// event names its attempt, so no ledger beside the log is consulted to find the issue.
fn result_returned_observation_of(read: RoadmapAllEventsRead, attempt_key: String) -> ResultReturnedObservation {
  if attempt_key == "" {
    ResultReturnedUnobserved { step: "attempt-key", reason: "the attempt key is empty, so there is no attempt to read a result for" }
  } else {
    match read {
      AllEventsReadRefused { step, reason } => ResultReturnedUnobserved { step: join(["events/", step], ""), reason: reason }
      AllEventsRead { envelopes } => {
        let nodes = result_distinct_nodes(envelopes: roadmap_results_for_attempt(envs: envelopes, attempt: attempt_key))
        if count(nodes) > 1 {
          ResultReturnedAmbiguous { attempt_key: attempt_key, nodes: nodes }
        } else {
          match nodes.first() {
            Absent => ResultNotReturned { attempt_key: attempt_key }
            Present { value: node_id } => {
              let node_envelopes = result_envelopes_of_node(envelopes: envelopes, node_id: node_id)
              match result_history_refusal(node_envelopes: node_envelopes) {
                Present { value: why } => ResultReturnedUnobserved { step: "history", reason: join(["issue ", node_id, ": ", why], "") }
                Absent => {
                  let results = roadmap_results_for_attempt(envs: node_envelopes, attempt: attempt_key)
                  if count(results) > 1 {
                    ResultReturnedUnobserved { step: "result-duplicate", reason: join(["issue ", node_id, " carries ", to_string(value: count(results)), " results for attempt ", attempt_key, "; an attempt has one"], "") }
                  } else {
                    match results.first() {
                      Present { value: env } => result_returned_observation_of_envelope(env: env, node_envelopes: node_envelopes)
                      Absent => ResultNotReturned { attempt_key: attempt_key }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

// ONE ATTEMPT'S RESULT, READ FROM THE INSTANCE'S EVENT LOG: the log is read once and answered for
// the attempt. Its consumer in this module is result_returned_report, the operator's entry.
// DECLARED FRONTIER: the dogfood route receipt (operator ruling 2026-10-03) is to fold this reader as
// its result-returned stage; the trigger is the change that makes that receipt call it -- until then
// no receipt consumes this function and none is claimed.
fn result_returned_observe_for_attempt(instance: HostDashboardInstance, attempt_key: String) -> ResultReturnedObservation {
  result_returned_observation_of(
    read: roadmap_events_read_all(layout: roadmap_event_carrier_layout_for_instance(instance: instance)),
    attempt_key: attempt_key,
  )
}

fn result_returned_observation_text(o: ResultReturnedObservation) -> String {
  match o {
    ResultReturnedObserved { node, event, claim, return_to, outcome, recorded_at } =>
      join(["returned on issue ", node as String, " (event ", event as String, ", ", recorded_at, ") for claim ", claim as String, " to ", event_principal_label(p: return_to), ": ", attempt_result_outcome_text(o: outcome)], "")
    ResultNotReturned { attempt_key } => join(["no result has been returned for attempt ", attempt_key], "")
    ResultReturnedAmbiguous { attempt_key, nodes } => join(["attempt ", attempt_key, " has results on more than one issue: ", join(nodes, ", ")], "")
    ResultReturnedUnobserved { step, reason } => join(["the result could not be read (", step, "): ", reason], "")
  }
}

// THE OPERATOR'S READ OF ONE ATTEMPT'S RESULT, a String because `gunbc run` prints a String return
// inside its typed envelope (gunbc.roadmap.roadmap_event_cli roadmap_event_standing_report):
//   gunbc run --entry dag/gunbc/roadmap/roadmap_result_returned.dag --function result_returned_report \
//     --arg repo_root=<instance repo> --arg attempt_key=<key>
fn result_returned_report(repo_root: String, attempt_key: String) -> String {
  match dashboard_instance_for_repo_root(repo_root: repo_root) {
    DashboardInstanceRootUnknown { repo_root: w } => join(["result_returned_report: no dashboard instance is rooted at ", w], "")
    DashboardInstanceResolved { instance } =>
      result_returned_observation_text(o: result_returned_observe_for_attempt(instance: instance, attempt_key: attempt_key))
  }
}
