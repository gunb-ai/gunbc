import extdeps.http.server {
  MediaType,
  text_plain_utf8,
  application_json_utf8,
  ServedStaticRoute,
}
import std.markup { Fragment }
import extdeps.languages.html { EmitOk, EmitRejected, try_serialize_html_source }
import gunbc.roadmap.roadmap_site_surface_observe { materialize_live_roadmap_site_surface_bundle }
import gunbc.roadmap.roadmap_site_surface_render {
  roadmap_site_health_path,
  roadmap_site_dispatch_url_path,
  roadmap_site_daily_url_path,
  roadmap_site_service_name,
  site_artifact_digest,
  served_page_body,
  healthz_body_from_surface_artifacts,
  healthz_body_with_release_identity,
}
import gunbc.roadmap.roadmap_authority {
  roadmap_acceptance_event_history_load,
  RoadmapAuthorityProjection, roadmap_authority_projection,
  authored_merged_prs,
}
import gunbc.roadmap.roadmap_spawner { roadmap_dispatch_file_content_for_projection }
import gunbc.roadmap.roadmap_page { roadmap_page_for_authority, roadmap_daily_workspace_page_for_authority }
import gunbc.roadmap.roadmap_component { dispatch_client_js_source, roadmap_dispatch_asset_path }
import gunbc.fleet.fleet_intent_network { fleet_intent_network }
import extdeps.languages.json.emit {
  serialize_json,
  json_object,
  json_kv,
  json_string,
  JsonKeyValue,
}
import extdeps.ietf.http_semantics { HttpMethod, GET }

type SiteArtifactKind
  = RoadmapDispatchJson
  | HtmlIndex

type SiteArtifact {
  kind: SiteArtifactKind
  url_path: NonEmptyStr
  body: String
  digest: Fnv1a64Structural
}

type WebServiceShape {
  cpu: Millicore
  memory: Mebibyte
  port: Port
  stateless: Bool
  health_path: NonEmptyStr
}

type DomainRoute {
  tailnet_domain: String?
  dns_manual: Bool
}

type StaticSiteAllocation {
  artifacts: List<SiteArtifact>
  service: WebServiceShape
  route: DomainRoute
}

// healthz is the served surface's FINGERPRINT DOCUMENT, not just a liveness ping. It publishes
// digests for the surface this tree renders ahead of time — the dispatch JSON, the daily page at /
// and the modeled dispatch asset (the /roadmap page and /ROADMAP.md were cut from serving on
// 2026-10-04 and left this document with their routes) — because those are exactly the bodies
// that went stale. The motivating incident (2026-07-24): the live srv1 page served
// `.node-superseded &gt; .title` (the escaped selector that kills the strikethrough), `width`
// instead of `min-width` on the status chip, no `<details>` disclosure and no centering, while the
// tree carried all four fixes — and nothing anywhere could observe the gap, because `gunbc serve`
// binds its compiled graph ONCE at process start, so a served page lags the tree until the unit is
// restarted AND nothing compares the two. Publishing the digests makes the comparison a plain body
// equality against this same function evaluated on the deploying tree
// (roadmap_site_healthz_surface_current), so there is no second definition of the page to drift
// from: the digest is taken over the SAME body the route serves, via the shared served_page_body /
// page_render_refusal_body pair in gunbc.roadmap.roadmap_site_surface_render. Cost measured before it was
// adopted rather than assumed, because the readiness poll calls this repeatedly: a live srv1 render
// was ~15 ms for the daily page, against a poll bound in the tens of seconds.

// THE PLAN IS A PARAMETER, AND THE NULLARY IS ONE BINDING OF IT. The text body is a projection
// of a roadmap authority, so the fold takes the projected plan and the zero-argument form supplies
// the public one. A caller serving a different plan -- an entry function in another repository --
// reaches the same fold with its own projection rather than a second copy of this body, and a
// plan that failed to project arrives as RoadmapAuthorityProjectionRefused and refuses through the
// same arm the public plan would.
fn roadmap_site_dispatch_json_body_over(plan: RoadmapAuthorityProjection) -> String {
  roadmap_dispatch_file_content_for_projection(proj: plan)
}

fn roadmap_site_dispatch_json_body() -> String {
  roadmap_site_dispatch_json_body_over(plan: roadmap_authority_projection(history: roadmap_acceptance_event_history_load()))
}

// STATIC SITE BINDING, DISTINCT FROM THE LIVE ROUTE. This artifact is
// roadmap_authority_projection(history) with no runtime tasks. The live serve
// route (DispatchJsonHandler) uses roadmap_site_dispatch_json_body_over(plan:
// roadmap_plan_projection()) — declared rows plus the roster. Consumers of this
// static artifact: roadmap_site_static_allocation / roadmap_site_text_artifacts,
// roadmap_site_text_static_routes,
// and test.claim.roadmap.roadmap_static_site_witness. Live digest readback does
// not consume it.
fn roadmap_site_dispatch_json_artifact() -> SiteArtifact {
  let body = roadmap_site_dispatch_json_body()
  SiteArtifact {
    kind: RoadmapDispatchJson,
    url_path: roadmap_site_dispatch_url_path,
    body: body,
    digest: site_artifact_digest(body: body),
  }
}

fn roadmap_site_text_artifacts() -> List<SiteArtifact> {
  [
    roadmap_site_dispatch_json_artifact(),
  ]
}

fn roadmap_site_web_service_shape() -> WebServiceShape {
  WebServiceShape {
    cpu: millicore(count: 100),
    memory: mebibyte(count: 128),
    port: 8080,
    stateless: true,
    health_path: roadmap_site_health_path,
  }
}

fn roadmap_site_domain_route() -> DomainRoute {
  DomainRoute {
    tailnet_domain: fleet_intent_network.tailnet_domain,
    dns_manual: true,
  }
}

fn roadmap_site_static_allocation() -> StaticSiteAllocation {
  StaticSiteAllocation {
    artifacts: roadmap_site_text_artifacts(),
    service: roadmap_site_web_service_shape(),
    route: roadmap_site_domain_route(),
  }
}

fn roadmap_site_path_template(raw: String) -> PathTemplate {
  match parse_path_template(raw: raw) {
    ParsedPathTemplate { template: t } => t
    MalformedPathTemplate { raw: _, segment: _, reason: _ } =>
      PathTemplate { tokens: [LiteralToken { text: raw }] }
  }
}

fn served_surface_digest_kv(url_path: NonEmptyStr, body: String) -> JsonKeyValue {
  json_kv(key: url_path as String, value: json_string(s: site_artifact_digest(body: body).digest as String))
}

fn roadmap_site_healthz_body() -> String {
  materialize_live_roadmap_site_surface_bundle().healthz_body
}

fn roadmap_site_healthz_body_for_release(release_revision: CommitSha) -> String {
  let bundle = materialize_live_roadmap_site_surface_bundle()
  healthz_body_with_release_identity(
    dispatch: bundle.dispatch_json,
    daily: bundle.daily_html,
    dispatch_js: bundle.dispatch_js,
    release_revision: release_revision,
    surface_bundle_identity: bundle.bundle_identity,
  )
}

// THE SERVED /healthz DOCUMENT, AND THE ONLY ONE A CLIENT EVER SEES. It is the bundle's surface
// members plus the two launch-identity members, assembled from the SAME materialized bundle the
// route renders from — so the digests published here are digests of the bodies this process
// actually serves, not of a second rendering that could differ. roadmap_site_healthz_body (surface
// only) is retained as the deploy-side EXPECTED projection: the deploying tree computes it to
// answer 'what should the surface be', while the running process answers 'what is the surface, and
// which release am I'. Those are two different questions asked of two different parties, which is
// why both functions exist and why neither is a copy of the other.

fn roadmap_site_healthz_route() -> ServedStaticRoute {
  ServedStaticRoute {
    method: GET,
    path_pattern: roadmap_site_path_template(raw: roadmap_site_health_path),
    body: roadmap_site_healthz_body(),
    content_type: application_json_utf8,
    status_on_hit: 200,
  }
}

fn roadmap_site_text_route(artifact: SiteArtifact, content_type: MediaType) -> ServedStaticRoute {
  ServedStaticRoute {
    method: GET,
    path_pattern: roadmap_site_path_template(raw: artifact.url_path),
    body: artifact.body,
    content_type: content_type,
    status_on_hit: 200,
  }
}

// STATIC ROUTE TABLE for the static-site allocation model. The live
// gunbc.roadmap.roadmap_serve handler table is a different binding. Consumers:
// roadmap_site_static_route_literal_paths and
// test.claim.roadmap.roadmap_static_site_witness.
fn roadmap_site_text_static_routes() -> List<ServedStaticRoute> {
  [
    roadmap_site_text_route(
      artifact: roadmap_site_dispatch_json_artifact(),
      content_type: application_json_utf8,
    ),
    roadmap_site_healthz_route(),
  ]
}

fn roadmap_site_static_route_authority_paths() -> List<String> {
  concat(
    map(roadmap_site_text_artifacts(), a => a.url_path as String),
    [roadmap_site_health_path as String]
  )
}

fn served_static_route_literal_path(route: ServedStaticRoute) -> String {
  fold(route.path_pattern.tokens, init: "", f: (acc, tok) => match tok {
    LiteralToken { text: t } => concat(acc, t)
    ParamToken { name: _ } => acc
  })
}

fn roadmap_site_static_route_literal_paths() -> List<String> {
  map(roadmap_site_text_static_routes(), r => served_static_route_literal_path(route: r))
}

