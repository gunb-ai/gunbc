module gunbc.roadmap_allocation_style

import std.types { String, List }
import gunbc.design.material { BuildRule, StaticRule, serialize_rules, decl }
import extdeps.languages.css.selectors { ClassSelector, RawSelector }
import extdeps.languages.css.properties { AlignItems, Background, Border, BorderLeft, BorderRadius, BoxSizing, Color, Cursor, Display, Flex, FlexDirection, FlexWrap, FontFamily, FontSize, FontWeight, Gap, GridTemplateColumns, LetterSpacing, LineHeight, Margin, MarginTop, MaxWidth, MinWidth, Outline, Padding, Width }

// Allocation content is a modeled input to the shared shell. Its remaining raw
// dimensions are visible to the scale census; they are not shared-shell overrides.
fn allocation_rules() -> List<BuildRule> {
  [
    StaticRule { selector: ClassSelector { name: "allocation-page" }, decls: [decl(prop: MaxWidth, value: "1040px"), decl(prop: Margin, value: "0 auto"), decl(prop: Padding, value: "32px 20px 64px"), decl(prop: FontFamily, value: "var(--issue-font)"), decl(prop: Color, value: "var(--issue-text)") ] },
    StaticRule { selector: RawSelector { text: ".allocation-page h2" }, decls: [decl(prop: FontSize, value: "30px"), decl(prop: Margin, value: "8px 0 12px"), decl(prop: LineHeight, value: "1.2") ] },
    StaticRule { selector: ClassSelector { name: "allocation-eyebrow" }, decls: [decl(prop: FontSize, value: "11px"), decl(prop: LetterSpacing, value: "0.12em"), decl(prop: Color, value: "var(--issue-text-dim)") ] },
    StaticRule { selector: ClassSelector { name: "allocation-intro" }, decls: [decl(prop: FontSize, value: "16px"), decl(prop: LineHeight, value: "1.6"), decl(prop: MaxWidth, value: "65ch") ] },
    StaticRule { selector: ClassSelector { name: "allocation-notice" }, decls: [decl(prop: Padding, value: "16px 20px"), decl(prop: Margin, value: "24px 0"), decl(prop: Border, value: "1px solid var(--issue-border)"), decl(prop: BorderLeft, value: "3px solid var(--issue-action)"), decl(prop: Background, value: "var(--issue-bg-subtle)"), decl(prop: BorderRadius, value: "6px") ] },
    StaticRule { selector: RawSelector { text: ".allocation-page p" }, decls: [decl(prop: LineHeight, value: "1.6") ] },
    StaticRule { selector: ClassSelector { name: "allocation-layout" }, decls: [decl(prop: Display, value: "flex"), decl(prop: FlexWrap, value: "wrap"), decl(prop: Gap, value: "24px"), decl(prop: AlignItems, value: "flex-start") ] },
    StaticRule { selector: RawSelector { text: ".allocation-layout form" }, decls: [decl(prop: Flex, value: "2 1 400px"), decl(prop: MinWidth, value: "0") ] },
    StaticRule { selector: ClassSelector { name: "allocation-card" }, decls: [decl(prop: Flex, value: "1 1 260px"), decl(prop: MinWidth, value: "0"), decl(prop: Padding, value: "24px"), decl(prop: Border, value: "1px solid var(--issue-border)"), decl(prop: BorderRadius, value: "8px"), decl(prop: Background, value: "var(--issue-bg-subtle)") ] },
    StaticRule { selector: RawSelector { text: ".allocation-page fieldset" }, decls: [decl(prop: Margin, value: "0"), decl(prop: Padding, value: "24px"), decl(prop: MinWidth, value: "0"), decl(prop: Border, value: "1px solid var(--issue-border)"), decl(prop: BorderRadius, value: "8px") ] },
    StaticRule { selector: RawSelector { text: ".allocation-page legend" }, decls: [decl(prop: FontSize, value: "18px"), decl(prop: FontWeight, value: "600"), decl(prop: Padding, value: "0 8px") ] },
    StaticRule { selector: ClassSelector { name: "allocation-fields" }, decls: [decl(prop: Display, value: "grid"), decl(prop: GridTemplateColumns, value: "repeat(auto-fit, minmax(min(180px, 100%), 1fr))"), decl(prop: Gap, value: "24px") ] },
    StaticRule { selector: ClassSelector { name: "allocation-field" }, decls: [decl(prop: Display, value: "flex"), decl(prop: FlexDirection, value: "column"), decl(prop: Gap, value: "8px"), decl(prop: MinWidth, value: "0") ] },
    StaticRule { selector: RawSelector { text: ".allocation-field label" }, decls: [decl(prop: FontWeight, value: "600"), decl(prop: FontSize, value: "14px") ] },
    StaticRule { selector: RawSelector { text: ".allocation-field input" }, decls: [decl(prop: Width, value: "100%"), decl(prop: BoxSizing, value: "border-box"), decl(prop: Padding, value: "10px 12px"), decl(prop: Border, value: "1px solid var(--issue-border)"), decl(prop: BorderRadius, value: "4px"), decl(prop: Background, value: "var(--issue-bg)"), decl(prop: Color, value: "var(--issue-text)"), decl(prop: FontSize, value: "16px") ] },
    StaticRule { selector: RawSelector { text: ".allocation-field small, .allocation-muted" }, decls: [decl(prop: Color, value: "var(--issue-text-dim)"), decl(prop: FontSize, value: "13px") ] },
    StaticRule { selector: RawSelector { text: ".allocation-page button" }, decls: [decl(prop: Padding, value: "10px 16px"), decl(prop: BorderRadius, value: "4px"), decl(prop: Border, value: "1px solid var(--issue-border)"), decl(prop: Background, value: "var(--issue-action)"), decl(prop: Color, value: "white"), decl(prop: FontSize, value: "14px"), decl(prop: Cursor, value: "pointer") ] },
    StaticRule { selector: RawSelector { text: ".allocation-page button:disabled" }, decls: [decl(prop: Background, value: "var(--issue-bg-hover)"), decl(prop: Color, value: "var(--issue-text-dim)"), decl(prop: Cursor, value: "not-allowed") ] },
    StaticRule { selector: RawSelector { text: ".allocation-page input:focus-visible, .allocation-page button:focus-visible" }, decls: [decl(prop: Outline, value: "var(--border-2) solid var(--focus)") ] },
    StaticRule { selector: RawSelector { text: ".allocation-page dt" }, decls: [decl(prop: Color, value: "var(--issue-text-dim)"), decl(prop: FontSize, value: "12px"), decl(prop: MarginTop, value: "16px") ] },
    StaticRule { selector: RawSelector { text: ".allocation-page dd" }, decls: [decl(prop: Margin, value: "4px 0 16px") ] },
    StaticRule { selector: ClassSelector { name: "allocation-connection" }, decls: [decl(prop: MarginTop, value: "24px") ] },
    StaticRule { selector: RawSelector { text: ".allocation-card h3" }, decls: [decl(prop: MarginTop, value: "0") ] },
  ]
}

fn allocation_css() -> String {
  serialize_rules(rules: allocation_rules())
}
