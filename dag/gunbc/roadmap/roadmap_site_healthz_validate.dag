module gunbc.roadmap_site_healthz_validate

import extdeps.languages.json.grammar { json_text_trim_trailing_lf }
import gunbc.roadmap_site_surface_observe { materialize_live_roadmap_site_surface_bundle }
import gunbc.roadmap_site_surface_expect {
  roadmap_site_healthz_json_string_parses,
  roadmap_site_healthz_surface_is_current,
}
import gunbc.roadmap_site_surface_types { RoadmapSiteSurfaceBundle }

fn roadmap_site_healthz_body_parses() -> Bool {
  roadmap_site_healthz_json_string_parses(
    body: materialize_live_roadmap_site_surface_bundle().healthz_body
  )
}

// PARSES and IS-THIS-TREE are two different questions about one body, kept as two predicates rather than one: 'the endpoint returned something that is not JSON' and 'the endpoint returned a well-formed fingerprint for a DIFFERENT tree' are different states whose remedies differ (the first is a broken or wrong process, the second is a process that never rebound its graph), and collapsing them would leave the second unlocatable. Freshness is whole-body equality against an already-materialized RoadmapSiteSurfaceBundle — the equality IS the fingerprint comparison the deploy needs, with no second definition of the page to drift from. The trailing-LF trim is the transport's, not the content's: curl over the shell transport can pick one up.
fn roadmap_site_healthz_surface_is_current_for_bundle(
  bundle: RoadmapSiteSurfaceBundle,
  observed_body: String,
) -> Bool {
  roadmap_site_healthz_surface_is_current(bundle: bundle, observed_body: observed_body)
}

fn roadmap_site_healthz_surface_is_current_from_observed_body(observed_body: String) -> Bool {
  let bundle = materialize_live_roadmap_site_surface_bundle()
  roadmap_site_healthz_surface_is_current_for_bundle(bundle: bundle, observed_body: observed_body)
}
