module gunbc.roadmap.roadmap_attempt_continuation

import std.types { String, Bool, Int, List, NonEmptyStr }
import gunbc.roadmap.roadmap_submission {
  SubmissionCaptureObservation, CaptureForHead, CaptureAbsent, CaptureUnreadable,
  SubmissionReady, SubmissionBlocked, SubmissionNeedsContext,
}
import gunbc.roadmap_workflow_stage {
  WorkflowSegment,
  WorkflowSegmentState, WorkflowSegmentPending, WorkflowSegmentActive, WorkflowSegmentComplete,
  WorkflowSegmentFailed, WorkflowSegmentRefused, WorkflowSegmentStopped,
}

// WHETHER A NODE'S NEXT ATTEMPT MAY START. Every attempt starts from the instance's base ref; there
// is no second origin. Until gunbc.plans.harness_session_lifecycle slice S1 a terminal attempt was
// CONTINUED by a new attempt on its branch -- a fresh worker, a fresh conversation, the prior turn's
// verdict at the top of its brief -- and a worker that spent its round budget was restarted that way
// every forty turns. A supervised session no longer ends at a round boundary, so that lane is gone
// with its turn cap, its turn file and its stretch supervisor; a candidate's revision continues the
// worker's own session once hand-in awaits acceptance (slice S2), never a replacement attempt.

// THE FACTS THE DECISION READS, and nothing else: the prior attempt's key and branch, whether its
// worker has ended, what its submission capture says the end meant, and what verification, review
// and the goal audit said. The capture is the same head-grain observation the verify gate reads.
type PriorAttemptFacts {
  node_id: String
  attempt_key: String
  branch: String
  worker_terminal: Bool
  capture: SubmissionCaptureObservation
  verification: WorkflowSegment?
  review: WorkflowSegment?
  goal_audit: WorkflowSegment?
}

// THE VOCABULARY NAMES WHAT THE BELT MAY DO, and Fresh means exactly one fact (branch review
// 2026-09-23, blocker 2): SpawnFresh is "it is established that no prior owned lineage exists for
// this node"; Hold spawns nothing while a verdict or a worker is outstanding; Complete spawns nothing
// because the lineage is fully approved; Ended spawns nothing because the lineage stopped short of
// an approved candidate -- its worker stopped, handed in nothing, declared a blocker, or its
// candidate was judged and found wanting -- and starting over from base would discard committed work
// silently; Refused is the arm that must not widen: a fact the decision needs that cannot be
// established refuses with a located reason the dashboard shows, and the operator decides.
type ContinuationDecision
  = ContinuationSpawnFresh { reason: String }
  | ContinuationRefused { reason: String }
  | ContinuationHold { reason: String }
  | ContinuationComplete { reason: String }
  | ContinuationEnded { reason: String }

fn continuation_decision(prior: PriorAttemptFacts?) -> ContinuationDecision {
  match prior {
    Absent => ContinuationSpawnFresh { reason: "no prior attempt of this node" }
    Present { value: p } =>
      if !p.worker_terminal {
        ContinuationHold { reason: "the prior attempt's worker has not ended; the lineage is active and a second attempt beside it is never spawned" }
      } else {
        continuation_from_capture(prior: p)
      }
  }
}

// THE CAPTURE IS READ BEFORE THE SEGMENTS. A terminal worker's capture is the binding record of
// what its end meant: a submission that declares blocked or needs-context, or no capture at all, is
// a lineage that ended without a candidate, and a capture that cannot be established is refused,
// never read as either. Only a READY capture falls through to the segment arms: that head is a
// candidate, and judging it is verification's job.
fn continuation_from_capture(prior: PriorAttemptFacts) -> ContinuationDecision {
  match prior.capture {
    CaptureUnreadable { reason } =>
      ContinuationRefused {
        reason: join([
          "the submission capture for the prior attempt ", prior.attempt_key,
          " cannot be established: ", reason,
          ", so whether its branch holds a declared candidate is unknown and the decision does not guess",
        ], ""),
      }
    CaptureAbsent =>
      continuation_ended(prior: prior, why: "its worker ended without handing in a candidate; the attempt's event stream records how the session ended")
    CaptureForHead { capture: c } =>
      match c.submission.readiness {
        SubmissionReady => continuation_from_segments(prior: prior)
        SubmissionBlocked =>
          continuation_ended(prior: prior, why: join(["its submission declared blocked: ", continuation_bounded_detail(detail: c.submission.explanation)], ""))
        SubmissionNeedsContext =>
          continuation_ended(prior: prior, why: join(["its submission declared needs-context: ", continuation_bounded_detail(detail: c.submission.explanation)], ""))
      }
  }
}

fn continuation_ended(prior: PriorAttemptFacts, why: String) -> ContinuationDecision {
  ContinuationEnded {
    reason: join([
      "the lineage ending at attempt ", prior.attempt_key, " (branch ", prior.branch, ") stopped short of an approved candidate: ", why,
      " -- its work stays on that branch, and no attempt is started over it",
    ], ""),
  }
}

// A WORKER-AUTHORED EXPLANATION IS UNBOUNDED TEXT, and it lands in a reason the dashboard shows; the
// decision carries at most this much of it. The truncation is marked so a cut explanation is never
// mistaken for a whole one.
data continuation_verdict_detail_bound: Int = 400

fn continuation_bounded_detail(detail: String) -> String {
  if string_length(s: detail) <= continuation_verdict_detail_bound {
    detail
  } else {
    concat(substring(s: detail, start: 0, end: continuation_verdict_detail_bound), " ...")
  }
}

fn continuation_from_segments(prior: PriorAttemptFacts) -> ContinuationDecision {
  match prior.verification {
    Absent => ContinuationHold { reason: "the prior attempt's verification is owed and has no segment yet; the belt owes it, not a spawn" }
    Present { value: v } =>
      match v.state {
        WorkflowSegmentFailed => continuation_ended(prior: prior, why: join(["verification failed: ", v.detail], ""))
        WorkflowSegmentComplete => continuation_after_green_verification(prior: prior)
        WorkflowSegmentStopped => ContinuationRefused { reason: "the prior attempt's verification segment is stopped, a state verification does not inhabit -- the segment record is damaged and the operator decides" }
        WorkflowSegmentPending => ContinuationHold { reason: "the prior attempt's verification is owed and still pending; the belt owes it, not a spawn" }
        WorkflowSegmentActive => ContinuationHold { reason: "the prior attempt's verification is running" }
        WorkflowSegmentRefused => ContinuationHold { reason: "the prior attempt's verification was refused, an environment fact rather than a verdict: the obligation stays outstanding and the belt retries it when the environment recovers, so no spawn" }
      }
  }
}

// A GREEN VERIFICATION HANDS THE QUESTION TO THE REVIEW: changes requested end the lineage with the
// reviewer's located reasons, an approved review hands it to the goal audit, anything else holds.
fn continuation_after_green_verification(prior: PriorAttemptFacts) -> ContinuationDecision {
  match prior.review {
    Absent => ContinuationHold { reason: "the prior attempt verified green and carries no review segment yet" }
    Present { value: r } =>
      match r.state {
        WorkflowSegmentFailed => continuation_ended(prior: prior, why: join(["review requested changes: ", r.detail], ""))
        WorkflowSegmentComplete => continuation_after_approved_review(prior: prior)
        WorkflowSegmentPending => ContinuationHold { reason: join(["the prior attempt verified green and awaits review: ", r.detail], "") }
        WorkflowSegmentActive => ContinuationHold { reason: "the prior attempt verified green and its reviewer is running" }
        WorkflowSegmentRefused => ContinuationHold { reason: join(["the prior attempt verified green and its review refused: ", r.detail], "") }
        WorkflowSegmentStopped => ContinuationHold { reason: "the prior attempt's review segment is stopped, a state review does not inhabit" }
      }
  }
}

// AN APPROVED REVIEW HANDS THE QUESTION TO THE GOAL AUDIT, the same way: changes requested end the
// lineage with the auditor's reasons, approval completes it, and anything else holds.
fn continuation_after_approved_review(prior: PriorAttemptFacts) -> ContinuationDecision {
  match prior.goal_audit {
    Absent => ContinuationHold { reason: "the prior attempt verified green and its review approved, but it carries no goal audit segment yet" }
    Present { value: a } =>
      match a.state {
        WorkflowSegmentFailed => continuation_ended(prior: prior, why: join(["goal audit requested changes: ", a.detail], ""))
        WorkflowSegmentComplete => ContinuationComplete { reason: "the prior attempt verified green, its review approved and its goal audit approved; the lineage is complete and nothing spawns" }
        WorkflowSegmentPending => ContinuationHold { reason: join(["the prior attempt awaits its goal audit: ", a.detail], "") }
        WorkflowSegmentActive => ContinuationHold { reason: "the prior attempt's goal auditor is running" }
        WorkflowSegmentRefused => ContinuationHold { reason: join(["the prior attempt's goal audit refused: ", a.detail], "") }
        WorkflowSegmentStopped => ContinuationHold { reason: "the prior attempt's goal audit segment is stopped, a state the audit does not inhabit" }
      }
  }
}
