module gunbc.roadmap.roadmap_attempt_continuation

import std.types { String, Bool, Int, List, NonEmptyStr, list_length }
import gunbc.roadmap.roadmap_refused_retry {
  RefusedRetryStanding, RefusedRetryOwed, RefusedRetryExhausted, RefusedRetryOperatorOnly, refused_retry_exhausted_reason,
}
import gunbc.roadmap.roadmap_submission {
  SubmissionCaptureObservation, CaptureForHead, CaptureAbsent, CaptureNotAttempted, CaptureUnreadable,
  SubmissionReady, SubmissionBlocked, SubmissionNeedsContext,
}
import gunbc.harness.harness_session_recovery {
  SessionRecovery, SessionRecoveryNone, SessionRecoveryPending, SessionRecoveryMalformed, SessionRecoveryRequestPending, session_resume_bound,
}
import gunbc.harness.harness_transport_retry_policy {
  harness_transport_retry_policy_now, transport_retry_next_delivery_at, transport_retry_redelivery_due,
}
import gunbc.roadmap.roadmap_workflow_stage {
  WorkflowSegment,
  WorkflowSegmentState, WorkflowSegmentPending, WorkflowSegmentActive, WorkflowSegmentComplete,
  WorkflowSegmentFailed, WorkflowSegmentRefused, WorkflowSegmentStopped,
}

import gunbc.roadmap.roadmap_lineage_retire { LineageRetireRecord }

// WHETHER A NODE'S NEXT ATTEMPT MAY START. Every attempt starts from the instance's base ref; there
// is no second origin. Until gunbc.plans.harness_session_lifecycle slice S1 a terminal attempt was
// CONTINUED by a new attempt on its branch -- a fresh worker, a fresh conversation, the prior turn's
// verdict at the top of its brief -- and a worker that spent its round budget was restarted that way
// every forty turns. A supervised session no longer ends at a round boundary, so that lane is gone
// with its turn cap, its turn file and its stretch supervisor; a candidate's revision continues the
// worker's own session once hand-in awaits acceptance (slice S2), never a replacement attempt.

// THE FACTS THE DECISION READS, and nothing else: the prior attempt's key and branch, whether its
// worker has ended, what its submission capture says the end meant, and what verification, review
// and the goal audit said. The capture is the same head-grain observation the verify gate reads.
type PriorAttemptFacts {
  node_id: String
  attempt_key: String
  branch: String
  worker_terminal: Bool
  capture: SubmissionCaptureObservation
  verification: WorkflowSegment?
  review: WorkflowSegment?
  goal_audit: WorkflowSegment?
  recovery: SessionRecovery
  // THE CLOCK THE SCHEDULE IS READ AGAINST, supplied by the belt as a supplied reading: one epoch-second
  // reading per sweep, passed down. Absent means the sweep could not read the clock, which is refused
  // where a re-delivery instant is to be named -- never guessed at, and never an ending.
  now: Int?
  verification_retry: RefusedRetryStanding
}

// THE VOCABULARY NAMES WHAT THE BELT MAY DO, and Fresh means exactly one fact (branch review
// 2026-09-23, blocker 2): SpawnFresh is "it is established that no prior owned lineage exists for
// this node"; Hold spawns nothing while a verdict or a worker is outstanding; Complete spawns nothing
// because the lineage is fully approved; Ended spawns nothing because the lineage stopped short of
// an approved candidate -- its worker stopped, handed in nothing, declared a blocker, or its
// candidate was judged and found wanting -- and starting over from base would discard committed work
// silently; Refused is the arm that must not widen: a fact the decision needs that cannot be
// established refuses with a located reason the dashboard shows, and the operator decides.
type ContinuationDecision
  = ContinuationSpawnFresh { reason: String }
  | ContinuationRefused { reason: String }
  | ContinuationHold { reason: String }
  | ContinuationComplete { reason: String }
  | ContinuationEnded { reason: String }
  | ContinuationResume { reason: String, attempt_key: String, ordinal: Int, causes: List<String> }

fn continuation_decision(prior: PriorAttemptFacts?) -> ContinuationDecision {
  match prior {
    Absent => ContinuationSpawnFresh { reason: "no prior attempt of this node" }
    Present { value: p } =>
      if !p.worker_terminal {
        ContinuationHold { reason: "the prior attempt's worker has not ended; the lineage is active and a second attempt beside it is never spawned" }
      } else {
        continuation_from_capture(prior: p)
      }
  }
}

// THE CAPTURE IS READ BEFORE THE SEGMENTS. A terminal worker's capture is the binding record of
// what its end meant: a submission that declares blocked or needs-context, or no capture at all, is
// a lineage that ended without a candidate, and a capture that cannot be established is refused,
// never read as either. Only a READY capture falls through to the segment arms: that head is a
// candidate, and judging it is verification's job.
fn continuation_from_capture(prior: PriorAttemptFacts) -> ContinuationDecision {
  match prior.capture {
    CaptureUnreadable { reason } =>
      ContinuationRefused {
        reason: join([
          "the submission capture for the prior attempt ", prior.attempt_key,
          " cannot be established: ", reason,
          ", so whether its branch holds a declared candidate is unknown and the decision does not guess",
        ], ""),
      }
    CaptureNotAttempted { reason } =>
      ContinuationRefused {
        reason: join([
          "the prior attempt ", prior.attempt_key, " has ended but its capture is still owed (", reason,
          "), so whether its branch holds a declared candidate is not yet read and the decision waits for the capture",
        ], ""),
      }
    CaptureAbsent => continuation_from_absent_capture(prior: prior)
    CaptureForHead { capture: c } =>
      match c.submission.readiness {
        SubmissionReady => continuation_from_segments(prior: prior)
        SubmissionBlocked =>
          continuation_ended(prior: prior, why: join(["its submission declared blocked: ", continuation_bounded_detail(detail: c.submission.explanation)], ""))
        SubmissionNeedsContext =>
          continuation_ended(prior: prior, why: join(["its submission declared needs-context: ", continuation_bounded_detail(detail: c.submission.explanation)], ""))
      }
  }
}

// A WORKER THAT HANDED IN NOTHING ENDED THE LINEAGE, UNLESS ITS SESSION STOPPED AT A VALIDATED STATE
// BY AN UNEXPLAINED ENGINE REFUSAL (gunbc.plans.harness_session_lifecycle S3, requirement 7). The
// stream records that as a recovery the session has not yet answered, and then the session is
// RECOVERY-NEEDED, which is not ended: it resumes in the same worktree and conversation, by the
// belt, under the declared bound. Three outcomes are distinct on purpose. An interrupted tool
// effect keeps the session recovery-needed but NOT resumable (Hold: the effect's outcome is to be
// established first). Past the bound the lineage ends and names every recorded cause, so a flapping
// engine is visible and bounded, never absorbed. No recovery recorded -- a refusal that explained
// itself, a hosted route, a worker that simply stopped -- is the ending it always was.
fn continuation_from_absent_capture(prior: PriorAttemptFacts) -> ContinuationDecision {
  match prior.recovery {
    SessionRecoveryNone =>
      continuation_ended(prior: prior, why: "its worker ended without handing in a candidate; the attempt's event stream records how the session ended")
    SessionRecoveryMalformed { mismatch: mismatch } =>
      ContinuationRefused {
        reason: join(["the prior attempt ", prior.attempt_key, "'s recovery record is unreadable, so neither a resume nor an ending is established: ", mismatch], ""),
      }
    SessionRecoveryRequestPending { cause: cause, since: since, re_deliveries: re_deliveries, last_delivery_at: last_delivery_at, resumable: _, interrupted_calls: interrupted, resume_round: _ } =>
      continuation_from_request_pending(prior: prior, cause: cause, since: since, re_deliveries: re_deliveries, last_delivery_at: last_delivery_at, interrupted: interrupted)
    SessionRecoveryPending { causes: causes, resumes_made: made, interrupted_calls: interrupted, resume_round: _ } =>
      if list_length(items: interrupted) > 0 {
        ContinuationHold {
          reason: join([
            "the prior attempt ", prior.attempt_key, " is recovery-needed but not resumable: tool calls ", join(interrupted, ", "),
            " have no recorded result, so their effects are not established; the last cause was ", join(causes, " | "),
          ], ""),
        }
      } else if made >= session_resume_bound {
        continuation_ended(prior: prior, why: join([
          "its session was resumed ", to_string(value: made), " times, the bound of ", to_string(value: session_resume_bound),
          ", and was refused again; every recorded cause: ", join(causes, " | "),
        ], ""))
      } else {
        ContinuationResume {
          reason: join(["the prior attempt ", prior.attempt_key, " stopped at a validated state and is resumed in its own session, resume ", to_string(value: made + 1), " of ", to_string(value: session_resume_bound), "; cause: ", join(causes, " | ")], ""),
          attempt_key: prior.attempt_key,
          ordinal: made + 1,
          causes: causes,
        }
      }
  }
}

// A SESSION WHOSE REQUEST STANDS PENDING IS WAITING, NOT REFUSED, AND NOTHING ENDS THE WAIT. The front
// answered 503/502/429 or the post drew no response, so nothing was served and the request had no
// effect: it stands (operator direction 2026-10-27: "i deliver the request, and wait indefinitely for the
// response (like a patient contract)"). The belt re-delivers the SAME attempt -- same session, same
// conversation, same x-pool-session -- when the next re-delivery is DUE by
// gunbc.harness.harness_transport_retry_policy, and Holds with the named instant until then. THE
// CONTINUATION HAS NO TERMINAL FOR THIS STATE: no expiry, no budget, no "waited too long"; a request
// pending ten days gets the same two answers as one pending ten seconds (a ten-day pending that produced
// an ending would fail the witness that says so). An interrupted tool effect keeps the unchanged rule:
// Hold, until that effect's outcome is established. A sweep that could not read the clock Holds naming
// that -- a re-delivery instant cannot be guessed at, and refusing the instant is not ending the request.
fn continuation_from_request_pending(prior: PriorAttemptFacts, cause: String, since: Int, re_deliveries: Int, last_delivery_at: Int, interrupted: List<String>) -> ContinuationDecision {
  if list_length(items: interrupted) > 0 {
    ContinuationHold {
      reason: join([
        "the prior attempt ", prior.attempt_key, " is request-pending but not resumable: tool calls ", join(interrupted, ", "),
        " have no recorded result, so their effects are not established; the request stands pending: ", cause,
      ], ""),
    }
  } else {
    match prior.now {
      Absent =>
        ContinuationHold {
          reason: join(["the prior attempt ", prior.attempt_key, " is request-pending and this sweep could not read the clock, so the next re-delivery instant cannot be named; the request still stands and the belt re-delivers it on a sweep that can read the clock; the request began pending: ", cause], ""),
        }
      Present { value: now } =>
        if transport_retry_redelivery_due(policy: harness_transport_retry_policy_now, last_delivery_at: last_delivery_at, re_deliveries: re_deliveries, session_key: prior.attempt_key, at: now) {
          ContinuationResume {
            reason: join(["the prior attempt ", prior.attempt_key, " is request-pending and its next re-delivery is due: the same round of its own session is RE-DELIVERED (re-delivery ", to_string(value: re_deliveries + 1),
              ", the S3 resume count of ", to_string(value: session_resume_bound), " is not spent by a re-delivery); the request began pending ", to_string(value: now - since), " seconds ago: ", cause], ""),
            attempt_key: prior.attempt_key,
            ordinal: re_deliveries + 1,
            causes: [cause],
          }
        } else {
          ContinuationHold {
            reason: join(["the prior attempt ", prior.attempt_key, " is request-pending and its next re-delivery is not due until ", to_string(value: transport_retry_next_delivery_at(policy: harness_transport_retry_policy_now, last_delivery_at: last_delivery_at, re_deliveries: re_deliveries, session_key: prior.attempt_key)),
              "; next re-delivery at that instant, no resume is spent; the request began pending: ", cause], ""),
          }
        }
    }
  }
}

fn continuation_ended(prior: PriorAttemptFacts, why: String) -> ContinuationDecision {
  ContinuationEnded {
    reason: join([
      "the lineage ending at attempt ", prior.attempt_key, " (branch ", prior.branch, ") stopped short of an approved candidate: ", why,
      " -- its work stays on that branch, and no attempt is started over it",
    ], ""),
  }
}

// A WORKER-AUTHORED EXPLANATION IS UNBOUNDED TEXT, and it lands in a reason the dashboard shows; the
// decision carries at most this much of it. The truncation is marked so a cut explanation is never
// mistaken for a whole one.
data continuation_verdict_detail_bound: Int = 400

fn continuation_bounded_detail(detail: String) -> String {
  if string_length(s: detail) <= continuation_verdict_detail_bound {
    detail
  } else {
    concat(substring(s: detail, start: 0, end: continuation_verdict_detail_bound), " ...")
  }
}

fn continuation_from_segments(prior: PriorAttemptFacts) -> ContinuationDecision {
  match prior.verification {
    Absent => ContinuationHold { reason: "the prior attempt's verification is owed and has no segment yet; the belt owes it, not a spawn" }
    Present { value: v } =>
      match v.state {
        WorkflowSegmentFailed => continuation_ended(prior: prior, why: join(["verification failed: ", v.detail], ""))
        WorkflowSegmentComplete => continuation_after_green_verification(prior: prior)
        WorkflowSegmentStopped => ContinuationRefused { reason: "the prior attempt's verification segment is stopped, a state verification does not inhabit -- the segment record is damaged and the operator decides" }
        WorkflowSegmentPending => ContinuationHold { reason: "the prior attempt's verification is owed and still pending; the belt owes it, not a spawn" }
        WorkflowSegmentActive => ContinuationHold { reason: "the prior attempt's verification is running" }
        WorkflowSegmentRefused =>
          match prior.verification_retry {
            RefusedRetryOwed { ordinal } =>
              ContinuationHold { reason: join(["the prior attempt's verification was refused by its infrastructure, an environment fact rather than a verdict: the belt re-runs it on its next wake (retry ", to_string(ordinal), " of its bound), so no spawn"], "") }
            RefusedRetryExhausted { attempts } =>
              ContinuationRefused { reason: refused_retry_exhausted_reason(attempts: attempts) }
            RefusedRetryOperatorOnly =>
              ContinuationHold { reason: "the prior attempt's verification was refused, an environment fact rather than a verdict: the belt does not re-run it on its own: the line stops here for the attempt and the operator resumes the verification (belt_verify_resume_cli), so no spawn" }
          }
      }
  }
}

// A GREEN VERIFICATION HANDS THE QUESTION TO THE REVIEW: changes requested end the lineage with the
// reviewer's located reasons, an approved review hands it to the goal audit, anything else holds.
fn continuation_after_green_verification(prior: PriorAttemptFacts) -> ContinuationDecision {
  match prior.review {
    Absent => ContinuationHold { reason: "the prior attempt verified green and carries no review segment yet" }
    Present { value: r } =>
      match r.state {
        WorkflowSegmentFailed => continuation_ended(prior: prior, why: join(["review requested changes: ", r.detail], ""))
        WorkflowSegmentComplete => continuation_after_approved_review(prior: prior)
        WorkflowSegmentPending => ContinuationHold { reason: join(["the prior attempt verified green and awaits review: ", r.detail], "") }
        WorkflowSegmentActive => ContinuationHold { reason: "the prior attempt verified green and its reviewer is running" }
        WorkflowSegmentRefused => ContinuationHold { reason: join(["the prior attempt verified green and its review refused: ", r.detail], "") }
        WorkflowSegmentStopped => ContinuationHold { reason: "the prior attempt's review segment is stopped, a state review does not inhabit" }
      }
  }
}

// AN APPROVED REVIEW HANDS THE QUESTION TO THE GOAL AUDIT, the same way: changes requested end the
// lineage with the auditor's reasons, approval completes it, and anything else holds.
fn continuation_after_approved_review(prior: PriorAttemptFacts) -> ContinuationDecision {
  match prior.goal_audit {
    Absent => ContinuationHold { reason: "the prior attempt verified green and its review approved, but it carries no goal audit segment yet" }
    Present { value: a } =>
      match a.state {
        WorkflowSegmentFailed => continuation_ended(prior: prior, why: join(["goal audit requested changes: ", a.detail], ""))
        WorkflowSegmentComplete => ContinuationComplete { reason: "the prior attempt verified green, its review approved and its goal audit approved; the lineage is complete and nothing spawns" }
        WorkflowSegmentPending => ContinuationHold { reason: join(["the prior attempt awaits its goal audit: ", a.detail], "") }
        WorkflowSegmentActive => ContinuationHold { reason: "the prior attempt's goal auditor is running" }
        WorkflowSegmentRefused => ContinuationHold { reason: join(["the prior attempt's goal audit refused: ", a.detail], "") }
        WorkflowSegmentStopped => ContinuationHold { reason: "the prior attempt's goal audit segment is stopped, a state the audit does not inhabit" }
      }
  }
}

// THE OPERATOR'S RETIREMENT OF AN ENDED LINEAGE (ruling 2026-10-16, LINEAGE-RETIRE-1). Ended spawns
// nothing because starting over would discard committed work silently; a retire record
// (gunbc.roadmap.roadmap_lineage_retire LineageRetireRecord) is the operator's explicit, attributable
// decision to discard, and it is read ONLY by the Ended arm. It changes no other arm's answer except
// to refuse: retiring is for Ended only, so a record over a lineage that is active, held, complete or
// refused, or over no lineage at all, is a refusal the dashboard shows, never a silent pass. A record
// naming another attempt or node than the lineage's current end is stale and refuses. No record:
// the decision is exactly continuation_decision. The ended branch is untouched by every arm.
fn continuation_decision_with_retirement(prior: PriorAttemptFacts?, retire: LineageRetireRecord?) -> ContinuationDecision {
  let base = continuation_decision(prior: prior)
  match retire {
    Absent => base
    Present { value: record } =>
      match prior {
        Absent => ContinuationRefused { reason: join(["a retire record names attempt ", record.attempt_key, " of node ", record.node_id, " but the node has no prior attempt; retiring is for an Ended lineage only"], "") }
        Present { value: p } =>
          match base {
            ContinuationEnded { reason: ended } =>
              if record.attempt_key != p.attempt_key || record.node_id != p.node_id {
                ContinuationRefused {
                  reason: join(["the retire record names attempt ", record.attempt_key, " of node ", record.node_id, " but the lineage now ends at attempt ", p.attempt_key, " of node ", p.node_id, "; the record is stale and the operator decides again"], ""),
                }
              } else {
                ContinuationSpawnFresh {
                  reason: join([
                    "the lineage ending at attempt ", p.attempt_key, " was retired by ", record.decided_by, " at ", record.decided_at,
                    " (", continuation_bounded_detail(detail: record.reason), "); its branch ", p.branch,
                    " is kept and the fresh attempt starts from base. It ended: ", ended,
                  ], ""),
                }
              }
            ContinuationSpawnFresh { reason: r } => continuation_retire_over_non_ended(record: record, state: "spawn-fresh", reason: r)
            ContinuationRefused { reason: r } => continuation_retire_over_non_ended(record: record, state: "refused", reason: r)
            ContinuationHold { reason: r } => continuation_retire_over_non_ended(record: record, state: "held or active", reason: r)
            ContinuationComplete { reason: r } => continuation_retire_over_non_ended(record: record, state: "complete", reason: r)
            ContinuationResume { reason: r, attempt_key: _, ordinal: _, causes: _ } => continuation_retire_over_non_ended(record: record, state: "recovery-needed and resumable", reason: r)
          }
      }
  }
}

fn continuation_retire_over_non_ended(record: LineageRetireRecord, state: String, reason: String) -> ContinuationDecision {
  ContinuationRefused {
    reason: join(["a retire record for attempt ", record.attempt_key, " exists but the lineage is ", state, ", not Ended; retiring is for an Ended lineage only: ", reason], ""),
  }
}

// THE ADMISSION OF A RETIRE REQUEST, pure over the lineage's facts and the request's values; the
// route is one realization (DESIGN 3). Who and when arrive as values the route took from its
// authentication and clock. The request must name the lineage's CURRENT ended end: any other
// attempt, a lineage that is not Ended, or an empty reason refuses with a located cause.
type LineageRetireAdmission
  = LineageRetireAdmitted { record: LineageRetireRecord }
  | LineageRetireRefused { reason: String }

fn lineage_retire_admission(prior: PriorAttemptFacts?, attempt_key: String, reason: String, decided_by: String, decided_at: String) -> LineageRetireAdmission {
  if reason == "" {
    LineageRetireRefused { reason: "a retire request states the operator's reason; an empty reason is not a decision" }
  } else {
    match prior {
      Absent => LineageRetireRefused { reason: "the node has no prior attempt, so there is no lineage to retire" }
      Present { value: p } =>
        match continuation_decision(prior: prior) {
          ContinuationEnded { reason: _ } =>
            if p.attempt_key != attempt_key {
              LineageRetireRefused { reason: join(["the request names attempt ", attempt_key, " but the lineage ends at attempt ", p.attempt_key, "; only the ended end may be retired"], "") }
            } else {
              LineageRetireAdmitted { record: LineageRetireRecord {
                node_id: p.node_id, attempt_key: p.attempt_key, branch: p.branch,
                reason: reason, decided_by: decided_by, decided_at: decided_at,
              } }
            }
          ContinuationSpawnFresh { reason: r } => LineageRetireRefused { reason: join(["the lineage is not Ended (spawn-fresh): ", r], "") }
          ContinuationRefused { reason: r } => LineageRetireRefused { reason: join(["the lineage is not Ended (refused): ", r], "") }
          ContinuationHold { reason: r } => LineageRetireRefused { reason: join(["the lineage is not Ended (held or active): ", r], "") }
          ContinuationComplete { reason: r } => LineageRetireRefused { reason: join(["the lineage is not Ended (complete): ", r], "") }
          ContinuationResume { reason: r, attempt_key: _, ordinal: _, causes: _ } => LineageRetireRefused { reason: join(["the lineage is not Ended (recovery-needed, resumable): ", r], "") }
        }
    }
  }
}
