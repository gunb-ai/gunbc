module gunbc.roadmap.roadmap_dashboard_instance_observe

import std.algebra { trim }
import std.types { String, Bool, Int, List, FilePath, NonEmptyStr }
import extdeps.shell
import gunbc.output_policy { OutcomeIsData }
import extdeps.gunbc
import gunbc.typed_argv_exec {
  TypedArgvExecConverged,
  TypedArgvExecRefused,
  typed_argv_probe_over_ssh,
  typed_argv_exec_over_ssh,
  typed_argv_exec_over_ssh_with_stdin,
  TypedArgvExecOutcome,
}
import gunbc.roadmap.roadmap_dashboard_instance {
  HostDashboardInstance,
  DashboardLocalProvision,
  DashboardSshProvision,
  dashboard_instance_controller_workdir,
}

// Observation-only host probes for a dashboard instance. Split out of
// gunbc.roadmap.roadmap_dashboard_instance_apply so serving can observe provider
// readiness without importing the launcher (CONVERGENCE-ONE C5).
// CONSUMERS: gunbc.roadmap.roadmap_dashboard_instance_apply dashboard_target_exec,
// gunbc.roadmap.dashboard_provider_readiness observe_dashboard_provider_readiness.

// DECLARED SCAFFOLD (review 44058, DESIGN 5). DashboardExecResult carries
// failure as success: Bool plus prose. DISSOLVES ON: the apply pipeline
// folding over a typed step outcome.

type DashboardExecResult {
  success: Bool
  stdout: String
  stderr: String
}

fn dashboard_exec_ok(stdout: String) -> DashboardExecResult {
  DashboardExecResult { success: true, stdout: stdout, stderr: "" }
}

fn dashboard_exec_refused(detail: String) -> DashboardExecResult {
  DashboardExecResult { success: false, stdout: "", stderr: detail }
}

fn dashboard_local_exec(
  workdir: FilePath,
  program: FilePath,
  args: List<String>,
) -> DashboardExecResult {
  let result = gunbc.WitnessBin.Run(
    workdir: workdir,
    bin_path: program,
    args: args,
    expect: OutcomeIsData,
  )
  DashboardExecResult {
    success: result.success,
    stdout: result.stdout,
    stderr: result.stderr,
  }
}

// THE ONE DISPATCH ON provision_transport. Every command run on a dashboard instance's target host
// (exec, probe, and exec with a stdin payload) goes through dashboard_target_run; the mode is a closed
// set, so a probe-with-stdin (no transport for it) is unwritable rather than refused at run time.
// dashboard_target_probe here and dashboard_target_exec in roadmap_dashboard_instance_apply are
// projections of it onto DashboardExecResult, not separate dispatches.
type DashboardTargetRunMode
  = TargetExec
  | TargetProbe
  | TargetExecWithStdin { payload: String }

type DashboardTargetRan
  = TargetRan { exit_code: Int, success: Bool, stdout: String, stderr: String }
  | TargetNotRun { reason: String }

fn dashboard_target_ran_of_typed_argv(outcome: TypedArgvExecOutcome) -> DashboardTargetRan {
  match outcome {
    TypedArgvExecConverged { result } =>
      TargetRan { exit_code: result.exit_code, success: result.success, stdout: result.stdout, stderr: result.stderr }
    TypedArgvExecRefused { reason } => TargetNotRun { reason: reason }
  }
}

fn dashboard_target_run(
  instance: HostDashboardInstance,
  program: FilePath,
  args: List<String>,
  mode: DashboardTargetRunMode,
) -> DashboardTargetRan {
  match instance.provision_transport {
    DashboardLocalProvision =>
      match mode {
        TargetExecWithStdin { payload } => {
          let ran = shell.Exec.RunArgvStdin(
            program: program as NonEmptyStr,
            arguments: args,
            stdin_payload: payload,
          )
          TargetRan { exit_code: ran.exit_code, success: ran.exit_code == 0, stdout: ran.stdout, stderr: ran.stderr }
        }
        TargetExec => dashboard_target_ran_of_local(instance: instance, program: program, args: args)
        TargetProbe => dashboard_target_ran_of_local(instance: instance, program: program, args: args)
      }
    DashboardSshProvision { host } => {
      let argv = concat([program as String], args)
      dashboard_target_ran_of_typed_argv(
        outcome: match mode {
          TargetExec => typed_argv_exec_over_ssh(host: host, argv: argv)
          TargetProbe => typed_argv_probe_over_ssh(host: host, argv: argv)
          TargetExecWithStdin { payload } =>
            typed_argv_exec_over_ssh_with_stdin(host: host, argv: argv, stdin_payload: payload)
        },
      )
    }
  }
}

fn dashboard_target_ran_of_local(
  instance: HostDashboardInstance,
  program: FilePath,
  args: List<String>,
) -> DashboardTargetRan {
  let result = gunbc.WitnessBin.Run(
    workdir: dashboard_instance_controller_workdir(instance: instance),
    bin_path: program,
    args: args,
    expect: OutcomeIsData,
  )
  TargetRan { exit_code: result.exit_code, success: result.success, stdout: result.stdout, stderr: result.stderr }
}

fn dashboard_exec_result_of_ran(ran: DashboardTargetRan) -> DashboardExecResult {
  match ran {
    TargetRan { exit_code: _, success, stdout, stderr } =>
      DashboardExecResult { success: success, stdout: stdout, stderr: stderr }
    TargetNotRun { reason } => dashboard_exec_refused(detail: reason)
  }
}

fn dashboard_target_probe(
  instance: HostDashboardInstance,
  program: FilePath,
  args: List<String>,
) -> DashboardExecResult {
  dashboard_exec_result_of_ran(
    ran: dashboard_target_run(instance: instance, program: program, args: args, mode: TargetProbe),
  )
}

type DashboardPathObservation
  = PathObservedPresent
  | PathObservedAbsent
  | PathObservationRefused { reason: String }

fn dashboard_exec_refusal_reason(label: String, r: DashboardExecResult) -> List<String> {
  if r.success {
    []
  } else if trim(r.stdout) == "" && !(trim(r.stderr) == "") {
    [join([label, " observation could not run: ", trim(r.stderr)], "")]
  } else {
    []
  }
}

fn dashboard_target_path_observe(
  instance: HostDashboardInstance,
  flag: String,
  path: FilePath,
) -> DashboardPathObservation {
  let r = dashboard_target_probe(
    instance: instance,
    program: instance.toolchain.path_test,
    args: [flag, path as String],
  )
  if r.success {
    PathObservedPresent
  } else if trim(r.stdout) == "" && !(trim(r.stderr) == "") {
    PathObservationRefused {
      reason: join([
        "path observation could not run for ",
        path as String,
        ": ",
        trim(r.stderr),
      ], ""),
    }
  } else {
    PathObservedAbsent
  }
}

fn dashboard_path_observation_refusal(obs: DashboardPathObservation) -> List<String> {
  match obs {
    PathObservedPresent => []
    PathObservedAbsent => []
    PathObservationRefused { reason } => [reason]
  }
}

fn dashboard_observation_present_bit(obs: DashboardPathObservation) -> Bool {
  match obs {
    PathObservedPresent => true
    PathObservedAbsent => false
    PathObservationRefused { reason: _ } => false
  }
}

fn dashboard_target_directory_present(
  instance: HostDashboardInstance,
  path: FilePath,
) -> Bool {
  dashboard_observation_present_bit(
    obs: dashboard_target_path_observe(instance: instance, flag: "-d", path: path),
  )
}

fn dashboard_target_file_present(
  instance: HostDashboardInstance,
  path: FilePath,
) -> Bool {
  dashboard_observation_present_bit(
    obs: dashboard_target_path_observe(instance: instance, flag: "-f", path: path),
  )
}

fn dashboard_probe_refused(r: DashboardExecResult) -> Bool {
  !r.success && trim(r.stdout) == "" && !(trim(r.stderr) == "")
}

fn codex_probe_detail(out: String, err: String) -> String {
  let o = trim(out)
  let e = trim(err)
  if o == "" { e } else if e == "" { o } else { join([o, e], " | ") }
}
