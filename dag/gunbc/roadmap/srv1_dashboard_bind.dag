module gunbc.srv1_dashboard_bind

import std.types { NonEmptyStr }

// THE SRV1 DASHBOARD INSTANCE'S HOST AND BIND, as a leaf read by gunbc.roadmap_dashboard_instance
// srv1_live_dashboard_instance. The approval modules no longer read it: the broker's host, the client
// origin and the identity trust follow the prod-role holder (gunbc.roadmap_dashboard_instance
// prod_role_realization), so they name whichever instance holds the role, not srv1.
data srv1_dashboard_host_identity: NonEmptyStr = "srv1"
data srv1_dashboard_listen_host: NonEmptyStr = "127.0.0.1"
