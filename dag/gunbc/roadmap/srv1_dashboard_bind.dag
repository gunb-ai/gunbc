module gunbc.srv1_dashboard_bind

import std.types { NonEmptyStr }

// THE SRV1 DASHBOARD INSTANCE'S HOST AND BIND, as a leaf. gunbc.roadmap_dashboard_instance
// srv1_live_dashboard_instance reads both, and so do the approval modules that derive a standing
// from them (gunbc.auth.approval_decision_store approval_identity_trust, gunbc.auth.approval_broker_endpoint
// approval_broker_host_identity). They are facts of the instance row, kept in a module of their own so
// a reader of two strings does not import the instance row's provider, codex and host-layout closure.
data srv1_dashboard_host_identity: NonEmptyStr = "srv1"
data srv1_dashboard_listen_host: NonEmptyStr = "127.0.0.1"
