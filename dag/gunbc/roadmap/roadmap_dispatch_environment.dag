import extdeps.shell

// review 44078. The receipt used to carry the Ensure decision as a raw String ("noop" | "apply" |
// "refuse") — a closed sum projected through an open carrier, so a fourth spelling was writable and
// nothing tied the field to the sum it came from. It now carries the UpsertDecision itself, which
// is the authority ensure_decide already produced, so there is no second sum to keep in step
// (DESIGN 3); the wire word exists once, at the JSON emit site, through upsert_decision_label.

// THE POSITIVE ARM IS SEALED, AND THAT IS THE WHOLE POINT OF THIS TYPE'S SHAPE. The admission fold
// below trusts these receipts to decide whether dispatch runs, and it used to trust an ORDINARY
// `grounded: Bool` on an open product. Migrating the producer onto the reconciliation authority did
// not reach that sink: the sealed ReconciledEffect was classified, then flattened back into a Boolean
// any importer could write, so
//   CapabilityEnsureReceipt { decision: Refuse { ... }, grounded: true, reason: "", ... }
// was authorable and admitted, because admission reads `grounded` and ignores `decision`. The
// consistency table was optional at the exact boundary it exists to guard -- validation standing
// where construction was available (DESIGN 5), and a migration that stops one type short of its sink.
//
// GroundedCapabilityEnsure is sole_constructor, so no module outside this one can build the value the
// CapabilityGrounded arm requires. Positive standing now has a CONSTRUCTION PATH rather than a second
// predicate: adding `decision == Noop` beside `grounded == true` would have left Noop-with-true just
// as writable, which is the same validation-instead-of-construction move one rung down.
//
// The Boolean survives only as a JSON PROJECTION at the serialization boundary, where it is an
// output format and not an authority anything reads back.
//
// THE WALL IS ENROLLED AND IS NOT NEW HERE. Cross-module sole_constructor forgery is the
// sole-constructor-cross-module class in gunbc.guarantee_probe_corpus, which already carries a forged
// RED, a cast RED and an unadmitted-caller RED beside its green controls. This type inherits that
// wall; authoring a second probe class for it would be a second authority for one guarantee
// (DESIGN 3), which is the move this change declined for its failure-mode row as well.
//
// SCOPED HONESTLY, in the same terms std.realization_reconcile uses for ConvergedEffect: the wall
// holds for callers OUTSIDE this module. Inside it the mint is ordinary source, so a wrong
// GroundedCapabilityEnsure is authorable here. What is closed is the importer path -- the one the
// witness corpus was previously exercising -- and the emitted or deserialized representation is not
// covered, which is this class's next-rung trigger rather than something the seal already holds.
type GroundedCapabilityEnsure sole_constructor {
  capability: ExecutionCapability
  capability_label: String
  executable: String
  decision: UpsertDecision<String>
  evidence: String
}

type CapabilityEnsureReceipt
  = CapabilityGrounded { grounded: GroundedCapabilityEnsure }
  | CapabilityNotGrounded {
      capability: ExecutionCapability,
      capability_label: String,
      executable: String,
      decision: UpsertDecision<String>,
      evidence: String,
      reason: String,
    }

fn receipt_capability(receipt: CapabilityEnsureReceipt) -> ExecutionCapability {
  match receipt {
    CapabilityGrounded { grounded: g } => g.capability
    CapabilityNotGrounded { capability: c, capability_label: _, executable: _, decision: _, evidence: _, reason: _ } => c
  }
}

fn receipt_capability_label(receipt: CapabilityEnsureReceipt) -> String {
  match receipt {
    CapabilityGrounded { grounded: g } => g.capability_label
    CapabilityNotGrounded { capability: _, capability_label: l, executable: _, decision: _, evidence: _, reason: _ } => l
  }
}

fn receipt_executable(receipt: CapabilityEnsureReceipt) -> String {
  match receipt {
    CapabilityGrounded { grounded: g } => g.executable
    CapabilityNotGrounded { capability: _, capability_label: _, executable: e, decision: _, evidence: _, reason: _ } => e
  }
}

fn receipt_decision(receipt: CapabilityEnsureReceipt) -> UpsertDecision<String> {
  match receipt {
    CapabilityGrounded { grounded: g } => g.decision
    CapabilityNotGrounded { capability: _, capability_label: _, executable: _, decision: d, evidence: _, reason: _ } => d
  }
}

fn receipt_evidence(receipt: CapabilityEnsureReceipt) -> String {
  match receipt {
    CapabilityGrounded { grounded: g } => g.evidence
    CapabilityNotGrounded { capability: _, capability_label: _, executable: _, decision: _, evidence: e, reason: _ } => e
  }
}

fn receipt_reason(receipt: CapabilityEnsureReceipt) -> String {
  match receipt {
    CapabilityGrounded { grounded: _ } => ""
    CapabilityNotGrounded { capability: _, capability_label: _, executable: _, decision: _, evidence: _, reason: r } => r
  }
}

fn receipt_grounded(receipt: CapabilityEnsureReceipt) -> Bool {
  match receipt {
    CapabilityGrounded { grounded: _ } => true
    CapabilityNotGrounded { capability: _, capability_label: _, executable: _, decision: _, evidence: _, reason: _ } => false
  }
}

type DispatchEnvironmentAdmission
  = EnvironmentAdmitted {
      receipts: List<CapabilityEnsureReceipt>,
      validation_summary: String,
    }
  | EnvironmentRefused {
      receipts: List<CapabilityEnsureReceipt>,
      validation_summary: String,
      reason: String,
    }

// Dispatch admission is requirements -> Ensure -> grounded receipts -> actuation. The work item's
// typed validation operations derive semantic capabilities; HostDashboardInstance resolves those to
// exact executable paths and identity probes; one generic Ensure decision is evaluated per
// capability; only Noop receipts whose capability observation grounds admit worktree/session
// effects. Generic Ensure never installs a named package. An EnsureMayApply realization still needs
// a capability-specific typed plan and adapter; this module supplies no ambient package manager
// fallback, so no-plan refuses. ExecutionContractUnspecified is an explicit migration refusal.
// Provider authentication remains a separate provider preflight after environment admission because
// cached OAuth and upstream quota are provider protocol facts, not executable identity.

fn no_capability_plan(reason: String) -> EnsurePlan<String> {
  EnsurePlanUnavailable { reason: reason }
}

fn ensure_observation_evidence(observation: EnsureObservation<String>) -> String {
  match observation {
    EnsureObserved { evidence } => evidence
    EnsureAbsent { reason } => reason
    EnsureInaccessible { reason } => reason
  }
}

// One receipt, one derivation. Each of the three arms below used to decide `grounded` for itself:
// the Noop arm from the readback, and the Apply and Refuse arms from a hand-written `false`. Two of
// the three were literals standing where a derivation belongs, so the arms could disagree with the
// lifecycle silently and a fourth arm would arrive with no obligation to derive anything at all.
// ensure_reconcile now answers it once, from the REPORTED effective read, and each arm takes the
// reason std already classified rather than re-deriving one.
//
// Behaviour is unchanged by construction rather than by inspection: reconcile_effect refuses a
// Refuse, refuses an Apply reported as NotApplied (this site reports NotApplied because no
// capability-specific provisioner is modeled), and grounds a Noop exactly when the read grounds.
//
// EACH ARM TAKES THE REASON std CLASSIFIED. An earlier revision of this change routed both arms
// through a capability_receipt_reason helper that re-branched on the decision, which preserved the
// classified reason only for Noop: Apply substituted a literal and Refuse re-read the decision's own
// reason. That discards exactly the reasons the classifier adds -- Refuse-paired-with-an-application
// is a REPORT CONTRADICTION, not the original policy refusal -- so a receipt would have named the
// wrong cause the moment this site gains a real provisioner. EffectNotConverged.reason is now used
// directly, and the converged arm is the empty string because classify_reconciled reaches it only
// through Grounds.
//
// AND THERE IS NO DISTINCT READBACK REASON, because there is no distinct readback. This site holds
// ONE observation per capability and passes it as both before and after, so no reachable route
// carries an after reason the before reason would not carry: a satisfied identity gives Noop over a
// grounding read, and a dissatisfied one gives Refuse before the grounding report is consulted. A
// helper minting separate "identity readback did not ground" vocabulary was therefore a producer
// whose only consumer fed a semantically dead argument -- DESIGN 3c's dangling declaration, the same
// class this change removes at ReconciledEffect. It is deleted rather than kept warm; a distinct
// after reason returns when this site obtains a distinct after OBSERVATION, and not before.
//
// The converged arm's evidence is c.evidence, from the sealed result, NOT re-derived from the raw
// observation. The two are equal today only because the same observation is passed as before and
// after; consuming the sealed value is what stops that parallel source from diverging when a real
// second read lands.
//
// The observation is passed as BOTH before and after, and that is a real limitation rather than an
// oversight: this site holds ONE observation per capability, and it is not a second read of the host.
// It was previously described as an independent readback, and the user-visible refusal said so too --
// a receipt asserting evidence this site does not hold, which is worse than stale prose because a
// reader acts on it. Making it one is a change to what this module
// OBSERVES, not to how it reconciles, so it is deliberately not folded in here.

fn capability_mismatch_reason(realization: CapabilityRealization) -> String {
  join([
    execution_capability_label(capability: realization.capability),
    " identity probe did not match ",
    realization.identity_contains as String,
  ], "")
}

// CALLER-SEALED, BECAUSE sole_constructor ALONE LEFT THIS OPEN. GroundedCapabilityEnsure cannot be
// written as a record literal outside this module, but an unrestricted pure function that MINTS it
// from ordinary caller-authored inputs is a public semantic constructor with a longer spelling. Given
// EnsureObserved plus identity_matches: true, this derives Noop, supplies NotApplied, reports one
// observation as both before and after, classifies it as grounding, and returns the sealed positive --
// with no IsExecutable and no identity command having run. So
//   capability_ensure_receipt(realization: <anything>, observation: EnsureObserved { ... }, identity_matches: true)
// was exactly the bypass that CapabilityEnsureReceipt { grounded: true } used to be, and a complete
// set of them still reached EnvironmentAdmitted. Sealing the RECORD moved the forgery; it did not
// remove it.
//
// This is the same cut gunbc.typed_remote_file_write already makes, and the reason that half got it
// right: the public classifier there returns an ordinary RemoteFileComparisonReport, while
// remote_file_converged_from_report is admitted to the func that ran the effect.
//
// admit_callers here names capability_ensure_observe -- the route that runs the executable probe and
// the declared identity command -- and one NAMED FIXTURE AUTHORITY, which asserts a match rather than
// observing one and says so at its declaration. The fixture exception is not a second observer, and
// it dissolves on the trigger recorded there: an injected execution context for this route, after
// which a witness drives the real observer and the fixture is deleted.
//
// NOT SPLIT into a public classifier plus a restricted mint, which was the other sound shape offered.
// Nothing in the corpus needs judgment without authority -- dispatch_preflight consumes receipts and
// never classifies -- so a public classify_capability_ensure would be a declaration with no consumer,
// which is the dangling-declaration class this change removes elsewhere (DESIGN 3c).
fn capability_ensure_receipt(
  realization: CapabilityRealization,
  observation: EnsureObservation<String>,
  identity_matches: Bool,
) -> CapabilityEnsureReceipt
  admit_callers: [
    decl_ref(module_path: "gunbc.roadmap_dispatch_environment", decl_name: "capability_ensure_observe"),
    decl_ref(module_path: "test.claim.capability_ensure_fixture", decl_name: "grounded_capability_ensure_witness_fixture"),
    decl_ref(module_path: "test.claim.capability_ensure_fixture", decl_name: "refused_capability_ensure_witness_fixture"),
  ]
{
  let reconciled = ensure_reconcile(
    policy: realization.ensure_policy,
    before: observation,
    before_satisfies: identity_matches,
    mismatch_reason: capability_mismatch_reason(realization: realization),
    plan: no_capability_plan(
      reason: join([
        "no capability-specific provisioner is modeled for ",
        execution_capability_label(capability: realization.capability),
        "; generic Ensure cannot choose an installer",
      ], ""),
    ),
    application: NotApplied,
    after: observation,
    after_satisfies: identity_matches,
    after_mismatch_reason: capability_mismatch_reason(realization: realization),
  )
  match classify_reconciled(r: reconciled) {
    EffectConverged { converged: c } =>
      CapabilityGrounded {
        grounded: GroundedCapabilityEnsure {
          capability: realization.capability,
          capability_label: execution_capability_label(capability: realization.capability),
          executable: realization.executable as String,
          decision: c.decision,
          evidence: c.evidence,
        },
      }
    EffectNotConverged { reason: why, attempt: a } =>
      CapabilityNotGrounded {
        capability: realization.capability,
        capability_label: execution_capability_label(capability: realization.capability),
        executable: realization.executable as String,
        decision: a.decision,
        evidence: ensure_observation_evidence(observation: observation),
        reason: why,
      }
  }
}

fn missing_capability_reason(cap: ExecutionCapability) -> String {
  join([
    "host environment has no realization for required capability ",
    execution_capability_label(capability: cap),
  ], "")
}

fn missing_capability_receipt(
  cap: ExecutionCapability,
) -> CapabilityEnsureReceipt {
  CapabilityNotGrounded {
    capability: cap,
    capability_label: execution_capability_label(capability: cap),
    executable: "",
    decision: Refuse {
      reason: missing_capability_reason(cap: cap) as NonEmptyStr,
    },
    evidence: "",
    reason: missing_capability_reason(cap: cap),
  }
}

fn capability_ensure_observe(
  realization: CapabilityRealization,
) -> CapabilityEnsureReceipt {
  let executable = shell.Test.IsExecutable(
    path: realization.executable,
    expect: OutcomeIsData,
  )
  if !executable.executable {
    capability_ensure_receipt(
      realization: realization,
      observation: EnsureAbsent {
        reason: join([
          "required executable is absent or not executable: ",
          realization.executable as String,
        ], ""),
      },
      identity_matches: false,
    )
  } else {
    let result = gunbc.WitnessBin.Run(
      workdir: "/" as FilePath,
      bin_path: realization.executable,
      args: realization.identity_args,
      expect: OutcomeIsData,
    )
    let evidence = join([
      "exit=", to_string(result.exit_code),
      " stdout=", result.stdout,
      " stderr=", result.stderr,
    ], "")
    capability_ensure_receipt(
      realization: realization,
      observation: EnsureObserved { evidence: evidence },
      identity_matches: result.success
        && string_contains(
          s: join([result.stdout, "\n", result.stderr], ""),
          pattern: realization.identity_contains as String,
        ),
    )
  }
}

fn capability_receipt_for_requirement(
  environment: DispatchHostEnvironment,
  cap: ExecutionCapability,
) -> CapabilityEnsureReceipt {
  match dispatch_host_realization(environment: environment, capability: cap) {
    Present { value: realization } =>
      capability_ensure_observe(realization: realization)
    Absent =>
      missing_capability_receipt(cap: cap)
  }
}

fn receipt_matches_requirement(
  receipt: CapabilityEnsureReceipt,
  cap: ExecutionCapability,
) -> Bool {
  execution_capability_equal(a: receipt_capability(receipt: receipt), b: cap)
}

fn first_ungrounded_reason(receipts: List<CapabilityEnsureReceipt>) -> String {
  fold(receipts, init: "", f: fn(reason, receipt) {
    if reason != "" {
      reason
    } else if !receipt_grounded(receipt: receipt) {
      join([receipt_capability_label(receipt: receipt), ": ", receipt_reason(receipt: receipt)], "")
    } else {
      ""
    }
  })
}

fn dispatch_environment_admission_decision(
  contract: WorkItemExecutionContract,
  receipts: List<CapabilityEnsureReceipt>,
  validation_summary: String,
) -> DispatchEnvironmentAdmission {
  let required = dispatch_required_capabilities(contract: contract)
  let exact_coverage = count(receipts) == count(required)
    && all(
      required,
      cap =>
        count(
          receipts
            |> filter(receipt =>
              receipt_matches_requirement(receipt: receipt, cap: cap)),
        ) == 1,
    )
  match contract_closure(contract: contract) {
    ContractDeclaresNoValidation =>
    EnvironmentRefused {
      receipts: receipts,
      validation_summary: validation_summary,
      reason: "work item execution contract is unspecified; dispatch will not guess validation or dependencies",
    }
    ContractClosesNothing =>
    EnvironmentRefused {
      receipts: receipts,
      validation_summary: validation_summary,
      reason: "work item execution contract declares no validation operations; a contract that closes nothing cannot admit dispatch",
    }
    ContractCloses { validations: _ } =>
    if !exact_coverage {
    EnvironmentRefused {
      receipts: receipts,
      validation_summary: validation_summary,
      reason: "Ensure receipt set does not exactly cover the execution contract",
    }
  } else if !all(receipts, receipt => receipt_grounded(receipt: receipt)) {
    EnvironmentRefused {
      receipts: receipts,
      validation_summary: validation_summary,
      reason: first_ungrounded_reason(receipts: receipts),
    }
  } else {
    EnvironmentAdmitted {
      receipts: receipts,
      validation_summary: validation_summary,
    }
  }
  }
}

fn dispatch_environment_admit(
  contract: WorkItemExecutionContract,
  environment: DispatchHostEnvironment,
) -> DispatchEnvironmentAdmission {
  let receipts = dispatch_required_capabilities(contract: contract)
    |> map(cap =>
      capability_receipt_for_requirement(environment: environment, cap: cap))
  dispatch_environment_admission_decision(
    contract: contract,
    receipts: receipts,
    validation_summary: execution_contract_validation_summary(
      contract: contract,
      environment: environment,
    ),
  )
}

data dispatch_environment_receipt_schema: String = "roadmap-dispatch-environment/v1"

type DispatchEnvironmentReceiptStatus
  = ReceiptAdmitted
  | ReceiptRefused

type DispatchEnvironmentReceiptDecode
  = ReceiptDecoded { status: DispatchEnvironmentReceiptStatus }
  | ReceiptUndecodable { reason: String }

// review 44094. The persisted status was two loose String rows read back by a Bool predicate, so
// the reader answered `is it admitted` and collapsed `records a refusal` with `I could not decode
// this` into one false. It is now a closed sum written and read through the SAME rows (DESIGN 4,
// one grammar in both directions): receipt_status_label spells the emitter's word,
// dispatch_environment_receipt_decode selects the variant by matching the emitter's own leading
// prefix, and an undecodable document gets its own located arm instead of masquerading as a
// refusal. The typed DispatchEnvironmentAdmission itself cannot cross this seam — the receipt is
// written at dispatch time and read back later from disk by a different process, and that
// independence is the point — so decoding is the honest move, not retaining the value.

fn receipt_status_label(status: DispatchEnvironmentReceiptStatus) -> String {
  match status {
    ReceiptAdmitted => "admitted"
    ReceiptRefused => "refused"
  }
}

// A persisted admission receipt is identified by its LEADING members, never by scanning its text.
// dispatch_environment_admission_json always emits schema then status first, so the admitted
// document's exact byte prefix is derivable from the same emitter; a reader requires the receipt to
// START with it. The scan this replaces (two string_contains over the serialized document) was
// satisfiable from any value position — a refused receipt whose reason or validation summary
// happened to carry the fragments read as admitted, fabricating a completed Environment fact from
// refused evidence (DESIGN 5). Positional identity makes that unwritable: no nested value can
// occupy the document prefix.

fn dispatch_environment_receipt_identity_prefix(
  status: DispatchEnvironmentReceiptStatus,
) -> String {
  serialize_json_object_prefix(members: [
    json_kv(key: "schema", value: json_string(s: dispatch_environment_receipt_schema)),
    json_kv(key: "status", value: json_string(s: receipt_status_label(status: status))),
  ])
}

fn dispatch_environment_receipt_decode(
  receipt: String,
) -> DispatchEnvironmentReceiptDecode {
  if !json_text_parseable(s: receipt) {
    ReceiptUndecodable { reason: "admission receipt is not one well-formed JSON value" }
  } else if starts_with(
    s: receipt,
    prefix: dispatch_environment_receipt_identity_prefix(status: ReceiptAdmitted),
  ) {
    ReceiptDecoded { status: ReceiptAdmitted }
  } else if starts_with(
    s: receipt,
    prefix: dispatch_environment_receipt_identity_prefix(status: ReceiptRefused),
  ) {
    ReceiptDecoded { status: ReceiptRefused }
  } else {
    ReceiptUndecodable {
      reason: "admission receipt does not lead with this emitter's schema and a known status",
    }
  }
}

fn capability_ensure_receipt_json(receipt: CapabilityEnsureReceipt) -> JsonValue {
  json_object(members: [
    json_kv(key: "capability", value: json_string(s: receipt_capability_label(receipt: receipt))),
    json_kv(key: "executable", value: json_string(s: receipt_executable(receipt: receipt))),
    json_kv(
      key: "decision",
      value: json_string(s: upsert_decision_label(decision: receipt_decision(receipt: receipt))),
    ),
    json_kv(key: "grounded", value: json_bool(b: receipt_grounded(receipt: receipt))),
    json_kv(key: "evidence", value: json_string(s: receipt_evidence(receipt: receipt))),
    json_kv(key: "reason", value: json_string(s: receipt_reason(receipt: receipt))),
  ])
}

fn dispatch_environment_admission_json(
  admission: DispatchEnvironmentAdmission,
) -> String {
  match admission {
    EnvironmentAdmitted { receipts, validation_summary } =>
      serialize_json(v: json_object(members: [
        json_kv(key: "schema", value: json_string(s: dispatch_environment_receipt_schema)),
        json_kv(
          key: "status",
          value: json_string(s: receipt_status_label(status: ReceiptAdmitted)),
        ),
        json_kv(key: "validation", value: json_string(s: validation_summary)),
        json_kv(
          key: "receipts",
          value: json_array(elements: map(receipts, receipt =>
            capability_ensure_receipt_json(receipt: receipt))),
        ),
      ]))
    EnvironmentRefused { receipts, validation_summary, reason } =>
      serialize_json(v: json_object(members: [
        json_kv(key: "schema", value: json_string(s: dispatch_environment_receipt_schema)),
        json_kv(
          key: "status",
          value: json_string(s: receipt_status_label(status: ReceiptRefused)),
        ),
        json_kv(key: "reason", value: json_string(s: reason)),
        json_kv(key: "validation", value: json_string(s: validation_summary)),
        json_kv(
          key: "receipts",
          value: json_array(elements: map(receipts, receipt =>
            capability_ensure_receipt_json(receipt: receipt))),
        ),
      ]))
  }
}
