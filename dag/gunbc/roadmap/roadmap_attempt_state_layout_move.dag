module gunbc.roadmap.roadmap_attempt_state_layout_move

import std.types { String, NonEmptyStr, List, Int, Bool }
import gunbc.executor_privileged_operation { ExecutorPrivilegedOperation, SystemdStopUnit, SystemdDaemonReload, SystemdMaskNowUnit, RetireUnitFragment }
import std.durable_exclusive_hold { DurableHoldHeld, DurableHoldOwnerRef }
import std.durable_compare_and_set { cas_generation_first }
import gunbc.durable_cas_file_store { cas_file_slot_name }
import gunbc.durable_exclusive_hold_file_store { hold_slot_payload }

// THE ONE RULE FOR MOVING A STORE'S FLAT ENTRIES OUT OF THE SHARED DISPATCH ATTEMPT-STATE ROOT INTO ITS OWN
// MEMBER DIRECTORY. A store that used to keep its entries directly in the shared parent root declares one
// MoveRow: the member it now owns and the pattern its legacy flat entries match. Every store's mint refuses
// while any legacy entry remains (move_row_legacy_names), and the deploy legs converge the move with this
// plan (move_plan). Adding a store to the move is a data row, never new control flow (DESIGN section 6b).
//
// The refusal is permanent and typed, never a dual read: a mint that read both layouts would let an ordinal
// claimed in the flat layout be re-claimed in the member.
//
// `content` says what the moved slot holds: HoldPayload for a store whose entry is only an occupied marker (the
// identity ordinals: the owner of an occupied slot is never read), CarryBytes for a store whose entry IS the
// record (the executor writes the legacy bytes and reads them back byte-equal before removing the flat entry).
type MoveContent = HoldPayload | CarryBytes
type MoveRow { member: NonEmptyStr, legacy_flat_prefix: NonEmptyStr, content: MoveContent }

// What the moved slot must hold, given the legacy entry's bytes: the one place the content mode is read.
fn move_expected_content(row: MoveRow, legacy_bytes: String) -> String {
  match row.content {
    HoldPayload => move_hold_payload()
    CarryBytes => legacy_bytes
  }
}

fn move_row_legacy_names(row: MoveRow, parent_listing: String) -> List<String> {
  split(s: parent_listing, delimiter: "\n").filter(fn(n) { starts_with(s: n, prefix: row.legacy_flat_prefix as String) })
}

// The target stem of a legacy entry is its name without the legacy prefix; the member holds records whose
// names begin with that stem.
fn move_target_stem(row: MoveRow, legacy_name: String) -> String {
  match row.content {
    HoldPayload => substring(s: legacy_name, start: string_length(s: row.legacy_flat_prefix as String), end: string_length(s: legacy_name))
    CarryBytes => legacy_name
  }
}

// ONE LEGACY ENTRY'S STEP. `slot_present` is true when the member already lists the exact hold-slot name, i.e. a
// previous run wrote the slot and stopped before removing the flat entry (a failed rm, a dead host). The executor
// reads that slot back: its bytes equal the content the row demands -> only the removal is left (converge); they
// differ -> a real collision, refused. A slot absent from the member is written create-only first.
type MoveEntry { legacy_name: String, slot_name: String, slot_present: Bool }

type MovePlan
  = MoveNoop
  | MoveApply { entries: List<MoveEntry> }
  | MoveRefused { collision: String }

// Noop when nothing remains in the flat layout. Refused when a member entry begins with a legacy entry's target
// stem (equal to it, or followed by the member's separator ".") but is not that entry's own hold-slot name: the
// entry would be claimed twice under another generation. Apply otherwise, naming every legacy entry with whether
// its own slot is already there. Nothing is overwritten and nothing is lost: an entry leaves the old place only
// after its slot exists and has been read back (the executor), so no state is both absent from the old place and
// unwritten in the new one, and a rerun after any stop converges to the same end state.
fn move_plan(row: MoveRow, parent_listing: String, member_listing: String) -> MovePlan {
  let legacy = move_row_legacy_names(row: row, parent_listing: parent_listing)
  if length(xs: legacy) == 0 {
    MoveNoop
  } else {
    let members = split(s: member_listing, delimiter: "\n")
    let clashes = legacy.filter(fn(l) {
      let stem = move_target_stem(row: row, legacy_name: l)
      let own = move_hold_slot_name(row: row, legacy_name: l)
      members.any(fn(m) { m != own && (m == stem || starts_with(s: m, prefix: join([stem, "."], ""))) })
    })
    if length(xs: clashes) > 0 {
      MoveRefused { collision: join(clashes, ",") }
    } else {
      MoveApply { entries: map(legacy, l => MoveEntry {
        legacy_name: l,
        slot_name: move_hold_slot_name(row: row, legacy_name: l),
        slot_present: members.any(fn(m) { m == move_hold_slot_name(row: row, legacy_name: l) }),
      }) }
    }
  }
}

// THE HOLD-SLOT SHAPE A MOVED ENTRY TAKES. A hold store's slot is `<key>.<generation>` holding the held
// payload, both derived by the hold and CAS libraries' own pure functions, so the move writes what
// file_hold_acquire would have written and the store decodes it as occupied. The legacy entry's own content
// is not carried: an occupied identity slot is never read for its owner, and the owner here names the move.
// A CarryBytes entry is already a slot (`<key>.<generation>`): it keeps its name, so the generation it was
// written at survives the move.
fn move_hold_slot_name(row: MoveRow, legacy_name: String) -> String {
  match row.content {
    HoldPayload => cas_file_slot_name(key: move_target_stem(row: row, legacy_name: legacy_name) as NonEmptyStr, generation: cas_generation_first())
    CarryBytes => legacy_name
  }
}

fn move_hold_payload() -> String {
  hold_slot_payload(state: DurableHoldHeld { owner: "moved from the flat attempt-state layout" as DurableHoldOwnerRef }) as String
}

// THE READBACK OF A MOVE, as a refusal text ("" when it held). Nothing legacy remains in the parent, and
// every moved entry is present in the member under its hold-slot name; the legacy set equals the moved set,
// so the highest ordinal moves with it.
fn move_readback_refusal(row: MoveRow, before_parent: String, after_parent: String, after_member: String) -> String {
  let remaining = move_row_legacy_names(row: row, parent_listing: after_parent)
  let members = split(s: after_member, delimiter: "\n")
  let missing = move_row_legacy_names(row: row, parent_listing: before_parent).filter(fn(l) {
    !members.any(fn(m) { m == move_hold_slot_name(row: row, legacy_name: l) })
  })
  if length(xs: remaining) > 0 {
    join(["the move left legacy entries in the parent: ", join(remaining, ",")], "")
  } else if length(xs: missing) > 0 {
    join(["the move lost entries; absent from the member: ", join(missing, ",")], "")
  } else {
    ""
  }
}

// THE LEGACY WRITER MUST BE EXCLUDED BEFORE AND THROUGH THE MOVE, AND THAT IS AN OBSERVATION, NOT AN OPERATOR
// NOTE. The old dispatcher claims an ordinal by creating a flat entry; once the flat entries have moved, its
// first create-only claim on a node succeeds again and re-mints an ordinal the member already holds (a
// duplicate attempt key). The old binary takes the first free ordinal per node, so a filesystem fence would have
// to cover every node and ordinal, which is unbounded; the exclusion is therefore the old writer's own units,
// read from host authority: EXCLUDED means "this unit cannot run", which is LoadState plus ActiveState from
// `systemctl show`: stopped (inactive/failed) AND not loadable (not-found, or masked). A unit that is only stopped
// or only disabled can be started again by a person, a dependency or a .path/.timer trigger.
//
// WHY NOT is-enabled == masked (the reading this replaced). systemd cannot mask a unit whose fragment lives in
// /etc/systemd/system ("File ... already exists"), so that predicate was UNSATISFIABLE for an /etc fragment: the
// apply refused forever at the entry move (srv1 lab, 2026-11-05). The exclusion is reached by a RETIREMENT, chosen
// from the same reading: an /etc fragment is renamed into the apply's rollback store (bytes and digest kept, so a
// refused apply restores it) and the manager reloaded; a vendor fragment (/usr/lib, /lib) is masked. After the act
// the unit is read again and must be excluded, or the apply refuses. An unreadable unit never reads as excluded.
//
// Two fence kinds:
//   LegacyWriterUnits           the units whose ExecStart entry reaches the identity mint (the set is data,
//                               traced by symbol; see legacy_writer_units in roadmap_dashboard_instance), each
//                               with the one /etc fragment path the grant and the rename are pinned to, and the
//                               rollback store the retired bytes move into;
//   LegacyWriterUndeclared      nothing is declared: refuses, never reads as excluded;
//   LegacyWriterFenceConflict   more than one row is declared for one instance: refuses on every route, since
//                               neither row is the authority and a silent pick would be a first- or last-wins fork.
type LegacyWriterUnit { name: NonEmptyStr, etc_fragment: NonEmptyStr }

type LegacyWriterFence
  = LegacyWriterUnits { systemctl: NonEmptyStr, units: List<LegacyWriterUnit>, rollback_store: NonEmptyStr }
  | LegacyWriterUndeclared
  | LegacyWriterFenceConflict { instance_id: NonEmptyStr, rows: Int }

type LegacyWriterExclusion
  = LegacyWriterExcluded
  | LegacyWriterNotExcluded { reason: String }

// What `systemctl show -p LoadState -p ActiveState -p FragmentPath <unit>` read. An empty string is a property
// the output did not carry (distinct from an empty value only in that no reading is acceptable either way).
type LegacyWriterUnitReading { load_state: String, active_state: String, fragment_path: String }

// The unit state words for a unit that is not running.
fn legacy_writer_state_is_stopped(active_state: String) -> Bool {
  active_state == "inactive" || active_state == "failed"
}

// The load states in which the manager will refuse to start the unit.
fn legacy_writer_load_state_cannot_start(load_state: String) -> Bool {
  load_state == "not-found" || load_state == "masked"
}

fn legacy_writer_exclusion(unit: String, reading: LegacyWriterUnitReading) -> LegacyWriterExclusion {
  if reading.load_state == "" || reading.active_state == "" {
    LegacyWriterNotExcluded { reason: join(["the legacy dispatcher unit ", unit, " could not be read (LoadState '", reading.load_state, "', ActiveState '", reading.active_state, "')"], "") }
  } else if !legacy_writer_state_is_stopped(active_state: reading.active_state) {
    LegacyWriterNotExcluded { reason: join(["the legacy dispatcher unit ", unit, " is not stopped (ActiveState read '", reading.active_state, "')"], "") }
  } else if !legacy_writer_load_state_cannot_start(load_state: reading.load_state) {
    LegacyWriterNotExcluded { reason: join(["the legacy dispatcher unit ", unit, " is stopped but still loadable (LoadState read '", reading.load_state, "'), so it can be started again"], "") }
  } else {
    LegacyWriterExcluded
  }
}

// THE RETIREMENT THE READING CALLS FOR. One decision over one unit's reading and its declared /etc fragment.
type LegacyWriterRetirement
  = LegacyWriterAlreadyExcluded
  | LegacyWriterRetireEtcFragment
  | LegacyWriterMaskVendorFragment
  | LegacyWriterRetirementRefused { reason: String }

fn legacy_writer_fragment_is_vendor(path: String) -> Bool {
  starts_with(s: path, prefix: "/usr/lib/systemd/system/") || starts_with(s: path, prefix: "/lib/systemd/system/")
}

// A loaded unit is acted on only when its fragment is the one the fence declares (the /etc case) or a vendor
// path (mask). Any other fragment (a drop-in dir, a transient or runtime unit, an unread path) refuses: the
// grant covers exactly the declared fragment, so no other path has a modeled route.
fn legacy_writer_retirement(unit: LegacyWriterUnit, reading: LegacyWriterUnitReading) -> LegacyWriterRetirement {
  match legacy_writer_exclusion(unit: unit.name as String, reading: reading) {
    LegacyWriterExcluded => LegacyWriterAlreadyExcluded
    LegacyWriterNotExcluded { reason: r } =>
      if reading.load_state == "" || reading.active_state == "" {
        LegacyWriterRetirementRefused { reason: r }
      } else if reading.load_state != "loaded" {
        LegacyWriterRetirementRefused { reason: join([r, "; LoadState '", reading.load_state, "' has no modeled retirement"], "") }
      } else if reading.fragment_path == (unit.etc_fragment as String) {
        LegacyWriterRetireEtcFragment
      } else if legacy_writer_fragment_is_vendor(path: reading.fragment_path) {
        LegacyWriterMaskVendorFragment
      } else {
        LegacyWriterRetirementRefused { reason: join([r, "; its FragmentPath '", reading.fragment_path, "' is neither the declared '", unit.etc_fragment as String, "' nor a vendor path"], "") }
      }
  }
}

// Where a unit's retired fragment bytes are kept: the rollback store, one file per unit. The suffix is not a unit
// type, so a store that is itself a unit search path (the declared one is /etc/systemd/system, which needs no
// directory created and so no further grant) never loads the retained bytes.
data legacy_writer_retained_suffix: String = ".retired-by-gunbc-apply"

fn legacy_writer_retained_path(rollback_store: NonEmptyStr, unit: LegacyWriterUnit) -> NonEmptyStr {
  join([rollback_store as String, "/", unit.name as String, legacy_writer_retained_suffix], "") as NonEmptyStr
}

// THE PRIVILEGED OPERATIONS A RETIREMENT RUNS, in order, as typed operations of gunbc.executor_privileged_operation
// (the one place that renders both the argv the host executes and the sudoers grant that authorizes it). The /etc case
// stops the unit, renames its fragment into the rollback store (the bytes survive; the apply records their digest
// before and after) and reloads the manager; the vendor case stops and masks. Nothing here deletes a byte.
fn legacy_writer_retirement_operations(rollback_store: NonEmptyStr, unit: LegacyWriterUnit, plan: LegacyWriterRetirement) -> List<ExecutorPrivilegedOperation> {
  match plan {
    LegacyWriterAlreadyExcluded => []
    LegacyWriterRetirementRefused { reason: _ } => []
    LegacyWriterRetireEtcFragment => [
      SystemdStopUnit { unit: unit.name },
      RetireUnitFragment { fragment: unit.etc_fragment, retained: legacy_writer_retained_path(rollback_store: rollback_store, unit: unit) },
      SystemdDaemonReload,
    ]
    LegacyWriterMaskVendorFragment => [
      SystemdStopUnit { unit: unit.name },
      SystemdMaskNowUnit { unit: unit.name },
    ]
  }
}

// THE ROLLBACK of a retirement that did not reach exclusion (or of a later refused step): the retained bytes go
// back to the declared fragment and the manager reloads. A vendor mask has no inverse operation modeled (nothing
// declares an unmask grant), so its rollback is empty and the apply reports the mask it could not undo.
fn legacy_writer_restore_operations(rollback_store: NonEmptyStr, unit: LegacyWriterUnit, plan: LegacyWriterRetirement) -> List<ExecutorPrivilegedOperation> {
  match plan {
    LegacyWriterRetireEtcFragment => [
      RetireUnitFragment { fragment: legacy_writer_retained_path(rollback_store: rollback_store, unit: unit), retained: unit.etc_fragment },
      SystemdDaemonReload,
    ]
    LegacyWriterAlreadyExcluded => []
    LegacyWriterMaskVendorFragment => []
    LegacyWriterRetirementRefused { reason: _ } => []
  }
}

// The first refusal over a unit set, or Excluded when every unit is.
fn legacy_writer_exclusion_all(exclusions: List<LegacyWriterExclusion>) -> LegacyWriterExclusion {
  fold(exclusions, init: LegacyWriterExcluded, f: (acc, e) => match acc {
    LegacyWriterNotExcluded { reason: _ } => acc
    LegacyWriterExcluded => e
  })
}

// One instance's declared fence. Data, never control flow: a new instance is a row.
type LegacyWriterFenceRow { instance_id: NonEmptyStr, fence: LegacyWriterFence }

// The fence an instance's declared row yields: Undeclared when it has none, a typed conflict when it has several.
fn legacy_writer_fence_for(rows: List<LegacyWriterFenceRow>, instance_id: NonEmptyStr) -> LegacyWriterFence {
  let mine = rows.filter(fn(r) { r.instance_id == instance_id })
  if length(xs: mine) > 1 {
    LegacyWriterFenceConflict { instance_id: instance_id, rows: length(xs: mine) }
  } else {
    fold(mine, init: LegacyWriterUndeclared, f: (acc, r) => r.fence)
  }
}

// THE GRANT IS THE OPERATION SET, NOT A SECOND LIST. What the operator account is authorized to run
// without a password is exactly the etc-fragment retirement's own operations (stop, rename into the
// rollback store, daemon-reload) and the rollback's reverse rename, for each declared unit and its
// declared fragment path; it is derived by the same two functions the apply leg runs, so a leg argv
// the grant lacks cannot exist (gunbc.recurring_failure_mode
// a_plan_emits_a_privileged_argv_its_hosts_grants_do_not_authorize). The vendor-mask arm is not
// granted (operator decision A: stop, rename, daemon-reload only), so a vendor fragment refuses at
// the sudo prompt rather than running unauthorized. No wildcard: every word is named.
fn legacy_writer_grant_operations(fence: LegacyWriterFence) -> List<ExecutorPrivilegedOperation> {
  match fence {
    LegacyWriterUnits { systemctl: _, units: us, rollback_store: store } =>
      flat_map(us, u => concat(
        legacy_writer_retirement_operations(rollback_store: store, unit: u, plan: LegacyWriterRetireEtcFragment),
        legacy_writer_restore_operations(rollback_store: store, unit: u, plan: LegacyWriterRetireEtcFragment),
      ))
    LegacyWriterUndeclared => []
    LegacyWriterFenceConflict { instance_id: _, rows: _ } => []
  }
}
