module gunbc.roadmap_provider_events

import std.algebra { trim }

import std.types { String, NonEmptyStr, Int, Bool, List, FilePath }
import std.measure {
  CharacterCount,
  character_count,
  character_count_value,
  measure_le,
}
import extdeps.languages.json.grammar {
  JsonTextParseResult, JsonTextParseOk, JsonTextParseFail,
  json_text_parse_string,
  json_text_skip_ws,
  json_text_starts_with_at,
}
import gunbc.harness.harness_tool_kind {
  HarnessTool, RunCommandTool, ReadFileTool, WriteFileTool, EditFileTool,
  ItemIsHarnessToolUse, ItemIsUnrecognizedToolUse, ItemIsNotAHarnessToolUse,
  harness_tool_item_read,
}
import extdeps.languages.json.parse {
  json_text_parseable, parse_json_document, JsonDocumentParse, JsonDocumentParsed, JsonDocumentUnreadable,
  json_field_string, json_field_int, JsonFieldRead, FieldRead, FieldAbsent, FieldMalformed,
}
import extdeps.llm.claude_code_stream_json {
  ClaudeCodeStreamLine,
  ClaudeCodeRateLimitEventLine,
  ClaudeCodeResultLine,
  ClaudeCodeSystemLine,
  ClaudeCodeAssistantLine,
  ClaudeCodeUserLine,
  ClaudeCodeOtherLine,
  ClaudeCodeLineUnreadable,
  claude_code_stream_line,
}

// THE HARNESS ARMS ARE THE READ SIDE OF gunbc.harness.harness_tool_kind. A harness tool use is
// written with an item type derived from its HarnessTool, and provider_item_activity inverts that same
// declaration, so a file read, a file write, a single-match edit and a command arrive as four
// different activities. Write and edit are NOT folded onto EditingFiles: that arm is the Codex
// provider's file_change, a patch item that does not say which of the two happened, and folding
// them would make the read lossy where the write was exact. A consumer that wants "anything that
// changed a file" takes the three arms together; one that wants them apart still can.
// HarnessRefusingUnrecognizedTool is a tool use whose name the harness does not declare -- the
// dispatcher refused it, and it is reported as that rather than as a command or an unknown item.
type ProviderItemActivity
  = RunningCommand
  | EditingFiles
  | UsingConnectedTool
  | Searching
  | UpdatingPlan
  | ReasoningItem
  | Reporting
  | HarnessReadingFile
  | HarnessWritingFile
  | HarnessEditingFile
  | HarnessRefusingUnrecognizedTool
  | UnclassifiedItem

// ONE SHARED EVENT VOCABULARY. Codex, Claude Code, and the gunbc harness write one JSONL
// stream the belt reads; the kind is not a Codex type that other providers nickname into.
// CodexProviderEventKind is deleted (DESIGN §3 replacement migration at the root).
// THE GUNBC HARNESS INTERLEAVES EVENTS OF ITS OWN in that stream: round.usage, the
// per-round token and clock accounting the dashboard's round strip reads (gunbc.harness.harness_throughput);
// turn.alignment_checkpoint_due, the epoch-boundary announcement a chain-carrying turn ends on;
// and turn.wire_log_unwritable, the non-terminal notice that a round's durable wire-log write
// refused (gunbc.harness.harness_turn). The phase fold leaves the provider state unchanged on the
// non-terminal pair; turn.placement_waiting, the worker announcing that it is waiting in line for a
// serving seat before any provider call (gunbc.harness.harness_cli harness_bind_seat_waiting). Before these arms the whole stream was refused at such a line as an unknown
// event type, so a live harness attempt rendered as "Agent evidence refused" with no strip
// (first belt-dispatched attempt, 2026-09-04).
type ProviderEventKind
  = ThreadStarted
  | TurnStarted
  | ItemStarted { activity: ProviderItemActivity }
  | ItemCompleted { activity: ProviderItemActivity }
  | TurnCompleted
  | TurnFailed
  | ProviderStreamError
  | HarnessRoundUsage
  | HarnessBudgetExhausted
  | HarnessAlignmentCheckpointDue
  | HarnessWireLogUnwritable
  | HarnessPlacementWaiting

// Skip is not refuse: a line the classifier names as noise is dropped and the stream continues.
// Refuse is a located stream failure. The classifier decides which; jq does not.
type ProviderEventSkipReason
  = SkipRateLimitEvent
  | SkipClaudeUserWithoutToolResult

type ProviderEventLineDisposition
  = ProviderEventObserved { kind: ProviderEventKind }
  | ProviderEventSkipped { reason: ProviderEventSkipReason }
  | ProviderEventLineRefused { reason: String }

type ProviderEvent {
  line_number: Int
  raw: String
  kind: ProviderEventKind
}

type ProviderEventParse
  = ProviderEventsParsed { events: List<ProviderEvent> }
  | ProviderEventStreamRefused {
      events_before_refusal: List<ProviderEvent>,
      line_number: Int,
      raw: String,
      reason: String,
    }

type ProviderParseFold {
  events: List<ProviderEvent>
  next_line_number: Int
  total_lines: Int
  refused: Bool
  refused_line_number: Int
  refused_raw: String
  refused_reason: String
}

// BUDGET SPENT IS TERMINAL AND IS NOT FAILED. The harness ends a turn when its step budget is spent
// (gunbc.harness.harness_turn turn.budget_exhausted) or when a chain-carrying epoch announces its
// alignment checkpoint (turn.alignment_checkpoint_due -- adjudication is the workflow's, and it is
// not a pronouncement on the work); the work those rounds produced is in the
// worktree and the belt commits and verifies it exactly as it does a completed turn. Folding it into
// ProviderFailed put "Agent failed" beside "Verification passed" on one row (attempt 7f08b76ceb8f4424,
// 2026-09-04), a pair the reader cannot reconcile because it is false: nothing failed. The verdict is
// the judge of the work; this state says only that the worker was stopped, and how far it got.
type ProviderExecutionState
  = ProviderNotStarted
  | ProviderStarting { activity: String }
  | ProviderAwaitingSeat { detail: String }
  | ProviderRunning { activity: String }
  | ProviderCompleted { activity: String }
  | ProviderFailed { activity: String, detail: String }
  | ProviderBudgetSpent { activity: String, detail: String }
  | ProviderEventsRefused { activity: String, detail: String }

// review 44089. These are budgets measured in CHARACTERS — a count of a unit, not a bare scalar —
// so they consume std.measure's CharacterCount on the same Measure<Count, One, Nat> axis
// HardwareThreadCount instantiates, and the oversize test is measure_le rather than a raw >. The
// wire spellings (the jq slice bounds and the refusal text) project the count at the boundary; the
// budgets themselves never travel as Int.

data codex_provider_event_line_observation_budget: CharacterCount = character_count(count: 65536)

data codex_provider_projection_type_budget: CharacterCount = character_count(count: 128)
data codex_provider_projection_detail_budget: CharacterCount = character_count(count: 4096)

// The agent's REPORT gets its own budget rather than reusing the detail budget beside it, because
// the two bound different things for different readers. A detail is a diagnostic — a terminal
// error's message, read to find out what broke, and short by nature. A report is what the provider
// says it DID, and it is the text an operator reads to judge whether the work is any good; it is
// the closest thing the dashboard has to the agent's answer. Sharing one number would mean a future
// tuning of either bound silently retunes the other, which is the coincidence-not-concept trap
// DESIGN §2 warns about — they are the same TYPE (CharacterCount, the same Measure axis) and
// genuinely different FACTS.
//
// 8192 is chosen against the incident this whole projection exists to prevent: a single
// item.completed carrying ~154KB of aggregated command output, which killed the old 64KB line
// reader. A report is bounded an order of magnitude under the 65536 line budget, so it cannot be
// the payload that reproduces that failure, while still being generous enough that a substantial
// multi-paragraph summary arrives whole and truncation stays the exception rather than the norm. It
// is deliberately larger than the 4096 detail budget: an error message that needs 4KB is
// pathological, a work summary that needs 6KB is ordinary.

data codex_provider_projection_message_budget: CharacterCount = character_count(count: 8192)

// TRUNCATION IS REPORTED, NEVER SILENT — the one place this projection could otherwise fabricate a plausible output (DESIGN §5). Everywhere else the bounds guard a machine-read classification, where a cut string simply fails to match and refuses; here the bounded value is PROSE AN OPERATOR READS AND ACTS ON, so a report severed mid-sentence and presented as if complete is a wrong answer delivered confidently — the operator would judge the work on a fragment while the screen gave no sign anything was missing. The projected envelope therefore carries the boundedness as its own member — a `message` object pairing the bounded text with a `truncated` flag — where truncated is computed from the ORIGINAL length before slicing, so it is a statement about the provider's actual output rather than about the slice. A consumer that renders text without consulting truncated is re-opening the arm this row closes, which is why the flag is a sibling of the text and not a derived guess about whether the slice happens to sit on the budget.
// DECLARED SCAFFOLD (review 44058, DESIGN 6). This is a jq PROGRAM assembled by join — a foreign
// language built as a string. It is Codex-only: which Claude lines count, which content blocks
// are projected, and slicing of Claude wire fields live in claude_code_stream_line and
// classify_claude_code_stream_line, never here. Minting a jq grammar would buy an emitter for a
// filter that exists ONLY to bound a Codex JSONL line before the substrate reads it (DESIGN 6
// purity trap). DISSOLVES ON: observation reading the attempt JSONL under a substrate-side line
// bound instead of shelling to a projector, at which point BOTH this filter and
// ProviderEventProjectionCapability delete together. Interpolated values are the CharacterCount
// budgets above, never caller input.
data codex_provider_event_projection_filter: NonEmptyStr = join([
  "fromjson | def event_type: if (.type | type) == \"string\" then .type[0:",
  to_string(character_count_value(c: codex_provider_projection_type_budget)),
  "] else \"unknown\" end; def item_type: if (.item.type | type) == \"string\" then .item.type[0:",
  to_string(character_count_value(c: codex_provider_projection_type_budget)),
  "] else \"unknown\" end; def num: if type == \"number\" then . else null end; def bounded_text: if . == null then \"\" elif type == \"string\" then .[0:",
  to_string(character_count_value(c: codex_provider_projection_detail_budget)),
  "] elif type == \"object\" and (.message | type) == \"string\" then .message[0:",
  to_string(character_count_value(c: codex_provider_projection_detail_budget)),
  "] else tostring[0:",
  to_string(character_count_value(c: codex_provider_projection_detail_budget)),
  "] end; def agent_report: if (.item.text | type) == \"string\" then {\"text\":(.item.text[0:",
  to_string(character_count_value(c: codex_provider_projection_message_budget)),
  "]),\"truncated\":((.item.text | length) > ",
  to_string(character_count_value(c: codex_provider_projection_message_budget)),
  ")} else null end; (event_type) as $type | if $type == \"item.started\" or $type == \"item.completed\" then (if item_type == \"agent_message\" and (agent_report != null) then {\"type\":$type,\"item\":{\"type\":item_type,\"message\":agent_report}} else {\"type\":$type,\"item\":{\"type\":item_type}} end) elif $type == \"turn.failed\" then {\"type\":$type,\"error\":{\"message\":(.error | bounded_text)}} elif $type == \"turn.budget_exhausted\" then {\"type\":$type,\"steps_taken\":(.steps_taken | num)} elif $type == \"turn.placement_waiting\" then {\"type\":$type,\"wait\":(.wait | num),\"wait_cap\":(.wait_cap | num),\"reason\":(.reason | bounded_text)} elif $type == \"error\" then {\"type\":$type,\"message\":((.message // .error) | bounded_text)} elif $type == \"round.usage\" then ({\"type\":$type,\"step\":(.step | num),\"input_tokens\":(.input_tokens | num),\"output_tokens\":(.output_tokens | num),\"epoch_ms\":(.epoch_ms | num)} + (if (.files_changed | type) == \"number\" then {\"files_changed\":.files_changed} else {} end) + (if (.tool_calls | type) == \"number\" then {\"tool_calls\":.tool_calls} else {} end)) elif $type == \"result\" then ({\"type\":$type} + (if (.subtype | type) == \"string\" then {\"subtype\":.subtype[0:",
  to_string(character_count_value(c: codex_provider_projection_type_budget)),
  "]} else {} end) + (if (.is_error | type) == \"boolean\" then {\"is_error\":.is_error} else {} end)) elif $type == \"system\" then {\"type\":$type} elif $type == \"assistant\" or $type == \"user\" then {\"type\":$type,\"message\":(if (.message | type) == \"object\" then {\"content\":(if (.message.content | type) == \"array\" then [.message.content[] | {\"type\":(if (.type | type) == \"string\" then .type[0:",
  to_string(character_count_value(c: codex_provider_projection_type_budget)),
  "] else .type end)}] else .message.content end)} else .message end)} else {\"type\":$type} end",
], "") as NonEmptyStr

fn codex_provider_event_projection_args(path: FilePath) -> List<String> {
  [
    "--raw-input",
    "--compact-output",
    codex_provider_event_projection_filter as String,
    path as String,
  ]
}

fn classify_claude_code_stream_line(line: ClaudeCodeStreamLine) -> ProviderEventLineDisposition {
  match line {
    ClaudeCodeSystemLine =>
      ProviderEventObserved { kind: ThreadStarted }
    ClaudeCodeAssistantLine { has_tool_use } =>
      if has_tool_use {
        ProviderEventObserved { kind: ItemStarted { activity: RunningCommand } }
      } else {
        ProviderEventObserved { kind: ItemCompleted { activity: Reporting } }
      }
    ClaudeCodeUserLine { has_tool_result } =>
      if has_tool_result {
        ProviderEventObserved { kind: ItemCompleted { activity: RunningCommand } }
      } else {
        ProviderEventSkipped { reason: SkipClaudeUserWithoutToolResult }
      }
    ClaudeCodeResultLine { result } =>
      if result.is_error {
        ProviderEventObserved { kind: TurnFailed }
      } else {
        ProviderEventObserved { kind: TurnCompleted }
      }
    ClaudeCodeRateLimitEventLine { info: _ } =>
      ProviderEventSkipped { reason: SkipRateLimitEvent }
    ClaudeCodeOtherLine { event_type: _ } =>
      ProviderEventLineRefused { reason: "unknown provider JSONL event type" }
    ClaudeCodeLineUnreadable { gap: _ } =>
      ProviderEventLineRefused { reason: "malformed Claude stream-json line" }
  }
}

// The attempt-owned provider-events.jsonl remains the complete Codex protocol authority. Workflow
// observation first runs a separately modeled jq capability over that file. `--raw-input` plus
// `fromjson` proves exactly one JSON value per physical JSONL line before emitting only a bounded
// envelope (top-level event type, bounded item type, and a bounded terminal error detail); two
// values on one line, a multiline value, and malformed JSON all refuse. Large command
// aggregated_output therefore becomes opaque to the synchronous dashboard without becoming lost
// evidence or an invented success. The exact jq executable and identity probe are part of
// dispatch-platform Ensure and dashboard provisioning; absence refuses before dispatch and is also
// visible as an observation refusal for retained attempts. A malformed raw event makes jq nonzero,
// so no parsed prefix is accepted as a complete observation.

// Codex --json is the provider protocol authority: one JSON object per line with thread.started,
// turn.started, item.*, turn.completed, turn.budget_exhausted, turn.failed, and error event types,
// plus the harness's own round.usage, turn.alignment_checkpoint_due and turn.wire_log_unwritable
// (gunbc.harness.harness_turn). The raw stream is
// structurally reduced by codex_provider_event_projection_filter before this bounded total envelope
// classifier runs. The shared RFC 8259 grammar proves each projected line parseable, then the
// classifier requires the emitted top-level `type` member to be the first object member before
// selecting a closed event variant. That fail-closed envelope rule prevents a nested item or
// user-authored string containing `type: turn.completed` from fabricating terminal success.
// Projected lines are mechanically bounded; the remaining line budget is a red control against
// projector drift and refuses before grammar descent with the payload elided. Unknown, reordered,
// malformed, or truncated projected lines still refuse with their located evidence and parsed
// prefix. A refusal is a workflow fact, never dropped as console noise. Item activity is only a
// presentation projection from the bounded item type; terminal success/failure comes only from the
// anchored top-level turn.completed, turn.failed, or error envelope, never from tmux Spawned.

// review 44058. Both reads below are ANCHORED walks over the projector's own envelope shape, not
// scans. codex_line_contains_type_token, which this replaces, searched the whole line for a
// `"type":"…"` fragment in either spacing — so an agent_message whose text quoted
// `"type":"file_change"` reclassified the pane's activity, the same fragment-scan class the
// top-level classifier already refused to use for terminal events and the same one the dashboard
// health readback was repaired for. The projector emits exactly {"type":…} for plain events and
// {"type":…,"item":{"type":…}} for item events — plus, on an agent_message item only, a "message"
// member SIBLING to and AFTER item.type carrying the bounded report and its truncation flag. The
// anchor is unaffected by that addition and that is why it was placed there: item.type remains
// item's FIRST member, so the walk's landing position is unchanged, and a report whose own text
// quotes an item-type fragment still cannot reclassify the pane because the walk never reaches it.
// Both anchored members have a known position and the walk either lands on it or answers false.
// codex_envelope_member_value_start is the single step both readings share (DESIGN 2, one concept).

fn codex_envelope_object_first_member(raw: String, at: Int) -> Int? {
  let start = json_text_skip_ws(s: raw, i: at)
  if json_text_starts_with_at(s: raw, i: start, lit: "\{") {
    Present { value: start + 1 }
  } else {
    none
  }
}

fn codex_envelope_member_value_start(raw: String, at: Int, key: String) -> Int? {
  let quoted = join(["\"", key, "\""], "")
  let key_start = json_text_skip_ws(s: raw, i: at)
  if !json_text_starts_with_at(s: raw, i: key_start, lit: quoted) {
    none
  } else {
    let colon = json_text_skip_ws(
      s: raw,
      i: key_start + string_length(s: quoted),
    )
    if json_text_starts_with_at(s: raw, i: colon, lit: ":") {
      Present { value: json_text_skip_ws(s: raw, i: colon + 1) }
    } else {
      none
    }
  }
}

fn codex_envelope_string_member_is(raw: String, at: Int, expected: String) -> Bool {
  let token = join(["\"", expected, "\""], "")
  let after = json_text_skip_ws(s: raw, i: at + string_length(s: token))
  json_text_starts_with_at(s: raw, i: at, lit: token)
    && (
      json_text_starts_with_at(s: raw, i: after, lit: ",")
        || json_text_starts_with_at(s: raw, i: after, lit: "\}")
    )
}

fn codex_line_has_top_level_type(raw: String, event_type: String) -> Bool {
  match codex_envelope_object_first_member(raw: raw, at: 0) {
    Absent => false
    Present { value: member } =>
      match codex_envelope_member_value_start(raw: raw, at: member, key: "type") {
        Absent => false
        Present { value: value_start } =>
          codex_envelope_string_member_is(
            raw: raw,
            at: value_start,
            expected: event_type,
          )
      }
  }
}

// THE ITEM TYPE IS READ ONCE, AS A VALUE, and classified afterwards. The walk is the anchored one
// described above; what it returns is the text between the quotes of item's first member, and only
// when that member is a well-formed string followed by `,` or `}`. An item type carrying an escape
// comes back in its escaped spelling, which equals no declared kind and so classifies as
// unclassified -- the same answer the per-candidate token comparison this replaces gave.
fn codex_line_item_type(raw: String) -> String? {
  match codex_envelope_object_first_member(raw: raw, at: 0) {
    Absent => none
    Present { value: member } =>
      match codex_envelope_member_value_start(raw: raw, at: member, key: "type") {
        Absent => none
        Present { value: type_value } =>
          match json_text_parse_string(s: raw, i: type_value) {
            JsonTextParseFail { end: _ } => none
            JsonTextParseOk { end: after_type } => {
              let comma = json_text_skip_ws(s: raw, i: after_type)
              if !json_text_starts_with_at(s: raw, i: comma, lit: ",") {
                none
              } else {
                match codex_envelope_member_value_start(
                  raw: raw,
                  at: comma + 1,
                  key: "item",
                ) {
                  Absent => none
                  Present { value: item_object } =>
                    match codex_envelope_object_first_member(
                      raw: raw,
                      at: item_object,
                    ) {
                      Absent => none
                      Present { value: item_member } =>
                        match codex_envelope_member_value_start(
                          raw: raw,
                          at: item_member,
                          key: "type",
                        ) {
                          Absent => none
                          Present { value: item_value } =>
                            match json_text_parse_string(s: raw, i: item_value) {
                              JsonTextParseFail { end: _ } => none
                              JsonTextParseOk { end: after_item } => {
                                let after = json_text_skip_ws(s: raw, i: after_item)
                                if json_text_starts_with_at(s: raw, i: after, lit: ",")
                                  || json_text_starts_with_at(s: raw, i: after, lit: "\}") {
                                  Present {
                                    value: raw.substring(start: item_value + 1, end: after_item - 1),
                                  }
                                } else {
                                  none
                                }
                              }
                            }
                        }
                    }
                }
              }
            }
          }
      }
  }
}

fn harness_tool_item_activity(tool: HarnessTool) -> ProviderItemActivity {
  match tool {
    RunCommandTool => RunningCommand
    ReadFileTool => HarnessReadingFile
    WriteFileTool => HarnessWritingFile
    EditFileTool => HarnessEditingFile
  }
}

// The item types below are the Codex provider's own and the harness's agent_message. The kinds a
// harness tool use is written as are not spelled here: they are read through
// gunbc.harness.harness_tool_kind, which is also what wrote them.
fn codex_provider_item_activity(item_type: String) -> ProviderItemActivity {
  if item_type == "file_change" {
    EditingFiles
  } else if item_type == "mcp_tool_call" {
    UsingConnectedTool
  } else if item_type == "web_search" {
    Searching
  } else if item_type == "plan_update" {
    UpdatingPlan
  } else if item_type == "reasoning" {
    ReasoningItem
  } else if item_type == "agent_message" {
    Reporting
  } else {
    UnclassifiedItem
  }
}

fn provider_item_activity(raw: String) -> ProviderItemActivity {
  match codex_line_item_type(raw: raw) {
    Absent => UnclassifiedItem
    Present { value: item_type } =>
      match harness_tool_item_read(item_type: item_type) {
        ItemIsHarnessToolUse { tool: t } => harness_tool_item_activity(tool: t)
        ItemIsUnrecognizedToolUse => HarnessRefusingUnrecognizedTool
        ItemIsNotAHarnessToolUse => codex_provider_item_activity(item_type: item_type)
      }
  }
}

fn provider_item_activity_label(activity: ProviderItemActivity) -> String {
  match activity {
    RunningCommand => "running command"
    EditingFiles => "editing files"
    UsingConnectedTool => "using connected tool"
    Searching => "searching"
    UpdatingPlan => "updating plan"
    ReasoningItem => "reasoning"
    Reporting => "reporting"
    HarnessReadingFile => "reading file"
    HarnessWritingFile => "writing file"
    HarnessEditingFile => "editing file"
    HarnessRefusingUnrecognizedTool => "refusing an undeclared tool"
    UnclassifiedItem => "provider item"
  }
}

fn classify_provider_event_line(raw: String) -> ProviderEventLineDisposition {
  if codex_line_has_top_level_type(raw: raw, event_type: "thread.started") {
    ProviderEventObserved { kind: ThreadStarted }
  } else if codex_line_has_top_level_type(raw: raw, event_type: "turn.started") {
    ProviderEventObserved { kind: TurnStarted }
  } else if codex_line_has_top_level_type(raw: raw, event_type: "item.started") {
    ProviderEventObserved { kind: ItemStarted { activity: provider_item_activity(raw: raw) } }
  } else if codex_line_has_top_level_type(raw: raw, event_type: "item.completed") {
    ProviderEventObserved { kind: ItemCompleted { activity: provider_item_activity(raw: raw) } }
  } else if codex_line_has_top_level_type(raw: raw, event_type: "turn.completed") {
    ProviderEventObserved { kind: TurnCompleted }
  } else if codex_line_has_top_level_type(raw: raw, event_type: "turn.failed") {
    ProviderEventObserved { kind: TurnFailed }
  } else if codex_line_has_top_level_type(raw: raw, event_type: "turn.budget_exhausted") {
    ProviderEventObserved { kind: HarnessBudgetExhausted }
  } else if codex_line_has_top_level_type(raw: raw, event_type: "round.usage") {
    ProviderEventObserved { kind: HarnessRoundUsage }
  } else if codex_line_has_top_level_type(raw: raw, event_type: "turn.alignment_checkpoint_due") {
    ProviderEventObserved { kind: HarnessAlignmentCheckpointDue }
  } else if codex_line_has_top_level_type(raw: raw, event_type: "turn.placement_waiting") {
    ProviderEventObserved { kind: HarnessPlacementWaiting }
  } else if codex_line_has_top_level_type(raw: raw, event_type: "turn.wire_log_unwritable") {
    ProviderEventObserved { kind: HarnessWireLogUnwritable }
  } else if codex_line_has_top_level_type(raw: raw, event_type: "error") {
    ProviderEventObserved { kind: ProviderStreamError }
  } else {
    classify_claude_code_stream_line(line: claude_code_stream_line(line: raw))
  }
}

fn provider_parse_fold_line(
  state: ProviderParseFold,
  line: String,
  line_budget: CharacterCount,
) -> ProviderParseFold {
  if state.refused {
    ProviderParseFold {
      events: state.events,
      next_line_number: state.next_line_number + 1,
      total_lines: state.total_lines,
      refused: state.refused,
      refused_line_number: state.refused_line_number,
      refused_raw: state.refused_raw,
      refused_reason: state.refused_reason,
    }
  } else {
    let raw = trim(line)
    let raw_chars = character_count(count: string_length(s: raw))
    let is_trailing_empty = raw == ""
      && state.next_line_number == state.total_lines
    if is_trailing_empty {
      ProviderParseFold {
        events: state.events,
        next_line_number: state.next_line_number + 1,
        total_lines: state.total_lines,
        refused: false,
        refused_line_number: 0,
        refused_raw: "",
        refused_reason: "",
      }
    } else if !measure_le(a: raw_chars, b: line_budget) {
      ProviderParseFold {
        events: state.events,
        next_line_number: state.next_line_number + 1,
        total_lines: state.total_lines,
        refused: true,
        refused_line_number: state.next_line_number,
        refused_raw: join([
          "<oversized provider JSONL event elided: ",
          to_string(character_count_value(c: raw_chars)),
          " chars>",
        ], ""),
        refused_reason: join([
          "provider JSONL event exceeds observation line budget ",
          to_string(character_count_value(c: line_budget)),
          " chars; full raw remains in attempt evidence",
        ], ""),
      }
    } else if raw == "" {
      ProviderParseFold {
        events: state.events,
        next_line_number: state.next_line_number + 1,
        total_lines: state.total_lines,
        refused: true,
        refused_line_number: state.next_line_number,
        refused_raw: line,
        refused_reason: "empty line inside provider JSONL stream",
      }
    } else if !json_text_parseable(s: raw) {
      ProviderParseFold {
        events: state.events,
        next_line_number: state.next_line_number + 1,
        total_lines: state.total_lines,
        refused: true,
        refused_line_number: state.next_line_number,
        refused_raw: line,
        refused_reason: "malformed or truncated provider JSONL object",
      }
    } else {
      match classify_provider_event_line(raw: raw) {
        ProviderEventObserved { kind } =>
          ProviderParseFold {
            events: append(state.events, [ProviderEvent {
              line_number: state.next_line_number,
              raw: raw,
              kind: kind,
            }]),
            next_line_number: state.next_line_number + 1,
            total_lines: state.total_lines,
            refused: false,
            refused_line_number: 0,
            refused_raw: "",
            refused_reason: "",
          }
        ProviderEventSkipped { reason: _ } =>
          ProviderParseFold {
            events: state.events,
            next_line_number: state.next_line_number + 1,
            total_lines: state.total_lines,
            refused: false,
            refused_line_number: 0,
            refused_raw: "",
            refused_reason: "",
          }
        ProviderEventLineRefused { reason } =>
          ProviderParseFold {
            events: state.events,
            next_line_number: state.next_line_number + 1,
            total_lines: state.total_lines,
            refused: true,
            refused_line_number: state.next_line_number,
            refused_raw: line,
            refused_reason: reason,
          }
      }
    }
  }
}

fn parse_codex_jsonl_with_line_budget(
  text: String,
  line_budget: CharacterCount,
) -> ProviderEventParse {
  if text == "" {
    ProviderEventsParsed { events: [] }
  } else {
    let lines = split(s: text, delimiter: "\n")
    let state = fold(
      lines,
      init: ProviderParseFold {
        events: [],
        next_line_number: 1,
        total_lines: count(lines),
        refused: false,
        refused_line_number: 0,
        refused_raw: "",
        refused_reason: "",
      },
      f: fn(acc, line) {
        provider_parse_fold_line(
          state: acc,
          line: line,
          line_budget: line_budget,
        )
      },
    )
    if state.refused {
      ProviderEventStreamRefused {
        events_before_refusal: state.events,
        line_number: state.refused_line_number,
        raw: state.refused_raw,
        reason: state.refused_reason,
      }
    } else {
      ProviderEventsParsed { events: state.events }
    }
  }
}

fn parse_codex_jsonl(text: String) -> ProviderEventParse {
  parse_codex_jsonl_with_line_budget(
    text: text,
    line_budget: codex_provider_event_line_observation_budget,
  )
}

// THE WAIT'S REASON, READ FROM ITS OWN LINE. The line is the harness's own construction, so a
// line that does not decode is shown as itself rather than guessed at.
fn harness_placement_waiting_detail(raw: String) -> String {
  match parse_json_document(s: raw) {
    JsonDocumentUnreadable { gap: _ } => join(["undecodable wait announcement: ", raw], "")
    JsonDocumentParsed { value: v } => {
      let reason = match json_field_string(obj: v, key: "reason") {
        FieldRead { value: r } => r
        FieldAbsent => "no reason recorded"
        FieldMalformed { cause: c } => join(["reason unreadable: ", c], "")
      }
      let wait = match json_field_int(obj: v, key: "wait") {
        FieldRead { value: n } => to_string(n)
        FieldAbsent => "?"
        FieldMalformed { cause: _ } => "?"
      }
      let cap = match json_field_int(obj: v, key: "wait_cap") {
        FieldRead { value: n } => to_string(n)
        FieldAbsent => "?"
        FieldMalformed { cause: _ } => "?"
      }
      join(["placement pending, wait ", wait, " of ", cap, ", asking again each interval: ", reason], "")
    }
  }
}

fn provider_execution_fold_event(
  state: ProviderExecutionState,
  event: ProviderEvent,
) -> ProviderExecutionState {
  match state {
    ProviderCompleted { activity: _ } => state
    ProviderFailed { activity: _, detail: _ } => state
    ProviderBudgetSpent { activity: _, detail: _ } => state
    ProviderEventsRefused { activity: _, detail: _ } => state
    _ =>
      match event.kind {
        ThreadStarted => ProviderStarting { activity: "thread started" }
        TurnStarted => ProviderRunning { activity: "agent started" }
        HarnessRoundUsage => state
        HarnessWireLogUnwritable => state
        HarnessPlacementWaiting => ProviderAwaitingSeat { detail: harness_placement_waiting_detail(raw: event.raw) }
        HarnessAlignmentCheckpointDue =>
          ProviderBudgetSpent {
            activity: "Alignment checkpoint due · adjudication decides resume",
            detail: event.raw,
          }
        ItemStarted { activity } =>
          ProviderRunning {
            activity: join(
              ["Agent working · ", provider_item_activity_label(activity: activity)],
              "",
            ),
          }
        ItemCompleted { activity } =>
          ProviderRunning {
            activity: match activity {
              Reporting => "Agent finishing"
              _ =>
                join(
                  ["Agent working · ", provider_item_activity_label(activity: activity)],
                  "",
                ),
            },
          }
        TurnCompleted =>
          ProviderCompleted { activity: "Agent complete" }
        TurnFailed =>
          ProviderFailed { activity: "agent turn failed", detail: event.raw }
        HarnessBudgetExhausted =>
          ProviderBudgetSpent { activity: "Agent stopped at its round budget", detail: event.raw }
        ProviderStreamError =>
          ProviderFailed { activity: "provider error", detail: event.raw }
      }
  }
}

fn provider_execution_state(parsed: ProviderEventParse) -> ProviderExecutionState {
  match parsed {
    ProviderEventsParsed { events } =>
      fold(
        events,
        init: ProviderNotStarted,
        f: fn(state, event) {
          provider_execution_fold_event(state: state, event: event)
        },
      )
    ProviderEventStreamRefused {
      events_before_refusal,
      line_number,
      raw,
      reason,
    } =>
      let prior = fold(
        events_before_refusal,
        init: ProviderNotStarted,
        f: fn(state, event) {
          provider_execution_fold_event(state: state, event: event)
        },
      )
      ProviderEventsRefused {
        activity: match prior {
          ProviderNotStarted => "event stream refused"
          ProviderStarting { activity } =>
            join(["last observed · ", activity], "")
          ProviderAwaitingSeat { detail: _ } =>
            "last observed · waiting for a serving seat"
          ProviderRunning { activity } =>
            join(["last observed · ", activity], "")
          ProviderCompleted { activity } =>
            join(["last observed · ", activity], "")
          ProviderFailed { activity, detail: _ } =>
            join(["last observed · ", activity], "")
          ProviderBudgetSpent { activity, detail: _ } =>
            join(["last observed · ", activity], "")
          ProviderEventsRefused { activity, detail: _ } =>
            join(["last observed · ", activity], "")
        },
        detail: join([
          "line ", to_string(line_number), ": ", reason, "; raw=", raw,
        ], ""),
      }
  }
}

fn provider_execution_state_label(state: ProviderExecutionState) -> String {
  match state {
    ProviderNotStarted => "not_started"
    ProviderStarting { activity: _ } => "starting"
    ProviderAwaitingSeat { detail: _ } => "awaiting_seat"
    ProviderRunning { activity: _ } => "running"
    ProviderCompleted { activity: _ } => "completed"
    ProviderFailed { activity: _, detail: _ } => "failed"
    ProviderBudgetSpent { activity: _, detail: _ } => "budget_spent"
    ProviderEventsRefused { activity: _, detail: _ } => "events_refused"
  }
}

fn provider_execution_activity(state: ProviderExecutionState) -> String {
  match state {
    ProviderNotStarted => "Agent waiting"
    ProviderStarting { activity: _ } => "Agent working"
    ProviderAwaitingSeat { detail: _ } => "Agent waiting for a serving seat"
    ProviderRunning { activity } => activity
    ProviderCompleted { activity: _ } => "Agent complete"
    ProviderFailed { activity: _, detail: _ } => "Agent failed"
    ProviderBudgetSpent { activity, detail: _ } => activity
    ProviderEventsRefused { activity, detail: _ } => activity
  }
}

fn provider_execution_detail(state: ProviderExecutionState) -> String {
  match state {
    ProviderFailed { activity: _, detail } => detail
    ProviderBudgetSpent { activity: _, detail } => detail
    ProviderEventsRefused { activity: _, detail } => detail
    ProviderAwaitingSeat { detail } => detail
    _ => ""
  }
}
