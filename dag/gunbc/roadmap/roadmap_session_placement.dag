// G5 OF THE DOGFOOD ROUTE: THE AGENT SESSION HOLDS A PLACEMENT GRANT AND RUNS INSIDE ITS BOUNDS.
//
// Before this module the model TURN held a fabric seat (gunbc.harness.harness_seat) while the agent
// SESSION that issues those turns held nothing: the worker ran as a transient unit whose MemoryMax
// was the instance's ceiling read straight off the deployment. This module is the session's side of
// the one capacity authority (DESIGN 3b fabric/compute row): it reserves the session's memory through
// gunbc.compute.host_capacity -- the same ledger, linearization and quiescence-required release law
// compute_provide uses -- from the host's AGENT SESSION pool, a partition separate from the build pool
// so a session never holds the capacity its own builds need (bold-bee-114 ruling 2026-10-03). The
// amount is gunbc.compute.work_class_grant's answer for WorkClassAgentSession, and the unit's
// MemoryMax is that amount through gunbc.compute.unit_bounds.
//
// THE LIFECYCLE IS gunbc.compute.attempt_lifecycle's, NOT A SECOND ONE (side-chat ruling on #13074,
// NO-LAND at b4d4a42). A ledger encumbrance is durable and quiescence-required -- a term that runs out
// frees nothing -- so every point at which the spawning process can die must leave a state some
// LATER process can resolve. The compute provider's attempt slot already is that machine: a CAS slot
// keyed by the reservation reference, Reserved -> Launching -> Terminal, a temporal trigger while no
// unit can exist and an observational one once it can. The session conforms to it with one ordering
// difference that closes the window the ruling named: the slot is OPENED BEFORE THE RESERVATION, so
// there is no instant at which the ledger holds this reference and no slot names it. A crash after
// opening and before reserving leaves a slot whose release finds nothing to return; a crash anywhere
// after reserving leaves a slot recovery can terminate and release. (gunbc.compute.work_provider_local
// reserves first and opens second, so it still has that window; it is outside this change.)
//
// WHAT RECOVERY READS AND WHEN. session_placement_settle_pass enumerates every slot in the session
// store (gunbc.durable_cas_file_store cas_slot_keys) -- not the workflow ledger, not the placement
// files -- so a slot whose files were never written is still found. The belt runs it once per tick
// BEFORE any new acquisition, which covers controller death and host reboot as well as returned
// failures, because it starts from the store rather than from anything the dead process meant to do.
//
// DECLARED FRONTIER (DESIGN 3c), WITH ITS TRIGGER: THE REVIEWER SESSION IS NO LONGER UNLEASED
// (still-hawk-558, 2026-10-28, after the srv1 OOM receipt: 17 unleased reviewers at the instance
// ceiling blew the 44 GiB slice mid-typecheck). A reviewer launch now takes its grant from the same
// capacity authority the workers use -- gunbc.compute.host_capacity's ReviewerSessionPool, its own
// seats, its own partition, with the slice leg adjudicating the cgroup the units actually land in
// (the section at the foot of this module). Its MemoryMax is the granted amount, one figure for
// reservation and cap. What REMAINS at the frontier: auditor and supervisor sessions still start
// unleased at the instance ceiling; they join the ledger as their own classes once measured peak
// rows size them (the reviewer's producer, below, is the pattern they follow), and their belt arms
// have no acquire call site yet. Vendor providers (claude, codex, cursor) run in tmux, whose panes
// escape any unit's cgroup, so they hold no placement until they move into a unit; their attempts
// read SessionPlacementAbsent, which is the truth.

// THE ROLE SEGMENTS OF THE RECORD NAMES. Two roles hold placements now, so the coproduct the first
// role's note promised lands here rather than as a second string constant: the segment is the
// role's token, and the identity and every durable name are built FROM the role value, so a third
// role adds an arm and not another pair of twins.
data session_worker_role: String = "worker"
data session_reviewer_role: String = "reviewer"

// THE ROLES THAT HOLD PLACEMENTS, as a coproduct (the note above kept its promise with the second
// role's arrival). A reviewer's identity is NOT just its role: one attempt runs one worker but one
// reviewer PER CRITERION, so the reviewer arm carries the criterion it reviews, and equality of two
// reviewer roles is equality of criteria. The role TOKENS above stay the wire vocabulary; this type
// is what functions pass, so no caller re-spells the token-criterion join.
type SessionRole
  = SessionWorkerSessionRole
  | SessionReviewerSessionRole { criterion_key: String }

fn session_role_token(r: SessionRole) -> String {
  match r {
    SessionWorkerSessionRole => session_worker_role
    SessionReviewerSessionRole { criterion_key: _ } => session_reviewer_role
  }
}

// THE FILENAME SEGMENT THAT MAKES A DURABLE NAME UNIQUE PER LAUNCH. The worker has one launch per
// attempt, so the bare token separates it from any other role; a reviewer has one per criterion, so
// its segment carries the criterion too -- and because unit names forbid ':', a criterion key can
// never be confused with a segment boundary in an identity.
fn session_role_durable_segment(r: SessionRole) -> String {
  match r {
    SessionWorkerSessionRole => session_worker_role
    SessionReviewerSessionRole { criterion_key } => join([session_reviewer_role, "-", criterion_key], "")
  }
}

data session_placement_schema: String = "gunbc.session-placement/v1"

// HOW LONG A SESSION RESERVATION DECLARES IT WILL HOLD. A declaration and not a deadline: the pool's
// release law is quiescence-required, so an elapsed term frees nothing and the seat returns only by
// the release the settlement pass performs. Four hours is the longest worker the belt has run on
// srv2 with margin.
//
// IT IS A Nat OF SECONDS BECAUSE THAT IS THE POOL'S OWN DURATION CARRIER: product.capacity.pool_events
// SeatRequest.term_seconds and product.capacity.lease LeasePolicy.maximum_duration_seconds are Nat
// seconds, and gunbc.compute.host_capacity host_capacity_reserve takes the term in that form. A
// branded std.types Seconds here would be a second representation cast back to Nat at the call --
// moving the duration onto a typed carrier is a change to the capacity authority's signature, not
// to this consumer (review 74593).
//
// feature:capacity-duration-carrier -- tracked debt, not a settled shape (review 74749).
// dissolve-on: product.capacity.pool_events SeatRequest.term_seconds, product.capacity.lease
// LeasePolicy.maximum_duration_seconds and gunbc.compute.host_capacity host_capacity_reserve's
// term_seconds take a std.measure duration carrier instead of a Nat of seconds. SUFFICIENT FOR
// retyping this row (and compute_reservation_term_seconds, its compute twin) in the same change; until
// then this row stays in the carrier its only consumer accepts. The lease's two instants are already
// carried as EpochSecs (SessionPlacementRecord.granted_at / expires_at), so they are not part of it.
data session_placement_term_seconds: Nat = 14400

// THE BOUNDS A GRANT DOES NOT CARRY. product.capacity.pool grants memory only, so CPU and task
// ceilings are stated beside it rather than pretended to come from it (DESIGN 3b: a divergence with
// its reason). They are policy budgets for the dogfood capped unit (operator ruling 2026-10-03: a
// capped systemd unit plus a lease is sufficient): eight cores and 4096 tasks bound a runaway
// session without throttling the single `gunbc run` a harness worker is. Falsifiable: a worker unit
// ending in Result=resources, or a throughput regression attributed to CPUQuota, re-derives them.
data session_process_bounds: UnitProcessBounds = UnitProcessBounds { cpu_quota: millicore(count: 8000), tasks_max: 4096 }

// THE SESSION POOL'S SLOTS ARE THE BELT'S WORKER COUNT, derived rather than chosen: the belt already
// admits at most max_concurrent workers, so a pool of that many ceilings refuses only for memory the
// machine lacks, never for a count launch admission did not impose.
fn session_placement_pool() -> HostCapacityPool? {
  match checked_int_to_nat(n: roadmap_belt_default_capacity.max_concurrent) {
    Absent => none
    Present { value: slots } => Present { value: AgentSessionPool { slots: slots } }
  }
}

// ── THE BINDING: WHICH ATTEMPT, WHICH UNIT, WHICH HOLD ─────────────────────────────────────────
//
// The slot's key and the ledger's reference are the attempt's UNIT NAME, which the dispatch actuator
// derives from the node and the content-hash attempt key -- so one attempt names one hold and two
// attempts never share one. The slot's identity field carries the node and attempt it binds, so a
// record read back is checked against the attempt that is asking rather than trusted because of
// where it was found (ruling, finding 3).
fn session_attempt_identity(node_id: String, attempt_key: String) -> String {
  join([node_id, ":", attempt_key], "")
}

fn session_unit(node_id: String, attempt_key: String) -> SystemdUnitNameAdmission {
  dispatch_attempt_unit_name(node_id: node_id, attempt_key: attempt_key)
}

fn session_unit_wire(node_id: String, attempt_key: String) -> NonEmptyStr? {
  match session_unit(node_id: node_id, attempt_key: attempt_key) {
    SystemdUnitNameAdmitted { name } => Present { value: systemd_unit_name_wire(name: name) }
    SystemdUnitNameStemEmpty => none
    SystemdUnitNameDisallowedCharacter { stem: _, character: _ } => none
    SystemdUnitNameOverlong { length: _ } => none
  }
}

fn session_unit_unnameable_detail(node_id: String, attempt_key: String) -> String {
  systemd_unit_name_refusal_detail(admission: session_unit(node_id: node_id, attempt_key: attempt_key))
}

// THE BINDING CHECK, ONE FOLD FOR EVERY READER. A slot is this attempt's only if its reference, its
// unit and its identity all name the same attempt; a mismatch is FOREIGN, and a foreign slot is never
// released by anyone reading it under this attempt's name.
fn session_slot_binding_mismatch(record: AttemptRecord, node_id: String, attempt_key: String) -> String {
  match session_unit_wire(node_id: node_id, attempt_key: attempt_key) {
    Absent => session_unit_unnameable_detail(node_id: node_id, attempt_key: attempt_key)
    Present { value: expected_unit } => {
  let expected = expected_unit as String
  if record.reference != expected {
    join(["the slot's reference is ", record.reference, " and this attempt's unit is ", expected], "")
  } else if record.unit != expected {
    join(["the slot's unit is ", record.unit, " and this attempt's unit is ", expected], "")
  } else if record.identity != session_attempt_identity(node_id: node_id, attempt_key: attempt_key) {
    join(["the slot binds ", record.identity, " and this attempt is ", session_attempt_identity(node_id: node_id, attempt_key: attempt_key)], "")
  } else {
    ""
  }
    }
  }
}

// THE IDENTITY PARSED BACK, for the settlement pass, which starts from a slot and must find the
// attempt it binds. The attempt key is a hex digest and carries no ':', so the LAST ':' splits.
type SessionAttemptName {
  node_id: String
  attempt_key: String
}

fn session_attempt_name_of(identity: String) -> SessionAttemptName? {
  let parts: List<String> = identity.split(delimiter: ":")
  if count(parts) < 2 { none } else {
    let key = match first(skip(parts, count(parts) - 1)) { Absent => ""  Present { value: p } => p }
    let node = join(parts |> take(count(parts) - 1), ":")
    if key == "" || node == "" { none } else { Present { value: SessionAttemptName { node_id: node, attempt_key: key } } }
  }
}

// ── THE STORES ─────────────────────────────────────────────────────────────────────────────────
//
// WHERE A SESSION'S DURABLE FACTS LIVE, resolved once from the instance and then passed as a value,
// so the settlement pass and its witnesses run the same fold over any store (the compute recovery
// door's own row names an instance-derived root as what kept its control unwritable).
type SessionPlacementStores {
  slots_root: NonEmptyStr
  records_dir: String
  store: FabricStorageBinding
  partition: PartitionId
}

type SessionStoresResolution
  = SessionStoresResolved { stores: SessionPlacementStores }
  | SessionStoresUnresolved { detail: String }

fn session_placement_records_dir(instance: HostDashboardInstance) -> String {
  dashboard_instance_dispatch_attempt_state_root(instance: instance) as String
}

fn session_placement_slots_root(instance: HostDashboardInstance) -> NonEmptyStr {
  join([session_placement_records_dir(instance: instance), "/session-attempts"], "") as NonEmptyStr
}

fn session_placement_stores(instance: HostDashboardInstance) -> SessionStoresResolution {
  match session_placement_pool() {
    Absent => SessionStoresUnresolved { detail: join(["the belt's max_concurrent ", to_string(value: roadmap_belt_default_capacity.max_concurrent), " is not a natural number, so the session pool has no size"], "") }
    Present { value: pool } =>
      match host_capacity_subject(instance: instance, pool: pool, request: kibibyte(count: 0)) {
        ComputeSubjectHostUnresolved { host } => SessionStoresUnresolved { detail: join(["no dashboard instance is declared for host ", host as String, ", so it has no session ledger"], "") }
        ComputeSubjectResolved { subject } =>
          SessionStoresResolved { stores: SessionPlacementStores {
            slots_root: session_placement_slots_root(instance: instance),
            records_dir: session_placement_records_dir(instance: instance),
            store: compute_capacity_store(subject: subject),
            partition: subject.partition,
          } }
      }
  }
}

// ── ACQUISITION: SLOT FIRST, THEN THE LEDGER ───────────────────────────────────────────────────
type SessionPlacementGrant {
  node_id: String
  attempt_key: String
  unit: NonEmptyStr
  lease: LeaseGrant
  partition: PartitionId
  amount: Kibibyte
  class_grant: WorkClassGrant
  store: FabricStorageBinding
  slot: AttemptRecord
  slot_generation: CasGeneration
}

type SessionPlacementAcquisition
  = SessionPlacementGranted { grant: SessionPlacementGrant }
  | SessionPlacementRefused { detail: String }

// THE DECLARED WINDOW IS THE CEILING'S OWN ROW, the same as the compute provider's: what it covers is
// the worktree add, the attempt state and the unit's argv -- the steps between acquisition and
// session_placement_begin_launch.
fn session_attempt_record(node_id: String, attempt_key: String, unit: NonEmptyStr, granted: Kibibyte, now: EpochSecs) -> AttemptRecord {
  AttemptRecord {
    identity: session_attempt_identity(node_id: node_id, attempt_key: attempt_key),
    reference: unit as String,
    unit: unit as String,
    granted: granted,
    opened_at: now,
    launch_deadline: now + compute_pre_launch_ceiling_seconds,
    state: AttemptReserved,
    owner: DispatchOwned { node_id: node_id, attempt_key: attempt_key },
  }
}

fn session_placement_acquire(instance: HostDashboardInstance, stores: SessionPlacementStores, node_id: String, attempt_key: String) -> SessionPlacementAcquisition {
  match session_unit(node_id: node_id, attempt_key: attempt_key) {
    SystemdUnitNameStemEmpty =>
      SessionPlacementRefused { detail: systemd_unit_name_refusal_detail(admission: SystemdUnitNameStemEmpty) }
    SystemdUnitNameDisallowedCharacter { stem: s, character: ch } =>
      SessionPlacementRefused { detail: systemd_unit_name_refusal_detail(admission: SystemdUnitNameDisallowedCharacter { stem: s, character: ch }) }
    SystemdUnitNameOverlong { length: n } =>
      SessionPlacementRefused { detail: systemd_unit_name_refusal_detail(admission: SystemdUnitNameOverlong { length: n }) }
    SystemdUnitNameAdmitted { name } =>
  match session_placement_pool() {
    Absent => SessionPlacementRefused { detail: "the session pool has no size" }
    Present { value: pool } => {
      let class_grant = work_class_grant(class: WorkClassAgentSession, rows: work_class_grant_rows, ceiling: compute_memory_ceiling(instance: instance))
      match now_epoch_seconds() {
        Absent => SessionPlacementRefused { detail: "the host clock could not be read as epoch seconds, and the session's slot carries a launch deadline" }
        Present { value: now } => {
          let record = session_attempt_record(node_id: node_id, attempt_key: attempt_key, unit: systemd_unit_name_wire(name: name), granted: work_class_grant_amount(g: class_grant), now: now)
          match attempt_open(root: stores.slots_root, record: record) {
            AttemptLostRace { expected: e, observed: o } =>
              SessionPlacementRefused { detail: join(["a session slot already exists for ", record.unit, " (expected ", e, ", found ", o, "); one attempt holds at most one placement"], "") }
            AttemptTransitionRefused { detail: d } =>
              SessionPlacementRefused { detail: join(["the session slot could not be opened, so nothing was reserved: ", d], "") }
            AttemptAdvanced { state: _, generation: g } =>
              match host_capacity_reserve(instance: instance, pool: pool, reference: record.unit as NonEmptyStr, term_seconds: session_placement_term_seconds, request: record.granted) {
                ComputeReserved { grant: lease, partition: p, amount: a, store: s } =>
                  SessionPlacementGranted { grant: SessionPlacementGrant {
                    node_id: node_id, attempt_key: attempt_key, unit: record.unit as NonEmptyStr,
                    lease: lease, partition: p, amount: a, class_grant: class_grant, store: s, slot: record, slot_generation: g,
                  } }
                ComputeCapacityFull { wire: w } => session_refused_after_open(stores: stores, record: record, generation: g, refusal: compute_reservation_wire(r: ComputeCapacityFull { wire: w }))
                ComputeHostBelowFloor { requested: rq, available: av } => session_refused_after_open(stores: stores, record: record, generation: g, refusal: compute_reservation_wire(r: ComputeHostBelowFloor { requested: rq, available: av }))
                ComputeReservationRefused { detail: d } => session_refused_after_open(stores: stores, record: record, generation: g, refusal: compute_reservation_wire(r: ComputeReservationRefused { detail: d }))
              }
          }
        }
      }
    }
  }
  }
}

// A REFUSED RESERVATION CLOSES THE SLOT IT OPENED, and if the close itself fails the slot is left
// Reserved -- which settlement terminates after the deadline, releasing nothing because nothing was
// reserved. Both outcomes are carried in the refusal.
fn session_refused_after_open(stores: SessionPlacementStores, record: AttemptRecord, generation: CasGeneration, refusal: String) -> SessionPlacementAcquisition {
  SessionPlacementRefused {
    detail: join([
      refusal, "; session slot ",
      attempt_transition_wire(t: attempt_terminate(root: stores.slots_root, reference: record.reference as NonEmptyStr, expected: generation, verdict: AttemptRecovered, detail: join(["reservation refused: ", refusal], ""))),
    ], ""),
  }
}

// THE LAUNCH GATE: Reserved -> Launching, called immediately before the unit is started and never
// after. Losing it means settlement terminated this attempt for overrunning its declared window, and
// the unit must not start; the caller abandons what it holds.
type SessionLaunchGate
  = SessionLaunchAdmitted { grant: SessionPlacementGrant }
  | SessionLaunchRefused { detail: String }

fn session_placement_begin_launch(stores: SessionPlacementStores, grant: SessionPlacementGrant) -> SessionLaunchGate {
  match attempt_begin_launch(root: stores.slots_root, reference: grant.slot.reference as NonEmptyStr, expected: grant.slot_generation) {
    AttemptAdvanced { state: s, generation: g } =>
      SessionLaunchAdmitted { grant: SessionPlacementGrant {
        node_id: grant.node_id, attempt_key: grant.attempt_key, unit: grant.unit, lease: grant.lease, partition: grant.partition,
        amount: grant.amount, class_grant: grant.class_grant, store: grant.store,
        slot: attempt_record_with_state(r: grant.slot, state: s),
        slot_generation: g,
      } }
    AttemptLostRace { expected: e, observed: o } => SessionLaunchRefused { detail: join(["the session slot moved before launch (expected ", e, ", found ", o, "); settlement ended this attempt, so its unit is not started"], "") }
    AttemptTransitionRefused { detail: d } => SessionLaunchRefused { detail: join(["the session slot would not take the launch generation: ", d], "") }
  }
}

// A SPAWN THAT DID NOT HAPPEN RETURNS ITS SEAT ONLY THROUGH A SLOT TRANSITION THAT COMMITTED
// (side-chat ruling on #13074 at c6d50f1). The caller may hold a STALE generation: the launch gate
// advances the slot Reserved -> Launching inside the container step, so a unit-start failure arrives
// here with the pre-launch generation. So:
//   - termination from the supplied generation commits -> release;
//   - it loses -> re-read the slot, and
//       Terminal  -> settlement already closed it; an idempotent release is allowed,
//       Reserved  -> terminate at the generation read, release only if that commits,
//       Launching -> observe the unit: ENDED terminates at the generation read and releases;
//                    ACTIVE or UNREADABLE keeps the charge (the launcher failing is not authoritative
//                    unit absence -- the transient unit is retained precisely so its state can be
//                    read), and the settlement pass releases it once the unit is observed ended,
//       unreadable, absent or mis-bound slot -> keep the charge.
// compute_release_on is NEVER reached merely because an attempted close lost.
type SessionAbandonment {
  freed: ComputeRelease?
  detail: String
}

fn session_abandon_release(stores: SessionPlacementStores, grant: SessionPlacementGrant, reason: NonEmptyStr, closed: String) -> SessionAbandonment {
  let freed = compute_release_on(store: grant.store, partition: grant.partition, appropriation: kibibyte(count: 0), reference: grant.lease.reference, reason: reason)
  let write = session_placement_release_write(
    records_dir: stores.records_dir, node_id: grant.node_id, attempt_key: grant.attempt_key,
    grant_binding: Present { value: SessionGrantBinding { grant_identity: grant.lease.fence.grant as String, fence_generation: grant.lease.fence.generation } },
    reason: reason, freed: freed)
  SessionAbandonment {
    freed: Present { value: freed },
    detail: join(["session slot ", closed, "; session placement ", session_release_outcome_wire(r: freed), ": ", session_release_detail(r: freed), session_write_note(w: write)], ""),
  }
}

fn session_abandon_kept(why: String) -> SessionAbandonment {
  SessionAbandonment { freed: none, detail: join(["session placement KEPT: ", why], "") }
}

fn session_abandon_terminate_then_release(stores: SessionPlacementStores, grant: SessionPlacementGrant, record: AttemptRecord, generation: CasGeneration, reason: NonEmptyStr, why: String) -> SessionAbandonment {
  match attempt_terminate(root: stores.slots_root, reference: record.reference as NonEmptyStr, expected: generation, verdict: AttemptRecovered, detail: join([reason as String, "; ", why], "")) {
    AttemptAdvanced { state: s, generation: _ } => session_abandon_release(stores: stores, grant: grant, reason: reason, closed: join(["closed (", attempt_state_wire(s: s), ") after re-reading: ", why], ""))
    AttemptLostRace { expected: e, observed: o } => session_abandon_kept(why: join(["the slot moved again (expected ", e, ", found ", o, "); the settlement pass decides it from the store"], ""))
    AttemptTransitionRefused { detail: d } => session_abandon_kept(why: join(["the slot would not take the terminal generation: ", d], ""))
  }
}

fn session_placement_abandon_at(stores: SessionPlacementStores, grant: SessionPlacementGrant, reason: NonEmptyStr, lifecycle_of: fn(NonEmptyStr) -> UnitLifecycle) -> SessionAbandonment {
  match attempt_terminate(root: stores.slots_root, reference: grant.slot.reference as NonEmptyStr, expected: grant.slot_generation, verdict: AttemptRecovered, detail: reason as String) {
    AttemptAdvanced { state: s, generation: _ } => session_abandon_release(stores: stores, grant: grant, reason: reason, closed: join(["closed (", attempt_state_wire(s: s), ")"], ""))
    AttemptTransitionRefused { detail: d } => session_abandon_kept(why: join(["the slot would not take the terminal generation (", d, "); the settlement pass decides it from the store"], ""))
    AttemptLostRace { expected: _, observed: _ } =>
      match attempt_slot_read(root: stores.slots_root, reference: grant.unit) {
        AttemptSlotUnreadable { detail } => session_abandon_kept(why: join(["the slot close lost and the slot is now unreadable: ", detail], ""))
        AttemptSlotAbsent => session_abandon_kept(why: "the slot close lost and no slot is held under this unit")
        AttemptSlotHeld { record: rec, generation: g } => {
          let mismatch = session_slot_binding_mismatch(record: rec, node_id: grant.node_id, attempt_key: grant.attempt_key)
          if mismatch != "" {
            session_abandon_kept(why: join(["the slot re-read is not this attempt's (", mismatch, ")"], ""))
          } else {
            match rec.state {
              AttemptTerminal { verdict: _, detail: d } => session_abandon_release(stores: stores, grant: grant, reason: reason, closed: join(["already closed (", d, ")"], ""))
              AttemptReserved => session_abandon_terminate_then_release(stores: stores, grant: grant, record: rec, generation: g, reason: reason, why: "the slot is still Reserved")
              AttemptLaunching => {
                let lifecycle = lifecycle_of(grant.unit)
                match lifecycle {
                  UnitTerminatedSuccess { detail: _ } => session_abandon_terminate_then_release(stores: stores, grant: grant, record: rec, generation: g, reason: reason, why: join(["the unit is ", unit_lifecycle_wire(u: lifecycle)], ""))
                  UnitTerminatedFailure { detail: _ } => session_abandon_terminate_then_release(stores: stores, grant: grant, record: rec, generation: g, reason: reason, why: join(["the unit is ", unit_lifecycle_wire(u: lifecycle)], ""))
                  UnitTerminatedCauseUnknown { detail: _ } => session_abandon_terminate_then_release(stores: stores, grant: grant, record: rec, generation: g, reason: reason, why: join(["the unit is ", unit_lifecycle_wire(u: lifecycle)], ""))
                  UnitStillRunning { detail: _ } => session_abandon_kept(why: join(["the slot is Launching and the unit is ", unit_lifecycle_wire(u: lifecycle), "; the settlement pass releases it once the unit is observed ended"], ""))
                  UnitLifecycleUnknown { detail: _ } => session_abandon_kept(why: join(["the slot is Launching and the unit is ", unit_lifecycle_wire(u: lifecycle), "; the settlement pass releases it once the unit is observed ended"], ""))
                }
              }
            }
          }
        }
      }
  }
}

fn session_placement_abandon(stores: SessionPlacementStores, grant: SessionPlacementGrant, reason: NonEmptyStr) -> String {
  (session_placement_abandon_at(stores: stores, grant: grant, reason: reason, lifecycle_of: session_observe_unit_lifecycle)).detail
}

// ── THE DURABLE PLACEMENT RECORD ───────────────────────────────────────────────────────────────
//
// The slot is the lifecycle authority; this record is the placement's DESCRIPTION -- the lease
// identity and fence, the partition, the class grant and the unit properties actually passed to
// systemd-run -- written after the reservation and before the launch gate. It names its schema, its
// node, its attempt, its host and its unit, and the reader refuses it unless every one of them is
// the asking attempt's (ruling, finding 3).
// THE KEY AND THE ROLE ARE BOTH PARTS OF THE NAME. A reviewer's hold belongs to a CRITERION of an
// attempt while its worker's hold belongs to the attempt itself, so the two roles of one attempt
// must never share a path: the key is the caller's placement key (the worker's is its attempt key)
// and the role is the role token, both carried as given.
fn session_placement_record_basename_key(node_id: String, key: String, role: String) -> String {
  join(["session-placement-", node_id, "-", key, "-", role, ".json"], "")
}

fn session_placement_record_basename(node_id: String, attempt_key: String) -> String {
  session_placement_record_basename_key(node_id: node_id, key: join(["a", attempt_key], ""), role: session_worker_role)
}

fn session_placement_release_basename_key(node_id: String, key: String, role: String) -> String {
  join(["session-placement-", node_id, "-", key, "-", role, ".release.json"], "")
}

fn session_placement_release_basename(node_id: String, attempt_key: String) -> String {
  session_placement_release_basename_key(node_id: node_id, key: join(["a", attempt_key], ""), role: session_worker_role)
}

fn session_placement_note_basename(unit: String) -> String {
  join(["session-placement-note-", unit, ".txt"], "")
}

type SessionPlacementRecord {
  schema: String
  node_id: String
  attempt_key: String
  host: String
  unit: String
  reference: String
  grant_identity: String
  fence_generation: CasGeneration
  granted_at: EpochSecs
  expires_at: EpochSecs
  partition: String
  amount: Kibibyte
  class_grant: String
  unit_properties: List<String>
}

fn session_placement_record_of(host: String, grant: SessionPlacementGrant, unit_properties: List<String>) -> SessionPlacementRecord {
  SessionPlacementRecord {
    schema: session_placement_schema,
    node_id: grant.node_id,
    attempt_key: grant.attempt_key,
    host: host,
    unit: grant.unit as String,
    reference: grant.lease.reference as String,
    grant_identity: grant.lease.fence.grant as String,
    fence_generation: grant.lease.fence.generation,
    granted_at: grant.lease.granted_at,
    expires_at: grant.lease.expires_at,
    partition: grant.partition as String,
    amount: grant.amount,
    class_grant: work_class_grant_wire(g: grant.class_grant),
    unit_properties: unit_properties,
  }
}

fn session_placement_record_json(r: SessionPlacementRecord) -> JsonValue {
  json_object(members: [
    json_kv(key: "schema", value: json_string(s: r.schema)),
    json_kv(key: "node_id", value: json_string(s: r.node_id)),
    json_kv(key: "attempt_key", value: json_string(s: r.attempt_key)),
    json_kv(key: "host", value: json_string(s: r.host)),
    json_kv(key: "unit", value: json_string(s: r.unit)),
    json_kv(key: "reference", value: json_string(s: r.reference)),
    json_kv(key: "grant_identity", value: json_string(s: r.grant_identity)),
    json_kv(key: "fence_generation", value: json_int(n: cas_generation_count(g: r.fence_generation))),
    json_kv(key: "granted_at", value: json_int(n: r.granted_at)),
    json_kv(key: "expires_at", value: json_int(n: r.expires_at)),
    json_kv(key: "partition", value: json_string(s: r.partition)),
    json_kv(key: "amount_kib", value: json_int(n: kibibyte_count(k: r.amount))),
    json_kv(key: "class_grant", value: json_string(s: r.class_grant)),
    json_kv(key: "unit_properties", value: json_array(elements: map(r.unit_properties, p => json_string(s: p)))),
  ])
}

type SessionPlacementWrite
  = SessionPlacementWritten { path: String }
  | SessionPlacementWriteFailed { path: String, error: String }

fn session_write_note(w: SessionPlacementWrite) -> String {
  match w {
    SessionPlacementWritten { path: _ } => ""
    SessionPlacementWriteFailed { path, error } => join([" (record not written at ", path, ": ", error, ")"], "")
  }
}

fn session_placement_record_write(stores: SessionPlacementStores, host: String, grant: SessionPlacementGrant, unit_properties: List<String>) -> SessionPlacementWrite {
  let path = join([stores.records_dir, "/", session_placement_record_basename(node_id: grant.node_id, attempt_key: grant.attempt_key)], "")
  let w = Filesystem.Write(path: path, content: serialize_json(v: session_placement_record_json(r: session_placement_record_of(host: host, grant: grant, unit_properties: unit_properties))))
  if w.success { SessionPlacementWritten { path: path } } else { SessionPlacementWriteFailed { path: path, error: w.error } }
}

// ── THE RELEASE RECORD, BOUND TO THE GRANT AND FENCE IT RETURNED ───────────────────────────────
//
// A reference is reusable text; a grant identity and its fence name ONE hold. The release carries
// the hold it returned when the releaser knows it, and says it does not (the `grant` member is
// absent) when settlement released from a slot whose placement record was never written -- in which
// case the reader requires that there IS no placement record to disagree with.
type SessionGrantBinding {
  grant_identity: String
  fence_generation: CasGeneration
}

fn session_release_outcome_wire(r: ComputeRelease) -> String {
  match r {
    ComputeReleased { partition: _, reference: _, reason: _ } => "released"
    ComputeNothingToRelease { detail: _ } => "nothing-to-release"
    ComputeReleaseRefused { detail: _ } => "refused"
  }
}

fn session_release_detail(r: ComputeRelease) -> String {
  match r {
    ComputeReleased { partition: p, reference: rf, reason: rs } => join(["released ", rf as String, " on ", p as String, " (", rs as String, ")"], "")
    ComputeNothingToRelease { detail: d } => d
    ComputeReleaseRefused { detail: d } => d
  }
}

fn session_placement_release_write(records_dir: String, node_id: String, attempt_key: String, grant_binding: SessionGrantBinding?, reason: NonEmptyStr, freed: ComputeRelease) -> SessionPlacementWrite {
  let path = join([records_dir, "/", session_placement_release_basename(node_id: node_id, attempt_key: attempt_key)], "")
  match session_unit_wire(node_id: node_id, attempt_key: attempt_key) {
    Absent => SessionPlacementWriteFailed { path: path, error: session_unit_unnameable_detail(node_id: node_id, attempt_key: attempt_key) }
    Present { value: unit } => {
  let w = Filesystem.Write(path: path, content: serialize_json(v: json_object(members: concat([
    json_kv(key: "schema", value: json_string(s: session_placement_schema)),
    json_kv(key: "node_id", value: json_string(s: node_id)),
    json_kv(key: "attempt_key", value: json_string(s: attempt_key)),
    json_kv(key: "reference", value: json_string(s: unit as String)),
    json_kv(key: "outcome", value: json_string(s: session_release_outcome_wire(r: freed))),
    json_kv(key: "reason", value: json_string(s: reason as String)),
    json_kv(key: "detail", value: json_string(s: session_release_detail(r: freed))),
  ], match grant_binding {
    Absent => []
    Present { value: b } => [json_kv(key: "grant", value: json_object(members: [
      json_kv(key: "grant_identity", value: json_string(s: b.grant_identity)),
      json_kv(key: "fence_generation", value: json_int(n: cas_generation_count(g: b.fence_generation))),
    ]))]
  }))))
  if w.success { SessionPlacementWritten { path: path } } else { SessionPlacementWriteFailed { path: path, error: w.error } }
    }
  }
}

// ── READING THE FILES BACK ─────────────────────────────────────────────────────────────────────
type SessionFieldsAcc {
  record: SessionPlacementRecord?
  cause: String
}

fn session_field_cause<T>(key: String, r: JsonFieldRead<T>) -> String {
  match r {
    FieldAbsent => join([key, " is missing"], "")
    FieldMalformed { cause } => cause
    FieldRead { value: _ } => ""
  }
}

fn session_string_or(r: JsonFieldRead<String>) -> String {
  match r { FieldRead { value } => value  FieldAbsent => ""  FieldMalformed { cause: _ } => "" }
}

fn session_int_or(r: JsonFieldRead<Int>) -> Int {
  match r { FieldRead { value } => value  FieldAbsent => 0  FieldMalformed { cause: _ } => 0 }
}

// AN INSTANT ON THE WIRE IS RE-ADMITTED, NOT CAST (the same rule as gunbc.compute.attempt_lifecycle
// attempt_member_epoch): a negative number is not an epoch second.
fn session_epoch_cause(key: String, r: JsonFieldRead<Int>) -> String {
  match r {
    FieldRead { value } => if value < 0 { join([key, " is ", to_string(value: value), ", which is not an epoch second"], "") } else { "" }
    FieldAbsent => join([key, " is missing"], "")
    FieldMalformed { cause } => cause
  }
}

fn session_nat_or(r: JsonFieldRead<Nat>) -> Nat {
  match r { FieldRead { value } => value  FieldAbsent => 0  FieldMalformed { cause: _ } => 0 }
}

// EVERY FIELD IS REQUIRED. The first missing or malformed one is the refusal; the zero and empty
// fallbacks above are reached only when that cause is non-empty, so no record is ever built from
// them.
fn session_placement_record_decode(doc: JsonValue) -> SessionFieldsAcc {
  let schema = json_field_string(obj: doc, key: "schema")
  let node_id = json_field_string(obj: doc, key: "node_id")
  let attempt_key = json_field_string(obj: doc, key: "attempt_key")
  let host = json_field_string(obj: doc, key: "host")
  let unit = json_field_string(obj: doc, key: "unit")
  let reference = json_field_string(obj: doc, key: "reference")
  let grant_identity = json_field_string(obj: doc, key: "grant_identity")
  let fence_generation = json_field_nat(obj: doc, key: "fence_generation")
  let granted_at = json_field_int(obj: doc, key: "granted_at")
  let expires_at = json_field_int(obj: doc, key: "expires_at")
  let partition = json_field_string(obj: doc, key: "partition")
  let amount_kib = json_field_nat(obj: doc, key: "amount_kib")
  let class_grant = json_field_string(obj: doc, key: "class_grant")
  let unit_properties = json_field_string_list(obj: doc, key: "unit_properties")
  let causes = filter([
    session_field_cause(key: "schema", r: schema),
    session_field_cause(key: "node_id", r: node_id),
    session_field_cause(key: "attempt_key", r: attempt_key),
    session_field_cause(key: "host", r: host),
    session_field_cause(key: "unit", r: unit),
    session_field_cause(key: "reference", r: reference),
    session_field_cause(key: "grant_identity", r: grant_identity),
    session_field_cause(key: "fence_generation", r: fence_generation),
    match fence_generation {
      FieldRead { value: n } => match cas_generation(n: n as Int) { Absent => "fence_generation is not a granted fence"  Present { value: _ } => "" }
      FieldAbsent => ""
      FieldMalformed { cause: _ } => ""
    },
    session_epoch_cause(key: "granted_at", r: granted_at),
    session_epoch_cause(key: "expires_at", r: expires_at),
    session_field_cause(key: "partition", r: partition),
    session_field_cause(key: "amount_kib", r: amount_kib),
    session_field_cause(key: "class_grant", r: class_grant),
    session_field_cause(key: "unit_properties", r: unit_properties),
  ], c => c != "")
  match causes.first() {
    Present { value: c } => SessionFieldsAcc { record: none, cause: c }
    Absent =>
      SessionFieldsAcc {
        record: Present { value: SessionPlacementRecord {
          schema: session_string_or(r: schema),
          node_id: session_string_or(r: node_id),
          attempt_key: session_string_or(r: attempt_key),
          host: session_string_or(r: host),
          unit: session_string_or(r: unit),
          reference: session_string_or(r: reference),
          grant_identity: session_string_or(r: grant_identity),
          fence_generation: match fence_generation {
            FieldRead { value: n } => match cas_generation(n: n as Int) { Present { value: g } => g  Absent => cas_generation_first() }
            FieldAbsent => cas_generation_first()
            FieldMalformed { cause: _ } => cas_generation_first()
          },
          granted_at: session_int_or(r: granted_at),
          expires_at: session_int_or(r: expires_at),
          partition: session_string_or(r: partition),
          amount: kibibyte(count: session_nat_or(r: amount_kib)),
          class_grant: session_string_or(r: class_grant),
          unit_properties: match unit_properties { FieldRead { value } => value  FieldAbsent => []  FieldMalformed { cause: _ } => [] },
        } },
        cause: "",
      }
  }
}

// THE PLACEMENT RECORD'S BINDING, checked against the asking attempt.
fn session_record_binding_mismatch(r: SessionPlacementRecord, node_id: String, attempt_key: String, host: String) -> String {
  match session_unit_wire(node_id: node_id, attempt_key: attempt_key) {
    Absent => session_unit_unnameable_detail(node_id: node_id, attempt_key: attempt_key)
    Present { value: expected_unit } => {
  let expected = expected_unit as String
  if r.schema != session_placement_schema {
    join(["the placement record's schema is ", r.schema, ", not ", session_placement_schema], "")
  } else if r.node_id != node_id || r.attempt_key != attempt_key {
    join(["the placement record belongs to ", r.node_id, ":", r.attempt_key, ", not ", node_id, ":", attempt_key], "")
  } else if r.unit != expected || r.reference != expected {
    join(["the placement record names unit ", r.unit, " and reference ", r.reference, "; this attempt's unit is ", expected], "")
  } else if r.host != host {
    join(["the placement record was written on host ", r.host, ", not ", host], "")
  } else {
    ""
  }
    }
  }
}

fn session_file_observation_cause(o: FilesystemFileObservation) -> String {
  match o {
    FilesystemFileAbsent(_) => "absent"
    FilesystemFileRead { path: _, content: _ } => ""
    FilesystemFileIndeterminate { cause } => cause
    FilesystemFileObservationsDisagree { path: _, cause } => cause
    FilesystemFileSubjectRefused { directory: _, name: _, cause } => cause
  }
}

type SessionGrantReading
  = SessionGrantRecorded { record: SessionPlacementRecord }
  | SessionGrantNotRecorded { path: String }
  | SessionGrantUnreadable { path: String, detail: String }
  | SessionGrantForeign { path: String, detail: String }

fn session_grant_reading_of(path: String, obs: FilesystemFileObservation, node_id: String, attempt_key: String, host: String) -> SessionGrantReading {
  match obs {
    FilesystemFileAbsent(_) => SessionGrantNotRecorded { path: path }
    FilesystemFileRead { path: _, content } =>
      match parse_json_document(s: content) {
        JsonDocumentUnreadable { gap } => SessionGrantUnreadable { path: path, detail: json_document_gap_text(gap: gap) }
        JsonDocumentParsed { value: doc } => {
          let decoded = session_placement_record_decode(doc: doc)
          match decoded.record {
            Absent => SessionGrantUnreadable { path: path, detail: decoded.cause }
            Present { value: r } => {
              let mismatch = session_record_binding_mismatch(r: r, node_id: node_id, attempt_key: attempt_key, host: host)
              if mismatch == "" { SessionGrantRecorded { record: r } } else { SessionGrantForeign { path: path, detail: mismatch } }
            }
          }
        }
      }
    FilesystemFileIndeterminate { cause: _ } => SessionGrantUnreadable { path: path, detail: session_file_observation_cause(o: obs) }
    FilesystemFileObservationsDisagree { path: _, cause: _ } => SessionGrantUnreadable { path: path, detail: session_file_observation_cause(o: obs) }
    FilesystemFileSubjectRefused { directory: _, name: _, cause: _ } => SessionGrantUnreadable { path: path, detail: session_file_observation_cause(o: obs) }
  }
}

type SessionReleaseObservation
  = SessionReleaseNotRecorded { path: String }
  | SessionReleased { reason: String, detail: String }
  | SessionReleaseNothingHeld { reason: String, detail: String }
  | SessionReleaseRefused { reason: String, detail: String }
  | SessionReleaseUnreadable { path: String, detail: String }

fn session_release_grant_mismatch(doc: JsonValue, grant: SessionGrantReading) -> String {
  match json_field(obj: doc, key: "grant") {
    FieldMalformed { cause } => cause
    FieldAbsent =>
      match grant {
        SessionGrantRecorded { record } => join(["the release names no grant, and this attempt's placement holds grant ", record.grant_identity], "")
        SessionGrantNotRecorded { path: _ } => ""
        SessionGrantUnreadable { path: _, detail: _ } => ""
        SessionGrantForeign { path: _, detail: d } => d
      }
    FieldRead { value: g } => {
      let identity = session_string_or(r: json_field_string(obj: g, key: "grant_identity"))
      match grant {
        SessionGrantRecorded { record } =>
          match json_field_nat(obj: g, key: "fence_generation") {
            FieldRead { value: f } =>
              if identity != record.grant_identity || (f as Int) != cas_generation_count(g: record.fence_generation) {
                join(["the release returned grant ", identity, " at fence ", to_string(value: f), ", and this attempt's placement holds ", record.grant_identity, " at fence ", to_string(value: cas_generation_count(g: record.fence_generation))], "")
              } else { "" }
            FieldAbsent => "the release's grant carries no fence generation"
            FieldMalformed { cause } => cause
          }
        SessionGrantNotRecorded { path: _ } => ""
        SessionGrantUnreadable { path: _, detail: _ } => ""
        SessionGrantForeign { path: _, detail: d } => d
      }
    }
  }
}

fn session_release_observation_of(path: String, obs: FilesystemFileObservation, node_id: String, attempt_key: String, grant: SessionGrantReading) -> SessionReleaseObservation {
  match obs {
    FilesystemFileAbsent(_) => SessionReleaseNotRecorded { path: path }
    FilesystemFileRead { path: _, content } =>
      match parse_json_document(s: content) {
        JsonDocumentUnreadable { gap } => SessionReleaseUnreadable { path: path, detail: json_document_gap_text(gap: gap) }
        JsonDocumentParsed { value: doc } => {
          let nd = json_field_string(obj: doc, key: "node_id")
          let ak = json_field_string(obj: doc, key: "attempt_key")
          let rf = json_field_string(obj: doc, key: "reference")
          let outcome = json_field_string(obj: doc, key: "outcome")
          let reason = json_field_string(obj: doc, key: "reason")
          let detail = json_field_string(obj: doc, key: "detail")
          let causes = filter([
            session_field_cause(key: "node_id", r: nd), session_field_cause(key: "attempt_key", r: ak),
            session_field_cause(key: "reference", r: rf), session_field_cause(key: "outcome", r: outcome),
            session_field_cause(key: "reason", r: reason), session_field_cause(key: "detail", r: detail),
          ], c => c != "")
          match causes.first() {
            Present { value: c } => SessionReleaseUnreadable { path: path, detail: c }
            Absent => {
              let admitted_unit = session_unit_wire(node_id: node_id, attempt_key: attempt_key)
              let mismatch = if session_string_or(r: nd) != node_id || session_string_or(r: ak) != attempt_key {
                join(["the release belongs to ", session_string_or(r: nd), ":", session_string_or(r: ak), ", not ", node_id, ":", attempt_key], "")
              } else {
                match admitted_unit {
                  Absent => session_unit_unnameable_detail(node_id: node_id, attempt_key: attempt_key)
                  Present { value: unit } =>
                    if session_string_or(r: rf) != (unit as String) {
                      join(["the release names reference ", session_string_or(r: rf), ", not this attempt's unit"], "")
                    } else {
                      session_release_grant_mismatch(doc: doc, grant: grant)
                    }
                }
              }
              if mismatch != "" {
                SessionReleaseUnreadable { path: path, detail: mismatch }
              } else if session_string_or(r: outcome) == "released" {
                SessionReleased { reason: session_string_or(r: reason), detail: session_string_or(r: detail) }
              } else if session_string_or(r: outcome) == "nothing-to-release" {
                SessionReleaseNothingHeld { reason: session_string_or(r: reason), detail: session_string_or(r: detail) }
              } else if session_string_or(r: outcome) == "refused" {
                SessionReleaseRefused { reason: session_string_or(r: reason), detail: session_string_or(r: detail) }
              } else {
                SessionReleaseUnreadable { path: path, detail: join(["release outcome is not in the closed vocabulary: ", session_string_or(r: outcome)], "") }
              }
            }
          }
        }
      }
    FilesystemFileIndeterminate { cause: _ } => SessionReleaseUnreadable { path: path, detail: session_file_observation_cause(o: obs) }
    FilesystemFileObservationsDisagree { path: _, cause: _ } => SessionReleaseUnreadable { path: path, detail: session_file_observation_cause(o: obs) }
    FilesystemFileSubjectRefused { directory: _, name: _, cause: _ } => SessionReleaseUnreadable { path: path, detail: session_file_observation_cause(o: obs) }
  }
}

fn session_release_settled(r: SessionReleaseObservation) -> Bool {
  match r {
    SessionReleased { reason: _, detail: _ } => true
    SessionReleaseNothingHeld { reason: _, detail: _ } => true
    SessionReleaseNotRecorded { path: _ } => false
    SessionReleaseRefused { reason: _, detail: _ } => false
    SessionReleaseUnreadable { path: _, detail: _ } => false
  }
}

// ── THE READER THE DOGFOOD RECEIPT FOLD CALLS ──────────────────────────────────────────────────
//
// CLOSED, AND NO ARM IS A DEFAULT. It takes the asking attempt's node and key and derives the unit,
// so it reads THIS attempt's slot by key and checks every file it reads against the attempt it is
// asking about: a slot, record or release belonging to another attempt reads FOREIGN, never Observed.
type SessionPlacementObservation
  = SessionPlacementObserved { slot: AttemptRecord, grant: SessionGrantReading, returned: SessionReleaseObservation }
  | SessionPlacementAbsent { unit: String }
  | SessionPlacementUnreadable { unit: String, detail: String }
  | SessionPlacementForeign { unit: String, detail: String }
  | SessionPlacementUnnameable { detail: String }

// THE PURE FOLD over what the caller read, so witnesses supply planted readings and the reader below
// supplies real ones.
fn session_placement_observation_of(
  node_id: String, attempt_key: String, host: String,
  slot: AttemptSlotReading,
  record_path: String, record: FilesystemFileObservation,
  release_path: String, released: FilesystemFileObservation,
) -> SessionPlacementObservation {
  match session_unit_wire(node_id: node_id, attempt_key: attempt_key) {
    Absent => SessionPlacementUnnameable {
      detail: session_unit_unnameable_detail(node_id: node_id, attempt_key: attempt_key),
    }
    Present { value: named } => {
  let unit = named as String
  match slot {
    AttemptSlotAbsent => SessionPlacementAbsent { unit: unit }
    AttemptSlotUnreadable { detail } => SessionPlacementUnreadable { unit: unit, detail: detail }
    AttemptSlotHeld { record: rec, generation: _ } => {
      let mismatch = session_slot_binding_mismatch(record: rec, node_id: node_id, attempt_key: attempt_key)
      if mismatch != "" {
        SessionPlacementForeign { unit: unit, detail: mismatch }
      } else {
        let grant = session_grant_reading_of(path: record_path, obs: record, node_id: node_id, attempt_key: attempt_key, host: host)
        match grant {
          SessionGrantForeign { path: _, detail } => SessionPlacementForeign { unit: unit, detail: detail }
          SessionGrantRecorded { record: _ } => SessionPlacementObserved { slot: rec, grant: grant, returned: session_release_observation_of(path: release_path, obs: released, node_id: node_id, attempt_key: attempt_key, grant: grant) }
          SessionGrantNotRecorded { path: _ } => SessionPlacementObserved { slot: rec, grant: grant, returned: session_release_observation_of(path: release_path, obs: released, node_id: node_id, attempt_key: attempt_key, grant: grant) }
          SessionGrantUnreadable { path: _, detail: _ } => SessionPlacementObserved { slot: rec, grant: grant, returned: session_release_observation_of(path: release_path, obs: released, node_id: node_id, attempt_key: attempt_key, grant: grant) }
        }
      }
    }
  }
    }
  }
}

fn session_placement_file(dir: String, name: String) -> FilesystemFileObservation {
  let path = join([dir, "/", name], "")
  let listing = Filesystem.List(path: dir)
  let read = Filesystem.Read(path: path)
  filesystem_file_observation(
    listing: filesystem_listing_observation(directory: dir, success: listing.success, entries: listing.entries, error: listing.error),
    name: name,
    path: path,
    read: filesystem_read_outcome(content: read.content, success: read.success, error: read.error),
  )
}

fn session_placement_observe_at(stores: SessionPlacementStores, host: String, node_id: String, attempt_key: String) -> SessionPlacementObservation {
  match session_unit_wire(node_id: node_id, attempt_key: attempt_key) {
    Absent => SessionPlacementUnnameable {
      detail: session_unit_unnameable_detail(node_id: node_id, attempt_key: attempt_key),
    }
    Present { value: unit } => {
  let record_name = session_placement_record_basename(node_id: node_id, attempt_key: attempt_key)
  let release_name = session_placement_release_basename(node_id: node_id, attempt_key: attempt_key)
  session_placement_observation_of(
    node_id: node_id, attempt_key: attempt_key, host: host,
    slot: attempt_slot_read(root: stores.slots_root, reference: unit),
    record_path: join([stores.records_dir, "/", record_name], ""), record: session_placement_file(dir: stores.records_dir, name: record_name),
    release_path: join([stores.records_dir, "/", release_name], ""), released: session_placement_file(dir: stores.records_dir, name: release_name),
  )
    }
  }
}

// THE STAGE READER: the worker session's slot (its lifecycle), its grant (identity, fence, unit
// properties applied) and its release, for THIS node's THIS attempt.
fn session_placement_observe_for_attempt(instance: HostDashboardInstance, node_id: String, attempt_key: String) -> SessionPlacementObservation {
  match session_unit_wire(node_id: node_id, attempt_key: attempt_key) {
    Absent => SessionPlacementUnnameable {
      detail: session_unit_unnameable_detail(node_id: node_id, attempt_key: attempt_key),
    }
    Present { value: unit } =>
  match session_placement_stores(instance: instance) {
    SessionStoresUnresolved { detail } => SessionPlacementUnreadable { unit: unit as String, detail: detail }
    SessionStoresResolved { stores } => session_placement_observe_at(stores: stores, host: instance.host_identity as String, node_id: node_id, attempt_key: attempt_key)
  }
  }
}

// ── SETTLEMENT: THE INDEPENDENT PASS ───────────────────────────────────────────────────────────
//
// THE UNIT'S LIFECYCLE IN THE AUTHORITY'S FIVE ARMS, from the worker's own observation (the read the
// belt already makes for liveness). A unit the manager does not have is ended with cause unknown --
// the one arm safe to free on without a verdict; an exited unit is ended with its status; an
// unreadable manager is UNKNOWN and frees nothing.
fn session_unit_lifecycle(o: AttemptUnitObservation) -> UnitLifecycle {
  match o {
    AttemptUnitAbsent => UnitTerminatedCauseUnknown { detail: "the user manager has no such unit" }
    AttemptUnitActive => UnitStillRunning { detail: "the unit is active" }
    AttemptUnitFinished { exit_status } =>
      if exit_status == "0" { UnitTerminatedSuccess { detail: "ExecMainStatus=0" } } else { UnitTerminatedFailure { detail: join(["ExecMainStatus=", exit_status], "") } }
    AttemptUnitUnreadable { reason } => UnitLifecycleUnknown { detail: reason }
  }
}

fn session_observe_unit_lifecycle(unit: NonEmptyStr) -> UnitLifecycle {
  session_unit_lifecycle(o: attempt_unit_observation(unit: unit))
}

// THE SETTLEMENT'S READ OF A WORKER UNIT, now that the unit is collected when its process ends
// (gunbc.roadmap.roadmap_dispatch_actuator dispatch_worker_unit_properties). A loaded unit is read as before;
// a collected one is read from its exit record, so a worker that exited 0 settles as SUCCESS rather
// than as cause-unknown. A collected unit with NO record keeps the arm it had: the manager has no such
// unit, its lifetime is over, the cause is unknown -- the one arm safe to free on without a verdict,
// and still only after the launch deadline (session_settle_decide). The settlement asks whether the
// unit's lifetime is over, not whether a worker ran, so it needs no start receipt: the slot it is
// settling IS one.
fn session_worker_unit_lifecycle(unit: NonEmptyStr, loaded: AttemptUnitObservation, record: AttemptExitRecordObservation) -> UnitLifecycle {
  match loaded {
    AttemptUnitAbsent =>
      match record {
        AttemptExitRecordNone => UnitTerminatedCauseUnknown { detail: "the user manager has no such unit and it left no exit record" }
        AttemptExitRecordFound { record: _ } => session_unit_lifecycle(o: attempt_unit_from_exit_record(unit: unit, record: record, start: AttemptUnitStartRecorded))
        AttemptExitRecordUnreadable { reason } => UnitLifecycleUnknown { detail: reason }
      }
    AttemptUnitActive => session_unit_lifecycle(o: loaded)
    AttemptUnitFinished { exit_status: _ } => session_unit_lifecycle(o: loaded)
    AttemptUnitUnreadable { reason: _ } => session_unit_lifecycle(o: loaded)
  }
}

fn session_worker_unit_lifecycle_for_instance(instance: HostDashboardInstance, unit: NonEmptyStr) -> UnitLifecycle {
  let loaded = attempt_unit_observation(unit: unit)
  match loaded {
    AttemptUnitAbsent =>
      session_worker_unit_lifecycle(
        unit: unit,
        loaded: loaded,
        record: attempt_exit_worker_record_matching(
          subject: (n, a) => match dispatch_attempt_unit_name(node_id: n, attempt_key: a) {
            SystemdUnitNameAdmitted { name } => (systemd_unit_name_wire(name: name) as String) == (unit as String)
            SystemdUnitNameStemEmpty => false
            SystemdUnitNameDisallowedCharacter { stem: _, character: _ } => false
            SystemdUnitNameOverlong { length: _ } => false
          },
          listings: attempt_exit_stage_listings(instance_root: instance.instance_root as String),
        ),
      )
    AttemptUnitActive => session_unit_lifecycle(o: loaded)
    AttemptUnitFinished { exit_status: _ } => session_unit_lifecycle(o: loaded)
    AttemptUnitUnreadable { reason: _ } => session_unit_lifecycle(o: loaded)
  }
}

// THE START RECEIPT THE PROCESS OBSERVER NEEDS (gunbc.roadmap.roadmap_dispatch_actuator
// AttemptUnitStartStanding): this attempt's placement record. It is written immediately before the
// worker unit is started, so its presence means dispatch committed to a unit; its absence means the
// attempt never had one.
fn session_worker_start_standing(observation: SessionPlacementObservation) -> AttemptUnitStartStanding {
  match observation {
    SessionPlacementObserved { slot: _, grant: _, returned: _ } => AttemptUnitStartRecorded
    SessionPlacementAbsent { unit: _ } => AttemptUnitNeverStarted
    SessionPlacementUnreadable { unit: _, detail } => AttemptUnitStartUnread { reason: detail }
    SessionPlacementForeign { unit: _, detail } => AttemptUnitStartUnread { reason: detail }
    SessionPlacementUnnameable { detail } => AttemptUnitStartUnread { reason: detail }
  }
}

// THE WORKER'S PROCESS OBSERVATION FOR ONE ATTEMPT: the unit, else its exit record, else -- only when
// both are silent -- whether it was ever started. Each later read is taken only when the earlier one
// could not answer, so a running worker costs one manager read as before.
fn attempt_worker_unit_observe_for_instance(instance: HostDashboardInstance, node_id: String, attempt_key: String) -> AttemptUnitObservation {
  match dispatch_attempt_unit_name(node_id: node_id, attempt_key: attempt_key) {
    SystemdUnitNameStemEmpty =>
      AttemptUnitUnreadable { reason: systemd_unit_name_refusal_detail(admission: SystemdUnitNameStemEmpty) }
    SystemdUnitNameDisallowedCharacter { stem: s, character: ch } =>
      AttemptUnitUnreadable { reason: systemd_unit_name_refusal_detail(admission: SystemdUnitNameDisallowedCharacter { stem: s, character: ch }) }
    SystemdUnitNameOverlong { length: n } =>
      AttemptUnitUnreadable { reason: systemd_unit_name_refusal_detail(admission: SystemdUnitNameOverlong { length: n }) }
    SystemdUnitNameAdmitted { name } => {
  let unit = systemd_unit_name_wire(name: name)
  let loaded = attempt_unit_observation(unit: unit)
  match loaded {
    AttemptUnitAbsent => {
      let record = attempt_exit_worker_record_matching(subject: (n, a) => n == node_id && a == attempt_key, listings: attempt_exit_stage_listings(instance_root: instance.instance_root as String))
      match record {
        AttemptExitRecordNone =>
          attempt_worker_unit_observation_of(unit: unit, loaded: loaded, record: record, start: session_worker_start_standing(observation: session_placement_observe_for_attempt(instance: instance, node_id: node_id, attempt_key: attempt_key)))
        AttemptExitRecordFound { record: _ } => attempt_worker_unit_observation_of(unit: unit, loaded: loaded, record: record, start: AttemptUnitStartRecorded)
        AttemptExitRecordUnreadable { reason: _ } => attempt_worker_unit_observation_of(unit: unit, loaded: loaded, record: record, start: AttemptUnitStartRecorded)
      }
    }
    AttemptUnitActive => loaded
    AttemptUnitFinished { exit_status: _ } => loaded
    AttemptUnitUnreadable { reason: _ } => loaded
  }
    }
  }
}

// THE DECISION, PURE OVER ONE SLOT. Every arm that does not release says why, and every arm that
// releases names the generation it will close.
type SessionSettleDecision
  = SettleTerminateAndRelease { record: AttemptRecord, generation: CasGeneration, attempt: SessionAttemptName, reason: String }
  | SettleReleaseOnly { record: AttemptRecord, attempt: SessionAttemptName, reason: String }
  | SettleKeep { why: String, explain: Bool }
  | SettleDone { why: String }

fn session_settle_decide(key: NonEmptyStr, slot: AttemptSlotReading, lifecycle: UnitLifecycle, now: EpochSecs, release_settled: Bool) -> SessionSettleDecision {
  match slot {
    AttemptSlotAbsent => SettleDone { why: join(["no slot is held for ", key as String], "") }
    AttemptSlotUnreadable { detail } => SettleKeep { why: join(["the session slot for ", key as String, " is unreadable, and an unreadable slot is not an absent one, so its seat is kept: ", detail], ""), explain: true }
    AttemptSlotHeld { record: rec, generation: g } =>
      match session_attempt_name_of(identity: rec.identity) {
        Absent => SettleKeep { why: join(["the session slot ", key as String, " binds identity ", rec.identity, ", which names no node and attempt, so its seat is kept"], ""), explain: true }
        Present { value: name } => {
          let mismatch = if (key as String) != rec.reference { join(["the slot keyed ", key as String, " names reference ", rec.reference], "") } else { session_slot_binding_mismatch(record: rec, node_id: name.node_id, attempt_key: name.attempt_key) }
          if mismatch != "" {
            SettleKeep { why: join(["the session slot ", key as String, " is not bound consistently (", mismatch, "), so it is never released under this name"], ""), explain: true }
          } else {
            match rec.state {
              AttemptTerminal { verdict: _, detail: d } =>
                if release_settled { SettleDone { why: "closed and released" } } else { SettleReleaseOnly { record: rec, attempt: name, reason: join(["the slot is closed (", d, ") and no settled release is recorded"], "") } }
              AttemptReserved => session_settle_by_trigger(record: rec, generation: g, attempt: name, trigger: recovery_trigger(record: rec, lifecycle: lifecycle, now: now))
              AttemptLaunching => session_settle_by_trigger(record: rec, generation: g, attempt: name, trigger: recovery_trigger(record: rec, lifecycle: lifecycle, now: now))
            }
          }
        }
      }
  }
}

fn session_settle_by_trigger(record: AttemptRecord, generation: CasGeneration, attempt: SessionAttemptName, trigger: RecoveryTrigger) -> SessionSettleDecision {
  match trigger {
    RecoveryMayTerminate { reason } => SettleTerminateAndRelease { record: record, generation: generation, attempt: attempt, reason: reason }
    RecoveryTooEarly { deadline: d, now: n } => SettleKeep { why: recovery_trigger_wire(t: RecoveryTooEarly { deadline: d, now: n }), explain: false }
    RecoveryUnitNotEnded { lifecycle: u } => SettleKeep { why: recovery_trigger_wire(t: RecoveryUnitNotEnded { lifecycle: u }), explain: false }
    RecoveryTerminalRecordMayRelease { state: s } => SettleDone { why: recovery_trigger_wire(t: RecoveryTerminalRecordMayRelease { state: s }) }
  }
}

type SessionSettlement
  = SessionSettlementReleaseAttempted { unit: String, freed: ComputeRelease, detail: String }
  | SessionSettlementKept { unit: String, why: String }
  | SessionSettlementDone { unit: String, why: String }
  | SessionSettlementRefused { unit: String, detail: String }

type SessionSettlePass
  = SessionSettlePassRan { settlements: List<SessionSettlement> }
  | SessionSettlePassRefused { detail: String }

fn session_settlement_wire(s: SessionSettlement) -> String {
  match s {
    SessionSettlementReleaseAttempted { unit, freed, detail } => join([unit, ": ", session_release_outcome_wire(r: freed), " (", detail, ")"], "")
    SessionSettlementKept { unit, why } => join([unit, ": kept (", why, ")"], "")
    SessionSettlementDone { unit, why } => join([unit, ": done (", why, ")"], "")
    SessionSettlementRefused { unit, detail } => join([unit, ": REFUSED (", detail, ")"], "")
  }
}

fn session_settle_pass_wire(p: SessionSettlePass) -> String {
  match p {
    SessionSettlePassRan { settlements } => join(map(settlements, s => session_settlement_wire(s: s)), "; ")
    SessionSettlePassRefused { detail } => join(["session settlement refused: ", detail], "")
  }
}

// THE KEPT-BUT-UNRESOLVABLE CASES LEAVE A DURABLE EXPLANATION. A slot that cannot be read, or that is
// bound inconsistently, keeps its seat -- the safe direction -- and an operator learns why from a note
// beside the records, rewritten each pass, instead of from an unexplained shortfall in the pool.
fn session_settle_note(stores: SessionPlacementStores, unit: String, why: String) -> String {
  let path = join([stores.records_dir, "/", session_placement_note_basename(unit: unit)], "")
  let w = Filesystem.Write(path: path, content: why)
  if w.success { why } else { join([why, " (note not written at ", path, ": ", w.error, ")"], "") }
}

fn session_release_settled_for_slot(stores: SessionPlacementStores, host: String, slot: AttemptSlotReading) -> Bool {
  match slot {
    AttemptSlotHeld { record: rec, generation: _ } =>
      match session_attempt_name_of(identity: rec.identity) {
        Absent => false
        Present { value: n } =>
          match session_placement_observe_at(stores: stores, host: host, node_id: n.node_id, attempt_key: n.attempt_key) {
            SessionPlacementObserved { slot: _, grant: _, returned } => session_release_settled(r: returned)
            SessionPlacementAbsent { unit: _ } => false
            SessionPlacementUnreadable { unit: _, detail: _ } => false
            SessionPlacementForeign { unit: _, detail: _ } => false
            SessionPlacementUnnameable { detail: _ } => false
          }
      }
    AttemptSlotAbsent => false
    AttemptSlotUnreadable { detail: _ } => false
  }
}

// WHO OWNS A HELD SLOT, asked as a declared sum rather than a Bool. The role is not a second field
// on the record (the identity already names it, and a parallel role field could drift from the name
// it is supposed to copy -- two sources of one fact); it is RECOVERED from the identity, and every
// outcome of that recovery is an arm here, including the ones a Bool would flatten into "not a
// reviewer": an unreadable slot, and a slot whose identity names neither role. Neither pass may act
// on a guess, so the worker pass releases only the Worker arm, the reviewer pass only the Reviewer
// arm (via session_reviewer_name_of), and Unrecognized is KEPT by both -- a hold of unknown
// ownership is left standing for a human, not guessed away.
type SessionSlotOwnership
  = SlotOwnershipReviewer { name: SessionReviewerName }
  | SlotOwnershipWorker { attempt: SessionAttemptName }
  | SlotOwnershipUnreadable { detail: String }
  | SlotOwnershipAbsent
  | SlotOwnershipUnrecognized { identity: String }

fn session_slot_ownership(slot: AttemptSlotReading) -> SessionSlotOwnership {
  match slot {
    AttemptSlotAbsent => SlotOwnershipAbsent
    AttemptSlotUnreadable { detail } => SlotOwnershipUnreadable { detail: detail }
    AttemptSlotHeld { record: rec, generation: _ } =>
      match session_reviewer_name_of(identity: rec.identity) {
        Present { value: name } => SlotOwnershipReviewer { name: name }
        Absent =>
          match session_attempt_name_of(identity: rec.identity) {
            Present { value: attempt } => SlotOwnershipWorker { attempt: attempt }
            Absent => SlotOwnershipUnrecognized { identity: rec.identity }
          }
      }
  }
}

fn session_settle_one(stores: SessionPlacementStores, host: String, key: NonEmptyStr, lifecycle: UnitLifecycle, now: EpochSecs) -> SessionSettlement {
  let slot = attempt_slot_read(root: stores.slots_root, reference: key)
  // A SLOT IS SETTLED ONLY BY THE PASS THAT OWNS IT. Ownership is a declared sum recovered from the
  // identity (see session_slot_ownership): the worker pass acts on the Worker arm and on the two
  // no-hold arms, refuses the Reviewer arm -- a reviewer's hold is released only by the reviewer
  // binder, under the reviewer's role-named record -- and KEEPS the Unrecognized arm: an identity
  // that names neither role is not this pass's to reinterpret, and its seat stays held.
  match session_slot_ownership(slot: slot) {
    SlotOwnershipReviewer { name: _ } =>
      SessionSettlementKept { unit: key as String, why: "the reviewer settlement pass owns this slot: its identity names a criterion, and the roles of an attempt release independently" }
    SlotOwnershipUnrecognized { identity } =>
      SessionSettlementKept { unit: key as String, why: join(["no pass owns this slot: its identity names neither a worker attempt nor a review criterion, so its hold is kept for a human to read: ", identity], "") }
    SlotOwnershipAbsent => session_settle_observed(stores: stores, host: host, key: key, slot: slot, lifecycle: lifecycle, now: now)
    SlotOwnershipUnreadable { detail: _ } => session_settle_observed(stores: stores, host: host, key: key, slot: slot, lifecycle: lifecycle, now: now)
    SlotOwnershipWorker { attempt: _ } => session_settle_observed(stores: stores, host: host, key: key, slot: slot, lifecycle: lifecycle, now: now)
  }
}

// THE WORKER PASS'S OWN FOLD, reached only for the arms it owns. Unreadable and absent slots are
// decided by session_settle_decide itself (an unreadable slot is kept, an absent one is done) --
// routed here explicitly so the arm is visible rather than smuggled through a false Bool.
fn session_settle_observed(stores: SessionPlacementStores, host: String, key: NonEmptyStr, slot: AttemptSlotReading, lifecycle: UnitLifecycle, now: EpochSecs) -> SessionSettlement {
  match session_settle_decide(key: key, slot: slot, lifecycle: lifecycle, now: now, release_settled: session_release_settled_for_slot(stores: stores, host: host, slot: slot)) {
    SettleDone { why } => SessionSettlementDone { unit: key as String, why: why }
    SettleKeep { why, explain } =>
      SessionSettlementKept { unit: key as String, why: if explain { session_settle_note(stores: stores, unit: key as String, why: why) } else { why } }
    SettleReleaseOnly { record: _, attempt, reason } =>
      session_settle_release(stores: stores, host: host, unit: key, attempt: attempt, reason: reason)
    SettleTerminateAndRelease { record, generation, attempt, reason } =>
      match attempt_terminate(root: stores.slots_root, reference: record.reference as NonEmptyStr, expected: generation, verdict: AttemptRecovered, detail: join([reason, "; unit ", unit_lifecycle_wire(u: lifecycle)], "")) {
        AttemptLostRace { expected: e, observed: o } =>
          SessionSettlementRefused { unit: key as String, detail: join(["the slot moved while settlement was deciding (expected ", e, ", found ", o, "); the observation is stale, so nothing is released"], "") }
        AttemptTransitionRefused { detail: d } => SessionSettlementRefused { unit: key as String, detail: join(["the slot would not take the terminal generation: ", d], "") }
        AttemptAdvanced { state: _, generation: _ } => session_settle_release(stores: stores, host: host, unit: key, attempt: attempt, reason: reason)
      }
  }
}

// THE RELEASE SETTLEMENT PERFORMS, bound to the grant the placement record names when there is one.
// A slot whose placement record was never written releases by its reference with no grant binding;
// the ledger answers NothingToRelease if the reservation never landed.
fn session_settle_release(stores: SessionPlacementStores, host: String, unit: NonEmptyStr, attempt: SessionAttemptName, reason: String) -> SessionSettlement {
  let binding = match session_placement_observe_at(stores: stores, host: host, node_id: attempt.node_id, attempt_key: attempt.attempt_key) {
    SessionPlacementObserved { slot: _, grant, returned: _ } =>
      match grant {
        SessionGrantRecorded { record } => Present { value: SessionGrantBinding { grant_identity: record.grant_identity, fence_generation: record.fence_generation } }
        SessionGrantNotRecorded { path: _ } => none
        SessionGrantUnreadable { path: _, detail: _ } => none
        SessionGrantForeign { path: _, detail: _ } => none
      }
    SessionPlacementAbsent { unit: _ } => none
    SessionPlacementUnreadable { unit: _, detail: _ } => none
    SessionPlacementForeign { unit: _, detail: _ } => none
    SessionPlacementUnnameable { detail: _ } => none
  }
  let why = join(["settled: ", reason], "") as NonEmptyStr
  let freed = compute_release_on(store: stores.store, partition: stores.partition, appropriation: kibibyte(count: 0), reference: unit, reason: why)
  let write = session_placement_release_write(records_dir: stores.records_dir, node_id: attempt.node_id, attempt_key: attempt.attempt_key, grant_binding: binding, reason: why, freed: freed)
  SessionSettlementReleaseAttempted { unit: unit as String, freed: freed, detail: join([reason, session_write_note(w: write)], "") }
}

// THE SLOT RECORDS A CLIENT FOLLOWS AFTER A 202. A dispatch whose attempt-unit start request was
// enqueued but not yet answered (SpawnLaunchPending) leaves its placement slot "launching"; the
// served /attempts.json carries every slot through attempt_record_json (the one serializer), each
// naming its owner_node and state, so the client reads that node's slot until it is no longer
// launching. A slot that cannot be read is carried as its own refusal, never dropped.
type SessionSlotRecords
  = SessionSlotRecordsRead { records: List<AttemptRecord>, unreadable: List<String> }
  | SessionSlotRecordsRefused { detail: String }

// ONE READ PER SLOT: each key is read once into this classification, then records and unreadable are
// projections of the same reads, so a slot that changes state mid-serve cannot appear in both lists or
// neither, and the lists are built by flat_map rather than a copied accumulator.
type SessionSlotObserved
  = SessionSlotObservedHeld { record: AttemptRecord }
  | SessionSlotObservedUnreadable { line: String }
  | SessionSlotObservedAbsent

fn session_placement_slot_records(stores: SessionPlacementStores) -> SessionSlotRecords {
  match cas_slot_keys(root: stores.slots_root) {
    CasSlotKeysListed { keys } => {
      let observed = map(keys, k => match attempt_slot_read(root: stores.slots_root, reference: k) {
        AttemptSlotHeld { record: r, generation: _ } => SessionSlotObservedHeld { record: r }
        AttemptSlotAbsent => SessionSlotObservedAbsent
        AttemptSlotUnreadable { detail: d } => SessionSlotObservedUnreadable { line: join([k as String, ": ", d], "") }
      })
      SessionSlotRecordsRead {
        records: flat_map(observed, o => match o {
          SessionSlotObservedHeld { record: r } => [r]
          SessionSlotObservedUnreadable { line: _ } => []
          SessionSlotObservedAbsent => []
        }),
        unreadable: flat_map(observed, o => match o {
          SessionSlotObservedUnreadable { line: l } => [l]
          SessionSlotObservedHeld { record: _ } => []
          SessionSlotObservedAbsent => []
        }),
      }
    }
    CasSlotKeysListingRefused { root: r, detail: d } => SessionSlotRecordsRefused { detail: join(["the session slot store at ", r as String, " could not be listed: ", d], "") }
    CasSlotKeysSubjectRefused { root: r, cause: c } => SessionSlotRecordsRefused { detail: join(["the session slot store path ", r as String, " is not admissible: ", c], "") }
  }
}

// THE PASS TAKES THE UNIT OBSERVATIONS AS A FUNCTION OF THE UNIT NAME so a witness can plant them;
// production passes session_worker_unit_lifecycle_for_instance, the worker's own read (unit, then its
// exit record).
fn session_placement_settle_pass_at(stores: SessionPlacementStores, host: String, lifecycle_of: fn(NonEmptyStr) -> UnitLifecycle, now: EpochSecs) -> SessionSettlePass {
  match cas_slot_keys(root: stores.slots_root) {
    CasSlotKeysListed { keys } => SessionSettlePassRan { settlements: map(keys, k => session_settle_one(stores: stores, host: host, key: k, lifecycle: lifecycle_of(k), now: now)) }
    CasSlotKeysListingRefused { root: r, detail: d } => SessionSettlePassRefused { detail: join(["the session slot store at ", r as String, " could not be listed: ", d], "") }
    CasSlotKeysSubjectRefused { root: r, cause: c } => SessionSettlePassRefused { detail: join(["the session slot store path ", r as String, " is not admissible: ", c], "") }
  }
}

fn session_placement_settle_pass(instance: HostDashboardInstance, stores: SessionPlacementStores) -> SessionSettlePass {
  match now_epoch_seconds() {
    Absent => SessionSettlePassRefused { detail: "the host clock could not be read as epoch seconds, and the reserved-state trigger compares against a deadline" }
    Present { value: now } => session_placement_settle_pass_at(stores: stores, host: instance.host_identity as String, lifecycle_of: u => session_worker_unit_lifecycle_for_instance(instance: instance, unit: u), now: now)
  }
}

// ============================================================================================
// THE REVIEWER: THE SECOND ROLE, LEASED THROUGH THE SAME AUTHORITY (2026-10-28)
//
// WHY THIS EXISTS. srv1, 2026-10-28 19:51 UTC: belt_review_spawn launched seventeen reviewers for
// one head at once, every one of them unleased at the instance ceiling (22 GiB MemoryMax), and the
// 44 GiB slice they all land in (gunbc-user-work.slice) OOM-killed all seventeen mid-typecheck,
// before any of them reached a model call. The reviewers were the last role the DECLARED FRONTIER
// above left unleased; this section closes that arm. The operator's approved fix is the ONE
// authority: a reviewer leases through gunbc.compute.host_capacity exactly as a worker does.
//
// THE POOL DECISION, as DESIGN 3b requires it be stated. Reviewers get their OWN partition, from
// HostCapacityPool::ReviewerSessionPool (gunbc.compute.host_capacity), rather than sharing the
// workers' AgentSessionPool -- a DIVERGENCE from "one pool for agent sessions" WITH A REASON, and
// it is the same law bold-bee-114 used to separate the build pool: separate pools exist so a class
// cannot starve itself. A worker holds its agent seat for the whole attempt and the attempt only
// ends after its head's reviews close; if reviewers competed for those same N agent seats, N busy
// workers would hold every seat while the reviewers that must close their heads waited behind them
// -- a permanent deadlock by construction, resolved by no timeout the reviewer could take. Within
// the pool's own class the ledger is one authority with no double counting; across the shared
// slice the SUM of the partitions is charged (the slice leg of host_capacity_reserve_reviewer),
// which is how a separate pool stays accounted against one parent rather than becoming a second
// 44 GiB entitlement.
//
// THE SAME LAWS, NOT A SECOND AUTHORITY: slot before reservation (the CAS attempt_open wins or
// loses the slot before any ledger event), the same CAS chain for the slot's generations, release
// through the same compute_release_on and the same settle decision table, and one figure for
// reservation and cap -- the unit's MemoryMax IS the granted amount, and the grant amount comes
// only from a WorkClassReviewerSession grant row or the ceiling fallback (gunbc.compute.
// work_class_grant). A refusal for LACK OF ROOM is ReviewDeferred (the belt retries on a later
// tick): waiting for room is not a failure, and the cap is never widened to get around it.
//
// THE COMPOSITE KEY. One attempt hosts ONE worker and up to N reviewers, so the reviewer's
// placement key is the attempt key joined with its criterion (session_reviewer_placement_key), and
// every durable name carries the role segment too (session_role_durable_segment). The composite,
// not the raw attempt key, is what the placement and release records carry, so a reviewer's
// record can never be read as its worker's or as another criterion's.
//
// THE CRASH LAW. A reviewer's holds are open before any unit exists and released only by the
// settlement pass once the reviewer unit is terminal (observation, or the exit record the unit
// writes for itself). A crash at any step leaves a slot a later pass resolves: opened but never
// reserved (slot expires by the launch deadline), reserved but never launched (same), launched but
// unreleased (terminal observation or exit record, then release). Release before record, or record
// before slot close: each ordering leaves either an idempotent NothingToRelease or a later pass
// that sees both sides and settles them.
//
// A FENCED DURABLE RELEASE PROVES ATTRIBUTION, NOT QUIESCENCE (bold-dove-340, #15300): the review
// unit is a single-process transient service (KillMode=process, the worker's confinement law); the
// pass releases when the LEADER is terminal -- observation or the exit record -- and does NOT
// observe descendant quiescence. Consumers that must withhold seat reuse until descendants are
// quiescent must adjudicate descendants themselves; this interface does not, and the residual is
// stated as such in the PR and on #15300.
//
// THE RESIDUAL, STATED AS IT IS (manager ruling, 2026-10-28, with bold-dove-340's correction):
// aggregate admission is NOT atomic across partitions, and work_provider_local's
// compute_cold_build_cap leases are uncharged; both stay open until every charged population joins
// one atomic parent admission with release after quiescence. Patient deferral reduces the exposure
// but bounds nothing. Per-unit MemoryMax bounds a single job, not the sum. #15300 owns the atomic
// commit; this change does not claim aggregate safety.
// ============================================================================================

// THE COMPOSITE PLACEMENT KEY OF A REVIEWER. The "r" separator is a letter, not a copy of any
// delimiter the carried values could contain: both parts are unit-name-admissible segments, so
// neither can forge the other's boundary by carrying a separator of its own.
fn session_reviewer_placement_key(attempt_key: String, criterion_key: String) -> String {
  join([attempt_key, "r", criterion_key], "")
}

// THE REVIEWER'S SLOT IDENTITY: node, attempt, ROLE, criterion. The worker's two-segment identity
// is unchanged by this -- the role segment is what makes the two roles of one attempt readable as
// different things, and the parser below accepts ONLY the four-segment shape, so a worker identity
// never parses as a reviewer and the reverse likewise.
fn session_reviewer_identity(node_id: String, attempt_key: String, criterion_key: String) -> String {
  join([node_id, ":", attempt_key, ":", session_reviewer_role, ":", criterion_key], "")
}

type SessionReviewerName {
  node_id: String
  attempt_key: String
  criterion_key: String
}

// THE FOUR-SEGMENT IDENTITY, parsed strictly. Each carried field must itself contain no ':': the
// three of them are admitted into systemd unit names and the identity must round-trip, so a field
// carrying a segment boundary is REFUSED (absent), never merged -- the worker's parser may merge a
// colon-bearing node because its last segment is all it needs, but a reviewer's criterion and role
// segments must be exactly themselves for two passes to divide slots between the roles correctly.
fn session_reviewer_field_speakable(field: String) -> Bool {
  count(field.split(delimiter: ":")) == 1
}

fn session_reviewer_name_of(identity: String) -> SessionReviewerName? {
  let parts: List<String> = identity.split(delimiter: ":")
  let node = match first(parts) { Present { value: v } => v Absent => "" }
  let key = match first(skip(parts, 1)) { Present { value: v } => v Absent => "" }
  let role = match first(skip(parts, 2)) { Present { value: v } => v Absent => "" }
  let crit = match first(skip(parts, 3)) { Present { value: v } => v Absent => "" }
  if count(parts) != 4 || role != session_reviewer_role
    || !session_reviewer_field_speakable(field: node)
    || !session_reviewer_field_speakable(field: key)
    || !session_reviewer_field_speakable(field: crit) {
    none
  } else {
    Present { value: SessionReviewerName { node_id: node, attempt_key: key, criterion_key: crit } }
  }
}

// THE REVIEWER'S UNIT NAME, admitted before anything is written or started. dispatch_review_unit_name
// is the spelling of record (gunbc.roadmap.roadmap_dispatch_actuator); admission is checked here
// because placement is the last point a bad name can still be refused for free.
fn session_reviewer_unit_name(node_id: String, attempt_key: String, criterion_key: String) -> SystemdUnitNameAdmission {
  systemd_service_unit_name(stem: join(["gunbc-review-", node_id, "-", attempt_key, "-", criterion_key], ""))
}

// THE GRANT THE REVIEWER LAUNCH CARRIES, shaped like the worker's: lease, partition, one amount,
// the class row it came from, and the slot it opened. The unit's MemoryMax is grant.amount --
// the same figure the ledger charged.
type SessionReviewerGrant {
  node_id: String
  attempt_key: String
  criterion_key: String
  unit: NonEmptyStr
  lease: LeaseGrant
  partition: PartitionId
  amount: Kibibyte
  class_grant: WorkClassGrant
  store: FabricStorageBinding
  slot: AttemptRecord
  slot_generation: CasGeneration
}

// THE THREE OUTCOMES OF TRYING TO PLACE A REVIEWER, and the law that divides them. Deferred means
// the room is not there yet and the belt re-tries on a later tick -- a LACK OF ROOM IS NEVER
// Refused, and Refused means a bug refused it (a name that could not be spoken, a ledger that
// refused for a reason other than fullness), not a question of capacity. The belt's own mapping
// (gunbc.roadmap.roadmap_belt_actuate belt_review_spawn) keeps them apart: ReviewDeferred for the
// first, ReviewFailed only for the second.
type SessionReviewerAcquisition
  = SessionReviewerPlacementGranted { grant: SessionReviewerGrant }
  | SessionReviewerPlacementDeferred { detail: String }
  | SessionReviewerPlacementRefused { detail: String }

type SessionReviewerLaunchGate
  = SessionReviewerLaunchAdmitted { grant: SessionReviewerGrant }
  | SessionReviewerLaunchRefused { detail: String }

// THE REVIEWER'S CAS ROOT, beside the worker's and not inside it: the two roles of one attempt
// open slots under the same instance root, and each pass must enumerate exactly its own class.
fn session_reviewer_slots_root(instance: HostDashboardInstance) -> NonEmptyStr {
  join([session_placement_records_dir(instance: instance), "/reviewer-attempts"], "") as NonEmptyStr
}

// THE REVIEWER'S LEDGER STORE AND CAS ROOT. The partition name is host-scoped and carries no slot
// count (gunbc.compute.host_capacity), so the settlement pass and the spawn resolve the SAME store
// without sharing a plan: how many reviewers a head may run is a property of the reservation
// request (session_reviewer_placement_acquire's reviewer_slots), not of the identity. The zero here
// says so -- no caller may read a seat limit out of it.
fn session_reviewer_placement_stores(instance: HostDashboardInstance) -> SessionStoresResolution {
  match host_capacity_subject(instance: instance, pool: ReviewerSessionPool { slots: 0 }, request: kibibyte(count: 0)) {
    ComputeSubjectHostUnresolved { host } => SessionStoresUnresolved { detail: join(["no dashboard instance is declared for host ", host as String, ", so it has no reviewer ledger"], "") }
    ComputeSubjectResolved { subject } =>
      SessionStoresResolved { stores: SessionPlacementStores {
        slots_root: session_reviewer_slots_root(instance: instance),
        records_dir: session_placement_records_dir(instance: instance),
        store: compute_capacity_store(subject: subject),
        partition: subject.partition,
      } }
  }
}

// THE REVIEWER'S DURABLE NAMES: the worker's shape, with the composite key and the reviewer role
// segment. The basename functions are the shared role-keyed cores; nothing re-spells the prefix.
fn session_reviewer_placement_basename(name: SessionReviewerName) -> String {
  session_placement_record_basename_key(
    node_id: name.node_id,
    key: join(["a", session_reviewer_placement_key(attempt_key: name.attempt_key, criterion_key: name.criterion_key)], ""),
    role: session_role_durable_segment(r: SessionReviewerSessionRole { criterion_key: name.criterion_key }),
  )
}

fn session_reviewer_release_basename(name: SessionReviewerName) -> String {
  session_placement_release_basename_key(
    node_id: name.node_id,
    key: join(["a", session_reviewer_placement_key(attempt_key: name.attempt_key, criterion_key: name.criterion_key)], ""),
    role: session_role_durable_segment(r: SessionReviewerSessionRole { criterion_key: name.criterion_key }),
  )
}

// THE RECORD A REVIEWER LAUNCH WRITES, beside the unit's start. attempt_key carries the COMPOSITE,
// unit and reference carry the review unit's wire -- the figure the unit is capped at and the
// figure the ledger charged must be readable from one document.
fn session_reviewer_record_of(host: String, grant: SessionReviewerGrant, unit_properties: List<String>) -> SessionPlacementRecord {
  SessionPlacementRecord {
    schema: session_placement_schema,
    node_id: grant.node_id,
    attempt_key: session_reviewer_placement_key(attempt_key: grant.attempt_key, criterion_key: grant.criterion_key),
    host: host,
    unit: grant.unit as String,
    reference: grant.lease.reference as String,
    grant_identity: grant.lease.fence.grant as String,
    fence_generation: grant.lease.fence.generation,
    granted_at: grant.lease.granted_at,
    expires_at: grant.lease.expires_at,
    partition: grant.partition as String,
    amount: grant.amount,
    class_grant: work_class_grant_wire(g: grant.class_grant),
    unit_properties: unit_properties,
  }
}

fn session_reviewer_placement_record_write(stores: SessionPlacementStores, host: String, grant: SessionReviewerGrant, unit_properties: List<String>) -> SessionPlacementWrite {
  let name = SessionReviewerName { node_id: grant.node_id, attempt_key: grant.attempt_key, criterion_key: grant.criterion_key }
  let path = join([stores.records_dir, "/", session_reviewer_placement_basename(name: name)], "")
  let w = Filesystem.Write(path: path, content: serialize_json(v: session_placement_record_json(r: session_reviewer_record_of(host: host, grant: grant, unit_properties: unit_properties))))
  if w.success { SessionPlacementWritten { path: path } } else { SessionPlacementWriteFailed { path: path, error: w.error } }
}

// WHAT A REVIEWER RECORD MUST AGREE WITH: its node, its COMPOSITE key, the review unit it was
// capped as, and the host it was written on. A record that disagrees on any of these is not this
// reviewer's placement, and nothing is released under it -- the worker's rule, restated for the
// reviewer's expectations rather than loosened across roles.
fn session_reviewer_record_binding_mismatch(r: SessionPlacementRecord, name: SessionReviewerName, host: String) -> String {
  let expected = dispatch_review_unit_name(node_id: name.node_id, attempt_key: name.attempt_key, criterion_key: name.criterion_key) as String
  let composite = session_reviewer_placement_key(attempt_key: name.attempt_key, criterion_key: name.criterion_key)
  if r.schema != session_placement_schema {
    join(["the reviewer placement record's schema is ", r.schema, ", not ", session_placement_schema], "")
  } else if r.node_id != name.node_id || r.attempt_key != composite {
    join(["the reviewer placement record belongs to ", r.node_id, ":", r.attempt_key, ", not ", name.node_id, ":", composite], "")
  } else if r.unit != expected || r.reference != expected {
    join(["the reviewer placement record names unit ", r.unit, " and reference ", r.reference, "; this reviewer's unit is ", expected], "")
  } else if r.host != host {
    join(["the reviewer placement record was written on host ", r.host, ", not ", host], "")
  } else { "" }
}

fn session_reviewer_grant_reading_of(path: String, obs: FilesystemFileObservation, name: SessionReviewerName, host: String) -> SessionGrantReading {
  match obs {
    FilesystemFileAbsent(_) => SessionGrantNotRecorded { path: path }
    FilesystemFileRead { path: _, content } =>
      match parse_json_document(s: content) {
        JsonDocumentUnreadable { gap } => SessionGrantUnreadable { path: path, detail: json_document_gap_text(gap: gap) }
        JsonDocumentParsed { value: doc } => {
          let decoded = session_placement_record_decode(doc: doc)
          match decoded.record {
            Absent => SessionGrantUnreadable { path: path, detail: decoded.cause }
            Present { value: r } => {
              let mismatch = session_reviewer_record_binding_mismatch(r: r, name: name, host: host)
              if mismatch == "" { SessionGrantRecorded { record: r } } else { SessionGrantForeign { path: path, detail: mismatch } }
            }
          }
        }
      }
    FilesystemFileIndeterminate { cause: _ } => SessionGrantUnreadable { path: path, detail: session_file_observation_cause(o: obs) }
    FilesystemFileObservationsDisagree { path: _, cause: _ } => SessionGrantUnreadable { path: path, detail: session_file_observation_cause(o: obs) }
    FilesystemFileSubjectRefused { directory: _, name: _, cause: _ } => SessionGrantUnreadable { path: path, detail: session_file_observation_cause(o: obs) }
  }
}

fn session_reviewer_grant_reading(stores: SessionPlacementStores, host: String, name: SessionReviewerName) -> SessionGrantReading {
  let base = session_reviewer_placement_basename(name: name)
  session_reviewer_grant_reading_of(
    path: join([stores.records_dir, "/", base], ""),
    obs: session_placement_file(dir: stores.records_dir, name: base),
    name: name,
    host: host,
  )
}

// THE RELEASE RECORD A REVIEWER SETTLEMENT WRITES, and reads back: node, COMPOSITE key, the review
// unit as reference, the release outcome, and the grant it settled when a grant was readable.
fn session_reviewer_placement_release_write(stores: SessionPlacementStores, name: SessionReviewerName, grant_binding: SessionGrantBinding?, reason: NonEmptyStr, freed: ComputeRelease) -> SessionPlacementWrite {
  let path = join([stores.records_dir, "/", session_reviewer_release_basename(name: name)], "")
  let unit = dispatch_review_unit_name(node_id: name.node_id, attempt_key: name.attempt_key, criterion_key: name.criterion_key) as String
  let w = Filesystem.Write(path: path, content: serialize_json(v: json_object(members: concat([
    json_kv(key: "schema", value: json_string(s: session_placement_schema)),
    json_kv(key: "node_id", value: json_string(s: name.node_id)),
    json_kv(key: "attempt_key", value: json_string(s: session_reviewer_placement_key(attempt_key: name.attempt_key, criterion_key: name.criterion_key))),
    json_kv(key: "reference", value: json_string(s: unit)),
    json_kv(key: "outcome", value: json_string(s: session_release_outcome_wire(r: freed))),
    json_kv(key: "reason", value: json_string(s: reason as String)),
    json_kv(key: "detail", value: json_string(s: session_release_detail(r: freed))),
  ], match grant_binding {
    Absent => []
    Present { value: b } => [json_kv(key: "grant", value: json_object(members: [
      json_kv(key: "grant_identity", value: json_string(s: b.grant_identity)),
      json_kv(key: "fence_generation", value: json_int(n: cas_generation_count(g: b.fence_generation))),
    ]))]
  }))))
  if w.success { SessionPlacementWritten { path: path } } else { SessionPlacementWriteFailed { path: path, error: w.error } }
}

fn session_reviewer_release_observation_of(path: String, obs: FilesystemFileObservation, name: SessionReviewerName, grant: SessionGrantReading) -> SessionReleaseObservation {
  match obs {
    FilesystemFileAbsent(_) => SessionReleaseNotRecorded { path: path }
    FilesystemFileRead { path: _, content } =>
      match parse_json_document(s: content) {
        JsonDocumentUnreadable { gap } => SessionReleaseUnreadable { path: path, detail: json_document_gap_text(gap: gap) }
        JsonDocumentParsed { value: doc } => {
          let nd = json_field_string(obj: doc, key: "node_id")
          let ak = json_field_string(obj: doc, key: "attempt_key")
          let rf = json_field_string(obj: doc, key: "reference")
          let outcome = json_field_string(obj: doc, key: "outcome")
          let reason = json_field_string(obj: doc, key: "reason")
          let detail = json_field_string(obj: doc, key: "detail")
          let causes = filter([
            session_field_cause(key: "node_id", r: nd), session_field_cause(key: "attempt_key", r: ak),
            session_field_cause(key: "reference", r: rf), session_field_cause(key: "outcome", r: outcome),
            session_field_cause(key: "reason", r: reason), session_field_cause(key: "detail", r: detail),
          ], c => c != "")
          match causes.first() {
            Present { value: c } => SessionReleaseUnreadable { path: path, detail: c }
            Absent => {
              let expected_unit = dispatch_review_unit_name(node_id: name.node_id, attempt_key: name.attempt_key, criterion_key: name.criterion_key) as String
              let composite = session_reviewer_placement_key(attempt_key: name.attempt_key, criterion_key: name.criterion_key)
              let mismatch = if session_string_or(r: nd) != name.node_id || session_string_or(r: ak) != composite {
                join(["the reviewer release belongs to ", session_string_or(r: nd), ":", session_string_or(r: ak), ", not this reviewer's ", name.node_id, ":", composite], "")
              } else if session_string_or(r: rf) != expected_unit {
                join(["the reviewer release names reference ", session_string_or(r: rf), ", not this reviewer's unit"], "")
              } else { session_release_grant_mismatch(doc: doc, grant: grant) }
              if mismatch != "" {
                SessionReleaseUnreadable { path: path, detail: mismatch }
              } else if session_string_or(r: outcome) == "released" {
                SessionReleased { reason: session_string_or(r: reason), detail: session_string_or(r: detail) }
              } else if session_string_or(r: outcome) == "nothing-to-release" {
                SessionReleaseNothingHeld { reason: session_string_or(r: reason), detail: session_string_or(r: detail) }
              } else if session_string_or(r: outcome) == "refused" {
                SessionReleaseRefused { reason: session_string_or(r: reason), detail: session_string_or(r: detail) }
              } else {
                SessionReleaseUnreadable { path: path, detail: join(["reviewer release outcome is not in the closed vocabulary: ", session_string_or(r: outcome)], "") }
              }
            }
          }
        }
      }
    FilesystemFileIndeterminate { cause: _ } => SessionReleaseUnreadable { path: path, detail: session_file_observation_cause(o: obs) }
    FilesystemFileObservationsDisagree { path: _, cause: _ } => SessionReleaseUnreadable { path: path, detail: session_file_observation_cause(o: obs) }
    FilesystemFileSubjectRefused { directory: _, name: _, cause: _ } => SessionReleaseUnreadable { path: path, detail: session_file_observation_cause(o: obs) }
  }
}

fn session_reviewer_release_observation(stores: SessionPlacementStores, host: String, name: SessionReviewerName) -> SessionReleaseObservation {
  let base = session_reviewer_release_basename(name: name)
  session_reviewer_release_observation_of(
    path: join([stores.records_dir, "/", base], ""),
    obs: session_placement_file(dir: stores.records_dir, name: base),
    name: name,
    grant: session_reviewer_grant_reading(stores: stores, host: host, name: name),
  )
}

// THE SLOT BEFORE THE LEDGER, in the worker's order with the worker's CAS chain. The slot carries
// the COMPOSITE owner key so the attempt-side tools can attribute a reviewer's holds, and its
// reference is the review unit's wire -- one token that keys the slot file, the lease and the
// records. A pre-existing slot for the same unit is NOT a bug: it means a reviewer for that
// criterion is already placed, and waiting on it is a room question, so it defers.
fn session_reviewer_attempt_record(node_id: String, attempt_key: String, criterion_key: String, unit: NonEmptyStr, granted: Kibibyte, now: EpochSecs) -> AttemptRecord {
  AttemptRecord {
    identity: session_reviewer_identity(node_id: node_id, attempt_key: attempt_key, criterion_key: criterion_key),
    reference: unit as String,
    unit: unit as String,
    granted: granted,
    opened_at: now,
    launch_deadline: now + compute_pre_launch_ceiling_seconds,
    state: AttemptReserved,
    owner: DispatchOwned { node_id: node_id, attempt_key: session_reviewer_placement_key(attempt_key: attempt_key, criterion_key: criterion_key) },
  }
}

// THE ANSWER AFTER A SLOT WAS OPENED AND THE LEDGER SAID NO. `room` divides the law: no room is
// DEFERRAL (a later tick may find room; the belt re-tries), a bug is REFUSAL. Either way the slot
// is closed first -- a reservation that never landed must not leave a slot standing open to hold
// the reference against the next tick's retry.
fn session_reviewer_answer_after_open(stores: SessionPlacementStores, record: AttemptRecord, generation: CasGeneration, refusal: String, room: Bool) -> SessionReviewerAcquisition {
  let closed = join([
    refusal, "; reviewer slot ",
    attempt_transition_wire(t: attempt_terminate(root: stores.slots_root, reference: record.reference as NonEmptyStr, expected: generation, verdict: AttemptRecovered, detail: join(["reservation refused: ", refusal], ""))),
  ], "")
  if room { SessionReviewerPlacementDeferred { detail: closed } } else { SessionReviewerPlacementRefused { detail: closed } }
}

// A REVIEWER LAUNCH TAKES ITS PLACEMENT. Same shape as the worker's acquire, with the reviewer's
// partition (host_capacity_reserve_reviewer): the class grant is resolved first, the CAS slot wins
// or loses the reference, and only then does the ledger see a request. reviewer_slots is how many
// reviewers this head may run at once (its criteria count) and agent_slots how many workers the
// belt runs -- both are needed because the slice leg charges the SUM of the partitions that land
// in the shared parent, and a pool cannot bound its own share without knowing the others.
fn session_reviewer_placement_acquire(
  instance: HostDashboardInstance,
  stores: SessionPlacementStores,
  node_id: String,
  attempt_key: String,
  criterion_key: String,
  reviewer_slots: Nat,
) -> SessionReviewerAcquisition {
  match session_reviewer_unit_name(node_id: node_id, attempt_key: attempt_key, criterion_key: criterion_key) {
    SystemdUnitNameAdmitted { name: _ } =>
      match now_epoch_seconds() {
        Absent => SessionReviewerPlacementRefused { detail: "the host clock could not be read as epoch seconds, and a reviewer's slot carries a launch deadline" }
        Present { value: now } =>
      match session_placement_pool() {
        // THE WORKERS' SEAT COUNT IS NEEDED TO CHARGE THE SHARED PARENT: the slice leg bills the
        // sum of the partitions that land in the work slice, and the agent partition is one of them.
        // No pool size means no honest sum, and an honest sum is what a refusal or a grant rests on.
        Absent => SessionReviewerPlacementRefused { detail: "the session pool has no size, so the workers sharing the slice with the reviewers cannot be charged" }
        Present { value: agent_pool } => {
          let agent_slots = host_capacity_pool_slots(pool: agent_pool)
          let class_grant = work_class_grant(class: WorkClassReviewerSession, rows: work_class_grant_rows, ceiling: compute_memory_ceiling(instance: instance))
          let record = session_reviewer_attempt_record(
            node_id: node_id, attempt_key: attempt_key, criterion_key: criterion_key,
            unit: dispatch_review_unit_name(node_id: node_id, attempt_key: attempt_key, criterion_key: criterion_key),
            granted: work_class_grant_amount(g: class_grant), now: now,
          )
          match attempt_open(root: stores.slots_root, record: record) {
            AttemptLostRace { expected: e, observed: o } =>
              SessionReviewerPlacementDeferred { detail: join(["a reviewer placement already holds ", record.reference, " (expected ", e, ", found ", o, "); its criterion is already being reviewed"], "") }
            AttemptTransitionRefused { detail: d } =>
              SessionReviewerPlacementRefused { detail: join(["the reviewer slot would not open, so nothing was reserved: ", d], "") }
            AttemptAdvanced { state: _, generation: g } =>
              match host_capacity_reserve_reviewer(instance: instance, reviewer_slots: reviewer_slots, agent_slots: agent_slots, reference: record.unit as NonEmptyStr, term_seconds: session_placement_term_seconds, request: record.granted) {
                ComputeReserved { grant: lease, partition: p, amount: a, store: s } =>
                  SessionReviewerPlacementGranted { grant: SessionReviewerGrant {
                    node_id: node_id, attempt_key: attempt_key, criterion_key: criterion_key,
                    unit: record.unit as NonEmptyStr,
                    lease: lease, partition: p, amount: a, class_grant: class_grant, store: s,
                    slot: record, slot_generation: g,
                  } }
                ComputeCapacityFull { wire: w } => session_reviewer_answer_after_open(stores: stores, record: record, generation: g, refusal: w, room: true)
                ComputeHostBelowFloor { requested: _, available: _ } =>
                  session_reviewer_answer_after_open(stores: stores, record: record, generation: g, refusal: "the host's free memory is below the floor every charged partition must share", room: true)
                ComputeReservationRefused { detail: d } => session_reviewer_answer_after_open(stores: stores, record: record, generation: g, refusal: d, room: false)
              }
          }
        }
      }
      }
    SystemdUnitNameStemEmpty => SessionReviewerPlacementRefused { detail: join(["the review unit name for ", node_id, ":", attempt_key, ":", criterion_key, " is empty"], "") }
    SystemdUnitNameDisallowedCharacter { stem: _, character: ch } => SessionReviewerPlacementRefused { detail: join(["the review unit name carries ", ch, ", which systemd refuses, so no unit could have run this review"], "") }
    SystemdUnitNameOverlong { length: n } => SessionReviewerPlacementRefused { detail: join(["the review unit name is ", to_string(value: n), " characters, past systemd's limit"], "") }
  }
}

// THE LAUNCH GATE, the worker's law on the reviewer's slot: only Reserved takes the launch
// generation, and a slot settlement already closed refuses the start.
fn session_reviewer_placement_begin_launch(stores: SessionPlacementStores, grant: SessionReviewerGrant) -> SessionReviewerLaunchGate {
  match attempt_begin_launch(root: stores.slots_root, reference: grant.slot.reference as NonEmptyStr, expected: grant.slot_generation) {
    AttemptAdvanced { state: s, generation: g } =>
      SessionReviewerLaunchAdmitted { grant: SessionReviewerGrant {
        node_id: grant.node_id, attempt_key: grant.attempt_key, criterion_key: grant.criterion_key, unit: grant.unit,
        lease: grant.lease, partition: grant.partition, amount: grant.amount, class_grant: grant.class_grant, store: grant.store,
        slot: attempt_record_with_state(r: grant.slot, state: s),
        slot_generation: g,
      } }
    AttemptLostRace { expected: e, observed: o } => SessionReviewerLaunchRefused { detail: join(["the reviewer slot moved before launch (expected ", e, ", found ", o, "); settlement ended this review, so its unit is not started"], "") }
    AttemptTransitionRefused { detail: d } => SessionReviewerLaunchRefused { detail: join(["the reviewer slot would not take the launch generation: ", d], "") }
  }
}

// WHEN THE START ITSELF REFUSED, free what was granted. The slot's generation decides: a winner
// closes it and releases; a loser or a refusal leaves the slot to the settlement pass, which reads
// the same states and holds nothing back on the belt's word alone. The answer is the release note
// the spawn outcome carries, in the worker's shape.
fn session_reviewer_placement_abandon(stores: SessionPlacementStores, grant: SessionReviewerGrant, reason: NonEmptyStr) -> String {
  match attempt_terminate(root: stores.slots_root, reference: grant.slot.reference as NonEmptyStr, expected: grant.slot_generation, verdict: AttemptRecovered, detail: reason as String) {
    AttemptAdvanced { state: _, generation: _ } => {
      let freed = compute_release_on(store: grant.store, partition: grant.partition, appropriation: kibibyte(count: 0), reference: grant.unit, reason: reason)
      let write = session_reviewer_placement_release_write(
        stores: stores,
        name: SessionReviewerName { node_id: grant.node_id, attempt_key: grant.attempt_key, criterion_key: grant.criterion_key },
        grant_binding: Present { value: SessionGrantBinding { grant_identity: grant.lease.fence.grant as String, fence_generation: grant.lease.fence.generation } },
        reason: reason,
        freed: freed,
      )
      join([reason as String, "; placement record close: ", session_write_note(w: write)], "")
    }
    AttemptLostRace { expected: e, observed: o } =>
      join([reason as String, "; the reviewer slot moved while the start failed (expected ", e, ", found ", o, "); the settlement pass owns it from here"], "")
    AttemptTransitionRefused { detail: d } =>
      join([reason as String, "; the reviewer slot would not take the terminal generation: ", d], "")
  }
}

// HOW A REVIEWER UNIT IS KNOWN TO HAVE ENDED, the worker's law restated for a unit whose name
// encodes a criterion: the live manager observation first, and failing that the exit record the
// unit wrote for ITSELF -- matched through the spool's own reviewer token prefix, never a
// re-spelled format. A crash between launch and release lands here on the next pass.
fn session_reviewer_unit_lifecycle_for_instance(instance: HostDashboardInstance, name: SessionReviewerName) -> UnitLifecycle {
  let unit = dispatch_review_unit_name(node_id: name.node_id, attempt_key: name.attempt_key, criterion_key: name.criterion_key)
  let loaded = attempt_unit_observation(unit: unit)
  match loaded {
    AttemptUnitAbsent =>
      session_worker_unit_lifecycle(
        unit: unit,
        loaded: loaded,
        record: attempt_exit_record_matching(
          matches: (n, a, r) =>
            n == name.node_id && a == name.attempt_key
              && starts_with(s: r, prefix: attempt_reviewer_role_token_prefix(criterion_key: name.criterion_key)),
          listings: attempt_exit_stage_listings(instance_root: instance.instance_root as String),
        ),
      )
    AttemptUnitActive => session_unit_lifecycle(o: loaded)
    AttemptUnitFinished { exit_status: _ } => session_unit_lifecycle(o: loaded)
    AttemptUnitUnreadable { reason: _ } => session_unit_lifecycle(o: loaded)
  }
}

// THE INSTRUMENT THAT SIZES THE CLASS (the manager's ruling: the route that launches reviewers
// also produces their samples, so a grant row is authored from recorded peaks and cites this
// instrument, never a hand-transcribed number). The peak is read from the manager itself -- the
// unit's MemoryPeak property, the same read the workspace metrics use -- at the moment the
// settlement pass sees the unit terminal, BEFORE collection can take it. Absent or unreported
// falls to the ceiling; it never invents a number. The sample lands as a durable record beside
// the placement records, one per review unit, naming the instrument and the figures, from which
// the WorkClassReviewerSession row is authored once enough OOM-free runs have accumulated.
type SessionReviewerPeakSample
  = SessionReviewerPeakObserved { peak: Kibibyte }
  | SessionReviewerPeakUnobserved { reason: String }

fn session_reviewer_peak_from_show(outcome: ShellOutcome, success: Bool, value: String) -> SessionReviewerPeakSample {
  match outcome {
    ShellSpawnRefused { program: _, cause: c } => SessionReviewerPeakUnobserved { reason: join(["systemctl --user show could not run: ", c], "") }
    ShellExited =>
      if !success {
        SessionReviewerPeakUnobserved { reason: join(["systemctl --user show refused the peak read: ", value], "") }
      } else if trim(s: value) == "" || trim(s: value) == "[not set]" {
        SessionReviewerPeakUnobserved { reason: "the unit reports no memory peak (collected, or accounting is off)" }
      } else if trim(s: value) == "infinity" || trim(s: value) == "max" {
        SessionReviewerPeakUnobserved { reason: "the unit reports its memory peak as unbounded" }
      } else {
        match systemd_formatted_bytes_parse(text: trim(s: value)) {
          FormattedBytesRead { value: b } => SessionReviewerPeakObserved { peak: kibibyte_ceiling(b: systemd_formatted_bytes_upper(b: b)) }
          FormattedBytesUnparseable { text: t } => SessionReviewerPeakUnobserved { reason: join(["the peak ", t, " is not a byte figure"], "") }
        }
      }
  }
}

fn session_reviewer_observe_peak(unit: NonEmptyStr) -> SessionReviewerPeakSample {
  let shown = systemd.Systemctl.ShowUserProperty(unit: unit, property: systemd_unit_property_wire(property: MemoryPeak))
  session_reviewer_peak_from_show(outcome: shown.outcome, success: shown.success, value: shown.value)
}

// THE SAMPLE RECORD, written beside the placement records. One per reviewer unit; the row author
// reads these, cites the instrument, and the sample floor in gunbc.compute.work_class_grant decides
// whether they are enough to size the class below the ceiling.
fn session_reviewer_record_peak_sample(stores: SessionPlacementStores, host: String, name: SessionReviewerName, granted: Kibibyte, sample: SessionReviewerPeakSample, observed_at: EpochSecs) -> SessionPlacementWrite {
  let path = join([stores.records_dir, "/session-placement-peak-", session_reviewer_placement_basename(name: name)], "")
  let peak_field = match sample {
    SessionReviewerPeakObserved { peak } => json_kv(key: "peak_kibibytes", value: json_int(n: kibibyte_count(k: peak))),
    SessionReviewerPeakUnobserved { reason } => json_kv(key: "peak_absent_reason", value: json_string(s: reason)),
  }
  let body = json_object(members: [
    json_kv(key: "unit", value: json_string(s: dispatch_review_unit_name(node_id: name.node_id, attempt_key: name.attempt_key, criterion_key: name.criterion_key) as String)),
    json_kv(key: "node_id", value: json_string(s: name.node_id)),
    json_kv(key: "attempt_key", value: json_string(s: session_reviewer_placement_key(attempt_key: name.attempt_key, criterion_key: name.criterion_key))),
    json_kv(key: "criterion_key", value: json_string(s: name.criterion_key)),
    json_kv(key: "host", value: json_string(s: host)),
    json_kv(key: "granted_kibibytes", value: json_int(n: kibibyte_count(k: granted))),
    peak_field,
    json_kv(key: "observed_at_seconds", value: json_int(n: observed_at)),
    json_kv(key: "instrument", value: json_string(s: "gunbc.roadmap.roadmap_session_placement session_reviewer_observe_peak: systemctl --user show -p MemoryPeak, read at settle before collection")),
  ])
  let w = Filesystem.Write(path: path, content: serialize_json(v: body))
  if w.success { SessionPlacementWritten { path: path } } else { SessionPlacementWriteFailed { path: path, error: w.error } }
}

// THE SAME DECISION TABLE, WITH THE REVIEWER'S BINDER. recovery_trigger and session_settle_by_trigger
// are the worker's, reused unchanged: the trigger law does not care which role holds the seat, and
// the decision arms do not either -- only the binding that says THIS slot belongs to THIS reviewer
// is the reviewer's own. The attempt carried through the trigger is the COMPOSITE name, so any
// release it leads to can only be written under the reviewer's role-named path.
fn session_reviewer_settle_decide(
  key: NonEmptyStr,
  name: SessionReviewerName,
  slot: AttemptSlotReading,
  lifecycle: UnitLifecycle,
  now: EpochSecs,
  release_settled: Bool,
) -> SessionSettleDecision {
  match slot {
    AttemptSlotAbsent => SettleDone { why: join(["no reviewer slot is held for ", key as String], "") }
    AttemptSlotUnreadable { detail } => SettleKeep { why: join(["the reviewer slot for ", key as String, " is unreadable, and an unreadable slot is not an absent one, so its hold is kept: ", detail], ""), explain: true }
    AttemptSlotHeld { record: rec, generation: g } => {
      let expected = dispatch_review_unit_name(node_id: name.node_id, attempt_key: name.attempt_key, criterion_key: name.criterion_key) as String
      let composite = session_reviewer_placement_key(attempt_key: name.attempt_key, criterion_key: name.criterion_key)
      let mismatch = if (key as String) != rec.reference {
        join(["the reviewer slot keyed ", key as String, " names reference ", rec.reference], "")
      } else if rec.identity != session_reviewer_identity(node_id: name.node_id, attempt_key: name.attempt_key, criterion_key: name.criterion_key) {
        join(["the reviewer slot ", key as String, " binds identity ", rec.identity, ", which is not this reviewer's"], "")
      } else if rec.unit != expected {
        join(["the reviewer slot ", key as String, " names unit ", rec.unit, ", not ", expected], "")
      } else {
        match rec.owner {
          DispatchOwned { node_id: n, attempt_key: a } =>
            if n != name.node_id || a != composite {
              join(["the reviewer slot ", key as String, " is owned by ", n, ":", a, ", not this reviewer's composite key ", composite], "")
            } else { "" }
          DirectInvocation { why: w } => join(["the reviewer slot ", key as String, " belongs to no dispatch (", w, ")"], "")
          OwnerUnrecorded { why: w } => join(["the reviewer slot ", key as String, " records no owner (", w, ")"], "")
        }
      }
      if mismatch != "" {
        SettleKeep { why: join(["the reviewer slot ", key as String, " is not bound consistently (", mismatch, "), so it is never released under this name"], ""), explain: true }
      } else {
        match rec.state {
          AttemptTerminal { verdict: _, detail: d } =>
            if release_settled { SettleDone { why: "closed and released" } } else { SettleReleaseOnly { record: rec, attempt: SessionAttemptName { node_id: name.node_id, attempt_key: composite }, reason: join(["the reviewer slot is closed (", d, ") and no settled release is recorded"], "") } }
          AttemptReserved => session_settle_by_trigger(record: rec, generation: g, attempt: SessionAttemptName { node_id: name.node_id, attempt_key: composite }, trigger: recovery_trigger(record: rec, lifecycle: lifecycle, now: now))
          AttemptLaunching => session_settle_by_trigger(record: rec, generation: g, attempt: SessionAttemptName { node_id: name.node_id, attempt_key: composite }, trigger: recovery_trigger(record: rec, lifecycle: lifecycle, now: now))
        }
      }
    }
  }
}

// A REVIEWER'S HOLD IS SETTLED once its own release record (composite key, review unit as
// reference) says released or nothing-to-release -- the same closed vocabulary as the worker's,
// read from the reviewer's role-named path.
fn session_reviewer_release_settled_for_slot(stores: SessionPlacementStores, host: String, name: SessionReviewerName) -> Bool {
  session_release_settled(r: session_reviewer_release_observation(stores: stores, host: host, name: name))
}

// THE RELEASE ITSELF, and the peak sample taken with it: the moment this pass sees the unit
// terminal is the last moment the manager still holds its MemoryPeak, and the sample must be
// recorded BEFORE the release note closes the story. One release attempt, one sample record.
fn session_reviewer_settle_release(stores: SessionPlacementStores, host: String, unit: NonEmptyStr, name: SessionReviewerName, granted: Kibibyte, reason: String, now: EpochSecs) -> SessionSettlement {
  let binding = match session_reviewer_grant_reading(stores: stores, host: host, name: name) {
    SessionGrantRecorded { record } => Present { value: SessionGrantBinding { grant_identity: record.grant_identity, fence_generation: record.fence_generation } }
    SessionGrantNotRecorded { path: _ } => none
    SessionGrantUnreadable { path: _, detail: _ } => none
    SessionGrantForeign { path: _, detail: _ } => none
  }
  let why = join(["settled: ", reason], "") as NonEmptyStr
  let freed = compute_release_on(store: stores.store, partition: stores.partition, appropriation: kibibyte(count: 0), reference: unit, reason: why)
  let write = session_reviewer_placement_release_write(stores: stores, name: name, grant_binding: binding, reason: why, freed: freed)
  let sample = session_reviewer_observe_peak(unit: unit)
  let noted = session_reviewer_record_peak_sample(stores: stores, host: host, name: name, granted: granted, sample: sample, observed_at: now)
  let peak_note = match noted {
    SessionPlacementWritten { path: p } => join(["; peak sample recorded at ", p], "")
    SessionPlacementWriteFailed { path: p, error: e } => join(["; peak sample NOT written at ", p, ": ", e], "")
  }
  SessionSettlementReleaseAttempted { unit: unit as String, freed: freed, detail: join([reason, session_write_note(w: write), peak_note], "") }
}

fn session_reviewer_settle_one(
  stores: SessionPlacementStores,
  host: String,
  key: NonEmptyStr,
  name: SessionReviewerName,
  lifecycle: UnitLifecycle,
  now: EpochSecs,
) -> SessionSettlement {
  let slot = attempt_slot_read(root: stores.slots_root, reference: key)
  match session_reviewer_settle_decide(key: key, name: name, slot: slot, lifecycle: lifecycle, now: now, release_settled: session_reviewer_release_settled_for_slot(stores: stores, host: host, name: name)) {
    SettleDone { why } => SessionSettlementDone { unit: key as String, why: why }
    SettleKeep { why, explain } =>
      SessionSettlementKept { unit: key as String, why: if explain { session_settle_note(stores: stores, unit: key as String, why: why) } else { why } }
    SettleReleaseOnly { record: rec, attempt: _, reason } =>
      session_reviewer_settle_release(stores: stores, host: host, unit: key, name: name, granted: rec.granted, reason: reason, now: now)
    SettleTerminateAndRelease { record, generation, attempt: _, reason } =>
      match attempt_terminate(root: stores.slots_root, reference: record.reference as NonEmptyStr, expected: generation, verdict: AttemptRecovered, detail: join([reason, "; unit ", unit_lifecycle_wire(u: lifecycle), " (reviewer)"], "")) {
        AttemptLostRace { expected: e, observed: o } =>
          SessionSettlementRefused { unit: key as String, detail: join(["the reviewer slot moved while settlement was deciding (expected ", e, ", found ", o, "); the observation is stale, so nothing is released"], "") }
        AttemptTransitionRefused { detail: d } => SessionSettlementRefused { unit: key as String, detail: join(["the reviewer slot would not take the terminal generation: ", d], "") }
        AttemptAdvanced { state: _, generation: _ } =>
          session_reviewer_settle_release(stores: stores, host: host, unit: key, name: name, granted: record.granted, reason: reason, now: now)
      }
  }
}

// THE REVIEWER SETTLEMENT PASS: enumerate the reviewer slot root, keep only identities that parse
// as reviewers (the strict parser makes a worker identity and a corrupt one both unfixed by this
// pass), and settle each through the shared decision table. A crash leaves a slot here for the
// next pass; nothing about a reviewer's hold is ever resolved by guessing.
fn session_reviewer_placement_settle_pass_at(
  stores: SessionPlacementStores,
  host: String,
  lifecycle_of: fn(SessionReviewerName) -> UnitLifecycle,
  now: EpochSecs,
) -> SessionSettlePass {
  match cas_slot_keys(root: stores.slots_root) {
    CasSlotKeysListed { keys } =>
      SessionSettlePassRan { settlements: flat_map(keys, k => match attempt_slot_read(root: stores.slots_root, reference: k) {
        AttemptSlotHeld { record: rec, generation: _ } =>
          match session_reviewer_name_of(identity: rec.identity) {
            Present { value: name } => [session_reviewer_settle_one(stores: stores, host: host, key: k, name: name, lifecycle: lifecycle_of(name), now: now)]
            Absent => [] as List<SessionSettlement>
          }
        AttemptSlotAbsent => [] as List<SessionSettlement>
        AttemptSlotUnreadable { detail: d } =>
          [SessionSettlementKept { unit: k as String, why: join(["the reviewer slot store entry ", k as String, " is unreadable, so its owner cannot be named and its hold is kept: ", d], "") }]
      }) }
    CasSlotKeysListingRefused { root: r, detail: d } => SessionSettlePassRefused { detail: join(["the reviewer slot store at ", r as String, " could not be listed: ", d], "") }
    CasSlotKeysSubjectRefused { root: r, cause: c } => SessionSettlePassRefused { detail: join(["the reviewer slot store path ", r as String, " is not admissible: ", c], "") }
  }
}

fn session_reviewer_placement_settle_pass(instance: HostDashboardInstance, stores: SessionPlacementStores) -> SessionSettlePass {
  match now_epoch_seconds() {
    Absent => SessionSettlePassRefused { detail: "the host clock could not be read as epoch seconds, and a reviewer settlement measures launch deadlines against it" }
    Present { value: now } => session_reviewer_placement_settle_pass_at(
      stores: stores,
      host: instance.host_identity as String,
      lifecycle_of: name => session_reviewer_unit_lifecycle_for_instance(instance: instance, name: name),
      now: now,
    )
  }
}
