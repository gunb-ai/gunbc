fn serve_text_response(status: HttpStatus, content_type: MediaType, body: String) -> ServeHttpResponse {
  ServeHttpResponse { status: status, content_type: content_type, body: body, headers: [] }
}

fn serve_text_response_with_headers(status: HttpStatus, content_type: MediaType, body: String, headers: List<ServeResponseHeader>) -> ServeHttpResponse {
  ServeHttpResponse { status: status, content_type: content_type, body: body, headers: headers }
}

fn serve_page_response_with_status(page: Fragment, status: HttpStatus) -> ServeHttpResponse {
  match try_serialize_html_source(node: page) {
    EmitOk { html } => serve_text_response(status: status, content_type: text_html_utf8, body: html)
    EmitRejected { reason } => serve_text_response(
      status: 500,
      content_type: text_plain_utf8,
      body: page_render_refusal_body(reason: reason),
    )
  }
}

fn launch_refusal_http_status(r: LaunchRefusal) -> HttpStatus {
  match r {
    LaunchAlreadyLive { session_name: _ } => 200
    LaunchNoActuatingInstance { reason: _ } => 403
    LaunchInstanceActuationRefused { instance_id: _, reason: _ } => 403
    LaunchNodeUnknown => 404
    LaunchAlreadyAccepted => 409
    LaunchNodeSuperseded { by: _ } => 409
    LaunchReviewRequired => 409
    LaunchDispatchBindingMissing => 409
    LaunchExecutionContractMissing { reason: _ } => 409
    LaunchNotAgentWork { mode: _ } => 409
    LaunchDependenciesBlocked { blockers: _ } => 409
    LaunchNoCapacity { occupied: _, max_concurrent: _ } => 409
    LaunchCauseNotPermitted { cause: _, mode: _ } => 409
    LaunchStaleSession { session_name: _, detail: _ } => 409
    LaunchTransitionInhibited { reason: _ } => 409
    LaunchSessionMultiplicityConflict { session_names: _, session_count: _ } => 409
    LaunchSessionsUnobservable { reason: _ } => 503
    LaunchAuthorityUnobserved { detail: _ } => 503
    LaunchRevisionUnobserved { cause: _ } => 503
    LaunchLivenessUnobserved { session_name: _, reason: _ } => 503
    LaunchGateNotEvaluated { gate: _ } => 503
  }
}

fn serve_issue_detail_response_over(
  instance: HostDashboardInstance,
  plan: RoadmapAuthorityProjection,
  params: List<PathParamBinding>,
  request: ServeHttpRequest<RequestAuthenticationEvidence>,
) -> ServeHttpResponse {
  let node_id = path_param_value(params: params, name: "node_id")
  let layout = roadmap_event_carrier_layout_for_instance(instance: instance)
  let standings = roadmap_standings_read(layout: layout)
  let viewer = authenticated_viewer_label(evidence: request.security.authentication)
  match roadmap_events_read_all(layout: layout) {
    AllEventsReadRefused { step, reason } => serve_text_response(status: 503, content_type: text_plain_utf8,
      body: join(["Issue history is unavailable at ", step, ": ", reason], ""))
    AllEventsRead { envelopes: all_events } => {
  let page = issue_detail_page_for(
    proj: plan,
    node_id: node_id,
    attempts: [],
    attempts_refused: none,
    standings: standings,
    launch: belt_launch_host_standing_for_page_over(instance: instance, plan: plan),
    stale_nodes: [],
    events: filter(all_events, event => event.event.node == (node_id as NonEmptyStr as RoadmapNodeId)),
    viewer: viewer,
    recents: roadmap_recent_claimed_assignees(envs: all_events))
  serve_page_response_with_status(
    page: page,
    status: if issue_detail_node_exists(proj: plan, node_id: node_id) { 200 } else { 404 })
    }
  }
}

fn serve_issue_assignment_context_over(
  instance: HostDashboardInstance,
  plan: RoadmapAuthorityProjection,
  request: ServeHttpRequest<RequestAuthenticationEvidence>,
  params: List<PathParamBinding>,
) -> ServeHttpResponse {
  let node_id = path_param_value(params: params, name: "node_id")
  match request.security.authentication {
    GoogleOidcSession { session } =>
      if !issue_detail_node_exists(proj: plan, node_id: node_id) {
        serve_text_response(status: 404, content_type: text_plain_utf8, body: "Issue not found.")
      } else {
        let layout = roadmap_event_carrier_layout_for_instance(instance: instance)
        match roadmap_events_read(layout: layout, node: node_id as NonEmptyStr as RoadmapNodeId) {
          EventsReadRefused { node: _, step, reason } =>
            serve_text_response(status: 503, content_type: text_plain_utf8, body: join(["Cannot load assignment history at ", step, ": ", reason], ""))
          EventsRead { node: _, envelopes } =>
            let recents = match roadmap_events_read_all(layout: layout) {
              AllEventsRead { envelopes: all_events } => roadmap_recent_claimed_assignees(envs: all_events)
              AllEventsReadRefused { step: _, reason: _ } => []
            }
            serve_text_response_with_headers(
              status: 200,
              content_type: application_json_utf8,
              body: inline_assignment_context_body(session: session, events: envelopes, recents: recents),
              headers: [ServeResponseHeaderNoStore])
        }
      }
    AuthAbsent => serve_text_response(status: 401, content_type: text_plain_utf8, body: "Sign in to assign this issue.")
    SessionStandingInvalid { standing: _ } => serve_text_response(status: 401, content_type: text_plain_utf8, body: "Your session has expired or is unavailable. Sign in again.")
    FabricServiceEvidence { kind: _, authenticated_at: _ } => serve_text_response(status: 403, content_type: text_plain_utf8, body: "Inline assignment requires a signed-in human session.")
  }
}

fn assignee_submission_shape_valid(s: String) -> Bool {
  issue_assignee_input_is_email(s: s)
    || trim(s) == (issue_assign_fabric_display as String)
    || match principal_ref_parse_label(s: s) { Present { value: _ } => true  Absent => false }
}

fn assignee_principal_of(raw: String) -> PrincipalRef? {
  let t = trim(raw)
  match principal_ref_parse_label(s: t) {
    Present { value: ref } => Present { value: ref }
    Absent =>
      if t == (issue_assign_fabric_display as String) {
        Present { value: fabric_workflow_principal }
      } else {
        none
      }
  }
}

fn assignee_lookup_refusal(raw: String) -> String {
  let t = trim(raw)
  if issue_assignee_input_is_email(s: t) && t != (issue_assign_fabric_display as String) {
    join(["'", t, "' names no admitted principal — the typed-email directory lookup is the A9 producer and no directory is bound yet, so human emails cannot mint a principal (and never will: email is display, not identity)"], "")
  } else {
    join(["'", t, "' is neither a principal spelling, the fabric selector, nor an email spelling"], "")
  }
}

fn serve_issue_assign_response_over(
  instance: HostDashboardInstance,
  plan: RoadmapAuthorityProjection,
  request: ServeHttpRequest<RequestAuthenticationEvidence>,
  params: List<PathParamBinding>,
) -> ServeHttpResponse {
  let node_id = path_param_value(params: params, name: "node_id")
  if !issue_detail_node_exists(proj: plan, node_id: node_id) {
    serve_text_response(status: 404, content_type: text_plain_utf8, body: join(["issue not found: ", node_id, "\n"], ""))
  } else {
    let observed_at = match clock_now_probed_at() { Present { value: t } => t as String  Absent => "" }
    match human_write_admission(
      route_path: join(["/issue/", node_id, "/assign"], "") as NonEmptyStr,
      action: ServeActionAssignIssue,
      security: request.security,
      authorization_policy: tracker_write_authorization_policy,
      deployment_policy: roadmap_deployment_access_policy,
      csrf_presented: issue_form_field(body: request.body, name: "csrf"),
      observed_at: observed_at,
    ) {
      Deny { refusal } =>
        serve_text_response(status: 403, content_type: text_plain_utf8, body: concat("assignment refused: ", access_refusal_reason(refusal: refusal)))
      Permit =>
        let author = authenticated_write_author_label(security: request.security)
        let raw_assignee = issue_form_field(body: request.body, name: "assignee")
        if !assignee_submission_shape_valid(s: raw_assignee) {
          serve_text_response(status: 400, content_type: text_plain_utf8, body: join(["assignment refused: '", raw_assignee, "' is not an email spelling, the fabric selector, or a principal spelling\n"], ""))
        } else {
          let raw_return_to = issue_form_field(body: request.body, name: "return_to")
          if raw_return_to != "" && !assignee_submission_shape_valid(s: raw_return_to) {
            serve_text_response(status: 400, content_type: text_plain_utf8, body: join(["assignment refused: return_to '", raw_return_to, "' is not an email spelling, the fabric selector, or a principal spelling\n"], ""))
          } else {
            let layout = roadmap_event_carrier_layout_for_instance(instance: instance)
            let nid = node_id as NonEmptyStr as RoadmapNodeId
            match roadmap_events_read(layout: layout, node: nid) {
              EventsReadRefused { node: _, step, reason } =>
                serve_text_response(status: 503, content_type: text_plain_utf8, body: join(["assignment refused: could not read the issue's history (", step, "): ", reason, "\n"], ""))
              EventsRead { node: _, envelopes } =>
                let standing = roadmap_node_standing(envs: envelopes)
                let key = roadmap_node_standing_key(s: standing)
                if key == "forked" || key == "history_incomplete" {
                  serve_text_response(status: 409, content_type: text_plain_utf8, body: join(["assignment refused: the issue's history is ", key, ": ", roadmap_node_standing_text(s: standing), "\n"], ""))
                } else {
                  let heads = filter(envelopes, e => !any(envelopes, o => match o.event.parent { Present { value: p } => (p as String) == (e.id as String)  Absent => false }))
                  let head = match heads.first() { Present { value: h } => h.id as String  Absent => "" }
                  let expected_revision = issue_form_field(body: request.body, name: "expected_revision")
                  if expected_revision != head {
                    serve_text_response(status: 409, content_type: text_plain_utf8, body: join(["assignment refused: the issue changed since the page rendered (expected revision ", expected_revision, ", head ", head, ") — reload and assign again\n"], ""))
                  } else {
                    let at = match clock_now_probed_at() { Present { value: t } => t as String  Absent => "" }
                    match authenticated_write_author_principal(security: request.security) {
                      Absent =>
                        serve_text_response(status: 403, content_type: text_plain_utf8, body: "assignment refused: admitted write carried no author principal (unreachable past the write law)\n")
                      Present { value: author_ref } =>
                        match assignee_principal_of(raw: raw_assignee) {
                          Absent =>
                            serve_text_response(status: 400, content_type: text_plain_utf8, body: join(["assignment refused: ", assignee_lookup_refusal(raw: raw_assignee), "\n"], ""))
                          Present { value: assignee_ref } =>
                            match (if raw_return_to == "" { Present { value: author_ref } } else { assignee_principal_of(raw: raw_return_to) }) {
                              Absent =>
                                serve_text_response(status: 400, content_type: text_plain_utf8, body: join(["assignment refused: return_to ", assignee_lookup_refusal(raw: raw_return_to), "\n"], ""))
                              Present { value: return_to_ref } =>
                                match roadmap_event_append(layout: layout, event: RoadmapEvent { node: nid, author: EventPrincipalAuthenticated { ref: author_ref }, parent: match heads.first() { Present { value: h } => Present { value: h.id }  Absent => none }, kind: Claimed { assignee: EventPrincipalAuthenticated { ref: assignee_ref }, return_to: EventPrincipalAuthenticated { ref: return_to_ref } }, recorded_at: at }) {
                                  EventAppended { id } =>
                                    serve_assignment_launch_follow_through(instance: instance, plan: plan, node_id: node_id, assignee: assignee_ref, event_id: id as String)
                                  EventAlreadyPresent { id } =>
                                    serve_assignment_launch_follow_through(instance: instance, plan: plan, node_id: node_id, assignee: assignee_ref, event_id: id as String)
                                  EventAppendRefused { id: _, step, reason } =>
                                    serve_text_response(status: 503, content_type: text_plain_utf8, body: join(["assignment refused at ", step, ": ", reason, "\n"], ""))
                                }
                            }
                        }
                    }
                  }
                }
            }
          }
        }
    }
  }
}

fn authenticated_write_author_principal(security: RequestSecurityContext<RequestAuthenticationEvidence>) -> PrincipalRef? {
  match security.authentication {
    GoogleOidcSession { session } => Present { value: session.principal }
    FabricServiceEvidence { kind: _, authenticated_at: _ } => Present { value: fabric_workflow_principal }
    SessionStandingInvalid { standing: _ } => none
    AuthAbsent => none
  }
}

fn authenticated_write_author_label(security: RequestSecurityContext<RequestAuthenticationEvidence>) -> NonEmptyStr {
  match security.authentication {
    GoogleOidcSession { session } => principal_ref_label(p: session.principal) as NonEmptyStr
    _ => "unreachable: admitted human write without a session principal" as NonEmptyStr
  }
}

fn issue_form_field(body: String, name: String) -> String {
  let prefix = join([name, "="], "")
  match (filter(split(s: body, delimiter: "\n"), line => starts_with(s: line, prefix: prefix))).first() {
    Present { value: line } => substring(s: line, start: string_length(s: prefix), end: string_length(s: line))
    Absent => ""
  }
}

fn serve_assignment_launch_follow_through(
  instance: HostDashboardInstance,
  plan: RoadmapAuthorityProjection,
  node_id: String,
  assignee: PrincipalRef,
  event_id: String,
) -> ServeHttpResponse {
  if principal_ref_eq(a: assignee, b: fabric_workflow_principal) {
    serve_fabric_assignment_response(
      node_id: node_id,
      assignee: assignee,
      event_id: event_id,
      outcome: belt_dispatch_node_for_instance_over(instance: instance, plan: plan, node_id: node_id),
    )
  } else {
    serve_text_response(status: 200, content_type: text_plain_utf8, body: join(["assigned: ", node_id, " → ", principal_ref_label(p: assignee), " (event ", event_id, ")\n"], ""))
  }
}

fn serve_fabric_assignment_response(node_id: String, assignee: PrincipalRef, event_id: String, outcome: BeltSpawnOutcome) -> ServeHttpResponse {
  match outcome {
    Spawned { node_id: _, session_name, provider: _, launch: _ } =>
      serve_text_response(status: 200, content_type: text_plain_utf8, body: join(["assigned: ", node_id, " → ", principal_ref_label(p: assignee), " (event ", event_id, ")\nfabric work request admitted: session ", session_name, " — the attempt renders on the Work tab\n"], ""))
    SpawnFailed { node_id: _, step, detail, provider: _, launch: _ } =>
      serve_text_response(status: 502, content_type: text_plain_utf8, body: join(["assigned: ", node_id, " → ", principal_ref_label(p: assignee), " (event ", event_id, ")\nfabric launch failed at ", step, ": ", detail, " — the assignment stands; re-assign to retry the request\n"], ""))
    SpawnNotAdmitted { node_id: _, refusal } =>
      serve_text_response(status: launch_refusal_http_status(r: refusal), content_type: text_plain_utf8, body: join(["assigned: ", node_id, " → ", principal_ref_label(p: assignee), " (event ", event_id, ")\nwaiting on fabric: ", launch_refusal_label(r: refusal), " — ", launch_refusal_reason(r: refusal), " — the assignment stands; the request joins the existing attempt when one is live\n"], ""))
  }
}

fn serve_issue_comment_response_over(
  instance: HostDashboardInstance,
  request: ServeHttpRequest<RequestAuthenticationEvidence>,
  params: List<PathParamBinding>,
) -> ServeHttpResponse {
  let node_id = path_param_value(params: params, name: "node_id")
  let plan = gunbc.roadmap_live_projection.roadmap_live_authority_projection()
  if !issue_detail_node_exists(proj: plan, node_id: node_id) {
    serve_text_response(status: 404, content_type: text_plain_utf8, body: join(["issue not found: ", node_id, "\n"], ""))
  } else {
    let observed_at = match clock_now_probed_at() { Present { value: t } => t as String  Absent => "" }
    match human_write_admission(
      route_path: join(["/issue/", node_id, "/comment"], "") as NonEmptyStr,
      action: ServeActionCommentIssue,
      security: request.security,
      authorization_policy: tracker_write_authorization_policy,
      deployment_policy: roadmap_deployment_access_policy,
      csrf_presented: issue_form_field(body: request.body, name: "csrf"),
      observed_at: observed_at,
    ) {
      Deny { refusal } =>
        serve_text_response(status: 403, content_type: text_plain_utf8, body: concat("comment refused: ", access_refusal_reason(refusal: refusal)))
      Permit =>
        let author_principal = authenticated_write_author_principal(security: request.security)
        let body = issue_comment_body_of(wire: request.body)
        if trim(body) == "" {
          serve_text_response(status: 400, content_type: text_plain_utf8, body: "comment refused: the body is empty\n")
        } else {
          let layout = roadmap_event_carrier_layout_for_instance(instance: instance)
          let nid = node_id as NonEmptyStr as RoadmapNodeId
          match roadmap_events_read(layout: layout, node: nid) {
            EventsReadRefused { node: _, step, reason } =>
              serve_text_response(status: 503, content_type: text_plain_utf8, body: join(["comment refused: could not read the issue's history (", step, "): ", reason, "\n"], ""))
            EventsRead { node: _, envelopes } =>
              let standing = roadmap_node_standing(envs: envelopes)
              let key = roadmap_node_standing_key(s: standing)
              if key == "forked" || key == "history_incomplete" {
                serve_text_response(status: 409, content_type: text_plain_utf8, body: join(["comment refused: the issue's history is ", key, ": ", roadmap_node_standing_text(s: standing), "\n"], ""))
              } else {
                let heads = filter(envelopes, e => !any(envelopes, o => match o.event.parent { Present { value: p } => (p as String) == (e.id as String)  Absent => false }))
                let head_string = match heads.first() { Present { value: h } => h.id as String  Absent => "" }
                let expected_revision = issue_form_field(body: request.body, name: "expected_revision")
                if expected_revision != "" && expected_revision != head_string {
                  serve_text_response(status: 409, content_type: text_plain_utf8, body: join(["comment refused: the issue changed since the page rendered (expected revision ", expected_revision, ", head ", head_string, ") — reload and comment again\n"], ""))
                } else {
                  match author_principal {
                    Absent =>
                      serve_text_response(status: 403, content_type: text_plain_utf8, body: "comment refused: admitted write carried no author principal (unreachable past the write law)\n")
                    Present { value: author_ref } =>
                      let author_identity = EventPrincipalAuthenticated { ref: author_ref }
                      let key_field = trim(issue_form_field(body: request.body, name: "key"))
                      let comments = roadmap_issue_comments(envs: envelopes)
                      if key_field != "" && roadmap_comment_created_key_present(envs: envelopes, comment: key_field as NonEmptyStr) {
                        serve_comment_recorded_response(node_id: node_id, comments: comments, comment: key_field, event_id: "", already_present: true)
                      } else if key_field == "" && roadmap_comment_retry_present(envs: envelopes, author: author_identity, body: body as NonEmptyStr, head: match heads.first() { Present { value: h } => Present { value: h.id }  Absent => none }) {
                        serve_comment_recorded_response(node_id: node_id, comments: comments, comment: "", event_id: "", already_present: true)
                      } else {
                        let at = match clock_now_probed_at() { Present { value: t } => t as String  Absent => "" }
                        let comment_id = if key_field == "" { join([principal_ref_label(p: author_ref), ":", body], "") as NonEmptyStr } else { key_field as NonEmptyStr }
                        match roadmap_event_append(layout: layout, event: RoadmapEvent { node: nid, author: author_identity, parent: match heads.first() { Present { value: h } => Present { value: h.id }  Absent => none }, kind: CommentCreated { comment: comment_id, body: body as NonEmptyStr, visibility: "public" as NonEmptyStr, parent_comment: none }, recorded_at: at }) {
                          EventAppended { id } =>
                            serve_comment_recorded_response(node_id: node_id, comments: [IssueComment { ordinal: count(comments) + 1, comment: comment_id, author: author_identity, body: "", visibility: "public" as NonEmptyStr, parent_comment: none, created_at: "", edited_at: "", deleted: false }], comment: comment_id as String, event_id: id as String, already_present: false)
                          EventAlreadyPresent { id } =>
                            serve_comment_recorded_response(node_id: node_id, comments: comments, comment: comment_id as String, event_id: id as String, already_present: true)
                          EventAppendRefused { id: _, step, reason } =>
                            serve_text_response(status: 503, content_type: text_plain_utf8, body: join(["comment refused at ", step, ": ", reason, "\n"], ""))
                        }
                      }
                  }
                }
              }
          }
        }
    }
  }
}

fn serve_comment_recorded_response(node_id: String, comments: List<IssueComment>, comment: String, event_id: String, already_present: Bool) -> ServeHttpResponse {
  let ordinal = match (filter(comments, c => (c.comment as String) == comment)).first() {
    Present { value: c } => c.ordinal
    Absent => 0
  }
  let link = join(["/issue/", node_id, "#comment-", to_string(value: ordinal)], "")
  if already_present {
    serve_text_response(status: 200, content_type: text_plain_utf8, body: join(["comment recorded (already present): ", link, "\n"], ""))
  } else {
    serve_text_response(status: 200, content_type: text_plain_utf8, body: join(["comment recorded: ", link, " (event ", event_id, ")\n"], ""))
  }
}

fn issue_comment_body_of(wire: String) -> String {
  if starts_with(s: wire, prefix: "body=") {
    substring(s: wire, start: 5, end: string_length(s: wire))
  } else {
    let parts = split(s: wire, delimiter: "\nbody=")
    if count(parts) == 1 {
      ""
    } else {
      match parts.first() {
        Present { value: before } => substring(s: wire, start: string_length(s: before) + 6, end: string_length(s: wire))
        Absent => ""
      }
    }
  }
}
