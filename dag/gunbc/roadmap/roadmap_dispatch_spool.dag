module gunbc.roadmap.roadmap_dispatch_spool

import std.algebra { trim }
import std.types { String, NonEmptyStr, List, Bool, FilePath }
import std.content_hash { content_hash_atom }
import extdeps.shell
import extdeps.filesystem.filesystem_io {
  Filesystem,
  FilesystemReadRefused,
  FilesystemReadSucceeded,
  filesystem_read_outcome,
}
import extdeps.languages.json.emit {
  JsonValue,
  JsonKeyValue,
  json_string,
  json_object,
  json_array,
  json_kv,
  serialize_json,
}
import extdeps.languages.json.parse {
  parse_json_document,
  JsonDocumentParsed,
  JsonDocumentUnreadable,
  json_document_gap_text,
  json_field_string,
  FieldRead,
  FieldAbsent,
  FieldMalformed,
}
import gunbc.host.host_layout {
  dispatch_request_dir,
  dispatch_answer_dir,
  dispatch_refused_dir,
}
import gunbc.roadmap.roadmap_dashboard_instance { HostDashboardInstance }
import gunbc.roadmap.roadmap_attempt_request_binding { LaunchAutonomous }
import gunbc.roadmap.roadmap_dispatch_actuator {
  decode_dispatch_executor_request,
  DispatchExecutorRequest,
  DispatchExecutorRequestDecoded,
  DispatchExecutorRequestUnknown,
}
import gunbc.roadmap.roadmap_runtime_plan { roadmap_plan_projection }
import gunbc.roadmap.roadmap_belt_actuate {
  belt_dispatch_node_for_instance_over,
  belt_spawn_outcome_json,
  BeltSpawnOutcome,
}

data dispatch_request_schema: NonEmptyStr = "belt-dispatch-spool-request/v1"

type DispatchSpoolRequest
  = DispatchSpoolDispatch { node_id: String, executor: DispatchExecutorRequest, executor_word: String }

type DispatchRequestDecode
  = DispatchRequestDecoded { request: DispatchSpoolRequest }
  | DispatchRequestUndecodable { reason: String }
  | DispatchRequestHumanOnly { reason: String }

type DispatchRequestAdmission
  = DispatchRequestAdmitted { request: DispatchSpoolRequest }
  | DispatchRequestUndecodableDocument { reason: String }
  | DispatchRequestHumanOnlyAction { reason: String }
  | DispatchRequestMisaddressed { detail: String }

type DispatchSpoolOutcome
  = DispatchSpoolDispatched { entry: String, spawn: BeltSpawnOutcome }
  | DispatchSpoolAnswerWriteFailed { entry: String, detail: String }
  | DispatchSpoolRequestNotConsumed { entry: String, detail: String }
  | DispatchSpoolRequestUnreadable { entry: String, detail: String }
  | DispatchSpoolRequestRefused { entry: String, detail: String }
  | DispatchSpoolRequestNotQuarantined { entry: String, detail: String }
  | DispatchSpoolSpoolRefused { detail: String }

type DispatchSpoolDisposition
  = OutcomeRecorded
  | OutcomeStopsTheLine { detail: String }

type DispatchSpoolRunStanding
  = DispatchSpoolRunCompleted { answered: Int }
  | DispatchSpoolRunStopped { first: String, more: Int }

fn dispatch_spool_entry_name(key: String) -> String {
  join([key, ".json"], "")
}

fn dispatch_request_path_for(instance_root: String, key: String) -> String {
  join([
    dispatch_request_dir(instance_root: instance_root),
    "/",
    dispatch_spool_entry_name(key: key),
  ], "")
}

type DispatchRequestEnqueue
  = DispatchRequestEnqueued { path: String, entry: String }
  | DispatchRequestNotEnqueued { detail: String }

fn dispatch_request_enqueue(
  instance_root: String,
  node_id: String,
  executor_word: String,
) -> DispatchRequestEnqueue {
  if trim(node_id) == "" {
    DispatchRequestNotEnqueued { detail: "dispatch spool enqueue refuses an empty node_id" }
  } else {
    let key = dispatch_spool_key(node_id: node_id, executor_word: executor_word)
    let entry = dispatch_spool_entry_name(key: key)
    let path = dispatch_request_path_for(instance_root: instance_root, key: key)
    let write = Filesystem.Write(
      path: path,
      content: dispatch_request_json(node_id: node_id, executor_word: executor_word),
    )
    if write.success {
      DispatchRequestEnqueued { path: path, entry: entry }
    } else {
      DispatchRequestNotEnqueued {
        detail: join([
          "the dispatch request could not be written, so nothing was asked of the belt: ",
          path, " (", write.error, ")",
        ], ""),
      }
    }
  }
}

fn dispatch_spool_key(node_id: String, executor_word: String) -> String {
  content_hash_atom(
    value: join([dispatch_request_schema as String, "|", node_id, "|", executor_word], "") as NonEmptyStr,
  ).digest as String
}

fn dispatch_request_json(node_id: String, executor_word: String) -> String {
  serialize_json(v: json_object(members: concat(
    [
      json_kv(key: "schema", value: json_string(s: dispatch_request_schema as String)),
      json_kv(key: "node_id", value: json_string(s: node_id)),
    ],
    if executor_word == "" {
      [] as List<JsonKeyValue>
    } else {
      [json_kv(key: "executor", value: json_string(s: executor_word))]
    },
  )))
}

fn dispatch_request_decode_document(doc: JsonValue) -> DispatchRequestDecode {
  match json_field_string(obj: doc, key: "action") {
    FieldMalformed { cause: c } => DispatchRequestUndecodable { reason: c }
    FieldRead { value: action } =>
      if action != "dispatch" {
        DispatchRequestHumanOnly {
          reason: join(["service write does not admit human-only action ", action], ""),
        }
      } else {
        dispatch_request_decode_dispatch_fields(doc: doc)
      }
    FieldAbsent => dispatch_request_decode_dispatch_fields(doc: doc)
  }
}

fn dispatch_request_decode_dispatch_fields(doc: JsonValue) -> DispatchRequestDecode {
  match json_field_string(obj: doc, key: "schema") {
    FieldAbsent => DispatchRequestUndecodable { reason: "dispatch request schema member is absent" }
    FieldMalformed { cause: c } => DispatchRequestUndecodable { reason: c }
    FieldRead { value: schema } =>
      if schema != (dispatch_request_schema as String) {
        DispatchRequestUndecodable {
          reason: join([
            "dispatch request schema is ", schema,
            ", not ", dispatch_request_schema as String,
          ], ""),
        }
      } else {
        match json_field_string(obj: doc, key: "node_id") {
          FieldAbsent => DispatchRequestUndecodable { reason: "dispatch request node_id member is absent" }
          FieldMalformed { cause: c } => DispatchRequestUndecodable { reason: c }
          FieldRead { value: node_id } =>
            if trim(node_id) == "" {
              DispatchRequestUndecodable { reason: "dispatch request node_id is empty" }
            } else {
              match json_field_string(obj: doc, key: "executor") {
                FieldMalformed { cause: c } => DispatchRequestUndecodable { reason: c }
                FieldAbsent => dispatch_request_decode_executor(node_id: node_id, executor_word: "")
                FieldRead { value: w } => dispatch_request_decode_executor(node_id: node_id, executor_word: w)
              }
            }
        }
      }
  }
}

fn dispatch_request_decode_executor(node_id: String, executor_word: String) -> DispatchRequestDecode {
  match decode_dispatch_executor_request(word: executor_word) {
    DispatchExecutorRequestUnknown { word, known } =>
      DispatchRequestUndecodable {
        reason: join(["dispatch executor ", word, " is not a known executor; accepted: ", join(known, ", ")], ""),
      }
    DispatchExecutorRequestDecoded { request: executor } =>
      DispatchRequestDecoded {
        request: DispatchSpoolDispatch {
          node_id: node_id,
          executor: executor,
          executor_word: executor_word,
        },
      }
  }
}

fn dispatch_request_decode(request: String) -> DispatchRequestDecode {
  match parse_json_document(s: request) {
    JsonDocumentUnreadable { gap: gap } =>
      DispatchRequestUndecodable {
        reason: concat("the dispatch request is ", json_document_gap_text(gap: gap)),
      }
    JsonDocumentParsed { value: doc } => dispatch_request_decode_document(doc: doc)
  }
}

fn dispatch_request_admission(entry: String, request_text: String) -> DispatchRequestAdmission {
  match dispatch_request_decode(request: request_text) {
    DispatchRequestUndecodable { reason } => DispatchRequestUndecodableDocument { reason: reason }
    DispatchRequestHumanOnly { reason } => DispatchRequestHumanOnlyAction { reason: reason }
    DispatchRequestDecoded { request } =>
      match request {
        DispatchSpoolDispatch { node_id, executor: _, executor_word } =>
          if dispatch_spool_entry_name(key: dispatch_spool_key(node_id: node_id, executor_word: executor_word)) != entry {
            DispatchRequestMisaddressed {
              detail: join([
                "the request addresses ",
                dispatch_spool_entry_name(key: dispatch_spool_key(node_id: node_id, executor_word: executor_word)),
                ", so the document at this entry is not about the dispatch its name claims",
              ], ""),
            }
          } else {
            DispatchRequestAdmitted { request: request }
          }
      }
  }
}

fn dispatch_spool_outcome_key(o: DispatchSpoolOutcome) -> String {
  match o {
    DispatchSpoolDispatched { entry: _, spawn: _ } => "dispatched"
    DispatchSpoolAnswerWriteFailed { entry: _, detail: _ } => "answer_write_failed"
    DispatchSpoolRequestNotConsumed { entry: _, detail: _ } => "request_not_consumed"
    DispatchSpoolRequestUnreadable { entry: _, detail: _ } => "request_unreadable"
    DispatchSpoolRequestRefused { entry: _, detail: _ } => "request_refused"
    DispatchSpoolRequestNotQuarantined { entry: _, detail: _ } => "request_not_quarantined"
    DispatchSpoolSpoolRefused { detail: _ } => "spool_refused"
  }
}

fn dispatch_spool_outcome_disposition(o: DispatchSpoolOutcome) -> DispatchSpoolDisposition {
  match o {
    DispatchSpoolDispatched { entry: _, spawn: _ } => OutcomeRecorded
    DispatchSpoolRequestRefused { entry: _, detail: _ } => OutcomeRecorded
    DispatchSpoolAnswerWriteFailed { entry: _, detail: d } => OutcomeStopsTheLine { detail: d }
    DispatchSpoolRequestNotConsumed { entry: _, detail: d } => OutcomeStopsTheLine { detail: d }
    DispatchSpoolRequestUnreadable { entry: _, detail: d } => OutcomeStopsTheLine { detail: d }
    DispatchSpoolRequestNotQuarantined { entry: _, detail: d } => OutcomeStopsTheLine { detail: d }
    DispatchSpoolSpoolRefused { detail: d } => OutcomeStopsTheLine { detail: d }
  }
}

fn dispatch_spool_disposition_detail(d: DispatchSpoolDisposition) -> String {
  match d {
    OutcomeRecorded => ""
    OutcomeStopsTheLine { detail } => detail
  }
}

fn dispatch_spool_run_standing(outcomes: List<DispatchSpoolOutcome>) -> DispatchSpoolRunStanding {
  let stopping = filter(xs: outcomes, f: o => match dispatch_spool_outcome_disposition(o: o) {
    OutcomeRecorded => false
    OutcomeStopsTheLine { detail: _ } => true
  })
  match stopping.first() {
    Absent =>
      DispatchSpoolRunCompleted {
        answered: count(filter(xs: outcomes, f: o => match o {
          DispatchSpoolDispatched { entry: _, spawn: _ } => true
          _ => false
        })),
      }
    Present { value: first } =>
      DispatchSpoolRunStopped {
        first: dispatch_spool_outcome_key(o: first),
        more: count(stopping) - 1,
      }
  }
}

fn dispatch_spool_retire_request(
  instance_root: String,
  entry: String,
  refused: DispatchSpoolOutcome,
) -> DispatchSpoolOutcome {
  let moved = shell.Move.File(
    source: join([dispatch_request_dir(instance_root: instance_root), "/", entry], "") as FilePath,
    destination: join([dispatch_refused_dir(instance_root: instance_root), "/", entry], "") as FilePath,
  )
  if moved.success {
    refused
  } else {
    DispatchSpoolRequestNotQuarantined {
      entry: entry,
      detail: join(["the refused request could not leave the pending set: ", moved.error], ""),
    }
  }
}

fn dispatch_spool_answer_admitted(
  instance: HostDashboardInstance,
  instance_root: String,
  entry: String,
  request: DispatchSpoolRequest,
) -> DispatchSpoolOutcome {
  match request {
    DispatchSpoolDispatch { node_id, executor, executor_word } => {
      let spawn = belt_dispatch_node_for_instance_over(
        instance: instance,
        plan: roadmap_plan_projection(),
        node_id: node_id,
        request: LaunchAutonomous,
        executor: executor,
      )
      let write = Filesystem.Write(
        path: join([dispatch_answer_dir(instance_root: instance_root), "/", entry], ""),
        content: serialize_json(v: json_object(members: [
          json_kv(key: "schema", value: json_string(s: "belt-dispatch-spool-answer/v1")),
          json_kv(key: "node_id", value: json_string(s: node_id)),
          json_kv(key: "executor", value: json_string(s: executor_word)),
          json_kv(key: "spawn", value: belt_spawn_outcome_json(o: spawn)),
        ])),
      )
      if !write.success {
        dispatch_spool_retire_request(
          instance_root: instance_root,
          entry: entry,
          refused: DispatchSpoolAnswerWriteFailed { entry: entry, detail: write.error },
        )
      } else {
        let consumed = Filesystem.Delete(
          path: join([dispatch_request_dir(instance_root: instance_root), "/", entry], ""),
        )
        if consumed.success {
          DispatchSpoolDispatched { entry: entry, spawn: spawn }
        } else {
          dispatch_spool_retire_request(
            instance_root: instance_root,
            entry: entry,
            refused: DispatchSpoolRequestNotConsumed { entry: entry, detail: consumed.error },
          )
        }
      }
    }
  }
}

fn dispatch_spool_entry_outcome(
  instance: HostDashboardInstance,
  instance_root: String,
  entry: String,
) -> DispatchSpoolOutcome {
  if !ends_with(s: entry, suffix: ".json") {
    dispatch_spool_retire_request(
      instance_root: instance_root,
      entry: entry,
      refused: DispatchSpoolRequestRefused {
        entry: entry,
        detail: "dispatch spool entries must be named <key>.json",
      },
    )
  } else {
    let path = join([dispatch_request_dir(instance_root: instance_root), "/", entry], "")
    let read = Filesystem.Read(path: path)
    match filesystem_read_outcome(content: read.content, success: read.success, error: read.error) {
      FilesystemReadRefused { error } =>
        DispatchSpoolRequestUnreadable {
          entry: entry,
          detail: join(["the dispatch request could not be read: ", path, " (", error, ")"], ""),
        }
      FilesystemReadSucceeded { content } =>
        match dispatch_request_admission(entry: entry, request_text: content) {
          DispatchRequestAdmitted { request } =>
            dispatch_spool_answer_admitted(
              instance: instance,
              instance_root: instance_root,
              entry: entry,
              request: request,
            )
          DispatchRequestUndecodableDocument { reason } =>
            dispatch_spool_retire_request(
              instance_root: instance_root,
              entry: entry,
              refused: DispatchSpoolRequestRefused { entry: entry, detail: reason },
            )
          DispatchRequestHumanOnlyAction { reason } =>
            dispatch_spool_retire_request(
              instance_root: instance_root,
              entry: entry,
              refused: DispatchSpoolRequestRefused { entry: entry, detail: reason },
            )
          DispatchRequestMisaddressed { detail } =>
            dispatch_spool_retire_request(
              instance_root: instance_root,
              entry: entry,
              refused: DispatchSpoolRequestRefused { entry: entry, detail: detail },
            )
        }
    }
  }
}

fn dispatch_spool_drain_for_instance(instance: HostDashboardInstance) -> List<DispatchSpoolOutcome> {
  let instance_root = instance.instance_root as String
  let requests_dir = dispatch_request_dir(instance_root: instance_root)
  let requests = Filesystem.List(path: requests_dir)
  if !requests.success {
    [
      DispatchSpoolSpoolRefused {
        detail: join([
          "the dispatch request directory could not be listed: ",
          requests_dir, " (", requests.error, ")",
        ], ""),
      },
    ]
  } else {
    map(
      filter(xs: split(s: requests.entries, delimiter: "\n"), f: e => trim(e) != ""),
      entry => dispatch_spool_entry_outcome(
        instance: instance,
        instance_root: instance_root,
        entry: trim(entry),
      ),
    )
  }
}

fn dispatch_spool_run_json(outcomes: List<DispatchSpoolOutcome>) -> String {
  serialize_json(v: json_object(members: [
    json_kv(key: "schema", value: json_string(s: "belt-dispatch-spool-run/v1")),
    json_kv(
      key: "outcomes",
      value: json_array(elements: map(outcomes, o => json_object(members: [
        json_kv(key: "outcome", value: json_string(s: dispatch_spool_outcome_key(o: o))),
        json_kv(
          key: "detail",
          value: json_string(s: dispatch_spool_disposition_detail(
            d: dispatch_spool_outcome_disposition(o: o),
          )),
        ),
      ]))),
    ),
  ]))
}
