// THE ITEM-LEVEL GANTT ANSWER over the whole roadmap: for every roadmap node, where its estimate came from
// (AuthoredSize | AuthoredDuration | Derived | Unsized -- the four states the ruling names), what it is worth in
// working days, and its start and finish, computed AT THE READ from the prerequisite edges and the worker count it
// was given (gunbc.design_ruling::schedule_answers_are_computed_cached_and_re_read), and bound to dates by
// gunbc.roadmap.roadmap_schedule_calendar -- the same binder and the same convention the leaf grain uses, so one
// calendar answers both grains.
//
// NO SECOND SCHEDULER. Every placement decision here is the ONE core in gunbc.roadmap.roadmap_placement: this module
// builds rows and edges and reads the answer, and owns no lane choice, no ordering, no rank, no gating of its own
// (gunbc.design_argument::single_authority). The leaf-grain scheduler in gunbc.roadmap.roadmap_schedule stays the
// scheduler of decomposed items, and WHERE THE TWO GRAINS MEET is declared once, here: an item that owns pieces takes
// its WORK from the sum of its pieces' days (through gunbc.roadmap.roadmap_decomposition's own total) and its ELAPSED
// from that item's leaf-grain makespan (one call of `schedule` over its own decomposition), so no number is priced
// twice and no item is ever scheduled by two policies.
//
// WHAT IS PLACED, and why: only the nodes that OWN work -- a node carrying a current estimate, or an item whose
// decomposition declares its pieces. A node whose estimate is DERIVED from contained children is a rollup: it is
// listed with its derived total and a bar that spans the placement of the work beneath it, and it is never placed as
// a peer of its own descendants (a parent placed beside its children would spend the same days twice). Prerequisite
// edges are expanded through containment before placement, so a task waiting on a project is gated by every piece of
// work inside that project and an edge is never silently dropped for pointing at a rollup.
//
// FAIL CLOSED (gunbc.design_argument::fail_closed, and the ruling's own no-contradiction clause): a roadmap whose
// estimates contradict refuses the whole read, naming every contradiction with both sides -- an unscheduled roadmap is
// reported, never scheduled around a contradiction. A node nobody priced is LISTED as Unsized with no duration and no
// dates: never priced at zero, never defaulted to a band's floor. A row waiting on something this read could not
// price is listed as Blocked, naming what it waits on, rather than being placed at day 0 as if it were ungated.
//
// CONSUMER: the ctrl dashboard's planning timeline, per the_ctrl_dashboard_renders_the_planning_page -- it reads
// these rows (source, days, start, finish, lane, state) to draw the roadmap's bars.
module gunbc.roadmap.roadmap_item_gantt

import std.types { Bool, Int, List, Map, String }
import std.nat { Nat }
import std.optional { Optional, Present, Absent, optional_present, optional_absent }
import std.algebra { empty_map, map_insert, map_contains_key, list_push }
import std.checked_arithmetic { checked_int_to_nat }
import extdeps.units.iso8601_calendar { Iso8601CivilDate }
import gunbc.roadmap.roadmap_model { RoadmapNodeId, RoadmapNode, RoadmapEdge }
import gunbc.roadmap.roadmap_authority { declared_roadmap_nodes, declared_roadmap_edges, nid }
import gunbc.roadmap.roadmap_belt { BeltCapacity }
import gunbc.roadmap.roadmap_decomposition { WorkDecomposition, decomposition_for, expand_decomposition }
import gunbc.roadmap.roadmap_schedule { Schedule, Scheduled, NotScheduled, ScheduleRefusal, schedule, horizon_of }
import gunbc.roadmap.roadmap_schedule_calendar { bound_day_to_date }
import gunbc.roadmap.roadmap_placement {
  Placement, PlacementRow, PlacementEdge, PlacementInput, PlacementOutcome, Placed, Refused,
  PlacementAnswer, PlacementRefusal, Cyclic, Unplaced, adjacency, look_or,
}
import gunbc.roadmap.roadmap_estimate_derivation {
  EstimateSource, AuthoredSize, AuthoredDuration, Derived, Unsized, UnsizedWhy, NothingEstimated,
  EstimateContradiction, EstimateRefusal,
  estimate_contradictions, estimate_refusals, restated_piece_days, node_source, contained_children,
}
import gunbc.roadmap.roadmap_effort_estimate { EstimateEntry }

// ONE ROW OF THE GANTT: the node, where its number came from, what it is worth in working days (ABSENT when nobody
// priced it -- never a zero), and where it sits.
type GanttRow {
  node: RoadmapNodeId
  source: EstimateSource
  work_days: Optional<Int>
  state: GanttRowState
}

// WHERE A ROW SITS, in exactly the states a read can honestly answer.
//   Placed   -- a work-owning row the core placed: half-open [start_day, finish_day), its lane, and the dates those
//               days bind to at this read.
//   Rollup   -- a node whose estimate is Derived from contained children: no lane of its own (its work is placed
//               beneath it), and a bar that spans that work.
//   UnsizedRow -- nobody priced it. Listed, with no duration and no dates.
//   Blocked  -- it could be priced, but something it waits on was not: named in `behind`, so a bar is never drawn
//               from a day this read did not earn.
//   LeafGrainRefused -- the item owns pieces and its OWN leaf-grain read refused; the leaf scheduler's typed refusal
//               is carried, unaltered, because it is the authority on why.
type GanttRowState
  = Placed { start_day: Int, finish_day: Int, lane: Int, start: Iso8601CivilDate, finish: Iso8601CivilDate }
  | Rollup { start_day: Int, finish_day: Int, start: Iso8601CivilDate, finish: Iso8601CivilDate }
  | UnsizedRow { why: UnsizedWhy }
  | Blocked { behind: List<RoadmapNodeId> }
  | LeafGrainRefused { cause: ScheduleRefusal }
  // THE ARM NO READ ANSWERS, and it is named rather than defaulted: a row this read priced, did not hold out, and
  // still cannot place. It is unreachable while the core's own completeness check holds, and it exists so that state
  // is a refusal a consumer must handle instead of a bar drawn at zero.
  | UnplacedRow

// WHY THERE IS NO GANTT AT ALL. Each arm is a fact about the roadmap, not a default.
type GanttRefusal
  = ContradictionsPresent { contradictions: List<EstimateContradiction> }
  | EstimatesRefused { refusals: List<EstimateRefusal> }
  | NoWorkers { cap: BeltCapacity }
  | PrerequisitesCyclic { nodes: List<RoadmapNodeId> }
  | RowsUnplaced { nodes: List<RoadmapNodeId> }

type GanttAnswer
  = Answered {
      rows: List<GanttRow>,
      horizon: Int,
      in_flight: List<Int>,
      critical: List<RoadmapNodeId>,
    }
  | Refused { refusal: GanttRefusal }

// WHAT THE READ IS GIVEN. `workers` is the declared worker count, carried as the belt's own capacity type (the same
// one the leaf scheduler takes) so the two grains cannot disagree about what "three workers" means; `findings_count`
// is the population a decomposition's assumed-count population expands against, which only the leaf grain of an item
// with a findings population ever reads; `read_date` is the date the answer is taken at, and every date here is
// derived from it and the placed days and nothing else.
type GanttInput {
  nodes: List<RoadmapNode>
  edges: List<RoadmapEdge>
  entries: List<EstimateEntry>
  workers: BeltCapacity
  findings_count: Int
  read_date: Iso8601CivilDate
}

// THE ANSWER, computed at the read. The contradiction check runs FIRST and refuses the whole roadmap: a bar drawn
// over an estimate that contradicts its own child is not a schedule, it is a picture -- so it is reported instead
// (the ruling's clause, and the operator's 1w-over-2w case, are the witness).
fn gantt_answer(input: GanttInput) -> GanttAnswer {
  let clashes = estimate_contradictions(nodes: input.nodes, entries: input.entries)
  let malformed = concat(
    estimate_refusals(nodes: input.nodes, entries: input.entries),
    restated_piece_days(nodes: input.nodes, entries: input.entries)
  )
  if count(clashes, c => true) > 0 {
    Refused { refusal: ContradictionsPresent { contradictions: clashes } }
  } else if count(malformed, r => true) > 0 {
    Refused { refusal: EstimatesRefused { refusals: malformed } }
  } else if input.workers.max_concurrent <= 0 {
    Refused { refusal: NoWorkers { cap: input.workers } }
  } else {
    answer_priced(input: input)
  }
}

// THE PRICED READ. Nothing here re-prices: durations come from `row_days` (which reads the derivation for an authored
// row and the leaf scheduler for an item that owns pieces), and placement comes from the core.
fn answer_priced(input: GanttInput) -> GanttAnswer {
  let priced = map(input.nodes, n => PricedNode { node: n, source: node_source(nodes: input.nodes, entries: input.entries, n: n) })
  let days = map(priced, p => NodeDays { node: p.node.node, days: row_days(input: input, p: p) })
  let unplaceable = map(filter(days, d => match d.days { Absent => true, Present { value: v } => v <= 0 }), d => d.node)
  let graph = prerequisite_graph(input: input, priced: priced)
  let stuck = blocked_behind(unplaceable: unplaceable, succ: graph.succ)
  let held = concat(unplaceable, stuck)
  let rows = rows_to_place(priced: priced, days: days)
  match place(input: PlacementInput {
    rows: rows,
    edges: graph.edges,
    workers: input.workers.max_concurrent,
    preplaced: [] as List<Placement>,
    earliest_start: 0,
    held_out: held,
  }) {
    Refused { refusal: Cyclic { keys: keys } } => Refused { refusal: PrerequisitesCyclic { nodes: map(keys, k => nid(s: k)) } }
    Refused { refusal: Unplaced { keys: keys } } => Refused { refusal: RowsUnplaced { nodes: map(keys, k => nid(s: k)) } }
    Refused { refusal: _ } => Refused { refusal: RowsUnplaced { nodes: [] as List<RoadmapNodeId> } }
    Placed { answer: placed } => Answered {
      rows: map(priced, p => gantt_row(input: input, priced: priced, days: days, placed: placed, held: held, p: p)),
      horizon: placed.horizon,
      in_flight: placed.in_flight,
      critical: map(placed.critical, k => nid(s: k)),
    }
  }
}

// A NODE PAIRED WITH ITS SOURCE, once per read so the derivation is asked one question per node and never twice under
// two different names.
type PricedNode {
  node: RoadmapNode
  source: EstimateSource
}

type NodeDays {
  node: RoadmapNodeId
  days: Optional<Int>
}

// THE DURATION OF A ROW, in working days: ABSENT when this read cannot answer one, which is a state and not a zero.
// An authored row is worth what the one table says its form is worth (a size's midpoint, or the literal days). An
// item that owns pieces is worth its leaf-grain makespan -- the leaf scheduler's own horizon over its own
// decomposition, which is where the two grains meet and the only place a decomposed item's elapsed is answered.
// A rollup is not placed, so it is asked for no duration at all.
fn row_days(input: GanttInput, p: PricedNode) -> Optional<Int> {
  match p.source {
    AuthoredSize { size: _, scheduled_days: d, made: _, basis: _ } => optional_present(value: d)
    AuthoredDuration { working_days: d, made: _, basis: _ } => optional_present(value: d)
    Derived { work_days: _, contributed: _, from_pieces: pieces } => if pieces { leaf_grain_days(input: input, node: p.node.node) } else { optional_absent() }
    Unsized { why: _ } => optional_absent()
  }
}

// THE LEAF-GRAIN MEETS THE ITEM GRAIN, in one call: expand the item's own decomposition and hand it to
// `gunbc.roadmap.roadmap_schedule::schedule` with the same worker capacity the item grain was given. Its horizon IS
// the item's elapsed. When the leaf read refuses, its typed refusal is carried away unaltered -- this module never
// re-explains another module's refusal, and never invents a duration to cover for it.
type LeafGrainRead
  = Makespan { days: Int }
  | LeafReadRefused { cause: ScheduleRefusal }

fn leaf_grain_read(input: GanttInput, node: RoadmapNodeId) -> LeafGrainRead {
  match checked_int_to_nat(n: input.findings_count) {
    Absent => LeafReadRefused { cause: ConcurrencyCapInvalid { cap: input.workers } }
    Present { value: findings } => leaf_grain_expansions(input: input, node: node, findings: findings)
  }
}

// One item can carry more than one declared decomposition; its elapsed is the sum of their makespans, because they
// are separate bodies of work under the same item and no piece of either is scheduled twice. Any one of them
// refusing refuses the item's duration, carrying that leaf read's refusal.
fn leaf_grain_expansions(input: GanttInput, node: RoadmapNodeId, findings: Nat) -> LeafGrainRead {
  fold(decomposition_for(node: node), init: Makespan { days: 0 }, f: fn(acc, d) {
    match acc {
      LeafReadRefused { cause: cause } => acc
      Makespan { days: so_far } => {
        let read = read_one_decomposition(input: input, d: d, findings: findings)
        match read {
          Makespan { days: more } => Makespan { days: so_far + more }
          LeafReadRefused { cause: cause } => LeafReadRefused { cause: cause }
        }
      }
    }
  })
}

fn read_one_decomposition(input: GanttInput, d: WorkDecomposition, findings: Nat) -> LeafGrainRead {
  match schedule(d: d, e: expand_decomposition(d: d, findings_count: findings), workers: input.workers) {
    Scheduled { answer: answer } => Makespan { days: horizon_of(leaves: answer.leaves) }
    NotScheduled { refusal: refusal } => LeafReadRefused { cause: refusal }
  }
}

fn leaf_grain_days(input: GanttInput, node: RoadmapNodeId) -> Optional<Int> {
  match leaf_grain_read(input: input, node: node) {
    Makespan { days: d } => if d > 0 { optional_present(value: d) } else { optional_absent() }
    LeafReadRefused { cause: _ } => optional_absent()
  }
}

// THE ROWS THE CORE IS GIVEN: the nodes that own work and have a duration. A rollup is not among them, and an
// unsized or blocked node is filtered again inside the core through `held_out` -- it is named there rather than
// placed and dropped, so it can never leave lane occupancy or a gate behind.
fn rows_to_place(priced: List<PricedNode>, days: List<NodeDays>) -> List<PlacementRow> {
  flat_map(priced, p => match days_of(days: days, node: p.node.node) {
    Present { value: d } => [PlacementRow { key: p.node.node as String, days: d }]
    Absent => [] as List<PlacementRow>
  })
}

fn days_of(days: List<NodeDays>, node: RoadmapNodeId) -> Optional<Int> {
  match first(filter(days, d => d.node == node)) {
    Present { value: found } => found.days
    Absent => optional_absent()
  }
}

// THE PREREQUISITE GRAPH THE CORE READS, with every edge expanded through containment: a task that waits on a
// project waits on every piece of work that project contains, and an edge that pointed only at a rollup would
// otherwise be dropped by the core as an already-done predecessor -- which is exactly the silent ungating this pass
// exists to prevent. Prerequisites order work; they never contain it, and no edge here is ever read upward as a
// price (gunbc.design_ruling::estimates_are_one_representation_derived_upward).
type PrerequisiteGraph {
  edges: List<PlacementEdge>
  succ: Map<String, List<PlacementRow>>
  pred: Map<String, List<PlacementRow>>
}

fn prerequisite_graph(input: GanttInput, priced: List<PricedNode>) -> PrerequisiteGraph {
  let expanded = flat_map(input.edges, e => {
    flat_map(expand_to_work(input: input, priced: priced, target: e.parent), from =>
      map(expand_to_work(input: input, priced: priced, target: e.child), to => PlacementEdge { from: from, to: to })
    )
  })
  let graph = adjacency(rows: map(priced, p => PlacementRow { key: p.node.node as String, days: 0 }), edges: expanded)
  PrerequisiteGraph { edges: expanded, succ: graph.succ, pred: graph.pred }
}

// WHICH WORK A PREREQUISITE REFERS TO: itself when it owns work, and every piece of work contained under it when it
// is a rollup. A node that owns no work and contains no work answers with nothing, and the edge that pointed at it is
// then an edge to nothing -- the core drops it, and `blocked_behind` is what names the row that was waiting.
fn expand_to_work(input: GanttInput, priced: List<PricedNode>, target: RoadmapNodeId) -> List<String> {
  match node_in(priced: priced, target: target) {
    Absent => [] as List<String>
    Present { value: p } => if owns_work(p: p) {
      [target as String]
    } else {
      map(work_under(input: input, priced: priced, root: p.node), n => n.node as String)
    }
  }
}

fn owns_work(p: PricedNode) -> Bool {
  match p.source {
    AuthoredSize { size: _, scheduled_days: _, made: _, basis: _ } => true
    AuthoredDuration { working_days: _, made: _, basis: _ } => true
    Derived { work_days: _, contributed: _, from_pieces: pieces } => pieces
    Unsized { why: _ } => false
  }
}

fn node_in(priced: List<PricedNode>, target: RoadmapNodeId) -> Optional<PricedNode> {
  match first(filter(priced, p => p.node.node == target)) {
    Present { value: p } => optional_present(value: p)
    Absent => optional_absent()
  }
}

// EVERY WORK-OWNING NODE CONTAINED UNDER `root`, by the same containment the derivation follows: in_project
// membership, and nothing else. Prerequisite edges are never walked here -- an edge orders siblings, it does not
// contain them (the ruling's boundary, and the reason two sequential tasks each keep their own price).
fn work_under(input: GanttInput, priced: List<PricedNode>, root: RoadmapNode) -> List<RoadmapNode> {
  under(input: input, priced: priced, current: root, seen: [])
}

fn under(input: GanttInput, priced: List<PricedNode>, current: RoadmapNode, seen: List<String>) -> List<RoadmapNode> {
  if any(seen, s => s == (current.node as String)) {
    [] as List<RoadmapNode>
  } else {
    let kids = contained_children(nodes: input.nodes, parent: current.node)
    let here = if owns_own_work(input: input, priced: priced, n: current) { [current] } else { [] as List<RoadmapNode> }
    concat(here, flat_map(kids, k => match node_in(priced: priced, target: k.node) {
      Absent => [] as List<RoadmapNode>
      Present { value: p } => under(input: input, priced: priced, current: p.node, seen: list_push(xs: seen, item: current.node as String))
    }))
  }
}

// Does this node own work of its own (a row it carries, or pieces it declares)? Asked of a node the read already
// paired with a source, so the answer is the same one `owns_work` gives and never a second opinion.
fn owns_own_work(input: GanttInput, priced: List<PricedNode>, n: RoadmapNode) -> Bool {
  match node_in(priced: priced, target: n.node) {
    Absent => false
    Present { value: p } => owns_work(p: p)
  }
}

// WHICH ROWS CANNOT BE PLACED because something they wait on cannot: the closure over the prerequisite successors of
// the unpriceable rows. It is ONE walk of the graph from a named frontier (a queue that visits each row once), not a
// re-scan of every edge per row -- the quadratic shape gunbc.design_argument::how_to_work fixes at the root.
fn blocked_behind(unplaceable: List<RoadmapNodeId>, succ: Map<String, List<PlacementRow>>) -> List<RoadmapNodeId> {
  let no_rows: List<PlacementRow> = []
  closure(queue: map(unplaceable, n => n as String), seen: empty_map(), visited: [] as List<String>, succ: succ, no_rows: no_rows)
}

fn closure(queue: List<String>, seen: Map<String, Bool>, visited: List<String>, succ: Map<String, List<PlacementRow>>, no_rows: List<PlacementRow>) -> List<RoadmapNodeId> {
  match queue {
    Empty => map(visited, k => nid(s: k))
    Cons { head: k, tail: rest } => if map_contains_key(m: seen, key: k) {
      closure(queue: rest, seen: seen, visited: visited, succ: succ, no_rows: no_rows)
    } else {
      let next = fold(look_or(m: succ, key: k, dflt: no_rows), init: rest, g: fn(q, s) { list_push(xs: q, item: s.key) })
      closure(queue: next, seen: map_insert(m: seen, key: k, value: true), visited: list_push(xs: visited, item: k), succ: succ, no_rows: no_rows)
    }
  }
}

// THE ROW, assembled from the core's answer and the calendar's binder. Every arm of the source is matched by name --
// a new source state cannot arrive here and be silently drawn as a bar.
fn gantt_row(input: GanttInput, priced: List<PricedNode>, days: List<NodeDays>, placed: PlacementAnswer, held: List<RoadmapNodeId>, p: PricedNode) -> GanttRow {
  let key = p.node.node as String
  let behind = waiting_on(input: input, priced: priced, placed: placed, held: held, target: p.node.node)
  GanttRow {
    node: p.node.node,
    source: p.source,
    work_days: if owns_work(p: p) { days_of(days: days, node: p.node.node) } else { optional_absent() },
    state: row_state(input: input, priced: priced, placed: placed, behind: behind, p: p, key: key),
  }
}

// WHICH UNPLACED PREREQUISITES THIS ROW WAITS ON, named. Only a row that would otherwise be placed is asked, so an
// unsized row keeps its own honest Unsized answer instead of borrowing someone else's reason.
fn waiting_on(input: GanttInput, priced: List<PricedNode>, placed: PlacementAnswer, held: List<RoadmapNodeId>, target: RoadmapNodeId) -> List<RoadmapNodeId> {
  let prereqs = flat_map(input.edges, e => if e.child == target {
    expand_to_work(input: input, priced: priced, target: e.parent)
  } else {
    [] as List<String>
  })
  map(filter(prereqs, k => any(held, h => h as String == k)), k => nid(s: k))
}

fn row_state(input: GanttInput, priced: List<PricedNode>, placed: PlacementAnswer, behind: List<RoadmapNodeId>, p: PricedNode, key: String) -> GanttRowState {
  match find_placement(placed: placed, key: key) {
    Present { value: row } => Placed {
      start_day: row.start_day,
      finish_day: row.finish_day,
      lane: row.lane,
      start: bound_day_to_date(read_date: input.read_date, day: row.start_day),
      finish: bound_day_to_date(read_date: input.read_date, day: row.finish_day),
    }
    Absent => rollup_or_refusal(input: input, priced: priced, placed: placed, behind: behind, p: p)
  }
}

fn find_placement(placed: PlacementAnswer, key: String) -> Optional<Placement> {
  match first(filter(placed.rows, r => r.key == key)) {
    Present { value: r } => optional_present(value: r)
    Absent => optional_absent()
  }
}

// THE STATES THAT ARE NOT A PLACED BAR, in the order a reader should see them: a leaf-grain refusal (an item whose
// own pieces refused, carrying the leaf scheduler's reason), then an unsized node, then a row gated by something
// unplacable, then a rollup spanning the work beneath it.
fn rollup_or_refusal(input: GanttInput, priced: List<PricedNode>, placed: PlacementAnswer, behind: List<RoadmapNodeId>, p: PricedNode) -> GanttRowState {
  match p.source {
    Derived { work_days: _, contributed: _, from_pieces: pieces } => if pieces {
      leaf_refusal_state(input: input, node: p.node.node)
    } else {
      rollup_bar(input: input, priced: priced, placed: placed, behind: behind, p: p)
    }
    AuthoredSize { size: _, scheduled_days: _, made: _, basis: _ } => blocked_or_unplaced(behind: behind)
    AuthoredDuration { working_days: _, made: _, basis: _ } => blocked_or_unplaced(behind: behind)
    Unsized { why: why } => UnsizedRow { why: why }
  }
}

fn blocked_or_unplaced(behind: List<RoadmapNodeId>) -> GanttRowState {
  if count(behind, b => true) > 0 {
    Blocked { behind: behind }
  } else {
    UnplacedRow
  }
}

// THE LEAF-GRAIN REFUSAL, re-read from the SAME call the duration came from: the leaf scheduler's own typed refusal,
// carried unaltered. It is never paraphrased into a duration and never rounded down to a bar of zero days.
fn leaf_refusal_state(input: GanttInput, node: RoadmapNodeId) -> GanttRowState {
  match leaf_grain_read(input: input, node: node) {
    LeafReadRefused { cause: cause } => LeafGrainRefused { cause: cause }
    Makespan { days: _ } => UnplacedRow
  }
}

// THE ROLLUP BAR: a derived node is drawn over the placement of the work it contains -- its first day is the earliest
// day any of that work starts and its last is the latest any of it finishes. It spends no days of its own and holds
// no lane, which is what keeps a parent's number and its children's numbers one fact and not two.
fn rollup_bar(input: GanttInput, priced: List<PricedNode>, placed: PlacementAnswer, behind: List<RoadmapNodeId>, p: PricedNode) -> GanttRowState {
  let spanned = map(filter(placed.rows, r => any(work_under(input: input, priced: priced, root: p.node), w => w.node as String == r.key)), r => r)
  if count(spanned, r => true) == 0 {
    blocked_or_unplaced(behind: behind)
  } else {
    let first_day = earliest_start_of(spanned: spanned)
    let last_day = latest_finish_of(spanned: spanned)
    Rollup {
      start_day: first_day,
      finish_day: last_day,
      start: bound_day_to_date(read_date: input.read_date, day: first_day),
      finish: bound_day_to_date(read_date: input.read_date, day: last_day),
    }
  }
}

fn earliest_start_of(spanned: List<Placement>) -> Int {
  fold(spanned, init: 0, f: fn(m, r) { if r.start_day < m { r.start_day } else { m } })
}

fn latest_finish_of(spanned: List<Placement>) -> Int {
  fold(spanned, init: 0, f: fn(m, r) { if r.finish_day > m { r.finish_day } else { m } })
}

// ============================== THE LIVE READ ==============================

// THE LIVE ANSWER over the declared roadmap, at a declared worker count and read date. Nothing here is authored
// beside the graph: the entries it prices with are the appended estimate stream (empty on this branch until the
// sizing lane appends rows), and the dates come from the read date and the placed days alone.
fn gantt_answer_live(workers: BeltCapacity, findings_count: Int, read_date: Iso8601CivilDate) -> GanttAnswer {
  gantt_answer(input: GanttInput {
    nodes: declared_roadmap_nodes(),
    edges: declared_roadmap_edges(),
    entries: [] as List<EstimateEntry>,
    workers: workers,
    findings_count: findings_count,
    read_date: read_date,
  })
}

// THE ROWS ONLY, for a consumer that draws bars and nothing else.
fn gantt_rows(a: GanttAnswer) -> List<GanttRow> {
  match a {
    Answered { rows: rows, horizon: _, in_flight: _, critical: _ } => rows
    Refused { refusal: _ } => [] as List<GanttRow>
  }
}

// THE REFUSAL ONLY, so a consumer can report why there is no picture rather than drawing an empty one.
fn gantt_refusal(a: GanttAnswer) -> Optional<GanttRefusal> {
  match a {
    Answered { rows: _, horizon: _, in_flight: _, critical: _ } => optional_absent()
    Refused { refusal: refusal } => optional_present(value: refusal)
  }
}

// HOW MANY ROWS THIS READ COULD NOT PRICE -- the count the dashboard shows beside the picture, so an unsized node is
// never invisible and never silently defaulted.
fn gantt_unpriced_count(a: GanttAnswer) -> Int {
  count(gantt_rows(a: a), r => match r.state {
    UnsizedRow { why: _ } => true
    Blocked { behind: _ } => true
    LeafGrainRefused { cause: _ } => true
    UnplacedRow => true
    Placed { start_day: _, finish_day: _, lane: _, start: _, finish: _ } => false
    Rollup { start_day: _, finish_day: _, start: _, finish: _ } => false
  })
}
