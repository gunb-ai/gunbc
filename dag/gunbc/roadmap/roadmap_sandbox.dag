// The sandbox gallery is a UI fixture that never spawns (its click echoes a wire exemplar from
// /sandbox); its rows carry a SYNTHETIC admitted launch so the operable button exists to press.
// This is a fixture value for the pressable gallery only -- no production surface reads it, and the
// identity names the sandbox as its instance so it cannot be mistaken for a served admission.

fn sandbox_launch_admission(node_id: String) -> LaunchAdmission {
  LaunchAdmitted { identity: LaunchIdentity {
    node_id: node_id as NonEmptyStr as RoadmapNodeId,
    cause: Operator,
    mode: ManualReady,
    instance_id: "sandbox" as NonEmptyStr,
    revision: launch_identity_null_revision(),
  } }
}

// The /sandbox design surface (P4): the register at every depth plus every component in every
// state, all DERIVED from the same authorities the live surfaces use, so the sandbox is a faithful
// mirror, never a hand mock. Roles are shown under BOTH themes at once (literal material paints
// inline — the one place a literal color is right, because it is DISPLAYING the role->material
// authority under two projections simultaneously, which var(--role) cannot do). The component
// gallery renders dispatch_button_component's states one-for-one; the terminal instances are
// exactly the wire vocabulary (totality is the P0 property, re-witnessed here as gallery coverage).
// The live section is one pressable instance per wire arm that POSTs /sandbox/echo?status=LABEL and
// renders through the SAME client program the real button uses — so every state is exercisable
// without dispatching a session, and the sandbox cannot drift from production render.

fn sandbox_rules() -> List<BuildRule> {
  [
    StaticRule { selector: ClassSelector { name: "sandbox" }, decls: [
      decl(prop: Padding, value: scale_pair(a: space_16, b: space_24)),
      decl(prop: MaxWidth, value: scale_var(t: measure_page)),
    ] },
    StaticRule { selector: RawSelector { text: ".sandbox section" }, decls: [
      decl(prop: MarginBottom, value: scale_var(t: space_24)),
    ] },
    StaticRule { selector: RawSelector { text: ".sandbox-strip-lab .activity-round-strip" }, decls: [
      decl(prop: Height, value: "18px"),
      decl(prop: BorderRadius, value: "4px"),
    ] },
    StaticRule { selector: ClassSelector { name: "strip-lab-label" }, decls: [
      decl(prop: Display, value: "block"),
      decl(prop: MarginTop, value: scale_var(t: space_16)),
      decl(prop: Opacity, value: "0.75"),
    ] },
    StaticRule { selector: ClassSelector { name: "swatch-row" }, decls: [
      decl(prop: Display, value: "flex"),
      decl(prop: AlignItems, value: "center"),
      decl(prop: Gap, value: scale_var(t: space_6)),
      decl(prop: MarginBottom, value: scale_var(t: space_2)),
    ] },
    StaticRule { selector: ClassSelector { name: "swatch" }, decls: [
      decl(prop: Display, value: "inline-block"),
      decl(prop: Width, value: scale_var(t: space_24)),
      decl(prop: Height, value: scale_var(t: space_24)),
      decl(prop: BorderRadius, value: scale_var(t: radius_3)),
      decl(prop: Border, value: scale_border(w: border_1, color_var: "var(--border)")),
    ] },
    StaticRule { selector: ClassSelector { name: "role-name" }, decls: [
      decl(prop: FontFamily, value: scale_var(t: font_mono)),
      decl(prop: FontSize, value: scale_var(t: text_12)),
      role_decl(prop: Color, r: TextRole),
    ] },
    StaticRule { selector: ClassSelector { name: "role-var" }, decls: [
      decl(prop: FontFamily, value: scale_var(t: font_mono)),
      decl(prop: FontSize, value: scale_var(t: text_12)),
      role_decl(prop: Color, r: TextDimRole),
    ] },
    StaticRule { selector: ClassSelector { name: "token-row" }, decls: [
      decl(prop: Display, value: "flex"),
      decl(prop: Gap, value: scale_var(t: space_8)),
      decl(prop: FontFamily, value: scale_var(t: font_mono)),
      decl(prop: FontSize, value: scale_var(t: text_12)),
      role_decl(prop: Color, r: TextDimRole),
    ] },
    StaticRule { selector: ClassSelector { name: "gallery-row" }, decls: [
      decl(prop: Display, value: "flex"),
      decl(prop: Gap, value: scale_var(t: space_8)),
      decl(prop: FlexWrap, value: "wrap"),
      decl(prop: AlignItems, value: "baseline"),
    ] },
    StaticRule { selector: ClassSelector { name: "gallery-cell" }, decls: [
      decl(prop: Display, value: "flex"),
      decl(prop: FlexDirection, value: "column"),
      decl(prop: AlignItems, value: "center"),
      decl(prop: Gap, value: scale_var(t: space_2)),
    ] },
    StaticRule { selector: ClassSelector { name: "gallery-arm" }, decls: [
      decl(prop: FontFamily, value: scale_var(t: font_mono)),
      decl(prop: FontSize, value: scale_var(t: text_10)),
      role_decl(prop: Color, r: TextDimRole),
    ] },
    StaticRule { selector: ClassSelector { name: "auditioner-bar" }, decls: [
      decl(prop: Display, value: "flex"),
      decl(prop: Gap, value: scale_var(t: space_4)),
      decl(prop: AlignItems, value: "center"),
      decl(prop: Margin, value: scale_triple(a: space_3, b: space_0, c: space_3)),
    ] },
    StaticRule { selector: ClassSelector { name: "band-chip" }, decls: [
      decl(prop: Display, value: "inline-block"),
      decl(prop: FontFamily, value: scale_var(t: font_mono)),
      decl(prop: FontSize, value: scale_var(t: text_10)),
      decl(prop: Padding, value: scale_pair(a: space_1, b: space_6)),
      decl(prop: BorderRadius, value: scale_var(t: radius_3)),
    ] },
  ]
}

// The three fixture frames simulate the falsifier's declared viewports (wide 1680 / medium 1024 /
// narrow 480) as max-width containers so the operator reads all three compositions on one screen
// without resizing. The px literals are DIAGNOSTIC viewport dimensions, not design lengths — they
// name external screen widths, which is why they do not route through gunbc.design.scale (whose
// tokens are the page's own spatial vocabulary); the untokened-length census scopes to
// roadmap_instance_rules() and these sandbox-only rules are its declared out-of-scope neighbor.

fn fixture_frame_rules() -> List<BuildRule> {
  [
    StaticRule { selector: RawSelector { text: ".sandbox-work-row" }, decls: [
      decl(prop: MaxWidth, value: "none"),
    ] },
    StaticRule { selector: ClassSelector { name: "fixture-frame" }, decls: [
      decl(prop: Border, value: scale_border(w: border_1, color_var: "var(--border)")),
      decl(prop: Padding, value: scale_var(t: space_8)),
      decl(prop: MarginBottom, value: scale_var(t: space_16)),
    ] },
    StaticRule { selector: ClassSelector { name: "fixture-wide" }, decls: [
      decl(prop: MaxWidth, value: "1680px"),
    ] },
    StaticRule { selector: ClassSelector { name: "fixture-medium" }, decls: [
      decl(prop: MaxWidth, value: "1024px"),
    ] },
    StaticRule { selector: ClassSelector { name: "fixture-narrow" }, decls: [
      decl(prop: MaxWidth, value: "480px"),
    ] },
  ]
}

fn sandbox_css() -> String {
  join([roadmap_css(), serialize_rules(rules: concat(sandbox_rules(), fixture_frame_rules()))], "\n")
}

fn role_swatch(theme: Theme, role: ThemeRole) -> Fragment {
  Element {
    tag: "span",
    attributes: [
      attr(name: "class", value: "swatch" ),
      attr(name: "style", value: join(["background: ", paint(m: assignment_material(t: theme, r: role))], "") ),
      attr(name: "title", value: join([theme.name, " ", role_key(r: role)], "") ),
    ],
    children: [],
  }
}

fn role_row(role: ThemeRole) -> Fragment {
  el_class("div", "swatch-row", [
    role_swatch(theme: night_theme, role: role),
    role_swatch(theme: day_theme, role: role),
    el_class("span", "role-name", [ txt(role_key(r: role)) ]),
    el_class("span", "role-var", [ txt(role_var(r: role)) ]),
  ])
}

fn roles_section() -> Fragment {
  el_class("section", "sandbox-roles",
    concat([ el("h2", [ txt("roles — night / day") ]) ],
      map(theme_roles, r => role_row(role: r))))
}

fn scale_token_row(t: ScaleToken) -> Fragment {
  el_class("div", "token-row", [
    el_class("span", "token-name", [ txt(t.name) ]),
    el_class("span", "token-value", [ txt(scale_value_wire(v: t.value)) ]),
  ])
}

fn scale_group(label: String, tokens: List<ScaleToken>) -> Fragment {
  el_class("div", "scale-group",
    concat([ el_class("h3", "group-label", [ txt(label) ]) ],
      map(tokens, t => scale_token_row(t: t))))
}

fn scales_section() -> Fragment {
  el_class("section", "sandbox-scales", [
    el("h2", [ txt("scales") ]),
    scale_group(label: "spacing", tokens: spacing_scale),
    scale_group(label: "type", tokens: type_scale),
    scale_group(label: "font", tokens: font_stack),
    scale_group(label: "dimension", tokens: dimension_scale),
  ])
}

fn gallery_states() -> List<ComponentState> {
  concat([dispatch_idle_state, dispatch_requested_state], dispatch_button_terminal_states())
}

// The caption collapse (W1d) makes band phrases the button text, so two refusal arms wear the same
// caption — CORRECT for the operator, ambiguous for a specimen sheet. The gallery is the diagnostic
// surface, so each cell carries the ARM identity as a sublabel under the instance (state.key, which
// for terminals IS the wire label — the same authority the coverage witness reads), and the live
// cells mirror it. The caption channel stays operator-vocabulary everywhere; the wire vocabulary
// survives only in the sublabel and title channels, where diagnosis lives.

// The auditioner's live preview (W1f visibility fix, operator report 2026-07-24: 'the swatches
// button doesn't seem to do anything' — the toggle worked, proven by execution in a DOM-stub
// harness, but nothing NEAR it consumed the band vars; the roles section beside it paints theme
// literals by design). Five chips filled from var(--band-*) sit beside the control, so a set flip
// repaints the strip in the same glance that clicked it. Keys derive from workspace_band_paints —
// the chip strip cannot drift from the band vocabulary.

fn band_chip(key: String) -> Fragment {
  Element {
    tag: "span",
    attributes: [
      attr(name: "class", value: "band-chip" ),
      attr(name: "style", value: join(["background: var(--band-", key, "); color: var(--band-", key, "-ink)"], "") ),
    ],
    children: [ txt(key) ],
  }
}

fn gallery_cell(button: Fragment, arm: String) -> Fragment {
  el_class("div", "gallery-cell", [ button, el_class("span", "gallery-arm", [ txt(arm) ]) ])
}

fn gallery_instance(state: ComponentState) -> Fragment {
  let cls = dispatch_state_class(state: state)
  let full = if cls == "" { "dispatch-btn" } else { join(["dispatch-btn ", cls], "") }
  gallery_cell(
    button: Element {
      tag: "button",
      attributes: [
        attr(name: "class", value: full ),
        attr(name: "type", value: "button" ),
        attr(name: "disabled", value: "" ),
      ],
      children: [ txt(dispatch_state_display_text(state: state)) ],
    },
    arm: state.key,
  )
}

fn gallery_section() -> Fragment {
  el_class("section", "sandbox-gallery", [
    el("h2", [ txt("dispatch button — every state (static)") ]),
    el_class("div", "gallery-row", map(gallery_states(), s => gallery_instance(state: s))),
  ])
}

fn live_instance(wire_label: String) -> Fragment {
  gallery_cell(
    button: el_attrs("button", [
      attr(name: "class", value: join(["dispatch-btn ", sandbox_live_class], "") ),
      attr(name: "type", value: "button" ),
      attr(name: "data-status", value: wire_label ),
    ], [ txt(dispatch_caption_idle) ]),
    arm: wire_label,
  )
}

fn live_section() -> Fragment {
  el_class("section", "sandbox-live", [
    el("h2", [ txt("live — press to exercise each wire arm (POST /sandbox/echo)") ]),
    el_class("div", "gallery-row", map(belt_dispatch_all_status_labels(), l => live_instance(wire_label: l))),
  ])
}

// The A2 composition fixture (operator blocker 6): the falsifier specimen row — long headline,
// seven obligations with Environment/Workspace/Agent complete, session-present/process-exited
// evidence, four remaining — rendered by the REAL render_work_row at the three declared falsifier
// widths, plus the refused-arm specimen with its located reason. Server-rendered from constructed
// views, so the operator critiques the exact production composition without live data, and a seam
// or renderer change moves these frames in the same deploy that moves the dashboard.

fn fixture_specimen_segments() -> List<WorkflowSegment> {
  [
    WorkflowSegment { kind: EnvironmentWorkflowSegment, state: WorkflowSegmentComplete, detail: "admission receipt readable" },
    WorkflowSegment { kind: WorkspaceWorkflowSegment, state: WorkflowSegmentComplete, detail: "worktree created" },
    WorkflowSegment { kind: AgentWorkflowSegment, state: WorkflowSegmentComplete, detail: "turn.completed and process exit 0" },
    WorkflowSegment { kind: VerificationWorkflowSegment, state: WorkflowSegmentPending, detail: "" },
    WorkflowSegment { kind: PublicationWorkflowSegment, state: WorkflowSegmentPending, detail: "" },
    WorkflowSegment { kind: ReviewWorkflowSegment, state: WorkflowSegmentPending, detail: "" },
    WorkflowSegment { kind: GoalAuditWorkflowSegment, state: WorkflowSegmentPending, detail: "" },
  ]
}

// A LEDGER WITH THE SHAPE THE STRIP EXISTS TO SHOW: two long read rounds and one short write, so the
// specimen paints as most of a bar of dim time ending in a bright sliver. The numbers are a fixture,
// not a transcription of any run; the shape is the one measured on 2026-09-04, where a worker spent
// twenty-one rounds reading and wrote at round twenty-two.
fn fixture_long_ledger() -> HarnessRoundLedger {
  RoundsObserved { rounds: [
    RoundObservation { step: 1, input_tokens: 2200, output_tokens: 157, epoch_ms: 1000000, files_changed: Present { value: 0 }, tool_calls: none },
    RoundObservation { step: 2, input_tokens: 3500, output_tokens: 194, epoch_ms: 1009000, files_changed: Present { value: 0 }, tool_calls: Present { value: 0 } },
    RoundObservation { step: 3, input_tokens: 4800, output_tokens: 231, epoch_ms: 1069000, files_changed: Present { value: 0 }, tool_calls: none },
    RoundObservation { step: 4, input_tokens: 6100, output_tokens: 268, epoch_ms: 1189000, files_changed: Present { value: 0 }, tool_calls: none },
    RoundObservation { step: 5, input_tokens: 7400, output_tokens: 305, epoch_ms: 1234000, files_changed: Present { value: 0 }, tool_calls: none },
    RoundObservation { step: 6, input_tokens: 8700, output_tokens: 342, epoch_ms: 1249000, files_changed: Present { value: 0 }, tool_calls: none },
    RoundObservation { step: 7, input_tokens: 10000, output_tokens: 379, epoch_ms: 1429000, files_changed: Present { value: 0 }, tool_calls: none },
    RoundObservation { step: 8, input_tokens: 11300, output_tokens: 416, epoch_ms: 1459000, files_changed: Present { value: 0 }, tool_calls: none },
    RoundObservation { step: 9, input_tokens: 12600, output_tokens: 453, epoch_ms: 1549000, files_changed: Present { value: 0 }, tool_calls: Present { value: 0 } },
    RoundObservation { step: 10, input_tokens: 13900, output_tokens: 490, epoch_ms: 1569000, files_changed: Present { value: 0 }, tool_calls: none },
    RoundObservation { step: 11, input_tokens: 15200, output_tokens: 127, epoch_ms: 1809000, files_changed: Present { value: 0 }, tool_calls: none },
    RoundObservation { step: 12, input_tokens: 16500, output_tokens: 164, epoch_ms: 1844000, files_changed: Present { value: 0 }, tool_calls: none },
    RoundObservation { step: 13, input_tokens: 17800, output_tokens: 201, epoch_ms: 1904000, files_changed: Present { value: 0 }, tool_calls: none },
    RoundObservation { step: 14, input_tokens: 19100, output_tokens: 238, epoch_ms: 1916000, files_changed: Present { value: 0 }, tool_calls: none },
    RoundObservation { step: 15, input_tokens: 20400, output_tokens: 275, epoch_ms: 2066000, files_changed: Present { value: 0 }, tool_calls: Present { value: 0 } },
    RoundObservation { step: 16, input_tokens: 21700, output_tokens: 312, epoch_ms: 2091000, files_changed: Present { value: 0 }, tool_calls: none },
    RoundObservation { step: 17, input_tokens: 23000, output_tokens: 349, epoch_ms: 2131000, files_changed: Present { value: 0 }, tool_calls: none },
    RoundObservation { step: 18, input_tokens: 24300, output_tokens: 386, epoch_ms: 2149000, files_changed: Present { value: 0 }, tool_calls: none },
    RoundObservation { step: 19, input_tokens: 25600, output_tokens: 423, epoch_ms: 2219000, files_changed: Present { value: 1 }, tool_calls: none },
    RoundObservation { step: 20, input_tokens: 26900, output_tokens: 460, epoch_ms: 2269000, files_changed: Present { value: 1 }, tool_calls: none },
    RoundObservation { step: 21, input_tokens: 28200, output_tokens: 497, epoch_ms: 2291000, files_changed: Present { value: 1 }, tool_calls: none },
    RoundObservation { step: 22, input_tokens: 29500, output_tokens: 134, epoch_ms: 2386000, files_changed: Present { value: 2 }, tool_calls: none },
