fn strip_lab_row(label: String, ledger: HarnessRoundLedger, live: Bool) -> Fragment {
  el_class("div", "strip-lab-row", concat(
    [ el_class("span", "strip-lab-label", [ txt(label) ]) ],
    round_strip_nodes(ledger: ledger, live: live)))
}

fn round_strip_lab_section() -> Fragment {
  el_class("section", strip_lab_section_class, [
    el("h2", [ txt("round strip — percolator (the last segment pulses while the attempt is active)") ]),
    el_class("div", "strip-lab-controls", [
      el_attrs("button", [ attr(name: "type", value: "button"), attr(name: "class", value: strip_lab_replay_class) ], [ txt("replay") ]),
      el_attrs("button", [ attr(name: "type", value: "button"), attr(name: "class", value: strip_lab_slow_class) ], [ txt("slow: off") ]),
    ]),
    strip_lab_row(label: "moseying · 4 rounds, wrote at round 4 · active", ledger: fixture_moseying_ledger(), live: true),
    strip_lab_row(label: "long research then write · 24 rounds, wrote at 19 and 22 · active", ledger: fixture_long_ledger(), live: true),
    strip_lab_row(label: "same 24 rounds · finished, no pulse", ledger: fixture_long_ledger(), live: false),
  ])
}

fn fixture_moseying_ledger() -> HarnessRoundLedger {
  RoundsObserved { rounds: [
    RoundObservation { step: 1, input_tokens: 900, output_tokens: 120, epoch_ms: 1000000, files_changed: Present { value: 0 }, tool_calls: none },
    RoundObservation { step: 2, input_tokens: 9000, output_tokens: 260, epoch_ms: 1120000, files_changed: Present { value: 0 }, tool_calls: none },
    RoundObservation { step: 3, input_tokens: 14000, output_tokens: 180, epoch_ms: 1210000, files_changed: Present { value: 0 }, tool_calls: none },
    RoundObservation { step: 4, input_tokens: 16000, output_tokens: 2100, epoch_ms: 1225000, files_changed: Present { value: 1 }, tool_calls: none },
  ] }
}

fn fixture_specimen_view(node_id: String, activity: ActivityView, rounds: HarnessRoundLedger, worker_alive: Bool) -> WorkRowView {
  WorkRowView {
    node_id: node_id,
    headline: "Record which generator actually produced each result",
    summary: none,
    lifecycle: OpenLifecycle,
    scheduling: SchedulingReady,
    superseded_by: "",
    activity: activity,
    action: action_view(lifecycle: OpenLifecycle, admission: sandbox_launch_admission(node_id: node_id)),
    supporting_facts: [],
    disclosure: NoDisclosure,
    rounds: rounds,
    worker_alive: worker_alive,
  }
}

fn fixture_active_view() -> WorkRowView {
  fixture_specimen_view(node_id: "sandbox-specimen-active", rounds: fixture_moseying_ledger(), activity: activity_view_from_parts(
    segments: fixture_specimen_segments(),
    remaining: 4,
    process: WorkerProcessExited { exit_code: 0, last_command: "codex" },
    throughput: ThroughputUnobserved { reason: "sandbox fixture models no provider event stream" as NonEmptyStr },
    current_activity: "Worked for 6m 34s"), worker_alive: true)
}

fn fixture_refused_view() -> WorkRowView {
  fixture_specimen_view(node_id: "sandbox-specimen-refused", rounds: RoundsUnobserved { reason: "refused specimen has no rounds" as NonEmptyStr }, activity: activity_view_from_parts(
    segments: [
      WorkflowSegment { kind: EnvironmentWorkflowSegment, state: WorkflowSegmentComplete, detail: "" },
      WorkflowSegment { kind: AgentWorkflowSegment, state: WorkflowSegmentRefused, detail: "turn.completed with process unobserved: no exit was established" },
    ],
    remaining: 6,
    process: WorkerProcessExited { exit_code: 0, last_command: "codex" },
    throughput: ThroughputUnobserved { reason: "sandbox fixture models no provider event stream" as NonEmptyStr },
    current_activity: ""), worker_alive: false)
}

fn fixture_row_li(view: WorkRowView) -> Fragment {
  Element {
    tag: "li",
    attributes: node_li_attributes(view: view),
    children: render_work_row(view: view),
  }
}

fn fixture_frame(label: String, cls: String) -> Fragment {
  el_class("div", join(["fixture-frame ", cls], ""), [
    el_class("h3", "group-label", [ txt(label) ]),
    el("ul", [
      fixture_row_li(view: fixture_active_view()),
      fixture_row_li(view: fixture_refused_view()),
    ]),
  ])
}

fn work_row_fixture_section() -> Fragment {
  el_class("section", "sandbox-work-row", [
    el("h2", [ txt("work row — falsifier specimen at three widths (static)") ]),
    fixture_frame(label: "wide · 1680", cls: "fixture-wide"),
    fixture_frame(label: "medium · 1024", cls: "fixture-medium"),
    fixture_frame(label: "narrow · 480", cls: "fixture-narrow"),
  ])
}

// The A3 composition fixture (the #7589 deferred receipt): one declared family rendered by the REAL
// grouping path — band_entries folds the constructed rows against the typed
// WorkFamilyDecl/WorkFamilyMemberFact facts, workspace_entries_ul paints the result — so the
// exhibit shows exactly what production shows: the family claim stated once in the group head with
// the member count, member rows carrying only their subjects (the full headline is provably absent
// — the subject swap runs through family_subject_row, not a display trick), and an undeclared
// neighbour row keeping its own headline outside the group. All rows are routine (OpenLifecycle +
// SchedulingReady + NoActiveWork), so the frame also exhibits the A3 chip collapse: no open chips,
// no hollow activity. Constructed views rather than the live closing-contract family, for the same
// reason the A2 fixture constructs its specimen: the exhibit must stay byte-stable across roadmap
// edits so the three width frames compare composition, not data drift.

fn fixture_ready_view(node_id: String, headline: String) -> WorkRowView {
  WorkRowView {
    node_id: node_id,
    headline: headline,
    summary: none,
    lifecycle: OpenLifecycle,
    scheduling: SchedulingReady,
    superseded_by: "",
    activity: NoActiveWork,
    action: action_view(lifecycle: OpenLifecycle, admission: sandbox_launch_admission(node_id: node_id)),
    supporting_facts: [],
    disclosure: NoDisclosure,
    rounds: RoundsUnobserved { reason: "fixture models no provider event stream" as NonEmptyStr },
    worker_alive: false,
  }
}

fn fixture_family_decl() -> WorkFamilyDecl {
  WorkFamilyDecl {
    id: "sandbox-family",
    claim: "Every startable node carries a closing contract",
  }
}

fn fixture_family_members() -> List<WorkFamilyMemberFact> {
  [
    WorkFamilyMemberFact { family_id: "sandbox-family", task_node: "sandbox-family-a", subject: "dag_compile_clean_gate" },
    WorkFamilyMemberFact { family_id: "sandbox-family", task_node: "sandbox-family-b", subject: "affected_set_falsifier" },
    WorkFamilyMemberFact { family_id: "sandbox-family", task_node: "sandbox-family-c", subject: "regen_floor_skip_witness" },
  ]
}

fn fixture_family_rows() -> List<WorkRowView> {
  [
    fixture_ready_view(node_id: "sandbox-family-a", headline: "Declare the closing contract for dag_compile_clean_gate"),
    fixture_ready_view(node_id: "sandbox-family-b", headline: "Declare the closing contract for affected_set_falsifier"),
    fixture_ready_view(node_id: "sandbox-family-c", headline: "Declare the closing contract for regen_floor_skip_witness"),
    fixture_ready_view(node_id: "sandbox-neighbour", headline: "Record which generator actually produced each result"),
  ]
}

fn family_fixture_frame(label: String, cls: String) -> Fragment {
  el_class("div", join(["fixture-frame ", cls], ""), [
    el_class("h3", "group-label", [ txt(label) ]),
    workspace_entries_ul(
      entries: band_entries(
        rows: fixture_family_rows(),
        families: [fixture_family_decl()],
        members: fixture_family_members(),
      ),
      observation: ObservationsNominal,
    ),
  ])
}

fn family_fixture_section() -> Fragment {
  el_class("section", "sandbox-family-fixture", [
    el("h2", [ txt("family grouping — claim stated once, members carry subjects (static)") ]),
    family_fixture_frame(label: "wide · 1680", cls: "fixture-wide"),
    family_fixture_frame(label: "medium · 1024", cls: "fixture-medium"),
    family_fixture_frame(label: "narrow · 480", cls: "fixture-narrow"),
  ])
}

// ONE CONTEXTUAL ENTRY, ON THE PAGE WHERE STUDIES LIVE, rather than three raw links in every shared
// header (review ruling, 2026-08-06). A header nav put development routes on the daily workspace
// and the roadmap, where they are noise to everyone not building the instrument. The sandbox is
// already the page for studies, so the labs belong here with a sentence saying what each one is for
// — and the rows come from gunbc.roadmap_component.instrument_lab_links, the same declaration the
// router builds its route specs from, so a link that resolves nowhere is caught by execution rather
// than by clicking.

fn instrument_lab_entry(l: InstrumentLabLink) -> Fragment {
  el("li", [ el_attrs("a", [ attr(name: "href", value: l.path) ], [ txt(l.label) ]) ])
}

fn instrument_labs_section() -> Fragment {
  el("section", [
    el("h2", [ txt("instrument labs") ]),
    el("ul", map(instrument_lab_links, l => instrument_lab_entry(l: l))),
  ])
}

fn sandbox_page() -> Fragment {
  Element {
    tag: "html",
    attributes: [],
    children: [
      el("head", [
        Element { tag: "meta", attributes: [ attr(name: "charset", value: "utf-8" ) ], children: [] },
        el("style", [ txt(sandbox_css()) ]),
        el("title", [ txt("gunbc — sandbox") ]),
      ]),
      el("body", [
        roadmap_header(page: "sandbox"),
        el_class("div", "auditioner-bar", concat(
          [ el_attrs("button", [
              attr(name: "class", value: swatch_toggle_class ),
              attr(name: "type", value: "button" ),
            ], []) ],
          map(workspace_band_paints(), p => band_chip(key: p.key)))),
        el_class("main", "sandbox", [
          round_strip_lab_section(),
          instrument_labs_section(),
          roles_section(),
          scales_section(),
          gallery_section(),
          live_section(),
          work_row_fixture_section(),
          family_fixture_section(),
        ]),
        Element {
          tag: "script",
          attributes: [
            attr(name: "src", value: sandbox_asset_path ),
            attr(name: "defer", value: "" ),
          ],
          children: [],
        },
      ]),
    ],
  }
}

fn sandbox_gallery_terminal_labels() -> List<String> {
  map(component_terminal_states(c: dispatch_button_component()), s => s.key)
}
