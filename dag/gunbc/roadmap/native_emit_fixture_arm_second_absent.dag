module gunbc.roadmap.native_emit_fixture_arm_second_absent

// THROWAWAY diagnostic fixture (roadmap node://adhoc-aade5300-c0e demand-serve-program-image, R4). NOT for
// merge -- the CONTROL to native_emit_fixture_arm_first_absent. Same fn, ARMS SWAPPED: the FIRST arm is the
// TYPED optional and the bare `Absent {}` is the SECOND arm. If the emitter types the `if` from its first
// arm, THIS module emits cleanly (first arm carries the NonEmptyStr element type), so a clean emit here +
// a refusal in the first_absent sibling CONFIRMS the hypothesis (an emitter defect). Same environment as
// runner_slot_retirement (Optional/Absent/Present prelude-provided).
import std.types { String, Bool, NonEmptyStr }

data fixture_opt: Optional<NonEmptyStr> = Present { value: "fixture-reason" as NonEmptyStr }

// FIRST arm is the typed optional; the bare `Absent {}` is the SECOND arm. Hypothesis says this one TYPES
// correctly from the first arm -> Optional<NonEmptyStr>.
fn arms_second_absent(b: Bool) -> Optional<NonEmptyStr> {
  if b { fixture_opt } else { Absent {} }
}

fn use_arms_second_absent(b: Bool) -> String {
  let p = arms_second_absent(b: b)
  match p {
    Absent {} => "none"
    Present { value: v } => v as String
  }
}

data fixture_emit_hook_second: String = use_arms_second_absent(b: true)
