module gunbc.roadmap.roadmap_supervisor

import std.types { String, Int, NonEmptyStr }
import std.optional { Present, Absent }
import extdeps.languages.json.emit {
  JsonValue, JsonNull, JsonBool, JsonString, JsonNumber, JsonArray, JsonObject,
  json_string,
  json_int,
  json_object,
  json_kv,
  serialize_json,
}
import extdeps.languages.json.parse {
  parse_json_document,
  JsonDocumentParsed,
  JsonDocumentUnreadable,
  json_document_gap_text,
  json_object_unique_member, JsonMemberFound, JsonMemberAbsent, JsonMemberDuplicated, JsonMemberNotAnObject,
}

// THE SUPERVISOR DECIDES INSIDE THE PAUSED SESSION (gunbc.plans.harness_session_lifecycle,
// requirements 2 and 9). It is convened by the alignment check when the check needs a broader
// decision than a steer, the worker's session waits for it, and its verdict is one of the actions
// that session can carry out and no other: Continue renews the round on stated evidence; Steer
// continues after one direction the worker receives verbatim; PlanDefect and Stuck stop the session
// with their typed cause. A verdict the session cannot execute is advice, and the stretch-restart
// supervisor this replaces showed what that costs: its Nominal could change neither the budget nor
// the next brief (F65). This module is the one authority for the vocabulary and its codec.
type SupervisorVerdict
  = VerdictContinue { basis: String }
  | VerdictSteer { direction: String }
  | VerdictPlanDefect { defect: String }
  | VerdictStuck { cause: String }

// THE RECEIPT BINDS THE TURN IT ADJUDICATED. Each boundary convenes its own supervisor with its
// own verdict path, and the session reads the receipt's adjudicated turn against its own: a verdict
// for any other turn decides nothing, so a stale or copied file is inert.
type SupervisorVerdictReceipt {
  adjudicated_turn: Int
  verdict: SupervisorVerdict
}

// THE SCHEMA IS A WALL, on the same precedent as the submission artifact: a document whose schema
// is not exactly this string is refused, so a future shape cannot be silently read as this one.
// v2: the routes became executable session actions and the receipt lost its attempt key, which the
// verdict's own path under the attempt's state directory now carries.
data supervisor_verdict_schema: NonEmptyStr = "roadmap-supervisor-verdict/v2" as NonEmptyStr

fn supervisor_verdict_route_key(verdict: SupervisorVerdict) -> String {
  match verdict {
    VerdictContinue { basis: _ } => "continue"
    VerdictSteer { direction: _ } => "steer"
    VerdictPlanDefect { defect: _ } => "plan-defect"
    VerdictStuck { cause: _ } => "stuck"
  }
}

fn supervisor_verdict_statement(verdict: SupervisorVerdict) -> String {
  match verdict {
    VerdictContinue { basis } => basis
    VerdictSteer { direction } => direction
    VerdictPlanDefect { defect } => defect
    VerdictStuck { cause } => cause
  }
}

fn supervisor_verdict_from_route_key(key: String, statement: String) -> SupervisorVerdict? {
  if key == "continue" {
    Present { value: VerdictContinue { basis: statement } }
  } else if key == "steer" {
    Present { value: VerdictSteer { direction: statement } }
  } else if key == "plan-defect" {
    Present { value: VerdictPlanDefect { defect: statement } }
  } else if key == "stuck" {
    Present { value: VerdictStuck { cause: statement } }
  } else {
    none
  }
}

fn supervisor_verdict_json(receipt: SupervisorVerdictReceipt) -> JsonValue {
  json_object(members: [
    json_kv(key: "schema", value: json_string(s: supervisor_verdict_schema as String)),
    json_kv(key: "adjudicated_turn", value: json_int(n: receipt.adjudicated_turn)),
    json_kv(key: "route", value: json_string(s: supervisor_verdict_route_key(verdict: receipt.verdict))),
    json_kv(key: "statement", value: json_string(s: supervisor_verdict_statement(verdict: receipt.verdict))),
  ])
}

fn supervisor_verdict_text(receipt: SupervisorVerdictReceipt) -> String {
  serialize_json(v: supervisor_verdict_json(receipt: receipt))
}

type SupervisorVerdictDecode
  = VerdictDecoded { receipt: SupervisorVerdictReceipt }
  | VerdictNotDecodable { reason: String }

fn supervisor_member_text(doc: JsonValue, key: String) -> String? {
  match json_object_unique_member(v: doc, key: key) {
    JsonMemberFound { value: JsonString { value: s } } => Present { value: s }
    JsonMemberFound { value: JsonNull } => none
    JsonMemberFound { value: JsonBool { value: _ } } => none
    JsonMemberFound { value: JsonNumber { lexeme: _ } } => none
    JsonMemberFound { value: JsonArray { elements: _ } } => none
    JsonMemberFound { value: JsonObject { members: _ } } => none
    JsonMemberAbsent => none
    JsonMemberDuplicated { count: _ } => none
    JsonMemberNotAnObject => none
  }
}

fn supervisor_member_int(doc: JsonValue, key: String) -> Int? {
  match json_object_unique_member(v: doc, key: key) {
    JsonMemberFound { value: JsonNumber { lexeme: lx } } => parse_int(s: lx as String)
    JsonMemberFound { value: JsonNull } => none
    JsonMemberFound { value: JsonBool { value: _ } } => none
    JsonMemberFound { value: JsonString { value: _ } } => none
    JsonMemberFound { value: JsonArray { elements: _ } } => none
    JsonMemberFound { value: JsonObject { members: _ } } => none
    JsonMemberAbsent => none
    JsonMemberDuplicated { count: _ } => none
    JsonMemberNotAnObject => none
  }
}

fn supervisor_verdict_member_gap(key: String) -> SupervisorVerdictDecode {
  VerdictNotDecodable { reason: join(["the supervisor verdict's ", key, " member is absent, duplicated or of the wrong type"], "") }
}

fn supervisor_verdict_decode_document(doc: JsonValue) -> SupervisorVerdictDecode {
  match supervisor_member_text(doc: doc, key: "schema") {
    Absent => supervisor_verdict_member_gap(key: "schema")
    Present { value: schema } =>
      if schema != (supervisor_verdict_schema as String) {
        VerdictNotDecodable {
          reason: join(["supervisor verdict schema is ", schema, ", not ", supervisor_verdict_schema as String], ""),
        }
      } else {
        match supervisor_member_int(doc: doc, key: "adjudicated_turn") {
          Absent => supervisor_verdict_member_gap(key: "adjudicated_turn")
          Present { value: adjudicated_turn } =>
            match supervisor_member_text(doc: doc, key: "route") {
              Absent => supervisor_verdict_member_gap(key: "route")
              Present { value: route } =>
                match supervisor_member_text(doc: doc, key: "statement") {
                  Absent => supervisor_verdict_member_gap(key: "statement")
                  Present { value: statement } =>
                    match supervisor_verdict_from_route_key(key: route, statement: statement) {
                      Absent =>
                        VerdictNotDecodable {
                          reason: join(["supervisor verdict route is ", route, ", which is not continue, steer, plan-defect or stuck"], ""),
                        }
                      Present { value: verdict } =>
                        VerdictDecoded { receipt: SupervisorVerdictReceipt { adjudicated_turn: adjudicated_turn, verdict: verdict } }
                    }
                }
            }
        }
      }
  }
}

fn supervisor_verdict_decode(text: String) -> SupervisorVerdictDecode {
  match parse_json_document(s: text) {
    JsonDocumentUnreadable { gap } =>
      VerdictNotDecodable {
        reason: concat("the supervisor verdict is ", json_document_gap_text(gap: gap)),
      }
    JsonDocumentParsed { value: doc } => supervisor_verdict_decode_document(doc: doc)
  }
}
