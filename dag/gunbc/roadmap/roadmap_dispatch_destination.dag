// A dispatch's destination is a per-NODE fact. The slug is a String: "gunbc" or owner/name.
// It is read from the node's WorkItemDispatch: destination_from_dispatch matches Dispatchable,
// whose repo slug is the destination, against NotDispatchable, which has none. The resolver
// itself did not change when #10994 unbundled the carrier -- only what the fold reads did.
// Sizing is no longer part of this question at all: a node's destination never depended on
// intricacy or volume, which is precisely why the unbundling could separate them.
//
// THIS MODULE NAMES NO PRIVATE REPOSITORY. A node whose work lives elsewhere supplies its
// own owner/name via the repo slug; the public authority only knows gunbc_repository as an
// observed Repository. A slug does not carry privacy or default branch: those are GitHub
// facts (extdeps.github.github.Repository). This path does not call that API.

type DestinationPrivacyStanding
  = DestinationPrivacyObserved { private: Bool }
  | DestinationPrivacyUnobserved

type DestinationDefaultBranchStanding
  = DestinationDefaultBranchObserved { branch: String }
  | DestinationDefaultBranchUnobserved

type DestinationIdentity {
  owner: String
  name: String
  full_name: String
  privacy: DestinationPrivacyStanding
  default_branch: DestinationDefaultBranchStanding
}

type DispatchDestination
  = DispatchDestinationResolved { identity: DestinationIdentity }
  | DispatchDestinationMissing { reason: NonEmptyStr }

fn gunbc_destination_slug_matches(repo: String) -> Bool {
  repo == gunbc_repository.name || repo == gunbc_repository.full_name
}

fn gunbc_destination_identity() -> DestinationIdentity {
  DestinationIdentity {
    owner: gunbc_repository.owner,
    name: gunbc_repository.name,
    full_name: gunbc_repository.full_name,
    privacy: DestinationPrivacyObserved { private: gunbc_repository.private },
    default_branch: DestinationDefaultBranchObserved { branch: gunbc_repository.default_branch },
  }
}

fn named_destination_identity_from_owner_name(owner: String, name: String) -> DestinationIdentity {
  DestinationIdentity {
    owner: owner,
    name: name,
    full_name: join([owner, "/", name], ""),
    privacy: DestinationPrivacyUnobserved,
    default_branch: DestinationDefaultBranchUnobserved,
  }
}

fn destination_is_known_public(identity: DestinationIdentity) -> Bool {
  match identity.privacy {
    DestinationPrivacyObserved { private } => !private
    DestinationPrivacyUnobserved => false
  }
}

// Owner and name on a named destination ARE observed from the slug. Privacy and default
// branch are not. destination_is_known_public reads Unobserved as not known to be public.
// RoadmapPublicationSubject.repository is still a GitHub Repository (Bool/String, no
// Unobserved arm). A fill would encode an unobserved fact as an established one (DESIGN §5).
// The publication path therefore refuses: DestinationGithubRepositoryUnobserved, consumed as
// PublicationSubjectUnobserved. Do not mint a Repository for Unobserved standing.

type DestinationGithubRepository
  = DestinationGithubRepositoryObserved { repository: Repository }
  | DestinationGithubRepositoryUnobserved { reason: NonEmptyStr }

fn destination_github_repository(identity: DestinationIdentity) -> DestinationGithubRepository {
  match identity.privacy {
    DestinationPrivacyUnobserved =>
      DestinationGithubRepositoryUnobserved {
        reason: join([
          "destination ",
          identity.full_name,
          " has no observed privacy standing, so a publication subject cannot encode GitHub Repository.private",
        ], "") as NonEmptyStr,
      }
    DestinationPrivacyObserved { private } =>
      match identity.default_branch {
        DestinationDefaultBranchUnobserved =>
          DestinationGithubRepositoryUnobserved {
            reason: join([
              "destination ",
              identity.full_name,
              " has no observed default branch, so a publication subject cannot encode GitHub Repository.default_branch",
            ], "") as NonEmptyStr,
          }
        DestinationDefaultBranchObserved { branch } =>
          DestinationGithubRepositoryObserved {
            repository: Repository {
              owner: identity.owner,
              name: identity.name,
              full_name: identity.full_name,
              private: private,
              default_branch: branch,
            },
          }
      }
  }
}

fn destination_slug_not_owner_name(slug: String) -> DispatchDestination {
  DispatchDestinationMissing {
    reason: join([
      "destination slug ",
      slug,
      " is not owner/name, so it cannot become a publication repository",
    ], "") as NonEmptyStr,
  }
}

fn repository_from_repo_slug(repo: String) -> DispatchDestination {
  let slug = trim(repo)
  if slug == "" {
    DispatchDestinationMissing {
      reason: "the node declares an empty destination slug, so there is no repository to publish to" as NonEmptyStr,
    }
  } else if gunbc_destination_slug_matches(repo: slug) {
    DispatchDestinationResolved { identity: gunbc_destination_identity() }
  } else {
    let segments = split(s: slug, delimiter: "/") |> map(p => trim(p)) |> filter(p => p != "")
    if count(segments) != 2 {
      destination_slug_not_owner_name(slug: slug)
    } else {
      match segments.first() {
        Absent => destination_slug_not_owner_name(slug: slug)
        Present { value: owner } => match segments.skip(n: 1).first() {
          Absent => destination_slug_not_owner_name(slug: slug)
          Present { value: name } =>
            DispatchDestinationResolved {
              identity: named_destination_identity_from_owner_name(owner: owner, name: name),
            }
        }
      }
    }
  }
}

fn destination_from_dispatch(dispatch: WorkItemDispatch) -> DispatchDestination {
  match dispatch {
    NotDispatchable =>
      DispatchDestinationMissing {
        reason: "the node carries no dispatch binding, so it has no destination repository" as NonEmptyStr,
      }
    Dispatchable { repo, acceptance: _ } =>
      repository_from_repo_slug(repo: repo)
  }
}

fn node_dispatch_destination(node: RoadmapNode) -> DispatchDestination {
  destination_from_dispatch(dispatch: node.dispatch)
}

// Destination identity and spawn actuation are different facts. repository_from_repo_slug
// resolves any well-formed owner/name so publication can name that repository. This
// instance still creates worktrees in instance.repo_root against dispatch_git_remote_ref
// (gunbc_merge_target_ref). Admitting a resolved non-gunbc destination onto that tree
// would work in gunbc and publish elsewhere — DESIGN section 5 widen. Until spawn binds
// worktree and remote to the destination, actuation is only the known-public gunbc tree.
// TRIGGER to retire this refuse: worktree-add and the merge remote are taken from the
// node's destination, not from the instance gunbc constants.

fn destination_is_this_spawn_tree(identity: DestinationIdentity) -> Bool {
  identity.full_name == gunbc_repository.full_name
    && destination_is_known_public(identity: identity)
}

fn destination_not_this_spawn_tree_reason(identity: DestinationIdentity) -> NonEmptyStr {
  join(
    [
      "this instance creates attempts in the public gunbc tree at ",
      gunbc_repository.full_name,
      "; destination ",
      identity.full_name,
      " is not that tree, so dispatch refuses rather than working in gunbc and publishing to ",
      identity.full_name,
    ],
    "",
  ) as NonEmptyStr
}

// Recorded at spawn so an attempt can later say which repository and which exact base
// revision it was branched from. The instance's dispatch_base_ref is a name; the SHA
// is the fact. Privacy and default branch are recorded as standings, not as GitHub
// Repository fields, so an unobserved destination cannot mint private:true in this file.

type DispatchSpawnOrigin {
  identity: DestinationIdentity
  base_ref: NonEmptyStr
  base_sha: NonEmptyStr
}

fn spawn_origin_is_public_gunbc(origin: DispatchSpawnOrigin) -> Bool {
  destination_is_this_spawn_tree(identity: origin.identity)
}

fn destination_privacy_json_members(privacy: DestinationPrivacyStanding) -> List<JsonKeyValue> {
  match privacy {
    DestinationPrivacyObserved { private } =>
      [
        json_kv(key: "privacy", value: json_string(s: "observed")),
        json_kv(key: "private", value: json_bool(b: private)),
      ]
    DestinationPrivacyUnobserved =>
      [json_kv(key: "privacy", value: json_string(s: "unobserved"))]
  }
}

fn destination_default_branch_json_members(
  standing: DestinationDefaultBranchStanding,
) -> List<JsonKeyValue> {
  match standing {
    DestinationDefaultBranchObserved { branch } =>
      [
        json_kv(key: "default_branch_standing", value: json_string(s: "observed")),
        json_kv(key: "default_branch", value: json_string(s: branch)),
      ]
    DestinationDefaultBranchUnobserved =>
      [json_kv(key: "default_branch_standing", value: json_string(s: "unobserved"))]
  }
}

fn dispatch_spawn_origin_json_value(origin: DispatchSpawnOrigin) -> JsonValue {
  json_object(
    members: concat(
      [json_kv(key: "repository", value: json_string(s: origin.identity.full_name))],
      concat(
        destination_privacy_json_members(privacy: origin.identity.privacy),
        concat(
          destination_default_branch_json_members(standing: origin.identity.default_branch),
          [
            json_kv(
              key: "known_public_gunbc",
              value: json_bool(b: spawn_origin_is_public_gunbc(origin: origin)),
            ),
            json_kv(key: "base_ref", value: json_string(s: origin.base_ref as String)),
            json_kv(key: "base_sha", value: json_string(s: origin.base_sha as String)),
          ],
        ),
      ),
    ),
  )
}

fn dispatch_spawn_origin_json(origin: DispatchSpawnOrigin) -> String {
  serialize_json(v: dispatch_spawn_origin_json_value(origin: origin))
}

data dispatch_spawn_origin_basename: String = "spawn-destination.json"

// Relocated unchanged from strategy.public_gunbc_dependency at gunbc-private 32d7a145e96f8442aa818c971bf552ba640a75cd,
// together with public_revision_standing_text. The private owner replaces its definition with
// imports when #60 recuts onto this public revision (bright-boar-435 authorization 2026-09-14).
// The neighbouring private CommitSha carrier is deliberately not relocated: GitObjectId owns
// revision validity. The seal and its identity use this authority's total projection, following
// strategy.plan_item_dispatch's finding-2 repair, rather than matching standing arms themselves.
type PublicRevisionStanding
  = AdmittedGreen { witnesses_run: NonEmptyStr, observed_on: NonEmptyStr }
  | AdmittedDespiteRed { witnesses_run: NonEmptyStr, observed_on: NonEmptyStr, red_cause: NonEmptyStr, why_unreachable: NonEmptyStr, revisit_when: NonEmptyStr }

fn public_revision_standing_text(s: PublicRevisionStanding) -> String {
  match s {
    AdmittedGreen { witnesses_run: r, observed_on: o } => join(["green: ", r as String, ", observed ", o as String], "")
    AdmittedDespiteRed { witnesses_run: r, observed_on: o, red_cause: c, why_unreachable: w, revisit_when: v } =>
      join(["admitted despite red: ", r as String, ", observed ", o as String, "; cause: ", c as String, "; why it cannot reach this composition: ", w as String, "; revisit when: ", v as String], "")
  }
}

// The actor and date record an admission act, as RoadmapAcceptanceReceipt records acceptance.
// They are nonempty attribution text, not an authentication or calendar-validity claim.
// Revision inputs must come through the Git authority's validating constructors; absent or
// unreadable inputs stay absent at admit_attempt_subject and refuse with the node and field.
type AdmittedBaseRevision {
  revision: GitObjectId
  admitted_by: NonEmptyStr
  admitted_on: NonEmptyStr
}

type AdmittedPublicRevision {
  revision: GitObjectId
  standing: PublicRevisionStanding
}

// This is what an attempt was admitted AGAINST, not whether a node is dispatchable (#10994's
// WorkItemDispatch). The destination owns publication and its default branch; the admitted base
// owns the starting revision in that destination; public_revision pins the public dependency
// of the validation composition. These can be different repositories and different revisions.
// WorkItemExecutionContract remains the only authored contract. Admission reads its four
// fields directly: there is no independent contract parameter beside execution. Each sealed_*
// field is a HISTORICAL snapshot of that contract half, exactly as the revision standing is,
// not a second current execution contract. The composition half is sealed_source_roots; the
// judgment and touch halves are sealed_validations, sealed_path_scope, and
// sealed_extra_capabilities. Reading the current owner's contract on both sides would erase a
// contract move. These snapshots add the temporal facts the live owner cannot supply after it
// changes. They must never answer what the CURRENT contract is; the join compares sealed
// history against new admission from the current WorkItemExecutionContract, never current
// against itself. publication and acceptance_kind are not fields of WorkItemExecutionContract
// or of this subject; they are not sealed here.
type AttemptAdmissionSubject {
  node: RoadmapNodeIdentity
  destination: DestinationIdentity
  base: AdmittedBaseRevision
  public_revision: AdmittedPublicRevision
  sealed_validations: List<ValidationOperation>
  sealed_extra_capabilities: List<ExecutionCapability>
  sealed_path_scope: AttemptPathScope
  sealed_source_roots: ClaimSourceRootLayout
}

type AttemptSubjectRefusal
  = AttemptSubjectInputMissing { field: NonEmptyStr }
  | AttemptSubjectRevisionInvalid { field: NonEmptyStr }
  | AttemptSubjectDestinationUnobserved { reason: NonEmptyStr }
  | AttemptSubjectSealStale { field: NonEmptyStr, sealed: String, current: String }

type AttemptSubjectAdmission
  = AttemptSubjectAdmitted { subject: AttemptAdmissionSubject }
  | AttemptSubjectRefused { node: RoadmapNodeIdentity, cause: AttemptSubjectRefusal }

// Public executing route: test.claim.attempt_admission_subject_witness_test calls admission,
// identity and join through the same functions the consumers will import. This establishes
// runtime refusal only, not private production consumption or an unforgeable record constructor.
// The frontier covers the types above and the mint/field/identity/join functions below.
// census_closure_frontier_row_groups enrolls these rows for dissolution_census to fold.
data attempt_admission_subject_frontier_rows: List<FrontierRow> = [frontier_row_decl(
  ref: decl_ref(module_path: "gunbc.roadmap_dispatch_destination", decl_name: "AttemptAdmissionSubject"),
  reason: "The sealed subject is executed by public witnesses. No public production attempt currently stores or reads the sealed contract fields; gunbc-private#60 finding 4 is the named later consumer, after its coordinated recut, not in this closure",
  dissolution: unbound_dissolution(
    description: "gunbc-private#60 finding 4 recuts strategy.plan_item_dispatch to store AttemptAdmissionSubject as its durable admitted subject, consume sealed_validations, sealed_path_scope and sealed_extra_capabilities for grant/oracle/publication identity, import PublicRevisionStanding and public_revision_standing_text instead of defining them, derive contract identity from attempt_admission_subject_fields, and join through join_attempt_subject. The public belt follow-up binds worktree creation and publication to this subject's destination and admitted base, persists the subject at admission, and reads it at verify. A witness-only caller or a rendered parallel string contract does not satisfy this production trigger"
  ),
)]

fn admit_attempt_subject(
  node: RoadmapNodeIdentity,
  destination: DispatchDestination,
  base: AdmittedBaseRevision?,
  public_revision: GitObjectId?,
  public_standing: PublicRevisionStanding?,
  execution: WorkItemExecutionContract,
) -> AttemptSubjectAdmission {
  match destination {
    DispatchDestinationMissing { reason } =>
      AttemptSubjectRefused { node: node, cause: AttemptSubjectDestinationUnobserved { reason: reason } }
    DispatchDestinationResolved { identity } =>
      match base {
        Absent => AttemptSubjectRefused { node: node, cause: AttemptSubjectInputMissing { field: "base_revision" } }
        Present { value: admitted_base } =>
          match public_revision {
            Absent => AttemptSubjectRefused { node: node, cause: AttemptSubjectInputMissing { field: "public_revision" } }
            Present { value: revision } =>
              match public_standing {
                Absent => AttemptSubjectRefused { node: node, cause: AttemptSubjectInputMissing { field: "public_revision_standing" } }
                Present { value: standing } =>
                  match execution {
                    ExecutionContractUnspecified => AttemptSubjectRefused { node: node, cause: AttemptSubjectInputMissing { field: "execution_contract" } }
                    NotAgentWork { mode: _ } => AttemptSubjectRefused { node: node, cause: AttemptSubjectInputMissing { field: "agent_execution_contract" } }
                    ExecutionContract { validations, extra_capabilities, path_scope, source_roots } =>
                      validate_attempt_subject(subject: AttemptAdmissionSubject {
                        node: node,
                        destination: identity,
                        base: admitted_base,
                        public_revision: AdmittedPublicRevision { revision: revision, standing: standing },
                        sealed_validations: validations,
                        sealed_extra_capabilities: extra_capabilities,
                        sealed_path_scope: path_scope,
                        sealed_source_roots: source_roots,
                      })
                  }
              }
          }
      }
  }
}

// A nominal GitObjectId is not validation evidence: dynamic casts can still construct raw
// digests. Re-enter the existing family-tagged Git decoder, which calls git_sha1_object_id or
// git_sha256_object_id, at BOTH mint and join. Do not normalize or trust the incoming family.
fn validate_attempt_subject(subject: AttemptAdmissionSubject) -> AttemptSubjectAdmission {
  match destination_github_repository(identity: subject.destination) {
    DestinationGithubRepositoryUnobserved { reason } =>
      AttemptSubjectRefused { node: subject.node, cause: AttemptSubjectDestinationUnobserved { reason: reason } }
    DestinationGithubRepositoryObserved { repository } =>
      if trim(repository.owner) == "" || trim(repository.name) == ""
        || trim(repository.full_name) == "" || trim(repository.default_branch) == "" {
        AttemptSubjectRefused {
          node: subject.node,
          cause: AttemptSubjectDestinationUnobserved { reason: "the destination carries empty repository or default-branch text" },
        }
      } else { match parse_git_object_id_wire(raw: render_git_object_id_wire(oid: subject.base.revision)) {
        Absent => AttemptSubjectRefused { node: subject.node, cause: AttemptSubjectRevisionInvalid { field: "base_revision" } }
        Present { value: base } =>
          match parse_git_object_id_wire(raw: render_git_object_id_wire(oid: subject.public_revision.revision)) {
            Absent => AttemptSubjectRefused { node: subject.node, cause: AttemptSubjectRevisionInvalid { field: "public_revision" } }
            Present { value: revision } =>
              AttemptSubjectAdmitted { subject: AttemptAdmissionSubject {
                node: subject.node,
                destination: subject.destination,
                base: AdmittedBaseRevision { revision: base, admitted_by: subject.base.admitted_by, admitted_on: subject.base.admitted_on },
                public_revision: AdmittedPublicRevision { revision: revision, standing: subject.public_revision.standing },
                sealed_validations: subject.sealed_validations,
                sealed_extra_capabilities: subject.sealed_extra_capabilities,
                sealed_path_scope: subject.sealed_path_scope,
                sealed_source_roots: subject.sealed_source_roots,
              } }
          }
      } }
  }
}

// The single field projection feeds both identity and stale-seal comparison. JSON encodes field
// and array boundaries; joining argv with spaces would conflate distinct root arguments. Git's
// existing family-tagged wire projection retains SHA-1 versus SHA-256 in both paths. The key is
// a structural fingerprint, not cryptographic evidence; admission compares the fields themselves.
fn attempt_admission_subject_fields(subject: AttemptAdmissionSubject) -> List<JsonKeyValue> {
  [
    json_kv(key: "node", value: json_string(s: subject.node as String)),
    json_kv(key: "destination", value: json_object(members: concat(
      [
        json_kv(key: "owner", value: json_string(s: subject.destination.owner)),
        json_kv(key: "name", value: json_string(s: subject.destination.name)),
        json_kv(key: "full_name", value: json_string(s: subject.destination.full_name)),
      ],
      concat(
        destination_privacy_json_members(privacy: subject.destination.privacy),
        destination_default_branch_json_members(standing: subject.destination.default_branch),
      ),
    ))),
    json_kv(key: "base_revision", value: json_string(s: render_git_object_id_wire(oid: subject.base.revision))),
    json_kv(key: "admitted_by", value: json_string(s: subject.base.admitted_by as String)),
    json_kv(key: "admitted_on", value: json_string(s: subject.base.admitted_on as String)),
    json_kv(key: "public_revision", value: json_string(s: render_git_object_id_wire(oid: subject.public_revision.revision))),
    json_kv(key: "public_revision_standing", value: json_string(s: public_revision_standing_text(s: subject.public_revision.standing))),
    json_kv(key: "validations", value: json_array(elements: subject.sealed_validations |> map(v => validation_operation_identity_json(validation: v)))),
    json_kv(key: "extra_capabilities", value: json_array(elements: subject.sealed_extra_capabilities |> map(c => execution_capability_identity_json(capability: c)))),
    json_kv(key: "path_scope", value: attempt_path_scope_identity_json(scope: subject.sealed_path_scope)),
    json_kv(key: "source_roots", value: json_array(elements: claim_source_root_args(layout: subject.sealed_source_roots) |> map(arg => json_string(s: arg)))),
  ]
}

fn attempt_admission_subject_identity(subject: AttemptAdmissionSubject) -> Fnv1a64Structural {
  content_hash_atom(value: serialize_json(v: json_object(members: attempt_admission_subject_fields(subject: subject))) as NonEmptyStr)
}

// current is the admission result of newly read inputs, never a second read of globals standing
// in for the stored seal. Missing/unreadable current inputs refuse before the join. Both field
// lists come from the same total projection; a changed field retains its location and both values.
fn compare_attempt_subject_fields(
  sealed: AttemptAdmissionSubject,
  current: AttemptSubjectAdmission,
) -> AttemptSubjectAdmission {
  match current {
    AttemptSubjectRefused { node, cause } => AttemptSubjectRefused { node: node, cause: cause }
    AttemptSubjectAdmitted { subject } =>
      let sealed_fields = attempt_admission_subject_fields(subject: sealed)
      let current_fields = attempt_admission_subject_fields(subject: subject)
      let differences = current_fields |> filter(field => !any(sealed_fields, prior =>
        prior.key == field.key && serialize_json(v: prior.value) == serialize_json(v: field.value)))
      match differences.first() {
        Absent => AttemptSubjectAdmitted { subject: sealed }
        Present { value: field } =>
          AttemptSubjectRefused {
            node: sealed.node,
            cause: AttemptSubjectSealStale {
              field: field.key as NonEmptyStr,
              sealed: serialize_json(v: json_object(members: sealed_fields |> filter(prior => prior.key == field.key))),
              current: serialize_json(v: json_object(members: [field])),
            },
          }
      }
  }
}

// Revalidate both records at acceptance as well as at mint: public record constructors cannot
// be treated as a proof that these values came through admit_attempt_subject.
fn join_attempt_subject(
  sealed: AttemptAdmissionSubject,
  current: AttemptSubjectAdmission,
) -> AttemptSubjectAdmission {
  match validate_attempt_subject(subject: sealed) {
    AttemptSubjectRefused { node, cause } => AttemptSubjectRefused { node: node, cause: cause }
    AttemptSubjectAdmitted { subject: validated_seal } =>
      match current {
        AttemptSubjectRefused { node, cause } => AttemptSubjectRefused { node: node, cause: cause }
        AttemptSubjectAdmitted { subject } =>
          compare_attempt_subject_fields(sealed: validated_seal, current: validate_attempt_subject(subject: subject))
      }
  }
}
