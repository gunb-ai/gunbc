module gunbc.roadmap_dispatch_destination

import std.types { String, NonEmptyStr, Bool, List, FilePath }
import std.algebra { trim }
import extdeps.github.github { Repository }
import extdeps.languages.json.emit {
  JsonValue,
  JsonKeyValue,
  json_kv,
  json_string,
  json_bool,
  json_object,
  serialize_json,
}
import gunbc.repository { gunbc_repository }
import gunbc.roadmap_model { RoadmapNode, NodeSizing, Sized, Unsized }

// A dispatch's destination is a per-NODE fact. The slug is a String: "gunbc" or owner/name.
// TODAY it is read from NodeSizing.repo. When eager-gull-33 lands, RoadmapNode.sizing becomes
// RoadmapNode.dispatch: WorkItemDispatch = NotDispatchable | Dispatchable { repo, acceptance },
// and destination_from_sizing's match is the one mechanical rewrite (Sized/Unsized ->
// Dispatchable/NotDispatchable). The resolver itself does not change.
//
// THIS MODULE NAMES NO PRIVATE REPOSITORY. A node whose work lives elsewhere supplies its
// own owner/name via the repo slug; the public authority only knows gunbc_repository as an
// observed Repository. A slug does not carry privacy or default branch: those are GitHub
// facts (extdeps.github.github.Repository). This path does not call that API.

type DestinationPrivacyStanding
  = DestinationPrivacyObserved { private: Bool }
  | DestinationPrivacyUnobserved

type DestinationDefaultBranchStanding
  = DestinationDefaultBranchObserved { branch: String }
  | DestinationDefaultBranchUnobserved

type DestinationIdentity {
  owner: String
  name: String
  full_name: String
  privacy: DestinationPrivacyStanding
  default_branch: DestinationDefaultBranchStanding
}

type DispatchDestination
  = DispatchDestinationResolved { identity: DestinationIdentity }
  | DispatchDestinationMissing { reason: NonEmptyStr }

fn gunbc_destination_slug_matches(repo: String) -> Bool {
  repo == gunbc_repository.name || repo == gunbc_repository.full_name
}

fn gunbc_destination_identity() -> DestinationIdentity {
  DestinationIdentity {
    owner: gunbc_repository.owner,
    name: gunbc_repository.name,
    full_name: gunbc_repository.full_name,
    privacy: DestinationPrivacyObserved { private: gunbc_repository.private },
    default_branch: DestinationDefaultBranchObserved { branch: gunbc_repository.default_branch },
  }
}

fn named_destination_identity_from_owner_name(owner: String, name: String) -> DestinationIdentity {
  DestinationIdentity {
    owner: owner,
    name: name,
    full_name: join([owner, "/", name], ""),
    privacy: DestinationPrivacyUnobserved,
    default_branch: DestinationDefaultBranchUnobserved,
  }
}

fn destination_is_known_public(identity: DestinationIdentity) -> Bool {
  match identity.privacy {
    DestinationPrivacyObserved { private } => !private
    DestinationPrivacyUnobserved => false
  }
}

// DECLARED DROP: gunbc.rung_drop publication_subject_unobserved_privacy_placeholder.
// Owner and name on a named destination ARE observed from the slug. Privacy and default
// branch are not. destination_is_known_public reads Unobserved as not known to be public.
// This projection still fills Repository.private = true and default_branch = "" because
// RoadmapPublicationSubject.repository cannot represent Unobserved. That fill is not an
// observation. Do not flip the Bool to false. The drop, not this comment, is the record.

fn destination_github_repository(identity: DestinationIdentity) -> Repository {
  match identity.privacy {
    DestinationPrivacyObserved { private } =>
      match identity.default_branch {
        DestinationDefaultBranchObserved { branch } =>
          Repository {
            owner: identity.owner,
            name: identity.name,
            full_name: identity.full_name,
            private: private,
            default_branch: branch,
          }
        DestinationDefaultBranchUnobserved =>
          destination_github_repository_unobserved_fields(identity: identity)
      }
    DestinationPrivacyUnobserved =>
      destination_github_repository_unobserved_fields(identity: identity)
  }
}

fn destination_github_repository_unobserved_fields(identity: DestinationIdentity) -> Repository {
  Repository {
    owner: identity.owner,
    name: identity.name,
    full_name: identity.full_name,
    private: true,
    default_branch: "",
  }
}

fn repository_from_repo_slug(repo: String) -> DispatchDestination {
  let slug = trim(repo)
  if slug == "" {
    DispatchDestinationMissing {
      reason: "the node declares an empty destination slug, so there is no repository to publish to" as NonEmptyStr,
    }
  } else if gunbc_destination_slug_matches(repo: slug) {
    DispatchDestinationResolved { identity: gunbc_destination_identity() }
  } else {
    let parts = split(s: slug, delimiter: "/")
    if count(parts) != 2 {
      DispatchDestinationMissing {
        reason: join([
          "destination slug ",
          slug,
          " is not owner/name, so it cannot become a publication repository",
        ], "") as NonEmptyStr,
      }
    } else {
      match first(parts) {
        Absent =>
          DispatchDestinationMissing {
            reason: join([
              "destination slug ",
              slug,
              " is not owner/name, so it cannot become a publication repository",
            ], "") as NonEmptyStr,
          }
        Present { value: owner_raw } =>
          match first(parts.skip(n: 1)) {
            Absent =>
              DispatchDestinationMissing {
                reason: join([
                  "destination slug ",
                  slug,
                  " is not owner/name, so it cannot become a publication repository",
                ], "") as NonEmptyStr,
              }
            Present { value: name_raw } => {
              let owner = trim(owner_raw)
              let name = trim(name_raw)
              if owner == "" || name == "" {
                DispatchDestinationMissing {
                  reason: join([
                    "destination slug ",
                    slug,
                    " has an empty owner or name",
                  ], "") as NonEmptyStr,
                }
              } else {
                DispatchDestinationResolved {
                  identity: named_destination_identity_from_owner_name(owner: owner, name: name),
                }
              }
            }
          }
      }
    }
  }
}

fn destination_from_sizing(sizing: NodeSizing) -> DispatchDestination {
  match sizing {
    Unsized =>
      DispatchDestinationMissing {
        reason: "the node is unsized, so it has no destination repository" as NonEmptyStr,
      }
    Sized { repo, intricacy: _, volume: _, acceptance: _ } =>
      repository_from_repo_slug(repo: repo)
  }
}

fn node_dispatch_destination(node: RoadmapNode) -> DispatchDestination {
  destination_from_sizing(sizing: node.sizing)
}

// Destination identity and spawn actuation are different facts. repository_from_repo_slug
// resolves any well-formed owner/name so publication can name that repository. This
// instance still creates worktrees in instance.repo_root against dispatch_git_remote_ref
// (gunbc_merge_target_ref). Admitting a resolved non-gunbc destination onto that tree
// would work in gunbc and publish elsewhere — DESIGN section 5 widen. Until spawn binds
// worktree and remote to the destination, actuation is only the known-public gunbc tree.
// TRIGGER to retire this refuse: worktree-add and the merge remote are taken from the
// node's destination, not from the instance gunbc constants.

fn destination_is_this_spawn_tree(identity: DestinationIdentity) -> Bool {
  identity.full_name == gunbc_repository.full_name
    && destination_is_known_public(identity: identity)
}

fn destination_not_this_spawn_tree_reason(identity: DestinationIdentity) -> NonEmptyStr {
  join(
    [
      "this instance creates attempts in the public gunbc tree at ",
      gunbc_repository.full_name,
      "; destination ",
      identity.full_name,
      " is not that tree, so dispatch refuses rather than working in gunbc and publishing to ",
      identity.full_name,
    ],
    "",
  ) as NonEmptyStr
}

// Recorded at spawn so an attempt can later say which repository and which exact base
// revision it was branched from. The instance's dispatch_base_ref is a name; the SHA
// is the fact. Privacy and default branch are recorded as standings, not as GitHub
// Repository fields, so an unobserved destination cannot mint private:true in this file.

type DispatchSpawnOrigin {
  identity: DestinationIdentity
  base_ref: NonEmptyStr
  base_sha: NonEmptyStr
}

fn spawn_origin_is_public_gunbc(origin: DispatchSpawnOrigin) -> Bool {
  destination_is_this_spawn_tree(identity: origin.identity)
}

fn destination_privacy_json_members(privacy: DestinationPrivacyStanding) -> List<JsonKeyValue> {
  match privacy {
    DestinationPrivacyObserved { private } =>
      [
        json_kv(key: "privacy", value: json_string(s: "observed")),
        json_kv(key: "private", value: json_bool(b: private)),
      ]
    DestinationPrivacyUnobserved =>
      [json_kv(key: "privacy", value: json_string(s: "unobserved"))]
  }
}

fn destination_default_branch_json_value(standing: DestinationDefaultBranchStanding) -> JsonValue {
  match standing {
    DestinationDefaultBranchObserved { branch } => json_string(s: branch)
    DestinationDefaultBranchUnobserved => json_string(s: "unobserved")
  }
}

fn dispatch_spawn_origin_json_value(origin: DispatchSpawnOrigin) -> JsonValue {
  json_object(
    members: concat(
      [json_kv(key: "repository", value: json_string(s: origin.identity.full_name))],
      concat(
        destination_privacy_json_members(privacy: origin.identity.privacy),
        [
          json_kv(
            key: "default_branch",
            value: destination_default_branch_json_value(standing: origin.identity.default_branch),
          ),
          json_kv(
            key: "known_public_gunbc",
            value: json_bool(b: spawn_origin_is_public_gunbc(origin: origin)),
          ),
          json_kv(key: "base_ref", value: json_string(s: origin.base_ref as String)),
          json_kv(key: "base_sha", value: json_string(s: origin.base_sha as String)),
        ],
      ),
    ),
  )
}

fn dispatch_spawn_origin_json(origin: DispatchSpawnOrigin) -> String {
  serialize_json(v: dispatch_spawn_origin_json_value(origin: origin))
}

data dispatch_spawn_origin_basename: String = "spawn-destination.json"
