module gunbc.roadmap.roadmap_runtime_plan

import gunbc.roadmap.roadmap_authority {
  RoadmapAuthorityProjection, roadmap_authority_projection_with, roadmap_acceptance_event_history_load,
  roadmap_retired_node_ids_load,
}

// THE ONE PLAN: the declared rows and closing-contract pairs of gunbc.roadmap.roadmap_authority, with the
// acceptance history, folded into the one RoadmapDocument every consumer reads. There is no second
// definition source: the fabric runtime task store was deleted on 2026-11-08
// (gunbc.design_ruling::plans_reset_and_audit_recommendations_2026_11_08), so a task is defined only by a
// row in the repository and its status lives in the event log.
fn roadmap_plan_projection() -> RoadmapAuthorityProjection {
  roadmap_authority_projection_with(history: roadmap_acceptance_event_history_load(), runtime: [], retired: roadmap_retired_node_ids_load())
}
