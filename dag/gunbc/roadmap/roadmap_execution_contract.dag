module gunbc.roadmap_execution_contract

import std.types { String, NonEmptyStr, List, FilePath, Bool }
import gunbc.ensure { EnsurePolicy }

type ExecutionCapability
  = GitWorkspaceCapability
  | TmuxSessionCapability
  | TmuxPipeShellCapability
  | TeeEventCaptureCapability
  | ProviderEventProjectionCapability
  | EnvironmentBindingCapability
  | AttemptStateDirectoryCapability
  | AttemptCurrentPointerCapability
  | GunbcClaimRunnerCapability
  | CargoCapability
  | RustcCapability
  | RustfmtCapability
  | RustupCapability

type ValidationOperation
  = GunbcClaimValidation {
      entry: FilePath,
      function: NonEmptyStr,
    }
  | CargoTestValidation { filter: NonEmptyStr }
  | CargoFmtValidation
  | ClosingContractAuthoringValidation { target: NonEmptyStr }

type AttemptPathScope
  = PathsUnrestricted
  | PathsAllowed { prefixes: List<FilePath> }

type PathScopeVerdict
  = PathsAdmitted
  | PathOutOfScope { path: FilePath }

type ClaimSourceRootLayout
  = PublicWorktreeLayout
  | PinnedPublicPlusLocalRoot { public_prefix: NonEmptyStr }

// WorkItemExecutionContract is the per-node execution fact. ExecutionContractUnspecified and
// ExecutionContract have live producers in gunbc.roadmap_authority. OperatorExclusive, ExternalLead
// and CalendarObservation are DECLARED FRONTIER, not dangling: launch admission, serve 409,
// verify, and contract_closure already refuse each mode by name so Unspecified is not their
// stand-in. No live RoadmapNode.execution is constructed as one of those three today — minting a
// public authority row that is not actually non-agent work would be a fake producer. TRIGGER: a
// RoadmapNode the belt looks up (this public authority, or a plan supplied as a parameter) is
// constructed with execution: OperatorExclusive, ExternalLead, or CalendarObservation, so
// LaunchOperatorExclusive / LaunchExternalLead / LaunchCalendarObservation and the matching
// Validation* arms fire on a production tick. A witness that constructs the arm in isolation does
// not satisfy this trigger. Inventing a public node whose work is not operator-exclusive,
// external-lead, or calendar-observation does not satisfy it either.

type WorkItemExecutionContract
  = ExecutionContractUnspecified
  | ExecutionContract {
      validations: List<ValidationOperation>,
      extra_capabilities: List<ExecutionCapability>,
      path_scope: AttemptPathScope,
      source_roots: ClaimSourceRootLayout,
    }
  | OperatorExclusive
  | ExternalLead
  | CalendarObservation

type CapabilityRealization {
  capability: ExecutionCapability
  executable: FilePath
  identity_args: List<String>
  identity_contains: NonEmptyStr
  ensure_policy: EnsurePolicy
}

type DispatchHostEnvironment {
  realizations: List<CapabilityRealization>
}

type ModeledValidationCommand {
  label: NonEmptyStr
  program: FilePath
  args: List<String>
}

// A work item names semantic validation operations, never an opaque prompt fragment. Task
// capabilities derive from those closed variants; the provider prompt and the post-provider
// verifier are projections of the same operations. The dispatch platform separately contributes its
// fixed workspace/session/capture capabilities at admission, so those mechanics do not leak into
// every work-item contract. HostDashboardInstance resolves every joined semantic capability to an
// exact executable plus identity probe and Ensure policy. ExecutionContractUnspecified is an
// explicit migration state and dispatch refusal, never a repository-wide guessed default. In
// particular, a DAG task does not acquire Cargo merely because the repository is implemented in
// Rust.

fn execution_capability_label(capability: ExecutionCapability) -> String {
  match capability {
    GitWorkspaceCapability => "git-workspace"
    TmuxSessionCapability => "tmux-session"
    TmuxPipeShellCapability => "tmux-pipe-shell"
    TeeEventCaptureCapability => "tee-event-capture"
    ProviderEventProjectionCapability => "provider-event-projection"
    EnvironmentBindingCapability => "environment-binding"
    AttemptStateDirectoryCapability => "attempt-state-directory"
    AttemptCurrentPointerCapability => "attempt-current-pointer"
    GunbcClaimRunnerCapability => "gunbc-claim-runner"
    CargoCapability => "cargo"
    RustcCapability => "rustc"
    RustfmtCapability => "rustfmt"
    RustupCapability => "rustup"
  }
}

fn execution_capability_equal(
  a: ExecutionCapability,
  b: ExecutionCapability,
) -> Bool {
  execution_capability_label(capability: a) == execution_capability_label(capability: b)
}

fn capability_append_unique(
  capabilities: List<ExecutionCapability>,
  capability: ExecutionCapability,
) -> List<ExecutionCapability> {
  if any(
    capabilities,
    existing => execution_capability_equal(a: existing, b: capability),
  ) {
    capabilities
  } else {
    append(capabilities, [capability])
  }
}

fn validation_required_capabilities(
  validation: ValidationOperation,
) -> List<ExecutionCapability> {
  match validation {
    GunbcClaimValidation { entry: _, function: _ } =>
      [GunbcClaimRunnerCapability]
    CargoTestValidation { filter: _ } =>
      [CargoCapability, RustcCapability]
    CargoFmtValidation =>
      [CargoCapability, RustfmtCapability]
    ClosingContractAuthoringValidation { target: _ } =>
      [GunbcClaimRunnerCapability]
  }
}

fn execution_contract_required_capabilities(
  contract: WorkItemExecutionContract,
) -> List<ExecutionCapability> {
  match contract {
    ExecutionContractUnspecified => []
    OperatorExclusive => []
    ExternalLead => []
    CalendarObservation => []
    ExecutionContract { validations, extra_capabilities, path_scope: _, source_roots: _ } =>
      let required = fold(
        validations,
        init: extra_capabilities,
        f: fn(acc, validation) {
          concat(
            acc,
            validation_required_capabilities(validation: validation),
          )
        },
      )
      fold(
        required,
        init: [],
        f: fn(acc, cap) {
          capability_append_unique(
            capabilities: acc,
            capability: cap,
          )
        },
      )
  }
}

// ONE BINDING LAW, BECAUSE THERE WERE THREE AND THEY DISAGREED. Whether a contract closes anything
// was decided independently in three places and two answers were given. gunbc.roadmap_authority's
// node_lacks_closing_validation treated ANY ExecutionContract as bound, so a contract declaring an
// empty validation list counted as closed; gunbc.roadmap_verify treated the empty list as unbound;
// gunbc.roadmap_dispatch_environment refused it with its own reason. Empty lists are constructible
// — nothing stops ExecutionContract with no validations from being written — so the disagreement is
// reachable rather than theoretical.\n\nThe consequence lands on the acceptance frontier. A node
// bound to an empty contract disappears from nodes_needing_acceptance, because the projection reads
// it as bound; the verifier then reports it Unbound, and dispatch refuses to admit an environment
// for it. The node is simultaneously finished, unverifiable and undispatchable, and no single
// reading of the model says so.\n\nThis is the one decision, and it returns a THREE-valued closure
// rather than a Bool because the two unclosed states have different remedies — author a contract,
// versus fix the contract you authored — and dispatch_environment's located diagnostics depend on
// telling them apart. contract_has_closing_validation is the Bool projection for the callers that
// genuinely only need the predicate. No consumer re-derives either from the coproduct's
// shape.\n\nNo behaviour changes on today's corpus: all four bound nodes route through
// gunbc_claim_execution_contract, which always emits exactly one validation. The de-fork is what
// keeps that true when the fifth binding is written by hand.

type NonAgentWorkMode
  = OperatorExclusiveMode
  | ExternalLeadMode
  | CalendarObservationMode

type ContractClosure
  = ContractDeclaresNoValidation
  | ContractClosesNothing
  | ContractCloses { validations: List<ValidationOperation> }
  | ContractNotAgentWork { mode: NonAgentWorkMode }

fn non_agent_work_mode_label(mode: NonAgentWorkMode) -> String {
  match mode {
    OperatorExclusiveMode => "operator-exclusive"
    ExternalLeadMode => "external-lead"
    CalendarObservationMode => "calendar-observation"
  }
}

fn contract_closure(contract: WorkItemExecutionContract) -> ContractClosure {
  match contract {
    ExecutionContractUnspecified => ContractDeclaresNoValidation
    OperatorExclusive => ContractNotAgentWork { mode: OperatorExclusiveMode }
    ExternalLead => ContractNotAgentWork { mode: ExternalLeadMode }
    CalendarObservation => ContractNotAgentWork { mode: CalendarObservationMode }
    ExecutionContract { validations, extra_capabilities: _, path_scope: _, source_roots: _ } =>
      if count(validations) == 0 {
        ContractClosesNothing
      } else {
        ContractCloses { validations: validations }
      }
  }
}

fn contract_has_closing_validation(contract: WorkItemExecutionContract) -> Bool {
  match contract_closure(contract: contract) {
    ContractCloses { validations: _ } => true
    ContractClosesNothing => false
    ContractDeclaresNoValidation => false
    ContractNotAgentWork { mode: _ } => false
  }
}

fn dispatch_platform_required_capabilities() -> List<ExecutionCapability> {
  [
    GitWorkspaceCapability,
    TmuxSessionCapability,
    TmuxPipeShellCapability,
    TeeEventCaptureCapability,
    ProviderEventProjectionCapability,
    EnvironmentBindingCapability,
    AttemptStateDirectoryCapability,
    AttemptCurrentPointerCapability,
  ]
}

fn dispatch_required_capabilities(
  contract: WorkItemExecutionContract,
) -> List<ExecutionCapability> {
  match contract {
    ExecutionContractUnspecified => []
    OperatorExclusive => []
    ExternalLead => []
    CalendarObservation => []
    ExecutionContract { validations: _, extra_capabilities: _, path_scope: _, source_roots: _ } =>
      fold(
        concat(
          dispatch_platform_required_capabilities(),
          execution_contract_required_capabilities(contract: contract),
        ),
        init: [],
        f: fn(acc, cap) {
          capability_append_unique(
            capabilities: acc,
            capability: cap,
          )
        },
      )
  }
}

fn agent_execution_contract(
  validations: List<ValidationOperation>,
  extra_capabilities: List<ExecutionCapability>,
) -> WorkItemExecutionContract {
  ExecutionContract {
    validations: validations,
    extra_capabilities: extra_capabilities,
    path_scope: PathsUnrestricted,
    source_roots: PublicWorktreeLayout,
  }
}

fn gunbc_claim_execution_contract(
  entry: FilePath,
  function: NonEmptyStr,
) -> WorkItemExecutionContract {
  agent_execution_contract(
    validations: [
      GunbcClaimValidation {
        entry: entry,
        function: function,
      },
    ],
    extra_capabilities: [],
  )
}

// ONE PARAMETERIZED KIND, NOT ONE META-WITNESS PER TARGET. gunbc.roadmap_authority
// closing_contract_task_naming_correction_note recorded the gap this closes: a derived
// closing-contract task was itself built with ExecutionContractUnspecified, so dispatch refused the
// very row whose job is to supply a contract, and the belt could not run the frontier it computes.
// The validation is parameterized by the TARGET node id and its oracle is a single fixed entry
// point, so adding a target costs no new declaration anywhere -- which is what the note asked for
// instead of ten bespoke meta-witnesses.
//
// The target travels as `--arg target=<id>` rather than being baked into a per-target function
// name, because a function name per target is exactly the hand-maintained roster the derivation
// exists to avoid: the frontier changes whenever a node is accepted or bound, and a roster of entry
// points would have to be edited in step with it.
//
// WHAT THE PREDICATE DECIDES AND WHAT IT DOES NOT is stated at
// gunbc.roadmap_closing_contract_authoring closing_contract_authoring_predicate_note. It is not the
// whole of the note's wish list, and the boundary is declared there rather than implied by a green.

data closing_contract_authoring_entry: FilePath = "dag/gunbc/roadmap/roadmap_closing_contract_authoring.dag" as FilePath

data closing_contract_authoring_function: NonEmptyStr = "closing_contract_authored" as NonEmptyStr

fn closing_contract_authoring_contract(
  target: NonEmptyStr,
) -> WorkItemExecutionContract {
  agent_execution_contract(
    validations: [ClosingContractAuthoringValidation { target: target }],
    extra_capabilities: [],
  )
}

fn cargo_test_execution_contract(
  filter: NonEmptyStr,
) -> WorkItemExecutionContract {
  agent_execution_contract(
    validations: [CargoTestValidation { filter: filter }],
    extra_capabilities: [],
  )
}

fn claim_source_root_args(layout: ClaimSourceRootLayout) -> List<String> {
  match layout {
    PublicWorktreeLayout =>
      ["--source-root", "dag", "--source-root", "src/v2"]
    PinnedPublicPlusLocalRoot { public_prefix } =>
      [
        "--source-root", join([public_prefix as String, "/dag"], ""),
        "--source-root", join([public_prefix as String, "/src/v2"], ""),
        "--source-root", "dag",
      ]
  }
}

fn contract_source_roots(contract: WorkItemExecutionContract) -> ClaimSourceRootLayout {
  match contract {
    ExecutionContract { validations: _, extra_capabilities: _, path_scope: _, source_roots } =>
      source_roots
    ExecutionContractUnspecified => PublicWorktreeLayout
    OperatorExclusive => PublicWorktreeLayout
    ExternalLead => PublicWorktreeLayout
    CalendarObservation => PublicWorktreeLayout
  }
}

fn contract_path_scope(contract: WorkItemExecutionContract) -> AttemptPathScope {
  match contract {
    ExecutionContract { validations: _, extra_capabilities: _, path_scope, source_roots: _ } =>
      path_scope
    ExecutionContractUnspecified => PathsUnrestricted
    OperatorExclusive => PathsUnrestricted
    ExternalLead => PathsUnrestricted
    CalendarObservation => PathsUnrestricted
  }
}

fn allowed_prefix_boundary(prefix: String) -> String {
  if ends_with(s: prefix, suffix: "/") {
    prefix
  } else {
    join([prefix, "/"], "")
  }
}

fn path_has_allowed_prefix(path: FilePath, prefixes: List<FilePath>) -> Bool {
  any(
    prefixes,
    prefix => {
      let declared = prefix as String
      let observed = path as String
      observed == declared
        || starts_with(s: observed, prefix: allowed_prefix_boundary(prefix: declared))
    },
  )
}

fn attempt_paths_admitted(
  scope: AttemptPathScope,
  touched: List<FilePath>,
) -> PathScopeVerdict {
  match scope {
    PathsUnrestricted => PathsAdmitted
    PathsAllowed { prefixes } =>
      fold(
        touched,
        init: PathsAdmitted,
        f: fn(acc, path) {
          match acc {
            PathOutOfScope { path: found } => PathOutOfScope { path: found }
            PathsAdmitted =>
              if path_has_allowed_prefix(path: path, prefixes: prefixes) {
                PathsAdmitted
              } else {
                PathOutOfScope { path: path }
              }
          }
        },
      )
  }
}

fn dispatch_host_realization(
  environment: DispatchHostEnvironment,
  capability: ExecutionCapability,
) -> CapabilityRealization? {
  environment.realizations
    |> filter(realization =>
      execution_capability_equal(
        a: realization.capability,
        b: capability,
      ))
    |> first
}

fn validation_operation_command(
  validation: ValidationOperation,
  environment: DispatchHostEnvironment,
  source_roots: ClaimSourceRootLayout,
) -> ModeledValidationCommand? {
  match validation {
    GunbcClaimValidation { entry, function } =>
      match dispatch_host_realization(
        environment: environment,
        capability: GunbcClaimRunnerCapability,
      ) {
        Present { value: realization } =>
          Present { value: ModeledValidationCommand {
            label: "gunbc-claim" as NonEmptyStr,
            program: realization.executable,
            args: concat(
              concat(["run"], claim_source_root_args(layout: source_roots)),
              [
                "--entry", entry as String,
                "--function", function as String,
                "--claim-run",
              ],
            ),
          } }
        Absent => none
      }
    CargoTestValidation { filter } =>
      match dispatch_host_realization(
        environment: environment,
        capability: CargoCapability,
      ) {
        Present { value: realization } =>
          Present { value: ModeledValidationCommand {
            label: "cargo-test" as NonEmptyStr,
            program: realization.executable,
            args: ["test", filter as String],
          } }
        Absent => none
      }
    CargoFmtValidation =>
      match dispatch_host_realization(
        environment: environment,
        capability: CargoCapability,
      ) {
        Present { value: realization } =>
          Present { value: ModeledValidationCommand {
            label: "cargo-fmt" as NonEmptyStr,
            program: realization.executable,
            args: ["fmt", "--all", "--check"],
          } }
        Absent => none
      }
    ClosingContractAuthoringValidation { target } =>
      match dispatch_host_realization(
        environment: environment,
        capability: GunbcClaimRunnerCapability,
      ) {
        Present { value: realization } =>
          Present { value: ModeledValidationCommand {
            label: "closing-contract-authoring" as NonEmptyStr,
            program: realization.executable,
            args: concat(
              concat(["run"], claim_source_root_args(layout: source_roots)),
              [
                "--entry", closing_contract_authoring_entry as String,
                "--function", closing_contract_authoring_function as String,
                "--arg", join(["target=", target as String], ""),
                "--claim-run",
              ],
            ),
          } }
        Absent => none
      }
  }
}

fn modeled_validation_command_wire(command: ModeledValidationCommand) -> String {
  join(
    concat([command.program as String], command.args),
    " ",
  )
}

fn execution_contract_validation_summary(
  contract: WorkItemExecutionContract,
  environment: DispatchHostEnvironment,
) -> String {
  match contract {
    ExecutionContractUnspecified => "execution contract unspecified"
    OperatorExclusive => "operator-exclusive: no agent may take this work"
    ExternalLead => "external-lead: no agent may take this work"
    CalendarObservation => "calendar-observation: no agent may take this work"
    ExecutionContract { validations, extra_capabilities: _, path_scope: _, source_roots } =>
      join(
        map(
          validations,
          validation =>
            match validation_operation_command(
              validation: validation,
              environment: environment,
              source_roots: source_roots,
            ) {
              Present { value: command } =>
                modeled_validation_command_wire(command: command)
              Absent =>
                "validation command has no host capability realization"
            },
        ),
        "\n",
      )
  }
}

fn validation_consumes_affected_set_window(validation: ValidationOperation) -> Bool {
  match validation {
    GunbcClaimValidation { entry: _, function: _ } => true
    CargoTestValidation { filter: _ } => false
    CargoFmtValidation => false
    ClosingContractAuthoringValidation { target: _ } => false
  }
}

fn execution_contract_needs_diff_window(contract: WorkItemExecutionContract) -> Bool {
  match contract {
    ExecutionContractUnspecified => false
    OperatorExclusive => false
    ExternalLead => false
    CalendarObservation => false
    ExecutionContract { validations, extra_capabilities: _, path_scope: _, source_roots: _ } =>
      any(
        validations,
        validation => validation_consumes_affected_set_window(validation: validation),
      )
  }
}
