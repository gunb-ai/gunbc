module gunbc.roadmap.roadmap_review_criteria

import std.types { String, Bool, List }
import std.syllogism { Proposition }
import gunbc.design_argument { design_propositions }

// ONE CRITERION PER DESIGN PROPOSITION, ONE REVIEWER PER CRITERION. A review that asks "is this
// change good" is one judgment over every concern at once, and its verdict cannot say which concern
// it failed; a review that asks one question can. So each criterion here is one checkable question
// derived from one proposition of the modeled design argument (gunbc.design_argument), grounded by
// that proposition's id -- a criterion naming a proposition the argument does not carry is a witness
// failure, not prose drift -- and the belt spawns one reviewer per criterion. Their verdicts are
// reconciled in gunbc.roadmap.roadmap_review_role (operator, 2026-09-05: break the reviews down as
// small as possible, each design axiom as a modeled input; the reviews may conflict and get sorted
// out there).
//
// THE GOAL CRITERION IS NOT A DESIGN PROPOSITION. "Does the change do what the node asked" is grounded
// on the node's own contract, so it is the one criterion whose premise is the roadmap node rather than
// the argument; it is listed first because every other question presupposes the change is the change.
type ReviewCriterionGround
  = GroundedOnTheNodeContract
  | GroundedOnDesignProposition { proposition_id: String }

type ReviewCriterion {
  key: String
  ground: ReviewCriterionGround
  question: String
  tells: List<String>
}

data review_criteria: List<ReviewCriterion> = [
  ReviewCriterion {
    key: "goal",
    ground: GroundedOnTheNodeContract,
    question: "Does the change do what the node's goal states, within its boundary, and nothing the non-goals forbid?",
    tells: [
      "a file changed that the goal does not need",
      "the acceptance check passes for a reason other than the goal being met",
      "the boundary sentence names something the diff does not contain",
    ],
  },
  ReviewCriterion {
    key: "redundancy",
    ground: GroundedOnDesignProposition { proposition_id: "s2.minimize-redundancy" },
    question: "Does the change add work that already exists somewhere in the repository: a second representation of a fact, a copied accumulator, a parallel path beside a modeled one?",
    tells: [
      "a new type or function whose shape matches an existing one under another name",
      "a hand-written projection of something the model could generate",
      "a quadratic fold or a copied list where a single fold would do",
    ],
  },
  ReviewCriterion {
    key: "single-authority",
    ground: GroundedOnDesignProposition { proposition_id: "s3.single-authority" },
    question: "Does the change give one concept a second name or a second home, or cite a position where a symbol exists?",
    tells: [
      "a new enum or record for a concept an extdeps or std module already owns",
      "a literal string where a modeled value exists",
      "a file:line citation in prose or a row where a module and symbol could be named",
      "the same fact now answerable from two carriers with no relation stated between them",
    ],
  },
  ReviewCriterion {
    key: "grounding",
    ground: GroundedOnDesignProposition { proposition_id: "s4.closed-grounded-substrate" },
    question: "Does the change leave something opaque that is not atomic, or route around the substrate: a stringly leaf hiding named parts, a heuristic where a fact was available, an annotation inside a body?",
    tells: [
      "a String field carrying structure a record could name",
      "a threshold or guess standing where the richer source exists",
      "a // annotation inside a fn or type body rather than above a module-scope declaration",
    ],
  },
  ReviewCriterion {
    key: "fail-closed",
    ground: GroundedOnDesignProposition { proposition_id: "s5.fail-closed" },
    question: "Does any failure arm in the change widen, default, or fall silent instead of refusing with a typed, located reason; and does any check stand where a construction was available?",
    tells: [
      "an arm that returns a superset, an empty value, or 'proceed' when it could not compute its answer",
      "an Option or wildcard that collapses two states with different remedies",
      "a toggle, env var or flag whose only effect is to skip a refusal",
      "a validator for a state the model could have made unwritable",
    ],
  },
  ReviewCriterion {
    key: "how-to-work",
    ground: GroundedOnDesignProposition { proposition_id: "s6.how-to-work" },
    question: "Does the change land temporary work, a workaround, or an unmarked scaffold without an operator's verdict, or a proven cost-shape defect left in place?",
    tells: [
      "'for now', 'temporary', 'until', 'bridge', 'shim', 'compatibility' with no dissolution obligation beside it",
      "a second path beside an existing modeled route",
      "a change that routes around a substrate refusal instead of naming it",
    ],
  },
]

fn review_criterion_proposition_ids() -> List<String> {
  fold(review_criteria, init: [], f: (acc, c) => match c.ground {
    GroundedOnTheNodeContract => acc
    GroundedOnDesignProposition { proposition_id } => concat(acc, [proposition_id])
  })
}

// Every design-grounded criterion names a proposition the argument actually carries. This is the
// entailment the roster claims, checked against the argument rather than asserted beside it.
fn review_criteria_grounded_in_the_argument() -> Bool {
  all(review_criterion_proposition_ids(), id => any(design_propositions, p => p.id == id))
}

fn review_criterion_keys() -> List<String> {
  map(review_criteria, c => c.key)
}

fn review_criterion_by_key(key: String) -> ReviewCriterion? {
  (filter(review_criteria, c => c.key == key)).first()
}

fn review_criterion_ground_text(g: ReviewCriterionGround) -> String {
  match g {
    GroundedOnTheNodeContract => "the node's own contract"
    GroundedOnDesignProposition { proposition_id } => join(["DESIGN proposition ", proposition_id], "")
  }
}

fn review_criterion_brief_text(c: ReviewCriterion) -> String {
  join([
    "Criterion (", c.key, ", grounded on ", review_criterion_ground_text(g: c.ground), "): ", c.question, "\n",
    "Tells that the answer is yes:\n",
    join(map(c.tells, t => join(["  - ", t], "")), "\n"),
    "\n",
  ], "")
}
