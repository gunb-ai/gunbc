module gunbc.roadmap.roadmap_attempt_request_binding

import std.types { String, Bool, List, NonEmptyStr }
import extdeps.filesystem.filesystem_io { Filesystem }
import extdeps.languages.json.emit { JsonValue, JsonNull, JsonBool, JsonNumber, JsonString, JsonArray, JsonObject, json_object, json_kv, json_string, serialize_json }
import extdeps.languages.json.parse {
  parse_json_document, JsonDocumentParsed, JsonDocumentUnreadable, json_document_gap_text,
  json_object_unique_member, JsonMemberFound, JsonMemberAbsent, JsonMemberDuplicated, JsonMemberNotAnObject,
}
import gunbc.roadmap_model { RoadmapNodeId }
import gunbc.roadmap_dashboard_instance { HostDashboardInstance }
import gunbc.roadmap_dispatch_actuator { dispatch_attempt_state_path_for_instance }
import gunbc.roadmap.roadmap_event_log {
  RoadmapEventEnvelope, RoadmapEventId, roadmap_issue_current_claim, roadmap_node_standing, roadmap_node_standing_key, roadmap_node_standing_text,
}
import gunbc.roadmap.roadmap_event_carrier {
  roadmap_event_carrier_layout_for_instance, roadmap_events_read, RoadmapEventsRead, EventsRead, EventsReadRefused,
}

// THE REQUEST AN ATTEMPT WAS LAUNCHED FOR, FIXED AT LAUNCH. An attempt exists because someone
// assigned the issue: that assignment is one Claimed event on the issue's log, and its id is the
// request's identity. Reading "who does the work come back to" from the issue's CURRENT assignment
// when the attempt ends answers a different question -- a second claim made while the attempt runs
// would take the first requester's result, and a release would erase its recipient -- so the
// attempt records the claim it was launched under, once, in its own attempt state, before the
// worker starts. Everything that later returns the attempt's result
// (gunbc.roadmap.roadmap_result_returned) joins through this record and nothing else.
//
// Three states, each written, none defaulted: Bound names the claim event; Unclaimed is an attempt
// launched on an issue nobody had assigned (the timer's own dispatch), which has no requester and
// never will; Unobserved is a launch at which the issue's log could not be read or ordered, which
// is NOT the same as unclaimed and is recorded with its reason so a result is never addressed on a
// guess.
type AttemptRequestBinding
  = RequestClaimBound { claim: RoadmapEventId }
  | RequestClaimAbsent
  | RequestClaimUnobserved { reason: String }

data attempt_request_binding_schema: String = "roadmap-attempt-request-binding/v1"
data attempt_request_binding_basename: String = "request-binding.json"

fn attempt_request_binding_path_for_instance(instance: HostDashboardInstance, node_id: RoadmapNodeId, attempt_key: String) -> String {
  join([dispatch_attempt_state_path_for_instance(instance: instance, node_id: node_id, attempt_key: attempt_key), "/", attempt_request_binding_basename], "")
}

fn attempt_request_binding_json(binding: AttemptRequestBinding) -> String {
  serialize_json(v: json_object(members: match binding {
    RequestClaimBound { claim } => [
      json_kv(key: "schema", value: json_string(s: attempt_request_binding_schema)),
      json_kv(key: "status", value: json_string(s: "bound")),
      json_kv(key: "claim", value: json_string(s: claim as String)),
    ]
    RequestClaimAbsent => [
      json_kv(key: "schema", value: json_string(s: attempt_request_binding_schema)),
      json_kv(key: "status", value: json_string(s: "unclaimed")),
    ]
    RequestClaimUnobserved { reason } => [
      json_kv(key: "schema", value: json_string(s: attempt_request_binding_schema)),
      json_kv(key: "status", value: json_string(s: "unobserved")),
      json_kv(key: "reason", value: json_string(s: reason)),
    ]
  }))
}

fn binding_member_string(doc: JsonValue, key: String) -> String? {
  match json_object_unique_member(v: doc, key: key) {
    JsonMemberFound { value: JsonString { value: s } } => Present { value: s }
    JsonMemberFound { value: JsonNull } => none
    JsonMemberFound { value: JsonBool { value: _ } } => none
    JsonMemberFound { value: JsonNumber { lexeme: _ } } => none
    JsonMemberFound { value: JsonArray { elements: _ } } => none
    JsonMemberFound { value: JsonObject { members: _ } } => none
    JsonMemberAbsent => none
    JsonMemberDuplicated { count: _ } => none
    JsonMemberNotAnObject => none
  }
}

type AttemptRequestBindingDecode
  = RequestBindingDecoded { binding: AttemptRequestBinding }
  | RequestBindingUndecodable { reason: String }

// THE DECODE IS STRICT: the schema must be this one, the status one of the three, a bound record
// must name a non-empty claim and an unobserved one its reason. A document that is anything else
// is undecodable, never unclaimed.
fn attempt_request_binding_decode(text: String) -> AttemptRequestBindingDecode {
  match parse_json_document(s: text) {
    JsonDocumentUnreadable { gap } => RequestBindingUndecodable { reason: join(["not JSON: ", json_document_gap_text(gap: gap)], "") }
    JsonDocumentParsed { value: doc } =>
      match binding_member_string(doc: doc, key: "schema") {
        Absent => RequestBindingUndecodable { reason: "the binding has no schema member" }
        Present { value: schema } =>
          if schema != attempt_request_binding_schema {
            RequestBindingUndecodable { reason: join(["schema is ", schema, ", expected ", attempt_request_binding_schema], "") }
          } else {
            match binding_member_string(doc: doc, key: "status") {
              Absent => RequestBindingUndecodable { reason: "the binding has no status member" }
              Present { value: status } =>
                if status == "bound" {
                  match binding_member_string(doc: doc, key: "claim") {
                    Absent => RequestBindingUndecodable { reason: "a bound binding names no claim" }
                    Present { value: claim } =>
                      if claim == "" { RequestBindingUndecodable { reason: "a bound binding names an empty claim" } }
                      else { RequestBindingDecoded { binding: RequestClaimBound { claim: claim as NonEmptyStr as RoadmapEventId } } }
                  }
                } else if status == "unclaimed" {
                  RequestBindingDecoded { binding: RequestClaimAbsent }
                } else if status == "unobserved" {
                  match binding_member_string(doc: doc, key: "reason") {
                    Absent => RequestBindingUndecodable { reason: "an unobserved binding gives no reason" }
                    Present { value: reason } => RequestBindingDecoded { binding: RequestClaimUnobserved { reason: reason } }
                  }
                } else {
                  RequestBindingUndecodable { reason: join(["status ", status, " is not bound, unclaimed or unobserved"], "") }
                }
            }
          }
      }
  }
}

// THE BINDING AN ISSUE'S LOG GIVES A LAUNCH, pure over the read. The claim is the one the issue is
// held under at this moment (roadmap_issue_current_claim: the newest Claimed in causal order that
// no later Released ended). A refused read, or a history that forks or is incomplete, is
// Unobserved with the reason.
fn attempt_request_binding_of_read(read: RoadmapEventsRead) -> AttemptRequestBinding {
  match read {
    EventsReadRefused { node: _, step, reason } => RequestClaimUnobserved { reason: join(["the issue's event log could not be read at launch (", step, "): ", reason], "") }
    EventsRead { node: _, envelopes } => {
      let standing = roadmap_node_standing(envs: envelopes)
      let key = roadmap_node_standing_key(s: standing)
      if key == "forked" || key == "history_incomplete" {
        RequestClaimUnobserved { reason: join(["the issue's history could not be ordered at launch: ", roadmap_node_standing_text(s: standing)], "") }
      } else {
        match roadmap_issue_current_claim(envs: envelopes) {
          Present { value: claim } => RequestClaimBound { claim: claim.id }
          Absent => RequestClaimAbsent
        }
      }
    }
  }
}

type AttemptRequestBindingRecord
  = RequestBindingRecorded { binding: AttemptRequestBinding }
  | RequestBindingWriteFailed { detail: String }

// THE LAUNCH-TIME WRITE (gunbc.roadmap_belt_actuate belt_attempt_state_initialize_for_instance,
// before the worker starts): read the issue's log once, derive the binding, write it into the
// attempt's state directory. Only a failed WRITE fails the launch; an unreadable log is a binding
// in its own right.
fn attempt_request_binding_record_for_instance(instance: HostDashboardInstance, node_id: RoadmapNodeId, attempt_key: String) -> AttemptRequestBindingRecord {
  let binding = attempt_request_binding_of_read(read: roadmap_events_read(layout: roadmap_event_carrier_layout_for_instance(instance: instance), node: node_id))
  let write = Filesystem.Write(
    path: attempt_request_binding_path_for_instance(instance: instance, node_id: node_id, attempt_key: attempt_key),
    content: attempt_request_binding_json(binding: binding),
  )
  if write.success { RequestBindingRecorded { binding: binding } } else { RequestBindingWriteFailed { detail: write.error } }
}

// THE BINDING AS A LATER READER FINDS IT. Absent is an attempt launched before bindings were
// recorded (or one whose state was never initialized): it has no recorded request, which is its
// own arm and not unclaimed. Unreadable is a file that is there and cannot be read or decoded.
type AttemptRequestBindingRead
  = RequestBindingRead { binding: AttemptRequestBinding }
  | RequestBindingAbsent
  | RequestBindingUnreadable { reason: String }

fn attempt_request_binding_read_of(success: Bool, error_kind: String, error: String, content: String) -> AttemptRequestBindingRead {
  if success {
    match attempt_request_binding_decode(text: content) {
      RequestBindingDecoded { binding } => RequestBindingRead { binding: binding }
      RequestBindingUndecodable { reason } => RequestBindingUnreadable { reason: reason }
    }
  } else if error_kind == "not_found" {
    RequestBindingAbsent
  } else {
    RequestBindingUnreadable { reason: error }
  }
}

fn attempt_request_binding_read_for_instance(instance: HostDashboardInstance, node_id: RoadmapNodeId, attempt_key: String) -> AttemptRequestBindingRead {
  let read = Filesystem.Read(path: attempt_request_binding_path_for_instance(instance: instance, node_id: node_id, attempt_key: attempt_key))
  attempt_request_binding_read_of(success: read.success, error_kind: read.error_kind, error: read.error, content: read.content)
}
