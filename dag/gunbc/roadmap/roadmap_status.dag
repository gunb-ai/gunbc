module gunbc.roadmap.roadmap_status

import extdeps.github.pulls { PullRequest }

import std.types { NonEmptyStr }

// The ticket decomposition (remodel W2, operator direction 2026-07-24; the model half of
// ts-wf-node-schema): an AuthoredLine's single content String fuses headline, brief, workflow
// fields, references, and the item's whole history — so the page can only dump it, the dispatch
// brief can only stub its slots with the title, and every update concatenates into the blob because
// no time axis exists (ts-dispatch-elevate was the live specimen). TicketLine carries the fields as
// fields: the union of ts-wf-node-schema's list and the dispatch_brief_template slots — the
// template was always the spec of what dispatch needs — plus the updates thread. References reuse
// the node's carriers (Pointer is the existing ref concept; a ticket-local refs list would be a
// second one). AuthoredLine survives as the counted LEGACY frontier: every remaining prose row is
// burn-down for the mechanical migration (W2-bulk), and a new prose row where a ticket was possible
// is the review reject.

type TicketUpdate {
  on: String
  note: String
}

type TicketFields {
  headline: String
  brief: String
  displaced_cost: String
  current_state: String
  first_slice: String
  red_control: String
  out_of_scope: String
  handback: String
  updates: List<TicketUpdate>
  authored_on: String
  last_verified_on: String
}

type RoadmapItem

  = DerivableLine { prs: List<Int>, title: String, description: String }

  | AuthoredLine { content: String }

  | PlainLine { content: String }

  | TicketLine { ticket: TicketFields }

// THE ACCEPTANCE EVIDENCE CARRIERS. RedControlExecuted names the witness that executed a row's
// TicketFields.red_control and HandbackDelivered the artifacts that discharged its
// TicketFields.handback, both in NonEmptyStr fields, so an unnamed witness and an empty delivery are
// unwritable and the two predicates below are pure discrimination. They are read by the acceptance
// receipt (gunbc.roadmap.roadmap_model RoadmapAcceptanceReceipt), which is the only carrier of a
// node's acceptance. A node DEFINITION carries no acceptance field: the authored acceptance field that once
// sat on RoadmapNode was never set in production and was a second, hand-editable home for "done"
// beside the receipt history (plan-consolidation audit, operator ruling
// gunbc.design_ruling::plans_reset_and_audit_recommendations_2026_11_08), so it was deleted rather
// than kept as a field nothing may set. REMAINING GAP, counted not implied: the witness named
// inside RedControlExecuted is not mechanically joined to the prose red_control it discharges
// (gunbc.roadmap.roadmap_model roadmap_acceptance_receipt_note).

type RedControlEvidence
  = RedControlNotRun
  | RedControlExecuted { witness_module: NonEmptyStr, witness_fn: NonEmptyStr, executed_on: NonEmptyStr }

type HandbackEvidence
  = HandbackNotDelivered
  | HandbackDelivered { first_artifact: NonEmptyStr, further_artifacts: List<NonEmptyStr> }

fn red_control_evidence_satisfied(e: RedControlEvidence) -> Bool {
  match e {
    RedControlNotRun => false
    RedControlExecuted { witness_module: _, witness_fn: _, executed_on: _ } => true
  }
}

fn handback_evidence_satisfied(e: HandbackEvidence) -> Bool {
  match e {
    HandbackNotDelivered => false
    HandbackDelivered { first_artifact: _, further_artifacts: _ } => true
  }
}

fn pr_merged(pr: PullRequest) -> Bool {
  match pr.merged_at {
    Present { value: _ } => true
    Absent => false
  }
}

fn merged_pr_numbers(prs: List<PullRequest>) -> List<Int> {
  prs |> filter(pr => pr_merged(pr: pr)) |> map(pr => pr.number)
}

fn prs_all_merged(prs: List<Int>, merged: List<Int>) -> Bool {
  count(prs) > 0 && all(prs, r => merged |> any(m => m == r))
}

// THE LINE NEVER STATES ITS OWN ENDING. A line can only say what the work IS; whether the node is
// over is answered by the event log's standing for that node — an AcceptanceRecorded whose receipt
// passes the replay law, or a Retired — and by the merged pull requests of a DerivableLine, which is
// implementation EVIDENCE for review state and not an acceptance (a merged PR has never accepted a
// node; gunbc.roadmap.roadmap_operator_acceptance is the only route that records one). The authored
// `done: Bool` these lines used to carry was a hand-editable second spelling of the merged-PR
// evidence, and the SupersededLine variant was a hand-editable second spelling of a retirement
// (operator ruling gunbc.design_ruling::plans_reset_and_audit_recommendations_2026_11_08, follow-up
// steps 1(d) and 3). A node whose row was a retired line now leaves the plan the same way an accepted
// one does — through frontier_sets_projection's withheld set — so nothing downstream asks a line.
fn item_is_done(item: RoadmapItem, merged: List<Int>) -> Bool {
  match item {
    DerivableLine { prs, title: _, description: _ } => prs_all_merged(prs: prs, merged: merged)
    AuthoredLine { content: _ } => false
    PlainLine { content: _ } => false
    TicketLine { ticket: _ } => false
  }
}

// node_title, item_description and item_exit_criterion fold RoadmapItem, so they live with
// RoadmapItem. node_title used to live in gunbc.roadmap.roadmap_spawner, which is a consumer; it moved here
// when gunbc.roadmap.roadmap_model node_sizing_subject needed the same fold to project a node into a
// gunbc.roadmap.roadmap_sizing SizingSubject, because two folds of one coproduct answering the same
// question is the section 3 fork. The sizing authority itself imports nothing from the roadmap --
// its subject is a task -- so the projection, and this fold's second caller, live on the roadmap
// side.
//
// item_exit_criterion is Optional rather than an empty String: a line kind that declares no
// statement of done genuinely declares none, and "" would be a subject the deriver could not
// distinguish from an authored blank.
fn node_title(item: RoadmapItem) -> String {
  match item {
    DerivableLine { prs: _, title, description: _ } => title
    AuthoredLine { content } => content
    PlainLine { content } => content
    TicketLine { ticket } => ticket.headline
  }
}

fn item_description(item: RoadmapItem) -> String {
  match item {
    DerivableLine { prs: _, title: _, description } => description
    AuthoredLine { content } => content
    PlainLine { content } => content
    TicketLine { ticket } => ticket.brief
  }
}

fn item_exit_criterion(item: RoadmapItem) -> String? {
  match item {
    DerivableLine { prs: _, title: _, description: _ } => none
    AuthoredLine { content: _ } => none
    PlainLine { content: _ } => none
    TicketLine { ticket } =>
      if ticket.handback == "" { none } else { Present { value: ticket.handback } }
  }
}

fn line_ticket(item: RoadmapItem) -> TicketFields? {
  match item {
    DerivableLine { prs: _, title: _, description: _ } => Absent
    AuthoredLine { content: _ } => Absent
    PlainLine { content: _ } => Absent
    TicketLine { ticket } => Present { value: ticket }
  }
}

type DriftVerdict = Drifted | Clean | Underivable

fn status_drift(item: RoadmapItem, committed_box: Bool, merged: List<Int>) -> DriftVerdict {
  match item {
    AuthoredLine { content: _ } => Underivable
    PlainLine { content: _ } => Underivable
    TicketLine { ticket: _ } => Underivable
    DerivableLine { prs, title: _, description: _ } =>
      if committed_box == prs_all_merged(prs: prs, merged: merged) {
        Clean
      } else {
        Drifted
      }
  }
}

fn item_drifted(item: RoadmapItem, committed_box: Bool, merged: List<Int>) -> Bool {
  match status_drift(item: item, committed_box: committed_box, merged: merged) {
    Drifted => true
    Clean => false
    Underivable => false
  }
}

fn item_drifts_against_prs(item: RoadmapItem, committed_box: Bool, prs: List<PullRequest>) -> Bool {
  item_drifted(item: item, committed_box: committed_box, merged: merged_pr_numbers(prs: prs))
}
