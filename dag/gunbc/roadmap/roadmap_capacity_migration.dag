module gunbc.roadmap.roadmap_capacity_migration

import std.types { String, NonEmptyStr, List, Int }
import std.decl_ref { decl_ref }
import std.error_primitives { Ok, Err }
import extdeps.systemd { systemd_service_unit_suffix }
import extdeps.systemd.manager { SystemManager, UserManager }
import gunbc.compute.capacity_migration { CapacityManagedUnit, CapacityWriterReading, CapacityTransientFamily, CapacityMigrationParentRequirement, CapacityConfirmedWriter, CapacityUnclassified, capacity_migration_family_parent_requirements }
import gunbc.live_deploy.slice_bounds { user_work_slice_unit_name, attempt_worker_slice_unit_name }
import gunbc.live_deploy.spec {
  DeploymentNames, deployment_agent_door_unit_name,
  deployment_belt_exit_path_unit_name, deployment_belt_answer_path_unit_name,
  deployment_publication_path_unit_name, deployment_attempt_unit_drain_path_unit_name,
  deployment_belt_credential_recovery_timer_unit_name,
}
import gunbc.roadmap.roadmap_belt_obligation {
  belt_attempt_obligation_unit_name, belt_instance_obligation_unit_name, belt_instance_obligation_kinds,
}
import gunbc.roadmap.roadmap_dispatch_actuator {
  dispatch_review_unit_name, dispatch_audit_unit_name, dispatch_attempt_unit_stem,
}
import gunbc.roadmap.roadmap_attempt_redelivery_wake { attempt_redelivery_wake_family_patterns }

// This lab-only adapter is a transient population, NOT an installed-unit census or a
// deployment admission. The installed side must project the same typed unit-install
// rows consumed by live_deploy's emitter. DeploymentSpec.steps alone is insufficient:
// one BeltEventPathUnit emits multiple services and activators.
//
// The UID is supplied from the deployment's operating-principal reading, not guessed
// from a username. All rows have manager identity, including enumerated timer/service
// pairs. Whole-parent inhibition covers anonymous self-wrap scopes as well as named
// units; it needs a quiet window across EVERY session using those parents on the host.
// Positive readings for the lab's two confirmed direct reserve/settle entries.
// This is a classification input for the installed projection, not another installed
// roster. Every other service stays in the drain as Unclassified: no negative is
// inferred from its name, manager, or an incomplete service-call reachability walk.
fn roadmap_lab_capacity_installed_writer_reading(names: DeploymentNames, unit: CapacityManagedUnit) -> CapacityWriterReading {
  if unit.manager == SystemManager && unit.unit == names.unit_name {
    CapacityWriterReading {
      source: decl_ref(module_path: "gunbc.roadmap.roadmap_serve", decl_name: "roadmap_serve_handle_srv1_lab"),
      standing: CapacityConfirmedWriter,
    }
  } else if unit.manager == SystemManager && unit.unit == deployment_agent_door_unit_name(names: names) {
    CapacityWriterReading {
      source: decl_ref(module_path: "gunbc.roadmap.roadmap_serve", decl_name: "roadmap_serve_handle_srv1_lab_agent_door"),
      standing: CapacityConfirmedWriter,
    }
  } else {
    CapacityWriterReading {
      source: decl_ref(module_path: "gunbc.roadmap.roadmap_capacity_migration", decl_name: "roadmap_lab_capacity_installed_writer_reading"),
      standing: CapacityUnclassified { detail: join(["installed service has no covered negative reachability reading: ", unit.unit as String], "") },
    }
  }
}

fn roadmap_capacity_migration_activators(names: DeploymentNames) -> List<CapacityManagedUnit> {
  map([
    deployment_belt_exit_path_unit_name(names: names),
    deployment_belt_answer_path_unit_name(names: names),
    deployment_publication_path_unit_name(names: names),
    deployment_attempt_unit_drain_path_unit_name(names: names),
    deployment_belt_credential_recovery_timer_unit_name(names: names),
    deployment_agent_door_unit_name(names: names),
  ], name => CapacityManagedUnit { manager: SystemManager, unit: name })
}

fn roadmap_capacity_migration_transients(names: DeploymentNames, instance_id: String, operating_uid: Int) -> List<CapacityTransientFamily> {
  let activators = roadmap_capacity_migration_activators(names: names)
  let user_manager = UserManager { uid: operating_uid }
  let work_parent = CapacityManagedUnit { manager: user_manager, unit: user_work_slice_unit_name }
  [
    CapacityTransientFamily {
      standing: CapacityConfirmedWriter,
      manager: user_manager,
      source: decl_ref(module_path: "gunbc.roadmap.roadmap_belt_obligation", decl_name: "belt_attempt_obligation_unit_name"),
      patterns: [belt_attempt_obligation_unit_name(node_id: "*", attempt_key: "*")],
      activators: activators, parents: Ok { value: [work_parent] },
    },
    CapacityTransientFamily {
      standing: CapacityConfirmedWriter,
      manager: user_manager,
      source: decl_ref(module_path: "gunbc.roadmap.roadmap_belt_obligation", decl_name: "belt_instance_obligation_unit_name"),
      patterns: map(belt_instance_obligation_kinds, kind => belt_instance_obligation_unit_name(instance_id: instance_id, kind: kind)),
      activators: activators, parents: Ok { value: [work_parent] },
    },
    CapacityTransientFamily {
      standing: CapacityUnclassified { detail: "process entry reachability is not covered; retain this family in the drain" },
      manager: user_manager,
      source: decl_ref(module_path: "gunbc.roadmap.roadmap_dispatch_actuator", decl_name: "dispatch_review_unit_name"),
      patterns: [dispatch_review_unit_name(node_id: "*", attempt_key: "*", criterion_key: "*")],
      activators: activators, parents: Ok { value: [work_parent] },
    },
    CapacityTransientFamily {
      standing: CapacityUnclassified { detail: "process entry reachability is not covered; retain this family in the drain" },
      manager: user_manager,
      source: decl_ref(module_path: "gunbc.roadmap.roadmap_dispatch_actuator", decl_name: "dispatch_audit_unit_name"),
      patterns: [dispatch_audit_unit_name(node_id: "*", attempt_key: "*")],
      activators: activators, parents: Ok { value: [work_parent] },
    },
    CapacityTransientFamily {
      standing: CapacityUnclassified { detail: "process entry reachability is not covered; retain this family in the drain" },
      manager: SystemManager,
      source: decl_ref(module_path: "gunbc.roadmap.roadmap_dispatch_actuator", decl_name: "dispatch_attempt_unit_stem"),
      patterns: [join([dispatch_attempt_unit_stem(node_id: "*", attempt_key: "*"), systemd_service_unit_suffix], "") as NonEmptyStr],
      activators: activators,
      parents: Ok { value: [CapacityManagedUnit { manager: SystemManager, unit: attempt_worker_slice_unit_name }] },
    },
    CapacityTransientFamily {
      standing: CapacityConfirmedWriter,
      manager: user_manager,
      source: decl_ref(module_path: "gunbc.roadmap.roadmap_attempt_redelivery_wake", decl_name: "attempt_redelivery_wake_unit_name"),
      patterns: attempt_redelivery_wake_family_patterns(), activators: activators,
      // Lab 2611d8c0508b, 2026-10-29 15:47/15:55 UTC: the triggered service
      // was read in user app.slice. The anonymous self-wrap scope still has no
      // parent reading: cwd refusal ended it before sampling. Keep the combined
      // placement unresolved until the working-directory fix permits observation.
      parents: Err { value: "redelivery service observed in user app.slice; anonymous run-*.scope parent remains unread after workspace-root refusal; observe and bind the scope parent before migration" },
    },
  ]
}

// Scheduling output, including Err for any unresolved family. A coordinator must not
// discard that row and schedule a quiet window from the known subset.
fn roadmap_capacity_migration_parent_requirements(names: DeploymentNames, instance_id: String, operating_uid: Int) -> List<CapacityMigrationParentRequirement> {
  capacity_migration_family_parent_requirements(families: roadmap_capacity_migration_transients(names: names, instance_id: instance_id, operating_uid: operating_uid))
}
