type BeltAttempts
  = AttemptsObserved { attempts: List<DispatchAttemptRef> }
  | AttemptsRefused { reason: String }

// U3: the attempts observation mirrors belt_observe's fail-closed grammar — git absent or a
// non-zero for-each-ref is an UNKNOWABLE attempts set (AttemptsRefused, typed, carries stderr),
// never widened to zero; exit 0 with empty output IS a genuine zero (for-each-ref's documented
// no-match behavior). Runs in belt_actuate_workdir — the repo-root authority the spawn's worktree
// add uses, because attempt branches live where spawns mint them.
fn belt_attempts_observe_for_instance(instance: HostDashboardInstance) -> BeltAttempts {
  let cmd = git_for_each_ref_dispatch_argv_for_instance(instance: instance)
  if belt_program_available(program: cmd.program) {
    let result = gunbc.WitnessBin.Run(
      workdir: instance.repo_root,
      bin_path: cmd.program as FilePath,
      args: cmd.args,
    )
    if result.success {
      AttemptsObserved { attempts: dispatch_attempt_refs(git_output: result.stdout) }
    } else {
      AttemptsRefused { reason: concat("git for-each-ref failed: ", result.stderr) }
    }
  } else {
    AttemptsRefused { reason: "git not found on PATH — the attempts set is unknowable" }
  }
}

fn belt_attempts_observe() -> BeltAttempts {
  belt_attempts_observe_for_instance(instance: srv1_live_dashboard_instance())
}

fn belt_attempt_slots_json_members(slots: SessionSlotRecords) -> List<JsonKeyValue> {
  match slots {
    SessionSlotRecordsRead { records, unreadable } => [
      json_kv(key: "slots", value: json_array(elements: map(records, r => attempt_record_json(r: r)))),
      json_kv(key: "slots_unreadable", value: json_array(elements: map(unreadable, u => json_string(s: u)))),
    ]
    SessionSlotRecordsRefused { detail } => [
      json_kv(key: "slots_refused", value: json_string(s: detail)),
    ]
  }
}

fn belt_attempts_json_value(a: BeltAttempts, slots: SessionSlotRecords) -> JsonValue {
  match a {
    AttemptsRefused { reason: r } =>
      json_object(members: concat([
        json_kv(key: "schema", value: json_string(s: "roadmap-attempts/v1")),
        json_kv(key: "attempts_refused", value: json_bool(b: true)),
        json_kv(key: "reason", value: json_string(s: r)),
      ], belt_attempt_slots_json_members(slots: slots)))
    AttemptsObserved { attempts } =>
      json_object(members: concat([
        json_kv(key: "schema", value: json_string(s: "roadmap-attempts/v1")),
        json_kv(key: "attempts_refused", value: json_bool(b: false)),
        json_kv(key: "attempts", value: json_array(elements: attempts |> map(a2 => {
          let evidence = dispatch_attempt_evidence(attempt: a2)
          json_object(members: [
            json_kv(key: "node_id", value: json_string(s: a2.node_id)),
            json_kv(key: "branch", value: json_string(s: a2.branch)),
            json_kv(key: "attempt_key", value: json_string(s: a2.attempt_key)),
            json_kv(key: "worktree_evidence", value: json_string(s: worktree_evidence_label(evidence: evidence.worktree))),
            json_kv(key: "provider_evidence", value: json_string(s: provider_evidence_label(evidence: evidence.provider_instance))),
            json_kv(key: "process_identity_evidence", value: json_string(s: process_identity_evidence_label(evidence: evidence.process_identity))),
            json_kv(key: "transcript_evidence", value: json_string(s: transcript_evidence_label(evidence: evidence.transcript))),
            json_kv(key: "terminal_outcome_evidence", value: json_string(s: terminal_outcome_evidence_label(evidence: evidence.terminal_outcome))),
          ])
        }))),
      ], belt_attempt_slots_json_members(slots: slots)))
  }
}

fn belt_attempts_observed_json(a: BeltAttempts, slots: SessionSlotRecords) -> String {
  serialize_json(v: belt_attempts_json_value(a: a, slots: slots))
}

fn belt_attempts_http_status(a: BeltAttempts) -> Int {
  match a {
    AttemptsRefused { reason: _ } => 503
    AttemptsObserved { attempts: _ } => 200
  }
}

type BeltAttemptPanes
  = BeltAttemptPanesObserved { panes: List<TmuxAttemptPaneEntry> }
  | BeltAttemptPanesRefused { reason: String }

type BeltWorkflowAttempts
  = WorkflowAttemptsObserved { attempts: List<WorkflowAttemptProgress> }
  | WorkflowAttemptsRefused { reason: String }

// The workflow route joins the latest published attempt state to process evidence at node grain.
// Git refs determine which nodes have attempts; the node-current pointer selects the latest modeled
// attempt without guessing chronology from content-hash keys; Filesystem.Read observes the
// immutable key/admission prefix plus the append-only Codex JSONL; one exact tmux list-panes read
// observes alive/dead/exit for all attempts. A git refusal refuses the route. A pane-command or
// parse refusal stays located inside each attempt, so terminal provider evidence remains usable
// while incomplete attempts become refused.
fn belt_attempt_panes_observe_for_instance(
  instance: HostDashboardInstance,
) -> BeltAttemptPanes {
  let cmd = tmux_attempt_panes_argv_for_instance(instance: instance)
  if belt_program_available(program: cmd.program) {
    let result = gunbc.WitnessBin.Run(
      workdir: belt_observe_workdir,
      bin_path: cmd.program as FilePath,
      args: cmd.args,
      expect: OutcomeIsData,
    )
    if result.success {
      match parse_tmux_attempt_panes_output(output: result.stdout) {
        AttemptPanesParsed { panes } =>
          BeltAttemptPanesObserved { panes: panes }
        AttemptPanesParseRefused { line_number, raw, reason } =>
          BeltAttemptPanesRefused {
            reason: join([
              "tmux attempt-pane parse refused at line ",
              to_string(line_number),
              ": ",
              reason,
              "; raw=",
              raw,
            ], ""),
          }
      }
    } else {
      match classify_tmux_session_list(
        exit_ok: result.success,
        stdout: result.stdout,
        stderr: result.stderr,
      ) {
        TmuxNoServer { evidence: _ } =>
          BeltAttemptPanesObserved { panes: [] }
        TmuxSessionsListed { entries: _ } =>
          BeltAttemptPanesRefused {
            reason: join([
              "tmux attempt-pane observation failed: ",
              result.stderr,
            ], ""),
          }
        TmuxListUnknowable { stderr: e } =>
          BeltAttemptPanesRefused {
            reason: join([
              "tmux attempt-pane observation failed: ",
              e,
            ], ""),
          }
        TmuxListStdoutRefused { line_number, raw, reason } =>
          BeltAttemptPanesRefused {
            reason: belt_ls_stdout_refusal_reason(
              line_number: line_number,
              raw: raw,
              reason: reason,
            ),
          }
      }
    }
  } else {
    BeltAttemptPanesRefused {
      reason: "tmux realization is not executable; process state is unknowable",
    }
  }
}

// The sessions route has two probes with independent authority. tmux ls decides only which session
// containers are present; if it refuses, the session set refuses. The richer pane probe decides
// process running/exited/unobserved and cleanup eligibility per observed session; its refusal does
// NOT erase known presence — every present session maps to process-unobserved and
// cleanup-unavailable with the located pane reason. The UI can say `session present · process
// unknown` instead of fabricating liveness or hiding the container.
// THE FINGERPRINT EACH LIVE NODE'S CURRENT ATTEMPT RECORDED AT SPAWN. A node with no current-attempt
// directory, or whose directory has no record, predates the record and contributes nothing, so its
// session keeps the default-selection scope. Any other unreadable state REFUSES the observation:
// substituting the default scope for a record that exists but cannot be read would judge a vendor
// attempt's pane against the harness's fingerprint, which is the misclassification the record exists
// to prevent.
type RecordedFingerprintsRead
  = RecordedFingerprintsOk { recorded: List<RecordedAttemptFingerprint> }
  | RecordedFingerprintsUnreadable { reason: String }

fn belt_recorded_fingerprint_for_node(
  instance: HostDashboardInstance,
  node_id: String,
) -> RecordedFingerprintsRead {
  let root = dashboard_instance_dispatch_attempt_state_root(instance: instance) as String
  let current_name = join([node_id, "-current"], "")
  let root_listing = Filesystem.List(path: root)
  match filesystem_entry_presence(
    listing: filesystem_listing_observation(directory: root, success: root_listing.success, entries: root_listing.entries, error: root_listing.error),
    name: current_name,
  ) {
    FilesystemEntryAbsent(_) => RecordedFingerprintsOk { recorded: [] }
    FilesystemEntryPresenceIndeterminate { cause } => RecordedFingerprintsUnreadable { reason: cause }
    FilesystemEntrySubjectRefused { directory: _, name: _, cause } => RecordedFingerprintsUnreadable { reason: cause }
    FilesystemEntryListed { directory: _, name: _ } => {
      let path = dispatch_current_attempt_process_fingerprint_path_for_instance(instance: instance, node_id: node_id as RoadmapNodeId)
      let dir = join([root, "/", current_name], "")
      let listing = Filesystem.List(path: dir)
      let read = Filesystem.Read(path: path)
      match filesystem_file_observation(
        listing: filesystem_listing_observation(directory: dir, success: listing.success, entries: listing.entries, error: listing.error),
        name: "process-fingerprint",
        path: path,
        read: filesystem_read_outcome(content: read.content, success: read.success, error: read.error),
      ) {
        FilesystemFileAbsent(_) => RecordedFingerprintsOk { recorded: [] }
        FilesystemFileRead { path: _, content } =>
          if trim(s: content) == "" {
            RecordedFingerprintsUnreadable { reason: join(["the recorded process fingerprint at ", path, " is empty"], "") }
          } else {
            RecordedFingerprintsOk {
              recorded: [RecordedAttemptFingerprint { node_id: node_id, fingerprint: trim(s: content) as NonEmptyStr }],
            }
          }
        FilesystemFileIndeterminate { cause } => RecordedFingerprintsUnreadable { reason: cause }
        FilesystemFileObservationsDisagree { path: _, cause } => RecordedFingerprintsUnreadable { reason: cause }
        FilesystemFileSubjectRefused { directory: _, name: _, cause } => RecordedFingerprintsUnreadable { reason: cause }
      }
    }
  }
}

fn belt_recorded_fingerprints_for_entries(
  instance: HostDashboardInstance,
  entries: List<TmuxLsEntry>,
) -> RecordedFingerprintsRead {
  fold(
    filter_dispatch_tmux_sessions(entries: entries),
    init: RecordedFingerprintsOk { recorded: [] },
    f: (acc, e) =>
      match acc {
        RecordedFingerprintsUnreadable { reason: _ } => acc
        RecordedFingerprintsOk { recorded } =>
          match belt_recorded_fingerprint_for_node(
            instance: instance,
            node_id: dispatch_node_id_from_session_name(session_name: e.session_name),
          ) {
            RecordedFingerprintsUnreadable { reason } => RecordedFingerprintsUnreadable { reason: reason }
            RecordedFingerprintsOk { recorded: mine } => RecordedFingerprintsOk { recorded: concat(recorded, mine) }
          }
      },
  )
}

fn belt_sessions_observe_for_instance(
  instance: HostDashboardInstance,
) -> BeltObserve {
  let ls = tmux_ls_argv_for_instance(instance: instance)
  if belt_program_available(program: ls.program) {
    let result = gunbc.WitnessBin.Run(
      workdir: belt_observe_workdir,
      bin_path: ls.program as FilePath,
      args: ls.args,
      expect: OutcomeIsData,
    )
    if result.success {
      match classify_tmux_session_list(
        exit_ok: result.success,
        stdout: result.stdout,
        stderr: result.stderr,
      ) {
        TmuxSessionsListed { entries } =>
          match belt_recorded_fingerprints_for_entries(instance: instance, entries: entries) {
            RecordedFingerprintsUnreadable { reason } =>
              ObserveRefused { reason: join(["a live dispatch attempt's recorded process fingerprint is unreadable: ", reason], "") }
            RecordedFingerprintsOk { recorded } =>
          match belt_attempt_panes_observe_for_instance(instance: instance) {
            BeltAttemptPanesObserved { panes } =>
              BeltSessionsObserved {
                live: dispatch_live_sessions_with_process(
                  entries: entries,
                  panes: panes,
                  pane_observation_refusal: "",
                  selection: dispatch_actuator_selection(sizing_expectation: NoDerivedSizingExpectation),
                  recorded: recorded,
                ),
              }
            BeltAttemptPanesRefused { reason } =>
              BeltSessionsObserved {
                live: dispatch_live_sessions_with_process(
                  entries: entries,
                  panes: [],
                  pane_observation_refusal: reason,
                  selection: dispatch_actuator_selection(sizing_expectation: NoDerivedSizingExpectation),
                  recorded: recorded,
                ),
              }
          }
          }
        TmuxListStdoutRefused { line_number, raw, reason } =>
          ObserveRefused {
            reason: belt_ls_stdout_refusal_reason(
              line_number: line_number,
              raw: raw,
              reason: reason,
            ),
          }
        TmuxNoServer { evidence: _ } =>
          BeltSessionsObserved { live: [] }
        TmuxListUnknowable { stderr: e } =>
          ObserveRefused {
            reason: concat(
              "belt_sessions_observe: tmux ls failed; session containers are unknowable. stderr: ",
              e,
            ),
          }
      }
    } else {
      match classify_tmux_session_list(
        exit_ok: result.success,
        stdout: result.stdout,
        stderr: result.stderr,
      ) {
        TmuxNoServer { evidence: _ } =>
          BeltSessionsObserved { live: [] }
        TmuxSessionsListed { entries: _ } =>
          ObserveRefused {
            reason: concat(
              "belt_sessions_observe: tmux ls failed; session containers are unknowable. stderr: ",
              result.stderr,
            ),
          }
        TmuxListUnknowable { stderr: e } =>
          ObserveRefused {
            reason: concat(
              "belt_sessions_observe: tmux ls failed; session containers are unknowable. stderr: ",
              e,
            ),
          }
        TmuxListStdoutRefused { line_number, raw, reason } =>
          ObserveRefused {
            reason: belt_ls_stdout_refusal_reason(
              line_number: line_number,
              raw: raw,
              reason: reason,
            ),
          }
      }
    }
  } else {
    ObserveRefused {
      reason: "belt_sessions_observe: tmux not found; session containers are unknowable",
    }
  }
}

fn belt_sessions_observe() -> BeltObserve {
  belt_sessions_observe_for_instance(
    instance: srv1_live_dashboard_instance(),
  )
}

// ------------------------------------------------------------------------------------------------
// THE REALIZATION-NEUTRAL OCCURRENCE POPULATION (branch review 2026-09-23, blocker 1). The launch
// census ran the tmux observation alone, so a production attempt held by a systemd transient unit
// was invisible to AlreadyLive and to capacity. This observer unions the tmux sessions, the
// system-manager gunbc-attempt-* units, and the durable attempt records (the attempts ledger joined
// with each attempt's persisted launch identity), and the pure producer
// (gunbc.roadmap.roadmap_attempt_occurrence) assigns every discovered container to exactly one
// arm. Either probe's refusal refuses the population: a census computed over half the population
// is the original defect wearing a new arm.
// ------------------------------------------------------------------------------------------------

type BeltOccurrencePopulation
  = OccurrencePopulationObserved { occurrences: List<DispatchAttemptOccurrence> }
  | OccurrencePopulationRefused { reason: String }

// Attempt workers live on the system manager; supervisors remain user-manager transients.
fn belt_occurrence_unit_names() -> List<String>? {
  let attempts = systemd.Systemctl.ListUnitsAllLoaded(pattern: "gunbc-attempt-*" as NonEmptyStr)
  if !attempts.success {
    none
  } else {
    Present { value: systemctl_list_units_all_states_from_stdout(stdout: attempts.stdout) }
  }
}

fn systemctl_list_units_all_states_from_stdout(stdout: String) -> List<String> {
  let t = trim(stdout)
  if t == "" {
    []
  } else {
    split(s: t, delimiter: "\n")
      |> filter(l => trim(l) != "")
      |> map(l => match split(s: trim(l), delimiter: " ").first() {
        Present { value: name } => name
        Absent => "systemctl-unit-line-empty"
      })
  }
}

// A unit's process evidence is the same per-unit read the convene gate and the progress observer
// already make -- one observation, three consumers, no second reading of liveness.
fn belt_occurrence_unit_row(unit: String) -> ObservedContainerRow {
  ObservedContainerRow {
    container: AttemptContainerSystemdUnit { unit: unit },
    process: worker_process_from_attempt_unit(
      observation: attempt_unit_observation(unit: unit as NonEmptyStr),
      unit: unit as NonEmptyStr,
    ),
  }
}

// THE PERSISTED SPAWN IDENTITY IS THE RECORD'S CONTENT, not a current selection. The launch
// identity the attempt was admitted under is read back from its own attempt-state path; an
// attempt with no launch record produces no record, so a live container over it joins nothing and
// reads Unclassified -- visible, occupying, never reaped -- rather than borrowing today's selection
// as its meaning, and a record-less attempt with no live container is historical, never a census
// row (gunbc.roadmap.roadmap_attempt_occurrence occurrence_population).
// NO RECORD AND AN UNKNOWN RECORD ARE TWO FACTS. Before the fold conversion an unreadable launch
// record returned [] and the census lost the attempt without a word; the conversion then refused
// on every failed read, which made an ESTABLISHED absence -- an attempt dispatched before launch
// identities were written, or whose attempt state is gone -- poison the whole live-session census
// on every tick (srv1, 2026-10-10: ten July/August dispatch branches refused every spawn pass and
// rendered every row Unknown). Absence is established from a successful listing of the attempt
// directory's parent and of the directory itself, through the filesystem_io folds; anything that
// could not be looked at, did not decode, or moved while observed still refuses, naming the attempt.
type AttemptOccurrenceRecordRead
  = AttemptOccurrenceRecordDecoded { record: DurableAttemptRecord }
  | AttemptOccurrenceRecordAbsent { absence: FilesystemEstablishedAbsence }
  | AttemptOccurrenceRecordRefused { reason: NonEmptyStr }

fn belt_occurrence_record_unobserved(attempt: DispatchAttemptRef, cause: String) -> AttemptOccurrenceRecordRead {
  AttemptOccurrenceRecordRefused { reason: join(["attempt ", attempt.attempt_key, ": the launch record could not be observed, so its durable occurrence is unknown: ", cause], "") }
}

fn belt_occurrence_record_from_launch_content(attempt: DispatchAttemptRef, content: String) -> AttemptOccurrenceRecordRead {
  match parse_json_document(s: content) {
    JsonDocumentUnreadable { gap } =>
      AttemptOccurrenceRecordRefused { reason: join(["attempt ", attempt.attempt_key, ": the launch record does not decode as JSON: ", gap], "") }
    JsonDocumentParsed { value: doc } =>
      match launch_identity_of_json(doc: doc) {
        LaunchIdentityUnreadable { reason } =>
          AttemptOccurrenceRecordRefused { reason: join(["attempt ", attempt.attempt_key, ": the launch record carries no readable launch identity: ", reason], "") }
        LaunchIdentityDecoded { identity } =>
          AttemptOccurrenceRecordDecoded {
            record: DurableAttemptRecord {
              node: attempt.node_id as String,
              attempt: attempt.attempt_key,
              spawn_identity: join([
                "cause=", launch_cause_label(c: identity.cause),
                " mode=", spawn_mode_label(m: identity.mode),
                " instance=", identity.instance_id as String,
                " revision=", git_object_id_wire_hex(oid: identity.revision) as String,
              ], ""),
            },
          }
      }
  }
}

// ONE OBSERVATION PER DECISION, IN SEQUENCE. The attempt directory's presence under the attempt-state
// root is observed first, and the launch record inside it only when that listing names the
// directory: a missing directory makes the record's own listing fail, which is indeterminate rather
// than absent, and observing both up front would join two instants -- a directory that appeared
// between the calls would pair "absent" with a readable record (review 78482). Sequenced, the absent
// arm consults nothing else, and a directory that vanished after being listed reaches the record
// observation as a failed listing, which refuses.
type AttemptDirectoryStanding
  = AttemptDirectoryListed
  | AttemptDirectoryDecided { read: AttemptOccurrenceRecordRead }

fn belt_occurrence_attempt_directory_standing(attempt: DispatchAttemptRef, directory: FilesystemEntryPresence) -> AttemptDirectoryStanding {
  match directory {
    FilesystemEntryAbsent(absence) =>
      AttemptDirectoryDecided { read: AttemptOccurrenceRecordAbsent { absence: absence } }
    FilesystemEntryPresenceIndeterminate { cause } => AttemptDirectoryDecided { read: belt_occurrence_record_unobserved(attempt: attempt, cause: cause) }
    FilesystemEntrySubjectRefused { directory: _, name: _, cause } => AttemptDirectoryDecided { read: belt_occurrence_record_unobserved(attempt: attempt, cause: cause) }
    FilesystemEntryListed { directory: _, name: _ } => AttemptDirectoryListed
  }
}

fn belt_occurrence_record_from_launch_observation(attempt: DispatchAttemptRef, launch: FilesystemFileObservation) -> AttemptOccurrenceRecordRead {
  match launch {
    FilesystemFileAbsent(absence) =>
      AttemptOccurrenceRecordAbsent { absence: absence }
    FilesystemFileRead { path: _, content } => belt_occurrence_record_from_launch_content(attempt: attempt, content: content)
    FilesystemFileIndeterminate { cause } => belt_occurrence_record_unobserved(attempt: attempt, cause: cause)
    FilesystemFileObservationsDisagree { path: _, cause } => belt_occurrence_record_unobserved(attempt: attempt, cause: cause)
    FilesystemFileSubjectRefused { directory: _, name: _, cause } => belt_occurrence_record_unobserved(attempt: attempt, cause: cause)
  }
}

fn belt_occurrence_record_for_attempt(instance: HostDashboardInstance, attempt: DispatchAttemptRef) -> AttemptOccurrenceRecordRead {
  let node_id = attempt.node_id as gunbc.roadmap.roadmap_model.RoadmapNodeId
  let directory = filesystem_entry_presence_of_path(
    path: dispatch_attempt_state_path_for_instance(instance: instance, node_id: node_id, attempt_key: attempt.attempt_key),
  )
  match belt_occurrence_attempt_directory_standing(attempt: attempt, directory: directory) {
    AttemptDirectoryDecided { read } => read
    AttemptDirectoryListed =>
      belt_occurrence_record_from_launch_observation(
        attempt: attempt,
        launch: filesystem_file_observation_of_path(
          path: dispatch_attempt_launch_path_for_instance(instance: instance, node_id: node_id, attempt_key: attempt.attempt_key),
        ),
      )
  }
}

// One unobservable attempt refuses the whole census rather than shrinking it silently: a census with
// a hole is not a census. The refusal names every attempt whose record could not be observed. An
// established absence is not a hole: the attempt contributes no record, exactly as the join reads it.
type BeltAttemptOccurrenceRecords
  = BeltAttemptOccurrenceRecordsObserved { records: List<DurableAttemptRecord> }
  | BeltAttemptOccurrenceRecordsRefused { reason: NonEmptyStr }

fn belt_occurrence_records_for_instance(instance: HostDashboardInstance) -> BeltAttemptOccurrenceRecords {
  match belt_attempts_observe_for_instance(instance: instance) {
    AttemptsRefused { reason } =>
      BeltAttemptOccurrenceRecordsRefused { reason: join(["the attempt population is unobservable: ", reason], "") }
    AttemptsObserved { attempts } => {
      let outcomes = map(attempts, a => belt_occurrence_record_for_attempt(instance: instance, attempt: a))
      let refusal_reasons = fold(outcomes, init: [], f: (acc, o) => match o {
        AttemptOccurrenceRecordRefused { reason } => concat(acc, [reason as String])
        AttemptOccurrenceRecordAbsent { absence: _ } => acc
        AttemptOccurrenceRecordDecoded { record: _ } => acc
      })
      if any(outcomes, o => match o {
        AttemptOccurrenceRecordRefused { reason: _ } => true
        AttemptOccurrenceRecordAbsent { absence: _ } => false
        AttemptOccurrenceRecordDecoded { record: _ } => false
      }) {
        BeltAttemptOccurrenceRecordsRefused { reason: join(refusal_reasons, "; ") as NonEmptyStr }
      } else {
        BeltAttemptOccurrenceRecordsObserved {
          records: flat_map(outcomes, o => match o {
            AttemptOccurrenceRecordDecoded { record: r } => [r]
            AttemptOccurrenceRecordAbsent { absence: _ } => []
            AttemptOccurrenceRecordRefused { reason: _ } => []
          }),
        }
      }
    }
  }
}
fn belt_attempt_occurrences_observe_for_instance(instance: HostDashboardInstance) -> BeltOccurrencePopulation {
  match belt_sessions_observe_for_instance(instance: instance) {
    ObserveRefused { reason } =>
      OccurrencePopulationRefused { reason: join(["the tmux population is unobservable: ", reason], "") }
    BeltSessionsObserved { live } =>
      match belt_occurrence_unit_names() {
        Absent =>
          OccurrencePopulationRefused { reason: "the user manager's gunbc unit population is unobservable; the census over half the population is unknowable" }
        Present { value: unit_names } =>
          match belt_occurrence_records_for_instance(instance: instance) {
            BeltAttemptOccurrenceRecordsRefused { reason } =>
              OccurrencePopulationRefused { reason: join(["the durable attempt records are unobservable; occurrence identity cannot be joined: ", reason], "") }
            BeltAttemptOccurrenceRecordsObserved { records } =>
              OccurrencePopulationObserved {
                occurrences: occurrence_population(
                  containers: concat(
                    map(live, s => ObservedContainerRow {
                      container: AttemptContainerTmux { session: s.session_name },
                      process: s.worker.process,
                    }),
                    map(unit_names, u => belt_occurrence_unit_row(unit: u)),
                  ),
                  records: records,
                ),
              }
          }
      }
  }
}


// NO PANE MEANS ASK THE OTHER CONTAINER, NOT CONCLUDE ABSENCE. An attempt is held by exactly one
// container -- a tmux pane for the vendor CLIs, a transient unit for the gunbc harness -- so these
// are two observations over DISJOINT populations rather than a precise reading with a widened
// fallback behind it. Answering WorkerProcessAbsent from a missing pane reported every unit-backed
// attempt as a worker that never started, which is what the dashboard showed while three workers
// were running.
//
// The order is pane-then-unit only because the pane observation is already in hand; it is not a
// preference between them. A vendor attempt whose pane is genuinely gone asks the manager, gets
// not-found, finds no exit record and no placement record, and answers WorkerProcessAbsent exactly as
// before -- so this adds a population without changing the answer for the one that already worked. A
// harness attempt whose unit has been collected is read from its exit record
// (gunbc.roadmap.roadmap_session_placement attempt_worker_unit_observe_for_instance).
fn attempt_process_for_node(
  instance: HostDashboardInstance,
  panes: BeltAttemptPanes,
  node_id: String,
  attempt_key: String,
) -> WorkerProcessEvidence {
  match panes {
    BeltAttemptPanesRefused { reason } =>
      WorkerProcessUnobserved { reason: reason as NonEmptyStr }
    BeltAttemptPanesObserved { panes: observed } => {
      let session_name = dispatch_tmux_session_name(
        node_id: node_id as gunbc.roadmap.roadmap_model.RoadmapNodeId,
      )
      let matched = observed |> filter(pane =>
        pane.session_name == session_name)
      match matched.first() {
        Absent =>
          match dispatch_attempt_unit_name(node_id: node_id, attempt_key: attempt_key) {
            SystemdUnitNameStemEmpty =>
              WorkerProcessUnobserved {
                reason: systemd_unit_name_refusal_detail(admission: SystemdUnitNameStemEmpty) as NonEmptyStr,
              }
            SystemdUnitNameDisallowedCharacter { stem: s, character: ch } =>
              WorkerProcessUnobserved {
                reason: systemd_unit_name_refusal_detail(admission: SystemdUnitNameDisallowedCharacter { stem: s, character: ch }) as NonEmptyStr,
              }
            SystemdUnitNameOverlong { length: n } =>
              WorkerProcessUnobserved {
                reason: systemd_unit_name_refusal_detail(admission: SystemdUnitNameOverlong { length: n }) as NonEmptyStr,
              }
            SystemdUnitNameAdmitted { name } =>
              worker_process_from_attempt_unit(
                observation: attempt_worker_unit_observe_for_instance(instance: instance, node_id: node_id, attempt_key: attempt_key),
                unit: systemd_unit_name_wire(name: name),
              )
          }
        Present { value: pane } =>
          worker_process_from_attempt_pane(pane: pane)
      }
    }
  }
}

fn dispatch_attempt_ref_first_per_node(
  attempts: List<DispatchAttemptRef>,
) -> List<DispatchAttemptRef> {
  fold(attempts, init: [], f: fn(acc, attempt) {
    if any(acc, existing => existing.node_id == attempt.node_id) {
      acc
    } else {
      append(acc, [attempt])
    }
  })
}

fn belt_validation_summary_for_node(
  instance: HostDashboardInstance,
  node_id: String,
) -> String {
  match belt_lookup_node(node_id: node_id) {
    AuthorityProjectionRefused { detail: _ } => ""
    NodeMissing => ""
    NodeFound { node } =>
      execution_contract_validation_summary(
        contract: node.execution,
        environment: instance.execution_environment,
      )
  }
}

type ProviderEventProjectionObservation
  = ProviderEventProjectionObserved { events: String }
  | ProviderEventProjectionRefused { reason: String }

fn belt_provider_event_projection_observe_for_instance(
  instance: HostDashboardInstance,
  node_id: gunbc.roadmap.roadmap_model.RoadmapNodeId,
) -> ProviderEventProjectionObservation {
  belt_provider_event_projection_observe_at(
    instance: instance,
    events_path: dispatch_current_attempt_events_path_for_instance(instance: instance, node_id: node_id),
  )
}

fn belt_provider_event_projection_observe_at(
  instance: HostDashboardInstance,
  events_path: String,
) -> ProviderEventProjectionObservation {
  match belt_exec(
    cmd: dispatch_events_projection_argv_at(instance: instance, events_path: events_path),
    workdir: instance.repo_root as String,
  ) {
    ExecOk { stdout } =>
      ProviderEventProjectionObserved { events: stdout }
    ExecFailed { program, exit_code, stderr } =>
      ProviderEventProjectionRefused {
        reason: join([
          "provider event projection failed through ",
          program,
          " (exit ",
          to_string(exit_code),
          "): ",
          stderr,
        ], ""),
      }
    ExecRefused { program, reason } =>
      ProviderEventProjectionRefused {
        reason: join([
          "provider event projection unavailable through ",
          program,
          ": ",
          reason,
        ], ""),
      }
  }
}

fn provider_event_projection_readable(
  observation: ProviderEventProjectionObservation,
) -> Bool {
  match observation {
    ProviderEventProjectionObserved { events: _ } => true
    ProviderEventProjectionRefused { reason: _ } => false
  }
}

fn provider_event_projection_events(
  observation: ProviderEventProjectionObservation,
) -> String {
  match observation {
    ProviderEventProjectionObserved { events } => events
    ProviderEventProjectionRefused { reason: _ } => ""
  }
}

fn provider_event_projection_error(
  observation: ProviderEventProjectionObservation,
) -> String {
  match observation {
    ProviderEventProjectionObserved { events: _ } => ""
    ProviderEventProjectionRefused { reason } => reason
  }
}

// THE RECEIPT IS ADDRESSED BY HEAD, SO THERE IS NO PATH TO READ UNTIL THE HEAD IS KNOWN — the point
// of the ordering: the other receipts on this row live at one path per attempt and can be read
// before anything is decided; a publication receipt is one per head, so the subject must exist
// before the address does.
//
// THE UNOBSERVED ARM ANSWERS ReceiptSourceAbsent AND THAT IS NOT A FABRICATED ABSENCE.
// publication_segment refuses on an unobserved subject before consulting the source, so this value
// never reaches a judgment; it exists because the evidence record carries a source for every stage
// and there is no address to consult here. If the projection stopped refusing first this would
// become a real answer — which is why the refusal there matches on the subject rather than being
// inferred here.
//
// EVERY OBSERVED ARM CONSUMES THE FILESYSTEM AUTHORITY. filesystem_entry_presence decides whether
// the publication directory is listed; filesystem_file_observation decides the head-addressed
// receipt. ReceiptSourceAbsent can be projected only from FilesystemEstablishedAbsence, whose sole
// mint consumes a successful directory listing; this module carries neither a prose copy of that
// law nor a second spelling of List's membership encoding. Listing refusal, listed-but-unreadable,
// and disagreeing observations all project to ReceiptSourceUnreadable.
// A REFUSED SUBJECT IS UNREADABLE, NEVER ABSENT. A subject that was never admitted established no
// absence, so answering `ReceiptSourceAbsent` for it would be exactly the fail-open the filesystem
// fold exists to prevent -- a receipt reported as not-there on outcomes that establish nothing.
fn belt_publication_receipt_source(
  instance: HostDashboardInstance,
  node_id: RoadmapNodeId,
  attempt_key: String,
  subject: PublicationSubjectObservation,
) -> PublicationReceiptSource {
  match subject {
    PublicationSubjectUnobserved { reason: _ } => ReceiptSourceAbsent
    PublicationSubjectObserved { subject: observed } => {
      let attempt_dir = dispatch_attempt_state_path_for_instance(
        instance: instance,
        node_id: node_id,
        attempt_key: attempt_key,
      )
      let attempt_listing = Filesystem.List(path: attempt_dir)
      match filesystem_entry_presence(
        listing: filesystem_listing_observation(
          directory: attempt_dir,
          success: attempt_listing.success,
          entries: attempt_listing.entries,
          error: attempt_listing.error,
        ),
        name: publication_receipt_directory_segment,
      ) {
        FilesystemEntryPresenceIndeterminate { cause: c } =>
          ReceiptSourceUnreadable { detail: c }
        FilesystemEntrySubjectRefused { directory: d, name: n, cause: c } =>
          ReceiptSourceUnreadable {
            detail: join([
              "the attempt directory ", d, " is not a directory subject, so ", n,
              " is established by nothing the fold received -- ", c,
            ], ""),
          }
        FilesystemEntryAbsent(_) => ReceiptSourceAbsent
        FilesystemEntryListed { directory: _, name: _ } => {
          let publication_dir = dispatch_attempt_publication_dir_for_instance(
            instance: instance,
            node_id: node_id,
            attempt_key: attempt_key,
          )
          let receipt_basename = join([observed.expected_head as String, ".json"], "")
          let path = dispatch_attempt_publication_receipt_path_for_instance(
            instance: instance,
            node_id: node_id,
            attempt_key: attempt_key,
            head_sha: observed.expected_head as String,
          )
          let publication_listing = Filesystem.List(path: publication_dir)
          let read = Filesystem.Read(path: path)
          match filesystem_file_observation(
            listing: filesystem_listing_observation(
              directory: publication_dir,
              success: publication_listing.success,
              entries: publication_listing.entries,
              error: publication_listing.error,
            ),
            name: receipt_basename,
            path: path,
            read: filesystem_read_outcome(
              content: read.content,
              success: read.success,
              error: read.error,
            ),
          ) {
            FilesystemFileIndeterminate { cause: c } =>
              ReceiptSourceUnreadable { detail: c }
            FilesystemFileObservationsDisagree { path: _, cause: c } =>
              ReceiptSourceUnreadable { detail: c }
            FilesystemFileSubjectRefused { directory: d, name: n, cause: c } =>
              ReceiptSourceUnreadable {
                detail: join([
                  "the publication directory ", d, " is not a directory subject, so ", n,
                  " is established by nothing the fold received -- ", c,
                ], ""),
              }
            FilesystemFileAbsent(_) => ReceiptSourceAbsent
            FilesystemFileRead { path: _, content: text } =>
              ReceiptSourcePresent { text: text }
          }
        }
      }
    }
  }
}

fn belt_publish_current_verification_selection(
  instance: HostDashboardInstance,
  node_id: RoadmapNodeId,
  attempt_key: String,
  subject: VerificationSubject,
) -> VerificationSelectionPublishOutcome {
  let path = dispatch_attempt_verification_current_selection_path_for_instance(
    instance: instance,
    node_id: node_id,
    attempt_key: attempt_key,
    head_sha: subject.head_sha as String,
  )
  let write = Filesystem.Write(
    path: path,
    content: current_verification_selection_json(
      selection: CurrentVerificationSelection {
        head_sha: subject.head_sha,
        change_window_identity: subject.change_window_identity,
      },
    ),
  )
  if write.success {
    VerificationSelectionPublished { path: path }
  } else {
    VerificationSelectionPublishRefused {
      path: path,
      cause: join([
        "the belt could not publish the current verification selection: ",
        write.error,
      ], ""),
    }
  }
}

fn belt_verification_selection_observe(
  instance: HostDashboardInstance,
  node_id: RoadmapNodeId,
  attempt_key: String,
  head_sha: String,
) -> CurrentVerificationSelectionObservation {
  current_verification_selection_observe(
    attempt_dir: dispatch_attempt_state_path_for_instance(
      instance: instance,
      node_id: node_id,
      attempt_key: attempt_key,
    ),
    verification_dir: dispatch_attempt_verification_dir_for_instance(
      instance: instance,
      node_id: node_id,
      attempt_key: attempt_key,
    ),
    head_sha: head_sha,
  )
}

// THE SHARED-COMPUTATION READER. For one attempt and the head it is verifying, it follows the belt's
// own published selection to the exact verification receipt and returns what that receipt says ran as
// shared computation. The observation is closed: Observed carries every compute citation the receipt
// holds (one per claim validation); Absent is POSITIVE and says which of three absences was
// established; Refused is anything that could not be read or decoded, carrying the observation's own
// refusal text, and never collapses to Absent.
type SharedComputationAbsence
  = NoVerificationSelectionPublished
  | SelectedReceiptNotWritten
  | ReceiptRecordsNoSharedComputation

type SharedComputationObservation
  = SharedComputationObserved { head_sha: String, window_identity: Fnv1a64Structural, citations: List<SharedComputationCitation> }
  | SharedComputationAbsent { absence: SharedComputationAbsence }
  | SharedComputationRefused { cause: String }

// DECLARED FRONTIER (DESIGN section 3c): this reader's consumer is the dogfood route's
// shared-computation stage, gunbc.roadmap.roadmap_dogfood_route DogfoodRouteReceipt (gunbc#13077), which is not
// on this change's base.
data shared_computation_reader_consumer_frontier: DissolutionCondition = unbound_dissolution(description: "TRIGGER: gunbc.roadmap.roadmap_dogfood_route (gunbc#13077) reads its shared-computation stage by calling gunbc.roadmap.roadmap_belt_actuate shared_computation_observe_for_attempt for the attempt and head it receipts. SUFFICIENT FOR: the reader's three arms reach the DogfoodRouteReceipt on the production route; retired by that landing and nothing else." as NonEmptyStr)

fn shared_computation_observe_for_attempt(
  instance: HostDashboardInstance,
  attempt: DispatchAttemptRef,
  head_sha: String,
) -> SharedComputationObservation {
  let node_id = attempt.node_id as gunbc.roadmap.roadmap_model.RoadmapNodeId
  let attempt_dir = dispatch_attempt_state_path_for_instance(instance: instance, node_id: node_id, attempt_key: attempt.attempt_key)
  let verification_dir = dispatch_attempt_verification_dir_for_instance(instance: instance, node_id: node_id, attempt_key: attempt.attempt_key)
  match current_verification_selection_observe(attempt_dir: attempt_dir, verification_dir: verification_dir, head_sha: head_sha) {
    SelectionAbsent => SharedComputationAbsent { absence: NoVerificationSelectionPublished }
    SelectionUnaddressable { cause } => SharedComputationRefused { cause: cause }
    SelectionUnreadable { cause } => SharedComputationRefused { cause: cause }
    SelectionMalformed { cause } => SharedComputationRefused { cause: cause }
    SelectionObserved { head, window_identity } =>
      match exact_verification_receipt_source_read(
        attempt_dir: attempt_dir,
        verification_dir: verification_dir,
        receipt_basename: exact_verification_receipt_basename(head_sha: head as String, window_identity_hex: git_diff_window_identity_hex(identity: window_identity)),
      ) {
        ExactVerificationReceiptAbsent => SharedComputationAbsent { absence: SelectedReceiptNotWritten }
        ExactVerificationReceiptUnreadable { detail } => SharedComputationRefused { cause: detail }
        ExactVerificationReceiptPresent { text } =>
          match verification_receipt_decode(receipt: text) {
            VerificationReceiptUndecodable { reason } => SharedComputationRefused { cause: reason }
            VerificationReceiptDecoded { receipt } => {
              let citations = fold(receipt.executions, init: [], f: (acc, e) => match e.computation {
                Present { value: c } => acc |> append(c)
                Absent => acc
              })
              if count(citations) == 0 {
                SharedComputationAbsent { absence: ReceiptRecordsNoSharedComputation }
              } else {
                SharedComputationObserved { head_sha: head as String, window_identity: window_identity, citations: citations }
              }
            }
          }
      }
  }
}

fn belt_verification_subject_from_selection(
  node: RoadmapNode,
  attempt_key: String,
  branch: String,
  head: CommitSha,
  selection: CurrentVerificationSelectionObservation,
) -> VerificationSubjectObservation {
  match selection {
    SelectionUnaddressable { cause } =>
      VerificationSubjectUnobserved { reason: cause }
    SelectionAbsent =>
      VerificationSubjectAwaitingSelection { head: head as String }
    SelectionUnreadable { cause } =>
      VerificationSubjectUnobserved { reason: cause }
    SelectionMalformed { cause } =>
      VerificationSubjectUnobserved { reason: cause }
    SelectionObserved { head: selected_head, window_identity } =>
      if (selected_head as String) != (head as String) {
        VerificationSubjectUnobserved {
          reason: join([
            "the current verification selection names head ",
            selected_head as String,
            " but the worktree head is ",
            head as String,
          ], ""),
        }
      } else {
        match node_criteria_digest(rn: node) {
          Absent =>
            VerificationSubjectUnobserved {
              reason: "this roadmap node has no criteria digest, so the verification subject cannot be constructed",
            }
          Present { value: criteria_digest } =>
            VerificationSubjectObserved {
              subject: VerificationSubject {
                node_identity: node.identity,
                criteria_digest: criteria_digest,
                attempt_key: attempt_key,
                branch: branch as NonEmptyStr,
                head_sha: head,
                change_window_identity: window_identity,
              },
            }
        }
      }
  }
}

fn belt_verification_receipt_source_for_selection(
  instance: HostDashboardInstance,
  node_id: RoadmapNodeId,
  attempt_key: String,
  head_sha: String,
  window_identity_hex: String,
) -> VerificationReceiptFileSource {
  let address = exact_verification_address_for(
    attempt_dir: dispatch_attempt_state_path_for_instance(
      instance: instance,
      node_id: node_id,
      attempt_key: attempt_key,
    ),
    verification_dir: dispatch_attempt_verification_dir_for_instance(
      instance: instance,
      node_id: node_id,
      attempt_key: attempt_key,
    ),
    head_sha: head_sha,
    window_identity_hex: window_identity_hex,
  )
  verification_receipt_file_source_from_exact(
    source: exact_verification_receipt_source_read(
      attempt_dir: address.attempt_dir,
      verification_dir: address.verification_dir,
      receipt_basename: address.receipt_basename,
    ),
  )
}

fn belt_verification_receipt_source(
  instance: HostDashboardInstance,
  node_id: RoadmapNodeId,
  attempt_key: String,
  selection: CurrentVerificationSelectionObservation,
) -> VerificationReceiptFileSource {
  match selection {
    SelectionUnaddressable { cause } =>
      VerificationReceiptUnreadable {
        detail: join([
          "the worktree head could not be observed, so the exact receipt path was not established: ",
          cause,
        ], ""),
      }
    SelectionAbsent => VerificationReceiptAbsent
    SelectionUnreadable { cause } =>
      VerificationReceiptUnreadable {
        detail: join([
          "the current verification selection could not be read, so the exact receipt path was not established: ",
          cause,
        ], ""),
      }
    SelectionMalformed { cause } =>
      VerificationReceiptUnreadable {
        detail: join([
          "the current verification selection is malformed, so the exact receipt path was not established: ",
          cause,
        ], ""),
      }
    SelectionObserved { head, window_identity } =>
      belt_verification_receipt_source_for_selection(
        instance: instance,
        node_id: node_id,
        attempt_key: attempt_key,
        head_sha: head as String,
        window_identity_hex: window_identity.digest as String,
      )
  }
}

// The modeled-state pointer read is a typed outcome, and the two failure facts are kept apart: a
// pointer that is established absent means this attempt has no modeled state; a pointer that could
// not be read means WHETHER the attempt has modeled state is unknown. Collapsing them -- the old
// `!read.success || trim(content) == ""` -- made an unreadable pointer claim "has no modeled state
// pointer", an absence the read never established.
type WorkflowModeledStatePointerState
  = WorkflowModeledStatePointerAbsent
  | WorkflowModeledStatePointerUnreadable { cause: NonEmptyStr }

// The pointer standing decides the subordinate facts' standing: established ABSENCE (no pointer)
// carries absence-shaped facts -- the legacy arm's own meaning -- while an UNREADABLE pointer
// carries non-absence variants: the wrong state is unwritable, and nothing downstream may read an
// unreadable pointer as "not yet".
fn selection_standing_for_pointer(pointer_state: WorkflowModeledStatePointerState) -> CurrentVerificationSelectionObservation {
  match pointer_state {
    WorkflowModeledStatePointerAbsent => SelectionAbsent
    WorkflowModeledStatePointerUnreadable { cause } =>
      SelectionUnaddressable {
        cause: join(["this attempt's current-attempt-key pointer could not be read, so whether a verification window was selected is unknown: ", cause], ""),
      }
  }
}

fn verification_source_standing_for_pointer(pointer_state: WorkflowModeledStatePointerState) -> VerificationReceiptFileSource {
  match pointer_state {
    WorkflowModeledStatePointerAbsent => VerificationReceiptAbsent
    WorkflowModeledStatePointerUnreadable { cause } =>
      VerificationReceiptUnreadable {
        detail: join(["this attempt's current-attempt-key pointer could not be read, so its verification receipt could not be located: ", cause], ""),
      }
  }
}

fn publication_source_standing_for_pointer(pointer_state: WorkflowModeledStatePointerState) -> PublicationReceiptSource {
  match pointer_state {
    WorkflowModeledStatePointerAbsent => ReceiptSourceAbsent
    WorkflowModeledStatePointerUnreadable { cause } =>
      ReceiptSourceUnreadable {
        detail: join(["this attempt's current-attempt-key pointer could not be read, so its publication receipt could not be located: ", cause], ""),
      }
  }
}

fn review_report_standing_for_pointer(pointer_state: WorkflowModeledStatePointerState) -> ReviewReport {
  match pointer_state {
    WorkflowModeledStatePointerAbsent => review_report_absent(reason: "this attempt has no modeled state pointer, so no review report exists for it")
    WorkflowModeledStatePointerUnreadable { cause } =>
      review_report_refused(reason: join(["this attempt's current-attempt-key pointer could not be read, so its review report could not be located: ", cause], ""))
  }
}

fn belt_workflow_attempt_evidence_without_modeled_state(
  instance: HostDashboardInstance,
  panes: BeltAttemptPanes,
  attempt: DispatchAttemptRef,
  pointer_state: WorkflowModeledStatePointerState,
) -> WorkflowAttemptEvidence {
  let pointer_reason = match pointer_state {
    WorkflowModeledStatePointerAbsent =>
      "this attempt has no modeled state pointer, so neither its attempt key nor its head is established"
    WorkflowModeledStatePointerUnreadable { cause } =>
      join(["this attempt's current-attempt-key pointer could not be read, so neither its attempt key nor its head is established: ", cause], "")
  }
  let worktree_cause = match pointer_state {
    WorkflowModeledStatePointerAbsent =>
      "this attempt has no modeled state pointer, so no attempt key names its worktree"
    WorkflowModeledStatePointerUnreadable { cause } =>
      join(["this attempt's current-attempt-key pointer could not be read, so whether an attempt key names its worktree is unknown: ", cause], "")
  }
  let standing = match pointer_state {
    WorkflowModeledStatePointerAbsent => WorkflowModeledStateAbsent
    WorkflowModeledStatePointerUnreadable { cause } => WorkflowModeledStateUnreadable { cause: cause }
  }
  let placement_detail = match pointer_state {
    WorkflowModeledStatePointerAbsent =>
      "this attempt has no modeled state pointer, so no attempt key names its session placement"
    WorkflowModeledStatePointerUnreadable { cause } =>
      join(["this attempt's current-attempt-key pointer could not be read, so whether an attempt key names its session placement is unknown: ", cause], "")
  }
  let provider_events_error = match pointer_state {
    WorkflowModeledStatePointerAbsent => ""
    WorkflowModeledStatePointerUnreadable { cause } => cause as String
  }
  WorkflowAttemptEvidence {
    node_id: attempt.node_id,
    attempt_key: attempt.attempt_key,
    branch: attempt.branch,
    modeled_state: standing,
    worktree: AttemptWorktreeUnobserved { path: "", cause: worktree_cause },
    admission_receipt_readable: false,
    admission_receipt: "",
    spawn_failure_present: false,
    spawn_failure: "",
    provider_events_readable: false,
    provider_events: "",
    provider_events_error: provider_events_error,
    process: attempt_process_for_node(
      instance: instance,
      panes: panes,
      node_id: attempt.node_id,
      attempt_key: attempt.attempt_key,
    ),
    validation_summary: belt_validation_summary_for_node(
      instance: instance,
      node_id: attempt.node_id,
    ),
    verification_subject: VerificationSubjectUnobserved {
      reason: pointer_reason,
    },
    verification_selection: selection_standing_for_pointer(pointer_state: pointer_state),
    verification_source: verification_source_standing_for_pointer(pointer_state: pointer_state),
    publication_subject: PublicationSubjectUnobserved {
      reason: pointer_reason,
    },
    publication_source: publication_source_standing_for_pointer(pointer_state: pointer_state),
    submission_capture: CaptureUnreadable {
      reason: pointer_reason,
    },
    integration: IntegrationReceiptUnreadable {
      reason: pointer_reason,
    },
    review: review_report_standing_for_pointer(pointer_state: pointer_state),
    goal_audit: [],
    session_placement: SessionPlacementUnnameable { detail: placement_detail },
  }
}

fn belt_workflow_attempt_evidence_for_ref(
  instance: HostDashboardInstance,
  panes: BeltAttemptPanes,
  attempt: DispatchAttemptRef,
) -> WorkflowAttemptEvidence {
  let key_read = Filesystem.Read(
    path: dispatch_current_attempt_key_path_for_instance(
      instance: instance,
      node_id: attempt.node_id as gunbc.roadmap.roadmap_model.RoadmapNodeId,
    ),
  )
  match filesystem_read_outcome(content: key_read.content, success: key_read.success, error: key_read.error) {
    FilesystemReadRefused { error } =>
      belt_workflow_attempt_evidence_without_modeled_state(
        instance: instance,
        panes: panes,
        attempt: attempt,
        pointer_state: WorkflowModeledStatePointerUnreadable { cause: error as NonEmptyStr },
      )
    FilesystemReadSucceeded { content } =>
      if trim(content) == "" {
        belt_workflow_attempt_evidence_without_modeled_state(
          instance: instance,
          panes: panes,
          attempt: attempt,
          pointer_state: WorkflowModeledStatePointerAbsent,
        )
      } else {
        belt_workflow_attempt_evidence_for_key(instance: instance, panes: panes, attempt: attempt, current_key: trim(content))
      }
  }
}

type BeltAttemptRecordPaths {
  admission: String
  events: String
  spawn_failure: String
}

fn belt_attempt_record_paths(instance: HostDashboardInstance, node_id: gunbc.roadmap.roadmap_model.RoadmapNodeId, attempt_key: String) -> BeltAttemptRecordPaths {
  BeltAttemptRecordPaths {
    admission: dispatch_attempt_admission_path_for_instance(instance: instance, node_id: node_id, attempt_key: attempt_key),
    events: dispatch_attempt_events_path_for_instance(instance: instance, node_id: node_id, attempt_key: attempt_key),
    spawn_failure: dispatch_attempt_spawn_failure_path_for_instance(instance: instance, node_id: node_id, attempt_key: attempt_key),
  }
}

// THE EVIDENCE OF ONE NAMED ATTEMPT. belt_workflow_attempt_evidence_for_ref resolves the node's
// CURRENT attempt through its state pointer and then reads it here; a reader of attempt HISTORY
// (gunbc.roadmap.roadmap_dogfood_route) names the attempt by its own key and reads it here directly, so
// both read one evidence builder. EVERY attempt-varying read below is addressed by the supplied key
// (admission, provider events, spawn failure, worktree, submission, verification, publication,
// review, integration, session placement) -- never through a dispatch_current_attempt_* projection, which would mix the
// node's current attempt into a historical one. The validation summary is the node's execution
// contract, a node fact, not an attempt fact.
fn belt_workflow_attempt_evidence_for_key(
  instance: HostDashboardInstance,
  panes: BeltAttemptPanes,
  attempt: DispatchAttemptRef,
  current_key: String,
) -> WorkflowAttemptEvidence {
  let node_id = attempt.node_id as gunbc.roadmap.roadmap_model.RoadmapNodeId
  let paths = belt_attempt_record_paths(instance: instance, node_id: node_id, attempt_key: current_key)
  let admission = Filesystem.Read(path: paths.admission)
  let events = belt_provider_event_projection_observe_at(instance: instance, events_path: paths.events)
  let spawn_failure = Filesystem.Read(path: paths.spawn_failure)
  let branch = dispatch_branch_name(
    node_id: node_id,
    attempt_key: current_key,
  )
  let worktree = dispatch_worktree_path_for_instance(
    instance: instance,
    node_id: node_id,
    attempt_key: current_key,
  )
  let head = belt_worktree_head_observe(
    instance: instance,
    worktree: worktree,
  )
  let publication_subject = match belt_lookup_node(node_id: attempt.node_id) {
    AuthorityProjectionRefused { detail } =>
      PublicationSubjectUnobserved {
        reason: concat("roadmap authority projection refused: ", detail),
      }
    NodeMissing =>
      PublicationSubjectUnobserved {
        reason: "the roadmap authority declares no node with this id, so there is no publication destination",
      }
    NodeFound { node } =>
      belt_publication_subject_for_node(
        node: node,
        attempt_key: current_key,
        branch: branch,
        base_branch: dispatch_base_branch(instance: instance),
        head: head,
      )
  }
  let verification_selection = match head {
    WorktreeHeadUnobserved { reason } =>
      SelectionUnaddressable { cause: reason }
    WorktreeHeadObserved { revision: revision } =>
      belt_verification_selection_observe(
        instance: instance,
        node_id: node_id,
        attempt_key: current_key,
        head_sha: revision as String,
      )
  }
  let verification_subject = match belt_lookup_node(node_id: attempt.node_id) {
    AuthorityProjectionRefused { detail: detail } =>
      VerificationSubjectUnobserved {
        reason: concat("roadmap authority projection refused: ", detail),
      }
    NodeMissing =>
      VerificationSubjectUnobserved {
        reason: "the roadmap authority declares no node with this id, so there is no verification subject",
      }
    NodeFound { node } =>
      match head {
        WorktreeHeadUnobserved { reason } =>
          VerificationSubjectUnobserved { reason: reason }
        WorktreeHeadObserved { revision: revision } =>
          if trim(branch) == "" {
            VerificationSubjectUnobserved {
              reason: "the attempt has no branch name, so there is no verification subject to construct",
            }
          } else {
            belt_verification_subject_from_selection(
              node: node,
              attempt_key: current_key,
              branch: branch,
              head: revision as CommitSha,
              selection: verification_selection,
            )
          }
      }
  }
  let publication_receipt = belt_publication_receipt_source(
    instance: instance,
    node_id: node_id,
    attempt_key: current_key,
    subject: publication_subject,
  )
  let review_evidence = match head {
    WorktreeHeadUnobserved { reason } => review_report_absent(reason: join(["the attempt head is unobserved: ", reason], ""))
    WorktreeHeadObserved { revision } =>
      belt_review_report(instance: instance, node_id: node_id, attempt_key: current_key, head_sha: revision as String)
  }
  let audit_evidence = match head {
    WorktreeHeadUnobserved { reason: _ } => []
    WorktreeHeadObserved { revision } =>
      belt_audit_evidence(instance: instance, node_id: node_id, attempt_key: current_key, head_sha: revision as String)
  }
  let submission_capture = match head {
    WorktreeHeadUnobserved { reason } =>
      CaptureUnreadable {
        reason: join(["the attempt head is unobserved, so no submission capture lookup names it: ", reason], ""),
      }
    WorktreeHeadObserved { revision } =>
      belt_submission_capture_for_head(
        instance: instance,
        worktree: worktree,
        node_id: node_id, attempt_key: current_key,
        head_sha: revision as String,
      )
  }
  let integration_receipt = match head {
    WorktreeHeadUnobserved { reason } =>
      IntegrationReceiptUnreadable {
        reason: join(["the attempt head is unobserved, so no integration receipt lookup names it: ", reason], ""),
      }
    WorktreeHeadObserved { revision } =>
      belt_integration_receipt_observe(
        instance: instance,
        worktree: worktree,
        dir: belt_attempt_integration_dir_for_instance(
          instance: instance,
          node_id: node_id,
          attempt_key: current_key,
        ),
        head_sha: revision as String,
      )
  }
  WorkflowAttemptEvidence {
    node_id: attempt.node_id,
    attempt_key: current_key,
    branch: dispatch_branch_name(
      node_id: node_id,
      attempt_key: current_key,
    ),
    modeled_state: WorkflowModeledStateObserved,
    worktree: belt_attempt_worktree_observe(instance: instance, node_id: node_id, attempt_key: current_key),
    admission_receipt_readable: admission.success,
    admission_receipt: admission.content,
    spawn_failure_present: spawn_failure.success,
    spawn_failure: spawn_failure.content,
    provider_events_readable: provider_event_projection_readable(
      observation: events,
    ),
    provider_events: provider_event_projection_events(
      observation: events,
    ),
    provider_events_error: provider_event_projection_error(
      observation: events,
    ),
    process: attempt_process_for_node(
      instance: instance,
      panes: panes,
      node_id: attempt.node_id,
      attempt_key: current_key,
    ),
    validation_summary: belt_validation_summary_for_node(
      instance: instance,
      node_id: attempt.node_id,
    ),
    verification_subject: verification_subject,
    verification_selection: verification_selection,
    verification_source: belt_verification_receipt_source(
      instance: instance,
      node_id: node_id,
      attempt_key: current_key,
      selection: verification_selection,
    ),
    publication_subject: publication_subject,
    publication_source: publication_receipt,
    submission_capture: submission_capture,
    integration: integration_receipt,
    review: review_evidence,
    goal_audit: audit_evidence,
    session_placement: session_placement_observe_for_attempt(instance: instance, node_id: attempt.node_id, attempt_key: current_key),
  }
}

// THE ATTEMPT'S TYPED EVIDENCE AND ITS PROGRESS ARE ONE READ. The evidence (submission capture,
// verification and publication receipt sources, review report, ...) is the record set the
// progress projection reduces to segments; exposing it lets a consumer that needs the typed
// records (gunbc.roadmap.roadmap_dogfood_route) read the same observation instead of re-reading the files.
fn belt_workflow_progress_for_attempt_ref(
  instance: HostDashboardInstance,
  panes: BeltAttemptPanes,
  attempt: DispatchAttemptRef,
) -> WorkflowAttemptProgress {
  workflow_attempt_progress(evidence: belt_workflow_attempt_evidence_for_ref(instance: instance, panes: panes, attempt: attempt))
}

type BeltWorkflowAttemptEvidences
  = WorkflowAttemptEvidencesObserved { evidences: List<WorkflowAttemptEvidence> }
  | WorkflowAttemptEvidencesRefused { reason: String }

// EVERY ATTEMPT IN THE INSTANCE'S DURABLE HISTORY, as typed evidence: each dispatch ref read by its
// OWN attempt key, not collapsed to the node's current attempt. The refs are the attempts' durable
// record (attempt branches and attempt state are retained), so a completed attempt stays readable
// after a newer attempt of its node becomes current. Refs whose key does not parse name no attempt
// and are not read.
fn belt_workflow_attempt_history_evidences_observe_for_instance(instance: HostDashboardInstance) -> BeltWorkflowAttemptEvidences {
  match belt_attempts_observe_for_instance(instance: instance) {
    AttemptsRefused { reason } => WorkflowAttemptEvidencesRefused { reason: reason }
    AttemptsObserved { attempts } => {
      let panes = belt_attempt_panes_observe_for_instance(instance: instance)
      WorkflowAttemptEvidencesObserved {
        evidences: map(filter(attempts, a => a.attempt_key != ""), attempt => belt_workflow_attempt_evidence_for_key(instance: instance, panes: panes, attempt: attempt, current_key: attempt.attempt_key)),
      }
    }
  }
}

// The workflow's own verification actuation, and why it lives on the belt rather than the
// /workflow.json handler: running a declared validation is an EFFECT as long as the validation,
// while the progress route is a synchronous read the browser polls every two seconds — producing
// the verdict on the read path would make the lamp's observation run cargo. So the belt produces
// the receipt and the projection reads it, the split the environment-admission receipt already
// uses, and why Verify can move without the observer changing shape. Idempotence comes from the
// receipt's presence, as spawn idempotence comes from the observed session: a recorded verdict is
// not recomputed, so re-ticking neither re-runs the validation nor overwrites a verdict with one
// taken against a tree the agent has since touched. Agent completion is read from the reconciled
// provider state, so a turn completed while its pane still runs, or with a nonzero exit, never
// reaches verification — the obligation order is preserved, not restated.
// Validations run in a detached checkout of the observed head, never the mutable implementation
// worktree. The checkout path is head-addressed and idempotent: a tree at the same revision is
// reused; one at a different revision refuses rather than validating the wrong commit.
// THE COMMIT PASS. Verification checks out the worktree HEAD (belt_verify_attempt_for_instance), so
// an attempt's uncommitted work was never what got verified. This pass runs after teardown and
// before verify on the same tick: it reads the worktree's NUL-separated status through the same
// capability program the head observation uses, hands provider state and status text to the pure
// decision in gunbc.roadmap.roadmap_belt_commit, and only on CommitNeeded stages everything and
// commits with the decided message. Every refusal is typed and carried into the tick receipt as
// commit_pass; verify is made data-dependent on these outcomes so it observes the committed head.
// AN ATTEMPT WITH NO KEY NAMES NO WORKTREE, AND THAT IS NOT A COMMIT THAT FAILED.
//
// dispatch_worktree_path_for_instance joins node_id, "-a" and the attempt key unconditionally, so an
// EMPTY key addresses `<root>/<node>-a` -- a path that cannot exist, because a keyed attempt's
// directory ends in the key and a keyless one (this host still carries seven from July, before the
// key convention) is just `<root>/<node>`. `git status` in a directory that is not there exits
// nonzero, that became CommitFailed, and one CommitFailed fails the whole pass. Measured on srv1:
// commit_pass failed on EVERY tick, verify then deferred for "no attempt is ready", and the roadmap
// moved nothing for eighteen hours while every stage reported honestly about a subject none of them
// could reach.
//
// THE FAILURE WAS NEVER IN THE COMMIT. Nothing was wrong with those worktrees and no git operation
// was refused; the pass computed an address for an attempt that has none. Reporting that as
// CommitFailed is the not-applicable-rendered-as-malformed conflation DESIGN names: one symbol over
// "this commit was refused" and "this attempt could not be addressed", which have different owners
// and different repairs.
//
// IT IS COUNTED AND IT DOES NOT HALT ITS SIBLINGS. A keyless attempt is a real defect in whatever
// wrote it, so it is not silently skipped -- it gets its own arm and its own count. But it must not
// fail the pass, because that is the absorbing arm: one unaddressable legacy row blocking every
// other attempt forever is strictly worse than the row itself, and it is what kept the pipeline
// severed. Typed, located, counted, siblings continue.
//
// THE SAME ABSORBING ARM, ONE LAYER DEEPER: CommitCapturePoisoned is the durable refusal of the
// candidate's SCM capture (see BeltScmCapture) rendered as an outcome. One attempt whose capture
// states a durable fact -- its project is owned by no single arc, its base freezes nothing, its
// store is damaged -- must not fail the whole commit pass on every tick until a human intervenes;
// that is the pass-killing failure the 2026-09-21 incident kept paying (commit_pass "one or more
// attempt worktrees could not be committed" on every tick, verify deferred forever behind it).
// Like the unaddressable arm it is typed, located, persisted per attempt, counted in the tick
// result, and its siblings continue; a transient capture refusal stays CommitFailed, because an
// infra arm that may clear by next tick must stay loud.
type BeltCommitOutcome
  = CommitRecorded { node_id: String, message: String }
  | CandidateCaptured { node_id: String, head_sha: String, message: String }
  | CommitSkipped { node_id: String, reason: String }
  | CommitFailed { node_id: String, detail: String }
  | CommitCapturePoisoned { node_id: String, detail: String }
  | CommitDeferred { node_id: String, reason: String }
  | CommitSubjectUnaddressable { node_id: String, reason: String }

type BeltCommitGitTrust
  = BeltCommitGitTrusted { git_dir: String, work_tree: String }
  | BeltCommitGitUntrusted { cause: String }

fn belt_commit_gitfile_points_at(contents: String, expected_git_dir: String) -> Bool {
  match git_dir_path_from_gitfile(contents: contents) {
    Absent => false
    Present { value: pointer } => pointer == expected_git_dir
  }
}

fn belt_commit_commondir_points_at(contents: String, expected_common: String) -> Bool {
  let line = trim(s: contents)
  line == git_worktree_commondir_relative || line == expected_common
}

fn belt_commit_git_trust(instance: HostDashboardInstance, worktree: String) -> BeltCommitGitTrust {
  let pointers = dispatch_worker_git_pointer_files(instance: instance, attempt_worktree: worktree)
  let expected_git_dir = dispatch_attempt_private_git_dir(instance: instance, attempt_worktree: worktree)
  let expected_common = join([instance.repo_root as String, "/.git"], "")
  let gitfile = Filesystem.Read(path: pointers.gitfile)
  if !gitfile.success {
    BeltCommitGitUntrusted { cause: "worktree gitfile is missing or unreadable" }
  } else if !belt_commit_gitfile_points_at(contents: gitfile.content, expected_git_dir: expected_git_dir) {
    BeltCommitGitUntrusted { cause: "worktree gitfile does not name the derived private git dir" }
  } else {
    let commondir = Filesystem.Read(path: pointers.commondir)
    if !commondir.success {
      BeltCommitGitUntrusted { cause: "worktree commondir is missing or unreadable" }
    } else if !belt_commit_commondir_points_at(contents: commondir.content, expected_common: expected_common) {
      BeltCommitGitUntrusted { cause: "worktree commondir does not name the derived common git dir" }
    } else {
      BeltCommitGitTrusted { git_dir: expected_git_dir, work_tree: worktree }
    }
  }
}

fn belt_commit_git(instance: HostDashboardInstance, worktree: String, args: List<String>) -> BeltExecOutcome {
  match belt_commit_git_trust(instance: instance, worktree: worktree) {
    BeltCommitGitUntrusted { cause } =>
      ExecRefused {
        program: dispatch_capability_program(environment: instance.execution_environment, cap: GitWorkspaceCapability),
        reason: cause,
      }
    BeltCommitGitTrusted { git_dir, work_tree } =>
      belt_exec(
        cmd: belt_commit_git_argv(instance: instance, git_dir: git_dir, work_tree: work_tree, args: args),
        workdir: work_tree,
      )
  }
}

fn belt_commit_git_argv(
  instance: HostDashboardInstance,
  git_dir: String,
  work_tree: String,
  args: List<String>,
) -> HostExecArgv {
  let git = dispatch_capability_program(
    environment: instance.execution_environment,
    cap: GitWorkspaceCapability,
  )
  host_exec_argv(
    program: "/usr/bin/env",
    args: concat(
      concat(git_untrusted_config_env_words(), [git, join([git_dir_flag_prefix, git_dir], ""), join([git_work_tree_flag_prefix, work_tree], "")]),
      concat(git_command_config_inert_args(), args),
    ),
  )
}

fn belt_commit_exec_detail(step: String, outcome: BeltExecOutcome) -> String {
  match outcome {
    ExecOk { stdout: _ } => join([step, " succeeded"], "")
    ExecFailed { program, exit_code, stderr } =>
      join([step, ": ", program, " exited ", to_string(exit_code), ": ", stderr], "")
    ExecRefused { program, reason } => join([step, ": ", program, " refused: ", reason], "")
  }
}

// THE SUBMISSION OBSERVATION IS PART OF THE COMMIT DECISION'S INPUT, READ AT THE BOUNDARY. Absence
// is established by a successful listing, never a failed read; an unlistable worktree or an
// artifact that lists and then does not read is not "no submission" -- it is unknown, and the belt
// refuses to commit on a guess, because the two commit kinds bind different obligations.
type BeltSubmissionRead
  = BeltSubmissionObserved { observation: SubmissionObservation }
  | BeltSubmissionUnobservable { reason: String }

fn belt_submission_observe(worktree: String) -> BeltSubmissionRead {
  let listing = Filesystem.List(path: worktree)
  if !listing.success {
    BeltSubmissionUnobservable {
      reason: join([
        "the attempt worktree could not be listed, so whether a submission artifact exists is unknown: ",
        worktree, " (", listing.error, ")",
      ], ""),
    }
  } else if !filesystem_listing_names_entry(listing: listing.entries, name: submission_artifact_name as String) {
    BeltSubmissionObserved { observation: SubmissionAbsent }
  } else {
    let read = Filesystem.Read(path: join([worktree, "/", submission_artifact_name as String], ""))
    match filesystem_read_outcome(content: read.content, success: read.success, error: read.error) {
      FilesystemReadRefused { error } =>
        BeltSubmissionUnobservable {
          reason: join([
            "the submission artifact was listed and then could not be read, so whether it declares a candidate is unknown: ",
            error,
          ], ""),
        }
      FilesystemReadSucceeded { content } =>
        match submission_decode(text: content) {
        SubmissionNotDecodable { reason } =>
          BeltSubmissionObserved { observation: SubmissionUndecodable { reason: reason } }
        SubmissionDecoded { submission } =>
          BeltSubmissionObserved {
            observation: SubmissionDeclared {
              submission: submission,
              digest: submission_digest(submission: submission),
            },
          }
      }
    }
  }
}

// THE CAPTURE ROSTER READ IS FAIL-CLOSED: one undecodable record refuses the whole roster rather
// than deciding freshness against a partial history, because the missing entry could be the very
// capture this declaration would collide with.
type BeltCaptureRoster
  = CaptureRosterObserved { captures: List<SubmissionCapture> }
  | CaptureRosterUnobservable { reason: String }

// THE CAPTURE DIRECTORY LIVES BESIDE THE ATTEMPT STATE, and the belt ensures it at every use
// rather than at staging: attempts dispatched before this lane existed have no `submissions/`
// subdirectory, and `install -d` is idempotent, so ensuring it here keeps the old population
// legible (absence established by a successful listing) instead of refused (an unlistable
// directory that is simply absent on older attempts).
fn belt_attempt_submission_dir_for_instance(
  instance: HostDashboardInstance,
  node_id: RoadmapNodeId,
  attempt_key: String,
) -> String {
  join([
    dispatch_attempt_state_path_for_instance(instance: instance, node_id: node_id, attempt_key: attempt_key),
    "/submissions",
  ], "")
}

fn belt_attempt_submission_dir_ensure(instance: HostDashboardInstance, worktree: String, dir: String) -> BeltExecOutcome {
  belt_exec(
    cmd: host_exec_argv(
      program: dispatch_capability_program(
        environment: instance.execution_environment,
        cap: AttemptStateDirectoryCapability,
      ),
      args: ["-d", "-m", "0700", dir],
    ),
    workdir: worktree,
  )
}

fn belt_submission_captures_observe(instance: HostDashboardInstance, worktree: String, dir: String) -> BeltCaptureRoster {
  match belt_attempt_submission_dir_ensure(instance: instance, worktree: worktree, dir: dir) {
    ExecFailed { program, exit_code, stderr } =>
      CaptureRosterUnobservable {
        reason: belt_commit_exec_detail(
          step: "submission-directory",
          outcome: ExecFailed { program: program, exit_code: exit_code, stderr: stderr },
        ),
      }
    ExecRefused { program, reason } =>
      CaptureRosterUnobservable {
        reason: belt_commit_exec_detail(step: "submission-directory", outcome: ExecRefused { program: program, reason: reason }),
      }
    ExecOk { stdout: _ } => {
  let listing = Filesystem.List(path: dir)
  if !listing.success {
    CaptureRosterUnobservable {
      reason: join([
        "the submission capture directory could not be listed, so the capture history is unknown: ",
        dir, " (", listing.error, ")",
      ], ""),
    }
  } else {
    fold(
      split(s: listing.entries, delimiter: "\n") |> filter(e => trim(e) != ""),
      init: CaptureRosterObserved { captures: [] },
      f: (acc, entry) =>
        match acc {
          CaptureRosterUnobservable { reason: _ } => acc
          CaptureRosterObserved { captures } => {
            let read = Filesystem.Read(path: join([dir, "/", trim(entry)], ""))
            match filesystem_read_outcome(content: read.content, success: read.success, error: read.error) {
              FilesystemReadRefused { error } =>
                CaptureRosterUnobservable {
                  reason: join([
                    "a submission capture record was listed and then could not be read: ",
                    trim(entry), " (", error, ")",
                  ], ""),
                }
              FilesystemReadSucceeded { content } =>
                match submission_capture_decode(text: content) {
                CaptureNotDecodable { reason } =>
                  CaptureRosterUnobservable {
                    reason: join(["the submission capture record ", trim(entry), " does not decode: ", reason], ""),
                  }
                CaptureDecoded { capture } =>
                  CaptureRosterObserved { captures: concat(captures, [capture]) }
              }
            }
          }
        },
    )
  }
  }
}
}

// THE HEAD-GRAIN CAPTURE LOOKUP: the one read both the verify gate and the dashboard projection
// make. Absence is listing-established; a record at the head's own address that decodes but names
// a different head is unexplained state, refused rather than read as this head's binding.
fn belt_submission_capture_for_head(instance: HostDashboardInstance, worktree: String, node_id: RoadmapNodeId, attempt_key: String, head_sha: String) -> SubmissionCaptureObservation {
  let dir = belt_attempt_submission_dir_for_instance(instance: instance, node_id: node_id, attempt_key: attempt_key)
  match belt_attempt_submission_dir_ensure(instance: instance, worktree: worktree, dir: dir) {
    ExecFailed { program, exit_code, stderr } =>
      CaptureUnreadable {
        reason: belt_commit_exec_detail(
          step: "submission-directory",
          outcome: ExecFailed { program: program, exit_code: exit_code, stderr: stderr },
        ),
      }
    ExecRefused { program, reason } =>
      CaptureUnreadable {
        reason: belt_commit_exec_detail(step: "submission-directory", outcome: ExecRefused { program: program, reason: reason }),
      }
    ExecOk { stdout: _ } => {
  let listing = Filesystem.List(path: dir)
  if !listing.success {
    CaptureUnreadable {
      reason: join([
        "the submission capture directory could not be listed, so whether this head is a captured candidate is unknown: ",
        dir, " (", listing.error, ")",
      ], ""),
    }
  } else if !filesystem_listing_names_entry(listing: listing.entries, name: submission_capture_basename(head_sha: head_sha)) {
    belt_capture_absence_for_attempt(instance: instance, node_id: node_id, attempt_key: attempt_key, head_sha: head_sha)
  } else {
    let read = Filesystem.Read(path: join([dir, "/", submission_capture_basename(head_sha: head_sha)], ""))
    match filesystem_read_outcome(content: read.content, success: read.success, error: read.error) {
      FilesystemReadRefused { error } =>
        CaptureUnreadable {
          reason: join(["the submission capture for this head was listed and then could not be read: ", error], ""),
        }
      FilesystemReadSucceeded { content } =>
        match submission_capture_decode(text: content) {
        CaptureNotDecodable { reason } =>
          CaptureUnreadable {
            reason: join(["the submission capture at this head's own address does not decode: ", reason], ""),
          }
        CaptureDecoded { capture } =>
          if capture.head_sha != head_sha {
            CaptureUnreadable {
              reason: join([
                "the submission capture at this head's own address names ", capture.head_sha,
                ", which is unexplained state rather than this head's binding",
              ], ""),
            }
          } else {
            CaptureForHead { capture: capture }
          }
      }
    }
  }
  }
}
}

type BeltStagedCommit
  = StagedCommitRecorded
  | StagedCommitFailed { detail: String }

fn belt_commit_staged(instance: HostDashboardInstance, worktree: String, message: NonEmptyStr) -> BeltStagedCommit {
  match belt_commit_git(instance: instance, worktree: worktree, args: shape_git_add_all_args()) {
    ExecOk { stdout: _ } =>
      match belt_commit_git(instance: instance, worktree: worktree, args: shape_git_commit_message_args(message: message as String)) {
        ExecOk { stdout: _ } => StagedCommitRecorded
        ExecFailed { program, exit_code, stderr } =>
          StagedCommitFailed { detail: belt_commit_exec_detail(step: "commit", outcome: ExecFailed { program: program, exit_code: exit_code, stderr: stderr }) }
        ExecRefused { program, reason } =>
          StagedCommitFailed { detail: belt_commit_exec_detail(step: "commit", outcome: ExecRefused { program: program, reason: reason }) }
      }
    ExecFailed { program, exit_code, stderr } =>
      StagedCommitFailed { detail: belt_commit_exec_detail(step: "add", outcome: ExecFailed { program: program, exit_code: exit_code, stderr: stderr }) }
    ExecRefused { program, reason } =>
      StagedCommitFailed { detail: belt_commit_exec_detail(step: "add", outcome: ExecRefused { program: program, reason: reason }) }
  }
}

// ------------------------------------------------------------------------------------------------
// THE SCM CAPTURE (owner ruling 2026-09-20: gunbc SCM inside, git at the edge).
//
// The authoritative capture of a candidate is a commit minted into the PROJECT's SCM envelope, not
// the git commit the belt still creates in the attempt worktree. The project is derived, not
// configured: a standalone task is a project of one (docs/plans/harness-work-lifecycle.md, delivery
// structure), so today the project key IS the node id, and the envelope for the ten sibling nodes
// of a multi-node project lands here unchanged once the roadmap authority carries explicit project
// parents. The envelope lives beside the attempt-state root so its lifetime is the dashboard
// instance's, not one attempt's.
// ------------------------------------------------------------------------------------------------

fn belt_scm_projects_dir(instance: HostDashboardInstance) -> String {
  join([dashboard_instance_dispatch_attempt_state_root(instance: instance) as String, "/projects"], "")
}

fn belt_scm_project_repository_path(instance: HostDashboardInstance, project_key: String) -> String {
  join([belt_scm_projects_dir(instance: instance), "/", project_key, ".gunbc-repository.json"], "")
}

fn belt_scm_project_entry_name(project_key: String) -> String {
  join([project_key, ".gunbc-repository.json"], "")
}

// A CAPTURE VERDICT, WITH THE REFUSAL'S DURABILITY CARRIED AT BIRTH. ScmCaptureRefused is a
// TRANSIENT arm: the same tick's retry, or the next tick's, can succeed (an exec failure, an
// unreadable file, a full disk). ScmCapturePoisoned is a DURABLE arm: the refusal states a fact
// about the attempt, its subject, or the store that no retry can change -- a project no arc owns,
// a base that freezes nothing, store or envelope damage, a staged tree identical to its base.
// The distinction is born here, at each refusal site, because the site is the one authority on
// what the refusal means; classifying later, from the detail string, would be a second authority
// (DESIGN section 3) and the pass would be guessing.
//
// ScmCandidateCaptured carries the commit's ROOT LOCATOR beside the ordinal: the ordinal is a
// repository-relative counter and the locator is the content identity, and the capture record is
// the handoff binding -- recording both is what makes the integrate able to authenticate the
// ordinal against the envelope instead of trusting it (submission_capture_binding_refusal).
type BeltScmCapture
  = ScmCandidateCaptured { repository_path: String, commit_ordinal: Int, commit_root_locator: String }
  | ScmCaptureRefused { detail: String }
  | ScmCapturePoisoned { detail: String }

// THE MINT WITHOUT THE SAVE. Recapture and the tick share one capture; the tick then creates a git
// commit, and recapture must not. Splitting persist from the mint lets recapture refuse a capture
// that would not be fresh before anything is written, and lets the tick keep its existing sequence.
type BeltScmMint
  = ScmCandidateMinted {
      repository: RepositoryEnvelope
      generation: RepositoryGenerationExpectation
      path: String
      commit_ordinal: Int
      commit_root_locator: String
    }
  | ScmCaptureMintRefused { detail: String }
  | ScmCaptureMintPoisoned { detail: String }

// THE ENVELOPE SOURCE CARRIES THE GENERATION EXPECTATION BESIDE THE ENVELOPE, because the two are
// one observation: the expectation records what this tick's observe saw at the path (a generation,
// or absence), and a later guarded save must compare against exactly that, not re-observe --
// re-observing could admit a write derived from older bytes over a newer envelope, which is the
// silent-clobber failure the guard exists to refuse (the 2026-09-22 incident: a capture persisted
// ordinal 1 and a stale writer rewound the envelope to commit-0-only four minutes later).
type BeltEnvelopeSource
  = EnvelopeReady { envelope: RepositoryEnvelope, generation: RepositoryGenerationExpectation }
  | EnvelopeSourceRefused { detail: String }

// A MISSING ENVELOPE IS AN EMPTY REPOSITORY; AN UNDECODABLE ONE STOPS THE LINE. Absence is
// established by the directory listing, never by a failed read -- the same rule the capture
// directory and the publication spool already carry, because a project envelope that exists but
// does not decode is damage to report, not a fresh start to pave over. The absence arm carries
// GenerationExpectedAbsent: the seed save this feeds is the first-save path, admissible only
// while the disk still holds no envelope.
fn belt_scm_envelope_observe(projects_dir: String, path: String, entry_name: String) -> BeltEnvelopeSource {
  let listing = Filesystem.List(path: projects_dir)
  if !listing.success {
    EnvelopeSourceRefused {
      detail: join([
        "the project envelope directory could not be listed, so whether an envelope exists is unknown: ",
        projects_dir, " (", listing.error, ")",
      ], ""),
    }
  } else if !filesystem_listing_names_entry(listing: listing.entries, name: entry_name) {
    EnvelopeReady { envelope: empty_repository(), generation: GenerationExpectedAbsent }
  } else {
    match load_repository_indexed(path: path) {
      RepositoryLoaded { path: _, envelope, generation } =>
        EnvelopeReady { envelope: envelope, generation: GenerationExpected(generation) }
      RepositoryLoadRefused { cause } =>
        EnvelopeSourceRefused {
          detail: join([
            "the project SCM envelope at ", path,
            " exists but could not be loaded, and the belt does not pave over a repository it cannot read: ",
            belt_scm_load_refusal_detail(cause: cause),
          ], ""),
        }
    }
  }
}

fn belt_scm_load_refusal_detail(cause: RepositoryLoadRefusal) -> String {
  match cause {
    RepositoryFileUnreadable { path, error } =>
      join(["the envelope file could not be read: ", path, " (", error, ")"], "")
    RepositoryDocumentUnparseable { path, gap: _ } =>
      join(["the envelope file is not JSON: ", path], "")
    RepositoryDocumentRefused { path, cause } =>
      match repository_document_protocol(cause: cause) {
        RepositoryProtocolIndexHasNoObjectRoster { found } =>
          join([
            "the envelope at ", path, " is ", found,
            ", whose index carries no object roster, so the belt cannot read only what it needs; migrate it once, outside a tick (gunbc.scm.repository_convert scm_convert_repository_cli)",
          ], "")
        RepositoryProtocolRetiredFormat { found: _ } => join(["the envelope document declares a retired format: ", path], "")
        RepositoryProtocolUnrecognizedFormat { found: _ } => join(["the envelope document declares an unrecognized format: ", path], "")
        RepositoryProtocolUnrecognizedIdentityRule { found: _ } => join(["the envelope document declares an unrecognized identity rule: ", path], "")
        RepositoryProtocolNotAProtocolRefusal => join(["the envelope document is refused by the repository schema: ", path], "")
      }
  }
}

// THE BASE TREE IS READ THROUGH THE BRIDGE, one `git show <sha>:<path>` per tracked path, and
// staged into the object store in ONE batch (gunbc.scm.object_store store_authored_sources_batch).
// One-time per project envelope; an unreadable base file stops the seed -- a partial base would
// make every later merge answer about a tree the intake never was. The batch is what makes the
// once affordable: the per-insert path was measured quadratic at this corpus size on 2026-09-21
// (a 7,050-file seeding never completed a belt tick).
type BeltBaseTexts
  = BaseTextsGathered { texts: List<String> }
  | BaseTextsRefused { detail: String }

fn belt_scm_gather_base_texts(
  instance: HostDashboardInstance,
  worktree: String,
  paths: List<NonEmptyStr>,
  base_sha: String,
) -> BeltBaseTexts {
  fold(
    paths,
    init: BaseTextsGathered { texts: [] },
    f: (acc, path) =>
      match acc {
        BaseTextsRefused { detail: _ } => acc
        BaseTextsGathered { texts } =>
          match belt_commit_git(
            instance: instance,
            worktree: worktree,
            args: worktree_base_file_args(base_sha: base_sha, path: path as String),
          ) {
            ExecFailed { program, exit_code, stderr } =>
              BaseTextsRefused {
                detail: belt_commit_exec_detail(
                  step: join(["base-file ", path as String], ""),
                  outcome: ExecFailed { program: program, exit_code: exit_code, stderr: stderr },
                ),
              }
            ExecRefused { program, reason } =>
              BaseTextsRefused {
                detail: belt_commit_exec_detail(
                  step: join(["base-file ", path as String], ""),
                  outcome: ExecRefused { program: program, reason: reason },
                ),
              }
            ExecOk { stdout } => BaseTextsGathered { texts: concat(texts, [stdout]) }
          }
      },
  )
}

// THE STAGE VERDICT, SAME DURABILITY SPLIT: ManifestBuildRefused is transient (the gather's
// bridge or read I/O), ManifestBuildPoisoned is durable (a base batch the store refuses, which
// is store damage and survives every retry).
type BeltManifestBuild
  = ManifestEntriesBuilt { store: ObjectStore, entries: List<CorpusManifestEntry> }
  | ManifestBuildRefused { detail: String }
  | ManifestBuildPoisoned { detail: String }

// THE INTAKE BASE IS THE SPAWN ORIGIN'S RECORDED SHA, never a moving ref. The dispatch writes the
// origin (base_ref + base_sha) before the worker starts; a project envelope's base commit freezes
// exactly that tree, read back through the declared git bridge one path at a time.
type BeltBaseSha
  = BaseShaObserved { base_sha: String }
  | BaseShaUnobserved { reason: String }

fn belt_scm_base_sha_observe(instance: HostDashboardInstance, node_id: RoadmapNodeId, attempt_key: String) -> BeltBaseSha {
  let path = dispatch_attempt_spawn_origin_path_for_instance(
    instance: instance,
    node_id: node_id,
    attempt_key: attempt_key,
  )
  let read = Filesystem.Read(path: path)
  match filesystem_read_outcome(content: read.content, success: read.success, error: read.error) {
    FilesystemReadRefused { error } =>
      BaseShaUnobserved {
        reason: join([
          "the attempt's spawn origin could not be read, so the intake base is unknown: ",
          path, " (", error, ") — the project base must freeze the recorded dispatch base",
        ], ""),
      }
    FilesystemReadSucceeded { content } =>
      match parse_json_document(s: content) {
      JsonDocumentUnreadable { gap: _ } =>
        BaseShaUnobserved { reason: join(["the spawn origin at ", path, " is not JSON"], "") }
      JsonDocumentParsed { value: doc } =>
        match publication_receipt_member(doc: doc, key: "base_sha") {
          ReceiptMemberUnreadable { reason: r } => BaseShaUnobserved { reason: r }
          ReceiptMemberRead { value: base_sha } =>
            if trim(base_sha) == "" {
              BaseShaUnobserved { reason: "the spawn origin records an empty base sha" }
            } else {
              BaseShaObserved { base_sha: trim(base_sha) }
            }
        }
    }
  }
}

// THE ATTEMPT'S EXECUTOR ORIGIN, read back from the same spawn-origin record the belt wrote once at spawn. Every
// way of not reading it is Unreadable, which the metering mint refuses: an attempt whose origin cannot be read is
// never treated as a real one.
fn belt_spawn_executor_origin_observe(instance: HostDashboardInstance, node_id: RoadmapNodeId, attempt_key: String) -> DispatchExecutorOriginRead {
  let path = dispatch_attempt_spawn_origin_path_for_instance(
    instance: instance,
    node_id: node_id,
    attempt_key: attempt_key,
  )
  let read = Filesystem.Read(path: path)
  match filesystem_read_outcome(content: read.content, success: read.success, error: read.error) {
    FilesystemReadRefused { error } =>
      DispatchExecutorOriginUnreadable { reason: join(["the spawn origin could not be read: ", path, " (", error, ")"], "") }
    FilesystemReadSucceeded { content } =>
      match parse_json_document(s: content) {
        JsonDocumentUnreadable { gap: _ } => DispatchExecutorOriginUnreadable { reason: join(["the spawn origin at ", path, " is not JSON"], "") }
        JsonDocumentParsed { value: doc } => dispatch_executor_origin_of_document(doc: doc)
      }
  }
}

fn belt_scm_stage_base_tree(
  instance: HostDashboardInstance,
  worktree: String,
  store: ObjectStore,
  paths: List<NonEmptyStr>,
  base_sha: String,
) -> BeltManifestBuild {
  match belt_scm_gather_base_texts(
    instance: instance,
    worktree: worktree,
    paths: paths,
    base_sha: base_sha,
  ) {
    BaseTextsRefused { detail } => ManifestBuildRefused { detail: detail }
    BaseTextsGathered { texts } =>
      match store_authored_sources_batch(store: store, texts: texts) {
        SourceBatchCollision { identity: _ } =>
          ManifestBuildPoisoned {
            detail: "the object store refuses the base batch: a different source already holds a content identity, which is store damage",
          }
        SourcesBatched { store: next, sources } =>
          ManifestEntriesBuilt {
            store: next,
            entries: belt_scm_entries_zip(paths: paths, sources: sources),
          }
      }
  }
}

// Paths and sources align by construction of the batch (one reference per input text, in input
// order, duplicates included). The zip goes through an index map because the list has no
// positional access: one O(n) map build, then cheap lookups -- never a fold-per-path rescan.
type BeltZipIndexAcc { i: Int, m: Map<String, AuthoredSourceObjectRef> }
type BeltZipAcc { i: Int, entries: List<CorpusManifestEntry> }

fn belt_scm_entries_zip(paths: List<NonEmptyStr>, sources: List<AuthoredSourceObjectRef>) -> List<CorpusManifestEntry> {
  let by_index = fold(
    sources,
    init: BeltZipIndexAcc { i: 0, m: empty_map() },
    f: fn(acc, s) {
      BeltZipIndexAcc { i: acc.i + 1, m: map_insert(acc.m, to_string(acc.i), s) }
    },
  ).m
  fold(
    paths,
    init: BeltZipAcc { i: 0, entries: [] },
    f: fn(acc, path) {
      match map_get(by_index, key: to_string(acc.i)) {
        Absent => acc
        Present { value: source } =>
          BeltZipAcc {
            i: acc.i + 1,
            entries: concat(
              acc.entries,
              [CorpusManifestEntry { path: path, source: authored_source_target_of(reference: source) }],
            ),
          }
      }
    },
  ).entries
}

// THE SEED'S VERDICT CARRIES THE SAME DURABILITY SPLIT AS THE CAPTURE'S (see BeltScmCapture):
// SeedRefused is transient (gather/exec/read/save I/O), SeedPoisoned is durable (store or
// envelope damage, an unsatisfiable base). The seed is the capture's first half, so the split
// is born here rather than re-classified where the seed's verdict joins the capture's.
// SeedReady carries the generation the capture persist must compare against. When this
// seed wrote, that is the generation of the index this seed wrote -- not the pre-seed
// observation, which a first save from absence would make stale on the capture persist.
// When the envelope already held commits, the seed did not write, and the observation
// this tick loaded remains the expectation.
type BeltSeedOutcome
  = SeedReady { envelope: RepositoryEnvelope, generation: RepositoryGenerationExpectation }
  | SeedRefused { detail: String }
  | SeedPoisoned { detail: String }

// SEED ONCE. The envelope holding any commit at all is already seeded -- the second candidate of a
// project must never re-read the base tree. The seed is saved before the candidate work begins, so
// a crash after seeding does not re-seed either. The save is the guarded sharded writer: a seed is
// the first-save path (the observation minted GenerationExpectedAbsent, or the generation of the
// empty envelope on disk), and the guard keeps it first -- an envelope that appears between this
// tick's observe and the seed's write is refused, not clobbered.
//
// Two notes on the mint below, kept at declaration grain (the annotation channel admits no
// in-body comments): on the BaseShaUnobserved arm -- THE SPAWN ORIGIN IS WRITTEN ONCE, BY THE
// DISPATCH THAT SPAWNED THIS ATTEMPT. No retry of the capture can create it for this attempt key;
// only a fresh dispatch can. That is durable for the attempt, so it poisons rather than refuses.
// On the commit_staged arms -- THE MINT'S DURABLE REFUSALS. Given the same staged tree and store
// these recompute to the same refusal every time, so retry buys nothing; the save arms below them
// are I/O and stay transient.
fn belt_scm_envelope_seeded(
  instance: HostDashboardInstance,
  worktree: String,
  envelope: RepositoryEnvelope,
  generation: RepositoryGenerationExpectation,
  path: String,
  paths: List<NonEmptyStr>,
  base_sha: String,
  revision: IntakeRevision,
) -> BeltSeedOutcome {
  if count(envelope.commits) > 0 {
    SeedReady { envelope: envelope, generation: generation }
  } else {
        match belt_scm_stage_base_tree(
          instance: instance,
          worktree: worktree,
          store: envelope.store,
          paths: paths,
          base_sha: base_sha,
        ) {
          ManifestBuildRefused { detail } => SeedRefused { detail: detail }
          ManifestBuildPoisoned { detail } => SeedPoisoned { detail: detail }
          ManifestEntriesBuilt { store, entries } =>
            match store_corpus_manifest(store: store, entries: entries) {
              CorpusManifestDuplicatePath { path: p } =>
                SeedPoisoned { detail: join(["the inventory named ", p as String, " twice"], "") }
              CorpusManifestLocatorCollision { identity: _, existing: _, incoming: _ } =>
                SeedPoisoned { detail: "the object store refuses the base manifest: a different manifest already holds its identity, which is store damage" }
              CorpusManifestStored { store: with_manifest, manifest } =>
                match mint_intake_base(
                  repository: RepositoryEnvelope {
                    store: with_manifest,
                    commits: envelope.commits,
                    commit_allocator: envelope.commit_allocator,
                    checked_out: envelope.checked_out,
                    staged: envelope.staged,
                  },
                  root: CorpusManifestTarget { locator: manifest.locator },
                  message: join(["project base: ", base_sha], ""),
                  revision: revision,
                ) {
                  IntakeBaseRootRefused { cause: _ } =>
                    SeedPoisoned { detail: "the base manifest the seed just stored does not resolve as a complete manifest in its own store, which is store damage" }
                  IntakeBaseLineExists { base: _ } =>
                    SeedPoisoned { detail: "an envelope with no commits already holds an intake base, which is envelope damage" }
                  IntakeBaseAllocatorInvalid { next_ordinal } =>
                    SeedPoisoned {
                      detail: join(["the envelope's commit allocator is invalid (next ordinal ", to_string(next_ordinal), ")"], ""),
                    }
                  IntakeBaseMinted { repository: minted, reference: base_ref } => {
                    let seeded = RepositoryEnvelope {
                      store: minted.store,
                      commits: minted.commits,
                      commit_allocator: minted.commit_allocator,
                      checked_out: Present { value: base_ref },
                      staged: minted.staged,
                    }
                    match save_repository_sharded_guarded(path: path, repo: seeded, expected: generation) {
                      RepositoryGuardedSaveOutcome(RepositorySaved { path: _, written: _, generation: written }) =>
                        SeedReady {
                          envelope: seeded,
                          generation: repository_generation_expected_after_save(generation: written),
                        }
                      RepositoryGuardedSaveOutcome(RepositorySaveRefusedByCodec { path: _, cause: _ }) =>
                        SeedRefused { detail: "the base commit was minted but the envelope could not be encoded for persistence" }
                      RepositoryGuardedSaveOutcome(RepositoryFileUnwritable { path: p, error }) =>
                        SeedRefused { detail: join(["the base commit was minted but the envelope could not be written to ", p, " (", error, ")"], "") }
                      RepositoryGuardedSaveOutcome(RepositoryWriteByteCountUnrepresentable { path: _, reported }) =>
                        SeedRefused { detail: join(["the envelope write reported a nonsensical byte count (", to_string(reported), ")"], "") }
                      RepositoryStaleGenerationRefused { path: _, expected: _, found: _ } =>
                        SeedRefused { detail: "the project envelope changed on disk since this tick observed it; the in-memory base commit is discarded and the seed re-derives on the next tick" }
                      RepositoryGuardedSaveUnobservable { path: _, error } =>
                        SeedRefused { detail: join(["the on-disk envelope generation could not be observed, so the seed refused to write unguarded: ", error], "") }
                    }
                }
            }
        }
    }
  }
}

// THE UNIT OF WORK A CANDIDATE CAPTURES, as the SCM's typed capture identity (gunbc.scm.intake
// CaptureWork): one roadmap node's one attempt, carried as two members -- never a rendered label,
// whose delimiter a node or attempt spelling could contain. Empty spellings name no work. Every capture of that attempt -- the original and a
// recapture after a base advance -- carries this subject, which is what binds a corrective
// supersession to the exact stale work it replaces. The one producer; the legacy conversion reads the
// same pair back from a pre-intake candidate's message and spells it through here.
fn belt_capture_work(node_id: String, attempt_key: String) -> CaptureWork? {
  if node_id == "" || attempt_key == "" {
    none
  } else {
    Present { value: CaptureWork { unit: node_id as NonEmptyStr, attempt: attempt_key as NonEmptyStr } }
  }
}

// THE ATTEMPT'S BASE AS A TYPED REVISION. The spawn origin records the sha as git printed it
// (untagged hex), so it is read through extdeps.git's one decoder for git's own plumbing text; a
// value that is not a git object id cannot name a revision and is refused by the caller.
fn belt_scm_intake_revision(base_sha: String) -> IntakeRevision? {
  match git_object_id_from_untagged_hex(hex: base_sha) {
    Absent => none
    Present { value: id } => Present { value: GitIntakeRevision { id: id } }
  }
}

fn belt_scm_intake_revision_sha(revision: IntakeRevision) -> String {
  match revision {
    GitIntakeRevision { id } => git_object_id_wire_hex(oid: id) as String
  }
}

// THE BASE A CANDIDATE DESCENDS FROM IS THE INTAKE COMMIT FOR ITS ATTEMPT'S BASE (the BaseAdvance
// follow-up to gunbc#13111). Until then every candidate descended from the repository's one root
// commit and a string comparison of that commit's message refused attempts on any other base; now
// the repository holds one intake commit per base revision it has met, and the candidate's parent
// IS the record of which base its delta assumed. An attempt on a revision the repository has not
// met advances the intake line's tip to it first (belt_scm_base_advance), in memory, and the
// candidate's save persists both. A repository whose commits carry no typed intake predates this
// and is refused by name until the legacy conversion types it in place: which base a candidate
// there would descend from is underivable from typed facts, and choosing the root by position is
// the guess this change removes.
type BeltIntakeBase
  = BeltIntakeBaseReady { envelope: RepositoryEnvelope, base_ref: RepositoryCommitRef }
  | BeltIntakeBaseRefused { detail: String }
  | BeltIntakeBasePoisoned { detail: String }

fn belt_scm_intake_base_for(
  git_program: String,
  worktree: String,
  path: String,
  envelope: RepositoryEnvelope,
  revision: IntakeRevision,
) -> BeltIntakeBase {
  match intake_commit_at_revision(commits: envelope.commits, revision: revision) {
    IntakeAtRevisionFound { commit: placed } => BeltIntakeBaseReady { envelope: envelope, base_ref: placed.reference }
    IntakeAtRevisionAmbiguous { commits } =>
      BeltIntakeBasePoisoned { detail: join(["the project repository places the attempt's base on ", to_string(count(commits)), " intake commits, which the one-line census forbids: envelope damage"], "") }
    IntakeAtRevisionAbsent =>
      match intake_tip(commits: envelope.commits) {
        IntakeTipAmbiguous { tips } =>
          BeltIntakeBasePoisoned { detail: join(["the project repository's intake line has ", to_string(count(tips)), " tips, which the one-line census forbids: envelope damage"], "") }
        IntakeTipNoLine =>
          BeltIntakeBasePoisoned {
            detail: "the project repository predates typed base records: no commit carries an intake, so which base a candidate would descend from is underivable until it is converted in place (belt_scm_intake_convert_cli), which types its base and records its stale captures",
          }
        IntakeTipFound(tip) =>
          match tip {
            IntakeTip { commit: tip_commit, revision: tip_revision } =>
              match belt_scm_base_advance(git_program: git_program, worktree: worktree, path: path, envelope: envelope, tip_commit: tip_commit, from: tip_revision, to: revision) {
                BaseAdvanceRefused { detail } => BeltIntakeBaseRefused { detail: detail }
                BaseAdvancePoisoned { detail } => BeltIntakeBasePoisoned { detail: detail }
                BaseAdvanced { envelope: advanced, reference } => BeltIntakeBaseReady { envelope: advanced, base_ref: reference }
              }
          }
      }
  }
}

// THE BASE ADVANCE: the tip's manifest re-bound over EXACTLY `git diff S_k..S_k+1` -- every path the
// diff names deleted or re-bound to its bytes at S_k+1, every other entry the tip's own -- minted as
// an IntakeAdvance { from: S_k, to: S_k+1 } child of the tip, whose admission refuses an advance that
// does not continue the tip's line. Both revisions are first asked whether the bridge can observe
// them; a revision it cannot observe POISONS the advance by name (BaseAdvanceRevisionUnobservable:
// the attempt's object store will not gain it by retrying) rather than diffing against whatever git
// resolves instead. The content demand on history is the tip's manifest (one shard),
// plus the shard of any re-bound bytes the repository already holds.
type BeltBaseAdvance
  = BaseAdvanced { envelope: RepositoryEnvelope, reference: RepositoryCommitRef }
  | BaseAdvanceRefused { detail: String }
  | BaseAdvancePoisoned { detail: String }

fn belt_scm_revision_observable(git_program: String, worktree: String, sha: String, role: String) -> String? {
  match belt_exec(cmd: host_exec_argv(program: git_program, args: revision_observable_args(sha: sha)), workdir: worktree) {
    ExecOk { stdout: _ } => none
    ExecFailed { program: _, exit_code, stderr } =>
      Present {
        value: join([
          "BaseAdvanceRevisionUnobservable: the advance's ", role, " revision ", sha,
          " is not a commit the worktree's git can observe (exit ", to_string(exit_code), ": ", trim(stderr),
          "), so the change between the two bases is underivable",
        ], ""),
      }
    ExecRefused { program: _, reason } =>
      Present { value: join(["BaseAdvanceRevisionUnobservable: the bridge refused to observe the ", role, " revision ", sha, ": ", reason], "") }
  }
}

fn belt_scm_base_advance(
  git_program: String,
  worktree: String,
  path: String,
  envelope: RepositoryEnvelope,
  tip_commit: RepositoryCommit,
  from: IntakeRevision,
  to: IntakeRevision,
) -> BeltBaseAdvance {
  let from_sha = belt_scm_intake_revision_sha(revision: from)
  let to_sha = belt_scm_intake_revision_sha(revision: to)
  let tip_root = tip_commit.root.locator
  match belt_scm_revision_observable(git_program: git_program, worktree: worktree, sha: from_sha, role: "from") {
    Present { value: detail } => BaseAdvancePoisoned { detail: detail }
    Absent =>
  match belt_scm_revision_observable(git_program: git_program, worktree: worktree, sha: to_sha, role: "to") {
    Present { value: detail } => BaseAdvancePoisoned { detail: detail }
    Absent =>
  match belt_exec(cmd: host_exec_argv(program: git_program, args: revision_changes_between_args(from: from_sha, to: to_sha)), workdir: worktree) {
    ExecFailed { program, exit_code, stderr } =>
      BaseAdvanceRefused { detail: belt_commit_exec_detail(step: "base-advance-diff", outcome: ExecFailed { program: program, exit_code: exit_code, stderr: stderr }) }
    ExecRefused { program, reason } =>
      BaseAdvanceRefused { detail: belt_commit_exec_detail(step: "base-advance-diff", outcome: ExecRefused { program: program, reason: reason }) }
    ExecOk { stdout } => {
      let changes = worktree_changes_parse(stdout_nul: stdout)
      match belt_scm_advance_texts(git_program: git_program, worktree: worktree, to_sha: to_sha, changes: changes, step: "base-advance-file") {
        AdvanceTextsRefused { detail } => BaseAdvanceRefused { detail: detail }
        AdvanceTextsRead { texts } =>
          match materialize_objects(envelope_path: path, store: envelope.store, identities: [tip_root]) {
            ObjectMaterializationRefused { detail } =>
              BaseAdvanceRefused { detail: join(["the intake tip's manifest could not be read from its shard: ", detail], "") }
            ObjectsMaterialized { store: with_tip, read_shards: _ } =>
              match find_corpus_manifest_record(store: with_tip, identity: tip_root) {
                CorpusManifestAbsent { identity: _ } => BaseAdvancePoisoned { detail: "the intake tip's manifest is absent from the store" }
                CorpusManifestIsAuthoredSource { identity: _ } => BaseAdvancePoisoned { detail: "the intake tip's root is an authored source, which is store damage" }
                CorpusManifestIsSemanticNode { identity: _ } => BaseAdvancePoisoned { detail: "the intake tip's root is a semantic node, which is store damage" }
                CorpusManifestFound(tip_record) =>
                  belt_scm_base_advance_mint(
                    path: path,
                    envelope: RepositoryEnvelope {
                      store: with_tip,
                      commits: envelope.commits,
                      commit_allocator: envelope.commit_allocator,
                      checked_out: envelope.checked_out,
                      staged: envelope.staged,
                    },
                    tip_commit: tip_commit,
                    from: from,
                    tip_record: tip_record,
                    to: to,
                    changes: changes,
                    texts: texts,
                  )
              }
          }
      }
    }
  }
  }
  }
}

// THE BYTES OF EVERY RE-BOUND PATH AT S_k+1, keyed by path. Read through the same declared bridge
// verb the seed reads the base with (`git show <sha>:<path>`), so an advance and a seed agree on
// what a revision's file holds.
type BeltAdvanceTexts
  = AdvanceTextsRead { texts: Map<String, String> }
  | AdvanceTextsRefused { detail: String }

fn belt_scm_advance_texts(git_program: String, worktree: String, to_sha: String, changes: List<WorktreeChange>, step: String) -> BeltAdvanceTexts {
  fold(changes, init: AdvanceTextsRead { texts: empty_map() }, f: (acc, change) =>
    match acc {
      AdvanceTextsRefused { detail: _ } => acc
      AdvanceTextsRead { texts } =>
        match change {
          WorktreeDelete { path: _ } => acc
          WorktreeBind { path } =>
            match belt_exec(cmd: host_exec_argv(program: git_program, args: worktree_base_file_args(base_sha: to_sha, path: path as String)), workdir: worktree) {
              ExecOk { stdout } => AdvanceTextsRead { texts: map_insert(texts, path as String, stdout) }
              ExecFailed { program, exit_code, stderr } =>
                AdvanceTextsRefused { detail: belt_commit_exec_detail(step: join([step, " ", path as String], ""), outcome: ExecFailed { program: program, exit_code: exit_code, stderr: stderr }) }
              ExecRefused { program, reason } =>
                AdvanceTextsRefused { detail: belt_commit_exec_detail(step: join([step, " ", path as String], ""), outcome: ExecRefused { program: program, reason: reason }) }
            }
        }
    })
}

// THE PURE RE-BINDING: the tip's entries with exactly `changes` applied, each bind to its text at
// S_k+1. A bind whose text was not read is refused rather than skipped -- a skipped bind would leave
// the tip's bytes at a path the diff says changed, which is the stale-base tree this exists to end.
fn belt_scm_advance_fold(store: ObjectStore, tip_record: CorpusManifestRecord, changes: List<WorktreeChange>, texts: Map<String, String>) -> BeltDeltaFold {
  fold(changes, init: BeltDeltaFold { store: store, unique: path_unique_of_record(base: tip_record), refused: none }, f: (acc, change) =>
    match acc.refused {
      Present { value: _ } => acc
      Absent =>
        match change {
          WorktreeDelete { path: p } =>
            BeltDeltaFold { store: acc.store, unique: path_unique_with_path_removed(unique: acc.unique, path: p), refused: none }
          WorktreeBind { path: p } =>
            match map_get(texts, key: p as String) {
              Absent =>
                BeltDeltaFold { store: acc.store, unique: acc.unique, refused: Present { value: join(["the advance's diff re-binds ", p as String, " but its bytes at the target revision were not read"], "") } }
              Present { value: text } => belt_scm_delta_bind_text(acc: acc, path: p, text: text)
            }
        }
    })
}

fn belt_scm_base_advance_mint(
  path: String,
  envelope: RepositoryEnvelope,
  tip_commit: RepositoryCommit,
  from: IntakeRevision,
  tip_record: CorpusManifestRecord,
  to: IntakeRevision,
  changes: List<WorktreeChange>,
  texts: Map<String, String>,
) -> BeltBaseAdvance {
  let folded = belt_scm_rebind_fold(path: path, store: envelope.store, base_record: tip_record, changes: changes, texts: texts)
  match folded.refused {
    Present { value: detail } => BaseAdvanceRefused { detail: detail }
    Absent =>
      match belt_delta_resident_of(outcome: materialize_if_rostered(envelope_path: path, store: folded.store, identity: path_unique_manifest_identity(unique: folded.unique))) {
        DeltaResidentRefused { detail } =>
          BaseAdvanceRefused { detail: join(["the advanced manifest's identity is already persisted and could not be read back: ", detail], "") }
        DeltaResident { store: manifest_resident } =>
          match store_path_unique_manifest(store: manifest_resident, unique: folded.unique) {
            UniqueManifestLocatorCollision { identity: _, existing: _, incoming: _ } =>
              BaseAdvancePoisoned { detail: "the object store refuses the advanced manifest: a different manifest already holds its identity, which is store damage" }
            UniqueManifestStored { store: with_manifest, manifest } =>
              match mint_intake_advance(
                repository: RepositoryEnvelope {
                  store: with_manifest,
                  commits: envelope.commits,
                  commit_allocator: envelope.commit_allocator,
                  checked_out: envelope.checked_out,
                  staged: envelope.staged,
                },
                root: CorpusManifestTarget { locator: manifest.locator },
                message: join(["project base advance: ", belt_scm_intake_revision_sha(revision: from), "..", belt_scm_intake_revision_sha(revision: to)], ""),
                parent: tip_commit.reference,
                from: from,
                to: to,
              ) {
                IntakeAdvanceMinted { repository, reference } => BaseAdvanced { envelope: repository, reference: reference }
                IntakeAdvanceAllocatorInvalid { next_ordinal } =>
                  BaseAdvancePoisoned { detail: join(["the envelope's commit allocator is invalid (next ordinal ", to_string(next_ordinal), ")"], "") }
                IntakeAdvanceParentMissing { parent: _ } =>
                  BaseAdvancePoisoned { detail: "the intake tip is not a commit of its own envelope, which is envelope damage" }
                IntakeAdvanceRootRefused { cause: _ } =>
                  BaseAdvancePoisoned { detail: "the advanced manifest does not resolve as a complete manifest in its own store, which is store damage" }
                IntakeAdvanceDoesNotMove { revision: _ } =>
                  BaseAdvancePoisoned { detail: "the advance's two revisions are one revision, which the intake tip search cannot produce: envelope damage" }
                IntakeAdvanceDiscontinuous { parent: _, line: _ } =>
                  BaseAdvancePoisoned { detail: "the intake tip's line does not stand at the tip's own revision, which is envelope damage" }
                IntakeAdvanceRevisionAlreadyPlaced { commits: _ } =>
                  BaseAdvancePoisoned { detail: "the advance's target revision is already placed, which the intake search had just ruled out: envelope damage" }
                IntakeAdvanceLineAlreadyAdvanced { commit: _ } =>
                  BaseAdvancePoisoned { detail: "an advance already leaves the intake tip's revision, so the tip search returned a commit that is not the tip: envelope damage" }
              }
          }
      }
  }
}

// THE CAPTURE, WHOLE. Seed-once (an envelope holding any commit is already seeded), then the
// candidate is staged from the worktree and minted DESCENDING FROM THE SHARED BASE: the selection
// is moved to the base for the mint and restored afterwards, so between belt operations
// checked_out IS the integration head and restart recovery is a pure derivation from the
// envelope. A candidate identical to the intake base is refused -- there is no change to deliver.
//
// One note on the zero-inventory arm below, kept at declaration grain (the annotation channel
// admits no in-body comments): THE RECORDED BASE IS A FACT ABOUT THE DISPATCH, not about this
// tick's I/O: an inventory that named zero files names zero files on every retry.
fn belt_scm_capture_candidate_tree(
  instance: HostDashboardInstance,
  worktree: String,
  node_id: RoadmapNodeId,
  attempt_key: String,
  message: String,
  committed_revision: String?,
) -> BeltScmMint {
  match project_key_for_node(node_id: node_id as String, memberships: roadmap_memberships()) {
    Absent =>
      ScmCaptureMintPoisoned {
        detail: "multiple authored parents name this node; project ownership is ambiguous: the authority must name one owning arc before a candidate can be captured",
      }
    Present { value: project_key } =>
  let projects_dir = belt_scm_projects_dir(instance: instance)
  match belt_exec(
    cmd: host_exec_argv(
      program: dispatch_capability_program(
        environment: instance.execution_environment,
        cap: AttemptStateDirectoryCapability,
      ),
      args: ["-d", "-m", "0700", projects_dir],
    ),
    workdir: worktree,
  ) {
    ExecFailed { program, exit_code, stderr } =>
      ScmCaptureMintRefused {
        detail: belt_commit_exec_detail(
          step: "projects-directory",
          outcome: ExecFailed { program: program, exit_code: exit_code, stderr: stderr },
        ),
      }
    ExecRefused { program, reason } =>
      ScmCaptureMintRefused {
        detail: belt_commit_exec_detail(step: "projects-directory", outcome: ExecRefused { program: program, reason: reason }),
      }
    ExecOk { stdout: _ } => {
      let path = belt_scm_project_repository_path(instance: instance, project_key: project_key)
      match belt_scm_envelope_observe(
        projects_dir: projects_dir,
        path: path,
        entry_name: belt_scm_project_entry_name(project_key: project_key),
      ) {
        EnvelopeSourceRefused { detail } => ScmCaptureMintRefused { detail: detail }
        EnvelopeReady { envelope, generation } =>
          match belt_scm_base_sha_observe(
            instance: instance,
            node_id: node_id,
            attempt_key: attempt_key,
          ) {
            BaseShaUnobserved { reason } => ScmCaptureMintPoisoned { detail: reason }
            BaseShaObserved { base_sha } =>
          match belt_scm_intake_revision(base_sha: base_sha) {
            Absent =>
              ScmCaptureMintPoisoned {
                detail: join(["the attempt's recorded base '", base_sha, "' is not a git object id, so no typed base record can name it"], ""),
              }
            Present { value: revision } =>
          match belt_commit_git(instance: instance, worktree: worktree, args: worktree_base_inventory_args(base_sha: base_sha)) {
            ExecFailed { program, exit_code, stderr } =>
              ScmCaptureMintRefused {
                detail: belt_commit_exec_detail(
                  step: "inventory",
                  outcome: ExecFailed { program: program, exit_code: exit_code, stderr: stderr },
                ),
              }
            ExecRefused { program, reason } =>
              ScmCaptureMintRefused {
                detail: belt_commit_exec_detail(step: "inventory", outcome: ExecRefused { program: program, reason: reason }),
              }
            ExecOk { stdout } => {
              let paths = worktree_inventory_parse(stdout_nul: stdout)
              if count(paths) == 0 {
                ScmCaptureMintPoisoned {
                  detail: "the recorded base names zero files, so capturing against it would mint an empty tree as the worker's deliverable",
                }
              } else {
                match belt_scm_envelope_seeded(
                  instance: instance,
                  worktree: worktree,
                  envelope: envelope,
                  generation: generation,
                  path: path,
                  paths: paths,
                  base_sha: base_sha,
                  revision: revision,
                ) {
                  SeedRefused { detail } => ScmCaptureMintRefused { detail: detail }
                  SeedPoisoned { detail } => ScmCaptureMintPoisoned { detail: detail }
                  SeedReady { envelope: seeded, generation: seeded_generation } =>
                    match belt_scm_intake_base_for(
                      git_program: dispatch_capability_program(environment: instance.execution_environment, cap: GitWorkspaceCapability),
                      worktree: worktree,
                      path: path,
                      envelope: seeded,
                      revision: revision,
                    ) {
                      BeltIntakeBaseRefused { detail } => ScmCaptureMintRefused { detail: detail }
                      BeltIntakeBasePoisoned { detail } => ScmCaptureMintPoisoned { detail: detail }
                      BeltIntakeBaseReady { envelope: based, base_ref } =>
                        match belt_capture_work(node_id: node_id as String, attempt_key: attempt_key) {
                          Absent => ScmCaptureMintPoisoned { detail: "the attempt key is empty, so no work identity can name this capture" }
                          Present { value: work } =>
                            belt_scm_delta_capture(
                              instance: instance,
                              worktree: worktree,
                              work: work,
                              seeded: based,
                              generation: seeded_generation,
                              base_ref: base_ref,
                              head_ref: seeded.checked_out,
                              base_sha: base_sha,
                              path: path,
                              message: message,
                              committed_revision: committed_revision,
                            )
                        }
                    }
                }
              }
            }
          }
      }
    }
  }
  }
  }
  }
}

// THE CANDIDATE DELTA: the candidate manifest is the base manifest with exactly the changed paths
// re-bound and the deleted paths removed, never the whole corpus re-staged. Two bridge verbs name
// the change population against the recorded base (worktree_changes_since_args for tracked,
// worktree_untracked_args for new files), and the selection moves are plain field assignments --
// the previous shape's two whole-corpus checkout recoveries per capture are gone with the
// whole-tree staging.
type BeltDeltaFold {
  store: ObjectStore
  unique: PathUniqueManifestEntries
  refused: String?
}

// THE RE-BOUND BYTES THE REPOSITORY ALREADY PERSISTS (a revert, a file restored to an earlier
// content) are materialized ONCE for the whole change population, before any bind: the identity law
// refuses two contents under one identity, and that comparison needs the persisted object -- read
// from exactly its shard (gunbc.scm.repository_load materialize_objects), never by decoding the
// repository. The demand is derived from the texts, so every shard the population names is planned
// and read once; a per-path demand re-read a shard for each of its members. Bytes the repository
// has never held need no read at all.
type BeltDeltaResident
  = DeltaResident { store: ObjectStore }
  | DeltaResidentRefused { detail: String }

fn belt_delta_resident_of(outcome: ObjectMaterialization) -> BeltDeltaResident {
  match outcome {
    ObjectMaterializationRefused { detail } => DeltaResidentRefused { detail: detail }
    ObjectsMaterialized { store, read_shards: _ } => DeltaResident { store: store }
  }
}

fn belt_scm_rebound_identities(store: ObjectStore, changes: List<WorktreeChange>, texts: Map<String, String>) -> List<ObjectId> {
  filter(
    flat_map(changes, change =>
      match change {
        WorktreeDelete { path: _ } => []
        WorktreeBind { path } =>
          match map_get(texts, key: path as String) {
            Absent => []
            Present { value: text } => [scm_object_identity(object: authored_source_object(text: text))]
          }
      }),
    identity => match store_rostered_lookup(store: store, identity: identity) {
      Present { value: _ } => true
      Absent => false
    },
  )
}

// THE RE-BINDING OF A CHANGE POPULATION OVER A BASE MANIFEST, shared by the tick, recapture and the
// base advance: the bytes are read first (by the caller), the persisted objects they may shadow are
// materialized once, and the fold is then pure.
fn belt_scm_rebind_fold(path: String, store: ObjectStore, base_record: CorpusManifestRecord, changes: List<WorktreeChange>, texts: Map<String, String>) -> BeltDeltaFold {
  match belt_delta_resident_of(outcome: materialize_objects(envelope_path: path, store: store, identities: belt_scm_rebound_identities(store: store, changes: changes, texts: texts))) {
    DeltaResidentRefused { detail } =>
      BeltDeltaFold {
        store: store,
        unique: path_unique_of_record(base: base_record),
        refused: Present { value: join(["the changed paths re-bind bytes the repository already holds, and they could not be read back: ", detail], "") },
      }
    DeltaResident { store: resident } =>
      belt_scm_advance_fold(store: resident, tip_record: base_record, changes: changes, texts: texts)
  }
}

// THE BYTES OF A TICK'S BOUND PATHS, read from the dirty worktree. A path that cannot be read is
// this tick's I/O: the next tick reads again.
fn belt_scm_worktree_texts(worktree: String, changes: List<WorktreeChange>) -> BeltAdvanceTexts {
  fold(changes, init: AdvanceTextsRead { texts: empty_map() }, f: (acc, change) =>
    match acc {
      AdvanceTextsRefused { detail: _ } => acc
      AdvanceTextsRead { texts } =>
        match change {
          WorktreeDelete { path: _ } => acc
          WorktreeBind { path } => {
            let read = Filesystem.Read(path: join([worktree, "/", path as String], ""))
            match filesystem_read_outcome(content: read.content, success: read.success, error: read.error) {
              FilesystemReadRefused { error } =>
                AdvanceTextsRefused {
                  detail: join(["the changed path ", path as String, " could not be read from the worktree (", error, "), so the tree cannot be captured whole"], ""),
                }
              FilesystemReadSucceeded { content } => AdvanceTextsRead { texts: map_insert(texts, path as String, content) }
            }
          }
        }
    })
}

// THE BYTES OF A CAPTURE'S BOUND PATHS: the committed revision's through the declared bridge for
// recapture, the dirty worktree's for the tick.
fn belt_scm_delta_texts(instance: HostDashboardInstance, worktree: String, committed_revision: String?, changes: List<WorktreeChange>) -> BeltAdvanceTexts {
  match committed_revision {
    Absent => belt_scm_worktree_texts(worktree: worktree, changes: changes)
    Present { value: revision } =>
      belt_scm_advance_texts(
        git_program: dispatch_capability_program(environment: instance.execution_environment, cap: GitWorkspaceCapability),
        worktree: worktree,
        to_sha: revision,
        changes: changes,
        step: "recapture-file",
      )
  }
}

// ONE BIND OF NEW BYTES AT A PATH, shared by the candidate delta (bytes read from the worktree) and
// the base advance (bytes read from the revision it advances to): the identity-law readback of a
// re-bound persisted object, the store, and the path-unique re-binding are one rule, so they are one
// function rather than two copies free to drift.
fn belt_scm_delta_bind_text(acc: BeltDeltaFold, path: NonEmptyStr, text: String) -> BeltDeltaFold {
  match store_authored_source(store: acc.store, text: text) {
    SourceLocatorCollision { identity: _, existing: _, incoming: _ } =>
      BeltDeltaFold {
        store: acc.store,
        unique: acc.unique,
        refused: Present {
          value: join([
            "the object store refuses ", path as String,
            ": a different source already holds its content identity, which is store damage",
          ], ""),
        },
      }
    SourceStored { store: next, source } =>
      BeltDeltaFold {
        store: next,
        unique: path_unique_with_path_bound(
          unique: acc.unique,
          path: path,
          source: authored_source_target_of(reference: source),
        ),
        refused: none,
      }
  }
}

// Two notes on the mint arms below, kept at declaration grain (the annotation channel admits no
// in-body comments): on the delta fold's refused arm -- A CHANGED PATH THAT CANNOT BE READ is this
// tick's I/O; the next tick reads again, so it stays transient. On the commit_staged arms -- THE
// MINT'S DURABLE REFUSALS, the same classification the seed's mint carries: identical-to-base,
// allocator damage, and unrecoverable sources recompute to the same refusal on every retry.
// THE SAVE'S GUARD ARMS ARE TRANSIENT TOO: a stale generation or an unobservable one is this tick's
// fact about the world, not the attempt's -- the next tick observes the envelope fresh and
// re-derives the capture against whatever is actually on disk. AND THE CAPTURED ROOT LOCATOR IS
// THE MANIFEST THE MINT CONSUMED, recorded from the value already in scope: commit_staged freezes
// this member as the commit's root by construction, so deriving the locator from it is
// construction-over-validation, not a re-lookup that would carry a dead missing-commit arm.
fn belt_scm_delta_capture(
  instance: HostDashboardInstance,
  worktree: String,
  work: CaptureWork,
  seeded: RepositoryEnvelope,
  generation: RepositoryGenerationExpectation,
  base_ref: RepositoryCommitRef,
  head_ref: RepositoryCommitRef?,
  base_sha: String,
  path: String,
  message: String,
  committed_revision: String?,
) -> BeltScmMint {
  match commit_at_reference(commits: seeded.commits, reference: base_ref) {
    Absent =>
      ScmCaptureMintPoisoned { detail: "the seeded base commit is not a commit of its own envelope, which is envelope damage" }
    Present { value: base_commit } =>
      match materialize_objects(envelope_path: path, store: seeded.store, identities: [base_commit.root.locator]) {
        ObjectMaterializationRefused { detail } =>
          ScmCaptureMintRefused { detail: join(["the base commit's manifest could not be read from its shard: ", detail], "") }
        ObjectsMaterialized { store: with_base, read_shards: _ } =>
          belt_scm_delta_capture_over(
            instance: instance,
            worktree: worktree,
            work: work,
            seeded: RepositoryEnvelope {
              store: with_base,
              commits: seeded.commits,
              commit_allocator: seeded.commit_allocator,
              checked_out: seeded.checked_out,
              staged: seeded.staged,
            },
            generation: generation,
            head_ref: head_ref,
            base_ref: base_ref,
            base_sha: base_sha,
            path: path,
            message: message,
            base_commit: base_commit,
            committed_revision: committed_revision,
          )
      }
  }
}

type BeltDeltaChangeSet
  = DeltaChangesCollected { changes: List<WorktreeChange> }
  | DeltaChangesRefused { detail: String }

// THE CHANGE POPULATION. The tick reads the dirty worktree against the spawn base. Recapture reads
// the committed revision against that same base through a tree-to-tree diff the worktree cannot
// perturb, and never the untracked list -- a committed tree has no untracked files.
fn belt_scm_delta_changes(
  instance: HostDashboardInstance,
  worktree: String,
  base_sha: String,
  committed_revision: String?,
) -> BeltDeltaChangeSet {
  match committed_revision {
    Present { value: head } =>
      match belt_commit_git(
        instance: instance,
        worktree: worktree,
        args: revision_changes_between_args(from: base_sha, to: head),
      ) {
        ExecFailed { program, exit_code, stderr } =>
          DeltaChangesRefused {
            detail: belt_commit_exec_detail(
              step: "recapture-changes",
              outcome: ExecFailed { program: program, exit_code: exit_code, stderr: stderr },
            ),
          }
        ExecRefused { program, reason } =>
          DeltaChangesRefused {
            detail: belt_commit_exec_detail(step: "recapture-changes", outcome: ExecRefused { program: program, reason: reason }),
          }
        ExecOk { stdout } => DeltaChangesCollected { changes: worktree_changes_parse(stdout_nul: stdout) }
      }
    Absent =>
      match belt_commit_git(
        instance: instance,
        worktree: worktree,
        args: worktree_changes_since_args(base_sha: base_sha),
      ) {
        ExecFailed { program, exit_code, stderr } =>
          DeltaChangesRefused {
            detail: belt_commit_exec_detail(
              step: "changes",
              outcome: ExecFailed { program: program, exit_code: exit_code, stderr: stderr },
            ),
          }
        ExecRefused { program, reason } =>
          DeltaChangesRefused {
            detail: belt_commit_exec_detail(step: "changes", outcome: ExecRefused { program: program, reason: reason }),
          }
        ExecOk { stdout: changes_out } =>
          match belt_commit_git(instance: instance, worktree: worktree, args: worktree_untracked_args) {
            ExecFailed { program, exit_code, stderr } =>
              DeltaChangesRefused {
                detail: belt_commit_exec_detail(
                  step: "untracked",
                  outcome: ExecFailed { program: program, exit_code: exit_code, stderr: stderr },
                ),
              }
            ExecRefused { program, reason } =>
              DeltaChangesRefused {
                detail: belt_commit_exec_detail(step: "untracked", outcome: ExecRefused { program: program, reason: reason }),
              }
            ExecOk { stdout: untracked_out } =>
              DeltaChangesCollected {
                changes: concat(
                  worktree_changes_parse(stdout_nul: changes_out),
                  map(worktree_inventory_parse(stdout_nul: untracked_out), p => WorktreeBind { path: p }),
                ),
              }
          }
      }
  }
}

// THE CAPTURE'S ONE CONTENT DEMAND ON HISTORY IS ITS BASE MANIFEST, materialized above from its own
// shard; everything else the capture reads is either the worktree's change set or the committed
// revision's, selected by the caller.
fn belt_scm_delta_capture_over(
  instance: HostDashboardInstance,
  worktree: String,
  work: CaptureWork,
  seeded: RepositoryEnvelope,
  generation: RepositoryGenerationExpectation,
  base_ref: RepositoryCommitRef,
  head_ref: RepositoryCommitRef?,
  base_sha: String,
  path: String,
  message: String,
  base_commit: RepositoryCommit,
  committed_revision: String?,
) -> BeltScmMint {
      match find_corpus_manifest_record(store: seeded.store, identity: base_commit.root.locator) {
        CorpusManifestAbsent { identity: _ } =>
          ScmCaptureMintPoisoned { detail: "the seeded base's manifest is absent from the store" }
        CorpusManifestIsAuthoredSource { identity: _ } =>
          ScmCaptureMintPoisoned { detail: "the seeded base's root is an authored source, which is store damage" }
        CorpusManifestIsSemanticNode { identity: _ } =>
          ScmCaptureMintPoisoned { detail: "the seeded base's root is a semantic node, which is store damage" }
        CorpusManifestFound(base_record) =>
          match belt_scm_delta_changes(instance: instance, worktree: worktree, base_sha: base_sha, committed_revision: committed_revision) {
            DeltaChangesRefused { detail } => ScmCaptureMintRefused { detail: detail }
            DeltaChangesCollected { changes } => {
                  let folded = match belt_scm_delta_texts(instance: instance, worktree: worktree, committed_revision: committed_revision, changes: changes) {
                    AdvanceTextsRefused { detail } =>
                      BeltDeltaFold { store: seeded.store, unique: path_unique_of_record(base: base_record), refused: Present { value: detail } }
                    AdvanceTextsRead { texts } =>
                      belt_scm_rebind_fold(path: path, store: seeded.store, base_record: base_record, changes: changes, texts: texts)
                  }
                  match folded.refused {
                    Present { value: detail } => ScmCaptureMintRefused { detail: detail }
                    Absent =>
                      match belt_delta_resident_of(outcome: materialize_if_rostered(envelope_path: path, store: folded.store, identity: path_unique_manifest_identity(unique: folded.unique))) {
                        DeltaResidentRefused { detail } =>
                          ScmCaptureMintRefused { detail: join(["the candidate manifest's identity is already persisted and could not be read back: ", detail], "") }
                        DeltaResident { store: manifest_resident } =>
                      match store_path_unique_manifest(store: manifest_resident, unique: folded.unique) {
                        UniqueManifestLocatorCollision { identity: _, existing: _, incoming: _ } =>
                          ScmCaptureMintPoisoned {
                            detail: "the object store refuses the candidate manifest: a different manifest already holds its identity, which is store damage, not a capture",
                          }
                        UniqueManifestStored { store: with_manifest, manifest } =>
                          match commit_staged_capture(
                            repository: RepositoryEnvelope {
                              store: with_manifest,
                              commits: seeded.commits,
                              commit_allocator: seeded.commit_allocator,
                              checked_out: Present { value: base_ref },
                              staged: Present { value: manifest },
                            },
                            message: message,
                            work: work,
                          ) {
                            StagedCaptureWithoutBase =>
                              ScmCaptureMintPoisoned { detail: "the capture's base commit is not selected, so the candidate would be a root, which no capture may be: envelope damage" }
                            StagedCaptureCommitted(staged) =>
                          match staged {
                            StagedCommitCandidateRefused { cause: _ } =>
                              ScmCaptureMintPoisoned {
                                detail: "the SCM stage could not be compared against its base, so the capture was not minted",
                              }
                            StagedCommitNothingToFreeze =>
                              ScmCaptureMintPoisoned {
                                detail: "the declared candidate is identical to the intake base: there is no change to deliver, so there is no candidate to bind",
                              }
                            StagedCommitAllocatorInvalid { next_ordinal } =>
                              ScmCaptureMintPoisoned {
                                detail: join([
                                  "the project envelope's commit allocator is invalid (next ordinal ",
                                  to_string(next_ordinal), "), which is envelope damage, not a capture",
                                ], ""),
                              }
                            StagedCommitSourceUnrecoverable { cause: _ } =>
                              ScmCaptureMintPoisoned {
                                detail: "a staged path's source is unrecoverable from the object store, so the candidate must not be published into history",
                              }
                            StagedCommitMinted { repository: with_candidate, reference } =>
                              ScmCandidateMinted {
                                repository: RepositoryEnvelope {
                                  store: with_candidate.store,
                                  commits: with_candidate.commits,
                                  commit_allocator: with_candidate.commit_allocator,
                                  checked_out: match head_ref {
                                    Present { value: h } => Present { value: h }
                                    Absent => Present { value: base_ref }
                                  },
                                  staged: with_candidate.staged,
                                },
                                generation: generation,
                                path: path,
                                commit_ordinal: minted_id_ordinal(id: reference.identity),
                                commit_root_locator: object_id_key(identity: manifest.locator),
                              }
                          }
                          }
                      }
                      }
                  }
            }
          }
      }
}

fn belt_scm_persist_capture(mint: BeltScmMint) -> BeltScmCapture {
  match mint {
    ScmCaptureMintRefused { detail } => ScmCaptureRefused { detail: detail }
    ScmCaptureMintPoisoned { detail } => ScmCapturePoisoned { detail: detail }
    ScmCandidateMinted { repository, generation, path, commit_ordinal, commit_root_locator } =>
      match save_repository_sharded_guarded(path: path, repo: repository, expected: generation) {
        RepositoryGuardedSaveOutcome(RepositorySaved { path: _, written: _, generation: _ }) =>
          ScmCandidateCaptured {
            repository_path: path,
            commit_ordinal: commit_ordinal,
            commit_root_locator: commit_root_locator,
          }
        RepositoryGuardedSaveOutcome(RepositorySaveRefusedByCodec { path: _, cause: _ }) =>
          ScmCaptureRefused {
            detail: "the capture was minted but the envelope could not be encoded for persistence; the in-memory commit is lost and the capture must be re-taken",
          }
        RepositoryGuardedSaveOutcome(RepositoryFileUnwritable { path: p, error }) =>
          ScmCaptureRefused {
            detail: join([
              "the capture was minted but the envelope could not be written to ", p,
              " (", error, "); the in-memory commit is lost and the capture must be re-taken",
            ], ""),
          }
        RepositoryGuardedSaveOutcome(RepositoryWriteByteCountUnrepresentable { path: _, reported }) =>
          ScmCaptureRefused {
            detail: join([
              "the envelope write reported a nonsensical byte count (",
              to_string(reported), "), so whether the capture persisted is unknown",
            ], ""),
          }
        RepositoryStaleGenerationRefused { path: _, expected: _, found: _ } =>
          ScmCaptureRefused {
            detail: "the project envelope changed on disk since this tick observed it; the in-memory capture is discarded and re-derived on the next tick rather than clobbering the newer envelope",
          }
        RepositoryGuardedSaveUnobservable { path: _, error } =>
          ScmCaptureRefused {
            detail: join(["the on-disk envelope generation could not be observed, so the capture refused to write unguarded: ", error], ""),
          }
      }
  }
}

// THE CAPTURE INTENT. The candidate capture is two durable writes around one git commit (the SCM envelope
// save, and the head-addressed capture record), so a kill between any two leaves a half: after the SCM save
// the rerun mints a SECOND commit (double capture); after the git commit the tree is clean, the decision sees
// nothing owed, and the capture record is never written (lost capture). The intent is written BEFORE the SCM
// save, carries the minted ordinal and root locator plus the pre-commit head, and lives beside the capture
// directory (not in it: the roster reads every file there as a capture of its own head). A rerun reads it:
// head still at the recorded base means the commit has not happened (resume: reuse the persisted SCM commit if
// the envelope already advanced past the intent's ordinal, else persist it); head moved means the commit
// happened and the capture record is owed (complete it at the new head). The intent is cleared after the
// capture record is written. This is part of the capture protocol, not a scaffold: it is the durable record
// that makes the three-step capture resumable.
type BeltCaptureIntent
  = IntentAbsent
  | IntentRead { capture: SubmissionCapture }
  | IntentUnreadable { reason: String }

type BeltIntentCompletion
  = IntentNothingOwed
  | IntentCompleted { head_sha: String }
  | IntentCompletionFailed { detail: String }

fn belt_capture_intent_dir(instance: HostDashboardInstance, node_id: RoadmapNodeId, attempt_key: String) -> String {
  join([belt_attempt_submission_dir_for_instance(instance: instance, node_id: node_id, attempt_key: attempt_key), "-intent"], "")
}

fn belt_capture_intent_path(instance: HostDashboardInstance, node_id: RoadmapNodeId, attempt_key: String) -> String {
  join([belt_capture_intent_dir(instance: instance, node_id: node_id, attempt_key: attempt_key), "/intent.json"], "")
}

fn belt_capture_intent_read(instance: HostDashboardInstance, worktree: String, node_id: RoadmapNodeId, attempt_key: String) -> BeltCaptureIntent {
  let dir = belt_capture_intent_dir(instance: instance, node_id: node_id, attempt_key: attempt_key)
  match belt_attempt_submission_dir_ensure(instance: instance, worktree: worktree, dir: dir) {
    ExecFailed { program, exit_code, stderr } =>
      IntentUnreadable { reason: belt_commit_exec_detail(step: "capture-intent-directory", outcome: ExecFailed { program: program, exit_code: exit_code, stderr: stderr }) }
    ExecRefused { program, reason } =>
      IntentUnreadable { reason: belt_commit_exec_detail(step: "capture-intent-directory", outcome: ExecRefused { program: program, reason: reason }) }
    ExecOk { stdout: _ } => {
      let listing = Filesystem.List(path: dir)
      if !listing.success {
        IntentUnreadable { reason: join(["the capture intent directory could not be listed: ", dir, " (", listing.error, ")"], "") }
      } else if !filesystem_listing_names_entry(listing: listing.entries, name: "intent.json") {
        IntentAbsent
      } else {
        let read = Filesystem.Read(path: belt_capture_intent_path(instance: instance, node_id: node_id, attempt_key: attempt_key))
        match filesystem_read_outcome(content: read.content, success: read.success, error: read.error) {
          FilesystemReadRefused { error } => IntentUnreadable { reason: join(["the capture intent was listed and then could not be read: ", error], "") }
          FilesystemReadSucceeded { content } =>
            match submission_capture_decode(text: content) {
              CaptureNotDecodable { reason } => IntentUnreadable { reason: join(["the capture intent does not decode: ", reason], "") }
              CaptureDecoded { capture } => IntentRead { capture: capture }
            }
        }
      }
    }
  }
}

fn belt_capture_intent_write(instance: HostDashboardInstance, worktree: String, node_id: RoadmapNodeId, attempt_key: String, capture: SubmissionCapture) -> String? {
  let dir = belt_capture_intent_dir(instance: instance, node_id: node_id, attempt_key: attempt_key)
  match belt_exec(
    cmd: host_exec_argv(
      program: dispatch_capability_program(environment: instance.execution_environment, cap: AttemptStateDirectoryCapability),
      args: ["-d", "-m", "0700", dir],
    ),
    workdir: worktree,
  ) {
    ExecFailed { program: _, exit_code: _, stderr } => Present { value: join(["intent directory: ", stderr], "") }
    ExecRefused { program: _, reason } => Present { value: join(["intent directory refused: ", reason], "") }
    ExecOk { stdout: _ } => {
      let write = Filesystem.Write(
        path: belt_capture_intent_path(instance: instance, node_id: node_id, attempt_key: attempt_key),
        content: submission_capture_text(capture: capture),
      )
      if write.success { none } else { Present { value: write.error } }
    }
  }
}

fn belt_capture_intent_clear(instance: HostDashboardInstance, node_id: RoadmapNodeId, attempt_key: String) -> String? {
  let gone = Filesystem.Delete(path: belt_capture_intent_path(instance: instance, node_id: node_id, attempt_key: attempt_key))
  if gone.success { none } else { Present { value: gone.error } }
}

fn belt_capture_record_write(instance: HostDashboardInstance, node_id: RoadmapNodeId, attempt_key: String, head: String, intent: SubmissionCapture) -> String? {
  let write = Filesystem.Write(
    path: join([
      belt_attempt_submission_dir_for_instance(instance: instance, node_id: node_id, attempt_key: attempt_key),
      "/",
      submission_capture_basename(head_sha: head),
    ], ""),
    content: submission_capture_text(capture: SubmissionCapture {
      head_sha: head,
      scm_repository: intent.scm_repository,
      scm_commit_ordinal: intent.scm_commit_ordinal,
      scm_root_locator: intent.scm_root_locator,
      digest: intent.digest,
      submission: intent.submission,
      handin: intent.handin,
    }),
  )
  if write.success { none } else { Present { value: write.error } }
}

// A rerun's first move: if an intent names a base head the worktree has moved past, the git commit happened
// and the capture record is owed at the new head (or already written, then only the intent is stale).
fn belt_capture_intent_complete(instance: HostDashboardInstance, worktree: String, node_id: RoadmapNodeId, attempt_key: String) -> BeltIntentCompletion {
  match belt_capture_intent_read(instance: instance, worktree: worktree, node_id: node_id, attempt_key: attempt_key) {
    IntentAbsent => IntentNothingOwed
    IntentUnreadable { reason } => IntentCompletionFailed { detail: reason }
    IntentRead { capture } =>
      match belt_worktree_head_observe(instance: instance, worktree: worktree) {
        WorktreeHeadUnobserved { reason } =>
          IntentCompletionFailed { detail: join(["a capture intent is owed but the head could not be observed: ", reason], "") }
        WorktreeHeadObserved { revision } =>
          if (revision as String) == capture.head_sha {
            IntentNothingOwed
          } else {
            match belt_submission_capture_for_head(instance: instance, worktree: worktree, node_id: node_id, attempt_key: attempt_key, head_sha: revision as String) {
              CaptureUnreadable { reason } => IntentCompletionFailed { detail: reason }
              CaptureForHead { capture: _ } =>
                match belt_capture_intent_clear(instance: instance, node_id: node_id, attempt_key: attempt_key) {
                  Present { value: e } => IntentCompletionFailed { detail: join(["the capture is recorded but its intent could not be cleared: ", e], "") }
                  Absent => IntentNothingOwed
                }
              _ =>
                match belt_capture_record_write(instance: instance, node_id: node_id, attempt_key: attempt_key, head: revision as String, intent: capture) {
                  Present { value: e } => IntentCompletionFailed { detail: join(["the commit exists at ", revision as String, " but its capture record could not be written: ", e], "") }
                  Absent =>
                    match belt_capture_intent_clear(instance: instance, node_id: node_id, attempt_key: attempt_key) {
                      Present { value: e } => IntentCompletionFailed { detail: join(["the capture is recorded but its intent could not be cleared: ", e], "") }
                      Absent => IntentCompleted { head_sha: revision as String }
                    }
                }
            }
          }
      }
  }
}

// THE CANDIDATE CAPTURE SEQUENCE: head observe, mint (pure), intent, SCM save, git commit, head observe,
// capture record, clear intent. A rerun after a kill at any seam resumes from the intent
// (belt_capture_intent_complete for the post-commit half; here for the pre-commit half).
fn belt_commit_capture_candidate(
  instance: HostDashboardInstance,
  worktree: String,
  node_id: String,
  attempt_key: String,
  message: NonEmptyStr,
  submission: WorkerSubmission,
  digest: String,
  handin: String?,
) -> BeltCommitOutcome {
  let nid = node_id as RoadmapNodeId
  match belt_worktree_head_observe(instance: instance, worktree: worktree) {
    WorktreeHeadUnobserved { reason } =>
      CommitFailed { node_id: node_id, detail: join(["the pre-commit head could not be observed, so no capture intent can name its base: ", reason], "") }
    WorktreeHeadObserved { revision: base } =>
      match belt_capture_intent_read(instance: instance, worktree: worktree, node_id: nid, attempt_key: attempt_key) {
        IntentUnreadable { reason } => CommitFailed { node_id: node_id, detail: reason }
        IntentAbsent =>
          belt_capture_candidate_mint(instance: instance, worktree: worktree, node_id: node_id, attempt_key: attempt_key, message: message, submission: submission, digest: digest, handin: handin, base: base as String, prior: Absent)
        IntentRead { capture } =>
          belt_capture_candidate_mint(instance: instance, worktree: worktree, node_id: node_id, attempt_key: attempt_key, message: message, submission: submission, digest: digest, handin: handin, base: base as String, prior: Present { value: capture })
      }
  }
}

fn belt_capture_candidate_mint(
  instance: HostDashboardInstance,
  worktree: String,
  node_id: String,
  attempt_key: String,
  message: NonEmptyStr,
  submission: WorkerSubmission,
  digest: String,
  handin: String?,
  base: String,
  prior: SubmissionCapture?,
) -> BeltCommitOutcome {
  match belt_scm_capture_candidate_tree(
    instance: instance,
    worktree: worktree,
    node_id: node_id as RoadmapNodeId,
    attempt_key: attempt_key,
    message: message as String,
    committed_revision: none,
  ) {
    ScmCaptureMintRefused { detail } => CommitFailed { node_id: node_id, detail: detail }
    ScmCaptureMintPoisoned { detail } => CommitCapturePoisoned { node_id: node_id, detail: detail }
    ScmCandidateMinted { repository, generation, path, commit_ordinal, commit_root_locator } => {
      let minted = SubmissionCapture {
        head_sha: base,
        scm_repository: path,
        scm_commit_ordinal: commit_ordinal,
        scm_root_locator: SubmissionCaptureRootBound { locator: commit_root_locator },
        digest: digest,
        submission: submission,
        handin: handin,
      }
      let persisted_before = match prior {
        Present { value: p } => commit_ordinal > p.scm_commit_ordinal && p.head_sha == base
        Absent => false
      }
      if persisted_before {
        match prior {
          Present { value: p } => belt_capture_candidate_commit(instance: instance, worktree: worktree, node_id: node_id, attempt_key: attempt_key, message: message, intent: p)
          Absent => CommitFailed { node_id: node_id, detail: "unreachable: a persisted capture without an intent" }
        }
      } else {
        match belt_capture_intent_write(instance: instance, worktree: worktree, node_id: node_id as RoadmapNodeId, attempt_key: attempt_key, capture: minted) {
          Present { value: e } =>
            CommitFailed { node_id: node_id, detail: join(["the capture intent could not be written, so the SCM capture was not taken: ", e], "") }
          Absent =>
            match belt_scm_persist_capture(mint: ScmCandidateMinted {
              repository: repository,
              generation: generation,
              path: path,
              commit_ordinal: commit_ordinal,
              commit_root_locator: commit_root_locator,
            }) {
              ScmCaptureRefused { detail } => CommitFailed { node_id: node_id, detail: detail }
              ScmCapturePoisoned { detail } => CommitCapturePoisoned { node_id: node_id, detail: detail }
              ScmCandidateCaptured { repository_path: _, commit_ordinal: _, commit_root_locator: _ } =>
                belt_capture_candidate_commit(instance: instance, worktree: worktree, node_id: node_id, attempt_key: attempt_key, message: message, intent: minted)
            }
        }
      }
    }
  }
}

fn belt_capture_candidate_commit(
  instance: HostDashboardInstance,
  worktree: String,
  node_id: String,
  attempt_key: String,
  message: NonEmptyStr,
  intent: SubmissionCapture,
) -> BeltCommitOutcome {
  match belt_commit_staged(instance: instance, worktree: worktree, message: message) {
    StagedCommitFailed { detail } => CommitFailed { node_id: node_id, detail: detail }
    StagedCommitRecorded =>
      match belt_worktree_head_observe(instance: instance, worktree: worktree) {
        WorktreeHeadUnobserved { reason } =>
          CommitFailed {
            node_id: node_id,
            detail: join([
              "the candidate commit was created but its head could not be observed; the capture intent is kept and the next pass completes it: ",
              reason,
            ], ""),
          }
        WorktreeHeadObserved { revision } =>
          match belt_capture_record_write(instance: instance, node_id: node_id as RoadmapNodeId, attempt_key: attempt_key, head: revision as String, intent: intent) {
            Present { value: e } =>
              CommitFailed {
                node_id: node_id,
                detail: join([
                  "the candidate commit ", revision as String,
                  " was created but its capture record could not be written (", e,
                  "); the capture intent is kept and the next pass completes it",
                ], ""),
              }
            Absent =>
              match belt_capture_intent_clear(instance: instance, node_id: node_id as RoadmapNodeId, attempt_key: attempt_key) {
                Present { value: e } =>
                  CommitFailed { node_id: node_id, detail: join(["the capture is recorded but its intent could not be cleared: ", e], "") }
                Absent => CandidateCaptured { node_id: node_id, head_sha: revision as String, message: message as String }
              }
          }
      }
  }
}

// THE PER-ATTEMPT OUTCOME IS PERSISTED BEFORE IT IS RETURNED. The tick receipt collapses every
// attempt's detail into one pass sentence ("one or more attempt worktrees could not be committed"),
// so the failing attempt and its arm were computed and erased on every tick (measured 2026-09-21:
// a wedged pass described itself only through a debugger). This receipt is the durable record at
// attempt grain -- node, key, outcome, detail -- written as each attempt's judgment is reached, so
// even a pass that stalls on a later attempt leaves the earlier attempts' outcomes on disk.
type BeltCommitOutcomeReceipt {
  node_id: String
  attempt_key: String
  head_sha: String?
  outcome: String
  detail: String
}

// THE RECORD NAMES THE HEAD THE STEP LEFT THE WORKTREE AT -- the commit it recorded, or the clean head it
// skipped -- because a settlement is a fact about one head: the head-grain capture lookup reads it only
// for the head it was asked about (belt_commit_record_standing_of_text). An unobserved head is recorded
// as none, which settles nothing.
fn belt_commit_outcome_receipt(o: BeltCommitOutcome, attempt_key: String, settled_head: String?) -> BeltCommitOutcomeReceipt {
  match o {
    CommitRecorded { node_id, message } =>
      BeltCommitOutcomeReceipt { node_id: node_id, attempt_key: attempt_key, head_sha: settled_head, outcome: belt_commit_outcome_key(o: o), detail: message }
    CandidateCaptured { node_id, head_sha, message } =>
      BeltCommitOutcomeReceipt { node_id: node_id, attempt_key: attempt_key, head_sha: settled_head, outcome: belt_commit_outcome_key(o: o), detail: join([message, " at ", head_sha], "") }
    CommitSkipped { node_id, reason } =>
      BeltCommitOutcomeReceipt { node_id: node_id, attempt_key: attempt_key, head_sha: settled_head, outcome: belt_commit_outcome_key(o: o), detail: reason }
    CommitFailed { node_id, detail } =>
      BeltCommitOutcomeReceipt { node_id: node_id, attempt_key: attempt_key, head_sha: settled_head, outcome: belt_commit_outcome_key(o: o), detail: detail }
    CommitCapturePoisoned { node_id, detail } =>
      BeltCommitOutcomeReceipt { node_id: node_id, attempt_key: attempt_key, head_sha: settled_head, outcome: belt_commit_outcome_key(o: o), detail: detail }
    CommitDeferred { node_id, reason } =>
      BeltCommitOutcomeReceipt { node_id: node_id, attempt_key: attempt_key, head_sha: settled_head, outcome: belt_commit_outcome_key(o: o), detail: reason }
    CommitSubjectUnaddressable { node_id, reason } =>
      BeltCommitOutcomeReceipt { node_id: node_id, attempt_key: attempt_key, head_sha: settled_head, outcome: belt_commit_outcome_key(o: o), detail: reason }
  }
}

fn belt_commit_outcome_receipt_json(r: BeltCommitOutcomeReceipt) -> JsonValue {
  json_object(members: [
    json_kv(key: "schema", value: json_string(s: belt_commit_outcome_schema)),
    json_kv(key: "node_id", value: json_string(s: r.node_id)),
    json_kv(key: "attempt_key", value: json_string(s: r.attempt_key)),
    json_kv(key: "head_sha", value: match r.head_sha { Present { value: h } => json_string(s: h)  Absent => JsonNull }),
    json_kv(key: "outcome", value: json_string(s: r.outcome)),
    json_kv(key: "detail", value: json_string(s: r.detail)),
  ])
}

// THE PERSISTED OUTCOME'S NAME IS SPELLED ONCE, here, for the persist pass that writes it.
data belt_commit_outcome_last_basename: NonEmptyStr = "commit-outcome-last.json" as NonEmptyStr

// THE COMMIT STEP'S OUTCOME KINDS, spelled once. The persisted record carries an outcome's kind, never
// its payload, so the writer (belt_commit_outcome_receipt, belt_commit_outcome_json_value) and the
// reader (belt_commit_record_standing_of_text) meet at this one key table rather than each spelling
// the strings.
type BeltCommitOutcomeKind
  = CommitKindRecorded
  | CommitKindCandidateCaptured
  | CommitKindSkipped
  | CommitKindFailed
  | CommitKindCapturePoisoned
  | CommitKindDeferred
  | CommitKindSubjectUnaddressable

data belt_commit_outcome_kinds: List<BeltCommitOutcomeKind> = [
  CommitKindRecorded, CommitKindCandidateCaptured, CommitKindSkipped, CommitKindFailed,
  CommitKindCapturePoisoned, CommitKindDeferred, CommitKindSubjectUnaddressable,
]

fn belt_commit_outcome_kind(o: BeltCommitOutcome) -> BeltCommitOutcomeKind {
  match o {
    CommitRecorded { node_id: _, message: _ } => CommitKindRecorded
    CandidateCaptured { node_id: _, head_sha: _, message: _ } => CommitKindCandidateCaptured
    CommitSkipped { node_id: _, reason: _ } => CommitKindSkipped
    CommitFailed { node_id: _, detail: _ } => CommitKindFailed
    CommitCapturePoisoned { node_id: _, detail: _ } => CommitKindCapturePoisoned
    CommitDeferred { node_id: _, reason: _ } => CommitKindDeferred
    CommitSubjectUnaddressable { node_id: _, reason: _ } => CommitKindSubjectUnaddressable
  }
}

fn belt_commit_outcome_kind_key(k: BeltCommitOutcomeKind) -> String {
  match k {
    CommitKindRecorded => "recorded"
    CommitKindCandidateCaptured => "candidate-captured"
    CommitKindSkipped => "skipped"
    CommitKindFailed => "failed"
    CommitKindCapturePoisoned => "capture-poisoned"
    CommitKindDeferred => "deferred"
    CommitKindSubjectUnaddressable => "subject-unaddressable"
  }
}

fn belt_commit_outcome_key(o: BeltCommitOutcome) -> String {
  belt_commit_outcome_kind_key(k: belt_commit_outcome_kind(o: o))
}

fn belt_commit_outcome_kind_of_key(key: String) -> BeltCommitOutcomeKind? {
  (belt_commit_outcome_kinds |> filter(k => belt_commit_outcome_kind_key(k: k) == key)).first()
}

// WHAT EACH KIND MEANS FOR THE CAPTURE, decided on the kind itself: an outcome that decided -- a
// commit recorded, a candidate captured, nothing to commit -- settles it; a failed or deferred one
// leaves it owed, so the next event or discovery runs it again; a poisoned capture or an
// unaddressable subject is a refusal.
type BeltCommitCaptureDisposition
  = CommitSettlesCapture
  | CommitLeavesCaptureOwed
  | CommitRefusesCapture

fn belt_commit_outcome_kind_capture_disposition(k: BeltCommitOutcomeKind) -> BeltCommitCaptureDisposition {
  match k {
    CommitKindRecorded => CommitSettlesCapture
    CommitKindCandidateCaptured => CommitSettlesCapture
    CommitKindSkipped => CommitSettlesCapture
    CommitKindFailed => CommitLeavesCaptureOwed
    CommitKindDeferred => CommitLeavesCaptureOwed
    CommitKindCapturePoisoned => CommitRefusesCapture
    CommitKindSubjectUnaddressable => CommitRefusesCapture
  }
}

// WHETHER THE COMMIT STEP HAS SETTLED THIS HEAD'S CAPTURE, read from its own persisted outcome --
// the fact that separates "no capture because the worker yielded" from "no capture because nothing has
// captured it yet" (gunbc.roadmap.roadmap_submission SubmissionCaptureObservation). The kind's own
// disposition decides; a record this reader cannot decode refuses, and is read as neither settled nor
// owed.
type BeltCommitRecordStanding
  = CommitStepSettled
  | CommitStepOwed { reason: String }
  | CommitStepRefused { reason: String }

data belt_commit_outcome_schema: String = "roadmap-commit-outcome/v2"

// The record before it named its head. Read, never written: which head it settled is unknown.
data belt_commit_outcome_schema_v1: String = "roadmap-commit-outcome/v1"

fn belt_commit_record_member(doc: JsonValue, key: String) -> String? {
  match publication_receipt_member(doc: doc, key: key) {
    ReceiptMemberRead { value: v } => Present { value: v }
    ReceiptMemberUnreadable { reason: _ } => none
  }
}

// THE ONE DECODE OF THE COMMIT STEP'S RECORD for one attempt: its schema, subject and kind are checked here, once,
// and the record's head and detail come back with the kind. A record for another attempt is unexplained state and
// refuses; a v1 record predates the head binding. Read by the head-grain capture standing below and by the replay
// recording capture (gunbc.dispatch_replay_capture), which takes the settled head as the attempt's result commit.
type BeltCommitRecordDecode
  = CommitRecordDecoded { kind: BeltCommitOutcomeKind, outcome: String, head_sha: String?, detail: String }
  | CommitRecordPredatesHead
  | CommitRecordRefused { reason: String }

fn belt_commit_record_decode(content: String, node_id: String, attempt_key: String) -> BeltCommitRecordDecode {
  match parse_json_document(s: content) {
    JsonDocumentUnreadable { gap } =>
      CommitRecordRefused { reason: join(["the commit step's record is ", json_document_gap_text(gap: gap)], "") }
    JsonDocumentParsed { value: doc } =>
      match belt_commit_record_member(doc: doc, key: "schema") {
        Absent => CommitRecordRefused { reason: "the commit step's record names no schema" }
        Present { value: schema } =>
          if schema == belt_commit_outcome_schema_v1 {
            CommitRecordPredatesHead
          } else if schema != belt_commit_outcome_schema {
            CommitRecordRefused { reason: join(["the commit step's record is ", schema, ", not ", belt_commit_outcome_schema], "") }
          } else if belt_commit_record_member(doc: doc, key: "node_id") != Present { value: node_id }
            || belt_commit_record_member(doc: doc, key: "attempt_key") != Present { value: attempt_key } {
            CommitRecordRefused { reason: join(["the commit step's record at attempt ", attempt_key, "'s address names another subject, which is unexplained state"], "") }
          } else {
            match belt_commit_record_member(doc: doc, key: "outcome") {
              Absent => CommitRecordRefused { reason: "the commit step's record names no outcome" }
              Present { value: outcome } =>
                match belt_commit_outcome_kind_of_key(key: outcome) {
                  Absent => CommitRecordRefused { reason: join(["the commit step's record names outcome ", outcome, ", which the commit step does not write"], "") }
                  Present { value: kind } =>
                    CommitRecordDecoded {
                      kind: kind,
                      outcome: outcome,
                      head_sha: belt_commit_record_member(doc: doc, key: "head_sha"),
                      detail: match belt_commit_record_member(doc: doc, key: "detail") { Present { value: d } => d  Absent => "" },
                    }
                }
            }
          }
      }
  }
}

// THE RECORD SETTLES ONLY THE SUBJECT AND HEAD IT NAMES. A record at another head, with no head, or from before the
// record named its head settles nothing here, so the capture of this head is owed; at this head, the kind's
// disposition decides.
fn belt_commit_record_standing_of_text(content: String, node_id: String, attempt_key: String, head_sha: String) -> BeltCommitRecordStanding {
  match belt_commit_record_decode(content: content, node_id: node_id, attempt_key: attempt_key) {
    CommitRecordRefused { reason } => CommitStepRefused { reason: reason }
    CommitRecordPredatesHead =>
      CommitStepOwed { reason: "the commit step's record predates its head binding, so which head it settled is unknown" }
    CommitRecordDecoded { kind, outcome, head_sha: settled_head, detail } =>
      match settled_head {
        Absent => CommitStepOwed { reason: join(["the commit step's last run ended ", outcome, " at a head it could not observe"], "") }
        Present { value: settled } =>
          if settled != head_sha {
            CommitStepOwed { reason: join(["the commit step last ran at ", settled, ", not at this head"], "") }
          } else {
            let said = join(["the commit step's last run at this head ended ", outcome, ": ", detail], "")
            match belt_commit_outcome_kind_capture_disposition(k: kind) {
              CommitSettlesCapture => CommitStepSettled
              CommitLeavesCaptureOwed => CommitStepOwed { reason: said }
              CommitRefusesCapture => CommitStepRefused { reason: said }
            }
          }
      }
  }
}

// NO CAPTURE AT THIS HEAD: settled, owed or refused, as the commit step's own record for this head says. The record is
// observed listing-first, so an unlistable directory is never read as a missing record.
fn belt_capture_absence_for_attempt(instance: HostDashboardInstance, node_id: RoadmapNodeId, attempt_key: String, head_sha: String) -> SubmissionCaptureObservation {
  let path = join([
    dispatch_attempt_state_path_for_instance(instance: instance, node_id: node_id, attempt_key: attempt_key),
    "/", belt_commit_outcome_last_basename as String,
  ], "")
  match filesystem_file_observation_of_path(path: path) {
    FilesystemFileAbsent(_) => CaptureNotAttempted { reason: "the belt's commit step has not run for this attempt" }
    FilesystemFileRead { path: _, content } =>
      match belt_commit_record_standing_of_text(content: content, node_id: node_id as String, attempt_key: attempt_key, head_sha: head_sha) {
        CommitStepSettled => CaptureAbsent
        CommitStepOwed { reason } => CaptureNotAttempted { reason: reason }
        CommitStepRefused { reason } => CaptureUnreadable { reason: reason }
      }
    FilesystemFileIndeterminate { cause } => CaptureUnreadable { reason: join(["whether the commit step has run is unknown: ", cause], "") }
    FilesystemFileObservationsDisagree { path: _, cause } => CaptureUnreadable { reason: join(["whether the commit step has run is unknown: ", cause], "") }
    FilesystemFileSubjectRefused { directory: _, name: _, cause } => CaptureUnreadable { reason: join(["whether the commit step has run is unknown: ", cause], "") }
  }
}

fn belt_commit_outcome_persist(
  instance: HostDashboardInstance,
  node_id: String,
  attempt_key: String,
  outcome: BeltCommitOutcome,
) -> BeltCommitOutcome {
  if trim(attempt_key) == "" {
    outcome
  } else {
    let write = Filesystem.Write(
      path: join([
        dispatch_attempt_state_path_for_instance(
          instance: instance,
          node_id: node_id as gunbc.roadmap.roadmap_model.RoadmapNodeId,
          attempt_key: attempt_key,
        ),
        "/", belt_commit_outcome_last_basename as String,
      ], ""),
      content: serialize_json(v: belt_commit_outcome_receipt_json(
        r: belt_commit_outcome_receipt(
          o: outcome,
          attempt_key: attempt_key,
          settled_head: match belt_worktree_head_observe(
            instance: instance,
            worktree: dispatch_worktree_path_for_instance(instance: instance, node_id: node_id as gunbc.roadmap.roadmap_model.RoadmapNodeId, attempt_key: attempt_key),
          ) {
            WorktreeHeadObserved { revision } => Present { value: revision as String }
            WorktreeHeadUnobserved { reason: _ } => none
          },
        ),
      )),
    )
    if write.success {
      outcome
    } else {
      CommitFailed {
        node_id: node_id,
        detail: join([
          "the commit step's outcome record could not be written (", write.error,
          "): the step is unsettled at this head and the worktree release waits on it",
        ], ""),
      }
    }
  }
}

// THE PER-ATTEMPT METERING RECORD (gunbc.roadmap.roadmap_attempt_metering). Every attempt in the workflow
// ledger is entered in the metering attempt index and, once its worker is terminal, metered against
// its open roster -- a Provisional record, rewritten each tick so later reviewer and auditor rounds
// and late seat releases are folded in. An indexed attempt that has LEFT the ledger
// can no longer be spawned for, because every harness spawner iterates that ledger; it is sealed and
// metered against the seal, which is the only route to a Final record. The pass runs after review
// and audit, and its outcomes are the tick receipt's metering_pass.
fn belt_metering_for_attempt(
  instance: HostDashboardInstance,
  progress: WorkflowAttemptProgress,
) -> MeteringPersist {
  match metering_attempt_index_admit(instance: instance, node_id: progress.node_id, attempt_key: progress.attempt_key) {
    Present { value: e } => MeteringPersistRefused { cause: join(["the metering attempt index could not be written: ", e], "") }
    Absent =>
      if belt_attempt_worker_terminal(provider: progress.provider, evidence: progress.process) {
        metering_persist_for_attempt(instance: instance, node_id: progress.node_id as RoadmapNodeId, attempt_key: progress.attempt_key, departed: false)
      } else {
        MeteringNotDue
      }
  }
}

fn belt_metering_departed(
  instance: HostDashboardInstance,
  attempts: List<WorkflowAttemptProgress>,
) -> List<MeteringPersist> {
  match metering_attempt_index(instance: instance) {
    MeteredAttemptsRefused { cause } => [MeteringPersistRefused { cause: join(["the metering attempt index is unreadable: ", cause], "") }]
    MeteredAttemptsObserved { attempts: indexed } =>
      flat_map(indexed, a =>
        if any(attempts, p => p.node_id == a.node_id && p.attempt_key == a.attempt_key) {
          [] as List<MeteringPersist>
        } else {
          [metering_persist_for_attempt(instance: instance, node_id: a.node_id as RoadmapNodeId, attempt_key: a.attempt_key, departed: true)]
        })
  }
}

fn belt_metering_attempts_for_instance(
  instance: HostDashboardInstance,
) -> List<MeteringPersist> {
  match belt_workflow_attempts_observe_for_instance(instance: instance) {
    WorkflowAttemptsRefused { reason } =>
      [MeteringPersistRefused { cause: join(["the attempts ledger is unobservable, so no attempt can be metered or sealed: ", reason], "") }]
    WorkflowAttemptsObserved { attempts } =>
      concat(
        map(attempts, progress => belt_metering_for_attempt(instance: instance, progress: progress)),
        belt_metering_departed(instance: instance, attempts: attempts),
      )
  }
}

// A REFUSED METERING WRITE FAILS THE PASS, counted and named, so a lost record stops the line on the
// tick receipt rather than surfacing only as an absent record at the reader.
fn belt_metering_pass_outcome_from(outcomes: List<MeteringPersist>) -> BeltPassOutcome {
  let refused = outcomes |> flat_map(o => match o {
    MeteringPersistRefused { cause: c } => [c]
    MeteringPersisted { path: _, standing: _ } => [] as List<String>
    MeteringAlreadyFinal => [] as List<String>
    MeteringNotDue => [] as List<String>
  })
  match refused.first() {
    Absent => BeltPassRecorded
    Present { value: c } =>
      BeltPassFailed { reason: join([to_string(count(refused)), " metering record(s) refused; first: ", c], "") }
  }
}

fn belt_commit_attempt_for_instance(
  instance: HostDashboardInstance,
  progress: WorkflowAttemptProgress,
) -> BeltCommitOutcome {
  belt_commit_outcome_persist(
    instance: instance,
    node_id: progress.node_id,
    attempt_key: progress.attempt_key,
    outcome: belt_commit_attempt_compute_for_instance(instance: instance, progress: progress),
  )
}

fn belt_commit_attempt_compute_for_instance(
  instance: HostDashboardInstance,
  progress: WorkflowAttemptProgress,
) -> BeltCommitOutcome {
  let node_id = progress.node_id
  if trim(s: progress.attempt_key) == "" {
    CommitSubjectUnaddressable {
      node_id: node_id,
      reason: "the attempt carries no key, so no dispatch worktree path names it: the path is built as <root>/<node>-a<key> and an empty key addresses <root>/<node>-a, which cannot exist",
    }
  } else {
  let worktree = dispatch_worktree_path_for_instance(
    instance: instance,
    node_id: node_id,
    attempt_key: progress.attempt_key,
  )
  match belt_capture_intent_complete(instance: instance, worktree: worktree, node_id: node_id, attempt_key: progress.attempt_key) {
    IntentCompleted { head_sha } =>
      CandidateCaptured {
        node_id: node_id,
        head_sha: head_sha,
        message: belt_candidate_commit_message(node_id: node_id as String, attempt_key: progress.attempt_key) as String,
      }
    IntentCompletionFailed { detail } => CommitFailed { node_id: node_id, detail: detail }
    IntentNothingOwed => belt_commit_attempt_decide(instance: instance, progress: progress, worktree: worktree)
  }
  }
}

fn belt_commit_attempt_decide(
  instance: HostDashboardInstance,
  progress: WorkflowAttemptProgress,
  worktree: String,
) -> BeltCommitOutcome {
  let node_id = progress.node_id
  match belt_commit_git(instance: instance, worktree: worktree, args: shape_git_status_porcelain_nul_args()) {
    ExecFailed { program, exit_code, stderr } =>
      CommitFailed { node_id: node_id, detail: belt_commit_exec_detail(step: "status", outcome: ExecFailed { program: program, exit_code: exit_code, stderr: stderr }) }
    ExecRefused { program, reason } =>
      CommitFailed { node_id: node_id, detail: belt_commit_exec_detail(step: "status", outcome: ExecRefused { program: program, reason: reason }) }
    ExecOk { stdout } =>
      match belt_submission_observe(worktree: worktree) {
        BeltSubmissionUnobservable { reason } =>
          CommitFailed {
            node_id: node_id,
            detail: join([
              "the submission artifact could not be observed, so the belt cannot distinguish a candidate from a checkpoint and refuses to guess: ",
              reason,
            ], ""),
          }
        BeltSubmissionObserved { observation } =>
          match belt_submission_captures_observe(
            instance: instance,
            worktree: worktree,
            dir: belt_attempt_submission_dir_for_instance(
              instance: instance,
              node_id: node_id,
              attempt_key: progress.attempt_key,
            ),
          ) {
            CaptureRosterUnobservable { reason } =>
              CommitFailed {
                node_id: node_id,
                detail: join([
                  "the submission capture history could not be observed, so the belt cannot tell a fresh declaration from a re-swept one and refuses to guess: ",
                  reason,
                ], ""),
              }
            CaptureRosterObserved { captures } =>
              match belt_commit_decision(provider: progress.provider, node_id: node_id, attempt_key: progress.attempt_key, entries_nul: stdout, submission: observation, captures: captures) {
                CommitNotNeeded { reason } => CommitSkipped { node_id: node_id, reason: reason as String }
                CheckpointCommitNeeded { message, note } =>
                  match belt_commit_staged(instance: instance, worktree: worktree, message: message) {
                    StagedCommitRecorded =>
                      CommitRecorded { node_id: node_id, message: join([message as String, " (", note, ")"], "") }
                    StagedCommitFailed { detail } => CommitFailed { node_id: node_id, detail: detail }
                  }
                CandidateCommitNeeded { message, submission, digest, handin } =>
                  belt_commit_capture_candidate(
                    instance: instance,
                    worktree: worktree,
                    node_id: node_id,
                    attempt_key: progress.attempt_key,
                    message: message,
                    submission: submission,
                    digest: digest,
                    handin: handin,
                  )
              }
          }
      }
  }
}

fn belt_commit_outcome_json_value(o: BeltCommitOutcome) -> JsonValue {
  match o {
    CommitRecorded { node_id, message } =>
      json_object(members: [json_kv(key: "outcome", value: json_string(s: belt_commit_outcome_key(o: o))), json_kv(key: "node_id", value: json_string(s: node_id)), json_kv(key: "message", value: json_string(s: message))])
    CandidateCaptured { node_id, head_sha, message } =>
      json_object(members: [json_kv(key: "outcome", value: json_string(s: belt_commit_outcome_key(o: o))), json_kv(key: "node_id", value: json_string(s: node_id)), json_kv(key: "head_sha", value: json_string(s: head_sha)), json_kv(key: "message", value: json_string(s: message))])
    CommitSkipped { node_id, reason } =>
      json_object(members: [json_kv(key: "outcome", value: json_string(s: belt_commit_outcome_key(o: o))), json_kv(key: "node_id", value: json_string(s: node_id)), json_kv(key: "reason", value: json_string(s: reason))])
    CommitFailed { node_id, detail } =>
      json_object(members: [json_kv(key: "outcome", value: json_string(s: belt_commit_outcome_key(o: o))), json_kv(key: "node_id", value: json_string(s: node_id)), json_kv(key: "detail", value: json_string(s: detail))])
    CommitCapturePoisoned { node_id, detail } =>
      json_object(members: [json_kv(key: "outcome", value: json_string(s: belt_commit_outcome_key(o: o))), json_kv(key: "node_id", value: json_string(s: node_id)), json_kv(key: "detail", value: json_string(s: detail))])
    CommitDeferred { node_id, reason } =>
      json_object(members: [json_kv(key: "outcome", value: json_string(s: belt_commit_outcome_key(o: o))), json_kv(key: "node_id", value: json_string(s: node_id)), json_kv(key: "reason", value: json_string(s: reason))])
    CommitSubjectUnaddressable { node_id, reason } =>
      json_object(members: [json_kv(key: "outcome", value: json_string(s: belt_commit_outcome_key(o: o))), json_kv(key: "node_id", value: json_string(s: node_id)), json_kv(key: "reason", value: json_string(s: reason))])
  }
}

fn belt_commit_outcome_is_failure(o: BeltCommitOutcome) -> Bool {
  match o {
    CommitRecorded { node_id: _, message: _ } => false
    CandidateCaptured { node_id: _, head_sha: _, message: _ } => false
    CommitSkipped { node_id: _, reason: _ } => false
    CommitFailed { node_id: _, detail: _ } => true
    CommitCapturePoisoned { node_id: _, detail: _ } => false
    CommitDeferred { node_id: _, reason: _ } => false
    CommitSubjectUnaddressable { node_id: _, reason: _ } => false
  }
}

fn belt_commit_outcome_is_recorded(o: BeltCommitOutcome) -> Bool {
  match o {
    CommitRecorded { node_id: _, message: _ } => true
    CandidateCaptured { node_id: _, head_sha: _, message: _ } => true
    CommitSkipped { node_id: _, reason: _ } => false
    CommitFailed { node_id: _, detail: _ } => false
    CommitCapturePoisoned { node_id: _, detail: _ } => false
    CommitDeferred { node_id: _, reason: _ } => false
    CommitSubjectUnaddressable { node_id: _, reason: _ } => false
  }
}

// POISONED ATTEMPTS ARE SKIPS, NOT FAILURES (kept at declaration grain: the annotation channel
// admits no in-body comments): a durable capture refusal changes what the pass can report, never
// whether it failed. The pass defers honestly (nothing was committed for that attempt until its
// durable fact is repaired) and the tick result counts the poison separately — one bad attempt
// cannot hold the other attempts' verdict hostage, which is the failure the 2026-09-21 tick kept
// paying. A transient CommitFailed still fails the pass, beside any number of poisoned siblings.
fn belt_commit_pass_outcome_from(outcomes: List<BeltCommitOutcome>) -> BeltPassOutcome {
  let ledger_refusals = outcomes |> filter(o => match o {
    CommitDeferred { node_id: nid, reason: _ } => nid == ""
    CommitRecorded { node_id: _, message: _ } => false
    CandidateCaptured { node_id: _, head_sha: _, message: _ } => false
    CommitSkipped { node_id: _, reason: _ } => false
    CommitFailed { node_id: _, detail: _ } => false
    CommitCapturePoisoned { node_id: _, detail: _ } => false
    CommitSubjectUnaddressable { node_id: _, reason: _ } => false
  })
  let poison_count = count(outcomes |> filter(o => match o {
    CommitCapturePoisoned { node_id: _, detail: _ } => true
    CommitRecorded { node_id: _, message: _ } => false
    CandidateCaptured { node_id: _, head_sha: _, message: _ } => false
    CommitSkipped { node_id: _, reason: _ } => false
    CommitFailed { node_id: _, detail: _ } => false
    CommitDeferred { node_id: _, reason: _ } => false
    CommitSubjectUnaddressable { node_id: _, reason: _ } => false
  }))
  if count(ledger_refusals) > 0 {
    match ledger_refusals.first() {
      Present { value: CommitDeferred { node_id: _, reason: r } } => BeltPassRefused { reason: r }
      Present { value: _ } => BeltPassRefused { reason: "the attempts ledger is unobservable" }
      Absent => BeltPassRefused { reason: "the attempts ledger is unobservable" }
    }
  } else if any(outcomes, o => belt_commit_outcome_is_failure(o: o)) {
    BeltPassFailed { reason: "one or more attempt worktrees could not be committed" }
  } else if any(outcomes, o => belt_commit_outcome_is_recorded(o: o)) {
    BeltPassRecorded
  } else if poison_count > 0 {
    BeltPassDeferred {
      reason: join([
        "no attempt needed a commit on this tick; ",
        to_string(poison_count),
        " attempt(s) are capture-poisoned and held for repair (see their commit-outcome receipts)",
      ], ""),
    }
  } else {
    BeltPassDeferred { reason: "no attempt needed a commit on this tick" }
  }
}

type BeltVerifyOutcome
  = VerifyDeferred { node_id: String, reason: String }
  | VerifyRecorded {
      node_id: String,
      verdict_key: String,
      detail: String,
    }
  | VerifyWriteFailed { node_id: String, detail: String }
  | VerifyEvidenceUnreadable { node_id: String, detail: String }
  | VerifyRefused { node_id: String, cause: String }

// review 45271; the scope of this collapse is now deliberate. Reducing a read to `""` conflates
// absent with unreadable, safe only where BOTH branches take the same action. That holds for the
// PIN reads below — absent and unreadable identity both leave pin_recorded false, the gate refuses
// either way, nothing actuates — so the distinction changes the message, not the behaviour. It did
// NOT hold for the receipt-presence read, which gated whether to RUN the validation and OVERWRITE
// the evidence: absent means run, unreadable means stop, so the collapse let an I/O fault
// regenerate a verdict against a worktree that may have moved. That seam no longer uses this
// function; it reads with status preserved and decodes.
fn belt_read_or_empty(path: String) -> String {
  let read = Filesystem.Read(path: path)
  if read.success { trim(read.content) } else { "" }
}

type BeltValidationRun {
  executions: List<ValidationExecution>
  verdict: ValidationVerdict
}

// Roadmap verification produces a GitExactDiffWindow with a derived window_identity immediately
// before gunbc-claim validation. The belt observes target_generation via rev-parse and
// merge-base(head, target_generation) in the detached verification checkout, writes the receipt at
// verification/<head>.<window_identity>.diff-window.json, and binds GUNBC_DIFF_WINDOW_PATH only for
// validations that consume an affected-set window.
fn git_target_generation_observation_of(outcome: BeltExecOutcome) -> GitTargetGenerationObservation {
  match outcome {
    ExecOk { stdout } =>
      match git_object_id_from_untagged_hex(hex: trim(stdout)) {
        Absent =>
          GitTargetGenerationOutputMalformed { stdout: trim(stdout) }
        Present { value: generation } =>
          GitTargetGenerationObserved { generation: generation }
      }
    ExecFailed { program, exit_code, stderr } =>
      GitTargetGenerationExecutionFailed {
        program: program,
        exit_code: exit_code,
        stdout: "",
        stderr: stderr,
      }
    ExecRefused { program, reason } =>
      GitTargetGenerationProgramUnavailable { program: program, reason: reason }
  }
}

fn git_merge_base_observation_of(
  outcome: BeltExecOutcome,
  target: GitRef,
  target_generation: GitObjectId,
  head: GitObjectId,
) -> GitMergeBaseObservation {
  match outcome {
    ExecOk { stdout } =>
      match git_object_id_from_untagged_hex(hex: trim(stdout)) {
        Absent =>
          GitMergeBaseOutputMalformed { stdout: trim(stdout) }
        Present { value: base } =>
          GitMergeBaseObserved {
            target: target,
            target_generation: target_generation,
            base: base,
            head: head,
          }
      }
    ExecFailed { program, exit_code, stderr } =>
      GitMergeBaseExecutionFailed {
        program: program,
        exit_code: exit_code,
        stdout: "",
        stderr: stderr,
      }
    ExecRefused { program, reason } =>
      GitMergeBaseProgramUnavailable { program: program, reason: reason }
  }
}

fn belt_observe_target_generation(
  instance: HostDashboardInstance,
  worktree: String,
  target: GitRef,
) -> GitTargetGenerationObservation {
  git_target_generation_observation_of(
    outcome: belt_exec(
      cmd: host_exec_argv(
        program: dispatch_capability_program(
          environment: instance.execution_environment,
          cap: GitWorkspaceCapability,
        ),
        args: ["rev-parse", target as String],
      ),
      workdir: worktree,
    ),
  )
}

fn belt_observe_merge_base(
  instance: HostDashboardInstance,
  worktree: String,
  head_sha: String,
  target_generation_hex: String,
) -> BeltExecOutcome {
  belt_exec(
    cmd: host_exec_argv(
      program: dispatch_capability_program(
        environment: instance.execution_environment,
        cap: GitWorkspaceCapability,
      ),
      args: ["merge-base", head_sha, target_generation_hex],
    ),
    workdir: worktree,
  )
}

fn belt_prepare_diff_window_for_verification(
  instance: HostDashboardInstance,
  node_id: RoadmapNodeId,
  attempt_key: String,
  subject: VerificationSubject,
  worktree: String,
) -> GitDiffWindowPrepareOutcome {
  let head_sha = subject.head_sha as String
  let target = instance.dispatch_base_ref
  match git_object_id_from_untagged_hex(hex: head_sha) {
    Absent =>
      GitDiffWindowPrepareRefused {
        cause: ChangeWindowHeadObjectIdRefused { head_hex: head_sha },
      }
    Present { value: head } =>
      match belt_observe_target_generation(
        instance: instance,
        worktree: worktree,
        target: target,
      ) {
        GitTargetGenerationObserved { generation: target_generation } =>
          match git_merge_base_observation_of(
            outcome: belt_observe_merge_base(
              instance: instance,
              worktree: worktree,
              head_sha: head_sha,
              target_generation_hex: git_object_id_wire_hex(oid: target_generation) as String,
            ),
            target: target,
            target_generation: target_generation,
            head: head,
          ) {
            GitMergeBaseObserved {
              target: observed_target,
              target_generation: observed_generation,
              base: base,
              head: observed_head,
            } =>
              let window = git_exact_diff_window_for_verification(
                target: observed_target,
                target_generation: observed_generation,
                base: base,
                head: observed_head,
              )
              let identity_hex = git_diff_window_identity_hex(
                identity: window.window_identity,
              )
              let path = dispatch_attempt_diff_window_path_for_instance(
                instance: instance,
                node_id: node_id,
                attempt_key: attempt_key,
                head_sha: head_sha,
                window_identity_hex: identity_hex,
              )
              let write = Filesystem.Write(
                path: path,
                content: git_diff_window_json(window: window),
              )
              if write.success {
                GitDiffWindowPrepared { path: path, window: window }
              } else {
                GitDiffWindowPrepareRefused {
                  cause: ChangeWindowPersistenceRefused {
                    path: path,
                    cause: write.error,
                  },
                }
              }
            GitMergeBaseProgramUnavailable { program: program, reason: reason } =>
              GitDiffWindowPrepareRefused {
                cause: ChangeWindowMergeBaseRefused {
                  observation: GitMergeBaseProgramUnavailable { program: program, reason: reason },
                },
              }
            GitMergeBaseExecutionFailed { program: program, exit_code: exit_code, stdout: stdout, stderr: stderr } =>
              GitDiffWindowPrepareRefused {
                cause: ChangeWindowMergeBaseRefused {
                  observation: GitMergeBaseExecutionFailed {
                    program: program,
                    exit_code: exit_code,
                    stdout: stdout,
                    stderr: stderr,
                  },
                },
              }
            GitMergeBaseOutputMalformed { stdout: stdout } =>
              GitDiffWindowPrepareRefused {
                cause: ChangeWindowMergeBaseRefused {
                  observation: GitMergeBaseOutputMalformed { stdout: stdout },
                },
              }
          }
        GitTargetGenerationProgramUnavailable { program: program, reason: reason } =>
          GitDiffWindowPrepareRefused {
            cause: ChangeWindowTargetGenerationRefused {
              observation: GitTargetGenerationProgramUnavailable { program: program, reason: reason },
            },
          }
        GitTargetGenerationExecutionFailed { program: program, exit_code: exit_code, stdout: stdout, stderr: stderr } =>
          GitDiffWindowPrepareRefused {
            cause: ChangeWindowTargetGenerationRefused {
              observation: GitTargetGenerationExecutionFailed {
                program: program,
                exit_code: exit_code,
                stdout: stdout,
                stderr: stderr,
              },
            },
          }
        GitTargetGenerationOutputMalformed { stdout: stdout } =>
          GitDiffWindowPrepareRefused {
            cause: ChangeWindowTargetGenerationRefused {
              observation: GitTargetGenerationOutputMalformed { stdout: stdout },
            },
          }
      }
  }
}

fn belt_verification_subject_with_window(
  subject: VerificationSubject,
  window_identity: Fnv1a64Structural,
) -> VerificationSubject {
  VerificationSubject {
    node_identity: subject.node_identity,
    criteria_digest: subject.criteria_digest,
    attempt_key: subject.attempt_key,
    branch: subject.branch,
    head_sha: subject.head_sha,
    change_window_identity: window_identity,
  }
}

fn belt_exec_with_diff_window_env(
  instance: HostDashboardInstance,
  cmd: HostExecArgv,
  workdir: String,
  diff_window_path: String,
) -> BeltExecOutcome {
  belt_exec(
    cmd: host_exec_argv(
      program: dispatch_capability_program(
        environment: instance.execution_environment,
        cap: EnvironmentBindingCapability,
      ),
      args: concat(
        [git_diff_window_env_assignment(path: diff_window_path)],
        concat([cmd.program], cmd.args),
      ),
    ),
    workdir: workdir,
  )
}

fn belt_run_validation_operations(
  instance: HostDashboardInstance,
  subject: VerificationSubject,
  validations: List<ValidationOperation>,
  worktree: String,
  oracle_identity: ContentHash,
  diff_window_path: String?,
  source_roots: ClaimSourceRootLayout,
) -> BeltValidationRun {
  fold(
    validations,
    init: BeltValidationRun {
      executions: [],
      verdict: ValidationPassed {
        command: "",
        oracle_identity: oracle_identity,
      },
    },
    f: fn(acc, validation) {
      match acc.verdict {
        ValidationNotRun => acc
        ValidationFailed { command: _, exit_code: _, detail: _ } => acc
        ValidationRefused { cause: _ } => acc
        ValidationPassed { command: prior, oracle_identity: _ } =>
          match validation {
          GunbcClaimValidation { entry, function } =>
            belt_run_claim_through_compute(
              instance: instance,
              subject: subject,
              acc: acc,
              prior: prior,
              validation: validation,
              entry: entry,
              function: function,
              oracle_identity: oracle_identity,
              diff_window_path: diff_window_path,
            )
          _ =>
          match validation_operation_command(
            validation: validation,
            environment: instance.execution_environment,
            source_roots: source_roots,
          ) {
            Absent =>
              BeltValidationRun {
                executions: acc.executions,
                verdict: ValidationRefused { cause: ValidationCommandUnrealized },
              }
            Present { value: command } => {
              let wire = modeled_validation_command_wire(command: command)
              let exec_outcome = if validation_consumes_affected_set_window(
                validation: validation,
              ) {
                match diff_window_path {
                  Present { value: path } =>
                    if path == "" {
                      ExecRefused {
                        program: "gunbc-diff-window",
                        reason: "verification requires an affected-set diff window path but the prepared path is empty",
                      }
                    } else {
                      belt_exec_with_diff_window_env(
                        instance: instance,
                        cmd: host_exec_argv(
                          program: command.program as String,
                          args: command.args,
                        ),
                        workdir: worktree,
                        diff_window_path: path,
                      )
                    }
                  Absent =>
                    ExecRefused {
                      program: "gunbc-diff-window",
                      reason: "verification requires an affected-set diff window path but none was prepared",
                    }
                }
              } else {
                belt_exec(
                  cmd: host_exec_argv(
                    program: command.program as String,
                    args: command.args,
                  ),
                  workdir: worktree,
                )
              }
              match exec_outcome {
                ExecOk { stdout } =>
                  BeltValidationRun {
                    executions: acc.executions |> append(ValidationExecution {
                      validation: validation,
                      command: command,
                      exit_code: 0,
                      stdout: stdout,
                      stderr: "",
                      computation: none,
                    }),
                    verdict: ValidationPassed {
                      command: if prior == "" {
                        wire
                      } else {
                        join([prior, "; ", wire], "")
                      },
                      oracle_identity: oracle_identity,
                    },
                  }
                ExecFailed { program: _, exit_code, stderr } =>
                  BeltValidationRun {
                    executions: acc.executions |> append(ValidationExecution {
                      validation: validation,
                      command: command,
                      exit_code: exit_code,
                      stdout: "",
                      stderr: stderr,
                      computation: none,
                    }),
                    verdict: ValidationFailed {
                      command: wire,
                      exit_code: exit_code,
                      detail: stderr,
                    },
                  }
                ExecRefused { program, reason } =>
                  BeltValidationRun {
                    executions: acc.executions,
                    verdict: ValidationRefused {
                      cause: if program == "gunbc-diff-window" {
                        ValidationChangeWindowRefused {
                          cause: ChangeWindowPersistenceRefused {
                            path: "",
                            cause: reason,
                          },
                        }
                      } else {
                        ValidationCommandRefused {
                          program: program,
                          reason: reason,
                        }
                      },
                    },
                  }
              }
            }
          }
          }
      }
    },
  )
}

// A CLAIM VALIDATION IS SHARED COMPUTATION. It runs as the compute family's RunClaims over the
// verified head's exact tree (gunbc.compute.work_provider_local compute_provide): a capped unit, the
// head's own build shared with every other request for that tree, and the outcome filed under the
// materialization provider's derived key. The affected-set window the claim reads is a declared
// input of the run (its identity keys it, its path is bound into the unit), so two windows over one
// tree are two runs. The run is WET, as the host `--claim-run` it replaces was, so the ladder exempts
// it from being served from the store; what is shared is the build it executes.
//
// The receipt cites the computation: the derived request key, the outcome's identity, the exact
// tree the work ran on, and whether it attached or computed. A run whose citation cannot be built
// REFUSES -- it is never recorded as a compute execution without one, and never passes. A host-record loss is not a verdict
// about the work, but it is not a clean verification either, so it refuses rather than passing.
fn belt_run_claim_through_compute(
  instance: HostDashboardInstance,
  subject: VerificationSubject,
  acc: BeltValidationRun,
  prior: String,
  validation: ValidationOperation,
  entry: FilePath,
  function: NonEmptyStr,
  oracle_identity: ContentHash,
  diff_window_path: String?,
) -> BeltValidationRun {
  let window_path = match diff_window_path { Present { value: p } => p  Absent => "" }
  if window_path == "" {
    BeltValidationRun {
      executions: acc.executions,
      verdict: ValidationRefused {
        cause: ValidationChangeWindowRefused {
          cause: ChangeWindowPersistenceRefused {
            path: "",
            cause: "verification requires an affected-set diff window path but none was prepared",
          },
        },
      },
    }
  } else {
    let op = RunClaims {
      entry: entry,
      functions: function,
      hermetic: false,
      window: Present { value: ClaimDiffWindow { identity: subject.change_window_identity, path: window_path as FilePath } },
    }
    let command = ModeledValidationCommand {
      label: "gunbc-compute-claim" as NonEmptyStr,
      program: "claim_batch" as FilePath,
      args: ["--entry", entry as String, "--functions", function as String],
    }
    let wire = modeled_validation_command_wire(command: command)
    let result = compute_provide(instance: instance, owner: DispatchOwned { node_id: subject.node_identity as String, attempt_key: subject.attempt_key }, commit: subject.head_sha as String, op: op)
    let document = provide_result_document(r: result)
    let citation = match stored_outcome_subject_tree(document: document) {
      Present { value: tree } =>
        if tree == "" || provide_result_identity(r: result) == "" {
          none
        } else {
          Present { value: SharedComputationCitation {
            request_key: provide_result_identity(r: result) as NonEmptyStr,
            outcome_identity: provide_result_identity(r: result),
            subject_tree: tree as NonEmptyStr,
            origin: match result {
              ProvideAttached { identity: _, ending: _, document: _, host_record: _ } => ComputationAttached
              ProvideFresh { outcome: _, document: _, host_record: _ } => ComputationComputed
            },
          } }
        }
      Absent => none
    }
    let ending = provide_result_ending(r: result)
    let record = provide_result_host_record(r: result)
    let execution = ValidationExecution {
      validation: validation,
      command: command,
      exit_code: match work_ending_decode(word: ending) { Present { value: e } => match e { WorkEndedSucceeded => 0  WorkEndedFailed => 1  WorkEndedRefusedByInfrastructure => 1  WorkEndedCancelled => 1  WorkEndedOutputMismatch => 1 }  Absent => 1 },
      stdout: document,
      stderr: if host_record_was_written(h: record) { "" } else { host_record_wire(h: record) },
      computation: citation,
    }
    if match citation { Present { value: _ } => false  Absent => true } {
      BeltValidationRun {
        executions: acc.executions,
        verdict: ValidationRefused {
          cause: ValidationCommandRefused {
            program: "gunbc-compute",
            reason: join(["the claim ran as compute work but its shared computation could not be cited (no subject tree or identity in the outcome), so it neither passes nor fails: ", document], ""),
          },
        },
      }
    } else if !host_record_was_written(h: record) {
      BeltValidationRun {
        executions: acc.executions |> append(execution),
        verdict: ValidationRefused {
          cause: ValidationCommandRefused {
            program: "gunbc-compute",
            reason: join(["the claim run ended ", ending, " but its host record was not written: ", host_record_wire(h: record)], ""),
          },
        },
      }
    } else {
      match work_ending_decode(word: ending) {
        Present { value: e } =>
          match e {
            WorkEndedSucceeded =>
              BeltValidationRun {
                executions: acc.executions |> append(execution),
                verdict: ValidationPassed {
                  command: if prior == "" { wire } else { join([prior, "; ", wire], "") },
                  oracle_identity: oracle_identity,
                },
              }
            WorkEndedFailed =>
              BeltValidationRun {
                executions: acc.executions |> append(execution),
                verdict: ValidationFailed { command: wire, exit_code: 1, detail: document },
              }
            WorkEndedRefusedByInfrastructure =>
              BeltValidationRun {
                executions: acc.executions |> append(execution),
                verdict: ValidationRefused { cause: compute_refusal_cause(ending: e, document: document) },
              }
            WorkEndedCancelled =>
              BeltValidationRun {
                executions: acc.executions |> append(execution),
                verdict: ValidationRefused { cause: compute_refusal_cause(ending: e, document: document) },
              }
            WorkEndedOutputMismatch =>
              BeltValidationRun {
                executions: acc.executions |> append(execution),
                verdict: ValidationRefused { cause: compute_refusal_cause(ending: e, document: document) },
              }
          }
        Absent =>
          BeltValidationRun {
            executions: acc.executions |> append(execution),
            verdict: ValidationRefused {
              cause: ValidationCommandRefused { program: compute_refusal_program, reason: compute_refusal_reason(ending: ending, document: document) },
            },
          }
      }
    }
  }
}

// THE CAPTURE GATE OF THE VERIFY PASS, the twin of belt_integration_capture_gate and consuming the
// same classifier, so the two passes answer "is this capture a verification candidate" identically.
type BeltVerifyCaptureGate
  = VerifyCaptureAdvances { capture: SubmissionCapture }
  | VerifyCaptureStops { outcome: BeltVerifyOutcome }

fn belt_verify_capture_gate(node_id: String, capture: SubmissionCaptureObservation) -> BeltVerifyCaptureGate {
  match capture {
    CaptureUnreadable { reason } =>
      VerifyCaptureStops {
        outcome: VerifyRefused {
          node_id: node_id,
          cause: join([
            "whether this head is a captured candidate is unknown (",
            reason,
            "), and the belt does not verify a head it cannot bind to a submission",
          ], ""),
        },
      }
    CaptureAbsent =>
      VerifyCaptureStops {
        outcome: VerifyDeferred {
          node_id: node_id,
          reason: "no submission capture binds this head: the belt's commit over it was a checkpoint (yielded, not ready), and only a captured candidate advances to authoritative verification",
        },
      }
    CaptureNotAttempted { reason } =>
      VerifyCaptureStops {
        outcome: VerifyDeferred {
          node_id: node_id,
          reason: join(["no submission capture binds this head yet: ", reason, "; verification waits for the capture"], ""),
        },
      }
    CaptureForHead { capture: c } =>
      match submission_candidacy(submission: c.submission) {
        SubmissionNotCandidate { reason } =>
          VerifyCaptureStops { outcome: VerifyDeferred { node_id: node_id, reason: reason } }
        SubmissionIsCandidate => VerifyCaptureAdvances { capture: c }
      }
  }
}

// WHO ASKED FOR THIS VERIFICATION: the belt (a recorded verdict of any kind is final) or the operator
// resuming a refused one (a recorded REFUSED verdict runs again; any other stays).
type BeltVerifyMode = VerifyAsBelt | VerifyAsOperatorResume

fn belt_verify_attempt_for_instance(
  instance: HostDashboardInstance,
  progress: WorkflowAttemptProgress,
) -> BeltVerifyOutcome {
  belt_verify_attempt_in_mode(instance: instance, progress: progress, mode: VerifyAsBelt)
}

// THE BELT'S BOUNDED RETRY OF AN INFRASTRUCTURE-REFUSED VERIFICATION (ruling gunbc.design_ruling
// infrastructure_refusal_is_retried_to_a_bound). The refused verdict stays recorded as refused; what
// changes is that the belt, on its existing wake events, runs the stage again while the ledger beside
// the receipt has fewer than the bound's entries, writes one ledger entry per retry carrying its cause,
// and past the bound refuses with RetryExhausted instead of holding. A refusal about the candidate and
// every recorded verdict pass through unchanged, and the operator resume bypasses the ledger.
fn belt_verify_retry_dir(instance: HostDashboardInstance, node_id: RoadmapNodeId, attempt_key: String) -> String {
  dispatch_attempt_verification_dir_for_instance(instance: instance, node_id: node_id, attempt_key: attempt_key)
}

fn belt_verify_retry_ledger_count(instance: HostDashboardInstance, node_id: RoadmapNodeId, attempt_key: String, receipt_basename: String) -> Int? {
  let listing = Filesystem.List(path: belt_verify_retry_dir(instance: instance, node_id: node_id, attempt_key: attempt_key))
  if listing.success {
    Present { value: refused_retry_ledger_count(entries: listing.entries, receipt_basename: receipt_basename) }
  } else {
    none
  }
}

fn belt_verify_retry_basename(instance: HostDashboardInstance, node_id: RoadmapNodeId, attempt_key: String) -> String? {
  match belt_worktree_head_observe(instance: instance, worktree: dispatch_worktree_path_for_instance(instance: instance, node_id: node_id, attempt_key: attempt_key)) {
    WorktreeHeadUnobserved { reason: _ } => none
    WorktreeHeadObserved { revision } =>
      match belt_verification_selection_observe(instance: instance, node_id: node_id, attempt_key: attempt_key, head_sha: revision as String) {
        SelectionObserved { head, window_identity } =>
          Present { value: exact_verification_receipt_basename(head_sha: head as String, window_identity_hex: git_diff_window_identity_hex(identity: window_identity)) }
        SelectionUnaddressable { cause: _ } => none
        SelectionAbsent => none
        SelectionUnreadable { cause: _ } => none
        SelectionMalformed { cause: _ } => none
      }
  }
}

// THE REFUSED SEGMENT'S STANDING is read from the receipt's typed cause, not from the segment's detail text.
fn belt_verify_retry_standing_of_refused(instance: HostDashboardInstance, progress: WorkflowAttemptProgress) -> RefusedRetryStanding {
  let node_id = progress.node_id as gunbc.roadmap.roadmap_model.RoadmapNodeId
  match belt_verify_retry_basename(instance: instance, node_id: node_id, attempt_key: progress.attempt_key) {
    Absent => RefusedRetryOperatorOnly
    Present { value: basename } =>
      match belt_verification_refused_cause(source: exact_verification_receipt_source_read(
        attempt_dir: dispatch_attempt_state_path_for_instance(instance: instance, node_id: node_id, attempt_key: progress.attempt_key),
        verification_dir: belt_verify_retry_dir(instance: instance, node_id: node_id, attempt_key: progress.attempt_key),
        receipt_basename: basename,
      )) {
        Absent => RefusedRetryOperatorOnly
        Present { value: cause } =>
          match belt_verify_retry_ledger_count(instance: instance, node_id: node_id, attempt_key: progress.attempt_key, receipt_basename: basename) {
            Absent => RefusedRetryOperatorOnly
            Present { value: n } => refused_retry_standing(class: refusal_cause_class(cause: cause), retries_recorded: n)
          }
      }
  }
}

// WHERE THE ATTEMPT'S VERIFICATION STANDS against the bound, from the segment the belt already read and
// the ledger. Anything that cannot be established is OperatorOnly: no retry is fabricated.
fn belt_verify_retry_standing(instance: HostDashboardInstance, progress: WorkflowAttemptProgress) -> RefusedRetryStanding {
  match workflow_segment_of_kind(segments: progress.segments, kind: VerificationWorkflowSegment) {
    Absent => RefusedRetryOperatorOnly
    Present { value: seg } =>
      match seg.state {
        WorkflowSegmentRefused =>
          belt_verify_retry_standing_of_refused(instance: instance, progress: progress)
        WorkflowSegmentPending => RefusedRetryOperatorOnly
        WorkflowSegmentActive => RefusedRetryOperatorOnly
        WorkflowSegmentComplete => RefusedRetryOperatorOnly
        WorkflowSegmentFailed => RefusedRetryOperatorOnly
        WorkflowSegmentStopped => RefusedRetryOperatorOnly
      }
  }
}

fn belt_verify_retry_gate(
  instance: HostDashboardInstance,
  progress: WorkflowAttemptProgress,
  mode: BeltVerifyMode,
  receipt_basename: String,
  source: ExactVerificationReceiptSource,
  decision: BeltVerificationDecision,
) -> BeltVerificationDecision {
  match mode {
    VerifyAsOperatorResume => decision
    VerifyAsBelt =>
      match decision {
        BeltVerificationDefer { reason: _ } => {
          let node_id = progress.node_id as gunbc.roadmap.roadmap_model.RoadmapNodeId
          match belt_verify_retry_ledger_count(instance: instance, node_id: node_id, attempt_key: progress.attempt_key, receipt_basename: receipt_basename) {
            Absent => decision
            Present { value: n } =>
              match belt_verification_retry_verdict(decision: decision, source: source, retries_recorded: n) {
                RefusedRetryPassThrough => decision
                RefusedRetryStop { reason } => BeltVerificationRefuse { reason: reason }
                RefusedRetryRun { ordinal, cause } => {
                  let write = Filesystem.Write(
                    path: join([belt_verify_retry_dir(instance: instance, node_id: node_id, attempt_key: progress.attempt_key), "/", refused_retry_ledger_entry_name(receipt_basename: receipt_basename, ordinal: ordinal)], ""),
                    content: serialize_json(v: json_object(members: [
                      json_kv(key: "schema", value: json_string(s: "roadmap-refused-retry/v1")),
                      json_kv(key: "ordinal", value: json_int(n: ordinal)),
                      json_kv(key: "bound", value: json_int(n: refused_retry_bound)),
                      json_kv(key: "cause", value: json_string(s: cause)),
                    ])),
                  )
                  if write.success {
                    BeltVerificationRun
                  } else {
                    BeltVerificationEvidenceUnreadable { reason: join(["the refused-retry ledger entry could not be written, so the retry is not made unrecorded: ", write.error], "") }
                  }
                }
              }
          }
        }
        BeltVerificationRun => decision
        BeltVerificationRefuse { reason: _ } => decision
        BeltVerificationEvidenceUnreadable { reason: _ } => decision
      }
  }
}

fn belt_verification_decision_in_mode(mode: BeltVerifyMode, expected: VerificationSubject, source: ExactVerificationReceiptSource) -> BeltVerificationDecision {
  match mode {
    VerifyAsBelt => belt_verification_decision(expected: expected, source: source)
    VerifyAsOperatorResume => belt_verification_resume_decision(expected: expected, source: source)
  }
}

fn belt_verify_mode_is_resume(mode: BeltVerifyMode) -> Bool {
  match mode {
    VerifyAsBelt => false
    VerifyAsOperatorResume => true
  }
}

// THE TERMINALITY PRECONDITION, decided where the evidence is known. A live-ready provider runs as
// always. An attempt the provider ledger cannot show terminal (a legacy attempt with no events file) may
// run ONLY when a verification receipt for the same attempt and head (any window) stands in for it; any other run decision is deferred
// with the unchanged reason, so a live worker is never verified.
fn belt_verify_terminality_guard(provider_ready: Bool, evidence: AttemptTerminalityEvidence, decision: BeltVerificationDecision) -> BeltVerificationDecision {
  match decision {
    BeltVerificationRun =>
      if provider_ready {
        BeltVerificationRun
      } else {
        match evidence {
          AttemptTerminalityEstablished => BeltVerificationRun
          AttemptTerminalityNotEstablished =>
            BeltVerificationDefer { reason: "the agent obligation is not satisfied: the agent has not reached a terminal state, so there is nothing to verify yet" }
          AttemptTerminalityEvidenceUnreadable { detail } =>
            BeltVerificationEvidenceUnreadable { reason: concat("terminality evidence for this head is unreadable: ", detail) }
        }
      }
    BeltVerificationDefer { reason: _ } => decision
    BeltVerificationRefuse { reason: _ } => decision
    BeltVerificationEvidenceUnreadable { reason: _ } => decision
  }
}

fn belt_verify_attempt_in_mode(
  instance: HostDashboardInstance,
  progress: WorkflowAttemptProgress,
  mode: BeltVerifyMode,
) -> BeltVerifyOutcome {
  let node_id = progress.node_id as gunbc.roadmap.roadmap_model.RoadmapNodeId
  let provider_ready = belt_provider_candidate_ready(provider: progress.provider)
  if provider_ready || belt_verify_mode_is_resume(mode: mode) {
      match belt_lookup_node(node_id: progress.node_id) {
        AuthorityProjectionRefused { detail: detail } =>
          VerifyDeferred {
            node_id: progress.node_id,
            reason: concat("roadmap authority projection refused: ", detail),
          }
        NodeMissing =>
          VerifyDeferred {
            node_id: progress.node_id,
            reason: "the roadmap authority declares no node with this id, so there is no contract to verify against",
          }
        NodeFound { node } => {
          let branch = dispatch_branch_name(
            node_id: node_id,
            attempt_key: progress.attempt_key,
          )
          if trim(branch) == "" {
            VerifyDeferred {
              node_id: progress.node_id,
              reason: "the attempt has no branch name, so there is no verification subject to construct",
            }
          } else {
            let attempt_worktree = dispatch_worktree_path_for_instance(
              instance: instance,
              node_id: node_id,
              attempt_key: progress.attempt_key,
            )
            match belt_worktree_head_observe(
              instance: instance,
              worktree: attempt_worktree,
            ) {
              WorktreeHeadUnobserved { reason } =>
                VerifyDeferred { node_id: progress.node_id, reason: reason }
              WorktreeHeadObserved { revision: revision } =>
              match belt_verify_capture_gate(
                node_id: progress.node_id,
                capture: belt_submission_capture_for_head(
                  instance: instance,
                  worktree: attempt_worktree,
                  node_id: node_id, attempt_key: progress.attempt_key,
                  head_sha: revision as String,
                ),
              ) {
                VerifyCaptureStops { outcome } => outcome
                VerifyCaptureAdvances { capture: _ } => {
                let head_sha = revision as String
                let worktree = belt_verify_detached_worktree(
                  instance: instance,
                  node_id: node_id,
                  attempt_key: progress.attempt_key,
                  head_sha: head_sha,
                )
                match node_criteria_digest(rn: node) {
                  Absent =>
                    VerifyDeferred {
                      node_id: progress.node_id,
                      reason: "this roadmap node has no criteria digest, so the verification subject cannot be constructed",
                    }
                  Present { value: criteria_digest } => {
                    let partial_subject = VerificationSubject {
                      node_identity: node.identity,
                      criteria_digest: criteria_digest,
                      attempt_key: progress.attempt_key,
                      branch: branch as NonEmptyStr,
                      head_sha: revision as CommitSha,
                      change_window_identity: git_diff_window_absent_identity(),
                    }
                    let prepared_window = if worktree != ""
                      && execution_contract_needs_diff_window(contract: node.execution) {
                      Present {
                        value: belt_prepare_diff_window_for_verification(
                          instance: instance,
                          node_id: node_id,
                          attempt_key: progress.attempt_key,
                          subject: partial_subject,
                          worktree: worktree,
                        ),
                      }
                    } else {
                      none
                    }
                    let subject = match prepared_window {
                      Present { value: GitDiffWindowPrepared { path: _, window: window } } =>
                        belt_verification_subject_with_window(
                          subject: partial_subject,
                          window_identity: window.window_identity,
                        )
                      Present { value: GitDiffWindowPrepareRefused { cause: _ } } =>
                        partial_subject
                      Absent => partial_subject
                    }
                    let identity_hex = git_diff_window_identity_hex(
                      identity: subject.change_window_identity,
                    )
                    let address = exact_verification_address_for(
                      attempt_dir: dispatch_attempt_state_path_for_instance(
                        instance: instance,
                        node_id: node_id,
                        attempt_key: progress.attempt_key,
                      ),
                      verification_dir: dispatch_attempt_verification_dir_for_instance(
                        instance: instance,
                        node_id: node_id,
                        attempt_key: progress.attempt_key,
                      ),
                      head_sha: head_sha,
                      window_identity_hex: identity_hex,
                    )
                    match belt_publish_current_verification_selection(
                      instance: instance,
                      node_id: node_id,
                      attempt_key: progress.attempt_key,
                      subject: subject,
                    ) {
                      VerificationSelectionPublishRefused { path: _, cause } =>
                        VerifyRefused {
                          node_id: progress.node_id,
                          cause: join([
                            "verification refused before running because the current selection could not be published: ",
                            cause,
                          ], ""),
                        }
                      VerificationSelectionPublished { path: _ } => {
                        let exact_source = exact_verification_receipt_source_read(
                          attempt_dir: address.attempt_dir,
                          verification_dir: address.verification_dir,
                          receipt_basename: address.receipt_basename,
                        )
                        match belt_verify_retry_gate(
                          instance: instance,
                          progress: progress,
                          mode: mode,
                          receipt_basename: address.receipt_basename,
                          source: exact_source,
                          decision: belt_verify_terminality_guard(
                            provider_ready: provider_ready,
                            evidence: belt_attempt_terminality_evidence(
                              expected: subject,
                              source: attempt_head_receipts_read(
                                attempt_dir: address.attempt_dir,
                                verification_dir: address.verification_dir,
                                head_sha: head_sha,
                              ),
                            ),
                            decision: belt_verification_decision_in_mode(
                              mode: mode,
                              expected: subject,
                              source: exact_source,
                            ),
                          ),
                        ) {
                          BeltVerificationEvidenceUnreadable { reason } =>
                            VerifyEvidenceUnreadable {
                              node_id: progress.node_id,
                              detail: reason,
                            }
                          BeltVerificationRefuse { reason } =>
                            VerifyRefused {
                              node_id: progress.node_id,
                              cause: reason,
                            }
                          BeltVerificationDefer { reason } =>
                            VerifyDeferred {
                              node_id: progress.node_id,
                              reason: reason,
                            }
                          BeltVerificationRun =>
                            belt_verify_run_and_persist(
                              instance: instance,
                              node: node,
                              progress: progress,
                              subject: subject,
                              diff_window_path: if execution_contract_needs_diff_window(
                                contract: node.execution,
                              ) {
                                Present {
                                  value: dispatch_attempt_diff_window_path_for_instance(
                                    instance: instance,
                                    node_id: node_id,
                                    attempt_key: progress.attempt_key,
                                    head_sha: head_sha,
                                    window_identity_hex: identity_hex,
                                  ),
                                }
                              } else {
                                none
                              },
                              change_window_refusal: match prepared_window {
                                Present {
                                  value: GitDiffWindowPrepareRefused { cause: cause },
                                } =>
                                  Present { value: cause }
                                Present { value: GitDiffWindowPrepared { path: _, window: _ } } => none
                                Absent => none
                              },
                            )
                        }
                      }
                    }
                  }
                }
              }
              }
            }
          }
        }
      }
  } else {
    VerifyDeferred {
      node_id: progress.node_id,
      reason: "the agent obligation is not satisfied: the agent has not reached a terminal state, so there is nothing to verify yet",
    }
  }
}

// A TERMINAL WORKER IS VERIFIED WHETHER IT FINISHED, FAILED, OR SPENT ITS BUDGET. Two belt-dispatched
// attempts exhausted their round budget with partial work in the worktree (then reported as
// turn.failed, now as turn.budget_exhausted); gating verification
// on ProviderCompleted alone left that work unjudged. The verdict is the judge of partial work, and
// publication is gated on the verdict, so verifying a failed provider's head is strictly more honest
// than skipping it. Only a running or not-yet-started worker has nothing to verify.
// THE WORKER-PROCESS TERMINAL READ (2026-09-29, the continuation-hold gap): the provider's own
// ledger can miss a terminal event entirely — the slot-population attempt's worker exited on a
// placement refusal without writing one, and the lineage read the lineage as live forever. The
// process evidence is the second authority the progress record already carries: a recorded exit
// settles the lineage even when the provider's events never said so. Unobserved stays
// non-terminal (fail-closed), exactly as an absent pane.
// THE UNRECOVERABLE READ (2026-09-29): a worker whose provider ledger is unreadable AND whose
// process is gone can never progress — nothing more will arrive and nothing is running — so the
// lineage must settle for a fresh attempt to start (the slot-population attempt read exactly this:
// events_refused from a provider that exited on a placement refusal, process absent after the pane
// reaped). EITHER channel still running keeps the lineage live; the combination is terminal.
fn belt_attempt_unrecoverable(provider: ProviderExecutionState, evidence: WorkerProcessEvidence) -> Bool {
  match provider {
    ProviderEventsRefused { activity: _, detail: _ } =>
      match evidence {
        WorkerProcessAbsent => true
        WorkerProcessUnobserved { reason: _ } => false
        WorkerProcessRunning { command: _ } => false
        WorkerProcessExited { exit_code: _, last_command: _ } => false
        WorkerProcessSignaled { signal: _, last_command: _ } => false
      }
    ProviderNotStarted => false
    ProviderStarting { activity: _ } => false
    ProviderAwaitingSeat { detail: _ } => false
    ProviderAwaitingAcceptance { handin: _ } => false
    ProviderRunning { activity: _ } => false
    ProviderCompleted { activity: _ } => false
    ProviderFailed { activity: _, detail: _ } => false
    ProviderBudgetSpent { activity: _, detail: _ } => false
    // A PENDING REQUEST IS RECOVERABLE, not unrecoverable: the worker exited cleanly from its own
    // patient-request path and the belt intends to re-deliver it. It is never a dead-process +
    // unreadable-ledger pair, and must not be sealed as if it were.
    ProviderRequestPending { activity: _, detail: _ } => false
  }
}

// THE TERMINAL READ OVER BOTH CHANNELS: the provider's own terminal event, a recorded process
// exit, or the unrecoverable combination (dead process + unreadable ledger). Fail-closed still:
// an unobserved process or a live pane never settles a lineage by inference. THE PROVIDER TERMINAL
// READ IS belt_provider_terminal (gunbc.roadmap.roadmap_belt_obligation) -- the ONE derivation, read
// here AND by the capture-owed gate, so "the worker has ended" is never decided twice (DESIGN 6b).
// It counts a request-pending worker as ended: the process exited and the belt owes it a capture.
fn belt_attempt_worker_terminal(provider: ProviderExecutionState, evidence: WorkerProcessEvidence) -> Bool {
  belt_provider_terminal(provider: provider)
    || belt_worker_process_terminal(evidence: evidence)
    || belt_attempt_unrecoverable(provider: provider, evidence: evidence)
}

fn belt_worker_process_terminal(evidence: WorkerProcessEvidence) -> Bool {
  match evidence {
    WorkerProcessExited { exit_code: _, last_command: _ } => true
    WorkerProcessSignaled { signal: _, last_command: _ } => true
    WorkerProcessRunning { command: _ } => false
    WorkerProcessAbsent => false
    WorkerProcessUnobserved { reason: _ } => false
  }
}

fn belt_verify_run_and_persist(
  instance: HostDashboardInstance,
  node: RoadmapNode,
  progress: WorkflowAttemptProgress,
  subject: VerificationSubject,
  diff_window_path: String?,
  change_window_refusal: ChangeWindowPreparationRefusal?,
) -> BeltVerifyOutcome {
  let node_id = progress.node_id as gunbc.roadmap.roadmap_model.RoadmapNodeId
  let identity_hex = git_diff_window_identity_hex(
    identity: subject.change_window_identity,
  )
  let receipt_path = dispatch_attempt_verification_receipt_path_for_instance(
    instance: instance,
    node_id: node_id,
    attempt_key: progress.attempt_key,
    head_sha: subject.head_sha as String,
    window_identity_hex: identity_hex,
  )
  let worktree = belt_verify_detached_worktree(
    instance: instance,
    node_id: node_id,
    attempt_key: progress.attempt_key,
    head_sha: subject.head_sha as String,
  )
  let pinned_identity_wire = belt_read_or_empty(
    path: dispatch_current_attempt_oracle_identity_path_for_instance(
      instance: instance,
      node_id: node_id,
    ),
  )
  let pinned_revision_wire = belt_read_or_empty(
    path: dispatch_current_attempt_oracle_revision_path_for_instance(
      instance: instance,
      node_id: node_id,
    ),
  )
  let pinned_identity = validation_oracle_parse_pinned_identity_wire(
    text: pinned_identity_wire,
  )
  let pinned_revision = validation_oracle_parse_pinned_revision_wire(
    text: pinned_revision_wire,
  )
  let pin_refusal = belt_read_or_empty(
    path: dispatch_current_attempt_oracle_pin_refusal_path_for_instance(
      instance: instance,
      node_id: node_id,
    ),
  )
  let pin_recorded = validation_oracle_pin_recorded(
    identity: pinned_identity,
    revision: pinned_revision,
  )
  if worktree == "" {
    let run = BeltValidationRun {
      executions: [],
      verdict: ValidationRefused {
        cause: ValidationCommandRefused {
          program: "git",
          reason: belt_verify_detached_worktree_refusal(
            instance: instance,
            node_id: node_id,
            attempt_key: progress.attempt_key,
            head_sha: subject.head_sha as String,
          ),
        },
      },
    }
    let receipt = VerificationReceipt {
      subject: subject,
      oracle_identity: match pinned_identity {
        Present { value: identity } => identity
        Absent =>
          as_content_hash_structural(
            structural: content_hash_atom(value: "oracle-pin-unreadable")
          )
      },
      executions: run.executions,
      verdict: run.verdict,
    }
    let write = Filesystem.Write(
      path: receipt_path,
      content: verification_receipt_json(receipt: receipt),
    )
    if write.success {
      VerifyRecorded {
        node_id: progress.node_id,
        verdict_key: validation_verdict_key(verdict: run.verdict),
        detail: validation_verdict_detail(verdict: run.verdict),
      }
    } else {
      VerifyWriteFailed {
        node_id: progress.node_id,
        detail: write.error,
      }
    }
  } else {
    match change_window_refusal {
      Present { value: cause } => {
        let run = BeltValidationRun {
          executions: [],
          verdict: ValidationRefused {
            cause: ValidationChangeWindowRefused { cause: cause },
          },
        }
        let receipt = VerificationReceipt {
          subject: subject,
          oracle_identity: match pinned_identity {
            Present { value: identity } => identity
            Absent =>
              as_content_hash_structural(
                structural: content_hash_atom(value: "oracle-pin-unreadable")
              )
          },
          executions: run.executions,
          verdict: run.verdict,
        }
        let write = Filesystem.Write(
          path: receipt_path,
          content: verification_receipt_json(receipt: receipt),
        )
        if write.success {
          VerifyRecorded {
            node_id: progress.node_id,
            verdict_key: validation_verdict_key(verdict: run.verdict),
            detail: validation_verdict_detail(verdict: run.verdict),
          }
        } else {
          VerifyWriteFailed {
            node_id: progress.node_id,
            detail: write.error,
          }
        }
      }
      Absent => {
    let observations = belt_oracle_observations_in_worktree(
      contract: node.execution,
      worktree: worktree,
    )
    let run = match validation_oracle_gate(
      contract: node.execution,
      observations: observations,
      pin_recorded: pin_recorded,
      expected_identity: match pinned_identity {
        Present { value: identity } => identity
        Absent =>
          as_content_hash_structural(
            structural: content_hash_atom(value: "oracle-pin-unreadable")
          )
      },
      revision: match pinned_revision {
        Present { value: revision } => revision
        Absent => "oracle-pin-unreadable" as NonEmptyStr as VersionIdentity
      },
      pin_read_detail: if pin_refusal == "" {
        "no oracle identity was recorded for this attempt at dispatch"
      } else {
        pin_refusal
      },
    ) {
      ValidationOracleGateRefused { cause } =>
        BeltValidationRun {
          executions: [],
          verdict: ValidationRefused { cause: cause },
        }
      ValidationOracleAdmitted { identity } =>
        match contract_closure(contract: node.execution) {
          ContractDeclaresNoValidation =>
            BeltValidationRun {
              executions: [],
              verdict: ValidationRefused {
                cause: ValidationContractUnspecified,
              },
            }
          ContractNotAgentWork { mode } =>
            BeltValidationRun {
              executions: [],
              verdict: ValidationRefused {
                cause: ValidationNotAgentWork { mode: mode },
              },
            }
          ContractClosesNothing =>
            BeltValidationRun {
              executions: [],
              verdict: ValidationRefused {
                cause: ValidationContractClosesNothing,
              },
            }
          ContractCloses { validations } =>
            belt_run_validation_operations(
              instance: instance,
              subject: subject,
              validations: validations,
              worktree: worktree,
              oracle_identity: identity,
              diff_window_path: diff_window_path,
              source_roots: contract_source_roots(contract: node.execution),
            )
        }
    }
    let receipt = VerificationReceipt {
      subject: subject,
      oracle_identity: match pinned_identity {
        Present { value: identity } => identity
        Absent =>
          as_content_hash_structural(
            structural: content_hash_atom(value: "oracle-pin-unreadable")
          )
      },
      executions: run.executions,
      verdict: run.verdict,
    }
    let write = Filesystem.Write(
      path: receipt_path,
      content: verification_receipt_json(receipt: receipt),
    )
    if write.success {
      VerifyRecorded {
        node_id: progress.node_id,
        verdict_key: validation_verdict_key(verdict: run.verdict),
        detail: validation_verdict_detail(verdict: run.verdict),
      }
    } else {
      VerifyWriteFailed {
        node_id: progress.node_id,
        detail: write.error,
      }
    }
      }
    }
  }
}

// ------------------------------------------------------------------------------------------------
// PER-ITEM OBLIGATIONS (owner ruling 2026-09-22, "The belt demoted"): the three expensive
// obligations -- verify one candidate and integrate one verified candidate -- are invocable on ONE item without the attempts ledger, each conditional and
// idempotent by construction. A wake-up is a hint, never a fact: the entry recomputes only the
// item's own projection, and a second run over unchanged state is a typed no-op.
// ------------------------------------------------------------------------------------------------

// ONE ATTEMPT'S PROGRESS, never the ledger. The per-item entries take the attempt by name and read
// its own evidence (belt_workflow_progress_for_attempt_ref); the one honesty check is that the
// named attempt IS the node's current modeled attempt -- verifying or integrating a superseded
// attempt would act on a lineage the pointer has already left.
type BeltOneAttemptProgress
  = OneAttemptProgress { progress: WorkflowAttemptProgress }
  | OneAttemptNotCurrent { named: String, current: String }

fn belt_progress_for_one_attempt(instance: HostDashboardInstance, node_id: String, attempt_key: String) -> BeltOneAttemptProgress {
  let progress = belt_workflow_progress_for_attempt_ref(
    instance: instance,
    panes: belt_attempt_panes_observe_for_instance(instance: instance),
    attempt: DispatchAttemptRef {
      node_id: node_id as NonEmptyStr,
      branch: dispatch_branch_name(node_id: node_id as gunbc.roadmap.roadmap_model.RoadmapNodeId, attempt_key: attempt_key) as NonEmptyStr,
      attempt_key: attempt_key,
    },
  )
  if progress.attempt_key == attempt_key {
    OneAttemptProgress { progress: progress }
  } else {
    OneAttemptNotCurrent { named: attempt_key, current: progress.attempt_key }
  }
}

// THE VERIFY-ONE RECEIPT OBSERVATION, lean enough for a witness to author. Recorded means a
// verdict receipt binds this exact head and oracle -- a durable fact the same wake-up can never
// change, so the entry neither re-runs nor rewrites (conditional publish: nothing moves when the
// version did not move).
type VerifyOneReceiptObservation
  = VerifyOneReceiptAbsent
  | VerifyOneReceiptRecorded { verdict_key: String, detail: String }
  | VerifyOneReceiptUnreadable { reason: String }

type VerifyOneGate
  = VerifyOneRun
  | VerifyOneNoOp { verdict_key: String, detail: String }
  | VerifyOneRefuse { reason: String }

fn belt_verify_one_gate(observation: VerifyOneReceiptObservation) -> VerifyOneGate {
  match observation {
    VerifyOneReceiptAbsent => VerifyOneRun
    VerifyOneReceiptRecorded { verdict_key, detail } => VerifyOneNoOp { verdict_key: verdict_key, detail: detail }
    VerifyOneReceiptUnreadable { reason } => VerifyOneRefuse { reason: reason }
  }
}

// The adapter from the receipt module's own evidence type: only an exact-subject v2 receipt counts as recorded;
// a receipt for another subject, a legacy attempt-level receipt, and a legacy v1 head receipt all re-run --
// the verify machinery then writes the v2 receipt at the exact address.
fn belt_verify_one_receipt_observation_of(evidence: VerificationFileEvidence) -> VerifyOneReceiptObservation {
  match evidence {
    VerificationFileAbsent => VerifyOneReceiptAbsent
    VerificationFileUnreadable { reason } => VerifyOneReceiptUnreadable { reason: reason }
    VerificationFileDecoded { evidence } =>
      match evidence {
        VerificationEvidenceForSubject { receipt } =>
          VerifyOneReceiptRecorded {
            verdict_key: validation_verdict_key(verdict: receipt.verdict),
            detail: validation_verdict_detail(verdict: receipt.verdict),
          }
        VerificationEvidenceForAnotherSubject { field: _, expected: _, found: _ } => VerifyOneReceiptUnreadable { reason: "the receipt at this head's address is not an exact-subject v2 receipt, so it does not settle this head" }
        VerificationEvidenceLegacyAttemptLevel { verdict_key: _ } => VerifyOneReceiptUnreadable { reason: "the receipt at this head's address is not an exact-subject v2 receipt, so it does not settle this head" }
        VerificationEvidenceUnreadable { reason: _ } => VerifyOneReceiptUnreadable { reason: "the receipt at this head's address is not an exact-subject v2 receipt, so it does not settle this head" }
        VerificationEvidenceV1LegacyExactHead { legacy: _ } => VerifyOneReceiptUnreadable { reason: "the receipt at this head's address is not an exact-subject v2 receipt, so it does not settle this head" }
      }
  }
}

type BeltVerifyOneResult
  = VerifyOneVerdictRecorded { outcome: BeltVerifyOutcome }
  | VerifyOneAlreadyRecorded { verdict_key: String, detail: String }
  | VerifyOneRefused { reason: String }

// VERIFY ONE ATTEMPT'S CAPTURED HEAD. The gate reads the item's own verification address first;
// only an absent receipt runs the shared verify machinery (belt_verify_attempt_for_instance,
// unchanged). The operation touches no sibling attempt and no envelope.
fn belt_verify_one_for_instance(instance: HostDashboardInstance, node_id: String, attempt_key: String) -> BeltVerifyOneResult {
  let nid = node_id as gunbc.roadmap.roadmap_model.RoadmapNodeId
  let worktree = dispatch_worktree_path_for_instance(instance: instance, node_id: nid, attempt_key: attempt_key)
  match belt_worktree_head_observe(instance: instance, worktree: worktree) {
    WorktreeHeadUnobserved { reason } =>
      VerifyOneRefused { reason: join(["the attempt's worktree head cannot be observed: ", reason], "") }
    WorktreeHeadObserved { revision } =>
      match belt_lookup_node(node_id: node_id) {
        AuthorityProjectionRefused { detail } => VerifyOneRefused { reason: detail }
        NodeMissing => VerifyOneRefused { reason: "the roadmap authority declares no node with this id, so there is no contract to verify against" }
        NodeFound { node } => {
          let selection = belt_verification_selection_observe(instance: instance, node_id: nid, attempt_key: attempt_key, head_sha: revision as String)
          match belt_verification_subject_from_selection(
            node: node,
            attempt_key: attempt_key,
            branch: dispatch_branch_name(node_id: nid, attempt_key: attempt_key),
            head: revision as CommitSha,
            selection: selection,
          ) {
            VerificationSubjectUnobserved { reason: _ } => belt_verify_one_run(instance: instance, node_id: node_id, attempt_key: attempt_key)
            VerificationSubjectAwaitingSelection { head: _ } => belt_verify_one_run(instance: instance, node_id: node_id, attempt_key: attempt_key)
            VerificationSubjectObserved { subject } =>
              match belt_verify_one_gate(observation: belt_verify_one_receipt_observation_of(
                evidence: verification_file_evidence_for(
                  expected: subject,
                  source: belt_verification_receipt_source(instance: instance, node_id: nid, attempt_key: attempt_key, selection: selection),
                )
              )) {
                VerifyOneNoOp { verdict_key, detail } =>
                  VerifyOneAlreadyRecorded { verdict_key: verdict_key, detail: detail }
                VerifyOneRefuse { reason } => VerifyOneRefused { reason: reason }
                VerifyOneRun => belt_verify_one_run(instance: instance, node_id: node_id, attempt_key: attempt_key)
              }
          }
        }
      }
  }
}

// THE OPERATOR'S RESUME OF ONE ATTEMPT'S REFUSED VERIFICATION. It runs the shared verify machinery in
// resume mode, which re-runs only a recorded REFUSED verdict at the attempt's exact head; the new
// verdict replaces the refused receipt. Nothing else changes: a passed or failed verdict answers
// already-recorded, exactly as belt_verify_one_for_instance does.
fn belt_verify_resume_for_instance(instance: HostDashboardInstance, node_id: String, attempt_key: String) -> BeltVerifyOneResult {
  match belt_progress_for_one_attempt(instance: instance, node_id: node_id, attempt_key: attempt_key) {
    OneAttemptNotCurrent { named, current } =>
      VerifyOneRefused {
        reason: join([
          "the named attempt ", named, " is not the node's current modeled attempt (current is ",
          current, "); the resume does not act on a lineage the pointer has left",
        ], ""),
      }
    OneAttemptProgress { progress } =>
      VerifyOneVerdictRecorded { outcome: belt_verify_attempt_in_mode(instance: instance, progress: progress, mode: VerifyAsOperatorResume) }
  }
}

fn belt_verify_one_run(instance: HostDashboardInstance, node_id: String, attempt_key: String) -> BeltVerifyOneResult {
  match belt_progress_for_one_attempt(instance: instance, node_id: node_id, attempt_key: attempt_key) {
    OneAttemptNotCurrent { named, current } =>
      VerifyOneRefused {
        reason: join([
          "the named attempt ", named, " is not the node's current modeled attempt (current is ",
          current, "); the per-item operation does not act on a lineage the pointer has left",
        ], ""),
      }
    OneAttemptProgress { progress } =>
      VerifyOneVerdictRecorded { outcome: belt_verify_attempt_for_instance(instance: instance, progress: progress) }
  }
}

fn belt_verify_pass_outcome_from(outcomes: List<BeltVerifyOutcome>) -> BeltPassOutcome {
  let ledger_refusals = outcomes |> filter(o => match o {
    VerifyDeferred { node_id: nid, reason: _ } => nid == ""
    VerifyWriteFailed { node_id: _, detail: _ } => false
    VerifyEvidenceUnreadable { node_id: _, detail: _ } => false
    VerifyRefused { node_id: _, cause: _ } => false
    VerifyRecorded { node_id: _, verdict_key: _, detail: _ } => false
  })
  if count(ledger_refusals) > 0 {
    match ledger_refusals.first() {
      Present { value: VerifyDeferred { node_id: _, reason: r } } =>
        BeltPassRefused { reason: r }
      Present { value: _ } =>
        BeltPassRefused { reason: "the attempts ledger is unobservable" }
      Absent =>
        BeltPassRefused { reason: "the attempts ledger is unobservable" }
    }
  } else {
    if any(outcomes, o => match o {
      VerifyWriteFailed { node_id: _, detail: _ } => true
      VerifyEvidenceUnreadable { node_id: _, detail: _ } => true
      VerifyDeferred { node_id: _, reason: _ } => false
      VerifyRefused { node_id: _, cause: _ } => false
      VerifyRecorded { node_id: _, verdict_key: _, detail: _ } => false
    }) {
      BeltPassFailed { reason: "one or more verification outcomes could not be recorded" }
    } else {
      let verification_refusals = outcomes |> filter(o => match o {
        VerifyRefused { node_id: _, cause: _ } => true
        VerifyWriteFailed { node_id: _, detail: _ } => false
        VerifyEvidenceUnreadable { node_id: _, detail: _ } => false
        VerifyDeferred { node_id: _, reason: _ } => false
        VerifyRecorded { node_id: _, verdict_key: _, detail: _ } => false
      })
      if count(verification_refusals) > 0 {
        match verification_refusals.first() {
          Present { value: VerifyRefused { node_id: _, cause: r } } =>
            BeltPassRefused { reason: r }
          Present { value: _ } =>
            BeltPassRefused { reason: "verification refused on one or more attempts" }
          Absent =>
            BeltPassRefused { reason: "verification refused on one or more attempts" }
        }
      } else if count(outcomes) > 0
        && all(outcomes, o => match o {
          VerifyDeferred { node_id: nid, reason: _ } => nid != ""
          VerifyWriteFailed { node_id: _, detail: _ } => false
          VerifyEvidenceUnreadable { node_id: _, detail: _ } => false
          VerifyRefused { node_id: _, cause: _ } => false
          VerifyRecorded { node_id: _, verdict_key: _, detail: _ } => false
        }) {
        BeltPassDeferred {
          reason: "no attempt is ready for verification on this tick",
        }
      } else {
        BeltPassRecorded
      }
    }
  }
}

// WHICH NODES AN OBSERVATION COVERS. The daily page observes every node once per tick; the issue
// page observes one node per request. Both are the SAME observation -- the same dispatch-ref census,
// the same current-attempt selection (dispatch_attempt_ref_first_per_node), the same progress
// fold -- narrowed before the per-attempt progress is read, so the two surfaces cannot disagree
// about what a node's current attempt is, and the issue request pays only for its own node.
type WorkflowAttemptScope
  = WorkflowAttemptsAllNodes
  | WorkflowAttemptsOneNode { node_id: String }

fn workflow_attempt_scope_admits(scope: WorkflowAttemptScope, attempt: DispatchAttemptRef) -> Bool {
  match scope {
    WorkflowAttemptsAllNodes => true
    WorkflowAttemptsOneNode { node_id } => (attempt.node_id as String) == node_id
  }
}

fn belt_workflow_attempts_observe_for_instance(
  instance: HostDashboardInstance,
) -> BeltWorkflowAttempts {
  belt_workflow_attempts_observe_scoped(instance: instance, scope: WorkflowAttemptsAllNodes)
}

fn belt_workflow_attempts_observe_scoped(
  instance: HostDashboardInstance,
  scope: WorkflowAttemptScope,
) -> BeltWorkflowAttempts {
  match belt_attempts_observe_for_instance(instance: instance) {
    AttemptsRefused { reason } =>
      WorkflowAttemptsRefused { reason: reason }
    AttemptsObserved { attempts } => {
      let panes = belt_attempt_panes_observe_for_instance(instance: instance)
      WorkflowAttemptsObserved {
        attempts: dispatch_attempt_ref_first_per_node(attempts: attempts)
          |> filter(attempt => workflow_attempt_scope_admits(scope: scope, attempt: attempt))
          |> map(attempt => belt_workflow_progress_for_attempt_ref(
            instance: instance,
            panes: panes,
            attempt: attempt,
          )),
      }
    }
  }
}

// The 'attempt_view_revision' member names the compact work view that is current for this
// attempt (gunbc.roadmap.roadmap_build_meter attempt_view_revision), for a page that already shows
// it. Its staleness is the caller's revision comparison; a caller that made none passes none.
// The wire join of the two authorities the client must never re-derive: the attempt's progress
// members (gunbc.roadmap.roadmap_workflow_progress, unchanged) plus the DECIDED activity view
// (gunbc.roadmap.roadmap_presentation) appended as one 'activity' member. The seam reads process and
// current activity from INSIDE the progress carrier (one_progress_authority_note — the belt cannot
// pass a disagreeing process beside it), so the join is one call on one value. It lives here
// because progress cannot import presentation without a cycle; the member-list seam
// (workflow_attempt_progress_json_members) lets the belt extend the object without re-stating or
// re-matching it.
fn belt_workflow_attempt_presentation_json(
  progress: WorkflowAttemptProgress,
) -> JsonValue {
  belt_workflow_attempt_presentation_json_with_tick_read(
    progress: progress,
    tick_read: BeltTickReceiptAbsent,
    obligation_read: BeltAttemptObligationReceiptAbsent,
  )
}

fn belt_workflow_attempt_presentation_json_with_tick_read(
  progress: WorkflowAttemptProgress,
  tick_read: BeltTickReceiptRead,
  obligation_read: BeltAttemptObligationReceiptRead,
  stale_nodes: List<String> = [],
) -> JsonValue {
  json_object(members: concat(
    workflow_attempt_progress_json_members(progress: progress),
    [
      json_kv(key: "activity", value: activity_view_json_value(
          view: activity_view_from_progress(progress: progress))),
      json_kv(key: build_meter_wire_revision_member, value: json_string(s: attempt_view_revision(progress: progress, stale: any(stale_nodes, n => n == progress.node_id)))),
      json_kv(
        key: "verification_presentation",
        value: json_string(
          s: belt_verification_presentation_detail(
            progress: progress,
            tick_read: tick_read,
            obligation_read: obligation_read,
          ),
        ),
      ),
    ]))
}

fn belt_tick_receipt_wire_json_from_read(tick_read: BeltTickReceiptRead) -> JsonValue {
  match tick_read {
    BeltTickReceiptPresent { receipt } =>
      json_object(members: [
        json_kv(key: "present", value: json_bool(b: true)),
        json_kv(key: "receipt", value: belt_tick_receipt_json_value(receipt: receipt)),
      ])
    BeltTickReceiptAbsent =>
      json_object(members: [
        json_kv(key: "present", value: json_bool(b: false)),
      ])
    BeltTickReceiptUnreadable { reason: r } =>
      json_object(members: [
        json_kv(key: "present", value: json_bool(b: false)),
        json_kv(
          key: "unreadable_reason",
          value: json_string(s: r),
        ),
      ])
  }
}

fn belt_tick_receipt_wire_json_for_instance(
  instance: HostDashboardInstance,
) -> JsonValue {
  belt_tick_receipt_wire_json_from_read(
    tick_read: belt_tick_receipt_read_for_instance(instance: instance),
  )
}

fn belt_workflow_attempts_json_value_for_instance(
  instance: HostDashboardInstance,
  observed: BeltWorkflowAttempts,
  stale_nodes: List<String> = [],
) -> JsonValue {
  let tick_read = belt_tick_receipt_read_for_instance(instance: instance)
  match observed {
    WorkflowAttemptsRefused { reason } =>
      json_object(members: [
        json_kv(key: "schema", value: json_string(s: "roadmap-workflow/v1")),
        json_kv(key: "observe_refused", value: json_bool(b: true)),
        json_kv(key: "reason", value: json_string(s: reason)),
        json_kv(key: "belt_tick", value: belt_tick_receipt_wire_json_from_read(tick_read: tick_read)),
      ])
    WorkflowAttemptsObserved { attempts } =>
      json_object(members: [
        json_kv(key: "schema", value: json_string(s: "roadmap-workflow/v1")),
        json_kv(key: "observe_refused", value: json_bool(b: false)),
        json_kv(
          key: "attempts",
          value: json_array(elements: map(
            attempts,
            progress => belt_workflow_attempt_presentation_json_with_tick_read(
              progress: progress,
              tick_read: tick_read,
              obligation_read: belt_attempt_obligation_receipt_read(instance: instance, node_id: progress.node_id, attempt_key: progress.attempt_key),
              stale_nodes: stale_nodes,
            ),
          )),
        ),
        json_kv(key: "belt_tick", value: belt_tick_receipt_wire_json_from_read(tick_read: tick_read)),
      ])
  }
}

fn belt_workflow_attempts_json_value(
  observed: BeltWorkflowAttempts,
) -> JsonValue {
  belt_workflow_attempts_json_value_for_instance(
    instance: srv1_live_dashboard_instance(),
    observed: observed,
  )
}

fn belt_workflow_attempts_observed_json_for_instance(
  instance: HostDashboardInstance,
  observed: BeltWorkflowAttempts,
  stale_nodes: List<String> = [],
) -> String {
  serialize_json(v: belt_workflow_attempts_json_value_for_instance(
    instance: instance,
    observed: observed,
    stale_nodes: stale_nodes,
  ))
}

fn belt_workflow_attempts_observed_json(
  observed: BeltWorkflowAttempts,
) -> String {
  serialize_json(v: belt_workflow_attempts_json_value(observed: observed))
}

fn belt_workflow_attempts_http_status(
  observed: BeltWorkflowAttempts,
) -> Int {
  match observed {
    WorkflowAttemptsRefused { reason: _ } => 503
    WorkflowAttemptsObserved { attempts: _ } => 200
  }
}

type BeltStopResult
  = StopProcessStopped { node_id: String, session_name: String }
  | StopRetainedSessionCleared {
      node_id: String,
      session_name: String,
      exit_code: Int,
    }
  | StopSignaledSessionCleared {
      node_id: String,
      session_name: String,
      signal: Int,
    }
  | StopDisabled { node_id: String, instance_id: String, reason: String }
  | StopRefusedResult { node_id: String, reason: String }
  | StopObserveRefused { node_id: String, reason: String }
  | StopTeardownFailed { node_id: String, session_name: String, detail: String }

// U4 (stop/clear from the UI): cleanup consumes the same independently observed session and process
// facts served to the page. Session-list refusal yields StopObserveRefused. A present running pane
// is stop-eligible only with the configured provider fingerprint; a foreign or unobserved running
// process refuses. A retained dead pane is a different operation: clear removes tmux metadata after
// the process exited, so its historical wrapper command is never misclassified as a live foreign
// process. Teardown failure remains its own typed 502 arm.
fn belt_stop_node_for_instance(
  instance: HostDashboardInstance,
  node_id: String,
) -> BeltStopResult {
  match instance.actuation {
    DashboardObserveOnly =>
    StopDisabled {
      node_id: node_id,
      instance_id: instance.instance_id as String,
      reason: "dashboard instance is observe-only; stop refused before tmux observation",
    }
    DashboardActuating => {
  match belt_sessions_observe_for_instance(instance: instance) {
    ObserveRefused { reason: r } => StopObserveRefused { node_id: node_id, reason: r }
    BeltSessionsObserved { live } => {
      match belt_recorded_fingerprint_for_node(instance: instance, node_id: node_id) {
        RecordedFingerprintsUnreadable { reason } =>
          StopRefusedResult {
            node_id: node_id,
            reason: join(["the node's recorded process fingerprint is unreadable before stop scope: ", reason], ""),
          }
        RecordedFingerprintsOk { recorded } =>
      match dispatch_tmux_session_scope_for_recorded(
        node_id: node_id as RoadmapNodeId,
        recorded: recorded,
        selection: dispatch_actuator_selection(sizing_expectation: NoDerivedSizingExpectation),
      ) {
        Absent =>
          StopRefusedResult {
            node_id: node_id,
            reason: "dispatch selection refused before stop scope",
          }
        Present { value: scope } => {
      let matched = live
        |> filter(sess =>
          sess.session_name == (scope.session_name as String))
      match matched.first() {
        Absent =>
          StopRefusedResult {
            node_id: node_id,
            reason: "no session container for this node",
          }
        Present { value: session } =>
          match dispatch_session_cleanup(scope: scope, session: session) {
            DispatchCleanupRefused { reason } =>
              StopRefusedResult { node_id: node_id, reason: reason }
            DispatchStopRunningProcess { session_name } =>
              match belt_actuate_teardown_for_instance(
                instance: instance,
                session_name: session_name,
              ) {
                ReapedSession { session_name: stopped } =>
                  StopProcessStopped {
                    node_id: node_id,
                    session_name: stopped,
                  }
                TeardownFailed { session_name: failed, detail } =>
                  StopTeardownFailed {
                    node_id: node_id,
                    session_name: failed,
                    detail: detail,
                  }
              }
            DispatchClearRetainedSession { session_name, exit_code } =>
              match belt_actuate_teardown_for_instance(
                instance: instance,
                session_name: session_name,
              ) {
                ReapedSession { session_name: cleared } =>
                  StopRetainedSessionCleared {
                    node_id: node_id,
                    session_name: cleared,
                    exit_code: exit_code,
                  }
                TeardownFailed { session_name: failed, detail } =>
                  StopTeardownFailed {
                    node_id: node_id,
                    session_name: failed,
                    detail: detail,
                  }
              }
            DispatchClearSignaledSession { session_name, signal } =>
              match belt_actuate_teardown_for_instance(
                instance: instance,
                session_name: session_name,
              ) {
                ReapedSession { session_name: cleared } =>
                  StopSignaledSessionCleared {
                    node_id: node_id,
                    session_name: cleared,
                    signal: signal,
                  }
                TeardownFailed { session_name: failed, detail } =>
                  StopTeardownFailed {
                    node_id: node_id,
                    session_name: failed,
                    detail: detail,
                  }
              }
          }
      }
        }
      }
      }
    }
  }
  }
  }
}

fn belt_stop_node(node_id: String) -> BeltStopResult {
  belt_stop_node_for_instance(
    instance: srv1_live_dashboard_instance(),
    node_id: node_id,
  )
}

fn belt_stop_result_json_value(r: BeltStopResult) -> JsonValue {
  match r {
    StopProcessStopped { node_id: nid, session_name: sn } =>
      json_object(members: [
        json_kv(key: "node_id", value: json_string(s: nid)),
        json_kv(key: "status", value: json_string(s: "process_stopped")),
        json_kv(key: "action", value: json_string(s: "stop")),
        json_kv(key: "ok", value: json_bool(b: true)),
        json_kv(key: "session_name", value: json_string(s: sn)),
      ])
    StopRetainedSessionCleared {
      node_id: nid,
      session_name: sn,
      exit_code,
    } =>
      json_object(members: [
        json_kv(key: "node_id", value: json_string(s: nid)),
        json_kv(key: "status", value: json_string(s: "session_cleared")),
        json_kv(key: "action", value: json_string(s: "clear")),
        json_kv(key: "ok", value: json_bool(b: true)),
        json_kv(key: "session_name", value: json_string(s: sn)),
        json_kv(key: "exit_code", value: json_int(n: exit_code)),
      ])
    StopSignaledSessionCleared {
      node_id: nid,
      session_name: sn,
      signal,
    } =>
      json_object(members: [
        json_kv(key: "node_id", value: json_string(s: nid)),
        json_kv(key: "status", value: json_string(s: "session_cleared")),
        json_kv(key: "action", value: json_string(s: "clear")),
        json_kv(key: "ok", value: json_bool(b: true)),
        json_kv(key: "session_name", value: json_string(s: sn)),
        json_kv(key: "signal", value: json_string(s: linux_standard_signal_render(n: signal))),
      ])
    StopDisabled { node_id: nid, instance_id: iid, reason: why } =>
      json_object(members: [
        json_kv(key: "node_id", value: json_string(s: nid)),
        json_kv(key: "status", value: json_string(s: "stop_disabled")),
        json_kv(key: "ok", value: json_bool(b: false)),
        json_kv(key: "instance", value: json_string(s: iid)),
        json_kv(key: "reason", value: json_string(s: why)),
      ])
    StopRefusedResult { node_id: nid, reason: r2 } =>
      json_object(members: [
        json_kv(key: "node_id", value: json_string(s: nid)),
        json_kv(key: "status", value: json_string(s: "stop_refused")),
        json_kv(key: "ok", value: json_bool(b: false)),
        json_kv(key: "reason", value: json_string(s: r2)),
      ])
    StopObserveRefused { node_id: nid, reason: r3 } =>
      json_object(members: [
        json_kv(key: "node_id", value: json_string(s: nid)),
        json_kv(key: "status", value: json_string(s: "observe_refused")),
        json_kv(key: "ok", value: json_bool(b: false)),
        json_kv(key: "reason", value: json_string(s: r3)),
      ])
    StopTeardownFailed { node_id: nid, session_name: sn, detail: d } =>
      json_object(members: [
        json_kv(key: "node_id", value: json_string(s: nid)),
        json_kv(key: "status", value: json_string(s: "teardown_failed")),
        json_kv(key: "ok", value: json_bool(b: false)),
        json_kv(key: "session_name", value: json_string(s: sn)),
        json_kv(key: "detail", value: json_string(s: d)),
      ])
  }
}

fn belt_stop_http_status(r: BeltStopResult) -> Int {
  match r {
    StopProcessStopped { node_id: _, session_name: _ } => 200
    StopRetainedSessionCleared {
      node_id: _,
      session_name: _,
      exit_code: _,
    } => 200
    StopSignaledSessionCleared {
      node_id: _,
      session_name: _,
      signal: _,
    } => 200
    StopDisabled { node_id: _, instance_id: _, reason: _ } => 403
    StopRefusedResult { node_id: _, reason: r2 } =>
      if string_contains(s: r2, pattern: "no session container") {
        404
      } else {
        409
      }
    StopObserveRefused { node_id: _, reason: _ } => 503
    StopTeardownFailed { node_id: _, session_name: _, detail: _ } => 502
  }
}

fn belt_stop_json(node_id: String) -> String {
  serialize_json(v: belt_stop_result_json_value(r: belt_stop_node(node_id: node_id)))
}

// The sessions wire projects independent session-container, process-lifecycle, provider, readiness,
// phase and cleanup facts. Inclusion in sessions proves only `session_presence=present`.
// process_state comes from the exact dead/status pane observation; cleanup_action is derived
// separately from process state plus ownership policy. A refused pane probe stays per-session as
// process unobserved and cleanup unavailable while the session set remains a 200; only refusal of
// the tmux session-list source produces top-level observe_refused/503. Cleanup scope for admitted
// rows uses dispatch_tmux_session_scope_for_live_session from the session worker's configured
// provider facts — never a production-selection re-query that would fabricate eligibility or a
// partial row when standing refuses.
fn belt_sessions_json_value(o: BeltObserve) -> JsonValue {
  match o {
    ObserveRefused { reason: r } =>
      json_object(members: [
        json_kv(key: "schema", value: json_string(s: "roadmap-sessions/v1")),
        json_kv(key: "observe_refused", value: json_bool(b: true)),
        json_kv(key: "reason", value: json_string(s: r)),
      ])
    BeltSessionsObserved { live } =>
      json_object(members: [
        json_kv(key: "schema", value: json_string(s: "roadmap-sessions/v1")),
        json_kv(key: "observe_refused", value: json_bool(b: false)),
        json_kv(key: "sessions", value: json_array(elements: live |> map(sess => {
          let cleanup = dispatch_session_cleanup_for_live_session(sess: sess)
          json_object(members: [
            json_kv(key: "node_id", value: json_string(s: sess.node_id)),
            json_kv(key: "session_name", value: json_string(s: sess.session_name)),
            json_kv(key: "session_presence", value: json_string(s: "present")),
            json_kv(key: "process_state", value: json_string(
              s: worker_process_evidence_label(evidence: sess.worker.process))),
            json_kv(key: "process_detail", value: json_string(
              s: worker_process_evidence_detail(evidence: sess.worker.process))),
            json_kv(key: "configured_provider", value: json_string(s: provider_kind_label(kind: sess.worker.configured_provider.kind))),
            json_kv(key: "provider", value: json_string(s: provider_evidence_label(evidence: sess.worker.provider_instance))),
            json_kv(key: "provider_readiness", value: json_string(s: provider_readiness_label(readiness: sess.worker.provider_readiness))),
            json_kv(key: "tool_execution_readiness", value: json_string(s: tool_execution_readiness_label(readiness: sess.worker.tool_readiness))),
            json_kv(key: "worker_phase", value: json_string(s: worker_phase_label(phase: sess.worker.phase))),
            json_kv(key: "cleanup_action", value: json_string(
              s: dispatch_session_cleanup_action(cleanup: cleanup))),
            json_kv(key: "cleanup_allowed", value: json_bool(
              b: dispatch_session_cleanup_allowed(cleanup: cleanup))),
            json_kv(key: "cleanup_detail", value: json_string(
              s: dispatch_session_cleanup_detail(cleanup: cleanup))),
            json_kv(key: "facts", value: session_facts_json_value(
              v: session_facts_view(
                process: sess.worker.process,
                process_detail: worker_process_evidence_detail(evidence: sess.worker.process),
                provider: provider_evidence_label(evidence: sess.worker.provider_instance),
                configured_provider: provider_kind_label(kind: sess.worker.configured_provider.kind),
                provider_readiness: provider_readiness_label(readiness: sess.worker.provider_readiness),
                session_name: sess.session_name,
                cleanup_action: dispatch_session_cleanup_action(cleanup: cleanup),
                cleanup_allowed: dispatch_session_cleanup_allowed(cleanup: cleanup),
                cleanup_detail: dispatch_session_cleanup_detail(cleanup: cleanup),
              ))),
          ])
        }))),
      ])
  }
}

fn belt_sessions_observed_json(o: BeltObserve) -> String {
  serialize_json(v: belt_sessions_json_value(o: o))
}

fn belt_sessions_json() -> String {
  belt_sessions_observed_json(o: belt_sessions_observe())
}

fn belt_sessions_http_status(o: BeltObserve) -> Int {
  match o {
    ObserveRefused { reason: _ } => 503
    BeltSessionsObserved { live: _ } => 200
  }
}

fn belt_run_once_json() -> String {
  serialize_json(v: belt_tick_result_json_value(t: belt_run_once()))
}

// THE JSON TICK RESOLVES ITS INSTANCE FROM THE SPAWN WORKDIR, the way the CLI does. belt_run_once_json
// above is bound to the srv1 live instance; run on any other host it ticks a nonexistent layout and
// reports refusals about the wrong machine. This entry takes the workdir as its argument and returns
// the full per-attempt commit, verify and publish outcomes as one JSON document for a reader.
fn belt_run_once_json_in(spawn_workdir: String) -> String {
  match dashboard_instance_for_repo_root(repo_root: spawn_workdir) {
    DashboardInstanceRootUnknown { repo_root: w } =>
      join(["{\"refused\": \"spawn workdir does not match a known dashboard instance repo root: ", w, "\"}"], "")
    DashboardInstanceResolved { instance } =>
      serialize_json(v: belt_tick_result_json_value(t: belt_run_once_in(instance: instance, spawn_workdir: spawn_workdir)))
  }
}


// Per-node MANUAL dispatch — the click path (operator 2026-07-20: 'i should just manually
// click/dispatch'). belt_run_once ticks the WHOLE ready frontier; belt_dispatch_node spawns exactly
// ONE node by id, operator-selected from the roadmap UI, NOT frontier-gated (the click IS the
// selection). DONE = the operator's SIGNOFF, never a merged PR (operator: 'PR merged not
// necessarily mean item == done — they may not be 1:1'): a signoff-accepted node refuses
// (DispatchNodeAlreadyDone); a node whose PRs merged but is unsigned is still 'in review' and
// dispatchable. Idempotent by the tick's observe-before-spawn, asserted of a PROCESS not a
// container name (belt_session_liveness_note): a running worker gives DispatchAlreadyLive (noop) so
// a double-click never double-spawns; a retained dead pane gives DispatchStaleSession — refused,
// never accepted, never suppressing the new turn. Fail-closed: unknown node id ->
// DispatchNodeNotFound; unknowable observed set -> DispatchObserveRefused; unreadable pane
// lifecycle for a present session -> DispatchSessionLivenessUnobserved (no blind spawn under
// unknown liveness); spawn failure -> DispatchSpawnFailed (never a fabricated success). Reuses
// belt_lookup_node (pure roadmap read), belt_sessions_observe_for_instance (the process-aware
// observation the sessions route already used) and belt_actuate_spawn — no forked spawn path, no
// second observer.
type BeltNodeLookup
  = NodeFound { node: RoadmapNode }
  | NodeMissing
  | AuthorityProjectionRefused { detail: String }

fn belt_find_node_in(nodes: List<RoadmapNode>, node_id: String) -> BeltNodeLookup {
  let matches = nodes |> filter(n => n.node == node_id)
  fold(matches, init: NodeMissing, f: fn(acc, n) {
    match acc {
      NodeFound { node: _ } => acc
      NodeMissing => NodeFound { node: n }
      AuthorityProjectionRefused { detail: _ } => acc
    }
  })
}

fn belt_lookup_node(node_id: String) -> BeltNodeLookup {
  match roadmap_plan_projection() {
    RoadmapAuthorityProjectionRefused { detail: detail } =>
      AuthorityProjectionRefused { detail: detail }
    RoadmapAuthorityProjected { doc: doc, accepted: _, withheld: _ } =>
      belt_find_node_in(nodes: doc_all_nodes(doc: doc), node_id: node_id)
  }
}

// A TMUX CONTAINER IS NOT A LIVE AGENT, AND ADMISSION WAS THE LAST PLACE IN THIS MODULE TO LEARN
// IT. dispatch_process_cleanup_separation_note settled the rule for cleanup and
// belt_sessions_observation_separation_note for the sessions route: session presence and process
// lifecycle are independent, so `session present` never means `agent running`. Dispatch admission
// never adopted it: belt_node_session_live asked `any(live, s => s.node_id == node_id)` over tmux
// ls rows whose worker evidence was the worker_observation_without_provider_probe placeholder, so a
// retained remain-on-exit pane — the artifact the spawn path CREATES by setting remain-on-exit —
// answered `live`, and the click returned DispatchAlreadyLive through the accepted band: a positive
// acknowledgement, no agent, forever, no refusal to count.
//
// THAT IS WORSE THAN THE REFUSAL BESIDE IT. A selection refusal lands in a journal as a typed,
// counted event; an accepted no-op is indistinguishable from success at every surface, so its
// frequency is zero by construction — DESIGN section 5's absorbing fallback wearing an idempotence
// label. `already running` is a claim about a PROCESS: derive it from process evidence or refuse.
//
// THE FOUR ANSWERS ARE NOT A BOOLEAN. Running alone may suppress a spawn. StaleTerminal (pane dead)
// must never suppress the new turn nor read as accepted — the remedy is to clear or supersede it.
// LivenessUnobserved (pane probe refused, or dead pane with no exit status) REFUSES rather than
// spawning, because a blind spawn under unknown liveness is how one node acquires two workers.
// Absent is the ordinary path to a spawn. Collapsing Unobserved into either pole is the state-space
// conflation that produced this defect one level down.
//
// NO SECOND OBSERVER WAS BUILT. The pane probe (belt_attempt_panes_observe_for_instance), the
// pane-to-evidence projection (worker_process_from_attempt_pane) and the per-session join
// (worker_process_for_session) already existed with the refusal semantics; dispatch admission just
// read the ls-only observation instead. Both actuation call sites — tick and dispatch — now route
// through the observation the sessions UI already used.
type BeltSessionLiveness
  = BeltSessionRunning { session_name: String, command: String }
  | BeltSessionStaleTerminal { session_name: String, detail: String }
  | BeltSessionLivenessUnobserved { session_name: String, reason: String }
  | BeltSessionAbsent
  | BeltSessionMultiplicityConflict { session_names: String, session_count: Int }

fn belt_session_liveness_from_process(
  session_name: String,
  process: WorkerProcessEvidence,
) -> BeltSessionLiveness {
  match process {
    WorkerProcessRunning { command } =>
      BeltSessionRunning { session_name: session_name, command: command as String }
    WorkerProcessExited { exit_code, last_command } =>
      BeltSessionStaleTerminal {
        session_name: session_name,
        detail: join([
          "retained pane: process exited with status ",
          to_string(exit_code),
          "; last command ",
          last_command,
        ], ""),
      }
    WorkerProcessSignaled { signal, last_command } =>
      BeltSessionStaleTerminal {
        session_name: session_name,
        detail: join([
          "retained pane: process killed by ",
          linux_standard_signal_render(n: signal),
          "; last command ",
          last_command,
        ], ""),
      }
    WorkerProcessAbsent =>
      BeltSessionStaleTerminal {
        session_name: session_name,
        detail: "session container is present but no provider process is attached",
      }
    WorkerProcessUnobserved { reason } =>
      BeltSessionLivenessUnobserved {
        session_name: session_name,
        reason: reason as String,
      }
  }
}

// 0/1/MANY, BECAUSE first() IS A SILENT VERDICT (review artifact 51237 handback item 3). The fold
// filtered rows by node id and took the first match, so two sessions claiming one node resolved to
// whichever tmux listed first — [running, stale] answered running, [stale, running] answered stale:
// one observation, two orders, two outcomes, no signal that a choice was made.
//
// Two sessions for one node is not a tie to break but a state whose remedy differs from every other
// arm — neither spawn nor reuse is safe until someone decides which history is real. So it refuses
// and NAMES every session; a bare 'ambiguous' leaves the operator to find the panes.
// belt_node_session_live IS DELETED. It answered Bool over a four-state lifecycle, mapping
// StaleTerminal, LivenessUnobserved and Absent all to false — three states with different remedies
// per the module's own liveness note (clean up; refuse and count; spawn). A Boolean erasing the
// distinction invites bypassing the coproduct, and it had no production caller once dispatch
// matched BeltSessionLiveness directly. Consumers match the coproduct.
data belt_dispatch_wire_contract_exemplar_provider: String = "codex"

// DISPATCH READS BACK THE DEPLOYED REVISION BEFORE IT ACTS, and binds it into the launch identity:
// every fact this path consumes -- node roster, signoff, contract, the command it runs -- comes from
// the deployed tree, so an attempt must name the code that produced it. After fleet-desired
// retirement the gate is `launch_gate_landed`: the named tree must be origin/main or an ancestor of
// it. A tree that has not landed (candidate-is-ancestor, unrelated, diverged, unverifiable) is
// `LaunchRevisionNotLanded`. Unreadable local HEAD still refuses because an attempt with no code to
// name has no identity. Equality to origin/main tip is not required -- a host one merge behind
// remains landed -- so convergence lag does not become a dispatch outage. Tip equality stays a
// host fact for the deployed-tree report and the deploy path.
//
// The repo path is `instance.repo_root`, not the `srv1_gunbc_repo_root` constant
// `fleet_converge_cli` uses: the read is a fact about the instance dispatched, and hardcoding srv1
// would mint a second path authority answering for the wrong host on any other instance.
// THE TRANSITION GATE DOMINATES THE REVISION GATE; the order is the safety property. A repository
// convergence advances the base ref BEFORE it transitions the worktree, so a converge that died in
// between leaves the ref at the admitted revision over a tree that never moved — and
// a revision read alone would see an ordinary HEAD and admit a
// dispatch into exactly the half-transitioned tree the belt must stay out of. Asking the inhibition
// first stops a gate being satisfied by the artifact of the failure it should notice.
//
// UNREADABLE REFUSES. `actuation_admission` admits only `ActuationPermitted`; an unreadable
// standing is a refusal carrying its cause, never a proceed.
fn belt_transition_admission_for_instance(instance: HostDashboardInstance) -> ActuationAdmission {
  actuation_admission(
    standing: transition_actuation_standing(instance_root: instance.instance_root as String),
  )
}

// THE ONE HOST OBSERVATION the launch admission consumes, produced here because this module owns
// the observers: posture from the instance, the transition admission, the fleet revision standing,
// the tmux session set, the capacity and the spawn mode. The served daily page, POST /dispatch and
// (inline, after the tick-wide transition and revision refusals) the belt tick all hand this to
// gunbc.roadmap.roadmap_launch_admission, so `drift refuses UI availability and backend actuation with the
// same reason` holds by construction: one standing, one decision.
// THE ONE STAGED OBSERVER behind the page, POST /dispatch and the timer. It reads in gate order and
// stops at the first refusal: instance posture is a model fact (no effect); the transition file is
// read only for an actuating instance; the fleet revision only under an admitted transition; tmux
// only under an observed revision. Each halt is a LaunchHostHalted whose later fields do not exist,
// so `tmux listed under an inhibited transition` is not a state it can produce (DESIGN 4b: no
// constructor). The refusal in a halt is derived by the admission's own gate functions
// (launch_host_halt_transition, launch_host_stage_revision), never spelled here.
fn belt_launch_host_standing_for_instance_with_capacity(
  instance: HostDashboardInstance,
  mode: SpawnMode,
  capacity: BeltCapacity,
) -> LaunchHostStanding {
  let instance_id = instance.instance_id as String
  match instance.actuation {
    DashboardObserveOnly => LaunchHostObserveOnly { instance_id: instance_id }
    DashboardActuating =>
      match belt_transition_admission_for_instance(instance: instance) {
        ActuationRefused { reason } => launch_host_halt_transition(instance_id: instance_id, reason: reason)
        ActuationAdmitted =>
          match launch_host_stage_revision(
            instance_id: instance_id,
            revision: local_tree_revision(repo: instance.repo_root),
          ) {
            HostRevisionHalted { standing } => standing
            HostRevisionObserved { revision } =>
              match revision {
                LocalTreeRevisionUnobserved { cause } =>
                  LaunchHostHalted {
                    instance_id: instance_id,
                    gate: HostRevisionGate,
                    refusal: LaunchRevisionUnobserved { cause: cause },
                  }
                LocalTreeRevisionObserved { revision: oid } =>
                  match launch_gate_landed(
                    standing: landed_on_admitted_standing(
                      repo: instance.repo_root,
                      remote: instance.admitted_revision.remote,
                      ref_name: instance.admitted_revision.ref_name,
                      local: oid,
                    ),
                  ) {
                    GatePassed =>
                      LaunchHostObserved {
                        instance_id: instance.instance_id,
                        actuation: DashboardActuating,
                        transition: ActuationAdmitted,
                        revision: revision,
                        sessions: LaunchSessionsPending,
                        capacity: capacity,
                        mode: mode,
                      }
                    GateRefused { refusal } =>
                      LaunchHostHalted { instance_id: instance_id, gate: HostRevisionGate, refusal: refusal }
                    GateNotReached =>
                      LaunchHostUnobserved { reason: "landed-on-main gate answered not-reached; refused fail-closed" }
                  }
              }
          }
      }
  }
}

// THE CENSUS READS THE OCCURRENCE POPULATION, not one realization's listing: tmux sessions, the
// user manager's attempt units, and the durable attempt records union into the
// occurrence population (gunbc.roadmap.roadmap_attempt_occurrence), and only the lean census rows
// reach the standing. A systemd-held attempt now answers AlreadyLive and occupies a capacity slot
// exactly as a tmux-held one does; a population that cannot be fully observed refuses rather than
// answering over half of it.
fn belt_launch_sessions_for_instance(instance: HostDashboardInstance) -> LaunchSessionsStanding {
  match belt_attempt_occurrences_observe_for_instance(instance: instance) {
    OccurrencePopulationObserved { occurrences } =>
      LaunchSessionsObserved {
        live: fold(occurrences, init: [], f: fn(acc, o) {
          match occurrence_census_row(o: o) {
            Absent => acc
            Present { value: row } => concat(acc, [row])
          }
        }),
      }
    OccurrencePopulationRefused { reason } => LaunchSessionsUnobserved { reason: reason }
  }
}

// The one place tmux is listed for a launch decision: a pending session set on an otherwise
// admitted host is observed ONCE and bound into the standing. The timer calls it after the host
// gates admit (its reap pass needs the observed set whatever the launch verdicts); the route only
// when launch_admission_staged answered LaunchStageNeedsSessions for the posted node; the page only
// when at least one row answered so. A halted, observe-only or unobserved standing is returned
// unchanged — nothing to complete, nothing read.
fn belt_launch_host_standing_complete(instance: HostDashboardInstance, standing: LaunchHostStanding) -> LaunchHostStanding {
  match standing {
    LaunchHostObserved { instance_id: _, actuation: _, transition: _, revision: _, sessions, capacity: _, mode: _ } =>
      match sessions {
        LaunchSessionsPending => launch_host_with_sessions(standing: standing, sessions: belt_launch_sessions_for_instance(instance: instance))
        LaunchSessionsObserved { live: _ } => standing
        LaunchSessionsUnobserved { reason: _ } => standing
      }
    LaunchHostObserveOnly { instance_id: _ } => standing
    LaunchHostHalted { instance_id: _, gate: _, refusal: _ } => standing
    LaunchHostUnobserved { reason: _ } => standing
  }
}

type BeltPageSessionsNeed
  = PageSessionsNotNeeded
  | PageSessionsNeeded { first_node_id: String }

fn belt_page_sessions_need(standing: LaunchHostStanding, graph: LaunchGraphStanding, merged: List<Int>, nodes: List<RoadmapNode>) -> BeltPageSessionsNeed {
  fold(nodes, init: PageSessionsNotNeeded, f: (acc, n) => match acc {
    PageSessionsNeeded { first_node_id } => PageSessionsNeeded { first_node_id: first_node_id }
    PageSessionsNotNeeded =>
      match launch_admission_staged(cause: Operator, standing: standing, graph: graph, merged: merged, node_id: n.node as String, reserved: 0) {
        LaunchStageNeedsSessions => PageSessionsNeeded { first_node_id: n.node as String }
        LaunchStageDecided { admission: _ } => PageSessionsNotNeeded
      }
  })
}

// The page's standing is decided against the plan the page is about to RENDER. Passing the plan in
// rather than reading the public carrier here is what keeps the two halves of one response honest:
// a caller rendering a different plan would otherwise get session-need decided from a roadmap its
// reader never sees.
fn belt_launch_host_standing_for_page_over(
  instance: HostDashboardInstance,
  plan: RoadmapAuthorityProjection,
) -> LaunchHostStanding {
  let pre = belt_launch_host_standing(instance: instance)
  match plan {
    RoadmapAuthorityProjectionRefused { detail: _ } => pre
    RoadmapAuthorityProjected { doc, accepted: _, withheld: _ } => {
      let graph = launch_graph_of_document(doc: doc)
      let merged = authored_merged_prs()
      match belt_page_sessions_need(standing: pre, graph: graph, merged: merged, nodes: doc_all_nodes(doc: doc)) {
        PageSessionsNeeded { first_node_id: _ } => belt_launch_host_standing_complete(instance: instance, standing: pre)
        PageSessionsNotNeeded => pre
      }
    }
  }
}

fn belt_launch_host_standing_for_instance(instance: HostDashboardInstance, mode: SpawnMode) -> LaunchHostStanding {
  belt_launch_host_standing_for_instance_with_capacity(instance: instance, mode: mode, capacity: roadmap_belt_default_capacity)
}

fn belt_launch_host_standing(instance: HostDashboardInstance) -> LaunchHostStanding {
  belt_launch_host_standing_for_instance(instance: instance, mode: roadmap_belt_production_spawn_mode)
}

// POST /dispatch/<node_id> IS A PROJECTION OF THE SHARED ADMISSION (RLM-1). The route observes the
// host once, asks gunbc.roadmap.roadmap_launch_admission with cause Operator, and actuates only on
// LaunchAdmitted — so a blocked child is refused DependenciesBlocked before any worktree, provider
// preflight or clock read; a second click on a live node answers AlreadyLive with the existing
// session; and the old route's manual out-of-order override (no dependency, capacity or contract
// check) has no path left. The node model the spawn needs is looked up AFTER admission through the
// projection the admission read; an admitted node cannot fail this lookup, and a projection refusal
// between the two reads is a typed SpawnFailed, never a spawn.
fn belt_dispatch_node_for_instance(
  instance: HostDashboardInstance,
  node_id: String,
) -> BeltSpawnOutcome {
  belt_dispatch_node_staged(instance: instance, standing: belt_launch_host_standing(instance: instance), node_id: node_id)
}

// The dispatch route reaches the SAME staged fold with a caller-supplied plan. belt_dispatch_node_staged_over
// already took the graph as a parameter, so this adds no second decision path -- it only supplies
// launch_graph_of_projection over the given plan instead of over the public one.
fn belt_dispatch_node_for_instance_over(
  instance: HostDashboardInstance,
  plan: RoadmapAuthorityProjection,
  node_id: String,
  request: AttemptLaunchRequest,
  executor: DispatchExecutorRequest,
) -> BeltSpawnOutcome {
  belt_dispatch_node_staged_over(
    instance: instance,
    standing: belt_launch_host_standing(instance: instance),
    graph: launch_graph_of_projection(proj: plan),
    merged: authored_merged_prs(),
    node_id: node_id,
    request: request,
    executor: executor,
  )
}

// THE ROUTE'S DECISION PATH after the staged host observation, and the seam the hermetic
// real-driver controls exercise: given a pre-session standing (sessions pending), the node's
// model-only gates are decided first; only LaunchStageNeedsSessions lists tmux, so an unknown,
// contractless or blocked node is refused with tmux UNREACHABLE (under claim_batch's hermetic route
// an effect here is a route refusal, not a verdict — the control's oracle).
fn belt_dispatch_node_staged(
  instance: HostDashboardInstance,
  standing: LaunchHostStanding,
  node_id: String,
) -> BeltSpawnOutcome {
  belt_dispatch_node_staged_over(
    instance: instance,
    standing: standing,
    graph: launch_graph_of_projection(proj: roadmap_plan_projection()),
    merged: authored_merged_prs(),
    node_id: node_id,
    request: LaunchAutonomous,
    executor: ExecutorDefault,
  )
}

fn belt_dispatch_node_staged_over(
  instance: HostDashboardInstance,
  standing: LaunchHostStanding,
  graph: LaunchGraphStanding,
  merged: List<Int>,
  node_id: String,
  request: AttemptLaunchRequest,
  executor: DispatchExecutorRequest,
) -> BeltSpawnOutcome {
  match (match launch_admission_staged(cause: Operator, standing: standing, graph: graph, merged: merged, node_id: node_id, reserved: 0) {
    LaunchStageDecided { admission } => admission
    LaunchStageNeedsSessions =>
      launch_admission(
        cause: Operator,
        standing: belt_launch_host_standing_complete(instance: instance, standing: standing),
        graph: graph,
        merged: merged,
        node_id: node_id,
        reserved: 0,
      )
  }) {
    LaunchRefused { refusal } => SpawnNotAdmitted { node_id: node_id, refusal: refusal }
    LaunchAdmitted { identity } =>
      match (match graph {
        LaunchGraphUnobserved { detail } => AuthorityProjectionRefused { detail: detail }
        LaunchGraphProjected { nodes, edges: _, readiness: _ } =>
          belt_find_node_in(nodes: nodes, node_id: node_id)
      }) {
        AuthorityProjectionRefused { detail } =>
          SpawnFailed {
            node_id: node_id,
            step: "node-model",
            detail: join(["admitted node's authority projection refused before spawn: ", detail], ""),
            provider: belt_dispatch_spawn_unselected_provider_wire_label(),
            launch: identity,
          }
        NodeMissing =>
          SpawnFailed {
            node_id: node_id,
            step: "node-model",
            detail: "admitted node is absent from the projection it was admitted against; fail-closed",
            provider: belt_dispatch_spawn_unselected_provider_wire_label(),
            launch: identity,
          }
        NodeFound { node } =>
          match clock_now_probed_at() {
            Present { value: probed_at } =>
              match belt_settlement_spawn_gate(settled: belt_session_settlement_pass(instance: instance), node_id: node_id) {
                Present { value: refused } => refused
                Absent =>
                  belt_actuate_spawn_for_instance(
                    instance: instance,
                    node: node,
                    probed_at: probed_at as String,
                    launch: identity,
                    request: request,
                    executor: executor,
                  )
              }
            Absent =>
              SpawnFailed {
                node_id: node_id,
                step: "attempt-clock",
                detail: "clock observation refused; an attempt without a stamp would collide with a later one — fail-closed, no unknown-stamped attempts",
                provider: belt_dispatch_spawn_unselected_provider_wire_label(),
                launch: identity,
              }
          }
      }
  }
}

fn belt_dispatch_node(node_id: String) -> BeltSpawnOutcome {
  belt_dispatch_node_for_instance(
    instance: srv1_live_dashboard_instance(),
    node_id: node_id,
  )
}

fn belt_dispatch_result_ok(r: BeltSpawnOutcome) -> Bool {
  dispatch_band_is_ok(b: belt_dispatch_result_band(r: r))
}

// The ONE wire vocabulary for a dispatch result (DESIGN §3, found live 2026-07-23): the served JSON
// `status` member and the roadmap page's client-side ok-check are two consumers of ONE label set —
// the dispatch button read a retired belt-A `{ok, node}` shape while belt B answered `{status,
// ...}`, so EVERY successful click rendered 'failed' (a silently-wrong UI answer, §5).
// belt_dispatch_status_label is the per-variant label authority consumed by
// belt_dispatch_result_json_value; belt_dispatch_ok_status_labels is the ok-subset the page derives
// its JS predicate from, glued to belt_dispatch_result_ok by witness (a label moved across the
// ok/refusal line without updating both surfaces goes RED).
fn belt_dispatch_status_label(r: BeltSpawnOutcome) -> String {
  match r {
    Spawned { node_id: _, session_name: _, provider: _, launch: _ } => "spawned"
    SpawnFailed { node_id: _, step: _, detail: _, provider: _, launch: _ } => "spawn_failed"
    SpawnLaunchPending { node_id: _, session_name: _, provider: _, launch: _, entry: _ } => "launch_pending"
    SpawnNotAdmitted { node_id: _, refusal } => launch_refusal_label(r: refusal)
  }
}

fn belt_dispatch_disabled_status_label() -> String {
  launch_refusal_label(r: LaunchInstanceActuationRefused { instance_id: "label-exemplar", reason: "label-exemplar" })
}

// The operator-facing state vocabulary (operator ruling 2026-07-24, roadmap-workspace-remodel-plan
// W1a): the wire taxonomy is the belt's DIAGNOSTIC vocabulary and must not moonlight as button
// text. The operator reads BANDS, each a remedy class — ok: the click achieved or already holds the
// desired state; fail: this click cannot achieve it and the ROW is the remedy (wrong node, already
// signed off); loud: the BELT is unwell (observe refused, spawn failed — step/detail in the detail
// channel, never the caption). BandInProgress is inhabited by the client's requested phase AND by
// exactly one wire RESULT, SpawnLaunchPending (the start request is on the attempt-unit spool and
// its answer was not yet there at the single read after the enqueue). That is a meaning change from
// "no wire RESULT maps to it": the progress is not fabricated by presentation, it is the
// observed fact that the root side has not answered, and the client follows the entry named in the
// 202 body through /attempts.json. This fold is the SINGLE ok-authority — belt_dispatch_result_ok and
// belt_dispatch_ok_status_labels project it; the former hand copies (a Bool match, a hand list, a
// label predicate — three spellings of one fact) were the half-born-band defect this dissolves.
type DispatchBand
  = BandOk
  | BandInProgress
  | BandFail
  | BandLoud

fn launch_refusal_band(r: LaunchRefusal) -> DispatchBand {
  match r {
    LaunchAlreadyLive { session_name: _ } => BandOk
    LaunchNoActuatingInstance { reason: _ } => BandFail
    LaunchInstanceActuationRefused { instance_id: _, reason: _ } => BandFail
    LaunchNodeUnknown => BandFail
    LaunchNotReady { missing: _ } => BandFail
    LaunchNoCapacity { occupied: _, max_concurrent: _ } => BandFail
    LaunchCauseNotPermitted { cause: _, mode: _ } => BandFail
    LaunchTransitionInhibited { reason: _ } => BandLoud
    LaunchRevisionUnobserved { cause: _ } => BandLoud
    LaunchRevisionNotLanded { local: _, admitted: _ } => BandLoud
    LaunchAuthorityUnobserved { detail: _ } => BandLoud
    LaunchSessionsUnobservable { reason: _ } => BandLoud
    LaunchStaleSession { session_name: _, detail: _ } => BandLoud
    LaunchLivenessUnobserved { session_name: _, reason: _ } => BandLoud
    LaunchSessionMultiplicityConflict { session_names: _, session_count: _ } => BandLoud
    LaunchGateNotEvaluated { gate: _ } => BandLoud
    LaunchNoPlacementGrant { detail: _ } => BandLoud
  }
}

fn belt_dispatch_result_band(r: BeltSpawnOutcome) -> DispatchBand {
  match r {
    Spawned { node_id: _, session_name: _, provider: _, launch: _ } => BandOk
    SpawnFailed { node_id: _, step: _, detail: _, provider: _, launch: _ } => BandLoud
    SpawnLaunchPending { node_id: _, session_name: _, provider: _, launch: _, entry: _ } => BandInProgress
    SpawnNotAdmitted { node_id: _, refusal } => launch_refusal_band(r: refusal)
  }
}

fn dispatch_band_key(b: DispatchBand) -> String {
  match b {
    BandOk => "ok"
    BandInProgress => "in-progress"
    BandFail => "fail"
    BandLoud => "loud"
  }
}

fn dispatch_band_is_ok(b: DispatchBand) -> Bool {
  match b {
    BandOk => true
    BandInProgress => false
    BandFail => false
    BandLoud => false
  }
}

fn belt_dispatch_ok_status_labels() -> List<String> {
  belt_dispatch_result_exemplars()
    |> filter(r => dispatch_band_is_ok(b: belt_dispatch_result_band(r: r)))
    |> map(r => belt_dispatch_status_label(r: r))
}

type DispatchLabelBandRow {
  wire_label: String
  band_key: String
}

fn belt_dispatch_label_band_rows() -> List<DispatchLabelBandRow> {
  map(belt_dispatch_result_exemplars(), r => DispatchLabelBandRow {
    wire_label: belt_dispatch_status_label(r: r),
    band_key: dispatch_band_key(b: belt_dispatch_result_band(r: r)),
  })
}

fn label_band_rows_cover(rows: List<DispatchLabelBandRow>, labels: List<String>) -> Bool {
  all(labels, l => count(filter(rows, row => row.wire_label == l)) == 1)
}

fn belt_dispatch_label_band_key(wire_label: String) -> String {
  match belt_dispatch_result_for_label(wire_label: wire_label) {
    Present { value: r } => dispatch_band_key(b: belt_dispatch_result_band(r: r))
    Absent => dispatch_band_key(b: BandLoud)
  }
}

// The full wire-label set, GROUNDED in belt_dispatch_status_label rather than hand-listed (§3): one
// exemplar per BeltDispatchResult variant mapped through the label authority. The exemplar roster
// is the single manual enumeration the closed variant set forces — the same one
// witness_dispatch_status_labels_pin_wire_contract pins — and is fail-closed twice: a NEW variant
// makes belt_dispatch_status_label's match non-exhaustive (compiler-caught), and
// gunbc.roadmap.roadmap_component derives the DispatchButton's terminal states from THIS list and
// cross-checks totality both directions (label with no state row, state with no label — each red),
// so the button's state set cannot drift from the served contract. This is what the dispatch-button
// incident (2026-07-23) needed: one authority for the wire vocabulary, consumed by the JSON body,
// the page ok-predicate and the component state totality.
fn belt_dispatch_result_exemplars() -> List<BeltSpawnOutcome> {
  concat(
    [
      Spawned { node_id: "x", session_name: "s", provider: belt_dispatch_wire_contract_exemplar_provider, launch: launch_identity_exemplar() },
      SpawnFailed { node_id: "x", step: "s", detail: "d", provider: belt_dispatch_wire_contract_exemplar_provider, launch: launch_identity_exemplar() },
      SpawnLaunchPending { node_id: "x", session_name: "s", provider: belt_dispatch_wire_contract_exemplar_provider, launch: launch_identity_exemplar(), entry: "e" },
    ],
    map(launch_refusal_exemplars(), r => SpawnNotAdmitted { node_id: "x", refusal: r }),
  )
}

fn belt_dispatch_all_status_labels() -> List<String> {
  map(belt_dispatch_result_exemplars(), r => belt_dispatch_status_label(r: r))
}

fn belt_dispatch_result_for_label(wire_label: String) -> BeltSpawnOutcome? {
  belt_dispatch_result_exemplars()
    |> filter(r => belt_dispatch_status_label(r: r) == wire_label)
    |> first
}

fn belt_dispatch_label_is_ok(wire_label: String) -> Bool {
  any(belt_dispatch_ok_status_labels(), l => l == wire_label)
}

// The dispatch route prefix, part of the wire contract (the click POSTs to prefix+NODE_ID; belt B
// answers at the /dispatch/ NODE_ID route). Homed with the rest of the wire vocabulary (§3) so the
// client script builder (gunbc.roadmap.roadmap_component) and the emitted server (node_http_server_emit)
// read one authority; moved off roadmap_page to break the page-to-component import cycle the
// TsProgram builder would otherwise create.
data belt_dispatch_path_prefix: String = "/dispatch/"

// Live production-selection introspection only — NOT the dispatch wire JSON authority.
// belt_dispatch_result_json_value reads the provider stamped on DispatchSpawned/DispatchSpawnFailed
// at construction time, so exemplars, sandbox echoes and post-selection receipts stay honest when
// standing refuses production re-query.
fn belt_dispatch_provider_label() -> String {
  match dispatch_actuator_selection(sizing_expectation: NoDerivedSizingExpectation) {
    DispatchActuatorSelectionOk { provider, effort: _, model: _, process_fingerprint: _ } =>
      dispatch_provider_label(provider: provider)
    DispatchActuatorSelectionRefused { reason } =>
      concat("selection-refused: ", reason as String)
  }
}

data belt_dispatch_env_var: NonEmptyStr = "GUNBC_BELT_NODE_ID" as NonEmptyStr

// The ProcessExit entrypoint a caller drives with the node id in the environment: gunbc run
// --function cannot pass an argument (no --arg flag), so the node id enters through
// GUNBC_BELT_NODE_ID, read via shell.Env.Get (the env-read authority github.auth uses for its
// token). Missing OR empty GUNBC_BELT_NODE_ID refuses -- shell.Env.Get returns Present-but-empty for
// an unset var wet, so empty folds into the Absent refusal. Exit map: DispatchSpawned or
// DispatchAlreadyLive -> ExitSuccess; every refusal or failure (node_not_found, already_done,
// observe_refused, spawn_failed) -> exit_failure with the JSON receipt on stderr.
// The Node HTTP server that once shelled this entry no longer exists (observed on srv1, 2026-10-11:
// no unit references it, no Node server runs, the listeners are native gunbc); an unknown out-of-tree
// caller therefore meets the refusals below.
// THE INSTANCE SELECTION: GUNBC_BELT_INSTANCE_ID names the instance. Unset, blank or any spelling
// outside belt_dispatch_admitted_instance_ids REFUSES before anything stages; there is no default
// instance (DESIGN 5).
fn belt_dispatch_instance_cli() -> HostDashboardInstance? {
  belt_dispatch_instance_selected(raw: shell.Env.Get(name: belt_dispatch_instance_env_var).value)
}

// The pure decision over what the environment read returned, so a claim can supply the raw value.
fn belt_dispatch_instance_selected(raw: String?) -> HostDashboardInstance? {
  match raw {
    Absent => none
    Present { value: v } =>
      if string_length(s: trim(s: v)) == 0 {
        none
      } else {
        belt_dispatch_instance_named(id: trim(s: v))
      }
  }
}

data belt_dispatch_instance_env_var: NonEmptyStr = "GUNBC_BELT_INSTANCE_ID" as NonEmptyStr

// HOW THE RE-DELIVERY ROUTE IS FIRED FROM A TRANSIENT UNIT. The wake (roadmap_attempt_redelivery_wake)
// owns only the timer (unit name + calendar from the instant); the ROUTE facts -- the module the CLI
// entry lives in, the function name, and the env names the entry reads -- live here, next to the fold
// that fires them, so there is exactly one copy of each (§3). The wake command is assembled by the fold
// in the same serve-binary/run/--source-root/--entry/--function shape belt_obligation_unit_command uses
// to fire any belt function from a transient unit.
//
// THE ENTRY IS belt_redeliver_attempt_cli, NOT belt_dispatch_node_cli. On the srv1 lab the attempt's
// instance is srv1-lab-codex-feedback-v0, which belt_dispatch_instance_named REFUSES (its admitted list
// is deliberately narrow -- srv2-deploy/srv1-live -- and is not ours to widen). belt_redeliver_attempt_cli
// resolves the instance the way the belt's OWN lab units already do -- by repo root, via the existing
// belt_instance_from_env -- so it is proven to work on the lab without widening that fail-closed list. It
// reads the node from GUNBC_BELT_NODE_ID, the expected instance from GUNBC_BELT_REDELIVER_INSTANCE_ID, and
// the ATTEMPT KEY from GUNBC_BELT_REDELIVER_ATTEMPT_KEY. THE ENTRY MAY ONLY CONTINUE, NEVER START: it
// re-delivers only when the node's own continuation decision (the existing belt_continuation_decision_for_instance)
// is a Resume or a request-pending Hold-Until for EXACTLY that key -- so it re-delivers an attempt the door
// already admitted, never fresh work. The admitted-instance list (belt_dispatch_admitted_instance_ids) governs
// what it was written for: STARTING work from the belt-dispatch CLI; a wake re-delivering admitted work is a
// different authority and is NOT gated by it (review 87645, manager decision A1).
data belt_redeliver_cli_entry: String = "dag/gunbc/roadmap/roadmap_belt_tick_cli.dag"
data belt_redeliver_cli_function: NonEmptyStr = "belt_redeliver_attempt_cli" as NonEmptyStr

// THE CROSS-CHECK, NOT THE RESOLUTION. The instance is RESOLVED by repo root (belt_instance_from_env);
// this carries the instance the ATTEMPT belongs to so the entry can refuse when the repo root resolves a
// DIFFERENT one -- a wake firing for the wrong instance is worse than a wedge (roadmap_belt_tick_cli
// belt_redeliver_attempt_cli). Distinct from belt_dispatch_instance_env_var, which is belt_dispatch_node_cli's
// resolution input and is NOT set on the wake.
data belt_redeliver_instance_env_var: NonEmptyStr = "GUNBC_BELT_REDELIVER_INSTANCE_ID" as NonEmptyStr

// THE CONTINUATION GUARD'S SUBJECT. The armed wake names the ONE attempt it re-delivers so the entry can
// refuse anything that is not a continuation of EXACTLY that attempt (belt_redeliver_attempt_continues): the
// wake may re-deliver an already-admitted pending attempt, never start fresh work (review 87645, A1).
data belt_redeliver_attempt_key_env_var: NonEmptyStr = "GUNBC_BELT_REDELIVER_ATTEMPT_KEY" as NonEmptyStr

// The instance comes from the one roster (gunbc.roadmap.roadmap_dashboard_instance dashboard_instance_for_id),
// so no constructor is named here. Admission for belt dispatch is a narrower set than the roster
// (DashboardActuating alone also admits srv1-lab and macbook-local) and is not yet a modeled row, so
// it stays this list of roster ids, unchanged from before. Trigger: an entry takes the instance its deployment names (frontier A of D2 layer 4,
// gunb-ai/gunbc#13726); the list is then replaced by a modeled belt-dispatch admission row on the roster.
data belt_dispatch_admitted_instance_ids: List<String> = ["srv2-deploy", "srv1-live"]

fn belt_dispatch_instance_named(id: String) -> HostDashboardInstance? {
  if any(belt_dispatch_admitted_instance_ids, admitted => admitted == id) {
    match dashboard_instance_for_id(instance_id: id) {
      DashboardInstanceForId { instance } => Present { value: instance }
      DashboardInstanceIdUnknown { instance_id } => none
    }
  } else {
    none
  }
}

fn belt_dispatch_node_cli() -> ProcessExit {
  match shell.Env.Get(name: belt_dispatch_env_var).value {
    Absent =>
      exit_failure(reason: "belt_dispatch_node_cli: GUNBC_BELT_NODE_ID not set — no node id to dispatch (fail-closed)")
    Present { value: v } =>
      if string_length(s: v) == 0 {
        exit_failure(reason: "belt_dispatch_node_cli: GUNBC_BELT_NODE_ID is empty — no node id to dispatch (fail-closed)")
      } else {
        match belt_dispatch_instance_cli() {
          Absent =>
            exit_failure(reason: "belt_dispatch_node_cli: GUNBC_BELT_INSTANCE_ID is unset, empty or names no admitted instance (srv1-live or srv2-deploy) — refusing before anything stages")
          Present { value: instance } =>
            let r = belt_dispatch_node_for_instance(instance: instance, node_id: v)
            if belt_dispatch_result_ok(r: r) {
              ExitSuccess
            } else {
              exit_failure(reason: serialize_json(v: belt_spawn_outcome_json(o: r)))
            }
        }
      }
  }
}

// THE PRODUCER, WITHOUT WHICH THE PUBLICATION LAMP CANNOT MOVE. Observer, adjudicator, receipt
// format, decoder, path and workflow projection all existed before this function and none ever ran,
// because nothing wrote a receipt: a tick read an absent file and reported Pending forever,
// indistinguishable from a correct answer — why the gap survived several reviews.
//
// THE DECISION IS SEPARATED FROM THE THREE EFFECTS, as roadmap_publish is from
// roadmap_publish_observe. belt_publish_decide takes what the read found, what the observation
// concluded and what the write reported, and returns the outcome; belt_publish_attempt_for_instance
// performs read, observation and write and calls it. Every arm — already recorded, undecodable
// evidence, a receipt about another subject, an unwritable receipt — is reachable in a hermetic
// witness from constructed values, the only way an arm that fires once a year gets proven.
//
// IT READS BEFORE WRITING, and an unreadable existing receipt REFUSES rather than being
// overwritten: the belt must not destroy evidence it cannot see. The address differs from the
// verify producer: verification writes one receipt per attempt, publication one per head, so
// re-running against a recorded head is a no-op while a new head opens a new round.
//
// OBSERVATION FAILURE PERSISTS A REFUSED RECEIPT rather than aborting. Aborting before any receipt
// exists would leave the workflow showing ordinary Pending, so an unavailable credential and a
// genuinely unpublished branch would look identical — the absence-versus-refusal collapse this lane
// removes, reappearing at the outermost boundary. A refusal is a fact about an attempt and belongs
// on disk with the others.
//
// THE OBSERVATION IS NO LONGER PERFORMED HERE — the one structural change to this producer. It used
// to read the receipt, call GitHub and write; it now reads the receipt, hands a typed request to
// the publication helper across a Unix-principal boundary, and writes the receipt the helper
// answered with. The three-effect decomposition is unchanged in shape, but the middle effect is a
// spool write and read rather than a network call, because a process that spawns provider sessions
// must not hold a publication token. gunbc.roadmap.roadmap_publication_helper carries that argument;
// PublishRequested is the state between the two, a named outcome rather than a silence for the same
// reason every other arm here is.
type BeltPublishOutcome
  = PublishRecorded {
      node_id: String,
      head_sha: String,
      outcome_key: String,
    }
  | PublishAlreadyRecorded { node_id: String, head_sha: String }
  | PublishEvidenceUnreadable { node_id: String, detail: String }
  | PublishWriteFailed { node_id: String, detail: String }
  | PublishDeferred { node_id: String, reason: String }
  | PublishRequested { node_id: String, head_sha: String, request_path: String }

// expected_base IS main FOR THIS BELT — a deployment fact, not a default. adjudicate_publication
// uses the base to decide which pull requests are candidates at all, so two runs with different
// bases can reach different outcomes about one head; the value belongs in the subject, is recorded
// in the receipt, and is compared when a consumer checks it.
//
// THE BASE IS THE INSTANCE'S DISPATCH BASE, read from the one row that already decides where attempts
// branch from (gunbc.roadmap.roadmap_dashboard_instance dispatch_base_branch), never the repository default:
// a srv2 attempt dispatched from origin/srv2-deploy was offered against main with the whole deploy
// branch in its diff before this (2026-09-05). Every caller passes the instance's derivation, not a
// literal, so there is still one authority; the receipt records what was used.
fn belt_publication_subject_for(
  node_id: String,
  attempt_key: String,
  branch: String,
  base_branch: NonEmptyStr,
  head: WorktreeHeadObservation,
  repository: Repository,
) -> PublicationSubjectObservation {
  match head {
    WorktreeHeadUnobserved { reason } =>
      PublicationSubjectUnobserved {
        reason: join([
          "publication is adjudicated against an exact head and this attempt has none: ",
          reason,
        ], ""),
      }
    WorktreeHeadObserved { revision } =>
      if trim(branch) == "" {
        PublicationSubjectUnobserved {
          reason: "the attempt has no branch name, so there is nothing to look for on the remote",
        }
      } else {
        PublicationSubjectObserved {
          subject: RoadmapPublicationSubject {
            node_id: node_id,
            attempt_key: attempt_key,
            repository: repository,
            branch: branch as NonEmptyStr,
            expected_base: base_branch,
            expected_head: revision as CommitSha,
          },
        }
      }
  }
}

fn belt_publication_subject_for_node(
  node: RoadmapNode,
  attempt_key: String,
  branch: String,
  base_branch: NonEmptyStr,
  head: WorktreeHeadObservation,
) -> PublicationSubjectObservation {
  match node_dispatch_destination(node: node) {
    DispatchDestinationMissing { reason } =>
      PublicationSubjectUnobserved { reason: reason as String }
    DispatchDestinationResolved { identity } =>
      match destination_github_repository(identity: identity) {
        DestinationGithubRepositoryUnobserved { reason } =>
          PublicationSubjectUnobserved { reason: reason as String }
        DestinationGithubRepositoryObserved { repository } =>
          belt_publication_subject_for(
            node_id: node.node as String,
            attempt_key: attempt_key,
            branch: branch,
            base_branch: base_branch,
            head: head,
            repository: repository,
          )
      }
  }
}

data belt_publish_gate_note: String = "THE GATE DECIDES WHETHER TO OBSERVE AT ALL, WHICH IS WHY IT IS PURE AND WHY IT RUNS FIRST. Three of the five outcomes are settled entirely by what is already on disk - the head is on offer, the record does not decode, the record is about someone else - and none of them should cost a network read or risk a write. Deciding them before the effect is what makes them reachable in a witness from constructed values; deciding them after would make the arms untestable and would perform a GitHub read to learn something the filesystem already said.\\n\\nONLY A SETTLED RECEIPT HALTS, AND GETTING THIS WRONG WOULD HAVE FROZEN THE LAMP. The obvious idempotence key is `a receipt exists for this head`, and it is wrong: the belt ticks continuously, so the FIRST observation of a head usually happens before the worker has pushed. That observation is a perfectly good judgment - branch-not-published - and storing it as final would pin the row to `not published` forever, with every later tick halting on the very receipt that recorded the branch's absence. The negative answer would outlive the fact it described.\\n\\nSo the key is whether the receipt says the head is ON OFFER (publication_receipt_offers_the_expected_head, the same predicate a downstream obligation asks). Every other outcome is a snapshot of remote state that has not stopped moving, so the next tick re-observes and replaces it. That is not destroying evidence: it is the same question re-asked, and nothing downstream builds on a snapshot that answered no.\\n\\nA RECEIPT ABOUT ANOTHER SUBJECT AT THIS HEAD'S OWN ADDRESS IS NOT OVERWRITTEN, and that halt is unconditional. The address contains the head, so a mismatch here means something wrote a receipt for a different node, attempt, repository or base into this head's slot. That is unexplained state, and the belt's move on unexplained state is to stop rather than to correct it - overwriting would destroy the only evidence that it happened."

type BeltPublishGate
  = PublishProceed
  | PublishHalted { outcome: BeltPublishOutcome }

fn belt_publish_gate(
  node_id: String,
  subject: RoadmapPublicationSubject,
  existing: PublicationReceiptSource,
) -> BeltPublishGate {
  match publication_evidence_for(expected: subject, source: existing) {
    EvidenceAbsent => PublishProceed
    EvidenceForSubject { receipt } =>
      if publication_receipt_offers_the_expected_head(outcome: receipt.outcome) {
        PublishHalted {
          outcome: PublishAlreadyRecorded {
            node_id: node_id,
            head_sha: subject.expected_head as String,
          },
        }
      } else {
        PublishProceed
      }
    EvidenceUnreadable { reason } =>
      PublishHalted {
        outcome: PublishEvidenceUnreadable {
          node_id: node_id,
          detail: join([
            "a publication receipt for this head could not be read or does not decode, so the belt refuses to replace evidence it cannot read: ",
            reason,
          ], ""),
        },
      }
    EvidenceForAnotherSubject { field, expected, found } =>
      PublishHalted {
        outcome: PublishEvidenceUnreadable {
          node_id: node_id,
          detail: join([
            "a publication receipt at this head's own address is about another subject (",
            field as String, " expected ", expected, ", found ", found,
            "), which the belt refuses to overwrite because the mismatch is itself evidence of a state nobody has explained",
          ], ""),
        },
      }
  }
}

fn belt_publish_write_outcome(
  node_id: String,
  subject: RoadmapPublicationSubject,
  receipt: PublicationReceipt,
  write_success: Bool,
  write_error: String,
) -> BeltPublishOutcome {
  if write_success {
    PublishRecorded {
      node_id: node_id,
      head_sha: subject.expected_head as String,
      outcome_key: publication_receipt_outcome_key(outcome: receipt.outcome) as String,
    }
  } else {
    PublishWriteFailed {
      node_id: node_id,
      detail: join([
        "the publication receipt could not be written, so the judgment was reached and then lost: ",
        write_error,
      ], ""),
    }
  }
}

// PUBLICATION IS ADMITTED ONLY ON A PASSED VERIFICATION VERDICT (gunbc.roadmap.roadmap_publish_admission).
// The evidence is read exactly as the verify pass writes it: the current selection for this head,
// the receipt file it addresses, and the subject the node and attempt pin; anything short of a
// decoded receipt whose verdict is ValidationPassed withholds, and the belt records the withholding
// as a typed deferral rather than publishing an unverified head.
fn belt_publish_admission_for(
  instance: HostDashboardInstance,
  node_id: String,
  attempt_key: String,
  subject: RoadmapPublicationSubject,
) -> PublishAdmission {
  let selection = belt_verification_selection_observe(
    instance: instance,
    node_id: node_id as gunbc.roadmap.roadmap_model.RoadmapNodeId,
    attempt_key: attempt_key,
    head_sha: subject.expected_head as String,
  )
  let source = belt_verification_receipt_source(
    instance: instance,
    node_id: node_id as gunbc.roadmap.roadmap_model.RoadmapNodeId,
    attempt_key: attempt_key,
    selection: selection,
  )
  match belt_lookup_node(node_id: node_id) {
    AuthorityProjectionRefused { detail } =>
      PublishWithheld { reason: join(["the roadmap authority could not be projected: ", detail], "") as NonEmptyStr }
    NodeMissing =>
      PublishWithheld { reason: "the attempt's node is not declared in the roadmap" as NonEmptyStr }
    NodeFound { node } =>
      match belt_verification_subject_from_selection(
        node: node,
        attempt_key: attempt_key,
        branch: subject.branch as String,
        head: subject.expected_head,
        selection: selection,
      ) {
        VerificationSubjectUnobserved { reason } =>
          PublishWithheld { reason: join(["the verification subject is unobserved: ", reason], "") as NonEmptyStr }
        VerificationSubjectAwaitingSelection { head: _ } =>
          PublishWithheld { reason: "the belt has not selected a verification window for this head yet" as NonEmptyStr }
        VerificationSubjectObserved { subject: expected } =>
          match verification_file_evidence_for(expected: expected, source: source) {
            VerificationFileAbsent =>
              PublishWithheld { reason: "no verification receipt exists for this head yet" as NonEmptyStr }
            VerificationFileUnreadable { reason } =>
              PublishWithheld { reason: join(["the verification receipt for this head is unreadable: ", reason], "") as NonEmptyStr }
            VerificationFileDecoded { evidence } =>
              match publish_admission(evidence: evidence) {
                PublishWithheld { reason } => PublishWithheld { reason: reason }
                PublishAdmitted =>
                  belt_review_admission(
                    instance: instance,
                    node_id: node_id as gunbc.roadmap.roadmap_model.RoadmapNodeId,
                    attempt_key: attempt_key,
                    head_sha: subject.expected_head as String,
                  )
              }
          }
      }
  }
}

// PUBLICATION NEEDS THE REVIEW'S APPROVAL AS WELL AS THE VERIFICATION'S PASS. The two judge different
// things -- the check answers whether the oracle is green, the review answers whether the change is
// the thing the goal asked for -- and either alone has passed work that was not the work (the earlier
// attempts that went green on a narrow oracle). Absent, unreadable, undecodable, cannot-judge and
// changes-requested all withhold, each with its own reason; only a decoded approve admits.
fn belt_review_admission(
  instance: HostDashboardInstance,
  node_id: RoadmapNodeId,
  attempt_key: String,
  head_sha: String,
) -> PublishAdmission {
  let report = belt_review_report(instance: instance, node_id: node_id, attempt_key: attempt_key, head_sha: head_sha)
  let audit = belt_audit_evidence(instance: instance, node_id: node_id, attempt_key: attempt_key, head_sha: head_sha)
  if !review_report_approved(report: report) {
    PublishWithheld { reason: join(["the review has not approved every planned call: ", report.reconciliation.detail], "") as NonEmptyStr }
  } else if !goal_audit_approved(evidence: audit) {
    PublishWithheld { reason: join(["the goal audit has not approved this head: ", (goal_audit_reconcile(evidence: audit)).detail], "") as NonEmptyStr }
  } else {
    PublishAdmitted
  }
}

// THE AUDIT'S EVIDENCE IS A ROSTER OF ONE, read the same way a review criterion is, from the audit
// directory and the auditor's unit.
fn belt_audit_evidence(
  instance: HostDashboardInstance,
  node_id: RoadmapNodeId,
  attempt_key: String,
  head_sha: String,
) -> List<CriterionReviewEvidence> {
  let dir = dispatch_attempt_audit_dir_for_instance(instance: instance, node_id: node_id, attempt_key: attempt_key)
  let path = dispatch_attempt_audit_verdict_path_for_instance(instance: instance, node_id: node_id, attempt_key: attempt_key, head_sha: head_sha)
  let listing = Filesystem.List(path: dir)
  let read = Filesystem.Read(path: path)
  let source = match filesystem_file_observation(
    listing: filesystem_listing_observation(directory: dir, success: listing.success, entries: listing.entries, error: listing.error),
    name: dispatch_attempt_audit_verdict_basename(head_sha: head_sha),
    path: path,
    read: filesystem_read_outcome(content: read.content, success: read.success, error: read.error),
  ) {
    FilesystemFileAbsent(_) => ReviewReceiptAbsent
    FilesystemFileRead { path: _, content } => ReviewReceiptPresent { text: content }
    FilesystemFileIndeterminate { cause } => ReviewReceiptUnreadable { detail: cause }
    FilesystemFileObservationsDisagree { path: _, cause } => ReviewReceiptUnreadable { detail: cause }
    FilesystemFileSubjectRefused { directory: _, name: _, cause } => ReviewReceiptUnreadable { detail: cause }
  }
  [ CriterionReviewEvidence {
    criterion_key: goal_audit_criterion_key,
    source: source,
    process: belt_launch_process(
      instance: instance,
      node_id: node_id as String,
      attempt_key: attempt_key,
      unit: dispatch_audit_unit_name(node_id: node_id as String, attempt_key: attempt_key),
      role: AttemptAuditorRole { head_sha: head_sha },
      metered: MeteredAuditor { head: head_sha as NonEmptyStr },
    ),
  } ]
}

fn belt_audit_attempt_for_instance(instance: HostDashboardInstance, progress: WorkflowAttemptProgress) -> BeltReviewOutcome {
  match workflow_segment_of_kind(segments: progress.segments, kind: VerificationWorkflowSegment) {
    Absent => ReviewSkipped { node_id: progress.node_id, criterion: goal_audit_criterion_key, reason: "the attempt carries no verification segment" }
    Present { value: v } =>
      match v.state {
        WorkflowSegmentComplete => belt_audit_verified_attempt(instance: instance, progress: progress, verification_detail: v.detail)
        WorkflowSegmentPending => ReviewSkipped { node_id: progress.node_id, criterion: goal_audit_criterion_key, reason: "verification has not passed for this head" }
        WorkflowSegmentActive => ReviewSkipped { node_id: progress.node_id, criterion: goal_audit_criterion_key, reason: "verification has not passed for this head" }
        WorkflowSegmentFailed => ReviewSkipped { node_id: progress.node_id, criterion: goal_audit_criterion_key, reason: "verification has not passed for this head" }
        WorkflowSegmentRefused => ReviewSkipped { node_id: progress.node_id, criterion: goal_audit_criterion_key, reason: "verification has not passed for this head" }
        WorkflowSegmentStopped => ReviewSkipped { node_id: progress.node_id, criterion: goal_audit_criterion_key, reason: "verification has not passed for this head" }
      }
  }
}

fn belt_audit_verified_attempt(instance: HostDashboardInstance, progress: WorkflowAttemptProgress, verification_detail: String) -> BeltReviewOutcome {
  let node_id = progress.node_id as gunbc.roadmap.roadmap_model.RoadmapNodeId
  let worktree = dispatch_worktree_path_for_instance(instance: instance, node_id: node_id, attempt_key: progress.attempt_key)
  let git = dispatch_capability_program(environment: instance.execution_environment, cap: GitWorkspaceCapability)
  match belt_exec(cmd: host_exec_argv(program: git, args: shape_git_rev_parse_head_args()), workdir: worktree) {
    ExecFailed { program: _, exit_code: _, stderr } => ReviewDeferred { node_id: progress.node_id, criterion: goal_audit_criterion_key, reason: join(["the attempt worktree head could not be read: ", stderr], "") }
    ExecRefused { program: _, reason } => ReviewDeferred { node_id: progress.node_id, criterion: goal_audit_criterion_key, reason: reason }
    ExecOk { stdout } => {
      let head = trim(stdout)
      match (belt_audit_evidence(instance: instance, node_id: node_id, attempt_key: progress.attempt_key, head_sha: head)).first() {
        Absent => ReviewDeferred { node_id: progress.node_id, criterion: goal_audit_criterion_key, reason: "the audit evidence roster is empty, which the constructor does not permit" }
        Present { value: e } =>
          match e.source {
            ReviewReceiptPresent { text: _ } => ReviewSkipped { node_id: progress.node_id, criterion: goal_audit_criterion_key, reason: "an audit verdict is recorded for this head" }
            ReviewReceiptUnreadable { detail } => ReviewFailed { node_id: progress.node_id, criterion: goal_audit_criterion_key, detail: detail }
            ReviewReceiptAbsent =>
              match e.process {
                WorkerProcessRunning { command: _ } => ReviewSkipped { node_id: progress.node_id, criterion: goal_audit_criterion_key, reason: "an auditor is running" }
                WorkerProcessExited { exit_code, last_command: _ } =>
                  ReviewFailed { node_id: progress.node_id, criterion: goal_audit_criterion_key, detail: join(["the auditor exited ", to_string(exit_code), " without writing a verdict; it is not respawned"], "") }
                WorkerProcessSignaled { signal, last_command: _ } =>
                  ReviewFailed { node_id: progress.node_id, criterion: goal_audit_criterion_key, detail: join(["the auditor was killed by ", linux_standard_signal_render(n: signal), " without writing a verdict; it is not respawned"], "") }
                WorkerProcessUnobserved { reason } => ReviewDeferred { node_id: progress.node_id, criterion: goal_audit_criterion_key, reason: reason as String }
                WorkerProcessAbsent => belt_audit_spawn(instance: instance, progress: progress, worktree: worktree, head: head, verification_detail: verification_detail)
              }
          }
      }
    }
  }
}

fn belt_audit_spawn(instance: HostDashboardInstance, progress: WorkflowAttemptProgress, worktree: String, head: String, verification_detail: String) -> BeltReviewOutcome {
  let node_id = progress.node_id as gunbc.roadmap.roadmap_model.RoadmapNodeId
  match belt_lookup_node(node_id: progress.node_id) {
    AuthorityProjectionRefused { detail } => ReviewDeferred { node_id: progress.node_id, criterion: goal_audit_criterion_key, reason: join(["roadmap authority projection refused: ", detail], "") }
    NodeMissing => ReviewDeferred { node_id: progress.node_id, criterion: goal_audit_criterion_key, reason: "the roadmap authority declares no node with this id, so there is no approved goal to audit against" }
    NodeFound { node } =>
      match instance.toolchain.systemd_run {
        Absent => ReviewDeferred { node_id: progress.node_id, criterion: goal_audit_criterion_key, reason: "the toolchain declares no systemd-run; the auditor needs a transient unit" }
        Present { value: systemd_run } => {
          let git = dispatch_capability_program(environment: instance.execution_environment, cap: GitWorkspaceCapability)
          match belt_exec(cmd: host_exec_argv(program: git, args: shape_git_merge_base_args(left: instance.dispatch_base_ref as String, right: head)), workdir: worktree) {
            ExecFailed { program: _, exit_code: _, stderr } => ReviewDeferred { node_id: progress.node_id, criterion: goal_audit_criterion_key, reason: join(["the audit base could not be computed: ", stderr], "") }
            ExecRefused { program: _, reason } => ReviewDeferred { node_id: progress.node_id, criterion: goal_audit_criterion_key, reason: reason }
            ExecOk { stdout: base } => {
              let ticket = line_ticket(item: node.line)
              let review_detail = match workflow_segment_of_kind(segments: progress.segments, kind: ReviewWorkflowSegment) { Present { value: r } => r.detail  Absent => "no review segment" }
              let brief = goal_audit_brief(
                node_id: progress.node_id,
                headline: node_title(item: node.line),
                boundary: match ticket { Present { value: t } => t.brief  Absent => "" },
                displaced_cost: match ticket { Present { value: t } => t.displaced_cost  Absent => "" },
                handback: match ticket { Present { value: t } => t.handback  Absent => "" },
                acceptance_command: execution_contract_validation_summary(contract: node.execution, environment: instance.execution_environment),
                verification_detail: verification_detail,
                review_detail: review_detail,
                base_sha: trim(base),
                head_sha: head,
                verdict_path: dispatch_attempt_audit_verdict_path_for_instance(instance: instance, node_id: node_id, attempt_key: progress.attempt_key, head_sha: head),
              )
              let unit = dispatch_audit_unit_name(node_id: progress.node_id, attempt_key: progress.attempt_key)
              match attempt_exit_hook(instance_root: instance.instance_root as String, node_id: progress.node_id, attempt_key: progress.attempt_key, role: AttemptAuditorRole { head_sha: head }, record_owner: instance.directory_owner) {
                AttemptExitHookRefused { reason } => ReviewFailed { node_id: progress.node_id, criterion: goal_audit_criterion_key, detail: join(["the auditor was not launched: its exit hook could not be rendered: ", reason as String], "") }
                AttemptExitHookRendered { exec_line } =>
              match metering_roster_admit(instance: instance, node_id: node_id, attempt_key: progress.attempt_key, role: MeteredAuditor { head: head as NonEmptyStr }) {
                RosterAdmissionRefused { cause: roster_cause } => ReviewFailed { node_id: progress.node_id, criterion: goal_audit_criterion_key, detail: join(["the auditor was not launched: ", roster_cause], "") }
                RosterAdmitted =>
              match dispatch_audit_unit_command(instance: instance, node_id: node_id, attempt_key: progress.attempt_key, worktree_path: worktree, brief: brief, head_sha: head, exit_hook: exec_line) {
                SystemdRunCommandRefused { cause: why } =>
                  ReviewFailed { node_id: progress.node_id, criterion: goal_audit_criterion_key, detail: systemd_run_option_words_refused_cause_detail(cause: why) }
                SystemdRunCommandReady { command: command } =>
                  match belt_exec(cmd: dispatch_unit_exec_argv(command: command, resolved_program: systemd_run), workdir: worktree) {
                    ExecOk { stdout: _ } => ReviewSpawned { node_id: progress.node_id, criterion: goal_audit_criterion_key, unit: unit as String }
                    ExecFailed { program: _, exit_code, stderr } => ReviewFailed { node_id: progress.node_id, criterion: goal_audit_criterion_key, detail: join(["the auditor unit could not be started (exit ", to_string(exit_code), "): ", stderr], "") }
                    ExecRefused { program: _, reason } => ReviewFailed { node_id: progress.node_id, criterion: goal_audit_criterion_key, detail: reason }
                  }
              }
              }
              }
            }
          }
        }
      }
  }
}

// THE PLAN THE BELT REALIZES AND JUDGES IS THE REVIEW FUNCTION'S, built from the node's own facts
// and the change window; the belt never enumerates criteria. The subject's verification detail is
// carried into the brief at spawn time and is not needed to observe (identity is node@head and the
// plan revision), so observation passes the detail it has, which may be empty.
type BeltReviewPlan
  = BeltReviewPlanned { plan: ReviewPlan }
  | BeltReviewPlanRefused { reason: String }

fn belt_review_plan_for_head(
  instance: HostDashboardInstance,
  node_id: RoadmapNodeId,
  attempt_key: String,
  head_sha: String,
  verification_detail: String,
) -> BeltReviewPlan {
  let worktree = dispatch_worktree_path_for_instance(instance: instance, node_id: node_id, attempt_key: attempt_key)
  match belt_lookup_node(node_id: node_id as String) {
    AuthorityProjectionRefused { detail } => BeltReviewPlanRefused { reason: join(["roadmap authority projection refused: ", detail], "") }
    NodeMissing => BeltReviewPlanRefused { reason: "the roadmap authority declares no node with this id, so there is no review subject" }
    NodeFound { node } => {
      let git = dispatch_capability_program(environment: instance.execution_environment, cap: GitWorkspaceCapability)
      match belt_exec(cmd: host_exec_argv(program: git, args: shape_git_merge_base_args(left: instance.dispatch_base_ref as String, right: head_sha)), workdir: worktree) {
        ExecFailed { program: _, exit_code: _, stderr } => BeltReviewPlanRefused { reason: join(["the review base could not be computed: ", stderr], "") }
        ExecRefused { program: _, reason } => BeltReviewPlanRefused { reason: reason }
        ExecOk { stdout: base } => {
          let ticket = line_ticket(item: node.line)
          BeltReviewPlanned { plan: review_plan(subject: ReviewSubject {
            node_id: node_id as String,
            headline: node_title(item: node.line),
            boundary: match ticket { Present { value: t } => t.brief  Absent => "" },
            out_of_scope: match ticket { Present { value: t } => t.out_of_scope  Absent => "" },
            red_control: match ticket { Present { value: t } => t.red_control  Absent => "" },
            acceptance_command: execution_contract_validation_summary(contract: node.execution, environment: instance.execution_environment),
            base_sha: trim(base),
            head_sha: head_sha,
            verification_detail: verification_detail,
          }) }
        }
      }
    }
  }
}

// THE ACTUATION KEY of a planned call: revision and criterion, so every artifact of a call (verdict,
// events, scratch, log, unit) is addressed by the plan it was produced under, and a verdict written
// under an earlier roster is simply not this plan's observation.
fn belt_review_call_key(plan: ReviewPlan, call: ReviewCall) -> String {
  join([plan.revision, "-", call.id], "")
}

// ONE OBSERVATION PER PLANNED CALL, whatever is on disk, bound to the call, the subject and the plan
// revision by the path it was read from -- never from the reviewer's text. A call with no verdict
// and no reviewer is present as an absent receipt, so the join's denominator is the plan.
fn belt_review_observations(
  instance: HostDashboardInstance,
  node_id: RoadmapNodeId,
  attempt_key: String,
  head_sha: String,
  plan: ReviewPlan,
) -> List<ReviewObservation> {
  map(plan.calls, call => {
    let key = belt_review_call_key(plan: plan, call: call)
    ReviewObservation {
      call_id: call.id,
      subject_id: review_subject_id(s: plan.subject),
      plan_revision: plan.revision,
      source: belt_review_receipt_source(instance: instance, node_id: node_id, attempt_key: attempt_key, head_sha: head_sha, criterion_key: key),
      process: belt_review_process(instance: instance, node_id: node_id as String, attempt_key: attempt_key, criterion_key: key, head_sha: head_sha),
    }
  })
}

fn belt_review_report(
  instance: HostDashboardInstance,
  node_id: RoadmapNodeId,
  attempt_key: String,
  head_sha: String,
) -> ReviewReport {
  match belt_review_plan_for_head(instance: instance, node_id: node_id, attempt_key: attempt_key, head_sha: head_sha, verification_detail: "") {
    BeltReviewPlanRefused { reason } => review_report_refused(reason: join(["the review plan could not be built: ", reason], ""))
    BeltReviewPlanned { plan } => review_aggregate(plan: plan, observations: belt_review_observations(instance: instance, node_id: node_id, attempt_key: attempt_key, head_sha: head_sha, plan: plan))
  }
}

fn belt_review_receipt_source(
  instance: HostDashboardInstance,
  node_id: RoadmapNodeId,
  attempt_key: String,
  head_sha: String,
  criterion_key: String,
) -> ReviewReceiptSource {
  let dir = dispatch_attempt_review_dir_for_instance(instance: instance, node_id: node_id, attempt_key: attempt_key)
  let path = dispatch_attempt_review_verdict_path_for_instance(instance: instance, node_id: node_id, attempt_key: attempt_key, head_sha: head_sha, criterion_key: criterion_key)
  let listing = Filesystem.List(path: dir)
  let read = Filesystem.Read(path: path)
  match filesystem_file_observation(
    listing: filesystem_listing_observation(directory: dir, success: listing.success, entries: listing.entries, error: listing.error),
    name: dispatch_attempt_review_verdict_basename(head_sha: head_sha, criterion_key: criterion_key),
    path: path,
    read: filesystem_read_outcome(content: read.content, success: read.success, error: read.error),
  ) {
    FilesystemFileAbsent(_) => ReviewReceiptAbsent
    FilesystemFileRead { path: _, content } => ReviewReceiptPresent { text: content }
    FilesystemFileIndeterminate { cause } => ReviewReceiptUnreadable { detail: cause }
    FilesystemFileObservationsDisagree { path: _, cause } => ReviewReceiptUnreadable { detail: cause }
    FilesystemFileSubjectRefused { directory: _, name: _, cause } => ReviewReceiptUnreadable { detail: cause }
  }
}

fn belt_review_process(instance: HostDashboardInstance, node_id: String, attempt_key: String, criterion_key: String, head_sha: String) -> WorkerProcessEvidence {
  belt_launch_process(
    instance: instance,
    node_id: node_id,
    attempt_key: attempt_key,
    unit: dispatch_review_unit_name(node_id: node_id, attempt_key: attempt_key, criterion_key: criterion_key),
    role: AttemptReviewerRole { criterion_key: criterion_key, head_sha: head_sha },
    metered: MeteredReviewer { criterion_key: criterion_key as NonEmptyStr, head: head_sha as NonEmptyStr },
  )
}

// A REVIEWER'S OR AUDITOR'S PROCESS, now that its unit is collected when it ends (the exit record
// replaced RemainAfterExit, gunbc.roadmap.roadmap_dispatch_actuator dispatch_review_unit_properties): the
// manager while the unit is loaded, else the launch's exit record, else -- only when both are silent
// -- whether the launch was ever admitted. The launch's START RECEIPT is its metering roster entry,
// which belt_review_spawn and the audit spawn commit before the unit is started, so a launch with a
// roster entry and no record is a hook that did not write (indeterminate, and never respawned), and
// only a launch with no roster entry answers absent -- the arm on which the review pass spawns.
fn belt_launch_process(instance: HostDashboardInstance, node_id: String, attempt_key: String, unit: NonEmptyStr, role: AttemptUnitRole, metered: MeteredRole) -> WorkerProcessEvidence {
  let loaded = attempt_unit_observation(unit: unit)
  let observation = match loaded {
    AttemptUnitAbsent => {
      let record = attempt_exit_record_observe(instance_root: instance.instance_root as String, node_id: node_id, attempt_key: attempt_key, role: role)
      match record {
        AttemptExitRecordNone =>
          attempt_worker_unit_observation_of(unit: unit, loaded: loaded, record: record, start: belt_launch_start_standing(instance: instance, node_id: node_id, attempt_key: attempt_key, metered: metered))
        AttemptExitRecordFound { record: _ } => attempt_worker_unit_observation_of(unit: unit, loaded: loaded, record: record, start: AttemptUnitStartRecorded)
        AttemptExitRecordUnreadable { reason: _ } => attempt_worker_unit_observation_of(unit: unit, loaded: loaded, record: record, start: AttemptUnitStartRecorded)
      }
    }
    AttemptUnitActive => loaded
    AttemptUnitFinished { exit_status: _ } => loaded
    AttemptUnitUnreadable { reason: _ } => loaded
  }
  worker_process_from_attempt_unit(observation: observation, unit: unit)
}

fn belt_launch_start_standing(instance: HostDashboardInstance, node_id: String, attempt_key: String, metered: MeteredRole) -> AttemptUnitStartStanding {
  let roster = metering_roster_for_attempt(instance: instance, node_id: node_id as gunbc.roadmap.roadmap_model.RoadmapNodeId, attempt_key: attempt_key)
  match roster {
    RosterRefused { cause } => AttemptUnitStartUnread { reason: join(["the launch roster could not be read: ", cause], "") }
    RosterOpen { launches: _ } =>
      if any(metering_roster_launches(roster: roster), r => metered_role_eq(a: r, b: metered)) { AttemptUnitStartRecorded } else { AttemptUnitNeverStarted }
    RosterSealed { launches: _, digest: _ } =>
      if any(metering_roster_launches(roster: roster), r => metered_role_eq(a: r, b: metered)) { AttemptUnitStartRecorded } else { AttemptUnitNeverStarted }
  }
}

// THE REVIEW PASS: for every attempt whose verification passed and whose head has no verdict and no
// reviewer, spawn one reviewer unit against the attempt worktree. It runs after verify on the same
// tick so a head verified now is reviewed now; the verdict is read on the next tick, as the worker's
// terminal is. A reviewer that exited without a verdict is a failure named here and NOT respawned --
// the retained unit keeps the fact stable, and a loop of reviewers would be the absorbing fallback.
type BeltReviewOutcome
  = ReviewSpawned { node_id: String, criterion: String, unit: String }
  | ReviewSkipped { node_id: String, criterion: String, reason: String }
  | ReviewDeferred { node_id: String, criterion: String, reason: String }
  | ReviewFailed { node_id: String, criterion: String, detail: String }
  | ReviewPlanSuperseded { node_id: String, stale_verdicts: Int, revision: String }

fn belt_review_attempt_for_instance(instance: HostDashboardInstance, progress: WorkflowAttemptProgress) -> List<BeltReviewOutcome> {
  match workflow_segment_of_kind(segments: progress.segments, kind: VerificationWorkflowSegment) {
    Absent => [ ReviewSkipped { node_id: progress.node_id, criterion: "", reason: "the attempt carries no verification segment" } ]
    Present { value: v } =>
      match v.state {
        WorkflowSegmentComplete => belt_review_verified_attempt(instance: instance, progress: progress, verification_detail: v.detail)
        WorkflowSegmentPending => [ ReviewSkipped { node_id: progress.node_id, criterion: "", reason: "verification has not passed for this head" } ]
        WorkflowSegmentActive => [ ReviewSkipped { node_id: progress.node_id, criterion: "", reason: "verification has not passed for this head" } ]
        WorkflowSegmentFailed => [ ReviewSkipped { node_id: progress.node_id, criterion: "", reason: "verification has not passed for this head" } ]
        WorkflowSegmentRefused => [ ReviewSkipped { node_id: progress.node_id, criterion: "", reason: "verification has not passed for this head" } ]
        WorkflowSegmentStopped => [ ReviewSkipped { node_id: progress.node_id, criterion: "", reason: "verification has not passed for this head" } ]
      }
  }
}

fn belt_review_verified_attempt(instance: HostDashboardInstance, progress: WorkflowAttemptProgress, verification_detail: String) -> List<BeltReviewOutcome> {
  belt_review_head_for_instance(instance: instance, node_id: progress.node_id, attempt_key: progress.attempt_key, verification_detail: verification_detail)
}

// REVIEW ONE ATTEMPT'S HEAD: the one path the tick takes after verification and the operator takes on
// demand (gunbc.roadmap.roadmap_belt_tick_cli belt_review_head_cli). It reads the head, builds the plan, reports
// a superseded earlier roster, and realizes plan.calls; nothing here enumerates criteria.
fn belt_review_head_for_instance(instance: HostDashboardInstance, node_id: String, attempt_key: String, verification_detail: String) -> List<BeltReviewOutcome> {
  let nid = node_id as gunbc.roadmap.roadmap_model.RoadmapNodeId
  let worktree = dispatch_worktree_path_for_instance(instance: instance, node_id: nid, attempt_key: attempt_key)
  let git = dispatch_capability_program(environment: instance.execution_environment, cap: GitWorkspaceCapability)
  match belt_exec(cmd: host_exec_argv(program: git, args: shape_git_rev_parse_head_args()), workdir: worktree) {
    ExecFailed { program: _, exit_code: _, stderr } => [ ReviewDeferred { node_id: node_id, criterion: "", reason: join(["the attempt worktree head could not be read: ", stderr], "") } ]
    ExecRefused { program: _, reason } => [ ReviewDeferred { node_id: node_id, criterion: "", reason: reason } ]
    ExecOk { stdout } => {
      let head = trim(stdout)
      match belt_review_plan_for_head(instance: instance, node_id: nid, attempt_key: attempt_key, head_sha: head, verification_detail: verification_detail) {
        BeltReviewPlanRefused { reason } => [ ReviewDeferred { node_id: node_id, criterion: "", reason: reason } ]
        BeltReviewPlanned { plan } =>
          concat(
            belt_review_supersession(instance: instance, node_id: nid, attempt_key: attempt_key, head: head, plan: plan),
            map(plan.calls, call => belt_review_call(instance: instance, node_id: node_id, attempt_key: attempt_key, worktree: worktree, head: head, plan: plan, call: call)),
          )
      }
    }
  }
}

// THE REPORT FOR ONE ATTEMPT'S CURRENT HEAD, for the operator entry and the board alike.
fn belt_review_report_for_instance(instance: HostDashboardInstance, node_id: String, attempt_key: String) -> ReviewReport {
  let nid = node_id as gunbc.roadmap.roadmap_model.RoadmapNodeId
  let worktree = dispatch_worktree_path_for_instance(instance: instance, node_id: nid, attempt_key: attempt_key)
  match belt_worktree_head_observe(instance: instance, worktree: worktree) {
    WorktreeHeadUnobserved { reason } => review_report_absent(reason: join(["the attempt head is unobserved: ", reason], ""))
    WorktreeHeadObserved { revision } => belt_review_report(instance: instance, node_id: nid, attempt_key: attempt_key, head_sha: revision as String)
  }
}

// A HEAD REVIEWED UNDER AN EARLIER ROSTER IS EXPLICITLY SUPERSEDED, NOT SILENTLY RE-JUDGED. The
// temporal rule (review 5125854144): a process change restarts the review of an in-flight head under
// the current plan; verdicts written under the old revision are left on disk, are not this plan's
// observations, and their count is reported here so the restart is visible and counted.
fn belt_review_supersession(
  instance: HostDashboardInstance,
  node_id: RoadmapNodeId,
  attempt_key: String,
  head: String,
  plan: ReviewPlan,
) -> List<BeltReviewOutcome> {
  let listing = Filesystem.List(path: dispatch_attempt_review_dir_for_instance(instance: instance, node_id: node_id, attempt_key: attempt_key))
  if !listing.success {
    []
  } else {
    let stale = filter(listing.entries.split(sep: "\n"), name =>
      name.length() > head.length() + 1
        && name.substring(start: 0, end: head.length() + 1) == join([head, "."], "")
        && !string_contains(s: name, pattern: join([".", plan.revision, "-"], ""))
        && string_contains(s: name, pattern: ".json"))
    if count(stale) == 0 { [] } else { [ ReviewPlanSuperseded { node_id: node_id as String, stale_verdicts: count(stale), revision: plan.revision } ] }
  }
}

fn belt_review_call(instance: HostDashboardInstance, node_id: String, attempt_key: String, worktree: String, head: String, plan: ReviewPlan, call: ReviewCall) -> BeltReviewOutcome {
  let nid = node_id as gunbc.roadmap.roadmap_model.RoadmapNodeId
  let key = belt_review_call_key(plan: plan, call: call)
  match belt_review_receipt_source(instance: instance, node_id: nid, attempt_key: attempt_key, head_sha: head, criterion_key: key) {
    ReviewReceiptPresent { text: _ } => ReviewSkipped { node_id: node_id, criterion: call.id, reason: "a verdict is recorded for this head, plan revision and criterion" }
    ReviewReceiptUnreadable { detail } => ReviewFailed { node_id: node_id, criterion: call.id, detail: detail }
    ReviewReceiptAbsent =>
      match belt_review_process(instance: instance, node_id: node_id, attempt_key: attempt_key, criterion_key: key, head_sha: head) {
        WorkerProcessRunning { command: _ } => ReviewSkipped { node_id: node_id, criterion: call.id, reason: "a reviewer is running" }
        WorkerProcessExited { exit_code, last_command: _ } =>
          ReviewFailed { node_id: node_id, criterion: call.id, detail: join(["the reviewer exited ", to_string(exit_code), " without writing a verdict; its exit record and journal are retained for inspection"], "") }
        WorkerProcessSignaled { signal, last_command: _ } =>
          ReviewFailed { node_id: node_id, criterion: call.id, detail: join(["the reviewer was killed by ", linux_standard_signal_render(n: signal), " without writing a verdict; its exit record and journal are retained for inspection"], "") }
        WorkerProcessUnobserved { reason } => ReviewDeferred { node_id: node_id, criterion: call.id, reason: reason as String }
        WorkerProcessAbsent =>
          belt_review_spawn(instance: instance, node_id: node_id, attempt_key: attempt_key, worktree: worktree, head: head, plan: plan, call: call)
      }
  }
}

// ============================================================================================
// THE REVIEWER'S PLACEMENT, BELT SIDE (2026-10-28: seventeen unleased reviewers OOM-killed)
//
// belt_review_spawn asks this for a seat before anything costs a roster entry or a unit. The
// placement itself is gunbc.roadmap.roadmap_session_placement's (the same authority and the same
// laws the worker's session_placement_acquire serves); this helper only wires the belt's answers:
// lack of room DEFERS (the belt re-tries the criterion on a later tick -- waiting is not failure),
// a bug REFUSES, and the settlement pass runs first so a terminal reviewer's hold never occupies
// the slice in the next reviewer's admission.
// ============================================================================================

type BeltReviewerPlacement
  = BeltReviewerPlacementHeld { grant: SessionReviewerGrant, stores: SessionPlacementStores }
  | BeltReviewerPlacementDeferred { detail: String }
  | BeltReviewerPlacementRefused { detail: String }

fn belt_reviewer_placement(
  instance: HostDashboardInstance,
  node_id: String,
  attempt_key: String,
  criterion_key: String,
  reviewer_slots: Nat,
) -> BeltReviewerPlacement {
  match session_reviewer_placement_stores(instance: instance) {
    SessionStoresUnresolved { detail } => BeltReviewerPlacementRefused { detail: detail }
    SessionStoresResolved { stores } =>
      match belt_session_slots_ensure(instance: instance, stores: stores) {
        Present { value: why } => BeltReviewerPlacementRefused { detail: why }
        Absent =>
          match session_reviewer_placement_settle_pass(instance: instance, stores: stores) {
            // An unreadable hold store cannot tell you there is room, and it cannot tell you there
            // is not: the patient answer is to defer the criterion, not to gamble the slice.
            SessionSettlePassRefused { detail } =>
              BeltReviewerPlacementDeferred { detail: join(["the reviewer holds could not be read to decide room: ", detail], "") }
            SessionSettlePassRan { settlements: _ } =>
              match session_reviewer_placement_acquire(instance: instance, stores: stores, node_id: node_id, attempt_key: attempt_key, criterion_key: criterion_key, reviewer_slots: reviewer_slots) {
                SessionReviewerPlacementGranted { grant } => BeltReviewerPlacementHeld { grant: grant, stores: stores }
                SessionReviewerPlacementDeferred { detail } => BeltReviewerPlacementDeferred { detail: detail }
                SessionReviewerPlacementRefused { detail } => BeltReviewerPlacementRefused { detail: detail }
              }
          }
      }
  }
}

// THE REVIEWER SETTLEMENT PASS, run from the placement pass above and from the tick's placement
// settlement. Reviewer holds are released only here -- never by the spawn's word, never by the
// verdict's arrival -- so the pass that reads the unit (observation first, self-recorded exit
// second, cause-unknown else) is the one that decides.
fn belt_reviewer_settlement_pass(instance: HostDashboardInstance) -> SessionSettlePass {
  match session_reviewer_placement_stores(instance: instance) {
    SessionStoresUnresolved { detail } => SessionSettlePassRefused { detail: detail }
    SessionStoresResolved { stores } =>
      match belt_session_slots_ensure(instance: instance, stores: stores) {
        Present { value: why } => SessionSettlePassRefused { detail: why }
        Absent => session_reviewer_placement_settle_pass(instance: instance, stores: stores)
      }
  }
}

fn belt_review_spawn(instance: HostDashboardInstance, node_id: String, attempt_key: String, worktree: String, head: String, plan: ReviewPlan, call: ReviewCall) -> BeltReviewOutcome {
  let nid = node_id as gunbc.roadmap.roadmap_model.RoadmapNodeId
  let key = belt_review_call_key(plan: plan, call: call)
  match instance.toolchain.systemd_run {
    Absent => ReviewDeferred { node_id: node_id, criterion: call.id, reason: "the toolchain declares no systemd-run; the reviewer needs a transient unit" }
    Present { value: systemd_run } => {
      let verdict_path = dispatch_attempt_review_verdict_path_for_instance(instance: instance, node_id: nid, attempt_key: attempt_key, head_sha: head, criterion_key: key)
      let brief = join([call.brief, review_verdict_instruction(verdict_path: verdict_path)], "")
      let unit = dispatch_review_unit_name(node_id: node_id, attempt_key: attempt_key, criterion_key: key)
      match attempt_exit_hook(instance_root: instance.instance_root as String, node_id: node_id, attempt_key: attempt_key, role: AttemptReviewerRole { criterion_key: key, head_sha: head }, record_owner: instance.directory_owner) {
        AttemptExitHookRefused { reason } => ReviewFailed { node_id: node_id, criterion: call.id, detail: join(["the reviewer was not launched: its exit hook could not be rendered: ", reason as String], "") }
        AttemptExitHookRendered { exec_line } =>
      // THE PLACEMENT COMES BEFORE ANYTHING THAT COSTS: no roster entry, no command, no unit exists
      // until the reviewer's seat is granted by the same authority the workers lease through
      // (gunbc.compute.host_capacity, ReviewerSessionPool partition). A refusal for LACK OF ROOM is
      // a DEFERRAL -- the criterion waits for the slice, it has not failed -- and the belt re-tries
      // it on a later tick (the operator's patient-request law). Only a bug (an unnameable unit, a
      // ledger refusing for a non-room reason) fails, and it fails with the holds abandoned. The cap
      // the unit carries below is the granted figure itself; nothing re-derives it.
      match belt_reviewer_placement(instance: instance, node_id: node_id, attempt_key: attempt_key, criterion_key: key, reviewer_slots: count(plan.calls)) {
        BeltReviewerPlacementDeferred { detail } =>
          ReviewDeferred { node_id: node_id, criterion: call.id, reason: join(["the reviewer waits for room in the work slice: ", detail], "") }
        BeltReviewerPlacementRefused { detail } =>
          ReviewFailed { node_id: node_id, criterion: call.id, detail: join(["the reviewer was not placed: ", detail], "") }
        BeltReviewerPlacementHeld { grant: grant, stores: stores } => {
          let granted_bytes = kibibyte_to_byte_size(k: grant.amount)
          match metering_roster_admit(instance: instance, node_id: nid, attempt_key: attempt_key, role: MeteredReviewer { criterion_key: key as NonEmptyStr, head: head as NonEmptyStr }) {
            RosterAdmissionRefused { cause: roster_cause } => ReviewFailed { node_id: node_id, criterion: call.id, detail: join(["the reviewer was not launched: ", roster_cause, "; ", session_reviewer_placement_abandon(stores: stores, grant: grant, reason: "reviewer roster admission refused before launch" as NonEmptyStr)], "") }
            RosterAdmitted =>
          match dispatch_review_unit_command(instance: instance, node_id: nid, attempt_key: attempt_key, worktree_path: worktree, brief: brief, head_sha: head, criterion_key: key, granted: granted_bytes, exit_hook: exec_line) {
            SystemdRunCommandRefused { cause: why } =>
              ReviewFailed { node_id: node_id, criterion: call.id, detail: join([systemd_run_option_words_refused_cause_detail(cause: why), "; ", session_reviewer_placement_abandon(stores: stores, grant: grant, reason: "reviewer unit command refused before launch" as NonEmptyStr)], "") }
            SystemdRunCommandReady { command: command } => {
              // THE RECORD CARRIES THE SETTINGS THE UNIT ACTUALLY RUNS WITH, built from the same call
              // the command builder makes, so a reader can compare cap to grant without trusting
              // either alone. Record, then launch generation, then start -- the worker's order.
              match systemd_run_property_assignments(properties: dispatch_review_unit_properties(instance: instance, granted: granted_bytes, working_directory: instance.repo_root as String, log_path: dispatch_attempt_review_log_path_for_instance(instance: instance, node_id: nid, attempt_key: attempt_key, criterion_key: key), review_dir: dispatch_attempt_review_dir_for_instance(instance: instance, node_id: nid, attempt_key: attempt_key), exit_hook: exec_line)) {
                SystemdRunPropertyAssignmentsRefused { cause: why } =>
                  ReviewFailed { node_id: node_id, criterion: call.id, detail: join([systemd_run_option_words_refused_cause_detail(cause: why), "; ", session_reviewer_placement_abandon(stores: stores, grant: grant, reason: "reviewer unit property refused" as NonEmptyStr)], "") }
                SystemdRunPropertyAssignmentsReady { assignments: unit_properties } =>
                  match session_reviewer_placement_record_write(stores: stores, host: instance.host_identity as String, grant: grant, unit_properties: unit_properties) {
                SessionPlacementWriteFailed { path: p, error: e } =>
                  ReviewFailed { node_id: node_id, criterion: call.id, detail: join(["the reviewer placement record could not be written at ", p, ": ", e, "; ", session_reviewer_placement_abandon(stores: stores, grant: grant, reason: "reviewer placement record write failed before launch" as NonEmptyStr)], "") }
                SessionPlacementWritten { path: _ } =>
                  match session_reviewer_placement_begin_launch(stores: stores, grant: grant) {
                    // THE SLOT WAS SETTLED WHILE WE WERE PREPARING: the hold belongs to the
                    // settlement pass now, the unit is NOT started, and the criterion is re-tried on
                    // a later tick -- the same patient law as a lack of room.
                    SessionReviewerLaunchRefused { detail: ld } =>
                      ReviewDeferred { node_id: node_id, criterion: call.id, reason: join(["the reviewer slot was settled before its unit started; the criterion is re-tried: ", ld], "") }
                    SessionReviewerLaunchAdmitted { grant: launched } =>
                      match belt_exec(cmd: dispatch_unit_exec_argv(command: command, resolved_program: systemd_run), workdir: worktree) {
                        ExecOk { stdout: _ } => ReviewSpawned { node_id: node_id, criterion: call.id, unit: unit as String }
                        ExecFailed { program: _, exit_code, stderr } => ReviewFailed { node_id: node_id, criterion: call.id, detail: join(["the reviewer unit could not be started (exit ", to_string(exit_code), "): ", stderr, "; ", session_reviewer_placement_abandon(stores: stores, grant: launched, reason: "reviewer unit start failed" as NonEmptyStr)], "") }
                        ExecRefused { program: _, reason } => ReviewFailed { node_id: node_id, criterion: call.id, detail: join([reason, "; ", session_reviewer_placement_abandon(stores: stores, grant: launched, reason: "reviewer unit start could not run" as NonEmptyStr)], "") }
                      }
                  }
                  }
              }
            }
          }
          }
        }
      }
      }
    }
  }
}

fn belt_review_outcome_json(o: BeltReviewOutcome) -> JsonValue {
  match o {
    ReviewSpawned { node_id, criterion, unit } =>
      json_object(members: [json_kv(key: "node", value: json_string(s: node_id)), json_kv(key: "criterion", value: json_string(s: criterion)), json_kv(key: "outcome", value: json_string(s: "spawned")), json_kv(key: "unit", value: json_string(s: unit))])
    ReviewSkipped { node_id, criterion, reason } =>
      json_object(members: [json_kv(key: "node", value: json_string(s: node_id)), json_kv(key: "criterion", value: json_string(s: criterion)), json_kv(key: "outcome", value: json_string(s: "skipped")), json_kv(key: "detail", value: json_string(s: reason))])
    ReviewDeferred { node_id, criterion, reason } =>
      json_object(members: [json_kv(key: "node", value: json_string(s: node_id)), json_kv(key: "criterion", value: json_string(s: criterion)), json_kv(key: "outcome", value: json_string(s: "deferred")), json_kv(key: "detail", value: json_string(s: reason))])
    ReviewFailed { node_id, criterion, detail } =>
      json_object(members: [json_kv(key: "node", value: json_string(s: node_id)), json_kv(key: "criterion", value: json_string(s: criterion)), json_kv(key: "outcome", value: json_string(s: "failed")), json_kv(key: "detail", value: json_string(s: detail))])
    ReviewPlanSuperseded { node_id, stale_verdicts, revision } =>
      json_object(members: [json_kv(key: "node", value: json_string(s: node_id)), json_kv(key: "outcome", value: json_string(s: "plan_superseded")), json_kv(key: "stale_verdicts", value: json_int(n: stale_verdicts)), json_kv(key: "revision", value: json_string(s: revision))])
  }
}

// ------------------------------------------------------------------------------------------------
// THE INTEGRATION STEP (owner ruling 2026-09-20: the batch integrates via native SCM fanin).
// It runs inside the publish pass because publication is the obligation integration feeds: a
// verified candidate is first merged into its project's integration head, and only a project
// whose membership is fully integrated has anything to publish. Idempotence is derived, not
// tracked: squash_merge's consumed-source record makes re-integration a typed no-op, so a
// restart continues from the envelope with no belt-side bookkeeping.
// ------------------------------------------------------------------------------------------------

fn belt_attempt_integration_dir_for_instance(
  instance: HostDashboardInstance,
  node_id: RoadmapNodeId,
  attempt_key: String,
) -> String {
  join([
    dispatch_attempt_state_path_for_instance(instance: instance, node_id: node_id, attempt_key: attempt_key),
    "/integration",
  ], "")
}

fn belt_integration_receipt_observe(
  instance: HostDashboardInstance,
  worktree: String,
  dir: String,
  head_sha: String,
) -> IntegrationReceiptObservation {
  match belt_attempt_submission_dir_ensure(instance: instance, worktree: worktree, dir: dir) {
    ExecFailed { program, exit_code, stderr } =>
      IntegrationReceiptUnreadable {
        reason: belt_commit_exec_detail(
          step: "integration-directory",
          outcome: ExecFailed { program: program, exit_code: exit_code, stderr: stderr },
        ),
      }
    ExecRefused { program, reason } =>
      IntegrationReceiptUnreadable {
        reason: belt_commit_exec_detail(step: "integration-directory", outcome: ExecRefused { program: program, reason: reason }),
      }
    ExecOk { stdout: _ } => {
      let listing = Filesystem.List(path: dir)
      if !listing.success {
        IntegrationReceiptUnreadable {
          reason: join(["the integration receipt directory could not be listed: ", dir, " (", listing.error, ")"], ""),
        }
      } else if !filesystem_listing_names_entry(listing: listing.entries, name: join([head_sha, ".json"], "")) {
        IntegrationReceiptAbsent
      } else {
        let read = Filesystem.Read(path: join([dir, "/", head_sha, ".json"], ""))
        match filesystem_read_outcome(content: read.content, success: read.success, error: read.error) {
          FilesystemReadRefused { error } =>
            IntegrationReceiptUnreadable {
              reason: join(["the integration receipt for this head was listed and then could not be read: ", error], ""),
            }
          FilesystemReadSucceeded { content } =>
            match integration_receipt_decode(text: content) {
            IntegrationReceiptNotDecodable { reason } =>
              IntegrationReceiptUnreadable {
                reason: join(["the integration receipt at this head's own address does not decode: ", reason], ""),
              }
            IntegrationReceiptDecoded { receipt } =>
              if receipt.head_sha != head_sha {
                IntegrationReceiptUnreadable {
                  reason: "the integration receipt at this head's own address names a different head, which is unexplained state",
                }
              } else {
                IntegrationReceiptForHead { receipt: receipt }
              }
          }
        }
      }
    }
  }
}

type BeltIntegrationReceiptWrite
  = IntegrationReceiptRecorded
  | IntegrationReceiptRecordFailed { detail: String }

fn belt_integration_receipt_record(
  instance: HostDashboardInstance,
  worktree: String,
  dir: String,
  receipt: IntegrationReceipt,
) -> BeltIntegrationReceiptWrite {
  match belt_attempt_submission_dir_ensure(instance: instance, worktree: worktree, dir: dir) {
    ExecFailed { program, exit_code, stderr } =>
      IntegrationReceiptRecordFailed {
        detail: belt_commit_exec_detail(
          step: "integration-directory",
          outcome: ExecFailed { program: program, exit_code: exit_code, stderr: stderr },
        ),
      }
    ExecRefused { program, reason } =>
      IntegrationReceiptRecordFailed {
        detail: belt_commit_exec_detail(step: "integration-directory", outcome: ExecRefused { program: program, reason: reason }),
      }
    ExecOk { stdout: _ } => {
      let write = Filesystem.Write(
        path: join([dir, "/", receipt.head_sha, ".json"], ""),
        content: integration_receipt_text(receipt: receipt),
      )
      if write.success {
        IntegrationReceiptRecorded
      } else {
        IntegrationReceiptRecordFailed {
          detail: join(["the integration receipt could not be written, so the judgment was reached and then lost: ", write.error], ""),
        }
      }
    }
  }
}

// VERIFICATION-PASSED, READ EXACTLY AS THE PUBLISH ADMISSION READS IT. The integration step must
// answer the same question with the same evidence: the current selection for this head, its
// receipt file, and the subject the node and attempt pin.
type BeltCandidateVerdict
  = VerificationPassedConfirmed
  | VerificationNotPassed { reason: String }
  | VerificationUnreadable { reason: String }

// THE SELECTION IS READ THREE WAYS, NOT TWO. SelectionAbsent is an ABSENCE -- the belt has not yet
// selected a verification window for this head, which is the ordinary state of a head the verify
// pass has not reached -- so the candidate is not (yet) passed and the integrate step defers.
// Unaddressable, unreadable and malformed selections are faults and stay unreadable, as does a
// present selection that cannot bind a subject (another head, no criteria digest). Collapsing the
// absence into the fault failed the publish pass on every tick from 2026-09-29.
type BeltCandidateSubjectReading
  = CandidateSubjectSettled { verdict: BeltCandidateVerdict }
  | CandidateSubjectBound { subject: VerificationSubject }

fn belt_candidate_subject_reading(
  node: RoadmapNode,
  attempt_key: String,
  branch: String,
  head: CommitSha,
  selection: CurrentVerificationSelectionObservation,
) -> BeltCandidateSubjectReading {
  match selection {
    SelectionAbsent =>
      CandidateSubjectSettled {
        verdict: VerificationNotPassed {
          reason: "the belt has not selected a verification window for this head yet, so no verified candidate exists to integrate",
        },
      }
    SelectionUnaddressable { cause } =>
      CandidateSubjectSettled { verdict: VerificationUnreadable { reason: cause } }
    SelectionUnreadable { cause } =>
      CandidateSubjectSettled { verdict: VerificationUnreadable { reason: cause } }
    SelectionMalformed { cause } =>
      CandidateSubjectSettled { verdict: VerificationUnreadable { reason: cause } }
    SelectionObserved { head: _, window_identity: _ } =>
      match belt_verification_subject_from_selection(
        node: node,
        attempt_key: attempt_key,
        branch: branch,
        head: head,
        selection: selection,
      ) {
        VerificationSubjectUnobserved { reason } =>
          CandidateSubjectSettled { verdict: VerificationUnreadable { reason: reason } }
        VerificationSubjectAwaitingSelection { head: _ } =>
          CandidateSubjectSettled {
            verdict: VerificationNotPassed {
              reason: "the belt has not selected a verification window for this head yet, so no verified candidate exists to integrate",
            },
          }
        VerificationSubjectObserved { subject } =>
          CandidateSubjectBound { subject: subject }
      }
  }
}

fn belt_candidate_verification_passed(
  instance: HostDashboardInstance,
  node_id: String,
  attempt_key: String,
  head_sha: String,
) -> BeltCandidateVerdict {
  match belt_lookup_node(node_id: node_id) {
    AuthorityProjectionRefused { detail } =>
      VerificationUnreadable { reason: concat("roadmap authority projection refused: ", detail) }
    NodeMissing =>
      VerificationUnreadable { reason: "the roadmap authority declares no node with this id" }
    NodeFound { node } => {
      let selection = belt_verification_selection_observe(
        instance: instance,
        node_id: node_id as gunbc.roadmap.roadmap_model.RoadmapNodeId,
        attempt_key: attempt_key,
        head_sha: head_sha,
      )
      let source = belt_verification_receipt_source(
        instance: instance,
        node_id: node_id as gunbc.roadmap.roadmap_model.RoadmapNodeId,
        attempt_key: attempt_key,
        selection: selection,
      )
      match belt_candidate_subject_reading(
        node: node,
        attempt_key: attempt_key,
        branch: dispatch_branch_name(
          node_id: node_id as gunbc.roadmap.roadmap_model.RoadmapNodeId,
          attempt_key: attempt_key,
        ),
        head: head_sha as CommitSha,
        selection: selection,
      ) {
        CandidateSubjectSettled { verdict } => verdict
        CandidateSubjectBound { subject } =>
          match verification_file_evidence_for(expected: subject, source: source) {
            VerificationFileAbsent =>
              VerificationNotPassed { reason: "no verification receipt exists for this head yet" }
            VerificationFileUnreadable { reason } =>
              VerificationUnreadable { reason: reason }
            VerificationFileDecoded { evidence } =>
              if verification_evidence_moves_lamp(evidence: evidence) {
                VerificationPassedConfirmed
              } else {
                VerificationNotPassed { reason: "the verification verdict for this head is not passed, so there is no verified candidate to integrate" }
              }
          }
      }
    }
  }
}

type BeltEnvelopeIntegration
  = EnvelopeIntegrated
  | EnvelopeIntegrationBlocked { detail: String }
  | EnvelopeIntegrationUnreadable { detail: String }

fn belt_integration_receipt_record_state(
  instance: HostDashboardInstance,
  worktree: String,
  dir: String,
  capture: SubmissionCapture,
  project_key: String,
  state: IntegrationReceiptState,
) -> BeltIntegrationReceiptWrite {
  belt_integration_receipt_record(
    instance: instance,
    worktree: worktree,
    dir: dir,
    receipt: IntegrationReceipt {
      head_sha: capture.head_sha,
      project: project_key,
      scm_commit_ordinal: capture.scm_commit_ordinal,
      state: state,
    },
  )
}

// THE CAPTURE BINDING IS AUTHENTICATED BEFORE FANIN, because the ordinal alone is not an identity.
// A capture whose scm_commit_ordinal resolves -- in the envelope this tick actually loaded -- to a
// commit whose root differs from the recorded locator is refused typed (CaptureBindingMismatch,
// both locators named) and the refusal is recorded as an integration-blocked receipt, durable: a
// mismatched capture recomputes to the same refusal on every tick until a human looks. A legacy v2
// capture records no locator and refuses as binding-unverifiable rather than being guessed at.
// Both refusals land BEFORE fanin_integrate_candidate, so no merge is ever minted against an
// unauthenticated binding; the honest capture falls through to the merge unchanged.
// THE INTEGRATE'S CONTENT DEMAND IS THE THREE MERGE-SIDE MANIFESTS: the integration head's, the
// candidate's and their merge base's. The envelope is loaded indexed (the index alone), the merge
// base is derived from the commit table -- which the index carries -- and exactly those three roots
// are materialized from their singleton shards; the merge reads entries, and completeness answers
// from the roster. A merge-base refusal reads nothing: squash_merge re-derives the same refusal from
// the same commits.
fn belt_integrate_materialize_sides(
  path: String,
  envelope: RepositoryEnvelope,
  head: RepositoryCommitRef,
  candidate: RepositoryCommitRef,
) -> BeltDeltaResident {
  match merge_base(repository: envelope, target: head, source: candidate) {
    MergeBaseNotDerived { refusal: _ } => DeltaResident { store: envelope.store }
    MergeBaseDerived { anchors } =>
      match materialize_objects(
        envelope_path: path,
        store: envelope.store,
        identities: [
          anchors.base.commit.root.locator,
          anchors.source.commit.root.locator,
          anchors.target.commit.root.locator,
        ],
      ) {
        ObjectMaterializationRefused { detail } => DeltaResidentRefused { detail: detail }
        ObjectsMaterialized { store, read_shards: _ } => DeltaResident { store: store }
      }
  }
}

// A CAPTURE'S STANDING: WHETHER ITS DELTA WAS APPLIED ONTO THE BASE IT WAS COMPUTED AGAINST. Every
// input is a typed member of the commit table (gunbc.scm.intake), so the standing is a pure read with
// no spawn origin observed. A fresh capture descends from the intake commit of the revision it was
// computed against, so its line stands there by construction: on base. A capture written before the
// intake record existed carries what the legacy conversion (belt_scm_intake_convert, below) recorded
// from the evidence of its time -- IntakeStaleCapture when its attempt branched from another revision
// than its line's base: CaptureBaseStale. A line that still reads unrecorded has not been converted,
// and its standing is underivable, never clean.
type BeltCaptureStanding
  = CaptureOnBase
  | CaptureBaseStale { commit: Int, captured_against: String, repository_base: String }
  | CaptureStandingUnderivable { detail: String }

fn belt_line_revision_sha(commits: List<RepositoryCommit>, at: RepositoryCommitRef) -> String {
  match line_intake(commits: commits, head: at) {
    LineIntakeAt { commit: _, revision } => belt_scm_intake_revision_sha(revision: revision)
    LineIntakeAbsent => "no recorded base"
    LineIntakeUnrecorded { commit: _ } => "an unrecorded base"
    LineIntakeUnreadable { at: _ } => "an unreadable line"
  }
}

fn belt_capture_standing(commits: List<RepositoryCommit>, candidate: RepositoryCommitRef) -> BeltCaptureStanding {
  let ordinal = minted_id_ordinal(id: candidate.identity)
  match commit_at_reference(commits: commits, reference: candidate) {
    Absent => CaptureStandingUnderivable { detail: join(["candidate ", to_string(ordinal), " is not a commit of its own envelope"], "") }
    Present { value: c } =>
      match c.intake {
        IntakeStaleCapture { captured_against } =>
          CaptureBaseStale {
            commit: ordinal,
            captured_against: belt_scm_intake_revision_sha(revision: captured_against),
            repository_base: belt_line_revision_sha(commits: commits, at: candidate),
          }
        IntakeNone => belt_capture_line_standing(commits: commits, candidate: candidate)
        IntakeBase { revision: _ } => belt_capture_line_standing(commits: commits, candidate: candidate)
        IntakeAdvance { from: _, to: _ } => belt_capture_line_standing(commits: commits, candidate: candidate)
        IntakeUnrecordedByFormat => belt_capture_line_standing(commits: commits, candidate: candidate)
      }
  }
}

fn belt_capture_line_standing(commits: List<RepositoryCommit>, candidate: RepositoryCommitRef) -> BeltCaptureStanding {
  let ordinal = to_string(minted_id_ordinal(id: candidate.identity))
  match line_intake(commits: commits, head: candidate) {
    LineIntakeAt { commit: _, revision: _ } => CaptureOnBase
    LineIntakeUnrecorded { commit: _ } =>
      CaptureStandingUnderivable { detail: join(["candidate ", ordinal, "'s line predates typed base records and has not been converted (belt_scm_intake_convert_cli)"], "") }
    LineIntakeAbsent => CaptureStandingUnderivable { detail: join(["no commit on candidate ", ordinal, "'s line records a base"], "") }
    LineIntakeUnreadable { at } =>
      CaptureStandingUnderivable { detail: join(["candidate ", ordinal, "'s ancestry cannot be read at commit ", to_string(minted_id_ordinal(id: at.identity))], "") }
  }
}

fn belt_capture_underivable_detail(detail: String) -> String {
  join(["whether the candidate was captured against its repository's base is unknown, so it is not integrated: ", detail], "")
}

fn belt_capture_base_stale_detail(commit: Int, captured_against: String, repository_base: String) -> String {
  join([
    "CaptureBaseStale: candidate ", to_string(commit), " was captured from an attempt on base ", captured_against,
    " into a line based at ", repository_base,
    ", so its recorded tree is not that attempt's tree and it is not integrated",
  ], "")
}

// THE INTEGRATIONS ON A HEAD'S LINE, as (integrating commit, consumed source, superseded integration)
// rows: the pure half of the derivation, from the commit table the index carries.
type BeltLineSource {
  integration: RepositoryCommit
  source: RepositoryCommit
  supersedes: RepositoryCommitRef?
}

type BeltLineSources
  = LineSourcesRead { sources: List<BeltLineSource> }
  | LineSourcesUnreadable { detail: String }

fn belt_line_integrated_sources(commits: List<RepositoryCommit>, head: RepositoryCommitRef) -> BeltLineSources {
  match ancestry_walk(start: head, history: repository_history(commits: commits)) {
    AncestryBrokenAt { commit: _, missing_parent: _ } => LineSourcesUnreadable { detail: "the head's ancestry is broken, so the integrations on its line cannot be enumerated" }
    AncestryStartNotInHistory { start: _ } => LineSourcesUnreadable { detail: "the head is not a commit of its own envelope" }
    AncestryRevisitsACommit { detected_from: _ } => LineSourcesUnreadable { detail: "the head's ancestry revisits a commit, which is envelope damage" }
    AncestryTraced { chain } =>
      fold(chain, init: LineSourcesRead { sources: [] }, f: (acc, at) =>
        match acc {
          LineSourcesUnreadable { detail: _ } => acc
          LineSourcesRead { sources } =>
            match commit_at_reference(commits: commits, reference: at) {
              Absent => LineSourcesUnreadable { detail: "a commit on the head's line is not in the envelope" }
              Present { value: c } =>
                match line_integration_of(commit: c) {
                  Absent => acc
                  Present { value: i } =>
                    match commit_at_reference(commits: commits, reference: i.source) {
                      Absent => LineSourcesUnreadable { detail: join(["integration ", to_string(minted_id_ordinal(id: c.reference.identity)), " names a source the envelope does not hold"], "") }
                      Present { value: s } => LineSourcesRead { sources: concat(sources, [BeltLineSource { integration: c, source: s, supersedes: i.supersedes }]) }
                    }
                }
            }
        })
  }
}

// THE SOURCES THAT STILL COUNT: an integration a later integration on the same line superseded no
// longer contributes its standing -- its content was replaced by the corrective squash, whose
// admission (gunbc.scm.repository_envelope admit_supersession) required it to be exactly that stale
// integration, on this line, superseded once, by a fresh source.
fn belt_line_live_sources(sources: List<BeltLineSource>) -> List<BeltLineSource> {
  let superseded = sources |> flat_map(s => match s.supersedes { Absent => [] Present { value: x } => [x] })
  sources |> filter(s => !any(superseded, x => repository_commit_ref_eq(left: x, right: s.integration.reference)))
}

// A LINE IS STALE WHEN A LIVE INTEGRATION ON IT CONSUMED A STALE CAPTURE: IntegratesStale names the
// integrating commit and the source, and carries the source's two bases.
type BeltLineStanding
  = LineClean
  | IntegratesStale { integration: Int, source: Int, captured_against: String, repository_base: String }
  | LineStandingUnderivable { detail: String }

fn belt_line_standing(commits: List<RepositoryCommit>, head: RepositoryCommitRef) -> BeltLineStanding {
  match belt_line_integrated_sources(commits: commits, head: head) {
    LineSourcesUnreadable { detail } => LineStandingUnderivable { detail: detail }
    LineSourcesRead { sources } =>
      fold(belt_line_live_sources(sources: sources), init: LineClean, f: (acc, s) =>
        match acc {
          IntegratesStale { integration: _, source: _, captured_against: _, repository_base: _ } => acc
          LineStandingUnderivable { detail: _ } => acc
          LineClean =>
            match belt_capture_standing(commits: commits, candidate: s.source.reference) {
              CaptureOnBase => LineClean
              CaptureStandingUnderivable { detail } => LineStandingUnderivable { detail: detail }
              CaptureBaseStale { commit, captured_against, repository_base } =>
                IntegratesStale {
                  integration: minted_id_ordinal(id: s.integration.reference.identity),
                  source: commit,
                  captured_against: captured_against,
                  repository_base: repository_base,
                }
            }
        })
  }
}

fn belt_line_standing_detail(standing: BeltLineStanding) -> String? {
  match standing {
    LineClean => none
    LineStandingUnderivable { detail } => Present { value: join(["the project head's line has an underivable standing, so it is neither integrated into nor published: ", detail], "") }
    IntegratesStale { integration, source, captured_against, repository_base } =>
      Present {
        value: join([
          "IntegratesStale: the project head's line integrates a stale capture: commit ", to_string(integration),
          " squash-integrated candidate ", to_string(source), ", captured from an attempt on ", captured_against,
          " into a line based at ", repository_base,
          "; its tree is not that attempt's tree, so nothing on this line is integrated into or published until a corrective squash supersedes commit ", to_string(integration),
        ], ""),
      }
  }
}

fn belt_selected_head_line_standing(envelope: RepositoryEnvelope) -> BeltLineStanding {
  match envelope.checked_out {
    Absent => LineClean
    Present { value: h } => belt_line_standing(commits: envelope.commits, head: h)
  }
}

// ------------------------------------------------------------------------------------------------
// The legacy intake conversion (v8 -> v9, in place)
// ------------------------------------------------------------------------------------------------

// THE v8 BASE-MESSAGE CONVENTION, INVERTED ONCE AND READ ONLY HERE: the conversion is the one reader
// of the message the v8 seed wrote, and it turns it into the typed base record.
data belt_legacy_base_prefix: String = "project base: "

fn belt_legacy_base_sha(message: String) -> String? {
  if !starts_with(s: message, prefix: belt_legacy_base_prefix) {
    none
  } else {
    let sha = substring(s: message, start: string_length(s: belt_legacy_base_prefix), end: string_length(s: message))
    if sha == "" { none } else { Present { value: sha } }
  }
}

// THE CAPTURING ATTEMPT'S BASE, AS OBSERVED FOR ONE LEGACY CANDIDATE: the conversion's only effect
// besides the save. Its message names the attempt (its one producer is
// gunbc.roadmap.roadmap_belt_commit belt_candidate_commit_message), and the attempt's spawn origin
// records the base it branched from.
type BeltLegacyCaptureBase {
  commit: Int
  base: BeltBaseSha
}

fn belt_legacy_capture_base(instance: HostDashboardInstance, source: RepositoryCommit) -> BeltBaseSha {
  match belt_candidate_commit_subject(message: source.message) {
    Absent => BaseShaUnobserved { reason: join(["commit ", to_string(minted_id_ordinal(id: source.reference.identity)), "'s message '", source.message, "' names no capturing attempt"], "") }
    Present { value: subject } =>
      belt_scm_base_sha_observe(
        instance: instance,
        node_id: subject.node_id as gunbc.roadmap.roadmap_model.RoadmapNodeId,
        attempt_key: subject.attempt_key,
      )
  }
}

// THE PURE PLAN: which intake each unrecorded commit records, from the evidence observed for it. The
// unrecorded root records the base its message names; a candidate (a commit whose message its
// producer wrote) records IntakeNone when its attempt branched from that base and IntakeStaleCapture
// when it branched from another; every other commit (a squash integration) froze nothing external
// and records IntakeNone. Evidence that cannot be read refuses the WHOLE plan, by commit: a partial
// conversion would leave a line half typed, which no reader can stand on.
type BeltLegacyIntakePlan
  = LegacyIntakePlanned { records: List<LegacyIntakeRecord> }
  | LegacyIntakePlanRefused { detail: String }

type BeltLegacyPlanAcc {
  records: List<LegacyIntakeRecord>
  refused: String?
}

fn belt_legacy_intake_plan(commits: List<RepositoryCommit>, observed: List<BeltLegacyCaptureBase>) -> BeltLegacyIntakePlan {
  let unrecorded = commits |> filter(c => match c.intake {
    IntakeUnrecordedByFormat => true
    IntakeNone => false
    IntakeBase { revision: _ } => false
    IntakeAdvance { from: _, to: _ } => false
    IntakeStaleCapture { captured_against: _ } => false
  })
  let roots = unrecorded |> filter(c => match c.ancestry { RootCommit => true DescendsFrom { parent: _ } => false })
  if count(roots) != 1 {
    LegacyIntakePlanRefused { detail: join(["a pre-intake repository must hold exactly one unrecorded root commit to type as its base; this one holds ", to_string(count(roots))], "") }
  } else {
    match roots.first() {
      Absent => LegacyIntakePlanRefused { detail: "no unrecorded root commit" }
      Present { value: root } =>
        match belt_legacy_base_sha(message: root.message) {
          Absent => LegacyIntakePlanRefused { detail: join(["the root commit's message '", root.message, "' names no base"], "") }
          Present { value: base_sha } =>
            match belt_scm_intake_revision(base_sha: base_sha) {
              Absent => LegacyIntakePlanRefused { detail: join(["the root commit records '", base_sha, "', which is not a git object id"], "") }
              Present { value: base_revision } => {
                let acc = fold(unrecorded, init: BeltLegacyPlanAcc { records: [], refused: none }, f: (acc, c) =>
                  match acc.refused {
                    Present { value: _ } => acc
                    Absent =>
                      match c.ancestry {
                        RootCommit => BeltLegacyPlanAcc { records: concat([LegacyIntakeRecord { commit: c.reference, intake: IntakeBase { revision: base_revision }, work: NoWork }], acc.records), refused: none }
                        DescendsFrom { parent: _ } =>
                          match belt_candidate_commit_subject(message: c.message) {
                            Absent => BeltLegacyPlanAcc { records: concat([LegacyIntakeRecord { commit: c.reference, intake: IntakeNone, work: NoWork }], acc.records), refused: none }
                            Present { value: subject } =>
                              match (observed |> filter(o => o.commit == minted_id_ordinal(id: c.reference.identity))).first() {
                                Absent => BeltLegacyPlanAcc { records: acc.records, refused: Present { value: join(["candidate ", to_string(minted_id_ordinal(id: c.reference.identity)), "'s capture base was not observed"], "") } }
                                Present { value: o } =>
                                  match o.base {
                                    BaseShaUnobserved { reason } => BeltLegacyPlanAcc { records: acc.records, refused: Present { value: join(["candidate ", to_string(o.commit), "'s capture base is unobservable: ", reason], "") } }
                                    BaseShaObserved { base_sha: captured } =>
                                      match belt_scm_intake_revision(base_sha: captured) {
                                        Absent => BeltLegacyPlanAcc { records: acc.records, refused: Present { value: join(["candidate ", to_string(o.commit), "'s attempt records '", captured, "', which is not a git object id"], "") } }
                                        Present { value: captured_revision } =>
                                          BeltLegacyPlanAcc {
                                            records: concat([LegacyIntakeRecord {
                                              commit: c.reference,
                                              intake: if intake_revision_eq(left: captured_revision, right: base_revision) { IntakeNone } else { IntakeStaleCapture { captured_against: captured_revision } },
                                              work: match belt_capture_work(node_id: subject.node_id, attempt_key: subject.attempt_key) {
                                                Present { value: w } => WorkCapture { work: w }
                                                Absent => NoWork
                                              },
                                            }], acc.records),
                                            refused: none,
                                          }
                                      }
                                  }
                              }
                          }
                      }
                  })
                match acc.refused {
                  Present { value: detail } => LegacyIntakePlanRefused { detail: detail }
                  Absent => LegacyIntakePlanned { records: reverse(acc.records) }
                }
              }
            }
        }
    }
  }
}

// THE CONVERSION, IDEMPOTENT AND OUTSIDE A TICK. A repository with nothing unrecorded is the typed
// no-op (a re-run writes nothing). Otherwise the plan is derived from the attempts' recorded bases,
// recorded through the SCM's one admission for it (record_legacy_intakes), and saved under the
// generation the load observed, so a belt tick that moved the envelope in between refuses the write
// rather than being clobbered.
type BeltIntakeConversion
  = IntakeConverted { path: String, records: List<LegacyIntakeRecord>, head_standing: BeltLineStanding }
  | IntakeConversionNoOp { path: String }
  | IntakeConversionRefused { path: String, detail: String }

fn belt_scm_intake_convert(instance: HostDashboardInstance, project_key: String) -> BeltIntakeConversion {
  let path = belt_scm_project_repository_path(instance: instance, project_key: project_key)
  match load_repository_indexed(path: path) {
    RepositoryLoadRefused { cause } => IntakeConversionRefused { path: path, detail: belt_scm_load_refusal_detail(cause: cause) }
    RepositoryLoaded { path: _, envelope, generation } => {
      let observed = envelope.commits
        |> filter(c => match c.intake {
          IntakeUnrecordedByFormat => match belt_candidate_commit_subject(message: c.message) { Present { value: _ } => true Absent => false }
          IntakeNone => false
          IntakeBase { revision: _ } => false
          IntakeAdvance { from: _, to: _ } => false
          IntakeStaleCapture { captured_against: _ } => false
        })
        |> map(c => BeltLegacyCaptureBase { commit: minted_id_ordinal(id: c.reference.identity), base: belt_legacy_capture_base(instance: instance, source: c) })
      belt_scm_intake_convert_over(path: path, envelope: envelope, generation: GenerationExpected(generation), observed: observed)
    }
  }
}

fn belt_scm_intake_convert_over(path: String, envelope: RepositoryEnvelope, generation: RepositoryGenerationExpectation, observed: List<BeltLegacyCaptureBase>) -> BeltIntakeConversion {
  match belt_legacy_intake_plan(commits: envelope.commits, observed: observed) {
    LegacyIntakePlanRefused { detail } =>
      match record_legacy_intakes(repository: envelope, records: []) {
        LegacyIntakesNothingUnrecorded => IntakeConversionNoOp { path: path }
        LegacyIntakesRecorded { repository: _ } => IntakeConversionRefused { path: path, detail: detail }
        LegacyIntakesRefused { cause: _ } => IntakeConversionRefused { path: path, detail: detail }
      }
    LegacyIntakePlanned { records } =>
      match record_legacy_intakes(repository: envelope, records: records) {
        LegacyIntakesNothingUnrecorded => IntakeConversionNoOp { path: path }
        LegacyIntakesRefused { cause } => IntakeConversionRefused { path: path, detail: belt_legacy_intake_refusal_detail(cause: cause) }
        LegacyIntakesRecorded { repository: converted } =>
          match save_repository_sharded_guarded(path: path, repo: converted, expected: generation) {
            RepositoryGuardedSaveOutcome(RepositorySaved { path: _, written: _, generation: _ }) =>
              IntakeConverted { path: path, records: records, head_standing: belt_selected_head_line_standing(envelope: converted) }
            RepositoryGuardedSaveOutcome(RepositorySaveRefusedByCodec { path: _, cause: _ }) =>
              IntakeConversionRefused { path: path, detail: "the converted envelope could not be encoded for persistence" }
            RepositoryGuardedSaveOutcome(RepositoryFileUnwritable { path: p, error }) =>
              IntakeConversionRefused { path: path, detail: join(["the converted envelope could not be written to ", p, " (", error, ")"], "") }
            RepositoryGuardedSaveOutcome(RepositoryWriteByteCountUnrepresentable { path: _, reported }) =>
              IntakeConversionRefused { path: path, detail: join(["the envelope write reported a nonsensical byte count (", to_string(reported), ")"], "") }
            RepositoryStaleGenerationRefused { path: _, expected: _, found: _ } =>
              IntakeConversionRefused { path: path, detail: "the envelope changed on disk since the conversion loaded it; nothing was written, re-run the conversion" }
            RepositoryGuardedSaveUnobservable { path: _, error } =>
              IntakeConversionRefused { path: path, detail: join(["the on-disk envelope generation could not be observed, so the conversion refused to write unguarded: ", error], "") }
          }
      }
  }
}

fn belt_legacy_intake_refusal_detail(cause: LegacyIntakeRefusal) -> String {
  match cause {
    LegacyIntakeUnknownCommit { commit } => join(["the plan names commit ", to_string(minted_id_ordinal(id: commit.identity)), ", which the envelope does not hold"], "")
    LegacyIntakeAlreadyRecorded { commit } => join(["commit ", to_string(minted_id_ordinal(id: commit.identity)), " already records an intake"], "")
    LegacyIntakeDuplicated { commit } => join(["commit ", to_string(minted_id_ordinal(id: commit.identity)), " is planned twice"], "")
    LegacyIntakeUncovered { commit } => join(["commit ", to_string(minted_id_ordinal(id: commit.identity)), " is unrecorded and the plan does not cover it"], "")
    LegacyIntakeRootNotBase { commit } => join(["root commit ", to_string(minted_id_ordinal(id: commit.identity)), " must record a base"], "")
    LegacyIntakeBaseNotRoot { commit } => join(["commit ", to_string(minted_id_ordinal(id: commit.identity)), " is not a root and cannot record a base"], "")
    LegacyIntakeNotRecordable { commit } => join(["commit ", to_string(minted_id_ordinal(id: commit.identity)), " is planned an intake a conversion cannot record"], "")
    LegacyIntakeCensusRefused { cause: _ } => "the recorded population fails the intake census (a stale capture on its own base, a capture naming no work, or a broken line)"
  }
}

fn belt_intake_record_json(record: LegacyIntakeRecord) -> JsonValue {
  json_object(members: [
    json_kv(key: "commit", value: json_int(n: minted_id_ordinal(id: record.commit.identity))),
    json_kv(key: "intake", value: encode_commit_intake(intake: record.intake)),
  ])
}

fn belt_line_standing_json(standing: BeltLineStanding) -> JsonValue {
  match standing {
    LineClean => json_object(members: [json_kv(key: "standing", value: json_string(s: "clean"))])
    LineStandingUnderivable { detail } => json_object(members: [json_kv(key: "standing", value: json_string(s: "underivable")), json_kv(key: "detail", value: json_string(s: detail))])
    IntegratesStale { integration, source, captured_against, repository_base } =>
      json_object(members: [
        json_kv(key: "standing", value: json_string(s: "IntegratesStale")),
        json_kv(key: "integration", value: json_int(n: integration)),
        json_kv(key: "source", value: json_int(n: source)),
        json_kv(key: "captured_against", value: json_string(s: captured_against)),
        json_kv(key: "repository_base", value: json_string(s: repository_base)),
      ])
  }
}

data belt_intake_conversion_receipt_schema: String = "gunbc-belt-intake-conversion/v1"

// THE ENTRY: `GUNBC_BELT_INSTANCE_ID=<instance> gunbc run --source-root dag --source-root src/v2
// --entry dag/gunbc/roadmap/roadmap_belt_actuate.dag --function belt_scm_intake_convert_cli
// --arg project_key=<project> --arg receipt_path=<receipt>`. The receipt names every recorded intake
// and the head line's standing after conversion.
fn belt_scm_intake_convert_cli(project_key: String, receipt_path: String) -> ProcessExit {
  match belt_dispatch_instance_cli() {
    Absent => exit_failure(reason: "belt_scm_intake_convert_cli: GUNBC_BELT_INSTANCE_ID names no admitted instance (fail-closed)")
    Present { value: instance } => {
      let outcome = belt_scm_intake_convert(instance: instance, project_key: project_key)
      let document = serialize_json(v: match outcome {
        IntakeConverted { path, records, head_standing } =>
          json_object(members: [
            json_kv(key: "schema", value: json_string(s: belt_intake_conversion_receipt_schema)),
            json_kv(key: "status", value: json_string(s: "converted")),
            json_kv(key: "path", value: json_string(s: path)),
            json_kv(key: "records", value: json_array(elements: map(records, r => belt_intake_record_json(record: r)))),
            json_kv(key: "head", value: belt_line_standing_json(standing: head_standing)),
          ])
        IntakeConversionNoOp { path } =>
          json_object(members: [
            json_kv(key: "schema", value: json_string(s: belt_intake_conversion_receipt_schema)),
            json_kv(key: "status", value: json_string(s: "noop")),
            json_kv(key: "path", value: json_string(s: path)),
          ])
        IntakeConversionRefused { path, detail } =>
          json_object(members: [
            json_kv(key: "schema", value: json_string(s: belt_intake_conversion_receipt_schema)),
            json_kv(key: "status", value: json_string(s: "refused")),
            json_kv(key: "path", value: json_string(s: path)),
            json_kv(key: "detail", value: json_string(s: detail)),
          ])
      })
      let w = Filesystem.Write(path: receipt_path, content: document)
      if !w.success {
        exit_failure(reason: join(["belt_scm_intake_convert_cli: receipt could not be written: ", w.error, "; result was ", document], ""))
      } else {
        match outcome {
          IntakeConversionRefused { path: _, detail } => exit_failure(reason: join(["belt_scm_intake_convert_cli: refused: ", detail], ""))
          IntakeConverted { path: _, records: _, head_standing: _ } => ExitSuccess
          IntakeConversionNoOp { path: _ } => ExitSuccess
        }
      }
    }
  }
}

// THE CORRECTIVE INTEGRATION ENTRY (parent ruling on gunbc#13402): squash a fresh recapture into the
// project's integration head, recording the stale integration it supersedes, outside a tick. The
// supersession's guards are the SCM's admission (exact stale integration, on the head's line, not yet
// superseded, fresh source); the merge sides are materialized from their own shards as the integrate
// pass materializes them; the save is guarded by the generation the load observed. Invocation:
// `GUNBC_BELT_INSTANCE_ID=<instance> gunbc run --source-root dag --source-root src/v2 --entry
// dag/gunbc/roadmap/roadmap_belt_actuate.dag --function belt_scm_corrective_integrate_cli
// --arg project_key=<project> --arg source=<recapture ordinal> --arg supersedes=<stale integration
// ordinal> --arg receipt_path=<receipt>`.
type BeltCorrectiveIntegration
  = CorrectivelyIntegrated { head: Int, head_standing: BeltLineStanding }
  | CorrectiveIntegrationRefused { detail: String }

fn belt_supersession_refusal_detail(cause: SupersessionRefusal) -> String {
  match cause {
    SupersessionNotAnIntegration { named } => join(["commit ", to_string(minted_id_ordinal(id: named.identity)), " integrated nothing, so there is nothing to supersede"], "")
    SupersessionStaleIntegrationIsARoot { named } => join(["commit ", to_string(minted_id_ordinal(id: named.identity)), " is a root, so there is no line before it to correct onto"], "")
    SupersessionNotStale { named } => join(["commit ", to_string(minted_id_ordinal(id: named.identity)), " integrated a capture that is not stale"], "")
    SupersessionAlreadySuperseded { named, by } => join(["commit ", to_string(minted_id_ordinal(id: named.identity)), " is already superseded by commit ", to_string(minted_id_ordinal(id: by.identity))], "")
    SupersessionSourceNotFresh { source } => join(["source ", to_string(minted_id_ordinal(id: source.identity)), " is not a fresh capture against its own intake"], "")
    SupersessionSourceNotACapture { source } => join(["commit ", to_string(minted_id_ordinal(id: source.identity)), " is not a capture, so it cannot be a recapture of anything"], "")
    SupersessionWorkMismatch { stale, source } => join(["source ", to_string(minted_id_ordinal(id: source.identity)), " does not capture the work stale capture ", to_string(minted_id_ordinal(id: stale.identity)), " captured, so it is not its recapture"], "")
    SupersessionMergeBaseRefused { refusal: _ } => "the recapture and the line before the stale integration share no derivable merge base"
  }
}

fn belt_scm_corrective_integrate(path: String, source: Int, supersedes: Int, message: String) -> BeltCorrectiveIntegration {
  match load_repository_indexed(path: path) {
    RepositoryLoadRefused { cause } => CorrectiveIntegrationRefused { detail: belt_scm_load_refusal_detail(cause: cause) }
    RepositoryLoaded { path: _, envelope, generation } =>
      match envelope.checked_out {
        Absent => CorrectiveIntegrationRefused { detail: "the project envelope selects no integration head" }
        Present { value: head } => {
          let candidate = RepositoryCommitRef { identity: MintedId { ordinal: source } }
          let stale = RepositoryCommitRef { identity: MintedId { ordinal: supersedes } }
          if !repository_commit_ref_eq(left: head, right: stale) {
            CorrectiveIntegrationRefused { detail: join(["the integration head is commit ", to_string(minted_id_ordinal(id: head.identity)), ", not the stale integration ", to_string(supersedes), "; a correction is admitted only while the stale integration is the head"], "") }
          } else {
            match commit_at_reference(commits: envelope.commits, reference: stale) {
              Absent => CorrectiveIntegrationRefused { detail: "the stale integration is not a commit of its own envelope" }
              Present { value: stale_commit } =>
                match stale_commit.ancestry {
                  RootCommit => CorrectiveIntegrationRefused { detail: "the stale integration is a root, so there is no line before it to correct onto" }
                  DescendsFrom { parent: stale_parent } =>
          match belt_integrate_materialize_sides(path: path, envelope: envelope, head: stale_parent, candidate: candidate) {
            DeltaResidentRefused { detail } => CorrectiveIntegrationRefused { detail: join(["a merge side's manifest could not be read from its shard: ", detail], "") }
            DeltaResident { store: sides } =>
              match fanin_correct_integration(
                repository: RepositoryEnvelope { store: sides, commits: envelope.commits, commit_allocator: envelope.commit_allocator, checked_out: envelope.checked_out, staged: envelope.staged },
                supersedes: stale,
                candidate: candidate,
                message: message,
              ) {
                FaninSupersessionRefused { cause } => CorrectiveIntegrationRefused { detail: join(["the supersession is refused: ", belt_supersession_refusal_detail(cause: cause)], "") }
                FaninCorrected(outcome) =>
                  match outcome {
                    FaninAlreadyIntegrated { head: _ } => CorrectiveIntegrationRefused { detail: "the source is already integrated on this line" }
                    FaninConflicted { conflicts } => CorrectiveIntegrationRefused { detail: join(["the corrective squash conflicts on ", to_string(count(conflicts)), " path(s); an owner must resolve them"], "") }
                    FaninRefused { detail } => CorrectiveIntegrationRefused { detail: detail }
                    FaninIntegrated { repository: advanced, head: new_head } => {
                      let moved = RepositoryEnvelope { store: advanced.store, commits: advanced.commits, commit_allocator: advanced.commit_allocator, checked_out: Present { value: new_head }, staged: advanced.staged }
                      match save_repository_sharded_guarded(path: path, repo: moved, expected: GenerationExpected(generation)) {
                        RepositoryGuardedSaveOutcome(RepositorySaved { path: _, written: _, generation: _ }) =>
                          CorrectivelyIntegrated { head: minted_id_ordinal(id: new_head.identity), head_standing: belt_line_standing(commits: moved.commits, head: new_head) }
                        RepositoryGuardedSaveOutcome(RepositorySaveRefusedByCodec { path: _, cause: _ }) => CorrectiveIntegrationRefused { detail: "the corrective squash was merged but the envelope could not be encoded" }
                        RepositoryGuardedSaveOutcome(RepositoryFileUnwritable { path: p, error }) => CorrectiveIntegrationRefused { detail: join(["the envelope could not be written to ", p, " (", error, ")"], "") }
                        RepositoryGuardedSaveOutcome(RepositoryWriteByteCountUnrepresentable { path: _, reported }) => CorrectiveIntegrationRefused { detail: join(["the envelope write reported a nonsensical byte count (", to_string(reported), ")"], "") }
                        RepositoryStaleGenerationRefused { path: _, expected: _, found: _ } => CorrectiveIntegrationRefused { detail: "the envelope changed on disk since it was loaded; nothing was written" }
                        RepositoryGuardedSaveUnobservable { path: _, error } => CorrectiveIntegrationRefused { detail: join(["the on-disk generation could not be observed: ", error], "") }
                      }
                    }
                  }
              }
          }
                }
            }
          }
        }
      }
  }
}

fn belt_scm_corrective_integrate_cli(project_key: String, source: Int, supersedes: Int, receipt_path: String) -> ProcessExit {
  match belt_dispatch_instance_cli() {
    Absent => exit_failure(reason: "belt_scm_corrective_integrate_cli: GUNBC_BELT_INSTANCE_ID names no admitted instance (fail-closed)")
    Present { value: instance } => {
      let path = belt_scm_project_repository_path(instance: instance, project_key: project_key)
      let outcome = belt_scm_corrective_integrate(path: path, source: source, supersedes: supersedes, message: join(["corrective integration into ", project_key, ": candidate ", to_string(source), " supersedes commit ", to_string(supersedes)], ""))
      let document = serialize_json(v: match outcome {
        CorrectivelyIntegrated { head, head_standing } =>
          json_object(members: [
            json_kv(key: "schema", value: json_string(s: "gunbc-belt-corrective-integration/v1")),
            json_kv(key: "status", value: json_string(s: "integrated")),
            json_kv(key: "path", value: json_string(s: path)),
            json_kv(key: "head", value: json_int(n: head)),
            json_kv(key: "head_standing", value: belt_line_standing_json(standing: head_standing)),
          ])
        CorrectiveIntegrationRefused { detail } =>
          json_object(members: [
            json_kv(key: "schema", value: json_string(s: "gunbc-belt-corrective-integration/v1")),
            json_kv(key: "status", value: json_string(s: "refused")),
            json_kv(key: "path", value: json_string(s: path)),
            json_kv(key: "detail", value: json_string(s: detail)),
          ])
      })
      let w = Filesystem.Write(path: receipt_path, content: document)
      if !w.success {
        exit_failure(reason: join(["belt_scm_corrective_integrate_cli: receipt could not be written: ", w.error, "; result was ", document], ""))
      } else {
        match outcome {
          CorrectiveIntegrationRefused { detail } => exit_failure(reason: join(["belt_scm_corrective_integrate_cli: refused: ", detail], ""))
          CorrectivelyIntegrated { head: _, head_standing: _ } => ExitSuccess
        }
      }
    }
  }
}

// THE RECAPTURE ENTRY. A committed attempt's tree is captured against its recorded spawn base
// (BaseAdvance) as a fresh CaptureWork of the same unit and attempt, without creating a git commit
// -- the realization already exists. The tick's capture fires only while the worktree is dirty;
// once commit-outcome is skipped: worktree clean, this is the only producer a corrective integrate
// can name as --arg source. THE HEAD MUST BE THE ATTEMPT'S OWN RECORDED SUBMISSION, READ AT THE
// SAME ADDRESS VERIFICATION AND THE DASHBOARD USE: belt_submission_capture_for_head. CaptureForHead
// proceeds; CaptureAbsent refuses; CaptureUnreadable poisons and is never read as absence.
// Invocation:
// `GUNBC_BELT_INSTANCE_ID=<instance> gunbc run --source-root dag --source-root src/v2 --entry
// dag/gunbc/roadmap/roadmap_belt_actuate.dag --function belt_scm_recapture_cli
// --arg project_key=<project> --arg node_id=<node> --arg attempt_key=<key> --arg receipt_path=<receipt>`.
type BeltRecapturePreconditions
  = RecaptureAdmitted { head_sha: String, base_sha: String }
  | RecaptureWorktreeDirty
  | RecaptureHasNoCommittedRevision { detail: String }
  | RecaptureBaseUnobservable { detail: String }

fn belt_scm_recapture_preconditions(
  porcelain_nul: String,
  head: WorktreeHeadObservation,
  base: BeltBaseSha,
) -> BeltRecapturePreconditions {
  if porcelain_nul != "" {
    RecaptureWorktreeDirty
  } else {
    match head {
      WorktreeHeadUnobserved { reason } => RecaptureHasNoCommittedRevision { detail: reason }
      WorktreeHeadObserved { revision } =>
        match base {
          BaseShaUnobserved { reason } => RecaptureBaseUnobservable { detail: reason }
          BaseShaObserved { base_sha } => RecaptureAdmitted { head_sha: revision as String, base_sha: base_sha }
        }
    }
  }
}

type RecaptureCaptureGate
  = RecaptureCaptureProceeds { capture: SubmissionCapture }
  | RecaptureCaptureRefused { detail: String }
  | RecaptureCapturePoisoned { detail: String }

data recapture_capture_absent_detail: String = "no submission capture binds this HEAD: recapture stamps CaptureWork only onto the attempt's durable capture at this head's own address"

fn belt_scm_recapture_capture_gate(observation: SubmissionCaptureObservation) -> RecaptureCaptureGate {
  match observation {
    CaptureForHead { capture } => RecaptureCaptureProceeds { capture: capture }
    CaptureAbsent => RecaptureCaptureRefused { detail: recapture_capture_absent_detail }
    CaptureNotAttempted { reason } => RecaptureCaptureRefused { detail: join([recapture_capture_absent_detail, " (the attempt's capture is still owed: ", reason, ")"], "") }
    CaptureUnreadable { reason } => RecaptureCapturePoisoned { detail: reason }
  }
}

type BeltRecapture
  = Recaptured { commit_ordinal: Int, repository_path: String }
  | RecaptureRefused { detail: String }
  | RecapturePoisoned { detail: String }

fn belt_scm_recapture(
  instance: HostDashboardInstance,
  project_key: String,
  node_id: String,
  attempt_key: String,
) -> BeltRecapture {
  match project_key_for_node(node_id: node_id, memberships: roadmap_memberships()) {
    Absent => RecapturePoisoned { detail: "multiple authored parents name this node; project ownership is ambiguous" }
    Present { value: derived } =>
      if derived != project_key {
        RecaptureRefused {
          detail: join(["project_key ", project_key, " is not the envelope of node ", node_id, " (derived key ", derived, ")"], ""),
        }
      } else {
        let worktree = dispatch_worktree_path_for_instance(
          instance: instance,
          node_id: node_id as RoadmapNodeId,
          attempt_key: attempt_key,
        )
        match belt_commit_git(instance: instance, worktree: worktree, args: shape_git_status_porcelain_nul_args()) {
          ExecFailed { program, exit_code, stderr } =>
            RecaptureRefused { detail: belt_commit_exec_detail(step: "status", outcome: ExecFailed { program: program, exit_code: exit_code, stderr: stderr }) }
          ExecRefused { program, reason } =>
            RecaptureRefused { detail: belt_commit_exec_detail(step: "status", outcome: ExecRefused { program: program, reason: reason }) }
          ExecOk { stdout } =>
            match belt_scm_recapture_preconditions(
              porcelain_nul: stdout,
              head: belt_worktree_head_observe(instance: instance, worktree: worktree),
              base: belt_scm_base_sha_observe(instance: instance, node_id: node_id as RoadmapNodeId, attempt_key: attempt_key),
            ) {
              RecaptureWorktreeDirty =>
                RecaptureRefused { detail: "the attempt worktree is dirty: recapture reads the committed tree, and a dirty tree is the tick's capture job" }
              RecaptureHasNoCommittedRevision { detail } =>
                RecaptureRefused { detail: join(["the attempt has no committed revision: ", detail], "") }
              RecaptureBaseUnobservable { detail } => RecapturePoisoned { detail: detail }
              RecaptureAdmitted { head_sha, base_sha: _ } =>
                match belt_scm_recapture_capture_gate(observation: belt_submission_capture_for_head(
                  instance: instance,
                  worktree: worktree,
                  node_id: node_id as RoadmapNodeId, attempt_key: attempt_key,
                  head_sha: head_sha,
                )) {
                  RecaptureCaptureRefused { detail } => RecaptureRefused { detail: detail }
                  RecaptureCapturePoisoned { detail } => RecapturePoisoned { detail: detail }
                  RecaptureCaptureProceeds { capture: _ } =>
                match belt_scm_capture_candidate_tree(
                  instance: instance,
                  worktree: worktree,
                  node_id: node_id as RoadmapNodeId,
                  attempt_key: attempt_key,
                  message: belt_candidate_commit_message(node_id: node_id, attempt_key: attempt_key) as String,
                  committed_revision: Present { value: head_sha },
                ) {
                  ScmCaptureMintRefused { detail } => RecaptureRefused { detail: detail }
                  ScmCaptureMintPoisoned { detail } => RecapturePoisoned { detail: detail }
                  ScmCandidateMinted { repository, generation, path, commit_ordinal, commit_root_locator } =>
                    match belt_capture_standing(
                      commits: repository.commits,
                      candidate: RepositoryCommitRef { identity: MintedId { ordinal: commit_ordinal } },
                    ) {
                      CaptureStandingUnderivable { detail } => RecapturePoisoned { detail: detail }
                      CaptureBaseStale { commit: _, captured_against: _, repository_base: _ } =>
                        RecaptureRefused {
                          detail: belt_supersession_refusal_detail(cause: SupersessionSourceNotFresh {
                            source: RepositoryCommitRef { identity: MintedId { ordinal: commit_ordinal } },
                          }),
                        }
                      CaptureOnBase =>
                        match belt_scm_persist_capture(mint: ScmCandidateMinted {
                          repository: repository,
                          generation: generation,
                          path: path,
                          commit_ordinal: commit_ordinal,
                          commit_root_locator: commit_root_locator,
                        }) {
                          ScmCaptureRefused { detail } => RecaptureRefused { detail: detail }
                          ScmCapturePoisoned { detail } => RecapturePoisoned { detail: detail }
                          ScmCandidateCaptured { repository_path, commit_ordinal: saved, commit_root_locator: _ } =>
                            Recaptured { commit_ordinal: saved, repository_path: repository_path }
                        }
                    }
                }
                }
            }
        }
      }
  }
}

data belt_recapture_receipt_schema: String = "gunbc-belt-recapture/v1"

fn belt_scm_recapture_cli(project_key: String, node_id: String, attempt_key: String, receipt_path: String) -> ProcessExit {
  match belt_dispatch_instance_cli() {
    Absent => exit_failure(reason: "belt_scm_recapture_cli: GUNBC_BELT_INSTANCE_ID names no admitted instance (fail-closed)")
    Present { value: instance } => {
      let outcome = belt_scm_recapture(instance: instance, project_key: project_key, node_id: node_id, attempt_key: attempt_key)
      let document = serialize_json(v: match outcome {
        Recaptured { commit_ordinal, repository_path } =>
          json_object(members: [
            json_kv(key: "schema", value: json_string(s: belt_recapture_receipt_schema)),
            json_kv(key: "status", value: json_string(s: "recaptured")),
            json_kv(key: "path", value: json_string(s: repository_path)),
            json_kv(key: "commit_ordinal", value: json_int(n: commit_ordinal)),
          ])
        RecaptureRefused { detail } =>
          json_object(members: [
            json_kv(key: "schema", value: json_string(s: belt_recapture_receipt_schema)),
            json_kv(key: "status", value: json_string(s: "refused")),
            json_kv(key: "detail", value: json_string(s: detail)),
          ])
        RecapturePoisoned { detail } =>
          json_object(members: [
            json_kv(key: "schema", value: json_string(s: belt_recapture_receipt_schema)),
            json_kv(key: "status", value: json_string(s: "poisoned")),
            json_kv(key: "detail", value: json_string(s: detail)),
          ])
      })
      let w = Filesystem.Write(path: receipt_path, content: document)
      if !w.success {
        exit_failure(reason: join(["belt_scm_recapture_cli: receipt could not be written: ", w.error, "; result was ", document], ""))
      } else {
        match outcome {
          RecaptureRefused { detail } => exit_failure(reason: join(["belt_scm_recapture_cli: refused: ", detail], ""))
          RecapturePoisoned { detail } => exit_failure(reason: join(["belt_scm_recapture_cli: poisoned: ", detail], ""))
          Recaptured { commit_ordinal: _, repository_path: _ } => ExitSuccess
        }
      }
    }
  }
}

fn belt_integrate_into_envelope(
  instance: HostDashboardInstance,
  worktree: String,
  capture: SubmissionCapture,
  project_key: String,
  dir: String,
) -> BeltEnvelopeIntegration {
  match load_repository_indexed(path: capture.scm_repository) {
    RepositoryLoadRefused { cause } =>
      EnvelopeIntegrationUnreadable { detail: belt_scm_load_refusal_detail(cause: cause) }
    RepositoryLoaded { path: _, envelope, generation } =>
      let candidate = RepositoryCommitRef { identity: MintedId { ordinal: capture.scm_commit_ordinal } }
      match belt_capture_standing(commits: envelope.commits, candidate: candidate) {
        CaptureStandingUnderivable { detail } =>
          EnvelopeIntegrationUnreadable { detail: belt_capture_underivable_detail(detail: detail) }
        CaptureBaseStale { commit, captured_against, repository_base } => {
          let detail = belt_capture_base_stale_detail(commit: commit, captured_against: captured_against, repository_base: repository_base)
          match belt_integration_receipt_record_state(instance: instance, worktree: worktree, dir: dir, capture: capture, project_key: project_key, state: IntegrationBlocked { detail: detail }) {
            IntegrationReceiptRecorded => EnvelopeIntegrationBlocked { detail: detail }
            IntegrationReceiptRecordFailed { detail: d } => EnvelopeIntegrationUnreadable { detail: d }
          }
        }
        CaptureOnBase => {
      match belt_line_standing_detail(standing: belt_selected_head_line_standing(envelope: envelope)) {
        Present { value: line_detail } => EnvelopeIntegrationUnreadable { detail: line_detail }
        Absent =>
      match envelope.checked_out {
        Absent =>
          EnvelopeIntegrationUnreadable {
            detail: "the project envelope selects no integration head, so there is nothing to merge the candidate into",
          }
        Present { value: head } =>
          if repository_commit_ref_eq(left: head, right: candidate) {
            match belt_integration_receipt_record_state(instance: instance, worktree: worktree, dir: dir, capture: capture, project_key: project_key, state: IntegrationIntegrated) {
              IntegrationReceiptRecorded => EnvelopeIntegrated
              IntegrationReceiptRecordFailed { detail } => EnvelopeIntegrationUnreadable { detail: detail }
            }
          } else {
            match submission_capture_binding_refusal(capture: capture, commits: envelope.commits) {
              Present { value: CaptureBindingMismatch { claimed, actual } } => {
                let detail = join([
                  "capture binding mismatch: the capture records root locator ", claimed,
                  " but commit ", to_string(capture.scm_commit_ordinal), " of the loaded envelope freezes root locator ",
                  actual, "; the candidate is not integrated because the envelope cannot authenticate it",
                ], "")
                match belt_integration_receipt_record_state(instance: instance, worktree: worktree, dir: dir, capture: capture, project_key: project_key, state: IntegrationBlocked { detail: detail }) {
                  IntegrationReceiptRecorded => EnvelopeIntegrationBlocked { detail: detail }
                  IntegrationReceiptRecordFailed { detail: d } => EnvelopeIntegrationUnreadable { detail: d }
                }
              }
              Present { value: CaptureBindingUnverifiable } => {
                let detail = join([
                  "the capture record predates the root-locator binding (schema ",
                  "roadmap-submission-capture/v2), so the capture cannot be authenticated against its commit: binding unverifiable",
                ], "")
                match belt_integration_receipt_record_state(instance: instance, worktree: worktree, dir: dir, capture: capture, project_key: project_key, state: IntegrationBlocked { detail: detail }) {
                  IntegrationReceiptRecorded => EnvelopeIntegrationBlocked { detail: detail }
                  IntegrationReceiptRecordFailed { detail: d } => EnvelopeIntegrationUnreadable { detail: d }
                }
              }
              Absent =>
            match belt_integrate_materialize_sides(path: capture.scm_repository, envelope: envelope, head: head, candidate: candidate) {
              DeltaResidentRefused { detail } =>
                EnvelopeIntegrationUnreadable { detail: join(["a merge side's manifest could not be read from its shard: ", detail], "") }
              DeltaResident { store: sides } =>
            match fanin_integrate_candidate(
              repository: RepositoryEnvelope {
                store: sides,
                commits: envelope.commits,
                commit_allocator: envelope.commit_allocator,
                checked_out: envelope.checked_out,
                staged: envelope.staged,
              },
              integration_head: head,
              candidate: candidate,
              message: join(["integrate ", capture.head_sha, " into ", project_key], ""),
            ) {
              FaninAlreadyIntegrated { head: _ } =>
                match belt_integration_receipt_record_state(instance: instance, worktree: worktree, dir: dir, capture: capture, project_key: project_key, state: IntegrationIntegrated) {
                  IntegrationReceiptRecorded => EnvelopeIntegrated
                  IntegrationReceiptRecordFailed { detail } => EnvelopeIntegrationUnreadable { detail: detail }
                }
              FaninIntegrated { repository: advanced, head: new_head } => {
                let moved = RepositoryEnvelope {
                  store: advanced.store,
                  commits: advanced.commits,
                  commit_allocator: advanced.commit_allocator,
                  checked_out: Present { value: new_head },
                  staged: advanced.staged,
                }
                match save_repository_sharded_guarded(path: capture.scm_repository, repo: moved, expected: GenerationExpected(generation)) {
                  RepositoryGuardedSaveOutcome(RepositorySaved { path: _, written: _, generation: _ }) =>
                    match belt_integration_receipt_record_state(instance: instance, worktree: worktree, dir: dir, capture: capture, project_key: project_key, state: IntegrationIntegrated) {
                      IntegrationReceiptRecorded => EnvelopeIntegrated
                      IntegrationReceiptRecordFailed { detail } => EnvelopeIntegrationUnreadable { detail: detail }
                    }
                  RepositoryGuardedSaveOutcome(RepositorySaveRefusedByCodec { path: _, cause: _ }) =>
                    EnvelopeIntegrationUnreadable {
                      detail: "the candidate was merged but the envelope could not be encoded for persistence; the merge must be re-derived on the next tick",
                    }
                  RepositoryGuardedSaveOutcome(RepositoryFileUnwritable { path: p, error }) =>
                    EnvelopeIntegrationUnreadable {
                      detail: join(["the candidate was merged but the envelope could not be written to ", p, " (", error, ")"], ""),
                    }
                  RepositoryGuardedSaveOutcome(RepositoryWriteByteCountUnrepresentable { path: _, reported }) =>
                    EnvelopeIntegrationUnreadable {
                      detail: join(["the envelope write reported a nonsensical byte count (", to_string(reported), ")"], ""),
                    }
                  RepositoryStaleGenerationRefused { path: _, expected: _, found: _ } =>
                    EnvelopeIntegrationUnreadable {
                      detail: "the project envelope changed on disk between this tick's load and the integrate's save; the in-memory merge is discarded and re-derived on the next tick against the envelope that is actually there",
                    }
                  RepositoryGuardedSaveUnobservable { path: _, error } =>
                    EnvelopeIntegrationUnreadable {
                      detail: join(["the on-disk envelope generation could not be observed, so the integrate refused to write unguarded: ", error], ""),
                    }
                }
              }
              FaninConflicted { conflicts } => {
                let detail = join([
                  to_string(count(conflicts)), " conflicting path(s): ",
                  join(map(conflicts, c => c.path as String), ", "),
                ], "")
                match belt_integration_receipt_record_state(instance: instance, worktree: worktree, dir: dir, capture: capture, project_key: project_key, state: IntegrationBlocked { detail: detail }) {
                  IntegrationReceiptRecorded => EnvelopeIntegrationBlocked { detail: detail }
                  IntegrationReceiptRecordFailed { detail: d } => EnvelopeIntegrationUnreadable { detail: d }
                }
              }
              FaninRefused { detail } => EnvelopeIntegrationUnreadable { detail: detail }
            }
            }
            }
          }
      }
      }
    }
      }
  }
}

type BeltIntegrationStep
  = IntegrationStepDeferred { reason: String }
  | IntegrationStepUnreadable { detail: String }
  | IntegrationStepBlocked { detail: String }
  | IntegrationStepReady { project_key: String, integrated: Int, members: Int }

type BeltIntegrationCoreStep
  = IntegrationCoreDeferred { reason: String }
  | IntegrationCoreUnreadable { detail: String }
  | IntegrationCoreBlocked { detail: String }
  | IntegrationCoreIntegrated { project_key: String }

// THE CAPTURE GATE OF THE INTEGRATE STEP, pure so a witness reaches every arm with a supplied
// observation. Only a capture the shared classifier (gunbc.roadmap.roadmap_submission
// submission_candidacy) admits as a candidate advances to the verification read; a blocked or
// needs-context declaration defers exactly as the verify pass defers it (belt_verify_capture_gate),
// never reaching a selection the verify pass will by design never write.
type BeltIntegrationCaptureGate
  = IntegrationCaptureAdvances { capture: SubmissionCapture }
  | IntegrationCaptureStops { step: BeltIntegrationCoreStep }

fn belt_integration_capture_gate(capture: SubmissionCaptureObservation) -> BeltIntegrationCaptureGate {
  match capture {
    CaptureAbsent =>
      IntegrationCaptureStops {
        step: IntegrationCoreDeferred { reason: "no submission capture binds this head, so there is no candidate to integrate" },
      }
    CaptureNotAttempted { reason } =>
      IntegrationCaptureStops {
        step: IntegrationCoreDeferred { reason: join(["no submission capture binds this head yet, so there is no candidate to integrate: ", reason], "") },
      }
    CaptureUnreadable { reason } =>
      IntegrationCaptureStops { step: IntegrationCoreUnreadable { detail: reason } }
    CaptureForHead { capture: c } =>
      match submission_candidacy(submission: c.submission) {
        SubmissionNotCandidate { reason } =>
          IntegrationCaptureStops { step: IntegrationCoreDeferred { reason: reason } }
        SubmissionIsCandidate => IntegrationCaptureAdvances { capture: c }
      }
  }
}

// THE PER-ITEM INTEGRATE, census-free. The integration receipt at the attempt's own head answers
// first: a recorded verdict there is durable (the same head merges to the same answer), so a
// repeat wake-up is a typed no-op that never touches the project envelope. Only an un-integrated
// candidate pays the envelope load, and only its own project's.
fn belt_integrate_candidate_core_for_instance(
  instance: HostDashboardInstance,
  node_id: String,
  attempt_key: String,
) -> BeltIntegrationCoreStep {
  if project_key_for_node(node_id: node_id, memberships: roadmap_memberships()) == none {
    IntegrationCoreUnreadable { detail: "project nesting is ambiguous or cyclic" }
  } else {

  let worktree = dispatch_worktree_path_for_instance(
    instance: instance,
    node_id: node_id as gunbc.roadmap.roadmap_model.RoadmapNodeId,
    attempt_key: attempt_key,
  )
  match belt_worktree_head_observe(instance: instance, worktree: worktree) {
    WorktreeHeadUnobserved { reason } => IntegrationCoreDeferred { reason: reason }
    WorktreeHeadObserved { revision } =>
      match belt_integration_receipt_observe(
        instance: instance,
        worktree: worktree,
        dir: belt_attempt_integration_dir_for_instance(
          instance: instance,
          node_id: node_id as gunbc.roadmap.roadmap_model.RoadmapNodeId,
          attempt_key: attempt_key,
        ),
        head_sha: revision as String,
      ) {
        IntegrationReceiptUnreadable { reason } => IntegrationCoreUnreadable { detail: reason }
        IntegrationReceiptForHead { receipt } =>
          match receipt.state {
            IntegrationIntegrated =>
              IntegrationCoreIntegrated { project_key: receipt.project }
            IntegrationBlocked { detail } => IntegrationCoreBlocked { detail: detail }
          }
        IntegrationReceiptAbsent =>
      match belt_integration_capture_gate(capture: belt_submission_capture_for_head(
        instance: instance,
        worktree: worktree,
        node_id: node_id as gunbc.roadmap.roadmap_model.RoadmapNodeId, attempt_key: attempt_key,
        head_sha: revision as String,
      )) {
        IntegrationCaptureStops { step } => step
        IntegrationCaptureAdvances { capture } =>
          match belt_candidate_verification_passed(
            instance: instance,
            node_id: node_id,
            attempt_key: attempt_key,
            head_sha: revision as String,
          ) {
            VerificationNotPassed { reason } => IntegrationCoreDeferred { reason: reason }
            VerificationUnreadable { reason } => IntegrationCoreUnreadable { detail: reason }
            VerificationPassedConfirmed => {
              let edges = declared_roadmap_edges()
              match node_project_membership(node_id: node_id, memberships: roadmap_memberships()) {
                MembershipAmbiguous { arcs: _ } =>
                  IntegrationCoreUnreadable {
                    detail: "multiple authored parents name this node; project ownership is ambiguous",
                  }
                membership => {
                  let project_key = match membership {
                    MembershipStandalone => node_id
                    MembershipMember { arc } => arc
                    MembershipAmbiguous { arcs: _ } => node_id
                  }
                  match belt_integrate_into_envelope(
                    instance: instance,
                    worktree: worktree,
                    capture: capture,
                    project_key: project_key,
                    dir: belt_attempt_integration_dir_for_instance(
                      instance: instance,
                      node_id: node_id as gunbc.roadmap.roadmap_model.RoadmapNodeId,
                      attempt_key: attempt_key,
                    ),
                  ) {
                    EnvelopeIntegrationUnreadable { detail } => IntegrationCoreUnreadable { detail: detail }
                    EnvelopeIntegrationBlocked { detail } => IntegrationCoreBlocked { detail: detail }
                    EnvelopeIntegrated => IntegrationCoreIntegrated { project_key: project_key }
                  }
                }
              }
            }
          }
        }
      }
  }
  }
}

fn belt_integrate_candidate_for_instance(
  instance: HostDashboardInstance,
  node_id: String,
  attempt_key: String,
) -> BeltIntegrationStep {
  match belt_integrate_candidate_core_for_instance(instance: instance, node_id: node_id, attempt_key: attempt_key) {
    IntegrationCoreDeferred { reason } => IntegrationStepDeferred { reason: reason }
    IntegrationCoreUnreadable { detail } => IntegrationStepUnreadable { detail: detail }
    IntegrationCoreBlocked { detail } => IntegrationStepBlocked { detail: detail }
    IntegrationCoreIntegrated { project_key } => {
      let edges = declared_roadmap_edges()
      let members = match node_project_membership(node_id: node_id, memberships: roadmap_memberships()) {
        MembershipStandalone => [node_id]
        MembershipMember { arc } => project_member_ids(arc: arc, memberships: roadmap_memberships())
        MembershipAmbiguous { arcs: _ } => [node_id]
      }
      match belt_integration_census(instance: instance, member_ids: members) {
        CensusUnreadable { detail } => IntegrationStepUnreadable { detail: detail }
        CensusCounted { integrated, blocked: _ } =>
          IntegrationStepReady {
            project_key: project_key,
            integrated: integrated,
            members: count(members),
          }
      }
    }
  }
}

// THE k-OF-n CENSUS, derived from the per-attempt integration receipts: a member counts as
// integrated when its CURRENT attempt's head carries an integrated receipt. Cheap to read, and a
// restart changes nothing because the receipts are the record.
type BeltIntegrationCensus
  = CensusCounted { integrated: Int, blocked: List<String> }
  | CensusUnreadable { detail: String }

fn belt_integration_census(instance: HostDashboardInstance, member_ids: List<String>) -> BeltIntegrationCensus {
  match belt_workflow_attempts_observe_for_instance(instance: instance) {
    WorkflowAttemptsRefused { reason } =>
      CensusUnreadable { detail: join(["the attempts ledger is unobservable, so the project's integration standing is unknown: ", reason], "") }
    WorkflowAttemptsObserved { attempts } => {
      let states = map(member_ids, member => {
        let progresses = attempts |> filter(p => p.node_id == member)
        match progresses.first() {
          Absent => MemberCensusPending { node_id: member }
          Present { value: progress } =>
            match belt_worktree_head_observe(
              instance: instance,
              worktree: dispatch_worktree_path_for_instance(
                instance: instance,
                node_id: member as gunbc.roadmap.roadmap_model.RoadmapNodeId,
                attempt_key: progress.attempt_key,
              ),
            ) {
              WorktreeHeadUnobserved { reason: _ } => MemberCensusPending { node_id: member }
              WorktreeHeadObserved { revision } =>
                match belt_integration_receipt_observe(
                  instance: instance,
                  worktree: dispatch_worktree_path_for_instance(
                    instance: instance,
                    node_id: member as gunbc.roadmap.roadmap_model.RoadmapNodeId,
                    attempt_key: progress.attempt_key,
                  ),
                  dir: belt_attempt_integration_dir_for_instance(
                    instance: instance,
                    node_id: member as gunbc.roadmap.roadmap_model.RoadmapNodeId,
                    attempt_key: progress.attempt_key,
                  ),
                  head_sha: revision as String,
                ) {
                  IntegrationReceiptAbsent => MemberCensusPending { node_id: member }
                  IntegrationReceiptUnreadable { reason: _ } => MemberCensusPending { node_id: member }
                  IntegrationReceiptForHead { receipt } =>
                    match receipt.state {
                      IntegrationIntegrated => MemberCensusIntegrated { node_id: member }
                      IntegrationBlocked { detail: _ } => MemberCensusBlocked { node_id: member }
                    }
                }
            }
        }
      })
      CensusCounted {
        integrated: count(states |> filter(s => match s {
          MemberCensusIntegrated { node_id: _ } => true
          MemberCensusPending { node_id: _ } => false
          MemberCensusBlocked { node_id: _ } => false
        })),
        blocked: states |> flat_map(s => match s {
          MemberCensusBlocked { node_id } => [node_id]
          MemberCensusIntegrated { node_id: _ } => []
          MemberCensusPending { node_id: _ } => []
        }),
      }
    }
  }
}

type MemberCensus
  = MemberCensusIntegrated { node_id: String }
  | MemberCensusPending { node_id: String }
  | MemberCensusBlocked { node_id: String }

// INTEGRATION PRECEDES PUBLICATION, and the obligation belongs to the project. A member attempt
// of a multi-member project never publishes alone: it defers, naming the standing, until the
// membership is fully integrated -- and then the PROJECT publishes (one integration head, one
// PR), through belt_publish_project_for_instance. A standalone task is the degenerate project
// of one and flows into the per-attempt adjudication unchanged. The capture mint moved the
// envelope selection to the base only so the candidate could descend from the shared base and
// then restored it: between belt operations checked_out IS the integration head, which is what
// makes restart recovery a pure derivation from the envelope.
fn belt_publish_attempt_for_instance(
  instance: HostDashboardInstance,
  node_id: String,
  attempt_key: String,
) -> BeltPublishOutcome {
  match belt_integrate_candidate_for_instance(instance: instance, node_id: node_id, attempt_key: attempt_key) {
    IntegrationStepDeferred { reason } => PublishDeferred { node_id: node_id, reason: reason }
    IntegrationStepUnreadable { detail } => PublishEvidenceUnreadable { node_id: node_id, detail: detail }
    IntegrationStepBlocked { detail } =>
      PublishDeferred { node_id: node_id, reason: join(["blocked on integration: ", detail], "") }
    IntegrationStepReady { project_key, integrated, members } =>
      if integrated < members {
        PublishDeferred {
          node_id: node_id,
          reason: join([
            "the publication obligation belongs to the project ", project_key, ": ",
            to_string(integrated), " of ", to_string(members), " members integrated",
          ], ""),
        }
      } else {
        match node_project_membership(node_id: node_id, memberships: roadmap_memberships()) {
          MembershipMember { arc } =>
            belt_publish_project_for_instance(
              instance: instance,
              node_id: node_id,
              attempt_key: attempt_key,
              project_key: arc,
            )
          MembershipStandalone => belt_publish_attempt_adjudicate(instance: instance, node_id: node_id, attempt_key: attempt_key)
          MembershipAmbiguous { arcs: _ } => belt_publish_attempt_adjudicate(instance: instance, node_id: node_id, attempt_key: attempt_key)
        }
      }
  }
}


// THE PROJECT PUBLICATION EDGE: the integration head, materialized to a git branch, handed to the
// same helper boundary the attempt flow uses. SCM inside, git only here at the edge -- the
// materialization reads the corpus OUT of the object store through the SCM checkout verbs and
// writes plain files; git's whole role is worktree-add/checkout/add/commit/push, and the helper's
// observe-first reconciliation (an existing PR is discovered, never duplicated) is unchanged.
//
// THE INTEGRATION WORKTREE IS BELT-OWNED, DETERMINISTIC, AND RE-SEDED EVERY PUBLICATION. It is
// created once (`git worktree add --detach` at the intake base), and every publication resets it
// (`checkout -B <integration branch> <base>` + `git clean -fdx`) before the corpus is written, so
// the tree afterwards holds exactly the integration head's corpus -- never a residue of an
// earlier materialization. No worker ever runs in it.
fn belt_publish_project_worktree(instance: HostDashboardInstance, project_key: String, base_sha: String) -> BeltExecOutcome {
  let root = dashboard_instance_dispatch_worktree_root(instance: instance) as String
  let path = join([root, "/", project_key, "-integration"], "")
  let listing = Filesystem.List(path: root)
  if !listing.success {
    ExecFailed {
      program: "git",
      exit_code: -1,
      stderr: join(["the dispatch worktree root could not be listed: ", root, " (", listing.error, ")"], ""),
    }
  } else if !filesystem_listing_names_entry(listing: listing.entries, name: join([project_key, "-integration"], "")) {
    belt_exec(
      cmd: host_exec_argv(
        program: dispatch_capability_program(
          environment: instance.execution_environment,
          cap: GitWorkspaceCapability,
        ),
        args: ["worktree", "add", "--detach", path, base_sha],
      ),
      workdir: belt_actuate_workdir as String,
    )
  } else {
    ExecOk { stdout: "" }
  }
}

fn belt_publish_project_subject_repository(
  instance: HostDashboardInstance,
  node_id: String,
  attempt_key: String,
) -> PublicationSubjectObservation {
  match belt_lookup_node(node_id: node_id) {
    AuthorityProjectionRefused { detail } =>
      PublicationSubjectUnobserved { reason: concat("roadmap authority projection refused: ", detail) }
    NodeMissing =>
      PublicationSubjectUnobserved { reason: "the roadmap authority declares no node with this id" }
    NodeFound { node } =>
      belt_publication_subject_for_node(
        node: node,
        attempt_key: attempt_key,
        branch: dispatch_branch_name(
          node_id: node_id as gunbc.roadmap.roadmap_model.RoadmapNodeId,
          attempt_key: attempt_key,
        ),
        base_branch: dispatch_base_branch(instance: instance),
        head: belt_worktree_head_observe(
          instance: instance,
          worktree: dispatch_worktree_path_for_instance(
            instance: instance,
            node_id: node_id as gunbc.roadmap.roadmap_model.RoadmapNodeId,
            attempt_key: attempt_key,
          ),
        ),
      )
  }
}

type BeltDirAcc { skipped: Bool, segments: List<String> }

fn belt_path_parent_dir(path: String) -> String {
  let acc = fold(
    reverse(split(s: path, delimiter: "/")),
    init: BeltDirAcc { skipped: false, segments: [] },
    f: (acc, seg) =>
      if acc.skipped {
        BeltDirAcc { skipped: true, segments: concat([seg], acc.segments) }
      } else {
        BeltDirAcc { skipped: true, segments: [] }
      },
  )
  join(acc.segments, "/")
}

// MATERIALIZE THE PUBLISH PLAN INTO THE INTEGRATION WORKTREE, in the one order that realizes every
// topology change (ruling on #13111, 2026-10-04): DELETES FIRST, so a base file is gone before a bind
// creates a directory at its path (file -> directory) and a base directory is emptied -- git rm
// removes the directories it empties -- before a bind writes a file at its path (directory -> file);
// then the bind parents in ONE install -d, only when some bind needs a parent; then the writes (the
// Filesystem.Write intrinsic creates no parents). Every delete path crosses
// extdeps.git git_pathspec_literal: `--` only ends option parsing, it does not make a pathspec
// literal, and a manifest path is a NonEmptyStr that may spell pathspec magic or a glob. git rm runs
// without --ignore-unmatch, so a delete the checkout disagrees with stops the publish.
//
// The realization is one function over the git and install programs, so production
// (belt_publish_project_materialize, the instance's capability programs) and the real-repository
// witness (test.claim.roadmap.roadmap_belt_publish_realization_wet_witness) drive the same code.
//
// One note on the fold arms below, kept at declaration grain (the annotation channel admits no
// in-body comments): NO POISON IS BORN IN MATERIALIZATION (its refusals are all exec/write I/O),
// but the verdict type is shared, so a poisoned accumulator propagates as the terminal state it is
// rather than being reclassified transient.
fn belt_publish_project_materialize(
  instance: HostDashboardInstance,
  worktree: String,
  files: List<RecoveredSourceFile>,
  deletes: List<NonEmptyStr>,
) -> BeltScmCapture {
  belt_publish_realize(
    git_program: dispatch_capability_program(environment: instance.execution_environment, cap: GitWorkspaceCapability),
    install_program: dispatch_capability_program(environment: instance.execution_environment, cap: AttemptStateDirectoryCapability),
    worktree: worktree,
    files: files,
    deletes: deletes,
  )
}

fn belt_publish_realize(
  git_program: String,
  install_program: String,
  worktree: String,
  files: List<RecoveredSourceFile>,
  deletes: List<NonEmptyStr>,
) -> BeltScmCapture {
  match belt_publish_realize_deletes(git_program: git_program, worktree: worktree, deletes: deletes) {
    ScmCaptureRefused { detail } => ScmCaptureRefused { detail: detail }
    ScmCapturePoisoned { detail } => ScmCapturePoisoned { detail: detail }
    ScmCandidateCaptured { repository_path: _, commit_ordinal: _, commit_root_locator: _ } =>
      match belt_publish_realize_parents(install_program: install_program, worktree: worktree, files: files) {
        ScmCaptureRefused { detail } => ScmCaptureRefused { detail: detail }
        ScmCapturePoisoned { detail } => ScmCapturePoisoned { detail: detail }
        ScmCandidateCaptured { repository_path: _, commit_ordinal: _, commit_root_locator: _ } =>
          belt_publish_realize_writes(worktree: worktree, files: files)
      }
  }
}

fn belt_publish_realize_deletes(git_program: String, worktree: String, deletes: List<NonEmptyStr>) -> BeltScmCapture {
  if count(deletes) == 0 {
    ScmCandidateCaptured { repository_path: "", commit_ordinal: 0, commit_root_locator: "" }
  } else {
    match belt_exec(
      cmd: host_exec_argv(program: git_program, args: concat(["rm", "-q", "--"], map(deletes, d => git_pathspec_literal(path: d as String)))),
      workdir: worktree,
    ) {
      ExecFailed { program, exit_code, stderr } =>
        ScmCaptureRefused {
          detail: belt_commit_exec_detail(step: "publish-deletes", outcome: ExecFailed { program: program, exit_code: exit_code, stderr: stderr }),
        }
      ExecRefused { program, reason } =>
        ScmCaptureRefused { detail: belt_commit_exec_detail(step: "publish-deletes", outcome: ExecRefused { program: program, reason: reason }) }
      ExecOk { stdout: _ } => ScmCandidateCaptured { repository_path: "", commit_ordinal: 0, commit_root_locator: "" }
    }
  }
}

fn belt_publish_realize_parents(install_program: String, worktree: String, files: List<RecoveredSourceFile>) -> BeltScmCapture {
  let dirs = distinct_by_key(
    xs: files
      |> map(f => belt_path_parent_dir(path: f.path as String))
      |> filter(d => d != ""),
    key: d => d,
  )
  if count(dirs) == 0 {
    ScmCandidateCaptured { repository_path: "", commit_ordinal: 0, commit_root_locator: "" }
  } else {
    match belt_exec(cmd: host_exec_argv(program: install_program, args: concat(["-d", "-m", "0700"], dirs)), workdir: worktree) {
      ExecFailed { program, exit_code, stderr } =>
        ScmCaptureRefused {
          detail: belt_commit_exec_detail(step: "materialize-directories", outcome: ExecFailed { program: program, exit_code: exit_code, stderr: stderr }),
        }
      ExecRefused { program, reason } =>
        ScmCaptureRefused {
          detail: belt_commit_exec_detail(step: "materialize-directories", outcome: ExecRefused { program: program, reason: reason }),
        }
      ExecOk { stdout: _ } => ScmCandidateCaptured { repository_path: "", commit_ordinal: 0, commit_root_locator: "" }
    }
  }
}

fn belt_publish_realize_writes(worktree: String, files: List<RecoveredSourceFile>) -> BeltScmCapture {
  fold(
    files,
    init: ScmCandidateCaptured { repository_path: "", commit_ordinal: 0, commit_root_locator: "" },
    f: (acc, f) =>
      match acc {
        ScmCaptureRefused { detail: _ } => acc
        ScmCapturePoisoned { detail: _ } => acc
        ScmCandidateCaptured { repository_path: _, commit_ordinal: _, commit_root_locator: _ } => {
          let write = Filesystem.Write(
            path: join([worktree, "/", f.path as String], ""),
            content: match f.content {
              AuthoredSourceEmpty => ""
              AuthoredSourceText(t) => t as String
            },
          )
          if write.success {
            acc
          } else {
            ScmCaptureRefused {
              detail: join(["the integration head's ", f.path as String, " could not be materialized: ", write.error], ""),
            }
          }
        }
      },
  )
}

// THE PUBLISH'S CONTENT DEMAND IS THE HEAD'S DELTA AGAINST THE BASE IT IS WRITTEN OVER. The
// integration worktree is checked out clean at the intake base, and the envelope's root commit IS
// that base's tree (the seed stages `git show <base>:<path>` for every tracked path and records the
// sha in the root's message), so every head entry bound to the same source as the root's entry at
// that path is already on disk byte-for-byte. Only the entries the head re-binds or adds are
// recovered -- their sources materialized from exactly their shards -- and written. The equivalence
// rests on the root being the base the worktree holds; when the root does not name this base (an
// envelope from the pre-seeding capture design, or a base that moved), the delta is underivable and
// the publish REFUSES, typed, rather than widening to a whole-corpus recovery.
//
// THE CHANGE IS CLOSED UNDER BOTH OPERATIONS (ruling on #13111, 2026-10-04). A head that DELETES a
// base path must delete it from the checkout too, or the published tree resurrects it and differs
// from the SCM commit it claims to realize -- the verified-tree/integrated-tree divergence this PR
// exists to remove (the earlier revision left removed paths as the base had them). So the plan is a
// closed carrier, PublishBind for every head entry the base lacks or binds differently and
// PublishDelete for every base path the head lacks; a rename is a delete plus a bind. The pure
// application (belt_publish_apply) is the model the tree-equality control executes, and the realizer
// (belt_publish_project_materialize) consumes exactly the same plan.
type BeltPublishChange
  = PublishBind { entry: CorpusManifestEntry }
  | PublishDelete { path: NonEmptyStr }

type BeltPublishDelta
  = PublishDeltaFiles { files: List<RecoveredSourceFile>, deletes: List<NonEmptyStr> }
  | PublishDeltaRefused { detail: String }

fn belt_publish_plan(head: List<CorpusManifestEntry>, root: List<CorpusManifestEntry>) -> List<BeltPublishChange> {
  let base_bound = path_unique_of_record_entries(entries: root)
  let head_bound = path_unique_of_record_entries(entries: head)
  concat(
    head
      |> filter(e => match map_get(base_bound, key: e.path) {
        Absent => true
        Present { value: held } => !object_id_eq(left: held.source.locator, right: e.source.locator)
      })
      |> map(e => PublishBind { entry: e }),
    root
      |> filter(e => match map_get(head_bound, key: e.path) {
        Absent => true
        Present { value: _ } => false
      })
      |> map(e => PublishDelete { path: e.path }),
  )
}

fn path_unique_of_record_entries(entries: List<CorpusManifestEntry>) -> Map<NonEmptyStr, CorpusManifestEntry> {
  fold(entries, init: empty_map(), f: (m, e) => map_insert(m, e.path, e))
}

fn belt_publish_binds(plan: List<BeltPublishChange>) -> List<CorpusManifestEntry> {
  plan |> flat_map(c => match c {
    PublishBind { entry } => [entry]
    PublishDelete { path: _ } => []
  })
}

fn belt_publish_deletes(plan: List<BeltPublishChange>) -> List<NonEmptyStr> {
  plan |> flat_map(c => match c {
    PublishBind { entry: _ } => []
    PublishDelete { path } => [path]
  })
}

// THE PURE APPLICATION: the base tree (path -> source digest) with the plan applied, in path order --
// the model of the checkout after the realizer writes every bind and removes every delete.
fn belt_publish_apply(base: List<CorpusManifestEntry>, plan: List<BeltPublishChange>) -> List<String> {
  let applied = fold(plan, init: fold(base, init: empty_map(), f: (m, e) => map_insert(m, e.path as String, object_id_key(identity: e.source.locator))), f: (m, c) =>
    match c {
      PublishBind { entry } => map_insert(m, entry.path as String, object_id_key(identity: entry.source.locator))
      PublishDelete { path } => map_without(m: m, key: path as String)
    })
  sort_by(map_keys(applied), k => k) |> map(k => join([k, "=", match map_get(applied, key: k) { Present { value: d } => d Absent => "" }], ""))
}

fn map_without(m: Map<String, String>, key: String) -> Map<String, String> {
  fold(map_keys(m), init: empty_map(), f: (acc, k) =>
    if k == key { acc } else {
      match map_get(m, key: k) {
        Present { value: v } => map_insert(acc, k, v)
        Absent => acc
      }
    })
}

fn belt_publish_tree_of(entries: List<CorpusManifestEntry>) -> List<String> {
  sort_by(entries, e => e.path as String) |> map(e => join([e.path as String, "=", object_id_key(identity: e.source.locator)], ""))
}

// THE PUBLISH BASE: THE INTAKE COMMIT WHOSE TREE THE INTEGRATION WORKTREE IS CHECKED OUT AT, and
// against whose manifest the head's re-bound entries are planned. A head's tree contains every
// external revision its line and its LIVE integrated sources were based on (a superseded
// integration's content was replaced by its corrective squash), and those intake commits lie on ONE
// chain (gunbc.scm.repository_envelope mint_intake_advance), so the base is the deepest of them:
// diffing against an earlier one would publish the upstream change between the two as if it were the
// work. A line that still reads unrecorded has not been converted and is underivable.
type BeltPublishBase {
  commit: RepositoryCommit
  sha: String
}

type BeltPublishBaseDerivation
  = PublishBaseDerived { base: BeltPublishBase }
  | PublishBaseUnderivable { detail: String }

type BeltPublishBaseAcc {
  typed: List<RepositoryCommitRef>
  refused: String?
}

fn belt_publish_base(commits: List<RepositoryCommit>, head: RepositoryCommitRef) -> BeltPublishBaseDerivation {
  match belt_line_integrated_sources(commits: commits, head: head) {
    LineSourcesUnreadable { detail } => PublishBaseUnderivable { detail: detail }
    LineSourcesRead { sources } => {
      let lines = concat([head], map(belt_line_live_sources(sources: sources), l => l.source.reference))
      let acc = fold(lines, init: BeltPublishBaseAcc { typed: [], refused: none }, f: (acc, at) =>
        match acc.refused {
          Present { value: _ } => acc
          Absent =>
            match line_intake(commits: commits, head: at) {
              LineIntakeAt { commit, revision: _ } => BeltPublishBaseAcc { typed: concat([commit], acc.typed), refused: none }
              LineIntakeUnrecorded { commit: _ } => BeltPublishBaseAcc { typed: acc.typed, refused: Present { value: join(["commit ", to_string(minted_id_ordinal(id: at.identity)), " is on a line that predates typed base records and has not been converted (belt_scm_intake_convert_cli)"], "") } }
              LineIntakeAbsent => BeltPublishBaseAcc { typed: acc.typed, refused: Present { value: join(["commit ", to_string(minted_id_ordinal(id: at.identity)), " is on no base line"], "") } }
              LineIntakeUnreadable { at: u } => BeltPublishBaseAcc { typed: acc.typed, refused: Present { value: join(["the ancestry of commit ", to_string(minted_id_ordinal(id: u.identity)), " cannot be read"], "") } }
            }
        })
      match acc.refused {
        Present { value: detail } => PublishBaseUnderivable { detail: detail }
        Absent =>
          match (sort_by(acc.typed, r => 0 - belt_line_depth(commits: commits, at: r))).first() {
            Absent => PublishBaseUnderivable { detail: "the head's line records no base" }
            Present { value: deepest } =>
              match commit_at_reference(commits: commits, reference: deepest) {
                Absent => PublishBaseUnderivable { detail: "the publish base is not a commit of its own envelope, which is envelope damage" }
                Present { value: base_commit } =>
                  PublishBaseDerived { base: BeltPublishBase { commit: base_commit, sha: belt_line_revision_sha(commits: commits, at: deepest) } }
              }
          }
      }
    }
  }
}

fn belt_line_depth(commits: List<RepositoryCommit>, at: RepositoryCommitRef) -> Int {
  match ancestry_walk(start: at, history: repository_history(commits: commits)) {
    AncestryTraced { chain } => count(chain)
    AncestryBrokenAt { commit: _, missing_parent: _ } => 0
    AncestryStartNotInHistory { start: _ } => 0
    AncestryRevisitsACommit { detected_from: _ } => 0
  }
}

// WHAT A PUBLISH IS ABOUT, READ FROM THE INDEX ONCE: the head, and the base its worktree is checked
// out at. The same envelope value then plans the delta, so the index is not read twice.
type BeltPublishSubject
  = PublishSubjectRead { envelope: RepositoryEnvelope, head_commit: RepositoryCommit, base: BeltPublishBase }
  | PublishSubjectUnreadable { detail: String }

fn belt_publish_subject_of(path: String) -> BeltPublishSubject {
  match load_repository_indexed(path: path) {
    RepositoryLoadRefused { cause } => PublishSubjectUnreadable { detail: belt_scm_load_refusal_detail(cause: cause) }
    RepositoryLoaded { path: _, envelope, generation: _ } =>
      match envelope.checked_out {
        Absent => PublishSubjectUnreadable { detail: "the project envelope selects no integration head, so there is nothing to publish" }
        Present { value: head } =>
          match commit_at_reference(commits: envelope.commits, reference: head) {
            Absent => PublishSubjectUnreadable { detail: "the integration head is not a commit of its own envelope, which is envelope damage" }
            Present { value: head_commit } =>
              match belt_publish_base(commits: envelope.commits, head: head) {
                PublishBaseUnderivable { detail } =>
                  PublishSubjectUnreadable { detail: join(["the publish base is underivable, so which head entries the base checkout already holds is unknown and the publish refuses rather than recovering the whole corpus: ", detail], "") }
                PublishBaseDerived { base } => PublishSubjectRead { envelope: envelope, head_commit: head_commit, base: base }
              }
          }
      }
  }
}

fn belt_publish_head_delta(
  instance: HostDashboardInstance,
  path: String,
  envelope: RepositoryEnvelope,
  head_commit: RepositoryCommit,
  base: BeltPublishBase,
) -> BeltPublishDelta {
  let root_commit = base.commit
            match belt_line_standing_detail(standing: belt_line_standing(commits: envelope.commits, head: head_commit.reference)) {
              Present { value: line_detail } => PublishDeltaRefused { detail: line_detail }
              Absent =>
            match materialize_objects(envelope_path: path, store: envelope.store, identities: [head_commit.root.locator, root_commit.root.locator]) {
              ObjectMaterializationRefused { detail } => PublishDeltaRefused { detail: join(["the head or base manifest could not be read from its shard: ", detail], "") }
              ObjectsMaterialized { store: with_manifests, read_shards: _ } =>
                match find_corpus_manifest_record(store: with_manifests, identity: head_commit.root.locator) {
                  CorpusManifestAbsent { identity: _ } => PublishDeltaRefused { detail: "the integration head's manifest is absent from the store" }
                  CorpusManifestIsAuthoredSource { identity: _ } => PublishDeltaRefused { detail: "the integration head's root is an authored source, which is store damage" }
                  CorpusManifestIsSemanticNode { identity: _ } => PublishDeltaRefused { detail: "the integration head's root is a semantic node, which is store damage" }
                  CorpusManifestFound(head_record) =>
                    match find_corpus_manifest_record(store: with_manifests, identity: root_commit.root.locator) {
                      CorpusManifestAbsent { identity: _ } => PublishDeltaRefused { detail: "the base manifest is absent from the store" }
                      CorpusManifestIsAuthoredSource { identity: _ } => PublishDeltaRefused { detail: "the base root is an authored source, which is store damage" }
                      CorpusManifestIsSemanticNode { identity: _ } => PublishDeltaRefused { detail: "the base root is a semantic node, which is store damage" }
                      CorpusManifestFound(root_record) => {
                        let plan = belt_publish_plan(head: head_record.entries, root: root_record.entries)
                        let changed = belt_publish_binds(plan: plan)
                        match materialize_objects(
                          envelope_path: path,
                          store: with_manifests,
                          identities: map(changed, e => authored_source_target_locator(target: e.source)),
                        ) {
                          ObjectMaterializationRefused { detail } => PublishDeltaRefused { detail: join(["a changed source could not be read from its shard: ", detail], "") }
                          ObjectsMaterialized { store: with_sources, read_shards: _ } =>
                            match recover_corpus(store: with_sources, entries: changed) {
                              CorpusRecoveryRefused { cause: _ } => PublishDeltaRefused { detail: "the integration head's changed corpus is unrecoverable from the store" }
                              CorpusRecovered { files } => PublishDeltaFiles { files: files, deletes: belt_publish_deletes(plan: plan) }
                            }
                        }
                      }
                    }
                }
            }
            }
}

fn belt_publish_project_for_instance(
  instance: HostDashboardInstance,
  node_id: String,
  attempt_key: String,
  project_key: String,
) -> BeltPublishOutcome {
  let envelope_path = belt_scm_project_repository_path(instance: instance, project_key: project_key)
  match belt_publish_subject_of(path: envelope_path) {
    PublishSubjectUnreadable { detail } =>
      PublishEvidenceUnreadable { node_id: node_id, detail: detail }
    PublishSubjectRead { envelope, head_commit, base } => {
      let base_sha = base.sha
      match belt_publish_project_worktree(instance: instance, project_key: project_key, base_sha: base_sha) {
        ExecFailed { program, exit_code, stderr } =>
          PublishEvidenceUnreadable {
            node_id: node_id,
            detail: belt_commit_exec_detail(step: "integration-worktree", outcome: ExecFailed { program: program, exit_code: exit_code, stderr: stderr }),
          }
        ExecRefused { program, reason } =>
          PublishEvidenceUnreadable {
            node_id: node_id,
            detail: belt_commit_exec_detail(step: "integration-worktree", outcome: ExecRefused { program: program, reason: reason }),
          }
        ExecOk { stdout: _ } => {
          let branch = join(["dispatch-", project_key, "-integration"], "")
          let worktree = join([
            dashboard_instance_dispatch_worktree_root(instance: instance) as String,
            "/", project_key, "-integration",
          ], "")
          match belt_commit_git(instance: instance, worktree: worktree, args: ["checkout", "-B", branch, base_sha]) {
            ExecFailed { program, exit_code, stderr } =>
              PublishEvidenceUnreadable {
                node_id: node_id,
                detail: belt_commit_exec_detail(step: "integration-branch", outcome: ExecFailed { program: program, exit_code: exit_code, stderr: stderr }),
              }
            ExecRefused { program, reason } =>
              PublishEvidenceUnreadable {
                node_id: node_id,
                detail: belt_commit_exec_detail(step: "integration-branch", outcome: ExecRefused { program: program, reason: reason }),
              }
            ExecOk { stdout: _ } =>
              match belt_commit_git(instance: instance, worktree: worktree, args: ["clean", "-fdx"]) {
                ExecFailed { program, exit_code, stderr } =>
                  PublishEvidenceUnreadable {
                    node_id: node_id,
                    detail: belt_commit_exec_detail(step: "integration-clean", outcome: ExecFailed { program: program, exit_code: exit_code, stderr: stderr }),
                  }
                ExecRefused { program, reason } =>
                  PublishEvidenceUnreadable {
                    node_id: node_id,
                    detail: belt_commit_exec_detail(step: "integration-clean", outcome: ExecRefused { program: program, reason: reason }),
                  }
                ExecOk { stdout: _ } => {
                              match belt_publish_head_delta(instance: instance, path: envelope_path, envelope: envelope, head_commit: head_commit, base: base) {
                                PublishDeltaRefused { detail } =>
                                  PublishEvidenceUnreadable { node_id: node_id, detail: detail }
                                    PublishDeltaFiles { files, deletes } =>
                                      match belt_publish_project_materialize(instance: instance, worktree: worktree, files: files, deletes: deletes) {
                                        ScmCaptureRefused { detail } =>
                                          PublishEvidenceUnreadable { node_id: node_id, detail: detail }
                                        ScmCapturePoisoned { detail } =>
                                          PublishEvidenceUnreadable { node_id: node_id, detail: detail }
                                        ScmCandidateCaptured { repository_path: _, commit_ordinal: _, commit_root_locator: _ } =>
                                          match belt_commit_staged(
                                            instance: instance,
                                            worktree: worktree,
                                            message: join(["integration: ", project_key], "") as NonEmptyStr,
                                          ) {
                                            StagedCommitFailed { detail } =>
                                              PublishEvidenceUnreadable { node_id: node_id, detail: detail }
                                            StagedCommitRecorded =>
                                              match belt_worktree_head_observe(instance: instance, worktree: worktree) {
                                                WorktreeHeadUnobserved { reason } =>
                                                  PublishEvidenceUnreadable { node_id: node_id, detail: reason }
                                                WorktreeHeadObserved { revision } =>
                                                  match belt_publish_project_subject_repository(
                                                    instance: instance,
                                                    node_id: node_id,
                                                    attempt_key: attempt_key,
                                                  ) {
                                                    PublicationSubjectUnobserved { reason } =>
                                                      PublishDeferred { node_id: node_id, reason: reason }
                                                    PublicationSubjectObserved { subject } => {
                                                      let project_subject = RoadmapPublicationSubject {
                                                        node_id: project_key,
                                                        attempt_key: "integration",
                                                        repository: subject.repository,
                                                        branch: branch as NonEmptyStr,
                                                        expected_base: subject.expected_base,
                                                        expected_head: revision as CommitSha,
                                                      }
                                                      match publication_answer_standing(
                                                        instance_root: instance.instance_root as String,
                                                        subject: project_subject,
                                                        worktree: worktree,
                                                      ) {
                                                        AnswerSpoolRefused { reason } =>
                                                          PublishEvidenceUnreadable {
                                                            node_id: node_id,
                                                            detail: join([
                                                              "the publication helper's spool refused, so it is unknown whether this integration head has been published: ",
                                                              reason,
                                                            ], ""),
                                                          }
                                                        AnswerAwaited { request_path } =>
                                                          PublishRequested {
                                                            node_id: project_key,
                                                            head_sha: revision as String,
                                                            request_path: request_path,
                                                          }
                                                        AnswerReady { receipt } => {
                                                          let write = Filesystem.Write(
                                                            path: join([
                                                              belt_scm_projects_dir(instance: instance),
                                                              "/", project_key, ".publication-receipt.json",
                                                            ], ""),
                                                            content: publication_receipt_json(receipt: receipt),
                                                          )
                                                          belt_publish_write_outcome(
                                                            node_id: project_key,
                                                            subject: project_subject,
                                                            receipt: receipt,
                                                            write_success: write.success,
                                                            write_error: write.error,
                                                          )
                                                        }
                                                      }
                                                    }
                                                  }
                                              }
                                          }
                                      }
                              }
                  }
                }
              }
          }
        }
    }
  }
}

fn belt_publish_attempt_adjudicate(
  instance: HostDashboardInstance,
  node_id: String,
  attempt_key: String,
) -> BeltPublishOutcome {
  let attempt_worktree = dispatch_worktree_path_for_instance(
    instance: instance,
    node_id: node_id as gunbc.roadmap.roadmap_model.RoadmapNodeId,
    attempt_key: attempt_key,
  )
  match belt_lookup_node(node_id: node_id) {
    AuthorityProjectionRefused { detail } =>
      PublishDeferred {
        node_id: node_id,
        reason: concat("roadmap authority projection refused: ", detail),
      }
    NodeMissing =>
      PublishDeferred {
        node_id: node_id,
        reason: "the roadmap authority declares no node with this id, so there is no publication destination",
      }
    NodeFound { node } =>
  match belt_publication_subject_for_node(
    node: node,
    attempt_key: attempt_key,
    branch: dispatch_branch_name(
      node_id: node_id as gunbc.roadmap.roadmap_model.RoadmapNodeId,
      attempt_key: attempt_key,
    ),
    base_branch: dispatch_base_branch(instance: instance),
    head: belt_worktree_head_observe(
      instance: instance,
      worktree: attempt_worktree,
    ),
  ) {
    PublicationSubjectUnobserved { reason } =>
      PublishDeferred { node_id: node_id, reason: reason }
    PublicationSubjectObserved { subject } => {
      match observe_worktree_repository_binding(
        worktree: attempt_worktree,
        repo: subject.repository,
      ) {
        WorktreeRemoteUnreadable { exit_code: code, stderr: err } =>
          PublishEvidenceUnreadable {
            node_id: node_id,
            detail: join([
              "the attempt worktree's origin remote could not be read, so it is unknown whether the head being published came from this repository (git exit ",
              to_string(code), "): ", err,
            ], ""),
          }
        WorktreeBoundElsewhere { observed: observed, expected: expected } =>
          PublishEvidenceUnreadable {
            node_id: node_id,
            detail: join([
              "the attempt worktree is a checkout of a different repository, so its head is not evidence about this subject — origin is ",
              observed, " but this publication is about ", expected as String,
            ], ""),
          }
        WorktreeBoundToRepository => {
          let path = dispatch_attempt_publication_receipt_path_for_instance(
            instance: instance,
            node_id: node_id as gunbc.roadmap.roadmap_model.RoadmapNodeId,
            attempt_key: attempt_key,
            head_sha: subject.expected_head as String,
          )
          match belt_publish_admission_for(
            instance: instance,
            node_id: node_id,
            attempt_key: attempt_key,
            subject: subject,
          ) {
            PublishWithheld { reason } =>
              PublishDeferred { node_id: node_id, reason: join(["publication withheld: ", reason as String], "") }
            PublishAdmitted =>
            match belt_publish_gate(
              node_id: node_id,
              subject: subject,
              existing: belt_publication_receipt_source(
                instance: instance,
                node_id: node_id as gunbc.roadmap.roadmap_model.RoadmapNodeId,
                attempt_key: attempt_key,
                subject: PublicationSubjectObserved { subject: subject },
              ),
            ) {
              PublishHalted { outcome } => outcome
              PublishProceed =>
                match publication_answer_standing(
                  instance_root: instance.instance_root as String,
                  subject: subject,
                  worktree: attempt_worktree,
                ) {
                  AnswerSpoolRefused { reason } =>
                    PublishEvidenceUnreadable {
                      node_id: node_id,
                      detail: join([
                        "the publication helper's spool refused, so it is unknown whether this head has been published: ",
                        reason,
                      ], ""),
                    }
                  AnswerAwaited { request_path } =>
                    PublishRequested {
                      node_id: node_id,
                      head_sha: subject.expected_head as String,
                      request_path: request_path,
                    }
                  AnswerReady { receipt } => {
                    let write = Filesystem.Write(
                      path: path,
                      content: publication_receipt_json(receipt: receipt),
                    )
                    belt_publish_write_outcome(
                      node_id: node_id,
                      subject: subject,
                      receipt: receipt,
                      write_success: write.success,
                      write_error: write.error,
                    )
                  }
                }
            }
          }
        }
      }
    }
  }
  }
}

// A FAILED PUBLISH PASS NAMES WHAT FAILED. The tick receipt keeps only the pass sentence, so a
// sentence that says "one or more" erases which attempt and why -- the 2026-09-29 regression was
// diagnosable only by re-running the pass by hand. Each failing outcome is rendered as its node, its
// arm and its detail, from the same accessors the per-outcome wire uses.
fn belt_publish_outcome_is_failure(o: BeltPublishOutcome) -> Bool {
  match o {
    PublishWriteFailed { node_id: _, detail: _ } => true
    PublishEvidenceUnreadable { node_id: _, detail: _ } => true
    PublishDeferred { node_id: _, reason: _ } => false
    PublishRequested { node_id: _, head_sha: _, request_path: _ } => false
    PublishRecorded { node_id: _, head_sha: _, outcome_key: _ } => false
    PublishAlreadyRecorded { node_id: _, head_sha: _ } => false
  }
}

fn belt_publish_outcome_failure_line(o: BeltPublishOutcome) -> String {
  join([
    belt_publish_outcome_node_id(o: o),
    " (", belt_publish_outcome_key(o: o), "): ",
    belt_publish_outcome_detail(o: o),
  ], "")
}

fn belt_publish_pass_outcome_from(outcomes: List<BeltPublishOutcome>) -> BeltPassOutcome {
  let ledger_refusals = outcomes |> filter(o => match o {
    PublishDeferred { node_id: nid, reason: _ } => nid == ""
    PublishRequested { node_id: _, head_sha: _, request_path: _ } => false
    PublishWriteFailed { node_id: _, detail: _ } => false
    PublishEvidenceUnreadable { node_id: _, detail: _ } => false
    PublishRecorded { node_id: _, head_sha: _, outcome_key: _ } => false
    PublishAlreadyRecorded { node_id: _, head_sha: _ } => false
  })
  if count(ledger_refusals) > 0 {
    match ledger_refusals.first() {
      Present { value: PublishDeferred { node_id: _, reason: r } } =>
        BeltPassRefused { reason: r }
      Present { value: _ } =>
        BeltPassRefused { reason: "the attempts ledger is unobservable" }
      Absent =>
        BeltPassRefused { reason: "the attempts ledger is unobservable" }
    }
  } else {
    let failures = outcomes |> filter(o => belt_publish_outcome_is_failure(o: o))
    if count(failures) > 0 {
      BeltPassFailed {
        reason: join([
          to_string(count(failures)),
          " publication outcome(s) could not be recorded: ",
          join(map(failures, o => belt_publish_outcome_failure_line(o: o)), "; "),
        ], ""),
      }
    } else {
      BeltPassRecorded
    }
  }
}

// A PENDING VERIFICATION SAYS WHAT ITS OWN OBLIGATION FOUND. Verification is no longer a pass the tick
// runs over every attempt (dogfood intervention #6): it is this attempt's obligation, run by this
// attempt's unit, and that run's receipt is what can say it was blocked or failed. Only when the
// attempt has no verify step on record does the page fall back to the tick: a refused discovery
// pass blocks every attempt's queue, and otherwise the verification is queued for its obligation.
fn belt_verification_presentation_detail(
  progress: WorkflowAttemptProgress,
  tick_read: BeltTickReceiptRead,
  obligation_read: BeltAttemptObligationReceiptRead,
) -> String {
  match workflow_segment_of_kind(segments: progress.segments, kind: VerificationWorkflowSegment) {
    Present { value: segment } =>
      match segment.state {
        WorkflowSegmentComplete =>
          join(["Verification passed · ", segment.detail], "")
        WorkflowSegmentFailed =>
          join(["Verification failed · ", segment.detail], "")
        WorkflowSegmentRefused =>
          join(["Verification refused · ", segment.detail], "")
        WorkflowSegmentStopped =>
          join(["Verification stopped · ", segment.detail], "")
        WorkflowSegmentActive =>
          join(["Verification running · ", progress.validation_summary], "")
        WorkflowSegmentPending =>
          match obligation_read {
            BeltAttemptObligationReceiptUnreadable { reason: r } =>
              join(["Verification blocked · attempt obligation receipt unreadable: ", r], "")
            BeltAttemptObligationReceiptPresent { verify: Present { value: pass } } =>
              match pass {
                BeltPassRefused { reason: r } => join(["Verification blocked · ", r], "")
                BeltPassFailed { reason: r } => join(["Verification failed · ", r], "")
                BeltPassDeferred { reason: r } => join(["Verification queued · ", r], "")
                BeltPassRecorded =>
                  if string_contains(s: segment.detail, pattern: "could not be read") {
                    join(["Verification refused · ", segment.detail], "")
                  } else {
                    join(["Verification queued · ", segment.detail], "")
                  }
              }
            BeltAttemptObligationReceiptPresent { verify: Absent } => belt_verification_queued_detail(tick_read: tick_read)
            BeltAttemptObligationReceiptAbsent => belt_verification_queued_detail(tick_read: tick_read)
          }
      }
    Absent =>
      "Verification unobserved"
  }
}

fn belt_verification_queued_detail(tick_read: BeltTickReceiptRead) -> String {
  match tick_read {
    BeltTickReceiptPresent { receipt } =>
      match receipt.discovery_pass {
        BeltPassRefused { reason: r } => join(["Verification blocked · ", r], "")
        BeltPassFailed { reason: r } => join(["Verification blocked · ", r], "")
        BeltPassDeferred { reason: _ } => "Verification queued - awaiting its obligation"
        BeltPassRecorded => "Verification queued - awaiting its obligation"
      }
    BeltTickReceiptAbsent => "Verification queued - awaiting its obligation"
    BeltTickReceiptUnreadable { reason: r } => join(["Verification blocked · belt tick receipt unreadable: ", r], "")
  }
}

// THE EXECUTION STANDING IS OBSERVED AT THE MINT SITE from the instance the tick ran for and the
// deployed tree's own revision -- the same local_tree_revision read the launch gate and the
// dispatch preflight make, because a tick receipt that answered from a different authority than
// the gate would report a revision the gate never bound -- and the mode is the production row the
// tick itself consumed. An unreadable revision withholds the binding rather than recording a
// revision the tick did not serve. Drift from the fleet ref is not consulted (operator ruling,
// 2026-09-05; see launch_revision_outcome).
fn belt_tick_execution_standing_for_instance(
  instance: HostDashboardInstance,
  mode: SpawnMode,
) -> BeltTickExecutionStanding {
  match local_tree_revision(repo: instance.repo_root) {
    LocalTreeRevisionObserved { revision: r } =>
      TickExecuted {
        instance_id: instance.instance_id as String,
        deployed_revision: git_object_id_wire_hex(oid: r) as String,
        spawn_mode: mode,
      }
    LocalTreeRevisionUnobserved { cause: c } =>
      TickExecutionWithheld { refusal: join(["revision unobserved: ", c], "") }
  }
}

fn belt_tick_receipt_from_result(
  result: BeltTickResult,
  observed_at: String,
  execution: BeltTickExecutionStanding,
) -> BeltTickReceipt {
  BeltTickReceipt {
    observed_at: observed_at,
    execution: execution,
    launches: belt_tick_launch_identities(outcomes: result.spawn_outcomes),
    spawn_pass: (match result.wholesale {
      TickPassesWithheld { refusal } => BeltPassRefused { reason: launch_refusal_reason(r: refusal) }
      TickPassesRun => belt_spawn_pass_outcome_from(host_refusal: result.host_refusal, spawn_outcomes: result.spawn_outcomes)
    }),
    teardown_pass: (match result.wholesale {
      TickPassesWithheld { refusal } => BeltPassRefused { reason: launch_refusal_reason(r: refusal) }
      TickPassesRun => belt_teardown_pass_outcome_from(host_refusal: result.host_refusal, teardown_outcomes: result.teardown_outcomes)
    }),
    seat_discharge_pass: belt_seat_discharge_pass_outcome_from(pass: result.seat_discharge),
    discovery_pass: (match result.wholesale {
      TickPassesWithheld { refusal } => BeltPassRefused { reason: launch_refusal_reason(r: refusal) }
      TickPassesRun => belt_discovery_pass_outcome(discovery: result.discovery)
    }),
  }
}

data belt_publish_pass_note: String = "PUBLICATION IS THE ATTEMPT'S LAST OBLIGATION, run by the attempt's own unit once its head is reviewed (gunbc.roadmap.roadmap_belt_obligation PublishObligation; dogfood intervention #6 moved it off the tick). It is still a desired obligation reconciled against an observed one, and a producer nobody calls is still the defect this lane keeps producing, so the wiring is the deliverable, not the type.\\n\\nIT IS AN OBSERVATION OF THE REMOTE AS WELL AS AN EFFECT: running it records the true state - the branch is not published yet - and its next run revises it. The gate is what makes repetition safe, since only a receipt saying the head is on offer stops the revisions, and one PR per work item is ensured, never created twice.\\n\\nTHE TICK HOLDS NO CREDENTIAL AT ALL, and that is what this pass gave up in exchange for the publication boundary. It used to probe GITHUB_TOKEN once per tick and hand the source to every attempt; it now writes a typed request per attempt and reads the answer the publication helper wrote under its own principal. The cost is that a head is published on the SECOND run of its obligation rather than the first: the first writes the request, and the helper's answer arriving is the event that runs it again (the deployment's publication-answer path unit). The gain is that no process holding this token spawns a provider session. See gunbc.roadmap.roadmap_publication_helper for the boundary argument."

// THE PRODUCER NEEDS A LIVE TRIGGER, AND belt_tick IS NOT ONE. belt_tick is the belt's actuation
// pass and nothing calls it — not the serve routes, a timer or the CLI. A pre-existing gap shared
// with the verification pass, wired into the same tick and equally undriven; this lane neither
// created nor closes it.
//
// So wiring publication into belt_tick alone would leave the receipt unproduced in production, the
// exact defect the recut fixes, one layer out. Publication therefore also gets a per-node entry the
// serve table can reach, mirroring belt_dispatch_node_for_instance: an operator presses it, the
// receipt is written, the next read of the row paints from it.
//
// IT RESOLVES THE ATTEMPT ITSELF rather than taking one, because the caller is a route holding only
// a node id. The current attempt pointer is the authority the workflow projection reads, so both
// answer about the same attempt by construction rather than by a matching key.
//
// OBSERVE-ONLY INSTANCES REFUSE, like dispatch: publication performs a network read and a
// filesystem write against an instance's own attempt state, so an observe-only instance must do
// neither — and the refusal names the posture rather than reporting an absence.
fn belt_publish_node_for_instance(
  instance: HostDashboardInstance,
  node_id: String,
) -> BeltPublishOutcome {
  match instance.actuation {
    DashboardObserveOnly =>
      PublishDeferred {
        node_id: node_id,
        reason: join([
          "dashboard instance ",
          instance.instance_id as String,
          " is observe-only, so publication was neither observed nor recorded",
        ], ""),
      }
    DashboardActuating =>
      match belt_transition_admission_for_instance(instance: instance) {
        ActuationRefused { reason: tr } =>
          PublishDeferred {
            node_id: node_id,
            reason: join([belt_publish_transition_inhibited_reason, " ", tr], ""),
          }
        ActuationAdmitted => {
      let key_read = Filesystem.Read(
        path: dispatch_current_attempt_key_path_for_instance(
          instance: instance,
          node_id: node_id as gunbc.roadmap.roadmap_model.RoadmapNodeId,
        ),
      )
      match filesystem_read_outcome(content: key_read.content, success: key_read.success, error: key_read.error) {
        FilesystemReadRefused { error } =>
          PublishDeferred {
            node_id: node_id,
            reason: join(["the node's current-attempt-key pointer could not be read, so whether the node has a current attempt is unknown: ", error], ""),
          }
        FilesystemReadSucceeded { content } =>
          if trim(content) == "" {
            PublishDeferred {
              node_id: node_id,
              reason: "this node has no current attempt, so there is no branch or head for publication to be about",
            }
          } else {
            belt_publish_attempt_for_instance(
              instance: instance,
              node_id: node_id,
              attempt_key: trim(content),
            )
          }
      }
    }
      }
  }
}

// THE WIRE CARRIES THE OUTCOME KEY THE RECEIPT RECORDED, not a rendering of it. A caller that
// pressed publish wants to know which judgment was reached, and re-deriving that from a sentence is
// the prose-parsing the receipt format was rewritten to remove. The detail is beside it for a
// human, never instead.
//
// THE STATUS CODES SPLIT ON WHO HAS TO ACT. A recorded judgment and an already-recorded one are
// both 200: the belt did what was asked and the row is accurate. A deferral is 409 — well formed,
// but the attempt is not in a state where publication means anything yet. Unreadable evidence and a
// failed write are 500: the belt's own problem, and nothing about the request would change them.
//
// A REQUESTED PUBLICATION IS 202, NEITHER OF THE OTHER TWO. Not 200 — nothing has been judged, and
// 200 for a merely queued request is fabricated-plausible-output at the route boundary. Not 409 — a
// deferral says publication MEANS nothing yet, while a request says the question is well formed,
// asked, and will be answered by the publication helper on its next run. Different destinations for
// the operator, so different codes.
fn belt_publish_outcome_key(o: BeltPublishOutcome) -> String {
  match o {
    PublishRecorded { node_id: _, head_sha: _, outcome_key: _ } => "recorded"
    PublishAlreadyRecorded { node_id: _, head_sha: _ } => "already-recorded"
    PublishEvidenceUnreadable { node_id: _, detail: _ } => "evidence-unreadable"
    PublishWriteFailed { node_id: _, detail: _ } => "write-failed"
    PublishDeferred { node_id: _, reason: _ } => "deferred"
    PublishRequested { node_id: _, head_sha: _, request_path: _ } => "requested"
  }
}

fn belt_publish_outcome_node_id(o: BeltPublishOutcome) -> String {
  match o {
    PublishRecorded { node_id, head_sha: _, outcome_key: _ } => node_id
    PublishAlreadyRecorded { node_id, head_sha: _ } => node_id
    PublishEvidenceUnreadable { node_id, detail: _ } => node_id
    PublishWriteFailed { node_id, detail: _ } => node_id
    PublishDeferred { node_id, reason: _ } => node_id
    PublishRequested { node_id, head_sha: _, request_path: _ } => node_id
  }
}

fn belt_publish_outcome_head_sha(o: BeltPublishOutcome) -> String {
  match o {
    PublishRecorded { node_id: _, head_sha, outcome_key: _ } => head_sha
    PublishAlreadyRecorded { node_id: _, head_sha } => head_sha
    PublishRequested { node_id: _, head_sha, request_path: _ } => head_sha
    PublishEvidenceUnreadable { node_id: _, detail: _ } => ""
    PublishWriteFailed { node_id: _, detail: _ } => ""
    PublishDeferred { node_id: _, reason: _ } => ""
  }
}

fn belt_publish_outcome_publication_key(o: BeltPublishOutcome) -> String {
  match o {
    PublishRecorded { node_id: _, head_sha: _, outcome_key } => outcome_key
    PublishAlreadyRecorded { node_id: _, head_sha: _ } => ""
    PublishRequested { node_id: _, head_sha: _, request_path: _ } => ""
    PublishEvidenceUnreadable { node_id: _, detail: _ } => ""
    PublishWriteFailed { node_id: _, detail: _ } => ""
    PublishDeferred { node_id: _, reason: _ } => ""
  }
}

fn belt_publish_outcome_detail(o: BeltPublishOutcome) -> String {
  match o {
    PublishRecorded { node_id: _, head_sha: _, outcome_key: _ } => ""
    PublishAlreadyRecorded { node_id: _, head_sha: _ } => ""
    PublishRequested { node_id: _, head_sha: _, request_path } =>
      join([
        "a publication request for this head is queued for the publication helper and has not yet been answered: ",
        request_path,
      ], "")
    PublishEvidenceUnreadable { node_id: _, detail } => detail
    PublishWriteFailed { node_id: _, detail } => detail
    PublishDeferred { node_id: _, reason } => reason
  }
}

fn belt_publish_outcome_http_status(o: BeltPublishOutcome) -> Int {
  match o {
    PublishRecorded { node_id: _, head_sha: _, outcome_key: _ } => 200
    PublishAlreadyRecorded { node_id: _, head_sha: _ } => 200
    PublishDeferred { node_id: _, reason: _ } => 409
    PublishRequested { node_id: _, head_sha: _, request_path: _ } => 202
    PublishEvidenceUnreadable { node_id: _, detail: _ } => 500
    PublishWriteFailed { node_id: _, detail: _ } => 500
  }
}

fn belt_publish_outcome_json_value(o: BeltPublishOutcome) -> JsonValue {
  json_object(members: [
    json_kv(key: "schema", value: json_string(s: "roadmap-belt-publish/v1")),
    json_kv(key: "outcome", value: json_string(s: belt_publish_outcome_key(o: o))),
    json_kv(key: "node_id", value: json_string(s: belt_publish_outcome_node_id(o: o))),
    json_kv(key: "head_sha", value: json_string(s: belt_publish_outcome_head_sha(o: o))),
    json_kv(
      key: "publication",
      value: json_string(s: belt_publish_outcome_publication_key(o: o)),
    ),
    json_kv(key: "detail", value: json_string(s: belt_publish_outcome_detail(o: o))),
  ])
}

// ── ONE ATTEMPT'S OBLIGATIONS, RUN BY ITS OWN UNIT ─────────────────────────────────────────────
//
// THE TICK NO LONGER CAPTURES, VERIFIES, REVIEWS, AUDITS OR PUBLISHES (dogfood intervention #6,
// gunbc#13124). Each attempt's obligations run in that
// attempt's own unit (gunbc.roadmap.roadmap_belt_obligation belt_attempt_obligation_unit_name), on
// that attempt's evidence, so a slow obligation of one attempt cannot hold another attempt's -- the
// fusion that held every tick at its bound on srv2 for ten hours on 2026-10-03.
//
// Within the unit, each kind is its own ensure over its own evidence authority, and the cores are the
// ones the tick used to call per attempt -- belt_commit_attempt_for_instance,
// belt_verify_attempt_for_instance, belt_review_attempt_for_instance, belt_audit_attempt_for_instance,
// belt_publish_attempt_for_instance -- each idempotent over unchanged evidence, so a duplicated or
// out-of-order trigger is a no-op. Kinds run in eligibility order and the attempt is re-observed after
// each one that ran, so an obligation made eligible by the one before it (a capture that produced a
// candidate makes verify eligible) runs in the same process, and one that is waiting on something
// outside the process (reviewers still running) ends the run. Its next run is the event that ends the
// wait: a reviewer's exit record.

type BeltAttemptProgressRead
  = BeltAttemptProgressFound { progress: WorkflowAttemptProgress }
  | BeltAttemptNotCurrent { reason: String }
  | BeltAttemptProgressRefused { reason: String }

// THE ATTEMPT'S PROJECTED EVIDENCE, read through the same observation the page and the old passes
// used, scoped to its node. Only the node's CURRENT attempt is observed there; an obligation for an
// attempt that is no longer current is not run -- a successor attempt has replaced it, and acting on
// the predecessor would publish or verify a head the node has moved past.
fn belt_attempt_progress_read(instance: HostDashboardInstance, node_id: String, attempt_key: String) -> BeltAttemptProgressRead {
  match belt_workflow_attempts_observe_scoped(instance: instance, scope: WorkflowAttemptsOneNode { node_id: node_id }) {
    WorkflowAttemptsRefused { reason } => BeltAttemptProgressRefused { reason: reason }
    WorkflowAttemptsObserved { attempts } =>
      match (attempts |> filter(p => p.attempt_key == attempt_key)).first() {
        Present { value: p } => BeltAttemptProgressFound { progress: p }
        Absent => BeltAttemptNotCurrent { reason: join(["attempt ", attempt_key, " is not the current attempt of node ", node_id], "") }
      }
  }
}

type BeltAttemptObligationStep {
  kind: BeltAttemptObligationKind
  pass: BeltPassOutcome
  detail: JsonValue
}

// A REVIEW OR AUDIT STEP FAILS ITS PASS when any of its calls failed; a deferred call defers it; a
// spawned or skipped call is recorded -- the spawned reviewer's exit is the step's next event.
fn belt_review_pass_outcome_from(outcomes: List<BeltReviewOutcome>) -> BeltPassOutcome {
  let failed = outcomes |> flat_map(o => match o {
    ReviewFailed { node_id: _, criterion: c, detail: d } => [join([c, ": ", d], "")]
    ReviewSpawned { node_id: _, criterion: _, unit: _ } => [] as List<String>
    ReviewSkipped { node_id: _, criterion: _, reason: _ } => [] as List<String>
    ReviewDeferred { node_id: _, criterion: _, reason: _ } => [] as List<String>
    ReviewPlanSuperseded { node_id: _, stale_verdicts: _, revision: _ } => [] as List<String>
  })
  let deferred = outcomes |> flat_map(o => match o {
    ReviewDeferred { node_id: _, criterion: c, reason: r } => [join([c, ": ", r], "")]
    ReviewFailed { node_id: _, criterion: _, detail: _ } => [] as List<String>
    ReviewSpawned { node_id: _, criterion: _, unit: _ } => [] as List<String>
    ReviewSkipped { node_id: _, criterion: _, reason: _ } => [] as List<String>
    ReviewPlanSuperseded { node_id: _, stale_verdicts: _, revision: _ } => [] as List<String>
  })
  match failed.first() {
    Present { value: f } => BeltPassFailed { reason: join([to_string(count(failed)), " review call(s) failed; first: ", f], "") }
    Absent =>
      match deferred.first() {
        Present { value: d } => BeltPassDeferred { reason: d }
        Absent => BeltPassRecorded
      }
  }
}

// ── THE ACCEPTANCE OUTCOME OF A HAND-IN (gunbc.plans.harness_session_lifecycle, slice S2) ────────────
//
// A worker that hands in waits, alive, for one outcome addressed to its hand-in. This step reduces the
// stage records of the candidate at the attempt's current head (gunbc.roadmap.roadmap_acceptance_outcome
// acceptance_outcome_of_stages) and, once they decide, publishes the outcome record whole: staged
// beside its final path and moved into place, so the session never reads half a decision. Until they
// decide it records nothing and defers; the next stage to finish -- a reviewer's or auditor's exit --
// wakes the attempt again. A hand-in whose id could not be read is refused rather than answered: an
// outcome addressed to no hand-in could finish or steer whichever came next.
type BeltAcceptanceOutcomeResult
  = AcceptanceOutcomePublished { handin: String, head: String, outcome: String }
  | AcceptanceOutcomeUndecided { reason: String }
  | AcceptanceOutcomeRefused { reason: String }

fn belt_acceptance_outcome_path_for_instance(instance: HostDashboardInstance, node_id: RoadmapNodeId, attempt_key: String) -> String {
  join([dispatch_attempt_state_path_for_instance(instance: instance, node_id: node_id, attempt_key: attempt_key), "/", acceptance_outcome_basename as String], "")
}

// WHETHER THE CURRENT HAND-IN STILL AWAITS ITS CAPTURE: the handoff the progress row carries, so the
// outcome is never computed from the stages of a capture this hand-in did not make.
fn belt_handoff_awaits_capture(handoff: CandidateHandoffState) -> Bool {
  match handoff {
    HandoffAwaitingCapture { reason: _ } => true
    _ => false
  }
}

// THE OUTCOME FOR A CAPTURED HAND-IN, pure over the progress row: a hand-in the commit step settled
// without capturing, or whose capture cannot be established, is acceptance unavailable -- written, so
// the session learns it at once rather than at its deadline; otherwise the stages decide.
fn belt_acceptance_outcome_of_progress(handin: String, progress: WorkflowAttemptProgress) -> AcceptanceOutcome? {
  match progress.handoff {
    HandoffYielded { reason } =>
      Present { value: AcceptanceUnavailable { cause: join(["hand-in ", handin, " was not captured: ", reason], "") } }
    HandoffEvidenceRefused { reason } =>
      Present { value: AcceptanceUnavailable { cause: join(["hand-in ", handin, "'s capture cannot be established: ", reason], "") } }
    _ =>
      acceptance_outcome_of_stages(
        verification: workflow_segment_of_kind(segments: progress.segments, kind: VerificationWorkflowSegment),
        review: workflow_segment_of_kind(segments: progress.segments, kind: ReviewWorkflowSegment),
        goal_audit: workflow_segment_of_kind(segments: progress.segments, kind: GoalAuditWorkflowSegment),
      )
  }
}

fn belt_acceptance_outcome_for_instance(instance: HostDashboardInstance, progress: WorkflowAttemptProgress) -> BeltAcceptanceOutcomeResult {
  let node_id = progress.node_id as gunbc.roadmap.roadmap_model.RoadmapNodeId
  let handin = belt_provider_handed_in(provider: progress.provider)
  if handin == "" {
    AcceptanceOutcomeRefused { reason: "the attempt is not awaiting acceptance under a readable hand-in id, so no outcome can be addressed" }
  } else if belt_handoff_awaits_capture(handoff: progress.handoff) {
    AcceptanceOutcomeUndecided { reason: join(["hand-in ", handin, " is not captured yet, so no stage has judged its code"], "") }
  } else {
    match belt_worktree_head_observe(instance: instance, worktree: dispatch_worktree_path_for_instance(instance: instance, node_id: node_id, attempt_key: progress.attempt_key)) {
      WorktreeHeadUnobserved { reason } =>
        AcceptanceOutcomeRefused { reason: join(["the handed-in candidate's head cannot be observed, so an outcome could not name the code it judged: ", reason], "") }
      WorktreeHeadObserved { revision } =>
        match belt_acceptance_outcome_of_progress(handin: handin, progress: progress) {
          Absent => AcceptanceOutcomeUndecided { reason: join(["acceptance is still running for hand-in ", handin], "") }
          Present { value: outcome } => {
            let final_path = belt_acceptance_outcome_path_for_instance(instance: instance, node_id: node_id, attempt_key: progress.attempt_key)
            let staging = join([final_path, ".staging"], "")
            let text = acceptance_outcome_record_text(r: AcceptanceOutcomeRecord { handin: handin, head: revision as String, outcome: outcome })
            let staged = Filesystem.Write(path: staging, content: text)
            if !staged.success {
              AcceptanceOutcomeRefused { reason: join(["the acceptance outcome could not be staged at ", staging, ": ", staged.error], "") }
            } else {
              let moved = shell.Move.File(source: staging as FilePath, destination: final_path as FilePath)
              if moved.success {
                AcceptanceOutcomePublished { handin: handin, head: revision as String, outcome: acceptance_outcome_key(o: outcome) }
              } else {
                AcceptanceOutcomeRefused { reason: join(["the acceptance outcome was staged but could not be moved into place at ", final_path], "") }
              }
            }
          }
        }
    }
  }
}

fn belt_acceptance_outcome_pass(r: BeltAcceptanceOutcomeResult) -> BeltPassOutcome {
  match r {
    AcceptanceOutcomePublished { handin: _, head: _, outcome: _ } => BeltPassRecorded
    AcceptanceOutcomeUndecided { reason } => BeltPassDeferred { reason: reason }
    AcceptanceOutcomeRefused { reason } => BeltPassFailed { reason: reason }
  }
}

fn belt_acceptance_outcome_json(r: BeltAcceptanceOutcomeResult) -> JsonValue {
  match r {
    AcceptanceOutcomePublished { handin, head, outcome } =>
      json_object(members: [
        json_kv(key: "status", value: json_string(s: "published")),
        json_kv(key: "handin", value: json_string(s: handin)),
        json_kv(key: "head", value: json_string(s: head)),
        json_kv(key: "outcome", value: json_string(s: outcome)),
      ])
    AcceptanceOutcomeUndecided { reason } =>
      json_object(members: [json_kv(key: "status", value: json_string(s: "undecided")), json_kv(key: "reason", value: json_string(s: reason))])
    AcceptanceOutcomeRefused { reason } =>
      json_object(members: [json_kv(key: "status", value: json_string(s: "refused")), json_kv(key: "reason", value: json_string(s: reason))])
  }
}

fn belt_attempt_obligation_step(instance: HostDashboardInstance, progress: WorkflowAttemptProgress, kind: BeltAttemptObligationKind) -> BeltAttemptObligationStep {
  match kind {
    CaptureObligation => {
      let o = belt_commit_attempt_for_instance(instance: instance, progress: progress)
      BeltAttemptObligationStep { kind: kind, pass: belt_commit_pass_outcome_from(outcomes: [o]), detail: belt_commit_outcome_json_value(o: o) }
    }
    VerifyObligation => {
      let o = belt_verify_attempt_for_instance(instance: instance, progress: progress)
      BeltAttemptObligationStep { kind: kind, pass: belt_verify_pass_outcome_from(outcomes: [o]), detail: belt_verify_outcome_json(o: o) }
    }
    ReviewObligation => {
      let os = belt_review_attempt_for_instance(instance: instance, progress: progress)
      BeltAttemptObligationStep { kind: kind, pass: belt_review_pass_outcome_from(outcomes: os), detail: json_array(elements: os |> map(o => belt_review_outcome_json(o: o))) }
    }
    AuditObligation => {
      let o = belt_audit_attempt_for_instance(instance: instance, progress: progress)
      BeltAttemptObligationStep { kind: kind, pass: belt_review_pass_outcome_from(outcomes: [o]), detail: belt_review_outcome_json(o: o) }
    }
    AcceptanceOutcomeObligation => {
      let o = belt_acceptance_outcome_for_instance(instance: instance, progress: progress)
      BeltAttemptObligationStep { kind: kind, pass: belt_acceptance_outcome_pass(r: o), detail: belt_acceptance_outcome_json(r: o) }
    }
    PublishObligation => {
      let o = belt_publish_attempt_for_instance(instance: instance, node_id: progress.node_id, attempt_key: progress.attempt_key)
      BeltAttemptObligationStep { kind: kind, pass: belt_publish_pass_outcome_from(outcomes: [o]), detail: belt_publish_outcome_json_value(o: o) }
    }
  }
}

type BeltAttemptObligationsFold {
  read: BeltAttemptProgressRead
  steps: List<BeltAttemptObligationStep>
}

type BeltAttemptObligationRun
  = BeltAttemptObligationsRan { node_id: String, attempt_key: String, steps: List<BeltAttemptObligationStep> }
  | BeltAttemptObligationsNotCurrent { node_id: String, attempt_key: String, reason: String }
  | BeltAttemptObligationsRefused { node_id: String, attempt_key: String, reason: String }

// THE RUN: every kind in eligibility order, each run only if it is outstanding on the evidence as it
// stands when its turn comes. The fold re-observes after each step that ran, so the outstanding test
// for the next kind reads what the previous one wrote. Each kind is visited once, so the run is
// bounded by the number of kinds and never re-runs a kind it already ran (the strictly-downstream
// rule of gunbc.roadmap.roadmap_belt_obligation belt_attempt_next_after, by construction here).
// A refused verification whose cause is the environment's wakes the verify obligation while the bound
// leaves a retry; the obligation then runs belt_verify_retry_gate, which records it.
fn belt_verify_retry_wakes(instance: HostDashboardInstance, progress: WorkflowAttemptProgress, kind: BeltAttemptObligationKind) -> Bool {
  match kind {
    VerifyObligation => refused_retry_owed(standing: belt_verify_retry_standing(instance: instance, progress: progress))
    CaptureObligation => false
    ReviewObligation => false
    AuditObligation => false
    AcceptanceOutcomeObligation => false
    PublishObligation => false
  }
}

fn belt_attempt_obligations_run(instance: HostDashboardInstance, node_id: String, attempt_key: String) -> BeltAttemptObligationRun {
  let folded = fold(belt_attempt_obligation_order, init: BeltAttemptObligationsFold { read: belt_attempt_progress_read(instance: instance, node_id: node_id, attempt_key: attempt_key), steps: [] }, f: fn(acc, kind) {
    match acc.read {
      BeltAttemptProgressFound { progress } =>
        if belt_attempt_obligation_outstanding(kind: kind, provider: progress.provider, segments: progress.segments)
          || belt_verify_retry_wakes(instance: instance, progress: progress, kind: kind) {
          let step = belt_attempt_obligation_step(instance: instance, progress: progress, kind: kind)
          BeltAttemptObligationsFold { read: belt_attempt_progress_read(instance: instance, node_id: node_id, attempt_key: attempt_key), steps: concat(acc.steps, [step]) }
        } else {
          acc
        }
      BeltAttemptNotCurrent { reason: _ } => acc
      BeltAttemptProgressRefused { reason: _ } => acc
    }
  })
  match folded.read {
    BeltAttemptProgressFound { progress: _ } => BeltAttemptObligationsRan { node_id: node_id, attempt_key: attempt_key, steps: folded.steps }
    BeltAttemptNotCurrent { reason } =>
      if count(folded.steps) == 0 { BeltAttemptObligationsNotCurrent { node_id: node_id, attempt_key: attempt_key, reason: reason } } else { BeltAttemptObligationsRan { node_id: node_id, attempt_key: attempt_key, steps: folded.steps } }
    BeltAttemptProgressRefused { reason } =>
      BeltAttemptObligationsRefused { node_id: node_id, attempt_key: attempt_key, reason: join(["the attempt's evidence could not be observed: ", reason, if count(folded.steps) == 0 { "" } else { join([" (after ", to_string(count(folded.steps)), " obligation(s) ran)"], "") }], "") }
  }
}

// ── THE ATTEMPT'S OBLIGATION RECEIPT ───────────────────────────────────────────────────────────
//
// What the attempt's last obligation run did, per kind, at the instance's receipts directory beside
// the tick receipt and named by the attempt. The page reads it where it used to read the tick's
// verify pass: "verification pending" now says what THIS attempt's own run found, not what the last
// pass over every attempt found.
data belt_attempt_obligation_receipt_schema: String = "roadmap-belt-attempt-obligations/v1"

fn belt_attempt_obligation_receipt_path(instance: HostDashboardInstance, node_id: String, attempt_key: String) -> String {
  join([instance_receipts_dir(instance_root: instance.instance_root as String), "/obligations-", node_id, "-", attempt_key, ".json"], "")
}

fn belt_attempt_obligation_step_json(step: BeltAttemptObligationStep) -> JsonValue {
  json_object(members: [
    json_kv(key: "kind", value: json_string(s: belt_attempt_obligation_kind_key(kind: step.kind))),
    json_kv(key: "pass", value: belt_pass_outcome_json(o: step.pass)),
    json_kv(key: "detail", value: step.detail),
  ])
}

fn belt_attempt_obligation_run_json(run: BeltAttemptObligationRun, observed_at: String, claimed: List<String>) -> JsonValue {
  match run {
    BeltAttemptObligationsRan { node_id, attempt_key, steps } =>
      json_object(members: [
        json_kv(key: "schema", value: json_string(s: belt_attempt_obligation_receipt_schema)),
        json_kv(key: "observed_at", value: json_string(s: observed_at)),
        json_kv(key: "claimed_exits", value: json_array(elements: claimed |> map(c => json_string(s: c)))),
        json_kv(key: "node", value: json_string(s: node_id)),
        json_kv(key: "attempt", value: json_string(s: attempt_key)),
        json_kv(key: "standing", value: json_string(s: "ran")),
        json_kv(key: "steps", value: json_array(elements: steps |> map(s => belt_attempt_obligation_step_json(step: s)))),
      ])
    BeltAttemptObligationsNotCurrent { node_id, attempt_key, reason } =>
      json_object(members: [
        json_kv(key: "schema", value: json_string(s: belt_attempt_obligation_receipt_schema)),
        json_kv(key: "observed_at", value: json_string(s: observed_at)),
        json_kv(key: "claimed_exits", value: json_array(elements: claimed |> map(c => json_string(s: c)))),
        json_kv(key: "node", value: json_string(s: node_id)),
        json_kv(key: "attempt", value: json_string(s: attempt_key)),
        json_kv(key: "standing", value: json_string(s: "not-current")),
        json_kv(key: "reason", value: json_string(s: reason)),
      ])
    BeltAttemptObligationsRefused { node_id, attempt_key, reason } =>
      json_object(members: [
        json_kv(key: "schema", value: json_string(s: belt_attempt_obligation_receipt_schema)),
        json_kv(key: "observed_at", value: json_string(s: observed_at)),
        json_kv(key: "claimed_exits", value: json_array(elements: claimed |> map(c => json_string(s: c)))),
        json_kv(key: "node", value: json_string(s: node_id)),
        json_kv(key: "attempt", value: json_string(s: attempt_key)),
        json_kv(key: "standing", value: json_string(s: "refused")),
        json_kv(key: "reason", value: json_string(s: reason)),
      ])
  }
}

// A REFUSED RUN OR A FAILED STEP IS THE RUN'S FAILURE, so the unit ends failed and the journal and the
// receipt both name it (the line stops for this attempt only). Deferred and recorded steps, and an
// attempt that is no longer current, end the unit successfully.
fn belt_attempt_obligation_run_failure(run: BeltAttemptObligationRun) -> String? {
  match run {
    BeltAttemptObligationsRefused { node_id: _, attempt_key: _, reason } => Present { value: reason }
    BeltAttemptObligationsNotCurrent { node_id: _, attempt_key: _, reason: _ } => none
    BeltAttemptObligationsRan { node_id: _, attempt_key: _, steps } =>
      (steps |> flat_map(s => match s.pass {
        BeltPassFailed { reason } => [join([belt_attempt_obligation_kind_key(kind: s.kind), ": ", reason], "")]
        BeltPassRefused { reason } => [join([belt_attempt_obligation_kind_key(kind: s.kind), ": ", reason], "")]
        BeltPassDeferred { reason: _ } => [] as List<String>
        BeltPassRecorded => [] as List<String>
      })).first()
  }
}

fn belt_attempt_obligation_receipt_write(instance: HostDashboardInstance, run: BeltAttemptObligationRun, node_id: String, attempt_key: String, observed_at: String, claimed: List<String>) -> BeltPassOutcome {
  let write = Filesystem.Write(
    path: belt_attempt_obligation_receipt_path(instance: instance, node_id: node_id, attempt_key: attempt_key),
    content: serialize_json(v: belt_attempt_obligation_run_json(run: run, observed_at: observed_at, claimed: claimed)),
  )
  if write.success { BeltPassRecorded } else { BeltPassFailed { reason: join(["the attempt's obligation receipt could not be written: ", write.error], "") } }
}

// ── HANDING AN OBLIGATION TO ITS UNIT ──────────────────────────────────────────────────────────
//
// AN OBLIGATION IS QUEUED BY STARTING ITS UNIT, and the caller returns at once: discovery, the exit
// drain and the attempt run's own tail never wait on the work they hand off. The unit is a transient
// unit in the service user's manager -- the manager that already runs every worker, reviewer and
// auditor this belt launches -- running one `gunbc run` entry of gunbc.roadmap.roadmap_belt_tick_cli, with
// the deployment's spawn root passed in the same variable the belt service is given
// (gunbc.host.host_layout belt_spawn_workdir_env_var), so the unit resolves the same instance.
//
// RuntimeMaxSec IS THE OBLIGATION'S DEADLINE: past it the manager stops the unit, it ends failed, and
// the line stops for that attempt only, loudly. Instance units take instance_obligation_run_bound;
// the attempt unit takes the max of attempt_obligation_run_bound over the attempt kinds.
// CollectMode=inactive-or-failed lets the next trigger reuse the name after a failure; the failure
// itself is kept in the attempt's obligation receipt and the user journal.
data belt_obligation_entry: String = "dag/gunbc/roadmap/roadmap_belt_tick_cli.dag"

fn belt_obligation_unit_command(
  instance: HostDashboardInstance,
  unit: NonEmptyStr,
  function: String,
  args: List<String>,
  stop_hook: NonEmptyStr?,
  run_bound: Second,
) -> SystemdRunCommandReading {
  let repo = instance.repo_root as String
  gunbc_user_work_transient_command(
    unit: unit,
    properties: concat([
      NamedUnitSetting { property: WorkingDirectoryProperty, value: repo as NonEmptyStr },
      NamedUnitSetting { property: RuntimeMaxSecProperty, value: systemd_time_span_of_seconds(d: run_bound) },
      NamedUnitSetting { property: CollectModeProperty, value: "inactive-or-failed" as NonEmptyStr },
      NamedUnitSetting { property: MemoryMax, value: to_string(value: byte_size_count(instance.dispatch_worker_memory_max)) as NonEmptyStr },
    ], match stop_hook {
      Present { value: hook } => [NamedUnitSetting { property: ExecStopPostProperty, value: hook }]
      Absent => [] as List<SystemdRunProperty>
    }),
    setenv_bindings: [SystemdSetenvBinding { name: belt_spawn_workdir_env_var, value: repo as NonEmptyStr }],
    command_argv: belt_function_run_argv(program: instance.serve_binary as String, repo_root: repo, entry: belt_obligation_entry, function: function, args: args),
  )
}

// THE ONE argv BUILDER FOR FIRING A BELT FUNCTION FROM A TRANSIENT UNIT: `<program> run
// --source-root <repo>/dag --source-root <repo>/src/v2 --entry <repo>/<entry> --function <fn> [--arg a]*`.
// Extracted (§2 net concepts, §6b root generalization) so belt_obligation_unit_command and the wake's
// SpawnRouteWake fold arm share ONE spelling instead of each hand-building it. `program` is passed
// resolved so each caller supplies the instance's own serve binary; the pre-existing harness/auditor/
// replay run-argv builders in roadmap_dispatch_actuator share this shape via its
// dispatch_worker_source_root_words and are a named follow-up to route through here once it is placed
// below both modules; roadmap_dashboard_instance's serve argv is a genuine divergence (the `serve`
// verb with --host/--port and relative source-roots), so it correctly does not share this.
fn belt_function_run_argv(program: String, repo_root: String, entry: String, function: String, args: List<String>) -> List<String> {
  concat(
    [
      program,
      "run",
      "--source-root", join([repo_root, "/dag"], ""),
      "--source-root", join([repo_root, "/src/v2"], ""),
      "--entry", join([repo_root, "/", entry], ""),
      "--function", function,
    ],
    args |> flat_map(a => ["--arg", a]),
  )
}

// THE UNIT NAME IS THE HOLD. A loaded unit of the name means the obligation is already being worked:
// that is read from the manager (the same LoadState/SubState read every worker observation makes)
// before starting, and answers Held -- a no-op. A start that then fails is a located refusal; the race
// between the read and the start can only produce that refusal, never a second process.
// THE HOLD DECISION, PURE over the manager's answer for ONE unit name: loaded and live holds, unread
// refuses, anything else may start. It reads nothing but that one unit, which is the whole of #6's
// isolation: another attempt's unit -- running, slow, wedged -- is a different name and never reaches
// this decision.
type BeltObligationHoldDecision
  = BeltObligationMayStart
  | BeltObligationIsHeld
  | BeltObligationHoldUnread { reason: String }

fn belt_obligation_hold_decision(observation: AttemptUnitObservation) -> BeltObligationHoldDecision {
  match observation {
    AttemptUnitActive => BeltObligationIsHeld
    AttemptUnitUnreadable { reason } => BeltObligationHoldUnread { reason: reason }
    AttemptUnitAbsent => BeltObligationMayStart
    AttemptUnitFinished { exit_status: _ } => BeltObligationMayStart
  }
}

fn belt_obligation_enqueue(instance: HostDashboardInstance, unit: NonEmptyStr, function: String, args: List<String>, stop_hook: NonEmptyStr?, run_bound: Second) -> BeltObligationEnqueue {
  match belt_obligation_hold_decision(observation: attempt_unit_observation(unit: unit)) {
    BeltObligationIsHeld => BeltObligationHeld { unit: unit }
    BeltObligationHoldUnread { reason } => BeltObligationEnqueueRefused { unit: unit, reason: join(["the user manager could not be asked whether the unit is loaded: ", reason], "") }
    BeltObligationMayStart => belt_obligation_start(instance: instance, unit: unit, function: function, args: args, stop_hook: stop_hook, run_bound: run_bound)
  }
}

fn belt_obligation_start(instance: HostDashboardInstance, unit: NonEmptyStr, function: String, args: List<String>, stop_hook: NonEmptyStr?, run_bound: Second) -> BeltObligationEnqueue {
  match instance.toolchain.systemd_run {
    Absent => BeltObligationEnqueueRefused { unit: unit, reason: join(["the toolchain for host ", instance.host_identity as String, " declares no systemd-run, and an obligation runs in its own transient unit"], "") }
    Present { value: systemd_run } =>
      match belt_obligation_unit_command(instance: instance, unit: unit, function: function, args: args, stop_hook: stop_hook, run_bound: run_bound) {
        SystemdRunCommandRefused { cause: why } => BeltObligationEnqueueRefused { unit: unit, reason: systemd_run_option_words_refused_cause_detail(cause: why) }
        SystemdRunCommandReady { command: command } =>
          match belt_exec(cmd: dispatch_unit_exec_argv(command: command, resolved_program: systemd_run), workdir: belt_observe_workdir as String) {
            ExecOk { stdout: _ } => BeltObligationStarted { unit: unit }
            ExecFailed { program: _, exit_code, stderr } => BeltObligationEnqueueRefused { unit: unit, reason: join(["systemd-run exited ", to_string(exit_code), ": ", stderr], "") }
            ExecRefused { program: _, reason } => BeltObligationEnqueueRefused { unit: unit, reason: reason }
          }
      }
  }
}

data belt_attempt_obligations_function: String = "belt_attempt_obligations_cli"
data belt_instance_obligation_function: String = "belt_instance_obligation_cli"

// THE ATTEMPT UNIT'S OWN STOP HOOK (claimant-terminal rescue, bold-bee-114 2026-10-09). When the run that
// claimed an exit ends for any reason -- settled, killed at RuntimeMaxSec, stopped with its manager -- the
// manager runs this hook and it records an `obligation` exit entry for the attempt. The drain consumes
// that entry only once the unit is gone, and before it does it moves any claim the dead run left in
// `running` back to `queued`, so a lone orphaned claim starts a new run with no other event. The entry
// is unconditional (a typed argv cannot test "settled"); a settled run leaves nothing to move, so it
// costs one drain and starts nothing, which is why it cannot loop.
fn belt_attempt_obligations_enqueue(instance: HostDashboardInstance, node_id: String, attempt_key: String) -> BeltObligationEnqueue {
  let unit = belt_attempt_obligation_unit_name(node_id: node_id, attempt_key: attempt_key)
  match attempt_exit_hook(instance_root: instance.instance_root as String, node_id: node_id, attempt_key: attempt_key, role: AttemptObligationRole, record_owner: instance.directory_owner) {
    AttemptExitHookRefused { reason } => BeltObligationEnqueueRefused { unit: unit, reason: join(["the attempt unit's stop hook could not be rendered: ", reason as String], "") }
    AttemptExitHookRendered { exec_line } =>
      belt_obligation_enqueue(
        instance: instance,
        unit: unit,
        function: belt_attempt_obligations_function,
        args: [join(["node_id=", node_id], ""), join(["attempt_key=", attempt_key], "")],
        stop_hook: Present { value: exec_line },
        run_bound: belt_attempt_obligation_unit_run_bound(),
      )
  }
}

fn belt_instance_obligation_enqueue(instance: HostDashboardInstance, kind: BeltInstanceObligationKind) -> BeltObligationEnqueue {
  belt_obligation_enqueue(
    instance: instance,
    unit: belt_instance_obligation_unit_name(instance_id: instance.instance_id as String, kind: kind),
    function: belt_instance_obligation_function,
    args: [join(["kind=", belt_instance_obligation_kind_key(kind: kind)], "")],
    stop_hook: Absent,
    run_bound: instance_obligation_run_bound(kind: kind),
  )
}

fn belt_enqueue_operator_follow_ups(instance: HostDashboardInstance, action: BeltOperatorAction) -> List<BeltObligationEnqueue> {
  belt_operator_follow_up_kinds(action: action) |> map(k => belt_instance_obligation_enqueue(instance: instance, kind: k))
}

fn belt_obligation_enqueue_json(e: BeltObligationEnqueue) -> JsonValue {
  match e {
    BeltObligationStarted { unit } => json_object(members: [json_kv(key: "unit", value: json_string(s: unit as String)), json_kv(key: "outcome", value: json_string(s: "started"))])
    BeltObligationHeld { unit } => json_object(members: [json_kv(key: "unit", value: json_string(s: unit as String)), json_kv(key: "outcome", value: json_string(s: "held"))])
    BeltObligationEnqueueRefused { unit, reason } => json_object(members: [json_kv(key: "unit", value: json_string(s: unit as String)), json_kv(key: "outcome", value: json_string(s: "refused")), json_kv(key: "reason", value: json_string(s: reason))])
  }
}

fn belt_obligation_enqueue_pass(enqueues: List<BeltObligationEnqueue>) -> BeltPassOutcome {
  let refused = enqueues |> flat_map(e => match e {
    BeltObligationEnqueueRefused { unit, reason } => [join([unit as String, ": ", reason], "")]
    BeltObligationStarted { unit: _ } => [] as List<String>
    BeltObligationHeld { unit: _ } => [] as List<String>
  })
  match refused.first() {
    Present { value: r } => BeltPassFailed { reason: join([to_string(count(refused)), " obligation(s) could not be handed to their unit; first: ", r], "") }
    Absent => BeltPassRecorded
  }
}

// ── DISCOVERY: THE BOUNDED ANTI-ENTROPY PASS ───────────────────────────────────────────────────
//
// DISCOVERY FINDS AND QUEUES; IT NEVER DOES THE WORK. It reads every current attempt's evidence --
// it must, to know which owe something -- and hands at most belt_discovery_attempt_bound of the ones
// that do to their units, plus the instance obligations a moved record makes owed (not launch: the
// launch pass is what runs discovery, and a worker's exit is what queues launch). It is the recovery backstop for a missed
// event (a reboot between an exit and its drain, an entry left in the inbox), never the primary
// route, and nothing in the product requires it to run on a cadence: events invoke the obligations
// they affect, and this pass is invoked by an event too (a publication answer arriving) or by an
// operator.
type BeltDiscovery
  = BeltDiscovered { owed: Int, enqueues: List<BeltObligationEnqueue> }
  | BeltDiscoveryRefused { reason: String }

// PURE: which attempts are owed something, in observation order, and the bounded prefix to queue.
fn belt_discovery_owed(instance: HostDashboardInstance, attempts: List<WorkflowAttemptProgress>) -> List<WorkflowAttemptProgress> {
  attempts |> filter(p => count(belt_attempt_outstanding(provider: p.provider, segments: p.segments)) > 0
    || refused_retry_owed(standing: belt_verify_retry_standing(instance: instance, progress: p)))
}

fn belt_discover_for_instance(instance: HostDashboardInstance) -> BeltDiscovery {
  match belt_workflow_attempts_observe_for_instance(instance: instance) {
    WorkflowAttemptsRefused { reason } => BeltDiscoveryRefused { reason: join(["the attempts ledger is unobservable, so no outstanding obligation can be discovered: ", reason], "") }
    WorkflowAttemptsObserved { attempts } => {
      let owed = belt_discovery_owed(instance: instance, attempts: attempts)
      BeltDiscovered {
        owed: count(owed),
        enqueues: concat(
          owed.take(belt_discovery_attempt_bound) |> map(p => belt_attempt_obligations_enqueue(instance: instance, node_id: p.node_id, attempt_key: p.attempt_key)),
          belt_record_moved_obligation_kinds |> map(k => belt_instance_obligation_enqueue(instance: instance, kind: k)),
        ),
      }
    }
  }
}

fn belt_discovery_json(discovery: BeltDiscovery) -> JsonValue {
  match discovery {
    BeltDiscovered { owed, enqueues } =>
      json_object(members: [
        json_kv(key: "standing", value: json_string(s: "discovered")),
        json_kv(key: "owed", value: json_int(n: owed)),
        json_kv(key: "bound", value: json_int(n: belt_discovery_attempt_bound)),
        json_kv(key: "enqueues", value: json_array(elements: enqueues |> map(e => belt_obligation_enqueue_json(e: e)))),
      ])
    BeltDiscoveryRefused { reason } =>
      json_object(members: [
        json_kv(key: "standing", value: json_string(s: "refused")),
        json_kv(key: "reason", value: json_string(s: reason)),
      ])
  }
}

// THE TICK RECEIPT'S DISCOVERY PASS: refused when the ledger could not be read, failed when an
// obligation could not be handed to its unit, recorded otherwise. Owed attempts past the bound are not
// a failure: they are still owed, and the next pass or their own events find them.
fn belt_discovery_pass_outcome(discovery: BeltDiscovery) -> BeltPassOutcome {
  match discovery {
    BeltDiscoveryRefused { reason } => BeltPassRefused { reason: reason }
    BeltDiscovered { owed: _, enqueues } => belt_obligation_enqueue_pass(enqueues: enqueues)
  }
}

// ── READING AN ATTEMPT'S OBLIGATION RECEIPT ────────────────────────────────────────────────────
//
// What the page needs from it is the verify step's pass, when the last run took one. An absent
// receipt means no obligation has run for the attempt yet; an unreadable one is never read as absent.
type BeltAttemptObligationReceiptRead
  = BeltAttemptObligationReceiptPresent { verify: BeltPassOutcome? }
  | BeltAttemptObligationReceiptAbsent
  | BeltAttemptObligationReceiptUnreadable { reason: String }

// THE DECODER IS TOTAL AND SUBJECT-BOUND (bold-bee-114, 2026-10-09): the receipt names its node and attempt and
// both must equal the requested subject, a foreign receipt never reads as this attempt's; observed_at and the
// run's standing are decoded and validated; every step is decoded, each kind at most once, an unknown kind, a
// malformed kind member or a malformed pass refuses; only then is verify projected.
type BeltObligationStepsDecode
  = BeltObligationStepsDecoded { kinds: List<String>, verify: BeltPassOutcome? }
  | BeltObligationStepsUnreadable { reason: String }

fn belt_attempt_obligation_receipt_unreadable(reason: String) -> BeltAttemptObligationReceiptRead {
  BeltAttemptObligationReceiptUnreadable { reason: join(["attempt obligation receipt: ", reason], "") }
}

fn belt_attempt_obligation_receipt_string_member(doc: JsonValue, key: String) -> String? {
  match json_required_string_member(doc: doc, key: key) {
    JsonStringMemberFound { value: v } => Present { value: v }
    JsonStringMemberRefused { reason: _ } => none
  }
}

fn belt_attempt_obligation_steps_decode(steps: List<JsonValue>) -> BeltObligationStepsDecode {
  let known = belt_attempt_obligation_order |> map(k => belt_attempt_obligation_kind_key(kind: k))
  fold(steps, init: BeltObligationStepsDecoded { kinds: [], verify: none }, f: fn(acc, step) {
    match acc {
      BeltObligationStepsUnreadable { reason: _ } => acc
      BeltObligationStepsDecoded { kinds, verify } =>
        match json_required_string_member(doc: step, key: "kind") {
          JsonStringMemberRefused { reason } => BeltObligationStepsUnreadable { reason: join(["a step has no readable kind: ", reason], "") }
          JsonStringMemberFound { value: k } =>
            if !any(known, kk => kk == k) {
              BeltObligationStepsUnreadable { reason: join(["a step names the unknown kind ", k], "") }
            } else if any(kinds, kk => kk == k) {
              BeltObligationStepsUnreadable { reason: join(["the ", k, " step appears more than once"], "") }
            } else {
              match belt_pass_outcome_from_member(doc: step, key: "pass") {
                BeltPassOutcomeUnreadable { reason } => BeltObligationStepsUnreadable { reason: join(["the ", k, " step: ", reason], "") }
                BeltPassOutcomeDecoded { outcome } =>
                  BeltObligationStepsDecoded {
                    kinds: concat(kinds, [k]),
                    verify: if k == belt_attempt_obligation_kind_key(kind: VerifyObligation) { Present { value: outcome } } else { verify },
                  }
              }
            }
        }
    }
  })
}

fn belt_attempt_obligation_receipt_decode(raw: String, node_id: String, attempt_key: String) -> BeltAttemptObligationReceiptRead {
  match parse_json_document(s: raw) {
    JsonDocumentUnreadable { gap } => BeltAttemptObligationReceiptUnreadable { reason: concat("the attempt obligation receipt is ", json_document_gap_text(gap: gap)) }
    JsonDocumentParsed { value: doc } =>
      match belt_attempt_obligation_receipt_string_member(doc: doc, key: "schema") {
        Absent => belt_attempt_obligation_receipt_unreadable(reason: "schema is missing")
        Present { value: schema } =>
          if schema != belt_attempt_obligation_receipt_schema {
            belt_attempt_obligation_receipt_unreadable(reason: "schema is unknown")
          } else {
            match belt_attempt_obligation_receipt_string_member(doc: doc, key: "node") {
              Absent => belt_attempt_obligation_receipt_unreadable(reason: "node is missing")
              Present { value: node } =>
                match belt_attempt_obligation_receipt_string_member(doc: doc, key: "attempt") {
                  Absent => belt_attempt_obligation_receipt_unreadable(reason: "attempt is missing")
                  Present { value: attempt } =>
                    if node != node_id || attempt != attempt_key {
                      belt_attempt_obligation_receipt_unreadable(reason: join(["it is for ", node, "/", attempt, ", not the requested ", node_id, "/", attempt_key], ""))
                    } else {
                      match belt_attempt_obligation_receipt_string_member(doc: doc, key: "observed_at") {
                        Absent => belt_attempt_obligation_receipt_unreadable(reason: "observed_at is missing")
                        Present { value: observed_at } =>
                          if string_length(s: observed_at) == 0 {
                            belt_attempt_obligation_receipt_unreadable(reason: "observed_at is empty")
                          } else if !belt_attempt_obligation_receipt_claim_is_strings(doc: doc) {
                            belt_attempt_obligation_receipt_unreadable(reason: "claimed_exits is missing, duplicated or not an array of strings")
                          } else {
                            match belt_attempt_obligation_receipt_string_member(doc: doc, key: "standing") {
                              Absent => belt_attempt_obligation_receipt_unreadable(reason: "standing is missing")
                              Present { value: standing } => belt_attempt_obligation_receipt_by_standing(doc: doc, standing: standing)
                            }
                          }
                      }
                    }
                }
            }
          }
      }
  }
}

// THE CLAIM THE RUN SETTLED AGAINST is part of the receipt: a ran, not-current or refused receipt all
// name it, and a receipt whose claim cannot be read is unreadable rather than assumed empty.
fn belt_attempt_obligation_receipt_claim_is_strings(doc: JsonValue) -> Bool {
  match json_object_unique_member(v: doc, key: "claimed_exits") {
    JsonMemberFound { value: JsonArray { elements } } =>
      all(elements, e => match e { JsonString { value: _ } => true _ => false })
    _ => false
  }
}

fn belt_attempt_obligation_receipt_by_standing(doc: JsonValue, standing: String) -> BeltAttemptObligationReceiptRead {
  if standing == "ran" {
    match json_object_unique_member(v: doc, key: "steps") {
      JsonMemberFound { value: JsonArray { elements } } =>
        match belt_attempt_obligation_steps_decode(steps: elements) {
          BeltObligationStepsUnreadable { reason } => belt_attempt_obligation_receipt_unreadable(reason: reason)
          BeltObligationStepsDecoded { kinds: _, verify } => BeltAttemptObligationReceiptPresent { verify: verify }
        }
      JsonMemberAbsent => belt_attempt_obligation_receipt_unreadable(reason: "a ran receipt has no steps")
      JsonMemberFound { value: _ } => belt_attempt_obligation_receipt_unreadable(reason: "steps is not an array")
      JsonMemberDuplicated { count: _ } => belt_attempt_obligation_receipt_unreadable(reason: "steps is duplicated")
      JsonMemberNotAnObject => belt_attempt_obligation_receipt_unreadable(reason: "it is not an object")
    }
  } else if standing == "not-current" || standing == "refused" {
    match belt_attempt_obligation_receipt_string_member(doc: doc, key: "reason") {
      Present { value: _ } => BeltAttemptObligationReceiptPresent { verify: none }
      Absent => belt_attempt_obligation_receipt_unreadable(reason: join(["a ", standing, " receipt has no reason"], ""))
    }
  } else {
    belt_attempt_obligation_receipt_unreadable(reason: join(["standing ", standing, " is unknown"], ""))
  }
}

fn belt_attempt_obligation_receipt_read(instance: HostDashboardInstance, node_id: String, attempt_key: String) -> BeltAttemptObligationReceiptRead {
  match filesystem_file_observation_of_path(path: belt_attempt_obligation_receipt_path(instance: instance, node_id: node_id, attempt_key: attempt_key)) {
    FilesystemFileAbsent(_) => BeltAttemptObligationReceiptAbsent
    FilesystemFileRead { path: _, content } => belt_attempt_obligation_receipt_decode(raw: content, node_id: node_id, attempt_key: attempt_key)
    FilesystemFileIndeterminate { cause } => BeltAttemptObligationReceiptUnreadable { reason: cause }
    FilesystemFileObservationsDisagree { path: _, cause } => BeltAttemptObligationReceiptUnreadable { reason: cause }
    FilesystemFileSubjectRefused { directory: _, name: _, cause } => BeltAttemptObligationReceiptUnreadable { reason: cause }
  }
}

// ── THE EXIT DRAIN ─────────────────────────────────────────────────────────────────────────────
//
// A RECORDED EXIT IS HANDED TO ITS ATTEMPT'S OBLIGATION UNIT, and that is all the drain does (dogfood
// intervention #4: with no timer, a worker's exit is what causes its capture to run). The deployment's
// exit path unit starts the drain while the inbox is not empty. Each entry is CLAIMED in the same pass:
// to `queued` when it is a record (the sweep then hands its attempt to the unit), or to `refused` when it
// is not -- a refused entry stays on disk, because the exit it records still happened and the process
// observer still reads it. An entry the drain cannot move is BeltExitEntryUnmovable: typed, counted,
// failing the pass, left on disk, and it has handed nothing to anyone.
//
// A WORKER'S EXIT ALSO QUEUES LAUNCH: its slot is free, so the ready frontier may admit the next
// attempt. A reviewer's or auditor's exit does not -- it frees no worker capacity.
type BeltExitDrainEntry
  = BeltExitEntryHanded { entry: String, enqueue: BeltObligationEnqueue }
  | BeltExitEntryClaimed { entry: String }
  | BeltExitEntryRefused { entry: String, reason: String }
  | BeltExitEntryUnmovable { entry: String, step: SpoolStallStep, cause: String }

type BeltExitDrain
  = BeltExitDrained { entries: List<BeltExitDrainEntry>, launch: BeltObligationEnqueue? }
  | BeltExitDrainRefused { reason: String }

fn belt_exit_entry_move(instance: HostDashboardInstance, entry: String, from: HostSpoolStage, to: HostSpoolStage) -> String? {
  belt_exit_entry_move_at(root: instance.instance_root as String, entry: entry, from: from, to: to)
}

fn belt_exit_entry_move_at(root: String, entry: String, from: HostSpoolStage, to: HostSpoolStage) -> String? {
  let cmd = mv_exact_destination_command(
    source: join([attempt_exit_spool_stage_dir(instance_root: root, stage: from), "/", entry], ""),
    destination: join([attempt_exit_spool_stage_dir(instance_root: root, stage: to), "/", entry], ""),
  )
  match belt_exec(cmd: host_exec_argv(program: cmd.program.invocation as String, args: cmd.arguments), workdir: belt_observe_workdir as String) {
    ExecOk { stdout: _ } => none
    ExecFailed { program: _, exit_code, stderr } => Present { value: join(["mv exited ", to_string(exit_code), ": ", stderr], "") }
    ExecRefused { program: _, reason } => Present { value: reason }
  }
}

// THE DRAIN'S ONLY ENTRY OPERATION IS THE CLAIM: inbox -> queued (or inbox -> refused for a name that is
// not a record). CLAIM FIRST, then hand off: `queued` is the durable record of a pending hand-off and
// belt_exit_queued_sweep_at, run in the same pass after every claim, is the SOLE hand-off. The earlier
// shape enqueued the attempt's obligation and only then moved the entry, so a move that failed left an
// effect the next pass repeated (refusal_decided_after_a_mutation). A claim that fails has no effect to
// repeat: the entry is BeltExitEntryUnmovable, typed and counted, and stays on disk as evidence.
//
// THE MOVE IS SUPPLIED. Production passes belt_exit_entry_move_at; a witness passes a move that refuses a
// named entry, because an entry the drain's principal cannot rename (a root-owned directory) is not
// authorable in unprivileged CI.
fn belt_exit_entry_drain_at(root: String, entry: String, move: fn(String, String, HostSpoolStage, HostSpoolStage) -> String?) -> BeltExitDrainEntry {
  match attempt_exit_entry_decode(entry_name: entry) {
    AttemptExitEntryMalformed { entry_name: _, reason } =>
      match move(root, entry, AttemptExitInbox, AttemptExitRefused) {
        Absent => BeltExitEntryRefused { entry: entry, reason: join(["not an exit record: ", reason], "") }
        Present { value: why } => BeltExitEntryUnmovable { entry: entry, step: SpoolStallMove { from: AttemptExitInbox, to: AttemptExitRefused }, cause: why }
      }
    AttemptExitEntryDecoded { record: _ } => belt_exit_entry_claim_at(root: root, entry: entry, move: move)
    AttemptHandInEntryDecoded { node_id: _, attempt_key: _, handin: _, entry_name: _ } => belt_exit_entry_claim_at(root: root, entry: entry, move: move)
  }
}

// A RECORD -- an exit or a hand-in -- IS CLAIMED into `queued`; the sweep hands its attempt off.
fn belt_exit_entry_claim_at(root: String, entry: String, move: fn(String, String, HostSpoolStage, HostSpoolStage) -> String?) -> BeltExitDrainEntry {
  match move(root, entry, AttemptExitInbox, AttemptExitQueued) {
    Absent => BeltExitEntryClaimed { entry: entry }
    Present { value: why } => BeltExitEntryUnmovable { entry: entry, step: SpoolStallMove { from: AttemptExitInbox, to: AttemptExitQueued }, cause: why }
  }
}

fn belt_exit_entry_is_worker(entry: String) -> Bool {
  match attempt_exit_entry_decode(entry_name: entry) {
    AttemptExitEntryDecoded { record } => attempt_role_token_is_worker(token: record.role)
    AttemptHandInEntryDecoded { node_id: _, attempt_key: _, handin: _, entry_name: _ } => false
    AttemptExitEntryMalformed { entry_name: _, reason: _ } => false
  }
}

// THE ORPHAN RECONCILIATION: a `running` entry whose attempt unit is not live has no owner, so it goes
// back to `queued` where the sweep starts a new run that adopts it. Both rescues end here -- the stop
// hook's `obligation` entry (the unit ended while the manager was up) and the drain's own start (boot,
// where no hook ran) -- so a lone orphaned claim recovers with no exit, answer, launch or operator
// action. A live unit keeps its claim; an unreadable manager leaves it and says so.
fn belt_exit_running_reconcile_at(root: String, observe: fn(String, String) -> AttemptUnitObservation, move: fn(String, String, HostSpoolStage, HostSpoolStage) -> String?) -> List<BeltExitDrainEntry> {
  match attempt_exit_stage_list(instance_root: root, stage: AttemptExitRunning) {
    AttemptExitStageUnreadable { reason } => [BeltExitEntryRefused { entry: "running", reason: reason }]
    AttemptExitStageNames { names } =>
      names |> flat_map(n => match attempt_exit_entry_decode(entry_name: n) {
        AttemptExitEntryMalformed { entry_name: _, reason } => [BeltExitEntryRefused { entry: n, reason: join(["running entry is not an exit record: ", reason], "") }]
        AttemptHandInEntryDecoded { node_id, attempt_key, handin: _, entry_name: _ } => belt_exit_running_entry_reconcile_at(root: root, entry: n, unit: observe(node_id, attempt_key), move: move)
        AttemptExitEntryDecoded { record } => belt_exit_running_entry_reconcile_at(root: root, entry: n, unit: observe(record.node_id, record.attempt_key), move: move)
      })
  }
}

fn belt_exit_running_entry_reconcile_at(root: String, entry: String, unit: AttemptUnitObservation, move: fn(String, String, HostSpoolStage, HostSpoolStage) -> String?) -> List<BeltExitDrainEntry> {
  match unit {
    AttemptUnitActive => [] as List<BeltExitDrainEntry>
    AttemptUnitUnreadable { reason } => [BeltExitEntryRefused { entry: entry, reason: join(["the user manager could not say whether the claiming unit is live: ", reason], "") }]
    AttemptUnitAbsent => belt_exit_orphan_requeue_at(root: root, entry: entry, move: move)
    AttemptUnitFinished { exit_status: _ } => belt_exit_orphan_requeue_at(root: root, entry: entry, move: move)
  }
}

fn belt_exit_orphan_requeue_at(root: String, entry: String, move: fn(String, String, HostSpoolStage, HostSpoolStage) -> String?) -> List<BeltExitDrainEntry> {
  match move(root, entry, AttemptExitRunning, AttemptExitQueued) {
    Absent => [] as List<BeltExitDrainEntry>
    Present { value: why } => [BeltExitEntryUnmovable { entry: entry, step: SpoolStallMove { from: AttemptExitRunning, to: AttemptExitQueued }, cause: why }]
  }
}

fn belt_exit_entry_is_obligation(entry: String) -> Bool {
  match attempt_exit_entry_decode(entry_name: entry) {
    AttemptExitEntryDecoded { record } => record.role == attempt_unit_role_token(role: AttemptObligationRole)
    AttemptHandInEntryDecoded { node_id: _, attempt_key: _, handin: _, entry_name: _ } => false
    AttemptExitEntryMalformed { entry_name: _, reason: _ } => false
  }
}

// THE OBLIGATION ENTRY IS A WAKE-UP, NOT A HAND-OFF. Consumed (inbox -> done) only once its attempt's unit
// is gone -- the hook writes while the unit is still stopping, and consuming it then would lose the very
// rescue it exists for; a live unit leaves it in the inbox and the level fires again. It is never enqueued.
fn belt_exit_obligation_entry_at(root: String, entry: String, observe: fn(String, String) -> AttemptUnitObservation, move: fn(String, String, HostSpoolStage, HostSpoolStage) -> String?) -> List<BeltExitDrainEntry> {
  match attempt_exit_entry_decode(entry_name: entry) {
    AttemptExitEntryMalformed { entry_name: _, reason } => [BeltExitEntryRefused { entry: entry, reason: reason }]
    AttemptHandInEntryDecoded { node_id: _, attempt_key: _, handin: _, entry_name: _ } =>
      [BeltExitEntryRefused { entry: entry, reason: "a hand-in record reached the obligation-rescue path, which reads only obligation exits" }]
    AttemptExitEntryDecoded { record } =>
      match observe(record.node_id, record.attempt_key) {
        AttemptUnitActive => [] as List<BeltExitDrainEntry>
        AttemptUnitUnreadable { reason } => [BeltExitEntryRefused { entry: entry, reason: join(["the user manager could not say whether the unit is live: ", reason], "") }]
        AttemptUnitAbsent => belt_exit_obligation_entry_consume_at(root: root, entry: entry, move: move)
        AttemptUnitFinished { exit_status: _ } => belt_exit_obligation_entry_consume_at(root: root, entry: entry, move: move)
      }
  }
}

fn belt_exit_obligation_entry_consume_at(root: String, entry: String, move: fn(String, String, HostSpoolStage, HostSpoolStage) -> String?) -> List<BeltExitDrainEntry> {
  match move(root, entry, AttemptExitInbox, AttemptExitDone) {
    Absent => [] as List<BeltExitDrainEntry>
    Present { value: why } => [BeltExitEntryUnmovable { entry: entry, step: SpoolStallMove { from: AttemptExitInbox, to: AttemptExitDone }, cause: why }]
  }
}

fn belt_exit_drain_at(root: String, enqueue: fn(String, String) -> BeltObligationEnqueue, launch: fn() -> BeltObligationEnqueue, observe: fn(String, String) -> AttemptUnitObservation) -> BeltExitDrain {
  belt_exit_drain_moving_at(root: root, enqueue: enqueue, launch: launch, observe: observe, move: (r, e, from, to) => belt_exit_entry_move_at(root: r, entry: e, from: from, to: to))
}

// The sweep runs after every claim in this pass: the claims are bound first, and the sweep lists `queued`
// afterwards, so a claimed entry is handed in the pass that claimed it. A worker's launch is owed only for
// a worker entry whose claim succeeded.
fn belt_exit_drain_moving_at(root: String, enqueue: fn(String, String) -> BeltObligationEnqueue, launch: fn() -> BeltObligationEnqueue, observe: fn(String, String) -> AttemptUnitObservation, move: fn(String, String, HostSpoolStage, HostSpoolStage) -> String?) -> BeltExitDrain {
  match attempt_exit_stage_list(instance_root: root, stage: AttemptExitInbox) {
    AttemptExitStageUnreadable { reason } => BeltExitDrainRefused { reason: reason }
    AttemptExitStageNames { names: inbox } => {
      let reconciled = belt_exit_running_reconcile_at(root: root, observe: observe, move: move)
      let rescues = inbox |> filter(n => belt_exit_entry_is_obligation(entry: n))
      let names = inbox |> filter(n => !belt_exit_entry_is_obligation(entry: n))
      let rescued = rescues |> flat_map(n => belt_exit_obligation_entry_at(root: root, entry: n, observe: observe, move: move))
      let claims = names |> map(n => belt_exit_entry_drain_at(root: root, entry: n, move: move))
      let swept = belt_exit_queued_sweep_at(root: root, enqueue: enqueue)
      let claimed_a_worker = any(claims, c => match c {
        BeltExitEntryClaimed { entry } => belt_exit_entry_is_worker(entry: entry)
        _ => false
      })
      BeltExitDrained {
        entries: concat(concat(reconciled, rescued), concat(claims, swept)),
        launch: if claimed_a_worker { Present { value: launch() } } else { none },
      }
    }
  }
}

// THE SESSIONS' HAND-INS ARE RELAYED INTO THE EXIT INBOX BY THE DRAIN, AS THE SERVICE USER, BEFORE THE
// INBOX IS LISTED. A session writes its hand-in entry into its own attempt's hand-in directory
// (gunbc.roadmap.roadmap_dispatch_actuator dispatch_attempt_handin_dir_for_instance), the one place it can
// write; the exit inbox is the manager's, and a confined unit that could write it could record an exit or a
// hand-in for any attempt (gunbc.roadmap.roadmap_attempt_exit_spool). The root launcher binds a path unit to
// that directory that starts this drain. Each pass looks at every node's CURRENT attempt -- the only attempt a
// live session belongs to -- and moves an entry that decodes as a hand-in naming that node and attempt into
// the inbox, where the claim below takes it like any other entry. Anything else in the directory -- a
// hand-in naming another attempt, or a name that is not a hand-in -- is moved to the refused stage and
// reported, never left: a non-empty directory keeps its path unit firing. An attempt whose directory is
// absent (dispatched before the directory existed) has nothing to relay, which a listing establishes; an
// unreadable state is reported, never read as empty.
fn belt_handin_relay_for_instance(instance: HostDashboardInstance) -> List<BeltExitDrainEntry> {
  let root = dashboard_instance_dispatch_attempt_state_root(instance: instance) as String
  let listing = Filesystem.List(path: root)
  match filesystem_listing_observation(directory: root, success: listing.success, entries: listing.entries, error: listing.error) {
    FilesystemDirectoryListingRefused { directory: d, error } =>
      [BeltExitEntryRefused { entry: d as String, reason: join(["hand-ins not relayed: the attempt-state root could not be listed: ", error], "") }]
    FilesystemDirectorySubjectRefused { directory: d, cause } =>
      [BeltExitEntryRefused { entry: d, reason: join(["hand-ins not relayed: the attempt-state root is not an admissible directory: ", cause], "") }]
    FilesystemDirectoryListed(admitted) =>
      filesystem_listing_entry_names(listing: admitted)
        |> filter(n => ends_with(s: n, suffix: belt_current_attempt_suffix))
        |> flat_map(n => belt_handin_relay_node(instance: instance, node_id: substring(s: n, start: 0, end: string_length(s: n) - string_length(s: belt_current_attempt_suffix))))
  }
}

data belt_current_attempt_suffix: String = "-current"

fn belt_handin_relay_node(instance: HostDashboardInstance, node_id: String) -> List<BeltExitDrainEntry> {
  let key_path = dispatch_current_attempt_key_path_for_instance(instance: instance, node_id: node_id as RoadmapNodeId)
  let key_read = Filesystem.Read(path: key_path)
  let attempt_key = trim(s: key_read.content)
  if !key_read.success || attempt_key == "" {
    [BeltExitEntryRefused { entry: key_path, reason: join(["hand-ins not relayed for ", node_id, ": its current attempt key could not be read: ", key_read.error], "") }]
  } else {
    let worker_dir = path_parent_directory(path: dispatch_attempt_handin_dir_for_instance(instance: instance, node_id: node_id as RoadmapNodeId, attempt_key: attempt_key))
    let worker_listing = Filesystem.List(path: worker_dir)
    match filesystem_entry_presence(
      listing: filesystem_listing_observation(directory: worker_dir, success: worker_listing.success, entries: worker_listing.entries, error: worker_listing.error),
      name: belt_handin_dir_name,
    ) {
      FilesystemEntryAbsent(_) => [] as List<BeltExitDrainEntry>
      FilesystemEntryPresenceIndeterminate { cause } =>
        [BeltExitEntryRefused { entry: worker_dir, reason: join(["hand-ins not relayed for ", node_id, ": ", cause], "") }]
      FilesystemEntrySubjectRefused { directory: _, name: _, cause } =>
        [BeltExitEntryRefused { entry: worker_dir, reason: join(["hand-ins not relayed for ", node_id, ": ", cause], "") }]
      FilesystemEntryListed { directory: _, name: _ } =>
        belt_handin_relay_directory(root: instance.instance_root as String, dir: dispatch_attempt_handin_dir_for_instance(instance: instance, node_id: node_id as RoadmapNodeId, attempt_key: attempt_key), node_id: node_id, attempt_key: attempt_key)
    }
  }
}

data belt_handin_dir_name: String = "handin"

fn belt_handin_relay_directory(root: String, dir: String, node_id: String, attempt_key: String) -> List<BeltExitDrainEntry> {
  let listing = Filesystem.List(path: dir)
  match filesystem_listing_observation(directory: dir, success: listing.success, entries: listing.entries, error: listing.error) {
    FilesystemDirectoryListingRefused { directory: d, error } =>
      [BeltExitEntryRefused { entry: d as String, reason: join(["hand-ins not relayed: the hand-in directory could not be listed: ", error], "") }]
    FilesystemDirectorySubjectRefused { directory: d, cause } =>
      [BeltExitEntryRefused { entry: d, reason: join(["hand-ins not relayed: the hand-in directory is not admissible: ", cause], "") }]
    FilesystemDirectoryListed(admitted) =>
      filesystem_listing_entry_names(listing: admitted)
        |> flat_map(entry => belt_handin_relay_entry(root: root, dir: dir, node_id: node_id, attempt_key: attempt_key, entry: entry))
  }
}

// PURE: whether an entry found in an attempt's hand-in directory is a hand-in for THAT attempt. The name is
// the whole claim (gunbc.roadmap.roadmap_attempt_exit_spool attempt_handin_entry_name), so a session can
// only ever hand in for the attempt whose directory it can write.
fn belt_handin_entry_is_own(entry: String, node_id: String, attempt_key: String) -> Bool {
  match attempt_exit_entry_decode(entry_name: entry) {
    AttemptHandInEntryDecoded { node_id: n, attempt_key: k, handin: _, entry_name: _ } => n == node_id && k == attempt_key
    AttemptExitEntryDecoded { record: _ } => false
    AttemptExitEntryMalformed { entry_name: _, reason: _ } => false
  }
}

fn belt_handin_relay_entry(root: String, dir: String, node_id: String, attempt_key: String, entry: String) -> List<BeltExitDrainEntry> {
  let own = belt_handin_entry_is_own(entry: entry, node_id: node_id, attempt_key: attempt_key)
  let stage = if own { AttemptExitInbox } else { AttemptExitRefused }
  let cmd = mv_exact_destination_command(
    source: join([dir, "/", entry], ""),
    destination: join([attempt_exit_spool_stage_dir(instance_root: root, stage: stage), "/", entry], ""),
  )
  match belt_exec(cmd: host_exec_argv(program: cmd.program.invocation as String, args: cmd.arguments), workdir: belt_observe_workdir as String) {
    ExecOk { stdout: _ } =>
      if own { [] as List<BeltExitDrainEntry> } else {
        [BeltExitEntryRefused { entry: entry, reason: join(["the hand-in directory of ", node_id, "/", attempt_key, " held an entry that is not a hand-in for that attempt; moved to refused"], "") }]
      }
    ExecFailed { program: _, exit_code, stderr } =>
      [BeltExitEntryRefused { entry: entry, reason: join(["the hand-in could not be relayed from ", dir, ": mv exited ", to_string(exit_code), ": ", stderr], "") }]
    ExecRefused { program: _, reason } =>
      [BeltExitEntryRefused { entry: entry, reason: join(["the hand-in could not be relayed from ", dir, ": ", reason], "") }]
  }
}

fn belt_exit_drain_for_instance(instance: HostDashboardInstance) -> BeltExitDrain {
  let relayed = belt_handin_relay_for_instance(instance: instance)
  match belt_exit_drain_at(
    root: instance.instance_root as String,
    enqueue: (node_id, attempt_key) => belt_attempt_obligations_enqueue(instance: instance, node_id: node_id, attempt_key: attempt_key),
    launch: fn() { belt_instance_obligation_enqueue(instance: instance, kind: LaunchObligation) },
    observe: (node_id, attempt_key) => attempt_unit_observation(unit: belt_attempt_obligation_unit_name(node_id: node_id, attempt_key: attempt_key)),
  ) {
    BeltExitDrained { entries, launch } => BeltExitDrained { entries: concat(relayed, entries), launch: launch }
    BeltExitDrainRefused { reason } => BeltExitDrainRefused { reason: reason }
  }
}

fn belt_exit_drain_entry_json(e: BeltExitDrainEntry) -> JsonValue {
  match e {
    BeltExitEntryHanded { entry, enqueue } => json_object(members: [json_kv(key: "entry", value: json_string(s: entry)), json_kv(key: "handed", value: belt_obligation_enqueue_json(e: enqueue))])
    BeltExitEntryClaimed { entry } => json_object(members: [json_kv(key: "entry", value: json_string(s: entry)), json_kv(key: "claimed", value: json_string(s: "queued"))])
    BeltExitEntryRefused { entry, reason } => json_object(members: [json_kv(key: "entry", value: json_string(s: entry)), json_kv(key: "refused", value: json_string(s: reason))])
    BeltExitEntryUnmovable { entry, step, cause } => json_object(members: [json_kv(key: "entry", value: json_string(s: entry)), json_kv(key: "unmovable", value: json_object(members: [json_kv(key: "step", value: json_string(s: spool_stall_step_text(step: step))), json_kv(key: "cause", value: json_string(s: cause))]))])
  }
}

fn belt_exit_drain_json(d: BeltExitDrain) -> JsonValue {
  match d {
    BeltExitDrained { entries, launch } =>
      json_object(members: [
        json_kv(key: "entries", value: json_array(elements: entries |> map(e => belt_exit_drain_entry_json(e: e)))),
        json_kv(key: "launch", value: match launch { Present { value: l } => belt_obligation_enqueue_json(e: l) Absent => json_string(s: "not owed") }),
      ])
    BeltExitDrainRefused { reason } => json_object(members: [json_kv(key: "refused", value: json_string(s: reason))])
  }
}

// A REFUSED ENTRY OR A REFUSED LAUNCH FAILS THE DRAIN, after every other entry has been handled: one
// unhandable exit never holds another, and the failure names each one.
fn belt_exit_drain_failures(d: BeltExitDrain) -> List<String> {
  match d {
    BeltExitDrainRefused { reason } => [join(["the exit inbox could not be read: ", reason], "")]
    BeltExitDrained { entries, launch } =>
      concat(
        entries |> flat_map(e => match e {
          BeltExitEntryRefused { entry, reason } => [join([entry, ": ", reason], "")]
          BeltExitEntryUnmovable { entry, step, cause } => [join([entry, ": unmovable at ", spool_stall_step_text(step: step), " (stays on disk): ", cause], "")]
          BeltExitEntryClaimed { entry: _ } => [] as List<String>
          BeltExitEntryHanded { entry: _, enqueue: _ } => [] as List<String>
        }),
        match launch {
          Present { value: BeltObligationEnqueueRefused { unit, reason } } => [join(["launch ", unit as String, ": ", reason], "")]
          Present { value: BeltObligationStarted { unit: _ } } => [] as List<String>
          Present { value: BeltObligationHeld { unit: _ } } => [] as List<String>
          Absent => [] as List<String>
        },
      )
  }
}

// THE EXIT SPOOL'S LINE STOP (DESIGN section 5, the factory model: a refusal that fires stops the line).
// The belt-exit path unit is a LEVEL on inbox and queued, so a drain that exits leaving an entry it
// cannot move is started again at once -- a hot loop with no terminal (srv1, 2026-10-21). The terminal is
// the drain's OWN verdict, not a rate: THIS PASS CLAIMED NOTHING AND AT LEAST ONE ENTRY WAS UNMOVABLE.
// Then the drain writes the stall record into `stalled/` (create-only) and the belt-exit service is
// skipped by `ConditionDirectoryNotEmpty=!stalled` until `belt_exit_stall_release_cli` clears it.
// Entries that arrive while stalled WAIT, unconsumed; the record says so, and the backlog judge
// (gunbc.roadmap.roadmap_launch_deployment_observe event_backlog_judge) reports them behind the head.
type BeltExitStallVerdict
  = BeltExitNotStalled
  | BeltExitStalled { unmovable: List<SpoolStallEntry> }

fn belt_exit_stall_verdict(d: BeltExitDrain) -> BeltExitStallVerdict {
  match d {
    BeltExitDrainRefused { reason: _ } => BeltExitNotStalled
    BeltExitDrained { entries, launch: _ } => {
      let claimed = entries |> filter(e => match e {
        BeltExitEntryClaimed { entry: _ } => true
        _ => false
      })
      let unmovable = entries |> flat_map(e => match e {
        BeltExitEntryUnmovable { entry, step, cause } => [SpoolStallEntry { entry: entry, step: step, cause: cause }]
        _ => [] as List<SpoolStallEntry>
      })
      if count(claimed) == 0 && count(unmovable) > 0 { BeltExitStalled { unmovable: unmovable } } else { BeltExitNotStalled }
    }
  }
}

// THE DRAIN'S TAIL: a stall verdict writes the record; a record that cannot be written is its own failure
// (the line cannot be stopped, so the hot loop is not contained and the operator must be told).
fn belt_exit_stall_failures(root: String, d: BeltExitDrain) -> List<String> {
  match belt_exit_stall_verdict(d: d) {
    BeltExitNotStalled => [] as List<String>
    BeltExitStalled { unmovable: u } =>
      match spool_stall_record_at(stalled_dir: attempt_exit_stalled_dir(instance_root: root), record_path: attempt_exit_stall_record_path(instance_root: root), unmovable: u) {
        SpoolStallRecorded => [join(["exit spool STALLED: ", to_string(value: count(u)), " entries cannot leave the spool; the belt-exit service is held until belt_exit_stall_release_cli (record: ", attempt_exit_stall_record_path(instance_root: root), ")"], "")]
        SpoolStallUnrecorded { reason } => [join(["SpoolStallUnrecorded: the stall record could not be written (", reason, "); the exit drain will re-fire"], "")]
      }
  }
}

// THE MODELED OPERATOR ROUTE OUT OF A STALL. `release` re-attempts the claim of every recorded entry that is
// still in the spool, with the same move the drain uses, unprivileged. Only when none is still unmovable does it
// delete the stall record; the re-arm of the path unit is a separate privileged effect (belt_exit_stall_release_cli).
// An entry that is no longer in the spool (cleared by a privileged operator) counts as left. A hand `rm` of the
// record is not the route: it would re-arm the loop over an entry that still cannot leave.
type BeltExitStallRelease
  = BeltExitStallNotHeld
  | BeltExitStallReleased { reclaimed: Int }
  | BeltExitStallStillUnmovable { entries: List<SpoolStallEntry> }
  | BeltExitStallReleaseRefused { reason: String }

fn belt_exit_stall_reclaim_entry_at(root: String, e: SpoolStallEntry, inbox: List<String>, running: List<String>, move: fn(String, String, HostSpoolStage, HostSpoolStage) -> String?) -> List<BeltExitDrainEntry> {
  if any(inbox, n => n == e.entry) && !belt_exit_entry_is_obligation(entry: e.entry) {
    [belt_exit_entry_drain_at(root: root, entry: e.entry, move: move)]
  } else if any(running, n => n == e.entry) {
    belt_exit_orphan_requeue_at(root: root, entry: e.entry, move: move)
  } else {
    [] as List<BeltExitDrainEntry>
  }
}

fn belt_exit_stall_release_at(root: String, move: fn(String, String, HostSpoolStage, HostSpoolStage) -> String?) -> BeltExitStallRelease {
  match spool_stall_read_at(record_path: attempt_exit_stall_record_path(instance_root: root)) {
    SpoolStallNone => BeltExitStallNotHeld
    SpoolStallUnreadable { reason } => BeltExitStallReleaseRefused { reason: join(["the stall record is unreadable: ", reason], "") }
    SpoolStallHeld { entries: recorded } =>
      match attempt_exit_stage_list(instance_root: root, stage: AttemptExitInbox) {
        AttemptExitStageUnreadable { reason } => BeltExitStallReleaseRefused { reason: reason }
        AttemptExitStageNames { names: inbox } =>
          match attempt_exit_stage_list(instance_root: root, stage: AttemptExitRunning) {
            AttemptExitStageUnreadable { reason } => BeltExitStallReleaseRefused { reason: reason }
            AttemptExitStageNames { names: running } => {
              let attempts = recorded |> flat_map(e => belt_exit_stall_reclaim_entry_at(root: root, e: e, inbox: inbox, running: running, move: move))
              let still = attempts |> flat_map(a => match a {
                BeltExitEntryUnmovable { entry, step, cause } => [SpoolStallEntry { entry: entry, step: step, cause: replace(cause, "\n", " ") }]
                _ => [] as List<SpoolStallEntry>
              })
              if count(still) > 0 {
                BeltExitStallStillUnmovable { entries: still }
              } else {
                match spool_stall_clear_at(record_path: attempt_exit_stall_record_path(instance_root: root)) {
                  SpoolStallCleared => BeltExitStallReleased { reclaimed: count(attempts) }
                  SpoolStallClearRefused { reason } => BeltExitStallReleaseRefused { reason: reason }
                }
              }
            }
          }
      }
  }
}

// ANALYZE IS READ-ONLY: for each recorded entry it reports the recorded cause and the entry's own owner, mode
// and type (stat), and for an entry owned by another principal it names the follow-up -- a privileged clear
// through the verb belt_exit_stall_clear_cli (belt_exit_stall_clear_at). Nothing is moved.
// An observation either happened or it did not; a failed reading is never folded into a value, so ownership
// is classified only from two readings that both succeeded.
type BeltExitStallObservation
  = BeltExitStallObserved { value: String }
  | BeltExitStallUnobserved { reason: String }

fn belt_exit_stall_observation_of(out: BeltExecOutcome, what: String) -> BeltExitStallObservation {
  match out {
    ExecOk { stdout } => BeltExitStallObserved { value: trim(stdout) }
    ExecFailed { program: _, exit_code, stderr } => BeltExitStallUnobserved { reason: join([what, " exited ", to_string(exit_code), ": ", trim(stderr)], "") }
    ExecRefused { program: _, reason } => BeltExitStallUnobserved { reason: join([what, " refused: ", reason], "") }
  }
}

// WHERE A RECORDED ENTRY LIVES: the stage its failing move starts from (the entry sits in `from`). The stat reading
// and the clear's admission both take their path from here, so what is observed is exactly what is cleared.
fn belt_exit_stall_entry_path(root: String, stage: HostSpoolStage, entry: String) -> String {
  join([attempt_exit_spool_stage_dir(instance_root: root, stage: stage), "/", entry], "")
}

// `stat` WITHOUT -L, so a symlink reads as `symbolic link` and never as what it points at. The type leads so
// the prefix `directory|` is the whole claim that the entry is a plain directory.
fn belt_exit_stall_path_stat_at(path: String) -> BeltExitStallObservation {
  belt_exit_stall_observation_of(out: belt_exec(cmd: host_exec_argv(program: "/usr/bin/stat", args: ["-c", "%F|%U|%a", path]), workdir: belt_observe_workdir as String), what: "stat")
}

fn belt_exit_stall_entry_stat_at(root: String, stage: HostSpoolStage, entry: String) -> BeltExitStallObservation {
  belt_exit_stall_path_stat_at(path: belt_exit_stall_entry_path(root: root, stage: stage, entry: entry))
}

// What a directory holds, one entry at most printed: empty output is an empty directory.
fn belt_exit_stall_contents_at(path: String) -> BeltExitStallObservation {
  belt_exit_stall_observation_of(out: belt_exec(cmd: host_exec_argv(program: "/usr/bin/find", args: [path, "-mindepth", "1", "-maxdepth", "1", "-print", "-quit"]), workdir: belt_observe_workdir as String), what: "find")
}

// THE ONE CLASSIFICATION of a recorded entry's ownership, from the two readings (the entry's stat, the drain
// principal's login). Analyze reports it and the clear's admission is gated on it, so the follow-up is offered
// for exactly the entries the clear admits. Foreign-owned is claimed only for a plain directory whose owner is
// read and is not the drain's principal; every unread or unexpected reading is its own arm, never a guess.
type BeltExitStallOwnership
  = BeltExitStallOwnedByDrain
  | BeltExitStallForeignOwned { mode: String }
  | BeltExitStallNotADirectory { stat: String }
  | BeltExitStallOwnerUnknown { reason: String }

fn belt_exit_stall_ownership_of(stat: BeltExitStallObservation, whoami: BeltExitStallObservation) -> BeltExitStallOwnership {
  match stat {
    BeltExitStallUnobserved { reason: sr } => BeltExitStallOwnerUnknown { reason: join([sr, "; the entry may no longer be in its stage"], "") }
    BeltExitStallObserved { value: s } =>
      if !starts_with(s: s, prefix: "directory|") {
        BeltExitStallNotADirectory { stat: s }
      } else {
        match whoami {
          BeltExitStallUnobserved { reason: wr } => BeltExitStallOwnerUnknown { reason: join(["the drain's principal is unread: ", wr], "") }
          BeltExitStallObserved { value: me } =>
            if string_length(s: me) == 0 {
              BeltExitStallOwnerUnknown { reason: "the drain's principal is empty" }
            } else if starts_with(s: s, prefix: join(["directory|", me, "|"], "")) {
              BeltExitStallOwnedByDrain
            } else {
              match split(s: s, delimiter: "|").last() {
                Present { value: m } => BeltExitStallForeignOwned { mode: m }
                Absent => BeltExitStallOwnerUnknown { reason: "the stat reading has no mode" }
              }
            }
        }
      }
  }
}

// THE VERB THE REFUSAL NAMES, and its exact invocation, so an operator reading analyze can act on it. The
// source roots are the run's own, so they are not guessed here.
data belt_exit_stall_clear_function: String = "belt_exit_stall_clear_cli"

fn belt_exit_stall_clear_invocation(entry: String) -> String {
  match admit_named_argument(name: "entry", value: entry) {
    NamedArgumentAdmitted { argument } =>
      join(["gunbc ", join(invocation_words_bare(words: gunbc_run_invocation_words_with_functions(source_roots: [], entry: "gunbc.roadmap.roadmap_belt_tick_cli", functions: [belt_exit_stall_clear_function], claim_run: false, arguments: [argument])), " ")], "")
    NamedArgumentNameEmpty => "(the clear verb takes --arg entry=<entry>)"
    NamedArgumentNameHoldsSeparator { name: _ } => "(the clear verb takes --arg entry=<entry>)"
  }
}

fn belt_exit_stall_analyze_at(root: String, whoami: BeltExitStallObservation) -> List<String> {
  match spool_stall_read_at(record_path: attempt_exit_stall_record_path(instance_root: root)) {
    SpoolStallNone => ["no stall record: the exit drain is not stalled"]
    SpoolStallUnreadable { reason } => [join(["the stall record is unreadable: ", reason], "")]
    SpoolStallHeld { entries } =>
      entries |> map(e => {
        let head = join([e.entry, ": ", spool_stall_step_text(step: e.step), " failed (", e.cause, "); "], "")
        match e.step {
          SpoolStallListRequests => join([head, "owner unknown (the step is not a spool stage move)"], "")
          SpoolStallClaim => join([head, "owner unknown (the step is not a spool stage move)"], "")
          SpoolStallMove { from: stage, to: _ } => {
            let stat = belt_exit_stall_entry_stat_at(root: root, stage: stage, entry: e.entry)
            let shown = match stat { BeltExitStallObserved { value: v } => join(["stat type|owner|mode: ", v, "; "], "") BeltExitStallUnobserved { reason: _ } => "" }
            match belt_exit_stall_ownership_of(stat: stat, whoami: whoami) {
              BeltExitStallOwnerUnknown { reason } => join([head, shown, "owner unknown (", reason, ")"], "")
              BeltExitStallNotADirectory { stat: _ } => join([head, shown, "not a plain directory: the clear refuses it"], "")
              BeltExitStallOwnedByDrain => join([head, shown, "owned by the drain's principal: release re-attempts the claim"], "")
              BeltExitStallForeignOwned { mode: _ } =>
                join([head, shown, "foreign-owned: the drain's principal cannot rename it across directories -- run `", belt_exit_stall_clear_invocation(entry: e.entry), "` as the drain's principal (same source roots as this run, no privilege); for an EMPTY entry it re-creates the entry in the move's target stage and removes the foreign one, then release"], "")
            }
          }
        }
      })
  }
}

// THE CLEAR: AN UNPRIVILEGED RE-MATERIALIZATION OF THE CLAIM'S OWN OUTCOME (DESIGN section 3b: no privileged
// effect remains, so none is selected or enrolled). A foreign-owned directory cannot be renamed by the drain's
// principal because a cross-parent rename rewrites the directory's `..`, but the principal owns both stage
// directories, so it can create the entry in the move's target stage and remove the empty foreign one: the same
// name, the claim's own outcome, nothing lost. Entries are created empty (the record is the name), so the effect is
// admitted only for an EMPTY plain directory; a non-empty foreign entry is tampering or another producer and is out
// of scope here, with no privileged route offered. Never `rm -r`: rmdir refuses a non-empty directory by itself.
// It is operator-invoked, never part of the drain, so the producer defect stays visible. Admission is ALL of:
// named in the current stall record, a plain entry name at <instance_root>/attempt-exit-spool/<from>/<entry> (stat
// without -L, so a symlink is refused), foreign-owned by belt_exit_stall_ownership_of (the reading analyze reports),
// and empty.
type BeltExitClearTarget
  = BeltExitClearTargeted { from_path: String, to_path: String }
  | BeltExitClearTargetRefused { reason: String }

fn belt_exit_entry_name_is_plain(entry: String) -> Bool {
  string_length(s: entry) > 0 && entry != "." && entry != ".." && !string_contains(s: entry, pattern: "/") && !string_contains(s: entry, pattern: "\n")
}

fn belt_exit_stall_clear_target(root: String, held: SpoolStallRead, entry: String) -> BeltExitClearTarget {
  match held {
    SpoolStallNone => BeltExitClearTargetRefused { reason: "no stall record: the exit drain is not stalled, so there is nothing to clear" }
    SpoolStallUnreadable { reason } => BeltExitClearTargetRefused { reason: join(["the stall record is unreadable: ", reason], "") }
    SpoolStallHeld { entries } =>
      if !belt_exit_entry_name_is_plain(entry: entry) {
        BeltExitClearTargetRefused { reason: join(["entry ", entry, " is not a plain entry name"], "") }
      } else {
        match entries |> filter(e => e.entry == entry) |> first() {
          Absent => BeltExitClearTargetRefused { reason: join(["entry ", entry, " is not named in the current stall record"], "") }
          Present { value: recorded } =>
            match recorded.step {
              SpoolStallMove { from, to } => BeltExitClearTargeted { from_path: belt_exit_stall_entry_path(root: root, stage: from, entry: entry), to_path: belt_exit_stall_entry_path(root: root, stage: to, entry: entry) }
              SpoolStallListRequests => BeltExitClearTargetRefused { reason: join(["entry ", entry, ": the recorded step is not a spool stage move"], "") }
              SpoolStallClaim => BeltExitClearTargetRefused { reason: join(["entry ", entry, ": the recorded step is not a spool stage move"], "") }
            }
        }
      }
  }
}

type BeltExitClearAdmission
  = BeltExitClearAdmitted
  | BeltExitClearRefused { reason: String }

fn belt_exit_stall_clear_admission(stat: BeltExitStallObservation, whoami: BeltExitStallObservation, contents: BeltExitStallObservation) -> BeltExitClearAdmission {
  match belt_exit_stall_ownership_of(stat: stat, whoami: whoami) {
    BeltExitStallOwnedByDrain => BeltExitClearRefused { reason: "owned by the drain's principal: nothing to clear; release re-attempts the claim" }
    BeltExitStallNotADirectory { stat: s } => BeltExitClearRefused { reason: join(["not a plain directory (", s, "): only a plain directory is cleared, never a symlink or a file"], "") }
    BeltExitStallOwnerUnknown { reason } => BeltExitClearRefused { reason: join(["ownership is unknown (", reason, "), so it is not classified foreign-owned"], "") }
    BeltExitStallForeignOwned { mode: _ } =>
      match contents {
        BeltExitStallUnobserved { reason } => BeltExitClearRefused { reason: join(["its contents are unread (", reason, ")"], "") }
        BeltExitStallObserved { value } =>
          if string_length(s: value) == 0 {
            BeltExitClearAdmitted
          } else {
            BeltExitClearRefused { reason: "not empty: exit records are created empty (the name is the record), so a non-empty foreign entry is tampering or a different producer; this verb never removes content and offers no privileged route for it" }
          }
      }
  }
}

type BeltExitClearOutcome
  = BeltExitCleared { to_path: String }
  | BeltExitClearFailed { reason: String }

fn belt_exit_clear_run(program: String, args: List<String>) -> String? {
  match belt_exec(cmd: host_exec_argv(program: program, args: args), workdir: belt_observe_workdir as String) {
    ExecOk { stdout: _ } => none
    ExecFailed { program: _, exit_code, stderr } => Present { value: join([program, " exited ", to_string(exit_code), ": ", trim(stderr)], "") }
    ExecRefused { program: _, reason } => Present { value: join([program, " refused: ", reason], "") }
  }
}

// mkdir (never -p) of the target, skipped when it is already a plain directory (an idempotent re-run), then rmdir
// of the foreign entry. Both run as the caller: the drain's principal.
fn belt_exit_stall_clear_at(root: String, entry: String, whoami: BeltExitStallObservation) -> BeltExitClearOutcome {
  match belt_exit_stall_clear_target(root: root, held: spool_stall_read_at(record_path: attempt_exit_stall_record_path(instance_root: root)), entry: entry) {
    BeltExitClearTargetRefused { reason } => BeltExitClearFailed { reason: reason }
    BeltExitClearTargeted { from_path, to_path } =>
      match belt_exit_stall_clear_admission(stat: belt_exit_stall_path_stat_at(path: from_path), whoami: whoami, contents: belt_exit_stall_contents_at(path: from_path)) {
        BeltExitClearRefused { reason } => BeltExitClearFailed { reason: reason }
        BeltExitClearAdmitted => {
          let made = match belt_exit_stall_path_stat_at(path: to_path) {
            BeltExitStallObserved { value } => if starts_with(s: value, prefix: "directory|") { none } else { Present { value: join([to_path, " exists and is not a plain directory (", value, ")"], "") } }
            BeltExitStallUnobserved { reason: _ } => belt_exit_clear_run(program: "/bin/mkdir", args: ["--", to_path])
          }
          match made {
            Present { value: why } => BeltExitClearFailed { reason: join(["could not create the target: ", why], "") }
            Absent =>
              match belt_exit_clear_run(program: "/bin/rmdir", args: ["--", from_path]) {
                Present { value: why } => BeltExitClearFailed { reason: join(["the target exists but the foreign entry was not removed: ", why], "") }
                Absent => BeltExitCleared { to_path: to_path }
              }
          }
        }
      }
  }
}

// THE PRIVILEGED HALF OF A RELEASE: the .path unit sits failed (trigger-limit-hit) after a stall, and re-arming
// a SYSTEM unit is root's. Its argv is elevated through extdeps.sudo.elevation sudo_elevate_argv, and the
// authorization it needs is whatever select_authorization_pattern selects for it
// (gunbc.auth.privileged_effect_census, site belt_exit_stall_rearm_at) -- no sudoers line is coined here. A
// refusal by the host is TYPED and carries the exact argv, so a privileged operator can run it.
type BeltExitStallRearm
  = BeltExitStallRearmed
  | BeltExitStallRearmRefused { argv: List<String>, reason: String }

fn belt_exit_stall_rearm_commands(path_unit: NonEmptyStr) -> List<ElevatedInvocation> {
  [
    sudo_elevate(command: systemctl_reset_failed_argv(unit: path_unit)),
    sudo_elevate(command: systemctl_start_argv(unit: path_unit)),
  ]
}

fn belt_exit_stall_rearm_at(path_unit: NonEmptyStr) -> BeltExitStallRearm {
  let refusals = belt_exit_stall_rearm_commands(path_unit: path_unit) |> flat_map(c => match belt_exec(cmd: host_exec_argv(program: c.bin_path, args: c.args), workdir: belt_observe_workdir as String) {
    ExecOk { stdout: _ } => [] as List<BeltExitStallRearm>
    ExecFailed { program: _, exit_code, stderr } => [BeltExitStallRearmRefused { argv: list_append(left: [c.bin_path], right: c.args), reason: join(["exit ", to_string(exit_code), ": ", trim(stderr)], "") }]
    ExecRefused { program: _, reason } => [BeltExitStallRearmRefused { argv: list_append(left: [c.bin_path], right: c.args), reason: reason }]
  })
  match refusals.first() {
    Present { value: r } => r
    Absent => BeltExitStallRearmed
  }
}

fn belt_exit_stall_whoami() -> BeltExitStallObservation {
  belt_exit_stall_observation_of(out: belt_exec(cmd: host_exec_argv(program: "/usr/bin/id", args: ["-un"]), workdir: belt_observe_workdir as String), what: "id -un")
}

// THE RUN CLAIMS A BOUNDED POPULATION BEFORE ITS FIRST OBSERVATION, AND ONLY WHAT IT CLAIMED IS SETTLED
// (bold-bee-114, 2026-10-09: lost wakeup and false acknowledgment). Claiming is the create-only move
// queued -> running of every entry this attempt has in the spool at that instant -- an entry the run's
// observations are guaranteed to have seen, because the exit was recorded before the claim and the
// observations come after it. The receipt names the claim (`claimed_exits`); settlement moves exactly
// those entries running -> done once the receipt is on disk. An exit that arrives later -- after the
// final observation but before settlement, after settlement but before the unit exits, or while the
// unit is gone -- is not in the claim, so nothing acknowledges it: it stays queued, the queued level
// starts the drain, and the sweep hands its attempt to a NEW run that claims it. A held unit is never
// proof the active run includes a new event.
//
// A `running` entry found at claim time belongs to a predecessor whose run died before settling: the
// unit name is the exclusive hold, so no live run can own it. The new run adopts it into its claim.
type BeltExitClaim
  = BeltExitClaimed { entries: List<String> }
  | BeltExitClaimRefused { reason: String }

fn belt_exit_entry_is_for(entry: String, node_id: String, attempt_key: String) -> Bool {
  match attempt_exit_entry_decode(entry_name: entry) {
    AttemptExitEntryDecoded { record } => record.node_id == node_id && record.attempt_key == attempt_key
    AttemptHandInEntryDecoded { node_id: n, attempt_key: k, handin: _, entry_name: _ } => n == node_id && k == attempt_key
    AttemptExitEntryMalformed { entry_name: _, reason: _ } => false
  }
}

fn belt_exit_entries_claim_at(root: String, node_id: String, attempt_key: String) -> BeltExitClaim {
  match attempt_exit_stage_list(instance_root: root, stage: AttemptExitQueued) {
    AttemptExitStageUnreadable { reason } => BeltExitClaimRefused { reason: join(["the queued exit entries could not be listed: ", reason], "") }
    AttemptExitStageNames { names: queued } =>
      match attempt_exit_stage_list(instance_root: root, stage: AttemptExitRunning) {
        AttemptExitStageUnreadable { reason } => BeltExitClaimRefused { reason: join(["the running exit entries could not be listed: ", reason], "") }
        AttemptExitStageNames { names: running } => {
          let mine = queued |> filter(n => belt_exit_entry_is_for(entry: n, node_id: node_id, attempt_key: attempt_key))
          let failed = mine |> flat_map(n => match belt_exit_entry_move_at(root: root, entry: n, from: AttemptExitQueued, to: AttemptExitRunning) {
            Absent => [] as List<String>
            Present { value: why } => [join([n, ": ", why], "")]
          })
          if count(failed) == 0 {
            BeltExitClaimed { entries: concat(mine, running |> filter(n => belt_exit_entry_is_for(entry: n, node_id: node_id, attempt_key: attempt_key))) }
          } else {
            BeltExitClaimRefused { reason: join(["exit entries could not be claimed: ", join(failed, "; ")], "") }
          }
        }
      }
  }
}

fn belt_exit_entries_claim(instance: HostDashboardInstance, node_id: String, attempt_key: String) -> BeltExitClaim {
  belt_exit_entries_claim_at(root: instance.instance_root as String, node_id: node_id, attempt_key: attempt_key)
}

// SETTLEMENT MOVES ONLY THE CLAIM running -> done, after the receipt that names it is written.
fn belt_exit_entries_settle_at(root: String, claimed: List<String>) -> List<String> {
  claimed |> flat_map(n => match belt_exit_entry_move_at(root: root, entry: n, from: AttemptExitRunning, to: AttemptExitDone) {
    Absent => [] as List<String>
    Present { value: why } => [join([n, ": ", why], "")]
  })
}

fn belt_exit_entries_settle(instance: HostDashboardInstance, claimed: List<String>) -> List<String> {
  belt_exit_entries_settle_at(root: instance.instance_root as String, claimed: claimed)
}

// EXITS THIS ATTEMPT STILL HAS UNCLAIMED, listed from the queue: the run's own re-check after settling
// (a second bounded pass picks up an arrival the first one could not have seen).
fn belt_exit_entries_pending_at(root: String, node_id: String, attempt_key: String) -> BeltExitClaim {
  match attempt_exit_stage_list(instance_root: root, stage: AttemptExitQueued) {
    AttemptExitStageUnreadable { reason } => BeltExitClaimRefused { reason: join(["the queued exit entries could not be listed: ", reason], "") }
    AttemptExitStageNames { names } => BeltExitClaimed { entries: names |> filter(n => belt_exit_entry_is_for(entry: n, node_id: node_id, attempt_key: attempt_key)) }
  }
}

// THE QUEUED SWEEP: the level-triggered half of the hand-off. Every attempt with an entry in `queued`
// is enqueued -- the sole hand-off, run in the pass that claimed the entry -- a held unit is a no-op (its own re-check or
// the next drain picks the entry up), a gone unit is started and its run claims the entry. One enqueue
// per attempt, whatever its entry count.
fn belt_exit_queued_sweep_at(root: String, enqueue: fn(String, String) -> BeltObligationEnqueue) -> List<BeltExitDrainEntry> {
  match attempt_exit_stage_list(instance_root: root, stage: AttemptExitQueued) {
    AttemptExitStageUnreadable { reason } => [BeltExitEntryRefused { entry: "queued", reason: reason }]
    AttemptExitStageNames { names } =>
      fold(names, init: [] as List<BeltExitDrainEntry>, f: (acc, n) => match attempt_exit_entry_decode(entry_name: n) {
        AttemptExitEntryMalformed { entry_name: _, reason } => concat(acc, [BeltExitEntryRefused { entry: n, reason: join(["queued entry is not an exit record: ", reason], "") }])
        AttemptExitEntryDecoded { record } => belt_exit_queued_entry_sweep(acc: acc, entry: n, node_id: record.node_id, attempt_key: record.attempt_key, enqueue: enqueue)
        AttemptHandInEntryDecoded { node_id, attempt_key, handin: _, entry_name: _ } => belt_exit_queued_entry_sweep(acc: acc, entry: n, node_id: node_id, attempt_key: attempt_key, enqueue: enqueue)
      })
  }
}

fn belt_exit_queued_entry_sweep(acc: List<BeltExitDrainEntry>, entry: String, node_id: String, attempt_key: String, enqueue: fn(String, String) -> BeltObligationEnqueue) -> List<BeltExitDrainEntry> {
  if any(acc, e => match e { BeltExitEntryHanded { entry: handed_entry, enqueue: _ } => belt_exit_entry_is_for(entry: handed_entry, node_id: node_id, attempt_key: attempt_key) _ => false }) {
    acc
  } else {
    let handed = enqueue(node_id, attempt_key)
    match handed {
      BeltObligationEnqueueRefused { unit: _, reason } => concat(acc, [BeltExitEntryRefused { entry: entry, reason: reason }])
      BeltObligationStarted { unit: _ } => concat(acc, [BeltExitEntryHanded { entry: entry, enqueue: handed }])
      BeltObligationHeld { unit: _ } => concat(acc, [BeltExitEntryHanded { entry: entry, enqueue: handed }])
    }
  }
}

// THE EXIT SPOOL'S UNCONSUMED ENTRIES WITH THEIR MODIFICATION TIMES, for the launch receipt's event
// backlog row (gunbc.roadmap.roadmap_launch_deployment_observe event_backlog_judge). An entry's directory is
// created by the stop hook and never written after, so its mtime is the instant the exit was recorded.
// Inbox and queued only: done and refused are not a backlog -- one is consumed, the other is a refusal
// the drain already reported. Any unreadable listing or unparseable time refuses the read whole.
type BeltExitSpoolEntryTime {
  stage: HostSpoolStage
  entry: String
  mtime_epoch: EpochSecs
}

type BeltExitSpoolTimes
  = BeltExitSpoolTimesRead { entries: List<BeltExitSpoolEntryTime> }
  | BeltExitSpoolTimesUnreadable { reason: String }

fn belt_exit_spool_stage_times(instance: HostDashboardInstance, stage: HostSpoolStage, label: String) -> BeltExitSpoolTimes {
  let root = instance.instance_root as String
  match attempt_exit_stage_list(instance_root: root, stage: stage) {
    AttemptExitStageUnreadable { reason } => BeltExitSpoolTimesUnreadable { reason: reason }
    AttemptExitStageNames { names } =>
      fold(names, init: BeltExitSpoolTimesRead { entries: [] }, f: (acc, n) => match acc {
        BeltExitSpoolTimesUnreadable { reason } => BeltExitSpoolTimesUnreadable { reason: reason }
        BeltExitSpoolTimesRead { entries } => {
          let cmd = stat_mtime_epoch_command(path: join([attempt_exit_spool_stage_dir(instance_root: root, stage: stage), "/", n], ""))
          match belt_exec(cmd: host_exec_argv(program: cmd.program.invocation as String, args: cmd.arguments), workdir: belt_observe_workdir as String) {
            ExecOk { stdout } =>
              match parse_int(text: trim(stdout)) {
                Present { value: t } =>
                  if t >= 0 {
                    BeltExitSpoolTimesRead { entries: concat(entries, [BeltExitSpoolEntryTime { stage: stage, entry: n, mtime_epoch: t as EpochSecs }]) }
                  } else {
                    BeltExitSpoolTimesUnreadable { reason: join(["the modification time of ", label, " entry ", n, " is negative: ", stdout], "") }
                  }
                Absent => BeltExitSpoolTimesUnreadable { reason: join(["the modification time of ", label, " entry ", n, " did not parse: ", stdout], "") }
              }
            ExecFailed { program: _, exit_code: _, stderr } => BeltExitSpoolTimesUnreadable { reason: join(["the modification time of ", label, " entry ", n, " could not be read: ", stderr], "") }
            ExecRefused { program: _, reason } => BeltExitSpoolTimesUnreadable { reason: reason }
          }
        }
      })
  }
}

fn belt_exit_spool_times(instance: HostDashboardInstance) -> BeltExitSpoolTimes {
  match belt_exit_spool_stage_times(instance: instance, stage: AttemptExitInbox, label: "inbox") {
    BeltExitSpoolTimesUnreadable { reason } => BeltExitSpoolTimesUnreadable { reason: reason }
    BeltExitSpoolTimesRead { entries: inbox } =>
      match belt_exit_spool_stage_times(instance: instance, stage: AttemptExitQueued, label: "queued") {
        BeltExitSpoolTimesUnreadable { reason } => BeltExitSpoolTimesUnreadable { reason: reason }
        BeltExitSpoolTimesRead { entries: queued } =>
          match belt_exit_spool_stage_times(instance: instance, stage: AttemptExitRunning, label: "running") {
            BeltExitSpoolTimesUnreadable { reason } => BeltExitSpoolTimesUnreadable { reason: reason }
            BeltExitSpoolTimesRead { entries: running } => BeltExitSpoolTimesRead { entries: concat(inbox, concat(queued, running)) }
          }
      }
  }
}
