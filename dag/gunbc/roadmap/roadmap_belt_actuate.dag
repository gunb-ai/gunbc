        json_kv(key: "outcome", value: json_string(s: "deferred")),
        json_kv(key: "detail", value: json_string(s: reason)),
      ])
    VerifyRecorded { node_id, verdict_key, detail } =>
      json_object(members: [
        json_kv(key: "node", value: json_string(s: node_id)),
        json_kv(key: "outcome", value: json_string(s: "recorded")),
        json_kv(key: "verdict", value: json_string(s: verdict_key)),
        json_kv(key: "detail", value: json_string(s: detail)),
      ])
    VerifyWriteFailed { node_id, detail } =>
      json_object(members: [
        json_kv(key: "node", value: json_string(s: node_id)),
        json_kv(key: "outcome", value: json_string(s: "write-failed")),
        json_kv(key: "detail", value: json_string(s: detail)),
      ])
    VerifyEvidenceUnreadable { node_id, detail } =>
      json_object(members: [
