// Slice 2b actuation: the belt DECISION (gunbc.roadmap_belt.belt_reconcile) is CLOSED against the
// host by three single-authorities — the actuator's HostExecArgv argv model
// (gunbc.roadmap_dispatch_actuator, the one place git/tmux/provider argv is shaped),
// gunbc.WitnessBin.Run (typed-argv exec, no shell string) and shell.PosixCommandV.Check (presence
// probe; migrated off shell.Which.Check, crisp-wren-896, PR #8590 — srv1's OperatingSystemSurface
// carries no package-set authority, so the weaker POSIX-shell assumption dominates). Provider is a
// closed ClaudeCodeProvider | CodexCliProvider choice whose argv, preflight and pane fingerprint
// move together. Fail-closed: which-miss or auth uncertainty refuses before git worktree add; a
// worktree failure short-circuits tmux spawn; a nonzero provider process after tmux accepted is
// runtime evidence, not spawn evidence, never absorbed into Spawned.
data belt_actuate_placement_dissolution_trigger: Disposition = Scaffold {
  dissolves_to: RealizationDispatch,
  bind: DeclarationRef {
    module_path: "gunbc.roadmap_dispatch_actuator",
    decl_name: "classify_dispatch_lease_upsert",
    field: WholeDeclaration
  }
}

data belt_actuate_fingerprint_dissolution_trigger: Disposition = Scaffold {
  dissolves_to: RealizationDispatch,
  bind: DeclarationRef {
    module_path: "gunbc.roadmap_dispatch_actuator",
    decl_name: "dispatch_tmux_process_fingerprint_observation_dissolution_trigger",
    field: WholeDeclaration
  }
}

data belt_actuate_workdir_note: String = "Two DISTINCT workdirs, because the belt's two host verbs bind to different roots (a §5 fail-open otherwise: observing from a repo path that may not exist on an arbitrary host would make `tmux ls` fail and — before this split — get widened to an empty session set). belt_actuate_workdir is the SPAWN root: `git worktree add` must run inside the gunbc repo — a PROJECTION of gunbc.host_layout.srv1_gunbc_repo_root (the single path authority; its former private copy deleted, DESIGN §3): the same tree `gunbc serve` loads, which is why dispatch works in-process. belt_observe_workdir is the host-global root '/': `tmux ls` and `tmux kill-session` act on the per-user tmux server (a host singleton, not a repo), so they must run from a directory guaranteed to exist on the host — never the repo path, which may be absent (fake-claude test box, a freshly-enrolled srvN). Observe/teardown therefore carry no workdir parameter; only spawn is workdir-parameterized."

data belt_actuate_workdir: FilePath = srv1_gunbc_repo_root

data belt_observe_workdir: FilePath = "/" as FilePath

type BeltExecOutcome
  = ExecOk { stdout: String }
  | ExecFailed { program: String, exit_code: Int, stderr: String }
  | ExecRefused { program: String, reason: String }

// Probe via shell.PosixCommandV.Check exit_success (Bool), NOT .path: the .path realization is a
// bare-stdout string wet (the Optional-over-Value::Null realization fork — DESIGN open thread), so
// the belt keys on the exit Bool and lets WitnessBin.Run's `env -C {workdir} {bin_path} args`
// resolve the bare program via PATH (env execvp). 'program missing' (refuse) stays distinct from
// 'present, exited nonzero' (fail) without touching the Optional straddle. Migrated off
// shell.Which.Check (crisp-wren-896, PR #8590): srv1's OperatingSystemSurface has
// distro_or_product: none, so `which` was never an established fact; command -v's strictly weaker
// assumption dominates.
// This module's probes are annotated OutcomeIsData (operator ruling 2026-07-25): their exit codes
// are ANSWERS the belt adjudicates, not faults. belt_program_available's which-miss is the 'program
// missing' pole belt_program_available_note keeps distinct from 'present but exited nonzero';
// belt_exec's nonzero exit becomes ExecFailed; belt_observe's a typed BeltObserve arm. Each is
// rendered loudly by the belt's per-variant status mapping, so the effect layer's anomaly glyph was
// a second, cruder judgment. ADMISSIBILITY (§5 guard, gunbc.output_policy outcome_is_data_note):
// each annotated fn returns a typed value whose arms ARE the adjudication — Bool for the
// availability probe (consumed as the refuse/fail discriminator, never discarded), BeltExecOutcome,
// BeltObserve — never unit. Dispatch failure is not an exit code, stays anomalous, and does not
// travel this arm.
fn belt_program_available(program: String) -> Bool {
  shell.PosixCommandV.Check(command: program as NonEmptyStr, expect: OutcomeIsData).exists
}

fn belt_exec(cmd: HostExecArgv, workdir: String) -> BeltExecOutcome {
  if belt_program_available(program: cmd.program) {
    let result = gunbc.WitnessBin.Run(
      workdir: workdir as FilePath,
      bin_path: cmd.program as FilePath,
      args: cmd.args,
      expect: OutcomeIsData,
    )
    if result.success {
      ExecOk { stdout: result.stdout }
    } else {
      ExecFailed { program: cmd.program, exit_code: result.exit_code, stderr: result.stderr }
    }
  } else {
    ExecRefused {
      program: cmd.program,
      reason: "belt_exec: program not found on PATH (which exit nonzero); fail-closed, no fabricated success",
    }
  }
}

// Fail-closed sequencing: the fold runs each argv in order and SHORT-CIRCUITS on the first non-ok
// step (ExecFailed/ExecRefused) — belt_exec is NOT called for the rest. Spawn's worktree-add ->
// tmux-new-session ordering rides this: a failed git worktree add never spawns a tmux session on a
// missing worktree. Discriminating control: without the ExecOk-guarded short-circuit, [false, echo]
// would run echo and go green.
fn belt_exec_all(cmds: List<HostExecArgv>, workdir: String) -> BeltExecOutcome {
  fold(cmds, init: ExecOk { stdout: "" }, f: fn(acc, cmd) {
    match acc {
      ExecOk { stdout: _ } => belt_exec(cmd: cmd, workdir: workdir)
      ExecFailed { program: _, exit_code: _, stderr: _ } => acc
      ExecRefused { program: _, reason: _ } => acc
    }
  })
}

type BeltExecStep {
  step: String
  command: HostExecArgv
}

type BeltExecStepsOutcome
  = ExecStepsOk
  | ExecStepFailed { step: String, detail: String }

fn belt_exec_steps(
  steps: List<BeltExecStep>,
  workdir: String,
) -> BeltExecStepsOutcome {
  fold(steps, init: ExecStepsOk, f: fn(acc, step) {
    match acc {
      ExecStepFailed { step: _, detail: _ } => acc
      ExecStepsOk =>
        match belt_exec(cmd: step.command, workdir: workdir) {
          ExecOk { stdout: _ } => ExecStepsOk
          ExecFailed { program: _, exit_code, stderr } =>
            ExecStepFailed {
              step: step.step,
              detail: join([
                "exit ", to_string(exit_code), ": ", stderr,
              ], ""),
            }
          ExecRefused { program: _, reason } =>
            ExecStepFailed { step: step.step, detail: reason }
        }
    }
  })
}

type AttemptStateInitialization
  = AttemptStateInitialized
  | AttemptStateInitializationFailed { step: String, detail: String }

// A modeled attempt publishes an immutable evidence prefix before provider launch: after worktree
// and state-directory creation the serve process writes the attempt key, the exact grounded
// environment-admission JSON receipt and an empty provider-events.jsonl via typed Filesystem.Write,
// then replaces the node-current symlink. The replace may be briefly unreadable; the observer
// reports refusal and retries next poll — no atomicity is claimed for `ln -sfnT`. A readable
// current attempt is constructive proof that admission, workspace creation and event-capture
// initialization preceded launch; the progress route validates the admitted receipt rather than
// inferring stages from a tmux name.
fn belt_attempt_state_initialize_for_instance(
  instance: HostDashboardInstance,
  node: RoadmapNode,
  attempt_key: String,
  admission_receipt: String,
  launch: LaunchIdentity,
) -> AttemptStateInitialization {
  let key_write = Filesystem.Write(
    path: dispatch_attempt_key_path_for_instance(
      instance: instance,
      node_id: node.node,
      attempt_key: attempt_key,
    ),
    content: attempt_key,
  )
  if !key_write.success {
    AttemptStateInitializationFailed {
      step: "attempt-key-write",
      detail: key_write.error,
    }
  } else {
    let admission_write = Filesystem.Write(
      path: dispatch_attempt_admission_path_for_instance(
        instance: instance,
        node_id: node.node,
        attempt_key: attempt_key,
      ),
      content: admission_receipt,
    )
    if !admission_write.success {
      AttemptStateInitializationFailed {
        step: "attempt-admission-write",
        detail: admission_write.error,
      }
    } else {
    let launch_write = Filesystem.Write(
      path: dispatch_attempt_launch_path_for_instance(
        instance: instance,
        node_id: node.node,
        attempt_key: attempt_key,
      ),
      content: serialize_json(v: launch_identity_json(id: launch)),
    )
    if !launch_write.success {
      AttemptStateInitializationFailed {
        step: "attempt-launch-write",
        detail: launch_write.error,
      }
    } else {
      let events_write = Filesystem.Write(
        path: dispatch_attempt_events_path_for_instance(
          instance: instance,
          node_id: node.node,
          attempt_key: attempt_key,
        ),
        content: "",
      )
      if events_write.success {
        let pin_persisted = belt_persist_oracle_pin_for_instance(
          instance: instance,
          node: node,
          attempt_key: attempt_key,
          capture: belt_attempt_oracle_pin_capture_for_instance(
            instance: instance,
            node: node,
            attempt_key: attempt_key,
          ),
        )
        let receipt_initialized = Filesystem.Write(
          path: dispatch_attempt_validation_receipt_path_for_instance(
            instance: instance,
            node_id: node.node,
            attempt_key: attempt_key,
          ),
          content: validation_receipt_json(
            verdict: ValidationNotRun,
            observations: belt_oracle_observations_in_worktree(
              contract: node.execution,
              worktree: dispatch_worktree_path_for_instance(
                instance: instance,
                node_id: node.node,
                attempt_key: attempt_key,
              ),
            ),
          ),
        ).success
        if !receipt_initialized {
          AttemptStateInitializationFailed {
            step: "attempt-validation-receipt-initialize",
            detail: "the not-run validation receipt could not be written beside the attempt; without it a later unreadable receipt is indistinguishable from an absent one, which is the conflation this initialization exists to remove",
          }
        } else if pin_persisted {
          AttemptStateInitialized
        } else {
          AttemptStateInitializationFailed {
            step: "attempt-oracle-pin-persist",
            detail: "the validation oracle pin could not be written beside the attempt; an attempt whose oracle is unrecorded can never be verified, and the write itself failing is a state-directory fault rather than a verification-side deficit",
          }
        }
      } else {
        AttemptStateInitializationFailed {
          step: "attempt-events-initialize",
          detail: events_write.error,
        }
      }
    }
  }
    }
}

// The pin is captured from the FRESHLY CREATED WORKTREE before the provider spawns — the only
// moment the oracle is known to be the base revision's, not the attempt's. The controller repo is a
// tree nothing ties to this attempt; reading after the agent runs is the fail-open this lane
// closes. The staged spawn already orders it: worktree-add and attempt-state-prepare first, this
// capture inside state initialization, tmux-session-create after. A capture failure does NOT fail
// the spawn (refusing on a verification-side deficit trades a whole attempt for a receipt) but is
// never silent: the reason is persisted to its own file, so verification reports a located cause,
// not an absent pin, and the deficit stays countable at the Verify lamp.
type AttemptOraclePinCapture
  = OraclePinRecorded {
      identity: ContentHash,
      revision: String,
    }
  | OraclePinNotRecorded { reason: String }

// This projection used filter_map, which type-checks and DOES NOT RUN: std.primitives declares the
// contract but the seed registers no method, so the call reached the interpreter as `not yet
// implemented` and the dispatch route 500'd. Found by a live lab dispatch, not the whole-tree
// compile (0 blocking errors) nor this lane's witnesses — DESIGN section 5's
// specification-without-execution one layer below where this PR watched: MY functions were checked
// as exercised, the PRIMITIVES they call never. The corpus had zero filter_map call sites before.
// flat_map is the same fold with a registered implementation; a one-or-zero element list is exactly
// the Present/none the contract described.
fn belt_oracle_refs_for_contract(
  contract: WorkItemExecutionContract,
) -> List<ValidationOracleRef> {
  validation_oracle_scopes(contract: contract)
    |> flat_map(scope => match scope {
      OraclePinnable { oracle } => [oracle]
      OracleNotPinnable { validation_label: _, reason: _ } => []
    })
}

fn belt_oracle_observe_in_worktree(
  worktree: String,
  oracle: ValidationOracleRef,
) -> OracleObservation {
  let read = Filesystem.Read(
    path: join([worktree, "/", oracle.entry as String], ""),
  )
  validation_oracle_observe_from_source(
    oracle: oracle,
    source_readable: read.success,
    source: read.content,
    read_error: read.error,
  )
}

fn belt_oracle_observations_in_worktree(
  contract: WorkItemExecutionContract,
  worktree: String,
) -> List<OracleObservation> {
  belt_oracle_refs_for_contract(contract: contract)
    |> map(oracle => belt_oracle_observe_in_worktree(
      worktree: worktree,
      oracle: oracle,
    ))
}

data worktree_head_observation_note: String = "THE REVISION READ NOW CARRIES WHY IT FAILED, AND THE STRING PROJECTION SURVIVES AS A PROJECTION. belt_worktree_head_revision collapsed all three exec arms to the empty string, and its one consumer tested `== \\\"\\\"`, which was adequate exactly because the consumer's two branches took the same action either way.\\n\\nPublication cannot use it, and the reason is the point rather than an inconvenience. Publication is adjudicated against an EXACT HEAD; if the head cannot be read there is no subject, and a consumer with no subject cannot check a receipt against one. That state has to say what happened - git missing, git refused, worktree gone - because the operator's next action differs in each case, and because a Publication lamp that reads `unknown` must be able to prove it is not reading `unpublished`.\\n\\nSO THE TYPED OBSERVATION IS THE AUTHORITY AND THE STRING IS DERIVED FROM IT. Not a second reader: one exec, one decision function, and belt_worktree_head_revision becomes a two-line projection over it. Adding a parallel typed reader beside the string one would have been the fork this corpus keeps paying for.\\n\\nEMPTY STDOUT IS UNOBSERVED, NOT OBSERVED-AS-EMPTY. git rev-parse HEAD exits zero and prints nothing in cases this belt can reach - an unborn HEAD in a freshly created worktree is the ordinary one - so a zero exit is not by itself proof that a revision was read. Casting that empty string into a CommitSha would produce a subject whose head matches no commit and compares equal to any other empty head, which is the branded-empty defect empty_branch_projection_note describes on the ref side."

type WorktreeHeadObservation
  = WorktreeHeadObserved { revision: NonEmptyStr }
  | WorktreeHeadUnobserved { reason: String }

fn worktree_head_observation_of(outcome: BeltExecOutcome) -> WorktreeHeadObservation {
  match outcome {
    ExecOk { stdout } =>
      if trim(stdout) == "" {
        WorktreeHeadUnobserved {
          reason: "git reported no revision for HEAD, which a worktree whose branch has no commit yet will do without failing",
        }
      } else {
        WorktreeHeadObserved { revision: trim(stdout) as NonEmptyStr }
      }
    ExecFailed { program, exit_code, stderr } =>
      WorktreeHeadUnobserved {
        reason: join([
          program, " could not read the worktree head (exit ", to_string(exit_code), "): ", stderr,
        ], ""),
      }
    ExecRefused { program, reason } =>
      WorktreeHeadUnobserved {
        reason: join([program, " was not available to read the worktree head: ", reason], ""),
      }
  }
}

fn belt_worktree_head_observe(
  instance: HostDashboardInstance,
  worktree: String,
) -> WorktreeHeadObservation {
  worktree_head_observation_of(
    outcome: belt_exec(
      cmd: host_exec_argv(
        program: dispatch_capability_program(
          environment: instance.execution_environment,
          cap: GitWorkspaceCapability,
        ),
        args: shape_git_rev_parse_head_args(),
      ),
      workdir: worktree,
    ),
  )
}

fn belt_worktree_head_revision(
  instance: HostDashboardInstance,
  worktree: String,
) -> String {
  match belt_worktree_head_observe(instance: instance, worktree: worktree) {
    WorktreeHeadObserved { revision } => revision as String
    WorktreeHeadUnobserved { reason: _ } => ""
  }
}

fn belt_verify_detached_worktree(
  instance: HostDashboardInstance,
  node_id: RoadmapNodeId,
  attempt_key: String,
  head_sha: String,
) -> String {
  let checkout_path = dispatch_verification_checkout_path_for_instance(
    instance: instance,
    node_id: node_id,
    attempt_key: attempt_key,
    head_sha: head_sha,
  )
  match belt_worktree_head_observe(instance: instance, worktree: checkout_path) {
    WorktreeHeadObserved { revision } =>
      if (revision as String) == head_sha {
        checkout_path
      } else {
        ""
      }
    WorktreeHeadUnobserved { reason: _ } =>
      match belt_exec(
        cmd: git_worktree_add_detached_argv_for_instance(
          instance: instance,
          worktree_path: checkout_path,
          commit_sha: head_sha,
        ),
        workdir: instance.repo_root as String,
      ) {
        ExecOk { stdout: _ } => checkout_path
        ExecFailed { program: _, exit_code: _, stderr: _ } => ""
        ExecRefused { program: _, reason: _ } => ""
      }
  }
}

fn belt_verify_detached_worktree_refusal(
  instance: HostDashboardInstance,
  node_id: RoadmapNodeId,
  attempt_key: String,
  head_sha: String,
) -> String {
  let checkout_path = dispatch_verification_checkout_path_for_instance(
    instance: instance,
    node_id: node_id,
    attempt_key: attempt_key,
    head_sha: head_sha,
  )
  match belt_worktree_head_observe(instance: instance, worktree: checkout_path) {
    WorktreeHeadObserved { revision } =>
      join([
        "a verification checkout already exists at ",
        checkout_path,
        " but its head is ",
        revision as String,
        " instead of the observed ",
        head_sha,
      ], "")
    WorktreeHeadUnobserved { reason: _ } =>
      match belt_exec(
        cmd: git_worktree_add_detached_argv_for_instance(
          instance: instance,
          worktree_path: checkout_path,
          commit_sha: head_sha,
        ),
        workdir: instance.repo_root as String,
      ) {
        ExecOk { stdout: _ } => ""
        ExecFailed { program, exit_code, stderr } =>
          join([
            program,
            " could not create a detached verification checkout at ",
            head_sha,
            " (exit ",
            to_string(exit_code),
            "): ",
            stderr,
          ], "")
        ExecRefused { program, reason } =>
          join([
            program,
            " was not available to create a detached verification checkout: ",
            reason,
          ], "")
      }
  }
}

fn belt_attempt_oracle_pin_capture_for_instance(
  instance: HostDashboardInstance,
  node: RoadmapNode,
  attempt_key: String,
) -> AttemptOraclePinCapture {
  let worktree = dispatch_worktree_path_for_instance(
    instance: instance,
    node_id: node.node,
    attempt_key: attempt_key,
  )
  let refs = belt_oracle_refs_for_contract(contract: node.execution)
  if count(refs) == 0 {
    OraclePinNotRecorded {
      reason: "this node's execution contract declares no validation whose oracle can be pinned",
    }
  } else {
    match validation_oracle_set_observe(
      observations: belt_oracle_observations_in_worktree(
        contract: node.execution,
        worktree: worktree,
      ),
    ) {
      OracleSetIncomplete { blocking: _, observations: _ } =>
        OraclePinNotRecorded {
          reason: join([
            "the declared validation oracle was not observable in the attempt worktree at ",
            worktree,
            " when the attempt was created",
          ], ""),
        }
      OracleSetObserved { identity, observations: _ } => {
        let revision = belt_worktree_head_revision(
          instance: instance,
          worktree: worktree,
        )
        if revision == "" {
          OraclePinNotRecorded {
            reason: "the attempt worktree's head revision could not be read, so the pinned oracle could not be attributed to a revision",
          }
        } else {
          OraclePinRecorded {
            identity: identity,
            revision: revision,
          }
        }
      }
    }
  }
}

fn belt_persist_oracle_pin_for_instance(
  instance: HostDashboardInstance,
  node: RoadmapNode,
  attempt_key: String,
  capture: AttemptOraclePinCapture,
) -> Bool {
  match capture {
    OraclePinNotRecorded { reason } =>
      Filesystem.Write(
        path: dispatch_attempt_oracle_pin_refusal_path_for_instance(
          instance: instance,
          node_id: node.node,
          attempt_key: attempt_key,
        ),
        content: reason,
      ).success
    OraclePinRecorded { identity, revision } => {
      let identity_write = Filesystem.Write(
        path: dispatch_attempt_oracle_identity_path_for_instance(
          instance: instance,
          node_id: node.node,
          attempt_key: attempt_key,
        ),
        content: serialize_content_hash(hash: identity) as String,
      )
      let revision_write = Filesystem.Write(
        path: dispatch_attempt_oracle_revision_path_for_instance(
          instance: instance,
          node_id: node.node,
          attempt_key: attempt_key,
        ),
        content: revision,
      )
      identity_write.success && revision_write.success
    }
  }
}

// THE TWO EXECUTION PHASES A CONTAINER NEEDS, kept as two because the belt already treats them
// differently: the CREATE step is the one whose failure means no container exists to clean up,
// while a failure in the START steps leaves a created container that must be torn down. Splitting
// by phase rather than by step count is what lets a single-step container and a four-step one share
// that error handling unchanged.
//
// The systemd container does all its work in the create step -- a transient unit is started with
// its command, its properties and its output redirection in one call -- so its start phase is
// empty. An empty step list is executed as a no-op by belt_exec_steps, which is the honest encoding
// of "this container has nothing further to do", not a skipped check.
fn belt_session_container_create_steps(container: DispatchSessionContainer) -> List<BeltExecStep> {
  match container {
    TmuxSessionContainer {
      spawn,
      default_shell: _,
      remain_on_exit: _,
      event_pipe: _,
      provider_start: _,
    } =>
      [BeltExecStep { step: "tmux-session-create", command: spawn }]
    SystemdUnitContainer { run } =>
      [BeltExecStep { step: "harness-unit-start", command: run }]
  }
}

fn belt_session_container_start_steps(container: DispatchSessionContainer) -> List<BeltExecStep> {
  match container {
    TmuxSessionContainer {
      spawn: _,
      default_shell,
      remain_on_exit,
      event_pipe,
      provider_start,
    } =>
      [
        BeltExecStep { step: "tmux-default-shell", command: default_shell },
        BeltExecStep { step: "tmux-remain-on-exit", command: remain_on_exit },
        BeltExecStep { step: "tmux-event-pipe", command: event_pipe },
        BeltExecStep { step: "provider-start", command: provider_start },
      ]
    SystemdUnitContainer { run: _ } => []
  }
}

fn belt_created_session_cleanup_detail(
  instance: HostDashboardInstance,
  session_name: String,
) -> String {
  match belt_exec(
    cmd: tmux_kill_session_argv_for_instance(
      instance: instance,
      session_name: session_name,
    ),
    workdir: belt_observe_workdir as String,
  ) {
    ExecOk { stdout: _ } => "created session reaped"
    ExecFailed { program: _, exit_code, stderr } =>
      join([
        "created-session cleanup failed with exit ",
        to_string(exit_code),
        ": ",
        stderr,
      ], "")
    ExecRefused { program: _, reason } =>
      join(["created-session cleanup refused: ", reason], "")
  }
}

fn belt_persist_spawn_failure_for_instance(
  instance: HostDashboardInstance,
  node: RoadmapNode,
  attempt_key: String,
  step: String,
  detail: String,
) -> String {
  let evidence = join([step, ": ", detail], "")
  let write = Filesystem.Write(
    path: dispatch_attempt_spawn_failure_path_for_instance(
      instance: instance,
      node_id: node.node,
      attempt_key: attempt_key,
    ),
    content: evidence,
  )
  if write.success {
    detail
  } else {
    join([
      detail,
      "; additionally failed to persist spawn evidence: ",
      write.error,
    ], "")
  }
}

// RLM-1: the THIRD outcome, produced by the shared launch admission. Spawned and SpawnFailed are
// actuation's answers once a launch is admitted; SpawnNotAdmitted is the admission's own refusal,
// carried as the typed LaunchRefusal (never flattened into a SpawnFailed step string) so the manual
// route, tick receipt and page project one identity and reason. Not a failure: a ManualReady tick
// reports one per Ready node it would have started, and the pass outcome stays Recorded.
// Spawned and SpawnFailed carry the exact LaunchIdentity that admitted the attempt (review
// 5059520727 finding 4: every surface matched `LaunchAdmitted { identity: _ }` and discarded it).
// The identity is threaded from the admission site through every actuation step — route response,
// tick outcome list, durable tick receipt (BeltTickReceipt.launches) and the attempt's state
// directory (launch-identity.json, beside environment-admission.json) — so RLM-4 joins an attempt
// to its admission by construction. SpawnNotAdmitted has no identity: no admission produced one.
type BeltSpawnOutcome
  = Spawned { node_id: String, session_name: String, provider: String, launch: LaunchIdentity }
  | SpawnFailed { node_id: String, step: String, detail: String, provider: String, launch: LaunchIdentity }
  | SpawnNotAdmitted { node_id: String, refusal: LaunchRefusal }

fn belt_dispatch_spawn_unselected_provider_wire_label() -> String {
  "unselected"
}

fn belt_dispatch_spawn_selection_refused_provider_wire_label(reason: NonEmptyStr) -> String {
  concat("selection-refused: ", reason as String)
}

fn belt_dispatch_spawn_provider_wire_label(provider: DispatchCliProvider) -> String {
  dispatch_provider_label(provider: provider)
}

// Spawn preflights the CLAUDE dependency before any actuation because both failure classes pass the
// exec seam SILENTLY (§5, found live 2026-07-23): tmux new-session exits 0 with the inner claude
// missing (the pane dies behind a fabricated Spawned), and an unseeded workspace-trust root blocks
// claude INTERACTIVELY on its per-path trust dialog (a hung session, not an error —
// --dangerously-skip-permissions does not cover it). Both are decidable BEFORE spawning and refuse
// as typed SpawnFailed rows: claude-on-PATH via the shell.PosixCommandV.Check authority belt_exec
// uses (step claude-cli; migrated off shell.Which.Check, crisp-wren-896, PR #8590), then the trust
// seed for the ONE dispatch worktree root, read from the claude trust store and classified by
// extdeps.llm.cli.claude_workspace_trust_seeded — the modeled home of what was hand-provisioned on
// srv1 at go-live (ancestor-inheritance makes the single root sufficient; steps claude-trust-home /
// claude-trust-store / claude-trust-seed, each detail naming the exact convergence). The DECISION
// is the pure witnessed fn belt_claude_preflight_decision (every arm on synthetic facts, like
// belt_observe_from_result); belt_claude_preflight only threads live observations in. Residue:
// refuse-with-instructions, not auto-seed — the trust store is claude's own runtime-mutable file,
// so a read-modify-write APPLY arm races the upstream writer; seeding stays with the live_deploy
// membership convergence (the go-live receipt's named dissolution).
type BeltClaudePreflight
  = ClaudePreflightOk
  | ClaudePreflightRefused { step: String, detail: String }

fn belt_claude_preflight_decision(
  claude_on_path: Bool,
  home: String,
  trust_store_path: String,
  trust_store_readable: Bool,
  trust_store_text: String,
  trust_root: String,
) -> BeltClaudePreflight {
  if !claude_on_path {
    ClaudePreflightRefused {
      step: "claude-cli",
      detail: "claude not found on PATH (which exit nonzero); tmux would spawn a pane that dies instantly — fail-closed, no fabricated Spawned",
    }
  } else if home == "" {
    ClaudePreflightRefused {
      step: "claude-trust-home",
      detail: "HOME unset or empty — cannot locate the claude trust store (~/.claude.json), so the workspace-trust seed is unknowable; fail-closed",
    }
  } else if !trust_store_readable {
    ClaudePreflightRefused {
      step: "claude-trust-store",
      detail: concat(
        concat("claude trust store unreadable at ", trust_store_path),
        " — claude blocks on its workspace-trust dialog for an unseeded root; seed it by launching claude once under the dispatch worktree root, or converge via the live_deploy membership",
      ),
    }
  } else if !claude_workspace_trust_seeded(config_text: trust_store_text, project_path: trust_root) {
    ClaudePreflightRefused {
      step: "claude-trust-seed",
      detail: concat(
        concat(concat("workspace trust not seeded for ", trust_root), " in "),
        concat(trust_store_path, " (projects entry with hasTrustDialogAccepted: true) — claude would block interactively on its trust dialog; ancestor-dir trust inheritance means seeding this ONE root covers every dispatch worktree"),
      ),
    }
  } else {
    ClaudePreflightOk
  }
}

fn belt_claude_preflight_for_instance(instance: HostDashboardInstance) -> BeltClaudePreflight {
  let claude_ok = belt_program_available(program: claude_cli_program)
  let home = match shell.Env.Get(name: "HOME" as NonEmptyStr).value {
    Absent => ""
    Present { value: v } => v
  }
  if !claude_ok || home == "" {
    belt_claude_preflight_decision(
      claude_on_path: claude_ok,
      home: home,
      trust_store_path: "",
      trust_store_readable: false,
      trust_store_text: "",
      trust_root: dashboard_instance_dispatch_worktree_root(instance: instance) as String,
    )
  } else {
    let path = claude_trust_store_path(home: home)
    let r = Filesystem.Read(path: path)
    belt_claude_preflight_decision(
      claude_on_path: claude_ok,
      home: home,
      trust_store_path: path,
      trust_store_readable: r.success,
      trust_store_text: r.content,
      trust_root: dashboard_instance_dispatch_worktree_root(instance: instance) as String,
    )
  }
}

fn belt_claude_preflight() -> BeltClaudePreflight {
  belt_claude_preflight_for_instance(instance: srv1_live_dashboard_instance())
}

type BeltCodexPreflight
  = CodexPreflightOk { auth_method: String }
  | CodexPreflightRefused { step: String, detail: String }

// Codex preflight owns only facts decidable before actuation. Exact env and codex executable paths
// are admitted first; then `env CODEX_HOME=<dedicated-root> codex --version` must show the provider
// identity marker before a separate `codex login status` — separating a broken npm launcher/runtime
// dependency from unauthenticated OAuth. Login exit 0 is the CLI's active-auth verdict, stdout
// retained as the method receipt; auth.json is never parsed and file presence is never
// authentication. Subscription exhaustion and upstream/rate failures occur only after codex exec
// starts and belong to provider JSONL (`turn.failed` / `error`) plus retained process exit.
fn belt_codex_preflight_decision_observed_for_home(
  codex_home: String,
  codex_on_path: Bool,
  env_on_path: Bool,
  identity_command_success: Bool,
  identity_stdout: String,
  identity_stderr: String,
  login_status_success: Bool,
  login_status_stdout: String,
  login_status_stderr: String,
) -> BeltCodexPreflight {
  let identity_realized = identity_command_success
    && codex_runtime_version_identity_satisfied(
      combined_output: join([identity_stdout, "\n", identity_stderr], ""),
    )
  if !codex_on_path {
    CodexPreflightRefused {
      step: "codex-cli",
      detail: "codex not found on PATH; refusing before worktree creation",
    }
  } else if !env_on_path {
    CodexPreflightRefused {
      step: "codex-env",
      detail: "env not found on PATH; cannot bind the dedicated CODEX_HOME for auth or execution",
    }
  } else if !identity_realized {
    CodexPreflightRefused {
      step: "codex-identity",
      detail: join([
        "codex --version did not realize ",
        codex_runtime_version_identity_marker(),
        "; stdout: ",
        identity_stdout,
        "; stderr: ",
        identity_stderr,
      ], ""),
    }
  } else if !login_status_success {
    CodexPreflightRefused {
      step: "codex-auth",
      detail: join([
        "codex login status exited nonzero for ",
        codex_home,
        "; stdout: ",
        login_status_stdout,
        "; stderr: ",
        login_status_stderr,
      ], ""),
    }
  } else {
    CodexPreflightOk { auth_method: login_status_stdout }
  }
}

fn belt_codex_preflight_for_instance(instance: HostDashboardInstance) -> BeltCodexPreflight {
  match dashboard_instance_provider_executable(instance: instance) {
    Absent =>
      CodexPreflightRefused {
        step: "codex-executable-placement",
        detail: dashboard_instance_provider_executable_refusal_detail(instance: instance),
      }
    Present { value: codex_program } => {
      let codex_home = dashboard_instance_provider_state_root(instance: instance) as String
      let codex_program_str = codex_program as String
      let env_program = dispatch_capability_program(
        environment: instance.execution_environment,
        cap: EnvironmentBindingCapability,
      )
      let codex_ok = belt_program_available(program: codex_program_str)
      let env_ok = belt_program_available(program: env_program)
      if !codex_ok || !env_ok {
        belt_codex_preflight_decision_observed_for_home(
          codex_home: codex_home,
          codex_on_path: codex_ok,
          env_on_path: env_ok,
          identity_command_success: false,
          identity_stdout: "",
          identity_stderr: "",
          login_status_success: false,
          login_status_stdout: "",
          login_status_stderr: "",
        )
      } else {
        let identity = gunbc.WitnessBin.Run(
          workdir: belt_observe_workdir,
          bin_path: env_program as FilePath,
          args: shape_codex_version_env_args_for_program(
            program: codex_program_str,
            codex_home: codex_home,
          ),
          expect: OutcomeIsData,
        )
        let identity_realized = identity.success
          && codex_runtime_version_identity_satisfied(
            combined_output: join([identity.stdout, "\n", identity.stderr], ""),
          )
        if !identity_realized {
          belt_codex_preflight_decision_observed_for_home(
            codex_home: codex_home,
            codex_on_path: codex_ok,
            env_on_path: env_ok,
            identity_command_success: identity.success,
            identity_stdout: identity.stdout,
            identity_stderr: identity.stderr,
            login_status_success: false,
            login_status_stdout: "",
            login_status_stderr: "",
          )
        } else {
          let result = gunbc.WitnessBin.Run(
            workdir: belt_observe_workdir,
            bin_path: env_program as FilePath,
            args: shape_codex_login_status_env_args_for_program(
              program: codex_program_str,
              codex_home: codex_home,
            ),
            expect: OutcomeIsData,
          )
          belt_codex_preflight_decision_observed_for_home(
            codex_home: codex_home,
            codex_on_path: codex_ok,
            env_on_path: env_ok,
            identity_command_success: identity.success,
            identity_stdout: identity.stdout,
            identity_stderr: identity.stderr,
            login_status_success: result.success,
            login_status_stdout: result.stdout,
            login_status_stderr: result.stderr,
          )
        }
      }
    }
  }
}

fn belt_codex_preflight() -> BeltCodexPreflight {
  belt_codex_preflight_for_instance(instance: srv1_live_dashboard_instance())
}

type BeltProviderPreflight
  = ProviderPreflightOk
  | ProviderPreflightRefused { step: String, detail: String }

fn belt_provider_preflight_for_instance(
  instance: HostDashboardInstance,
  provider: DispatchCliProvider,
) -> BeltProviderPreflight {
  match provider {
    ClaudeCodeProvider =>
      match belt_claude_preflight_for_instance(instance: instance) {
        ClaudePreflightOk => ProviderPreflightOk
        ClaudePreflightRefused { step: st, detail: d } =>
          ProviderPreflightRefused { step: st, detail: d }
      }
    CodexDispatchProvider =>
      match belt_codex_preflight_for_instance(instance: instance) {
        CodexPreflightOk { auth_method: _ } => ProviderPreflightOk
        CodexPreflightRefused { step: st, detail: d } =>
          ProviderPreflightRefused { step: st, detail: d }
      }
    CursorDispatchProvider =>
      ProviderPreflightRefused {
        step: "cursor-provider-preflight",
        detail: "cursor dispatch is not yet wired on this actuator path",
      }
    GunbcHarnessProvider =>
      match harness_observe_backend() {
        HarnessBackendServing { model: _ } => ProviderPreflightOk
        HarnessBackendModelAbsent { model: m, advertised: a } =>
          ProviderPreflightRefused {
            step: "harness-backend-model",
            detail: join([
              "the harness backend is reachable but does not advertise ", m,
              "; it advertises: ", a,
            ], ""),
          }
        HarnessBackendUnreachable { url: u } =>
          ProviderPreflightRefused {
            step: "harness-backend-reachability",
            detail: join(["the harness backend did not answer ", u], ""),
          }
        HarnessBackendUnreadable { cause: c } =>
          ProviderPreflightRefused {
            step: "harness-backend-model-list",
            detail: join(["the harness backend answered unreadably: ", c], ""),
          }
      }
  }
}

fn belt_provider_preflight(provider: DispatchCliProvider) -> BeltProviderPreflight {
  belt_provider_preflight_for_instance(
    instance: srv1_live_dashboard_instance(),
    provider: provider,
  )
}

// Step 0b: the runtime admits against its own deployment footprint BEFORE mutating anything. The
// 2026-07-30 incident: staging ran `git worktree add` (389ms, ok) then `install -d` into an
// attempt-state root missing under a root-owned parent (3ms, EACCES) — the short-circuit worked and
// still left an orphan branch and worktree per click, because the first durable mutation preceded
// discovery. Step 0a made the root a converged deployment member so it EXISTS; this gate makes its
// absence or unwritability REFUSE FIRST — a class that cannot recur versus one recurring once per
// host between deploys.
//
// THE ROOTS COME FROM THE INSTANCE, NOT live_deploy's srv1 roster — not a second footprint: the
// instance is the runtime's own view of the paths it writes, so a lab/preview instance under a
// disjoint root admits against ITS roots while gunbc.live_deploy.spec stays the provisioner's view
// of srv1. Step 1 unifies both into one member list with permissions; until then the belt reads
// what it was handed rather than a host-specific roster.
//
// WRITABILITY IS PROBED AS WRITE AND SEARCH, since POSIX needs both to create a directory entry:
// `test -w` alone passes on a mode-0644 directory and the next `install -d` still fails — the
// fabricated precondition this gate removes. Search reuses shell.Test.IsExecutable: `test -x` on a
// directory IS the search bit, the cited operation in its directory sense, not a minted probe. The
// frame is the EFFECTIVE principal: the probes run in the serve process, answering for the account
// that performs the mutation (a provisioner-side SSH probe answers for the deploy principal and
// would admit a root the runtime cannot write).
//
// Known conflation, named not modeled away: a probe that could not execute reads present=false,
// like an absent root. Both arms REFUSE, nothing is fabricated, the remedy is a converge in both;
// only the detail line misattributes, and `test` is a coreutils/shell builtin whose absence would
// already break belt_exec's which-check. Splitting adds a third state whose branches take the same
// action.
//
// OutcomeIsData ADMISSIBILITY (discharging gunbc.output_policy outcome_is_data_note's review
// obligation): all three probes are annotated because a non-zero `test` exit is an ANSWER — root
// absent / not writable / not searchable — ambient in both contexts: production refuses the spawn,
// witnesses assert the refusal arm. Satisfied structurally: belt_footprint_observe returns
// BeltFootprintObservation and belt_footprint_admission_for_instance returns
// BeltFootprintAdmission, so each exit feeds a typed consumer, never unit. Dispatch failure of the
// probe ITSELF stays anomalous, not silenced by the annotation.
type BeltFootprintRoot {
  member: String
  path: String
}

fn belt_dispatch_footprint_roots(instance: HostDashboardInstance) -> List<BeltFootprintRoot> {
  [
    BeltFootprintRoot {
      member: "dispatch-worktree-root",
      path: dashboard_instance_dispatch_worktree_root(instance: instance) as String,
    },
    BeltFootprintRoot {
      member: "attempt-state-root",
      path: dashboard_instance_dispatch_attempt_state_root(instance: instance) as String,
    },
  ]
}

type BeltFootprintObservation {
  member: String
  path: String
  present: Bool
  writable: Bool
  searchable: Bool
}

type BeltFootprintAdmission
  = FootprintAdmitted
  | FootprintRefused { step: String, detail: String }

fn belt_footprint_root_verdict(obs: BeltFootprintObservation) -> BeltFootprintAdmission {
  if !obs.present {
    FootprintRefused {
      step: "footprint-root-absent",
      detail: join([
        "deployment member ", obs.member, " is not a directory at ", obs.path,
        " — the belt writes there on every dispatch, so staging would mutate the worktree and then fail; converge the member (gunbc.live_deploy.spec deployment_owned_steps) rather than creating it by hand",
      ], ""),
    }
  } else if !obs.writable {
    FootprintRefused {
      step: "footprint-root-unwritable",
      detail: join([
        "deployment member ", obs.member, " at ", obs.path,
        " is not writable by the effective runtime principal — the deploy converges it owned by the service user; a root owned by anyone else means the instance was hand-provisioned or the member's ownership drifted",
      ], ""),
    }
  } else if !obs.searchable {
    FootprintRefused {
      step: "footprint-root-unsearchable",
      detail: join([
        "deployment member ", obs.member, " at ", obs.path,
        " is writable but not searchable by the effective runtime principal — POSIX requires write AND search to create an entry, so staging would still fail on a directory this gate would otherwise admit",
      ], ""),
    }
  } else {
    FootprintAdmitted
  }
}

fn belt_footprint_admission_decision(
  observations: List<BeltFootprintObservation>,
) -> BeltFootprintAdmission {
  fold(observations, init: FootprintAdmitted, f: (acc, obs) =>
    match acc {
      FootprintRefused { step: st, detail: d } =>
        FootprintRefused { step: st, detail: d }
      FootprintAdmitted => belt_footprint_root_verdict(obs: obs)
    }
  )
}

fn belt_footprint_observe(root: BeltFootprintRoot) -> BeltFootprintObservation {
  BeltFootprintObservation {
    member: root.member,
    path: root.path,
    present: shell.Test.IsDirectory(
      path: root.path as FilePath,
      expect: OutcomeIsData,
    ).is_directory,
    writable: shell.Test.IsWritable(
      path: root.path as FilePath,
      expect: OutcomeIsData,
    ).writable,
    searchable: shell.Test.IsExecutable(
      path: root.path as FilePath,
      expect: OutcomeIsData,
    ).executable,
  }
}

fn belt_footprint_admission_for_instance(
  instance: HostDashboardInstance,
) -> BeltFootprintAdmission {
  belt_footprint_admission_decision(
    observations: map(
      belt_dispatch_footprint_roots(instance: instance),
      r => belt_footprint_observe(root: r),
    ),
  )
}

fn belt_actuate_spawn_for_instance(
  instance: HostDashboardInstance,
  node: RoadmapNode,
  probed_at: String,
  launch: LaunchIdentity,
) -> BeltSpawnOutcome {
  match belt_footprint_admission_for_instance(instance: instance) {
    FootprintRefused { step: fst, detail: fd } =>
      SpawnFailed {
        node_id: node.node as String,
        step: fst,
        detail: fd,
        provider: belt_dispatch_spawn_unselected_provider_wire_label(),
        launch: launch,
      }
    FootprintAdmitted =>
  match dispatch_environment_admit(
    contract: node.execution,
    environment: instance.execution_environment,
  ) {
    EnvironmentRefused { receipts, validation_summary, reason } =>
      SpawnFailed {
        node_id: node.node as String,
        step: "environment-admission",
        detail: dispatch_environment_admission_json(
          admission: EnvironmentRefused {
            receipts: receipts,
            validation_summary: validation_summary,
            reason: reason,
          },
        ),
        provider: belt_dispatch_spawn_unselected_provider_wire_label(),
        launch: launch,
      }
    EnvironmentAdmitted { receipts, validation_summary } =>
      match dispatch_actuator_selection(node_sizing: node.sizing) {
        DispatchActuatorSelectionRefused { reason } =>
          SpawnFailed {
            node_id: node.node as String,
            step: "dispatch-selection",
            detail: reason as String,
            provider: belt_dispatch_spawn_selection_refused_provider_wire_label(reason: reason),
            launch: launch,
          }
        DispatchActuatorSelectionOk { provider, effort: _, process_fingerprint: _ } =>
          match belt_provider_preflight_for_instance(
            instance: instance,
            provider: provider,
          ) {
            ProviderPreflightRefused { step: st, detail: d } =>
              SpawnFailed {
                node_id: node.node as String,
                step: st,
                detail: d,
                provider: belt_dispatch_spawn_provider_wire_label(provider: provider),
                launch: launch,
              }
            ProviderPreflightOk =>
              belt_actuate_spawn_exec_for_instance(
                instance: instance,
                node: node,
                probed_at: probed_at,
                admission_receipt: dispatch_environment_admission_json(
                  admission: EnvironmentAdmitted {
                    receipts: receipts,
                    validation_summary: validation_summary,
                  },
                ),
                provider_wire_label: belt_dispatch_spawn_provider_wire_label(provider: provider),
                launch: launch,
              )
          }
      }
  }
  }
}

fn belt_actuate_spawn_exec_for_instance(
  instance: HostDashboardInstance,
  node: RoadmapNode,
  probed_at: String,
  admission_receipt: String,
  provider_wire_label: String,
  launch: LaunchIdentity,
) -> BeltSpawnOutcome {
  belt_actuate_spawn_exec_modeled(
    instance: instance,
    node: node,
    probed_at: probed_at,
    workdir: instance.repo_root as String,
    admission_receipt: admission_receipt,
    provider_wire_label: provider_wire_label,
    launch: launch,
  )
}

// The tmux creation boundary is explicit: worktree/state publication first; tmux new-session alone;
// only after its success do session configuration, pipe attachment and provider respawn run. A
// later staging failure reaps exactly the session this request created, no name-only ownership
// guess. Worktree, branch and attempt evidence are retained for diagnosis and user work. The
// located failure plus cleanup receipt is persisted under the published attempt before SpawnFailed
// returns.
fn belt_actuate_spawn_exec_modeled(
  instance: HostDashboardInstance,
  node: RoadmapNode,
  probed_at: String,
  workdir: String,
  admission_receipt: String,
  provider_wire_label: String,
  launch: LaunchIdentity,
) -> BeltSpawnOutcome {
  let attempt_key = dispatch_attempt_key(
    node_id: node.node,
    probed_at: probed_at,
  )
  let session_name = dispatch_tmux_session_name(node_id: node.node)
  match belt_resolved_spawn_plan(
    instance: instance,
    node: node,
    session_uuid: belt_spawn_session_uuid(node_id: node.node as String, probed_at: probed_at),
    attempt_key: attempt_key,
  ) {
    DispatchSpawnRefused { step, detail } =>
      SpawnFailed {
        node_id: node.node as String,
        step: step as String,
        detail: detail,
        provider: provider_wire_label,
        launch: launch,
      }
    DispatchSpawnReady { commands: cmds } =>
  match belt_exec_steps(
    steps: [
      BeltExecStep { step: "worktree-add", command: cmds.worktree_add },
      BeltExecStep {
        step: "attempt-state-prepare",
        command: cmds.attempt_state_prepare,
      },
    ],
    workdir: workdir,
  ) {
    ExecStepFailed { step, detail } =>
      SpawnFailed {
        node_id: node.node as String,
        step: step,
        detail: detail,
        provider: provider_wire_label,
        launch: launch,
      }
    ExecStepsOk =>
      match belt_attempt_state_initialize_for_instance(
        instance: instance,
        node: node,
        attempt_key: attempt_key,
        admission_receipt: admission_receipt,
        launch: launch,
      ) {
        AttemptStateInitializationFailed { step, detail } =>
          SpawnFailed {
            node_id: node.node as String,
            step: step,
            detail: detail,
            provider: provider_wire_label,
            launch: launch,
          }
        AttemptStateInitialized =>
          match belt_exec_steps(
            steps: [
              BeltExecStep {
                step: "attempt-current-publish",
                command: cmds.attempt_current_pointer,
              },
            ],
            workdir: workdir,
          ) {
            ExecStepFailed { step, detail } =>
              SpawnFailed {
                node_id: node.node as String,
                step: step,
                detail: detail,
                provider: provider_wire_label,
                launch: launch,
              }
            ExecStepsOk =>
              match belt_exec_steps(
                steps: belt_session_container_create_steps(container: cmds.session_container),
                workdir: workdir,
              ) {
                ExecStepFailed { step, detail } =>
                  SpawnFailed {
                    node_id: node.node as String,
                    step: step,
                    detail: belt_persist_spawn_failure_for_instance(
                      instance: instance,
                      node: node,
                      attempt_key: attempt_key,
                      step: step,
                      detail: detail,
                    ),
                    provider: provider_wire_label,
                    launch: launch,
                  }
                ExecStepsOk =>
                  match belt_exec_steps(
                    steps: belt_session_container_start_steps(container: cmds.session_container),
                    workdir: workdir,
                  ) {
                    ExecStepsOk =>
                      Spawned {
                        node_id: node.node as String,
                        session_name: session_name,
                        provider: provider_wire_label,
                        launch: launch,
                      }
                    ExecStepFailed { step, detail } => {
                      let cleanup = belt_created_session_cleanup_detail(
                        instance: instance,
                        session_name: session_name,
                      )
                      let full_detail = join([
                        detail,
                        "; ",
                        cleanup,
                      ], "")
                      SpawnFailed {
                        node_id: node.node as String,
                        step: step,
                        detail: belt_persist_spawn_failure_for_instance(
                          instance: instance,
                          node: node,
                          attempt_key: attempt_key,
                          step: step,
                          detail: full_detail,
                        ),
                        provider: provider_wire_label,
                        launch: launch,
                      }
                    }
                  }
              }
          }
      }
  }
}
}

fn belt_actuate_spawn(node: RoadmapNode, probed_at: String, workdir: String, launch: LaunchIdentity) -> BeltSpawnOutcome {
  let instance = srv1_live_dashboard_instance()
  match dispatch_environment_admit(
    contract: node.execution,
    environment: instance.execution_environment,
  ) {
    EnvironmentRefused { receipts, validation_summary, reason } =>
      SpawnFailed {
        node_id: node.node as String,
        step: "environment-admission",
        detail: dispatch_environment_admission_json(
          admission: EnvironmentRefused {
            receipts: receipts,
            validation_summary: validation_summary,
            reason: reason,
          },
        ),
        provider: belt_dispatch_spawn_unselected_provider_wire_label(),
        launch: launch,
      }
    EnvironmentAdmitted { receipts, validation_summary } =>
      match dispatch_actuator_selection(node_sizing: node.sizing) {
        DispatchActuatorSelectionRefused { reason } =>
          SpawnFailed {
            node_id: node.node as String,
            step: "dispatch-selection",
            detail: reason as String,
            provider: belt_dispatch_spawn_selection_refused_provider_wire_label(reason: reason),
            launch: launch,
          }
        DispatchActuatorSelectionOk { provider, effort: _, process_fingerprint: _ } =>
          match belt_provider_preflight(provider: provider) {
            ProviderPreflightRefused { step: st, detail: d } =>
              SpawnFailed {
                node_id: node.node as String,
                step: st,
                detail: d,
                provider: belt_dispatch_spawn_provider_wire_label(provider: provider),
                launch: launch,
              }
            ProviderPreflightOk =>
              belt_actuate_spawn_exec(
                node: node,
                probed_at: probed_at,
                workdir: workdir,
                admission_receipt: dispatch_environment_admission_json(
                  admission: EnvironmentAdmitted {
                    receipts: receipts,
                    validation_summary: validation_summary,
                  },
                ),
                provider_wire_label: belt_dispatch_spawn_provider_wire_label(provider: provider),
                launch: launch,
              )
          }
      }
  }
}

fn belt_actuate_spawn_exec(
  node: RoadmapNode,
  probed_at: String,
  workdir: String,
  admission_receipt: String,
  provider_wire_label: String,
  launch: LaunchIdentity,
) -> BeltSpawnOutcome {
  belt_actuate_spawn_exec_modeled(
    instance: srv1_live_dashboard_instance(),
    node: node,
    probed_at: probed_at,
    workdir: workdir,
    admission_receipt: admission_receipt,
    provider_wire_label: provider_wire_label,
    launch: launch,
  )
}

type BeltTeardownOutcome
  = ReapedSession { session_name: String }
  | TeardownFailed { session_name: String, detail: String }

fn belt_actuate_teardown_for_instance(
  instance: HostDashboardInstance,
  session_name: String,
) -> BeltTeardownOutcome {
  match belt_exec(
    cmd: tmux_kill_session_argv_for_instance(
      instance: instance,
      session_name: session_name,
    ),
    workdir: belt_observe_workdir as String,
  ) {
    ExecOk { stdout: _ } => ReapedSession { session_name: session_name }
    ExecFailed { program: _, exit_code: _, stderr: e } =>
      TeardownFailed { session_name: session_name, detail: e }
    ExecRefused { program: _, reason: r } =>
      TeardownFailed { session_name: session_name, detail: r }
  }
}

fn belt_actuate_teardown(session_name: String) -> BeltTeardownOutcome {
  belt_actuate_teardown_for_instance(
    instance: srv1_live_dashboard_instance(),
    session_name: session_name,
  )
}

// The reconcile guarantees spawns are DesiredMembers (carry the RoadmapNode for the brief) and
// teardowns ObservedMembers (carry the live session). The cross arms are unreachable by
// construction; if reached they REFUSE (typed SpawnFailed/TeardownFailed), never a fabricated
// action — DESIGN §5 (no spawn without a node model, no teardown without an observed session).
data belt_session_uuid_salt: NonEmptyStr = "belt-session-uuid-v1" as NonEmptyStr

// The UUID is the Claude provider's --session-id input (Claude requires a valid UUID). It is
// computed for every provider so dispatch_spawn_commands has one arity, but CodexCliProvider
// ignores it and lets Codex mint its persisted thread id. For Claude it is ATTEMPT-scoped (U1
// redispatch fix 2026-07-25): (node_id x the spawn's clock observation) reshaped to RFC-4122 v4;
// the earlier node-deterministic derivation made every node one-shot at the Claude layer. Reconcile
// idempotency never keys on it — the node-grain tmux session name is the observation key.
fn belt_uuid_stamped_id(node_id: String, probed_at: String) -> NonEmptyStr {
  join([node_id, "\n", probed_at], "") as NonEmptyStr
}

fn belt_uuid_hex32(node_id: String, probed_at: String) -> String {
  concat(
    content_hash_atom(value: belt_uuid_stamped_id(node_id: node_id, probed_at: probed_at)).digest as String,
    content_hash_combine_structural(
      left: content_hash_atom(value: belt_uuid_stamped_id(node_id: node_id, probed_at: probed_at)),
      right: content_hash_atom(value: belt_session_uuid_salt),
    ).digest as String,
  )
}

fn belt_uuid_rfc4122(hex: String) -> String {
  concat(substring(s: hex, start: 0, end: 12),
  concat("4",
  concat(substring(s: hex, start: 13, end: 16),
  concat("8",
  substring(s: hex, start: 17, end: 32)))))
}

fn belt_uuid_dash(v: String) -> String {
  concat(substring(s: v, start: 0, end: 8),
  concat("-",
  concat(substring(s: v, start: 8, end: 12),
  concat("-",
  concat(substring(s: v, start: 12, end: 16),
  concat("-",
  concat(substring(s: v, start: 16, end: 20),
  concat("-",
  substring(s: v, start: 20, end: 32)))))))))
}

// THE SPAWN CONSUMES THE SELECTION THE ADMISSION ALREADY MADE, rather than re-deriving it through
// the vendor selector.
//
// This call used to hand default_provider_selection_request() to the vendor path, which then chose
// a provider for itself. That was already a second decision beside dispatch_actuator_selection --
// two answers to "who executes this attempt", reconciled by both happening to say Codex -- and it
// became visible the moment they could disagree: the dispatch receipt reported provider
// "gunbc-harness" from the first decision while the spawn refused with the vendor selector's
// "no provider offer is selection-eligible" from the second. One route reporting another route's
// refusal is the forked-authority shape DESIGN section 3 names.
//
// dispatch_spawn_commands_for_resolved_instance already existed for exactly this: it takes the
// resolved executor and skips the inventory entirely. So the selection is made once, and the spawn
// consumes it.
fn belt_resolved_spawn_plan(
  instance: HostDashboardInstance,
  node: RoadmapNode,
  session_uuid: String,
  attempt_key: String,
) -> DispatchSpawnPlan {
  match dispatch_actuator_selection(node_sizing: node.sizing) {
    DispatchActuatorSelectionRefused { reason } =>
      DispatchSpawnRefused {
        step: "dispatch-selection" as NonEmptyStr,
        detail: reason as String,
      }
    DispatchActuatorSelectionOk { provider, effort, process_fingerprint: _ } =>
      dispatch_spawn_commands_for_resolved_instance(
        instance: instance,
        node: node,
        session_uuid: session_uuid,
        attempt_key: attempt_key,
        provider: provider,
        effort: effort,
      )
  }
}

fn belt_spawn_session_uuid(node_id: String, probed_at: String) -> String {
  belt_uuid_dash(v: belt_uuid_rfc4122(hex: belt_uuid_hex32(node_id: node_id, probed_at: probed_at)))
}

fn belt_actuate_spawn_member(m: DispatchMember, workdir: String, launch: LaunchIdentity) -> BeltSpawnOutcome {
  match m {
    DesiredMember { node_id: nid, node: node } =>
      match clock_now_probed_at() {
        Present { value: probed_at } =>
          belt_actuate_spawn(node: node, probed_at: probed_at as String, workdir: workdir, launch: launch)
        Absent =>
          SpawnFailed {
            node_id: nid,
            step: "attempt-clock",
            detail: "clock observation refused; an attempt without a stamp would collide with a later one — fail-closed, no unknown-stamped attempts",
            provider: belt_dispatch_spawn_unselected_provider_wire_label(),
            launch: launch,
          }
      }
    ObservedMember { node_id: nid, session: _ } =>
      SpawnFailed {
        node_id: nid,
        step: "member-shape",
        detail: "belt spawn expected DesiredMember (carries node for brief); got ObservedMember — fail-closed, no spawn without a node model",
        provider: belt_dispatch_spawn_unselected_provider_wire_label(),
        launch: launch,
      }
  }
}

fn belt_actuate_teardown_member(m: DispatchMember) -> BeltTeardownOutcome {
  match m {
    ObservedMember { node_id: _, session: session } =>
      belt_actuate_teardown(session_name: session.session_name)
    DesiredMember { node_id: nid, node: _ } =>
      TeardownFailed {
        session_name: nid,
        detail: "belt teardown expected ObservedMember (carries live session); got DesiredMember — fail-closed, no teardown without an observed session",
      }
  }
}

type BeltObserve
  = Observed { live: List<DispatchLiveSession> }
  | ObserveRefused { reason: String }

// tmux-present is the FIRST precondition: tmux not on PATH -> ObserveRefused (the belt cannot know
// what is live). Once present, the observe half must NOT widen an exec failure into a zero-session
// answer (§5 absorbing fallback, ⊤-as-answer vs ⊤-as-ignorance). extdeps.tmux
// classify_tmux_session_list is the sole authority for tmux ls outcome facts (listed sessions,
// documented no-server signals, stdout parse refusal, unknowable stderr); this module maps them to
// belt policy only: TmuxSessionsListed -> filter dispatch sessions into Observed live rows;
// TmuxNoServer -> Observed []; TmuxListStdoutRefused and TmuxListUnknowable -> ObserveRefused with
// located evidence, never a blind spawn/reap. First-tick bootstrap works under either no-server
// spelling the classifier admits. The decision is a pure fn so every arm is witnessed
// (belt_observe_from_result witnesses); belt_observe only threads live WitnessBin.Run fields in.
fn belt_ls_stdout_refusal_reason(
  line_number: Int,
  raw: String,
  reason: String,
) -> String {
  join([
    "belt_observe: tmux ls stdout parse refused at line ",
    to_string(line_number),
    ": ",
    reason,
    "; raw=",
    raw,
    " — the live session set is unknowable; fail-closed, no blind spawn/reap",
  ], "")
}

fn belt_observe_from_result(
  success: Bool,
  stdout: String,
  stderr: String,
) -> BeltObserve {
  match classify_tmux_session_list(exit_ok: success, stdout: stdout, stderr: stderr) {
    TmuxSessionsListed { entries } =>
      Observed {
        live: dispatch_live_sessions_from_entries(entries: entries),
      }
    TmuxNoServer { evidence: _ } =>
      Observed { live: [] }
    TmuxListStdoutRefused { line_number, raw, reason } =>
      ObserveRefused {
        reason: belt_ls_stdout_refusal_reason(
          line_number: line_number,
          raw: raw,
          reason: reason,
        ),
      }
    TmuxListUnknowable { stderr: e } =>
      ObserveRefused {
        reason: concat(
          "belt_observe: tmux ls exited nonzero with no documented no-server/no-sessions signal — the live session set is unknowable; fail-closed, no blind spawn/reap. stderr: ",
          e,
        ),
      }
  }
}

// belt_observe and belt_observe_for_instance ARE DELETED: they observed the tmux session NAME set
// only, so a retained dead pane read as a live agent — the defect this arc removed. Dispatch and
// tick now call belt_sessions_observe_for_instance, which classifies each row's process evidence.
//
// belt_observe_from_result SURVIVES DELIBERATELY, reached only by witnesses. Its subject is the
// tmux stdout parse (nonzero exit with no documented no-server marker, unparseable line, empty
// set); deleting it would delete that evidence with the caller — §4b: a climb dissolves lower-rung
// production handling, never the discriminating evidence. Its parse duty is subsumed by
// classify_tmux_session_list, which the live observer uses; dissolve-on: those parse witnesses
// re-pointed at classify_tmux_session_list with the refusal cases preserved one-for-one, at which
// point this function and this note go together.
type BeltPassOutcome
  = BeltPassRecorded
  | BeltPassDeferred { reason: String }
  | BeltPassRefused { reason: String }
  | BeltPassFailed { reason: String }

// THE EXECUTION STANDING (RLM-2 ruling section 6): a receipt names the instance that ticked, the
// revision the instance was serving, and the mode the tick ran under -- or says why it could not
// bind those -- so a reader can tell a fresh tick of THIS deployment from any other file that
// parses. `receipt_identity` is DERIVED from the members (belt_tick_receipt_identity_hex), written
// on the wire and verified on decode; it is not a stored field, because a stored copy would be a
// second authority for what the members already say.
type BeltTickExecutionStanding
  = TickExecuted { instance_id: String, deployed_revision: String, spawn_mode: SpawnMode }
  | TickExecutionWithheld { refusal: String }

type BeltTickReceipt {
  observed_at: String,
  execution: BeltTickExecutionStanding,
  launches: List<LaunchIdentity>,
  spawn_pass: BeltPassOutcome,
  teardown_pass: BeltPassOutcome,
  verify_pass: BeltPassOutcome,
  publish_pass: BeltPassOutcome,
}

type BeltTickReceiptRead
  = BeltTickReceiptPresent { receipt: BeltTickReceipt }
  | BeltTickReceiptAbsent
  | BeltTickReceiptUnreadable { reason: String }

// THE PERSISTED TICK RECEIPT IS WHAT THE WORKFLOW UI READS to say whether a tick ran, deferred,
// refused or failed — previously only journald stdout, so the row could not say 'Verification
// queued - next belt tick' or 'blocked - belt session observation refused'. Each pass is typed
// independently (BeltPassOutcome): spawn/teardown depend on tmux session observation; verify only
// on the attempt ledger plus terminal provider/process evidence; publish on exact verified head
// plus repository observation. A tmux-list refusal may block spawn/reap while verify still examines
// its own evidence (DESIGN section 5: refuse narrowly, never widen to zeroing sibling passes).
// Written to the instance's receipts directory (gunbc.host_layout instance_receipts_dir) so
// /workflow.json reads it without re-running the belt. CORRECTED 2026-08-19: this sentence read
// 'beside the instance's attempt-state root', wrong two ways and recorded rather than reworded. The
// code wrote <instance_root>/belt-last-tick.json, a root-owned directory, so the receipt was EACCES
// and absent on every instance. And the attempt-state root is not per-instance: the srv1 pair is
// DispatchStateHostShared, so blue and green resolve it to ONE path and a receipt there would
// answer for two instances. A note describing a home the implementation did not and could not
// safely use is the stale-authority class of DESIGN section 3.
data belt_tick_receipt_schema: String = "roadmap-belt-tick-receipt/v4"

// THE RECEIPT HAD NO WRITABLE HOME AND HAS NEVER BEEN WRITTEN ON ANY INSTANCE. The path was
// <instance_root>/belt-last-tick.json; every instance_root on srv1 is root:root 0755 while the belt
// runs as the service user, so the write was EACCES on blue and green alike and the file was absent
// from both on 2026-08-19. The workflow UI reads this receipt to say whether a tick ran, deferred,
// refused or failed, so its absence is exactly the operator's "nothing seems to be changing": the
// belt could run and leave the row nothing to render.
//
// The fix is a home the service principal owns, not an elevation at write time: the instance's
// receipts directory, bootstrapped by the deploy through the granted install -d -o <service-user>
// (live_deploy.emit BeltTimerUnit apply) — the mechanism and reasoning
// fleet_converge_receipt_atomic_publish_note records for the converge receipt beside it.
//
// NOT the dispatch attempt-state root, though service-user-owned and closer-looking: the srv1 pair
// is DispatchStateHostShared, so blue and green resolve
// dashboard_instance_dispatch_attempt_state_root to ONE path and a receipt there would answer for
// two instances. Deriving from instance_root keeps it per-instance by construction.
fn belt_tick_receipt_path_for_instance(instance: HostDashboardInstance) -> String {
  join([
    instance_receipts_dir(instance_root: instance.instance_root as String),
    "/belt-last-tick.json",
  ], "")
}

fn belt_pass_outcome_key(o: BeltPassOutcome) -> String {
  match o {
    BeltPassRecorded => "recorded"
    BeltPassDeferred { reason: _ } => "deferred"
    BeltPassRefused { reason: _ } => "refused"
    BeltPassFailed { reason: _ } => "failed"
  }
}

fn belt_pass_outcome_json(o: BeltPassOutcome) -> JsonValue {
  match o {
    BeltPassRecorded =>
      json_object(members: [
        json_kv(key: "outcome", value: json_string(s: "recorded")),
      ])
    BeltPassDeferred { reason: r } =>
      json_object(members: [
        json_kv(key: "outcome", value: json_string(s: "deferred")),
        json_kv(key: "reason", value: json_string(s: r)),
      ])
    BeltPassRefused { reason: r } =>
      json_object(members: [
        json_kv(key: "outcome", value: json_string(s: "refused")),
        json_kv(key: "reason", value: json_string(s: r)),
      ])
    BeltPassFailed { reason: r } =>
      json_object(members: [
        json_kv(key: "outcome", value: json_string(s: "failed")),
        json_kv(key: "reason", value: json_string(s: r)),
      ])
  }
}

type BeltPassOutcomeDecode
  = BeltPassOutcomeDecoded { outcome: BeltPassOutcome }
  | BeltPassOutcomeUnreadable { reason: String }

fn belt_pass_outcome_from_json(doc: JsonValue) -> BeltPassOutcomeDecode {
  match json_object_unique_member(v: doc, key: "outcome") {
    JsonMemberFound { value: JsonString { value: outcome } } =>
      match outcome {
        "recorded" => BeltPassOutcomeDecoded { outcome: BeltPassRecorded }
        "deferred" =>
          match json_object_unique_member(v: doc, key: "reason") {
            JsonMemberFound { value: JsonString { value: r } } =>
              BeltPassOutcomeDecoded { outcome: BeltPassDeferred { reason: r } }
            _ =>
              BeltPassOutcomeUnreadable { reason: "belt tick pass deferred without reason" }
          }
        "refused" =>
          match json_object_unique_member(v: doc, key: "reason") {
            JsonMemberFound { value: JsonString { value: r } } =>
              BeltPassOutcomeDecoded { outcome: BeltPassRefused { reason: r } }
            _ =>
              BeltPassOutcomeUnreadable { reason: "belt tick pass refused without reason" }
          }
        "failed" =>
          match json_object_unique_member(v: doc, key: "reason") {
            JsonMemberFound { value: JsonString { value: r } } =>
              BeltPassOutcomeDecoded { outcome: BeltPassFailed { reason: r } }
            _ =>
              BeltPassOutcomeUnreadable { reason: "belt tick pass failed without reason" }
          }
        _ => BeltPassOutcomeUnreadable { reason: "belt tick pass outcome is unknown" }
      }
    JsonMemberFound { value: _ } =>
      BeltPassOutcomeUnreadable { reason: "belt tick pass outcome is not a string" }
    JsonMemberAbsent =>
      BeltPassOutcomeUnreadable { reason: "belt tick pass outcome is missing" }
    JsonMemberDuplicated { count: _ } =>
      BeltPassOutcomeUnreadable { reason: "belt tick pass outcome is duplicated" }
    JsonMemberNotAnObject =>
      BeltPassOutcomeUnreadable { reason: "belt tick pass outcome is unreadable" }
  }
}

fn belt_tick_receipt_decode(raw: String) -> BeltTickReceiptRead {
  match parse_json_document(s: raw) {
    JsonDocumentUnreadable { gap: gap } =>
      BeltTickReceiptUnreadable { reason: concat("the belt tick receipt is ", json_document_gap_text(gap: gap)) }
    JsonDocumentParsed { value: doc } =>
      match json_object_unique_member(v: doc, key: "schema") {
        JsonMemberFound { value: JsonString { value: schema } } =>
          if schema != belt_tick_receipt_schema {
            BeltTickReceiptUnreadable { reason: "belt tick receipt schema is unknown" }
          } else {
            match json_object_unique_member(v: doc, key: "observed_at") {
              JsonMemberFound { value: JsonString { value: observed_at } } =>
                match belt_pass_outcome_from_member(doc: doc, key: "spawn_pass") {
                  BeltPassOutcomeUnreadable { reason: r } =>
                    BeltTickReceiptUnreadable { reason: r }
                  BeltPassOutcomeDecoded { outcome: spawn_pass } =>
                    match belt_pass_outcome_from_member(doc: doc, key: "teardown_pass") {
                      BeltPassOutcomeUnreadable { reason: r } =>
                        BeltTickReceiptUnreadable { reason: r }
                      BeltPassOutcomeDecoded { outcome: teardown_pass } =>
                        match belt_pass_outcome_from_member(doc: doc, key: "verify_pass") {
                          BeltPassOutcomeUnreadable { reason: r } =>
                            BeltTickReceiptUnreadable { reason: r }
                          BeltPassOutcomeDecoded { outcome: verify_pass } =>
                            match belt_pass_outcome_from_member(doc: doc, key: "publish_pass") {
                              BeltPassOutcomeUnreadable { reason: r } =>
                                BeltTickReceiptUnreadable { reason: r }
                              BeltPassOutcomeDecoded { outcome: publish_pass } =>
                                match belt_tick_launches_from_member(doc: doc) {
                                  BeltTickLaunchesUnreadable { reason: r } =>
                                    BeltTickReceiptUnreadable { reason: r }
                                  BeltTickLaunchesDecoded { launches } =>
                                    match belt_tick_execution_from_member(doc: doc) {
                                      BeltTickExecutionUnreadable { reason: r } =>
                                        BeltTickReceiptUnreadable { reason: r }
                                      BeltTickExecutionDecoded { execution } => {
                                        let receipt = BeltTickReceipt {
                                          observed_at: observed_at,
                                          execution: execution,
                                          launches: launches,
                                          spawn_pass: spawn_pass,
                                          teardown_pass: teardown_pass,
                                          verify_pass: verify_pass,
                                          publish_pass: publish_pass,
                                        }
                                        match json_object_unique_member(v: doc, key: "receipt_identity") {
                                          JsonMemberFound { value: JsonString { value: claimed } } =>
                                            if claimed != belt_tick_receipt_identity_hex(receipt: receipt) {
                                              BeltTickReceiptUnreadable { reason: "belt tick receipt identity does not match its members" }
                                            } else {
                                              BeltTickReceiptPresent { receipt: receipt }
                                            }
                                          _ =>
                                            BeltTickReceiptUnreadable { reason: "belt tick receipt receipt_identity is missing" }
                                        }
                                      }
                                    }
                                }
                            }
                        }
                    }
                }
              _ =>
                BeltTickReceiptUnreadable { reason: "belt tick receipt observed_at is missing" }
            }
          }
        _ =>
          BeltTickReceiptUnreadable { reason: "belt tick receipt schema is missing" }
      }
  }
}

type BeltTickLaunchesDecode
  = BeltTickLaunchesDecoded { launches: List<LaunchIdentity> }
  | BeltTickLaunchesUnreadable { reason: String }

fn belt_tick_launches_from_member(doc: JsonValue) -> BeltTickLaunchesDecode {
  match json_object_unique_member(v: doc, key: "launches") {
    JsonMemberFound { value: JsonArray { elements } } =>
      fold(elements, init: BeltTickLaunchesDecoded { launches: [] }, f: (acc, e) => match acc {
        BeltTickLaunchesUnreadable { reason } => BeltTickLaunchesUnreadable { reason: reason }
        BeltTickLaunchesDecoded { launches } =>
          match launch_identity_of_json(doc: e) {
            LaunchIdentityUnreadable { reason } => BeltTickLaunchesUnreadable { reason: join(["belt tick receipt launches: ", reason], "") }
            LaunchIdentityDecoded { identity } => BeltTickLaunchesDecoded { launches: concat(launches, [identity]) }
          }
      })
    JsonMemberFound { value: _ } => BeltTickLaunchesUnreadable { reason: "belt tick receipt launches is not an array" }
    JsonMemberAbsent => BeltTickLaunchesUnreadable { reason: "belt tick receipt launches is missing" }
    JsonMemberDuplicated { count: _ } => BeltTickLaunchesUnreadable { reason: "belt tick receipt launches is duplicated" }
    JsonMemberNotAnObject => BeltTickLaunchesUnreadable { reason: "belt tick receipt is not an object" }
  }
}

fn belt_pass_outcome_from_member(doc: JsonValue, key: String) -> BeltPassOutcomeDecode {
  match json_object_unique_member(v: doc, key: key) {
    JsonMemberFound { value: pass_doc } => belt_pass_outcome_from_json(doc: pass_doc)
    _ =>
      BeltPassOutcomeUnreadable {
        reason: join(["belt tick receipt ", key, " is missing"], ""),
      }
  }
}

fn belt_tick_receipt_read_from_filesystem(
  success: Bool,
  content: String,
  error: String,
) -> BeltTickReceiptRead {
  if success {
    if trim(content) == "" {
      BeltTickReceiptAbsent
    } else {
      belt_tick_receipt_decode(raw: content)
    }
  } else if string_contains(s: error, pattern: "No such file")
      || string_contains(s: error, pattern: "not found") {
    BeltTickReceiptAbsent
  } else {
    BeltTickReceiptUnreadable {
      reason: join(["belt tick receipt could not be read: ", error], ""),
    }
  }
}

fn belt_tick_receipt_read_for_instance(
  instance: HostDashboardInstance,
) -> BeltTickReceiptRead {
  let read = Filesystem.Read(
    path: belt_tick_receipt_path_for_instance(instance: instance),
  )
  belt_tick_receipt_read_from_filesystem(
    success: read.success,
    content: read.content,
    error: read.error,
  )
}

fn belt_tick_execution_json(e: BeltTickExecutionStanding) -> JsonValue {
  match e {
    TickExecuted { instance_id: i, deployed_revision: r, spawn_mode: m } =>
      json_object(members: [
        json_kv(key: "standing", value: json_string(s: "executed")),
        json_kv(key: "instance_id", value: json_string(s: i)),
        json_kv(key: "deployed_revision", value: json_string(s: r)),
        json_kv(key: "spawn_mode", value: json_string(s: spawn_mode_label(m: m))),
      ])
    TickExecutionWithheld { refusal: why } =>
      json_object(members: [
        json_kv(key: "standing", value: json_string(s: "withheld")),
        json_kv(key: "refusal", value: json_string(s: why)),
      ])
  }
}

fn belt_tick_execution_text(e: BeltTickExecutionStanding) -> String {
  match e {
    TickExecuted { instance_id: i, deployed_revision: r, spawn_mode: m } =>
      join(["executed|", i, "|", r, "|", spawn_mode_label(m: m)], "")
    TickExecutionWithheld { refusal: why } => join(["withheld|", why], "")
  }
}

fn belt_tick_receipt_identity_text(receipt: BeltTickReceipt) -> String {
  join([
    receipt.observed_at, "|",
    belt_tick_execution_text(e: receipt.execution), "|",
    join(receipt.launches |> map(l => serialize_json(v: launch_identity_json(id: l))), ","), "|",
    belt_pass_outcome_key(o: receipt.spawn_pass), "|",
    belt_pass_outcome_key(o: receipt.teardown_pass), "|",
    belt_pass_outcome_key(o: receipt.verify_pass), "|",
    belt_pass_outcome_key(o: receipt.publish_pass),
  ], "")
}

fn belt_tick_receipt_identity_hex(receipt: BeltTickReceipt) -> String {
  content_hash_tagged_structural(
    tag: "roadmap-belt-tick-receipt-v4" as NonEmptyStr,
    payload: content_hash_atom(value: belt_tick_receipt_identity_text(receipt: receipt) as NonEmptyStr),
  ).digest as String
}

type BeltTickExecutionDecode
  = BeltTickExecutionDecoded { execution: BeltTickExecutionStanding }
  | BeltTickExecutionUnreadable { reason: String }

fn belt_tick_execution_from_member(doc: JsonValue) -> BeltTickExecutionDecode {
  match json_object_unique_member(v: doc, key: "execution") {
    JsonMemberFound { value: inner } =>
      match json_object_unique_member(v: inner, key: "standing") {
        JsonMemberFound { value: JsonString { value: standing } } =>
          match standing {
            "executed" =>
              match json_object_unique_member(v: inner, key: "instance_id") {
                JsonMemberFound { value: JsonString { value: instance_id } } =>
                  match json_object_unique_member(v: inner, key: "deployed_revision") {
                    JsonMemberFound { value: JsonString { value: revision } } =>
                      match json_object_unique_member(v: inner, key: "spawn_mode") {
                        JsonMemberFound { value: JsonString { value: mode_label } } =>
                          match spawn_mode_of_label(label: mode_label) {
                            Absent => BeltTickExecutionUnreadable { reason: join(["belt tick receipt execution spawn_mode is unknown: ", mode_label], "") }
                            Present { value: mode } =>
                              BeltTickExecutionDecoded {
                                execution: TickExecuted { instance_id: instance_id, deployed_revision: revision, spawn_mode: mode },
                              }
                          }
                        _ => BeltTickExecutionUnreadable { reason: "belt tick receipt execution spawn_mode is missing" }
                      }
                    _ => BeltTickExecutionUnreadable { reason: "belt tick receipt execution deployed_revision is missing" }
                  }
                _ => BeltTickExecutionUnreadable { reason: "belt tick receipt execution instance_id is missing" }
              }
            "withheld" =>
              match json_object_unique_member(v: inner, key: "refusal") {
                JsonMemberFound { value: JsonString { value: why } } =>
                  BeltTickExecutionDecoded { execution: TickExecutionWithheld { refusal: why } }
                _ => BeltTickExecutionUnreadable { reason: "belt tick receipt execution withheld without refusal" }
              }
            _ => BeltTickExecutionUnreadable { reason: join(["belt tick receipt execution standing is unknown: ", standing], "") }
          }
        _ => BeltTickExecutionUnreadable { reason: "belt tick receipt execution standing is missing" }
      }
    JsonMemberAbsent => BeltTickExecutionUnreadable { reason: "belt tick receipt execution is missing" }
    JsonMemberDuplicated { count: _ } => BeltTickExecutionUnreadable { reason: "belt tick receipt execution is duplicated" }
    JsonMemberNotAnObject => BeltTickExecutionUnreadable { reason: "belt tick receipt is not an object" }
  }
}

fn belt_tick_receipt_json_value(receipt: BeltTickReceipt) -> JsonValue {
  json_object(members: [
    json_kv(key: "schema", value: json_string(s: belt_tick_receipt_schema)),
    json_kv(key: "observed_at", value: json_string(s: receipt.observed_at)),
    json_kv(key: "execution", value: belt_tick_execution_json(e: receipt.execution)),
    json_kv(key: "receipt_identity", value: json_string(s: belt_tick_receipt_identity_hex(receipt: receipt))),
    json_kv(key: "launches", value: json_array(elements: receipt.launches |> map(l => launch_identity_json(id: l)))),
    json_kv(key: "spawn_pass", value: belt_pass_outcome_json(o: receipt.spawn_pass)),
    json_kv(key: "teardown_pass", value: belt_pass_outcome_json(o: receipt.teardown_pass)),
    json_kv(key: "verify_pass", value: belt_pass_outcome_json(o: receipt.verify_pass)),
    json_kv(key: "publish_pass", value: belt_pass_outcome_json(o: receipt.publish_pass)),
  ])
}

fn belt_teardown_ok(o: BeltTeardownOutcome) -> Bool {
  match o {
    ReapedSession { session_name: _ } => true
    TeardownFailed { session_name: _, detail: _ } => false
  }
}

// THE LOCATED CAUSE TRAVELS INTO THE RECEIPT. SpawnFailed carries node_id, step, detail and
// provider — which node refused, at which gate, why — and this fold discarded all four for "one or
// more spawn outcomes failed". The receipt is the only durable record of a tick, so the cause was
// computed and erased every tick.
//
// That erasure made a one-command fix cost weeks: srv1's belt refused every spawn once the pinned
// Codex bundle went missing from /opt/gunbc/provider-runtime/codex, and the receipt said only that
// something failed. Every host probe an operator reaches for — `which codex`, the tmux server, the
// attempt directories — answers about a DIFFERENT object than the preflight tests (it probes the
// pinned bundled executable by absolute path, never PATH), so the visible evidence pointed away
// from the cause. DESIGN section 5 requires a failure arm typed, located and countable; at the
// receipt it was none.
//
// The reason string is now built from the failed outcomes, naming each node with gate and detail: a
// tick refusing for a missing provider binary says so in the file the dashboard reads, and the
// dispatch button's "belt fault" caption gets an explanation instead of a dead end.
fn belt_spawn_failure_reason(spawn_outcomes: List<BeltSpawnOutcome>) -> String {
  join([
    "one or more spawn outcomes failed: ",
    join(
      fold(spawn_outcomes, init: [], f: (acc, o) => match o {
        SpawnFailed { node_id: n, step: st, detail: d, provider: pv, launch: _ } =>
          concat(acc, [join([n, " [", pv, "] ", st, ": ", d], "")])
        Spawned { node_id: _, session_name: _, provider: _, launch: _ } => acc
        SpawnNotAdmitted { node_id: _, refusal: _ } => acc
      }),
      "; ",
    ),
  ], "")
}

fn belt_spawn_pass_outcome_from(
  host_refusal: LaunchRefusal?,
  spawn_outcomes: List<BeltSpawnOutcome>,
) -> BeltPassOutcome {
  match host_refusal {
    Present { value: r } => BeltPassRefused { reason: launch_refusal_reason(r: r) }
    Absent =>
    if belt_spawn_tally(outcomes: spawn_outcomes).failed > 0 {
      BeltPassFailed { reason: belt_spawn_failure_reason(spawn_outcomes: spawn_outcomes) }
    } else {
      BeltPassRecorded
    }
  }
}

fn belt_teardown_pass_outcome_from(
  host_refusal: LaunchRefusal?,
  teardown_outcomes: List<BeltTeardownOutcome>,
) -> BeltPassOutcome {
  match host_refusal {
    Present { value: r } => BeltPassRefused { reason: launch_refusal_reason(r: r) }
    Absent =>
    if count(teardown_outcomes |> filter(o => !belt_teardown_ok(o: o))) > 0 {
      BeltPassFailed { reason: "one or more teardown outcomes failed" }
    } else {
      BeltPassRecorded
    }
  }
}

fn belt_tick_observed_at() -> String {
  match clock_now_probed_at() {
    Present { value: probed_at } => probed_at as String
    Absent => "clock observation refused"
  }
}

fn belt_tick_receipt_write_for_instance(
  instance: HostDashboardInstance,
  receipt: BeltTickReceipt,
) -> BeltPassOutcome {
  let write = Filesystem.Write(
    path: belt_tick_receipt_path_for_instance(instance: instance),
    content: serialize_json(v: belt_tick_receipt_json_value(receipt: receipt)),
  )
  if write.success {
    BeltPassRecorded
  } else {
    BeltPassFailed {
      reason: join([
        "the belt tick receipt could not be written: ",
        write.error,
      ], ""),
    }
  }
}

// Verification runs on the SAME tick that spawns and reaps: it is the same kind of fact, a desired
// obligation reconciled against an observed one. Living here rather than behind its own trigger is
// what makes the mechanism what the operator did by hand — the belt already runs, so a completed
// turn gets its receipts run next tick without anyone noticing it finished. It runs AFTER the
// reconcile's actuations on its own evidence, so a session spawned this tick has no completed turn
// and is simply deferred. VERIFY NO LONGER SHORT-CIRCUITS ON SESSION OBSERVE REFUSAL: a tmux-list
// refusal blocks spawn/reap only; verify reads the attempt ledger and terminal provider/process
// evidence on its own authority (operator P1, 2026-08-02).
// The tick's node-independent launch refusal, when the host refused before any node reached its own
// gates: the same LaunchRefusal (gunbc.roadmap_launch_admission launch_host_refusal over the staged
// standing) every per-node SpawnNotAdmitted in spawn_outcomes carries, so the receipt's spawn_pass
// reason and the per-row refusals are one spelling. Absent when the host admitted observation
// through to the session set (a per-node refusal may still stand in spawn_outcomes). Replaces the
// tick-local `observe_refused: Bool + reason: String` pair review 5059520727 found beside the
// shared vocabulary.
// A deployment transition is the deploy's ATOMIC WHOLESALE refusal (gunbc.deploy_transition): under
// it nothing on the host actuates — spawn, teardown, verification, publication. The tick records it
// as TickPassesWithheld with the transition refusal, and the durable receipt derives every pass as
// Refused with that reason. Review 5059681676 found the previous shape — empty verify/publish lists
// folded to BeltPassRecorded — persisting a false `recorded` for passes the driver never ran. A
// host refusal that is NOT a transition (revision drift, an unobservable session set) withholds
// only the launch passes; verification and publication still run and record on their own evidence.
type BeltTickWholesale
  = TickPassesRun
  | TickPassesWithheld { refusal: LaunchRefusal }

type BeltTickResult {
  host_refusal: LaunchRefusal?,
  wholesale: BeltTickWholesale,
  reconcile: BeltReconcile,
  spawn_outcomes: List<BeltSpawnOutcome>,
  teardown_outcomes: List<BeltTeardownOutcome>,
  verify_outcomes: List<BeltVerifyOutcome>,
  publish_outcomes: List<BeltPublishOutcome>,
}

fn belt_tick_empty_reconcile(state: SpawnMode) -> BeltReconcile {
  BeltReconcile {
    mode: state,
    occupied: 0,
    upserts: [],
    teardowns: [],
    refusals: [],
  }
}

// The re-runnable belt driver: observe the live session set -> decide via belt_reconcile (the sole
// belt decision; its spawn-only precursor belt_step was deleted under RLM-1 — the launch admission
// is the only eligibility decision) -> actuate each planned spawn/teardown through the fail-closed
// exec seam. Idempotent by construction: a spawned session is observed next tick, keys to its ready
// node as Unchanged -> noop, so re-ticking never double-spawns (the observed set closes the loop
// the pure decision cannot). ObserveRefused blocks spawn/reap only — verify and publish run on
// their own evidence authorities (operator P1, 2026-08-02).
// THE TIMER IS A DISPATCH ACTUATOR TOO (review artifact 51237, both P0s). The dead-pane fix and the
// revision gate reached only the click path. This tick passed the whole observed session list into
// belt_reconcile, which maps EVERY present row to an observed member and counts live.length() as
// occupied — so a retained dead pane stayed a member (desired + present = Unchanged, no respawn)
// and consumed a capacity slot; and it never consulted the deployed revision, so a drifted host
// refused a click and spawned on a timer.
//
// BOTH PATHS NOW CONSUME ONE SEAM. launch_gate_revision (through the staged observer's
// launch_host_stage_revision) halts the tick before any spawn or reap. A refusal blocks spawn and
// teardown ONLY: verification and publication read independently bound receipts and already run
// when tmux observation refuses — stopping them would widen a spawn-admission refusal into a work
// stoppage.
//
// CLEANUP PRECEDES START, DEFERRED ONE TICK. A stale pane is excluded from observed membership, so
// its node becomes a spawn candidate — but spawning THIS tick would collide with the still-existing
// tmux session name, since spawn runs before teardown. So the spawn is withheld this tick and the
// teardown planned; next tick observes it Absent and spawns. Hence a partition plus a deferral, not
// a filter.
//
// LivenessUnobserved and MultiplicityConflict are neither cleaned nor spawned: counted refusals. An
// unobserved pane might be running, so teardown could kill live work and a spawn beside it could
// double-run the node.
//
// THIS PARAGRAPH DESCRIBED BEHAVIOUR THE CODE DID NOT HAVE (review artifact 51285), worse than the
// gap it described. The first cut partitioned `refused` and never read it, so only stale node ids
// were withheld — a ready node with an unobserved-but-present session read as ABSENT to
// belt_reconcile and could spawn beside a possibly-running pane. The deferral set is now every
// non-running class, so note and code agree.
//
// MULTIPLICITY IS A NODE FACT, NOT A SESSION FACT, which the first cut missed here:
// belt_tick_classify_sessions read each row's process state in isolation, so two rows for one node
// (running + stale) landed in two buckets and the reconciler acted on an ambiguity dispatch would
// have refused. The partition is now node-aware — more than one row is conflicted whatever the rows
// say — so both actuation paths refuse the same ambiguity.
type BeltTickSessionPartition {
  running: List<DispatchLiveSession>
  stale: List<DispatchLiveSession>
  refused: List<DispatchLiveSession>
  conflicted: List<DispatchLiveSession>
}

fn belt_tick_node_row_count(live: List<DispatchLiveSession>, node_id: String) -> Int {
  count(filter(live, s => s.node_id == node_id))
}

// THE PARTITION READS THE COPRODUCT, NOT A PARALLEL STRING VOCABULARY (review artifact 51309). The
// first cut asked belt_tick_session_is(s, arm: "running") — a second naming scheme for
// BeltSessionLiveness, which already names these states. Two vocabularies for one concept is the
// nicknaming class, and the string one is strictly worse: a typo in an arm name compiles and
// silently empties a bucket, where a missing coproduct arm is a compiler-caught non-exhaustive
// match.
//
// Node-awareness stays here rather than in belt_session_liveness_from_process, because multiplicity
// is a fact about a NODE's rows and that function sees one row's process.
// belt_node_session_liveness makes the same distinction on the dispatch path.
fn belt_tick_session_class(
  live: List<DispatchLiveSession>,
  s: DispatchLiveSession,
) -> BeltSessionLiveness {
  let n = belt_tick_node_row_count(live: live, node_id: s.node_id)
  if n > 1 {
    BeltSessionMultiplicityConflict {
      session_names: join(
        map(filter(live, r => r.node_id == s.node_id), r => r.session_name), ", "),
      session_count: n,
    }
  } else {
    belt_session_liveness_from_process(session_name: s.session_name, process: s.worker.process)
  }
}

fn belt_tick_is_running(live: List<DispatchLiveSession>, s: DispatchLiveSession) -> Bool {
  match belt_tick_session_class(live: live, s: s) {
    BeltSessionRunning { session_name: _, command: _ } => true
    _ => false
  }
}

fn belt_tick_is_stale(live: List<DispatchLiveSession>, s: DispatchLiveSession) -> Bool {
  match belt_tick_session_class(live: live, s: s) {
    BeltSessionStaleTerminal { session_name: _, detail: _ } => true
    _ => false
  }
}

fn belt_tick_is_refused(live: List<DispatchLiveSession>, s: DispatchLiveSession) -> Bool {
  match belt_tick_session_class(live: live, s: s) {
    BeltSessionLivenessUnobserved { session_name: _, reason: _ } => true
    _ => false
  }
}

fn belt_tick_is_conflicted(live: List<DispatchLiveSession>, s: DispatchLiveSession) -> Bool {
  match belt_tick_session_class(live: live, s: s) {
    BeltSessionMultiplicityConflict { session_names: _, session_count: _ } => true
    _ => false
  }
}

fn belt_tick_classify_sessions(live: List<DispatchLiveSession>) -> BeltTickSessionPartition {
  BeltTickSessionPartition {
    running: filter(live, s => belt_tick_is_running(live: live, s: s)),
    stale: filter(live, s => belt_tick_is_stale(live: live, s: s)),
    refused: filter(live, s => belt_tick_is_refused(live: live, s: s)),
    conflicted: filter(live, s => belt_tick_is_conflicted(live: live, s: s)),
  }
}

data belt_publish_transition_inhibited_reason: String = "publication deferred: a deployment transition is in force or unresolved on this host, so the attempt evidence this publication would read is being rewritten or was left half-rewritten --"

// A TRANSITION REFUSAL WITHHOLDS PUBLICATION AND VERIFICATION AS WELL AS SPAWN AND REAP — the one
// place it departs from the revision refusal below, whose ruling blocks spawn and teardown ONLY
// because verification and publication read independently bound receipts and stopping them would
// widen a spawn-admission refusal into a work stoppage. That argument fails here: a transition
// means the tree those receipts are read FROM is being rewritten underneath, or was left
// half-rewritten by something that died, so all four passes consume an incoherent release.
// Publishing a pull request off a receipt read from a half-converged tree is not a smaller mistake
// than spawning into it — it is the one that leaves the house.
// THE REAL TIMER DRIVER IS observer -> launch pass -> actuation.
// belt_launch_host_standing_for_instance is the ONE staged observer (shared with the page and POST
// /dispatch); belt_tick_launch_pass is the timer's whole launch decision over that standing and is
// pure — no effect, so a witness runs the real driver's decision on a fabricated staged standing;
// the only thing it cannot exercise is the observer's filesystem/tmux reads, whose ORDER is
// structural (LaunchHostHalted has no later fields). When the host halts, every desired node
// (frontier.ready, in frontier order) is still folded through the admission and receives the halt
// refusal as SpawnNotAdmitted: the receipt names what the timer would have started and the one
// reason it did not. Reaping needs an observed session set, so happens only when the standing
// reached it. Verification and publication are not launches and run on every arm EXCEPT a
// deployment transition halt — the deploy's atomic wholesale refusal (gunbc.deploy_transition),
// under which nothing on the host actuates, verify and publish included.
type BeltLaunchPass {
  reconcile: BeltReconcile,
  host_refusal: LaunchRefusal?,
  decisions: List<BeltLaunchDecision>,
  teardowns: List<DispatchMember>,
}

fn belt_tick_desired_candidates(frontier: SpawnFrontier) -> List<DispatchMember> {
  frontier.ready |> map(n => DesiredMember { node_id: n.node as String, node: n })
}

fn belt_tick_launch_pass_refused(
  standing: LaunchHostStanding,
  state: SpawnMode,
  frontier: SpawnFrontier,
  graph: LaunchGraphStanding,
  merged: List<Int>,
  host_refusal: LaunchRefusal,
) -> BeltLaunchPass {
  BeltLaunchPass {
    reconcile: belt_tick_empty_reconcile(state: state),
    host_refusal: Present { value: host_refusal },
    decisions: belt_tick_admit(
      candidates: belt_tick_desired_candidates(frontier: frontier),
      standing: standing,
      graph: graph,
      merged: merged,
    ),
    teardowns: [],
  }
}

fn belt_tick_launch_pass_observed(
  standing: LaunchHostStanding,
  state: SpawnMode,
  frontier: SpawnFrontier,
  graph: LaunchGraphStanding,
  merged: List<Int>,
  live: List<DispatchLiveSession>,
) -> BeltLaunchPass {
  let classified = belt_tick_classify_sessions(live: live)
  let r = belt_reconcile(
    state: state,
    frontier: frontier,
    live: classified.running,
    cap: roadmap_belt_default_capacity,
  )
  BeltLaunchPass {
    reconcile: r,
    host_refusal: none,
    decisions: belt_tick_admit(candidates: r.upserts, standing: standing, graph: graph, merged: merged),
    teardowns: concat(r.teardowns, map(classified.stale, s => ObservedMember { node_id: s.node_id, session: s })),
  }
}

fn belt_tick_launch_pass(
  standing: LaunchHostStanding,
  state: SpawnMode,
  frontier: SpawnFrontier,
  graph: LaunchGraphStanding,
  merged: List<Int>,
) -> BeltLaunchPass {
  match launch_host_refusal(standing: standing) {
    Present { value: r } =>
      belt_tick_launch_pass_refused(standing: standing, state: state, frontier: frontier, graph: graph, merged: merged, host_refusal: r)
    Absent =>
      match standing {
        LaunchHostObserved { instance_id: _, actuation: _, transition: _, revision: _, sessions, capacity: _, mode: _ } =>
          match sessions {
            LaunchSessionsObserved { live } =>
              belt_tick_launch_pass_observed(standing: standing, state: state, frontier: frontier, graph: graph, merged: merged, live: live)
            LaunchSessionsUnobserved { reason } =>
              belt_tick_launch_pass_refused(standing: standing, state: state, frontier: frontier, graph: graph, merged: merged, host_refusal: LaunchSessionsUnobservable { reason: reason })
            LaunchSessionsPending =>
              belt_tick_launch_pass_refused(standing: standing, state: state, frontier: frontier, graph: graph, merged: merged, host_refusal: LaunchGateNotEvaluated { gate: "sessions" })
          }
        LaunchHostObserveOnly { instance_id } =>
          belt_tick_launch_pass_refused(standing: standing, state: state, frontier: frontier, graph: graph, merged: merged, host_refusal: LaunchInstanceActuationRefused { instance_id: instance_id, reason: "observe-only instance reached the launch pass without a host refusal; fail-closed" })
        LaunchHostHalted { instance_id: _, gate: _, refusal } =>
          belt_tick_launch_pass_refused(standing: standing, state: state, frontier: frontier, graph: graph, merged: merged, host_refusal: refusal)
        LaunchHostUnobserved { reason } =>
          belt_tick_launch_pass_refused(standing: standing, state: state, frontier: frontier, graph: graph, merged: merged, host_refusal: LaunchNoActuatingInstance { reason: reason })
      }
  }
}

fn belt_tick_wholesale_of(standing: LaunchHostStanding) -> BeltTickWholesale {
  match standing {
    LaunchHostHalted { instance_id: _, gate, refusal } =>
      match gate {
        HostTransitionGate => TickPassesWithheld { refusal: refusal }
        HostRevisionGate => TickPassesRun
      }
    LaunchHostObserved { instance_id: _, actuation: _, transition: _, revision: _, sessions: _, capacity: _, mode: _ } => TickPassesRun
    LaunchHostObserveOnly { instance_id: _ } => TickPassesRun
    LaunchHostUnobserved { reason: _ } => TickPassesRun
  }
}

fn belt_tick_for_instance(
  instance: HostDashboardInstance,
  state: SpawnMode,
  frontier: SpawnFrontier,
  cap: BeltCapacity,
  spawn_workdir: String,
) -> BeltTickResult {
  let standing = belt_launch_host_standing_complete(
    instance: instance,
    standing: belt_launch_host_standing_for_instance_with_capacity(instance: instance, mode: state, capacity: cap),
  )
  let pass = belt_tick_launch_pass(
    standing: standing,
    state: state,
    frontier: frontier,
    graph: launch_graph_of_projection(proj: roadmap_authority_projection()),
    merged: authored_merged_prs(),
  )
  let spawn_outcomes = belt_tick_spawn_decided(decisions: pass.decisions, workdir: spawn_workdir)
  let teardown_outcomes = pass.teardowns |> map(m => belt_actuate_teardown_member(m: m))
  match belt_tick_wholesale_of(standing: standing) {
    TickPassesWithheld { refusal } =>
      BeltTickResult {
        host_refusal: pass.host_refusal,
        wholesale: TickPassesWithheld { refusal: refusal },
        reconcile: pass.reconcile,
        spawn_outcomes: spawn_outcomes,
        teardown_outcomes: teardown_outcomes,
        verify_outcomes: [],
        publish_outcomes: [],
      }
    TickPassesRun =>
      BeltTickResult {
        host_refusal: pass.host_refusal,
        wholesale: TickPassesRun,
        reconcile: pass.reconcile,
        spawn_outcomes: spawn_outcomes,
        teardown_outcomes: teardown_outcomes,
        verify_outcomes: belt_verify_attempts_for_instance(instance: instance),
        publish_outcomes: belt_publish_attempts_for_instance(instance: instance),
      }
  }
}

// THE TIMER CONSUMES THE SAME ADMISSION AS THE CLICK (RLM-1). Every upsert the reconcile plans is
// folded through gunbc.roadmap_launch_admission with cause Timer, in order, `reserved` = the
// launches this tick already admitted, so capacity is decided once and a tick cannot overshoot. A
// refusal is carried whole as SpawnNotAdmitted; only an admitted candidate reaches
// belt_actuate_spawn_member. The stale / liveness-unobserved / multiplicity partition the tick
// filtered by hand is now the admission's no-live-attempt gate over the FULL observed session list
// — the gate the route reads — so the tick has no private `deferred`. The transition gate
// (belt_transition_admission_for_instance refuses the whole tick before observation) and the
// revision gate are already closed above, so the standing handed to the admission carries them as
// admitted facts of THIS tick, not a second read.
// The timer's per-candidate verdict from the ONE admission, before any actuation: a decided launch
// carries the admitted LaunchIdentity, a withheld one the refusal. belt_tick_admit is the pure fold
// every candidate passes in deterministic (plan) order, `reserved` counting launches already
// decided so capacity is admitted as a prefix and the remainder receives LaunchNoCapacity;
// belt_tick_spawn_decided actuates exactly the decided ones. Splitting fold from actuation lets the
// multi-candidate control assert the fold on three Ready rows against one slot without entering the
// actuator.
type BeltLaunchDecision
  = BeltLaunchDecided { member: DispatchMember, launch: LaunchIdentity }
  | BeltLaunchWithheld { node_id: String, refusal: LaunchRefusal }

type BeltTickAdmitFold {
  reserved: Int
  decisions: List<BeltLaunchDecision>
}

fn belt_tick_admit(
  candidates: List<DispatchMember>,
  standing: LaunchHostStanding,
  graph: LaunchGraphStanding,
  merged: List<Int>,
) -> List<BeltLaunchDecision> {
  let folded = fold(candidates, init: BeltTickAdmitFold { reserved: 0, decisions: [] }, f: fn(acc, m) {
    let node_id = dispatch_member_key(m: m)
    match launch_admission(
      cause: Timer,
      standing: standing,
      graph: graph,
      merged: merged,
      node_id: node_id,
      reserved: acc.reserved,
    ) {
      LaunchRefused { refusal } =>
        BeltTickAdmitFold {
          reserved: acc.reserved,
          decisions: concat(acc.decisions, [ BeltLaunchWithheld { node_id: node_id, refusal: refusal } ]),
        }
      LaunchAdmitted { identity } =>
        BeltTickAdmitFold {
          reserved: acc.reserved + 1,
          decisions: concat(acc.decisions, [ BeltLaunchDecided { member: m, launch: identity } ]),
        }
    }
  })
  folded.decisions
}

fn belt_tick_spawn_decided(decisions: List<BeltLaunchDecision>, workdir: String) -> List<BeltSpawnOutcome> {
  decisions |> map(d => match d {
    BeltLaunchWithheld { node_id, refusal } => SpawnNotAdmitted { node_id: node_id, refusal: refusal }
    BeltLaunchDecided { member, launch } => belt_actuate_spawn_member(m: member, workdir: workdir, launch: launch)
  })
}

fn belt_tick_admit_and_spawn(
  candidates: List<DispatchMember>,
  standing: LaunchHostStanding,
  graph: LaunchGraphStanding,
  merged: List<Int>,
  workdir: String,
) -> List<BeltSpawnOutcome> {
  belt_tick_spawn_decided(
    decisions: belt_tick_admit(candidates: candidates, standing: standing, graph: graph, merged: merged),
    workdir: workdir,
  )
}

fn belt_tick_deferred_count(outcomes: List<BeltSpawnOutcome>) -> Int { belt_spawn_tally(outcomes: outcomes).deferred }

fn belt_tick_launch_identities(outcomes: List<BeltSpawnOutcome>) -> List<LaunchIdentity> {
  fold(outcomes, init: [], f: (acc, o) => match o {
    Spawned { node_id: _, session_name: _, provider: _, launch } => concat(acc, [launch])
    SpawnFailed { node_id: _, step: _, detail: _, provider: _, launch } => concat(acc, [launch])
    SpawnNotAdmitted { node_id: _, refusal: _ } => acc
  })
}

fn belt_tick(
  state: SpawnMode,
  frontier: SpawnFrontier,
  cap: BeltCapacity,
  spawn_workdir: String,
) -> BeltTickResult {
  belt_tick_for_instance(
    instance: srv1_live_dashboard_instance(),
    state: state,
    frontier: frontier,
    cap: cap,
    spawn_workdir: spawn_workdir,
  )
}

fn belt_tick_default_workdir(
  state: SpawnMode,
  frontier: SpawnFrontier,
  cap: BeltCapacity,
) -> BeltTickResult {
  belt_tick(state: state, frontier: frontier, cap: cap, spawn_workdir: belt_actuate_workdir as String)
}

// ONE fold over the tick's spawn outcomes to a typed tally; every count the tick JSON, receipt and
// deferred figure report is a field of it. Replaces four variant-to-Bool predicates (belt_spawn_ok
// / _failed / _not_admitted and the NoCapacity filter) that each re-eliminated the outcome
// coproduct for one arm — the predicate-dissolution shape review 57498 refused.
type BeltSpawnTally {
  spawned: Int
  failed: Int
  not_admitted: Int
  deferred: Int
}

fn belt_spawn_tally(outcomes: List<BeltSpawnOutcome>) -> BeltSpawnTally {
  fold(outcomes, init: BeltSpawnTally { spawned: 0, failed: 0, not_admitted: 0, deferred: 0 }, f: (acc, o) => match o {
    Spawned { node_id: _, session_name: _, provider: _, launch: _ } =>
      BeltSpawnTally { spawned: acc.spawned + 1, failed: acc.failed, not_admitted: acc.not_admitted, deferred: acc.deferred }
    SpawnFailed { node_id: _, step: _, detail: _, provider: _, launch: _ } =>
      BeltSpawnTally { spawned: acc.spawned, failed: acc.failed + 1, not_admitted: acc.not_admitted, deferred: acc.deferred }
    SpawnNotAdmitted { node_id: _, refusal } =>
      match refusal {
        LaunchNoCapacity { occupied: _, max_concurrent: _ } =>
          BeltSpawnTally { spawned: acc.spawned, failed: acc.failed, not_admitted: acc.not_admitted + 1, deferred: acc.deferred + 1 }
        _ =>
          BeltSpawnTally { spawned: acc.spawned, failed: acc.failed, not_admitted: acc.not_admitted + 1, deferred: acc.deferred }
      }
  })
}

fn belt_tick_spawn_ok_count(t: BeltTickResult) -> Int { belt_spawn_tally(outcomes: t.spawn_outcomes).spawned }
fn belt_tick_spawn_failed_count(t: BeltTickResult) -> Int { belt_spawn_tally(outcomes: t.spawn_outcomes).failed }
fn belt_tick_spawn_not_admitted_count(t: BeltTickResult) -> Int { belt_spawn_tally(outcomes: t.spawn_outcomes).not_admitted }
fn belt_tick_teardown_ok_count(t: BeltTickResult) -> Int {
  count(t.teardown_outcomes |> filter(o => belt_teardown_ok(o: o)))
}

// One belt tick against the LIVE roadmap reads the roadmap authority + merged PRs, builds the ready
// frontier, and reconciles it in the production spawn mode (ManualReady) at the default capacity.
// belt_run_once_cli is the executable entrypoint (`gunbc run --function belt_run_once_cli`, wet):
// it requires the deployment's GUNBC_BELT_SPAWN_WORKDIR, resolves that root to its dashboard
// instance, ticks against it, and persists the BeltTickReceipt. belt_run_once and
// belt_run_once_json are non-executable projections (typed BeltTickResult for the production
// instance; its serialization) — `gunbc run` rejects both return types. The tick observes live
// sessions before actuating planned spawns and teardowns through the provider
// dispatch_actuator_selection resolves (a refused selection is a typed SpawnFailed at step
// dispatch-selection, never a defaulted provider), then verifies and publishes attempts on their
// independent evidence authorities. Idempotent: a spawned session is observed live next tick and
// reconciles to noop.
fn belt_run_once_in(
  instance: HostDashboardInstance,
  spawn_workdir: String,
) -> BeltTickResult {
  match roadmap_authority_projection() {
    RoadmapAuthorityProjectionRefused { detail: detail } =>
      BeltTickResult {
        host_refusal: Present { value: LaunchAuthorityUnobserved { detail: detail } },
        wholesale: TickPassesRun,
        reconcile: belt_tick_empty_reconcile(state: roadmap_belt_production_spawn_mode),
        spawn_outcomes: [],
        teardown_outcomes: [],
        verify_outcomes: belt_verify_attempts_for_instance(instance: instance),
        publish_outcomes: belt_publish_attempts_for_instance(instance: instance),
      }
    RoadmapAuthorityProjected { doc: doc, accepted: _ } =>
      belt_tick_for_instance(
        instance: instance,
        state: roadmap_belt_production_spawn_mode,
        frontier: spawn_frontier(doc: doc, merged: authored_merged_prs()),
        cap: roadmap_belt_default_capacity,
        spawn_workdir: spawn_workdir,
      )
  }
}

fn belt_run_once() -> BeltTickResult {
  belt_run_once_in(
    instance: srv1_live_dashboard_instance(),
    spawn_workdir: belt_actuate_workdir as String,
  )
}

fn belt_spawn_outcome_json(o: BeltSpawnOutcome) -> JsonValue {
  match o {
    Spawned { node_id: nid, session_name: sn, provider: p, launch: l } =>
      json_object(members: [
        json_kv(key: "node_id", value: json_string(s: nid)),
        json_kv(key: "status", value: json_string(s: "spawned")),
        json_kv(key: "provider", value: json_string(s: p)),
        json_kv(key: "session_name", value: json_string(s: sn)),
        json_kv(key: "launch", value: launch_identity_json(id: l)),
      ])
    SpawnFailed { node_id: nid, step: st, detail: d, provider: p, launch: l } =>
      json_object(members: [
        json_kv(key: "node_id", value: json_string(s: nid)),
        json_kv(key: "status", value: json_string(s: "spawn_failed")),
        json_kv(key: "provider", value: json_string(s: p)),
        json_kv(key: "step", value: json_string(s: st)),
        json_kv(key: "detail", value: json_string(s: d)),
        json_kv(key: "launch", value: launch_identity_json(id: l)),
      ])
    SpawnNotAdmitted { node_id: nid, refusal: r } =>
      json_object(members: [
        json_kv(key: "node_id", value: json_string(s: nid)),
        json_kv(key: "status", value: json_string(s: launch_refusal_label(r: r))),
        json_kv(key: "reason", value: json_string(s: launch_refusal_reason(r: r))),
      ])
  }
}

fn belt_teardown_outcome_json(o: BeltTeardownOutcome) -> JsonValue {
  match o {
    ReapedSession { session_name: sn } =>
      json_object(members: [
        json_kv(key: "session_name", value: json_string(s: sn)),
        json_kv(key: "status", value: json_string(s: "reaped")),
      ])
    TeardownFailed { session_name: sn, detail: d } =>
      json_object(members: [
        json_kv(key: "session_name", value: json_string(s: sn)),
        json_kv(key: "status", value: json_string(s: "teardown_failed")),
        json_kv(key: "detail", value: json_string(s: d)),
      ])
  }
}

fn belt_tick_result_json_value(t: BeltTickResult) -> JsonValue {
  json_object(members: [
    json_kv(key: "schema", value: json_string(s: "roadmap-belt-tick/v1")),
    json_kv(key: "observe_refused", value: json_bool(b: match t.host_refusal { Present { value: _ } => true Absent => false })),
    json_kv(key: "observe_refusal_reason", value: json_string(s: match t.host_refusal { Present { value: r } => launch_refusal_reason(r: r) Absent => "" })),
    json_kv(key: "launch_refusal", value: json_string(s: match t.host_refusal { Present { value: r } => launch_refusal_label(r: r) Absent => "" })),
    json_kv(key: "wholesale_refused", value: json_bool(b: match t.wholesale { TickPassesWithheld { refusal: _ } => true TickPassesRun => false })),
    json_kv(key: "spawn_mode", value: json_string(s: spawn_mode_label(m: t.reconcile.mode))),
    json_kv(key: "occupied", value: json_int(n: t.reconcile.occupied)),
    json_kv(key: "upserts", value: json_int(n: belt_reconcile_upsert_count(r: t.reconcile))),
    json_kv(key: "deferred", value: json_int(n: belt_tick_deferred_count(outcomes: t.spawn_outcomes))),
    json_kv(key: "refusal_count", value: json_int(n: belt_reconcile_refusal_count(r: t.reconcile))),
    json_kv(key: "spawned", value: json_int(n: belt_tick_spawn_ok_count(t: t))),
    json_kv(key: "spawn_failed", value: json_int(n: belt_tick_spawn_failed_count(t: t))),
    json_kv(key: "spawn_not_admitted", value: json_int(n: belt_tick_spawn_not_admitted_count(t: t))),
    json_kv(key: "reaped", value: json_int(n: belt_tick_teardown_ok_count(t: t))),
    json_kv(key: "spawn_outcomes", value: json_array(elements: t.spawn_outcomes |> map(o => belt_spawn_outcome_json(o: o)))),
    json_kv(key: "teardown_outcomes", value: json_array(elements: t.teardown_outcomes |> map(o => belt_teardown_outcome_json(o: o)))),
    json_kv(key: "verified", value: json_int(n: belt_tick_verify_recorded_count(t: t))),
    json_kv(key: "verify_outcomes", value: json_array(elements: t.verify_outcomes |> map(o => belt_verify_outcome_json(o: o)))),
  ])
}

fn belt_verify_outcome_json(o: BeltVerifyOutcome) -> JsonValue {
  match o {
    VerifyDeferred { node_id, reason } =>
      json_object(members: [
        json_kv(key: "node", value: json_string(s: node_id)),
        json_kv(key: "outcome", value: json_string(s: "deferred")),
        json_kv(key: "detail", value: json_string(s: reason)),
      ])
    VerifyRecorded { node_id, verdict_key, detail } =>
      json_object(members: [
        json_kv(key: "node", value: json_string(s: node_id)),
        json_kv(key: "outcome", value: json_string(s: "recorded")),
        json_kv(key: "verdict", value: json_string(s: verdict_key)),
        json_kv(key: "detail", value: json_string(s: detail)),
      ])
    VerifyWriteFailed { node_id, detail } =>
      json_object(members: [
        json_kv(key: "node", value: json_string(s: node_id)),
        json_kv(key: "outcome", value: json_string(s: "write-failed")),
        json_kv(key: "detail", value: json_string(s: detail)),
      ])
    VerifyEvidenceUnreadable { node_id, detail } =>
      json_object(members: [
        json_kv(key: "node", value: json_string(s: node_id)),
        json_kv(key: "outcome", value: json_string(s: "evidence-unreadable")),
        json_kv(key: "detail", value: json_string(s: detail)),
      ])
    VerifyRefused { node_id, cause } =>
      json_object(members: [
        json_kv(key: "node", value: json_string(s: node_id)),
        json_kv(key: "outcome", value: json_string(s: "refused")),
        json_kv(key: "detail", value: json_string(s: cause)),
      ])
  }
}

// The tick counts verdicts RECORDED, never verdicts passed: four refusals recorded is the job done
// as well as four passes — the obligation is the receipt, not a green — and counting passes would
// turn the receipt into a quality metric that invites wanting fewer refusals. Write failures are
// counted separately: they are the belt failing, not the validation.
fn belt_tick_verify_recorded_count(t: BeltTickResult) -> Int {
  count(t.verify_outcomes |> filter(o => match o {
    VerifyRecorded { node_id: _, verdict_key: _, detail: _ } => true
    VerifyDeferred { node_id: _, reason: _ } => false
    VerifyWriteFailed { node_id: _, detail: _ } => false
    VerifyEvidenceUnreadable { node_id: _, detail: _ } => false
    VerifyRefused { node_id: _, cause: _ } => false
  }))
}

fn belt_tick_verify_write_failed_count(t: BeltTickResult) -> Int {
  count(t.verify_outcomes |> filter(o => match o {
    VerifyWriteFailed { node_id: _, detail: _ } => true
    VerifyEvidenceUnreadable { node_id: _, detail: _ } => true
    VerifyRecorded { node_id: _, verdict_key: _, detail: _ } => false
    VerifyDeferred { node_id: _, reason: _ } => false
    VerifyRefused { node_id: _, cause: _ } => false
  }))
}

type BeltAttempts
  = AttemptsObserved { attempts: List<DispatchAttemptRef> }
  | AttemptsRefused { reason: String }

// U3: the attempts observation mirrors belt_observe's fail-closed grammar — git absent or a
// non-zero for-each-ref is an UNKNOWABLE attempts set (AttemptsRefused, typed, carries stderr),
// never widened to zero; exit 0 with empty output IS a genuine zero (for-each-ref's documented
// no-match behavior). Runs in belt_actuate_workdir — the repo-root authority the spawn's worktree
// add uses, because attempt branches live where spawns mint them.
fn belt_attempts_observe_for_instance(instance: HostDashboardInstance) -> BeltAttempts {
  let cmd = git_for_each_ref_dispatch_argv_for_instance(instance: instance)
  if belt_program_available(program: cmd.program) {
    let result = gunbc.WitnessBin.Run(
      workdir: instance.repo_root,
      bin_path: cmd.program as FilePath,
      args: cmd.args,
    )
    if result.success {
      AttemptsObserved { attempts: dispatch_attempt_refs(git_output: result.stdout) }
    } else {
      AttemptsRefused { reason: concat("git for-each-ref failed: ", result.stderr) }
    }
  } else {
    AttemptsRefused { reason: "git not found on PATH — the attempts set is unknowable" }
  }
}

fn belt_attempts_observe() -> BeltAttempts {
  belt_attempts_observe_for_instance(instance: srv1_live_dashboard_instance())
}

fn belt_attempts_json_value(a: BeltAttempts) -> JsonValue {
  match a {
    AttemptsRefused { reason: r } =>
      json_object(members: [
        json_kv(key: "schema", value: json_string(s: "roadmap-attempts/v1")),
        json_kv(key: "attempts_refused", value: json_bool(b: true)),
        json_kv(key: "reason", value: json_string(s: r)),
      ])
    AttemptsObserved { attempts } =>
      json_object(members: [
        json_kv(key: "schema", value: json_string(s: "roadmap-attempts/v1")),
        json_kv(key: "attempts_refused", value: json_bool(b: false)),
        json_kv(key: "attempts", value: json_array(elements: attempts |> map(a2 => {
          let evidence = dispatch_attempt_evidence(attempt: a2)
          json_object(members: [
            json_kv(key: "node_id", value: json_string(s: a2.node_id)),
            json_kv(key: "branch", value: json_string(s: a2.branch)),
            json_kv(key: "attempt_key", value: json_string(s: a2.attempt_key)),
            json_kv(key: "worktree_evidence", value: json_string(s: worktree_evidence_label(evidence: evidence.worktree))),
            json_kv(key: "provider_evidence", value: json_string(s: provider_evidence_label(evidence: evidence.provider_instance))),
            json_kv(key: "process_identity_evidence", value: json_string(s: process_identity_evidence_label(evidence: evidence.process_identity))),
            json_kv(key: "transcript_evidence", value: json_string(s: transcript_evidence_label(evidence: evidence.transcript))),
            json_kv(key: "terminal_outcome_evidence", value: json_string(s: terminal_outcome_evidence_label(evidence: evidence.terminal_outcome))),
          ])
        }))),
      ])
  }
}

fn belt_attempts_observed_json(a: BeltAttempts) -> String {
  serialize_json(v: belt_attempts_json_value(a: a))
}

fn belt_attempts_http_status(a: BeltAttempts) -> Int {
  match a {
    AttemptsRefused { reason: _ } => 503
    AttemptsObserved { attempts: _ } => 200
  }
}

type BeltAttemptPanes
  = BeltAttemptPanesObserved { panes: List<TmuxAttemptPaneEntry> }
  | BeltAttemptPanesRefused { reason: String }

type BeltWorkflowAttempts
  = WorkflowAttemptsObserved { attempts: List<WorkflowAttemptProgress> }
  | WorkflowAttemptsRefused { reason: String }

// The workflow route joins the latest published attempt state to process evidence at node grain.
// Git refs determine which nodes have attempts; the node-current pointer selects the latest modeled
// attempt without guessing chronology from content-hash keys; Filesystem.Read observes the
// immutable key/admission prefix plus the append-only Codex JSONL; one exact tmux list-panes read
// observes alive/dead/exit for all attempts. A git refusal refuses the route. A pane-command or
// parse refusal stays located inside each attempt, so terminal provider evidence remains usable
// while incomplete attempts become refused.
fn belt_attempt_panes_observe_for_instance(
  instance: HostDashboardInstance,
) -> BeltAttemptPanes {
  let cmd = tmux_attempt_panes_argv_for_instance(instance: instance)
  if belt_program_available(program: cmd.program) {
    let result = gunbc.WitnessBin.Run(
      workdir: belt_observe_workdir,
      bin_path: cmd.program as FilePath,
      args: cmd.args,
      expect: OutcomeIsData,
    )
    if result.success {
      match parse_tmux_attempt_panes_output(output: result.stdout) {
        AttemptPanesParsed { panes } =>
          BeltAttemptPanesObserved { panes: panes }
        AttemptPanesParseRefused { line_number, raw, reason } =>
          BeltAttemptPanesRefused {
            reason: join([
              "tmux attempt-pane parse refused at line ",
              to_string(line_number),
              ": ",
              reason,
              "; raw=",
              raw,
            ], ""),
          }
      }
    } else {
      match classify_tmux_session_list(
        exit_ok: result.success,
        stdout: result.stdout,
        stderr: result.stderr,
      ) {
        TmuxNoServer { evidence: _ } =>
          BeltAttemptPanesObserved { panes: [] }
        TmuxSessionsListed { entries: _ } =>
          BeltAttemptPanesRefused {
            reason: join([
              "tmux attempt-pane observation failed: ",
              result.stderr,
            ], ""),
          }
        TmuxListUnknowable { stderr: e } =>
          BeltAttemptPanesRefused {
            reason: join([
              "tmux attempt-pane observation failed: ",
              e,
            ], ""),
          }
        TmuxListStdoutRefused { line_number, raw, reason } =>
          BeltAttemptPanesRefused {
            reason: belt_ls_stdout_refusal_reason(
              line_number: line_number,
              raw: raw,
              reason: reason,
            ),
          }
      }
    }
  } else {
    BeltAttemptPanesRefused {
      reason: "tmux realization is not executable; process state is unknowable",
    }
  }
}

// The sessions route has two probes with independent authority. tmux ls decides only which session
// containers are present; if it refuses, the session set refuses. The richer pane probe decides
// process running/exited/unobserved and cleanup eligibility per observed session; its refusal does
// NOT erase known presence — every present session maps to process-unobserved and
// cleanup-unavailable with the located pane reason. The UI can say `session present · process
// unknown` instead of fabricating liveness or hiding the container.
fn belt_sessions_observe_for_instance(
  instance: HostDashboardInstance,
) -> BeltObserve {
  let ls = tmux_ls_argv_for_instance(instance: instance)
  if belt_program_available(program: ls.program) {
    let result = gunbc.WitnessBin.Run(
      workdir: belt_observe_workdir,
      bin_path: ls.program as FilePath,
      args: ls.args,
      expect: OutcomeIsData,
    )
    if result.success {
      match classify_tmux_session_list(
        exit_ok: result.success,
        stdout: result.stdout,
        stderr: result.stderr,
      ) {
        TmuxSessionsListed { entries } =>
          match belt_attempt_panes_observe_for_instance(instance: instance) {
            BeltAttemptPanesObserved { panes } =>
              Observed {
                live: dispatch_live_sessions_with_process(
                  entries: entries,
                  panes: panes,
                  pane_observation_refusal: "",
                ),
              }
            BeltAttemptPanesRefused { reason } =>
              Observed {
                live: dispatch_live_sessions_with_process(
                  entries: entries,
                  panes: [],
                  pane_observation_refusal: reason,
                ),
              }
          }
        TmuxListStdoutRefused { line_number, raw, reason } =>
          ObserveRefused {
            reason: belt_ls_stdout_refusal_reason(
              line_number: line_number,
              raw: raw,
              reason: reason,
            ),
          }
        TmuxNoServer { evidence: _ } =>
          Observed { live: [] }
        TmuxListUnknowable { stderr: e } =>
          ObserveRefused {
            reason: concat(
              "belt_sessions_observe: tmux ls failed; session containers are unknowable. stderr: ",
              e,
            ),
          }
      }
    } else {
      match classify_tmux_session_list(
        exit_ok: result.success,
        stdout: result.stdout,
        stderr: result.stderr,
      ) {
        TmuxNoServer { evidence: _ } =>
          Observed { live: [] }
        TmuxSessionsListed { entries: _ } =>
          ObserveRefused {
            reason: concat(
              "belt_sessions_observe: tmux ls failed; session containers are unknowable. stderr: ",
              result.stderr,
            ),
          }
        TmuxListUnknowable { stderr: e } =>
          ObserveRefused {
            reason: concat(
              "belt_sessions_observe: tmux ls failed; session containers are unknowable. stderr: ",
              e,
            ),
          }
        TmuxListStdoutRefused { line_number, raw, reason } =>
          ObserveRefused {
            reason: belt_ls_stdout_refusal_reason(
              line_number: line_number,
              raw: raw,
              reason: reason,
            ),
          }
      }
    }
  } else {
    ObserveRefused {
      reason: "belt_sessions_observe: tmux not found; session containers are unknowable",
    }
  }
}

fn belt_sessions_observe() -> BeltObserve {
  belt_sessions_observe_for_instance(
    instance: srv1_live_dashboard_instance(),
  )
}

// NO PANE MEANS ASK THE OTHER CONTAINER, NOT CONCLUDE ABSENCE. An attempt is held by exactly one
// container -- a tmux pane for the vendor CLIs, a transient unit for the gunbc harness -- so these
// are two observations over DISJOINT populations rather than a precise reading with a widened
// fallback behind it. Answering WorkerProcessAbsent from a missing pane reported every unit-backed
// attempt as a worker that never started, which is what the dashboard showed while three workers
// were running.
//
// The order is pane-then-unit only because the pane observation is already in hand; it is not a
// preference between them. A vendor attempt whose pane is genuinely gone asks the manager, gets
// not-found, and answers WorkerProcessAbsent exactly as before -- so this adds a population without
// changing the answer for the one that already worked.
fn attempt_process_for_node(
  panes: BeltAttemptPanes,
  node_id: String,
  attempt_key: String,
) -> WorkerProcessEvidence {
  match panes {
    BeltAttemptPanesRefused { reason } =>
      WorkerProcessUnobserved { reason: reason as NonEmptyStr }
    BeltAttemptPanesObserved { panes: observed } => {
      let session_name = dispatch_tmux_session_name(
        node_id: node_id as gunbc.roadmap_model.RoadmapNodeId,
      )
      let matched = observed |> filter(pane =>
        pane.session_name == session_name)
      match matched.first() {
        Absent => {
          let unit = dispatch_attempt_unit_name(node_id: node_id, attempt_key: attempt_key)
          worker_process_from_attempt_unit(
            observation: attempt_unit_observation(unit: unit),
            unit: unit,
          )
        }
        Present { value: pane } =>
          worker_process_from_attempt_pane(pane: pane)
      }
    }
  }
}

fn dispatch_attempt_ref_first_per_node(
  attempts: List<DispatchAttemptRef>,
) -> List<DispatchAttemptRef> {
  fold(attempts, init: [], f: fn(acc, attempt) {
    if any(acc, existing => existing.node_id == attempt.node_id) {
      acc
    } else {
      append(acc, [attempt])
    }
  })
}

fn belt_validation_summary_for_node(
  instance: HostDashboardInstance,
  node_id: String,
) -> String {
  match belt_lookup_node(node_id: node_id) {
    AuthorityProjectionRefused { detail: _ } => ""
    NodeMissing => ""
    NodeFound { node } =>
      execution_contract_validation_summary(
        contract: node.execution,
        environment: instance.execution_environment,
      )
  }
}

type ProviderEventProjectionObservation
  = ProviderEventProjectionObserved { events: String }
  | ProviderEventProjectionRefused { reason: String }

fn belt_provider_event_projection_observe_for_instance(
  instance: HostDashboardInstance,
  node_id: gunbc.roadmap_model.RoadmapNodeId,
) -> ProviderEventProjectionObservation {
  match belt_exec(
    cmd: dispatch_current_attempt_events_projection_argv_for_instance(
      instance: instance,
      node_id: node_id,
    ),
    workdir: instance.repo_root as String,
  ) {
    ExecOk { stdout } =>
      ProviderEventProjectionObserved { events: stdout }
    ExecFailed { program, exit_code, stderr } =>
      ProviderEventProjectionRefused {
        reason: join([
          "provider event projection failed through ",
          program,
          " (exit ",
          to_string(exit_code),
          "): ",
          stderr,
        ], ""),
      }
    ExecRefused { program, reason } =>
      ProviderEventProjectionRefused {
        reason: join([
          "provider event projection unavailable through ",
          program,
          ": ",
          reason,
        ], ""),
      }
  }
}

fn provider_event_projection_readable(
  observation: ProviderEventProjectionObservation,
) -> Bool {
  match observation {
    ProviderEventProjectionObserved { events: _ } => true
    ProviderEventProjectionRefused { reason: _ } => false
  }
}

fn provider_event_projection_events(
  observation: ProviderEventProjectionObservation,
) -> String {
  match observation {
    ProviderEventProjectionObserved { events } => events
    ProviderEventProjectionRefused { reason: _ } => ""
  }
}

fn provider_event_projection_error(
  observation: ProviderEventProjectionObservation,
) -> String {
  match observation {
    ProviderEventProjectionObserved { events: _ } => ""
    ProviderEventProjectionRefused { reason } => reason
  }
}

// THE RECEIPT IS ADDRESSED BY HEAD, SO THERE IS NO PATH TO READ UNTIL THE HEAD IS KNOWN — the point
// of the ordering: the other receipts on this row live at one path per attempt and can be read
// before anything is decided; a publication receipt is one per head, so the subject must exist
// before the address does.
//
// THE UNOBSERVED ARM ANSWERS ReceiptSourceAbsent AND THAT IS NOT A FABRICATED ABSENCE.
// publication_segment refuses on an unobserved subject before consulting the source, so this value
// never reaches a judgment; it exists because the evidence record carries a source for every stage
// and there is no address to consult here. If the projection stopped refusing first this would
// become a real answer — which is why the refusal there matches on the subject rather than being
// inferred here.
//
// EVERY OBSERVED ARM CONSUMES THE FILESYSTEM AUTHORITY. filesystem_entry_presence decides whether
// the publication directory is listed; filesystem_file_observation decides the head-addressed
// receipt. ReceiptSourceAbsent can be projected only from FilesystemEstablishedAbsence, whose sole
// mint consumes a successful directory listing; this module carries neither a prose copy of that
// law nor a second spelling of List's membership encoding. Listing refusal, listed-but-unreadable,
// and disagreeing observations all project to ReceiptSourceUnreadable.
fn belt_publication_receipt_source(
  instance: HostDashboardInstance,
  node_id: RoadmapNodeId,
  attempt_key: String,
  subject: PublicationSubjectObservation,
) -> PublicationReceiptSource {
  match subject {
    PublicationSubjectUnobserved { reason: _ } => ReceiptSourceAbsent
    PublicationSubjectObserved { subject: observed } => {
      let attempt_dir = dispatch_attempt_state_path_for_instance(
        instance: instance,
        node_id: node_id,
        attempt_key: attempt_key,
      )
      let attempt_listing = Filesystem.List(path: attempt_dir)
      match filesystem_entry_presence(
        listing: filesystem_listing_observation(
          directory: attempt_dir,
          success: attempt_listing.success,
          entries: attempt_listing.entries,
          error: attempt_listing.error,
        ),
        name: publication_receipt_directory_segment,
      ) {
        FilesystemEntryPresenceIndeterminate { cause: c } =>
          ReceiptSourceUnreadable { detail: c }
        FilesystemEntryAbsent(_) => ReceiptSourceAbsent
        FilesystemEntryListed { directory: _, name: _ } => {
          let publication_dir = dispatch_attempt_publication_dir_for_instance(
            instance: instance,
            node_id: node_id,
            attempt_key: attempt_key,
          )
          let receipt_basename = join([observed.expected_head as String, ".json"], "")
          let path = dispatch_attempt_publication_receipt_path_for_instance(
            instance: instance,
            node_id: node_id,
            attempt_key: attempt_key,
            head_sha: observed.expected_head as String,
          )
          let publication_listing = Filesystem.List(path: publication_dir)
          let read = Filesystem.Read(path: path)
          match filesystem_file_observation(
            listing: filesystem_listing_observation(
              directory: publication_dir,
              success: publication_listing.success,
              entries: publication_listing.entries,
              error: publication_listing.error,
            ),
            name: receipt_basename,
            path: path,
            read: filesystem_read_outcome(
              content: read.content,
              success: read.success,
              error: read.error,
            ),
          ) {
            FilesystemFileIndeterminate { cause: c } =>
              ReceiptSourceUnreadable { detail: c }
            FilesystemFileObservationsDisagree { path: _, cause: c } =>
              ReceiptSourceUnreadable { detail: c }
            FilesystemFileAbsent(_) => ReceiptSourceAbsent
            FilesystemFileRead { path: _, content: text } =>
              ReceiptSourcePresent { text: text }
          }
        }
      }
    }
  }
}

fn belt_publish_current_verification_selection(
  instance: HostDashboardInstance,
  node_id: RoadmapNodeId,
  attempt_key: String,
  subject: VerificationSubject,
) -> VerificationSelectionPublishOutcome {
  let path = dispatch_attempt_verification_current_selection_path_for_instance(
    instance: instance,
    node_id: node_id,
    attempt_key: attempt_key,
    head_sha: subject.head_sha as String,
  )
  let write = Filesystem.Write(
    path: path,
    content: current_verification_selection_json(
      selection: CurrentVerificationSelection {
        head_sha: subject.head_sha,
        change_window_identity: subject.change_window_identity,
      },
    ),
  )
  if write.success {
    VerificationSelectionPublished { path: path }
  } else {
    VerificationSelectionPublishRefused {
      path: path,
      cause: join([
        "the belt could not publish the current verification selection: ",
        write.error,
      ], ""),
    }
  }
}

fn belt_verification_selection_observe(
  instance: HostDashboardInstance,
  node_id: RoadmapNodeId,
  attempt_key: String,
  head_sha: String,
) -> CurrentVerificationSelectionObservation {
  current_verification_selection_observe(
    attempt_dir: dispatch_attempt_state_path_for_instance(
      instance: instance,
      node_id: node_id,
      attempt_key: attempt_key,
    ),
    verification_dir: dispatch_attempt_verification_dir_for_instance(
      instance: instance,
      node_id: node_id,
      attempt_key: attempt_key,
    ),
    head_sha: head_sha,
  )
}

fn belt_verification_subject_from_selection(
  node: RoadmapNode,
  attempt_key: String,
  branch: String,
  head: CommitSha,
  selection: CurrentVerificationSelectionObservation,
) -> VerificationSubjectObservation {
  match selection {
    SelectionUnaddressable { cause } =>
      VerificationSubjectUnobserved { reason: cause }
    SelectionAbsent =>
      VerificationSubjectUnobserved {
        reason: "the belt has not selected a verification window for this head yet",
      }
    SelectionUnreadable { cause } =>
      VerificationSubjectUnobserved { reason: cause }
    SelectionMalformed { cause } =>
      VerificationSubjectUnobserved { reason: cause }
    SelectionObserved { head: selected_head, window_identity } =>
      if (selected_head as String) != (head as String) {
        VerificationSubjectUnobserved {
          reason: join([
            "the current verification selection names head ",
            selected_head as String,
            " but the worktree head is ",
            head as String,
          ], ""),
        }
      } else {
        match node_criteria_digest(rn: node) {
          Absent =>
            VerificationSubjectUnobserved {
              reason: "this roadmap node has no criteria digest, so the verification subject cannot be constructed",
            }
          Present { value: criteria_digest } =>
            VerificationSubjectObserved {
              subject: VerificationSubject {
                node_identity: node.identity,
                criteria_digest: criteria_digest,
                attempt_key: attempt_key,
                branch: branch as NonEmptyStr,
                head_sha: head,
                change_window_identity: window_identity,
              },
            }
        }
      }
  }
}

fn belt_verification_receipt_source_for_selection(
  instance: HostDashboardInstance,
  node_id: RoadmapNodeId,
  attempt_key: String,
  head_sha: String,
  window_identity_hex: String,
) -> VerificationReceiptFileSource {
  let address = exact_verification_address_for(
    attempt_dir: dispatch_attempt_state_path_for_instance(
      instance: instance,
      node_id: node_id,
      attempt_key: attempt_key,
    ),
    verification_dir: dispatch_attempt_verification_dir_for_instance(
      instance: instance,
      node_id: node_id,
      attempt_key: attempt_key,
    ),
    head_sha: head_sha,
    window_identity_hex: window_identity_hex,
  )
  verification_receipt_file_source_from_exact(
    source: exact_verification_receipt_source_read(
      attempt_dir: address.attempt_dir,
      verification_dir: address.verification_dir,
      receipt_basename: address.receipt_basename,
    ),
  )
}

fn belt_verification_receipt_source(
  instance: HostDashboardInstance,
  node_id: RoadmapNodeId,
  attempt_key: String,
  selection: CurrentVerificationSelectionObservation,
) -> VerificationReceiptFileSource {
  match selection {
    SelectionUnaddressable { cause } =>
      VerificationReceiptUnreadable {
        detail: join([
          "the worktree head could not be observed, so the exact receipt path was not established: ",
          cause,
        ], ""),
      }
    SelectionAbsent => VerificationReceiptAbsent
    SelectionUnreadable { cause } =>
      VerificationReceiptUnreadable {
        detail: join([
          "the current verification selection could not be read, so the exact receipt path was not established: ",
          cause,
        ], ""),
      }
    SelectionMalformed { cause } =>
      VerificationReceiptUnreadable {
        detail: join([
          "the current verification selection is malformed, so the exact receipt path was not established: ",
          cause,
        ], ""),
      }
    SelectionObserved { head, window_identity } =>
      belt_verification_receipt_source_for_selection(
        instance: instance,
        node_id: node_id,
        attempt_key: attempt_key,
        head_sha: head as String,
        window_identity_hex: window_identity.digest as String,
      )
  }
}

fn belt_workflow_progress_for_attempt_ref(
  instance: HostDashboardInstance,
  panes: BeltAttemptPanes,
  attempt: DispatchAttemptRef,
) -> WorkflowAttemptProgress {
  let key_read = Filesystem.Read(
    path: dispatch_current_attempt_key_path_for_instance(
      instance: instance,
      node_id: attempt.node_id as gunbc.roadmap_model.RoadmapNodeId,
    ),
  )
  if !key_read.success || trim(key_read.content) == "" {
    workflow_attempt_progress(evidence: WorkflowAttemptEvidence {
      node_id: attempt.node_id,
      attempt_key: attempt.attempt_key,
      branch: attempt.branch,
      modeled_state_present: false,
      admission_receipt_readable: false,
      admission_receipt: "",
      spawn_failure_present: false,
      spawn_failure: "",
      provider_events_readable: false,
      provider_events: "",
      provider_events_error: key_read.error,
      process: attempt_process_for_node(
        panes: panes,
        node_id: attempt.node_id,
        attempt_key: attempt.attempt_key,
      ),
      validation_summary: belt_validation_summary_for_node(
        instance: instance,
        node_id: attempt.node_id,
      ),
      verification_subject: VerificationSubjectUnobserved {
        reason: "this attempt has no modeled state pointer, so neither its attempt key nor its head is established",
      },
      verification_selection: SelectionAbsent,
      verification_source: VerificationReceiptAbsent,
      publication_subject: PublicationSubjectUnobserved {
        reason: "this attempt has no modeled state pointer, so neither its attempt key nor its head is established",
      },
      publication_source: ReceiptSourceAbsent,
    })
  } else {
    let current_key = trim(key_read.content)
    let node_id = attempt.node_id as gunbc.roadmap_model.RoadmapNodeId
    let admission = Filesystem.Read(
      path: dispatch_current_attempt_admission_path_for_instance(
        instance: instance,
        node_id: node_id,
      ),
    )
    let events = belt_provider_event_projection_observe_for_instance(
      instance: instance,
      node_id: node_id,
    )
    let spawn_failure = Filesystem.Read(
      path: dispatch_current_attempt_spawn_failure_path_for_instance(
        instance: instance,
        node_id: node_id,
      ),
    )
    let branch = dispatch_branch_name(
      node_id: node_id,
      attempt_key: current_key,
    )
    let worktree = dispatch_worktree_path_for_instance(
      instance: instance,
      node_id: node_id,
      attempt_key: current_key,
    )
    let head = belt_worktree_head_observe(
      instance: instance,
      worktree: worktree,
    )
    let publication_subject = belt_publication_subject_for(
      node_id: attempt.node_id,
      attempt_key: current_key,
      branch: branch,
      head: head,
    )
    let verification_selection = match head {
      WorktreeHeadUnobserved { reason } =>
        SelectionUnaddressable { cause: reason }
      WorktreeHeadObserved { revision: revision } =>
        belt_verification_selection_observe(
          instance: instance,
          node_id: node_id,
          attempt_key: current_key,
          head_sha: revision as String,
        )
    }
    let verification_subject = match belt_lookup_node(node_id: attempt.node_id) {
      AuthorityProjectionRefused { detail: detail } =>
        VerificationSubjectUnobserved {
          reason: concat("roadmap authority projection refused: ", detail),
        }
      NodeMissing =>
        VerificationSubjectUnobserved {
          reason: "the roadmap authority declares no node with this id, so there is no verification subject",
        }
      NodeFound { node } =>
        match head {
          WorktreeHeadUnobserved { reason } =>
            VerificationSubjectUnobserved { reason: reason }
          WorktreeHeadObserved { revision: revision } =>
            if trim(branch) == "" {
              VerificationSubjectUnobserved {
                reason: "the attempt has no branch name, so there is no verification subject to construct",
              }
            } else {
              belt_verification_subject_from_selection(
                node: node,
                attempt_key: current_key,
                branch: branch,
                head: revision as CommitSha,
                selection: verification_selection,
              )
            }
        }
    }
    let publication_receipt = belt_publication_receipt_source(
      instance: instance,
      node_id: node_id,
      attempt_key: current_key,
      subject: publication_subject,
    )
    workflow_attempt_progress(evidence: WorkflowAttemptEvidence {
      node_id: attempt.node_id,
      attempt_key: current_key,
      branch: dispatch_branch_name(
        node_id: node_id,
        attempt_key: current_key,
      ),
      modeled_state_present: true,
      admission_receipt_readable: admission.success,
      admission_receipt: admission.content,
      spawn_failure_present: spawn_failure.success,
      spawn_failure: spawn_failure.content,
      provider_events_readable: provider_event_projection_readable(
        observation: events,
      ),
      provider_events: provider_event_projection_events(
        observation: events,
      ),
      provider_events_error: provider_event_projection_error(
        observation: events,
      ),
      process: attempt_process_for_node(
        panes: panes,
        node_id: attempt.node_id,
        attempt_key: current_key,
      ),
      validation_summary: belt_validation_summary_for_node(
        instance: instance,
        node_id: attempt.node_id,
      ),
      verification_subject: verification_subject,
      verification_selection: verification_selection,
      verification_source: belt_verification_receipt_source(
        instance: instance,
        node_id: node_id,
        attempt_key: current_key,
        selection: verification_selection,
      ),
      publication_subject: publication_subject,
      publication_source: publication_receipt,
    })
  }
}

// The workflow's own verification actuation, and why it lives on the belt rather than the
// /workflow.json handler: running a declared validation is an EFFECT as long as the validation,
// while the progress route is a synchronous read the browser polls every two seconds — producing
// the verdict on the read path would make the lamp's observation run cargo. So the belt produces
// the receipt and the projection reads it, the split the environment-admission receipt already
// uses, and why Verify can move without the observer changing shape. Idempotence comes from the
// receipt's presence, as spawn idempotence comes from the observed session: a recorded verdict is
// not recomputed, so re-ticking neither re-runs the validation nor overwrites a verdict with one
// taken against a tree the agent has since touched. Agent completion is read from the reconciled
// provider state, so a turn completed while its pane still runs, or with a nonzero exit, never
// reaches verification — the obligation order is preserved, not restated.
// Validations run in a detached checkout of the observed head, never the mutable implementation
// worktree. The checkout path is head-addressed and idempotent: a tree at the same revision is
// reused; one at a different revision refuses rather than validating the wrong commit.
type BeltVerifyOutcome
  = VerifyDeferred { node_id: String, reason: String }
  | VerifyRecorded {
      node_id: String,
      verdict_key: String,
      detail: String,
    }
  | VerifyWriteFailed { node_id: String, detail: String }
  | VerifyEvidenceUnreadable { node_id: String, detail: String }
  | VerifyRefused { node_id: String, cause: String }

// review 45271; the scope of this collapse is now deliberate. Reducing a read to `""` conflates
// absent with unreadable, safe only where BOTH branches take the same action. That holds for the
// PIN reads below — absent and unreadable identity both leave pin_recorded false, the gate refuses
// either way, nothing actuates — so the distinction changes the message, not the behaviour. It did
// NOT hold for the receipt-presence read, which gated whether to RUN the validation and OVERWRITE
// the evidence: absent means run, unreadable means stop, so the collapse let an I/O fault
// regenerate a verdict against a worktree that may have moved. That seam no longer uses this
// function; it reads with status preserved and decodes.
fn belt_read_or_empty(path: String) -> String {
  let read = Filesystem.Read(path: path)
  if read.success { trim(read.content) } else { "" }
}

type BeltValidationRun {
  executions: List<ValidationExecution>
  verdict: ValidationVerdict
}

// Roadmap verification produces a GitExactDiffWindow with a derived window_identity immediately
// before gunbc-claim validation. The belt observes target_generation via rev-parse and
// merge-base(head, target_generation) in the detached verification checkout, writes the receipt at
// verification/<head>.<window_identity>.diff-window.json, and binds GUNBC_DIFF_WINDOW_PATH only for
// validations that consume an affected-set window.
fn git_target_generation_observation_of(outcome: BeltExecOutcome) -> GitTargetGenerationObservation {
  match outcome {
    ExecOk { stdout } =>
      match git_object_id_from_untagged_hex(hex: trim(stdout)) {
        Absent =>
          GitTargetGenerationOutputMalformed { stdout: trim(stdout) }
        Present { value: generation } =>
          GitTargetGenerationObserved { generation: generation }
      }
    ExecFailed { program, exit_code, stderr } =>
      GitTargetGenerationExecutionFailed {
        program: program,
        exit_code: exit_code,
        stdout: "",
        stderr: stderr,
      }
    ExecRefused { program, reason } =>
      GitTargetGenerationProgramUnavailable { program: program, reason: reason }
  }
}

fn git_merge_base_observation_of(
  outcome: BeltExecOutcome,
  target: GitRef,
  target_generation: GitObjectId,
  head: GitObjectId,
) -> GitMergeBaseObservation {
  match outcome {
    ExecOk { stdout } =>
      match git_object_id_from_untagged_hex(hex: trim(stdout)) {
        Absent =>
          GitMergeBaseOutputMalformed { stdout: trim(stdout) }
        Present { value: base } =>
          GitMergeBaseObserved {
            target: target,
            target_generation: target_generation,
            base: base,
            head: head,
          }
      }
    ExecFailed { program, exit_code, stderr } =>
      GitMergeBaseExecutionFailed {
        program: program,
        exit_code: exit_code,
        stdout: "",
        stderr: stderr,
      }
    ExecRefused { program, reason } =>
      GitMergeBaseProgramUnavailable { program: program, reason: reason }
  }
}

fn belt_observe_target_generation(
  instance: HostDashboardInstance,
  worktree: String,
  target: GitRef,
) -> GitTargetGenerationObservation {
  git_target_generation_observation_of(
    outcome: belt_exec(
      cmd: host_exec_argv(
        program: dispatch_capability_program(
          environment: instance.execution_environment,
          cap: GitWorkspaceCapability,
        ),
        args: ["rev-parse", target as String],
      ),
      workdir: worktree,
    ),
  )
}

fn belt_observe_merge_base(
  instance: HostDashboardInstance,
  worktree: String,
  head_sha: String,
  target_generation_hex: String,
) -> BeltExecOutcome {
  belt_exec(
    cmd: host_exec_argv(
      program: dispatch_capability_program(
        environment: instance.execution_environment,
        cap: GitWorkspaceCapability,
      ),
      args: ["merge-base", head_sha, target_generation_hex],
    ),
    workdir: worktree,
  )
}

fn belt_prepare_diff_window_for_verification(
  instance: HostDashboardInstance,
  node_id: RoadmapNodeId,
  attempt_key: String,
  subject: VerificationSubject,
  worktree: String,
) -> GitDiffWindowPrepareOutcome {
  let head_sha = subject.head_sha as String
  let target = instance.dispatch_base_ref
  match git_object_id_from_untagged_hex(hex: head_sha) {
    Absent =>
      GitDiffWindowPrepareRefused {
        cause: ChangeWindowHeadObjectIdRefused { head_hex: head_sha },
      }
    Present { value: head } =>
      match belt_observe_target_generation(
        instance: instance,
        worktree: worktree,
        target: target,
      ) {
        GitTargetGenerationObserved { generation: target_generation } =>
          match git_merge_base_observation_of(
            outcome: belt_observe_merge_base(
              instance: instance,
              worktree: worktree,
              head_sha: head_sha,
              target_generation_hex: git_object_id_wire_hex(oid: target_generation) as String,
            ),
            target: target,
            target_generation: target_generation,
            head: head,
          ) {
            GitMergeBaseObserved {
              target: observed_target,
              target_generation: observed_generation,
              base: base,
              head: observed_head,
            } =>
              let window = git_exact_diff_window_for_verification(
                target: observed_target,
                target_generation: observed_generation,
                base: base,
                head: observed_head,
              )
              let identity_hex = git_diff_window_identity_hex(
                identity: window.window_identity,
              )
              let path = dispatch_attempt_diff_window_path_for_instance(
                instance: instance,
                node_id: node_id,
                attempt_key: attempt_key,
                head_sha: head_sha,
                window_identity_hex: identity_hex,
              )
              let write = Filesystem.Write(
                path: path,
                content: git_diff_window_json(window: window),
              )
              if write.success {
                GitDiffWindowPrepared { path: path, window: window }
              } else {
                GitDiffWindowPrepareRefused {
                  cause: ChangeWindowPersistenceRefused {
                    path: path,
                    cause: write.error,
                  },
                }
              }
            GitMergeBaseProgramUnavailable { program: program, reason: reason } =>
              GitDiffWindowPrepareRefused {
                cause: ChangeWindowMergeBaseRefused {
                  observation: GitMergeBaseProgramUnavailable { program: program, reason: reason },
                },
              }
            GitMergeBaseExecutionFailed { program: program, exit_code: exit_code, stdout: stdout, stderr: stderr } =>
              GitDiffWindowPrepareRefused {
                cause: ChangeWindowMergeBaseRefused {
                  observation: GitMergeBaseExecutionFailed {
                    program: program,
                    exit_code: exit_code,
                    stdout: stdout,
                    stderr: stderr,
                  },
                },
              }
            GitMergeBaseOutputMalformed { stdout: stdout } =>
              GitDiffWindowPrepareRefused {
                cause: ChangeWindowMergeBaseRefused {
                  observation: GitMergeBaseOutputMalformed { stdout: stdout },
                },
              }
          }
        GitTargetGenerationProgramUnavailable { program: program, reason: reason } =>
          GitDiffWindowPrepareRefused {
            cause: ChangeWindowTargetGenerationRefused {
              observation: GitTargetGenerationProgramUnavailable { program: program, reason: reason },
            },
          }
        GitTargetGenerationExecutionFailed { program: program, exit_code: exit_code, stdout: stdout, stderr: stderr } =>
          GitDiffWindowPrepareRefused {
            cause: ChangeWindowTargetGenerationRefused {
              observation: GitTargetGenerationExecutionFailed {
                program: program,
                exit_code: exit_code,
                stdout: stdout,
                stderr: stderr,
              },
            },
          }
        GitTargetGenerationOutputMalformed { stdout: stdout } =>
          GitDiffWindowPrepareRefused {
            cause: ChangeWindowTargetGenerationRefused {
              observation: GitTargetGenerationOutputMalformed { stdout: stdout },
            },
          }
      }
  }
}

fn belt_verification_subject_with_window(
  subject: VerificationSubject,
  window_identity: Fnv1a64Structural,
) -> VerificationSubject {
  VerificationSubject {
    node_identity: subject.node_identity,
    criteria_digest: subject.criteria_digest,
    attempt_key: subject.attempt_key,
    branch: subject.branch,
    head_sha: subject.head_sha,
    change_window_identity: window_identity,
  }
}

fn belt_exec_with_diff_window_env(
  instance: HostDashboardInstance,
  cmd: HostExecArgv,
  workdir: String,
  diff_window_path: String,
) -> BeltExecOutcome {
  belt_exec(
    cmd: host_exec_argv(
      program: dispatch_capability_program(
        environment: instance.execution_environment,
        cap: EnvironmentBindingCapability,
      ),
      args: concat(
        [git_diff_window_env_assignment(path: diff_window_path)],
        concat([cmd.program], cmd.args),
      ),
    ),
    workdir: workdir,
  )
}

fn belt_run_validation_operations(
  instance: HostDashboardInstance,
  validations: List<ValidationOperation>,
  worktree: String,
  oracle_identity: ContentHash,
  diff_window_path: String?,
) -> BeltValidationRun {
  fold(
    validations,
    init: BeltValidationRun {
      executions: [],
      verdict: ValidationPassed {
        command: "",
        oracle_identity: oracle_identity,
      },
    },
    f: fn(acc, validation) {
      match acc.verdict {
        ValidationNotRun => acc
        ValidationFailed { command: _, exit_code: _, detail: _ } => acc
        ValidationRefused { cause: _ } => acc
        ValidationPassed { command: prior, oracle_identity: _ } =>
          match validation_operation_command(
            validation: validation,
            environment: instance.execution_environment,
          ) {
            Absent =>
              BeltValidationRun {
                executions: acc.executions,
                verdict: ValidationRefused { cause: ValidationCommandUnrealized },
              }
            Present { value: command } => {
              let wire = modeled_validation_command_wire(command: command)
              let exec_outcome = if validation_consumes_affected_set_window(
                validation: validation,
              ) {
                match diff_window_path {
                  Present { value: path } =>
                    if path == "" {
                      ExecRefused {
                        program: "gunbc-diff-window",
                        reason: "verification requires an affected-set diff window path but the prepared path is empty",
                      }
                    } else {
                      belt_exec_with_diff_window_env(
                        instance: instance,
                        cmd: host_exec_argv(
                          program: command.program as String,
                          args: command.args,
                        ),
                        workdir: worktree,
                        diff_window_path: path,
                      )
                    }
                  Absent =>
                    ExecRefused {
                      program: "gunbc-diff-window",
                      reason: "verification requires an affected-set diff window path but none was prepared",
                    }
                }
              } else {
                belt_exec(
                  cmd: host_exec_argv(
                    program: command.program as String,
                    args: command.args,
                  ),
                  workdir: worktree,
                )
              }
              match exec_outcome {
                ExecOk { stdout } =>
                  BeltValidationRun {
                    executions: acc.executions |> append(ValidationExecution {
                      validation: validation,
                      command: command,
                      exit_code: 0,
                      stdout: stdout,
                      stderr: "",
                    }),
                    verdict: ValidationPassed {
                      command: if prior == "" {
                        wire
                      } else {
                        join([prior, "; ", wire], "")
                      },
                      oracle_identity: oracle_identity,
                    },
                  }
                ExecFailed { program: _, exit_code, stderr } =>
                  BeltValidationRun {
                    executions: acc.executions |> append(ValidationExecution {
                      validation: validation,
                      command: command,
                      exit_code: exit_code,
                      stdout: "",
                      stderr: stderr,
                    }),
                    verdict: ValidationFailed {
                      command: wire,
                      exit_code: exit_code,
                      detail: stderr,
                    },
                  }
                ExecRefused { program, reason } =>
                  BeltValidationRun {
                    executions: acc.executions,
                    verdict: ValidationRefused {
                      cause: if program == "gunbc-diff-window" {
                        ValidationChangeWindowRefused {
                          cause: ChangeWindowPersistenceRefused {
                            path: "",
                            cause: reason,
                          },
                        }
                      } else {
                        ValidationCommandRefused {
                          program: program,
                          reason: reason,
                        }
                      },
                    },
                  }
              }
            }
          }
      }
    },
  )
}

fn belt_verify_attempt_for_instance(
  instance: HostDashboardInstance,
  progress: WorkflowAttemptProgress,
) -> BeltVerifyOutcome {
  let node_id = progress.node_id as gunbc.roadmap_model.RoadmapNodeId
  match progress.provider {
    ProviderCompleted { activity: _ } =>
      match belt_lookup_node(node_id: progress.node_id) {
        AuthorityProjectionRefused { detail: detail } =>
          VerifyDeferred {
            node_id: progress.node_id,
            reason: concat("roadmap authority projection refused: ", detail),
          }
        NodeMissing =>
          VerifyDeferred {
            node_id: progress.node_id,
            reason: "the roadmap authority declares no node with this id, so there is no contract to verify against",
          }
        NodeFound { node } => {
          let branch = dispatch_branch_name(
            node_id: node_id,
            attempt_key: progress.attempt_key,
          )
          if trim(branch) == "" {
            VerifyDeferred {
              node_id: progress.node_id,
              reason: "the attempt has no branch name, so there is no verification subject to construct",
            }
          } else {
            let attempt_worktree = dispatch_worktree_path_for_instance(
              instance: instance,
              node_id: node_id,
              attempt_key: progress.attempt_key,
            )
            match belt_worktree_head_observe(
              instance: instance,
              worktree: attempt_worktree,
            ) {
              WorktreeHeadUnobserved { reason } =>
                VerifyDeferred { node_id: progress.node_id, reason: reason }
              WorktreeHeadObserved { revision: revision } => {
                let head_sha = revision as String
                let worktree = belt_verify_detached_worktree(
                  instance: instance,
                  node_id: node_id,
                  attempt_key: progress.attempt_key,
                  head_sha: head_sha,
                )
                match node_criteria_digest(rn: node) {
                  Absent =>
                    VerifyDeferred {
                      node_id: progress.node_id,
                      reason: "this roadmap node has no criteria digest, so the verification subject cannot be constructed",
                    }
                  Present { value: criteria_digest } => {
                    let partial_subject = VerificationSubject {
                      node_identity: node.identity,
                      criteria_digest: criteria_digest,
                      attempt_key: progress.attempt_key,
                      branch: branch as NonEmptyStr,
                      head_sha: revision as CommitSha,
                      change_window_identity: git_diff_window_absent_identity(),
                    }
                    let prepared_window = if worktree != ""
                      && execution_contract_needs_diff_window(contract: node.execution) {
                      Present {
                        value: belt_prepare_diff_window_for_verification(
                          instance: instance,
                          node_id: node_id,
                          attempt_key: progress.attempt_key,
                          subject: partial_subject,
                          worktree: worktree,
                        ),
                      }
                    } else {
                      none
                    }
                    let subject = match prepared_window {
                      Present { value: GitDiffWindowPrepared { path: _, window: window } } =>
                        belt_verification_subject_with_window(
                          subject: partial_subject,
                          window_identity: window.window_identity,
                        )
                      Present { value: GitDiffWindowPrepareRefused { cause: _ } } =>
                        partial_subject
                      Absent => partial_subject
                    }
                    let identity_hex = git_diff_window_identity_hex(
                      identity: subject.change_window_identity,
                    )
                    let address = exact_verification_address_for(
                      attempt_dir: dispatch_attempt_state_path_for_instance(
                        instance: instance,
                        node_id: node_id,
                        attempt_key: progress.attempt_key,
                      ),
                      verification_dir: dispatch_attempt_verification_dir_for_instance(
                        instance: instance,
                        node_id: node_id,
                        attempt_key: progress.attempt_key,
                      ),
                      head_sha: head_sha,
                      window_identity_hex: identity_hex,
                    )
                    match belt_publish_current_verification_selection(
                      instance: instance,
                      node_id: node_id,
                      attempt_key: progress.attempt_key,
                      subject: subject,
                    ) {
                      VerificationSelectionPublishRefused { path: _, cause } =>
                        VerifyRefused {
                          node_id: progress.node_id,
                          cause: join([
                            "verification refused before running because the current selection could not be published: ",
                            cause,
                          ], ""),
                        }
                      VerificationSelectionPublished { path: _ } => {
                        let exact_source = exact_verification_receipt_source_read(
                          attempt_dir: address.attempt_dir,
                          verification_dir: address.verification_dir,
                          receipt_basename: address.receipt_basename,
                        )
                        match belt_verification_decision(
                          expected: subject,
                          source: exact_source,
                        ) {
                          BeltVerificationEvidenceUnreadable { reason } =>
                            VerifyEvidenceUnreadable {
                              node_id: progress.node_id,
                              detail: reason,
                            }
                          BeltVerificationRefuse { reason } =>
                            VerifyRefused {
                              node_id: progress.node_id,
                              cause: reason,
                            }
                          BeltVerificationDefer { reason } =>
                            VerifyDeferred {
                              node_id: progress.node_id,
                              reason: reason,
                            }
                          BeltVerificationRun =>
                            belt_verify_run_and_persist(
                              instance: instance,
                              node: node,
                              progress: progress,
                              subject: subject,
                              diff_window_path: if execution_contract_needs_diff_window(
                                contract: node.execution,
                              ) {
                                Present {
                                  value: dispatch_attempt_diff_window_path_for_instance(
                                    instance: instance,
                                    node_id: node_id,
                                    attempt_key: progress.attempt_key,
                                    head_sha: head_sha,
                                    window_identity_hex: identity_hex,
                                  ),
                                }
                              } else {
                                none
                              },
                              change_window_refusal: match prepared_window {
                                Present {
                                  value: GitDiffWindowPrepareRefused { cause: cause },
                                } =>
                                  Present { value: cause }
                                _ => none
                              },
                            )
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    _ =>
      VerifyDeferred {
        node_id: progress.node_id,
        reason: "the agent obligation is not satisfied, so there is nothing to verify yet",
      }
  }
}

fn belt_verify_run_and_persist(
  instance: HostDashboardInstance,
  node: RoadmapNode,
  progress: WorkflowAttemptProgress,
  subject: VerificationSubject,
  diff_window_path: String?,
  change_window_refusal: ChangeWindowPreparationRefusal?,
) -> BeltVerifyOutcome {
  let node_id = progress.node_id as gunbc.roadmap_model.RoadmapNodeId
  let identity_hex = git_diff_window_identity_hex(
    identity: subject.change_window_identity,
  )
  let receipt_path = dispatch_attempt_verification_receipt_path_for_instance(
    instance: instance,
    node_id: node_id,
    attempt_key: progress.attempt_key,
    head_sha: subject.head_sha as String,
    window_identity_hex: identity_hex,
  )
  let worktree = belt_verify_detached_worktree(
    instance: instance,
    node_id: node_id,
    attempt_key: progress.attempt_key,
    head_sha: subject.head_sha as String,
  )
  let pinned_identity_wire = belt_read_or_empty(
    path: dispatch_current_attempt_oracle_identity_path_for_instance(
      instance: instance,
      node_id: node_id,
    ),
  )
  let pinned_revision_wire = belt_read_or_empty(
    path: dispatch_current_attempt_oracle_revision_path_for_instance(
      instance: instance,
      node_id: node_id,
    ),
  )
  let pinned_identity = validation_oracle_parse_pinned_identity_wire(
    text: pinned_identity_wire,
  )
  let pinned_revision = validation_oracle_parse_pinned_revision_wire(
    text: pinned_revision_wire,
  )
  let pin_refusal = belt_read_or_empty(
    path: dispatch_current_attempt_oracle_pin_refusal_path_for_instance(
      instance: instance,
      node_id: node_id,
    ),
  )
  let pin_recorded = validation_oracle_pin_recorded(
    identity: pinned_identity,
    revision: pinned_revision,
  )
  if worktree == "" {
    let run = BeltValidationRun {
      executions: [],
      verdict: ValidationRefused {
        cause: ValidationCommandRefused {
          program: "git",
          reason: belt_verify_detached_worktree_refusal(
            instance: instance,
            node_id: node_id,
            attempt_key: progress.attempt_key,
            head_sha: subject.head_sha as String,
          ),
        },
      },
    }
    let receipt = VerificationReceipt {
      subject: subject,
      oracle_identity: match pinned_identity {
        Present { value: identity } => identity
        Absent =>
          as_content_hash_structural(
            structural: content_hash_atom(value: "oracle-pin-unreadable")
          )
      },
      executions: run.executions,
      verdict: run.verdict,
    }
    let write = Filesystem.Write(
      path: receipt_path,
      content: verification_receipt_json(receipt: receipt),
    )
    if write.success {
      VerifyRecorded {
        node_id: progress.node_id,
        verdict_key: validation_verdict_key(verdict: run.verdict),
        detail: validation_verdict_detail(verdict: run.verdict),
      }
    } else {
      VerifyWriteFailed {
        node_id: progress.node_id,
        detail: write.error,
      }
    }
  } else {
    match change_window_refusal {
      Present { value: cause } => {
        let run = BeltValidationRun {
          executions: [],
          verdict: ValidationRefused {
            cause: ValidationChangeWindowRefused { cause: cause },
          },
        }
        let receipt = VerificationReceipt {
          subject: subject,
          oracle_identity: match pinned_identity {
            Present { value: identity } => identity
            Absent =>
              as_content_hash_structural(
                structural: content_hash_atom(value: "oracle-pin-unreadable")
              )
          },
          executions: run.executions,
          verdict: run.verdict,
        }
        let write = Filesystem.Write(
          path: receipt_path,
          content: verification_receipt_json(receipt: receipt),
        )
        if write.success {
          VerifyRecorded {
            node_id: progress.node_id,
            verdict_key: validation_verdict_key(verdict: run.verdict),
            detail: validation_verdict_detail(verdict: run.verdict),
          }
        } else {
          VerifyWriteFailed {
            node_id: progress.node_id,
            detail: write.error,
          }
        }
      }
      Absent => {
    let observations = belt_oracle_observations_in_worktree(
      contract: node.execution,
      worktree: worktree,
    )
    let run = match validation_oracle_gate(
      contract: node.execution,
      observations: observations,
      pin_recorded: pin_recorded,
      expected_identity: match pinned_identity {
        Present { value: identity } => identity
        Absent =>
          as_content_hash_structural(
            structural: content_hash_atom(value: "oracle-pin-unreadable")
          )
      },
      revision: match pinned_revision {
        Present { value: revision } => revision
        Absent => "oracle-pin-unreadable" as NonEmptyStr as VersionIdentity
      },
      pin_read_detail: if pin_refusal == "" {
        "no oracle identity was recorded for this attempt at dispatch"
      } else {
        pin_refusal
      },
    ) {
      ValidationOracleGateRefused { cause } =>
        BeltValidationRun {
          executions: [],
          verdict: ValidationRefused { cause: cause },
        }
      ValidationOracleAdmitted { identity } =>
        match node.execution {
          ExecutionContractUnspecified =>
            BeltValidationRun {
              executions: [],
              verdict: ValidationRefused {
                cause: ValidationContractUnspecified,
              },
            }
          ExecutionContract { validations, extra_capabilities: _ } =>
            belt_run_validation_operations(
              instance: instance,
              validations: validations,
              worktree: worktree,
              oracle_identity: identity,
              diff_window_path: diff_window_path,
            )
        }
    }
    let receipt = VerificationReceipt {
      subject: subject,
      oracle_identity: match pinned_identity {
        Present { value: identity } => identity
        Absent =>
          as_content_hash_structural(
            structural: content_hash_atom(value: "oracle-pin-unreadable")
          )
      },
      executions: run.executions,
      verdict: run.verdict,
    }
    let write = Filesystem.Write(
      path: receipt_path,
      content: verification_receipt_json(receipt: receipt),
    )
    if write.success {
      VerifyRecorded {
        node_id: progress.node_id,
        verdict_key: validation_verdict_key(verdict: run.verdict),
        detail: validation_verdict_detail(verdict: run.verdict),
      }
    } else {
      VerifyWriteFailed {
        node_id: progress.node_id,
        detail: write.error,
      }
    }
      }
    }
  }
}

fn belt_verify_attempts_for_instance(
  instance: HostDashboardInstance,
) -> List<BeltVerifyOutcome> {
  match belt_workflow_attempts_observe_for_instance(instance: instance) {
    WorkflowAttemptsRefused { reason } =>
      [
        VerifyDeferred {
          node_id: "",
          reason: join([
            "the attempts ledger is unobservable, so no attempt can be verified: ",
            reason,
          ], ""),
        },
      ]
    WorkflowAttemptsObserved { attempts } =>
      map(attempts, progress => belt_verify_attempt_for_instance(
        instance: instance,
        progress: progress,
      ))
  }
}

fn belt_verify_attempts() -> List<BeltVerifyOutcome> {
  belt_verify_attempts_for_instance(
    instance: srv1_live_dashboard_instance(),
  )
}

fn belt_verify_pass_outcome_from(outcomes: List<BeltVerifyOutcome>) -> BeltPassOutcome {
  let ledger_refusals = outcomes |> filter(o => match o {
    VerifyDeferred { node_id: nid, reason: _ } => nid == ""
    VerifyWriteFailed { node_id: _, detail: _ } => false
    VerifyEvidenceUnreadable { node_id: _, detail: _ } => false
    VerifyRefused { node_id: _, cause: _ } => false
    VerifyRecorded { node_id: _, verdict_key: _, detail: _ } => false
  })
  if count(ledger_refusals) > 0 {
    match ledger_refusals.first() {
      Present { value: VerifyDeferred { node_id: _, reason: r } } =>
        BeltPassRefused { reason: r }
      _ =>
        BeltPassRefused { reason: "the attempts ledger is unobservable" }
    }
  } else {
    if any(outcomes, o => match o {
      VerifyWriteFailed { node_id: _, detail: _ } => true
      VerifyEvidenceUnreadable { node_id: _, detail: _ } => true
      VerifyDeferred { node_id: _, reason: _ } => false
      VerifyRefused { node_id: _, cause: _ } => false
      VerifyRecorded { node_id: _, verdict_key: _, detail: _ } => false
    }) {
      BeltPassFailed { reason: "one or more verification outcomes could not be recorded" }
    } else {
      let verification_refusals = outcomes |> filter(o => match o {
        VerifyRefused { node_id: _, cause: _ } => true
        VerifyWriteFailed { node_id: _, detail: _ } => false
        VerifyEvidenceUnreadable { node_id: _, detail: _ } => false
        VerifyDeferred { node_id: _, reason: _ } => false
        VerifyRecorded { node_id: _, verdict_key: _, detail: _ } => false
      })
      if count(verification_refusals) > 0 {
        match verification_refusals.first() {
          Present { value: VerifyRefused { node_id: _, cause: r } } =>
            BeltPassRefused { reason: r }
          _ =>
            BeltPassRefused { reason: "verification refused on one or more attempts" }
        }
      } else if count(outcomes) > 0
        && all(outcomes, o => match o {
          VerifyDeferred { node_id: nid, reason: _ } => nid != ""
          VerifyWriteFailed { node_id: _, detail: _ } => false
          VerifyEvidenceUnreadable { node_id: _, detail: _ } => false
          VerifyRefused { node_id: _, cause: _ } => false
          VerifyRecorded { node_id: _, verdict_key: _, detail: _ } => false
        }) {
        BeltPassDeferred {
          reason: "no attempt is ready for verification on this tick",
        }
      } else {
        BeltPassRecorded
      }
    }
  }
}

fn belt_workflow_attempts_observe_for_instance(
  instance: HostDashboardInstance,
) -> BeltWorkflowAttempts {
  match belt_attempts_observe_for_instance(instance: instance) {
    AttemptsRefused { reason } =>
      WorkflowAttemptsRefused { reason: reason }
    AttemptsObserved { attempts } => {
      let panes = belt_attempt_panes_observe_for_instance(instance: instance)
      WorkflowAttemptsObserved {
        attempts: dispatch_attempt_ref_first_per_node(attempts: attempts)
          |> map(attempt => belt_workflow_progress_for_attempt_ref(
            instance: instance,
            panes: panes,
            attempt: attempt,
          )),
      }
    }
  }
}

// The wire join of the two authorities the client must never re-derive: the attempt's progress
// members (gunbc.roadmap_workflow_progress, unchanged) plus the DECIDED activity view
// (gunbc.roadmap_presentation) appended as one 'activity' member. The seam reads process and
// current activity from INSIDE the progress carrier (one_progress_authority_note — the belt cannot
// pass a disagreeing process beside it), so the join is one call on one value. It lives here
// because progress cannot import presentation without a cycle; the member-list seam
// (workflow_attempt_progress_json_members) lets the belt extend the object without re-stating or
// re-matching it.
fn belt_workflow_attempt_presentation_json(
  progress: WorkflowAttemptProgress,
) -> JsonValue {
  belt_workflow_attempt_presentation_json_with_tick_read(
    progress: progress,
    tick_read: BeltTickReceiptAbsent,
  )
}

fn belt_workflow_attempt_presentation_json_for_instance(
  instance: HostDashboardInstance,
  progress: WorkflowAttemptProgress,
) -> JsonValue {
  belt_workflow_attempt_presentation_json_with_tick_read(
    progress: progress,
    tick_read: belt_tick_receipt_read_for_instance(instance: instance),
  )
}

fn belt_workflow_attempt_presentation_json_with_tick_read(
  progress: WorkflowAttemptProgress,
  tick_read: BeltTickReceiptRead,
) -> JsonValue {
  json_object(members: concat(
    workflow_attempt_progress_json_members(progress: progress),
    [
      json_kv(key: "activity", value: activity_view_json_value(
          view: activity_view_from_progress(progress: progress))),
      json_kv(
        key: "verification_presentation",
        value: json_string(
          s: belt_verification_presentation_detail(
            progress: progress,
            tick_read: tick_read,
          ),
        ),
      ),
    ]))
}

fn belt_tick_receipt_wire_json_from_read(tick_read: BeltTickReceiptRead) -> JsonValue {
  match tick_read {
    BeltTickReceiptPresent { receipt } =>
      json_object(members: [
        json_kv(key: "present", value: json_bool(b: true)),
        json_kv(key: "receipt", value: belt_tick_receipt_json_value(receipt: receipt)),
      ])
    BeltTickReceiptAbsent =>
      json_object(members: [
        json_kv(key: "present", value: json_bool(b: false)),
      ])
    BeltTickReceiptUnreadable { reason: r } =>
      json_object(members: [
        json_kv(key: "present", value: json_bool(b: false)),
        json_kv(
          key: "unreadable_reason",
          value: json_string(s: r),
        ),
      ])
  }
}

fn belt_tick_receipt_wire_json_for_instance(
  instance: HostDashboardInstance,
) -> JsonValue {
  belt_tick_receipt_wire_json_from_read(
    tick_read: belt_tick_receipt_read_for_instance(instance: instance),
  )
}

fn belt_workflow_attempts_json_value_for_instance(
  instance: HostDashboardInstance,
  observed: BeltWorkflowAttempts,
) -> JsonValue {
  let tick_read = belt_tick_receipt_read_for_instance(instance: instance)
  match observed {
    WorkflowAttemptsRefused { reason } =>
      json_object(members: [
        json_kv(key: "schema", value: json_string(s: "roadmap-workflow/v1")),
        json_kv(key: "observe_refused", value: json_bool(b: true)),
        json_kv(key: "reason", value: json_string(s: reason)),
        json_kv(key: "belt_tick", value: belt_tick_receipt_wire_json_from_read(tick_read: tick_read)),
      ])
    WorkflowAttemptsObserved { attempts } =>
      json_object(members: [
        json_kv(key: "schema", value: json_string(s: "roadmap-workflow/v1")),
        json_kv(key: "observe_refused", value: json_bool(b: false)),
        json_kv(
          key: "attempts",
          value: json_array(elements: map(
            attempts,
            progress => belt_workflow_attempt_presentation_json_with_tick_read(
              progress: progress,
              tick_read: tick_read,
            ),
          )),
        ),
        json_kv(key: "belt_tick", value: belt_tick_receipt_wire_json_from_read(tick_read: tick_read)),
      ])
  }
}

fn belt_workflow_attempts_json_value(
  observed: BeltWorkflowAttempts,
) -> JsonValue {
  belt_workflow_attempts_json_value_for_instance(
    instance: srv1_live_dashboard_instance(),
    observed: observed,
  )
}

fn belt_workflow_attempts_observed_json_for_instance(
  instance: HostDashboardInstance,
  observed: BeltWorkflowAttempts,
) -> String {
  serialize_json(v: belt_workflow_attempts_json_value_for_instance(
    instance: instance,
    observed: observed,
  ))
}

fn belt_workflow_attempts_observed_json(
  observed: BeltWorkflowAttempts,
) -> String {
  serialize_json(v: belt_workflow_attempts_json_value(observed: observed))
}

fn belt_workflow_attempts_http_status(
  observed: BeltWorkflowAttempts,
) -> Int {
  match observed {
    WorkflowAttemptsRefused { reason: _ } => 503
    WorkflowAttemptsObserved { attempts: _ } => 200
  }
}

type BeltStopResult
  = StopProcessStopped { node_id: String, session_name: String }
  | StopRetainedSessionCleared {
      node_id: String,
      session_name: String,
      exit_code: Int,
    }
  | StopDisabled { node_id: String, instance_id: String, reason: String }
  | StopRefusedResult { node_id: String, reason: String }
  | StopObserveRefused { node_id: String, reason: String }
  | StopTeardownFailed { node_id: String, session_name: String, detail: String }

// U4 (stop/clear from the UI): cleanup consumes the same independently observed session and process
// facts served to the page. Session-list refusal yields StopObserveRefused. A present running pane
// is stop-eligible only with the configured provider fingerprint; a foreign or unobserved running
// process refuses. A retained dead pane is a different operation: clear removes tmux metadata after
// the process exited, so its historical wrapper command is never misclassified as a live foreign
// process. Teardown failure remains its own typed 502 arm.
fn belt_stop_node_for_instance(
  instance: HostDashboardInstance,
  node_id: String,
) -> BeltStopResult {
  match instance.actuation {
    DashboardObserveOnly =>
    StopDisabled {
      node_id: node_id,
      instance_id: instance.instance_id as String,
      reason: "dashboard instance is observe-only; stop refused before tmux observation",
    }
    DashboardActuating => {
  match belt_sessions_observe_for_instance(instance: instance) {
    ObserveRefused { reason: r } => StopObserveRefused { node_id: node_id, reason: r }
    Observed { live } => {
      match dispatch_tmux_session_scope(node_id: node_id) {
        Absent =>
          StopRefusedResult {
            node_id: node_id,
            reason: "dispatch selection refused before stop scope",
          }
        Present { value: scope } => {
      let matched = live
        |> filter(sess =>
          sess.session_name == (scope.session_name as String))
      match matched.first() {
        Absent =>
          StopRefusedResult {
            node_id: node_id,
            reason: "no session container for this node",
          }
        Present { value: session } =>
          match dispatch_session_cleanup(scope: scope, session: session) {
            DispatchCleanupRefused { reason } =>
              StopRefusedResult { node_id: node_id, reason: reason }
            DispatchStopRunningProcess { session_name } =>
              match belt_actuate_teardown_for_instance(
                instance: instance,
                session_name: session_name,
              ) {
                ReapedSession { session_name: stopped } =>
                  StopProcessStopped {
                    node_id: node_id,
                    session_name: stopped,
                  }
                TeardownFailed { session_name: failed, detail } =>
                  StopTeardownFailed {
                    node_id: node_id,
                    session_name: failed,
                    detail: detail,
                  }
              }
            DispatchClearRetainedSession { session_name, exit_code } =>
              match belt_actuate_teardown_for_instance(
                instance: instance,
                session_name: session_name,
              ) {
                ReapedSession { session_name: cleared } =>
                  StopRetainedSessionCleared {
                    node_id: node_id,
                    session_name: cleared,
                    exit_code: exit_code,
                  }
                TeardownFailed { session_name: failed, detail } =>
                  StopTeardownFailed {
                    node_id: node_id,
                    session_name: failed,
                    detail: detail,
                  }
              }
          }
      }
        }
      }
    }
  }
  }
  }
}

fn belt_stop_node(node_id: String) -> BeltStopResult {
  belt_stop_node_for_instance(
    instance: srv1_live_dashboard_instance(),
    node_id: node_id,
  )
}

fn belt_stop_result_json_value(r: BeltStopResult) -> JsonValue {
  match r {
    StopProcessStopped { node_id: nid, session_name: sn } =>
      json_object(members: [
        json_kv(key: "node_id", value: json_string(s: nid)),
        json_kv(key: "status", value: json_string(s: "process_stopped")),
        json_kv(key: "action", value: json_string(s: "stop")),
        json_kv(key: "ok", value: json_bool(b: true)),
        json_kv(key: "session_name", value: json_string(s: sn)),
      ])
    StopRetainedSessionCleared {
      node_id: nid,
      session_name: sn,
      exit_code,
    } =>
      json_object(members: [
        json_kv(key: "node_id", value: json_string(s: nid)),
        json_kv(key: "status", value: json_string(s: "session_cleared")),
        json_kv(key: "action", value: json_string(s: "clear")),
        json_kv(key: "ok", value: json_bool(b: true)),
        json_kv(key: "session_name", value: json_string(s: sn)),
        json_kv(key: "exit_code", value: json_int(n: exit_code)),
      ])
    StopDisabled { node_id: nid, instance_id: iid, reason: why } =>
      json_object(members: [
        json_kv(key: "node_id", value: json_string(s: nid)),
        json_kv(key: "status", value: json_string(s: "stop_disabled")),
        json_kv(key: "ok", value: json_bool(b: false)),
        json_kv(key: "instance", value: json_string(s: iid)),
        json_kv(key: "reason", value: json_string(s: why)),
      ])
    StopRefusedResult { node_id: nid, reason: r2 } =>
      json_object(members: [
        json_kv(key: "node_id", value: json_string(s: nid)),
        json_kv(key: "status", value: json_string(s: "stop_refused")),
        json_kv(key: "ok", value: json_bool(b: false)),
        json_kv(key: "reason", value: json_string(s: r2)),
      ])
    StopObserveRefused { node_id: nid, reason: r3 } =>
      json_object(members: [
        json_kv(key: "node_id", value: json_string(s: nid)),
        json_kv(key: "status", value: json_string(s: "observe_refused")),
        json_kv(key: "ok", value: json_bool(b: false)),
        json_kv(key: "reason", value: json_string(s: r3)),
      ])
    StopTeardownFailed { node_id: nid, session_name: sn, detail: d } =>
      json_object(members: [
        json_kv(key: "node_id", value: json_string(s: nid)),
        json_kv(key: "status", value: json_string(s: "teardown_failed")),
        json_kv(key: "ok", value: json_bool(b: false)),
        json_kv(key: "session_name", value: json_string(s: sn)),
        json_kv(key: "detail", value: json_string(s: d)),
      ])
  }
}

fn belt_stop_http_status(r: BeltStopResult) -> Int {
  match r {
    StopProcessStopped { node_id: _, session_name: _ } => 200
    StopRetainedSessionCleared {
      node_id: _,
      session_name: _,
      exit_code: _,
    } => 200
    StopDisabled { node_id: _, instance_id: _, reason: _ } => 403
    StopRefusedResult { node_id: _, reason: r2 } =>
      if string_contains(s: r2, pattern: "no session container") {
        404
      } else {
        409
      }
    StopObserveRefused { node_id: _, reason: _ } => 503
    StopTeardownFailed { node_id: _, session_name: _, detail: _ } => 502
  }
}

fn belt_stop_json(node_id: String) -> String {
  serialize_json(v: belt_stop_result_json_value(r: belt_stop_node(node_id: node_id)))
}

// The sessions wire projects independent session-container, process-lifecycle, provider, readiness,
// phase and cleanup facts. Inclusion in sessions proves only `session_presence=present`.
// process_state comes from the exact dead/status pane observation; cleanup_action is derived
// separately from process state plus ownership policy. A refused pane probe stays per-session as
// process unobserved and cleanup unavailable while the session set remains a 200; only refusal of
// the tmux session-list source produces top-level observe_refused/503. Cleanup scope for admitted
// rows uses dispatch_tmux_session_scope_for_live_session from the session worker's configured
// provider facts — never a production-selection re-query that would fabricate eligibility or a
// partial row when standing refuses.
fn belt_sessions_json_value(o: BeltObserve) -> JsonValue {
  match o {
    ObserveRefused { reason: r } =>
      json_object(members: [
        json_kv(key: "schema", value: json_string(s: "roadmap-sessions/v1")),
        json_kv(key: "observe_refused", value: json_bool(b: true)),
        json_kv(key: "reason", value: json_string(s: r)),
      ])
    Observed { live } =>
      json_object(members: [
        json_kv(key: "schema", value: json_string(s: "roadmap-sessions/v1")),
        json_kv(key: "observe_refused", value: json_bool(b: false)),
        json_kv(key: "sessions", value: json_array(elements: live |> map(sess => {
          let cleanup = dispatch_session_cleanup_for_live_session(sess: sess)
          json_object(members: [
            json_kv(key: "node_id", value: json_string(s: sess.node_id)),
            json_kv(key: "session_name", value: json_string(s: sess.session_name)),
            json_kv(key: "session_presence", value: json_string(s: "present")),
            json_kv(key: "process_state", value: json_string(
              s: worker_process_evidence_label(evidence: sess.worker.process))),
            json_kv(key: "process_detail", value: json_string(
              s: worker_process_evidence_detail(evidence: sess.worker.process))),
            json_kv(key: "configured_provider", value: json_string(s: provider_kind_label(kind: sess.worker.configured_provider.kind))),
            json_kv(key: "provider", value: json_string(s: provider_evidence_label(evidence: sess.worker.provider_instance))),
            json_kv(key: "provider_readiness", value: json_string(s: provider_readiness_label(readiness: sess.worker.provider_readiness))),
            json_kv(key: "tool_execution_readiness", value: json_string(s: tool_execution_readiness_label(readiness: sess.worker.tool_readiness))),
            json_kv(key: "worker_phase", value: json_string(s: worker_phase_label(phase: sess.worker.phase))),
            json_kv(key: "cleanup_action", value: json_string(
              s: dispatch_session_cleanup_action(cleanup: cleanup))),
            json_kv(key: "cleanup_allowed", value: json_bool(
              b: dispatch_session_cleanup_allowed(cleanup: cleanup))),
            json_kv(key: "cleanup_detail", value: json_string(
              s: dispatch_session_cleanup_detail(cleanup: cleanup))),
            json_kv(key: "facts", value: session_facts_json_value(
              v: session_facts_view(
                process: sess.worker.process,
                process_detail: worker_process_evidence_detail(evidence: sess.worker.process),
                provider: provider_evidence_label(evidence: sess.worker.provider_instance),
                configured_provider: provider_kind_label(kind: sess.worker.configured_provider.kind),
                provider_readiness: provider_readiness_label(readiness: sess.worker.provider_readiness),
                session_name: sess.session_name,
                cleanup_action: dispatch_session_cleanup_action(cleanup: cleanup),
                cleanup_allowed: dispatch_session_cleanup_allowed(cleanup: cleanup),
                cleanup_detail: dispatch_session_cleanup_detail(cleanup: cleanup),
              ))),
          ])
        }))),
      ])
  }
}

fn belt_sessions_observed_json(o: BeltObserve) -> String {
  serialize_json(v: belt_sessions_json_value(o: o))
}

fn belt_sessions_json() -> String {
  belt_sessions_observed_json(o: belt_sessions_observe())
}

fn belt_sessions_http_status(o: BeltObserve) -> Int {
  match o {
    ObserveRefused { reason: _ } => 503
    Observed { live: _ } => 200
  }
}

fn belt_run_once_json() -> String {
  serialize_json(v: belt_tick_result_json_value(t: belt_run_once()))
}

data belt_run_once_cli_note: String = "The ProcessExit entrypoint — this is what `gunbc run --function belt_run_once_cli` invokes (belt_run_once_json returns String, which `gunbc run` rejects; belt_run_once_cli is its runnable wrapper). EXIT SEMANTICS (operator P0, 2026-08-02): exit 0 when the tick COMPLETED and PERSISTED its BeltTickReceipt — spawn failures, recorded validation refusals, and observe_refused on the spawn pass do NOT flip the exit, because those are counted outcomes in the receipt, not a failure to run or record the tick. Nonzero ONLY when the tick could not persist its receipt (BeltPassFailed on write) or when GUNBC_BELT_SPAWN_WORKDIR is missing/empty. systemd therefore distinguishes 'tick crashed' from 'tick ran, work refused'. The stdout JSON (roadmap-belt-tick/v1) remains the per-tick operational receipt for journald; the persisted BeltTickReceipt (roadmap-belt-tick-receipt/v3) is what /workflow.json reads for presentation."

// THE SPAWN ROOT IS SUPPLIED BY WHOEVER INVOKES THE TICK; MAKING IT A LITERAL WAS THE DEFECT.
// belt_actuate_workdir projects srv1_gunbc_repo_root, so a tick ran `git worktree add` into
// PRODUCTION's tree whichever deployment invoked it — invisible while nothing ticked on a cadence,
// but once a deployment owns a timer the srv1-lab twin would install a unit that actuates
// production: the failure gunbc.live_deploy.spec's deployment_service_handler_note records for the
// serve handler, where every path-level check passes and the process operates as production.
//
// It enters through the environment for the same reason the node id does
// (belt_dispatch_node_cli_note): `gunbc run --function` cannot pass an argument, there is no --arg
// flag. So the deployment's belt unit sets GUNBC_BELT_SPAWN_WORKDIR to ITS instance's repo root and
// each instance actuates its own tree.
//
// FAIL-CLOSED ON THE CHANNEL, more important here than for a node id: defaulting an absent variable
// to belt_actuate_workdir would silently restore the exact defect for every caller that forgot it —
// the absorbing fallback DESIGN §5 forbids, with production's tree as the thing absorbed. Missing
// OR empty refuses; shell.Env.Get returns Present-but-empty for an unset var wet, so both fold into
// one refusal.
//
// belt_run_once and belt_run_once_json keep the literal default: they are inspection surfaces
// invoked by hand against production, not the scheduled entrypoint, and belt_run_once_in is the one
// implementation both route through so the parameterized and default paths cannot drift.
fn belt_run_once_cli() -> ProcessExit {
  match shell.Env.Get(name: belt_spawn_workdir_env_var).value {
    Absent =>
      exit_failure(reason: "belt_run_once_cli: GUNBC_BELT_SPAWN_WORKDIR not set — the spawn root is a per-deployment fact and defaulting it would actuate production's tree (fail-closed)")
    Present { value: workdir } =>
      if string_length(s: workdir) == 0 {
        exit_failure(reason: "belt_run_once_cli: GUNBC_BELT_SPAWN_WORKDIR is empty — the spawn root is a per-deployment fact and defaulting it would actuate production's tree (fail-closed)")
      } else {
        belt_run_once_cli_in(spawn_workdir: workdir)
      }
  }
}

fn belt_run_once_cli_in(spawn_workdir: String) -> ProcessExit {
  match dashboard_instance_for_repo_root(repo_root: spawn_workdir) {
    DashboardInstanceRootUnknown { repo_root: w } =>
      exit_failure(reason: join([
        "belt_run_once_cli: GUNBC_BELT_SPAWN_WORKDIR does not match a known dashboard instance repo root: ",
        w,
      ], ""))
    DashboardInstanceResolved { instance } => {
      let t = belt_run_once_in(instance: instance, spawn_workdir: spawn_workdir)
      let tick_receipt = belt_tick_receipt_from_result(
        result: t,
        observed_at: belt_tick_observed_at(),
        execution: belt_tick_execution_standing_for_instance(
          instance: instance,
          mode: roadmap_belt_production_spawn_mode,
        ),
      )
      match belt_tick_receipt_write_for_instance(instance: instance, receipt: tick_receipt) {
        BeltPassFailed { reason: r } =>
          exit_failure(reason: join([
            serialize_json(v: belt_tick_result_json_value(t: t)),
            "\n",
            r,
          ], ""))
        BeltPassRecorded =>
          ExitSuccess
        BeltPassDeferred { reason: r } =>
          exit_failure(reason: join(["belt tick receipt write returned deferred: ", r], ""))
        BeltPassRefused { reason: r } =>
          exit_failure(reason: join(["belt tick receipt write returned refused: ", r], ""))
      }
    }
  }
}

// Per-node MANUAL dispatch — the click path (operator 2026-07-20: 'i should just manually
// click/dispatch'). belt_run_once ticks the WHOLE ready frontier; belt_dispatch_node spawns exactly
// ONE node by id, operator-selected from the roadmap UI, NOT frontier-gated (the click IS the
// selection). DONE = the operator's SIGNOFF, never a merged PR (operator: 'PR merged not
// necessarily mean item == done — they may not be 1:1'): a signoff-accepted node refuses
// (DispatchNodeAlreadyDone); a node whose PRs merged but is unsigned is still 'in review' and
// dispatchable. Idempotent by the tick's observe-before-spawn, asserted of a PROCESS not a
// container name (belt_session_liveness_note): a running worker gives DispatchAlreadyLive (noop) so
// a double-click never double-spawns; a retained dead pane gives DispatchStaleSession — refused,
// never accepted, never suppressing the new turn. Fail-closed: unknown node id ->
// DispatchNodeNotFound; unknowable observed set -> DispatchObserveRefused; unreadable pane
// lifecycle for a present session -> DispatchSessionLivenessUnobserved (no blind spawn under
// unknown liveness); spawn failure -> DispatchSpawnFailed (never a fabricated success). Reuses
// belt_lookup_node (pure roadmap read), belt_sessions_observe_for_instance (the process-aware
// observation the sessions route already used) and belt_actuate_spawn — no forked spawn path, no
// second observer.
type BeltNodeLookup
  = NodeFound { node: RoadmapNode }
  | NodeMissing
  | AuthorityProjectionRefused { detail: String }

fn belt_find_node_in(nodes: List<RoadmapNode>, node_id: String) -> BeltNodeLookup {
  let matches = nodes |> filter(n => n.node == node_id)
  fold(matches, init: NodeMissing, f: fn(acc, n) {
    match acc {
      NodeFound { node: _ } => acc
      NodeMissing => NodeFound { node: n }
      AuthorityProjectionRefused { detail: _ } => acc
    }
  })
}

fn belt_lookup_node(node_id: String) -> BeltNodeLookup {
  match roadmap_authority_projection() {
    RoadmapAuthorityProjectionRefused { detail: detail } =>
      AuthorityProjectionRefused { detail: detail }
    RoadmapAuthorityProjected { doc: doc, accepted: _ } =>
      belt_find_node_in(nodes: doc_all_nodes(doc: doc), node_id: node_id)
  }
}

// A TMUX CONTAINER IS NOT A LIVE AGENT, AND ADMISSION WAS THE LAST PLACE IN THIS MODULE TO LEARN
// IT. dispatch_process_cleanup_separation_note settled the rule for cleanup and
// belt_sessions_observation_separation_note for the sessions route: session presence and process
// lifecycle are independent, so `session present` never means `agent running`. Dispatch admission
// never adopted it: belt_node_session_live asked `any(live, s => s.node_id == node_id)` over tmux
// ls rows whose worker evidence was the worker_observation_without_provider_probe placeholder, so a
// retained remain-on-exit pane — the artifact the spawn path CREATES by setting remain-on-exit —
// answered `live`, and the click returned DispatchAlreadyLive through the accepted band: a positive
// acknowledgement, no agent, forever, no refusal to count.
//
// THAT IS WORSE THAN THE REFUSAL BESIDE IT. A selection refusal lands in a journal as a typed,
// counted event; an accepted no-op is indistinguishable from success at every surface, so its
// frequency is zero by construction — DESIGN section 5's absorbing fallback wearing an idempotence
// label. `already running` is a claim about a PROCESS: derive it from process evidence or refuse.
//
// THE FOUR ANSWERS ARE NOT A BOOLEAN. Running alone may suppress a spawn. StaleTerminal (pane dead)
// must never suppress the new turn nor read as accepted — the remedy is to clear or supersede it.
// LivenessUnobserved (pane probe refused, or dead pane with no exit status) REFUSES rather than
// spawning, because a blind spawn under unknown liveness is how one node acquires two workers.
// Absent is the ordinary path to a spawn. Collapsing Unobserved into either pole is the state-space
// conflation that produced this defect one level down.
//
// NO SECOND OBSERVER WAS BUILT. The pane probe (belt_attempt_panes_observe_for_instance), the
// pane-to-evidence projection (worker_process_from_attempt_pane) and the per-session join
// (worker_process_for_session) already existed with the refusal semantics; dispatch admission just
// read the ls-only observation instead. Both actuation call sites — tick and dispatch — now route
// through the observation the sessions UI already used.
type BeltSessionLiveness
  = BeltSessionRunning { session_name: String, command: String }
  | BeltSessionStaleTerminal { session_name: String, detail: String }
  | BeltSessionLivenessUnobserved { session_name: String, reason: String }
  | BeltSessionAbsent
  | BeltSessionMultiplicityConflict { session_names: String, session_count: Int }

fn belt_session_liveness_from_process(
  session_name: String,
  process: WorkerProcessEvidence,
) -> BeltSessionLiveness {
  match process {
    WorkerProcessRunning { command } =>
      BeltSessionRunning { session_name: session_name, command: command as String }
    WorkerProcessExited { exit_code, last_command } =>
      BeltSessionStaleTerminal {
        session_name: session_name,
        detail: join([
          "retained pane: process exited with status ",
          to_string(exit_code),
          "; last command ",
          last_command,
        ], ""),
      }
    WorkerProcessAbsent =>
      BeltSessionStaleTerminal {
        session_name: session_name,
        detail: "session container is present but no provider process is attached",
      }
    WorkerProcessUnobserved { reason } =>
      BeltSessionLivenessUnobserved {
        session_name: session_name,
        reason: reason as String,
      }
  }
}

// 0/1/MANY, BECAUSE first() IS A SILENT VERDICT (review artifact 51237 handback item 3). The fold
// filtered rows by node id and took the first match, so two sessions claiming one node resolved to
// whichever tmux listed first — [running, stale] answered running, [stale, running] answered stale:
// one observation, two orders, two outcomes, no signal that a choice was made.
//
// Two sessions for one node is not a tie to break but a state whose remedy differs from every other
// arm — neither spawn nor reuse is safe until someone decides which history is real. So it refuses
// and NAMES every session; a bare 'ambiguous' leaves the operator to find the panes.
// belt_node_session_live IS DELETED. It answered Bool over a four-state lifecycle, mapping
// StaleTerminal, LivenessUnobserved and Absent all to false — three states with different remedies
// per the module's own liveness note (clean up; refuse and count; spawn). A Boolean erasing the
// distinction invites bypassing the coproduct, and it had no production caller once dispatch
// matched BeltSessionLiveness directly. Consumers match the coproduct.
data belt_dispatch_wire_contract_exemplar_provider: String = "codex"

// DISPATCH READS BACK THE DEPLOYED REVISION BEFORE IT ACTS, because every fact this path consumes —
// node roster, signoff, contract, the command it runs — comes from the deployed tree.
// `gunbc.fleet_desired_observe` `fleet_revision_standing` already decided that cell three ways, and
// its ONLY consumer was `gunbc.fleet_converge_cli`: convergence knew the host was drifted while the
// served page dispatched against the drifted tree, saying nothing. Not a stale display — a worker
// spawned from code the fleet never admitted, reported as an ordinary spawn.
//
// So the standing is consulted FIRST — before node lookup, session observation, worktree — because
// a roster from an unadmitted tree cannot be trusted to name the right node, and refusing later
// means refusing after acting on it.
//
// BOTH non-converged arms refuse, neither an absorbing widen: `RevisionDrifted` carries BOTH
// revisions (the membership-diff `from` ruling — a catch-up needs the prior, a receipt must name
// what it observed); `RevisionUnobserved` carries its cause and is unobserved-GRADE, never
// satisfied. Dispatching on `RevisionUnobserved` would be the empty-observation narrow:
// could-not-compare rendered as nothing-is-wrong.
//
// The repo path is `instance.repo_root`, not the `srv1_gunbc_repo_root` constant
// `fleet_converge_cli` uses: the gate is a fact about the instance dispatched, and hardcoding srv1
// would mint a second path authority answering for the wrong host on any other instance.
// THE TRANSITION GATE DOMINATES THE REVISION GATE; the order is the safety property. A repository
// convergence advances the base ref BEFORE it transitions the worktree, so a converge that died in
// between leaves the ref at the admitted revision over a tree that never moved — and
// `fleet_revision_standing` reads that ref. The revision gate would answer CONVERGED and admit a
// dispatch into exactly the half-transitioned tree the belt must stay out of. Asking the inhibition
// first stops a gate being satisfied by the artifact of the failure it should notice.
//
// UNREADABLE REFUSES. `actuation_admission` admits only `ActuationPermitted`; an unreadable
// standing is a refusal carrying its cause, never a proceed.
fn belt_transition_admission_for_instance(instance: HostDashboardInstance) -> ActuationAdmission {
  actuation_admission(
    standing: transition_actuation_standing(instance_root: instance.instance_root as String),
  )
}

// THE ONE HOST OBSERVATION the launch admission consumes, produced here because this module owns
// the observers: posture from the instance, the transition admission, the fleet revision standing,
// the tmux session set, the capacity and the spawn mode. The served daily page, POST /dispatch and
// (inline, after the tick-wide transition and revision refusals) the belt tick all hand this to
// gunbc.roadmap_launch_admission, so `drift refuses UI availability and backend actuation with the
// same reason` holds by construction: one standing, one decision.
// THE ONE STAGED OBSERVER behind the page, POST /dispatch and the timer. It reads in gate order and
// stops at the first refusal: instance posture is a model fact (no effect); the transition file is
// read only for an actuating instance; the fleet revision only under an admitted transition; tmux
// only under a converged revision. Each halt is a LaunchHostHalted whose later fields do not exist,
// so `tmux listed under an inhibited transition` is not a state it can produce (DESIGN 4b: no
// constructor). The refusal in a halt is derived by the admission's own gate functions
// (launch_host_halt_transition, launch_host_stage_revision), never spelled here.
fn belt_launch_host_standing_for_instance_with_capacity(
  instance: HostDashboardInstance,
  mode: SpawnMode,
  capacity: BeltCapacity,
) -> LaunchHostStanding {
  let instance_id = instance.instance_id as String
  match instance.actuation {
    DashboardObserveOnly => LaunchHostObserveOnly { instance_id: instance_id }
    DashboardActuating =>
      match belt_transition_admission_for_instance(instance: instance) {
        ActuationRefused { reason } => launch_host_halt_transition(instance_id: instance_id, reason: reason)
        ActuationAdmitted =>
          match launch_host_stage_revision(
            instance_id: instance_id,
            revision: admitted_revision_standing(
              repo: instance.repo_root,
              remote: instance.admitted_revision.remote,
              ref_name: instance.admitted_revision.ref_name,
            ),
          ) {
            HostRevisionHalted { standing } => standing
            HostRevisionConverged { revision } =>
              LaunchHostObserved {
                instance_id: instance.instance_id,
                actuation: DashboardActuating,
                transition: ActuationAdmitted,
                revision: revision,
                sessions: LaunchSessionsPending,
                capacity: capacity,
                mode: mode,
              }
          }
      }
  }
}

fn belt_launch_sessions_for_instance(instance: HostDashboardInstance) -> LaunchSessionsStanding {
  match belt_sessions_observe_for_instance(instance: instance) {
    Observed { live } => LaunchSessionsObserved { live: live }
    ObserveRefused { reason } => LaunchSessionsUnobserved { reason: reason }
  }
}

// The one place tmux is listed for a launch decision: a pending session set on an otherwise
// admitted host is observed ONCE and bound into the standing. The timer calls it after the host
// gates admit (its reap pass needs the observed set whatever the launch verdicts); the route only
// when launch_admission_staged answered LaunchStageNeedsSessions for the posted node; the page only
// when at least one row answered so. A halted, observe-only or unobserved standing is returned
// unchanged — nothing to complete, nothing read.
fn belt_launch_host_standing_complete(instance: HostDashboardInstance, standing: LaunchHostStanding) -> LaunchHostStanding {
  match standing {
    LaunchHostObserved { instance_id: _, actuation: _, transition: _, revision: _, sessions, capacity: _, mode: _ } =>
      match sessions {
        LaunchSessionsPending => launch_host_with_sessions(standing: standing, sessions: belt_launch_sessions_for_instance(instance: instance))
        LaunchSessionsObserved { live: _ } => standing
        LaunchSessionsUnobserved { reason: _ } => standing
      }
    LaunchHostObserveOnly { instance_id: _ } => standing
    LaunchHostHalted { instance_id: _, gate: _, refusal: _ } => standing
    LaunchHostUnobserved { reason: _ } => standing
  }
}

type BeltPageSessionsNeed
  = PageSessionsNotNeeded
  | PageSessionsNeeded { first_node_id: String }

fn belt_page_sessions_need(standing: LaunchHostStanding, graph: LaunchGraphStanding, merged: List<Int>, nodes: List<RoadmapNode>) -> BeltPageSessionsNeed {
  fold(nodes, init: PageSessionsNotNeeded, f: (acc, n) => match acc {
    PageSessionsNeeded { first_node_id } => PageSessionsNeeded { first_node_id: first_node_id }
    PageSessionsNotNeeded =>
      match launch_admission_staged(cause: Operator, standing: standing, graph: graph, merged: merged, node_id: n.node as String, reserved: 0) {
        LaunchStageNeedsSessions => PageSessionsNeeded { first_node_id: n.node as String }
        LaunchStageDecided { admission: _ } => PageSessionsNotNeeded
      }
  })
}

fn belt_launch_host_standing_for_page(instance: HostDashboardInstance) -> LaunchHostStanding {
  let pre = belt_launch_host_standing(instance: instance)
  match roadmap_authority_projection() {
    RoadmapAuthorityProjectionRefused { detail: _ } => pre
    RoadmapAuthorityProjected { doc, accepted: _ } => {
      let graph = launch_graph_of_document(doc: doc)
      let merged = authored_merged_prs()
      match belt_page_sessions_need(standing: pre, graph: graph, merged: merged, nodes: doc_all_nodes(doc: doc)) {
        PageSessionsNeeded { first_node_id: _ } => belt_launch_host_standing_complete(instance: instance, standing: pre)
        PageSessionsNotNeeded => pre
      }
    }
  }
}

fn belt_launch_host_standing_for_instance(instance: HostDashboardInstance, mode: SpawnMode) -> LaunchHostStanding {
  belt_launch_host_standing_for_instance_with_capacity(instance: instance, mode: mode, capacity: roadmap_belt_default_capacity)
}

fn belt_launch_host_standing(instance: HostDashboardInstance) -> LaunchHostStanding {
  belt_launch_host_standing_for_instance(instance: instance, mode: roadmap_belt_production_spawn_mode)
}

// POST /dispatch/<node_id> IS A PROJECTION OF THE SHARED ADMISSION (RLM-1). The route observes the
// host once, asks gunbc.roadmap_launch_admission with cause Operator, and actuates only on
// LaunchAdmitted — so a blocked child is refused DependenciesBlocked before any worktree, provider
// preflight or clock read; a second click on a live node answers AlreadyLive with the existing
// session; and the old route's manual out-of-order override (no dependency, capacity or contract
// check) has no path left. The node model the spawn needs is looked up AFTER admission through the
// projection the admission read; an admitted node cannot fail this lookup, and a projection refusal
// between the two reads is a typed SpawnFailed, never a spawn.
fn belt_dispatch_node_for_instance(
  instance: HostDashboardInstance,
  node_id: String,
) -> BeltSpawnOutcome {
  belt_dispatch_node_staged(instance: instance, standing: belt_launch_host_standing(instance: instance), node_id: node_id)
}

// THE ROUTE'S DECISION PATH after the staged host observation, and the seam the hermetic
// real-driver controls exercise: given a pre-session standing (sessions pending), the node's
// model-only gates are decided first; only LaunchStageNeedsSessions lists tmux, so an unknown,
// contractless or blocked node is refused with tmux UNREACHABLE (under claim_batch's hermetic route
// an effect here is a route refusal, not a verdict — the control's oracle).
fn belt_dispatch_node_staged(
  instance: HostDashboardInstance,
  standing: LaunchHostStanding,
  node_id: String,
) -> BeltSpawnOutcome {
  belt_dispatch_node_staged_over(
    instance: instance,
    standing: standing,
    graph: launch_graph_of_projection(proj: roadmap_authority_projection()),
    merged: authored_merged_prs(),
    node_id: node_id,
  )
}

fn belt_dispatch_node_staged_over(
  instance: HostDashboardInstance,
  standing: LaunchHostStanding,
  graph: LaunchGraphStanding,
  merged: List<Int>,
  node_id: String,
) -> BeltSpawnOutcome {
  match (match launch_admission_staged(cause: Operator, standing: standing, graph: graph, merged: merged, node_id: node_id, reserved: 0) {
    LaunchStageDecided { admission } => admission
    LaunchStageNeedsSessions =>
      launch_admission(
        cause: Operator,
        standing: belt_launch_host_standing_complete(instance: instance, standing: standing),
        graph: graph,
        merged: merged,
        node_id: node_id,
        reserved: 0,
      )
  }) {
    LaunchRefused { refusal } => SpawnNotAdmitted { node_id: node_id, refusal: refusal }
    LaunchAdmitted { identity } =>
      match (match graph {
        LaunchGraphUnobserved { detail } => AuthorityProjectionRefused { detail: detail }
        LaunchGraphProjected { nodes, edges: _ } =>
          belt_find_node_in(nodes: nodes, node_id: node_id)
      }) {
        AuthorityProjectionRefused { detail } =>
          SpawnFailed {
            node_id: node_id,
            step: "node-model",
            detail: join(["admitted node's authority projection refused before spawn: ", detail], ""),
            provider: belt_dispatch_spawn_unselected_provider_wire_label(),
            launch: identity,
          }
        NodeMissing =>
          SpawnFailed {
            node_id: node_id,
            step: "node-model",
            detail: "admitted node is absent from the projection it was admitted against; fail-closed",
            provider: belt_dispatch_spawn_unselected_provider_wire_label(),
            launch: identity,
          }
        NodeFound { node } =>
          match clock_now_probed_at() {
            Present { value: probed_at } =>
              belt_actuate_spawn_for_instance(
                instance: instance,
                node: node,
                probed_at: probed_at as String,
                launch: identity,
              )
            Absent =>
              SpawnFailed {
                node_id: node_id,
                step: "attempt-clock",
                detail: "clock observation refused; an attempt without a stamp would collide with a later one — fail-closed, no unknown-stamped attempts",
                provider: belt_dispatch_spawn_unselected_provider_wire_label(),
                launch: identity,
              }
          }
      }
  }
}

fn belt_dispatch_node(node_id: String) -> BeltSpawnOutcome {
  belt_dispatch_node_for_instance(
    instance: srv1_live_dashboard_instance(),
    node_id: node_id,
  )
}

fn belt_dispatch_result_ok(r: BeltSpawnOutcome) -> Bool {
  dispatch_band_is_ok(b: belt_dispatch_result_band(r: r))
}

// The ONE wire vocabulary for a dispatch result (DESIGN §3, found live 2026-07-23): the served JSON
// `status` member and the roadmap page's client-side ok-check are two consumers of ONE label set —
// the dispatch button read a retired belt-A `{ok, node}` shape while belt B answered `{status,
// ...}`, so EVERY successful click rendered 'failed' (a silently-wrong UI answer, §5).
// belt_dispatch_status_label is the per-variant label authority consumed by
// belt_dispatch_result_json_value; belt_dispatch_ok_status_labels is the ok-subset the page derives
// its JS predicate from, glued to belt_dispatch_result_ok by witness (a label moved across the
// ok/refusal line without updating both surfaces goes RED).
fn belt_dispatch_status_label(r: BeltSpawnOutcome) -> String {
  match r {
    Spawned { node_id: _, session_name: _, provider: _, launch: _ } => "spawned"
    SpawnFailed { node_id: _, step: _, detail: _, provider: _, launch: _ } => "spawn_failed"
    SpawnNotAdmitted { node_id: _, refusal } => launch_refusal_label(r: refusal)
  }
}

fn belt_dispatch_disabled_status_label() -> String {
  launch_refusal_label(r: LaunchInstanceActuationRefused { instance_id: "label-exemplar", reason: "label-exemplar" })
}

// The operator-facing state vocabulary (operator ruling 2026-07-24, roadmap-workspace-remodel-plan
// W1a): the wire taxonomy is the belt's DIAGNOSTIC vocabulary and must not moonlight as button
// text. The operator reads BANDS, each a remedy class — ok: the click achieved or already holds the
// desired state; fail: this click cannot achieve it and the ROW is the remedy (wrong node, already
// signed off); loud: the BELT is unwell (observe refused, spawn failed — step/detail in the detail
// channel, never the caption). BandInProgress is inhabited only by the client's requested phase: no
// wire RESULT maps to it (no arm below produces it), so presentation cannot fabricate progress out
// of an answer. This fold is the SINGLE ok-authority — belt_dispatch_result_ok and
// belt_dispatch_ok_status_labels project it; the former hand copies (a Bool match, a hand list, a
// label predicate — three spellings of one fact) were the half-born-band defect this dissolves.
type DispatchBand
  = BandOk
  | BandInProgress
  | BandFail
  | BandLoud

fn launch_refusal_band(r: LaunchRefusal) -> DispatchBand {
  match r {
    LaunchAlreadyLive { session_name: _ } => BandOk
    LaunchNoActuatingInstance { reason: _ } => BandFail
    LaunchInstanceActuationRefused { instance_id: _, reason: _ } => BandFail
    LaunchNodeUnknown => BandFail
    LaunchNodeSuperseded { by: _ } => BandFail
    LaunchAlreadyAccepted => BandFail
    LaunchReviewRequired => BandFail
    LaunchSizeMissing => BandFail
    LaunchExecutionContractMissing { reason: _ } => BandFail
    LaunchDependenciesBlocked { blockers: _ } => BandFail
    LaunchNoCapacity { occupied: _, max_concurrent: _ } => BandFail
    LaunchCauseNotPermitted { cause: _, mode: _ } => BandFail
    LaunchTransitionInhibited { reason: _ } => BandLoud
    LaunchRevisionUnobserved { cause: _ } => BandLoud
    LaunchRevisionDrift { desired: _, local: _ } => BandLoud
    LaunchAuthorityUnobserved { detail: _ } => BandLoud
    LaunchSessionsUnobservable { reason: _ } => BandLoud
    LaunchStaleSession { session_name: _, detail: _ } => BandLoud
    LaunchLivenessUnobserved { session_name: _, reason: _ } => BandLoud
    LaunchSessionMultiplicityConflict { session_names: _, session_count: _ } => BandLoud
    LaunchGateNotEvaluated { gate: _ } => BandLoud
  }
}

fn belt_dispatch_result_band(r: BeltSpawnOutcome) -> DispatchBand {
  match r {
    Spawned { node_id: _, session_name: _, provider: _, launch: _ } => BandOk
    SpawnFailed { node_id: _, step: _, detail: _, provider: _, launch: _ } => BandLoud
    SpawnNotAdmitted { node_id: _, refusal } => launch_refusal_band(r: refusal)
  }
}

fn dispatch_band_key(b: DispatchBand) -> String {
  match b {
    BandOk => "ok"
    BandInProgress => "in-progress"
    BandFail => "fail"
    BandLoud => "loud"
  }
}

fn dispatch_band_is_ok(b: DispatchBand) -> Bool {
  match b {
    BandOk => true
    BandInProgress => false
    BandFail => false
    BandLoud => false
  }
}

fn belt_dispatch_ok_status_labels() -> List<String> {
  belt_dispatch_result_exemplars()
    |> filter(r => dispatch_band_is_ok(b: belt_dispatch_result_band(r: r)))
    |> map(r => belt_dispatch_status_label(r: r))
}

type DispatchLabelBandRow {
  wire_label: String
  band_key: String
}

fn belt_dispatch_label_band_rows() -> List<DispatchLabelBandRow> {
  map(belt_dispatch_result_exemplars(), r => DispatchLabelBandRow {
    wire_label: belt_dispatch_status_label(r: r),
    band_key: dispatch_band_key(b: belt_dispatch_result_band(r: r)),
  })
}

fn label_band_rows_cover(rows: List<DispatchLabelBandRow>, labels: List<String>) -> Bool {
  all(labels, l => count(filter(rows, row => row.wire_label == l)) == 1)
}

fn belt_dispatch_label_band_key(wire_label: String) -> String {
  match belt_dispatch_result_for_label(wire_label: wire_label) {
    Present { value: r } => dispatch_band_key(b: belt_dispatch_result_band(r: r))
    Absent => dispatch_band_key(b: BandLoud)
  }
}

// The full wire-label set, GROUNDED in belt_dispatch_status_label rather than hand-listed (§3): one
// exemplar per BeltDispatchResult variant mapped through the label authority. The exemplar roster
// is the single manual enumeration the closed variant set forces — the same one
// witness_dispatch_status_labels_pin_wire_contract pins — and is fail-closed twice: a NEW variant
// makes belt_dispatch_status_label's match non-exhaustive (compiler-caught), and
// gunbc.roadmap_component derives the DispatchButton's terminal states from THIS list and
// cross-checks totality both directions (label with no state row, state with no label — each red),
// so the button's state set cannot drift from the served contract. This is what the dispatch-button
// incident (2026-07-23) needed: one authority for the wire vocabulary, consumed by the JSON body,
// the page ok-predicate and the component state totality.
fn belt_dispatch_result_exemplars() -> List<BeltSpawnOutcome> {
  concat(
    [
      Spawned { node_id: "x", session_name: "s", provider: belt_dispatch_wire_contract_exemplar_provider, launch: launch_identity_exemplar() },
      SpawnFailed { node_id: "x", step: "s", detail: "d", provider: belt_dispatch_wire_contract_exemplar_provider, launch: launch_identity_exemplar() },
    ],
    map(launch_refusal_exemplars(), r => SpawnNotAdmitted { node_id: "x", refusal: r }),
  )
}

fn belt_dispatch_all_status_labels() -> List<String> {
  map(belt_dispatch_result_exemplars(), r => belt_dispatch_status_label(r: r))
}

fn belt_dispatch_result_for_label(wire_label: String) -> BeltSpawnOutcome? {
  belt_dispatch_result_exemplars()
    |> filter(r => belt_dispatch_status_label(r: r) == wire_label)
    |> first
}

fn belt_dispatch_label_is_ok(wire_label: String) -> Bool {
  any(belt_dispatch_ok_status_labels(), l => l == wire_label)
}

// The dispatch route prefix, part of the wire contract (the click POSTs to prefix+NODE_ID; belt B
// answers at the /dispatch/ NODE_ID route). Homed with the rest of the wire vocabulary (§3) so the
// client script builder (gunbc.roadmap_component) and the emitted server (node_http_server_emit)
// read one authority; moved off roadmap_page to break the page-to-component import cycle the
// TsProgram builder would otherwise create.
data belt_dispatch_path_prefix: String = "/dispatch/"

// Live production-selection introspection only — NOT the dispatch wire JSON authority.
// belt_dispatch_result_json_value reads the provider stamped on DispatchSpawned/DispatchSpawnFailed
// at construction time, so exemplars, sandbox echoes and post-selection receipts stay honest when
// standing refuses production re-query.
fn belt_dispatch_provider_label() -> String {
  match dispatch_actuator_selection(node_sizing: Unsized) {
    DispatchActuatorSelectionOk { provider, effort: _, process_fingerprint: _ } =>
      dispatch_provider_label(provider: provider)
    DispatchActuatorSelectionRefused { reason } =>
      concat("selection-refused: ", reason as String)
  }
}

data belt_dispatch_env_var: NonEmptyStr = "GUNBC_BELT_NODE_ID" as NonEmptyStr

// The ProcessExit entrypoint the roadmap-UI launch button drives. gunbc run --function cannot pass
// an argument (no --arg flag), so the node id enters through the environment: the Node HTTP server
// on srv1 shells env GUNBC_BELT_NODE_ID=NODE gunbc run --function belt_dispatch_node_cli, read via
// shell.Env.Get (the env-read authority github.auth uses for its token). Fail-closed on the
// channel: missing OR empty GUNBC_BELT_NODE_ID refuses — shell.Env.Get returns Present-but-empty
// for an unset var wet, so empty folds into the Absent refusal. Exit map: DispatchSpawned or
// DispatchAlreadyLive -> ExitSuccess (the click achieved or already holds the desired state); every
// refusal or failure (node_not_found, already_done, observe_refused, spawn_failed) -> exit_failure
// with the JSON receipt on stderr, so the server relays the exact cause.
fn belt_dispatch_node_cli() -> ProcessExit {
  match shell.Env.Get(name: belt_dispatch_env_var).value {
    Absent =>
      exit_failure(reason: "belt_dispatch_node_cli: GUNBC_BELT_NODE_ID not set — no node id to dispatch (fail-closed)")
    Present { value: v } =>
      if string_length(s: v) == 0 {
        exit_failure(reason: "belt_dispatch_node_cli: GUNBC_BELT_NODE_ID is empty — no node id to dispatch (fail-closed)")
      } else {
        let r = belt_dispatch_node(node_id: v)
        if belt_dispatch_result_ok(r: r) {
          ExitSuccess
        } else {
          exit_failure(reason: serialize_json(v: belt_spawn_outcome_json(o: r)))
        }
      }
  }
}

// THE PRODUCER, WITHOUT WHICH THE PUBLICATION LAMP CANNOT MOVE. Observer, adjudicator, receipt
// format, decoder, path and workflow projection all existed before this function and none ever ran,
// because nothing wrote a receipt: a tick read an absent file and reported Pending forever,
// indistinguishable from a correct answer — why the gap survived several reviews.
//
// THE DECISION IS SEPARATED FROM THE THREE EFFECTS, as roadmap_publish is from
// roadmap_publish_observe. belt_publish_decide takes what the read found, what the observation
// concluded and what the write reported, and returns the outcome; belt_publish_attempt_for_instance
// performs read, observation and write and calls it. Every arm — already recorded, undecodable
// evidence, a receipt about another subject, an unwritable receipt — is reachable in a hermetic
// witness from constructed values, the only way an arm that fires once a year gets proven.
//
// IT READS BEFORE WRITING, and an unreadable existing receipt REFUSES rather than being
// overwritten: the belt must not destroy evidence it cannot see. The address differs from the
// verify producer: verification writes one receipt per attempt, publication one per head, so
// re-running against a recorded head is a no-op while a new head opens a new round.
//
// OBSERVATION FAILURE PERSISTS A REFUSED RECEIPT rather than aborting. Aborting before any receipt
// exists would leave the workflow showing ordinary Pending, so an unavailable credential and a
// genuinely unpublished branch would look identical — the absence-versus-refusal collapse this lane
// removes, reappearing at the outermost boundary. A refusal is a fact about an attempt and belongs
// on disk with the others.
//
// THE OBSERVATION IS NO LONGER PERFORMED HERE — the one structural change to this producer. It used
// to read the receipt, call GitHub and write; it now reads the receipt, hands a typed request to
// the publication helper across a Unix-principal boundary, and writes the receipt the helper
// answered with. The three-effect decomposition is unchanged in shape, but the middle effect is a
// spool write and read rather than a network call, because a process that spawns provider sessions
// must not hold a publication token. gunbc.roadmap_publication_helper carries that argument;
// PublishRequested is the state between the two, a named outcome rather than a silence for the same
// reason every other arm here is.
type BeltPublishOutcome
  = PublishRecorded {
      node_id: String,
      head_sha: String,
      outcome_key: String,
    }
  | PublishAlreadyRecorded { node_id: String, head_sha: String }
  | PublishEvidenceUnreadable { node_id: String, detail: String }
  | PublishWriteFailed { node_id: String, detail: String }
  | PublishDeferred { node_id: String, reason: String }
  | PublishRequested { node_id: String, head_sha: String, request_path: String }

// expected_base IS main FOR THIS BELT — a deployment fact, not a default. adjudicate_publication
// uses the base to decide which pull requests are candidates at all, so two runs with different
// bases can reach different outcomes about one head; the value belongs in the subject, is recorded
// in the receipt, and is compared when a consumer checks it.
//
// It must not become a parameter nobody supplies: threading it up the belt produces a call chain
// where every caller passes the same literal — spelling-repeated-N-times, not one authority. When a
// roadmap node can target a base other than the repository default, this reads that fact from the
// node; the receipt already records what was used, so the change is visible in the evidence.
fn belt_publication_subject_for(
  node_id: String,
  attempt_key: String,
  branch: String,
  head: WorktreeHeadObservation,
) -> PublicationSubjectObservation {
  match head {
    WorktreeHeadUnobserved { reason } =>
      PublicationSubjectUnobserved {
        reason: join([
          "publication is adjudicated against an exact head and this attempt has none: ",
          reason,
        ], ""),
      }
    WorktreeHeadObserved { revision } =>
      if trim(branch) == "" {
        PublicationSubjectUnobserved {
          reason: "the attempt has no branch name, so there is nothing to look for on the remote",
        }
      } else {
        PublicationSubjectObserved {
          subject: RoadmapPublicationSubject {
            node_id: node_id,
            attempt_key: attempt_key,
            repository: gunbc_repository,
            branch: branch as NonEmptyStr,
            expected_base: gunbc_repository.default_branch as NonEmptyStr,
            expected_head: revision as CommitSha,
          },
        }
      }
  }
}

data belt_publish_gate_note: String = "THE GATE DECIDES WHETHER TO OBSERVE AT ALL, WHICH IS WHY IT IS PURE AND WHY IT RUNS FIRST. Three of the five outcomes are settled entirely by what is already on disk - the head is on offer, the record does not decode, the record is about someone else - and none of them should cost a network read or risk a write. Deciding them before the effect is what makes them reachable in a witness from constructed values; deciding them after would make the arms untestable and would perform a GitHub read to learn something the filesystem already said.\\n\\nONLY A SETTLED RECEIPT HALTS, AND GETTING THIS WRONG WOULD HAVE FROZEN THE LAMP. The obvious idempotence key is `a receipt exists for this head`, and it is wrong: the belt ticks continuously, so the FIRST observation of a head usually happens before the worker has pushed. That observation is a perfectly good judgment - branch-not-published - and storing it as final would pin the row to `not published` forever, with every later tick halting on the very receipt that recorded the branch's absence. The negative answer would outlive the fact it described.\\n\\nSo the key is whether the receipt says the head is ON OFFER (publication_receipt_offers_the_expected_head, the same predicate a downstream obligation asks). Every other outcome is a snapshot of remote state that has not stopped moving, so the next tick re-observes and replaces it. That is not destroying evidence: it is the same question re-asked, and nothing downstream builds on a snapshot that answered no.\\n\\nA RECEIPT ABOUT ANOTHER SUBJECT AT THIS HEAD'S OWN ADDRESS IS NOT OVERWRITTEN, and that halt is unconditional. The address contains the head, so a mismatch here means something wrote a receipt for a different node, attempt, repository or base into this head's slot. That is unexplained state, and the belt's move on unexplained state is to stop rather than to correct it - overwriting would destroy the only evidence that it happened."

type BeltPublishGate
  = PublishProceed
  | PublishHalted { outcome: BeltPublishOutcome }

fn belt_publish_gate(
  node_id: String,
  subject: RoadmapPublicationSubject,
  existing: PublicationReceiptSource,
) -> BeltPublishGate {
  match publication_evidence_for(expected: subject, source: existing) {
    EvidenceAbsent => PublishProceed
    EvidenceForSubject { receipt } =>
      if publication_receipt_offers_the_expected_head(outcome: receipt.outcome) {
        PublishHalted {
          outcome: PublishAlreadyRecorded {
            node_id: node_id,
            head_sha: subject.expected_head as String,
          },
        }
      } else {
        PublishProceed
      }
    EvidenceUnreadable { reason } =>
      PublishHalted {
        outcome: PublishEvidenceUnreadable {
          node_id: node_id,
          detail: join([
            "a publication receipt for this head could not be read or does not decode, so the belt refuses to replace evidence it cannot read: ",
            reason,
          ], ""),
        },
      }
    EvidenceForAnotherSubject { field, expected, found } =>
      PublishHalted {
        outcome: PublishEvidenceUnreadable {
          node_id: node_id,
          detail: join([
            "a publication receipt at this head's own address is about another subject (",
            field as String, " expected ", expected, ", found ", found,
            "), which the belt refuses to overwrite because the mismatch is itself evidence of a state nobody has explained",
          ], ""),
        },
      }
  }
}

fn belt_publish_write_outcome(
  node_id: String,
  subject: RoadmapPublicationSubject,
  receipt: PublicationReceipt,
  write_success: Bool,
  write_error: String,
) -> BeltPublishOutcome {
  if write_success {
    PublishRecorded {
      node_id: node_id,
      head_sha: subject.expected_head as String,
      outcome_key: publication_receipt_outcome_key(outcome: receipt.outcome) as String,
    }
  } else {
    PublishWriteFailed {
      node_id: node_id,
      detail: join([
        "the publication receipt could not be written, so the judgment was reached and then lost: ",
        write_error,
      ], ""),
    }
  }
}

fn belt_publish_attempt_for_instance(
  instance: HostDashboardInstance,
  node_id: String,
  attempt_key: String,
) -> BeltPublishOutcome {
  let attempt_worktree = dispatch_worktree_path_for_instance(
    instance: instance,
    node_id: node_id as gunbc.roadmap_model.RoadmapNodeId,
    attempt_key: attempt_key,
  )
  match belt_publication_subject_for(
    node_id: node_id,
    attempt_key: attempt_key,
    branch: dispatch_branch_name(
      node_id: node_id as gunbc.roadmap_model.RoadmapNodeId,
      attempt_key: attempt_key,
    ),
    head: belt_worktree_head_observe(
      instance: instance,
      worktree: attempt_worktree,
    ),
  ) {
    PublicationSubjectUnobserved { reason } =>
      PublishDeferred { node_id: node_id, reason: reason }
    PublicationSubjectObserved { subject } => {
      match observe_worktree_repository_binding(
        worktree: attempt_worktree,
        repo: subject.repository,
      ) {
        WorktreeRemoteUnreadable { exit_code: code, stderr: err } =>
          PublishEvidenceUnreadable {
            node_id: node_id,
            detail: join([
              "the attempt worktree's origin remote could not be read, so it is unknown whether the head being published came from this repository (git exit ",
              to_string(code), "): ", err,
            ], ""),
          }
        WorktreeBoundElsewhere { observed: observed, expected: expected } =>
          PublishEvidenceUnreadable {
            node_id: node_id,
            detail: join([
              "the attempt worktree is a checkout of a different repository, so its head is not evidence about this subject — origin is ",
              observed, " but this publication is about ", expected as String,
            ], ""),
          }
        WorktreeBoundToRepository => {
          let path = dispatch_attempt_publication_receipt_path_for_instance(
            instance: instance,
            node_id: node_id as gunbc.roadmap_model.RoadmapNodeId,
            attempt_key: attempt_key,
            head_sha: subject.expected_head as String,
          )
          match belt_publish_gate(
            node_id: node_id,
            subject: subject,
            existing: belt_publication_receipt_source(
              instance: instance,
              node_id: node_id as gunbc.roadmap_model.RoadmapNodeId,
              attempt_key: attempt_key,
              subject: PublicationSubjectObserved { subject: subject },
            ),
          ) {
            PublishHalted { outcome } => outcome
            PublishProceed =>
              match publication_answer_standing(
                instance_root: instance.instance_root as String,
                subject: subject,
              ) {
                AnswerSpoolRefused { reason } =>
                  PublishEvidenceUnreadable {
                    node_id: node_id,
                    detail: join([
                      "the publication helper's spool refused, so it is unknown whether this head has been published: ",
                      reason,
                    ], ""),
                  }
                AnswerAwaited { request_path } =>
                  PublishRequested {
                    node_id: node_id,
                    head_sha: subject.expected_head as String,
                    request_path: request_path,
                  }
                AnswerReady { receipt } => {
                  let write = Filesystem.Write(
                    path: path,
                    content: publication_receipt_json(receipt: receipt),
                  )
                  belt_publish_write_outcome(
                    node_id: node_id,
                    subject: subject,
                    receipt: receipt,
                    write_success: write.success,
                    write_error: write.error,
                  )
                }
              }
          }
        }
      }
    }
  }
}

fn belt_publish_pass_outcome_from(outcomes: List<BeltPublishOutcome>) -> BeltPassOutcome {
  let ledger_refusals = outcomes |> filter(o => match o {
    PublishDeferred { node_id: nid, reason: _ } => nid == ""
    PublishRequested { node_id: _, head_sha: _, request_path: _ } => false
    PublishWriteFailed { node_id: _, detail: _ } => false
    PublishEvidenceUnreadable { node_id: _, detail: _ } => false
    PublishRecorded { node_id: _, head_sha: _, outcome_key: _ } => false
    PublishAlreadyRecorded { node_id: _, head_sha: _ } => false
  })
  if count(ledger_refusals) > 0 {
    match ledger_refusals.first() {
      Present { value: PublishDeferred { node_id: _, reason: r } } =>
        BeltPassRefused { reason: r }
      _ =>
        BeltPassRefused { reason: "the attempts ledger is unobservable" }
    }
  } else {
    if any(outcomes, o => match o {
      PublishWriteFailed { node_id: _, detail: _ } => true
      PublishEvidenceUnreadable { node_id: _, detail: _ } => true
      PublishDeferred { node_id: _, reason: _ } => false
      PublishRequested { node_id: _, head_sha: _, request_path: _ } => false
      PublishRecorded { node_id: _, head_sha: _, outcome_key: _ } => false
      PublishAlreadyRecorded { node_id: _, head_sha: _ } => false
    }) {
      BeltPassFailed { reason: "one or more publication outcomes could not be recorded" }
    } else {
      BeltPassRecorded
    }
  }
}

fn belt_verification_segment(progress: WorkflowAttemptProgress) -> WorkflowSegment? {
  fold(progress.segments, init: none, f: (acc, s) => match acc {
    Present { value: v } => Present { value: v }
    Absent =>
      match s.kind {
        VerificationWorkflowSegment => Present { value: s }
        _ => none
      }
  })
}

fn belt_verification_presentation_detail(
  progress: WorkflowAttemptProgress,
  tick_read: BeltTickReceiptRead,
) -> String {
  match belt_verification_segment(progress: progress) {
    Present { value: segment } =>
      match segment.state {
        WorkflowSegmentComplete =>
          join(["Verification passed · ", segment.detail], "")
        WorkflowSegmentFailed =>
          join(["Verification failed · ", segment.detail], "")
        WorkflowSegmentRefused =>
          join(["Verification refused · ", segment.detail], "")
        WorkflowSegmentActive =>
          join(["Verification running · ", progress.validation_summary], "")
        WorkflowSegmentPending =>
          match tick_read {
            BeltTickReceiptPresent { receipt } =>
              match receipt.verify_pass {
                BeltPassRefused { reason: r } =>
                  join(["Verification blocked · ", r], "")
                BeltPassFailed { reason: r } =>
                  join(["Verification failed · ", r], "")
                BeltPassDeferred { reason: _ } =>
                  "Verification queued - next belt tick"
                BeltPassRecorded =>
                  if string_contains(s: segment.detail, pattern: "could not be read") {
                    join(["Verification refused · ", segment.detail], "")
                  } else {
                    join(["Verification queued - next belt tick · ", segment.detail], "")
                  }
              }
            BeltTickReceiptAbsent =>
              "Verification queued - next belt tick"
            BeltTickReceiptUnreadable { reason: r } =>
              join(["Verification blocked · belt tick receipt unreadable: ", r], "")
          }
      }
    Absent =>
      "Verification unobserved"
  }
}

// THE EXECUTION STANDING IS OBSERVED AT THE MINT SITE from the instance the tick ran for and the
// revision standing of that instance's tree -- the same admitted_revision_standing read the
// dispatch preflight makes, against the same per-instance admitting ref, because a tick receipt
// that answered from a different authority than the gate would report a revision the gate never
// admitted -- and the mode is the production row the tick itself consumed. A drifted or
// unobservable revision withholds the binding rather than recording a revision the tick did not
// serve.
fn belt_tick_execution_standing_for_instance(
  instance: HostDashboardInstance,
  mode: SpawnMode,
) -> BeltTickExecutionStanding {
  match admitted_revision_standing(
    repo: instance.repo_root,
    remote: instance.admitted_revision.remote,
    ref_name: instance.admitted_revision.ref_name,
  ) {
    RevisionConverged { revision: r } =>
      TickExecuted {
        instance_id: instance.instance_id as String,
        deployed_revision: git_object_id_wire_hex(oid: r) as String,
        spawn_mode: mode,
      }
    RevisionDrifted { desired: d, local: l } =>
      TickExecutionWithheld {
        refusal: join([
          "revision drifted: desired ", git_object_id_wire_hex(oid: d) as String,
          " local ", git_object_id_wire_hex(oid: l) as String,
        ], ""),
      }
    RevisionUnobserved { cause: c } =>
      TickExecutionWithheld { refusal: join(["revision unobserved: ", c], "") }
  }
}

fn belt_tick_receipt_from_result(
  result: BeltTickResult,
  observed_at: String,
  execution: BeltTickExecutionStanding,
) -> BeltTickReceipt {
  BeltTickReceipt {
    observed_at: observed_at,
    execution: execution,
    launches: belt_tick_launch_identities(outcomes: result.spawn_outcomes),
    spawn_pass: (match result.wholesale {
      TickPassesWithheld { refusal } => BeltPassRefused { reason: launch_refusal_reason(r: refusal) }
      TickPassesRun => belt_spawn_pass_outcome_from(host_refusal: result.host_refusal, spawn_outcomes: result.spawn_outcomes)
    }),
    teardown_pass: (match result.wholesale {
      TickPassesWithheld { refusal } => BeltPassRefused { reason: launch_refusal_reason(r: refusal) }
      TickPassesRun => belt_teardown_pass_outcome_from(host_refusal: result.host_refusal, teardown_outcomes: result.teardown_outcomes)
    }),
    verify_pass: (match result.wholesale {
      TickPassesWithheld { refusal } => BeltPassRefused { reason: launch_refusal_reason(r: refusal) }
      TickPassesRun => belt_verify_pass_outcome_from(outcomes: result.verify_outcomes)
    }),
    publish_pass: (match result.wholesale {
      TickPassesWithheld { refusal } => BeltPassRefused { reason: launch_refusal_reason(r: refusal) }
      TickPassesRun => belt_publish_pass_outcome_from(outcomes: result.publish_outcomes)
    }),
  }
}

data belt_publish_pass_note: String = "PUBLICATION RUNS ON THE SAME TICK AS SPAWN, TEARDOWN AND VERIFY, because it is the same kind of fact: a desired obligation reconciled against an observed one. A producer nobody calls is the defect this lane keeps producing - every piece of the publication path existed before this pass and none of it ever ran - so the wiring is the deliverable, not the type.\\n\\nIT RUNS PER ATTEMPT, OVER THE SAME OBSERVED LEDGER VERIFY USES, and it does NOT wait for the agent to finish. That is the difference from the verify pass and it is deliberate: verification is an action taken ON the attempt, so running it early would burn a validation against an unfinished tree, while publication is an OBSERVATION of the remote, so running it early records the true state - the branch is not published yet - and the next tick revises it. The gate is what makes that safe, since only a receipt saying the head is on offer stops the revisions.\\n\\nTHE TICK HOLDS NO CREDENTIAL AT ALL, and that is what this pass gave up in exchange for the publication boundary. It used to probe GITHUB_TOKEN once per tick and hand the source to every attempt; it now writes a typed request per attempt and reads the answer the publication helper wrote under its own principal. The cost is that a head is published on the SECOND tick that sees it rather than the first, which is a latency the belt already tolerates everywhere else - the first observation of a head is usually before the worker has pushed anyway. The gain is that no process holding this token spawns a provider session. See gunbc.roadmap_publication_helper for the boundary argument."

fn belt_publish_attempts_for_instance(
  instance: HostDashboardInstance,
) -> List<BeltPublishOutcome> {
  match belt_workflow_attempts_observe_for_instance(instance: instance) {
    WorkflowAttemptsRefused { reason } =>
      [
        PublishDeferred {
          node_id: "",
          reason: join([
            "the attempts ledger is unobservable, so no attempt's publication can be adjudicated: ",
            reason,
          ], ""),
        },
      ]
    WorkflowAttemptsObserved { attempts } => {
      map(attempts, progress => belt_publish_attempt_for_instance(
        instance: instance,
        node_id: progress.node_id,
        attempt_key: progress.attempt_key,
      ))
    }
  }
}

fn belt_publish_attempts() -> List<BeltPublishOutcome> {
  belt_publish_attempts_for_instance(
    instance: srv1_live_dashboard_instance(),
  )
}

// THE PRODUCER NEEDS A LIVE TRIGGER, AND belt_tick IS NOT ONE. belt_tick is the belt's actuation
// pass and nothing calls it — not the serve routes, a timer or the CLI. A pre-existing gap shared
// with the verification pass, wired into the same tick and equally undriven; this lane neither
// created nor closes it.
//
// So wiring publication into belt_tick alone would leave the receipt unproduced in production, the
// exact defect the recut fixes, one layer out. Publication therefore also gets a per-node entry the
// serve table can reach, mirroring belt_dispatch_node_for_instance: an operator presses it, the
// receipt is written, the next read of the row paints from it.
//
// IT RESOLVES THE ATTEMPT ITSELF rather than taking one, because the caller is a route holding only
// a node id. The current attempt pointer is the authority the workflow projection reads, so both
// answer about the same attempt by construction rather than by a matching key.
//
// OBSERVE-ONLY INSTANCES REFUSE, like dispatch: publication performs a network read and a
// filesystem write against an instance's own attempt state, so an observe-only instance must do
// neither — and the refusal names the posture rather than reporting an absence.
fn belt_publish_node_for_instance(
  instance: HostDashboardInstance,
  node_id: String,
) -> BeltPublishOutcome {
  match instance.actuation {
    DashboardObserveOnly =>
      PublishDeferred {
        node_id: node_id,
        reason: join([
          "dashboard instance ",
          instance.instance_id as String,
          " is observe-only, so publication was neither observed nor recorded",
        ], ""),
      }
    DashboardActuating =>
      match belt_transition_admission_for_instance(instance: instance) {
        ActuationRefused { reason: tr } =>
          PublishDeferred {
            node_id: node_id,
            reason: join([belt_publish_transition_inhibited_reason, " ", tr], ""),
          }
        ActuationAdmitted => {
      let key_read = Filesystem.Read(
        path: dispatch_current_attempt_key_path_for_instance(
          instance: instance,
          node_id: node_id as gunbc.roadmap_model.RoadmapNodeId,
        ),
      )
      if !key_read.success || trim(key_read.content) == "" {
        PublishDeferred {
          node_id: node_id,
          reason: "this node has no current attempt, so there is no branch or head for publication to be about",
        }
      } else {
        belt_publish_attempt_for_instance(
          instance: instance,
          node_id: node_id,
          attempt_key: trim(key_read.content),
        )
      }
    }
      }
  }
}

// THE WIRE CARRIES THE OUTCOME KEY THE RECEIPT RECORDED, not a rendering of it. A caller that
// pressed publish wants to know which judgment was reached, and re-deriving that from a sentence is
// the prose-parsing the receipt format was rewritten to remove. The detail is beside it for a
// human, never instead.
//
// THE STATUS CODES SPLIT ON WHO HAS TO ACT. A recorded judgment and an already-recorded one are
// both 200: the belt did what was asked and the row is accurate. A deferral is 409 — well formed,
// but the attempt is not in a state where publication means anything yet. Unreadable evidence and a
// failed write are 500: the belt's own problem, and nothing about the request would change them.
//
// A REQUESTED PUBLICATION IS 202, NEITHER OF THE OTHER TWO. Not 200 — nothing has been judged, and
// 200 for a merely queued request is fabricated-plausible-output at the route boundary. Not 409 — a
// deferral says publication MEANS nothing yet, while a request says the question is well formed,
// asked, and will be answered by the publication helper on its next run. Different destinations for
// the operator, so different codes.
fn belt_publish_outcome_key(o: BeltPublishOutcome) -> String {
  match o {
    PublishRecorded { node_id: _, head_sha: _, outcome_key: _ } => "recorded"
    PublishAlreadyRecorded { node_id: _, head_sha: _ } => "already-recorded"
    PublishEvidenceUnreadable { node_id: _, detail: _ } => "evidence-unreadable"
    PublishWriteFailed { node_id: _, detail: _ } => "write-failed"
    PublishDeferred { node_id: _, reason: _ } => "deferred"
    PublishRequested { node_id: _, head_sha: _, request_path: _ } => "requested"
  }
}

fn belt_publish_outcome_node_id(o: BeltPublishOutcome) -> String {
  match o {
    PublishRecorded { node_id, head_sha: _, outcome_key: _ } => node_id
    PublishAlreadyRecorded { node_id, head_sha: _ } => node_id
    PublishEvidenceUnreadable { node_id, detail: _ } => node_id
    PublishWriteFailed { node_id, detail: _ } => node_id
    PublishDeferred { node_id, reason: _ } => node_id
    PublishRequested { node_id, head_sha: _, request_path: _ } => node_id
  }
}

fn belt_publish_outcome_head_sha(o: BeltPublishOutcome) -> String {
  match o {
    PublishRecorded { node_id: _, head_sha, outcome_key: _ } => head_sha
    PublishAlreadyRecorded { node_id: _, head_sha } => head_sha
    PublishRequested { node_id: _, head_sha, request_path: _ } => head_sha
    PublishEvidenceUnreadable { node_id: _, detail: _ } => ""
    PublishWriteFailed { node_id: _, detail: _ } => ""
    PublishDeferred { node_id: _, reason: _ } => ""
  }
}

fn belt_publish_outcome_publication_key(o: BeltPublishOutcome) -> String {
  match o {
    PublishRecorded { node_id: _, head_sha: _, outcome_key } => outcome_key
    PublishAlreadyRecorded { node_id: _, head_sha: _ } => ""
    PublishRequested { node_id: _, head_sha: _, request_path: _ } => ""
    PublishEvidenceUnreadable { node_id: _, detail: _ } => ""
    PublishWriteFailed { node_id: _, detail: _ } => ""
    PublishDeferred { node_id: _, reason: _ } => ""
  }
}

fn belt_publish_outcome_detail(o: BeltPublishOutcome) -> String {
  match o {
    PublishRecorded { node_id: _, head_sha: _, outcome_key: _ } => ""
    PublishAlreadyRecorded { node_id: _, head_sha: _ } => ""
    PublishRequested { node_id: _, head_sha: _, request_path } =>
      join([
        "a publication request for this head is queued for the publication helper and has not yet been answered: ",
        request_path,
      ], "")
    PublishEvidenceUnreadable { node_id: _, detail } => detail
    PublishWriteFailed { node_id: _, detail } => detail
    PublishDeferred { node_id: _, reason } => reason
  }
}

fn belt_publish_outcome_http_status(o: BeltPublishOutcome) -> Int {
  match o {
    PublishRecorded { node_id: _, head_sha: _, outcome_key: _ } => 200
    PublishAlreadyRecorded { node_id: _, head_sha: _ } => 200
    PublishDeferred { node_id: _, reason: _ } => 409
    PublishRequested { node_id: _, head_sha: _, request_path: _ } => 202
    PublishEvidenceUnreadable { node_id: _, detail: _ } => 500
    PublishWriteFailed { node_id: _, detail: _ } => 500
  }
}

fn belt_publish_outcome_json_value(o: BeltPublishOutcome) -> JsonValue {
  json_object(members: [
    json_kv(key: "schema", value: json_string(s: "roadmap-belt-publish/v1")),
    json_kv(key: "outcome", value: json_string(s: belt_publish_outcome_key(o: o))),
    json_kv(key: "node_id", value: json_string(s: belt_publish_outcome_node_id(o: o))),
    json_kv(key: "head_sha", value: json_string(s: belt_publish_outcome_head_sha(o: o))),
    json_kv(
      key: "publication",
      value: json_string(s: belt_publish_outcome_publication_key(o: o)),
    ),
    json_kv(key: "detail", value: json_string(s: belt_publish_outcome_detail(o: o))),
  ])
}
