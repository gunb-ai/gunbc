// Slice 2b actuation: the belt DECISION (gunbc.roadmap.roadmap_belt.belt_reconcile) is CLOSED against the
// host by three single-authorities — the actuator's HostExecArgv argv model
// (gunbc.roadmap.roadmap_dispatch_actuator, the one place git/tmux/provider argv is shaped),
// gunbc.WitnessBin.Run (typed-argv exec, no shell string) and shell.PosixCommandV.Check (presence
// probe; migrated off shell.Which.Check, crisp-wren-896, PR #8590 — srv1's OperatingSystemSurface
// carries no package-set authority, so the weaker POSIX-shell assumption dominates). Provider is a
// closed ClaudeCodeProvider | CodexCliProvider choice whose argv, preflight and pane fingerprint
// move together. Fail-closed: which-miss or auth uncertainty refuses before git worktree add; a
// worktree failure short-circuits tmux spawn; a nonzero provider process after tmux accepted is
// runtime evidence, not spawn evidence, never absorbed into Spawned.
data belt_actuate_placement_dissolution_trigger: Disposition = Scaffold {
  dissolves_to: RealizationDispatch,
  bind: DeclarationRef {
    module_path: "gunbc.roadmap.roadmap_dispatch_actuator",
    decl_name: "classify_dispatch_lease_upsert",
    field: WholeDeclaration
  }
}

data belt_actuate_fingerprint_dissolution_trigger: Disposition = Scaffold {
  dissolves_to: RealizationDispatch,
  bind: DeclarationRef {
    module_path: "gunbc.roadmap.roadmap_dispatch_actuator",
    decl_name: "dispatch_tmux_process_fingerprint_observation_dissolution_trigger",
    field: WholeDeclaration
  }
}

data belt_actuate_workdir_note: String = "Two DISTINCT workdirs, because the belt's two host verbs bind to different roots (a §5 fail-open otherwise: observing from a repo path that may not exist on an arbitrary host would make `tmux ls` fail and — before this split — get widened to an empty session set). belt_actuate_workdir is the SPAWN root: `git worktree add` must run inside the gunbc repo — a PROJECTION of gunbc.host.host_layout.srv1_gunbc_repo_root (the single path authority; its former private copy deleted, DESIGN §3): the same tree `gunbc serve` loads, which is why dispatch works in-process. belt_observe_workdir is the host-global root '/': `tmux ls` and `tmux kill-session` act on the per-user tmux server (a host singleton, not a repo), so they must run from a directory guaranteed to exist on the host — never the repo path, which may be absent (fake-claude test box, a freshly-enrolled srvN). Observe/teardown therefore carry no workdir parameter; only spawn is workdir-parameterized."

data belt_actuate_workdir: FilePath = srv1_gunbc_repo_root

data belt_observe_workdir: FilePath = "/" as FilePath

type BeltExecOutcome
  = ExecOk { stdout: String }
  | ExecFailed { program: String, exit_code: Int, stderr: String }
  | ExecRefused { program: String, reason: String }

// THE RESULT OF TRYING TO ARM A RE-DELIVERY WAKE. A host exec of systemd-run has a fourth outcome the
// generic ExecOk/ExecFailed/ExecRefused shape cannot express: systemd-run REFUSES to start a unit whose
// name is already loaded ('Unit ... already exists'). Because the wake's name fixes the one re-delivery
// instant it targets, that refusal means the exact wake is ALREADY armed -- idempotence, not failure --
// while every other nonzero exit stays a real failure carrying exit code and stderr (DESIGN §5: no
// plausible output fabricated, the diagnostic located). Recognition lives in extdeps.systemd
// (systemd_run_reported_unit_already_exists), not as a bare string test here.
type BeltWakeArm
  = WakeArmed
  | WakeAlreadyArmed
  | WakeArmFailed { program: String, exit_code: Int, stderr: String }
  | WakeArmRefused { program: String, reason: String }

// CLASSIFY A WAKE-ARMING HOST EXEC. Pure: it reads a BeltExecOutcome the caller already has and the wake
// unit stem (the identity systemd echoes on the already-exists refusal) and returns the outcome the fold
// reports. A same-name start is WakeAlreadyArmed only when systemd-run names THIS stem; anything else is
// a real failure with exit code and stderr kept.
fn belt_redelivery_wake_arm(exec: BeltExecOutcome, unit_stem: NonEmptyStr) -> BeltWakeArm {
  match exec {
    ExecOk { stdout: _ } => WakeArmed
    ExecFailed { program, exit_code, stderr } =>
      if systemd_run_reported_unit_already_exists(stderr: stderr, unit_stem: unit_stem) {
        WakeAlreadyArmed
      } else {
        WakeArmFailed { program: program, exit_code: exit_code, stderr: stderr }
      }
    ExecRefused { program, reason } => WakeArmRefused { program: program, reason: reason }
  }
}

// Probe via shell.PosixCommandV.Check exit_success (Bool), NOT .path: the .path realization is a
// bare-stdout string wet (the Optional-over-Value::Null realization fork — DESIGN open thread), so
// the belt keys on the exit Bool and lets WitnessBin.Run's `env -C {workdir} {bin_path} args`
// resolve the bare program via PATH (env execvp). 'program missing' (refuse) stays distinct from
// 'present, exited nonzero' (fail) without touching the Optional straddle. Migrated off
// shell.Which.Check (crisp-wren-896, PR #8590): srv1's OperatingSystemSurface has
// distro_or_product: none, so `which` was never an established fact; command -v's strictly weaker
// assumption dominates.
// This module's probes are annotated OutcomeIsData (operator ruling 2026-07-25): their exit codes
// are ANSWERS the belt adjudicates, not faults. belt_program_available's which-miss is the 'program
// missing' pole belt_program_available_note keeps distinct from 'present but exited nonzero';
// belt_exec's nonzero exit becomes ExecFailed; belt_observe's a typed BeltObserve arm. Each is
// rendered loudly by the belt's per-variant status mapping, so the effect layer's anomaly glyph was
// a second, cruder judgment. ADMISSIBILITY (§5 guard, gunbc.output_policy outcome_is_data_note):
// each annotated fn returns a typed value whose arms ARE the adjudication — Bool for the
// availability probe (consumed as the refuse/fail discriminator, never discarded), BeltExecOutcome,
// BeltObserve — never unit. Dispatch failure is not an exit code, stays anomalous, and does not
// travel this arm.
fn belt_program_available(program: String) -> Bool {
  shell.PosixCommandV.Check(command: program as NonEmptyStr, expect: OutcomeIsData).exists
}

fn belt_exec(cmd: HostExecArgv, workdir: String) -> BeltExecOutcome {
  if belt_program_available(program: cmd.program) {
    let result = gunbc.WitnessBin.Run(
      workdir: workdir as FilePath,
      bin_path: cmd.program as FilePath,
      args: cmd.args,
      expect: OutcomeIsData,
    )
    if result.success {
      ExecOk { stdout: result.stdout }
    } else {
      ExecFailed { program: cmd.program, exit_code: result.exit_code, stderr: result.stderr }
    }
  } else {
    ExecRefused {
      program: cmd.program,
      reason: "belt_exec: program not found on PATH (which exit nonzero); fail-closed, no fabricated success",
    }
  }
}

// Fail-closed sequencing: the fold runs each argv in order and SHORT-CIRCUITS on the first non-ok
// step (ExecFailed/ExecRefused) — belt_exec is NOT called for the rest. Spawn's worktree-add ->
// tmux-new-session ordering rides this: a failed git worktree add never spawns a tmux session on a
// missing worktree. Discriminating control: without the ExecOk-guarded short-circuit, [false, echo]
// would run echo and go green.
fn belt_exec_all(cmds: List<HostExecArgv>, workdir: String) -> BeltExecOutcome {
  fold(cmds, init: ExecOk { stdout: "" }, f: fn(acc, cmd) {
    match acc {
      ExecOk { stdout: _ } => belt_exec(cmd: cmd, workdir: workdir)
      ExecFailed { program: _, exit_code: _, stderr: _ } => acc
      ExecRefused { program: _, reason: _ } => acc
    }
  })
}

type BeltExecStep {
  step: String
  command: HostExecArgv
}

type BeltExecStepsOutcome
  = ExecStepsOk
  | ExecStepFailed { step: String, detail: String }

// What creating the session container answers. The tmux container's steps are all synchronous, so
// they fold to Ok or Failed through belt_exec_steps; the systemd unit container enqueues a start
// request on the attempt-unit spool and reads its answer ONCE, so it alone can answer Pending.
type BeltContainerCreateOutcome
  = ContainerCreated
  | ContainerCreatePending { entry: String }
  | ContainerCreateFailed { step: String, detail: String }

fn belt_exec_steps(
  steps: List<BeltExecStep>,
  workdir: String,
) -> BeltExecStepsOutcome {
  fold(steps, init: ExecStepsOk, f: fn(acc, step) {
    match acc {
      ExecStepFailed { step: _, detail: _ } => acc
      ExecStepsOk =>
        match belt_exec(cmd: step.command, workdir: workdir) {
          ExecOk { stdout: _ } => ExecStepsOk
          ExecFailed { program: _, exit_code, stderr } =>
            ExecStepFailed {
              step: step.step,
              detail: join([
                "exit ", to_string(exit_code), ": ", stderr,
              ], ""),
            }
          ExecRefused { program: _, reason } =>
            ExecStepFailed { step: step.step, detail: reason }
        }
    }
  })
}

type AttemptStateInitialization
  = AttemptStateInitialized
  | AttemptStateInitializationFailed { step: String, detail: String }

// A modeled attempt publishes an immutable evidence prefix before provider launch: after worktree
// and state-directory creation the serve process writes the attempt key, the alignment binding (the
// resolved chain's fingerprint at this attempt's identity), the exact grounded
// environment-admission JSON receipt and an empty provider-events.jsonl via typed Filesystem.Write,
// then replaces the node-current symlink. The replace may be briefly unreadable; the observer
// reports refusal and retries next poll — no atomicity is claimed for `ln -sfnT`. A readable
// current attempt is constructive proof that admission, workspace creation and event-capture
// initialization preceded launch; the progress route validates the admitted receipt rather than
// inferring stages from a tmux name.
fn belt_attempt_state_initialize_for_instance(
  instance: HostDashboardInstance,
  node: RoadmapNode,
  attempt_key: String,
  admission_receipt: String,
  launch: LaunchIdentity,
  binding: AlignmentBinding,
  request: AttemptLaunchRequest,
  process_fingerprint: NonEmptyStr,
  executor: DispatchExecutorOrigin,
) -> AttemptStateInitialization {
  let key_write = Filesystem.Write(
    path: dispatch_attempt_key_path_for_instance(
      instance: instance,
      node_id: node.node,
      attempt_key: attempt_key,
    ),
    content: attempt_key,
  )
  let binding_write = Filesystem.Write(
    path: dispatch_attempt_alignment_binding_path_for_instance(
      instance: instance,
      node_id: node.node,
      attempt_key: attempt_key,
    ),
    content: alignment_binding_text(binding: binding),
  )
  if !key_write.success {
    AttemptStateInitializationFailed {
      step: "attempt-key-write",
      detail: key_write.error,
    }
  } else if !binding_write.success {
    AttemptStateInitializationFailed {
      step: "attempt-alignment-binding-write",
      detail: binding_write.error,
    }
  } else if !Filesystem.Write(
    path: dispatch_attempt_process_fingerprint_path_for_instance(
      instance: instance,
      node_id: node.node,
      attempt_key: attempt_key,
    ),
    content: process_fingerprint as String,
  ).success {
    AttemptStateInitializationFailed {
      step: "attempt-process-fingerprint-write",
      detail: "the spawn's selected process fingerprint could not be recorded in the attempt state",
    }
  } else {
    let admission_write = Filesystem.Write(
      path: dispatch_attempt_admission_path_for_instance(
        instance: instance,
        node_id: node.node,
        attempt_key: attempt_key,
      ),
      content: admission_receipt,
    )
    if !admission_write.success {
      AttemptStateInitializationFailed {
        step: "attempt-admission-write",
        detail: admission_write.error,
      }
    } else {
    let launch_write = Filesystem.Write(
      path: dispatch_attempt_launch_path_for_instance(
        instance: instance,
        node_id: node.node,
        attempt_key: attempt_key,
      ),
      content: serialize_json(v: attempt_launch_record_json(id: launch, attempt_key: attempt_key as NonEmptyStr)),
    )
    if !launch_write.success {
      AttemptStateInitializationFailed {
        step: "attempt-launch-write",
        detail: launch_write.error,
      }
    } else {
      match dispatch_attempt_events_initialize_for_instance(
        instance: instance,
        node_id: node.node,
        attempt_key: attempt_key,
      ) {
      DispatchAttemptEventsInitializationFailed { detail: events_detail } =>
        AttemptStateInitializationFailed {
          step: "attempt-events-initialize",
          detail: events_detail,
        }
      DispatchAttemptEventsInitialized => {
        let receipt_initialized = Filesystem.Write(
          path: dispatch_attempt_validation_receipt_path_for_instance(
            instance: instance,
            node_id: node.node,
            attempt_key: attempt_key,
          ),
          content: validation_receipt_json(
            verdict: ValidationNotRun,
            observations: belt_oracle_observations_in_worktree(
              contract: node.execution,
              worktree: dispatch_worktree_path_for_instance(
                instance: instance,
                node_id: node.node,
                attempt_key: attempt_key,
              ),
            ),
          ),
        ).success
        if !receipt_initialized {
          AttemptStateInitializationFailed {
            step: "attempt-validation-receipt-initialize",
            detail: "the not-run validation receipt could not be written beside the attempt; without it a later unreadable receipt is indistinguishable from an absent one, which is the conflation this initialization exists to remove",
          }
        } else {
          match belt_persist_oracle_pin_for_instance(
            instance: instance,
            node: node,
            attempt_key: attempt_key,
            capture: belt_attempt_oracle_pin_capture_for_instance(
              instance: instance,
              node: node,
              attempt_key: attempt_key,
            ),
          ) {
            OraclePinPersisted =>
              match belt_persist_spawn_origin_for_instance(
                instance: instance,
                node: node,
                attempt_key: attempt_key,
                executor: executor,
              ) {
                SpawnOriginRecorded =>
                  match attempt_request_binding_commit_for_instance(instance: instance, node_id: node.node, attempt_key: attempt_key, request: request) {
                    RequestBindingCommitted { binding: _ } => AttemptStateInitialized
                    RequestBindingCommitRefused { step, detail } =>
                      AttemptStateInitializationFailed { step: step, detail: detail }
                  }
                SpawnOriginRecordFailed { step, detail } =>
                  AttemptStateInitializationFailed { step: step, detail: detail }
              }
            OraclePinSpawnRefused { reason } =>
              AttemptStateInitializationFailed {
                step: "validation-oracle-pin",
                detail: reason,
              }
            OraclePinPersistWriteFailed { detail } =>
              AttemptStateInitializationFailed {
                step: "attempt-oracle-pin-persist",
                detail: detail,
              }
          }
        }
      }
      }
    }
  }
    }
}

type SpawnOriginRecord
  = SpawnOriginRecorded
  | SpawnOriginRecordFailed { step: String, detail: String }

fn belt_persist_spawn_origin_for_instance(
  instance: HostDashboardInstance,
  node: RoadmapNode,
  attempt_key: String,
  executor: DispatchExecutorOrigin,
) -> SpawnOriginRecord {
  match node_dispatch_destination(node: node) {
    DispatchDestinationMissing { reason } =>
      SpawnOriginRecordFailed {
        step: "spawn-destination",
        detail: reason as String,
      }
    DispatchDestinationResolved { identity } => {
      let worktree = dispatch_worktree_path_for_instance(
        instance: instance,
        node_id: node.node,
        attempt_key: attempt_key,
      )
      match belt_worktree_head_observe(instance: instance, worktree: worktree) {
        WorktreeHeadUnobserved { reason } =>
          SpawnOriginRecordFailed {
            step: "spawn-base-sha",
            detail: join([
              "spawn refuses to proceed without recording the base SHA: ",
              reason,
            ], ""),
          }
        WorktreeHeadObserved { revision } => {
          let origin = DispatchSpawnOrigin {
            identity: identity,
            base_ref: instance.dispatch_base_ref,
            base_sha: revision as NonEmptyStr,
            executor: executor,
          }
          let write = Filesystem.Write(
            path: dispatch_attempt_spawn_origin_path_for_instance(
              instance: instance,
              node_id: node.node,
              attempt_key: attempt_key,
            ),
            content: dispatch_spawn_origin_json(origin: origin),
          )
          if write.success {
            SpawnOriginRecorded
          } else {
            SpawnOriginRecordFailed {
              step: "spawn-destination-write",
              detail: write.error,
            }
          }
        }
      }
    }
  }
}

// The pin is captured from the FRESHLY CREATED WORKTREE before the provider spawns — the only
// moment the oracle is known to be the base revision's, not the attempt's. The controller repo is a
// tree nothing ties to this attempt; reading after the agent runs is the fail-open this lane
// closes. The staged spawn already orders it: worktree-add and attempt-state-prepare first, this
// capture inside state initialization, session-container create after.
//
// A PIN REFUSAL ON THAT WORKTREE FAILS THE SPAWN. That is not "the oracle pin refusal
// precedes effects." What has already run: worktree-add, the attempt branch, and the
// attempt-state writes before this capture. What is still saved: the seat, the model
// turn, the provider process. An earlier ask against instance.repo_root is NOT the same
// observation: the controller tree and the admitted-base worktree can disagree, which is
// the #11021 class (the guard protects a different object than the harm travels through).
// belt_spawn_oracle_pin_standing_production_consumer_frontier is the typed standing for that
// admitted-base-before-enqueue consumer; the fold is not a controller-tree gate and is not
// the live spawn caller. Verify-side validation_oracle_gate is unchanged.
type AttemptOraclePinCapture
  = OraclePinRecorded {
      identity: ContentHash,
      revision: String,
    }
  | OraclePinNotRecorded { reason: String }

// This projection used filter_map, which type-checks and DOES NOT RUN: std.primitives declares the
// contract but the seed registers no method, so the call reached the interpreter as `not yet
// implemented` and the dispatch route 500'd. Found by a live lab dispatch, not the whole-tree
// compile (0 blocking errors) nor this lane's witnesses — DESIGN section 5's
// specification-without-execution one layer below where this PR watched: MY functions were checked
// as exercised, the PRIMITIVES they call never. The corpus had zero filter_map call sites before.
// flat_map is the same fold with a registered implementation; a one-or-zero element list is exactly
// the Present/none the contract described.
fn belt_oracle_refs_for_contract(
  contract: WorkItemExecutionContract,
) -> List<ValidationOracleRef> {
  validation_oracle_scopes(contract: contract)
    |> flat_map(scope => match scope {
      OraclePinnable { oracle } => [oracle]
      OracleNotPinnable { validation_label: _, reason: _ } => []
    })
}

fn belt_oracle_observe_in_worktree(
  worktree: String,
  oracle: ValidationOracleRef,
) -> OracleObservation {
  let read = Filesystem.Read(
    path: join([worktree, "/", oracle.entry as String], ""),
  )
  validation_oracle_observe_from_source(
    oracle: oracle,
    source_read: filesystem_read_outcome(content: read.content, success: read.success, error: read.error),
  )
}

fn belt_oracle_observations_in_worktree(
  contract: WorkItemExecutionContract,
  worktree: String,
) -> List<OracleObservation> {
  belt_oracle_refs_for_contract(contract: contract)
    |> map(oracle => belt_oracle_observe_in_worktree(
      worktree: worktree,
      oracle: oracle,
    ))
}

data worktree_head_observation_note: String = "THE REVISION READ NOW CARRIES WHY IT FAILED, AND THE STRING PROJECTION SURVIVES AS A PROJECTION. belt_worktree_head_revision collapsed all three exec arms to the empty string, and its one consumer tested `== \\\"\\\"`, which was adequate exactly because the consumer's two branches took the same action either way.\\n\\nPublication cannot use it, and the reason is the point rather than an inconvenience. Publication is adjudicated against an EXACT HEAD; if the head cannot be read there is no subject, and a consumer with no subject cannot check a receipt against one. That state has to say what happened - git missing, git refused, worktree gone - because the operator's next action differs in each case, and because a Publication lamp that reads `unknown` must be able to prove it is not reading `unpublished`.\\n\\nSO THE TYPED OBSERVATION IS THE AUTHORITY AND THE STRING IS DERIVED FROM IT. Not a second reader: one exec, one decision function, and belt_worktree_head_revision becomes a two-line projection over it. Adding a parallel typed reader beside the string one would have been the fork this corpus keeps paying for.\\n\\nEMPTY STDOUT IS UNOBSERVED, NOT OBSERVED-AS-EMPTY. git rev-parse HEAD exits zero and prints nothing in cases this belt can reach - an unborn HEAD in a freshly created worktree is the ordinary one - so a zero exit is not by itself proof that a revision was read. Casting that empty string into a CommitSha would produce a subject whose head matches no commit and compares equal to any other empty head, which is the branded-empty defect empty_branch_projection_note describes on the ref side."

type WorktreeHeadObservation
  = WorktreeHeadObserved { revision: NonEmptyStr }
  | WorktreeHeadUnobserved { reason: String }

fn worktree_head_observation_of(outcome: BeltExecOutcome) -> WorktreeHeadObservation {
  match outcome {
    ExecOk { stdout } =>
      if trim(stdout) == "" {
        WorktreeHeadUnobserved {
          reason: "git reported no revision for HEAD, which a worktree whose branch has no commit yet will do without failing",
        }
      } else {
        WorktreeHeadObserved { revision: trim(stdout) as NonEmptyStr }
      }
    ExecFailed { program, exit_code, stderr } =>
      WorktreeHeadUnobserved {
        reason: join([
          program, " could not read the worktree head (exit ", to_string(exit_code), "): ", stderr,
        ], ""),
      }
    ExecRefused { program, reason } =>
      WorktreeHeadUnobserved {
        reason: join([program, " was not available to read the worktree head: ", reason], ""),
      }
  }
}

fn belt_worktree_head_observe(
  instance: HostDashboardInstance,
  worktree: String,
) -> WorktreeHeadObservation {
  worktree_head_observation_of(
    outcome: belt_exec(
      cmd: host_exec_argv(
        program: dispatch_capability_program(
          environment: instance.execution_environment,
          cap: GitWorkspaceCapability,
        ),
        args: shape_git_rev_parse_head_args(),
      ),
      workdir: worktree,
    ),
  )
}

fn belt_worktree_head_revision(
  instance: HostDashboardInstance,
  worktree: String,
) -> String {
  match belt_worktree_head_observe(instance: instance, worktree: worktree) {
    WorktreeHeadObserved { revision } => revision as String
    WorktreeHeadUnobserved { reason: _ } => ""
  }
}

fn belt_verify_detached_worktree(
  instance: HostDashboardInstance,
  node_id: RoadmapNodeId,
  attempt_key: String,
  head_sha: String,
) -> String {
  let checkout_path = dispatch_verification_checkout_path_for_instance(
    instance: instance,
    node_id: node_id,
    attempt_key: attempt_key,
    head_sha: head_sha,
  )
  match belt_worktree_head_observe(instance: instance, worktree: checkout_path) {
    WorktreeHeadObserved { revision } =>
      if (revision as String) == head_sha {
        checkout_path
      } else {
        ""
      }
    WorktreeHeadUnobserved { reason: _ } =>
      match belt_exec(
        cmd: git_worktree_add_detached_argv_for_instance(
          instance: instance,
          worktree_path: checkout_path,
          commit_sha: head_sha,
        ),
        workdir: instance.repo_root as String,
      ) {
        ExecOk { stdout: _ } => checkout_path
        ExecFailed { program: _, exit_code: _, stderr: _ } => ""
        ExecRefused { program: _, reason: _ } => ""
      }
  }
}

fn belt_verify_detached_worktree_refusal(
  instance: HostDashboardInstance,
  node_id: RoadmapNodeId,
  attempt_key: String,
  head_sha: String,
) -> String {
  let checkout_path = dispatch_verification_checkout_path_for_instance(
    instance: instance,
    node_id: node_id,
    attempt_key: attempt_key,
    head_sha: head_sha,
  )
  match belt_worktree_head_observe(instance: instance, worktree: checkout_path) {
    WorktreeHeadObserved { revision } =>
      join([
        "a verification checkout already exists at ",
        checkout_path,
        " but its head is ",
        revision as String,
        " instead of the observed ",
        head_sha,
      ], "")
    WorktreeHeadUnobserved { reason: _ } =>
      match belt_exec(
        cmd: git_worktree_add_detached_argv_for_instance(
          instance: instance,
          worktree_path: checkout_path,
          commit_sha: head_sha,
        ),
        workdir: instance.repo_root as String,
      ) {
        ExecOk { stdout: _ } => ""
        ExecFailed { program, exit_code, stderr } =>
          join([
            program,
            " could not create a detached verification checkout at ",
            head_sha,
            " (exit ",
            to_string(exit_code),
            "): ",
            stderr,
          ], "")
        ExecRefused { program, reason } =>
          join([
            program,
            " was not available to create a detached verification checkout: ",
            reason,
          ], "")
      }
  }
}

fn belt_oracle_pin_not_observable_reason(tree: String) -> String {
  join([
    "the declared validation oracle was not observable in the named tree at ",
    tree,
  ], "")
}

data belt_spawn_oracle_pin_standing_production_consumer_frontier: FrontierRow = frontier_row_decl(
  ref: decl_ref(module_path: "gunbc.roadmap.roadmap_belt_actuate", decl_name: "belt_spawn_oracle_pin_standing"),
  reason: "live spawn refuses via belt_attempt_oracle_pin_capture_for_instance after worktree-add; belt_spawn_oracle_pin_standing is not on that path",
  dissolution: unbound_dissolution(
    description: "a production fold on the POST /dispatch or belt-intent-admission path calls belt_spawn_oracle_pin_standing with observations of the exact admitted-base Git objects. Not satisfied by belt_dispatch_node existing, nor by a witness constructing OracleMissing / OracleFound, nor by re-binding spawn to instance.repo_root"
  ),
)

type BeltSpawnOraclePinStanding
  = SpawnOraclePinAdmitted
  | SpawnOraclePinRefused { reason: String }

fn belt_spawn_oracle_pin_standing(
  contract: WorkItemExecutionContract,
  observations: List<OracleObservation>,
  tree: String,
) -> BeltSpawnOraclePinStanding {
  if count(belt_oracle_refs_for_contract(contract: contract)) == 0 {
    SpawnOraclePinAdmitted
  } else {
    match validation_oracle_set_observe(observations: observations) {
      OracleSetIncomplete { blocking: _, observations: _ } =>
        SpawnOraclePinRefused {
          reason: belt_oracle_pin_not_observable_reason(tree: tree),
        }
      OracleSetObserved { identity: _, observations: _ } =>
        SpawnOraclePinAdmitted
    }
  }
}

fn belt_attempt_oracle_pin_capture_for_instance(
  instance: HostDashboardInstance,
  node: RoadmapNode,
  attempt_key: String,
) -> AttemptOraclePinCapture {
  let worktree = dispatch_worktree_path_for_instance(
    instance: instance,
    node_id: node.node,
    attempt_key: attempt_key,
  )
  let refs = belt_oracle_refs_for_contract(contract: node.execution)
  if count(refs) == 0 {
    OraclePinNotRecorded {
      reason: "this node's execution contract declares no validation whose oracle can be pinned",
    }
  } else {
    match validation_oracle_set_observe(
      observations: belt_oracle_observations_in_worktree(
        contract: node.execution,
        worktree: worktree,
      ),
    ) {
      OracleSetIncomplete { blocking: _, observations: _ } =>
        OraclePinNotRecorded {
          reason: belt_oracle_pin_not_observable_reason(tree: worktree),
        }
      OracleSetObserved { identity, observations: _ } => {
        let revision = belt_worktree_head_revision(
          instance: instance,
          worktree: worktree,
        )
        if revision == "" {
          OraclePinNotRecorded {
            reason: "the attempt worktree's head revision could not be read, so the pinned oracle could not be attributed to a revision",
          }
        } else {
          OraclePinRecorded {
            identity: identity,
            revision: revision,
          }
        }
      }
    }
  }
}

type OraclePinPersist
  = OraclePinPersisted
  | OraclePinSpawnRefused { reason: String }
  | OraclePinPersistWriteFailed { detail: String }

fn belt_persist_oracle_pin_for_instance(
  instance: HostDashboardInstance,
  node: RoadmapNode,
  attempt_key: String,
  capture: AttemptOraclePinCapture,
) -> OraclePinPersist {
  match capture {
    OraclePinNotRecorded { reason } => {
      let wrote = Filesystem.Write(
        path: dispatch_attempt_oracle_pin_refusal_path_for_instance(
          instance: instance,
          node_id: node.node,
          attempt_key: attempt_key,
        ),
        content: reason,
      )
      if !wrote.success {
        OraclePinPersistWriteFailed { detail: wrote.error }
      } else if count(belt_oracle_refs_for_contract(contract: node.execution)) == 0 {
        OraclePinPersisted
      } else {
        OraclePinSpawnRefused { reason: reason }
      }
    }
    OraclePinRecorded { identity, revision } => {
      let identity_write = Filesystem.Write(
        path: dispatch_attempt_oracle_identity_path_for_instance(
          instance: instance,
          node_id: node.node,
          attempt_key: attempt_key,
        ),
        content: serialize_content_hash(hash: identity) as String,
      )
      let revision_write = Filesystem.Write(
        path: dispatch_attempt_oracle_revision_path_for_instance(
          instance: instance,
          node_id: node.node,
          attempt_key: attempt_key,
        ),
        content: revision,
      )
      if identity_write.success && revision_write.success {
        OraclePinPersisted
      } else {
        OraclePinPersistWriteFailed {
          detail: "the validation oracle pin could not be written beside the attempt; an attempt whose oracle is unrecorded can never be verified, and the write itself failing is a state-directory fault rather than a verification-side deficit",
        }
      }
    }
  }
}

// THE TWO EXECUTION PHASES A CONTAINER NEEDS, kept as two because the belt already treats them
// differently: the CREATE step is the one whose failure means no container exists to clean up,
// while a failure in the START steps leaves a created container that must be torn down. Splitting
// by phase rather than by step count is what lets a single-step container and a four-step one share
// that error handling unchanged.
//
// The systemd container does all its work in the create step -- a transient unit is started with
// its command, its properties and its output redirection in one call -- so its start phase is
// empty. An empty step list is executed as a no-op by belt_exec_steps, which is the honest encoding
// of "this container has nothing further to do", not a skipped check.
type BeltCredentialAdmit
  = BeltCredentialAdmitOk
  | BeltCredentialAdmitLost { detail: String }

fn belt_credential_admit_before_spawn(prepared: PreparedAttemptLaunch) -> BeltCredentialAdmit {
  match prepared_attempt_launch_alternative(prepared: prepared) {
    SnapshotFreeLaunch { attempt: _, executor: _ } => BeltCredentialAdmitOk
    SnapshotLaunch { snapshot } =>
      match credential_admit_reader_or_discard(snapshot: snapshot) {
        CredentialLaunchAdmitted => BeltCredentialAdmitOk
        LaunchLostSnapshotDiscarded =>
          BeltCredentialAdmitLost { detail: "begin_launch lost; snapshot discarded" }
        LaunchLostDiscardFailed { reason: r } =>
          BeltCredentialAdmitLost { detail: r as String }
      }
  }
}

// THE WORKER'S REACH IS ESTABLISHED BEFORE ANYTHING IS CLAIMED FOR THE UNIT. A unit whose worker uid
// cannot traverse an ancestor of a handed path fails at start (200/CHDIR) with the worker never
// having run, after the credential snapshot, placement grant and request have been consumed. This
// refuses first, so no placement record is written and no start request is enqueued.
// The tmux container runs as the controller itself and hands no User=, so only a unit container
// climbs.
fn belt_worker_traversal_outcome(reach: DispatchWorkerTraversal) -> BeltExecStepsOutcome {
  match reach {
    DispatchWorkerTraversalAdmitted => ExecStepsOk
    DispatchWorkerAncestorNotTraversable { worker: _, handed_path: _, blocking_dir: _, observed_owner: _, observed_mode: _ } =>
      ExecStepFailed { step: "worker-traversal", detail: dispatch_worker_traversal_wire(reach: reach) }
    DispatchWorkerTraversalCouldNotLook { worker: _, handed_path: _, subject: _, reason: _ } =>
      ExecStepFailed { step: "worker-traversal", detail: dispatch_worker_traversal_wire(reach: reach) }
  }
}

fn belt_worker_traversal_before_spawn(instance: HostDashboardInstance, container: DispatchSessionContainer) -> BeltExecStepsOutcome {
  match container {
    TmuxSessionContainer { spawn: _, default_shell: _, remain_on_exit: _, event_pipe: _, provider_start: _ } => ExecStepsOk
    SystemdUnitContainer { plan } =>
      match belt_worker_traversal_outcome(reach: dispatch_worker_traversal_for_plan(instance: instance, plan: plan)) {
        ExecStepFailed { step: s, detail: d } => ExecStepFailed { step: s, detail: d }
        ExecStepsOk => belt_worker_created_paths_outcome(verdict: dispatch_unit_created_paths_judge(created: dispatch_worker_created_paths(instance: instance, plan: plan)))
      }
  }
}

// The producer-side half of the same boundary: the paths the system manager creates for the unit must
// be usable by their consumers (gunbc.roadmap.dispatch_unit_created_paths). Pure over declared
// principals, so it needs no observation; it refuses before the placement record and the enqueue.
fn belt_worker_created_paths_outcome(verdict: DispatchUnitCreatedPathVerdict) -> BeltExecStepsOutcome {
  match verdict {
    DispatchUnitCreatedPathConsumable => ExecStepsOk
    DispatchUnitCreatedPathUnconsumable { created: _ } =>
      ExecStepFailed { step: "worker-created-path", detail: dispatch_unit_created_path_wire(verdict: verdict) }
  }
}

fn belt_session_container_create(
  instance: HostDashboardInstance,
  attempt_key: String,
  container: DispatchSessionContainer,
  placement: BeltHeldPlacement?,
  workdir: String,
) -> BeltContainerCreateOutcome {
  match container {
    TmuxSessionContainer {
      spawn,
      default_shell: _,
      remain_on_exit: _,
      event_pipe: _,
      provider_start: _,
    } =>
      match belt_exec_steps(steps: [BeltExecStep { step: "tmux-session-create", command: spawn }], workdir: workdir) {
        ExecStepsOk => ContainerCreated
        ExecStepFailed { step, detail } => ContainerCreateFailed { step: step, detail: detail }
      }
    SystemdUnitContainer { plan } =>
      match placement {
        Absent =>
          ContainerCreateFailed {
            step: "session-placement",
            detail: "the worker unit was reached with no placement grant; belt_session_placement_for_container acquires one for every unit container, so this refuses rather than starting the unit at the instance ceiling",
          }
        Present { value: held } => {
          let properties = dispatch_worker_unit_properties_for_plan(instance: instance, plan: plan, granted: held.grant.amount, process_bounds: session_process_bounds)
          match systemd_run_property_assignments(properties: properties) {
            SystemdRunPropertyAssignmentsRefused { cause: why } =>
              ContainerCreateFailed { step: "session-placement-record", detail: systemd_run_option_words_refused_cause_detail(cause: why) }
            SystemdRunPropertyAssignmentsReady { assignments: property_texts } =>
          match session_placement_record_write(stores: held.stores, host: instance.host_identity as String, grant: held.grant, unit_properties: property_texts) {
            SessionPlacementWriteFailed { path, error } =>
              ContainerCreateFailed { step: "session-placement-record", detail: join(["the placement record could not be written at ", path, ": ", error], "") }
            SessionPlacementWritten { path: _ } =>
              match session_placement_begin_launch(stores: held.stores, grant: held.grant) {
                SessionLaunchRefused { detail } => ContainerCreateFailed { step: "session-launch-gate", detail: detail }
                SessionLaunchAdmitted { grant: launched } =>
                  match attempt_system_unit_enqueue_start(
                    instance_root: instance.instance_root as String,
                    request: attempt_system_unit_start_request_from_plan(
                      plan: plan,
                      granted: launched.amount,
                      nonce: to_string(value: cas_generation_count(g: launched.slot_generation)),
                    ),
                  ) {
                    AttemptSystemUnitEnqueueRefused { detail } =>
                      ContainerCreateFailed { step: "harness-unit-start", detail: detail }
                    AttemptSystemUnitEnqueueOccupied { entry } =>
                      ContainerCreateFailed {
                        step: "harness-unit-start",
                        detail: join(["a request for this attempt already exists at ", entry], ""),
                      }
                    AttemptSystemUnitEnqueued { entry, body } =>
                      match attempt_system_unit_harness_start_from_observation(
                        entry: entry,
                        reading: attempt_system_unit_read_answer(
                          instance_root: instance.instance_root as String,
                          entry: entry,
                          request_body: body,
                        ),
                      ) {
                        AttemptSystemUnitHarnessStarted => ContainerCreated
                        AttemptSystemUnitHarnessPending { entry: pending } => ContainerCreatePending { entry: pending }
                        AttemptSystemUnitHarnessFailed { detail } =>
                          ContainerCreateFailed { step: "harness-unit-start", detail: detail }
                      }
                  }
              }
          }
          }
        }
      }
  }
}

// G5: A UNIT CONTAINER ACQUIRES ITS PLACEMENT BEFORE ANY HOST STEP RUNS, so a refusal leaves no
// worktree, no attempt state and no current pointer behind -- it is a launch refusal
// (LaunchNoPlacementGrant), not a spawn that failed halfway. The session slot it opens first is what
// makes every later crash recoverable (gunbc.roadmap.roadmap_session_placement). A tmux container holds no
// placement: its panes escape any unit's cgroup, which is that module's declared frontier.
type BeltHeldPlacement {
  grant: SessionPlacementGrant
  stores: SessionPlacementStores
}

type BeltSessionPlacement
  = BeltPlacementHeld { held: BeltHeldPlacement }
  | BeltPlacementNotHeld
  | BeltPlacementRefused { detail: String }

fn belt_session_placement_for_container(instance: HostDashboardInstance, node_id: String, attempt_key: String, container: DispatchSessionContainer, resume: Bool) -> BeltSessionPlacement {
  match container {
    TmuxSessionContainer { spawn: _, default_shell: _, remain_on_exit: _, event_pipe: _, provider_start: _ } => BeltPlacementNotHeld
    SystemdUnitContainer { plan: _ } =>
      match session_placement_stores(instance: instance) {
        SessionStoresUnresolved { detail } => BeltPlacementRefused { detail: detail }
        SessionStoresResolved { stores } =>
          match belt_session_slots_ensure(instance: instance, stores: stores) {
            Present { value: why } => BeltPlacementRefused { detail: why }
            Absent =>
              match session_placement_acquire(instance: instance, stores: stores, node_id: node_id, attempt_key: attempt_key, resume: resume) {
                SessionPlacementGranted { grant } => BeltPlacementHeld { held: BeltHeldPlacement { grant: grant, stores: stores } }
                SessionPlacementRefused { detail } => BeltPlacementRefused { detail: detail }
              }
          }
      }
  }
}

// THE SLOT STORE IS CREATED BY THE SAME CAPABILITY THAT CREATES ATTEMPT STATE, before the settlement
// pass reads it and before any slot is opened in it, so "the store is missing" never has to be told
// apart from "the store could not be listed" by reading an error string. Present carries the refusal.
fn belt_session_slots_ensure(instance: HostDashboardInstance, stores: SessionPlacementStores) -> String? {
  match belt_exec(
    cmd: host_exec_argv(
      program: dispatch_capability_program(environment: instance.execution_environment, cap: AttemptStateDirectoryCapability),
      args: ["-d", "-m", "0700", stores.slots_root as String],
    ),
    workdir: belt_observe_workdir as String,
  ) {
    ExecOk { stdout: _ } => none
    ExecFailed { program, exit_code, stderr } => Present { value: join(["the session slot store ", stores.slots_root as String, " could not be created (", program, " exit ", to_string(exit_code), "): ", stderr], "") }
    ExecRefused { program, reason } => Present { value: join(["the session slot store ", stores.slots_root as String, " could not be created (", program, "): ", reason], "") }
  }
}

// G5 SETTLEMENT IS ITS OWN PASS, ORDERED BEFORE EVERY NEW ACQUISITION (ruling on #13074, findings 1
// and 2). It starts from the session slot store, not from the workflow ledger or from anything a
// spawn meant to do, so it finds a grant whose spawning process died at any point -- and the tick's
// spawn pass is computed inside an exhaustive match on its result, so the settlement is on the
// returned computation's dependency path rather than an unused binding.
fn belt_session_settlement_pass(instance: HostDashboardInstance) -> SessionSettlePass {
  match session_placement_stores(instance: instance) {
    SessionStoresUnresolved { detail } => SessionSettlePassRefused { detail: detail }
    SessionStoresResolved { stores } =>
      match belt_session_slots_ensure(instance: instance, stores: stores) {
        Present { value: why } => SessionSettlePassRefused { detail: why }
        Absent => {
          let worker_pass = belt_worktree_claim_ensure(instance: instance, stores: stores, settled: session_activation_ensure_after_settlement(instance: instance, stores: stores, settled: session_placement_settle_pass(instance: instance, stores: stores)))
          // THE TICK SETTLES BOTH ROLES' HOLDS. A reviewer's hold must not wait for a spawn to be
          // freed -- a tick that neither spawns nor settles keeps the slice full of the dead. A
          // refusal of the reviewer store is recorded as a finding INSIDE the ran pass rather than
          // refusing the whole settlement: the worker's holds release independently of the
          // reviewer's store, and one class's unreadable ledger does not pause the other's.
          match belt_reviewer_settlement_pass(instance: instance) {
            SessionSettlePassRan { settlements: reviewer_settlements } =>
              match worker_pass {
                SessionSettlePassRan { settlements: worker_settlements } => SessionSettlePassRan { settlements: concat(worker_settlements, reviewer_settlements) }
                SessionSettlePassRefused { detail } => SessionSettlePassRefused { detail: join([detail, "; reviewer pass ran: ", session_settle_pass_wire(p: SessionSettlePassRan { settlements: reviewer_settlements })], "") }
              }
            SessionSettlePassRefused { detail: rd } =>
              match worker_pass {
                SessionSettlePassRan { settlements: worker_settlements } =>
                  SessionSettlePassRan { settlements: concat(worker_settlements, [SessionSettlementKept { unit: "reviewer-settlement-pass", why: join(["the reviewer settlement pass could not run, so no reviewer hold was released this tick: ", rd], "") }]) }
                SessionSettlePassRefused { detail } => SessionSettlePassRefused { detail: join([detail, "; reviewer pass: ", rd], "") }
              }
          }
        }
      }
  }
}

// THE WORKTREE RESTORE, an explicit named ACTUATION on the spawn route run BEFORE the continuation decision,
// for the one state the old settlement mangled: a request-pending/resumable lineage whose worktree was reclaimed
// (its claim's generation line reads terminal:recovered, 'the attempt ended and its capture is committed') but
// whose DISPATCH BRANCH survives. It is NOT hidden inside the capture observation -- an observation that repairs
// what it reads is the §5 hidden-actuation smell -- it is a visible step returning a typed outcome. It fires only
// when (a) the recovery reading says request-pending/resumable, (b) the worktree path is absent, and (c) the
// branch exists; it re-materializes the worktree from that branch (`git worktree add` on the existing branch) and
// reopens the reclaimed claim on the SAME CAS slot (worktree_claim_reopen_settled, generation line kept, no
// delete). The branch is the durable record (§3b), so this RESTORES state rather than guessing; a gone branch
// fails closed (BranchAbsent) rather than spawning on an unknown tree. With D1/D2 no longer releasing a pending
// claim, this step only ever sees the legacy reaped state -- it is recovery, not a second release path.
type AttemptWorktreeRestore
  = AttemptWorktreeRestored { worktree_path: String, branch: String }
  | AttemptWorktreeNotNeeded
  | AttemptWorktreeBranchAbsent { branch: String, detail: String }
  | AttemptWorktreeRestoreRefused { detail: String }

// THE CLAIM SUB-STEP'S OWN OUTCOME. It only ever ensures that an OPEN claim names the worktree path, so it does not
// borrow AttemptWorktreeRestore's 'nothing to do' / 'branch absent' variants -- reusing that type for two roles would
// force the sub-step to fake outcomes it cannot produce (§3: a name held constant may not carry two meanings).
type WorktreeClaimEnsure
  = ClaimEnsured
  | ClaimEnsureRefused { detail: String }

// ENSURE AN OPEN CLAIM NAMES THE RE-MATERIALIZED WORKTREE. A reclaimed (terminal) claim is reopened onto its own
// slot at generation n+1 under a CAS on the observed generation, keeping the generation line (DESIGN §3b); an absent
// claim (never opened, or removed) is opened create-only. Every branch that does NOT leave an open claim naming THIS
// worktree path fails closed -- a reopen that refuses is re-read and accepted only if a live claim already names this
// exact path, and an absent/open-lost/unreadable claim is a typed refusal rather than a reported success (§5: no
// plausible output is fabricated on an unknown record).
fn belt_worktree_claim_ensure_open_for_instance(
  instance: HostDashboardInstance,
  node_id: RoadmapNodeId,
  attempt_key: String,
  worktree_path: String,
  branch: String,
) -> WorktreeClaimEnsure {
  let root = worktree_claim_slots_root_of(instance: instance)
  let reference = worktree_claim_reference(node_id: node_id as String, attempt_key: attempt_key)
  match now_epoch_seconds() {
    Absent => ClaimEnsureRefused { detail: "the host clock could not be read, so a reopened claim would carry no launch deadline" }
    Present { value: now } => {
      let fresh = worktree_claim_new(
        node_id: node_id as String,
        attempt_key: attempt_key,
        worktree_path: worktree_path,
        opened_at: now,
        launch_deadline: now + compute_pre_launch_ceiling_seconds)
      match worktree_claim_read(root: root, reference: reference as NonEmptyStr) {
        WorktreeClaimHeld { claim: _, generation: g } =>
          match worktree_claim_reopen_settled(root: root, reference: reference as NonEmptyStr, expected: g, claim: fresh) {
            AttemptAdvanced { state: _, generation: _ } => ClaimEnsured
            AttemptLostRace { expected: e, observed: o } =>
              ClaimEnsureRefused { detail: join(["the reclaimed claim moved under the restore: expected ", e, ", observed ", o], "") }
            AttemptTransitionRefused { detail } =>
              match worktree_claim_read(root: root, reference: reference as NonEmptyStr) {
                WorktreeClaimHeld { claim: c, generation: _ } =>
                  if c.worktree_path == worktree_path {
                    ClaimEnsured
                  } else {
                    ClaimEnsureRefused { detail: join(["the reclaim would not reopen onto this worktree: ", detail], "") }
                  }
                WorktreeClaimAbsent => ClaimEnsureRefused { detail: join(["the reclaim vanished during the restore: ", detail], "") }
                WorktreeClaimUnreadable { detail: d } => ClaimEnsureRefused { detail: join(["the reclaimed claim could not be re-read after the reopen refused: ", d], "") }
              }
          }
        WorktreeClaimAbsent =>
          match worktree_claim_open(root: root, claim: fresh) {
            AttemptAdvanced { state: _, generation: _ } => ClaimEnsured
            AttemptTransitionRefused { detail } =>
              ClaimEnsureRefused { detail: join(["a worktree claim could not be opened for the restored worktree: ", detail], "") }
            AttemptLostRace { expected: e, observed: o } =>
              ClaimEnsureRefused { detail: join(["a claim appeared under the restore: expected ", e, ", observed ", o], "") }
          }
        WorktreeClaimUnreadable { detail } =>
          ClaimEnsureRefused { detail: join(["the reclaimed claim could not be read to reopen it: ", detail], "") }
      }
    }
  }
}

// THE RESTORE STEP itself. Resolves the node's prior attempt from the ledger (the same ledger the decision reads),
// applies the three-way gate, then re-materializes the tree from the branch and reopens the claim. Every read is
// the modeled one; the two git calls run through the belt's exec path (the same host_exec_argv/capability program
// the claim-open flow uses), so no parallel authority is introduced.
fn belt_attempt_worktree_restore_for_instance(instance: HostDashboardInstance, node_id: RoadmapNodeId) -> AttemptWorktreeRestore {
  // The attempt to restore is the node's prior attempt -- the SAME first-per-node row the continuation decision
  // reads -- so the restore and the decision never disagree about WHICH attempt is being resumed (one selection
  // rule). The GATE is RESUMABILITY, not ENDEDNESS: it reads the recovery reading (the attempt-state event
  // stream), which is TREE-INDEPENDENT. A reclaimed worktree makes the CONTINUATION Refused (its capture cannot
  // be read), so gating the restore on that standing would CYCLE -- missing tree => Refused => unknown => restore
  // refuses => tree stays missing, and the wedge would never clear. The recovery reading says 'request-pending
  // and resumable' without touching the tree, so the restore can re-materialize it. ENDEDNESS is a separate fact,
  // read by the claim release via belt_lineage_standing; RESUMABILITY is this one -- different facts, each derived
  // in exactly one place (DESIGN §3). The ledger is read only to SELECT the prior attempt; if it cannot be read we
  // refuse rather than act on an unknown (§5: a failure arm refuses, never widens).
  let ledger = belt_attempts_observe_for_instance(instance: instance)
  match ledger {
    AttemptsRefused { reason } =>
      AttemptWorktreeRestoreRefused { detail: join(["the prior-attempt ledger could not be read to decide whether a request-pending worktree needs restoring: ", reason], "") }
    AttemptsObserved { attempts } =>
      match (attempts |> filter(a => a.node_id as String == node_id as String)).first() {
        Absent => AttemptWorktreeNotNeeded
        Present { value: p } =>
          if session_recovery_is_request_pending_resumable(
            belt_prior_attempt_recovery(instance: instance, node_id: node_id, attempt_key: p.attempt_key),
          ) {
            let path = dispatch_worktree_path_for_instance(instance: instance, node_id: node_id, attempt_key: p.attempt_key)
            let branch = dispatch_branch_name(node_id: node_id, attempt_key: p.attempt_key)
            match belt_claim_tree_at(instance: instance, path: path) {
              // The tree is already there: no restore, and the decision observes its head normally.
              ClaimTreePresent => AttemptWorktreeNotNeeded
              // An unobservable tree is UNKNOWN, not absent: refuse rather than restore onto a tree we cannot see (§5).
              ClaimTreeUnobserved { detail } =>
                AttemptWorktreeRestoreRefused { detail: join(["the worktree could not be observed before restoring it: ", detail, "; refusing to restore onto an unknown tree"], "") }
              ClaimTreeAbsent =>
                match belt_exec(cmd: git_rev_parse_verify_argv_for_instance(instance: instance, reference: branch), workdir: instance.repo_root as String) {
                  // The branch is the durable record. Reopen/open the CLAIM first (mirroring the invariant that the
                  // claim is recorded BEFORE `git worktree add`), so a tree is never created that no open record names;
                  // only then re-materialize the tree from the branch.
                  ExecOk { stdout: _ } =>
                    match belt_worktree_claim_ensure_open_for_instance(instance: instance, node_id: node_id, attempt_key: p.attempt_key, worktree_path: path, branch: branch) {
                      ClaimEnsured =>
                        match belt_exec(cmd: git_worktree_add_branch_argv_for_instance(instance: instance, worktree_path: path, branch_name: branch), workdir: instance.repo_root as String) {
                          ExecOk { stdout: _ } => AttemptWorktreeRestored { worktree_path: path, branch: branch }
                          ExecFailed { program: _, exit_code, stderr } => AttemptWorktreeRestoreRefused { detail: join(["re-materializing the worktree for attempt ", p.attempt_key, " from branch ", branch, " failed (exit ", to_string(value: exit_code), "): ", stderr], "") }
                          ExecRefused { program, reason } => AttemptWorktreeRestoreRefused { detail: join(["re-materializing the worktree was refused: ", program, " -- ", reason], "") }
                        }
                      ClaimEnsureRefused { detail } => AttemptWorktreeRestoreRefused { detail: detail }
                    }
                  ExecFailed { program: _, exit_code, stderr: _ } =>
                    if exit_code == 1 {
                      AttemptWorktreeBranchAbsent { branch: branch, detail: join(["the request-pending attempt ", p.attempt_key, " has no worktree and its dispatch branch ", branch, " is gone: there is no durable record to re-materialize the worktree from"], "") }
                    } else {
                      AttemptWorktreeRestoreRefused { detail: join(["the branch existence check for ", branch, " could not be completed (exit ", to_string(value: exit_code), ")"], "") }
                    }
                  ExecRefused { program, reason } => AttemptWorktreeRestoreRefused { detail: join(["the branch existence check was refused: ", program, " -- ", reason], "") }
                }
            }
          } else {
            // Not a request-pending resumable lineage (no stream / not resumable / malformed / non-pending): there is
            // nothing for the restore to re-materialize. This is not a silent widen -- the continuation decision itself
            // refuses on a malformed stream or ends on a non-pending one, each with a typed reason; the restore simply
            // does not act on a lineage that is not a pending request waiting to be resumed.
            AttemptWorktreeNotNeeded
          }
      }
  }
}

// THE WORKTREE CLAIM IS RECORDED BEFORE `git worktree add` (gunbc.roadmap.roadmap_attempt_worktree_claim): the
// attempt's identity, derived path and launch deadline, written create-only and read back. Any other
// standing refuses the spawn step, so no tree is created that a record does not name.
fn belt_worktree_claim_before_add(instance: HostDashboardInstance, node_id: String, attempt_key: String) -> WorktreeClaimWritten {
  match now_epoch_seconds() {
    Absent => WorktreeClaimNotRecorded { detail: "the host clock could not be read, so the worktree claim has no launch deadline" }
    Present { value: now } =>
      worktree_claim_record_before_add(
        root: worktree_claim_slots_root_of(instance: instance),
        claim: worktree_claim_new(
          node_id: node_id, attempt_key: attempt_key,
          worktree_path: dispatch_worktree_path_for_instance(instance: instance, node_id: node_id as RoadmapNodeId, attempt_key: attempt_key),
          opened_at: now, launch_deadline: now + compute_pre_launch_ceiling_seconds))
  }
}

// HOST ADAPTERS for the claim ensure. The tree is read through the existing listing-based observation; content
// and removal go through the trusted git route (belt_commit_git), so no other git invocation is introduced.
// The tree is observed at the path the claim DERIVES, through the same listing-and-gitfile observation the spawn
// readback uses: its directory name is read back out of the derived path, never taken from the record.
fn belt_claim_tree_at(instance: HostDashboardInstance, path: String) -> ClaimTree {
  let root = dashboard_instance_dispatch_worktree_root(instance: instance) as String
  let name = replace(path, join([root, "/"], ""), "")
  let listing = Filesystem.List(path: root)
  let read = Filesystem.Read(path: join([path, "/.git"], ""))
  match attempt_worktree_observation_of(
    path: path,
    marker: filesystem_file_observation(
      listing: filesystem_listing_observation(directory: root, success: listing.success, entries: listing.entries, error: listing.error),
      name: name,
      path: join([path, "/.git"], ""),
      read: filesystem_read_outcome(content: read.content, success: read.success, error: read.error),
    ),
  ) {
    AttemptWorktreePresent { path: _ } => ClaimTreePresent
    AttemptWorktreeAbsent { path: _ } => ClaimTreeAbsent
    AttemptWorktreeUnobserved { path: _, cause } => ClaimTreeUnobserved { detail: cause }
  }
}

fn belt_claim_content_of(instance: HostDashboardInstance, worktree: String) -> ClaimContent {
  match belt_commit_git(instance: instance, worktree: worktree, args: shape_git_status_porcelain_nul_args()) {
    ExecOk { stdout } =>
      if trim(stdout) != "" {
        ClaimContentDirty { detail: "git status lists changes" }
      } else {
        match belt_commit_git(instance: instance, worktree: worktree, args: shape_git_branch_remote_contains_head_args()) {
          ExecOk { stdout: remotes } =>
            if trim(remotes) != "" { ClaimContentPushed } else { ClaimContentUnpushedCommits { detail: "no remote-tracking branch contains HEAD" } }
          ExecFailed { program: _, exit_code: _, stderr } => ClaimContentUnobserved { detail: stderr }
          ExecRefused { program: _, reason } => ClaimContentUnobserved { detail: reason }
        }
      }
    ExecFailed { program: _, exit_code: _, stderr } => ClaimContentUnobserved { detail: stderr }
    ExecRefused { program: _, reason } => ClaimContentUnobserved { detail: reason }
  }
}

fn belt_claim_remove_tree(instance: HostDashboardInstance, repo_workdir: String, path: String) -> ClaimRemoval {
  match belt_exec(
    cmd: host_exec_argv(
      program: dispatch_capability_program(environment: instance.execution_environment, cap: GitWorkspaceCapability),
      args: shape_git_worktree_remove_argv(path: path as FilePath)),
    workdir: repo_workdir,
  ) {
    ExecOk { stdout: _ } => ClaimRemoved
    ExecFailed { program: _, exit_code: _, stderr } => ClaimRemoveDeclined { detail: stderr }
    ExecRefused { program: _, reason } => ClaimRemoveUnexecuted { detail: reason }
  }
}

// CAPTURE IS SETTLED AT THE COMMIT STEP: the head-bound commit-step record (belt_commit_outcome_persist), never
// the absence of a capture file. An unobservable head or unreadable record is unknown, which keeps the tree.
fn belt_claim_capture_of(instance: HostDashboardInstance, node_id: String, attempt_key: String) -> ClaimCapture {
  match belt_worktree_head_observe(instance: instance, worktree: dispatch_worktree_path_for_instance(instance: instance, node_id: node_id as RoadmapNodeId, attempt_key: attempt_key)) {
    WorktreeHeadUnobserved { reason } => ClaimCaptureUnknown { detail: reason }
    WorktreeHeadObserved { revision } =>
      match belt_capture_absence_for_attempt(instance: instance, node_id: node_id as RoadmapNodeId, attempt_key: attempt_key, head_sha: revision as String) {
        CaptureAbsent => ClaimCaptureSettled
        CaptureForHead { capture: _ } => ClaimCaptureSettled
        CaptureNotAttempted { reason } => ClaimCaptureOwed { detail: reason }
        CaptureUnreadable { reason } => ClaimCaptureUnknown { detail: reason }
      }
  }
}

// THE BELT'S ONE CLAIM-ENSURE CALL, run after the activation ensure so the worker's standing is read after any
// rollback. A refused store or clock is a refused pass, not a skipped one.
fn belt_worktree_claim_ensure(instance: HostDashboardInstance, stores: SessionPlacementStores, settled: SessionSettlePass) -> SessionSettlePass {
  match settled {
    SessionSettlePassRefused { detail: _ } => settled
    SessionSettlePassRan { settlements } =>
      match now_epoch_seconds() {
        Absent => SessionSettlePassRefused { detail: "the host clock could not be read as epoch seconds, and the worktree claim ensure compares against the launch deadline" }
        Present { value: now } => {
          // Observe the raw ledger and the pane snapshot ONCE for the whole pass; each claim's lineage standing is a
          // pure lookup over these, so a pass over n claims costs one ledger read and one pane read, not n of each.
          let ledger = belt_attempts_observe_for_instance(instance: instance)
          let panes = belt_attempt_panes_observe_for_instance(instance: instance)
          match worktree_claim_ensure_pass_at(
            stores: stores,
            claims_root: worktree_claim_slots_root_of(instance: instance),
            host: instance.host_identity as String,
            path_of: (n, k) => dispatch_worktree_path_for_instance(instance: instance, node_id: n as RoadmapNodeId, attempt_key: k),
            loaded_of: u => attempt_unit_observation(unit: u),
            lifecycle_of: u => session_worker_unit_lifecycle_for_instance(instance: instance, unit: u),
            now: now,
            tree_of: p => belt_claim_tree_at(instance: instance, path: p),
            content_of: p => belt_claim_content_of(instance: instance, worktree: p),
            remove_tree: p => belt_claim_remove_tree(instance: instance, repo_workdir: instance.repo_root as String, path: p),
            capture_of: (n, k) => belt_claim_capture_of(instance: instance, node_id: n, attempt_key: k),
            // THE ONE 'ENDED' DERIVATION, keyed by THIS claim's (node_id, attempt_key) and read from the continuation
            // over the shared snapshot -- never the node's collapsed first-per-node row (that lets a sibling attempt
            // decide this claim's fate), never the worker's unit standing. A request-pending worker legitimately
            // exited yet its OWN lineage is resumable, so its standing is NotEnded and the claim is kept; an unreadable
            // ledger or a missing row is Unknown, which REFUSES the claim rather than reporting it converged.
            ended_of: (n, k) => belt_lineage_standing(instance: instance, ledger: ledger, panes: panes, node_id: nid(s: n), attempt_key: k),
          ) {
            WorktreeClaimPassRan { outcomes } =>
              if any(outcomes, o => worktree_claim_outcome_is_red(o: o)) {
                SessionSettlePassRefused { detail: worktree_claim_pass_wire(p: WorktreeClaimPassRan { outcomes: outcomes }) }
              } else {
                SessionSettlePassRan { settlements: settlements }
              }
            WorktreeClaimPassRefused { detail } => SessionSettlePassRefused { detail: detail }
          }
        }
      }
  }
}

// A COMPUTE SEAT OPENED FOR A DISPATCH ATTEMPT THAT HAS ENDED IS DISCHARGED, EVERY TICK. The belt is only the
// executor: the ownership authority is the location the seat was recorded at (the dispatch attempt's own directory), the trigger is the
// attempt's exit record, and the release is gunbc.compute.work_provider_local compute_recover_attempt_in,
// which re-proves unit termination itself (gunbc.compute.compute_seat_ensure compute_seat_discharge_all).
fn belt_compute_seat_discharge_pass(instance: HostDashboardInstance) -> SeatDischargePass {
  match compute_capacity_subject(instance: instance, request: kibibyte(count: 0)) {
    ComputeSubjectHostUnresolved { host: h } => SeatDischargeRefused { reason: join(["no capacity subject resolves for host ", h as String], "") }
    ComputeSubjectResolved { subject: subj } =>
      compute_seat_discharge_all(
        instance_root: instance.instance_root as String,
        attempts_dir: compute_attempts_root(instance: instance) as String,
        leases_dir: compute_leases_root(instance: instance),
        subject: subj,
        source: ObserveUnitLifecycle)
  }
}

// A GRANT TAKEN FOR A SPAWN THAT DID NOT HAPPEN IS RETURNED AT ONCE, whatever step failed: the slot is
// closed, the seat released and the release recorded (session_placement_abandon), and that sentence
// is carried into the failure detail. A SpawnNotAdmitted cannot carry it (LaunchRefusal has no slot
// for it), and belt_spawn_admitted never returns one -- admission was decided before the grant -- so
// that arm is re-expressed as a SpawnFailed naming the refusal AND the release (review 74569). A
// process that dies before returning here is the settlement pass's to resolve, from the slot.
fn belt_spawn_release_unless_spawned(held: BeltHeldPlacement, provider_wire_label: String, launch: LaunchIdentity, outcome: BeltSpawnOutcome) -> BeltSpawnOutcome {
  match outcome {
    Spawned { node_id: _, session_name: _, provider: _, launch: _ } => outcome
    SpawnLaunchPending { node_id: _, session_name: _, provider: _, launch: _, entry: _ } => outcome
    SpawnNotAdmitted { node_id: _, refusal: _ } =>
      belt_spawn_outcome_with_release(outcome: outcome, release_note: session_placement_abandon(stores: held.stores, grant: held.grant, reason: "spawn did not complete"), provider_wire_label: provider_wire_label, launch: launch)
    SpawnFailed { node_id: _, step: _, detail: _, provider: _, launch: _ } =>
      belt_spawn_outcome_with_release(outcome: outcome, release_note: session_placement_abandon(stores: held.stores, grant: held.grant, reason: "spawn did not complete"), provider_wire_label: provider_wire_label, launch: launch)
  }
}

// THE PURE HALF: an outcome that did not spawn, plus the note of the release that followed it. Every
// such arm comes back as a SpawnFailed whose detail CONTAINS the note -- never an arm that drops it.
fn belt_spawn_outcome_with_release(outcome: BeltSpawnOutcome, release_note: String, provider_wire_label: String, launch: LaunchIdentity) -> BeltSpawnOutcome {
  match outcome {
    Spawned { node_id: _, session_name: _, provider: _, launch: _ } => outcome
    SpawnLaunchPending { node_id: _, session_name: _, provider: _, launch: _, entry: _ } => outcome
    SpawnNotAdmitted { node_id, refusal } =>
      SpawnFailed {
        node_id: node_id,
        step: "not-admitted-after-placement",
        detail: join(["admission refused after the placement was granted: ", launch_refusal_reason(r: refusal), "; ", release_note], ""),
        provider: provider_wire_label,
        launch: launch,
      }
    SpawnFailed { node_id, step, detail, provider, launch: l } =>
      SpawnFailed { node_id: node_id, step: step, detail: join([detail, "; ", release_note], ""), provider: provider, launch: l }
  }
}

// LAUNCH ESTABLISHES THE WORKTREE IT CLAIMS. `git worktree add` exiting zero was taken as the
// worktree's existence, and srv2 (2026-10-02) showed an attempt whose worktree was missing while the
// Workspace segment read complete. A linked worktree has a `.git` FILE at its root naming its git
// directory, so its presence is read from the listing of the worktree, through the absence-
// establishing fold over the worktree ROOT: the attempt's directory not listed there is Absent; listed
// with no readable `.git` is a broken worktree and reads Unobserved with its cause; a listing that
// fails is Unobserved, never Absent.
fn belt_attempt_worktree_observe(instance: HostDashboardInstance, node_id: RoadmapNodeId, attempt_key: String) -> AttemptWorktreeObservation {
  let root = dashboard_instance_dispatch_worktree_root(instance: instance) as String
  let name = join([node_id as String, "-a", attempt_key], "")
  let worktree = dispatch_worktree_path_for_instance(instance: instance, node_id: node_id, attempt_key: attempt_key)
  let listing = Filesystem.List(path: root)
  let read = Filesystem.Read(path: join([worktree, "/.git"], ""))
  attempt_worktree_observation_of(
    path: worktree,
    marker: filesystem_file_observation(
      listing: filesystem_listing_observation(directory: root, success: listing.success, entries: listing.entries, error: listing.error),
      name: name,
      path: join([worktree, "/.git"], ""),
      read: filesystem_read_outcome(content: read.content, success: read.success, error: read.error),
    ),
  )
}

fn belt_session_container_start_steps(container: DispatchSessionContainer) -> List<BeltExecStep> {
  match container {
    TmuxSessionContainer {
      spawn: _,
      default_shell,
      remain_on_exit,
      event_pipe,
      provider_start,
    } =>
      [
        BeltExecStep { step: "tmux-default-shell", command: default_shell },
        BeltExecStep { step: "tmux-remain-on-exit", command: remain_on_exit },
        BeltExecStep { step: "tmux-event-pipe", command: event_pipe },
        BeltExecStep { step: "provider-start", command: provider_start },
      ]
    SystemdUnitContainer { plan: _ } => []
  }
}

// Spawn-start cleanup: a start step failed after the idle session existed. remain-on-exit is
// already on, but the failed step is almost always default-shell / remain-on-exit / event-pipe /
// provider-start as a tmux command, so the pane is the live idle shell, not a remain-on-exit dead
// attempt. The same write-before-reap rule still applies: if the pane IS dead with a status, record
// then reap; a failed write keeps the pane.
fn belt_created_session_cleanup_detail(
  instance: HostDashboardInstance,
  session_name: String,
) -> String {
  match belt_actuate_teardown_for_instance(
    instance: instance,
    session_name: session_name,
  ) {
    ReapedSession { session_name: _ } => "created session reaped"
    TeardownFailed { session_name: _, detail } =>
      join(["created-session cleanup failed: ", detail], "")
  }
}

fn belt_persist_spawn_failure_for_instance(
  instance: HostDashboardInstance,
  node: RoadmapNode,
  attempt_key: String,
  step: String,
  detail: String,
) -> String {
  let evidence = join([step, ": ", detail], "")
  let write = Filesystem.Write(
    path: dispatch_attempt_spawn_failure_path_for_instance(
      instance: instance,
      node_id: node.node,
      attempt_key: attempt_key,
    ),
    content: evidence,
  )
  if write.success {
    detail
  } else {
    join([
      detail,
      "; additionally failed to persist spawn evidence: ",
      write.error,
    ], "")
  }
}

// RLM-1: the THIRD outcome, produced by the shared launch admission. Spawned and SpawnFailed are
// actuation's answers once a launch is admitted; SpawnNotAdmitted is the admission's own refusal,
// carried as the typed LaunchRefusal (never flattened into a SpawnFailed step string) so the manual
// route, tick receipt and page project one identity and reason. Not a failure: a ManualReady tick
// reports one per Ready node it would have started, and the pass outcome stays Recorded.
// Spawned and SpawnFailed carry the exact LaunchIdentity that admitted the attempt (review
// 5059520727 finding 4: every surface matched `LaunchAdmitted { identity: _ }` and discarded it).
// The identity is threaded from the admission site through every actuation step — route response,
// tick outcome list, durable tick receipt (BeltTickReceipt.launches) and the attempt's state
// directory (launch-identity.json, beside environment-admission.json) — so RLM-4 joins an attempt
// to its admission by construction. SpawnNotAdmitted has no identity: no admission produced one.
type BeltSpawnOutcome
  = Spawned { node_id: String, session_name: String, provider: String, launch: LaunchIdentity }
  | SpawnFailed { node_id: String, step: String, detail: String, provider: String, launch: LaunchIdentity }
  | SpawnNotAdmitted { node_id: String, refusal: LaunchRefusal }
  | SpawnLaunchPending { node_id: String, session_name: String, provider: String, launch: LaunchIdentity, entry: String }

// SpawnLaunchPending is the launch whose start request is enqueued on the attempt-unit spool and
// whose answer was not yet there at the single read made right after the enqueue. It is neither
// Spawned nor SpawnFailed: the root side (the spool's path unit) answers asynchronously, the slot
// stays "launching", and the placement is NOT released here -- the recovery pass resolves the slot
// from the unit's real state. The entry names the spool request a client follows.

fn belt_dispatch_spawn_unselected_provider_wire_label() -> String {
  "unselected"
}

fn belt_dispatch_spawn_selection_refused_provider_wire_label(reason: NonEmptyStr) -> String {
  concat("selection-refused: ", reason as String)
}

fn belt_dispatch_spawn_provider_wire_label(provider: DispatchCliProvider) -> String {
  dispatch_provider_label(provider: provider)
}

// Spawn preflights the CLAUDE dependency before any actuation because both failure classes pass the
// exec seam SILENTLY (§5, found live 2026-07-23): tmux new-session exits 0 with the inner claude
// missing (the pane dies behind a fabricated Spawned), and an unseeded workspace-trust root blocks
// claude INTERACTIVELY on its per-path trust dialog (a hung session, not an error —
// --dangerously-skip-permissions does not cover it). Both are decidable BEFORE spawning and refuse
// as typed SpawnFailed rows: claude-on-PATH via the shell.PosixCommandV.Check authority belt_exec
// uses (step claude-cli; migrated off shell.Which.Check, crisp-wren-896, PR #8590), then the trust
// seed for the ONE dispatch worktree root, read from the claude trust store and classified by
// extdeps.llm.cli.claude_workspace_trust_seeded — the modeled home of what was hand-provisioned on
// srv1 at go-live (ancestor-inheritance makes the single root sufficient; steps claude-trust-home /
// claude-trust-store / claude-trust-seed, each detail naming the exact convergence). The DECISION
// is the pure witnessed fn belt_claude_preflight_decision (every arm on synthetic facts, like
// belt_observe_from_result); belt_claude_preflight only threads live observations in. Residue:
// refuse-with-instructions, not auto-seed — the trust store is claude's own runtime-mutable file,
// so a read-modify-write APPLY arm races the upstream writer; seeding stays with the live_deploy
// membership convergence (the go-live receipt's named dissolution).
type BeltClaudePreflight
  = ClaudePreflightOk
  | ClaudePreflightRefused { step: String, detail: String }

fn belt_claude_preflight_decision(
  claude_on_path: Bool,
  home: String,
  trust_store_path: String,
  trust_store_read: FilesystemReadOutcome,
  trust_root: String,
) -> BeltClaudePreflight {
  if !claude_on_path {
    ClaudePreflightRefused {
      step: "claude-cli",
      detail: "claude not found on PATH (which exit nonzero); tmux would spawn a pane that dies instantly — fail-closed, no fabricated Spawned",
    }
  } else if home == "" {
    ClaudePreflightRefused {
      step: "claude-trust-home",
      detail: "HOME unset or empty — cannot locate the claude trust store (~/.claude.json), so the workspace-trust seed is unknowable; fail-closed",
    }
  } else {
    match trust_store_read {
      FilesystemReadRefused { error: _ } =>
        ClaudePreflightRefused {
          step: "claude-trust-store",
          detail: concat(
            concat("claude trust store unreadable at ", trust_store_path),
            " — claude blocks on its workspace-trust dialog for an unseeded root; seed it by launching claude once under the dispatch worktree root, or converge via the live_deploy membership",
          ),
        }
      FilesystemReadSucceeded { content: trust_store_text } =>
        if !claude_workspace_trust_seeded(config_text: trust_store_text, project_path: trust_root) {
          ClaudePreflightRefused {
            step: "claude-trust-seed",
            detail: concat(
              concat(concat("workspace trust not seeded for ", trust_root), " in "),
              concat(trust_store_path, " (projects entry with hasTrustDialogAccepted: true) — claude would block interactively on its trust dialog; ancestor-dir trust inheritance means seeding this ONE root covers every dispatch worktree"),
            ),
          }
        } else {
          ClaudePreflightOk
        }
    }
  }
}

fn belt_claude_preflight_for_instance(instance: HostDashboardInstance) -> BeltClaudePreflight {
  let claude_ok = belt_program_available(program: claude_cli_program)
  let home = match shell.Env.Get(name: "HOME" as NonEmptyStr).value {
    Absent => ""
    Present { value: v } => v
  }
  if !claude_ok || home == "" {
    belt_claude_preflight_decision(
      claude_on_path: claude_ok,
      home: home,
      trust_store_path: "",
      trust_store_read: filesystem_read_outcome(content: "", success: false, error: "unused on refusal"),
      trust_root: dashboard_instance_dispatch_worktree_root(instance: instance) as String,
    )
  } else {
    let path = claude_trust_store_path(home: home)
    let r = Filesystem.Read(path: path)
    belt_claude_preflight_decision(
      claude_on_path: claude_ok,
      home: home,
      trust_store_path: path,
      trust_store_read: filesystem_read_outcome(content: r.content, success: r.success, error: r.error),
      trust_root: dashboard_instance_dispatch_worktree_root(instance: instance) as String,
    )
  }
}

fn belt_claude_preflight() -> BeltClaudePreflight {
  belt_claude_preflight_for_instance(instance: srv1_live_dashboard_instance())
}

type BeltCodexPreflight
  = CodexPreflightOk { auth_method: String }
  | CodexPreflightRefused { step: String, detail: String }

// Codex preflight owns only facts decidable before actuation. Exact env and codex executable paths
// are admitted first; then `env CODEX_HOME=<dedicated-root> codex --version` must show the provider
// identity marker before a separate `codex login status` — separating a broken npm launcher/runtime
// dependency from unauthenticated OAuth. Login exit 0 is the CLI's active-auth verdict, stdout
// retained as the method receipt; auth.json is never parsed and file presence is never
// authentication. Subscription exhaustion and upstream/rate failures occur only after codex exec
// starts and belong to provider JSONL (`turn.failed` / `error`) plus retained process exit.
fn belt_codex_preflight_decision_observed_for_home(
  codex_home: String,
  codex_on_path: Bool,
  env_on_path: Bool,
  identity_command_success: Bool,
  identity_stdout: String,
  identity_stderr: String,
  login_status_success: Bool,
  login_status_stdout: String,
  login_status_stderr: String,
) -> BeltCodexPreflight {
  let identity_realized = identity_command_success
    && codex_runtime_version_identity_satisfied(
      combined_output: join([identity_stdout, "\n", identity_stderr], ""),
    )
  if !codex_on_path {
    CodexPreflightRefused {
      step: "codex-cli",
      detail: "codex not found on PATH; refusing before worktree creation",
    }
  } else if !env_on_path {
    CodexPreflightRefused {
      step: "codex-env",
      detail: "env not found on PATH; cannot bind the dedicated CODEX_HOME for auth or execution",
    }
  } else if !identity_realized {
    CodexPreflightRefused {
      step: "codex-identity",
      detail: join([
        "codex --version did not realize ",
        codex_runtime_version_identity_marker(),
        "; stdout: ",
        identity_stdout,
        "; stderr: ",
        identity_stderr,
      ], ""),
    }
  } else if !login_status_success {
    CodexPreflightRefused {
      step: "codex-auth",
      detail: join([
        "codex login status exited nonzero for ",
        codex_home,
        "; stdout: ",
        login_status_stdout,
        "; stderr: ",
        login_status_stderr,
      ], ""),
    }
  } else {
    CodexPreflightOk { auth_method: login_status_stdout }
  }
}

fn belt_codex_preflight_for_instance(instance: HostDashboardInstance) -> BeltCodexPreflight {
  match dashboard_instance_provider_executable(instance: instance) {
    Absent =>
      CodexPreflightRefused {
        step: "codex-executable-placement",
        detail: dashboard_instance_provider_executable_refusal_detail(instance: instance),
      }
    Present { value: codex_program } => {
      let codex_home = dashboard_instance_provider_state_root(instance: instance) as String
      let codex_program_str = codex_program as String
      let env_program = dispatch_capability_program(
        environment: instance.execution_environment,
        cap: EnvironmentBindingCapability,
      )
      let codex_ok = belt_program_available(program: codex_program_str)
      let env_ok = belt_program_available(program: env_program)
      if !codex_ok || !env_ok {
        belt_codex_preflight_decision_observed_for_home(
          codex_home: codex_home,
          codex_on_path: codex_ok,
          env_on_path: env_ok,
          identity_command_success: false,
          identity_stdout: "",
          identity_stderr: "",
          login_status_success: false,
          login_status_stdout: "",
          login_status_stderr: "",
        )
      } else {
        let identity = gunbc.WitnessBin.Run(
          workdir: belt_observe_workdir,
          bin_path: env_program as FilePath,
          args: shape_codex_version_env_args_for_program(
            program: codex_program_str,
            codex_home: codex_home,
          ),
          expect: OutcomeIsData,
        )
        let identity_realized = identity.success
          && codex_runtime_version_identity_satisfied(
            combined_output: join([identity.stdout, "\n", identity.stderr], ""),
          )
        if !identity_realized {
          belt_codex_preflight_decision_observed_for_home(
            codex_home: codex_home,
            codex_on_path: codex_ok,
            env_on_path: env_ok,
            identity_command_success: identity.success,
            identity_stdout: identity.stdout,
            identity_stderr: identity.stderr,
            login_status_success: false,
            login_status_stdout: "",
            login_status_stderr: "",
          )
        } else {
          let result = gunbc.WitnessBin.Run(
            workdir: belt_observe_workdir,
            bin_path: env_program as FilePath,
            args: shape_codex_login_status_env_args_for_program(
              program: codex_program_str,
              codex_home: codex_home,
            ),
            expect: OutcomeIsData,
          )
          belt_codex_preflight_decision_observed_for_home(
            codex_home: codex_home,
            codex_on_path: codex_ok,
            env_on_path: env_ok,
            identity_command_success: identity.success,
            identity_stdout: identity.stdout,
            identity_stderr: identity.stderr,
            login_status_success: result.success,
            login_status_stdout: result.stdout,
            login_status_stderr: result.stderr,
          )
        }
      }
    }
  }
}

fn belt_codex_preflight() -> BeltCodexPreflight {
  belt_codex_preflight_for_instance(instance: srv1_live_dashboard_instance())
}

type BeltProviderPreflight
  = ProviderPreflightOk
  | ProviderPreflightRefused { step: String, detail: String }

fn belt_provider_preflight_for_instance(
  instance: HostDashboardInstance,
  provider: DispatchCliProvider,
) -> BeltProviderPreflight {
  match provider {
    ClaudeCodeProvider =>
      match belt_claude_preflight_for_instance(instance: instance) {
        ClaudePreflightOk => ProviderPreflightOk
        ClaudePreflightRefused { step: st, detail: d } =>
          ProviderPreflightRefused { step: st, detail: d }
      }
    CodexDispatchProvider =>
      match belt_codex_preflight_for_instance(instance: instance) {
        CodexPreflightOk { auth_method: _ } => ProviderPreflightOk
        CodexPreflightRefused { step: st, detail: d } =>
          ProviderPreflightRefused { step: st, detail: d }
      }
    CursorDispatchProvider =>
      ProviderPreflightRefused {
        step: "cursor-provider-preflight",
        detail: "cursor dispatch is not yet wired on this actuator path",
      }
    ReplayDispatchProvider => ProviderPreflightOk
    GunbcHarnessProvider =>
      match harness_observe_roster() {
        HarnessRosterServing { serving: _, declined: _, unresolved: _ } => ProviderPreflightOk
        HarnessRosterNoneServing { declined, unresolved } =>
          ProviderPreflightRefused {
            step: "harness-backend-roster",
            detail: join(["no enrolled serving route advertises a model the harness is admitted to ask: ", harness_declines_detail(declined: declined, unresolved: unresolved)], ""),
          }
      }
  }
}

fn belt_provider_preflight(provider: DispatchCliProvider) -> BeltProviderPreflight {
  belt_provider_preflight_for_instance(
    instance: srv1_live_dashboard_instance(),
    provider: provider,
  )
}

// Step 0b: the runtime admits against its own deployment footprint BEFORE mutating anything. The
// 2026-07-30 incident: staging ran `git worktree add` (389ms, ok) then `install -d` into an
// attempt-state root missing under a root-owned parent (3ms, EACCES) — the short-circuit worked and
// still left an orphan branch and worktree per click, because the first durable mutation preceded
// discovery. Step 0a made the root a converged deployment member so it EXISTS; this gate makes its
// absence or unwritability REFUSE FIRST — a class that cannot recur versus one recurring once per
// host between deploys.
//
// THE ROOTS COME FROM THE INSTANCE, NOT live_deploy's srv1 roster — not a second footprint: the
// instance is the runtime's own view of the paths it writes, so a lab/preview instance under a
// disjoint root admits against ITS roots while gunbc.live_deploy.spec stays the provisioner's view
// of srv1. Step 1 unifies both into one member list with permissions; until then the belt reads
// what it was handed rather than a host-specific roster.
//
// WRITABILITY IS PROBED AS WRITE AND SEARCH, since POSIX needs both to create a directory entry:
// `test -w` alone passes on a mode-0644 directory and the next `install -d` still fails — the
// fabricated precondition this gate removes. Search reuses shell.Test.IsExecutable: `test -x` on a
// directory IS the search bit, the cited operation in its directory sense, not a minted probe. The
// frame is the EFFECTIVE principal: the probes run in the serve process, answering for the account
// that performs the mutation (a provisioner-side SSH probe answers for the deploy principal and
// would admit a root the runtime cannot write).
//
// Known conflation, named not modeled away: a probe that could not execute reads present=false,
// like an absent root. Both arms REFUSE, nothing is fabricated, the remedy is a converge in both;
// only the detail line misattributes, and `test` is a coreutils/shell builtin whose absence would
// already break belt_exec's which-check. Splitting adds a third state whose branches take the same
// action.
//
// OutcomeIsData ADMISSIBILITY (discharging gunbc.output_policy outcome_is_data_note's review
// obligation): all three probes are annotated because a non-zero `test` exit is an ANSWER — root
// absent / not writable / not searchable — ambient in both contexts: production refuses the spawn,
// witnesses assert the refusal arm. Satisfied structurally: belt_footprint_observe returns
// BeltFootprintObservation and belt_footprint_admission_for_instance returns
// BeltFootprintAdmission, so each exit feeds a typed consumer, never unit. Dispatch failure of the
// probe ITSELF stays anomalous, not silenced by the annotation.
type BeltFootprintRoot {
  member: String
  path: String
}

fn belt_dispatch_footprint_roots(instance: HostDashboardInstance) -> List<BeltFootprintRoot> {
  [
    BeltFootprintRoot {
      member: "dispatch-worktree-root",
      path: dashboard_instance_dispatch_worktree_root(instance: instance) as String,
    },
    BeltFootprintRoot {
      member: "attempt-state-root",
      path: dashboard_instance_dispatch_attempt_state_root(instance: instance) as String,
    },
  ]
}

type BeltFootprintObservation {
  member: String
  path: String
  present: Bool
  writable: Bool
  searchable: Bool
}

type BeltFootprintAdmission
  = FootprintAdmitted
  | FootprintRefused { step: String, detail: String }

fn belt_footprint_root_verdict(obs: BeltFootprintObservation) -> BeltFootprintAdmission {
  if !obs.present {
    FootprintRefused {
      step: "footprint-root-absent",
      detail: join([
        "deployment member ", obs.member, " is not a directory at ", obs.path,
        " — the belt writes there on every dispatch, so staging would mutate the worktree and then fail; converge the member (gunbc.live_deploy.spec deployment_owned_steps) rather than creating it by hand",
      ], ""),
    }
  } else if !obs.writable {
    FootprintRefused {
      step: "footprint-root-unwritable",
      detail: join([
        "deployment member ", obs.member, " at ", obs.path,
        " is not writable by the effective runtime principal — the deploy converges it owned by the service user; a root owned by anyone else means the instance was hand-provisioned or the member's ownership drifted",
      ], ""),
    }
  } else if !obs.searchable {
    FootprintRefused {
      step: "footprint-root-unsearchable",
      detail: join([
        "deployment member ", obs.member, " at ", obs.path,
        " is writable but not searchable by the effective runtime principal — POSIX requires write AND search to create an entry, so staging would still fail on a directory this gate would otherwise admit",
      ], ""),
    }
  } else {
    FootprintAdmitted
  }
}

fn belt_footprint_admission_decision(
  observations: List<BeltFootprintObservation>,
) -> BeltFootprintAdmission {
  fold(observations, init: FootprintAdmitted, f: (acc, obs) =>
    match acc {
      FootprintRefused { step: st, detail: d } =>
        FootprintRefused { step: st, detail: d }
      FootprintAdmitted => belt_footprint_root_verdict(obs: obs)
    }
  )
}

fn belt_footprint_observe(root: BeltFootprintRoot) -> BeltFootprintObservation {
  let present = shell.Test.IsDirectory(
    path: root.path as FilePath,
    expect: OutcomeIsData,
  ).is_directory
  let writable = shell.Test.IsWritable(
    path: root.path as FilePath,
    expect: OutcomeIsData,
  ).writable
  let searchable = shell.Test.IsExecutable(
    path: root.path as FilePath,
    expect: OutcomeIsData,
  ).executable
  BeltFootprintObservation {
    member: root.member,
    path: root.path,
    present: present,
    writable: writable,
    searchable: searchable,
  }
}

fn belt_footprint_admission_for_instance(
  instance: HostDashboardInstance,
) -> BeltFootprintAdmission {
  belt_footprint_admission_decision(
    observations: map(
      belt_dispatch_footprint_roots(instance: instance),
      r => belt_footprint_observe(root: r),
    ),
  )
}

// ONE ROSTER READ PER SPAWN, BOUND HERE AND CARRIED. This site preflighted and labelled a provider
// from one live selection, and belt_resolved_spawn_plan then read the roster AGAIN beneath it -- and
// it was that second answer whose model reached the process. If the roster moved between the two, a
// replica dropping out being exactly the event this fleet sees, the preflighted provider and the
// spawned one could disagree with nothing recording it. That is the same class the observe fold
// closed, sitting on the one route where the model actually reaches a process, and this module's own
// rule is that the fix is the carrier rather than the call.
// ONE OWNER FOR THE CREDENTIAL SNAPSHOT'S LIFECYCLE AFTER SELECTION (side-chat finding, 2026-10-05).
// A vendor selection may take a per-attempt credential snapshot, and when it does the prepared launch
// CARRIES the sealed value it took (gunbc.dispatch_attempt_launch SnapshotLaunch, a
// gunbc.dispatch_credential_snapshot TakenCredentialSnapshot). Exactly one path consumes it: the
// launched child, whose wrapper removes it before exec. Every other way out of the spawn after
// selection -- a refused provider preflight, no spawn route, a placement refusal,
// any SpawnFailed -- never launches that child, so the snapshot would outlive the attempt. The
// decision is a pure fold over the outcome so every arm is witnessed; the discard is applied once,
// here, around everything that follows selection, and it removes the snapshot the prepared launch
// carries -- never a path re-derived here. That snapshot is this attempt's: the prepared launch was
// minted only because its attempt is the one this belt requested (gunbc.dispatch_attempt_launch
// prepare_attempt_launch), so the discard cannot reach a file another attempt's child is about to
// read. A launch without an attempt snapshot passes through unchanged.
type BeltSnapshotDisposition
  = SnapshotConsumedByChild
  | SnapshotDiscardRequired

fn belt_snapshot_disposition(outcome: BeltSpawnOutcome) -> BeltSnapshotDisposition {
  match outcome {
    Spawned { node_id: _, session_name: _, provider: _, launch: _ } => SnapshotConsumedByChild
    SpawnLaunchPending { node_id: _, session_name: _, provider: _, launch: _, entry: _ } => SnapshotConsumedByChild
    SpawnFailed { node_id: _, step: _, detail: _, provider: _, launch: _ } => SnapshotDiscardRequired
    SpawnNotAdmitted { node_id: _, refusal: _ } => SnapshotDiscardRequired
  }
}

fn belt_snapshot_owned_outcome(
  prepared: PreparedAttemptLaunch,
  provider_wire_label: String,
  launch: LaunchIdentity,
  outcome: BeltSpawnOutcome,
) -> BeltSpawnOutcome {
  match prepared_attempt_launch_alternative(prepared: prepared) {
    SnapshotFreeLaunch { attempt: _, executor: _ } => outcome
    SnapshotLaunch { snapshot } => belt_snapshot_discarded_unless_consumed(snapshot: snapshot, provider_wire_label: provider_wire_label, launch: launch, outcome: outcome)
  }
}

fn belt_snapshot_discarded_unless_consumed(
  snapshot: TakenCredentialSnapshot,
  provider_wire_label: String,
  launch: LaunchIdentity,
  outcome: BeltSpawnOutcome,
) -> BeltSpawnOutcome {
  match belt_snapshot_disposition(outcome: outcome) {
    SnapshotConsumedByChild => outcome
    SnapshotDiscardRequired =>
      match credential_discard_taken_attempt(snapshot: snapshot) {
        CredentialSnapshotTombstoned => outcome
        CredentialSnapshotTombstoneFailed { reason } =>
          SpawnFailed {
            node_id: launch.node_id as String,
            step: "credential-snapshot-discard",
            detail: join(["the attempt did not launch its provider, and ", reason as String], ""),
            provider: provider_wire_label,
            launch: launch,
          }
      }
  }
}

// WHICH ATTEMPT THIS SPAWN IS FOR. A resume is for the prior attempt: its key is that attempt's, so
// the sealed prepared launch, the worktree, the state and the unit all address the one session that is
// being continued. Anything else mints a new attempt from the base ref, as always. The decision is the
// one the route then consumes, read once.
type BeltSpawnKey
  = BeltSpawnKeyOf { attempt_key: String }
  | BeltSpawnKeyRefused { detail: String }

fn belt_spawn_attempt_key(instance: HostDashboardInstance, node: RoadmapNode, probed_at: String, decision: ContinuationDecision) -> BeltSpawnKey {
  match decision {
    ContinuationResume { reason: _, attempt_key, ordinal: _, causes: _ } => BeltSpawnKeyOf { attempt_key: attempt_key }
    ContinuationSpawnFresh { reason: _ } => belt_spawn_minted_key(instance: instance, node: node, probed_at: probed_at)
    ContinuationRefused { reason: _ } => belt_spawn_minted_key(instance: instance, node: node, probed_at: probed_at)
    ContinuationHold { reason: _ } => belt_spawn_minted_key(instance: instance, node: node, probed_at: probed_at)
    ContinuationHoldUntil { reason: _, attempt_key: _, redeliver_at: _ } => belt_spawn_minted_key(instance: instance, node: node, probed_at: probed_at)
    ContinuationComplete { reason: _ } => belt_spawn_minted_key(instance: instance, node: node, probed_at: probed_at)
    ContinuationEnded { reason: _ } => belt_spawn_minted_key(instance: instance, node: node, probed_at: probed_at)
  }
}

fn belt_spawn_minted_key(instance: HostDashboardInstance, node: RoadmapNode, probed_at: String) -> BeltSpawnKey {
  match dispatch_attempt_identity_mint(instance: instance, node_id: node.node, minted_at: probed_at) {
    DispatchAttemptIdentityRefused { detail } => BeltSpawnKeyRefused { detail: detail }
    DispatchAttemptMinted { attempt_key: minted_key, ordinal: _ } => BeltSpawnKeyOf { attempt_key: minted_key }
  }
}

fn belt_actuate_spawn_for_instance(
  instance: HostDashboardInstance,
  node: RoadmapNode,
  probed_at: String,
  launch: LaunchIdentity,
  request: AttemptLaunchRequest,
  executor: DispatchExecutorRequest,
) -> BeltSpawnOutcome {
  // BEFORE the decision is read: a request-pending/resumable attempt whose worktree was reclaimed but whose
  // branch survives is re-materialized here (a named actuation, not an effect hidden in an observation), so the
  // continuation can observe the prior capture instead of refusing forever. A gone branch or a failed
  // re-materialization fails closed -- it does not decide on an unknown tree.
  match belt_attempt_worktree_restore_for_instance(instance: instance, node_id: node.node) {
    AttemptWorktreeBranchAbsent { branch: _, detail } =>
      SpawnFailed {
        node_id: node.node as String,
        step: "worktree-restore",
        detail: detail,
        provider: belt_dispatch_spawn_unselected_provider_wire_label(),
        launch: launch,
      }
    AttemptWorktreeRestoreRefused { detail } =>
      SpawnFailed {
        node_id: node.node as String,
        step: "worktree-restore",
        detail: detail,
        provider: belt_dispatch_spawn_unselected_provider_wire_label(),
        launch: launch,
      }
    _ => {
  let decision = belt_continuation_decision_for_instance(instance: instance, node: node)
  match belt_footprint_admission_for_instance(instance: instance) {
    FootprintRefused { step: fst, detail: fd } =>
      SpawnFailed {
        node_id: node.node as String,
        step: fst,
        detail: fd,
        provider: belt_dispatch_spawn_unselected_provider_wire_label(),
        launch: launch,
      }
    FootprintAdmitted =>
  match dispatch_environment_admit(
    contract: node.execution,
    environment: instance.execution_environment,
  ) {
    EnvironmentRefused { receipts, validation_summary, reason } =>
      SpawnFailed {
        node_id: node.node as String,
        step: "environment-admission",
        detail: dispatch_environment_admission_json(
          admission: EnvironmentRefused {
            receipts: receipts,
            validation_summary: validation_summary,
            reason: reason,
          },
        ),
        provider: belt_dispatch_spawn_unselected_provider_wire_label(),
        launch: launch,
      }
    EnvironmentAdmitted { receipts, validation_summary } => {
      match belt_spawn_attempt_key(instance: instance, node: node, probed_at: probed_at, decision: decision) {
        BeltSpawnKeyRefused { detail } =>
          SpawnFailed {
            node_id: node.node as String,
            step: "attempt-identity",
            detail: detail,
            provider: belt_dispatch_spawn_unselected_provider_wire_label(),
            launch: launch,
          }
        BeltSpawnKeyOf { attempt_key: minted_key } => {
      let attempt = DispatchAttempt {
        instance: instance,
        node: node,
        attempt_key: minted_key,
      }
      match dispatch_actuator_selection_for_request(
        attempt: attempt,
        request: executor,
        sizing_expectation: sizing_profile_expectation(d: node_sizing_derivation(rn: node)),
      ) {
        DispatchAttemptSelectionRefused { reason } =>
          SpawnFailed {
            node_id: node.node as String,
            step: "dispatch-selection",
            detail: reason as String,
            provider: belt_dispatch_spawn_selection_refused_provider_wire_label(reason: reason),
            launch: launch,
          }
        DispatchAttemptPrepared { prepared } => {
          let provider = prepared_attempt_provider(prepared: prepared)
          let post_selection = match belt_provider_preflight_for_instance(
            instance: instance,
            provider: provider,
          ) {
            ProviderPreflightRefused { step: st, detail: d } =>
              SpawnFailed {
                node_id: node.node as String,
                step: st,
                detail: d,
                provider: belt_dispatch_spawn_provider_wire_label(provider: provider),
                launch: launch,
              }
            ProviderPreflightOk =>
              belt_actuate_spawn_exec_for_instance(
                probed_at: probed_at,
                admission_receipt: dispatch_environment_admission_json(
                  admission: EnvironmentAdmitted {
                    receipts: receipts,
                    validation_summary: validation_summary,
                  },
                ),
                provider_wire_label: belt_dispatch_spawn_provider_wire_label(provider: provider),
                launch: launch,
                prepared: prepared,
                request: request,
                decision: decision,
              )
          }
          belt_snapshot_owned_outcome(
            prepared: prepared,
            provider_wire_label: belt_dispatch_spawn_provider_wire_label(provider: provider),
            launch: launch,
            outcome: post_selection,
          )
        }
      }
            }
      }
    }
  }
  }
    }
  }
}

fn belt_actuate_spawn_exec_for_instance(
  probed_at: String,
  admission_receipt: String,
  provider_wire_label: String,
  launch: LaunchIdentity,
  prepared: PreparedAttemptLaunch,
  request: AttemptLaunchRequest,
  decision: ContinuationDecision,
) -> BeltSpawnOutcome {
  belt_actuate_spawn_exec_modeled(
    probed_at: probed_at,
    workdir: prepared_attempt(prepared: prepared).instance.repo_root as String,
    admission_receipt: admission_receipt,
    provider_wire_label: provider_wire_label,
    launch: launch,
    prepared: prepared,
    request: request,
    decision: decision,
  )
}

// The tmux creation boundary is explicit: worktree/state publication first; tmux new-session alone;
// only after its success do session configuration, pipe attachment and provider respawn run. A
// later staging failure reaps exactly the session this request created, no name-only ownership
// guess. Worktree, branch and attempt evidence are retained for diagnosis and user work. The
// located failure plus cleanup receipt is persisted under the published attempt before SpawnFailed
// returns.
// THE SPAWN ROUTE IS A PURE FUNCTION OF THE DECISION, factored so the law "an unresolved lineage
// never reaches a spawn command" is witnessable without the actuator: only SpawnFresh reaches a
// worker spawn; Hold, Complete, Ended and Refused are SpawnRouteNone -- no spawn command is
// reachable from them. A Resume reaches the worker spawn too, but as the continuation of the prior
// attempt's own session (SpawnRouteResume), never as a new attempt.
type BeltSpawnRoute
  = SpawnRouteWorker
  | SpawnRouteResume { attempt_key: String, ordinal: Int }
  | SpawnRouteNone { step: String, detail: String }
  // A request-pending attempt whose re-delivery is not yet due does NOT spawn, but it must not merely
  // stop: this arm carries the instant the continuation named so the spawn fold arms ONE transient
  // re-delivery wake for the same attempt key (roadmap_attempt_redelivery_wake), execing the instance's
  // own belt_dispatch_node_cli route at that instant. Distinct from SpawnRouteNone, which is a dead stop.
  | SpawnRouteWake { attempt_key: String, at: EpochSecs }

fn belt_spawn_route_for_decision(decision: ContinuationDecision) -> BeltSpawnRoute {
  match decision {
    ContinuationSpawnFresh { reason: _ } => SpawnRouteWorker
    ContinuationResume { reason: _, attempt_key, ordinal, causes: _ } => SpawnRouteResume { attempt_key: attempt_key, ordinal: ordinal }
    ContinuationRefused { reason } => SpawnRouteNone { step: "continuation", detail: reason }
    ContinuationHold { reason } => SpawnRouteNone { step: "continuation-hold", detail: reason }
    // Not-due request-pending hold becomes a WAKE route, not a dead stop: the fold arms one re-delivery
    // timer at the instant the continuation itself named, so the attempt comes back on its own.
    ContinuationHoldUntil { reason: _, attempt_key, redeliver_at } => SpawnRouteWake { attempt_key: attempt_key, at: redeliver_at }
    ContinuationComplete { reason } => SpawnRouteNone { step: "continuation-complete", detail: reason }
    ContinuationEnded { reason } => SpawnRouteNone { step: "lineage-ended", detail: reason }
  }
}

// THE SPAWN'S ATTEMPT IS THE PREPARED LAUNCH'S. The instance, node and key every staging step below
// addresses are read from the sealed value the selection prepared for the belt's attempt, never
// re-derived beside it, so the state the belt writes and the launch the child runs are one attempt's.
// THE BELT'S ADDRESSING OF A LAUNCH IS THE PREPARED LAUNCH'S ATTEMPT. Every staging step after
// selection -- the continuation decision, alignment, the binding gate, placement, the worktree, the
// attempt state, the session container and the persisted failure -- addresses the instance, node and
// key projected here from the sealed prepared launch, the same value the spawn plan builds its
// commands from (gunbc.roadmap.roadmap_dispatch_actuator dispatch_spawn_commands_for_launch). No helper
// below receives them beside it, so the state the belt writes and the commands it runs cannot name
// two attempts.
type BeltSpawnAddressing {
  instance: HostDashboardInstance
  node: RoadmapNode
  attempt_key: String
  session_name: String
}

fn belt_spawn_addressing(prepared: PreparedAttemptLaunch) -> BeltSpawnAddressing {
  let attempt = prepared_attempt(prepared: prepared)
  BeltSpawnAddressing {
    instance: attempt.instance,
    node: attempt.node,
    attempt_key: attempt.attempt_key,
    session_name: dispatch_tmux_session_name(node_id: attempt.node.node),
  }
}

fn belt_actuate_spawn_exec_modeled(
  probed_at: String,
  workdir: String,
  admission_receipt: String,
  provider_wire_label: String,
  launch: LaunchIdentity,
  prepared: PreparedAttemptLaunch,
  request: AttemptLaunchRequest,
  decision: ContinuationDecision,
) -> BeltSpawnOutcome {
  let addressing = belt_spawn_addressing(prepared: prepared)
  let instance = addressing.instance
  let node = addressing.node
  match belt_spawn_route_for_decision(decision: decision) {
    SpawnRouteNone { step, detail } =>
      SpawnFailed {
        node_id: node.node as String,
        step: step,
        detail: detail,
        provider: provider_wire_label,
        launch: launch,
      }
    SpawnRouteWorker =>
      belt_actuate_spawn_with_origin(
        workdir: workdir, admission_receipt: admission_receipt,
        provider_wire_label: provider_wire_label, launch: launch, probed_at: probed_at,
        prepared: prepared,
        request: request,
        run: DispatchWorkerFirst,
      )
    SpawnRouteResume { attempt_key, ordinal } =>
      if attempt_key != addressing.attempt_key {
        SpawnFailed {
          node_id: node.node as String,
          step: "resume-attempt",
          detail: join(["the decision resumes attempt ", attempt_key, " but the prepared launch addresses attempt ", addressing.attempt_key, "; a resume continues the prior attempt's own session and never another"], ""),
          provider: provider_wire_label,
          launch: launch,
        }
      } else {
        belt_actuate_spawn_with_origin(
          workdir: workdir, admission_receipt: admission_receipt,
          provider_wire_label: provider_wire_label, launch: launch, probed_at: probed_at,
          prepared: prepared,
          request: request,
          run: DispatchWorkerResumed { ordinal: ordinal },
        )
      }
    // A request-pending attempt held until a named instant arms ONE transient re-delivery wake for its
    // own key, execed through the SAME host-exec transport the belt uses for its other transient units
    // (dispatch_unit_exec_argv -> belt_exec, systemd-run resolved from the instance toolchain). Fail-
    // closed: with no systemd-run, a refused command, or a genuine host-exec failure the attempt stays
    // held and is retried -- never a silent drop, and the failure keeps exit code and stderr (DESIGN §5).
    // The wake's name fixes the one instant it targets, so a later belt pass re-runs the SAME command and
    // systemd-run refuses it ('already exists'); belt_redelivery_wake_arm reads that as the wake already
    // being armed -- idempotence, not a spurious failure -- while any other exit stays a real failure.
    SpawnRouteWake { attempt_key, at } =>
      match instance.toolchain.systemd_run {
        Absent => SpawnFailed { node_id: node.node as String, step: "redelivery-wake", detail: join(["the request-pending attempt ", attempt_key, " is held until a re-delivery wake at ", to_string(value: at), " but this host carries no systemd-run to arm it; the belt cannot wake it -- provision systemd-run"], ""), provider: provider_wire_label, launch: launch }
        Present { value: systemd_run } => {
          // The ROUTE the wake fires is built here, from the instance and the re-delivery route facts this
          // module owns (belt_spawn_workdir_env_var / belt_dispatch_env_var / belt_redeliver_instance_env_var /
          // belt_redeliver_cli_entry / belt_redeliver_cli_function) -- the same serve-binary/run/--source-root/
          // --entry/--function shape belt_obligation_unit_command uses. The entry resolves the instance BY
          // REPO ROOT (belt_instance_from_env), so the wake carries SPAWN_WORKDIR (the attempt's own repo
          // root), the NODE id, the EXPECTED instance id as a cross-check, and the ATTEMPT KEY -- NOT
          // GUNBC_BELT_INSTANCE_ID, whose narrow admitted list refuses srv1-lab-codex-feedback-v0. The entry
          // uses the attempt key to refuse anything but a Resume/Hold-Until continuation of THAT attempt, so
          // the wake continues admitted work rather than starting new dispatch. The wake module holds no route literal.
          let repo = instance.repo_root as String
          let dispatch_env = [
            SystemdSetenvBinding { name: belt_spawn_workdir_env_var, value: repo as NonEmptyStr },
            SystemdSetenvBinding { name: belt_dispatch_env_var, value: node.node as NonEmptyStr },
            SystemdSetenvBinding { name: belt_redeliver_instance_env_var, value: instance.instance_id as NonEmptyStr },
            SystemdSetenvBinding { name: belt_redeliver_attempt_key_env_var, value: attempt_key as NonEmptyStr },
          ]
          let dispatch_argv = belt_function_run_argv(program: instance.serve_binary as String, repo_root: repo, entry: belt_redeliver_cli_entry, function: belt_redeliver_cli_function as String, args: [])
          match attempt_redelivery_wake_command(node_id: node.node as String, attempt_key: attempt_key, next_delivery: at, setenv_bindings: dispatch_env, command_argv: dispatch_argv) {
          SystemdRunCommandRefused { cause } => SpawnFailed { node_id: node.node as String, step: "redelivery-wake", detail: join(["the request-pending attempt ", attempt_key, " could not arm its re-delivery wake: ", systemd_run_option_words_refused_cause_detail(cause: cause)], ""), provider: provider_wire_label, launch: launch }
          SystemdRunCommandReady { command } => {
            let wake_stem = attempt_redelivery_wake_unit_stem(node_id: node.node as String, attempt_key: attempt_key, instant: at)
            let wake_unit = attempt_redelivery_wake_unit_name(node_id: node.node as String, attempt_key: attempt_key, instant: at)
            match belt_redelivery_wake_arm(exec: belt_exec(cmd: dispatch_unit_exec_argv(command: command, resolved_program: systemd_run), workdir: workdir), unit_stem: wake_stem) {
              WakeArmed => SpawnFailed { node_id: node.node as String, step: "continuation-hold-until", detail: join(["the prior attempt ", attempt_key, " is request-pending and its re-delivery is not due yet; its wake ", wake_unit as String, " is armed at ", to_string(value: at), " to re-deliver the same key by belt_redeliver_attempt_cli (resolving the instance by repo root); no resume is spent now"], ""), provider: provider_wire_label, launch: launch }
              WakeAlreadyArmed => SpawnFailed { node_id: node.node as String, step: "continuation-hold-until", detail: join(["the prior attempt ", attempt_key, " is request-pending and its re-delivery at ", to_string(value: at), " was already armed as ", wake_unit as String, "; the wake is not double-armed and no resume is spent now"], ""), provider: provider_wire_label, launch: launch }
              WakeArmFailed { program, exit_code, stderr } => SpawnFailed { node_id: node.node as String, step: "redelivery-wake", detail: join(["arming the re-delivery wake for ", attempt_key, " failed on host exec of ", program, " with exit ", to_string(value: exit_code), "; stderr: ", stderr, "; the attempt stays held and is retried on the next belt pass"], ""), provider: provider_wire_label, launch: launch }
              WakeArmRefused { program, reason } => SpawnFailed { node_id: node.node as String, step: "redelivery-wake", detail: join(["arming the re-delivery wake for ", attempt_key, " was refused on host exec of ", program, ": ", reason, "; the attempt stays held and is retried on the next belt pass"], ""), provider: provider_wire_label, launch: launch }
            }
          }
          }
        }
      }
  }
}

// WHETHER THIS NODE MAY SPAWN. The facts come from the same attempts ledger the commit and verify
// passes read, so the decision sees exactly the provider state and verification segment the
// dashboard shows; an unobservable ledger refuses here as it does there, because a spawn that cannot
// tell whether committed work exists must not start over on top of it. The capture observation is
// the same head-grain read the verify gate makes.
fn belt_continuation_decision_for_instance(instance: HostDashboardInstance, node: RoadmapNode) -> ContinuationDecision {
  belt_continuation_decision_for_node(instance: instance, node_id: node.node)
}

// THE SAME SINGLE CONTINUATION DERIVATION, keyed by the node ID rather than a full node. The decision
// path reads only the node's identity (its ledger row, prior-attempt facts and retire record are all
// keyed by node_id), never the node's roadmap definition -- so a caller that holds only a node ID, such
// as the worktree-claim settlement pass deciding whether a lineage has ended, asks the ONE decision
// instead of re-deriving 'ended' from the worker's unit standing. for_instance is now a projection onto
// this; there is one derivation, not two.
fn belt_continuation_decision_for_node(instance: HostDashboardInstance, node_id: RoadmapNodeId) -> ContinuationDecision {
  match belt_workflow_attempts_observe_for_instance(instance: instance) {
    WorkflowAttemptsRefused { reason } =>
      ContinuationRefused { reason: join(["the attempts ledger is unobservable, so whether this node has committed work to continue cannot be decided: ", reason], "") }
    WorkflowAttemptsObserved { attempts } => {
      let mine = attempts |> filter(p => p.node_id == node_id as String)
      match mine.first() {
        Absent => continuation_decision(prior: none)
        Present { value: p } => belt_continuation_decision_for_progress(instance: instance, node_id: node_id, progress: p)
      }
    }
  }
}

// THE 'ENDED' STANDING FOR ONE ATTEMPT, keyed by (node_id, attempt_key), computed from a PRE-OBSERVED ledger and
// pane snapshot (so a pass over n claims costs ONE ledger read and ONE pane read, not n of each). The node-wide
// observer collapses the ledger to the first row PER NODE (dispatch_attempt_ref_first_per_node), so it cannot answer
// "has THIS attempt's lineage ended?" without a meaning fork; this reads the attempt's OWN row and routes it through
// the SAME decision the spawn route uses (belt_continuation_decision_for_progress): one derivation, keyed. The
// verdict is THREE-valued -- 'can't tell' is never collapsed into 'converged' (§5): the attempt's own row says
// Ended -> LineageEnded (release); Resume / Hold-Until / Refused -> LineageNotEnded (keep); a ledger we could not
// read, or a row we cannot find (reaped, or not this attempt's), -> LineageUnknown, which makes the claim REFUSE
// (typed, located, countable) rather than report it converged while it silently leaks.
// THE PURE DECISION -> STANDING PROJECTION: what the claim settlement may do given one attempt's OWN continuation
// decision. Split out so the mapping is testable in isolation (belt_actuate_witness drives every ContinuationDecision
// arm) and lives in exactly one place (§3). ENDED => the claim may be released/closed; NOT ENDED => keep it; UNKNOWN
// => refuse it, countably -- a 'can't tell' never reports converged (§5).
//   ENDED:     ContinuationEnded (the lineage ended); ContinuationComplete (verified green, reviewed and audited,
//              "nothing spawns" -- definitively finished); ContinuationSpawnFresh (this attempt is abandoned for a
//              fresh dispatch -- its lineage is not continuing). NONE is reachable for a live request-pending
//              lineage, which decides Hold / HoldUntil / Resume, so releasing on these never touches a pending
//              attempt's tree (review 88212: these were silently kept, leaking a finished attempt's worktree).
//   NOT ENDED: ContinuationHold / ContinuationHoldUntil (awaiting the belt, an armed wake, or an operator) and
//              ContinuationResume (recovery-needed and resumable) -- all still open; keep the claim.
//   UNKNOWN:   ContinuationRefused -- the decision could not be made (unobservable ledger, unreadable retire record,
//              or a damaged segment record only the operator may decide). 'Can't tell' REFUSES; never kept as if it
//              converged, never released.
fn belt_lineage_standing_of_decision(decision: ContinuationDecision) -> LineageStanding {
  match decision {
    ContinuationEnded { reason: _ } => LineageEnded
    ContinuationComplete { reason: _ } => LineageEnded
    ContinuationSpawnFresh { reason: _ } => LineageEnded
    ContinuationRefused { reason } => LineageUnknown { detail: join(["the continuation could not decide: ", reason], "") }
    ContinuationHold { reason: _ } => LineageNotEnded
    ContinuationHoldUntil { reason: _, attempt_key: _, redeliver_at: _ } => LineageNotEnded
    ContinuationResume { reason: _, attempt_key: _, ordinal: _, causes: _ } => LineageNotEnded
  }
}

fn belt_lineage_standing(
  instance: HostDashboardInstance,
  ledger: BeltAttempts,
  panes: BeltAttemptPanes,
  node_id: RoadmapNodeId,
  attempt_key: String,
) -> LineageStanding {
  match ledger {
    AttemptsRefused { reason } => LineageUnknown { detail: join(["the prior-attempt ledger could not be read: ", reason], "") }
    AttemptsObserved { attempts } =>
      match (attempts |> filter(a => a.node_id as String == node_id as String && a.attempt_key == attempt_key)).first() {
        // A SUCCESSFULLY-READ ledger that carries no row for this attempt is NOT 'can't tell' -- it is the reaped,
        // finished case. The workflow-attempts row exists while an attempt is active and is removed once it is done
        // and reaped; a live request-pending lineage always carries its row. So a missing row for a claim whose worker
        // has ended means the lineage is FINISHED: CLOSE it (LineageEnded), restoring the pre-settlement behaviour
        // where an ended worker closed its own claim. Reporting this Unknown instead would leave a permanently-red,
        // uncloseable claim on every settlement pass -- a rung lowered without declaration (DESIGN §4b meta-obligation
        // 3). Only an UNREADABLE ledger (AttemptsRefused, above) is genuinely 'can't tell' and comes back Unknown.
        Absent => LineageEnded
        Present { value: a } =>
          belt_lineage_standing_of_decision(
            belt_continuation_decision_for_progress(
              instance: instance,
              node_id: node_id,
              progress: belt_workflow_progress_for_attempt_ref(instance: instance, panes: panes, attempt: a),
            ),
          )
      }
  }
}

// THE DECISION OVER ONE ATTEMPT'S OWN FACTS, built from one progress row.
fn belt_continuation_decision_for_progress(instance: HostDashboardInstance, node_id: RoadmapNodeId, progress: WorkflowAttemptProgress) -> ContinuationDecision {
  let prior = Present { value: belt_prior_attempt_facts(instance: instance, node_id: node_id, progress: progress) }
  match lineage_retire_read_for_instance(instance: instance, node_id: node_id, attempt_key: progress.attempt_key) {
    LineageRetireAbsent => continuation_decision_with_retirement(prior: prior, retire: none)
    LineageRetireFound { record } => continuation_decision_with_retirement(prior: prior, retire: Present { value: record })
    LineageRetireUnreadable { reason } =>
      ContinuationRefused { reason: join(["the lineage's retire record is present but unreadable, so the lineage is neither retired nor trusted: ", reason], "") }
  }
}

fn belt_prior_attempt_facts(instance: HostDashboardInstance, node_id: RoadmapNodeId, progress: WorkflowAttemptProgress) -> PriorAttemptFacts {
  let recovery = belt_prior_attempt_recovery(instance: instance, node_id: node_id, attempt_key: progress.attempt_key)
  PriorAttemptFacts {
    node_id: node_id as String,
    attempt_key: progress.attempt_key,
    branch: progress.branch,
    worker_terminal: belt_attempt_worker_terminal(provider: progress.provider, evidence: progress.process),
    capture: belt_prior_attempt_capture(instance: instance, node_id: node_id, attempt_key: progress.attempt_key),
    verification: workflow_segment_of_kind(segments: progress.segments, kind: VerificationWorkflowSegment),
    review: workflow_segment_of_kind(segments: progress.segments, kind: ReviewWorkflowSegment),
    goal_audit: workflow_segment_of_kind(segments: progress.segments, kind: GoalAuditWorkflowSegment),
    recovery: recovery,
    // THE CLOCK THE RE-DELIVERY SCHEDULE IS READ AGAINST, read once for the sweep's facts. No /models wake
    // probe remains: a patient request needs no observation that a card is serving -- the re-delivery IS
    // the probe, and the front's answer to it is the only reading that counts.
    now: now_epoch_seconds(),
    verification_retry: belt_verify_retry_standing(instance: instance, progress: progress),
  }
}

// THE OPERATOR'S RETIRE-LINEAGE ENTRY: admit the request over the node's current lineage facts, then
// commit the create-only record beside the ended attempt's state. The route supplies the authenticated
// principal and the clock; nothing here reads a caller-claimed identity. The branch is never touched.
type BeltLineageRetireOutcome
  = BeltLineageRetired { record: LineageRetireRecord }
  | BeltLineageRetireRefused { step: String, detail: String }

fn belt_lineage_retire_for_instance(instance: HostDashboardInstance, node_id: RoadmapNodeId, attempt_key: String, reason: String, decided_by: String, decided_at: String) -> BeltLineageRetireOutcome {
  match belt_workflow_attempts_observe_for_instance(instance: instance) {
    WorkflowAttemptsRefused { reason: why } =>
      BeltLineageRetireRefused { step: "lineage-retire-ledger", detail: join(["the attempts ledger is unobservable: ", why], "") }
    WorkflowAttemptsObserved { attempts } => {
      let mine = attempts |> filter(p => p.node_id == node_id as String)
      let prior = match mine.first() {
        Absent => none
        Present { value: p } => Present { value: belt_prior_attempt_facts(instance: instance, node_id: node_id, progress: p) }
      }
      match lineage_retire_admission(prior: prior, attempt_key: attempt_key, reason: reason, decided_by: decided_by, decided_at: decided_at) {
        LineageRetireRefused { reason: why } => BeltLineageRetireRefused { step: "lineage-retire-admission", detail: why }
        LineageRetireAdmitted { record } =>
          match lineage_retire_create_for_instance(instance: instance, node_id: node_id, record: record) {
            LineageRetireCommitted { record: committed } => BeltLineageRetired { record: committed }
            LineageRetireCommitRefused { step, detail } => BeltLineageRetireRefused { step: step, detail: detail }
          }
      }
    }
  }
}

// THE NODE PAGE'S RETIREMENT PANEL over the node's attempts (newest first): a record beside the latest
// attempt is shown as recorded; with none, the offer exists only when the unretired decision for that
// attempt is Ended. Every other state shows nothing. It decides nothing: the route re-admits.
fn belt_lineage_retire_panel_for_instance(instance: HostDashboardInstance, node_id: RoadmapNodeId, attempts: List<WorkflowAttemptProgress>) -> LineageRetirePanel {
  match (attempts |> filter(p => p.node_id == node_id as String)).first() {
    Absent => LineageRetirePanelNone
    Present { value: p } =>
      match lineage_retire_read_for_instance(instance: instance, node_id: node_id, attempt_key: p.attempt_key) {
        LineageRetireFound { record } => LineageRetirePanelRecorded { record: record }
        LineageRetireUnreadable { reason } => LineageRetirePanelUnreadable { reason: reason }
        LineageRetireAbsent =>
          match continuation_decision_with_retirement(prior: Present { value: belt_prior_attempt_facts(instance: instance, node_id: node_id, progress: p) }, retire: none) {
            ContinuationEnded { reason: _ } => LineageRetirePanelOffer { attempt_key: p.attempt_key, branch: p.branch }
            ContinuationSpawnFresh { reason: _ } => LineageRetirePanelNone
            ContinuationRefused { reason: _ } => LineageRetirePanelNone
            ContinuationHold { reason: _ } => LineageRetirePanelNone
            ContinuationHoldUntil { reason: _, attempt_key: _, redeliver_at: _ } => LineageRetirePanelNone
            ContinuationComplete { reason: _ } => LineageRetirePanelNone
            ContinuationResume { reason: _, attempt_key: _, ordinal: _, causes: _ } => LineageRetirePanelNone
          }
      }
  }
}

// THE PRIOR SESSION'S RECOVERY STANDING, read from its own event stream (the stream a harness worker
// writes and a resume appends to), so the decision and the harness read one record. An unreadable
// stream reads as no recovery: it can lose a resume, never manufacture one, and the lineage then ends
// exactly as it did before this slice.
fn belt_prior_attempt_recovery(instance: HostDashboardInstance, node_id: RoadmapNodeId, attempt_key: String) -> SessionRecovery {
  let read = Filesystem.Read(path: dispatch_attempt_events_path_for_instance(instance: instance, node_id: node_id, attempt_key: attempt_key))
  if read.success {
    session_recovery_of_events(lines: split(s: read.content, delimiter: "\n") |> filter(l => trim(l) != ""))
  } else {
    SessionRecoveryNone
  }
}

// THE PRIOR ATTEMPT'S CAPTURE, AT ITS OWN HEAD. The spawn decision binds the same fact the
// verify gate binds -- the capture record at the worktree's current head -- through the same
// reader, so the two passes can never disagree about what the terminal worker declared. A head
// that cannot be observed is not a yield: it is unknown, and the decision refuses on it.
fn belt_prior_attempt_capture(instance: HostDashboardInstance, node_id: RoadmapNodeId, attempt_key: String) -> SubmissionCaptureObservation {
  let worktree = dispatch_worktree_path_for_instance(instance: instance, node_id: node_id, attempt_key: attempt_key)
  match belt_worktree_head_observe(instance: instance, worktree: worktree) {
    WorktreeHeadUnobserved { reason } =>
      CaptureUnreadable {
        reason: join(["the prior attempt's worktree head cannot be observed: ", reason], ""),
      }
    WorktreeHeadObserved { revision } =>
      belt_submission_capture_for_head(
        instance: instance,
        worktree: worktree,
        node_id: node_id, attempt_key: attempt_key,
        head_sha: revision as String,
      )
  }
}

fn belt_actuate_spawn_with_origin(
  workdir: String,
  admission_receipt: String,
  provider_wire_label: String,
  launch: LaunchIdentity,
  probed_at: String,
  prepared: PreparedAttemptLaunch,
  request: AttemptLaunchRequest,
  run: DispatchWorkerRun,
) -> BeltSpawnOutcome {
  let addressing = belt_spawn_addressing(prepared: prepared)
  let instance = addressing.instance
  let node = addressing.node
  let attempt_key = addressing.attempt_key
  let resolution = alignment_resolve(
    node_id: node.node as String,
    turns_elapsed: 1,
    state: alignment_base_cadence_state(),
  )
  match belt_resolved_spawn_plan(
    session_uuid: belt_spawn_session_uuid(node_id: node.node as String, attempt_key: attempt_key),
    prepared: prepared,
    resolution: resolution,
    run: run,
  ) {
    DispatchSpawnRefused { step, detail } =>
      SpawnFailed {
        node_id: node.node as String,
        step: step as String,
        detail: detail,
        provider: provider_wire_label,
        launch: launch,
      }
    DispatchSpawnReady { commands: cmds } =>
      match resolution {
        AlignmentUnresolved { cause } =>
          SpawnFailed {
            node_id: node.node as String,
            step: "alignment",
            detail: join(["the spawn plan returned commands for an unresolved chain, which the gate must refuse; fail-closed: ", alignment_refusal_reason(cause: cause)], ""),
            provider: provider_wire_label,
            launch: launch,
          }
        AlignmentReady { chain, due_levels: _, rendered_prompt: _ } =>
          let binding = AlignmentBinding {
            attempt_identity: dispatch_worker_attempt_identity(node_id: node.node as String, attempt_key: attempt_key),
            fingerprint: alignment_chain_fingerprint(chain: chain),
          }
          let process_fingerprint = prepared_attempt_process_fingerprint(prepared: prepared)
  // The continuation route already decided this spawn RESUMES the prior attempt (it re-delivers the
  // same attempt key the continuation named) or starts FRESH; the placement layer takes that from the
  // already-resolved `run` rather than re-deriving it, so there is one decision path beside the door.
  match belt_session_placement_for_container(instance: instance, node_id: node.node as String, attempt_key: attempt_key, container: cmds.session_container, resume: match run { DispatchWorkerFirst => false  DispatchWorkerResumed { ordinal: _ } => true }) {
    BeltPlacementRefused { detail } =>
      SpawnNotAdmitted { node_id: node.node as String, refusal: LaunchNoPlacementGrant { detail: detail } }
    BeltPlacementNotHeld =>
      belt_spawn_admitted(prepared: prepared, workdir: workdir, admission_receipt: admission_receipt, provider_wire_label: provider_wire_label, launch: launch, cmds: cmds, binding: binding, placement: none, request: request, process_fingerprint: process_fingerprint, run: run)
    BeltPlacementHeld { held } =>
      belt_spawn_release_unless_spawned(
        held: held,
        provider_wire_label: provider_wire_label,
        launch: launch,
        outcome: belt_spawn_admitted(prepared: prepared, workdir: workdir, admission_receipt: admission_receipt, provider_wire_label: provider_wire_label, launch: launch, cmds: cmds, binding: binding, placement: Present { value: held }, request: request, process_fingerprint: process_fingerprint, run: run),
      )
  }
  }
  }
}

// THE PER-ATTEMPT PROOF, run by the SPAWN and nothing else. The grant argv come in the spawn bundle
// beside worktree_add, so the sequence is one attempt's by construction: `git worktree add` creates
// .git/worktrees/<key> under the principal that runs the actuator (on the lab, the account the serve
// runs as -- the entry's owner and a member of the attempt group), the two grant commands then put that
// entry and everything under it in the attempt group at the declared arm (02770 on directories, 0664 on the
// walked files), and the walk proves it. THE UNIT IS
// NOT STARTED IF THE PROOF FAILS: a worker whose entry is not granted cannot commit, and starting it
// anyway turns a named refusal into a permission error inside someone else's attempt. The decision is
// the model's own dashboard_git_subtree_readback_is_granted_under over
// dashboard_git_worker_granted_directory_mode -- the same figure the apply and the claims use -- so
// there is no second definition of "granted" to drift, and an EMPTY receipt fails it rather than
// passing it (recurring failure mode directory_ownership_assertion_stops_at_the_top_level).
//
// THE GROUP IS A PARAMETER, NOT A CONSTANT READ HERE, for the reason every other grant in this slice has
// it: the fold compares find's `%g` against the token the grant was told, and a test that groups a
// throwaway tree to a token its own host can resolve is asking the same question of a group name the CI
// host has never heard. THE PRODUCTION CALLER BELOW BINDS fleet_posix_worker_shared_group_name, the row
// fleet_posix_accounts declares and the same row the grant argv were built with; NO DEFAULT, so a call
// site cannot quietly take the production name where it meant to name its own. The dry pairing claim
// the_production_route_names_the_declared_group_in_every_grant_command keeps the production binding
// executed, so the substituted spelling is never the only route through this gate.
fn belt_worker_git_entry_grant_readback(
  cmds: DispatchSpawnCommands,
  workdir: String,
  group: NonEmptyStr,
) -> BeltExecStepsOutcome {
  match belt_exec(cmd: cmds.worker_git_entry_readback, workdir: workdir) {
    ExecOk { stdout: receipt } =>
      if dashboard_git_subtree_readback_is_granted_under(
        top: dashboard_git_worker_granted_directory_mode,
        // THE GROUP HALF OF THE GRANT, ON EVERY LINE. Without this leg the gate starts the worker unit
        // on a tree at the right MODES and the wrong GROUP -- which is exactly the pre-migration state of
        // the lab tree this slice exists to repair (briansrls:briansrls at 0775 read as granted), and the
        // worker's first commit dies on a permission error inside a tree the belt just certified.
        group: group,
        // THE ENTRY'S OWN DECISION: its files DO carry group-write, because logs/HEAD in this very entry
        // is a reflog the worker's commit appends to (dashboard_git_worker_entry_writes_files_in_place).
        // A receipt whose reflog came back at git's read-only 0444 therefore refuses here -- which is the
        // state that makes the worker's first commit die on "unable to append", so the unit is not started.
        files_group_writable: dashboard_git_worker_entry_writes_files_in_place(),
        receipt: receipt,
      ) {
        ExecStepsOk
      } else {
        ExecStepFailed {
          step: "worker-git-entry-readback",
          // THE EXPECTED TOP IS NAMED BY THE ARM THE GATE DECIDES ON, not by a figure typed beside it:
          // the same rendering the install passes to `install -d -m` and the fold compares against
          // (dashboard_git_worker_directory_mode_octal over dashboard_git_worker_granted_directory_mode).
          // A hand-typed mode here is a third spelling of one fact, and it is how this gate started
          // reporting a mode its own decision no longer used.
          detail: join(
            [
              "the attempt's private git entry did not read back granted (expected ",
              dashboard_git_worker_directory_mode_octal(mode: dashboard_git_worker_granted_directory_mode),
              " on the entry, group-writable entries beneath it; an empty or unreadable walk counts as not",
              " granted), so the worker unit is not started",
            ],
            "",
          ) as NonEmptyStr,
        }
      }
    ExecFailed { program: _, exit_code, stderr } =>
      ExecStepFailed {
        step: "worker-git-entry-readback",
        detail: join(["the grant walk could not run: exit ", to_string(exit_code), ": ", stderr], ""),
      }
    ExecRefused { program: _, reason } =>
      ExecStepFailed { step: "worker-git-entry-readback", detail: reason }
  }
}

// THE ADMITTED SPAWN'S HOST STEPS, carrying the session's placement grant when its container holds
// one. Extracted from belt_actuate_spawn_with_origin so the grant's release-unless-spawned rule
// wraps ONE outcome rather than every SpawnFailed arm separately. It addresses the prepared launch's
// attempt (belt_spawn_addressing) and runs the commands the spawn plan built from that same launch;
// because the commands still arrive beside the launch, the one route that builds both from one
// value is the only caller admitted.
fn belt_spawn_admitted(
  prepared: PreparedAttemptLaunch,
  workdir: String,
  admission_receipt: String,
  provider_wire_label: String,
  launch: LaunchIdentity,
  cmds: DispatchSpawnCommands,
  binding: AlignmentBinding,
  placement: BeltHeldPlacement?,
  request: AttemptLaunchRequest,
  process_fingerprint: NonEmptyStr,
  run: DispatchWorkerRun,
) -> BeltSpawnOutcome
  admit_callers: [
    decl_ref(module_path: "gunbc.roadmap.roadmap_belt_actuate", decl_name: "belt_actuate_spawn_with_origin"),
  ]
{
  let addressing = belt_spawn_addressing(prepared: prepared)
  let instance = addressing.instance
  let node = addressing.node
  let attempt_key = addressing.attempt_key
  let session_name = addressing.session_name
  match belt_spawn_stage(
    prepared: prepared, workdir: workdir, admission_receipt: admission_receipt,
    provider_wire_label: provider_wire_label, launch: launch, cmds: cmds, binding: binding,
    request: request, process_fingerprint: process_fingerprint, run: run,
  ) {
    Present { value: failed } => failed
    Absent =>
              match belt_credential_admit_before_spawn(prepared: prepared) {
                BeltCredentialAdmitLost { detail } =>
                  SpawnFailed {
                    node_id: node.node as String,
                    step: "credential-begin-launch",
                    detail: detail,
                    provider: provider_wire_label,
                    launch: launch,
                  }
                BeltCredentialAdmitOk =>
              match belt_session_container_create(
                instance: instance,
                attempt_key: attempt_key,
                container: cmds.session_container,
                placement: placement,
                workdir: workdir,
              ) {
                ContainerCreateFailed { step, detail } =>
                  SpawnFailed {
                    node_id: node.node as String,
                    step: step,
                    detail: belt_persist_spawn_failure_for_instance(
                      instance: instance,
                      node: node,
                      attempt_key: attempt_key,
                      step: step,
                      detail: detail,
                    ),
                    provider: provider_wire_label,
                    launch: launch,
                  }
                ContainerCreatePending { entry } =>
                  SpawnLaunchPending {
                    node_id: node.node as String,
                    session_name: session_name,
                    provider: provider_wire_label,
                    launch: launch,
                    entry: entry,
                  }
                ContainerCreated =>
                  match belt_exec_steps(
                    steps: belt_session_container_start_steps(container: cmds.session_container),
                    workdir: workdir,
                  ) {
                    ExecStepsOk =>
                      Spawned {
                        node_id: node.node as String,
                        session_name: session_name,
                        provider: provider_wire_label,
                        launch: launch,
                      }
                    ExecStepFailed { step, detail } => {
                      let cleanup = belt_created_session_cleanup_detail(
                        instance: instance,
                        session_name: session_name,
                      )
                      let full_detail = join([
                        detail,
                        "; ",
                        cleanup,
                      ], "")
                      SpawnFailed {
                        node_id: node.node as String,
                        step: step,
                        detail: belt_persist_spawn_failure_for_instance(
                          instance: instance,
                          node: node,
                          attempt_key: attempt_key,
                          step: step,
                          detail: full_detail,
                        ),
                        provider: provider_wire_label,
                        launch: launch,
                      }
                    }
                  }
              }
              }
  }
}

// THE STAGING A SPAWN NEEDS BEFORE ITS CONTAINER STARTS, per run. A first run branches a worktree,
// prepares and initializes the attempt's state and publishes it as the node's current attempt. A
// RESUME stages none of that: the worktree, the state and the pointer are the prior run's and are
// exactly what a resume continues, so the only staging is the observation that the worktree is still
// there. Staging a resume as a first run would write the attempt's state over the session it is
// meant to continue. Absent is staged; Present is the failure that stops the spawn.
fn belt_spawn_stage(
  prepared: PreparedAttemptLaunch,
  workdir: String,
  admission_receipt: String,
  provider_wire_label: String,
  launch: LaunchIdentity,
  cmds: DispatchSpawnCommands,
  binding: AlignmentBinding,
  request: AttemptLaunchRequest,
  process_fingerprint: NonEmptyStr,
  run: DispatchWorkerRun,
) -> BeltSpawnOutcome? {
  let addressing = belt_spawn_addressing(prepared: prepared)
  let instance = addressing.instance
  let node = addressing.node
  let attempt_key = addressing.attempt_key
  match run {
    DispatchWorkerResumed { ordinal: _ } =>
      match belt_attempt_worktree_observe(instance: instance, node_id: node.node, attempt_key: attempt_key) {
        AttemptWorktreePresent { path: _ } =>
          match belt_worker_traversal_before_spawn(instance: instance, container: cmds.session_container) {
            ExecStepFailed { step, detail } =>
              Present { value: SpawnFailed { node_id: node.node as String, step: step, detail: detail, provider: provider_wire_label, launch: launch } }
            ExecStepsOk => none
          }
        AttemptWorktreeAbsent { path } =>
          Present { value: SpawnFailed {
            node_id: node.node as String,
            step: "resume-worktree",
            detail: join(["the session to resume has no worktree at ", path, "; its work is not where the resume would continue it"], ""),
            provider: provider_wire_label,
            launch: launch,
          } }
        AttemptWorktreeUnobserved { path, cause } =>
          Present { value: SpawnFailed {
            node_id: node.node as String,
            step: "resume-worktree",
            detail: join(["the worktree at ", path, " could not be observed before resuming: ", cause], ""),
            provider: provider_wire_label,
            launch: launch,
          } }
      }
    DispatchWorkerFirst =>
      match belt_worktree_claim_before_add(instance: instance, node_id: node.node as String, attempt_key: attempt_key) {
        WorktreeClaimNotRecorded { detail } =>
          Present { value: SpawnFailed { node_id: node.node as String, step: "worktree-claim", detail: detail, provider: provider_wire_label, launch: launch } }
        WorktreeClaimRecorded =>
      match belt_exec_steps(
        steps: concat(
          [BeltExecStep { step: "worktree-add", command: cmds.worktree_add }],
          concat(
            concat(
              map(
                cmds.worker_git_entry_grant,
                command => BeltExecStep { step: "worker-git-entry-grant", command: command },
              ),
              map(cmds.worker_worktree_grant, command => BeltExecStep { step: "worker-worktree-grant", command: command }),
            ),
            map(cmds.attempt_state_prepare, command => BeltExecStep { step: "attempt-state-prepare", command: command }),
          ),
        ),
        workdir: workdir,
      ) {
        ExecStepFailed { step, detail } =>
          Present { value: SpawnFailed { node_id: node.node as String, step: step, detail: detail, provider: provider_wire_label, launch: launch } }
        ExecStepsOk =>
      match belt_worker_git_entry_grant_readback(
        cmds: cmds,
        workdir: workdir,
        // THE PRODUCTION BINDING, AT THE SPAWN THAT RUNS THIS GATE: the group the grant argv in the same
        // bundle were told, read from the row that declares it. The gate and the grant cannot disagree,
        // because neither of them spells a group name.
        group: fleet_posix_worker_shared_group_name,
      ) {
        ExecStepFailed { step, detail } =>
          Present { value: SpawnFailed { node_id: node.node as String, step: step, detail: detail, provider: provider_wire_label, launch: launch } }
        ExecStepsOk =>
          match belt_attempt_worktree_observe(instance: instance, node_id: node.node, attempt_key: attempt_key) {
            AttemptWorktreeAbsent { path } =>
              Present { value: SpawnFailed {
                node_id: node.node as String,
                step: "worktree-establish",
                detail: join(["git worktree add reported success and no worktree is present at ", path], ""),
                provider: provider_wire_label,
                launch: launch,
              } }
            AttemptWorktreeUnobserved { path, cause } =>
              Present { value: SpawnFailed {
                node_id: node.node as String,
                step: "worktree-establish",
                detail: join(["the worktree at ", path, " could not be observed after git worktree add: ", cause], ""),
                provider: provider_wire_label,
                launch: launch,
              } }
            AttemptWorktreePresent { path: _ } =>
              match belt_worker_traversal_before_spawn(instance: instance, container: cmds.session_container) {
                ExecStepFailed { step, detail } =>
                  Present { value: SpawnFailed { node_id: node.node as String, step: step, detail: detail, provider: provider_wire_label, launch: launch } }
                ExecStepsOk =>
              match belt_attempt_state_initialize_for_instance(
                instance: instance,
                node: node,
                attempt_key: attempt_key,
                admission_receipt: admission_receipt,
                launch: launch,
                binding: binding,
                request: request,
                process_fingerprint: process_fingerprint,
                executor: prepared_attempt_executor_origin(prepared: prepared),
              ) {
                AttemptStateInitializationFailed { step, detail } =>
                  Present { value: SpawnFailed { node_id: node.node as String, step: step, detail: detail, provider: provider_wire_label, launch: launch } }
                AttemptStateInitialized =>
                  match belt_exec_steps(
                    steps: [BeltExecStep { step: "attempt-current-publish", command: cmds.attempt_current_pointer }],
                    workdir: workdir,
                  ) {
                    ExecStepFailed { step, detail } =>
                      Present { value: SpawnFailed { node_id: node.node as String, step: step, detail: detail, provider: provider_wire_label, launch: launch } }
                    ExecStepsOk => none
                  }
              }
              }
          }
      }
      }
      }
  }
}

// ONE ROSTER READ PER SPAWN, BOUND HERE AND CARRIED. This site preflighted and labelled a provider
// from one live selection, and belt_resolved_spawn_plan then read the roster AGAIN beneath it -- and
// it was that second answer whose model reached the process. If the roster moved between the two, a
// replica dropping out being exactly the event this fleet sees, the preflighted provider and the
// spawned one could disagree with nothing recording it. That is the same class the observe fold
// closed, sitting on the one route where the model actually reaches a process, and this module's own
// rule is that the fix is the carrier rather than the call.
fn belt_actuate_spawn(node: RoadmapNode, probed_at: String, workdir: String, launch: LaunchIdentity) -> BeltSpawnOutcome {
  let instance = srv1_live_dashboard_instance()
  match dispatch_environment_admit(
    contract: node.execution,
    environment: instance.execution_environment,
  ) {
    EnvironmentRefused { receipts, validation_summary, reason } =>
      SpawnFailed {
        node_id: node.node as String,
        step: "environment-admission",
        detail: dispatch_environment_admission_json(
          admission: EnvironmentRefused {
            receipts: receipts,
            validation_summary: validation_summary,
            reason: reason,
          },
        ),
        provider: belt_dispatch_spawn_unselected_provider_wire_label(),
        launch: launch,
      }
    EnvironmentAdmitted { receipts, validation_summary } => {
      match dispatch_attempt_identity_mint(instance: instance, node_id: node.node, minted_at: probed_at) {
        DispatchAttemptIdentityRefused { detail } =>
          SpawnFailed {
            node_id: node.node as String,
            step: "attempt-identity",
            detail: detail,
            provider: belt_dispatch_spawn_unselected_provider_wire_label(),
            launch: launch,
          }
        DispatchAttemptMinted { attempt_key: minted_key, ordinal: _ } => {
      match dispatch_harness_attempt_selection(
        attempt: DispatchAttempt {
          instance: instance,
          node: node,
          attempt_key: minted_key,
        },
        sizing_expectation: sizing_profile_expectation(d: node_sizing_derivation(rn: node)),
      ) {
        DispatchAttemptSelectionRefused { reason } =>
          SpawnFailed {
            node_id: node.node as String,
            step: "dispatch-selection",
            detail: reason as String,
            provider: belt_dispatch_spawn_selection_refused_provider_wire_label(reason: reason),
            launch: launch,
          }
        DispatchAttemptPrepared { prepared } => {
          let provider = prepared_attempt_provider(prepared: prepared)
          match belt_provider_preflight(provider: provider) {
            ProviderPreflightRefused { step: st, detail: d } =>
              SpawnFailed {
                node_id: node.node as String,
                step: st,
                detail: d,
                provider: belt_dispatch_spawn_provider_wire_label(provider: provider),
                launch: launch,
              }
            ProviderPreflightOk =>
              belt_actuate_spawn_exec(
                probed_at: probed_at,
                workdir: workdir,
                admission_receipt: dispatch_environment_admission_json(
                  admission: EnvironmentAdmitted {
                    receipts: receipts,
                    validation_summary: validation_summary,
                  },
                ),
                provider_wire_label: belt_dispatch_spawn_provider_wire_label(provider: provider),
                launch: launch,
                prepared: prepared,
              )
          }
        }
      }
            }
      }
    }
  }
}

fn belt_actuate_spawn_exec(
  probed_at: String,
  workdir: String,
  admission_receipt: String,
  provider_wire_label: String,
  launch: LaunchIdentity,
  prepared: PreparedAttemptLaunch,
) -> BeltSpawnOutcome {
  belt_actuate_spawn_exec_modeled(
    probed_at: probed_at,
    workdir: workdir,
    admission_receipt: admission_receipt,
    provider_wire_label: provider_wire_label,
    launch: launch,
    prepared: prepared,
    request: LaunchAutonomous,
    decision: belt_continuation_decision_for_instance(
      instance: prepared_attempt(prepared: prepared).instance,
      node: prepared_attempt(prepared: prepared).node,
    ),
  )
}

type BeltTeardownOutcome
  = ReapedSession { session_name: String }
  | TeardownFailed { session_name: String, detail: String }

type BeltCurrentAttemptKey
  = BeltCurrentAttemptKeyRead { key: String }
  | BeltCurrentAttemptKeyUnreadable { reason: String }

fn belt_current_attempt_key_read(instance: HostDashboardInstance, node_id: String) -> BeltCurrentAttemptKey {
  let read = Filesystem.Read(
    path: dispatch_current_attempt_key_path_for_instance(
      instance: instance,
      node_id: node_id as RoadmapNodeId,
    ),
  )
  match filesystem_read_outcome(content: read.content, success: read.success, error: read.error) {
    FilesystemReadRefused { error } =>
      BeltCurrentAttemptKeyUnreadable { reason: error }
    FilesystemReadSucceeded { content } => {
      let key = trim(s: content)
      if key == "" {
        BeltCurrentAttemptKeyUnreadable {
          reason: "the node's current-attempt-key pointer is empty",
        }
      } else {
        BeltCurrentAttemptKeyRead { key: key }
      }
    }
  }
}

fn belt_dead_attempt_pane_standing(
  panes: BeltAttemptPanes,
  session_name: String,
) -> BeltDeadAttemptPane {
  match panes {
    BeltAttemptPanesRefused { reason } =>
      BeltDeadAttemptPaneUnobserved { reason: reason }
    BeltAttemptPanesObserved { panes: observed } => {
      let matched = observed |> filter(pane => pane.session_name == session_name)
      match matched.first() {
        Absent => BeltDeadAttemptPaneAbsent
        Present { value: pane } =>
          match pane.standing {
            TmuxAttemptPaneAlive => BeltDeadAttemptPaneLive
            TmuxAttemptPaneExited { status } =>
              BeltDeadAttemptPaneEnded { death: VendorPaneExited { status: status } }
            TmuxAttemptPaneSignaled { signal } =>
              BeltDeadAttemptPaneEnded { death: VendorPaneSignaled { signal: signal } }
          }
      }
    }
  }
}

type BeltDeadAttemptPane
  = BeltDeadAttemptPaneEnded { death: VendorPaneDeath }
  | BeltDeadAttemptPaneLive
  | BeltDeadAttemptPaneAbsent
  | BeltDeadAttemptPaneUnobserved { reason: String }

fn belt_reap_session_for_instance(
  instance: HostDashboardInstance,
  session_name: String,
) -> BeltTeardownOutcome {
  match belt_exec(
    cmd: tmux_kill_session_argv_for_instance(
      instance: instance,
      session_name: session_name,
    ),
    workdir: belt_observe_workdir as String,
  ) {
    ExecOk { stdout: _ } => ReapedSession { session_name: session_name }
    ExecFailed { program: _, exit_code: _, stderr: e } =>
      TeardownFailed { session_name: session_name, detail: e }
    ExecRefused { program: _, reason: r } =>
      TeardownFailed { session_name: session_name, detail: r }
  }
}

fn belt_preserve_dead_pane_exit_then_reap(
  instance: HostDashboardInstance,
  session_name: String,
  node_id: String,
  death: VendorPaneDeath,
) -> BeltTeardownOutcome {
  match belt_current_attempt_key_read(instance: instance, node_id: node_id) {
    BeltCurrentAttemptKeyUnreadable { reason } =>
      TeardownFailed {
        session_name: session_name,
        detail: join(["exit record write refused; dead pane kept: attempt key unreadable: ", reason], ""),
      }
    BeltCurrentAttemptKeyRead { key } =>
      match attempt_exit_record_put_vendor_pane_death(
        instance_root: instance.instance_root as String,
        node_id: node_id,
        attempt_key: key,
        death: death,
      ) {
        AttemptExitRecordPutFailed { reason } =>
          TeardownFailed {
            session_name: session_name,
            detail: join(["exit record write failed; dead pane kept: ", reason], ""),
          }
        AttemptExitRecordPutOk =>
          belt_reap_session_for_instance(instance: instance, session_name: session_name)
      }
  }
}

fn belt_actuate_teardown_for_instance(
  instance: HostDashboardInstance,
  session_name: String,
) -> BeltTeardownOutcome {
  let node_id = dispatch_node_id_from_session_name(session_name: session_name)
  match belt_dead_attempt_pane_standing(
    panes: belt_attempt_panes_observe_for_instance(instance: instance),
    session_name: session_name,
  ) {
    BeltDeadAttemptPaneUnobserved { reason } =>
      TeardownFailed {
        session_name: session_name,
        detail: join(["teardown refused; pane evidence unobserved: ", reason], ""),
      }
    BeltDeadAttemptPaneEnded { death } =>
      belt_preserve_dead_pane_exit_then_reap(
        instance: instance,
        session_name: session_name,
        node_id: node_id,
        death: death,
      )
    BeltDeadAttemptPaneLive =>
      belt_reap_session_for_instance(instance: instance, session_name: session_name)
    BeltDeadAttemptPaneAbsent =>
      belt_reap_session_for_instance(instance: instance, session_name: session_name)
  }
}

fn belt_actuate_teardown(session_name: String) -> BeltTeardownOutcome {
  belt_actuate_teardown_for_instance(
    instance: srv1_live_dashboard_instance(),
    session_name: session_name,
  )
}

// The reconcile guarantees spawns are DesiredMembers (carry the RoadmapNode for the brief) and
// teardowns ObservedMembers (carry the live session). The cross arms are unreachable by
// construction; if reached they REFUSE (typed SpawnFailed/TeardownFailed), never a fabricated
// action — DESIGN §5 (no spawn without a node model, no teardown without an observed session).
data belt_session_uuid_salt: NonEmptyStr = "belt-session-uuid-v1" as NonEmptyStr

// The UUID is the Claude provider's --session-id input (Claude requires a valid UUID). It is
// computed for every provider so dispatch_spawn_commands_for_launch has one arity, but CodexCliProvider
// ignores it and lets Codex mint its persisted thread id. For Claude it is ATTEMPT-scoped (U1
// redispatch fix 2026-07-25): (node_id x the spawn's clock observation) reshaped to RFC-4122 v4;
// the earlier node-deterministic derivation made every node one-shot at the Claude layer. Reconcile
// idempotency never keys on it — the node-grain tmux session name is the observation key.
fn belt_uuid_stamped_id(node_id: String, attempt_key: String) -> NonEmptyStr {
  join([node_id, "\n", attempt_key], "") as NonEmptyStr
}

fn belt_uuid_hex32(node_id: String, attempt_key: String) -> String {
  concat(
    content_hash_atom(value: belt_uuid_stamped_id(node_id: node_id, attempt_key: attempt_key)).digest as String,
    content_hash_combine_structural(
      left: content_hash_atom(value: belt_uuid_stamped_id(node_id: node_id, attempt_key: attempt_key)),
      right: content_hash_atom(value: belt_session_uuid_salt),
    ).digest as String,
  )
}

fn belt_uuid_rfc4122(hex: String) -> String {
  concat(substring(s: hex, start: 0, end: 12),
  concat("4",
  concat(substring(s: hex, start: 13, end: 16),
  concat("8",
  substring(s: hex, start: 17, end: 32)))))
}

fn belt_uuid_dash(v: String) -> String {
  concat(substring(s: v, start: 0, end: 8),
  concat("-",
  concat(substring(s: v, start: 8, end: 12),
  concat("-",
  concat(substring(s: v, start: 12, end: 16),
  concat("-",
  concat(substring(s: v, start: 16, end: 20),
  concat("-",
  substring(s: v, start: 20, end: 32)))))))))
}

// THE SPAWN CONSUMES THE SELECTION THE ADMISSION ALREADY MADE, rather than re-deriving it through
// the vendor selector.
//
// This call used to hand default_provider_selection_request() to the vendor path, which then chose
// a provider for itself. That was already a second decision beside dispatch_actuator_selection --
// two answers to "who executes this attempt", reconciled by both happening to say Codex -- and it
// became visible the moment they could disagree: the dispatch receipt reported provider
// "gunbc-harness" from the first decision while the spawn refused with the vendor selector's
// "no provider offer is selection-eligible" from the second. One route reporting another route's
// refusal is the forked-authority shape DESIGN section 3 names.
//
// dispatch_spawn_commands_for_launch takes the prepared launch and skips the inventory entirely. So
// the selection is made once, for the belt's attempt, and the spawn consumes what it prepared.
fn belt_resolved_spawn_plan(
  session_uuid: String,
  prepared: PreparedAttemptLaunch,
  resolution: AlignmentResolution,
  run: DispatchWorkerRun,
) -> DispatchSpawnPlan {
  dispatch_spawn_commands_for_launch(
    prepared: prepared,
    session_uuid: session_uuid,
    resolution: resolution,
    run: run,
  )
}

fn belt_spawn_session_uuid(node_id: String, attempt_key: String) -> String {
  belt_uuid_dash(v: belt_uuid_rfc4122(hex: belt_uuid_hex32(node_id: node_id, attempt_key: attempt_key)))
}

fn belt_actuate_spawn_member(m: DispatchMember, workdir: String, launch: LaunchIdentity) -> BeltSpawnOutcome {
  match m {
    DesiredMember { node_id: nid, node: node } =>
      match clock_now_probed_at() {
        Present { value: probed_at } =>
          belt_actuate_spawn(node: node, probed_at: probed_at as String, workdir: workdir, launch: launch)
        Absent =>
          SpawnFailed {
            node_id: nid,
            step: "attempt-clock",
            detail: "clock observation refused; an attempt without a stamp would collide with a later one — fail-closed, no unknown-stamped attempts",
            provider: belt_dispatch_spawn_unselected_provider_wire_label(),
            launch: launch,
          }
      }
    ObservedMember { node_id: nid, session: _ } =>
      SpawnFailed {
        node_id: nid,
        step: "member-shape",
        detail: "belt spawn expected DesiredMember (carries node for brief); got ObservedMember — fail-closed, no spawn without a node model",
        provider: belt_dispatch_spawn_unselected_provider_wire_label(),
        launch: launch,
      }
  }
}

fn belt_actuate_teardown_member_for_instance(
  instance: HostDashboardInstance,
  m: DispatchMember,
) -> BeltTeardownOutcome {
  match m {
    ObservedMember { node_id: _, session: session } =>
      belt_actuate_teardown_for_instance(
        instance: instance,
        session_name: session.session_name,
      )
    DesiredMember { node_id: nid, node: _ } =>
      TeardownFailed {
        session_name: nid,
        detail: "belt teardown expected ObservedMember (carries live session); got DesiredMember — fail-closed, no teardown without an observed session",
      }
  }
}

fn belt_actuate_teardown_member(m: DispatchMember) -> BeltTeardownOutcome {
  belt_actuate_teardown_member_for_instance(
    instance: srv1_live_dashboard_instance(),
    m: m,
  )
}

type BeltObserve
  = BeltSessionsObserved { live: List<DispatchLiveSession> }
  | ObserveRefused { reason: String }

// tmux-present is the FIRST precondition: tmux not on PATH -> ObserveRefused (the belt cannot know
// what is live). Once present, the observe half must NOT widen an exec failure into a zero-session
// answer (§5 absorbing fallback, ⊤-as-answer vs ⊤-as-ignorance). extdeps.tmux
// classify_tmux_session_list is the sole authority for tmux ls outcome facts (listed sessions,
// documented no-server signals, stdout parse refusal, unknowable stderr); this module maps them to
// belt policy only: TmuxSessionsListed -> filter dispatch sessions into BeltSessionsObserved live rows;
// TmuxNoServer -> BeltSessionsObserved []; TmuxListStdoutRefused and TmuxListUnknowable -> ObserveRefused with
// located evidence, never a blind spawn/reap. First-tick bootstrap works under either no-server
// spelling the classifier admits. The decision is a pure fn so every arm is witnessed
// (belt_observe_from_result witnesses); belt_observe only threads live WitnessBin.Run fields in.
fn belt_ls_stdout_refusal_reason(
  line_number: Int,
  raw: String,
  reason: String,
) -> String {
  join([
    "belt_observe: tmux ls stdout parse refused at line ",
    to_string(line_number),
    ": ",
    reason,
    "; raw=",
    raw,
    " — the live session set is unknowable; fail-closed, no blind spawn/reap",
  ], "")
}

fn belt_observe_from_result(
  success: Bool,
  stdout: String,
  stderr: String,
) -> BeltObserve {
  match classify_tmux_session_list(exit_ok: success, stdout: stdout, stderr: stderr) {
    TmuxSessionsListed { entries } =>
      BeltSessionsObserved {
        live: dispatch_live_sessions_from_entries(
          entries: entries,
          selection: dispatch_actuator_selection(sizing_expectation: NoDerivedSizingExpectation),
        ),
      }
    TmuxNoServer { evidence: _ } =>
      BeltSessionsObserved { live: [] }
    TmuxListStdoutRefused { line_number, raw, reason } =>
      ObserveRefused {
        reason: belt_ls_stdout_refusal_reason(
          line_number: line_number,
          raw: raw,
          reason: reason,
        ),
      }
    TmuxListUnknowable { stderr: e } =>
      ObserveRefused {
        reason: concat(
          "belt_observe: tmux ls exited nonzero with no documented no-server/no-sessions signal — the live session set is unknowable; fail-closed, no blind spawn/reap. stderr: ",
          e,
        ),
      }
  }
}

// belt_observe and belt_observe_for_instance ARE DELETED: they observed the tmux session NAME set
// only, so a retained dead pane read as a live agent — the defect this arc removed. Dispatch and
// tick now call belt_sessions_observe_for_instance, which classifies each row's process evidence.
//
// belt_observe_from_result SURVIVES DELIBERATELY, reached only by witnesses. Its subject is the
// tmux stdout parse (nonzero exit with no documented no-server marker, unparseable line, empty
// set); deleting it would delete that evidence with the caller — §4b: a climb dissolves lower-rung
// production handling, never the discriminating evidence. Its parse duty is subsumed by
// classify_tmux_session_list, which the live observer uses; dissolve-on: those parse witnesses
// re-pointed at classify_tmux_session_list with the refusal cases preserved one-for-one, at which
// point this function and this note go together.
type BeltPassOutcome
  = BeltPassRecorded
  | BeltPassDeferred { reason: String }
  | BeltPassRefused { reason: String }
  | BeltPassFailed { reason: String }

// THE EXECUTION STANDING (RLM-2 ruling section 6): a receipt names the instance that ticked, the
// revision the instance was serving, and the mode the tick ran under -- or says why it could not
// bind those -- so a reader can tell a fresh tick of THIS deployment from any other file that
// parses. `receipt_identity` is DERIVED from the members (belt_tick_receipt_identity_hex), written
// on the wire and verified on decode; it is not a stored field, because a stored copy would be a
// second authority for what the members already say.
type BeltTickExecutionStanding
  = TickExecuted { instance_id: String, deployed_revision: String, spawn_mode: SpawnMode }
  | TickExecutionWithheld { refusal: String }

type BeltTickReceipt {
  observed_at: String,
  execution: BeltTickExecutionStanding,
  launches: List<LaunchIdentity>,
  spawn_pass: BeltPassOutcome,
  teardown_pass: BeltPassOutcome,
  seat_discharge_pass: BeltPassOutcome,
  discovery_pass: BeltPassOutcome,
}

type BeltTickReceiptRead
  = BeltTickReceiptPresent { receipt: BeltTickReceipt }
  | BeltTickReceiptAbsent
  | BeltTickReceiptUnreadable { reason: String }

// THE PERSISTED TICK RECEIPT IS WHAT THE WORKFLOW UI READS to say whether a tick ran, deferred,
// refused or failed — previously only journald stdout, so the row could not say 'Verification
// queued - next belt tick' or 'blocked - belt session observation refused'. Each pass is typed
// independently (BeltPassOutcome): spawn/teardown depend on tmux session observation; verify only
// on the attempt ledger plus terminal provider/process evidence; publish on exact verified head
// plus repository observation. A tmux-list refusal may block spawn/reap while verify still examines
// its own evidence (DESIGN section 5: refuse narrowly, never widen to zeroing sibling passes).
// Written to the instance's receipts directory (gunbc.host.host_layout instance_receipts_dir) so
// /workflow.json reads it without re-running the belt. CORRECTED 2026-08-19: this sentence read
// 'beside the instance's attempt-state root', wrong two ways and recorded rather than reworded. The
// code wrote <instance_root>/belt-last-tick.json, a root-owned directory, so the receipt was EACCES
// and absent on every instance. And the attempt-state root is not per-instance: the srv1 pair is
// DispatchStateHostShared, so blue and green resolve it to ONE path and a receipt there would
// answer for two instances. A note describing a home the implementation did not and could not
// safely use is the stale-authority class of DESIGN section 3.
// v7 (dogfood intervention #6): the tick no longer captures, verifies, publishes or meters, so it no
// longer reports those passes. It reports the passes it still runs -- spawn and teardown -- and the
// discovery pass that hands outstanding obligations to their units. What each attempt's obligations
// did is that attempt's own receipt (belt_attempt_obligation_receipt_path).
data belt_tick_receipt_schema: String = "roadmap-belt-tick-receipt/v8"

// THE RECEIPT HAD NO WRITABLE HOME AND HAS NEVER BEEN WRITTEN ON ANY INSTANCE. The path was
// <instance_root>/belt-last-tick.json; every instance_root on srv1 is root:root 0755 while the belt
// runs as the service user, so the write was EACCES on blue and green alike and the file was absent
// from both on 2026-08-19. The workflow UI reads this receipt to say whether a tick ran, deferred,
// refused or failed, so its absence is exactly the operator's "nothing seems to be changing": the
// belt could run and leave the row nothing to render.
//
// The fix is a home the service principal owns, not an elevation at write time: the instance's
// receipts directory, bootstrapped by the deploy through the granted install -d -o <service-user>
// (live_deploy.emit BeltEventPathUnit apply) — the mechanism and reasoning
// fleet_converge_receipt_atomic_publish_note records for the converge receipt beside it.
//
// NOT the dispatch attempt-state root, though service-user-owned and closer-looking: the srv1 pair
// is DispatchStateHostShared, so blue and green resolve
// dashboard_instance_dispatch_attempt_state_root to ONE path and a receipt there would answer for
// two instances. Deriving from instance_root keeps it per-instance by construction.
fn belt_tick_receipt_path_for_instance(instance: HostDashboardInstance) -> String {
  join([
    instance_receipts_dir(instance_root: instance.instance_root as String),
    "/belt-last-tick.json",
  ], "")
}

fn belt_pass_outcome_key(o: BeltPassOutcome) -> String {
  match o {
    BeltPassRecorded => "recorded"
    BeltPassDeferred { reason: _ } => "deferred"
    BeltPassRefused { reason: _ } => "refused"
    BeltPassFailed { reason: _ } => "failed"
  }
}

fn belt_pass_outcome_json(o: BeltPassOutcome) -> JsonValue {
  match o {
    BeltPassRecorded =>
      json_object(members: [
        json_kv(key: "outcome", value: json_string(s: "recorded")),
      ])
    BeltPassDeferred { reason: r } =>
      json_object(members: [
        json_kv(key: "outcome", value: json_string(s: "deferred")),
        json_kv(key: "reason", value: json_string(s: r)),
      ])
    BeltPassRefused { reason: r } =>
      json_object(members: [
        json_kv(key: "outcome", value: json_string(s: "refused")),
        json_kv(key: "reason", value: json_string(s: r)),
      ])
    BeltPassFailed { reason: r } =>
      json_object(members: [
        json_kv(key: "outcome", value: json_string(s: "failed")),
        json_kv(key: "reason", value: json_string(s: r)),
      ])
  }
}

type BeltPassOutcomeDecode
  = BeltPassOutcomeDecoded { outcome: BeltPassOutcome }
  | BeltPassOutcomeUnreadable { reason: String }

fn belt_pass_outcome_from_json(doc: JsonValue) -> BeltPassOutcomeDecode {
  match json_object_unique_member(v: doc, key: "outcome") {
    JsonMemberFound { value: JsonString { value: outcome } } =>
      match outcome {
        "recorded" => BeltPassOutcomeDecoded { outcome: BeltPassRecorded }
        "deferred" =>
          match json_object_unique_member(v: doc, key: "reason") {
            JsonMemberFound { value: JsonString { value: r } } =>
              BeltPassOutcomeDecoded { outcome: BeltPassDeferred { reason: r } }
            JsonMemberFound { value: _ } =>
              BeltPassOutcomeUnreadable { reason: "belt tick pass deferred without reason" }
            JsonMemberAbsent =>
              BeltPassOutcomeUnreadable { reason: "belt tick pass deferred without reason" }
            JsonMemberDuplicated { count: _ } =>
              BeltPassOutcomeUnreadable { reason: "belt tick pass deferred without reason" }
            JsonMemberNotAnObject =>
              BeltPassOutcomeUnreadable { reason: "belt tick pass deferred without reason" }
          }
        "refused" =>
          match json_object_unique_member(v: doc, key: "reason") {
            JsonMemberFound { value: JsonString { value: r } } =>
              BeltPassOutcomeDecoded { outcome: BeltPassRefused { reason: r } }
            JsonMemberFound { value: _ } =>
              BeltPassOutcomeUnreadable { reason: "belt tick pass refused without reason" }
            JsonMemberAbsent =>
              BeltPassOutcomeUnreadable { reason: "belt tick pass refused without reason" }
            JsonMemberDuplicated { count: _ } =>
              BeltPassOutcomeUnreadable { reason: "belt tick pass refused without reason" }
            JsonMemberNotAnObject =>
              BeltPassOutcomeUnreadable { reason: "belt tick pass refused without reason" }
          }
        "failed" =>
          match json_object_unique_member(v: doc, key: "reason") {
            JsonMemberFound { value: JsonString { value: r } } =>
              BeltPassOutcomeDecoded { outcome: BeltPassFailed { reason: r } }
            JsonMemberFound { value: _ } =>
              BeltPassOutcomeUnreadable { reason: "belt tick pass failed without reason" }
            JsonMemberAbsent =>
              BeltPassOutcomeUnreadable { reason: "belt tick pass failed without reason" }
            JsonMemberDuplicated { count: _ } =>
              BeltPassOutcomeUnreadable { reason: "belt tick pass failed without reason" }
            JsonMemberNotAnObject =>
              BeltPassOutcomeUnreadable { reason: "belt tick pass failed without reason" }
          }
        _ => BeltPassOutcomeUnreadable { reason: "belt tick pass outcome is unknown" }
      }
    JsonMemberFound { value: _ } =>
      BeltPassOutcomeUnreadable { reason: "belt tick pass outcome is not a string" }
    JsonMemberAbsent =>
      BeltPassOutcomeUnreadable { reason: "belt tick pass outcome is missing" }
    JsonMemberDuplicated { count: _ } =>
      BeltPassOutcomeUnreadable { reason: "belt tick pass outcome is duplicated" }
    JsonMemberNotAnObject =>
      BeltPassOutcomeUnreadable { reason: "belt tick pass outcome is unreadable" }
  }
}

fn belt_tick_receipt_decode(raw: String) -> BeltTickReceiptRead {
  match parse_json_document(s: raw) {
    JsonDocumentUnreadable { gap: gap } =>
      BeltTickReceiptUnreadable { reason: concat("the belt tick receipt is ", json_document_gap_text(gap: gap)) }
    JsonDocumentParsed { value: doc } =>
      match json_object_unique_member(v: doc, key: "schema") {
        JsonMemberFound { value: JsonString { value: schema } } =>
          if schema != belt_tick_receipt_schema {
            BeltTickReceiptUnreadable { reason: "belt tick receipt schema is unknown" }
          } else {
            match json_object_unique_member(v: doc, key: "observed_at") {
              JsonMemberFound { value: JsonString { value: observed_at } } => belt_tick_receipt_decode_passes(doc: doc, observed_at: observed_at)
              JsonMemberFound { value: _ } => BeltTickReceiptUnreadable { reason: "belt tick receipt observed_at is missing" }
              JsonMemberAbsent => BeltTickReceiptUnreadable { reason: "belt tick receipt observed_at is missing" }
              JsonMemberDuplicated { count: _ } => BeltTickReceiptUnreadable { reason: "belt tick receipt observed_at is missing" }
              JsonMemberNotAnObject => BeltTickReceiptUnreadable { reason: "belt tick receipt observed_at is missing" }
            }
          }
        JsonMemberFound { value: _ } => BeltTickReceiptUnreadable { reason: "belt tick receipt schema is missing" }
        JsonMemberAbsent => BeltTickReceiptUnreadable { reason: "belt tick receipt schema is missing" }
        JsonMemberDuplicated { count: _ } => BeltTickReceiptUnreadable { reason: "belt tick receipt schema is missing" }
        JsonMemberNotAnObject => BeltTickReceiptUnreadable { reason: "belt tick receipt schema is missing" }
      }
  }
}

fn belt_tick_receipt_decode_passes(doc: JsonValue, observed_at: String) -> BeltTickReceiptRead {
  match belt_pass_outcome_from_member(doc: doc, key: "spawn_pass") {
    BeltPassOutcomeUnreadable { reason: r } => BeltTickReceiptUnreadable { reason: r }
    BeltPassOutcomeDecoded { outcome: spawn_pass } =>
      match belt_pass_outcome_from_member(doc: doc, key: "teardown_pass") {
        BeltPassOutcomeUnreadable { reason: r } => BeltTickReceiptUnreadable { reason: r }
        BeltPassOutcomeDecoded { outcome: teardown_pass } =>
         match belt_pass_outcome_from_member(doc: doc, key: "seat_discharge_pass") {
          BeltPassOutcomeUnreadable { reason: r } => BeltTickReceiptUnreadable { reason: r }
          BeltPassOutcomeDecoded { outcome: seat_discharge_pass } =>
          match belt_pass_outcome_from_member(doc: doc, key: "discovery_pass") {
            BeltPassOutcomeUnreadable { reason: r } => BeltTickReceiptUnreadable { reason: r }
            BeltPassOutcomeDecoded { outcome: discovery_pass } =>
              match belt_tick_launches_from_member(doc: doc) {
                BeltTickLaunchesUnreadable { reason: r } => BeltTickReceiptUnreadable { reason: r }
                BeltTickLaunchesDecoded { launches } =>
                  match belt_tick_execution_from_member(doc: doc) {
                    BeltTickExecutionUnreadable { reason: r } => BeltTickReceiptUnreadable { reason: r }
                    BeltTickExecutionDecoded { execution } =>
                      belt_tick_receipt_with_identity(doc: doc, receipt: BeltTickReceipt {
                        observed_at: observed_at,
                        execution: execution,
                        launches: launches,
                        spawn_pass: spawn_pass,
                        teardown_pass: teardown_pass,
                        seat_discharge_pass: seat_discharge_pass,
                        discovery_pass: discovery_pass,
                      })
                  }
              }
          }
         }
      }
  }
}

fn belt_tick_receipt_with_identity(doc: JsonValue, receipt: BeltTickReceipt) -> BeltTickReceiptRead {
  match json_object_unique_member(v: doc, key: "receipt_identity") {
    JsonMemberFound { value: JsonString { value: claimed } } =>
      if claimed != belt_tick_receipt_identity_hex(receipt: receipt) {
        BeltTickReceiptUnreadable { reason: "belt tick receipt identity does not match its members" }
      } else {
        BeltTickReceiptPresent { receipt: receipt }
      }
    JsonMemberFound { value: _ } => BeltTickReceiptUnreadable { reason: "belt tick receipt receipt_identity is missing" }
    JsonMemberAbsent => BeltTickReceiptUnreadable { reason: "belt tick receipt receipt_identity is missing" }
    JsonMemberDuplicated { count: _ } => BeltTickReceiptUnreadable { reason: "belt tick receipt receipt_identity is missing" }
    JsonMemberNotAnObject => BeltTickReceiptUnreadable { reason: "belt tick receipt receipt_identity is missing" }
  }
}

type BeltTickLaunchesDecode
  = BeltTickLaunchesDecoded { launches: List<LaunchIdentity> }
  | BeltTickLaunchesUnreadable { reason: String }

fn belt_tick_launches_from_member(doc: JsonValue) -> BeltTickLaunchesDecode {
  match json_object_unique_member(v: doc, key: "launches") {
    JsonMemberFound { value: JsonArray { elements } } =>
      fold(elements, init: BeltTickLaunchesDecoded { launches: [] }, f: (acc, e) => match acc {
        BeltTickLaunchesUnreadable { reason } => BeltTickLaunchesUnreadable { reason: reason }
        BeltTickLaunchesDecoded { launches } =>
          match launch_identity_of_json(doc: e) {
            LaunchIdentityUnreadable { reason } => BeltTickLaunchesUnreadable { reason: join(["belt tick receipt launches: ", reason], "") }
            LaunchIdentityDecoded { identity } => BeltTickLaunchesDecoded { launches: concat(launches, [identity]) }
          }
      })
    JsonMemberFound { value: _ } => BeltTickLaunchesUnreadable { reason: "belt tick receipt launches is not an array" }
    JsonMemberAbsent => BeltTickLaunchesUnreadable { reason: "belt tick receipt launches is missing" }
    JsonMemberDuplicated { count: _ } => BeltTickLaunchesUnreadable { reason: "belt tick receipt launches is duplicated" }
    JsonMemberNotAnObject => BeltTickLaunchesUnreadable { reason: "belt tick receipt is not an object" }
  }
}

fn belt_pass_outcome_from_member(doc: JsonValue, key: String) -> BeltPassOutcomeDecode {
  match json_object_unique_member(v: doc, key: key) {
    JsonMemberFound { value: pass_doc } => belt_pass_outcome_from_json(doc: pass_doc)
    JsonMemberAbsent =>
      BeltPassOutcomeUnreadable {
        reason: join(["belt tick receipt ", key, " is missing"], ""),
      }
    JsonMemberDuplicated { count: _ } =>
      BeltPassOutcomeUnreadable {
        reason: join(["belt tick receipt ", key, " is missing"], ""),
      }
    JsonMemberNotAnObject =>
      BeltPassOutcomeUnreadable {
        reason: join(["belt tick receipt ", key, " is missing"], ""),
      }
  }
}

// The tick receipt read classifies an OBSERVATION, not a host error string: the old classifier
// text-matched the host's error ("No such file", "not found") to decide absent versus unreadable,
// which breaks on every host phrasing and every error-transport change. The observation authority
// establishes absence from the listing instead, and the host error rides inside the cause text.
fn belt_tick_receipt_read_from_observation(observation: FilesystemFileObservation) -> BeltTickReceiptRead {
  match observation {
    FilesystemFileAbsent(_) => BeltTickReceiptAbsent
    FilesystemFileRead { path: _, content } =>
      if trim(content) == "" {
        BeltTickReceiptAbsent
      } else {
        belt_tick_receipt_decode(raw: content)
      }
    FilesystemFileIndeterminate { cause } =>
      BeltTickReceiptUnreadable {
        reason: join(["belt tick receipt could not be read: ", cause], ""),
      }
    FilesystemFileObservationsDisagree { path: _, cause } =>
      BeltTickReceiptUnreadable {
        reason: join(["belt tick receipt could not be read: ", cause], ""),
      }
    FilesystemFileSubjectRefused { directory: _, name: _, cause } =>
      BeltTickReceiptUnreadable {
        reason: join(["belt tick receipt could not be read: ", cause], ""),
      }
  }
}

fn belt_tick_receipt_read_for_instance(
  instance: HostDashboardInstance,
) -> BeltTickReceiptRead {
  belt_tick_receipt_read_from_observation(
    observation: filesystem_file_observation_of_path(
      path: belt_tick_receipt_path_for_instance(instance: instance),
    ),
  )
}

fn belt_tick_execution_json(e: BeltTickExecutionStanding) -> JsonValue {
  match e {
    TickExecuted { instance_id: i, deployed_revision: r, spawn_mode: m } =>
      json_object(members: [
        json_kv(key: "standing", value: json_string(s: "executed")),
        json_kv(key: "instance_id", value: json_string(s: i)),
        json_kv(key: "deployed_revision", value: json_string(s: r)),
        json_kv(key: "spawn_mode", value: json_string(s: spawn_mode_label(m: m))),
      ])
    TickExecutionWithheld { refusal: why } =>
      json_object(members: [
        json_kv(key: "standing", value: json_string(s: "withheld")),
        json_kv(key: "refusal", value: json_string(s: why)),
      ])
  }
}

fn belt_tick_execution_text(e: BeltTickExecutionStanding) -> String {
  match e {
    TickExecuted { instance_id: i, deployed_revision: r, spawn_mode: m } =>
      join(["executed|", i, "|", r, "|", spawn_mode_label(m: m)], "")
    TickExecutionWithheld { refusal: why } => join(["withheld|", why], "")
  }
}

fn belt_tick_receipt_identity_text(receipt: BeltTickReceipt) -> String {
  join([
    receipt.observed_at, "|",
    belt_tick_execution_text(e: receipt.execution), "|",
    join(receipt.launches |> map(l => serialize_json(v: launch_identity_json(id: l))), ","), "|",
    belt_pass_outcome_key(o: receipt.spawn_pass), "|",
    belt_pass_outcome_key(o: receipt.teardown_pass), "|",
    belt_pass_outcome_key(o: receipt.seat_discharge_pass), "|",
    belt_pass_outcome_key(o: receipt.discovery_pass),
  ], "")
}

fn belt_tick_receipt_identity_hex(receipt: BeltTickReceipt) -> String {
  content_hash_tagged_structural(
    tag: "roadmap-belt-tick-receipt-v5" as NonEmptyStr,
    payload: content_hash_atom(value: belt_tick_receipt_identity_text(receipt: receipt) as NonEmptyStr),
  ).digest as String
}

type BeltTickExecutionDecode
  = BeltTickExecutionDecoded { execution: BeltTickExecutionStanding }
  | BeltTickExecutionUnreadable { reason: String }

fn belt_tick_execution_from_member(doc: JsonValue) -> BeltTickExecutionDecode {
  match json_object_unique_member(v: doc, key: "execution") {
    JsonMemberFound { value: inner } =>
      match json_object_unique_member(v: inner, key: "standing") {
        JsonMemberFound { value: JsonString { value: standing } } =>
          match standing {
            "executed" =>
              match json_object_unique_member(v: inner, key: "instance_id") {
                JsonMemberFound { value: JsonString { value: instance_id } } =>
                  match json_object_unique_member(v: inner, key: "deployed_revision") {
                    JsonMemberFound { value: JsonString { value: revision } } =>
                      match json_object_unique_member(v: inner, key: "spawn_mode") {
                        JsonMemberFound { value: JsonString { value: mode_label } } =>
                          match spawn_mode_of_label(label: mode_label) {
                            Absent => BeltTickExecutionUnreadable { reason: join(["belt tick receipt execution spawn_mode is unknown: ", mode_label], "") }
                            Present { value: mode } =>
                              BeltTickExecutionDecoded {
                                execution: TickExecuted { instance_id: instance_id, deployed_revision: revision, spawn_mode: mode },
                              }
                          }
                        JsonMemberFound { value: _ } => BeltTickExecutionUnreadable { reason: "belt tick receipt execution spawn_mode is missing" }
                        JsonMemberAbsent => BeltTickExecutionUnreadable { reason: "belt tick receipt execution spawn_mode is missing" }
                        JsonMemberDuplicated { count: _ } => BeltTickExecutionUnreadable { reason: "belt tick receipt execution spawn_mode is missing" }
                        JsonMemberNotAnObject => BeltTickExecutionUnreadable { reason: "belt tick receipt execution spawn_mode is missing" }
                      }
                    JsonMemberFound { value: _ } => BeltTickExecutionUnreadable { reason: "belt tick receipt execution deployed_revision is missing" }
                    JsonMemberAbsent => BeltTickExecutionUnreadable { reason: "belt tick receipt execution deployed_revision is missing" }
                    JsonMemberDuplicated { count: _ } => BeltTickExecutionUnreadable { reason: "belt tick receipt execution deployed_revision is missing" }
                    JsonMemberNotAnObject => BeltTickExecutionUnreadable { reason: "belt tick receipt execution deployed_revision is missing" }
                  }
                JsonMemberFound { value: _ } => BeltTickExecutionUnreadable { reason: "belt tick receipt execution instance_id is missing" }
                JsonMemberAbsent => BeltTickExecutionUnreadable { reason: "belt tick receipt execution instance_id is missing" }
                JsonMemberDuplicated { count: _ } => BeltTickExecutionUnreadable { reason: "belt tick receipt execution instance_id is missing" }
                JsonMemberNotAnObject => BeltTickExecutionUnreadable { reason: "belt tick receipt execution instance_id is missing" }
              }
            "withheld" =>
              match json_object_unique_member(v: inner, key: "refusal") {
                JsonMemberFound { value: JsonString { value: why } } =>
                  BeltTickExecutionDecoded { execution: TickExecutionWithheld { refusal: why } }
                JsonMemberFound { value: _ } => BeltTickExecutionUnreadable { reason: "belt tick receipt execution withheld without refusal" }
                JsonMemberAbsent => BeltTickExecutionUnreadable { reason: "belt tick receipt execution withheld without refusal" }
                JsonMemberDuplicated { count: _ } => BeltTickExecutionUnreadable { reason: "belt tick receipt execution withheld without refusal" }
                JsonMemberNotAnObject => BeltTickExecutionUnreadable { reason: "belt tick receipt execution withheld without refusal" }
              }
            _ => BeltTickExecutionUnreadable { reason: join(["belt tick receipt execution standing is unknown: ", standing], "") }
          }
        JsonMemberFound { value: _ } => BeltTickExecutionUnreadable { reason: "belt tick receipt execution standing is missing" }
        JsonMemberAbsent => BeltTickExecutionUnreadable { reason: "belt tick receipt execution standing is missing" }
        JsonMemberDuplicated { count: _ } => BeltTickExecutionUnreadable { reason: "belt tick receipt execution standing is missing" }
        JsonMemberNotAnObject => BeltTickExecutionUnreadable { reason: "belt tick receipt execution standing is missing" }
      }
    JsonMemberAbsent => BeltTickExecutionUnreadable { reason: "belt tick receipt execution is missing" }
    JsonMemberDuplicated { count: _ } => BeltTickExecutionUnreadable { reason: "belt tick receipt execution is duplicated" }
    JsonMemberNotAnObject => BeltTickExecutionUnreadable { reason: "belt tick receipt is not an object" }
  }
}

fn belt_tick_receipt_json_value(receipt: BeltTickReceipt) -> JsonValue {
  json_object(members: [
    json_kv(key: "schema", value: json_string(s: belt_tick_receipt_schema)),
    json_kv(key: "observed_at", value: json_string(s: receipt.observed_at)),
    json_kv(key: "execution", value: belt_tick_execution_json(e: receipt.execution)),
    json_kv(key: "receipt_identity", value: json_string(s: belt_tick_receipt_identity_hex(receipt: receipt))),
    json_kv(key: "launches", value: json_array(elements: receipt.launches |> map(l => launch_identity_json(id: l)))),
    json_kv(key: "spawn_pass", value: belt_pass_outcome_json(o: receipt.spawn_pass)),
    json_kv(key: "teardown_pass", value: belt_pass_outcome_json(o: receipt.teardown_pass)),
    json_kv(key: "seat_discharge_pass", value: belt_pass_outcome_json(o: receipt.seat_discharge_pass)),
    json_kv(key: "discovery_pass", value: belt_pass_outcome_json(o: receipt.discovery_pass)),
  ])
}

fn belt_teardown_ok(o: BeltTeardownOutcome) -> Bool {
  match o {
    ReapedSession { session_name: _ } => true
    TeardownFailed { session_name: _, detail: _ } => false
  }
}

// THE LOCATED CAUSE TRAVELS INTO THE RECEIPT. SpawnFailed carries node_id, step, detail and
// provider — which node refused, at which gate, why — and this fold discarded all four for "one or
// more spawn outcomes failed". The receipt is the only durable record of a tick, so the cause was
// computed and erased every tick.
//
// That erasure made a one-command fix cost weeks: srv1's belt refused every spawn once the pinned
// Codex bundle went missing from /opt/gunbc/provider-runtime/codex, and the receipt said only that
// something failed. Every host probe an operator reaches for — `which codex`, the tmux server, the
// attempt directories — answers about a DIFFERENT object than the preflight tests (it probes the
// pinned bundled executable by absolute path, never PATH), so the visible evidence pointed away
// from the cause. DESIGN section 5 requires a failure arm typed, located and countable; at the
// receipt it was none.
//
// The reason string is now built from the failed outcomes, naming each node with gate and detail: a
// tick refusing for a missing provider binary says so in the file the dashboard reads, and the
// dispatch button's "belt fault" caption gets an explanation instead of a dead end.
fn belt_spawn_failure_reason(spawn_outcomes: List<BeltSpawnOutcome>) -> String {
  join([
    "one or more spawn outcomes failed: ",
    join(
      fold(spawn_outcomes, init: [], f: (acc, o) => match o {
        SpawnFailed { node_id: n, step: st, detail: d, provider: pv, launch: _ } =>
          concat(acc, [join([n, " [", pv, "] ", st, ": ", d], "")])
        Spawned { node_id: _, session_name: _, provider: _, launch: _ } => acc
        SpawnLaunchPending { node_id: _, session_name: _, provider: _, launch: _, entry: _ } => acc
        SpawnNotAdmitted { node_id: _, refusal: _ } => acc
      }),
      "; ",
    ),
  ], "")
}

fn belt_spawn_pass_outcome_from(
  host_refusal: LaunchRefusal?,
  spawn_outcomes: List<BeltSpawnOutcome>,
) -> BeltPassOutcome {
  match host_refusal {
    Present { value: r } => BeltPassRefused { reason: launch_refusal_reason(r: r) }
    Absent =>
    if belt_spawn_tally(outcomes: spawn_outcomes).failed > 0 {
      BeltPassFailed { reason: belt_spawn_failure_reason(spawn_outcomes: spawn_outcomes) }
    } else {
      BeltPassRecorded
    }
  }
}

fn belt_teardown_pass_outcome_from(
  host_refusal: LaunchRefusal?,
  teardown_outcomes: List<BeltTeardownOutcome>,
) -> BeltPassOutcome {
  match host_refusal {
    Present { value: r } => BeltPassRefused { reason: launch_refusal_reason(r: r) }
    Absent =>
    if count(teardown_outcomes |> filter(o => !belt_teardown_ok(o: o))) > 0 {
      BeltPassFailed { reason: "one or more teardown outcomes failed" }
    } else {
      BeltPassRecorded
    }
  }
}

// A SEAT-DISCHARGE PASS REACHES THE DURABLE RECEIPT TYPED AND COUNTED: a red is Failed, a kept charge with a
// named cause is Refused, a clean pass is Recorded. Nothing is dropped between the driver and the receipt.
fn belt_seat_discharge_pass_outcome_from(pass: SeatDischargePass) -> BeltPassOutcome {
  match seat_discharge_pass_standing(p: pass) {
    SeatDischargeHasReds { reds: n, first: why } => BeltPassFailed { reason: join([to_string(value: n), " seat discharge red(s); first: ", why], "") }
    SeatDischargeHasRefusals { refused: n, first: why } => BeltPassRefused { reason: join([to_string(value: n), " seat discharge refusal(s), charge kept; first: ", why], "") }
    SeatDischargePassRefused { reason: why } => BeltPassRefused { reason: join(["the seat discharge pass could not run, every charge kept: ", why], "") }
    SeatDischargeClean => BeltPassRecorded
  }
}

fn belt_tick_observed_at() -> String {
  match clock_now_probed_at() {
    Present { value: probed_at } => probed_at as String
    Absent => "clock observation refused"
  }
}

fn belt_tick_receipt_write_for_instance(
  instance: HostDashboardInstance,
  receipt: BeltTickReceipt,
) -> BeltPassOutcome {
  let write = Filesystem.Write(
    path: belt_tick_receipt_path_for_instance(instance: instance),
    content: serialize_json(v: belt_tick_receipt_json_value(receipt: receipt)),
  )
  if write.success {
    BeltPassRecorded
  } else {
    BeltPassFailed {
      reason: join([
        "the belt tick receipt could not be written: ",
        write.error,
      ], ""),
    }
  }
}

// Verification runs on the SAME tick that spawns and reaps: it is the same kind of fact, a desired
// obligation reconciled against an observed one. Living here rather than behind its own trigger is
// what makes the mechanism what the operator did by hand — the belt already runs, so a completed
// turn gets its receipts run next tick without anyone noticing it finished. It runs AFTER the
// reconcile's actuations on its own evidence, so a session spawned this tick has no completed turn
// and is simply deferred. VERIFY NO LONGER SHORT-CIRCUITS ON SESSION OBSERVE REFUSAL: a tmux-list
// refusal blocks spawn/reap only; verify reads the attempt ledger and terminal provider/process
// evidence on its own authority (operator P1, 2026-08-02).
// The tick's node-independent launch refusal, when the host refused before any node reached its own
// gates: the same LaunchRefusal (gunbc.roadmap.roadmap_launch_admission launch_host_refusal over the staged
// standing) every per-node SpawnNotAdmitted in spawn_outcomes carries, so the receipt's spawn_pass
// reason and the per-row refusals are one spelling. Absent when the host admitted observation
// through to the session set (a per-node refusal may still stand in spawn_outcomes). Replaces the
// tick-local `observe_refused: Bool + reason: String` pair review 5059520727 found beside the
// shared vocabulary.
// A deployment transition is the deploy's ATOMIC WHOLESALE refusal (gunbc.deploy_transition): under
// it nothing on the host actuates — spawn, teardown, verification, publication. The tick records it
// as TickPassesWithheld with the transition refusal, and the durable receipt derives every pass as
// Refused with that reason. Review 5059681676 found the previous shape — empty verify/publish lists
// folded to BeltPassRecorded — persisting a false `recorded` for passes the driver never ran. A
// host refusal that is NOT a transition (revision drift, an unobservable session set) withholds
// only the launch passes; verification and publication still run and record on their own evidence.
type BeltTickWholesale
  = TickPassesRun
  | TickPassesWithheld { refusal: LaunchRefusal }

type BeltTickResult {
  host_refusal: LaunchRefusal?,
  wholesale: BeltTickWholesale,
  reconcile: BeltReconcile,
  spawn_outcomes: List<BeltSpawnOutcome>,
  teardown_outcomes: List<BeltTeardownOutcome>,
  discovery: BeltDiscovery,
  seat_discharge: SeatDischargePass,
}

fn belt_tick_empty_reconcile(state: SpawnMode) -> BeltReconcile {
  BeltReconcile {
    mode: state,
    occupied: 0,
    upserts: [],
    teardowns: [],
    refusals: [],
  }
}

// The re-runnable belt driver: observe the live session set -> decide via belt_reconcile (the sole
// belt decision; its spawn-only precursor belt_step was deleted under RLM-1 — the launch admission
// is the only eligibility decision) -> actuate each planned spawn/teardown through the fail-closed
// exec seam. Idempotent by construction: a spawned session is observed next tick, keys to its ready
// node as Unchanged -> noop, so re-ticking never double-spawns (the observed set closes the loop
// the pure decision cannot). ObserveRefused blocks spawn/reap only — verify and publish run on
// their own evidence authorities (operator P1, 2026-08-02).
// THE TIMER IS A DISPATCH ACTUATOR TOO (review artifact 51237, both P0s). The dead-pane fix and the
// revision gate reached only the click path. This tick passed the whole observed session list into
// belt_reconcile, which maps EVERY present row to an observed member and counts live.length() as
// occupied — so a retained dead pane stayed a member (desired + present = Unchanged, no respawn)
// and consumed a capacity slot; and it never consulted the deployed revision, so a drifted host
// refused a click and spawned on a timer.
//
// BOTH PATHS NOW CONSUME ONE SEAM. launch_gate_revision (through the staged observer's
// launch_host_stage_revision) halts the tick before any spawn or reap. A refusal blocks spawn and
// teardown ONLY: verification and publication read independently bound receipts and already run
// when tmux observation refuses — stopping them would widen a spawn-admission refusal into a work
// stoppage.
//
// CLEANUP PRECEDES START, DEFERRED ONE TICK. A stale pane is excluded from observed membership, so
// its node becomes a spawn candidate — but spawning THIS tick would collide with the still-existing
// tmux session name, since spawn runs before teardown. So the spawn is withheld this tick and the
// teardown planned; next tick observes it Absent and spawns. Hence a partition plus a deferral, not
// a filter.
//
// LivenessUnobserved and MultiplicityConflict are neither cleaned nor spawned: counted refusals. An
// unobserved pane might be running, so teardown could kill live work and a spawn beside it could
// double-run the node.
//
// THIS PARAGRAPH DESCRIBED BEHAVIOUR THE CODE DID NOT HAVE (review artifact 51285), worse than the
// gap it described. The first cut partitioned `refused` and never read it, so only stale node ids
// were withheld — a ready node with an unobserved-but-present session read as ABSENT to
// belt_reconcile and could spawn beside a possibly-running pane. The deferral set is now every
// non-running class, so note and code agree.
//
// MULTIPLICITY IS A NODE FACT, NOT A SESSION FACT, which the first cut missed here:
// belt_tick_classify_sessions read each row's process state in isolation, so two rows for one node
// (running + stale) landed in two buckets and the reconciler acted on an ambiguity dispatch would
// have refused. The partition is now node-aware — more than one row is conflicted whatever the rows
// say — so both actuation paths refuse the same ambiguity.
type BeltTickSessionPartition {
  running: List<DispatchLiveSession>
  stale: List<DispatchLiveSession>
  refused: List<DispatchLiveSession>
  conflicted: List<DispatchLiveSession>
}

fn belt_tick_node_row_count(live: List<DispatchLiveSession>, node_id: String) -> Int {
  count(filter(live, s => s.node_id == node_id))
}

// THE PARTITION READS THE COPRODUCT, NOT A PARALLEL STRING VOCABULARY (review artifact 51309). The
// first cut asked belt_tick_session_is(s, arm: "running") — a second naming scheme for
// BeltSessionLiveness, which already names these states. Two vocabularies for one concept is the
// nicknaming class, and the string one is strictly worse: a typo in an arm name compiles and
// silently empties a bucket, where a missing coproduct arm is a compiler-caught non-exhaustive
// match.
//
// Node-awareness stays here rather than in belt_session_liveness_from_process, because multiplicity
// is a fact about a NODE's rows and that function sees one row's process.
// belt_node_session_liveness makes the same distinction on the dispatch path.
fn belt_tick_session_class(
  live: List<DispatchLiveSession>,
  s: DispatchLiveSession,
) -> BeltSessionLiveness {
  let n = belt_tick_node_row_count(live: live, node_id: s.node_id)
  if n > 1 {
    BeltSessionMultiplicityConflict {
      session_names: join(
        map(filter(live, r => r.node_id == s.node_id), r => r.session_name), ", "),
      session_count: n,
    }
  } else {
    belt_session_liveness_from_process(session_name: s.session_name, process: s.worker.process)
  }
}

fn belt_tick_is_running(live: List<DispatchLiveSession>, s: DispatchLiveSession) -> Bool {
  match belt_tick_session_class(live: live, s: s) {
    BeltSessionRunning { session_name: _, command: _ } => true
    BeltSessionStaleTerminal { session_name: _, detail: _ } => false
    BeltSessionLivenessUnobserved { session_name: _, reason: _ } => false
    BeltSessionAbsent => false
    BeltSessionMultiplicityConflict { session_names: _, session_count: _ } => false
  }
}

fn belt_tick_is_stale(live: List<DispatchLiveSession>, s: DispatchLiveSession) -> Bool {
  match belt_tick_session_class(live: live, s: s) {
    BeltSessionStaleTerminal { session_name: _, detail: _ } => true
    BeltSessionRunning { session_name: _, command: _ } => false
    BeltSessionLivenessUnobserved { session_name: _, reason: _ } => false
    BeltSessionAbsent => false
    BeltSessionMultiplicityConflict { session_names: _, session_count: _ } => false
  }
}

fn belt_tick_is_refused(live: List<DispatchLiveSession>, s: DispatchLiveSession) -> Bool {
  match belt_tick_session_class(live: live, s: s) {
    BeltSessionLivenessUnobserved { session_name: _, reason: _ } => true
    BeltSessionRunning { session_name: _, command: _ } => false
    BeltSessionStaleTerminal { session_name: _, detail: _ } => false
    BeltSessionAbsent => false
    BeltSessionMultiplicityConflict { session_names: _, session_count: _ } => false
  }
}

fn belt_tick_is_conflicted(live: List<DispatchLiveSession>, s: DispatchLiveSession) -> Bool {
  match belt_tick_session_class(live: live, s: s) {
    BeltSessionMultiplicityConflict { session_names: _, session_count: _ } => true
    BeltSessionRunning { session_name: _, command: _ } => false
    BeltSessionStaleTerminal { session_name: _, detail: _ } => false
    BeltSessionLivenessUnobserved { session_name: _, reason: _ } => false
    BeltSessionAbsent => false
  }
}

fn belt_tick_classify_sessions(live: List<DispatchLiveSession>) -> BeltTickSessionPartition {
  BeltTickSessionPartition {
    running: filter(live, s => belt_tick_is_running(live: live, s: s)),
    stale: filter(live, s => belt_tick_is_stale(live: live, s: s)),
    refused: filter(live, s => belt_tick_is_refused(live: live, s: s)),
    conflicted: filter(live, s => belt_tick_is_conflicted(live: live, s: s)),
  }
}

data belt_publish_transition_inhibited_reason: String = "publication deferred: a deployment transition is in force or unresolved on this host, so the attempt evidence this publication would read is being rewritten or was left half-rewritten --"

// A TRANSITION REFUSAL WITHHOLDS PUBLICATION AND VERIFICATION AS WELL AS SPAWN AND REAP — the one
// place it departs from the revision refusal below, whose ruling blocks spawn and teardown ONLY
// because verification and publication read independently bound receipts and stopping them would
// widen a spawn-admission refusal into a work stoppage. That argument fails here: a transition
// means the tree those receipts are read FROM is being rewritten underneath, or was left
// half-rewritten by something that died, so all four passes consume an incoherent release.
// Publishing a pull request off a receipt read from a half-converged tree is not a smaller mistake
// than spawning into it — it is the one that leaves the house.
// THE REAL TIMER DRIVER IS observer -> launch pass -> actuation.
// belt_launch_host_standing_for_instance is the ONE staged observer (shared with the page and POST
// /dispatch); belt_tick_launch_pass is the timer's whole launch decision over that standing and is
// pure — no effect, so a witness runs the real driver's decision on a fabricated staged standing;
// the only thing it cannot exercise is the observer's filesystem/tmux reads, whose ORDER is
// structural (LaunchHostHalted has no later fields). When the host halts, every desired node
// (frontier.ready, in frontier order) is still folded through the admission and receives the halt
// refusal as SpawnNotAdmitted: the receipt names what the timer would have started and the one
// reason it did not. Reaping needs an observed session set, so happens only when the standing
// reached it. Verification and publication are not launches and run on every arm EXCEPT a
// deployment transition halt — the deploy's atomic wholesale refusal (gunbc.deploy_transition),
// under which nothing on the host actuates, verify and publish included.
type BeltLaunchPass {
  reconcile: BeltReconcile,
  host_refusal: LaunchRefusal?,
  decisions: List<BeltLaunchDecision>,
  teardowns: List<DispatchMember>,
}

fn belt_tick_desired_candidates(frontier: SpawnFrontier) -> List<DispatchMember> {
  frontier.ready |> map(n => DesiredMember { node_id: n.node as String, node: n })
}

fn belt_tick_launch_pass_refused(
  standing: LaunchHostStanding,
  state: SpawnMode,
  frontier: SpawnFrontier,
  graph: LaunchGraphStanding,
  merged: List<Int>,
  host_refusal: LaunchRefusal,
) -> BeltLaunchPass {
  BeltLaunchPass {
    reconcile: belt_tick_empty_reconcile(state: state),
    host_refusal: Present { value: host_refusal },
    decisions: belt_tick_admit(
      candidates: belt_tick_desired_candidates(frontier: frontier),
      standing: standing,
      graph: graph,
      merged: merged,
    ),
    teardowns: [],
  }
}

fn belt_tick_launch_pass_observed(
  standing: LaunchHostStanding,
  state: SpawnMode,
  frontier: SpawnFrontier,
  graph: LaunchGraphStanding,
  merged: List<Int>,
  live: List<DispatchLiveSession>,
) -> BeltLaunchPass {
  let classified = belt_tick_classify_sessions(live: live)
  let r = belt_reconcile(
    state: state,
    frontier: frontier,
    live: classified.running,
    cap: roadmap_belt_default_capacity,
  )
  BeltLaunchPass {
    reconcile: r,
    host_refusal: none,
    decisions: belt_tick_admit(candidates: r.upserts, standing: standing, graph: graph, merged: merged),
    teardowns: concat(r.teardowns, map(classified.stale, s => ObservedMember { node_id: s.node_id, session: s })),
  }
}

// The launch pass's two populations are now distinct facts: the STANDING carries the census rows
// (occurrence population: tmux and systemd attempts alike) that admission reads, and the reconcile
// keeps the tmux population's own rows, because its teardown classification is the tmux session
// machinery's subject. The tmux rows arrive as a parameter: the tick observes them once, and the
// census observation's tmux leg reads the same host state.
fn belt_tick_launch_pass(
  standing: LaunchHostStanding,
  state: SpawnMode,
  frontier: SpawnFrontier,
  graph: LaunchGraphStanding,
  merged: List<Int>,
  tmux_live: List<DispatchLiveSession>,
) -> BeltLaunchPass {
  match launch_host_refusal(standing: standing) {
    Present { value: r } =>
      belt_tick_launch_pass_refused(standing: standing, state: state, frontier: frontier, graph: graph, merged: merged, host_refusal: r)
    Absent =>
      match standing {
        LaunchHostObserved { instance_id: _, actuation: _, transition: _, revision: _, sessions, capacity: _, mode: _ } =>
          match sessions {
            LaunchSessionsObserved { live: _ } =>
              belt_tick_launch_pass_observed(standing: standing, state: state, frontier: frontier, graph: graph, merged: merged, live: tmux_live)
            LaunchSessionsUnobserved { reason } =>
              belt_tick_launch_pass_refused(standing: standing, state: state, frontier: frontier, graph: graph, merged: merged, host_refusal: LaunchSessionsUnobservable { reason: reason })
            LaunchSessionsPending =>
              belt_tick_launch_pass_refused(standing: standing, state: state, frontier: frontier, graph: graph, merged: merged, host_refusal: LaunchGateNotEvaluated { gate: "sessions" })
          }
        LaunchHostObserveOnly { instance_id } =>
          belt_tick_launch_pass_refused(standing: standing, state: state, frontier: frontier, graph: graph, merged: merged, host_refusal: LaunchInstanceActuationRefused { instance_id: instance_id, reason: "observe-only instance reached the launch pass without a host refusal; fail-closed" })
        LaunchHostHalted { instance_id: _, gate: _, refusal } =>
          belt_tick_launch_pass_refused(standing: standing, state: state, frontier: frontier, graph: graph, merged: merged, host_refusal: refusal)
        LaunchHostUnobserved { reason } =>
          belt_tick_launch_pass_refused(standing: standing, state: state, frontier: frontier, graph: graph, merged: merged, host_refusal: LaunchNoActuatingInstance { reason: reason })
      }
  }
}

fn belt_tick_wholesale_of(standing: LaunchHostStanding) -> BeltTickWholesale {
  match standing {
    LaunchHostHalted { instance_id: _, gate, refusal } =>
      match gate {
        HostTransitionGate => TickPassesWithheld { refusal: refusal }
        HostRevisionGate => TickPassesRun
      }
    LaunchHostObserved { instance_id: _, actuation: _, transition: _, revision: _, sessions: _, capacity: _, mode: _ } => TickPassesRun
    LaunchHostObserveOnly { instance_id: _ } => TickPassesRun
    LaunchHostUnobserved { reason: _ } => TickPassesRun
  }
}

fn belt_tick_for_instance(
  instance: HostDashboardInstance,
  state: SpawnMode,
  frontier: SpawnFrontier,
  cap: BeltCapacity,
  spawn_workdir: String,
) -> BeltTickResult {
  let standing = belt_launch_host_standing_complete(
    instance: instance,
    standing: belt_launch_host_standing_for_instance_with_capacity(instance: instance, mode: state, capacity: cap),
  )
  let pass = belt_tick_launch_pass(
    standing: standing,
    state: state,
    frontier: frontier,
    graph: launch_graph_of_projection(proj: roadmap_plan_projection()),
    merged: authored_merged_prs(),
    tmux_live: match belt_sessions_observe_for_instance(instance: instance) {
      BeltSessionsObserved { live } => live
      ObserveRefused { reason: _ } => []
    },
  )
  let spawn_outcomes = belt_tick_spawn_after_settlement(
    settled: belt_session_settlement_pass(instance: instance),
    decisions: pass.decisions,
    workdir: spawn_workdir,
  )
  let teardown_outcomes = pass.teardowns |> map(m => belt_actuate_teardown_member_for_instance(instance: instance, m: m))
  match belt_tick_wholesale_of(standing: standing) {
    TickPassesWithheld { refusal } =>
      BeltTickResult {
        host_refusal: pass.host_refusal,
        wholesale: TickPassesWithheld { refusal: refusal },
        reconcile: pass.reconcile,
        spawn_outcomes: spawn_outcomes,
        teardown_outcomes: teardown_outcomes,
        seat_discharge: belt_compute_seat_discharge_pass(instance: instance),
        discovery: BeltDiscoveryRefused { reason: launch_refusal_reason(r: refusal) },
      }
    TickPassesRun =>
      BeltTickResult {
        host_refusal: pass.host_refusal,
        wholesale: TickPassesRun,
        reconcile: pass.reconcile,
        spawn_outcomes: spawn_outcomes,
        teardown_outcomes: teardown_outcomes,
        seat_discharge: belt_compute_seat_discharge_pass(instance: instance),
        discovery: belt_discover_for_instance(instance: instance),
      }
  }
}

// THE TIMER CONSUMES THE SAME ADMISSION AS THE CLICK (RLM-1). Every upsert the reconcile plans is
// folded through gunbc.roadmap.roadmap_launch_admission with cause Timer, in order, `reserved` = the
// launches this tick already admitted, so capacity is decided once and a tick cannot overshoot. A
// refusal is carried whole as SpawnNotAdmitted; only an admitted candidate reaches
// belt_actuate_spawn_member. The stale / liveness-unobserved / multiplicity partition the tick
// filtered by hand is now the admission's no-live-attempt gate over the FULL observed session list
// — the gate the route reads — so the tick has no private `deferred`. The transition gate
// (belt_transition_admission_for_instance refuses the whole tick before observation) and the
// revision gate are already closed above, so the standing handed to the admission carries them as
// admitted facts of THIS tick, not a second read.
// The timer's per-candidate verdict from the ONE admission, before any actuation: a decided launch
// carries the admitted LaunchIdentity, a withheld one the refusal. belt_tick_admit is the pure fold
// every candidate passes in deterministic (plan) order, `reserved` counting launches already
// decided so capacity is admitted as a prefix and the remainder receives LaunchNoCapacity;
// belt_tick_spawn_decided actuates exactly the decided ones. Splitting fold from actuation lets the
// multi-candidate control assert the fold on three Ready rows against one slot without entering the
// actuator.
type BeltLaunchDecision
  = BeltLaunchDecided { member: DispatchMember, launch: LaunchIdentity }
  | BeltLaunchWithheld { node_id: String, refusal: LaunchRefusal }

type BeltTickAdmitFold {
  reserved: Int
  decisions: List<BeltLaunchDecision>
}

fn belt_tick_admit(
  candidates: List<DispatchMember>,
  standing: LaunchHostStanding,
  graph: LaunchGraphStanding,
  merged: List<Int>,
) -> List<BeltLaunchDecision> {
  let folded = fold(candidates, init: BeltTickAdmitFold { reserved: 0, decisions: [] }, f: fn(acc, m) {
    let node_id = dispatch_member_key(m: m)
    match launch_admission(
      cause: Timer,
      standing: standing,
      graph: graph,
      merged: merged,
      node_id: node_id,
      reserved: acc.reserved,
    ) {
      LaunchRefused { refusal } =>
        BeltTickAdmitFold {
          reserved: acc.reserved,
          decisions: concat(acc.decisions, [ BeltLaunchWithheld { node_id: node_id, refusal: refusal } ]),
        }
      LaunchAdmitted { identity } =>
        BeltTickAdmitFold {
          reserved: acc.reserved + 1,
          decisions: concat(acc.decisions, [ BeltLaunchDecided { member: m, launch: identity } ]),
        }
    }
  })
  folded.decisions
}

// THE SPAWNS OF A TICK ARE COMPUTED INSIDE AN EXHAUSTIVE MATCH ON THAT TICK'S SESSION SETTLEMENT,
// so no acquisition runs until every stranded session seat on this host has been read and, where its
// unit has ended or its pre-launch window has passed, returned. A settlement that could not run
// WITHHOLDS this tick's launches as typed LaunchNoPlacementGrant refusals naming why -- the store
// that recovers stranded seats is the one new seats would be recorded in, so acquiring past an
// unreadable store would add holds no later pass could be shown to reach. Visible in the tick
// receipt; a retry next tick succeeds once the store reads.
fn belt_launch_member_node_id(m: DispatchMember) -> String {
  match m {
    DesiredMember { node_id, node: _ } => node_id
    ObservedMember { node_id, session: _ } => node_id
  }
}

// G5 (side-chat ruling on #13074): settlement is its own pass, ORDERED BEFORE EVERY NEW ACQUISITION.
// ONE derivation shared by the two routes that acquire a placement -- the tick (belt_tick_spawn_after_
// settlement, which has run the pass every tick) and the dispatch route that the door and the redeliver
// entry both end in (belt_dispatch_node_staged_over) -- so a stale slot the tick's own pass would have
// released can never wedge an acquisition on the sibling route. That asymmetry was the wedge: on a
// manual_ready lab with no tick, a dead worker's terminal slot held the seat a same-key re-delivery
// needed, and nothing ran the pass to release it. Absent = the pass ran, the caller may acquire;
// Present = the pass refused, the acquisition is refused with a typed LaunchNoPlacementGrant carrying
// the settlement wire -- never a spawn that collided halfway. Fail-closed, not a resume special case:
// it guards EVERY new acquisition on the dispatch route (fresh, resume and re-delivery alike).
fn belt_settlement_spawn_gate(settled: SessionSettlePass, node_id: String) -> BeltSpawnOutcome? {
  match settled {
    SessionSettlePassRan { settlements: _ } => Absent
    SessionSettlePassRefused { detail } =>
      Present {
        value: SpawnNotAdmitted {
          node_id: node_id,
          refusal: LaunchNoPlacementGrant { detail: session_settle_pass_wire(p: SessionSettlePassRefused { detail: detail }) },
        },
      }
  }
}

fn belt_tick_spawn_after_settlement(settled: SessionSettlePass, decisions: List<BeltLaunchDecision>, workdir: String) -> List<BeltSpawnOutcome> {
  decisions |> map(d => match d {
    BeltLaunchWithheld { node_id, refusal } => SpawnNotAdmitted { node_id: node_id, refusal: refusal }
    BeltLaunchDecided { member, launch } =>
      match belt_settlement_spawn_gate(settled: settled, node_id: belt_launch_member_node_id(m: member)) {
        Present { value: refused } => refused
        Absent => belt_actuate_spawn_member(m: member, workdir: workdir, launch: launch)
      }
  })
}

fn belt_tick_spawn_decided(decisions: List<BeltLaunchDecision>, workdir: String) -> List<BeltSpawnOutcome> {
  decisions |> map(d => match d {
    BeltLaunchWithheld { node_id, refusal } => SpawnNotAdmitted { node_id: node_id, refusal: refusal }
    BeltLaunchDecided { member, launch } => belt_actuate_spawn_member(m: member, workdir: workdir, launch: launch)
  })
}

fn belt_tick_admit_and_spawn(
  candidates: List<DispatchMember>,
  standing: LaunchHostStanding,
  graph: LaunchGraphStanding,
  merged: List<Int>,
  workdir: String,
) -> List<BeltSpawnOutcome> {
  belt_tick_spawn_decided(
    decisions: belt_tick_admit(candidates: candidates, standing: standing, graph: graph, merged: merged),
    workdir: workdir,
  )
}

fn belt_tick_deferred_count(outcomes: List<BeltSpawnOutcome>) -> Int { belt_spawn_tally(outcomes: outcomes).deferred }

fn belt_tick_launch_identities(outcomes: List<BeltSpawnOutcome>) -> List<LaunchIdentity> {
  fold(outcomes, init: [], f: (acc, o) => match o {
    Spawned { node_id: _, session_name: _, provider: _, launch } => concat(acc, [launch])
    SpawnFailed { node_id: _, step: _, detail: _, provider: _, launch } => concat(acc, [launch])
    SpawnLaunchPending { node_id: _, session_name: _, provider: _, launch, entry: _ } => concat(acc, [launch])
    SpawnNotAdmitted { node_id: _, refusal: _ } => acc
  })
}

fn belt_tick(
  state: SpawnMode,
  frontier: SpawnFrontier,
  cap: BeltCapacity,
  spawn_workdir: String,
) -> BeltTickResult {
  belt_tick_for_instance(
    instance: srv1_live_dashboard_instance(),
    state: state,
    frontier: frontier,
    cap: cap,
    spawn_workdir: spawn_workdir,
  )
}

fn belt_tick_default_workdir(
  state: SpawnMode,
  frontier: SpawnFrontier,
  cap: BeltCapacity,
) -> BeltTickResult {
  belt_tick(state: state, frontier: frontier, cap: cap, spawn_workdir: belt_actuate_workdir as String)
}

// ONE fold over the tick's spawn outcomes to a typed tally; every count the tick JSON, receipt and
// deferred figure report is a field of it. Replaces four variant-to-Bool predicates (belt_spawn_ok
// / _failed / _not_admitted and the NoCapacity filter) that each re-eliminated the outcome
// coproduct for one arm — the predicate-dissolution shape review 57498 refused.
type BeltSpawnTally {
  spawned: Int
  failed: Int
  not_admitted: Int
  deferred: Int
  pending: Int
}

fn belt_spawn_tally(outcomes: List<BeltSpawnOutcome>) -> BeltSpawnTally {
  fold(outcomes, init: BeltSpawnTally { spawned: 0, failed: 0, not_admitted: 0, deferred: 0, pending: 0 }, f: (acc, o) => match o {
    Spawned { node_id: _, session_name: _, provider: _, launch: _ } =>
      BeltSpawnTally { spawned: acc.spawned + 1, failed: acc.failed, not_admitted: acc.not_admitted, deferred: acc.deferred, pending: acc.pending }
    SpawnLaunchPending { node_id: _, session_name: _, provider: _, launch: _, entry: _ } =>
      BeltSpawnTally { spawned: acc.spawned, failed: acc.failed, not_admitted: acc.not_admitted, deferred: acc.deferred, pending: acc.pending + 1 }
    SpawnFailed { node_id: _, step: _, detail: _, provider: _, launch: _ } =>
      BeltSpawnTally { spawned: acc.spawned, failed: acc.failed + 1, not_admitted: acc.not_admitted, deferred: acc.deferred, pending: acc.pending }
    SpawnNotAdmitted { node_id: _, refusal } =>
      match refusal {
        LaunchNoCapacity { occupied: _, max_concurrent: _ } =>
          BeltSpawnTally { spawned: acc.spawned, failed: acc.failed, not_admitted: acc.not_admitted + 1, deferred: acc.deferred + 1, pending: acc.pending }
        LaunchNoActuatingInstance { reason: _ } =>
          BeltSpawnTally { spawned: acc.spawned, failed: acc.failed, not_admitted: acc.not_admitted + 1, deferred: acc.deferred, pending: acc.pending }
        LaunchInstanceActuationRefused { instance_id: _, reason: _ } =>
          BeltSpawnTally { spawned: acc.spawned, failed: acc.failed, not_admitted: acc.not_admitted + 1, deferred: acc.deferred, pending: acc.pending }
        LaunchTransitionInhibited { reason: _ } =>
          BeltSpawnTally { spawned: acc.spawned, failed: acc.failed, not_admitted: acc.not_admitted + 1, deferred: acc.deferred, pending: acc.pending }
        LaunchRevisionUnobserved { cause: _ } =>
          BeltSpawnTally { spawned: acc.spawned, failed: acc.failed, not_admitted: acc.not_admitted + 1, deferred: acc.deferred, pending: acc.pending }
        LaunchRevisionNotLanded { local: _, admitted: _ } =>
          BeltSpawnTally { spawned: acc.spawned, failed: acc.failed, not_admitted: acc.not_admitted + 1, deferred: acc.deferred, pending: acc.pending }
        LaunchAuthorityUnobserved { detail: _ } =>
          BeltSpawnTally { spawned: acc.spawned, failed: acc.failed, not_admitted: acc.not_admitted + 1, deferred: acc.deferred, pending: acc.pending }
        LaunchNodeUnknown =>
          BeltSpawnTally { spawned: acc.spawned, failed: acc.failed, not_admitted: acc.not_admitted + 1, deferred: acc.deferred, pending: acc.pending }
        LaunchNotReady { missing: _ } =>
          BeltSpawnTally { spawned: acc.spawned, failed: acc.failed, not_admitted: acc.not_admitted + 1, deferred: acc.deferred, pending: acc.pending }
        LaunchSessionsUnobservable { reason: _ } =>
          BeltSpawnTally { spawned: acc.spawned, failed: acc.failed, not_admitted: acc.not_admitted + 1, deferred: acc.deferred, pending: acc.pending }
        LaunchAlreadyLive { session_name: _ } =>
          BeltSpawnTally { spawned: acc.spawned, failed: acc.failed, not_admitted: acc.not_admitted + 1, deferred: acc.deferred, pending: acc.pending }
        LaunchStaleSession { session_name: _, detail: _ } =>
          BeltSpawnTally { spawned: acc.spawned, failed: acc.failed, not_admitted: acc.not_admitted + 1, deferred: acc.deferred, pending: acc.pending }
        LaunchLivenessUnobserved { session_name: _, reason: _ } =>
          BeltSpawnTally { spawned: acc.spawned, failed: acc.failed, not_admitted: acc.not_admitted + 1, deferred: acc.deferred, pending: acc.pending }
        LaunchSessionMultiplicityConflict { session_names: _, session_count: _ } =>
          BeltSpawnTally { spawned: acc.spawned, failed: acc.failed, not_admitted: acc.not_admitted + 1, deferred: acc.deferred, pending: acc.pending }
        LaunchCauseNotPermitted { cause: _, mode: _ } =>
          BeltSpawnTally { spawned: acc.spawned, failed: acc.failed, not_admitted: acc.not_admitted + 1, deferred: acc.deferred, pending: acc.pending }
        LaunchGateNotEvaluated { gate: _ } =>
          BeltSpawnTally { spawned: acc.spawned, failed: acc.failed, not_admitted: acc.not_admitted + 1, deferred: acc.deferred, pending: acc.pending }
        LaunchNoPlacementGrant { detail: _ } =>
          BeltSpawnTally { spawned: acc.spawned, failed: acc.failed, not_admitted: acc.not_admitted + 1, deferred: acc.deferred + 1, pending: acc.pending }
      }
  })
}

fn belt_tick_spawn_ok_count(t: BeltTickResult) -> Int { belt_spawn_tally(outcomes: t.spawn_outcomes).spawned }
fn belt_tick_spawn_failed_count(t: BeltTickResult) -> Int { belt_spawn_tally(outcomes: t.spawn_outcomes).failed }
fn belt_tick_spawn_not_admitted_count(t: BeltTickResult) -> Int { belt_spawn_tally(outcomes: t.spawn_outcomes).not_admitted }
fn belt_tick_teardown_ok_count(t: BeltTickResult) -> Int {
  count(t.teardown_outcomes |> filter(o => belt_teardown_ok(o: o)))
}

// One belt tick against the LIVE roadmap reads the roadmap authority + merged PRs, builds the ready
// frontier, and reconciles it in the production spawn mode (ManualReady) at the default capacity.
// gunbc.roadmap.roadmap_belt_tick_cli belt_run_once_cli is the executable entrypoint (`gunbc run --function belt_run_once_cli`, wet):
// it requires the deployment's GUNBC_BELT_SPAWN_WORKDIR, resolves that root to its dashboard
// instance, ticks against it, and persists the BeltTickReceipt and the served observation. belt_run_once and
// belt_run_once_json are non-executable projections (typed BeltTickResult for the production
// instance; its serialization) — `gunbc run` rejects both return types. The tick observes live
// sessions before actuating planned spawns and teardowns through the provider
// dispatch_actuator_selection resolves (a refused selection is a typed SpawnFailed at step
// dispatch-selection, never a defaulted provider), then DISCOVERS which attempts owe an obligation and
// hands each to its own unit (belt_discover_for_instance) -- it no longer captures, verifies, reviews
// or publishes anything itself (dogfood intervention #6). Idempotent: a spawned session is observed
// live next tick and reconciles to noop, and a queued obligation whose unit is loaded is held.
fn belt_run_once_in(
  instance: HostDashboardInstance,
  spawn_workdir: String,
) -> BeltTickResult {
  match roadmap_plan_projection() {
    RoadmapAuthorityProjectionRefused { detail: detail } =>
      BeltTickResult {
        host_refusal: Present { value: LaunchAuthorityUnobserved { detail: detail } },
        wholesale: TickPassesRun,
        reconcile: belt_tick_empty_reconcile(state: roadmap_belt_production_spawn_mode),
        spawn_outcomes: [],
        teardown_outcomes: [],
        seat_discharge: belt_compute_seat_discharge_pass(instance: instance),
        discovery: belt_discover_for_instance(instance: instance),
      }
    RoadmapAuthorityProjected { doc: doc, accepted: _, withheld: _ } =>
      belt_tick_for_instance(
        instance: instance,
        state: roadmap_belt_production_spawn_mode,
        frontier: spawn_frontier(doc: doc, merged: authored_merged_prs()),
        cap: roadmap_belt_default_capacity,
        spawn_workdir: spawn_workdir,
      )
  }
}

fn belt_run_once() -> BeltTickResult {
  belt_run_once_in(
    instance: srv1_live_dashboard_instance(),
    spawn_workdir: belt_actuate_workdir as String,
  )
}

fn belt_spawn_outcome_json(o: BeltSpawnOutcome) -> JsonValue {
  match o {
    Spawned { node_id: nid, session_name: sn, provider: p, launch: l } =>
      json_object(members: [
        json_kv(key: "node_id", value: json_string(s: nid)),
        json_kv(key: "status", value: json_string(s: "spawned")),
        json_kv(key: "provider", value: json_string(s: p)),
        json_kv(key: "session_name", value: json_string(s: sn)),
        json_kv(key: "launch", value: launch_identity_json(id: l)),
      ])
    SpawnFailed { node_id: nid, step: st, detail: d, provider: p, launch: l } =>
      json_object(members: [
        json_kv(key: "node_id", value: json_string(s: nid)),
        json_kv(key: "status", value: json_string(s: "spawn_failed")),
        json_kv(key: "provider", value: json_string(s: p)),
        json_kv(key: "step", value: json_string(s: st)),
        json_kv(key: "detail", value: json_string(s: d)),
        json_kv(key: "launch", value: launch_identity_json(id: l)),
      ])
    SpawnLaunchPending { node_id: nid, session_name: sn, provider: p, launch: l, entry: e } =>
      json_object(members: [
        json_kv(key: "node_id", value: json_string(s: nid)),
        json_kv(key: "status", value: json_string(s: "launch_pending")),
        json_kv(key: "provider", value: json_string(s: p)),
        json_kv(key: "session_name", value: json_string(s: sn)),
        json_kv(key: "entry", value: json_string(s: e)),
        json_kv(key: "launch", value: launch_identity_json(id: l)),
      ])
    SpawnNotAdmitted { node_id: nid, refusal: r } =>
      json_object(members: [
        json_kv(key: "node_id", value: json_string(s: nid)),
        json_kv(key: "status", value: json_string(s: launch_refusal_label(r: r))),
        json_kv(key: "reason", value: json_string(s: launch_refusal_reason(r: r))),
      ])
  }
}

fn belt_teardown_outcome_json(o: BeltTeardownOutcome) -> JsonValue {
  match o {
    ReapedSession { session_name: sn } =>
      json_object(members: [
        json_kv(key: "session_name", value: json_string(s: sn)),
        json_kv(key: "status", value: json_string(s: "reaped")),
      ])
    TeardownFailed { session_name: sn, detail: d } =>
      json_object(members: [
        json_kv(key: "session_name", value: json_string(s: sn)),
        json_kv(key: "status", value: json_string(s: "teardown_failed")),
        json_kv(key: "detail", value: json_string(s: d)),
      ])
  }
}

fn belt_tick_result_json_value(t: BeltTickResult) -> JsonValue {
  json_object(members: [
    json_kv(key: "schema", value: json_string(s: "roadmap-belt-tick/v1")),
    json_kv(key: "observe_refused", value: json_bool(b: match t.host_refusal { Present { value: _ } => true Absent => false })),
    json_kv(key: "observe_refusal_reason", value: json_string(s: match t.host_refusal { Present { value: r } => launch_refusal_reason(r: r) Absent => "" })),
    json_kv(key: "launch_refusal", value: json_string(s: match t.host_refusal { Present { value: r } => launch_refusal_label(r: r) Absent => "" })),
    json_kv(key: "wholesale_refused", value: json_bool(b: match t.wholesale { TickPassesWithheld { refusal: _ } => true TickPassesRun => false })),
    json_kv(key: "spawn_mode", value: json_string(s: spawn_mode_label(m: t.reconcile.mode))),
    json_kv(key: "occupied", value: json_int(n: t.reconcile.occupied)),
    json_kv(key: "upserts", value: json_int(n: belt_reconcile_upsert_count(r: t.reconcile))),
    json_kv(key: "deferred", value: json_int(n: belt_tick_deferred_count(outcomes: t.spawn_outcomes))),
    json_kv(key: "refusal_count", value: json_int(n: belt_reconcile_refusal_count(r: t.reconcile))),
    json_kv(key: "spawned", value: json_int(n: belt_tick_spawn_ok_count(t: t))),
    json_kv(key: "spawn_failed", value: json_int(n: belt_tick_spawn_failed_count(t: t))),
    json_kv(key: "spawn_not_admitted", value: json_int(n: belt_tick_spawn_not_admitted_count(t: t))),
    json_kv(key: "reaped", value: json_int(n: belt_tick_teardown_ok_count(t: t))),
    json_kv(key: "spawn_outcomes", value: json_array(elements: t.spawn_outcomes |> map(o => belt_spawn_outcome_json(o: o)))),
    json_kv(key: "teardown_outcomes", value: json_array(elements: t.teardown_outcomes |> map(o => belt_teardown_outcome_json(o: o)))),
    json_kv(key: "discovery", value: belt_discovery_json(discovery: t.discovery)),
  ])
}

