// operator acceptance: the daily close, durable and deterministic.
//// the node must CLOSE: an acceptance fact, durable across restart, visible on the next page read,
// with no hand-commit and no redeploy. Before this module the only way was to hand-append an
// AcceptanceRecorded line to a committed JSONL carrier and redeploy — an operator act with no route
// at all.
//
// ONE HOME. An acceptance is a fact about a node, and every other fact about a node — who holds it,
// what it last said, whether it is retired — lives in the roadmap event log
// (gunbc.roadmap.roadmap_event_carrier). Since 2026-11-09 the acceptance lives there too, as the
// event kind AcceptanceRecorded, and nowhere else
// (gunbc.design_ruling::plans_reset_and_audit_recommendations_2026_11_08). The two former homes — the
// committed JSONL seed and this module's fabric partition "roadmap-operator-acceptance" — are retired:
// an acceptance the log does not hold is an acceptance that did not happen. The chain the acceptance
// tail used to be is read by nothing and written by nothing; its rows were migrated into the log's
// node chains, each acceptance an event under its own node, in the order the operator recorded them.
//
// WHAT THIS MODULE OWNS IS THE OPERATOR LAW, not the storage: what a close must prove (a merged PR read
// back through the GitHub boundary, the node's own review PR, a live receipt with a red control executed
// and a handback delivered), what it refuses (every refusal typed and located, never a default), and the
// receipt line's grammar — which is also the grammar the event's own members spell, so a line the law
// refuses never becomes an event and an event read back folds to the receipt the line would have parsed
// to. The append itself goes through the one command route that assigns an issue or retires a node
// (gunbc.roadmap.roadmap_issue_command issue_command_apply): there is no second writer to keep honest.
//
// THE MERGED PR IS A GATE AND AN ATTACHMENT, NEVER THE ACCEPTANCE FACT. The standing ruling
// "merged pull requests never accept" holds: the durable acceptance fact is the typed receipt
// (red-control executed + handback delivered — the same schema the native carrier parser admits).
// The PR enters twice, both honestly: (a) the route READS BACK GitHub through the extdeps.github
// boundary and refuses unless the PR is verifiably merged — an unavailable read refuses too, so a
// bare operator claim is never trusted; (b) the verified PR facts (url, merged_at, head sha) ride
// the durable chain event beside the canonical receipt line, so the record shows its own evidence.
module gunbc.roadmap.roadmap_operator_acceptance

import std.types { String, NonEmptyStr, Bool, Int, List, EpochSecs }
import std.nat { Nat, Zero }
import std.checked_arithmetic { checked_int_to_nat }
import std.integer { nat_to_int }
import std.optional { Present, Absent, Optional }
import std.content_hash { serialize_content_hash, Fnv1a64 }
import std.decimal { decimal_digit_char }
import extdeps.units.iso8601_calendar { Iso8601CivilDate, iso8601_civil_from_days, iso8601_floor_div, iso8601_seconds_per_day, iso8601_two_digits }
import extdeps.languages.json.emit { JsonValue, JsonKeyValue, json_kv, json_string, json_array, json_object, serialize_json }
import extdeps.github.pulls { PullRequestViewState, PullRequestViewOpen, PullRequestViewClosed, PullRequestViewMerged, PullRequestViewUnknown, github_pull_request_view_state_text }
// The capacity constant the close's own growth guard uses — the same budget the log's readers enforce.
import gunbc.fabric.fabric_event_log { event_log_read_budget }
import gunbc.roadmap.roadmap_model {
  RoadmapNodeId, RoadmapAcceptanceEvent, RoadmapAcceptanceReceipt, RoadmapAcceptanceRevocationFacts,
  AcceptanceHistoryReplayState, replay_acceptance_history, replay_acceptance_event, roadmap_criteria_digest,
  roadmap_acceptance_line_of_receipt, roadmap_acceptance_line_acceptance_receipt,
  roadmap_acceptance_line_revocation_facts,
}
import gunbc.roadmap.roadmap_status { TicketFields, RedControlExecuted, RedControlNotRun, HandbackDelivered, HandbackNotDelivered }
import gunbc.roadmap.roadmap_event_log {
  RoadmapNodeStanding, NodeReadyForReview, RoadmapEventId, RoadmapEventEnvelope, RoadmapAcceptanceEventRow,
  EventPrincipal, EventPrincipalAuthenticated,
  roadmap_acceptance_event_rows, roadmap_event_node_ids, roadmap_event_tips,
}
import gunbc.roadmap.roadmap_event_carrier {
  RoadmapEventCarrierLayout, roadmap_event_carrier_layout_for_instance, roadmap_events_read_all, roadmap_events_read,
  RoadmapAllEventsRead, AllEventsRead, AllEventsReadRefused, EventsRead, EventsReadRefused,
  EventAppended, EventAlreadyPresent, EventAppendRefused, CarrierClosed, CarrierSnapshotClose,
  SnapshotNotOpened, SnapshotClosed, SnapshotCloseFailed,
}
import gunbc.roadmap.roadmap_issue_command { IssueCommandSubject, AcceptNode, issue_command_apply }
import gunbc.roadmap.roadmap_dashboard_instance {
  HostDashboardInstance, dashboard_instance_for_repo_root, DashboardInstanceLookup, DashboardInstanceResolved, DashboardInstanceRootUnknown,
}
import gunbc.roadmap.roadmap_event_log { RoadmapEventEnvelope, roadmap_event_kind_word, roadmap_retired_node_ids_of, RoadmapRetiredNodeIds, RetiredNodeIdsLoaded, RetiredNodeIdsRefused, roadmap_acceptance_receipt_members }
import gunbc.roadmap.roadmap_model { RoadmapNodeId, RoadmapAcceptanceReceipt, AcceptanceRecorded, AcceptanceRevoked, roadmap_node_ids_contain, revocation_reopens_active_frontier }
import gunbc.principal_projection { principal_ref_parse_label }
import gunbc.roadmap.roadmap_acceptance_history_carrier {
  RoadmapAcceptanceEventHistoryLoad, RoadmapAcceptanceEventHistoryLoaded, RoadmapAcceptanceEventHistoryLoadRefused,
  load_roadmap_acceptance_event_history_from_carrier_text
}

// ── THE WIRE LINE ────────────────────────────────────────────────────────────────────────────────
// The receipt -> canonical-line direction of the carrier codec. The parser side is the trusted
// native seed; this produces exactly what that seed admits: {"variant":"acceptance_recorded",
// "receipt":{...}} with the six receipt members, the red_control/handback tagged sub-objects, and
// criteria_digest in lowercase hex16 (the parser's validate_hex16 law). Member order is fixed, so
// the same receipt always serializes byte-identically — the determinism the close's replay relies
// on. An evidence-free receipt has no wire form: it is not closable, and "" says so.

fn roadmap_operator_acceptance_receipt_line(receipt: RoadmapAcceptanceReceipt) -> String {
  let red_members = match receipt.red_control {
    RedControlExecuted { witness_module: wm, witness_fn: wf, executed_on: eo } => [
      json_kv("variant", json_string("red_control_executed")),
      json_kv("witness_module", json_string(wm as String)),
      json_kv("witness_fn", json_string(wf as String)),
      json_kv("executed_on", json_string(eo)),
    ]
    RedControlNotRun => [] as List<JsonKeyValue>
  }
  let handback_members = match receipt.handback {
    HandbackDelivered { first_artifact: fa, further_artifacts: extra } => [
      json_kv("variant", json_string("handback_delivered")),
      json_kv("first_artifact", json_string(fa as String)),
      json_kv("further_artifacts", json_array(map(extra, a => json_string(a as String)))),
    ]
    HandbackNotDelivered => [] as List<JsonKeyValue>
  }
  if count(red_members) == 0 || count(handback_members) == 0 {
    ""
  } else {
    serialize_json(v: json_object([
      json_kv("variant", json_string("acceptance_recorded")),
      json_kv("receipt", json_object([
        json_kv("node", json_string(receipt.node as String)),
        json_kv("criteria_digest", json_string(serialize_content_hash(hash: Fnv1a64(receipt.criteria_digest)) as String)),
        json_kv("red_control", json_object(red_members)),
        json_kv("handback", json_object(handback_members)),
        json_kv("accepted_by", json_string(receipt.accepted_by as String)),
        json_kv("accepted_on", json_string(receipt.accepted_on)),
      ])),
    ]))
  }
}

// ── THE LOAD: THE EVENT LOG, ALL OF IT ────────────────────────────────────────────────────────────
// THE ACCEPTANCE HISTORY, AS ONE LOAD. Every node the log speaks of, walked in causal order, its
// acceptance events taken out and replayed through the one replay law. A log that will not order, or a
// sequence the replay law refuses, answers with a located reason and writes nothing — the page, the
// inbox, the plan and the belt then say so rather than showing a history with a quiet gap
// (gunbc.design_argument::fail_closed). There is no seed prefix and no tail any more: one home, one
// reader, one law.
type RoadmapOperatorAcceptanceHistory
  = OperatorAcceptanceHistoryLoaded { events: List<RoadmapAcceptanceEvent>, replayed: AcceptanceHistoryReplayState, rows: List<RoadmapAcceptanceEventRow> }
  | OperatorAcceptanceHistoryRefused { detail: NonEmptyStr }

fn roadmap_operator_acceptance_history_of(envelopes: List<RoadmapEventEnvelope>) -> RoadmapOperatorAcceptanceHistory {
  match roadmap_operator_acceptance_rows_of_nodes(nodes: roadmap_event_node_ids(envs: envelopes), envelopes: envelopes, acc: []) {
    Absent => OperatorAcceptanceHistoryRefused { detail: "the event log's chains do not order" as NonEmptyStr }
    Present { value: rows } => {
      let events = map(rows, r => r.line)
      match replay_acceptance_history(events: events) {
        Absent => OperatorAcceptanceHistoryRefused { detail: roadmap_operator_acceptance_replay_violation(events: events) }
        Present { value: replayed } => OperatorAcceptanceHistoryLoaded { events: events, replayed: replayed, rows: rows }
      }
    }
  }
}

// ONE NODE AT A TIME, refusing the whole fold on the first chain that will not order: a partial
// acceptance history read as a complete one is how an acceptance gets recorded beside another one nobody
// could see.
fn roadmap_operator_acceptance_rows_of_nodes(
  nodes: List<RoadmapNodeId>,
  envelopes: List<RoadmapEventEnvelope>,
  acc: List<RoadmapAcceptanceEventRow>
) -> List<RoadmapAcceptanceEventRow>? {
  match nodes.first() {
    Absent => Present { value: acc }
    Present { value: hd } =>
      match roadmap_acceptance_event_rows(envs: filter(envelopes, e => (e.event.node as String) == (hd as String))) {
        Absent => none
        Present { value: rows } => roadmap_operator_acceptance_rows_of_nodes(nodes: nodes.skip(n: 1), envelopes: envelopes, acc: concat(acc, rows))
      }
  }
}

// THE READ, AFTER ITS SNAPSHOT IS CLOSED. A read-only load cannot carry a close handle through every
// consumer that wants an answer, so the reader that took the snapshot closes it here — the same law the
// serve display path applies to the same read (roadmap_serve::serve_all_events_after_snapshot_close),
// stated once in the module that owns the acceptance load so a reader cannot forget it
// (gunbc.design_argument::single_authority).
fn roadmap_all_events_after_snapshot_close(read: CarrierClosed<RoadmapAllEventsRead>) -> RoadmapAllEventsRead {
  match read.close {
    SnapshotNotOpened => read.result
    SnapshotClosed => read.result
    SnapshotCloseFailed { worktree: _, exit_code: _, stderr: _ } => read.result
  }
}

// THE LOAD PRODUCTION READS: the event log's acceptance history through the same reader the plan and the
// page use, or the located reason it cannot be had. This is the ONLY way an acceptance fact reaches a
// reader.
fn roadmap_operator_acceptance_history_load(layout: RoadmapEventCarrierLayout) -> RoadmapAcceptanceEventHistoryLoad {
  // The read opens a temporary snapshot worktree; this is a read-only load whose callers are pure
  // readers, and it is closed the way the serve display path closes the same read
  // (roadmap_serve::serve_all_events_after_snapshot_close) — by the reader that took it.
  match roadmap_all_events_after_snapshot_close(read: roadmap_events_read_all(layout: layout)) {
    AllEventsReadRefused { step, reason } =>
      RoadmapAcceptanceEventHistoryLoadRefused { detail: join(["event log read refused at ", step, ": ", reason], "") as NonEmptyStr }
    AllEventsRead { envelopes } => match roadmap_operator_acceptance_history_of(envelopes: envelopes) {
      OperatorAcceptanceHistoryRefused { detail: d } => RoadmapAcceptanceEventHistoryLoadRefused { detail: d }
      OperatorAcceptanceHistoryLoaded { events: events, replayed: _, rows: _ } => RoadmapAcceptanceEventHistoryLoaded { events: events }
    }
  }
}

type RoadmapAcceptanceTailParse
  = RoadmapAcceptanceTailOk { events: List<RoadmapAcceptanceEvent> }
  | RoadmapAcceptanceTailBad { line_index: Nat, detail: NonEmptyStr }

// THE RECEIPT LINE'S GRAMMAR, which is also the grammar the event's members spell. Each line through
// the SAME native parser (its law is per line), in order; the fold keeps the FIRST refusal and stops
// reporting after it — a caller refuses regardless, and one located cause is the honest diagnosis. This
// is the route an operator's line takes into an event, and the route the migration of the retired
// carriers' lines took into the log.
fn roadmap_operator_acceptance_parse_tail(lines: List<String>) -> RoadmapAcceptanceTailParse {
  fold(
    lines,
    init: RoadmapAcceptanceTailOk { events: [] as List<RoadmapAcceptanceEvent> },
    f: (acc, entry) => match acc {
      RoadmapAcceptanceTailBad { line_index: i, detail: d } => RoadmapAcceptanceTailBad { line_index: i, detail: d }
      RoadmapAcceptanceTailOk { events: got } =>
        match load_roadmap_acceptance_event_history_from_carrier_text(text: entry) {
          RoadmapAcceptanceEventHistoryLoadRefused { detail: d } => RoadmapAcceptanceTailBad { line_index: match checked_int_to_nat(n: count(got)) { Present { value: k } => k Absent => Zero }, detail: d as NonEmptyStr }
          RoadmapAcceptanceEventHistoryLoaded { events: parsed } =>
            match parsed.first() {
              Absent => RoadmapAcceptanceTailBad { line_index: match checked_int_to_nat(n: count(got)) { Present { value: k } => k Absent => Zero }, detail: "line parsed to no event" as NonEmptyStr }
              Present { value: e } => RoadmapAcceptanceTailOk { events: concat(got, [e]) }
            }
        }
    }
  )
}

// The replay law returned none — name WHERE it broke, for the located refusal. The law refuses exactly
// two things over one sequence — an acceptance recorded twice, or a revocation naming no live
// acceptance — so the walk replays the history event by event, stops at the first refusal, and names the
// acceptance at fault by the node it is about. An operator reading the refusal must be able to tell
// which acceptance to go and look at.
fn roadmap_operator_acceptance_replay_violation(events: List<RoadmapAcceptanceEvent>) -> String {
  roadmap_operator_acceptance_replay_walk(events: events, acc: roadmap_operator_empty_replay_state(), named: "the start of the log")
}

fn roadmap_operator_empty_replay_state() -> AcceptanceHistoryReplayState {
  AcceptanceHistoryReplayState { live: [], revoked: [], ever_recorded: [] }
}

fn roadmap_operator_acceptance_replay_walk(
  events: List<RoadmapAcceptanceEvent>,
  acc: AcceptanceHistoryReplayState,
  named: String
) -> String {
  match events.first() {
    Absent => join(["the acceptance history replays; no event after ", named, " was refused"], "")
    Present { value: hd } => match replay_acceptance_event(state: acc, event: hd) {
      Present { value: next } => roadmap_operator_acceptance_replay_walk(events: events.skip(n: 1), acc: next, named: roadmap_operator_acceptance_event_name(event: hd))
      Absent => roadmap_operator_acceptance_event_refusal(event: hd, state: acc)
    }
  }
}

fn roadmap_operator_acceptance_event_name(event: RoadmapAcceptanceEvent) -> String {
  match roadmap_acceptance_line_acceptance_receipt(line: event) {
    Present { value: r } => join(["the acceptance of node '", r.node as String, "'"], "")
    Absent => match roadmap_acceptance_line_revocation_facts(line: event) {
      Present { value: f } => join(["the revocation of the acceptance of node '", f.receipt.node as String, "'"], "")
      Absent => "an event the acceptance line law does not recognise"
    }
  }
}

// WHY THIS event is the one the law stops at, in the operator's own terms: a second acceptance of a node
// that already holds one, a receipt the history already carries, or a revocation of an acceptance the
// history does not hold live.
fn roadmap_operator_acceptance_event_refusal(event: RoadmapAcceptanceEvent, state: AcceptanceHistoryReplayState) -> String {
  match roadmap_acceptance_line_acceptance_receipt(line: event) {
    Present { value: r } =>
      if count(filter(state.live, x => (x.node as String) == (r.node as String))) > 0 {
        join(["node '", r.node as String, "' already holds a live acceptance; a second acceptance of the same node is refused"], "")
      } else {
        join(["the acceptance of node '", r.node as String, "' is already recorded in this history"], "")
      }
    Absent => match roadmap_acceptance_line_revocation_facts(line: event) {
      Present { value: f } =>
        join(["the revocation names no live acceptance of node '", f.receipt.node as String, "' — a revocation withdraws an acceptance the log holds, or it is not written"], "")
      Absent => "an event the acceptance line law does not recognise"
    }
  }
}

// ── THE CLOSE ────────────────────────────────────────────────────────────────────────────────────
// The write the operator's day needs. node + repo/PR are the required inputs; the receipt's
// criteria_digest DERIVES from the node's own ticket text, accepted_by is the authenticated principal
// the admission already verified, and the PR facts are the readback's, not the operator's claims.
// Same inputs -> the same line, the same operation-key replay, the same durable record.

type OperatorPrRow {
  number: Int
  // Absence is Optional here, the one spelling the codebase owns (std.optional::Optional;
  // dag_absence_is_one_meaning). The gh boundary collapses its three absence spellings — missing
  // member, JSON null, empty text — into Absent at the reader, so downstream there is no empty
  // string standing beside a present value, and the durable NonEmptyStr facts are only ever
  // built by matching Present. Construction, not validation, makes the bad case unwritable.
  // The decoded upstream word (extdeps.github.pulls.PullRequestViewState) — the state names
  // GitHub actually returns are an upstream fact and live there, not in a hand-written list here.
  state: PullRequestViewState?
  merged_at: NonEmptyStr?
  head_sha: NonEmptyStr?
}

// The GitHub readback as the boundary hands it over. Unreadable is a RESULT, never a default: an
// unavailable roster refuses the close fail-closed; it never admits one.
type OperatorPrReadback
  = PrRoster { rows: List<OperatorPrRow> }
  | PrReadbackUnavailable { cause: NonEmptyStr }

type OperatorCloseInputs {
  node: RoadmapNodeId
  ticket: TicketFields
  repo: NonEmptyStr
  pr_number: Int
  accepted_by: NonEmptyStr
  accepted_on: Iso8601CivilDate
  witness_module: NonEmptyStr
  witness_fn: NonEmptyStr
  first_artifact: NonEmptyStr
  further_artifacts: List<NonEmptyStr>
  at: EpochSecs
}

type OperatorCloseRefusal
  = CloseUnknownNode { node: NonEmptyStr }
  | CloseAlreadyClosed { node: NonEmptyStr }
  // The merged PR must be THE node's review PR, not any merged PR in the repo: the receipt is
  // evidence about one node, and citing an unrelated merged PR is a fabricated plausible output
  // (gunbc.design_argument::fail_closed). The node's NodeReadyForReview standing is where its PR is recorded; a mismatch
  // says both numbers, and no other standing can substitute.
  | ClosePrNotForNode { pr_number: Int, expected: NonEmptyStr }
  | CloseEvidenceMissing { field: NonEmptyStr }
  | ClosePrUnreadable { cause: NonEmptyStr }
  | ClosePrNotFound { pr_number: Int }
  | ClosePrNotMerged { pr_number: Int, state: NonEmptyStr }
  // The event log itself could not be read, or a chain in it could not be ordered. Named for what it
  // is now: the log is the one home, so "the tail is unreadable" and "the log is unreadable" are the
  // same fact and get one name.
  | CloseHistoryUnreadable { reason: NonEmptyStr }
  | CloseInvalidHistory { detail: NonEmptyStr }
  | CloseCapacityFull { budget: Nat }
  | CloseStaleHead
  | CloseChainWriteRefused { step: NonEmptyStr, reason: NonEmptyStr }

type OperatorCloseWrite
  = CloseWritten { event_id: RoadmapEventId }
  // The close's every durable fact — the receipt and the verified PR facts — is already in the log. The
  // answer is the FIRST recording's own event identity, never a recomputed twin of it.
  | CloseAlreadyRecorded { event_id: RoadmapEventId }
  | CloseRefused { reason: OperatorCloseRefusal }

type OperatorClosePrFacts { url: NonEmptyStr, merged_at: NonEmptyStr, head: NonEmptyStr }

// THE CLOSE, END TO END. The gate runs FIRST and fail-closed: a roster we cannot read is not evidence
// (ClosePrUnreadable); a PR absent from the roster is not merged (ClosePrNotFound); an open or
// closed-unmerged PR refuses with its state. Nothing downstream ever sees an unverified PR. Then the
// node's own lane must name that PR (readback-vs-record, never readback-vs-claim), then the log's
// acceptance history is read through the ONE reader production uses, then idempotency, then the
// already-closed refusal, then the evidence law, then the replay law WITH the new event in it, then the
// capacity law — and only then is the event appended, through the same route that assigns an issue or
// retires a node (gunbc.roadmap.roadmap_issue_command issue_command_apply). Every refusal is typed and
// named; none of them is a default.
fn roadmap_operator_close(
  instance: HostDashboardInstance,
  inputs: OperatorCloseInputs,
  readback: OperatorPrReadback,
  standing: RoadmapNodeStanding?
) -> OperatorCloseWrite {
  match roadmap_operator_close_pr_gate(inputs: inputs, readback: readback) {
    Present { value: refusal } => CloseRefused { reason: refusal }
    Absent => match roadmap_operator_close_pr_facts(inputs: inputs, readback: readback) {
      Absent => CloseRefused { reason: ClosePrNotFound { pr_number: inputs.pr_number } }
      Present { value: facts } =>
        match roadmap_operator_close_pr_binding(standing: standing, inputs: inputs) {
          Present { value: refusal } => CloseRefused { reason: refusal }
          Absent => {
            let layout = roadmap_event_carrier_layout_for_instance(instance: instance)
            match roadmap_all_events_after_snapshot_close(read: roadmap_events_read_all(layout: layout)) {
              AllEventsReadRefused { step, reason } => CloseRefused {
                reason: CloseHistoryUnreadable { reason: join(["event log read refused at ", step, ": ", reason], "") as NonEmptyStr } }
              AllEventsRead { envelopes } =>
                match roadmap_operator_acceptance_history_of(envelopes: envelopes) {
                  OperatorAcceptanceHistoryRefused { detail: d } => CloseRefused { reason: CloseInvalidHistory { detail: d } }
                  OperatorAcceptanceHistoryLoaded { events: events, replayed: replayed, rows: rows } =>
                    match roadmap_operator_close_existing(rows: rows, inputs: inputs, facts: facts) {
                      Present { value: already } => already
                      Absent =>
                        if roadmap_operator_node_has_live_receipt(replayed: replayed, node: inputs.node) {
                          CloseRefused { reason: CloseAlreadyClosed { node: inputs.node as NonEmptyStr } }
                        } else {
                          match roadmap_operator_close_record(inputs: inputs) {
                            Present { value: refusal } => CloseRefused { reason: refusal }
                            Absent =>
                              match replay_acceptance_history(events: concat(events, [roadmap_acceptance_line_of_receipt(receipt: roadmap_operator_close_receipt(inputs: inputs))])) {
                                Absent => CloseRefused { reason: CloseInvalidHistory { detail: "the close would make the event log's history replay-invalid" as NonEmptyStr } }
                                Present { value: _ } =>
                                  if roadmap_operator_close_over_budget(rows: rows) {
                                    CloseRefused { reason: CloseCapacityFull { budget: event_log_read_budget() } }
                                  } else {
                                    roadmap_operator_close_append(instance: instance, inputs: inputs, facts: facts)
                                  }
                              }
                          }
                        }
                    }
                }
            }
          }
        }
    }
  }
}

// The budget check in the Int lane, crossing to Nat once through
// std.checked_arithmetic::checked_int_to_nat — the single Int->Nat crossing this codebase already owns.
// count()'s answer is a list length, never negative, so the checked arm's Absent cannot arise; Zero there
// compares under budget, which fails open ONLY into the append's own capacity law, never into an
// unbounded write. The population counted is the log's own acceptance records — the ones that grow.
fn roadmap_operator_close_over_budget(rows: List<RoadmapAcceptanceEventRow>) -> Bool {
  match checked_int_to_nat(n: count(rows) + 1) {
    Absent => false
    Present { value: n } => n > event_log_read_budget()
  }
}

// Does a review standing's pr reference name exactly this PR number? The published carriers are
// a number tail after '#' (owner/repo#12210) or after the last '/' (…/pull/4242) — both are real
// in the event lane today. The tail must equal the canonical decimal of the number: "007", "7x"
// and "" are not 7. No parsing, so no parse can lie.
fn roadmap_operator_pr_ref_matches(pr: NonEmptyStr, number: Int) -> Bool {
  match last(split(s: pr as String, delimiter: "#")) {
    Absent => false
    Present { value: tail } =>
      match last(split(s: tail, delimiter: "/")) {
        Absent => false
        Present { value: seg } => seg == to_string(value: number)
      }
  }
}

// A merged PR only closes the node it belongs to: the node's NodeReadyForReview standing is the
// fabric's own record of that PR, so the comparison is readback-vs-record, never readback-vs-claim.
// No standing means no node on the lane; any other standing means the node never published a
// review PR — closing it on a PR claim would fabricate the link the receipt cites.
fn roadmap_operator_close_pr_binding(
  standing: RoadmapNodeStanding?,
  inputs: OperatorCloseInputs
) -> OperatorCloseRefusal? {
  match standing {
    Absent => Present { value: CloseUnknownNode { node: inputs.node as NonEmptyStr } }
    Present { value: NodeReadyForReview { pr: pr, head: _ } } =>
      if roadmap_operator_pr_ref_matches(pr: pr, number: inputs.pr_number) { none }
      else { Present { value: ClosePrNotForNode { pr_number: inputs.pr_number, expected: pr } } }
    Present { value: _ } => Present { value: ClosePrNotForNode { pr_number: inputs.pr_number, expected: "no review standing (node is not ready for review)" as NonEmptyStr } }
  }
}

fn roadmap_operator_close_pr_gate(inputs: OperatorCloseInputs, readback: OperatorPrReadback) -> OperatorCloseRefusal? {
  match readback {
    PrReadbackUnavailable { cause: c } => Present { value: ClosePrUnreadable { cause: c } }
    PrRoster { rows: rows } =>
      match filter(rows, r => r.number == inputs.pr_number).first() {
        Absent => Present { value: ClosePrNotFound { pr_number: inputs.pr_number } }
        Present { value: row } => if roadmap_operator_pr_is_merged(row: row) { none } else { Present { value: ClosePrNotMerged { pr_number: inputs.pr_number, state: roadmap_operator_pr_state_text(row: row) } } }
      }
  }
}

// Merged is what GitHub says, read back — the decoded upstream state (extdeps.github.pulls)
// AND a merged_at AND a head sha, each by matching Present. The two carrier conventions are the
// upstream's own (the gh CLI view says MERGED; the REST pull object says closed and proves merge
// with mergedAt), so both constructors admit; an unknown word, an open PR, or a closed PR without
// a merged_at all refuse. No hand-written state-word list lives on this side of the boundary.
fn roadmap_operator_pr_is_merged(row: OperatorPrRow) -> Bool {
  match row.state {
    Absent => false
    Present { value: PullRequestViewMerged } =>
      match row.merged_at {
        Absent => false
        Present { value: _ } => match row.head_sha { Absent => false Present { value: _ } => true }
      }
    Present { value: PullRequestViewClosed } =>
      match row.merged_at {
        Absent => false
        Present { value: _ } => match row.head_sha { Absent => false Present { value: _ } => true }
      }
    Present { value: _ } => false
  }
}

// The state as the refusal names it, rendered by the upstream model; an absent word reads "none".
fn roadmap_operator_pr_state_text(row: OperatorPrRow) -> NonEmptyStr {
  match row.state {
    Present { value: st } => github_pull_request_view_state_text(state: st)
    Absent => "none" as NonEmptyStr
  }
}

fn roadmap_operator_close_pr_facts(inputs: OperatorCloseInputs, readback: OperatorPrReadback) -> OperatorClosePrFacts? {
  match readback {
    PrReadbackUnavailable { cause: _ } => none
    PrRoster { rows: rows } =>
      match filter(rows, r => r.number == inputs.pr_number).first() {
        Absent => none
        Present { value: row } =>
          // The durable NonEmptyStr facts are BUILT BY MATCHING PRESENT — no cast and no reliance
          // on an earlier gate: a row missing either fact cannot construct them at all, it can
          // only answer none (which the gate renders as its typed refusal).
          match row.merged_at {
            Absent => none
            Present { value: m } =>
              match row.head_sha {
                Absent => none
                Present { value: h } => Present { value: OperatorClosePrFacts {
                  url: join(["https://github.com/", inputs.repo as String, "/pull/", to_string(value: inputs.pr_number)], "") as NonEmptyStr,
                  merged_at: m,
                  head: h,
                } }
              }
          }
      }
  }
}

// The replayed state already refuses a second live receipt for one node; naming it here turns that
// law into the operator's typed CloseAlreadyClosed rather than a generic history refusal.
fn roadmap_operator_node_has_live_receipt(replayed: AcceptanceHistoryReplayState, node: RoadmapNodeId) -> Bool {
  count(filter(replayed.live, r => r.node == node)) > 0
}

fn roadmap_operator_close_receipt(inputs: OperatorCloseInputs) -> RoadmapAcceptanceReceipt {
  RoadmapAcceptanceReceipt {
    node: inputs.node,
    criteria_digest: roadmap_criteria_digest(t: inputs.ticket),
    red_control: RedControlExecuted { witness_module: inputs.witness_module, witness_fn: inputs.witness_fn, executed_on: roadmap_operator_render_civil_date(date: inputs.accepted_on) },
    handback: HandbackDelivered { first_artifact: inputs.first_artifact, further_artifacts: inputs.further_artifacts },
    accepted_by: inputs.accepted_by,
    accepted_on: roadmap_operator_render_civil_date(date: inputs.accepted_on),
  }
}

// Inputs -> a wire-able record, or the located refusal. accepted_on must be a YYYY-MM-DD date (the
// carrier's form); the receipt needs real red-control and handback evidence — empty witness fields
// are refused here, with the field named, rather than minting an admissible-looking nothing.
fn roadmap_operator_close_record(inputs: OperatorCloseInputs) -> OperatorCloseRefusal? {
  // The date needs NO check: OperatorCloseInputs.accepted_on is an Iso8601CivilDate derived from
  // the clock through the shared calendar law (extdeps.units.iso8601_calendar) — there is no
  // hand-authored door, so a wrong state is unwritable, not validated (gunbc.design_argument::fail_closed). The
  // witness_module/witness_fn/first_artifact emptiness branches were deleted for the same reason:
  // NonEmptyStr already holds that constraint, so a check restating it is a second representation
  // (gunbc.design_argument::minimize_redundancy, gunbc.design_argument::single_authority). What is actually unchecked below is the receipt LINE — a String — so it is checked.
  if roadmap_operator_acceptance_receipt_line(receipt: roadmap_operator_close_receipt(inputs: inputs)) == "" { Present { value: CloseEvidenceMissing { field: "red_control/handback" as NonEmptyStr } } } else { none }
}

// Idempotency by operation key, read from the chain itself: the same key carrying the same close
// (same canonical line, same verified PR) is CloseAlreadyRecorded with the STORED event's id — the
// durable record of the first attempt, never a recomputed twin; the same key carrying different
// content is the typed CloseKeyConflict.
// KEY IDEMPOTENCY, BEFORE THE SIDE EFFECT CAN REFUSE THE CALLER. A close whose every durable fact — the
// receipt AND the verified PR facts — is already in the log answers the FIRST recording, carrying that
// event's own identity. It is checked before the already-closed refusal because a retry of a recorded
// close is not a second close: the same bytes must not be able to produce a second refusal, and never a
// second event. The match is on the stored record's content, not on a caller's key — an event's identity
// IS its content, so "the same submission twice" and "the same record twice" are one question here
// (gunbc.design_argument::minimize_redundancy: the operation key the fabric record needed has no home
// now that the record is an event).
fn roadmap_operator_close_existing(
  rows: List<RoadmapAcceptanceEventRow>,
  inputs: OperatorCloseInputs,
  facts: OperatorClosePrFacts
) -> OperatorCloseWrite? {
  match roadmap_operator_close_matching_row(rows: rows, inputs: inputs, facts: facts) {
    Absent => none
    Present { value: row } => Present { value: CloseAlreadyRecorded { event_id: row.id } }
  }
}

// The row that already carries THIS close: the same receipt on the same node, under the same review
// thread, merged at the same time at the same head. The receipt is compared through the one canonical
// line form, so the comparison is the operator law's own, field for field.
fn roadmap_operator_close_matching_row(
  rows: List<RoadmapAcceptanceEventRow>,
  inputs: OperatorCloseInputs,
  facts: OperatorClosePrFacts
) -> RoadmapAcceptanceEventRow? {
  match rows.first() {
    Absent => none
    Present { value: hd } =>
      if roadmap_operator_close_row_is_this_close(row: hd, inputs: inputs, facts: facts) {
        Present { value: hd }
      } else {
        roadmap_operator_close_matching_row(rows: rows.skip(n: 1), inputs: inputs, facts: facts)
      }
  }
}

fn roadmap_operator_close_row_is_this_close(row: RoadmapAcceptanceEventRow, inputs: OperatorCloseInputs, facts: OperatorClosePrFacts) -> Bool {
  match roadmap_acceptance_line_acceptance_receipt(line: row.line) {
    Absent => false
    Present { value: receipt } =>
      (receipt.node as String) == (inputs.node as String)
        && roadmap_operator_acceptance_receipt_line(receipt: receipt) == roadmap_operator_acceptance_receipt_line(receipt: roadmap_operator_close_receipt(inputs: inputs))
        && row.pr_url == (facts.url as String)
        && row.merged_at == (facts.merged_at as String)
        && row.head_sha == (facts.head as String)
  }
}

// THE APPEND, THROUGH THE ONE ROUTE. The close builds an AcceptNode command and hands it to
// gunbc.roadmap.roadmap_issue_command::issue_command_apply — the same route that assigns an issue or
// retires a node — so acceptance is an event like any other, there is no second writer to keep honest,
// and the route's own laws do the refusing: the receipt must name the node the subject names
// (issue_command_receipt_disagreement), the parent must be the chain's current tip as read a moment ago
// (a chain that moved underneath is the typed CloseStaleHead, never a blind write), and the carrier's
// admission law refuses a history that cannot be ordered. The author is the operator the receipt names,
// as an AUTHENTICATED principal: an event's author is who wrote it, and a bare email cannot be written.
// The snapshot the reads open is the same temporary worktree the serve display path reads through
// (roadmap_serve serve_all_events_after_snapshot_close); the write itself is closed by its own route.
fn roadmap_operator_close_append(
  instance: HostDashboardInstance,
  inputs: OperatorCloseInputs,
  facts: OperatorClosePrFacts
) -> OperatorCloseWrite {
  match principal_ref_parse_label(s: inputs.accepted_by as String) {
    Absent => CloseRefused { reason: CloseEvidenceMissing { field: "accepted_by (not an authenticated principal spelling)" as NonEmptyStr } }
    Present { value: author_ref } => {
      let layout = roadmap_event_carrier_layout_for_instance(instance: instance)
      match roadmap_operator_acceptance_tip(layout: layout, node: inputs.node) {
        CloseTipRefused { reason: r } => CloseRefused { reason: CloseHistoryUnreadable { reason: r } }
        CloseTipUnordered => CloseRefused { reason: CloseHistoryUnreadable { reason: "the node's lane has more than one tip, so nothing may be hung on it" as NonEmptyStr } }
        CloseTipAt { expected: expected } => {
          let applied = issue_command_apply(
            layout: layout,
            command: AcceptNode {
              subject: IssueCommandSubject {
                node: inputs.node,
                author: EventPrincipalAuthenticated { ref: author_ref },
                operation: inputs.node as NonEmptyStr,
                expected: expected,
              },
              receipt: roadmap_operator_close_receipt(inputs: inputs),
              // The close route always names the pull request it was earned by: the PR facts are read
              // from GitHub before this point, so the evidence is never absent here (an absent triple is
              // the migration's case alone, and only before the cutoff).
              pr_url: Present { value: facts.url as String as NonEmptyStr },
              merged_at: Present { value: facts.merged_at as String as NonEmptyStr },
              head_sha: Present { value: facts.head as String as NonEmptyStr },
            },
            recorded_at: roadmap_operator_render_civil_date(date: roadmap_operator_date_from_epoch_secs(secs: inputs.at)))
          match applied.result {
            EventAppended { id } => CloseWritten { event_id: id }
            EventAlreadyPresent { id } => CloseAlreadyRecorded { event_id: id }
            EventAppendRefused { id: _, step, reason } => CloseRefused {
              reason: CloseChainWriteRefused { step: step as NonEmptyStr, reason: reason as NonEmptyStr } }
          }
        }
      }
    }
  }
}

// THE TIP THE CLOSE EXPECTS, read from the node's own lane: the event no other event names as its
// parent, or none when the lane is empty. Two tips is a fork — a state to refuse to write onto, never a
// state to pick a favourite out of.
type RoadmapCloseTip
  = CloseTipAt { expected: RoadmapEventId? }
  | CloseTipUnordered
  | CloseTipRefused { reason: NonEmptyStr }

fn roadmap_operator_acceptance_tip(layout: RoadmapEventCarrierLayout, node: RoadmapNodeId) -> RoadmapCloseTip {
  let read = roadmap_events_read(layout: layout, node: node)
  match read.result {
    EventsReadRefused { node: _, step, reason } => CloseTipRefused { reason: join([step, ": ", reason], "") as NonEmptyStr }
    EventsRead { node: _, envelopes: envs } =>
      roadmap_operator_close_tip_of(tips: roadmap_event_tips(envs: envs))
  }
}

// One tip is the tip; none is an empty lane; more than one is a fork to refuse to write onto.
fn roadmap_operator_close_tip_of(tips: List<RoadmapEventEnvelope>) -> RoadmapCloseTip {
  if count(tips) > 1 {
    CloseTipUnordered
  } else {
    match tips.first() {
      Absent => CloseTipAt { expected: none }
      Present { value: only } => CloseTipAt { expected: Present { value: only.id } }
    }
  }
}

type OperatorNodeClosedStatus
  = AcceptanceFound
  | AcceptanceAbsent
  | ClosedStatusUnreadable { reason: NonEmptyStr }

fn roadmap_operator_node_closed(node: RoadmapNodeId, history: RoadmapAcceptanceEventHistoryLoad) -> OperatorNodeClosedStatus {
  match history {
    RoadmapAcceptanceEventHistoryLoadRefused { detail: d } => ClosedStatusUnreadable { reason: d as NonEmptyStr }
    RoadmapAcceptanceEventHistoryLoaded { events: events } =>
      match replay_acceptance_history(events: events) {
        Absent => ClosedStatusUnreadable { reason: "acceptance history does not replay" as NonEmptyStr }
        Present { value: state } => if roadmap_operator_node_has_live_receipt(replayed: state, node: node) { AcceptanceFound } else { AcceptanceAbsent }
      }
  }
}

// The belt's entry: the merged history over the instance's fabric store, then the closed read.
// A REFUSED placement fails the load closed (a tail may exist and cannot be read — never hide it);
// an UNPLACED binding reads the seed alone, which is the truth where no runtime store has ever
// existed (repo tools, authoring time).
// THE ACCEPTANCE HISTORY THE AUTHORITY, THE PAGE, THE INBOX AND THE BELT READ: the event log, through
// the one load. A refusal is carried, never swallowed — a reader that cannot have the history says so,
// and a node's closed-ness is reported as refused rather than absent, because "absent" would be an
// opinion about a history nobody read (gunbc.design_argument::fail_closed).
fn roadmap_operator_close_history(layout: RoadmapEventCarrierLayout) -> RoadmapAcceptanceEventHistoryLoad {
  roadmap_operator_acceptance_history_load(layout: layout)
}

fn roadmap_operator_date_from_epoch_secs(secs: EpochSecs) -> Iso8601CivilDate {
  iso8601_civil_from_days(days: iso8601_floor_div(a: secs, b: iso8601_seconds_per_day()))
}

// Text only at the write: the wire carrier's accepted_on takes YYYY-MM-DD; the two-digit form is
// the calendar's, and this is the one place the civil date becomes text.
fn roadmap_operator_render_civil_date(date: Iso8601CivilDate) -> NonEmptyStr {
  join([to_string(value: date.year), "-", iso8601_two_digits(n: date.month), "-", iso8601_two_digits(n: date.day)], "") as NonEmptyStr
}

// ──────────────────────────────────────────────────────────────────────────────────────────────
// THE MIGRATION'S OWN WITNESS: WHAT THE ONE HOME MUST HOLD BEFORE IT MAY SERVE.
//
// A readable empty log is NOT proof that the old acceptance history arrived in it (review of
// gunb-ai/gunbc#16189). So the migration is not finished when the appends stop answering with
// success — it is finished when this function, run over the LIVE carrier, says the facts it must hold
// are the facts it holds. It is the activation gate: the new roadmap service starts only after it
// prints MIGRATION VERIFIED, and refuses to start when it prints MIGRATION REFUSED.
//
// THREE SEPARATE COMPARISONS, BECAUSE THEY FAIL DIFFERENTLY — all of them in one pure function,
// roadmap_acceptance_migration_problems, so each is witnessed directly over constructed lists and not
// only through a live carrier:
//   1. THE FACTS, AS A MULTISET, NOT A SET. Each side's COUNT of each COMPLETE canonical fact must
//      agree. The fact is spelled by the same member law that writes the event's own canonical bytes:
//      node, criteria digest, the red-control variant with its witness module, fn and executed day, the
//      handback variant with its artifacts, the accepting principal and day — and for a revocation its
//      disposition, reason, revoker and day. Comparing node and receipt digest alone would certify an
//      event whose evidence had been swapped, and membership tested with `any` cannot see a count
//      disagree; both refusals name the fact and both counts. The manifest is the exported text of the
//      old carriers — the seed jsonl and the fabric tail's own lines — so the comparison is between what
//      WAS recorded and what IS held, never between two readings of one source.
//   2. CLOSEDNESS, BOTH WAYS. The receipts the manifest's own sequence leaves live, against what the
//      log's reader (roadmap_operator_node_closed) establishes: an acceptance the log lost refuses, and
//      so does a node the log calls closed that the manifest never accepted — the migration may not
//      invent a closed node either. And a manifest that does not replay REFUSES: an unorderable history
//      is not evidence that nothing was closed, and reading it as an empty expectation would certify
//      whatever the log happened to hold.
//   3. the retired roster: every node named must be in the log's retired set, and an unorderable lane
//      REFUSES rather than answering "nothing is retired" (RoadmapRetiredNodeIds is a fail-closed sum).
//
// The per-event ids are printed because a receipt is an identity, not a count: the runbook's receipts
// are these ids, read out of the carrier the same reader production uses.
// ──────────────────────────────────────────────────────────────────────────────────────────────
fn roadmap_acceptance_migration_verify(
  repo_root: String, expected_manifest: String, retired_roster: String
) -> String {
  match dashboard_instance_for_repo_root(repo_root: repo_root) {
    DashboardInstanceRootUnknown { repo_root: r } =>
      join(["MIGRATION REFUSED: no dashboard instance is registered at ", r, " — the migration runs over a registered instance's carrier, never an arbitrary path"], "")
    DashboardInstanceResolved { instance } => roadmap_acceptance_migration_verify_instance(
      instance: instance, expected_manifest: expected_manifest, retired_roster: retired_roster)
  }
}

fn roadmap_acceptance_migration_verify_instance(
  instance: HostDashboardInstance, expected_manifest: String, retired_roster: String
) -> String {
  let layout = roadmap_event_carrier_layout_for_instance(instance: instance)
  match roadmap_all_events_after_snapshot_close(read: roadmap_events_read_all(layout: layout)) {
    AllEventsReadRefused { step, reason } =>
      join(["MIGRATION REFUSED: the event log read failed at ", step, ": ", reason], "")
    AllEventsRead { envelopes } =>
      match roadmap_operator_acceptance_history_of(envelopes: envelopes) {
        OperatorAcceptanceHistoryRefused { detail: d } =>
          join(["MIGRATION REFUSED: the event log does not replay: ", d as String], "")
        OperatorAcceptanceHistoryLoaded { events: log_events, replayed: _, rows: _ } =>
          match roadmap_operator_acceptance_parse_tail(
            lines: filter(split(s: expected_manifest, delimiter: "\n"), l => count(l) > 0)) {
            RoadmapAcceptanceTailBad { line_index: i, detail: d } =>
              join(["MIGRATION REFUSED: manifest line ", to_string(value: i), " is not a valid acceptance event: ", d as String], "")
            RoadmapAcceptanceTailOk { events: wanted } =>
              match roadmap_retired_node_ids_of(envs: envelopes) {
                RetiredNodeIdsRefused { detail: d } =>
                  join(["MIGRATION REFUSED: the retired lane does not order: ", d as String], "")
                RetiredNodeIdsLoaded { ids: retired_ids } =>
                  roadmap_acceptance_migration_verdict(
                    wanted: wanted, log_events: log_events, envelopes: envelopes,
                    layout: layout, retired_ids: retired_ids, retired_roster: retired_roster)
              }
          }
      }
  }
}

// THE CANONICAL FACT, WHOLE. A migration is certified against the event's COMPLETE evidence, spelled by
// the same member law that writes the event's canonical bytes (gunbc.roadmap.roadmap_event_log
// roadmap_acceptance_receipt_members): the node, the criteria digest, the red-control variant with its
// witness module, fn and executed day, the handback variant with its first and further artifacts, the
// accepting principal and day — and for a revocation its disposition, its reason, its revoker and its
// day too. Comparing node and criteria digest alone would certify a migrated acceptance whose
// red-control witness, handback artifact, accepting principal or day had been swapped: the standing
// still folds the same way, and the receipt is no longer the one the operator wrote (witness:
// a_migrated_event_with_swapped_evidence_disagrees_with_the_manifest).
fn roadmap_acceptance_migration_identity(e: RoadmapAcceptanceEvent) -> String {
  match e {
    AcceptanceRecorded { receipt } =>
      join(["acceptance|", serialize_json(v: json_object(roadmap_acceptance_receipt_members(r: receipt)))], "")
    AcceptanceRevoked { exact_prior_receipt, disposition, reason, revoked_by, revoked_on } =>
      join(["revocation|",
            if revocation_reopens_active_frontier(disposition: disposition) { "reopens" } else { "remains" },
            "|", reason, "|", revoked_by, "|", revoked_on, "|",
            serialize_json(v: json_object(roadmap_acceptance_receipt_members(r: exact_prior_receipt)))], "")
  }
}

// THE COMPARISON, PURE: the verifier's refusal logic in one function nobody can skip, so every refusal
// is witnessed directly over constructed lists rather than only through a live carrier. Three
// independent failures, each reported with the fact that failed:
//   1. THE FACTS, AS A MULTISET — not by membership. `any` cannot see that a manifest naming one
//      acceptance twice met a log holding it once, so each side's COUNT of each distinct fact must
//      agree: a lost event, a duplicated event and an altered event all refuse, with both counts and the
//      fact named.
//   2. CLOSEDNESS, BOTH WAYS. An acceptance the manifest leaves closed on a live receipt that the log's
//      own reader does not confirm refuses — and so does a node the log calls closed that the manifest
//      never accepted, because the migration may not invent a closed node either. And a manifest that
//      does not replay is itself a refusal: it is not evidence of nothing, and reading it as an empty
//      expectation would certify whatever the log happened to hold.
//   3. THE RETIRED ROSTER: a node the runbook claims retired that the log does not hold retired.
fn roadmap_acceptance_migration_problems(
  wanted: List<RoadmapAcceptanceEvent>,
  held: List<RoadmapAcceptanceEvent>,
  closed_nodes: List<String>,
  not_retired: List<String>,
) -> List<String> {
  let wanted_facts = map(wanted, e => roadmap_acceptance_migration_identity(e: e))
  let held_facts = map(held, e => roadmap_acceptance_migration_identity(e: e))
  let facts = fold(concat(wanted_facts, held_facts), init: [] as List<String>, f: (acc, x) =>
    if any(acc, a => a == x) { acc } else { concat(acc, [x]) })
  let count_problems = filter(
    map(facts, fct => {
      let want_count = count(filter(wanted_facts, w => w == fct))
      let have_count = count(filter(held_facts, h => h == fct))
      if have_count == want_count { "" }
      else {
        join(["the log does not hold the manifest's fact in the same number: expected ",
          to_string(value: want_count), ", the log holds ", to_string(value: have_count), ", for ", fct], "")
      }
    }),
    pr => pr != "")
  let replay_problems = match replay_acceptance_history(events: wanted) {
    Present { value: state } => {
      let expected_closed = map(state.live, r => r.node as String)
      concat(
        filter(expected_closed, n => !any(closed_nodes, cn => cn == n),
          n => join(["the manifest leaves ", n, " closed on a live receipt; the log does not say so", ""], "")),
        filter(closed_nodes, cn => !any(expected_closed, n => n == cn),
          cn => join(["the log calls ", cn, " closed on a live receipt the exported manifest never accepted", ""], "")))
    }
    // The manifest IS the evidence. An acceptance history that cannot be put in order — a revocation or
    // an acceptance whose live receipt the events before it never established — is not evidence that
    // nothing was closed; treating it as an empty expectation would certify whatever the log held.
    Absent => ["the exported manifest does not replay as an acceptance history; nothing can be certified from it"]
  }
  let retired_problems = map(not_retired, n => join(["the log does not hold ", n, " retired", ""], ""))
  concat(concat(count_problems, replay_problems), retired_problems)
}

fn roadmap_acceptance_migration_verdict(
  wanted: List<RoadmapAcceptanceEvent>, log_events: List<RoadmapAcceptanceEvent>,
  envelopes: List<RoadmapEventEnvelope>, layout: RoadmapEventCarrierLayout,
  retired_ids: List<RoadmapNodeId>, retired_roster: String
) -> String {
  let held_ids = map(log_events, e => roadmap_acceptance_migration_identity(e: e))
  let history = roadmap_operator_close_history(layout: layout)
  // What the LOG's own reader says is closed: the nodes whose live receipt its fold establishes. The
  // manifest's own sequence is replayed separately, inside the comparison below — two folds over two
  // sources, so a lost acceptance or an un-applied revocation is a disagreement, never a silence.
  let closed_nodes = map(
    filter(log_events, e =>
      roadmap_operator_node_closed(node: roadmap_acceptance_migration_event_node(e: e) as NonEmptyStr as RoadmapNodeId, history: history) == AcceptanceFound),
    e => roadmap_acceptance_migration_event_node(e: e))
  let roster = filter(split(s: retired_roster, delimiter: ","), n => count(n) > 0)
  let not_retired = filter(roster, n => !roadmap_node_ids_contain(ids: retired_ids, node: n as NonEmptyStr as RoadmapNodeId))
  let problems = roadmap_acceptance_migration_problems(
    wanted: wanted, held: log_events, closed_nodes: closed_nodes, not_retired: not_retired)
  let event_lines = map(
    filter(envelopes, env => match env.event.kind {
      AcceptanceRecordedEvent { receipt: _, pr_url: _, merged_at: _, head_sha: _ } => true
      AcceptanceRevokedEvent { receipt: _, disposition: _, revoked_by: _, revoked_on: _, reason: _ } => true
      _ => false }),
    env => join(["  EVENT ", env.id as String, " ", env.event.node as String, " ", roadmap_event_kind_word(k: env.event.kind)], ""))
  if count(problems) > 0 {
    join(concat([join(["MIGRATION REFUSED: ", to_string(value: count(wanted)), " manifest events, ",
      to_string(value: count(held_ids)), " held, ", to_string(value: count(problems)), " disagreement(s):"], "")],
      concat(map(problems, pr => join(["  ", pr], "")), event_lines)), "\n")
  } else {
    join(concat([join(["MIGRATION VERIFIED: ", to_string(value: count(wanted)), " manifest events (",
      to_string(value: count(filter(wanted, e => match e { AcceptanceRecorded { receipt: _ } => true AcceptanceRevoked { exact_prior_receipt: _, disposition: _, reason: _, revoked_by: _, revoked_on: _ } => false }))), " acceptances, ",
      to_string(value: count(filter(wanted, e => match e { AcceptanceRecorded { receipt: _ } => false AcceptanceRevoked { exact_prior_receipt: _, disposition: _, reason: _, revoked_by: _, revoked_on: _ } => true }))), " revocations), ",
      to_string(value: count(roster)), " retired node(s) named, all held; ",
      to_string(value: count(held_ids)), " acceptance events held in the log:"], "")], event_lines), "\n")
  }
}

// The node an acceptance event is about — the receipt's own field, never a second naming of it.
fn roadmap_acceptance_migration_event_node(e: RoadmapAcceptanceEvent) -> String {
  match e {
    AcceptanceRecorded { receipt } => receipt.node as String
    AcceptanceRevoked { exact_prior_receipt, disposition: _, reason: _, revoked_by: _, revoked_on: _ } =>
      exact_prior_receipt.node as String
  }
}
