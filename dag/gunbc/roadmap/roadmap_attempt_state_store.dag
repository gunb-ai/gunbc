// THE PER-ATTEMPT DISPATCH STATE STORE (inventory row Seeadecb2). One attempt's state is one directory
// `<node>-a<attempt_key>` directly under the instance's dispatch attempt-state root, plus the node's
// `<node>-current` pointer directory. SEALED IN PLACE, NO FORMAT CHANGE: every file keeps the name and the
// bytes the unsealed path functions gave it. What changes is who may name a file: the closed
// AttemptStateMember and AttemptStateDirectory below are the only way to address an entry, and the store is
// the only value the operations take.
//
// THE DECLARATION IS DATA: the file names and the directory segments below are rows read by
// attempt_state_member_name and attempt_state_directory_name, the only places a basename is written. Adding
// a file is a variant and a row, never a path at a call site.
// THE ONE DECLARATION OF THE STORE (the `<store>_slots` row): how an attempt's and a node's-current directory
// entries are named under the dispatch attempt-state root. The directories' modes stay in
// attempt_state_prepare_argvs_for_instance, which creates them per attempt (they cannot be listed in the
// instance directory list: there is one per attempt), and read the entry names from this row.
type AttemptStateSlotsDeclaration { attempt_infix: String, current_suffix: String }

data attempt_state_slots: AttemptStateSlotsDeclaration = AttemptStateSlotsDeclaration {
  attempt_infix: "-a",
  current_suffix: "-current",
}

type AttemptStateDirectory
  = AttemptDirectoryRoot
  | AttemptDirectoryWorker
  | AttemptDirectoryWire
  | AttemptDirectoryPublication
  | AttemptDirectoryVerification
  | AttemptDirectoryReview
  | AttemptDirectoryAudit
  | AttemptDirectorySupervisor

fn attempt_state_directory_segment(directory: AttemptStateDirectory) -> String {
  match directory {
    AttemptDirectoryRoot => ""
    AttemptDirectoryWorker => "worker"
    AttemptDirectoryWire => "worker/provider-events.jsonl.wire/"
    AttemptDirectoryPublication => "publication"
    AttemptDirectoryVerification => verification_directory_segment
    AttemptDirectoryReview => "review"
    AttemptDirectoryAudit => "audit"
    AttemptDirectorySupervisor => "supervisor"
  }
}

type AttemptStateMember
  = AttemptKeyRecord
  | AttemptProcessFingerprint
  | AttemptContinuationTurn
  | AttemptAlignmentBinding
  | AttemptEnvironmentAdmission
  | AttemptLaunchIdentity
  | AttemptSpawnOrigin
  | AttemptVerificationRecord
  | AttemptSpawnFailure
  | AttemptRequestBindingFile
  | AttemptCommitOutcomeLast
  | AttemptOracleIdentity
  | AttemptOracleRevision
  | AttemptOraclePinRefused
  | AttemptValidationReceipt
  | AttemptWorkerRequestScratch
  | AttemptPublicationReceipt { head_sha: String }
  | AttemptVerificationReceipt { head_sha: String, window_identity_hex: String }
  | AttemptDiffWindow { head_sha: String, window_identity_hex: String }
  | AttemptVerificationSelection { head_sha: String }
  | AttemptReviewVerdict { head_sha: String, criterion_key: String }
  | AttemptReviewRequestScratch { criterion_key: String }
  | AttemptAuditVerdict { head_sha: String }
  | AttemptAuditRequestScratch
  | AttemptSupervisorRequestScratch
  | AttemptSupervisorVerdict

// THE ATTEMPT-LOG MEMBERS ARE THEIR OWN CLOSED SET (decision A, #15471 seal move): the four `*Events` streams,
// the four `*Log` stdout streams (the in-place `attempt-wire` record is a directory member reached through the
// wire lane, not an AttemptStateMember). They are NOT values of AttemptStateMember, so the generic
// single-shot attempt_state_write -- which takes AttemptStateMember -- can never be handed one: a caller that
// tries is refused by the type checker on the real acceptance path (the claim), while plain members stay
// accepted. They are reached only through gunbc.durable_append_log_store, whose owning store mints each
// member's writer window and the sandboxed worker appends under it. The census in that store is the single
// authority for the split. Where a site genuinely needs either set, wrap both in
// gunbc.durable_append_log_store.AttemptStateOrLogMember.
type AttemptLogMember
  = AttemptWorkerLog
  | AttemptWorkerEvents
  | AttemptReviewEvents { criterion_key: String, head_sha: String }
  | AttemptReviewLog { criterion_key: String }
  | AttemptAuditEvents { head_sha: String }
  | AttemptAuditLog
  | AttemptSupervisorEvents { turn: Int }
  | AttemptSupervisorLog

// The log lane's OWN directory/name/path over AttemptLogMember, mirroring the plain helpers one row each.
fn attempt_log_member_directory(member: AttemptLogMember) -> AttemptStateDirectory {
  match member {
    AttemptWorkerLog => AttemptDirectoryWorker
    AttemptWorkerEvents => AttemptDirectoryWorker
    AttemptReviewEvents { criterion_key: _, head_sha: _ } => AttemptDirectoryReview
    AttemptReviewLog { criterion_key: _ } => AttemptDirectoryReview
    AttemptAuditEvents { head_sha: _ } => AttemptDirectoryAudit
    AttemptAuditLog => AttemptDirectoryAudit
    AttemptSupervisorEvents { turn: _ } => AttemptDirectorySupervisor
    AttemptSupervisorLog => AttemptDirectorySupervisor
  }
}

fn attempt_log_member_name(member: AttemptLogMember) -> String {
  match member {
    AttemptWorkerLog => "worker-stdout.log"
    AttemptWorkerEvents => "provider-events.jsonl"
    AttemptReviewEvents { criterion_key: c, head_sha: h } => join([c, "@", h, ".provider-events.jsonl"], "")
    AttemptReviewLog { criterion_key: c } => join([c, ".reviewer-stdout.log"], "")
    AttemptAuditEvents { head_sha: h } => join([h, ".provider-events.jsonl"], "")
    AttemptAuditLog => "auditor-stdout.log"
    AttemptSupervisorEvents { turn: t } => join(["t", to_string(value: t), ".provider-events.jsonl"], "")
    AttemptSupervisorLog => "supervisor-stdout.log"
  }
}

fn attempt_log_member_path(store: AttemptState, member: AttemptLogMember) -> String {
  join([attempt_state_directory_path(store: store, directory: attempt_log_member_directory(member: member)), "/", attempt_log_member_name(member: member)], "")
}

// The directory each member lives in and the file name it carries: ONE row each, read by every operation.
fn attempt_state_member_directory(member: AttemptStateMember) -> AttemptStateDirectory {
  match member {
    AttemptWorkerRequestScratch => AttemptDirectoryWorker
    AttemptPublicationReceipt { head_sha: _ } => AttemptDirectoryPublication
    AttemptVerificationReceipt { head_sha: _, window_identity_hex: _ } => AttemptDirectoryVerification
    AttemptDiffWindow { head_sha: _, window_identity_hex: _ } => AttemptDirectoryVerification
    AttemptVerificationSelection { head_sha: _ } => AttemptDirectoryVerification
    AttemptReviewVerdict { head_sha: _, criterion_key: _ } => AttemptDirectoryReview
    AttemptReviewRequestScratch { criterion_key: _ } => AttemptDirectoryReview
    AttemptAuditVerdict { head_sha: _ } => AttemptDirectoryAudit
    AttemptAuditRequestScratch => AttemptDirectoryAudit
    AttemptSupervisorRequestScratch => AttemptDirectorySupervisor
    AttemptSupervisorVerdict => AttemptDirectorySupervisor
    AttemptKeyRecord => AttemptDirectoryRoot
    AttemptProcessFingerprint => AttemptDirectoryRoot
    AttemptContinuationTurn => AttemptDirectoryRoot
    AttemptAlignmentBinding => AttemptDirectoryRoot
    AttemptEnvironmentAdmission => AttemptDirectoryRoot
    AttemptLaunchIdentity => AttemptDirectoryRoot
    AttemptSpawnOrigin => AttemptDirectoryRoot
    AttemptVerificationRecord => AttemptDirectoryRoot
    AttemptSpawnFailure => AttemptDirectoryRoot
    AttemptRequestBindingFile => AttemptDirectoryRoot
    AttemptCommitOutcomeLast => AttemptDirectoryRoot
    AttemptOracleIdentity => AttemptDirectoryRoot
    AttemptOracleRevision => AttemptDirectoryRoot
    AttemptOraclePinRefused => AttemptDirectoryRoot
    AttemptValidationReceipt => AttemptDirectoryRoot
  }
}

fn attempt_state_member_name(member: AttemptStateMember) -> String {
  match member {
    AttemptKeyRecord => "attempt-key"
    AttemptProcessFingerprint => "process-fingerprint"
    AttemptContinuationTurn => "continuation-turn"
    AttemptAlignmentBinding => "alignment-binding.json"
    AttemptEnvironmentAdmission => "environment-admission.json"
    AttemptLaunchIdentity => "launch-identity.json"
    AttemptSpawnOrigin => dispatch_spawn_origin_basename
    AttemptVerificationRecord => "verification.json"
    AttemptSpawnFailure => "spawn-failure.txt"
    AttemptRequestBindingFile => "request-binding.json"
    AttemptCommitOutcomeLast => "commit-outcome-last.json"
    AttemptOracleIdentity => "validation-oracle-identity"
    AttemptOracleRevision => "validation-oracle-revision"
    AttemptOraclePinRefused => "validation-oracle-pin-refused"
    AttemptValidationReceipt => "validation-receipt.json"
    AttemptWorkerRequestScratch => "harness-request.json"
    AttemptPublicationReceipt { head_sha: h } => join([h, ".json"], "")
    AttemptVerificationReceipt { head_sha: h, window_identity_hex: w } => exact_verification_receipt_basename(head_sha: h, window_identity_hex: w)
    AttemptDiffWindow { head_sha: h, window_identity_hex: w } => join([h, ".", w, ".diff-window.json"], "")
    AttemptVerificationSelection { head_sha: h } => current_verification_selection_basename(head_sha: h)
    AttemptReviewVerdict { head_sha: h, criterion_key: c } => join([h, ".", c, ".json"], "")
    AttemptReviewRequestScratch { criterion_key: c } => join([c, ".harness-request.json"], "")
    AttemptAuditVerdict { head_sha: h } => join([h, ".json"], "")
    AttemptAuditRequestScratch => "harness-request.json"
    AttemptSupervisorRequestScratch => "harness-request.json"
    AttemptSupervisorVerdict => supervisor_verdict_basename as String
  }
}

// THE SEALED RECORD. Data only, non-generic, never a variant arm. `directory` is the attempt (or current
// pointer) directory this store addresses; only the mints below build it, from the instance, the node and the
// attempt key, and never from a path. A holder CAN read `directory` (field reads are not module-private: the
// declared residual gunbc.recurring_failure_mode a_slot_store_is_built_over_a_literal_path_by_any_module),
// which is what the external-consumer accessors below name for the tmux, systemd and worker argv routes.
type AttemptState sole_constructor {
  instance: NonEmptyStr
  node: String
  directory: NonEmptyStr
}

type AttemptStateReading
  = AttemptStateReady { store: AttemptState }
  | AttemptStateUnready { detail: String }

// The directory name the attempt's state lives under, the one place the `<node>-a<key>` and `<node>-current`
// shapes are written.
fn attempt_state_entry_name(node: String, attempt_key: String) -> String {
  join([node, attempt_state_slots.attempt_infix, attempt_key], "")
}

fn attempt_state_current_entry_name(node: String) -> String {
  join([node, attempt_state_slots.current_suffix], "")
}

fn attempt_state_entry_path(instance: HostDashboardInstance, entry: String) -> NonEmptyStr {
  join([dashboard_instance_dispatch_attempt_state_root(instance: instance) as String, "/", entry], "") as NonEmptyStr
}

type AttemptStateListing
  = AttemptStateListingRead { entries: String }
  | AttemptStateListingUnreadable { detail: String }

fn attempt_state_listing(path: String, what: String) -> AttemptStateListing {
  let listed = Filesystem.List(path: path)
  match filesystem_listing_observation(directory: path, success: listed.success, entries: listed.entries, error: listed.error) {
    FilesystemDirectorySubjectRefused { directory: _, cause: c } => AttemptStateListingUnreadable { detail: join([what, " is not admissible: ", c], "") }
    FilesystemDirectoryListingRefused { directory: _, error: e } => AttemptStateListingUnreadable { detail: join([what, " could not be listed: ", path, " (", e, ")"], "") }
    FilesystemDirectoryListed(l) => AttemptStateListingRead { entries: l.entries }
  }
}

// THE MINTS. Each takes the instance and the business key (node, attempt key) and never a path; the
// directory is derived from the dispatch attempt-state root declaration, and only a directory that lists
// yields a store. An attempt whose directory has not been provisioned yet (attempt_state_prepare_argvs_for_instance
// creates it) is Unready, which callers surface as their own typed refusal and never project to an empty value.
fn attempt_state_open(instance: HostDashboardInstance, node: String, attempt_key: String) -> AttemptStateReading {
  attempt_state_listed(provision: attempt_state_provision(instance: instance, node: node, attempt_key: attempt_key), what: "the attempt state directory")
}

fn attempt_state_open_current(instance: HostDashboardInstance, node: String) -> AttemptStateReading {
  attempt_state_listed(provision: attempt_state_provision_current(instance: instance, node: node), what: "the node's current attempt state directory")
}

// The listing mint derives nothing itself: it observes the directory the provision (the one derivation of
// instance + node + key -> path, below) names.
fn attempt_state_listed(provision: AttemptStateProvision, what: String) -> AttemptStateReading {
  match attempt_state_listing(path: provision.directory as String, what: what) {
    AttemptStateListingUnreadable { detail } => AttemptStateUnready { detail: detail }
    AttemptStateListingRead { entries: _ } => AttemptStateReady { store: AttemptState { instance: provision.instance, node: provision.node, directory: provision.directory } }
  }
}

fn attempt_state_directory_within(root: String, directory: AttemptStateDirectory) -> String {
  match directory {
    AttemptDirectoryRoot => root
    AttemptDirectoryWorker => join([root, "/", attempt_state_directory_segment(directory: directory)], "")
    AttemptDirectoryWire => join([root, "/", attempt_state_directory_segment(directory: directory)], "")
    AttemptDirectoryPublication => join([root, "/", attempt_state_directory_segment(directory: directory)], "")
    AttemptDirectoryVerification => join([root, "/", attempt_state_directory_segment(directory: directory)], "")
    AttemptDirectoryReview => join([root, "/", attempt_state_directory_segment(directory: directory)], "")
    AttemptDirectoryAudit => join([root, "/", attempt_state_directory_segment(directory: directory)], "")
    AttemptDirectorySupervisor => join([root, "/", attempt_state_directory_segment(directory: directory)], "")
  }
}

fn attempt_state_directory_path(store: AttemptState, directory: AttemptStateDirectory) -> String {
  attempt_state_directory_within(root: store.directory as String, directory: directory)
}

fn attempt_state_member_path(store: AttemptState, member: AttemptStateMember) -> String {
  join([attempt_state_directory_path(store: store, directory: attempt_state_member_directory(member: member)), "/", attempt_state_member_name(member: member)], "")
}

// THE STORE'S OPERATIONS: ordinary functions over the sealed record.
fn attempt_state_read(store: AttemptState, member: AttemptStateMember) -> FilesystemReadOutcome {
  let read = Filesystem.Read(path: attempt_state_member_path(store: store, member: member))
  filesystem_read_outcome(content: read.content, success: read.success, error: read.error)
}

fn attempt_state_write(store: AttemptState, member: AttemptStateMember, content: String) -> FilesystemWriteOutcome {
  let path = attempt_state_member_path(store: store, member: member)
  let write = Filesystem.Write(path: path, content: content)
  filesystem_write_outcome(path: path, success: write.success, error: write.error)
}

fn attempt_state_list(store: AttemptState, directory: AttemptStateDirectory) -> AttemptStateListing {
  attempt_state_listing(path: attempt_state_directory_path(store: store, directory: directory), what: "an attempt state directory")
}

// THE ONE-SHOT RUNTIME ROUTES: mint the listed store from the business key and apply the operation, so a
// function that touches one member does not hand-write the mint's match. An attempt directory that does not
// list is the typed refusal of the operation (a write refused, a read refused, an observation indeterminate),
// never an empty or absent value. The observation names absence only from a successful listing of the member's
// own directory (filesystem_file_observation), the carrier the belt's absence-establishing readers already use.
fn attempt_state_observe(store: AttemptState, member: AttemptStateMember) -> FilesystemFileObservation {
  let dir = attempt_state_directory_path(store: store, directory: attempt_state_member_directory(member: member))
  let path = attempt_state_member_path(store: store, member: member)
  let listing = Filesystem.List(path: dir)
  let read = Filesystem.Read(path: path)
  filesystem_file_observation(
    listing: filesystem_listing_observation(directory: dir, success: listing.success, entries: listing.entries, error: listing.error),
    name: attempt_state_member_name(member: member),
    path: path,
    read: filesystem_read_outcome(content: read.content, success: read.success, error: read.error),
  )
}

fn attempt_state_observe_at(instance: HostDashboardInstance, node: String, attempt_key: String, member: AttemptStateMember) -> FilesystemFileObservation {
  match attempt_state_open(instance: instance, node: node, attempt_key: attempt_key) {
    AttemptStateUnready { detail } => FilesystemFileIndeterminate { cause: detail }
    AttemptStateReady { store } => attempt_state_observe(store: store, member: member)
  }
}

// Whether the attempt's directory exists, observed in its parent: the census distinction between an attempt
// that was never provisioned (absent: no record) and one whose directory cannot be observed (a hole), which
// the mint's Unready conflates by design.
// Whether one of the listed attempt directory's subdirectories exists, named in the attempt's own listing:
// absence is established only by a successful listing of the attempt directory.
fn attempt_state_directory_presence(store: AttemptState, directory: AttemptStateDirectory) -> FilesystemEntryPresence {
  let listing = Filesystem.List(path: store.directory as String)
  filesystem_entry_presence(
    listing: filesystem_listing_observation(directory: store.directory as String, success: listing.success, entries: listing.entries, error: listing.error),
    name: attempt_state_directory_segment(directory: directory),
  )
}

fn attempt_state_presence_at(instance: HostDashboardInstance, node: String, attempt_key: String) -> FilesystemEntryPresence {
  filesystem_entry_presence_of_path(path: attempt_state_provision(instance: instance, node: node, attempt_key: attempt_key).directory as String)
}

fn attempt_state_presence_current(instance: HostDashboardInstance, node: String) -> FilesystemEntryPresence {
  filesystem_entry_presence_of_path(path: attempt_state_provision_current(instance: instance, node: node).directory as String)
}

fn attempt_state_observe_current(instance: HostDashboardInstance, node: String, member: AttemptStateMember) -> FilesystemFileObservation {
  match attempt_state_open_current(instance: instance, node: node) {
    AttemptStateUnready { detail } => FilesystemFileIndeterminate { cause: detail }
    AttemptStateReady { store } => attempt_state_observe(store: store, member: member)
  }
}

fn attempt_state_read_at(instance: HostDashboardInstance, node: String, attempt_key: String, member: AttemptStateMember) -> FilesystemReadOutcome {
  match attempt_state_open(instance: instance, node: node, attempt_key: attempt_key) {
    AttemptStateUnready { detail } => FilesystemReadRefused { error: detail }
    AttemptStateReady { store } => attempt_state_read(store: store, member: member)
  }
}

fn attempt_state_read_current(instance: HostDashboardInstance, node: String, member: AttemptStateMember) -> FilesystemReadOutcome {
  match attempt_state_open_current(instance: instance, node: node) {
    AttemptStateUnready { detail } => FilesystemReadRefused { error: detail }
    AttemptStateReady { store } => attempt_state_read(store: store, member: member)
  }
}

fn attempt_state_write_at(instance: HostDashboardInstance, node: String, attempt_key: String, member: AttemptStateMember, content: String) -> FilesystemWriteOutcome {
  match attempt_state_open(instance: instance, node: node, attempt_key: attempt_key) {
    AttemptStateUnready { detail } =>
      FilesystemWriteRefused { path: attempt_state_provision_path(provision: attempt_state_provision(instance: instance, node: node, attempt_key: attempt_key), member: member), error: detail }
    AttemptStateReady { store } => attempt_state_write(store: store, member: member, content: content)
  }
}

// The create-only write: fails when the member exists, so the first writer binds and a later one reads what
// is there. An attempt directory that does not list is a refused create, never a created one.
fn attempt_state_create_new_at(instance: HostDashboardInstance, node: String, attempt_key: String, member: AttemptStateMember, content: String) -> FilesystemCreateNew {
  match attempt_state_open(instance: instance, node: node, attempt_key: attempt_key) {
    AttemptStateUnready { detail } =>
      FilesystemCreateRefused { path: attempt_state_provision_path(provision: attempt_state_provision(instance: instance, node: node, attempt_key: attempt_key), member: member), kind: FilesystemNotFound, error: detail }
    AttemptStateReady { store } => {
      let write = Filesystem.WriteCreateNew(path: attempt_state_member_path(store: store, member: member), content: content)
      filesystem_create_new(path: write.path, success: write.success, error: write.error, error_kind: write.error_kind)
    }
  }
}

// THE EXTERNAL-CONSUMER ROUTE. The tmux pane cwd, the systemd ReadWritePaths and ExecStart argv, the worker's
// --arg events_path / verdict_dir, the sandbox allowlists and the shell steps that run outside this
// process's filesystem handle the attempt's paths as text. These two accessors are the only text producers;
// they take the sealed record, so a path for an attempt whose directory was never listed does not exist.
// Field reads stay unsealed (the declared residual), recorded under that specimen and not claimed as a rung.
fn attempt_state_external_path(store: AttemptState, member: AttemptStateMember) -> String {
  attempt_state_member_path(store: store, member: member)
}

fn attempt_state_external_directory(store: AttemptState, directory: AttemptStateDirectory) -> String {
  attempt_state_directory_path(store: store, directory: directory)
}

// THE PLAN-TIME RECORD. The belt plans a spawn as one pure value (the state-prepare argvs and the unit argv
// are built together, gunbc.roadmap.roadmap_dispatch_actuator), before the attempt directory exists, so a
// mint that lists the directory cannot serve it. AttemptStateProvision is the second sealed record over the
// same declaration: minted from the instance, the node and the attempt key with no path and no observation,
// it yields only the text of the directories to create and of the entries the units are confined to. It has
// no read or write operation, so provisioning cannot be mistaken for an observed store.
type AttemptStateProvision sole_constructor {
  instance: NonEmptyStr
  node: String
  directory: NonEmptyStr
}

fn attempt_state_provision(instance: HostDashboardInstance, node: String, attempt_key: String) -> AttemptStateProvision {
  AttemptStateProvision {
    instance: instance.instance_id,
    node: node,
    directory: attempt_state_entry_path(instance: instance, entry: attempt_state_entry_name(node: node, attempt_key: attempt_key)),
  }
}

fn attempt_state_provision_current(instance: HostDashboardInstance, node: String) -> AttemptStateProvision {
  AttemptStateProvision {
    instance: instance.instance_id,
    node: node,
    directory: attempt_state_entry_path(instance: instance, entry: attempt_state_current_entry_name(node: node)),
  }
}

fn attempt_state_provision_directory(provision: AttemptStateProvision, directory: AttemptStateDirectory) -> String {
  attempt_state_directory_within(root: provision.directory as String, directory: directory)
}

fn attempt_state_provision_path(provision: AttemptStateProvision, member: AttemptStateMember) -> String {
  join([attempt_state_provision_directory(provision: provision, directory: attempt_state_member_directory(member: member)), "/", attempt_state_member_name(member: member)], "")
}

// THE PLAN-TIME TEXT ROUTES, one function per addressing and no path function per file: the planner names the
// attempt by its business key and the entry by a closed member, and gets the text the unit argv, the
// state-prepare argv and the worker's --arg lines carry. Each mints the provision, the one derivation.
fn attempt_state_text(instance: HostDashboardInstance, node_id: RoadmapNodeId, attempt_key: String, member: AttemptStateMember) -> String {
  attempt_state_provision_path(provision: attempt_state_provision(instance: instance, node: node_id as String, attempt_key: attempt_key), member: member)
}

fn attempt_state_directory_text(instance: HostDashboardInstance, node_id: RoadmapNodeId, attempt_key: String, directory: AttemptStateDirectory) -> String {
  attempt_state_provision_directory(provision: attempt_state_provision(instance: instance, node: node_id as String, attempt_key: attempt_key), directory: directory)
}

fn attempt_state_current_text(instance: HostDashboardInstance, node_id: RoadmapNodeId, member: AttemptStateMember) -> String {
  attempt_state_provision_path(provision: attempt_state_provision_current(instance: instance, node: node_id as String), member: member)
}

fn attempt_state_current_directory_text(instance: HostDashboardInstance, node_id: RoadmapNodeId, directory: AttemptStateDirectory) -> String {
  attempt_state_provision_directory(provision: attempt_state_provision_current(instance: instance, node: node_id as String), directory: directory)
}

// THE VERIFICATION READERS. Both walks establish absence positively (a successful listing of the attempt
// directory names no verification directory, then the member's own listing and read), and both take the
// listed store, so they cannot be pointed at a directory the mint did not list. A refused subject is
// unreadable, never absent.
fn attempt_state_verification_selection_observe(store: AttemptState, head_sha: String) -> CurrentVerificationSelectionObservation {
  match attempt_state_directory_presence(store: store, directory: AttemptDirectoryVerification) {
    FilesystemEntrySubjectRefused { directory: d, name: n, cause: c } =>
      SelectionUnreadable { cause: join(["the verification root ", d, " is not a directory subject, so ", n, " is established by nothing the fold received: ", c], "") }
    FilesystemEntryPresenceIndeterminate { cause: c } =>
      SelectionUnreadable { cause: join(["whether a current verification selection exists was not established: ", c], "") }
    FilesystemEntryAbsent(_) => SelectionAbsent
    FilesystemEntryListed { directory: _, name: _ } =>
      match attempt_state_observe(store: store, member: AttemptVerificationSelection { head_sha: head_sha }) {
        FilesystemFileIndeterminate { cause: c } => SelectionUnreadable { cause: c }
        FilesystemFileObservationsDisagree { path: _, cause: c } => SelectionUnreadable { cause: c }
        FilesystemFileSubjectRefused { directory: d, name: n, cause: c } =>
          SelectionUnreadable { cause: join([d, " is not a directory subject, so ", n, " is established by nothing the fold received: ", c], "") }
        FilesystemFileAbsent(_) => SelectionAbsent
        FilesystemFileRead { path: p, content: text } =>
          current_verification_selection_decode_document(selection_path: p, expected_head_sha: head_sha, content: text)
      }
  }
}

fn attempt_state_verification_receipt_read(store: AttemptState, head_sha: String, window_identity_hex: String) -> ExactVerificationReceiptSource {
  match attempt_state_directory_presence(store: store, directory: AttemptDirectoryVerification) {
    FilesystemEntrySubjectRefused { directory: d, name: n, cause: c } =>
      ExactVerificationReceiptUnreadable { detail: join(["the verification root ", d, " is not a directory subject, so ", n, " is established by nothing the fold received: ", c], "") }
    FilesystemEntryPresenceIndeterminate { cause: c } =>
      ExactVerificationReceiptUnreadable { detail: join(["whether a verification receipt exists was not established: ", c], "") }
    FilesystemEntryAbsent(_) => ExactVerificationReceiptAbsent
    FilesystemEntryListed { directory: _, name: _ } =>
      match attempt_state_observe(store: store, member: AttemptVerificationReceipt { head_sha: head_sha, window_identity_hex: window_identity_hex }) {
        FilesystemFileIndeterminate { cause: c } => ExactVerificationReceiptUnreadable { detail: c }
        FilesystemFileObservationsDisagree { path: _, cause: c } => ExactVerificationReceiptUnreadable { detail: c }
        FilesystemFileSubjectRefused { directory: d, name: n, cause: c } =>
          ExactVerificationReceiptUnreadable { detail: join([d, " is not a directory subject, so ", n, " is established by nothing the fold received: ", c], "") }
        FilesystemFileAbsent(_) => ExactVerificationReceiptAbsent
        FilesystemFileRead { path: _, content: text } => ExactVerificationReceiptPresent { text: text }
      }
  }
}

fn attempt_state_verification_selection_observe_at(instance: HostDashboardInstance, node: String, attempt_key: String, head_sha: String) -> CurrentVerificationSelectionObservation {
  match attempt_state_open(instance: instance, node: node, attempt_key: attempt_key) {
    AttemptStateUnready { detail } => SelectionUnreadable { cause: detail }
    AttemptStateReady { store } => attempt_state_verification_selection_observe(store: store, head_sha: head_sha)
  }
}

fn attempt_state_verification_receipt_read_at(instance: HostDashboardInstance, node: String, attempt_key: String, head_sha: String, window_identity_hex: String) -> ExactVerificationReceiptSource {
  match attempt_state_open(instance: instance, node: node, attempt_key: attempt_key) {
    AttemptStateUnready { detail } => ExactVerificationReceiptUnreadable { detail: detail }
    AttemptStateReady { store } => attempt_state_verification_receipt_read(store: store, head_sha: head_sha, window_identity_hex: window_identity_hex)
  }
}

// THE APPEND-LOG SEAL (decision B; amends #15471 about where the seal sits). The generic durable layer
// (gunbc.durable_append_log_store) is data-only -- the unsealed carrier + contract types + pure operations.
// The SEAL (AttemptAppendLogStore sole_constructor) and its ONE business-key mint live HERE, in the module that
// DECLARES the members, mirroring roadmap_attempt_worktree_claim_root. The mint takes the business key
// (instance, node, attempt key) and the member -- NEVER a path -- and uses only the path derived from the sealed
// attempt-state record, whose directory it reads once for the real listing the mint must be bound to. No
// exported fn here takes a path or a NonEmptyStr and returns a sealed store: the only inputs are the sealed
// HostDashboardInstance and the business keys. Land order (with #15413): until #15413 lands and its cutover runs
// on a host, that host's shared attempt-state root still holds the flat entries #15413 relocates; a member whose
// real read finds a foreign/un-moved entry is refused with the typed AppendLogLegacyRefused, never treated as
// absent and never dual-read.
type AttemptAppendLogStore sole_constructor {
  instance: NonEmptyStr
  node: String
  attempt_key: String
  member_name: NonEmptyStr
  directory: NonEmptyStr
  slot: AppendLogSlot
}

type AttemptAppendLogReading
  = AttemptAppendLogReady { store: AttemptAppendLogStore }
  | AttemptAppendLogUnready { detail: String }
  | AttemptAppendLogLegacyRefused { cause: AppendLogLegacyCause }

// The census log members that are AttemptStateMember values. AttemptDirectoryWire is an in-place record in the
// wire directory written by the worker lane (roadmap_attempt_directory_wire), NOT an AttemptStateMember, so it is
// minted through that lane's own directory read, not here; every other census member is not a log member.
fn attempt_append_log_member_name(member: AttemptLogMember) -> String {
  match member {
    AttemptWorkerEvents => "AttemptWorkerEvents"
    AttemptWorkerLog => "AttemptWorkerLog"
    AttemptReviewEvents { criterion_key: _, head_sha: _ } => "AttemptReviewEvents"
    AttemptReviewLog { criterion_key: _ } => "AttemptReviewLog"
    AttemptAuditEvents { head_sha: _ } => "AttemptAuditEvents"
    AttemptAuditLog => "AttemptAuditLog"
    AttemptSupervisorEvents { turn: _ } => "AttemptSupervisorEvents"
    AttemptSupervisorLog => "AttemptSupervisorLog"
    _ => ""
  }
}

fn attempt_append_log_census_row(name: String) -> MemberCensusRow? {
  match append_log_member_census {
    Empty {} => Absent
    Cons { head: r, tail: rest } => match r.disposition {
      MigrateToLogStore { framing: _, principal: _ } => if r.member == (name as NonEmptyStr) { Present { value: r } } else { attempt_append_log_census_row(name: name) }
      _ => attempt_append_log_census_row(name: name)
    }
  }
}

// THE ONE SEAL MINT. Business key only; the path is derived from the sealed attempt-state record and read once.
fn attempt_append_log_store_open(instance: HostDashboardInstance, node: String, attempt_key: String, member: AttemptLogMember) -> AttemptAppendLogReading {
  let name = attempt_append_log_member_name(member: member)
  if name == "" {
    AttemptAppendLogUnready { detail: "not an append-log member" }
  } else {
    match attempt_state_open(instance: instance, node: node, attempt_key: attempt_key) {
      AttemptStateUnready { detail } => AttemptAppendLogUnready { detail: detail }
      AttemptStateReady { store } => {
        let member_dir = attempt_state_directory_path(store: store, directory: attempt_log_member_directory(member: member))
        let listed = Filesystem.List(path: member_dir)
        match filesystem_listing_observation(directory: member_dir, success: listed.success, entries: listed.entries, error: listed.error) {
          FilesystemDirectorySubjectRefused { directory: _, cause: _ } => AttemptAppendLogUnready { detail: "the member directory subject was refused; the listing is never treated as empty" }
          FilesystemDirectoryListingRefused { directory: _, error: e } => AttemptAppendLogUnready { detail: join(["the member directory could not be listed; a member is never treated as absent from a failed read -- ", e], "") }
          FilesystemDirectoryListed(lic) => match attempt_append_log_census_row(name: name) {
            Absent => AttemptAppendLogUnready { detail: join(["no census row for ", name], "") }
            Present { value: row } => match append_log_census_slot(row: row) {
              Absent => AttemptAppendLogUnready { detail: join(["census row is not a log row: ", name], "") }
              Present { value: slot } => {
                let names = filesystem_listing_entry_names(listing: lic)
                match append_log_store_mint(parent: AppendLogParent { directory: member_dir as NonEmptyStr }, slot: slot, listing: Present { value: names }) {
                  AppendLogReady { store: s } => AttemptAppendLogReady { store: AttemptAppendLogStore { instance: store.instance, node: node, attempt_key: attempt_key, member_name: name as NonEmptyStr, directory: s.parent, slot: slot } }
                  AppendLogUnready { detail } => AttemptAppendLogUnready { detail: detail }
                  AppendLogLegacyRefused { cause } => AttemptAppendLogLegacyRefused { cause: cause }
                }
              }
            }
          }
        }
      }
    }
  }
}

// THE HOST-SIDE CREATE, through the SEALED store, for the HostCreatesThenSandboxWrites window. The host's only
// write under that window is this create, admitted only while the member does not exist; the window then passes
// to the sandbox by the member's existence (contract: std.durable_append_log append_write_admission, standing
// WriterWindowReleased -- NO hold to acquire or release). The dedicated-account branch keeps the old
// group-writable mode at creation; the service-user branch was historically an overwrite-capable Write, but the
// store op is CREATE-NEW on BOTH branches so an existing member is a typed outcome (AlreadyExists), never an
// overwrite. Business key only; the path is derived from the sealed attempt-state record, never supplied.
// The dedicated-account events member is group-writable AT CREATION (owner rw, group rw, other none), never
// widened afterwards -- the same FileMode value dispatch_attempt_events_initialize_for_instance created it with
// (declared there as dispatch_attempt_events_group_writable_mode). Declared here as a local copy because the
// seal module must not import the dispatch actuator (it would cycle: the actuator already imports this module).
// PR body notes the single-source intent.
data attempt_append_log_events_group_writable_mode: FileMode = FileMode {
  owner: PermissionBits { read: true, write: true, execute: false },
  group: PermissionBits { read: true, write: true, execute: false },
  other: PermissionBits { read: false, write: false, execute: false },
  setuid: false, setgid: false, sticky: false,
}

type AttemptAppendLogHostCreate
  = AttemptAppendLogCreated { path: String, created_mode: FileMode? }
  | AttemptAppendLogAlreadyExists { path: String }
  | AttemptAppendLogCreateRefused { detail: String }
  | AttemptAppendLogHostUnready { detail: String }
  | AttemptAppendLogHostLegacyRefused { cause: AppendLogLegacyCause }

fn attempt_append_log_refusal_detail(refusal: AppendWriteRefusal) -> String {
  match refusal {
    WriterNotAuthorizedByPolicy => "the host is not the authorized writer for this member"
    WriterWindowHeldByAnother { holder: _ } => "the writer window is held by another principal"
    WriterWindowNotOpen => "the writer window is not open"
    HostWriteDuringSandboxWindow { holder: _ } => "a host write was attempted during the sandbox window"
    WriterStandingUnknown { cause: c } => join(["the writer standing is unobserved: ", c], "")
    CreateOverExistingMember => "the member already exists; create-new will not overwrite it"
  }
}

fn attempt_append_log_host_create(instance: HostDashboardInstance, node: String, attempt_key: String, member: AttemptLogMember) -> AttemptAppendLogHostCreate {
  match attempt_append_log_store_open(instance: instance, node: node, attempt_key: attempt_key, member: member) {
    AttemptAppendLogUnready { detail } => AttemptAppendLogHostUnready { detail: detail }
    AttemptAppendLogLegacyRefused { cause } => AttemptAppendLogHostLegacyRefused { cause: cause }
    AttemptAppendLogReady { store: sealed } => match attempt_state_open(instance: instance, node: node, attempt_key: attempt_key) {
      AttemptStateUnready { detail } => AttemptAppendLogHostUnready { detail: detail }
      AttemptStateReady { store: as_store } => {
        let member_path = attempt_log_member_path(store: as_store, member: member)
        let exists_read = Filesystem.Read(path: member_path)
        let member_exists = exists_read.success
        match append_write_admission(policy: sealed.slot.writers, writer: HostWriter, intent: IntentCreateEmpty, standing: WriterWindowReleased, member_exists: member_exists) {
          AppendWriteAdmitted => match instance.worker {
            WorkerDedicatedAccount => {
              let created = Filesystem.WriteCreateNewWithMode(path: member_path, content: "", mode: file_mode_bits(mode: attempt_append_log_events_group_writable_mode))
              if created.success { AttemptAppendLogCreated { path: member_path, created_mode: Present { value: attempt_append_log_events_group_writable_mode } } } else { AttemptAppendLogCreateRefused { detail: created.error } }
            }
            WorkerIsServiceUser => {
              let created = Filesystem.WriteCreateNew(path: member_path, content: "")
              if created.success { AttemptAppendLogCreated { path: member_path, created_mode: Absent } } else { AttemptAppendLogCreateRefused { detail: created.error } }
            }
          }
          AppendWriteRefused { refusal: r } => match r {
            CreateOverExistingMember => AttemptAppendLogAlreadyExists { path: member_path }
            _ => AttemptAppendLogCreateRefused { detail: attempt_append_log_refusal_detail(refusal: r) }
          }
        }
      }
    }
  }
}
