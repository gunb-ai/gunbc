module gunbc.roadmap.roadmap_review_role

import std.types { String, Int, List, Bool, NonEmptyStr }
import extdeps.languages.json.parse {
  parse_json_document, JsonDocumentParsed, JsonDocumentUnreadable, json_document_gap_text,
  json_object_unique_member, JsonMemberFound, JsonMemberAbsent, JsonMemberDuplicated, JsonMemberNotAnObject,
}
import extdeps.languages.json.emit { JsonValue, JsonString, JsonArray, JsonObject }
import gunbc.roadmap_workflow_stage {
  WorkflowSegmentState, WorkflowSegmentComplete, WorkflowSegmentFailed, WorkflowSegmentRefused,
  WorkflowSegmentPending, WorkflowSegmentActive,
}
import gunbc.worker_lifecycle {
  WorkerProcessEvidence, WorkerProcessRunning, WorkerProcessExited, WorkerProcessAbsent, WorkerProcessUnobserved,
}
import gunbc.roadmap.roadmap_review_criteria { ReviewCriterion, review_criterion_brief_text }

// THE REVIEW VERDICT, AS THE REVIEWER WRITES IT AND THE BELT READS IT. Three words because three
// remedies: approved admits publication; changes requested carries located reasons and feeds the next
// turn of the same lineage; cannot-judge is the reviewer's refusal -- a fact it needed and could not
// establish -- which is an environment problem, never a verdict on the work, and must not be read as
// either of the other two.
type ReviewReason {
  path: String
  reason: String
}

type HeadVerdict
  = ReviewApproved { summary: String }
  | ReviewChangesRequested { reasons: List<ReviewReason> }
  | ReviewCannotJudge { reason: String }

type ReviewVerdictDecode
  = ReviewVerdictDecoded { verdict: HeadVerdict }
  | ReviewVerdictUndecodable { reason: String }

// THE VERDICT FILE AS OBSERVED, before decoding. Absent and unreadable are different facts with
// different remedies (spawn a reviewer; fix the read), so the belt carries both and the segment
// names each.
type ReviewReceiptSource
  = ReviewReceiptAbsent
  | ReviewReceiptPresent { text: String }
  | ReviewReceiptUnreadable { detail: String }

data review_verdict_schema: String = "roadmap-review-verdict/v1"

// The grammar the reviewer is told and the decoder enforces, one authority for both.
fn review_verdict_shape_text() -> String {
  join([
    "{\"schema\": \"", review_verdict_schema, "\", \"verdict\": \"approve\" | \"request_changes\" | \"cannot_judge\", ",
    "\"summary\": \"<one sentence, required for approve>\", ",
    "\"reasons\": [{\"path\": \"<file>\", \"reason\": \"<what is wrong or missing>\"}] (required and non-empty for request_changes), ",
    "\"reason\": \"<which fact could not be established>\" (required for cannot_judge)}",
  ], "")
}

fn review_member_string(doc: JsonValue, key: String) -> String? {
  match json_object_unique_member(v: doc, key: key) {
    JsonMemberFound { value: JsonString { value: s } } => Present { value: s }
    _ => none
  }
}

fn review_reason_of(v: JsonValue) -> ReviewReason? {
  match review_member_string(doc: v, key: "path") {
    Absent => none
    Present { value: p } =>
      match review_member_string(doc: v, key: "reason") {
        Absent => none
        Present { value: r } => Present { value: ReviewReason { path: p, reason: r } }
      }
  }
}

fn review_reasons_of(doc: JsonValue) -> List<ReviewReason>? {
  match json_object_unique_member(v: doc, key: "reasons") {
    JsonMemberFound { value: JsonArray { elements } } => {
      let parsed = map(elements, e => review_reason_of(v: e))
      if any(parsed, r => match r { Absent => true  Present { value: _ } => false }) {
        none
      } else {
        Present { value: fold(parsed, init: [], f: (acc, r) => match r { Present { value: x } => concat(acc, [x])  Absent => acc }) }
      }
    }
    _ => none
  }
}

fn review_verdict_decode(text: String) -> ReviewVerdictDecode {
  match parse_json_document(s: text) {
    JsonDocumentUnreadable { gap } => ReviewVerdictUndecodable { reason: join(["verdict file is not JSON: ", json_document_gap_text(gap: gap)], "") }
    JsonDocumentParsed { value: doc } =>
      match review_member_string(doc: doc, key: "schema") {
        Absent => ReviewVerdictUndecodable { reason: "verdict file has no schema member" }
        Present { value: s } =>
          if s != review_verdict_schema {
            ReviewVerdictUndecodable { reason: join(["verdict schema is ", s, ", expected ", review_verdict_schema], "") }
          } else {
            match review_member_string(doc: doc, key: "verdict") {
              Absent => ReviewVerdictUndecodable { reason: "verdict file has no verdict member" }
              Present { value: w } => review_verdict_of_word(doc: doc, word: w)
            }
          }
      }
  }
}

fn review_verdict_of_word(doc: JsonValue, word: String) -> ReviewVerdictDecode {
  if word == "approve" {
    match review_member_string(doc: doc, key: "summary") {
      Present { value: s } => ReviewVerdictDecoded { verdict: ReviewApproved { summary: s } }
      Absent => ReviewVerdictUndecodable { reason: "approve without a summary" }
    }
  } else if word == "request_changes" {
    match review_reasons_of(doc: doc) {
      Present { value: rs } =>
        if count(rs) == 0 { ReviewVerdictUndecodable { reason: "request_changes with no reasons" } }
        else { ReviewVerdictDecoded { verdict: ReviewChangesRequested { reasons: rs } } }
      Absent => ReviewVerdictUndecodable { reason: "request_changes without a well-formed reasons array" }
    }
  } else if word == "cannot_judge" {
    match review_member_string(doc: doc, key: "reason") {
      Present { value: r } => ReviewVerdictDecoded { verdict: ReviewCannotJudge { reason: r } }
      Absent => ReviewVerdictUndecodable { reason: "cannot_judge without a reason" }
    }
  } else {
    ReviewVerdictUndecodable { reason: join(["unknown verdict word ", word], "") }
  }
}

fn review_verdict_key(v: HeadVerdict) -> String {
  match v {
    ReviewApproved { summary: _ } => "approved"
    ReviewChangesRequested { reasons: _ } => "changes_requested"
    ReviewCannotJudge { reason: _ } => "cannot_judge"
  }
}

fn review_reason_text(r: ReviewReason) -> String {
  join([r.path, ": ", r.reason], "")
}

fn review_verdict_detail(v: HeadVerdict) -> String {
  match v {
    ReviewApproved { summary } => summary
    ReviewChangesRequested { reasons } => join(map(reasons, r => review_reason_text(r: r)), "; ")
    ReviewCannotJudge { reason } => reason
  }
}


// ONE CRITERION'S EVIDENCE: its verdict file as observed, and its reviewer's process. The belt reads
// both per criterion; the reconciliation below folds the roster into one segment.
type CriterionReviewEvidence {
  criterion_key: String
  source: ReviewReceiptSource
  process: WorkerProcessEvidence
}

// THE RECONCILIATION IS A FOLD WITH A DOMINANCE ORDER, NOT A VOTE. Reviews of different criteria are
// expected to disagree -- the goal reviewer approves while the fail-closed reviewer requests changes
// -- and that is not a conflict to resolve but the reason they were separated: each answer keeps its
// criterion's name. The aggregate rule: any changes-requested fails the segment and carries every
// requesting criterion's reasons; else any cannot-judge, undecodable or unreadable verdict refuses it
// (a criterion nobody could judge is not an approval); else any criterion still without a verdict
// leaves it active if its reviewer runs and pending if not; only all-approved completes.
type CriterionStanding
  = CriterionApproved { key: String, summary: String }
  | CriterionChangesRequested { key: String, reasons: List<ReviewReason> }
  | CriterionCannotJudge { key: String, reason: String }
  | CriterionUndecodable { key: String, reason: String }
  | CriterionUnreadable { key: String, detail: String }
  | CriterionReviewerRunning { key: String }
  | CriterionReviewerExitedWithoutVerdict { key: String, exit_code: Int }
  | CriterionReviewerUnobserved { key: String, reason: String }
  | CriterionAwaitingReviewer { key: String }

fn criterion_standing(e: CriterionReviewEvidence) -> CriterionStanding {
  match e.source {
    ReviewReceiptPresent { text } =>
      match review_verdict_decode(text: text) {
        ReviewVerdictDecoded { verdict: ReviewApproved { summary } } => CriterionApproved { key: e.criterion_key, summary: summary }
        ReviewVerdictDecoded { verdict: ReviewChangesRequested { reasons } } => CriterionChangesRequested { key: e.criterion_key, reasons: reasons }
        ReviewVerdictDecoded { verdict: ReviewCannotJudge { reason } } => CriterionCannotJudge { key: e.criterion_key, reason: reason }
        ReviewVerdictUndecodable { reason } => CriterionUndecodable { key: e.criterion_key, reason: reason }
      }
    ReviewReceiptUnreadable { detail } => CriterionUnreadable { key: e.criterion_key, detail: detail }
    ReviewReceiptAbsent =>
      match e.process {
        WorkerProcessRunning { command: _ } => CriterionReviewerRunning { key: e.criterion_key }
        WorkerProcessExited { exit_code, last_command: _ } => CriterionReviewerExitedWithoutVerdict { key: e.criterion_key, exit_code: exit_code }
        WorkerProcessUnobserved { reason } => CriterionReviewerUnobserved { key: e.criterion_key, reason: reason as String }
        WorkerProcessAbsent => CriterionAwaitingReviewer { key: e.criterion_key }
      }
  }
}

fn criterion_standing_text(s: CriterionStanding) -> String {
  match s {
    CriterionApproved { key, summary } => join([key, ": approved — ", summary], "")
    CriterionChangesRequested { key, reasons } => join([key, ": changes requested — ", join(map(reasons, r => review_reason_text(r: r)), "; ")], "")
    CriterionCannotJudge { key, reason } => join([key, ": cannot judge — ", reason], "")
    CriterionUndecodable { key, reason } => join([key, ": verdict undecodable — ", reason], "")
    CriterionUnreadable { key, detail } => join([key, ": verdict unreadable — ", detail], "")
    CriterionReviewerRunning { key } => join([key, ": reviewer running"], "")
    CriterionReviewerExitedWithoutVerdict { key, exit_code } => join([key, ": reviewer exited ", to_string(value: exit_code), " without a verdict"], "")
    CriterionReviewerUnobserved { key, reason } => join([key, ": reviewer unobserved — ", reason], "")
    CriterionAwaitingReviewer { key } => join([key, ": awaiting reviewer"], "")
  }
}

fn standing_is_changes(s: CriterionStanding) -> Bool { match s { CriterionChangesRequested { key: _, reasons: _ } => true  _ => false } }
fn standing_is_approved(s: CriterionStanding) -> Bool { match s { CriterionApproved { key: _, summary: _ } => true  _ => false } }
fn standing_is_running(s: CriterionStanding) -> Bool { match s { CriterionReviewerRunning { key: _ } => true  _ => false } }
fn standing_blocks(s: CriterionStanding) -> Bool {
  match s {
    CriterionCannotJudge { key: _, reason: _ } => true
    CriterionUndecodable { key: _, reason: _ } => true
    CriterionUnreadable { key: _, detail: _ } => true
    CriterionReviewerExitedWithoutVerdict { key: _, exit_code: _ } => true
    CriterionReviewerUnobserved { key: _, reason: _ } => true
    _ => false
  }
}

type ReviewReconciliation {
  state: WorkflowSegmentState
  detail: String
}

// THE WORKER'S FEEDBACK IS THE SAME EVIDENCE RECOMPOSED FOR THE PERSON WHO HAS TO ACT ON IT. The belt
// reads verdicts per criterion; a worker fixes files, so the findings are grouped by PATH, in the
// criteria's own order within a path, with identical (criterion, path, reason) rows folded once. Two
// criteria naming the same path is the recomposition's residual -- the split was not perfectly
// exclusive there -- and it is counted rather than hidden. Criteria that could not judge are listed
// so the worker knows what was NOT reviewed; approved criteria are listed by key only.
type CriterionFinding {
  criterion: String
  reason: String
}

type FeedbackAtPath {
  path: String
  findings: List<CriterionFinding>
}

type WorkerFeedback {
  must_fix: List<FeedbackAtPath>
  could_not_judge: List<String>
  approved: List<String>
  incomplete: List<String>
  overlap_count: Int
}

fn feedback_add(acc: List<FeedbackAtPath>, criterion: String, r: ReviewReason) -> List<FeedbackAtPath> {
  if any(acc, g => g.path == r.path) {
    map(acc, g =>
      if g.path == r.path {
        if any(g.findings, f => f.criterion == criterion && f.reason == r.reason) {
          g
        } else {
          FeedbackAtPath { path: g.path, findings: concat(g.findings, [CriterionFinding { criterion: criterion, reason: r.reason }]) }
        }
      } else {
        g
      })
  } else {
    concat(acc, [FeedbackAtPath { path: r.path, findings: [CriterionFinding { criterion: criterion, reason: r.reason }] }])
  }
}

fn feedback_path_criteria_count(g: FeedbackAtPath) -> Int {
  count(fold(g.findings, init: [], f: (acc, f) => if any(acc, k => k == f.criterion) { acc } else { concat(acc, [f.criterion]) }))
}

fn review_feedback(evidence: List<CriterionReviewEvidence>) -> WorkerFeedback {
  review_feedback_standings(standings: map(evidence, e => criterion_standing(e: e)))
}

// STREAMING, WITH THE INCOMPLETE SET STATED: feedback is emitted as soon as any criterion requests
// changes, and it carries the calls that have not reached a terminal observation, so a worker cannot
// mistake an early report for the complete one (review 5125854144: the first cut dropped running and
// awaiting calls from the smoothed message).
fn review_feedback_standings(standings: List<CriterionStanding>) -> WorkerFeedback {
  let must_fix = fold(standings, init: [], f: (acc, s) => match s {
    CriterionChangesRequested { key, reasons } => fold(reasons, init: acc, f: (acc2, r) => feedback_add(acc: acc2, criterion: key, r: r))
    _ => acc
  })
  WorkerFeedback {
    must_fix: must_fix,
    could_not_judge: flat_map(standings, s => match s {
      CriterionCannotJudge { key, reason } => [join([key, ": ", reason], "")]
      CriterionUndecodable { key, reason } => [join([key, ": verdict undecodable: ", reason], "")]
      CriterionUnreadable { key, detail } => [join([key, ": verdict unreadable: ", detail], "")]
      CriterionReviewerExitedWithoutVerdict { key, exit_code } => [join([key, ": reviewer exited ", to_string(value: exit_code), " without a verdict"], "")]
      CriterionReviewerUnobserved { key, reason } => [join([key, ": reviewer unobserved: ", reason], "")]
      _ => []
    }),
    approved: flat_map(standings, s => match s { CriterionApproved { key, summary: _ } => [key]  _ => [] }),
    incomplete: flat_map(standings, s => match s {
      CriterionReviewerRunning { key } => [key]
      CriterionAwaitingReviewer { key } => [key]
      _ => []
    }),
    overlap_count: count(filter(must_fix, g => feedback_path_criteria_count(g: g) > 1)),
  }
}

fn feedback_at_path_text(g: FeedbackAtPath) -> String {
  join([
    g.path, " — ",
    join(map(g.findings, f => join([f.criterion, ": changes requested — ", f.reason], "")), "; "),
  ], "")
}

fn review_feedback_text(f: WorkerFeedback) -> String {
  join(concat(
    concat(
      if count(f.must_fix) == 0 { [] } else { [join(["Fix, by file: ", join(map(f.must_fix, g => feedback_at_path_text(g: g)), " · ")], "")] },
      if f.overlap_count == 0 { [] } else { [join([to_string(value: f.overlap_count), " file(s) were named by more than one criterion; fix the file once, then re-read every reason on it."], "")] },
    ),
    concat(
      if count(f.could_not_judge) == 0 { [] } else { [join(["Not reviewed (fix before claiming done): ", join(f.could_not_judge, " · ")], "")] },
      if count(f.incomplete) == 0 { [] } else { [join(["Still reviewing (", to_string(value: count(f.incomplete)), ", this report is not complete): ", join(f.incomplete, ", ")], "")] },
    ),
  ), "\n")
}

fn review_reconcile(evidence: List<CriterionReviewEvidence>) -> ReviewReconciliation {
  review_reconcile_standings(standings: map(evidence, e => criterion_standing(e: e)))
}

// THE FOLD OVER STANDINGS. The denominator is whatever standings the caller hands in; the plan-bound
// join in gunbc.roadmap.roadmap_review_function is what makes that denominator exactly the plan's calls
// (missing calls arrive here as CriterionAwaitingReviewer, never dropped), so production reaches this
// fold only through that join. The evidence form above is kept for the goal audit's roster of one.
fn review_reconcile_standings(standings: List<CriterionStanding>) -> ReviewReconciliation {
  let text = join(map(standings, s => criterion_standing_text(s: s)), " · ")
  if count(standings) == 0 {
    ReviewReconciliation { state: WorkflowSegmentRefused, detail: "no review criteria are declared, so nothing can approve this head" }
  } else if any(standings, s => standing_is_changes(s: s)) {
    ReviewReconciliation { state: WorkflowSegmentFailed, detail: review_feedback_text(f: review_feedback_standings(standings: standings)) }
  } else if any(standings, s => standing_blocks(s: s)) {
    ReviewReconciliation { state: WorkflowSegmentRefused, detail: join(map(filter(standings, s => standing_blocks(s: s)), s => criterion_standing_text(s: s)), " · ") }
  } else if all(standings, s => standing_is_approved(s: s)) {
    ReviewReconciliation { state: WorkflowSegmentComplete, detail: text }
  } else if any(standings, s => standing_is_running(s: s)) {
    ReviewReconciliation { state: WorkflowSegmentActive, detail: text }
  } else {
    ReviewReconciliation { state: WorkflowSegmentPending, detail: text }
  }
}

fn review_all_approved(evidence: List<CriterionReviewEvidence>) -> Bool {
  count(evidence) > 0 && all(map(evidence, e => criterion_standing(e: e)), s => standing_is_approved(s: s))
}

// THE BRIEF CARRIES THE PER-CANDIDATE FACTS; THE ROLE'S STANDING FACTS ARE THE SYSTEM PROMPT
// (gunbc.harness.harness_review_guidance). Goal, boundary and non-goals come from the node; the
// acceptance command from its execution contract; base and head from the belt's diff window; the
// verification detail from the belt's receipt for this head; the verdict path from the attempt state.
fn review_brief(
  criterion: ReviewCriterion,
  node_id: String,
  headline: String,
  boundary: String,
  out_of_scope: String,
  red_control: String,
  acceptance_command: String,
  base_sha: String,
  head_sha: String,
  verification_detail: String,
) -> String {
  join([
    "Review of node ", node_id, ", on one criterion.\n",
    review_criterion_brief_text(c: criterion),
    "Goal: ", headline, "\n",
    "Boundary: ", boundary, "\n",
    "Out of scope: ", out_of_scope, "\n",
    "What should go red if the change is wrong: ", red_control, "\n",
    "Acceptance command: ", acceptance_command, "\n",
    "Change under review: git diff ", base_sha, "..", head_sha, " (the worktree is at ", head_sha, ")\n",
    "What the belt's own run of the acceptance command said about this head: ", verification_detail, "\n",
    "Answer the criterion and only the criterion: approve means the answer to its question is no; request_changes means yes, with each reason naming the path and the tell.\n",
  ], "")
}

// WHERE TO WRITE THE VERDICT IS THE ACTUATION'S FACT, appended by the realization that mints the path,
// so the semantic call (gunbc.roadmap.roadmap_review_function ReviewCall) carries no path.
fn review_verdict_instruction(verdict_path: String) -> String {
  join(["Write your verdict to ", verdict_path, " in the shape given in your instructions.\n"], "")
}
