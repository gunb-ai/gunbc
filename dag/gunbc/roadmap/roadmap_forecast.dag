type CycleTimeProvenance
  = AcceptedRoadmapNodePullHistory
  | DashboardWorkItemDispatchPullHistory

// AcceptedRoadmapNodePullHistory measures PR open -> merge for nodes whose roadmap acceptance
// receipt is valid. DashboardWorkItemDispatchPullHistory is reserved as a distinct future
// provenance arm because dispatch -> merge measures a different interval; this slice constructs no
// value in that arm and calibration admits only accepted-roadmap observations. The two populations
// therefore cannot blend silently.

type CycleTimeObservation {
  node: RoadmapNodeId
  sizing_cell: NodeSizing
  pull_number: Int
  cycle_time: Millisecond
  accepted_on: NonEmptyStr
  source_url: NonEmptyStr
  provenance: CycleTimeProvenance
}

type CycleTimeHistoryRefusal
  = HistoryNodeMissing { node: RoadmapNodeId }
  | HistoryNodeDuplicate { node: RoadmapNodeId }
  | HistoryAcceptanceMissing { node: RoadmapNodeId }
  | HistoryAcceptanceDuplicate { node: RoadmapNodeId }
  | HistoryNodeUnsized { node: RoadmapNodeId }
  | HistoryPullMissing { node: RoadmapNodeId, pull_number: Int }
  | HistoryPullDuplicate { node: RoadmapNodeId, pull_number: Int }
  | HistoryPullNotMergedAfterOpen { node: RoadmapNodeId, pull_number: Int }
  | HistoryAcceptanceCarrierLoadRefused { detail: String }
  | HistorySizingAssignmentRefused { refusals: List<SizingAssignmentRefusal> }

type CycleTimePopulationExclusion
  = BundledPullDelivery { pull_number: Int, nodes: List<RoadmapNodeId> }

type CycleTimeObservationBuild
  = CycleTimeObserved { observation: CycleTimeObservation }
  | CycleTimePopulationExcluded { exclusion: CycleTimePopulationExclusion }
  | CycleTimeHistoryRefused { refusal: CycleTimeHistoryRefusal }

fn observation_for_link(
  link: AcceptedNodePullLink,
  nodes: List<RoadmapNode>,
  sizings: List<NodeSizingAssignment>,
  receipts: List<RoadmapAcceptanceReceipt>,
  pulls: List<PullTimingObservation>,
  links: List<AcceptedNodePullLink>,
) -> CycleTimeObservationBuild {
  let bundled_links = links |> filter(candidate => candidate.pull_number == link.pull_number)
  let matching_nodes = nodes |> filter(n => n.node == link.node)
  if count(matching_nodes) == 0 {
    return CycleTimeHistoryRefused { refusal: HistoryNodeMissing { node: link.node } }
  }
  if count(matching_nodes) != 1 {
    return CycleTimeHistoryRefused { refusal: HistoryNodeDuplicate { node: link.node } }
  }
  let node = first(matching_nodes)
  let matching_receipts = receipts |> filter(r => r.node == link.node)
  if count(matching_receipts) == 0 {
    return CycleTimeHistoryRefused { refusal: HistoryAcceptanceMissing { node: link.node } }
  }
  if count(matching_receipts) != 1 {
    return CycleTimeHistoryRefused { refusal: HistoryAcceptanceDuplicate { node: link.node } }
  }
  if !node_accepted(receipts: receipts, rn: node) {
    return CycleTimeHistoryRefused { refusal: HistoryAcceptanceMissing { node: link.node } }
  }
  let cell = match assigned_sizing(sizings: sizings, subject: node_sizing_subject_id(rn: node)) {
    Absent => return CycleTimeHistoryRefused { refusal: HistoryNodeUnsized { node: link.node } }
    Present { value } => value
  }
  let matching_pulls = pulls |> filter(p => p.pull_number == link.pull_number)
  if count(matching_pulls) == 0 {
    return CycleTimeHistoryRefused {
      refusal: HistoryPullMissing { node: link.node, pull_number: link.pull_number }
    }
  }
  if count(matching_pulls) != 1 {
    return CycleTimeHistoryRefused {
      refusal: HistoryPullDuplicate { node: link.node, pull_number: link.pull_number }
    }
  }
  let pull = first(matching_pulls)
  if pull.merged_at <= pull.opened_at {
    return CycleTimeHistoryRefused {
      refusal: HistoryPullNotMergedAfterOpen { node: link.node, pull_number: link.pull_number }
    }
  }
  if count(bundled_links) > 1 {
    return CycleTimePopulationExcluded { exclusion: BundledPullDelivery {
      pull_number: link.pull_number,
      nodes: bundled_links |> map(candidate => candidate.node),
    } }
  }
  let receipt = first(matching_receipts)
  CycleTimeObserved {
    observation: CycleTimeObservation {
      node: link.node,
      sizing_cell: cell,
      pull_number: pull.pull_number,
      cycle_time: millisecond(count: pull.merged_at - pull.opened_at),
      accepted_on: receipt.accepted_on,
      source_url: pull.source_url,
      provenance: AcceptedRoadmapNodePullHistory,
    }
  }
}

// BOTH ASSIGNMENT CHECKS RUN ON THIS POPULATION TOO, and skipping them here was the defect this
// module's own NodeSizingAdaptation note describes: reading only the assignments makes a
// wrong-subject answer indistinguishable from an unsized node, so a SizingForAnotherSubject would
// have degraded silently into HistoryNodeUnsized and blamed the wrong cause, and without the
// duplicate check list order would arbitrate between two conflicting cells inside assigned_sizing.
// The whole build refuses rather than proceeding on a population it cannot trust, which is the
// shape the sibling HistoryAcceptanceCarrierLoadRefused arm already uses for a bad population.
fn roadmap_cycle_time_observation_builds() -> List<CycleTimeObservationBuild> {
  match roadmap_acceptance_receipts() {
    RoadmapAcceptanceReceiptsProjectionRefused { detail: detail } =>
      [CycleTimeHistoryRefused {
        refusal: HistoryAcceptanceCarrierLoadRefused { detail: detail },
      }]
    RoadmapAcceptanceReceiptsProjected { receipts: receipts } => {
      let nodes = declared_roadmap_nodes()
      let pulls = cited_pull_timings()
      let links = accepted_node_pull_links()
      let adaptation = derived_node_sizings(nodes: nodes)
      let sizings = adaptation.assignments
      let assignment_refusals = concat(adaptation.refusals, duplicate_sizing_subjects(sizings: sizings))
      if count(assignment_refusals) > 0 {
        return [CycleTimeHistoryRefused {
          refusal: HistorySizingAssignmentRefused { refusals: assignment_refusals },
        }]
      }
      links |> map(link => observation_for_link(
        link: link,
        nodes: nodes,
        sizings: sizings,
        receipts: receipts,
        pulls: pulls,
        links: links,
      ))
    }
  }
}

fn accepted_cycle_time_observations(builds: List<CycleTimeObservationBuild>) -> List<CycleTimeObservation> {
  builds |> flat_map(b => match b {
    CycleTimeObserved { observation } => [observation]
    CycleTimePopulationExcluded { exclusion: _ } => []
    CycleTimeHistoryRefused { refusal: _ } => []
  })
}

fn cycle_time_history_refusals(builds: List<CycleTimeObservationBuild>) -> List<CycleTimeHistoryRefusal> {
  builds |> flat_map(b => match b {
    CycleTimeObserved { observation: _ } => []
    CycleTimePopulationExcluded { exclusion: _ } => []
    CycleTimeHistoryRefused { refusal } => [refusal]
  })
}

fn cycle_time_population_exclusions(builds: List<CycleTimeObservationBuild>) -> List<CycleTimePopulationExclusion> {
  builds
    |> flat_map(b => match b {
      CycleTimeObserved { observation: _ } => []
      CycleTimePopulationExcluded { exclusion } => [exclusion]
      CycleTimeHistoryRefused { refusal: _ } => []
    })
    |> fold(init: [], f: (acc, exclusion) => match exclusion {
      BundledPullDelivery { pull_number, nodes: _ } =>
        if any(acc, existing => match existing {
          BundledPullDelivery { pull_number: existing_pull, nodes: _ } => existing_pull == pull_number
        }) { acc } else { concat(acc, [exclusion]) }
    })
}

type CycleTimeInterval {
  minimum: Millisecond
  median: Millisecond
  maximum: Millisecond
  sample_count: Int
}

type CalibrationResult
  = Calibrated { interval: CycleTimeInterval }
  | CalibrationRefusedNoSample { cell: NodeSizing }

fn int_at(sorted: List<Int>, index: Int) -> Int {
  first(sorted |> skip(n: index))
}

fn median_int(sorted: List<Int>) -> Int {
  let n = count(sorted)
  if (n % 2) == 1 {
    int_at(sorted: sorted, index: n / 2)
  } else {
    (int_at(sorted: sorted, index: (n / 2) - 1) + int_at(sorted: sorted, index: n / 2)) / 2
  }
}

fn calibrate_cell(cell: NodeSizing, observations: List<CycleTimeObservation>) -> CalibrationResult {
  let samples = observations
    |> filter(o => o.provenance == AcceptedRoadmapNodePullHistory)
    |> filter(o => node_sizing_eq(a: o.sizing_cell, b: cell))
    |> map(o => millisecond_count(m: o.cycle_time))
    |> sort_by(n => n)
  if count(samples) == 0 {
    CalibrationRefusedNoSample { cell: cell }
  } else {
    Calibrated {
      interval: CycleTimeInterval {
        minimum: millisecond(count: first(samples)),
        median: millisecond(count: median_int(sorted: samples)),
        maximum: millisecond(count: first(reverse(samples))),
        sample_count: count(samples),
      }
    }
  }
}

type ForecastAnchorObservation { observed_at: EpochMs }

type ReviewCycleCount { count: PositiveMeasureCount }

type OperatorMergeLatencyAssumption { duration: Millisecond }

type EndToEndBeltSlotOccupancyAssumption {}

data end_to_end_belt_slot_occupancy_assumption: EndToEndBeltSlotOccupancyAssumption = EndToEndBeltSlotOccupancyAssumption {}

type ScheduleForecastAssumptions {
  worker_concurrency_cap: BeltCapacity
  review_cycle_count: ReviewCycleCount
  operator_merge_latency: OperatorMergeLatencyAssumption
  belt_slot_occupancy: EndToEndBeltSlotOccupancyAssumption
}

type ScenarioAdjustmentUnavailableCause
  = ReviewCycleDurationUnobserved { declared_count: PositiveMeasureCount }
  | OperatorMergeLatencyUnobserved { declared_latency: Millisecond }

type ScenarioAdjustment
  = AdjustmentUnavailable { causes: List<ScenarioAdjustmentUnavailableCause> }

fn scenario_adjustment(assumptions: ScheduleForecastAssumptions) -> ScenarioAdjustment {
  AdjustmentUnavailable { causes: [
    ReviewCycleDurationUnobserved { declared_count: assumptions.review_cycle_count.count },
    OperatorMergeLatencyUnobserved { declared_latency: assumptions.operator_merge_latency.duration },
  ] }
}

type ForecastInstant { epoch_ms: EpochMs }

type ForecastLowerBoundInterval {
  earliest: ForecastInstant
  median: ForecastInstant
  latest: ForecastInstant
}

type NodeScheduleForecast {
  node: RoadmapNodeId
  calibrated_cycle_time: CycleTimeInterval
  landing_lower_bound: ForecastLowerBoundInterval
}

type DurationEstimateInterval {
  minimum: Millisecond
  median: Millisecond
  maximum: Millisecond
}

type TotalWork { duration: DurationEstimateInterval }

// TotalWork is the capacity-independent sum of per-node calibrated open-to-merge baseline durations. It applies no review-cycle multiplier and adds no merge latency because both are already inseparable inside the observed interval. It is an absolute cycle-time cost, not an observation of labor hours. Only CapacityConstrainedMinimum interprets that sum as belt slot-time, and it structurally carries the occupancy assumption required for that interpretation.
type CriticalPathMinimum { duration: DurationEstimateInterval }

type CapacityConstrainedMinimum {
  duration: DurationEstimateInterval
  under_belt_slot_occupancy: EndToEndBeltSlotOccupancyAssumption
}

type ParallelismHeadroomInterval {
  minimum: FieldOfFractions<Millisecond>
  median: FieldOfFractions<Millisecond>
  maximum: FieldOfFractions<Millisecond>
}

type ParallelismHeadroom { ratio: ParallelismHeadroomInterval }

type ScheduleLowerBounds {
  total_work: TotalWork
  critical_path_minimum: CriticalPathMinimum
  capacity_constrained_minimum: CapacityConstrainedMinimum
  parallelism_headroom: ParallelismHeadroom
}

type ScheduleForecast {
  anchor: ForecastAnchorObservation
  assumptions: ScheduleForecastAssumptions
  nodes: List<NodeScheduleForecast>
  critical_path: List<RoadmapNodeId>
  calibration_population_exclusions: List<CycleTimePopulationExclusion>
  scenario_adjustment: ScenarioAdjustment
  lower_bounds: ScheduleLowerBounds
  completion_lower_bound: ForecastLowerBoundInterval
}

type CalibrationGap {
  cell: NodeSizing
  nodes: List<RoadmapNodeId>
}

type ForecastRefusal
  = ForecastGraphEmpty
  | DependencyCycle { nodes: List<RoadmapNodeId> }
  | DependencyEndpointUnknown { nodes: List<RoadmapNodeId> }
  | NodeUnsized { nodes: List<RoadmapNodeId> }
  | CycleTimeObservationNonPositive { nodes: List<RoadmapNodeId> }
  | NoCalibrationSample {
      gaps: List<CalibrationGap>,
      population_exclusions: List<CycleTimePopulationExclusion>,
      assumptions: ScheduleForecastAssumptions,
      scenario_adjustment: ScenarioAdjustment,
    }
  | WorkerConcurrencyCapInvalid { declared_cap: Int }
  | CalibrationHistoryRefused { refusals: List<CycleTimeHistoryRefusal> }
  | ForecastRoadmapAuthorityRefused { detail: String }
  | ForecastBuildRefused { node: RoadmapNodeId }
  | SizingAssignmentRefused { refusals: List<SizingAssignmentRefusal> }

type ScheduleForecastResult
  = ScheduleForecastKnown { forecast: ScheduleForecast }
  | ScheduleForecastRefused { refusals: List<ForecastRefusal> }

fn forecast_refusal_count(result: ScheduleForecastResult) -> Int {
  match result {
    ScheduleForecastKnown { forecast: _ } => 0
    ScheduleForecastRefused { refusals } => count(refusals)
  }
}

// SIZING IS AN INPUT TO THIS FOLD, NOT SOMETHING IT REACHES OUT FOR. Every other fact the forecast
// consumes -- nodes, edges, observations, refusals, exclusions, the anchor -- arrives as a
// parameter, and sizing was the exception only because it rode on the node record. Now that it is
// derived, passing the derivation in keeps the fold total and testable: a witness supplies the
// cells it wants to exercise, and production supplies whatever the deriver actually answered. A
// node with no assignment is unsized to this fold, which is the same refusal the authored Unsized
// arm used to produce.
// THE ASSIGNMENT IS KEYED BY THE KEY THE DERIVER ANSWERED UNDER, and this is the whole reason the
// type exists rather than the sizing riding on the node record. A derivation is SUBJECTED to a
// SizingSubjectId -- gunbc.roadmap_model node_sizing_subject_id, the node's minted identity,
// because roadmap_node_identity_law forbids the slug as an identity input. An assignment keyed by
// RoadmapNodeId would have derived evidence under a durable key and then matched it to nodes by a
// mutable one, so a rename would silently break the join: the strength of a join is its weakest
// key, and the durable one would never have participated in the lookup.
//
// THE SLUG IS NOT BANISHED, IT IS SCOPED. RoadmapNodeId remains the key of the dependency edges,
// of the refusal payloads, and of every population this module reports, because those are the
// graph's and the wire's vocabulary and this change does not migrate them. What it must not be is
// the key of THIS join. So a fold filters by identity and reports by slug.
type NodeSizingAssignment {
  subject: SizingSubjectId
  sizing: NodeSizing
}

fn assigned_sizing(sizings: List<NodeSizingAssignment>, subject: SizingSubjectId) -> NodeSizing? {
  match sizings |> filter(a => a.subject == subject) |> first {
    Absent => Absent
    Present { value: a } => Present { value: a.sizing }
  }
}

// A DERIVED CELL IS ADMITTED FOR THE SUBJECT IT NAMES OR FOR NO SUBJECT AT ALL. The adapter below
// is the seam where an answer from gunbc.roadmap_sizing becomes a fact about a roadmap node, and
// it is the one place a wrong answer could be rebound to the wrong node. It does not rebind: it
// compares the subject the deriver ANSWERED UNDER against the subject the node was ASKED UNDER --
// the same gunbc.roadmap_model node_sizing_subject_id projection on both sides -- and a mismatch
// produces SizingForAnotherSubject rather than an assignment.
//
// THIS ARM IS UNREACHABLE TODAY AND THAT IS EXACTLY WHY IT IS HERE. The stub refuses every subject,
// so no assignment of any kind is produced; but this adapter is deliberately written to start
// producing the moment the deriver answers, with no second edit. A positional rebind left at this
// seam would therefore not be a dormant defect -- it would be a live defect scheduled to arrive
// silently on the day the seam activates. The control that fires it is authorable because the
// derivation is a PARAMETER here:
// test.claim.roadmap_forecast_witness.witness_a_cell_answered_for_another_subject_refuses hands
// this function a cell carrying another node's subject and reads the refusal, and
// witness_a_cell_answered_for_its_own_subject_is_admitted is its positive twin, so the arm is
// shown to discriminate rather than merely to fire.
type SizingAssignmentRefusal
  = SizingForAnotherSubject { asked: SizingSubjectId, answered: SizingSubjectId }
  | SizingAssignedTwice { subject: SizingSubjectId }

// BOTH HALVES OF ONE ANSWER, reported together rather than one silently dropping the other: a fold
// that returned only the assignments would make a wrong-subject answer indistinguishable from an
// unsized node, and one that returned only refusals could not produce a forecast.
type NodeSizingAdaptation {
  assignments: List<NodeSizingAssignment>
  refusals: List<SizingAssignmentRefusal>
}

fn node_sizing_adaptation(rn: RoadmapNode, d: NodeSizingDerivation) -> NodeSizingAdaptation {
  let asked = node_sizing_subject_id(rn: rn)
  match d {
    SizingNotDerivable { subject: _, detail: _ } =>
      NodeSizingAdaptation { assignments: [], refusals: [] }
    SizingDerived { subject, sizing } =>
      if subject == asked {
        NodeSizingAdaptation {
          assignments: [NodeSizingAssignment { subject: subject, sizing: sizing }],
          refusals: [],
        }
      } else {
        NodeSizingAdaptation {
          assignments: [],
          refusals: [SizingForAnotherSubject { asked: asked, answered: subject }],
        }
      }
  }
}

// THE PRODUCTION ADAPTATION, AND IT IS EMPTY TODAY. gunbc.roadmap_sizing derive_task_sizing is a
// stub that refuses for every subject, so this fold yields no assignments and no refusals, and the
// forecast refuses with NodeUnsized over the whole graph. That is the declared loss, rostered as
// gunbc.rung_drop.roadmap_sizing_authored_to_derived; it is written as a fold over the real deriver
// rather than as a literal empty list, so the day the deriver answers this function starts
// producing without being edited.
fn derived_node_sizings(nodes: List<RoadmapNode>) -> NodeSizingAdaptation {
  nodes |> fold(init: NodeSizingAdaptation { assignments: [], refusals: [] }, f: (acc, n) => {
    let one = node_sizing_adaptation(rn: n, d: node_sizing_derivation(rn: n))
    NodeSizingAdaptation {
      assignments: concat(acc.assignments, one.assignments),
      refusals: concat(acc.refusals, one.refusals),
    }
  })
}

// LIST ORDER IS NOT AN ARBITER. assigned_sizing takes the first match, which is correct only if a
// subject can appear at most once; nothing in a List enforces that, so the population is checked
// before any fold reads it and a repeated subject refuses instead of letting position decide which
// of two conflicting cells wins.
fn duplicate_sizing_subjects(sizings: List<NodeSizingAssignment>) -> List<SizingAssignmentRefusal> {
  sizings
    |> filter(a => count(sizings |> filter(b => b.subject == a.subject)) > 1)
    |> fold(init: [], f: (acc, a) =>
      if any(acc, existing => match existing {
        SizingAssignedTwice { subject } => subject == a.subject
        SizingForAnotherSubject { asked: _, answered: _ } => false
      }) { acc } else { concat(acc, [SizingAssignedTwice { subject: a.subject }]) }
    )
}

fn unique_cells(cells: List<NodeSizing>) -> List<NodeSizing> {
  cells |> fold(init: [], f: (acc, cell) =>
    if any(acc, existing => node_sizing_eq(a: existing, b: cell)) { acc }
    else { concat(acc, [cell]) }
  )
}

fn calibration_gaps(
  nodes: List<RoadmapNode>,
  sizings: List<NodeSizingAssignment>,
  observations: List<CycleTimeObservation>,
) -> List<CalibrationGap> {
  let cells = unique_cells(cells: nodes |> flat_map(n => match assigned_sizing(sizings: sizings, subject: node_sizing_subject_id(rn: n)) {
    Absent => []
    Present { value } => [value]
  }))
  cells |> flat_map(cell => match calibrate_cell(cell: cell, observations: observations) {
    Calibrated { interval: _ } => []
    CalibrationRefusedNoSample { cell: missing } => [CalibrationGap {
      cell: missing,
      nodes: nodes
        |> filter(n => match assigned_sizing(sizings: sizings, subject: node_sizing_subject_id(rn: n)) {
          Absent => false
          Present { value } => node_sizing_eq(a: value, b: missing)
        })
        |> map(n => n.node),
    }]
  })
}

fn dependency_graph(nodes: List<RoadmapNode>, edges: List<RoadmapEdge>) -> CallGraph {
  CallGraph {
    edges: edges |> map(e => GraphEdge { caller: e.child as String, callee: e.parent as String })
  }
}

fn dependency_cycle_nodes(nodes: List<RoadmapNode>, edges: List<RoadmapEdge>) -> List<RoadmapNodeId> {
  graph_cycle_members(
    names: nodes |> map(n => n.node as String),
    graph: dependency_graph(nodes: nodes, edges: edges),
  ) |> map(n => n as RoadmapNodeId)
}

fn unknown_dependency_endpoints(nodes: List<RoadmapNode>, edges: List<RoadmapEdge>) -> List<RoadmapNodeId> {
  let ids = nodes |> map(n => n.node)
  concat(
    edges |> filter(e => !any(ids, id => id == e.child)) |> map(e => e.child),
    edges |> filter(e => !any(ids, id => id == e.parent)) |> map(e => e.parent),
  ) |> fold(init: [], f: (acc, id) => if any(acc, existing => existing == id) { acc } else { concat(acc, [id]) })
}

type ForecastBound = EarliestBound | MedianBound | LatestBound

fn interval_bound(interval: CycleTimeInterval, bound: ForecastBound) -> Int {
  match bound {
    EarliestBound => millisecond_count(m: interval.minimum)
    MedianBound => millisecond_count(m: interval.median)
    LatestBound => millisecond_count(m: interval.maximum)
  }
}

fn baseline_node_duration(
  interval: CycleTimeInterval,
  bound: ForecastBound,
) -> Millisecond {
  millisecond(count: interval_bound(interval: interval, bound: bound))
}

type PathEstimate {
  duration: Millisecond
  path: List<RoadmapNodeId>
}

type PathEstimateResult
  = PathEstimated { estimate: PathEstimate }
  | PathEstimateUnknown { node: RoadmapNodeId }

fn longer_path(a: PathEstimate, b: PathEstimate) -> PathEstimate {
  if millisecond_count(m: b.duration) > millisecond_count(m: a.duration) { b } else { a }
}

fn path_to_node(
  node: RoadmapNode,
  nodes: List<RoadmapNode>,
  sizings: List<NodeSizingAssignment>,
  edges: List<RoadmapEdge>,
  observations: List<CycleTimeObservation>,
  bound: ForecastBound,
) -> PathEstimateResult {
  let cell = match assigned_sizing(sizings: sizings, subject: node_sizing_subject_id(rn: node)) {
    Absent => return PathEstimateUnknown { node: node.node }
    Present { value } => value
  }
  let interval = match calibrate_cell(cell: cell, observations: observations) {
    CalibrationRefusedNoSample { cell: _ } => return PathEstimateUnknown { node: node.node }
    Calibrated { interval } => interval
  }
  let parent_ids = edges |> filter(e => e.child == node.node) |> map(e => e.parent)
  let parent_estimates = parent_ids |> map(parent_id =>
    match nodes |> filter(n => n.node == parent_id) |> first {
      Absent => PathEstimateUnknown { node: parent_id }
      Present { value: parent } => path_to_node(
        node: parent,
        nodes: nodes,
        sizings: sizings,
        edges: edges,
        observations: observations,
        bound: bound,
      )
    }
  )
  let refused = parent_estimates |> filter(r => match r {
    PathEstimated { estimate: _ } => false
    PathEstimateUnknown { node: _ } => true
  })
  match first(refused) {
    Present { value } => value
    Absent => {
      let parent_best = parent_estimates |> fold(
        init: PathEstimate { duration: millisecond(count: 0), path: [] },
        f: (best, result) => match result {
          PathEstimated { estimate } => longer_path(a: best, b: estimate)
          PathEstimateUnknown { node: _ } => best
        },
      )
      PathEstimated { estimate: PathEstimate {
        duration: millisecond(
          count: millisecond_count(m: parent_best.duration) + millisecond_count(m: baseline_node_duration(
            interval: interval,
            bound: bound,
          )),
        ),
        path: concat(parent_best.path, [node.node]),
      } }
    }
  }
}

type NodeForecastBuild
  = NodeForecastBuilt { forecast: NodeScheduleForecast, median_path: List<RoadmapNodeId> }
  | NodeForecastBuildRefused { node: RoadmapNodeId }

type CriticalPathChoice {
  median_epoch_ms: EpochMs
  path: List<RoadmapNodeId>
}

fn forecast_instant(anchor: ForecastAnchorObservation, duration: Millisecond) -> ForecastInstant {
  ForecastInstant { epoch_ms: anchor.observed_at + millisecond_count(m: duration) }
}

fn build_node_forecast(
  node: RoadmapNode,
  nodes: List<RoadmapNode>,
  sizings: List<NodeSizingAssignment>,
  edges: List<RoadmapEdge>,
  observations: List<CycleTimeObservation>,
  anchor: ForecastAnchorObservation,
) -> NodeForecastBuild {
  let cell = match assigned_sizing(sizings: sizings, subject: node_sizing_subject_id(rn: node)) {
    Absent => return NodeForecastBuildRefused { node: node.node }
    Present { value } => value
  }
  let calibrated = match calibrate_cell(cell: cell, observations: observations) {
    CalibrationRefusedNoSample { cell: _ } => return NodeForecastBuildRefused { node: node.node }
    Calibrated { interval } => interval
  }
  let earliest = path_to_node(node: node, nodes: nodes, sizings: sizings, edges: edges, observations: observations, bound: EarliestBound)
  let median = path_to_node(node: node, nodes: nodes, sizings: sizings, edges: edges, observations: observations, bound: MedianBound)
  let latest = path_to_node(node: node, nodes: nodes, sizings: sizings, edges: edges, observations: observations, bound: LatestBound)
  match earliest {
    PathEstimateUnknown { node: _ } => NodeForecastBuildRefused { node: node.node }
    PathEstimated { estimate: early } => match median {
      PathEstimateUnknown { node: _ } => NodeForecastBuildRefused { node: node.node }
      PathEstimated { estimate: middle } => match latest {
        PathEstimateUnknown { node: _ } => NodeForecastBuildRefused { node: node.node }
        PathEstimated { estimate: late } => NodeForecastBuilt {
          forecast: NodeScheduleForecast {
            node: node.node,
            calibrated_cycle_time: calibrated,
            landing_lower_bound: ForecastLowerBoundInterval {
              earliest: forecast_instant(anchor: anchor, duration: early.duration),
              median: forecast_instant(anchor: anchor, duration: middle.duration),
              latest: forecast_instant(anchor: anchor, duration: late.duration),
            },
          },
          median_path: middle.path,
        }
      }
    }
  }
}

fn dependency_completion_lower_bound(nodes: List<NodeScheduleForecast>, anchor: ForecastAnchorObservation) -> ForecastLowerBoundInterval {
  nodes |> fold(
    init: ForecastLowerBoundInterval {
      earliest: ForecastInstant { epoch_ms: anchor.observed_at },
      median: ForecastInstant { epoch_ms: anchor.observed_at },
      latest: ForecastInstant { epoch_ms: anchor.observed_at },
    },
    f: (acc, node) => ForecastLowerBoundInterval {
      earliest: ForecastInstant { epoch_ms: if node.landing_lower_bound.earliest.epoch_ms > acc.earliest.epoch_ms { node.landing_lower_bound.earliest.epoch_ms } else { acc.earliest.epoch_ms } },
      median: ForecastInstant { epoch_ms: if node.landing_lower_bound.median.epoch_ms > acc.median.epoch_ms { node.landing_lower_bound.median.epoch_ms } else { acc.median.epoch_ms } },
      latest: ForecastInstant { epoch_ms: if node.landing_lower_bound.latest.epoch_ms > acc.latest.epoch_ms { node.landing_lower_bound.latest.epoch_ms } else { acc.latest.epoch_ms } },
    },
  )
}

fn total_work_duration(
  nodes: List<NodeScheduleForecast>,
  bound: ForecastBound,
) -> Millisecond {
  let total = nodes |> fold(init: 0, f: (acc, node) =>
    acc + millisecond_count(m: baseline_node_duration(
      interval: node.calibrated_cycle_time,
      bound: bound,
    ))
  )
  millisecond(count: total)
}

fn total_work(
  nodes: List<NodeScheduleForecast>,
) -> TotalWork {
  TotalWork { duration: DurationEstimateInterval {
    minimum: total_work_duration(nodes: nodes, bound: EarliestBound),
    median: total_work_duration(nodes: nodes, bound: MedianBound),
    maximum: total_work_duration(nodes: nodes, bound: LatestBound),
  } }
}

fn critical_path_minimum(
  bound: ForecastLowerBoundInterval,
  anchor: ForecastAnchorObservation,
) -> CriticalPathMinimum {
  CriticalPathMinimum { duration: DurationEstimateInterval {
    minimum: millisecond(count: bound.earliest.epoch_ms - anchor.observed_at),
    median: millisecond(count: bound.median.epoch_ms - anchor.observed_at),
    maximum: millisecond(count: bound.latest.epoch_ms - anchor.observed_at),
  } }
}

fn capacity_constrained_minimum(
  total: TotalWork,
  critical: CriticalPathMinimum,
  worker_cap: Int,
  belt_slot_occupancy: EndToEndBeltSlotOccupancyAssumption,
) -> CapacityConstrainedMinimum {
  CapacityConstrainedMinimum {
    duration: DurationEstimateInterval {
      minimum: millisecond(count: if millisecond_count(m: critical.duration.minimum) > (millisecond_count(m: total.duration.minimum) + worker_cap - 1) / worker_cap { millisecond_count(m: critical.duration.minimum) } else { (millisecond_count(m: total.duration.minimum) + worker_cap - 1) / worker_cap }),
      median: millisecond(count: if millisecond_count(m: critical.duration.median) > (millisecond_count(m: total.duration.median) + worker_cap - 1) / worker_cap { millisecond_count(m: critical.duration.median) } else { (millisecond_count(m: total.duration.median) + worker_cap - 1) / worker_cap }),
      maximum: millisecond(count: if millisecond_count(m: critical.duration.maximum) > (millisecond_count(m: total.duration.maximum) + worker_cap - 1) / worker_cap { millisecond_count(m: critical.duration.maximum) } else { (millisecond_count(m: total.duration.maximum) + worker_cap - 1) / worker_cap }),
    },
    under_belt_slot_occupancy: belt_slot_occupancy,
  }
}

fn completion_lower_bound_from_duration(
  duration: DurationEstimateInterval,
  anchor: ForecastAnchorObservation,
) -> ForecastLowerBoundInterval {
  ForecastLowerBoundInterval {
    earliest: forecast_instant(anchor: anchor, duration: duration.minimum),
    median: forecast_instant(anchor: anchor, duration: duration.median),
    latest: forecast_instant(anchor: anchor, duration: duration.maximum),
  }
}

fn parallelism_headroom(total: TotalWork, critical: CriticalPathMinimum) -> ParallelismHeadroom {
  ParallelismHeadroom { ratio: ParallelismHeadroomInterval {
    minimum: FieldOfFractions { num: total.duration.minimum, denom: critical.duration.minimum },
    median: FieldOfFractions { num: total.duration.median, denom: critical.duration.median },
    maximum: FieldOfFractions { num: total.duration.maximum, denom: critical.duration.maximum },
  } }
}

fn schedule_forecast(
  nodes: List<RoadmapNode>,
  sizings: List<NodeSizingAssignment>,
  edges: List<RoadmapEdge>,
  observations: List<CycleTimeObservation>,
  history_refusals: List<CycleTimeHistoryRefusal>,
  population_exclusions: List<CycleTimePopulationExclusion>,
  assumptions: ScheduleForecastAssumptions,
  anchor: ForecastAnchorObservation,
) -> ScheduleForecastResult {
  let cycles = dependency_cycle_nodes(nodes: nodes, edges: edges)
  let unknown_endpoints = unknown_dependency_endpoints(nodes: nodes, edges: edges)
  let unsized = nodes |> filter(n => match assigned_sizing(sizings: sizings, subject: node_sizing_subject_id(rn: n)) { Absent => true Present { value: _ } => false }) |> map(n => n.node)
  let non_positive_observation_nodes = observations
    |> filter(observation => millisecond_count(m: observation.cycle_time) <= 0)
    |> fold(init: [], f: (located, observation) =>
      if any(located, node => node == observation.node) { located }
      else { append(located, items: [observation.node]) }
    )
  let gaps = calibration_gaps(nodes: nodes, sizings: sizings, observations: observations)
  let invalid_worker_cap = assumptions.worker_concurrency_cap.max_concurrent <= 0
  let duplicate_subjects = duplicate_sizing_subjects(sizings: sizings)
  let refusals = concat(
    if count(duplicate_subjects) > 0 { [SizingAssignmentRefused { refusals: duplicate_subjects }] } else { [] },
    concat(
    if count(nodes) == 0 { [ForecastGraphEmpty] } else { [] },
    concat(
      if count(cycles) > 0 { [DependencyCycle { nodes: cycles }] } else { [] },
      concat(
        if count(unknown_endpoints) > 0 { [DependencyEndpointUnknown { nodes: unknown_endpoints }] } else { [] },
        concat(
          if count(unsized) > 0 { [NodeUnsized { nodes: unsized }] } else { [] },
          concat(
            if count(non_positive_observation_nodes) > 0 { [CycleTimeObservationNonPositive { nodes: non_positive_observation_nodes }] } else { [] },
            concat(
              if count(gaps) > 0 { [NoCalibrationSample {
              gaps: gaps,
              population_exclusions: population_exclusions,
              assumptions: assumptions,
              scenario_adjustment: scenario_adjustment(assumptions: assumptions),
              }] } else { [] },
              concat(
                if invalid_worker_cap { [WorkerConcurrencyCapInvalid { declared_cap: assumptions.worker_concurrency_cap.max_concurrent }] } else { [] },
                if count(history_refusals) > 0 { [CalibrationHistoryRefused { refusals: history_refusals }] } else { [] },
              ),
            ),
          ),
        ),
      ),
    ),
    ),
  )
  if count(refusals) > 0 {
    return ScheduleForecastRefused { refusals: refusals }
  }
  let builds = nodes |> map(node => build_node_forecast(
    node: node,
    nodes: nodes,
    sizings: sizings,
    edges: edges,
    observations: observations,
    anchor: anchor,
  ))
  let build_refusals = builds |> flat_map(b => match b {
    NodeForecastBuilt { forecast: _, median_path: _ } => []
    NodeForecastBuildRefused { node } => [ForecastBuildRefused { node: node }]
  })
  if count(build_refusals) > 0 {
    return ScheduleForecastRefused { refusals: build_refusals }
  }
  let forecasts = builds |> flat_map(b => match b {
    NodeForecastBuilt { forecast, median_path: _ } => [forecast]
    NodeForecastBuildRefused { node: _ } => []
  })
  let critical = builds |> fold(
    init: CriticalPathChoice { median_epoch_ms: 0, path: [] },
    f: (best, candidate) => match candidate {
      NodeForecastBuildRefused { node: _ } => best
      NodeForecastBuilt { forecast, median_path } =>
        if forecast.landing_lower_bound.median.epoch_ms >= best.median_epoch_ms {
          CriticalPathChoice { median_epoch_ms: forecast.landing_lower_bound.median.epoch_ms, path: median_path }
        } else { best }
    },
  )
  let dependency_bound = dependency_completion_lower_bound(nodes: forecasts, anchor: anchor)
  let total = total_work(nodes: forecasts)
  let critical_minimum = critical_path_minimum(bound: dependency_bound, anchor: anchor)
  let capacity_minimum = capacity_constrained_minimum(
    total: total,
    critical: critical_minimum,
    worker_cap: assumptions.worker_concurrency_cap.max_concurrent,
    belt_slot_occupancy: assumptions.belt_slot_occupancy,
  )
  ScheduleForecastKnown { forecast: ScheduleForecast {
    anchor: anchor,
    assumptions: assumptions,
    nodes: forecasts,
    critical_path: critical.path,
    calibration_population_exclusions: population_exclusions,
    scenario_adjustment: scenario_adjustment(assumptions: assumptions),
    lower_bounds: ScheduleLowerBounds {
      total_work: total,
      critical_path_minimum: critical_minimum,
      capacity_constrained_minimum: capacity_minimum,
      parallelism_headroom: parallelism_headroom(total: total, critical: critical_minimum),
    },
    completion_lower_bound: completion_lower_bound_from_duration(duration: capacity_minimum.duration, anchor: anchor),
  } }
}

// THE FORECAST'S PLAN IS A PARAMETER. The accepted set is carried BY the projection -- it is the
// field roadmap_authority_projection fills from accepted_roadmap_node_ids_projection -- so the fold
// reads it from the plan it was handed rather than re-deriving it from the public carrier. That is
// what makes a caller-supplied plan forecastable at all: a second read would have answered about
// the public roadmap while the nodes came from the caller's.
fn roadmap_schedule_forecast_over(
  plan: RoadmapAuthorityProjection,
  assumptions: ScheduleForecastAssumptions,
  anchor: ForecastAnchorObservation,
) -> ScheduleForecastResult {
  match plan {
    RoadmapAuthorityProjectionRefused { detail: detail } =>
      ScheduleForecastRefused { refusals: [ForecastRoadmapAuthorityRefused { detail: detail }] }
    RoadmapAuthorityProjected { doc: _, accepted: accepted } =>
      let builds = roadmap_cycle_time_observation_builds()
      let active_nodes = active_roadmap_nodes_for_accepted(accepted: accepted)
      let adaptation = derived_node_sizings(nodes: active_nodes)
      if count(adaptation.refusals) > 0 {
        ScheduleForecastRefused {
          refusals: [SizingAssignmentRefused { refusals: adaptation.refusals }],
        }
      } else {
        schedule_forecast(
          nodes: active_nodes,
          sizings: adaptation.assignments,
          edges: active_roadmap_edges_for_accepted(accepted: accepted),
          observations: accepted_cycle_time_observations(builds: builds),
          history_refusals: cycle_time_history_refusals(builds: builds),
          population_exclusions: cycle_time_population_exclusions(builds: builds),
          assumptions: assumptions,
          anchor: anchor,
        )
      }
  }
}

fn live_roadmap_schedule_forecast(
  assumptions: ScheduleForecastAssumptions,
  anchor: ForecastAnchorObservation,
) -> ScheduleForecastResult {
  roadmap_schedule_forecast_over(
    plan: roadmap_authority_projection(),
    assumptions: assumptions,
    anchor: anchor,
  )
}
