module gunbc.roadmap.roadmap_decomposition

import std.types { String, Int, Bool, List }
import gunbc.roadmap.roadmap_model { RoadmapNodeId }
import gunbc.roadmap.roadmap_authority { declared_roadmap_nodes, nid }

// THE RECURSIVE DECOMPOSITION OF EVERY OPEN BOUND WORK ITEM, DONE UP FRONT (operator, 2026-11-17: "basically i'm
// asking us to recursively decompose the tasks up front/now"; "the units of work being sized for a worker node";
// "honest accounting at a unit level is all that should matter"). A work item is a roadmap node; it opens into
// STAGES (a stage waits on the stage before it), a stage into PIECES that may run in parallel, and a piece is a
// LEAF or another list of stages. THE LEAF RULE: at most leaf_days_max working days, one worker, one pull request,
// one observable named in its label (a claim green, a refusal, a receipt, a deletion). A leaf with a population
// is one attempt per member; a Placeholder population is unknown until an enumeration leaf earlier in the same
// item has run, and that is where a replan happens: the assumed count is the simulation's input, never a claim.
//
// WHAT THIS IS. The planning input the simulation runs over: aggregate dates are the simulated execution of these
// leaves under the dependency edges of gunbc.roadmap.roadmap_authority (a parent's every leaf precedes a child's
// first stage), so there is no estimate at the item grain that is not the sum of its leaves. Each row is a
// proposal read from the item's own first slice and handback and from populations counted on 2026-11-17 (126
// grammar productions; 54 unhomed names in the native-seven closure; 26 in the compiler closures; 8 dual std
// types; about 430 corpus names in home-groups of ten; 32 production modules with reason symbols). A leaf whose
// label says "retire" records that the ruling of the same day answered the item, so its only work is the receipt.
//
// WHAT THIS IS NOT. Not a second roadmap: a leaf is not a RoadmapNode and has no identity, owner or event log; it
// becomes one only when a worker claims it, and then the claim names its item and its path here. Not a schedule:
// no leaf carries a date (gunbc.design_ruling planning_scheduling_is_cut). Not a count the tree must keep: a
// realized claimed-to-accepted duration replaces a leaf's days when it lands, and a measured population replaces
// a Placeholder; nothing here is ratcheted.

type Population
  = Counted { n: Int }
  | Placeholder { assumed: Int }

type WorkPiece
  = Leaf { label: String, days: Int, population: Population }
  | Composite { label: String, stages: List<WorkStage> }

type WorkStage { pieces: List<WorkPiece> }

type WorkDecomposition {
  node: RoadmapNodeId
  stages: List<WorkStage>
}

data leaf_days_max: Int = 5

fn leaf(label: String, days: Int) -> WorkPiece {
  Leaf { label: label, days: days, population: Counted { n: 1 } }
}

fn leaves(label: String, days: Int, n: Int) -> WorkPiece {
  Leaf { label: label, days: days, population: Counted { n: n } }
}

fn placeholder(label: String, days: Int, assumed: Int) -> WorkPiece {
  Leaf { label: label, days: days, population: Placeholder { assumed: assumed } }
}

fn stages_of(stages: List<List<WorkPiece>>) -> List<WorkStage> {
  fold(stages, init: [], f: fn(acc, s) { concat(acc, [WorkStage { pieces: s }]) })
}

fn piece(label: String, stages: List<List<WorkPiece>>) -> WorkPiece {
  Composite { label: label, stages: stages_of(stages: stages) }
}

fn decomposition(node: String, stages: List<List<WorkPiece>>) -> WorkDecomposition {
  WorkDecomposition { node: nid(s: node), stages: stages_of(stages: stages) }
}

fn population_count(p: Population) -> Int {
  match p {
    Counted { n } => n
    Placeholder { assumed } => assumed
  }
}

fn population_is_placeholder(p: Population) -> Bool {
  match p {
    Counted { n } => false
    Placeholder { assumed } => true
  }
}

fn piece_leaf_count(p: WorkPiece) -> Int {
  match p {
    Leaf { label, days, population } => population_count(p: population)
    Composite { label, stages } => stages_leaf_count(stages: stages)
  }
}

fn stages_leaf_count(stages: List<WorkStage>) -> Int {
  fold(stages, init: 0, f: fn(acc, s) { acc + fold(s.pieces, init: 0, f: fn(a, p) { a + piece_leaf_count(p: p) }) })
}

fn piece_leaf_days(p: WorkPiece) -> Int {
  match p {
    Leaf { label, days, population } => days * population_count(p: population)
    Composite { label, stages } => stages_leaf_days(stages: stages)
  }
}

fn stages_leaf_days(stages: List<WorkStage>) -> Int {
  fold(stages, init: 0, f: fn(acc, s) { acc + fold(s.pieces, init: 0, f: fn(a, p) { a + piece_leaf_days(p: p) }) })
}

fn piece_placeholder_count(p: WorkPiece) -> Int {
  match p {
    Leaf { label, days, population } => if population_is_placeholder(p: population) { population_count(p: population) } else { 0 }
    Composite { label, stages } => stages_placeholder_count(stages: stages)
  }
}

fn stages_placeholder_count(stages: List<WorkStage>) -> Int {
  fold(stages, init: 0, f: fn(acc, s) { acc + fold(s.pieces, init: 0, f: fn(a, p) { a + piece_placeholder_count(p: p) }) })
}

// THE LEAF RULE, as a fold: every leaf under a piece is within leaf_days_max.
fn piece_leaf_days_within(p: WorkPiece) -> Bool {
  match p {
    Leaf { label, days, population } => days <= leaf_days_max
    Composite { label, stages } => stages_leaf_days_within(stages: stages)
  }
}

fn stages_leaf_days_within(stages: List<WorkStage>) -> Bool {
  all(stages, s => all(s.pieces, p => piece_leaf_days_within(p: p)))
}

// NO EMPTY STAGE AND NO EMPTY COMPOSITE: a stage with nothing in it would be a free day in the simulation.
fn piece_stages_nonempty(p: WorkPiece) -> Bool {
  match p {
    Leaf { label, days, population } => population_count(p: population) >= 1
    Composite { label, stages } => count(stages) >= 1 && stages_nonempty(stages: stages)
  }
}

fn stages_nonempty(stages: List<WorkStage>) -> Bool {
  all(stages, s => count(s.pieces) >= 1 && all(s.pieces, p => piece_stages_nonempty(p: p)))
}

fn decomposition_has_node(d: WorkDecomposition) -> Bool {
  count(filter(declared_roadmap_nodes(), n => n.node == d.node)) == 1
}

fn decompositions_all_have_nodes() -> Bool {
  all(roadmap_decompositions, d => decomposition_has_node(d: d))
}

fn decomposition_nodes_unique() -> Bool {
  all(roadmap_decompositions, d => count(filter(roadmap_decompositions, e => e.node == d.node)) == 1)
}

fn decompositions_leaf_days_bounded() -> Bool {
  all(roadmap_decompositions, d => stages_leaf_days_within(stages: d.stages))
}

fn decompositions_stages_nonempty() -> Bool {
  all(roadmap_decompositions, d => count(d.stages) >= 1 && stages_nonempty(stages: d.stages))
}

fn decomposition_for(node: RoadmapNodeId) -> List<WorkDecomposition> {
  filter(roadmap_decompositions, d => d.node == node)
}

fn decomposition_leaf_count() -> Int {
  fold(roadmap_decompositions, init: 0, f: fn(acc, d) { acc + stages_leaf_count(stages: d.stages) })
}

fn decomposition_leaf_days() -> Int {
  fold(roadmap_decompositions, init: 0, f: fn(acc, d) { acc + stages_leaf_days(stages: d.stages) })
}

fn decomposition_placeholder_count() -> Int {
  fold(roadmap_decompositions, init: 0, f: fn(acc, d) { acc + stages_placeholder_count(stages: d.stages) })
}

