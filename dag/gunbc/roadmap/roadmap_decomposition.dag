// =================== roadmap-schedule-leaf-expansion: decomposition -> leaf OCCURRENCES ===================
// A decomposition reads as leaf OCCURRENCES with the dependency EDGES between them: one occurrence per leaf
// at member 0, one per member of a produced/read family at its DECLARED count, and one per member of a
// FindingsOf family at a SIMULATION-input count -- an ASSUMED count the carrier itself declares none of.
// The edge relation is stage k depending on stage k-1, plus every waits_on row aimed into the child's own
// stage. The expansion WRITES NOTHING; its executing consumer is the leaf-expansion witness
// (test.claim.roadmap.roadmap_schedule_leaf_expansion_witness), which reads the occurrences and their edges
// through the accessors below. Downstream schedule/readiness units are OUT OF SCOPE for this unit and are
// deliberately NOT built or claimed here. It mints no
// gunbc.roadmap.roadmap_authority node -- a leaf has no identity until claimed. Occurrences are keyed by the
// single carrier LeafPath (imported from gunbc.roadmap.roadmap_model above); nothing here re-spells that tuple.
//
// The expansion's ONE fail-closed gate is the carrier's OWN well-formedness claim,
// decomposition_dependencies_well_formed: a planted waits_on naming a stage the parent's decomposition does
// not have refuses there, and the expansion CALLS that claim rather than re-checking a row the carrier has
// already admitted.
//
// Index arithmetic and comparison run in Int (the carrier's own index law, as decomposition_has_leaf_path
// does); a LeafPath index is read back with nat_to_int. LeafPath indices are BUILT as `Nat` by successor
// (Zero / Succ) at each enumeration site, and loop bounds come from carrier counts or the findings-count
// simulation input read as Int -- so no Int is ever converted into a Nat field position, and there is no
// checked-crossing branch whose `Absent` could silently drop an occurrence. There is no un-representable index
// to guard: every index counts up from zero, and a stage's member indices never exceed its enumerated length.
// A dependency is refused by the gate below, not by a mint-time check.

// The count an occurrence's member index is drawn from: DECLARED by the carrier, or ASSUMED (a simulation
// input the carrier never declared, used only for a FindingsOf family whose count is unknown until its
// probe runs). This is the carrier's single declared-vs-assumed distinction; a FindingsOf member is never
// DECLARED, so it is never offered as claimable.
type OccurrenceCount = Declared | Assumed

type Occurrence {
  path: LeafPath
  count_source: OccurrenceCount
}

// An edge between two occurrences: `to` waits on `from`.
type OccurrenceEdge {
  from: LeafPath
  to: LeafPath
}

// The expansion is fail-closed: it either holds the occurrences and their edges, or a located refusal naming
// the carrier claim that refused.
type Expansion
  = Expanded { occurrences: List<Occurrence>, edges: List<OccurrenceEdge> }
  | Refused { cause: String }

// Members drawn from Int `first` up to Int `last` with the given count source. The bounds are Int (a carrier
// count or the findings-count simulation input); the member index that KEYS each occurrence is a `Nat` advanced
// by successor alongside the counter, so no Int ever crosses into a Nat field. An empty or inverted range
// yields none.
fn members_occurrences(item: RoadmapNodeId, stage: Nat, piece: Nat, first: Int, last: Int, index: Nat, source: OccurrenceCount) -> List<Occurrence> {
  if last <= first {
    []
  } else {
    concat(
      [ member_occurrence(item: item, stage: stage, piece: piece, member: index, source: source) ],
      members_occurrences(item: item, stage: stage, piece: piece, first: first + 1, last: last, index: Succ { prev: index }, source: source),
    )
  }
}

// THE single place an Occurrence is minted. Every index arrives here as a `Nat` already built by successor
// (Zero / Succ) at the enumeration sites below -- never as an un-checked Int->Nat crossing -- so there is no
// representability branch to bypass and no state the type system could not already hold. The mint is total.
fn member_occurrence(item: RoadmapNodeId, stage: Nat, piece: Nat, member: Nat, source: OccurrenceCount) -> Occurrence {
  Occurrence { path: LeafPath { item: item, stage: stage, piece: piece, member: member }, count_source: source }
}

fn piece_occurrences(item: RoadmapNodeId, stage: Nat, piece: Nat, p: WorkPiece, findings_count: Int) -> List<Occurrence> {
  match p {
    Leaf { label, days, evidence } => [ member_occurrence(item: item, stage: stage, piece: piece, member: Zero, source: Declared) ]
    Family { label, days, population, owner } =>
      if population_is_findings(p: population) {
        members_occurrences(item: item, stage: stage, piece: piece, first: 0, last: findings_count, index: Zero, source: Assumed)
      } else {
        members_occurrences(item: item, stage: stage, piece: piece, first: 0, last: population_members(p: population), index: Zero, source: Declared)
      }
    Join { label } => []
    Decision { label, alternatives } => []
    Composite { label, stages } => []
  }
}

// Walk a stage's pieces by Int index (for the Option-indexed read and the bound), carrying the piece index
// that KEYS each occurrence as a Nat built by successor -- advanced only on a real piece so it stays the
// piece's position. No Int ever crosses into a Nat field.
fn stage_pieces_occurrences(item: RoadmapNodeId, stage: Nat, st: WorkStage, piece_index: Int, piece_nat: Nat, findings_count: Int) -> List<Occurrence> {
  if piece_index >= count(st.pieces) {
    []
  } else {
    match st.pieces[piece_index] {
      Absent => stage_pieces_occurrences(item: item, stage: stage, st: st, piece_index: piece_index + 1, piece_nat: piece_nat, findings_count: findings_count)
      Present { value: p } => concat(
        piece_occurrences(item: item, stage: stage, piece: piece_nat, p: p, findings_count: findings_count),
        stage_pieces_occurrences(item: item, stage: stage, st: st, piece_index: piece_index + 1, piece_nat: Succ { prev: piece_nat }, findings_count: findings_count),
      )
    }
  }
}

fn stage_occurrences(item: RoadmapNodeId, stage: Nat, st: WorkStage, findings_count: Int) -> List<Occurrence> {
  stage_pieces_occurrences(item: item, stage: stage, st: st, piece_index: 0, piece_nat: Zero, findings_count: findings_count)
}

fn stages_from_index_occurrences(d: WorkDecomposition, index: Int, stage_nat: Nat, findings_count: Int) -> List<Occurrence> {
  if index >= count(d.stages) {
    []
  } else {
    match d.stages[index] {
      Absent => stages_from_index_occurrences(d: d, index: index + 1, stage_nat: stage_nat, findings_count: findings_count)
      Present { value: st } => concat(
        stage_occurrences(item: d.node, stage: stage_nat, st: st, findings_count: findings_count),
        stages_from_index_occurrences(d: d, index: index + 1, stage_nat: Succ { prev: stage_nat }, findings_count: findings_count),
      )
    }
  }
}

fn all_occurrences(d: WorkDecomposition, findings_count: Int) -> List<Occurrence> {
  stages_from_index_occurrences(d: d, index: 0, stage_nat: Zero, findings_count: findings_count)
}

fn occurrences_at_stage(occs: List<Occurrence>, stage: Int) -> List<Occurrence> {
  filter(occs, o => nat_to_int(n: o.path.stage) == stage)
}

// The parent a waits_on row names must be uniquely decomposed for any occurrence at the waited-from stage to
// exist -- the SAME rule decomposition_has_leaf_path applies (count(decomposition_for) != 1 is no leaf),
// imported not re-derived (single_authority). dependency_is_well_formed bounds the stage index but not
// decomposition uniqueness, so expand_decomposition refuses on this separately rather than let the row's edges
// vanish silently.
fn parent_is_uniquely_decomposed(item: RoadmapNodeId) -> Bool {
  count(decomposition_for(node: item)) == 1
}

// A parent's occurrences at the waited-from Int stage, built exactly like every other occurrence -- over the
// parent's own decomposition, so the edge endpoint is a real occurrence path, never a separately-minted tuple
// (single_authority). The stage comparison runs in Int via nat_to_int. The unique-decomposition precondition is
// enforced upstream by every_waits_parent_decomposed, so the non-unique arm below is never reached in an
// admitted expansion.
fn parent_occurrences_at(item: RoadmapNodeId, from_stage: Int, findings_count: Int) -> List<Occurrence> {
  let ds = decomposition_for(node: item)
  if count(ds) == 1 {
    match ds[0] {
      Absent => []
      Present { value: pd } => filter(all_occurrences(d: pd, findings_count: findings_count), o => nat_to_int(n: o.path.stage) == from_stage)
    }
  } else {
    []
  }
}

fn every_waits_parent_decomposed(d: WorkDecomposition) -> Bool {
  all(d.waits_on, w => parent_is_uniquely_decomposed(item: w.item))
}

// Stage k depends on stage k-1: each occurrence at stage k waits on every occurrence at stage k-1.
fn stage_barrier_edges(occs: List<Occurrence>) -> List<OccurrenceEdge> {
  flat_map(occs, o =>
    if nat_to_int(n: o.path.stage) <= 0 {
      []
    } else {
      map(occurrences_at_stage(occs: occs, stage: nat_to_int(n: o.path.stage) - 1), u => OccurrenceEdge { from: u.path, to: o.path })
    }
  )
}

// Each waits_on row is aimed into the child's own stage: a child occurrence at the row's into_stage waits on
// every occurrence the named parent has at the row's from_stage. Both endpoints are REAL occurrence paths, never
// a separately-minted tuple (single_authority). Parent non-uniqueness is refused upstream by expand_decomposition.
fn waits_on_edges(d: WorkDecomposition, occs: List<Occurrence>, findings_count: Int) -> List<OccurrenceEdge> {
  flat_map(d.waits_on, w =>
    flat_map(occurrences_at_stage(occs: occs, stage: w.into_stage), c =>
      map(parent_occurrences_at(item: w.item, from_stage: w.from_stage, findings_count: findings_count), p => OccurrenceEdge { from: p.path, to: c.path })
    )
  )
}

// THE expansion. It asks the carrier's own well-formedness claim first (fail_closed, single_authority): when
// that claim refuses -- a stage dependency naming a stage its parent's decomposition does not have, or an
// undeclared edge -- the expansion refuses with the carrier's claim as the located cause, and re-checks no row.
// A non-positive findings count refuses: it would silently drop a FindingsOf family's assumed members. A
// waits_on naming a parent that is not uniquely decomposed refuses: its edge could not be aimed at a parent
// occurrence the carrier's own leaf rule admits (dependency_is_well_formed bounds the stage index but not
// decomposition uniqueness, so this is an added refusal, not a re-check). Only over an admitted decomposition
// does it read out the occurrences and their edges.
fn expand_decomposition(d: WorkDecomposition, findings_count: Int) -> Expansion {
  if !decomposition_dependencies_well_formed(d: d) {
    Refused { cause: "roadmap-schedule-leaf-expansion refuses: the carrier's decomposition_dependencies_well_formed claim rejects this decomposition (a stage dependency names a stage its parent's decomposition does not have)" }
  } else if findings_count <= 0 {
    Refused { cause: "roadmap-schedule-leaf-expansion refuses: a FindingsOf family's assumed count must be a positive simulation input, never a value that drops its members" }
  } else if !every_waits_parent_decomposed(d: d) {
    Refused { cause: "roadmap-schedule-leaf-expansion refuses: a waits_on row names a parent that is not uniquely decomposed, so its edge cannot be aimed at a parent occurrence the carrier's own leaf rule admits" }
  } else {
    let occs = all_occurrences(d: d, findings_count: findings_count)
    Expanded { occurrences: occs, edges: concat(stage_barrier_edges(occs: occs), waits_on_edges(d: d, occs: occs, findings_count: findings_count)) }
  }
}

fn is_expanded(e: Expansion) -> Bool {
  match e { Expanded { occurrences, edges } => true, Refused { cause } => false }
}

fn is_refused(e: Expansion) -> Bool {
  match e { Expanded { occurrences, edges } => false, Refused { cause } => true }
}

fn expanded_occurrences(e: Expansion) -> List<Occurrence> {
  match e { Expanded { occurrences, edges } => occurrences, Refused { cause } => [] }
}

fn expanded_edges(e: Expansion) -> List<OccurrenceEdge> {
  match e { Expanded { occurrences, edges } => edges, Refused { cause } => [] }
}

fn occurrence_is_declared(o: Occurrence) -> Bool {
  o.count_source == Declared
}

fn occurrence_is_assumed(o: Occurrence) -> Bool {
  o.count_source == Assumed
}

// An occurrence is OFFERED CLAIMABLE under a policy DISTINCT from "its count is declared": it may be offered
// only when its count is DECLARED *and* its path actually resolves under the carrier's own
// decomposition_has_leaf_path. This is deliberately not a rename of occurrence_is_declared -- an ASSUMED
// FindingsOf member is not declared (so not offered), and a declared member whose index the carrier does not
// acknowledge is likewise not offered. It composes existing authority (the carrier's leaf predicate) rather
// than restating it.
fn occurrence_is_offered_claimable(o: Occurrence) -> Bool {
  occurrence_is_declared(o: o) && decomposition_has_leaf_path(path: o.path)
}
