module gunbc.roadmap.roadmap_decomposition

import std.types { String, Int, Bool, List, Map }
import std.integer { nat_to_int }
import std.checked_arithmetic { checked_int_to_nat }
import std.optional { Optional }
import std.nat { Nat, Zero, Succ }
import std.algebra { Cons, Empty, empty_map, map_insert, map_lookup }
import std.decl_ref { DeclarationRef, decl_ref }
import gunbc.roadmap.roadmap_model { RoadmapNodeId, LeafPath, ClaimGrain, Pathless, AtPath }

import gunbc.roadmap.roadmap_authority { declared_roadmap_nodes, declared_roadmap_edges, nid }

// THE RECURSIVE DECOMPOSITION OF EVERY OPEN BOUND WORK ITEM, DONE UP FRONT (operator, 2026-11-17: "basically i'm
// asking us to recursively decompose the tasks up front/now"; "the units of work being sized for a worker node";
// "honest accounting at a unit level is all that should matter"). A work item is a roadmap node; it opens into
// STAGES (a stage waits on the stage before it), a stage into PIECES that may run in parallel, and a piece is one
// of four executable forms, or a composite with stages of its own (second reading, 2026-11-17, after the external
// recut review: four forms, populations as producers, witnesses bound by citation, stage-level dependencies):
//
//   Leaf      one worker, one subject, one pull request, one observable named in its label; at most leaf_days_max
//             working days. A leaf whose evidence RunsWitness cites the existing claim it executes: a green run
//             closes the clause only when the receipt establishes that the witness's subject is the handback's
//             subject (same route, source head, producer, member population); otherwise it is a probe whose typed
//             findings populate a family. The emitter door is the cautionary case: its closing claim was green
//             for months over an in-memory string while the handback promised a written, compiled artifact.
//   Family    one leaf per member of a population. Produced cites the in-tree declaration whose members they are,
//             with a dated reading of the count; Reading is an off-tree measurement whose basis is named and whose
//             trigger is to home its producer (the hand-kept arm, meant to disappear); FindingsOf carries no count
//             at all: its members are the typed findings of a probe leaf in the same item, and that is where a
//             replan happens. A family is charged to its OWNER, which is the item unless the work decides meaning
//             elsewhere: declaring a name's home is the semantic authority's work, visible under the namespace
//             campaign and charged once (one-standard-library today; operations-are-declarations and
//             one-text-carrier as their classification lands).
//   Join      zero work; reads the required receipts.
//   Decision  an operator (or delegated acceptor) chooses among closed alternatives and records the ruling.
//
// DEPENDENCIES ARE STAGE-LEVEL. A decomposition names, for each open parent in gunbc.roadmap.roadmap_authority's
// edges, which of the parent's stages it consumes and into which of its own stages: the default is the parent's
// last stage into stage 0 (the whole parent), and an item whose partial handback is independently meaningful
// exposes it (native-seven's typed stage is what second-generation consumes; its executed stage waits on the
// native test verdict). Every open parent has a row, so a child cannot silently stop waiting.
//
// WHAT THIS IS NOT. Not a second roadmap: a leaf has no identity, owner or event log until a worker claims it, and
// the claim then names its item and its path here. Not a schedule: no leaf carries a date
// (gunbc.design_ruling planning_scheduling_is_cut). Not a count the tree must keep: a realized claimed-to-accepted
// duration replaces a leaf's days when it lands, a Produced reading is refreshed from its producer, and a Reading
// retires when its producer is homed. Per-name day counts are priors for the first calibration batch (ten
// native-seven names, stratified by whether a compatible home exists, a signature must be reconciled, or the name
// is an operation or sugar), not measurements.

type Population
  = Produced { producer: DeclarationRef, members: Int, on: String }
  | Reading { members: Int, on: String, basis: String }
  | FindingsOf { probe: String }

type Evidence
  = Builds
  | RunsWitness { witness: DeclarationRef }

// `days` on a Leaf or a Family is a count of WORKING DAYS -- a duration -- carried as a bare
// Int. std.measure has no working-day/effort family: its Time dimension counts SI seconds and its
// CalendarDayDisplacement (:1870) counts CALENDAR-day displacements, and neither is a working-day
// effort prior (a working-day count "fits neither type exactly"), so wrapping these would be a
// fabricated value wearing a unit, not a conversion. gunbc.design_ruling::planning_scheduling_is_cut
// forbids a schedule/effort type here, and these figures are documented priors, not measurements
// (see the calibration note above). The field name carries the unit until the carrier grows.
// feature:working-day-prior-carrier -- dissolve-on: std.measure grows a working-day (effort) family;
// Leaf.days and Family.days become its alias. Owning lane: std.measure.
type WorkPiece
  = Leaf { label: String, days: Int, evidence: Evidence }
  | Family { label: String, days: Int, population: Population, owner: RoadmapNodeId }
  | Join { label: String }
  | Decision { label: String, alternatives: List<String> }
  | Composite { label: String, stages: List<WorkStage> }

type WorkStage { pieces: List<WorkPiece> }

// The KIND of a top-level WorkPiece, as a TYPED closed set -- the one projection of the WorkPiece coproduct used
// wherever only the kind matters (an unresolved-wait report says WHICH kinds filled an occurrence-less span). It is
// NOT a String: the labels are the coproduct's own constructors, so renaming or adding a WorkPiece variant breaks the
// TOTAL piece_kind match below at compile time rather than leaving stale text behind (single_authority, minimize_redundancy:
// a closed set gets one spelling). piece_kind is the ONLY producer; piece_kinds_equal is the ONLY comparator.
type PieceKind = LeafKind | FamilyKind | JoinKind | DecisionKind | CompositeKind

type StageDependency {
  item: RoadmapNodeId
  from_stage: Int
  into_stage: Int
}

type WorkDecomposition {
  node: RoadmapNodeId
  waits_on: List<StageDependency>
  stages: List<WorkStage>
}

// THE LEAF PATH (type LeafPath) lives in gunbc.roadmap.roadmap_model, imported above: it is named by
// both the record (roadmap_event_log's Claimed grain) and this carrier's authority, and neither may
// import the other, so it sits in the model below both. `decomposition_has_leaf_path` below, over that
// imported type, is THE authority for "is this a leaf of this item"; nothing else defines a leaf path.
// The ordered EXPANSION of a decomposition into occurrences over that same type is the schedule lane's
// work, built on it -- not a second definition of it.

// Same working-day prior unit as WorkPiece.days: leaf_days_max is the leaf-rule ceiling and
// decision_days the cost of a decision point, both in working days, held as bare Int.
// feature:working-day-prior-carrier -- dissolve-on: std.measure grows a working-day (effort) family.
// Owning lane: std.measure.
data leaf_days_max: Int = 5
data decision_days: Int = 1

// The `days: Int` parameter on each constructor below is the same working-day prior as
// WorkPiece.days (see the marker there).
// feature:working-day-prior-carrier -- dissolve-on: std.measure grows a working-day (effort) family.
// Owning lane: std.measure.
fn leaf(label: String, days: Int) -> WorkPiece { Leaf { label: label, days: days, evidence: Builds } }

fn probe(label: String, days: Int, module_path: String, decl_name: String) -> WorkPiece {
  Leaf { label: label, days: days, evidence: RunsWitness { witness: decl_ref(module_path: module_path, decl_name: decl_name) } }
}

fn produced_family(label: String, days: Int, members: Int, on: String, module_path: String, decl_name: String, owner: String) -> WorkPiece {
  Family { label: label, days: days, population: Produced { producer: decl_ref(module_path: module_path, decl_name: decl_name), members: members, on: on }, owner: nid(s: owner) }
}

fn reading_family(label: String, days: Int, members: Int, on: String, basis: String, owner: String) -> WorkPiece {
  Family { label: label, days: days, population: Reading { members: members, on: on, basis: basis }, owner: nid(s: owner) }
}

fn findings_family(label: String, days: Int, probe: String, owner: String) -> WorkPiece {
  Family { label: label, days: days, population: FindingsOf { probe: probe }, owner: nid(s: owner) }
}

fn join(label: String) -> WorkPiece { Join { label: label } }

fn decision(label: String, alternatives: List<String>) -> WorkPiece { Decision { label: label, alternatives: alternatives } }

fn stages_of(stages: List<List<WorkPiece>>) -> List<WorkStage> {
  fold(stages, init: [], f: fn(acc, s) { concat(acc, [WorkStage { pieces: s }]) })
}

fn piece(label: String, stages: List<List<WorkPiece>>) -> WorkPiece { Composite { label: label, stages: stages_of(stages: stages) } }

fn waits(item: String, from_stage: Int, into_stage: Int) -> StageDependency {
  StageDependency { item: nid(s: item), from_stage: from_stage, into_stage: into_stage }
}

fn decomposition(node: String, waits_on: List<StageDependency>, stages: List<List<WorkPiece>>) -> WorkDecomposition {
  WorkDecomposition { node: nid(s: node), waits_on: waits_on, stages: stages_of(stages: stages) }
}

// ---- folds over a piece: counted members (a FindingsOf family counts as one leaf, its population being unknown)
fn population_members(p: Population) -> Int {
  match p {
    Produced { producer, members, on } => members
    Reading { members, on, basis } => members
    FindingsOf { probe } => 1
  }
}

fn population_is_findings(p: Population) -> Bool {
  match p {
    Produced { producer, members, on } => false
    Reading { members, on, basis } => false
    FindingsOf { probe } => true
  }
}

fn piece_leaf_count(p: WorkPiece) -> Int {
  match p {
    Leaf { label, days, evidence } => 1
    Family { label, days, population, owner } => population_members(p: population)
    Join { label } => 0
    Decision { label, alternatives } => 1
    Composite { label, stages } => stages_leaf_count(stages: stages)
  }
}

fn stages_leaf_count(stages: List<WorkStage>) -> Int {
  fold(stages, init: 0, f: fn(acc, s) { acc + fold(s.pieces, init: 0, f: fn(a, p) { a + piece_leaf_count(p: p) }) })
}

fn piece_leaf_days(p: WorkPiece) -> Int {
  match p {
    Leaf { label, days, evidence } => days
    Family { label, days, population, owner } => days * population_members(p: population)
    Join { label } => 0
    Decision { label, alternatives } => decision_days
    Composite { label, stages } => stages_leaf_days(stages: stages)
  }
}

fn stages_leaf_days(stages: List<WorkStage>) -> Int {
  fold(stages, init: 0, f: fn(acc, s) { acc + fold(s.pieces, init: 0, f: fn(a, p) { a + piece_leaf_days(p: p) }) })
}

fn piece_findings_families(p: WorkPiece) -> Int {
  match p {
    Leaf { label, days, evidence } => 0
    Family { label, days, population, owner } => if population_is_findings(p: population) { 1 } else { 0 }
    Join { label } => 0
    Decision { label, alternatives } => 0
    Composite { label, stages } => stages_findings_families(stages: stages)
  }
}

fn stages_findings_families(stages: List<WorkStage>) -> Int {
  fold(stages, init: 0, f: fn(acc, s) { acc + fold(s.pieces, init: 0, f: fn(a, p) { a + piece_findings_families(p: p) }) })
}

// THE LEAF RULE at every depth: a leaf, and a family's per-member work, within leaf_days_max.
fn piece_leaf_days_within(p: WorkPiece) -> Bool {
  match p {
    Leaf { label, days, evidence } => days >= 1 && days <= leaf_days_max
    Family { label, days, population, owner } => days >= 1 && days <= leaf_days_max
    Join { label } => true
    Decision { label, alternatives } => count(alternatives) >= 2
    Composite { label, stages } => stages_leaf_days_within(stages: stages)
  }
}

fn stages_leaf_days_within(stages: List<WorkStage>) -> Bool {
  all(stages, s => all(s.pieces, p => piece_leaf_days_within(p: p)))
}

// NO EMPTY STAGE AND NO EMPTY COMPOSITE: an empty stage would be a free day in the simulation.
fn piece_stages_nonempty(p: WorkPiece) -> Bool {
  match p {
    Leaf { label, days, evidence } => true
    Family { label, days, population, owner } => population_members(p: population) >= 1
    Join { label } => true
    Decision { label, alternatives } => true
    Composite { label, stages } => count(stages) >= 1 && stages_nonempty(stages: stages)
  }
}

fn stages_nonempty(stages: List<WorkStage>) -> Bool {
  all(stages, s => count(s.pieces) >= 1 && all(s.pieces, p => piece_stages_nonempty(p: p)))
}

// A FINDINGS FAMILY NAMES A PROBE LEAF OF ITS OWN ITEM: the population it will have is that leaf's typed findings.
fn piece_leaf_labels(p: WorkPiece) -> List<String> {
  match p {
    Leaf { label, days, evidence } => [label]
    Family { label, days, population, owner } => []
    Join { label } => []
    Decision { label, alternatives } => []
    Composite { label, stages } => stages_leaf_labels(stages: stages)
  }
}

fn stages_leaf_labels(stages: List<WorkStage>) -> List<String> {
  fold(stages, init: [], f: fn(acc, s) { concat(acc, fold(s.pieces, init: [], f: fn(a, p) { concat(a, piece_leaf_labels(p: p)) })) })
}

fn piece_findings_probes(p: WorkPiece) -> List<String> {
  match p {
    Leaf { label, days, evidence } => []
    Family { label, days, population, owner } => population_probe(p: population)
    Join { label } => []
    Decision { label, alternatives } => []
    Composite { label, stages } => stages_findings_probes(stages: stages)
  }
}

fn population_probe(p: Population) -> List<String> {
  match p {
    Produced { producer, members, on } => []
    Reading { members, on, basis } => []
    FindingsOf { probe } => [probe]
  }
}

fn stages_findings_probes(stages: List<WorkStage>) -> List<String> {
  fold(stages, init: [], f: fn(acc, s) { concat(acc, fold(s.pieces, init: [], f: fn(a, p) { concat(a, piece_findings_probes(p: p)) })) })
}

fn decomposition_findings_probes_exist(d: WorkDecomposition) -> Bool {
  let labels = stages_leaf_labels(stages: d.stages)
  all(stages_findings_probes(stages: d.stages), probe => count(filter(labels, l => l == probe)) == 1)
}

fn decompositions_findings_probes_exist() -> Bool {
  all(roadmap_decompositions, d => decomposition_findings_probes_exist(d: d))
}

// A FAMILY'S OWNER IS A DECLARED NODE.
fn piece_owners(p: WorkPiece) -> List<RoadmapNodeId> {
  match p {
    Leaf { label, days, evidence } => []
    Family { label, days, population, owner } => [owner]
    Join { label } => []
    Decision { label, alternatives } => []
    Composite { label, stages } => stages_owners(stages: stages)
  }
}

fn stages_owners(stages: List<WorkStage>) -> List<RoadmapNodeId> {
  fold(stages, init: [], f: fn(acc, s) { concat(acc, fold(s.pieces, init: [], f: fn(a, p) { concat(a, piece_owners(p: p)) })) })
}

fn node_is_declared(node: RoadmapNodeId) -> Bool {
  count(filter(declared_roadmap_nodes(), n => n.node == node)) == 1
}

fn decompositions_owners_declared() -> Bool {
  all(roadmap_decompositions, d => all(stages_owners(stages: d.stages), o => node_is_declared(node: o)))
}

// STAGE DEPENDENCIES: each row names a declared parent edge, a stage the parent has, and a stage this item has;
// and every parent that has a decomposition of its own is waited on at least once.
fn decomposition_for(node: RoadmapNodeId) -> List<WorkDecomposition> {
  filter(roadmap_decompositions, d => d.node == node)
}

// THE ONE leaf-path check: does the item's decomposition hold a leaf at this path, at its declared
// count? A plain Leaf is one occurrence at member 0. A Family admits a member only when its population
// is PRODUCED or READ with a declared count and the member index lies within it. A FindingsOf family
// carries no count of its own -- its members are findings the probe produces -- so a member index names
// a leaf there ONLY once that population is produced or read; until then the path resolves to no leaf
// and refuses. A Join is zero work, a Decision an operator choice, and a Composite a container addressed
// deeper than this path reaches: none is a leaf a worker claims. An out-of-range index has no element and
// refuses, and a negative index is unwritable in `LeafPath` rather than rejected here; an item without
// exactly one decomposition refuses. Consumers -- the Claimed append route -- call THIS rather than
// re-deriving the spelling (single_authority: import the row, do not copy it).
fn decomposition_has_leaf_path(path: LeafPath) -> Bool {
  // The path's indexes are Nat (a negative leaf index is unwritable, not caught here); the list
  // read below is indexed by Int, so each index crosses once, total and exact, via nat_to_int.
  let stage_index: Int = nat_to_int(n: path.stage)
  let piece_index: Int = nat_to_int(n: path.piece)
  let member_index: Int = nat_to_int(n: path.member)
  let ds = decomposition_for(node: path.item)
  if count(ds) != 1 {
    false
  } else {
    match ds[0] {
      Absent => false
      Present { value: d } => match d.stages[stage_index] {
        Absent => false
        Present { value: st } => match st.pieces[piece_index] {
          Absent => false
          Present { value: pc } => match pc {
            Leaf { label, days, evidence } => member_index == 0
            Family { label, days, population, owner } =>
              if population_is_findings(p: population) {
                false
              } else {
                member_index < population_members(p: population)
              }
            Join { label } => false
            Decision { label, alternatives } => false
            Composite { label, stages } => false
          }
        }
      }
    }
  }
}

// THE APPEND-TIME GUARD: the ONE place that decides whether a Claimed of a given GRAIN may be recorded
// against `node`. It lives here, beside decomposition_has_leaf_path -- the leaf authority -- so the well-
// formedness judgment is never re-spelled at a call site (single_authority: consumers import this one
// check, they do not copy it). The minting producers that can reach it (roadmap_event_cli, roadmap_serve)
// route a Claimed through it before appending; roadmap_issue_command cannot import it (cycle:
// roadmap_authority imports this module which imports roadmap_event_log which roadmap_issue_command imports).
// The two decode sites never mint, so they never call it.
//
// The decision is by decomposition COUNT, read through decomposition_for (the carrier's own authority),
// exactly as the operator ruled (2026-11-18): a count of 0 means there is no leaf to name, so a Pathless
// is admitted and a Leaf names a path in nothing (refused, leaf-path-unknown); a count of 1 applies the
// first-landing ruling -- a Claimed must name a leaf (Pathless refused), the leaf must belong to THIS
// item (else leaf-wrong-item), and it must be a leaf the decomposition actually has (else leaf-path-
// unknown); a count above 1 is ambiguous and refuses EVERY Claimed with a typed decomposition-ambiguous
// reason -- the guard never silently picks one decomposition to check against. Every refusal is typed
// (fail_closed), never a boolean that a caller could invert or ignore. The CLI front-end computes this
// verdict BEFORE appending (kinds that carry no grain skip it), so the append and exit block is one
// block, not a copy per grain branch (minimize_redundancy).
type ClaimedGrainRefusal
  = LeafPathUnknown { path: LeafPath }
  | LeafWrongItem { path: LeafPath, expected: RoadmapNodeId }
  | PathlessOnDecomposed { node: RoadmapNodeId }
  | DecompositionAmbiguous { node: RoadmapNodeId, count: Int }

type ClaimedGrainVerdict
  = Admitted { grain: ClaimGrain }
  | Refused { reason: ClaimedGrainRefusal }

fn roadmap_claimed_grain_admissible(node: RoadmapNodeId, grain: ClaimGrain) -> ClaimedGrainVerdict {
  let ds = decomposition_for(node: node)
  let c = count(ds)
  if c > 1 {
    Refused { reason: DecompositionAmbiguous { node: node, count: c } }
  } else if c == 0 {
    match grain {
      Pathless => Admitted { grain: Pathless }
      AtPath { path } => Refused { reason: LeafPathUnknown { path: path } }
    }
  } else {
    match grain {
      Pathless => Refused { reason: PathlessOnDecomposed { node: node } }
      AtPath { path } =>
        if path.item != node {
          Refused { reason: LeafWrongItem { path: path, expected: node } }
        } else if decomposition_has_leaf_path(path: path) {
          Admitted { grain: grain }
        } else {
          Refused { reason: LeafPathUnknown { path: path } }
        }
    }
  }
}

// Render the guard's typed refusal as a human-readable string. The CLI and the served route both
// call this so the ruled reason appears identically no matter which front-end is refused.
fn roadmap_claimed_grain_refusal_text(reason: ClaimedGrainRefusal) -> String {
  match reason {
    LeafPathUnknown { path } => "the claimed leaf stage/" + to_string(value: nat_to_int(n: path.stage)) + "/" + to_string(value: nat_to_int(n: path.piece)) + "/" + to_string(value: nat_to_int(n: path.member)) + " is not a leaf the item's decomposition has"
    LeafWrongItem { path, expected } => "the claimed leaf names item '" + (path.item as String) + "' but the claim is being recorded against '" + (expected as String) + "'"
    PathlessOnDecomposed { node } => "the item '" + (node as String) + "' has a decomposition, so its claim must name a leaf (a whole-item claim is refused from the first landing)"
    DecompositionAmbiguous { node, count } => "the item '" + (node as String) + "' has " + to_string(value: count) + " decompositions; a claim is refused until exactly one is declared"
  }
}

fn parent_stage_count(item: RoadmapNodeId) -> Int {
  fold(decomposition_for(node: item), init: 0, f: fn(acc, d) { acc + count(d.stages) })
}

fn dependency_is_well_formed(d: WorkDecomposition, w: StageDependency) -> Bool {
  count(filter(declared_roadmap_edges(), e => e.child == d.node && e.parent == w.item)) == 1
    && w.from_stage >= 0 && w.from_stage < parent_stage_count(item: w.item)
    && w.into_stage >= 0 && w.into_stage < count(d.stages)
}

fn decomposition_dependencies_well_formed(d: WorkDecomposition) -> Bool {
  all(d.waits_on, w => dependency_is_well_formed(d: d, w: w))
}

fn decompositions_dependencies_well_formed() -> Bool {
  all(roadmap_decompositions, d => decomposition_dependencies_well_formed(d: d))
}

fn decomposition_waits_on_every_decomposed_parent(d: WorkDecomposition) -> Bool {
  let parents = declared_roadmap_edges() |> filter(e => e.child == d.node) |> map(e => e.parent)
  all(parents, p => count(decomposition_for(node: p)) == 0 || count(filter(d.waits_on, w => w.item == p)) >= 1)
}

fn decompositions_wait_on_every_decomposed_parent() -> Bool {
  all(roadmap_decompositions, d => decomposition_waits_on_every_decomposed_parent(d: d))
}

fn decomposition_has_node(d: WorkDecomposition) -> Bool { node_is_declared(node: d.node) }

fn decompositions_all_have_nodes() -> Bool { all(roadmap_decompositions, d => decomposition_has_node(d: d)) }

fn decomposition_nodes_unique() -> Bool {
  all(roadmap_decompositions, d => count(filter(roadmap_decompositions, e => e.node == d.node)) == 1)
}

fn decompositions_leaf_days_bounded() -> Bool { all(roadmap_decompositions, d => stages_leaf_days_within(stages: d.stages)) }

fn decompositions_stages_nonempty() -> Bool { all(roadmap_decompositions, d => count(d.stages) >= 1 && stages_nonempty(stages: d.stages)) }

fn decomposition_leaf_count() -> Int { fold(roadmap_decompositions, init: 0, f: fn(acc, d) { acc + stages_leaf_count(stages: d.stages) }) }

fn decomposition_leaf_days() -> Int { fold(roadmap_decompositions, init: 0, f: fn(acc, d) { acc + stages_leaf_days(stages: d.stages) }) }

fn decomposition_findings_families() -> Int { fold(roadmap_decompositions, init: 0, f: fn(acc, d) { acc + stages_findings_families(stages: d.stages) }) }

data roadmap_decompositions: List<WorkDecomposition> = [
  decomposition(node: "namespace-reference-derived-closure", waits_on: [
  ], stages: [
    [
      leaf(label: "one module: closure from qualified refs equals its import-list closure", days: 5),
    ],
    [
      leaf(label: "pool-independence arm on one real module", days: 5),
      piece(label: "generated demands enter the closure", stages: [
        [
          leaf(label: "list the generated-provider demand kinds (probe)", days: 2),
        ],
        [
          findings_family(label: "one demand kind enters the closure, claim green", days: 2, probe: "list the generated-provider demand kinds (probe)", owner: "namespace-reference-derived-closure"),
        ],
      ]),
    ],
    [
      reading_family(label: "remaining arm of the acceptance witness", days: 5, members: 4, on: "2026-11-17", basis: "the four arms named in the acceptance witness text", owner: "namespace-reference-derived-closure"),
    ],
  ]),
  decomposition(node: "namespace-reference-derived-producer-bounded", waits_on: [
  ], stages: [
    [
      piece(label: "the producer reads a name table, not the pool", stages: [
        [
          leaf(label: "name table carrier: qualified path to declaration, built once from the universe", days: 5),
        ],
        [
          leaf(label: "producer reads the table; same edges on the N7 closure", days: 5),
        ],
        [
          leaf(label: "old pool path deleted; unknown path refuses", days: 3),
          leaf(label: "pool-independence claim green", days: 2),
        ],
      ]),
    ],
    [
      leaf(label: "before/after edge equivalence over the N7 closure", days: 5),
      leaf(label: "residency qualification by invocation", days: 5),
    ],
