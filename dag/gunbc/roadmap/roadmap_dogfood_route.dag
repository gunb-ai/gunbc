// THE DOGFOOD ROUTE, AS ONE ACCEPTANCE CASE (operator ruling 2026-10-03). A request enters the
// factory and leaves as an independently reviewed, published candidate. Every stage is established
// by its OWN typed record, read from the same evidence observation the dashboard reduces (gunbc.
// roadmap_belt_actuate belt_workflow_attempt_evidence_for_ref), and the first attempt to complete
// is recorded once, durably, as the dogfood start receipt.
//
// THE ROUTE IS DECLARED IN PRODUCTION ORDER. The belt reviews a head after verification and
// publishes it only when the review (and goal audit) approved that head (belt_review_admission
// beside belt_publish_gate), so review precedes publication, and that is the order here. The
// causal binding is the head: the submission, the review and the publication receipt all speak of
// the attempt's one worktree head, and the publication evidence is admitted only when its receipt's
// expected head IS the captured submission's head.
type DogfoodStage
  = DogfoodRequest
  | DogfoodImmutableSubject
  | DogfoodSharedComputation
  | DogfoodPlacementGrant
  | DogfoodIsolatedExecution
  | DogfoodDurableResult
  | DogfoodMetering
  | DogfoodIndependentReview
  | DogfoodCandidatePublished
  | DogfoodCleanup
  | DogfoodResultReturned

fn dogfood_stage_wire(stage: DogfoodStage) -> String {
  match stage {
    DogfoodRequest => "request"
    DogfoodImmutableSubject => "immutable-subject"
    DogfoodSharedComputation => "shared-computation"
    DogfoodPlacementGrant => "placement-grant"
    DogfoodIsolatedExecution => "isolated-execution"
    DogfoodDurableResult => "durable-result"
    DogfoodMetering => "metering"
    DogfoodIndependentReview => "independent-review"
    DogfoodCandidatePublished => "candidate-published"
    DogfoodCleanup => "cleanup"
    DogfoodResultReturned => "result-returned"
  }
}

// ── STAGE-SPECIFIC EVIDENCE ─────────────────────────────────────────────────────────────────────
//
// Each established stage carries its own evidence type, constructible only here and only from the
// producer's decoded record, so one record cannot stand for two stages: a review report cannot be
// placed where the submission goes, and no caller can mint evidence from prose.
type SubmissionEvidence sole_constructor {
  attempt_key: String
  head_sha: String
  digest: String
}

type ReviewEvidence sole_constructor {
  subject: String
  plan_revision: String
}

type PublicationEvidence sole_constructor {
  head_sha: String
  pr_number: Int
  url: String
}

// THE SESSION'S PLACEMENT GRANT, from the placement record gunbc.roadmap_session_placement
// session_placement_observe_for_attempt has already bound to this node, attempt, host and unit.
type PlacementGrantEvidence sole_constructor {
  host: String
  unit: String
  grant_identity: String
  fence_generation: Nat
}

// THE SESSION'S RELEASE, from a release record the same reader bound to the grant and fence above.
type CleanupEvidence sole_constructor {
  grant_identity: String
  fence_generation: Nat
  outcome: String
  reason: String
}

// THE REQUEST: the claim the attempt's create-only request record binds (G4, gunbc#13075), so the
// attempt answers exactly the request that caused its dispatch.
type RequestEvidence sole_constructor {
  claim: String
}

// THE RESULT RETURNED to that requester: the ResultReturned event the production reader binds to
// this attempt's recorded claim, publishing a pull request at a head.
type ResultReturnedEvidence sole_constructor {
  event: String
  claim: String
  head: String
  pr: String
  recorded_at: String
}

// THE METERING: a Final per-attempt metering record's totals (G3, gunbc#13073); a provisional record
// is not metering of a finished attempt.
type MeteringEvidence sole_constructor {
  input_tokens: TokenCount
  output_tokens: TokenCount
  seat_time: Second
  compute: ComputeUsage
}

fn dogfood_compute_word(c: ComputeUsage) -> String {
  match c {
    ComputeNotAttributable { reason: _ } => "not-attributable"
  }
}

type StageGap
  = StageOwed { owed_by: String }
  | StageRefused { reason: String }

type SubmissionReading
  = SubmissionEstablished { evidence: SubmissionEvidence }
  | SubmissionGap { gap: StageGap }

type ReviewReading
  = ReviewEstablished { evidence: ReviewEvidence }
  | ReviewGap { gap: StageGap }

type PublicationReading
  = PublicationEstablished { evidence: PublicationEvidence }
  | PublicationGap { gap: StageGap }

type PlacementGrantReading
  = PlacementGrantEstablished { evidence: PlacementGrantEvidence }
  | PlacementGrantGap { gap: StageGap }

type CleanupReading
  = CleanupEstablished { evidence: CleanupEvidence }
  | CleanupGap { gap: StageGap }

type RequestReading
  = RequestEstablished { evidence: RequestEvidence }
  | RequestGap { gap: StageGap }

type ResultReturnedReading
  = ResultReturnedEstablished { evidence: ResultReturnedEvidence }
  | ResultReturnedGap { gap: StageGap }

type MeteringReading
  = MeteringEstablished { evidence: MeteringEvidence }
  | MeteringGap { gap: StageGap }

// A STAGE WITH NO PRODUCER YET HAS NO ESTABLISHED ARM AT ALL. When its producer lands it gains its
// own evidence type and reading, exactly as the three above; until then nothing can claim it.
type ProducerPendingReading
  = ProducerPending { owed_by: String }

// ONE FIELD PER STAGE, each of its own reading type.
type DogfoodStageReadings {
  request: RequestReading
  immutable_subject: ProducerPendingReading
  shared_computation: ProducerPendingReading
  placement_grant: PlacementGrantReading
  isolated_execution: ProducerPendingReading
  durable_result: SubmissionReading
  metering: MeteringReading
  independent_review: ReviewReading
  candidate_published: PublicationReading
  cleanup: CleanupReading
  result_returned: ResultReturnedReading
}

// COMPLETE CARRIES THE EVIDENCE, NOT A FLAG. The arm is built only by dogfood_route_receipt, and only
// when every stage is established -- which, while any stage has no producer, it cannot be.
type DogfoodRouteReceipt
  = DogfoodRouteComplete { node_id: String, attempt_key: String, request: RequestEvidence, placement: PlacementGrantEvidence, submission: SubmissionEvidence, metering: MeteringEvidence, review: ReviewEvidence, publication: PublicationEvidence, cleanup: CleanupEvidence, result_returned: ResultReturnedEvidence }
  | DogfoodRouteIncomplete { node_id: String, attempt_key: String, owed: List<DogfoodStage>, refused: List<DogfoodStage> }

type DogfoodStageGaps {
  owed: List<DogfoodStage>
  refused: List<DogfoodStage>
}

fn dogfood_gap(acc: DogfoodStageGaps, stage: DogfoodStage, gap: StageGap) -> DogfoodStageGaps {
  match gap {
    StageOwed { owed_by: _ } => DogfoodStageGaps { owed: concat(acc.owed, [stage]), refused: acc.refused }
    StageRefused { reason: _ } => DogfoodStageGaps { owed: acc.owed, refused: concat(acc.refused, [stage]) }
  }
}

fn dogfood_pending(acc: DogfoodStageGaps, stage: DogfoodStage, r: ProducerPendingReading) -> DogfoodStageGaps {
  match r {
    ProducerPending { owed_by: _ } => DogfoodStageGaps { owed: concat(acc.owed, [stage]), refused: acc.refused }
  }
}

fn dogfood_route_receipt(node_id: String, attempt_key: String, r: DogfoodStageReadings) -> DogfoodRouteReceipt {
  let g0 = DogfoodStageGaps { owed: [], refused: [] }
  let g1 = match r.request {
    RequestEstablished { evidence: _ } => g0
    RequestGap { gap } => dogfood_gap(acc: g0, stage: DogfoodRequest, gap: gap)
  }
  let g2 = dogfood_pending(acc: g1, stage: DogfoodImmutableSubject, r: r.immutable_subject)
  let g3 = dogfood_pending(acc: g2, stage: DogfoodSharedComputation, r: r.shared_computation)
  let g4 = match r.placement_grant {
    PlacementGrantEstablished { evidence: _ } => g3
    PlacementGrantGap { gap } => dogfood_gap(acc: g3, stage: DogfoodPlacementGrant, gap: gap)
  }
  let g5 = dogfood_pending(acc: g4, stage: DogfoodIsolatedExecution, r: r.isolated_execution)
  let g6 = match r.durable_result {
    SubmissionEstablished { evidence: _ } => g5
    SubmissionGap { gap } => dogfood_gap(acc: g5, stage: DogfoodDurableResult, gap: gap)
  }
  let g7 = match r.metering {
    MeteringEstablished { evidence: _ } => g6
    MeteringGap { gap } => dogfood_gap(acc: g6, stage: DogfoodMetering, gap: gap)
  }
  let g8 = match r.independent_review {
    ReviewEstablished { evidence: _ } => g7
    ReviewGap { gap } => dogfood_gap(acc: g7, stage: DogfoodIndependentReview, gap: gap)
  }
  let g9 = match r.candidate_published {
    PublicationEstablished { evidence: _ } => g8
    PublicationGap { gap } => dogfood_gap(acc: g8, stage: DogfoodCandidatePublished, gap: gap)
  }
  let g10 = match r.cleanup {
    CleanupEstablished { evidence: _ } => g9
    CleanupGap { gap } => dogfood_gap(acc: g9, stage: DogfoodCleanup, gap: gap)
  }
  let gaps = match r.result_returned {
    ResultReturnedEstablished { evidence: _ } => g10
    ResultReturnedGap { gap } => dogfood_gap(acc: g10, stage: DogfoodResultReturned, gap: gap)
  }
  if length(gaps.owed) == 0 && length(gaps.refused) == 0 {
    match dogfood_route_carried(r: r) {
      Absent => DogfoodRouteIncomplete { node_id: node_id, attempt_key: attempt_key, owed: gaps.owed, refused: gaps.refused }
      Present { value: c } => dogfood_route_complete_of(node_id: node_id, attempt_key: attempt_key, c: c)
    }
  } else {
    DogfoodRouteIncomplete { node_id: node_id, attempt_key: attempt_key, owed: gaps.owed, refused: gaps.refused }
  }
}

// THE ESTABLISHED EVIDENCE THE COMPLETE ARM CARRIES, gathered only when every produced stage holds
// its evidence; any gap yields none.
type DogfoodCarried {
  request: RequestEvidence
  placement: PlacementGrantEvidence
  submission: SubmissionEvidence
  metering: MeteringEvidence
  review: ReviewEvidence
  publication: PublicationEvidence
  cleanup: CleanupEvidence
  result_returned: ResultReturnedEvidence
}

// CLEANUP MUST RETURN THE GRANT THAT WAS PLACED: a release of another grant or fence is a refused
// cleanup, never a completion.
fn dogfood_route_complete_of(node_id: String, attempt_key: String, c: DogfoodCarried) -> DogfoodRouteReceipt {
  if c.cleanup.grant_identity != c.placement.grant_identity || c.cleanup.fence_generation != c.placement.fence_generation {
    DogfoodRouteIncomplete { node_id: node_id, attempt_key: attempt_key, owed: [], refused: [DogfoodCleanup] }
  } else if c.result_returned.claim != c.request.claim || c.result_returned.head != c.submission.head_sha || c.result_returned.pr != c.publication.url {
    DogfoodRouteIncomplete { node_id: node_id, attempt_key: attempt_key, owed: [], refused: [DogfoodResultReturned] }
  } else {
    DogfoodRouteComplete { node_id: node_id, attempt_key: attempt_key, request: c.request, placement: c.placement, submission: c.submission, metering: c.metering, review: c.review, publication: c.publication, cleanup: c.cleanup, result_returned: c.result_returned }
  }
}

fn dogfood_route_carried(r: DogfoodStageReadings) -> DogfoodCarried? {
  match r.placement_grant {
    PlacementGrantGap { gap: _ } => none
    PlacementGrantEstablished { evidence: g } =>
      match r.durable_result {
        SubmissionGap { gap: _ } => none
        SubmissionEstablished { evidence: s } =>
          match r.independent_review {
            ReviewGap { gap: _ } => none
            ReviewEstablished { evidence: v } =>
              match r.candidate_published {
                PublicationGap { gap: _ } => none
                PublicationEstablished { evidence: p } =>
                  match r.cleanup {
                    CleanupGap { gap: _ } => none
                    CleanupEstablished { evidence: c } =>
                      match r.request {
                        RequestGap { gap: _ } => none
                        RequestEstablished { evidence: q } =>
                          match r.metering {
                            MeteringGap { gap: _ } => none
                            MeteringEstablished { evidence: m } =>
                              match r.result_returned {
                                ResultReturnedGap { gap: _ } => none
                                ResultReturnedEstablished { evidence: rr } => Present { value: DogfoodCarried { request: q, placement: g, submission: s, metering: m, review: v, publication: p, cleanup: c, result_returned: rr } }
                              }
                          }
                      }
                  }
              }
          }
      }
  }
}

// ── READING EACH STAGE FROM ITS OWN RECORD ──────────────────────────────────────────────────────

fn dogfood_submission_reading(attempt_key: String, capture: SubmissionCaptureObservation) -> SubmissionReading {
  match capture {
    CaptureForHead { capture: c } =>
      SubmissionEstablished { evidence: SubmissionEvidence { attempt_key: attempt_key, head_sha: c.head_sha, digest: c.digest } }
    CaptureAbsent => SubmissionGap { gap: StageOwed { owed_by: "the worker has not captured a submission at its head" } }
    CaptureUnreadable { reason } => SubmissionGap { gap: StageRefused { reason: reason } }
  }
}

// THE REVIEW NAMES ITS SUBJECT AS node@head (gunbc.roadmap.roadmap_review_function review_subject_id),
// computed in the same evidence read as the submission capture from the same worktree head, so the
// subject recorded here is the submission's head.
fn dogfood_review_reading(node_id: String, head_sha: String, report: ReviewReport) -> ReviewReading {
  match report.reconciliation.state {
    WorkflowSegmentComplete => ReviewEstablished { evidence: ReviewEvidence { subject: join([node_id, "@", head_sha], ""), plan_revision: report.plan_revision } }
    WorkflowSegmentPending => ReviewGap { gap: StageOwed { owed_by: join(["review has not run on this head: ", report.reconciliation.detail], "") } }
    WorkflowSegmentActive => ReviewGap { gap: StageOwed { owed_by: join(["review is running on this head: ", report.reconciliation.detail], "") } }
    WorkflowSegmentFailed => ReviewGap { gap: StageRefused { reason: report.reconciliation.detail } }
    WorkflowSegmentRefused => ReviewGap { gap: StageRefused { reason: report.reconciliation.detail } }
    WorkflowSegmentStopped => ReviewGap { gap: StageRefused { reason: report.reconciliation.detail } }
  }
}

// PUBLICATION IS ADMITTED ONLY ON A RECEIPT FOR THIS SUBJECT whose expected head is the captured
// submission's head and whose outcome binds a pull request at that head.
fn dogfood_publication_reading(head_sha: String, subject: PublicationSubjectObservation, evidence_source: gunbc.roadmap_publish.PublicationReceiptSource) -> PublicationReading {
  match subject {
    PublicationSubjectUnobserved { reason } => PublicationGap { gap: StageOwed { owed_by: reason } }
    PublicationSubjectObserved { subject: s } =>
      if (s.expected_head as String) != head_sha {
        PublicationGap { gap: StageRefused { reason: join(["the publication subject's head ", s.expected_head as String, " is not the captured submission's head ", head_sha], "") } }
      } else {
        match publication_evidence_for(expected: s, source: evidence_source) {
          EvidenceAbsent => PublicationGap { gap: StageOwed { owed_by: "no publication receipt for this head yet" } }
          EvidenceUnreadable { reason } => PublicationGap { gap: StageRefused { reason: reason } }
          EvidenceForAnotherSubject { field, expected: _, found: _ } => PublicationGap { gap: StageRefused { reason: join(["the publication receipt is for another subject (", field as String, ")"], "") } }
          EvidenceForSubject { receipt } =>
            match receipt.outcome {
              ReceiptBound { pr_number, url, draft: _ } => PublicationEstablished { evidence: PublicationEvidence { head_sha: head_sha, pr_number: pr_number, url: url as String } }
              ReceiptHeadDiverged { pr_number: _, pr_head: _, url: _ } => PublicationGap { gap: StageRefused { reason: "the pull request's head diverged from the submission's head" } }
              ReceiptBindingAmbiguous { pr_numbers: _ } => PublicationGap { gap: StageRefused { reason: "more than one pull request binds the branch" } }
              ReceiptRemoteBranchAtHeadWithoutPullRequest { head_sha: _ } => PublicationGap { gap: StageOwed { owed_by: "the branch is pushed at the head but no pull request exists yet" } }
              ReceiptRemoteBranchHeadDiverged { remote_head: _ } => PublicationGap { gap: StageRefused { reason: "the remote branch head diverged from the submission's head" } }
              ReceiptRemoteBranchBindingAmbiguous { refs_matched: _ } => PublicationGap { gap: StageRefused { reason: "the remote branch binding is ambiguous" } }
              ReceiptBranchNotPublished { remote_branches_seen: _ } => PublicationGap { gap: StageOwed { owed_by: "the branch is not published yet" } }
              ReceiptObservationRefused { detail } => PublicationGap { gap: StageRefused { reason: detail } }
            }
        }
      }
  }
}

// THE PLACEMENT GRANT IS ESTABLISHED ONLY BY A RECORD THE READER BOUND TO THIS ATTEMPT. The reader
// already refuses a slot, record or release belonging to another attempt as Foreign, so this fold
// only decides which of its arms is a grant, which is owed and which refuses.
fn dogfood_placement_grant_reading(p: SessionPlacementObservation) -> PlacementGrantReading {
  match p {
    SessionPlacementAbsent { unit } => PlacementGrantGap { gap: StageOwed { owed_by: join(["no session slot is held for ", unit], "") } }
    SessionPlacementUnreadable { unit: _, detail } => PlacementGrantGap { gap: StageRefused { reason: detail } }
    SessionPlacementForeign { unit: _, detail } => PlacementGrantGap { gap: StageRefused { reason: detail } }
    SessionPlacementObserved { slot: _, grant, returned: _ } =>
      match grant {
        SessionGrantRecorded { record } => PlacementGrantEstablished { evidence: PlacementGrantEvidence { host: record.host, unit: record.unit, grant_identity: record.grant_identity, fence_generation: record.fence_generation } }
        SessionGrantNotRecorded { path } => PlacementGrantGap { gap: StageOwed { owed_by: join(["the session slot is held but no placement record is written at ", path], "") } }
        SessionGrantUnreadable { path: _, detail } => PlacementGrantGap { gap: StageRefused { reason: detail } }
        SessionGrantForeign { path: _, detail } => PlacementGrantGap { gap: StageRefused { reason: detail } }
      }
  }
}

// CLEANUP IS ESTABLISHED ONLY BY A SETTLED RELEASE OF A RECORDED GRANT. The reader checks a release
// against the grant and fence it names; a release with no recorded grant to bind to establishes
// nothing here, because there is no hold it can be shown to have returned.
fn dogfood_cleanup_reading(p: SessionPlacementObservation) -> CleanupReading {
  match p {
    SessionPlacementAbsent { unit } => CleanupGap { gap: StageOwed { owed_by: join(["no session slot is held for ", unit, ", so there is no hold to release"], "") } }
    SessionPlacementUnreadable { unit: _, detail } => CleanupGap { gap: StageRefused { reason: detail } }
    SessionPlacementForeign { unit: _, detail } => CleanupGap { gap: StageRefused { reason: detail } }
    SessionPlacementObserved { slot: _, grant, returned } =>
      match grant {
        SessionGrantNotRecorded { path: _ } => CleanupGap { gap: StageOwed { owed_by: "no placement grant is recorded, so no release can be bound to one" } }
        SessionGrantUnreadable { path: _, detail } => CleanupGap { gap: StageRefused { reason: detail } }
        SessionGrantForeign { path: _, detail } => CleanupGap { gap: StageRefused { reason: detail } }
        SessionGrantRecorded { record } =>
          match returned {
            SessionReleased { reason, detail: _ } => CleanupEstablished { evidence: CleanupEvidence { grant_identity: record.grant_identity, fence_generation: record.fence_generation, outcome: "released", reason: reason } }
            SessionReleaseNothingHeld { reason, detail: _ } => CleanupEstablished { evidence: CleanupEvidence { grant_identity: record.grant_identity, fence_generation: record.fence_generation, outcome: "nothing-to-release", reason: reason } }
            SessionReleaseNotRecorded { path: _ } => CleanupGap { gap: StageOwed { owed_by: "the session's hold has not been released yet" } }
            SessionReleaseRefused { reason: _, detail } => CleanupGap { gap: StageRefused { reason: detail } }
            SessionReleaseUnreadable { path: _, detail } => CleanupGap { gap: StageRefused { reason: detail } }
          }
      }
  }
}

// THE STAGES WITH NO RECORD OF THEIR OWN YET, each owed by the change that will write it.
data dogfood_owed_immutable_subject: String = "G1 cutover: the verified head's exact tree that the shared computation's request key was derived from"

data dogfood_owed_shared_computation: String = "G1 cutover: belt verify runs through the materialization provider (compute request family), citing the derived request key and the outcome identity"

// THE ONE G5 FACT THE LANDED READER DOES NOT PROVE. The slot's states (reserved, launching,
// terminal:recovered) and the placement record's applied unit properties establish that a capped
// unit was granted and launched toward; they do not establish that the unit RAN: every session slot
// closes as terminal:recovered whether its unit executed or never started, and nothing records the
// unit's own start or exit against the grant.
data dogfood_owed_isolated_execution: String = "G5 execution observation: a record binding the granted unit's observed start and exit (systemd ExecMainStartTimestamp / ExecMainStatus) to this attempt's grant and fence; gunbc.roadmap_session_placement session_placement_observe_for_attempt proves the grant and its release, not that the capped unit ran"

// THE STAGES WITH NO PRODUCER, as one constant record: the fold reads them from here, and the
// recorder asks the same record whether completion is still structurally impossible, so no flag is
// kept beside it. As each producer lands, its field leaves this record (and gains its own reading
// type above), as placement_grant and cleanup did when gunbc#13074 landed the session placement
// reader; when the record is empty the recorder's history scan begins to run.
type DogfoodUnproduced {
  immutable_subject: ProducerPendingReading
  shared_computation: ProducerPendingReading
  isolated_execution: ProducerPendingReading
}

data dogfood_unproduced: DogfoodUnproduced = DogfoodUnproduced {
  immutable_subject: ProducerPending { owed_by: dogfood_owed_immutable_subject },
  shared_computation: ProducerPending { owed_by: dogfood_owed_shared_computation },
  isolated_execution: ProducerPending { owed_by: dogfood_owed_isolated_execution },
}

fn dogfood_unproduced_stages(u: DogfoodUnproduced) -> List<DogfoodStage> {
  let g0 = DogfoodStageGaps { owed: [], refused: [] }
  let g1 = dogfood_pending(acc: g0, stage: DogfoodImmutableSubject, r: u.immutable_subject)
  let g2 = dogfood_pending(acc: g1, stage: DogfoodSharedComputation, r: u.shared_computation)
  dogfood_pending(acc: g2, stage: DogfoodIsolatedExecution, r: u.isolated_execution).owed
}

// THE ATTEMPT'S RECORDS BESIDE ITS WORKFLOW EVIDENCE, GATHERED ONCE: the request record (G4's
// create-only binding) and the attempt's joined service evidence (gunbc.roadmap_service_evidence),
// whose inputs already carry the one G3 metering observation and the one G4 result observation with
// its snapshot-close standing. The route's metering and result stages read those same inputs, and the
// start pins the snapshot made from them, so each producer is read once per attempt. They ride beside
// WorkflowAttemptEvidence because G4's reader imports the module that type lives in.
type DogfoodAttemptRecords {
  request: AttemptRequestBindingRead
  service: ServiceEvidenceObservation
}

type DogfoodAttemptView {
  evidence: WorkflowAttemptEvidence
  records: DogfoodAttemptRecords
}

fn dogfood_attempt_records_for(instance: HostDashboardInstance, e: WorkflowAttemptEvidence) -> DogfoodAttemptRecords {
  DogfoodAttemptRecords {
    request: attempt_request_binding_read_for_instance(instance: instance, node_id: e.node_id as gunbc.roadmap_model.RoadmapNodeId, attempt_key: e.attempt_key),
    service: service_evidence_observe_for_attempt(instance: instance, node_id: e.node_id as gunbc.roadmap_model.RoadmapNodeId, attempt_key: e.attempt_key),
  }
}

// A RESULT OBSERVED THROUGH A SNAPSHOT THAT DID NOT CLOSE CLEANLY IS NOT A CLEAN OBSERVATION: the
// event may stand, but the start would claim more than is known, so the stage refuses.
fn dogfood_result_returned_reading_of(service: ServiceEvidenceObservation) -> ResultReturnedReading {
  match service {
    ServiceEvidenceJoined { receipt } =>
      match receipt.inputs.result_returned {
        ResultReturnedRead { observation, close } =>
          match close {
            SnapshotNotOpened => dogfood_result_returned_reading(r: observation)
            SnapshotClosed => dogfood_result_returned_reading(r: observation)
            SnapshotCloseFailed { worktree, exit_code: _, stderr: _ } => ResultReturnedGap { gap: StageRefused { reason: join(["the result was read through a carrier snapshot that failed to close (", worktree as String, "), so its observation is not established clean"], "") } }
          }
      }
    ServiceEvidenceAttemptUnlaunched => ResultReturnedGap { gap: StageRefused { reason: "the attempt has no launch record, so no service evidence or result can be bound to it" } }
    ServiceEvidenceRefused { reason } => ResultReturnedGap { gap: StageRefused { reason: reason } }
  }
}

fn dogfood_metering_reading_of(service: ServiceEvidenceObservation) -> MeteringReading {
  match service {
    ServiceEvidenceJoined { receipt } =>
      match receipt.inputs.metering {
        MeteringRead { observation } => dogfood_metering_reading(m: observation)
      }
    ServiceEvidenceAttemptUnlaunched => MeteringGap { gap: StageRefused { reason: "the attempt has no launch record, so no metering can be bound to it" } }
    ServiceEvidenceRefused { reason } => MeteringGap { gap: StageRefused { reason: reason } }
  }
}

fn dogfood_request_reading(r: AttemptRequestBindingRead) -> RequestReading {
  match r {
    RequestBindingRead { binding } =>
      match binding {
        RequestClaimBound { claim } => RequestEstablished { evidence: RequestEvidence { claim: claim as String } }
        RequestAutonomous => RequestGap { gap: StageRefused { reason: "the attempt was launched autonomously, so no request entered the factory for it" } }
      }
    RequestBindingAbsent => RequestGap { gap: StageOwed { owed_by: "the attempt has no request-binding record (launched before G4, or not yet initialized)" } }
    RequestBindingUnreadable { reason } => RequestGap { gap: StageRefused { reason: reason } }
  }
}

fn dogfood_result_returned_reading(r: ResultReturnedObservation) -> ResultReturnedReading {
  match r {
    ResultReturnedObserved { node: _, attempt: _, event, claim, return_to: _, outcome, recorded_at } =>
      match outcome {
        ResultPublished { pr, head } => ResultReturnedEstablished { evidence: ResultReturnedEvidence { event: event as String, claim: claim as String, head: head as String, pr: pr as String, recorded_at: recorded_at } }
        ResultVerificationFailed { head: _, cause } => ResultReturnedGap { gap: StageRefused { reason: join(["the result returned is a verification failure: ", cause as String], "") } }
        ResultHandedBack { reason } => ResultReturnedGap { gap: StageRefused { reason: join(["the result returned hands the attempt back: ", reason as String], "") } }
      }
    ResultNotReturned { attempt_key: _ } => ResultReturnedGap { gap: StageOwed { owed_by: "no result has been returned to the requester yet" } }
    ResultNotOwed { reason } => ResultReturnedGap { gap: StageRefused { reason: join(["no result is owed for this attempt: ", reason], "") } }
    ResultReturnedUnobserved { step: _, reason } => ResultReturnedGap { gap: StageRefused { reason: reason } }
  }
}

fn dogfood_metering_reading(m: AttemptMeteringObservation) -> MeteringReading {
  match m {
    MeteringObserved { record } =>
      match metering_token_total(record: record, output: false) {
        MeteringTokensIncomplete { cause } => MeteringGap { gap: StageRefused { reason: cause } }
        MeteringTokensObserved { value } => {
          let input = value
          match metering_token_total(record: record, output: true) {
            MeteringTokensIncomplete { cause } => MeteringGap { gap: StageRefused { reason: cause } }
            MeteringTokensObserved { value } =>
              match metering_seat_time_total(record: record) {
                MeteringSeatTimeIncomplete { cause } => MeteringGap { gap: StageRefused { reason: cause } }
                MeteringSeatTimeObserved { held } => MeteringEstablished { evidence: MeteringEvidence { input_tokens: input, output_tokens: value, seat_time: held, compute: record.compute } }
              }
          }
        }
      }
    MeteringProvisional { record: _ } => MeteringGap { gap: StageOwed { owed_by: "the attempt's metering record is provisional: its roster is not sealed, or a launch or seat is still open" } }
    MeteringNotYetWritten => MeteringGap { gap: StageOwed { owed_by: "no metering record has been written for the attempt" } }
    MeteringRefused { cause } => MeteringGap { gap: StageRefused { reason: cause } }
  }
}

fn dogfood_route_readings(e: WorkflowAttemptEvidence, records: DogfoodAttemptRecords) -> DogfoodStageReadings {
  let submission = dogfood_submission_reading(attempt_key: e.attempt_key, capture: e.submission_capture)
  let head = match submission {
    SubmissionEstablished { evidence: s } => s.head_sha
    SubmissionGap { gap: _ } => ""
  }
  DogfoodStageReadings {
    request: dogfood_request_reading(r: records.request),
    immutable_subject: dogfood_unproduced.immutable_subject,
    shared_computation: dogfood_unproduced.shared_computation,
    placement_grant: dogfood_placement_grant_reading(p: e.session_placement),
    isolated_execution: dogfood_unproduced.isolated_execution,
    durable_result: submission,
    metering: dogfood_metering_reading_of(service: records.service),
    independent_review: if head == "" { ReviewGap { gap: StageOwed { owed_by: "no captured submission, so no head to review" } } } else { dogfood_review_reading(node_id: e.node_id, head_sha: head, report: e.review) },
    candidate_published: if head == "" { PublicationGap { gap: StageOwed { owed_by: "no captured submission, so no head to publish" } } } else { dogfood_publication_reading(head_sha: head, subject: e.publication_subject, evidence_source: e.publication_source) },
    cleanup: dogfood_cleanup_reading(p: e.session_placement),
    result_returned: dogfood_result_returned_reading_of(service: records.service),
  }
}

fn dogfood_route_receipt_for(v: DogfoodAttemptView) -> DogfoodRouteReceipt {
  dogfood_route_receipt(node_id: v.evidence.node_id, attempt_key: v.evidence.attempt_key, r: dogfood_route_readings(e: v.evidence, records: v.records))
}

// ── THE START RECEIPT: ONE MINT, VALIDATED JOINS, FIRST RECORDED ONLY ────────────────────────────
//
// WHAT "FIRST" MEANS, stated so it is not mistaken for more: the start receipt is the first complete
// attempt, selected in refname order, by the first SUCCESSFUL RECORDER to observe one. The recorder runs in every belt tick until a receipt
// exists, and each run scans the instance's whole durable attempt history (every dispatch ref, read
// by its own attempt key -- gunbc.roadmap_belt_actuate
// belt_workflow_attempt_history_evidences_observe_for_instance), so a completed attempt is found
// whether or not it is still its node's current attempt, and a tick that dies before recording
// leaves it for the next tick to find. Among several complete attempts in one scan, the first in
// refname order is taken: deterministic, not temporal. The established time is the recorder's own
// typed clock reading; a refused clock refuses the record, it is never written as the time. Once a
// valid receipt is in the slot the scan stops and the slot is never rewritten (create-only CAS).
data dogfood_start_receipt_key: NonEmptyStr = "dogfood-start-receipt" as NonEmptyStr

data dogfood_start_receipt_schema: String = "dogfood-start-receipt/v6"

// THE SLOT LIVES IN A ROOT THE DEPLOYMENT ALREADY CONVERGES. The file CAS store does not create its
// the attempt-state demand (gunbc.roadmap_dashboard_instance dashboard_instance_dispatch_attempt_state_directory) both deployment routes ensure with its owner
// the AttemptStateRoot member gunbc.live_deploy.spec deployment_owned_steps installs with its owner
// and mode before any belt timer runs, and the directory the session placement records already
// share -- under its own key. A root of its own would be a second deployment member for one file.
fn dogfood_start_store_root(instance: HostDashboardInstance) -> NonEmptyStr {
  dashboard_instance_dispatch_attempt_state_root(instance: instance) as String as NonEmptyStr
}

// THE START RECEIPT, every field the acceptance read requires. Minted only by
// dogfood_start_candidate (from one WorkflowAttemptEvidence) or by the total decoder below, both of
// which check every join; the wire encoder re-checks them, so correctness does not rest on
// sole_constructor (enforced by the seed, not yet by the native route -- gunbc.rung_drop
// g0_type_decl_modifier_parse_without_sealing_property), which is defence in depth here.
// THE JOINED SERVICE EVIDENCE THE START PINS (gunbc.roadmap_service_evidence, #13109/#13157) is one
// ServiceEvidenceSnapshot: the canonical evidence wire, persisted whole, from which the decoder of that
// module derives the digest, the binding and every field's standing. The start receipt carries no
// digest or standing list of its own, so the two can never describe different evidence, and the field
// population is that module's, not a list kept here.
type DogfoodStartReceipt sole_constructor {
  node_id: String
  attempt_key: String
  head_sha: String
  submission_digest: String
  review_subject: String
  review_plan_revision: String
  review_digest: String
  pr_number: Int
  pr_url: String
  grant_identity: String
  fence_generation: Nat
  cleanup_outcome: String
  request_claim: String
  request_binding_wire: String
  result_event: String
  result_claim: String
  metering_compute: String
  service_evidence: ServiceEvidenceSnapshot
  established_at: Rfc3339Timestamp
}

// The joins every start receipt must satisfy, whoever built it. Absent is valid; Present names the
// first disagreement.
// THE PINNED SERVICE EVIDENCE MUST ESTABLISH THE G3 AND G4 STAGES, not merely decode: a Final meter
// (both token totals and seat time observed) and a published result whose PR and head are the
// receipt's publication. None when they hold; otherwise the first failure.
fn dogfood_pinned_g3_g4_holds(r: DogfoodStartReceipt) -> Bool {
  match dogfood_pinned_g3_g4_defect(r: r) { Absent => true  Present { value: _ } => false }
}

fn dogfood_pinned_g3_g4_defect(r: DogfoodStartReceipt) -> String? {
  dogfood_pinned_g3_g4_defect_of(snapshot: r.service_evidence, pr_url: r.pr_url, head_sha: r.head_sha)
}

fn dogfood_pinned_g3_g4_defect_of(snapshot: ServiceEvidenceSnapshot, pr_url: String, head_sha: String) -> String? {
  match service_evidence_snapshot_final_metering(snapshot: snapshot) {
    Absent => Present { value: "the pinned service evidence does not establish a Final metering record (execution_time and billable_usage observed)" }
    Present { value: _ } =>
      match service_evidence_snapshot_published_result(snapshot: snapshot) {
        Absent => Present { value: "the pinned service evidence does not establish a published result (failure_attribution and completion_time observed)" }
        Present { value: p } =>
          if p.pr != pr_url { Present { value: "the pinned result names another pull request than the receipt's publication" } }
          else if p.head != head_sha { Present { value: "the pinned result names another head than the receipt's submission" } }
          else { none }
      }
  }
}

fn dogfood_start_receipt_defect(r: DogfoodStartReceipt) -> String? {
  if r.node_id == "" { Present { value: "node_id is empty" } }
  else if r.attempt_key == "" { Present { value: "attempt_key is empty" } }
  else if !lower_hex_40(value: r.head_sha) { Present { value: "head_sha is not a 40-hex commit identity" } }
  else if r.submission_digest == "" { Present { value: "submission_digest is empty" } }
  else if r.review_subject != join([r.node_id, "@", r.head_sha], "") { Present { value: "review_subject does not name node_id@head_sha" } }
  else if r.review_plan_revision == "" { Present { value: "review_plan_revision is empty" } }
  else if r.review_digest == "" { Present { value: "review_digest is empty" } }
  else if r.pr_number <= 0 { Present { value: "pr_number is not a positive pull request number" } }
  else if r.pr_url == "" { Present { value: "pr_url is empty" } }
  else if r.grant_identity == "" { Present { value: "grant_identity is empty" } }
  else if r.fence_generation == 0 { Present { value: "fence_generation is not a granted fence" } }
  else if r.cleanup_outcome != "released" && r.cleanup_outcome != "nothing-to-release" { Present { value: "cleanup_outcome is not a settled release" } }
  else if r.request_claim == "" { Present { value: "request_claim is empty" } }
  else if r.request_binding_wire != attempt_request_binding_json(binding: RequestClaimBound { claim: r.request_claim as NonEmptyStr as gunbc.roadmap.roadmap_event_log.RoadmapEventId }) { Present { value: "request_binding_wire is not the canonical request record for request_claim" } }
  else if r.result_event == "" { Present { value: "result_event is empty" } }
  else if r.result_claim != r.request_claim { Present { value: "the returned result answers another claim than the pinned request" } }
  else if r.metering_compute == "" { Present { value: "metering_compute is empty" } }
  else if !dogfood_pinned_g3_g4_holds(r: r) { dogfood_pinned_g3_g4_defect(r: r) }
  else if r.service_evidence.node_id != r.node_id || r.service_evidence.attempt_key != r.attempt_key { Present { value: "the pinned service evidence names another node or attempt" } }
  else if !rfc3339_is_canonically_spelled(value: r.established_at) { Present { value: "established_at is not a canonical RFC 3339 UTC instant" } }
  else { none }
}

// THE ONE MINT FROM EVIDENCE. It reads every stage from the single WorkflowAttemptEvidence it is
// given and checks that the three established pieces speak of that one attempt and head. While any
// stage is owed or refused there is no candidate.
fn dogfood_start_candidate(v: DogfoodAttemptView, service: ServiceEvidenceReceipt, established_at: Rfc3339Timestamp) -> DogfoodStartReceipt? {
  let e = v.evidence
  match dogfood_route_receipt_for(v: v) {
    DogfoodRouteIncomplete { node_id: _, attempt_key: _, owed: _, refused: _ } => none
    DogfoodRouteComplete { node_id: _, attempt_key: _, request, placement, submission, metering, review, publication, cleanup, result_returned } =>
      if submission.attempt_key != e.attempt_key || publication.head_sha != submission.head_sha
        || (service.binding.node_id as String) != e.node_id || (service.binding.attempt_key as String) != e.attempt_key {
        none
      } else {
        match service_evidence_snapshot_of_receipt(r: service) {
          SnapshotInvalid { reason: _ } => none
          SnapshotDecoded { snapshot } => {
        let r = DogfoodStartReceipt {
          node_id: e.node_id,
          attempt_key: e.attempt_key,
          head_sha: submission.head_sha,
          submission_digest: submission.digest,
          review_subject: review.subject,
          review_plan_revision: review.plan_revision,
          review_digest: wire_content_hash_to_hex(hash: content_hash_of_value(value: serialize_json(v: review_report_json(report: e.review)) as NonEmptyStr)),
          pr_number: publication.pr_number,
          pr_url: publication.url,
          grant_identity: placement.grant_identity,
          fence_generation: placement.fence_generation,
          cleanup_outcome: cleanup.outcome,
          request_claim: request.claim,
          request_binding_wire: attempt_request_binding_json(binding: RequestClaimBound { claim: request.claim as NonEmptyStr as gunbc.roadmap.roadmap_event_log.RoadmapEventId }),
          result_event: result_returned.event,
          result_claim: result_returned.claim,
          metering_compute: dogfood_compute_word(c: metering.compute),
          service_evidence: snapshot,
          established_at: established_at,
        }
        match dogfood_start_receipt_defect(r: r) {
          Absent => Present { value: r }
          Present { value: _ } => none
        }
          }
        }
      }
  }
}

// THE FIRST COMPLETE ATTEMPT in observation order, found WITHOUT a time: candidate discovery comes
// before the clock is consulted, so an unavailable clock can only refuse timestamping a candidate
// that exists, never a tick with nothing to record.
fn dogfood_first_complete_evidence(views: List<DogfoodAttemptView>) -> DogfoodAttemptView? {
  fold(views, init: none, f: (acc, v) => match acc {
    Present { value: _ } => acc
    Absent =>
      match dogfood_route_receipt_for(v: v) {
        DogfoodRouteComplete { node_id: _, attempt_key: _, request: _, placement: _, submission: _, metering: _, review: _, publication: _, cleanup: _, result_returned: _ } => Present { value: v }
        DogfoodRouteIncomplete { node_id: _, attempt_key: _, owed: _, refused: _ } => none
      }
  })
}

// THE ORDER OF THE RECORDER'S TWO QUESTIONS, pure so both arms are witnessed: no candidate is
// NoCandidate whatever the clock says; a candidate with no usable clock refuses.
type DogfoodStartStep<C>
  = StartNoCandidate
  | StartClockRefused { reason: String }
  | StartTimestamp { candidate: C, at: Rfc3339Timestamp }

fn dogfood_start_step<C>(candidate: C?, clock: NonEmptyStr?) -> DogfoodStartStep<C> {
  match candidate {
    Absent => StartNoCandidate
    Present { value: c } =>
      match clock {
        Absent => StartClockRefused { reason: "the clock could not be read, so no start time can be established" }
        Present { value: now } =>
          if rfc3339_is_canonically_spelled(value: (now as String) as Rfc3339Timestamp) {
            StartTimestamp { candidate: c, at: (now as String) as Rfc3339Timestamp }
          } else {
            StartClockRefused { reason: join(["the clock reading is not a canonical RFC 3339 UTC instant: ", now as String], "") }
          }
      }
  }
}

fn dogfood_start_receipt_wire(r: DogfoodStartReceipt) -> String? {
  match dogfood_start_receipt_defect(r: r) {
    Present { value: _ } => none
    Absent =>
      Present { value: serialize_json(v: json_object([
        json_kv(key: "schema", value: json_string(s: dogfood_start_receipt_schema)),
        json_kv(key: "node_id", value: json_string(s: r.node_id)),
        json_kv(key: "attempt_key", value: json_string(s: r.attempt_key)),
        json_kv(key: "head_sha", value: json_string(s: r.head_sha)),
        json_kv(key: "submission_digest", value: json_string(s: r.submission_digest)),
        json_kv(key: "review_subject", value: json_string(s: r.review_subject)),
        json_kv(key: "review_plan_revision", value: json_string(s: r.review_plan_revision)),
        json_kv(key: "review_digest", value: json_string(s: r.review_digest)),
        json_kv(key: "pr_number", value: json_int(n: r.pr_number)),
        json_kv(key: "pr_url", value: json_string(s: r.pr_url)),
        json_kv(key: "grant_identity", value: json_string(s: r.grant_identity)),
        json_kv(key: "fence_generation", value: json_int(n: r.fence_generation)),
        json_kv(key: "cleanup_outcome", value: json_string(s: r.cleanup_outcome)),
        json_kv(key: "request_binding_wire", value: json_string(s: r.request_binding_wire)),
        json_kv(key: "result_event", value: json_string(s: r.result_event)),
        json_kv(key: "result_claim", value: json_string(s: r.result_claim)),
        json_kv(key: "metering_compute", value: json_string(s: r.metering_compute)),
        json_kv(key: "service_evidence_digest", value: json_string(s: r.service_evidence.digest)),
        json_kv(key: "service_evidence_wire", value: json_string(s: r.service_evidence.wire)),
        json_kv(key: "established_at", value: json_string(s: r.established_at as String)),
      ])) }
  }
}

// ── THE TOTAL DECODER ──
type DogfoodStartReceiptDecode
  = StartReceiptDecoded { receipt: DogfoodStartReceipt }
  | StartReceiptInvalid { reason: String }

// A missing or mistyped field decodes as empty (or zero), which the join validation refuses, so
// the defect check is the whole of the decoder's judgment and there is no second list of rules.
fn dogfood_decode_field(v: JsonValue, key: String) -> String {
  match json_field_string(obj: v, key: key) {
    FieldRead { value: s } => s
    FieldAbsent => ""
    FieldMalformed { cause: _ } => ""
  }
}

fn dogfood_start_receipt_decode(payload: String) -> DogfoodStartReceiptDecode {
  match parse_json_document(s: payload) {
    JsonDocumentUnreadable { gap: _ } => StartReceiptInvalid { reason: "the start receipt is not a JSON document" }
    JsonDocumentParsed { value: v } =>
      if dogfood_decode_field(v: v, key: "schema") != dogfood_start_receipt_schema {
        StartReceiptInvalid { reason: "the schema is missing or not dogfood-start-receipt/v6" }
      } else {
        let when = dogfood_decode_field(v: v, key: "established_at")
        if when == "" {
          StartReceiptInvalid { reason: "established_at is missing" }
        } else {
          let ev_wire = dogfood_decode_field(v: v, key: "service_evidence_wire")
          let pinned_claim = match attempt_request_binding_decode(text: dogfood_decode_field(v: v, key: "request_binding_wire")) {
            RequestBindingDecoded { binding } => match binding { RequestClaimBound { claim } => claim as String  RequestAutonomous => "" }
            RequestBindingUndecodable { reason: _ } => ""
          }
          if pinned_claim == "" || dogfood_decode_field(v: v, key: "result_claim") != pinned_claim {
            StartReceiptInvalid { reason: "the returned result does not answer the pinned request's claim" }
          } else if ev_wire == "" || dogfood_decode_field(v: v, key: "service_evidence_digest") != wire_content_hash_to_hex(hash: content_hash_of_value(value: ev_wire as NonEmptyStr)) {
            StartReceiptInvalid { reason: "service_evidence_digest is not the digest of the pinned service evidence" }
          } else {
          match service_evidence_snapshot_decode_bound(wire: ev_wire, node_id: Present { value: dogfood_decode_field(v: v, key: "node_id") }, attempt_key: Present { value: dogfood_decode_field(v: v, key: "attempt_key") }) {
            SnapshotInvalid { reason } => StartReceiptInvalid { reason: join(["the pinned service evidence does not decode: ", reason], "") }
            SnapshotDecoded { snapshot } => {
          let r = DogfoodStartReceipt {
            node_id: dogfood_decode_field(v: v, key: "node_id"),
            attempt_key: dogfood_decode_field(v: v, key: "attempt_key"),
            head_sha: dogfood_decode_field(v: v, key: "head_sha"),
            submission_digest: dogfood_decode_field(v: v, key: "submission_digest"),
            review_subject: dogfood_decode_field(v: v, key: "review_subject"),
            review_plan_revision: dogfood_decode_field(v: v, key: "review_plan_revision"),
            review_digest: dogfood_decode_field(v: v, key: "review_digest"),
            pr_number: match json_field_int(obj: v, key: "pr_number") { FieldRead { value: n } => n  FieldAbsent => 0  FieldMalformed { cause: _ } => 0 },
            pr_url: dogfood_decode_field(v: v, key: "pr_url"),
            grant_identity: dogfood_decode_field(v: v, key: "grant_identity"),
            fence_generation: match json_field_nat(obj: v, key: "fence_generation") { FieldRead { value: n } => n  FieldAbsent => 0  FieldMalformed { cause: _ } => 0 },
            cleanup_outcome: dogfood_decode_field(v: v, key: "cleanup_outcome"),
            request_claim: match attempt_request_binding_decode(text: dogfood_decode_field(v: v, key: "request_binding_wire")) {
              RequestBindingDecoded { binding } => match binding { RequestClaimBound { claim } => claim as String  RequestAutonomous => "" }
              RequestBindingUndecodable { reason: _ } => ""
            },
            request_binding_wire: dogfood_decode_field(v: v, key: "request_binding_wire"),
            result_event: dogfood_decode_field(v: v, key: "result_event"),
            result_claim: dogfood_decode_field(v: v, key: "result_claim"),
            metering_compute: dogfood_decode_field(v: v, key: "metering_compute"),
            service_evidence: snapshot,
            established_at: when as Rfc3339Timestamp,
          }
          match dogfood_start_receipt_defect(r: r) {
            Absent => StartReceiptDecoded { receipt: r }
            Present { value: why } => StartReceiptInvalid { reason: why }
          }
              }
          }
          }
        }
      }
  }
}

// ── THE RECORDER ──
type DogfoodStartRecord
  = DogfoodStartRecorded { receipt: String }
  | DogfoodStartAlreadyRecorded
  | DogfoodStartNoCompleteAttempt
  | DogfoodStartRefused { reason: String }

// THE ONE INSTANCE-BOUND JUDGMENT OF AN OCCUPIED SLOT, used by the recorder's first read, by its
// lost-race read and by the acceptance read: the decoded receipt's pinned evidence must name exactly
// the attempt's durable binding -- instance, node, attempt and launch revision, read from the
// attempt's launch record in THIS instance (gunbc.roadmap_service_evidence
// service_evidence_snapshot_binding_defect).
fn dogfood_receipt_binding_defect_here(instance: HostDashboardInstance, receipt: DogfoodStartReceipt) -> String? {
  match service_evidence_snapshot_binding_defect(
    snapshot: receipt.service_evidence,
    binding: service_evidence_binding_for_attempt(instance: instance, node_id: receipt.node_id as gunbc.roadmap_model.RoadmapNodeId, attempt_key: receipt.attempt_key),
  ) {
    Present { value: why } => Present { value: why }
    Absent =>
      match dogfood_request_record_defect(receipt: receipt, record: attempt_request_binding_read_for_instance(instance: instance, node_id: receipt.node_id as gunbc.roadmap_model.RoadmapNodeId, attempt_key: receipt.attempt_key)) {
        Present { value: why } => Present { value: why }
        Absent => dogfood_durable_g3_g4_defect(receipt: receipt, service: service_evidence_observe_for_attempt(instance: instance, node_id: receipt.node_id as gunbc.roadmap_model.RoadmapNodeId, attempt_key: receipt.attempt_key))
      }
  }
}

// THE PINNED G3 AND G4 FACTS AGAINST THE ATTEMPT'S DURABLE RECORDS, read once through the service
// evidence gather: the result reader must observe exactly the pinned event and claim, published at the
// pinned PR and head, through a cleanly closed snapshot; the metering reader must observe a Final
// record whose totals are the pinned ones and whose compute standing is the pinned one.
fn dogfood_durable_g3_g4_defect(receipt: DogfoodStartReceipt, service: ServiceEvidenceObservation) -> String? {
  match service {
    ServiceEvidenceAttemptUnlaunched => Present { value: "the attempt has no launch record to read its G3 and G4 records under" }
    ServiceEvidenceRefused { reason } => Present { value: join(["the attempt's G3 and G4 records are unreadable: ", reason], "") }
    ServiceEvidenceJoined { receipt: live } => {
      let result_defect = match live.inputs.result_returned {
        ResultReturnedRead { observation, close } =>
          match close {
            SnapshotCloseFailed { worktree: _, exit_code: _, stderr: _ } => Present { value: "the attempt's result was read through a snapshot that failed to close" }
            SnapshotNotOpened => dogfood_durable_result_defect(receipt: receipt, observation: observation)
            SnapshotClosed => dogfood_durable_result_defect(receipt: receipt, observation: observation)
          }
      }
      let metering_defect = match live.inputs.metering {
        MeteringRead { observation } => dogfood_durable_metering_defect(receipt: receipt, observation: observation)
      }
      match result_defect {
        Present { value: why } => Present { value: why }
        Absent => metering_defect
      }
    }
  }
}

fn dogfood_durable_result_defect(receipt: DogfoodStartReceipt, observation: ResultReturnedObservation) -> String? {
  match observation {
    ResultReturnedObserved { node, attempt, event, claim, return_to: _, outcome, recorded_at } =>
      if (node as String) != receipt.node_id || (attempt as String) != receipt.attempt_key { Present { value: "the attempt's returned result names another node or attempt" } }
      else if (event as String) != receipt.result_event || (claim as String) != receipt.result_claim { Present { value: "the attempt's returned result is another event or claim than the pinned one" } }
      else if (match service_evidence_snapshot_published_result(snapshot: receipt.service_evidence) { Absent => true  Present { value } => value.recorded_at != recorded_at }) { Present { value: "the attempt's returned result was recorded at another time than the pinned completion_time" } }
      else {
        match outcome {
          ResultPublished { pr, head } => if (pr as String) != receipt.pr_url || (head as String) != receipt.head_sha { Present { value: "the attempt's returned result publishes another PR or head than the pinned one" } } else { none }
          ResultVerificationFailed { head: _, cause: _ } => Present { value: "the attempt's returned result is a verification failure" }
          ResultHandedBack { reason: _ } => Present { value: "the attempt's returned result hands the attempt back" }
        }
      }
    ResultNotReturned { attempt_key: _ } => Present { value: "the attempt has no returned result" }
    ResultNotOwed { reason: _ } => Present { value: "no result is owed for the attempt" }
    ResultReturnedUnobserved { step: _, reason } => Present { value: join(["the attempt's returned result is unobserved: ", reason], "") }
  }
}

fn dogfood_durable_metering_defect(receipt: DogfoodStartReceipt, observation: AttemptMeteringObservation) -> String? {
  match observation {
    MeteringObserved { record } =>
      match dogfood_metering_reading(m: MeteringObserved { record: record }) {
        MeteringGap { gap: _ } => Present { value: "the attempt's Final metering record has incomplete totals" }
        MeteringEstablished { evidence: m } =>
          match service_evidence_snapshot_final_metering(snapshot: receipt.service_evidence) {
            Absent => Present { value: "the pinned service evidence has no Final metering" }
            Present { value: pinned } =>
              if m.input_tokens != pinned.input_tokens || m.output_tokens != pinned.output_tokens || m.seat_time != pinned.seat_time { Present { value: "the attempt's Final metering totals are not the pinned ones" } }
              else if dogfood_compute_word(c: m.compute) != receipt.metering_compute { Present { value: "the attempt's metering compute standing is not the pinned one" } }
              else { none }
          }
      }
    MeteringProvisional { record: _ } => Present { value: "the attempt's metering record is provisional" }
    MeteringNotYetWritten => Present { value: "the attempt has no metering record" }
    MeteringRefused { cause } => Present { value: join(["the attempt's metering record is refused: ", cause], "") }
  }
}

// THE PINNED REQUEST AGAINST THE ATTEMPT'S DURABLE REQUEST RECORD: the receipt's request record must
// be exactly the one the attempt carries.
fn dogfood_request_record_defect(receipt: DogfoodStartReceipt, record: AttemptRequestBindingRead) -> String? {
  match record {
    RequestBindingRead { binding } =>
      if attempt_request_binding_json(binding: binding) == receipt.request_binding_wire { none }
      else { Present { value: "the pinned request record is not the attempt's request record" } }
    RequestBindingAbsent => Present { value: "the attempt has no request record" }
    RequestBindingUnreadable { reason } => Present { value: join(["the attempt's request record is unreadable: ", reason], "") }
  }
}

// What an occupied slot means for the recorder, pure over the judgment: a receipt bound here is
// already recorded; one that is not refuses, so it is never reported as this instance's start.
fn dogfood_occupied_slot_record(defect: String?) -> DogfoodStartRecord {
  match defect {
    Absent => DogfoodStartAlreadyRecorded
    Present { value: why } => DogfoodStartRefused { reason: join(["the recorded start receipt is not this instance's start: ", why], "") }
  }
}

fn dogfood_start_record_for_instance(instance: HostDashboardInstance) -> DogfoodStartRecord {
  let root = dogfood_start_store_root(instance: instance)
  match observe_cas_slot_state(root: root, key: dogfood_start_receipt_key) {
    CasObservedUnreadable { cause: _ } => DogfoodStartRefused { reason: "the start receipt slot cannot be read, so whether a start is recorded is unknown" }
    CasObservedReadable { readable } =>
      match readable {
        CasReadablePresent { version } =>
          match dogfood_start_receipt_decode(payload: version.value as String) {
            StartReceiptDecoded { receipt } => dogfood_occupied_slot_record(defect: dogfood_receipt_binding_defect_here(instance: instance, receipt: receipt))
            StartReceiptInvalid { reason } => DogfoodStartRefused { reason: join(["the recorded start receipt is invalid and cannot be rewritten: ", reason], "") }
          }
        CasReadableAbsent =>
          if length(dogfood_unproduced_stages(u: dogfood_unproduced)) > 0 {
            DogfoodStartNoCompleteAttempt
          } else {
            match belt_workflow_attempt_history_evidences_observe_for_instance(instance: instance) {
              WorkflowAttemptEvidencesRefused { reason } => DogfoodStartRefused { reason: reason }
              WorkflowAttemptEvidencesObserved { evidences } =>
                match dogfood_first_complete_evidence(views: map(evidences, e => DogfoodAttemptView { evidence: e, records: dogfood_attempt_records_for(instance: instance, e: e) })) {
                  Absent => DogfoodStartNoCompleteAttempt
                  Present { value: found } =>
                    match found.records.service {
                      ServiceEvidenceAttemptUnlaunched => DogfoodStartRefused { reason: "the complete attempt has no launch record, so it has no joined service evidence" }
                      ServiceEvidenceRefused { reason } => DogfoodStartRefused { reason: join(["the complete attempt's service evidence is refused: ", reason], "") }
                      ServiceEvidenceJoined { receipt } =>
                        match dogfood_start_step(candidate: Present { value: found }, clock: clock_now_probed_at()) {
                          StartNoCandidate => DogfoodStartNoCompleteAttempt
                          StartClockRefused { reason } => DogfoodStartRefused { reason: reason }
                          StartTimestamp { candidate, at } =>
                            match dogfood_start_candidate(v: candidate, service: receipt, established_at: at) {
                              Absent => DogfoodStartRefused { reason: "the complete attempt failed its own join validation" }
                              Present { value: first } =>
                                match dogfood_start_receipt_wire(r: first) {
                                  Absent => DogfoodStartRefused { reason: "the start candidate failed its own join validation" }
                                  Present { value: wire } =>
                                    match admit_cas_attempt_for_derived_payload(key: dogfood_start_receipt_key, expected: ExpectSlotAbsent, proposed: wire as NonEmptyStr) {
                                      DerivedPayloadKeyNotSlotAddressable { key: _ } => DogfoodStartRefused { reason: "the start receipt key is not slot-addressable" }
                                      DerivedPayloadAdmitted { verified } =>
                                        match file_compare_and_set(root: root, publication: DefaultAccessCreateOnly, verified: verified) {
                                          CasCommitted { committed: _ } => DogfoodStartRecorded { receipt: wire }
                                          CasPreconditionFailed { expected: _, observed } =>
                                            match observed {
                                              CasReadableAbsent => DogfoodStartRefused { reason: "the create-only write was refused yet the slot reads absent" }
                                              CasReadablePresent { version } =>
                                                match dogfood_start_receipt_decode(payload: version.value as String) {
                                                  StartReceiptDecoded { receipt } => dogfood_occupied_slot_record(defect: dogfood_receipt_binding_defect_here(instance: instance, receipt: receipt))
                                                  StartReceiptInvalid { reason } => DogfoodStartRefused { reason: join(["a concurrent writer left an invalid start receipt: ", reason], "") }
                                                }
                                            }
                                          CasStoreRefused { cause: _ } => DogfoodStartRefused { reason: "the start receipt store refused the create-only write" }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
          }
      }
  }
}

// ── THE ACCEPTANCE CASE ──
//
// The roadmap row's execution contract reads the start-receipt slot and holds exactly when it holds
// a receipt the total decoder accepts. A plain function rather than a floor witness: its subject is
// a deployment's durable store, which a CI runner does not have. An unreadable slot is not a pass.
fn dogfood_route_acceptance_holds_on(instance: HostDashboardInstance) -> Bool {
  match observe_cas_slot_state(root: dogfood_start_store_root(instance: instance), key: dogfood_start_receipt_key) {
    CasObservedUnreadable { cause: _ } => false
    CasObservedReadable { readable } =>
      match readable {
        CasReadableAbsent => false
        CasReadablePresent { version } =>
          match dogfood_start_receipt_decode(payload: version.value as String) {
            StartReceiptDecoded { receipt } => match dogfood_receipt_binding_defect_here(instance: instance, receipt: receipt) { Absent => true  Present { value: _ } => false }
            StartReceiptInvalid { reason: _ } => false
          }
      }
  }
}

fn dogfood_route_acceptance_holds() -> Bool {
  dogfood_route_acceptance_holds_on(instance: srv2_deploy_dashboard_instance())
}
