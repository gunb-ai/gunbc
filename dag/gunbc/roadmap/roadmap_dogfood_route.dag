module gunbc.roadmap_dogfood_route

import std.types { String, Bool, Int, List, NonEmptyStr }
import gunbc.roadmap_workflow_stage {
  WorkflowSegment, workflow_segment_of_kind,
  SubmissionWorkflowSegment, PublicationWorkflowSegment, ReviewWorkflowSegment,
  WorkflowSegmentPending, WorkflowSegmentActive, WorkflowSegmentComplete, WorkflowSegmentFailed,
  WorkflowSegmentRefused, WorkflowSegmentStopped,
}
import gunbc.roadmap_workflow_progress { WorkflowAttemptProgress }
import gunbc.roadmap_dashboard_instance { HostDashboardInstance, srv2_deploy_dashboard_instance }
import gunbc.roadmap_belt_actuate {
  BeltWorkflowAttempts, WorkflowAttemptsObserved, WorkflowAttemptsRefused,
  belt_workflow_attempts_observe_for_instance,
}

// THE DOGFOOD ROUTE, AS ONE ACCEPTANCE CASE (operator ruling 2026-10-03). A request enters the
// factory and leaves as an independently reviewed, published candidate, and every stage between is
// established from a durable record the real route wrote for ONE attempt -- each stage from its OWN
// record, never two stages from one -- and never from the route being described. The first attempt
// whose receipt is DogfoodRouteComplete is the dogfood start receipt; attempts operated by hand
// before the route existed do not qualify, because their records cannot establish the stages that
// had no producer.
type DogfoodStage
  = DogfoodRequest
  | DogfoodImmutableSubject
  | DogfoodSharedComputation
  | DogfoodPlacementGrant
  | DogfoodIsolatedExecution
  | DogfoodDurableResult
  | DogfoodMetering
  | DogfoodCleanup
  | DogfoodResultReturned
  | DogfoodCandidatePublished
  | DogfoodIndependentReview

fn dogfood_stage_wire(stage: DogfoodStage) -> String {
  match stage {
    DogfoodRequest => "request"
    DogfoodImmutableSubject => "immutable-subject"
    DogfoodSharedComputation => "shared-computation"
    DogfoodPlacementGrant => "placement-grant"
    DogfoodIsolatedExecution => "isolated-execution"
    DogfoodDurableResult => "durable-result"
    DogfoodMetering => "metering"
    DogfoodCleanup => "cleanup"
    DogfoodResultReturned => "result-returned"
    DogfoodCandidatePublished => "candidate-published"
    DogfoodIndependentReview => "independent-review"
  }
}

// THREE READINGS, AND ONLY ONE OF THEM COUNTS. Established carries the evidence that established
// the stage; Owed is a stage the attempt has not reached or that no producer yet writes, naming
// what owes it; Refused is a stage whose record exists and says the stage did not hold.
type DogfoodStageReading
  = StageEstablished { evidence: String }
  | StageOwed { owed_by: String }
  | StageRefused { reason: String }

// ONE FIELD PER STAGE, so a reading set with a stage missing or read twice has no constructor
// (DESIGN §4b, structurally impossible) -- there is no identity join to check and no stage
// equality to write.
type DogfoodStageReadings {
  request: DogfoodStageReading
  immutable_subject: DogfoodStageReading
  shared_computation: DogfoodStageReading
  placement_grant: DogfoodStageReading
  isolated_execution: DogfoodStageReading
  durable_result: DogfoodStageReading
  metering: DogfoodStageReading
  cleanup: DogfoodStageReading
  result_returned: DogfoodStageReading
  candidate_published: DogfoodStageReading
  independent_review: DogfoodStageReading
}

type DogfoodRouteReceipt
  = DogfoodRouteComplete { attempt_key: String, readings: DogfoodStageReadings }
  | DogfoodRouteIncomplete { attempt_key: String, owed: List<DogfoodStage>, refused: List<DogfoodStage>, readings: DogfoodStageReadings }

type DogfoodStageGaps {
  owed: List<DogfoodStage>
  refused: List<DogfoodStage>
}

fn dogfood_stage_gap(acc: DogfoodStageGaps, stage: DogfoodStage, reading: DogfoodStageReading) -> DogfoodStageGaps {
  match reading {
    StageEstablished { evidence: _ } => acc
    StageOwed { owed_by: _ } => DogfoodStageGaps { owed: concat(acc.owed, [stage]), refused: acc.refused }
    StageRefused { reason: _ } => DogfoodStageGaps { owed: acc.owed, refused: concat(acc.refused, [stage]) }
  }
}

// The gaps in route order, one step per stage.
fn dogfood_stage_gaps(r: DogfoodStageReadings) -> DogfoodStageGaps {
  let g0 = DogfoodStageGaps { owed: [], refused: [] }
  let g1 = dogfood_stage_gap(acc: g0, stage: DogfoodRequest, reading: r.request)
  let g2 = dogfood_stage_gap(acc: g1, stage: DogfoodImmutableSubject, reading: r.immutable_subject)
  let g3 = dogfood_stage_gap(acc: g2, stage: DogfoodSharedComputation, reading: r.shared_computation)
  let g4 = dogfood_stage_gap(acc: g3, stage: DogfoodPlacementGrant, reading: r.placement_grant)
  let g5 = dogfood_stage_gap(acc: g4, stage: DogfoodIsolatedExecution, reading: r.isolated_execution)
  let g6 = dogfood_stage_gap(acc: g5, stage: DogfoodDurableResult, reading: r.durable_result)
  let g7 = dogfood_stage_gap(acc: g6, stage: DogfoodMetering, reading: r.metering)
  let g8 = dogfood_stage_gap(acc: g7, stage: DogfoodCleanup, reading: r.cleanup)
  let g9 = dogfood_stage_gap(acc: g8, stage: DogfoodResultReturned, reading: r.result_returned)
  let g10 = dogfood_stage_gap(acc: g9, stage: DogfoodCandidatePublished, reading: r.candidate_published)
  dogfood_stage_gap(acc: g10, stage: DogfoodIndependentReview, reading: r.independent_review)
}

fn dogfood_route_receipt(attempt_key: String, readings: DogfoodStageReadings) -> DogfoodRouteReceipt {
  let gaps = dogfood_stage_gaps(r: readings)
  if length(gaps.owed) == 0 && length(gaps.refused) == 0 {
    DogfoodRouteComplete { attempt_key: attempt_key, readings: readings }
  } else {
    DogfoodRouteIncomplete { attempt_key: attempt_key, owed: gaps.owed, refused: gaps.refused, readings: readings }
  }
}

// ── READING THE STAGES THE ROUTE ALREADY RECORDS ────────────────────────────────────────────────
//
// A stage with its own durable record today is read off that record's workflow segment, selected by
// gunbc.roadmap_workflow_stage workflow_segment_of_kind -- the same projection the dashboard and the
// continuation decision read, so this adds no second reader. Durable result is the SUBMISSION
// segment: the worker's candidate captured and committed at the head, which is the attempt's
// result, not verification's verdict on it. Complete establishes; Pending or
// Active is owed by the attempt itself (not reached yet); Failed, Refused or Stopped is the record
// saying the stage did not hold. An absent segment is a record defect and refuses.
fn dogfood_reading_from_segment(segment: WorkflowSegment?) -> DogfoodStageReading {
  match segment {
    Absent => StageRefused { reason: "the attempt's workflow projection carries no segment for this stage" }
    Present { value: s } =>
      match s.state {
        WorkflowSegmentComplete => StageEstablished { evidence: s.detail }
        WorkflowSegmentPending => StageOwed { owed_by: join(["the attempt has not reached this stage: ", s.detail], "") }
        WorkflowSegmentActive => StageOwed { owed_by: join(["the attempt is in this stage: ", s.detail], "") }
        WorkflowSegmentFailed => StageRefused { reason: s.detail }
        WorkflowSegmentRefused => StageRefused { reason: s.detail }
        WorkflowSegmentStopped => StageRefused { reason: s.detail }
      }
  }
}

// THE STAGES WITH NO RECORD OF THEIR OWN YET, each owed by the change that will write it. When a
// producer lands, its arm becomes a read of its record and the owed text is deleted -- the receipt
// never establishes a stage on a promise, nor on another stage's record. Request is not the
// dispatch environment's admission (that records a host's readiness, not who asked for what): it is
// the Claimed event that assigned the issue, joined to the attempt. Immutable subject is not a
// green verification (that records a verdict, not that the subject was fixed): it is the exact tree
// the shared computation was keyed on.
data dogfood_owed_request: String = "G4: the Claimed event that assigned the issue, joined to this attempt with its requester (gunbc.roadmap.roadmap_result_returned carries the join)"

data dogfood_owed_immutable_subject: String = "G1 cutover: the verified head's exact tree that the shared computation's request key was derived from"

data dogfood_owed_shared_computation: String = "G1 cutover: belt verify runs through the materialization provider (compute request family), citing the derived request key and the outcome identity"

data dogfood_owed_placement_grant: String = "G5: the agent session acquires a capacity lease before spawn"

data dogfood_owed_isolated_execution: String = "G5: the agent session runs in a systemd unit capped from its grant"

data dogfood_owed_metering: String = "G3: a per-attempt metering record totals tokens, seat seconds and compute"

data dogfood_owed_cleanup: String = "G5: release evidence for the session lease and every seat the attempt held"

data dogfood_owed_result_returned: String = "G4: a typed result event on the issue returns the outcome to the requester"

fn dogfood_route_readings(progress: WorkflowAttemptProgress) -> DogfoodStageReadings {
  DogfoodStageReadings {
    request: StageOwed { owed_by: dogfood_owed_request },
    immutable_subject: StageOwed { owed_by: dogfood_owed_immutable_subject },
    shared_computation: StageOwed { owed_by: dogfood_owed_shared_computation },
    placement_grant: StageOwed { owed_by: dogfood_owed_placement_grant },
    isolated_execution: StageOwed { owed_by: dogfood_owed_isolated_execution },
    durable_result: dogfood_reading_from_segment(segment: workflow_segment_of_kind(segments: progress.segments, kind: SubmissionWorkflowSegment)),
    metering: StageOwed { owed_by: dogfood_owed_metering },
    cleanup: StageOwed { owed_by: dogfood_owed_cleanup },
    result_returned: StageOwed { owed_by: dogfood_owed_result_returned },
    candidate_published: dogfood_reading_from_segment(segment: workflow_segment_of_kind(segments: progress.segments, kind: PublicationWorkflowSegment)),
    independent_review: dogfood_reading_from_segment(segment: workflow_segment_of_kind(segments: progress.segments, kind: ReviewWorkflowSegment)),
  }
}

fn dogfood_route_receipt_for_progress(progress: WorkflowAttemptProgress) -> DogfoodRouteReceipt {
  dogfood_route_receipt(attempt_key: progress.attempt_key, readings: dogfood_route_readings(progress: progress))
}

// ── THE ACCEPTANCE CASE, ON THE REAL ROUTE ──────────────────────────────────────────────────────
//
// The roadmap row's execution contract. It reads every attempt the srv2 deployment instance has
// published and holds when at least one folds to DogfoodRouteComplete. It is a plain function
// rather than a floor witness on purpose: its subject is a deployment's durable attempt records,
// which a CI runner does not have, so on the floor it could only ever be red for the wrong reason.
// The belt runs it on srv2 against the instance it describes. An observation the route cannot read
// is not a pass.
fn dogfood_route_acceptance_holds_on(instance: HostDashboardInstance) -> Bool {
  match belt_workflow_attempts_observe_for_instance(instance: instance) {
    WorkflowAttemptsRefused { reason: _ } => false
    WorkflowAttemptsObserved { attempts } =>
      length(filter(attempts, p => match dogfood_route_receipt_for_progress(progress: p) {
        DogfoodRouteComplete { attempt_key: _, readings: _ } => true
        DogfoodRouteIncomplete { attempt_key: _, owed: _, refused: _, readings: _ } => false
      })) > 0
  }
}

fn dogfood_route_acceptance_holds() -> Bool {
  dogfood_route_acceptance_holds_on(instance: srv2_deploy_dashboard_instance())
}
