// THE DOGFOOD ROUTE, AS ONE ACCEPTANCE CASE (operator ruling 2026-10-03). A request enters the
// factory and leaves as an independently reviewed, published candidate. Every stage is established
// by its OWN typed record, read from the same evidence observation the dashboard reduces (gunbc.
// roadmap_belt_actuate belt_workflow_attempt_evidence_for_ref), and the first attempt to complete
// is recorded once, durably, as the dogfood start receipt.
//
// THE ROUTE IS DECLARED IN PRODUCTION ORDER. The belt reviews a head after verification and
// publishes it only when the review (and goal audit) approved that head (belt_review_admission
// beside belt_publish_gate), so review precedes publication, and that is the order here. The
// causal binding is the head: the submission, the review and the publication receipt all speak of
// the attempt's one worktree head, and the publication evidence is admitted only when its receipt's
// expected head IS the captured submission's head.
type DogfoodStage
  = DogfoodRequest
  | DogfoodImmutableSubject
  | DogfoodSharedComputation
  | DogfoodPlacementGrant
  | DogfoodIsolatedExecution
  | DogfoodDurableResult
  | DogfoodMetering
  | DogfoodIndependentReview
  | DogfoodCandidatePublished
  | DogfoodCleanup
  | DogfoodResultReturned

fn dogfood_stage_wire(stage: DogfoodStage) -> String {
  match stage {
    DogfoodRequest => "request"
    DogfoodImmutableSubject => "immutable-subject"
    DogfoodSharedComputation => "shared-computation"
    DogfoodPlacementGrant => "placement-grant"
    DogfoodIsolatedExecution => "isolated-execution"
    DogfoodDurableResult => "durable-result"
    DogfoodMetering => "metering"
    DogfoodIndependentReview => "independent-review"
    DogfoodCandidatePublished => "candidate-published"
    DogfoodCleanup => "cleanup"
    DogfoodResultReturned => "result-returned"
  }
}

// ── STAGE-SPECIFIC EVIDENCE ─────────────────────────────────────────────────────────────────────
//
// Each established stage carries its own evidence type, constructible only here and only from the
// producer's decoded record, so one record cannot stand for two stages: a review report cannot be
// placed where the submission goes, and no caller can mint evidence from prose.
type SubmissionEvidence sole_constructor {
  attempt_key: String
  head_sha: String
  digest: String
}

type ReviewEvidence sole_constructor {
  subject: String
  plan_revision: String
}

type PublicationEvidence sole_constructor {
  head_sha: String
  pr_number: Int
  url: String
}

type StageGap
  = StageOwed { owed_by: String }
  | StageRefused { reason: String }

type SubmissionReading
  = SubmissionEstablished { evidence: SubmissionEvidence }
  | SubmissionGap { gap: StageGap }

type ReviewReading
  = ReviewEstablished { evidence: ReviewEvidence }
  | ReviewGap { gap: StageGap }

type PublicationReading
  = PublicationEstablished { evidence: PublicationEvidence }
  | PublicationGap { gap: StageGap }

// A STAGE WITH NO PRODUCER YET HAS NO ESTABLISHED ARM AT ALL. When its producer lands it gains its
// own evidence type and reading, exactly as the three above; until then nothing can claim it.
type ProducerPendingReading
  = ProducerPending { owed_by: String }

// ONE FIELD PER STAGE, each of its own reading type.
type DogfoodStageReadings {
  request: ProducerPendingReading
  immutable_subject: ProducerPendingReading
  shared_computation: ProducerPendingReading
  placement_grant: ProducerPendingReading
  isolated_execution: ProducerPendingReading
  durable_result: SubmissionReading
  metering: ProducerPendingReading
  independent_review: ReviewReading
  candidate_published: PublicationReading
  cleanup: ProducerPendingReading
  result_returned: ProducerPendingReading
}

// COMPLETE CARRIES THE EVIDENCE, NOT A FLAG. The arm is built only by dogfood_route_receipt, and only
// when every stage is established -- which, while eight stages have no producer, it cannot be.
type DogfoodRouteReceipt
  = DogfoodRouteComplete { node_id: String, attempt_key: String, submission: SubmissionEvidence, review: ReviewEvidence, publication: PublicationEvidence }
  | DogfoodRouteIncomplete { node_id: String, attempt_key: String, owed: List<DogfoodStage>, refused: List<DogfoodStage> }

type DogfoodStageGaps {
  owed: List<DogfoodStage>
  refused: List<DogfoodStage>
}

fn dogfood_gap(acc: DogfoodStageGaps, stage: DogfoodStage, gap: StageGap) -> DogfoodStageGaps {
  match gap {
    StageOwed { owed_by: _ } => DogfoodStageGaps { owed: concat(acc.owed, [stage]), refused: acc.refused }
    StageRefused { reason: _ } => DogfoodStageGaps { owed: acc.owed, refused: concat(acc.refused, [stage]) }
  }
}

fn dogfood_pending(acc: DogfoodStageGaps, stage: DogfoodStage, r: ProducerPendingReading) -> DogfoodStageGaps {
  match r {
    ProducerPending { owed_by: _ } => DogfoodStageGaps { owed: concat(acc.owed, [stage]), refused: acc.refused }
  }
}

fn dogfood_route_receipt(node_id: String, attempt_key: String, r: DogfoodStageReadings) -> DogfoodRouteReceipt {
  let g0 = DogfoodStageGaps { owed: [], refused: [] }
  let g1 = dogfood_pending(acc: g0, stage: DogfoodRequest, r: r.request)
  let g2 = dogfood_pending(acc: g1, stage: DogfoodImmutableSubject, r: r.immutable_subject)
  let g3 = dogfood_pending(acc: g2, stage: DogfoodSharedComputation, r: r.shared_computation)
  let g4 = dogfood_pending(acc: g3, stage: DogfoodPlacementGrant, r: r.placement_grant)
  let g5 = dogfood_pending(acc: g4, stage: DogfoodIsolatedExecution, r: r.isolated_execution)
  let g6 = match r.durable_result {
    SubmissionEstablished { evidence: _ } => g5
    SubmissionGap { gap } => dogfood_gap(acc: g5, stage: DogfoodDurableResult, gap: gap)
  }
  let g7 = dogfood_pending(acc: g6, stage: DogfoodMetering, r: r.metering)
  let g8 = match r.independent_review {
    ReviewEstablished { evidence: _ } => g7
    ReviewGap { gap } => dogfood_gap(acc: g7, stage: DogfoodIndependentReview, gap: gap)
  }
  let g9 = match r.candidate_published {
    PublicationEstablished { evidence: _ } => g8
    PublicationGap { gap } => dogfood_gap(acc: g8, stage: DogfoodCandidatePublished, gap: gap)
  }
  let g10 = dogfood_pending(acc: g9, stage: DogfoodCleanup, r: r.cleanup)
  let gaps = dogfood_pending(acc: g10, stage: DogfoodResultReturned, r: r.result_returned)
  if length(gaps.owed) == 0 && length(gaps.refused) == 0 {
    match r.durable_result {
      SubmissionGap { gap: _ } => DogfoodRouteIncomplete { node_id: node_id, attempt_key: attempt_key, owed: gaps.owed, refused: gaps.refused }
      SubmissionEstablished { evidence: s } =>
        match r.independent_review {
          ReviewGap { gap: _ } => DogfoodRouteIncomplete { node_id: node_id, attempt_key: attempt_key, owed: gaps.owed, refused: gaps.refused }
          ReviewEstablished { evidence: v } =>
            match r.candidate_published {
              PublicationGap { gap: _ } => DogfoodRouteIncomplete { node_id: node_id, attempt_key: attempt_key, owed: gaps.owed, refused: gaps.refused }
              PublicationEstablished { evidence: p } => DogfoodRouteComplete { node_id: node_id, attempt_key: attempt_key, submission: s, review: v, publication: p }
            }
        }
    }
  } else {
    DogfoodRouteIncomplete { node_id: node_id, attempt_key: attempt_key, owed: gaps.owed, refused: gaps.refused }
  }
}

// ── READING EACH STAGE FROM ITS OWN RECORD ──────────────────────────────────────────────────────

fn dogfood_submission_reading(attempt_key: String, capture: SubmissionCaptureObservation) -> SubmissionReading {
  match capture {
    CaptureForHead { capture: c } =>
      SubmissionEstablished { evidence: SubmissionEvidence { attempt_key: attempt_key, head_sha: c.head_sha, digest: c.digest } }
    CaptureAbsent => SubmissionGap { gap: StageOwed { owed_by: "the worker has not captured a submission at its head" } }
    CaptureUnreadable { reason } => SubmissionGap { gap: StageRefused { reason: reason } }
  }
}

// THE REVIEW NAMES ITS SUBJECT AS node@head (gunbc.roadmap.roadmap_review_function review_subject_id),
// computed in the same evidence read as the submission capture from the same worktree head, so the
// subject recorded here is the submission's head.
fn dogfood_review_reading(node_id: String, head_sha: String, report: ReviewReport) -> ReviewReading {
  match report.reconciliation.state {
    WorkflowSegmentComplete => ReviewEstablished { evidence: ReviewEvidence { subject: join([node_id, "@", head_sha], ""), plan_revision: report.plan_revision } }
    WorkflowSegmentPending => ReviewGap { gap: StageOwed { owed_by: join(["review has not run on this head: ", report.reconciliation.detail], "") } }
    WorkflowSegmentActive => ReviewGap { gap: StageOwed { owed_by: join(["review is running on this head: ", report.reconciliation.detail], "") } }
    WorkflowSegmentFailed => ReviewGap { gap: StageRefused { reason: report.reconciliation.detail } }
    WorkflowSegmentRefused => ReviewGap { gap: StageRefused { reason: report.reconciliation.detail } }
    WorkflowSegmentStopped => ReviewGap { gap: StageRefused { reason: report.reconciliation.detail } }
  }
}

// PUBLICATION IS ADMITTED ONLY ON A RECEIPT FOR THIS SUBJECT whose expected head is the captured
// submission's head and whose outcome binds a pull request at that head.
fn dogfood_publication_reading(head_sha: String, subject: PublicationSubjectObservation, evidence_source: gunbc.roadmap_publish.PublicationReceiptSource) -> PublicationReading {
  match subject {
    PublicationSubjectUnobserved { reason } => PublicationGap { gap: StageOwed { owed_by: reason } }
    PublicationSubjectObserved { subject: s } =>
      if (s.expected_head as String) != head_sha {
        PublicationGap { gap: StageRefused { reason: join(["the publication subject's head ", s.expected_head as String, " is not the captured submission's head ", head_sha], "") } }
      } else {
        match publication_evidence_for(expected: s, source: evidence_source) {
          EvidenceAbsent => PublicationGap { gap: StageOwed { owed_by: "no publication receipt for this head yet" } }
          EvidenceUnreadable { reason } => PublicationGap { gap: StageRefused { reason: reason } }
          EvidenceForAnotherSubject { field, expected: _, found: _ } => PublicationGap { gap: StageRefused { reason: join(["the publication receipt is for another subject (", field as String, ")"], "") } }
          EvidenceForSubject { receipt } =>
            match receipt.outcome {
              ReceiptBound { pr_number, url, draft: _ } => PublicationEstablished { evidence: PublicationEvidence { head_sha: head_sha, pr_number: pr_number, url: url as String } }
              ReceiptHeadDiverged { pr_number: _, pr_head: _, url: _ } => PublicationGap { gap: StageRefused { reason: "the pull request's head diverged from the submission's head" } }
              ReceiptBindingAmbiguous { pr_numbers: _ } => PublicationGap { gap: StageRefused { reason: "more than one pull request binds the branch" } }
              ReceiptRemoteBranchAtHeadWithoutPullRequest { head_sha: _ } => PublicationGap { gap: StageOwed { owed_by: "the branch is pushed at the head but no pull request exists yet" } }
              ReceiptRemoteBranchHeadDiverged { remote_head: _ } => PublicationGap { gap: StageRefused { reason: "the remote branch head diverged from the submission's head" } }
              ReceiptRemoteBranchBindingAmbiguous { refs_matched: _ } => PublicationGap { gap: StageRefused { reason: "the remote branch binding is ambiguous" } }
              ReceiptBranchNotPublished { remote_branches_seen: _ } => PublicationGap { gap: StageOwed { owed_by: "the branch is not published yet" } }
              ReceiptObservationRefused { detail } => PublicationGap { gap: StageRefused { reason: detail } }
            }
        }
      }
  }
}

// THE STAGES WITH NO RECORD OF THEIR OWN YET, each owed by the change that will write it.
data dogfood_owed_request: String = "G4: the Claimed event that assigned the issue, joined to this attempt with its requester (gunbc.roadmap.roadmap_result_returned carries the join)"

data dogfood_owed_immutable_subject: String = "G1 cutover: the verified head's exact tree that the shared computation's request key was derived from"

data dogfood_owed_shared_computation: String = "G1 cutover: belt verify runs through the materialization provider (compute request family), citing the derived request key and the outcome identity"

data dogfood_owed_placement_grant: String = "G5: the agent session acquires a capacity lease before spawn"

data dogfood_owed_isolated_execution: String = "G5: the agent session runs in a systemd unit capped from its grant"

data dogfood_owed_metering: String = "G3: a per-attempt metering record totals tokens, seat seconds and compute"

data dogfood_owed_cleanup: String = "G5: release evidence for the session lease and every seat the attempt held"

data dogfood_owed_result_returned: String = "G4: a typed result event on the issue returns the outcome to the requester"

fn dogfood_route_readings(e: WorkflowAttemptEvidence) -> DogfoodStageReadings {
  let submission = dogfood_submission_reading(attempt_key: e.attempt_key, capture: e.submission_capture)
  let head = match submission {
    SubmissionEstablished { evidence: s } => s.head_sha
    SubmissionGap { gap: _ } => ""
  }
  DogfoodStageReadings {
    request: ProducerPending { owed_by: dogfood_owed_request },
    immutable_subject: ProducerPending { owed_by: dogfood_owed_immutable_subject },
    shared_computation: ProducerPending { owed_by: dogfood_owed_shared_computation },
    placement_grant: ProducerPending { owed_by: dogfood_owed_placement_grant },
    isolated_execution: ProducerPending { owed_by: dogfood_owed_isolated_execution },
    durable_result: submission,
    metering: ProducerPending { owed_by: dogfood_owed_metering },
    independent_review: if head == "" { ReviewGap { gap: StageOwed { owed_by: "no captured submission, so no head to review" } } } else { dogfood_review_reading(node_id: e.node_id, head_sha: head, report: e.review) },
    candidate_published: if head == "" { PublicationGap { gap: StageOwed { owed_by: "no captured submission, so no head to publish" } } } else { dogfood_publication_reading(head_sha: head, subject: e.publication_subject, evidence_source: e.publication_source) },
    cleanup: ProducerPending { owed_by: dogfood_owed_cleanup },
    result_returned: ProducerPending { owed_by: dogfood_owed_result_returned },
  }
}

fn dogfood_route_receipt_for_evidence(e: WorkflowAttemptEvidence) -> DogfoodRouteReceipt {
  dogfood_route_receipt(node_id: e.node_id, attempt_key: e.attempt_key, r: dogfood_route_readings(e: e))
}

// ── THE START RECEIPT: FIRST ONLY, DURABLE ──────────────────────────────────────────────────────
//
// The receipt that starts the dogfood clock is written ONCE, create-only, through the durable
// compare-and-set store (gunbc.durable_cas_file_store file_compare_and_set, ExpectSlotAbsent): the
// first complete attempt to be recorded stays the start forever, and a later or newer attempt --
// complete or not -- cannot move it. It is produced by the belt tick right after its own passes:
// the candidate-published stage is written BY that tick's publish pass, so the completing attempt is
// necessarily the node's current attempt when the tick observes it, and nothing can supersede it
// between completing and being recorded. Two attempts completing in one tick are taken in the
// observation's own order -- git for-each-ref's refname order over refs/heads/dispatch/ -- so the
// choice is deterministic.
data dogfood_start_receipt_key: NonEmptyStr = "dogfood-start-receipt" as NonEmptyStr

data dogfood_start_receipt_schema: String = "dogfood-start-receipt/v1"

fn dogfood_start_store_root(instance: HostDashboardInstance) -> NonEmptyStr {
  join([instance.instance_root as String, "/dogfood-start"], "") as NonEmptyStr
}

fn dogfood_start_receipt_wire(c: DogfoodRouteReceipt, established_at: String) -> String? {
  match c {
    DogfoodRouteIncomplete { node_id: _, attempt_key: _, owed: _, refused: _ } => none
    DogfoodRouteComplete { node_id, attempt_key, submission, review, publication } =>
      Present { value: serialize_json(v: json_object([
        json_kv(key: "schema", value: json_string(s: dogfood_start_receipt_schema)),
        json_kv(key: "node_id", value: json_string(s: node_id)),
        json_kv(key: "attempt_key", value: json_string(s: attempt_key)),
        json_kv(key: "head_sha", value: json_string(s: submission.head_sha)),
        json_kv(key: "submission_digest", value: json_string(s: submission.digest)),
        json_kv(key: "review_subject", value: json_string(s: review.subject)),
        json_kv(key: "review_plan_revision", value: json_string(s: review.plan_revision)),
        json_kv(key: "pr_number", value: json_int(n: publication.pr_number)),
        json_kv(key: "pr_url", value: json_string(s: publication.url)),
        json_kv(key: "established_at", value: json_string(s: established_at)),
      ])) }
  }
}

// The first complete receipt in observation order.
fn dogfood_first_complete(receipts: List<DogfoodRouteReceipt>) -> DogfoodRouteReceipt? {
  fold(receipts, init: none, f: (acc, r) => match acc {
    Present { value: _ } => acc
    Absent =>
      match r {
        DogfoodRouteIncomplete { node_id: _, attempt_key: _, owed: _, refused: _ } => none
        DogfoodRouteComplete { node_id: _, attempt_key: _, submission: _, review: _, publication: _ } => Present { value: r }
      }
  })
}

type DogfoodStartRecord
  = DogfoodStartRecorded { receipt: String }
  | DogfoodStartAlreadyRecorded
  | DogfoodStartNoCompleteAttempt
  | DogfoodStartRefused { reason: String }

fn dogfood_start_record_for_instance(instance: HostDashboardInstance) -> DogfoodStartRecord {
  match belt_workflow_attempt_evidences_observe_for_instance(instance: instance) {
    WorkflowAttemptEvidencesRefused { reason } => DogfoodStartRefused { reason: reason }
    WorkflowAttemptEvidencesObserved { evidences } =>
      match dogfood_first_complete(receipts: map(evidences, e => dogfood_route_receipt_for_evidence(e: e))) {
        Absent => DogfoodStartNoCompleteAttempt
        Present { value: first } => {
          let at = belt_tick_observed_at()
          match dogfood_start_receipt_wire(c: first, established_at: at) {
            Absent => DogfoodStartNoCompleteAttempt
            Present { value: wire } =>
              match admit_cas_attempt_for_derived_payload(key: dogfood_start_receipt_key, expected: ExpectSlotAbsent, proposed: wire as NonEmptyStr) {
                DerivedPayloadKeyNotSlotAddressable { key: _ } => DogfoodStartRefused { reason: "the start receipt key is not slot-addressable" }
                DerivedPayloadAdmitted { verified } =>
                  match file_compare_and_set(root: dogfood_start_store_root(instance: instance), publication: DefaultAccessCreateOnly, verified: verified) {
                    CasCommitted { committed: _ } => DogfoodStartRecorded { receipt: wire }
                    CasPreconditionFailed { expected: _, observed: _ } => DogfoodStartAlreadyRecorded
                    CasStoreRefused { cause: _ } => DogfoodStartRefused { reason: "the start receipt store refused the create-only write" }
                  }
              }
          }
        }
      }
  }
}

// ── THE ACCEPTANCE CASE ─────────────────────────────────────────────────────────────────────────
//
// The roadmap row's execution contract READS the start receipt; it does not recompute a current
// state. It holds exactly when the slot holds a receipt of this schema naming an attempt. It is a
// plain function rather than a floor witness: its subject is a deployment's durable store, which a
// CI runner does not have. An unreadable slot is not a pass.
fn dogfood_start_receipt_names_an_attempt(payload: String) -> Bool {
  match parse_json_document(s: payload) {
    JsonDocumentUnreadable { gap: _ } => false
    JsonDocumentParsed { value: v } =>
      (match json_field_string(obj: v, key: "schema") {
        FieldRead { value: s } => s == dogfood_start_receipt_schema
        FieldAbsent => false
        FieldMalformed { cause: _ } => false
      }) && (match json_field_string(obj: v, key: "attempt_key") {
        FieldRead { value: k } => k != ""
        FieldAbsent => false
        FieldMalformed { cause: _ } => false
      })
  }
}

fn dogfood_route_acceptance_holds_on(instance: HostDashboardInstance) -> Bool {
  match observe_cas_slot_state(root: dogfood_start_store_root(instance: instance), key: dogfood_start_receipt_key) {
    CasObservedUnreadable { cause: _ } => false
    CasObservedReadable { readable } =>
      match readable {
        CasReadableAbsent => false
        CasReadablePresent { version } => dogfood_start_receipt_names_an_attempt(payload: version.value as String)
      }
  }
}

fn dogfood_route_acceptance_holds() -> Bool {
  dogfood_route_acceptance_holds_on(instance: srv2_deploy_dashboard_instance())
}
