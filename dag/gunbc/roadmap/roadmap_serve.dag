// The gunbc-served dashboard instantiation (docs/plans/gunbc-served-dashboard-design.md; belt B,
// parent-approved 2026-07-20). H = RoadmapServeHandler: every row is a DynamicRoute whose handler
// calls the SAME authority the static-site artifacts call (roadmap_page, roadmap_static_site) — the
// artifact table and this serve table are two projections of one authority set, never two copies of
// content, and every body is computed at request time so the served page is the LIVE roadmap, not a
// deploy-frozen snapshot (the section-3 dual-representation cost this module exists to remove).
// Dispatch: POST /dispatch/NODE_ID invokes gunbc.roadmap_belt_actuate.belt_dispatch_node IN-PROCESS
// — the single dispatch authority (#6914), no emitted JS, no subprocess exec, no env-var channel.
// The launch button that POSTs here is transport-agnostic and lands with belt A in roadmap_page
// (lane agreement 2026-07-20): the page never knows which backend answers.

data roadmap_serve_interpreted_scaffold: Disposition = Scaffold {
  dissolves_to: RealizationDispatch,
  bind: DeclarationRef {
    module_path: "gunbc.roadmap_serve",
    decl_name: "roadmap_serve_handle",
    field: WholeDeclaration
  }
}

// ROADMAP section-4 rules a NEW long-running interpreted workload a review reject, routed through
// emit-on-demand. gunbc serve under the tree-walker is exactly that workload, so it lands as this
// DECLARED scaffold: dissolution = emit-on-demand of the serve closure (emit -> build -> run
// native, artifact shared by content-hash — the same lane as the S1 parse census receipt). Interim
// cost is bounded and strictly better than the belt-A alternative it supersedes: A pays a full CLI
// startup (load + compile + resolve) per dispatch click; this process pays it once at bind time.

// THE SOCKET SEAM WAS RESTORED ON 2026-08-19, AND THIS ROW RECORDS WHY THAT IS A REPAIR RATHER THAN
// NEW DEBT. #8286 deleted the cli_run driver surface and took `serve` and `converge` out as ONE
// population; the two are not the same case, and deleting them together is what made it wrong.
// Converge has a successor that EXISTS -- the modeled convergence spine, fleet_converge_timer ->
// fleet_converge_apply -> host_effect_realize -- so its verb can refuse and route there. Serve's
// declared successor is the scaffold ABOVE, roadmap_serve_interpreted_scaffold, dissolving to
// emit-on-demand of the serve closure, and it was never built. So the deletion removed a live
// outward-facing production route with no minimal Y able to hold the boundary, which is precisely
// the case DESIGN section 3 carves out: a gap-intolerant boundary keeps the staged form, and where
// no Y can hold it at all X stays but stays FROZEN. What the restore does is put X back and freeze
// it.
//
// MEASURED, NOT ASSUMED, because the cost of the repair turned on one fact. The retained engine
// still evaluates this module completely: roadmap_serve_witness_test runs 16/16 green against a
// binary built from the post-deletion tree, covering route selection, 404 and 501 folding, and
// dispatch-refuses-before-effects. What #8286 removed was the SOCKET SEAM only -- accept, minimal
// HTTP/1.1 parse, response write -- which its own surviving doc comment still described after the
// code was gone. The deletion left the prose and took the machinery, so the restore is a quarry
// revert into comments that already marked the insertion points, not new authoring.
//
// NO SECOND OBLIGATION IS REGISTERED, DELIBERATELY. The scaffold above already binds
// roadmap_serve_handle and already names the correct terminal, so its dissolution IS this seam's
// restoration trigger; a fresh row beside it would be two obligations over one independently
// removable unit, which DESIGN section 5 forbids. FROZEN MEANS: no new options, no new verbs, no
// new routes into the interpreter, no completion work, no flag or environment gate re-opening it --
// an escape hatch is refused outright and would be a NewEscapeHatchOrAdmissionRow under
// gunbc.v1_maintenance_standing besides.
//
// THE DELETED REFUSAL'S SUBSTANTIVE CLAIM IS NOT RETRACTED. Serve remains a desired SERVICE
// OCCURRENCE that convergence should observe and reconcile rather than a command, and it cannot be
// modeled that way today because gunbc.host_effect carries only the LiveDeployApply /
// LiveDeployRetract / LiveDeployEnsureDependency triple and the runner-slot family -- no generic
// service-occurrence member exists. That absence is why BOTH bring-up paths must name a command:
// the systemd unit through gunbc.live_deploy.emit, and the tmux path through
// gunbc.roadmap_dashboard_instance dashboard_instance_serve_argv. Registering that member is
// separate work and is the thing that stops this recurring.
//
// THE ENGINE OBJECTION IS RECORDED RATHER THAN ARGUED AWAY. This does make the interpreter
// load-bearing for a capability two lanes are deleting -- the propagation consequence DESIGN
// section 3 names. It is not a NEW dependency; it is the one that stood until #8286. But if this
// route begins attracting completion work or performance work on the interpreted loop, the freeze
// has been repealed by drift, which is the standing danger gunbc.v1_maintenance_standing
// v1_seed_standing already warns about for the active-maintenance arm.

type RoadmapServeHandler
  = RoadmapDailyPageHandler
  | AllocationPageHandler
  | SiteFaviconHandler
  | SiteClientHandler
  | WebFontStylesheetHandler
  | AllocationCreateHandler
  | AllocationListHandler
  | AllocationGetHandler
  | AllocationReleaseHandler
  | AllocationClientHandler
  | FleetStandingPageHandler
  | SpecimenPageHandler
  | DispatchJsonHandler
  | HealthzHandler
  | DashboardInstanceHandler
  | ProviderReadinessHandler
  | BeltDispatchHandler
  | DispatchAssetHandler
  | SessionsJsonHandler
  | AttemptsJsonHandler
  | WorkflowJsonHandler
  | ObservationJsonHandler
  | BeltStopHandler
  | BeltPublishHandler
  | ApprovalBrokerCutoverHandler { route: ApprovalBrokerHandler }
  | IssueDetailPageHandler
  | IssueAssignHandler
  | IssueAssignmentContextHandler
  | IssueQueryHandler
  | IssueViewPreferencesReadHandler
  | IssueViewPreferencesSaveHandler
  | IssueCommentHandler
  | AuthSessionHandler
  | AuthLoginHandler
  | AuthGoogleCallbackHandler
  | AuthLogoutHandler

// Fail-closed table construction (review 40286, the section 5 catch: the earlier serve_tpl mapped
// MalformedPathTemplate to an EMPTY template, and an empty template matches exactly '/' — so a typo
// in any route literal would have silently become a second root matcher, a widen at the very seam
// section 5 forbids). THE BUILD ITSELF NO LONGER LIVES HERE. It was this module's, monomorphic over
// this module's handler vocabulary, and the approval-broker split gave it a second instantiation —
// at which point copying it would have been section 2's duplicated work at the exact seam where a
// divergence is invisible. It is now extdeps.http.server serve_build_route_table, generic in the
// handler, beside the selection fold it has always been the same layer as; this module supplies the
// rows and consumes the typed refusal. The RED control moved with it and still runs here
// (witness_malformed_route_literal_refuses_table: a bad literal through the same build fold ->
// Refused).

// THE SERVED PATH IS ONE FACT. gunbc.roadmap_site_surface_render already declared each of these
// paths as data -- the static site, the surface-observation bundle and the deploy witnesses all
// cite those constants -- while these rows carried a second spelling of the same string. Two copies
// of a path agree until one moves, and the one that moves silently is the one nothing reads back:
// a witness spelling "/roadmap.md" reaches a 404 and asserts nothing (review 63317, and the
// operator's live check against the running instance). The rows now consume the declaration, so a
// renamed route moves the routing table, the static artifact and every witness together.
// THE ONE FACT THE SERVING PROCESS CANNOT OBSERVE, DECLARED SO IT CAN REFUSE.
//
// Route / is served from a body the BELT TICK rendered, under whatever plan that process held. The
// stored body carries no identity of the authority it came from, so a serving process handed a
// plan cannot check whether the body agrees with it -- the class is filed as
// gunbc.recurring_failure_mode.a_prerendered_body_carries_no_identity_of_its_source.
//
// That made this entry's plan parameter a constructor for silent wrongness: before the parameter
// existed no caller COULD diverge, and DESIGN 4b puts silent wrongness outside the ladder and
// forbids it outright rather than admitting it at a low rung. A note saying so is not a refusal
// (4c), so the honest arm available today is the one 5 names: refuse, never widen.
//
// The agreement is therefore a DECLARED fact of the call rather than something inferred. A caller
// whose own tick renders the daily body under the same plan says so and is served; a caller that
// cannot say so gets a located refusal on that ONE route, and every other route still answers from
// its plan. This is 4b's "outside the modeled guarantee" column handled at a declared boundary --
// observed, refused, or mitigated, never fabricated -- not a fifth rung and not a proof.

type ServedDailyBodyAuthority
  = DailyBodyRenderedUnderThisPlan
  | DailyBodyAuthorityUnknown

fn roadmap_serve_own_route_specs() -> List<ServedRouteSpec<RoadmapServeHandler>> {
  [
    ServedRouteSpec { method: GET, raw: roadmap_site_daily_url_path as String, handler: RoadmapDailyPageHandler },
    ServedRouteSpec { method: POST, raw: allocation_page_path, handler: AllocationCreateHandler },
    ServedRouteSpec { method: GET, raw: allocation_list_path, handler: AllocationListHandler },
    ServedRouteSpec { method: GET, raw: allocation_item_route(), handler: AllocationGetHandler },
    ServedRouteSpec { method: POST, raw: allocation_release_route(), handler: AllocationReleaseHandler },
    ServedRouteSpec { method: GET, raw: allocation_page_path, handler: AllocationPageHandler },
    ServedRouteSpec { method: GET, raw: site_favicon_path, handler: SiteFaviconHandler },
    ServedRouteSpec { method: GET, raw: site_client_path, handler: SiteClientHandler },
    ServedRouteSpec { method: GET, raw: web_font_stylesheet_path(), handler: WebFontStylesheetHandler },
    ServedRouteSpec { method: GET, raw: allocation_client_path, handler: AllocationClientHandler },
    ServedRouteSpec { method: GET, raw: "/fleet", handler: FleetStandingPageHandler },
    ServedRouteSpec { method: GET, raw: specimen_route_path, handler: SpecimenPageHandler },
    ServedRouteSpec { method: GET, raw: roadmap_site_dispatch_url_path as String, handler: DispatchJsonHandler },
    ServedRouteSpec { method: GET, raw: roadmap_site_health_path as String, handler: HealthzHandler },
    ServedRouteSpec { method: GET, raw: "/instance.json", handler: DashboardInstanceHandler },
    ServedRouteSpec { method: GET, raw: "/provider.json", handler: ProviderReadinessHandler },
    ServedRouteSpec { method: GET, raw: "/sessions.json", handler: SessionsJsonHandler },
    ServedRouteSpec { method: GET, raw: "/attempts.json", handler: AttemptsJsonHandler },
    ServedRouteSpec { method: GET, raw: "/workflow.json", handler: WorkflowJsonHandler },
    ServedRouteSpec { method: GET, raw: "/observation.json", handler: ObservationJsonHandler },
    ServedRouteSpec { method: GET, raw: roadmap_dispatch_asset_path, handler: DispatchAssetHandler },
    ServedRouteSpec { method: POST, raw: "/dispatch/\{node_id\}", handler: BeltDispatchHandler },
    ServedRouteSpec { method: GET, raw: "/issue/\{node_id\}", handler: IssueDetailPageHandler },
    ServedRouteSpec { method: GET, raw: "/issue/\{node_id\}/assignment", handler: IssueAssignmentContextHandler },
    ServedRouteSpec { method: POST, raw: "/issue/\{node_id\}/assign", handler: IssueAssignHandler },
    ServedRouteSpec { method: POST, raw: "/issue/\{node_id\}/comment", handler: IssueCommentHandler },
    ServedRouteSpec { method: GET, raw: "/auth/session", handler: AuthSessionHandler },
    ServedRouteSpec { method: POST, raw: "/issues/query", handler: IssueQueryHandler },
    ServedRouteSpec { method: GET, raw: "/preferences/issues", handler: IssueViewPreferencesReadHandler },
    ServedRouteSpec { method: POST, raw: "/preferences/issues", handler: IssueViewPreferencesSaveHandler },
    ServedRouteSpec { method: GET, raw: auth_login_route_path, handler: AuthLoginHandler },
    ServedRouteSpec { method: GET, raw: "/auth/google/callback", handler: AuthGoogleCallbackHandler },
    ServedRouteSpec { method: POST, raw: auth_logout_route_path, handler: AuthLogoutHandler },
    ServedRouteSpec { method: POST, raw: "/publish/\{node_id\}", handler: BeltPublishHandler },
    ServedRouteSpec { method: POST, raw: "/cleanup/\{node_id\}", handler: BeltStopHandler },
    ServedRouteSpec { method: POST, raw: "/stop/\{node_id\}", handler: BeltStopHandler },
  ]
}

// THE LIVE TABLE IS THIS MODULE'S OWN ROWS PLUS THE ROWS IT IS STILL MOUNTING FOR THE BROKER MID-
// CUTOVER, and the split into two producers is what makes stage 6 a deletion rather than an edit
// inside a list of thirty literals.
fn roadmap_serve_route_specs() -> List<ServedRouteSpec<RoadmapServeHandler>> {
  concat(roadmap_serve_own_route_specs(), roadmap_serve_approval_cutover_route_specs())
}

fn roadmap_serve_route_table_build() -> ServedRouteTableBuild<RoadmapServeHandler> {
  serve_build_route_table(specs: roadmap_serve_route_specs())
}

fn serve_text_response(status: HttpStatus, content_type: MediaType, body: String) -> ServeHttpResponse {
  ServeHttpResponse { status: status, content_type: content_type, body: body, headers: [] }
}

// A page render refusal is a TYPED 500 carrying the emitter's reason — never an empty page and
// never a dropped route (the EmitRejected => [] route-drop in node_http_server_emit is a silent
// widen this path deliberately does not copy; DESIGN 5). The BODY of both arms is
// roadmap_static_site.served_page_body, shared with the healthz digest map rather than spelled
// twice: healthz publishes the digest of the served surface so a deploy can prove the running
// process is serving THIS tree, and a digest taken over a body that is merely supposed to match the
// route's would be validation standing where construction was available — the check would go green
// while the route lied. Only the STATUS split lives here, because a digest has no status.

// The self-hosted face stylesheet (gunbc.site.web_fonts). Its path is content-addressed, so the
// response is immutable under that path for as long as any client may hold it.
fn web_font_stylesheet_response() -> ServeHttpResponse {
  ServeHttpResponse {
    status: 200,
    content_type: text_css_utf8,
    body: web_font_stylesheet(),
    headers: [ServeResponseHeaderCacheImmutable { max_age_seconds: web_font_stylesheet_max_age_seconds }],
  }
}

fn serve_page_response(page: Fragment) -> ServeHttpResponse {
  match try_serialize_html_source(node: page) {
    EmitOk { html: h } =>
      serve_text_response(status: 200, content_type: text_html_utf8, body: h)
    EmitRejected { reason: r } =>
      serve_text_response(
        status: 500,
        content_type: text_plain_utf8,
        body: page_render_refusal_body(reason: r),
      )
  }
}

fn serve_page_response_with_status(page: Fragment, status: HttpStatus) -> ServeHttpResponse {
  match try_serialize_html_source(node: page) {
    EmitOk { html } => serve_text_response(status: status, content_type: text_html_utf8, body: html)
    EmitRejected { reason } => serve_text_response(
      status: 500,
      content_type: text_plain_utf8,
      body: page_render_refusal_body(reason: reason),
    )
  }
}

// TOTAL per-arm status mapping over the route's outcome (DESIGN 5): every BeltSpawnOutcome arm and
// every LaunchRefusal arm has its own row in launch_refusal_http_status -- no lazy 200-or-500
// collapse. Spawned and LaunchAlreadyLive = 200 (the click achieved or already holds the desired
// state, the same idempotent-success fold the CLI exit map uses); LaunchNoActuatingInstance and
// LaunchInstanceActuationRefused = 403 (no actuating instance stands behind the request);
// LaunchNodeUnknown = 404; the state conflicts (superseded, accepted, review-only, unsized,
// contract missing, centering absent, dependencies blocked, stale or conflicting session, capacity, cause not
// permitted by mode) = 409, retryable only after the state changes; the observation refusals
// (transition inhibited, revision unobserved or drifted, authority unobserved, sessions
// unobservable, liveness unobserved, gate not evaluated) = 503, a retry can succeed; SpawnFailed =
// 502 (actuation behind the server failed; the receipt carries step, detail and the admitted launch
// identity).

fn launch_refusal_http_status(r: LaunchRefusal) -> HttpStatus {
  match r {
    LaunchAlreadyLive { session_name: _ } => 200
    LaunchNoActuatingInstance { reason: _ } => 403
    LaunchInstanceActuationRefused { instance_id: _, reason: _ } => 403
    LaunchNodeUnknown => 404
    LaunchNotReady { missing: _ } => 409
    LaunchNoCapacity { occupied: _, max_concurrent: _ } => 409
    LaunchCauseNotPermitted { cause: _, mode: _ } => 409
    LaunchStaleSession { session_name: _, detail: _ } => 409
    LaunchTransitionInhibited { reason: _ } => 409
    LaunchSessionMultiplicityConflict { session_names: _, session_count: _ } => 409
    LaunchSessionsUnobservable { reason: _ } => 503
    LaunchAuthorityUnobserved { detail: _ } => 503
    LaunchRevisionUnobserved { cause: _ } => 503
    LaunchLivenessUnobserved { session_name: _, reason: _ } => 503
    LaunchGateNotEvaluated { gate: _ } => 503
    LaunchNoPlacementGrant { detail: _ } => 503
  }
}

fn belt_dispatch_status(r: BeltSpawnOutcome) -> HttpStatus {
  match r {
    Spawned { node_id: _, session_name: _, provider: _, launch: _ } => 200
    SupervisorConvened { node_id: _, unit: _, provider: _, launch: _ } => 200
    SpawnFailed { node_id: _, step: _, detail: _, provider: _, launch: _ } => 502
    SpawnNotAdmitted { node_id: _, refusal } => launch_refusal_http_status(r: refusal)
  }
}

fn belt_dispatch_response(r: BeltSpawnOutcome) -> ServeHttpResponse {
  serve_text_response(
    status: belt_dispatch_status(r: r),
    content_type: application_json_utf8,
    body: serialize_json(v: belt_spawn_outcome_json(o: r)),
  )
}

// The node_id param is bound by the route template, so an empty value is unreachable by
// construction (match_path_template refuses empty segments); the empty-check below is the typed
// backstop for that unreachable arm — a 400 refusal, never a dispatch with a fabricated id (DESIGN
// 5: an unreachable arm refuses, never fabricates).

// THE EXECUTOR IS AN OPTIONAL ?executor=LABEL ON THE DISPATCH ROUTE (gunbc.roadmap_dispatch_actuator
// DispatchExecutorRequest): absent, it is the default executor; a vendor label routes the attempt to
// that vendor's selection, which refuses typed when the vendor's offer or standing does not admit it.
// An unknown label is a 400 naming the accepted set -- never a dispatch to the default, which would
// run the attempt somewhere the operator did not ask.
fn serve_dispatch_handler_response_over(
  instance: HostDashboardInstance,
  plan: RoadmapAuthorityProjection,
  params: List<PathParamBinding>,
  executor_word: String,
) -> ServeHttpResponse {
  let node_id = path_param_value(params: params, name: "node_id")
  if node_id == "" {
    serve_text_response(
      status: 400,
      content_type: text_plain_utf8,
      body: "dispatch requires a node id path segment (fail-closed; empty binding is unreachable by construction)\n",
    )
  } else {
    match decode_dispatch_executor_request(word: executor_word) {
      DispatchExecutorRequestUnknown { word, known } =>
        serve_text_response(
          status: 400,
          content_type: text_plain_utf8,
          body: join(["dispatch executor ", word, " is not a known executor; accepted: ", join(known, ", "), "\n"], ""),
        )
      DispatchExecutorRequestDecoded { request: executor } =>
        belt_dispatch_response(
          r: belt_dispatch_node_for_instance_over(instance: instance, plan: plan, node_id: node_id, request: LaunchAutonomous, executor: executor),
        )
    }
  }
}

fn serve_dispatch_handler_response_for_instance(
  instance: HostDashboardInstance,
  params: List<PathParamBinding>,
) -> ServeHttpResponse {
  serve_dispatch_handler_response_over(
    instance: instance,
    plan: roadmap_authority_projection(history: roadmap_acceptance_event_history_load()),
    params: params,
    executor_word: "",
  )
}

// POST /publish/NODE_ID is the publication producer's live trigger, and it exists because belt_tick
// has none. Publication is wired into that actuation pass beside verification and nothing drives
// it, so without this route the receipt would never be written in production and the row's lamp
// could never move off pending - the same never-runs defect one layer out from the one this lane
// fixed.\n\nIT IS A POST BECAUSE IT WRITES. The workflow route reads and paints; this one observes
// two remote surfaces and persists a judgment, and putting that on the read path would make the
// browser poll the thing that queries GitHub - the split serve_workflow_note already draws for
// verification.\n\nTHE STATUS COMES FROM THE OUTCOME, not from whether the handler ran. A deferral
// is 409 and a belt-side failure is 500, so a caller can tell `the attempt is not ready` from `the
// belt could not do its job` without reading prose.

fn serve_publish_handler_response_for_instance(
  instance: HostDashboardInstance,
  params: List<PathParamBinding>,
) -> ServeHttpResponse {
  let node_id = path_param_value(params: params, name: "node_id")
  if node_id == "" {
    serve_text_response(
      status: 400,
      content_type: text_plain_utf8,
      body: "publish requires a node id path segment (fail-closed; empty binding is unreachable by construction)\n",
    )
  } else {
    let outcome = belt_publish_node_for_instance(instance: instance, node_id: node_id)
    serve_text_response(
      status: belt_publish_outcome_http_status(o: outcome),
      content_type: application_json_utf8,
      body: serialize_json(v: belt_publish_outcome_json_value(o: outcome)),
    )
  }
}

// ── THE APPROVAL ROUTES ARE MID-CUTOVER, AND THIS IS THE STAGE THEY ARE AT ───────────────────
// GET/POST /approve/\{capability\}, POST /approvals and GET /approvals/\{escalation_id\} are being
// moved out of this process into gunbc.auth.approval_broker_serve, which has its own unit, slice,
// MainPID and memory bound.
//
// THE RECEIPT IS AN OUTAGE, NOT A TIDINESS ARGUMENT (side-chat ruling 2026-09-19). Boot 15 refused
// on an approval status poll because THIS process's 18 GB heap was swapped and OOM-killed. The
// approval folds were fine; they were merely resident in a process whose job is expensive renders.
// The note further down still says what made that possible -- the approval routes consulted no
// roadmap at all -- so the only thing joining them to a roadmap render was co-tenancy, and
// co-tenancy is repaired by splitting the process, not by rendering more cheaply.
//
// WHAT LANDED HERE AND WHY IT IS ONE ARM RATHER THAN FOUR. The handler folds and the path literals
// are GONE from this module: they live once, in the broker's module and in
// gunbc.auth.approval_broker_endpoint. What remains is a single arm carrying the broker's own
// handler value, and route rows PROJECTED from the broker's own specs -- so during the cutover
// window there are two route TABLES and still exactly one authority for what an approval route is,
// where it is mounted and what it does. Copying the adapter to keep serving here would have been
// the DESIGN section 2 duplication this split exists to remove, and re-spelling the paths would
// have been the section 3 fork.
//
// WHY THE ROWS ARE STILL HERE AT ALL: the staged transaction the split was ordered under puts the
// dark deployment and the measurement BEFORE anything is repointed, and the route removal LAST
// (gunbc.auth.approval_broker_cutover). Removing them in the same change that first introduces the
// broker would take the approval loop down for the window between the two -- an outage strictly
// worse than the co-tenancy it repairs, and the reason the plan is staged rather than atomic.
//
// THE DISSOLUTION IS ONE ROW AND NOTHING ELSE, which is what makes it a mechanism rather than a
// plan someone remembers. gunbc.auth.approval_broker_cutover approval_route_ownership decides who
// the approval paths are routed to, and every derived fact reads it: whether this table projects
// the four rows, which port the deploy binds the broker to, and whether the front door carries the
// two approval mounts. At most one party is routed at every value of that row, which is the
// property an earlier arrangement asserted in prose and a later one tried to get from the port
// alone (reviews 68050 and 68075).
//
// This projection stops at ApprovalPathsOwnedByBroker. The arm below survives that flip as dead
// code for exactly one change and is deleted with it; what stays is the regression control that
// this table answers nothing for the four approval pairs.

// WHICH ROUTES THE ROADMAP STILL MOUNTS IS A TOTAL MATCH, NOT A WILDCARD, and the difference is
// what stops this window widening on its own. This fold used to map over ALL of
// approval_broker_route_specs(), which reads as "one authority, two mounts" -- true, and it is why
// a reviewer cleared it -- but its SUBJECT is narrower than its EXPRESSION: it is "the four routes
// being cut over", written as "whatever the broker serves". The gap is invisible until someone adds
// a fifth row, at which point the roadmap silently starts serving it too, for the whole cutover
// window, with no edit here and no reviewer looking.
//
// THAT IS NOT HYPOTHETICAL. wise-owl-628 is holding six App Attest device routes that extend
// approval_broker_route_specs under this same construction; under the wildcard, landing them would
// have enrolled the roadmap process as a second server of device enrolment and redemption. The
// store stays safe -- approval_write_admission refuses a non-writer before any mutation -- but the
// roadmap would be answering assertion-authenticated routes it has no business answering, with
// every marker on those responses reading roadmap/.
//
// SO A NEW HANDLER ARM MUST BE CLASSIFIED RATHER THAN INHERITED. The match below is total over
// ApprovalBrokerHandler: adding an arm does not compile until someone says, here, whether the
// roadmap serves it during the cutover. That is the construction DESIGN section 5 prefers to a
// check -- the widening becomes unwritable instead of merely reviewable.
fn roadmap_mounts_during_cutover(h: ApprovalBrokerHandler) -> Bool {
  match h {
    ApprovalSiteFaviconHandler => false
    ApprovalConfirmPageHandler => true
    ApprovalDecideHandler => true
    ApprovalSubmitHandler => true
    ApprovalStatusHandler => true
    ApprovalStoreReceiptHandler => false
    DeviceEnrolHandler => false
    DeviceRedeemHandler => false
    DevicePendingHandler => false
    DeviceRequestHandler => false
    DeviceEnrollmentReadbackHandler => false
    DevicePushUpdateHandler => false
  }
}

fn roadmap_serve_approval_cutover_route_specs() -> List<ServedRouteSpec<RoadmapServeHandler>> {
  if roadmap_still_mounts_approval_routes() {
    map(
      filter(approval_broker_route_specs(), spec => roadmap_mounts_during_cutover(h: spec.handler)),
      spec => ServedRouteSpec {
        method: spec.method,
        raw: spec.raw,
        handler: ApprovalBrokerCutoverHandler { route: spec.handler },
      },
    )
  } else {
    []
  }
}

// THE ISSUE DETAIL ROUTE (owner ruling 2026-09-24: the detail page is a real served route). ONE
// issue rendered live from the same authorities the daily page reads: the plan for the ticket and
// the parent/blocking links, the standings observation for the holder, the node's event log for
// the Work tab's durable execution history — a local read per request, the same grain the tick's
// standings read pays. THE ASSIGNMENT FIELD'S RECENTS ride the all-events read (the cross-issue
// ledger fold); a refused all-events read degrades to the seeds alone rather than refusing the
// page — the suggestions feed is furniture, not the issue's truth. Attempts ride the render
// entry's parameter (the live attempt feed is the belt-side observation-storage decision, deferred
// with its reason in the report); the events keep the Work tab honest until it lands. Unknown ids
// render the not-found document at 404. THE CSRF TOKEN rides the page AT RENDER: a seated
// Google session's token fills the comment composer's hidden csrf field (the synchronizer-token
// pattern — the detail route renders per request with the session in hand, so no context fetch
// or client fill), every other standing renders the empty field the write law refuses honestly,
// and the response is NO-STORE because the page now carries a session secret (session-dependent
// HTML is never reused for a different viewer — the allocation page's law, extended here).
// THE WORK TAB READS THE SAME OBSERVATION THE DAILY PAGE DOES, scoped to this node: the
// dispatch-ref census and current-attempt selection, then this node's progress. A census that
// refuses stays a refusal on the page -- never an empty attempt list.
fn serve_issue_detail_response_over(
  instance: HostDashboardInstance,
  plan: RoadmapAuthorityProjection,
  params: List<PathParamBinding>,
  request: ServeHttpRequest<RequestAccessPath, RequestAuthenticationEvidence>,
) -> ServeHttpResponse {
  let node_id = path_param_value(params: params, name: "node_id")
  let layout = roadmap_event_carrier_layout_for_instance(instance: instance)
  if !issue_detail_node_exists(proj: plan, node_id: node_id) { serve_page_response_with_status(page: issue_detail_not_found_page(node_id: node_id, viewer: ""), status: 404) }
  else { match serve_history_after_snapshot_close(read: roadmap_events_read(layout: layout, node: node_id as NonEmptyStr as RoadmapNodeId)) {
    EventsReadRefused { node: _, step, reason } => serve_text_response(status: 503, content_type: text_plain_utf8,
      body: join(["Issue history unavailable at ", step, ": ", reason, ". No revision-pinned mutations are available."], ""))
    EventsRead { node: _, envelopes } => {
      let state = roadmap_issue_state(envs: envelopes)
      let standing = state.standing
      match roadmap_history_unordered_reason(envs: envelopes) {
      Present { value: why } =>
        serve_text_response(status: 503, content_type: text_plain_utf8, body: concat("Issue history unavailable: ", why))
      Absent => {
        let context = match request.security.authentication {
          GoogleOidcSession { session } => IssueFormContext { operation: match issue_operation_nonce() { Present { value: nonce } => nonce Absent => "" }, csrf: session.csrf.token as String }
          FabricServiceEvidence { kind: _, authenticated_at: _ } => IssueFormContext { operation: "", csrf: "" }
          SessionStandingInvalid { standing: _ } => IssueFormContext { operation: "", csrf: "" }
          AuthAbsent => IssueFormContext { operation: "", csrf: "" }
        }
        let recents = match serve_all_events_after_snapshot_close(read: roadmap_events_read_all(layout: layout)) { AllEventsRead { envelopes: all_events } => roadmap_recent_claimed_assignees(envs: all_events) AllEventsReadRefused { step: _, reason: _ } => [] }
        let launch = belt_launch_host_standing_for_page_over(instance: instance, plan: plan)
        let observed = belt_workflow_attempts_observe_scoped(instance: instance, scope: WorkflowAttemptsOneNode { node_id: node_id })
        let attempts = match observed {
          WorkflowAttemptsObserved { attempts: a } => a
          WorkflowAttemptsRefused { reason: _ } => []
        }
        let attempts_refused = match observed {
          WorkflowAttemptsObserved { attempts: _ } => none
          WorkflowAttemptsRefused { reason: r } => Present { value: r }
        }
        let page = issue_detail_page_for(proj: plan, node_id: node_id, attempts: attempts,
          attempts_refused: attempts_refused,
          standings: StandingsObserved { rows: [NodeStandingRow { node_id: node_id, standing: standing, assignment: state.assignment }] },
          launch: launch,
          stale_nodes: stale_attempt_nodes(
            observations: served_attempt_revision_observations(instance: instance, attempts: attempts),
            current_revision_hex: served_current_revision_hex(launch: launch)),
          events: envelopes,
          viewer: authenticated_viewer_label(evidence: request.security.authentication), recents: recents, command_context: context,
          profiles: serve_profiles_for_instance(instance: instance))
        let response = serve_page_response_with_status(page: page, status: 200)
        response
      }
      }
    }
  } }
}

// THE AUTH PROFILE ROSTER, read once per render under the never-blocks law: the store's refusal
// (or absence) degrades to the empty roster — the page renders every assignee surface's fallback
// exactly as before, never a failed page on a profile read.
fn serve_profiles_for_instance(instance: HostDashboardInstance) -> List<PrincipalProfile> {
  match profile_store_read_all(layout: profile_store_layout_for_instance(instance: instance)) {
    ProfileStoreRead { profiles, skipped: _ } => profiles
    ProfileStoreUnread { step: _, reason: _ } => []
  }
}

// THE ASSIGNEE SUBMISSION, resolved to the stable PrincipalRef the v3 event records (owner
// ruling: the picker displays emails but submits principals). Resolution order: a principal label
// parses directly; the fabric selector maps by declaration to the one workflow principal; any
// other email goes through the directory lookup — and the directory producer is A9, so until it
// lands the lookup refuses with the typed vocabulary rather than minting a principal from an
// email (the banned shape has no constructor anywhere in gunbc).
// Fresh, session-bound picker context. Refuse unread history rather than inventing a
// revision; the existing POST remains the sole assignment and launch authority.
fn serve_issue_assignment_context_over(
  instance: HostDashboardInstance,
  plan: RoadmapAuthorityProjection,
  request: ServeHttpRequest<RequestAccessPath, RequestAuthenticationEvidence>,
  params: List<PathParamBinding>,
) -> ServeHttpResponse {
  let node_id = path_param_value(params: params, name: "node_id")
  match request.security.authentication {
    GoogleOidcSession { session } =>
      if !issue_detail_node_exists(proj: plan, node_id: node_id) {
        serve_text_response(status: 404, content_type: text_plain_utf8, body: "Issue not found.")
      } else {
        let layout = roadmap_event_carrier_layout_for_instance(instance: instance)
        match serve_history_after_snapshot_close(read: roadmap_events_read(layout: layout, node: node_id as NonEmptyStr as RoadmapNodeId)) {
          EventsReadRefused { node: _, step, reason } =>
            serve_text_response(status: 503, content_type: text_plain_utf8, body: join(["Cannot load assignment history at ", step, ": ", reason], ""))
          EventsRead { node: _, envelopes } =>
            let recents = match serve_all_events_after_snapshot_close(read: roadmap_events_read_all(layout: layout)) {
              AllEventsRead { envelopes: all_events } => roadmap_recent_claimed_assignees(envs: all_events)
              AllEventsReadRefused { step: _, reason: _ } => []
            }
            match issue_operation_nonce() {
              Absent => serve_text_response(status: 503, content_type: text_plain_utf8, body: "Cannot prepare a stable assignment operation. Try again before submitting.")
              Present { value: nonce } => serve_text_response(
                status: 200, content_type: application_json_utf8,
                body: inline_assignment_context_body(session: session, events: envelopes, recents: recents, profiles: serve_profiles_for_instance(instance: instance), operation: nonce, node_id: node_id))
            }
        }
      }
    AuthAbsent => serve_text_response(status: 401, content_type: text_plain_utf8, body: "Sign in to assign this issue.")
    SessionStandingInvalid { standing: _ } => serve_text_response(status: 401, content_type: text_plain_utf8, body: "Your session has expired or is unavailable. Sign in again.")
    FabricServiceEvidence { kind: _, authenticated_at: _ } => serve_text_response(status: 403, content_type: text_plain_utf8, body: "Inline assignment requires a signed-in human session.")
  }
}

fn assignee_submission_shape_valid(s: String) -> Bool {
  issue_assignee_input_is_email(s: s)
    || trim(s) == (issue_assign_fabric_display as String)
    || match principal_ref_parse_label(s: s) { Present { value: _ } => true  Absent => false }
}

fn assignee_principal_of(raw: String) -> PrincipalRef? {
  let t = trim(raw)
  match principal_ref_parse_label(s: t) {
    Present { value: ref } => Present { value: ref }
    Absent =>
      if t == (issue_assign_fabric_display as String) {
        Present { value: fabric_workflow_principal }
      } else {
        none
      }
  }
}

fn assignee_lookup_refusal(raw: String) -> String {
  let t = trim(raw)
  if issue_assignee_input_is_email(s: t) && t != (issue_assign_fabric_display as String) {
    join(["'", t, "' names no admitted principal — the typed-email directory lookup is the A9 producer and no directory is bound yet, so human emails cannot mint a principal (and never will: email is display, not identity)"], "")
  } else {
    join(["'", t, "' is neither a principal spelling, the fabric selector, nor an email spelling"], "")
  }
}

// A HUMAN WRITE READS THE CLOCK ONLY WHERE A READING IS CONSUMED. The write law
// (gunbc.auth.request_authentication human_authentication_decision) reads observed_at only on the
// GoogleOidcSession arm -- session expiry -- and only that arm can reach the append that records
// it; absent, invalid and service evidence refuse at the authentication axis without it. So the
// early refusals (404 unknown issue, 403 without a session) answer before any host read.
fn human_write_observed_at(security: RequestSecurityContext<RequestAccessPath, RequestAuthenticationEvidence>) -> String {
  match security.authentication {
    GoogleOidcSession { session: _ } => match clock_now_probed_at() { Present { value: t } => t as String Absent => "" }
    FabricServiceEvidence { kind: _, authenticated_at: _ } => ""
    SessionStandingInvalid { standing: _ } => ""
    AuthAbsent => ""
  }
}

// THE DURABLE ASSIGN ROUTE — the AssignIssue command (owner rulings 2026-09-24 and the 2026-09-25
// issue-page mandate): POST /issue/<id>/assign records a Claimed event carrying the ASSIGNEE and
// the RETURN_TO principal explicitly (default return_to = the requester — the authenticated
// principal, never derived from whichever event was first), chained on the single head by the
// event-CLI idiom: read, refuse on forked/incomplete history (409), parent = the head, probed
// clock, append through the carrier. The expected_issue_revision field pins the head the page
// rendered under: a mismatch is 409 STALE, never a silent chain onto a history the writer never
// saw — reload and the form re-pins. The author is the AUTHENTICATED PRINCIPAL: the write law
// (gunbc.auth.request_authentication.human_write_admission) admits this route only on the
// conjunction of a Google OIDC session, action authorization, and the CSRF proof, and the event
// records the session principal's stable label — tailnet transport alone refuses at the
// authentication axis with a located reason and is never a person the backend may act for.
// A HUMAN ASSIGNEE NEVER
// DISPATCHES: the response records the fact and stops. THE FABRIC ENDPOINT IS THE EXECUTION ENTRY
// POINT (the Start Work button is retired): after the event lands, the handler drives the SAME
// launch admission the /dispatch route answers. AN ADMISSION REFUSAL DOES NOT UNDO THE ASSIGNMENT:
// the event stands, the issue stays with Fabric, and the response renders the located waiting
// condition in the launch's typed refusal vocabulary — "waiting on fabric: <label> — <reason>",
// never "assignment failed". RE-ASSIGNING THE SAME REVISION joins the existing request: the
// admission's own already-live / already-accepted arms refuse the duplicate attempt, and the
// response says the assignment stands beside the refusal. THE REQUEST BODY is the form's
// application/x-www-form-urlencoded encoding, decoded once by the shared strict codec.
fn serve_issue_assign_response_over(
  instance: HostDashboardInstance,
  plan: RoadmapAuthorityProjection,
  request: ServeHttpRequest<RequestAccessPath, RequestAuthenticationEvidence>,
  params: List<PathParamBinding>,
) -> ServeHttpResponse {
  let node_id = path_param_value(params: params, name: "node_id")
  let observed_at = human_write_observed_at(security: request.security)
  if !issue_detail_node_exists(proj: plan, node_id: node_id) { serve_text_response(status: 404, content_type: text_plain_utf8, body: "issue not found") }
  else { match human_write_admission(route_path: concat("/issue/", concat(node_id, "/assign")) as NonEmptyStr,
    action: ServeActionAssignIssue, security: request.security, authorization_policy: tracker_write_authorization_policy,
    deployment_policy: roadmap_deployment_access_policy, csrf_presented: issue_form_field(body: request.body, name: "csrf"), observed_at: observed_at) {
    Deny { refusal } => serve_text_response(status: 403, content_type: text_plain_utf8, body: access_refusal_reason(refusal: refusal))
    Permit => if !issue_command_form_valid(body: request.body) { serve_text_response(status: 400, content_type: text_plain_utf8, body: "assignment refused: a valid operation key and explicit expected_revision are required") }
      else { match authenticated_write_author_principal(security: request.security) {
        Absent => serve_text_response(status: 403, content_type: text_plain_utf8, body: "authenticated principal required")
        Present { value: author } => match assignee_principal_of(raw: issue_form_field(body: request.body, name: "assignee")) {
          Absent => serve_text_response(status: 400, content_type: text_plain_utf8, body: "assignee has no admitted principal")
          Present { value: assignee } => {
            let target = issue_form_field(body: request.body, name: "return_to")
            match (if target == "" { Present { value: author } } else { assignee_principal_of(raw: target) }) {
              Absent => serve_text_response(status: 400, content_type: text_plain_utf8, body: "return_to has no admitted principal")
              Present { value: return_to } => {
                let expected = issue_form_field(body: request.body, name: "expected_revision")
                let outcome = serve_append_after_snapshot_close(appended: issue_command_apply(layout: roadmap_event_carrier_layout_for_instance(instance: instance),
                  command: AssignIssue { subject: IssueCommandSubject { node: node_id as NonEmptyStr as RoadmapNodeId,
                    author: EventPrincipalAuthenticated { ref: author }, operation: issue_form_field(body: request.body, name: "key") as NonEmptyStr,
                    expected: if expected == "" { none } else { Present { value: expected as NonEmptyStr as RoadmapEventId } } },
                    assignee: EventPrincipalAuthenticated { ref: assignee }, return_to: EventPrincipalAuthenticated { ref: return_to } }, recorded_at: observed_at))
                match outcome {
                  EventAppended { id } => serve_assignment_launch_follow_through(instance: instance, plan: plan, node_id: node_id, assignee: assignee, event_id: id as String)
                  EventAlreadyPresent { id } => serve_text_response(status: 200, content_type: text_plain_utf8, body: join(["assigned: ", node_id, " (already recorded event ", id as String, ")\n"], ""))
                  EventAppendRefused { id: _, step, reason } => issue_command_refusal_response(step: step, reason: reason)
                }
              }
            }
          }
        }
      } }
  } }
}

fn issue_command_form_valid(body: String) -> Bool {
  issue_form_has_field(body: body, name: "expected_revision")
    && roadmap_operation_identity_valid(operation: issue_form_field(body: body, name: "key"))
}

fn issue_command_refusal_response(step: String, reason: String) -> ServeHttpResponse {
  serve_text_response(status: if step == "revision-conflict" || step == "operation-conflict" { 409 } else { 503 },
    content_type: text_plain_utf8, body: join(["issue command refused at ", step, ": ", reason, "\n"], ""))
}

// THE AUTHOR PRINCIPAL OF AN ADMITTED WRITE, the typed form the v3 event records: a Google OIDC
// session writes as its seated principal; fabric service evidence writes as the one workflow
// principal (a service writer never presents a human session as workload identity — the ruling's
// service-writer law). Only reachable past the write law's Permit arm; the Absent fallback is the
// loud spelling of an unreachable state, refused at the call site, never a value that reaches the
// durable record.
fn authenticated_write_author_principal(security: RequestSecurityContext<RequestAccessPath, RequestAuthenticationEvidence>) -> PrincipalRef? {
  match security.authentication {
    GoogleOidcSession { session } => Present { value: session.principal }
    FabricServiceEvidence { kind: _, authenticated_at: _ } => Present { value: fabric_workflow_principal }
    SessionStandingInvalid { standing: _ } => none
    AuthAbsent => none
  }
}

// THE AUTHOR OF AN ADMITTED HUMAN WRITE. Only reachable past the write law's Permit arm, which
// only a GoogleOidcSession can produce; every other arm is refused above, so the fallback string
// is the loud spelling of an unreachable state, never a value that can reach the durable record.
fn authenticated_write_author_label(security: RequestSecurityContext<RequestAccessPath, RequestAuthenticationEvidence>) -> NonEmptyStr {
  match security.authentication {
    GoogleOidcSession { session } => principal_ref_label(p: session.principal) as NonEmptyStr
    FabricServiceEvidence { kind: _, authenticated_at: _ } => "unreachable: admitted human write without a session principal" as NonEmptyStr
    SessionStandingInvalid { standing: _ } => "unreachable: admitted human write without a session principal" as NonEmptyStr
    AuthAbsent => "unreachable: admitted human write without a session principal" as NonEmptyStr
  }
}

// Both native and enhanced issue commands use the same admitted form codec (Cut 1's
// form_decode, superseding the 2026-09-28 text/plain CR-strip repair — the full codec handles
// the CRLF separation the located repair handled field-by-field).
fn issue_form_field(body: String, name: String) -> String {
  match form_field(form: form_decode(wire: body), name: name) {
    Present { value } => value
    Absent => ""
  }
}

fn issue_form_has_field(body: String, name: String) -> Bool {
  match form_field(form: form_decode(wire: body), name: name) { Present { value: _ } => true Absent => false }
}

// THE EXECUTION ENTRY POINT'S FOLLOW-THROUGH, factored pure over the admission outcome so the
// witness drives it with constructed outcomes: a human assignee stops at the recorded fact (NEVER
// dispatches); the fabric endpoint drives the SAME admission the /dispatch route answers and the
// response renders what came back — admitted (the attempt renders on the Work tab), actuation
// failure (502, the assignment stands), or the typed refusal: the issue STAYS with Fabric and the
// body names the located waiting condition, never "assignment failed". THE CONFIRMATION NAMES THE
// PERSON, NOT THE PRINCIPAL: the profile store is read ONCE and the assignee renders through its
// display — "name (email)" when the store carries both, the email when only the email, the name
// when only the name, else the principal label. THE LABEL IS THE IDENTITY, THE DISPLAY IS
// PRESENTATION: principal_ref_label stays out of the visible text whenever a profile exists (the
// label remains only as the no-profile fallback, where it is the only spelling known).
fn serve_assignment_launch_follow_through(
  instance: HostDashboardInstance,
  plan: RoadmapAuthorityProjection,
  node_id: String,
  assignee: PrincipalRef,
  event_id: String,
) -> ServeHttpResponse {
  serve_assignment_launch_follow_through_over(
    instance: instance,
    plan: plan,
    node_id: node_id,
    assignee: assignee,
    event_id: event_id,
    profiles: serve_profiles_for_instance(instance: instance),
  )
}

// The follow-through over a profile roster the caller read once: the display resolution is a pure
// fold over it, so the human/Fabric decision is reachable without the profile-store read.
fn serve_assignment_launch_follow_through_over(
  instance: HostDashboardInstance,
  plan: RoadmapAuthorityProjection,
  node_id: String,
  assignee: PrincipalRef,
  event_id: String,
  profiles: List<PrincipalProfile>,
) -> ServeHttpResponse {
  let assignee_display = assignment_confirmation_display(assignee: assignee, profiles: profiles)
  if principal_ref_eq(a: assignee, b: fabric_workflow_principal) {
    serve_fabric_assignment_response(
      node_id: node_id,
      assignee_display: assignee_display,
      event_id: event_id,
      outcome: belt_dispatch_node_for_instance_over(
        instance: instance,
        plan: plan,
        node_id: node_id,
        request: LaunchForClaim { node: node_id as NonEmptyStr as RoadmapNodeId, claim: event_id as NonEmptyStr as RoadmapEventId },
        executor: ExecutorDefault,
      ),
    )
  } else {
    serve_text_response(status: 200, content_type: text_plain_utf8, body: join(["assigned: ", node_id, " → ", assignee_display, " (event ", event_id, ")\n"], ""))
  }
}

// THE CONFIRMATION'S DISPLAY RESOLUTION over the read-once roster: the first profile matching the
// assignee principal by principal_ref_eq contributes name and email; nothing known falls back to
// the principal label.
fn assignment_confirmation_display(assignee: PrincipalRef, profiles: List<PrincipalProfile>) -> String {
  match assignment_confirmation_profile(assignee: assignee, profiles: profiles) {
    Absent => principal_ref_label(p: assignee)
    Present { value: p } =>
      match p.name {
        Present { value: n } => match p.email {
          Present { value: e } => join([n, " (", e as String, ")"], "")
          Absent => n
        }
        Absent => match p.email {
          Present { value: e } => e as String
          Absent => principal_ref_label(p: assignee)
        }
      }
  }
}

// THE ROSTER WALK: the first profile whose principal equals the assignee wins. (The Present
// binder rides the short spelling p: the binder spelling 'profile' is a named resolver failure
// mode — gunbc.recurring_failure_mode.binder_renaming_changes_variant_field_lookup.)
fn assignment_confirmation_profile(assignee: PrincipalRef, profiles: List<PrincipalProfile>) -> PrincipalProfile? {
  match profiles.first() {
    Absent => none
    Present { value: p } =>
      if principal_ref_eq(a: p.principal, b: assignee) {
        Present { value: p }
      } else {
        assignment_confirmation_profile(assignee: assignee, profiles: profiles.skip(n: 1))
      }
  }
}

fn serve_fabric_assignment_response(node_id: String, assignee_display: String, event_id: String, outcome: BeltSpawnOutcome) -> ServeHttpResponse {
  match outcome {
    Spawned { node_id: _, session_name, provider: _, launch: _ } =>
      serve_text_response(status: 200, content_type: text_plain_utf8, body: join(["assigned: ", node_id, " → ", assignee_display, " (event ", event_id, ")\nfabric work request admitted: session ", session_name, " — the attempt renders on the Work tab\n"], ""))
    SupervisorConvened { node_id: _, unit, provider: _, launch: _ } =>
      serve_text_response(status: 200, content_type: text_plain_utf8, body: join(["assigned: ", node_id, " → ", assignee_display, " (event ", event_id, ")\nfabric work request admitted: supervisor ", unit, " — the attempt renders on the Work tab\n"], ""))
    SpawnFailed { node_id: _, step, detail, provider: _, launch: _ } =>
      serve_text_response(status: 502, content_type: text_plain_utf8, body: join(["assigned: ", node_id, " → ", assignee_display, " (event ", event_id, ")\nfabric launch failed at ", step, ": ", detail, " — the assignment stands; re-assign to retry the request\n"], ""))
    SpawnNotAdmitted { node_id: _, refusal } =>
      serve_text_response(status: launch_refusal_http_status(r: refusal), content_type: text_plain_utf8, body: join(["assigned: ", node_id, " → ", assignee_display, " (event ", event_id, ")\nwaiting on fabric: ", launch_refusal_label(r: refusal), " — ", launch_refusal_reason(r: refusal), " — the assignment stands; the request joins the existing attempt when one is live\n"], ""))
  }
}

// Comment commands use the same strict URL-encoded codec as native and enhanced assignment.
// Every form has a stable operation identity, explicit expected revision, and session CSRF.
// A retry returns the original event and comment ordinal, even after intervening events;
// equal text with another operation identity is an intentional second comment.
fn serve_issue_comment_response_over(
  instance: HostDashboardInstance,
  request: ServeHttpRequest<RequestAccessPath, RequestAuthenticationEvidence>,
  params: List<PathParamBinding>,
) -> ServeHttpResponse {
  let node_id = path_param_value(params: params, name: "node_id")
  let observed_at = human_write_observed_at(security: request.security)
  if !issue_detail_node_exists(proj: roadmap_authority_projection(history: roadmap_acceptance_event_history_load()), node_id: node_id) { serve_text_response(status: 404, content_type: text_plain_utf8, body: "issue not found") }
  else { match human_write_admission(route_path: concat("/issue/", concat(node_id, "/comment")) as NonEmptyStr,
    action: ServeActionCommentIssue, security: request.security, authorization_policy: tracker_write_authorization_policy,
    deployment_policy: roadmap_deployment_access_policy, csrf_presented: issue_form_field(body: request.body, name: "csrf"), observed_at: observed_at) {
    Deny { refusal } => serve_text_response(status: 403, content_type: text_plain_utf8, body: access_refusal_reason(refusal: refusal))
    Permit => if !issue_command_form_valid(body: request.body) { serve_text_response(status: 400, content_type: text_plain_utf8, body: "comment refused: a valid operation key and explicit expected_revision are required") }
      else { match authenticated_write_author_principal(security: request.security) {
        Absent => serve_text_response(status: 403, content_type: text_plain_utf8, body: "authenticated principal required")
        Present { value: author } => {
          let body = issue_comment_body_of(wire: request.body)
          if body == "" { serve_text_response(status: 400, content_type: text_plain_utf8, body: "comment refused: empty body") }
          else {
            let layout = roadmap_event_carrier_layout_for_instance(instance: instance)
            let expected = issue_form_field(body: request.body, name: "expected_revision")
            let operation = issue_form_field(body: request.body, name: "key")
            let outcome = serve_append_after_snapshot_close(appended: issue_command_apply(layout: layout, command: CreateComment { subject: IssueCommandSubject {
              node: node_id as NonEmptyStr as RoadmapNodeId, author: EventPrincipalAuthenticated { ref: author }, operation: operation as NonEmptyStr,
              expected: if expected == "" { none } else { Present { value: expected as NonEmptyStr as RoadmapEventId } } }, body: body as NonEmptyStr }, recorded_at: observed_at))
            match outcome {
              EventAppendRefused { id: _, step, reason } => issue_command_refusal_response(step: step, reason: reason)
              EventAppended { id } => issue_comment_readback_response(layout: layout, node_id: node_id, operation: operation, event_id: id as String, already_present: false)
              EventAlreadyPresent { id } => issue_comment_readback_response(layout: layout, node_id: node_id, operation: operation, event_id: id as String, already_present: true)
            }
          }
        }
      } }
  } }
}

// THE COMMENT RESPONSE, factored pure over the recorded comments so the witness drives it without
// a carrier: the deep link /issue/<id>#comment-N is the answer a retry and a first write share —
// the client re-anchors instead of re-posting.
// POST/REDIRECT/GET: the composer is a native form, so a 200 body strands the browser on a text
// page. A recorded comment -- first write or an idempotent retry -- answers 303 to its own numbered
// anchor, which is the one canonical location for it; the retry reaches the same address. A
// readback that does not carry the committed comment names no anchor at all: it refuses, loudly,
// rather than linking #comment-0.
// A committed or already-present comment answers from the event log read back after the commit;
// a refused readback is a 503 that names its step, never a page built from the request.
fn issue_comment_readback_response(layout: RoadmapEventCarrierLayout, node_id: String, operation: String, event_id: String, already_present: Bool) -> ServeHttpResponse {
  match serve_history_after_snapshot_close(read: roadmap_events_read(layout: layout, node: node_id as NonEmptyStr as RoadmapNodeId)) {
    EventsReadRefused { node: _, step, reason } => serve_text_response(status: 503, content_type: text_plain_utf8,
      body: concat("comment commit acknowledged, but readback refused; retry with the same operation key: ", concat(step, concat(": ", reason))))
    EventsRead { node: _, envelopes } => serve_comment_recorded_response(node_id: node_id, comments: roadmap_issue_comments(envs: envelopes), comment: operation,
      event_id: event_id, already_present: already_present)
  }
}

fn serve_comment_recorded_response(node_id: String, comments: List<IssueComment>, comment: String, event_id: String, already_present: Bool) -> ServeHttpResponse {
  match (filter(comments, c => (c.comment as String) == comment)).first() {
    Absent =>
      serve_text_response(status: 502, content_type: text_plain_utf8, body: join(["comment ", comment, " was committed (event ", event_id, ") but the issue's readback does not carry it; reload /issue/", node_id, "\n"], ""))
    Present { value: c } => {
      let link = join(["/issue/", node_id, "#comment-", to_string(value: c.ordinal)], "")
      let body = if already_present {
        join(["comment recorded (already present): ", link, "\n"], "")
      } else {
        join(["comment recorded: ", link, " (event ", event_id, ")\n"], "")
      }
      serve_text_response(status: 200, content_type: text_plain_utf8, body: body)
    }
  }
}

// The body is a decoded value; its newlines and field-looking text are never reparsed.
fn issue_comment_body_of(wire: String) -> String {
  issue_form_field(body: wire, name: "body")
}

fn serve_dispatch_handler_response(params: List<PathParamBinding>) -> ServeHttpResponse {
  serve_dispatch_handler_response_for_instance(
    instance: srv1_live_dashboard_instance(),
    params: params,
  )
}

fn dashboard_instance_json(instance: HostDashboardInstance) -> String {
  let plan = dashboard_instance_provision_plan_rows(instance: instance)
  serialize_json(v: json_object(members: [
    json_kv(key: "schema", value: json_string(s: dashboard_instance_health_schema)),
    json_kv(key: "instance_id", value: json_string(s: instance.instance_id as String)),
    json_kv(key: "host_identity", value: json_string(s: instance.host_identity as String)),
    json_kv(
      key: "actuation",
      value: json_string(s: dashboard_actuation_posture_label(posture: instance.actuation)),
    ),
    json_kv(key: "repo_root", value: json_string(s: instance.repo_root as String)),
    json_kv(
      key: "dispatch_worktree_root",
      value: json_string(s: dashboard_instance_dispatch_worktree_root(instance: instance) as String),
    ),
    json_kv(
      key: "dispatch_attempt_state_root",
      value: json_string(s: dashboard_instance_dispatch_attempt_state_root(instance: instance) as String),
    ),
    json_kv(key: "listen_port", value: json_int(n: instance.listen_port)),
    json_kv(key: "serve_function", value: json_string(s: instance.serve_function as String)),
    json_kv(key: "dispatch_base_ref", value: json_string(s: instance.dispatch_base_ref as String)),
    json_kv(
      key: "provision_transport",
      value: json_string(s: dashboard_provision_transport_label(
        transport: instance.provision_transport,
      )),
    ),
    json_kv(
      key: "desired_provision_plan",
      value: json_array(elements: plan |> map(row => json_object(members: [
        json_kv(key: "kind", value: json_string(s: row.kind as String)),
        json_kv(key: "target", value: json_string(s: row.target)),
        json_kv(key: "detail", value: json_string(s: row.detail)),
      ]))),
    ),
  ]))
}

// Every handler receives the FULL modeled ServeHttpRequest (review 40314: the request body was
// formerly accepted at the seam and dropped before invoke, so a body-reading POST handler would
// have silently seen the empty string — a latent widen).

// THE PLAN TRAVELS WITH THE REQUEST, exactly as the instance already does. Which plan a process
// serves is fixed by its serve entry function -- `gunbc serve` binds --entry/--function and carries
// no per-request argument -- so an entry declared elsewhere supplies its own projected plan by
// CALLING this fold, and nothing here enumerates or registers callers. The handlers that consult a
// roadmap read the parameter instead of the public carrier, so one response cannot mix two plans.
//
// WHICH HANDLERS IGNORE IT, AND THE ONE THAT ONLY LOOKS LIKE IT DOES. Assets consult no roadmap
// at all. The sessions, attempts, workflow and observation surfaces read bodies
// the belt tick already wrote, and none of them is a roadmap render.
//
// RoadmapDailyPageHandler IS a roadmap render and must not be filed with them (review 63341, which
// caught this note grouping it there). Its plan is bound EARLIER, at the tick that rendered the
// body, by gunbc.roadmap_served_observation served_observation_observe_and_write_over -- so the
// daily page is parameterized, on the other entry. The consequence a caller has to know: supplying
// a plan HERE does not reach `/`. A process serving its own plan must supply it at BOTH entries,
// the serve entry and the tick entry; supply it at only this one and `/` answers from whatever plan
// the tick that wrote the body was given, with no refusal, because a pre-rendered body carries no
// record of the plan it came from. That is a real seam between two processes, not a gap inside this
// fold, and it is stated rather than papered over: nothing here can detect the mismatch.
// THE APPROVAL ARM DECLARES WHICH PROCESS IT IS, and that is what stops this mount being a second
// writer. The four approval folds are the broker's own, so nothing inside them can tell they were
// reached from here; the arm below passes RoadmapProcess, so the two routes that MUTATE the store
// consult gunbc.auth.approval_writer_authority and refuse the moment authority moves to the broker
// -- while this table is still mounting them for rollback (side-chat HOLD item 3: port identity is
// not writer authority, and roadmap route code may stay only if its store effects are gated by the
// same authority).
fn roadmap_serve_invoke_over(
  instance: HostDashboardInstance,
  plan: fn() -> RoadmapAuthorityProjection,
  daily_body: ServedDailyBodyAuthority,
  handler: RoadmapServeHandler,
  params: List<PathParamBinding>,
  request: ServeHttpRequest<RequestAccessPath, RequestAuthenticationEvidence>,
  release_revision: CommitSha,
  cookie_header: String = "",
) -> ServeHttpResponse {
  match handler {
    AuthLoginHandler => auth_login_response(instance: instance, request: request)
    AuthGoogleCallbackHandler => auth_google_callback_response(instance: instance, path: request.path, cookie_header: cookie_header)
    AuthLogoutHandler => auth_logout_response(instance: instance, request: request)
    RoadmapDailyPageHandler =>
      match daily_body {
        DailyBodyRenderedUnderThisPlan => serve_daily_page_response_for_instance(instance: instance)
        DailyBodyAuthorityUnknown =>
          serve_text_response(
            status: 503,
            content_type: text_plain_utf8,
            body: join([
              "the daily workspace is served from a body this process did not render: the belt tick ",
              "wrote it under the plan THAT process held, and a stored body carries no identity of ",
              "the authority it came from, so agreement with the plan this entry was given cannot ",
              "be decided here. Refusing rather than answering from an unknown authority ",
              "(gunbc.recurring_failure_mode.a_prerendered_body_carries_no_identity_of_its_source). ",
              "Bind the same plan at the tick entry, gunbc.roadmap_served_observation ",
              "served_observation_observe_and_write_over, and declare it with ",
              "DailyBodyRenderedUnderThisPlan.\n",
            ], ""),
          )
      }
    AllocationPageHandler => allocation_page_response(request: request)
    SiteFaviconHandler => serve_text_response(status: 200, content_type: site_favicon_type, body: site_favicon_source())
    SiteClientHandler => serve_text_response(status: 200, content_type: text_javascript_utf8, body: site_client_source())
    WebFontStylesheetHandler => web_font_stylesheet_response()
    AllocationCreateHandler => workspace_route_create(request: request)
    AllocationListHandler => workspace_route_list(request: request)
    AllocationReleaseHandler => workspace_route_release(request: request, allocation_id: path_param_value(params: params, name: "allocation_id") as NonEmptyStr)
    AllocationGetHandler => workspace_route_get(request: request, allocation_id: path_param_value(params: params, name: "allocation_id") as NonEmptyStr)
    AllocationClientHandler => serve_text_response(status: 200, content_type: text_javascript_utf8, body: allocation_client_source())
    FleetStandingPageHandler => serve_page_response(page: roadmap_fleet_page())
    SpecimenPageHandler => serve_page_response(page: specimen_page())
    DispatchJsonHandler => serve_text_response(status: 200, content_type: application_json_utf8, body: roadmap_site_dispatch_json_body_over(plan: plan()))
    HealthzHandler => serve_text_response(status: 200, content_type: application_json_utf8, body: roadmap_site_healthz_body_for_release(release_revision: release_revision))
    DashboardInstanceHandler =>
      serve_text_response(
        status: 200,
        content_type: application_json_utf8,
        body: dashboard_instance_json(instance: instance),
      )
    ProviderReadinessHandler =>
      serve_text_response(
        status: 200,
        content_type: application_json_utf8,
        body: dashboard_provider_readiness_json(instance: instance),
      )
    BeltDispatchHandler =>
      serve_dispatch_handler_response_over(instance: instance, plan: plan(), params: params, executor_word: uri_query_param(path: request.path, key: "executor"))
    DispatchAssetHandler => serve_text_response(status: 200, content_type: text_javascript_utf8, body: dispatch_client_js_source())
    IssueDetailPageHandler => serve_issue_detail_response_over(instance: instance, plan: plan(), params: params, request: request)
    IssueAssignmentContextHandler => serve_issue_assignment_context_over(instance: instance, plan: plan(), request: request, params: params)
    IssueAssignHandler => serve_issue_assign_response_over(instance: instance, plan: plan(), request: request, params: params)
    IssueCommentHandler => serve_issue_comment_response_over(instance: instance, request: request, params: params)
    IssueQueryHandler => serve_issue_query(instance: instance, request: request)
    IssueViewPreferencesReadHandler => serve_issue_view_preferences_over(instance: instance, request: request, saving: false)
    IssueViewPreferencesSaveHandler => serve_issue_view_preferences_over(instance: instance, request: request, saving: true)
    AuthSessionHandler => auth_session_response_over(instance: instance, request: request)
    SessionsJsonHandler => serve_sessions_response_for_instance(instance: instance)
    AttemptsJsonHandler => serve_attempts_response_for_instance(instance: instance)
    WorkflowJsonHandler => serve_workflow_response_for_instance(instance: instance)
    ObservationJsonHandler => served_observation_standing_response_for_instance(instance: instance)
    BeltStopHandler => serve_stop_handler_response_for_instance(instance: instance, params: params)
    BeltPublishHandler => serve_publish_handler_response_for_instance(instance: instance, params: params)
    ApprovalBrokerCutoverHandler { route: r } =>
      approval_broker_invoke(handler: r, params: params, request: request, process: RoadmapProcess)
  }
}

fn roadmap_serve_invoke_for_instance(
  instance: HostDashboardInstance,
  handler: RoadmapServeHandler,
  params: List<PathParamBinding>,
  request: ServeHttpRequest<RequestAccessPath, RequestAuthenticationEvidence>,
  release_revision: CommitSha,
) -> ServeHttpResponse {
  roadmap_serve_invoke_over(
    instance: instance,
    plan: fn() { roadmap_authority_projection(history: roadmap_acceptance_event_history_load()) },
    daily_body: DailyBodyRenderedUnderThisPlan,
    handler: handler,
    params: params,
    request: request,
    release_revision: release_revision,
  )
}

fn roadmap_serve_invoke(
  handler: RoadmapServeHandler,
  params: List<PathParamBinding>,
  request: ServeHttpRequest<RequestAccessPath, RequestAuthenticationEvidence>,
  release_revision: CommitSha,
) -> ServeHttpResponse {
  roadmap_serve_invoke_for_instance(
    instance: srv1_live_dashboard_instance(),
    handler: handler,
    params: params,
    request: request,
    release_revision: release_revision,
  )
}

fn serve_stop_handler_response_for_instance(
  instance: HostDashboardInstance,
  params: List<PathParamBinding>,
) -> ServeHttpResponse {
  let node_id = path_param_value(params: params, name: "node_id")
  if node_id == "" {
    serve_text_response(
      status: 400,
      content_type: text_plain_utf8,
      body: "cleanup requires a node id path segment (fail-closed; empty binding is unreachable by construction)\n",
    )
  } else {
    let r = belt_stop_node_for_instance(instance: instance, node_id: node_id)
    serve_text_response(
      status: belt_stop_http_status(r: r),
      content_type: application_json_utf8,
      body: serialize_json(v: belt_stop_result_json_value(r: r)))
  }
}

fn serve_stop_handler_response(params: List<PathParamBinding>) -> ServeHttpResponse {
  serve_stop_handler_response_for_instance(
    instance: srv1_live_dashboard_instance(),
    params: params,
  )
}

fn serve_attempts_response_for_instance(
  instance: HostDashboardInstance,
) -> ServeHttpResponse {
  served_observation_surface_response_for_instance(instance: instance, kind: AttemptsJson)
}

fn serve_attempts_response() -> ServeHttpResponse {
  serve_attempts_response_for_instance(instance: srv1_live_dashboard_instance())
}

// GET /workflow.json is the evidence-derived attempt pipeline. One observation joins current
// modeled state, a bounded jq projection of complete Codex attempt evidence, retained process exit,
// and the node's declared validation contract. The exact projector executable is an ensured
// platform capability. It validates each raw JSON value while omitting unbounded command payloads
// from the synchronous interpreted handler; projector absence or malformed input remains an
// explicit per-attempt refusal. The observed facts reconcile by fold against the shared desired
// obligation roster and expose desired/observed/remaining counts plus distinct observed-failure,
// observed-refusal, and unsafe-plan-refusal counts; they never upgrade provider completion into
// verification, publication, review, or goal audit. A refused attempts ledger returns 503;
// per-attempt event/process refusals remain explicit segment states in a 200 body so one damaged
// attempt cannot erase evidence from every other row.

// The daily page consumes the SAME attempt observation the /workflow.json wire serves (one
// observing authority, two projections): an observed ledger renders real activity regions and the
// active band; a refused ledger renders the page with the ONE workspace observation banner carrying
// the located reason — the page itself stays a 200 because the roadmap authority rendered fine;
// what failed is the activity channel, and that failure is narrated once, in place, exactly as the
// client would narrate it on a later poll.

// HOST-BOUNDARY AMPLIFIER REPAIR (PR #8087, operator ruling 2026-08-10): v1_interpreter
// dispatch_shell drains child stdout/stderr concurrently while the child runs. Bounded the stderr
// buffer+clone amplifier on the shell success path — stderr retains bounded tail (16 KiB) with
// total_bytes, truncated, and FNV digest_hex surfaced via CapturedStreamEvidence /
// map_shell_outputs from_key fields; stdout complete-within 8 MiB or typed ShellOutputLimitExceeded
// refusal (never a silent prefix). TWO WEDGES, TWO ATTEMPTS — this note originally attributed the
// 59.5 MB figure to the profiled recurrence, which was wrong: attempt-state holds several attempts
// per node and only the -current one is projected (the gate is
// <instance_root>/attempt-state/<node>-current/attempt-key), and for node
// v2-emitter-direct-rust-door that key's mtime is 2026-08-09 17:52:15, 8m41s BEFORE the 18:00:56
// wedge, naming 677905e3704d70a3. So the 2026-08-08 wedge selected ...-acc0923494fc8b9cb
// (60,257,673 B raw / 831 lines / 308 non-JSON / jq stdout 30,770 B / jq stderr 59,522,411 B) while
// the profiled 2026-08-09 recurrence selected ...-a677905e3704d70a3 (20,511,073 B raw / 355 lines /
// 101 non-JSON / jq stdout 15,034 B / jq stderr 18,421,072 B). Both exit 0, so both take the ExecOk
// arm where map_shell_outputs clones stderr into a Value::Str — the repair is correct for both, and
// 59,522,411 B remains the witness's legitimate worst-observed STRESS SPECIMEN rather than the
// recurrence's fixture. INCIDENT NOT CLOSED: wedge was finite/self-recovered; wedged route unproven
// — and the two candidate routes are NOT rival cost centers, because
// serve_daily_page_response_for_instance and serve_workflow_response_for_instance both served (then) by calling
// belt_workflow_attempts_observe_for_instance per request (one observing authority, two projections; since the
// served-observation split, gunbc.roadmap_served_observation calls it once per belt tick instead), so they
// share the projection cost and differ only in that the daily page adds the render;
// interpreter-concat hypothesis live and may be primary; share of two-hour peg versus queued
// duplicate polls unmeasured, and the share attributable to stream capture is unestablished in BOTH
// directions (an arithmetic argument that 18.4 MB is too small to explain the peg assumed a fixed
// two copies, which the profile does not support — Value::clone/String::clone sat inside the
// repeating evaluator path, so the multiplier is per-iteration and unmeasured). FIXTURE PROVENANCE:
// the pointer proves which ATTEMPT was selected at onset, not that the retained file is
// byte-identical to what the wedged request read — that attempt was in flight (events mtime
// 18:35:37, i.e. during the 18:00:56-to-~19:52 wedge), so the file grew while the route was polled
// and was smaller at onset; the artifact is the retained final state of the attempt selected at
// wedge onset, never the exact historical request input. Witness:
// bounded_shell_stream_capture_replay. Dissolve-on: emit-on-demand native serve and shared
// CapturedProcessStream carrier subsume this seed-only drain.

fn serve_daily_page_response_for_instance(
  instance: HostDashboardInstance,
) -> ServeHttpResponse {
  served_observation_surface_response_for_instance(instance: instance, kind: DailyPage)
}

fn serve_workflow_response_for_instance(
  instance: HostDashboardInstance,
) -> ServeHttpResponse {
  served_observation_surface_response_for_instance(instance: instance, kind: WorkflowJson)
}

fn serve_workflow_response() -> ServeHttpResponse {
  serve_workflow_response_for_instance(instance: srv1_live_dashboard_instance())
}

// GET /sessions.json performs one session-container observation and one independently adjudicated
// pane/process observation. Session-list refusal serves 503 because container presence is
// unknowable. Pane refusal stays in each known session as process unobserved and cleanup
// unavailable; it cannot erase session presence. The same combined observation feeds both status
// and body so the route never races two reads.

fn serve_sessions_response_for_instance(
  instance: HostDashboardInstance,
) -> ServeHttpResponse {
  served_observation_surface_response_for_instance(instance: instance, kind: SessionsJson)
}

fn serve_sessions_response() -> ServeHttpResponse {
  serve_sessions_response_for_instance(instance: srv1_live_dashboard_instance())
}

fn roadmap_serve_selection_response_over(
  instance: HostDashboardInstance,
  plan: fn() -> RoadmapAuthorityProjection,
  daily_body: ServedDailyBodyAuthority,
  sel: RouteSelection<RoadmapServeHandler>,
  request: ServeHttpRequest<RequestAccessPath, RequestAuthenticationEvidence>,
  release_revision: CommitSha,
  cookie_header: String = "",
) -> ServeHttpResponse {
  match sel {
    SelectedDynamic { handler: h, params: ps } =>
      roadmap_serve_invoke_over(
        instance: instance,
        plan: plan,
        daily_body: daily_body,
        handler: h,
        params: ps,
        request: request,
        release_revision: release_revision,
        cookie_header: cookie_header,
      )
    SelectedStatic { route: r } =>
      ServeHttpResponse { status: r.status_on_hit, content_type: r.content_type, body: r.body, headers: [] }
    MethodNotAllowed { allowed: ms } =>
      serve_text_response(
        status: 405,
        content_type: text_plain_utf8,
        body: join(["method not allowed; allowed: ", http_method_label_join(methods: ms), "\n"], ""),
      )
    NoRouteMatched =>
      serve_page_response_with_status(page: site_document(title: "Page not found · gunbc", heading: "page not found", styles: roadmap_styles(), content: [el("main", [el("h1", [txt("Page not found")]), el("p", [txt("Use the workspace navigation to find an issue or project.")])])]), status: 404)
  }
}

fn roadmap_serve_selection_response_for_instance(
  instance: HostDashboardInstance,
  sel: RouteSelection<RoadmapServeHandler>,
  request: ServeHttpRequest<RequestAccessPath, RequestAuthenticationEvidence>,
  release_revision: CommitSha,
) -> ServeHttpResponse {
  roadmap_serve_selection_response_over(
    instance: instance,
    plan: fn() { roadmap_authority_projection(history: roadmap_acceptance_event_history_load()) },
    daily_body: DailyBodyRenderedUnderThisPlan,
    sel: sel,
    request: request,
    release_revision: release_revision,
  )
}

fn roadmap_serve_selection_response(
  sel: RouteSelection<RoadmapServeHandler>,
  request: ServeHttpRequest<RequestAccessPath, RequestAuthenticationEvidence>,
  release_revision: CommitSha,
) -> ServeHttpResponse {
  roadmap_serve_selection_response_for_instance(
    instance: srv1_live_dashboard_instance(),
    sel: sel,
    request: request,
    release_revision: release_revision,
  )
}

// THE REQUEST-SECURITY CONTEXT, built at the one seam every route shares. The access path is
// modeled from the instance bind, the tailnet header and the serve-route readback through the ACL
// and serve-route authorities: a header alone mints no tailnet path, and neither does a reading
// that is absent, stale, unreadable, or shows another backend at this instance's declared route.
// Authentication evidence is the session cookie the seam passes through, resolved against the
// session store (gunbc.roadmap_auth_routes roadmap_serve_authentication_evidence): an absent
// cookie is AuthAbsent, a cookie that does not resolve to a live session is SessionStandingInvalid
// with its cause. NO REQUEST IS AUTHENTICATED BY TAILNET TRANSPORT.
fn roadmap_serve_request_security(
  instance: HostDashboardInstance,
  tailscale_identity: String,
  ingress: RequestIngress,
  readback: TailnetServeReadback,
  decided_at: String,
  cookie_header: String = "",
) -> RequestSecurityContext<RequestAccessPath, RequestAuthenticationEvidence> {
  RequestSecurityContext {
    access_path: roadmap_serve_access_path(instance: instance, tailscale_identity: tailscale_identity, ingress: ingress, readback: readback, decided_at: decided_at),
    authentication: roadmap_serve_authentication_evidence(instance: instance, cookie_header: cookie_header),
  }
}

// THE ACCESS-PATH HALF OF THE SEAM. The route the reading is compared to is the one the
// desired-deployment roster declares for this instance, so the route a write is admitted on and
// the route the deployment installs are one value.
fn roadmap_serve_access_path(
  instance: HostDashboardInstance,
  tailscale_identity: String,
  ingress: RequestIngress,
  readback: TailnetServeReadback,
  decided_at: String,
) -> RequestAccessPath {
  roadmap_serve_access_path_over(
    listen_host: instance.listen_host,
    declared: roadmap_serve_declared_serve_endpoint(instance: instance),
    tailscale_identity: tailscale_identity,
    ingress: ingress,
    readback: readback,
    decided_at: decided_at,
  )
}

// The same fold over a supplied bind and declared route.
fn roadmap_serve_access_path_over(
  listen_host: NonEmptyStr,
  declared: TailscaleServeEndpoint?,
  tailscale_identity: String,
  ingress: RequestIngress,
  readback: TailnetServeReadback,
  decided_at: String,
) -> RequestAccessPath {
  request_access_path_of_standing(
    listen_host: listen_host,
    tailscale_header: tailscale_identity,
    ingress: ingress,
    standing: tailnet_route_standing(readback: readback, declared: declared, decided_at: decided_at),
    acl_policy: operator_tailscale_acl_policy,
  )
}

// An instance outside the desired-deployment roster, or one whose bind differs from its roster
// row, has no declared serve route, so no reading can vouch for a tailnet path to it.
fn roadmap_serve_declared_serve_endpoint(instance: HostDashboardInstance) -> TailscaleServeEndpoint? {
  match desired_deployment_for_instance_id(instance_id: instance.instance_id as String) {
    DesiredDeploymentFound { row } =>
      if row.instance.listen_port == instance.listen_port && (row.instance.listen_host as String) == (instance.listen_host as String) {
        Present { value: row.names.tailscale_serve_endpoint }
      } else {
        none
      }
    DesiredDeploymentUnknownInstanceId { instance_id: _ } => none
    DesiredDeploymentRosterRefused { refusal: _ } => none
  }
}

// WHICH SELECTED ROUTES DEMAND THE READING: the ones whose write law requires the tailnet path
// (gunbc.workspace_allocation_routes workspace_allocation_deployment_access_policy). Every other
// route decides nothing over the access path's tailnet arm, so it is handed an untaken reading
// rather than paying a process spawn per request -- as is a connection whose ingress is not the
// proxy, which no reading could vouch for.
fn roadmap_serve_selection_requires_tailnet_path(sel: RouteSelection<RoadmapServeHandler>) -> Bool {
  match sel {
    SelectedDynamic { handler: h, params: _ } => h == AllocationCreateHandler || h == AllocationReleaseHandler
    SelectedStatic { route: _ } => false
    MethodNotAllowed { allowed: _ } => false
    NoRouteMatched => false
  }
}

fn roadmap_serve_tailnet_readback(sel: RouteSelection<RoadmapServeHandler>, tailscale_identity: String, ingress: RequestIngress) -> TailnetServeReadback {
  if !roadmap_serve_selection_requires_tailnet_path(sel: sel) || tailscale_identity == "" || !request_ingress_is_the_proxy(ingress: ingress) {
    TailnetServeReadbackUntaken { gap: TailnetReadbackNotDemanded }
  } else {
    tailnet_serve_readback_take()
  }
}

// The instant the access path is decided at, read AFTER the readback so the reading's age is
// measured rather than assumed. An unreadable clock is the empty instant, which no reading is
// fresh against.
fn roadmap_serve_decided_at(readback: TailnetServeReadback) -> String {
  match readback {
    TailnetServeReadbackUntaken { gap: _ } => ""
    TailnetServeReadbackTaken { status_json: _, observed_at: _ } =>
      match clock_now_probed_at() {
        Present { value: now } => now as String
        Absent => ""
      }
  }
}

fn roadmap_serve_respond_over(
  instance: HostDashboardInstance,
  plan: fn() -> RoadmapAuthorityProjection,
  daily_body: ServedDailyBodyAuthority,
  method_label: String,
  path: String,
  body: String,
  tailscale_identity: String,
  ingress: RequestIngress,
  cookie_header: String = "",
  release_revision: CommitSha,
) -> ServeHttpResponse {
  match parse_http_method_label(label: method_label) {
    UnknownMethod { label: l } =>
      serve_text_response(
        status: 501,
        content_type: text_plain_utf8,
        body: join(["unrecognized method: ", l, "\n"], ""),
      )
    KnownMethod { method: m } =>
      match roadmap_serve_route_table_build() {
        ServedRouteTableBuildRefused { raw: r, segment: s, reason: why } =>
          serve_text_response(
            status: 500,
            content_type: text_plain_utf8,
            body: join([
              "route table refused: malformed route literal raw=", r,
              " segment=", s,
              " reason=", why,
              " (fail-closed — fix the literal in gunbc.roadmap_serve.roadmap_serve_route_specs)\n",
            ], ""),
          )
        ServedRouteTableBuilt { table: t } => {
          let sel = serve_select_route(table: t, method: m, path: path)
          let readback = roadmap_serve_tailnet_readback(sel: sel, tailscale_identity: tailscale_identity, ingress: ingress)
          roadmap_serve_selection_response_over(
            instance: instance,
            plan: plan,
            daily_body: daily_body,
            sel: sel,
            cookie_header: cookie_header,
            request: ServeHttpRequest {
              method: m,
              path: path,
              body: body,
              security: roadmap_serve_request_security(
                instance: instance,
                tailscale_identity: tailscale_identity,
                ingress: ingress,
                readback: readback,
                decided_at: roadmap_serve_decided_at(readback: readback),
                cookie_header: cookie_header,
              ),
            },
            release_revision: release_revision,
          )
        }
      }
  }
}

fn roadmap_serve_respond_for_instance(
  instance: HostDashboardInstance,
  method_label: String,
  path: String,
  body: String,
