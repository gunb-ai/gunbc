  serve_sessions_response_for_instance(instance: srv1_live_dashboard_instance())
}

fn http_method_label_join(methods: List<HttpMethod>) -> String {
  join(map(methods, m => match m {
    GET => "GET"
    POST => "POST"
    PUT => "PUT"
    PATCH => "PATCH"
    DELETE => "DELETE"
    HEAD => "HEAD"
    OPTIONS => "OPTIONS"
  }), ", ")
}

fn roadmap_serve_selection_response_over(
  instance: HostDashboardInstance,
  plan: RoadmapAuthorityProjection,
  daily_body: ServedDailyBodyAuthority,
  sel: RouteSelection<RoadmapServeHandler>,
  request: ServeHttpRequest,
  release_revision: CommitSha,
) -> ServeHttpResponse {
  match sel {
    SelectedDynamic { handler: h, params: ps } =>
      roadmap_serve_invoke_over(
        instance: instance,
        plan: plan,
        daily_body: daily_body,
        handler: h,
        params: ps,
        request: request,
        release_revision: release_revision,
      )
    SelectedStatic { route: r } =>
      ServeHttpResponse { status: r.status_on_hit, content_type: r.content_type, body: r.body }
    MethodNotAllowed { allowed: ms } =>
      serve_text_response(
        status: 405,
        content_type: text_plain_utf8,
        body: join(["method not allowed; allowed: ", http_method_label_join(methods: ms), "\n"], ""),
      )
    NoRouteMatched =>
      serve_text_response(status: 404, content_type: text_plain_utf8, body: "not found\n")
  }
}

fn roadmap_serve_selection_response_for_instance(
  instance: HostDashboardInstance,
  sel: RouteSelection<RoadmapServeHandler>,
  request: ServeHttpRequest,
  release_revision: CommitSha,
) -> ServeHttpResponse {
  roadmap_serve_selection_response_over(
    instance: instance,
    plan: roadmap_authority_projection(),
    daily_body: DailyBodyRenderedUnderThisPlan,
    sel: sel,
    request: request,
    release_revision: release_revision,
  )
}

fn roadmap_serve_selection_response(
  sel: RouteSelection<RoadmapServeHandler>,
  request: ServeHttpRequest,
  release_revision: CommitSha,
) -> ServeHttpResponse {
  roadmap_serve_selection_response_for_instance(
    instance: srv1_live_dashboard_instance(),
    sel: sel,
    request: request,
    release_revision: release_revision,
  )
}

fn roadmap_serve_respond_over(
  instance: HostDashboardInstance,
  plan: RoadmapAuthorityProjection,
  daily_body: ServedDailyBodyAuthority,
  method_label: String,
  path: String,
  body: String,
  tailscale_identity: String,
  release_revision: CommitSha,
) -> ServeHttpResponse {
  match parse_http_method_label(label: method_label) {
    UnknownMethod { label: l } =>
      serve_text_response(
        status: 501,
        content_type: text_plain_utf8,
        body: join(["unrecognized method: ", l, "\n"], ""),
      )
    KnownMethod { method: m } =>
      match roadmap_serve_route_table_build() {
        ServedRouteTableBuildRefused { raw: r, segment: s, reason: why } =>
          serve_text_response(
            status: 500,
            content_type: text_plain_utf8,
            body: join([
              "route table refused: malformed route literal raw=", r,
              " segment=", s,
              " reason=", why,
              " (fail-closed — fix the literal in gunbc.roadmap_serve.roadmap_serve_route_specs)\n",
            ], ""),
          )
        ServedRouteTableBuilt { table: t } =>
          roadmap_serve_selection_response_over(
            instance: instance,
            plan: plan,
            daily_body: daily_body,
            sel: serve_select_route(table: t, method: m, path: path),
            request: ServeHttpRequest {
              method: m,
              path: path,
              body: body,
              identity: tailnet_identity_of(header_value: tailscale_identity),
            },
            release_revision: release_revision,
          )
      }
  }
}

fn roadmap_serve_respond_for_instance(
  instance: HostDashboardInstance,
  method_label: String,
  path: String,
  body: String,
  tailscale_identity: String,
  release_revision: CommitSha,
) -> ServeHttpResponse {
  roadmap_serve_respond_over(
    instance: instance,
    plan: roadmap_authority_projection(),
    daily_body: DailyBodyRenderedUnderThisPlan,
    method_label: method_label,
    path: path,
    body: body,
    tailscale_identity: tailscale_identity,
    release_revision: release_revision,
  )
}

fn roadmap_serve_respond(
  method_label: String,
  path: String,
  body: String,
  tailscale_identity: String,
  release_revision: CommitSha,
) -> ServeHttpResponse {
  roadmap_serve_respond_for_instance(
    instance: srv1_live_dashboard_instance(),
    method_label: method_label,
    path: path,
    body: body,
    tailscale_identity: tailscale_identity,
    release_revision: release_revision,
  )
}

// THE IDENTITY ARGUMENT, and why it arrives as one named value rather than a header bag.
//
// `tailscale serve` authenticates the tailnet device and user before proxying, and injects the
// resulting login. It is threaded through the entry rather than read at the handler because there
// is exactly one entry, and a fact every route may need to consult belongs on the request that
// reaches them all; handlers that do not need it ignore it.
//
// NO ROUTE IN THIS TABLE CURRENTLY CONSULTS IT. The routes that did -- the approval pair, where an
// authenticated login is what makes a leaked capability useless to whoever it leaked to -- moved to
// gunbc.auth.approval_broker_serve, which populates its own request from the same header. The
// argument stays because the header is a fact about every request this entry receives rather than
// about the routes that happened to read it, and a serving entry that dropped it would have to
// re-earn it for the next route that needs an authenticated caller.
//
// THE PLAN AUTHORITY IS THE PARAMETER, AND A SERVE ENTRY IS THE WHOLE INTEGRATION.
//
// Instance selection is already by serve entry function, because `gunbc serve` binds --entry and
// --function once for the process's life and carries no per-request argument. The plan a process
// serves is the same KIND of fact -- fixed at launch, constant for every request -- so it arrives
// the same way: an entry function declared in whatever module owns that plan calls this fold with
// its own projection.
//
// What is passed is the PROJECTED PLAN, not a path or a source root. A plan that failed to project
// arrives as RoadmapAuthorityProjectionRefused and every consumer below refuses in its own
// vocabulary; handing over a location instead would have made an unreadable plan indistinguishable
// from an empty one at the surfaces that render it.
//
// It is deliberately NOT a registry. Nothing here enumerates plans, and no table is filled in from
// elsewhere: the direction of the dependency is that the caller reaches this fold, so this module
// stays unaware of who calls it and needs no edit when another one does.
fn roadmap_serve_handle_over(
  instance: HostDashboardInstance,
  plan: RoadmapAuthorityProjection,
  daily_body: ServedDailyBodyAuthority,
  method: String,
  path: String,
  body: String,
  tailscale_identity: String,
  release_revision: CommitSha,
) -> ServeWireResponse {
  serve_wire_response(r: roadmap_serve_respond_over(
    instance: instance,
    plan: plan,
    daily_body: daily_body,
    method_label: method,
    path: path,
    body: body,
    tailscale_identity: tailscale_identity,
    release_revision: release_revision,
  ))
}

fn roadmap_serve_handle(
  method: String,
  path: String,
  body: String,
  tailscale_identity: String,
  release_revision: CommitSha,
) -> ServeWireResponse {
  roadmap_serve_handle_over(
    instance: srv1_live_dashboard_instance(),
    plan: roadmap_authority_projection(),
    daily_body: DailyBodyRenderedUnderThisPlan,
    method: method,
    path: path,
    body: body,
    tailscale_identity: tailscale_identity,
    release_revision: release_revision,
  )
}

// THE OPERATOR MACBOOK'S ENTRY. Instance selection is by serve entry function. That is a
// constraint of `gunbc serve`, not a dual: the Serve verb binds method/path/body from the socket
// and has no `--arg` (handle_serve; Serve flags are function/host/port/release-revision only).
// `gunbc run --arg name=value` exists for ProcessExit entries and does not apply here. Observing
// the repo root at request time would make the served identity depend on where the binary happened
// to be launched, which is an ambient fact, and it would re-answer per request a question that is
// fixed for a process's whole life.
fn roadmap_serve_handle_macbook_local(
  method: String,
  path: String,
  body: String,
  tailscale_identity: String,
  release_revision: CommitSha,
) -> ServeWireResponse {
  roadmap_serve_handle_over(
    instance: macbook_local_dashboard_instance(),
    plan: roadmap_authority_projection(),
    daily_body: DailyBodyRenderedUnderThisPlan,
    method: method,
    path: path,
    body: body,
    tailscale_identity: tailscale_identity,
    release_revision: release_revision,
  )
}

