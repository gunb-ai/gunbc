// THE TAILSCALE_HEADER ARGUMENT — the raw Tailscale-User-Login string — and why it still arrives
// as one named value rather than a header bag.
//
// `tailscale serve` authenticates the tailnet device and user before proxying, and injects the
// resulting login. UNDER THE 2026-09-25 RULING THAT LOGIN IS TRANSPORT METADATA, never
// application identity: it is one INPUT to the access-path modeling (which vouches for it only
// behind a serve-status readback and the ACL revision), and the request-security context carries
// it strictly separate from the authentication evidence. A signed capability establishes WHAT
// is being decided; the Google OIDC session establishes WHO is deciding; the tailnet
// observation, where attributed, is the audit trail the consent record may name.
//
// It is threaded through the entry rather than read at the handler because there is exactly one
// entry, and a fact every route may need to consult belongs on the request that reaches them all.
// Handlers that do not need it ignore it; the write routes consult the write law, which refuses
// on the authentication axis until a Google session arrives at the seam.
//
// THE APPROVAL ROUTES NO LONGER READ IT HERE. They moved to gunbc.auth.approval_broker_serve,
// which populates its own request from the same header; the argument stays because the header is
// a fact about every request this entry receives rather than about the routes that happened to
// read it.
//
// THE PLAN AUTHORITY IS THE PARAMETER, AND A SERVE ENTRY IS THE WHOLE INTEGRATION.
//
// Instance selection is already by serve entry function, because `gunbc serve` binds --entry and
// --function once for the process's life and carries no per-request argument. The plan a process
// serves is the same KIND of fact -- fixed at launch, constant for every request -- so it arrives
// the same way: an entry function declared in whatever module owns that plan calls this fold with
// its own projection.
//
// What is passed is the PROJECTED PLAN, not a path or a source root. A plan that failed to project
// arrives as RoadmapAuthorityProjectionRefused and every consumer below refuses in its own
// vocabulary; handing over a location instead would have made an unreadable plan indistinguishable
// from an empty one at the surfaces that render it.
//
// It is deliberately NOT a registry. Nothing here enumerates plans, and no table is filled in from
// elsewhere: the direction of the dependency is that the caller reaches this fold, so this module
// stays unaware of who calls it and needs no edit when another one does.
fn roadmap_serve_handle_over(
  instance: HostDashboardInstance,
  plan: fn() -> RoadmapAuthorityProjection,
  daily_body: ServedDailyBodyAuthority,
  method: String,
  path: String,
  body: String,
  tailscale_identity: String,
  ingress: RequestIngress,
  request_headers: List<ServeRequestHeader>,
  release_revision: CommitSha,
) -> ServeWireResponse {
  match serve_request_header_reading(headers: request_headers, name: "cookie") {
    ServeRequestHeaderRepeated { occurrences: _ } =>
      serve_wire_response(r: serve_text_response(status: 400, content_type: text_plain_utf8, body: "bad request: duplicate cookie header\n"))
    ServeRequestHeaderAbsent =>
      serve_wire_response(r: roadmap_serve_respond_over(
        instance: instance, plan: plan, daily_body: daily_body, method_label: method, path: path, body: body,
        tailscale_identity: tailscale_identity, ingress: ingress, cookie_header: "", release_revision: release_revision,
      ))
    ServeRequestHeaderSingle { value: cookie_header } =>
      serve_wire_response(r: roadmap_serve_respond_over(
        instance: instance, plan: plan, daily_body: daily_body, method_label: method, path: path, body: body,
        tailscale_identity: tailscale_identity, ingress: ingress, cookie_header: cookie_header, release_revision: release_revision,
      ))
  }
}

// EVERY ENTRY THAT DECLARES NO peer_user IS LAUNCHED ON A TCP LISTENER, which attests no peer, so
// each hands the seam IngressUnattested: its requests cannot mint the tailnet path and the
// tailnet-required writes answer unavailable there. roadmap_serve_handle_door is the one that can.
fn roadmap_serve_handle(
  method: String,
  path: String,
  body: String,
  tailscale_identity: String,
  request_headers: List<ServeRequestHeader>,
  release_revision: CommitSha,
) -> ServeWireResponse {
  roadmap_serve_handle_over(
    instance: srv1_live_dashboard_instance(),
    plan: fn() { roadmap_authority_projection(history: roadmap_acceptance_event_history_load()) },
    daily_body: DailyBodyRenderedUnderThisPlan,
    method: method,
    path: path,
    body: body,
    tailscale_identity: tailscale_identity,
    ingress: IngressUnattested,
    request_headers: request_headers,
    release_revision: release_revision,
  )
}

// THE OPERATOR MACBOOK'S ENTRY. Instance selection is by serve entry function. That is a
// constraint of `gunbc serve`, not a dual: the Serve verb binds method/path/body from the socket
// and has no `--arg` (handle_serve; Serve flags are function/host/port/release-revision only).
// `gunbc run --arg name=value` exists for ProcessExit entries and does not apply here. Observing
// the repo root at request time would make the served identity depend on where the binary happened
// to be launched, which is an ambient fact, and it would re-answer per request a question that is
// fixed for a process's whole life.
// THE PRODUCTION INSTANCE'S TAILNET DOOR ENTRY, launched on the unix socket its serve route
// targets (gunbc.live_deploy.spec deployment_tailnet_door_socket). The listener attests the peer of
// each connection and this entry hands it to the seam as the request's ingress, which is what lets
// a proxied request mint the tailnet path and a local account dialing the socket not.
fn roadmap_serve_handle_door(
  method: String,
  path: String,
  body: String,
  tailscale_identity: String,
  peer_user: String,
  request_headers: List<ServeRequestHeader>,
  release_revision: CommitSha,
) -> ServeWireResponse {
  roadmap_serve_handle_over(
    instance: srv1_live_dashboard_instance(),
    plan: fn() { roadmap_authority_projection(history: roadmap_acceptance_event_history_load()) },
    daily_body: DailyBodyRenderedUnderThisPlan,
    method: method,
    path: path,
    body: body,
    tailscale_identity: tailscale_identity,
    ingress: IngressAttestedPeer { peer_user: peer_user },
    request_headers: request_headers,
    release_revision: release_revision,
  )
}

