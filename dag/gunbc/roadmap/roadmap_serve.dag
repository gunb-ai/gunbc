  serve_workflow_response_for_instance(instance: srv1_live_dashboard_instance())
}

// GET /sessions.json performs one session-container observation and one independently adjudicated
// pane/process observation. Session-list refusal serves 503 because container presence is
// unknowable. Pane refusal stays in each known session as process unobserved and cleanup
// unavailable; it cannot erase session presence. The same combined observation feeds both status
// and body so the route never races two reads.

fn serve_sessions_response_for_instance(
  instance: HostDashboardInstance,
) -> ServeHttpResponse {
  served_observation_surface_response_for_instance(instance: instance, kind: SessionsJson)
}

