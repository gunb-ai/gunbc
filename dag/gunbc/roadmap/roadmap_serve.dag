  [
    RoadmapServeRouteSpec { method: GET, raw: roadmap_site_daily_url_path as String, handler: RoadmapDailyPageHandler },
    RoadmapServeRouteSpec { method: GET, raw: roadmap_site_full_url_path as String, handler: RoadmapFullPageHandler },
    RoadmapServeRouteSpec { method: GET, raw: "/fleet", handler: FleetStandingPageHandler },
    RoadmapServeRouteSpec { method: GET, raw: roadmap_site_roadmap_url_path as String, handler: RoadmapMdHandler },
    RoadmapServeRouteSpec { method: GET, raw: roadmap_site_dispatch_url_path as String, handler: DispatchJsonHandler },
    RoadmapServeRouteSpec { method: GET, raw: roadmap_site_health_path as String, handler: HealthzHandler },
    RoadmapServeRouteSpec { method: GET, raw: "/instance.json", handler: DashboardInstanceHandler },
    RoadmapServeRouteSpec { method: GET, raw: "/provider.json", handler: ProviderReadinessHandler },
    RoadmapServeRouteSpec { method: GET, raw: "/sessions.json", handler: SessionsJsonHandler },
    RoadmapServeRouteSpec { method: GET, raw: "/attempts.json", handler: AttemptsJsonHandler },
    RoadmapServeRouteSpec { method: GET, raw: "/workflow.json", handler: WorkflowJsonHandler },
    RoadmapServeRouteSpec { method: GET, raw: "/observation.json", handler: ObservationJsonHandler },
    RoadmapServeRouteSpec { method: GET, raw: roadmap_dispatch_asset_path, handler: DispatchAssetHandler },
    RoadmapServeRouteSpec { method: GET, raw: "/sandbox", handler: SandboxPageHandler },
    RoadmapServeRouteSpec { method: GET, raw: instrument_sandbox_page_path, handler: InstrumentSandboxPageHandler },
    RoadmapServeRouteSpec { method: GET, raw: instrument_tuner_page_path, handler: InstrumentTunerPageHandler },
    RoadmapServeRouteSpec { method: GET, raw: instrument_tuner_asset_path, handler: InstrumentTunerAssetHandler },
    RoadmapServeRouteSpec { method: GET, raw: instrument_motion_page_path, handler: InstrumentMotionPageHandler },
    RoadmapServeRouteSpec { method: GET, raw: instrument_motion_asset_path, handler: InstrumentMotionAssetHandler },
    RoadmapServeRouteSpec { method: GET, raw: repo_atlas_page_path, handler: RepoAtlasPageHandler },
    RoadmapServeRouteSpec { method: GET, raw: sandbox_asset_path, handler: SandboxAssetHandler },
    RoadmapServeRouteSpec { method: GET, raw: "/approve/\{capability\}", handler: ApprovalConfirmPageHandler },
    RoadmapServeRouteSpec { method: POST, raw: "/approve/\{capability\}", handler: ApprovalDecideHandler },
    RoadmapServeRouteSpec { method: POST, raw: "/approvals", handler: ApprovalSubmitHandler },
    RoadmapServeRouteSpec { method: GET, raw: "/approvals/\{escalation_id\}", handler: ApprovalStatusHandler },
    RoadmapServeRouteSpec { method: POST, raw: "/sandbox/echo", handler: SandboxEchoHandler },
    RoadmapServeRouteSpec { method: POST, raw: "/dispatch/\{node_id\}", handler: BeltDispatchHandler },
    RoadmapServeRouteSpec { method: GET, raw: "/issue/\{node_id\}", handler: IssueDetailPageHandler },
    RoadmapServeRouteSpec { method: POST, raw: "/issue/\{node_id\}/assign", handler: IssueAssignHandler },
    RoadmapServeRouteSpec { method: POST, raw: "/issue/\{node_id\}/comment", handler: IssueCommentHandler },
    RoadmapServeRouteSpec { method: POST, raw: "/publish/\{node_id\}", handler: BeltPublishHandler },
    RoadmapServeRouteSpec { method: POST, raw: "/cleanup/\{node_id\}", handler: BeltStopHandler },
    RoadmapServeRouteSpec { method: POST, raw: "/stop/\{node_id\}", handler: BeltStopHandler },
  ]
}

type RoadmapServeRouteRow
  = RouteRow { route: ServedRoute<RoadmapServeHandler> }
  | RouteRowRefused { raw: String, segment: String, reason: String }

// Cost-shape per DESIGN §6 bare-minimum-cost (review 40297 note: the first cut grew the route list
// by concat inside a fold — the copied-accumulator class that is always fixed regardless of
// realized n): the build is now map (per-spec row sum) + a scalar first-refusal fold (no list
// accumulation) + flat_map projection — linear by construction. The projection's RouteRowRefused
// arm contributes nothing and is reached only in the refusal-free branch (the scalar fold
// structurally excludes refused rows there), so it is a projection, never a fabricated value.

fn roadmap_serve_route_row(spec: RoadmapServeRouteSpec) -> RoadmapServeRouteRow {
  match parse_path_template(raw: spec.raw) {
    MalformedPathTemplate { raw: r, segment: s, reason: why } =>
      RouteRowRefused { raw: r, segment: s, reason: why }
    ParsedPathTemplate { template: tpl } =>
      RouteRow { route: DynamicRoute { method: spec.method, path_pattern: tpl, handler: spec.handler } }
  }
}

fn roadmap_serve_build_from_specs(specs: List<RoadmapServeRouteSpec>) -> RoadmapServeTableBuild {
  let rows = map(specs, spec => roadmap_serve_route_row(spec: spec))
  let first_refusal = fold(rows, init: none, f: (acc, r) =>
    match acc {
      Present { value: v } => acc
      Absent =>
        match r {
          RouteRowRefused { raw: rr, segment: s, reason: why } =>
            Present { value: RoadmapServeTableRefused { raw: rr, segment: s, reason: why } }
          RouteRow { route: _ } => Absent
        }
    }
  )
  match first_refusal {
    Present { value: refusal } => refusal
    Absent =>
      RoadmapServeTable {
        table: ServedRouteTable {
          routes: rows |> flat_map(r => match r {
            RouteRow { route: rt } => [rt]
            RouteRowRefused { raw: _, segment: _, reason: _ } => []
          })
        }
      }
  }
}

fn roadmap_serve_route_table_build() -> RoadmapServeTableBuild {
  roadmap_serve_build_from_specs(specs: roadmap_serve_route_specs())
}

fn serve_text_response(status: HttpStatus, content_type: MediaType, body: String) -> ServeHttpResponse {
  ServeHttpResponse { status: status, content_type: content_type, body: body }
}

// A page render refusal is a TYPED 500 carrying the emitter's reason — never an empty page and
// never a dropped route (the EmitRejected => [] route-drop in node_http_server_emit is a silent
// widen this path deliberately does not copy; DESIGN 5). The BODY of both arms is
// roadmap_static_site.served_page_body, shared with the healthz digest map rather than spelled
// twice: healthz publishes the digest of the served surface so a deploy can prove the running
// process is serving THIS tree, and a digest taken over a body that is merely supposed to match the
// route's would be validation standing where construction was available — the check would go green
// while the route lied. Only the STATUS split lives here, because a digest has no status.

fn serve_page_response(page: Fragment) -> ServeHttpResponse {
  match try_serialize_html_source(node: page) {
    EmitOk { html: h } =>
      serve_text_response(status: 200, content_type: text_html_utf8, body: h)
    EmitRejected { reason: r } =>
      serve_text_response(
        status: 500,
        content_type: text_plain_utf8,
        body: page_render_refusal_body(reason: r),
      )
  }
}

fn serve_page_response_with_status(page: Fragment, status: HttpStatus) -> ServeHttpResponse {
  match try_serialize_html_source(node: page) {
    EmitOk { html } => serve_text_response(status: status, content_type: text_html_utf8, body: html)
    EmitRejected { reason } => serve_text_response(
      status: 500,
      content_type: text_plain_utf8,
      body: page_render_refusal_body(reason: reason),
    )
  }
}

// TOTAL per-arm status mapping over the route's outcome (DESIGN 5): every BeltSpawnOutcome arm and
// every LaunchRefusal arm has its own row in launch_refusal_http_status -- no lazy 200-or-500
// collapse. Spawned and LaunchAlreadyLive = 200 (the click achieved or already holds the desired
// state, the same idempotent-success fold the CLI exit map uses); LaunchNoActuatingInstance and
// LaunchInstanceActuationRefused = 403 (no actuating instance stands behind the request);
// LaunchNodeUnknown = 404; the state conflicts (superseded, accepted, review-only, unsized,
// contract missing, centering absent, dependencies blocked, stale or conflicting session, capacity, cause not
// permitted by mode) = 409, retryable only after the state changes; the observation refusals
// (transition inhibited, revision unobserved or drifted, authority unobserved, sessions
// unobservable, liveness unobserved, gate not evaluated) = 503, a retry can succeed; SpawnFailed =
// 502 (actuation behind the server failed; the receipt carries step, detail and the admitted launch
// identity).

fn launch_refusal_http_status(r: LaunchRefusal) -> HttpStatus {
  match r {
    LaunchAlreadyLive { session_name: _ } => 200
    LaunchNoActuatingInstance { reason: _ } => 403
    LaunchInstanceActuationRefused { instance_id: _, reason: _ } => 403
    LaunchNodeUnknown => 404
    LaunchAlreadyAccepted => 409
    LaunchNodeSuperseded { by: _ } => 409
    LaunchReviewRequired => 409
    LaunchSizeMissing => 409
    LaunchExecutionContractMissing { reason: _ } => 409
    LaunchCenteringAbsent => 409
    LaunchNotAgentWork { mode: _ } => 409
    LaunchDependenciesBlocked { blockers: _ } => 409
    LaunchNoCapacity { occupied: _, max_concurrent: _ } => 409
    LaunchCauseNotPermitted { cause: _, mode: _ } => 409
    LaunchStaleSession { session_name: _, detail: _ } => 409
    LaunchTransitionInhibited { reason: _ } => 409
    LaunchSessionMultiplicityConflict { session_names: _, session_count: _ } => 409
    LaunchSessionsUnobservable { reason: _ } => 503
    LaunchAuthorityUnobserved { detail: _ } => 503
    LaunchRevisionUnobserved { cause: _ } => 503
    LaunchLivenessUnobserved { session_name: _, reason: _ } => 503
    LaunchGateNotEvaluated { gate: _ } => 503
  }
}

fn belt_dispatch_status(r: BeltSpawnOutcome) -> HttpStatus {
  match r {
    Spawned { node_id: _, session_name: _, provider: _, launch: _ } => 200
    SupervisorConvened { node_id: _, unit: _, provider: _, launch: _ } => 200
    SpawnFailed { node_id: _, step: _, detail: _, provider: _, launch: _ } => 502
    SpawnNotAdmitted { node_id: _, refusal } => launch_refusal_http_status(r: refusal)
  }
}

fn belt_dispatch_response(r: BeltSpawnOutcome) -> ServeHttpResponse {
  serve_text_response(
    status: belt_dispatch_status(r: r),
    content_type: application_json_utf8,
    body: serialize_json(v: belt_spawn_outcome_json(o: r)),
  )
}

// The node_id param is bound by the route template, so an empty value is unreachable by
// construction (match_path_template refuses empty segments); the empty-check below is the typed
// backstop for that unreachable arm — a 400 refusal, never a dispatch with a fabricated id (DESIGN
// 5: an unreachable arm refuses, never fabricates).

fn serve_dispatch_handler_response_over(
  instance: HostDashboardInstance,
  plan: RoadmapAuthorityProjection,
  params: List<PathParamBinding>,
) -> ServeHttpResponse {
  let node_id = path_param_value(params: params, name: "node_id")
  if node_id == "" {
    serve_text_response(
      status: 400,
      content_type: text_plain_utf8,
      body: "dispatch requires a node id path segment (fail-closed; empty binding is unreachable by construction)\n",
    )
  } else {
    belt_dispatch_response(
      r: belt_dispatch_node_for_instance_over(instance: instance, plan: plan, node_id: node_id),
    )
  }
}

fn serve_dispatch_handler_response_for_instance(
  instance: HostDashboardInstance,
  params: List<PathParamBinding>,
) -> ServeHttpResponse {
  serve_dispatch_handler_response_over(
    instance: instance,
    plan: roadmap_authority_projection(),
    params: params,
  )
}

// POST /publish/NODE_ID is the publication producer's live trigger, and it exists because belt_tick
// has none. Publication is wired into that actuation pass beside verification and nothing drives
// it, so without this route the receipt would never be written in production and the row's lamp
// could never move off pending - the same never-runs defect one layer out from the one this lane
// fixed.\n\nIT IS A POST BECAUSE IT WRITES. The workflow route reads and paints; this one observes
// two remote surfaces and persists a judgment, and putting that on the read path would make the
// browser poll the thing that queries GitHub - the split serve_workflow_note already draws for
// verification.\n\nTHE STATUS COMES FROM THE OUTCOME, not from whether the handler ran. A deferral
// is 409 and a belt-side failure is 500, so a caller can tell `the attempt is not ready` from `the
// belt could not do its job` without reading prose.

fn serve_publish_handler_response_for_instance(
  instance: HostDashboardInstance,
  params: List<PathParamBinding>,
) -> ServeHttpResponse {
  let node_id = path_param_value(params: params, name: "node_id")
  if node_id == "" {
    serve_text_response(
      status: 400,
      content_type: text_plain_utf8,
      body: "publish requires a node id path segment (fail-closed; empty binding is unreachable by construction)\n",
    )
  } else {
    let outcome = belt_publish_node_for_instance(instance: instance, node_id: node_id)
    serve_text_response(
      status: belt_publish_outcome_http_status(o: outcome),
      content_type: application_json_utf8,
      body: serialize_json(v: belt_publish_outcome_json_value(o: outcome)),
    )
  }
}

// ── The approval routes ──────────────────────────────────────────────────────────────────────
// THE GET RENDERS AND NEVER DECIDES. This is the operator's first sight of the request: what is
// being asked, for which resource, for how long, and by whom. It is deliberately a plain page with
// no side effect, because everything that fetches a URL without a person -- previews, scanners,
// prefetch -- lands here, and landing here must cost nothing.
//
// It does not verify the capability either. A confirmation page that refused an unverifiable
// capability would be an oracle: anyone able to reach the route could learn which capabilities are
// live by watching which pages render. The page describes the decision the URL claims to carry;
// the POST is where a claim becomes a fact.
fn approval_confirm_page_response(
  request: ServeHttpRequest<RequestAuthenticationEvidence>,
  params: List<PathParamBinding>,
) -> ServeHttpResponse {
  let segment = path_param_value(params: params, name: "capability")
  let decision_word = match parse_capability_segment(segment: segment) {
    CapabilitySegmentParsed { escalation_id: _, decision: ProposeApprove, tag_hex: _ } => "APPROVE"
    CapabilitySegmentParsed { escalation_id: _, decision: ProposeDeny, tag_hex: _ } => "DENY"
    CapabilitySegmentMalformed { detail: _ } => "(malformed capability)"
  }
  serve_page_response(page: el("html", [
    el("head", [ el("title", [ txt("gunbc approval") ]), el_attrs("meta", [ attr(name: "name", value: "viewport"), attr(name: "content", value: "width=device-width, initial-scale=1") ], []) ]),
    el("body", [
      el("h1", [ txt(join(["Confirm: ", decision_word], "")) ]),
      el("p", [ txt("This page does not decide anything. Opening a link -- by tapping it, previewing it, or having a scanner fetch it -- must never spend an approval, so this route renders and stops. The button below POSTs to the same path, and that request is the one that commits.") ]),
      el("p", [ txt(join(["capability: ", segment], "")) ]),
      el_attrs("form", [ attr(name: "method", value: "post"), attr(name: "action", value: join(["/approve/", segment], "")) ], [
        el_attrs("button", [ attr(name: "type", value: "submit") ], [ txt(decision_word) ]),
      ]),
    ]),
  ]))
}

// THE POST IS THE ONLY ROUTE THAT COMMITS, and every refusal it can produce is the broker's or
// the store's rather than this handler's. The handler's whole job is to hand the store's fold the
// things only the request carries -- the method, the capability segment from the path, the
// AUTHENTICATED IDENTITY and the clock reading -- and to render whatever comes back.
//
// The operator observation comes from the request's ACCESS PATH — the proxy-attributed tailnet
// login the path modeling vouches for, else absent. It is transport/audit metadata for the
// consent record, never authentication evidence: it is not read from the body, a query
// parameter, or a cookie (those are supplied by whoever is making the request), and whether it
// is evidence at all is the deployment's to establish, not this handler's to assume:
// gunbc.auth.approval_decision_store approval_identity_trust says NOT ESTABLISHED while the unit
// binds 0.0.0.0, and redeem_over_store refuses on that row before it reads anything else. So
// until the deployment earns the trust, this route answers a located refusal naming the blocker
// -- which is the honest successor to the 501 it used to answer, not a silent 200 and not a
// decision nobody recorded. THE GOOGLE-PRINCIPAL AXIS OF THIS DECISION IS THE APPROVALS LANE'S
// CUT (A7): the authenticated session gate and the exact capability conjunction land there; this
// handler passes the transport observation unchanged.
//
// A 503 IS THE DEPLOYMENT'S OR THE STORE'S FAULT, never the operator's: it names what to fix
// before trying again, and it is the honest successor to the 501 this route answered while the
// store did not exist.
//
// THE SEGMENT IS PARSED BEFORE ANY HOST READ, AND THE CLOCK AND KEYRING ARE READ ONLY PAST THE
// TRUST GATE. All three are ordered so that a refusal costs no effect it should have prevented: a
// segment that is not <escalation>.<decision>.<hex> is 400 with the clock, the keyring and the
// store untouched -- which is also what keeps the hermetic witness able to reach this handler
// whether or not the trust standing is established (it is derived from the instance bind and is
// closed while srv1_live_dashboard_instance binds 0.0.0.0), since Clock.Now has no hermetic arm.
fn approval_decide_response(
  request: ServeHttpRequest<RequestAuthenticationEvidence>,
  params: List<PathParamBinding>,
) -> ServeHttpResponse {
  let segment = path_param_value(params: params, name: "capability")
  match parse_capability_segment(segment: segment) {
    CapabilitySegmentMalformed { detail: d } =>
      serve_text_response(
        status: 400,
        content_type: text_plain_utf8,
        body: join(["approval decision: ", d as String, "\ncapability: ", segment, "\ntransport observation: ", tailnet_identity_login(i: tailnet_transport_observation(security: request.security)), "\n"], ""),
      )
    CapabilitySegmentParsed { escalation_id: _, decision: _, tag_hex: _ } => approval_decide_parsed_response(request: request, segment: segment)
  }
}

fn approval_decide_parsed_response(request: ServeHttpRequest<RequestAuthenticationEvidence>, segment: String) -> ServeHttpResponse {
  let observed_at = match approval_identity_trust {
    IdentityHeaderTrustNotEstablished { blocker: _ } => ""
    IdentityHeaderTrustEstablished { evidence: _ } => match clock_now_probed_at() { Present { value: t } => t as String  Absent => "" }
    IdentityHeaderUnattributed { residual: _ } => match clock_now_probed_at() { Present { value: t } => t as String  Absent => "" }
  }
  let keyring = match approval_identity_trust {
    IdentityHeaderTrustNotEstablished { blocker: _ } => ApprovalKeyringRefused { cause: ApprovalKeyFileAbsent { path: approval_mac_key_path } }
    IdentityHeaderTrustEstablished { evidence: _ } => read_approval_keyring()
    IdentityHeaderUnattributed { residual: _ } => read_approval_keyring()
  }
  let transport_observation = tailnet_transport_observation(security: request.security)
  let outcome = redeem_over_store(
    root: approval_decision_store_root,
    trust: approval_identity_trust,
    keyring: keyring,
    method: request.method,
    segment: segment,
    presented_identity: transport_observation,
    observed_at: observed_at,
  )
  let status = match outcome {
    RedeemedApproved { decision: _ } => 200
    RedeemedDenied { decision: _ } => 200
    AlreadyDecided { decision: _ } => 200
    RedemptionSegmentMalformed { detail: _ } => 400
    RedemptionEscalationNotFiled { escalation_id: _ } => 404
    RedemptionBrokerRefused { cause: _ } => 403
    RedemptionLostTheRace => 409
    RedemptionStoreUnreadable { detail: _ } => 503
    RedemptionKeyringUnavailable { cause: _ } => 503
    RedemptionIdentityUntrusted { blocker: _ } => 503
    RedemptionCommitRefused { detail: _ } => 503
  }
  serve_text_response(
    status: status,
    content_type: text_plain_utf8,
    body: join([
      "approval decision: ", store_redemption_reason(r: outcome), "\n",
      "capability: ", segment, "\n",
      "transport observation: ", tailnet_identity_login(i: transport_observation), "\n",
      "observed_at: ", observed_at, "\n",
    ], ""),
  )
}

// THE FILING ROUTE. No identity gate here: the filer is a workflow run on a tagged node with no
// login to present, and its enrolment is the MAC over the canonical request under the submission
// key (gunbc.auth.approval_request_submission). Every refusal is the fold's; this handler passes
// the body and renders the outcome, and the response never carries a link -- links go only to the
// operator's phone.
fn approval_submit_response(request: ServeHttpRequest<RequestAuthenticationEvidence>) -> ServeHttpResponse {
  let outcome = match parse_submission_envelope(text: request.body) {
    SubmissionEnvelopeUnreadable { detail: d } => SubmissionRefused { refusal: SubmissionUnreadable { detail: d } }
    SubmissionEnvelopeParsed { tag_hex: tag, request: r } =>
      match admit_parsed_submission(tag_hex: tag, request: r, keyring: read_submission_keyring()) {
        SubmissionNotAdmitted { refusal: refused } => SubmissionRefused { refusal: refused }
        SubmissionVerified { request: admitted } =>
          file_and_notify(
            root: approval_decision_store_root,
            capability_keyring: read_approval_keyring(),
            publisher: read_publisher_token(),
            request: admitted,
          )
      }
  }
  let status = match outcome {
    SubmissionFiledAndNotified { escalation_id: _, message_id: _ } => 201
    SubmissionFiledNotNotified { escalation_id: _, publish: _ } => 502
    SubmissionFiledPublisherTokenUnavailable { escalation_id: _, detail: _ } => 503
    SubmissionFiledLinksNotIssued { escalation_id: _, key_id: _ } => 503
    SubmissionAlreadyFiled { escalation_id: _ } => 409
    SubmissionStoreRefused { detail: _ } => 503
    SubmissionRefused { refusal: v } => match v {
      SubmissionUnreadable { detail: _ } => 400
      SubmissionKeyUnavailable { cause: _ } => 503
      SubmissionNotEnrolled { detail: _ } => 403
      SubmissionAuthorityRefused { requester: _, authority: _ } => 403
    }
    SubmissionFiledCapabilityKeyUnavailable { escalation_id: _, cause: _ } => 503
  }
  serve_text_response(
    status: status,
    content_type: text_plain_utf8,
    body: join(["approval submission: ", submission_outcome_reason(o: outcome), "\n"], ""),
  )
}

// THE STATUS ROUTE a filing run polls: standing and, once decided, who and when. Nothing here is
// a secret and nothing here decides, so it takes no identity and performs no write.
// THE SEGMENT IS NON-EMPTY BY THE ROUTER'S CONSTRUCTION (extdeps.uri_path: a ParamToken binds a
// non-empty segment and empties never match), so this handler is only ever entered with an id and
// carries no guard for the state the router already makes unreachable (review 67057).
fn approval_status_response(params: List<PathParamBinding>) -> ServeHttpResponse {
  let standing = escalation_status(root: approval_decision_store_root, escalation_id: path_param_value(params: params, name: "escalation_id") as NonEmptyStr)
  serve_text_response(status: standing.status, content_type: text_plain_utf8, body: standing.body)
}

// THE ISSUE DETAIL ROUTE (owner ruling 2026-09-24: the detail page is a real served route). ONE
// issue rendered live from the same authorities the daily page reads: the plan for the ticket and
// the parent/blocking links, the standings observation for the holder, the node's event log for
// the Work tab's durable execution history — a local read per request, the same grain the tick's
// standings read pays. THE ASSIGNMENT FIELD'S RECENTS ride the all-events read (the cross-issue
// ledger fold); a refused all-events read degrades to the seeds alone rather than refusing the
// page — the suggestions feed is furniture, not the issue's truth. Attempts ride the render
// entry's parameter (the live attempt feed is the belt-side observation-storage decision, deferred
// with its reason in the report); the events keep the Work tab honest until it lands. Unknown ids
// render the not-found document at 404.
fn serve_issue_detail_response_over(
  instance: HostDashboardInstance,
  plan: RoadmapAuthorityProjection,
  params: List<PathParamBinding>,
  request: ServeHttpRequest<RequestAuthenticationEvidence>,
) -> ServeHttpResponse {
  let node_id = path_param_value(params: params, name: "node_id")
  let layout = roadmap_event_carrier_layout_for_instance(instance: instance)
  let standings = roadmap_standings_read(layout: layout)
  let viewer = authenticated_viewer_label(evidence: request.security.authentication)
  let recents = match roadmap_events_read_all(layout: layout) {
    AllEventsRead { envelopes } => roadmap_recent_claimed_assignees(envs: envelopes)
    AllEventsReadRefused { step: _, reason: _ } => []
  }
  let envelopes = match roadmap_events_read(layout: layout, node: node_id as NonEmptyStr as RoadmapNodeId) {
    EventsRead { node: _, envelopes } => envelopes
    EventsReadRefused { node: _, step: _, reason: _ } => []
  }
  let page = issue_detail_page_for(
    proj: plan,
    node_id: node_id,
    attempts: [],
    attempts_refused: none,
    standings: standings,
    launch: belt_launch_host_standing_for_page_over(instance: instance, plan: plan),
    stale_nodes: [],
    events: envelopes,
    viewer: viewer,
    recents: recents)
  serve_page_response_with_status(
    page: page,
    status: if issue_detail_node_exists(proj: plan, node_id: node_id) { 200 } else { 404 })
}

// THE ASSIGNEE SUBMISSION, resolved to the stable PrincipalRef the v3 event records (owner
// ruling: the picker displays emails but submits principals). Resolution order: a principal label
// parses directly; the fabric selector maps by declaration to the one workflow principal; any
// other email goes through the directory lookup — and the directory producer is A9, so until it
// lands the lookup refuses with the typed vocabulary rather than minting a principal from an
// email (the banned shape has no constructor anywhere in gunbc).
fn assignee_submission_shape_valid(s: String) -> Bool {
  issue_assignee_input_is_email(s: s)
    || trim(s) == (issue_assign_fabric_display as String)
    || match principal_ref_parse_label(s: s) { Present { value: _ } => true  Absent => false }
}

fn assignee_principal_of(raw: String) -> PrincipalRef? {
  let t = trim(raw)
  match principal_ref_parse_label(s: t) {
    Present { value: ref } => Present { value: ref }
    Absent =>
      if t == (issue_assign_fabric_display as String) {
        Present { value: fabric_workflow_principal }
      } else {
        none
      }
  }
}

fn assignee_lookup_refusal(raw: String) -> String {
  let t = trim(raw)
  if issue_assignee_input_is_email(s: t) && t != (issue_assign_fabric_display as String) {
    join(["'", t, "' names no admitted principal — the typed-email directory lookup is the A9 producer and no directory is bound yet, so human emails cannot mint a principal (and never will: email is display, not identity)"], "")
  } else {
    join(["'", t, "' is neither a principal spelling, the fabric selector, nor an email spelling"], "")
  }
}

// THE DURABLE ASSIGN ROUTE — the AssignIssue command (owner rulings 2026-09-24 and the 2026-09-25
// issue-page mandate): POST /issue/<id>/assign records a Claimed event carrying the ASSIGNEE and
// the RETURN_TO principal explicitly (default return_to = the requester — the authenticated
// principal, never derived from whichever event was first), chained on the single head by the
// event-CLI idiom: read, refuse on forked/incomplete history (409), parent = the head, probed
// clock, append through the carrier. The expected_issue_revision field pins the head the page
// rendered under: a mismatch is 409 STALE, never a silent chain onto a history the writer never
// saw — reload and the form re-pins. The author is the AUTHENTICATED PRINCIPAL: the write law
// (gunbc.auth.request_authentication.human_write_admission) admits this route only on the
// conjunction of a Google OIDC session, action authorization, and the CSRF proof, and the event
// records the session principal's stable label — tailnet transport alone refuses at the
// authentication axis with a located reason and is never a person the backend may act for.
// A HUMAN ASSIGNEE NEVER
// DISPATCHES: the response records the fact and stops. THE FABRIC ENDPOINT IS THE EXECUTION ENTRY
// POINT (the Start Work button is retired): after the event lands, the handler drives the SAME
// launch admission the /dispatch route answers. AN ADMISSION REFUSAL DOES NOT UNDO THE ASSIGNMENT:
// the event stands, the issue stays with Fabric, and the response renders the located waiting
// condition in the launch's typed refusal vocabulary — "waiting on fabric: <label> — <reason>",
// never "assignment failed". RE-ASSIGNING THE SAME REVISION joins the existing request: the
// admission's own already-live / already-accepted arms refuse the duplicate attempt, and the
// response says the assignment stands beside the refusal. THE REQUEST BODY is the form's
// text/plain encoding — newline-delimited k=v fields, no percent-encoding to undo.
fn serve_issue_assign_response_over(
  instance: HostDashboardInstance,
  plan: RoadmapAuthorityProjection,
  request: ServeHttpRequest<RequestAuthenticationEvidence>,
  params: List<PathParamBinding>,
) -> ServeHttpResponse {
  let node_id = path_param_value(params: params, name: "node_id")
  if !issue_detail_node_exists(proj: plan, node_id: node_id) {
    serve_text_response(status: 404, content_type: text_plain_utf8, body: join(["issue not found: ", node_id, "\n"], ""))
  } else {
    let observed_at = match clock_now_probed_at() { Present { value: t } => t as String  Absent => "" }
    match human_write_admission(
      route_path: join(["/issue/", node_id, "/assign"], "") as NonEmptyStr,
      action: ServeActionAssignIssue,
      security: request.security,
      authorization_policy: tracker_write_authorization_policy,
      deployment_policy: roadmap_deployment_access_policy,
      csrf_presented: issue_form_field(body: request.body, name: "csrf"),
      observed_at: observed_at,
    ) {
      Deny { refusal } =>
        serve_text_response(status: 403, content_type: text_plain_utf8, body: concat("assignment refused: ", access_refusal_reason(refusal: refusal)))
      Permit =>
        let author = authenticated_write_author_label(security: request.security)
        let raw_assignee = issue_form_field(body: request.body, name: "assignee")
        if !assignee_submission_shape_valid(s: raw_assignee) {
          serve_text_response(status: 400, content_type: text_plain_utf8, body: join(["assignment refused: '", raw_assignee, "' is not an email spelling, the fabric selector, or a principal spelling\n"], ""))
        } else {
          let raw_return_to = issue_form_field(body: request.body, name: "return_to")
          if raw_return_to != "" && !assignee_submission_shape_valid(s: raw_return_to) {
            serve_text_response(status: 400, content_type: text_plain_utf8, body: join(["assignment refused: return_to '", raw_return_to, "' is not an email spelling, the fabric selector, or a principal spelling\n"], ""))
          } else {
            let layout = roadmap_event_carrier_layout_for_instance(instance: instance)
            let nid = node_id as NonEmptyStr as RoadmapNodeId
            match roadmap_events_read(layout: layout, node: nid) {
              EventsReadRefused { node: _, step, reason } =>
                serve_text_response(status: 503, content_type: text_plain_utf8, body: join(["assignment refused: could not read the issue's history (", step, "): ", reason, "\n"], ""))
              EventsRead { node: _, envelopes } =>
                let standing = roadmap_node_standing(envs: envelopes)
                let key = roadmap_node_standing_key(s: standing)
                if key == "forked" || key == "history_incomplete" {
                  serve_text_response(status: 409, content_type: text_plain_utf8, body: join(["assignment refused: the issue's history is ", key, ": ", roadmap_node_standing_text(s: standing), "\n"], ""))
                } else {
                  let heads = filter(envelopes, e => !any(envelopes, o => match o.event.parent { Present { value: p } => (p as String) == (e.id as String)  Absent => false }))
                  let head = match heads.first() { Present { value: h } => h.id as String  Absent => "" }
                  let expected_revision = issue_form_field(body: request.body, name: "expected_revision")
                  if expected_revision != "" && expected_revision != head {
                    serve_text_response(status: 409, content_type: text_plain_utf8, body: join(["assignment refused: the issue changed since the page rendered (expected revision ", expected_revision, ", head ", head, ") — reload and assign again\n"], ""))
                  } else {
                    let at = match clock_now_probed_at() { Present { value: t } => t as String  Absent => "" }
                    match authenticated_write_author_principal(security: request.security) {
                      Absent =>
                        serve_text_response(status: 403, content_type: text_plain_utf8, body: "assignment refused: admitted write carried no author principal (unreachable past the write law)\n")
                      Present { value: author_ref } =>
                        match assignee_principal_of(raw: raw_assignee) {
                          Absent =>
                            serve_text_response(status: 400, content_type: text_plain_utf8, body: join(["assignment refused: ", assignee_lookup_refusal(raw: raw_assignee), "\n"], ""))
                          Present { value: assignee_ref } =>
                            match (if raw_return_to == "" { Present { value: author_ref } } else { assignee_principal_of(raw: raw_return_to) }) {
                              Absent =>
                                serve_text_response(status: 400, content_type: text_plain_utf8, body: join(["assignment refused: return_to ", assignee_lookup_refusal(raw: raw_return_to), "\n"], ""))
                              Present { value: return_to_ref } =>
                                match roadmap_event_append(layout: layout, event: RoadmapEvent { node: nid, author: EventPrincipalAuthenticated { ref: author_ref }, parent: match heads.first() { Present { value: h } => Present { value: h.id }  Absent => none }, kind: Claimed { assignee: EventPrincipalAuthenticated { ref: assignee_ref }, return_to: EventPrincipalAuthenticated { ref: return_to_ref } }, recorded_at: at }) {
                                  EventAppended { id } =>
                                    serve_assignment_launch_follow_through(instance: instance, plan: plan, node_id: node_id, assignee: assignee_ref, event_id: id as String)
                                  EventAlreadyPresent { id } =>
                                    serve_assignment_launch_follow_through(instance: instance, plan: plan, node_id: node_id, assignee: assignee_ref, event_id: id as String)
                                  EventAppendRefused { id: _, step, reason } =>
                                    serve_text_response(status: 503, content_type: text_plain_utf8, body: join(["assignment refused at ", step, ": ", reason, "\n"], ""))
                                }
                            }
                        }
                    }
                  }
                }
            }
          }
        }
    }
  }
}

// THE AUTHOR PRINCIPAL OF AN ADMITTED WRITE, the typed form the v3 event records: a Google OIDC
// session writes as its seated principal; fabric service evidence writes as the one workflow
// principal (a service writer never presents a human session as workload identity — the ruling's
// service-writer law). Only reachable past the write law's Permit arm; the Absent fallback is the
// loud spelling of an unreachable state, refused at the call site, never a value that reaches the
// durable record.
fn authenticated_write_author_principal(security: RequestSecurityContext<RequestAuthenticationEvidence>) -> PrincipalRef? {
  match security.authentication {
    GoogleOidcSession { session } => Present { value: session.principal }
    FabricServiceEvidence { kind: _, authenticated_at: _ } => Present { value: fabric_workflow_principal }
    AuthAbsent => none
  }
}

// THE AUTHOR OF AN ADMITTED HUMAN WRITE. Only reachable past the write law's Permit arm, which
// only a GoogleOidcSession can produce; every other arm is refused above, so the fallback string
// is the loud spelling of an unreachable state, never a value that can reach the durable record.
fn authenticated_write_author_label(security: RequestSecurityContext<RequestAuthenticationEvidence>) -> NonEmptyStr {
  match security.authentication {
    GoogleOidcSession { session } => principal_ref_label(p: session.principal) as NonEmptyStr
    _ => "unreachable: admitted human write without a session principal" as NonEmptyStr
  }
}

// ONE FIELD OF A TEXT/PLAIN FORM BODY (the issue forms ship enctype text/plain — newline-
// delimited k=v fields, no percent-encoding to undo): the line "name=value", value taken verbatim
// to the line end (the fields here are single-line by construction — an email spelling, an event
// id; the comment body rides LAST and is parsed by its own rule, since markdown freely carries
// newlines). A field absent from the body reads as "".
fn issue_form_field(body: String, name: String) -> String {
  let prefix = join([name, "="], "")
  match (filter(split(s: body, delimiter: "\n"), line => starts_with(s: line, prefix: prefix))).first() {
    Present { value: line } => substring(s: line, start: string_length(s: prefix), end: string_length(s: line))
    Absent => ""
  }
}

// THE EXECUTION ENTRY POINT'S FOLLOW-THROUGH, factored pure over the admission outcome so the
// witness drives it with constructed outcomes: a human assignee stops at the recorded fact (NEVER
// dispatches); the fabric endpoint drives the SAME admission the /dispatch route answers and the
// response renders what came back — admitted (the attempt renders on the Work tab), actuation
// failure (502, the assignment stands), or the typed refusal: the issue STAYS with Fabric and the
// body names the located waiting condition, never "assignment failed".
fn serve_assignment_launch_follow_through(
  instance: HostDashboardInstance,
  plan: RoadmapAuthorityProjection,
  node_id: String,
  assignee: PrincipalRef,
  event_id: String,
) -> ServeHttpResponse {
  if principal_ref_eq(a: assignee, b: fabric_workflow_principal) {
    serve_fabric_assignment_response(
      node_id: node_id,
      assignee: assignee,
      event_id: event_id,
      outcome: belt_dispatch_node_for_instance_over(instance: instance, plan: plan, node_id: node_id),
    )
  } else {
    serve_text_response(status: 200, content_type: text_plain_utf8, body: join(["assigned: ", node_id, " → ", principal_ref_label(p: assignee), " (event ", event_id, ")\n"], ""))
  }
}

fn serve_fabric_assignment_response(node_id: String, assignee: PrincipalRef, event_id: String, outcome: BeltSpawnOutcome) -> ServeHttpResponse {
  match outcome {
    Spawned { node_id: _, session_name, provider: _, launch: _ } =>
      serve_text_response(status: 200, content_type: text_plain_utf8, body: join(["assigned: ", node_id, " → ", principal_ref_label(p: assignee), " (event ", event_id, ")\nfabric work request admitted: session ", session_name, " — the attempt renders on the Work tab\n"], ""))
    SupervisorConvened { node_id: _, unit, provider: _, launch: _ } =>
      serve_text_response(status: 200, content_type: text_plain_utf8, body: join(["assigned: ", node_id, " → ", principal_ref_label(p: assignee), " (event ", event_id, ")\nfabric work request admitted: supervisor ", unit, " — the attempt renders on the Work tab\n"], ""))
    SpawnFailed { node_id: _, step, detail, provider: _, launch: _ } =>
      serve_text_response(status: 502, content_type: text_plain_utf8, body: join(["assigned: ", node_id, " → ", principal_ref_label(p: assignee), " (event ", event_id, ")\nfabric launch failed at ", step, ": ", detail, " — the assignment stands; re-assign to retry the request\n"], ""))
    SpawnNotAdmitted { node_id: _, refusal } =>
      serve_text_response(status: launch_refusal_http_status(r: refusal), content_type: text_plain_utf8, body: join(["assigned: ", node_id, " → ", principal_ref_label(p: assignee), " (event ", event_id, ")\nwaiting on fabric: ", launch_refusal_label(r: refusal), " — ", launch_refusal_reason(r: refusal), " — the assignment stands; the request joins the existing attempt when one is live\n"], ""))
  }
}

// THE COMMENT ROUTE (owner mandate 2026-09-25: comments are durable events; retries never
// duplicate): POST /issue/<id>/comment appends a CommentCreated to the SAME chained, fork-refusing
// log — the event-CLI idiom again (read, refuse on forked/incomplete, parent = the single head,
// probed clock, append through the carrier). The body ships enctype text/plain with the key line
// first and the body LAST (markdown freely carries newlines). The key is the client's idempotency
// token: already present, the request is a RETRY — 200 with the existing comment's deep link and
// NOTHING appended (control 7: retries never duplicate; this is the duplicate-append-refused
// arm). A composer that minted no key (the no-JS native form) still never duplicates a retry on
// an unchanged history: same author, same body, same head is the retry. Visibility is recorded
// ("public" this cut). The author is the AUTHENTICATED PRINCIPAL — the same write law as the
// assign route: Google OIDC session + action authorization + CSRF, with the event recording the
// session principal's stable label; tailnet transport alone refuses at the authentication axis.
// The expected_revision guard matches the assign route — 409 STALE on a moved head.
fn serve_issue_comment_response_over(
  instance: HostDashboardInstance,
  request: ServeHttpRequest<RequestAuthenticationEvidence>,
  params: List<PathParamBinding>,
) -> ServeHttpResponse {
  let node_id = path_param_value(params: params, name: "node_id")
  let plan = roadmap_authority_projection()
  if !issue_detail_node_exists(proj: plan, node_id: node_id) {
    serve_text_response(status: 404, content_type: text_plain_utf8, body: join(["issue not found: ", node_id, "\n"], ""))
  } else {
    let observed_at = match clock_now_probed_at() { Present { value: t } => t as String  Absent => "" }
    match human_write_admission(
      route_path: join(["/issue/", node_id, "/comment"], "") as NonEmptyStr,
      action: ServeActionCommentIssue,
      security: request.security,
      authorization_policy: tracker_write_authorization_policy,
      deployment_policy: roadmap_deployment_access_policy,
      csrf_presented: issue_form_field(body: request.body, name: "csrf"),
      observed_at: observed_at,
    ) {
      Deny { refusal } =>
        serve_text_response(status: 403, content_type: text_plain_utf8, body: concat("comment refused: ", access_refusal_reason(refusal: refusal)))
      Permit =>
        let author_principal = authenticated_write_author_principal(security: request.security)
        let body = issue_comment_body_of(wire: request.body)
        if trim(body) == "" {
          serve_text_response(status: 400, content_type: text_plain_utf8, body: "comment refused: the body is empty\n")
        } else {
          let layout = roadmap_event_carrier_layout_for_instance(instance: instance)
          let nid = node_id as NonEmptyStr as RoadmapNodeId
          match roadmap_events_read(layout: layout, node: nid) {
            EventsReadRefused { node: _, step, reason } =>
              serve_text_response(status: 503, content_type: text_plain_utf8, body: join(["comment refused: could not read the issue's history (", step, "): ", reason, "\n"], ""))
            EventsRead { node: _, envelopes } =>
              let standing = roadmap_node_standing(envs: envelopes)
              let key = roadmap_node_standing_key(s: standing)
              if key == "forked" || key == "history_incomplete" {
                serve_text_response(status: 409, content_type: text_plain_utf8, body: join(["comment refused: the issue's history is ", key, ": ", roadmap_node_standing_text(s: standing), "\n"], ""))
              } else {
                let heads = filter(envelopes, e => !any(envelopes, o => match o.event.parent { Present { value: p } => (p as String) == (e.id as String)  Absent => false }))
                let head_string = match heads.first() { Present { value: h } => h.id as String  Absent => "" }
                let expected_revision = issue_form_field(body: request.body, name: "expected_revision")
                if expected_revision != "" && expected_revision != head_string {
                  serve_text_response(status: 409, content_type: text_plain_utf8, body: join(["comment refused: the issue changed since the page rendered (expected revision ", expected_revision, ", head ", head_string, ") — reload and comment again\n"], ""))
                } else {
                  match author_principal {
                    Absent =>
                      serve_text_response(status: 403, content_type: text_plain_utf8, body: "comment refused: admitted write carried no author principal (unreachable past the write law)\n")
                    Present { value: author_ref } =>
                      let author_identity = EventPrincipalAuthenticated { ref: author_ref }
                      let key_field = trim(issue_form_field(body: request.body, name: "key"))
                      let comments = roadmap_issue_comments(envs: envelopes)
                      if key_field != "" && roadmap_comment_created_key_present(envs: envelopes, comment: key_field as NonEmptyStr) {
                        serve_comment_recorded_response(node_id: node_id, comments: comments, comment: key_field, event_id: "", already_present: true)
                      } else if key_field == "" && roadmap_comment_retry_present(envs: envelopes, author: author_identity, body: body as NonEmptyStr, head: match heads.first() { Present { value: h } => Present { value: h.id }  Absent => none }) {
                        serve_comment_recorded_response(node_id: node_id, comments: comments, comment: "", event_id: "", already_present: true)
                      } else {
                        let at = match clock_now_probed_at() { Present { value: t } => t as String  Absent => "" }
                        let comment_id = if key_field == "" { join([principal_ref_label(p: author_ref), ":", body], "") as NonEmptyStr } else { key_field as NonEmptyStr }
                        match roadmap_event_append(layout: layout, event: RoadmapEvent { node: nid, author: author_identity, parent: match heads.first() { Present { value: h } => Present { value: h.id }  Absent => none }, kind: CommentCreated { comment: comment_id, body: body as NonEmptyStr, visibility: "public" as NonEmptyStr, parent_comment: none }, recorded_at: at }) {
                          EventAppended { id } =>
                            serve_comment_recorded_response(node_id: node_id, comments: [IssueComment { ordinal: count(comments) + 1, comment: comment_id, author: author_identity, body: "", visibility: "public" as NonEmptyStr, parent_comment: none, created_at: "", edited_at: "", deleted: false }], comment: comment_id as String, event_id: id as String, already_present: false)
                          EventAlreadyPresent { id } =>
                            serve_comment_recorded_response(node_id: node_id, comments: comments, comment: comment_id as String, event_id: id as String, already_present: true)
                          EventAppendRefused { id: _, step, reason } =>
                            serve_text_response(status: 503, content_type: text_plain_utf8, body: join(["comment refused at ", step, ": ", reason, "\n"], ""))
                        }
                      }
                  }
                }
              }
          }
        }
    }
  }
}

// THE COMMENT RESPONSE, factored pure over the recorded comments so the witness drives it without
// a carrier: the deep link /issue/<id>#comment-N is the answer a retry and a first write share —
// the client re-anchors instead of re-posting.
fn serve_comment_recorded_response(node_id: String, comments: List<IssueComment>, comment: String, event_id: String, already_present: Bool) -> ServeHttpResponse {
  let ordinal = match (filter(comments, c => (c.comment as String) == comment)).first() {
    Present { value: c } => c.ordinal
    Absent => 0
  }
  let link = join(["/issue/", node_id, "#comment-", to_string(value: ordinal)], "")
  if already_present {
    serve_text_response(status: 200, content_type: text_plain_utf8, body: join(["comment recorded (already present): ", link, "\n"], ""))
  } else {
    serve_text_response(status: 200, content_type: text_plain_utf8, body: join(["comment recorded: ", link, " (event ", event_id, ")\n"], ""))
  }
}

// THE COMMENT BODY'S WIRE SHAPE: the form orders key first, body LAST, so the body may carry any
// character including newlines. The body is everything after the FIRST body= field opener —
// occurrences inside the markdown stay verbatim because the cut is at the first, never the last.
fn issue_comment_body_of(wire: String) -> String {
  if starts_with(s: wire, prefix: "body=") {
    substring(s: wire, start: 5, end: string_length(s: wire))
  } else {
    let parts = split(s: wire, delimiter: "\nbody=")
    if count(parts) == 1 {
      ""
    } else {
      match parts.first() {
        Present { value: before } => substring(s: wire, start: string_length(s: before) + 6, end: string_length(s: wire))
        Absent => ""
      }
    }
  }
}

fn serve_dispatch_handler_response(params: List<PathParamBinding>) -> ServeHttpResponse {
  serve_dispatch_handler_response_for_instance(
    instance: srv1_live_dashboard_instance(),
    params: params,
  )
}

fn dashboard_instance_json(instance: HostDashboardInstance) -> String {
  let plan = dashboard_instance_provision_plan_rows(instance: instance)
  serialize_json(v: json_object(members: [
    json_kv(key: "schema", value: json_string(s: dashboard_instance_health_schema)),
    json_kv(key: "instance_id", value: json_string(s: instance.instance_id as String)),
    json_kv(key: "host_identity", value: json_string(s: instance.host_identity as String)),
    json_kv(
      key: "actuation",
      value: json_string(s: dashboard_actuation_posture_label(posture: instance.actuation)),
    ),
    json_kv(key: "repo_root", value: json_string(s: instance.repo_root as String)),
    json_kv(
      key: "dispatch_worktree_root",
      value: json_string(s: dashboard_instance_dispatch_worktree_root(instance: instance) as String),
    ),
    json_kv(
      key: "dispatch_attempt_state_root",
      value: json_string(s: dashboard_instance_dispatch_attempt_state_root(instance: instance) as String),
    ),
    json_kv(key: "listen_port", value: json_int(n: instance.listen_port)),
    json_kv(key: "serve_function", value: json_string(s: instance.serve_function as String)),
    json_kv(key: "dispatch_base_ref", value: json_string(s: instance.dispatch_base_ref as String)),
    json_kv(
      key: "provision_transport",
      value: json_string(s: dashboard_provision_transport_label(
        transport: instance.provision_transport,
      )),
    ),
    json_kv(
      key: "desired_provision_plan",
      value: json_array(elements: plan |> map(row => json_object(members: [
        json_kv(key: "kind", value: json_string(s: row.kind as String)),
        json_kv(key: "target", value: json_string(s: row.target)),
        json_kv(key: "detail", value: json_string(s: row.detail)),
      ]))),
    ),
  ]))
}

// The /sandbox echo handler answers ANY wire arm on demand so every dispatch state is pressable
// without spawning a session (P4). It reads ?status=LABEL from the request path (uri_query_param —
// the query survives in request.path; match_path_template strips it only for routing) and maps it
// to the belt result exemplar via belt_dispatch_result_for_label, serializing the SAME
// belt_dispatch_result_json_value the real dispatch returns — so the sandbox JSON shape is
// identical to production, never a mock. Fail-closed: an unknown or missing status refuses with a
// 400 that names the valid label set, never a fabricated arm.

fn sandbox_echo_response(request: ServeHttpRequest<RequestAuthenticationEvidence>) -> ServeHttpResponse {
  let status = uri_query_param(path: request.path, key: "status")
  match belt_dispatch_result_for_label(wire_label: status) {
    Present { value: r } =>
      serve_text_response(
        status: 200,
        content_type: application_json_utf8,
        body: serialize_json(v: belt_spawn_outcome_json(o: r)),
      )
    Absent =>
      serve_text_response(
        status: 400,
        content_type: text_plain_utf8,
        body: join([
          "unknown status label: ", status,
          " (fail-closed; valid: ", join(belt_dispatch_all_status_labels(), ", "), ")\n",
        ], ""),
      )
  }
}

// Every handler receives the FULL modeled ServeHttpRequest (review 40314: the request body was
// formerly accepted at the seam and dropped before invoke, so a body-reading POST handler would
// have silently seen the empty string — a latent widen).

// THE PLAN TRAVELS WITH THE REQUEST, exactly as the instance already does. Which plan a process
// serves is fixed by its serve entry function -- `gunbc serve` binds --entry/--function and carries
// no per-request argument -- so an entry declared elsewhere supplies its own projected plan by
// CALLING this fold, and nothing here enumerates or registers callers. The handlers that consult a
// roadmap read the parameter instead of the public carrier, so one response cannot mix two plans.
//
// WHICH HANDLERS IGNORE IT, AND THE ONE THAT ONLY LOOKS LIKE IT DOES. Assets, the sandbox echo and
// the approval routes consult no roadmap at all. The sessions, attempts, workflow and observation
// surfaces read bodies the belt tick already wrote, and none of them is a roadmap render.
//
// RoadmapDailyPageHandler IS a roadmap render and must not be filed with them (review 63341, which
// caught this note grouping it there). Its plan is bound EARLIER, at the tick that rendered the
// body, by gunbc.roadmap_served_observation served_observation_observe_and_write_over -- so the
// daily page is parameterized, on the other entry. The consequence a caller has to know: supplying
// a plan HERE does not reach `/`. A process serving its own plan must supply it at BOTH entries,
// the serve entry and the tick entry; supply it at only this one and `/` answers from whatever plan
// the tick that wrote the body was given, with no refusal, because a pre-rendered body carries no
// record of the plan it came from. That is a real seam between two processes, not a gap inside this
// fold, and it is stated rather than papered over: nothing here can detect the mismatch.
fn roadmap_serve_invoke_over(
  instance: HostDashboardInstance,
  plan: RoadmapAuthorityProjection,
  daily_body: ServedDailyBodyAuthority,
  handler: RoadmapServeHandler,
  params: List<PathParamBinding>,
  request: ServeHttpRequest<RequestAuthenticationEvidence>,
  release_revision: CommitSha,
) -> ServeHttpResponse {
  match handler {
    RoadmapDailyPageHandler =>
      match daily_body {
        DailyBodyRenderedUnderThisPlan => serve_daily_page_response_for_instance(instance: instance)
        DailyBodyAuthorityUnknown =>
          serve_text_response(
            status: 503,
            content_type: text_plain_utf8,
            body: join([
              "the daily workspace is served from a body this process did not render: the belt tick ",
              "wrote it under the plan THAT process held, and a stored body carries no identity of ",
              "the authority it came from, so agreement with the plan this entry was given cannot ",
              "be decided here. Refusing rather than answering from an unknown authority ",
              "(gunbc.recurring_failure_mode.a_prerendered_body_carries_no_identity_of_its_source). ",
              "Bind the same plan at the tick entry, gunbc.roadmap_served_observation ",
              "served_observation_observe_and_write_over, and declare it with ",
              "DailyBodyRenderedUnderThisPlan.\n",
            ], ""),
          )
      }
    RoadmapFullPageHandler =>
      serve_page_response(page: roadmap_page_for_projection_launch(
        proj: plan,
        launch: belt_launch_host_standing_for_page_over(instance: instance, plan: plan),
      ))
    FleetStandingPageHandler => serve_page_response(page: roadmap_fleet_page())
    RoadmapMdHandler => serve_text_response(status: 200, content_type: text_plain_utf8, body: roadmap_site_roadmap_md_body_over(plan: plan))
    DispatchJsonHandler => serve_text_response(status: 200, content_type: application_json_utf8, body: roadmap_site_dispatch_json_body_over(plan: plan))
    HealthzHandler => serve_text_response(status: 200, content_type: application_json_utf8, body: roadmap_site_healthz_body_for_release(release_revision: release_revision))
    DashboardInstanceHandler =>
      serve_text_response(
        status: 200,
        content_type: application_json_utf8,
        body: dashboard_instance_json(instance: instance),
      )
    ProviderReadinessHandler =>
      serve_text_response(
        status: 200,
        content_type: application_json_utf8,
        body: dashboard_provider_readiness_json(instance: instance),
      )
    BeltDispatchHandler =>
      serve_dispatch_handler_response_over(instance: instance, plan: plan, params: params)
    DispatchAssetHandler => serve_text_response(status: 200, content_type: text_javascript_utf8, body: dispatch_client_js_source())
    SandboxPageHandler => serve_page_response(page: sandbox_page())
    InstrumentSandboxPageHandler => serve_page_response(page: instrument_sandbox_page())
    InstrumentTunerPageHandler => serve_page_response(page: instrument_tuner_page())
    InstrumentTunerAssetHandler => serve_text_response(status: 200, content_type: text_javascript_utf8, body: instrument_tuner_client_js_source())
    InstrumentMotionPageHandler => serve_page_response(page: instrument_motion_page())
    InstrumentMotionAssetHandler => serve_text_response(status: 200, content_type: text_javascript_utf8, body: instrument_motion_client_js_source())
    RepoAtlasPageHandler => serve_page_response(page: repo_atlas_page())
    SandboxAssetHandler => serve_text_response(status: 200, content_type: text_javascript_utf8, body: sandbox_client_js_source())
    ApprovalConfirmPageHandler => approval_confirm_page_response(request: request, params: params)
    ApprovalDecideHandler => approval_decide_response(request: request, params: params)
    ApprovalSubmitHandler => approval_submit_response(request: request)
    ApprovalStatusHandler => approval_status_response(params: params)
    SandboxEchoHandler => sandbox_echo_response(request: request)
    IssueDetailPageHandler => serve_issue_detail_response_over(instance: instance, plan: plan, params: params, request: request)
    IssueAssignHandler => serve_issue_assign_response_over(instance: instance, plan: plan, request: request, params: params)
    IssueCommentHandler => serve_issue_comment_response_over(instance: instance, request: request, params: params)
    SessionsJsonHandler => serve_sessions_response_for_instance(instance: instance)
    AttemptsJsonHandler => serve_attempts_response_for_instance(instance: instance)
    WorkflowJsonHandler => serve_workflow_response_for_instance(instance: instance)
    ObservationJsonHandler => served_observation_standing_response_for_instance(instance: instance)
    BeltStopHandler => serve_stop_handler_response_for_instance(instance: instance, params: params)
    BeltPublishHandler => serve_publish_handler_response_for_instance(instance: instance, params: params)
  }
}

fn roadmap_serve_invoke_for_instance(
  instance: HostDashboardInstance,
  handler: RoadmapServeHandler,
  params: List<PathParamBinding>,
  request: ServeHttpRequest<RequestAuthenticationEvidence>,
  release_revision: CommitSha,
) -> ServeHttpResponse {
  roadmap_serve_invoke_over(
    instance: instance,
    plan: roadmap_authority_projection(),
    daily_body: DailyBodyRenderedUnderThisPlan,
    handler: handler,
    params: params,
    request: request,
    release_revision: release_revision,
  )
}

fn roadmap_serve_invoke(
  handler: RoadmapServeHandler,
  params: List<PathParamBinding>,
  request: ServeHttpRequest<RequestAuthenticationEvidence>,
  release_revision: CommitSha,
) -> ServeHttpResponse {
  roadmap_serve_invoke_for_instance(
    instance: srv1_live_dashboard_instance(),
    handler: handler,
    params: params,
    request: request,
    release_revision: release_revision,
  )
}

fn serve_stop_handler_response_for_instance(
  instance: HostDashboardInstance,
  params: List<PathParamBinding>,
) -> ServeHttpResponse {
  let node_id = path_param_value(params: params, name: "node_id")
  if node_id == "" {
    serve_text_response(
      status: 400,
      content_type: text_plain_utf8,
      body: "cleanup requires a node id path segment (fail-closed; empty binding is unreachable by construction)\n",
    )
  } else {
    let r = belt_stop_node_for_instance(instance: instance, node_id: node_id)
    serve_text_response(
      status: belt_stop_http_status(r: r),
      content_type: application_json_utf8,
      body: serialize_json(v: belt_stop_result_json_value(r: r)))
  }
}

fn serve_stop_handler_response(params: List<PathParamBinding>) -> ServeHttpResponse {
  serve_stop_handler_response_for_instance(
    instance: srv1_live_dashboard_instance(),
    params: params,
  )
}

fn serve_attempts_response_for_instance(
  instance: HostDashboardInstance,
) -> ServeHttpResponse {
  served_observation_surface_response_for_instance(instance: instance, kind: AttemptsJson)
}

fn serve_attempts_response() -> ServeHttpResponse {
  serve_attempts_response_for_instance(instance: srv1_live_dashboard_instance())
}

// GET /workflow.json is the evidence-derived attempt pipeline. One observation joins current
// modeled state, a bounded jq projection of complete Codex attempt evidence, retained process exit,
// and the node's declared validation contract. The exact projector executable is an ensured
// platform capability. It validates each raw JSON value while omitting unbounded command payloads
// from the synchronous interpreted handler; projector absence or malformed input remains an
// explicit per-attempt refusal. The observed facts reconcile by fold against the shared desired
// obligation roster and expose desired/observed/remaining counts plus distinct observed-failure,
// observed-refusal, and unsafe-plan-refusal counts; they never upgrade provider completion into
// verification, publication, review, or goal audit. A refused attempts ledger returns 503;
// per-attempt event/process refusals remain explicit segment states in a 200 body so one damaged
// attempt cannot erase evidence from every other row.

// The daily page consumes the SAME attempt observation the /workflow.json wire serves (one
// observing authority, two projections): an observed ledger renders real activity regions and the
// active band; a refused ledger renders the page with the ONE workspace observation banner carrying
// the located reason — the page itself stays a 200 because the roadmap authority rendered fine;
// what failed is the activity channel, and that failure is narrated once, in place, exactly as the
// client would narrate it on a later poll.

// HOST-BOUNDARY AMPLIFIER REPAIR (PR #8087, operator ruling 2026-08-10): v1_interpreter
// dispatch_shell drains child stdout/stderr concurrently while the child runs. Bounded the stderr
// buffer+clone amplifier on the shell success path — stderr retains bounded tail (16 KiB) with
// total_bytes, truncated, and FNV digest_hex surfaced via CapturedStreamEvidence /
// map_shell_outputs from_key fields; stdout complete-within 8 MiB or typed ShellOutputLimitExceeded
// refusal (never a silent prefix). TWO WEDGES, TWO ATTEMPTS — this note originally attributed the
// 59.5 MB figure to the profiled recurrence, which was wrong: attempt-state holds several attempts
// per node and only the -current one is projected (the gate is
// <instance_root>/attempt-state/<node>-current/attempt-key), and for node
// v2-emitter-direct-rust-door that key's mtime is 2026-08-09 17:52:15, 8m41s BEFORE the 18:00:56
// wedge, naming 677905e3704d70a3. So the 2026-08-08 wedge selected ...-acc0923494fc8b9cb
// (60,257,673 B raw / 831 lines / 308 non-JSON / jq stdout 30,770 B / jq stderr 59,522,411 B) while
// the profiled 2026-08-09 recurrence selected ...-a677905e3704d70a3 (20,511,073 B raw / 355 lines /
// 101 non-JSON / jq stdout 15,034 B / jq stderr 18,421,072 B). Both exit 0, so both take the ExecOk
// arm where map_shell_outputs clones stderr into a Value::Str — the repair is correct for both, and
// 59,522,411 B remains the witness's legitimate worst-observed STRESS SPECIMEN rather than the
// recurrence's fixture. INCIDENT NOT CLOSED: wedge was finite/self-recovered; wedged route unproven
// — and the two candidate routes are NOT rival cost centers, because
// serve_daily_page_response_for_instance and serve_workflow_response_for_instance both served (then) by calling
// belt_workflow_attempts_observe_for_instance per request (one observing authority, two projections; since the
// served-observation split, gunbc.roadmap_served_observation calls it once per belt tick instead), so they
// share the projection cost and differ only in that the daily page adds the render;
// interpreter-concat hypothesis live and may be primary; share of two-hour peg versus queued
// duplicate polls unmeasured, and the share attributable to stream capture is unestablished in BOTH
// directions (an arithmetic argument that 18.4 MB is too small to explain the peg assumed a fixed
// two copies, which the profile does not support — Value::clone/String::clone sat inside the
// repeating evaluator path, so the multiplier is per-iteration and unmeasured). FIXTURE PROVENANCE:
// the pointer proves which ATTEMPT was selected at onset, not that the retained file is
// byte-identical to what the wedged request read — that attempt was in flight (events mtime
// 18:35:37, i.e. during the 18:00:56-to-~19:52 wedge), so the file grew while the route was polled
// and was smaller at onset; the artifact is the retained final state of the attempt selected at
// wedge onset, never the exact historical request input. Witness:
// bounded_shell_stream_capture_replay. Dissolve-on: emit-on-demand native serve and shared
// CapturedProcessStream carrier subsume this seed-only drain.

fn serve_daily_page_response_for_instance(
  instance: HostDashboardInstance,
) -> ServeHttpResponse {
  served_observation_surface_response_for_instance(instance: instance, kind: DailyPage)
}

fn serve_workflow_response_for_instance(
  instance: HostDashboardInstance,
) -> ServeHttpResponse {
  served_observation_surface_response_for_instance(instance: instance, kind: WorkflowJson)
}

fn serve_workflow_response() -> ServeHttpResponse {
  serve_workflow_response_for_instance(instance: srv1_live_dashboard_instance())
}

// GET /sessions.json performs one session-container observation and one independently adjudicated
// pane/process observation. Session-list refusal serves 503 because container presence is
// unknowable. Pane refusal stays in each known session as process unobserved and cleanup
// unavailable; it cannot erase session presence. The same combined observation feeds both status
// and body so the route never races two reads.

fn serve_sessions_response_for_instance(
  instance: HostDashboardInstance,
) -> ServeHttpResponse {
  served_observation_surface_response_for_instance(instance: instance, kind: SessionsJson)
}

fn serve_sessions_response() -> ServeHttpResponse {
  serve_sessions_response_for_instance(instance: srv1_live_dashboard_instance())
}

fn http_method_label_join(methods: List<HttpMethod>) -> String {
  join(map(methods, m => match m {
    GET => "GET"
    POST => "POST"
    PUT => "PUT"
    PATCH => "PATCH"
    DELETE => "DELETE"
    HEAD => "HEAD"
    OPTIONS => "OPTIONS"
  }), ", ")
}

fn roadmap_serve_selection_response_over(
  instance: HostDashboardInstance,
  plan: RoadmapAuthorityProjection,
  daily_body: ServedDailyBodyAuthority,
  sel: RouteSelection<RoadmapServeHandler>,
  request: ServeHttpRequest<RequestAuthenticationEvidence>,
  release_revision: CommitSha,
) -> ServeHttpResponse {
  match sel {
    SelectedDynamic { handler: h, params: ps } =>
      roadmap_serve_invoke_over(
        instance: instance,
        plan: plan,
        daily_body: daily_body,
        handler: h,
        params: ps,
        request: request,
        release_revision: release_revision,
      )
    SelectedStatic { route: r } =>
      ServeHttpResponse { status: r.status_on_hit, content_type: r.content_type, body: r.body }
    MethodNotAllowed { allowed: ms } =>
      serve_text_response(
        status: 405,
        content_type: text_plain_utf8,
        body: join(["method not allowed; allowed: ", http_method_label_join(methods: ms), "\n"], ""),
      )
    NoRouteMatched =>
      serve_text_response(status: 404, content_type: text_plain_utf8, body: "not found\n")
  }
}

fn roadmap_serve_selection_response_for_instance(
  instance: HostDashboardInstance,
  sel: RouteSelection<RoadmapServeHandler>,
  request: ServeHttpRequest<RequestAuthenticationEvidence>,
  release_revision: CommitSha,
) -> ServeHttpResponse {
  roadmap_serve_selection_response_over(
    instance: instance,
    plan: roadmap_authority_projection(),
    daily_body: DailyBodyRenderedUnderThisPlan,
    sel: sel,
    request: request,
    release_revision: release_revision,
  )
}

fn roadmap_serve_selection_response(
  sel: RouteSelection<RoadmapServeHandler>,
  request: ServeHttpRequest<RequestAuthenticationEvidence>,
  release_revision: CommitSha,
) -> ServeHttpResponse {
  roadmap_serve_selection_response_for_instance(
    instance: srv1_live_dashboard_instance(),
    sel: sel,
    request: request,
    release_revision: release_revision,
  )
}

// THE REQUEST-SECURITY CONTEXT, built at the one seam every route shares. The access path is
// modeled from the instance bind and the tailnet header through the ACL and serve-route
// authorities (a header alone mints no tailnet path — the readback does). The authentication
// evidence is AuthAbsent at this seam because the serve runtime does not yet hand a session
// standing across the socket seam (frontier: the session-cookie channel lands with the serve
// runtime's security wiring) — so until then every write route refuses at the authentication
// axis of gunbc.auth.request_authentication.human_write_admission, loudly, by construction, and
// no request is authenticated by tailnet transport.
fn roadmap_serve_request_security(
  instance: HostDashboardInstance,
  tailscale_identity: String,
) -> RequestSecurityContext<RequestAuthenticationEvidence> {
  RequestSecurityContext {
    access_path: request_access_path_of(
      listen_host: instance.listen_host,
      tailscale_header: tailscale_identity,
      serve_status: ServeStatusUnreadable,
      serve_route: none,
      acl_policy: operator_tailscale_acl_policy,
    ),
    authentication: AuthAbsent,
  }
}

fn roadmap_serve_respond_over(
  instance: HostDashboardInstance,
  plan: RoadmapAuthorityProjection,
  daily_body: ServedDailyBodyAuthority,
  method_label: String,
  path: String,
  body: String,
  tailscale_identity: String,
  release_revision: CommitSha,
) -> ServeHttpResponse {
  match parse_http_method_label(label: method_label) {
    UnknownMethod { label: l } =>
      serve_text_response(
        status: 501,
        content_type: text_plain_utf8,
        body: join(["unrecognized method: ", l, "\n"], ""),
      )
    KnownMethod { method: m } =>
      match roadmap_serve_route_table_build() {
        RoadmapServeTableRefused { raw: r, segment: s, reason: why } =>
          serve_text_response(
            status: 500,
            content_type: text_plain_utf8,
            body: join([
              "route table refused: malformed route literal raw=", r,
              " segment=", s,
              " reason=", why,
              " (fail-closed — fix the literal in gunbc.roadmap_serve.roadmap_serve_route_specs)\n",
            ], ""),
          )
        RoadmapServeTable { table: t } =>
          roadmap_serve_selection_response_over(
            instance: instance,
            plan: plan,
            daily_body: daily_body,
            sel: serve_select_route(table: t, method: m, path: path),
            request: ServeHttpRequest {
              method: m,
              path: path,
              body: body,
              security: roadmap_serve_request_security(
                instance: instance,
                tailscale_identity: tailscale_identity,
              ),
            },
            release_revision: release_revision,
          )
      }
  }
}

fn roadmap_serve_respond_for_instance(
  instance: HostDashboardInstance,
  method_label: String,
  path: String,
  body: String,
  tailscale_identity: String,
  release_revision: CommitSha,
) -> ServeHttpResponse {
  roadmap_serve_respond_over(
    instance: instance,
    plan: roadmap_authority_projection(),
    daily_body: DailyBodyRenderedUnderThisPlan,
    method_label: method_label,
    path: path,
    body: body,
    tailscale_identity: tailscale_identity,
    release_revision: release_revision,
  )
}

fn roadmap_serve_respond(
  method_label: String,
  path: String,
  body: String,
  tailscale_identity: String,
  release_revision: CommitSha,
) -> ServeHttpResponse {
  roadmap_serve_respond_for_instance(
    instance: srv1_live_dashboard_instance(),
    method_label: method_label,
    path: path,
    body: body,
    tailscale_identity: tailscale_identity,
    release_revision: release_revision,
  )
}

// THE TAILSCALE_HEADER ARGUMENT — the raw Tailscale-User-Login string — and why it still arrives
// as one named value rather than a header bag.
//
// `tailscale serve` authenticates the tailnet device and user before proxying, and injects the
// resulting login. UNDER THE 2026-09-25 RULING THAT LOGIN IS TRANSPORT METADATA, never
// application identity: it is one INPUT to the access-path modeling (which vouches for it only
// behind a serve-status readback and the ACL revision), and the request-security context carries
// it strictly separate from the authentication evidence. A signed capability establishes WHAT
// is being decided; the Google OIDC session establishes WHO is deciding; the tailnet
// observation, where attributed, is the audit trail the consent record may name.
//
// It is threaded through the entry rather than read at the handler because there is exactly one
// entry, and a fact every route may need to consult belongs on the request that reaches them all.
// Handlers that do not need it ignore it; the write routes consult the write law, which refuses
// on the authentication axis until a Google session arrives at the seam.
//
// THE PLAN AUTHORITY IS THE PARAMETER, AND A SERVE ENTRY IS THE WHOLE INTEGRATION.
//
// Instance selection is already by serve entry function, because `gunbc serve` binds --entry and
// --function once for the process's life and carries no per-request argument. The plan a process
// serves is the same KIND of fact -- fixed at launch, constant for every request -- so it arrives
// the same way: an entry function declared in whatever module owns that plan calls this fold with
// its own projection.
//
// What is passed is the PROJECTED PLAN, not a path or a source root. A plan that failed to project
// arrives as RoadmapAuthorityProjectionRefused and every consumer below refuses in its own
// vocabulary; handing over a location instead would have made an unreadable plan indistinguishable
// from an empty one at the surfaces that render it.
//
// It is deliberately NOT a registry. Nothing here enumerates plans, and no table is filled in from
// elsewhere: the direction of the dependency is that the caller reaches this fold, so this module
// stays unaware of who calls it and needs no edit when another one does.
fn roadmap_serve_handle_over(
  instance: HostDashboardInstance,
  plan: RoadmapAuthorityProjection,
  daily_body: ServedDailyBodyAuthority,
  method: String,
  path: String,
  body: String,
  tailscale_identity: String,
  release_revision: CommitSha,
) -> ServeWireResponse {
  serve_wire_response(r: roadmap_serve_respond_over(
    instance: instance,
    plan: plan,
    daily_body: daily_body,
    method_label: method,
    path: path,
    body: body,
    tailscale_identity: tailscale_identity,
    release_revision: release_revision,
  ))
}

fn roadmap_serve_handle(
  method: String,
  path: String,
  body: String,
  tailscale_identity: String,
  release_revision: CommitSha,
) -> ServeWireResponse {
  roadmap_serve_handle_over(
    instance: srv1_live_dashboard_instance(),
    plan: roadmap_authority_projection(),
    daily_body: DailyBodyRenderedUnderThisPlan,
    method: method,
    path: path,
    body: body,
    tailscale_identity: tailscale_identity,
    release_revision: release_revision,
  )
}

// THE OPERATOR MACBOOK'S ENTRY. Instance selection is by serve entry function. That is a
// constraint of `gunbc serve`, not a dual: the Serve verb binds method/path/body from the socket
// and has no `--arg` (handle_serve; Serve flags are function/host/port/release-revision only).
// `gunbc run --arg name=value` exists for ProcessExit entries and does not apply here. Observing
// the repo root at request time would make the served identity depend on where the binary happened
// to be launched, which is an ambient fact, and it would re-answer per request a question that is
// fixed for a process's whole life.
fn roadmap_serve_handle_macbook_local(
  method: String,
  path: String,
  body: String,
  tailscale_identity: String,
  release_revision: CommitSha,
) -> ServeWireResponse {
  roadmap_serve_handle_over(
    instance: macbook_local_dashboard_instance(),
    plan: roadmap_authority_projection(),
    daily_body: DailyBodyRenderedUnderThisPlan,
    method: method,
    path: path,
    body: body,
    tailscale_identity: tailscale_identity,
    release_revision: release_revision,
  )
}

