// ── GET /auth/session ──────────────────────────────────────────────────────────────────────────
// THE SESSION READ: the standing the seam decoded, rendered as JSON — the authenticated
// principal's label and expiry for a live session, the invalid standing's reason for anything
// else, anonymous for absence. THE PROFILE rides the wire as OPTIONAL MEMBERS: the picture is
// emitted only when the seated session's login projected one (the verified ID token's picture
// claim, stored at login and re-read from the session file), so the client renders the Google
// PFP when present and the initials fallback when absent; the name is the same shape (the
// verified token's name claim), so the header greets the operator's display name and falls
// back to the principal label's short form. Both are presentation only, never an input to
// identity or authorization, and a read renders; it never decides.
fn auth_session_response(request: ServeHttpRequest<RequestAccessPath, RequestAuthenticationEvidence>) -> ServeHttpResponse {
  serve_text_response(
    status: 200,
    content_type: application_json_utf8,
    body: auth_session_body(evidence: request.security.authentication),
  )
}

// THE SESSION STANDING READS THE DURABLE PROJECTION (Cut B): the header displays the profile the
// projection carries, not a freshly parsed session wire, so merge-retained members cannot be
// silently reverted by a login that omitted a claim. The session stays the identity authority;
// the projection is the display authority; a member the projection does not hold falls back to
// the session's. The roster's degradation standing (unreadable store, skipped records) is
// reported as data -- a missing-looking avatar must not read as 'nobody published'.
fn auth_session_response_over(instance: HostDashboardInstance, request: ServeHttpRequest<RequestAccessPath, RequestAuthenticationEvidence>) -> ServeHttpResponse {
  let roster = profile_store_read_all(layout: profile_store_layout_for_instance(instance: instance))
  serve_text_response(
    status: 200,
    content_type: application_json_utf8,
    body: auth_session_body_over(roster: roster, evidence: request.security.authentication),
  )
}

fn auth_session_roster_standing_members(roster: ProfileStoreReadAll) -> List<JsonKeyValue> {
  let unreadable = [ json_kv(key: "profile_standing", value: json_string(s: "profile store unread; session profile only")) ]
  let partial = [ json_kv(key: "profile_standing", value: json_string(s: "one or more profile records unreadable; the affected members render their fallback")) ]
  match roster {
    ProfileStoreUnread { step: _, reason: _ } => unreadable
    ProfileStoreRead { profiles: _, skipped } =>
      if count(skipped) == 0 {
        []
      } else {
        partial
      }
  }
}

fn auth_session_body_over(roster: ProfileStoreReadAll, evidence: RequestAuthenticationEvidence) -> String {
  serialize_json(v: json_object(members: match evidence {
    GoogleOidcSession { session } => {
      let found = match roster {
        ProfileStoreRead { profiles, skipped: _ } =>
          filter(profiles, p => principal_ref_eq(a: p.principal, b: session.principal)).first()
        ProfileStoreUnread { step: _, reason: _ } => none
      }
      let name = match found {
        Present { value: stored } => match stored.name {
          Present { value: n } => Present { value: n }
          Absent => session.profile.name
        }
        Absent => session.profile.name
      }
      let email = match found {
        Present { value: stored } => match stored.email {
          Present { value: e } => Present { value: e }
          Absent => session.profile.email
        }
        Absent => session.profile.email
      }
      let picture = match found {
        Present { value: stored } => match stored.picture {
          Present { value: u } => Present { value: u }
          Absent => session.profile.picture
        }
        Absent => session.profile.picture
      }
      concat([
        json_kv(key: "authenticated", value: json_bool(b: true)),
        json_kv(key: "principal", value: json_string(s: principal_ref_label(p: session.principal))),
        json_kv(key: "expires_at", value: json_string(s: session.expires_at)),
        json_kv(key: "viewer", value: json_string(s: authenticated_viewer_label(evidence: evidence))),
      ], concat(auth_session_picture_members(picture: picture), concat(auth_session_name_members(name: name), concat(auth_session_email_members(email: email), auth_session_roster_standing_members(roster: roster)))))
    }
    SessionStandingInvalid { standing } => [
      json_kv(key: "authenticated", value: json_bool(b: false)),
      json_kv(key: "standing", value: json_string(s: session_cookie_standing_reason(standing: standing))),
      json_kv(key: "viewer", value: json_string(s: "")),
    ]
    FabricServiceEvidence { kind: _, authenticated_at: _ } => [
      json_kv(key: "authenticated", value: json_bool(b: false)),
      json_kv(key: "standing", value: json_string(s: "service evidence is not a human session")),
      json_kv(key: "viewer", value: json_string(s: authenticated_viewer_label(evidence: evidence))),
    ]
    AuthAbsent => [
      json_kv(key: "authenticated", value: json_bool(b: false)),
      json_kv(key: "standing", value: json_string(s: session_cookie_standing_reason(standing: SessionCookieAbsent))),
      json_kv(key: "viewer", value: json_string(s: "")),
    ]
  }))
}

// THE OPTIONAL PICTURE MEMBER of the session wire: present only when the session's profile
// projected one — absence is the member's ABSENCE, never an empty string standing in for none,
// and the client reads absence (like a failed fetch) as the initials fallback, never an
// identity claim from a hole in the wire.
fn auth_session_picture_members(picture: Uri?) -> List<JsonKeyValue> {
  match picture {
    Present { value: u } => [ json_kv(key: "picture", value: json_string(s: uri_wire(uri: u) as String)) ]
    Absent => []
  }
}

// THE OPTIONAL NAME MEMBER, the same law as the picture: absence is the member's ABSENCE,
// never an empty string standing in for none.
fn auth_session_name_members(name: String?) -> List<JsonKeyValue> {
  match name {
    Present { value: n } => [ json_kv(key: "name", value: json_string(s: n)) ]
    Absent => []
  }
}

// THE OPTIONAL EMAIL MEMBER, the same law as the name: absence is the member's ABSENCE.
fn auth_session_email_members(email: Email?) -> List<JsonKeyValue> {
  match email {
    Present { value: e } => [ json_kv(key: "email", value: json_string(s: e as String)) ]
    Absent => []
  }
}

fn auth_session_body(evidence: RequestAuthenticationEvidence) -> String {
  serialize_json(v: json_object(members: match evidence {
    GoogleOidcSession { session } => concat([
      json_kv(key: "authenticated", value: json_bool(b: true)),
      json_kv(key: "principal", value: json_string(s: principal_ref_label(p: session.principal))),
      json_kv(key: "expires_at", value: json_string(s: session.expires_at)),
      json_kv(key: "viewer", value: json_string(s: authenticated_viewer_label(evidence: evidence))),
    ], concat(auth_session_picture_members(picture: session.profile.picture), concat(auth_session_name_members(name: session.profile.name), auth_session_email_members(email: session.profile.email))))
    SessionStandingInvalid { standing } => [
      json_kv(key: "authenticated", value: json_bool(b: false)),
      json_kv(key: "standing", value: json_string(s: session_cookie_standing_reason(standing: standing))),
      json_kv(key: "viewer", value: json_string(s: "")),
    ]
    FabricServiceEvidence { kind: _, authenticated_at: _ } => [
      json_kv(key: "authenticated", value: json_bool(b: false)),
      json_kv(key: "standing", value: json_string(s: "service evidence is not a human session")),
      json_kv(key: "viewer", value: json_string(s: authenticated_viewer_label(evidence: evidence))),
    ]
    AuthAbsent => [
      json_kv(key: "authenticated", value: json_bool(b: false)),
      json_kv(key: "standing", value: json_string(s: session_cookie_standing_reason(standing: SessionCookieAbsent))),
      json_kv(key: "viewer", value: json_string(s: "")),
    ]
  }))
}

// Session-dependent HTML; its no-store header moved to the OAuth follow-up with the response-header channel.
fn allocation_page_response(request: ServeHttpRequest<RequestAccessPath, RequestAuthenticationEvidence>) -> ServeHttpResponse {
  allocation_page_response_over(request: request, roadmap_stylesheet: roadmap_styles())
}

// The response over a supplied roadmap stylesheet: the session and header decisions do not read the
// stylesheet, so a claim about them supplies it (gunbc.roadmap_allocation_page
// allocation_page_with_stylesheet).
fn allocation_page_response_over(request: ServeHttpRequest<RequestAccessPath, RequestAuthenticationEvidence>, roadmap_stylesheet: SiteStyles) -> ServeHttpResponse {
  let viewer = match request.security.authentication {
    GoogleOidcSession { session } => AllocationViewerSignedIn { csrf: session.csrf.token as String }
    AuthAbsent => AllocationViewerSignedOut
    SessionStandingInvalid { standing: _ } => AllocationViewerSignedOut
    FabricServiceEvidence { kind: _, authenticated_at: _ } => AllocationViewerSignedOut
  }
  match try_serialize_html_source(node: allocation_page_with_stylesheet(viewer: viewer, roadmap_stylesheet: roadmap_stylesheet)) {
    EmitOk { html } => serve_text_response(status: 200, content_type: text_html_utf8, body: html)
    EmitRejected { reason } => serve_text_response(status: 500, content_type: text_plain_utf8, body: page_render_refusal_body(reason: reason))
  }
}

// Preferences are owned by the seated account, independent of the session id. Neither route
// accepts a principal selector. No-store prevents account/CSRF context entering shared caches.
fn issue_view_response(status: HttpStatus, body: String) -> ServeHttpResponse {
  ServeHttpResponse { status: status, content_type: application_json_utf8, body: body, headers: [ServeResponseHeaderNoStore] }
}
fn serve_issue_view_preferences_over(instance: HostDashboardInstance, request: ServeHttpRequest<RequestAccessPath, RequestAuthenticationEvidence>, saving: Bool) -> ServeHttpResponse {
  match request.security.authentication {
    GoogleOidcSession { session } => {
      if saving {
        match human_write_admission(route_path: "/preferences/issues", action: ServeActionSaveOwnView, security: request.security, authorization_policy: tracker_write_authorization_policy, deployment_policy: roadmap_deployment_access_policy, csrf_presented: issue_form_field(body: request.body, name: "csrf"), observed_at: human_write_observed_at(security: request.security)) {
          Deny { refusal: _ } => issue_view_response(status: 403, body: "Preference save requires a valid session and CSRF proof.")
          Permit => match issue_view_preferences_of(text: issue_form_field(body: request.body, name: "preferences")) {
            Absent => issue_view_response(status: 400, body: "Invalid issue view preferences.")
            Present { value: prefs } => match issue_view_store_key(principal: session.principal) {
              Absent => issue_view_response(status: 503, body: "Account preferences unavailable.")
              Present { value: key } => match issue_view_store_save(root: issue_view_store_root(instance: instance), key: key, prefs: prefs, revision: issue_form_field(body: request.body, name: "revision")) {
                IssueViewSaveOk { revision } => issue_view_response(status: 200, body: serialize_json(v: json_object(members: [json_kv(key: "revision", value: json_int(n: revision))])))
                IssueViewSaveConflict => issue_view_response(status: 409, body: "Preferences changed in another tab or browser. Reload to sync.")
                IssueViewSaveRefused => issue_view_response(status: 503, body: "Account preferences could not be saved.")
              }
            }
          }
        }
      } else {
        match issue_view_store_key(principal: session.principal) {
          Absent => issue_view_response(status: 503, body: "Account preferences unavailable.")
          Present { value: key } => match issue_view_store_read(root: issue_view_store_root(instance: instance), key: key) {
            IssueViewUnread => issue_view_response(status: 503, body: "Account preferences could not be read.")
            IssueViewAbsent => issue_view_response(status: 200, body: serialize_json(v: json_object(members: [
              json_kv(key: "revision", value: json_int(n: 0)), json_kv(key: "csrf", value: json_string(s: session.csrf.token as String)), json_kv(key: "preferences", value: JsonNull),
            ])))
            IssueViewFound { prefs, revision, expected: _ } => issue_view_response(status: 200, body: serialize_json(v: json_object(members: [
              json_kv(key: "revision", value: json_int(n: revision)), json_kv(key: "csrf", value: json_string(s: session.csrf.token as String)), json_kv(key: "preferences", value: issue_view_preferences_json(prefs: prefs)),
            ])))
          }
        }
      }
    }
    AuthAbsent => issue_view_response(status: 401, body: "Sign in for account preferences.")
    SessionStandingInvalid { standing: _ } => issue_view_response(status: 401, body: "Sign in for account preferences.")
    FabricServiceEvidence { kind: _, authenticated_at: _ } => issue_view_response(status: 403, body: "Human account preferences required.")
  }
}

// Read-only query: validated view terms select from the complete, digest-checked observation.
// Filtering and stable multi-column ordering happen before the fixed-size page is selected.
fn serve_issue_query(instance: HostDashboardInstance, request: ServeHttpRequest<RequestAccessPath, RequestAuthenticationEvidence>) -> ServeHttpResponse {
  match issue_view_preferences_of(text: issue_form_field(body: request.body, name: "preferences")) {
    Absent => issue_view_response(status: 400, body: "Invalid issue query.")
    Present { value: prefs } => match parse_int(s: issue_form_field(body: request.body, name: "offset")) {
      Absent => issue_view_response(status: 400, body: "Invalid issue offset.")
      Present { value: offset } => if offset < 0 || offset > 100000 { issue_view_response(status: 400, body: "Invalid issue offset.") } else {
        let stored = served_observation_surface_response_for_instance(instance: instance, kind: IssueQueryRows)
        if stored.status != 200 { stored } else {
          let identity = served_observation_body_digest(body: stored.body)
          let expected = issue_form_field(body: request.body, name: "snapshot")
          if offset > 0 && expected != identity { issue_view_response(status: 409, body: "Issues changed; refresh the results before loading more.") }
          else { match issue_query_rows_of(body: stored.body) {
            Absent => issue_view_response(status: 503, body: "Issue query observation unreadable.")
            Present { value: rows } => issue_view_response(status: 200, body: issue_query_response_body(rows: rows, prefs: prefs, offset: offset, snapshot: identity))
          } }
        }
      }
    }
  }
}

// A SERVED RESPONSE HAS NO SURFACE FOR A LEAKED EVENT-LOG SNAPSHOT. The body is the client's answer
// to its own request -- a page, a redirect, a refusal it can act on -- and the path of a scratch
// worktree on the host is neither the client's to act on nor the client's to see; the serve process
// writes no operator log of its own. So in the three functions below the snapshot's standing is
// matched by name and the carrier's result passes through unchanged. THIS FAILURE ITSELF IS
// RECORDED NOWHERE. What exists is the instance's snapshot census
// (gunbc.roadmap.roadmap_event_snapshot_census roadmap_snapshot_census_for_instance), taken by the
// belt tick from the repository's worktree registry: a snapshot a served request left registered is
// listed there for as long as it stays registered. The census does not know a removal failed, and
// one whose worktree is gone before the next census appears nowhere.
fn serve_history_after_snapshot_close(read: CarrierClosed<RoadmapEventsRead>) -> RoadmapEventsRead {
  match read.close {
    SnapshotNotOpened => read.result
    SnapshotClosed => read.result
    SnapshotCloseFailed { worktree: _, exit_code: _, stderr: _ } => read.result
  }
}

fn serve_all_events_after_snapshot_close(read: CarrierClosed<RoadmapAllEventsRead>) -> RoadmapAllEventsRead {
  match read.close {
    SnapshotNotOpened => read.result
    SnapshotClosed => read.result
    SnapshotCloseFailed { worktree: _, exit_code: _, stderr: _ } => read.result
  }
}

fn serve_append_after_snapshot_close(appended: CarrierClosed<RoadmapEventAppend>) -> RoadmapEventAppend {
  match appended.close {
    SnapshotNotOpened => appended.result
    SnapshotClosed => appended.result
    SnapshotCloseFailed { worktree: _, exit_code: _, stderr: _ } => appended.result
  }
}
