module gunbc.roadmap.roadmap_work_item_projection

import std.types { String, Int, Bool, List }
import std.decl_ref { declaration_ref_display_key }
import gunbc.roadmap.roadmap_model { RoadmapNodeId, LeafPath }
import gunbc.roadmap.roadmap_event_log {
  RoadmapNodeStanding, RoadmapStandings, LeafInFlightEntry, LeafInFlightRead, InFlightLeaves, InFlightRefused, RoadmapEventEnvelope, RoadmapEventKind,
  roadmap_event_kind_word, standing_for_node, roadmap_node_standing_key, event_principal_label,
  roadmap_acceptance_pr_evidence_url, roadmap_leaf_in_flight_from_envs,
}
import gunbc.roadmap.roadmap_intention_binding { IntentionBinding, roadmap_intention_bindings }
import gunbc.roadmap.roadmap_schedule_calendar { DatedLeaf, date_leaf, date_text }
import gunbc.roadmap.roadmap_belt { BeltCapacity }
import gunbc.roadmap.roadmap_decomposition { WorkDecomposition, decomposition_for, expand_decomposition }
import gunbc.roadmap.roadmap_schedule { Schedule, Scheduled, NotScheduled, ScheduleRefusal, schedule }
import std.nat { Nat }
import std.integer { nat_to_int }
import extdeps.units.iso8601_calendar { Iso8601CivilDate }
import gunbc.extdeps.languages.json.emit {
  JsonValue, JsonKeyValue, json_kv, json_object, json_array, json_string, json_int, json_bool, json_null,
}

// THE WORK-ITEM PROJECTION (GET /projection.json): one JSON row per roadmap work item, the shape the
// ctrl session dashboard's Roadmap Timeline view and the gunbc planning page both read. It is a
// PROJECTION, not a store: every field is read from an authority already on the page at the tick --
// the standing from the same fold /standings.json reads (roadmap_event_log), the leaf-grain start and
// finish days and the critical path from the schedule (roadmap_schedule / roadmap_schedule_from_now,
// the leaf-grain answer), the in-flight leaves from the log's derived set (roadmap_event_log
// roadmap_leaf_in_flight_set, gunbc#16703), the intention and layer from the binding carrier
// (roadmap_intention_binding), and the item's past events from the event log AT THIS READ -- events are
// the log's own rows, never a copy this document keeps (roadmap_event_log is their only home).
//
// IT COMPUTES NOTHING THE UPSTREAM ALREADY ANSWERS (ticket note 2026-11-19). The schedule answers the
// dates and the critical path; the log answers the in-flight set and the events; the binding carrier
// answers the intention and the layer and refuses a planted binding at load. The integration here is
// the SERVED DOCUMENT and its release control -- assembling those answers into the one closed wire
// shape and refusing a row that could not honestly carry it -- never a second timeline calculation.
//
// WHY A REFUSAL AND NOT A GAP. The ticket's red control: a served row that omits a declared field of
// the shape -- a leaf without its critical-path bit, an in-flight entry without its assignee and
// return_to, an event without its recorded day, a row without read_on and the inputs the read used --
// IS NOT THE PROJECTION. So the emitter refuses rather than serve a row missing a field: a reader that
// sees a row knows every declared field is present, and a reader that sees the refusal knows the
// projection was not honestly computable and reads the located reason. A silent omission would let a
// Timeline draw a bar with no critical-path colour and call it complete.

data roadmap_work_item_projection_schema: String = "roadmap-work-item-projection/v1"

// One occurrence of a leaf, with the schedule's own answer bound to dates by the calendar (roadmap_schedule_calendar
// -- ONE calendar answers both grains, per roadmap_item_gantt; abstract day integers never leave the schedule).
// start_day and finish_day are ISO days (YYYY-MM-DD) read off the dated leaf's start_date/finish_date via the
// calendar's own date_text -- the same dates the item gantt serves, so a reader runs no second calendar.
type ProjectionLeaf {
  path: String
  start_day: String
  finish_day: String
  on_critical_path: Bool
}

// One leaf the log's derived set says is in flight: the leaf path, the claim's assignee, the claim's
// return_to -- the three the boundary names. The set is DERIVED from the log (roadmap_leaf_in_flight_set),
// never a list this document stores; these rows are that set read at the tick, so an entry's assignee
// and return_to are the claim's own, not a snapshot.
type ProjectionInFlight {
  path: String
  assignee: String
  return_to: String
}

// One of the item's past events the boundary lists -- claimed, released, acceptance recorded, retired --
// with the day the log recorded it at. Read from the log at this read; not stored on the row.
type ProjectionEvent {
  kind: String
  recorded_at: String
}

// The inputs the read used, SHOWN AS INPUTS (not as facts): how many workers the schedule read with,
// the day priors it counted with, and the assumed findings counts it filled gaps with. A reader sees
// these are inputs the projection was computed under, so a bar moving with a re-read is not mistaken
// for the work moving.
type ProjectionInputs {
  worker_count: Int
  // feature:working-day-prior-carrier  dissolve-on: std.measure grows a working-day (effort) family -- the
  // same inherited grain the scheduler marks on ScheduledLeaf.start_day/finish_day (roadmap_schedule.dag) and
  // the decomposition marks on WorkPiece.days (roadmap_decomposition.dag); these values ARE those scheduled
  // working-day spans (finish - start), so this field dissolves with that carrier, never re-tracking the unit.
  // Working days, never hours; no calendar instant here (roadmap_schedule_calendar binds the grain to dates).
  day_priors: List<Int>
  assumed_findings_counts: List<Int>
}

// One work item's row. `intention` is the binding carrier's DeclarationRef display key; a row that could
// not resolve its intention is refused before it reaches this record.
type ProjectionRow {
  node: String
  intention: String
  layer: Int
  item_state: String
  leaves: List<ProjectionLeaf>
  in_flight: List<ProjectionInFlight>
  latest_event: String
  acceptance_evidence: String
  events: List<ProjectionEvent>
}

// WHY a row could not be honestly built, located and countable -- never a bare sentence.
type ProjectionRefusal
  = UnboundNode { node: String }
  | StandingUnobserved { node: String }
  // A node whose decomposition exists but whose schedule REFUSED: a plan is present but cannot be honestly
  // placed. Serving empty leaves here would draw "nothing planned" for an item mid-plan -- a silent widen.
  | ScheduleRefused { node: String, cause: String }
  // The item's in-flight read refused (history not causally orderable, a grain unreadable, ...): its held
  // claims cannot be honestly stated. Serving empty in_flight would draw "nobody claimed" -- a silent widen.
  | InFlightUnordered { node: String }

// THE INTENTION-EXISTENCE GUARANTEE IS THE BINDING CARRIER'S, NOT THIS UNIT'S. A work item's row takes its
// intention and layer from the binding carrier (roadmap_intention_bindings, IntentionBinding { node,
// intention: DeclarationRef, layer }); whether that cited DeclarationRef names a real Plan is decided ONCE,
// at load, by the carrier's own cited-declaration sweep (roadmap_intention_binding holds producer_resolves
// for the same reason a strategy clause holds it) -- a planted binding to an intention that does not exist
// refuses the seed at load and never reaches a row. This unit therefore does NOT restate which plans exist;
// a hand-copied list of plans here would be a second source of truth for a fact that belongs to gunbc.plans
// and the DeclarationRef resolution (the Consumption rule's "a module nothing imports" and single-authority
// rules forbid it). What this unit CAN check at the read is the runtime gap the fold cannot: an item with NO
// binding at all cannot carry an intention or a layer, so it refuses as UnboundNode rather than serve a bar
// wired to nothing.

// A leaf path spelled as the decomposition spells it -- item#stage#piece#member, the one string the
// schedule, the in-flight set and a reader all agree on (the schedule's own path key, read the same way).
fn projection_leaf_path_text(p: LeafPath) -> String {
  join([
    p.item as String, "#",
    to_string(nat_to_int(n: p.stage)), "#",
    to_string(nat_to_int(n: p.piece)), "#",
    to_string(nat_to_int(n: p.member)),
  ], "")
}

// ONE LEAF, dated. The dates come from the calendar's own DatedLeaf (roadmap_schedule_calendar --
// bound_day_to_date / date_leaf / bind_each_leaf read the schedule's abstract days and bind them to the read
// date; this only spells the dated answer to the wire via the calendar's date_text, so the projection serves
// the SAME ISO days the item gantt serves and runs no calendar of its own). on_critical_path is read off the
// schedule answer's critical path, compared by the leaf's spelled path.
fn projection_leaf_from_dated(d: DatedLeaf, critical_path: List<LeafPath>) -> ProjectionLeaf {
  let path = projection_leaf_path_text(p: d.path)
  ProjectionLeaf {
    path: path,
    start_day: date_text(date: d.start_date),
    finish_day: date_text(date: d.finish_date),
    on_critical_path: count(filter(critical_path, p => projection_leaf_path_text(p: p) == path)) > 0,
  }
}

// THE LEAVES OF ONE ITEM, bound to dates from the schedule answer at the read. The belt reads the schedule
// (roadmap_schedule / roadmap_schedule_from_now -- the projection never computes it), binds it through the
// calendar (bind_each_leaf), and hands the dated leaves here; this spells them to the wire. Leaves whose
// path belongs to the item are kept; the rest are not this item's row.
fn projection_leaves_for_item(dated: List<DatedLeaf>, critical_path: List<LeafPath>, item: String) -> List<ProjectionLeaf> {
  map(filter(dated, d => (d.path.item as String) == item), d => projection_leaf_from_dated(d: d, critical_path: critical_path))
}

// THE DERIVED IN-FLIGHT SET for one item, read at the tick. These entries are the log's own derived rows;
// this only names them for the wire (path, assignee, return_to) -- it holds nothing of its own.
fn projection_in_flight_entries(entries: List<LeafInFlightEntry>, item: String) -> List<ProjectionInFlight> {
  map(
    filter(entries, e => (e.leaf.item as String) == item),
    e => ProjectionInFlight {
      path: projection_leaf_path_text(p: e.leaf),
      assignee: event_principal_label(p: e.assignee),
      return_to: event_principal_label(p: e.return_to),
    })
}

// The kinds the boundary carries as item events: claimed, released, acceptance recorded, retired.
fn projection_carried_kind_word(w: String) -> Bool {
  w == "claimed" || w == "released" || w == "acceptance_recorded" || w == "retired"
}

// THE ITEM'S PAST EVENTS, read from the log at THIS read -- the log's own rows, never a copy the row
// keeps. Only the boundary's carried kinds appear; each carries the day the log recorded it at.
fn projection_events_of(envs: List<RoadmapEventEnvelope>, item: String) -> List<ProjectionEvent> {
  map(
    filter(envs, e => (e.event.node as String) == item
      && projection_carried_kind_word(w: roadmap_event_kind_word(k: e.event.kind))),
    e => ProjectionEvent {
      kind: roadmap_event_kind_word(k: e.event.kind),
      recorded_at: e.event.recorded_at,
    })
}

// THE LATEST EVENT of the item, read from the log at this read: the kind word of its most recent event,
// or "none" when the log has carried nothing for it -- never a standing guessed from absence.
fn projection_latest_event_of(envs: List<RoadmapEventEnvelope>, item: String) -> String {
  fold(filter(envs, e => (e.event.node as String) == item), init: "none",
    f: fn(acc, e) { roadmap_event_kind_word(k: e.event.kind) })
}

// THE ACCEPTANCE EVIDENCE the log carries for the item: the PR evidence URL on its acceptance_recorded
// row -- the acceptance's own machine fact, read from the log at this read, not a re-spelling. An item
// with no acceptance carries the empty string, shown honestly rather than omitted.
fn projection_acceptance_evidence_of(envs: List<RoadmapEventEnvelope>, item: String) -> String {
  fold(
    filter(envs, e => (e.event.node as String) == item
      && roadmap_event_kind_word(k: e.event.kind) == "acceptance_recorded"),
    init: "",
    f: fn(acc, e) {
      match e.event.kind {
        AcceptanceRecordedEvent { receipt: _, evidence } => roadmap_acceptance_pr_evidence_url(evidence: evidence)
        _ => acc
      }
    })
}

// One build outcome: the row, or why it could not honestly be built. day_priors is the row's scheduled
// working-day spans (ScheduledLeaf finish - start); same tracked unit as ProjectionInputs.day_priors.
type ProjectionRowResult
  = ProjectionRowBuilt { row: ProjectionRow, day_priors: List<Int> }
  | ProjectionRowRefused { refusal: ProjectionRefusal }

// BUILD ONE ROW from the answers already on the page, or refuse. item_state is the fold's standing keyed;
// leaves are the schedule's; in_flight and events are the log's; intention and layer are the binding
// carrier's. Whether a cited intention names a real Plan is the carrier's LOAD-time check (see the note on
// ProjectionRefusal); the only binding gap this read can see is an item with NO binding at all, which
// refuses as UnboundNode rather than serve a bar wired to nothing.
fn projection_build_row(
  node: String,
  bindings: List<IntentionBinding>,
  standings: RoadmapStandings,
  leaves: List<ProjectionLeaf>,
  in_flight: List<ProjectionInFlight>,
  envs: List<RoadmapEventEnvelope>,
  day_priors: List<Int>,
) -> ProjectionRowResult {
  match filter(bindings, b => (b.node as String) == node).first() {
    Absent => ProjectionRowRefused { refusal: UnboundNode { node: node } }
    Present { value: b } =>
      match standing_for_node(standings: standings, node_id: node) {
        Absent => ProjectionRowRefused { refusal: StandingUnobserved { node: node } }
        Present { value: s } => ProjectionRowBuilt { row: ProjectionRow {
          node: node,
          intention: declaration_ref_display_key(ref: b.intention),
          layer: b.layer,
          item_state: roadmap_node_standing_key(s: s),
          leaves: leaves,
          in_flight: in_flight,
          latest_event: projection_latest_event_of(envs: envs, item: node),
          acceptance_evidence: projection_acceptance_evidence_of(envs: envs, item: node),
          events: projection_events_of(envs: envs, item: node),
        }, day_priors: day_priors }
      }
  }
}

fn projection_refusal_reason(refusal: ProjectionRefusal) -> String {
  match refusal {
    UnboundNode { node: n } => join(["no binding for node: ", n], "")
    StandingUnobserved { node: n } => join(["standing unobserved for node: ", n], "")
    ScheduleRefused { node: n, cause: c } => join(["schedule refused for node: ", n, " (", c, ")"], "")
    InFlightUnordered { node: n } => join(["in-flight read refused for node: ", n, " (history not orderable)"], "")
  }
}

fn projection_refusal_step(refusal: ProjectionRefusal) -> String {
  match refusal {
    UnboundNode { node: _ } => "binding"
    StandingUnobserved { node: _ } => "standing"
    ScheduleRefused { node: _, cause: _ } => "schedule"
    InFlightUnordered { node: _ } => "in_flight"
  }
}

// THE CAUSE WORD OF A REFUSED SCHEDULE -- the failure named, not swallowed (fail_closed). The projection
// refuses on a NotScheduled rather than widen to empty leaves, and this names which arm refused so the
// located reason carries the upstream cause instead of a generic 'schedule refused'.
fn projection_schedule_refusal_cause(refusal: ScheduleRefusal) -> String {
  match refusal {
    OverRefusedExpansion { cause: _ } => "over_refused_expansion"
    ConcurrencyCapInvalid { cap: _ } => "concurrency_cap_invalid"
    NoWorkingDayPrior { paths: _ } => "no_working_day_prior"
    CyclicOccurrenceGraph => "cyclic_occurrence_graph"
    UnplacedOccurrences { paths: _ } => "unplaced_occurrences"
    MemberIndexBeyondExpansion { paths: _ } => "member_index_beyond_expansion"
    PinnedLeafNotAnOccurrence { paths: _ } => "pinned_leaf_not_an_occurrence"
    PinnedPlacementInvalid { paths: _ } => "pinned_placement_invalid"
  }
}

// THE SERVED DOCUMENT: the whole roadmap as one JSON document, read_on and the inputs the read used at
// the TOP LEVEL (every row shares the one read), and the rows beneath `rows`. Any row that could not be
// honestly built refuses the WHOLE document -- a Timeline missing a row would silently draw an incomplete
// plan, so an honest projection refuses rather than drops. A reader treats a document without `rows` as
// not-the-projection and reads `refused` for the located reason.
fn roadmap_work_item_projection_document_json(
  rows: List<ProjectionRow>,
  refused: List<ProjectionRefusal>,
  read_on: String,
  inputs: ProjectionInputs,
) -> JsonValue {
  if count(refused) > 0 {
    match refused.first() {
      Present { value: r } => roadmap_work_item_projection_refusal_json(read_on: read_on, step: projection_refusal_step(refusal: r), reason: projection_refusal_reason(refusal: r))
      Absent => roadmap_work_item_projection_refusal_json(read_on: read_on, step: "unknown", reason: "refusal list unreadable")
    }
  } else {
    json_object(members: [
      json_kv(key: "schema", value: json_string(s: roadmap_work_item_projection_schema)),
      json_kv(key: "read_on", value: json_string(s: read_on)),
      json_kv(key: "inputs", value: json_object(members: [
        json_kv(key: "worker_count", value: json_int(n: inputs.worker_count)),
        json_kv(key: "day_priors", value: json_array(elements: map(inputs.day_priors, d => json_int(n: d)))),
        json_kv(key: "assumed_findings_counts", value: json_array(elements: map(inputs.assumed_findings_counts, c => json_int(n: c)))),
      ])),
      json_kv(key: "rows", value: json_array(elements: map(rows, r => projection_row_json(row: r)))),
    ])
  }
}

// EVERY DECLARED FIELD, every row, always. No field is conditional: the boundary's red control is that a
// row omitting a declared field is not the projection, so the emitter writes all of them -- node,
// intention, layer, item_state, leaves (each with its critical-path bit), in_flight (each with assignee
// and return_to), latest_event, acceptance_evidence, events (each with its recorded day).
fn projection_row_json(row: ProjectionRow) -> JsonValue {
  json_object(members: [
    json_kv(key: "node", value: json_string(s: row.node)),
    json_kv(key: "intention", value: json_string(s: row.intention)),
    json_kv(key: "layer", value: json_int(n: row.layer)),
    json_kv(key: "item_state", value: json_string(s: row.item_state)),
    json_kv(key: "leaves", value: json_array(elements: map(row.leaves, l => json_object(members: [
      json_kv(key: "path", value: json_string(s: l.path)),
      json_kv(key: "start_day", value: json_string(s: l.start_day)),
      json_kv(key: "finish_day", value: json_string(s: l.finish_day)),
      json_kv(key: "on_critical_path", value: json_bool(b: l.on_critical_path)),
    ])))),
    json_kv(key: "in_flight", value: json_array(elements: map(row.in_flight, f => json_object(members: [
      json_kv(key: "path", value: json_string(s: f.path)),
      json_kv(key: "assignee", value: json_string(s: f.assignee)),
      json_kv(key: "return_to", value: json_string(s: f.return_to)),
    ])))),
    json_kv(key: "latest_event", value: json_string(s: row.latest_event)),
    json_kv(key: "acceptance_evidence", value: json_string(s: row.acceptance_evidence)),
    json_kv(key: "events", value: json_array(elements: map(row.events, e => json_object(members: [
      json_kv(key: "kind", value: json_string(s: e.kind)),
      json_kv(key: "recorded_at", value: json_string(s: e.recorded_at)),
    ])))),
  ])
}

// THE REFUSAL, located and typed -- the projection says WHY it is not the projection rather than
// answering with a partial document a reader could mistake for complete.
fn roadmap_work_item_projection_refusal_json(read_on: String, step: String, reason: String) -> JsonValue {
  json_object(members: [
    json_kv(key: "schema", value: json_string(s: roadmap_work_item_projection_schema)),
    json_kv(key: "read_on", value: json_string(s: read_on)),
    json_kv(key: "refused", value: json_object(members: [
      json_kv(key: "step", value: json_string(s: step)),
      json_kv(key: "reason", value: json_string(s: reason)),
    ])),
  ])
}

// THE ONE PER-ITEM READ (ticket reuse note 2026-11-19; manager ruling 2026-11-24). The whole composition
// for a single work item lives here: the item's decomposition, expanded and scheduled by the schedule that
// already exists (roadmap_schedule), the answer's leaves bound to ISO days by the ONE calendar
// (roadmap_schedule_calendar.date_leaf -- the same binding the item gantt uses, so the projection and the
// gantt never carry two calendars), the item's derived in-flight set read off its OWN envelopes through the
// log's fold (roadmap_event_log.roadmap_leaf_in_flight_from_envs, never a second derivation), and the row
// assembled by projection_build_row from the binding (intention, layer), the standing (item_state) and the
// envelopes (events, latest_event, acceptance_evidence). IT DRIVES THE UPSTREAM ANSWERS AND COMPUTES NO
// TIMELINE OF ITS OWN. An EMPTY leaf list means one thing only: the node has no decomposition at all -- a
// fact about an unplanned item. A schedule that REFUSES, or an in-flight history the log cannot order,
// REFUSES the WHOLE row (ProjectionRowRefused { ScheduleRefused | InFlightUnordered }) rather than widen to
// an empty list: a barless row must never stand in for a plan the schedule could not place or hide held
// claims behind an empty in_flight (fail_closed: a failure arm refuses, it never widens). Likewise
// in_flight is never silently emptied -- it is the log's derived set, or the row refuses.
fn roadmap_projection_row_read(
  node: RoadmapNodeId,
  read_date: Iso8601CivilDate,
  workers: BeltCapacity,
  findings_count: Nat,
  standings: RoadmapStandings,
  envs: List<RoadmapEventEnvelope>,
) -> ProjectionRowResult {
  let node_id = node as String
  let item_envs = filter(envs, e => (e.event.node as String) == node_id)
  // In-flight FIRST, and fail-closed: a refused in-flight read (history not orderable, a grain unreadable,
  // ...) refuses the WHOLE row -- it is never widened to an empty set, which would draw an item with held
  // claims as one nobody claimed (fail_closed). Ordering it before the schedule keeps an unordered history
  // visible even where the schedule would otherwise have answered.
  match roadmap_leaf_in_flight_from_envs(envs: item_envs) {
    InFlightRefused { cause: _ } => ProjectionRowRefused { refusal: InFlightUnordered { node: node_id } }
    InFlightLeaves { leaves: entries, closed: _, pathless_claims: _, absorbed_claims: _ } =>
      let in_flight = projection_in_flight_entries(entries: entries, item: node_id)
      match decomposition_for(node: node).first() {
        // NO decomposition at all: nothing to plan, so the leaf list is honestly empty -- the ONLY case that
        // serves empty leaves (a fact about an unplanned item, not a hidden refusal).
        Absent => projection_build_row(
          node: node_id, bindings: roadmap_intention_bindings, standings: standings,
          leaves: [] as List<ProjectionLeaf>, in_flight: in_flight, envs: item_envs, day_priors: [] as List<Int>)
        Present { value: d } => match schedule(d: d, e: expand_decomposition(d: d, findings_count: findings_count), workers: workers) {
          // The schedule REFUSED -- a plan exists but cannot be placed. Refuse the row (fail_closed: a failure
          // arm refuses, it never widens); do NOT widen to empty leaves and call the item un-planned.
          NotScheduled { refusal: r } => ProjectionRowRefused { refusal: ScheduleRefused { node: node_id, cause: projection_schedule_refusal_cause(refusal: r) } }
          Scheduled { answer: a } => projection_build_row(
            node: node_id, bindings: roadmap_intention_bindings, standings: standings,
            leaves: projection_leaves_for_item(
              dated: map(a.leaves, l => date_leaf(read_date: read_date, leaf: l)),
              critical_path: a.critical_path,
              item: node_id,
            ),
            in_flight: in_flight,
            envs: item_envs,
            // The working-day spans the schedule priced each leaf at -- the read's ACTUAL day priors, surfaced
            // so the document shows them as the inputs they are (they live in the decomposition, not a side input).
            // feature:working-day-prior-carrier -- the scheduled working-day span (ScheduledLeaf
            // finish_day - start_day), the same bare-Int grain the schedule and decomposition carry; dissolves
            // with that carrier (see ProjectionInputs.day_priors). Working days, never hours.
            day_priors: map(a.leaves, l => l.finish_day - l.start_day),
          )
        }
      }
  }
}

// THE SERVED PROJECTION FOR A SET OF WORK ITEMS AT ONE READ -- the single call the /projection.json surface
// makes (manager ruling 2026-11-24: the hot served_observation file holds only this one call plus the
// ProjectionJson arm, never the composition itself). It maps every node through the one row read above and
// hands the rows and any refusal to the document builder, which emits refused{step,reason} for the WHOLE
// document if any single item could not be honestly built -- so a Timeline never draws a partial plan as a
// complete one. A refusal here is THE PROJECTION'S OWN and reaches only /projection.json; it does not fail
// the tick or the standings surface, which are built by their own arms. read_on and the inputs the read used
// (worker_count, the day priors -- each built row's scheduled working-day spans, concatenated, so the reader
// sees the durations the schedule actually placed with -- and the findings count it assumed) sit at the top
// level, shown as the inputs they
// are and not as facts (the boundary). The witness drives it with constructed inputs, the way
// roadmap_standings_document_test drives the standings fold.
fn roadmap_projection_document_for_read(
  nodes: List<RoadmapNodeId>,
  read_on_date: Iso8601CivilDate,
  workers: BeltCapacity,
  findings_count: Nat,
  standings: RoadmapStandings,
  envs: List<RoadmapEventEnvelope>,
) -> JsonValue {
  let read_on = date_text(date: read_on_date)
  let results = map(nodes, n => roadmap_projection_row_read(
    node: n, read_date: read_on_date, workers: workers, findings_count: findings_count, standings: standings, envs: envs))
  let rows = fold(results, init: [] as List<ProjectionRow>, f: fn(acc, r) {
    match r {
      ProjectionRowBuilt { row: row, day_priors: _ } => concat(acc, [row])
      ProjectionRowRefused { refusal: _ } => acc
    }
  })
  let refusals = fold(results, init: [] as List<ProjectionRefusal>, f: fn(acc, r) {
    match r {
      ProjectionRowBuilt { row: _, day_priors: _ } => acc
      ProjectionRowRefused { refusal: refusal } => concat(acc, [refusal])
    }
  })
  // THE DAY PRIORS THE READ ACTUALLY PRICED WITH: the working-day spans the schedule placed each built leaf
  // at, collected across every built item and shown at the top as the input it is (the boundary). An empty
  // list here now means exactly what it says -- no scheduled leaf was priced -- rather than a field that
  // claimed priors it never captured.
  let day_priors = fold(results, init: [] as List<Int>, f: fn(acc, r) {
    match r {
      ProjectionRowBuilt { row: _, day_priors: p } => concat(acc, p)
      ProjectionRowRefused { refusal: _ } => acc
    }
  })
  roadmap_work_item_projection_document_json(
    rows: rows,
    refused: refusals,
    read_on: read_on,
    inputs: ProjectionInputs {
      worker_count: workers.max_concurrent,
      day_priors: day_priors,
      assumed_findings_counts: [nat_to_int(n: findings_count)],
    },
  )
}
