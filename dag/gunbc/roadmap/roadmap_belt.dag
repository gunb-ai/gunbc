module gunbc.roadmap_belt

import std.types { String, Int, List, Bool }
import gunbc.roadmap_model { RoadmapNode, RoadmapNodeId }
import gunbc.roadmap_document { RoadmapDocument }
import gunbc.roadmap_spawner { SpawnFrontier, spawn_frontier }
import gunbc.roadmap_authority {
  roadmap_authority_projection,
  RoadmapAuthorityProjected, RoadmapAuthorityProjectionRefused,
  authored_merged_prs,
}
import gunbc.membership_reconcile {
  MembershipPlan, MemberAction,
  MemberAdded, MemberChanged, MemberRemoved, MemberRemovalRefused, MemberRosterDuplicateKeyRefused,
  membership_reconcile,
  membership_plan_admitting_outcome,
}
import gunbc.ownership { Ownership, Owned }
import gunbc.roadmap_dispatch_actuator { DispatchLiveSession, dispatch_session_is_owned }
import extdeps.languages.json.emit {
  JsonValue,
  serialize_json,
  json_string,
  json_int,
  json_bool,
  json_array,
  json_object,
  json_kv,
}

// RLM-1 (docs/plans/roadmap-launch-mvp-plan.md section 3): the belt's run state and the launch
// admission's spawn mode were ONE concept, migrated at the root (DESIGN 3 replacement migration) --
// BeltRunState = Running | Paused is gone and SpawnMode stands where it stood. Paused: no cause may
// start work and the reconciler emits nothing. ManualReady (PRODUCTION): the operator may start a
// Ready node through the shared launch admission; the timer may not start new work, while its
// reconciliation (teardown of departed members), verification, publication and cleanup continue --
// so the reconciler still runs and only the launch admission (gunbc.roadmap_launch_admission
// launch_gate_cause) withholds the timer's spawns. AutomaticReady: the timer starts Ready nodes up
// to capacity, the retired default. The production value is roadmap_belt_production_spawn_mode.

type SpawnMode
  = Paused
  | ManualReady
  | AutomaticReady

fn spawn_mode_label(m: SpawnMode) -> String {
  match m {
    Paused => "paused"
    ManualReady => "manual_ready"
    AutomaticReady => "automatic_ready"
  }
}

fn spawn_mode_of_label(label: String) -> SpawnMode? {
  match label {
    "paused" => Present { value: Paused }
    "manual_ready" => Present { value: ManualReady }
    "automatic_ready" => Present { value: AutomaticReady }
    _ => none
  }
}

type BeltCapacity {
  max_concurrent: Int
}

fn belt_free_slots_int(cap: BeltCapacity, occupied_count: Int) -> Int {
  let free = cap.max_concurrent - occupied_count
  if free < 0 { 0 } else { free }
}

data roadmap_belt_default_capacity: BeltCapacity = BeltCapacity { max_concurrent: 3 }

data roadmap_belt_production_spawn_mode: SpawnMode = ManualReady

// R9 session-grain binding: the belt IS gunbc.membership_reconcile at member-type = dispatch
// Session. Desired = frontier.ready roadmap nodes; observed = dispatch_live_sessions (belt-owned by
// construction — the gunbc-dispatch- prefix filter + node-id keying, so a foreign tmux session has
// no node-id key, is not a member, and never enters Removed). Added -> spawn, Removed(owned) ->
// reap, Unchanged -> noop, Paused -> no actions, capacity caps upserts. This SUBSUMED belt_step
// (spawn-only, observed hardcoded empty), the degenerate slice-1 precursor; the host-effect driver
// (belt_tick_for_instance: MemberAdded/MemberChanged -> launch admission ->
// dispatch_spawn_commands, MemberRemoved -> tmux_kill_session_argv) consumes belt_reconcile as the
// sole belt decision, and belt_step was DELETED under RLM-1 because a retired planner still
// selecting frontier.ready is a second eligibility authority (DESIGN 3 delete-first). The belt is a
// CONTINUOUS reconciler => SIBLINGS-CONTINUE (product/plan grain: emit doable spawns+reaps,
// count+surface refusals), NOT the deploy's atomic wholesale-refuse. It reuses the spine UNCHANGED
// (zero spine edit) — the grain-agnosticism proof (DESIGN §2 Realization / R9).

type DispatchMemberAt = String

type DispatchMember
  = DesiredMember { node_id: String, node: RoadmapNode }
  | ObservedMember { node_id: String, session: DispatchLiveSession }

// The reconcile member for the belt. DesiredMember (from frontier.ready) carries the RoadmapNode
// for the spawn brief; ObservedMember (from dispatch_live_sessions) carries the DispatchLiveSession
// for the teardown. Both keyed on the node-id String so a ready node and its live session collapse
// to one key. The action's member carries exactly the payload that action needs:
// Added->DesiredMember(.node) spawns, Removed->ObservedMember(.session) reaps. Keyed on raw String
// (not RoadmapNodeId) so desired (n.node as String) and observed (s.node_id, already String) share
// one key type with no branded cast.

fn dispatch_member_key(m: DispatchMember) -> String {
  match m {
    DesiredMember { node_id, node: _ } => node_id
    ObservedMember { node_id, session: _ } => node_id
  }
}

fn dispatch_member_key_eq(a: String, b: String) -> Bool { a == b }

// Presence-only equality (always true): a ready node WITH a live session is Unchanged (noop), never
// Modified — the belt must NEVER respawn a running session on content drift (that would kill live
// work). Session HEALTH (drain/restart of a drifted or hung session for a still-ready node) is the
// actuator lease concern (roadmap_dispatch_actuator.classify_dispatch_lease_upsert), a SEPARATE
// layer over membership. key_of is stable identity (node-id) so a Removed member means the node
// genuinely left the ready set (done), never a content drift.

fn dispatch_member_value_eq(a: DispatchMember, b: DispatchMember) -> Bool { true }

// R5 owned-only teardown at session grain. Teardown-eligibility (Owned) is the actuator's
// dispatch_session_is_owned Bool (Converged/Drifted = OUR process;
// Conflict/Inaccessible/UnknownRefused/Absent = not owned — see dispatch_session_ownership_note).
// This fn LIFTS that Bool into gunbc.ownership.Ownership? for the spine's teardown gate: owned ->
// Present{Owned} (reap), not-owned -> Absent -> OwnershipUnknown -> the spine REFUSES teardown
// (counted, surfaced), never kills a session it cannot prove it owns. The coarse spine cause
// (foreign Conflict collapses to OwnershipUnknown because gunbc.ownership has no
// observed-but-foreign stance distinct from Ensured=required-dependency) is retained finely in the
// ObservedMember payload (session.lease_verdict) for belt surfacing; a spine-cause refinement is a
// coordinated evolution, not a belt fork. Keeping the verdict match in the actuator lets
// roadmap_belt avoid importing ObservationVerdict, whose Absent variant collides with
// Optional.Absent.

fn belt_ownership_owned() -> Ownership? { Present { value: Owned } }
fn belt_ownership_unknown() -> Ownership? { Absent }

fn belt_session_ownership(session: DispatchLiveSession) -> Ownership? {
  if dispatch_session_is_owned(session: session) { belt_ownership_owned() } else { belt_ownership_unknown() }
}

// ownership_of is called by the spine ONLY on Removed (observed-side) members; a DesiredMember is
// on the desired side and is never Removed, so this arm is unreachable by construction. IF reached
// it returns Absent => OwnershipUnknown => REFUSE (fail-closed, DESIGN §5) — never a fabricated
// Owned that would license a teardown.

fn dispatch_member_ownership(m: DispatchMember) -> Ownership? {
  match m {
    ObservedMember { node_id: _, session } => belt_session_ownership(session: session)
    DesiredMember { node_id: _, node: _ } => belt_ownership_unknown()
  }
}

fn belt_desired_members(frontier: SpawnFrontier) -> List<DispatchMember> {
  frontier.ready |> map(n => DesiredMember { node_id: n.node as String, node: n })
}

fn belt_observed_members(live: List<DispatchLiveSession>) -> List<DispatchMember> {
  live |> map(s => ObservedMember { node_id: s.node_id, session: s })
}

fn belt_membership_plan(
  frontier: SpawnFrontier,
  live: List<DispatchLiveSession>,
) -> MembershipPlan<DispatchMember, DispatchMemberAt> {
  membership_plan_admitting_outcome(
    outcome: membership_reconcile(
      desired: belt_desired_members(frontier: frontier),
      observed: belt_observed_members(live: live),
      key_of: dispatch_member_key,
      key_eq: dispatch_member_key_eq,
      value_eq: dispatch_member_value_eq,
      ownership_of: dispatch_member_ownership,
    ),
  )
}

fn belt_plan_upserts(plan: MembershipPlan<DispatchMember, DispatchMemberAt>) -> List<DispatchMember> {
  fold(plan.actions, init: [], f: fn(acc, a) {
    match a {
      MemberAdded { at: _, to: member } => concat(acc, [member])
      MemberChanged { at: _, from: _, to: member } => concat(acc, [member])
      MemberRemoved { at: _, from: _ } => acc
      MemberRemovalRefused { from: _, cause: _ } => acc
      MemberRosterDuplicateKeyRefused { roster: _, first: _, duplicate: _ } => acc
    }
  })
}

fn belt_plan_teardowns(plan: MembershipPlan<DispatchMember, DispatchMemberAt>) -> List<DispatchMember> {
  fold(plan.actions, init: [], f: fn(acc, a) {
    match a {
      MemberRemoved { at: _, from: member } => concat(acc, [member])
      MemberAdded { at: _, to: _ } => acc
      MemberChanged { at: _, from: _, to: _ } => acc
      MemberRemovalRefused { from: _, cause: _ } => acc
      MemberRosterDuplicateKeyRefused { roster: _, first: _, duplicate: _ } => acc
    }
  })
}

fn belt_plan_refusals(plan: MembershipPlan<DispatchMember, DispatchMemberAt>) -> List<MemberAction<DispatchMember, DispatchMemberAt>> {
  plan.actions |> filter(a => match a {
    MemberRemovalRefused { from: _, cause: _ } => true
    MemberRosterDuplicateKeyRefused { roster: _, first: _, duplicate: _ } => true
    MemberAdded { at: _, to: _ } => false
    MemberChanged { at: _, from: _, to: _ } => false
    MemberRemoved { at: _, from: _ } => false
  })
}

type BeltReconcile {
  mode: SpawnMode,
  occupied: Int,
  upserts: List<DispatchMember>,
  teardowns: List<DispatchMember>,
  refusals: List<MemberAction<DispatchMember, DispatchMemberAt>>,
}

// EVERY upsert the membership plan produces is returned, in plan order; the reconcile does NOT
// truncate to free capacity. Capacity is the launch admission's gate
// (gunbc.roadmap_launch_admission launch_gate_capacity, with `reserved` counting the launches
// already admitted in the same fold), so the timer's excess rows receive a typed LaunchNoCapacity
// from the one decision instead of vanishing into a count here -- review 5059520727 found `spawns =
// ups.take(n: free)` standing as a second capacity authority in front of the admission. Any
// deferred summary is DERIVED from those per-row outcomes (gunbc.roadmap_belt_actuate
// belt_tick_deferred_count), never computed beside them. The idempotence argument is unchanged: a
// refused node stays desired-not-observed and is planned again next tick.

fn belt_reconcile(
  state: SpawnMode,
  frontier: SpawnFrontier,
  live: List<DispatchLiveSession>,
  cap: BeltCapacity,
) -> BeltReconcile {
  match state {
    Paused => BeltReconcile {
      mode: Paused,
      occupied: count(live),
      upserts: [],
      teardowns: [],
      refusals: [],
    }
    ManualReady => belt_reconcile_members(mode: state, frontier: frontier, live: live)
    AutomaticReady => belt_reconcile_members(mode: state, frontier: frontier, live: live)
  }
}

// The membership plan runs in BOTH non-paused modes. In ManualReady the upserts it plans are still
// handed to the tick, which folds each through gunbc.roadmap_launch_admission with cause Timer and
// receives LaunchCauseNotPermitted -- so the receipt shows what the timer WOULD have started and
// why it did not (the plan's exit: the timer returns a projection of the one decision), while the
// teardowns of departed members proceed. Withholding the plan here instead would make ManualReady
// indistinguishable from Paused on the reconcile axis and stop the reap arm the plan says must
// continue.

fn belt_reconcile_members(
  mode: SpawnMode,
  frontier: SpawnFrontier,
  live: List<DispatchLiveSession>,
) -> BeltReconcile {
      let plan = belt_membership_plan(frontier: frontier, live: live)
      BeltReconcile {
        mode: mode,
        occupied: count(live),
        upserts: belt_plan_upserts(plan: plan),
        teardowns: belt_plan_teardowns(plan: plan),
        refusals: belt_plan_refusals(plan: plan),
      }
}

fn belt_reconcile_upsert_count(r: BeltReconcile) -> Int { count(r.upserts) }
fn belt_reconcile_teardown_count(r: BeltReconcile) -> Int { count(r.teardowns) }
fn belt_reconcile_refusal_count(r: BeltReconcile) -> Int { count(r.refusals) }

fn dispatch_member_id(m: DispatchMember) -> String { dispatch_member_key(m: m) }

fn belt_member_ids(ms: List<DispatchMember>) -> List<String> {
  ms |> map(m => dispatch_member_id(m: m))
}

fn belt_refusal_member_id(a: MemberAction<DispatchMember, DispatchMemberAt>) -> String {
  match a {
    MemberRemovalRefused { from: member, cause: _ } => dispatch_member_id(m: member)
    MemberRosterDuplicateKeyRefused { roster: _, first: member, duplicate: _ } => dispatch_member_id(m: member)
    MemberAdded { at: _, to: member } => dispatch_member_id(m: member)
    MemberChanged { at: _, from: _, to: member } => dispatch_member_id(m: member)
    MemberRemoved { at: _, from: member } => dispatch_member_id(m: member)
  }
}

fn belt_refusal_ids(as: List<MemberAction<DispatchMember, DispatchMemberAt>>) -> List<String> {
  as |> map(a => belt_refusal_member_id(a: a))
}

fn belt_reconcile_json_value(
  state: SpawnMode,
  frontier: SpawnFrontier,
  live: List<DispatchLiveSession>,
  cap: BeltCapacity,
) -> JsonValue {
  let r = belt_reconcile(state: state, frontier: frontier, live: live, cap: cap)
  json_object(members: [
    json_kv(key: "schema", value: json_string(s: "roadmap-belt-reconcile/v1")),
    json_kv(key: "spawn_mode", value: json_string(s: spawn_mode_label(m: r.mode))),
    json_kv(key: "max_concurrent", value: json_int(n: cap.max_concurrent)),
    json_kv(key: "occupied", value: json_int(n: r.occupied)),
    json_kv(key: "upserts", value: json_array(elements: belt_member_ids(ms: r.upserts) |> map(id => json_string(s: id)))),
    json_kv(key: "would_teardown", value: json_array(elements: belt_member_ids(ms: r.teardowns) |> map(id => json_string(s: id)))),
    json_kv(key: "refusal_count", value: json_int(n: belt_reconcile_refusal_count(r: r))),
    json_kv(key: "refused", value: json_array(elements: belt_refusal_ids(as: r.refusals) |> map(id => json_string(s: id)))),
  ])
}

fn belt_reconcile_status_json(
  state: SpawnMode,
  frontier: SpawnFrontier,
  live: List<DispatchLiveSession>,
  cap: BeltCapacity,
) -> String {
  serialize_json(v: belt_reconcile_json_value(state: state, frontier: frontier, live: live, cap: cap))
}
