module gunbc.roadmap.g0_contained_dev_execution_proof

// THE .dag INTENT OF THE G0 TWO-SIDED HERMETIC ISOLATION PROOF. The semantics of the
// unreachability probe are modeled here as a .dag consumer, and this module claims only what
// each channel proves (review 98584 FINDING 3; review 98783 TRIM):
//   - IN REPO: the claim witness dag/test/claim/roadmap/g0_criteria_witness.dag feeds CONSTRUCTED
//     return-code tokens through the single token->Bool derivation helpers into the model rule
//     g0_two_sided_isolation_holds and discriminates red on the broken-mask and own-op-denied
//     token sets. G0-compliant: constructed records only; nothing in this repo executes the probe.
//   - LANE EVIDENCE ONLY: the REAL-observation pair (enforced deny + unmasked reach) is
//     evidence-transcribed in the PR #16989 evidence comment (the bwrap probe sha256
//     d9702374b787297de2601a363133bf7981d953b8d6da7ac5895bcc322a2117ca, srv1 boot c095c0cd,
//     heavy-slot run logs pasted there). It is UNPROVEN-IN-REPO
//     (gunbc.design_argument::epistemic_humility) and never by itself a basis for a G0 lift.
//     No in-repo runner is authorized or recorded; the out-of-repo probe as realization home is
//     a DEFERRED question, see lane manager. The bash-emit capability (#5828) belongs to the
//     bash-emit work when it lands, not to this PR.
// SINGLE ISOLATION AUTHORITY (gunbc.design_argument::single_authority; reviews 98327, 98584,
// 98783): each raw return code becomes an isolation fact exactly ONCE through the single
// derivation helpers below, and the model rule g0_two_sided_isolation_holds applied to those
// derived Bools is THE isolation decision -- no other declaration re-decides it.

import std.types { Bool, String }

// THE DECISION RULE (the .dag consumer). Given the observations a probe records about a worker placed
// behind a hermetic boundary -- its own operation is permitted (own_op_permitted), the representative
// PROTECTED credential fixture is reachable (protected_reachable), and the SIBLING-ATTEMPT fixture is
// reachable (sibling_reachable) -- isolation HOLDS exactly when the worker's own operation is permitted
// AND neither the protected nor the sibling fixture is reachable. A real consumer that returns false when
// the boundary is absent (the unmasked observation), not a grep.
fn g0_two_sided_isolation_holds(own_op_permitted: Bool, protected_reachable: Bool, sibling_reachable: Bool) -> Bool {
  own_op_permitted && !protected_reachable && !sibling_reachable
}

fn g0_rc_is_zero(tok: String) -> Bool {
  match parse_int(s: tok) {
    Present { value: n } => n == 0
    Absent => false
  }
}

// SINGLE DERIVATION OF THE ISOLATION FACTS (review 98584 FINDING 1). These are the
// ONLY places a raw probe return code becomes an isolation fact: own-op permission from
// own_rc, protected reachability from the two protected rcs, sibling reachability from
// the sibling rc. The model rule g0_two_sided_isolation_holds applied to these derived
// Bools is THE isolation decision — nothing else re-decides isolation from raw rc
// comparisons (gunbc.design_argument::single_authority). An unparseable token derives
// "not permitted / not reachable" (parse absent), so it can never fabricate permission.
fn g0_own_op_permitted(own_rc: String) -> Bool {
  g0_rc_is_zero(own_rc)
}

fn g0_protected_reachable(protected_read_rc: String, protected_exec_rc: String) -> Bool {
  g0_rc_is_zero(protected_read_rc) || g0_rc_is_zero(protected_exec_rc)
}

fn g0_sibling_reachable(sibling_rc: String) -> Bool {
  g0_rc_is_zero(sibling_rc)
}
