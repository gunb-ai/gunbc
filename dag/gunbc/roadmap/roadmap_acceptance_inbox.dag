module gunbc.roadmap.roadmap_acceptance_inbox

import std.types { Set }
import gunbc.roadmap.roadmap_model { RoadmapNode, RoadmapNodeId, RoadmapAcceptanceReceipt, RoadmapAcceptanceEvent, AcceptanceRecorded, AcceptanceRevoked }
import gunbc.roadmap.roadmap_status { line_ticket }
import gunbc.roadmap.roadmap_acceptance_history_carrier {
  RoadmapAcceptanceEventHistoryLoad,
  RoadmapAcceptanceEventHistoryLoaded,
  RoadmapAcceptanceEventHistoryLoadRefused,
}
import gunbc.roadmap.roadmap_event_log { RoadmapRetiredNodeIds }
import gunbc.roadmap.roadmap_authority {
  declared_roadmap_nodes,
  declared_roadmap_edges,
  frontier_sets_projection,
  FrontierSetsProjected,
  FrontierSetsProjectionRefused,
  roadmap_node_id_set,
  roadmap_acceptance_event_history_load,
  roadmap_retired_node_ids_load,
}

// THE ACCEPTANCE INBOX: which declared nodes are awaiting acceptance, and what each owes. A pure
// projection over the ONE acceptance load and the ONE retired read (roadmap_authority
// roadmap_acceptance_event_history_load and roadmap_retired_node_ids_load, both over the roadmap event
// log through roadmap_operator_acceptance_history_load); it keeps no list of its
// own and reads no carrier file.
//
// EVERY REFUSAL IS TYPED, NEVER AN EMPTY INBOX. An empty row list would assert that nothing awaits
// acceptance, so a refused load, an unreplayable history, or a frontier refusal yields
// AcceptanceInboxProjectionRefused (same discipline as roadmap_acceptance_receipts and
// WithheldNodeIdsProjectionRefused). That includes a live receipt whose criteria_digest no longer
// matches its node: frontier_sets_projection refuses on it (live-receipt-does-not-match-declared-node),
// so a stale acceptance surfaces here as a refusal naming the node, never as a quiet row.
//
// THE ROW CARRIES THE NODE, NOT ITS TEXT. red_control, handback and the rest of the ticket are read
// from the RoadmapNode (line_ticket) by whoever renders; copying them would be a second spelling.
// CONSUMERS (gunbc.design_argument::consumption). Consumed in this change: test.claim.roadmap.roadmap_acceptance_inbox_witness
// (supplied histories, with red controls) and test.claim.roadmap.roadmap_acceptance_inbox_live_witness
// (the real route, roadmap_acceptance_inbox_on_authority on the live corpus). DECLARED FRONTIER, the
// production consumer: the acceptance-inbox renderer (a roadmap page section reading each row.node
// through line_ticket), landed by the change that follows this one; its trigger is this module being
// on main. Until then the projection is read only by those witnesses.
// There is no execution-evidence field: a receipt's evidence exists only for a node that was
// accepted once, and that is the only reading carried (PriorReceiptRevoked).

type InboxStatus
  = InboxAwaiting
  | InboxWithheld

type ParentAcceptance
  = ParentAccepted { parent: RoadmapNodeId }
  | ParentWithheld { parent: RoadmapNodeId }
  | ParentOpen { parent: RoadmapNodeId }

type PriorReceiptReading
  = NoReceiptEverRecorded
  | PriorReceiptRevoked { receipt: RoadmapAcceptanceReceipt }

type AcceptanceInboxRow {
  node: RoadmapNode
  status: InboxStatus
  parents: List<ParentAcceptance>
  prior: PriorReceiptReading
}

type AcceptanceInbox
  = AcceptanceInboxProjected { rows: List<AcceptanceInboxRow> }
  | AcceptanceInboxProjectionRefused { detail: String }

fn node_has_ticket(rn: RoadmapNode) -> Bool {
  match line_ticket(item: rn.line) {
    Present { value: _ } => true
    Absent => false
  }
}

fn inbox_parent_state(
  parent: RoadmapNodeId,
  accepted: Set<RoadmapNodeId>,
  withheld: Set<RoadmapNodeId>,
) -> ParentAcceptance {
  if set_contains(accepted, parent) {
    ParentAccepted { parent: parent }
  } else {
    if set_contains(withheld, parent) {
      ParentWithheld { parent: parent }
    } else {
      ParentOpen { parent: parent }
    }
  }
}

// The latest revoked receipt for the node, read from the loaded events themselves. Admissibility of
// the history is already judged once, by frontier_sets_projection, before this runs; this is a read
// of AcceptanceRevoked events, not a second replay.
fn inbox_prior_reading(
  events: List<RoadmapAcceptanceEvent>,
  node: RoadmapNodeId,
) -> PriorReceiptReading {
  fold(
    events,
    init: NoReceiptEverRecorded,
    f: fn(acc, e) {
      match e {
        AcceptanceRecorded { receipt: _ } => acc
        AcceptanceRevoked { exact_prior_receipt: r, disposition: _, reason: _, revoked_by: _, revoked_on: _ } =>
          if r.node == node { PriorReceiptRevoked { receipt: r } } else { acc }
      }
    },
  )
}

fn roadmap_acceptance_inbox(
  history: RoadmapAcceptanceEventHistoryLoad,
  retired: RoadmapRetiredNodeIds
) -> AcceptanceInbox {
  match history {
    RoadmapAcceptanceEventHistoryLoadRefused { detail: detail } =>
      AcceptanceInboxProjectionRefused { detail: detail }
    RoadmapAcceptanceEventHistoryLoaded { events: events } =>
      match frontier_sets_projection(history: history, retired: retired) {
        FrontierSetsProjectionRefused { detail: detail } =>
          AcceptanceInboxProjectionRefused { detail: detail }
        FrontierSetsProjected { accepted: accepted, withheld: withheld } => {
          let accepted_set = roadmap_node_id_set(ids: accepted)
          let withheld_set = roadmap_node_id_set(ids: withheld)
          let edges = declared_roadmap_edges()
          AcceptanceInboxProjected {
            rows: declared_roadmap_nodes()
              |> filter(n => node_has_ticket(rn: n) && !set_contains(accepted_set, n.node))
              |> map(n => AcceptanceInboxRow {
                node: n,
                status: if set_contains(withheld_set, n.node) { InboxWithheld } else { InboxAwaiting },
                parents: edges
                  |> filter(e => e.child == n.node)
                  |> map(e => inbox_parent_state(parent: e.parent, accepted: accepted_set, withheld: withheld_set)),
                prior: inbox_prior_reading(events: events, node: n.node),
              }),
          }
        }
      }
  }
}

fn roadmap_acceptance_inbox_on_authority() -> AcceptanceInbox {
  roadmap_acceptance_inbox(history: roadmap_acceptance_event_history_load(), retired: roadmap_retired_node_ids_load())
}
