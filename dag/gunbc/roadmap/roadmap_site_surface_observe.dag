module gunbc.roadmap.roadmap_site_surface_observe

import gunbc.roadmap.roadmap_event_log { StandingsUnobserved, RetiredNodeIdsLoaded }
import gunbc.roadmap.roadmap_acceptance_history_carrier { RoadmapAcceptanceEventHistoryLoaded }
import std.types { String, NonEmptyStr, List }
import std.content_hash { Fnv1a64Structural, content_hash_atom, content_hash_combine_structural, content_hash_tagged_structural }
import gunbc.roadmap.roadmap_authority {
  RoadmapAuthorityProjection,
  RoadmapAuthorityProjected,
  RoadmapAuthorityProjectionRefused,
  roadmap_authority_projection_with,
  expected_roadmap_md_for_projection,
}
import gunbc.roadmap.roadmap_spawner { roadmap_dispatch_file_content_for_projection }
import gunbc.roadmap.roadmap_page {
  roadmap_daily_workspace_page_for_projection_observed,
}
import gunbc.roadmap.roadmap_launch_admission { launch_host_unobserved_static_render }
import gunbc.roadmap.roadmap_component { dispatch_client_js_source, roadmap_dispatch_asset_path }
import gunbc.roadmap.roadmap_model { RoadmapNodeId }
import gunbc.roadmap.roadmap_site_surface_types {
  RoadmapSiteSurfaceArtifact,
  RoadmapSiteSurfaceBundle,
}
import gunbc.roadmap.roadmap_site_surface_render {
  roadmap_site_dispatch_url_path,
  roadmap_site_daily_url_path,
  site_artifact_digest,
  served_page_body,
  healthz_body_from_surface_artifacts,
}

// THE SOLE AUTHORITY for roadmap served-surface materialization. roadmap_site_tree_surface_bundle (below) is the
// one bundle every party renders; downstream consumers evaluate gunbc.roadmap.roadmap_site_surface_expect
// predicates over it.

// producer_identity names the observe/render implementation that produced a bundle, distinct from subject_identity (which roadmap snapshot) and bundle_identity (which rendered artifact population).
fn roadmap_site_surface_producer_identity() -> Fnv1a64Structural {
  content_hash_atom(value: "gunbc.roadmap_site_surface_observe/v1" as NonEmptyStr)
}

fn acceptance_identity_from_accepted(accepted: List<RoadmapNodeId>) -> Fnv1a64Structural {
  fold(accepted, init: content_hash_atom(value: "roadmap-acceptance-snapshot/v1" as NonEmptyStr), f: (acc, id) =>
    content_hash_combine_structural(
      left: acc,
      right: content_hash_atom(value: id as NonEmptyStr),
    )
  )
}

// The dispatch body is SUPPLIED by the one render that also serves it (render_roadmap_site_surface_bundle_for_projection),
// rather than rendered a second time here over the same projection.
fn subject_identity_for_projection(proj: RoadmapAuthorityProjection, dispatch_body: String) -> Fnv1a64Structural {
  match proj {
    RoadmapAuthorityProjectionRefused { detail: detail } =>
      content_hash_tagged_structural(
        tag: "roadmap-site-surface-subject-refused/v1" as NonEmptyStr,
        payload: content_hash_atom(value: detail as NonEmptyStr),
      )
    RoadmapAuthorityProjected { doc: _, accepted: accepted, withheld: _ } =>
      content_hash_combine_structural(
        left: acceptance_identity_from_accepted(accepted: accepted),
        right: content_hash_combine_structural(
          left: site_artifact_digest(body: expected_roadmap_md_for_projection(proj: proj)),
          right: site_artifact_digest(body: dispatch_body),
        ),
      )
  }
}

fn bundle_identity_from_artifacts(
  dispatch: RoadmapSiteSurfaceArtifact,
  daily: RoadmapSiteSurfaceArtifact,
  dispatch_js: RoadmapSiteSurfaceArtifact,
) -> Fnv1a64Structural {
  fold(
    [dispatch.digest, daily.digest, dispatch_js.digest],
    init: content_hash_atom(value: "roadmap-site-surface-bundle/v1" as NonEmptyStr),
    f: (acc, digest) => content_hash_combine_structural(left: acc, right: digest),
  )
}

fn render_roadmap_site_surface_bundle_for_projection(proj: RoadmapAuthorityProjection) -> RoadmapSiteSurfaceBundle {
  let dispatch_body = roadmap_dispatch_file_content_for_projection(proj: proj)
  let subject_identity = subject_identity_for_projection(proj: proj, dispatch_body: dispatch_body)
  let producer_identity = roadmap_site_surface_producer_identity()
  let daily_body = served_page_body(
    page: roadmap_daily_workspace_page_for_projection_observed(
      proj: proj,
      attempts: [],
      attempts_refused: none,
      standings: StandingsUnobserved { reason: "site surface observation renders the static page and does not consult the event carrier" },
      launch: launch_host_unobserved_static_render(),
      profiles: [],
    )
  )
  let js_body = dispatch_client_js_source()
  let dispatch = RoadmapSiteSurfaceArtifact {
    url_path: roadmap_site_dispatch_url_path,
    body: dispatch_body,
    digest: site_artifact_digest(body: dispatch_body),
  }
  let daily = RoadmapSiteSurfaceArtifact {
    url_path: roadmap_site_daily_url_path,
    body: daily_body,
    digest: site_artifact_digest(body: daily_body),
  }
  let dispatch_js = RoadmapSiteSurfaceArtifact {
    url_path: roadmap_dispatch_asset_path as NonEmptyStr,
    body: js_body,
    digest: site_artifact_digest(body: js_body),
  }
  RoadmapSiteSurfaceBundle {
    subject_identity: subject_identity,
    producer_identity: producer_identity,
    bundle_identity: bundle_identity_from_artifacts(
      dispatch: dispatch,
      daily: daily,
      dispatch_js: dispatch_js,
    ),
    dispatch_json: dispatch,
    daily_html: daily,
    dispatch_js: dispatch_js,
    healthz_body: healthz_body_from_surface_artifacts(
      dispatch: dispatch,
      daily: daily,
      dispatch_js: dispatch_js,
    ),
  }
}

// THE SURFACE IDENTITY IS A FACT OF (interpreter, tree), NOT OF THE EVENT LOG (operator ruling 2026-11-26,
// approved on gunbc#17128's proposal). gunbc.live_deploy.release_binding states what the surface digest is FOR:
// "a joint fact of the interpreter that is actually executing and the tree it is actually interpreting". The
// event log was a third input to it that bought nothing toward that purpose and cost a carrier read on BOTH sides
// of every comparison: the serving process read its carrier per /healthz probe (a snapshot, fold and render that
// overran the 30 s serve budget, incident 2026-11-26), the expectation read the log again at a different instant
// (so an event landing between the two was a spurious mismatch), and a principal that could not open the carrier
// had to be refused by a typed arm because a render over a refused read would fabricate an identity.
//
// So the surface is rendered over the CARRIER-FREE PROJECTION: the declared roadmap rows folded by the one
// projection fold (gunbc.roadmap.roadmap_authority roadmap_authority_projection_with) with an empty acceptance
// history, no runtime tasks and an empty retired set. Nothing here reads a carrier, so every party that renders it
// -- the serving process (/healthz), the belt pair gate, the deploy candidate, the readiness gate and the launch
// receipt -- computes the same value from the same tree, and the arms that existed only because a carrier read
// could refuse (RoadmapSiteSurfaceBundleReadRefused, gunbc.live_deploy.candidate CandidateRosterReadRefused,
// gunbc.live_deploy.readiness ServiceSurfaceUnobserved) have no constructor: they were deleted with this change.
//
// WHAT IS GIVEN UP, stated where the value is minted: the dispatch digest the surface publishes is the digest of
// the dispatch document over the DECLARED rows, not of the bytes /target/roadmap-dispatch.json serves at that
// instant (which also folds the live acceptance history). The daily-page digest was already not the served `/`
// body (it renders with no attempts, standings or launch facts).
fn roadmap_site_tree_projection() -> RoadmapAuthorityProjection {
  roadmap_authority_projection_with(
    history: RoadmapAcceptanceEventHistoryLoaded { events: [] },
    runtime: [],
    retired: RetiredNodeIdsLoaded { ids: [] },
  )
}

// THE ONE SURFACE BUNDLE, a pure function of the tree this process interprets. Every comparison site renders it
// and the serving process publishes it (gunbc.roadmap.roadmap_static_site roadmap_site_healthz_body_for_release).
fn roadmap_site_tree_surface_bundle() -> RoadmapSiteSurfaceBundle {
  render_roadmap_site_surface_bundle_for_projection(proj: roadmap_site_tree_projection())
}
