module gunbc.roadmap.roadmap_site_surface_observe

import gunbc.roadmap.roadmap_runtime_plan { roadmap_plan_projection, roadmap_plan_projection_over_layout, roadmap_plan_projection_over_scoped }
import gunbc.roadmap.roadmap_event_carrier {
  RoadmapEventCarrierLayout,
  RoadmapEventCarrierScopedLayout,
  roadmap_event_carrier_ci_layout,
  roadmap_event_carrier_layout_for_instance,
}
import extdeps.git
import gunbc.roadmap.roadmap_dashboard_instance { srv1_live_dashboard_instance }
import gunbc.roadmap.roadmap_event_log { StandingsUnobserved }
import std.types { String, NonEmptyStr, List }
import std.content_hash { Fnv1a64Structural, content_hash_atom, content_hash_combine_structural, content_hash_tagged_structural }
import gunbc.roadmap.roadmap_authority {
 
  RoadmapAuthorityProjection,
  RoadmapAuthorityProjected,
  RoadmapAuthorityProjectionRefused,
  expected_roadmap_md_for_projection,
}
import gunbc.roadmap.roadmap_spawner { roadmap_dispatch_file_content_for_projection }
import gunbc.roadmap.roadmap_page {
  roadmap_daily_workspace_page_for_projection_observed,
}
import gunbc.roadmap.roadmap_launch_admission { launch_host_unobserved_static_render }
import gunbc.roadmap.roadmap_component { dispatch_client_js_source, roadmap_dispatch_asset_path }
import gunbc.roadmap.roadmap_model { RoadmapNodeId }
import gunbc.roadmap.roadmap_site_surface_types {
  RoadmapSiteSurfaceArtifact,
  RoadmapSiteSurfaceBundle,
  LiveRoadmapSiteSurfaceBundle,
  roadmap_site_surface_subject,
}
import gunbc.roadmap.roadmap_site_surface_render {
  roadmap_site_dispatch_url_path,
  roadmap_site_daily_url_path,
  site_artifact_digest,
  served_page_body,
  healthz_body_from_surface_artifacts,
}

// THE SOLE LIVE OBSERVATION AUTHORITY for roadmap served-surface materialization.
// materialize_live_roadmap_site_surface_bundle is the only entry that loads acceptance history and
// projects roadmap authority for site-surface rendering; downstream consumers evaluate
// gunbc.roadmap.roadmap_site_surface_expect predicates over the retained bundle.

// producer_identity names the observe/render implementation that produced a bundle, distinct from subject_identity (which roadmap snapshot) and bundle_identity (which rendered artifact population).
fn roadmap_site_surface_producer_identity() -> Fnv1a64Structural {
  content_hash_atom(value: "gunbc.roadmap_site_surface_observe/v1" as NonEmptyStr)
}

fn acceptance_identity_from_accepted(accepted: List<RoadmapNodeId>) -> Fnv1a64Structural {
  fold(accepted, init: content_hash_atom(value: "roadmap-acceptance-snapshot/v1" as NonEmptyStr), f: (acc, id) =>
    content_hash_combine_structural(
      left: acc,
      right: content_hash_atom(value: id as NonEmptyStr),
    )
  )
}

fn subject_identity_for_projection(proj: RoadmapAuthorityProjection) -> Fnv1a64Structural {
  match proj {
    RoadmapAuthorityProjectionRefused { detail: detail } =>
      content_hash_tagged_structural(
        tag: "roadmap-site-surface-subject-refused/v1" as NonEmptyStr,
        payload: content_hash_atom(value: detail as NonEmptyStr),
      )
    RoadmapAuthorityProjected { doc: _, accepted: accepted, withheld: _ } =>
      content_hash_combine_structural(
        left: acceptance_identity_from_accepted(accepted: accepted),
        right: content_hash_combine_structural(
          left: site_artifact_digest(body: expected_roadmap_md_for_projection(proj: proj)),
          right: site_artifact_digest(body: roadmap_dispatch_file_content_for_projection(proj: proj)),
        ),
      )
  }
}

fn bundle_identity_from_artifacts(
  dispatch: RoadmapSiteSurfaceArtifact,
  daily: RoadmapSiteSurfaceArtifact,
  dispatch_js: RoadmapSiteSurfaceArtifact,
) -> Fnv1a64Structural {
  fold(
    [dispatch.digest, daily.digest, dispatch_js.digest],
    init: content_hash_atom(value: "roadmap-site-surface-bundle/v1" as NonEmptyStr),
    f: (acc, digest) => content_hash_combine_structural(left: acc, right: digest),
  )
}

fn render_roadmap_site_surface_bundle_for_projection(proj: RoadmapAuthorityProjection) -> RoadmapSiteSurfaceBundle {
  let subject_identity = subject_identity_for_projection(proj: proj)
  let producer_identity = roadmap_site_surface_producer_identity()
  let dispatch_body = roadmap_dispatch_file_content_for_projection(proj: proj)
  let daily_body = served_page_body(
    page: roadmap_daily_workspace_page_for_projection_observed(
      proj: proj,
      attempts: [],
      attempts_refused: none,
      standings: StandingsUnobserved { reason: "site surface observation renders the static page and does not consult the event carrier" },
      launch: launch_host_unobserved_static_render(),
      profiles: [],
    )
  )
  let js_body = dispatch_client_js_source()
  let dispatch = RoadmapSiteSurfaceArtifact {
    url_path: roadmap_site_dispatch_url_path,
    body: dispatch_body,
    digest: site_artifact_digest(body: dispatch_body),
  }
  let daily = RoadmapSiteSurfaceArtifact {
    url_path: roadmap_site_daily_url_path,
    body: daily_body,
    digest: site_artifact_digest(body: daily_body),
  }
  let dispatch_js = RoadmapSiteSurfaceArtifact {
    url_path: roadmap_dispatch_asset_path as NonEmptyStr,
    body: js_body,
    digest: site_artifact_digest(body: js_body),
  }
  RoadmapSiteSurfaceBundle {
    subject_identity: subject_identity,
    producer_identity: producer_identity,
    bundle_identity: bundle_identity_from_artifacts(
      dispatch: dispatch,
      daily: daily,
      dispatch_js: dispatch_js,
    ),
    dispatch_json: dispatch,
    daily_html: daily,
    dispatch_js: dispatch_js,
    healthz_body: healthz_body_from_surface_artifacts(
      dispatch: dispatch,
      daily: daily,
      dispatch_js: dispatch_js,
    ),
  }
}

// THE SERVE-SIDE RENDERER. This renders the bytes the process actually serves — its own healthz body and
// served-surface digests — and is correct for that: the serving process IS the authority, so it reads its
// own roster and emits what it has. It is NOT for minting an expectation: a caller that will compare an
// identity across the CI/host boundary must call `roadmap_site_surface_bundle_observation` (or the
// *_of_layout fold) so a refused roster read becomes a typed refusal instead of a fabricated identity. The
// two surviving serve-only callers (roadmap_static_site's healthz body / served-surface digest, and
// roadmap_site_healthz_validate's fresh-body currentness check) render the OBSERVED side, not an expected
// one; if either ever gains an expectation-minting use, the trigger is exactly that, and it moves onto the
// observation. (gunbc.recurring_failure_mode
// readback_expectation_rendered_over_a_refused_read_under_the_wrong_principal.)
fn materialize_live_roadmap_site_surface_bundle() -> RoadmapSiteSurfaceBundle {
  render_roadmap_site_surface_bundle_for_projection(proj: roadmap_plan_projection())
}

fn live_roadmap_site_surface_bundle() -> LiveRoadmapSiteSurfaceBundle {
  LiveRoadmapSiteSurfaceBundle {
    subject: roadmap_site_surface_subject,
    bundle: materialize_live_roadmap_site_surface_bundle(),
  }
}

// A FAILED ROSTER READ IS NOT A SURFACE. `render_roadmap_site_surface_bundle_for_projection` renders a bundle
// over ANY projection, and `subject_identity_for_projection` gives a refused projection its own tagged identity
// — so minting a bundle_identity from `RoadmapAuthorityProjectionRefused` fabricates an expectation the live
// service (which reads the real roster and renders a DIFFERENT identity) can never meet. That is the fail-open
// the srv1 cutover gate caught as a deterministic ProcessSurfaceMismatch. This observation folds the plan read
// exactly once (gunbc.live_deploy.candidate_identity) and names the refusal INSTEAD of a bundle, so a caller that
// needs an expectation can refuse the candidate rather than mint a wrong one. A read that cannot be opened is a
// refusal, never an empty roster — the same law roadmap_retired_node_ids_load states one fold up.
type RoadmapSiteSurfaceBundleObservation
  = RoadmapSiteSurfaceBundleRendered { bundle: RoadmapSiteSurfaceBundle }
  | RoadmapSiteSurfaceBundleReadRefused { detail: String }

// Observe the site surface over the SRV1 INSTANCE carrier layout — the record the service/instance principal
// reads its own tree with (roadmap_event_carrier_layout_for_instance). For a caller running AS THE INSTANCE
// PRINCIPAL. The read reaches the log through the ATTACHED arm of the single read entry point; the fold over the
// projection is shared with the launcher arm (the _of_projection below), so both render the roster identically
// (gunbc.design_argument::root_generalization).
fn roadmap_site_surface_bundle_observation_of_layout(
  layout: RoadmapEventCarrierLayout,
) -> RoadmapSiteSurfaceBundleObservation {
  roadmap_site_surface_bundle_observation_of_projection(proj: roadmap_plan_projection_over_layout(layout: layout))
}

// Observe the site surface over the LAUNCHER's scoped layout (roadmap_event_carrier_ci_layout), which owns no
// worktree and reads origin's roadmap-events branch into a short-lived detached snapshot under the CI job's own
// principal. The projection fold is the SAME as the instance arm; only the read principal and layout differ
// (gunbc.design_argument::earliest_unjustified_boundary).
fn roadmap_site_surface_bundle_observation_of_scoped(
  scoped: RoadmapEventCarrierScopedLayout,
) -> RoadmapSiteSurfaceBundleObservation {
  roadmap_site_surface_bundle_observation_of_projection(proj: roadmap_plan_projection_over_scoped(scoped: scoped))
}

// THE SHARED SURFACE FOLD. A refused projection is a RoadmapSiteSurfaceBundleReadRefused — NEVER a bundle with a
// placeholder identity — so a caller can never mint an expected surface identity over a log nobody opened. A
// projected roster renders the one site bundle. This fold is reached identically from the instance record path and
// the launcher scoped path, so the two render the same roster over the same event set.
fn roadmap_site_surface_bundle_observation_of_projection(
  proj: RoadmapAuthorityProjection,
) -> RoadmapSiteSurfaceBundleObservation {
  match proj {
    RoadmapAuthorityProjectionRefused { detail: detail } =>
      RoadmapSiteSurfaceBundleReadRefused { detail: detail }
    RoadmapAuthorityProjected { doc: _, accepted: _, withheld: _ } =>
      RoadmapSiteSurfaceBundleRendered { bundle: render_roadmap_site_surface_bundle_for_projection(proj: proj) }
  }
}

// THE SERVICE / INSTANCE observation: reads through the instance layout (/opt/gunbc, the service principal's
// tree) — the authority the live service renders from. For a caller that runs AS THE INSTANCE PRINCIPAL and reads
// its own tree: the belt serve gate (roadmap_belt_tick_cli, run under the belt service's principal/slice/spawn
// root) and the healthz_validate comparison. It returns the same bundle the old
// `materialize_live_roadmap_site_surface_bundle` returned whenever the read opens, and a TYPED REFUSAL instead of a
// fabricated identity when it does not. A caller that runs in the CI DEPLOY JOB (the candidate, the cutover
// readiness gate, the launch receipt CI step) must NOT use this — the runner cannot open the instance tree, and
// reading it there just moves the failure to a typed refusal. Those call
// `roadmap_site_surface_bundle_observation_for_launcher` below. Same fold, same law; the layout is chosen by which
// principal actually runs the read (gunbc.design_argument::earliest_unjustified_boundary).
fn roadmap_site_surface_bundle_observation() -> RoadmapSiteSurfaceBundleObservation {
  roadmap_site_surface_bundle_observation_of_layout(
    layout: roadmap_event_carrier_layout_for_instance(instance: srv1_live_dashboard_instance()),
  )
}

// Observe the site surface over the LAUNCHER (CI-runner) carrier layout — for every expectation-minting site
// that runs in the fleet-converge DEPLOY JOB as the runner principal (ghrunner) inside the job's own checkout:
// the candidate (gunbc.live_deploy.candidate), the cutover readiness gate (gunbc.live_deploy.readiness) and the
// launch receipt step (roadmap_launch_deployment_cli). The runner cannot open the instance tree (briansrls-
// owned), so it reads the SAME authority the service renders from — origin's roadmap-events branch, which the
// service fetch+reset --hard onto on every read — into its own checkout, under the principal that owns that
// checkout. The candidate, the readiness gate and the launch step therefore share ONE layout for the one
// roster question (roadmap_event_carrier_ci_layout: a RoadmapEventCarrierScopedLayout, repo_root = the runner
// checkout and NO worktree field — the scoped read owns a short-lived detached snapshot in its own scratch),
// which is the point — the readback expectation is derived under the same principal as the read it
// must match, not re-derived under a different one (gunbc.design_argument::earliest_unjustified_boundary,
// gunbc.recurring_failure_mode.readback_expectation_rendered_over_a_refused_read_under_the_wrong_principal).
fn roadmap_site_surface_bundle_observation_for_launcher() -> RoadmapSiteSurfaceBundleObservation {
  roadmap_site_surface_bundle_observation_of_scoped(
    scoped: roadmap_event_carrier_ci_layout(
      checkout_root: git.Inspect.Toplevel().path,
      instance_layout: roadmap_event_carrier_layout_for_instance(instance: srv1_live_dashboard_instance()),
    ),
  )
}
