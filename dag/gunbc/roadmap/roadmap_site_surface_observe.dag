module gunbc.roadmap.roadmap_site_surface_observe

import gunbc.roadmap.roadmap_runtime_plan { roadmap_plan_projection, roadmap_plan_projection_over_layout }
import gunbc.roadmap.roadmap_event_carrier { RoadmapEventCarrierLayout }
import gunbc.roadmap.roadmap_event_log { StandingsUnobserved }
import std.types { String, NonEmptyStr, List }
import std.content_hash { Fnv1a64Structural, content_hash_atom, content_hash_combine_structural, content_hash_tagged_structural }
import gunbc.roadmap.roadmap_authority {
 
  RoadmapAuthorityProjection,
  RoadmapAuthorityProjected,
  RoadmapAuthorityProjectionRefused,
  expected_roadmap_md_for_projection,
}
import gunbc.roadmap.roadmap_spawner { roadmap_dispatch_file_content_for_projection }
import gunbc.roadmap.roadmap_page {
  roadmap_daily_workspace_page_for_projection_observed,
}
import gunbc.roadmap.roadmap_launch_admission { launch_host_unobserved_static_render }
import gunbc.roadmap.roadmap_component { dispatch_client_js_source, roadmap_dispatch_asset_path }
import gunbc.roadmap.roadmap_model { RoadmapNodeId }
import gunbc.roadmap.roadmap_site_surface_types {
  RoadmapSiteSurfaceArtifact,
  RoadmapSiteSurfaceBundle,
  LiveRoadmapSiteSurfaceBundle,
  roadmap_site_surface_subject,
}
import gunbc.roadmap.roadmap_site_surface_render {
  roadmap_site_dispatch_url_path,
  roadmap_site_daily_url_path,
  site_artifact_digest,
  served_page_body,
  healthz_body_from_surface_artifacts,
}

// THE SOLE LIVE OBSERVATION AUTHORITY for roadmap served-surface materialization.
// materialize_live_roadmap_site_surface_bundle is the only entry that loads acceptance history and
// projects roadmap authority for site-surface rendering; downstream consumers evaluate
// gunbc.roadmap.roadmap_site_surface_expect predicates over the retained bundle.

// producer_identity names the observe/render implementation that produced a bundle, distinct from subject_identity (which roadmap snapshot) and bundle_identity (which rendered artifact population).
fn roadmap_site_surface_producer_identity() -> Fnv1a64Structural {
  content_hash_atom(value: "gunbc.roadmap_site_surface_observe/v1" as NonEmptyStr)
}

fn acceptance_identity_from_accepted(accepted: List<RoadmapNodeId>) -> Fnv1a64Structural {
  fold(accepted, init: content_hash_atom(value: "roadmap-acceptance-snapshot/v1" as NonEmptyStr), f: (acc, id) =>
    content_hash_combine_structural(
      left: acc,
      right: content_hash_atom(value: id as NonEmptyStr),
    )
  )
}

fn subject_identity_for_projection(proj: RoadmapAuthorityProjection) -> Fnv1a64Structural {
  match proj {
    RoadmapAuthorityProjectionRefused { detail: detail } =>
      content_hash_tagged_structural(
        tag: "roadmap-site-surface-subject-refused/v1" as NonEmptyStr,
        payload: content_hash_atom(value: detail as NonEmptyStr),
      )
    RoadmapAuthorityProjected { doc: _, accepted: accepted, withheld: _ } =>
      content_hash_combine_structural(
        left: acceptance_identity_from_accepted(accepted: accepted),
        right: content_hash_combine_structural(
          left: site_artifact_digest(body: expected_roadmap_md_for_projection(proj: proj)),
          right: site_artifact_digest(body: roadmap_dispatch_file_content_for_projection(proj: proj)),
        ),
      )
  }
}

fn bundle_identity_from_artifacts(
  dispatch: RoadmapSiteSurfaceArtifact,
  daily: RoadmapSiteSurfaceArtifact,
  dispatch_js: RoadmapSiteSurfaceArtifact,
) -> Fnv1a64Structural {
  fold(
    [dispatch.digest, daily.digest, dispatch_js.digest],
    init: content_hash_atom(value: "roadmap-site-surface-bundle/v1" as NonEmptyStr),
    f: (acc, digest) => content_hash_combine_structural(left: acc, right: digest),
  )
}

fn render_roadmap_site_surface_bundle_for_projection(proj: RoadmapAuthorityProjection) -> RoadmapSiteSurfaceBundle {
  let subject_identity = subject_identity_for_projection(proj: proj)
  let producer_identity = roadmap_site_surface_producer_identity()
  let dispatch_body = roadmap_dispatch_file_content_for_projection(proj: proj)
  let daily_body = served_page_body(
    page: roadmap_daily_workspace_page_for_projection_observed(
      proj: proj,
      attempts: [],
      attempts_refused: none,
      standings: StandingsUnobserved { reason: "site surface observation renders the static page and does not consult the event carrier" },
      launch: launch_host_unobserved_static_render(),
      profiles: [],
    )
  )
  let js_body = dispatch_client_js_source()
  let dispatch = RoadmapSiteSurfaceArtifact {
    url_path: roadmap_site_dispatch_url_path,
    body: dispatch_body,
    digest: site_artifact_digest(body: dispatch_body),
  }
  let daily = RoadmapSiteSurfaceArtifact {
    url_path: roadmap_site_daily_url_path,
    body: daily_body,
    digest: site_artifact_digest(body: daily_body),
  }
  let dispatch_js = RoadmapSiteSurfaceArtifact {
    url_path: roadmap_dispatch_asset_path as NonEmptyStr,
    body: js_body,
    digest: site_artifact_digest(body: js_body),
  }
  RoadmapSiteSurfaceBundle {
    subject_identity: subject_identity,
    producer_identity: producer_identity,
    bundle_identity: bundle_identity_from_artifacts(
      dispatch: dispatch,
      daily: daily,
      dispatch_js: dispatch_js,
    ),
    dispatch_json: dispatch,
    daily_html: daily,
    dispatch_js: dispatch_js,
    healthz_body: healthz_body_from_surface_artifacts(
      dispatch: dispatch,
      daily: daily,
      dispatch_js: dispatch_js,
    ),
  }
}

fn materialize_live_roadmap_site_surface_bundle() -> RoadmapSiteSurfaceBundle {
  render_roadmap_site_surface_bundle_for_projection(proj: roadmap_plan_projection())
}

fn live_roadmap_site_surface_bundle() -> LiveRoadmapSiteSurfaceBundle {
  LiveRoadmapSiteSurfaceBundle {
    subject: roadmap_site_surface_subject,
    bundle: materialize_live_roadmap_site_surface_bundle(),
  }
}

// A FAILED ROSTER READ IS NOT A SURFACE. `render_roadmap_site_surface_bundle_for_projection` renders a bundle
// over ANY projection, and `subject_identity_for_projection` gives a refused projection its own tagged identity
// — so minting a bundle_identity from `RoadmapAuthorityProjectionRefused` fabricates an expectation the live
// service (which reads the real roster and renders a DIFFERENT identity) can never meet. That is the fail-open
// the srv1 cutover gate caught as a deterministic ProcessSurfaceMismatch. This observation folds the plan read
// exactly once (gunbc.live_deploy.candidate_identity) and names the refusal INSTEAD of a bundle, so a caller that
// needs an expectation can refuse the candidate rather than mint a wrong one. A read that cannot be opened is a
// refusal, never an empty roster — the same law roadmap_retired_node_ids_load states one fold up.
type RoadmapSiteSurfaceBundleObservation
  = RoadmapSiteSurfaceBundleRendered { bundle: RoadmapSiteSurfaceBundle }
  | RoadmapSiteSurfaceBundleReadRefused { detail: String }

// Observe the site surface over a caller-supplied carrier layout — the single plan read, typed. Used by the
// live-deploy candidate (which reads origin's roadmap-events branch under the CI job's principal) and by the
// controls that exercise both arms deterministically.
fn roadmap_site_surface_bundle_observation_of_layout(
  layout: RoadmapEventCarrierLayout,
) -> RoadmapSiteSurfaceBundleObservation {
  let proj = roadmap_plan_projection_over_layout(layout: layout)
  match proj {
    RoadmapAuthorityProjectionRefused { detail: detail } =>
      RoadmapSiteSurfaceBundleReadRefused { detail: detail }
    RoadmapAuthorityProjected { doc: _, accepted: _, withheld: _ } =>
      RoadmapSiteSurfaceBundleRendered { bundle: render_roadmap_site_surface_bundle_for_projection(proj: proj) }
  }
}
