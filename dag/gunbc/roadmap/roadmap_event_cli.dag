// THE TWO LOADERS LIVE IN THE AUTHORITY, not in the carriers they read: they are the folds that resolve the
// one log through the same pinned instance every other production roadmap read names
// (roadmap_authority.dag:5091, 5100), and they are the reason a log that cannot be read is a typed refusal
// rather than an empty set. The TYPES are the carriers' own.
import gunbc.roadmap.roadmap_authority {
  roadmap_acceptance_event_history_load, roadmap_retired_node_ids_load,
}
import gunbc.roadmap.roadmap_acceptance_history_carrier { RoadmapAcceptanceEventHistoryLoad }
import gunbc.roadmap.roadmap_model {
  RoadmapAcceptanceEvent, RoadmapAcceptanceReceipt, RoadmapAcceptanceRevocationFacts,
  roadmap_acceptance_line_acceptance_receipt, roadmap_acceptance_line_revocation_facts,
  roadmap_node_ids_contain,
}
import gunbc.roadmap.roadmap_event_carrier {
  roadmap_event_carrier_layout_for_instance, roadmap_event_append, roadmap_events_read,
  EventAppended, EventAlreadyPresent, EventAppendRefused, EventsRead, EventsReadRefused,
  CarrierSnapshotClose, SnapshotNotOpened, SnapshotClosed, SnapshotCloseFailed,
  carrier_snapshot_close_failures, carrier_report_with_snapshot_close,
}

// THE ONE WRITER. A session, an operator or a harness worker records a fact about a node with
//   gunbc run --entry dag/gunbc/roadmap/roadmap_event_cli.dag --function roadmap_event_record_cli \
//     --arg repo_root=<instance repo> --arg node=<id> --arg kind=claim|release|progress|block|handback \
//     --arg text=<note or reason> --arg author=principal:<authority>/<namespace>/<subject>
// and reads a node's standing with roadmap_event_standing_cli. The instance is resolved from the
// repository root the caller stands in, exactly as the belt resolves its own, so the same command on
// srv1 and srv2 writes to the same shared branch and reads the same events. The parent of the new
// event is the current head of the node's history when there is exactly one; a fork or an incomplete
// history refuses the write, because recording on top of a state the writer could not read is how a
// fork becomes three. THE AUTHOR IS A PRINCIPAL, never an email (owner ruling 2026-09-25,
// docs/plans/human-identity-authorization.md): the CLI is a machine-writer seam, and --arg author
// must spell principal:.../.../... — a bare email refuses, because new v3 writes require an
// authenticated principal and a legacy email can only be DECODED from history, never minted. A CLI
// `claim` records the caller's principal as the assignee — a self-claim; assignment to ANOTHER
// principal is the served assign route's shape (POST /issue/<id>/assign), not the CLI's.
fn roadmap_event_kind_from_words(kind: String, text: String, author: EventPrincipal) -> RoadmapEventKind? {
  let t = trim(text)
  if kind == "claim" { Present { value: Claimed { assignee: author, return_to: author } } }
  else if kind == "release" { Present { value: Released } }
  else if kind == "progress" { if t == "" { none } else { Present { value: Progress { note: t as NonEmptyStr } } } }
  else if kind == "block" { if t == "" { none } else { Present { value: Blocked { reason: t as NonEmptyStr } } } }
  else if kind == "handback" { if t == "" { none } else { Present { value: HandedBack { reason: t as NonEmptyStr } } } }
  // RETIREMENT, FROM THE ONE WRITER. A node's retirement is an event like any other and the CLI is the
  // route a session or an operator reaches for; the append route beneath it is what refuses to record
  // it twice or after the node has been accepted (gunbc.roadmap.roadmap_event_carrier
  // roadmap_retirement_append_admitted_after).
  else if kind == "retire" { if t == "" { none } else { Present { value: Retired { reason: t as NonEmptyStr } } } }
  else { none }
}

fn roadmap_event_record_unordered_refusal(why: String) -> String {
  join(["roadmap_event_record_cli: refusing to record on a history that cannot be ordered: ", why], "")
}

// THE RECORD'S EXIT BESIDE THE SNAPSHOTS IT OWNED. A refusal already carries text, so a snapshot
// left behind is stated after the refusal's own reason. A recorded event stays ExitSuccess: the
// exit IS the append's result, ExitSuccess carries no text, and a nonzero exit would tell a caller
// the event was not recorded when it was -- a retry would then append a second event. So on success
// this entry has no surface for a leaked snapshot, each standing is matched by name to say so, and
// that failure itself is recorded nowhere; a snapshot left registered is listed by the instance's
// snapshot census (gunbc.roadmap.roadmap_event_snapshot_census roadmap_snapshot_census_for_instance).
fn roadmap_event_record_exit(exit: ProcessExit, closes: List<CarrierSnapshotClose>) -> ProcessExit {
  match exit {
    ExitFailure { code, reason } => ExitFailure { code: code, reason: join(concat([reason], carrier_snapshot_close_failures(closes: closes)), "; ") }
    ExitSuccess => fold(closes, init: ExitSuccess, f: (acc, c) => match c {
      SnapshotNotOpened => acc
      SnapshotClosed => acc
      SnapshotCloseFailed { worktree: _, exit_code: _, stderr: _ } => acc
    })
  }
}

fn roadmap_event_record_cli(repo_root: String, node: String, kind: String, text: String, author: String) -> ProcessExit {
  match dashboard_instance_for_repo_root(repo_root: repo_root) {
    DashboardInstanceRootUnknown { repo_root: w } => ExitFailure { code: 1, reason: join(["roadmap_event_record_cli: no dashboard instance is rooted at ", w], "") }
    DashboardInstanceResolved { instance } =>
      match principal_ref_parse_label(s: author) {
        Absent => ExitFailure { code: 1, reason: join(["roadmap_event_record_cli: author must be an authenticated principal spelling principal:<authority>/<namespace>/<subject>; got '", author, "' (a bare email can only be read from history, never written)"], "") }
        Present { value: author_ref } => {
          let author_principal = EventPrincipalAuthenticated { ref: author_ref }
          match roadmap_event_kind_from_words(kind: kind, text: text, author: author_principal) {
            Absent => ExitFailure { code: 1, reason: join(["roadmap_event_record_cli: kind must be claim|release|progress|block|handback|retire, and progress/block/handback/retire need text; got kind=", kind], "") }
            Present { value: k } => {
              let layout = roadmap_event_carrier_layout_for_instance(instance: instance)
          let node_id = node as NonEmptyStr as RoadmapNodeId
          let history = roadmap_events_read(layout: layout, node: node_id)
          match history.result {
            EventsReadRefused { node: _, step, reason } => roadmap_event_record_exit(
              exit: ExitFailure { code: 1, reason: join(["roadmap_event_record_cli: could not read the node's history (", step, "): ", reason], "") },
              closes: [history.close])
            EventsRead { node: _, envelopes } => {
              match roadmap_history_unordered_reason(envs: envelopes) {
                Present { value: why } => roadmap_event_record_exit(exit: ExitFailure { code: 1, reason: roadmap_event_record_unordered_refusal(why: why) }, closes: [history.close])
                Absent => {
                let heads = filter(envelopes, e => !any(envelopes, o => match o.event.parent { Present { value: p } => (p as String) == (e.id as String)  Absent => false }))
                let parent = match heads.first() { Present { value: h } => Present { value: h.id }  Absent => none }
                let at = match clock_now_probed_at() { Present { value: t } => t as String  Absent => "" }
                // THE RETIREMENT IS AN OPERATION, THE OTHER KINDS ARE NOT (yet). Retirement is terminal,
                // so its key can be the fact itself and a retried command answers the first recording
                // instead of appending; claim/progress/block/handback are not terminal, and giving them
                // the same key would refuse an operator's SECOND deliberate posting of the same note.
                let operation = match k {
                  Retired { reason } => roadmap_retirement_operation_identity(node: node, reason: reason as String)
                  _ => ""
                }
                let appended = roadmap_event_append(layout: layout, event: RoadmapEvent { node: node_id, author: author_principal, parent: parent, kind: k, recorded_at: at }, operation: operation)
                roadmap_event_record_exit(
                  exit: match appended.result {
                    EventAppended { id } => ExitSuccess
                    EventAlreadyPresent { id } => ExitSuccess
                    EventAppendRefused { id: _, step, reason } => ExitFailure { code: 1, reason: join(["roadmap_event_record_cli: append refused at ", step, ": ", reason], "") }
                  },
                  closes: [history.close, appended.close])
              }
              }
            }
          }
        }
      }
    }
      }
  }
}

// THE OPERATOR'S ACCEPTANCE, RECORDED AS AN EVENT. The acceptance of a node is not conversation and it
// is not an assignment: it is the operator's verdict, and since 2026-11-09 it lives in the same
// append-only event log every other node fact lives in
// (gunbc.design_ruling::plans_reset_and_audit_recommendations_2026_11_08). The caller passes the receipt
// line the operator law spells (gunbc.roadmap.roadmap_operator_acceptance
// roadmap_operator_acceptance_receipt_line) and the review thread the acceptance closed on; THE NODE IS
// THE RECEIPT'S OWN NODE, never an argument that could disagree with it, and the route beneath refuses a
// receipt that names another node. A line the operator law refuses is refused here, before any write.
//
//   gunbc run --entry dag/gunbc/roadmap/roadmap_event_cli.dag --function roadmap_acceptance_record_cli \
//     --arg repo_root=<instance repo> --arg receipt_line=<acceptance line> \
//     --arg pr_url=<review thread> --arg merged_at=<merge time> --arg head_sha=<head at merge> \
//     --arg author=principal:<authority>/<namespace>/<subject>
//
// THE THREE PULL-REQUEST ARGUMENTS ARE ONE FACT OR NOTHING. An acceptance earned now names the review
// thread that earned it, its merge time and its head. Passing NOTHING for all three records an acceptance
// that never had a pull request — which is admitted only for a receipt the one-time migration carried
// (gunbc.roadmap.roadmap_event_log roadmap_migration_acceptance_identities), because that is what the
// hand-committed seed holds and nothing else; a claimed date used to be the test, and a date is something
// whoever runs the command types. HALF a triple is refused HERE, at the command line, naming how many of
// the three arrived (roadmap_acceptance_pr_evidence_from_args); an absence that is not one of the
// migration's own receipts is refused at the route
// (gunbc.roadmap.roadmap_issue_command issue_command_acceptance_evidence_law). Witnessed by
// half_a_pull_request_is_refused_where_the_arguments_are_read and
// the_absence_of_a_pull_request_is_admitted_only_for_a_migration_receipt, in
// dag/test/claim/roadmap/roadmap_acceptance_evidence_witness.dag.
fn roadmap_acceptance_record_cli(repo_root: String, receipt_line: String, pr_url: String, merged_at: String, head_sha: String, author: String) -> ProcessExit {
  match roadmap_acceptance_line_of(text: receipt_line) {
    Absent => ExitFailure { code: 1, reason: "roadmap_acceptance_record_cli: the receipt line is refused: it must be an acceptance line spelled exactly as the operator law spells one, naming the live receipt, its red control, and its handback" }
    Present { value: line } => match roadmap_acceptance_line_acceptance_receipt(line: line) {
      Absent => ExitFailure { code: 1, reason: "roadmap_acceptance_record_cli: only an acceptance line is written by this route; a revocation is written by roadmap_acceptance_revoke_cli" }
      Present { value: receipt } => {
        // THE COMMAND LINE IS THE UNTYPED EDGE, so this is where half a pull request dies. Three arguments
        // arrive; they either spell the whole fact, spell its absence, or are refused here with the count
        // they carried — past this line the evidence is one typed fact
        // (gunbc.roadmap.roadmap_event_log AcceptancePrEvidence) and no downstream check has to wonder.
        let carried = count(filter([pr_url, merged_at, head_sha], v => v != ""))
        match roadmap_acceptance_pr_evidence_from_args(url: pr_url, at: merged_at, sha: head_sha) {
          Absent => ExitFailure { code: 1, reason: join([
            "roadmap_acceptance_record_cli: the pull request an acceptance was earned by is one fact — its url, its merge time and its head arrive together, or none of them; this command carried ",
            to_string(value: carried), " of the three"], "") }
          Present { value: evidence } => roadmap_acceptance_command(
            repo_root: repo_root, author: author, node: receipt.node as String, who: "roadmap_acceptance_record_cli",
            choice: BuildAcceptCommand { receipt: receipt, evidence: evidence })
        }
      }
    }
  }
}

// THE SAME RECEIPT, UNDONE. The caller passes the operator law's REVOCATION line — the form that already
// names the exact acceptance it withdraws, the reason, and the standing the node returns to. The
// disposition is READ from the line and never defaulted, and the append route beneath refuses the write
// unless the receipt named is that node's live acceptance
// (gunbc.roadmap.roadmap_event_log roadmap_revocation_names_live_acceptance).
//
//   gunbc run --entry dag/gunbc/roadmap/roadmap_event_cli.dag --function roadmap_acceptance_revoke_cli \
//     --arg repo_root=<instance repo> --arg revocation_line=<revocation line> \
//     --arg author=principal:<authority>/<namespace>/<subject>
fn roadmap_acceptance_revoke_cli(repo_root: String, revocation_line: String, author: String) -> ProcessExit {
  match roadmap_acceptance_line_of(text: revocation_line) {
    Absent => ExitFailure { code: 1, reason: "roadmap_acceptance_revoke_cli: the revocation line is refused: it must name the exact acceptance it withdraws — the same node, the same criteria digest, the same red control and handback — with its reason and its disposition" }
    Present { value: line } => match roadmap_acceptance_line_revocation_facts(line: line) {
      Absent => ExitFailure { code: 1, reason: "roadmap_acceptance_revoke_cli: only a revocation line is written by this route; an acceptance is written by roadmap_acceptance_record_cli" }
      Present { value: facts } => roadmap_acceptance_command(
        repo_root: repo_root, author: author, node: facts.receipt.node as String, who: "roadmap_acceptance_revoke_cli",
        choice: BuildRevokeCommand { facts: facts })
    }
  }
}

// WHICH COMMAND THE ROUTE IS ASKING FOR, named by data rather than by a half-built command: the subject
// the route beneath supplies (it is the one that knows the chain's head), and the acceptance facts the
// operator's line carried.
type AcceptanceCommandChoice
  = BuildAcceptCommand { receipt: RoadmapAcceptanceReceipt, evidence: AcceptancePrEvidence }
  | BuildRevokeCommand { facts: RoadmapAcceptanceRevocationFacts }

// THE OPERATION IDENTITY IS THE FACT, NOT THE NODE. The carrier keeps an operation create-once, so an
// identity naming only the node would let a node be accepted ONCE IN ITS LIFE: the acceptance and the
// revocation that later takes it back (and any re-acceptance on new criteria) would collide at
// operations/<node>/<operation>.json and the second command would be refused for a collision that is not
// a duplicate of anything. The identity is the node, the KIND of fact, and the digest of the receipt it
// acts on — stable, so retrying the same command is the same operation and replays instead of writing
// twice, and distinct, so a revocation is never mistaken for the acceptance it revokes
// (witness: acceptance_then_revocation_of_one_node_are_two_operations).
fn roadmap_acceptance_operation_identity(node: String, choice: AcceptanceCommandChoice) -> String {
  match choice {
    BuildAcceptCommand { receipt, evidence: _ } =>
      join([node, "-acceptance-", roadmap_acceptance_receipt_digest_text(receipt: receipt)], "")
    BuildRevokeCommand { facts } =>
      join([node, "-revocation-", roadmap_acceptance_receipt_digest_text(receipt: facts.receipt)], "")
  }
}

// The receipt's own digest, in the hex text the member law already writes into the event.
fn roadmap_acceptance_receipt_digest_text(receipt: RoadmapAcceptanceReceipt) -> String {
  serialize_content_hash(hash: Fnv1a64(receipt.criteria_digest)) as String
}

// THE RETIREMENT'S OPERATION KEY IS ITS FACT: the node, the word "retirement", and the digest of the
// reason the principal gave — an identity the CLI can recompute, so a retried retirement meets its own
// operation receipt and answers the first recording (EventAlreadyPresent) instead of appending a second
// event or colliding; a DIFFERENT retirement of the same node is a different key, and the admission law
// refuses it outright, because a node already retired has no change left to name. Witnessed by
// a_retired_node_is_retired_once_because_its_key_is_the_reason_not_the_call, in
// test.claim.roadmap.roadmap_acceptance_evidence_witness, with the replay and the outright refusal
// themselves exercised by `issue_command_acceptance_wet` in test.manual.issue_command_wet.
fn roadmap_retirement_operation_identity(node: String, reason: String) -> String {
  join([node, "-retirement-", content_hash_atom(value: reason as NonEmptyStr).digest as String], "")
}

fn roadmap_acceptance_built_command(subject: IssueCommandSubject, choice: AcceptanceCommandChoice) -> IssueCommand {
  match choice {
    BuildAcceptCommand { receipt, evidence } => AcceptNode {
      subject: subject, receipt: receipt, evidence: evidence }
    BuildRevokeCommand { facts } => RevokeAcceptance {
      subject: subject, receipt: facts.receipt, disposition: facts.disposition,
      revoked_by: facts.revoked_by, revoked_on: facts.revoked_on, reason: facts.reason }
  }
}

// ONE LINE, PARSED BY THE OPERATOR LAW ITSELF. The line is the operator's record; the native seed parser
// is its only parser and this route adds no grammar of its own.
fn roadmap_acceptance_line_of(text: String) -> RoadmapAcceptanceEvent? {
  match roadmap_operator_acceptance_parse_tail(lines: [text]) {
    RoadmapAcceptanceTailOk { events: events } => events.first()
    RoadmapAcceptanceTailBad { line_index: _, detail: _ } => none
  }
}

// BOTH ROUTES BUILD THE SAME COMMAND OVER THE SAME ROUTE: name the instance, read its history, refuse to
// write on one that cannot be ordered, and hand the command to gunbc.roadmap.roadmap_issue_command
// issue_command_apply — the same route that assigns an issue or retires a node, so acceptance is an
// event like any other and there is no second writer to keep honest.
fn roadmap_acceptance_command(repo_root: String, author: String, node: String, who: String, choice: AcceptanceCommandChoice) -> ProcessExit {
  match dashboard_instance_for_repo_root(repo_root: repo_root) {
    DashboardInstanceRootUnknown { repo_root: w } => ExitFailure { code: 1, reason: join([who, ": no dashboard instance is rooted at ", w], "") }
    DashboardInstanceResolved { instance } =>
      match principal_ref_parse_label(s: author) {
        Absent => ExitFailure { code: 1, reason: join([who, ": author must be an authenticated principal spelling principal:<authority>/<namespace>/<subject>; got '", author, "' (a bare email can only be read from history, never written)"], "") }
        Present { value: author_ref } => {
          let layout = roadmap_event_carrier_layout_for_instance(instance: instance)
          let node_id = node as NonEmptyStr as RoadmapNodeId
          let history = roadmap_events_read(layout: layout, node: node_id)
          match history.result {
            EventsReadRefused { node: _, step, reason } => ExitFailure { code: 1, reason: join([who, ": could not read the node's history (", step, "): ", reason], "") }
            EventsRead { node: _, envelopes } =>
              match roadmap_history_unordered_reason(envs: envelopes) {
                Present { value: why } => ExitFailure { code: 1, reason: join([who, ": the node's history cannot be ordered, so nothing is written: ", why], "") }
                Absent => {
                  let heads = filter(envelopes, e => !any(envelopes, o => match o.event.parent { Present { value: p } => (p as String) == (e.id as String)  Absent => false }))
                  let expected = match heads.first() { Present { value: h } => Present { value: h.id }  Absent => none }
                  let subject = IssueCommandSubject {
                    node: node_id,
                    author: EventPrincipalAuthenticated { ref: author_ref },
                    // NOT `node`: see roadmap_acceptance_operation_identity — an operation named for the
                    // node alone would let a node be accepted exactly once in its life.
                    operation: roadmap_acceptance_operation_identity(node: node, choice: choice) as NonEmptyStr,
                    expected: expected,
                  }
                  let applied = issue_command_apply(layout: layout, command: roadmap_acceptance_built_command(subject: subject, choice: choice), recorded_at: match clock_now_probed_at() { Present { value: t } => t as String  Absent => "" })
                  roadmap_event_record_exit(
                    exit: match applied.result {
                      EventAppended { id: _ } => ExitSuccess
                      EventAlreadyPresent { id: _ } => ExitSuccess
                      EventAppendRefused { id: _, step, reason } => ExitFailure { code: 1, reason: join([who, ": append refused at ", step, ": ", reason], "") }
                    },
                    closes: [history.close, applied.close])
                }
              }
          }
        }
      }
  }
}

// THE STANDING IS A REPORT, SO IT IS A STRING: `gunbc run` prints a String return inside its typed
// envelope, which is the sanctioned way to read a value out of a run (a ProcessExit carries no
// stdout, and an ExitFailure with code 0 is refused by the host as a status that contradicts itself).
fn roadmap_event_standing_report(repo_root: String, node: String) -> String {
  match dashboard_instance_for_repo_root(repo_root: repo_root) {
    DashboardInstanceRootUnknown { repo_root: w } => join(["roadmap_event_standing_report: no dashboard instance is rooted at ", w], "")
    DashboardInstanceResolved { instance } => {
      let history = roadmap_events_read(layout: roadmap_event_carrier_layout_for_instance(instance: instance), node: node as NonEmptyStr as RoadmapNodeId)
      carrier_report_with_snapshot_close(
        text: match history.result {
          EventsReadRefused { node: _, step, reason } => join(["roadmap_event_standing_report: read refused at ", step, ": ", reason], "")
          EventsRead { node: _, envelopes } => join([node, ": ", roadmap_node_standing_text(s: roadmap_node_standing(envs: envelopes)), " (", to_string(value: count(envelopes)), " events)"], "")
        },
        close: history.close)
    }
  }
}

// THE READ-BACK DOORS, for the live migration's verification and rollback steps. `gunbc run` refuses
// an entry whose function does not return ProcessExit (src/v1/stage0/src/cli_run.rs: "function
// returned `X`, not ProcessExit"), and the three facts the cutover is gated on are DATA, not exits —
// their authorities return them to the page (`roadmap_retired_node_ids_load`,
// `roadmap_acceptance_event_history_load`, `roadmap_acceptance_migration_verify`), and narrowing a
// production authority to an exit shape to make it runnable would bend the reader to the runner.
// So these entries stand beside them and add NOTHING to what is decided: each asks the SAME reader
// production asks, through the same pinned instance, and turns its verdict into the exit the runbook
// gates on. They decide by MATCHING the coproduct each reader returns — never by searching the words that
// rendering happens to use (review 93664 on gunb-ai/gunbc#16189; gunbc.design_argument::fail_closed:
// "a typecheck and a `.contains()` grep are not consumers"). A ProcessExit has no stdout to name a fact
// in, so — the convention every wet entry here already follows — exit 0 says the fact is admitted as
// expected, and a refusal exits 1 carrying the reason the reader named, which the runtime prints.
//
//   gunbc run --source-root dag --source-root src/v2 --entry dag/gunbc/roadmap/roadmap_event_cli.dag \
//     --function roadmap_event_log_retired_report_cli
//   gunbc run --source-root dag --source-root src/v2 --entry dag/gunbc/roadmap/roadmap_event_cli.dag \
//     --function roadmap_event_log_acceptance_report_cli
//   gunbc run --source-root dag --source-root src/v2 --entry dag/gunbc/roadmap/roadmap_event_cli.dag \
//     --function roadmap_acceptance_migration_verify_cli --arg repo_root=<instance repo> \
//     --arg expected_manifest="$(cat $D/manifest.jsonl)" --arg retired_roster="$(cat $D/retired.jsonl)"

// WHY A READ-BACK IS NOT ADMITTED, AS DATA. Review 93664 on gunb-ai/gunbc#16189 took out the doors that
// decided by searching their own wording ("a typecheck and a `.contains()` grep are not consumers" —
// gunbc.design_argument::fail_closed); what remains decides by MATCHING the sums the readers already
// return, once each, here. The answer is the list of readers that refused, each named by the reason it
// itself gave. The empty list is the only admitted answer, so a reader that cannot answer is never
// silently missing from the list (gunbc.design_argument::fail_closed: "a failure arm refuses, never
// widens"). roadmap_acceptance_migration_verify_cli and roadmap_event_log_read_back_cli exit 0 exactly
// when this is empty, and the claim population in
// dag/test/claim/roadmap/roadmap_receipt_continuity_acceptance.dag holds one arm at a time.
fn roadmap_read_back_refusals(
  migration: RoadmapAcceptanceMigrationOutcome, retired: RoadmapRetiredNodeIds,
  history: RoadmapAcceptanceEventHistoryLoad, wrote: Bool
) -> List<String> {
  concat(
    match migration {
      MigrationVerified {
        manifest_events: _, accepted_events: _, revoked_events: _,
        retired_named: _, held_events: _, event_lines: _
      } => []
      MigrationRefused { cause } => [join(["migration verifier: ",
        roadmap_acceptance_migration_refusal_report(cause: cause)], "")]
    },
    concat(
      match retired {
        RetiredNodeIdsLoaded { ids: _ } => []
        RetiredNodeIdsRefused { detail } => [join([
          "retired read: the one event log refused its retired set — ", detail as String,
          "; an unreadable log is never an empty retired set"], "")]
      },
      concat(
        match history {
          RoadmapAcceptanceEventHistoryLoaded { events: _ } => []
          RoadmapAcceptanceEventHistoryLoadRefused { detail } => [join([
            "acceptance history: the one event log refused its acceptance history — ", detail,
            "; the page that stands on this reader would be serving no accepted work at all"], "")]
        },
        if wrote { [] } else { ["read-back document: the write to the report path did not succeed"] }
      )
    )
  )
}

fn roadmap_event_log_retired_report_cli() -> ProcessExit {
  match roadmap_retired_node_ids_load() {
    RetiredNodeIdsLoaded { ids: _ } => ExitSuccess
    RetiredNodeIdsRefused { detail } => ExitFailure {
      code: 1,
      reason: join([
        "roadmap_event_log_retired_report_cli: the one event log refused its retired set — ",
        detail as String,
        "; an unreadable log is never an empty retired set, so this is a refusal and not a plan without retirements"], "") }
  }
}

fn roadmap_event_log_acceptance_report_cli() -> ProcessExit {
  match roadmap_acceptance_event_history_load() {
    RoadmapAcceptanceEventHistoryLoaded { events: _ } => ExitSuccess
    RoadmapAcceptanceEventHistoryLoadRefused { detail } => ExitFailure {
      code: 1,
      reason: join([
        "roadmap_event_log_acceptance_report_cli: the one event log refused its acceptance history — ",
        detail,
        "; the page that stands on this reader would be serving no accepted work at all"], "") }
  }
}

fn roadmap_acceptance_migration_verify_cli(
  repo_root: String, expected_manifest: String, retired_roster: String
) -> ProcessExit {
  match roadmap_acceptance_migration_verify(
    repo_root: repo_root, expected_manifest: expected_manifest, retired_roster: retired_roster) {
    MigrationVerified {
      manifest_events: _, accepted_events: _, revoked_events: _,
      retired_named: _, held_events: _, event_lines: _
    } => ExitSuccess
    MigrationRefused { cause } => ExitFailure {
      code: 1,
      reason: join(["roadmap_acceptance_migration_verify_cli: ",
        roadmap_acceptance_migration_refusal_report(cause: cause)], "") }
  }
}

// ALL THREE FACTS AT ONCE, WRITTEN WHERE THE PR CAN QUOTE IT. A ProcessExit carries no stdout, so an exit
// code alone cannot be a read-back RECEIPT (protocol: read back through the reader production uses and SHOW
// the result). This entry asks the same three readers the page asks — the migration verifier, the fail-closed
// retired read, the acceptance-history reader — plus the per-node standing sentence for each name in the
// retired roster, composes what they said into one document, writes it through the modeled
// Filesystem.Write, and exits 0 only when every part was admitted AND the document was actually written. A
// refusal exits 1 carrying the whole document in its reason, so the failing read-back is still legible.
// Nothing here decides anything: each part is the reader's own answer, the four matches that turn an answer
// into a refusal live in roadmap_read_back_refusals (one per reader, once), and the composition is claimed
// (dag/test/claim/roadmap/roadmap_receipt_continuity_acceptance.dag) to refuse when any single part refuses.
//
//   gunbc run --source-root dag --source-root src/v2 --entry dag/gunbc/roadmap/roadmap_event_cli.dag \
//     --function roadmap_event_log_read_back_cli --arg repo_root=/opt/gunbc/gunbc \
//     --arg expected_manifest="$MANIFEST" --arg retired_roster=<a>,<b> --arg report_path=$D/read-back.out
fn roadmap_event_log_read_back_cli(
  repo_root: String, expected_manifest: String, retired_roster: String, report_path: String
) -> ProcessExit {
  let verdict = roadmap_acceptance_migration_verify(
    repo_root: repo_root, expected_manifest: expected_manifest, retired_roster: retired_roster)
  let retired = roadmap_retired_node_ids_load()
  let history = roadmap_acceptance_event_history_load()
  let standings = map(
    filter(split(s: retired_roster, delimiter: ","), n => trim(n) != ""),
    n => roadmap_event_standing_report(repo_root: repo_root, node: trim(n)))
  let document = join([
    "READ-BACK for repo_root ", repo_root, " (the readers production itself asks)\n",
    // The verdict reaches the document through its RENDERING only; the exit above is decided by matching the
    // outcome. Same words the runbook quotes, and rewording them could not change which read-backs are admitted.
    "MIGRATION VERDICT:\n", roadmap_acceptance_migration_report(outcome: verdict), "\n",
    "RETIRED SET: ", match retired {
      RetiredNodeIdsLoaded { ids: _ } => "admitted by the fail-closed retired read",
      RetiredNodeIdsRefused { detail } => join(["REFUSED — ", detail as String, " (a refusal, never an empty set)"], "") }, "\n",
    "ACCEPTANCE HISTORY: ", match history {
      RoadmapAcceptanceEventHistoryLoaded { events: _ } => "admitted by the one decoder of the one home",
      RoadmapAcceptanceEventHistoryLoadRefused { detail } => join(["REFUSED — ", detail], "") }, "\n",
    "STANDINGS (one sentence per retired node, as the log's standing renders it):\n",
    join(standings, "\n"), "\n"], "")
  let wrote = Filesystem.Write(path: report_path, content: document)
  let refusals = roadmap_read_back_refusals(
    migration: verdict, retired: retired, history: history, wrote: wrote.success)
  if count(refusals) == 0 {
    ExitSuccess
  } else {
    ExitFailure {
      code: 1,
      reason: join([
        "roadmap_event_log_read_back_cli: the read-back REFUSED at ", report_path,
        " — ", to_string(value: count(refusals)), " reader(s) refused:",
        join(map(refusals, r => join(["\n  ", r], "")), ""),
        " (write error: ", wrote.error,
        "); the document below is what the readers answered — a partial read is never quoted as a migration that completed:\n", document], "") }
  }
}

// ─────────────────────────────────────────────────────────────────────────────────────────────
// THE PRE-WRITE REFUSAL FOR THE ONE-TIME CUTOVER
// (docs/runbooks/roadmap-event-log-cutover.md, step `precheck`; operator ruling
// gunbc.design_ruling::plans_reset_and_audit_recommendations_2026_11_08).
//
// WHY THIS EXISTS. The cutover appends facts the log does not yet hold: five RetiredEvents and the
// seventeen operator acceptances plus its one revocation. Appending any of them a SECOND time is not
// harmless — a second RetiredEvent on a chain is a second terminal event the replay folds, and a
// duplicated acceptance is a receipt the audit trail shows twice. The append route beneath this one
// already refuses an event whose (node, id, parent, kind) is already present, but that refusal lands
// DURING the write, after earlier steps of the same attempt have already landed, which is the worst
// moment to discover the migration ran before. So the runbook asks this question BEFORE it writes
// anything, through the two readers production itself uses (roadmap_retired_node_ids_load and
// roadmap_acceptance_event_history_load — the same loads the board, the page and the belt read), and
// refuses the whole attempt if any fact it is about to add is already live.
//
// WHAT MAKES IT A MODEL AND NOT A GREP. Nothing here opens a file, lists a directory or matches a
// word in a document. Each reader's answer is matched by its OWN TYPE, and a reader that refuses is
// reported as a refusal — an unreadable log never answers "nothing is there yet"
// (gunbc.design_argument::fail_closed). The runbook's shell runs this entry and aborts its own block
// on a nonzero exit; it decides nothing.
//
// WHY THE TWO ROSTERS ARE ARGUMENTS. `roadmap_cutover_precheck_decide` takes the retirement roster
// and the acceptance closed set as parameters and its only production caller passes the MODEL's own
// (`roadmap_migration_retirement_ids`, `roadmap_migration_acceptance_identities`), which is what the
// runbook and its emitted roster file are built from. They are parameters so a claim can drive the
// decision over a roster it constructs — a decision that could only be reached by calling the model
// could only be witnessed by a live carrier, and a witness that needs the host to be wrong is not a
// witness (gunbc.design_argument::claims_discriminate). Nothing outside this module passes anything
// else: a caller that invented a roster would be arguing with the model in its own refusal text.
//
// THE ROSTER FILE. The admitted decision also emits the roster of nodes step 4 must retire, one id
// per line, so the loop that retires them iterates WHAT THE MODEL LISTS rather than a copy of it
// typed into a document — a roster restated in shell is a second home for the same fact
// (gunbc.design_argument::planning_has_one_home), and a copy is how a later fifth or sixth id gets
// missed. Step 4 and step 6 read this file; nothing hard-codes the ids.
// ─────────────────────────────────────────────────────────────────────────────────────────────

type RoadmapCutoverPrecheck
  = PrecheckAdmitted { retired_live: List<String>, acceptances_live: List<String> }
  | PrecheckRefused { refusals: List<String> }

// THE DECISION, PURE, so a claim can drive it without a host: the two readers' answers in, the
// roster out. `PrecheckAdmitted` carries what the log already holds about the migration's own facts,
// which is always empty for an admitted attempt — a non-empty live set is a refusal, never a note.
fn roadmap_cutover_precheck_decide(
  retired: RoadmapRetiredNodeIds,
  history: RoadmapAcceptanceEventHistoryLoad,
  retire_roster: List<String>,
  accept_roster: List<String>
) -> RoadmapCutoverPrecheck {
  match retired {
    RetiredNodeIdsRefused { detail } => PrecheckRefused { refusals: [
      join([
        "the live retired-node read REFUSED: ", detail as String,
        " — a log nobody can read is not a log that holds nothing; the migration would be appending blind"], "")] }
    RetiredNodeIdsLoaded { ids: live_retired } => match history {
      RoadmapAcceptanceEventHistoryLoadRefused { detail } => PrecheckRefused { refusals: [
        join([
          "the live acceptance-history read REFUSED: ", detail,
          " — an acceptance the migration cannot see is an acceptance it would record twice"], "")] }
      RoadmapAcceptanceEventHistoryLoaded { events: events } => {
        let live_acceptances = map(events, e => roadmap_acceptance_migration_identity(e: e))
        let already_retired = filter(
          retire_roster,
          n => roadmap_node_ids_contain(ids: live_retired, node: n as NonEmptyStr as RoadmapNodeId))
        let already_accepted = filter(
          accept_roster,
          i => count(filter(live_acceptances, a => a == i)) > 0)
        let empty_roster = if count(retire_roster) == 0 {
          ["the model hands back an EMPTY retirement roster — a migration that retires nothing silently skipped its step"]
        } else { [] }
        let empty_closed_set = if count(accept_roster) == 0 {
          ["the model hands back an EMPTY acceptance closed set — the no-pull-request door would admit nothing and the migration would record nothing"]
        } else { [] }
        let refusals = concat([
          empty_roster,
          empty_closed_set,
          map(already_retired, n => join([
            "retirement is ALREADY LIVE for ", n,
            " (authority: ", match roadmap_migration_retirement_authority(node: n) {
              Present { value: a } => a as String
              Absent => "the roster carries no authority for this node" },
            ") — this migration is one-time; re-running it would append the fact twice"], "")),
          map(already_accepted, i => join([
            "an acceptance is ALREADY LIVE for ", i,
            " — this migration is one-time; re-running it would record the receipt twice"], "")),
        ])
        if count(refusals) == 0 {
          PrecheckAdmitted { retired_live: already_retired, acceptances_live: already_accepted }
        } else {
          PrecheckRefused { refusals: refusals }
        }
      }
    }
  }
}

// THE DOCUMENT THE PR QUOTES. Rendered from the decision, with the two rosters read from the MODEL
// here rather than taken from the caller: this text is the artifact the runbook tells the operator to
// attach to the PR, and a renderer whose roster came from its caller could be made to quote any
// roster the caller liked. The exit is matched from the decision; rewording any string here cannot
// change which side of the door an attempt lands on.
fn roadmap_cutover_precheck_document(decision: RoadmapCutoverPrecheck) -> String {
  let retire_roster = roadmap_migration_retirement_ids()
  let accept_count = count(roadmap_migration_acceptance_identities())
  let verdict = match decision {
    PrecheckAdmitted { retired_live: _, acceptances_live: _ } => "ADMITTED — none of the migration's own facts is live yet; the appends may run\n"
    PrecheckRefused { refusals: refusals } => join([
      "REFUSED — ", to_string(value: count(refusals)), " fact(s) of this migration are already live, or the log could not be read:\n",
      join(map(refusals, r => join(["  - ", r, "\n"], "")), ""),
      "Nothing was written by this refusal. The migration is one-time; if these facts are live, the cutover has already run.\n"], "")
  }
  let roster_text = match decision {
    PrecheckAdmitted { retired_live: _, acceptances_live: _ } => join([
      "RETIREMENT ROSTER, as the model lists it (", to_string(value: count(retire_roster)),
      " node(s); this is what the retirement step iterates — no id is typed into the runbook):\n",
      join(map(retire_roster, n => join(["  - ", n, "\n"], "")), "")], "")
    PrecheckRefused { refusals: _ } => ""
  }
  join([
    "ROADMAP EVENT-LOG CUTOVER — PRE-WRITE PRECHECK\n",
    "(read-only: the two readers production uses, matched by their own types; no file of the carrier was opened by hand)\n",
    verdict, "\n", roster_text,
    "ACCEPTANCE CLOSED SET: ", to_string(value: accept_count),
    " identity(ies) pinned in gunbc.roadmap.roadmap_event_log roadmap_migration_acceptance_identities;\n",
    "every acceptance line the migration feeds must be one of them, or the modeled law refuses it.\n"], "")
}

// THE ENTRY THE RUNBOOK RUNS BEFORE ITS FIRST WRITE. Read-only against the carrier; the only files it
// touches are its own report and the roster file it emits for the retirement step. A refusal exits
// nonzero WITHOUT writing either, so a second run cannot leave behind artifacts that look like an
// admitted attempt.
fn roadmap_cutover_precheck_cli(report_path: String, roster_path: String) -> ProcessExit {
  let retire_roster = roadmap_migration_retirement_ids()
  let accept_roster = roadmap_migration_acceptance_identities()
  let decision = roadmap_cutover_precheck_decide(
    retired: roadmap_retired_node_ids_load(),
    history: roadmap_acceptance_event_history_load(),
    retire_roster: retire_roster,
    accept_roster: accept_roster)
  match decision {
    PrecheckRefused { refusals: refusals } => ExitFailure {
      code: 1,
      reason: join([
        "roadmap_cutover_precheck_cli: the cutover REFUSES to write — ", to_string(value: count(refusals)),
        " fact(s) of this one-time migration are already live or the log could not be read:",
        join(map(refusals, r => join(["\n  ", r], "")), ""),
        "; nothing was written to ", report_path, " or ", roster_path], "") }
    PrecheckAdmitted { retired_live: _, acceptances_live: _ } => {
      let document = roadmap_cutover_precheck_document(decision: decision)
      let roster_wrote = Filesystem.Write(
        path: roster_path,
        content: join(map(retire_roster, n => join([n, "\n"], "")), ""))
      let wrote = Filesystem.Write(path: report_path, content: document)
      if !roster_wrote.success {
        ExitFailure {
          code: 1,
          reason: join([
            "roadmap_cutover_precheck_cli: the retirement roster could not be written to ", roster_path,
            " (write error: ", roster_wrote.error,
            "); the retirement step iterates that file, so without it there is no step to run"], "") }
      } else if !wrote.success {
        ExitFailure {
          code: 1,
          reason: join([
            "roadmap_cutover_precheck_cli: the precheck report could not be written to ", report_path,
            " (write error: ", wrote.error,
            "); a cutover with no quotable pre-write read is a cutover nobody can audit"], "") }
      } else {
        ExitSuccess
      }
    }
  }
}
