import std.process { ProcessExit, ExitSuccess, ExitFailure }
import std.algebra { trim }
import gunbc.clock_read { clock_now_probed_at }
import gunbc.roadmap.roadmap_model { RoadmapNodeId }
import std.content_hash { serialize_content_hash, Fnv1a64, content_hash_atom }
import gunbc.roadmap.roadmap_dashboard_instance { HostDashboardInstance, dashboard_instance_for_repo_root, DashboardInstanceResolved, DashboardInstanceRootUnknown }
import gunbc.principal_projection { principal_ref_parse_label }
import gunbc.roadmap.roadmap_event_log {
  RoadmapEvent, RoadmapEventKind, Claimed, Released, Progress, Blocked, HandedBack, Retired,
  EventPrincipal, EventPrincipalAuthenticated,
  roadmap_node_standing, roadmap_node_standing_text, roadmap_history_unordered_reason,
}
import gunbc.roadmap.roadmap_issue_command { IssueCommand, IssueCommandSubject, issue_command_apply }
import gunbc.roadmap.roadmap_operator_acceptance {
  roadmap_operator_acceptance_parse_tail, RoadmapAcceptanceTailOk, RoadmapAcceptanceTailBad,
}
import gunbc.roadmap.roadmap_model {
  RoadmapAcceptanceEvent, RoadmapAcceptanceReceipt, RoadmapAcceptanceRevocationFacts,
  roadmap_acceptance_line_acceptance_receipt, roadmap_acceptance_line_revocation_facts,
}
import gunbc.roadmap.roadmap_event_carrier {
  roadmap_event_carrier_layout_for_instance, roadmap_event_append, roadmap_events_read,
  EventAppended, EventAlreadyPresent, EventAppendRefused, EventsRead, EventsReadRefused,
  CarrierSnapshotClose, SnapshotNotOpened, SnapshotClosed, SnapshotCloseFailed,
  carrier_snapshot_close_failures, carrier_report_with_snapshot_close,
}

// THE ONE WRITER. A session, an operator or a harness worker records a fact about a node with
//   gunbc run --entry dag/gunbc/roadmap/roadmap_event_cli.dag --function roadmap_event_record_cli \
//     --arg repo_root=<instance repo> --arg node=<id> --arg kind=claim|release|progress|block|handback \
//     --arg text=<note or reason> --arg author=principal:<authority>/<namespace>/<subject>
// and reads a node's standing with roadmap_event_standing_cli. The instance is resolved from the
// repository root the caller stands in, exactly as the belt resolves its own, so the same command on
// srv1 and srv2 writes to the same shared branch and reads the same events. The parent of the new
// event is the current head of the node's history when there is exactly one; a fork or an incomplete
// history refuses the write, because recording on top of a state the writer could not read is how a
// fork becomes three. THE AUTHOR IS A PRINCIPAL, never an email (owner ruling 2026-09-25,
// docs/plans/human-identity-authorization.md): the CLI is a machine-writer seam, and --arg author
// must spell principal:.../.../... — a bare email refuses, because new v3 writes require an
// authenticated principal and a legacy email can only be DECODED from history, never minted. A CLI
// `claim` records the caller's principal as the assignee — a self-claim; assignment to ANOTHER
// principal is the served assign route's shape (POST /issue/<id>/assign), not the CLI's.
fn roadmap_event_kind_from_words(kind: String, text: String, author: EventPrincipal) -> RoadmapEventKind? {
  let t = trim(text)
  if kind == "claim" { Present { value: Claimed { assignee: author, return_to: author } } }
  else if kind == "release" { Present { value: Released } }
  else if kind == "progress" { if t == "" { none } else { Present { value: Progress { note: t as NonEmptyStr } } } }
  else if kind == "block" { if t == "" { none } else { Present { value: Blocked { reason: t as NonEmptyStr } } } }
  else if kind == "handback" { if t == "" { none } else { Present { value: HandedBack { reason: t as NonEmptyStr } } } }
  // RETIREMENT, FROM THE ONE WRITER. A node's retirement is an event like any other and the CLI is the
  // route a session or an operator reaches for; the append route beneath it is what refuses to record
  // it twice or after the node has been accepted (gunbc.roadmap.roadmap_event_carrier
  // roadmap_retirement_append_admitted_after).
  else if kind == "retire" { if t == "" { none } else { Present { value: Retired { reason: t as NonEmptyStr } } } }
  else { none }
}

fn roadmap_event_record_unordered_refusal(why: String) -> String {
  join(["roadmap_event_record_cli: refusing to record on a history that cannot be ordered: ", why], "")
}

// THE RECORD'S EXIT BESIDE THE SNAPSHOTS IT OWNED. A refusal already carries text, so a snapshot
// left behind is stated after the refusal's own reason. A recorded event stays ExitSuccess: the
// exit IS the append's result, ExitSuccess carries no text, and a nonzero exit would tell a caller
// the event was not recorded when it was -- a retry would then append a second event. So on success
// this entry has no surface for a leaked snapshot, each standing is matched by name to say so, and
// that failure itself is recorded nowhere; a snapshot left registered is listed by the instance's
// snapshot census (gunbc.roadmap.roadmap_event_snapshot_census roadmap_snapshot_census_for_instance).
fn roadmap_event_record_exit(exit: ProcessExit, closes: List<CarrierSnapshotClose>) -> ProcessExit {
  match exit {
    ExitFailure { code, reason } => ExitFailure { code: code, reason: join(concat([reason], carrier_snapshot_close_failures(closes: closes)), "; ") }
    ExitSuccess => fold(closes, init: ExitSuccess, f: (acc, c) => match c {
      SnapshotNotOpened => acc
      SnapshotClosed => acc
      SnapshotCloseFailed { worktree: _, exit_code: _, stderr: _ } => acc
    })
  }
}

fn roadmap_event_record_cli(repo_root: String, node: String, kind: String, text: String, author: String) -> ProcessExit {
  match dashboard_instance_for_repo_root(repo_root: repo_root) {
    DashboardInstanceRootUnknown { repo_root: w } => ExitFailure { code: 1, reason: join(["roadmap_event_record_cli: no dashboard instance is rooted at ", w], "") }
    DashboardInstanceResolved { instance } =>
      match principal_ref_parse_label(s: author) {
        Absent => ExitFailure { code: 1, reason: join(["roadmap_event_record_cli: author must be an authenticated principal spelling principal:<authority>/<namespace>/<subject>; got '", author, "' (a bare email can only be read from history, never written)"], "") }
        Present { value: author_ref } => {
          let author_principal = EventPrincipalAuthenticated { ref: author_ref }
          match roadmap_event_kind_from_words(kind: kind, text: text, author: author_principal) {
            Absent => ExitFailure { code: 1, reason: join(["roadmap_event_record_cli: kind must be claim|release|progress|block|handback|retire, and progress/block/handback/retire need text; got kind=", kind], "") }
            Present { value: k } => {
              let layout = roadmap_event_carrier_layout_for_instance(instance: instance)
          let node_id = node as NonEmptyStr as RoadmapNodeId
          let history = roadmap_events_read(layout: layout, node: node_id)
          match history.result {
            EventsReadRefused { node: _, step, reason } => roadmap_event_record_exit(
              exit: ExitFailure { code: 1, reason: join(["roadmap_event_record_cli: could not read the node's history (", step, "): ", reason], "") },
              closes: [history.close])
            EventsRead { node: _, envelopes } => {
              match roadmap_history_unordered_reason(envs: envelopes) {
                Present { value: why } => roadmap_event_record_exit(exit: ExitFailure { code: 1, reason: roadmap_event_record_unordered_refusal(why: why) }, closes: [history.close])
                Absent => {
                let heads = filter(envelopes, e => !any(envelopes, o => match o.event.parent { Present { value: p } => (p as String) == (e.id as String)  Absent => false }))
                let parent = match heads.first() { Present { value: h } => Present { value: h.id }  Absent => none }
                let at = match clock_now_probed_at() { Present { value: t } => t as String  Absent => "" }
                // THE RETIREMENT IS AN OPERATION, THE OTHER KINDS ARE NOT (yet). Retirement is terminal,
                // so its key can be the fact itself and a retried command answers the first recording
                // instead of appending; claim/progress/block/handback are not terminal, and giving them
                // the same key would refuse an operator's SECOND deliberate posting of the same note.
                let operation = match k {
                  Retired { reason } => roadmap_retirement_operation_identity(node: node, reason: reason as String)
                  _ => ""
                }
                let appended = roadmap_event_append(layout: layout, event: RoadmapEvent { node: node_id, author: author_principal, parent: parent, kind: k, recorded_at: at }, operation: operation)
                roadmap_event_record_exit(
                  exit: match appended.result {
                    EventAppended { id } => ExitSuccess
                    EventAlreadyPresent { id } => ExitSuccess
                    EventAppendRefused { id: _, step, reason } => ExitFailure { code: 1, reason: join(["roadmap_event_record_cli: append refused at ", step, ": ", reason], "") }
                  },
                  closes: [history.close, appended.close])
              }
              }
            }
          }
        }
      }
    }
      }
  }
}

// THE OPERATOR'S ACCEPTANCE, RECORDED AS AN EVENT. The acceptance of a node is not conversation and it
// is not an assignment: it is the operator's verdict, and since 2026-11-09 it lives in the same
// append-only event log every other node fact lives in
// (gunbc.design_ruling::plans_reset_and_audit_recommendations_2026_11_08). The caller passes the receipt
// line the operator law spells (gunbc.roadmap.roadmap_operator_acceptance
// roadmap_operator_acceptance_receipt_line) and the review thread the acceptance closed on; THE NODE IS
// THE RECEIPT'S OWN NODE, never an argument that could disagree with it, and the route beneath refuses a
// receipt that names another node. A line the operator law refuses is refused here, before any write.
//
//   gunbc run --entry dag/gunbc/roadmap/roadmap_event_cli.dag --function roadmap_acceptance_record_cli \
//     --arg repo_root=<instance repo> --arg receipt_line=<acceptance line> \
//     --arg pr_url=<review thread> --arg merged_at=<merge time> --arg head_sha=<head at merge> \
//     --arg author=principal:<authority>/<namespace>/<subject>
//
// THE THREE PULL-REQUEST ARGUMENTS ARE ONE FACT OR NOTHING. An acceptance earned now names the review
// thread that earned it, its merge time and its head. Passing NOTHING for all three records an acceptance
// that never had a pull request — which is admitted only for a receipt the operator recorded before this
// log became the authority (roadmap_acceptance_pr_evidence_cutoff), because that is what the one-time
// migration of the hand-committed seed carries and nothing else; half a triple, or an absence dated after
// the cutoff, is refused at the route (witness:
// a_partial_pull_request_evidence_refuses_and_an_absence_is_admitted_only_before_the_cutoff).
fn roadmap_acceptance_record_cli(repo_root: String, receipt_line: String, pr_url: String, merged_at: String, head_sha: String, author: String) -> ProcessExit {
  match roadmap_acceptance_line_of(text: receipt_line) {
    Absent => ExitFailure { code: 1, reason: "roadmap_acceptance_record_cli: the receipt line is refused: it must be an acceptance line spelled exactly as the operator law spells one, naming the live receipt, its red control, and its handback" }
    Present { value: line } => match roadmap_acceptance_line_acceptance_receipt(line: line) {
      Absent => ExitFailure { code: 1, reason: "roadmap_acceptance_record_cli: only an acceptance line is written by this route; a revocation is written by roadmap_acceptance_revoke_cli" }
      Present { value: receipt } => roadmap_acceptance_command(
        repo_root: repo_root, author: author, node: receipt.node as String, who: "roadmap_acceptance_record_cli",
        choice: BuildAcceptCommand { receipt: receipt, pr_url: pr_url, merged_at: merged_at, head_sha: head_sha })
    }
  }
}

// THE SAME RECEIPT, UNDONE. The caller passes the operator law's REVOCATION line — the form that already
// names the exact acceptance it withdraws, the reason, and the standing the node returns to. The
// disposition is READ from the line and never defaulted, and the append route beneath refuses the write
// unless the receipt named is that node's live acceptance
// (gunbc.roadmap.roadmap_event_log roadmap_revocation_names_live_acceptance).
//
//   gunbc run --entry dag/gunbc/roadmap/roadmap_event_cli.dag --function roadmap_acceptance_revoke_cli \
//     --arg repo_root=<instance repo> --arg revocation_line=<revocation line> \
//     --arg author=principal:<authority>/<namespace>/<subject>
fn roadmap_acceptance_revoke_cli(repo_root: String, revocation_line: String, author: String) -> ProcessExit {
  match roadmap_acceptance_line_of(text: revocation_line) {
    Absent => ExitFailure { code: 1, reason: "roadmap_acceptance_revoke_cli: the revocation line is refused: it must name the exact acceptance it withdraws — the same node, the same criteria digest, the same red control and handback — with its reason and its disposition" }
    Present { value: line } => match roadmap_acceptance_line_revocation_facts(line: line) {
      Absent => ExitFailure { code: 1, reason: "roadmap_acceptance_revoke_cli: only a revocation line is written by this route; an acceptance is written by roadmap_acceptance_record_cli" }
      Present { value: facts } => roadmap_acceptance_command(
        repo_root: repo_root, author: author, node: facts.receipt.node as String, who: "roadmap_acceptance_revoke_cli",
        choice: BuildRevokeCommand { facts: facts })
    }
  }
}

// WHICH COMMAND THE ROUTE IS ASKING FOR, named by data rather than by a half-built command: the subject
// the route beneath supplies (it is the one that knows the chain's head), and the acceptance facts the
// operator's line carried.
type AcceptanceCommandChoice
  = BuildAcceptCommand { receipt: RoadmapAcceptanceReceipt, pr_url: String, merged_at: String, head_sha: String }
  | BuildRevokeCommand { facts: RoadmapAcceptanceRevocationFacts }

// THE OPERATION IDENTITY IS THE FACT, NOT THE NODE. The carrier keeps an operation create-once, so an
// identity naming only the node would let a node be accepted ONCE IN ITS LIFE: the acceptance and the
// revocation that later takes it back (and any re-acceptance on new criteria) would collide at
// operations/<node>/<operation>.json and the second command would be refused for a collision that is not
// a duplicate of anything. The identity is the node, the KIND of fact, and the digest of the receipt it
// acts on — stable, so retrying the same command is the same operation and replays instead of writing
// twice, and distinct, so a revocation is never mistaken for the acceptance it revokes
// (witness: acceptance_then_revocation_of_one_node_are_two_operations).
fn roadmap_acceptance_operation_identity(node: String, choice: AcceptanceCommandChoice) -> String {
  match choice {
    BuildAcceptCommand { receipt, pr_url: _, merged_at: _, head_sha: _ } =>
      join([node, "-acceptance-", roadmap_acceptance_receipt_digest_text(receipt: receipt)], "")
    BuildRevokeCommand { facts } =>
      join([node, "-revocation-", roadmap_acceptance_receipt_digest_text(receipt: facts.receipt)], "")
  }
}

// THE COMMAND LINE'S EMPTY ARGUMENT IS AN ABSENCE, never an empty string carried into the record. The
// one-time migration passes nothing for the pull request its records never carried (the hand-committed
// seed holds no such field); whether that absence is ADMISSIBLE is the command law's decision
// (gunbc.roadmap.roadmap_issue_command issue_command_acceptance_evidence_law), not this reader's guess —
// an acceptance earned after this log became the authority still has to name its pull request.
fn roadmap_acceptance_optional_text(value: String) -> NonEmptyStr? {
  if value == "" { none } else { Present { value: value as NonEmptyStr } }
}

// The receipt's own digest, in the hex text the member law already writes into the event.
fn roadmap_acceptance_receipt_digest_text(receipt: RoadmapAcceptanceReceipt) -> String {
  serialize_content_hash(hash: Fnv1a64(receipt.criteria_digest)) as String
}

// THE RETIREMENT'S OPERATION KEY IS ITS FACT: the node, the word "retirement", and the digest of the
// reason the principal gave — an identity the CLI can recompute, so a retried retirement meets its own
// operation receipt and answers the first recording (EventAlreadyPresent) instead of appending a second
// event or colliding; a DIFFERENT retirement of the same node is a different key, and the admission law
// refuses it outright, because a node already retired has no change left to name (witness:
// a_second_retirement_of_a_retired_node_refuses_and_a_retry_of_the_first_answers_it).
fn roadmap_retirement_operation_identity(node: String, reason: String) -> String {
  join([node, "-retirement-", content_hash_atom(value: reason as NonEmptyStr).digest as String], "")
}

fn roadmap_acceptance_built_command(subject: IssueCommandSubject, choice: AcceptanceCommandChoice) -> IssueCommand {
  match choice {
    BuildAcceptCommand { receipt, pr_url, merged_at, head_sha } => AcceptNode {
      subject: subject, receipt: receipt,
      pr_url: roadmap_acceptance_optional_text(value: pr_url),
      merged_at: roadmap_acceptance_optional_text(value: merged_at),
      head_sha: roadmap_acceptance_optional_text(value: head_sha) }
    BuildRevokeCommand { facts } => RevokeAcceptance {
      subject: subject, receipt: facts.receipt, disposition: facts.disposition,
      revoked_by: facts.revoked_by, revoked_on: facts.revoked_on, reason: facts.reason }
  }
}

// ONE LINE, PARSED BY THE OPERATOR LAW ITSELF. The line is the operator's record; the native seed parser
// is its only parser and this route adds no grammar of its own.
fn roadmap_acceptance_line_of(text: String) -> RoadmapAcceptanceEvent? {
  match roadmap_operator_acceptance_parse_tail(lines: [text]) {
    RoadmapAcceptanceTailOk { events: events } => events.first()
    RoadmapAcceptanceTailBad { line_index: _, detail: _ } => none
  }
}

// BOTH ROUTES BUILD THE SAME COMMAND OVER THE SAME ROUTE: name the instance, read its history, refuse to
// write on one that cannot be ordered, and hand the command to gunbc.roadmap.roadmap_issue_command
// issue_command_apply — the same route that assigns an issue or retires a node, so acceptance is an
// event like any other and there is no second writer to keep honest.
fn roadmap_acceptance_command(repo_root: String, author: String, node: String, who: String, choice: AcceptanceCommandChoice) -> ProcessExit {
  match dashboard_instance_for_repo_root(repo_root: repo_root) {
    DashboardInstanceRootUnknown { repo_root: w } => ExitFailure { code: 1, reason: join([who, ": no dashboard instance is rooted at ", w], "") }
    DashboardInstanceResolved { instance } =>
      match principal_ref_parse_label(s: author) {
        Absent => ExitFailure { code: 1, reason: join([who, ": author must be an authenticated principal spelling principal:<authority>/<namespace>/<subject>; got '", author, "' (a bare email can only be read from history, never written)"], "") }
        Present { value: author_ref } => {
          let layout = roadmap_event_carrier_layout_for_instance(instance: instance)
          let node_id = node as NonEmptyStr as RoadmapNodeId
          let history = roadmap_events_read(layout: layout, node: node_id)
          match history.result {
            EventsReadRefused { node: _, step, reason } => ExitFailure { code: 1, reason: join([who, ": could not read the node's history (", step, "): ", reason], "") }
            EventsRead { node: _, envelopes } =>
              match roadmap_history_unordered_reason(envs: envelopes) {
                Present { value: why } => ExitFailure { code: 1, reason: join([who, ": the node's history cannot be ordered, so nothing is written: ", why], "") }
                Absent => {
                  let heads = filter(envelopes, e => !any(envelopes, o => match o.event.parent { Present { value: p } => (p as String) == (e.id as String)  Absent => false }))
                  let expected = match heads.first() { Present { value: h } => Present { value: h.id }  Absent => none }
                  let subject = IssueCommandSubject {
                    node: node_id,
                    author: EventPrincipalAuthenticated { ref: author_ref },
                    // NOT `node`: see roadmap_acceptance_operation_identity — an operation named for the
                    // node alone would let a node be accepted exactly once in its life.
                    operation: roadmap_acceptance_operation_identity(node: node, choice: choice) as NonEmptyStr,
                    expected: expected,
                  }
                  let applied = issue_command_apply(layout: layout, command: roadmap_acceptance_built_command(subject: subject, choice: choice), recorded_at: match clock_now_probed_at() { Present { value: t } => t as String  Absent => "" })
                  roadmap_event_record_exit(
                    exit: match applied.result {
                      EventAppended { id: _ } => ExitSuccess
                      EventAlreadyPresent { id: _ } => ExitSuccess
                      EventAppendRefused { id: _, step, reason } => ExitFailure { code: 1, reason: join([who, ": append refused at ", step, ": ", reason], "") }
                    },
                    closes: [history.close, applied.close])
                }
              }
          }
        }
      }
  }
}

// THE STANDING IS A REPORT, SO IT IS A STRING: `gunbc run` prints a String return inside its typed
// envelope, which is the sanctioned way to read a value out of a run (a ProcessExit carries no
// stdout, and an ExitFailure with code 0 is refused by the host as a status that contradicts itself).
fn roadmap_event_standing_report(repo_root: String, node: String) -> String {
  match dashboard_instance_for_repo_root(repo_root: repo_root) {
    DashboardInstanceRootUnknown { repo_root: w } => join(["roadmap_event_standing_report: no dashboard instance is rooted at ", w], "")
    DashboardInstanceResolved { instance } => {
      let history = roadmap_events_read(layout: roadmap_event_carrier_layout_for_instance(instance: instance), node: node as NonEmptyStr as RoadmapNodeId)
      carrier_report_with_snapshot_close(
        text: match history.result {
          EventsReadRefused { node: _, step, reason } => join(["roadmap_event_standing_report: read refused at ", step, ": ", reason], "")
          EventsRead { node: _, envelopes } => join([node, ": ", roadmap_node_standing_text(s: roadmap_node_standing(envs: envelopes)), " (", to_string(value: count(envelopes)), " events)"], "")
        },
        close: history.close)
    }
  }
}
