module gunbc.roadmap.roadmap_intention_binding

import std.types { String, Int, Bool, List }
import std.decl_ref { DeclarationRef, decl_ref, declaration_ref_display_key }
import gunbc.roadmap.roadmap_model { RoadmapNodeId, RoadmapNode }
import gunbc.roadmap.roadmap_authority { declared_roadmap_nodes, declared_roadmap_edges, nid }

// WHICH INTENTION A WORK ITEM SERVES, AND AT WHICH LAYER, AS DATA RATHER THAN PROSE (operator,
// 2026-11-17: "move planning to more of a code based approach - a lot of the issues you refer to would
// be undefined variable in code"). Until now a node said "Layer 1 of gunbc.plans.names_without_imports"
// in its contribution string, which nothing could read or refuse. A row here names the node by its id,
// the intention by the DeclarationRef of its Plan value, and the layer by the number the plan's own
// layer section gives it. Two things then refuse instead of rotting: a node id with no node (the claim
// witness's identity join over declared_roadmap_nodes), and an intention that does not resolve (the
// cited-declaration sweep every landing's parse runs over DeclarationRef rows). The same shape as the
// private strategy's strategy.layered_argument, where a clause names the plan row that produces it and
// producer_resolves is held by a claim.
//
// WHAT THIS IS NOT. Not a field on RoadmapNode: that record is constructed literally in thirty test
// files, so a new field is thirty edits for the same fact; the binding folds into the record when the
// realization home is decided (gunbc.plans.planning_consolidation section 6). Not a second plan: the
// intention does not list its work items (gunbc.design_ruling plans_are_intentions_and_realization_is_downstream);
// the work item names the intention, which is the direction this binding runs. Not a schedule: the
// layer is the plan's dependency reading, not a date.
type IntentionBinding {
  node: RoadmapNodeId
  intention: DeclarationRef
  layer: Int
}

fn serves(node: String, module_path: String, plan: String, layer: Int) -> IntentionBinding {
  IntentionBinding { node: nid(s: node), intention: decl_ref(module_path: module_path, decl_name: plan), layer: layer }
}

