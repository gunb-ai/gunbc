  serves(node: "compiler-identity-from-sources", module_path: demand_engine_intention, plan: "demand_engine_program_plan", layer: 0),
  serves(node: "consumers-on-canonical-dependencies", module_path: demand_engine_intention, plan: "demand_engine_program_plan", layer: 0),
  serves(node: "native-artifact-reuse-through-request-key", module_path: demand_engine_intention, plan: "demand_engine_program_plan", layer: 1),
  serves(node: "schedulers-on-the-engine", module_path: demand_engine_intention, plan: "demand_engine_program_plan", layer: 1),
  serves(node: "reuse-decided-by-measurement", module_path: demand_engine_intention, plan: "demand_engine_program_plan", layer: 2),
  serves(node: "a-change-pays-only-for-what-it-invalidates", module_path: demand_engine_intention, plan: "demand_engine_program_plan", layer: 3),
  // gunbc.plans.gunb_ai_served_from_gunbc (2026-11-24): the cutover, then the refresh that waits on it.
  serves(node: "gunb-ai-deploy-cutover", module_path: gunb_ai_served_from_gunbc_intention, plan: "gunb_ai_served_from_gunbc_plan", layer: 0),
  serves(node: "gunb-ai-content-refresh", module_path: gunb_ai_served_from_gunbc_intention, plan: "gunb_ai_served_from_gunbc_plan", layer: 1),
]

// EACH INTENTION'S TERMINALS: the nodes whose acceptance is the intention's done-when, from which every bound
// node must be reachable by parent edges (the full-path property the operator asked for on 2026-11-17).
// namespace-legacy-choice-retirement is a terminal of its own: its seed-mirror row dies with the interpreter
// (edge from v1-interpreter-delete), so the import cut must not wait on it, or the graph cycles.
type IntentionTerminals {
  intention: DeclarationRef
  terminals: List<RoadmapNodeId>
}

data intention_terminals: List<IntentionTerminals> = [
  IntentionTerminals { intention: decl_ref(module_path: "gunbc.plans.fabric_market", decl_name: "fabric_market_plan"), terminals: [nid(s: "fabric-market-convergence")] },
  IntentionTerminals { intention: decl_ref(module_path: "gunbc.plans.claim_execution_consolidation", decl_name: "claim_execution_consolidation_plan"), terminals: [nid(s: "claim-entrypoints-cutover")] },
  IntentionTerminals { intention: decl_ref(module_path: "gunbc.plans.v2_self_host", decl_name: "v2_self_host_plan"), terminals: [nid(s: "external-specimen-compiles"), nid(s: "v1-products-v1-free")] },
  // namespace-unique-on-chain joins as the program milestone's own terminal (2026-11-23): the review of
  // 2026-11-19 (#16749) rewired native-production-admission's dependency off the project node onto
  // names-bind-to-the-unique-declaration, leaving the bound program node with no terminal reaching it;
  // the milestone's acceptance is the intention's done-when, as it is for factory_dogfood's factory row.
  IntentionTerminals { intention: decl_ref(module_path: "gunbc.plans.names_without_imports", decl_name: "names_without_imports_plan"), terminals: [nid(s: "import-grammar-and-lines-deleted"), nid(s: "namespace-legacy-choice-retirement"), nid(s: "namespace-unique-on-chain")] },
  IntentionTerminals { intention: decl_ref(module_path: "gunbc.plans.factory_dogfood", decl_name: "factory_dogfood_plan"), terminals: [nid(s: "factory")] },
  IntentionTerminals { intention: decl_ref(module_path: "gunbc.plans.debt_payoff", decl_name: "debt_payoff_plan"), terminals: [nid(s: "debt-payoff"), nid(s: "v1-zero-hand-maintained-rust")] },
  IntentionTerminals { intention: decl_ref(module_path: "gunbc.plans.one_source_tree", decl_name: "one_source_tree_plan"), terminals: [nid(s: "v2-namespace-dissolved")] },
  IntentionTerminals { intention: decl_ref(module_path: "gunbc.plans.first_customer_service", decl_name: "first_customer_service_plan"), terminals: [nid(s: "service-evidence-capture")] },
  // planning_consolidation's terminals are the sinks of the dispatch-from-the-simulated-execution
  // units: the page that renders the projection, and the three units whose acceptance is itself the
  // end of a line of work (a realized duration, a leaf carried by a dispatch, a typed handback), plus
  // the return_to route that records an acceptance. A bound unit is on a path when it is one of these
  // or reaches one along dependency edges; this row is what makes section 1's projection and section
  // 6's realization home checkable as done.
  IntentionTerminals { intention: decl_ref(module_path: "gunbc.plans.planning_consolidation", decl_name: "planning_consolidation_plan"), terminals: [nid(s: "roadmap-timeline-page"), nid(s: "roadmap-leaf-realized-duration"), nid(s: "roadmap-dispatch-carries-leaf"), nid(s: "roadmap-typed-handback"), nid(s: "roadmap-return-to-principal-records-acceptance")] },
  // desired_state_follows_the_machine's terminals are the work items whose completion ends a line: the read
  // is the only node with children along this program's dependency edges, so it is on a path to the three
  // that hang below it, and each remaining item is its own line's end. The plan's done-when is the whole
  // set -- one consumer refusing on a planted divergence, not four hosts repaired.
  IntentionTerminals { intention: decl_ref(module_path: "gunbc.plans.desired_state_follows_the_machine", decl_name: "desired_state_follows_the_machine_plan"), terminals: [nid(s: "fleet-truth-rosters-consume-the-read"), nid(s: "fleet-truth-unit-orphans-closed"), nid(s: "fleet-truth-serving-leaf-caps-joined-to-working-set"), nid(s: "fleet-truth-enrolled-key-roster-closed"), nid(s: "fleet-truth-prefix-cache-sized-to-population"), nid(s: "fleet-truth-probes-refuse-not-absence"), nid(s: "fleet-truth-declared-incompleteness-refuses-use")] },
  // The root item preserves settled constraint and nominal contracts while the transparent-reference
  // surface is decided separately. Only reference-specific changes or migration await that choice;
  // full acceptance still requires every relationship control. NonEmptyStr and the brands keep their
  // contracts through checked construction; transparent references denote the full constrained type.
  // These three still chain root <- nonempty <- brands along the prerequisite edges in
  // roadmap_authority::declared_roadmap_edges, so the existing terminal and bindings remain correct.
  // A blanket alias retirement is not this intention's goal, and the equals form's existing behavior
  // does not settle reference syntax. The governing choice is cited by the plan, not invented here.
  IntentionTerminals { intention: decl_ref(module_path: "gunbc.plans.derived_types_keep_their_name", decl_name: "derived_types_keep_their_name_plan"), terminals: [nid(s: "brands-reached-by-checked-constructors")] },
  // read_set_convergence's terminals here are the sinks of heal's lines of work: the P7 milestone and the three
  // separately accepted affected-round items. The plan's other consumers (A1 to A3) join as their items are filed.
  // demand_engine_program: the one-file bar is the intention's first done-when and the sink of its work items.
  IntentionTerminals { intention: decl_ref(module_path: "gunbc.plans.demand_engine_program", decl_name: "demand_engine_program_plan"), terminals: [nid(s: "a-change-pays-only-for-what-it-invalidates")] },
  IntentionTerminals { intention: decl_ref(module_path: "gunbc.plans.read_set_convergence", decl_name: "read_set_convergence_plan"), terminals: [nid(s: "heal-planning-only-in-a-minute"), nid(s: "heal-observation-reuse-by-subject"), nid(s: "heal-bootstrap-seed-reuse"), nid(s: "heal-terminal-emission-elision")] },
  // gunb_ai_served_from_gunbc's one line ends at the refresh, which waits on the cutover along the prerequisite edge.
  IntentionTerminals { intention: decl_ref(module_path: "gunbc.plans.gunb_ai_served_from_gunbc", decl_name: "gunb_ai_served_from_gunbc_plan"), terminals: [nid(s: "gunb-ai-content-refresh")] },
]

fn terminals_of(intention: DeclarationRef) -> List<RoadmapNodeId> {
  fold(intention_terminals, init: [], f: fn(acc, t) { if declaration_ref_display_key(ref: t.intention) == declaration_ref_display_key(ref: intention) { concat(acc, t.terminals) } else { acc } })
}

fn edges_parents_of(node: RoadmapNodeId) -> List<RoadmapNodeId> {
  declared_roadmap_edges() |> filter(e => e.child == node) |> map(e => e.parent)
}

// A terminal reaches the node walking parent edges, bounded by the node count so the walk terminates.
fn reaches_from(start: RoadmapNodeId, target: RoadmapNodeId, budget: Int) -> Bool {
  if budget <= 0 { false } else {
    if start == target { true } else {
      any(edges_parents_of(node: start), p => reaches_from(start: p, target: target, budget: budget - 1))
    }
  }
}

fn binding_on_a_path(b: IntentionBinding) -> Bool {
  any(terminals_of(intention: b.intention), t => reaches_from(start: t, target: b.node, budget: count(declared_roadmap_nodes())))
}

fn bindings_all_on_a_path() -> Bool {
  all(roadmap_intention_bindings, b => binding_on_a_path(b: b))
}

// Layer order: a bound parent is never at a higher layer than its bound child of the same intention.
fn binding_layer_order_holds() -> Bool {
  all(roadmap_intention_bindings, b =>
    all(edges_parents_of(node: b.node), p =>
      all(filter(roadmap_intention_bindings, o => o.node == p && intention_key(b: o) == intention_key(b: b)), o => o.layer <= b.layer)))
}

fn binding_has_node(b: IntentionBinding) -> Bool {
  count(filter(declared_roadmap_nodes(), n => n.node == b.node)) == 1
}

fn bindings_all_have_nodes() -> Bool {
  all(roadmap_intention_bindings, b => binding_has_node(b: b))
}

fn binding_nodes_unique() -> Bool {
  all(roadmap_intention_bindings, b => count(filter(roadmap_intention_bindings, o => o.node == b.node)) == 1)
}

fn binding_layers_nonnegative() -> Bool {
  all(roadmap_intention_bindings, b => b.layer >= 0)
}

fn intention_key(b: IntentionBinding) -> String {
  declaration_ref_display_key(ref: b.intention)
}

// The projection gunbc.plans.planning_consolidation section 2 asks for, read from here: the work items
// serving one intention, in layer order.
fn nodes_serving_from(rows: List<IntentionBinding>, intention: DeclarationRef) -> List<IntentionBinding> {
  filter(rows, b => intention_key(b: b) == declaration_ref_display_key(ref: intention))
    |> sort_by(b => b.layer)
}

fn nodes_serving(intention: DeclarationRef) -> List<IntentionBinding> {
  nodes_serving_from(rows: roadmap_intention_bindings, intention: intention)
}

fn bindings_at_layer(intention: DeclarationRef, layer: Int) -> List<IntentionBinding> {
  filter(nodes_serving(intention: intention), b => b.layer == layer)
}

fn bound_nodes_without_binding() -> List<RoadmapNode> {
  filter(declared_roadmap_nodes(), n => count(filter(roadmap_intention_bindings, b => b.node == n.node)) == 0)
}
