// ONE PER-ATTEMPT METERING RECORD (dogfood stage G3). The usage receipt the corpus already carries,
// gunbc.runner.runner_usage_receipt RunnerUsageReceipt, meters ONE microVM: configured vCPUs times
// a jailer-launch-to-VMM-reap interval, beside a capacity-held interval, read from four instants on
// one monotonic clock. An attempt on the belt is not one VM: it is N harness launches (the worker, a
// reviewer per criterion and head, an auditor per head, a supervisor per escalation turn), each
// holding its own serving seat on the fabric ledger and each reporting model tokens, which
// RunnerUsageReceipt has no field for. So this record DIVERGES (DESIGN §3b) and keeps only what
// transfers: an interval is a difference of two observed instants that refuses when reversed, and a
// missing meter is a typed refusal, never a zero. No price, credit or rounding enters here.
//
// THE POPULATION IS THE LAUNCH ROSTER, NEVER THE MEASUREMENT FILES. The belt admits each launch to
// the attempt's roster before it spawns the role (metering_roster_admit), and refuses the spawn when
// it cannot; the worker is always a member. Every roster member is one paired row -- its token
// reading and its seat reading -- so a launch whose files never appeared is a row that is incomplete,
// not a row that is missing.

// ── launches ──────────────────────────────────────────────────────────────────────────────────
type MeteredRole
  = MeteredWorker
  | MeteredReviewer { criterion_key: NonEmptyStr, head: NonEmptyStr }
  | MeteredAuditor { head: NonEmptyStr }
  | MeteredSupervisor { turn: Int }

fn metered_role_wire(role: MeteredRole) -> String {
  match role {
    MeteredWorker => "worker"
    MeteredReviewer { criterion_key: c, head: h } => join(["reviewer:", c as String, "@", h as String], "")
    MeteredAuditor { head: h } => join(["auditor@", h as String], "")
    MeteredSupervisor { turn: t } => join(["supervisor:t", to_string(t)], "")
  }
}

fn metered_role_eq(a: MeteredRole, b: MeteredRole) -> Bool {
  metered_role_wire(role: a) == metered_role_wire(role: b)
}

fn metered_role_json(role: MeteredRole) -> JsonValue {
  match role {
    MeteredWorker => json_object(members: [json_kv(key: "kind", value: json_string(s: "worker"))])
    MeteredReviewer { criterion_key: c, head: h } => json_object(members: [
      json_kv(key: "kind", value: json_string(s: "reviewer")),
      json_kv(key: "criterion_key", value: json_string(s: c as String)),
      json_kv(key: "head", value: json_string(s: h as String)),
    ])
    MeteredAuditor { head: h } => json_object(members: [
      json_kv(key: "kind", value: json_string(s: "auditor")),
      json_kv(key: "head", value: json_string(s: h as String)),
    ])
    MeteredSupervisor { turn: t } => json_object(members: [
      json_kv(key: "kind", value: json_string(s: "supervisor")),
      json_kv(key: "turn", value: json_int(n: t)),
    ])
  }
}

fn metered_role_decode(v: JsonValue) -> RowDecode<MeteredRole> {
  match metering_member_text(doc: v, key: "kind") {
    MemberTextGap { cause: c } => RowUndecodable { cause: join(["a role ", c], "") }
    MemberText { value: kind } =>
      if kind == "worker" {
        RowDecoded { row: MeteredWorker }
      } else if kind == "reviewer" {
        match metering_member_text(doc: v, key: "criterion_key") {
          MemberTextGap { cause: c } => RowUndecodable { cause: join(["a reviewer role ", c], "") }
          MemberText { value: ck } =>
            match metering_member_text(doc: v, key: "head") {
              MemberTextGap { cause: c } => RowUndecodable { cause: join(["a reviewer role ", c], "") }
              MemberText { value: h } => RowDecoded { row: MeteredReviewer { criterion_key: ck as NonEmptyStr, head: h as NonEmptyStr } }
            }
        }
      } else if kind == "auditor" {
        match metering_member_text(doc: v, key: "head") {
          MemberTextGap { cause: c } => RowUndecodable { cause: join(["an auditor role ", c], "") }
          MemberText { value: h } => RowDecoded { row: MeteredAuditor { head: h as NonEmptyStr } }
        }
      } else if kind == "supervisor" {
        match metering_member_int(doc: v, key: "turn") {
          MemberIntGap { cause: c } => RowUndecodable { cause: c }
          MemberInt { value: t } => RowDecoded { row: MeteredSupervisor { turn: t } }
        }
      } else {
        RowUndecodable { cause: join(["unknown role kind ", kind], "") }
      }
  }
}

// The events path and the seat owner of a launch are the spawner's own derivations, read from the
// same functions gunbc.roadmap_dispatch_actuator mints them with -- never from a file the launch wrote.
fn metered_role_events_path(instance: HostDashboardInstance, node_id: RoadmapNodeId, attempt_key: String, role: MeteredRole) -> String {
  match role {
    MeteredWorker => dispatch_attempt_events_path_for_instance(instance: instance, node_id: node_id, attempt_key: attempt_key)
    MeteredReviewer { criterion_key: c, head: h } =>
      dispatch_attempt_review_events_path_for_instance(instance: instance, node_id: node_id, attempt_key: attempt_key, criterion_key: c as String, head_sha: h as String)
    MeteredAuditor { head: h } =>
      dispatch_attempt_audit_events_path_for_instance(instance: instance, node_id: node_id, attempt_key: attempt_key, head_sha: h as String)
    MeteredSupervisor { turn: t } =>
      dispatch_attempt_supervisor_events_path_for_instance(instance: instance, node_id: node_id, attempt_key: attempt_key, turn: t)
  }
}

fn metered_role_seat_owner(node_id: String, attempt_key: String, role: MeteredRole) -> String {
  match role {
    MeteredWorker => dispatch_worker_attempt_identity(node_id: node_id, attempt_key: attempt_key)
    MeteredReviewer { criterion_key: c, head: h } => dispatch_reviewer_attempt_identity(node_id: node_id, attempt_key: attempt_key, criterion_key: c as String, head_sha: h as String)
    MeteredAuditor { head: h } => dispatch_auditor_attempt_identity(node_id: node_id, attempt_key: attempt_key, head_sha: h as String)
    MeteredSupervisor { turn: t } => dispatch_supervisor_attempt_identity(node_id: node_id, attempt_key: attempt_key, turn: t)
  }
}

// ── tokens: one launch's provider-events stream, read strictly ────────────────────────────────
// gunbc.harness.harness_throughput skips a non-JSON line as somebody else's event, which suits a
// throughput projection over mixed historical streams and does not suit a record whose claim is that
// the token population is complete: a truncated round.usage line would vanish and the total would
// read short. This fold refuses every nonempty line that is not JSON, every recognized usage row it
// cannot read, and every round.usage_unavailable row (the harness's own statement that a round's
// usage is unknown). Rows are decoded by the throughput module's row reader -- one decoder. An
// unclocked row still carries its counts: a token total has no interval to place it in.
type RoleTokens
  = TokensObserved { rounds: Int, input_tokens: TokenCount, output_tokens: TokenCount, terminal: Bool }
  | TokensStreamAbsent
  | TokensRefused { cause: String }

type StrictLine
  = StrictLineRow { input_tokens: TokenCount, output_tokens: TokenCount }
  | StrictLineSkipped
  | StrictLineRefused { cause: String }

fn metering_event_type(doc: JsonValue) -> String {
  match json_object_unique_member(v: doc, key: "type") {
    JsonMemberFound { value: v } =>
      match v {
        JsonString { value: t } => t
        JsonNull => ""
        JsonBool { value: _ } => ""
        JsonNumber { lexeme: _ } => ""
        JsonArray { elements: _ } => ""
        JsonObject { members: _ } => ""
      }
    JsonMemberAbsent => ""
    JsonMemberDuplicated { count: _ } => ""
    JsonMemberNotAnObject => ""
  }
}

// A ROUND'S COUNTS ENTER AS TokenCount AT THE STREAM BOUNDARY; a negative count refuses there.
fn metering_round_row(input_tokens: Int, output_tokens: Int) -> StrictLine {
  match checked_int_to_nat(n: input_tokens) {
    Absent => StrictLineRefused { cause: "a round.usage row carries a negative input_tokens" }
    Present { value: i } =>
      match checked_int_to_nat(n: output_tokens) {
        Absent => StrictLineRefused { cause: "a round.usage row carries a negative output_tokens" }
        Present { value: o } => StrictLineRow { input_tokens: token_count(count: i), output_tokens: token_count(count: o) }
      }
  }
}

fn token_count_sum(a: TokenCount, b: TokenCount) -> TokenCount {
  token_count(count: token_count_value(t: a) + token_count_value(t: b))
}

fn metering_unclocked_row(doc: JsonValue) -> StrictLine {
  match metering_member_int(doc: doc, key: "input_tokens") {
    MemberIntGap { cause: c } => StrictLineRefused { cause: c }
    MemberInt { value: i } =>
      match metering_member_int(doc: doc, key: "output_tokens") {
        MemberIntGap { cause: c } => StrictLineRefused { cause: c }
        MemberInt { value: o } => metering_round_row(input_tokens: i, output_tokens: o)
      }
  }
}

fn metering_strict_line(line: String) -> StrictLine {
  if trim(line) == "" {
    StrictLineSkipped
  } else {
    match parse_json_document(s: line) {
      JsonDocumentUnreadable { gap: _ } => StrictLineRefused { cause: "an events line is not a JSON document; a truncated or corrupt row cannot be excluded from a complete token total" }
      JsonDocumentParsed { value: doc } =>
        if metering_event_type(doc: doc) == "round.usage_unavailable" {
          StrictLineRefused { cause: "the harness recorded a round whose usage was unavailable" }
        } else {
          match throughput_is_usage_row(doc: doc) {
            UsageRowIsAnotherEvent => StrictLineSkipped
            UsageRowUnreadable { cause: c } => StrictLineRefused { cause: c }
            UsageRowIsOurs =>
              match round_observation_of(doc: doc) {
                RoundReadOk { round: r } => metering_round_row(input_tokens: r.input_tokens, output_tokens: r.output_tokens)
                RoundReadUnclocked => metering_unclocked_row(doc: doc)
                RoundReadGap { cause: c } => StrictLineRefused { cause: c }
              }
          }
        }
    }
  }
}

fn metering_role_terminal(body: String) -> Bool {
  match provider_execution_state(parsed: parse_codex_jsonl(text: body)) {
    ProviderCompleted { activity: _ } => true
    ProviderFailed { activity: _, detail: _ } => true
    ProviderBudgetSpent { activity: _, detail: _ } => true
    ProviderNotStarted => false
    ProviderStarting { activity: _ } => false
    ProviderAwaitingSeat { detail: _ } => false
    ProviderRunning { activity: _ } => false
    ProviderEventsRefused { activity: _, detail: _ } => false
  }
}

type RoundTokens {
  input_tokens: TokenCount
  output_tokens: TokenCount
}

fn role_tokens_from_events(body: String) -> RoleTokens {
  let reads = map(split(s: body, delimiter: "\n"), l => metering_strict_line(line: l))
  match fold(reads, init: none, f: (acc, r) =>
    match acc {
      Present { value: c } => Present { value: c }
      Absent => match r { StrictLineRefused { cause: c } => Present { value: c } StrictLineRow { input_tokens: _, output_tokens: _ } => none StrictLineSkipped => none }
    }) {
    Present { value: c } => TokensRefused { cause: c }
    Absent => {
      let rows = flat_map(reads, r => match r {
        StrictLineRow { input_tokens: i, output_tokens: o } => [RoundTokens { input_tokens: i, output_tokens: o }]
        StrictLineSkipped => [] as List<RoundTokens>
        StrictLineRefused { cause: _ } => [] as List<RoundTokens>
      })
      TokensObserved {
        rounds: list_length(items: rows),
        input_tokens: fold(rows, init: token_count(count: 0), f: (acc, r) => token_count_sum(a: acc, b: r.input_tokens)),
        output_tokens: fold(rows, init: token_count(count: 0), f: (acc, r) => token_count_sum(a: acc, b: r.output_tokens)),
        terminal: metering_role_terminal(body: body),
      }
    }
  }
}

// ── seats: one launch's grant -> release interval on the fabric ledger ────────────────────────
// The pointer names the seat (gunbc.harness.harness_seat_pointer); both instants come from the
// ledger's own events for that reference. The pointer must name the launch's own seat owner and a
// reference minted for that owner, and the ledger must acquire exactly one seat under it.
type SeatHeld
  = SeatReleased { pointer: HarnessSeatPointer, granted_at: EpochSecs, released_at: EpochSecs }
  | SeatStillHeld { pointer: HarnessSeatPointer, granted_at: EpochSecs }
  | SeatPointerAbsent
  | SeatRefused { cause: String }

type SeatInstants {
  acquired: List<EpochSecs>
  released: List<EpochSecs>
  wrong_amount: Bool
}

fn seat_pointer_owned_by(pointer: HarnessSeatPointer, owner: String) -> String? {
  if (pointer.owner as String) != owner {
    Present { value: join(["the seat pointer names owner ", pointer.owner as String, ", not this launch's ", owner], "") }
  } else if !harness_seat_pointer_reference_names_owner(pointer: pointer) {
    Present { value: join(["the seat reference ", pointer.reference as String, " was not minted for its owner ", owner], "") }
  } else {
    none
  }
}

fn seat_held_from_events(pointer: HarnessSeatPointer, oldest_first: List<ChainEnvelope<PoolEvent>>) -> SeatHeld {
  let seat_ref = pointer.reference as String
  let s = fold(oldest_first, init: SeatInstants { acquired: [] as List<EpochSecs>, released: [] as List<EpochSecs>, wrong_amount: false }, f: (acc, env) =>
    match env.event.payload {
      PoolAcquired { reference: r, amount: a, term_seconds: _ } =>
        if (r as String) == seat_ref {
          SeatInstants { acquired: concat(acc.acquired, [env.event.recorded_at]), released: acc.released, wrong_amount: acc.wrong_amount || a != 1 }
        } else { acc }
      PoolReleased { reference: r, reason: _ } =>
        if (r as String) == seat_ref { SeatInstants { acquired: acc.acquired, released: concat(acc.released, [env.event.recorded_at]), wrong_amount: acc.wrong_amount } } else { acc }
      PoolSettled { reference: _, actual: _ } => acc
      PoolLapsed => acc
      PoolUpstreamObserved { remaining: _, term_seconds: _ } => acc
      PoolResetObserved { reset_at: _ } => acc
    })
  let na = list_length(items: s.acquired)
  let nr = list_length(items: s.released)
  if na == 0 {
    SeatRefused { cause: join(["the ledger carries no acquisition for seat ", seat_ref], "") }
  } else if na > 1 {
    SeatRefused { cause: join(["the ledger acquires seat ", seat_ref, " more than once"], "") }
  } else if s.wrong_amount {
    SeatRefused { cause: join(["the ledger acquires seat ", seat_ref, " for an amount other than one seat"], "") }
  } else if nr > 1 {
    SeatRefused { cause: join(["the ledger releases seat ", seat_ref, " more than once"], "") }
  } else {
    let g = fold(s.acquired, init: 0, f: (_a, x) => x)
    if nr == 0 {
      SeatStillHeld { pointer: pointer, granted_at: g }
    } else {
      let r = fold(s.released, init: 0, f: (_a, x) => x)
      if r < g {
        SeatRefused { cause: join(["seat ", seat_ref, " was released before it was acquired"], "") }
      } else {
        SeatReleased { pointer: pointer, granted_at: g, released_at: r }
      }
    }
  }
}

fn seat_held_from_walk(pointer: HarnessSeatPointer, walk: ChainWalk<PoolEvent>) -> SeatHeld {
  match walk {
    ChainWalked { oldest_first: es } => seat_held_from_events(pointer: pointer, oldest_first: es)
    ChainIncomplete { missing: m, newest_first_so_far: _ } =>
      SeatRefused { cause: join(["the seat partition chain is incomplete at ", m as String], "") }
    ChainBudgetExhausted { at: a } =>
      SeatRefused { cause: join(["the seat partition chain exceeded its read budget at ", a as String], "") }
  }
}

// A seat's held time is derived from its two ledger instants, never stored beside them.
fn seat_held_seconds(seat: SeatHeld) -> Second? {
  match seat {
    SeatReleased { pointer: _, granted_at: g, released_at: r } =>
      match checked_int_to_nat(n: r - g) {
        Present { value: n } => Present { value: second(count: n) }
        Absent => none
      }
    SeatStillHeld { pointer: _, granted_at: _ } => none
    SeatPointerAbsent => none
    SeatRefused { cause: _ } => none
  }
}

fn seat_reference(seat: SeatHeld) -> List<String> {
  match seat {
    SeatReleased { pointer: p, granted_at: _, released_at: _ } => [p.reference as String]
    SeatStillHeld { pointer: p, granted_at: _ } => [p.reference as String]
    SeatPointerAbsent => [] as List<String>
    SeatRefused { cause: _ } => [] as List<String>
  }
}

// ── compute ───────────────────────────────────────────────────────────────────────────────────
// gunbc.compute outcome records are keyed by work identity, and nothing yet links an attempt to the
// work it caused, so the compute share is a typed absence, never zero. FRONTIER: the Observed arm
// (compute seconds, memory peak) lands with dogfood G1, which introduces that attempt->work link.
type ComputeUsage
  = ComputeNotAttributable { reason: NonEmptyStr }

data compute_not_attributable_reason: NonEmptyStr = "no record links this attempt to compute work identities; gunbc.compute outcome records are keyed by work identity only" as NonEmptyStr

// ── the record ────────────────────────────────────────────────────────────────────────────────
// FINAL ONCE NOTHING IT MEASURES CAN CHANGE: every launch's stream has a terminal event and every
// launch's seat is released on the ledger. The standing is derived from the rows (metering_standing_of),
// never stored beside them, so no record can claim a standing its rows do not hold. A Final record is
// never rewritten, so it cannot go stale;
// a Provisional one is rewritten each tick and is never reported as the current meter. A launch
// admitted after a record went Final makes that record inadmissible against the roster, and the
// next tick writes a new Provisional one.
type MeteringStanding = MeteringStandingFinal | MeteringStandingProvisional

type MeteredRoleUsage {
  role: MeteredRole
  tokens: RoleTokens
  seat: SeatHeld
}

type AttemptMeteringRecord {
  node_id: String
  attempt_key: String
  metered_at: EpochSecs
  sealed_roster: String?
  roles: List<MeteredRoleUsage>
  compute: ComputeUsage
}

fn metered_role_usage_final(u: MeteredRoleUsage) -> Bool {
  (match u.tokens {
    TokensObserved { rounds: _, input_tokens: _, output_tokens: _, terminal: t } => t
    TokensStreamAbsent => false
    TokensRefused { cause: _ } => false
  }) && (match u.seat {
    SeatReleased { pointer: _, granted_at: _, released_at: _ } => true
    SeatStillHeld { pointer: _, granted_at: _ } => false
    SeatPointerAbsent => false
    SeatRefused { cause: _ } => false
  })
}

// FINAL ONLY AGAINST A SEALED ROSTER THE RECORD IS BOUND TO, with every row complete. An open roster
// can still grow, so nothing measured against it is final.
fn metering_standing_of(record: AttemptMeteringRecord, seal: String?) -> MeteringStanding {
  match seal {
    Absent => MeteringStandingProvisional
    Present { value: d } =>
      match record.sealed_roster {
        Present { value: bound } =>
          if bound == d && list_length(items: record.roles) > 0 && all(record.roles, u => metered_role_usage_final(u: u)) {
            MeteringStandingFinal
          } else {
            MeteringStandingProvisional
          }
        Absent => MeteringStandingProvisional
      }
  }
}

fn metering_wire_repeats(wires: List<String>) -> Bool {
  any(wires, w => count(filter(wires, x => x == w)) > 1)
}

// THE RECORD IS ADMISSIBLE ONLY AGAINST ITS ROSTER: every launch exactly once, no row outside the
// roster, and no seat reference counted twice. The writer and
// the reader both apply it, so a decoded record can claim no more than a constructed one.
fn metering_row_owner_gap(record: AttemptMeteringRecord, u: MeteredRoleUsage) -> String? {
  let owner = metered_role_seat_owner(node_id: record.node_id, attempt_key: record.attempt_key, role: u.role)
  match u.seat {
    SeatReleased { pointer: p, granted_at: _, released_at: _ } => seat_pointer_owned_by(pointer: p, owner: owner)
    SeatStillHeld { pointer: p, granted_at: _ } => seat_pointer_owned_by(pointer: p, owner: owner)
    SeatPointerAbsent => none
    SeatRefused { cause: _ } => none
  }
}

// THE RECORD IS ADMISSIBLE ONLY AGAINST ITS ROSTER: every launch exactly once, no row outside the
// roster, no seat reference counted twice, every seat pointer owned by exactly the launch whose row
// carries it, and a seal binding only to the roster's own seal. The writer and the reader both apply
// it, so a decoded record can claim no more than a constructed one.
fn metering_record_inadmissible(record: AttemptMeteringRecord, roster: List<MeteredRole>, seal: String?) -> String? {
  let wires = map(record.roles, u => metered_role_wire(role: u.role))
  let roster_wires = map(roster, r => metered_role_wire(role: r))
  let refs = flat_map(record.roles, u => seat_reference(seat: u.seat))
  let owner_gaps = flat_map(record.roles, u => match metering_row_owner_gap(record: record, u: u) { Present { value: c } => [join([metered_role_wire(role: u.role), ": ", c], "")] Absent => [] as List<String> })
  if list_length(items: record.roles) == 0 {
    Present { value: "the record meters no launch; the worker is always launched" }
  } else if metering_wire_repeats(wires: wires) {
    Present { value: "a launch appears more than once in the record" }
  } else if any(roster_wires, w => !any(wires, x => x == w)) {
    Present { value: "a launch in the attempt's roster has no row in the record" }
  } else if any(wires, w => !any(roster_wires, x => x == w)) {
    Present { value: "the record carries a row for a launch the roster does not name" }
  } else if metering_wire_repeats(wires: refs) {
    Present { value: "one seat reference is attributed to more than one launch" }
  } else {
    match owner_gaps.first() {
      Present { value: c } => Present { value: c }
      Absent =>
        match record.sealed_roster {
          Absent => none
          Present { value: bound } =>
            match seal {
              Present { value: d } => if bound == d { none } else { Present { value: "the record binds a roster seal other than the attempt's" } }
              Absent => Present { value: "the record binds a roster seal the attempt does not carry" }
            }
        }
    }
  }
}

type MeteringTokenTotal
  = MeteringTokensObserved { value: TokenCount }
  | MeteringTokensIncomplete { cause: String }

type MeteringSeatTimeTotal
  = MeteringSeatTimeObserved { held: Second }
  | MeteringSeatTimeIncomplete { cause: String }

fn metering_token_total(record: AttemptMeteringRecord, output: Bool) -> MeteringTokenTotal {
  if list_length(items: record.roles) == 0 {
    MeteringTokensIncomplete { cause: "the record meters no launch" }
  } else {
    fold(record.roles, init: MeteringTokensObserved { value: token_count(count: 0) }, f: (acc, u) =>
      match acc {
        MeteringTokensIncomplete { cause: _ } => acc
        MeteringTokensObserved { value: v } =>
          match u.tokens {
            TokensObserved { rounds: _, input_tokens: i, output_tokens: o, terminal: _ } =>
              MeteringTokensObserved { value: token_count_sum(a: v, b: if output { o } else { i }) }
            TokensStreamAbsent =>
              MeteringTokensIncomplete { cause: join([metered_role_wire(role: u.role), ": the launch has no events stream"], "") }
            TokensRefused { cause: c } =>
              MeteringTokensIncomplete { cause: join([metered_role_wire(role: u.role), ": ", c], "") }
          }
      })
  }
}

fn metering_seat_gap(u: MeteredRoleUsage) -> String {
  match u.seat {
    SeatReleased { pointer: _, granted_at: _, released_at: _ } => "the seat was released before it was acquired"
    SeatPointerAbsent => "no seat pointer was written"
    SeatStillHeld { pointer: _, granted_at: _ } => "the seat is not yet released"
    SeatRefused { cause: c } => c
  }
}

fn metering_seat_time_total(record: AttemptMeteringRecord) -> MeteringSeatTimeTotal {
  if list_length(items: record.roles) == 0 {
    MeteringSeatTimeIncomplete { cause: "the record meters no launch" }
  } else {
    fold(record.roles, init: MeteringSeatTimeObserved { held: second(count: 0) }, f: (acc, u) =>
      match acc {
        MeteringSeatTimeIncomplete { cause: _ } => acc
        MeteringSeatTimeObserved { held: v } =>
          match seat_held_seconds(seat: u.seat) {
            Present { value: h } => MeteringSeatTimeObserved { held: second(count: second_count(s: v) + second_count(s: h)) }
            Absent => MeteringSeatTimeIncomplete { cause: join([metered_role_wire(role: u.role), ": ", metering_seat_gap(u: u)], "") }
          }
      })
  }
}

// ── codec ─────────────────────────────────────────────────────────────────────────────────────
data attempt_metering_schema: String = "gunbc-attempt-metering/v4"
data attempt_metering_basename: String = "metering.json"
data attempt_metering_roster_schema: String = "gunbc-attempt-metering-roster/v2"

fn role_tokens_json(t: RoleTokens) -> JsonValue {
  match t {
    TokensObserved { rounds: n, input_tokens: i, output_tokens: o, terminal: term } => json_object(members: [
      json_kv(key: "state", value: json_string(s: "observed")),
      json_kv(key: "rounds", value: json_int(n: n)),
      json_kv(key: "input_tokens", value: json_int(n: token_count_value(t: i))),
      json_kv(key: "output_tokens", value: json_int(n: token_count_value(t: o))),
      json_kv(key: "terminal", value: json_string(s: if term { "yes" } else { "no" })),
    ])
    TokensStreamAbsent => json_object(members: [json_kv(key: "state", value: json_string(s: "absent"))])
    TokensRefused { cause: c } => json_object(members: [
      json_kv(key: "state", value: json_string(s: "refused")),
      json_kv(key: "cause", value: json_string(s: c)),
    ])
  }
}

fn seat_pointer_members(p: HarnessSeatPointer) -> List<JsonKeyValue> {
  [
    json_kv(key: "partition", value: json_string(s: p.partition as String)),
    json_kv(key: "reference", value: json_string(s: p.reference as String)),
    json_kv(key: "owner", value: json_string(s: p.owner as String)),
  ]
}

fn seat_held_json(s: SeatHeld) -> JsonValue {
  match s {
    SeatReleased { pointer: p, granted_at: g, released_at: r } => json_object(members: concat([
      json_kv(key: "state", value: json_string(s: "released")),
      json_kv(key: "granted_at", value: json_int(n: g)),
      json_kv(key: "released_at", value: json_int(n: r)),
    ], seat_pointer_members(p: p)))
    SeatStillHeld { pointer: p, granted_at: g } => json_object(members: concat([
      json_kv(key: "state", value: json_string(s: "held")),
      json_kv(key: "granted_at", value: json_int(n: g)),
    ], seat_pointer_members(p: p)))
    SeatPointerAbsent => json_object(members: [json_kv(key: "state", value: json_string(s: "pointer-absent"))])
    SeatRefused { cause: c } => json_object(members: [
      json_kv(key: "state", value: json_string(s: "refused")),
      json_kv(key: "cause", value: json_string(s: c)),
    ])
  }
}

fn compute_usage_json(c: ComputeUsage) -> JsonValue {
  match c {
    ComputeNotAttributable { reason: r } => json_object(members: [
      json_kv(key: "state", value: json_string(s: "not-attributable")),
      json_kv(key: "reason", value: json_string(s: r as String)),
    ])
  }
}

fn attempt_metering_json(record: AttemptMeteringRecord) -> String {
  serialize_json(v: json_object(members: [
    json_kv(key: "schema", value: json_string(s: attempt_metering_schema)),
    json_kv(key: "node_id", value: json_string(s: record.node_id)),
    json_kv(key: "attempt_key", value: json_string(s: record.attempt_key)),
    json_kv(key: "metered_at", value: json_int(n: record.metered_at)),
    json_kv(key: "sealed_roster", value: match record.sealed_roster { Present { value: d } => json_string(s: d) Absent => JsonNull }),
    json_kv(key: "roles", value: json_array(elements: map(record.roles, u => json_object(members: [
      json_kv(key: "role", value: metered_role_json(role: u.role)),
      json_kv(key: "tokens", value: role_tokens_json(t: u.tokens)),
      json_kv(key: "seat", value: seat_held_json(s: u.seat)),
    ])))),
    json_kv(key: "compute", value: compute_usage_json(c: record.compute)),
  ]))
}

type MemberTextRead
  = MemberText { value: String }
  | MemberTextGap { cause: String }

fn metering_member_text(doc: JsonValue, key: String) -> MemberTextRead {
  match json_object_unique_member(v: doc, key: key) {
    JsonMemberFound { value: v } =>
      match v {
        JsonString { value: s } => if trim(s) == "" { MemberTextGap { cause: join(["'", key, "' is empty"], "") } } else { MemberText { value: s } }
        JsonNull => MemberTextGap { cause: join(["'", key, "' is not a string"], "") }
        JsonBool { value: _ } => MemberTextGap { cause: join(["'", key, "' is not a string"], "") }
        JsonNumber { lexeme: _ } => MemberTextGap { cause: join(["'", key, "' is not a string"], "") }
        JsonArray { elements: _ } => MemberTextGap { cause: join(["'", key, "' is not a string"], "") }
        JsonObject { members: _ } => MemberTextGap { cause: join(["'", key, "' is not a string"], "") }
      }
    JsonMemberAbsent => MemberTextGap { cause: join(["'", key, "' is missing"], "") }
    JsonMemberDuplicated { count: _ } => MemberTextGap { cause: join(["'", key, "' is duplicated"], "") }
    JsonMemberNotAnObject => MemberTextGap { cause: "is not a JSON object" }
  }
}

type MemberIntRead
  = MemberInt { value: Int }
  | MemberIntGap { cause: String }

fn metering_member_int(doc: JsonValue, key: String) -> MemberIntRead {
  match harness_member_int(doc: doc, key: key) {
    IntRead { value: n } => MemberInt { value: n }
    IntAbsent => MemberIntGap { cause: harness_int_read_gap(key: key, read: IntAbsent) }
    IntDuplicated => MemberIntGap { cause: harness_int_read_gap(key: key, read: IntDuplicated) }
    IntNotAnObject => MemberIntGap { cause: harness_int_read_gap(key: key, read: IntNotAnObject) }
    IntNotANumber => MemberIntGap { cause: harness_int_read_gap(key: key, read: IntNotANumber) }
    IntNotAnInteger { lexeme: lx } => MemberIntGap { cause: harness_int_read_gap(key: key, read: IntNotAnInteger { lexeme: lx }) }
  }
}

type MemberValueRead
  = MemberValue { value: JsonValue }
  | MemberValueGap { cause: String }

fn metering_member_value(doc: JsonValue, key: String) -> MemberValueRead {
  match json_object_unique_member(v: doc, key: key) {
    JsonMemberFound { value: v } => MemberValue { value: v }
    JsonMemberAbsent => MemberValueGap { cause: join(["'", key, "' is missing"], "") }
    JsonMemberDuplicated { count: _ } => MemberValueGap { cause: join(["'", key, "' is duplicated"], "") }
    JsonMemberNotAnObject => MemberValueGap { cause: "is not a JSON object" }
  }
}

type MemberArrayRead
  = MemberArray { elements: List<JsonValue> }
  | MemberArrayGap { cause: String }

fn metering_member_array(doc: JsonValue, key: String) -> MemberArrayRead {
  match metering_member_value(doc: doc, key: key) {
    MemberValueGap { cause: c } => MemberArrayGap { cause: c }
    MemberValue { value: v } =>
      match v {
        JsonArray { elements: es } => MemberArray { elements: es }
        JsonNull => MemberArrayGap { cause: join(["'", key, "' is not an array"], "") }
        JsonBool { value: _ } => MemberArrayGap { cause: join(["'", key, "' is not an array"], "") }
        JsonNumber { lexeme: _ } => MemberArrayGap { cause: join(["'", key, "' is not an array"], "") }
        JsonString { value: _ } => MemberArrayGap { cause: join(["'", key, "' is not an array"], "") }
        JsonObject { members: _ } => MemberArrayGap { cause: join(["'", key, "' is not an array"], "") }
      }
  }
}

type RowDecode<T>
  = RowDecoded { row: T }
  | RowUndecodable { cause: String }

fn rows_decode<T>(elements: List<JsonValue>, decode: fn(JsonValue) -> RowDecode<T>) -> RowDecode<List<T>> {
  let decoded = map(elements, e => decode(e))
  match fold(decoded, init: none, f: (acc, d) =>
    match acc {
      Present { value: c } => Present { value: c }
      Absent => match d { RowUndecodable { cause: c } => Present { value: c } RowDecoded { row: _ } => none }
    }) {
    Present { value: c } => RowUndecodable { cause: c }
    Absent => RowDecoded { row: flat_map(decoded, d => match d { RowDecoded { row: x } => [x] RowUndecodable { cause: _ } => [] as List<T> }) }
  }
}

fn role_tokens_decode(v: JsonValue) -> RowDecode<RoleTokens> {
  match metering_member_text(doc: v, key: "state") {
    MemberTextGap { cause: c } => RowUndecodable { cause: join(["a token row ", c], "") }
    MemberText { value: st } =>
      if st == "absent" {
        RowDecoded { row: TokensStreamAbsent }
      } else if st == "refused" {
        match metering_member_text(doc: v, key: "cause") {
          MemberTextGap { cause: c } => RowUndecodable { cause: join(["a refused token row ", c], "") }
          MemberText { value: c } => RowDecoded { row: TokensRefused { cause: c } }
        }
      } else if st == "observed" {
        match metering_member_int(doc: v, key: "rounds") {
          MemberIntGap { cause: c } => RowUndecodable { cause: c }
          MemberInt { value: n } =>
            match metering_member_int(doc: v, key: "input_tokens") {
              MemberIntGap { cause: c } => RowUndecodable { cause: c }
              MemberInt { value: i } =>
                match metering_member_int(doc: v, key: "output_tokens") {
                  MemberIntGap { cause: c } => RowUndecodable { cause: c }
                  MemberInt { value: o } =>
                    match metering_member_text(doc: v, key: "terminal") {
                      MemberTextGap { cause: c } => RowUndecodable { cause: join(["a token row ", c], "") }
                      MemberText { value: t } =>
                        if t == "yes" || t == "no" {
                          match metering_round_row(input_tokens: i, output_tokens: o) {
                            StrictLineRow { input_tokens: ti, output_tokens: to } =>
                              RowDecoded { row: TokensObserved { rounds: n, input_tokens: ti, output_tokens: to, terminal: t == "yes" } }
                            StrictLineRefused { cause: c } => RowUndecodable { cause: c }
                            StrictLineSkipped => RowUndecodable { cause: "a token row carries no counts" }
                          }
                        } else {
                          RowUndecodable { cause: "a token row's 'terminal' is neither yes nor no" }
                        }
                    }
                }
            }
        }
      } else {
        RowUndecodable { cause: join(["unknown token row state ", st], "") }
      }
  }
}

fn seat_pointer_members_decode(v: JsonValue) -> RowDecode<HarnessSeatPointer> {
  match metering_member_text(doc: v, key: "partition") {
    MemberTextGap { cause: c } => RowUndecodable { cause: join(["a seat row ", c], "") }
    MemberText { value: p } =>
      match metering_member_text(doc: v, key: "reference") {
        MemberTextGap { cause: c } => RowUndecodable { cause: join(["a seat row ", c], "") }
        MemberText { value: r } =>
          match metering_member_text(doc: v, key: "owner") {
            MemberTextGap { cause: c } => RowUndecodable { cause: join(["a seat row ", c], "") }
            MemberText { value: o } =>
              RowDecoded { row: HarnessSeatPointer { partition: p as NonEmptyStr as PartitionId, reference: r as NonEmptyStr, owner: o as NonEmptyStr } }
          }
      }
  }
}

fn seat_held_decode(v: JsonValue) -> RowDecode<SeatHeld> {
  match metering_member_text(doc: v, key: "state") {
    MemberTextGap { cause: c } => RowUndecodable { cause: join(["a seat row ", c], "") }
    MemberText { value: st } =>
      if st == "pointer-absent" {
        RowDecoded { row: SeatPointerAbsent }
      } else if st == "refused" {
        match metering_member_text(doc: v, key: "cause") {
          MemberTextGap { cause: c } => RowUndecodable { cause: join(["a refused seat row ", c], "") }
          MemberText { value: c } => RowDecoded { row: SeatRefused { cause: c } }
        }
      } else if st == "held" || st == "released" {
        match seat_pointer_members_decode(v: v) {
          RowUndecodable { cause: c } => RowUndecodable { cause: c }
          RowDecoded { row: p } =>
            match metering_member_int(doc: v, key: "granted_at") {
              MemberIntGap { cause: c } => RowUndecodable { cause: c }
              MemberInt { value: g } =>
                if st == "held" {
                  RowDecoded { row: SeatStillHeld { pointer: p, granted_at: g } }
                } else {
                  match metering_member_int(doc: v, key: "released_at") {
                    MemberIntGap { cause: c } => RowUndecodable { cause: c }
                    MemberInt { value: r } =>
                      if r < g {
                        RowUndecodable { cause: "a seat row is released before it was granted" }
                      } else {
                        RowDecoded { row: SeatReleased { pointer: p, granted_at: g, released_at: r } }
                      }
                  }
                }
            }
        }
      } else {
        RowUndecodable { cause: join(["unknown seat row state ", st], "") }
      }
  }
}

fn metered_role_usage_decode(v: JsonValue) -> RowDecode<MeteredRoleUsage> {
  match metering_member_value(doc: v, key: "role") {
    MemberValueGap { cause: c } => RowUndecodable { cause: join(["a launch row ", c], "") }
    MemberValue { value: rv } =>
      match metered_role_decode(v: rv) {
        RowUndecodable { cause: c } => RowUndecodable { cause: c }
        RowDecoded { row: role } =>
          match metering_member_value(doc: v, key: "tokens") {
            MemberValueGap { cause: c } => RowUndecodable { cause: join(["a launch row ", c], "") }
            MemberValue { value: tv } =>
              match role_tokens_decode(v: tv) {
                RowUndecodable { cause: c } => RowUndecodable { cause: c }
                RowDecoded { row: tokens } =>
                  match metering_member_value(doc: v, key: "seat") {
                    MemberValueGap { cause: c } => RowUndecodable { cause: join(["a launch row ", c], "") }
                    MemberValue { value: sv } =>
                      match seat_held_decode(v: sv) {
                        RowUndecodable { cause: c } => RowUndecodable { cause: c }
                        RowDecoded { row: seat } => RowDecoded { row: MeteredRoleUsage { role: role, tokens: tokens, seat: seat } }
                      }
                  }
              }
          }
      }
  }
}

fn compute_usage_decode(doc: JsonValue) -> RowDecode<ComputeUsage> {
  match metering_member_value(doc: doc, key: "compute") {
    MemberValueGap { cause: c } => RowUndecodable { cause: join(["the metering record ", c], "") }
    MemberValue { value: v } =>
      match metering_member_text(doc: v, key: "state") {
        MemberTextGap { cause: c } => RowUndecodable { cause: join(["the compute row ", c], "") }
        MemberText { value: st } =>
          if st == "not-attributable" {
            match metering_member_text(doc: v, key: "reason") {
              MemberTextGap { cause: c } => RowUndecodable { cause: join(["the compute row ", c], "") }
              MemberText { value: r } => RowDecoded { row: ComputeNotAttributable { reason: r as NonEmptyStr } }
            }
          } else {
            RowUndecodable { cause: join(["unknown compute state ", st], "") }
          }
      }
  }
}

fn metering_sealed_roster_decode(v: JsonValue) -> RowDecode<String?> {
  match v {
    JsonNull => RowDecoded { row: none }
    JsonString { value: d } => if trim(d) == "" { RowUndecodable { cause: "the record's sealed_roster is empty" } } else { RowDecoded { row: Present { value: d } } }
    JsonBool { value: _ } => RowUndecodable { cause: "the record's sealed_roster is neither null nor a digest" }
    JsonNumber { lexeme: _ } => RowUndecodable { cause: "the record's sealed_roster is neither null nor a digest" }
    JsonArray { elements: _ } => RowUndecodable { cause: "the record's sealed_roster is neither null nor a digest" }
    JsonObject { members: _ } => RowUndecodable { cause: "the record's sealed_roster is neither null nor a digest" }
  }
}

fn attempt_metering_decode(raw: String) -> RowDecode<AttemptMeteringRecord> {
  match parse_json_document(s: raw) {
    JsonDocumentUnreadable { gap: _ } => RowUndecodable { cause: "the metering record is not a JSON document" }
    JsonDocumentParsed { value: doc } =>
      match metering_member_text(doc: doc, key: "schema") {
        MemberTextGap { cause: c } => RowUndecodable { cause: join(["the metering record ", c], "") }
        MemberText { value: schema } =>
          if schema != attempt_metering_schema {
            RowUndecodable { cause: join(["unknown metering schema ", schema], "") }
          } else {
            match metering_member_text(doc: doc, key: "node_id") {
              MemberTextGap { cause: c } => RowUndecodable { cause: join(["the metering record ", c], "") }
              MemberText { value: node } =>
                match metering_member_text(doc: doc, key: "attempt_key") {
                  MemberTextGap { cause: c } => RowUndecodable { cause: join(["the metering record ", c], "") }
                  MemberText { value: key } =>
                    match metering_member_int(doc: doc, key: "metered_at") {
                      MemberIntGap { cause: c } => RowUndecodable { cause: c }
                      MemberInt { value: at } =>
                        match metering_member_value(doc: doc, key: "sealed_roster") {
                          MemberValueGap { cause: c } => RowUndecodable { cause: join(["the metering record ", c], "") }
                          MemberValue { value: sv } =>
                            match metering_sealed_roster_decode(v: sv) {
                            RowUndecodable { cause: c } => RowUndecodable { cause: c }
                            RowDecoded { row: sealed } =>
                            match metering_member_array(doc: doc, key: "roles") {
                              MemberArrayGap { cause: c } => RowUndecodable { cause: c }
                              MemberArray { elements: rows } =>
                                match rows_decode(elements: rows, decode: fn(v) { metered_role_usage_decode(v: v) }) {
                                  RowUndecodable { cause: c } => RowUndecodable { cause: c }
                                  RowDecoded { row: roles } =>
                                    match compute_usage_decode(doc: doc) {
                                      RowUndecodable { cause: c } => RowUndecodable { cause: c }
                                      RowDecoded { row: compute } =>
                                        RowDecoded { row: AttemptMeteringRecord {
                                          node_id: node, attempt_key: key, metered_at: at, sealed_roster: sealed,
                                          roles: roles, compute: compute,
                                        } }
                                    }
                                }
                            }
                            }
                        }
                    }
                }
            }
          }
      }
  }
}

// ── the launch roster ─────────────────────────────────────────────────────────────────────────
// APPEND-ONLY AND SEALABLE. Each launch is one create-only entry file in the attempt's state directory
// (metering-launch.<key>.json), so two concurrent admissions commit two entries and neither can erase
// the other; the worker is a member without an entry. The roster closes when the attempt leaves the
// belt's workflow ledger (belt_metering_attempts_for_instance): the sealer writes a create-only
// closing marker, THEN lists the entries, THEN writes the seal carrying that population and its
// digest. An admission writes its entry and THEN reads the marker, refusing its spawn when the marker
// is present -- so a racing admission either lands in the sealed listing or refuses. The seal is sound
// only while every harness spawner iterates that ledger; a spawner that bypasses it would admit after
// a seal it cannot see.
data metering_launch_entry_prefix: String = "metering-launch."
data metering_roster_closing_basename: String = "metering-roster-closing"
data metering_roster_seal_basename: String = "metering-roster-sealed.json"

fn metering_length_prefixed(parts: List<String>) -> String {
  join(map(parts, p => join([to_string(string_length(s: p)), ".", p], "")), ".")
}

fn metered_role_key(role: MeteredRole) -> String {
  match role {
    MeteredWorker => "worker"
    MeteredReviewer { criterion_key: c, head: h } => join(["reviewer.", metering_length_prefixed(parts: [c as String, h as String])], "")
    MeteredAuditor { head: h } => join(["auditor.", metering_length_prefixed(parts: [h as String])], "")
    MeteredSupervisor { turn: t } => join(["supervisor.", to_string(t)], "")
  }
}

fn metering_launch_entry_name(role: MeteredRole) -> String {
  join([metering_launch_entry_prefix, metered_role_key(role: role), ".json"], "")
}

fn metering_roster_entry_json(node_id: String, attempt_key: String, role: MeteredRole) -> String {
  serialize_json(v: json_object(members: [
    json_kv(key: "schema", value: json_string(s: attempt_metering_roster_schema)),
    json_kv(key: "node_id", value: json_string(s: node_id)),
    json_kv(key: "attempt_key", value: json_string(s: attempt_key)),
    json_kv(key: "launch", value: metered_role_json(role: role)),
  ]))
}

fn metering_attempt_member_check(doc: JsonValue, node_id: String, attempt_key: String, what: String) -> String? {
  match metering_member_text(doc: doc, key: "node_id") {
    MemberTextGap { cause: c } => Present { value: join([what, " ", c], "") }
    MemberText { value: n } =>
      match metering_member_text(doc: doc, key: "attempt_key") {
        MemberTextGap { cause: c } => Present { value: join([what, " ", c], "") }
        MemberText { value: k } =>
          if n != node_id || k != attempt_key { Present { value: join([what, " names ", n, "-a", k], "") } } else { none }
      }
  }
}

fn metering_schema_check(doc: JsonValue, schema: String, what: String) -> String? {
  match metering_member_text(doc: doc, key: "schema") {
    MemberTextGap { cause: c } => Present { value: join([what, " ", c], "") }
    MemberText { value: s } => if s != schema { Present { value: join(["unknown ", what, " schema ", s], "") } } else { none }
  }
}

// ONE ENTRY, BY ITS FILE NAME AND CONTENT: the entry must name this attempt and the launch its name
// encodes, so an entry cannot be renamed into another launch's place.
fn metering_roster_entry_decode(node_id: String, attempt_key: String, name: String, raw: String) -> RowDecode<MeteredRole> {
  match parse_json_document(s: raw) {
    JsonDocumentUnreadable { gap: _ } => RowUndecodable { cause: join(["the roster entry ", name, " is not a JSON document"], "") }
    JsonDocumentParsed { value: doc } =>
      match metering_schema_check(doc: doc, schema: attempt_metering_roster_schema, what: "roster entry") {
        Present { value: c } => RowUndecodable { cause: c }
        Absent =>
          match metering_attempt_member_check(doc: doc, node_id: node_id, attempt_key: attempt_key, what: join(["the roster entry ", name], "")) {
            Present { value: c } => RowUndecodable { cause: c }
            Absent =>
              match metering_member_value(doc: doc, key: "launch") {
                MemberValueGap { cause: c } => RowUndecodable { cause: join(["the roster entry ", name, " ", c], "") }
                MemberValue { value: v } =>
                  match metered_role_decode(v: v) {
                    RowUndecodable { cause: c } => RowUndecodable { cause: c }
                    RowDecoded { row: role } =>
                      if metering_launch_entry_name(role: role) != name || metered_role_eq(a: role, b: MeteredWorker) {
                        RowUndecodable { cause: join(["the roster entry ", name, " does not carry the launch its name encodes"], "") }
                      } else {
                        RowDecoded { row: role }
                      }
                  }
              }
          }
      }
  }
}

type RosterEntryText {
  name: String
  content: String
}

// The open population: the worker, then every committed entry. Entries are never rewritten, so the
// union is monotone in time -- a later listing can only add.
fn metering_roster_from_entries(node_id: String, attempt_key: String, entries: List<RosterEntryText>) -> MeteringRoster {
  let decoded = map(entries, e => metering_roster_entry_decode(node_id: node_id, attempt_key: attempt_key, name: e.name, raw: e.content))
  match fold(decoded, init: none, f: (acc, d) =>
    match acc {
      Present { value: c } => Present { value: c }
      Absent => match d { RowUndecodable { cause: c } => Present { value: c } RowDecoded { row: _ } => none }
    }) {
    Present { value: c } => RosterRefused { cause: c }
    Absent => RosterOpen { launches: concat([MeteredWorker], flat_map(decoded, d => match d { RowDecoded { row: r } => [r] RowUndecodable { cause: _ } => [] as List<MeteredRole> })) }
  }
}

fn metering_roster_digest(launches: List<MeteredRole>) -> String {
  content_hash_tagged_structural(
    tag: "gunbc-attempt-metering-roster" as NonEmptyStr,
    payload: content_hash_atom(value: join(concat(["roster"], map(launches, r => metered_role_wire(role: r))), "\n") as NonEmptyStr),
  ).digest as String
}

fn metering_roster_seal_json(node_id: String, attempt_key: String, launches: List<MeteredRole>) -> String {
  serialize_json(v: json_object(members: [
    json_kv(key: "schema", value: json_string(s: attempt_metering_roster_schema)),
    json_kv(key: "node_id", value: json_string(s: node_id)),
    json_kv(key: "attempt_key", value: json_string(s: attempt_key)),
    json_kv(key: "launches", value: json_array(elements: map(launches, r => metered_role_json(role: r)))),
    json_kv(key: "digest", value: json_string(s: metering_roster_digest(launches: launches))),
  ]))
}

type MeteringRoster
  = RosterOpen { launches: List<MeteredRole> }
  | RosterSealed { launches: List<MeteredRole>, digest: String }
  | RosterRefused { cause: String }

fn metering_roster_launches(roster: MeteringRoster) -> List<MeteredRole> {
  match roster {
    RosterOpen { launches: ls } => ls
    RosterSealed { launches: ls, digest: _ } => ls
    RosterRefused { cause: _ } => [] as List<MeteredRole>
  }
}

// THE SEAL CARRIES ITS POPULATION AND A DIGEST OF IT; a seal whose digest does not match its own
// launches, that names another attempt, that lacks the worker or names a launch twice refuses.
fn metering_roster_seal_decode(node_id: String, attempt_key: String, raw: String) -> MeteringRoster {
  match parse_json_document(s: raw) {
    JsonDocumentUnreadable { gap: _ } => RosterRefused { cause: "the roster seal is not a JSON document" }
    JsonDocumentParsed { value: doc } =>
      match metering_schema_check(doc: doc, schema: attempt_metering_roster_schema, what: "roster seal") {
        Present { value: c } => RosterRefused { cause: c }
        Absent =>
          match metering_attempt_member_check(doc: doc, node_id: node_id, attempt_key: attempt_key, what: "the roster seal") {
            Present { value: c } => RosterRefused { cause: c }
            Absent =>
              match metering_member_array(doc: doc, key: "launches") {
                MemberArrayGap { cause: c } => RosterRefused { cause: c }
                MemberArray { elements: es } =>
                  match rows_decode(elements: es, decode: fn(v) { metered_role_decode(v: v) }) {
                    RowUndecodable { cause: c } => RosterRefused { cause: c }
                    RowDecoded { row: launches } =>
                      match metering_member_text(doc: doc, key: "digest") {
                        MemberTextGap { cause: c } => RosterRefused { cause: join(["the roster seal ", c], "") }
                        MemberText { value: d } =>
                          if d != metering_roster_digest(launches: launches) {
                            RosterRefused { cause: "the roster seal's digest does not match its launches" }
                          } else if !any(launches, r => metered_role_eq(a: r, b: MeteredWorker)) {
                            RosterRefused { cause: "the roster seal does not name the worker" }
                          } else if metering_wire_repeats(wires: map(launches, r => metered_role_wire(role: r))) {
                            RosterRefused { cause: "the roster seal names one launch more than once" }
                          } else {
                            RosterSealed { launches: launches, digest: d }
                          }
                      }
                  }
              }
          }
      }
  }
}

type OptionalFileRead
  = OptionalFileContent { content: String }
  | OptionalFileAbsent
  | OptionalFileRefused { cause: String }

// Absence is established from the directory listing, so an unlistable directory refuses rather than
// reading as an empty one.
fn metering_read_file(path: String) -> OptionalFileRead {
  let parts = split(s: path, delimiter: "/")
  let dir = join(take(parts, list_length(items: parts) - 1), "/")
  let name = fold(parts, init: "", f: (_a, x) => x)
  let listing = Filesystem.List(path: dir)
  let read = Filesystem.Read(path: path)
  match filesystem_file_observation(
    listing: filesystem_listing_observation(directory: dir, success: listing.success, entries: listing.entries, error: listing.error),
    name: name,
    path: path,
    read: filesystem_read_outcome(content: read.content, success: read.success, error: read.error),
  ) {
    FilesystemFileAbsent(_) => OptionalFileAbsent
    FilesystemFileRead { path: _, content: c } => OptionalFileContent { content: c }
    FilesystemFileIndeterminate { cause: c } => OptionalFileRefused { cause: c }
    FilesystemFileObservationsDisagree { path: _, cause: c } => OptionalFileRefused { cause: c }
    FilesystemFileSubjectRefused { directory: _, name: _, cause: c } => OptionalFileRefused { cause: c }
  }
}

type MeteringListing
  = MeteringListed { names: List<String> }
  | MeteringListingRefused { cause: String }

fn metering_list(dir: String) -> MeteringListing {
  let listing = Filesystem.List(path: dir)
  match filesystem_listing_observation(directory: dir, success: listing.success, entries: listing.entries, error: listing.error) {
    FilesystemDirectoryListed(l) => MeteringListed { names: filesystem_listing_entry_names(listing: l) }
    FilesystemDirectoryListingRefused { directory: _, error: e } => MeteringListingRefused { cause: join(["the directory could not be listed: ", e], "") }
    FilesystemDirectorySubjectRefused { directory: _, cause: c } => MeteringListingRefused { cause: c }
  }
}

fn metering_attempt_dir(instance: HostDashboardInstance, node_id: RoadmapNodeId, attempt_key: String) -> String {
  dispatch_attempt_state_path_for_instance(instance: instance, node_id: node_id, attempt_key: attempt_key)
}

fn metering_open_roster_for_attempt(instance: HostDashboardInstance, node_id: RoadmapNodeId, attempt_key: String) -> MeteringRoster {
  let dir = metering_attempt_dir(instance: instance, node_id: node_id, attempt_key: attempt_key)
  match metering_list(dir: dir) {
    MeteringListingRefused { cause: c } => RosterRefused { cause: c }
    MeteringListed { names: names } => {
      let entry_names = filter(names, n => starts_with(s: n, prefix: metering_launch_entry_prefix))
      let reads = map(entry_names, n => RosterEntryRead { name: n, read: metering_read_file(path: join([dir, "/", n], "")) })
      match fold(reads, init: none, f: (acc, r) =>
        match acc {
          Present { value: c } => Present { value: c }
          Absent =>
            match r.read {
              OptionalFileContent { content: _ } => none
              OptionalFileAbsent => Present { value: join(["the roster entry ", r.name, " vanished while it was read"], "") }
              OptionalFileRefused { cause: c } => Present { value: c }
            }
        }) {
        Present { value: c } => RosterRefused { cause: c }
        Absent =>
          metering_roster_from_entries(node_id: node_id as String, attempt_key: attempt_key, entries: flat_map(reads, r =>
            match r.read {
              OptionalFileContent { content: c } => [RosterEntryText { name: r.name, content: c }]
              OptionalFileAbsent => [] as List<RosterEntryText>
              OptionalFileRefused { cause: _ } => [] as List<RosterEntryText>
            }))
      }
    }
  }
}

type RosterEntryRead {
  name: String
  read: OptionalFileRead
}

// A sealed roster is the seal's population; entries committed after the seal belong to launches that
// refused to spawn and are not members.
fn metering_roster_for_attempt(instance: HostDashboardInstance, node_id: RoadmapNodeId, attempt_key: String) -> MeteringRoster {
  match metering_read_file(path: join([metering_attempt_dir(instance: instance, node_id: node_id, attempt_key: attempt_key), "/", metering_roster_seal_basename], "")) {
    OptionalFileRefused { cause: c } => RosterRefused { cause: c }
    OptionalFileContent { content: raw } => metering_roster_seal_decode(node_id: node_id as String, attempt_key: attempt_key, raw: raw)
    OptionalFileAbsent => metering_open_roster_for_attempt(instance: instance, node_id: node_id, attempt_key: attempt_key)
  }
}

type MeteringRosterAdmission
  = RosterAdmitted
  | RosterAdmissionRefused { cause: String }

// THE SECOND HALF OF ADMISSION, AFTER THE ENTRY IS COMMITTED: a closing marker means the roster may
// already have been listed for its seal, so this launch must not spawn.
fn metering_admission_after_entry(closing: OptionalFileRead) -> MeteringRosterAdmission {
  match closing {
    OptionalFileAbsent => RosterAdmitted
    OptionalFileContent { content: _ } => RosterAdmissionRefused { cause: "the attempt's launch roster is closed; no further launch may be admitted" }
    OptionalFileRefused { cause: c } => RosterAdmissionRefused { cause: join(["the roster closing marker is unreadable: ", c], "") }
  }
}

// THE BELT CALLS THIS BEFORE IT SPAWNS A REVIEWER, AUDITOR OR SUPERVISOR, and does not spawn on a
// refusal. The entry is create-only; an existing entry for the same launch is the same admission.
fn metering_roster_admit(instance: HostDashboardInstance, node_id: RoadmapNodeId, attempt_key: String, role: MeteredRole) -> MeteringRosterAdmission {
  let dir = metering_attempt_dir(instance: instance, node_id: node_id, attempt_key: attempt_key)
  let name = metering_launch_entry_name(role: role)
  if !path_segment_is_safe(raw: name) {
    RosterAdmissionRefused { cause: join(["the launch key ", name, " is not a safe file name"], "") }
  } else {
    let content = metering_roster_entry_json(node_id: node_id as String, attempt_key: attempt_key, role: role)
    let w = Filesystem.WriteCreateNew(path: join([dir, "/", name], ""), content: content)
    let committed = match filesystem_create_new(path: join([dir, "/", name], ""), success: w.success, error: w.error, error_kind: w.error_kind) {
      FilesystemCreated { path: _ } => none
      FilesystemCreateTargetOccupied { path: p } =>
        match metering_read_file(path: p) {
          OptionalFileContent { content: existing } =>
            match metering_roster_entry_decode(node_id: node_id as String, attempt_key: attempt_key, name: name, raw: existing) {
              RowDecoded { row: _ } => none
              RowUndecodable { cause: c } => Present { value: c }
            }
          OptionalFileAbsent => Present { value: "the roster entry was occupied and then absent" }
          OptionalFileRefused { cause: c } => Present { value: c }
        }
      FilesystemCreateRefused { path: _, kind: _, error: e } => Present { value: join(["the roster entry could not be written: ", e], "") }
      FilesystemCreateKindUnrecognized { path: _, observed: _, error: e } => Present { value: join(["the roster entry could not be written: ", e], "") }
    }
    match committed {
      Present { value: c } => RosterAdmissionRefused { cause: c }
      Absent => metering_admission_after_entry(closing: metering_read_file(path: join([dir, "/", metering_roster_closing_basename], "")))
    }
  }
}

fn metering_create_only(path: String, content: String) -> String? {
  let w = Filesystem.WriteCreateNew(path: path, content: content)
  match filesystem_create_new(path: path, success: w.success, error: w.error, error_kind: w.error_kind) {
    FilesystemCreated { path: _ } => none
    FilesystemCreateTargetOccupied { path: _ } => none
    FilesystemCreateRefused { path: _, kind: _, error: e } => Present { value: e }
    FilesystemCreateKindUnrecognized { path: _, observed: _, error: e } => Present { value: e }
  }
}

// SEAL, ONLY FOR AN ATTEMPT THAT HAS LEFT THE WORKFLOW LEDGER: marker, then listing, then the seal.
// A seal already written is the seal; a second sealer's create-only write loses and reads it.
fn metering_roster_seal(instance: HostDashboardInstance, node_id: RoadmapNodeId, attempt_key: String) -> MeteringRoster {
  let dir = metering_attempt_dir(instance: instance, node_id: node_id, attempt_key: attempt_key)
  match metering_create_only(path: join([dir, "/", metering_roster_closing_basename], ""), content: "closed: the attempt left the workflow ledger") {
    Present { value: e } => RosterRefused { cause: join(["the roster closing marker could not be written: ", e], "") }
    Absent =>
      match metering_open_roster_for_attempt(instance: instance, node_id: node_id, attempt_key: attempt_key) {
        RosterRefused { cause: c } => RosterRefused { cause: c }
        RosterSealed { launches: _, digest: _ } => RosterRefused { cause: "unreachable: an open listing returned a seal" }
        RosterOpen { launches: ls } =>
          match metering_create_only(path: join([dir, "/", metering_roster_seal_basename], ""), content: metering_roster_seal_json(node_id: node_id as String, attempt_key: attempt_key, launches: ls)) {
            Present { value: e } => RosterRefused { cause: join(["the roster seal could not be written: ", e], "") }
            Absent => metering_roster_for_attempt(instance: instance, node_id: node_id, attempt_key: attempt_key)
          }
      }
  }
}

// ── the attempt index: which attempts the belt has seen, so a departed one can still be sealed ──
data metering_attempt_index_prefix: String = "metering-attempt."

fn metering_attempt_index_name(node_id: String, attempt_key: String) -> String {
  join([metering_attempt_index_prefix, metering_length_prefixed(parts: [node_id, attempt_key]), ".json"], "")
}

fn metering_attempt_index_json(node_id: String, attempt_key: String) -> String {
  serialize_json(v: json_object(members: [
    json_kv(key: "schema", value: json_string(s: attempt_metering_roster_schema)),
    json_kv(key: "node_id", value: json_string(s: node_id)),
    json_kv(key: "attempt_key", value: json_string(s: attempt_key)),
  ]))
}

type MeteredAttempt {
  node_id: String
  attempt_key: String
}

fn metering_attempt_index_decode(name: String, raw: String) -> RowDecode<MeteredAttempt> {
  match parse_json_document(s: raw) {
    JsonDocumentUnreadable { gap: _ } => RowUndecodable { cause: join(["the attempt index entry ", name, " is not a JSON document"], "") }
    JsonDocumentParsed { value: doc } =>
      match metering_member_text(doc: doc, key: "node_id") {
        MemberTextGap { cause: c } => RowUndecodable { cause: join(["the attempt index entry ", name, " ", c], "") }
        MemberText { value: n } =>
          match metering_member_text(doc: doc, key: "attempt_key") {
            MemberTextGap { cause: c } => RowUndecodable { cause: join(["the attempt index entry ", name, " ", c], "") }
            MemberText { value: k } =>
              if metering_attempt_index_name(node_id: n, attempt_key: k) != name {
                RowUndecodable { cause: join(["the attempt index entry ", name, " does not name the attempt its name encodes"], "") }
              } else {
                RowDecoded { row: MeteredAttempt { node_id: n, attempt_key: k } }
              }
          }
      }
  }
}

fn metering_attempt_index_admit(instance: HostDashboardInstance, node_id: String, attempt_key: String) -> String? {
  metering_create_only(
    path: join([dashboard_instance_dispatch_attempt_state_root(instance: instance) as String, "/", metering_attempt_index_name(node_id: node_id, attempt_key: attempt_key)], ""),
    content: metering_attempt_index_json(node_id: node_id, attempt_key: attempt_key),
  )
}

type MeteredAttempts
  = MeteredAttemptsObserved { attempts: List<MeteredAttempt> }
  | MeteredAttemptsRefused { cause: String }

fn metering_attempt_index(instance: HostDashboardInstance) -> MeteredAttempts {
  let root = dashboard_instance_dispatch_attempt_state_root(instance: instance) as String
  match metering_list(dir: root) {
    MeteringListingRefused { cause: c } => MeteredAttemptsRefused { cause: c }
    MeteringListed { names: names } => {
      let decoded = map(filter(names, n => starts_with(s: n, prefix: metering_attempt_index_prefix)), n =>
        match metering_read_file(path: join([root, "/", n], "")) {
          OptionalFileContent { content: c } => metering_attempt_index_decode(name: n, raw: c)
          OptionalFileAbsent => RowUndecodable { cause: join(["the attempt index entry ", n, " vanished while it was read"], "") }
          OptionalFileRefused { cause: c } => RowUndecodable { cause: c }
        })
      match fold(decoded, init: none, f: (acc, d) =>
        match acc {
          Present { value: c } => Present { value: c }
          Absent => match d { RowUndecodable { cause: c } => Present { value: c } RowDecoded { row: _ } => none }
        }) {
        Present { value: c } => MeteredAttemptsRefused { cause: c }
        Absent => MeteredAttemptsObserved { attempts: flat_map(decoded, d => match d { RowDecoded { row: a } => [a] RowUndecodable { cause: _ } => [] as List<MeteredAttempt> }) }
      }
    }
  }
}

// ── the reader the dogfood receipt fold calls ─────────────────────────────────────────────────
// Only a Final record is the attempt's meter. Final requires a SEALED roster whose digest the record
// binds and complete rows; anything else is reported as Provisional, never in the Observed arm.
type AttemptMeteringObservation
  = MeteringObserved { record: AttemptMeteringRecord }
  | MeteringProvisional { record: AttemptMeteringRecord }
  | MeteringNotYetWritten
  | MeteringRefused { cause: String }

fn attempt_metering_path_for_instance(instance: HostDashboardInstance, node_id: RoadmapNodeId, attempt_key: String) -> String {
  join([metering_attempt_dir(instance: instance, node_id: node_id, attempt_key: attempt_key), "/", attempt_metering_basename], "")
}

fn metering_observe_from_text(node_id: String, attempt_key: String, roster: MeteringRoster, raw: String) -> AttemptMeteringObservation {
  match roster {
    RosterRefused { cause: c } => MeteringRefused { cause: join(["the launch roster is unreadable: ", c], "") }
    RosterOpen { launches: _ } => metering_observe_against(node_id: node_id, attempt_key: attempt_key, launches: metering_roster_launches(roster: roster), seal: none, raw: raw)
    RosterSealed { launches: ls, digest: d } => metering_observe_against(node_id: node_id, attempt_key: attempt_key, launches: ls, seal: Present { value: d }, raw: raw)
  }
}

fn metering_observe_against(node_id: String, attempt_key: String, launches: List<MeteredRole>, seal: String?, raw: String) -> AttemptMeteringObservation {
  match attempt_metering_decode(raw: raw) {
    RowUndecodable { cause: c } => MeteringRefused { cause: c }
    RowDecoded { row: r } =>
      if r.node_id != node_id || r.attempt_key != attempt_key {
        MeteringRefused { cause: join(["the metering record at this attempt's path names ", r.node_id, "-a", r.attempt_key], "") }
      } else {
        match metering_record_inadmissible(record: r, roster: launches, seal: seal) {
          Present { value: c } => MeteringRefused { cause: c }
          Absent =>
            match metering_standing_of(record: r, seal: seal) {
              MeteringStandingFinal => MeteringObserved { record: r }
              MeteringStandingProvisional => MeteringProvisional { record: r }
            }
        }
      }
  }
}

fn metering_observe_for_attempt(instance: HostDashboardInstance, node_id: RoadmapNodeId, attempt_key: String) -> AttemptMeteringObservation {
  match metering_read_file(path: attempt_metering_path_for_instance(instance: instance, node_id: node_id, attempt_key: attempt_key)) {
    OptionalFileAbsent => MeteringNotYetWritten
    OptionalFileRefused { cause: c } => MeteringRefused { cause: c }
    OptionalFileContent { content: raw } =>
      metering_observe_from_text(node_id: node_id as String, attempt_key: attempt_key, roster: metering_roster_for_attempt(instance: instance, node_id: node_id, attempt_key: attempt_key), raw: raw)
  }
}

// ── the writer the belt tick calls ────────────────────────────────────────────────────────────
fn metering_launch_tokens(instance: HostDashboardInstance, node_id: RoadmapNodeId, attempt_key: String, role: MeteredRole) -> RoleTokens {
  match metering_read_file(path: metered_role_events_path(instance: instance, node_id: node_id, attempt_key: attempt_key, role: role)) {
    OptionalFileAbsent => TokensStreamAbsent
    OptionalFileRefused { cause: c } => TokensRefused { cause: c }
    OptionalFileContent { content: body } => role_tokens_from_events(body: body)
  }
}

fn metering_launch_seat(instance: HostDashboardInstance, node_id: RoadmapNodeId, attempt_key: String, role: MeteredRole) -> SeatHeld {
  match metering_read_file(path: harness_seat_pointer_path(events_path: metered_role_events_path(instance: instance, node_id: node_id, attempt_key: attempt_key, role: role))) {
    OptionalFileAbsent => SeatPointerAbsent
    OptionalFileRefused { cause: c } => SeatRefused { cause: c }
    OptionalFileContent { content: raw } =>
      match harness_seat_pointer_decode(raw: raw) {
        HarnessSeatPointerUndecodable { cause: c } => SeatRefused { cause: c }
        HarnessSeatPointerDecoded { pointer: p } =>
          match seat_pointer_owned_by(pointer: p, owner: metered_role_seat_owner(node_id: node_id as String, attempt_key: attempt_key, role: role)) {
            Present { value: c } => SeatRefused { cause: c }
            Absent =>
              match event_log_store_for_host(short_hostname: instance.host_identity as String) {
                HostStoreRefused { detail: d } => SeatRefused { cause: d }
                HostStoreResolved { store: store, executor: _ } =>
                  match event_log_read_partition(store: store, partition: p.partition, budget: event_log_read_budget()) {
                    PartitionReadRefused { cause: c } => SeatRefused { cause: event_log_refusal_wire(cause: c) }
                    PartitionReadOk { head: _, walk: w } => seat_held_from_walk(pointer: p, walk: w)
                  }
              }
          }
      }
  }
}

fn metering_record_from_usage(node_id: String, attempt_key: String, metered_at: EpochSecs, sealed_roster: String?, roles: List<MeteredRoleUsage>) -> AttemptMeteringRecord {
  AttemptMeteringRecord {
    node_id: node_id,
    attempt_key: attempt_key,
    metered_at: metered_at,
    sealed_roster: sealed_roster,
    roles: roles,
    compute: ComputeNotAttributable { reason: compute_not_attributable_reason },
  }
}

type MeteringPersist
  = MeteringPersisted { path: String, standing: MeteringStanding }
  | MeteringAlreadyFinal
  | MeteringNotDue
  | MeteringPersistRefused { cause: String }

fn metering_persist_record(instance: HostDashboardInstance, node_id: RoadmapNodeId, attempt_key: String, launches: List<MeteredRole>, seal: String?) -> MeteringPersist {
  match now_epoch_seconds() {
    Absent => MeteringPersistRefused { cause: "the clock could not be read as epoch seconds" }
    Present { value: now } => {
      let record = metering_record_from_usage(
        node_id: node_id as String,
        attempt_key: attempt_key,
        metered_at: now,
        sealed_roster: seal,
        roles: map(launches, role => MeteredRoleUsage {
          role: role,
          tokens: metering_launch_tokens(instance: instance, node_id: node_id, attempt_key: attempt_key, role: role),
          seat: metering_launch_seat(instance: instance, node_id: node_id, attempt_key: attempt_key, role: role),
        }),
      )
      match metering_record_inadmissible(record: record, roster: launches, seal: seal) {
        Present { value: c } => MeteringPersistRefused { cause: c }
        Absent => {
          let path = attempt_metering_path_for_instance(instance: instance, node_id: node_id, attempt_key: attempt_key)
          let written = Filesystem.Write(path: path, content: attempt_metering_json(record: record))
          if written.success { MeteringPersisted { path: path, standing: metering_standing_of(record: record, seal: seal) } } else { MeteringPersistRefused { cause: written.error } }
        }
      }
    }
  }
}

// A Final record is never rewritten. An attempt still in the workflow ledger is metered against its
// open roster (never Final); one that has left it is sealed first, then metered against the seal.
fn metering_persist_for_attempt(instance: HostDashboardInstance, node_id: RoadmapNodeId, attempt_key: String, departed: Bool) -> MeteringPersist {
  if trim(attempt_key) == "" {
    MeteringPersistRefused { cause: "the attempt carries no key, so no attempt-state path names it" }
  } else {
    match metering_observe_for_attempt(instance: instance, node_id: node_id, attempt_key: attempt_key) {
      MeteringObserved { record: _ } => MeteringAlreadyFinal
      MeteringProvisional { record: _ } => metering_persist_current(instance: instance, node_id: node_id, attempt_key: attempt_key, departed: departed)
      MeteringNotYetWritten => metering_persist_current(instance: instance, node_id: node_id, attempt_key: attempt_key, departed: departed)
      MeteringRefused { cause: _ } => metering_persist_current(instance: instance, node_id: node_id, attempt_key: attempt_key, departed: departed)
    }
  }
}

fn metering_persist_current(instance: HostDashboardInstance, node_id: RoadmapNodeId, attempt_key: String, departed: Bool) -> MeteringPersist {
  let roster = if departed {
    metering_roster_seal(instance: instance, node_id: node_id, attempt_key: attempt_key)
  } else {
    metering_roster_for_attempt(instance: instance, node_id: node_id, attempt_key: attempt_key)
  }
  match roster {
    RosterRefused { cause: c } => MeteringPersistRefused { cause: join(["the launch roster is unreadable: ", c], "") }
    RosterOpen { launches: ls } => metering_persist_record(instance: instance, node_id: node_id, attempt_key: attempt_key, launches: ls, seal: none)
    RosterSealed { launches: ls, digest: d } => metering_persist_record(instance: instance, node_id: node_id, attempt_key: attempt_key, launches: ls, seal: Present { value: d })
  }
}
