module gunbc.roadmap.roadmap_schedule

// WHY THIS UNIT IS INSIDE THE DESIGN (reconciled with the scheduling cut). gunbc.design_ruling::planning_scheduling_is_cut
// (2026-11-11) cut the STORED schedule and the daily workspace's own consumption of it -- "what to work on next is the
// operator's choice." gunbc.design_ruling::schedule_answers_are_computed_cached_and_re_read (2026-11-18, and on main)
// NARROWS that cut in the operator's words -- "we cut the scheduling and are redoing it now - but yes, you should
// compute it/cache it/re-read it - the planning we did now is relevant": a schedule ANSWER computed at the read --
// start and finish per leaf, the lanes, the critical path and the next-leaf offer -- is NOT a schedule type, a
// time-period record, a forecast state or a synchronized today list, because it is recomputed on every read and no
// cache of it is ever authoritative. What follows is exactly such an answer: computed, never stored as a schedule,
// recomputed on read (see `schedule_read`). Its named consumers decide from its day and lane fields: the
// bottleneck-and-offer row (which leaf to offer next among those the readiness predicate already admits, bounded by
// BeltCapacity) and the roadmap-work-item-projection that renders the planning page. Days here are ABSTRACT until the
// calendar-binding unit binds them; nothing in this file writes a date, a stored schedule, or a today list.

// THE LIST SCHEDULER (roadmap-schedule-list-scheduling). It reads the leaf-expansion's OUTPUT -- the flat
// occurrence list and their edges (Expansion) -- and answers, for an abstract worker count handed in as a
// SIMULATION INPUT: per leaf occurrence its start and finish day, the lane it sits in, how many leaves are in
// flight on each day, and the critical path. Days stay ABSTRACT (a day is a count, not a date) until the
// calendar unit binds them; this unit writes no calendar and no claim. That grain is carried as a typed frontier
// row (`schedule_day_grain_frontier`), not left as prose.
//
// The priority is LONGEST REMAINING PATH FIRST: every occurrence's rank is its own working days plus the longest
// remaining path through the successors it waits nothing on; a ready occurrence with the largest rank is placed
// next, on the lane that frees earliest. A ZERO-DAY JOIN is placed without a worker: the expansion emits no
// occurrence for a Join, so a Join consumes no lane and adds no in-flight leaf -- it is the day-zero barrier the
// stage edges already carry, and it never appears as a scheduled leaf.
//
// The worker count is shown as an input and NEVER becomes a fact: it is echoed back inside the answer labelled
// `workers`, typed as `PositiveInt` (std.integer: `Nat where gt_zero`) so a zero or negative count is not a
// value a caller can write at a literal site; the runtime refusal below stays as the wall against the tracked
// residue (pin.dag's frontier row `feature:refinement-evidence-at-non-literal-positions`: the positivity wall
// holds at literal sites only, so a non-literal at a refined position still compiles).
//
// single_authority: occurrences, their edges, their LeafPaths and their count sources are IMPORTED from the
// expansion; their working-day priors are read back through the SAME carrier via piece_member_days. Nothing here
// re-expands a decomposition or copies a row. fail_closed: a refused expansion, a non-positive worker count, an
// occurrence whose carrier path carries no working-day prior, a cyclic occurrence graph, and a run that leaves
// occurrences unplaced each answer as one `ScheduleRefusal` arm -- typed, located by the carrier paths it carries,
// and countable -- rather than a fabricated schedule, a partial schedule, or prose.
// schedule_answers_are_computed_cached_and_re_read: the answer is COMPUTED from the expansion on every call; a
// cache handed to `schedule_read` is derived and NEVER authoritative -- the read recomputes, supersedes the cached
// answer, and says how many cached leaves no longer match.

import std.types { Bool, Int, List, String, Map }
import std.algebra { empty_map, map_insert, map_lookup, map_contains_key }
import std.integer { nat_to_int, PositiveInt }
import std.roster_frontier { FrontierRow, frontier_row_decl }
import std.dissolution { unbound_dissolution }
import std.decl_ref { decl_ref }
import std.list { first_where }
import gunbc.roadmap.roadmap_model { LeafPath }
import gunbc.roadmap.roadmap_decomposition {
  Expansion, ExpansionRefusal, WorkDecomposition, Occurrence, OccurrenceEdge, OccurrenceCount,
  piece_member_days,
}

// ONE SCHEDULED LEAF OCCURRENCE: where it starts and finishes (abstract days), the worker lane it sits in, and its
// COUNT SOURCE kept visible -- an Assumed occurrence is a simulation input, and it stays marked so downstream.
type ScheduledLeaf {
  path: LeafPath
  // feature:roadmap-schedule-day-measure  dissolve-on: roadmap-schedule-calendar-binding binds the day grain. Days
  // here count WORKING DAYS from the first day of the run; the tracked row carrying that fact is
  // `schedule_day_grain_frontier` below -- this is not a calendar instant and no date is written here.
  start_day: Int
  finish_day: Int
  lane: Int
  count_source: OccurrenceCount
}

// THE SCHEDULE ANSWER, the computed fields bundled so callers read them without matching the coproduct.
type ScheduleAnswer {
  workers: PositiveInt
  leaves: List<ScheduledLeaf>
  in_flight_per_day: List<Int>
  // feature:roadmap-schedule-day-measure  dissolve-on: roadmap-schedule-calendar-binding binds the day grain (the
  // same working-day count as ScheduledLeaf.start_day; see `schedule_day_grain_frontier`).
  horizon: Int
  critical_path: List<LeafPath>
  critical_length: Int
}

// THE SCHEDULE ANSWER. `workers` is the worker count shown as an INPUT (never derived into a fact). `leaves` places
// every scheduled occurrence; `in_flight_per_day` is the count of leaves running on each day from 0 to horizon-1;
// `horizon` is the last finish day; `critical_path` is the longest remaining path as a chain of LeafPaths and
// `critical_length` its total days.
//
// THE REFUSAL IS A COPRODUCT, NOT A SENTENCE (fail_closed: "A failure arm refuses, never widens, and every
// degradation is typed, located and countable"; source_annotations: "Prose is not forbidden; unclassified prose
// is"). Five distinct causes can refuse this answer, and a consumer -- roadmap-schedule-bottlenecks-and-offer, then
// roadmap-work-item-projection -- must know WHICH one fired and WHICH carrier paths caused it without parsing text.
// The expansion arm carries the parent's own `ExpansionRefusal` row rather than restating it (single_authority), and
// the two path-located arms carry the `LeafPath`s themselves -- the same carrier the answer is keyed by. Any prose a
// report wants is rendered FROM the arm; nothing downstream parses it.
//
// `NotScheduled` (not `Refused`) so the constructor never collides with the `Refused` that comes in with the
// imported `Expansion`.
type ScheduleRefusal
  = OverRefusedExpansion { cause: ExpansionRefusal }
  | NonPositiveWorkerCount { count: Int }
  | NoWorkingDayPrior { paths: List<LeafPath> }
  | CyclicOccurrenceGraph
  | UnplacedOccurrences { paths: List<LeafPath> }

type Schedule
  = Scheduled { answer: ScheduleAnswer }
  | NotScheduled { refusal: ScheduleRefusal }

// WHAT THE DAY GRAIN IS, CARRIED AS A ROW AND NOT AS PROSE. Every day quantity here is a count of WORKING DAYS
// counted from the first day of the run -- ScheduledLeaf.start_day and .finish_day, ScheduleAnswer.horizon and
// .critical_length, and the days read through roadmap_decomposition::piece_member_days into SchedNode.days -- not an
// instant on a calendar. The lane that binds that grain to dates is roadmap-schedule-calendar-binding, the next unit
// in this chain and a consumer of exactly this answer. There is no day carrier to CONSUME: std.measure stops at
// Minute (Nanosecond, Microsecond, Millisecond, Second, Minute), and a working day is not an SI scale of seconds, so
// picking an existing measure row would INVENT a unit rather than consume one -- the same fact this repo carries for
// its own day count in extdeps.pin::pin_frontier_rows (feature:pin-refresh-window-measure). So the grain is declared
// as a tracked frontier row, the lane's standard typed carrier for unfinished modeling (as
// gunbc.roadmap.roadmap_attempt_state_store and roadmap_attempt_state_move_rows do), and these fields become that
// carrier's day quantity when it lands. Consume-never-fork.
data schedule_day_grain_frontier: FrontierRow = frontier_row_decl(
  ref: decl_ref(module_path: "gunbc.roadmap.roadmap_schedule", decl_name: "ScheduledLeaf"),
  reason: "start_day and finish_day are bare Int counts of working days, not a day-typed magnitude; ScheduleAnswer.horizon and .critical_length, and the days read through roadmap_decomposition::piece_member_days into SchedNode.days, carry the same grain",
  dissolution: unbound_dissolution(description: "feature:roadmap-schedule-day-measure -- a working-day carrier exists to consume (std.measure stops at Minute: Nanosecond, Microsecond, Millisecond, Second, Minute -- there is no Day, and a working day is not an SI scale of seconds, so this cannot be satisfied by picking an existing row); roadmap-schedule-calendar-binding binds the day grain to a calendar, and then ScheduledLeaf.start_day and .finish_day, ScheduleAnswer.horizon and .critical_length become that carrier and this row deletes. Consume-never-fork"),
)

// An occurrence reduced for scheduling: its carrier LeafPath, the string key the maps are keyed by, its working-day
// prior read back through the carrier, and its count source (Declared or Assumed) kept for the answer.
type SchedNode {
  path: LeafPath
  key: String
  days: Int
  source: OccurrenceCount
}

// One Bellman-Ford relaxation pass over the occurrence ranks.
type Relaxed { changed: Bool, rank: Map<String, Int> }

// The ranks either settle (a DAG) or keep growing past the node count (a cycle the scheduler will not schedule).
type RankResult
  = Ranked { rank: Map<String, Int> }
  | Cyclic

// THE SCHEDULED RUN STATE: each lane's free day (a Map lane-index -> day, so no indexed list rewrite), each
// scheduled key's finish day, the leaves placed so far, and the occurrences not yet placed.
type RunState {
  lanes: Map<Int, Int>
  finish: Map<String, Int>
  placed: List<ScheduledLeaf>
  remaining: List<SchedNode>
}

// A total read over a String-keyed map: the stored value, or `dflt` when the key is absent.
fn look_or<V>(m: Map<String, V>, key: String, dflt: V) -> V {
  match map_lookup(m: m, key: key) {
    Present { value: v } => v
    Absent => dflt
  }
}

// A total read over an Int-keyed map (the lane-free map).
fn look_int(m: Map<Int, Int>, key: Int, dflt: Int) -> Int {
  match map_lookup(m: m, key: key) {
    Present { value: v } => v
    Absent => dflt
  }
}

// The occurrence edge ENDPOINTS keyed by the same path_key the nodes are keyed by.
fn edge_from_key(e: OccurrenceEdge) -> String {
  path_key(p: e.from)
}

fn edge_to_key(e: OccurrenceEdge) -> String {
  path_key(p: e.to)
}

// THE STABLE STRING KEY of a leaf occurrence: the carrier LeafPath's four indexes joined. Two occurrences share a
// key only when they share a path, so the key is the path read a second way -- never a second authority over it.
fn path_key(p: LeafPath) -> String {
  join([p.item as String, "#", to_string(nat_to_int(n: p.stage)), "#", to_string(nat_to_int(n: p.piece)), "#", to_string(nat_to_int(n: p.member))], "")
}

// Append `v` to the list stored at `key` (a successor / predecessor adjacency list).
fn push_key(m: Map<String, List<String>>, key: String, v: String) -> Map<String, List<String>> {
  map_insert(m: m, key: key, value: concat(look_or(m: m, key: key, dflt: []), [v]))
}

// The successor / predecessor adjacency over the scheduled occurrence keys.
type Adjacency {
  succ: Map<String, List<String>>
  pred: Map<String, List<String>>
}

// Build a key -> successor-list and key -> predecessor-list pair from the edges whose BOTH endpoints are scheduled
// occurrences. An edge whose `from` is a parent occurrence (a waits_on aim reaching outside this decomposition) is
// DROPPED: that predecessor is satisfied before this abstract schedule begins, so it is an already-done edge, not a
// day this schedule pays for. This unit schedules ONE expansion's own occurrences; parents arrive from above.
fn adjacency(nodes: List<SchedNode>, edges: List<OccurrenceEdge>) -> Adjacency {
  let member: Map<String, Bool> = fold(nodes, init: empty_map(), f: fn(acc, n) { map_insert(m: acc, key: n.key, value: true) })
  let internal = filter(edges, e => map_contains_key(m: member, key: edge_from_key(e: e)) && map_contains_key(m: member, key: edge_to_key(e: e)))
  let succ: Map<String, List<String>> = fold(internal, init: empty_map(), f: fn(acc, e) { push_key(acc, edge_from_key(e: e), edge_to_key(e: e)) })
  let pred: Map<String, List<String>> = fold(internal, init: empty_map(), f: fn(acc, e) { push_key(acc, edge_to_key(e: e), edge_from_key(e: e)) })
  Adjacency { succ: succ, pred: pred }
}

// ONE relaxation pass: rank(k) = days(k) + max rank over successors. A value that grows marks `changed`.
fn relax(keys: List<String>, succ: Map<String, List<String>>, days_map: Map<String, Int>, rank: Map<String, Int>) -> Relaxed {
  fold(keys, init: Relaxed { changed: false, rank: rank }, f: fn(acc, k) {
    let best = fold(look_or(m: succ, key: k, dflt: []), init: 0, g: fn(m, s) {
      let r = look_or(m: acc.rank, key: s, dflt: 0)
      if r > m { r } else { m }
    })
    let cand = look_or(m: days_map, key: k, dflt: 0) + best
    let cur = look_or(m: acc.rank, key: k, dflt: 0)
    if cand > cur { Relaxed { changed: true, rank: map_insert(m: acc.rank, key: k, value: cand) } } else { acc }
  })
}

// Relax until stable. For a DAG of n nodes the longest simple path has at most n-1 edges, so it settles within
// `max_pass` = n passes; if it is STILL growing at pass n the graph has a cycle and there is no terminating
// schedule -- refuse (fail_closed).
fn rank_fix(keys: List<String>, succ: Map<String, List<String>>, days_map: Map<String, Int>, rank: Map<String, Int>, pass: Int, max_pass: Int) -> RankResult {
  let step = relax(keys: keys, succ: succ, days_map: days_map, rank: rank)
  if !step.changed {
    Ranked { rank: step.rank }
  } else if pass >= max_pass {
    Cyclic
  } else {
    rank_fix(keys: keys, succ: succ, days_map: days_map, rank: step.rank, pass: pass + 1, max_pass: max_pass)
  }
}

// The key with the largest rank, stable on ties (the first such key in the list wins). "" when the list is empty.
fn argmax_rank(keys: List<String>, rank: Map<String, Int>) -> String {
  fold(keys, init: "", f: fn(best, k) {
    if best == "" {
      k
    } else {
      let rb = look_or(m: rank, key: best, dflt: 0)
      let rk = look_or(m: rank, key: k, dflt: 0)
      if rk > rb { k } else { best }
    }
  })
}

// The critical path as a chain of LeafPaths: start at the maximum-rank node and follow its maximum-rank successor
// until none is left. rank(n) = days(n) + max rank over successors, so each step stays on a longest path. A cycle
// would not terminate, but rank_fix has already refused one, so this halts. An empty successor key resolves Absent
// in `node_of`, which ends the walk -- no placeholder path is ever emitted.
fn follow_critical(n: SchedNode, succ: Map<String, List<String>>, rank: Map<String, Int>, node_of: Map<String, SchedNode>) -> List<LeafPath> {
  let next = argmax_rank(keys: look_or(m: succ, key: n.key, dflt: []), rank: rank)
  match map_lookup(m: node_of, key: next) {
    Absent => [n.path]
    Present { value: child } => concat([n.path], follow_critical(n: child, succ: succ, rank: rank, node_of: node_of))
  }
}

// The lane whose free day is earliest; ties choose the lower lane index, so placement is deterministic.
fn pick_lane(lanes: Map<Int, Int>, workers: Int) -> Int {
  scan_lanes(i: 0, workers: workers, lanes: lanes, best_lane: 0, best_free: look_int(m: lanes, key: 0, dflt: 0))
}

fn scan_lanes(i: Int, workers: Int, lanes: Map<Int, Int>, best_lane: Int, best_free: Int) -> Int {
  if i >= workers {
    best_lane
  } else {
    let f = look_int(m: lanes, key: i, dflt: 0)
    if f < best_free { scan_lanes(i: i + 1, workers: workers, lanes: lanes, best_lane: i, best_free: f) }
    else { scan_lanes(i: i + 1, workers: workers, lanes: lanes, best_lane: best_lane, best_free: best_free) }
  }
}

// Whether every scheduled-predecessor of `n` already has a finish day. (External parents were dropped from `pred`,
// so they impose no wait.)
fn is_ready(n: SchedNode, pred: Map<String, List<String>>, finish: Map<String, Int>) -> Bool {
  all(look_or(m: pred, key: n.key, dflt: []), p => map_contains_key(m: finish, key: p))
}

// The ready occurrence with the largest rank (longest remaining path first), stable on ties.
fn best_ready(remaining: List<SchedNode>, rank: Map<String, Int>, pred: Map<String, List<String>>, finish: Map<String, Int>) -> SchedNode? {
  let seed: SchedNode? = none
  fold(remaining, init: seed, f: fn(best, n) {
    if !is_ready(n: n, pred: pred, finish: finish) {
      best
    } else {
      match best {
        Present { value: b } => if look_or(m: rank, key: n.key, dflt: 0) > look_or(m: rank, key: b.key, dflt: 0) { Present { value: n } } else { best }
        Absent => Present { value: n }
      }
    }
  })
}

// The finish day of the latest already-scheduled predecessor of `n` (0 when it has none scheduled).
fn dep_finish(n: SchedNode, pred: Map<String, List<String>>, finish: Map<String, Int>) -> Int {
  fold(look_or(m: pred, key: n.key, dflt: []), init: 0, g: fn(m, p) {
    let f = look_or(m: finish, key: p, dflt: 0)
    if f > m { f } else { m }
  })
}

// WHAT A RUN ANSWERS: every occurrence placed, or the occurrences that stayed UNPLACED when the ready set emptied
// while work remained. A truncated schedule is never handed back as if it were complete (fail_closed: a failure arm
// refuses, it never widens). Whether this arm is reachable is NOT assumed here: the rank pass admits only a DAG, and
// readiness is decided by `pred`, so `run` reports what it could not place and `schedule` turns that into a typed
// refusal rather than trusting the two to agree.
type RunOutcome
  = Placed { leaves: List<ScheduledLeaf> }
  | Stuck { unplaced: List<LeafPath> }

// THE LIST SCHEDULE: place occurrences one at a time -- longest remaining path first, on the lane that frees
// earliest, no earlier than all its scheduled predecessors have finished -- until nothing remains. `placed`
// accumulates the ScheduledLeaf records; an empty ready set with work left answers `Stuck`, never the partial list.
fn run(state: RunState, succ: Map<String, List<String>>, pred: Map<String, List<String>>, rank: Map<String, Int>, workers: Int) -> RunOutcome {
  if count(state.remaining) == 0 {
    Placed { leaves: state.placed }
  } else {
    match best_ready(remaining: state.remaining, rank: rank, pred: pred, finish: state.finish) {
      Absent => Stuck { unplaced: map(state.remaining, n => n.path) }
      Present { value: n } => {
        let lane = pick_lane(lanes: state.lanes, workers: workers)
        let lane_free = look_int(m: state.lanes, key: lane, dflt: 0)
        let dep = dep_finish(n: n, pred: pred, finish: state.finish)
        let start_day = if dep > lane_free { dep } else { lane_free }
        let finish_day = start_day + n.days
        let leaf = ScheduledLeaf { path: n.path, start_day: start_day, finish_day: finish_day, lane: lane, count_source: n.source }
        run(
          state: RunState {
            lanes: map_insert(m: state.lanes, key: lane, value: finish_day),
            finish: map_insert(m: state.finish, key: n.key, value: finish_day),
            placed: concat(state.placed, [leaf]),
            remaining: filter(state.remaining, m => m.key != n.key),
          },
          succ: succ, pred: pred, rank: rank, workers: workers
        )
      }
    }
  }
}

// The days 0 .. last-1 as a list (empty when last <= 0), used to index the per-day in-flight count.
fn day_range(last: Int) -> List<Int> {
  range_from(0, last)
}

fn range_from(i: Int, last: Int) -> List<Int> {
  if i >= last { [] } else { concat([i], range_from(i + 1, last)) }
}

// The maximum finish day over the placed leaves -- the horizon, the day the schedule empties.
fn horizon_of(leaves: List<ScheduledLeaf>) -> Int {
  fold(leaves, init: 0, g: fn(m, l) { if l.finish_day > m { l.finish_day } else { m } })
}

// How many leaves are in flight on each day, indexed from day 0 to horizon-1. A leaf with days == 0 (a zero-day
// Join would be one, but the expansion emits no Join occurrence) spans no day and is counted on none.
fn in_flight(leaves: List<ScheduledLeaf>, horizon: Int) -> List<Int> {
  map(day_range(last: horizon), d => count(filter(leaves, l => l.start_day <= d && d < l.finish_day)))
}

// THE SCHEDULE, computed from an Expansion and a worker count (a SIMULATION INPUT). Refusals, each typed and
// located: the expansion was itself refused; the worker count is not a positive count; an occurrence carries no
// working-day prior on the carrier it is read against; the occurrence graph has a cycle; the run leaves occurrences
// unplaced (a partial schedule is never returned as a complete one). Each is a `ScheduleRefusal` arm, located by the
// carrier paths it carries -- never a sentence a consumer has to parse.
fn schedule(d: WorkDecomposition, e: Expansion, workers: PositiveInt) -> Schedule {
  let worker_count: Int = nat_to_int(n: workers)
  match e {
    Refused { cause: cause } =>
      NotScheduled { refusal: OverRefusedExpansion { cause: cause } }
    Expanded { occurrences: occs, edges: edges } => {
      if worker_count <= 0 {
        NotScheduled { refusal: NonPositiveWorkerCount { count: worker_count } }
      } else {
        // EVERY occurrence's working-day prior is read back through its OWN carrier path. An occurrence whose path
        // is not on the decomposition being read against has NO day count, and one is never minted for it
        // (fail_closed: no plausible output is fabricated): the whole answer refuses, CARRYING the carrier paths that
        // hold no prior. `piece_member_days` is asked twice -- once to find the unpriced paths, once to build the
        // nodes -- because it is the ONE authority on the day count; nothing here caches or restates its answer.
        let unpriced_seed: List<LeafPath> = []
        let unpriced = fold(occs, init: unpriced_seed, f: fn(acc, o) {
          match piece_member_days(d: d, path: o.path) {
            Present { value: _ } => acc
            Absent => concat(acc, [o.path])
          }
        })
        if count(unpriced) > 0 {
          NotScheduled { refusal: NoWorkingDayPrior { paths: unpriced } }
        } else {
          let nodes_seed: List<SchedNode> = []
          let nodes = fold(occs, init: nodes_seed, f: fn(acc, o) {
            match piece_member_days(d: d, path: o.path) {
              Present { value: days } => concat(acc, [SchedNode { path: o.path, key: path_key(p: o.path), days: days, source: o.count_source }])
              Absent => acc
            }
          })
          let keys = map(nodes, n => n.key)
          let adj = adjacency(nodes: nodes, edges: edges)
          let days_map: Map<String, Int> = fold(nodes, init: empty_map(), f: fn(acc, n) { map_insert(m: acc, key: n.key, value: n.days) })
          let rank0: Map<String, Int> = fold(nodes, init: empty_map(), f: fn(acc, n) { map_insert(m: acc, key: n.key, value: n.days) })
          let node_of: Map<String, SchedNode> = fold(nodes, init: empty_map(), f: fn(acc, n) { map_insert(m: acc, key: n.key, value: n) })
          match rank_fix(keys: keys, succ: adj.succ, days_map: days_map, rank: rank0, pass: 1, max_pass: count(nodes)) {
            Cyclic => NotScheduled { refusal: CyclicOccurrenceGraph }
            Ranked { rank: rank } => {
              let lane_seed: Map<Int, Int> = empty_map()
              let lanes0 = fold(range_from(0, worker_count), init: lane_seed, f: fn(acc, l) { map_insert(m: acc, key: l, value: 0) })
              match run(
                state: RunState { lanes: lanes0, finish: empty_map(), placed: [], remaining: nodes },
                succ: adj.succ, pred: adj.pred, rank: rank, workers: worker_count
              ) {
                // A run that could not place everything refuses with the occurrences it could not place; it is never
                // wrapped as a complete `Scheduled` answer.
                Stuck { unplaced: stuck } =>
                  NotScheduled { refusal: UnplacedOccurrences { paths: stuck } }
                Placed { leaves: placed } => {
                  let horizon = horizon_of(leaves: placed)
                  let crit_start = argmax_rank(keys: keys, rank: rank)
                  let critical_path = match map_lookup(m: node_of, key: crit_start) {
                    Absent => []
                    Present { value: n } => follow_critical(n: n, succ: adj.succ, rank: rank, node_of: node_of)
                  }
                  Scheduled { answer: ScheduleAnswer {
                    workers: workers,
                    leaves: placed,
                    in_flight_per_day: in_flight(leaves: placed, horizon: horizon),
                    horizon: horizon,
                    critical_path: critical_path,
                    critical_length: look_or(m: rank, key: crit_start, dflt: 0),
                  } }
                }
              }
            }
          }
        }
      }
    }
  }
}

// WHAT A RE-READ ANSWERS, and where the cache the caller held stands against it
// (gunbc.design_ruling::schedule_answers_are_computed_cached_and_re_read: the schedule is COMPUTED from the
// carriers; it MAY be cached; a cache is DERIVED and NEVER authoritative; the answer is RECOMPUTED ON READ). The
// answer a read serves is ALWAYS the recomputed one -- the cache never wins -- and the arm says what the cache got
// wrong, so a stale cache is DETECTED at the read instead of being served silently or dropped silently.
// `ReadRefused` is the recomputation's own typed refusal: a cached answer is never a reason to answer when the
// recomputation itself refuses.
type ScheduleRead
  = ReadRefused { refusal: ScheduleRefusal }
  | CacheHeldNothing { answer: ScheduleAnswer }
  | CacheMatches { answer: ScheduleAnswer }
  | CacheSuperseded { answer: ScheduleAnswer, stale_leaves: Int, stale_answer_fields: Int }

// THE ONE READ CONSUMERS USE (roadmap-schedule-bottlenecks-and-offer, then roadmap-work-item-projection): hand it the
// decomposition, its expansion, the worker count, and whatever you last cached; it recomputes and answers.
fn schedule_read(d: WorkDecomposition, e: Expansion, workers: PositiveInt, cached: Schedule) -> ScheduleRead {
  match schedule(d: d, e: e, workers: workers) {
    NotScheduled { refusal: refusal } => ReadRefused { refusal: refusal }
    Scheduled { answer: fresh } => match cached {
      // Nothing usable was cached: the caller holds no answer, or holds a cached refusal.
      NotScheduled { refusal: _ } => CacheHeldNothing { answer: fresh }
      Scheduled { answer: held } => {
        // Every divergence between the cached answer and the recomputed one is counted, in BOTH directions, each
        // leaf located by the one path_key: placed differently or not at all in the cache, and cached leaves that
        // are no longer placed. The aggregate fields are compared too, so a cache carried over from a different
        // worker count or horizon cannot masquerade as a matching one.
        let moved = count(filter(fresh.leaves, l => match scheduled_at(a: held, path: l.path) {
          Absent => true
          Present { value: k } => !(k.start_day == l.start_day && k.finish_day == l.finish_day && k.lane == l.lane
            && occurrence_count_is_assumed(c: k.count_source) == occurrence_count_is_assumed(c: l.count_source))
        }))
        let dropped = count(filter(held.leaves, k => match scheduled_at(a: fresh, path: k.path) {
          Absent => true
          Present { value: _ } => false
        }))
        let fields = stale_answer_fields(fresh: fresh, held: held)
        if moved + dropped + fields == 0 { CacheMatches { answer: fresh } }
        else { CacheSuperseded { answer: fresh, stale_leaves: moved + dropped, stale_answer_fields: fields } }
      }
    }
  }
}

// Which aggregate fields of a cached answer no longer match the recomputed one: the worker count, the horizon, the
// critical length, and the shapes of the in-flight series and of the critical path (spelled through the one
// path_key, never a restated key format).
fn stale_answer_fields(fresh: ScheduleAnswer, held: ScheduleAnswer) -> Int {
  let w = if fresh.workers == held.workers { 0 } else { 1 }
  let h = if fresh.horizon == held.horizon { 0 } else { 1 }
  let c = if fresh.critical_length == held.critical_length { 0 } else { 1 }
  let f = if count(fresh.in_flight_per_day) == count(held.in_flight_per_day) { 0 } else { 1 }
  let p = if join(map(fresh.critical_path, q => path_key(p: q)), ",") == join(map(held.critical_path, q => path_key(p: q)), ",") { 0 } else { 1 }
  w + h + c + f + p
}

// ACCESSORS so a reader consumes a ScheduleRead without matching its coproduct: the answer the read serves (none
// when the recomputation refused), and how many cached leaves the recomputation superseded.
fn schedule_read_answer(r: ScheduleRead) -> ScheduleAnswer? {
  match r {
    ReadRefused { refusal: _ } => none
    CacheHeldNothing { answer: a } => Present { value: a }
    CacheMatches { answer: a } => Present { value: a }
    CacheSuperseded { answer: a, stale_leaves: _, stale_answer_fields: _ } => Present { value: a }
  }
}

fn schedule_read_refusal(r: ScheduleRead) -> ScheduleRefusal? {
  match r {
    ReadRefused { refusal: r } => Present { value: r }
    _ => none
  }
}

fn schedule_read_stale_leaves(r: ScheduleRead) -> Int {
  match r {
    CacheSuperseded { answer: _, stale_leaves: n, stale_answer_fields: _ } => n
    _ => 0
  }
}

// How many AGGREGATE fields of the cached answer the recomputation superseded (worker count, horizon, critical
// length, in-flight shape, critical-path keys). Zero with a non-zero stale_leaves means the cache was right about
// the totals and wrong about the placement.
fn schedule_read_stale_answer_fields(r: ScheduleRead) -> Int {
  match r {
    CacheSuperseded { answer: _, stale_leaves: _, stale_answer_fields: n } => n
    _ => 0
  }
}

// ACCESSORS so a reader consumes a Schedule without matching its coproduct (and without naming its constructors
// beside the imported Expansion's). Each hands back the TYPED thing -- the answer, or the refusal -- rather than a
// Bool that flattens which arm fired; a reader that must act differently per cause reads `schedule_refusal` and
// matches its arm, and one that only needs the fields reads `schedule_answer`.
fn schedule_answer(s: Schedule) -> ScheduleAnswer? {
  match s {
    Scheduled { answer: a } => Present { value: a }
    NotScheduled { refusal: _ } => none
  }
}

fn schedule_refusal(s: Schedule) -> ScheduleRefusal? {
  match s {
    Scheduled { answer: _ } => none
    NotScheduled { refusal: r } => Present { value: r }
  }
}

// The placed leaf for a carrier path, if it was scheduled -- the witness reads a leaf's day and lane this way,
// through the single path_key the schedule is keyed by (both sides go through path_key; no second key format).
fn scheduled_at(a: ScheduleAnswer, path: LeafPath) -> ScheduledLeaf? {
  first_where(a.leaves, l => path_key(p: l.path) == path_key(p: path))
}

// The critical path spelled as path keys, in order from the start of the longest remaining path -- each key is the
// single path_key applied to the path, never a restated format.
fn critical_path_keys(a: ScheduleAnswer) -> List<String> {
  map(a.critical_path, p => path_key(p: p))
}

fn scheduled_leaf_count(a: ScheduleAnswer) -> Int {
  count(a.leaves)
}

// THE DERIVED CACHE RECORD: wrap a computed answer as the Schedule a later `schedule_read` may be handed. It is a
// cache and nothing more -- the read recomputes and never serves it, which is what makes a stale one superseded.
fn as_cache(a: ScheduleAnswer) -> Schedule {
  Scheduled { answer: a }
}

// Whether a placed leaf's count source is the ASSUMED simulation count (a FindingsOf member), kept visible in the
// answer so a downstream reader sees it was scheduled from a simulation input, not a declared count.
fn occurrence_count_is_assumed(c: OccurrenceCount) -> Bool {
  c == Assumed
}
