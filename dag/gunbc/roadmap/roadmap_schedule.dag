module gunbc.roadmap.roadmap_schedule

// WHY THIS UNIT IS INSIDE THE DESIGN (reconciled with the scheduling cut). gunbc.design_ruling::planning_scheduling_is_cut
// (2026-11-11) cut the STORED schedule and the daily workspace's own consumption of it -- "what to work on next is the
// operator's choice." gunbc.design_ruling::schedule_answers_are_computed_cached_and_re_read (2026-11-18, and on main)
// NARROWS that cut in the operator's words -- "we cut the scheduling and are redoing it now - but yes, you should
// compute it/cache it/re-read it - the planning we did now is relevant": a schedule ANSWER computed at the read --
// start and finish per leaf, the lanes, the critical path and the next-leaf offer -- is NOT a schedule type, a
// time-period record, a forecast state or a synchronized today list, because it is recomputed on every read and no
// cache of it is ever authoritative. What follows is exactly such an answer: computed, never stored as a schedule,
// recomputed on read (see `schedule_read`). Its named consumers decide from its day and lane fields: the
// bottleneck-and-offer row (which leaf to offer next among those the readiness predicate already admits, bounded by
// BeltCapacity) and the roadmap-work-item-projection that renders the planning page. Days here are ABSTRACT until the
// calendar-binding unit binds them; nothing in this file writes a date, a stored schedule, or a today list.

// THE LIST SCHEDULER (roadmap-schedule-list-scheduling). It reads the leaf-expansion's OUTPUT -- the flat
// occurrence list and their edges (Expansion) -- and answers, for an abstract worker count handed in as a
// SIMULATION INPUT: per leaf occurrence its start and finish day, the lane it sits in, how many leaves are in
// flight on each day, and the critical path. Days stay ABSTRACT (a day is a count, not a date) until the
// calendar unit binds them; this unit writes no calendar and no claim. That grain is carried as a typed frontier
// row that already tracks it -- see the field markers below.
//
// The priority is LONGEST REMAINING PATH FIRST: every occurrence's rank is its own working days plus the longest
// remaining path through the successors it waits nothing on; the occurrence with the largest rank is placed
// next, on the lane that frees earliest. A ZERO-DAY JOIN is placed without a worker: the expansion emits no
// occurrence for a Join, so a Join consumes no lane and adds no in-flight leaf -- it is the day-zero barrier the
// stage edges already carry, and it never appears as a scheduled leaf.
//
// The worker count is shown as an input and NEVER becomes a fact: it is echoed back inside the answer labelled
// `workers`, carried by the concurrency carrier this repo already decided on -- `roadmap_belt::BeltCapacity`
// (`max_concurrent`), the same one `roadmap_forecast::ScheduleForecastAssumptions.worker_concurrency_cap` takes --
// because "how many run at once" is one quantity with one authority (`single_authority`). A capacity that is not
// positive refuses by name, in step with that lane's own `WorkerConcurrencyCapInvalid`: this unit does NOT re-type
// another lane's carrier (making `BeltCapacity.max_concurrent` a `PositiveInt` would be a change to the belt
// authority, outside this ticket's boundary), and it does not mint a second cap scalar.
//
// single_authority: occurrences, their edges, their LeafPaths and their count sources are IMPORTED from the
// expansion; their working-day priors are read back through the SAME carrier via piece_member_days. Nothing here
// re-expands a decomposition or copies a row. fail_closed: a refused expansion, a non-positive worker count, an
// occurrence whose carrier path carries no working-day prior, a cyclic occurrence graph, and a run that leaves
// occurrences unplaced each answer as one `ScheduleRefusal` arm -- typed, located by the carrier paths it carries,
// and countable -- rather than a fabricated schedule, a partial schedule, or prose.
// schedule_answers_are_computed_cached_and_re_read: the answer is COMPUTED from the expansion on every call; a
// cache handed to `schedule_read` is derived and NEVER authoritative -- the read recomputes, supersedes the cached
// answer, and says how many cached leaves no longer match.

import std.types { Bool, Int, List, String, Map }
import std.algebra { empty_map, map_insert, map_lookup, map_contains_key, list_push, list_reverse }
import std.integer { nat_to_int }
import gunbc.roadmap.roadmap_belt { BeltCapacity }
import std.list { first_where, distinct_by_key }
import gunbc.roadmap.roadmap_model { LeafPath }
import gunbc.roadmap.roadmap_decomposition {
  Expansion, ExpansionRefusal, WorkDecomposition, Occurrence, OccurrenceEdge, OccurrenceCount,
  piece_member_days,
}

// ONE SCHEDULED LEAF OCCURRENCE: where it starts and finishes (abstract days), the worker lane it sits in, and its
// COUNT SOURCE kept visible -- an Assumed occurrence is a simulation input, and it stays marked so downstream.
type ScheduledLeaf {
  path: LeafPath
  // feature:working-day-prior-carrier  dissolve-on: std.measure grows a working-day (effort) family. These are
  // WORKING-DAY counts read through roadmap_decomposition::piece_member_days, so they INHERIT the grain that row
  // already tracks on WorkPiece.days (owning lane: std.measure); this unit does not re-track it and writes no
  // calendar instant -- roadmap-schedule-calendar-binding is the lane that binds the grain to dates.
  start_day: Int
  finish_day: Int
  lane: Int
  count_source: OccurrenceCount
}

// THE SCHEDULE ANSWER, the computed fields bundled so callers read them without matching the coproduct.
type ScheduleAnswer {
  workers: BeltCapacity
  leaves: List<ScheduledLeaf>
  in_flight_per_day: List<Int>
  // feature:working-day-prior-carrier  dissolve-on: std.measure grows a working-day (effort) family -- the same
  // inherited grain as ScheduledLeaf.start_day (marker there; the tracked row lives on WorkPiece.days).
  horizon: Int
  critical_path: List<LeafPath>
  critical_length: Int
}

// THE SCHEDULE ANSWER. `workers` is the worker count shown as an INPUT (never derived into a fact). `leaves` places
// every scheduled occurrence; `in_flight_per_day` is the count of leaves running on each day from 0 to horizon-1;
// `horizon` is the last finish day; `critical_path` is the longest remaining path as a chain of LeafPaths and
// `critical_length` its total days.
//
// WHY THIS IS NOT THE FORECAST'S CRITICAL PATH (conformance: "Diverges with no reason -- the only red").
// gunbc.roadmap.roadmap_forecast already answers a critical-path question and cites the method row
// `critical_path_method_used`; this unit does not re-answer it, and the two quantities are distinguishable:
//   * the forecast projects a THREE-POINT CALIBRATION over ROADMAP ITEM nodes -- `NodeScheduleForecast` per
//     `RoadmapNodeId`, durations held as `std.measure` milliseconds measured against a `ForecastAnchorObservation`,
//     with `critical_path_minimum` and `capacity_constrained_minimum` as statistical LOWER BOUNDS;
//   * this unit places the LEAF OCCURRENCES of one admitted expansion deterministically, from the working-day priors
//     the carrier declares, and answers per-leaf start/finish, lane, in-flight per day and the dependency chain that
//     decides the finish. No anchor, no calibration population, no milliseconds: days stay abstract until
//     roadmap-schedule-calendar-binding binds them.
// What IS shared rather than re-decided: the concurrency carrier (`roadmap_belt::BeltCapacity`), the cap-invalid
// refusal's name and shape, the `path_key`/`LeafPath` carrier, and the composition law the rank obeys -- sequence
// sums and parallel takes the larger, which is `std.realization_measurement::time_measure_seq` /
// `time_measure_par` (`schedule_batch_critical_path`); this module's pass is the fixpoint over THIS occurrence graph
// that turns that law into a per-node priority, which no existing row computes.
//
// THE REFUSAL IS A COPRODUCT, NOT A SENTENCE (fail_closed: "A failure arm refuses, never widens, and every
// degradation is typed, located and countable"; source_annotations: "Prose is not forbidden; unclassified prose
// is"). Five distinct causes can refuse this answer, and a consumer -- roadmap-schedule-bottlenecks-and-offer, then
// roadmap-work-item-projection -- must know WHICH one fired and WHICH carrier paths caused it without parsing text.
// The expansion arm carries the parent's own `ExpansionRefusal` row rather than restating it (single_authority), and
// the two path-located arms carry the `LeafPath`s themselves -- the same carrier the answer is keyed by. Any prose a
// report wants is rendered FROM the arm; nothing downstream parses it.
//
// `NotScheduled` (not `Refused`) so the constructor never collides with the `Refused` that comes in with the
// imported `Expansion`.
type ScheduleRefusal
  = OverRefusedExpansion { cause: ExpansionRefusal }
  | ConcurrencyCapInvalid { cap: BeltCapacity }
  | NoWorkingDayPrior { paths: List<LeafPath> }
  | CyclicOccurrenceGraph
  | UnplacedOccurrences { paths: List<LeafPath> }
  | MemberIndexBeyondExpansion { paths: List<LeafPath> }
  // A PIN THE CALLER HANDED IN NAMES NO OCCURRENCE OF THIS EXPANSION. A pin is a fact about work already running,
  // so it cannot be skipped or dropped: it would hold a lane and gate starts for a leaf this expansion never
  // emitted. The answer refuses, naming the pins (fail_closed: a failure arm refuses, it never widens).
  | PinnedLeafNotAnOccurrence { paths: List<LeafPath> }
  // A PIN WHOSE PLACEMENT NO READ CAN HOLD: a negative lane or start day, a bar that does not run
  // (finish_day at or before start_day), or two pins claiming one lane. Same rule, named.
  | PinnedPlacementInvalid { paths: List<LeafPath> }

type Schedule
  = Scheduled { answer: ScheduleAnswer }
  | NotScheduled { refusal: ScheduleRefusal }


// An occurrence reduced for scheduling: its carrier LeafPath, the string key the maps are keyed by, its working-day
// prior read back through the carrier, and its count source (Declared or Assumed) kept for the answer.
type SchedNode {
  path: LeafPath
  key: String
  days: Int
  source: OccurrenceCount
}

// THE BOOKKEEPING THE ORDERING PASS CARRIES. `ready` holds the occurrences whose internal predecessors have ALL
// been emitted; `order` is the emitted sequence, one append per emit, so it is a FORWARD topological order --
// every predecessor before its successor -- and the passes that need the other direction ask std.algebra's
// `list_reverse` for it once rather than pretending an accumulator is backwards. (std.algebra:176 is explicit that
// `list_push` is FreeMonoid's SNOC: a push accumulator reads forwards. Reading it as if it were a prepend was the
// orientation bug this comment now forbids.) `indeg` counts the internal predecessors still unemitted;
// `unemitted` counts the occurrences not yet emitted.
type TopoState {
  ready: List<SchedNode>
  order: List<SchedNode>
  indeg: Map<String, Int>
  unemitted: Int
}

// WHAT THE ORDERING PASS ANSWERS: an emission order in which every predecessor precedes its successor, or the typed
// fact that the occurrence graph has a cycle. There is no third arm and no partial order handed back as if it were
// complete: a sort that comes out short IS a cycle on this graph, and that is the construction the refusal rests on
// -- not a separate pass being trusted to agree with this one.
type TopoOutcome
  = Ordered { order: List<SchedNode> }
  | Cyclic

// THE BOOKKEEPING THE PLACEMENT PASS CARRIES: each lane's free day (a Map lane-index -> day; a lane with no entry
// is free at day 0, the same default the lane scan reads, so the map is never pre-seeded and never rewritten by
// index), each placed occurrence's finish day, the leaves in the order they were placed -- which IS the answer's
// order, highest rank first, built with one append per placement -- the bucket of occurrences currently at the rank
// being placed, and that rank.
type PlaceState {
  placed: List<ScheduledLeaf>
  finish: Map<String, Int>
  lanes: Map<Int, Int>
  bucket: List<SchedNode>
  rank_now: Int
}

// A total read over a String-keyed map: the stored value, or `dflt` when the key is absent.
fn look_or<V>(m: Map<String, V>, key: String, dflt: V) -> V {
  match map_lookup(m: m, key: key) {
    Present { value: v } => v
    Absent => dflt
  }
}

// A total read over an Int-keyed map (the lane-free-day map and the rank-bucket map).
fn look_key<V>(m: Map<Int, V>, key: Int, dflt: V) -> V {
  match map_lookup(m: m, key: key) {
    Present { value: v } => v
    Absent => dflt
  }
}

// The occurrence edge ENDPOINTS keyed by the same path_key the nodes are keyed by.
fn edge_from_key(e: OccurrenceEdge) -> String {
  path_key(p: e.from)
}

fn edge_to_key(e: OccurrenceEdge) -> String {
  path_key(p: e.to)
}

// THE STABLE STRING KEY of a leaf occurrence: the carrier LeafPath's four indexes joined. Two occurrences share a
// key only when they share a path, so the key is the path read a second way -- never a second authority over it.
// The (item, stage, piece) identity of an occurrence path -- the same path_key spelling WITHOUT the member index, so
// one family occurrence's member set is counted from the expansion's own rows.
fn occurrence_piece_key(p: LeafPath) -> String {
  join([p.item as String, "#", to_string(nat_to_int(n: p.stage)), "#", to_string(nat_to_int(n: p.piece))], "")
}

// How many members the expansion produced for each (item, stage, piece), in ONE pass over the occurrences it
// emitted. Asking this per occurrence (re-filtering the whole occurrence list each time) is the quadratic fold
// shape gunbc.design_argument::how_to_work says is always fixed, whatever the realized n.
fn member_counts(occs: List<Occurrence>) -> Map<String, Int> {
  fold(occs, init: empty_map(), f: fn(acc, o) {
    let k = occurrence_piece_key(p: o.path)
    map_insert(m: acc, key: k, value: look_or(m: acc, key: k, dflt: 0) + 1)
  })
}

fn path_key(p: LeafPath) -> String {
  join([p.item as String, "#", to_string(nat_to_int(n: p.stage)), "#", to_string(nat_to_int(n: p.piece)), "#", to_string(nat_to_int(n: p.member))], "")
}

// Add one occurrence to the successor / predecessor list stored at `key`. `list_push` is std.algebra's declared
// home of the single-item append; the `concat(acc, [x])` form that stood here copied the whole accumulated list at
// every edge, which is the copied-accumulator shape gunbc.design_argument::how_to_work fixes at the root.
fn push_node(m: Map<String, List<SchedNode>>, key: String, n: SchedNode) -> Map<String, List<SchedNode>> {
  let none_yet: List<SchedNode> = []
  map_insert(m: m, key: key, value: list_push(xs: look_or(m: m, key: key, dflt: none_yet), item: n))
}

// The successor / predecessor adjacency over the scheduled occurrence keys, held as the neighbouring NODES so the
// ordering, ranking and placement passes never look a key up again.
type Adjacency {
  succ: Map<String, List<SchedNode>>
  pred: Map<String, List<SchedNode>>
}

// Build the successor and predecessor lists from the edges whose BOTH endpoints are scheduled occurrences. An edge
// whose `from` is a parent occurrence (a waits_on aim reaching outside this decomposition) is DROPPED: that
// predecessor is satisfied before this abstract schedule begins, so it is an already-done edge, not a day this
// schedule pays for. This unit schedules ONE expansion's own occurrences; parents arrive from above. The `Absent`
// arm below is unreachable by construction -- `internal` just filtered to edges whose endpoints are in `member` --
// and it is kept as a typed no-op rather than a fabricated node, so the pass cannot invent a neighbour.
fn adjacency(nodes: List<SchedNode>, edges: List<OccurrenceEdge>) -> Adjacency {
  let member: Map<String, SchedNode> = fold(nodes, init: empty_map(), f: fn(acc, n) { map_insert(m: acc, key: n.key, value: n) })
  let internal = filter(edges, e => map_contains_key(m: member, key: edge_from_key(e: e)) && map_contains_key(m: member, key: edge_to_key(e: e)))
  let succ: Map<String, List<SchedNode>> = fold(internal, init: empty_map(), f: fn(acc, e) {
    match map_lookup(m: member, key: edge_to_key(e: e)) {
      Absent => acc
      Present { value: n } => push_node(m: acc, key: edge_from_key(e: e), n: n)
    }
  })
  let pred: Map<String, List<SchedNode>> = fold(internal, init: empty_map(), f: fn(acc, e) {
    match map_lookup(m: member, key: edge_from_key(e: e)) {
      Absent => acc
      Present { value: n } => push_node(m: acc, key: edge_to_key(e: e), n: n)
    }
  })
  Adjacency { succ: succ, pred: pred }
}

// THE OUTSTANDING-PREDECESSOR COUNT of each occurrence, read off the adjacency the expansion's own edges built
// (external endpoints were dropped there, so a parent arriving from above imposes no wait -- see `adjacency`).
fn indegrees(nodes: List<SchedNode>, succ: Map<String, List<SchedNode>>) -> Map<String, Int> {
  let no_succs: List<SchedNode> = []
  let seeded = fold(nodes, init: empty_map(), f: fn(acc, n) { map_insert(m: acc, key: n.key, value: 0) })
  fold(nodes, init: seeded, f: fn(acc, n) {
    fold(look_or(m: succ, key: n.key, dflt: no_succs), init: acc, g: fn(m, s) { map_insert(m: m, key: s.key, value: look_or(m: m, key: s.key, dflt: 0) + 1) })
  })
}

// EMIT one ready occurrence: append it to the order, take one outstanding predecessor off each of its successors,
// and put on the ready queue exactly those successors that just ran out of predecessors (the fold appends, so the
// queue is FIFO; which ready node is emitted next cannot change the answer, because placement is driven by rank,
// not by emission order). Each edge is touched once,
// so the ordering pass costs one walk of the graph. What stood here was a Bellman-Ford relaxation that re-scanned
// every node and every edge once PER NODE -- a proven quadratic shape, gunbc.design_argument::how_to_work: it is
// fixed at the root whatever the realized n.
fn topo_step(state: TopoState, succ: Map<String, List<SchedNode>>) -> TopoState {
  match state.ready {
    Empty => state
    Cons { head: n, tail: rest } => {
      let no_succs: List<SchedNode> = []
      let succs = look_or(m: succ, key: n.key, dflt: no_succs)
      let dec = fold(succs, init: state.indeg, g: fn(m, s) { map_insert(m: m, key: s.key, value: look_or(m: m, key: s.key, dflt: 0) - 1) })
      let freed = fold(succs, init: rest, h: fn(acc, s) { if look_or(m: dec, key: s.key, dflt: 0) == 0 { list_push(xs: acc, item: s) } else { acc } })
      TopoState { ready: freed, order: list_push(xs: state.order, item: n), indeg: dec, unemitted: state.unemitted - 1 }
    }
  }
}

// Run the ordering pass to exhaustion. `unemitted` is carried rather than recounted, and a sort that ends with
// occurrences still unemitted IS a cycle on this graph: the same pass that would have produced the order reports it
// short, so nothing here rests on a second pass agreeing with the first.
fn topo_run(state: TopoState, succ: Map<String, List<SchedNode>>) -> TopoOutcome {
  match state.ready {
    Empty => if state.unemitted > 0 { Cyclic } else { Ordered { order: state.order } }
    Cons { head: n, tail: rest } => topo_run(state: topo_step(state: state, succ: succ), succ: succ)
  }
}

// ONE rank pass over the emission order read BACKWARDS -- the reversal taken once, from std.algebra's own
// `list_reverse`. A successor is emitted only after every one of its predecessors has been, so the reversed order
// puts every successor before its predecessor and rank(k) = days(k) + max rank over successors is already settled
// for every successor by the time k is read. One walk of the graph; there is no fixed-point iteration left to
// iterate. Walking the FORWARD order instead would read every successor as unset (rank 0) and collapse every rank
// to the node's own days -- the chain would lose its length and a successor could be placed before its
// predecessor -- so the direction here is the whole correctness of the pass.
fn rank_pass(order_back: List<SchedNode>, succ: Map<String, List<SchedNode>>) -> Map<String, Int> {
  let no_succs: List<SchedNode> = []
  fold(order_back, init: empty_map(), f: fn(rank, n) {
    let best = fold(look_or(m: succ, key: n.key, dflt: no_succs), init: 0, g: fn(m, s) {
      let r = look_or(m: rank, key: s.key, dflt: 0)
      if r > m { r } else { m }
    })
    map_insert(m: rank, key: n.key, value: n.days + best)
  })
}

// The largest rank over the occurrences -- the critical length, the shortest span any schedule of these occurrences
// under any worker count can cover.
fn max_rank_of(order: List<SchedNode>, rank: Map<String, Int>) -> Int {
  fold(order, init: 0, f: fn(m, n) {
    let r = look_or(m: rank, key: n.key, dflt: 0)
    if r > m { r } else { m }
  })
}

// The occurrences grouped by rank. The groups are built by appending while walking the FORWARD topological order,
// so each group is itself predecessor-first: equal ranks are placed deterministically, and a zero-day tie (where
// rank stops strictly decreasing along an edge) still cannot place a successor before its predecessor.
fn rank_buckets(order: List<SchedNode>, rank: Map<String, Int>) -> Map<Int, List<SchedNode>> {
  let empty_bucket: List<SchedNode> = []
  fold(order, init: empty_map(), f: fn(acc, n) {
    let r = look_or(m: rank, key: n.key, dflt: 0)
    map_insert(m: acc, key: r, value: list_push(xs: look_key(m: acc, key: r, dflt: empty_bucket), item: n))
  })
}

// The occurrence with the largest rank, stable on ties (the first in the list wins); `none` on an empty list, so no
// placeholder occurrence is ever emitted.
fn argmax_node_rank(nodes: List<SchedNode>, rank: Map<String, Int>) -> SchedNode? {
  let seed: SchedNode? = none
  fold(nodes, init: seed, f: fn(best, n) {
    match best {
      Present { value: b } => if look_or(m: rank, key: n.key, dflt: 0) > look_or(m: rank, key: b.key, dflt: 0) { Present { value: n } } else { best }
      Absent => Present { value: n }
    }
  })
}

// The critical path as a chain of LeafPaths: start at the maximum-rank occurrence and follow its maximum-rank
// successor until it has none. rank(n) = days(n) + max rank over successors, so every step stays on a longest path.
// The walk halts because the ordering pass refused every cycle before this could be called -- same graph, one pass
// reporting to the next. The chain is appended as it is walked, which is the direction the answer reports it in.
fn follow_critical(n: SchedNode, succ: Map<String, List<SchedNode>>, rank: Map<String, Int>, acc: List<LeafPath>) -> List<LeafPath> {
  let no_succs: List<SchedNode> = []
  let next = argmax_node_rank(nodes: look_or(m: succ, key: n.key, dflt: no_succs), rank: rank)
  match next {
    Absent => list_push(xs: acc, item: n.path)
    Present { value: child } => follow_critical(n: child, succ: succ, rank: rank, acc: list_push(xs: acc, item: n.path))
  }
}

// The lane whose free day is earliest; ties choose the lower lane index, so placement is deterministic. The scan
// runs over `workers` -- the concurrency input, which is also the answer's own width -- and never over the
// placements accumulated so far.
fn pick_lane(lanes: Map<Int, Int>, workers: Int) -> Int {
  scan_lanes(i: 0, workers: workers, lanes: lanes, best_lane: 0, best_free: look_key(m: lanes, key: 0, dflt: 0))
}

fn scan_lanes(i: Int, workers: Int, lanes: Map<Int, Int>, best_lane: Int, best_free: Int) -> Int {
  if i >= workers {
    best_lane
  } else {
    let f = look_key(m: lanes, key: i, dflt: 0)
    if f < best_free { scan_lanes(i: i + 1, workers: workers, lanes: lanes, best_lane: i, best_free: f) }
    else { scan_lanes(i: i + 1, workers: workers, lanes: lanes, best_lane: best_lane, best_free: best_free) }
  }
}

// The finish day of the latest already-placed predecessor of `n` (0 when it has none placed). A predecessor cannot
// be placed after its successor: placement walks ranks downwards and every predecessor ranks above its successor.
fn dep_finish(n: SchedNode, pred: Map<String, List<SchedNode>>, finish: Map<String, Int>) -> Int {
  let no_preds: List<SchedNode> = []
  fold(look_or(m: pred, key: n.key, dflt: no_preds), init: 0, g: fn(m, p) {
    let f = look_or(m: finish, key: p.key, dflt: 0)
    if f > m { f } else { m }
  })
}

// THE LIST SCHEDULE: place occurrences by descending rank (longest remaining path first), each on the lane that
// frees earliest, no earlier than all its placed predecessors have finished. Every occurrence the ordering pass
// emitted lands in exactly one rank bucket, so walking the buckets from the top down covers the whole set; whether
// it did is CHECKED by `unplaced_occurrences` in `schedule`, not assumed here. The leaf list is pushed and read
// back once; the rank walk over empty buckets is bounded by the critical length, which the answer's own per-day
// series already spans.
fn place_all(state: PlaceState, pred: Map<String, List<SchedNode>>, buckets: Map<Int, List<SchedNode>>, workers: Int, earliest_start: Int) -> PlaceState {
  match state.bucket {
    Cons { head: n, tail: rest } => {
      let lane = pick_lane(lanes: state.lanes, workers: workers)
      let lane_free = look_key(m: state.lanes, key: lane, dflt: 0)
      let dep = dep_finish(n: n, pred: pred, finish: state.finish)
      let ready = if dep > lane_free { dep } else { lane_free }
      // `earliest_start` is the CALLER's floor on a start day -- the day its pins leave the belt room for one more
      // leaf (roadmap-schedule-from-now) -- and it is 0 for every read with no pins, which is what every caller
      // before roadmap-schedule-from-now passes, byte for byte unchanged. The cap itself is not enforced here: it is
      // enforced per placement by the lane state, whose seeded lanes hold every pin including the ones parked past
      // the cap (`reserve_over_cap_lanes`). A floor is one number for the whole schedule and stops holding the
      // moment more rows are in flight than it counted; the lane state is what each placement actually reads.
      let start_day = if earliest_start > ready { earliest_start } else { ready }
      let finish_day = start_day + n.days
      let leaf = ScheduledLeaf { path: n.path, start_day: start_day, finish_day: finish_day, lane: lane, count_source: n.source }
      place_all(
        state: PlaceState {
          placed: list_push(xs: state.placed, item: leaf),
          finish: map_insert(m: state.finish, key: n.key, value: finish_day),
          lanes: map_insert(m: state.lanes, key: lane, value: finish_day),
          bucket: rest,
          rank_now: state.rank_now,
        },
        pred: pred, buckets: buckets, workers: workers, earliest_start: earliest_start
      )
    }
    Empty =>
      if state.rank_now < 0 {
        state
      } else {
        let empty_bucket: List<SchedNode> = []
        place_all(
          state: PlaceState { placed: state.placed, finish: state.finish, lanes: state.lanes, bucket: look_key(m: buckets, key: state.rank_now - 1, dflt: empty_bucket), rank_now: state.rank_now - 1 },
          pred: pred, buckets: buckets, workers: workers, earliest_start: earliest_start
        )
      }
  }
}

// THE COMPLETENESS CHECK, read off the placement's own finish map: the occurrences it did not place, located by
// their carrier paths. A truncated schedule is never handed back as a complete one (fail_closed: a failure arm
// refuses, it never widens), and the reachability of that arm is established by this pass rather than assumed of
// two passes that were never compared.
fn unplaced_occurrences(nodes: List<SchedNode>, finish: Map<String, Int>) -> List<LeafPath> {
  map(filter(nodes, n => !map_contains_key(m: finish, key: n.key)), n => n.path)
}

// The maximum finish day over the placed leaves -- the horizon, the day the schedule empties.
fn horizon_of(leaves: List<ScheduledLeaf>) -> Int {
  fold(leaves, init: 0, g: fn(m, l) { if l.finish_day > m { l.finish_day } else { m } })
}

// How many leaves are in flight on each day, indexed from day 0 to horizon-1. ONE pass over the leaves turns each
// interval [start, finish) into a +1 at its start day and a -1 at its finish day; ONE walk over the days, appending
// the running count in day order, folds those deltas into the series. What stood here filtered every leaf once per day. A leaf spanning no day adds its
// +1 and its -1 on the same day and is counted on none (the expansion emits no zero-day occurrence today -- a Join
// carries none -- but the answer does not depend on that).
fn in_flight(leaves: List<ScheduledLeaf>, horizon: Int) -> List<Int> {
  let delta = fold(leaves, init: empty_map(), f: fn(m, l) {
    let opened = map_insert(m: m, key: l.start_day, value: look_key(m: m, key: l.start_day, dflt: 0) + 1)
    map_insert(m: opened, key: l.finish_day, value: look_key(m: opened, key: l.finish_day, dflt: 0) - 1)
  })
  count_days(d: 0, horizon: horizon, running: 0, delta: delta, acc: [])
}

fn count_days(d: Int, horizon: Int, running: Int, delta: Map<Int, Int>, acc: List<Int>) -> List<Int> {
  if d >= horizon {
    acc
  } else {
    let now = running + look_key(m: delta, key: d, dflt: 0)
    count_days(d: d + 1, horizon: horizon, running: now, delta: delta, acc: list_push(xs: acc, item: now))
  }
}

// A LEAF ALREADY IN FLIGHT AT THE MOMENT OF THE READ (roadmap-schedule-from-now). A pin is a FACT the caller read
// off the item's event log, never a placement this policy chose: the work is being done NOW, so from the read's day
// 0 it holds lane `lane` over the half-open span [start_day, finish_day). What the scheduler does with a pin is
// occupancy and gating, and nothing else:
//   * it is placed BEFORE any unclaimed leaf, so the answer shows it where the log says it already stands;
//   * it is dropped from the rank BUCKETS, so the policy never re-places it and no rank or lane rule is re-run over
//     work already under way -- which is also why this stays ONE scheduler: the buckets are the only place a pin
//     differs from an occurrence;
//   * it stays in the node set and in the adjacency, so an unclaimed leaf that waits on a pinned leaf starts when
//     that pin finishes, through the SAME `dep_finish` gate the policy already uses between its own placements;
//   * its lane is seeded busy until `finish_day`, so no unclaimed leaf is placed on top of it;
//   * when the pins alone fill or exceed the cap, unclaimed leaves wait for the first day the belt has room
//     (`earliest_day_with_room` below), and the caller that derived the pins reports the excess by name.
// The pin's remaining working days arrive through the SAME duration input as any realized count (`realized`, keyed
// by `path_key`): a pin carries no day count of its own, so there is no second path a day number could reach the
// scheduler by. Lanes must be distinct across pins; the from-now read assigns them in claim order, lowest first.
type PinnedLeaf {
  path: LeafPath
  lane: Int
  start_day: Int
  finish_day: Int
}

// THE SCHEDULE, read from the carriers alone: every leaf is priced at its declared prior. This is
// roadmap-schedule-list-scheduling's (#16695) answer and it is UNCHANGED in behaviour -- it delegates to the one
// scheduler with an empty realized map, so a leaf that has never been realized in the log keeps quoting the day
// count it started with.
fn schedule(d: WorkDecomposition, e: Expansion, workers: BeltCapacity) -> Schedule {
  let nothing_realized: RealizedDays = empty_map()
  schedule_with_realized(d: d, e: e, workers: workers, realized: nothing_realized)
}

// THE SCHEDULE AT A DURATION INPUT (roadmap-leaf-realized-duration). Same scheduler, same order, same refusals, same
// lanes: the ONLY difference is that a leaf the item's log has realized is priced at its realized working-day count
// (leaf_working_days above), and every other leaf at its prior. Which value a leaf was priced at is reported by
// gunbc.roadmap.roadmap_leaf_realized_duration::realized_duration_fold -- the fold that produced the map -- so the
// schedule answers, per leaf, whether the realized value or the prior was used.
//
// It hands the pins and the held-out occurrences to the ONE placement below as empty, which is exactly what every
// read before roadmap-schedule-from-now did: there is ONE path from an expansion to a schedule, and the from-now
// link widened that path instead of adding a second scheduler beside it.
fn schedule_with_realized(d: WorkDecomposition, e: Expansion, workers: BeltCapacity, realized: RealizedDays) -> Schedule {
  let no_pins: List<PinnedLeaf> = []
  let nothing_held_out: List<LeafPath> = []
  schedule_pinned(d: d, e: e, workers: workers, realized: realized, pinned: no_pins, unschedulable: nothing_held_out)
}

// THE SCHEDULE AT A DURATION INPUT AND A PINNED-OCCUPANCY INPUT (roadmap-schedule-from-now). The pins are leaves the
// item's log says are being worked right now (see `PinnedLeaf` above): they stand in the answer where the log puts
// them, they gate the starts of leaves that wait on them, and they are never re-placed by the policy.
//
// `unschedulable` names occurrences THIS READ refuses to place -- an in-flight leaf whose remaining days could not
// be worked out is one, and a leaf standing behind such a leaf is another. They are left OUT of the node set
// entirely, so the answer cannot show them, and the caller that named them reports each one by name in its own
// answer: the scheduler never decides WHY a leaf is held out and never silently drops one either. Pricing is NOT
// waived for them: the expansion's own integrity (a member index inside the member set, a day count every leaf
// carries) is the carrier's business, not the caller's to waive, and a held-out occurrence with no day count is a
// broken carrier that still refuses the whole read.
fn schedule_pinned(d: WorkDecomposition, e: Expansion, workers: BeltCapacity, realized: RealizedDays, pinned: List<PinnedLeaf>, unschedulable: List<LeafPath>) -> Schedule {
  let worker_count: Int = workers.max_concurrent
  match e {
    ExpansionRejected { cause: cause } =>
      NotScheduled { refusal: OverRefusedExpansion { cause: cause } }
    Expanded { occurrences: occs, edges: edges, omitted_composites: _ } => {
      if worker_count <= 0 {
        NotScheduled { refusal: ConcurrencyCapInvalid { cap: workers } }
      } else {
        // THE PIN INPUT IS CHECKED BEFORE ANYTHING IS PLACED. A pin is a fact the answer will show and gate on, so a
        // pin this expansion cannot name, or one whose days or lanes no read can hold, refuses the read by name --
        // it is never skipped, and a skipped pin would silently free a lane and un-gate a start (fail_closed: a
        // failure arm refuses, it never widens). ONE grouping pass over the occurrences builds the key set the pins
        // are checked against, and the lane check rides `distinct_by_key`; neither re-filters per pin.
        let unpinable = pins_not_occurrences(occs: occs, pinned: pinned)
        let mispinned = pins_placed_badly(pinned: pinned)
        // EVERY occurrence's working-day prior is read back through its OWN carrier path. An occurrence whose path
        // is not on the decomposition being read against has NO day count, and one is never minted for it
        // (fail_closed: no plausible output is fabricated): the whole answer refuses, CARRYING the carrier paths that
        // hold no prior. `piece_member_days` is asked twice -- once to find the unpriced paths, once to price the
        // nodes -- because it is the ONE authority on the day count; nothing here caches or restates its answer.
        // A member index must sit inside the member set the EXPANSION itself produced for that (item, stage, piece).
        // A findings population declares no member count of its own -- its count is the ASSUMED findings count handed
        // to expand_decomposition -- so the expansion's own member set is the bound; inventing a population count
        // here would mean re-expanding, which this unit never does. Those member-set sizes come from ONE grouping
        // pass over the occurrences the expansion emitted (`member_counts`), not from re-filtering the occurrence
        // list once per occurrence.
        let counts = member_counts(occs: occs)
        let beyond = map(
          filter(occs, o => nat_to_int(n: o.path.member) >= look_or(m: counts, key: occurrence_piece_key(p: o.path), dflt: 0)),
          o => o.path
        )
        if count(unpinable) > 0 {
          NotScheduled { refusal: PinnedLeafNotAnOccurrence { paths: unpinable } }
        } else {
        if count(mispinned) > 0 {
          NotScheduled { refusal: PinnedPlacementInvalid { paths: mispinned } }
        } else {
        if count(beyond) > 0 {
          NotScheduled { refusal: MemberIndexBeyondExpansion { paths: beyond } }
        } else {
          let unpriced = map(
            filter(occs, o => match leaf_working_days(d: d, path: o.path, realized: realized) { Present { value: _ } => false, Absent => true }),
            o => o.path
          )
          if count(unpriced) > 0 {
            NotScheduled { refusal: NoWorkingDayPrior { paths: unpriced } }
          } else {
          let empty_paths: List<LeafPath> = []
          // OCCURRENCES THIS READ HOLDS OUT, keyed ONCE and asked once per occurrence -- never re-filtered per
          // occurrence. A held-out occurrence joins no node set, so no answer can show it; the caller that named it
          // reports it by name in its own answer.
          let held_out = fold(unschedulable, init: empty_map(), f: fn(m, p) { map_insert(m: m, key: path_key(p: p), value: true) })
          let nodes = flat_map(filter(occs, o => !map_contains_key(m: held_out, key: path_key(p: o.path))), o => priced_node(d: d, o: o, realized: realized))
          // THE PINS, standing before the policy runs: their rows in the answer, the finish days an unclaimed leaf
          // waiting on them gates through, and the lanes seeded busy. `pins_not_occurrences` refused any pin naming
          // no node above, so every pin resolves to a priced node here.
          let pinned_rows = pin_rows(nodes: nodes, pinned: pinned)
          let pin_finish = pin_finish_days(pinned: pinned)
          // The lanes busy at the start of the placement: every pin's own lane, PLUS a reservation for every pin
          // whose lane number the lane scan will never reach (see `reserve_over_cap_lanes`).
          let pin_lanes = reserve_over_cap_lanes(
            lanes: pin_lane_free_days(pinned: pinned), pinned: pinned, workers: worker_count)
            let adj = adjacency(nodes: nodes, edges: edges)
            let indeg = indegrees(nodes: nodes, succ: adj.succ)
            let empty_nodes: List<SchedNode> = []
            match topo_run(
              state: TopoState { ready: filter(nodes, n => look_or(m: indeg, key: n.key, dflt: 0) == 0), order: empty_nodes, indeg: indeg, unemitted: count(nodes) },
              succ: adj.succ
            ) {
              Cyclic => NotScheduled { refusal: CyclicOccurrenceGraph }
              Ordered { order: order } => {
                let rank = rank_pass(order_back: list_reverse(xs: order), succ: adj.succ)
                // PINS DROP OUT OF THE BUCKETS AND NOTHING ELSE: the node set, the ordering and the rank pass keep
                // them -- that is what lets an unclaimed leaf that waits on a pin read the pin's finish day through
                // `dep_finish` -- while the placement never re-places work that is already running.
                let pin_keys = fold(pinned, init: empty_map(), f: fn(m, p) { map_insert(m: m, key: path_key(p: p.path), value: true) })
                let to_place = filter(order, n => !map_contains_key(m: pin_keys, key: n.key))
                let buckets = rank_buckets(order: to_place, rank: rank)
                let top_rank = max_rank_of(order: order, rank: rank)
                let empty_bucket: List<SchedNode> = []
                let placed_state = place_all(
                  state: PlaceState { placed: pinned_rows, finish: pin_finish, lanes: pin_lanes, bucket: look_key(m: buckets, key: top_rank, dflt: empty_bucket), rank_now: top_rank },
                  pred: adj.pred, buckets: buckets, workers: worker_count, earliest_start: earliest_day_with_room(pinned: pinned, workers: worker_count)
                )
                // The placement's OWN finish map decides whether the answer is complete; a placement that left an
                // occurrence out refuses instead of being wrapped as `Scheduled`.
                let unplaced = unplaced_occurrences(nodes: nodes, finish: placed_state.finish)
                if count(unplaced) > 0 {
                  NotScheduled { refusal: UnplacedOccurrences { paths: unplaced } }
                } else {
                  let placed = placed_state.placed
                  let horizon = horizon_of(leaves: placed)
                  let crit_start = argmax_node_rank(nodes: nodes, rank: rank)
                  let critical_path = match crit_start {
                    Absent => empty_paths
                    Present { value: n } => follow_critical(n: n, succ: adj.succ, rank: rank, acc: empty_paths)
                  }
                  Scheduled { answer: ScheduleAnswer {
                    workers: workers,
                    leaves: placed,
                    in_flight_per_day: in_flight(leaves: placed, horizon: horizon),
                    horizon: horizon,
                    critical_path: critical_path,
                    critical_length: top_rank,
                  } }
                }
              }
            }
          }
        }
        }
        }
      }
    }
  }
}

// THE PIN INPUT CHECKED BEFORE ANYTHING IS PLACED. A pin naming no occurrence of this expansion would hold a lane
// and gate starts for a leaf the expansion never emitted, so the answer refuses it by name; a pin whose days do not
// run, whose lane or start day is negative, or whose lane a second pin also claims is refused the same way. ONE
// grouping pass builds the occurrence key set and the lane check rides `distinct_by_key` -- neither re-filters the
// pins per pin.
fn pins_not_occurrences(occs: List<Occurrence>, pinned: List<PinnedLeaf>) -> List<LeafPath> {
  let occ_keys = fold(occs, init: empty_map(), f: fn(m, o) { map_insert(m: m, key: path_key(p: o.path), value: true) })
  map(filter(pinned, p => !map_contains_key(m: occ_keys, key: path_key(p: p.path))), p => p.path)
}

fn pins_placed_badly(pinned: List<PinnedLeaf>) -> List<LeafPath> {
  let lane_count = count(distinct_by_key(xs: pinned, key: p => to_string(p.lane)))
  // A pin is work ALREADY RUNNING at the read date, so it runs from day 0 of the read to its finish: a pin starting
  // later would hold a lane over days it is not working, and the lane reservation that enforces the cap per
  // placement reads exactly that prefix shape. A lane below zero, a bar that runs no day, or a lane two pins share
  // are refused the same way.
  let malformed = filter(pinned, p => p.lane < 0 || p.start_day != 0 || p.finish_day <= p.start_day)
  if count(pinned) != lane_count {
    map(pinned, p => p.path)
  } else {
    map(malformed, p => p.path)
  }
}

// THE PINS AS ROWS OF THE ANSWER, in the order the caller pinned them (claim order, from the from-now read). A pin
// carries no day count of its own: its `count_source` is the source its priced node carries, and the days it spans
// are the days the duration input priced that node at.
fn pin_rows(nodes: List<SchedNode>, pinned: List<PinnedLeaf>) -> List<ScheduledLeaf> {
  let by_key = fold(nodes, init: empty_map(), f: fn(m, n) { map_insert(m: m, key: n.key, value: n) })
  flat_map(pinned, p => match map_lookup(m: by_key, key: path_key(p: p.path)) {
    Absent => []
    Present { value: n } => [ScheduledLeaf { path: n.path, start_day: p.start_day, finish_day: p.finish_day, lane: p.lane, count_source: n.source }]
  })
}

// The day each pin frees its lane, keyed as the placement keys every other finish day: an unclaimed leaf that waits
// on a pin reads it through the SAME `dep_finish`, and its lane reads it busy until that day.
fn pin_finish_days(pinned: List<PinnedLeaf>) -> Map<String, Int> {
  fold(pinned, init: empty_map(), f: fn(m, p) { map_insert(m: m, key: path_key(p: p.path), value: p.finish_day) })
}

fn pin_lane_free_days(pinned: List<PinnedLeaf>) -> Map<Int, Int> {
  fold(pinned, init: empty_map(), f: fn(m, p) { map_insert(m: m, key: p.lane, value: p.finish_day) })
}

// THE CAP HOLDS PER PLACEMENT, NOT ONCE AS A FLOOR. Pins are facts: k of them hold k lanes whether or not k fits the
// cap, and the read that derived them names the excess (roadmap_schedule_from_now's `pins_over_capacity`). But the
// lane scan looks at lanes `0..workers-1` only, so a pin parked on lane `workers` or beyond is a lane the placement
// never sees -- and a belt already full of such pins would otherwise launch an unclaimed leaf on top of it, which is
// a plan that breaks its own limit and says nothing. So each pin whose lane is at or past the cap has its days
// folded onto the LEAST-LOADED lane below the cap, closing that lane until the pin finishes: the closed lane is the
// capacity the pin consumes, and the gate that already serializes a lane then checks it at every placement, not once
// for the whole schedule. Cost: one fold over the pins, each step a `scan_lanes` across the cap's own width -- the
// shape the lane choice already pays per placement.
//
// WHY FOLDING IN ANY ORDER IS SAFE. Every pin row is a prefix of the read -- it runs from day 0 to its finish day,
// which `pins_placed_badly` now insists on -- so a closure of [0, finish) covers every day that pin covers. A fold
// that lands on a lane already held at least as long records nothing new, and that is sound: the fold chose the
// least-loaded lane, so every OTHER lane is held at least as long too, which is exactly when the pins alone already
// fill the cap and no unclaimed leaf may start at all. A fold absorbed by a leaf's own finish day only ever closes a
// lane for longer than the pin needed, which delays placements and never launches an extra one.
fn reserve_over_cap_lanes(lanes: Map<Int, Int>, pinned: List<PinnedLeaf>, workers: Int) -> Map<Int, Int> {
  fold(pinned, init: lanes, f: fn(m, p) {
    if p.lane < workers {
      m
    } else {
      let lane = scan_lanes(i: 0, workers: workers, lanes: m, best_lane: 0, best_free: look_key(m: m, key: 0, dflt: 0))
      let held = look_key(m: m, key: lane, dflt: 0)
      if p.finish_day > held { map_insert(m: m, key: lane, value: p.finish_day) } else { m }
    }
  })
}

// THE CALLER'S FLOOR ON A START DAY: the first day on which fewer than `workers` pins are running. It is a floor
// and nothing more -- a single day for the whole schedule, so it cannot by itself keep the cap: pins parked past
// the cap sit on lanes the lane scan never reads, and two unclaimed leaves launched on the first day this answers
// can still crowd a pin that runs past it. `reserve_over_cap_lanes` is what makes the cap hold at every placement;
// this is the day the caller additionally refuses to start anything before. Pins are facts: k of them hold k lanes
// whether or not k fits the cap, and the read that derived them says so by name
// (roadmap_schedule_from_now's `pins_over_capacity`). ONE pass turns the pins into day
// deltas and ONE walk folds them -- the shape `in_flight` already uses -- and the walk is bounded by the last pin's
// finish day, past which no pin runs at all. With no pins it answers 0, which is the gate every read before
// roadmap-schedule-from-now ran under: `start_day` is then exactly `max(dep, lane_free)`, byte for byte.
fn earliest_day_with_room(pinned: List<PinnedLeaf>, workers: Int) -> Int {
  let delta = fold(pinned, init: empty_map(), f: fn(m, p) {
    let opened = map_insert(m: m, key: p.start_day, value: look_key(m: m, key: p.start_day, dflt: 0) + 1)
    map_insert(m: opened, key: p.finish_day, value: look_key(m: opened, key: p.finish_day, dflt: 0) - 1)
  })
  let last_day = fold(pinned, init: 0, g: fn(m, p) { if p.finish_day > m { p.finish_day } else { m } })
  wait_for_room(d: 0, limit: last_day, running: 0, delta: delta, workers: workers)
}

fn wait_for_room(d: Int, limit: Int, running: Int, delta: Map<Int, Int>, workers: Int) -> Int {
  if d >= limit {
    limit
  } else {
    let now = running + look_key(m: delta, key: d, dflt: 0)
    if now < workers {
      d
    } else {
      wait_for_room(d: d + 1, limit: limit, running: now, delta: delta, workers: workers)
    }
  }
}

// THE SCHEDULE'S DURATION INPUT, named in ONE place. A leaf's working-day count is the count this scheduler pays
// for its occurrence: the LOG's realized value where one exists, and the carrier's declared prior otherwise. The
// realized side is produced by gunbc.roadmap.roadmap_leaf_realized-duration (roadmap-leaf-realized-duration),
// which reads a leaf's claimed-to-accepted working days out of the item's event log; the prior side is
// roadmap_decomposition::piece_member_days, the carrier's declared prior, imported and never copied.
//
// This REPLACES a duration; it never reorders. The scheduler's ORDER -- the topological order, the
// longest-remaining-path ranks, the lane picking -- reads only the occurrence graph and these counts, exactly as
// before; no rank, lane or placement rule is touched here. A realized count therefore changes WHICH day count a
// leaf is priced at, which is what the Gantt needs to show work already done, and nothing else.
//
// The map is keyed by `path_key` -- the ONE key this unit derives from a LeafPath -- so a realized value can only
// ever address a leaf the carrier itself can name; an unknown key is simply absent, and that leaf keeps its prior.
type RealizedDays = Map<String, Int>

// The working-day count ONE leaf occurrence is priced at, at the duration input. Where the fold handed a realized
// count for this leaf's key, that count is taken; otherwise the carrier's prior is taken. `Absent` means NEITHER
// exists: the path is unpriced and the scheduler refuses the whole answer (NoWorkingDayPrior), never a zero.
fn leaf_working_days(d: WorkDecomposition, path: LeafPath, realized: RealizedDays) -> Int? {
  match map_lookup(m: realized, key: path_key(p: path)) {
    Present { value: days } => Present { value: days }
    Absent => piece_member_days(d: d, path: path)
  }
}

// The run node an occurrence prices to, or nothing when NEITHER a realized value nor a working-day prior prices it.
// The `Absent` arm is not a silent drop: every such occurrence has already refused the whole answer above, and the
// arm is here so nothing can be invented for a path nobody prices.
fn priced_node(d: WorkDecomposition, o: Occurrence, realized: RealizedDays) -> List<SchedNode> {
  match leaf_working_days(d: d, path: o.path, realized: realized) {
    Present { value: days } => [SchedNode { path: o.path, key: path_key(p: o.path), days: days, source: o.count_source }]
    Absent => []
  }
}

// WHAT A RE-READ ANSWERS, and where the cache the caller held stands against it
// (gunbc.design_ruling::schedule_answers_are_computed_cached_and_re_read: the schedule is COMPUTED from the
// carriers; it MAY be cached; a cache is DERIVED and NEVER authoritative; the answer is RECOMPUTED ON READ). The
// answer a read serves is ALWAYS the recomputed one -- the cache never wins -- and the arm says what the cache got
// wrong, so a stale cache is DETECTED at the read instead of being served silently or dropped silently.
// `ReadRefused` is the recomputation's own typed refusal: a cached answer is never a reason to answer when the
// recomputation itself refuses.
type ScheduleRead
  = ReadRefused { refusal: ScheduleRefusal }
  | CacheHeldNothing { answer: ScheduleAnswer }
  | CacheMatches { answer: ScheduleAnswer }
  | CacheSuperseded { answer: ScheduleAnswer, stale_leaves: Int, stale_answer_fields: Int }

// THE ONE READ CONSUMERS USE (roadmap-schedule-bottlenecks-and-offer, then roadmap-work-item-projection): hand it the
// decomposition, its expansion, the worker count, and whatever you last cached; it recomputes and answers.
fn schedule_read(d: WorkDecomposition, e: Expansion, workers: BeltCapacity, cached: Schedule) -> ScheduleRead {
  match schedule(d: d, e: e, workers: workers) {
    NotScheduled { refusal: refusal } => ReadRefused { refusal: refusal }
    Scheduled { answer: fresh } => match cached {
      // Nothing usable was cached: the caller holds no answer, or holds a cached refusal.
      NotScheduled { refusal: _ } => CacheHeldNothing { answer: fresh }
      Scheduled { answer: held } => {
        // Every divergence between the cached answer and the recomputed one is counted, in BOTH directions, each
        // leaf located by the one path_key: placed differently or not at all in the cache, and cached leaves that
        // are no longer placed. The aggregate fields are compared too, so a cache carried over from a different
        // worker count or horizon cannot masquerade as a matching one.
        let moved = count(filter(fresh.leaves, l => match scheduled_at(a: held, path: l.path) {
          Absent => true
          Present { value: k } => !(k.start_day == l.start_day && k.finish_day == l.finish_day && k.lane == l.lane
            && k.count_source == l.count_source)
        }))
        let dropped = count(filter(held.leaves, k => match scheduled_at(a: fresh, path: k.path) {
          Absent => true
          Present { value: _ } => false
        }))
        let fields = stale_answer_fields(fresh: fresh, held: held)
        if moved + dropped + fields == 0 { CacheMatches { answer: fresh } }
        else { CacheSuperseded { answer: fresh, stale_leaves: moved + dropped, stale_answer_fields: fields } }
      }
    }
  }
}

// Which aggregate fields of a cached answer no longer match the recomputed one: the worker count, the horizon, the
// critical length, and the shapes of the in-flight series and of the critical path (spelled through the one
// path_key, never a restated key format).
fn stale_answer_fields(fresh: ScheduleAnswer, held: ScheduleAnswer) -> Int {
  let w = if fresh.workers.max_concurrent == held.workers.max_concurrent { 0 } else { 1 }
  let h = if fresh.horizon == held.horizon { 0 } else { 1 }
  let c = if fresh.critical_length == held.critical_length { 0 } else { 1 }
  let f = if count(fresh.in_flight_per_day) == count(held.in_flight_per_day) { 0 } else { 1 }
  let p = if join(map(fresh.critical_path, q => path_key(p: q)), ",") == join(map(held.critical_path, q => path_key(p: q)), ",") { 0 } else { 1 }
  w + h + c + f + p
}

// ACCESSORS so a reader consumes a ScheduleRead without matching its coproduct: the answer the read serves (none
// when the recomputation refused), and how many cached leaves the recomputation superseded.
fn schedule_read_answer(r: ScheduleRead) -> ScheduleAnswer? {
  match r {
    ReadRefused { refusal: _ } => none
    CacheHeldNothing { answer: a } => Present { value: a }
    CacheMatches { answer: a } => Present { value: a }
    CacheSuperseded { answer: a, stale_leaves: _, stale_answer_fields: _ } => Present { value: a }
  }
}

fn schedule_read_refusal(r: ScheduleRead) -> ScheduleRefusal? {
  match r {
    ReadRefused { refusal: r } => Present { value: r }
    _ => none
  }
}

fn schedule_read_stale_leaves(r: ScheduleRead) -> Int {
  match r {
    CacheSuperseded { answer: _, stale_leaves: n, stale_answer_fields: _ } => n
    _ => 0
  }
}

// How many AGGREGATE fields of the cached answer the recomputation superseded (worker count, horizon, critical
// length, in-flight shape, critical-path keys). Zero with a non-zero stale_leaves means the cache was right about
// the totals and wrong about the placement.
fn schedule_read_stale_answer_fields(r: ScheduleRead) -> Int {
  match r {
    CacheSuperseded { answer: _, stale_leaves: _, stale_answer_fields: n } => n
    _ => 0
  }
}

// ACCESSORS so a reader consumes a Schedule without matching its coproduct (and without naming its constructors
// beside the imported Expansion's). Each hands back the TYPED thing -- the answer, or the refusal -- rather than a
// Bool that flattens which arm fired; a reader that must act differently per cause reads `schedule_refusal` and
// matches its arm, and one that only needs the fields reads `schedule_answer`.
fn schedule_answer(s: Schedule) -> ScheduleAnswer? {
  match s {
    Scheduled { answer: a } => Present { value: a }
    NotScheduled { refusal: _ } => none
  }
}

fn schedule_refusal(s: Schedule) -> ScheduleRefusal? {
  match s {
    Scheduled { answer: _ } => none
    NotScheduled { refusal: r } => Present { value: r }
  }
}

// The placed leaf for a carrier path, if it was scheduled -- the witness reads a leaf's day and lane this way,
// through the single path_key the schedule is keyed by (both sides go through path_key; no second key format).
fn scheduled_at(a: ScheduleAnswer, path: LeafPath) -> ScheduledLeaf? {
  first_where(a.leaves, l => path_key(p: l.path) == path_key(p: path))
}

// The critical path spelled as path keys, in order from the start of the longest remaining path -- each key is the
// single path_key applied to the path, never a restated format.
fn critical_path_keys(a: ScheduleAnswer) -> List<String> {
  map(a.critical_path, p => path_key(p: p))
}

fn scheduled_leaf_count(a: ScheduleAnswer) -> Int {
  count(a.leaves)
}

// THE DERIVED CACHE RECORD: wrap a computed answer as the Schedule a later `schedule_read` may be handed. It is a
// cache and nothing more -- the read recomputes and never serves it, which is what makes a stale one superseded.
fn as_cache(a: ScheduleAnswer) -> Schedule {
  Scheduled { answer: a }
}
