module gunbc.roadmap.native_emit_fixture_param_optional

// THROWAWAY bisect matrix CONTROL (node://adhoc-aade5300-c0e, R4). NonEmptyStr bound from a PARAMETER
// Optional (no fn-return indirection, no bare Absent arm, no module-data arm). If this EMITS while
// arms-first/second-absent REFUSE, the defect is specific to matching an fn-RETURNED Optional<T>. If it ALSO
// refuses, binding a NonEmptyStr from ANY matched Optional fails at emit (broader).
import std.types { String, Bool, NonEmptyStr }

fn use_c(p: Optional<NonEmptyStr>) -> String {
  match p {
    Absent {} => "none"
    Present { value: v } => v as String
  }
}

data fixture_emit_hook_c: String = use_c(p: Present { value: "fixture-c" as NonEmptyStr })
