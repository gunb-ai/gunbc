module gunbc.roadmap.roadmap_issue_command

import std.types { String, NonEmptyStr }
import std.algebra { trim, string_compare_canonical, Ordering, Less }
import extdeps.entropy { Urandom }
import std.encoding { base64_decode, Standard }
import gunbc.roadmap.roadmap_model { RoadmapNodeId, RoadmapAcceptanceReceipt, AcceptanceRevocationDisposition }
import gunbc.roadmap.roadmap_event_log {
  EventPrincipal, RoadmapEventId, RoadmapEvent, Claimed, CommentCreated, Retired,
  AcceptanceRecordedEvent, AcceptanceRevokedEvent, roadmap_event_id_for, roadmap_event_schema,
  roadmap_acceptance_pr_evidence_cutoff, AcceptancePrEvidence, NoPullRequest, EarnedByPullRequest,
}
import gunbc.roadmap.roadmap_event_carrier { RoadmapEventCarrierLayout, RoadmapEventAppend, CarrierClosed, roadmap_event_append }

// Authorization precedes this boundary. The operation is a submission identity, independent of
// comment text or the observation clock. Native forms receive it before submission, just as JS does.
type IssueCommandSubject {
  node: RoadmapNodeId
  author: EventPrincipal
  operation: NonEmptyStr
  expected: RoadmapEventId?
}

type IssueCommand
  = AssignIssue { subject: IssueCommandSubject, assignee: EventPrincipal, return_to: EventPrincipal }
  | CreateComment { subject: IssueCommandSubject, body: NonEmptyStr }
  // The operator's retirement (operator ruling 2026-11-04): end ANY work item, in ANY state — no
  // PR, no lineage-state precondition. The durable fact is the event log's Retired kind, authored by
  // the authenticated operator principal, so the record reads 'retired by <principal>'. Terminality
  // is the ROUTE's check (an already-retired or accepted node refuses); the command itself carries
  // no admission, because the operator's authority is the admission.
  | RetireNode { subject: IssueCommandSubject, reason: NonEmptyStr }
  // THE OPERATOR'S ACCEPTANCE, AS A COMMAND ON THE SAME ROUTE as an assignment or a retirement. The
  // receipt is the record the operator law spells — the live receipt it names, its red control, its
  // handback — and the PR facts are the readback's, never the operator's claims. The receipt names the
  // node it accepts, and the command's subject names the node being written; `issue_command_apply`
  // refuses the pair when they disagree, so no caller can accept a node other than the one its own
  // receipt was written for (gunbc.design_ruling::plans_reset_and_audit_recommendations_2026_11_08:
  // accepted lives in the event log and nowhere else).
  | AcceptNode {
      subject: IssueCommandSubject,
      receipt: RoadmapAcceptanceReceipt,
      // THE PULL REQUEST IS ONE FACT OF THIS COMMAND, TYPED: either the acceptance was earned by a
      // review thread (url, merge time and head together — AcceptancePrEvidence
      // EarnedByPullRequest), or there was no pull request (NoPullRequest). Half a pull request cannot be
      // constructed, so no check has to catch it downstream. NoPullRequest is admissible only for a
      // receipt the operator recorded before this log became the authority — the dated law below.
      evidence: AcceptancePrEvidence,
    }
  // THE SAME RECEIPT, UNDONE, ON THE SAME ROUTE. `disposition` is the standing the node returns to and
  // is READ from the operator's revocation line — there is no default to fall into. Whether the receipt
  // named is a live acceptance is the append route's law (roadmap_event_log
  // roadmap_revocation_names_live_acceptance), enforced where the history is read.
  | RevokeAcceptance {
      subject: IssueCommandSubject,
      receipt: RoadmapAcceptanceReceipt,
      disposition: AcceptanceRevocationDisposition,
      revoked_by: String,
      revoked_on: String,
      reason: String,
    }

type IssueFormContext { operation: String, csrf: String }

fn issue_operation_nonce() -> String? {
  let wire = trim(Urandom.ReadBytes(count: 32).octets_b64)
  match base64_decode(s: wire, variant: Standard) {
    Absent => none
    Present { value: bytes } => if count(bytes) != 32 { none }
      else { Present { value: replace(replace(replace(wire, "+", "-"), "/", "_"), "=", "") } }
  }
}

fn issue_command_event(command: IssueCommand, recorded_at: String) -> RoadmapEvent {
  match command {
    AssignIssue { subject, assignee, return_to } => RoadmapEvent { node: subject.node, author: subject.author,
      parent: subject.expected, kind: Claimed { assignee: assignee, return_to: return_to }, recorded_at: recorded_at }
    CreateComment { subject, body } => RoadmapEvent { node: subject.node, author: subject.author,
      parent: subject.expected, kind: CommentCreated { comment: subject.operation, body: body, visibility: "public", parent_comment: none }, recorded_at: recorded_at }
    RetireNode { subject, reason } => RoadmapEvent { node: subject.node, author: subject.author,
      parent: subject.expected, kind: Retired { reason: reason }, recorded_at: recorded_at }
    AcceptNode { subject, receipt, evidence } => RoadmapEvent { node: subject.node, author: subject.author,
      parent: subject.expected, kind: AcceptanceRecordedEvent { receipt: receipt, evidence: evidence }, recorded_at: recorded_at }
    RevokeAcceptance { subject, receipt, disposition, revoked_by, revoked_on, reason } => RoadmapEvent { node: subject.node, author: subject.author,
      parent: subject.expected, kind: AcceptanceRevokedEvent { receipt: receipt, disposition: disposition, revoked_by: revoked_by, revoked_on: revoked_on, reason: reason }, recorded_at: recorded_at }
  }
}

// THE NODE A RECEIPT ACCEPTS. The receipt carries its own node; the command's subject carries the node
// being written; the two must name the same node or the event would be a claim about a node its own
// evidence does not name.
fn issue_command_receipt_node(receipt: RoadmapAcceptanceReceipt) -> String {
  receipt.node as String
}

// THE PULL-REQUEST EVIDENCE LAW, in one place: the dated door, and nothing else. A command that names a
// review thread needs no check — the type already guarantees the thread, its merge time and its head came
// as one fact. A command that says there was NO pull request is admitted only for a receipt whose
// accepted_on day is before gunbc.roadmap.roadmap_event_log roadmap_acceptance_pr_evidence_cutoff: that
// absence is the one-time migration's case, and nothing else. An acceptance earned after this log became
// the authority must name the pull request it was earned by — an absence may only ever mean "this fact
// never carried one", never "nobody looked".
fn issue_command_acceptance_evidence_law(receipt: RoadmapAcceptanceReceipt, evidence: AcceptancePrEvidence) -> String? {
  match evidence {
    EarnedByPullRequest { pr_url: _, merged_at: _, head_sha: _ } => none
    NoPullRequest => {
      let day = receipt.accepted_on as String
      if string_compare_canonical(a: day, b: roadmap_acceptance_pr_evidence_cutoff()) == Less { none }
      else {
        Present { value: join(["an acceptance with no pull request is admitted only for a receipt the operator recorded before ",
          roadmap_acceptance_pr_evidence_cutoff(), "; this receipt says it was accepted on '", day,
          "'. A live acceptance names the pull request it was earned by — an absent field may only mean this fact never carried one, never that nobody looked"], "") }
      }
    }
  }
}
fn issue_command_apply(layout: RoadmapEventCarrierLayout, command: IssueCommand, recorded_at: String) -> CarrierClosed<RoadmapEventAppend> {
  let event = issue_command_event(command: command, recorded_at: recorded_at)
  match issue_command_receipt_disagreement(command: command, event: event) {
    Present { value: why } => CarrierClosed {
      result: EventAppendRefused { id: roadmap_event_id_for(e: event, schema: roadmap_event_schema), step: "receipt", reason: why },
      close: SnapshotNotOpened }
    Absent => {
      let operation = match command { AssignIssue { subject, assignee: _, return_to: _ } => subject.operation CreateComment { subject, body: _ } => subject.operation RetireNode { subject, reason: _ } => subject.operation AcceptNode { subject, receipt: _, evidence: _ } => subject.operation RevokeAcceptance { subject, receipt: _, disposition: _, revoked_by: _, revoked_on: _, reason: _ } => subject.operation }
      roadmap_event_append(layout: layout, event: event, operation: operation as String)
    }
  }
}

// THE COMMAND'S EVIDENCE LAW, REFUSED AT THE ROUTE BEFORE ANY WRITE. Two things are checked here, both
// about the receipt the command carries:
//   1. A RECEIPT THAT NAMES ANOTHER NODE IS REFUSED. The reason is the mismatch itself: a caller that
//      meant this node fixes the subject, and a caller that meant the other node fixes the receipt;
//      neither gets to write an event whose evidence is about something else.
//   2. AN ABSENCE OF A PULL REQUEST IS DATED. The pull request is typed as one fact
//      (gunbc.roadmap.roadmap_event_log AcceptancePrEvidence), so "url with no merge time" is not a
//      command that has to be refused here — it cannot be built; the command line, which is the untyped
//      edge, refuses it at gunbc.roadmap.roadmap_event_cli roadmap_acceptance_pr_evidence_from_args.
//      What remains for the route is the law the type cannot state: NoPullRequest is admitted only when
//      the receipt's own accepted_on day is before gunbc.roadmap.roadmap_event_log
//      roadmap_acceptance_pr_evidence_cutoff — the one-time migration of the acceptances the operator
//      recorded before this log became the authority, and nothing else. An acceptance earned today must
//      name the pull request that earned it: an absence may only ever mean "this fact never carried one",
//      never "nobody looked".
fn issue_command_receipt_disagreement(command: IssueCommand, event: RoadmapEvent) -> String? {
  match command {
    AcceptNode { subject, receipt, evidence } =>
      if (subject.node as String) != issue_command_receipt_node(receipt: receipt) {
        Present { value: join(["the acceptance receipt names node '", issue_command_receipt_node(receipt: receipt), "' but the command's subject is node '", subject.node as String, "'"], "") }
      } else { issue_command_acceptance_evidence_law(receipt: receipt, evidence: evidence) }
    RevokeAcceptance { subject, receipt, disposition: _, revoked_by: _, revoked_on: _, reason: _ } =>
      if (subject.node as String) != issue_command_receipt_node(receipt: receipt) {
        Present { value: join(["the revocation receipt names node '", issue_command_receipt_node(receipt: receipt), "' but the command's subject is node '", subject.node as String, "'"], "") }
      } else { none }
    AssignIssue { subject: _, assignee: _, return_to: _ } => none
    CreateComment { subject: _, body: _ } => none
    RetireNode { subject: _, reason: _ } => none
  }
}
