module gunbc.roadmap_live_projection

import gunbc.roadmap_authority { RoadmapAuthorityProjection, RoadmapAuthorityProjected, RoadmapAuthorityProjectionRefused, roadmap_authority_projection, roadmap_acceptance_event_history_load }
import gunbc.roadmap.roadmap_event_log { RoadmapEventEnvelope }
import gunbc.roadmap_live_document { roadmap_live_document_over, LiveDocumentProjected, LiveDocumentRefused }
import gunbc.fabric_storage_binding { fabric_state_storage_binding }
import gunbc.roadmap.roadmap_event_carrier { roadmap_event_carrier_service_layout, roadmap_event_snapshot_read, RoadmapEventSnapshotObserved, RoadmapEventSnapshotRefused }

fn roadmap_live_projection_over(authored: RoadmapAuthorityProjection, events: List<RoadmapEventEnvelope>) -> RoadmapAuthorityProjection {
  match authored {
    RoadmapAuthorityProjectionRefused { detail: _ } => authored
    RoadmapAuthorityProjected { doc, accepted, withheld } => match roadmap_live_document_over(doc: doc, events: events) {
      LiveDocumentRefused { detail } => RoadmapAuthorityProjectionRefused { detail: detail }
      LiveDocumentProjected { doc: projected } => RoadmapAuthorityProjected { doc: projected, accepted: accepted, withheld: withheld }
    }
  }
}

fn roadmap_live_authority_projection() -> RoadmapAuthorityProjection {
  match roadmap_event_snapshot_read(layout: roadmap_event_carrier_service_layout(store: fabric_state_storage_binding())) {
    RoadmapEventSnapshotRefused { step, reason } => RoadmapAuthorityProjectionRefused { detail: join(["live issue state unavailable at ", step, ": ", reason], "") }
    RoadmapEventSnapshotObserved { snapshot } => roadmap_live_projection_over(
      authored: roadmap_authority_projection(history: roadmap_acceptance_event_history_load()), events: map(snapshot.events, e => e.envelope))
  }
}
