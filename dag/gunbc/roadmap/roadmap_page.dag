fn roadmap_page_max_depth() -> Int { 12 }

// The finish-line block is REFERENCE prose, not operational attention (A1 of the presentation
// recon, operator-signed 2026-08-01): the daily workspace's declared archetype is Operational
// (gunbc.design.archetype dashboard_archetype), so / leads with the frontier and carries only the
// one-line program strip (program_progress_markup_of, the ProgramProgressView consumer); the four
// claims render on /roadmap, where the strategic argument lives. The 2026-07-28 stylesheet-debt
// scaffold that shipped this section unstyled dissolved in the same pass: the gate/brick rules are
// deleted, .finish-line-* rules exist on the tokened grain, and roadmap_css_lift_parity_digest was
// re-pinned by execution (see the A1 re-pin note in
// test.claim.design_register_lift_parity_witness). The count line under the heading is the LOCAL
// denominator — accepted finish lines over the four — never the global roadmap population, which
// belonged to a different question (review: the section visually implied a denominator of four
// while reporting an unrelated global one).

fn finish_line_state_class(accepted: Bool) -> String {
  if accepted { "accepted" } else { "active" }
}

fn finish_line_row(spec: V1FinishLineSpec, accepted_ids: List<RoadmapNodeId>) -> Fragment {
  let accepted = v1_finish_line_accepted(spec: spec, accepted: accepted_ids)
  el_class("li", concat("finish-line finish-line-", finish_line_state_class(accepted: accepted)), [
    el_class("span", "finish-line-state", [ txt(finish_line_state_class(accepted: accepted)) ]),
    el_class("span", "finish-line-name", [ txt(spec.name) ]),
    el_class("span", "finish-line-node", [ txt(spec.node as String) ]),
    el_class("span", "finish-line-claim", [ txt(spec.claim) ]),
  ])
}

fn finish_line_local_count_label(accepted_ids: List<RoadmapNodeId>) -> String {
  join([
    to_string(v1_finish_lines_accepted_count(accepted: accepted_ids)),
    " of ",
    to_string(count(v1_exit_finish_lines())),
    " complete",
  ], "")
}

fn finish_line_progress_markup_for_accepted(accepted_ids: List<RoadmapNodeId>) -> Fragment {
  el_class("section", "finish-line-progress", [
    el("h2", [ txt("v1 exit: four finish lines") ]),
    el_class("p", "finish-line-counts", [ txt(finish_line_local_count_label(accepted_ids: accepted_ids)) ]),
    el_class("ul", "finish-lines",
      map(v1_exit_finish_lines(), s => finish_line_row(spec: s, accepted_ids: accepted_ids))),
  ])
}

fn finish_line_progress_markup() -> Fragment {
  match frontier_sets_projection(history: roadmap_acceptance_event_history_load()) {
    FrontierSetsProjectionRefused { detail: detail } =>
      el_class("section", "finish-line-progress", [
        el("h2", [ txt("v1 exit: four finish lines") ]),
        el_class("p", "finish-line-refused", [
          txt(concat("acceptance carrier refused: ", detail)),
        ]),
      ])
    FrontierSetsProjected { accepted: accepted_ids, withheld: _ } =>
      finish_line_progress_markup_for_accepted(accepted_ids: accepted_ids)
  }
}

fn dashboard_instance_banner() -> Fragment {
  el_class("section", dashboard_instance_class, [
    el_class("span", dashboard_instance_label_class, [
      txt("instance · observing"),
    ]),
  ])
}

// The mute lives in the HEADER, pushed to the far edge by margin-left auto, because it is a
// property of the whole surface rather than of any row — a per-row mute would be a second control
// on every line, which is exactly what the exemplar's scope forbids. The former empty-label
// rendering was corrected at A1 (presentation recon, 2026-08-01): honest-before-JS does not require
// blankness — a blank button has no visible content and no accessible name, which is a defect, not
// honesty. The TWO TOGGLES SHIP DIFFERENT AMOUNTS OF STATE, and the asymmetry is the honesty
// boundary, not an inconsistency (A1 reconciliation, operator feedback 2026-08-01): the theme
// control ships 'theme · auto' because at parse time the document carries no data-theme and
// prefers-color-scheme governs — which is the DEFINITION of auto, true for every visitor until the
// client program applies a stored choice; the sound control ships only its NAME because its state
// has no parse-time truth — the preference lives in this browser's storage (unreadable at serve),
// and for a no-JS visitor no sound ever plays, so any shipped state word would be a fabricated
// claim for someone. The client program repaints both from storage on load, exactly as before.





// A1 header decision (presentation recon, operator-signed 2026-08-01): the header carries a TEXT
// wordmark, not the site mark. The mark that stood here was gunbc.site.mark candidate A
// ('Confluence') — an explicitly unselected brand experiment (DESIGN's site thread still owes
// candidates B–D) whose aria-label said 'gunb.ai mark' on a gunbc operational tool: a public-site
// brand artifact leaking into a tool surface. The minimal correct move is the wordmark; a drawn
// mark returns if and when an actual brand-selection task runs (the sandbox auditioner is the
// venue, the swatch-graduation precedent). The h1 carries the PAGE name alone — the product name
// lives in the wordmark, so the two never restate each other.

data header_composition_frame_note: String = "HEADER AND CONTENT RUN FULL WIDTH (operator ruling 2026-09-24, superseding the 2026-08-02 centered-measure frame): the page takes the full viewport like the issue-tracker model — the measure_page cap and auto-centering are retired from .header-inner, .roadmap, and .daily-workspace. The header element keeps its full-width surface and border — it is a chassis edge — and its content in .header-inner now flows edge to edge with the same side padding the content containers carry. measure_page survives only on the sandbox audition surfaces, which are deliberately narrow."

// The header carries one link per SERVED page a human navigates between, so splitting the fleet
// panels off the workspace does not make them unreachable. The link set is authored here rather
// than derived from gunbc.roadmap_serve's route table on purpose and the reason is a layering one:
// that table is the transport's routing authority and includes assets, JSON reads and POST verbs
// that are not navigation destinations, so deriving from it would need a second predicate saying
// which rows a person navigates to -- a fact this page owns. If the pair ever disagrees the tell is
// a 404 from a header link, which is why the link text and the route literal are the only two
// spellings and both live one grep apart.


// The status vocabulary the page renders (chip text, node-<key> classes, altitude-band counts) is
// work_lifecycle_key over the seam's WorkLifecycle — the node_status_symbol decision moved to
// gunbc.roadmap_presentation as its single authority (operator blocker 1, 2026-08-01: the old
// renderer independently re-decided open/review/done/superseded beside the seam). The key set is
// unchanged, so the altitude machinery and the styling grain consume the same four words.

fn node_lifecycle_key(rn: RoadmapNode, merged: List<Int>) -> String {
  work_lifecycle_key(l: work_lifecycle(rn: rn, merged: merged))
}

// The lead is the row's at-a-glance face: the seam's row_headline (the ticket's typed headline; for
// legacy lines the named lead residue inside gunbc.roadmap_presentation). A row whose LEAD is
// itself paragraph-length defeats the disclosure — the brief stays collapsed but the summary line
// does not, so the reader pays the full text anyway. The bound is authoring residue, not a
// structural class: no construction forbids a long sentence, so this is the §5-sanctioned lens over
// the genuinely unstructurable part, and it is typed/located/counted (node id + measured length)
// rather than a bare Bool, so a red says WHICH row and by how much. 300 chars is the operator's
// declared bound (roadmap-workspace-ux-plan.md P1b); an offender is re-cut by moving its summary
// delimiter earlier or splitting its content, while the body remains available behind the
// disclosure.

fn roadmap_lead_budget_chars() -> Int { 300 }

type LeadBudgetViolation {
  node: String
  lead_chars: Int
}

fn lead_budget_violations(nodes: List<RoadmapNode>) -> List<LeadBudgetViolation> {
  fold(nodes, init: [], f: (acc, rn) => {
    let n = row_headline(line: rn.line).length()
    if n > roadmap_lead_budget_chars() {
      concat(acc, [LeadBudgetViolation { node: rn.node as String, lead_chars: n }])
    } else {
      acc
    }
  })
}

fn roadmap_authority_lead_budget_violations() -> List<LeadBudgetViolation> {
  lead_budget_violations(nodes: declared_roadmap_nodes())
}

// The brief bound (operator's ticket model: a brief is ~100 words or less, read daily). Same shape
// as the lead budget: authoring residue no construction can forbid, so a typed located counted
// census — a red carries the node id and the measured count, never a bare Bool. Words, not
// characters, because the operator priced it in reading, and a word is the unit reading is priced
// in.

data ticket_brief_word_budget: Int = 100

type BriefBudgetViolation {
  node: RoadmapNodeId
  words: Int
}

fn ticket_brief_word_count(brief: String) -> Int {
  count(split(s: brief, delimiter: " "))
}

fn ticket_brief_violations(nodes: List<RoadmapNode>) -> List<BriefBudgetViolation> {
  fold(nodes, init: [], f: (acc, rn) => match line_ticket(item: rn.line) {
    Absent => acc
    Present { value: t } => {
      let words = ticket_brief_word_count(brief: t.brief)
      if words > ticket_brief_word_budget {
        concat(acc, [BriefBudgetViolation { node: rn.node, words: words }])
      } else {
        acc
      }
    }
  })
}

// THE BUDGET GOVERNS AUTHORED TICKET PROSE, SO IT WALKS THE AUTHORED NODES RATHER THAN THE
// PROJECTION. It previously walked doc_all_nodes(roadmap_authority()), which includes the DERIVED
// closing-contract task nodes whose boundary is generated as a fixed prefix plus the target node's
// red_control. That made the budget a second, indirect and undeclared constraint on red_control
// length: accepting any node could push a DIFFERENT node over budget, because acceptance makes the
// next node startable-and-unbound and therefore derives a closing-contract row for it.
//
// That is exactly what happened when v1-interpreter-primitive-roster was accepted:
// v1-interpreter-primitive-dispatch-authority became the frontier, its derived row's brief came to
// the prefix plus a six-clause red_control, and the budget refused -- with the only available
// remedies being to trim a carefully authored acceptance bar to satisfy a PAGE constraint, or to
// leave every PR touching roadmap_authority.dag red. Neither is the budget's purpose.
//
// A derived brief is a projection of a field that is already governed where it is authored.
// Budgeting the projection prices the source field twice, through a channel nobody declared. So the
// subject is declared_roadmap_nodes(): every authored ticket, accepted or active, and nothing
// generated. The planted-fixture RED control is unaffected -- it passes an authored node directly
// to ticket_brief_violations, which still refuses at the same threshold.

fn roadmap_ticket_brief_violations() -> List<BriefBudgetViolation> {
  ticket_brief_violations(nodes: declared_roadmap_nodes())
}

fn inline_md_nodes(text: String) -> List<Fragment> {
  markdown_inlines_to_fragments(inlines: parse_inline_markdown_minimal(text: text))
}

fn disclosure_field_row(f: DisclosureField) -> Fragment {
  el_class("div", "ticket-field", concat(
    [ el_class("span", "ticket-field-label", [ txt(f.label) ]) ],
    [ el_class("span", "ticket-field-value", disclosure_field_value_nodes(f: f)) ]))
}

fn disclosure_update_row(u: DisclosureNote) -> Fragment {
  el_class("div", "ticket-update", concat(
    [ el_class("span", "ticket-update-date", [ txt(u.on) ]) ],
    [ el_class("span", "ticket-update-note", inline_md_nodes(text: u.note)) ]))
}

fn disclosure_updates_block(updates: List<DisclosureNote>) -> List<Fragment> {
  if count(updates) == 0 {
    []
  } else {
    [ el_class("div", "ticket-updates", concat(
        [ el_class("div", "ticket-updates-head", [ txt("updates") ]) ],
        map(updates, u => disclosure_update_row(u: u)))) ]
  }
}

fn disclosure_body_nodes(d: DisclosureView) -> List<Fragment> {
  match d {
    NoDisclosure => []
    TicketDisclosure { brief, fields, updates } =>
      concat(
        [ el_class("p", "ticket-brief", inline_md_nodes(text: brief)) ],
        concat(
          map(fields, f => disclosure_field_row(f: f)),
          disclosure_updates_block(updates: updates)))
    LegacyBodyDisclosure { content } =>
      markdown_inlines_to_fragments(inlines: parse_inline_markdown_minimal(text: content))
  }
}

// Supporting facts live in the disclosure, not the head row (A1 of the presentation recon,
// operator-signed 2026-08-01): the head line had grown to ~7 simultaneous inline facts — owner,
// sizing codes, carrier links, dependencies — wrapping arbitrarily under the title, which is the
// half-console-half-product voice fork the recon named. The head carries the row's PRIMARY facts
// only plus the actuator; owner/sizing/carriers are supporting facts behind the same disclosure
// that already held the body. A row with supporting facts but no body still discloses (summary
// label 'facts'), so no fact is dropped — only demoted. AT A2 this renderer reads the DECIDED view
// alone: supporting facts arrive as WorkRowView.supporting_facts rows (label/value/href), the body
// as WorkRowView.disclosure — the RoadmapNode/TicketFields reads that used to live here moved
// behind the seam.

fn supporting_fact_node(f: SupportingFact) -> Fragment {
  if f.href == "" {
    el_class("span", f.label, [ txt(f.value) ])
  } else {
    el_attrs("a", [ attr(name: "href", value: join([github_blob_base, f.href], "") ) ], [ txt(f.value) ])
  }
}

fn view_supporting_facts(view: WorkRowView) -> List<Fragment> {
  if count(view.supporting_facts) == 0 {
    []
  } else {
    [ el_class("div", "item-facts", map(view.supporting_facts, f => supporting_fact_node(f: f))) ]
  }
}

// The per-surface link projection (remodel W2, census row 7): a Pointer's path is a REPO path —
// correct in GitHub's renderer, dead on the served page by construction (no /docs route). The
// served surface projects repo paths through the GitHub blob base so every carrier link answers;
// when repo paths gain a served route (the storage-blind lane, W3 neighborhood), this base swaps
// for that route in ONE place. The prose-inline [label](docs/...) links inside legacy AuthoredLine
// blobs remain relative — a named residue that dies with the blobs themselves (W2-bulk).

data github_blob_base: String = "https://github.com/gunb-ai/gunbc/blob/main/"

// The launch button (operator 2026-07-20: manual click-to-dispatch). Rendered on every open or
// review row as the PROJECTION of gunbc.roadmap_launch_admission for cause Operator (RLM-1): an
// admitted row renders the operable button; a refused row renders the same button disabled,
// carrying data-launch = the refusal's wire label and title = its reason -- the words POST
// /dispatch would answer, because both read one decision. Done and superseded rows hide it. The
// manual out-of-order dispatch the page used to preserve for blocked and unsized rows is gone with
// the AvailableAsOverride arm: spawn_frontier.ready no longer governs one surface while the route
// governs another. The button carries data-node = the node id. Its client behavior is a MODELED
// TsProgram (gunbc.roadmap_component.dispatch_client_program), emitted as an EXTERNAL served asset
// (roadmap_dispatch_asset_path, served by belt B) and referenced by <script src> -- NOT a
// hand-concatenated JS string inlined into the HTML (the former was the dispatch-button incident's
// root class, §5, and the inline placement was a hack: an inline <script> text node escapes '>'
// under std.markup, corrupting an arrow's `=>`; external emission is escape-clean). It reads belt
// B's `status` contract with the ok-set DERIVED from belt_dispatch_ok_status_labels; the retired
// belt-A `ok`/`node` shape is gone and cannot return (the page witness holds a RED on `j.ok`).

fn superseded_badge_of(view: WorkRowView) -> List<Fragment> {
  if view.superseded_by == "" {
    []
  } else {
    [ el_class("span", "superseded-by", [ txt(concat("→ ", view.superseded_by)) ]) ]
  }
}

fn view_dispatch_actions(view: WorkRowView) -> List<WorkAction> {
  let primary = match view.action.primary_action {
    Present { value: a } => [a]
    Absent => []
  }
  concat(primary, view.action.secondary_actions) |> filter(a => match a.kind {
    DispatchAction => true
    ClearSessionAction => false
  })
}

// THE BUTTON CARRIES ITS DECIDED AXES (A2 hierarchy closeout, operator gap ruling 2026-08-02:
// 'action prominence derives from selection and priority, not mere availability'). The seam already
// decided priority and availability per action (action_axes_note); this renderer used to flatten
// both into one identical class, which is exactly how fourteen equally loud pills reached the
// desktop fold while LANDED rows kept the ready-row treatment. The class now carries the decided
// priority (action-primary / action-secondary) and data-availability carries the admission fact, so
// the stylesheet can rest every in-row control quiet and the client program can raise ONLY the
// selected row's primary action to the invite band (the action-focal class — selection is client
// state, prominence is its projection; named for the grant, not for liveness). Status classes keep
// winning in the cascade: emphasis never overrides truth. No-JS visitors see every control quiet
// but present, labeled, and operable — honest-before-JS forbids blankness, not calm.

fn dispatch_button_attributes(view: WorkRowView, a: WorkAction) -> List<Attribute> {
  let base = [
    attr(name: "class", value: concat("dispatch-btn action-", action_priority_key(p: a.priority)) ),
    attr(name: "type", value: "button" ),
    attr(name: "data-node", value: view.node_id ),
    attr(name: "data-availability", value: action_availability_key(a: a.availability) ),
    attr(name: "data-launch", value: a.label ),
    attr(name: "title", value: a.detail ),
  ]
  let with_identity = match a.launch {
    Absent => base
    Present { value: id } => concat(base, [
      attr(name: "data-launch-cause", value: launch_cause_label(c: id.cause) ),
      attr(name: "data-launch-mode", value: spawn_mode_label(m: id.mode) ),
      attr(name: "data-launch-instance", value: launch_identity_instance_text(id: id) ),
      attr(name: "data-launch-revision", value: launch_identity_revision_hex(id: id) ),
    ])
  }
  match a.availability {
    ActionAvailable => with_identity
    ActionUnavailable => concat(with_identity, [ attr(name: "disabled", value: "" ) ])
  }
}

fn dispatch_button_nodes(view: WorkRowView) -> List<Fragment> {
  map(view_dispatch_actions(view: view), a =>
    el_attrs("button", dispatch_button_attributes(view: view, a: a), [ txt("dispatch") ]))
}

// THE DURABLE ASSIGN ACTION, the Buganizer autocomplete idiom (owner ruling 2026-09-25:
// assignment works "via email ... autocompletes to recently used emails"): an email input with a
// datalist of the always-present seeds — the request's authenticated identity and the fabric
// endpoint — followed by the ledger's recently-used assignees, then the model's Assign label on
// the submit. The suggestions roster renders each principal avatar-backed (initials, or the
// workflow badge for Fabric — never-blocks: every standing renders). The form POSTs the assign
// route natively (method + action + enctype text/plain — newline-delimited fields, no
// percent-encoding for the route to undo): honest-before-JS, no client program involved. The
// hidden expected_revision field carries the chain head the page rendered under; the route refuses
// a stale write with 409 rather than chaining onto a history the writer never saw. The submit
// deliberately does NOT wear the .issue-action class — the emitted client's action bind would
// otherwise intercept the click with a bodyless fetch and race
// the native submit; the model's vocabulary still derives the data attributes (data-action,
// data-idiom, data-action-route), and the client bind stays live for any surface that renders a
// modeled .issue-action button. THE START WORK BUTTON STAYS RETIRED (the 2026-09-25 ruling): no
// execution button renders here — but assigning TO THE FABRIC ENDPOINT is the execution entry
// point now (owner: "the workflow should be figuring out for us which model to use"): the assign
// route records the Claimed event and then drives the SAME launch admission the /dispatch route
// answers (see gunbc.roadmap_serve serve_issue_assign_response_over), refusing with the launch's
// typed vocabulary when fabric cannot start.
fn issue_assign_action_nodes(view: WorkRowView, viewer: String, recents: List<EventPrincipal>, expected_revision: String, current_assignee: String = "", command_context: IssueFormContext = IssueFormContext { operation: "", csrf: "" }) -> List<Fragment> {
  issue_assign_form_nodes(node_id: view.node_id, profiles: view.profiles, viewer: viewer, recents: recents, expected_revision: expected_revision, current_assignee: current_assignee, command_context: command_context)
}

// One form producer for the issue rail and the session-loaded workspace editor.
fn issue_assign_form_nodes(node_id: String, profiles: List<PrincipalProfile>, viewer: String, recents: List<EventPrincipal>, expected_revision: String, current_assignee: String, command_context: IssueFormContext) -> List<Fragment> {
  let suggestions = filter(issue_assign_suggestions(viewer: viewer, recents: recents), p => issue_assign_selector(p: p, profiles: profiles) != "")
  [ el_attrs("form", [
      attr(name: "class", value: "issue-assign-form site-choice site-choice-rich" ),
      attr(name: "data-site-choice", value: "rich"),
      attr(name: "method", value: "post" ),
      attr(name: "enctype", value: "application/x-www-form-urlencoded" ),
      attr(name: "action", value: join(["/issue/", node_id, "/assign"], "") ),
    ], [
      el_attrs("input", [ attr(name: "name", value: "key"), attr(name: "type", value: "hidden"), attr(name: "value", value: if command_context.operation == "" { "" } else { concat(command_context.operation, "-assign") }) ], []),
      el_attrs("input", [ attr(name: "name", value: "csrf"), attr(name: "type", value: "hidden"), attr(name: "value", value: command_context.csrf) ], []),
      site_choice_input(id: concat("issue-assign-input-", node_id), name: "assignee", class_name: "issue-assign-input", label: "Assignee", placeholder: "Unassigned — choose a person or group", value: current_assignee, list_id: concat("issue-assign-options-", node_id)),
      el_attrs("input", [
        attr(name: "name", value: "expected_revision" ),
        attr(name: "type", value: "hidden" ),
        attr(name: "value", value: expected_revision ),
      ], []),
      site_choice_list(id: concat("issue-assign-options-", node_id), options: map(suggestions, p => issue_assign_suggestion_nodes(p: p, profiles: profiles)), hidden: true, empty_label: "No matching assignees"),
      el_attrs("button", [
        attr(name: "class", value: "issue-assign-submit issue-action-text" ),
        attr(name: "hidden", value: ""),
        attr(name: "type", value: "submit" ),
        attr(name: "data-action", value: issue_action_wire(kind: IssueActionAssign) ),
        attr(name: "data-idiom", value: issue_button_idiom_wire(idiom: IssueButtonText) ),
        attr(name: "data-action-route", value: "assign" ),
        attr(name: "data-action-state", value: issue_action_availability_wire(a: IssueActionEnabled) ),
        attr(name: "data-node", value: node_id ),
        attr(name: "title", value: "Assigning Fabric starts a workflow run; review before confirming" ),
      ], [ txt(issue_action_wire(kind: IssueActionAssign)) ]),
    ]) ]
}

// THE SUGGESTIONS FEED (owner ruling: email-centric display, stable PrincipalRef submission):
// fabric pinned first, the authenticated viewer (self) when the page rendered with one — or the
// operator's own UNVERIFIED-email principal when the viewer arrives as a bare email (the pre-OIDC
// tailnet identity: offered as self, marked honestly, never silently authenticated) — then the
// ledger's recently-used principals newest-first, each exactly once by label — a legacy-email
// recent and an authenticated principal never collide, and a legacy entry is never auto-matched
// to an authenticated one (the ruling's migration law).
fn issue_assign_suggestions(viewer: String, recents: List<EventPrincipal>) -> List<EventPrincipal> {
  let fabric_row = [EventPrincipalAuthenticated { ref: fabric_workflow_principal }]
  let self_row = match principal_ref_parse_label(s: viewer) {
    Present { value: ref } => [EventPrincipalAuthenticated { ref: ref }]
    Absent => if string_contains(s: viewer, pattern: "@") { [LegacyEmailPrincipal { email: viewer as NonEmptyStr, authentication_unestablished: true }] } else { [] }
  }
  fold(concat(fabric_row, concat(self_row, recents)), init: [] as List<EventPrincipal>, f: (acc, p) =>
    if any(acc, existing => event_principal_label(p: existing) == event_principal_label(p: p)) {
      acc
    } else { concat(acc, [p]) })
}

// THE SELECTOR a suggestion submits is the EMAIL, never the qualified identity (owner 2026-09-26:
// "in the dropdown, i still see principal:gunbc/..." — the ruling: email is the user-facing
// selector; the PrincipalRef resolves server-side through the directory/profile lookup). A
// principal without a known email is NOT offered — it has no user-facing selector until the
// profile registry resolves one; the qualified label never appears in the picker.
fn suggestion_selector_of(p: EventPrincipal) -> String {
  match p {
    EventPrincipalAuthenticated { ref } =>
      if principal_ref_eq(a: ref, b: fabric_workflow_principal) { fabric_display_alias as String } else { "" }
    LegacyEmailPrincipal { email, authentication_unestablished: _ } => email as String
  }
}

// ONE SUGGESTION ROW, avatar-backed per the mandate: the avatar chip (initials under the
// never-blocks law — the /avatar image endpoint is the realization, follow-up), the display name
// through the profile-bound projection (the store's name/email replace the raw label), the
// selector, and the workflow badge for the fabric endpoint so it never masquerades as human.
fn issue_assign_suggestion_nodes(p: EventPrincipal, profiles: List<PrincipalProfile>) -> Fragment {
  let display = event_principal_display_with_profile(p: p, profiles: profiles)
  el_attrs("button", [
    attr(name: "type", value: "button"),
    attr(name: "role", value: "option"),
    attr(name: "aria-selected", value: "false"),
    attr(name: "data-choice-value", value: issue_assign_selector(p: p, profiles: profiles)),
    attr(name: "data-workflow", value: if event_principal_is_fabric(p: p) { "1" } else { "0" }),
    attr(name: "class", value: "site-choice-option issue-assign-suggestion" ),
    attr(name: "data-principal", value: event_principal_label(p: p) ),
    attr(name: "data-assignee-label", value: workspace_assignee_label(holder: p, profiles: profiles)),
    attr(name: "data-kind", value: suggestion_kind_wire(p: p) ),
  ], concat(
    [ issue_avatar_chip_node(display: display, workflow: event_principal_is_fabric(p: p)) ],
    concat(
      [ el_class("span", "issue-assign-name", [ txt(display.name) ]),
        el_class("span", "issue-assign-email", [ txt(display.detail) ]) ],
      [ el_class("span", "issue-assign-kind", [ txt(if event_principal_is_fabric(p: p) { "Group · starts a workflow run" } else { "Person" }) ]) ])))
}

fn event_principal_is_fabric(p: EventPrincipal) -> Bool {
  match p {
    EventPrincipalAuthenticated { ref } => principal_ref_eq(a: ref, b: fabric_workflow_principal)
    LegacyEmailPrincipal { email: _, authentication_unestablished: _ } => false
  }
}

fn suggestion_kind_wire(p: EventPrincipal) -> String {
  if event_principal_is_fabric(p: p) { "workflow" } else { "human" }
}

// THE DISPLAY PROJECTION, what a chip or row renders: a legacy email shows its local part with
// the legacy marker (readable history, never an identity claim); an authenticated principal shows
// the fabric display alias for the workflow endpoint and its label for humans until the A9
// directory binds profiles. NEVER BLOCKS: every input yields a row.
type EventPrincipalDisplay {
  name: String
  detail: String
  initials: String
  avatar: AvatarStanding
  picture: String
}

fn event_principal_display(p: EventPrincipal) -> EventPrincipalDisplay {
  match p {
    EventPrincipalAuthenticated { ref } =>
      if principal_ref_eq(a: ref, b: fabric_workflow_principal) {
        EventPrincipalDisplay { name: "Fabric", detail: fabric_display_alias as String, initials: "F", avatar: AvatarAbsent, picture: "" }
      } else {
        EventPrincipalDisplay { name: principal_ref_label(p: ref), detail: principal_ref_label(p: ref), initials: principal_subject_initial(ref: ref), avatar: AvatarAbsent, picture: "" }
      }
    LegacyEmailPrincipal { email, authentication_unestablished: _ } =>
      EventPrincipalDisplay { name: principal_display_name_of(email: email as String), detail: join([email as String, " (legacy, unverified)"], ""), initials: avatar_initials_of(display_name: principal_display_name_of(email: email as String)), avatar: AvatarAbsent, picture: "" }
  }
}

// THE PROFILE-BOUND DISPLAY PROJECTION (owner ask 2026-09-28: the assignee surfaces show the
// person's real identity — email/name and their Google photo — instead of the raw principal label
// or a digit-derived initial). The profile store (gunbc.auth.profile_projection, bound at login
// and read once per render entry) IS the A9 directory binding event_principal_display's fallback
// deferred: a known principal renders the profile's name (email local part, then label, as the
// name preference order), the email as the detail, initials from the display name, and
// AvatarResolved when a picture was observed. THE NEVER-BLOCKS LAW HOLDS: a principal with no
// profile in the roster — or a roster read that failed upstream and arrived empty — renders
// EXACTLY the projection-less fallback, never a refusal.
fn event_principal_display_with_profile(p: EventPrincipal, profiles: List<PrincipalProfile>) -> EventPrincipalDisplay {
  match p {
    EventPrincipalAuthenticated { ref } =>
      if principal_ref_eq(a: ref, b: fabric_workflow_principal) {
        event_principal_display(p: p)
      } else {
        match principal_profile_of(ref: ref, profiles: profiles) {
          Absent => event_principal_display(p: p)
          Present { value: prof } => profile_display_projection(ref: ref, profile: prof)
        }
      }
    LegacyEmailPrincipal { email: _, authentication_unestablished: _ } => event_principal_display(p: p)
  }
}

// THE PROFILE-BOUND PROJECTION BODY: the display name decides the initials, the email rides the
// detail, the stored picture resolves the standing.
fn profile_display_projection(ref: PrincipalRef, profile: PrincipalProfile) -> EventPrincipalDisplay {
  let name = profile_display_name(ref: ref, profile: profile)
  EventPrincipalDisplay {
    name: name,
    detail: profile_display_detail(ref: ref, profile: profile),
    initials: avatar_initials_of(display_name: name),
    avatar: profile_display_avatar(profile: profile),
    picture: match profile.picture { Present { value: u } => uri_wire(uri: u) as String Absent => "" },
  }
}

// THE PROFILE LOOKUP, by principal equality — the label never enters the match. (The Present
// binder rides the short spelling p: the binder spelling 'profile' is a named resolver failure
// mode — gunbc.recurring_failure_mode.binder_renaming_changes_variant_field_lookup.)
fn principal_profile_of(ref: PrincipalRef, profiles: List<PrincipalProfile>) -> PrincipalProfile? {
  match profiles.first() {
    Absent => none
    Present { value: p } =>
      if principal_ref_eq(a: p.principal, b: ref) {
        Present { value: p }
      } else {
        principal_profile_of(ref: ref, profiles: profiles.skip(n: 1))
      }
  }
}

// THE NAME PREFERENCE ORDER: the profile's name, then the email's local part, then the principal
// label — the label is the last resort, never the first choice.
fn profile_display_name(ref: PrincipalRef, profile: PrincipalProfile) -> String {
  match profile.name {
    Present { value: n } => n
    Absent => match profile.email {
      Present { value: e } => principal_display_name_of(email: e as String)
      Absent => principal_ref_label(p: ref)
    }
  }
}

// THE DETAIL LINE: the email when the profile observed one, else the label.
fn profile_display_detail(ref: PrincipalRef, profile: PrincipalProfile) -> String {
  match profile.email {
    Present { value: e } => e as String
    Absent => principal_ref_label(p: ref)
  }
}

// THE AVATAR STANDING: a stored picture resolves the avatar (the chip's img realization rides the
// standing); no picture keeps the initials fallback.
fn profile_display_avatar(profile: PrincipalProfile) -> AvatarStanding {
  match profile.picture {
    Present { value: _ } => AvatarResolved
    Absent => AvatarAbsent
  }
}

// THE PRINCIPAL'S OWN INITIAL when no profile names it: the subject's first character — a
// deterministic placeholder, not an identity claim.
fn principal_subject_initial(ref: PrincipalRef) -> String {
  let sub = ref.subject as String
  if string_length(s: sub) == 0 { "?" } else { substring(s: sub, start: 0, end: 1) }
}

fn principal_display_name_of(email: String) -> String {
  match split(s: email, delimiter: "@").first() {
    Present { value: local } => local
    Absent => email
  }
}

// THE AVATAR CHIP: initials under every standing (never-blocks law); the workflow endpoint wears
// the badge. A resolved human avatar renders the same initials chip until the /avatar realization
// lands — the standing rides the row for the upgrade, never a block.
fn issue_avatar_chip_node(display: EventPrincipalDisplay, workflow: Bool) -> Fragment {
  el_attrs("span", [
    attr(name: "class", value: join([
      "site-avatar",
      if workflow { " site-avatar-workflow" } else { match display.avatar { AvatarResolved => "" AvatarAbsent => " site-avatar-default" AvatarUnread => " site-avatar-default" } },
    ], "") ),
    attr(name: "data-avatar", value: issue_avatar_standing_wire(a: display.avatar) ),
    attr(name: "title", value: issue_avatar_title(display: display, workflow: workflow) ),
  ], issue_avatar_face(display: display, workflow: workflow))
}

// THE CIRCLE'S FACE: absent/unread human pictures use the question-mark brand avatar;
// resolved pictures keep their existing initials realization until the photo transport lands.
// The Fabric workflow shows the gunb robot mark
// (gunbc.site.robot_mark, copied from the frontend's #stoic-robot symbol), in the chip's own color.
fn issue_avatar_face(display: EventPrincipalDisplay, workflow: Bool) -> List<Fragment> {
  if workflow { [group_avatar_svg(class_name: "site-avatar-default-mark", label: concat(display.name, " group"))] }
  else if display.picture != "" {
    [el_attrs("img", [attr(name: "src", value: display.picture), attr(name: "alt", value: display.name), attr(name: "referrerpolicy", value: "no-referrer")], [])]
  } else if substring(s: display.name, start: 0, end: 10) == "principal:" {
    [unknown_avatar_svg(class_name: "site-avatar-default-mark", label: concat(display.name, " — unknown profile"))]
  } else { [txt(display.initials)] }
}

// THE CIRCLE HOLDS ONLY THE INITIAL. It is a fixed 24px chip with overflow hidden, so prose placed
// inside it is clipped ("workfl…"); the workflow kind is carried by the chip's class (its own
// fill) and named in full in the hover title, never as text inside the circle.
fn issue_avatar_title(display: EventPrincipalDisplay, workflow: Bool) -> String {
  if workflow {
    join([display.name, " — workflow · ", display.detail], "")
  } else {
    join([display.name, " — ", display.detail], "")
  }
}

// THE RESULTS TABLE'S ASSIGNEE CHIP (owner ruling 2026-09-25, "make assignee always be the pfp (or
// a default/placeholder) of the email account"; owner ask 2026-09-28: the chip PAIRS its circular
// avatar with the person's real identity text): the holder principal's circular chip — initials
// under the avatar law (the stored Google photo resolves the standing), the workflow badge for
// Fabric — PLUS, WHEN THE PROJECTION KNOWS THE PRINCIPAL, a visible text span (class
// issue-assignee-text) carrying the EMAIL when one is known, else the display name; the full
// identity (name — detail) rides the title attribute. A principal the profile roster does not
// name renders EXACTLY the chip alone — the pre-profile behavior, never a refusal. Fabric wears
// the badge alone (its identity is the workflow endpoint, not a person).
fn issue_assignee_chip_node(holder: EventPrincipal, profiles: List<PrincipalProfile>) -> List<Fragment> {
  let display = event_principal_display_with_profile(p: holder, profiles: profiles)
  let chip = issue_avatar_chip_node(display: display, workflow: event_principal_is_fabric(p: holder))
  match issue_assignee_chip_text(holder: holder, profiles: profiles) {
    Absent => [ chip ]
    Present { value: text } => concat([ chip ], [ el_class("span", "issue-assignee-text", [ txt(text) ]) ])
  }
}

// THE CHIP'S VISIBLE TEXT, present exactly when the projection knows the principal's identity: a
// stored profile contributes its email (preferred, the owner ask) or its name; a legacy email
// principal contributes its email (the identity it carries, unverified marker riding the
// suggestion rows); a principal with no profile and Fabric name no text — the initials chip
// stands alone as before.
fn issue_assignee_chip_text(holder: EventPrincipal, profiles: List<PrincipalProfile>) -> String? {
  match holder {
    EventPrincipalAuthenticated { ref } =>
      if principal_ref_eq(a: ref, b: fabric_workflow_principal) {
        none
      } else {
        match principal_profile_of(ref: ref, profiles: profiles) {
          Absent => none
          Present { value: p } =>
            match p.email {
              Present { value: e } => Present { value: e as String }
              Absent => match p.name {
                Present { value: n } => Present { value: n }
                Absent => none
              }
            }
        }
      }
    LegacyEmailPrincipal { email, authentication_unestablished: _ } => Present { value: email as String }
  }
}

// The issue rail and the on-demand workspace editor share the durable Assign form
// (owner request 2026-10-04). Workflow selection still needs its explicit commit.
fn issue_detail_action_bar_nodes(view: WorkRowView, viewer: String, recents: List<EventPrincipal>, expected_revision: String, current_assignee: String = "", command_context: IssueFormContext = IssueFormContext { operation: "", csrf: "" }) -> List<Fragment> {
  issue_assign_action_nodes(view: view, current_assignee: current_assignee, viewer: viewer, recents: recents, expected_revision: expected_revision, command_context: command_context)
}

data workflow_controls_actions_only_note: String = "The actuator cell carries ACTIONS ONLY (A2, the falsifier correction — see roadmap_row_archetype_note). The server-rendered lamp strip, seven pending stage chips, and 'waiting' activity text that used to preload this wrapper were exactly the furniture the attention rule forbids: a row with no attempt renders NO workflow DOM at all, and a row with one gets its activity painted by the client into the under-head ActivityRegion from the DECIDED /workflow.json view — never into this cell. The wrapper stays always-present so the dispatch control keeps a stable actuator home and the head grid keeps its three derived tracks."

fn workflow_controls_nodes(view: WorkRowView) -> List<Fragment> {
  [ el_class("div", workflow_controls_class,
      dispatch_button_nodes(view: view)) ]
}

fn dispatch_client_script() -> Fragment {
  Element {
    tag: "script",
    attributes: [
      attr(name: "src", value: roadmap_dispatch_asset_path ),
      attr(name: "defer", value: "" ),
    ],
    children: [],
  }
}

// The served-page script wall (P1): every script the page carries must be MODELED, not a
// hand-authored string. The page emits its dispatch behavior as an external <script src> pointing
// at roadmap_dispatch_asset_path (whose body IS serialize_typescript_program of a modeled
// TsProgram, served by belt B). So the census walks the page tree and refuses two shapes
// fail-closed: an inline <script> with a non-empty text node (a hand JS string, the dispatch-button
// incident's class) and a <script src> pointing anywhere but a known modeled asset. Green over the
// real page; the RED controls (a resurrected inline string script; a rogue src) each locate their
// violation. Mirror of the unthemed-color / untokened-length censuses: a pure reader over the same
// Fragment tree, no new substrate.

type PageScriptViolation {
  kind: String
  detail: String
}

fn script_inline_text(children: List<Fragment>) -> String {
  fold(children, init: "", f: (acc, c) => match c {
    FragmentText { content } => concat(acc, content)
    RawNode { content } => concat(acc, content)
    Element { tag: _, attributes: _, children: _ } => acc
  })
}

fn script_src_attr(attributes: List<Attribute>) -> String {
  fold(attributes, init: "", f: (acc, a) => if a.name == "src" { a.value } else { acc })
}

fn collect_script_violations(node: Fragment, known_src: String) -> List<PageScriptViolation> {
  match node {
    FragmentText { content: _ } => []
    RawNode { content: _ } => []
    Element { tag, attributes, children } =>
      if tag == "script" {
        let inline = script_inline_text(children: children)
        let src = script_src_attr(attributes: attributes)
        concat(
          if inline == "" { [] } else { [PageScriptViolation { kind: "inline-js", detail: inline }] },
          if src == "" || src == known_src || src == site_client_path { [] } else { [PageScriptViolation { kind: "unknown-src", detail: src }] },
        )
      } else {
        fold(children, init: [], f: (acc, c) => concat(acc, collect_script_violations(node: c, known_src: known_src)))
      }
  }
}

fn page_script_census(page: Fragment) -> List<PageScriptViolation> {
  collect_script_violations(node: page, known_src: roadmap_dispatch_asset_path)
}

data a1_composition_provisional_note: String = "SCOPE STATEMENT for the A1 pass (operator feedback 2026-08-01): the flat row list, the head-line composition, and the visual style of this module are ONE PROVISIONAL RENDERER, not product ontology. What A1 fixed is which claims render and at what altitude (operational before narrative, local denominators, supporting facts demoted, routine chrome quieted); it deliberately did NOT choose the workspace's interaction model. The named misses carried forward to the presentation-seam slice (A2: WorkRowView/DailyWorkspaceView/ObservationImpactView, roadmap_page becomes serialize-only): the row's one purpose-specific supporting line (why-now / what-it-unlocks — deferred because no typed fact carries it yet, and truncating ticket prose by punctuation is exactly the heuristic class the seam exists to kill); the observation-refusal altitude split (one cause narrated once, not once per channel); availability-vs-priority on the dispatch control; family-once row grouping; routine-state collapse (open/ticket/idle lamps). Witnesses over this module assert per-claim semantics, never element order or adjacency — pinning the accidental composition would harden this renderer into the model."

// The row composition, on the declared archetype. The head line retains three derived tracks: status chip; node-mid title/meta flow; and one workflow-controls realization of ActuatorRegion carrying actions only (workflow_controls_actions_only_note). Activity — what is happening to the work — is the separate UnderHead ActivityRegion: the client creates it below this head when the decided /workflow.json view says an attempt exists, and removes it when the view says none, so the intrinsic-width third track can never again starve the title (the A2 falsifier). The li owns stable data-node identity independently of actuator presence; client observations locate the row first and only then its regions.
// The view-only row renderer (operator blocker 1, 2026-08-01; recomposed as the taskbar on
// 2026-09-21): render_task_row and its helpers receive WorkRowView ALONE — no RoadmapNode, no
// RoadmapItem, no merged list, no frontier edges, no signoff or sizing constructors. Every fact
// they paint (bar fill, title, signal, count, second line, dispatch action, supporting facts,
// disclosure body, inspection evidence) arrives already decided by gunbc.roadmap_presentation;
// what remains here is serialization: markdown-inline expansion, class assembly, element nesting.
// The tree structure (children, depth fuel) stays outside the row renderer because parent/child is
// a graph fact about the PAGE, not a presentation fact about one row.

// The SERVER realization of the activity region — the same semantic DOM the emitted client paints
// from the decided /workflow.json view (node-activity container with arm/attention data, the hero
// stage strip keyed by the wire's decided segment states, one summary line via
// activity_summary_line carrying its decided activity-line class, the throughput line, and the
// round strip + obligation ledger + evidence rows + bounded located reason behind the activity
// disclosure — which never arrives open since the 2026-09-21 hero ruling; refusal loudness lives
// on the label per the 2026-09-20 status-surface ruling). Two realizations, ONE deciding module;
// the parity witness holds their semantic regions and labels equal (operator blocker 7). A
// NoActiveWork view renders NOTHING, which is why a served page whose rows carry no observed
// attempt still ships zero workflow furniture.

fn activity_obligation_node(s: WorkflowSegment) -> Fragment {
  let state = workflow_segment_state_key(state: s.state)
  let detail = workflow_segment_detail_bounded(detail: s.detail)
  el_attrs("div", [
    attr(name: "class", value: activity_obligation_class ),
    attr(name: "data-state", value: state ),
  ], [ txt(join([
    workflow_segment_kind_label(kind: s.kind), activity_state_sep, state,
    if detail == "" { "" } else { join([activity_detail_sep, detail], "") },
  ], "")) ])
}

fn activity_evidence_row_node(row: ActivityEvidenceRow) -> Fragment {
  el_class("div", activity_evidence_row_class, [ txt(join([row.label, activity_evidence_kv_sep, row.value], "")) ])
}

// THE TASKBAR (owner-endorsed redesign 2026-09-21: "the task IS the bar"). ONE recursive
// component replaces the fragmented row (head + activity region + two disclosures + project
// count/bar + tasks disclosure): a bar of h-taskbar height whose FILL is the subdued progress
// layer (the decided stage segments for a live attempt, the project's declared closed/total
// counts, or the full fill of an accepted node — the seam's TaskBarFill, painted here) with the
// face — title, current-stage-or-blocker signal, at most one count, at most one short second
// line, the actuator — laid over it. Everything else is INSPECTION, one disclosure deep:
// stage-by-stage evidence first (the obligation ledger; for a stale attempt the earlier attempt's
// strip under its own label — it never fills the bar and never implies a live worker), then raw
// detail (round strip, throughput, evidence rows, bounded refusal payload), then the ticket body
// and supporting facts, then dependency links. Two realizations, ONE deciding module
// (gunbc.roadmap_presentation's task_bar_view_of); the parity obligation holds on the bar's
// decided slots (signal/count/subline ride the wire as bar_signal/bar_count/summary).

fn taskbar_stage_fill(obligations: List<WorkflowSegment>, live: Bool) -> List<Fragment> {
  if count(obligations) == 0 {
    []
  } else {
    [ el_class("div", "taskbar-fill", [
        el_class("div", stage_strip_class,
          map(obligations, s => stage_segment_node(s: s, pulsing: live && workflow_segment_state_key(state: s.state) == "active"))) ]) ]
  }
}

fn taskbar_fill_nodes(view: WorkRowView, bar: TaskBarView, project: ProjectTreeView?) -> List<Fragment> {
  match bar.fill {
    BarFillNone => []
    BarFillClosed =>
      [ el_class("div", "taskbar-fill", [ el_class("span", "taskbar-fill-closed", []) ]) ]
    BarFillProject =>
      match project {
        Absent => []
        Present { value: p } =>
          [ el_class("div", "taskbar-fill", [
              el_class("div", "taskbar-project-bar", [
                el_attrs("span", [
                  attr(name: "class", value: "project-progress-closed" ),
                  attr(name: "style", value: join(["flex-grow: ", to_string(p.closed_count)], "")),
                ], []),
                el_attrs("span", [
                  attr(name: "class", value: "project-progress-open" ),
                  attr(name: "style", value: join(["flex-grow: ", to_string(value: p.total_count - p.closed_count)], "")),
                ], []),
              ]),
            ]) ]
      }
    BarFillStages =>
      match view.activity {
        ActiveWork { summary: _, obligations, remaining_obligation_count: _, current_activity: _, attention: _, evidence: _ } =>
          taskbar_stage_fill(obligations: obligations, live: view.worker_alive)
        ActiveWorkRefused { summary: _, located_reason: _, evidence: _, obligations } =>
          taskbar_stage_fill(obligations: obligations, live: view.worker_alive)
        CompletedWork { outcome: _, evidence: _, obligations } =>
          taskbar_stage_fill(obligations: obligations, live: view.worker_alive)
        NoActiveWork => []
        LegacySupersedableAttempt { summary: _, located_reason: _, attempt_key: _, evidence: _ } => []
        ActivityUnobservable { reason } => [ el_class("p", "issue-observation-unavailable", [ txt(concat("Work observation unavailable: ", reason)) ]) ]
      }
  }
}

// The three slots are ALWAYS rendered (empty spans hide via :empty) so the client poll has stable
// paint targets, and the signal span carries the row's NO-ATTEMPT values (task_bar_idle_view,
// decided at serve) as data-rest-*: when the wire stops carrying an attempt the client restores
// them rather than recomputing or leaving stale text.
fn taskbar_face_nodes(view: WorkRowView, bar: TaskBarView) -> Fragment {
  let rest = task_bar_idle_view(view: view)
  el_class("div", "taskbar-face", concat(
    concat(status_chip_nodes(view: view), standing_chip_nodes(view: view)),
    concat(
      [ el_class("span", "taskbar-title", inline_md_nodes(text: view.headline)) ],
      concat(
        superseded_badge_of(view: view),
        concat(
          [ el_attrs("span", [
              attr(name: "class", value: join(["taskbar-signal ", activity_line_prefix_class, bar.signal_class], "") ),
              attr(name: "data-rest-signal", value: rest.signal ),
              attr(name: "data-rest-class", value: join([activity_line_prefix_class, rest.signal_class], "") ),
            ], [ txt(bar.signal) ]) ],
          concat(
            [ el_class("span", "taskbar-count", [ txt(bar.count) ]) ],
            concat(
              workflow_controls_nodes(view: view),
              [ el_class("span", "taskbar-sub", [ txt(bar.subline) ]) ])))))))
}

fn taskbar_attention_attr(view: WorkRowView) -> List<Attribute> {
  match view.activity {
    ActiveWork { summary: _, obligations: _, remaining_obligation_count: _, current_activity: _, attention, evidence: _ } =>
      [ attr(name: "data-attention", value: activity_attention_key(a: attention) ) ]
    ActiveWorkRefused { summary: _, located_reason: _, evidence: _, obligations: _ } => []
    LegacySupersedableAttempt { summary: _, located_reason: _, attempt_key: _, evidence: _ } => []
    CompletedWork { outcome: _, evidence: _, obligations: _ } => []
    NoActiveWork => []
    ActivityUnobservable { reason } => [ el_class("p", "issue-observation-unavailable", [ txt(concat("Work observation unavailable: ", reason)) ]) ]
  }
}

fn taskbar_nodes(view: WorkRowView, bar: TaskBarView, project: ProjectTreeView?) -> Fragment {
  el_attrs("div",
    concat(
      [ attr(name: "class", value: concat("taskbar", if bar.attention { " taskbar-error" } else { "" }) ),
        attr(name: "data-arm", value: activity_arm_key(a: view.activity) ),
      ],
      taskbar_attention_attr(view: view)),
    concat(
      taskbar_fill_nodes(view: view, bar: bar, project: project),
      [ taskbar_face_nodes(view: view, bar: bar) ]))
}

// Inspection order is the owner's: stage-by-stage evidence FIRST, raw detail beneath. A STALE
// attempt's strip and ledger carry the earlier-attempt label and never pulse — they are evidence
// for a superseded question. The ledger lines keep their bounded payloads (the 2026-09-20
// status-surface ruling) and their per-state classes.
fn inspect_attempt_nodes(view: WorkRowView, obligations: List<WorkflowSegment>, evidence: List<ActivityEvidenceRow>, located_reason: String) -> List<Fragment> {
  [
    el_class("div", "inspect-stages", concat(
      if view.attempt_stale {
        concat(
          [ el_class("div", "inspect-stale-label", [ txt("earlier attempt · superseded revision — evidence for a superseded question") ]) ],
          stage_strip_nodes(obligations: obligations, live: false))
      } else { [] },
      [ el_class("div", activity_ledger_class, map(obligations, s => activity_obligation_node(s: s))) ])),
    el_class("div", "inspect-raw", concat(
      [ activity_throughput_node(rounds: view.rounds) ],
      concat(
        round_strip_nodes(ledger: view.rounds, live: false),
        [ el_class("div", activity_evidence_class, concat(
            map(evidence, row => activity_evidence_row_node(row: row)),
            if located_reason == "" { [] } else {
              [ el_class("div", activity_located_reason_class, [ txt(located_reason) ]) ]
            })) ]))),
  ]
}

fn inspect_attempt_evidence(view: WorkRowView) -> List<Fragment> {
  match view.activity {
    NoActiveWork => []
    ActivityUnobservable { reason } => [ el_class("p", "issue-observation-unavailable", [ txt(concat("Work observation unavailable: ", reason)) ]) ]
    ActiveWork { summary: _, obligations, remaining_obligation_count: _, current_activity: _, attention: _, evidence } =>
      inspect_attempt_nodes(view: view, obligations: obligations, evidence: evidence, located_reason: "")
    ActiveWorkRefused { summary: _, located_reason, evidence, obligations } =>
      inspect_attempt_nodes(view: view, obligations: obligations, evidence: evidence, located_reason: located_reason)
    LegacySupersedableAttempt { summary: _, located_reason, attempt_key, evidence } =>
      inspect_attempt_nodes(
        view: view,
        obligations: [],
        evidence: concat(evidence, [ ActivityEvidenceRow { label: "attempt key", value: attempt_key } ]),
        located_reason: located_reason)
    CompletedWork { outcome: _, evidence, obligations } =>
      inspect_attempt_nodes(view: view, obligations: obligations, evidence: evidence, located_reason: "")
  }
}

// DEPENDENCY LINKS (the requires-vs-contains ruling, 2026-09-21): nested members are the
// decomposition the tree derives; a display child placed ELSEWHERE — a shared prerequisite owned
// by another project (fleet-closed-loop-converge's shell-gate-migration is the exemplar) or a
// family-owned closing-contract task — renders as a LINK to the one place the task renders, never
// as a counted copy or a fake member. The bar's denominator still counts them (the declared
// aggregate); the link is the pointer to the single rendering. The model carries only dependency
// edges, so decomposition IS the primary-parent derivation — the named gap is that an authored
// decomposition edge would be a first-class relation, not a presentation rule.
fn inspect_dependency_link_nodes(project: ProjectTreeView?) -> List<Fragment> {
  match project {
    Absent => []
    Present { value: p } =>
      if count(p.linked) == 0 {
        []
      } else {
        [ el_class("div", "inspect-requires", concat(
            [ el_class("span", "inspect-requires-label", [ txt("requires") ]) ],
            map(p.linked, r =>
              el_attrs("a", [
                attr(name: "class", value: "inspect-requires-link" ),
                attr(name: "href", value: concat("#node-", r.node_id) ),
              ], [ txt(r.headline) ])))) ]
      }
  }
}

fn taskbar_inspect_nodes(view: WorkRowView, project: ProjectTreeView?) -> List<Fragment> {
  let attempt = inspect_attempt_evidence(view: view)
  let facts = view_supporting_facts(view: view)
  let body = disclosure_body_nodes(d: view.disclosure)
  let links = inspect_dependency_link_nodes(project: project)
  if count(attempt) == 0 && count(facts) == 0 && count(body) == 0 && count(links) == 0 {
    []
  } else {
    [ el_class("details", "taskbar-inspect", [
        el("summary", [
          txt(inspect_disclosure_label),
        ]),
        el_class("div", "inspect-body", concat(attempt, concat(facts, concat(body, links)))),
      ]) ]
  }
}

fn render_task_row(view: WorkRowView, observation: ObservationImpactView) -> List<Fragment> {
  let bar = task_bar_view_of(view: view, observation: observation)
  concat(
    [ taskbar_nodes(view: view, bar: bar, project: none) ],
    taskbar_inspect_nodes(view: view, project: none))
}

fn stage_segment_node(s: WorkflowSegment, pulsing: Bool) -> Fragment {
  let state = workflow_segment_state_key(state: s.state)
  el_attrs("span", [
    attr(name: "class", value: join([
      stage_segment_class, " stage-", state,
      if pulsing { join([" ", stage_live_class], "") } else { "" },
    ], "")),
    attr(name: "title", value: join([
      workflow_segment_kind_label(kind: s.kind), activity_state_sep, state,
    ], "")),
  ], [])
}

fn stage_strip_nodes(obligations: List<WorkflowSegment>, live: Bool) -> List<Fragment> {
  if count(obligations) == 0 {
    []
  } else {
    [ el_class("div", stage_strip_class,
        map(obligations, s => stage_segment_node(s: s, pulsing: live && workflow_segment_state_key(state: s.state) == "active"))) ]
  }
}

fn activity_throughput_node(rounds: HarnessRoundLedger) -> Fragment {
  el_class("span", activity_throughput_class, [
    txt(throughput_cell_text(t: harness_throughput_from_ledger(ledger: rounds))),
  ])
}

// THE ROUND STRIP: one span per segment, width by flex-grow so a long round is a wide segment. The
// widths are the segments' millisecond intervals used directly as flex weights -- proportional by
// construction, with no percentage arithmetic to round. The strip is absent, not empty, when the
// ledger has fewer than two clocked rounds: a zero-width strip would read as "nothing happened".
fn round_segment_class(k: RoundSegmentKind) -> String {
  match k {
    ReadRound => activity_round_read_class
    WriteRound => activity_round_write_class
    ReasonRound => activity_round_reason_class
    UnmeasuredRound => activity_round_unmeasured_class
  }
}

fn round_segment_node(play: RoundPlayback, pulsing: Bool) -> Fragment {
  let seg = play.segment
  let base_class = join([
    round_segment_class(k: seg.kind),
    " ", activity_line_prefix_class, activity_line_class_key(c: activity_line_class_of_round(k: seg.kind)),
  ], "")
  el_attrs("span", [
    attr(name: "class", value: if pulsing { join([base_class, " ", activity_round_live_class], "") } else { base_class }),
    attr(name: "style", value: join([
      "flex-grow: ", to_string(value: if seg.duration_ms < 1 { 1 } else { seg.duration_ms }),
      "; --", round_fill_delay_var, ": ", to_string(value: play.delay_ms), "ms",
      "; --", round_fill_duration_var, ": ", to_string(value: play.duration_ms), "ms",
    ], "")),
    attr(name: "data-delay-ms", value: to_string(value: play.delay_ms)),
    attr(name: "data-duration-ms", value: to_string(value: play.duration_ms)),
    attr(name: "title", value: join([
      "round ", to_string(value: seg.step), " · ", round_segment_kind_word(k: seg.kind), " · ",
      to_string(value: seg.duration_ms / 1000), "s · ", to_string(value: seg.output_tokens), " tok",
    ], "")),
  ], [])
}

fn round_strip_nodes(ledger: HarnessRoundLedger, live: Bool) -> List<Fragment> {
  let plays = round_playback(segs: round_segments(ledger: ledger), playback_ms: round_strip_playback_ms)
  let total = list_length(items: plays)
  if total == 0 {
    []
  } else {
    let nodes = fold(plays, init: [], f: (acc, p) =>
      concat(acc, [round_segment_node(play: p, pulsing: live && list_length(items: acc) + 1 == total)]))
    let remaining = if live { round_remaining_flex(ledger: ledger, budget_steps: harness_round_budget_steps) } else { 0 }
    let tail = if remaining > 0 {
      [ el_attrs("span", [
          attr(name: "class", value: activity_round_remaining_class),
          attr(name: "style", value: join(["flex-grow: ", to_string(value: remaining)], "")),
          attr(name: "title", value: "unspent round budget, projected at the pace so far"),
        ], []) ]
    } else { [] }
    [ el_class("div", activity_round_strip_class, concat(nodes, tail)) ]
  }
}

// THE STANDING CHIP: the node's live standing from the event log, beside the lifecycle chip. Absent
// when the log has nothing for this node; the standing's own key is the class so each state reads
// through the palette's neutral roles (gunbc.roadmap_style standing_chip_rules).
fn standing_chip_nodes(view: WorkRowView) -> List<Fragment> {
  match view.standing {
    Absent => []
    Present { value: s } =>
      [ el_attrs("span", [
          attr(name: "class", value: join([standing_chip_class, " ", standing_chip_class, "-", roadmap_node_standing_key(s: s)], "")),
          attr(name: "title", value: issue_standing_text(s: s, profiles: view.profiles)),
        ], [ txt(issue_standing_text(s: s, profiles: view.profiles)) ]) ]
  }
}

fn status_chip_nodes(view: WorkRowView) -> List<Fragment> {
  if lifecycle_chip_renders(l: view.lifecycle) {
    let status = work_lifecycle_key(l: view.lifecycle)
    [ el_class("span", concat("status status-", status), [ txt(status) ]) ]
  } else {
    []
  }
}

fn node_li_attributes_for(view: WorkRowView, class_infix: String) -> List<Attribute> {
  concat(
    [
      attr(name: "class", value: concat(
        concat(concat("node", class_infix), concat(" node-", work_lifecycle_key(l: view.lifecycle))),
        if view.attempt_stale { concat(" ", node_attempt_stale_class) } else { "" })),
      attr(name: "id", value: concat("node-", view.node_id)),
      attr(name: "data-band", value: row_filter_band_key(view: view)),
      attr(name: "data-node", value: view.node_id),
      attr(name: "tabindex", value: "0"),
    ],
    if view.attempt_stale {
      [ attr(name: "data-attempt-revision", value: "stale") ]
    } else {
      []
    })
}

fn node_li_attributes(view: WorkRowView) -> List<Attribute> {
  node_li_attributes_for(view: view, class_infix: "")
}

// THE TREE ROW carries no profile roster: the roadmap tree is the static render path (no instance
// in scope) and its rows name no assignee surface — the empty roster renders every fallback
// exactly as before.
fn node_work_row_view(rn: RoadmapNode, graph: ReadinessGraph, merged: List<Int>, launch: LaunchRowContext) -> WorkRowView {
  work_row_view_in(rn: rn, graph: graph, merged: merged, activity: NoActiveWork, rounds: RoundsUnobserved { reason: "no active attempt" as NonEmptyStr }, worker_alive: false, standing: none, launch: launch, attempt_stale: false, profiles: [], assignment: none)
}

// THE TREE'S GRAPH, indexed once per rendered group: the row graph every row's readiness reads
// (gunbc.roadmap_presentation row_graph) and each node's primary children (gunbc.roadmap_model
// roadmap_primary_children_index). Asked per row of the raw lists, the children filter alone made
// the tree nodes x nodes.
type PageTree {
  rows: ReadinessGraph
  children: Map<String, List<RoadmapNode>>
}

fn page_tree(nodes: List<RoadmapNode>, edges: List<RoadmapEdge>) -> PageTree {
  PageTree { rows: row_graph(nodes: nodes, edges: edges), children: roadmap_primary_children_index(nodes: nodes, edges: edges) }
}

fn node_li(rn: RoadmapNode, tree: PageTree, merged: List<Int>, fuel: Int, launch: LaunchRowContext) -> Fragment {
  let view = node_work_row_view(rn: rn, graph: tree.rows, merged: merged, launch: launch)
  let head = render_task_row(view: view, observation: ObservationsNominal)
  let kids = roadmap_primary_children_in(index: tree.children, parent: rn.node)
  let child_block = if count(kids) == 0 {
    []
  } else {
    if fuel > 0 {
      [ nodes_ul_in(items: kids, tree: tree, merged: merged, fuel: fuel - 1, launch: launch) ]
    } else {
      [ el_class("ul", "depth-limited", [
          el_class("li", "depth-limit", [
            txt(concat(concat("(", to_string(count(kids))), " nested node(s) hidden — depth limit)")),
          ]),
        ]) ]
    }
  }
  Element {
    tag: "li",
    attributes: node_li_attributes(view: view),
    children: concat(head, child_block),
  }
}

fn nodes_ul(items: List<RoadmapNode>, nodes: List<RoadmapNode>, edges: List<RoadmapEdge>, merged: List<Int>, fuel: Int, launch: LaunchRowContext) -> Fragment {
  nodes_ul_in(items: items, tree: page_tree(nodes: nodes, edges: edges), merged: merged, fuel: fuel, launch: launch)
}

fn nodes_ul_in(items: List<RoadmapNode>, tree: PageTree, merged: List<Int>, fuel: Int, launch: LaunchRowContext) -> Fragment {
  el("ul", map(items, rn => node_li(rn: rn, tree: tree, merged: merged, fuel: fuel, launch: launch)))
}

fn group_markup(g: SectionGroup, merged: List<Int>, launch: LaunchRowContext) -> List<Fragment> {
  let tree = page_tree(nodes: g.nodes, edges: g.edges)
  let tops = g.nodes |> filter(n => count(roadmap_parent_ids_in(parents: tree.rows.parents, node: n.node)) == 0)
  let ul = nodes_ul_in(items: tops, tree: tree, merged: merged, fuel: roadmap_page_max_depth(), launch: launch)
  if g.label == "" {
    [ ul ]
  } else {
    [ el_class("h3", "group-label", [ txt(g.label) ]), ul ]
  }
}

fn element_markup(e: SectionElement, merged: List<Int>, launch: LaunchRowContext) -> List<Fragment> {
  match e {
    Prose { prose } => [ el_class("p", "prose", markdown_inlines_to_fragments(inlines: parse_inline_markdown_minimal(text: prose.content))) ]
    Group { group } => group_markup(g: group, merged: merged, launch: launch)
  }
}

// Page altitude from the attention law (composition slice 3; gunbc.roadmap_altitude carries the law, this page is its renderer — the workspace as the third renderer of 'routine collapses, anomaly expands'). A node-bearing section renders as a BAND: a details.section-fold whose summary carries the section's title and its derived counts, open exactly when the section holds non-routine work — statuses_all_routine folds the finished lanes, one working or anomalous member holds the band open, and the open attribute is DERIVED, never authored per section. A section without nodes has no altitude axis and renders flat, so prose leads never fold themselves away.
fn altitude_section(cls: String, title_nodes: List<Fragment>, statuses: List<String>, body: List<Fragment>) -> Fragment {
  if count(statuses) == 0 {
    el_class("section", cls, concat(title_nodes, body))
  } else {
    let counts = el_class("span", "section-counts", [ txt(section_counts_wire(c: section_counts(statuses: statuses))) ])
    let band = el_class("summary", "section-band", concat(title_nodes, [ counts ]))
    let fold_attrs = if statuses_all_routine(statuses: statuses) {
      [ attr(name: "class", value: "section-fold" ) ]
    } else {
      [ attr(name: "class", value: "section-fold" ), attr(name: "open", value: "" ) ]
    }
    el_class("section", cls, [
      el_attrs("details", fold_attrs, concat([ band ], body)),
    ])
  }
}

fn group_statuses(g: SectionGroup, merged: List<Int>) -> List<String> {
  map(g.nodes, rn => node_lifecycle_key(rn: rn, merged: merged))
}

fn section_statuses(s: RoadmapSection, merged: List<Int>) -> List<String> {
  fold(s.elements, init: [], f: (acc, e) => match e {
    Prose { prose: _ } => acc
    Group { group } => concat(acc, group_statuses(g: group, merged: merged))
  })
}

fn section_markup(s: RoadmapSection, merged: List<Int>, launch: LaunchRowContext) -> Fragment {
  let body = fold(s.elements, init: [], f: (acc, e) => concat(acc, element_markup(e: e, merged: merged, launch: launch)))
  altitude_section(
    cls: "roadmap-section",
    title_nodes: [ el("h2", [ txt(s.title) ]) ],
    statuses: section_statuses(s: s, merged: merged),
    body: body)
}

// The workspace is rendered from ONE DailyWorkspaceView (operator blocker 6), and since the
// 2026-09-25 Buganizer ruling that view's page realization is the flat issue TABLE alone (see
// workspace_markup): the view still derives the active/ready/not-ready/done/superseded band
// entries — they are the table's row order and the data-band vocabulary the filter chips read —
// but the banded forest that presented them retired with the tree/bands view tabs. The workspace
// observation banner narrates a channel-level refusal ONCE, and rows the impact covers render
// without their per-row unobservable line (workspace_covers_row_activity — the row's typed state is
// unchanged, only the duplicate narration is suppressed). The program strip is the
// ProgramProgressView consumer: its ready-obligation count is the causal link between the program
// claim and the queue below it.

fn workspace_row_li(view: WorkRowView, observation: ObservationImpactView) -> Fragment {
  Element {
    tag: "li",
    attributes: node_li_attributes(view: view),
    children: render_task_row(view: view, observation: observation),
  }
}

// MEMBER ROWS ARE SUMMARY-ONLY (owner defect fix 2026-09-23: fifteen stacked 'inspect'
// disclosures in/after one row on the old dashboard lanes). Inside a project disclosure or a
// family group, every member task rendered a FULL taskbar row including its own taskbar-inspect
// disclosure — the per-attempt stage ledger and evidence — so one project or family row stacked
// one 'inspect' per member. The member row now renders ONLY the latest attempt's summary (the
// decided bar); the full execution history lives exclusively on the member's Work tab. The
// member keeps its data-node identity so its detail route (arriving with its slice) links here.
fn member_row_li(view: WorkRowView, observation: ObservationImpactView) -> Fragment {
  let bar = task_bar_view_of(view: view, observation: observation)
  Element {
    tag: "li",
    attributes: concat(
      node_li_attributes(view: view),
      [ attr(name: "data-summary-only", value: "" ) ]),
    children: [ taskbar_nodes(view: view, bar: bar, project: none) ],
  }
}

fn workspace_rows_ul(rows: List<WorkRowView>, observation: ObservationImpactView) -> Fragment {
  el("ul", map(rows, v => workspace_row_li(view: v, observation: observation)))
}

fn family_group_li(family: WorkFamilyView, observation: ObservationImpactView) -> Fragment {
  el_class("li", "family-group", [
    el_class("div", "family-head", [
      el_class("span", "family-claim", [ txt(family.claim) ]),
      el_class("span", "family-count", [ txt(concat(to_string(count(family.rows)), " nodes")) ]),
    ]),
    el_class("ul", "family-rows", map(family.rows, v => member_row_li(view: v, observation: observation))),
  ])
}

// THE PROJECT ROW (operator request 2026-09-20). The row's own face is the SAME row shape every
// task renders — the decided head (chips, headline, dispatch actuator), its activity region, its
// disclosure — followed by the two project-only regions: the derived progress summary ("k of n
// tasks closed" plus a CSS-only bar whose segments are flex-weighted by the counts, the round
// strip's proportional-by-construction idiom, so no percentage arithmetic ever rounds) and the
// task disclosure. The disclosure is the page's existing details/summary idiom; its open attribute
// is the seam's DECIDED auto_open, never authored per project. A COLLAPSED chain (operator ruling
// 2026-09-21, see gunbc.roadmap_presentation) carries its swallowed intermediate projects as the
// chain line inside this disclosure, so collapse never drops a node. Rendered depth is capped at
// project_render_depth_cap levels: a project AT the cap renders its tasks behind a collapsed
// "+N deeper" disclosure (N = the tasks hidden at the next level) rather than an open one — the
// rows beyond still render inside it, so the cap bounds the default view without ever dropping a
// node. Nested task rows are emitted by the same workspace_row_li as every flat row; the row
// renderer is not forked.

fn project_render_depth_cap() -> Int { 3 }

fn project_entry_li(entry: ProjectTreeEntry, observation: ObservationImpactView) -> Fragment {
  match entry {
    ProjectLeaf { row } => member_row_li(view: row, observation: observation)
    ProjectNested { project } => project_tree_li(view: project, observation: observation)
  }
}

fn project_entries_ul(entries: List<ProjectTreeEntry>, observation: ObservationImpactView) -> Fragment {
  el("ul", map(entries, e => project_entry_li(entry: e, observation: observation)))
}

// THE CHAIN LINE (collapse, operator ruling 2026-09-21): the intermediate projects a collapsed
// row swallowed render HERE — one compact member per project (its data-node identity, the
// lifecycle chip when it discriminates, the headline), in walk order, so the reader can tell whose
// tasks the bar counts and every swallowed node still renders exactly once. The members carry no
// actuator: the ruling makes the chain one project row, and the topmost row's actuator is the
// one it keeps.
fn project_chain_member_node(r: WorkRowView) -> Fragment {
  el_attrs("span", [
    attr(name: "class", value: "project-chain-member" ),
    attr(name: "data-node", value: r.node_id),
  ], concat(
    status_chip_nodes(view: r),
    [ el_class("span", "project-chain-title", inline_md_nodes(text: r.headline)) ]))
}

fn project_chain_members_joined(chain: List<WorkRowView>) -> List<Fragment> {
  fold(chain, init: [] as List<Fragment>, f: (acc, r) =>
    concat(acc, concat(
      if count(acc) == 0 { [] } else { [ el_class("span", "project-chain-sep", [ txt("›") ]) ] },
      [ project_chain_member_node(r: r) ])))
}

fn project_chain_nodes(view: ProjectTreeView) -> List<Fragment> {
  if count(view.chain) == 0 {
    []
  } else {
    [ el_class("div", "project-chain", concat(
        [ el_class("span", "project-chain-label", [ txt("via") ]) ],
        project_chain_members_joined(chain: view.chain))) ]
  }
}

fn project_tasks_details(view: ProjectTreeView, observation: ObservationImpactView) -> List<Fragment> {
  if count(view.entries) == 0 && count(view.chain) == 0 {
    []
  } else {
    let content = concat(
      project_chain_nodes(view: view),
      if count(view.entries) == 0 { [] } else { [ project_entries_ul(entries: view.entries, observation: observation) ] })
    if view.depth >= project_render_depth_cap() && count(view.entries) > 0 {
      [ el_class("details", "project-tasks project-deeper",
          concat(
            [ el("summary", [
                txt(join(["+", to_string(count(view.entries)), " deeper"], "")),
              ]) ],
            content)) ]
    } else {
      [ el_attrs("details",
          concat(
            [ attr(name: "class", value: "project-tasks" ) ],
            if view.auto_open { [ attr(name: "open", value: "" ) ] } else { [] }),
          concat(
            [ el("summary", [
                txt(if count(view.entries) == 0 { "chain" } else { "tasks" }),
              ]) ],
            content)) ]
    }
  }
}

fn project_tree_li(view: ProjectTreeView, observation: ObservationImpactView) -> Fragment {
  let base = task_bar_view_of(view: view.row, observation: observation)
  let bar = TaskBarView {
    fill: BarFillProject,
    signal: base.signal,
    signal_class: base.signal_class,
    count: join([to_string(view.closed_count), " of ", to_string(view.total_count), " tasks closed"], ""),
    subline: base.subline,
    attention: base.attention || view.subtree_error,
  }
  Element {
    tag: "li",
    attributes: node_li_attributes_for(view: view.row, class_infix: " node-project"),
    children: concat(
      [ taskbar_nodes(view: view.row, bar: bar, project: Present { value: view }) ],
      concat(
        taskbar_inspect_nodes(view: view.row, project: Present { value: view }),
        project_tasks_details(view: view, observation: observation))),
  }
}

fn band_entry_li(entry: WorkBandEntry, observation: ObservationImpactView) -> Fragment {
  match entry {
    BandRow { row } => workspace_row_li(view: row, observation: observation)
    BandFamily { family } => family_group_li(family: family, observation: observation)
    BandProject { project } => project_tree_li(view: project, observation: observation)
  }
}

fn workspace_entries_ul(entries: List<WorkBandEntry>, observation: ObservationImpactView) -> Fragment {
  el("ul", map(entries, e => band_entry_li(entry: e, observation: observation)))
}

// THE BAND SHELLS ARE RETIRED WITH THE VIEWS (owner ruling 2026-09-25): the frontier-bucket band
// renderers had no caller left once the served page dropped the forest; the entry renderer
// (workspace_entries_ul and its chain) stays for the /sandbox exhibit.

fn issue_owner_value(view: WorkRowView) -> String {
  fold(view.supporting_facts, init: "", f: (acc, f) =>
    if f.label == "owner" { f.value } else { acc })
}

// THE COMPONENT FIELD reads the modeled component placement when the row carries one (the
// presentation seam derives it from the srvN component tree), and falls back to the owner lane
// otherwise — a real placement when one exists, never an empty field.
fn issue_component_value(view: WorkRowView) -> String {
  let component = fold(view.supporting_facts, init: "", f: (acc, f) =>
    if f.label == "component" { f.value } else { acc })
  if component == "" { issue_owner_value(view: view) } else { component }
}

// THE PARENT FIELD renders DECOMPOSITION separately from dependency (owner ruling 2026-09-24):
// the panel's parent is the tree derivation's display link; top-level reads honestly as such.
// The named modeling gap — decomposition rides the primary-parent rule over dependency edges
// until decomposition edges land — is stated on the panel type, not papered over here.
fn issue_parent_value(panel: IssueLinkPanel) -> List<Fragment> {
  match panel.parent {
    Present { value: p } => issue_link_value(links: [ p ])
    Absent => [ txt("top-level") ]
  }
}

// Assignment is the committed command projection. Attempt existence and progress actors do not
// grant ownership; table and detail read the same holder from the same causal state.
fn issue_assignee_holder(view: WorkRowView, attempts: List<WorkflowAttemptProgress>) -> EventPrincipal? {
  match view.assignment { Present { value: assignment } => assignment.holder Absent => none }
}

// THE FIELD-ROW TEXT for the assignee row (the rail's plain-text spelling): the holder's display
// name through the profile-bound projection (real name when the store knows one), empty when no
// holder exists — never a bare label.
fn issue_assignee_value(view: WorkRowView, attempts: List<WorkflowAttemptProgress>) -> String {
  match issue_assignee_holder(view: view, attempts: attempts) {
    Absent => ""
    Present { value: holder } => event_principal_display_with_profile(p: holder, profiles: view.profiles).name
  }
}

fn issue_search_value(view: WorkRowView) -> String {
  join([view.headline, " ", view.node_id, " ", issue_owner_value(view: view)], "")
}

fn issue_band_chip(label: String, band: String) -> Fragment {
  el_attrs("button", [
    attr(name: "class", value: "site-choice-option chip-filter" ),
    attr(name: "data-choice-value", value: band),
    attr(name: "role", value: "option"),
    attr(name: "aria-selected", value: if band == "all" { "true" } else { "false" }),
    attr(name: "type", value: "button" ),
    attr(name: "data-band-chip", value: band ),
  ], [ txt(label) ])
}

fn issue_controls_markup() -> Fragment {
  el_class("div", "issue-controls", concat(
    [ el_attrs("input", [
        attr(name: "type", value: "search" ),
        attr(name: "maxlength", value: "500"),
        attr(name: "class", value: "issue-search" ),
        attr(name: "placeholder", value: "Filter issues · title, ID or assignee" ),
        attr(name: "aria-label", value: "filter issues" ),
      ], []) ],
    [
      site_compact_choice(id: "issue-status-options", label: "All issues", accessible_label: "Issue status filter", options: [
        issue_band_chip(label: "All issues", band: "all"),
        issue_band_chip(label: "Active", band: "active"),
        issue_band_chip(label: "Ready", band: "ready"),
        issue_band_chip(label: "Not ready", band: "not-ready"),
        issue_band_chip(label: "Done", band: "done"),
        issue_band_chip(label: "Superseded", band: "superseded"),
      ]),
      el_attrs("div", [attr(name: "class", value: "issue-sort-settings"), attr(name: "data-view-default", value: serialize_json(v: issue_view_preferences_json(prefs: default_issue_view_preferences()))), attr(name: "role", value: "group"), attr(name: "aria-label", value: "Multi-column sort")], [
        el_class("span", "issue-sort-caption", [txt("Sort by")]),
        el_attrs("span", [attr(name: "class", value: "issue-sort-terms"), attr(name: "data-sort-terms", value: "")], []),
        site_compact_choice(id: "issue-add-sort", label: "Add column", accessible_label: "Add sort column", options: map(workspace_issue_columns(), col => el_attrs("button", [
          attr(name: "type", value: "button"), attr(name: "class", value: "site-choice-option"), attr(name: "role", value: "option"), attr(name: "aria-selected", value: "false"),
          attr(name: "data-choice-value", value: issue_results_sort_key_wire(key: col.sort_key)), attr(name: "data-add-sort", value: issue_results_sort_key_wire(key: col.sort_key)),
        ], [txt(if col.kind == IssueColumnPriority { "Priority" } else { workspace_column_label(col: col) })]))),
        el_attrs("button", [attr(name: "type", value: "button"), attr(name: "class", value: "site-button-compact"), attr(name: "data-view-reset", value: "")], [txt("Reset view")]),
        el_attrs("button", [attr(name: "type", value: "button"), attr(name: "class", value: "site-button-compact"), attr(name: "data-view-retry", value: ""), attr(name: "hidden", value: "")], [txt("Save this view")]),
        el_attrs("span", [attr(name: "class", value: "issue-view-save-status"), attr(name: "data-view-save-status", value: ""), attr(name: "role", value: "status"), attr(name: "aria-live", value: "polite")], [txt("Loading preferences…")]),
      ]),
      el_attrs("button", [
        attr(name: "type", value: "button"),
        attr(name: "class", value: "site-button-compact issue-sort-undo"),
        attr(name: "hidden", value: "hidden"),
        attr(name: "disabled", value: "disabled"),
      ], [ txt("Undo sort") ]),
      el_attrs("span", [
        attr(name: "class", value: "issue-sort-status"),
        attr(name: "role", value: "status"),
        attr(name: "aria-live", value: "polite"),
      ], []),
    ]))
}

// One cell per modeled column for every issue, regardless of recursive position or
// descriptive type. TITLE links to detail; ASSIGNEE is the inline assignment control;
// STATUS reads the decided signal. Unknown priority/modified facts remain empty.
// The shared grid is declared once on the table; wrappers use display: contents.
// THE TABLE ROW SHOWS ONLY THE LATEST ATTEMPT'S SUMMARY, AND ONLY WHEN IT IS RECENT OR LIVE
// (owner defect fix 2026-09-23): a stale attempt — launched against a revision that is no longer
// the deployed head — is evidence for a superseded question, and its summary does not belong on
// the dense table line; the row falls back to its scheduling voice (ready / blocked on / done),
// and the attempt's full record stays reachable on the row's Work tab. The taskbar grammar in the
// forest keeps the stale dim law — that is the bar's own voice, not the table's.
fn issue_line_cell_class(kind: IssueResultsColumnKind) -> String {
  join(["issue-cell issue-cell-", issue_results_column_kind_wire(kind: kind)], "")
}

// Names are preferred for people; groups and legacy identities retain their full email.
fn workspace_assignee_label(holder: EventPrincipal, profiles: List<PrincipalProfile>) -> String {
  match holder {
    LegacyEmailPrincipal { email, authentication_unestablished: _ } => email as String
    EventPrincipalAuthenticated { ref: _ } =>
      if event_principal_is_fabric(p: holder) { fabric_display_alias as String }
      else { event_principal_display_with_profile(p: holder, profiles: profiles).name }
  }
}

fn issue_line_cell_content(col: IssueResultsColumn, view: WorkRowView, bar: TaskBarView, priority: DerivedPriority) -> List<Fragment> {
  match col.kind {
    IssueColumnPriority => [el_attrs("span", [
      attr(name: "class", value: "issue-priority"),
      attr(name: "data-priority", value: to_string(roadmap_priority_rank(priority: priority.priority))),
      attr(name: "title", value: issue_priority_explanation(value: priority)),
      attr(name: "aria-label", value: issue_priority_explanation(value: priority))
    ], [txt(roadmap_priority_label(priority: priority.priority))])]
    IssueColumnTitle =>
      [ el_attrs("a", [
          attr(name: "class", value: "issue-title-link" ),
          attr(name: "href", value: join(["/issue/", view.node_id], "") ),
        ], inline_md_nodes(text: view.headline)) ]
    IssueColumnAssignee =>
      [ el_attrs("button", [
          attr(name: "type", value: "button"),
          attr(name: "class", value: "issue-inline-assign"),
          attr(name: "disabled", value: "disabled"),
          attr(name: "title", value: "Open assignee picker; checking session."),
          attr(name: "aria-label", value: join(["Assign ", view.headline], "")),
          attr(name: "data-assign-node", value: view.node_id),
        ], match issue_assignee_holder(view: view, attempts: []) {
          Absent => [unassigned_avatar(), el_class("span", "issue-assignee-text", [txt("Unassigned")])]
          Present { value: holder } => [
            issue_avatar_chip_node(display: event_principal_display_with_profile(p: holder, profiles: view.profiles), workflow: event_principal_is_fabric(p: holder)),
            el_attrs("span", [attr(name: "class", value: "issue-assignee-text"), attr(name: "title", value: event_principal_display_with_profile(p: holder, profiles: view.profiles).detail)], [txt(workspace_assignee_label(holder: holder, profiles: view.profiles))])
          ]
        }) ]
    IssueColumnStatus => [el_attrs("span", [attr(name: "class", value: "issue-status site-status"), attr(name: "data-status-tone", value: status_tone(label: issue_status_label(view: view))), attr(name: "title", value: bar.signal)], [txt(issue_status_label(view: view))])]
    IssueColumnLastModified => []
  }
}

// Sort the underlying identity and status text, never avatar initials or DOM decorations.
// Priority is derived from classified project ancestry; modified remains absent without a fact.
fn issue_line_sort_value(col: IssueResultsColumn, view: WorkRowView, bar: TaskBarView, priority: DerivedPriority) -> String {
  match col.kind {
    IssueColumnPriority => to_string(roadmap_priority_rank(priority: priority.priority))
    IssueColumnTitle => view.headline
    IssueColumnAssignee => match issue_assignee_holder(view: view, attempts: []) {
      Absent => ""
      Present { value: holder } => event_principal_display_with_profile(p: holder, profiles: view.profiles).name
    }
    IssueColumnStatus => to_string(issue_status_sort_rank(view: view))
    IssueColumnLastModified => ""
  }
}

// THE TABLE'S PER-ROW FACTS READ INDEXES BUILT ONCE PER TABLE: each row's project root and its
// dependency list were a walk over the whole membership relation and a filter over every edge,
// per row (measured 2026-10-01: the daily page's issue table dominated its cost).
fn issue_dependency_index(edges: List<RoadmapEdge>) -> Map<String, List<String>> {
  let empty: Map<String, List<String>> = empty_map()
  fold(edges, init: empty, f: fn(acc, e) {
    match issue_dependencies_of(index: acc, node_id: e.child as String) {
      Absent => map_insert(m: acc, key: e.child as String, value: [e.parent as String])
      Present { value: ps } => map_insert(m: acc, key: e.child as String, value: concat(ps, [e.parent as String]))
    }
  })
}

fn issue_dependencies_of(index: Map<String, List<String>>, node_id: String) -> List<String>? {
  map_lookup(m: index, key: node_id)
}

fn issue_line_li(row: IssueTableRow, observation: ObservationImpactView, memberships: RoadmapMembershipIndex, dependencies: Map<String, List<String>>) -> Fragment {
  let view = row.view
  let priority = issue_priority_of(node_id: view.node_id, index: memberships)
  let bar = if view.attempt_stale { task_bar_idle_view(view: view) } else { task_bar_view_of(view: view, observation: observation) }
  Element {
    tag: "li",
    attributes: concat(
      node_li_attributes_for(view: view, class_infix: "") |> filter(a => !(a.name == "id")),
      [ attr(name: "role", value: "row"),
        attr(name: "data-project", value: match project_root_for_node_in(node_id: view.node_id, index: memberships) { Present { value: project } => project Absent => "" }),
        attr(name: "data-complete", value: if work_lifecycle_key(l: view.lifecycle) == "done" { "true" } else { "false" }),
        attr(name: "data-dependencies", value: join(match issue_dependencies_of(index: dependencies, node_id: view.node_id) { Present { value: ps } => ps Absent => [] }, " ") ),
        attr(name: "data-search", value: issue_search_value(view: view) ),
        attr(name: "data-summary-only", value: "" ) ]),
    children: [ el_attrs("div", [attr(name: "class", value: "issue-line"), attr(name: "role", value: "presentation")],
      map(workspace_issue_columns(), c => el_attrs("span", [
        attr(name: "class", value: issue_line_cell_class(kind: c.kind) ),
        attr(name: "data-col", value: issue_results_column_kind_wire(kind: c.kind) ),
        attr(name: "data-sort-value", value: issue_line_sort_value(col: c, view: view, bar: bar, priority: priority) ),
        attr(name: "role", value: "cell"),
      ], issue_line_cell_content(col: c, view: view, bar: bar, priority: priority)))) ],
  }
}

// THE TABLE HEADER derives from the SAME roster as the rows: one header cell per declared column
// in roster order. The header div is a display:
// contents wrapper like the row divs, so these cells land in the table's one grid beside the
// rows' cells — same tracks, by construction.
fn workspace_column_label(col: IssueResultsColumn) -> String {
  match col.kind {
    IssueColumnPriority => "P"
    IssueColumnTitle => "Title"
    IssueColumnAssignee => "Assignee"
    IssueColumnStatus => "Status"
    IssueColumnLastModified => "Last modified"
  }
}

fn issue_table_header_nodes() -> Fragment {
  el_attrs("div", [attr(name: "class", value: "issue-table-header"), attr(name: "role", value: "row")],
    map(workspace_issue_columns(), c =>
      el_attrs("span", [
        attr(name: "class", value: join(["issue-col issue-col-", issue_results_column_kind_wire(kind: c.kind)], "") ),
        attr(name: "data-col", value: issue_results_column_kind_wire(kind: c.kind) ),
        attr(name: "role", value: "columnheader" ),
        attr(name: "aria-sort", value: if c.kind == IssueColumnStatus { "other" } else { "none" } ),
      ], [ el_attrs("button", [
        attr(name: "type", value: "button" ),
        attr(name: "class", value: "issue-sort" ),
        attr(name: "data-sort-key", value: issue_results_sort_key_wire(key: c.sort_key) ),
        attr(name: "data-sort-numeric", value: if c.kind == IssueColumnStatus || issue_results_sort_numeric(key: c.sort_key) { "true" } else { "false" } ),
        attr(name: "aria-label", value: join(["Sort by ", workspace_column_label(col: c)], "") ),
      ], [ txt(workspace_column_label(col: c)) ]) ])))
}

fn issue_table_markup(rows: List<IssueTableRow>, observation: ObservationImpactView, edges: List<RoadmapEdge>, memberships: List<RoadmapMembership> = roadmap_memberships()) -> Fragment {
  let membership_index_of_table = membership_index(memberships: memberships)
  let dependency_index_of_table = issue_dependency_index(edges: edges)
  el_attrs("div", [attr(name: "class", value: "issue-table"), attr(name: "role", value: "table"), attr(name: "aria-label", value: "Issue search results")], [
    issue_table_header_nodes(),
    el_class("div", "issue-empty", [ txt("No issues match your search.") ]),
    el_attrs("ul", [attr(name: "role", value: "rowgroup")], map(sort_by(rows, r => workspace_priority_order_key(priority: issue_priority_of(node_id: r.view.node_id, index: membership_index_of_table).priority, status_rank: issue_status_sort_rank(view: r.view))), r => issue_line_li(row: r, observation: observation, memberships: membership_index_of_table, dependencies: dependency_index_of_table))),
  ])
}

// THE ISSUE DETAIL PAGE (owner ruling 2026-09-22: each issue has a detail page and a separate
// Work tab; the visual contract's detail anatomy — header id + title, a field panel, tabs —
// docs/plans/buganizer-visual-contract.md). ONE page function over the decided row view and link
// panel: serialize-only, the same contract render_task_row keeps. The Status field renders the
// four-fact present-tense explanation decided by gunbc.roadmap_presentation (the four facts stay
// separate on the row; the sentence is derived, never stored); the head line reads the decided
// bar view beside it. The Work tab also receives the node's attempt history (the caller's order,
// newest first) and lists every attempt — execution history lives here exclusively, never stacked
// in the workspace rows (owner defect fix 2026-09-23). The page ships the same external client
// asset the workspace ships; its tab chips are inert on surfaces that carry none.
fn issue_field_row(label: String, value: List<Fragment>) -> Fragment {
  el_class("div", "issue-field", concat(
    [ el_class("span", "issue-field-label", [ txt(label) ]) ],
    [ el_class("span", "issue-field-value", value) ]))
}

fn issue_field_text_row(label: String, value: String) -> Fragment {
  issue_field_row(label: label, value: if value == "" { [] } else { [ txt(value) ] })
}

fn issue_link_value(links: List<IssueLinkView>) -> List<Fragment> {
  map(links, l =>
    el_attrs("a", [
      attr(name: "class", value: "issue-link" ),
      attr(name: "href", value: join(["/issue/", l.node_id], "") ),
    ], [ txt(l.headline) ]))
}

// The Work tab's history rows ride the landed taskbar grammar: one bar per clocked round, the
// round kind carrying its decided activity-line class, newest (highest step) first per the
// presentation seam's issue_work_history_rounds. Beneath the rows the tab carries the decided
// stage ledger and evidence rows — the same inspection facts the bar's disclosure owns, at tab
// altitude.
fn issue_work_history_row_node(seg: RoundSegment) -> Fragment {
  el_attrs("div", [
    attr(name: "class", value: join([
      "taskbar work-history-row ", activity_line_prefix_class, activity_line_class_key(c: activity_line_class_of_round(k: seg.kind)),
    ], "") ),
    attr(name: "data-step", value: to_string(value: seg.step) ),
  ], [
    el_class("div", "taskbar-face", concat(
      [ el_class("span", "work-history-step", [ txt(join(["round ", to_string(value: seg.step)], "")) ]) ],
      concat(
        [ el_class("span", "taskbar-title", [ txt(round_segment_kind_word(k: seg.kind)) ]) ],
        [ el_class("span", "taskbar-count", [ txt(join([
            to_string(value: seg.duration_ms / 1000), "s · ", to_string(value: seg.output_tokens), " tok",
          ], "")) ]) ])))
  ])
}

// THE ATTEMPT HISTORY (owner defect fix 2026-09-23: the full execution history lives exclusively
// on the Work tab). One compact row per attempt, the caller's order (newest first), each carrying
// the attempt's short key and its decided outcome sentence — the latest attempt's summary is the
// table row's whole claim about execution; the tab is where a node's N attempts are enumerated.
fn issue_attempt_history_row_node(progress: WorkflowAttemptProgress) -> Fragment {
  el_attrs("div", [
    attr(name: "class", value: "taskbar work-attempt-row" ),
    attr(name: "data-attempt", value: attempt_key_short_form(key: progress.attempt_key) ),
  ], [
    el_class("div", "taskbar-face", concat(
      [ el_class("span", "work-history-step", [ txt(attempt_key_short_form(key: progress.attempt_key)) ]) ],
      [ el_class("span", "taskbar-title", [ txt(activity_summary_line(a: activity_view_from_progress(progress: progress))) ]) ]))
  ])
}

// THE EVENT HISTORY (owner ruling 2026-09-24: the Work tab carries the issue's execution
// history): one row per event-log envelope, NEWEST FIRST by recorded_at, each naming the author,
// the event kind, and its payload — the durable facts a session stated on the issue (assignment
// among them: a Claimed event IS the assignment record). Events whose recorded_at is empty (an
// unprobed clock at write) sort oldest, honestly — absence is not a timestamp.
fn issue_event_row_node(env: RoadmapEventEnvelope, profiles: List<PrincipalProfile> = []) -> Fragment {
  let e = env.event
  el_attrs("div", [
    attr(name: "class", value: "issue-event-row" ),
    attr(name: "data-event-kind", value: roadmap_event_kind_word(k: e.kind) ),
  ], [
    el_attrs("span", [attr(name: "class", value: "issue-event-author"), attr(name: "title", value: event_principal_label(p: e.author))], [txt(event_principal_display_with_profile(p: e.author, profiles: profiles).name)]),
    el_class("span", "issue-event-text", [ txt(issue_event_text(env: env)) ]),
    el_class("span", "issue-event-at", [ txt(e.recorded_at) ]),
  ])
}

// THE EVENT ROW'S PAYLOAD WORDS (the raw ledger's voice; the Comments stream has its own richer
// rendering in the page-rebuild slice). A Claimed row names its assignee: a self-claim reads as
// claiming, a reassignment (assignee ≠ author) reads as assigned-to, so the history tells the two
// apart without hiding who recorded the event — the author column already names them.
fn issue_event_payload(env: RoadmapEventEnvelope) -> String {
  match env.event.kind {
    Claimed { assignee, return_to: _ } =>
      if event_principal_label(p: assignee) == event_principal_label(p: env.event.author) {
        "claimed the issue"
      } else {
        join(["assigned the issue to ", event_principal_label(p: assignee)], "")
      }
    Released => "released the issue"
    Progress { note } => join(["progress: ", note as String], "")
    Blocked { reason } => join(["blocked: ", reason as String], "")
    HandedBack { reason } => join(["handed back: ", reason as String], "")
    ReceiptReferenced { obligation, address, verdict } =>
      join(["receipt ", obligation as String, " at ", address as String, ": ", verdict as String], "")
    CommentCreated { comment: _, body: _, visibility: _, parent_comment: _ } => "comment created"
    CommentEdited { comment: _, body: _ } => "comment edited"
    CommentDeleted { comment: _ } => "comment deleted"
    ResultReturned { attempt, claim, outcome } =>
      join(["result of attempt ", attempt as String, " for claim ", claim as String, ": ", attempt_result_outcome_text(o: outcome)], "")
  }
}

fn issue_event_text(env: RoadmapEventEnvelope) -> String {
  issue_event_payload(env: env)
}

// The audit and last-modified projection share causal order, independent of clock skew.
fn issue_events_newest_first(envs: List<RoadmapEventEnvelope>) -> List<RoadmapEventEnvelope> {
  roadmap_issue_history_newest_first(envs: envs)
}



// CODE-ISH CONTENT GETS MONO BLOCKS, never prose paragraphs (owner mandate 2026-09-25): a field
// value that spans lines or names code (a fn signature, a module path) renders in a pre block on
// the tokened grain; single-line prose keeps the inline-markdown voice.
fn field_value_is_codeish(value: String) -> Bool {
  string_contains(s: value, pattern: "\n") || string_contains(s: value, pattern: "fn ") || string_contains(s: value, pattern: "::")
}

fn disclosure_field_value_nodes(f: DisclosureField) -> List<Fragment> {
  if field_value_is_codeish(value: f.value) {
    [ el_class("pre", "ticket-field-code", [ txt(f.value) ]) ]
  } else {
    inline_md_nodes(text: f.value)
  }
}

fn issue_authored_details(summary: String, open: Bool, rows: List<Fragment>) -> Fragment {
  el_attrs("details", concat(
    [ attr(name: "class", value: "issue-authored-details" ) ],
    if open { [ attr(name: "open", value: "" ) ] } else { [] }),
    concat([ el("summary", [ txt(summary) ]) ], rows))
}

fn issue_authored_section(heading: String, rows: List<Fragment>) -> Fragment {
  el_class("div", "issue-authored-section", concat(
    [ el_class("h3", "issue-authored-heading", [ txt(heading) ]) ],
    rows))
}

// Typed field identities survive presentation. Display labels may change without moving a
// field into a different semantic section.
fn ticket_fields_selected(fields: List<DisclosureField>, identities: List<TicketFieldIdentity>) -> List<DisclosureField> {
  fold(identities, init: [], f: (acc, identity) => concat(acc, filter(fields, f => f.identity == identity)))
}

// THE AUTHORED FIELDS, FOLDED PER THE MANDATE (owner 2026-09-25,
// docs/plans/issue-page-architecture.md): Description (the brief) always renders; Acceptance
// criteria carries the red control and the hand-back; Current plan carries current state, first
// slice and displaced cost inside a details/summary disclosure — OPEN while the work is not done,
// collapsed once it is; Scope carries out-of-scope inside a collapsed disclosure. Long content is
// collapsed by default; the verified row never forms when no verification was recorded (fixed at
// the source, roadmap_presentation.ticket_disclosure_fields). The flat rendering survives for the
// daily table's row disclosure, where the fold is not the mandate's subject.
fn disclosure_folded_nodes(d: DisclosureView, done: Bool) -> List<Fragment> {
  match d {
    NoDisclosure => []
    LegacyBodyDisclosure { content } =>
      markdown_inlines_to_fragments(inlines: parse_inline_markdown_minimal(text: content))
    TicketDisclosure { brief, fields, updates } =>
      let acceptance_fields = ticket_fields_selected(fields: fields, identities: [TicketRedControl, TicketHandback])
      let acceptance = if count(acceptance_fields) == 0 { [] } else {
        [ issue_authored_section(heading: "Acceptance criteria", rows: map(acceptance_fields, f => disclosure_field_row(f: f))) ]
      }
      let plan_fields = ticket_fields_selected(fields: fields, identities: [TicketCurrentState, TicketFirstSlice, TicketDisplacedCost])
      let plan = if count(plan_fields) == 0 { [] } else {
        [ issue_authored_details(summary: "Current plan", open: !done, rows: map(plan_fields, f => disclosure_field_row(f: f))) ]
      }
      let scope_fields = ticket_fields_selected(fields: fields, identities: [TicketOutOfScope])
      let scope = if count(scope_fields) == 0 { [] } else {
        [ issue_authored_details(summary: "Scope", open: false, rows: map(scope_fields, f => disclosure_field_row(f: f))) ]
      }
      [ el_class("div", "issue-authored", concat(
          [],
          concat(acceptance, concat(plan, concat(scope, disclosure_updates_block(updates: updates)))))) ]
  }
}

// The authored brief is the description; the headline remains the issue title.
fn issue_description_node(view: WorkRowView) -> Fragment {
  el_class("div", "issue-description", [
    el_class("h2", "issue-description-heading", [ txt("Description") ]),
    el_class("div", "issue-description-body", inline_md_nodes(text: match view.disclosure { TicketDisclosure { brief, fields: _, updates: _ } => brief LegacyBodyDisclosure { content } => content NoDisclosure => view.headline })),
  ])
}

// THE COMMENT STREAM (A5 surface): one row per folded comment in chronological (causal) order —
// avatar-backed (the author principal through the display projection, initials under the
// never-blocks law, the workflow badge for fabric), the stable deep link /issue/<id>#comment-N on
// the ordinal anchor AND the row id (the location bar lands on the comment), the created and
// edited timestamps, the markdown body, and the reply marker naming the comment answered. A
// DELETED comment renders its tombstone with the ordinal RETAINED — the deep link stays addressed.
fn issue_comment_row_node(node_id: String, comments: List<IssueComment>, c: IssueComment, profiles: List<PrincipalProfile>) -> Fragment {
  let display = event_principal_display_with_profile(p: c.author, profiles: profiles)
  el_attrs("div", [
    attr(name: "class", value: join(["issue-comment", if c.deleted { " issue-comment-deleted" } else { "" }], "") ),
    attr(name: "id", value: issue_comment_anchor(ordinal: c.ordinal) ),
  ], [
    issue_avatar_chip_node(display: display, workflow: event_principal_is_fabric(p: c.author)),
    el_class("div", "issue-comment-main", concat(
      [ issue_comment_head_node(node_id: node_id, comments: comments, c: c, display: display) ],
      [ el_class("div", "issue-comment-body",
          if c.deleted { [ txt("comment deleted") ] } else { map(inline_md_nodes(text: c.body), f => issue_mention_fragment(f: f, profiles: profiles)) }) ])),
  ])
}

fn issue_comment_head_node(node_id: String, comments: List<IssueComment>, c: IssueComment, display: EventPrincipalDisplay) -> Fragment {
  el_class("div", "issue-comment-head", concat(
    [ el_class("span", "issue-comment-author", [ txt(display.name) ]) ],
    concat(
      [ el_attrs("a", [
          attr(name: "class", value: "issue-comment-ref" ),
          attr(name: "href", value: join(["/issue/", node_id, "#", issue_comment_anchor(ordinal: c.ordinal)], "") ),
        ], [ txt(join(["#comment-", to_string(value: c.ordinal)], "")) ]) ],
      concat(
        [ el_class("span", "issue-comment-at", [ txt(comment_time_text(c: c)) ]) ],
        concat(
          [ el_class("span", "issue-comment-detail", [ txt(display.detail) ]) ],
          [ el_class("span", "issue-comment-reply", [ txt(issue_comment_reply_text(comments: comments, c: c)) ]) ])))))
}

// THE REPLY MARKER: a reply names the comment it answers by the parent's ordinal — looked up in
// the folded stream, so the marker reads "reply to #comment-2", never a raw id. A root comment
// renders an empty marker (the :empty rule hides it).
fn issue_comment_reply_text(comments: List<IssueComment>, c: IssueComment) -> String {
  match c.parent_comment {
    Absent => ""
    Present { value: parent_id } =>
      match (filter(comments, pc => (pc.comment as String) == (parent_id as String))).first() {
        Present { value: parent } => join(["reply to #comment-", to_string(value: parent.ordinal)], "")
        Absent => join(["reply to ", parent_id as String], "")
      }
  }
}

// THE TIMESTAMP LINE: created, plus the edited marker when an edit event stamped it — both empty
// for an unprobed clock, honestly (absence is not a timestamp).
fn comment_time_text(c: IssueComment) -> String {
  join([
    c.created_at,
    if c.edited_at == "" { "" } else { join([" · edited ", c.edited_at], "") },
  ], "")
}

// ONE STREAM ENTRY, the chronological merge the mandate's Comments tab renders: a durable
// comment, or the compact automated entry a returned attempt result appends (published and
// reassigned for merge, verification failed, or handed back) — the answer the requester
// is owed interleaves with the narrative, never raw belt noise.
type IssueStreamEntry
  = StreamComment { comment: IssueComment }
  | StreamPublication { env: RoadmapEventEnvelope }

fn issue_stream_entries(envs: List<RoadmapEventEnvelope>) -> List<IssueStreamEntry> {
  let comments = map(roadmap_issue_comments(envs: envs), c => StreamComment { comment: c })
  let publications = map(filter(envs, e => match e.event.kind { ResultReturned { attempt: _, claim: _, outcome: _ } => true  Claimed { assignee: _, return_to: _ } => false  Released => false  Progress { note: _ } => false  Blocked { reason: _ } => false  HandedBack { reason: _ } => false  ReceiptReferenced { obligation: _, address: _, verdict: _ } => false  CommentCreated { comment: _, body: _, visibility: _, parent_comment: _ } => false  CommentEdited { comment: _, body: _ } => false  CommentDeleted { comment: _ } => false }), e => StreamPublication { env: e })
  issue_entries_sort_ascending(concat(comments, publications))
}

fn issue_entry_time(entry: IssueStreamEntry) -> String {
  match entry {
    StreamComment { comment } => comment.created_at
    StreamPublication { env } => env.event.recorded_at
  }
}

// Insertion sort by recorded_at ASCENDING (the chronological stream; the comments' causal order
// is the tie-break for equal timestamps because the fold's creation order rides in already-sorted
// for comments and publications sort stably behind them).
fn issue_entries_sort_ascending(entries: List<IssueStreamEntry>) -> List<IssueStreamEntry> {
  fold(entries, init: [], f: (acc, e) => issue_entry_insert(sorted: acc, e: e))
}

fn issue_entry_insert(sorted: List<IssueStreamEntry>, e: IssueStreamEntry) -> List<IssueStreamEntry> {
  match sorted.first() {
    Absent => [ e ]
    Present { value: head } =>
      if issue_entry_time(e) <= issue_entry_time(head) {
        concat([e], sorted)
      } else {
        concat([head], issue_entry_insert(sorted: sorted.skip(n: 1), e: e))
      }
  }
}

// The preview uses the same durable event stream as every other instance.
fn issue_comments_stream_node(node_id: String, envs: List<RoadmapEventEnvelope>, profiles: List<PrincipalProfile>) -> Fragment {
  let entries = issue_stream_entries(envs: envs)
  el_class("div", "issue-comments", [
    el_class("h2", "issue-comments-heading", [txt(concat("Comments · ", to_string(value: count(roadmap_issue_comments(envs: envs)))))]),
    el_class("div", "issue-comment-stream", if count(entries) == 0 {
      [el_class("p", "issue-panel-empty", [txt("No comments yet.")])]
    } else { map(entries, e => issue_stream_entry_row_node(node_id: node_id, envs: envs, entries: entries, e: e, profiles: profiles)) }),
  ])
}

fn issue_stream_entry_row_node(node_id: String, envs: List<RoadmapEventEnvelope>, entries: List<IssueStreamEntry>, e: IssueStreamEntry, profiles: List<PrincipalProfile>) -> Fragment {
  match e {
    StreamComment { comment } => issue_comment_row_node(node_id: node_id, comments: roadmap_comments_of(entries: entries), c: comment, profiles: profiles)
    StreamPublication { env } => issue_publication_entry_row_node(node_id: node_id, envs: envs, env: env, profiles: profiles)
  }
}

fn roadmap_comments_of(entries: List<IssueStreamEntry>) -> List<IssueComment> {
  fold(entries, init: [], f: (acc, e) => match e {
    StreamComment { comment } => concat(acc, [comment])
    StreamPublication { env: _ } => acc
  })
}

// THE COMPACT AUTOMATED RESULT ENTRY (owner mandate: one compact automated comment with PR/head,
// reassigned for merge; operator ruling 2026-10-03: every terminal outcome is returned, not only
// the published one): fabric's service avatar, the attempt, the outcome sentence, and the
// principal the result names — the durable event is the comment; nothing is synthesized twice.
fn issue_publication_entry_row_node(node_id: String, envs: List<RoadmapEventEnvelope>, env: RoadmapEventEnvelope, profiles: List<PrincipalProfile>) -> Fragment {
  match env.event.kind {
    ResultReturned { attempt, claim, outcome } =>
      let display = event_principal_display_with_profile(p: env.event.author, profiles: profiles)
      el_attrs("div", [
        attr(name: "class", value: "issue-comment issue-publication" ),
        attr(name: "data-event-kind", value: "result_returned" ),
        attr(name: "data-result-outcome", value: attempt_result_outcome_word(o: outcome) ),
        attr(name: "data-attempt", value: attempt as String ),
      ], [
        issue_avatar_chip_node(display: display, workflow: event_principal_is_fabric(p: env.event.author)),
        el_class("div", "issue-comment-main", [
          el_class("div", "issue-comment-head", concat(
            [ el_class("span", "issue-comment-author", [ txt(display.name) ]) ],
            concat(
              [ el_class("span", "issue-comment-at", [ txt(env.event.recorded_at) ]) ],
              [ el_class("span", "issue-comment-detail", [ txt(display.detail) ]) ]))),
          el_class("div", "issue-comment-body", [
            txt(issue_result_entry_sentence(outcome: outcome, return_to: issue_result_return_to_name(envs: envs, claim: claim, profiles: profiles))),
          ]),
        ]),
      ])
    Claimed { assignee: _, return_to: _ } =>
      el_class("div", "issue-comment-body", [ txt("") ])
    Released =>
      el_class("div", "issue-comment-body", [ txt("") ])
    Progress { note: _ } =>
      el_class("div", "issue-comment-body", [ txt("") ])
    Blocked { reason: _ } =>
      el_class("div", "issue-comment-body", [ txt("") ])
    HandedBack { reason: _ } =>
      el_class("div", "issue-comment-body", [ txt("") ])
    ReceiptReferenced { obligation: _, address: _, verdict: _ } =>
      el_class("div", "issue-comment-body", [ txt("") ])
    CommentCreated { comment: _, body: _, visibility: _, parent_comment: _ } =>
      el_class("div", "issue-comment-body", [ txt("") ])
    CommentEdited { comment: _, body: _ } =>
      el_class("div", "issue-comment-body", [ txt("") ])
    CommentDeleted { comment: _ } =>
      el_class("div", "issue-comment-body", [ txt("") ])
  }
}

// THE NAME OF THE PRINCIPAL A RESULT RETURNS TO, read from the claim the result names in the same
// history. The carrier admits no result whose claim the history lacks, so the absent arm is a
// history this page was handed incomplete, and it says so rather than naming anyone.
fn issue_result_return_to_name(envs: List<RoadmapEventEnvelope>, claim: RoadmapEventId, profiles: List<PrincipalProfile>) -> String {
  match roadmap_claim_return_to(envs: envs, claim: claim) {
    Present { value: return_to } => event_principal_display_with_profile(p: return_to, profiles: profiles).name
    Absent => "the requester of a claim this history does not carry"
  }
}

// THE ENTRY'S SENTENCE, one per outcome, naming the principal its claim returns to: a published
// result says who it was reassigned to for merge; every other outcome says who the answer was
// returned to, because the holder did not move.
fn issue_result_entry_sentence(outcome: AttemptResultOutcome, return_to: String) -> String {
  match outcome {
    ResultPublished { pr: _, head: _ } => join([attempt_result_outcome_text(o: outcome), " — reassigned for merge to ", return_to], "")
    ResultVerificationFailed { head: _, cause: _ } => join([attempt_result_outcome_text(o: outcome), " — returned to ", return_to], "")
    ResultHandedBack { reason: _ } => join([attempt_result_outcome_text(o: outcome), " — returned to ", return_to], "")
  }
}

// THE COMPOSER, the durable-comment write surface: a NATIVE FORM (method + action + enctype
// text/plain — honest-before-JS, the body rides LAST since markdown freely carries newlines), the
// key field for retry-idempotence (empty until the client mints one; the server still dedupes the
// keyless retry by author + body + head), the csrf field the write law consults
// (gunbc.auth.request_authentication.human_write_admission) — filled AT RENDER from the seated
// session, the synchronizer-token pattern: the detail route renders per request with the session
// in hand, so no context fetch or client fill is needed, and the response is no-store so the
// token never crosses viewers (the 2026-09-28 defect: the field shipped EMPTY and every real
// comment refused with a CSRF mismatch; the empty spelling remains the unauthenticated render,
// which the write law refuses honestly) — and the expected_revision pin matching the assign
// form. The submit wears no .issue-action class — the client's bodyless action
// bind must not race the native submit.
fn issue_comment_composer_node(node_id: String, expected_revision: String, profiles: List<PrincipalProfile> = [], command_context: IssueFormContext = IssueFormContext { operation: "", csrf: "" }) -> Fragment {
  el_attrs("form", [
    attr(name: "class", value: "issue-comment-form" ),
    attr(name: "method", value: "post" ),
    attr(name: "enctype", value: "application/x-www-form-urlencoded" ),
    attr(name: "action", value: join(["/issue/", node_id, "/comment"], "") ),
  ], [
    el_attrs("input", [ attr(name: "name", value: "key" ), attr(name: "type", value: "hidden" ), attr(name: "value", value: if command_context.operation == "" { "" } else { concat(command_context.operation, "-comment") } ) ], []),
    el_attrs("input", [ attr(name: "name", value: "csrf" ), attr(name: "type", value: "hidden" ), attr(name: "value", value: command_context.csrf ) ], []),
    el_attrs("input", [ attr(name: "name", value: "expected_revision" ), attr(name: "type", value: "hidden" ), attr(name: "value", value: expected_revision ) ], []),
    el_attrs("textarea", [
      attr(name: "name", value: "body" ),
      attr(name: "class", value: "issue-comment-input" ),
      attr(name: "placeholder", value: "Write a comment. Type @ to mention a person or group." ),
      attr(name: "aria-label", value: "Comment"),
      attr(name: "aria-controls", value: "issue-mention-options"),
    ], []),
    el_attrs("div", [attr(name: "id", value: "issue-mention-options"), attr(name: "class", value: "site-choice-list issue-mention-options"), attr(name: "role", value: "listbox"), attr(name: "aria-label", value: "Mention suggestions"), attr(name: "hidden", value: "")],
      concat([issue_mention_option(p: fabric_workflow_principal, profiles: profiles)], map(profiles, p => issue_mention_option(p: p.principal, profiles: profiles)))),
    el_attrs("button", concat(if command_context.csrf == "" { [attr(name: "disabled", value: ""), attr(name: "title", value: "Sign in to post a comment")] } else { [] }, [
      attr(name: "class", value: "issue-comment-submit issue-action-text" ),
      attr(name: "type", value: "submit" ),
      attr(name: "data-action-route", value: "comment" ),
      attr(name: "data-node", value: node_id ),
    ]), [ txt("Comment") ]),
  ])
}

fn issue_work_tab_nodes(view: WorkRowView, attempts: List<WorkflowAttemptProgress>, events: List<RoadmapEventEnvelope>) -> List<Fragment> {
  let rounds = issue_work_history_rounds(ledger: view.rounds)
  concat(
    if count(attempts) == 0 { [] } else {
      [ el_class("div", "issue-attempt-history", map(attempts, issue_attempt_history_row_node)) ]
    },
    concat(
      if count(rounds) == 0 { [] } else {
        [ el_class("div", "issue-work-history", map(rounds, issue_work_history_row_node)) ]
      },
      match view.activity {
        NoActiveWork => if count(attempts) == 0 && count(rounds) == 0 { [el_class("p", "issue-panel-empty", [txt("No work has been recorded for this issue.")])] } else { [] }
        ActivityUnobservable { reason } => [ el_class("p", "issue-observation-unavailable", [ txt(concat("Work observation unavailable: ", reason)) ]) ]
        ActiveWork { summary: _, obligations, remaining_obligation_count: _, current_activity: _, attention: _, evidence } =>
          issue_work_ledger_nodes(view: view, obligations: obligations, evidence: evidence, located_reason: "")
        ActiveWorkRefused { summary: _, located_reason, evidence, obligations } =>
          issue_work_ledger_nodes(view: view, obligations: obligations, evidence: evidence, located_reason: located_reason)
        LegacySupersedableAttempt { summary: _, located_reason, attempt_key, evidence } =>
          issue_work_ledger_nodes(view: view, obligations: [],
            evidence: concat(evidence, [ ActivityEvidenceRow { label: "attempt key", value: attempt_key } ]),
            located_reason: located_reason)
        CompletedWork { outcome: _, evidence, obligations } =>
          issue_work_ledger_nodes(view: view, obligations: obligations, evidence: evidence, located_reason: "")
      }))
}

fn issue_work_ledger_row_node(s: WorkflowSegment, wait_target: String) -> Fragment {
  let state = workflow_segment_state_key(state: s.state)
  let detail = workflow_segment_detail_bounded(detail: s.detail)
  el_attrs("div", [
    attr(name: "class", value: activity_obligation_class ),
    attr(name: "data-state", value: state ),
  ], [ txt(join([
    workflow_segment_kind_label(kind: s.kind), activity_state_sep,
    issue_wait_state_label(state_key: state, wait_target: wait_target),
    if detail == "" { "" } else { join([activity_detail_sep, detail], "") },
  ], "")) ])
}

fn issue_work_ledger_nodes(view: WorkRowView, obligations: List<WorkflowSegment>, evidence: List<ActivityEvidenceRow>, located_reason: String) -> List<Fragment> {
  let wait_target = issue_first_open_kind(segments: obligations)
  concat(
    if count(obligations) == 0 { [] } else {
      [ el_class("div", activity_ledger_class, map(obligations, s => issue_work_ledger_row_node(s: s, wait_target: wait_target))) ]
    },
    [ el_class("div", activity_evidence_class, concat(
        map(evidence, row => activity_evidence_row_node(row: row)),
        if located_reason == "" { [] } else {
          [ el_class("div", activity_located_reason_class, [ txt(located_reason) ]) ]
        })) ])
}

fn issue_tab_chip(label: String, tab: String) -> Fragment {
  el_attrs("button", [
    attr(name: "class", value: if tab == "comments" { "chip chip-on" } else { "chip" } ),
    attr(name: "type", value: "button" ),
    attr(name: "data-tab-chip", value: tab ),
  ], [ txt(label) ])
}

// THE HEADER CHIPS (owner mandate 2026-09-25, docs/plans/issue-page-architecture.md): planning
// status + type + priority ONLY — [Done] [Task] [P2] — never competing status strings. The type
// row is the interface's single issue kind today (every tracked issue is a task until a type
// vocabulary lands); the priority chip renders only when the authority carries a priority (it
// does not yet — the chip omits, never fabricates). The standing line, the live bar signal and
// the assignee control moved to the metadata rail.
fn issue_head_chip_nodes(view: WorkRowView) -> List<Fragment> {
  status_chip_nodes(view: view)
}

// THE PROJECT PATH BREADCRUMB: one navigation answer per issue, rendered directly above the page
// body. The ONLY derivation named is alignment_resolve -- the same resolution the dispatch gate
// consumes -- never a second path answer folded out of the raw memberships. The ready arm renders
// the chain's levels ROOT-TO-LEAF: each project level links to its /project/<node_id> suite, the
// task level is the current page and renders as plain text (no self-link), and the
// root-principles pointer is skipped (it is a pointer to gunbc.design_document, not a page). The
// unresolved arm renders the typed refusal itself -- a partial path is never dressed as a complete
// one.
type IssueBreadcrumbCrumb
  = IssueBreadcrumbProject { node_id: String, purpose: String, boundary: String }
  | IssueBreadcrumbTask { node_id: String, purpose: String, boundary: String }

type IssueBreadcrumb
  = IssueBreadcrumbPath { crumbs: List<IssueBreadcrumbCrumb> }
  | IssueBreadcrumbRefused { reason: String }

// THE CRUMBS from the chain's levels: the root-principles level contributes no crumb (a pointer,
// not a page); every other level contributes one crumb carrying its purpose and boundary.
fn issue_breadcrumb_crumbs(levels: List<AlignmentLevel>) -> List<IssueBreadcrumbCrumb> {
  fold(levels, init: [] as List<IssueBreadcrumbCrumb>, f: fn(acc, level) {
    match level {
      RootPrinciplesLevel => acc
      ProjectIntentLevel { link } => concat(acc, [IssueBreadcrumbProject { node_id: link.node_id, purpose: link.purpose, boundary: link.boundary }])
      TaskContractLevel { link } => concat(acc, [IssueBreadcrumbTask { node_id: link.node_id, purpose: link.purpose, boundary: link.boundary }])
    }
  })
}

fn issue_breadcrumb_of(resolution: AlignmentResolution) -> IssueBreadcrumb {
  match resolution {
    AlignmentReady { chain, due_levels: _, rendered_prompt: _ } =>
      IssueBreadcrumbPath { crumbs: issue_breadcrumb_crumbs(levels: alignment_levels(chain: chain)) }
    AlignmentUnresolved { cause } =>
      IssueBreadcrumbRefused { reason: alignment_refusal_reason(cause: cause) }
  }
}

fn issue_breadcrumb_crumb_node(crumb: IssueBreadcrumbCrumb) -> Fragment {
  match crumb {
    IssueBreadcrumbProject { node_id, purpose, boundary } =>
      el_attrs("a", [
        attr(name: "href", value: join(["/project/", node_id], "")),
        attr(name: "title", value: boundary),
      ], [ txt(purpose) ])
    IssueBreadcrumbTask { node_id: _, purpose, boundary } =>
      el_attrs("span", [
        attr(name: "class", value: "issue-breadcrumb-here"),
        attr(name: "title", value: boundary),
      ], [ txt(purpose) ])
  }
}

// THE CRUMB LIST'S SEPARATOR LAW: " › " BETWEEN crumbs only -- never leading, never trailing --
// so the single-crumb path and the refusal arm emit exactly their own text and nothing else.
fn issue_breadcrumb_nodes(breadcrumb: IssueBreadcrumb) -> List<Fragment> {
  match breadcrumb {
    IssueBreadcrumbPath { crumbs } => {
      let spaced = fold(crumbs, init: { out: [] as List<Fragment>, first: true }, f: fn(acc, crumb) {
        {
          out: if acc.first {
            concat(acc.out, [issue_breadcrumb_crumb_node(crumb: crumb)])
          } else {
            concat(acc.out, [txt(" › "), issue_breadcrumb_crumb_node(crumb: crumb)])
          },
          first: false,
        }
      })
      spaced.out
    }
    IssueBreadcrumbRefused { reason } =>
      [ el_class("span", "issue-breadcrumb-refused", [ txt(join(["project path unavailable: ", reason], "")) ]) ]
  }
}

fn issue_alignment_breadcrumb_node(resolution: AlignmentResolution) -> Fragment {
  el_class("nav", "issue-breadcrumb", issue_breadcrumb_nodes(breadcrumb: issue_breadcrumb_of(resolution: resolution)))
}

fn issue_detail_page(view: WorkRowView, panel: IssueLinkPanel, observation: ObservationImpactView, attempts: List<WorkflowAttemptProgress>, events: List<RoadmapEventEnvelope>, viewer: String, recents: List<EventPrincipal>, expected_revision: String, command_context: IssueFormContext = IssueFormContext { operation: "", csrf: "" }) -> Fragment {
  issue_detail_page_with_alignment(view: view, panel: panel, observation: observation, attempts: attempts, events: events, viewer: viewer, recents: recents, expected_revision: expected_revision, command_context: command_context,
    alignment: alignment_resolve(node_id: view.node_id, turns_elapsed: 1, state: alignment_base_cadence_state()))
}

// The page consumes the resolved project path; the authority-bound entry above supplies it.
fn issue_detail_page_with_alignment(view: WorkRowView, panel: IssueLinkPanel, observation: ObservationImpactView, attempts: List<WorkflowAttemptProgress>, events: List<RoadmapEventEnvelope>, viewer: String, recents: List<EventPrincipal>, expected_revision: String, command_context: IssueFormContext = IssueFormContext { operation: "", csrf: "" }, alignment: AlignmentResolution) -> Fragment {
  el_attrs("main", [
    attr(name: "class", value: "issue-detail" ),
    attr(name: "data-tab", value: "comments" ),
  ], [
    el_class("div", "issue-detail-head", concat(
      [ el_class("span", "issue-id", [ txt(view.node_id) ]) ],
      concat(
        [ el_class("h1", "issue-detail-title", inline_md_nodes(text: view.headline)) ],
        issue_head_chip_nodes(view: view)))),
    el_class("div", "issue-tabs", [
      issue_tab_chip(label: concat("Comments · ", to_string(value: count(roadmap_issue_comments(envs: events)))), tab: "comments"),
      issue_tab_chip(label: "Dependencies", tab: "dependencies"),
      issue_tab_chip(label: "Work", tab: "work"),
      issue_tab_chip(label: "History", tab: "history"),
    ]),
    issue_alignment_breadcrumb_node(resolution: alignment),
    el_class("div", "issue-body", [
      el_class("div", "issue-panels", [
        el_class("section", "panel-comments", issue_comments_tab_nodes(view: view, events: events, expected_revision: expected_revision, command_context: command_context)),
        el_class("section", "panel-dependencies", issue_dependencies_tab_nodes(view: view, panel: panel)),
        el_class("section", "panel-work", issue_work_tab_nodes(view: view, attempts: attempts, events: events)),
        el_class("section", "panel-history", issue_history_tab_nodes(events: events, profiles: view.profiles)),
      ]),
      issue_metadata_rail_node(view: view, panel: panel, attempts: attempts, events: events, viewer: viewer, recents: recents, expected_revision: expected_revision, command_context: command_context),
    ]),
  ])
}

// THE COMMENTS TAB: the description pinned above the stream, the composer below — the page's
// default panel (the tab law renders it when data-tab is "comments").
fn issue_comments_tab_nodes(view: WorkRowView, events: List<RoadmapEventEnvelope>, expected_revision: String, command_context: IssueFormContext = IssueFormContext { operation: "", csrf: "" }) -> List<Fragment> {
  concat(
    [
      issue_description_node(view: view),
      issue_comments_stream_node(node_id: view.node_id, envs: events, profiles: view.profiles),
      issue_comment_composer_node(node_id: view.node_id, expected_revision: expected_revision, profiles: view.profiles, command_context: command_context),
    ],
    disclosure_folded_nodes(d: view.disclosure, done: work_lifecycle_key(l: view.lifecycle) == "done"))
}

// Nesting and blocking are independently projected; no reverse blocker stands in for a child.
// One-hop dependency neighborhood. Solid lanes are prerequisite edges; project
// membership is a separate dashed lane. Completed prerequisites remain visible.
fn issue_graph_link(link: IssueLinkView) -> Fragment {
  issue_membership_link(link: link, parent: false)
}
fn issue_membership_link(link: IssueLinkView, parent: Bool) -> Fragment {
  el_attrs("a", [attr(name: "class", value: "issue-graph-node"), attr(name: "href", value: concat("/issue/", link.node_id)),
    attr(name: "data-complete", value: if link.status == "done" || link.status == "superseded" { "1" } else { "0" }),
    attr(name: "aria-label", value: concat(if parent { "Parent project: " } else { "Child issue: " }, link.headline)),
    attr(name: "title", value: concat(if parent { "Parent project · " } else { "Child issue · " }, concat(link.node_id, concat(" · ", link.status))))], [
    el_attrs("svg", [attr(name: "class", value: "issue-membership-icon"), attr(name: "viewBox", value: "0 0 16 16"), attr(name: "fill", value: "none"), attr(name: "stroke", value: "currentColor"), attr(name: "stroke-width", value: "1.5"), attr(name: "stroke-linecap", value: "round"), attr(name: "stroke-linejoin", value: "round"), attr(name: "aria-hidden", value: "true")], [el_attrs("path", [attr(name: "d", value: if parent { "M12 13H8a3 3 0 0 1-3-3V3M2 6l3-3 3 3" } else { "M3 2v6a3 3 0 0 0 3 3h7M10 8l3 3-3 3" })], [])]),
    el_class("span", "issue-membership-name", [txt(link.headline)]), el_class("small", "issue-graph-state", [txt(link.status)]),
  ])
}
fn issue_graph_column(label: String, links: List<IssueLinkView>) -> Fragment {
  el_class("div", "issue-graph-column", [el("h3", [txt(label)]),
    el_class("div", "issue-graph-branch", if count(links) == 0 { [el_class("p", "issue-panel-empty", [txt("None declared")])] } else { map(links, issue_graph_link) }),
  ])
}
fn issue_dependency_graph_item(link: IssueLinkView) -> DependencyGraphItem {
  DependencyGraphItem { id: link.node_id, label: link.headline, status: link.status }
}
fn issue_dependencies_tab_nodes(view: WorkRowView, panel: IssueLinkPanel) -> List<Fragment> {
  [el_class("section", "issue-dependency-graph", [
    el("h2", [txt("Dependencies")]),
    el_class("p", "issue-graph-legend", [txt("Read top to bottom. Arrows lead from a prerequisite to the issue that needs it. Click a grouped node to expand its issues; select an issue to follow its dependencies.")]),
    el_class("div", "issue-dag-key", [
      el_attrs("span", [attr(name: "data-state", value: "selected")], [txt("Selected")]),
      el_attrs("span", [attr(name: "data-state", value: "open")], [txt("Unfinished")]),
      el_attrs("span", [attr(name: "data-state", value: "done")], [txt("Done")]),
      el_attrs("span", [attr(name: "data-state", value: "unknown")], [txt("Unknown")]),
    ]),
    dependency_graph_interactive(current: DependencyGraphItem { id: view.node_id, label: view.headline, status: issue_status_label(view: view) }, prerequisites: map(panel.prerequisites, issue_dependency_graph_item), dependents: map(panel.blocking, issue_dependency_graph_item)),
    el_class("p", "issue-dag-empty", if count(panel.prerequisites) == 0 && count(panel.blocking) == 0 { [txt("No dependencies declared.")] } else { [] }),
    el_class("div", "issue-graph-membership", [el("h3", [txt("Project membership")]),
      el_class("div", "issue-membership-tree", concat(match panel.parent { Absent => [] Present { value: parent } => [issue_membership_link(link: parent, parent: true)] }, [
        el_attrs("div", [attr(name: "class", value: "issue-membership-subtree"), attr(name: "data-has-parent", value: match panel.parent { Absent => "0" Present { value: _ } => "1" })], [
          el_class("details", "issue-membership-children", concat([
            el_attrs("summary", [attr(name: "class", value: "issue-membership-current"), attr(name: "aria-current", value: "true"), attr(name: "aria-label", value: join([view.headline, " · ", to_string(value: count(panel.children)), " child issues"], ""))], [
              el_class("span", "issue-membership-selected-mark", []),
              el_class("strong", "issue-membership-selected", [txt(view.headline)]),
              el_attrs("span", [attr(name: "class", value: "issue-membership-count"), attr(name: "aria-hidden", value: "true")], [txt(to_string(value: count(panel.children)))]),
            ]),
          ], if count(panel.children) == 0 { [el_class("p", "issue-panel-empty", [txt("No child issues")])] } else { [el_class("div", "issue-membership-list", map(panel.children, issue_graph_link))] })),
        ]),
      ])),
    ]),
    el_class("p", "issue-graph-warning", if panel.cycle { [txt("Dependency cycle touches this issue. Review the linked prerequisites before dispatching.")] } else { [] }),
  ])]
}

// THE HISTORY TAB: the raw event ledger, newest first — every durable event with its author,
// kind, and payload. Execution evidence (attempts, rounds, the stage ledger) lives on the Work
// tab exclusively; this tab is the audit trail.
fn issue_history_tab_nodes(events: List<RoadmapEventEnvelope>, profiles: List<PrincipalProfile> = []) -> List<Fragment> {
  if count(events) == 0 { [el_class("p", "issue-panel-empty", [txt("No issue history yet.")])] } else {
    [ el_class("div", "issue-event-history", map(issue_events_newest_first(envs: events), env => issue_event_row_node(env: env, profiles: profiles))) ]
  }
}

// THE RIGHT METADATA RAIL (owner mandate): status, assignee (the editable control), reporter,
// component, parent, blocked-by/blocking, delivery, return-to, modified, observation — the
// issue's identity and state at a glance, beside the narrative. Rows with no fact OMIT (the
// mandate's empty-row law), except status and assignee which always render.
fn issue_metadata_rail_node(view: WorkRowView, panel: IssueLinkPanel, attempts: List<WorkflowAttemptProgress>, events: List<RoadmapEventEnvelope>, viewer: String, recents: List<EventPrincipal>, expected_revision: String, command_context: IssueFormContext = IssueFormContext { operation: "", csrf: "" }) -> Fragment {
  let assignment = roadmap_issue_assignment(envs: events)
  let bar = task_bar_view_of(view: view, observation: observation_impact_view(workflow_refused: none))
  el_class("aside", "issue-rail", [
    issue_field_row(label: "status", value: [issue_status_node(view: view, events: events)]),
    issue_rail_assignee_row(view: view, attempts: attempts, assignment: assignment, viewer: viewer, recents: recents, expected_revision: expected_revision, command_context: command_context),
    issue_field_text_row(label: "reporter", value: issue_reporter_value(events: events)),
    issue_field_text_row(label: "component", value: issue_component_value(view: view)),
    issue_field_row(label: "parent", value: issue_parent_value(panel: panel)),
    issue_rail_optional_nodes_row(label: "blocked by", value: issue_link_count_nodes(links: panel.blocked_by)),
    issue_rail_optional_nodes_row(label: "blocking", value: issue_link_count_nodes(links: panel.blocking)),
    issue_rail_optional_row(label: "delivery", value: issue_delivery_value(attempts: attempts)),
    issue_rail_return_to_row(view: view, assignment: assignment),
    issue_rail_optional_row(label: "modified", value: issue_modified_value(events: events)),
    issue_rail_optional_row(label: "observation", value: if count(attempts) == 0 { "" } else { bar.signal }),
  ])
}

// Status detail keeps the latest ledger standing alongside the observed planning facts.
// THE STANDING SENTENCE AS A PAGE SHOWS IT: the ledger's one sentence, with each principal named
// by the same profile-bound display the avatar chips use ("Fabric", "Brian Searls") rather than
// its canonical label.
fn issue_standing_text(s: RoadmapNodeStanding, profiles: List<PrincipalProfile>) -> String {
  roadmap_node_standing_text_naming(s: s, name: fn(p) { event_principal_display_with_profile(p: p, profiles: profiles).name })
}

// The current identity becomes the editor in place; closing restores the projected holder.
fn issue_rail_assignee_row(view: WorkRowView, attempts: List<WorkflowAttemptProgress>, assignment: IssueAssignmentProjection, viewer: String, recents: List<EventPrincipal>, expected_revision: String, command_context: IssueFormContext = IssueFormContext { operation: "", csrf: "" }) -> Fragment {
  let face = match assignment.holder {
    Absent => unassigned_avatar()
    Present { value: holder } => issue_avatar_chip_node(display: event_principal_display_with_profile(p: holder, profiles: view.profiles), workflow: event_principal_is_fabric(p: holder))
  }
  let label = match assignment.holder { Absent => "Unassigned" Present { value: holder } => event_principal_display_with_profile(p: holder, profiles: view.profiles).detail }
  issue_field_row(label: "assignee", value: [el_class("details", "issue-assignee-disclosure", concat([
    el_attrs("summary", [attr(name: "aria-label", value: concat("Change assignee: ", label))], [face, el_class("span", "issue-assignee-identity", [txt(label)])]),
  ], issue_detail_action_bar_nodes(view: view, current_assignee: if label == "Unassigned" { "" } else { label }, viewer: viewer, recents: recents, expected_revision: expected_revision, command_context: command_context)))])
}

// THE RETURN-TO ROW: the stored merge owner the work comes back to (the publication handoff's
// target) — rendered when any assignment recorded one.
fn issue_rail_return_to_row(view: WorkRowView, assignment: IssueAssignmentProjection) -> Fragment {
  match assignment.return_to {
    Present { value: return_to } =>
      issue_field_row(label: "return to", value: issue_assignee_chip_node(holder: return_to, profiles: view.profiles))
    Absent =>
      el_class("div", "issue-field", [])
  }
}

fn issue_rail_optional_row(label: String, value: String) -> Fragment {
  if value == "" {
    el_class("div", "issue-field", [])
  } else {
    issue_field_text_row(label: label, value: value)
  }
}

fn issue_rail_optional_nodes_row(label: String, value: List<Fragment>) -> Fragment {
  if count(value) == 0 {
    el_class("div", "issue-field", [])
  } else {
    issue_field_row(label: label, value: value)
  }
}

// THE RAIL CARRIES A RELATION'S SIZE, NOT ITS POPULATION. The rail is a 34ch column: every blocker's
// headline comma-joined into it wrapped ten titles down the page. The rail names how many, and the
// count opens the Dependencies tab (the same data-tab-chip the tab strip uses), where each target
// is its own link. No relation, no row.
fn issue_link_count_nodes(links: List<IssueLinkView>) -> List<Fragment> {
  let n = count(links)
  if n == 0 {
    []
  } else {
    [ el_attrs("button", [
        attr(name: "class", value: "issue-rail-link" ),
        attr(name: "type", value: "button" ),
        attr(name: "data-tab-chip", value: "dependencies" ),
      ], [ txt(join([to_string(value: n), if n == 1 { " issue" } else { " issues" }], "")) ]) ]
  }
}

// THE REPORTER IS WHO OPENED THE ISSUE, and the event vocabulary has no creation event: every
// issue on this surface is an authored roadmap row, opened by nobody the ledger can name. The row
// says so rather than promoting the owner lane (a component, e.g. @shell) to a person. When an
// IssueCreated kind lands, its author is this value.
fn issue_reporter_value(events: List<RoadmapEventEnvelope>) -> String {
  "not recorded (authored roadmap row)"
}

// DELIVERY: the latest attempt's short key names the delivery vehicle until issue→PR links land
// (the Implements relation is the named follow-up); no attempt, no row.
fn issue_delivery_value(attempts: List<WorkflowAttemptProgress>) -> String {
  match attempts.first() {
    Present { value: p } => join(["attempt ", attempt_key_short_form(key: p.attempt_key)], "")
    Absent => ""
  }
}

// MODIFIED: the newest event's recorded_at — the ledger's own freshness fact; no events, no row.
fn issue_modified_value(events: List<RoadmapEventEnvelope>) -> String {
  match issue_events_newest_first(envs: events).first() {
    Present { value: newest } => newest.event.recorded_at
    Absent => ""
  }
}

fn issue_detail_page_launch(view: WorkRowView, panel: IssueLinkPanel, observation: ObservationImpactView, attempts: List<WorkflowAttemptProgress>, events: List<RoadmapEventEnvelope>, viewer: String, recents: List<EventPrincipal>, expected_revision: String, command_context: IssueFormContext = IssueFormContext { operation: "", csrf: "" }, profiles: List<PrincipalProfile>) -> Fragment {
  site_document(title: join(["gunbc — issue ", view.node_id], ""), heading: "issue", styles: roadmap_styles(), content: [
issue_detail_page(view: view, panel: panel, observation: observation, attempts: attempts, events: events, viewer: viewer, recents: recents, expected_revision: expected_revision, command_context: command_context),
dispatch_client_script()
])
}

// THE DETAIL ROUTE'S RENDER ENTRY (owner ruling 2026-09-24: the detail page is a real served
// route): one issue's decided row view, link panel, and Work-tab history rendered from the SAME
// authorities the daily page reads — the plan for the ticket and links, the standings observation
// for the holder, the node's event log for the durable execution history. Attempts ride the same
// list the static render takes; the live attempt feed is the belt-side observation-storage
// decision (deferred with the reason carried in the handoff), and the events keep the Work tab
// honest until it lands. Unknown ids render the not-found document; the route answers 404 for it.
fn issue_detail_node_exists(proj: RoadmapAuthorityProjection, node_id: String) -> Bool {
  match proj {
    RoadmapAuthorityProjectionRefused { detail: _ } => false
    RoadmapAuthorityProjected { doc, accepted: _, withheld: _ } =>
      any(doc_all_nodes(doc: doc), n => (n.node as String) == node_id)
  }
}

// THE CHAIN HEAD the rendered page pins into the assign form's expected_revision: the envelope no
// other envelope parents. Empty history pins the empty initial revision: if a first
// event arrives before submission, the POST refuses the changed head. The route separately
// refuses forked or incomplete histories before appending any assignment.
fn issue_chain_head_id(envs: List<RoadmapEventEnvelope>) -> String {
  match (filter(envs, e => !any(envs, o => match o.event.parent { Present { value: p } => (p as String) == (e.id as String)  Absent => false }))).first() {
    Present { value: h } => h.id as String
    Absent => ""
  }
}

fn issue_detail_page_for(
  proj: RoadmapAuthorityProjection,
  node_id: String,
  attempts: List<WorkflowAttemptProgress>,
  attempts_refused: String?,
  standings: RoadmapStandings,
  launch: LaunchHostStanding,
  stale_nodes: List<String>,
  events: List<RoadmapEventEnvelope>,
  viewer: String,
  recents: List<EventPrincipal>,
  command_context: IssueFormContext = IssueFormContext { operation: "", csrf: "" },
  profiles: List<PrincipalProfile>,
 memberships: List<RoadmapMembership> = roadmap_memberships()) -> Fragment {
  match proj {
    RoadmapAuthorityProjectionRefused { detail: detail } =>
      roadmap_daily_workspace_page_for_projection_observed_stale(
        proj: proj, attempts: attempts, attempts_refused: attempts_refused,
        standings: standings, launch: launch, stale_nodes: stale_nodes, profiles: profiles,
      memberships: memberships)
    RoadmapAuthorityProjected { doc, accepted: accepted, withheld: withheld } =>
      let nodes = doc_all_nodes(doc: doc)
      let edges = doc_all_edges(doc: doc)
      let ctx = page_launch_context(doc: doc, merged: authored_merged_prs(), launch: launch)
      let observation = observation_impact_view(workflow_refused: attempts_refused)
      match (filter(nodes, n => (n.node as String) == node_id)).first() {
        Absent =>
          issue_detail_not_found_page(node_id: node_id, viewer: viewer)
        Present { value: rn } =>
          issue_detail_page_launch(
            view: work_row_view(
              rn: rn, nodes: nodes, edges: edges, merged: authored_merged_prs(),
              activity: daily_row_activity(node_id: node_id, attempts: attempts, attempts_refused: attempts_refused),
              rounds: daily_row_rounds(node_id: node_id, attempts: attempts, attempts_refused: attempts_refused),
              worker_alive: daily_row_worker_alive(node_id: node_id, attempts: attempts, attempts_refused: attempts_refused),
              standing: standing_for_node(standings: standings, node_id: node_id),
              assignment: assignment_for_node(standings: standings, node_id: node_id),
              launch: ctx,
              attempt_stale: any(stale_nodes, s => s == node_id),
              profiles: profiles),
            panel: gunbc.roadmap_presentation.issue_link_panel(rn: rn, nodes: nodes, edges: edges, member_titles: declared_roadmap_nodes(), merged: authored_merged_prs()),
            observation: observation,
            attempts: attempts,
            events: events,
            viewer: viewer,
            recents: recents,
            expected_revision: issue_chain_head_id(envs: events), command_context: command_context,
            profiles: profiles)
      }
  }
}

fn issue_detail_not_found_page(node_id: String, viewer: String) -> Fragment {
  site_document(title: "gunbc — issue not found", heading: "issue", styles: roadmap_styles(), content: [
el_class("main", "issue-detail", [
          el_class("p", "issue-not-found", [ txt(join(["no issue named ", node_id, " is declared in the roadmap authority"], "")) ]),
        ])
])
}

// THE PROJECT SUITE PAGE (GET /project/<node_id>): ONE project's direct membership listing --
// the members declared under it in gunbc.roadmap_nesting, in authored order as the base order,
// then Kahn-layered by the declared dependency edges restricted to the member set: a member whose
// in-set prerequisites include another member sorts AFTER that member, and members with no
// in-set prerequisites keep their authored order at the front. The heading is the project row's
// own ticket headline; an absent row or a non-ticket row renders the not-found document, the same
// grain as the issue detail route.
type ProjectSuiteRow { node_id: String, title: String, cycle: Bool }

// THE HEADING'S TICKET PROJECTION: exactly one declared row, and that row a ticket -- anything
// else is a not-found, because a suite whose heading cannot be read against the row's own brief
// would be a listing no check can read against.
fn project_suite_headline(nodes: List<RoadmapNode>, node_id: String) -> String? {
  match (filter(nodes, n => (n.node as String) == node_id)).first() {
    Absent => none
    Present { value: rn } =>
      match rn.line {
        TicketLine { done: _, ticket } => Present { value: ticket.headline }
        DerivableLine { prs: _, title: _, description: _ } => none
        AuthoredLine { done: _, content: _ } => none
        PlainLine { content: _ } => none
        SupersededLine { by: _, content: _ } => none
      }
  }
}

// THE DIRECT MEMBERS, in authored order: the memberships whose project field names this suite --
// nothing from another project, nothing nested one level deeper.
fn project_suite_member_ids(memberships: List<RoadmapMembership>, project: String) -> List<String> {
  map(filter(memberships, m => m.project == project), m => m.member)
}

// A MEMBER'S IN-SET PREREQUISITES: the parent ends of its declared dependency edges (the
// roadmap_parent_ids read) restricted to members of this suite -- an edge whose parent stands
// outside the member set constrains nothing here.
fn project_suite_in_set_prereqs(edges: List<RoadmapEdge>, member: String, members: List<String>) -> List<String> {
  filter(roadmap_parent_ids(edges: edges, node: member as NonEmptyStr as RoadmapNodeId), p => any(members, m => m == (p as String)))
}

// ONE KAHN LAYER: every not-yet-emitted member whose in-set prerequisites are all already emitted,
// in authored order. A STABLE sort by construction: filter preserves the authored order the
// membership relation supplies.
fn project_suite_next_layer(members: List<String>, edges: List<RoadmapEdge>, emitted: List<String>) -> List<String> {
  filter(members, m => !any(emitted, e => e == m)
    && all(project_suite_in_set_prereqs(edges: edges, member: m, members: members), p => any(emitted, e => e == p)))
}

// A CYCLE STOPS PROGRESS: when no not-yet-emitted member can advance (a dependency cycle inside
// the member set), the remainder emits in authored order -- the listing degrades to declaration
// order rather than refusing the page over a fixture cycle. The fuel bound is count(members):
// every advancing layer emits at least one member, so a cycle is the only way to exhaust it.
fn project_suite_order_step(members: List<String>, edges: List<RoadmapEdge>, emitted: List<String>, fuel: Int) -> List<String> {
  if fuel <= 0 {
    concat(emitted, filter(members, m => !any(emitted, e => e == m)))
  } else {
    let layer = project_suite_next_layer(members: members, edges: edges, emitted: emitted)
    if count(layer) == 0 {
      concat(emitted, filter(members, m => !any(emitted, e => e == m)))
    } else {
      project_suite_order_step(members: members, edges: edges, emitted: concat(emitted, layer), fuel: fuel - 1)
    }
  }
}

fn project_suite_ordered_members(members: List<String>, edges: List<RoadmapEdge>) -> List<String> {
  project_suite_order_step(members: members, edges: edges, emitted: [], fuel: count(members))
}

// THE ROW'S TITLE: the node row's own title when one exists, the raw id when none does -- an
// undeclared member still lists, honestly labeled.
fn project_suite_member_title(nodes: List<RoadmapNode>, member: String) -> String {
  match (filter(nodes, n => (n.node as String) == member)).first() {
    Absent => member
    Present { value: rn } => node_title(item: rn.line)
  }
}

// THE LISTING, one row per direct member, topologically ordered.
fn project_suite_rows(memberships: List<RoadmapMembership>, edges: List<RoadmapEdge>, nodes: List<RoadmapNode>, project: String) -> List<ProjectSuiteRow> {
  let ordered = project_suite_ordered_members(members: project_suite_member_ids(memberships: memberships, project: project), edges: edges)
  map(ordered, m => ProjectSuiteRow { node_id: m, title: project_suite_member_title(nodes: nodes, member: m), cycle: dependency_cycle_touches(node_id: m, edges: edges) })
}

fn project_suite_row_node(row: ProjectSuiteRow) -> Fragment {
  el_class("li", "project-suite-member", [
    el_attrs("a", [
      attr(name: "href", value: join(["/issue/", row.node_id], "")),
      attr(name: "title", value: row.node_id),
    ], [ txt(row.title) ]),
    el_class("span", "issue-graph-warning", if row.cycle { [txt(" · dependency cycle")] } else { [] }),
  ])
}

fn project_suite_page_launch(headline: String, node_id: String, rows: List<ProjectSuiteRow>, viewer: String) -> Fragment {
  site_document(title: join(["gunbc — project ", node_id], ""), heading: "project", styles: roadmap_styles(), content: [
el_class("main", "project-suite", [
          el_class("div", "issue-detail-head", [
            el_class("span", "issue-id", [ txt(node_id) ]),
            el_class("h1", "issue-detail-title", [ txt(headline) ]),
          ]),
          el_class("p", "issue-graph-warning", if any(rows, r => r.cycle) { [txt("A dependency cycle prevents a complete ordering. Unresolved members follow in declared order.")] } else { [] }),
          if count(rows) == 0 {
            el_class("p", "project-suite-empty", [ txt("no direct members declared") ])
          } else {
            el_class("ul", "project-suite-members", map(rows, r => project_suite_row_node(row: r)))
          },
        ])
])
}

// THE NOT-FOUND DOCUMENT, the issue route's grain: an absent row or a non-ticket row is a missing
// project, said in one sentence.
fn project_suite_not_found_page(node_id: String, viewer: String) -> Fragment {
  site_document(title: "gunbc — project not found", heading: "project", styles: roadmap_styles(), content: [
el_class("main", "project-suite", [
          el_class("p", "issue-not-found", [ txt(join(["no project named ", node_id, " is declared as a ticket in the roadmap authority"], "")) ]),
        ])
])
}

// THE WORKSPACE RENDERS THE TABLE ALONE (owner ruling 2026-09-25: the tree/bands views and their
// forest container retire from the served page — see the surface note above issue_owner_value).
// The band derivation still runs one level down: DailyWorkspaceView's active/ready/not-ready/done/
// superseded entries are what the flat table flattens (workspace_flat_table), so the table's row
// ORDER is the band order and every row carries its data-band for the filter chips — the band
// vocabulary outlives the band SURFACE. The forest renderer below (workspace_entries_ul and its
// chain) stays in this module as the /sandbox exhibit's real grouping path; nothing on this page
// calls it.
fn workspace_markup(ws: DailyWorkspaceView, edges: List<RoadmapEdge>, memberships: List<RoadmapMembership> = roadmap_memberships()) -> Fragment {
  let hidden_summary = if ws.hidden_not_ready == 0 { [] } else { [
    el_attrs("span", [
      attr(name: "class", value: "issue-hidden-summary"),
      attr(name: "title", value: hidden_not_ready_summary(ws: ws))
    ], [txt(join([to_string(ws.hidden_not_ready), " not ready hidden"], ""))])
  ] }
  el_class("section", "roadmap-frontier", [
    el_class("div", "view-table", [
      el_class("div", "workspace-toolbar", concat([issue_controls_markup()], hidden_summary)),
      el_class("div", "issue-table-scroll", [issue_table_markup(rows: ws.table, observation: ws.observation, edges: edges, memberships: memberships)])
    ])
  ])
}

// THE STRIP'S NAME, superseded (owner ruling 2026-09-28: the "v1 exit · N of 4 finish lines"
// framing is retired — the workspace is the program now): the view keeps the type's shape for
// its remaining constructors, but the strip renders the workspace's readiness, and the
// completed/total fields ride unused until the type retires with its last consumer.
fn v1_exit_program_progress_view_for_accepted(accepted_ids: List<RoadmapNodeId>, ready_count: Int) -> ProgramProgressView {
  ProgramProgressView {
    name: "workspace",
    completed: v1_finish_lines_accepted_count(accepted: accepted_ids),
    total: count(v1_exit_finish_lines()),
    ready_obligation_count: ready_count,
  }
}

fn daily_attempt_progress_for(node_id: String, attempts: List<WorkflowAttemptProgress>) -> WorkflowAttemptProgress? {
  fold(attempts, init: none, f: (acc, p) => match acc {
    Present { value: v } => Present { value: v }
    Absent => if p.node_id == node_id { Present { value: p } } else { none }
  })
}

// THE STRIP'S LEDGER IS READ OFF THE SAME PROGRESS THE ACTIVITY VIEW IS, at the same seam, so the
// two cannot describe different attempts. It is a sibling projection rather than a field on the view
// for the reason given at rounds_of: the view is matched by name everywhere, the ledger is read in
// one place.
fn daily_row_rounds(node_id: String, attempts: List<WorkflowAttemptProgress>, attempts_refused: String?) -> HarnessRoundLedger {
  match attempts_refused {
    Present { value: _ } => RoundsUnobserved { reason: "attempts refused" as NonEmptyStr }
    Absent =>
      match daily_attempt_progress_for(node_id: node_id, attempts: attempts) {
        Present { value: p } => p.rounds
        Absent => RoundsUnobserved { reason: "no active attempt" as NonEmptyStr }
      }
  }
}

fn daily_row_worker_alive(node_id: String, attempts: List<WorkflowAttemptProgress>, attempts_refused: String?) -> Bool {
  match attempts_refused {
    Present { value: _ } => false
    Absent =>
      match daily_attempt_progress_for(node_id: node_id, attempts: attempts) {
        Present { value: p } => worker_alive_from_process(process: p.process)
        Absent => false
      }
  }
}

fn daily_row_activity(node_id: String, attempts: List<WorkflowAttemptProgress>, attempts_refused: String?) -> ActivityView {
  match attempts_refused {
    Present { value: reason } => ActivityUnobservable { reason: reason }
    Absent =>
      match daily_attempt_progress_for(node_id: node_id, attempts: attempts) {
        Present { value: p } => activity_view_from_progress(progress: p)
        Absent => NoActiveWork
      }
  }
}

// The live family facts: one WorkFamilyDecl for the closing-contract family (claim = the authority's closing_contract_family_claim, stated once) and one member fact per generator pair, each carrying the gated node's typed headline as the row subject. Fixtures construct their own decls/members, so the grouping stays witnessable without live counts.
fn closing_contract_family_id() -> String { "closing-contract" }

fn live_work_family_decls() -> List<WorkFamilyDecl> {
  [ WorkFamilyDecl { id: closing_contract_family_id(), claim: closing_contract_family_claim } ]
}

// The family members are read off the document being rendered: a closing-contract task is the one row
// whose parent is Closes { target } (gunbc.roadmap_authority closing_contract_task_for mints it, and
// nothing else declares that parent), and its subject is the gated row's own headline. The projected
// authority carries exactly the tasks closing_contract_task_pairs_for_accepted derives, in the same
// order, beside the rows they gate -- so the served page sees the same members, and a page rendered for
// a supplied document no longer reaches past it to the declared authority for them.
fn live_work_family_members_of(nodes: List<RoadmapNode>, index: Map<String, RoadmapNode>) -> List<WorkFamilyMemberFact> {
  flat_map(nodes, t => match t.parent {
    Absent => []
    Present { value: p } => match p {
      Closes { target: g } => match lineage_lookup(index: index, id: g) {
        Present { value: gated } => [WorkFamilyMemberFact { family_id: closing_contract_family_id(), task_node: t.node as String, subject: ticket_headline_of(n: gated) }]
        Absent => []
      }
      MemberOf { project: _, contribution: _ } => []
      AdmittedRoot => []
    }
  })
}

fn page_launch_context(doc: RoadmapDocument, merged: List<Int>, launch: LaunchHostStanding) -> LaunchRowContext {
  LaunchRowContext { standing: launch, graph: launch_graph_of_document(doc: doc), merged: merged }
}

fn daily_workspace_view_of_for_accepted(
  doc: RoadmapDocument,
  merged: List<Int>,
  accepted_ids: List<RoadmapNodeId>,
  withheld: List<RoadmapNodeId>,
  attempts: List<WorkflowAttemptProgress>,
  attempts_refused: String?,
  standings: RoadmapStandings,
  launch: LaunchHostStanding,
  stale_nodes: List<String>,
 profiles: List<PrincipalProfile>,
  memberships: List<RoadmapMembership> = roadmap_memberships()) -> DailyWorkspaceView {
  let nodes = doc_all_nodes(doc: doc)
  let edges = doc_all_edges(doc: doc)
  let observation = observation_impact_view(workflow_refused: attempts_refused)
  let ctx = page_launch_context(doc: doc, merged: merged, launch: launch)
  let graph = row_graph(nodes: nodes, edges: edges)
  let rows = map(nodes, rn => work_row_view_in(
    rn: rn, graph: graph, merged: merged,
    activity: daily_row_activity(node_id: rn.node as String, attempts: attempts, attempts_refused: attempts_refused),
    rounds: daily_row_rounds(node_id: rn.node as String, attempts: attempts, attempts_refused: attempts_refused),
    worker_alive: daily_row_worker_alive(node_id: rn.node as String, attempts: attempts, attempts_refused: attempts_refused),
    standing: standing_for_node(standings: standings, node_id: rn.node as String),
    assignment: assignment_for_node(standings: standings, node_id: rn.node as String),
    launch: ctx,
    attempt_stale: any(stale_nodes, s => s == rn.node as String),
    profiles: profiles))
  let ready_count = count(rows |> filter(r =>
    !row_is_active_work(row: r) && work_scheduling_key(s: r.scheduling) == "ready"))
  let shown_index = membership_index(memberships: memberships)
  let shown = rows |> filter(r => row_is_shown_in(row: r, index: shown_index))
  daily_workspace_view_in(
    rows: shown,
    edges: edges,
    program: Present { value: v1_exit_program_progress_view_for_accepted(accepted_ids: accepted_ids, ready_count: ready_count) },
    observation: observation,
    families: live_work_family_decls(),
    members: live_work_family_members_of(nodes: nodes, index: graph.lineage), memberships: shown_index,
    hidden_not_ready: count(rows) - count(shown))
}

fn roadmap_daily_workspace_page_impl_for_accepted(
  doc: RoadmapDocument,
  merged: List<Int>,
  accepted_ids: List<RoadmapNodeId>,
  withheld: List<RoadmapNodeId>,
  main_prefix: List<Fragment>,
  attempts: List<WorkflowAttemptProgress>,
  attempts_refused: String?,
  standings: RoadmapStandings,
  launch: LaunchHostStanding,
  stale_nodes: List<String>,
 profiles: List<PrincipalProfile>,
  memberships: List<RoadmapMembership> = roadmap_memberships()) -> Fragment {
  roadmap_daily_workspace_page_impl_for_accepted_with_stylesheet(
    doc: doc, merged: merged, accepted_ids: accepted_ids, withheld: withheld, main_prefix: main_prefix,
    attempts: attempts, attempts_refused: attempts_refused, standings: standings, launch: launch,
    stale_nodes: stale_nodes, profiles: profiles, memberships: memberships, stylesheet: roadmap_styles())
}

fn roadmap_daily_workspace_page_impl_for_accepted_with_stylesheet(
  doc: RoadmapDocument,
  merged: List<Int>,
  accepted_ids: List<RoadmapNodeId>,
  withheld: List<RoadmapNodeId>,
  main_prefix: List<Fragment>,
  attempts: List<WorkflowAttemptProgress>,
  attempts_refused: String?,
  standings: RoadmapStandings,
  launch: LaunchHostStanding,
  stale_nodes: List<String>,
 profiles: List<PrincipalProfile>,
  memberships: List<RoadmapMembership>,
  stylesheet: SiteStyles) -> Fragment {
  let ws = daily_workspace_view_of_for_accepted(
    doc: doc,
    merged: merged,
    accepted_ids: accepted_ids,
    withheld: withheld,
    attempts: attempts,
    attempts_refused: attempts_refused, standings: standings,
    launch: launch,
    stale_nodes: stale_nodes,
    profiles: profiles,
      memberships: memberships)
  site_document(title: "gunbc — daily workspace", heading: "workspace", styles: stylesheet, content: [
    el_attrs("main", [attr(name: "class", value: "daily-workspace"), attr(name: "data-observation-banners", value: "off")], concat(main_prefix, [workspace_markup(ws: ws, edges: doc_all_edges(doc: doc), memberships: memberships)])),
    dispatch_client_script()
  ])
}

// THE MACHINE-STANDING SURFACE IS ITS OWN PAGE, NOT A PREFIX ON THE WORK SURFACE.
//
// The two fleet panels answer a different question from every row below them: what the hardware is
// doing, versus what work is dispatchable. Composed into the daily workspace they occupied the
// first screen, so the surface the operator opens to decide WHAT TO LAUNCH led with facts that
// change no launch decision. Splitting them costs nothing structurally -- both panels are pure
// Fragment producers over their own authorities, so this page composes the SAME two calls the
// workspace used to make, and the panels keep their single authority.
//
// The witness that proves a panel reaches a rendered page follows the panel to this page rather
// than being deleted: the claim was never "the panel is on the daily workspace", it was "the panel
// reaches the surface the operator actually sees", and that surface is now /fleet.
fn roadmap_fleet_page() -> Fragment {
  site_document(title: "gunbc — fleet", heading: "fleet", styles: roadmap_styles(), content: [
el_class("main", "daily-workspace", [
          fleet_hardware_standing_panel(),
          fleet_capacity_panel(),
        ])
])
}

// THE STYLESHEET IS A PARAMETER BECAUSE IT IS HEAD CHROME NO ROW CLAIM READS. Deriving it here
// made every claim about BODY markup pay for it: roadmap_css() measures 157,986 eval steps against
// ~5,800 for the node row it was actually asserting on, so four page claims each spent 96% of their
// budget building a stylesheet none of them inspects (probe over roadmap_page_launch, claim_batch on
// this tree). That is the DESIGN section 3 tell exactly -- a claim dominated by one call whose result
// it does not inspect -- and the substrate's whole remedy is to SUPPLY the value instead of computing
// it. Every production caller below passes roadmap_css(), so the served page is unchanged.
fn roadmap_page_impl_with_stylesheet(doc: RoadmapDocument, merged: List<Int>, main_prefix: List<Fragment>, launch: LaunchHostStanding, stylesheet: SiteStyles) -> Fragment {
  let ctx = page_launch_context(doc: doc, merged: merged, launch: launch)
  let lead = map(doc.lead_lanes, s => section_markup(s: s, merged: merged, launch: ctx))
  let secs = map(doc.sections, s => section_markup(s: s, merged: merged, launch: ctx))
  let main_children = concat(main_prefix, concat(lead, secs))
  let body_base = [
    el_class("main", "roadmap", main_children),
  ]
  let body_children = if list_length(main_children) == 0 {
    body_base
  } else {
    concat(body_base, [ dispatch_client_script() ])
  }
  site_document(title: "gunbc — roadmap", heading: "roadmap", styles: stylesheet, content: body_children)
}

fn roadmap_page_impl(doc: RoadmapDocument, merged: List<Int>, main_prefix: List<Fragment>, launch: LaunchHostStanding) -> Fragment {
  roadmap_page_impl_with_stylesheet(doc: doc, merged: merged, main_prefix: main_prefix, launch: launch, stylesheet: roadmap_styles())
}

// The supplied-stylesheet seam a row claim renders through. It is the same page fold; only the head's
// style text is handed in. A claim that asserts on the stylesheet must use roadmap_page_launch.
fn roadmap_page_launch_with_stylesheet(doc: RoadmapDocument, merged: List<Int>, launch: LaunchHostStanding, stylesheet: SiteStyles) -> Fragment {
  roadmap_page_impl_with_stylesheet(doc: doc, merged: merged, main_prefix: [], launch: launch, stylesheet: stylesheet)
}

fn roadmap_page(doc: RoadmapDocument, merged: List<Int>) -> Fragment {
  roadmap_page_impl(doc: doc, merged: merged, main_prefix: [], launch: launch_host_unobserved_static_render())
}

fn roadmap_page_launch(doc: RoadmapDocument, merged: List<Int>, launch: LaunchHostStanding) -> Fragment {
  roadmap_page_impl(doc: doc, merged: merged, main_prefix: [], launch: launch)
}

// roadmap_page_for_doc exists so a claim about how a TICKET ROW renders can be written without a
// claim about which lanes are currently shown. witness_ticket_rows_render_structured asserts the
// row markup — disclosure mark, brief class, displaced-cost label, carrier href — and it happened
// to pick a node from a lane the focus later hid, so it went red having found nothing wrong with
// the rendering at all. Passing an unfocused document keeps that claim measuring markup.
// roadmap_page_for_authority keeps the declared focus, because the served page IS the focused view.

fn roadmap_page_for_doc(doc: RoadmapDocument) -> Fragment {
  roadmap_page_impl(
    doc: doc,
    merged: authored_merged_prs(),
    main_prefix: [
      dashboard_instance_banner(),
      finish_line_progress_markup(),
    ],
    launch: launch_host_unobserved_static_render(),
  )
}

fn roadmap_authority_refusal_markup(detail: String) -> Fragment {
  el_class("section", "roadmap-authority-refused", [
    el("h2", [ txt("roadmap unavailable") ]),
    el_class("p", "roadmap-authority-refused-detail", [
      txt(concat("acceptance history projection refused: ", detail)),
    ]),
  ])
}

// Which renders can offer a launch (RLM-1). The SERVED pages receive the host standing the serve
// handler observed through gunbc.roadmap_belt_actuate belt_launch_host_standing, so their rows
// project the same admission the route answers. Every other entry -- the static site, the
// surface-observation probe, a page rendered for a document fixture -- passes
// launch_host_unobserved_static_render, and every row refuses at the instance gate: there is no
// actuating instance behind those bytes, so a Launch there would be a claim the page cannot honor.

fn roadmap_page_for_authority() -> Fragment {
  roadmap_page_for_projection(proj: roadmap_authority_projection(history: roadmap_acceptance_event_history_load()))
}

fn roadmap_page_for_projection(proj: RoadmapAuthorityProjection) -> Fragment {
  roadmap_page_for_projection_launch(proj: proj, launch: launch_host_unobserved_static_render())
}

fn roadmap_page_for_projection_launch(proj: RoadmapAuthorityProjection, launch: LaunchHostStanding) -> Fragment {
  roadmap_page_for_projection_launch_with_stylesheet(proj: proj, launch: launch, stylesheet: roadmap_styles())
}

// The supplied-stylesheet seam of the served roadmap route: the projection's own page fold with only
// the head's style text handed in, so a claim about rows of a supplied projection does not pay for
// the stylesheet it never reads. roadmap_page_for_projection_launch passes roadmap_css().
fn roadmap_page_for_projection_launch_with_stylesheet(proj: RoadmapAuthorityProjection, launch: LaunchHostStanding, stylesheet: SiteStyles) -> Fragment {
  match proj {
    RoadmapAuthorityProjectionRefused { detail: detail } =>
      roadmap_page_impl_with_stylesheet(
        doc: RoadmapDocument { preamble: [], lead_lanes: [], sections: [] },
        merged: [],
        main_prefix: [
          dashboard_instance_banner(),
          roadmap_authority_refusal_markup(detail: detail),
        ],
        launch: launch,
        stylesheet: stylesheet,
      )
    RoadmapAuthorityProjected { doc: doc, accepted: accepted, withheld: _ } =>
      roadmap_page_impl_with_stylesheet(
        doc: doc,
        merged: authored_merged_prs(),
        main_prefix: [
          dashboard_instance_banner(),
          finish_line_progress_markup_for_accepted(accepted_ids: accepted),
        ],
        launch: launch,
        stylesheet: stylesheet,
      )
  }
}

// THE ACCEPTED SET IS SUPPLIED HERE TOO, AND THAT IS WHY THE LEAK HAS NO CONSTRUCTOR LEFT.
//
// These two entries used to reach roadmap_daily_workspace_page_impl, which read
// accepted_roadmap_node_ids_projection() itself. That fold was also the refusal arm of
// roadmap_daily_workspace_page_for_projection_observed, so a caller-supplied plan that failed to
// project rendered beside the PUBLIC accepted set (review 63317). Routing that one arm to the
// _for_accepted form closed the route, but left the ambient-reading fold standing -- and a probe
// cannot guard it: under the hermetic witness route the carrier read REFUSES and yields the same
// empty set, so the defect is invisible to any witness that could be enrolled (measured: the
// leak restored in an isolated worktree, the probe still PASSED). DESIGN 4b says a check whose RED
// is not authorable is not a weak wall but a decoration, and 5 says prefer construction over
// validation. So the fold is deleted rather than watched: nothing below the parameterized route
// can name the public accepted set any more, and these two get the empty one, which is what their
// own "the event carrier is not consulted" already claimed and did not deliver.

fn roadmap_daily_workspace_page(doc: RoadmapDocument, merged: List<Int>, memberships: List<RoadmapMembership> = roadmap_memberships()) -> Fragment {
  roadmap_daily_workspace_page_impl_for_accepted(doc: doc, merged: merged, accepted_ids: [], withheld: [], main_prefix: [], attempts: [], attempts_refused: none, standings: StandingsUnobserved { reason: "static render: the event carrier is not consulted" }, launch: launch_host_unobserved_static_render(), stale_nodes: [], profiles: [],
      memberships: memberships)
}

// The supplied-stylesheet seam a row or table claim renders through (the daily twin of
// roadmap_page_launch_with_stylesheet): the same page fold with only the head's style text handed in.
// A claim that asserts on the stylesheet itself reads roadmap_css or its rule blocks directly.
fn roadmap_daily_workspace_page_launch_with_stylesheet(doc: RoadmapDocument, merged: List<Int>, launch: LaunchHostStanding, memberships: List<RoadmapMembership>, stylesheet: SiteStyles) -> Fragment {
  roadmap_daily_workspace_page_impl_for_accepted_with_stylesheet(doc: doc, merged: merged, accepted_ids: [], withheld: [], main_prefix: [], attempts: [], attempts_refused: none, standings: StandingsUnobserved { reason: "static render: the event carrier is not consulted" }, launch: launch, stale_nodes: [], profiles: [],
      memberships: memberships, stylesheet: stylesheet)
}

fn roadmap_daily_workspace_page_launch(doc: RoadmapDocument, merged: List<Int>, launch: LaunchHostStanding, memberships: List<RoadmapMembership> = roadmap_memberships()) -> Fragment {
  roadmap_daily_workspace_page_impl_for_accepted(doc: doc, merged: merged, accepted_ids: [], withheld: [], main_prefix: [], attempts: [], attempts_refused: none, standings: StandingsUnobserved { reason: "static render: the event carrier is not consulted" }, launch: launch, stale_nodes: [], profiles: [],
      memberships: memberships)

}

// The served daily workspace consumes the OBSERVED attempt evidence at render (the tick decomposes the belt observation and passes progress rows or the located refusal), so the active band and every server-rendered activity region are real facts, not placeholders — the same decided views the /workflow.json wire carries, giving the client poll an identical starting DOM (the parity obligation's server half). The plan is a parameter because the caller that renders it is the caller that chose it. profiles is the read-once auth profile roster the tick passes down (gunbc.roadmap_served_observation); every non-belt entry passes the empty roster.
fn roadmap_daily_workspace_page_for_projection_observed(
  proj: RoadmapAuthorityProjection,
  attempts: List<WorkflowAttemptProgress>,
  attempts_refused: String?,
  standings: RoadmapStandings,
  launch: LaunchHostStanding,
 profiles: List<PrincipalProfile>,
  memberships: List<RoadmapMembership> = roadmap_memberships()) -> Fragment {
  roadmap_daily_workspace_page_for_projection_observed_stale(
    proj: proj,
    attempts: attempts,
    attempts_refused: attempts_refused,
    standings: standings,
    launch: launch,
    stale_nodes: [],
    profiles: profiles,
      memberships: memberships)
}

// THE STALE-AWARE ENTRY: the tick's observing authority (gunbc.roadmap_served_observation) reads
// each attempt's recorded launch identity and compares its revision against the deployed-tree head
// the launch host standing observed, passing the stale node ids decided by
// gunbc.roadmap_presentation.stale_attempt_nodes. A stale attempt keeps every typed fact — its
// activity arm, its evidence, its disclosure — and renders them dimmed (the node-attempt-stale
// class): evidence for a superseded question stays reachable and stops shouting. Every other entry
// supplies the empty set, so a static or plan-fixture render dims nothing it cannot compare.
fn roadmap_daily_workspace_page_for_projection_observed_stale(
  proj: RoadmapAuthorityProjection,
  attempts: List<WorkflowAttemptProgress>,
  attempts_refused: String?,
  standings: RoadmapStandings,
  launch: LaunchHostStanding,
  stale_nodes: List<String>,
 profiles: List<PrincipalProfile>,
  memberships: List<RoadmapMembership> = roadmap_memberships()) -> Fragment {
  roadmap_daily_workspace_page_for_projection_observed_stale_with_stylesheet(
    proj: proj, attempts: attempts, attempts_refused: attempts_refused, standings: standings, launch: launch,
    stale_nodes: stale_nodes, profiles: profiles, memberships: memberships, stylesheet: roadmap_styles())
}

// The supplied-stylesheet seam of the served daily route (the twin of
// roadmap_page_for_projection_launch_with_stylesheet): every served daily render reaches this fold,
// and only the head's style text is handed in.
fn roadmap_daily_workspace_page_for_projection_observed_stale_with_stylesheet(
  proj: RoadmapAuthorityProjection,
  attempts: List<WorkflowAttemptProgress>,
  attempts_refused: String?,
  standings: RoadmapStandings,
  launch: LaunchHostStanding,
  stale_nodes: List<String>,
  profiles: List<PrincipalProfile>,
  memberships: List<RoadmapMembership>,
  stylesheet: SiteStyles) -> Fragment {
  match proj {
    RoadmapAuthorityProjectionRefused { detail: detail } =>
      roadmap_daily_workspace_page_impl_for_accepted_with_stylesheet(
        doc: RoadmapDocument { preamble: [], lead_lanes: [], sections: [] },
        merged: [],
        accepted_ids: [],
        withheld: [],
        main_prefix: [
          roadmap_authority_refusal_markup(detail: detail),
        ],
        attempts: attempts,
        attempts_refused: attempts_refused,
        standings: standings,
        launch: launch,
        stale_nodes: stale_nodes,
        profiles: profiles,
        memberships: memberships,
        stylesheet: stylesheet)
    RoadmapAuthorityProjected { doc: doc, accepted: accepted, withheld: withheld } =>
      roadmap_daily_workspace_page_impl_for_accepted_with_stylesheet(
        doc: doc,
        merged: authored_merged_prs(),
        accepted_ids: accepted,
        withheld: withheld,
        main_prefix: [
        ],
        attempts: attempts,
        attempts_refused: attempts_refused,
        standings: standings,
        launch: launch,
        stale_nodes: stale_nodes,
        profiles: profiles,
        memberships: memberships,
        stylesheet: stylesheet)
  }
}

fn roadmap_daily_workspace_page_for_authority( memberships: List<RoadmapMembership> = roadmap_memberships()) -> Fragment {
  roadmap_daily_workspace_page_for_projection(proj: roadmap_authority_projection(history: roadmap_acceptance_event_history_load()), memberships: memberships)
}

fn roadmap_daily_workspace_page_for_projection(proj: RoadmapAuthorityProjection, memberships: List<RoadmapMembership> = roadmap_memberships()) -> Fragment {
  roadmap_daily_workspace_page_for_projection_observed(
    proj: proj,
    attempts: [],
    attempts_refused: none,
    standings: StandingsUnobserved { reason: "static render: the event carrier is not consulted" },
    launch: launch_host_unobserved_static_render(),
   profiles: [],
      memberships: memberships)

}

fn issue_rail_status_text(view: WorkRowView, events: List<RoadmapEventEnvelope>) -> String { issue_status_label(view: view) }
fn issue_status_node(view: WorkRowView, events: List<RoadmapEventEnvelope> = []) -> Fragment {
  let facts = issue_status_details(view: view)
  el_class("details", "issue-status-detail", [
    el("summary", [status_badge(label: issue_status_label(view: view))]),
    el_class("dl", "issue-status-facts", [
      el("dt", [txt("Planning")]), el("dd", concat([txt(facts.planning)], if count(events) == 0 { [] } else { [el("p", [txt(issue_standing_text(s: roadmap_node_standing(envs: events), profiles: view.profiles))])] })),
      el("dt", [txt("Current obligation")]), el("dd", [txt(if facts.obligation == "" { "No unsettled obligation" } else { facts.obligation })]),
      el("dt", [txt("Attempt")]), el("dd", [txt(facts.outcome)]),
      el("dt", [txt("Delivery evidence")]), el("dd", if count(facts.evidence) == 0 { [txt("No delivery evidence observed")] } else { map(facts.evidence, e => el("p", [txt(join([e.label, ": ", e.value], ""))])) }),
    ]),
  ])
}

// Profile disclosure is local UI. No click on this card issues a command.
fn issue_mention_fragment(f: Fragment, profiles: List<PrincipalProfile>) -> Fragment {
  match f {
    FragmentText { content: _ } => f
    RawNode { content: _ } => f
    Element { tag, attributes, children } =>
      let href = fold(attributes, init: "", f: (acc, a) => if a.name == "href" { a.value } else { acc })
      match principal_mention_read(uri: href) {
        Absent => Element { tag: tag, attributes: attributes, children: map(children, c => issue_mention_fragment(f: c, profiles: profiles)) }
        Present { value: principal } =>
          let p = EventPrincipalAuthenticated { ref: principal }
          let display = event_principal_display_with_profile(p: p, profiles: profiles)
          el_attrs("span", [attr(name: "class", value: "issue-mention"), attr(name: "tabindex", value: "0"), attr(name: "data-principal", value: principal_ref_label(p: principal))], concat(children, [
            el_class("span", "issue-profile-card", [
              issue_avatar_chip_node(display: display, workflow: event_principal_is_fabric(p: p)),
              el("strong", [txt(display.name)]), el("span", [txt(display.detail)]),
              el("small", [txt(if event_principal_is_fabric(p: p) { "Group · Fabric workflow" } else { "Person" })]),
            ]),
          ]))
      }
  }
}
fn issue_mention_option(p: PrincipalRef, profiles: List<PrincipalProfile>) -> Fragment {
  let principal = EventPrincipalAuthenticated { ref: p }
  let display = event_principal_display_with_profile(p: principal, profiles: profiles)
  el_attrs("button", [attr(name: "type", value: "button"), attr(name: "class", value: "site-choice-option"), attr(name: "data-mention-reference", value: principal_mention_markdown(principal: p, label: display.name)), attr(name: "role", value: "option"), attr(name: "aria-selected", value: "false")], [
    issue_avatar_chip_node(display: display, workflow: event_principal_is_fabric(p: principal)), txt(join([display.name, " · ", display.detail], "")),
  ])
}

fn issue_assign_selector(p: EventPrincipal, profiles: List<PrincipalProfile>) -> String {
  match p {
    EventPrincipalAuthenticated { ref } => if principal_ref_eq(a: ref, b: fabric_workflow_principal) { fabric_display_alias as String } else {
      match principal_profile_of(ref: ref, profiles: profiles) {
        Absent => ""
        Present { value: prof } => match prof.email { Absent => "" Present { value: email } => email as String }
      }
    }
    LegacyEmailPrincipal { email, authentication_unestablished: _ } => if string_contains(s: email as String, pattern: "@") { email as String } else { "" }
  }
}
