// review 44113. Building the spawn plan can FAIL, so the builder returns a sum rather than a record
// it might have to fake. The one failure today is the tmux pipe-pane payload: it is emitted through
// the bash backend, and a serializer refusal has no honest command to put in tmux_event_pipe.
// Answering with a placeholder would make an un-emittable intent indistinguishable from a
// serialized one at the dispatch site (DESIGN 5). The refusal names the step that could not be
// built, and the belt maps it onto the SpawnFailed carrier it already has, so a plan that cannot be
// built never becomes a plan that gets run.

type DispatchSpawnPlan
  = DispatchSpawnReady { commands: DispatchSpawnCommands }
  | DispatchSpawnRefused { step: NonEmptyStr, detail: String }

// THE SESSION CONTAINER IS A REALIZATION, NOT A FACT ABOUT DISPATCH, and this coproduct is where
// that stops being a claim in prose. A dispatched attempt needs four things from whatever holds its
// process: it must outlive the request that started it, its output must be captured, its liveness
// must be observable, and it must be killable. tmux supplies all four -- but the REASON it was
// chosen is that claude and codex are interactive terminal programs and need a pty, which is a fact
// about those two providers rather than about dispatch.
//
// The gunbc harness worker is `gunbc run`, a non-interactive batch process. For it tmux supplies
// nothing it needs and two things it cannot tolerate: tmux places every pane in its own transient
// scope (tmux-spawn-<uuid>.scope, memory.max=max), so the worker escapes the serving unit's cgroup
// and `gunbc run` REFUSES to plan -- HostBudgetUnreadable, measured on srv2-deploy -- and pane
// capture requires a shell-command payload, which extdeps.tmux's own annotation names as the one
// foreign-executor seam in attempt capture.
//
// A transient systemd unit supplies the same four properties with no pty, and supplies as ordinary
// unit properties the two things the tmux path had to invent or could not express: MemoryMax, which
// makes the budget enforceable BY CONSTRUCTION rather than by a check that fails, and Result plus
// ExecMainStatus, which is the terminal state that distinguishes a finished worker from a crashed
// or reaped one.
//
// The unit is named per ATTEMPT rather than per node, so two attempts on one node cannot collide --
// the failure the tmux path shows as `duplicate session`, where a dead pane blocks the next
// dispatch and nothing reaps it.
type DispatchSessionContainer
  = TmuxSessionContainer {
      spawn: HostExecArgv
      default_shell: HostExecArgv
      remain_on_exit: HostExecArgv
      event_pipe: HostExecArgv
      provider_start: HostExecArgv
    }
  | SystemdUnitContainer { plan: DispatchWorkerUnitPlan }

type DispatchSpawnCommands {
  worktree_add: HostExecArgv
  // THE PER-ATTEMPT GRANT OF THE WORKTREE'S PRIVATE GIT ENTRY, and the walk that proves it. They ride
  // in the same bundle as worktree_add so the spawn that creates the entry is the only spawn that can
  // grant it, and the actuator sequences them: add, grant, read back, and only then the unit start.
  // See dispatch_attempt_worker_git_entry_migration for what each command does and why the sticky bit
  // is deliberately absent here.
  worker_git_entry_grant: List<HostExecArgv>
  worker_git_entry_readback: HostExecArgv
  // THE CHECKOUT'S GRANT AND ITS PROOF (dispatch_attempt_worker_worktree_grant): empty for a service-user worker.
  worker_worktree_grant: List<HostExecArgv>
  attempt_state_prepare: List<HostExecArgv>
  attempt_current_pointer: HostExecArgv
  session_container: DispatchSessionContainer
}

// THE ORIGIN DECIDES TWO THINGS AND ONLY TWO: which ref the worktree branches from, and what leads
// the brief. A fresh start branches from the instance's base ref with the node brief alone; a
// continuation branches from the prior attempt's branch, so the committed work is already in the
// tree, and puts the verdict ahead of the brief. Nothing else about the spawn changes -- same
// harness, same confinement, same state layout -- which is what makes the second turn ordinary.
// THE ALIGNMENT GATE IS THE FIRST GATE, before destination, brief, or any command: the spawn
// fold consumes the ONE resolution the caller derived from gunbc.roadmap.roadmap_alignment, and an
// Unresolved chain refuses with zero commands — no worktree, no state, no session. The review
// finding this closes (2026-09-26): ambiguity and undeclared rows used to render prose telling
// the worker to "mention the drift" while execution proceeded; now the typed refusal IS the
// spawn answer, and the refusal reason names the fork or the row.
// THE PLAN IS FOR THE PREPARED LAUNCH'S ATTEMPT: the instance, node and key every path below is built
// from, and the executor whose argv it carries, are read from the one sealed value
// (gunbc.dispatch_attempt_launch PreparedAttemptLaunch), so the worktree, the state and the credential
// the child reads are one attempt's by construction.
fn dispatch_spawn_commands_for_launch(
  prepared: PreparedAttemptLaunch,
  session_uuid: String,
  origin: AttemptOrigin,
  resolution: AlignmentResolution,
) -> DispatchSpawnPlan {
  let attempt = prepared_attempt(prepared: prepared)
  let instance = attempt.instance
  let node = attempt.node
  let attempt_key = attempt.attempt_key
  let provider = prepared_attempt_provider(prepared: prepared)
  match resolution {
    AlignmentUnresolved { cause } =>
      DispatchSpawnRefused {
        step: "alignment" as NonEmptyStr,
        detail: alignment_refusal_reason(cause: cause),
      }
    AlignmentReady { chain, due_levels: _, rendered_prompt: _ } =>
  match node_dispatch_destination(node: node) {
    DispatchDestinationMissing { reason } =>
      DispatchSpawnRefused {
        step: "spawn-destination" as NonEmptyStr,
        detail: reason as String,
      }
    DispatchDestinationResolved { identity } =>
      if !destination_is_this_spawn_tree(identity: identity) {
        DispatchSpawnRefused {
          step: "spawn-destination" as NonEmptyStr,
          detail: destination_not_this_spawn_tree_reason(identity: identity) as String,
        }
      } else {
  let fields = dispatch_brief_fields_for_environment(
    node: node,
    environment: instance.execution_environment,
  )
  let brief = dispatch_brief_for_origin(node: node, fields: fields, origin: origin, resolution: resolution)
  let session_name = dispatch_tmux_session_name(node_id: node.node)
  let worktree_path = dispatch_worktree_path_for_instance(
    instance: instance,
    node_id: node.node,
    attempt_key: attempt_key,
  )
  let branch_name = dispatch_branch_name(node_id: node.node, attempt_key: attempt_key)
  match dispatch_provider_inner_argv_for_launch(
    prepared: prepared,
    session_uuid: session_uuid,
    worktree_path: worktree_path,
    brief: brief,
    alignment_chain_fingerprint: alignment_chain_fingerprint(chain: chain),
  ) {
    CursorProviderOffCustodyHost { reason } =>
      DispatchSpawnRefused {
        step: "cursor-credential-custody-host" as NonEmptyStr,
        detail: reason as String,
      }
    CodexProviderOffCustodyHost { reason } =>
      DispatchSpawnRefused {
        step: "codex-credential-custody-host" as NonEmptyStr,
        detail: reason as String,
      }
    CursorProviderCredentialUnbound { reason } =>
      DispatchSpawnRefused {
        step: "cursor-credential-binding" as NonEmptyStr,
        detail: reason as String,
      }
    CodexProviderExecutableAbsent { reason } =>
      DispatchSpawnRefused {
        step: "codex-executable-placement" as NonEmptyStr,
        detail: reason as String,
      }
    ClaudeProviderCredentialUnbound { reason } =>
      DispatchSpawnRefused {
        step: "claude-credential-binding" as NonEmptyStr,
        detail: reason as String,
      }
    DispatchProviderInnerArgvReady { argv: provider_inner } => {
  let worktree = git_worktree_add_argv_for_instance(
    instance: instance,
    worktree_path: worktree_path,
    branch_name: branch_name,
    remote_ref: attempt_origin_base_ref(origin: origin, instance_base_ref: instance.dispatch_base_ref as String),
  )
  let state_prepare = attempt_state_prepare_argvs_for_instance(
    instance: instance,
    node_id: node.node,
    attempt_key: attempt_key,
  )
  let events_path = attempt_state_text(instance: instance, node_id: node.node, attempt_key: attempt_key, member: AttemptWorkerEvents)
  match dispatch_session_container_for_provider(
    provider: provider,
    instance: instance,
    node_id: node.node,
    attempt_key: attempt_key,
    session_name: session_name,
    events_path: events_path,
    worker_log_path: attempt_state_text(instance: instance, node_id: node.node, attempt_key: attempt_key, member: AttemptWorkerLog),
    pane_working_directory: dispatch_pane_working_directory(
      provider: provider,
      instance: instance,
      worktree_path: worktree_path,
    ),
    worktree_path: worktree_path,
    provider_inner: provider_inner,
  ) {
    DispatchSessionContainerUnavailable { step: st, detail: d } =>
      DispatchSpawnRefused { step: st, detail: d }
    DispatchSessionContainerReady { container: c } =>
      DispatchSpawnReady {
        commands: DispatchSpawnCommands {
          worktree_add: worktree,
          worker_git_entry_grant: map(
            dispatch_attempt_worker_git_entry_migration(
              instance: instance,
              attempt_worktree: worktree_path,
              // THE PRODUCTION BINDING, AT THE SPAWN THAT RUNS THE GRANT: the declared group, the same
              // row the belt's readback gate compares the walk against below -- one declaration, both
              // halves of the grant-and-prove pair.
              group: fleet_posix_worker_shared_group_name,
            ),
            command => dispatch_git_owned_host_step_argv(command: command),
          ),
          worker_git_entry_readback: dispatch_git_owned_host_step_argv(
            command: dispatch_attempt_worker_git_entry_readback_command(
              instance: instance,
              attempt_worktree: worktree_path,
            ),
          ),
          worker_worktree_grant: map(
            dispatch_attempt_worker_worktree_grant(instance: instance, attempt_worktree: worktree_path, group: fleet_posix_worker_shared_group_name),
            command => dispatch_git_owned_host_step_argv(command: command),
          ),
          attempt_state_prepare: state_prepare,
          attempt_current_pointer: attempt_current_pointer_argv_for_instance(
            instance: instance,
            node_id: node.node,
            attempt_key: attempt_key,
          ),
          session_container: c,
        },
      }
  }
    }
  }
      }
  }
  }
}

fn filter_dispatch_tmux_sessions(entries: List<TmuxLsEntry>) -> List<TmuxLsEntry> {
  entries |> filter(e => starts_with(s: e.session_name, prefix: dispatch_tmux_session_prefix))
}

fn tmux_session_observation_for_scope(
  scope: TmuxSessionScope,
  entries: List<TmuxLsEntry>,
) -> TmuxSessionObservation {
  let scoped_name = scope.session_name as String
  let matched = entries |> filter(e => e.session_name == scoped_name)
  match matched.first() {
    Absent => SessionAbsent
    Present { value: e } =>
      SessionNameObserved {
        session_name: scope.session_name,
        windows: e.windows,
      }
  }
}

fn classify_tmux_session(
  scope: TmuxSessionScope,
  obs: TmuxSessionObservation,
) -> ObservationVerdict {
  match obs {
    SessionAbsent => Absent
    SessionInaccessible => Inaccessible
    SessionNameObserved {
      session_name: name,
      windows: _,
    } =>
      if (name as String) != (scope.session_name as String) {
        Inaccessible
      } else {
        UnknownRefused
      }
    SessionObserved {
      session_name: name,
      windows: _,
      process_fingerprint: fingerprint,
    } =>
      if (name as String) != (scope.session_name as String) {
        Inaccessible
      } else {
        if fingerprint == scope.expected_process_fingerprint {
          Converged
        } else {
          Conflict
        }
      }
    SessionObservedStaleExpected {
      session_name: name,
      windows: _,
      process_fingerprint: fingerprint,
      stale_reason: _,
    } =>
      if (name as String) != (scope.session_name as String) {
        Inaccessible
      } else {
        if fingerprint == scope.expected_process_fingerprint {
          Drifted
        } else {
          Conflict
        }
      }
  }
}

fn decision_for_dispatch_lease_verdict(
  verdict: ObservationVerdict,
) -> UpsertDecision<DispatchLeasePlan> {
  match verdict {
    Converged => Refuse { reason: "dispatch session already running for node" as NonEmptyStr }
    Absent => Apply { plan: SpawnSession }
    Drifted => Apply { plan: DrainStaleThenSpawn }
    Conflict => Refuse { reason: "foreign tmux session owns dispatch slot" as NonEmptyStr }
    Inaccessible => Refuse { reason: "tmux session inaccessible" as NonEmptyStr }
    UnknownRefused =>
      Refuse { reason: "dispatch session name occupied; process fingerprint unobserved" as NonEmptyStr }
  }
}

fn classify_dispatch_lease_upsert(
  scope: TmuxSessionScope,
  obs: TmuxSessionObservation,
) -> UpsertClassification<DispatchLeasePlan> {
  let verdict = classify_tmux_session(scope: scope, obs: obs)
  UpsertClassification {
    verdict: verdict,
    decision: decision_for_dispatch_lease_verdict(verdict: verdict),
  }
}

fn node_in_ready(node_id: RoadmapNodeId, ready: List<RoadmapNode>) -> Bool {
  any(ready, n => n.node == node_id)
}

fn dispatch_permitted_from_selection(
  instance: HostDashboardInstance,
  node: RoadmapNode,
  attempt_key: String,
  effort: ReasoningEffort,
  model: ProviderModelSelection,
) -> DispatchRequestGate {
  DispatchPermitted {
    session_name: dispatch_tmux_session_name(node_id: node.node),
    worktree_path: dispatch_worktree_path_for_instance(instance: instance, node_id: node.node, attempt_key: attempt_key),
    branch_name: dispatch_branch_name(node_id: node.node, attempt_key: attempt_key),
    brief: filled_dispatch_brief_for_node(instance: instance, node: node),
    reasoning_effort: effort,
    model: model,
  }
}

fn classify_dispatch_lease_after_destination(
  instance: HostDashboardInstance,
  node: RoadmapNode,
  tmux_entries: List<TmuxLsEntry>,
  attempt_key: String,
  process_fingerprint: NonEmptyStr,
  effort: ReasoningEffort,
  model: ProviderModelSelection,
) -> DispatchRequestGate {
  let scope = dispatch_tmux_session_scope_for_process_fingerprint(
    node_id: node.node,
    process_fingerprint: process_fingerprint,
  )
  let obs = tmux_session_observation_for_scope(scope: scope, entries: tmux_entries)
  match classify_dispatch_lease_upsert(scope: scope, obs: obs) {
    UpsertClassification { verdict: _, decision: Refuse { reason } } =>
      DispatchRefused { reason: reason }
    UpsertClassification { verdict: _, decision: Noop } =>
      DispatchRefused { reason: "dispatch session already running for node" as NonEmptyStr }
    UpsertClassification { verdict: _, decision: Apply { plan: _ } } =>
      dispatch_permitted_from_selection(
        instance: instance,
        node: node,
        attempt_key: attempt_key,
        effort: effort,
        model: model,
      )
  }
}

fn classify_dispatch_destination_gate(node: RoadmapNode) -> DispatchRequestGate? {
  match node_dispatch_destination(node: node) {
    DispatchDestinationMissing { reason } =>
      Present { value: DispatchRefused { reason: reason } }
    DispatchDestinationResolved { identity } =>
      if !destination_is_this_spawn_tree(identity: identity) {
        Present {
          value: DispatchRefused { reason: destination_not_this_spawn_tree_reason(identity: identity) },
        }
      } else {
        none
      }
  }
}

fn classify_dispatch_request_for_process_fingerprint(
  instance: HostDashboardInstance,
  node: RoadmapNode,
  ready: List<RoadmapNode>,
  tmux_entries: List<TmuxLsEntry>,
  attempt_key: String,
  process_fingerprint: NonEmptyStr,
  effort: ReasoningEffort,
  model: ProviderModelSelection,
) -> DispatchRequestGate {
  if !node_in_ready(node_id: node.node, ready: ready) {
    DispatchRefused { reason: "node not in ready frontier" as NonEmptyStr }
  } else {
    match classify_dispatch_destination_gate(node: node) {
      Present { value: refused } => refused
      Absent =>
        classify_dispatch_lease_after_destination(
          instance: instance,
          node: node,
          tmux_entries: tmux_entries,
          attempt_key: attempt_key,
          process_fingerprint: process_fingerprint,
          effort: effort,
          model: model,
        )
    }
  }
}

// THE SELECTION IS A PARAMETER, NOT AN EFFECT THIS CLASSIFIER PERFORMS. It used to call
// dispatch_actuator_selection itself, and since DCH-3 pointed that at the harness the call reached
// harness_observe_roster -> http.Client.Get, an operation with no mock_response. A classifier that
// performs I/O cannot be witnessed hermetically BY CONSTRUCTION, and that is exactly what happened:
// witness_projection_standing_refusal_specimen_holds could not reach its subject on the floor, and
// nothing noticed for six days because the changed-witness lane enrols only witnesses in CHANGED
// files and nothing had touched that file since.
//
// Carrying the selection rather than re-deriving it is the same move this module now makes for the
// model and already made for effort and the process fingerprint (DESIGN 2: carry, rewire or share
// the first value). It costs the caller nothing -- the one production shape already has a selection
// in hand -- and it makes the refusal-propagation arm testable with a constructed refusal instead of
// a live roster read. The alternative considered and rejected was giving http.Client.Get a
// fail-closed mock_response like its bounded siblings: one line, but it flips every Get consumer
// under the floor from "cannot run" to "runs and refuses", a corpus-wide change of meaning that this
// witness's repair has no business making.
fn classify_dispatch_request(
  instance: HostDashboardInstance,
  node: RoadmapNode,
  ready: List<RoadmapNode>,
  tmux_entries: List<TmuxLsEntry>,
  attempt_key: String,
  selection: DispatchActuatorSelection,
) -> DispatchRequestGate {
  if !node_in_ready(node_id: node.node, ready: ready) {
    DispatchRefused { reason: "node not in ready frontier" as NonEmptyStr }
  } else {
    match classify_dispatch_destination_gate(node: node) {
      Present { value: refused } => refused
      Absent =>
        match selection {
          DispatchActuatorSelectionRefused { reason } =>
            DispatchRefused { reason: reason }
          DispatchActuatorSelectionOk { provider: _, effort, model, process_fingerprint } =>
            classify_dispatch_lease_after_destination(
              instance: instance,
              node: node,
              tmux_entries: tmux_entries,
              attempt_key: attempt_key,
              process_fingerprint: process_fingerprint,
              effort: effort,
              model: model,
            )
        }
    }
  }
}

fn dispatch_node_id_from_session_name(session_name: String) -> String {
  if starts_with(s: session_name, prefix: dispatch_tmux_session_prefix) {
    substring(
      s: session_name,
      start: string_length(s: dispatch_tmux_session_prefix),
      end: string_length(s: session_name),
    )
  } else {
    ""
  }
}

fn dispatch_live_session_row_for_scope(
  entry: TmuxLsEntry,
  scope: TmuxSessionScope,
  instance: ProviderInstance,
) -> DispatchLiveSession {
  let obs = SessionNameObserved {
    session_name: entry.session_name as NonEmptyStr,
    windows: entry.windows,
  }
  DispatchLiveSession {
    session_name: entry.session_name,
    node_id: dispatch_node_id_from_session_name(session_name: entry.session_name),
    windows: entry.windows,
    lease_verdict: classify_tmux_session(scope: scope, obs: obs),
    worker: worker_observation_without_provider_probe(instance: instance),
  }
}

fn live_session_row(entry: TmuxLsEntry, scope: TmuxSessionScope) -> DispatchLiveSession? {
  match dispatch_worker_observation() {
    Present { value: worker } => {
      let obs = SessionNameObserved {
        session_name: entry.session_name as NonEmptyStr,
        windows: entry.windows,
      }
      Present {
        value: DispatchLiveSession {
          session_name: entry.session_name,
          node_id: dispatch_node_id_from_session_name(session_name: entry.session_name),
          windows: entry.windows,
          lease_verdict: classify_tmux_session(scope: scope, obs: obs),
          worker: worker,
        }
      }
    }
    none => none
  }
}

fn dispatch_tmux_session_scope_for_live_session(sess: DispatchLiveSession) -> TmuxSessionScope? {
  let node_id = sess.node_id as RoadmapNodeId
  match sess.worker.configured_provider.kind {
    CodexCliProvider =>
      match sess.worker.process {
        WorkerProcessRunning { command } =>
          Present {
            value: dispatch_tmux_session_scope_for_process_fingerprint(
              node_id: node_id,
              process_fingerprint: command as NonEmptyStr,
            ),
          }
        WorkerProcessExited { exit_code: _, last_command } =>
          Present {
            value: dispatch_tmux_session_scope_for_process_fingerprint(
              node_id: node_id,
              process_fingerprint: if last_command == "" {
                "retained-exit" as NonEmptyStr
              } else {
                last_command as NonEmptyStr
              },
            ),
          }
        WorkerProcessSignaled { signal: _, last_command } =>
          Present {
            value: dispatch_tmux_session_scope_for_process_fingerprint(
              node_id: node_id,
              process_fingerprint: if last_command == "" {
                "retained-signal" as NonEmptyStr
              } else {
                last_command as NonEmptyStr
              },
            ),
          }
        WorkerProcessUnobserved { reason: _ } => none
        WorkerProcessAbsent => none
      }
    ClaudeCliProvider =>
      Present {
        value: dispatch_tmux_session_scope_for_process_fingerprint(
          node_id: sess.node_id as RoadmapNodeId,
          process_fingerprint: dispatch_claude_process_fingerprint,
        ),
      }
    CursorCliProvider =>
      Present {
        value: dispatch_tmux_session_scope_for_process_fingerprint(
          node_id: sess.node_id as RoadmapNodeId,
          process_fingerprint: dispatch_cursor_process_fingerprint,
        ),
      }
  }
}

fn dispatch_session_cleanup_for_live_session(sess: DispatchLiveSession) -> DispatchSessionCleanup {
  match dispatch_tmux_session_scope_for_live_session(sess: sess) {
    Present { value: scope } => dispatch_session_cleanup(scope: scope, session: sess)
    Absent =>
      DispatchCleanupRefused {
        reason: "cleanup scope unavailable from session worker process evidence",
      }
  }
}

fn dispatch_live_session_for_entry(
  entry: TmuxLsEntry,
  selection: DispatchActuatorSelection,
) -> DispatchLiveSession? {
  let node_id = dispatch_node_id_from_session_name(session_name: entry.session_name)
  match dispatch_tmux_session_scope(node_id: node_id as RoadmapNodeId, selection: selection) {
    Present { value: scope } => live_session_row(entry: entry, scope: scope)
    Absent => none
  }
}

fn append_present_live_session(
  acc: List<DispatchLiveSession>,
  entry: TmuxLsEntry,
  selection: DispatchActuatorSelection,
) -> List<DispatchLiveSession> {
  match dispatch_live_session_for_entry(entry: entry, selection: selection) {
    Present { value: row } => concat(acc, [row])
    Absent => acc
  }
}

fn dispatch_live_sessions_from_entries(
  entries: List<TmuxLsEntry>,
  selection: DispatchActuatorSelection,
) -> List<DispatchLiveSession> {
  fold(
    filter_dispatch_tmux_sessions(entries: entries),
    init: [],
    f: fn(acc, e) { append_present_live_session(acc: acc, entry: e, selection: selection) },
  )
}

// U3 (result surfacing): the attempt branches ARE the results ledger — every spawn mints
// dispatch/<node>-a<key> (U1), so listing refs/heads/dispatch/ observes every attempt ever made,
// including pre-attempt-grain LEGACY branches (attempt_key empty — the operator's accidental
// ts-authority-converge spawn is one), which are real attempts and render as such, never filtered
// as noise. Parse discriminates by the LAST -a segment being exactly 16 chars (the content-hash key
// width); a node id that itself ends in -a<16 chars> would misparse — accepted and named, not
// papered over: node ids are roadmap-authored and none has that shape. Empty-node branches are
// rejected before constructing DispatchAttemptRef, whose node and branch are non-empty by
// construction; malformed debris cannot invalidate the whole attempts projection. v0 renders branch
// NAMES (copyable, true), never tree links that would be dead until a push — a dead link is a
// fabricated result; the PR half lands when push/PR state is observed, not guessed.

type DispatchAttemptRef {
  node_id: NonEmptyStr
  branch: NonEmptyStr
  attempt_key: String
}

fn dispatch_attempt_evidence(attempt: DispatchAttemptRef) -> AttemptEvidence {
  AttemptEvidence {
    node_id: attempt.node_id,
    attempt_key: attempt.attempt_key,
    branch: attempt.branch,
    worktree: WorktreeUnobserved {
      reason: "branch observation does not inspect the attempt worktree" as NonEmptyStr,
    },
    provider_instance: ProviderEvidenceUnobserved {
      reason: "branch observation does not identify the provider instance" as NonEmptyStr,
    },
    process_identity: ProcessIdentityUnobserved {
      reason: "branch observation does not inspect PID, start time, or ownership" as NonEmptyStr,
    },
    transcript: TranscriptUnobserved {
      reason: "branch observation does not locate a provider transcript" as NonEmptyStr,
    },
    terminal_outcome: TerminalOutcomeUnobserved {
      reason: "branch existence does not imply a terminal outcome" as NonEmptyStr,
    },
  }
}

fn parse_dispatch_attempt_branch(line: String) -> DispatchAttemptRef? {
  if string_contains(s: line, pattern: "dispatch/") {
    let rest = substring(s: line, start: 9, end: string_length(s: line))
    if rest == "" {
      none
    } else {
      let segs = split(s: rest, delimiter: "-a")
      let last = segs |> fold(init: "", f: (acc, x) => x)
      if count(segs) >= 2 && string_length(s: last) == 16 {
        let node_id = substring(s: rest, start: 0, end: string_length(s: rest) - 18)
        if node_id == "" {
          none
        } else {
          Present { value: DispatchAttemptRef {
            node_id: node_id as NonEmptyStr,
            branch: line as NonEmptyStr,
            attempt_key: last,
          } }
        }
      } else {
        Present { value: DispatchAttemptRef {
          node_id: rest as NonEmptyStr,
          branch: line as NonEmptyStr,
          attempt_key: "",
        } }
      }
    }
  } else {
    none
  }
}

fn dispatch_attempt_refs(git_output: String) -> List<DispatchAttemptRef> {
  fold(
    split(s: git_output, delimiter: "\n"),
    init: [],
    f: (acc, line) => match parse_dispatch_attempt_branch(line: line) {
      Present { value: r } => append(acc, [r])
      Absent => acc
    },
  )
}

fn git_for_each_ref_dispatch_argv() -> HostExecArgv {
  host_exec_argv(program: "git", args: ["for-each-ref", "--format=%(refname:short)", "refs/heads/dispatch/"])
}

fn git_for_each_ref_dispatch_argv_for_instance(
  instance: HostDashboardInstance,
) -> HostExecArgv {
  host_exec_argv(
    program: dispatch_capability_program(
      environment: instance.execution_environment,
      cap: GitWorkspaceCapability,
    ),
    args: ["for-each-ref", "--format=%(refname:short)", "refs/heads/dispatch/"],
  )
}

// R5 owned-only teardown, session grain: a live dispatch session is teardown-eligible (OUR process)
// ONLY when its lease verdict is Converged (running with our expected process fingerprint) or
// Drifted (our fingerprint, stale lease — reap-able stale-ours, matching
// decision_for_dispatch_lease_verdict's DrainStale). Conflict (foreign process), Inaccessible,
// UnknownRefused, Absent are NOT owned. Name-only tmux-ls observation yields
// UnknownRefused/Inaccessible only, so teardown FAIL-CLOSED-REFUSES until the observation carries a
// process fingerprint — correct R5 (no ownership proof, no reap). This owned-ness judgment lives
// HERE (the actuator owns lease/ownership classification, §3) as a Bool; gunbc.roadmap.roadmap_belt lifts
// the Bool into gunbc.ownership.Ownership for the reconcile teardown gate, so the belt never
// imports ObservationVerdict.

// U4 (stop from the UI): the pane read is the scaffold's declared dissolution — tmux list-panes -a
// with the cited format variables yields (session_name, pane_current_command) per pane, and
// pane_current_command IS the process-fingerprint evidence the lease classification was built to
// consume. The observation upgrade is total over its inputs: a session whose pane row is found
// observes as SessionObserved (fingerprint in hand — Converged only for the process fingerprint
// dispatch_actuator_selection resolved, Conflict for anything else wearing the name, e.g. a
// hand-made sleep); a session visible in ls but absent from the pane read stays SessionNameObserved
// (honest partial — UnknownRefused downstream, still no reap). The stop gate is the R5 table as a
// typed decision: owned stops; everything else refuses with the verdict's own reason, and refusing
// to kill what we cannot prove ours is the point, not a limitation.

type TmuxPaneEntry {
  session_name: String
  command: String
}

fn parse_tmux_pane_line(line: String) -> TmuxPaneEntry? {
  let segs = split(s: line, delimiter: " ")
  match segs.first() {
    Absent => none
    Present { value: name } =>
      if count(segs) >= 2 && name != "" {
        Present { value: TmuxPaneEntry {
          session_name: name,
          command: substring(s: line, start: string_length(s: name) + 1, end: string_length(s: line)),
        } }
      } else {
        none
      }
  }
}

fn parse_tmux_panes_output(output: String) -> List<TmuxPaneEntry> {
  fold(
    split(s: output, delimiter: "\n"),
    init: [],
    f: (acc, line) => match parse_tmux_pane_line(line: line) {
      Present { value: e } => append(acc, [e])
      Absent => acc
    },
  )
}

fn tmux_list_panes_argv() -> HostExecArgv {
  host_exec_argv(program: "tmux", args: shape_tmux_list_panes_argv())
}

fn tmux_list_panes_argv_for_instance(instance: HostDashboardInstance) -> HostExecArgv {
  host_exec_argv(
    program: dispatch_capability_program(
      environment: instance.execution_environment,
      cap: TmuxSessionCapability,
    ),
    args: shape_tmux_list_panes_argv_for(scope: instance.tmux_server),
  )
}

type DispatchSessionCleanup
  = DispatchStopRunningProcess { session_name: String }
  | DispatchClearRetainedSession {
      session_name: String,
      exit_code: Int,
    }
  | DispatchClearSignaledSession {
      session_name: String,
      signal: Int,
    }
  | DispatchCleanupRefused { reason: String }

fn dispatch_session_cleanup_action(
  cleanup: DispatchSessionCleanup,
) -> String {
  match cleanup {
    DispatchStopRunningProcess { session_name: _ } => "stop"
    DispatchClearRetainedSession { session_name: _, exit_code: _ } => "clear"
    DispatchClearSignaledSession { session_name: _, signal: _ } => "clear"
    DispatchCleanupRefused { reason: _ } => "unavailable"
  }
}

fn dispatch_session_cleanup_allowed(
  cleanup: DispatchSessionCleanup,
) -> Bool {
  match cleanup {
    DispatchStopRunningProcess { session_name: _ } => true
    DispatchClearRetainedSession { session_name: _, exit_code: _ } => true
    DispatchClearSignaledSession { session_name: _, signal: _ } => true
    DispatchCleanupRefused { reason: _ } => false
  }
}

fn dispatch_session_cleanup_detail(
  cleanup: DispatchSessionCleanup,
) -> String {
  match cleanup {
    DispatchStopRunningProcess { session_name: _ } =>
      "owned running provider process may be stopped"
    DispatchClearRetainedSession { session_name: _, exit_code } =>
      join([
        "provider process already exited ",
        to_string(exit_code),
        "; only retained tmux session metadata will be removed",
      ], "")
    DispatchClearSignaledSession { session_name: _, signal } =>
      join([
        "provider process already killed by ",
        linux_standard_signal_render(n: signal),
        "; only retained tmux session metadata will be removed",
      ], "")
    DispatchCleanupRefused { reason } => reason
  }
}

// Session presence, pane/process lifecycle, and cleanup authority are independent facts. A running
// process is stop-eligible only when its observed command matches the provider fingerprint. A dead
// remain-on-exit pane is clear-eligible from the exact dead/status observation because no live
// process can be killed; its last command is historical evidence and is never re-used as a running
// ownership fingerprint. A present session with an absent/refused pane observation remains
// cleanup-refused. The wire therefore says stop, clear, or unavailable mechanically from
// DispatchSessionCleanup instead of presenting every tmux container as a live agent.

// THE UNIT-BACKED ATTEMPT'S PROCESS EVIDENCE, answering the same question the pane answers for a
// tmux-backed one. The Agent obligation deliberately needs BOTH a terminal provider event and a
// compatible process exit -- provider_execution_reconcile_process refuses a turn.completed whose
// process exited nonzero as conflicting terminal evidence -- so emitting events was never going to
// be sufficient on its own. This is the second source, not a second opinion.
//
// LoadState IS READ FIRST AND IT IS THE ONLY HONEST ABSENCE. A unit the user manager never heard of
// answers ActiveState `inactive` with a successful exit, which is indistinguishable from a unit
// that ran and stopped -- so deciding absence from ActiveState would report every finished attempt
// as one that never started. `not-found` is the manager saying it has no such unit, and it is the
// only reading that means absent. That premise needs RemainAfterExit on the unit (see
// dispatch_worker_unit_properties): without it a unit that exited 0 IS collected and reads
// not-found, which is how every successful worker was read as never having run until 2026-09-05.
//
// SUBSTATE, NOT ACTIVESTATE, DECIDES RUNNING. With RemainAfterExit the unit stays ActiveState=active
// after its process has exited, so ActiveState cannot separate a working process from a finished
// one; SubState can -- `running` while the main process lives, `exited` once it has gone, `failed`
// or `dead` for the retained failure and the stopped unit. Every other SubState is a transition
// (start-pre, stop-sigterm, auto-restart) and counts as live, because a unit in transition has no
// final exit to report yet.
//
// A REFUSED READ IS NOT AN ABSENT UNIT. Every capture refusal maps to WorkerProcessUnobserved
// carrying its cause, never to WorkerProcessAbsent: "the manager says no such unit" and "I could
// not ask the manager" are different facts with different remedies, and collapsing them would let
// a broken transport read as a worker that never ran.
type AttemptUnitObservation
  = AttemptUnitAbsent
  | AttemptUnitActive
  | AttemptUnitFinished { exit_status: String }
  | AttemptUnitUnreadable { reason: String }

// THE READ IS A DIRECT SERVICE CALL, NOT A ROUTED HOST OPERATION, and the reason is the import
// graph rather than preference. gunbc.systemctl_show_read routes through gunbc.host.host_operation_exec,
// which depends on gunbc.host.host_effect, which reaches this module through
// live_deploy.candidate -> roadmap_belt -> roadmap_belt_actuate. Importing the routed read here is
// a cycle, and the acyclicity law is the one structural rule the import graph has. The transport
// indirection buys local-vs-ssh dispatch, which this observation does not need: the belt runs on
// the host whose units it is reading, so the local manager IS the subject.
fn attempt_unit_property(unit: NonEmptyStr, property: SystemdUnitProperty) -> AttemptUnitObservation {
  if starts_with(s: unit as String, prefix: "gunbc-attempt-") {
    let read = systemd.Systemctl.ShowProperty(unit: unit, property: systemd_unit_property_wire(property: property))
    if read.success {
      AttemptUnitFinished { exit_status: trim(read.value) }
    } else {
      AttemptUnitUnreadable {
        reason: join(["systemctl show refused for ", unit as String], ""),
      }
    }
  } else {
    let read = systemd.Systemctl.ShowUserProperty(unit: unit, property: systemd_unit_property_wire(property: property))
    if read.success {
      AttemptUnitFinished { exit_status: trim(read.value) }
    } else {
      AttemptUnitUnreadable {
        reason: join(["systemctl --user show refused for ", unit as String], ""),
      }
    }
  }
}

fn attempt_unit_observation(unit: NonEmptyStr) -> AttemptUnitObservation {
  match attempt_unit_property(unit: unit, property: LoadState) {
    AttemptUnitUnreadable { reason: why } => AttemptUnitUnreadable { reason: why }
    AttemptUnitAbsent => AttemptUnitAbsent
    AttemptUnitActive => AttemptUnitActive
    AttemptUnitFinished { exit_status: load } =>
      if load == "not-found" {
        AttemptUnitAbsent
      } else {
        match attempt_unit_property(unit: unit, property: SubState) {
          AttemptUnitUnreadable { reason: why } => AttemptUnitUnreadable { reason: why }
          AttemptUnitAbsent => AttemptUnitAbsent
          AttemptUnitActive => AttemptUnitActive
          AttemptUnitFinished { exit_status: sub } =>
            if attempt_unit_substate_has_exited(substate: sub) {
              attempt_unit_property(unit: unit, property: ExecMainStatus)
            } else {
              AttemptUnitActive
            }
        }
      }
  }
}

fn attempt_unit_substate_has_exited(substate: String) -> Bool {
  substate == "exited" || substate == "failed" || substate == "dead"
}

// THE WORKER UNIT'S OBSERVATION: the manager while the unit is loaded, the exit record once it is
// not. The worker unit no longer carries RemainAfterExit (dispatch_worker_unit_properties), so a
// worker that exited 0 is collected and the manager answers not-found; its stop hook wrote the exit
// record first (ExecStopPost runs before the unit leaves the manager), so a collected worker is read
// from that record, carrying the same status ExecMainStatus carried.
//
// A COLLECTED UNIT WITH NO RECORD IS NOT A WORKER THAT NEVER RAN (bold-bee-114, 2026-10-06, condition
// 1). Dispatch's own start receipt separates the two: the G5 placement record is written immediately
// before every worker unit is started (gunbc.roadmap.roadmap_belt_actuate belt_session_container_create), so
// an attempt with a placement record and no exit record had a unit that ended without its hook
// writing -- a failed hook, which is reported as indeterminate and located, never as absence
// (condition 2). Only an attempt with NO placement record answers absent: it never had a unit,
// which is the vendor (tmux) population and the attempt whose spawn never reached the unit start.
type AttemptUnitStartStanding
  = AttemptUnitStartRecorded
  | AttemptUnitNeverStarted
  | AttemptUnitStartUnread { reason: String }

// A SIGNALED WORKER IS READ AS systemd's ExecMainStatus READ IT: the signal number. That is the
// reading every consumer of WorkerProcessExited saw before this change, preserved exactly so no
// consumer's decision moves; the record keeps the distinction (AttemptProcessSignaled) and a
// signaled arm on WorkerProcessEvidence is the named follow-up
// (trigger: the next change to a WorkerProcessExited consumer's decision).
fn attempt_unit_from_exit_record(unit: NonEmptyStr, record: AttemptExitRecordObservation, start: AttemptUnitStartStanding) -> AttemptUnitObservation {
  match record {
    AttemptExitRecordUnreadable { reason } =>
      AttemptUnitUnreadable { reason: join(["unit ", unit as String, " is not loaded and its exit record could not be read: ", reason], "") }
    AttemptExitRecordFound { record: r } =>
      match r.end {
        AttemptProcessExitedWith { status } => AttemptUnitFinished { exit_status: to_string(value: status) }
        AttemptProcessSignaled { signal } => AttemptUnitFinished { exit_status: to_string(value: linux_standard_signal_number(signal: signal)) }
      }
    AttemptExitRecordNone =>
      match start {
        AttemptUnitNeverStarted => AttemptUnitAbsent
        AttemptUnitStartRecorded =>
          AttemptUnitUnreadable { reason: join(["unit ", unit as String, " was started under a placement grant and is no longer loaded, and it left no exit record: its ExecStopPost hook did not write (see the user journal for this unit)"], "") }
        AttemptUnitStartUnread { reason } =>
          AttemptUnitUnreadable { reason: join(["unit ", unit as String, " is not loaded and left no exit record, and whether it was started could not be read: ", reason], "") }
      }
  }
}

fn attempt_worker_unit_observation_of(unit: NonEmptyStr, loaded: AttemptUnitObservation, record: AttemptExitRecordObservation, start: AttemptUnitStartStanding) -> AttemptUnitObservation {
  match loaded {
    AttemptUnitAbsent => attempt_unit_from_exit_record(unit: unit, record: record, start: start)
    AttemptUnitActive => AttemptUnitActive
    AttemptUnitFinished { exit_status } => AttemptUnitFinished { exit_status: exit_status }
    AttemptUnitUnreadable { reason } => AttemptUnitUnreadable { reason: reason }
  }
}

fn worker_process_from_attempt_unit(
  observation: AttemptUnitObservation,
  unit: NonEmptyStr,
) -> WorkerProcessEvidence {
  match observation {
    AttemptUnitAbsent => WorkerProcessAbsent
    AttemptUnitActive => WorkerProcessRunning { command: unit }
    AttemptUnitFinished { exit_status: status } =>
      match parse_int(text: status) {
        Present { value: code } =>
          WorkerProcessExited { exit_code: code, last_command: unit as String }
        Absent =>
          WorkerProcessUnobserved {
            reason: join([
              "unit ", unit as String, " has stopped but ExecMainStatus did not parse as an exit code: ",
              status,
            ], "") as NonEmptyStr,
          }
      }
    AttemptUnitUnreadable { reason: why } =>
      WorkerProcessUnobserved {
        reason: join(["unit ", unit as String, " could not be read: ", why], "") as NonEmptyStr,
      }
  }
}

fn worker_process_from_attempt_pane(
  pane: TmuxAttemptPaneEntry,
) -> WorkerProcessEvidence {
  match pane.standing {
    TmuxAttemptPaneExited { status } =>
      WorkerProcessExited {
        exit_code: status,
        last_command: pane.command,
      }
    TmuxAttemptPaneSignaled { signal } =>
      WorkerProcessSignaled {
        signal: signal,
        last_command: pane.command,
      }
    TmuxAttemptPaneAlive =>
      if pane.command == "" {
        WorkerProcessUnobserved {
          reason: "running pane did not expose pane_current_command" as NonEmptyStr,
        }
      } else {
        WorkerProcessRunning { command: pane.command as NonEmptyStr }
      }
  }
}

fn worker_process_for_session(
  panes: List<TmuxAttemptPaneEntry>,
  session_name: String,
  pane_observation_refusal: String,
) -> WorkerProcessEvidence {
  if pane_observation_refusal != "" {
    WorkerProcessUnobserved {
      reason: pane_observation_refusal as NonEmptyStr,
    }
  } else {
    let matched = panes
      |> filter(pane => pane.session_name == session_name)
    match matched.first() {
      Present { value: pane } =>
        worker_process_from_attempt_pane(pane: pane)
      Absent =>
        WorkerProcessUnobserved {
          reason: "session was observed but no pane row was returned" as NonEmptyStr,
        }
    }
  }
}

fn live_session_row_with_process(
  entry: TmuxLsEntry,
  scope: TmuxSessionScope,
  process: WorkerProcessEvidence,
) -> DispatchLiveSession? {
  match dispatch_worker_observation_for_process(process: process) {
    Present { value: worker } => {
      let obs = match worker_process_observed_command(process: process) {
        Present { value: command } =>
          SessionObserved {
            session_name: entry.session_name as NonEmptyStr,
            windows: entry.windows,
            process_fingerprint: command,
          }
        none =>
          SessionNameObserved {
            session_name: entry.session_name as NonEmptyStr,
            windows: entry.windows,
          }
      }
      Present {
        value: DispatchLiveSession {
          session_name: entry.session_name,
          node_id: dispatch_node_id_from_session_name(session_name: entry.session_name),
          windows: entry.windows,
          lease_verdict: classify_tmux_session(scope: scope, obs: obs),
          worker: worker,
        }
      }
    }
    none => none
  }
}

// A node whose current attempt recorded the fingerprint its spawn selected (see
// the AttemptProcessFingerprint member) is judged against that record; a node
// with no record falls back to the default selection's scope, exactly as before the record existed.
type RecordedAttemptFingerprint {
  node_id: String
  fingerprint: NonEmptyStr
}

fn dispatch_tmux_session_scope_for_recorded(
  node_id: RoadmapNodeId,
  recorded: List<RecordedAttemptFingerprint>,
  selection: DispatchActuatorSelection,
) -> TmuxSessionScope? {
  match (recorded |> filter(r => r.node_id == node_id as String)).first() {
    Present { value: r } =>
      Present {
        value: dispatch_tmux_session_scope_for_process_fingerprint(node_id: node_id, process_fingerprint: r.fingerprint),
      }
    Absent => dispatch_tmux_session_scope(node_id: node_id, selection: selection)
  }
}

fn append_present_live_session_with_process(
  acc: List<DispatchLiveSession>,
  entry: TmuxLsEntry,
  panes: List<TmuxAttemptPaneEntry>,
  pane_observation_refusal: String,
  selection: DispatchActuatorSelection,
  recorded: List<RecordedAttemptFingerprint>,
) -> List<DispatchLiveSession> {
  let node_id = dispatch_node_id_from_session_name(session_name: entry.session_name)
  match dispatch_tmux_session_scope_for_recorded(node_id: node_id as RoadmapNodeId, recorded: recorded, selection: selection) {
    Present { value: scope } =>
      match live_session_row_with_process(
        entry: entry,
        scope: scope,
        process: worker_process_for_session(
          panes: panes,
          session_name: entry.session_name,
          pane_observation_refusal: pane_observation_refusal,
        ),
      ) {
        Present { value: row } => concat(acc, [row])
        Absent => acc
      }
    Absent => acc
  }
}

fn dispatch_live_sessions_with_process(
  entries: List<TmuxLsEntry>,
  panes: List<TmuxAttemptPaneEntry>,
  pane_observation_refusal: String,
  selection: DispatchActuatorSelection,
  recorded: List<RecordedAttemptFingerprint>,
) -> List<DispatchLiveSession> {
  fold(
    filter_dispatch_tmux_sessions(entries: entries),
    init: [],
    f: fn(acc, entry) {
      append_present_live_session_with_process(
        acc: acc,
        entry: entry,
        panes: panes,
        pane_observation_refusal: pane_observation_refusal,
        selection: selection,
        recorded: recorded,
      )
    },
  )
}

fn dispatch_session_cleanup(
  scope: TmuxSessionScope,
  session: DispatchLiveSession,
) -> DispatchSessionCleanup {
  if session.session_name != (scope.session_name as String) {
    DispatchCleanupRefused {
      reason: "tmux session name does not match the requested node",
    }
  } else {
    match session.worker.process {
      WorkerProcessRunning { command } =>
        if command == scope.expected_process_fingerprint {
          DispatchStopRunningProcess {
            session_name: session.session_name,
          }
        } else {
          DispatchCleanupRefused {
            reason: "a foreign running process wears the dispatch session name — refusing to kill what we cannot prove ours",
          }
        }
      WorkerProcessExited { exit_code, last_command: _ } =>
        DispatchClearRetainedSession {
          session_name: session.session_name,
          exit_code: exit_code,
        }
      WorkerProcessSignaled { signal, last_command: _ } =>
        DispatchClearSignaledSession {
          session_name: session.session_name,
          signal: signal,
        }
      WorkerProcessAbsent =>
        DispatchCleanupRefused {
          reason: "session is present but provider process is absent",
        }
      WorkerProcessUnobserved { reason } =>
        DispatchCleanupRefused {
          reason: join([
            "process lifecycle unobserved — no cleanup authority: ",
            reason as String,
          ], ""),
        }
    }
  }
}

fn tmux_attempt_panes_argv_for_instance(
  instance: HostDashboardInstance,
) -> HostExecArgv {
  host_exec_argv(
    program: dispatch_capability_program(
      environment: instance.execution_environment,
      cap: TmuxSessionCapability,
    ),
    args: shape_tmux_attempt_panes_argv_for(scope: instance.tmux_server),
  )
}

fn pane_command_for_session(panes: List<TmuxPaneEntry>, session_name: String) -> String {
  fold(panes, init: "", f: (acc, p) =>
    if acc == "" && p.session_name == session_name { p.command } else { acc })
}

fn tmux_session_observation_with_panes(
  scope: TmuxSessionScope,
  entries: List<TmuxLsEntry>,
  panes: List<TmuxPaneEntry>,
) -> TmuxSessionObservation {
  match tmux_session_observation_for_scope(scope: scope, entries: entries) {
    SessionNameObserved { session_name: name, windows: w } => {
      let cmd = pane_command_for_session(panes: panes, session_name: name as String)
      if cmd == "" {
        SessionNameObserved { session_name: name, windows: w }
      } else {
        SessionObserved { session_name: name, windows: w, process_fingerprint: cmd as NonEmptyStr }
      }
    }
    SessionAbsent => SessionAbsent
    SessionObserved { session_name: n2, windows: w2, process_fingerprint: f2 } =>
      SessionObserved { session_name: n2, windows: w2, process_fingerprint: f2 }
    SessionObservedStaleExpected { session_name: n3, windows: w3, process_fingerprint: f3, stale_reason: r3 } =>
      SessionObservedStaleExpected { session_name: n3, windows: w3, process_fingerprint: f3, stale_reason: r3 }
    SessionInaccessible => SessionInaccessible
  }
}

type DispatchStopGate
  = StopPermitted { session_name: String }
  | StopRefused { reason: String }

fn dispatch_stop_gate(scope: TmuxSessionScope, obs: TmuxSessionObservation) -> DispatchStopGate {
  match classify_tmux_session(scope: scope, obs: obs) {
    Converged => StopPermitted { session_name: scope.session_name as String }
    Drifted => StopPermitted { session_name: scope.session_name as String }
    Absent => StopRefused { reason: "no live session for this node" }
    Conflict => StopRefused { reason: "a foreign process wears the dispatch session name — refusing to kill what we cannot prove ours" }
    Inaccessible => StopRefused { reason: "tmux session inaccessible" }
    UnknownRefused => StopRefused { reason: "process fingerprint unobserved — no ownership proof, no reap" }
  }
}

fn dispatch_session_is_owned(session: DispatchLiveSession) -> Bool {
  match session.lease_verdict {
    Converged => true
    Drifted => true
    Absent => false
    Conflict => false
    Inaccessible => false
    UnknownRefused => false
  }
}

fn session_lease_reuses_process_port_classifier_shape() -> Bool {
  let port_scope = ProcessPortScope {
    listen_port: 8080,
    expected_owner_label: "gunbc-roadmap" as NonEmptyStr,
    expected_process_fingerprint: "node server.js" as NonEmptyStr,
  }
  match classify_process_port_upsert(
    scope: port_scope,
    obs: PortAbsent,
  ) {
    UpsertClassification { verdict: Absent, decision: Apply { plan: Start } } => true
    _ => false
  }
}

fn argv_contains_token(argv: List<String>, token: String) -> Bool {
  any(argv, a => a == token)
}

fn hostile_node_id_stays_single_argv_token(instance: HostDashboardInstance, node_id: String) -> Bool {
  let worktree_path = dispatch_worktree_path_for_instance(instance: instance, node_id: node_id, attempt_key: "feedfacefeedface")
  let branch_name = dispatch_branch_name(node_id: node_id, attempt_key: "feedfacefeedface")
  let worktree = git_worktree_add_argv(
    worktree_path: worktree_path,
    branch_name: branch_name,
    remote_ref: dispatch_git_remote_ref,
  ).args
  argv_contains_token(argv: worktree, token: worktree_path)
    && argv_contains_token(argv: worktree, token: branch_name)
    && !argv_contains_token(argv: worktree, token: "rm")
    && !argv_contains_token(argv: worktree, token: "-rf")
}
