data dispatch_tmux_process_fingerprint_observation_dissolution_trigger: Disposition = Terminal {
  reason: "DISSOLVED (U4, 2026-07-25): the pane-fingerprint observation landed — tmux list-panes with the cited format variables feeds tmux_session_observation_with_panes, so SessionObserved carries pane_current_command and the lease classification's Converged/Conflict arms are reachable by observation, not only by fixture. The R5 owned-only teardown gate (dispatch_stop_gate) is its first live consumer." as NonEmptyStr
}

data dispatch_git_remote_ref: String = gunbc_merge_target_ref as String
data dispatch_tmux_session_prefix: String = "gunbc-dispatch-"
// NAMED FINDING (U4 live drive, macOS, 2026-07-25): pane_current_command is the kernel process name
// (p_comm) — symlinks resolve and exec -a cannot fake it, which is exactly the anti-spoof property
// R5 wants — BUT a REAL running claude CLI on this macOS reported its VERSION STRING (2.1.220) as
// p_comm, not claude (node process.title). So the Converged green path may not fire on real workers
// until the fingerprint a real srv1 spawned session reports is READ, not guessed. The refuse arms
// are unaffected (they are the safety half and were proven live four ways). DECIDE-BY-RECEIPT: run
// tmux list-panes on srv1 beside a live dispatch session; if it reports claude this row stands; if
// it reports a version-or-node name, this row becomes the observed value (or an accepted set) — a
// data edit, never a code change.

// Provider choice is resolved by gunbc.dispatch_selection from a per-instance inventory, not a
// host-wide constant. dispatch_actuator_selection projects the srv1-live Automatic selection for
// the callers that carry no instance; instance-aware dispatch uses dispatch_selection_for_instance.
// Production Codex inventory standing is declared-unobserved at selection time; wet probe-derived
// standing is reserved for dashboard readiness
// (dispatch_production_standing_unobserved_refusal_note). Each DispatchCliProvider variant owns
// argv, preflight, and expected pane fingerprint together at this call site.

fn provider_kind_to_dispatch_cli(kind: ProviderKind) -> DispatchCliProvider {
  match kind {
    ClaudeCliProvider => ClaudeCodeProvider
    extdeps.llm.cli_lifecycle.CodexCliProvider => CodexDispatchProvider
    extdeps.llm.cli_lifecycle.CursorCliProvider => CursorDispatchProvider
  }
}

// THE HARNESS HAS NO ProviderKind, AND THAT IS THE ANSWER RATHER THAN A GAP TO FILL.
//
// This map used to be a total bijection because every executor was a vendor. It no longer is, and
// the honest return is a coproduct: asking "which external vendor kind is the gunbc harness" has no
// answer, and inventing one -- reusing CodexCliProvider, minting a fourth kind in extdeps -- would
// put the harness into the credential, entitlement and rate-limit machinery it has none of, where
// every one of those facts would have to be fabricated to get a verdict.
type DispatchProviderKindForCli
  = DispatchProviderKindIs { kind: ProviderKind }
  | DispatchExecutorHasNoVendorKind { executor: String }

fn dispatch_cli_to_provider_kind(provider: DispatchCliProvider) -> DispatchProviderKindForCli {
  match provider {
    ClaudeCodeProvider => DispatchProviderKindIs { kind: ClaudeCliProvider }
    CodexDispatchProvider => DispatchProviderKindIs { kind: extdeps.llm.cli_lifecycle.CodexCliProvider }
    CursorDispatchProvider => DispatchProviderKindIs { kind: extdeps.llm.cli_lifecycle.CursorCliProvider }
    GunbcHarnessProvider =>
      DispatchExecutorHasNoVendorKind {
        executor: "gunbc-harness: a local harness process against a local inference backend, with no vendor account, entitlement or rate limit for a ProviderKind to name",
      }
  }
}

// THE MODEL IS A REQUIRED FIELD OF THIS ARM, and that is the whole wall for the second spawn route.
// review 62268 found the first cut of this change threaded a model into the argv rows but not into
// this carrier, so gunbc.roadmap.roadmap_belt_actuate belt_resolved_spawn_plan -- the OTHER caller of
// the spawn plan (now dispatch_spawn_commands_for_launch) -- had no model to supply; CI agreed, refusing at
// belt_resolved_spawn_plan with `missing required argument model`. Passing
// ProviderAccountDefaultModel there to make it compile would have been the absorbing fallback
// DESIGN section 5 names: a silent widen that reports the account default for a selection that
// resolved something else, which is precisely the class this change exists to close.
//
// Because the field is required and has no default, no construction of this arm can omit a model:
// the belt route and the dispatch route both carry one or neither compiles. That is why there is no
// belt-path witness for the drop -- the RED is not authorable, so a check here would be the
// permanently-green decoration section 4b warns against rather than a wall. The argv-grain red
// stays enrolled below, where the forbidden state IS writable.
//
// THIS CARRIER NAMES NO ATTEMPT AND HOLDS NO CREDENTIAL. Its callers without an attempt -- the
// provider label, the process fingerprint, the tmux scope, the preflight fact -- ask only who would
// execute; an attempt that is being launched is selected through DispatchAttemptSelection below.
type DispatchActuatorSelection
  = DispatchActuatorSelectionOk {
      provider: DispatchCliProvider
      effort: ReasoningEffort
      model: ProviderModelSelection
      process_fingerprint: NonEmptyStr
    }
  | DispatchActuatorSelectionRefused { reason: NonEmptyStr }

// AN ATTEMPT BEING LAUNCHED IS SELECTED INTO A SEALED PREPARED LAUNCH (gunbc.dispatch_attempt_launch
// PreparedAttemptLaunch): the executor is the launch's, never a second field, and the selection
// receipt contributes only what it alone resolved -- effort, model and the process fingerprint.
fn snapshot_executor_provider(executor: SnapshotExecutor) -> DispatchCliProvider {
  match executor {
    ClaudeFromSnapshot => ClaudeCodeProvider
    CursorFromSnapshot => CursorDispatchProvider
  }
}

fn snapshot_free_executor_provider(executor: SnapshotFreeExecutor) -> DispatchCliProvider {
  match executor {
    CodexWithoutSnapshot => CodexDispatchProvider
    HarnessWithoutSnapshot => GunbcHarnessProvider
  }
}

fn attempt_launch_provider(launch: AttemptLaunch) -> DispatchCliProvider {
  match launch {
    SnapshotFreeLaunch { attempt: _, executor } => snapshot_free_executor_provider(executor: executor)
    SnapshotLaunch { snapshot } => snapshot_executor_provider(executor: taken_credential_snapshot_executor(snapshot: snapshot))
  }
}

fn prepared_attempt_provider(prepared: PreparedAttemptLaunch) -> DispatchCliProvider {
  attempt_launch_provider(launch: prepared_attempt_launch_alternative(prepared: prepared))
}

type DispatchAttemptSelection
  = DispatchAttemptPrepared { prepared: PreparedAttemptLaunch }
  | DispatchAttemptSelectionRefused { reason: NonEmptyStr }

// The one preparation producer the mint admits: the requested attempt, the selection that answered,
// and the launch preparation built for it. Two independent inputs meet here and are joined once: the
// executor the selection resolved must be the executor the launch prepared (a draw that took the wrong
// executor's snapshot refuses rather than launching under the receipt's name), and the launch's attempt
// must be the requested one (prepare_attempt_launch).
fn attempt_selection_launching(
  requested: DispatchAttempt,
  selection: DispatchActuatorSelection,
  launch: AttemptLaunch,
) -> DispatchAttemptSelection {
  match selection {
    DispatchActuatorSelectionOk { provider, effort, model, process_fingerprint } =>
      if dispatch_provider_label(provider: provider) != dispatch_provider_label(provider: attempt_launch_provider(launch: launch)) {
        DispatchAttemptSelectionRefused {
          reason: join([
            "the selection resolved ", dispatch_provider_label(provider: provider), " but the launch was prepared for ",
            dispatch_provider_label(provider: attempt_launch_provider(launch: launch)), "; refusing rather than launching one executor under another's selection",
          ], "") as NonEmptyStr,
        }
      } else {
        match prepare_attempt_launch(requested: requested, launch: launch, effort: effort, model: model, process_fingerprint: process_fingerprint) {
          AttemptLaunchPrepared { prepared } => DispatchAttemptPrepared { prepared: prepared }
          AttemptLaunchForAnotherAttempt { reason } => DispatchAttemptSelectionRefused { reason: reason }
        }
      }
    DispatchActuatorSelectionRefused { reason } => DispatchAttemptSelectionRefused { reason: reason }
  }
}

// The actuator's sole projection of gunbc.dispatch_selection for legacy call sites. Refusal
// propagates typed — no Codex substitute, no ReasoningMedium default, no actuator-local process
// fingerprint (DESIGN §5; review 47676). Process fingerprints are consumed from the selection
// kernel via resolved_process_fingerprint, never re-declared here (DESIGN §3).

// THE HARNESS IS THE DEFAULT SELECTION (DCH-3, operator direction 2026-09-02: the dedicated harness
// is to be the only and default harness). Two things about the shape of this are deliberate.
//
// IT REFUSES RATHER THAN FALLING BACK. When the backend is not serving, this returns the harness's
// own typed cause and stops. Reaching for a vendor would be the absorbing fallback DESIGN section 5
// names -- a degradation wearing the fail-closed label -- and it would also be a fiction today,
// because vendor selection cannot resolve at all: every declared offer is built with an unobserved
// standing and eligibility requires an observed one. There is no fallback to lose.
//
// THE EFFORT AXIS IS NOT THE HARNESS'S. ReasoningEffort is a vendor CLI's knob and the harness has
// no equivalent; a value is supplied here only because DispatchActuatorSelection carries the field
// for the three vendor arms. It is stated as the neutral middle rather than derived, and the honest
// reading is that this field does not apply to this executor. Removing it from the tuple is DCH-4's
// work, when the vendor arms that need it are deleted -- doing it now would be a wide refactor of a
// type whose other consumers still require the field.
data harness_selection_process_fingerprint: NonEmptyStr = "gunbc" as NonEmptyStr

// THE PIN IS GONE BECAUSE THE EVENT IT WAS WAITING FOR HAPPENED. This field pinned the one model the
// roster observed, and the annotation standing here said in as many words that when the harness grew
// per-route model identity, that identity would replace the single constant. It has: the harness now
// binds its model from the route that grants the seat, so before placement there is no single
// identity to report, and reporting one route's would be a claim about where the turn will land that
// this function does not make.
//
// SO THE ARM IS THE ACCOUNT DEFAULT, WHICH IS THE ONE THAT IS TRUE. On the three vendor arms, model
// is what will be SENT to the process -- it becomes --model on the argv, or it is the default and no
// flag is passed. The harness worker is this repository's own binary and has no --model flag at all,
// so "no flag" was always the accurate transmission answer and the pin was only ever a report. What
// is lost with it is a REPORT, not an instruction, and the report now lives where it is observed:
// gunbc.harness.harness_backend's roster carries one model per serving route.
fn dispatch_harness_selection() -> DispatchActuatorSelection {
  match harness_observe_roster() {
    HarnessRosterServing { serving: _, declined: _, unresolved: _ } =>
      DispatchActuatorSelectionOk {
        provider: GunbcHarnessProvider,
        effort: ReasoningMedium,
        model: ProviderAccountDefaultModel,
        process_fingerprint: harness_selection_process_fingerprint,
      }
    HarnessRosterNoneServing { declined, unresolved } =>
      DispatchActuatorSelectionRefused {
        reason: join(["no enrolled serving route advertises a model the harness is admitted to ask: ", harness_declines_detail(declined: declined, unresolved: unresolved)], "") as NonEmptyStr,
      }
  }
}

// WHAT THESE SELECTORS TAKE IS AN EXPECTATION, NOT A SIZE. The parameter used to be a hand-authored
// NodeSizing read off the roadmap node; it is now gunbc.dispatch_selection
// SizingProfileExpectation, which a caller with a task derives from that task and a caller without
// one (a harness probe) states as absent. The harness arm ignores it for the same reason it always
// did -- there is one harness and nothing to choose -- and says so here rather than leaving a silent
// unused parameter.
fn dispatch_actuator_selection(sizing_expectation: SizingProfileExpectation) -> DispatchActuatorSelection {
  dispatch_harness_selection()
}

fn dispatch_actuator_vendor_selection(
  instance: HostDashboardInstance,
  sizing_expectation: SizingProfileExpectation,
) -> DispatchActuatorSelection {
  match dispatch_selection_for_instance(
    instance: instance,
    request: default_provider_selection_request(),
    sizing_expectation: sizing_expectation,
  ) {
    DispatchSelectionResolved { receipt } =>
      DispatchActuatorSelectionOk {
        provider: provider_kind_to_dispatch_cli(kind: receipt.provider_kind),
        effort: receipt.applied_effort,
        model: resolved_model_selection(resolved: receipt.resolved_selection),
        process_fingerprint: resolved_process_fingerprint(resolved: receipt.resolved_selection),
      }
    DispatchSelectionRefused { sizing_expectation: _, requested_selection: _, reason } =>
      DispatchActuatorSelectionRefused { reason: reason }
  }
}

// ASKING THE VENDOR SELECTOR FOR A NON-VENDOR EXECUTOR REFUSES. This function's entire body is the
// vendor machinery -- inventory, entitlement, limit buckets -- and the harness has none of the
// facts it reads. Routing the harness through it would require inventing an account and a quota to
// get a verdict, so the executor without a vendor kind refuses here and is selected by its own
// path instead.
//
// THE SELECTION IS JUDGED ON THE INSTANCE BEING DISPATCHED ON (side-chat finding, 2026-10-05). There
// is no form that names an instance for its caller: a dispatch passes the one it carries, so a srv2
// request sees srv2's offers rather than refusing against srv1's.
fn dispatch_actuator_selection_for_provider_on(
  instance: HostDashboardInstance,
  provider: DispatchCliProvider,
  sizing_expectation: SizingProfileExpectation,
) -> DispatchActuatorSelection {
  match dispatch_cli_to_provider_kind(provider: provider) {
    DispatchExecutorHasNoVendorKind { executor: e } =>
      DispatchActuatorSelectionRefused {
        reason: join([
          "vendor provider selection was asked for a non-vendor executor (", e,
          "); it has no inventory row, entitlement or limit bucket to select over",
        ], "") as NonEmptyStr,
      }
    DispatchProviderKindIs { kind: vendor_kind } =>
  match dispatch_selection_for_instance(
    instance: instance,
    request: provider_selection_request_for_kind(
      kind: vendor_kind,
    ),
    sizing_expectation: sizing_expectation,
  ) {
    DispatchSelectionResolved { receipt } =>
      DispatchActuatorSelectionOk {
        provider: provider_kind_to_dispatch_cli(kind: receipt.provider_kind),
        effort: receipt.applied_effort,
        model: resolved_model_selection(resolved: receipt.resolved_selection),
        process_fingerprint: resolved_process_fingerprint(resolved: receipt.resolved_selection),
      }
    DispatchSelectionRefused { sizing_expectation: _, requested_selection: _, reason } =>
      DispatchActuatorSelectionRefused { reason: reason }
  }
  }
}

// THE OPERATOR NAMES THE EXECUTOR, OR THE DEFAULT STANDS (operator ruling via swift-ibex-601,
// 2026-10-05). Belt dispatch selects the harness unconditionally (dispatch_actuator_selection);
// the vendor selector above had no production caller, so no dispatched attempt could reach a vendor
// CLI. An explicit request is the smallest honest door: it names one vendor, routes through the
// SAME dispatch_actuator_selection_for_provider every vendor arm already answers through, and
// inherits its refusals -- an offer that is absent, or whose standing (credential, entitlement,
// per-window usage limits) does not admit the draw, refuses typed, and is never replaced by the
// harness. Absence of a request is ExecutorDefault, never a vendor.
//
// DECLARED FRONTIER, NOT CODE: automatic selection between the harness and a vendor is a std.decision
// select_realization over funded axes (cost, usage-window headroom, latency, quality). Its trigger is
// a grounded funded-axis policy once limit, latency and quality readings exist for at least two
// providers; until then nothing here chooses on the operator's behalf. A harness refusal therefore
// stays a refusal. Headless Claude is reached by `?executor=claude`, not by widening the default.
type DispatchExecutorRequest
  = ExecutorDefault
  | ExecutorVendor { provider: DispatchCliProvider }

type DispatchExecutorRequestDecode
  = DispatchExecutorRequestDecoded { request: DispatchExecutorRequest }
  | DispatchExecutorRequestUnknown { word: String, known: List<String> }

data dispatch_vendor_executor_roster: List<DispatchCliProvider> = [ClaudeCodeProvider, CodexDispatchProvider, CursorDispatchProvider]

// The wire word is dispatch_provider_label, the label the belt already reports a provider under, so
// a request and a report spell one provider one way. The empty word is no request. The harness label
// is the default executor named explicitly, not a vendor. Any other word is a typed refusal naming
// the accepted set -- never the default, which would run a turn somewhere the operator did not ask.
fn decode_dispatch_executor_request(word: String) -> DispatchExecutorRequestDecode {
  if word == "" || word == dispatch_provider_label(provider: GunbcHarnessProvider) {
    DispatchExecutorRequestDecoded { request: ExecutorDefault }
  } else {
    fold(
      dispatch_vendor_executor_roster,
      init: DispatchExecutorRequestUnknown {
        word: word,
        known: concat(
          [dispatch_provider_label(provider: GunbcHarnessProvider)],
          map(dispatch_vendor_executor_roster, p => dispatch_provider_label(provider: p)),
        ),
      },
      f: (acc, p) =>
        if dispatch_provider_label(provider: p) == word {
          DispatchExecutorRequestDecoded { request: ExecutorVendor { provider: p } }
        } else {
          acc
        },
    )
  }
}

// ONE CREDENTIAL SNAPSHOT PER ATTEMPT, FROM ADMISSION TO CHILD LOAD (side-chat finding, 2026-10-05).
// The custody file is mutable: a custody converge can replace version A with B at any moment. If the
// standing trip read the custody file and the spawn read it again, a replacement between the two
// would run B under A's admission. So the attempt copies the custody bytes ONCE, owner-only, to a path
// derived from the attempt identity (instance, node, attempt key, provider); the standing trip reads
// that snapshot and keeps it, and the spawned child reads the SAME snapshot and the shell removes it
// before exec. A replacement after the copy cannot reach the child, and a missing snapshot exits 78
// before the provider starts -- the launch refuses; it never falls back to the custody file.
// THE SELECTION IS THE TAKE'S ONLY PRODUCTION CALLER, AND THE LAUNCH READS ITS ATTEMPT FROM WHAT IT
// TOOK. A path re-derived at the spawn names the file whether or not any take wrote it, which is what
// an instance-less spawn route here once launched against; and a snapshot checked against an attempt
// supplied beside it is a comparison every launch leg had to remember. So the take is given the
// attempt the belt requested, the sealed value carries it (gunbc.dispatch_credential_snapshot
// TakenCredentialSnapshot), the prepared launch is minted only when that attempt is the requested one
// (gunbc.dispatch_attempt_launch prepare_attempt_launch), and the launch reads its attempt from it.
// The path here is where the production take writes, derived from that same attempt.
fn dispatch_credential_snapshot_path_for_attempt(attempt: DispatchAttempt, executor: SnapshotExecutor) -> NonEmptyStr {
  join([
    dashboard_instance_dispatch_attempt_state_root(instance: attempt.instance) as String,
    "/", attempt.node.node as String, "-a", attempt.attempt_key, ".",
    dispatch_provider_label(provider: snapshot_executor_provider(executor: executor)), "-credential",
  ], "") as NonEmptyStr
}

// A selection that refuses after its take discards the snapshot it took; a discard that does not
// occupy it with a tombstone is appended to the refusal, never dropped.
fn selection_refused_discarding(reason: NonEmptyStr, snapshot: TakenCredentialSnapshot) -> DispatchAttemptSelection {
  match credential_discard_taken_attempt(snapshot: snapshot) {
    CredentialSnapshotTombstoned => DispatchAttemptSelectionRefused { reason: reason }
    CredentialSnapshotTombstoneFailed { reason: failed } =>
      DispatchAttemptSelectionRefused { reason: join([reason as String, "; and ", failed as String], "") as NonEmptyStr }
  }
}

// THE EXPLICIT CLAUDE DRAW OBSERVES BEFORE IT SELECTS. The declared Claude row's standing admits no
// draw, so selection over it would always refuse; this snapshots the credential, runs the standing
// trip under that snapshot, projects the CLI's own report (gunbc.claude_code_limit_standing),
// substitutes it into the declared row of THIS instance's inventory, and selects. An exhausted usage
// window, a rejected token or an unreadable trip refuses the dispatch typed, naming why -- it never
// falls back to the harness, never spawns a turn that would fail for a reason already known, and
// discards the snapshot it took. The trip runs only here, on an operator's explicit request.
//
// The tool environment is supplied as Ready because this is reached only after the spawn's
// environment admission (belt_actuate_spawn_for_instance EnvironmentAdmitted); the trip itself does
// not observe the worktree.
data claude_code_standing_trip_fact_id: RecordedFactId = "claude-code-standing-trip" as RecordedFactId

fn claude_standing_trip_command(path: NonEmptyStr) -> ClaudeCodeEnvWrapping {
  claude_code_oauth_env_wrapped_command(
    token_path: path,
    argv: concat(
      [claude_cli_program],
      concat(claude_code_stream_json_print_args, ["--max-turns", "1", claude_code_standing_trip_prompt]),
    ),
    disposition: PosixShKeepFile,
  )
}

// THE TRIP BORROWS THE SNAPSHOT: it reads the sealed value the take returned and keeps the file for the
// launch (PosixShKeepFile), and the instance whose offer it observes is the snapshot's own attempt's.
fn claude_observed_standing_from_snapshot(snapshot: TakenCredentialSnapshot) -> ProviderStanding {
  let path = taken_credential_snapshot_path(snapshot: snapshot)
  match claude_standing_trip_command(path: path) {
    ClaudeCodeEnvWrapRefused { reason } => ProviderStandingUnobserved { reason: reason }
    ClaudeCodeEnvWrapped { command } => {
      let run = run_shell_command_observe(command: command, transport: LocalExec)
      if run.exit_code == posix_sh_export_from_file_unreadable_exit {
        ProviderStandingUnobserved {
          reason: join(["the claude credential snapshot ", path as String, " is unreadable: ", run.stderr], "") as NonEmptyStr,
        }
      } else {
        match claude_code_standing_from_trip(
          credential_label: claude_code_harness_credential_label,
          stdout: run.stdout,
          tool_environment: ToolEnvironmentReady,
        ) {
          ClaudeCodeStandingUnreadable { line_index, gap: _ } =>
            ProviderStandingUnobserved {
              reason: join(["the claude standing trip wrote an unreadable stream-json line at index ", to_string(value: line_index)], "") as NonEmptyStr,
            }
          ClaudeCodeStandingRead { bundle } =>
            provider_standing_from_observed_bundle(
              fact_id: claude_code_standing_trip_fact_id,
              provider: claude_offer_for_instance(instance: taken_credential_snapshot_attempt(snapshot: snapshot).instance).instance,
              bundle: bundle,
            )
        }
      }
    }
  }
}

// WHERE THE CLAUDE CREDENTIAL IS HELD, which is a different fact from a snapshot of it: this names the
// mutable custody file the take copies FROM, so it has its own carrier rather than reusing the
// snapshot's (one name, two meanings is the fork DESIGN section 3 forbids).
type ClaudeCredentialCustody
  = ClaudeCustodyBound { custody: SnapshotCustodyDeclaration }
  | ClaudeCustodyUnbound { reason: NonEmptyStr }

fn snapshot_custody_declaration(executor: SnapshotExecutor) -> SnapshotCustodyDeclaration {
  match executor {
    ClaudeFromSnapshot => claude_worker_turn_snapshot_custody
    CursorFromSnapshot => cursor_worker_turn_snapshot_custody
  }
}

fn claude_dispatch_secret_is_declared(secret_ref: SecretRef, declared: SnapshotCustodyDeclaration) -> Bool {
  (secret_ref.project as String) == (declared.secret.project as String)
    && (secret_ref.secret as String) == (declared.secret.secret as String)
    && (secret_ref.version as String) == (declared.secret.version as String)
}

fn claude_credential_custody_source() -> ClaudeCredentialCustody {
  let declared = snapshot_custody_declaration(executor: ClaudeFromSnapshot)
  match claude_dispatch_credential() {
    ClaudeOAuthTokenSecretRef { secret_ref } =>
      if claude_dispatch_secret_is_declared(secret_ref: secret_ref, declared: declared) {
        ClaudeCustodyBound { custody: declared }
      } else {
        ClaudeCustodyUnbound {
          reason: join(["claude credential secret ", secret_ref.secret as String, " has no host custody"], "") as NonEmptyStr,
        }
      }
    ClaudeApiKeySecretRef { secret_ref: _ } =>
      ClaudeCustodyUnbound { reason: "an API-key Claude credential has no dispatch spawn binding" as NonEmptyStr }
    ClaudeStateRootRef { root: _ } =>
      ClaudeCustodyUnbound { reason: "a Claude state root is a profile tree, not a credential the spawn can bind" as NonEmptyStr }
  }
}

fn dispatch_actuator_claude_selection_observed(
  attempt: DispatchAttempt,
  sizing_expectation: SizingProfileExpectation,
) -> DispatchAttemptSelection {
  match claude_credential_custody_source() {
    ClaudeCustodyUnbound { reason } => DispatchAttemptSelectionRefused { reason: reason }
    ClaudeCustodyBound { custody } =>
      match credential_register_then_take(
        attempt: attempt,
        executor: ClaudeFromSnapshot,
        custody: custody,
        snapshot: dispatch_credential_snapshot_path_for_attempt(attempt: attempt, executor: ClaudeFromSnapshot),
      ) {
        DispatchSnapshotRefused { reason } => DispatchAttemptSelectionRefused { reason: dispatch_snapshot_refusal_text(reason: reason) }
        DispatchSnapshotTaken { snapshot } => {
          let selected = attempt_selection_launching(
            requested: attempt,
            selection: worker_turn_selection_of(
              inventory: inventory_with_observed_standing(
                inventory: provider_inventory_for_instance(instance: attempt.instance),
                kind: ClaudeCliProvider,
                standing: claude_observed_standing_from_snapshot(snapshot: snapshot),
              ),
              kind: ClaudeCliProvider,
              sizing_expectation: sizing_expectation,
            ),
            launch: SnapshotLaunch { snapshot: snapshot },
          )
          match selected {
            DispatchAttemptPrepared { prepared: _ } => selected
            DispatchAttemptSelectionRefused { reason } => selection_refused_discarding(reason: reason, snapshot: snapshot)
          }
        }
      }
  }
}

// THE CODEX AND CURSOR DRAWS OBSERVE BEFORE THEY SELECT, as the Claude draw does: the declared row's
// standing admits no draw, so each request runs its custody-bound observation
// (gunbc.worker_turn_standing), substitutes it into the declared row and selects over that. A rejected
// credential, an exhausted codex bucket, a busy codex lock or a credential held on another host
// therefore refuses typed before any spawn.
fn codex_offer_provider_instance(inventory: ProviderInventory) -> ProviderInstance? {
  fold(inventory.offers, init: none, f: (acc, offer) =>
    match acc {
      Present { value: _ } => acc
      Absent =>
        match offer {
          OfferCodex { offer: o } => Present { value: o.instance }
          OfferClaude { offer: _ } => acc
          OfferCursor { offer: _ } => acc
        }
    }
  )
}

// THE CODEX DRAW binds the custody CODEX_HOME directory itself, not a copy: a copied auth.json would
// fork the refresh token, and the issuer refuses a reused one. So the shared one-snapshot rule
// (dispatch_credential_snapshot_path_for_attempt) is met by the directory and its flock instead --
// admission observes it under the lock, the turn runs in it under the lock, and nothing else ever
// writes it but codex under that lock. A turn that runs between admission and this attempt's spawn
// may move the bucket the admission read; the spawn still binds the same credential, and a bucket
// exhausted in that window fails the turn as the CLI reports it.
fn codex_observed_inventory(instance: HostDashboardInstance) -> ProviderInventory {
  let inventory = provider_inventory_for_instance(instance: instance)
  inventory_with_codex_state_root(
    inventory: inventory_with_observed_standing(
      inventory: inventory,
      kind: CodexCliProvider,
      standing: match codex_offer_provider_instance(inventory: inventory) {
        Absent => ProviderStandingUnobserved { reason: "this instance's inventory declares no codex offer" as NonEmptyStr }
        Present { value: provider_instance } => codex_observed_standing_for_instance(instance: instance, provider: provider_instance)
      },
    ),
    account_state_root: codex_worker_turn_codex_home as FilePath,
  )
}

fn worker_turn_selection_of(
  inventory: ProviderInventory,
  kind: ProviderKind,
  sizing_expectation: SizingProfileExpectation,
) -> DispatchActuatorSelection {
  match resolve_dispatch_selection(
    inventory: inventory,
    request: provider_selection_request_for_kind(kind: kind),
    sizing_expectation: sizing_expectation,
  ) {
    DispatchSelectionResolved { receipt } =>
      DispatchActuatorSelectionOk {
        provider: provider_kind_to_dispatch_cli(kind: receipt.provider_kind),
        effort: receipt.applied_effort,
        model: resolved_model_selection(resolved: receipt.resolved_selection),
        process_fingerprint: resolved_process_fingerprint(resolved: receipt.resolved_selection),
      }
    DispatchSelectionRefused { sizing_expectation: _, requested_selection: _, reason } =>
      DispatchActuatorSelectionRefused { reason: reason }
  }
}

// THE CURSOR DRAW takes the attempt's credential snapshot first (shared rule above): the status probe
// borrows that snapshot and keeps it, and the spawn loads the same snapshot and removes it before exec.
// A refused draw discards the snapshot it took, as the Claude draw does; after selection the belt owns
// the discard (gunbc.roadmap.roadmap_belt_actuate belt_snapshot_owned_outcome).
fn cursor_selection_observed(attempt: DispatchAttempt, sizing_expectation: SizingProfileExpectation) -> DispatchAttemptSelection {
  if (attempt.instance.host_identity as String) != (snapshot_custody_declaration(executor: CursorFromSnapshot).host as String) {
    DispatchAttemptSelectionRefused {
      reason: provider_off_custody_host_reason(provider_label: "cursor", custody_host: snapshot_custody_declaration(executor: CursorFromSnapshot).host, instance_host: attempt.instance.host_identity),
    }
  } else {
    match credential_register_then_take(
      attempt: attempt,
      executor: CursorFromSnapshot,
      custody: snapshot_custody_declaration(executor: CursorFromSnapshot),
      snapshot: dispatch_credential_snapshot_path_for_attempt(attempt: attempt, executor: CursorFromSnapshot),
    ) {
      DispatchSnapshotRefused { reason } => DispatchAttemptSelectionRefused { reason: dispatch_snapshot_refusal_text(reason: reason) }
      DispatchSnapshotTaken { snapshot } => {
        let selected = attempt_selection_launching(
          requested: attempt,
          selection: worker_turn_selection_of(
            inventory: inventory_with_observed_standing(
              inventory: provider_inventory_for_instance(instance: attempt.instance),
              kind: CursorCliProvider,
              standing: cursor_observed_standing_from_snapshot(snapshot: snapshot),
            ),
            kind: CursorCliProvider,
            sizing_expectation: sizing_expectation,
          ),
          launch: SnapshotLaunch { snapshot: snapshot },
        )
        match selected {
          DispatchAttemptPrepared { prepared: _ } => selected
          DispatchAttemptSelectionRefused { reason } => selection_refused_discarding(reason: reason, snapshot: snapshot)
        }
      }
    }
  }
}

// THE HARNESS IS AN ATTEMPT'S DEFAULT EXECUTOR, and it reads no snapshot.
fn dispatch_harness_attempt_selection(attempt: DispatchAttempt, sizing_expectation: SizingProfileExpectation) -> DispatchAttemptSelection {
  attempt_selection_launching(
    requested: attempt,
    selection: dispatch_actuator_selection(sizing_expectation: sizing_expectation),
    launch: SnapshotFreeLaunch { attempt: attempt, executor: HarnessWithoutSnapshot },
  )
}

fn dispatch_actuator_worker_turn_selection_observed(
  attempt: DispatchAttempt,
  provider: DispatchCliProvider,
  sizing_expectation: SizingProfileExpectation,
) -> DispatchAttemptSelection {
  match provider {
    CodexDispatchProvider =>
      attempt_selection_launching(
        requested: attempt,
        selection: worker_turn_selection_of(
          inventory: codex_observed_inventory(instance: attempt.instance),
          kind: CodexCliProvider,
          sizing_expectation: sizing_expectation,
        ),
        launch: SnapshotFreeLaunch { attempt: attempt, executor: CodexWithoutSnapshot },
      )
    CursorDispatchProvider => cursor_selection_observed(attempt: attempt, sizing_expectation: sizing_expectation)
    ClaudeCodeProvider =>
      DispatchAttemptSelectionRefused { reason: "the claude draw is observed by dispatch_actuator_claude_selection_observed" as NonEmptyStr }
    GunbcHarnessProvider =>
      DispatchAttemptSelectionRefused { reason: "worker-turn selection was asked for the gunbc harness, which has no vendor credential" as NonEmptyStr }
  }
}

// THE BELT SELECTS FOR THE ATTEMPT IT OWNS: the attempt is given here once, and every arm returns a
// launch built from it -- a snapshot the draw took for it, or the attempt itself with an executor that
// reads none.
fn dispatch_actuator_selection_for_request(
  attempt: DispatchAttempt,
  request: DispatchExecutorRequest,
  sizing_expectation: SizingProfileExpectation,
) -> DispatchAttemptSelection {
  match request {
    ExecutorDefault => dispatch_harness_attempt_selection(attempt: attempt, sizing_expectation: sizing_expectation)
    ExecutorVendor { provider } =>
      match provider {
        ClaudeCodeProvider => dispatch_actuator_claude_selection_observed(attempt: attempt, sizing_expectation: sizing_expectation)
        CodexDispatchProvider =>
          dispatch_actuator_worker_turn_selection_observed(attempt: attempt, provider: provider, sizing_expectation: sizing_expectation)
        CursorDispatchProvider =>
          dispatch_actuator_worker_turn_selection_observed(attempt: attempt, provider: provider, sizing_expectation: sizing_expectation)
        GunbcHarnessProvider => dispatch_harness_attempt_selection(attempt: attempt, sizing_expectation: sizing_expectation)
      }
  }
}

data claude_skip_permission_settings_json: String = "{\"skipDangerousModePermissionPrompt\":true}"
data dispatch_claude_start_prompt: String = "Begin working on the assigned node."
data dispatch_claude_permission_args: List<String> = ["--dangerously-skip-permissions"]
data dispatch_codex_start_prompt: String = "Begin working on the assigned node."
data dispatch_codex_exec_spec: CodexExecSpec = CodexExecSpec {
  sandbox: CodexWorkspaceWrite,
  approval: CodexApprovalNever,
  json_events: true,
  persist_session: true,
}
// Codex dispatch is unattended but not unrestricted: workspace-write permits implementation inside
// the attempt worktree; approval never returns blocked operations to the agent instead of hanging
// on an invisible prompt; --json exposes the provider event stream in the pane; persisted sessions
// preserve the provider transcript after the process exits. Attempt capture retains the complete
// JSONL stream, while workflow observation consumes a separately validated bounded projection.
// Spawned and session-present remain actuator/process observations only — never a claim that the
// provider completed successfully.

fn dispatch_provider_label(provider: DispatchCliProvider) -> String {
  match provider {
    ClaudeCodeProvider => "claude"
    CodexDispatchProvider => "codex"
    CursorDispatchProvider => "cursor"
    GunbcHarnessProvider => "gunbc-harness"
  }
}

type HostExecArgv {
  program: String
  args: List<String>
}

data dispatch_unrealized_capability_marker: String = "gunbc-unrealized-capability:"

// An environment with no realization for a capability used to resolve to the empty program string.
// Empty is non-executable, so the host did fail — but it failed as an unattributable exec error
// with nothing naming WHICH capability was unrealized, which is a degradation that cannot be
// counted (DESIGN 5). The marker keeps the arm non-executable and makes it self-describing at the
// point of failure. It is not a widening: no marker value can run. The real close is a typed
// refusal on the resolver, which requires the argv shapers above it to carry a refusal arm — that
// rides with the DashboardExecResult typed-refusal migration named in
// dashboard_exec_result_carrier_note, and dissolves this row with it.

fn dispatch_capability_program(
  environment: DispatchHostEnvironment,
  cap: ExecutionCapability,
) -> String {
  match dispatch_host_realization(environment: environment, capability: cap) {
    Present { value: realization } => realization.executable as String
    Absent =>
      join(
        [
          dispatch_unrealized_capability_marker,
          execution_capability_label(capability: cap),
        ],
        "",
      )
  }
}

type DispatchBriefFields {
  node_id: String
  displaced_cost: String
  current_state: String
  first_slice: String
  red_control: String
  out_of_scope: String
  handback: String
  paths: String
  commands_to_run: String
  expected_artifact: String
}

// DispatchBriefFields contains only fields consumed by fill_dispatch_brief. Sizing remains typed on
// RoadmapNode and is projected only where rendered.

// The template's workflow slots are REAL fields when the node is a TicketLine (remodel W2: the
// template was always the spec of the schema — its slot names became TicketFields), and honest
// stubs only on the legacy prose frontier: a legacy row's brief still repeats the title where a
// fact should be, which is exactly the burn-down pressure W2-bulk answers. A ticket node's brief
// carries its own displaced cost, current state, first slice, RED, scope, and hand-back conditions;
// paths come from the node's carriers.

type TmuxSessionScope {
  session_name: NonEmptyStr
  expected_owner_label: NonEmptyStr
  expected_process_fingerprint: NonEmptyStr
}

type TmuxSessionObservation
  = SessionAbsent
  | SessionNameObserved {
      session_name: NonEmptyStr
      windows: Int
    }
  | SessionObserved {
      session_name: NonEmptyStr
      windows: Int
      process_fingerprint: NonEmptyStr
    }
  | SessionObservedStaleExpected {
      session_name: NonEmptyStr
      windows: Int
      process_fingerprint: NonEmptyStr
      stale_reason: NonEmptyStr
    }
  | SessionInaccessible

type DispatchLeasePlan
  = SpawnSession
  | DrainStaleThenSpawn
  | RefuseForeignSession

// THE PERMIT CARRIES THE MODEL BESIDE THE EFFORT. It carried effort alone, which is the same drop
// this change closes everywhere else: a permit that names one provider control and not the other is
// the shape the next author copies, and it is harmless today only because nothing in production
// consumes this gate. Adding the field now costs one line and removes the trap; the alternative --
// deleting the gate as the unconsumed surface it is -- is a separate section 3c question, and
// leaving a known-incomplete shape standing while that is decided is the worse of the two.
type DispatchRequestGate
  = DispatchPermitted {
      session_name: String
      worktree_path: String
      branch_name: String
      brief: String
      reasoning_effort: ReasoningEffort
      model: ProviderModelSelection
    }
  | DispatchRefused { reason: NonEmptyStr }

type DispatchLiveSession {
  session_name: String
  node_id: String
  windows: Int
  lease_verdict: ObservationVerdict
  worker: WorkerObservation
}

// The configured provider instance is known from the actuator plan, not guessed from one process
// command. dispatch_provider_instance_for is total over the same closed DispatchCliProvider choice
// that owns argv and expected process fingerprint: Claude consumes claude_cli_program; Codex
// consumes codex_cli_program. The tmux observation does not read hostname, version, state/auth
// directory, credential storage, or service identity, so each stays explicitly Unobserved; filling
// any from deployment prose would fabricate live evidence. A later provider-instance probe replaces
// those arms independently.

// THE HARNESS'S EXECUTABLE IS OUR OWN BINARY, which is the one fact that makes the whole executor
// arm cheap: the worker is `gunbc run` against a .dag entry in the attempt's own checkout, so there
// is no runtime to install, no bundle to place and no version to reconcile. The three vendor arms
// name programs that must already exist on the host; this one names the binary that is already
// executing the dispatch.
fn dispatch_provider_executable(provider: DispatchCliProvider) -> NonEmptyStr {
  match provider {
    ClaudeCodeProvider => claude_cli_program as NonEmptyStr
    CodexDispatchProvider => codex_cli_program as NonEmptyStr
    CursorDispatchProvider => cursor_cli_program as NonEmptyStr
    GunbcHarnessProvider => gunbc_harness_program as NonEmptyStr
  }
}

data gunbc_harness_program: String = "gunbc"

// THE DOMAIN IS NARROWED RATHER THAN THE ANSWER FABRICATED. This projects a VENDOR session's
// provider instance, and every field it fills is a vendor fact -- kind, executable, credential
// storage. The gunbc harness has no vendor kind, so rather than handing this function an executor
// it cannot answer for and inventing a placeholder kind to get past the type, the parameter becomes
// the vendor kind itself: asking it about the harness is now unwritable instead of wrong.
//
// Nothing lost a caller. Every call site in the tree passes a literal vendor provider, so the
// narrowing is a rename at those sites and a wall at the one that does not exist yet.
fn dispatch_provider_instance_for_kind(
  kind: ProviderKind,
) -> ProviderInstance {
  ProviderInstance {
    kind: kind,
    host: ProviderInstanceFieldUnobserved {
      reason: "session observation does not read host identity" as NonEmptyStr,
    },
    executable: dispatch_provider_executable(provider: provider_kind_to_dispatch_cli(kind: kind)),
    observed_version: ProviderInstanceFieldUnobserved {
      reason: "session observation does not execute the provider version probe" as NonEmptyStr,
    },
    state_directory: ProviderInstanceFieldUnobserved {
      reason: "session observation does not inspect provider state" as NonEmptyStr,
    },
    credential_storage_method: ProviderInstanceFieldUnobserved {
      reason: "session observation does not inspect credential storage" as NonEmptyStr,
    },
    service_identity: ProviderInstanceFieldUnobserved {
      reason: "session observation does not read process ownership" as NonEmptyStr,
    },
  }
}

// AN EXECUTOR WITH NO VENDOR INSTANCE ANSWERS ABSENT, which this Optional already meant and now
// has a second way to be reached. The gunbc harness has no vendor ProviderInstance to observe -- no
// account, no credential storage, no separately versioned runtime -- and Absent says exactly that.
// The alternative was to invent one so the shape stayed populated, which would put a fabricated
// vendor row into every session observation downstream.
fn dispatch_provider_instance() -> ProviderInstance? {
  match dispatch_actuator_selection(sizing_expectation: NoDerivedSizingExpectation) {
    DispatchActuatorSelectionOk { provider, effort: _, model: _, process_fingerprint: _ } =>
      match dispatch_cli_to_provider_kind(provider: provider) {
        DispatchProviderKindIs { kind: k } =>
          Present { value: dispatch_provider_instance_for_kind(kind: k) }
        DispatchExecutorHasNoVendorKind { executor: _ } => none
      }
    DispatchActuatorSelectionRefused { reason: _ } => none
  }
}

fn dispatch_worker_observation_for_process(
  process: WorkerProcessEvidence,
) -> WorkerObservation? {
  match dispatch_provider_instance() {
    Present { value: instance } =>
      Present {
        value: worker_observation_without_provider_probe_for_process(
          instance: instance,
          process: process,
        ),
      }
    none => none
  }
}

fn dispatch_worker_observation() -> WorkerObservation? {
  match dispatch_provider_instance() {
    Present { value: instance } =>
      Present { value: worker_observation_without_provider_probe(instance: instance) }
    none => none
  }
}

fn dispatch_applied_effort() -> ReasoningEffort? {
  match dispatch_actuator_selection(sizing_expectation: NoDerivedSizingExpectation) {
    DispatchActuatorSelectionOk { provider: _, effort, model: _, process_fingerprint: _ } =>
      Present { value: effort }
    DispatchActuatorSelectionRefused { reason: _ } => none
  }
}

fn dispatch_tmux_session_name(node_id: RoadmapNodeId) -> String {
  concat(dispatch_tmux_session_prefix, node_id)
}

// Dispatch is ATTEMPT-grain (U1, the redispatch fix, 2026-07-25; the operator's accidental spawn
// was the live receipt): branch and worktree carry an attempt key derived from (node_id x the
// attempt's ORDINAL) through std.content_hash; the Claude provider also derives its required
// session-id from that key, while Codex mints its own persisted thread identity and does not yet
// join it back to the attempt. A stopped attempt's debris therefore never collides with the next
// spawn, and NOTHING is deleted to make way. The tmux session name deliberately STAYS node-grain:
// it is what observe/reconcile key on, so already-live detection, kill, and tick idempotency are
// untouched.
//
// THE ORDINAL IS MINTED BY AN EXCLUSIVE DURABLE CREATE, NOT READ FROM THE CLOCK. The key used to be
// content_hash(node_id x the second-granular probed_at), so two spawns of one node inside one second
// derived ONE identity and the collision surfaced only at the git step. Now the identity is the
// outcome of dispatch_attempt_identity_mint: a create-only file under the attempt-state root named
// by (node, ordinal), whose creation is the claim on that ordinal. Two same-second spawns create two
// different ordinals, so a same-second duplicate has no spelling; the clock observation is recorded
// as the file's CONTENT (when it was minted) and is no longer an input to the identity. A clock
// refusal still refuses the spawn (step attempt-clock), never an unknown-stamped attempt, and a
// mint the host refuses refuses the spawn (step attempt-identity).

fn dispatch_attempt_key(node_id: RoadmapNodeId, ordinal: Int) -> String {
  content_hash_atom(value: join([node_id as String, "\nordinal:", to_string(value: ordinal)], "") as NonEmptyStr).digest as String
}

data dispatch_attempt_identity_prefix: String = "attempt-identity-"

// The ordinal space is bounded so a host that refuses every create ends in a typed refusal, not a loop.
data dispatch_attempt_ordinal_limit: Int = 4096

fn dispatch_attempt_identity_path_for_instance(instance: HostDashboardInstance, node_id: RoadmapNodeId, ordinal: Int) -> String {
  join([
    dashboard_instance_dispatch_attempt_state_root(instance: instance) as String,
    "/", dispatch_attempt_identity_prefix, node_id as String, "-n", to_string(value: ordinal),
  ], "")
}

type DispatchAttemptIdentity
  = DispatchAttemptMinted { attempt_key: String, ordinal: Int }
  | DispatchAttemptIdentityRefused { detail: String }

fn dispatch_attempt_identity_mint(instance: HostDashboardInstance, node_id: RoadmapNodeId, minted_at: String) -> DispatchAttemptIdentity {
  dispatch_attempt_identity_claim(instance: instance, node_id: node_id, minted_at: minted_at, ordinal: 1)
}

// An occupied ordinal belongs to an earlier attempt and is never read back or overwritten: the next
// ordinal is claimed. Any other refusal is the host's and ends the mint.
fn dispatch_attempt_identity_claim(instance: HostDashboardInstance, node_id: RoadmapNodeId, minted_at: String, ordinal: Int) -> DispatchAttemptIdentity {
  if ordinal > dispatch_attempt_ordinal_limit {
    DispatchAttemptIdentityRefused { detail: join(["every ordinal up to ", to_string(value: dispatch_attempt_ordinal_limit), " is already claimed for node ", node_id as String], "") }
  } else {
    let path = dispatch_attempt_identity_path_for_instance(instance: instance, node_id: node_id, ordinal: ordinal)
    let write = Filesystem.WriteCreateNew(path: path, content: join(["minted_at: ", minted_at, "\n"], ""))
    match filesystem_create_new(path: path, success: write.success, error: write.error, error_kind: write.error_kind) {
      FilesystemCreated { path: _ } => DispatchAttemptMinted { attempt_key: dispatch_attempt_key(node_id: node_id, ordinal: ordinal), ordinal: ordinal }
      FilesystemCreateTargetOccupied { path: _ } => dispatch_attempt_identity_claim(instance: instance, node_id: node_id, minted_at: minted_at, ordinal: ordinal + 1)
      FilesystemCreateRefused { path: _, kind: _, error: e } => DispatchAttemptIdentityRefused { detail: join(["the attempt identity could not be created at ", path, ": ", e], "") }
      FilesystemCreateKindUnrecognized { path: _, observed: _, error: e } => DispatchAttemptIdentityRefused { detail: join(["the attempt identity could not be created at ", path, ": ", e], "") }
    }
  }
}

// Verification validates the committed head in a DETACHED checkout, never the mutable
// implementation worktree the agent may still be editing. The path is head-addressed beside the
// attempt worktree so multiple heads per attempt each retain their own immutable tree without
// colliding on the branch checkout.

fn dispatch_verification_checkout_path_for_instance(
  instance: HostDashboardInstance,
  node_id: RoadmapNodeId,
  attempt_key: String,
  head_sha: String,
) -> String {
  join([
    dashboard_instance_dispatch_worktree_root(instance: instance) as String,
    "/",
    node_id as String,
    "-a",
    attempt_key,
    "-verify-",
    head_sha,
  ], "")
}

// THE WIRE LOG DIRECTORY (harness-conversation-log-forking): per-round request/response bytes
// persist beside the provider events file under "<events>.wire/"; provisioning it here is what
// makes the harness's round writes land instead of degrading to turn.wire_log_unwritable.
// THE PROCESS FINGERPRINT THE SPAWN'S SELECTION CHOSE, written at state initialization beside the
// attempt key. Live-session observation and stop judge a tmux session against what THIS attempt
// spawned, read here, rather than against whatever the default selection would choose now: once an
// operator can name a vendor executor (DispatchExecutorRequest), a Claude attempt's pane is not the
// harness's, and re-selecting at observation time would also hide a live session the moment its
// provider's standing stopped admitting new draws. An attempt with no such file predates the record
// and keeps the default-selection scope it was always observed under.
fn dispatch_actuator_selection_process_fingerprint(selection: DispatchActuatorSelection) -> NonEmptyStr? {
  match selection {
    DispatchActuatorSelectionOk { provider: _, effort: _, model: _, process_fingerprint } => Present { value: process_fingerprint }
    DispatchActuatorSelectionRefused { reason: _ } => Absent
  }
}

// THE TURN NUMBER OF THIS ATTEMPT IN ITS LINEAGE (gunbc.roadmap.roadmap_attempt_continuation), written
// at state initialization beside the attempt key. A first turn writes 1, so an attempt with no such
// file predates the continuation and is read as turn 1 by the decision, never guessed at otherwise.
// THE ALIGNMENT BINDING PATH: the resolved chain's fingerprint, written at state initialization
// beside the attempt key and turn (gunbc.roadmap.roadmap_alignment owns the binding's shape; this
// module only names its address in the attempt state directory).
// The attempt's verification evidence sits beside its admission receipt and its event stream, in
// the same attempt-state directory and keyed by the same attempt key. That placement is what lets a
// Publication step find the evidence for the revision it is about to publish without being told
// where to look: the attempt identity already addresses everything else the attempt produced, and a
// verification record filed anywhere else would need a second index.

// The oracle pin is TWO one-fact files beside the attempt's other evidence, not one record needing
// a grammar. That follows the directory's existing shape — attempt-key, spawn-failure.txt and
// provider-events.jsonl are each one fact in one file — and it is what lets the verification side
// read a value back without a JSON parser, which this seam does not have. Only these two facts
// cross the disk seam because they are the only two that cannot be re-derived at verification time:
// what the oracle's content WAS before the agent started, and which revision that content came
// from. The subject, the selection, and the declared command are all re-derived from the node's own
// execution contract, so persisting them would be a second home for a fact that already has one.

// THE HEAD IS IN THE PATH, BECAUSE ONE ATTEMPT PUBLISHES MORE THAN ONCE. The ratified Review loop
// is head A -> findings -> worker correction -> head B, all inside a single implementation attempt.
// A single attempt-level receipt file has only bad answers to that: overwrite and lose A's real
// receipt, leave it and misreport B forever, or invent an update convention nobody else follows.
//
// Addressing by head makes the rounds independent rather than competing. Writing B's receipt cannot
// destroy A's, a reader asking about A gets A, and idempotence has an honest key - re-running for a
// head that already has a receipt is a no-op, while a new head is a new round by construction
// rather than by remembering to bump something.
//
// This is also what lets the subject check stay a check rather than becoming the only defence. Even
// with per-head addressing a receipt can be copied or retained, so publication_evidence_for still
// compares all six subject fields; the path narrows what can be found and the comparison decides
// what counts.

data publication_receipt_directory_is_named_once_note: String = "The directory is its own function because a reader has to establish that a receipt is ABSENT, and the only honest way to do that is to list the directory it would be in and not find it there. Filesystem.Read reports the same failure for a file that does not exist and one that cannot be read (review 46148), so absence inferred from a failed read is a guess; absence established by a successful listing is a fact. That makes the directory a load-bearing address rather than a path fragment, so it is named here once and the receipt path is built from it."

// EVERY OTHER RECEIPT ON THIS ROW HAS A `current` SPELLING AND THIS ONE DELIBERATELY DOES NOT. The
// alias exists so a reader that knows only a node can find the live attempt's evidence without
// first reading the attempt key. Publication cannot be reached that way: its address contains the
// head, and a reader that does not know the head has no path to build regardless of which attempt
// directory it starts from.\n\nSo the alias would buy nothing and cost the thing this lane is for.
// A reader holding a head already had to establish it, and establishing a head means reading the
// attempt - at which point the attempt-keyed path is available and the alias is a second spelling
// of it. Keeping it would have made the symlink an alternative route to a file whose identity is a
// head, which is how a receipt for one attempt gets read as evidence for another.

// VERIFICATION AND PUBLICATION SHARE THE HEAD × WINDOW GRAIN. One implementation attempt may be
// verified at head A under window W1 and again at the same head under window W2 after the target
// branch advances. Attempt-level files would either overwrite A or let A's verdict stand for B. The
// verification directory therefore mirrors publication at the finer grain:
// attempt/<attempt>/verification/<head>.<window_identity>.json for immutable receipts, plus a
// mutable current-selection pointer at verification/<head>.current-selection.json that names which
// window identity is selected for dashboard observation. DISSOLVE-ON: the legacy attempt-level
// validation-receipt.json path deletes once its last belt consumer is gone.

// THE REVIEW DIRECTORY: the reviewer's verdict per head, its event stream, its request scratch and
// its stdout, all beside the attempt's verification directory and prepared with it. It is the ONLY
// path the reviewer's unit may write, which is how "you may not change the tree" is a wall rather
// than a sentence (gunbc.harness.harness_review_guidance CapabilityWithheld ChangeTheTree).
// Every review artifact is addressed by head AND criterion: one reviewer per criterion, so one verdict,
// one event stream, one scratch and one log per criterion, never shared between them.
fn dispatch_review_unit_name(node_id: String, attempt_key: String, criterion_key: String) -> NonEmptyStr {
  join(["gunbc-review-", node_id, "-", attempt_key, "-", criterion_key, ".service"], "") as NonEmptyStr
}

// THE REVIEWER'S UNIT: the worker's confinement with ONE writable path, the review directory. The
// worktree it reads is under the instance root and stays read-only to it, so a reviewer that tried
// to fix what it was judging gets a refused write, not a contribution. Its WorkingDirectory is the
// controller's repo root, as the worker's is: `gunbc run` refuses a source root outside its process
// root (the first reviewer, 2026-09-05, exited 101 on exactly that with the worktree as its cwd), and
// the worktree reaches the harness as the argument that sets its tools' directory, tool and subject
// named separately (gunbc_harness_spawn_argv).
//
// THE EXIT RECORD REPLACES RemainAfterExit FOR THE REVIEWER AND AUDITOR (bold-bee-114 ruling,
// 2026-10-06), for the worker's reason (dispatch_worker_unit_properties): a reviewer finishing is the
// event the attempt's next obligation waits on, and a unit that stays `active (exited)` never stops,
// so its stop hook could not fire at that moment. With an exit hook the unit stops with its process
// and its record carries the exit; the belt reads a collected reviewer from that record
// (gunbc.roadmap.roadmap_belt_actuate belt_review_process). The SUPERVISOR shares this shape and now carries the same
// hook (AttemptSupervisorRole): its convene gate reads the exit record, not a retained unit, so a
// finished supervisor no longer stays loaded and blocks the continuation it authorized
// (gunbc.recurring_failure_mode an_attempt_crashed_between_state_init_and_container_start_is_unrecoverable).
// ExecStopPost runs after a failed unit too, so a failed supervisor records its failure; RemainAfterExit
// is gone from every role.
fn dispatch_review_unit_properties(
  instance: HostDashboardInstance,
  working_directory: String,
  log_path: String,
  review_dir: String,
  exit_hook: NonEmptyStr,
) -> List<SystemdRunProperty> {
  concat(worker_root_equivalent_socket_denial_properties(), concat(dispatch_model_driven_privilege_confinement_properties(), concat([
    NamedUnitSetting { property: MemoryMax, value: to_string(value: byte_size_count(instance.dispatch_worker_memory_max)) as NonEmptyStr },
    NamedUnitSetting { property: WorkingDirectoryProperty, value: working_directory as NonEmptyStr },
    NamedUnitSetting { property: StandardOutputProperty, value: join(["append:", log_path], "") as NonEmptyStr },
    NamedUnitSetting { property: StandardErrorProperty, value: join(["append:", log_path], "") as NonEmptyStr },
    NamedUnitSetting { property: ProtectSystemProperty, value: "strict" as NonEmptyStr },
    NamedUnitSetting { property: ProtectHomeProperty, value: "read-only" as NonEmptyStr },
    NamedUnitSetting { property: PrivateTmpProperty, value: "yes" as NonEmptyStr },
    NamedUnitSetting { property: ReadWritePathsProperty, value: review_dir as NonEmptyStr },
  ], [NamedUnitSetting { property: ExecStopPostProperty, value: exit_hook }])))
}

data gunbc_harness_reviewer_function: String = "harness_reviewer_cli"

fn gunbc_harness_review_argv(
  gunbc_program: String,
  repo_root: String,
  worktree_path: String,
  brief: String,
  timeout_program: String,
  request_scratch_path: String,
  events_path: String,
  verdict_dir: String,
  verdict_name: String,
  attempt_identity: String,
) -> List<String> {
  [
    gunbc_program,
    "run",
    "--source-root", join([repo_root, "/dag"], ""),
    "--source-root", join([repo_root, "/src/v2"], ""),
    "--entry", join([repo_root, "/", gunbc_harness_worker_entry], ""),
    "--function", gunbc_harness_reviewer_function,
    "--arg", join(["worktree=", worktree_path], ""),
    "--arg", join(["brief=", brief], ""),
    "--arg", join(["timeout_program=", timeout_program], ""),
    "--arg", join(["request_scratch_path=", request_scratch_path], ""),
    "--arg", join(["events_path=", events_path], ""),
    "--arg", join(["verdict_dir=", verdict_dir], ""),
    "--arg", join(["verdict_name=", verdict_name], ""),
    "--arg", join(["attempt_identity=", attempt_identity], ""),
  ]
}

// THE REVIEWER'S ATTEMPT IDENTITY IS MINTED HERE, as the worker's and auditor's are, with the
// criterion key appended: fourteen reviewer lanes share one node id and attempt key, and each
// lane's identity must stay distinct. Every piece is a safe path segment by construction, which the
// fleet ssh context's safe-segment law (gunbc.fleet.fleet_known_hosts_anchor fleet_ssh_attempt_identity)
// demands of the attempt identity it consumes as a path segment -- the pre-fix reviewer built it
// from the absolute verdict path and every lane's seat bind refused before any ssh leg.
// THE BELT LAYER RUNS THE RESOLVED PROGRAM, not the spelling: the instance toolchain declares where
// systemd-run lives, and that declaration is the only thing the invoking host is allowed to assert
// about an unobserved host's program location (extdeps.exec.command
// program_spelling_is_an_observation_claim). The option and command words are untouched -- they are
// the one projection's; only the head is substituted.
fn dispatch_unit_exec_argv(command: ArgvCommand, resolved_program: FilePath) -> HostExecArgv {
  host_exec_argv(program: resolved_program as String, args: systemd_run_command_argument_words(command: command))
}

fn dispatch_review_unit_command(
  instance: HostDashboardInstance,
  node_id: RoadmapNodeId,
  attempt_key: String,
  worktree_path: String,
  brief: String,
  head_sha: String,
  criterion_key: String,
  exit_hook: NonEmptyStr,
) -> SystemdRunCommandReading {
  gunbc_user_work_transient_command(
    unit: dispatch_review_unit_name(node_id: node_id as String, attempt_key: attempt_key, criterion_key: criterion_key),
    properties: dispatch_review_unit_properties(
      instance: instance,
      working_directory: instance.repo_root as String,
      log_path: attempt_state_text(instance: instance, node_id: node_id, attempt_key: attempt_key, member: AttemptReviewLog { criterion_key: criterion_key }),
      review_dir: attempt_state_directory_text(instance: instance, node_id: node_id, attempt_key: attempt_key, directory: AttemptDirectoryReview),
      exit_hook: exit_hook,
    ),
    setenv_bindings: [],
    command_argv: gunbc_harness_review_argv(
      gunbc_program: instance.serve_binary as String,
      repo_root: instance.repo_root as String,
      worktree_path: worktree_path,
      brief: brief,
      timeout_program: instance.toolchain.timeout as String,
      request_scratch_path: attempt_state_text(instance: instance, node_id: node_id, attempt_key: attempt_key, member: AttemptReviewRequestScratch { criterion_key: criterion_key }),
      events_path: attempt_state_text(instance: instance, node_id: node_id, attempt_key: attempt_key, member: AttemptReviewEvents { criterion_key: criterion_key, head_sha: head_sha }),
      verdict_dir: attempt_state_directory_text(instance: instance, node_id: node_id, attempt_key: attempt_key, directory: AttemptDirectoryReview),
      verdict_name: attempt_state_member_name(member: AttemptReviewVerdict { head_sha: head_sha, criterion_key: criterion_key }),
      attempt_identity: dispatch_reviewer_attempt_identity(node_id: node_id as String, attempt_key: attempt_key, criterion_key: criterion_key, head_sha: head_sha),
    ),
  )
}

// THE AUDIT DIRECTORY, the auditor's only writable path, beside review/. One auditor per head, so its
// artifacts are addressed by head alone.
fn dispatch_audit_unit_name(node_id: String, attempt_key: String) -> NonEmptyStr {
  join(["gunbc-audit-", node_id, "-", attempt_key, ".service"], "") as NonEmptyStr
}

data gunbc_harness_auditor_function: String = "harness_auditor_cli"

// Each launch writes its events to its OWN per-launch path (head-hash for the auditor, turn for
// the supervisor): a path shared across launches let a later launch rewrite an earlier one's
// stream, which erased that launch's token usage from the per-attempt metering — the metering
// reader opens exactly these per-launch paths (roadmap_attempt_metering), so the writer and the
// reader must name the same path expression, which the actuator witness pins on both sides.
fn dispatch_audit_unit_command(
  instance: HostDashboardInstance,
  node_id: RoadmapNodeId,
  attempt_key: String,
  worktree_path: String,
  brief: String,
  head_sha: String,
  exit_hook: NonEmptyStr,
) -> SystemdRunCommandReading {
  let dir = attempt_state_directory_text(instance: instance, node_id: node_id, attempt_key: attempt_key, directory: AttemptDirectoryAudit)
  gunbc_user_work_transient_command(
    unit: dispatch_audit_unit_name(node_id: node_id as String, attempt_key: attempt_key),
    properties: dispatch_review_unit_properties(
      instance: instance,
      working_directory: instance.repo_root as String,
      log_path: join([dir, "/auditor-stdout.log"], ""),
      review_dir: dir,
      exit_hook: exit_hook,
    ),
    setenv_bindings: [],
    command_argv: [
      instance.serve_binary as String,
      "run",
      "--source-root", join([instance.repo_root as String, "/dag"], ""),
      "--source-root", join([instance.repo_root as String, "/src/v2"], ""),
      "--entry", join([instance.repo_root as String, "/", gunbc_harness_worker_entry], ""),
      "--function", gunbc_harness_auditor_function,
      "--arg", join(["worktree=", worktree_path], ""),
      "--arg", join(["brief=", brief], ""),
      "--arg", join(["timeout_program=", instance.toolchain.timeout as String], ""),
      "--arg", join(["request_scratch_path=", dir, "/harness-request.json"], ""),
      "--arg", join(["events_path=", attempt_state_text(instance: instance, node_id: node_id, attempt_key: attempt_key, member: AttemptAuditEvents { head_sha: head_sha })], ""),
      "--arg", join(["verdict_dir=", dir], ""),
      "--arg", join(["verdict_name=", attempt_state_member_name(member: AttemptAuditVerdict { head_sha: head_sha })], ""),
      "--arg", join(["attempt_identity=", dispatch_auditor_attempt_identity(node_id: node_id as String, attempt_key: attempt_key, head_sha: head_sha)], ""),
    ],
  )
}

// THE SUPERVISOR DIRECTORY, the supervisor session's only writable path, beside review/ and
// audit/. One supervisor per escalation record (node, attempt, turn): its verdict, event stream,
// scratch and log are addressed together, and the belt's continuation decision reads the verdict
// at this same address (belt_supervisor_verdict_observe), so writer and reader cannot disagree
// about where an adjudication lands.
fn dispatch_supervisor_unit_name(node_id: String, attempt_key: String, turn: Int) -> NonEmptyStr {
  join(["gunbc-supervisor-", node_id, "-", attempt_key, "-t", to_string(value: turn), ".service"], "") as NonEmptyStr
}

fn dispatch_supervisor_attempt_identity(node_id: String, attempt_key: String, turn: Int) -> String {
  join(["supervisor:", node_id, "-", attempt_key, "-t", to_string(value: turn)], "")
}

data gunbc_harness_supervisor_function: String = "harness_supervisor_cli"

// THE SUPERVISOR'S UNIT: the auditor's shape (one session per subject, not per criterion) with the
// escalation's turn in the unit name and the attempt identity, which is what makes one escalation
// record convene at most one session -- a second convene over the same record names the same unit,
// and the belt's liveness gate reads that. The worktree stays read-only to the session, as the
// reviewer's is: the supervisor adjudicates the checkpoint; it does not edit it.
fn dispatch_supervisor_unit_command(
  instance: HostDashboardInstance,
  node_id: RoadmapNodeId,
  attempt_key: String,
  turn: Int,
  worktree_path: String,
  brief: String,
  exit_hook: NonEmptyStr,
) -> SystemdRunCommandReading {
  let dir = attempt_state_directory_text(instance: instance, node_id: node_id, attempt_key: attempt_key, directory: AttemptDirectorySupervisor)
  gunbc_user_work_transient_command(
    unit: dispatch_supervisor_unit_name(node_id: node_id as String, attempt_key: attempt_key, turn: turn),
    properties: dispatch_review_unit_properties(
      instance: instance,
      working_directory: instance.repo_root as String,
      log_path: join([dir, "/supervisor-stdout.log"], ""),
      review_dir: dir,
      exit_hook: exit_hook,
    ),
    setenv_bindings: [],
    command_argv: [
      instance.serve_binary as String,
      "run",
      "--source-root", join([instance.repo_root as String, "/dag"], ""),
      "--source-root", join([instance.repo_root as String, "/src/v2"], ""),
      "--entry", join([instance.repo_root as String, "/", gunbc_harness_worker_entry], ""),
      "--function", gunbc_harness_supervisor_function,
      "--arg", join(["worktree=", worktree_path], ""),
      "--arg", join(["brief=", brief], ""),
      "--arg", join(["timeout_program=", instance.toolchain.timeout as String], ""),
      "--arg", join(["request_scratch_path=", dir, "/harness-request.json"], ""),
      "--arg", join(["events_path=", attempt_state_text(instance: instance, node_id: node_id, attempt_key: attempt_key, member: AttemptSupervisorEvents { turn: turn })], ""),
      "--arg", join(["verdict_dir=", dir], ""),
      "--arg", join(["verdict_name=", supervisor_verdict_basename as String], ""),
      "--arg", join(["attempt_identity=", dispatch_supervisor_attempt_identity(node_id: node_id as String, attempt_key: attempt_key, turn: turn)], ""),
    ],
  )
}

// THE PROVIDER-EVENT PROJECTION OVER ONE EVENTS FILE. The current-attempt projection names the file
// through the node's current pointer; a reader of a named attempt names it by the attempt's own key.
// One argv, two addressings.
fn dispatch_events_projection_argv_at(
  instance: HostDashboardInstance,
  events_path: String,
) -> HostExecArgv {
  host_exec_argv(
    program: dispatch_capability_program(
      environment: instance.execution_environment,
      cap: ProviderEventProjectionCapability,
    ),
    args: codex_provider_event_projection_args(path: events_path as FilePath),
  )
}

fn dispatch_current_attempt_events_projection_argv_for_instance(
  instance: HostDashboardInstance,
  node_id: RoadmapNodeId,
) -> HostExecArgv {
  dispatch_events_projection_argv_at(
    instance: instance,
    events_path: attempt_state_current_text(instance: instance, node_id: node_id, member: AttemptWorkerEvents),
  )
}

fn dispatch_branch_name(node_id: RoadmapNodeId, attempt_key: String) -> String {
  join(["dispatch/", node_id as String, "-a", attempt_key], "")
}

// Lease and tmux classification witnesses pin an explicit process fingerprint via
// dispatch_tmux_session_scope_for_process_fingerprint and
// classify_dispatch_request_for_process_fingerprint — they prove ownership classification and
// ready-frontier gating, not production selection standing. Production paths use
// dispatch_actuator_selection and refuse while standing axes block eligibility.

// Production admission onto the live-session list routes through dispatch_tmux_session_scope, which
// projects dispatch_actuator_selection. Standing refusal yields Absent and the tmux row is omitted
// — ordinary non-running presentation, never a Codex substitute or partial row. Wire projection for
// already-admitted sessions uses dispatch_tmux_session_scope_for_live_session: Codex routes through
// dispatch_actuator_selection and refuses when process fingerprint is unobserved; Claude/Cursor
// still pin their observed fixture fingerprints.

// One planted refusal specimen for production standing-blocked projection: tmux row
// gunbc-dispatch-panel-a while production dispatch_actuator_selection refuses. Actuator admission
// (dispatch_live_sessions_from_entries), classify_dispatch_request, and sessions wire
// (belt_sessions_json_value over Observed live) must all derive no eligible provider — omit the
// row, never Null-deref or Codex substitute.

fn fixture_projection_standing_refusal_tmux_entry() -> TmuxLsEntry {
  TmuxLsEntry {
    session_name: "gunbc-dispatch-panel-a",
    windows: 1,
  }
}

fn dispatch_tmux_session_scope_for_process_fingerprint(
  node_id: RoadmapNodeId,
  process_fingerprint: NonEmptyStr,
) -> TmuxSessionScope {
  TmuxSessionScope {
    session_name: dispatch_tmux_session_name(node_id: node_id) as NonEmptyStr,
    expected_owner_label: dispatch_tmux_session_name(node_id: node_id) as NonEmptyStr,
    expected_process_fingerprint: process_fingerprint,
  }
}

// THE SELECTION IS CARRIED HERE TOO, for the reason classify_dispatch_request states above: a
// projection that performs its own live selection cannot be witnessed hermetically, and this one
// sits under the live-sessions fold, so the standing-refusal specimen reached http.Client.Get
// through THREE independent routes rather than one. Threading the resolved selection through the
// fold makes all three judge the SAME specimen, which is also the more correct shape -- the previous
// code made one live read per entry per clause, so a roster that changed mid-fold could return rows
// for one entry and not another with nothing recording that they disagreed.
fn dispatch_tmux_session_scope(
  node_id: RoadmapNodeId,
  selection: DispatchActuatorSelection,
) -> TmuxSessionScope? {
  match selection {
    DispatchActuatorSelectionOk { provider: _, effort: _, model: _, process_fingerprint } =>
      Present {
        value: dispatch_tmux_session_scope_for_process_fingerprint(
          node_id: node_id,
          process_fingerprint: process_fingerprint,
        ),
      }
    DispatchActuatorSelectionRefused { reason: _ } => none
  }
}

fn carrier_paths_label(carriers: List<Pointer>, repo: String) -> String {
  if count(carriers) == 0 {
    concat("dag/gunbc/roadmap/roadmap_dispatch_actuator.dag (repo=", concat(repo, ")"))
  } else {
    join(map(carriers, p => p.path), " · ")
  }
}

fn dispatch_slot_fields(node: RoadmapNode, repo: String) -> DispatchBriefFields {
  let title = node_title(item: node.line)
  match line_ticket(item: node.line) {
    Present { value: t } =>
      DispatchBriefFields {
        node_id: node.node,
        displaced_cost: t.displaced_cost,
        current_state: t.current_state,
        first_slice: t.first_slice,
        red_control: t.red_control,
        out_of_scope: t.out_of_scope,
        handback: t.handback,
        paths: carrier_paths_label(carriers: node.carriers, repo: repo),
        commands_to_run: "",
        expected_artifact: "",
      }
    Absent =>
      DispatchBriefFields {
        node_id: node.node,
        displaced_cost: title,
        current_state: title,
        first_slice: title,
        red_control: "drop modeled argv row and witness goes red",
        out_of_scope: "see parent roadmap dispatch plan",
        handback: "node not ready, foreign lease, or unsupported repo",
        paths: carrier_paths_label(carriers: node.carriers, repo: repo),
        commands_to_run: "",
        expected_artifact: "",
      }
  }
}

fn dispatch_brief_fields_for_environment(
  node: RoadmapNode,
  environment: DispatchHostEnvironment,
) -> DispatchBriefFields {
  let validation = execution_contract_validation_summary(
    contract: node.execution,
    environment: environment,
  )
  match node.dispatch {
  Dispatchable { repo, acceptance: _ } => {
    let f = dispatch_slot_fields(node: node, repo: repo)
    DispatchBriefFields {
      node_id: f.node_id,
      displaced_cost: f.displaced_cost,
      current_state: f.current_state,
      first_slice: f.first_slice,
      red_control: f.red_control,
      out_of_scope: f.out_of_scope,
      handback: f.handback,
      paths: f.paths,
      commands_to_run: validation,
      expected_artifact: "implementation diff plus receipts from the declared validation operations",
    }
  }
  NotDispatchable => {
    let f = dispatch_slot_fields(node: node, repo: "")
    DispatchBriefFields {
      node_id: f.node_id,
      displaced_cost: f.displaced_cost,
      current_state: f.current_state,
      first_slice: f.first_slice,
      red_control: f.red_control,
      out_of_scope: f.out_of_scope,
      handback: f.handback,
      paths: f.paths,
      commands_to_run: validation,
      expected_artifact: "implementation diff plus receipts from the declared validation operations",
    }
  }
  }
}

fn fill_dispatch_brief(template: String, fields: DispatchBriefFields) -> String {
  template
    .replace(from: "<node_id>", to: fields.node_id)
    .replace(from: "<displaced cost / what it unblocks>", to: fields.displaced_cost)
    .replace(from: "<explicitly out of scope>", to: fields.out_of_scope)
    .replace(from: "<prove current state / reproduce the gap>", to: fields.current_state)
    .replace(from: "<first implementation slice>", to: fields.first_slice)
    .replace(from: "<perturbation that goes red>", to: fields.red_control)
    .replace(from: "<execution on the real path>", to: fields.commands_to_run)
    .replace(from: "<named hand-back conditions>", to: fields.handback)
    .replace(from: "<paths>", to: fields.paths)
    .replace(from: "<repro/verify commands>", to: fields.commands_to_run)
    .replace(from: "<what comes back even if the fix does not land>", to: fields.expected_artifact)
}

fn filled_dispatch_brief_for_node(instance: HostDashboardInstance, node: RoadmapNode) -> String {
  dispatch_brief_with_centering(
    node: node,
    fields: dispatch_brief_fields_for_environment(node: node, environment: instance.execution_environment),
  )
}

// EVERY DISPATCHED BRIEF CARRIES THE SHARED PREAMBLE EXACTLY ONCE AND THE NODE'S CENTERING PLAN
// (operator ruling 2026-09-19: centering is a dispatch prerequisite, supplied up front, never
// re-derived per attempt). The preamble and the plan are read from their single authority
// (gunbc.roadmap.roadmap_centering) at the one join site per brief assembly -- this function and
// the continuation spawn path below -- so "exactly once" is construction, and the centering
// witness counts occurrences rather than trusting it. A node with no declared plan renders the
// roster's loud marker here, but such a brief never dispatches: the launch admission's centering
// gate refuses it first.
fn dispatch_brief_with_centering(node: RoadmapNode, fields: DispatchBriefFields) -> String {
  join([
    dispatch_centering_preamble,
    "\n\nCentering plan for this node:\n",
    node_centering_plan_text(node: node),
    "\n\n",
    fill_dispatch_brief(template: dispatch_brief_template, fields: fields),
  ], "")
}

// THE CONTINUATION BRIEF RE-ALIGNS BEFORE IT RE-BRIEFS (docs/plans/harness-work-lifecycle.md,
// alignment ladder: the continuation turn is a cadence point, and the answer rides in the
// submission's explanation). The preamble sits between the verdict prefix and the ordinary brief,
// exists only on continuation origins -- the initial brief is byte-identical to the pre-preamble
// assembly -- and EVERY level of the chain renders, node to root, because the preamble IS the
// resolution's rendered_prompt: gunbc.roadmap.roadmap_alignment is the one authority over the
// alignment answer (chain, due levels, render), and this module only concatenates. A continuation
// whose resolution is Unresolved renders a loud refusal marker here -- and never dispatches,
// because the spawn fold below gates on the same resolution value before any command exists.
fn dispatch_brief_for_origin(node: RoadmapNode, fields: DispatchBriefFields, origin: AttemptOrigin, resolution: AlignmentResolution) -> String {
  join([
    continuation_brief_prefix(origin: origin),
    match origin {
      FreshFromBase => ""
      ContinueFromAttempt { parent_attempt_key: _, branch: _, turn: _, verdict_detail: _ } =>
        dispatch_continuation_alignment_preamble(resolution: resolution)
    },
    dispatch_brief_with_centering(node: node, fields: fields),
  ], "")
}

fn dispatch_continuation_alignment_preamble(resolution: AlignmentResolution) -> String {
  match resolution {
    AlignmentReady { chain: _, due_levels: _, rendered_prompt } => rendered_prompt
    AlignmentUnresolved { cause } =>
      join([
        "\nAlignment UNRESOLVED -- this continuation does not dispatch: ",
        alignment_refusal_reason(cause: cause),
        "\n\n",
      ], "")
  }
}

