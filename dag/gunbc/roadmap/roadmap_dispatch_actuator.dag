type DispatchProviderInnerArgv
  = DispatchProviderInnerArgvReady { argv: List<String> }
  | CodexProviderExecutableAbsent { reason: NonEmptyStr }
  | CursorProviderOffCustodyHost { reason: NonEmptyStr }
  | CursorProviderCredentialUnbound { reason: NonEmptyStr }
  | CodexProviderOffCustodyHost { reason: NonEmptyStr }
  | ClaudeProviderCredentialUnbound { reason: NonEmptyStr }

// THE WORKER-TURN CREDENTIALS LIVE ON ONE HOST EACH (gunbc.cursor_harness_credential,
// gunbc.codex_harness_credential), so a Cursor or Codex spawn on any other instance host refuses here
// rather than running against an ambient login. On the custody host, codex runs with CODEX_HOME set to
// the custody directory, never the instance's ambient login, and the run holds its flock for its whole
// life.

fn provider_off_custody_host_reason(provider_label: String, custody_host: HostIdentity, instance_host: NonEmptyStr) -> NonEmptyStr {
  join([provider_label, " worker-turn credential is held only on ", custody_host as String, "; this instance runs on ", instance_host as String], "") as NonEmptyStr
}

// THE HARNESS SPAWN. The worker is this repository's own binary running a .dag entry, so there is
// no runtime to install, no provider home to seed and no version to reconcile against a committed
// lock -- most of what the three vendor arms above exist to arrange.
//
// THE TOOL COMES FROM THE CONTROLLER, THE SUBJECT IS THE WORKTREE, and conflating them was a real
// defect caught by the first wet dispatch. The argv originally passed relative source roots, so the
// worker resolved its own modules out of the attempt's checkout and died with `entry file does not
// exist` -- the worktree is branched from the base ref, which does not carry the harness.
//
// Repointing the base ref would have made that particular run work and left the error in place,
// because the error is not about which ref: a harness that must exist inside the tree it is editing
// cannot be used to work ON the harness (an attempt could break its own worker mid-turn), cannot
// start from any base ref predating it, and would silently change VERSION with the subject under
// edit. So the entry and source roots are absolute paths under the instance's repo_root -- the
// controller's own checkout, fixed for the process's life -- while the worktree reaches the worker
// as the argument that sets its tools' working directory. Tool and subject, named separately.
// THE WORKER ATTEMPT IDENTITY, minted here from the safe pieces the spawner already holds — the
// spawn argv and the alignment binding (gunbc.roadmap.roadmap_belt_actuate) both name it, so the
// mint is one function: the unit's --arg and the attempt state's binding file cannot drift apart.
// node id plus attempt key is the same uniqueness (the key hashes the id and the spawn instant) in
// a form that is a safe path segment by construction.
// Length-prefixed identity parts (main #13208): each part becomes "<len>.<part>" so a part
// carrying a separator still yields a safe path segment.
fn dispatch_launch_identity(kind: String, parts: List<String>) -> String {
  join([kind, ":", join(map(parts, p => join([to_string(string_length(s: p)), ".", p], "")), ".")], "")
}

fn dispatch_reviewer_attempt_identity(node_id: String, attempt_key: String, criterion_key: String, head_sha: String) -> String {
  dispatch_launch_identity(kind: "reviewer", parts: [node_id, attempt_key, criterion_key, head_sha])
}

fn dispatch_auditor_attempt_identity(node_id: String, attempt_key: String, head_sha: String) -> String {
  dispatch_launch_identity(kind: "auditor", parts: [node_id, attempt_key, head_sha])
}

fn dispatch_worker_attempt_identity(node_id: String, attempt_key: String) -> String {
  join(["worker:", node_id, "-", attempt_key], "")
}

// attempt_identity IS MINTED HERE FROM THE SAFE PIECES THE SPAWNER ALREADY HOLDS. The worker and
// auditor used to build it from the worktree, events and verdict paths -- all absolute, all
// rejected by the fleet ssh context's safe-segment law, so every seat bind on a host needing that
// context refused before any ssh leg (measured 2026-09-16 on srv2).
fn gunbc_harness_spawn_argv(
  gunbc_program: String,
  repo_root: String,
  worktree_path: String,
  brief: String,
  timeout_program: String,
  request_scratch_path: String,
  events_path: String,
  attempt_identity: String,
  alignment_chain_fingerprint: String,
) -> List<String> {
  concat(
    [gunbc_program, "run"],
    concat(
      dispatch_worker_source_root_words(repo_root: repo_root),
      [
        "--entry", join([repo_root, "/", gunbc_harness_worker_entry], ""),
        "--function", gunbc_harness_worker_function,
        "--arg", join(["worktree=", worktree_path], ""),
        "--arg", join(["brief=", brief], ""),
        "--arg", join(["timeout_program=", timeout_program], ""),
        "--arg", join(["request_scratch_path=", request_scratch_path], ""),
        "--arg", join(["events_path=", events_path], ""),
        "--arg", join(["repo_root=", repo_root], ""),
        "--arg", join(["gunbc_program=", gunbc_program], ""),
        "--arg", join(["attempt_identity=", attempt_identity], ""),
        "--arg", join(["alignment_chain_fingerprint=", alignment_chain_fingerprint], ""),
      ],
    ),
  )
}

data gunbc_harness_worker_entry: String = "dag/gunbc/harness/harness_cli.dag"

data gunbc_harness_worker_function: String = "harness_worker_cli"

// A LAUNCH FOR A SNAPSHOT NO TAKE WROTE HAS NO EXPRESSION HERE. Before the snapshot was a carried
// value, a selection that took none (the instance-less fold, the vendor selectors) still produced a
// Claude or Cursor argv naming the derived path, and the only refusal was the wrapper's exit 78 after a
// worktree, a session and a unit had been staged; after it was carried, the spawn still refused three
// combinations at runtime. The launch is now the sealed prepared launch, whose alternatives make the
// executor and the snapshot one fact (gunbc.dispatch_attempt_launch AttemptLaunch).
// THE CLAUDE PROCESS RECEIVES THE CREDENTIAL THE SELECTION JUDGED: the snapshot the selection TOOK
// (a gunbc.dispatch_credential_snapshot TakenCredentialSnapshot, which only the take can build), read
// into the child's environment by the grammar-emitted wrapper of gunbc.claude_code_credential and
// removed before exec -- never argv, which the process table exposes, and never the mutable custody
// file. A credential the roster names no custody for, and an API-key or profile-tree credential, refuse
// typed rather than falling back to the ambient ~/.claude profile, which is a profile on disk and not
// the authority to act.
fn claude_inner_argv_for_credential(
  credential: ClaudeCredentialRef,
  snapshot: TakenCredentialSnapshot,
  argv: List<String>,
) -> DispatchProviderInnerArgv {
  match credential {
    ClaudeOAuthTokenSecretRef { secret_ref } =>
      match claude_code_custody_path(secret_ref: secret_ref) {
        Present { value: _ } =>
          match claude_code_oauth_env_wrapped_command(token_path: taken_credential_snapshot_path(snapshot: snapshot), argv: argv, disposition: credential_snapshot_after_read_disposition()) {
            ClaudeCodeEnvWrapped { command } => DispatchProviderInnerArgvReady { argv: argv_words(command: command) }
            ClaudeCodeEnvWrapRefused { reason } => ClaudeProviderCredentialUnbound { reason: reason }
          }
        Absent =>
          ClaudeProviderCredentialUnbound {
            reason: join(["claude credential secret ", secret_ref.secret as String, " has no host custody in gunbc.claude_code_credential"], "") as NonEmptyStr,
          }
      }
    ClaudeApiKeySecretRef { secret_ref: _ } =>
      ClaudeProviderCredentialUnbound { reason: "an API-key Claude credential has no dispatch spawn binding" as NonEmptyStr }
    ClaudeStateRootRef { root: _ } =>
      ClaudeProviderCredentialUnbound { reason: "a Claude state root is a profile tree, not a credential the spawn can bind" as NonEmptyStr }
  }
}

fn dispatch_provider_inner_argv_for_launch(
  prepared: PreparedAttemptLaunch,
  session_uuid: String,
  worktree_path: String,
  brief: String,
  alignment_chain_fingerprint: String,
) -> DispatchProviderInnerArgv {
  let attempt = prepared_attempt(prepared: prepared)
  let instance = attempt.instance
  let effort = prepared_attempt_effort(prepared: prepared)
  let model = prepared_attempt_model(prepared: prepared)
  match prepared_attempt_launch_alternative(prepared: prepared) {
    SnapshotLaunch { snapshot } =>
      match taken_credential_snapshot_executor(snapshot: snapshot) {
        ClaudeFromSnapshot =>
          claude_inner_argv_for_credential(
            credential: claude_dispatch_credential(),
            snapshot: snapshot,
            argv: concat(
              [
                dispatch_capability_program(
                  environment: instance.execution_environment,
                  cap: EnvironmentBindingCapability,
                ),
                "CLAUDE_CODE_NO_FLICKER=1",
              ],
              claude_spawn_argv(
                effort: effort,
                model: model,
                brief: brief,
              ),
            ),
          )
        CursorFromSnapshot =>
          if (instance.host_identity as String) != (snapshot_custody_declaration(executor: CursorFromSnapshot).host as String) {
            CursorProviderOffCustodyHost {
              reason: provider_off_custody_host_reason(provider_label: "cursor", custody_host: snapshot_custody_declaration(executor: CursorFromSnapshot).host, instance_host: instance.host_identity),
            }
          } else {
            match cursor_worker_turn_argv(
              program: cursor_agent_pinned_program(),
              snapshot: snapshot,
              worktree_path: worktree_path,
              prompt: brief as NonEmptyStr,
            ) {
              CursorWorkerTurnArgvReady { argv } => DispatchProviderInnerArgvReady { argv: argv }
              CursorWorkerTurnRefused { reason } => CursorProviderCredentialUnbound { reason: reason }
            }
          }
      }
    SnapshotFreeLaunch { attempt: _, executor } =>
      match executor {
        CodexWithoutSnapshot =>
          if (instance.host_identity as String) != (codex_worker_turn_custody_host as String) {
            CodexProviderOffCustodyHost {
              reason: provider_off_custody_host_reason(provider_label: "codex", custody_host: codex_worker_turn_custody_host, instance_host: instance.host_identity),
            }
          } else {
            match dashboard_instance_provider_executable(instance: instance) {
              Absent =>
                CodexProviderExecutableAbsent {
                  reason: dashboard_instance_provider_executable_refusal_detail(instance: instance) as NonEmptyStr,
                }
              Present { value: codex_program } =>
                DispatchProviderInnerArgvReady {
                  argv: codex_harness_turn_argv(
                    command: shape_codex_exec_argv_for_programs(
                      env_program: dispatch_capability_program(
                        environment: instance.execution_environment,
                        cap: EnvironmentBindingCapability,
                      ),
                      program: codex_program as String,
                      codex_home: codex_worker_turn_codex_home as String,
                      cwd: worktree_path,
                      prompt: join([brief, "\n\n", dispatch_codex_start_prompt], ""),
                      reasoning_effort: effort,
                      model: model,
                      spec: dispatch_codex_exec_spec,
                    ),
                  ),
                }
            }
          }
        HarnessWithoutSnapshot =>
          DispatchProviderInnerArgvReady {
            argv: gunbc_harness_spawn_argv(
              gunbc_program: instance.serve_binary as String,
              repo_root: instance.repo_root as String,
              worktree_path: worktree_path,
              brief: brief,
              timeout_program: instance.toolchain.timeout as String,
              request_scratch_path: attempt_state_text(instance: instance, node_id: attempt.node.node, attempt_key: attempt.attempt_key, member: AttemptWorkerRequestScratch),
              events_path: attempt_state_text(instance: instance, node_id: attempt.node.node, attempt_key: attempt.attempt_key, member: AttemptWorkerEvents),
              attempt_identity: dispatch_worker_attempt_identity(node_id: attempt.node.node as String, attempt_key: attempt.attempt_key),
              alignment_chain_fingerprint: alignment_chain_fingerprint,
            ),
          }
      }
  }
}

fn tmux_spawn_inner_argv(session_name: String, worktree_path: String, inner_argv: List<String>) -> HostExecArgv {
  host_exec_argv(
    program: "tmux",
    args: shape_tmux_new_session_argv(
      session_name: session_name,
      working_dir: worktree_path,
      inner_argv: inner_argv,
    ),
  )
}

fn tmux_spawn_inner_argv_for_instance(
  instance: HostDashboardInstance,
  session_name: String,
  worktree_path: String,
  inner_argv: List<String>,
) -> HostExecArgv {
  host_exec_argv(
    program: dispatch_capability_program(
      environment: instance.execution_environment,
      cap: TmuxSessionCapability,
    ),
    args: shape_tmux_new_session_argv_for(
      scope: instance.tmux_server,
      session_name: session_name,
      working_dir: worktree_path,
      inner_argv: inner_argv,
    ),
  )
}

fn tmux_spawn_argv(session_name: String, worktree_path: String, claude_argv: List<String>) -> HostExecArgv {
  tmux_spawn_inner_argv(
    session_name: session_name,
    worktree_path: worktree_path,
    inner_argv: concat([env_path_resolved_program().invocation as String, "CLAUDE_CODE_NO_FLICKER=1"], claude_argv),
  )
}

// tmux pipe-pane is the one foreign-executor seam in attempt capture: upstream requires a
// shell-command payload. TmuxPipeCommand bounds that residue. The earlier session-environment
// design was rejected by live execution because pipe processes did not inherit tmux set-environment
// values and created no file. Staging order is state directory -> idle exact-shell pane ->
// default-shell -> remain-on-exit -> quoted pipe -> typed provider respawn, so the first provider
// byte and a fast nonzero exit are both observable. The payload itself is no longer constructed
// here: gunbc.dispatch_pipe_pane_emit builds it as a bash AST and renders it through the signed
// serializer (review 44063), which is why this module now imports an EMISSION rather than joining a
// command: a serializer refusal has no command to hand back, so
// dispatch_spawn_commands_for_launch refuses the whole plan instead of staging one (review
// 44113).

// THE PUBLICATION DIRECTORY IS PREPARED WITH THE ATTEMPT DIRECTORY, IN ONE install -d, and the
// reason it is here rather than on the write path is that the write path cannot create it. The
// Filesystem.Write intrinsic is a bare write with no parent creation, and it emits its
// `[file] write <path>` trace BEFORE attempting -- so a publication receipt written into a
// directory that does not exist logs exactly like a successful write and fails with ENOENT, which
// is how this went unnoticed. Measured on srv1 2026-08-19: zero of twelve attempt directories had
// a publication/ subdirectory, and every publish pass reported failed while the journal showed the
// write line for each one.
//
// It is not a deploy member either, and that distinction is the whole design point. The receipts
// directory (gunbc.host.host_layout instance_receipts_dir) IS bootstrapped at apply time because there
// is exactly one per instance; a publication directory belongs to an ATTEMPT, which is minted at
// runtime long after any apply, so a deploy member could only ever create directories that do not
// exist yet. The attempt's own prepare step is the earliest moment the path is known.
//
// install -d takes a list, so this is the same single command with a second directory rather than
// a new step -- the attempt directory and the one subdirectory it is required to contain come into
// existence together, and publication_receipt_directory_is_named_once_note's requirement that a
// reader be able to LIST the directory holds from attempt birth instead of from first publish.
// The worker/ child (path_parent_directory of the AttemptWorkerLog member) is
// in this same list: the belt runs attempt_state_prepare_argvs_for_instance as step
// attempt-state-prepare, then belt_attempt_state_initialize_for_instance writes
// launch-identity.json, then the unit starts. ReadWritePaths has no '-' prefix, so a missing
// worker/ is NAMESPACE 226 rather than a silent drop of the write grant (Manager B).
//
// THE MODES FOLLOW WHO ENTERS EACH DIRECTORY, keyed on the instance's worker identity. Under
// WorkerIsServiceUser the worker IS the owner, so every directory is owner-only and the command is the
// one install -d it always was. Under WorkerDedicatedAccount the worker is a foreign uid in the shared
// attempt group, and its handed set (dispatch_worker_handed_set) enters exactly three of these: it
// traverses the attempt directory, writes worker/ (its scratch directory and stdout parent), and writes
// the wire log directory inside worker/, where the harness persists each round's request and response
// bytes (the AttemptDirectoryWire directory). An owner-only attempt directory was refused at the
// worker-traversal step on the srv1 lab, 2026-10-24 (1000:1003 0700, no execute bit for the worker);
// the wire directory was first filed with the stages below as owner-only, which the same lab refused
// at the worker's first round. So the attempt directory is group-traversable and setgid, which keeps
// the group the attempt-state root hands down for the children made inside it; worker/ and the wire
// directory are group-writable setgid; the publication, verification, review and audit stages, which
// the worker never enters, stay owner-only. The attempt directory is never group-writable: the worker
// must not replace launch-identity.json or a stage directory beside it. One install -d per mode,
// attempt directory first, so each child is made inside a parent that already carries its group.
fn attempt_state_install_argv(instance: HostDashboardInstance, mode: DeclaredDirectoryMode, paths: List<String>) -> HostExecArgv {
  host_exec_argv(
    program: dispatch_capability_program(
      environment: instance.execution_environment,
      cap: AttemptStateDirectoryCapability,
    ),
    args: coreutils_install_directories_arguments(mode: declared_directory_mode(m: mode), paths: paths),
  )
}

fn attempt_state_prepare_argvs_for_instance(
  instance: HostDashboardInstance,
  node_id: RoadmapNodeId,
  attempt_key: String,
) -> List<HostExecArgv> {
  let attempt_directory = attempt_state_directory_text(instance: instance, node_id: node_id, attempt_key: attempt_key, directory: AttemptDirectoryRoot)
  let worker_scratch = attempt_state_directory_text(instance: instance, node_id: node_id, attempt_key: attempt_key, directory: AttemptDirectoryWorker)
  let stages = [
    attempt_state_directory_text(instance: instance, node_id: node_id, attempt_key: attempt_key, directory: AttemptDirectoryPublication),
    attempt_state_directory_text(instance: instance, node_id: node_id, attempt_key: attempt_key, directory: AttemptDirectoryVerification),
    attempt_state_directory_text(instance: instance, node_id: node_id, attempt_key: attempt_key, directory: AttemptDirectoryReview),
    attempt_state_directory_text(instance: instance, node_id: node_id, attempt_key: attempt_key, directory: AttemptDirectoryAudit),
  ]
  let wire = attempt_state_directory_text(instance: instance, node_id: node_id, attempt_key: attempt_key, directory: AttemptDirectoryWire)
  match instance.worker {
    WorkerIsServiceUser => [
      attempt_state_install_argv(instance: instance, mode: DirectoryOwnerOnly, paths: concat(concat([attempt_directory, worker_scratch], stages), [wire])),
    ]
    WorkerDedicatedAccount => [
      attempt_state_install_argv(instance: instance, mode: DirectoryOwnerAllGroupTraverseSetgid, paths: [attempt_directory]),
      attempt_state_install_argv(instance: instance, mode: DirectoryOwnerGroupWritableSetgid, paths: [worker_scratch, wire]),
      attempt_state_install_argv(instance: instance, mode: DirectoryOwnerOnly, paths: stages),
    ]
  }
}

// THE EMPTY EVENT STREAM IS CREATED FOR ITS WRITER. The belt creates provider-events.jsonl empty before
// launch (belt_attempt_state_initialize_for_instance), so a readable empty file proves event capture was
// initialized; the harness worker then appends every round's events to it. Under WorkerIsServiceUser the
// writer is the file's owner and the create is the plain write it always was. Under WorkerDedicatedAccount
// the writer is a foreign uid in the attempt group, and the plain write left the file owner-writable only
// (the srv1 lab refused the worker's first append, 2026-10-24, Permission denied), so the file is created
// group-writable AT CREATION -- the mode set on the new inode, never widened afterwards -- and create-only,
// because a fresh attempt has no event stream yet.
data dispatch_attempt_events_group_writable_mode: FileMode = FileMode {
  owner: PermissionBits { read: true, write: true, execute: false },
  group: PermissionBits { read: true, write: true, execute: false },
  other: PermissionBits { read: false, write: false, execute: false },
  setuid: false, setgid: false, sticky: false,
}

type DispatchAttemptEventsInitialization
  = DispatchAttemptEventsInitialized
  | DispatchAttemptEventsInitializationFailed { detail: String }

fn dispatch_attempt_events_initialize_for_instance(
  instance: HostDashboardInstance,
  node_id: RoadmapNodeId,
  attempt_key: String,
) -> DispatchAttemptEventsInitialization {
  let path = attempt_state_text(instance: instance, node_id: node_id, attempt_key: attempt_key, member: AttemptWorkerEvents)
  match instance.worker {
    WorkerIsServiceUser => {
      let written = Filesystem.Write(path: path, content: "")
      if written.success { DispatchAttemptEventsInitialized } else { DispatchAttemptEventsInitializationFailed { detail: written.error } }
    }
    WorkerDedicatedAccount => {
      let created = Filesystem.WriteCreateNewWithMode(path: path, content: "", mode: file_mode_bits(mode: dispatch_attempt_events_group_writable_mode))
      if created.success { DispatchAttemptEventsInitialized } else { DispatchAttemptEventsInitializationFailed { detail: created.error } }
    }
  }
}

fn attempt_current_pointer_argv_for_instance(
  instance: HostDashboardInstance,
  node_id: RoadmapNodeId,
  attempt_key: String,
) -> HostExecArgv {
  host_exec_argv(
    program: dispatch_capability_program(
      environment: instance.execution_environment,
      cap: AttemptCurrentPointerCapability,
    ),
    args: [
      "-sfnT",
      "--",
      attempt_state_directory_text(instance: instance, node_id: node_id, attempt_key: attempt_key, directory: AttemptDirectoryRoot),
      attempt_state_current_directory_text(instance: instance, node_id: node_id, directory: AttemptDirectoryRoot),
    ],
  )
}

fn dispatch_attempt_unit_name(node_id: String, attempt_key: String) -> SystemdUnitNameAdmission {
  if node_id == "" {
    SystemdUnitNameStemEmpty
  } else {
    systemd_service_unit_name(stem: dispatch_attempt_unit_stem(node_id: node_id, attempt_key: attempt_key))
  }
}

// THE WORKER'S UNIT PROPERTIES, and every one of them answers something the tmux path either could
// not express or had to fabricate. MemoryMax is the enforceable cgroup bound `gunbc run` requires
// before it will size its typed-module cache -- without it the worker refuses, which is exactly the
// failure this container replaces. It is the session's PLACEMENT GRANT (gunbc.roadmap.roadmap_session_placement),
// applied through the same grant-to-unit fold the compute provider uses
// (gunbc.compute.unit_bounds compute_grant_unit_properties), so the memory the ledger counts and the
// memory the cgroup enforces are one figure; it used to be the instance ceiling read directly. WorkingDirectory is the controller checkout for the reason
// dispatch_pane_working_directory states (harness: repo_root). ReadWritePaths starts with this
// attempt's worktree, not that cwd: a harness worker that ran from /source used to carve /source
// writable (bright-moth-475 on 13942, live unit ReadWritePaths). StandardOutput and StandardError append to the attempt's
// own events path, so capture is a unit property rather than a quoted shell payload piped through
// a terminal multiplexer. ExecStopPost is the attempt's exit record (gunbc.roadmap.roadmap_attempt_exit_spool
// attempt_exit_hook): one create-only mkdir whose name carries the manager's stop-time facts, written
// at the moment the worker's process ends -- the event the capture obligation is invoked on.
fn dispatch_worker_unit_properties(
  instance: HostDashboardInstance,
  working_directory: String,
  attempt_worktree: String,
  worker_log_path: String,
  granted: Kibibyte,
  process_bounds: UnitProcessBounds,
  exit_hook: NonEmptyStr,
) -> List<SystemdRunProperty> {
  dispatch_worker_unit_stream_properties(
    instance: instance,
    working_directory: working_directory,
    attempt_worktree: attempt_worktree,
    stdout_path: worker_log_path,
    stderr_path: worker_log_path,
    granted: granted,
    process_bounds: process_bounds,
    exit_hook: exit_hook,
  )
}

// THE UNIT NO LONGER OUTLIVES ITS PROCESS; THE EXIT RECORD DOES (reversal of the 2026-09-05 choice,
// bold-bee-114 ruling 2026-10-06 on dogfood intervention #4). A transient unit whose main process
// exits 0 is collected by the manager and reads LoadState=not-found a moment later. On 2026-09-05 the
// observer read not-found as "never ran", so a SUCCESSFUL worker was the one case the belt could not
// commit or verify (attempt ce21f99eb2e82ec1), and RemainAfterExit=yes was added to keep the unit
// loaded as `active (exited)` with its ExecMainStatus readable.
//
// That kept the exit observable only as manager MEMORY -- lost on a reboot, a manager restart or a
// reap -- and, because a RemainAfterExit unit never stops when its process ends, it made a stop hook
// impossible: ExecStopPost would run at teardown, not at exit, so nothing could be invoked BY the
// exit. The exit record replaces it. The hook writes it at exit, on disk, under the instance root,
// carrying the same facts ExecMainStatus did plus the manager's result and whether the process
// exited or was signaled. The observer reads the unit while it is loaded and the record once it is
// not (attempt_worker_unit_observation), and a unit that is gone with NO record is reported as
// exactly that -- never as a worker that did not run.

// THE PER-ATTEMPT PRIVATE GIT ENTRY, AS A GRANTED SUBTREE (WORKER-ROOT-EQUIVALENT-3). This is where
// a linked worktree's OWN git state lives -- HEAD, index(+.lock), logs/HEAD, ORIG_HEAD,
// COMMIT_EDITMSG -- so a worker that can write the three shared subtrees and not this one still
// cannot commit (measured: `index.lock`: Permission denied on the first commit, in
// .git/worktrees/<key>). It joins the three at the ONE place both the attempt key and the spawn are
// known, which is also why it is not in dashboard_git_worker_directory_children: no apply of an
// instance knows the attempts in advance.
//
// TWO MEASURED FACTS SHAPE IT.
//
// ONE: THE ENTRY IS OWNED BY THE INSTANCE'S PRINCIPAL, so the re-group must be performed by that same
// account -- by `git worktree add`, which on the lab is a spawn command of the serve and runs as
// instance.directory_owner.user (measured on srv1, 2026-10-17: the serve is a system unit running as
// that account, all 185 .git/worktrees/<key> entries are owned by it, and `getent group gunbc-attempt`
// shows it as a member). An earlier cut of this comment said the entry was root-owned and that only a
// root step could re-group it; that was read off a BuildBuddy runner whose uid is 0, not off the lab
// (DESIGN 4d: name where a figure or a principal was measured), and it implied a privilege the lab
// deploy does not use. WHAT THE FACT STILL REQUIRES is unchanged and still load-bearing: the re-group
// has to be done by the ENTRY'S OWNER, and it cannot be left to the worker -- chgrp to a group the
// caller is not a member of is restricted, and the worker is not the entry's owner. Hence the step is
// part of THIS actuator's spawn sequence, run between the worktree add and the unit start, under the
// same principal that just created the entry. Asserting it is still the only thing that makes the
// worker's first commit possible.
//
// TWO: the grant must be RECURSIVE over the entry, because the commit writes an existing file (its
// index, its HEAD) and creates new subdirectories (logs/, and the reflog file inside logs/) that have
// to inherit the group; the mode this demands -- the declared arm at 02770 on directories, 0664 on the
// files the sweep walks -- is exactly what core.sharedRepository=group
// makes git ask for. It also says the entry must NOT be pre-created by hand: git silently renames an entry that
// already exists (probe becomes probe1) and the grant plus the unit's ReadWritePaths= would then point
// at a directory git is not using.
fn dispatch_attempt_worker_git_entry_directories(instance: HostDashboardInstance, attempt_worktree: String) -> List<OwnedDirectoryTarget> {
  match instance.worker {
    WorkerIsServiceUser => []
    WorkerDedicatedAccount => [
      OwnedDirectoryDeclared {
        member: join(
          [
            "git-worker-entry-",
            dispatch_worktree_entry_name(attempt_worktree: attempt_worktree) as NonEmptyStr,
          ],
          "",
        ) as NonEmptyStr,
        path: dispatch_attempt_private_git_dir(instance: instance, attempt_worktree: attempt_worktree) as String as FilePath,
        owner: dashboard_instance_worker_writable_owner(instance: instance),
        mode: DirectoryOwnerGroupWritableSetgid,
        group_adoption: dashboard_instance_worker_writable_group_adoption(instance: instance),
      },
    ]
  }
}

// THE ROOT-OWNED MIGRATION OF THAT ENTRY, beside the spawn that creates it: same bounded walk, same
// group, run as the step right after `git worktree add` and before the unit starts. Without it the
// entry is root:root 0700 and the confined unit cannot write a single file inside it.
// THE PROJECTION THE SPAWN RUNS UNDER. The actuator's host steps are (program, args) pairs executed by
// the belt under the principal that runs the actuator itself -- on the lab, the account the serve runs
// as, which is the account `git worktree add` runs as and the owner of the entry just created. That
// identity is why this needs no privilege the deploy does not already have; an earlier cut of this
// comment called it root, read off a BuildBuddy runner whose uid is 0 rather than off the lab (DESIGN
// 4d). argv_words, not this module, decides that argv[0] is the program.
fn dispatch_git_owned_host_step_argv(command: ArgvCommand) -> HostExecArgv {
  let words = argv_words(command: command)
  match words.first() {
    Absent => HostExecArgv { program: "", args: [] }
    Present { value: program } => HostExecArgv { program: program, args: words.skip(n: 1) }
  }
}

// THE PROOF THE ENTRY WAS GRANTED: the same bounded walk the apply runs over the repository's subtrees,
// over this attempt's private git entry. The spawn decides on it with
// gunbc.roadmap.roadmap_dashboard_instance dashboard_git_subtree_readback_is_granted_under -- one
// figure, so the actuator, the apply and the claims cannot disagree -- and REFUSES to start the unit on
// an empty, unreadable, or wrong-moded receipt rather than starting a worker that would fail its first
// commit with a permission error nobody named.
fn dispatch_attempt_worker_git_entry_readback_command(
  instance: HostDashboardInstance,
  attempt_worktree: String,
) -> ArgvCommand {
  find_subtree_mode_readback_command(
    target: dispatch_attempt_private_git_dir(instance: instance, attempt_worktree: attempt_worktree),
    pruned: [],
    depth: dashboard_git_worker_subtree_walk_depth,
  )
}

// THE WORKTREE IS THE DEDICATED WORKER'S TO EDIT. `git worktree add` checks the attempt's worktree out as the service
// user under its umask, so every directory under the top is 2755 and every file 0644: the worker (a member of the
// attempt group, not the owner) can read the checkout and edit nothing in it. The srv1 lab's first full session
// found exactly that -- 851 of 852 directories and all 10362 files without group write -- and its model wrote its
// change beside the tree instead. So the spawn grants group write over the whole checkout (directories setgid, so a
// file the worker creates keeps the attempt group) and then proves it, refusing to start the unit while any entry
// lacks the grant. The checkout's `.git` file is pruned: it names the attempt's git directory, and the worker must
// never be able to repoint it. Unlike the shared object store, granting write on FILES here is right: this checkout
// is the attempt's alone, so a file the worker rewrites in place is its own work, never another attempt's base. A
// service-user worker owns the checkout and gets no step. The group is the caller's parameter, as below.
fn dispatch_attempt_worker_worktree_grant(
  instance: HostDashboardInstance,
  attempt_worktree: String,
  group: NonEmptyStr,
) -> List<ArgvCommand> {
  match instance.worker {
    WorkerIsServiceUser => []
    WorkerDedicatedAccount => [
      find_subtree_group_writable_command(
        target: attempt_worktree,
        pruned: [git_non_bare_git_dir_name],
        sticky: false,
        files_group_writable: true,
        depth: dashboard_git_worker_subtree_walk_depth,
      ),
      find_subtree_ungranted_entry_refusal_command(
        target: attempt_worktree,
        pruned: [git_non_bare_git_dir_name],
        group: group as String,
        depth: dashboard_git_worker_subtree_walk_depth,
      ),
    ]
  }
}

// THE SPAWN'S OWN GRANT OF THE PER-ATTEMPT ENTRY. THE GROUP IS A PARAMETER LIKE EVERY OTHER GRANT IN
// THIS SLICE: the token is a host fact the caller owns, the production caller below binds the row
// fleet_posix_accounts declares, and a witness on a host without that account supplies the token it can
// resolve. NO DEFAULT -- and the dry pairing claim
// the_production_route_names_the_declared_group_in_every_grant_command asserts the PRODUCTION route names
// the declared group, so the substituted spelling is never the only route that runs.
fn dispatch_attempt_worker_git_entry_migration(
  instance: HostDashboardInstance,
  attempt_worktree: String,
  group: NonEmptyStr,
) -> List<ArgvCommand> {
  match instance.worker {
    WorkerIsServiceUser => []
    WorkerDedicatedAccount => [
      // THE ENTRY'S TOP IS INSTALLED, NOT MERELY SWEPT, and the distinction is the round-3 finding the
      // wet witness used to hide: `git worktree add` CREATES .git/worktrees/<key> under the instance
      // principal's umask (~0755, group briansrls), and a sweep only ADDS bits -- chgrp + g+w + g+s on a
      // 0755 top lands it at a mode the readback's exact top leg refuses, never at the declared one.
      // install -d -o -g -m is the one primitive that states all three ownership fields absolutely
      // (measured on this host: an EXISTING node:node 0755 dir was restated to node:<group> at the -m
      // mode given it, file
      // contents and children untouched), so the spawn converges the entry to the same declared arm the
      // deploy converges the three shared tops to, and the grant is IDEMPOTENT: re-spawning an attempt
      // re-states the mode instead of refusing. The arm is the shared authority's non-sticky directory --
      // a sticky entry top would EPERM the instance principal's own checkout entries against the worker
      // (the argument at the sweep below) -- and the group is the caller's parameter like every other
      // grant in this slice, NO DEFAULT, with the production pairing claim asserting the declared group.
      // The admitted builder is the SAME word builder the deploy route's owned_directory_install_argv
      // uses (coreutils_install_directory_owned_arguments), so a witness that execs this step execs the
      // deploy's install.
      install_directory_owned_argv_command(
        mode: declared_directory_mode(m: DirectoryOwnerGroupWritableSetgid),
        owner: instance.directory_owner.user,
        group: group,
        path: dispatch_attempt_private_git_dir(instance: instance, attempt_worktree: attempt_worktree),
      ),
      dashboard_git_worker_subtree_chgrp_command(
        target: dispatch_attempt_private_git_dir(instance: instance, attempt_worktree: attempt_worktree),
        group: group,
        // NOTHING UNDER THE ENTRY IS CONFINED: a worktree private gitdir holds commondir, gitdir,
        // index, HEAD, ORIG_HEAD, COMMIT_EDITMSG and logs/. It has no pack, no info, no hooks, so the
        // prune group is empty -- and the builder then emits NO prune words at all rather than an
        // empty OR-group, which find would refuse as a syntax error.
        pruned: [],
      ),
      dashboard_git_worker_subtree_chmod_command(
        target: dispatch_attempt_private_git_dir(instance: instance, attempt_worktree: attempt_worktree),
        pruned: [],
        // ITS FILES DO GET g+w, and only its files: the entry holds a reflog of its own (logs/HEAD),
        // which the worker's commit OPENS IN APPEND MODE, and a reflog left at git's own read-only mode
        // dies with "unable to append: Permission denied" (measured, git 2.47.3). Its index and HEAD are
        // replaced by rename and would need only the directory's write -- so this is the whole of the
        // extra, one subtree's files, and not a sweep that makes a base object group-writable.
        files_group_writable: dashboard_git_worker_entry_writes_files_in_place(),
        // NO STICKY BIT HERE, and it is the one granted subtree where getting it wrong would BREAK the
        // feature rather than weaken it: the instance principal's `git worktree add` checks the entry
        // out, so its index and HEAD are entries OWNED BY THAT ACCOUNT inside a directory the attempt
        // group writes, and the worker's first `git add` renames index.lock OVER index -- a rename of an
        // entry whose owner is somebody else, which +t refuses with EPERM. The objects/ argument does
        // not transfer: nothing under this entry is confined, and no maintenance step writes or deletes
        // through it.
        sticky: false,
      ),
    ]
  }
}

// THE SHARED-REPOSITORY POSTURE, WRITTEN BEFORE THE WORKTREE IS ADDED, by the instance's own
// principal step
// and in this order, both measured:
//   core.sharedRepository=group  git creates the fan-out directory, the ref file and the reflog with
//                                the group bits set (0444/0664/2775). Set AFTER `git worktree add` and
//                                it is already too late for that entry: the private entry's files
//                                were created at 0644 and 0755 under the umask and the group write
//                                dies on the worker's first index.lock.
//   gc.auto=0, maintenance.auto=false  hand the automatic repack to the named maintenance job
//                                (dashboard_git_maintenance_exec_commands). `git commit` spawns
//                                `git maintenance run --auto`, whose sweep reaches for
//                                packed-refs.lock IN .git ITSELF -- confined. The commit survives it
//                                (exit 0, stderr noise) and that noise is what these two keys buy
//                                out, not a grant to the confined path.
fn dispatch_repository_shared_posture_commands(instance: HostDashboardInstance) -> List<ArgvCommand> {
  dashboard_ensure_git_shared_repository_posture(instance: instance)
}

// THE ONE MIGRATION THAT IS NOT IDEMPOTENT-AS-USUAL, and why that is fine: the walk re-groups and
// re-modes whatever exists, so re-running it after an attempt has committed only re-asserts what git
// already created under the shared posture. Its readback is dispatch_worker_git_subtree_readback.
// THE READBACK, PER GRANTED SUBTREE, as the argv that produces the receipt: one `stat` of the
// directory and one walk of the files under it. The model does not claim a migration worked because
// it was issued; the claim compares THESE readings against
// dashboard_git_worker_directory_mode_is_granted / dashboard_git_worker_file_mode_is_granted, and the
// state srv1 measured (0775, no setgid) fails them.
fn dispatch_worker_git_subtree_readback_command(target: String, pruned: List<String>) -> ArgvCommand {
  find_subtree_mode_readback_command(
    target: target,
    pruned: pruned,
    depth: dashboard_git_worker_subtree_walk_depth
  )
}

fn dispatch_worker_worktree_config(instance: HostDashboardInstance, attempt_worktree: String) -> String {
  join([dispatch_attempt_private_git_dir(instance: instance, attempt_worktree: attempt_worktree), "/config.worktree"], "")
}

fn dispatch_worker_common_git_config(instance: HostDashboardInstance) -> String {
  join([instance.repo_root as String, "/.git/config"], "")
}

fn dispatch_worker_path_is_readonly(instance: HostDashboardInstance, attempt_worktree: String, path: String) -> Bool {
  any(
    dispatch_worker_git_pointer_readonly_list(instance: instance, attempt_worktree: attempt_worktree),
    p => path == p,
  )
}

fn dispatch_worker_path_is_writable(instance: HostDashboardInstance, attempt_worktree: String, scratch_directory: String, path: String) -> Bool {
  if dispatch_worker_path_is_readonly(instance: instance, attempt_worktree: attempt_worktree, path: path) {
    false
  } else {
    any(
      dispatch_worker_writable_path_list(instance: instance, attempt_worktree: attempt_worktree, scratch_directory: scratch_directory),
      root => path == root || starts_with(s: path, prefix: join([root, "/"], "")),
    )
  }
}

type DispatchSessionContainerPlan
  = DispatchSessionContainerReady { container: DispatchSessionContainer }
  | DispatchSessionContainerUnavailable { step: NonEmptyStr, detail: String }

// WHICH CONTAINER HOLDS THE ATTEMPT, decided per provider with no default arm, so a new provider
// must state which one it needs rather than inheriting whichever was written first.
//
// The harness arm REFUSES on a host whose toolchain declares no systemd-run instead of falling back
// to tmux. That is deliberate and it is the DESIGN section 5 rule rather than a preference: the tmux
// path is precisely where this worker cannot get an enforceable memory bound, so a fallback would
// not be a degraded success, it would be a guaranteed HostBudgetUnreadable wearing the shape of a
// spawn that worked. macbook_local_toolchain answers `none` here because macOS has no systemd at
// all, which is why the field is optional rather than a path every toolchain must invent.
fn dispatch_systemd_unit_container_plan(
  instance: HostDashboardInstance,
  node_id: String,
  attempt_key: String,
  pane_working_directory: String,
  worktree_path: String,
  stdout_path: String,
  stderr_path: String,
  provider_inner: List<String>,
  unavailable_step: NonEmptyStr,
  unavailable_why: String,
) -> DispatchSessionContainerPlan {
  match instance.toolchain.systemd_run {
    Absent =>
      DispatchSessionContainerUnavailable {
        step: unavailable_step,
        detail: join([
          unavailable_why,
          ", and the toolchain for host ", instance.host_identity as String,
          " declares no systemd-run",
        ], ""),
      }
    Present { value: program } =>
      match dispatch_attempt_unit_name(node_id: node_id, attempt_key: attempt_key) {
        SystemdUnitNameStemEmpty =>
          DispatchSessionContainerUnavailable {
            step: "attempt-unit-name" as NonEmptyStr,
            detail: systemd_unit_name_refusal_detail(admission: SystemdUnitNameStemEmpty),
          }
        SystemdUnitNameDisallowedCharacter { stem: s, character: ch } =>
          DispatchSessionContainerUnavailable {
            step: "attempt-unit-name" as NonEmptyStr,
            detail: systemd_unit_name_refusal_detail(admission: SystemdUnitNameDisallowedCharacter { stem: s, character: ch }),
          }
        SystemdUnitNameOverlong { length: n } =>
          DispatchSessionContainerUnavailable {
            step: "attempt-unit-name" as NonEmptyStr,
            detail: systemd_unit_name_refusal_detail(admission: SystemdUnitNameOverlong { length: n }),
          }
        SystemdUnitNameAdmitted { name } =>
          match attempt_exit_hook(instance_root: instance.instance_root as String, node_id: node_id, attempt_key: attempt_key, role: AttemptWorkerRole, record_owner: instance.directory_owner) {
            AttemptExitHookRefused { reason } =>
              DispatchSessionContainerUnavailable { step: "worker-exit-hook" as NonEmptyStr, detail: reason as String }
            AttemptExitHookRendered { exec_line } =>
              DispatchSessionContainerReady {
                container: SystemdUnitContainer {
                  plan: DispatchWorkerUnitPlan {
                    systemd_run_program: program,
                    unit: systemd_unit_name_wire(name: name),
                    node_id: node_id,
                    attempt_key: attempt_key,
                    working_directory: pane_working_directory,
                    attempt_worktree: worktree_path,
                    stdout_path: stdout_path,
                    stderr_path: stderr_path,
                    inner_argv: provider_inner,
                    exit_hook: exec_line,
                  },
                },
              }
          }
      }
  }
}

fn dispatch_tmux_session_container_plan(
  instance: HostDashboardInstance,
  session_name: String,
  events_path: String,
  pane_working_directory: String,
  worktree_path: String,
  provider_inner: List<String>,
) -> DispatchSessionContainerPlan {
  match dispatch_attempt_pipe_emission_for_instance(
    instance: instance,
    events_path: events_path,
  ) {
    PipeEmitRefused { detail } =>
      DispatchSessionContainerUnavailable {
        step: "tmux-event-pipe-emit" as NonEmptyStr,
        detail: detail,
      }
    PipeEmitted { command } =>
      DispatchSessionContainerReady {
        container: dispatch_tmux_container(
          instance: instance,
          session_name: session_name,
          tmux_spawn: tmux_idle_spawn_argv_for_instance(
            instance: instance,
            session_name: session_name,
            worktree_path: worktree_path,
            pane_working_directory: pane_working_directory,
          ),
          pipe_command: command,
          provider_inner: provider_inner,
        ),
      }
  }
}

fn dispatch_session_container_for_provider(
  provider: DispatchCliProvider,
  instance: HostDashboardInstance,
  node_id: String,
  attempt_key: String,
  session_name: String,
  events_path: String,
  worker_log_path: String,
  pane_working_directory: String,
  worktree_path: String,
  provider_inner: List<String>,
) -> DispatchSessionContainerPlan {
  match provider {
    GunbcHarnessProvider =>
      dispatch_systemd_unit_container_plan(
        instance: instance,
        node_id: node_id,
        attempt_key: attempt_key,
        pane_working_directory: pane_working_directory,
        worktree_path: worktree_path,
        stdout_path: worker_log_path,
        stderr_path: worker_log_path,
        provider_inner: provider_inner,
        unavailable_step: "harness-transient-unit" as NonEmptyStr,
        unavailable_why: "the gunbc harness worker requires a transient unit for an enforceable memory bound",
      )
    ClaudeCodeProvider =>
      dispatch_systemd_unit_container_plan(
        instance: instance,
        node_id: node_id,
        attempt_key: attempt_key,
        pane_working_directory: pane_working_directory,
        worktree_path: worktree_path,
        stdout_path: events_path,
        stderr_path: worker_log_path,
        provider_inner: provider_inner,
        unavailable_step: "claude-transient-unit" as NonEmptyStr,
        unavailable_why: "headless Claude Code requires a transient unit so stream-json stdout is a unit property and the session placement grant is the cgroup bound",
      )
    CodexDispatchProvider =>
      dispatch_tmux_session_container_plan(
        instance: instance,
        session_name: session_name,
        events_path: events_path,
        pane_working_directory: pane_working_directory,
        worktree_path: worktree_path,
        provider_inner: provider_inner,
      )
    CursorDispatchProvider =>
      dispatch_tmux_session_container_plan(
        instance: instance,
        session_name: session_name,
        events_path: events_path,
        pane_working_directory: pane_working_directory,
        worktree_path: worktree_path,
        provider_inner: provider_inner,
      )
  }
}

fn dispatch_tmux_container(
  instance: HostDashboardInstance,
  session_name: String,
  tmux_spawn: HostExecArgv,
  pipe_command: TmuxPipeCommand,
  provider_inner: List<String>,
) -> DispatchSessionContainer {
  TmuxSessionContainer {
    spawn: tmux_spawn,
    default_shell: tmux_attempt_default_shell_argv_for_instance(
      instance: instance,
      session_name: session_name,
    ),
    remain_on_exit: tmux_attempt_remain_argv_for_instance(
      instance: instance,
      session_name: session_name,
    ),
    event_pipe: tmux_attempt_pipe_argv_for_command(
      instance: instance,
      session_name: session_name,
      command: pipe_command,
    ),
    provider_start: tmux_attempt_provider_start_argv_for_instance(
      instance: instance,
      session_name: session_name,
      inner_argv: provider_inner,
    ),
  }
}

