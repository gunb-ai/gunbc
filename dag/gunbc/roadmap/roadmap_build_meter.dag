// THE COMPACT WORK SUMMARY OF AN ISSUE, derived here and only drawn by the BuildMeter element
// (gunbc.site.element.build_meter). Every field is read from one attempt's progress projection
// (gunbc.roadmap_workflow_progress WorkflowAttemptProgress) through the authority that owns it:
// stage kinds and states from gunbc.roadmap_workflow_stage, the changed-path rule from
// gunbc.harness.harness_throughput, the handoff state from gunbc.roadmap.roadmap_submission, the
// failure identity from gunbc.workflow_reconcile, the Work tab destination from
// gunbc.roadmap_issue_location. Nothing is classified by reading text, and no word is chosen here:
// the element says the words.
//
// WHAT A ROUND'S MARKS ARE, TODAY. The ledger records, per round, how many tool calls the model
// made and how many paths the worktree reported changed afterwards. So a round yields at most two
// marks, each labelled with its evidence: tool calls of unrecorded kind, drawn in the run lane, and
// the rise of the changed-path count, drawn in the write lane. Both are legacy inferences; when the
// producer that dispatches tools stamps their kinds, those arrive as typed operations and replace
// them, and the element already draws them.

// ONE ATTEMPT'S FAILURE EVENTS, in stage order. An event is a stage obligation of the attempt
// that ended without completing, identified by its workflow obligation key (the same key the
// reconciliation reads), classified by its stage and state, with its recorded detail. A provider
// that stopped while no stage records the stop is the agent obligation's event; a blocked handoff
// that no stage records is the submission obligation's event. The Work tab lists these rows and
// the meter's digest names the first, so the link and its target are one list.
type FailureEvent {
  key: WorkflowFactKey
  kind: FailureKind
  stage: WorkflowSegmentKind
  detail: String
}

fn failure_kind_of_segment(segment: WorkflowSegment) -> FailureKind? {
  match segment.state {
    WorkflowSegmentRefused => Present { value: FailureRefused }
    WorkflowSegmentStopped => Present { value: FailureBudgetSpent }
    WorkflowSegmentFailed => Present { value: match segment.kind {
      VerificationWorkflowSegment => FailureVerificationFailed
      SubmissionWorkflowSegment => FailureHandoffBlocked
      PublicationWorkflowSegment => FailureHandoffBlocked
      EnvironmentWorkflowSegment => FailureActivityFailed
      WorkspaceWorkflowSegment => FailureActivityFailed
      AgentWorkflowSegment => FailureActivityFailed
      ReviewWorkflowSegment => FailureActivityFailed
      GoalAuditWorkflowSegment => FailureActivityFailed
    } }
    WorkflowSegmentPending => none
    WorkflowSegmentActive => none
    WorkflowSegmentComplete => none
  }
}

fn failure_event_key(node_id: String, attempt_key: String, stage: WorkflowSegmentKind) -> WorkflowFactKey {
  WorkflowFactKey {
    workflow_id: workflow_attempt_id(node_id: node_id, attempt_key: attempt_key),
    obligation_id: workflow_segment_kind_key(kind: stage),
  }
}

fn failure_kind_of_provider(provider: ProviderExecutionState) -> FailureKind? {
  match provider {
    ProviderFailed { activity: _, detail: _ } => Present { value: FailureActivityFailed }
    ProviderBudgetSpent { activity: _, detail: _ } => Present { value: FailureBudgetSpent }
    ProviderEventsRefused { activity: _, detail: _ } => Present { value: FailureRefused }
    ProviderNotStarted => none
    ProviderStarting { activity: _ } => none
    ProviderAwaitingSeat { detail: _ } => none
    ProviderRunning { activity: _ } => none
    ProviderCompleted { activity: _ } => none
  }
}

fn provider_failure_detail(provider: ProviderExecutionState) -> String {
  match provider {
    ProviderFailed { activity: _, detail } => detail
    ProviderBudgetSpent { activity: _, detail } => detail
    ProviderEventsRefused { activity: _, detail } => detail
    ProviderNotStarted => ""
    ProviderStarting { activity: _ } => ""
    ProviderAwaitingSeat { detail: _ } => ""
    ProviderRunning { activity: _ } => ""
    ProviderCompleted { activity: _ } => ""
  }
}

fn handoff_block_detail(handoff: CandidateHandoffState) -> String? {
  match handoff {
    HandoffYielded { reason } => Present { value: reason }
    HandoffDeclaredBlocked { head_sha: _, readiness: _, explanation } => Present { value: explanation }
    HandoffBlockedOnIntegration { head_sha: _, cause } => Present { value: cause }
    HandoffBlockedOnPublication { head_sha: _, cause } => Present { value: cause }
    HandoffAwaitingWorker => none
    HandoffEvidenceRefused { reason: _ } => none
    HandoffSubmitted { head_sha: _ } => none
    HandoffVerificationFailed { head_sha: _, verdict_key: _ } => none
    HandoffAwaitingIntegration { head_sha: _ } => none
    HandoffPublicationOwed { head_sha: _ } => none
    HandoffPublished { head_sha: _, pr_number: _, url: _ } => none
  }
}

fn attempt_failure_events_of(
  node_id: String,
  attempt_key: String,
  segments: List<WorkflowSegment>,
  provider: ProviderExecutionState,
  handoff: CandidateHandoffState,
) -> List<FailureEvent> {
  let staged = flat_map(segments, s => match failure_kind_of_segment(segment: s) {
    Present { value: kind } => [FailureEvent {
      key: failure_event_key(node_id: node_id, attempt_key: attempt_key, stage: s.kind),
      kind: kind,
      stage: s.kind,
      detail: workflow_segment_detail_bounded(detail: s.detail),
    }]
    Absent => []
  })
  if count(staged) > 0 { staged } else {
    match failure_kind_of_provider(provider: provider) {
      Present { value: kind } => [FailureEvent {
        key: failure_event_key(node_id: node_id, attempt_key: attempt_key, stage: AgentWorkflowSegment),
        kind: kind,
        stage: AgentWorkflowSegment,
        detail: provider_failure_detail(provider: provider),
      }]
      Absent => match handoff_block_detail(handoff: handoff) {
        Present { value: detail } => [FailureEvent {
          key: failure_event_key(node_id: node_id, attempt_key: attempt_key, stage: SubmissionWorkflowSegment),
          kind: FailureHandoffBlocked,
          stage: SubmissionWorkflowSegment,
          detail: detail,
        }]
        Absent => []
      }
    }
  }
}

fn attempt_failure_events(progress: WorkflowAttemptProgress) -> List<FailureEvent> {
  attempt_failure_events_of(node_id: progress.node_id, attempt_key: progress.attempt_key, segments: progress.segments, provider: progress.provider, handoff: progress.handoff)
}

// The digest names the first event and counts them all. No authority ties a stage failure to a
// round today (a verification judges the candidate the whole run produced; a refusal belongs to a
// stage, not a round), so the round is absent and the element draws the failure at the working
// edge; a producer that records the round an operation was refused in supplies it here.
fn failure_digest_of(node_id: String, events: List<FailureEvent>) -> FailureDigest? {
  match events.first() {
    Absent => none
    Present { value: primary } => Present { value: FailureDigest {
      kind: primary.kind,
      primary_event: primary.key,
      event_count: count(events),
      round: none,
      stage: primary.stage,
      destination: issue_work_event_path(node_id: node_id, workflow_id: primary.key.workflow_id, obligation_id: primary.key.obligation_id),
    } }
  }
}

type BuildMeterRoundFold {
  last_measured: Int?
  rounds: List<BuildMeterRound>
}

fn build_meter_round_marks(tool_calls: Int?, changed_path_rise: Int?) -> List<BuildMeterMark> {
  concat(
    match tool_calls {
      Present { value: n } => if n > 0 { [BuildMeterMark { kind: BuildMeterRun, count: n, evidence: BuildMeterToolCallCount }] } else { [] }
      Absent => []
    },
    match changed_path_rise {
      Present { value: rise } => if rise > 0 { [BuildMeterMark { kind: BuildMeterWrite, count: rise, evidence: BuildMeterChangedPathCountRise }] } else { [] }
      Absent => []
    })
}

fn build_meter_round_step(acc: BuildMeterRoundFold, r: RoundObservation) -> BuildMeterRoundFold {
  BuildMeterRoundFold {
    last_measured: match r.files_changed { Present { value: n } => Present { value: n }  Absent => acc.last_measured },
    rounds: acc.rounds.list_push(BuildMeterRound {
      step: r.step,
      marks: build_meter_round_marks(tool_calls: r.tool_calls, changed_path_rise: round_changed_path_count_rise(now: r.files_changed, last_measured: acc.last_measured)),
      input_tokens: r.input_tokens,
      output_tokens: r.output_tokens,
    }),
  }
}

// Coverage from the ledger: rounds with the last round's own recorded clock; a read ledger that
// holds none; or a ledger this instrumentation did not observe, with its reason.
fn build_meter_coverage(ledger: HarnessRoundLedger) -> BuildMeterCoverage {
  match ledger {
    RoundsUnobserved { reason } => BuildMeterRoundsNotRecorded { reason: reason as String }
    RoundsObserved { rounds } => match rounds.last() {
      Absent => BuildMeterNoRoundYet
      Present { value: last } => BuildMeterRoundsRecorded {
        rounds: fold(rounds, init: BuildMeterRoundFold { last_measured: none, rounds: [] }, f: (acc, r) => build_meter_round_step(acc: acc, r: r)).rounds,
        last_recorded_at: iso8601_utc_text(unix: last.epoch_ms / 1000),
      }
    }
  }
}

fn build_meter_is_published(handoff: CandidateHandoffState) -> Bool {
  match handoff {
    HandoffPublished { head_sha: _, pr_number: _, url: _ } => true
    HandoffAwaitingWorker => false
    HandoffYielded { reason: _ } => false
    HandoffEvidenceRefused { reason: _ } => false
    HandoffDeclaredBlocked { head_sha: _, readiness: _, explanation: _ } => false
    HandoffSubmitted { head_sha: _ } => false
    HandoffVerificationFailed { head_sha: _, verdict_key: _ } => false
    HandoffAwaitingIntegration { head_sha: _ } => false
    HandoffBlockedOnIntegration { head_sha: _, cause: _ } => false
    HandoffPublicationOwed { head_sha: _ } => false
    HandoffBlockedOnPublication { head_sha: _, cause: _ } => false
  }
}

// The pose comes from the outcome and observed activity, never from the marks. A failure stops
// the worker; a published candidate rests; otherwise the provider's observed state decides, and a
// provider that is neither running nor waiting leaves the worker idle.
fn build_meter_pose(failed: Bool, provider: ProviderExecutionState, handoff: CandidateHandoffState) -> BuildMeterPose {
  if failed {
    BuildMeterStopped
  } else if build_meter_is_published(handoff: handoff) {
    BuildMeterDone
  } else {
    match provider {
      ProviderRunning { activity: _ } => BuildMeterWorking
      ProviderStarting { activity: _ } => BuildMeterWorking
      ProviderAwaitingSeat { detail: _ } => BuildMeterWaitingForSeat
      ProviderNotStarted => BuildMeterIdle
      ProviderCompleted { activity: _ } => BuildMeterIdle
      ProviderFailed { activity: _, detail: _ } => BuildMeterStopped
      ProviderBudgetSpent { activity: _, detail: _ } => BuildMeterStopped
      ProviderEventsRefused { activity: _, detail: _ } => BuildMeterStopped
    }
  }
}

fn build_meter_segment_is_complete(state: WorkflowSegmentState) -> Bool {
  match state {
    WorkflowSegmentComplete => true
    WorkflowSegmentPending => false
    WorkflowSegmentActive => false
    WorkflowSegmentFailed => false
    WorkflowSegmentRefused => false
    WorkflowSegmentStopped => false
  }
}

// The current stage is the first one that has not completed; when every stage has, it is the
// last.
fn build_meter_current_segment(segments: List<WorkflowSegment>) -> WorkflowSegment? {
  match fold(segments, init: none, f: (acc, s) => match acc {
    Present { value: found } => Present { value: found }
    Absent => if build_meter_segment_is_complete(state: s.state) { none } else { Present { value: s } }
  }) {
    Present { value: open } => Present { value: open }
    Absent => segments.last()
  }
}

// THE ONE DERIVATION of the view. It takes the facts of an attempt the meter shows, so a claim
// about it supplies them directly; build_meter_view below is the same call on a real projection.
// Staleness is the presentation's revision comparison (gunbc.roadmap_presentation
// stale_attempt_nodes), passed in by the caller that made it.
fn build_meter_view_of(
  node_id: String,
  attempt_key: String,
  segments: List<WorkflowSegment>,
  rounds: HarnessRoundLedger,
  provider: ProviderExecutionState,
  handoff: CandidateHandoffState,
  stale: Bool,
) -> BuildMeterView {
  let failure = failure_digest_of(node_id: node_id, events: attempt_failure_events_of(node_id: node_id, attempt_key: attempt_key, segments: segments, provider: provider, handoff: handoff))
  let stage = build_meter_current_segment(segments: segments)
  BuildMeterView {
    attempt_key: attempt_key,
    attempt_label: attempt_key_short_form(key: attempt_key),
    stage: match stage { Present { value: s } => Present { value: s.kind }  Absent => none },
    stage_state: match stage { Present { value: s } => Present { value: s.state }  Absent => none },
    coverage: build_meter_coverage(ledger: rounds),
    pose: build_meter_pose(failed: match failure { Present { value: _ } => true  Absent => false }, provider: provider, handoff: handoff),
    stale: stale,
    failure: failure,
    handoff: handoff,
    destination: match failure { Present { value: d } => d.destination  Absent => issue_work_path(node_id: node_id) },
  }
}

fn build_meter_view(progress: WorkflowAttemptProgress, stale: Bool) -> BuildMeterView {
  build_meter_view_of(
    node_id: progress.node_id,
    attempt_key: progress.attempt_key,
    segments: progress.segments,
    rounds: progress.rounds,
    provider: progress.provider,
    handoff: progress.handoff,
    stale: stale,
  )
}

// THE REVISION'S PREIMAGE: the whole view and its subject, one member per field, so a value that
// can change what the element draws or says changes the revision. It is the canonical JSON of
// the view, hashed through the content-hash authority under this projection's own tag.
fn build_meter_mark_json(m: BuildMeterMark) -> JsonValue {
  json_object(members: [
    json_kv(key: "kind", value: json_string(s: build_meter_kind_key(kind: m.kind))),
    json_kv(key: "count", value: json_int(n: m.count)),
    json_kv(key: "evidence", value: json_string(s: build_meter_evidence_key(evidence: m.evidence))),
  ])
}

fn build_meter_round_json(r: BuildMeterRound) -> JsonValue {
  json_object(members: [
    json_kv(key: "step", value: json_int(n: r.step)),
    json_kv(key: "marks", value: json_array(elements: map(r.marks, m => build_meter_mark_json(m: m)))),
    json_kv(key: "input_tokens", value: json_int(n: r.input_tokens)),
    json_kv(key: "output_tokens", value: json_int(n: r.output_tokens)),
  ])
}

fn build_meter_coverage_json(c: BuildMeterCoverage) -> JsonValue {
  match c {
    BuildMeterNoRoundYet => json_object(members: [json_kv(key: "coverage", value: json_string(s: "none-yet"))])
    BuildMeterRoundsNotRecorded { reason } => json_object(members: [
      json_kv(key: "coverage", value: json_string(s: "not-recorded")),
      json_kv(key: "reason", value: json_string(s: reason)),
    ])
    BuildMeterRoundsRecorded { rounds, last_recorded_at } => json_object(members: [
      json_kv(key: "coverage", value: json_string(s: "recorded")),
      json_kv(key: "rounds", value: json_array(elements: map(rounds, r => build_meter_round_json(r: r)))),
      json_kv(key: "last_recorded_at", value: json_string(s: last_recorded_at)),
    ])
  }
}

fn build_meter_failure_json(f: FailureDigest?) -> JsonValue {
  match f {
    Absent => json_null()
    Present { value: d } => json_object(members: [
      json_kv(key: "kind", value: json_string(s: failure_kind_key(kind: d.kind))),
      json_kv(key: "workflow_id", value: json_string(s: d.primary_event.workflow_id)),
      json_kv(key: "obligation_id", value: json_string(s: d.primary_event.obligation_id)),
      json_kv(key: "event_count", value: json_int(n: d.event_count)),
      json_kv(key: "round", value: match d.round { Present { value: n } => json_int(n: n)  Absent => json_null() }),
      json_kv(key: "stage", value: json_string(s: workflow_segment_kind_key(kind: d.stage))),
      json_kv(key: "destination", value: json_string(s: d.destination)),
    ])
  }
}

fn build_meter_handoff_json(h: CandidateHandoffState) -> JsonValue {
  json_object(members: [
    json_kv(key: "state", value: json_string(s: candidate_handoff_state_key(state: h))),
    json_kv(key: "detail", value: match h {
      HandoffPublished { head_sha: _, pr_number, url: _ } => json_int(n: pr_number)
      HandoffVerificationFailed { head_sha: _, verdict_key } => json_string(s: verdict_key)
      HandoffAwaitingWorker => json_null()
      HandoffYielded { reason: _ } => json_null()
      HandoffEvidenceRefused { reason: _ } => json_null()
      HandoffDeclaredBlocked { head_sha: _, readiness: _, explanation: _ } => json_null()
      HandoffSubmitted { head_sha: _ } => json_null()
      HandoffAwaitingIntegration { head_sha: _ } => json_null()
      HandoffBlockedOnIntegration { head_sha: _, cause: _ } => json_null()
      HandoffPublicationOwed { head_sha: _ } => json_null()
      HandoffBlockedOnPublication { head_sha: _, cause: _ } => json_null()
    }),
  ])
}

fn compact_work_preimage_json(subject: String, view: BuildMeterView) -> JsonValue {
  json_object(members: [
    json_kv(key: "subject", value: json_string(s: subject)),
    json_kv(key: "attempt_key", value: json_string(s: view.attempt_key)),
    json_kv(key: "attempt_label", value: json_string(s: view.attempt_label)),
    json_kv(key: "stage", value: match view.stage { Present { value: k } => json_string(s: workflow_segment_kind_key(kind: k))  Absent => json_null() }),
    json_kv(key: "stage_state", value: match view.stage_state { Present { value: st } => json_string(s: workflow_segment_state_key(state: st))  Absent => json_null() }),
    json_kv(key: "coverage", value: build_meter_coverage_json(c: view.coverage)),
    json_kv(key: "pose", value: json_string(s: build_meter_pose_key(pose: view.pose))),
    json_kv(key: "stale", value: json_bool(b: view.stale)),
    json_kv(key: "failure", value: build_meter_failure_json(f: view.failure)),
    json_kv(key: "handoff", value: build_meter_handoff_json(h: view.handoff)),
    json_kv(key: "destination", value: json_string(s: view.destination)),
  ])
}

data compact_work_revision_tag: NonEmptyStr = "gunbc.compact-work-summary/v1" as NonEmptyStr

fn compact_work_revision(subject: String, view: BuildMeterView) -> String {
  serialize_content_hash(hash: content_hash_tagged(
    tag: compact_work_revision_tag,
    payload: content_hash_atom(value: serialize_json(v: compact_work_preimage_json(subject: subject, view: view)) as NonEmptyStr),
  )) as String
}

fn compact_work_summary_of_view(subject: String, view: BuildMeterView) -> CompactWorkSummary {
  CompactWorkSummary { subject: subject, view: view, revision: compact_work_revision(subject: subject, view: view) }
}

fn compact_work_summary_of(progress: WorkflowAttemptProgress, stale: Bool) -> CompactWorkSummary {
  compact_work_summary_of_view(subject: progress.node_id, view: build_meter_view(progress: progress, stale: stale))
}

// WHETHER AN ISSUE HAS A COMPACT WORK SUMMARY AT ALL is decided here, not by the page: an issue
// held by the Fabric workflow with an attempt has one, over its latest attempt (the caller's list
// is newest first); held by anyone else, unassigned, or with no attempt, it has none and nothing
// is placed.
fn compact_work_summary(holder: EventPrincipal?, attempts: List<WorkflowAttemptProgress>, stale: Bool) -> CompactWorkSummary? {
  match holder {
    Absent => none
    Present { value: p } =>
      if !event_principal_is_fabric(p: p) { none } else {
        match attempts.first() {
          Absent => none
          Present { value: latest } => Present { value: compact_work_summary_of(progress: latest, stale: stale) }
        }
      }
  }
}

// THE REVISION ON THE WORKFLOW WIRE. Every observation carries every attempt's revision; a page
// that shows a meter whose drawn revision differs asks its issue page for the rendering, so the
// browser never draws a meter itself. The wire and the page compute it with the same function
// from the same projection and the same staleness, so an unchanged attempt never asks.
fn attempt_view_revision(progress: WorkflowAttemptProgress, stale: Bool) -> String {
  compact_work_summary_of(progress: progress, stale: stale).revision
}
