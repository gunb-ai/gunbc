module gunbc.roadmap.roadmap_event_carrier

import gunbc.roadmap.roadmap_task_projection { roadmap_task_append_admits, roadmap_task_graph_refusal }

import std.types { String, Int, Bool, List, NonEmptyStr }
import std.nat { Nat }
import gunbc.fabric_storage_protocol { fabric_storage_closure_bound_cap }
import extdeps.languages.json.parse { parse_json_document, JsonDocumentParsed, json_field_string, FieldRead }
import std.list { distinct_by_key }
import std.fabric_storage {
  FabricObject, FabricObjectRef, FabricStoredObject, FabricHeadExpectation, FabricHeadReading,
  FabricHeadAbsent, FabricHeadAt, ExpectHeadAbsent, ExpectHeadAt,
  FabricClosureRead, FabricClosureBudgetExhausted, FabricClosureRefused,
  FabricObjectStored, FabricPutRefused, FabricHeadAdvanced, FabricHeadMoved, FabricHeadAdvanceRefused,
  fabric_object_ref_eq, fabric_object_ref_of, fabric_object_ref_wire, fabric_storage_fault_wire,
}
import gunbc.fabric_storage_client { FabricStorageBinding, fabric_storage_closure, fabric_storage_put, fabric_storage_advance }
import gunbc.roadmap_model { RoadmapNodeId }
import gunbc.roadmap.roadmap_event_log {
  RoadmapEvent, RoadmapEventEnvelope, RoadmapEventId, roadmap_event_envelope, roadmap_event_wire_text, roadmap_event_heads,
  RoadmapEventDecoded, RoadmapEventUndecodable, roadmap_event_decode,
  NodeStandingRow, RoadmapStandings, StandingsObserved, StandingsUnobserved, roadmap_node_standing,
}

// The event model and IDs are unchanged. One fabric head publishes the complete set atomically;
// its manifest links immutable original event bytes, including historical schema generations.
// No runtime read or write consults a Git worktree. Import is a separate pinned-source operation.
data roadmap_event_manifest_schema: NonEmptyStr = "roadmap-event-set/v1"
data roadmap_event_store_head: NonEmptyStr = "roadmap-events-v1"
data roadmap_event_read_bound: Nat = fabric_storage_closure_bound_cap

type RoadmapCarrierMode = RoadmapImportTarget | RoadmapMigratedService
type RoadmapEventCarrierLayout { store: FabricStorageBinding, mode: RoadmapCarrierMode }
fn roadmap_event_carrier_layout(store: FabricStorageBinding) -> RoadmapEventCarrierLayout { RoadmapEventCarrierLayout { store: store, mode: RoadmapImportTarget } }
fn roadmap_event_carrier_service_layout(store: FabricStorageBinding) -> RoadmapEventCarrierLayout { RoadmapEventCarrierLayout { store: store, mode: RoadmapMigratedService } }
data roadmap_migration_gate_head: NonEmptyStr = "roadmap-events-initialized-v1"
data roadmap_migration_gate_schema: NonEmptyStr = "roadmap-event-initialization/v1"
data roadmap_import_receipt_head: NonEmptyStr = "roadmap-events-import-receipt-v1"
data roadmap_import_receipt_schema: String = "roadmap-event-import/v1"


type RoadmapEventAppend
  = EventAppended { id: RoadmapEventId }
  | EventAlreadyPresent { id: RoadmapEventId }
  | EventAppendRefused { id: RoadmapEventId, step: String, reason: String }
type RoadmapEventsRead
  = EventsRead { node: RoadmapNodeId, envelopes: List<RoadmapEventEnvelope> }
  | EventsReadRefused { node: RoadmapNodeId, step: String, reason: String }

type RoadmapStoredEvent { envelope: RoadmapEventEnvelope, object: FabricObjectRef, wire: NonEmptyStr }
type RoadmapEventSnapshot { expected: FabricHeadExpectation, events: List<RoadmapStoredEvent> }
type RoadmapEventSnapshotRead
  = RoadmapEventSnapshotObserved { snapshot: RoadmapEventSnapshot }
  | RoadmapEventSnapshotRefused { step: String, reason: String }

fn roadmap_event_object(wire: NonEmptyStr) -> FabricObject { FabricObject { links: [], body: wire } }
fn roadmap_event_manifest(events: List<RoadmapStoredEvent>) -> FabricObject {
  FabricObject { links: map(events, e => e.object), body: roadmap_event_manifest_schema }
}

fn roadmap_snapshot_decode_events(expected: FabricHeadExpectation, objects: List<FabricStoredObject>) -> RoadmapEventSnapshotRead {
  fold(objects, init: RoadmapEventSnapshotObserved { snapshot: RoadmapEventSnapshot { expected: expected, events: [] } }, f: (acc, stored) => match acc {
    RoadmapEventSnapshotRefused { step, reason } => RoadmapEventSnapshotRefused { step: step, reason: reason }
    RoadmapEventSnapshotObserved { snapshot } =>
      if stored.content.links.count() != 0 { RoadmapEventSnapshotRefused { step: "decode", reason: "event object unexpectedly links other objects" } }
      else { match roadmap_event_decode(text: stored.content.body as String) {
        RoadmapEventUndecodable { reason } => RoadmapEventSnapshotRefused { step: "decode", reason: reason }
        RoadmapEventDecoded { envelope } =>
          if any(snapshot.events, e => e.envelope.id == envelope.id) { RoadmapEventSnapshotRefused { step: "decode", reason: "duplicate event identity in manifest" } }
          else { RoadmapEventSnapshotObserved { snapshot: RoadmapEventSnapshot {
            expected: expected, events: snapshot.events + [RoadmapStoredEvent { envelope: envelope, object: stored.object, wire: stored.content.body }],
          } } }
      } }
  })
}

fn roadmap_snapshot_from_closure(observation: FabricClosureRead) -> RoadmapEventSnapshotRead {
  match observation {
    FabricClosureRefused { fault } => RoadmapEventSnapshotRefused { step: "read", reason: fabric_storage_fault_wire(fault: fault) }
    FabricClosureBudgetExhausted { at: _, bound } => RoadmapEventSnapshotRefused { step: "read", reason: join(["event closure exceeds bound ", to_string(bound), "; no truncated history returned"], "") }
    FabricClosureRead { reading: FabricHeadAbsent, newest_first } =>
      if newest_first.count() != 0 { RoadmapEventSnapshotRefused { step: "read", reason: "absent head returned objects" } }
      else { RoadmapEventSnapshotObserved { snapshot: RoadmapEventSnapshot { expected: ExpectHeadAbsent, events: [] } } }
    FabricClosureRead { reading: FabricHeadAt { object: head, generation: _ }, newest_first } => {
      let manifests = filter(newest_first, stored => fabric_object_ref_eq(a: stored.object, b: head))
      if manifests.count() != 1 { RoadmapEventSnapshotRefused { step: "read", reason: "head manifest missing or duplicated in closure" } }
      else { match manifests.first() {
        Absent => RoadmapEventSnapshotRefused { step: "read", reason: "head manifest unavailable" }
        Present { value: manifest } => {
          let events = filter(newest_first, stored => !fabric_object_ref_eq(a: stored.object, b: head))
          if manifest.content.body != roadmap_event_manifest_schema { RoadmapEventSnapshotRefused { step: "decode", reason: "unknown roadmap event manifest schema" } }
          else if events.count() != manifest.content.links.count() || distinct_by_key(xs: manifest.content.links, key: r => fabric_object_ref_wire(object: r) as String).count() != manifest.content.links.count() { RoadmapEventSnapshotRefused { step: "read", reason: "event manifest closure is incomplete or duplicates links" } }
          else if !all(events, event => any(manifest.content.links, link => fabric_object_ref_eq(a: link, b: event.object))) { RoadmapEventSnapshotRefused { step: "read", reason: "closure contains an event not named by the manifest" } }
          else { roadmap_snapshot_decode_events(expected: ExpectHeadAt { object: head }, objects: events) }
        }
      } }
    }
  }
}

fn roadmap_event_snapshot_read(layout: RoadmapEventCarrierLayout) -> RoadmapEventSnapshotRead {
  let decoded = roadmap_snapshot_from_closure(observation: fabric_storage_closure(binding: layout.store, name: roadmap_event_store_head, bound: roadmap_event_read_bound))
  match layout.mode {
    RoadmapImportTarget => decoded
    RoadmapMigratedService => match decoded {
      RoadmapEventSnapshotRefused { step: _, reason: _ } => decoded
      RoadmapEventSnapshotObserved { snapshot: observed } => roadmap_migration_gate_check(snapshot: observed,
        observation: fabric_storage_closure(binding: layout.store, name: roadmap_migration_gate_head, bound: roadmap_event_read_bound))
    }
  }
}

fn roadmap_event_append_snapshot(layout: RoadmapEventCarrierLayout, snapshot: RoadmapEventSnapshot, event: RoadmapEvent) -> RoadmapEventAppend {
  let envelope = roadmap_event_envelope(e: event)
  let wire = roadmap_event_wire_text(env: envelope) as NonEmptyStr
  let prior = filter(snapshot.events, stored => stored.envelope.id == envelope.id)
  if prior.count() != 0 {
    if all(prior, stored => stored.wire == wire) { EventAlreadyPresent { id: envelope.id } }
    else { EventAppendRefused { id: envelope.id, step: "identity", reason: "event ID is already bound to different bytes" } }
  } else if !roadmap_event_wire_admits(envelope: envelope, wire: wire) { EventAppendRefused { id: envelope.id, step: "encode", reason: "proposed event cannot be read back under the current schema" } }
  else if !roadmap_task_append_admits(event: event, events: map(snapshot.events, item => item.envelope)) { EventAppendRefused { id: envelope.id, step: "editorial", reason: "editorial creation or revision violates node identity, code-contract binding, or relationships" } }
  else if !roadmap_event_parent_admits(snapshot: snapshot, event: event) { EventAppendRefused { id: envelope.id, step: "revision", reason: "event parent is not the unique current node revision; reread before editing" } }
  else if (match roadmap_task_graph_refusal(events: map(snapshot.events, item => item.envelope) + [envelope], allow_unresolved: layout.mode == RoadmapImportTarget) {
    Present { value: _ } => true Absent => false
  }) { EventAppendRefused { id: envelope.id, step: "relationships", reason: "proposed history has unreadable editorial state, unknown prerequisites, or a dependency cycle" } }
  else { match fabric_storage_put(binding: layout.store, object: roadmap_event_object(wire: wire)) {
    FabricPutRefused { fault } => EventAppendRefused { id: envelope.id, step: "put-event", reason: fabric_storage_fault_wire(fault: fault) }
    FabricObjectStored { object: event_ref } => {
      let manifest = roadmap_event_manifest(events: snapshot.events + [RoadmapStoredEvent { envelope: envelope, object: event_ref, wire: wire }])
      match fabric_storage_put(binding: layout.store, object: manifest) {
        FabricPutRefused { fault } => EventAppendRefused { id: envelope.id, step: "put-manifest", reason: fabric_storage_fault_wire(fault: fault) }
        FabricObjectStored { object: next } => match fabric_storage_advance(binding: layout.store, name: roadmap_event_store_head, expected: snapshot.expected, target: next) {
          FabricHeadAdvanced { object: _, generation: _ } => EventAppended { id: envelope.id }
          FabricHeadAdvanceRefused { fault } => EventAppendRefused { id: envelope.id, step: "advance", reason: fabric_storage_fault_wire(fault: fault) }
          FabricHeadMoved { expected: _, observed: _ } => roadmap_event_append_reconcile(layout: layout, envelope: envelope, wire: wire)
        }
      }
    }
  } }
}

// A lost publication is observed, never reported successful merely because its object exists.
fn roadmap_event_append_reconcile(layout: RoadmapEventCarrierLayout, envelope: RoadmapEventEnvelope, wire: NonEmptyStr) -> RoadmapEventAppend {
  match roadmap_event_snapshot_read(layout: layout) {
    RoadmapEventSnapshotRefused { step, reason } => EventAppendRefused { id: envelope.id, step: step, reason: reason }
    RoadmapEventSnapshotObserved { snapshot } =>
      if any(snapshot.events, stored => stored.envelope.id == envelope.id && stored.wire == wire) { EventAlreadyPresent { id: envelope.id } }
      else { EventAppendRefused { id: envelope.id, step: "advance", reason: "another writer advanced the event head; reread before retrying" } }
  }
}

fn roadmap_event_append(layout: RoadmapEventCarrierLayout, event: RoadmapEvent) -> RoadmapEventAppend {
  let envelope = roadmap_event_envelope(e: event)
  match roadmap_event_snapshot_read(layout: layout) {
    RoadmapEventSnapshotRefused { step, reason } => EventAppendRefused { id: envelope.id, step: step, reason: reason }
    RoadmapEventSnapshotObserved { snapshot } => roadmap_event_append_snapshot(layout: layout, snapshot: snapshot, event: event)
  }
}

fn roadmap_events_read(layout: RoadmapEventCarrierLayout, node: RoadmapNodeId) -> RoadmapEventsRead {
  match roadmap_event_snapshot_read(layout: layout) {
    RoadmapEventSnapshotRefused { step, reason } => EventsReadRefused { node: node, step: step, reason: reason }
    RoadmapEventSnapshotObserved { snapshot } => EventsRead { node: node, envelopes: map(filter(snapshot.events, e => e.envelope.event.node == node), e => e.envelope) }
  }
}

fn roadmap_standings_read(layout: RoadmapEventCarrierLayout) -> RoadmapStandings {
  match roadmap_event_snapshot_read(layout: layout) {
    RoadmapEventSnapshotRefused { step, reason } => StandingsUnobserved { reason: join([step, ": ", reason], "") }
    RoadmapEventSnapshotObserved { snapshot } => {
      let nodes = distinct_by_key(xs: map(snapshot.events, e => e.envelope.event.node), key: node => node as String)
      StandingsObserved { rows: map(nodes, node => NodeStandingRow { node_id: node as String, standing: roadmap_node_standing(envs: map(filter(snapshot.events, e => e.envelope.event.node == node), e => e.envelope)) }) }
    }
  }
}
type EventFileRead
  = EventFileContent { content: String }
  | EventFileUnreadable { detail: String }

fn roadmap_events_decode_reads(node: RoadmapNodeId, reads: List<EventFileRead>) -> RoadmapEventsRead {
  if any(reads, r => match r { EventFileUnreadable { detail: _ } => true  EventFileContent { content: _ } => false }) {
    EventsReadRefused { node: node, step: "read", reason: join(fold(reads, init: [], f: (acc, r) => match r { EventFileUnreadable { detail } => concat(acc, [detail])  EventFileContent { content: _ } => acc }), "; ") }
  } else {
    let decoded = map(reads, r => match r { EventFileContent { content } => roadmap_event_decode(text: content)  EventFileUnreadable { detail } => RoadmapEventUndecodable { reason: detail } })
    if any(decoded, d => match d { RoadmapEventUndecodable { reason: _ } => true  RoadmapEventDecoded { envelope: _ } => false }) {
      EventsReadRefused { node: node, step: "decode", reason: join(fold(decoded, init: [], f: (acc, d) => match d { RoadmapEventUndecodable { reason } => concat(acc, [reason])  RoadmapEventDecoded { envelope: _ } => acc }), "; ") }
    } else {
      EventsRead { node: node, envelopes: fold(decoded, init: [], f: (acc, d) => match d { RoadmapEventDecoded { envelope } => concat(acc, [envelope])  RoadmapEventUndecodable { reason: _ } => acc }) }
    }
  }
}


// The event's parent is the mutation precondition. Publication CAS also fences concurrent writers
// between this snapshot and the head advance; no HTTP-only revision check is trusted.
fn roadmap_event_parent_admits(snapshot: RoadmapEventSnapshot, event: RoadmapEvent) -> Bool {
  let existing = map(filter(snapshot.events, stored => stored.envelope.event.node == event.node), stored => stored.envelope)
  let heads = roadmap_event_heads(envs: existing)
  if existing.count() == 0 { match event.parent { Absent => true Present { value: _ } => false } }
  else if heads.count() != 1 { false }
  else { match heads.first() {
    Absent => false
    Present { value: head } => match event.parent { Absent => false Present { value: expected } => expected == head.id }
  } }
}

// Validate the exact bytes before publishing any event head. Typed in-process callers still
// cannot publish a duplicate dependency list or a legacy principal in the current schema.
fn roadmap_event_wire_admits(envelope: RoadmapEventEnvelope, wire: NonEmptyStr) -> Bool {
  match roadmap_event_decode(text: wire as String) {
    RoadmapEventDecoded { envelope: decoded } => decoded.id == envelope.id
    RoadmapEventUndecodable { reason: _ } => false
  }
}

fn roadmap_is_import_receipt(content: FabricObject) -> Bool {
  match parse_json_document(s: content.body as String) {
    JsonDocumentParsed { value: doc } => match json_field_string(obj: doc, key: "schema") {
      FieldRead { value: schema_wire } => schema_wire == roadmap_import_receipt_schema
      _ => false
    }
    _ => false
  }
}

// A production reader must observe a completed migration, and its current head must retain
// every imported/seeded baseline event. Missing initialization is not an empty task collection.
fn roadmap_migration_gate_check(snapshot: RoadmapEventSnapshot, observation: FabricClosureRead) -> RoadmapEventSnapshotRead {
  match observation {
    FabricClosureRead { reading: FabricHeadAt { object: marker_ref, generation: _ }, newest_first: objects } => {
      let markers = filter(objects, item => fabric_object_ref_eq(a: item.object, b: marker_ref))
      match markers.first() {
        Absent => RoadmapEventSnapshotRefused { step: "migration", reason: "initialization marker object is missing" }
        Present { value: marker } => if markers.count() != 1 || marker.content.body != roadmap_migration_gate_schema || marker.content.links.count() != 2 {
          RoadmapEventSnapshotRefused { step: "migration", reason: "initialization marker has an invalid shape" }
        } else {
          let direct = filter(objects, item => any(marker.content.links, linked => fabric_object_ref_eq(a: linked, b: item.object)))
          let baselines = filter(direct, item => item.content.body == roadmap_event_manifest_schema)
          let receipts = filter(direct, item => roadmap_is_import_receipt(content: item.content))
          if baselines.count() != 1 || receipts.count() != 1 { RoadmapEventSnapshotRefused { step: "migration", reason: "initialization does not bind one import receipt and one baseline manifest" } }
          else { match baselines.first() {
            Absent => RoadmapEventSnapshotRefused { step: "migration", reason: "baseline manifest is missing" }
            Present { value: baseline } => if (match snapshot.expected { ExpectHeadAbsent => false ExpectHeadAt { object: _ } => true }) && all(baseline.content.links, required => any(snapshot.events, actual => fabric_object_ref_eq(a: required, b: actual.object))) {
              match roadmap_task_graph_refusal(events: map(snapshot.events, item => item.envelope), allow_unresolved: false) {
                Present { value: detail } => RoadmapEventSnapshotRefused { step: "relationships", reason: detail }
                Absent => RoadmapEventSnapshotObserved { snapshot: snapshot }
              }
            } else { RoadmapEventSnapshotRefused { step: "migration", reason: "current event head lost imported or seeded history" } }
          } }
        }
      }
    }
    _ => RoadmapEventSnapshotRefused { step: "migration", reason: "roadmap state migration is not completed or its receipt is unreadable" }
  }
}

type RoadmapAllEventsRead
  = AllEventsRead { envelopes: List<RoadmapEventEnvelope> }
  | AllEventsReadRefused { step: String, reason: String }

fn roadmap_events_read_all(layout: RoadmapEventCarrierLayout) -> RoadmapAllEventsRead {
  match roadmap_event_snapshot_read(layout: layout) {
    RoadmapEventSnapshotObserved { snapshot: current } => AllEventsRead { envelopes: map(current.events, item => item.envelope) }
    RoadmapEventSnapshotRefused { step: failed_step, reason: detail } => AllEventsReadRefused { step: failed_step, reason: detail }
  }
}

fn roadmap_all_events_of_reads(reads: List<RoadmapEventsRead>) -> RoadmapAllEventsRead {
  fold(reads, init: AllEventsRead { envelopes: [] }, f: (acc, reading) => match acc {
    AllEventsReadRefused { step: _, reason: _ } => acc
    AllEventsRead { envelopes: prior } => match reading {
      EventsRead { node: _, envelopes: next } => AllEventsRead { envelopes: prior + next }
      EventsReadRefused { node: failed_node, step: failed_step, reason: detail } =>
        AllEventsReadRefused { step: join(["node ", failed_node as String, " ", failed_step], ""), reason: detail }
    }
  })
}
