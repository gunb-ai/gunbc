// The issue command boundary is carrier-independent. This Git realization publishes the issue
// revision and operation receipt together with an exact remote-ref compare-and-swap. Each read
// or append owns a private snapshot; fetching cannot reset another request's index or precondition.
// A failed read remains a refusal. Publication conflicts never rebase a stale issue command.
// Operation retries bind issue, principal, payload and original precondition, and recover the
// committed event before checking the current revision. Timestamps are result data, not identity.
data roadmap_events_branch: NonEmptyStr = "roadmap-events" as NonEmptyStr
data roadmap_events_remote: String = "origin"
data roadmap_events_dir_segment: String = "events"

// The carrier's host layout: a worktree of the instance repository, beside the instance's other roots.
type RoadmapEventCarrierLayout {
  repo_root: FilePath
  worktree: FilePath
  git_program: String
  directory_program: String
}

// Built from the instance the way the dispatch actuator builds attempt roots: the repository, the
// instance root the worktree hangs under, and the host's git and directory (install) realizations.
fn roadmap_event_carrier_layout_for_instance(instance: HostDashboardInstance) -> RoadmapEventCarrierLayout {
  RoadmapEventCarrierLayout {
    repo_root: instance.repo_root,
    worktree: join([instance.instance_root as String, "/roadmap-events"], "") as FilePath,
    git_program: dispatch_capability_program(environment: instance.execution_environment, cap: GitWorkspaceCapability),
    directory_program: dispatch_capability_program(environment: instance.execution_environment, cap: AttemptStateDirectoryCapability),
  }
}

fn roadmap_event_carrier_layout(repo_root: FilePath, instance_root: FilePath, git_program: String, directory_program: String) -> RoadmapEventCarrierLayout {
  RoadmapEventCarrierLayout {
    repo_root: repo_root,
    worktree: join([instance_root as String, "/roadmap-events"], "") as FilePath,
    git_program: git_program,
    directory_program: directory_program,
  }
}

fn roadmap_event_node_dir(layout: RoadmapEventCarrierLayout, node: RoadmapNodeId) -> String {
  join([layout.worktree as String, "/", roadmap_events_dir_segment, "/", node as String], "")
}

fn roadmap_event_file_relative(node: RoadmapNodeId, id: RoadmapEventId) -> String {
  join([roadmap_events_dir_segment, "/", node as String, "/", id as String, ".json"], "")
}

fn roadmap_event_push_refspec() -> String {
  join([roadmap_events_branch as String, ":", roadmap_events_branch as String], "")
}

fn roadmap_event_commit_message(env: RoadmapEventEnvelope) -> String {
  join(["roadmap event ", env.id as String, " on ", env.event.node as String], "")
}

type RoadmapEventAppend
  = EventAppended { id: RoadmapEventId }
  | EventAlreadyPresent { id: RoadmapEventId }
  | EventAppendRefused { id: RoadmapEventId, step: String, reason: String }

type RoadmapEventsRead
  = EventsRead { node: RoadmapNodeId, envelopes: List<RoadmapEventEnvelope> }
  | EventsReadRefused { node: RoadmapNodeId, step: String, reason: String }

type CarrierExec
  = CarrierExecOk { stdout: String }
  | CarrierExecFailed { exit_code: Int, stderr: String }

fn carrier_exec(layout: RoadmapEventCarrierLayout, workdir: String, args: List<String>) -> CarrierExec {
  carrier_exec_program(program: layout.git_program, workdir: workdir, args: args)
}

fn carrier_exec_program(program: String, workdir: String, args: List<String>) -> CarrierExec {
  let r = gunbc.WitnessBin.Run(workdir: workdir as FilePath, bin_path: program as FilePath, args: args, expect: OutcomeIsData)
  if r.success { CarrierExecOk { stdout: r.stdout } } else { CarrierExecFailed { exit_code: r.exit_code, stderr: r.stderr } }
}

// ENSURE THE WORKTREE. Present: nothing to do. Absent and the remote has the branch: check it out.
// Absent and the remote has no branch yet: create the orphan branch with one empty commit and push
// it, so the FIRST event has a parent tree to land in. Each step that fails is named.
type CarrierEnsure = CarrierReady | CarrierEnsureRefused { step: String, reason: String }

fn roadmap_event_carrier_ensure(layout: RoadmapEventCarrierLayout) -> CarrierEnsure {
  let probe = Filesystem.List(path: layout.worktree as String)
  if probe.success {
    CarrierReady
  } else {
    match carrier_exec(layout: layout, workdir: layout.repo_root as String, args: shape_git_ls_remote_heads_args(remote: roadmap_events_remote, branch: roadmap_events_branch)) {
      CarrierExecFailed { exit_code, stderr } => CarrierEnsureRefused { step: "ls-remote", reason: join(["exit ", to_string(value: exit_code), ": ", stderr], "") }
      CarrierExecOk { stdout } =>
        if trim(stdout) != "" {
          match carrier_exec(layout: layout, workdir: layout.repo_root as String, args: ["fetch", roadmap_events_remote, join([roadmap_events_branch as String, ":", roadmap_events_branch as String], "")]) {
            CarrierExecFailed { exit_code, stderr } => CarrierEnsureRefused { step: "fetch-branch", reason: join(["exit ", to_string(value: exit_code), ": ", stderr], "") }
            CarrierExecOk { stdout: _ } =>
              match carrier_exec(layout: layout, workdir: layout.repo_root as String, args: shape_git_worktree_add_branch_argv(path: layout.worktree, branch: roadmap_events_branch)) {
                CarrierExecFailed { exit_code, stderr } => CarrierEnsureRefused { step: "worktree-add", reason: join(["exit ", to_string(value: exit_code), ": ", stderr], "") }
                CarrierExecOk { stdout: _ } => CarrierReady
              }
          }
        } else {
          match carrier_exec(layout: layout, workdir: layout.repo_root as String, args: shape_git_worktree_add_detached_argv(path: layout.worktree, commit: "HEAD" as GitRef)) {
            CarrierExecFailed { exit_code, stderr } => CarrierEnsureRefused { step: "worktree-add-detached", reason: join(["exit ", to_string(value: exit_code), ": ", stderr], "") }
            CarrierExecOk { stdout: _ } =>
              match carrier_exec(layout: layout, workdir: layout.worktree as String, args: shape_git_checkout_orphan_args(branch: roadmap_events_branch)) {
                CarrierExecFailed { exit_code, stderr } => CarrierEnsureRefused { step: "checkout-orphan", reason: join(["exit ", to_string(value: exit_code), ": ", stderr], "") }
                CarrierExecOk { stdout: _ } =>
                  match carrier_exec(layout: layout, workdir: layout.worktree as String, args: ["rm", "-rfq", "--cached", "--ignore-unmatch", "."]) {
                    CarrierExecFailed { exit_code, stderr } => CarrierEnsureRefused { step: "orphan-unstage", reason: join(["exit ", to_string(value: exit_code), ": ", stderr], "") }
                    CarrierExecOk { stdout: _ } =>
                      match carrier_exec(layout: layout, workdir: layout.worktree as String, args: ["clean", "-fdq"]) {
                        CarrierExecFailed { exit_code, stderr } => CarrierEnsureRefused { step: "orphan-clean", reason: join(["exit ", to_string(value: exit_code), ": ", stderr], "") }
                        CarrierExecOk { stdout: _ } =>
                          match carrier_exec(layout: layout, workdir: layout.worktree as String, args: shape_git_commit_allow_empty_args(message: "roadmap events: root")) {
                            CarrierExecFailed { exit_code, stderr } => CarrierEnsureRefused { step: "root-commit", reason: join(["exit ", to_string(value: exit_code), ": ", stderr], "") }
                            CarrierExecOk { stdout: _ } =>
                              match carrier_exec(layout: layout, workdir: layout.worktree as String, args: ["push", "-q", roadmap_events_remote, roadmap_event_push_refspec()]) {
                                CarrierExecFailed { exit_code, stderr } => CarrierEnsureRefused { step: "root-push", reason: join(["exit ", to_string(value: exit_code), ": ", stderr], "") }
                                CarrierExecOk { stdout: _ } => CarrierReady
                              }
                          }
                      }
                  }
              }
          }
        }
    }
  }
}

// SYNC TO THE REMOTE'S BRANCH HEAD before reading or appending: fetch, then reset the worktree hard
// to the remote branch. Local state that was never pushed is discarded here on purpose -- an event
// that failed to publish is not part of the shared log, and the append reports that refusal itself.
fn roadmap_event_carrier_sync(layout: RoadmapEventCarrierLayout) -> CarrierEnsure {
  match carrier_exec(layout: layout, workdir: layout.worktree as String, args: ["fetch", "-q", roadmap_events_remote, roadmap_events_branch as String]) {
    CarrierExecFailed { exit_code, stderr } => CarrierEnsureRefused { step: "fetch", reason: join(["exit ", to_string(value: exit_code), ": ", stderr], "") }
    CarrierExecOk { stdout: _ } =>
      match carrier_exec(layout: layout, workdir: layout.worktree as String, args: ["reset", "-q", "--hard", "FETCH_HEAD"]) {
        CarrierExecFailed { exit_code, stderr } => CarrierEnsureRefused { step: "reset", reason: join(["exit ", to_string(value: exit_code), ": ", stderr], "") }
        CarrierExecOk { stdout: _ } => CarrierReady
      }
  }
}

// Every operation owns its worktree. A concurrent read cannot reset a writer's index or FETCH_HEAD.
// The remote publication is conditional on the EXACT fetched commit, not merely fast-forward.
// The issue-parent decision and operation receipt are made inside that same immutable snapshot.
// A SNAPSHOT'S PATH SAYS WHOSE IT IS. Every private snapshot of one carrier layout is created at
// stem, then a fixed-width structural digest of the layout's complete long-lived worktree path,
// then a dot, then mktemp's suffix. The worktree path is per instance, so the namespace is per
// instance. The digest is over the whole path and has one width, so two worktree paths that differ
// anywhere have different namespaces, no namespace is a prefix of another, and an instance root of
// any length costs the same one filename component.
//
// OWNERSHIP IS THE WHOLE SHAPE, not a prefix: a path is one of this layout's snapshots only when it
// is the namespace followed by exactly the suffix mktemp writes in place of the template's
// placeholder (roadmap_event_snapshot_path_owned). The census of one instance
// (gunbc.roadmap.roadmap_event_snapshot_census) selects by that, so a worktree someone registered
// at a longer path beginning with the namespace is not counted as a snapshot.
data roadmap_event_snapshot_stem: String = "/tmp/gunbc-roadmap-event-snapshot."
data roadmap_event_snapshot_placeholder: String = "XXXXXXXXXX"

fn roadmap_event_snapshot_namespace(layout: RoadmapEventCarrierLayout) -> String {
  join([
    roadmap_event_snapshot_stem,
    content_hash_tagged_structural(tag: "roadmap-event-snapshot-namespace" as NonEmptyStr, payload: content_hash_atom(value: layout.worktree as String as NonEmptyStr)).digest as String,
    ".",
  ], "")
}

fn roadmap_event_snapshot_template(layout: RoadmapEventCarrierLayout) -> FilePath {
  concat(roadmap_event_snapshot_namespace(layout: layout), roadmap_event_snapshot_placeholder) as FilePath
}

fn roadmap_event_snapshot_path_owned(namespace: String, path: String) -> Bool {
  starts_with(s: path, prefix: namespace)
    && string_length(s: path) == string_length(s: namespace) + string_length(s: roadmap_event_snapshot_placeholder)
    && all((path |> chars).skip(n: string_length(s: namespace)), cp => (cp >= 48 && cp <= 57) || (cp >= 65 && cp <= 90) || (cp >= 97 && cp <= 122))
}

type CarrierSnapshot = CarrierSnapshotReady { layout: RoadmapEventCarrierLayout } | CarrierSnapshotRefused { reason: String }

fn roadmap_event_private_snapshot(layout: RoadmapEventCarrierLayout) -> CarrierSnapshot {
  match roadmap_event_carrier_ensure(layout: layout) {
    CarrierEnsureRefused { step, reason } => CarrierSnapshotRefused { reason: concat(step, concat(": ", reason)) }
    CarrierReady => {
      let temporary = shell.Mktemp.DirWithTemplate(template: roadmap_event_snapshot_template(layout: layout))
      if !temporary.success { CarrierSnapshotRefused { reason: "cannot create private event snapshot" } }
      else { match carrier_exec(layout: layout, workdir: layout.repo_root as String,
        args: ["worktree", "add", "--detach", "--no-checkout", temporary.path, "HEAD"]) {
        CarrierExecFailed { exit_code: _, stderr } => CarrierSnapshotRefused { reason: stderr }
        CarrierExecOk { stdout: _ } => CarrierSnapshotReady { layout: RoadmapEventCarrierLayout {
          repo_root: layout.repo_root, worktree: temporary.path as FilePath, git_program: layout.git_program, directory_program: layout.directory_program } }
      } }
    }
  }
}

// WHAT BECAME OF THE OPERATION'S PRIVATE SNAPSHOT. Not opened is an operation refused before a
// snapshot existed, so there was nothing to remove. Closed is the worktree removed. Close failed is
// a worktree the operation left behind, named with what the removal answered. It is a fact beside
// the operation's result and never a rewrite of it: an event that was published stays published
// whether or not its scratch worktree could be removed.
type CarrierSnapshotClose
  = SnapshotNotOpened
  | SnapshotClosed
  | SnapshotCloseFailed { worktree: FilePath, exit_code: Int, stderr: String }

// EVERY SNAPSHOT-OWNING OPERATION ANSWERS WITH BOTH: its own result, unchanged, and the standing of
// the snapshot it owned. The caller is the one that has a surface for a leaked worktree, so the
// standing travels to it as a value; no carrier operation decides it is unimportant.
type CarrierClosed<T> {
  result: T
  close: CarrierSnapshotClose
}

fn carrier_snapshot_close_of(layout: RoadmapEventCarrierLayout, removal: CarrierExec) -> CarrierSnapshotClose {
  match removal {
    CarrierExecOk { stdout: _ } => SnapshotClosed
    CarrierExecFailed { exit_code, stderr } => SnapshotCloseFailed { worktree: layout.worktree, exit_code: exit_code, stderr: stderr }
  }
}

// The sentence a caller with a text surface states, and none when there is nothing to state.
fn carrier_snapshot_close_failure(close: CarrierSnapshotClose) -> String? {
  match close {
    SnapshotNotOpened => none
    SnapshotClosed => none
    SnapshotCloseFailed { worktree, exit_code, stderr } =>
      Present { value: join(["roadmap event snapshot worktree ", worktree as String, " was not removed (exit ", to_string(value: exit_code), "): ", trim(stderr)], "") }
  }
}

fn carrier_snapshot_close_failures(closes: List<CarrierSnapshotClose>) -> List<String> {
  fold(closes, init: [], f: (acc, c) => match carrier_snapshot_close_failure(close: c) {
    Present { value: line } => concat(acc, [line])
    Absent => acc
  })
}

// A REPORT IS A TEXT SURFACE, so a leaked snapshot is stated on it after the report's own answer,
// which is left exactly as it was.
fn carrier_report_with_snapshot_close(text: String, close: CarrierSnapshotClose) -> String {
  match carrier_snapshot_close_failure(close: close) {
    Absent => text
    Present { value: leak } => join([text, " [", leak, "]"], "")
  }
}

fn roadmap_event_snapshot_close(layout: RoadmapEventCarrierLayout) -> CarrierSnapshotClose {
  carrier_snapshot_close_of(layout: layout, removal: carrier_exec(layout: layout, workdir: layout.repo_root as String, args: ["worktree", "remove", "--force", layout.worktree as String]))
}

// THE CLOSE IS TAKEN INSIDE A MATCH ON THE OPERATION'S OWN RESULT, in every snapshot-owning
// operation below. The removal is therefore a dependency of the answer (the answer carries its
// standing) and the operation's result is a dependency of the removal (the arm that removes exists
// only once the result does), so the snapshot is removed after the operation and before the answer,
// by construction and not by the order two independent bindings happen to be written in.
fn roadmap_event_append(layout: RoadmapEventCarrierLayout, event: RoadmapEvent, operation: String = "") -> CarrierClosed<RoadmapEventAppend> {
  if operation != "" && !roadmap_operation_identity_valid(operation: operation) {
    CarrierClosed { result: EventAppendRefused { id: roadmap_event_envelope(e: event).id, step: "operation-invalid", reason: "operation identity must be 1–128 URL-safe ASCII characters" }, close: SnapshotNotOpened }
  } else {
    match roadmap_event_private_snapshot(layout: layout) {
      CarrierSnapshotRefused { reason } => CarrierClosed { result: EventAppendRefused { id: roadmap_event_envelope(e: event).id, step: "snapshot", reason: reason }, close: SnapshotNotOpened }
      CarrierSnapshotReady { layout: private } =>
        match roadmap_event_append_private(layout: private, event: event, operation: operation) {
          EventAppended { id } => CarrierClosed { result: EventAppended { id: id }, close: roadmap_event_snapshot_close(layout: private) }
          EventAlreadyPresent { id } => CarrierClosed { result: EventAlreadyPresent { id: id }, close: roadmap_event_snapshot_close(layout: private) }
          EventAppendRefused { id, step, reason } => CarrierClosed { result: EventAppendRefused { id: id, step: step, reason: reason }, close: roadmap_event_snapshot_close(layout: private) }
        }
    }
  }
}

fn roadmap_operation_identity_valid(operation: String) -> Bool {
  string_length(s: operation) > 0 && string_length(s: operation) <= 128
    && all(operation |> chars, cp => (cp >= 48 && cp <= 57) || (cp >= 65 && cp <= 90) || (cp >= 97 && cp <= 122) || cp == 45 || cp == 95)
}

fn roadmap_event_operation_path(event: RoadmapEvent, operation: String) -> String {
  join(["operations/", event.node as String, "/", operation, ".json"], "")
}

// recorded_at belongs to the committed result, not the retry payload. Parent remains bound to
// the original precondition; a key cannot be repurposed for a new command after a later event.
fn roadmap_event_same_command(a: RoadmapEvent, b: RoadmapEvent) -> Bool {
  a.node == b.node && a.author == b.author && a.parent == b.parent && a.kind == b.kind
}

// The operation receipt is observed, not read-and-kind-matched: the old flow branched on the
// host error's error_kind string ("not_found"), which breaks on every host phrasing. The
// observation authority establishes absence from the listing, so a missing receipt is an
// established fact (proceed with the append), a listed-but-unreadable receipt is a refusal that
// says whether the operation already ran is UNKNOWN, and a readable receipt decodes.
fn roadmap_event_append_after_no_operation_receipt(
  layout: RoadmapEventCarrierLayout,
  event: RoadmapEvent,
  env: RoadmapEventEnvelope,
  operation: String,
  receipt_path: String,
  expected_commit: String,
) -> RoadmapEventAppend {
  match roadmap_events_read_synced(layout: layout, node: event.node) {
    EventsReadRefused { node: _, step, reason } => EventAppendRefused { id: env.id, step: step, reason: reason }
    EventsRead { node: _, envelopes } => if any(envelopes, existing => existing.id == env.id) { EventAlreadyPresent { id: env.id } }
      else if !roadmap_event_admitted_after(envs: envelopes, event: event) {
        EventAppendRefused { id: env.id, step: "result-requires-binding", reason: "a result is written only through the bound result append, which builds it from the attempt's own binding; the generic append does not admit one" }
      } else if !roadmap_event_parent_admitted(event: event, envelopes: envelopes) {
        EventAppendRefused { id: env.id, step: "revision-conflict", reason: "expected issue revision does not match the committed issue head" }
      } else { roadmap_event_publish_private(layout: layout, env: env, operation: operation, receipt_path: receipt_path, expected_commit: expected_commit) }
  }
}

fn roadmap_event_append_private(layout: RoadmapEventCarrierLayout, event: RoadmapEvent, operation: String) -> RoadmapEventAppend {
  let env = roadmap_event_envelope(e: event)
  match roadmap_event_carrier_sync(layout: layout) {
    CarrierEnsureRefused { step, reason } => EventAppendRefused { id: env.id, step: step, reason: reason }
    CarrierReady => match carrier_exec(layout: layout, workdir: layout.worktree as String, args: ["rev-parse", "HEAD"]) {
      CarrierExecFailed { exit_code: _, stderr } => EventAppendRefused { id: env.id, step: "snapshot-revision", reason: stderr }
      CarrierExecOk { stdout: revision } => {
        let receipt_path = roadmap_event_operation_path(event: event, operation: operation)
        if operation == "" {
          roadmap_event_append_after_no_operation_receipt(
            layout: layout,
            event: event,
            env: env,
            operation: operation,
            receipt_path: receipt_path,
            expected_commit: trim(revision),
          )
        } else {
          match filesystem_file_observation_of_path(path: concat(layout.worktree as String, concat("/", receipt_path))) {
            FilesystemFileRead { path: _, content } =>
              match roadmap_event_decode(text: content) {
                RoadmapEventUndecodable { reason } => EventAppendRefused { id: env.id, step: "operation-read", reason: reason }
                RoadmapEventDecoded { envelope: previous } => if roadmap_event_same_command(a: previous.event, b: event) {
                  let committed = Filesystem.Read(path: concat(layout.worktree as String, concat("/", roadmap_event_file_relative(node: previous.event.node, id: previous.id))))
                  match filesystem_read_outcome(content: committed.content, success: committed.success, error: committed.error) {
                    FilesystemReadRefused { error } =>
                      EventAppendRefused { id: env.id, step: "operation-read", reason: join(["the committed event at this operation's address could not be read, so whether the operation already ran is unknown: ", error], "") }
                    FilesystemReadSucceeded { content: committed_text } => if committed_text == content { EventAlreadyPresent { id: previous.id } }
                      else { EventAppendRefused { id: env.id, step: "operation-read", reason: "operation receipt has no matching committed event" } }
                  }
                } else { EventAppendRefused { id: env.id, step: "operation-conflict", reason: "operation identity already belongs to another issue/principal/payload/precondition" } }
              }
            FilesystemFileAbsent(_) =>
              roadmap_event_append_after_no_operation_receipt(
                layout: layout,
                event: event,
                env: env,
                operation: operation,
                receipt_path: receipt_path,
                expected_commit: trim(revision),
              )
            FilesystemFileIndeterminate { cause } =>
              EventAppendRefused { id: env.id, step: "operation-read", reason: join(["the operation receipt could not be observed, so whether the operation already ran is unknown: ", cause], "") }
            FilesystemFileObservationsDisagree { path: _, cause } =>
              EventAppendRefused { id: env.id, step: "operation-read", reason: join(["the operation receipt observation is self-contradictory, so whether the operation already ran is unknown: ", cause], "") }
            FilesystemFileSubjectRefused { directory: _, name: _, cause } =>
              EventAppendRefused { id: env.id, step: "operation-read", reason: join(["the operation receipt path was refused before any filesystem call ran: ", cause], "") }
          }
        }
      }
    }
  }
}

fn roadmap_event_parent_admitted(event: RoadmapEvent, envelopes: List<RoadmapEventEnvelope>) -> Bool {
  match roadmap_history_unordered_reason(envs: envelopes) {
    Present { value: _ } => false
    Absent =>
      if any(envelopes, e => e.event.node != event.node) { false }
      else {
        let readable = match roadmap_event_heads(envs: envelopes).first() {
          Absent => CasReadableAbsent
          Present { value: head } => CasReadablePresent { version: CasSlotVersion {
            generation: count(envelopes), content: content_hash_of_value(value: head.id as NonEmptyStr), value: head.id } }
        }
        match event.parent {
          Absent => cas_expectation_admits(expected: ExpectSlotAbsent, readable: readable)
          Present { value: expected } => match filter(envelopes, e => e.id == expected).first() {
            Absent => false
            Present { value: previous } => cas_expectation_admits(expected: ExpectSlotGeneration {
              generation: count(roadmap_event_chain(envs: envelopes, head: previous, budget: count(envelopes))) }, readable: readable)
          }
        }
      }
  }
}

fn roadmap_event_publish_private(layout: RoadmapEventCarrierLayout, env: RoadmapEventEnvelope,
  operation: String, receipt_path: String, expected_commit: String) -> RoadmapEventAppend {
  let rel = roadmap_event_file_relative(node: env.event.node, id: env.id)
  match carrier_exec_program(program: layout.directory_program, workdir: layout.worktree as String,
    args: ["-d", roadmap_event_node_dir(layout: layout, node: env.event.node), concat(layout.worktree as String, concat("/operations/", env.event.node as String))]) {
    CarrierExecFailed { exit_code: _, stderr } => EventAppendRefused { id: env.id, step: "mkdir", reason: stderr }
    CarrierExecOk { stdout: _ } => {
      let written = Filesystem.Write(path: concat(layout.worktree as String, concat("/", rel)), content: roadmap_event_wire_text(env: env))
      let recorded = if operation == "" { written.success } else { Filesystem.Write(path: concat(layout.worktree as String, concat("/", receipt_path)), content: roadmap_event_wire_text(env: env)).success }
      if !written.success || !recorded { EventAppendRefused { id: env.id, step: "write", reason: "event or operation receipt write refused" } }
      else { match carrier_exec(layout: layout, workdir: layout.worktree as String, args: concat(["add", "--", rel], if operation == "" { [] } else { [receipt_path] })) {
        CarrierExecFailed { exit_code: _, stderr } => EventAppendRefused { id: env.id, step: "add", reason: stderr }
        CarrierExecOk { stdout: _ } => match carrier_exec(layout: layout, workdir: layout.worktree as String, args: shape_git_commit_message_args(message: roadmap_event_commit_message(env: env))) {
          CarrierExecFailed { exit_code: _, stderr } => EventAppendRefused { id: env.id, step: "commit", reason: stderr }
          CarrierExecOk { stdout: _ } => match carrier_exec(layout: layout, workdir: layout.worktree as String,
            args: ["push", "-q", concat("--force-with-lease=refs/heads/roadmap-events:", expected_commit), roadmap_events_remote, "HEAD:refs/heads/roadmap-events"]) {
            CarrierExecFailed { exit_code: _, stderr } => match carrier_exec(layout: layout, workdir: layout.worktree as String,
              args: shape_git_ls_remote_heads_args(remote: roadmap_events_remote, branch: roadmap_events_branch)) {
              CarrierExecOk { stdout: current } => EventAppendRefused { id: env.id,
                step: if trim(current) != "" && !starts_with(s: current, prefix: concat(expected_commit, "\t")) { "revision-conflict" } else { "publication-refused" },
                reason: concat("conditional publication refused; retry using the same operation identity: ", stderr) }
              CarrierExecFailed { exit_code: _, stderr: _ } => EventAppendRefused { id: env.id, step: "publication-refused", reason: stderr }
            }
            CarrierExecOk { stdout: _ } => EventAppended { id: env.id }
          }
        }
      } }
    }
  }
}

// ONE EVENT FILE AS READ, so the decode over a directory is a pure fold a witness can drive with
// constructed reads (the hermetic floor routes no filesystem read), while the filesystem walk stays
// in roadmap_events_decode_all.
type EventFileRead
  = EventFileContent { content: String }
  | EventFileUnreadable { detail: String }

fn roadmap_events_decode_all(node: RoadmapNodeId, dir: String, names: List<String>) -> RoadmapEventsRead {
  let reads = map(filter(names, n => ends_with(s: n, suffix: ".json")), n => {
    let r = Filesystem.Read(path: join([dir, "/", n], ""))
    match filesystem_read_outcome(content: r.content, success: r.success, error: r.error) {
      FilesystemReadSucceeded { content } => EventFileContent { content: content }
      FilesystemReadRefused { error } => EventFileUnreadable { detail: error }
    }
  })
  roadmap_events_decode_reads(node: node, reads: reads)
}

fn roadmap_events_decode_reads(node: RoadmapNodeId, reads: List<EventFileRead>) -> RoadmapEventsRead {
  if any(reads, r => match r { EventFileUnreadable { detail: _ } => true  EventFileContent { content: _ } => false }) {
    EventsReadRefused { node: node, step: "read", reason: join(fold(reads, init: [], f: (acc, r) => match r { EventFileUnreadable { detail } => concat(acc, [detail])  EventFileContent { content: _ } => acc }), "; ") }
  } else {
    let decoded = map(reads, r => match r { EventFileContent { content } => roadmap_event_decode(text: content)  EventFileUnreadable { detail } => RoadmapEventUndecodable { reason: detail } })
    if any(decoded, d => match d { RoadmapEventUndecodable { reason: _ } => true  RoadmapEventDecoded { envelope: _ } => false }) {
      EventsReadRefused { node: node, step: "decode", reason: join(fold(decoded, init: [], f: (acc, d) => match d { RoadmapEventUndecodable { reason } => concat(acc, [reason])  RoadmapEventDecoded { envelope: _ } => acc }), "; ") }
    } else {
      EventsRead { node: node, envelopes: fold(decoded, init: [], f: (acc, d) => match d { RoadmapEventDecoded { envelope } => concat(acc, [envelope])  RoadmapEventUndecodable { reason: _ } => acc }) }
    }
  }
}

fn roadmap_events_read_private(layout: RoadmapEventCarrierLayout, node: RoadmapNodeId) -> RoadmapEventsRead {
  match roadmap_event_carrier_ensure(layout: layout) {
    CarrierEnsureRefused { step, reason } => EventsReadRefused { node: node, step: join(["ensure/", step], ""), reason: reason }
    CarrierReady =>
      match roadmap_event_carrier_sync(layout: layout) {
        CarrierEnsureRefused { step, reason } => EventsReadRefused { node: node, step: join(["sync/", step], ""), reason: reason }
        CarrierReady => {
          let dir = roadmap_event_node_dir(layout: layout, node: node)
          let listing = Filesystem.List(path: dir)
          if !listing.success && listing.error_kind != "not_found" { EventsReadRefused { node: node, step: "list", reason: listing.error } } else if !listing.success {
            EventsRead { node: node, envelopes: [] }
          } else {
            roadmap_events_decode_all(node: node, dir: dir, names: filter(split(s: listing.entries, delimiter: "\n"), n => trim(n) != ""))
          }
        }
      }
  }
}

// EVERY NODE'S STANDING IN ONE SYNC: one fetch, then one fold per node directory. The belt's served
// observation reads this on every tick so the board shows the log without a merge; a carrier that
// cannot be reached is StandingsUnobserved with the step that failed, never an empty roster.
fn roadmap_standing_rows_of_reads(reads: List<RoadmapEventsRead>) -> List<NodeStandingRow> {
  fold(reads, init: [], f: (acc, r) => match r {
    EventsRead { node, envelopes } => { let state = roadmap_issue_state(envs: envelopes)
      concat(acc, [NodeStandingRow { node_id: node as String, standing: state.standing, assignment: state.assignment }]) }
    EventsReadRefused { node: _, step: _, reason: _ } => acc
  })
}

fn roadmap_standings_read_private(layout: RoadmapEventCarrierLayout) -> RoadmapStandings {
  match roadmap_event_carrier_ensure(layout: layout) {
    CarrierEnsureRefused { step, reason } => StandingsUnobserved { reason: join(["ensure/", step, ": ", reason], "") }
    CarrierReady =>
      match roadmap_event_carrier_sync(layout: layout) {
        CarrierEnsureRefused { step, reason } => StandingsUnobserved { reason: join(["sync/", step, ": ", reason], "") }
        CarrierReady => {
          let root = join([layout.worktree as String, "/", roadmap_events_dir_segment], "")
          let listing = Filesystem.List(path: root)
          if !listing.success && listing.error_kind != "not_found" { StandingsUnobserved { reason: listing.error } } else if !listing.success {
            StandingsObserved { rows: [] }
          } else {
            let nodes = filter(split(s: listing.entries, delimiter: "\n"), n => trim(n) != "")
            let reads = map(nodes, n => roadmap_events_read_synced(layout: layout, node: trim(n) as NonEmptyStr as RoadmapNodeId))
            match (filter(reads, r => match r { EventsReadRefused { node: _, step: _, reason: _ } => true  EventsRead { node: _, envelopes: _ } => false })).first() {
              Present { value: EventsReadRefused { node, step, reason } } => StandingsUnobserved { reason: join(["node ", node as String, " ", step, ": ", reason], "") }
              Present { value: EventsRead { node: _, envelopes: _ } } => StandingsObserved { rows: roadmap_standing_rows_of_reads(reads: reads) }
              Absent => StandingsObserved { rows: roadmap_standing_rows_of_reads(reads: reads) }
            }
          }
        }
      }
  }
}

// The per-node read without its own ensure and sync, for a caller that already synced.
fn roadmap_events_read_synced(layout: RoadmapEventCarrierLayout, node: RoadmapNodeId) -> RoadmapEventsRead {
  let dir = roadmap_event_node_dir(layout: layout, node: node)
  let listing = Filesystem.List(path: dir)
  if !listing.success && listing.error_kind != "not_found" { EventsReadRefused { node: node, step: "list", reason: listing.error } } else if !listing.success {
    EventsRead { node: node, envelopes: [] }
  } else {
    roadmap_events_decode_all(node: node, dir: dir, names: filter(split(s: listing.entries, delimiter: "\n"), n => trim(n) != ""))
  }
}

// EVERY EVENT ACROSS EVERY NODE IN ONE SYNC — one fetch, then one read per node directory, the
// envelopes concatenated (each envelope carries its own node). The assignment field's recently-used
// derivation consumes this feed; a refusal on any node's read refuses the whole read, because one
// damaged directory must never silently narrow the population.
type RoadmapAllEventsRead
  = AllEventsRead { envelopes: List<RoadmapEventEnvelope> }
  | AllEventsReadRefused { step: String, reason: String }

// THE PURE COMPOSITION, so the witness drives it with constructed per-node reads: the first refusal
// refuses the whole (named by node and step), else the envelopes concatenate in node order.
fn roadmap_envelopes_of_reads(reads: List<RoadmapEventsRead>) -> List<RoadmapEventEnvelope> {
  fold(reads, init: [], f: (acc, r) => match r {
    EventsRead { node: _, envelopes } => concat(acc, envelopes)
    EventsReadRefused { node: _, step: _, reason: _ } => acc
  })
}

fn roadmap_all_events_of_reads(reads: List<RoadmapEventsRead>) -> RoadmapAllEventsRead {
  match (filter(reads, r => match r { EventsReadRefused { node: _, step: _, reason: _ } => true  EventsRead { node: _, envelopes: _ } => false })).first() {
    Present { value: EventsReadRefused { node, step, reason } } =>
      AllEventsReadRefused { step: join(["node ", node as String, " ", step], ""), reason: reason }
    Present { value: EventsRead { node: _, envelopes: _ } } => AllEventsRead { envelopes: roadmap_envelopes_of_reads(reads: reads) }
    Absent => AllEventsRead { envelopes: roadmap_envelopes_of_reads(reads: reads) }
  }
}

// Every node's events from a worktree the caller already synced: the one walk both the all-events
// read and the bound result append decide over.
fn roadmap_events_read_all_synced(layout: RoadmapEventCarrierLayout) -> RoadmapAllEventsRead {
  let root = join([layout.worktree as String, "/", roadmap_events_dir_segment], "")
  let listing = Filesystem.List(path: root)
  if !listing.success && listing.error_kind != "not_found" { AllEventsReadRefused { step: "list", reason: listing.error } } else if !listing.success {
    AllEventsRead { envelopes: [] }
  } else {
    let nodes = filter(split(s: listing.entries, delimiter: "\n"), n => trim(n) != "")
    roadmap_all_events_of_reads(map(nodes, n => roadmap_events_read_synced(layout: layout, node: trim(n) as NonEmptyStr as RoadmapNodeId)))
  }
}

fn roadmap_events_read_all_private(layout: RoadmapEventCarrierLayout) -> RoadmapAllEventsRead {
  match roadmap_event_carrier_ensure(layout: layout) {
    CarrierEnsureRefused { step, reason } => AllEventsReadRefused { step: join(["ensure/", step], ""), reason: reason }
    CarrierReady =>
      match roadmap_event_carrier_sync(layout: layout) {
        CarrierEnsureRefused { step, reason } => AllEventsReadRefused { step: join(["sync/", step], ""), reason: reason }
        CarrierReady => {
          roadmap_events_read_all_synced(layout: layout)
        }
      }
  }
}

fn roadmap_events_read(layout: RoadmapEventCarrierLayout, node: RoadmapNodeId) -> CarrierClosed<RoadmapEventsRead> {
  match roadmap_event_private_snapshot(layout: layout) {
    CarrierSnapshotRefused { reason } => CarrierClosed { result: EventsReadRefused { node: node, step: "snapshot", reason: reason }, close: SnapshotNotOpened }
    CarrierSnapshotReady { layout: private } =>
      match roadmap_events_read_private(layout: private, node: node) {
        EventsRead { node: read_node, envelopes } => CarrierClosed { result: EventsRead { node: read_node, envelopes: envelopes }, close: roadmap_event_snapshot_close(layout: private) }
        EventsReadRefused { node: read_node, step, reason } => CarrierClosed { result: EventsReadRefused { node: read_node, step: step, reason: reason }, close: roadmap_event_snapshot_close(layout: private) }
      }
  }
}

fn roadmap_standings_read(layout: RoadmapEventCarrierLayout) -> CarrierClosed<RoadmapStandings> {
  match roadmap_event_private_snapshot(layout: layout) {
    CarrierSnapshotRefused { reason } => CarrierClosed { result: StandingsUnobserved { reason: reason }, close: SnapshotNotOpened }
    CarrierSnapshotReady { layout: private } =>
      match roadmap_standings_read_private(layout: private) {
        StandingsObserved { rows } => CarrierClosed { result: StandingsObserved { rows: rows }, close: roadmap_event_snapshot_close(layout: private) }
        StandingsUnobserved { reason } => CarrierClosed { result: StandingsUnobserved { reason: reason }, close: roadmap_event_snapshot_close(layout: private) }
      }
  }
}

fn roadmap_events_read_all(layout: RoadmapEventCarrierLayout) -> CarrierClosed<RoadmapAllEventsRead> {
  match roadmap_event_private_snapshot(layout: layout) {
    CarrierSnapshotRefused { reason } => CarrierClosed { result: AllEventsReadRefused { step: "snapshot", reason: reason }, close: SnapshotNotOpened }
    CarrierSnapshotReady { layout: private } =>
      match roadmap_events_read_all_private(layout: private) {
        AllEventsRead { envelopes } => CarrierClosed { result: AllEventsRead { envelopes: envelopes }, close: roadmap_event_snapshot_close(layout: private) }
        AllEventsReadRefused { step, reason } => CarrierClosed { result: AllEventsReadRefused { step: step, reason: reason }, close: roadmap_event_snapshot_close(layout: private) }
      }
  }
}

// WHOSE RESULT THIS IS, DERIVED FROM THE ATTEMPT'S OWN RECORD AND NOTHING THE CALLER SAYS. Given the
// issue and the attempt and what the attempt's create-only request record reads as, the identity a
// result is written under is established or refused. Established carries the claim THE RECORD
// names; there is no parameter through which a claim could be offered, so a result for attempt K
// cannot be addressed to any claim but the one K recorded at launch. An attempt with no record, an
// autonomous one, and a record that cannot be read have no claim to answer and refuse, each by
// name.
type RoadmapResultAuthority
  = ResultAuthorityEstablished { binding: RoadmapResultBinding }
  | ResultAuthorityRefused { step: String, reason: String }

fn roadmap_result_authority_of_record(node: RoadmapNodeId, attempt: String, record: AttemptRequestBindingRead) -> RoadmapResultAuthority {
  if attempt == "" {
    ResultAuthorityRefused { step: "result-attempt", reason: "the attempt has no key, so no request record can be read for it" }
  } else {
    match record {
      RequestBindingRead { binding: RequestClaimBound { claim } } =>
        ResultAuthorityEstablished { binding: RoadmapResultBinding { node: node, attempt: attempt as NonEmptyStr, claim: claim } }
      RequestBindingRead { binding: RequestAutonomous } =>
        ResultAuthorityRefused { step: "result-binding", reason: join(["attempt ", attempt, " of issue ", node as String, " was launched autonomously; it has no request to answer"], "") }
      RequestBindingAbsent =>
        ResultAuthorityRefused { step: "result-binding", reason: join(["attempt ", attempt, " of issue ", node as String, " has no request record, so the claim a result must name is not established"], "") }
      RequestBindingUnreadable { reason } =>
        ResultAuthorityRefused { step: "result-binding", reason: join(["the request record of attempt ", attempt, " of issue ", node as String, " cannot be read: ", reason], "") }
    }
  }
}

// WHAT THE BOUND APPEND ANSWERS. Its own type, because a refusal reached before the claim is derived
// has no event to name: appended and already-present name the result event; refused names the step
// and the reason.
type RoadmapResultAppend
  = ResultAppended { id: RoadmapEventId }
  | ResultAppendAlreadyPresent { id: RoadmapEventId }
  | ResultAppendRefused { step: String, reason: String }

fn roadmap_result_append_of(append: RoadmapEventAppend) -> RoadmapResultAppend {
  match append {
    EventAppended { id } => ResultAppended { id: id }
    EventAlreadyPresent { id } => ResultAppendAlreadyPresent { id: id }
    EventAppendRefused { id: _, step, reason } => ResultAppendRefused { step: step, reason: reason }
  }
}

// THE BOUND RESULT APPEND: the one way a ResultReturned reaches the log. The caller names the issue
// and the attempt and supplies the outcome. It supplies neither an event nor a claim. Inside ONE
// private snapshot the effect reads the attempt's own create-only request record and derives the
// claim from it (roadmap_result_authority_of_record), reads the whole log,
// roadmap_bound_result_admission decides over it (no result for the attempt on any other issue,
// none that differs on this one, the claim a Claimed on this issue's history, a single head), the
// event is built from that derived identity and chained on the head the snapshot read, and it is
// published against that exact commit. A log that moved between the read and the publish is
// refused by the same conditional push as any append. The snapshot is closed inside a match on the
// append's own result, and its standing is answered beside that result (roadmap_event_append).
fn roadmap_bound_result_append(instance: HostDashboardInstance, node: RoadmapNodeId, attempt: String, outcome: AttemptResultOutcome, author: EventPrincipal, recorded_at: String) -> CarrierClosed<RoadmapResultAppend> {
  match roadmap_event_private_snapshot(layout: roadmap_event_carrier_layout_for_instance(instance: instance)) {
    CarrierSnapshotRefused { reason } => CarrierClosed { result: ResultAppendRefused { step: "snapshot", reason: reason }, close: SnapshotNotOpened }
    CarrierSnapshotReady { layout: private } =>
      match roadmap_bound_result_append_private(instance: instance, layout: private, node: node, attempt: attempt, outcome: outcome, author: author, recorded_at: recorded_at) {
        ResultAppended { id } => CarrierClosed { result: ResultAppended { id: id }, close: roadmap_event_snapshot_close(layout: private) }
        ResultAppendAlreadyPresent { id } => CarrierClosed { result: ResultAppendAlreadyPresent { id: id }, close: roadmap_event_snapshot_close(layout: private) }
        ResultAppendRefused { step, reason } => CarrierClosed { result: ResultAppendRefused { step: step, reason: reason }, close: roadmap_event_snapshot_close(layout: private) }
      }
  }
}

fn roadmap_bound_result_append_private(instance: HostDashboardInstance, layout: RoadmapEventCarrierLayout, node: RoadmapNodeId, attempt: String, outcome: AttemptResultOutcome, author: EventPrincipal, recorded_at: String) -> RoadmapResultAppend {
  match roadmap_result_authority_of_record(node: node, attempt: attempt, record: attempt_request_binding_read_for_instance(instance: instance, node_id: node, attempt_key: attempt)) {
    ResultAuthorityRefused { step, reason } => ResultAppendRefused { step: step, reason: reason }
    ResultAuthorityEstablished { binding } =>
      match roadmap_event_carrier_sync(layout: layout) {
        CarrierEnsureRefused { step, reason } => ResultAppendRefused { step: step, reason: reason }
        CarrierReady => match carrier_exec(layout: layout, workdir: layout.worktree as String, args: ["rev-parse", "HEAD"]) {
          CarrierExecFailed { exit_code: _, stderr } => ResultAppendRefused { step: "snapshot-revision", reason: stderr }
          CarrierExecOk { stdout: revision } =>
            match roadmap_events_read_all_synced(layout: layout) {
              AllEventsReadRefused { step, reason } => ResultAppendRefused { step: step, reason: reason }
              AllEventsRead { envelopes } =>
                match roadmap_bound_result_admission(envs: envelopes, binding: binding, outcome: outcome) {
                  ResultNotAdmitted { step, reason } => ResultAppendRefused { step: step, reason: reason }
                  ResultAlreadyOnLog { id } => ResultAppendAlreadyPresent { id: id }
                  ResultAdmitted { parent } =>
                    roadmap_result_append_of(append: roadmap_event_publish_private(
                      layout: layout,
                      env: roadmap_event_envelope(e: roadmap_result_returned_event(binding: binding, outcome: outcome, author: author, parent: parent, recorded_at: recorded_at)),
                      operation: "",
                      receipt_path: "",
                      expected_commit: trim(revision),
                    ))
                }
            }
        }
      }
  }
}
