module gunbc.roadmap.roadmap_effort_estimate

import std.types { String, Int, Bool, List }
import std.optional { Optional, Present, Absent, optional_absent, optional_present }
import extdeps.units.iso8601_calendar { Iso8601CivilDate }
import gunbc.roadmap.roadmap_model { RoadmapNodeId, RoadmapNodeIdentity }
import gunbc.roadmap.roadmap_authority { declared_roadmap_nodes, nid }

// THE CLOCK IS THE ESTIMATE, NOT THE MILESTONE (gunbc.design_ruling::effort_estimates_are_public_and_live_in_gunbc,
// operator 2026-11-17, reversing the private-only placement; the shape is the operator's own from the private
// plan, 2026-11-03). One row per estimate, keyed by the roadmap node that stands for the milestone: when it was
// made, when the work starts, when it is realistically done, when it is pessimistically done, and the basis the
// numbers rest on. A row is appended and never edited, so the first estimate and the actual acceptance (read
// from the roadmap event log, never written here) stay readable side by side. Overdue is derived: the latest
// estimate's realistic date has passed and the node has no acceptance. No date here is a dependency or a gate
// (gunbc.design_ruling::planning_scheduling_is_cut still forbids that); the dependency reading is the edges.
type EffortEstimate {
  subject: RoadmapNodeId
  made_on: Iso8601CivilDate
  start: Iso8601CivilDate
  done: Iso8601CivilDate
  done_pessimistic: Iso8601CivilDate
  basis: String
}

fn d(y: Int, m: Int, day: Int) -> Iso8601CivilDate { Iso8601CivilDate { year: y, month: m, day: day } }

fn estimate(subject: String, made: Iso8601CivilDate, start: Iso8601CivilDate, done: Iso8601CivilDate, pessimistic: Iso8601CivilDate, basis: String) -> EffortEstimate {
  EffortEstimate { subject: nid(s: subject), made_on: made, start: start, done: done, done_pessimistic: pessimistic, basis: basis }
}

// THE CALIBRATION THE FIRST ROUND RESTS ON (measured 2026-11-17 from GitHub and main's committed event log): a hard
