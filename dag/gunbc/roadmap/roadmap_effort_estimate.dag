// STRICT DATE ORDER, from the total order this file already keeps: a revocation must come after the row it withdraws,
// and "after" has to mean strictly after rather than the antisymmetric collapse of <= onto itself.
fn date_precedes(a: Iso8601CivilDate, b: Iso8601CivilDate) -> Bool {
  date_le(a: a, b: b) && !date_le(a: b, b: a)
}

// ======================= THE ONE CONVERSION TABLE (single authority) =======================
// Each size names an INCLUSIVE working-day range; the ranges PARTITION the positive whole numbers, so every
// duration lies in exactly one band (`estimate_table_partitions_the_line` checks it, and the witnesses check
// the round-trip both ways). The scheduled duration of a size is its midpoint rounded up -- a single Int,
// because the scheduler places Int days -- and it always lands inside its own band, which is what makes the
// round-trip hold by construction rather than by test. The RANGE itself stays readable beside it
// (`estimate_band`), so an answer can show "L, 16 to 49 days" without inventing a second number.
// THE TOP BAND IS OPEN ABOVE; its `high` is the table's declared planning ceiling, carried there and nowhere
// else, so the open top still has a midpoint. It is not a cap on what a node may cost: a duration above it
// resolves to NO size and the caller refuses rather than clamping -- see `days_to_size`.
// BASIS (measured, from this file's own header and its appended history): an easy node is about a week, and
// the quick wins measured 3 to 5 working days, which is SizeS; a hard compiler node is 10 to 16 weeks, and
// native-seven's first estimate carries exactly 50 working days to its realistic done and 80 to its
// pessimistic done, which is SizeXl. Nothing measured sits under 3 days, so SizeXs is DECLARED for the work
// under a week rather than inferred from data nobody has. The ceiling is twice the measured top of the hard
// band (2 x 80), a declaration and not a measurement, because nothing measured as WORK reaches past it.
// RE-CALIBRATION TRIGGER: realized durations -- gunbc.roadmap.roadmap_leaf_realized_duration. When a band's
// realized working days fall outside its range, the bands move; a realized duration at or above the ceiling
// moves the ceiling. Re-calibration is an edit to THIS table and nowhere else, because it is the single
// authority (gunbc.design_argument::single_authority).
type SizeBand {
  size: EstimateSize
  // feature:working-day-prior-carrier  dissolve-on: std.measure grows a working-day (effort) family -- the same inherited grain the scheduler marks on ScheduledLeaf.start_day (roadmap_schedule.dag); the tracked row lives on WorkPiece.days. Working days, never hours.
  low: Int
  // feature:working-day-prior-carrier  dissolve-on: std.measure grows a working-day (effort) family -- the same inherited grain the scheduler marks on ScheduledLeaf.start_day (roadmap_schedule.dag); the tracked row lives on WorkPiece.days. Working days, never hours.
  high: Int
}

type EstimateTable {
  bands: List<SizeBand>
  basis: String
  recalibration: String
}

data estimate_table: EstimateTable = EstimateTable {
  bands: [
    SizeBand { size: SizeXs, low: 1, high: 2 },
    SizeBand { size: SizeS, low: 3, high: 5 },
    SizeBand { size: SizeM, low: 6, high: 15 },
    SizeBand { size: SizeL, low: 16, high: 49 },
    SizeBand { size: SizeXl, low: 50, high: 80 },
    SizeBand { size: SizeXxl, low: 81, high: 160 }
  ],
  basis: "measured from this carrier's own header and history: an easy node is about a week and the quick wins measured 3 to 5 working days (SizeS); a hard compiler node is 10 to 16 weeks and native-seven's first estimate carries 50 working days to done, 80 to pessimistic (SizeXl); SizeXs is declared, not measured, and the ceiling is twice the measured top of the hard band",
  recalibration: "realized durations from gunbc.roadmap.roadmap_leaf_realized_duration: a band whose realized days fall outside its range moves the range, and a realized duration at or above the top band's high moves the ceiling"
}

fn estimate_band(t: EstimateTable, s: EstimateSize) -> Optional<SizeBand> {
  match filter(t.bands, b => b.size == s) {
    Empty => optional_absent()
    Cons { head: b, tail: _ } => optional_present(value: b)
  }
}

// THE MIDPOINT, ROUNDED UP. Integer division truncates, so (low + high + 1) / 2 is the ceiling of the
// midpoint, and for a non-empty band it always lies within [low, high].
fn band_scheduled_days(b: SizeBand) -> Int {
  (b.low + b.high + 1) / 2
}

// DURATION TO SIZE: the bucket that contains it. A non-positive duration has no size and a duration above the
// ceiling has NO SIZE -- the caller refuses both rather than clamping to the nearest band (a silent clamp
// would price the biggest item in the roadmap at the table's own ceiling, which is the contradiction this
// whole carrier exists to refuse).
fn days_to_size(t: EstimateTable, days: Int) -> Optional<EstimateSize> {
  match filter(t.bands, b => days >= b.low && days <= b.high) {
    Empty => optional_absent()
    Cons { head: b, tail: _ } => optional_present(value: b.size)
  }
}

// THE ONE DERIVATION FROM THE ROW TO THE NUMBER THE SCHEDULER PLACES. A stated size gives its band's
// midpoint; a stated duration gives itself, unchanged -- there is no second conversion and no rounding of a
// literal. Non-positive and above-ceiling both answer Absent, and the caller names the side that failed.
fn estimate_form_days(t: EstimateTable, v: EstimateForm) -> Optional<Int> {
  match v {
    DaysEstimate { working_days } => if working_days >= 1 { optional_present(value: working_days) } else { optional_absent() }
    SizedEstimate { size } => match estimate_band(t: t, s: size) {
      Absent => optional_absent()
      Present { value: b } => optional_present(value: band_scheduled_days(b: b))
    }
  }
}

// THE RANGE A SIZE NAMES, for the answer that reports a band rather than a single number.
fn estimate_form_range(t: EstimateTable, v: EstimateForm) -> Optional<SizeBand> {
  match v {
    DaysEstimate { working_days } => match days_to_size(t: t, days: working_days) {
      Present { value: s } => estimate_band(t: t, s: s)
      Absent => optional_absent()
    }
    SizedEstimate { size } => estimate_band(t: t, s: size)
  }
}

// THE PARTITION, checked rather than asserted: ascending bands starting at one working day, no gap and no
// overlap, every band non-empty, and every scheduled midpoint inside its own band.
fn estimate_table_partitions_the_line(t: EstimateTable) -> Bool {
  all(t.bands, b => b.low >= 1 && b.high >= b.low && band_scheduled_days(b: b) >= b.low && band_scheduled_days(b: b) <= b.high)
    && partition_is_contiguous(bands: t.bands)
}

// THE BANDS START AT ONE WORKING DAY AND CONTINUE WITHOUT A GAP OR AN OVERLAP. The list is authored in
// ascending order (declaration order is the order); a gap or an overlap means some duration lands in no band
// or in two, which is the table contradicting itself.
fn partition_is_contiguous(bands: List<SizeBand>) -> Bool {
  let walked = fold(bands, init: optional_present(value: 0), f: fn(acc, b) {
    match acc {
      Absent => optional_absent()
      Present { value: prev_high } => if b.low == prev_high + 1 { optional_present(value: b.high) } else { optional_absent() }
    }
  })
  let starts_at_one = match bands {
    Empty => false
    Cons { head: b, tail: _ } => b.low == 1
  }
  match walked {
    Absent => false
    Present { value: _ } => starts_at_one
  }
}

// THE CEILING, read from the one table rather than restated anywhere: the top band's own high. It is not a cap on
// what work may cost -- a duration above it resolves to NO size and the caller refuses (see `days_to_size`); it is
// the declared top of the calibrated line, and the realized duration that reaches it is the trigger to raise it.
fn estimate_ceiling() -> Int {
  match estimate_band(t: estimate_table, s: SizeXxl) {
    Present { value: b } => b.high
    Absent => 0
  }
}

// ROUND-TRIP, SIZE FIRST: the size the scheduler's number buckets back into is the size it came from.
fn size_round_trips(t: EstimateTable, s: EstimateSize) -> Bool {
  match estimate_form_days(t: t, v: sized_estimate(size: s)) {
    Present { value: days } => match days_to_size(t: t, days: days) {
      Present { value: back } => back == s
      Absent => false
    }
    Absent => false
  }
}

// ROUND-TRIP, DURATION FIRST: a duration bucketed into a band still lies inside that band, so bucketing never
// relocates work to a cheaper or dearer range than the one the number says it is in.
fn days_round_trip_inside_band(t: EstimateTable, days: Int) -> Bool {
  match days_to_size(t: t, days: days) {
    Present { value: s } => match estimate_band(t: t, s: s) {
      Present { value: b } => days >= b.low && days <= b.high
      Absent => false
    }
    Absent => false
  }
}

fn sized_estimate(size: EstimateSize) -> EstimateForm { SizedEstimate { size: size } }

fn days_estimate(working_days: Int) -> EstimateForm { DaysEstimate { working_days: working_days } }

// THE DATED CARRIER IS CLOSED. The 18 rows appended on 2026-11-17 and 2026-11-18 are history and stay as they
// are -- the ruling forbids deleting or rewriting them, and the contradiction report reads them as they stand.
// It takes no new row: a new row would author a start, a done and a pessimistic date, and under the ruling
// those are DERIVED. This is the seal, so the closure is a check and not a comment.
data dated_rows_closed_on: Iso8601CivilDate = d(y: 2026, m: 11, day: 19)

fn dated_rows_are_closed_to_the_ruling() -> Bool {
  all(roadmap_effort_estimates, e => date_le(a: e.made_on, b: dated_rows_closed_on))
}
