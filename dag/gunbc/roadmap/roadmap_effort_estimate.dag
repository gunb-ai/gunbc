  estimate(subject: "native-seven", made: d(y: 2026, m: 11, day: 17), start: d(y: 2026, m: 11, day: 17), done: d(y: 2027, m: 2, day: 23), pessimistic: d(y: 2027, m: 4, day: 27),
    basis: "prior: operator's scratch list-scheduling simulation (unbounded-parallelism assumption), 2026-11-17, not in the tree. day 70, bound by its own four parents at 40 working days (declaration-provider-outcomes and the derived closure), not by parallelism"),
  estimate(subject: "second-generation", made: d(y: 2026, m: 11, day: 17), start: d(y: 2026, m: 11, day: 17), done: d(y: 2027, m: 11, day: 2), pessimistic: d(y: 2028, m: 3, day: 31),
    basis: "prior: operator's scratch list-scheduling simulation (unbounded-parallelism assumption), 2026-11-17, not in the tree. day 250, unchanged from the narrow pass because the chain is serial; the date moves only if the six emitter nodes are decomposed per grammar production (126 productions, join per node)"),
  estimate(subject: "v1-products-v1-free", made: d(y: 2026, m: 11, day: 17), start: d(y: 2027, m: 11, day: 2), done: d(y: 2028, m: 7, day: 25), pessimistic: d(y: 2029, m: 2, day: 28),
    basis: "prior: operator's scratch list-scheduling simulation (unbounded-parallelism assumption), 2026-11-17, not in the tree. day 440, the longest serial chain; two weeks better than the narrow pass"),
  estimate(subject: "import-grammar-and-lines-deleted", made: d(y: 2026, m: 11, day: 17), start: d(y: 2026, m: 11, day: 24), done: d(y: 2027, m: 6, day: 29), pessimistic: d(y: 2027, m: 11, day: 30),
    basis: "prior: operator's scratch list-scheduling simulation (unbounded-parallelism assumption), 2026-11-17, not in the tree. day 160; its own chain (closure, rule, layers 1 to 3) at 40 working days each, beside the emitter chain"),
  estimate(subject: "factory-dogfood-route", made: d(y: 2026, m: 11, day: 17), start: d(y: 2026, m: 11, day: 17), done: d(y: 2027, m: 5, day: 4), pessimistic: d(y: 2027, m: 8, day: 31),
    basis: "prior: operator's scratch list-scheduling simulation (unbounded-parallelism assumption), 2026-11-17, not in the tree. day 120 (the execution cut, then G1 and G5, then the route); the factory terminal at day 250 behind the work-execution chain"),
  estimate(subject: "external-specimen-compiles", made: d(y: 2026, m: 11, day: 17), start: d(y: 2028, m: 7, day: 25), done: d(y: 2028, m: 8, day: 8), pessimistic: d(y: 2029, m: 6, day: 30),
    basis: "prior: operator's scratch list-scheduling simulation (unbounded-parallelism assumption), 2026-11-17, not in the tree. day 450, ten days after self-host, since the seven vision separations proceed beside the chain and only the specimen waits on everything"),
]

fn date_le(a: Iso8601CivilDate, b: Iso8601CivilDate) -> Bool {
  a.year < b.year || (a.year == b.year && (a.month < b.month || (a.month == b.month && a.day <= b.day)))
}

fn estimate_has_node(e: EffortEstimate) -> Bool {
  count(filter(declared_roadmap_nodes(), n => n.node == e.subject)) == 1
}

fn estimates_all_have_nodes() -> Bool {
  all(roadmap_effort_estimates, e => estimate_has_node(e: e))
}

fn estimates_are_ordered() -> Bool {
  all(roadmap_effort_estimates, e => date_le(a: e.made_on, b: e.done) && date_le(a: e.start, b: e.done) && date_le(a: e.done, b: e.done_pessimistic))
}

fn estimates_for(subject: RoadmapNodeId) -> List<EffortEstimate> {
  filter(roadmap_effort_estimates, e => e.subject == subject)
}

// Consumption frontier (gunbc.design_argument::consumption). latest_estimate and
// overdue are read by no production consumer on this branch; their only reader here is
// their own witness, which is not a consumer under the rule. They are a declared frontier:
// consumed by the named later change `roadmap-work-item-projection` (declared in #16650,
// stacked on this branch), whose per-node row carries a node's latest estimate and its
// `overdue`, which `roadmap-timeline-page` then renders. Trigger: #16650 landing
// `roadmap-work-item-projection`. The node ids are named here as the consuming change,
// not linked as a graph edge -- this branch does not carry that node.
// The latest estimate for a subject: the last appended, since rows are appended in order and never edited.
fn latest_estimate(subject: RoadmapNodeId) -> Optional<EffortEstimate> {
  fold(estimates_for(subject: subject), init: optional_absent(), f: fn(acc, e) { optional_present(value: e) })
}

// Overdue is derived: the latest realistic date has passed and the caller found no acceptance for the subject.
fn overdue(subject: RoadmapNodeId, today: Iso8601CivilDate, accepted: Bool) -> Bool {
  match latest_estimate(subject: subject) {
    Present { value: e } => !accepted && date_le(a: e.done, b: today) && !(e.done.year == today.year && e.done.month == today.month && e.done.day == today.day)
    Absent => false
  }
}
