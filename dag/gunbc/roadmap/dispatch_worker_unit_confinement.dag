module gunbc.roadmap.dispatch_worker_unit_confinement

// THE WORKER UNIT'S PLAN AND CONFINEMENT, A LEAF BOTH SIDES OF THE ATTEMPT-UNIT SPOOL IMPORT. The
// requester side (roadmap_dispatch_actuator, roadmap_belt_actuate) plans a unit; the root side
// (gunbc.roadmap.attempt_system_unit_launch's launcher entry) re-derives the same confinement from the
// request's identity. Both read ONE fold, so it lives below both: a root helper that must be auditable
// and is re-derived from source on every start (DESIGN section 2) may not reach the credential,
// harness, tmux and LLM world through the dispatch actuator to learn which paths a worker may write.
// The closure of this module excludes roadmap_dispatch_actuator, roadmap_belt_actuate and
// harness_backend; the exclusion is checked at identity grain by the closure-exclusion witness.

import std.types { String, NonEmptyStr, Int, Bool, List, FilePath }
import std.optional { Present, Absent }
import std.measure { Kibibyte, millicore }
import std.filesystem { path_parent_directory }
import extdeps.git { git_non_bare_git_dir_name, SafeDirectoryGrant, GitEnvironmentSetting, git_safe_directory_environment }
import extdeps.systemd {
  ExecStopPostProperty, NoNewPrivilegesProperty, PrivateTmpProperty, ProtectHomeProperty, ProtectSystemProperty,
  ReadOnlyPathsProperty, ReadWritePathsProperty, RestrictSUIDSGIDProperty, StandardErrorProperty, StandardOutputProperty,
  UMaskProperty,
}
import extdeps.systemd.unit_file { systemd_system_credstore_directory }
import gunbc.fleet.fleet_posix_accounts { fleet_posix_home_directory }
import gunbc.harness.harness_operator_credential { OperatorCredentialFile, operator_route_credential_file }
import extdeps.systemd.systemd_run { EmptyCapabilityBoundingSet, NamedUnitSetting, SystemdRunProperty }
import gunbc.compute.unit_bounds { UnitProcessBounds, compute_grant_unit_properties }
import gunbc.roadmap.roadmap_model { RoadmapNodeId }
import gunbc.host.host_layout { attempt_exit_inbox_dir }
import gunbc.roadmap.dispatch_worker_handed_set {
  HandedEntry, HandedWorkingDirectory, HandedReadWrite, HandedReadOnly, HandedStdout, HandedStderr,
  HandedExitRoot, HandedExecutable, HandedCredentialSource, dispatch_worker_source_roots, dispatch_worker_set_working_directory,
  dispatch_worker_set_stream_wire, dispatch_worker_set_read_write_wire, dispatch_worker_set_read_only_wire,
  dispatch_worker_set_credential_settings,
}
import gunbc.roadmap.roadmap_dashboard_instance {
  HostDashboardInstance, dashboard_instance_dispatch_attempt_state_root, dashboard_instance_dispatch_worktree_root,
  WorkerIsServiceUser, WorkerDedicatedAccount,
}

// THE EXECUTOR AXIS, AND WHY THE HARNESS ARM BELONGS HERE AND NOT IN ProviderKind.
//
// ProviderKind lives in extdeps.llm.cli_lifecycle and enumerates three EXTERNAL vendor CLIs. The
// gunbc harness is not one, and DESIGN's external-upstream decomposition is explicit that a generic
// hub may not enumerate concrete products -- adding a fourth arm there would widen a vendor
// enumeration with a thing that has no vendor, no account, no entitlement and no rate limit.
//
// It would also multiply. "Which vendor" is currently forked across SIX parallel coproducts --
// ProviderOffer, ResolvedProviderSelection, DispatchCredentialBindingIdentity,
// DispatchModelIdentity, DispatchProviderControl and this one -- so a fourth vendor is not one arm
// but six, plus every match site. The arity is the tell that those axes are realization facts
// fused into a selection interface.
//
// This type is already the right layer: it is gunbc's own "who executes this attempt", and each of
// its variants owns argv, preflight and pane fingerprint together at the spawn call site. So the
// harness is one arm HERE, the vendor machinery below is untouched and keeps serving the three
// vendor arms, and DCH-4's deletion collapses this type toward a single arm rather than unpicking a
// fourth copy of a fork.
type DispatchCliProvider
  = ClaudeCodeProvider
  | CodexDispatchProvider
  | CursorDispatchProvider
  | GunbcHarnessProvider

// THE GITFILE AND WORKTREE POINTER FILES REDIRECT THE CONTROLLER'S GIT. They sit inside the
// writable carve-outs (the worktree and .git/worktrees/<n>/), and ReadOnlyPaths= on those exact
// files wins over the parent ReadWritePaths. systemd can only bind a path that exists, so the
// entries carry NO '-' prefix (systemd.exec(5): '-' ignores a missing path): the belt's staged
// spawn runs worktree-add before it starts the unit (gunbc.roadmap.roadmap_belt_actuate), so all
// three exist at start, and a missing one fails the unit start instead of leaving the file open.
// Index, HEAD, refs and logs under the private dir stay writable.
//
// config.worktree IS NOT ONE OF THEM and is not claimed read-only. git worktree add does not create
// it, so no mount can hold it, and the worker can create it under the writable .git/worktrees/<n>/.
// It is inert rather than protected: git reads $GIT_DIR/config.worktree only when
// extensions.worktreeConfig is set (git-worktree(1), CONFIGURATION FILE), and that key lives in the
// common config, dispatch_worker_common_git_config, which no writable root covers (review 81053).
type DispatchWorkerGitPointerFiles {
  gitfile: String
  commondir: String
  gitdir_file: String
}

// THE WORKER UNIT IS PLANNED WITHOUT ITS BOUNDS AND STARTED WITH THEM. Everything about the unit
// that the spawn plan knows -- program, name, directories, the provider's argv -- is fixed here; the
// memory bound is the placement grant, which exists only once the belt has acquired it immediately
// before spawn. So there is no argv to run until a grant is supplied: dispatch_worker_unit_run takes
// the granted amount as an argument, and a plan cannot be started at the instance ceiling by
// omission.
type DispatchWorkerUnitPlan {
  systemd_run_program: FilePath
  unit: NonEmptyStr
  node_id: String
  attempt_key: String
  working_directory: String
  attempt_worktree: String
  stdout_path: String
  stderr_path: String
  inner_argv: List<String>
  exit_hook: NonEmptyStr
}

fn dispatch_attempt_private_git_dir(instance: HostDashboardInstance, attempt_worktree: String) -> String {
  join([instance.repo_root as String, "/.git/worktrees/", dispatch_worktree_entry_name(attempt_worktree: attempt_worktree)], "")
}

// WHICH DIRECTORY THE ATTEMPT PANE STANDS IN, and it is a PROVIDER fact rather than an attempt
// fact. A vendor CLI is handed the attempt as its WORKING DIRECTORY -- that is how claude and codex
// are told which tree to edit, so for them the pane cwd IS the subject and must stay the worktree.
//
// The gunbc harness is told the same thing as an ARGUMENT (--arg worktree=), because
// gunbc_harness_spawn_argv resolves the worker's own modules from absolute source roots under the
// controller's repo_root -- the separation that function's annotation draws between the TOOL and
// the SUBJECT. Standing that process in the worktree contradicts it: `gunbc run` takes its process
// workspace root from the cwd, and repo_relative_path_normalized PANICS on any module path outside
// it, so the controller's own dag/ is rejected by the worker that was pointed at it on purpose.
//
// Found by execution, not by reading: the first wet dispatch on srv2-deploy spawned, the pane
// exited 101, and provider-events.jsonl carried
// "path /home/briansrls/gunbc-srv2-deploy/dag is not under process workspace root
// .../attempts/shell-typed-invocation-<key>". The attempt worktree, the branch, the state directory
// and the current-pointer were all correct -- only the directory the process stood in was wrong,
// which is why every receipt looked right while nothing ran.
// THE ATTEMPT'S UNIT NAME. Per attempt, not per node: the attempt key is a content hash, so two
// attempts on one node get distinct units and the collision the tmux path reports as
// `duplicate session` has no spelling here. A unit that has exited stays loaded in `failed` or
// `inactive` carrying its Result, which is the evidence the next step reads; clearing it is an
// explicit act rather than a side effect of starting the next attempt.

// THE WORKER'S OWN STDOUT IS A LOG, NOT AN EVENT STREAM, and separating them is the repair for a
// conflation this lane shipped. provider-events.jsonl is not "where the attempt's output goes": it
// carries a DECLARED SCHEMA -- turn.started, item.*, turn.completed, turn.failed, error -- that
// gunbc.roadmap.roadmap_provider_events reads through jq with fromjson. Pointing the worker's progress
// output at it (`[file] write ...`, `✓ ... done in 48 seconds`) made jq exit 5 on the first line
// and the whole attempt's agent evidence refuse as unreadable.
//
// The refusal was correct and is why this was cheap to find: it named the file, the line and the
// column rather than fabricating an activity state. What was wrong was the producer, and the fix is
// not to loosen the reader but to stop writing the wrong content into a typed stream. The worker's
// stdout keeps its own sibling file, and provider-events.jsonl is written only by something that
// speaks the schema.
// THE WORKER-OWNED CHILD OF THE ATTEMPT DIRECTORY. Owner-side records (request-binding.json,
// launch-identity.json, attempt-key, admission) stay in roadmap_attempt_state_store AttemptDirectoryRoot
// itself, which is read-only to the unit. The log path is the single producer of that child:
// ReadWritePaths scratch is path_parent_directory of stdout, and events/request scratch follow
// this same parent. Do not add a parallel worker-dir function.
// THE PRIVILEGE CONFINEMENT EVERY UNIT RUNNING MODEL-DRIVEN CODE CARRIES, spelled once: no setuid or
// setgid escalation, no setuid/setgid file creation, and an empty capability bounding set. Worker,
// reviewer, auditor and supervisor units share it (WORKER-ROOT-EQUIVALENT-2, item 4). The review roles
// launch through the user manager, which cannot switch uid, so they keep the owner's identity and this
// is their whole privilege reduction; the dedicated identity needs the system-manager launcher.
fn dispatch_model_driven_privilege_confinement_properties() -> List<SystemdRunProperty> {
  [
    NamedUnitSetting { property: NoNewPrivilegesProperty, value: "yes" as NonEmptyStr },
    NamedUnitSetting { property: RestrictSUIDSGIDProperty, value: "yes" as NonEmptyStr },
    EmptyCapabilityBoundingSet,
  ]
}

// THE DEDICATED WORKER CREATES GROUP-WRITABLE ENTRIES, BECAUSE ITS CONFINEMENT FORBIDS THE CHMOD GIT WOULD ISSUE.
// The shared repository runs git with core.sharedRepository=group, so a directory git creates (an object fan-out,
// a new ref directory) is created and then chmod-ed to 02775 -- setgid included. The worker unit's
// RestrictSUIDSGID=yes (above) refuses any chmod whose mode carries setuid or setgid, so that chmod fails EPERM and
// the object write with it ("unable to create temporary file: Operation not permitted": the srv1 lab's first
// worker to reach its model could not `git add` at all, 2026-10-25). git issues the chmod only when the new
// entry's mode differs from the shared one, and under umask 0002 a directory made inside a setgid parent already
// is 2775, so no chmod is issued and the confinement stays whole. Measured on srv1 under the unit's own seccomp: a
// transient gunbc-worker unit with RestrictSUIDSGID=yes wrote a new object with UMask=0002 and refused with EPERM
// with UMask=0022. The same mask makes what the worker creates writable by the attempt group, which is how the
// service user's commit of the worker's changes reaches them. A service-user worker owns everything it touches and
// keeps the default. The class: gunbc.recurring_failure_mode restrict_suidsgid_refuses_the_shared_repository_chmod.
data dispatch_dedicated_worker_umask: NonEmptyStr = "0002"

fn dispatch_worker_umask_properties(instance: HostDashboardInstance) -> List<SystemdRunProperty> {
  match instance.worker {
    WorkerIsServiceUser => []
    WorkerDedicatedAccount => [NamedUnitSetting { property: UMaskProperty, value: dispatch_dedicated_worker_umask }]
  }
}

// THE WORKER'S GIT TRUST: EXACTLY ITS OWN WORKTREE. `git worktree add` runs as the service user, so the attempt's
// worktree is the service user's; a dedicated worker account operating in it is refused by every git call with
// "detected dubious ownership" -- the harness's own status reads and the model's tools, its commit included (srv1
// lab, 2026-10-24, the first attempt to reach its model). The trust is git's own safe.directory grant naming that
// one worktree, carried by the environment so it reaches the tools' git as well as the harness's
// (extdeps.git git_safe_directory_environment), and set on the unit by the root launcher from the attempt's identity
// (gunbc.roadmap.attempt_system_unit_launch attempt_system_unit_worker_environment). A worker that IS the service
// user owns its worktree and gets none.
fn dispatch_worker_git_trust_environment(instance: HostDashboardInstance, attempt_worktree: String) -> List<GitEnvironmentSetting> {
  match instance.worker {
    WorkerIsServiceUser => []
    WorkerDedicatedAccount => git_safe_directory_environment(grant: SafeDirectoryGrant { path: attempt_worktree as NonEmptyStr })
  }
}

fn dispatch_pane_working_directory(
  provider: DispatchCliProvider,
  instance: HostDashboardInstance,
  worktree_path: String,
) -> String {
  match provider {
    GunbcHarnessProvider => instance.repo_root as String
    ClaudeCodeProvider => worktree_path
    CodexDispatchProvider => worktree_path
    CursorDispatchProvider => worktree_path
  }
}

fn dispatch_worker_git_pointer_files(instance: HostDashboardInstance, attempt_worktree: String) -> DispatchWorkerGitPointerFiles {
  let private_dir = dispatch_attempt_private_git_dir(instance: instance, attempt_worktree: attempt_worktree)
  DispatchWorkerGitPointerFiles {
    gitfile: join([attempt_worktree, "/", git_non_bare_git_dir_name], ""),
    commondir: join([private_dir, "/commondir"], ""),
    gitdir_file: join([private_dir, "/gitdir"], ""),
  }
}

fn dispatch_worker_git_pointer_readonly_list(instance: HostDashboardInstance, attempt_worktree: String) -> List<String> {
  let pointers = dispatch_worker_git_pointer_files(instance: instance, attempt_worktree: attempt_worktree)
  [pointers.gitfile, pointers.commondir, pointers.gitdir_file]
}

fn dispatch_worker_git_pointer_readonly_paths(instance: HostDashboardInstance, attempt_worktree: String) -> String {
  join(dispatch_worker_git_pointer_readonly_list(instance: instance, attempt_worktree: attempt_worktree), separator: " ")
}

// THE WORKER'S WRITABLE SET IS THIS ATTEMPT'S PATHS, NOT THE INSTANCE ROOT AND NOT THE WHOLE
// DISPATCH STATE. ProtectSystem=strict makes /usr /boot /etc /opt read-only except ReadWritePaths.
// Spelling instance_root as that carve-out on srv1_live (instance_root=/opt/gunbc) reopened
// /opt/gunbc/bin and the deployed checkout (smart-gull-336 item c). Carving the whole common
// git dir would reopen the same class: the worker plants .git/hooks or .git/config, then
// belt_commit_staged runs git from the belt process and the hook executes as the controller
// (bright-moth-475 on 13942). Choice (1): keep objects/refs/logs/packed-refs and THIS attempt's
// .git/worktrees/<entry> writable; do not carve .git itself, so hooks, config, and info cannot be
// created or written, and never the .git/worktrees parent: its sibling entries hold other attempts'
// commondir and gitdir, and a worker that could rewrite them would redirect the controller's git in
// that sibling's worktree (review 81064). Choice (2)
// (never run git with authority in a worker-writable repo) is the publication-transport
// precedent and is not this cut; belt_commit_git still prefixes git_command_config_inert_args
// so a planted hook would not be the hooksPath the controller uses. /tmp is PrivateTmp=yes.
//
// THE SHARED REF STORE IS A DECLARED RESIDUAL, NOT CONFINED. refs/ and logs/ stay writable as wholes
// because git updates a ref through a <ref>.lock created beside it, so the ref's directory must be
// writable, and refs/heads/dispatch/ holds every attempt's branch. A worker can therefore move any
// ref in the shared repository, including another attempt's branch and the controller's base refs; it
// still cannot reach hooks or config, and the controller's own git runs with
// git_command_config_inert_args. Removal: a per-attempt git directory (the worker commits into a
// repository of its own whose objects borrow the shared store as an alternate, and the controller
// fetches the attempt branch from it), recorded on
// gunbc.recurring_failure_mode.protect_carve_out_reopens_the_protected_subject.
//
// PACKED-REFS LEFT THIS LIST AT WORKER-ROOT-EQUIVALENT-3, and the reason it was never load-bearing is
// worth keeping in prose. A worker has NEVER been able to rewrite packed-refs: git rewrites it by
// creating packed-refs.lock IN .git ITSELF, which #13942 confines, so the grant named a file whose
// only rewrite path was already closed. It was inert rather than dangerous -- until a claim read it
// as a capability. The write-set derivation (gunbc.roadmap.roadmap_dashboard_instance
// dashboard_git_worker_commit_write_set, measured) says the commit never touches packed-refs: a new
// branch is written LOOSE, and a loose ref shadows the packed one. Rewriting it is a root maintenance
// job -- dashboard_instance_git_repository_maintenance -- which is also why the automatic sweep is
// switched off for the repository rather than given a grant for its noise.
fn dispatch_worker_git_writable_paths(instance: HostDashboardInstance, attempt_worktree: String) -> List<String> {
  let git = join([instance.repo_root as String, "/.git"], "")
  [
    join([git, "/objects"], ""),
    join([git, "/refs"], ""),
    join([git, "/logs"], ""),
    dispatch_attempt_private_git_dir(instance: instance, attempt_worktree: attempt_worktree),
  ]
}

fn dispatch_worker_unit_properties_for_plan(instance: HostDashboardInstance, plan: DispatchWorkerUnitPlan, granted: Kibibyte, process_bounds: UnitProcessBounds) -> List<SystemdRunProperty> {
  dispatch_worker_unit_stream_properties(
    instance: instance,
    working_directory: plan.working_directory,
    attempt_worktree: plan.attempt_worktree,
    stdout_path: plan.stdout_path,
    stderr_path: plan.stderr_path,
    granted: granted,
    process_bounds: process_bounds,
    exit_hook: plan.exit_hook,
  )
}

fn dispatch_worker_unit_stream_properties(
  instance: HostDashboardInstance,
  working_directory: String,
  attempt_worktree: String,
  stdout_path: String,
  stderr_path: String,
  granted: Kibibyte,
  process_bounds: UnitProcessBounds,
  exit_hook: NonEmptyStr,
) -> List<SystemdRunProperty> {
  let set = dispatch_worker_handed_set(
    instance: instance,
    working_directory: working_directory,
    attempt_worktree: attempt_worktree,
    stdout_path: stdout_path,
    stderr_path: stderr_path,
  )
  concat(
    concat(
      compute_grant_unit_properties(granted: granted, working_directory: dispatch_worker_set_working_directory(set: set), process_bounds: Present { value: process_bounds }),
      concat(dispatch_model_driven_privilege_confinement_properties(), dispatch_worker_umask_properties(instance: instance)),
    ),
    concat(
      [
        NamedUnitSetting { property: StandardOutputProperty, value: dispatch_worker_set_stream_wire(set: set, stdout: true) as NonEmptyStr },
        NamedUnitSetting { property: StandardErrorProperty, value: dispatch_worker_set_stream_wire(set: set, stdout: false) as NonEmptyStr },
        NamedUnitSetting { property: ProtectSystemProperty, value: "strict" as NonEmptyStr },
        NamedUnitSetting { property: ProtectHomeProperty, value: "read-only" as NonEmptyStr },
        NamedUnitSetting { property: PrivateTmpProperty, value: "yes" as NonEmptyStr },
        NamedUnitSetting { property: ReadWritePathsProperty, value: dispatch_worker_set_read_write_wire(set: set) as NonEmptyStr },
        NamedUnitSetting { property: ReadOnlyPathsProperty, value: dispatch_worker_set_read_only_wire(set: set) as NonEmptyStr },
        NamedUnitSetting { property: ExecStopPostProperty, value: exit_hook },
      ],
      dispatch_worker_set_credential_settings(set: set),
    ),
  )
}

// THE HANDED SET, BUILT ONCE PER PLAN from the instance and the plan's own fields: the working
// directory, the serve binary, the exit-record root, the writable and read-only carve-outs, both log
// targets and the harness worker's module roots. Every renderer and the reach check read THIS value
// (gunbc.roadmap.dispatch_worker_handed_set); the carve-out lists below are its sources and nothing
// else consumes them as a second answer.
fn dispatch_worker_handed_set(
  instance: HostDashboardInstance,
  working_directory: String,
  attempt_worktree: String,
  stdout_path: String,
  stderr_path: String,
) -> List<HandedEntry> {
  concat(
    concat(
      [
        HandedEntry { role: HandedWorkingDirectory, path: working_directory },
        HandedEntry { role: HandedExecutable, path: instance.serve_binary as String },
        HandedEntry { role: HandedExitRoot, path: attempt_exit_inbox_dir(instance_root: instance.instance_root as String) },
        HandedEntry { role: HandedStdout, path: stdout_path },
        HandedEntry { role: HandedStderr, path: stderr_path },
      ],
      dispatch_worker_source_roots(repo_root: instance.repo_root as String),
    ),
    concat(
      concat(
        map(
          dispatch_worker_writable_path_list(instance: instance, attempt_worktree: attempt_worktree, scratch_directory: path_parent_directory(path: stdout_path)),
          p => HandedEntry { role: HandedReadWrite, path: p },
        ),
        map(
          dispatch_worker_git_pointer_readonly_list(instance: instance, attempt_worktree: attempt_worktree),
          p => HandedEntry { role: HandedReadOnly { missing_ok: false }, path: p },
        ),
      ),
      map(
        dispatch_worker_credentials(instance: instance),
        c => HandedEntry { role: HandedCredentialSource { identifier: c.identifier }, path: c.credstore_path as String },
      ),
    ),
  )
}

// THE CREDENTIALS A DEDICATED WORKER IS HANDED, AND WHERE EACH ONE COMES FROM. The harness worker reaches its model
// over the operator route, whose key is the service user's custody in its home
// (gunbc.harness.harness_operator_route OperatorCredentialCustody). A worker running AS the service user reads it
// there; a dedicated worker account has no home and must not hold a standing copy, so the manager hands the unit
// the file at start (LoadCredential=) and removes it at stop. The manager opens the source as root, so the source
// is a root-owned copy under the system credstore and never the custody path itself: a path the service user can
// write or relink, opened by root, would let any launch it requests read an arbitrary root-only file into a unit
// it directs. The deploy makes the copy reading the custody AS THE SERVICE USER
// (gunbc.live_deploy.apply_legs credstore_copy_legs), so the copy can only ever hold bytes that principal
// could read itself. Per instance, because two instances on one host may hold different keys. A rotated key
// reaches the worker at the next deploy, not before.
//
// The identifier is the route's own (gunbc.harness.harness_operator_credential), so the file the unit is handed
// and the file the harness looks up in $CREDENTIALS_DIRECTORY are one datum.
type DispatchWorkerCredential {
  identifier: NonEmptyStr
  custody_source: NonEmptyStr
  credstore_path: NonEmptyStr
}

// THE CREDSTORE COPY'S PATH, ONE SPELLING: <credstore>/<identifier>-<instance id>. The deploy installs the copy here
// and the unit loads it from here, both through dispatch_worker_credentials, which is the only caller.
fn dispatch_worker_credstore_path(instance: HostDashboardInstance, file: OperatorCredentialFile) -> NonEmptyStr {
  join([systemd_system_credstore_directory as String, "/", file.identifier as String, "-", instance.instance_id as String], "") as NonEmptyStr
}

fn dispatch_worker_credential(instance: HostDashboardInstance, file: OperatorCredentialFile) -> DispatchWorkerCredential {
  DispatchWorkerCredential {
    identifier: file.identifier,
    custody_source: join([fleet_posix_home_directory(login: instance.directory_owner.user) as String, "/", file.relative_path as String], "") as NonEmptyStr,
    credstore_path: dispatch_worker_credstore_path(instance: instance, file: file),
  }
}

fn dispatch_worker_credentials(instance: HostDashboardInstance) -> List<DispatchWorkerCredential> {
  match instance.worker {
    WorkerIsServiceUser => []
    WorkerDedicatedAccount => [dispatch_worker_credential(instance: instance, file: operator_route_credential_file)]
  }
}

fn dispatch_worker_writable_path_list(instance: HostDashboardInstance, attempt_worktree: String, scratch_directory: String) -> List<String> {
  concat(
    [attempt_worktree, scratch_directory],
    dispatch_worker_git_writable_paths(instance: instance, attempt_worktree: attempt_worktree),
  )
}

fn dispatch_worker_writable_paths(instance: HostDashboardInstance, attempt_worktree: String, scratch_directory: String) -> String {
  join(dispatch_worker_writable_path_list(instance: instance, attempt_worktree: attempt_worktree, scratch_directory: scratch_directory), separator: " ")
}

fn dispatch_worktree_entry_name(attempt_worktree: String) -> String {
  fold(split(s: attempt_worktree, delimiter: "/"), init: "", f: (acc, seg) => if seg == "" { acc } else { seg })
}

fn dispatch_worktree_path_for_instance(
  instance: HostDashboardInstance,
  node_id: RoadmapNodeId,
  attempt_key: String,
) -> String {
  join([
    dashboard_instance_dispatch_worktree_root(instance: instance) as String,
    "/",
    node_id as String,
    "-a",
    attempt_key,
  ], "")
}

// THE BOUNDS A GRANT DOES NOT CARRY. product.capacity.pool grants memory only, so CPU and task
// ceilings are stated beside it rather than pretended to come from it (DESIGN 3b: a divergence with
// its reason). They are policy budgets for the dogfood capped unit (operator ruling 2026-10-03: a
// capped systemd unit plus a lease is sufficient): eight cores and 4096 tasks bound a runaway
// session without throttling the single `gunbc run` a harness worker is. Falsifiable: a worker unit
// ending in Result=resources, or a throughput regression attributed to CPUQuota, re-derives them.
data session_process_bounds: UnitProcessBounds = UnitProcessBounds { cpu_quota: millicore(count: 8000), tasks_max: 4096 }
