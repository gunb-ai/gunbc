module gunbc.roadmap.roadmap_dashboard_target_write

import std.optional { Present }
import std.types { String, Int, Bool, List, NonEmptyStr, FilePath }
import extdeps.shell
import extdeps.exec.command { argv_words }
import extdeps.tools.gnu_coreutils { dd_create_new_path_command }
import gunbc.typed_argv_exec {
  TypedArgvExecConverged,
  TypedArgvExecRefused,
  typed_argv_exec_over_ssh_with_stdin,
}
import gunbc.roadmap.roadmap_dashboard_instance {
  HostDashboardInstance,
  DashboardLocalProvision,
  DashboardSshProvision,
}

// THE CREATE-ONLY WRITE OF GIVEN BYTES ON A DASHBOARD INSTANCE'S TARGET HOST. This is the CommandHost
// realization of the Filesystem.WriteCreateNew effect contract (create-only, never overwrites, refuses
// when the path exists), NOT a second route beside it: Filesystem has no target transport, and the
// target host is reached only through typed argv. The contract is realized as ONE modelled argv --
// extdeps.tools.gnu_coreutils dd_create_new_path_command -- with the payload on stdin, so no byte of it
// is ever shell-parsed or an argv element. It takes the place of an inline `sh -c 'set -C; printf ...'`.
//
// The stdin leg has the same two arms as dashboard_target_exec (local controller exec | typed argv over
// ssh) and the same shell-safe argv wall (typed_argv_exec_over_ssh_with_stdin). It lives in this module
// rather than beside dashboard_target_exec only so as not to edit gunbc.roadmap.roadmap_dashboard_instance_apply
// under an in-flight change to it; the dispatch is the same two-arm match on provision_transport.
//
// THE REFUSAL IS UNCLASSIFIED ON PURPOSE. dd's exit status cannot separate "already exists" from
// "permission denied", and matching stderr text or probing after the fact would be a heuristic in place
// of an observation. A caller MUST treat CreateNewRefused and CreateNewNotDispatched as a refusal and
// never as success; in particular nothing may be removed on the strength of a write that did not land.
//
// FOLLOW-UPS (same gap, not covered here): Filesystem.WriteCreateNewWithMode, LinkCreateNew, Write and
// WriteOwnerOnly have no target-host realization either.
type DashboardCreateNewOutcome
  = CreateNewWritten
  | CreateNewRefused { exit_code: Int, stderr: String }
  | CreateNewNotDispatched { reason: String }

fn dashboard_create_new_argv(path: String) -> List<String> {
  argv_words(command: dd_create_new_path_command(path: path))
}

fn dashboard_create_new_outcome(exit_code: Int, stderr: String) -> DashboardCreateNewOutcome {
  if exit_code == 0 {
    CreateNewWritten
  } else {
    CreateNewRefused { exit_code: exit_code, stderr: stderr }
  }
}

fn dashboard_target_write_create_new(
  instance: HostDashboardInstance,
  path: FilePath,
  content: String,
) -> DashboardCreateNewOutcome {
  let argv = dashboard_create_new_argv(path: path as String)
  match first(argv) {
    Absent => CreateNewNotDispatched { reason: "the create-new command projected to no argv" }
    Present { value: program } =>
      match instance.provision_transport {
        DashboardLocalProvision => {
          let ran = shell.Exec.RunArgvStdin(
            program: program as NonEmptyStr,
            arguments: argv |> skip(n: 1),
            stdin_payload: content,
          )
          dashboard_create_new_outcome(exit_code: ran.exit_code, stderr: ran.stderr)
        }
        DashboardSshProvision { host } =>
          match typed_argv_exec_over_ssh_with_stdin(host: host, argv: argv, stdin_payload: content) {
            TypedArgvExecConverged { result } =>
              dashboard_create_new_outcome(exit_code: result.exit_code, stderr: result.stderr)
            TypedArgvExecRefused { reason } => CreateNewNotDispatched { reason: reason }
          }
      }
  }
}
