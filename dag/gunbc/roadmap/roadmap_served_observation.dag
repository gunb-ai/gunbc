module gunbc.roadmap_served_observation

import std.types { String, Int, Bool, List, NonEmptyStr }
import std.algebra { trim }
import std.content_hash { content_hash_tagged_structural, content_hash_atom }
import extdeps.http.server { MediaType, text_html_utf8, text_plain_utf8, application_json_utf8, ServeHttpResponse }
import extdeps.languages.html { EmitOk, EmitRejected, try_serialize_html_source }
import extdeps.languages.json.emit {
  JsonValue, JsonString, JsonArray,
  serialize_json, json_string, json_array, json_object, json_kv,
}
import extdeps.languages.json.parse {
  parse_json_document, JsonDocumentParsed, JsonDocumentUnreadable, json_document_gap_text,
  json_object_unique_member, JsonMemberFound, JsonMemberAbsent, JsonMemberDuplicated, JsonMemberNotAnObject,
}
import gunbc.host_layout { instance_receipts_dir }
import gunbc.roadmap_dashboard_instance { HostDashboardInstance }
import gunbc.roadmap_page { roadmap_daily_workspace_page_for_authority_observed }
import gunbc.roadmap_site_surface_render { page_render_refusal_body, site_artifact_digest }
import gunbc.roadmap_belt_actuate {
  BeltPassOutcome, BeltPassRecorded, BeltPassFailed,
  belt_launch_host_standing_for_page,
  belt_sessions_observe_for_instance, belt_sessions_observed_json, belt_sessions_http_status,
  belt_attempts_observe_for_instance, belt_attempts_observed_json, belt_attempts_http_status,
  belt_workflow_attempts_observe_for_instance,
  belt_workflow_attempts_observed_json_for_instance, belt_workflow_attempts_http_status,
  BeltWorkflowAttempts, WorkflowAttemptsObserved, WorkflowAttemptsRefused,
}

// THE DASHBOARD IS DISAGGREGATED INTO ONE PRODUCER AND ANY NUMBER OF STATELESS READERS. Before this
// module the serve process observed the host on every request: each page render forked ~26
// subprocess pairs (a `command -v` and a `git rev-parse` per dispatch worktree, tmux, jq) and under
// load the first byte took seven seconds. Observation is a property of the HOST at a moment, not of
// a request, so it belongs to the belt tick, which already walks the same worktrees once a minute
// and already persists its own receipt beside this one. The tick observes once and writes the four
// served surfaces as finished response bytes; serve reads two small files per request and spawns
// nothing, holds nothing, and can be replicated freely. A reader that finds no snapshot refuses with
// a typed 503 — it never falls back to observing for itself, because that fallback would silently
// restore the per-request cost the split exists to remove (the absorbing fallback, DESIGN 5).
//
// THE SURFACES ARE FILES, NOT JSON STRING MEMBERS. The first cut embedded the rendered bodies in one
// JSON document, and the reader then paid the JSON string scanner once per character of a 300 KB
// body: extdeps.languages.json.grammar json_text_parse_string_inner recurses per code point, which
// crossed the interpreter's call-depth wall and cost 16 s per request — worse than the observation
// it replaced. The rendered form is bytes, so it is stored as bytes: one body file per surface,
// digested by the same authority the static site surface uses, and a small index carrying
// observed_at, each surface's status and digest, and the index's own identity. The reader parses
// only the index, reads exactly the one body it serves, and refuses on a digest mismatch — which
// also makes the moment between a new index and an old body a typed refusal rather than a silently
// mixed page.

type ServedObservationKind
  = DailyPage
  | AttemptsJson
  | WorkflowJson
  | SessionsJson

type ServedObservationSurface {
  kind: ServedObservationKind
  status: Int
  body: String
}

type ServedObservationSnapshot {
  observed_at: String
  surfaces: List<ServedObservationSurface>
}

// The index entry is what the reader learns about a surface before touching its body: what it is,
// what status it carries, and the digest the body must hash to.
type ServedObservationEntry {
  kind: ServedObservationKind
  status: Int
  digest: String
}

type ServedObservationIndex {
  observed_at: String
  entries: List<ServedObservationEntry>
}

type ServedObservationRead
  = ServedObservationPresent { index: ServedObservationIndex }
  | ServedObservationAbsent
  | ServedObservationUnreadable { reason: String }

data served_observation_schema: String = "roadmap-served-observation/v2"

data served_observation_index_file_name: String = "served-observation.json"

fn served_observation_path_for_instance(instance: HostDashboardInstance) -> String {
  join([
    instance_receipts_dir(instance_root: instance.instance_root as String),
    "/",
    served_observation_index_file_name,
  ], "")
}

fn served_observation_body_path_for_instance(instance: HostDashboardInstance, kind: ServedObservationKind) -> String {
  join([
    instance_receipts_dir(instance_root: instance.instance_root as String),
    "/served-observation-",
    served_observation_kind_key(kind: kind),
    ".body",
  ], "")
}

fn served_observation_kind_key(kind: ServedObservationKind) -> String {
  match kind {
    DailyPage => "daily_page"
    AttemptsJson => "attempts_json"
    WorkflowJson => "workflow_json"
    SessionsJson => "sessions_json"
  }
}

fn served_observation_kind_url_path(kind: ServedObservationKind) -> String {
  match kind {
    DailyPage => "/"
    AttemptsJson => "/attempts.json"
    WorkflowJson => "/workflow.json"
    SessionsJson => "/sessions.json"
  }
}

fn served_observation_kind_media_type(kind: ServedObservationKind, status: Int) -> MediaType {
  match kind {
    DailyPage => if status == 200 { text_html_utf8 } else { text_plain_utf8 }
    AttemptsJson => application_json_utf8
    WorkflowJson => application_json_utf8
    SessionsJson => application_json_utf8
  }
}

type ServedObservationKindDecode
  = ServedObservationKindDecoded { kind: ServedObservationKind }
  | ServedObservationKindUnknown { key: String }

fn served_observation_kind_of_key(key: String) -> ServedObservationKindDecode {
  if key == "daily_page" { ServedObservationKindDecoded { kind: DailyPage } }
  else if key == "attempts_json" { ServedObservationKindDecoded { kind: AttemptsJson } }
  else if key == "workflow_json" { ServedObservationKindDecoded { kind: WorkflowJson } }
  else if key == "sessions_json" { ServedObservationKindDecoded { kind: SessionsJson } }
  else { ServedObservationKindUnknown { key: key } }
}

// The status set a surface can carry is closed: 200 observed, 503 observation refused, 500 the page
// emitter refused. Stored as its decimal label and decoded by membership, so an index carrying any
// other status is unreadable rather than served.
type ServedObservationStatusDecode
  = ServedObservationStatusDecoded { status: Int }
  | ServedObservationStatusUnknown { label: String }

fn served_observation_status_of_label(label: String) -> ServedObservationStatusDecode {
  if label == "200" { ServedObservationStatusDecoded { status: 200 } }
  else if label == "503" { ServedObservationStatusDecoded { status: 503 } }
  else if label == "500" { ServedObservationStatusDecoded { status: 500 } }
  else { ServedObservationStatusUnknown { label: label } }
}

fn served_observation_daily_surface_for_instance(instance: HostDashboardInstance, observed: BeltWorkflowAttempts) -> ServedObservationSurface {
  let launch = belt_launch_host_standing_for_page(instance: instance)
  let page = match observed {
    WorkflowAttemptsObserved { attempts } =>
      roadmap_daily_workspace_page_for_authority_observed(attempts: attempts, attempts_refused: none, launch: launch)
    WorkflowAttemptsRefused { reason } =>
      roadmap_daily_workspace_page_for_authority_observed(attempts: [], attempts_refused: Present { value: reason }, launch: launch)
  }
  match try_serialize_html_source(node: page) {
    EmitOk { html } => ServedObservationSurface { kind: DailyPage, status: 200, body: html }
    EmitRejected { reason } => ServedObservationSurface { kind: DailyPage, status: 500, body: page_render_refusal_body(reason: reason) }
  }
}

fn served_observation_attempts_surface_for_instance(instance: HostDashboardInstance) -> ServedObservationSurface {
  let a = belt_attempts_observe_for_instance(instance: instance)
  ServedObservationSurface { kind: AttemptsJson, status: belt_attempts_http_status(a: a), body: belt_attempts_observed_json(a: a) }
}

fn served_observation_workflow_surface_for_instance(instance: HostDashboardInstance, observed: BeltWorkflowAttempts) -> ServedObservationSurface {
  ServedObservationSurface {
    kind: WorkflowJson,
    status: belt_workflow_attempts_http_status(observed: observed),
    body: belt_workflow_attempts_observed_json_for_instance(instance: instance, observed: observed),
  }
}

fn served_observation_sessions_surface_for_instance(instance: HostDashboardInstance) -> ServedObservationSurface {
  let o = belt_sessions_observe_for_instance(instance: instance)
  ServedObservationSurface { kind: SessionsJson, status: belt_sessions_http_status(o: o), body: belt_sessions_observed_json(o: o) }
}

// The workflow attempts are observed ONCE per tick and shared by the two surfaces that project them
// (one observing authority, two projections), so the walk over dispatch worktrees happens once.
fn served_observation_snapshot_observe_for_instance(instance: HostDashboardInstance, observed_at: String) -> ServedObservationSnapshot {
  let observed = belt_workflow_attempts_observe_for_instance(instance: instance)
  ServedObservationSnapshot {
    observed_at: observed_at,
    surfaces: [
      served_observation_daily_surface_for_instance(instance: instance, observed: observed),
      served_observation_attempts_surface_for_instance(instance: instance),
      served_observation_workflow_surface_for_instance(instance: instance, observed: observed),
      served_observation_sessions_surface_for_instance(instance: instance),
    ],
  }
}

fn served_observation_body_digest(body: String) -> String {
  site_artifact_digest(body: body).digest as String
}

fn served_observation_entry_of_surface(s: ServedObservationSurface) -> ServedObservationEntry {
  ServedObservationEntry { kind: s.kind, status: s.status, digest: served_observation_body_digest(body: s.body) }
}

fn served_observation_index_of_snapshot(snapshot: ServedObservationSnapshot) -> ServedObservationIndex {
  ServedObservationIndex {
    observed_at: snapshot.observed_at,
    entries: snapshot.surfaces |> map(s => served_observation_entry_of_surface(s: s)),
  }
}

fn served_observation_entry_identity_text(e: ServedObservationEntry) -> String {
  join([served_observation_kind_key(kind: e.kind), "|", to_string(e.status), "|", e.digest], "")
}

fn served_observation_identity_text(index: ServedObservationIndex) -> String {
  join([
    index.observed_at, "|",
    join(index.entries |> map(e => served_observation_entry_identity_text(e: e)), "\n"),
  ], "")
}

fn served_observation_identity_hex(index: ServedObservationIndex) -> String {
  content_hash_tagged_structural(
    tag: "roadmap-served-observation-v2" as NonEmptyStr,
    payload: content_hash_atom(value: served_observation_identity_text(index: index) as NonEmptyStr),
  ).digest as String
}

fn served_observation_entry_json_value(e: ServedObservationEntry) -> JsonValue {
  json_object(members: [
    json_kv(key: "kind", value: json_string(s: served_observation_kind_key(kind: e.kind))),
    json_kv(key: "status", value: json_string(s: to_string(e.status))),
    json_kv(key: "digest", value: json_string(s: e.digest)),
  ])
}

fn served_observation_index_json_value(index: ServedObservationIndex) -> JsonValue {
  json_object(members: [
    json_kv(key: "schema", value: json_string(s: served_observation_schema)),
    json_kv(key: "observed_at", value: json_string(s: index.observed_at)),
    json_kv(key: "surfaces", value: json_array(elements: index.entries |> map(e => served_observation_entry_json_value(e: e)))),
    json_kv(key: "snapshot_identity", value: json_string(s: served_observation_identity_hex(index: index))),
  ])
}

fn served_observation_index_wire(index: ServedObservationIndex) -> String {
  serialize_json(v: served_observation_index_json_value(index: index))
}

type ServedObservationEntryDecode
  = ServedObservationEntryDecoded { entry: ServedObservationEntry }
  | ServedObservationEntryUnreadable { reason: String }

fn served_observation_entry_of_json(doc: JsonValue) -> ServedObservationEntryDecode {
  match json_object_unique_member(v: doc, key: "kind") {
    JsonMemberFound { value: JsonString { value: kind_key } } =>
      match served_observation_kind_of_key(key: kind_key) {
        ServedObservationKindUnknown { key } =>
          ServedObservationEntryUnreadable { reason: join(["served observation surface kind is unknown: ", key], "") }
        ServedObservationKindDecoded { kind } =>
          match json_object_unique_member(v: doc, key: "status") {
            JsonMemberFound { value: JsonString { value: status_label } } =>
              match served_observation_status_of_label(label: status_label) {
                ServedObservationStatusUnknown { label } =>
                  ServedObservationEntryUnreadable { reason: join(["served observation surface status is outside the closed set: ", label], "") }
                ServedObservationStatusDecoded { status } =>
                  match json_object_unique_member(v: doc, key: "digest") {
                    JsonMemberFound { value: JsonString { value: digest } } =>
                      ServedObservationEntryDecoded { entry: ServedObservationEntry { kind: kind, status: status, digest: digest } }
                    _ => ServedObservationEntryUnreadable { reason: "served observation surface digest is missing" }
                  }
              }
            _ => ServedObservationEntryUnreadable { reason: "served observation surface status is missing" }
          }
      }
    _ => ServedObservationEntryUnreadable { reason: "served observation surface kind is missing" }
  }
}

type ServedObservationEntriesDecode
  = ServedObservationEntriesDecoded { entries: List<ServedObservationEntry> }
  | ServedObservationEntriesUnreadable { reason: String }

fn served_observation_entries_from_member(doc: JsonValue) -> ServedObservationEntriesDecode {
  match json_object_unique_member(v: doc, key: "surfaces") {
    JsonMemberFound { value: JsonArray { elements } } =>
      fold(elements, init: ServedObservationEntriesDecoded { entries: [] }, f: (acc, e) => match acc {
        ServedObservationEntriesUnreadable { reason } => ServedObservationEntriesUnreadable { reason: reason }
        ServedObservationEntriesDecoded { entries } =>
          match served_observation_entry_of_json(doc: e) {
            ServedObservationEntryUnreadable { reason } => ServedObservationEntriesUnreadable { reason: reason }
            ServedObservationEntryDecoded { entry } => ServedObservationEntriesDecoded { entries: concat(entries, [entry]) }
          }
      })
    JsonMemberFound { value: _ } => ServedObservationEntriesUnreadable { reason: "served observation surfaces is not an array" }
    JsonMemberAbsent => ServedObservationEntriesUnreadable { reason: "served observation surfaces is missing" }
    JsonMemberDuplicated { count: _ } => ServedObservationEntriesUnreadable { reason: "served observation surfaces is duplicated" }
    JsonMemberNotAnObject => ServedObservationEntriesUnreadable { reason: "served observation is not an object" }
  }
}

fn served_observation_decode(raw: String) -> ServedObservationRead {
  match parse_json_document(s: raw) {
    JsonDocumentUnreadable { gap } =>
      ServedObservationUnreadable { reason: concat("the served observation index is ", json_document_gap_text(gap: gap)) }
    JsonDocumentParsed { value: doc } =>
      match json_object_unique_member(v: doc, key: "schema") {
        JsonMemberFound { value: JsonString { value: schema } } =>
          if schema != served_observation_schema {
            ServedObservationUnreadable { reason: "served observation schema is unknown" }
          } else {
            match json_object_unique_member(v: doc, key: "observed_at") {
              JsonMemberFound { value: JsonString { value: observed_at } } =>
                match served_observation_entries_from_member(doc: doc) {
                  ServedObservationEntriesUnreadable { reason } => ServedObservationUnreadable { reason: reason }
                  ServedObservationEntriesDecoded { entries } => {
                    let index = ServedObservationIndex { observed_at: observed_at, entries: entries }
                    match json_object_unique_member(v: doc, key: "snapshot_identity") {
                      JsonMemberFound { value: JsonString { value: claimed } } =>
                        if claimed != served_observation_identity_hex(index: index) {
                          ServedObservationUnreadable { reason: "served observation identity does not match its members" }
                        } else {
                          ServedObservationPresent { index: index }
                        }
                      _ => ServedObservationUnreadable { reason: "served observation snapshot_identity is missing" }
                    }
                  }
                }
              _ => ServedObservationUnreadable { reason: "served observation observed_at is missing" }
            }
          }
        _ => ServedObservationUnreadable { reason: "served observation schema is missing" }
      }
  }
}

fn served_observation_read_from_filesystem(success: Bool, content: String, error: String) -> ServedObservationRead {
  if success {
    if trim(content) == "" { ServedObservationAbsent } else { served_observation_decode(raw: content) }
  } else if string_contains(s: error, pattern: "No such file") || string_contains(s: error, pattern: "not found") {
    ServedObservationAbsent
  } else {
    ServedObservationUnreadable { reason: join(["served observation index could not be read: ", error], "") }
  }
}

fn served_observation_read_for_instance(instance: HostDashboardInstance) -> ServedObservationRead {
  let read = Filesystem.Read(path: served_observation_path_for_instance(instance: instance))
  served_observation_read_from_filesystem(success: read.success, content: read.content, error: read.error)
}

// Bodies first, index last: a reader that races the writer sees either the previous complete
// snapshot or the new one, and a body that does not hash to its index entry is refused.
fn served_observation_write_bodies_for_instance(instance: HostDashboardInstance, surfaces: List<ServedObservationSurface>) -> BeltPassOutcome {
  fold(surfaces, init: BeltPassRecorded, f: (acc, s) => match acc {
    BeltPassRecorded => {
      let write = Filesystem.Write(
        path: served_observation_body_path_for_instance(instance: instance, kind: s.kind),
        content: s.body,
      )
      if write.success {
        BeltPassRecorded
      } else {
        BeltPassFailed { reason: join(["the served observation ", served_observation_kind_key(kind: s.kind), " body could not be written: ", write.error], "") }
      }
    }
    _ => acc
  })
}

fn served_observation_write_for_instance(instance: HostDashboardInstance, snapshot: ServedObservationSnapshot) -> BeltPassOutcome {
  match served_observation_write_bodies_for_instance(instance: instance, surfaces: snapshot.surfaces) {
    BeltPassRecorded => {
      let write = Filesystem.Write(
        path: served_observation_path_for_instance(instance: instance),
        content: served_observation_index_wire(index: served_observation_index_of_snapshot(snapshot: snapshot)),
      )
      if write.success {
        BeltPassRecorded
      } else {
        BeltPassFailed { reason: join(["the served observation index could not be written: ", write.error], "") }
      }
    }
    other => other
  }
}

fn served_observation_observe_and_write_for_instance(instance: HostDashboardInstance, observed_at: String) -> BeltPassOutcome {
  served_observation_write_for_instance(
    instance: instance,
    snapshot: served_observation_snapshot_observe_for_instance(instance: instance, observed_at: observed_at),
  )
}

type ServedObservationEntryLookup
  = ServedObservationEntryFound { entry: ServedObservationEntry }
  | ServedObservationEntryMissing

fn served_observation_entry_lookup(index: ServedObservationIndex, kind: ServedObservationKind) -> ServedObservationEntryLookup {
  let key = served_observation_kind_key(kind: kind)
  fold(index.entries, init: ServedObservationEntryMissing, f: (acc, e) => match acc {
    ServedObservationEntryFound { entry } => ServedObservationEntryFound { entry: entry }
    ServedObservationEntryMissing =>
      if served_observation_kind_key(kind: e.kind) == key { ServedObservationEntryFound { entry: e } } else { ServedObservationEntryMissing }
  })
}

type ServedObservationBodyRead
  = ServedObservationBodyPresent { body: String }
  | ServedObservationBodyMissing { reason: String }
  | ServedObservationBodyMismatch { expected: String, actual: String }

fn served_observation_body_read_from_filesystem(entry: ServedObservationEntry, success: Bool, content: String, error: String) -> ServedObservationBodyRead {
  if !success {
    ServedObservationBodyMissing { reason: error }
  } else {
    let actual = served_observation_body_digest(body: content)
    if actual == entry.digest {
      ServedObservationBodyPresent { body: content }
    } else {
      ServedObservationBodyMismatch { expected: entry.digest, actual: actual }
    }
  }
}

fn served_observation_body_read_for_instance(instance: HostDashboardInstance, entry: ServedObservationEntry) -> ServedObservationBodyRead {
  let read = Filesystem.Read(path: served_observation_body_path_for_instance(instance: instance, kind: entry.kind))
  served_observation_body_read_from_filesystem(entry: entry, success: read.success, content: read.content, error: read.error)
}

fn served_observation_refusal_body(refusal: String, detail: String) -> String {
  serialize_json(v: json_object(members: [
    json_kv(key: "schema", value: json_string(s: served_observation_schema)),
    json_kv(key: "refusal", value: json_string(s: refusal)),
    json_kv(key: "detail", value: json_string(s: detail)),
  ]))
}

fn served_observation_refusal_response(refusal: String, detail: String) -> ServeHttpResponse {
  ServeHttpResponse {
    status: 503,
    content_type: application_json_utf8,
    body: served_observation_refusal_body(refusal: refusal, detail: detail),
  }
}

fn served_observation_body_response(entry: ServedObservationEntry, body: ServedObservationBodyRead) -> ServeHttpResponse {
  match body {
    ServedObservationBodyMissing { reason } =>
      served_observation_refusal_response(
        refusal: "ServedObservationBodyMissing",
        detail: join(["the ", served_observation_kind_key(kind: entry.kind), " body named by the index could not be read: ", reason], ""),
      )
    ServedObservationBodyMismatch { expected, actual } =>
      served_observation_refusal_response(
        refusal: "ServedObservationBodyMismatch",
        detail: join(["the ", served_observation_kind_key(kind: entry.kind), " body hashes to ", actual, " but the index names ", expected], ""),
      )
    ServedObservationBodyPresent { body: bytes } =>
      ServeHttpResponse {
        status: entry.status,
        content_type: served_observation_kind_media_type(kind: entry.kind, status: entry.status),
        body: bytes,
      }
  }
}

// The reader's refusals are distinct states with distinct owners: Absent means the belt has not
// ticked since the receipts dir was created (or the timer is not running); Unreadable means a
// producer and this reader disagree about the index wire; Missing means the index was written by a
// producer that did not render this surface; BodyMissing and BodyMismatch mean the body on disk is
// not the one the index names. None of them observes the host as a substitute.
fn served_observation_index_refusal(read: ServedObservationRead, kind: ServedObservationKind) -> ServeHttpResponse {
  match read {
    ServedObservationAbsent =>
      served_observation_refusal_response(refusal: "ServedObservationAbsent", detail: "no belt tick has published a served observation for this instance yet")
    ServedObservationUnreadable { reason } =>
      served_observation_refusal_response(refusal: "ServedObservationUnreadable", detail: reason)
    ServedObservationPresent { index } =>
      served_observation_refusal_response(
        refusal: "ServedObservationSurfaceMissing",
        detail: join(["the snapshot observed at ", index.observed_at, " carries no ", served_observation_kind_key(kind: kind), " surface"], ""),
      )
  }
}

fn served_observation_entry_for(read: ServedObservationRead, kind: ServedObservationKind) -> ServedObservationEntryLookup {
  match read {
    ServedObservationPresent { index } => served_observation_entry_lookup(index: index, kind: kind)
    ServedObservationAbsent => ServedObservationEntryMissing
    ServedObservationUnreadable { reason: _ } => ServedObservationEntryMissing
  }
}

fn served_observation_surface_response_for_instance(instance: HostDashboardInstance, kind: ServedObservationKind) -> ServeHttpResponse {
  let read = served_observation_read_for_instance(instance: instance)
  match served_observation_entry_for(read: read, kind: kind) {
    ServedObservationEntryMissing => served_observation_index_refusal(read: read, kind: kind)
    ServedObservationEntryFound { entry } =>
      served_observation_body_response(entry: entry, body: served_observation_body_read_for_instance(instance: instance, entry: entry))
  }
}

fn served_observation_standing_json_value(read: ServedObservationRead) -> JsonValue {
  match read {
    ServedObservationAbsent =>
      json_object(members: [
        json_kv(key: "schema", value: json_string(s: served_observation_schema)),
        json_kv(key: "standing", value: json_string(s: "absent")),
      ])
    ServedObservationUnreadable { reason } =>
      json_object(members: [
        json_kv(key: "schema", value: json_string(s: served_observation_schema)),
        json_kv(key: "standing", value: json_string(s: "unreadable")),
        json_kv(key: "reason", value: json_string(s: reason)),
      ])
    ServedObservationPresent { index } =>
      json_object(members: [
        json_kv(key: "schema", value: json_string(s: served_observation_schema)),
        json_kv(key: "standing", value: json_string(s: "present")),
        json_kv(key: "observed_at", value: json_string(s: index.observed_at)),
        json_kv(key: "snapshot_identity", value: json_string(s: served_observation_identity_hex(index: index))),
        json_kv(key: "surfaces", value: json_array(elements: index.entries |> map(e => json_object(members: [
          json_kv(key: "url_path", value: json_string(s: served_observation_kind_url_path(kind: e.kind))),
          json_kv(key: "status", value: json_string(s: to_string(e.status))),
          json_kv(key: "digest", value: json_string(s: e.digest)),
        ])))),
      ])
  }
}

fn served_observation_standing_http_status(read: ServedObservationRead) -> Int {
  match read {
    ServedObservationPresent { index: _ } => 200
    ServedObservationAbsent => 503
    ServedObservationUnreadable { reason: _ } => 503
  }
}

fn served_observation_standing_response_for_instance(instance: HostDashboardInstance) -> ServeHttpResponse {
  let read = served_observation_read_for_instance(instance: instance)
  ServeHttpResponse {
    status: served_observation_standing_http_status(read: read),
    content_type: application_json_utf8,
    body: serialize_json(v: served_observation_standing_json_value(read: read)),
  }
}
