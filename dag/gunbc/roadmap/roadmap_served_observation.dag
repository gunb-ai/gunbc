module gunbc.roadmap_served_observation

import std.types { String, Int, Bool, List, NonEmptyStr }
import std.algebra { trim }
import std.content_hash { content_hash_tagged_structural, content_hash_atom }
import extdeps.http.server { MediaType, text_html_utf8, text_plain_utf8, application_json_utf8, ServeHttpResponse }
import extdeps.languages.html { EmitOk, EmitRejected, try_serialize_html_source }
import extdeps.languages.json.emit {
  JsonValue, JsonString, JsonArray,
  serialize_json, json_string, json_array, json_object, json_kv,
}
import extdeps.languages.json.parse {
  parse_json_document, JsonDocumentParsed, JsonDocumentUnreadable, json_document_gap_text,
  json_object_unique_member, JsonMemberFound, JsonMemberAbsent, JsonMemberDuplicated, JsonMemberNotAnObject,
}
import gunbc.host_layout { instance_receipts_dir }
import gunbc.roadmap_dashboard_instance { HostDashboardInstance }
import gunbc.roadmap_page { roadmap_daily_workspace_page_for_authority_observed }
import gunbc.roadmap_site_surface_render { page_render_refusal_body }
import gunbc.roadmap_belt_actuate {
  BeltPassOutcome, BeltPassRecorded, BeltPassFailed,
  belt_launch_host_standing_for_page,
  belt_sessions_observe_for_instance, belt_sessions_observed_json, belt_sessions_http_status,
  belt_attempts_observe_for_instance, belt_attempts_observed_json, belt_attempts_http_status,
  belt_workflow_attempts_observe_for_instance,
  belt_workflow_attempts_observed_json_for_instance, belt_workflow_attempts_http_status,
  BeltWorkflowAttempts, WorkflowAttemptsObserved, WorkflowAttemptsRefused,
}

// THE DASHBOARD IS DISAGGREGATED INTO ONE PRODUCER AND ANY NUMBER OF STATELESS READERS. Before this
// module the serve process observed the host on every request: each page render forked ~26
// subprocess pairs (a `command -v` and a `git rev-parse` per dispatch worktree, tmux, jq) and under
// load the first byte took seven seconds. Observation is a property of the HOST at a moment, not of
// a request, so it belongs to the belt tick, which already walks the same worktrees once a minute
// and already persists its own receipt beside this one. The tick observes once and writes the four
// served surfaces as finished response bytes; serve reads one file per request and spawns nothing,
// holds nothing, and can be replicated freely. A reader that finds no snapshot refuses with a typed
// 503 — it never falls back to observing for itself, because that fallback would silently restore
// the per-request cost the split exists to remove (the absorbing fallback, DESIGN 5).
//
// The surfaces are stored RENDERED rather than as typed observations because the rendered form is
// the one every consumer wants and the one whose codec already exists (bytes), where a typed
// snapshot would need a second JSON codec for WorkflowAttemptProgress beside the wire one the
// endpoints already emit. Staleness is a first-class fact: observed_at is carried on the snapshot
// and published on /observation.json so a reader can tell a live host from a stalled belt.

type ServedObservationKind
  = DailyPage
  | AttemptsJson
  | WorkflowJson
  | SessionsJson

type ServedObservationSurface {
  kind: ServedObservationKind
  status: Int
  body: String
}

type ServedObservationSnapshot {
  observed_at: String
  surfaces: List<ServedObservationSurface>
}

type ServedObservationRead
  = ServedObservationPresent { snapshot: ServedObservationSnapshot }
  | ServedObservationAbsent
  | ServedObservationUnreadable { reason: String }

data served_observation_schema: String = "roadmap-served-observation/v1"

data served_observation_file_name: String = "served-observation.json"

fn served_observation_path_for_instance(instance: HostDashboardInstance) -> String {
  join([
    instance_receipts_dir(instance_root: instance.instance_root as String),
    "/",
    served_observation_file_name,
  ], "")
}

fn served_observation_kind_key(kind: ServedObservationKind) -> String {
  match kind {
    DailyPage => "daily_page"
    AttemptsJson => "attempts_json"
    WorkflowJson => "workflow_json"
    SessionsJson => "sessions_json"
  }
}

fn served_observation_kind_url_path(kind: ServedObservationKind) -> String {
  match kind {
    DailyPage => "/"
    AttemptsJson => "/attempts.json"
    WorkflowJson => "/workflow.json"
    SessionsJson => "/sessions.json"
  }
}

fn served_observation_kind_media_type(kind: ServedObservationKind, status: Int) -> MediaType {
  match kind {
    DailyPage => if status == 200 { text_html_utf8 } else { text_plain_utf8 }
    AttemptsJson => application_json_utf8
    WorkflowJson => application_json_utf8
    SessionsJson => application_json_utf8
  }
}

type ServedObservationKindDecode
  = ServedObservationKindDecoded { kind: ServedObservationKind }
  | ServedObservationKindUnknown { key: String }

fn served_observation_kind_of_key(key: String) -> ServedObservationKindDecode {
  if key == "daily_page" { ServedObservationKindDecoded { kind: DailyPage } }
  else if key == "attempts_json" { ServedObservationKindDecoded { kind: AttemptsJson } }
  else if key == "workflow_json" { ServedObservationKindDecoded { kind: WorkflowJson } }
  else if key == "sessions_json" { ServedObservationKindDecoded { kind: SessionsJson } }
  else { ServedObservationKindUnknown { key: key } }
}

// The status set a surface can carry is closed: 200 observed, 503 observation refused, 500 the page
// emitter refused. Stored as its decimal label and decoded by membership, so a snapshot carrying any
// other status is unreadable rather than served.
type ServedObservationStatusDecode
  = ServedObservationStatusDecoded { status: Int }
  | ServedObservationStatusUnknown { label: String }

fn served_observation_status_of_label(label: String) -> ServedObservationStatusDecode {
  if label == "200" { ServedObservationStatusDecoded { status: 200 } }
  else if label == "503" { ServedObservationStatusDecoded { status: 503 } }
  else if label == "500" { ServedObservationStatusDecoded { status: 500 } }
  else { ServedObservationStatusUnknown { label: label } }
}

fn served_observation_daily_surface_for_instance(instance: HostDashboardInstance, observed: BeltWorkflowAttempts) -> ServedObservationSurface {
  let launch = belt_launch_host_standing_for_page(instance: instance)
  let page = match observed {
    WorkflowAttemptsObserved { attempts } =>
      roadmap_daily_workspace_page_for_authority_observed(attempts: attempts, attempts_refused: none, launch: launch)
    WorkflowAttemptsRefused { reason } =>
      roadmap_daily_workspace_page_for_authority_observed(attempts: [], attempts_refused: Present { value: reason }, launch: launch)
  }
  match try_serialize_html_source(node: page) {
    EmitOk { html } => ServedObservationSurface { kind: DailyPage, status: 200, body: html }
    EmitRejected { reason } => ServedObservationSurface { kind: DailyPage, status: 500, body: page_render_refusal_body(reason: reason) }
  }
}

fn served_observation_attempts_surface_for_instance(instance: HostDashboardInstance) -> ServedObservationSurface {
  let a = belt_attempts_observe_for_instance(instance: instance)
  ServedObservationSurface { kind: AttemptsJson, status: belt_attempts_http_status(a: a), body: belt_attempts_observed_json(a: a) }
}

fn served_observation_workflow_surface_for_instance(instance: HostDashboardInstance, observed: BeltWorkflowAttempts) -> ServedObservationSurface {
  ServedObservationSurface {
    kind: WorkflowJson,
    status: belt_workflow_attempts_http_status(observed: observed),
    body: belt_workflow_attempts_observed_json_for_instance(instance: instance, observed: observed),
  }
}

fn served_observation_sessions_surface_for_instance(instance: HostDashboardInstance) -> ServedObservationSurface {
  let o = belt_sessions_observe_for_instance(instance: instance)
  ServedObservationSurface { kind: SessionsJson, status: belt_sessions_http_status(o: o), body: belt_sessions_observed_json(o: o) }
}

// The workflow attempts are observed ONCE per tick and shared by the two surfaces that project them
// (one observing authority, two projections), so the walk over dispatch worktrees happens once.
fn served_observation_snapshot_observe_for_instance(instance: HostDashboardInstance, observed_at: String) -> ServedObservationSnapshot {
  let observed = belt_workflow_attempts_observe_for_instance(instance: instance)
  ServedObservationSnapshot {
    observed_at: observed_at,
    surfaces: [
      served_observation_daily_surface_for_instance(instance: instance, observed: observed),
      served_observation_attempts_surface_for_instance(instance: instance),
      served_observation_workflow_surface_for_instance(instance: instance, observed: observed),
      served_observation_sessions_surface_for_instance(instance: instance),
    ],
  }
}

fn served_observation_surface_identity_text(s: ServedObservationSurface) -> String {
  join([served_observation_kind_key(kind: s.kind), "|", to_string(s.status), "|", to_string(string_length(s: s.body)), "|", s.body], "")
}

fn served_observation_identity_text(snapshot: ServedObservationSnapshot) -> String {
  join([
    snapshot.observed_at, "|",
    join(snapshot.surfaces |> map(s => served_observation_surface_identity_text(s: s)), "\n"),
  ], "")
}

fn served_observation_identity_hex(snapshot: ServedObservationSnapshot) -> String {
  content_hash_tagged_structural(
    tag: "roadmap-served-observation-v1" as NonEmptyStr,
    payload: content_hash_atom(value: served_observation_identity_text(snapshot: snapshot) as NonEmptyStr),
  ).digest as String
}

fn served_observation_surface_json_value(s: ServedObservationSurface) -> JsonValue {
  json_object(members: [
    json_kv(key: "kind", value: json_string(s: served_observation_kind_key(kind: s.kind))),
    json_kv(key: "status", value: json_string(s: to_string(s.status))),
    json_kv(key: "body", value: json_string(s: s.body)),
  ])
}

fn served_observation_json_value(snapshot: ServedObservationSnapshot) -> JsonValue {
  json_object(members: [
    json_kv(key: "schema", value: json_string(s: served_observation_schema)),
    json_kv(key: "observed_at", value: json_string(s: snapshot.observed_at)),
    json_kv(key: "surfaces", value: json_array(elements: snapshot.surfaces |> map(s => served_observation_surface_json_value(s: s)))),
    json_kv(key: "snapshot_identity", value: json_string(s: served_observation_identity_hex(snapshot: snapshot))),
  ])
}

fn served_observation_wire(snapshot: ServedObservationSnapshot) -> String {
  serialize_json(v: served_observation_json_value(snapshot: snapshot))
}

type ServedObservationSurfaceDecode
  = ServedObservationSurfaceDecoded { surface: ServedObservationSurface }
  | ServedObservationSurfaceUnreadable { reason: String }

fn served_observation_surface_of_json(doc: JsonValue) -> ServedObservationSurfaceDecode {
  match json_object_unique_member(v: doc, key: "kind") {
    JsonMemberFound { value: JsonString { value: kind_key } } =>
      match served_observation_kind_of_key(key: kind_key) {
        ServedObservationKindUnknown { key } =>
          ServedObservationSurfaceUnreadable { reason: join(["served observation surface kind is unknown: ", key], "") }
        ServedObservationKindDecoded { kind } =>
          match json_object_unique_member(v: doc, key: "status") {
            JsonMemberFound { value: JsonString { value: status_label } } =>
              match served_observation_status_of_label(label: status_label) {
                ServedObservationStatusUnknown { label } =>
                  ServedObservationSurfaceUnreadable { reason: join(["served observation surface status is outside the closed set: ", label], "") }
                ServedObservationStatusDecoded { status } =>
                  match json_object_unique_member(v: doc, key: "body") {
                    JsonMemberFound { value: JsonString { value: body } } =>
                      ServedObservationSurfaceDecoded { surface: ServedObservationSurface { kind: kind, status: status, body: body } }
                    _ => ServedObservationSurfaceUnreadable { reason: "served observation surface body is missing" }
                  }
              }
            _ => ServedObservationSurfaceUnreadable { reason: "served observation surface status is missing" }
          }
      }
    _ => ServedObservationSurfaceUnreadable { reason: "served observation surface kind is missing" }
  }
}

type ServedObservationSurfacesDecode
  = ServedObservationSurfacesDecoded { surfaces: List<ServedObservationSurface> }
  | ServedObservationSurfacesUnreadable { reason: String }

fn served_observation_surfaces_from_member(doc: JsonValue) -> ServedObservationSurfacesDecode {
  match json_object_unique_member(v: doc, key: "surfaces") {
    JsonMemberFound { value: JsonArray { elements } } =>
      fold(elements, init: ServedObservationSurfacesDecoded { surfaces: [] }, f: (acc, e) => match acc {
        ServedObservationSurfacesUnreadable { reason } => ServedObservationSurfacesUnreadable { reason: reason }
        ServedObservationSurfacesDecoded { surfaces } =>
          match served_observation_surface_of_json(doc: e) {
            ServedObservationSurfaceUnreadable { reason } => ServedObservationSurfacesUnreadable { reason: reason }
            ServedObservationSurfaceDecoded { surface } => ServedObservationSurfacesDecoded { surfaces: concat(surfaces, [surface]) }
          }
      })
    JsonMemberFound { value: _ } => ServedObservationSurfacesUnreadable { reason: "served observation surfaces is not an array" }
    JsonMemberAbsent => ServedObservationSurfacesUnreadable { reason: "served observation surfaces is missing" }
    JsonMemberDuplicated { count: _ } => ServedObservationSurfacesUnreadable { reason: "served observation surfaces is duplicated" }
    JsonMemberNotAnObject => ServedObservationSurfacesUnreadable { reason: "served observation is not an object" }
  }
}

fn served_observation_decode(raw: String) -> ServedObservationRead {
  match parse_json_document(s: raw) {
    JsonDocumentUnreadable { gap } =>
      ServedObservationUnreadable { reason: concat("the served observation is ", json_document_gap_text(gap: gap)) }
    JsonDocumentParsed { value: doc } =>
      match json_object_unique_member(v: doc, key: "schema") {
        JsonMemberFound { value: JsonString { value: schema } } =>
          if schema != served_observation_schema {
            ServedObservationUnreadable { reason: "served observation schema is unknown" }
          } else {
            match json_object_unique_member(v: doc, key: "observed_at") {
              JsonMemberFound { value: JsonString { value: observed_at } } =>
                match served_observation_surfaces_from_member(doc: doc) {
                  ServedObservationSurfacesUnreadable { reason } => ServedObservationUnreadable { reason: reason }
                  ServedObservationSurfacesDecoded { surfaces } => {
                    let snapshot = ServedObservationSnapshot { observed_at: observed_at, surfaces: surfaces }
                    match json_object_unique_member(v: doc, key: "snapshot_identity") {
                      JsonMemberFound { value: JsonString { value: claimed } } =>
                        if claimed != served_observation_identity_hex(snapshot: snapshot) {
                          ServedObservationUnreadable { reason: "served observation identity does not match its members" }
                        } else {
                          ServedObservationPresent { snapshot: snapshot }
                        }
                      _ => ServedObservationUnreadable { reason: "served observation snapshot_identity is missing" }
                    }
                  }
                }
              _ => ServedObservationUnreadable { reason: "served observation observed_at is missing" }
            }
          }
        _ => ServedObservationUnreadable { reason: "served observation schema is missing" }
      }
  }
}

fn served_observation_read_from_filesystem(success: Bool, content: String, error: String) -> ServedObservationRead {
  if success {
    if trim(content) == "" { ServedObservationAbsent } else { served_observation_decode(raw: content) }
  } else if string_contains(s: error, pattern: "No such file") || string_contains(s: error, pattern: "not found") {
    ServedObservationAbsent
  } else {
    ServedObservationUnreadable { reason: join(["served observation could not be read: ", error], "") }
  }
}

fn served_observation_read_for_instance(instance: HostDashboardInstance) -> ServedObservationRead {
  let read = Filesystem.Read(path: served_observation_path_for_instance(instance: instance))
  served_observation_read_from_filesystem(success: read.success, content: read.content, error: read.error)
}

fn served_observation_write_for_instance(instance: HostDashboardInstance, snapshot: ServedObservationSnapshot) -> BeltPassOutcome {
  let write = Filesystem.Write(
    path: served_observation_path_for_instance(instance: instance),
    content: served_observation_wire(snapshot: snapshot),
  )
  if write.success {
    BeltPassRecorded
  } else {
    BeltPassFailed { reason: join(["the served observation could not be written: ", write.error], "") }
  }
}

fn served_observation_observe_and_write_for_instance(instance: HostDashboardInstance, observed_at: String) -> BeltPassOutcome {
  served_observation_write_for_instance(
    instance: instance,
    snapshot: served_observation_snapshot_observe_for_instance(instance: instance, observed_at: observed_at),
  )
}

type ServedObservationSurfaceLookup
  = ServedObservationSurfaceFound { surface: ServedObservationSurface }
  | ServedObservationSurfaceMissing

fn served_observation_surface_lookup(snapshot: ServedObservationSnapshot, kind: ServedObservationKind) -> ServedObservationSurfaceLookup {
  let key = served_observation_kind_key(kind: kind)
  fold(snapshot.surfaces, init: ServedObservationSurfaceMissing, f: (acc, s) => match acc {
    ServedObservationSurfaceFound { surface } => ServedObservationSurfaceFound { surface: surface }
    ServedObservationSurfaceMissing =>
      if served_observation_kind_key(kind: s.kind) == key { ServedObservationSurfaceFound { surface: s } } else { ServedObservationSurfaceMissing }
  })
}

fn served_observation_refusal_body(refusal: String, detail: String) -> String {
  serialize_json(v: json_object(members: [
    json_kv(key: "schema", value: json_string(s: served_observation_schema)),
    json_kv(key: "refusal", value: json_string(s: refusal)),
    json_kv(key: "detail", value: json_string(s: detail)),
  ]))
}

// The reader's three refusals are distinct states with distinct owners: Absent means the belt has
// not ticked since the receipts dir was created (or the timer is not running); Unreadable means a
// producer and this reader disagree about the wire; Missing means the snapshot was written by a
// producer that did not render this surface. None of them observes the host as a substitute.
fn served_observation_surface_response(read: ServedObservationRead, kind: ServedObservationKind) -> ServeHttpResponse {
  match read {
    ServedObservationAbsent =>
      ServeHttpResponse {
        status: 503,
        content_type: application_json_utf8,
        body: served_observation_refusal_body(refusal: "ServedObservationAbsent", detail: "no belt tick has published a served observation for this instance yet"),
      }
    ServedObservationUnreadable { reason } =>
      ServeHttpResponse {
        status: 503,
        content_type: application_json_utf8,
        body: served_observation_refusal_body(refusal: "ServedObservationUnreadable", detail: reason),
      }
    ServedObservationPresent { snapshot } =>
      match served_observation_surface_lookup(snapshot: snapshot, kind: kind) {
        ServedObservationSurfaceMissing =>
          ServeHttpResponse {
            status: 503,
            content_type: application_json_utf8,
            body: served_observation_refusal_body(
              refusal: "ServedObservationSurfaceMissing",
              detail: join(["the snapshot observed at ", snapshot.observed_at, " carries no ", served_observation_kind_key(kind: kind), " surface"], ""),
            ),
          }
        ServedObservationSurfaceFound { surface } =>
          ServeHttpResponse {
            status: surface.status,
            content_type: served_observation_kind_media_type(kind: surface.kind, status: surface.status),
            body: surface.body,
          }
      }
  }
}

fn served_observation_surface_response_for_instance(instance: HostDashboardInstance, kind: ServedObservationKind) -> ServeHttpResponse {
  served_observation_surface_response(read: served_observation_read_for_instance(instance: instance), kind: kind)
}

fn served_observation_standing_json_value(read: ServedObservationRead) -> JsonValue {
  match read {
    ServedObservationAbsent =>
      json_object(members: [
        json_kv(key: "schema", value: json_string(s: served_observation_schema)),
        json_kv(key: "standing", value: json_string(s: "absent")),
      ])
    ServedObservationUnreadable { reason } =>
      json_object(members: [
        json_kv(key: "schema", value: json_string(s: served_observation_schema)),
        json_kv(key: "standing", value: json_string(s: "unreadable")),
        json_kv(key: "reason", value: json_string(s: reason)),
      ])
    ServedObservationPresent { snapshot } =>
      json_object(members: [
        json_kv(key: "schema", value: json_string(s: served_observation_schema)),
        json_kv(key: "standing", value: json_string(s: "present")),
        json_kv(key: "observed_at", value: json_string(s: snapshot.observed_at)),
        json_kv(key: "snapshot_identity", value: json_string(s: served_observation_identity_hex(snapshot: snapshot))),
        json_kv(key: "surfaces", value: json_array(elements: snapshot.surfaces |> map(s => json_object(members: [
          json_kv(key: "url_path", value: json_string(s: served_observation_kind_url_path(kind: s.kind))),
          json_kv(key: "status", value: json_string(s: to_string(s.status))),
          json_kv(key: "body_length", value: json_string(s: to_string(string_length(s: s.body)))),
        ])))),
      ])
  }
}

fn served_observation_standing_http_status(read: ServedObservationRead) -> Int {
  match read {
    ServedObservationPresent { snapshot: _ } => 200
    ServedObservationAbsent => 503
    ServedObservationUnreadable { reason: _ } => 503
  }
}

fn served_observation_standing_response_for_instance(instance: HostDashboardInstance) -> ServeHttpResponse {
  let read = served_observation_read_for_instance(instance: instance)
  ServeHttpResponse {
    status: served_observation_standing_http_status(read: read),
    content_type: application_json_utf8,
    body: serialize_json(v: served_observation_standing_json_value(read: read)),
  }
}
