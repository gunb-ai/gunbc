module gunbc.roadmap.roadmap_authority_fixture_writer

// THE ONE PLACE THE ROADMAP AUTHORITY FIXTURE MAY BE WRITTEN.
//
// test.claim.roadmap.roadmap_authority commits a small acceptance log under the checkout
// (fixtures/roadmap_authority/events) so that the witnesses which keep the REAL Filesystem.List walk alive
// have something real to walk. Those witnesses read. They must never be the thing that writes: a test module
// that can both author its own input and assert over it can be talked into agreement with whatever the code
// next does, which is the opposite of what a witness is for. So the write lives here, in an instrument with a
// typed contract, and the test module's only contact with it is (a) handing over path/content pairs and (b)
// interrogating the guard.
//
// WHY THIS IS NOT gunbc.instruments.generated_artifact_gate::write_generated_artifact, AND WHY THAT
// IS NOT A SECOND PATH. The gate is the sanctioned route FOR ITS OWN ROSTER: it selects from
// gunbc.generated_artifact::generated_artifact_registry and refuses anything unrostered
// (gunbc.generated_artifact GeneratedArtifactPathUnrostered). That roster is a CLOSED POPULATION --
// the files the repo's own build, CI and toolchain read as INPUTS (workflows, .gitignore, the stage0
// mirrors, the iOS oracle fixtures), each carrying an artifact_location, a RepoConsumer disposition
// answering why the file must survive in a git checkout, and a producer row that must resolve to a
// live declaration. Adding a variant is not a local edit: it is a new member of that population, so
// every exhaustive match over GeneratedArtifact gains an arm, plus a registry row, a generator arm, a
// commit policy, a ledger row and a docs-projection arm. Ruling roadmap acceptance-event bytes onto it
// is a claim about what those bytes are FOR, and that ruling is not this change's to make -- it is the
// kind of decision that belongs in gunbc.design_ruling, not smuggled in beside a test-infrastructure PR.
//
// SO THIS TAKES THE WRITE PATH EVERY OTHER FILE-WRITING MODULE TAKES. Filesystem.Write is the ordinary
// route for a module that writes a file -- hundreds of modules across dag/ and src/v2 take it, among
// them gunbc.std.durable_append_log and the product store modules -- and gunbc.command_runner's
// LocalExec is the ordinary transport for the one mkdir -p that must precede it, because
// Filesystem.Write creates no parent directory and returns FALSE SILENTLY when the parent is missing
// (measured: the first wet run wrote nothing and said only false). That is not a route parallel to the
// gate; the gate is one of the users of these same two primitives. What the gate gets from its roster
// -- which prefix may be written, and that a refused write is never reported as success -- is supplied
// HERE for the one prefix this emitter may touch: roadmap_authority_fixture_guard is the prefix
// admission, RoadmapAuthorityFixtureWrite is the refusal, and the guard is itself interrogated by a
// witness rather than trusted by assertion. The how_to_work tells for "a second path beside a modelled
// route" is about an artifact that will not survive the terminal architecture; this fixture is read by
// the interpreter's own Filesystem.Read as the oracle for the encoder's bytes, which is exactly the
// shape of the fixture rows the gate already carries.
//
// IF THE FIXTURE IS RULED GATE-GOVERNED, THE ROSTER ROW OWNS BOTH STEPS. That row would supply the
// prefix admission and the parent-directory step, and this module collapses to
// roadmap_authority_fixture_bytes plus a call to write_generated_artifact -- the cheaper shape, and the
// one to take once such a ruling exists. It is not taken here because the ruling does not.
//
// EVERY STEP ANSWERS WITH A TYPE, INCLUDING THE FAILURE. The first wet run of the generator returned false
// five times over five files and nothing noticed: a Bool cannot say which file, which step, or why, and
// 'false' looks exactly like a finished run. gunbc.design_argument::fail_closed ("Done means a real consumer
// green by execution plus a discriminating input that goes red when the behavior is wrong") makes that a
// defect, so each step answers with RoadmapAuthorityFixtureWrite naming path, step and reason, and the emit
// refuses as a whole on the FIRST refusal rather than folding successes over it.
//
// REGENERATE THE FIXTURE WITH THIS, from a throwaway clone and never the lab checkout:
//   SCRATCH=$(mktemp -d) && git clone --shared <repo-url> "$SCRATCH" && cd "$SCRATCH" && git checkout <head>
//   GUNBC_MEMORY_BUDGET_BYTES=42949672960 systemd-run --user --scope -p MemoryMax=48G \
//     ./release-bins/unpacked/claim_batch --source-root dag --source-root src/v1 --source-root src/v2 \
//       --entry dag/test/claim/roadmap/roadmap_authority.dag --wet \
//       --functions roadmap_authority_fixture_emit_ok
// It can write only the five files under fixtures/roadmap_authority/events, and the guard refuses the rest.
//
// BOTH EFFECTS ARE REFUSED HERMETICALLY (Filesystem.Write and the command transport alike), which is another
// way of saying this module has exactly one mode: wet.

import extdeps.filesystem.filesystem_io
import std.filesystem { path_parent_directory }
import std.integer { int_to_decimal_string }
import extdeps.tools.gnu_coreutils { mkdir_parents_command }
import extdeps.exec.command { LocalExec }
import extdeps.shell.exec { ProcessOutputAbsent, ProcessOutputPresent, ProcessRefused }
import gunbc.command_runner { run_shell_command_capture }

// ONE PATH IS WRITABLE HERE, AND THE TYPE SAYS WHICH. Not decoration: the live route reads its acceptance log
// from a working-tree `events/` directory, so a generator that could be aimed at any path is a generator that
// will someday be aimed at the lab's log, or at /opt/gunbc/roadmap-events, or at a real instance root. No
// absolute path, no traversal, nothing outside the committed fixture root.
// ONE SPELLING OF THE DIRECTORY, IN THE MODULE THAT WRITES IT. The witnesses that READ the committed log
// import these two; they do not re-spell the path. A root written twice is a fork: the reader and the writer
// can drift apart, and the drift shows up as a witness reading a different directory than the one generated --
// which is a missing-fixture FAIL, the exact state this PR exists to make impossible.
data roadmap_authority_fixture_worktree_dir: String = "fixtures/roadmap_authority"

fn roadmap_authority_fixture_worktree_root() -> String { roadmap_authority_fixture_worktree_dir }

fn roadmap_authority_fixture_root() -> String { concat(roadmap_authority_fixture_worktree_dir, "/events") }

fn roadmap_authority_fixture_write_prefix() -> String { concat(roadmap_authority_fixture_root(), "/") }

fn roadmap_authority_fixture_write_allowed(path: String) -> Bool {
  !path.starts_with(prefix: "/")
    && !path.contains(fragment: "..")
    && path.starts_with(prefix: roadmap_authority_fixture_write_prefix())
}

type RoadmapAuthorityFixtureWrite =
    FixtureFileWritten { path: String }
  | FixtureWriteRefused { path: String, step: String, reason: String }

type RoadmapAuthorityFixtureEmit =
    FixtureEmitComplete { written: List<String> }
  | FixtureEmitRefused { path: String, step: String, reason: String }

type FixtureWriteTarget {
  path: String
  content: String
}

// THE GUARD IS ITS OWN QUESTION, ANSWERED OVER A PATH. It used to be an && inside the emitter, which meant the
// only way to test it was to run a real write -- and a real write is exactly what the guard exists to stop.
// Taking the path as a parameter makes it interrogable without touching a filesystem, which is what makes the
// control in the test module hermetic.
fn roadmap_authority_fixture_guard(path: String) -> RoadmapAuthorityFixtureWrite? {
  if roadmap_authority_fixture_write_allowed(path: path) {
    Absent
  } else {
    Present {
      value: FixtureWriteRefused {
        path: path,
        step: "guard",
        reason: concat(
          "refused to write ",
          concat(path, ": not under the committed fixture root, or absolute, or escaping it"),
        ),
      }
    }
  }
}

fn roadmap_authority_fixture_write_refused(r: RoadmapAuthorityFixtureWrite) -> Bool {
  match r {
    FixtureFileWritten { path: _ } => false
    FixtureWriteRefused { path: _, step: _, reason: _ } => true
  }
}

// A PARENT DIRECTORY IS A PRECONDITION, NOT A COURTESY. Filesystem.Write is a pure write and never plants a
// tree -- the repo witnesses that property as load-bearing at
// test.claim.generated_artifact_write_absent_dir_wet_witness
// the_same_write_without_the_directory_step_refuses_by_real_execution. So this does what the sanctioned route
// does (gunbc.instruments.generated_artifact_gate write_generated_artifact): mkdir -p over the local command
// transport, then the write.
fn roadmap_authority_fixture_make_parent(path: String) -> RoadmapAuthorityFixtureWrite? {
  match run_shell_command_capture(
    command: mkdir_parents_command(path: path_parent_directory(path: path)), transport: LocalExec,
  ) {
    ProcessRefused { exit_code: code, stderr: err } => Present {
      value: FixtureWriteRefused {
        path: path,
        step: "mkdir",
        reason: concat(
          concat("mkdir -p refused for ", path_parent_directory(path: path)),
          concat(concat(": exit ", int_to_decimal_string(value: code)), concat(": ", err)),
        ),
      }
    }
    // NO OUTPUT IS NOT SUCCESS. gunbc.extdeps.shell.exec ProcessOutcome has three inhabitants, and a
    // catch-all that maps the third to "the directory is there now" invents a precondition out of silence --
    // which is precisely the failure this module was built to stop, since a write into a missing parent is
    // the silent false that started this. Only a reported output says the step ran.
    ProcessOutputAbsent => Present {
      value: FixtureWriteRefused {
        path: path,
        step: "mkdir",
        reason: concat(
          "mkdir -p for ", concat(path_parent_directory(path: path), " reported no outcome; refusing to assume the parent exists"),
        ),
      }
    }
    ProcessOutputPresent { text: _ } => Absent
  }
}

fn roadmap_authority_fixture_write_target(t: FixtureWriteTarget) -> RoadmapAuthorityFixtureWrite {
  match roadmap_authority_fixture_guard(path: t.path) {
    Present { value: refusal } => refusal
    Absent => match roadmap_authority_fixture_make_parent(path: t.path) {
      Present { value: refusal } => refusal
      Absent => {
        let w = Filesystem.Write(path: t.path, content: t.content)
        if w.success {
          FixtureFileWritten { path: t.path }
        } else {
          FixtureWriteRefused {
            path: t.path, step: "write", reason: concat("Filesystem.Write refused: ", w.error),
          }
        }
      }
    }
  }
}

// THE EMIT REFUSES WHOLE, AND NAMES THE FIRST FAILURE. What this does NOT claim is worth as much as what it
// claims: evaluation here is not lazy, so `map` over the targets ATTEMPTS EVERY TARGET -- there is no
// short-circuit to be had, and a comment saying the run stops at the first refusal would be a lie about
// evaluation order. What is guaranteed is the thing that matters: a run in which any target failed is never
// reported as an emit that completed. The old shape folded Bools, which is how five separate failures read
// as one quiet false with no path on it; now the refusal carries the path, the step and the reason, and it
// is the FIRST refusal in target order. A partial log cannot be mistaken for a fixture.
fn roadmap_authority_fixture_write_all(targets: List<FixtureWriteTarget>) -> RoadmapAuthorityFixtureEmit {
  match first(
    map(targets, t => roadmap_authority_fixture_write_target(t: t))
      |> filter(r => roadmap_authority_fixture_write_refused(r: r)),
  ) {
    Present { value: r } => match r {
      FixtureWriteRefused { path: path, step: step, reason: reason } =>
        FixtureEmitRefused { path: path, step: step, reason: reason }
      // UNREACHABLE, AND REFUSING ANYWAY. The filter admits only refusals, so no written record can reach
      // this arm; the shape it must have if one ever does is a refusal that names itself, not a success with
      // an empty list standing in for files that were never counted. Reporting FixtureEmitComplete here would
      // be the emit inventing a result -- the same defect this module exists to remove from the fold.
      FixtureFileWritten { path: p } => FixtureEmitRefused {
        path: p,
        step: "emit",
        reason: "a completed write reached the refusal filter; refusing to report an emit built from it",
      }
    }
    Absent => FixtureEmitComplete { written: map(targets, t => t.path) }
  }
}
