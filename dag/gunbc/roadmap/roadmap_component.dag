// Creation paths for the attempt-driven regions: the bar's fill (before the face) and the
// inspection details (after the bar) with its stages/raw sections. A client-minted details is
// marked so the sweep can remove the whole element when the attempt vanishes — server-rendered
// details carry ticket content and only lose their attempt sections.
fn activity_fill_create_stmts() -> List<TsStmt> {
  [
    ts_expr_stmt(expr: ts_binop(
      left: ts_ident(name: "fl"),
      op: "=",
      right: ts_call(
        callee: ts_member(object: ts_ident(name: "document"), property: "createElement"),
        args: [ts_lit_str(value: "div")]))),
    ts_expr_stmt(expr: ts_binop(
      left: ts_member(object: ts_ident(name: "fl"), property: "className"),
      op: "=",
      right: ts_lit_str(value: "taskbar-fill"))),
    ts_const(name: "st", value: ts_call(
      callee: ts_member(object: ts_ident(name: "document"), property: "createElement"),
      args: [ts_lit_str(value: "div")])),
    ts_expr_stmt(expr: ts_binop(
      left: ts_member(object: ts_ident(name: "st"), property: "className"),
      op: "=",
      right: ts_lit_str(value: stage_strip_class))),
    ts_expr_stmt(expr: ts_call(
      callee: ts_member(object: ts_ident(name: "fl"), property: "append"),
      args: [ts_ident(name: "st")])),
    ts_const(name: "fc", value: ts_slot_query(obj: "tb", selector: ".taskbar-face")),
    ts_expr_stmt(expr: ts_binop(
      left: ts_ident(name: "fc"),
      op: "&&",
      right: ts_call(
        callee: ts_member(object: ts_ident(name: "fc"), property: "insertAdjacentElement"),
        args: [ts_lit_str(value: "beforebegin"), ts_ident(name: "fl")]))),
  ]
}

