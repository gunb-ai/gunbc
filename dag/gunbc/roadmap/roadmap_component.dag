              callee: ts_member(object: ts_ident(name: "aev"), property: "append"),
              args: [ts_ident(name: "er")])),
          ]))])),
        ts_if(
          cond: ts_binop(
            left: ts_binop(
              left: ts_member(object: ts_ident(name: "av"), property: "arm"),
              op: "===",
