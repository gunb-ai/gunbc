}

// SUMMARY-ONLY ROWS ARE THE SERVER'S DECIDED SURFACE (owner defect fix 2026-09-23): the dense
// issue-table line and the member rows inside a project disclosure or family group carry
// data-summary-only — the row's whole claim about execution is the latest attempt's summary,
// decided at serve (and gated there to recent-or-live). The client paint SKIPS these rows
// entirely: no stage-strip fill, and NO minted taskbar-inspect disclosure. Before this guard the
// paint minted one 'inspect' after every row the wire carried an attempt for — inline in the
// issue table, and stacked one-per-member inside project and family rows on the old dashboard
// lanes (fifteen deep). Execution history lives exclusively on the Work tab.
// THE COMPACT WORK SUMMARY REFRESH rides this same workflow observation: no second timer and no
// new route. Each wire attempt carries its current view revision
// (gunbc.roadmap.roadmap_build_meter attempt_view_revision). Where this page shows a summary for
// the attempt's node and the revision it drew differs, the page records the revision it now wants
// and asks its own address for the issue page, takes the summary the server rendered there, and
// replaces the body and the link destination whole: the picture catches up at once however much
// changed, and the browser draws nothing of its own.
//
// A RENDERING IS TAKEN ONLY IF IT IS THE ONE STILL WANTED. If revision B is wanted while the read
// for A is outstanding, A's rendering, arriving late, carries revision A and is discarded; only a
// rendering whose own revision equals the latest wanted one replaces what is drawn. One read is
// made per distinct wanted revision, so a page and a wire that keep disagreeing cannot make a read
// per observation; a read that fails forgets that revision, and the next observation asks again.
// If the recorded round count rose, the element gets its beat class once, never under reduced
// motion.
data workflow_meter_beat_ms: Milliseconds = 1500
data workflow_meter_wanted_attribute: String = "data-meter-wanted"
data workflow_meter_asked_attribute: String = "data-meter-asked"

fn workflow_meter_body_attribute_expr(element: String, attribute: String) -> TsExpr {
  ts_call(
    callee: ts_member(object: ts_member(object: ts_ident(name: element), property: "firstElementChild"), property: "getAttribute"),
    args: [ts_lit_str(value: attribute)])
}

fn workflow_meter_selector_expr() -> TsExpr {
  ts_binop(
    left: ts_binop(
      left: ts_lit_str(value: join(["[", build_meter_subject_attribute, "=\""], "")),
      op: "+",
      right: ts_member(object: ts_ident(name: "attempt"), property: "node_id")),
    op: "+",
    right: ts_lit_str(value: "\"]"))
}

fn workflow_meter_bm_call(method: String, args: List<TsExpr>) -> TsStmt {
  ts_expr_stmt(expr: ts_call(callee: ts_member(object: ts_ident(name: "bm"), property: method), args: args))
}

fn workflow_meter_bm_attribute(name: String) -> TsExpr {
  ts_call(callee: ts_member(object: ts_ident(name: "bm"), property: "getAttribute"), args: [ts_lit_str(value: name)])
}

fn workflow_meter_swap_stmts() -> List<TsStmt> {
  [
    ts_const(name: "fresh", value: ts_call(
      callee: ts_member(
        object: ts_call(
          callee: ts_member(object: ts_new(callee: ts_ident(name: "DOMParser"), args: []), property: "parseFromString"),
          args: [ts_ident(name: "page"), ts_lit_str(value: "text/html")]),
        property: "querySelector"),
      args: [ts_ident(name: "bmSelector")])),
    ts_if(
      cond: ts_binop(
        left: ts_binop(
          left: ts_binop(left: ts_ident(name: "fresh"), op: "&&", right: ts_member(object: ts_ident(name: "fresh"), property: "firstElementChild")),
          op: "&&",
          right: ts_member(object: ts_ident(name: "bm"), property: "firstElementChild")),
        op: "&&",
        right: ts_binop(
          left: workflow_meter_body_attribute_expr(element: "fresh", attribute: build_meter_revision_attribute),
          op: "===",
          right: workflow_meter_bm_attribute(name: workflow_meter_wanted_attribute))),
      then_stmt: ts_block(stmts: [
        ts_const(name: "bmRoundsBefore", value: ts_prefix(op: "+", expr: workflow_meter_body_attribute_expr(element: "bm", attribute: build_meter_rounds_attribute))),
        ts_expr_stmt(expr: ts_binop(
          left: ts_member(object: ts_ident(name: "bm"), property: "innerHTML"),
          op: "=",
          right: ts_member(object: ts_ident(name: "fresh"), property: "innerHTML"))),
        workflow_meter_bm_call(method: "setAttribute", args: [
          ts_lit_str(value: "href"),
          ts_call(callee: ts_member(object: ts_ident(name: "fresh"), property: "getAttribute"), args: [ts_lit_str(value: "href")]),
        ]),
        ts_if(
          cond: ts_binop(
            left: ts_binop(
              left: ts_prefix(op: "+", expr: workflow_meter_body_attribute_expr(element: "bm", attribute: build_meter_rounds_attribute)),
              op: ">",
              right: ts_ident(name: "bmRoundsBefore")),
            op: "&&",
            right: ts_prefix(op: "!", expr: build_meter_reduced_motion_expr())),
          then_stmt: ts_block(stmts: [
            ts_expr_stmt(expr: ts_call(
              callee: ts_member(object: ts_member(object: ts_ident(name: "bm"), property: "classList"), property: "add"),
              args: [ts_lit_str(value: build_meter_beat_class)])),
            ts_expr_stmt(expr: ts_call(
              callee: ts_ident(name: "setTimeout"),
              args: [
                ts_arrow(params: [], body: ts_block(stmts: [
                  ts_expr_stmt(expr: ts_call(
                    callee: ts_member(object: ts_member(object: ts_ident(name: "bm"), property: "classList"), property: "remove"),
                    args: [ts_lit_str(value: build_meter_beat_class)])),
                ])),
                ts_lit_num(text: to_string(workflow_meter_beat_ms)),
              ])),
          ]),
          else_stmt: none),
      ]),
      else_stmt: none),
  ]
}

fn workflow_meter_refresh_stmts() -> List<TsStmt> {
  [
    ts_const(name: "bmSelector", value: workflow_meter_selector_expr()),
    ts_const(name: "bm", value: ts_call(
      callee: ts_member(object: ts_ident(name: "document"), property: "querySelector"),
      args: [ts_ident(name: "bmSelector")])),
    ts_const(name: "mk", value: ts_binop(
      left: ts_member(object: ts_ident(name: "attempt"), property: build_meter_wire_revision_member),
      op: "||",
      right: ts_lit_str(value: ""))),
    ts_if(
      cond: ts_binop(
        left: ts_binop(
          left: ts_binop(left: ts_ident(name: "bm"), op: "&&", right: ts_ident(name: "mk")),
          op: "&&",
          right: ts_member(object: ts_ident(name: "bm"), property: "firstElementChild")),
        op: "&&",
        right: ts_binop(
          left: workflow_meter_body_attribute_expr(element: "bm", attribute: build_meter_revision_attribute),
          op: "!==",
          right: ts_ident(name: "mk"))),
      then_stmt: ts_block(stmts: [
        workflow_meter_bm_call(method: "setAttribute", args: [ts_lit_str(value: workflow_meter_wanted_attribute), ts_ident(name: "mk")]),
        ts_if(
          cond: ts_binop(left: workflow_meter_bm_attribute(name: workflow_meter_asked_attribute), op: "!==", right: ts_ident(name: "mk")),
          then_stmt: ts_block(stmts: [
            workflow_meter_bm_call(method: "setAttribute", args: [ts_lit_str(value: workflow_meter_asked_attribute), ts_ident(name: "mk")]),
            ts_expr_stmt(expr: ts_call(
              callee: ts_member(
                object: ts_call(
                  callee: ts_member(
                    object: ts_call(
                      callee: ts_member(
                        object: ts_call(
                          callee: ts_ident(name: "fetch"),
                          args: [ts_member(object: ts_member(object: ts_ident(name: "window"), property: "location"), property: "pathname")]),
                        property: "then"),
                      args: [ts_arrow(params: ["r"], body: ts_block(stmts: [
                        ts_return(expr: Present { value: ts_call(callee: ts_member(object: ts_ident(name: "r"), property: "text"), args: []) }),
                      ]))]),
                    property: "then"),
                  args: [ts_arrow(params: ["page"], body: ts_block(stmts: workflow_meter_swap_stmts()))]),
                property: "catch"),
              args: [ts_arrow(params: [], body: ts_block(stmts: [
                ts_if(
                  cond: ts_binop(left: workflow_meter_bm_attribute(name: workflow_meter_asked_attribute), op: "===", right: ts_ident(name: "mk")),
                  then_stmt: ts_block(stmts: [workflow_meter_bm_call(method: "removeAttribute", args: [ts_lit_str(value: workflow_meter_asked_attribute)])]),
                  else_stmt: none),
              ]))])),
          ]),
          else_stmt: none),
      ]),
      else_stmt: none),
  ]
}

fn workflow_mark_attempt_stmts() -> List<TsStmt> {
  concat(workflow_meter_refresh_stmts(), workflow_mark_attempt_paint_stmts())
}

fn workflow_mark_attempt_paint_stmts() -> List<TsStmt> {
  [
    ts_const(name: "wr", value: ts_call(
      callee: ts_member(
        object: ts_ident(name: "document"),
        property: "querySelector",
      ),
      args: [workflow_row_selector_expr(
        node_id: ts_member(
          object: ts_ident(name: "attempt"),
          property: "node_id",
        ),
      )],
    )),
    ts_const(name: "av", value: ts_binop(
      left: ts_member(object: ts_ident(name: "attempt"), property: "activity"),
      op: "||",
      right: ts_ident(name: "null"))),
    ts_let(name: "tb", value: workflow_activity_in_row_expr(row_name: "wr")),
    ts_if(
      cond: ts_binop(
        left: ts_binop(
          left: ts_binop(
            left: ts_prefix(op: "!", expr: ts_ident(name: "av")),
            op: "||",
            right: ts_binop(
              left: ts_member(object: ts_ident(name: "av"), property: "arm"),
              op: "===",
              right: ts_lit_str(value: "none"))),
          op: "||",
          right: ts_prefix(op: "!", expr: ts_ident(name: "tb"))),
        op: "||",
        right: ts_binop(
          left: ts_ident(name: "wr"),
          op: "&&",
          right: ts_call(
            callee: ts_member(object: ts_ident(name: "wr"), property: "hasAttribute"),
            args: [ts_lit_str(value: "data-summary-only")]))),
      then_stmt: ts_block(stmts: []),
      else_stmt: Present { value: ts_block(stmts: activity_paint_stmts()) }),
  ]
}

fn workflow_fetch_request_statements() -> List<TsStmt> {
  [
    ts_return(expr: ts_call(
      callee: ts_member(
        object: ts_call(
          callee: ts_member(
            object: ts_call(
              callee: ts_member(
                object: ts_call(
                  callee: ts_ident(name: "fetch"),
                  args: [ts_lit_str(value: workflow_route_path)],
                ),
                property: "then",
              ),
              args: [ts_arrow(params: ["r"], body: ts_block(stmts: [
                ts_return(expr: ts_call(
                  callee: ts_member(
                    object: ts_ident(name: "r"),
                    property: "json",
                  ),
                  args: [],
                )),
              ]))],
            ),
            property: "then",
          ),
          args: [ts_arrow(params: ["wj"], body: ts_block(stmts: [
            ts_if(
              cond: ts_member(
                object: ts_ident(name: "wj"),
                property: "observe_refused",
              ),
              then_stmt: ts_block(stmts: concat(
                [
                  ts_const(name: "why", value: ts_binop(
                    left: ts_lit_str(
                      value: "workflow observation refused: ",
                    ),
                    op: "+",
                    right: ts_binop(
                      left: ts_member(
                        object: ts_ident(name: "wj"),
                        property: "reason",
                      ),
                      op: "||",
                      right: ts_lit_str(value: reason_absent_phrase),
                    ),
                  )),
                  workflow_refuse_visible_stmt(),
                ],
                observation_refused_banner_stmts(
                  source_class: "workflow-observe-refused"),
              )),
              else_stmt: Present { value: ts_block(stmts: [
                remove_all_selector_stmt(
                  selector: ".workflow-observe-refused",
                  item_name: "oldWorkflowBanner"),
                ts_expr_stmt(expr: ts_call(callee: ts_ident(name: "gunbcObserveImpactSync"), args: [])),
                workflow_clear_rendered_stmt(),
                ts_expr_stmt(expr: ts_call(
                  callee: ts_member(
                    object: ts_member(
                      object: ts_ident(name: "wj"),
                      property: "attempts",
                    ),
                    property: "forEach",
                  ),
                  args: [ts_arrow(
                    params: ["attempt"],
                    body: ts_block(stmts: workflow_mark_attempt_stmts()),
                  )],
                )),
                workflow_stale_sweep_stmt(),
              ]) },
            ),
          ]))],
        ),
        property: "catch",
      ),
      args: [ts_arrow(params: ["e"], body: ts_block(stmts: concat(
        [
          ts_const(name: "why", value: ts_binop(
            left: ts_lit_str(value: "workflow observation refused: "),
            op: "+",
            right: ts_binop(
              left: ts_ident(name: "e"),
              op: "+",
              right: ts_lit_str(value: ""),
            ),
          )),
          workflow_refuse_visible_stmt(),
        ],
        observation_refused_banner_stmts(
          source_class: "workflow-observe-refused"),
      )))],
    )),
  ]
}

data workflow_observation_poll_interval: Millisecond = millisecond(count: 2000)

fn workflow_schedule_refresh_stmt() -> TsStmt {
  ts_expr_stmt(expr: ts_call(
    callee: ts_ident(name: "setTimeout"),
    args: [
      ts_ident(name: js_poll_workflow_fn),
      ts_lit_num(text: to_string(
        millisecond_count(m: workflow_observation_poll_interval))),
    ],
  ))
}

// gunbcPollWorkflow waits for gunbcRefreshWorkflow's returned fetch promise to settle and schedules
// the next read in finally. The former fire-then-setTimeout shape overlapped every two seconds
// whenever /workflow.json exceeded its cadence; one real oversized Codex event made the interpreted
// handler slow enough to fill the socket backlog. Settlement-driven polling preserves cadence after
// completion and admits at most one workflow observation per browser.

fn workflow_fetch_statements() -> List<TsStmt> {
  [
    ts_const(
      name: js_refresh_workflow_fn,
      value: ts_arrow(
        params: [],
        body: ts_block(stmts: workflow_fetch_request_statements()),
      ),
    ),
    ts_const(
      name: js_poll_workflow_fn,
      value: ts_arrow(params: [], body: ts_block(stmts: [
        ts_expr_stmt(expr: ts_call(
          callee: ts_member(
            object: ts_call(
              callee: ts_ident(name: js_refresh_workflow_fn),
              args: [],
            ),
            property: "finally",
          ),
          args: [
            ts_arrow(
              params: [],
              body: ts_block(stmts: [workflow_schedule_refresh_stmt()]),
            ),
          ],
        )),
      ])),
    ),
    ts_expr_stmt(expr: ts_call(
      callee: ts_ident(name: js_poll_workflow_fn),
      args: [],
    )),
  ]
}

// SELECTION IS CLIENT STATE; PROMINENCE IS ITS PROJECTION (A2 hierarchy closeout, operator gap
// ruling 2026-08-02: only the selected subject normally exposes the primary operation prominently).
// Selecting a row — by clicking its non-interactive surface, by keyboard focus reaching it
// (focus-visible only, so pointer clicks on inner controls never move selection through the focus
// channel), or by Enter/Space on the focused row — selects exactly one row at a time; re-selecting
// the selected row, or pressing Escape, clears; activating any control, link, or disclosure TOGGLE
// acts WITHOUT changing selection, keeping selection and activation distinct operations (the
// exclusion names summary — the disclosure's interactive part — NOT details: every row lives inside
// the section fold's details element, so excluding details ancestors made pointer selection
// unreachable corpus-wide, a defect this note's first revision shipped and the S0 interaction
// capture exposed by execution). Every input path funnels through ONE gunbcSelectRow, so keyboard
// and pointer cannot drift apart. Selection grants action-focal to the row's own primary action
// only (the class named for what it means — selection-granted focal prominence, never liveness; see
// action_prominence_rules_note) — the first .node-head under the row li is its own head in document
// order, so a nested child row's control can never inherit the parent's grant — and the clear pass
// strips every node-selected and action-focal in one sweep, so two focal controls cannot coexist.
// No selection state is persisted: prominence is a session-local reading aid, not a fact about the
// work. DECLARED FOLLOW-UP (S0 handback, operator recalibration 2026-08-02): in the instrument
// composition, secondary override controls LEAVE the resting row entirely — they move into the
// contextual inspector/disclosure and the resting row keeps at most a small affordance; this
// production page keeps them in-row until that composition lands.

data row_selected_class: String = "node-selected"
data action_focal_class: String = "action-focal"

fn row_selection_bind_statements() -> List<TsStmt> {
  [
    ts_const(name: "gunbcClearSelection", value: ts_arrow(params: [], body: ts_expr_stmt(expr: ts_call(
      callee: ts_member(
        object: ts_call(
          callee: ts_member(object: ts_ident(name: "document"), property: "querySelectorAll"),
          args: [ts_lit_str(value: join([".", row_selected_class, ", .", action_focal_class], ""))],
        ),
        property: "forEach",
      ),
      args: [ts_arrow(params: ["n"], body: ts_expr_stmt(expr: ts_call(
        callee: ts_member(object: ts_member(object: ts_ident(name: "n"), property: "classList"), property: "remove"),
        args: [ts_lit_str(value: row_selected_class), ts_lit_str(value: action_focal_class)],
      )))],
    )))),
    ts_const(name: "gunbcSelectRow", value: ts_arrow(params: ["li"], body: ts_block(stmts: [
      ts_if(
        cond: ts_call(
          callee: ts_member(object: ts_member(object: ts_ident(name: "li"), property: "classList"), property: "contains"),
          args: [ts_lit_str(value: row_selected_class)]),
        then_stmt: ts_return(expr: none),
        else_stmt: none,
      ),
      ts_expr_stmt(expr: ts_call(callee: ts_ident(name: "gunbcClearSelection"), args: [])),
      ts_expr_stmt(expr: ts_call(
        callee: ts_member(object: ts_member(object: ts_ident(name: "li"), property: "classList"), property: "add"),
        args: [ts_lit_str(value: row_selected_class)])),
      ts_const(name: "b", value: ts_call(
        callee: ts_member(object: ts_ident(name: "li"), property: "querySelector"),
        args: [ts_lit_str(value: ".taskbar .dispatch-btn.action-primary")])),
      ts_if(
        cond: ts_ident(name: "b"),
        then_stmt: ts_expr_stmt(expr: ts_call(
          callee: ts_member(object: ts_member(object: ts_ident(name: "b"), property: "classList"), property: "add"),
          args: [ts_lit_str(value: action_focal_class)])),
        else_stmt: none,
      ),
    ]))),
    ts_expr_stmt(expr: ts_call(
      callee: ts_member(object: ts_ident(name: "document"), property: "addEventListener"),
      args: [ts_lit_str(value: "click"), ts_arrow(params: ["e"], body: ts_block(stmts: [
        ts_const(name: "t", value: ts_member(object: ts_ident(name: "e"), property: "target")),
        ts_if(
          cond: ts_binop(
            left: ts_prefix(op: "!", expr: ts_ident(name: "t")),
            op: "||",
            right: ts_prefix(op: "!", expr: ts_member(object: ts_ident(name: "t"), property: "closest"))),
          then_stmt: ts_return(expr: none),
          else_stmt: none,
        ),
        ts_if(
          cond: ts_call(
            callee: ts_member(object: ts_ident(name: "t"), property: "closest"),
            args: [ts_lit_str(value: "summary, button, a, input, select, textarea")]),
          then_stmt: ts_return(expr: none),
          else_stmt: none,
        ),
        ts_const(name: "li", value: ts_call(
          callee: ts_member(object: ts_ident(name: "t"), property: "closest"),
          args: [ts_lit_str(value: "li.node")])),
        ts_if(cond: ts_prefix(op: "!", expr: ts_ident(name: "li")), then_stmt: ts_return(expr: none), else_stmt: none),
        ts_const(name: "was", value: ts_call(
          callee: ts_member(object: ts_member(object: ts_ident(name: "li"), property: "classList"), property: "contains"),
          args: [ts_lit_str(value: row_selected_class)])),
        ts_expr_stmt(expr: ts_call(callee: ts_ident(name: "gunbcClearSelection"), args: [])),
        ts_if(cond: ts_ident(name: "was"), then_stmt: ts_return(expr: none), else_stmt: none),
        ts_expr_stmt(expr: ts_call(callee: ts_ident(name: "gunbcSelectRow"), args: [ts_ident(name: "li")])),
      ]))],
    )),
    ts_expr_stmt(expr: ts_call(
      callee: ts_member(object: ts_ident(name: "document"), property: "addEventListener"),
      args: [ts_lit_str(value: "focusin"), ts_arrow(params: ["e"], body: ts_block(stmts: [
        ts_const(name: "t", value: ts_member(object: ts_ident(name: "e"), property: "target")),
        ts_if(
          cond: ts_binop(
            left: ts_binop(
              left: ts_prefix(op: "!", expr: ts_ident(name: "t")),
              op: "||",
              right: ts_prefix(op: "!", expr: ts_member(object: ts_ident(name: "t"), property: "matches"))),
            op: "||",
            right: ts_prefix(op: "!", expr: ts_member(object: ts_ident(name: "t"), property: "closest"))),
          then_stmt: ts_return(expr: none),
          else_stmt: none,
        ),
        ts_if(
          cond: ts_prefix(op: "!", expr: ts_call(
            callee: ts_member(object: ts_ident(name: "t"), property: "matches"),
            args: [ts_lit_str(value: ":focus-visible")])),
          then_stmt: ts_return(expr: none),
          else_stmt: none,
        ),
        ts_const(name: "li", value: ts_call(
          callee: ts_member(object: ts_ident(name: "t"), property: "closest"),
          args: [ts_lit_str(value: "li.node")])),
        ts_if(
          cond: ts_ident(name: "li"),
          then_stmt: ts_expr_stmt(expr: ts_call(callee: ts_ident(name: "gunbcSelectRow"), args: [ts_ident(name: "li")])),
          else_stmt: none,
        ),
      ]))],
    )),
    ts_expr_stmt(expr: ts_call(
      callee: ts_member(object: ts_ident(name: "document"), property: "addEventListener"),
      args: [ts_lit_str(value: "keydown"), ts_arrow(params: ["e"], body: ts_block(stmts: [
        ts_if(
          cond: ts_binop(
            left: ts_member(object: ts_ident(name: "e"), property: "key"),
            op: "===",
            right: ts_lit_str(value: "Escape")),
          then_stmt: ts_expr_stmt(expr: ts_call(callee: ts_ident(name: "gunbcClearSelection"), args: [])),
          else_stmt: none,
        ),
        ts_if(
          cond: ts_binop(
            left: ts_binop(
              left: ts_member(object: ts_ident(name: "e"), property: "key"),
              op: "!==",
              right: ts_lit_str(value: "Enter")),
            op: "&&",
            right: ts_binop(
              left: ts_member(object: ts_ident(name: "e"), property: "key"),
              op: "!==",
              right: ts_lit_str(value: " "))),
          then_stmt: ts_return(expr: none),
          else_stmt: none,
        ),
        ts_const(name: "t", value: ts_member(object: ts_ident(name: "e"), property: "target")),
        ts_if(
          cond: ts_binop(
            left: ts_prefix(op: "!", expr: ts_ident(name: "t")),
            op: "||",
            right: ts_prefix(op: "!", expr: ts_member(object: ts_ident(name: "t"), property: "matches"))),
          then_stmt: ts_return(expr: none),
          else_stmt: none,
        ),
        ts_if(
          cond: ts_prefix(op: "!", expr: ts_call(
            callee: ts_member(object: ts_ident(name: "t"), property: "matches"),
            args: [ts_lit_str(value: "li.node")])),
          then_stmt: ts_return(expr: none),
          else_stmt: none,
        ),
        ts_expr_stmt(expr: ts_call(
          callee: ts_member(object: ts_ident(name: "e"), property: "preventDefault"),
          args: [])),
        ts_const(name: "was", value: ts_call(
          callee: ts_member(object: ts_member(object: ts_ident(name: "t"), property: "classList"), property: "contains"),
          args: [ts_lit_str(value: row_selected_class)])),
        ts_expr_stmt(expr: ts_call(callee: ts_ident(name: "gunbcClearSelection"), args: [])),
        ts_if(cond: ts_ident(name: "was"), then_stmt: ts_return(expr: none), else_stmt: none),
        ts_expr_stmt(expr: ts_call(callee: ts_ident(name: "gunbcSelectRow"), args: [ts_ident(name: "t")])),
      ]))],
    )),
  ]
}

// THE ISSUE TRACKER'S CLIENT BEHAVIORS (owner ruling 2026-09-22; amended 2026-09-25: the VIEW
// chips retired with the tree/bands views, and their view switch retired with them): three
// mechanics over the server's decided DOM, no presentation policy. A BAND chip only writes
// data-band-filter — the stylesheet hides non-matching rows of the one table; the search input
// hides rows by inline display from the row's own data-search (headline · node id · owner,
// decided at serve); a TAB chip on an issue detail only writes the detail root's data-tab — the
// stylesheet decides which panel shows. Filters retain nothing: the table is flat by construction
// and matching is a substring read, never a tree walk.

fn ts_closest(obj: String, selector: String) -> TsExpr {
  ts_call(
    callee: ts_member(object: ts_ident(name: obj), property: "closest"),
    args: [ts_lit_str(value: selector)])
}

fn ts_for_each(selector: String, item: String, body: List<TsStmt>) -> TsStmt {
  ts_expr_stmt(expr: ts_call(
    callee: ts_member(
      object: ts_call(
        callee: ts_member(object: ts_ident(name: "document"), property: "querySelectorAll"),
        args: [ts_lit_str(value: selector)]),
      property: "forEach"),
    args: [ts_arrow(params: [item], body: ts_block(stmts: body))]))
}

fn issue_filter_bind_statements() -> List<TsStmt> {
  [
    ts_const(name: "gunbcFilterEmpty", value: ts_arrow(params: ["root"], body: ts_block(stmts: [ts_if(cond: ts_prefix(op: "!", expr: ts_ident(name: "root")), then_stmt: ts_block(stmts: [ts_return(expr: none)]), else_stmt: none), ts_const(name: "band", value: ts_member(object: ts_member(object: ts_ident(name: "root"), property: "dataset"), property: "bandFilter")), ts_const(name: "visible", value: ts_call(callee: ts_member(object: ts_call(callee: ts_member(object: ts_ident(name: "Array"), property: "from"), args: [ts_call(callee: ts_member(object: ts_ident(name: "root"), property: "querySelectorAll"), args: [ts_lit_str(value: ".view-table li.node")])]), property: "some"), args: [ts_arrow(params: ["row"], body: ts_block(stmts: [ts_return(expr: Present { value: ts_binop(left: ts_binop(left: ts_member(object: ts_member(object: ts_ident(name: "row"), property: "style"), property: "display"), op: "!==", right: ts_lit_str(value: "none")), op: "&&", right: ts_binop(left: ts_prefix(op: "!", expr: ts_ident(name: "band")), op: "||", right: ts_binop(left: ts_member(object: ts_member(object: ts_ident(name: "row"), property: "dataset"), property: "band"), op: "===", right: ts_ident(name: "band")))) })]))])), ts_expr_stmt(expr: ts_binop(left: ts_member(object: ts_member(object: ts_ident(name: "root"), property: "dataset"), property: "empty"), op: "=", right: ts_cond(test: ts_ident(name: "visible"), consequent: ts_lit_str(value: "0"), alternate: ts_lit_str(value: "1"))))]))),
    ts_for_each(selector: "[data-band-chip]", item: "c", body: [
      ts_on_click(obj: "c", body: [
        ts_const(name: "root", value: ts_closest(obj: "c", selector: ".roadmap-frontier")),
        ts_if(cond: ts_binop(left: ts_ident(name: "root"), op: "&&", right: ts_call(callee: ts_member(object: ts_ident(name: "root"), property: "querySelector"), args: [ts_lit_str(value: ".issue-table")])), then_stmt: ts_block(stmts: [ts_return(expr: none)]), else_stmt: none),
        ts_expr_stmt(expr: ts_binop(
          left: ts_ident(name: "root"),
          op: "&&",
          right: ts_binop(
            left: ts_member(
              object: ts_member(object: ts_ident(name: "root"), property: "dataset"),
              property: "bandFilter"),
            op: "=",
            right: ts_cond(
              test: ts_binop(
                left: ts_member(
                  object: ts_member(object: ts_ident(name: "c"), property: "dataset"),
                  property: "bandChip"),
                op: "===",
                right: ts_lit_str(value: "all")),
              consequent: ts_lit_str(value: ""),
              alternate: ts_member(
                object: ts_member(object: ts_ident(name: "c"), property: "dataset"),
                property: "bandChip"))))),
        ts_for_each(selector: "[data-band-chip]", item: "d", body: [
          ts_expr_stmt(expr: ts_call(
            callee: ts_member(
              object: ts_member(object: ts_ident(name: "d"), property: "classList"),
              property: "toggle"),
            args: [
              ts_lit_str(value: "chip-on"),
              ts_binop(
                left: ts_member(
                  object: ts_member(object: ts_ident(name: "d"), property: "dataset"),
                  property: "bandChip"),
                op: "===",
                right: ts_member(
                  object: ts_member(object: ts_ident(name: "c"), property: "dataset"),
                  property: "bandChip")),
            ])),
        ]),
        ts_expr_stmt(expr: ts_call(callee: ts_ident(name: "gunbcFilterEmpty"), args: [ts_ident(name: "root")])),
      ]),
    ]),
    ts_for_each(selector: "input.issue-search", item: "q", body: [
      ts_expr_stmt(expr: ts_call(
        callee: ts_member(object: ts_ident(name: "q"), property: "addEventListener"),
        args: [
          ts_lit_str(value: "input"),
          ts_arrow(params: ["e"], body: ts_block(stmts: [
            ts_const(name: "root", value: ts_closest(obj: "q", selector: ".roadmap-frontier")),
        ts_if(cond: ts_binop(left: ts_ident(name: "root"), op: "&&", right: ts_call(callee: ts_member(object: ts_ident(name: "root"), property: "querySelector"), args: [ts_lit_str(value: ".issue-table")])), then_stmt: ts_block(stmts: [ts_return(expr: none)]), else_stmt: none),
            ts_const(name: "needle", value: ts_call(
              callee: ts_member(
                object: ts_member(
                  object: ts_member(object: ts_ident(name: "e"), property: "target"),
                  property: "value"),
                property: "toLowerCase"),
              args: [])),
            ts_expr_stmt(expr: ts_binop(
              left: ts_ident(name: "root"),
              op: "&&",
              right: ts_call(
                callee: ts_member(
                  object: ts_call(
                    callee: ts_member(object: ts_ident(name: "root"), property: "querySelectorAll"),
                    args: [ts_lit_str(value: ".view-table li.node")]),
                  property: "forEach"),
                args: [ts_arrow(params: ["li"], body: ts_expr_stmt(expr: ts_binop(
                  left: ts_member(
                    object: ts_member(object: ts_ident(name: "li"), property: "style"),
                    property: "display"),
                  op: "=",
                  right: ts_cond(
                    test: ts_call(
                      callee: ts_member(
                        object: ts_call(
                          callee: ts_member(
                            object: ts_member(
                              object: ts_member(object: ts_ident(name: "li"), property: "dataset"),
                              property: "search"),
                            property: "toLowerCase"),
                          args: []),
                        property: "includes"),
                      args: [ts_ident(name: "needle")]),
                    consequent: ts_lit_str(value: ""),
                    alternate: ts_lit_str(value: "none")))))]))),
            ts_expr_stmt(expr: ts_call(callee: ts_ident(name: "gunbcFilterEmpty"), args: [ts_ident(name: "root")])),
          ])),
        ])),
    ]),
    ts_for_each(selector: "[data-tab-chip]", item: "c", body: [
      ts_on_click(obj: "c", body: [
        ts_const(name: "root", value: ts_closest(obj: "c", selector: ".issue-detail")),
        ts_expr_stmt(expr: ts_binop(
          left: ts_ident(name: "root"),
          op: "&&",
          right: ts_binop(
            left: ts_member(
              object: ts_member(object: ts_ident(name: "root"), property: "dataset"),
              property: "tab"),
            op: "=",
            right: ts_member(
              object: ts_member(object: ts_ident(name: "c"), property: "dataset"),
              property: "tabChip")))),
        ts_for_each(selector: "[data-tab-chip]", item: "d", body: [
          ts_expr_stmt(expr: ts_call(
            callee: ts_member(
              object: ts_member(object: ts_ident(name: "d"), property: "classList"),
              property: "toggle"),
            args: [
              ts_lit_str(value: "chip-on"),
              ts_binop(
                left: ts_member(
                  object: ts_member(object: ts_ident(name: "d"), property: "dataset"),
                  property: "tabChip"),
                op: "===",
                right: ts_member(
                  object: ts_member(object: ts_ident(name: "c"), property: "dataset"),
                  property: "tabChip")),
            ])),
        ]),
      ]),
    ]),
  ]
}

// THE ACCOUNT SWAP (owner defect 2026-09-27: the main page body is the belt's pre-rendered
// static body, so the account area can only personalize CLIENT-SIDE): rides THE ONE SESSION
// READ (gunbcSessionRead from gunbc.site.session_client — never a second fetch of
// /auth/session); an authenticated response swaps the hidden session target in — the display
// name and the avatar initials render from the SESSION RESPONSE ALONE (the wire's OPTIONAL
// name member, the verified token's name claim, preferred; the principal label's short form
// when the login projected no name) — anything else (rejected standing, absent flag, read
// failure) leaves Sign in: never an identity claim from a failed fetch, and the empty catch
// swallows the rejection so the static bytes stand. THE PFP rides the wire's OPTIONAL
// picture member (shape
// (a) of the identity doctrine: the verified Google picture URL rendered directly; the
// /avatar/<principal> proxy is the tailnet-privacy follow-up): when present, an <img> layers
// over the initials INSIDE the same chip and the standing flips to data-avatar="resolved" —
// the initials are NEVER removed, so a slow or failed image renders the initials fallback
// under the never-blocks law (alt="" keeps a broken image invisible). There is no Sign in,
// Sign out or account menu to drive: the login/logout routes moved to a follow-up PR (#12787).

fn dispatch_client_program_for(
  selector: String,
  url_expr: TsExpr,
  header: List<String>,
  instance_statements: List<TsStmt>,
) -> TsProgram {
  TsProgram {
    ts_nocheck: false,
    header_lines: header,
    statements: concat(
      [],
      concat(
        dispatch_preamble_statements(),
        concat(
          observe_impact_preamble_statements(),
          concat(
          dispatch_bind_statements(selector: selector, url_expr: url_expr),
          concat(
            issue_action_bind_statements(),
            concat(
            [],
            concat(
              [],
              concat(
                disclosure_bind_statements(),
                concat(
                  swatch_toggle_bind_statements(),
                  concat(
                    observation_fetch_statements(),
                    concat(
                      workflow_fetch_statements(),
                      concat(
                        row_selection_bind_statements(),
                        concat(
                          issue_filter_bind_statements(),
                          concat(
                            [],
                            concat(
                              [],
                              concat(
                                issue_sort_bind_statements(),
                                concat(
                                  inline_assignment_bind_statements(),
                                  instance_statements))))))))))))))))),
  }
}

// THE MODELED ACTION'S URL (owner ruling 2026-09-24): the button's data-action-route decides the
// POST target — "assign" posts the durable-assign route, anything else (the dispatch default)
// posts the dispatch route. One bind, two distinct effects, never one affordance doing both.
fn issue_action_url_expr() -> TsExpr {
  ts_cond(
    test: ts_binop(
      left: ts_call(callee: js_b_member(name: "getAttribute"), args: [ts_lit_str(value: "data-action-route")]),
      op: "===",
      right: ts_lit_str(value: "assign")),
    consequent: ts_binop(
      left: ts_binop(
        left: ts_lit_str(value: "/issue/"),
        op: "+",
        right: ts_call(callee: ts_ident(name: "encodeURIComponent"), args: [ts_call(callee: js_b_member(name: "getAttribute"), args: [ts_lit_str(value: "data-node")])])),
      op: "+",
      right: ts_lit_str(value: "/assign")),
    alternate: dispatch_fetch_url_expr())
}

// THE MODELED ACTION'S CLICK (owner directive 2026-09-24): the product's action POSTs its decided
// route with the same data-node binding, but it does NOT wear the old button's acknowledgement
// captions — the model's label stays. Success re-enables (the row repaints from the next
// observation); failure re-enables and carries the located reason on the title.
fn issue_action_click_handler_body() -> TsStmt {
  ts_block(stmts: [
    ts_expr_stmt(expr: ts_binop(left: js_b_member(name: "disabled"), op: "=", right: ts_ident(name: "true"))),
    ts_expr_stmt(expr: ts_call(
      callee: ts_member(
        object: ts_call(
          callee: ts_member(
            object: ts_call(
              callee: ts_member(
                object: ts_call(
                  callee: ts_ident(name: "fetch"),
                  args: [issue_action_url_expr(), ts_object(fields: [ts_field(key: "method", value: ts_lit_str(value: "POST"))])],
                ),
                property: "then",
              ),
              args: [ts_arrow(params: ["r"], body: ts_expr_stmt(expr: ts_call(callee: ts_member(object: ts_ident(name: "r"), property: "json"), args: [])))],
            ),
            property: "then",
          ),
          args: [ts_arrow(params: ["j"], body: ts_expr_stmt(expr: ts_binop(left: js_b_member(name: "disabled"), op: "=", right: ts_ident(name: "false"))))],
        ),
        property: "catch",
      ),
      args: [ts_arrow(params: ["e"], body: ts_block(stmts: [
        ts_expr_stmt(expr: ts_binop(left: js_b_member(name: "disabled"), op: "=", right: ts_ident(name: "false"))),
        ts_expr_stmt(expr: ts_binop(
          left: js_b_member(name: "title"),
          op: "=",
          right: ts_binop(
            left: ts_lit_str(value: concat(dispatch_unreadable_answer_phrase, ": ")),
            op: "+",
            right: ts_ident(name: "e")))),
      ]))],
    )),
  ])
}

fn issue_action_bind_statements() -> List<TsStmt> {
  [
    ts_expr_stmt(expr: ts_call(
      callee: ts_member(
        object: ts_call(
          callee: ts_member(object: ts_ident(name: "document"), property: "querySelectorAll"),
          args: [ts_lit_str(value: ".issue-action")]),
        property: "forEach"),
      args: [ts_arrow(params: ["b"], body: ts_block(stmts: [
        ts_expr_stmt(expr: ts_call(
          callee: js_b_member(name: "addEventListener"),
          args: [
            ts_lit_str(value: "pointerdown"),
            ts_arrow(params: [], body: ts_expr_stmt(expr: ts_call(callee: ts_ident(name: js_tick_fn), args: []))),
          ],
        )),
        ts_expr_stmt(expr: ts_call(
          callee: js_b_member(name: "addEventListener"),
          args: [ts_lit_str(value: "click"), ts_arrow(params: [], body: issue_action_click_handler_body())],
        )),
      ]))],
    )),
  ]
}

fn dispatch_client_program() -> TsProgram {
  dispatch_client_program_for(
    selector: ".dispatch-btn",
    url_expr: dispatch_fetch_url_expr(),
    header: [
      "gunbc roadmap dispatch button — emitted from gunbc.roadmap_component.dispatch_client_program",
      "POSTs to the dispatch route and reads belt B's status contract (ok set derived from",
      "belt_dispatch_ok_status_labels); served as an external asset, referenced by <script src>",
      "Operation sound: a 5ms detent tick on pointerdown, synthesized through WebAudio from",
      "gunbc.design.sound rows — no audio files, and a persisted mute the instrument obeys",
    ],
    instance_statements: dashboard_instance_fetch_statements(),
  )
}

fn dispatch_client_js_source() -> String {
  serialize_typescript_program(p: dispatch_client_program())
}

data round_strip_playback_ms: Int = 2400

data motion_probe_window_ms: Int = 2000

data js_motion_line_fn: String = "gunbcMotionLine"
data js_motion_devicemotion_probe_fn: String = "gunbcMotionProbeDeviceMotion"
data js_motion_sensor_probe_fn: String = "gunbcMotionProbeSensor"
data js_motion_sensor_refused_var: String = "gunbcMotionSensorRefused"

fn js_motion_assign(target: TsExpr, value: TsExpr) -> TsStmt {
  ts_expr_stmt(expr: ts_binop(left: target, op: "=", right: value))
}

fn js_motion_guard(cond: TsExpr) -> TsStmt {
  ts_if(cond: cond, then_stmt: ts_return(expr: none), else_stmt: none)
}

fn js_motion_cat(parts: List<TsExpr>) -> TsExpr {
  fold(parts, init: ts_lit_str(value: ""), f: (acc, p) => ts_binop(left: acc, op: "+", right: p))
}

fn js_motion_line_call(index: String, text: TsExpr) -> TsStmt {
  ts_expr_stmt(expr: ts_call(
    callee: ts_ident(name: js_motion_line_fn),
    args: [ts_lit_num(text: index), text],
  ))
}

fn js_motion_typeof_undefined(name: String) -> TsExpr {
  ts_binop(
    left: ts_prefix(op: "typeof ", expr: ts_ident(name: name)),
    op: "===",
    right: ts_lit_str(value: "undefined"),
  )
}

fn js_motion_axis_not_null(obj: TsExpr, axis: String) -> TsExpr {
  ts_binop(left: ts_member(object: obj, property: axis), op: "!==", right: ts_ident(name: "null"))
}

fn js_motion_any_axis_valued(obj: TsExpr, x: String, y: String, z: String) -> TsExpr {
  ts_binop(
    left: js_motion_axis_not_null(obj: obj, axis: x),
    op: "||",
    right: ts_binop(
      left: js_motion_axis_not_null(obj: obj, axis: y),
      op: "||",
      right: js_motion_axis_not_null(obj: obj, axis: z),
    ),
  )
}

fn js_motion_count_if(cond: TsExpr, counter: String) -> TsStmt {
  ts_if(
    cond: cond,
    then_stmt: js_motion_assign(
      target: ts_ident(name: counter),
      value: ts_binop(left: ts_ident(name: counter), op: "+", right: ts_lit_num(text: "1")),
    ),
    else_stmt: none,
  )
}

fn js_motion_now() -> TsExpr {
  ts_call(callee: ts_member(object: ts_ident(name: "Date"), property: "now"), args: [])
}

fn js_motion_set_timeout(body: List<TsStmt>) -> TsStmt {
  ts_expr_stmt(expr: ts_call(
    callee: ts_ident(name: "setTimeout"),
    args: [
      ts_arrow(params: [], body: ts_block(stmts: body)),
      ts_lit_num(text: to_string(motion_probe_window_ms)),
    ],
  ))
}

fn motion_devicemotion_listen_statements() -> List<TsStmt> {
  [
    ts_let(name: "events", value: ts_lit_num(text: "0")),
    ts_let(name: "valued", value: ts_lit_num(text: "0")),
    ts_const(name: "t0", value: js_motion_now()),
    ts_const(name: "h", value: ts_arrow(params: ["ev"], body: ts_block(stmts: [
      js_motion_assign(
        target: ts_ident(name: "events"),
        value: ts_binop(left: ts_ident(name: "events"), op: "+", right: ts_lit_num(text: "1")),
      ),
      ts_const(name: "a", value: ts_member(object: ts_ident(name: "ev"), property: device_motion_acceleration_property)),
      js_motion_count_if(
        cond: ts_binop(
          left: ts_ident(name: "a"),
          op: "&&",
          right: js_motion_any_axis_valued(
            obj: ts_ident(name: "a"),
            x: device_motion_axis_x_property,
            y: device_motion_axis_y_property,
            z: device_motion_axis_z_property,
          ),
        ),
        counter: "valued",
      ),
    ]))),
    ts_expr_stmt(expr: ts_call(
      callee: ts_member(object: ts_ident(name: "window"), property: "addEventListener"),
      args: [ts_lit_str(value: devicemotion_event_type), ts_ident(name: "h")],
    )),
    js_motion_line_call(index: "0", text: ts_lit_str(value: join([device_motion_event_interface, " · listening"], ""))),
    js_motion_set_timeout(body: [
      ts_expr_stmt(expr: ts_call(
        callee: ts_member(object: ts_ident(name: "window"), property: "removeEventListener"),
        args: [ts_lit_str(value: devicemotion_event_type), ts_ident(name: "h")],
      )),
      js_motion_line_call(index: "0", text: js_motion_cat(parts: [
        ts_lit_str(value: join([device_motion_event_interface, " · "], "")),
        ts_ident(name: "events"),
        ts_lit_str(value: " events, "),
        ts_ident(name: "valued"),
        ts_lit_str(value: " carrying values, over "),
        ts_binop(left: js_motion_now(), op: "-", right: ts_ident(name: "t0")),
        ts_lit_str(value: "ms"),
      ])),
    ]),
  ]
}

fn motion_devicemotion_probe_statement() -> TsStmt {
  ts_const(
    name: js_motion_devicemotion_probe_fn,
    value: ts_arrow(params: [], body: ts_block(stmts: [
      ts_if(
        cond: js_motion_typeof_undefined(name: device_motion_event_interface),
        then_stmt: ts_block(stmts: [
          js_motion_line_call(
            index: "0",
            text: ts_lit_str(value: join([device_motion_event_interface, " · interface absent in this container"], "")),
          ),
          ts_return(expr: none),
        ]),
        else_stmt: none,
      ),
      ts_const(name: "listen", value: ts_arrow(params: [], body: ts_block(stmts: motion_devicemotion_listen_statements()))),
      ts_if(
        cond: ts_binop(
          left: ts_prefix(
            op: "typeof ",
            expr: ts_member(object: ts_ident(name: device_motion_event_interface), property: "requestPermission"),
          ),
          op: "===",
          right: ts_lit_str(value: "function"),
        ),
        then_stmt: ts_block(stmts: [
          ts_expr_stmt(expr: ts_call(
            callee: ts_member(
              object: ts_call(
                callee: ts_member(
                  object: ts_call(
                    callee: ts_member(
                      object: ts_ident(name: device_motion_event_interface),
                      property: "requestPermission",
                    ),
                    args: [],
                  ),
                  property: "then",
                ),
                args: [ts_arrow(params: ["st"], body: ts_block(stmts: [
                  ts_if(
                    cond: ts_binop(left: ts_ident(name: "st"), op: "===", right: ts_lit_str(value: permission_state_wire(s: PermissionGranted))),
                    then_stmt: ts_block(stmts: [
                      ts_expr_stmt(expr: ts_call(callee: ts_ident(name: "listen"), args: [])),
                      ts_return(expr: none),
                    ]),
                    else_stmt: none,
                  ),
                  js_motion_line_call(index: "0", text: js_motion_cat(parts: [
                    ts_lit_str(value: join([device_motion_event_interface, " · permission "], "")),
                    ts_ident(name: "st"),
                  ])),
                ]))],
              ),
              property: "catch",
            ),
            args: [ts_arrow(params: ["err"], body: ts_block(stmts: [
              js_motion_line_call(index: "0", text: js_motion_cat(parts: [
                ts_lit_str(value: join([device_motion_event_interface, " · permission request refused · "], "")),
                ts_member(object: ts_ident(name: "err"), property: "name"),
              ])),
            ]))],
          )),
          ts_return(expr: none),
        ]),
        else_stmt: none,
      ),
      ts_expr_stmt(expr: ts_call(callee: ts_ident(name: "listen"), args: [])),
    ])),
  )
}

// The Generic Sensor route, kept because it is the only one whose failures are NAMED. Construction
// itself can raise, so it is wrapped: a SecurityError from an insecure context or a blocking
// permissions policy becomes a located line rather than a fault that leaves the previous line
// standing. The refusal flag exists so an error observed during the window is not overwritten by
// the window's own summary — the first thing that actually happened is what the receipt keeps.

fn motion_sensor_probe_statement() -> TsStmt {
  ts_const(
    name: js_motion_sensor_probe_fn,
    value: ts_arrow(params: [], body: ts_block(stmts: [
      ts_if(
        cond: js_motion_typeof_undefined(name: accelerometer_interface_name(i: LinearAccelerationSensor)),
        then_stmt: ts_block(stmts: [
          js_motion_line_call(
            index: "1",
            text: ts_lit_str(value: join([
              accelerometer_interface_name(i: LinearAccelerationSensor),
              " · interface absent in this container",
            ], "")),
          ),
          ts_return(expr: none),
        ]),
        else_stmt: none,
      ),
      js_motion_assign(target: ts_ident(name: js_motion_sensor_refused_var), value: ts_ident(name: "false")),
      ts_try(
        body: ts_block(stmts: [
          ts_let(name: "readings", value: ts_lit_num(text: "0")),
          ts_let(name: "valued", value: ts_lit_num(text: "0")),
          ts_const(
            name: "s",
            value: ts_new(
              callee: ts_ident(name: accelerometer_interface_name(i: LinearAccelerationSensor)),
              args: [ts_object(fields: [ts_field(key: "frequency", value: ts_lit_num(text: "60"))])],
            ),
          ),
          ts_expr_stmt(expr: ts_call(
            callee: ts_member(object: ts_ident(name: "s"), property: "addEventListener"),
            args: [
              ts_lit_str(value: "error"),
              ts_arrow(params: ["ev"], body: ts_block(stmts: [
                js_motion_assign(target: ts_ident(name: js_motion_sensor_refused_var), value: ts_ident(name: "true")),
                js_motion_line_call(index: "1", text: js_motion_cat(parts: [
                  ts_lit_str(value: join([
                    accelerometer_interface_name(i: LinearAccelerationSensor), " · refused · ",
                  ], "")),
                  ts_member(object: ts_member(object: ts_ident(name: "ev"), property: "error"), property: "name"),
                ])),
              ])),
            ],
          )),
          ts_expr_stmt(expr: ts_call(
            callee: ts_member(object: ts_ident(name: "s"), property: "addEventListener"),
            args: [
              ts_lit_str(value: "reading"),
              ts_arrow(params: [], body: ts_block(stmts: [
                js_motion_assign(
                  target: ts_ident(name: "readings"),
                  value: ts_binop(left: ts_ident(name: "readings"), op: "+", right: ts_lit_num(text: "1")),
                ),
                js_motion_count_if(
                  cond: js_motion_any_axis_valued(
                    obj: ts_ident(name: "s"),
                    x: axis_x_property,
                    y: axis_y_property,
                    z: axis_z_property,
                  ),
                  counter: "valued",
                ),
              ])),
            ],
          )),
          ts_const(name: "t0", value: js_motion_now()),
          js_motion_line_call(
            index: "1",
            text: ts_lit_str(value: join([
              accelerometer_interface_name(i: LinearAccelerationSensor), " · ",
              sensor_lifecycle_key(s: SensorActivating),
            ], "")),
          ),
          ts_expr_stmt(expr: ts_call(callee: ts_member(object: ts_ident(name: "s"), property: "start"), args: [])),
          js_motion_set_timeout(body: [
            ts_expr_stmt(expr: ts_call(callee: ts_member(object: ts_ident(name: "s"), property: "stop"), args: [])),
            js_motion_guard(cond: ts_ident(name: js_motion_sensor_refused_var)),
            js_motion_line_call(index: "1", text: js_motion_cat(parts: [
              ts_lit_str(value: join([accelerometer_interface_name(i: LinearAccelerationSensor), " · "], "")),
              ts_ident(name: "readings"),
              ts_lit_str(value: " reading events, "),
              ts_ident(name: "valued"),
              ts_lit_str(value: " carrying values, over "),
              ts_binop(left: js_motion_now(), op: "-", right: ts_ident(name: "t0")),
              ts_lit_str(value: "ms · activated "),
              ts_member(object: ts_ident(name: "s"), property: "activated"),
            ])),
          ]),
        ]),
        catch_param: "err",
        handler: ts_block(stmts: [
          js_motion_assign(target: ts_ident(name: js_motion_sensor_refused_var), value: ts_ident(name: "true")),
          js_motion_line_call(index: "1", text: js_motion_cat(parts: [
            ts_lit_str(value: join([
              accelerometer_interface_name(i: LinearAccelerationSensor), " · construction refused · ",
            ], "")),
            ts_member(object: ts_ident(name: "err"), property: "name"),
          ])),
        ]),
      ),
    ])),
  )
}
