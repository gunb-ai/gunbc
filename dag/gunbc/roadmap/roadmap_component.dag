// The DispatchButton — the first instantiation of the component concept (gunbc.design.component),
// and the second consumer that unlocks the archetype library's component axis. It lives HERE, one
// layer above the register, because it binds the belt wire vocabulary: its terminal states are
// DERIVED from belt_dispatch_all_status_labels (the grounded label set), never a hand enum, so the
// state totality is a projection of the served contract — the exact thing the dispatch-button
// incident needed (the button's states cannot drift from what belt B answers). Role/material
// binding follows the ok/refusal split of the wire authority: an ok terminal (spawned/already_live)
// reads through the figure role (the lit/accent material, the same the progress bar uses); a
// refusal terminal reads through the boundary role (clay — the warning material, never
// brass-as-text). idle reads text, requested reads text-dim (the in-flight hush). P3 renders these
// rows as chips + reserved widths; P4 galleries them; here they are just the modeled rows.

fn dispatch_terminal_role(ok: Bool) -> ThemeRole {
  if ok { FigureRole } else { BoundaryRole }
}

fn dispatch_terminal_state(wire_label: String) -> ComponentState {
  let ok = belt_dispatch_label_is_ok(wire_label: wire_label)
  ComponentState {
    key: wire_label,
    kind: TerminalState { wire_label: wire_label, ok: ok },
    role: dispatch_terminal_role(ok: ok),
  }
}

fn dispatch_button_terminal_states() -> List<ComponentState> {
  map(belt_dispatch_all_status_labels(), l => dispatch_terminal_state(wire_label: l))
}

data dispatch_idle_state: ComponentState = ComponentState {
  key: "idle",
  kind: IdleState,
  role: TextRole,
}

data dispatch_requested_state: ComponentState = ComponentState {
  key: "requested",
  kind: RequestedState,
  role: TextDimRole,
}

fn dispatch_button_component() -> Component {
  Component {
    name: "dispatch-button",
    element: DispatchBtnElement,
    verbs: [Approach, Dispatch],
    base_roles: [TextRole, SurfaceRole, BorderRole, FocusRole],
    states: concat(
      [dispatch_idle_state, dispatch_requested_state],
      dispatch_button_terminal_states(),
    ),
  }
}

fn dispatch_button_wire_total() -> Bool {
  component_wire_total(c: dispatch_button_component(), wire_labels: belt_dispatch_all_status_labels())
}

fn dispatch_button_terminal_count() -> Int {
  count(component_terminal_states(c: dispatch_button_component()))
}

// The dispatch button's reserved width is a PROJECTION of the caption authority, not a hand pixel
// (P3, re-pointed by remodel W1d): min-width is the longest CAPTION the button can wear (band
// phrases + dispatch-receipt and observed-session morphs) plus a fixed gutter. A caption or
// ok-label change moves the reservation by derivation; there is no pixel to re-tune.

fn dispatch_caption_set() -> List<String> {
  concat([
    dispatch_caption_idle,
    dispatch_caption_requested,
    dispatch_caption_fail,
    dispatch_caption_loud,
  ], [
    concat(dispatch_ack_prefix, dispatch_ack_word),
    concat(dispatch_ack_prefix, belt_dispatch_disabled_status_label()),
  ])
}

fn dispatch_reserved_ch() -> Int {
  dispatch_reserved_ch_for(labels: dispatch_caption_set())
}

fn dispatch_reserved_length() -> CssLength {
  css_ch(n: dispatch_reserved_ch())
}

fn dispatch_reserved_width() -> String {
  css_length_wire(l: dispatch_reserved_length())
}

data dispatch_session_chip_note: String = "The POST acknowledgement and the session observation are two different captions because they are two different facts. An ok POST renders `dispatch · accepted`: worktree/process creation returned success, or the idempotent request found the desired dispatch already accepted. Only the independent /sessions.json observation may show the session sentence — and at A2 that sentence is DECIDED by gunbc.roadmap_presentation.session_facts_view and carried on the wire under `facts`; this client paints it verbatim, so no session prose constant lives here anymore (operator blocker 5). The wording claims tmux/process presence only — never provider readiness, execution, or completion. The response's exact spawned/already_live wire label remains in the title channel.

The observe-only posture independently renders `dispatch · disabled`; it is neither an accepted dispatch nor session evidence. All three captions stay inside the reserved width derived from the caption set, so re-observation cannot reflow the row. The session chip remains type-distinct from the node's status chip at the head of the row."

data dispatch_ack_prefix: String = "dispatch · "
data dispatch_ack_word: String = "accepted"

data sessions_route_path: String = "/sessions.json"
data dashboard_instance_route_path: String = "/instance.json"
data dashboard_instance_class: String = "dashboard-instance"
data dashboard_instance_label_class: String = "dashboard-instance-label"

// The page body remains pure and digestable; the running serve entrypoint names its actual
// HostDashboardInstance through /instance.json. The client projects that observation into the
// instance banner. Observe-only is also projected onto every real dispatch control before
// interaction: the control reads `dispatch · disabled`, carries the located posture reason, and is
// physically disabled, while the server independently returns typed HTTP 403 if a stale or scripted
// client still POSTs.

fn dashboard_instance_fetch_statements() -> List<TsStmt> {
  [
    ts_expr_stmt(expr: ts_call(
      callee: ts_member(
        object: ts_call(
          callee: ts_member(
            object: ts_call(
              callee: ts_member(
                object: ts_call(
                  callee: ts_ident(name: "fetch"),
                  args: [ts_lit_str(value: dashboard_instance_route_path)]),
                property: "then"),
              args: [ts_arrow(params: ["r"], body: ts_block(stmts: [
                ts_return(expr: ts_call(
                  callee: ts_member(object: ts_ident(name: "r"), property: "json"),
                  args: [])),
              ]))]),
            property: "then"),
          args: [ts_arrow(params: ["ij"], body: ts_block(stmts: [
            ts_const(name: "il", value: ts_call(
              callee: ts_member(object: ts_ident(name: "document"), property: "querySelector"),
              args: [ts_lit_str(value: join([".", dashboard_instance_label_class], ""))])),
            ts_const(
              name: "instanceId",
              value: ts_binop(
                left: ts_member(object: ts_ident(name: "ij"), property: "instance_id"),
                op: "||",
                right: ts_lit_str(value: "unknown"))),
            ts_const(
              name: "posture",
              value: ts_binop(
                left: ts_member(object: ts_ident(name: "ij"), property: "actuation"),
                op: "||",
                right: ts_lit_str(value: "unknown"))),
            ts_if(
              cond: ts_ident(name: "il"),
              then_stmt: ts_block(stmts: [
                ts_expr_stmt(expr: ts_binop(
                  left: ts_member(object: ts_ident(name: "il"), property: "textContent"),
                  op: "=",
                  right: ts_binop(
                    left: ts_binop(
                      left: ts_binop(
                        left: ts_lit_str(value: "instance · "),
                        op: "+",
                        right: ts_ident(name: "instanceId")),
                      op: "+",
                      right: ts_lit_str(value: " · ")),
                    op: "+",
                    right: ts_ident(name: "posture")))),
                ts_expr_stmt(expr: ts_binop(
                  left: ts_member(object: ts_ident(name: "il"), property: "title"),
                  op: "=",
                  right: ts_binop(
                    left: ts_binop(
                      left: ts_binop(
                        left: ts_lit_str(value: "host "),
                        op: "+",
                        right: ts_binop(
                          left: ts_member(object: ts_ident(name: "ij"), property: "host_identity"),
                          op: "||",
                          right: ts_lit_str(value: "unknown"))),
                      op: "+",
                      right: ts_lit_str(value: " · repo ")),
                    op: "+",
                    right: ts_binop(
                      left: ts_member(object: ts_ident(name: "ij"), property: "repo_root"),
                      op: "||",
                      right: ts_lit_str(value: "unknown"))))),
              ]),
              else_stmt: none),
            ts_if(
              cond: ts_binop(
                left: ts_ident(name: "posture"),
                op: "===",
                right: ts_lit_str(value: "observe-only")),
              then_stmt: ts_block(stmts: [
                ts_expr_stmt(expr: ts_call(
                  callee: ts_member(
                    object: ts_call(
                      callee: ts_member(
                        object: ts_ident(name: "document"),
                        property: "querySelectorAll"),
                      args: [ts_lit_str(value: ".dispatch-btn, .issue-action")]),
                    property: "forEach"),
                  args: [ts_arrow(params: ["db"], body: ts_block(stmts: [
                    ts_expr_stmt(expr: ts_binop(
                      left: ts_member(object: ts_ident(name: "db"), property: "disabled"),
                      op: "=",
                      right: ts_ident(name: "true"))),
                    ts_expr_stmt(expr: ts_binop(
                      left: ts_member(object: ts_ident(name: "db"), property: "textContent"),
                      op: "=",
                      right: ts_lit_str(value: join([
                        dispatch_ack_prefix,
                        belt_dispatch_disabled_status_label(),
                      ], "")))),
                    ts_expr_stmt(expr: ts_binop(
                      left: ts_member(object: ts_ident(name: "db"), property: "title"),
                      op: "=",
                      right: ts_lit_str(value: "dispatch disabled by instance posture: observe-only"))),
                    ts_expr_stmt(expr: ts_call(
                      callee: ts_member(
                        object: ts_member(object: ts_ident(name: "db"), property: "classList"),
                        property: "add"),
                      args: [ts_lit_str(value: dispatch_class_refused)])),
                  ]))])),
              ]),
              else_stmt: none),
          ]))]),
        property: "catch"),
      args: [ts_arrow(params: ["e"], body: ts_block(stmts: [
        ts_const(name: "il", value: ts_call(
          callee: ts_member(object: ts_ident(name: "document"), property: "querySelector"),
          args: [ts_lit_str(value: join([".", dashboard_instance_label_class], ""))])),
        ts_if(
          cond: ts_ident(name: "il"),
          then_stmt: ts_block(stmts: [
            ts_expr_stmt(expr: ts_binop(
              left: ts_member(object: ts_ident(name: "il"), property: "textContent"),
              op: "=",
              right: ts_lit_str(value: "instance · observation refused"))),
            ts_expr_stmt(expr: ts_binop(
              left: ts_member(object: ts_ident(name: "il"), property: "title"),
              op: "=",
              right: ts_binop(
                left: ts_ident(name: "e"),
                op: "+",
                right: ts_lit_str(value: "")))),
          ]),
          else_stmt: none),
      ]))])),
  ]
}

