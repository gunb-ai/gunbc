    alternate: ts_cond(
      test: ts_binop(
        left: ts_member(object: ts_ident(name: "av"), property: "arm"),
        op: "===",
        right: ts_lit_str(value: "unobservable")),
      consequent: ts_binop(
        left: ts_lit_str(value: "workflow evidence unobservable — "),
        op: "+",
        right: ts_member(object: ts_ident(name: "av"), property: "reason")),
      alternate: ts_member(object: ts_ident(name: "av"), property: "summary")))
}

