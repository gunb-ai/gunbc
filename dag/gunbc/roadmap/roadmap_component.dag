// The hero activity face (operator request 2026-09-21): the stage strip is the attempt row's
// prominent progress bar — one segment per workflow obligation, class stage-<state key> decided by
// the wire's own state field (no client-side derivation), stage-live marking the pulsing active
// segment. The throughput line rides the face beside the one-line state. Semantic activity-line
// coloring (gunbc.roadmap_presentation's ActivityLineClass) composes as activity-line-<key> from
// this prefix plus the decided key — one string authority for server markup, the emitted client,
// and the stylesheet.
data stage_strip_class: String = "stage-strip"
data stage_segment_class: String = "stage-segment"
data stage_live_class: String = "stage-live"
data activity_throughput_class: String = "activity-throughput"
data activity_line_prefix_class: String = "activity-line-"

// The stale-attempt dim (operator ruling 2026-09-20): a row whose attempt was launched against a
// revision that is no longer the deployed tree's head carries this class on its li (set by the
// server render from the revision comparison in gunbc.roadmap_presentation.stale_attempt_nodes)
// plus data-attempt-revision="stale" as the machine-readable fact. The stylesheet dims the row's
// activity region; the client poll never mints or clears the class because the wire carries no
// revision fact — the next tick's server render re-decides it from the same comparison.
data node_attempt_stale_class: String = "node-attempt-stale"

// The client realization of the archetype's UnderHead ActivityRegion (A2 —
// roadmap_row_archetype_note records the falsifier that forced it; the lamp strip, seven
// pre-rendered stage chips, and 'waiting' text it replaces are deleted, not hidden). The container
// exists ONLY while the decided /workflow.json activity view says an attempt exists — the attention
// rule's 'no attempt, no furniture' is realized as DOM absence, not display:none. All content is
// painted VERBATIM from the decided view (gunbc.roadmap_presentation, single projection authority):
// activity.summary/outcome/reason are final strings, data-arm and data-attention are the decided
// keys the stylesheet materializes, the hero stage strip paints one segment per wire segment with
// the wire's own decided state key as its class, the summary carries the decided summary_class,
// the throughput line paints the wire's throughput cell text, the obligation ledger renders the
// wire's canonical segment rows, and evidence rows are label/value pairs. The client holds NO
// composition policy — a summary sentence assembled in TypeScript is the two-authorities defect
// this region dissolved. The
// disclosure no longer auto-opens on a refused arm (the 2026-09-20 status-surface ruling: the
// refusal's loudness lives in the decided LABEL, its payload behind the disclosure, so a board of
// refusals is a board of one-line labels); the former auto-open-once-per-anomaly-transition
// (data-auto-opened guard) is deleted in both realizations, and a poll tick never fights the
// operator's hands because it never opens anything. Session-observation facts (/sessions.json, the
// independent presence source) render into the row disclosure's session-facts line, never into the
// actuator cell and never onto the dispatch button — the button is an action, not a status report.

data workflow_progress_note: String = "The eight-obligation attempt pipeline is presentation over /workflow.json evidence, not a stored stage machine. Environment and Worktree are constructive receipts; Agent comes from provider events reconciled with the shared worker-process evidence; Verify, Publish, Review, and Audit remain pending until their own producers exist. The server decides the presentation (the 'activity' member on each wire attempt, derived by gunbc.roadmap_presentation from roadmap_attempt_workflow_segment_kinds and the reconcile report); the client paints it into the UnderHead activity region without policy. A provider turn completing cannot move downstream obligations. Workflow observation is single-flight: the next timer is armed only in the settled promise's finally arm, so a slow/refused route cannot accumulate overlapping requests against the interpreted single-threaded server."

// The session route observes tmux container presence independently from pane/process lifecycle. Its
// decided sentence says `present`, never `live` or `executing` (the wording now lives in
// gunbc.roadmap_presentation.session_facts_view, which composes it from the shared worker-process
// evidence).

data dispatch_class_requested: String = "dispatch-requested"
data dispatch_class_ok: String = "dispatch-ok"
data dispatch_class_refused: String = "dispatch-refused"
data dispatch_class_loud: String = "dispatch-loud"

data roadmap_row_archetype_note: String = "The RoadmapRow archetype (composition slice 2; ActivityRegion added at A2 after the live-session falsifier, operator 2026-08-01 — docs/plans/roadmap-presentation-seam-design.md section 1). The prior revision of this note declared the fusion the falsifier refuted: it packed the workflow strip, dynamic process evidence, AND the cleanup action into the one actuator wrapper 'to preserve the derived auto 1fr auto grid' — evidence about an action and the action itself sharing one region because the layout had one cell left. Under the first realistic live state the intrinsic-width actuator track starved the 1fr title on WIDE screens (the stacked realization fires only below the compact breakpoint, so the pathology never reached it). The correction is regional, not spatial: ActivityRegion — what is happening to this work — is its own region placed UnderHead, where width is not contested with the title; ActuatorRegion shrinks back to ACTIONS only (dispatch, stop); evidence rows render inside the activity region's disclosure, never as head-track furniture. The head grid stays the derived auto 1fr auto with a small third track. The activity content itself is the decided ActivityView from gunbc.roadmap_presentation (single projection authority across server and client); the attention rule governs its rendering — no attempt means NO activity DOM at all. The title owns the flex track; meta FLOWS inside it; disclosure sits under the head. Density rides roadmap_row_height and roadmap_row_gutter. The full-size instrument specimen remains outside .node-head in the sandbox. RETIRED 2026-09-21: the owner-endorsed title-in-bar redesign dissolved the three-track head grid — the taskbar face is one flex row, the regions vocabulary and its grid derivations are deleted with it (the falsifier history above kept as the record of WHY the grid existed)."

// Two gutters, two jobs (operator-signed 2026-07-25, the third PROVISIONAL flip): the first cut ran
// ONE space-4 token as both the grid's column rhythm and the mid cell's badge-flow rhythm, and the
// operator's tune split them — column gaps (chip | title | actuator) breathe at space-8 while the
// badge flow inside the title cell keeps space-4. They are separate density decisions that happened
// to share a number for one commit; a later retune of either moves alone.

data roadmap_row_height: ScaleToken = height_row
data roadmap_row_gutter: ScaleToken = space_4

// The operator-facing captions (remodel W1d, operator ruling 2026-07-24; lifecycle correction
// 2026-07-27): ok keeps the exact belt status under the dispatch-receipt prefix, while fail and
// loud collapse to one operator phrase each with the wire label and located fields in the
// title/detail channel. A separate sessions observation may replace the receipt with `session ·
// present`; neither caption claims provider execution. BandInProgress renders the requested
// caption. These rows are the caption authority for the client program, gallery, and reserved
// width.

data dispatch_caption_idle: String = "dispatch"
data dispatch_caption_requested: String = "dispatching..."
data dispatch_caption_fail: String = "not dispatchable"
data dispatch_caption_loud: String = "belt fault"

// The day/night control (operator 2026-07-24, remodel W1g): a property of the whole surface like
// the mute, cycling auto -> day -> night. auto removes data-theme so the prefers-color-scheme
// projection governs; a named choice pins data-theme to the Theme's OWN name (derived from
// day_theme/night_theme, never a re-typed string), which the theme_root_css selector grammar
// already answers. Persisted in this browser's storage for the same reason the mute is: the
// preference belongs to these eyes.

// The brief disclosure enters the register (remodel W1e, operator 2026-07-24: the UA triangle read
// as debug chrome — a ticket affordance, not a tree-widget default). The MARK is a real span inside
// the summary, never a UA marker or a pseudo-element: the client program mirrors the details
// element's open state onto the mark as a state class (the browser owns [open]; the state class
// belongs to the client program — the same split the dispatch button's OnStateClass note
// establishes), so the register's existing trigger + detent machinery drives the turn with no new
// trigger vocabulary and no descendant selector. The open detent is the first consumer of the
// detent model's rotation axis (turn_deg).

data disclosure_mark_class: String = "disclosure-mark"
data disclosure_open_class: String = "disclosure-open"
data disclosure_mark_glyph: String = "›"

// The toggle paints itself from the same predicate the tick reads, then repaints after each flip,
// so the label is a projection of the stored state rather than a second copy of it — a toggle whose
// label and behaviour can disagree is worse than no toggle. paint() runs once at bind time because
// the stored preference outlives the page: on load the label must already say what this browser
// will actually do.

// The single authority for a state's CSS modifier class, consumed by the client script (which flips
// classes on the live button), the stylesheet (which paints each class through the state's role
// material), and the P4 gallery (which renders each state statically) — three consumers, one class
// vocabulary, so the live button and the gallery cannot disagree. idle is the base (no modifier);
// the terminals collapse to their ok/refusal MATERIAL group (figure vs boundary), the per-label
// distinction living in the text, not the color.

data roadmap_dispatch_asset_path: String = "/assets/roadmap-dispatch.js"

fn js_b_member(name: String) -> TsExpr {
  ts_member(object: ts_ident(name: "b"), property: name)
}

fn js_j_status() -> TsExpr {
  ts_member(object: ts_ident(name: "j"), property: "status")
}

fn js_j_member(name: String) -> TsExpr {
  ts_member(object: ts_ident(name: "j"), property: name)
}

fn js_classlist_call(method: String, arg: TsExpr) -> TsStmt {
  ts_expr_stmt(expr: ts_call(
    callee: ts_member(object: ts_member(object: ts_ident(name: "b"), property: "classList"), property: method),
    args: [arg],
  ))
}

fn dispatch_ok_status_comparison(wire_label: String) -> TsExpr {
  ts_binop(left: js_j_status(), op: "===", right: ts_lit_str(value: wire_label))
}

fn dispatch_or_chain(exprs: List<TsExpr>) -> TsExpr {
  let acc = fold(exprs, init: none, f: (a, c) => match a {
    Absent => Present { value: c }
    Present { value: prev } => Present { value: ts_binop(left: prev, op: "||", right: c) }
  })
  match acc {
    Present { value: e } => e
    Absent => ts_ident(name: "false")
  }
}

fn dispatch_ok_predicate_expr() -> TsExpr {
  dispatch_or_chain(exprs: map(belt_dispatch_ok_status_labels(), l => dispatch_ok_status_comparison(wire_label: l)))
}

fn dispatch_fetch_url_expr() -> TsExpr {
  ts_binop(
    left: ts_lit_str(value: belt_dispatch_path_prefix),
    op: "+",
    right: ts_call(
      callee: ts_ident(name: "encodeURIComponent"),
      args: [ts_call(callee: js_b_member(name: "getAttribute"), args: [ts_lit_str(value: "data-node")])],
    ),
  )
}

// The presented-state choreography (remodel W1d, operator ruling 2026-07-24: transitions are sugar
// over the data layer). The DATA layer applies the wire answer the moment it arrives —
// b.dataset.status lands immediately, nothing about the operation waits. The PRESENTATION holds the
// requested phase for at least the read dwell (dispatch_requested_read_dwell_ms — a reading
// duration with its own authority row, never a borrowed transition clock) and then applies the
// terminal render: setTimeout(apply, max(0, t0 + dwell - now)), so a 1 ms echo appears as a
// deliberate act and a 30 s belt answer appears the moment it lands. Presentation never fabricates
// a state that did not occur — apply renders exactly the answer stored on the data layer, later,
// never a different one. The terminal caption is the BAND's phrase (dispatch_caption_note); the
// wire label and located fields live in the title channel; the loud band additionally marks
// dispatch_class_loud so the stylesheet and any detail affordance can key on it.

// The requested phase's minimum presentation is a READING duration, not a transition clock
// (operator ruling 2026-07-24: 160 ms — the first cut borrowed reveal_deliberate — was too short to
// actually read 'dispatching...'; a dwell exists so the caption is USEFUL, so it is priced in
// reading time). It is deliberately its own authority row rather than a retune of a shared
// TimingToken: the hover reveal and this hold are different concepts that happened to share a
// number for one commit, and retuning the shared token would have made every hover a half-second.
// Operator-tuned twice: 500 ms first (readable), then 300 ms (2026-07-24 — readable AND quick). The
// deeper direction is filed as the motion-modeling follow-up: a single long hold is the wrong shape
// — the requested phase wants MOVING PARTS (the Discord-mute reference: the state lands fast, the
// motion continues to hold attention), i.e. phase-structured choreography rows, not one dwell
// scalar. This row survives until that session replaces it.

data dispatch_requested_read_dwell_ms: Milliseconds = 300

data js_dwell_const: String = "gunbcDwellMs"
data js_refresh_workflow_fn: String = "gunbcRefreshWorkflow"
data js_poll_workflow_fn: String = "gunbcPollWorkflow"
data js_row_disclosure_fn: String = "gunbcRowDisclosure"
data js_reason_surface_fn: String = "gunbcReasonSurface"

// THE REASON SURFACE IS ONE MECHANISM WITH SEVERAL PRODUCERS, and it became one on an incident
// (2026-07-30). Composition slice 4 established the rule — anomaly evidence is a SURFACE, not a
// tooltip — and realized it once, inline, for the dispatch answer. Since then the row grew two more
// refusal producers: the eight-obligation workflow strip, whose failed and refused segments carry a
// located detail from /workflow.json, and the click's own catch arm. NEITHER reached a surface. The
// workflow segment's detail went to stage.title and the catch arm's went to b.title, which is
// exactly the title-only world anomaly_evidence_witness_test plants as its RED — the corpus stated
// the rule, enforced it against one subject, and then wrote two more subjects that fail it.\n\nThat
// is why this is a helper rather than a second copy: the defect was not that the workflow strip
// forgot to render a reason, it was that 'render a located reason where the operator can read it'
// had one realization welded to one caller, so the second and third callers could not reuse it and
// did the cheap thing instead. Adding a parallel insertion for the strip would have made three
// spellings of one concept and guaranteed a fourth.\n\nEach producer owns its own line, keyed by
// data-reason-source, because a row can be simultaneously refused at dispatch and refused at Verify
// and those are different facts with different remedies — one shared element would let whichever
// wrote last silently erase the other. Passing empty text REMOVES that producer's line, so a
// resolved refusal stops claiming the row is unwell; it does not touch any other
// producer's.\n\nWhat this deliberately does NOT do is auto-expand the row when a workflow segment
// refuses. The dispatch band expands because a click is a discrete operator act with an answer owed
// to it; the workflow strip re-renders on a two-second poll, and opening a disclosure on a timer
// would fight the operator's own hands every tick. The chip already carries `Verify · refused` in
// its own text; the disclosure carries why.

fn row_disclosure_helper_stmt() -> TsStmt {
  ts_const(name: js_row_disclosure_fn, value: ts_arrow(params: ["el"], body: ts_block(stmts: [
    ts_const(name: "r", value: ts_binop(
      left: ts_ident(name: "el"),
      op: "&&",
      right: ts_call(
        callee: ts_member(object: ts_ident(name: "el"), property: "closest"),
        args: [ts_lit_str(value: "li")]),
    )),
    ts_return(expr: ts_binop(
      left: ts_ident(name: "r"),
      op: "&&",
      right: ts_call(
        callee: ts_member(object: ts_ident(name: "r"), property: "querySelector"),
        args: [ts_lit_str(value: "details.taskbar-inspect")]),
    )),
  ])))
}

fn reason_surface_helper_stmt() -> TsStmt {
  ts_const(name: js_reason_surface_fn, value: ts_arrow(params: ["dt", "source", "text"], body: ts_block(stmts: [
    ts_if(
      cond: ts_prefix(op: "!", expr: ts_ident(name: "dt")),
      then_stmt: ts_block(stmts: [ts_return(expr: none)]),
      else_stmt: none,
    ),
    ts_let(name: "rl", value: ts_call(
      callee: ts_member(object: ts_ident(name: "dt"), property: "querySelector"),
      args: [ts_binop(
        left: ts_binop(
          left: ts_lit_str(value: ".disclosure-reason[data-reason-source=\""),
          op: "+",
          right: ts_ident(name: "source")),
        op: "+",
        right: ts_lit_str(value: "\"]"))],
    )),
    ts_if(
      cond: ts_prefix(op: "!", expr: ts_ident(name: "text")),
      then_stmt: ts_block(stmts: [
        ts_expr_stmt(expr: ts_binop(
          left: ts_ident(name: "rl"),
          op: "&&",
          right: ts_call(callee: ts_member(object: ts_ident(name: "rl"), property: "remove"), args: []))),
        ts_return(expr: none),
      ]),
      else_stmt: none,
    ),
    ts_if(
      cond: ts_prefix(op: "!", expr: ts_ident(name: "rl")),
      then_stmt: ts_block(stmts: [
        ts_expr_stmt(expr: ts_binop(
          left: ts_ident(name: "rl"),
          op: "=",
          right: ts_call(
            callee: ts_member(object: ts_ident(name: "document"), property: "createElement"),
            args: [ts_lit_str(value: "div")]))),
        ts_expr_stmt(expr: ts_binop(
          left: ts_member(object: ts_ident(name: "rl"), property: "className"),
          op: "=",
          right: ts_lit_str(value: "disclosure-reason"))),
        ts_expr_stmt(expr: ts_call(
          callee: ts_member(object: ts_ident(name: "rl"), property: "setAttribute"),
          args: [ts_lit_str(value: "data-reason-source"), ts_ident(name: "source")])),
        ts_const(name: "sm", value: ts_call(
          callee: ts_member(object: ts_ident(name: "dt"), property: "querySelector"),
          args: [ts_lit_str(value: "summary")])),
        ts_expr_stmt(expr: ts_binop(
          left: ts_ident(name: "sm"),
          op: "&&",
          right: ts_call(
            callee: ts_member(object: ts_ident(name: "sm"), property: "insertAdjacentElement"),
            args: [ts_lit_str(value: "afterend"), ts_ident(name: "rl")]))),
      ]),
      else_stmt: none,
    ),
    ts_expr_stmt(expr: ts_binop(
      left: ts_member(object: ts_ident(name: "rl"), property: "textContent"),
      op: "=",
      right: ts_ident(name: "text"))),
  ])))
}

data reason_source_dispatch: String = "dispatch"
data reason_source_workflow_prefix: String = "workflow:"
data reason_source_cleanup: String = "cleanup"

// The sources naming each producer's own line. They are row-scoped: every one of them is a verdict
// about THIS work item, so the row's disclosure is where it belongs. Two refusal surfaces
// deliberately do NOT use this mechanism and it is worth saying why, so a later reader does not
// 'finish the job' by moving them here. The sessions, attempts, and workflow OBSERVATION refusals
// are page-scoped — the route itself is unreachable, which is a fact about the dashboard rather
// than about any one row — and they already render as a persistent .observe-refused banner above
// main, which is the same rule realized at the page grain. The instance label is the one genuine
// remainder: it renders `instance · observation refused` with the thrown cause in its title alone,
// and it is page-scoped, so closing it means routing it into the banner family rather than into
// this one.

data reason_absent_phrase: String = "no located reason on the wire"

// THE CATCH ARM USED TO NAME A CAUSE IT HAD NOT OBSERVED. It set the title to the literal `network
// error`, but this arm catches every rejection of the fetch chain — a genuine transport failure AND
// a response whose body would not parse, which is what an HTTP 500 from the dispatch route looks
// like from here (r.json() rejects on the error page). The live specimen (2026-07-30): the served
// graph called an unregistered primitive, the route answered 500, and the button read `belt fault`
// with a tooltip claiming the network had failed. Nothing had failed on the network; the operator
// was handed a fabricated diagnosis of a real defect, which is a §5 wrong answer rather than a
// missing one.\n\nThe phrase below is true of BOTH producers — a transport failure means no answer
// arrived, an unparseable body means the answer cannot be read, and neither is claimed to be the
// other — and the thrown value is appended rather than discarded, so the actual cause (a TypeError
// from fetch, a SyntaxError naming the offending token) reaches the operator instead of being
// replaced by a guess. The status code itself is still lost, because the chain reads r.json()
// without keeping r; recovering it means restructuring the chain and is not bundled here.

data dispatch_unreadable_answer_phrase: String = "no readable answer from the dispatch route"

fn dispatch_preamble_statements() -> List<TsStmt> {
  [
    ts_const(name: js_dwell_const, value: ts_lit_num(text: to_string(dispatch_requested_read_dwell_ms))),
    row_disclosure_helper_stmt(),
    reason_surface_helper_stmt(),
    inspect_ensure_helper_stmt(),
  ]
}

fn dwell_remaining_expr() -> TsExpr {
  ts_call(
    callee: ts_member(object: ts_ident(name: "Math"), property: "max"),
    args: [
      ts_lit_num(text: "0"),
      ts_binop(
        left: ts_binop(left: ts_ident(name: "t0"), op: "+", right: ts_ident(name: js_dwell_const)),
        op: "-",
        right: ts_call(callee: ts_member(object: ts_ident(name: "Date"), property: "now"), args: []),
      ),
    ],
  )
}

fn dispatch_band_chain_expr() -> TsExpr {
  fold(belt_dispatch_label_band_rows(), init: ts_lit_str(value: "loud"), f: (acc, row) =>
    ts_cond(
      test: ts_binop(left: ts_ident(name: "s"), op: "===", right: ts_lit_str(value: row.wire_label)),
      consequent: ts_lit_str(value: row.band_key),
      alternate: acc,
    ))
}

// The client grain of the attention law (composition slice 3): which terminal bands auto-expand the
// row's disclosure is DERIVED — the distinct band keys of the wire-band rows filtered through
// gunbc.roadmap_altitude.band_expands (anomaly expands; routine and working never do) — so the
// emitted predicate `(band === "fail") || (band === "loud")` moves when either authority moves and
// no band name is hand-chosen at the emit site. The fold seeds `false`, which serializes as a
// visible leading arm rather than a fabricated default.

fn key_present(keys: List<String>, key: String) -> Bool {
  fold(keys, init: false, f: (acc, k) => acc || k == key)
}

fn dispatch_expand_band_keys() -> List<String> {
  fold(belt_dispatch_label_band_rows(), init: [], f: (acc, row) =>
    if band_expands(band_key: row.band_key) && !key_present(keys: acc, key: row.band_key) {
      concat(acc, [row.band_key])
    } else {
      acc
    })
}

fn dispatch_expand_chain_expr() -> TsExpr {
  fold(dispatch_expand_band_keys(), init: ts_ident(name: "false"), f: (acc, k) =>
    ts_binop(
      left: acc,
      op: "||",
      right: ts_binop(left: ts_ident(name: "band"), op: "===", right: ts_lit_str(value: k))))
}

fn dispatch_terminal_apply_body() -> TsStmt {
  ts_block(stmts: [
    ts_const(name: "s", value: ts_binop(left: js_j_status(), op: "||", right: ts_lit_str(value: ""))),
    ts_const(name: "band", value: dispatch_band_chain_expr()),
    ts_const(name: "ok", value: ts_binop(left: ts_ident(name: "band"), op: "===", right: ts_lit_str(value: "ok"))),
    ts_expr_stmt(expr: ts_binop(
      left: js_b_member(name: "textContent"),
      op: "=",
      right: ts_cond(
        test: ts_ident(name: "ok"),
        consequent: ts_lit_str(value: concat(dispatch_ack_prefix, dispatch_ack_word)),
        alternate: ts_cond(
          test: ts_binop(
            left: ts_ident(name: "s"),
            op: "===",
            right: ts_lit_str(value: belt_dispatch_disabled_status_label())),
          consequent: ts_binop(
            left: ts_lit_str(value: dispatch_ack_prefix),
            op: "+",
            right: ts_ident(name: "s")),
          alternate: ts_cond(
            test: ts_binop(
              left: ts_ident(name: "band"),
              op: "===",
              right: ts_lit_str(value: "fail")),
            consequent: ts_lit_str(value: dispatch_caption_fail),
            alternate: ts_lit_str(value: dispatch_caption_loud)),
        ),
      ),
    )),
    js_classlist_call(method: "remove", arg: ts_lit_str(value: dispatch_class_requested)),
    js_classlist_call(method: "remove", arg: ts_lit_str(value: dispatch_class_ok)),
    js_classlist_call(method: "remove", arg: ts_lit_str(value: dispatch_class_refused)),
    js_classlist_call(method: "remove", arg: ts_lit_str(value: dispatch_class_loud)),
    js_classlist_call(method: "add", arg: ts_cond(
      test: ts_ident(name: "ok"),
      consequent: ts_lit_str(value: dispatch_class_ok),
      alternate: ts_lit_str(value: dispatch_class_refused),
    )),
    ts_if(
      cond: ts_binop(left: ts_ident(name: "band"), op: "===", right: ts_lit_str(value: "loud")),
      then_stmt: ts_block(stmts: [
        js_classlist_call(method: "add", arg: ts_lit_str(value: dispatch_class_loud)),
      ]),
      else_stmt: none,
    ),
    ts_const(name: "d", value: ts_binop(left: js_j_member(name: "detail"), op: "||", right: ts_lit_str(value: ""))),
    ts_const(name: "why", value: ts_cond(
      test: js_j_member(name: "step"),
      consequent: ts_binop(
        left: ts_binop(left: js_j_member(name: "step"), op: "+", right: ts_lit_str(value: ": ")),
        op: "+",
        right: ts_ident(name: "d"),
      ),
      alternate: ts_binop(left: js_j_member(name: "reason"), op: "||", right: ts_lit_str(value: "")),
    )),
    ts_const(name: "base", value: ts_cond(
      test: ts_ident(name: "p"),
      consequent: ts_binop(
        left: ts_binop(left: ts_ident(name: "s"), op: "+", right: ts_lit_str(value: " · ")),
        op: "+",
        right: ts_ident(name: "p")),
      alternate: ts_binop(left: ts_ident(name: "s"), op: "||", right: ts_lit_str(value: "no status")))),
    ts_expr_stmt(expr: ts_binop(
      left: js_b_member(name: "title"),
      op: "=",
      right: ts_cond(
        test: ts_ident(name: "why"),
        consequent: ts_binop(
          left: ts_binop(left: ts_ident(name: "base"), op: "+", right: ts_lit_str(value: " — ")),
          op: "+",
          right: ts_ident(name: "why"),
        ),
        alternate: ts_ident(name: "base"),
      ),
    )),
    ts_const(name: "expandRow", value: dispatch_expand_chain_expr()),
    ts_const(name: "dt", value: ts_call(
      callee: ts_ident(name: js_row_disclosure_fn),
      args: [ts_ident(name: "b")])),
    ts_if(
      cond: ts_binop(left: ts_ident(name: "expandRow"), op: "&&", right: ts_ident(name: "dt")),
      then_stmt: ts_block(stmts: [
        ts_expr_stmt(expr: ts_binop(
          left: ts_member(object: ts_ident(name: "dt"), property: "open"),
          op: "=",
          right: ts_ident(name: "true"))),
      ]),
      else_stmt: none,
    ),
    ts_expr_stmt(expr: ts_call(
      callee: ts_ident(name: js_reason_surface_fn),
      args: [
        ts_ident(name: "dt"),
        ts_lit_str(value: reason_source_dispatch),
        ts_cond(
          test: ts_binop(left: ts_ident(name: "band"), op: "===", right: ts_lit_str(value: "loud")),
          consequent: ts_binop(
            left: ts_ident(name: "why"),
            op: "||",
            right: ts_lit_str(value: concat(dispatch_caption_loud, concat(" — ", reason_absent_phrase)))),
          alternate: ts_lit_str(value: "")),
      ])),
    ts_if(
      cond: ts_prefix(op: "!", expr: ts_ident(name: "ok")),
      then_stmt: ts_block(stmts: [
        ts_expr_stmt(expr: ts_call(
          callee: ts_member(object: ts_ident(name: "console"), property: "log"),
          args: [ts_lit_str(value: "dispatch refused"), ts_ident(name: "j")],
        )),
      ]),
      else_stmt: none,
    ),
    ts_if(
      cond: ts_ident(name: "ok"),
      then_stmt: ts_block(stmts: [
        ts_expr_stmt(expr: ts_call(callee: ts_ident(name: js_sessions_observe_fn), args: [])),
        ts_expr_stmt(expr: ts_call(callee: ts_ident(name: js_attempts_observe_fn), args: [])),
        ts_expr_stmt(expr: ts_call(callee: ts_ident(name: js_refresh_workflow_fn), args: [])),
      ]),
      else_stmt: none,
    ),
    ts_expr_stmt(expr: ts_binop(left: js_b_member(name: "disabled"), op: "=", right: ts_ident(name: "false"))),
  ])
}

fn dispatch_response_handler_body() -> TsStmt {
  ts_block(stmts: [
    ts_expr_stmt(expr: ts_binop(
      left: ts_member(object: js_b_member(name: "dataset"), property: "status"),
      op: "=",
      right: ts_binop(left: js_j_status(), op: "||", right: ts_lit_str(value: "")),
    )),
    ts_const(name: "apply", value: ts_arrow(params: [], body: dispatch_terminal_apply_body())),
    ts_expr_stmt(expr: ts_call(
      callee: ts_ident(name: "setTimeout"),
      args: [ts_ident(name: "apply"), dwell_remaining_expr()],
    )),
  ])
}

fn dispatch_click_handler_body(url_expr: TsExpr) -> TsStmt {
  ts_block(stmts: [
    ts_expr_stmt(expr: ts_binop(left: js_b_member(name: "disabled"), op: "=", right: ts_ident(name: "true"))),
    ts_const(name: "t0", value: ts_call(callee: ts_member(object: ts_ident(name: "Date"), property: "now"), args: [])),
    ts_expr_stmt(expr: ts_binop(left: js_b_member(name: "textContent"), op: "=", right: ts_lit_str(value: dispatch_caption_requested))),
    js_classlist_call(method: "remove", arg: ts_lit_str(value: dispatch_class_ok)),
    js_classlist_call(method: "remove", arg: ts_lit_str(value: dispatch_class_refused)),
    js_classlist_call(method: "remove", arg: ts_lit_str(value: dispatch_class_loud)),
    js_classlist_call(method: "add", arg: ts_lit_str(value: dispatch_class_requested)),
    ts_expr_stmt(expr: ts_binop(left: js_b_member(name: "title"), op: "=", right: ts_lit_str(value: ""))),
    ts_expr_stmt(expr: ts_call(
      callee: ts_member(
        object: ts_call(
          callee: ts_member(
            object: ts_call(
              callee: ts_member(
                object: ts_call(
                  callee: ts_ident(name: "fetch"),
                  args: [url_expr, ts_object(fields: [ts_field(key: "method", value: ts_lit_str(value: "POST"))])],
                ),
                property: "then",
              ),
              args: [ts_arrow(params: ["r"], body: ts_expr_stmt(expr: ts_call(callee: ts_member(object: ts_ident(name: "r"), property: "json"), args: [])))],
            ),
            property: "then",
          ),
          args: [ts_arrow(params: ["j"], body: dispatch_response_handler_body())],
        ),
        property: "catch",
      ),
      args: [ts_arrow(params: ["e"], body: ts_block(stmts: [
        ts_const(name: "applyErr", value: ts_arrow(params: [], body: ts_block(stmts: [
          ts_expr_stmt(expr: ts_binop(left: js_b_member(name: "textContent"), op: "=", right: ts_lit_str(value: dispatch_caption_loud))),
          js_classlist_call(method: "remove", arg: ts_lit_str(value: dispatch_class_requested)),
          js_classlist_call(method: "add", arg: ts_lit_str(value: dispatch_class_refused)),
          js_classlist_call(method: "add", arg: ts_lit_str(value: dispatch_class_loud)),
          ts_const(name: "why", value: ts_binop(
            left: ts_lit_str(value: concat(dispatch_unreadable_answer_phrase, ": ")),
            op: "+",
            right: ts_ident(name: "e"))),
          ts_expr_stmt(expr: ts_binop(left: js_b_member(name: "title"), op: "=", right: ts_ident(name: "why"))),
          ts_expr_stmt(expr: ts_call(
            callee: ts_ident(name: js_reason_surface_fn),
            args: [
              ts_call(callee: ts_ident(name: js_row_disclosure_fn), args: [ts_ident(name: "b")]),
              ts_lit_str(value: reason_source_dispatch),
              ts_ident(name: "why"),
            ])),
          ts_expr_stmt(expr: ts_binop(left: js_b_member(name: "disabled"), op: "=", right: ts_ident(name: "false"))),
        ]))),
        ts_expr_stmt(expr: ts_call(callee: ts_ident(name: "setTimeout"), args: [ts_ident(name: "applyErr"), dwell_remaining_expr()])),
      ]))],
    )),
  ])
}

data pointerdown_tick_isolation_note: String = "The tick rides its OWN pointerdown listener rather than living inside the click handler, and the separation is load-bearing in two independent ways.

MECHANICALLY it is when the sound belongs. Acknowledgment is owed to the press, not the release — the video-game rule the whole register follows — and pointerdown is the event that fires as the control starts travelling, in the same frame the CSS :active depression begins. Putting the tick in the click handler would fire it on RELEASE, so the sound and the visible travel would disagree about when the mechanism engaged.

SAFETY-WISE it means a sound failure cannot break dispatch. Two listeners on one element are independent: if WebAudio is unavailable or throws in some browser, the exception is contained in the tick listener and the click listener still POSTs. Had the tick been a statement inside the click handler, a throw would have aborted the dispatch before the fetch — trading a working button for a decorative noise, which is exactly the wrong direction. This is also why no capability probe or try/catch appears here: the isolation makes the failure harmless, so there is nothing to degrade gracefully around and no silent fallback to write."

fn dispatch_bind_statements(selector: String, url_expr: TsExpr) -> List<TsStmt> {
  [
    ts_expr_stmt(expr: ts_call(
      callee: ts_member(
        object: ts_call(
          callee: ts_member(object: ts_ident(name: "document"), property: "querySelectorAll"),
          args: [ts_lit_str(value: selector)],
        ),
        property: "forEach",
      ),
      args: [ts_arrow(params: ["b"], body: ts_block(stmts: [
        ts_expr_stmt(expr: ts_call(
          callee: js_b_member(name: "addEventListener"),
          args: [
            ts_lit_str(value: "pointerdown"),
            ts_arrow(params: [], body: ts_expr_stmt(expr: ts_call(callee: ts_ident(name: js_tick_fn), args: []))),
          ],
        )),
        ts_expr_stmt(expr: ts_call(
          callee: js_b_member(name: "addEventListener"),
          args: [ts_lit_str(value: "click"), ts_arrow(params: [], body: dispatch_click_handler_body(url_expr: url_expr))],
        )),
      ]))],
    )),
  ]
}

// The auditioner control (remodel W1f): cycles the active swatch set island-pastel -> okabe-ito ->
// solarized -> island-pastel, persisted like the mute because a palette audition is a property of
// these eyes. island is the ABSENT attribute (the emitted default); a named set pins
// data-swatch-set, which the audition blocks in roadmap_style answer. The control was rendered
// only on the /sandbox design surface, which is deleted (owner ruling 2026-10-04: unused served
// pages go), so NO served page renders the toggle today; the shared client program still applies a
// stored choice on load and still binds the control wherever a page renders one.

data swatch_storage_key: String = "gunbc.swatch-set"
data swatch_toggle_class: String = "swatch-toggle"
data swatch_default_set_value: String = "okabe-ito"
data swatch_audition_a: String = "island-pastel"
data swatch_audition_b: String = "solarized"
data swatch_audition_values: List<String> = [swatch_audition_a, swatch_audition_b]
data swatch_toggle_label_prefix: String = "swatches · "

fn swatch_toggle_labels() -> List<String> {
  map(concat([swatch_default_set_value], swatch_audition_values),
    v => join([swatch_toggle_label_prefix, v], ""))
}

fn swatch_toggle_reserved_width() -> String {
  css_length_wire(l: css_ch(n: dispatch_reserved_ch_for(labels: swatch_toggle_labels())))
}

fn disclosure_bind_statements() -> List<TsStmt> {
  [
    ts_expr_stmt(expr: ts_call(
      callee: ts_member(
        object: ts_call(
          callee: ts_member(object: ts_ident(name: "document"), property: "querySelectorAll"),
          args: [ts_lit_str(value: "details.taskbar-inspect")],
        ),
        property: "forEach",
      ),
      args: [ts_arrow(params: ["d"], body: ts_block(stmts: [
        ts_const(name: "m", value: ts_call(
          callee: ts_member(object: ts_ident(name: "d"), property: "querySelector"),
          args: [ts_lit_str(value: join([".", disclosure_mark_class], ""))],
        )),
        ts_if(
          cond: ts_prefix(op: "!", expr: ts_ident(name: "m")),
          then_stmt: ts_block(stmts: [ts_return(expr: none)]),
          else_stmt: none,
        ),
        ts_const(name: "paint", value: ts_arrow(params: [], body: ts_expr_stmt(expr: ts_call(
          callee: ts_member(object: ts_member(object: ts_ident(name: "m"), property: "classList"), property: "toggle"),
          args: [ts_lit_str(value: disclosure_open_class), ts_member(object: ts_ident(name: "d"), property: "open")],
        )))),
        ts_expr_stmt(expr: ts_call(callee: ts_ident(name: "paint"), args: [])),
        ts_expr_stmt(expr: ts_call(
          callee: ts_member(object: ts_ident(name: "d"), property: "addEventListener"),
          args: [ts_lit_str(value: "toggle"), ts_ident(name: "paint")],
        )),
      ]))],
    )),
  ]
}

fn swatch_toggle_bind_statements() -> List<TsStmt> {
  [
    ts_const(name: "gunbcSwatchChoice", value: ts_arrow(params: [], body: ts_expr_stmt(expr: ts_binop(
      left: js_local_storage_get(key: swatch_storage_key),
      op: "||",
      right: ts_lit_str(value: swatch_default_set_value))))),
    ts_const(name: "gunbcApplySwatch", value: ts_arrow(params: [], body: ts_block(stmts: [
      ts_const(name: "t", value: ts_call(callee: ts_ident(name: "gunbcSwatchChoice"), args: [])),
      ts_if(
        cond: ts_binop(left: ts_ident(name: "t"), op: "===", right: ts_lit_str(value: swatch_default_set_value)),
        then_stmt: ts_block(stmts: [
          ts_expr_stmt(expr: ts_call(
            callee: ts_member(object: js_document_element(), property: "removeAttribute"),
            args: [ts_lit_str(value: "data-swatch-set")],
          )),
          ts_return(expr: none),
        ]),
        else_stmt: none,
      ),
      ts_expr_stmt(expr: ts_call(
        callee: ts_member(object: js_document_element(), property: "setAttribute"),
        args: [ts_lit_str(value: "data-swatch-set"), ts_ident(name: "t")],
      )),
    ]))),
    ts_expr_stmt(expr: ts_call(callee: ts_ident(name: "gunbcApplySwatch"), args: [])),
    ts_expr_stmt(expr: ts_call(
      callee: ts_member(
        object: ts_call(
          callee: ts_member(object: ts_ident(name: "document"), property: "querySelectorAll"),
          args: [ts_lit_str(value: join([".", swatch_toggle_class], ""))],
        ),
        property: "forEach",
      ),
      args: [ts_arrow(params: ["t"], body: ts_block(stmts: [
        ts_const(name: "paint", value: ts_arrow(params: [], body: ts_expr_stmt(expr: ts_binop(
          left: ts_member(object: ts_ident(name: "t"), property: "textContent"),
          op: "=",
          right: ts_binop(
            left: ts_lit_str(value: swatch_toggle_label_prefix),
            op: "+",
            right: ts_call(callee: ts_ident(name: "gunbcSwatchChoice"), args: []),
          ),
        )))),
        ts_expr_stmt(expr: ts_call(callee: ts_ident(name: "paint"), args: [])),
        ts_expr_stmt(expr: ts_call(
          callee: ts_member(object: ts_ident(name: "t"), property: "addEventListener"),
          args: [ts_lit_str(value: "click"), ts_arrow(params: [], body: ts_block(stmts: [
            ts_const(name: "cur", value: ts_call(callee: ts_ident(name: "gunbcSwatchChoice"), args: [])),
            ts_const(name: "next", value: ts_cond(
              test: ts_binop(left: ts_ident(name: "cur"), op: "===", right: ts_lit_str(value: swatch_default_set_value)),
              consequent: ts_lit_str(value: swatch_audition_a),
              alternate: ts_cond(
                test: ts_binop(left: ts_ident(name: "cur"), op: "===", right: ts_lit_str(value: swatch_audition_a)),
                consequent: ts_lit_str(value: swatch_audition_b),
                alternate: ts_lit_str(value: swatch_default_set_value),
              ),
            )),
            ts_if(
              cond: ts_binop(left: ts_ident(name: "next"), op: "===", right: ts_lit_str(value: swatch_default_set_value)),
              then_stmt: ts_block(stmts: [
                ts_expr_stmt(expr: ts_call(
                  callee: ts_member(object: ts_ident(name: "localStorage"), property: "removeItem"),
                  args: [ts_lit_str(value: swatch_storage_key)],
                )),
              ]),
              else_stmt: none,
            ),
            ts_if(
              cond: ts_binop(left: ts_ident(name: "next"), op: "!==", right: ts_lit_str(value: swatch_default_set_value)),
              then_stmt: ts_block(stmts: [
                ts_expr_stmt(expr: ts_call(
                  callee: ts_member(object: ts_ident(name: "localStorage"), property: "setItem"),
                  args: [ts_lit_str(value: swatch_storage_key), ts_ident(name: "next")],
                )),
              ]),
              else_stmt: none,
            ),
            ts_expr_stmt(expr: ts_call(callee: ts_ident(name: "gunbcApplySwatch"), args: [])),
            ts_expr_stmt(expr: ts_call(callee: ts_ident(name: "paint"), args: [])),
          ]))],
        )),
      ]))],
    )),
  ]
}

fn workflow_row_selector_expr(node_id: TsExpr) -> TsExpr {
  ts_binop(
    left: ts_binop(
      left: ts_lit_str(value: "li[data-node=\""),
      op: "+",
      right: node_id),
    op: "+",
    right: ts_lit_str(value: "\"]"))
}

// U2 plus workflow lamps v0, corrected for lifecycle truth: one named observer per endpoint runs at
// load, immediately after an accepted dispatch, and on the modeled poll cadence while the page is
// open. Each observation recomputes its own axis; neither endpoint can suppress the other.
// /sessions.json proves tmux/process presence only, so it renders `session · present` plus the
// provider/readiness evidence carried by the wire, never `live` as agent execution. Refusal
// resolves every Live lamp to Refused and inserts a source-specific loud banner — unknowable never
// rounds to Off.

data js_sessions_observe_fn: String = "gunbcObserveSessions"
data js_attempts_observe_fn: String = "gunbcObserveAttempts"
data js_sessions_observe_in_flight: String = "gunbcSessionsObservationInFlight"
data js_attempts_observe_in_flight: String = "gunbcAttemptsObservationInFlight"
data js_sessions_observe_pending: String = "gunbcSessionsObservationPending"
data js_attempts_observe_pending: String = "gunbcAttemptsObservationPending"
data js_observation_poll_tick: String = "gunbcObservationPollTick"
data observation_poll_interval: Millisecond = millisecond(count: 3000)
// The page has no typed terminal-attempt observation yet, so it cannot honestly decide that an
// attempt is terminal and stop polling. It therefore re-observes both independent sources for the
// page lifetime at one explicit cadence; a recursive one-shot timeout schedules the next
// observation without introducing the dashboard's forbidden animation/interval loop, and page
// unload cancels the browser timer. Each source permits one request in flight and coalesces
// overlapping timer or post-dispatch observations into one pending rerun, so an older response
// cannot repaint over a newer one. This dissolves into terminal-bounded polling when
// AttemptEvidence.terminal_outcome gains a live producer.

fn observation_complete_stmts(
  observer: String,
  in_flight: String,
  pending: String,
) -> List<TsStmt> {
  [
    ts_expr_stmt(expr: ts_binop(
      left: ts_ident(name: in_flight),
      op: "=",
      right: ts_ident(name: "false"))),
    ts_if(
      cond: ts_ident(name: pending),
      then_stmt: ts_block(stmts: [
        ts_expr_stmt(expr: ts_binop(
          left: ts_ident(name: pending),
          op: "=",
          right: ts_ident(name: "false"))),
        ts_expr_stmt(expr: ts_call(callee: ts_ident(name: observer), args: [])),
      ]),
      else_stmt: none),
  ]
}

fn observation_begin_stmts(in_flight: String, pending: String) -> List<TsStmt> {
  [
    ts_if(
      cond: ts_ident(name: in_flight),
      then_stmt: ts_block(stmts: [
        ts_expr_stmt(expr: ts_binop(
          left: ts_ident(name: pending),
          op: "=",
          right: ts_ident(name: "true"))),
        ts_return(expr: none),
      ]),
      else_stmt: none),
    ts_expr_stmt(expr: ts_binop(
      left: ts_ident(name: in_flight),
      op: "=",
      right: ts_ident(name: "true"))),
  ]
}

