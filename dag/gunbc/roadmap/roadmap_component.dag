// When a server-rendered inspect exists (ticket content) but the attempt sections are absent, the
// painter creates just those sections — stages ahead of the ticket body, raw beneath it.
// Registered once beside the other helpers; the painter calls it with the inspect body element.
data js_inspect_ensure_fn: String = "gunbcInspectEnsure"

fn inspect_ensure_helper_stmt() -> TsStmt {
  ts_const(name: js_inspect_ensure_fn, value: ts_arrow(params: ["ib"], body: ts_block(stmts: [
    ts_let(name: "stg", value: ts_slot_query(obj: "ib", selector: ".inspect-stages")),
    ts_if(
      cond: ts_prefix(op: "!", expr: ts_ident(name: "stg")),
      then_stmt: ts_block(stmts: [
        ts_expr_stmt(expr: ts_binop(
          left: ts_ident(name: "stg"),
          op: "=",
          right: ts_call(
            callee: ts_member(object: ts_ident(name: "document"), property: "createElement"),
            args: [ts_lit_str(value: "div")]))),
        ts_expr_stmt(expr: ts_binop(
          left: ts_member(object: ts_ident(name: "stg"), property: "className"),
          op: "=",
          right: ts_lit_str(value: "inspect-stages"))),
        ts_const(name: "aled2", value: ts_call(
          callee: ts_member(object: ts_ident(name: "document"), property: "createElement"),
          args: [ts_lit_str(value: "div")])),
        ts_expr_stmt(expr: ts_binop(
          left: ts_member(object: ts_ident(name: "aled2"), property: "className"),
          op: "=",
          right: ts_lit_str(value: activity_ledger_class))),
        ts_expr_stmt(expr: ts_call(
          callee: ts_member(object: ts_ident(name: "stg"), property: "append"),
          args: [ts_ident(name: "aled2")])),
        ts_expr_stmt(expr: ts_call(
          callee: ts_member(object: ts_ident(name: "ib"), property: "prepend"),
          args: [ts_ident(name: "stg")])),
      ]),
      else_stmt: none),
    ts_let(name: "raw", value: ts_slot_query(obj: "ib", selector: ".inspect-raw")),
    ts_if(
      cond: ts_prefix(op: "!", expr: ts_ident(name: "raw")),
      then_stmt: ts_block(stmts: [
        ts_expr_stmt(expr: ts_binop(
          left: ts_ident(name: "raw"),
          op: "=",
          right: ts_call(
            callee: ts_member(object: ts_ident(name: "document"), property: "createElement"),
            args: [ts_lit_str(value: "div")]))),
        ts_expr_stmt(expr: ts_binop(
          left: ts_member(object: ts_ident(name: "raw"), property: "className"),
          op: "=",
          right: ts_lit_str(value: "inspect-raw"))),
        ts_const(name: "athr2", value: ts_call(
          callee: ts_member(object: ts_ident(name: "document"), property: "createElement"),
          args: [ts_lit_str(value: "span")])),
        ts_expr_stmt(expr: ts_binop(
          left: ts_member(object: ts_ident(name: "athr2"), property: "className"),
          op: "=",
          right: ts_lit_str(value: activity_throughput_class))),
        ts_expr_stmt(expr: ts_call(
          callee: ts_member(object: ts_ident(name: "raw"), property: "append"),
          args: [ts_ident(name: "athr2")])),
        ts_const(name: "aev2", value: ts_call(
          callee: ts_member(object: ts_ident(name: "document"), property: "createElement"),
          args: [ts_lit_str(value: "div")])),
        ts_expr_stmt(expr: ts_binop(
          left: ts_member(object: ts_ident(name: "aev2"), property: "className"),
          op: "=",
          right: ts_lit_str(value: activity_evidence_class))),
        ts_expr_stmt(expr: ts_call(
          callee: ts_member(object: ts_ident(name: "raw"), property: "append"),
          args: [ts_ident(name: "aev2")])),
        ts_expr_stmt(expr: ts_call(
          callee: ts_member(object: ts_ident(name: "ib"), property: "append"),
          args: [ts_ident(name: "raw")])),
      ]),
