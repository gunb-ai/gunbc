          else_stmt: Present { value: ts_block(stmts: [
            ts_expr_stmt(expr: ts_binop(
              left: ts_ident(name: "cc"),
              op: "&&",
              right: ts_call(
                callee: ts_member(object: ts_ident(name: "cc"), property: "remove"),
                args: []))),
          ]) }),
      ]),
      else_stmt: none,
    ),
  ]
}

fn remove_all_selector_stmt(selector: String, item_name: String) -> TsStmt {
  ts_expr_stmt(expr: ts_call(
    callee: ts_member(
      object: ts_call(
        callee: ts_member(object: ts_ident(name: "document"), property: "querySelectorAll"),
        args: [ts_lit_str(value: selector)]),
      property: "forEach"),
    args: [ts_arrow(
      params: [item_name],
      body: ts_expr_stmt(expr: ts_call(
        callee: ts_member(object: ts_ident(name: item_name), property: "remove"),
        args: [])))]))
}

// Each session observation clears the prior projection before repainting: presence datasets flip
// back and every session-facts disclosure line is removed, so a torn-down session cannot leave a
// stale 'present' claim. The dispatch button itself is untouched — it is an action and never
// carried the presence claim after A2 (node_activity_region_note).

fn sessions_reset_presence_stmt() -> TsStmt {
  ts_expr_stmt(expr: ts_call(
    callee: ts_member(
      object: ts_call(
        callee: ts_member(object: ts_ident(name: "document"), property: "querySelectorAll"),
        args: [ts_lit_str(value: join([
          ".dispatch-btn[data-session-presence=\"present\"], .",
          session_facts_class,
        ], ""))]),
      property: "forEach"),
    args: [ts_arrow(params: ["pb"], body: ts_block(stmts: [
      ts_if(
        cond: ts_call(
          callee: ts_member(
            object: ts_member(object: ts_ident(name: "pb"), property: "classList"),
            property: "contains"),
          args: [ts_lit_str(value: session_facts_class)]),
        then_stmt: ts_block(stmts: [
          ts_expr_stmt(expr: ts_call(
            callee: ts_member(object: ts_ident(name: "pb"), property: "remove"),
            args: [])),
        ]),
        else_stmt: Present { value: ts_block(stmts: [
          ts_expr_stmt(expr: ts_binop(
            left: ts_member(
              object: ts_member(object: ts_ident(name: "pb"), property: "dataset"),
              property: "sessionPresence"),
            op: "=",
            right: ts_lit_str(value: ""))),
        ]) },
      ),
    ]))]))
}

// ONE FAILURE NARRATED ONCE, ACROSS CHANNELS (A2 hierarchy closeout, operator gap ruling
// 2026-08-02). Three observation channels — sessions, attempts, workflow — used to each prepend
// their own full-width refusal banner through this painter, so one dead observation root stacked
// three near-identical amber voices above the fold (the local-serve screenshots are the specimen).
// The painter now upserts each channel's located row INSIDE one shared impact region: the
// server-rendered section.workspace-observation when the page shipped one (the serve-time impact
// statement keeps its own summary — the client never overwrites a server-decided claim), else a
// client-minted twin. The region's disclosure holds the per-channel raw rows, the summary states
// the user-relevant impact with the refused-channel count, and gunbcObserveImpactSync retracts rows
// as channels recover — a client-minted region with zero refused rows removes itself, so recovery
// leaves no husk. Frequency stays observable: every channel row remains in the DOM, typed by its
// source class, one interaction deep — deduplicated narration, never deduplicated evidence.

fn observe_impact_preamble_statements() -> List<TsStmt> {
  [
    ts_const(name: "gunbcObserveImpactBox", value: ts_arrow(params: [], body: ts_block(stmts: [
      ts_let(name: "box", value: ts_call(
        callee: ts_member(object: ts_ident(name: "document"), property: "querySelector"),
        args: [ts_lit_str(value: ".workspace-observation")])),
      ts_if(
        cond: ts_prefix(op: "!", expr: ts_ident(name: "box")),
        then_stmt: ts_block(stmts: [
          ts_expr_stmt(expr: ts_binop(
            left: ts_ident(name: "box"),
            op: "=",
            right: ts_call(
              callee: ts_member(object: ts_ident(name: "document"), property: "createElement"),
              args: [ts_lit_str(value: "section")]))),
          ts_expr_stmt(expr: ts_binop(
            left: ts_member(object: ts_ident(name: "box"), property: "className"),
            op: "=",
            right: ts_lit_str(value: "workspace-observation client-minted"))),
          ts_const(name: "s", value: ts_call(
            callee: ts_member(object: ts_ident(name: "document"), property: "createElement"),
            args: [ts_lit_str(value: "span")])),
          ts_expr_stmt(expr: ts_binop(
            left: ts_member(object: ts_ident(name: "s"), property: "className"),
            op: "=",
            right: ts_lit_str(value: "workspace-observation-summary"))),
          ts_expr_stmt(expr: ts_call(
            callee: ts_member(object: ts_ident(name: "box"), property: "append"),
            args: [ts_ident(name: "s")])),
          ts_const(name: "mn", value: ts_call(
            callee: ts_member(object: ts_ident(name: "document"), property: "querySelector"),
            args: [ts_lit_str(value: "main")])),
          ts_expr_stmt(expr: ts_binop(
            left: ts_ident(name: "mn"),
            op: "&&",
            right: ts_call(
              callee: ts_member(object: ts_ident(name: "mn"), property: "prepend"),
              args: [ts_ident(name: "box")]))),
        ]),
        else_stmt: none),
      ts_let(name: "d", value: ts_call(
        callee: ts_member(object: ts_ident(name: "box"), property: "querySelector"),
        args: [ts_lit_str(value: ".observe-impact-detail")])),
      ts_if(
        cond: ts_prefix(op: "!", expr: ts_ident(name: "d")),
        then_stmt: ts_block(stmts: [
          ts_expr_stmt(expr: ts_binop(
            left: ts_ident(name: "d"),
            op: "=",
            right: ts_call(
              callee: ts_member(object: ts_ident(name: "document"), property: "createElement"),
              args: [ts_lit_str(value: "details")]))),
          ts_expr_stmt(expr: ts_binop(
            left: ts_member(object: ts_ident(name: "d"), property: "className"),
            op: "=",
            right: ts_lit_str(value: "observe-impact-detail"))),
          ts_const(name: "sm", value: ts_call(
            callee: ts_member(object: ts_ident(name: "document"), property: "createElement"),
            args: [ts_lit_str(value: "summary")])),
          ts_expr_stmt(expr: ts_binop(
            left: ts_member(object: ts_ident(name: "sm"), property: "textContent"),
            op: "=",
            right: ts_lit_str(value: "refused observation channels"))),
          ts_expr_stmt(expr: ts_call(
            callee: ts_member(object: ts_ident(name: "d"), property: "append"),
            args: [ts_ident(name: "sm")])),
          ts_expr_stmt(expr: ts_call(
            callee: ts_member(object: ts_ident(name: "box"), property: "append"),
            args: [ts_ident(name: "d")])),
        ]),
        else_stmt: none),
      ts_return(expr: Present { value: ts_ident(name: "box") }),
    ]))),
    ts_const(name: "gunbcObserveImpactSync", value: ts_arrow(params: [], body: ts_block(stmts: [
      ts_const(name: "box", value: ts_call(
        callee: ts_member(object: ts_ident(name: "document"), property: "querySelector"),
        args: [ts_lit_str(value: ".workspace-observation")])),
      ts_if(cond: ts_prefix(op: "!", expr: ts_ident(name: "box")), then_stmt: ts_return(expr: none), else_stmt: none),
      ts_const(name: "n", value: ts_member(
        object: ts_call(
          callee: ts_member(object: ts_ident(name: "box"), property: "querySelectorAll"),
          args: [ts_lit_str(value: ".observe-refused")]),
        property: "length")),
      ts_if(
        cond: ts_prefix(op: "!", expr: ts_call(
          callee: ts_member(object: ts_member(object: ts_ident(name: "box"), property: "classList"), property: "contains"),
          args: [ts_lit_str(value: "client-minted")])),
        then_stmt: ts_return(expr: none),
        else_stmt: none),
      ts_if(
        cond: ts_binop(left: ts_ident(name: "n"), op: "===", right: ts_lit_num(text: "0")),
        then_stmt: ts_block(stmts: [
          ts_expr_stmt(expr: ts_call(callee: ts_member(object: ts_ident(name: "box"), property: "remove"), args: [])),
          ts_return(expr: none),
        ]),
        else_stmt: none),
      ts_const(name: "s", value: ts_call(
        callee: ts_member(object: ts_ident(name: "box"), property: "querySelector"),
        args: [ts_lit_str(value: ".workspace-observation-summary")])),
      ts_expr_stmt(expr: ts_binop(
        left: ts_ident(name: "s"),
        op: "&&",
        right: ts_binop(
          left: ts_member(object: ts_ident(name: "s"), property: "textContent"),
          op: "=",
          right: ts_binop(
            left: ts_binop(
              left: ts_lit_str(value: "observation unavailable — "),
              op: "+",
              right: ts_ident(name: "n")),
            op: "+",
            right: ts_cond(
              test: ts_binop(left: ts_ident(name: "n"), op: "===", right: ts_lit_num(text: "1")),
              consequent: ts_lit_str(value: " channel refused"),
              alternate: ts_lit_str(value: " channels refused")))))),
    ]))),
