                remove_all_selector_stmt(selector: ".sessions-observe-refused", item_name: "oldBanner"),
                ts_expr_stmt(expr: ts_call(callee: ts_ident(name: "gunbcObserveImpactSync"), args: [])),
                sessions_reset_presence_stmt(),
                ts_expr_stmt(expr: ts_call(
                  callee: ts_member(object: ts_member(object: ts_ident(name: "sj"), property: "sessions"), property: "forEach"),
                  args: [ts_arrow(params: ["sess"], body: ts_block(stmts: sessions_mark_live_stmts()))])),
              ]) },
            ),
          ], observation_complete_stmts(
            observer: js_sessions_observe_fn,
            in_flight: js_sessions_observe_in_flight,
            pending: js_sessions_observe_pending))))]),
        property: "catch"),
      args: [ts_arrow(params: ["e"], body: ts_block(stmts: concat(
