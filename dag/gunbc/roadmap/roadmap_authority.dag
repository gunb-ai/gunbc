    roadmap_node(
      identity: "rn_HARNESS0RECURSIVE0ALIGN0A",
      id: "harness-recursive-alignment",
      owner: "harness",
      carriers: carrier(path: "docs/plans/harness-work-lifecycle.md"),
      line: ticket(t: fields(
        headline: "Allow work to continue across durable epochs while preserving alignment to every project level and the task contract",
        boundary: "Continuation is unbounded in time but bounded in grounding: at each epoch boundary an independent adjudication reads the attempt's evidence against its rooted chain and resumes, steers, re-plans, routes, or stops the lineage.",
        displaced_cost: "A fixed round budget ends correct work mid-task; uncapped continuation without adjudication trades longer execution for quiet drift. Both failure shapes were measured on live workers.",
        first_slice: "Turn the harness's round-count terminal into a checkpoint-due announcement the workflow adjudicates outside the worker loop.",
        red_control: "A worker crosses two checkpoints on one lineage and submits one candidate; no checkpoint is reported as task failure or completion; a planted steer is accepted and visible in the next epoch.",
        out_of_scope: "The checkpoint never establishes submission, verification, publication, or readiness; those gates are untouched.",
        handback: "The checkpoint mechanism, the durable cadence state, the adjudication boundary, and the two-checkpoint acceptance receipt."
      )),
      parent: in_project(project: "factory", contribution: "Recursive alignment lets workers continue across durable epochs without trading longer execution for project drift."),
    ),
    roadmap_node(
      identity: "rn_HPROMPT0CONTEXT0MODEL00A",
      id: "harness-prompt-context-model",
      owner: "harness",
      carriers: carrier(path: "dag/gunbc/harness/harness_prompt_context.dag"),
      line: ticket(t: updated(t: fields(
        headline: "A prompt is a projection of an admitted context snapshot, never an authored string",
        boundary: "Prompt inputs are typed (authority declaration + revision, work contract + revision, evidence with standing, prior conversation turns, guidance receipts); a context snapshot binds them to an attempt lineage, epoch, and source revision; provider envelopes are late projections of a PromptPlan; a render receipt digests exactly what was rendered. A withdrawn item cannot render as established; a conversation turn cannot fork from bytes the lineage does not own.",
        displaced_cost: "Today the modeled guidance premises collapse into system_prompt: String at the config boundary, so a contradiction between two inputs is concatenated and shipped to the model, and a stale conclusion can resurface from a provider session as if it were a fact.",
        first_slice: "Stand up the PromptInput/PromptContextSnapshot/PromptSegment/PromptPlan types with the render receipt, and make harness_guidance emit modeled segments rather than the final system-prompt string.",
        red_control: "Identical snapshots render identical digests; changing an authority revision invalidates the old render; a Withdrawn input cannot reach a rendered segment; compaction cannot drop unresolved guidance or a tool result's matching call; restart reconstructs the same prompt from durable inputs.",
        out_of_scope: "Segment content is rendered prose, digested -- the type system guards input provenance and revision, not the prose itself. No semantic contradiction inference between free-text inputs; conflicts must be typed to refuse.",
        handback: "The snapshot/segment/plan model, the render receipt, harness_guidance emitting segments, and the controls."
      ), on: "2026-09-30", note: "Not yet centered: needs a centering plan: authored 2026-09-30 with no attempts, and its first slice has not been confirmed bounded.")),
      dispatch: dispatchable(),
      parent: in_project(project: "factory", contribution: "The lifecycle's mandatory steps are only workflow-owned if what the agent is TOLD is also derived and revisioned; modeled prompt inputs make prompt contradiction a dispatch-time refusal instead of a runtime prayer."),
    ),
    roadmap_node(
      identity: "rn_HCHECKPOINT0PLANNER000A",
      id: "harness-checkpoint-subject-planner",
      owner: "harness",
      carriers: carrier(path: "dag/gunbc/roadmap/roadmap_alignment.dag"),
      line: ticket(t: fields(
        headline: "Freeze the checkpoint subject and derive the per-level probe obligations, purely",
        boundary: "Given an AlignmentCheckpointIdentity and the resolved chain, derive the homogeneous probe population (principles, root project, each intermediate project, task), each obligation carrying its level contract, the edge contribution it judges against, the prior guidance outstanding at that level, and the PromptContextSnapshot identity it projects from. No model call, no workspace effect, no verdict: this is the pure plan the durable scheduler executes.",
        displaced_cost: "If probe obligations are derived inside the execution loop, a crash mid-fan-out cannot say which probes existed, and reruns risk minting duplicate verdicts for one checkpoint.",
        first_slice: "The obligation-derivation function and its witness: one checkpoint over the harness lineage derives exactly four obligations in root-to-leaf order, each keyed by the checkpoint identity.",
        red_control: "The same checkpoint identity derives the identical obligation set (idempotent re-derivation after a crash); an obligation's level contract digest and contribution digest come from the chain, not re-authored; a checkpoint whose chain fingerprint moved refuses re-derivation.",
        out_of_scope: "No probe execution, no roundup, no resume; those are the scheduler and adjudication folds. No PromptPlan rendering here either -- the probes' plans are assembled where they execute.",
        handback: "The derivation, the obligation carrier, the idempotency witness, and the join key the scheduler consumes."
      )),
      dispatch: dispatchable(),
      execution: bound(contract: harness_checkpoint_subject_planner_execution_contract()),
      parent: in_project(project: "harness-recursive-alignment", contribution: "The pure planner turns a checkpoint into durable, idempotent obligations, so the parallel probe fan-out is a schedule over derived facts rather than an in-loop improvisation."),
      centering: plan(text: "Target: dag/gunbc/roadmap/roadmap_checkpoint_plan.dag, the checkpoint_probe_obligations derivation, and its witness dag/test/claim/roadmap/roadmap_checkpoint_plan_witness_test.dag. (1) The witness is authored and green at dispatch; keep it green -- a witness edit refuses verification as oracle-moved. (2) The deliverable per the node row: the obligation carrier over the resolved chain, obligation keys idempotent under one AlignmentCheckpointIdentity, the fingerprint-mismatch refusal naming both fingerprints, and outstanding guidance read at leaf distance (task is distance 0; obligations derive root-to-leaf). (3) Scope wall: NO probe execution, NO verdicts, NO roundup -- this lane is the pure planner the scheduler consumes; the belt's adjudication lane joins it later. (4) Acceptance: the named test process, pattern //dag/test/claim/roadmap:roadmap_checkpoint_plan_witness_test."),
    ),
    roadmap_node(
      identity: "rn_HCONVO0LOG0FORK0POINTS0A",
      id: "harness-conversation-log-forking",
      owner: "harness",
      carriers: carrier(path: "dag/gunbc/harness/harness_turn.dag"),
      line: ticket(t: fields(
        headline: "The attempt lineage owns its conversation log; epochs resume and probes fork from typed fork points",
        boundary: "Every round's exact wire (messages sent, blocks received) persists under the attempt's state directory keyed by round, so any (attempt, epoch, round) names an exact conversation state. Epoch resume replays the log to its tip and appends the guidance bundle; an alignment probe forks at the checkpoint's log tip: shared chain prefix plus one level-specific suffix branch. The engine's prefix cache only accelerates what the log already makes correct; nothing may depend on the cache being warm.",
        displaced_cost: "Without a durable log, continuation re-briefs blind, a worker's hard-won context dies with its process, and 'fork from a known point' is impossible because no known point exists.",
        first_slice: "Persist per-round request/response bodies keyed by round in the attempt state directory; wire continuation resume to replay from the log instead of a fresh brief.",
        red_control: "A fork is typed: ForkAdmitted { tip } / ForkInvalid { cause }, where a model, weights, chat-template, or chain-fingerprint change invalidates the fork point; a crashed worker's next epoch resumes from the durable log, not from a re-authored brief; a probe can name the exact log tip it forked from.",
        out_of_scope: "No engine-side KV pinning or replica affinity; the cache stays an opportunistic derivation. No change to what the alignment probes judge.",
        handback: "The durable log, the fork-point typing, resume-from-log, and receipts for crash recovery and invalidation."
      )),
      dispatch: dispatchable(),
      execution: bound(contract: harness_conversation_log_forking_execution_contract()),
      parent: in_project(project: "harness-recursive-alignment", contribution: "The lineage-owned conversation log is what makes resume and probe forks possible at all: without it every epoch is a cold start and every fork point is imaginary."),
      centering: plan(text: "Target: dag/gunbc/harness/harness_turn.dag and dag/gunbc/harness/harness_conversation_fork.dag. The wire layout and fork typing are landed (per-round request/response under <attempt-state>/provider-events.jsonl.wire/, turn.wire_log_unwritable degradation, ConversationForkAdmittance with its three named invalidation causes, KvPrefixResidencyObservation as placement input only). (1) The witness dag/test/claim/harness_conversation_fork_test.dag is green; keep it green. (2) Remaining per the node row: resume-from-log -- the continuation path replays the durable wire log to its tip and appends the guidance bundle instead of re-briefing, and emits the fork receipt binding model/checkpoint/tokenizer/template/projection/prefix digests. (3) Scope wall: engine KV residency is a performance derivation, NEVER correctness state -- cache hit and cache miss must render the same bytes. (4) Acceptance: the named test process, pattern //dag/test/claim/harness_conversation_fork_test."),
    ),
    roadmap_node(
      identity: "rn_HALIGN0CHECKPOINT0RESUME0A",
      id: "harness-alignment-checkpoint-resume",
      owner: "harness",
      carriers: carrier(path: "dag/gunbc/harness/harness_turn.dag"),
      line: ticket(t: updated(t: fields(
