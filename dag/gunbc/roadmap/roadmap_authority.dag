// Operational consumers (belt, dispatch, forecast, page, spawn) match
// roadmap_authority_projection() and propagate RoadmapAuthorityProjectionRefused.
// roadmap_authority() is retained for witnesses that run with a loaded carrier; on refusal it
// returns an explicit unavailable document rather than a silent empty active graph.

fn roadmap_authority_refusal_document(detail: String) -> RoadmapDocument {
  RoadmapDocument {
    preamble: [
      HeadingBlock { level: H1, inlines: [TextInline { text: "gunbc — Roadmap (unavailable)" }] },
      ParagraphBlock {
        inlines: [TextInline {
          text: concat(
            "Acceptance history projection refused; match roadmap_authority_projection at operational boundaries: ",
            detail,
          ),
        }],
      },
    ],
    lead_lanes: [],
    sections: [],
  }
}

fn roadmap_authority() -> RoadmapDocument {
  match roadmap_authority_projection(history: roadmap_acceptance_event_history_load()) {
    RoadmapAuthorityProjected { doc: doc, accepted: _, withheld: _ } => doc
    RoadmapAuthorityProjectionRefused { detail: detail } =>
      roadmap_authority_refusal_document(detail: detail)
  }
}

fn authored_merged_prs() -> List<Int> { [] }

fn expected_roadmap_md_for_projection(proj: RoadmapAuthorityProjection) -> String {
  match proj {
    RoadmapAuthorityProjectionRefused { detail: detail } =>
      concat("# roadmap unavailable\n\n", concat(detail, "\n"))
    RoadmapAuthorityProjected { doc: doc, accepted: _, withheld: _ } =>
      serialize_markdown_source(
        doc: project_roadmap_to_markdown(
          doc: doc,
          merged: authored_merged_prs()
        )
      )
  }
}

fn expected_roadmap_md() -> String {
  expected_roadmap_md_for_projection(proj: roadmap_authority_projection(history: roadmap_acceptance_event_history_load()))
}

fn roadmap_drifted(committed: String) -> Bool {
  !(committed == expected_roadmap_md())
}

fn accepted_node_ids_projection(history: RoadmapAcceptanceEventHistoryLoad) -> AcceptedNodeIdsProjection {
  match frontier_sets_projection(history: history) {
    FrontierSetsProjected { accepted: accepted, withheld: _ } =>
      AcceptedNodeIdsProjected { ids: accepted }
    FrontierSetsProjectionRefused { detail: detail } =>
      AcceptedNodeIdsProjectionRefused { detail: detail }
  }
}

fn frontier_sets_projection(history: RoadmapAcceptanceEventHistoryLoad) -> FrontierSetsProjection {
  match history {
    RoadmapAcceptanceEventHistoryLoadRefused { detail: detail } =>
      FrontierSetsProjectionRefused { detail: detail }
    RoadmapAcceptanceEventHistoryLoaded { events: events } => {
      match remains_superseded_revocations_join(history: events, nodes: declared_roadmap_nodes()) {
        RemainsSupersededRevocationOnNonSupersededNode { node: node } =>
          FrontierSetsProjectionRefused {
            detail: join(["remains-superseded-revocation-on-non-superseded-node:", node as String], ""),
          }
        RemainsSupersededRevocationOnUndeclaredNode { node: node } =>
          FrontierSetsProjectionRefused {
            detail: join(["remains-superseded-revocation-on-undeclared-node:", node as String], ""),
          }
        RemainsSupersededRevocationOnAmbiguousDeclaredNode { node: node } =>
          FrontierSetsProjectionRefused {
            detail: join(["remains-superseded-revocation-on-ambiguous-declared-node:", node as String], ""),
          }
        RemainsSupersededRevocationsJoined =>
          match replay_acceptance_history(events: events) {
            Absent =>
              FrontierSetsProjectionRefused { detail: "acceptance-history-unreplayable" }
            Present { value: state } =>
              match live_receipts_join_declared_nodes(receipts: state.live, nodes: declared_roadmap_nodes()) {
                LiveReceiptJoinsSupersededLine { node: node } =>
                  FrontierSetsProjectionRefused {
                    detail: join(["live-receipt-on-superseded-line:", node as String], ""),
                  }
                LiveReceiptDoesNotMatchDeclaredNode { node: node } =>
                  FrontierSetsProjectionRefused {
                    detail: join(["live-receipt-does-not-match-declared-node:", node as String], ""),
                  }
                LiveReceiptJoinsUndeclaredNode { node: node } =>
                  FrontierSetsProjectionRefused {
                    detail: join(["live-receipt-on-undeclared-node:", node as String], ""),
                  }
                LiveReceiptJoinsAmbiguousDeclaredNode { node: node } =>
                  FrontierSetsProjectionRefused {
                    detail: join(["live-receipt-on-ambiguous-declared-node:", node as String], ""),
                  }
                LiveReceiptsJoinDeclared =>
                  FrontierSetsProjected {
                    accepted: accepted_node_ids_from_receipts(receipts: state.live),
                    withheld: node_ids_held_off_active_frontier(history: events),
                  }
              }
          }
      }
    }
  }
}



fn withheld_node_ids_projection(history: RoadmapAcceptanceEventHistoryLoad) -> WithheldNodeIdsProjection {
  match frontier_sets_projection(history: history) {
    FrontierSetsProjected { accepted: _, withheld: withheld } =>
      WithheldNodeIdsProjected { ids: withheld }
    FrontierSetsProjectionRefused { detail: detail } =>
      WithheldNodeIdsProjectionRefused { detail: detail }
  }
}

type AcceptedNodeIdsProjection
  = AcceptedNodeIdsProjected { ids: List<RoadmapNodeId> }
  | AcceptedNodeIdsProjectionRefused { detail: String }
