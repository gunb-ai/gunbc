    roadmap_node(
      identity: "rn_5JZQ8XKD2VWT4N7RYH6MCB3FP9",
      id: "ken-strata-56g-reread-dissolves-build-seat-frontier",
      owner: "fleet",
      carriers: carrier(path: "dag/gunbc/serving/serving_host_memory.dag"),
      line: ticket(t: updated(t: fields(
        headline: "ken's strata engine carries the 56G trim, and the build-seat frontier it priced is dissolved (gunbc#16763)",
        displaced_cost: "What it cost to leave this unread: the model believed a 112G serving charge the operator had already trimmed on 2026-11-19, and that charge held up the second build seat the trim was bought to fund. gunbc#16763 paid it down: the ceiling is now a read, and the seat frontier row that priced it is deleted.",
        boundary: "ken's strata engine is read live, the 112G reading is replaced by the 56G one with its provenance, and the build-seat frontier goes through its own dissolve rather than being edited away by hand. Owner: still-fox-404.",
        first_slice: "Nothing left to cut: gunbc#16763 (ea751f86d6ff) merged 2026-11-20T06:00:45Z with the read and the dissolve. The row stays as the record of what the ruling owed and of who owns what is left on ken.",
        red_control: "A frontier that dissolves without a live read behind the new ceiling refuses; with the ceiling back-dated to the unconfirmed 112G reading the dissolve refuses, which is the control's positive case.",
        out_of_scope: "ken's tailnet pin, host key and srv9 endpoint -- tidy-pike-449's, edged to and not authored here; any live change to ken's engine (the trim was the operator's act); butch's engines.",
        handback: "A serving charge the model reads from the machine, and a build-seat frontier that dissolved because the number earned it, which is what landed."
      ), on: "2026-11-20", note: "LANDED. Live read 2026-11-20: gunbc#16763 MERGED 2026-11-20T06:00:45Z as ea751f86d6ff, 'ken: carry the live 56 GiB serving ceiling, and dissolve the seat frontier it priced (#16763)' -- the read that landing the ruling owed. What it carried, from its own commit message: systemctl show ken-strata.service -p MemoryMax returned 60129542144 (56 GiB) and MemoryHigh returned infinity, read by still-fox-404 over read-only ssh to ubuntu@192.168.1.236 at 2026-11-19T22:18:37Z. The ceiling this row is about is now gunbc.serving.serving_host_memory::ken_strata_engine_memory carrying memory_max as a ServingMemoryRead at 56 GiB with that provenance, alongside a read 2G swap cap, a read 12 GiB parked-session cache and six read slots; the seat frontier row that used to price the 112G reading is DELETED from dag/gunbc/serving/serving_reservation.dag, so it is named here only as the thing that was dissolved, never cited. It came from: gunbc.design_ruling::ken_strata_memory_trim_buys_two_build_seats_2026_11_19 (dag/gunbc/design_ruling.dag, landed by gunbc#16745, MERGED 2026-11-20T01:15:35Z), which held the 112G reading load-bearing until a live re-read replaced it. Correction to the hand-down: srv9 is modeled, not missing -- gunbc#16712 (MERGED 2026-11-19T05:52:57Z, 'fleet: retire the sold srv9 LAN endpoint, hold .236 as a dated observation on ken, and model the GPU read its retirement frees') retired the sold endpoint and holds .236 as a dated observation on ken's row at dag/gunbc/fleet/fleet_intent_network.dag:226. What is genuinely owed is the tailnet name pin and a host key confirmed from the unit's own console, both carried as read obligations and owned by tidy-pike-449.")),
      parent: in_project(project: "site-boot-and-management-edge", contribution: "The management edge keeps the fleet's memory truth: a charge the operator trimmed is a charge the model re-reads, and the capacity it frees is released by rule."),
      centering: plan(text: "new_server_bringup_plan: capacity the operator grants is only real once the model can see it, so the 56G trim had to be read into the model before the build seat it frees could be counted. Target: gunbc.serving.serving_host_memory::ken_strata_engine_memory, and the seat that the dissolved frontier used to hold."),
    ),
    roadmap_node(
      identity: "rn_7QKZ3XDV9WT2N5RYH6MCB8FP4",
      id: "mtcollins1-arrival-budget-grants",
      owner: "fleet",
      carriers: carrier(path: "dag/gunbc/ci/ci_budget_raise.dag"),
      line: ticket(t: updated(t: fields(
        headline: "mtcollins1's arrival budgets get admitted grants in ci_budget_raise",
        displaced_cost: "The arrival budgets are wired through ci_budget_raise's budget_admission, but nothing grants them: an arrival run either dies on a refusal nobody planned for, or a reader believes it is budget-admitted when no row ever admitted it.",
        boundary: "Add the grants the arrival legs need, in the shape the module already uses. Precedent to follow, from the same module a day ago: gunbc#16746 dropped the budget_admitted Bool and had the witness read the refusal by its arm -- grants are admitted by their arm, not by a flag.",
        first_slice: "The arrival-leg grants as BudgetRaiseGrant rows with their witnesses, RED against no grant and GREEN against the planted one.",
        red_control: "An arrival leg whose budget no grant admits is refused by arm, and the same leg passes with its grant planted.",
        out_of_scope: "Inventing a second budget path; the arrival run itself; any grant for a host outside this program.",
        handback: "Arrival legs whose minutes the authority itself admitted, in the module's own idiom."
      ), on: "2026-11-20", note: "Live read 2026-11-20 on the cited PRs: gunbc#16668 MERGED 2026-11-19T21:13:40Z (title 'bmc_cold_reset: a sustained-availability window after recovery; RecoveredThenLost (#16659)' -- it raised the cold-reset step's budget, and it added no grant for the arrival legs) and gunbc#16746 MERGED 2026-11-19T23:33:24Z (title 'ci_budget_raise: drop the budget_admitted Bool; the witness reads the refusal by its arm'). Verified in the module: dag/gunbc/ci/ci_budget_raise.dag carries exactly two BudgetRaiseGrant rows today -- the serve entry-verdict step at 45 minutes (:37) and mtcollins1's BMC cold-reset step at 67 minutes (:45) -- and nothing for the arrival legs, with budget_admission at :86 refusing by arm. This row was gated on bobo-arrival-converge-budget-fold, which is where those legs and their minutes are first declared; that pull request merged 2026-11-20T03:59:52Z, so the gate is open and this is the next dispatchable thing on the budget path.")),
      dispatch: dispatchable(),
      parent: in_project(project: "site-boot-and-management-edge", contribution: "The boot path's minutes are budget-admitted like every other raised budget, so an arrival run is planned rather than lucky."),
      centering: plan(text: "new_server_bringup_plan: mtcollins1 stays the site's boot host until its duties move, and while it does, its arrival legs must be budget-admitted rather than improvised. Target: dag/gunbc/ci/ci_budget_raise.dag and its budget_admission fold."),
    ),
    roadmap_node(
      identity: "rn_4ZQK7XJW2VT9N5RYH6MCB3FP8",
      id: "mtcollins1-runner-dispatch-collect-deregister",
      owner: "fleet",
      carriers: carrier(path: "dag/gunbc/runner/runner_slot_desired.dag"),
      line: ticket(t: updated(t: fields(
        headline: "mtcollins1's dispatch, collect and deregister legs need their design PR",
        displaced_cost: "Three legs of the runner lifecycle are named in the program and modeled nowhere: today they are performed by hand on a machine the site is trying to stop depending on, and no fold can say whether they happened.",
        boundary: "One design PR that puts the dispatch, collect and deregister legs where they belong: the desired-state folds at gunbc.runner.runner_slot_desired, the trust selection at gunbc.auth.authorization_pattern_selection, and fleet_revision_acceptance for what a completed leg owes. No code before the design lands.",
        first_slice: "The design PR: the three legs stated as desired state with their acceptance obligations, reviewed and merged; implementation follows as separate rows.",
        red_control: "A claimed runner leg with no desired-state row and no acceptance obligation behind it refuses; a planted leg with both passes.",
        out_of_scope: "The qualification leg (its own row); the fleet-converge mode question and the job-roster closure, which stay out until the design says otherwise; any runner-side execution.",
        handback: "A merged design the three legs can be implemented against, with the trust and acceptance seams named."
      ), on: "2026-11-20", note: "Two holds, both named: the S4 host key T1 (sleek-deer-601 -- branch session/sleek-deer-601-delivery4 exists at b24ac05b81b8 with no pull request open, read 2026-11-20) and this program's per-host trust policy row, operator-mtcollins1-per-host-trust-policy. Still owed inside the pairing: the HostEffectTransport pairing that gunbc#14738 opened (MERGED 2026-10-22T09:41:12Z, title 'Host-bound transport: join a HostEffectTransport to the managed host it reaches') -- its pairing is not complete -- and a read-only dry run of the lost-boot sweep against the real org runner listing, whose plan and run models exist at dag/gunbc/runner/runner_lost_boot_sweep_plan.dag and runner_lost_boot_sweep_run.dag.")),
      dispatch: dispatchable(),
      parent: in_project(project: "site-boot-and-management-edge", contribution: "The management edge covers a host's whole runner life: dispatch, collect and deregister are modeled, not remembered."),
      centering: plan(text: "new_server_bringup_plan: retiring mtcollins1's duties means each duty has a modeled home first; dispatch, collect and deregister do not yet. Target: dag/gunbc/runner/runner_slot_desired.dag with the trust selection at gunbc.auth.authorization_pattern_selection."),
    ),
    roadmap_node(
      identity: "rn_9DKZ2QVX7WT4N5RYH6MCB3FP8",
      id: "mtcollins1-first-qualification-run",
      owner: "fleet",
      carriers: carrier(path: "dag/gunbc/host/memory_envelope.dag"),
      line: ticket(t: updated(t: fields(
        headline: "mtcollins1's first qualification run, with its memory envelope and receipt",
        displaced_cost: "A boot host that also carries runner work without a qualified envelope is a machine the site cannot reason about: the memory envelope is what makes the two duties compatible instead of merely coexisting.",
        boundary: "Read mtcollins1's memory envelope, model it at gunbc.host.memory_envelope, and record one qualified run's receipt against the runner group the operator names. The run itself needs the GO, so it waits on the gate.",
        first_slice: "The envelope read live, its row, and a receipt for one qualification run against the named group.",
        red_control: "A qualification receipt that cites no envelope, or no runner group, refuses; the envelope's own reads refuse a receipt whose charge exceeds it.",
        out_of_scope: "Naming the group or giving the GO (the gate row); the dispatch/collect/deregister design (its own row); any live change to mtcollins1.",
        handback: "An envelope and a receipt, so the qualification leg is a fact the model holds."
      ), on: "2026-11-20", note: "Waits on operator-mtcollins1-runner-group-qualification-go, and on the trust policy for anything that runs without a per-run approval. No worker is assigned to this row or to any of the mtcollins1 boot rows: they come from merry-fox-82's wind-down, and recording them is what keeps them from being lost.")),
      dispatch: dispatchable(),
      parent: in_project(project: "site-boot-and-management-edge", contribution: "The management edge proves mtcollins1's runner work is charged and bounded, not incidental."),
      centering: plan(text: "new_server_bringup_plan: mtcollins1's duties retire only once each is modeled and qualified somewhere else; its runner qualification is one of them. Target: dag/gunbc/host/memory_envelope.dag and the receipt it supports."),
    ),
    roadmap_node(
      identity: "rn_3XKZ7QVD2WT9N5RYH6MCB4FP8",
      id: "mtcollins1-boot-later-work",
      owner: "fleet",
      carriers: carrier(path: "dag/gunbc/machine_intake/mtcollins1_boot_run.dag"),
      line: ticket(t: updated(t: fields(
        headline: "mtcollins1's boot path grows up: disk rows, then a boot-install-qualify repeat with no hand step",
        displaced_cost: "The boot path still needs a person between steps. Until disk rows exist and the sequence can repeat unattended, mtcollins1 is not a boot service, it is a person with a boot habit -- and every later row that claims its duties are retired is claiming it of a host that still cannot boot itself.",
        boundary: "Two things, in order. First the disk rows the boot path reads -- their PR is owed. Then the full sequence over PXE, diskless and disk-backed both: boot, install, qualify, and repeat with no hand step between them, which is the persistence axis the boot design named.",
        first_slice: "The disk-rows PR: the boot path reads its disks from modeled rows instead of hand-stated values.",
        red_control: "A boot run that claims persistence across a repeat with no modeled disk row refuses; the modeled rows pass, and a planted hand-stated value fails.",
        out_of_scope: "The host's runner legs; anything needing an operator GO (those are the gate rows); a second boot host.",
        handback: "A boot path that repeats unattended against modeled disks -- the precondition for retiring the duties it carries."
      ), on: "2026-11-20", note: "Live read 2026-11-20: the persistence axis comes from gunbc#15645 (MERGED 2026-11-02T06:58:33Z, title 'Boot design: delivery, persistence and role are independent axes (ruling + plan)' -- its P1 axis). This row is the later half of the boot program; the install lane's rows run in parallel with it.")),
      dispatch: dispatchable(),
      parent: in_project(project: "site-boot-and-management-edge", contribution: "The boot host becomes a service: repeatable, modeled, and no longer dependent on a hand between steps."),
      centering: plan(text: "new_server_bringup_plan: mtcollins1's boot duties retire only once the boot path can run itself. Target: dag/gunbc/machine_intake/mtcollins1_boot_run.dag and the disk rows it should read."),
    ),
    roadmap_node(
      identity: "rn_6ZQK2XWD9VT5N7RYH6MCB3FP8",
      id: "mtcollins1-boot-duty-retirement",
      owner: "fleet",
      carriers: carrier(path: "dag/gunbc/machine_intake/mtcollins1_boot_run.dag"),
      line: ticket(t: updated(t: fields(
        headline: "mtcollins1's boot duties are retired onto srv4, and the last consumer moves",
        displaced_cost: "Nothing today carries this. No row anywhere in the authority models retiring mtcollins1's boot duties -- the only records that existed were two closed pull requests. So the site runs a second, unwitnessed boot path with no plan for ending it, and nobody can say what still depends on it.",
        boundary: "Name every boot duty mtcollins1 still carries, name where each moves (the srv4 edge rows above, as transitions within the lifecycle gunbc.plans.fleet_machine_authority already models), move the consumers, and then delete the duties. Retirement is the last step and it is data: rows deleted, consumers repointed, the fleet's reading of the edge showing no gap.",
        first_slice: "The duty census: an enumerated list of what mtcollins1 still does at boot, each item with the row that replaces it or a named blocker.",
        red_control: "A duty that cannot name its replacement or its blocker refuses the retirement, so retirement cannot pass by forgetting a duty.",
        out_of_scope: "Anything that needs the operator's GO; the srv4 rows themselves (their own rows); the physical decommissioning of hardware -- duties, not machines.",
        handback: "A boot path with one home, and the fleet's reading of the boot and management edge showing srv4 where mtcollins1 was."
      ), on: "2026-11-20", note: "Verified 2026-11-20 against the authority: no row in dag/gunbc/roadmap/roadmap_authority.dag carried mtcollins1's boot retirement, and no plan under dag/gunbc/plans named it. Searched before adding, and the nearest existing models are linked rather than duplicated: gunbc.plans.fleet_machine_authority already governs the machine lifecycle as modeled transitions (retire and replace included, and its own bobo-lane line retires srv13's identity rows), and gunbc.plans.fleet_hardware_fact_consumption governs the GPU facts a hardware read produces -- neither says which of mtcollins1's boot duties moves to which srv4 row, which is the gap this row closes. Its prerequisites are the srv4 live-source row and the later-work row; the boot duties stay load-bearing until retirement is modeled; ken's 56G re-read landed on 2026-11-20 (gunbc#16763, ea751f86d6ff) and is recorded on ken's own row, and the trim it confirmed is the 2026-11-19 ruling gunbc.design_ruling::ken_strata_memory_trim_buys_two_build_seats_2026_11_19.")),
      dispatch: dispatchable(),
      parent: in_project(project: "site-boot-and-management-edge", contribution: "The program's closing claim: the boot and management edge lives on srv4 because every duty moved there in the model first."),
      centering: plan(text: "new_server_bringup_plan: the point of srv4 as the site's boot and management edge is that mtcollins1 stops being it. Target: dag/gunbc/machine_intake/mtcollins1_boot_run.dag, whose duties move onto the srv4 edge rows."),
    ),
    roadmap_node(
      identity: "rn_8QZK5XVD2WT9N4RYH6MCB3FP7",
      id: "bmc-nfs-share-server-through-endpoint-authority",
      owner: "fleet",
      carriers: carrier(path: "dag/gunbc/megarac_media_model.dag"),
      line: ticket(t: updated(t: fields(
        headline: "The BMC virtual-media share resolves its server through the fleet endpoint authority, not a pinned literal",
        displaced_cost: "The virtual-media share the boot path attaches carries 192.168.1.201 as a typed-in server string wherever it is built. Pin an address and the day the server moves, the boot path breaks somewhere no witness predicted.",
        boundary: "Resolve that server through the fleet endpoint authority the rest of the fleet already uses -- the pattern srv4's own TFTP server address follows at dag/gunbc/fleet/site_pxe_edge_converge.dag:824, read out of srv4's LAN endpoint row -- and keep the literal only as a dated observation. Finishing the shape the closed gunbc#15350 opened.",
        first_slice: "The MegaRacShare server resolved through the endpoint authority, with the pinned literal retired to a dated observation and a witness that refuses a share not resolved by authority.",
        red_control: "A share whose server does not resolve through the endpoint authority refuses by name; the literal-only form is the control's RED case.",
        out_of_scope: "Moving any server; the boot path's other consumers until they read the resolved address; the approval question gunbc#15287 raised, which the standing ruling settled.",
        handback: "A boot path whose share server is resolved, not remembered -- with the recommendation on the two closed PRs recorded where a reader will find it."
      ), on: "2026-11-20", note: "Verified 2026-11-20: MegaRacShare carries server/source_path/share_type at dag/gunbc/megarac_media_model.dag:34, and every place the server is spelled is a witness fixture pinning '192.168.1.201' (dag/test/claim/machine_intake/mtcollins1_boot_acceptance_matrix.dag:748 real_share, dag/test/claim/machine_intake/megarac_media_0_45_3_witness.dag:1122, dag/test/claim/bmc/megarac_csrf_header_argv_witness.dag:148); 201 is srv2's LAN address at dag/gunbc/fleet/fleet_intent_network.dag:86. The two closed pull requests this row disposes of, both read 2026-11-20: gunbc#15350 (BMC NFS share server_address through the fleet endpoint authority) is CLOSED, opened as a DRAFT, mergeable CONFLICTING / merge state DIRTY, last updated 2026-11-20T01:17:19Z, never merged -- its work is still owed, which is why this row exists. RECOMMENDATION: re-author from this row on current main rather than reopening, because the endpoint-authority pattern it wanted now has a working precedent (srv4's TFTP address, site_pxe_edge_converge.dag:824) and its tree no longer applies. gunbc#15287 (mtcollins1_boot approval-free from a trusted branch, gated on a reader-key mint) is CLOSED, not draft, mergeable CONFLICTING / DIRTY, last updated 2026-11-20T01:17:27Z, and SUPERSEDED rather than owed: the standing ruling at dag/gunbc/auth/privileged_effect_registry.dag:408 already grants the admitted boot modes with no per-run or standing approval (operator chat rulings 2026-09-23 and 2026-09-25, repeated at dag/gunbc/machine_intake/mtcollins1_boot_run.dag:3419), which is what the PR was trying to arrange. RECOMMENDATION: close as superseded by that ruling; if any residual approval is ever found in the boot path, it opens as a new row against today's code rather than as a reopening. Neither pull request was touched by this change.")),
      dispatch: dispatchable(),
      parent: in_project(project: "site-boot-and-management-edge", contribution: "The boot path stops depending on remembered addresses: the share server is resolved by the same authority that resolves every other endpoint."),
      centering: plan(text: "new_server_bringup_plan: the boot and management edge is a modeled path, and a path that pins an address in a parameter string is not modeled. Target: dag/gunbc/megarac_media_model.dag's share and the fleet endpoint authority it should read through."),
    ),
    roadmap_node(
      identity: "rn_1NT194C8SV6TFJS09ATH58RKPR",
      id: "install-target-designated-or-unformatted",
      owner: "fleet",
      carriers: carrier(path: "dag/gunbc/host/network_install.dag"),
      line: ticket(t: fields(
        headline: "The install writes its designated medium or an unformatted disk, chosen and checked inside the run, with no pre-install disk reading",
        boundary: "Realize gunbc.design_ruling::install_target_is_designated_or_unformatted_2026_11_24 in the one install route. Today gunbc.host.network_install admits an install only against a dated pre-install reading (gunbc.provisioning.install_target_disk admit_install_target_disk over gunbc.fleet.machine_target_disk_observations, inside a 30-day window) and a committed contents row (admit_target_disk_contents over network_install_ci network_install_disk_contents, empty today), and the only source of either is a hand-booted rescue medium. Two steps over the attempt's CURRENT device view, taken inside the attempt before its first storage write: first SELECT one eligible destination -- the designated medium when the model names one (a designation resolving to no device or several holds the attempt), else the unique eligible internal device (removable, recovery, virtual or unreadable media are never eligible; several eligible devices hold the attempt as ambiguous); then CLASSIFY that same device into the ruling's layer and apply the layer's policy to it -- raw and empty-table devices initialized automatically, a device carrying this unit's own unfinished attempt identity replaced automatically, a verified installation of this unit adopted with no write, and partitions with unrecognized contents, an unattributed partial install and every other layer left for a manual authorization naming the device, its layer and the attempt. The writer is handed that same device. The policy is rows keyed by layer in a new gunbc.provisioning module, replacing gunbc.host.network_install TargetDiskContents, a single content/no-content bit, rather than sitting beside it. Canonical documents that early-commands run before Subiquity probes block devices and that several matching disks may be chosen arbitrarily, and gunbc.provisioning.public_nocloud_seed admits neither early-commands nor reporting, so the selector is either a narrowly typed selector in the verified installer image or a deliberate extension of the seed contract, chosen here. The disk identity is recorded from the post-install readback. The pre-read admission, its window and its rows are deleted; the dangling citation gunbc.design_argument::install_authorization_pinpoints_one_target in network_install's header goes with it.",
        displaced_cost: "Every install today waits on a disk reading that only a person with a rescue USB can produce, so no install of a new unit can run unattended, and a reading older than its window silently withholds the next one.",
        first_slice: "Choose where the selector lives (installer-image selector or a widened seed contract) against Canonical's documented early-commands and storage-match behavior, and model that in extdeps.os.ubuntu_autoinstall; then the layer-policy module and the select-then-classify fold, with srv15's recorded 2026-10-29 USB-plus-NVMe reading as a fixture only -- the live selection always reads the attempt's own device view.",
        red_control: "OPEN: not yet measured. Three distinct claims, each over a device view handed to the select-then-classify fold. (a) Regression: a raw eligible NVMe -- which today's contents admission already admits when both readers and matching capture provenance are present -- is still initialized automatically. (b) The layer-policy change: an eligible NVMe with an empty GPT and no other signature is initialized automatically, where today's admission refuses it as carrying a partition table. (c) Removal of the operator pre-read: a fresh in-attempt device view with no pre-existing capture row admits the install, where today the dispatch refuses for want of the dated reading. Further cases: a table whose partitions carry no recognized filesystem ends manual with nothing written; this unit's own unfinished attempt identity is replaced automatically and the same partial install without a provable identity ends manual; over srv15's recorded USB-plus-NVMe view with no designation the USB drive is ineligible and the NVMe alone is selected.",
        out_of_scope: "Formatting a disk that carries content, which stays manual by the ruling; any change to the boot-once route; the edge's chain pins.",
        handback: "An install route that needs no pre-install reading and still erases nothing that was not designated or blank, with the selected disk's identity recorded after the fact."
      )),
      dispatch: dispatchable(),
      parent: in_project(project: "site-boot-and-management-edge", contribution: "Onboarding gap from the 2026-11-24 re-read of gunbc.plans.new_server_bringup section 2: a lifecycle stage that today needs a hand or a per-unit edit."),
      centering: plan(text: "new_server_bringup_plan: section 3's lifecycle admits a new unit by its rows alone. Target: dag/gunbc/host/network_install.dag."),
    ),
    roadmap_node(
      identity: "rn_091R4S8N1SEEZATJ83Q9VD3B0W",
      id: "boot-once-one-judgment",
      owner: "fleet",
      carriers: carrier(path: "dag/gunbc/machine_intake/oob_boot_handoff.dag"),
      line: ticket(t: fields(
        headline: "One judgment gates a one-shot boot, whatever protocol carries it",
        boundary: "Two modules judge the same one-shot boot: gunbc.host.managed_host_boot_once (Redfish BootSourceOverride, model only) and gunbc.machine_intake.oob_boot_handoff (IPMI parameter 5, live). Consolidate to one judgment of a one-shot UEFI network or media boot -- setting, readback verdict, power gate -- with the protocol a realization of it, and delete the other. The existing integration concern managed_host_boot_once_and_oob_boot_handoff_gate_the_same_boot_once is this row's finding.",
        displaced_cost: "Two judgments of one boot drift: a rule tightened in one (EFI only, once only, readback before power) is absent from the other, and the Redfish arm cannot be built without choosing which one it inherits.",
        first_slice: "Name the one judgment's carrier and move the IPMI route onto it with no change in what it admits; delete the second judgment's duplicate checks.",
        red_control: "OPEN: not yet measured. The pair to execute: a boot setting that reads back persistent or legacy refuses through the one judgment for both protocols (red today for the Redfish arm, which has no executing route); the IPMI route's existing one-shot EFI readback still passes.",
        out_of_scope: "Building the Redfish write route (its own row); persistent boot-order reading.",
        handback: "One authority for what makes a one-shot boot safe to power, with each protocol a realization of it."
      )),
      dispatch: dispatchable(),
      parent: in_project(project: "site-boot-and-management-edge", contribution: "Onboarding gap from the 2026-11-24 re-read of gunbc.plans.new_server_bringup section 2: a lifecycle stage that today needs a hand or a per-unit edit."),
      centering: plan(text: "new_server_bringup_plan: section 3's lifecycle admits a new unit by its rows alone. Target: dag/gunbc/machine_intake/oob_boot_handoff.dag."),
    ),
    roadmap_node(
      identity: "rn_H09VMW4TGD03QD3TP2287HD4NR",
      id: "redfish-boot-once-live-route",
      owner: "fleet",
      carriers: carrier(path: "dag/gunbc/host/managed_host_boot_once.dag"),
      line: ticket(t: fields(
        headline: "A Redfish controller can be made to boot from the network once, live",
        boundary: "Give the Redfish one-shot override an executing route: PATCH the ComputerSystem Boot object to BootSourceOverrideEnabled Once, Mode UEFI, Target Pxe, read it back (extdeps.bmc.redfish_boot_override already parses the reading), and reset only on a readback the one boot judgment admits. A writer alone does not make a Redfish controller drivable: the allowed values the service advertises, firmware behavior, which NIC the firmware then boots and available power control each matter, and some services refuse behind a license (H11SSL-i unit 2's root returned a license refusal). The route is admitted per controller release by an observed write, and the boot is proven by the unit's own request reaching the edge from the intended NIC, since ken's forced PXE selects LAN1 while its install booted LAN2.",
        displaced_cost: "Every Redfish-only controller is excluded from the lifecycle at the boot-source stage, and its install falls back to virtual media or hands.",
        first_slice: "The request shape and its readback against the dry controller (gunbc.bmc_dry_realization), then one live run on a unit whose capability row records the write.",
        red_control: "OPEN: not yet measured. The pair to execute: a one-shot PXE boot of a Redfish controller whose capability row records the override refuses today with no executing route, and passes once the route exists; a readback that says Continuous refuses the reset.",
        out_of_scope: "Persistent boot order; virtual media; any controller without an observed override write in its capability row.",
        handback: "Redfish controllers on the same PXE path as IPMI ones."
      )),
      dispatch: dispatchable(),
      parent: in_project(project: "site-boot-and-management-edge", contribution: "Onboarding gap from the 2026-11-24 re-read of gunbc.plans.new_server_bringup section 2: a lifecycle stage that today needs a hand or a per-unit edit."),
      centering: plan(text: "new_server_bringup_plan: section 3's lifecycle admits a new unit by its rows alone. Target: dag/gunbc/host/managed_host_boot_once.dag."),
    ),
    roadmap_node(
      identity: "rn_TJJTQDB0ZBTD1G7R1GTYXGDCZK",
      id: "bmc-generic-protocol-family",
      owner: "fleet",
      carriers: carrier(path: "dag/gunbc/machine_intake/bmc_firmware_family_discriminator.dag"),
      line: ticket(t: fields(
        headline: "An unrecognized controller is read through generic IPMI and Redfish before any vendor family exists for it",
        boundary: "gunbc.machine_intake.bmc_firmware_family_discriminator recognizes OpenBMC, MegaRAC and Supermicro and stops anything else at FamilyUnobserved, so a new vendor needs a firmware family, dispatch arms, OEM keys, a capture binding, a prior-life policy, a board catalog and live archive paths before its first read. Admit a controller that answers standard IPMI or DMTF Redfish to the generic reads those protocols define, so the vendor-specific work is driven by what the generic reads could not establish rather than required up front.",
        displaced_cost: "Each new vendor costs eight to ten module edits before the model can even read it, so the first contact with new hardware is done by hand.",
        first_slice: "List which arrival reads depend on a vendor family and which only on the protocol; route an unrecognized controller to the protocol-only reads with the rest refused by name.",
        red_control: "OPEN: not yet measured. The pair to execute: a recorded Redfish service root and Manager capture with an unknown OEM key refuses at family discrimination today, and reaches identity binding through the generic reads afterwards; a known family is unchanged.",
        out_of_scope: "Writing to an unrecognized controller (securing it still needs an observed route); vendor fan or firmware features.",
        handback: "A new controller family readable on day one, with its vendor work named by the reads that refused."
      )),
      dispatch: dispatchable(),
      parent: in_project(project: "site-boot-and-management-edge", contribution: "Onboarding gap from the 2026-11-24 re-read of gunbc.plans.new_server_bringup section 2: a lifecycle stage that today needs a hand or a per-unit edit."),
      centering: plan(text: "new_server_bringup_plan: section 3's lifecycle admits a new unit by its rows alone. Target: dag/gunbc/machine_intake/bmc_firmware_family_discriminator.dag."),
    ),
    roadmap_node(
      identity: "rn_EV6WV1FRRBKJPYQG7J8ZH0E5ZK",
      id: "bmc-located-from-site-network",
      owner: "fleet",
      carriers: carrier(path: "dag/gunbc/fleet/fleet_intent.dag"),
      line: ticket(t: fields(
        headline: "A new controller's address is an observation of the site network, not a transcribed literal",
        boundary: "Every BMC address in the model (gunbc.fleet.fleet_intent baseboard rows, gunbc.machine_intake.mtjade1_factory_network) was copied from a router page, a capture or an operator. Make a controller's address a dated observation bound to its MAC: a DHCP lease or neighbour-table reading from a host the fleet already reaches, or, for a controller that arrives statically configured with no lease (mtjade1 did), the observed management link reconciled to the site network.",
        displaced_cost: "Each new unit starts with someone finding its address by hand and typing it into a row, and a lease that moves is a silently wrong row.",
        first_slice: "Name the lease source the site actually has (the router's DHCP or srv4's dnsmasq) and the reading's shape; read it once for an existing controller and compare with its committed row.",
        red_control: "OPEN: not yet measured. The pair to execute: a controller row whose address disagrees with the lease reading for its MAC refuses; the agreeing row passes.",
        out_of_scope: "Changing the site's DHCP service; reserving addresses.",
        handback: "Controllers located by the model from the network they are on."
      )),
      dispatch: dispatchable(),
      parent: in_project(project: "site-boot-and-management-edge", contribution: "Onboarding gap from the 2026-11-24 re-read of gunbc.plans.new_server_bringup section 2: a lifecycle stage that today needs a hand or a per-unit edit."),
      centering: plan(text: "new_server_bringup_plan: section 3's lifecycle admits a new unit by its rows alone. Target: dag/gunbc/fleet/fleet_intent.dag."),
    ),
    roadmap_node(
      identity: "rn_JHBTDPPE3R1MRYTCV0BMRHPBMD",
      id: "bmc-secure-live-rotation",
      owner: "fleet",
      carriers: carrier(path: "dag/gunbc/machine_intake/arrival_converge.dag"),
      line: ticket(t: fields(
        headline: "Securing a controller runs live: the factory credential is rotated into custody by the model",
        boundary: "gunbc.machine_intake.arrival_converge bmc_secure models the rotation, with its live read, live write and route qualification still declared frontiers (gunbc.machine_intake.bmc_secure bmc_secure_state_live_apply_frontier, gunbc.machine_intake.bmc_rotation_route route_qualification_live_frontier, gunbc.machine_intake.arrival_converge forced_first_rotation_apply_frontier), and the live arrival run does not reach it. Every rotation and recovery so far was performed by hand. Give it an executing route for the families the lifecycle supports, under the per-write approval.",
        displaced_cost: "Securing a new controller is the largest manual stage left in the lifecycle, and its custody is whatever the person who did it recorded.",
        first_slice: "One live rotation on the next arriving unit of a supported family, its receipt recorded, with the forced-change arm exercised where the firmware forces one.",
        red_control: "OPEN: not yet measured. The pair to execute: a rotation whose post-write login with the new credential fails refuses and records the controller as not secured; the succeeding rotation records custody.",
        out_of_scope: "Recovering a controller whose credential is unknown (gunbc.machine_intake.bmc_recovery_route); creating cloud identities, which stay operator-dispatched.",
        handback: "A controller secured by the model, with its credential in custody from the first write."
      )),
      dispatch: dispatchable(),
      parent: in_project(project: "site-boot-and-management-edge", contribution: "Onboarding gap from the 2026-11-24 re-read of gunbc.plans.new_server_bringup section 2: a lifecycle stage that today needs a hand or a per-unit edit."),
      centering: plan(text: "new_server_bringup_plan: section 3's lifecycle admits a new unit by its rows alone. Target: dag/gunbc/machine_intake/arrival_converge.dag."),
    ),
    roadmap_node(
      identity: "rn_SNK7NNRMGFRQBN5P25JEN5XYA4",
      id: "boot-nic-from-observation",
      owner: "fleet",
      carriers: carrier(path: "dag/gunbc/host/network_install.dag"),
      line: ticket(t: fields(
        headline: "The install client's boot NIC is read, not transcribed",
        boundary: "gunbc.host.network_install network_install_client_bindings holds one hand-entered row (srv15's MAC from a rescue capture). Derive the boot NIC from the controller's Redfish EthernetInterfaces and BootOptions (extdeps.bmc.redfish_network_boot) or from the DHCP request the edge observes (gunbc.fleet.site_pxe_edge_client_requests), refusing an ambiguous reading as the table does today.",
        displaced_cost: "Each new unit needs someone to find and type the MAC its firmware netboots from, and a wrong MAC is an install file served to nobody.",
        first_slice: "Read the boot NIC for srv15 from its controller's capture and compare it with the committed row.",
        red_control: "OPEN: not yet measured. The pair to execute: a binding whose MAC disagrees with the controller's reading refuses; two candidate NICs with no boot-option evidence refuse as ambiguous.",
        out_of_scope: "Choosing among NICs by policy; the edge's chain pins.",
        handback: "A unit's install client known from its own readings."
      )),
      dispatch: dispatchable(),
      parent: in_project(project: "site-boot-and-management-edge", contribution: "Onboarding gap from the 2026-11-24 re-read of gunbc.plans.new_server_bringup section 2: a lifecycle stage that today needs a hand or a per-unit edit."),
      centering: plan(text: "new_server_bringup_plan: section 3's lifecycle admits a new unit by its rows alone. Target: dag/gunbc/host/network_install.dag."),
    ),
    roadmap_node(
      identity: "rn_4ND5RG06R5ZWT5RXQBD7KBK6KX",
      id: "install-method-selection-consumed",
      owner: "fleet",
      carriers: carrier(path: "dag/gunbc/provisioning/provisioning_arm.dag"),
      line: ticket(t: fields(
        headline: "The install route asks the modeled install-method selection instead of assuming PXE",
        boundary: "The lifecycle's install-method stage is modeled (gunbc.provisioning.provisioning_arm, gunbc.provisioning.network_boot_actuation, gunbc.fleet.fleet_boot_delivery_solution) and gunbc.host.network_install never consults it, so the decision exists without a consumer and the install route hard-codes its answer. Make the install consume the selection, with a refusal naming the missing capability when PXE is not available, and delete whatever of the selection model no consumer needs.",
        displaced_cost: "A decision nobody reads is either dead or a second authority waiting to disagree with the route that actually runs.",
        first_slice: "Read which of the three modules carries the decision the route needs, and wire the dispatch admission to it.",
        red_control: "OPEN: not yet measured. The pair to execute: a unit whose architecture or controller does not admit PXE refuses at the install-method stage with that capability named, rather than at the boot write; a PXE-capable unit passes.",
        out_of_scope: "Building the virtual-media fallback route.",
        handback: "One install-method decision, consumed by the route that installs."
      )),
      dispatch: dispatchable(),
      parent: in_project(project: "site-boot-and-management-edge", contribution: "Onboarding gap from the 2026-11-24 re-read of gunbc.plans.new_server_bringup section 2: a lifecycle stage that today needs a hand or a per-unit edit."),
      centering: plan(text: "new_server_bringup_plan: section 3's lifecycle admits a new unit by its rows alone. Target: dag/gunbc/provisioning/provisioning_arm.dag."),
    ),
    roadmap_node(
      identity: "rn_4XGA06H95F3F6ZPBBH2Y5QN2ZV",
      id: "fleet-admission-hand-lists-fold",
      owner: "fleet",
      carriers: carrier(path: "dag/gunbc/fleet/fleet_intent.dag"),
      line: ticket(t: fields(
        headline: "A newly installed unit joins the fleet through its enrollment row, not by being added to hand lists",
        boundary: "The roster lists keyed by HostIdentity are gunbc.plans.fleet_machine_authority's (operator_hosts, hostname allocations, enrollments, machine_board_rows, runner_host_spec_rows as separate facts keyed by the handle); this row takes only the two lists that intention does not name and that the lifecycle still makes a new unit join by hand: gunbc.fleet.fleet_intent fleet_intent_known_hosts, the health population (also read by gunbc.plans.host_thermal_operating_point), and the per-unit arrival credential modules (gunbc.auth.srv15_arrival_federation_provision, gunbc.auth.srv15_bmc_secret_versions_receipt). Derive the first from enrollment and fold the second into rows of one generic module.",
        displaced_cost: "Every unit added to the fleet is another round of the same edits in several files, and a unit forgotten in one list is silently absent from health checks or capacity.",
        first_slice: "Replace fleet_intent_known_hosts with a fold over enrollment and confirm the health goals for srv1-srv4 and srv14 are unchanged.",
        red_control: "OPEN: not yet measured. The pair to execute: an enrolled unit missing from the health population is caught by a comparison against the enrollment fold (red today for H11SSL-i unit 3); the fold-derived population passes.",
        out_of_scope: "Everything gunbc.plans.fleet_machine_authority owns, runner_host_spec_rows included; dan (operator_host_6ce85c) having no enrollment row, which a fold over enrollment alone would hide and which is that intention's to record; the fan model's board coverage; the reach-policy flips that need live reads.",
        handback: "Fleet membership with one source: the enrollment row."
      )),
      dispatch: dispatchable(),
      parent: in_project(project: "site-boot-and-management-edge", contribution: "Onboarding gap from the 2026-11-24 re-read of gunbc.plans.new_server_bringup section 2: a lifecycle stage that today needs a hand or a per-unit edit."),
      centering: plan(text: "new_server_bringup_plan: section 3's lifecycle admits a new unit by its rows alone. Target: dag/gunbc/fleet/fleet_intent.dag."),
    ),
    roadmap_node(
      identity: "rn_F0M12T7WH06NPMVDEK20Q529WP",
      id: "install-refusal-through-generated-workflow",
      owner: "fleet",
      carriers: carrier(path: "dag/gunbc/host/network_install_ci.dag"),
      line: ticket(t: fields(
        headline: "A refused network install reaches the operator through the generated workflow, with its receipt",
        boundary: "The entry writes network-install-ci-receipt.txt (gunbc.host.network_install_ci network_install_ci_receipt_path) while the generated fleet-converge step reads and uploads target/managed-host-network-install-receipt.txt, so even a routine refusal can leave the operator nothing. The tabletop review of 2026-11-24 also reports that the step passes none of the token inputs the managed credential reader accepts (gunbc.auth.access_token_source) and that the credential is read before the missing-input report is written. Make one receipt path the authority for both, make the refusal report precede every effectful read, and prove it with a dispatch for a deliberately ineligible subject.",
        displaced_cost: "Without this the first live attempt can fail with no explanation, and the cheapest test of the whole wiring -- a harmless refusal -- cannot be run.",
        first_slice: "Dispatch the network install for a deliberately ineligible subject through the generated workflow and retrieve whatever it leaves; fix what that run shows.",
        red_control: "OPEN: not yet measured. The pair to execute: a dispatch for an ineligible subject today uploads no receipt (red); after the change it uploads one naming executor, subject and reason, and the edge and controller are unchanged.",
        out_of_scope: "Any change to what the install admits; the eligible non-actuating preflight (install-eligible-preflight).",
        handback: "A refusal the operator can read, from the real generated workflow, before any hardware is at stake."
      )),
      dispatch: dispatchable(),
      parent: in_project(project: "site-boot-and-management-edge", contribution: "Install-route blocker from the 2026-11-24 tabletop recorded in gunbc.plans.new_server_bringup section 2: the route cannot complete an install of a new unit until this holds."),
      centering: plan(text: "new_server_bringup_plan: section 3's lifecycle installs, adopts or holds a unit through one attempt whose stages connect. Target: dag/gunbc/host/network_install_ci.dag."),
    ),
    roadmap_node(
      identity: "rn_WXZ0HAWR8BNBG5N2719335TVWS",
      id: "install-subject-owns-secured-controller",
      owner: "fleet",
      carriers: carrier(path: "dag/gunbc/host/install_boot_subject.dag"),
      line: ticket(t: fields(
        headline: "A new unit can be admitted to install: the arrival owns its secured-controller evidence",
        boundary: "The install resolver obtains secured-controller evidence only through a managed-host row (gunbc.host.network_install_ci network_install_ci_managed_row over managed_host_binding_for), and the install subject gate refuses a unit that is a managed host (gunbc.host.install_boot_subject admit_install_boot_subject through admit_arrival_subject_in over managed_hosts()); both read gunbc.host.managed_host managed_host_memberships, so no real population satisfies both. The arrival must own, or reference, the secured-controller evidence before the unit enters managed membership, keeping the refusal for managed hosts. The per-write approval the controller row demands (gunbc.machine_intake.bmc_write_controller) must also reach the boot call for this attempt and operation; capability, credential and approval stay three separate admissions.",
        displaced_cost: "As written, the install route can never admit the unit it was built for: srv15 is refused either as unmanaged or as managed.",
        first_slice: "Move the secured-controller evidence the resolver reads onto the arrival subject, with a witness over a population holding one arrival unit and one managed host.",
        red_control: "OPEN: not yet measured. The pair to execute: an arrival unit with secured-controller evidence and no managed row is refused today (red) and admitted after; a managed host is refused before and after.",
        out_of_scope: "Building the live BMC securing route (bmc-secure-live-rotation).",
        handback: "An install subject that a real row population can satisfy."
      )),
      dispatch: dispatchable(),
      parent: in_project(project: "site-boot-and-management-edge", contribution: "Install-route blocker from the 2026-11-24 tabletop recorded in gunbc.plans.new_server_bringup section 2: the route cannot complete an install of a new unit until this holds."),
      centering: plan(text: "new_server_bringup_plan: section 3's lifecycle installs, adopts or holds a unit through one attempt whose stages connect. Target: dag/gunbc/host/install_boot_subject.dag."),
    ),
    roadmap_node(
      identity: "rn_KRAXW9NKAVP7TTPRJPZF9MDFZB",
      id: "install-chain-selected-by-content",
      owner: "fleet",
      carriers: carrier(path: "dag/gunbc/host/network_install_ci.dag"),
      line: ticket(t: fields(
        headline: "The installer chooses its boot chain by what the chain can install, using the edge's own answer",
        boundary: "The installer accepts only a chain pinned for InstallBoundClients (gunbc.host.network_install_ci network_install_ci_chain), while the x86_64 Ubuntu chain is pinned for EveryKnownClient because its GRUB checks for a per-MAC install config and otherwise exits (gunbc.fleet.site_pxe_edge_converge). The edge already decides whether a chain is install-capable from its kernel, initrd and image; the installer answers the same question independently by audience label, and the two disagree on x86_64. Delete the installer's answer and consume the edge's. The missing arm64 default chainloader is a separate matter.",
        displaced_cost: "Every x86_64 unit is refused for want of an install chain that exists on srv4 and installed ken.",
        first_slice: "Point network_install_ci_chain at the edge's install-capable selection and add an x86_64 case beside the arm64 one.",
        red_control: "OPEN: not yet measured. The pair to execute: an x86_64 install request finds no chain today (red) and finds the pinned Ubuntu shim/GRUB chain after; an arm64 request selects the same chain before and after.",
        out_of_scope: "Placing snponly.efi on srv4; Secure Boot.",
        handback: "One answer to which chain installs, owned by the edge."
      )),
      dispatch: dispatchable(),
      parent: in_project(project: "site-boot-and-management-edge", contribution: "Install-route blocker from the 2026-11-24 tabletop recorded in gunbc.plans.new_server_bringup section 2: the route cannot complete an install of a new unit until this holds."),
      centering: plan(text: "new_server_bringup_plan: section 3's lifecycle installs, adopts or holds a unit through one attempt whose stages connect. Target: dag/gunbc/host/network_install_ci.dag."),
    ),
    roadmap_node(
      identity: "rn_GSX3KQEBNY5040JDVNNT53A26Q",
      id: "install-attempt-observed-and-resumable",
      owner: "fleet",
      carriers: carrier(path: "dag/gunbc/host/network_install_host_reader.dag"),
      line: ticket(t: fields(
        headline: "An install is one attempt with an identity, observed while it runs and resumable after an interruption",
        boundary: "Today one installed-host reading is taken right after the boot write, the reader leaves the DHCP client class Unread, the fetches empty and Secure Boot Unobserved and stamps observed_at with decided_at (gunbc.host.network_install_host_reader), and the receipt requires those readings inside the attempt window (gunbc.provisioning.network_install_receipt), so a successful physical install cannot close. The seed's instance id derives from the MAC, so two attempts on one unit are indistinguishable. Carry one attempt identity through the installer's result, the installed root, the first-boot host key and the edge withdrawal; let the attempt stay in progress while the installer runs, collect evidence from the edge and the host, resume from another executor, and leave a lost report or SSH timeout unresolved rather than failed. First SSH trust is scoped to the attempt -- the repository already models a host key announced over the console for one install (gunbc.fleet.fleet_host_key_enrollment) -- and becomes durable enrollment only once root and attempt agree.",
        displaced_cost: "The install route cannot report success for an install that worked, and a crash after the disk is written leaves a unit that looks uninstalled and invites a second storage write.",
        first_slice: "Give the receipt an attempt identity and an in-progress standing, and replace the zero-length observation window with readings taken when the evidence exists.",
        red_control: "OPEN: not yet measured. The pair to execute: a recorded successful install whose root and installer record postdate the dispatch by minutes fails to close today (red) and closes after; the same evidence under another attempt's identity does not close this one.",
        out_of_scope: "Edge concurrency (install-holds-one-store-and-edge-reconciles-attempts).",
        handback: "An install whose outcome is established from its own evidence, including after an interruption."
      )),
      dispatch: dispatchable(),
      parent: in_project(project: "site-boot-and-management-edge", contribution: "Install-route blocker from the 2026-11-24 tabletop recorded in gunbc.plans.new_server_bringup section 2: the route cannot complete an install of a new unit until this holds."),
      centering: plan(text: "new_server_bringup_plan: section 3's lifecycle installs, adopts or holds a unit through one attempt whose stages connect. Target: dag/gunbc/host/network_install_host_reader.dag."),
    ),
    roadmap_node(
      identity: "rn_6Z95K94JKGXGDR6EFN1VX6TWW6",
      id: "install-holds-one-store-and-edge-reconciles-attempts",
      owner: "fleet",
      carriers: carrier(path: "dag/gunbc/host/network_install_store.dag"),
      line: ticket(t: fields(
        headline: "One physical unit has one hold, installs are serialized at the edge, and recovery establishes what an orphaned installer did",
        boundary: "Arrival takes its unit hold under unit-holds on its store host (gunbc.machine_intake.arrival_run) and the install takes the same slot spelling under its own network-install directory (gunbc.host.network_install_store), so equal keys in two stores exclude nothing; the completion journal is read before the hold is acquired, so a dispatch can act on a stale empty reading. The first cut: one hold per unit in one store, the journal read under the hold, and installs serialized at srv4's edge for an attempt's whole lifetime, so a second attempt waits while the first owns the edge. Recovery is the part a released lock cannot answer: a physical installer that already fetched its seed can still be writing after its GitHub job dies, so a replacement executor must establish what the earlier attempt's installer did and whether it can still write -- by fencing the unit through its controller (power read and off) or by an observed installer end -- before it arms a successor. The install's holder is not an arrival holder, so gunbc#16916's arrival-hold recovery does not cover it. Several simultaneously active offers are later work (edge-concurrent-install-offers).",
        displaced_cost: "Two executors can drive one machine, or one machine's withdrawal can remove another's installer, and the conflict is noticed only after the disk is written.",
        first_slice: "Put arrival and install holds in one store under one key, move the journal read under the hold, take an edge-wide install lock, and give recovery a fence-then-read step.",
        red_control: "OPEN: not yet measured. The cases to execute: an arrival hold and an install hold on the same unit both succeed today (red) and the second refuses after; attempt B waits while attempt A owns the edge; a replacement executor after A's job dies arms no successor until A's unit is fenced or its installer's end is observed; and a crash after partition creation but before the attempt marker is durable is classified, on resume, as an unattributed partial install (manual), not as this unit's resumable attempt.",
        out_of_scope: "Simultaneously active offers at the edge (edge-concurrent-install-offers); arrival-hold recovery (gunbc#16916).",
        handback: "Mutual exclusion that holds across stores and executors, serialized installs at the edge, and recovery that never arms a successor while an orphaned installer can still write."
      )),
      dispatch: dispatchable(),
      parent: in_project(project: "site-boot-and-management-edge", contribution: "Install-route blocker from the 2026-11-24 tabletop recorded in gunbc.plans.new_server_bringup section 2: the route cannot complete an install of a new unit until this holds."),
      centering: plan(text: "new_server_bringup_plan: section 3's lifecycle installs, adopts or holds a unit through one attempt whose stages connect. Target: dag/gunbc/host/network_install_store.dag."),
    ),
    roadmap_node(
      identity: "rn_3XQYXCQT62WYZG33M714693307",
      id: "install-adoption-of-installed-units",
      owner: "fleet",
      carriers: carrier(path: "dag/gunbc/host/network_install.dag"),
      line: ticket(t: fields(
        headline: "An already-installed unit is adopted, not reinstalled",
        boundary: "Upsert means a unit whose current installed root is verifiably the fleet's is adopted or verified with no storage write, and a historical completion whose current root cannot be verified is reported as unverified. ken (H11SSL-i unit 3, hand-installed over srv4's edge) is the first case: its enrollment describes a manual PXE install but constructs provisioning_over_bmc_via_virtual_media(), its board serial is unread, and its LAN address was reused from a sold Spark. Prove boot port, identity, delivery and authenticated first contact separately, then run its first workload on an executor of its architecture (gunbc#16815 addresses the arm64-only executor label).",
        displaced_cost: "Without an adoption route a working unit can only join by hand-written rows, or by a reinstall it does not need.",
        first_slice: "Model adoption as a delivery selection with its own evidence, and correct ken's provisioning provenance to what happened.",
        red_control: "OPEN: not yet measured. The pair to execute: ken's enrollment row claims virtual-media provisioning today (red against its intake observation) and claims the observed manual PXE install after; an adoption whose root reads a foreign machine-id refuses.",
        out_of_scope: "Reinstalling ken; the arm64 executor label (gunbc#16815).",
        handback: "Hand-installed units brought under the lifecycle without being reinstalled."
      )),
      dispatch: dispatchable(),
      parent: in_project(project: "site-boot-and-management-edge", contribution: "Install-route blocker from the 2026-11-24 tabletop recorded in gunbc.plans.new_server_bringup section 2: the route cannot complete an install of a new unit until this holds."),
      centering: plan(text: "new_server_bringup_plan: section 3's lifecycle installs, adopts or holds a unit through one attempt whose stages connect. Target: dag/gunbc/host/network_install.dag."),
    ),
    roadmap_node(
      identity: "rn_Y3BMMSTGKW82D3TR963TAPD3T7",
      id: "bobo-onboarding-end-to-end",
      owner: "fleet",
      carriers: carrier(path: "dag/gunbc/plans/new_server_bringup.dag"),
      line: ticket(t: fields(
        headline: "bobo (srv15) is onboarded end to end by the workflow alone: arrival, fresh install, first CI job",
        boundary: "The first milestone of gunbc.plans.new_server_bringup, requested by the operator on 2026-11-24 for one existing machine other than srv1-srv4. One run of the lifecycle on srv15 with no hand step between dispatch and the first workload: the arrival admits it outside managed membership with its controller secured; the install drives its OpenBMC 3.22.00 controller through an evidenced route and boots it once over the arm64 install chain under its per-write approval; inside the attempt the destination is selected and classified by the layer policy over its current device view; the attempt is observed to completion and its offer withdrawn; first SSH trust is scoped to the attempt; and a CI job's build executes on srv15 through the remote-build bridge (srv15 is an executor, never the GitHub runner). This node owns the composed run and the fixes it surfaces; each stage's own change is its prerequisite row.",
        displaced_cost: "Until one machine has gone through every stage in one run, each stage is green only in isolation, and the first real onboarding would discover the seams on hardware. Every later unit is cheaper once one has crossed.",
        first_slice: "Once the prerequisites land: a refusal dispatch for srv15 through the generated workflow with the operator's GO withheld, its receipt read, then the live dispatch with the GO.",
        red_control: "OPEN: not yet measured. The run to execute is the plan's bobo acceptance: today a dispatch for srv15 cannot be admitted (red: the install subject requires a managed row and refuses managed hosts); the milestone passes when one dispatch on main leaves srv15 booting its selected NVMe with the offer withdrawn and answering SSH with the fleet key, a CI job's build is recorded as executed on srv15 with its reservation released (bobo-first-remote-build-executed), and a second dispatch through bring-up's entry returns srv15's verified identity and installed root with no write (bringup-entry-verifies-managed-unit).",
        out_of_scope: "Any other unit; the x86_64 chain selection and adoption of hand-installed units (ken), which are the next milestone's; Redfish boot control; BMC discovery; securing a controller from factory state, since srv15's credential is already in custody.",
        handback: "One existing machine onboarded by the workflow alone, with the run's receipts, and the list of seams the run surfaced."
      )),
      dispatch: dispatchable(),
      parent: in_project(project: "site-boot-and-management-edge", contribution: "The lane's first end-to-end milestone: one existing unit onboarded by the workflow with no hand step."),
      centering: plan(text: "new_server_bringup_plan: the lifecycle of section 3 is proven by one composed run on one existing unit before it is generalized. Target: srv15 (bobo)."),
    ),
    roadmap_node(
      identity: "rn_EY6Q4TZRAWEW34WQZ53SG5ST4P",
      id: "bobo-openbmc-boot-power-route-admitted",
      owner: "fleet",
      carriers: carrier(path: "dag/gunbc/host/network_install_ci.dag"),
      line: ticket(t: fields(
        headline: "srv15's OpenBMC 3.22.00 controller resolves through the production selector to an evidenced boot-and-power route",
        boundary: "srv15's committed manager capture identifies OpenBMC firmware 3.22.00, and the install's capability lookup (gunbc.host.network_install_ci network_install_ci_capability_row) asks host_capability_row over megarac_operation_evidence() and accepts only MegaRacReleaseCapabilityKnown; gunbc.host.bmc_release_capability_catalog covers MegaRAC only. Done when srv15's observed release resolves through the production selector -- generalized past MegaRAC evidence, not a srv15 branch -- to a capability row whose boot-source override and power control are each backed by an observed write on that release, and the route the row admits is the one the install drives. Not the generic Redfish program: only what this release needs.",
        displaced_cost: "Without it srv15 is refused at the capability lookup however every other prerequisite stands, and the firmware reading scheduled before the dispatch would not change that.",
        first_slice: "Make the capability lookup family-dispatched over the controller's observed family; then record srv15's release row from one observed one-shot override write with readback, and one authorized power transition (the action the install issues) with attributable readback of the resulting power state -- a power read alone does not establish the power operation.",
        red_control: "OPEN: not yet measured. The cases to execute: the install's capability lookup for srv15 answers Absent today (red: MegaRAC-only evidence); a 3.22.00 row whose boot-override write and power read are observed but whose power transition has never been observed leaves the power operation unavailable and the install refused; with the transition observed and read back the row resolves; a release with no observed write answers Absent.",
        out_of_scope: "Redfish boot control for other controllers (redfish-boot-once-live-route); a generic family fallback.",
        handback: "srv15's controller drivable by the install through an evidenced route."
      )),
      dispatch: dispatchable(),
      parent: in_project(project: "site-boot-and-management-edge", contribution: "The controller route srv15's install actually needs, distinct from the firmware reading."),
      centering: plan(text: "new_server_bringup_plan: an install drives a controller only through a route evidenced for that controller's release. Target: dag/gunbc/host/network_install_ci.dag and gunbc.host.bmc_release_capability_catalog."),
    ),
    roadmap_node(
      identity: "rn_KHT3X66AMAFD1Q4FKTSYC125CW",
      id: "install-eligible-preflight",
      owner: "fleet",
      carriers: carrier(path: "dag/gunbc/host/network_install_ci.dag"),
      line: ticket(t: fields(
        headline: "An eligible install dispatch reaches credential and approval resolution without actuating anything",
        boundary: "Beside the ineligible-subject refusal (install-refusal-through-generated-workflow), an eligible dispatch through the generated workflow runs as far as the controller credential and the per-write approval and stops before any edge, boot or power effect. It proves the generated step passes the scoped credential input the managed credential reader accepts, and that a missing approval, or an approval for another attempt or operation, refuses before boot or power. Without it the refusal test can be green while every eligible install still stops at the credential.",
        displaced_cost: "The first eligible dispatch would otherwise discover the credential and approval wiring on hardware, mid-attempt.",
        first_slice: "Add a non-actuating preflight mode to the network install entry and dispatch it for srv15 through the generated workflow.",
        red_control: "OPEN: not yet measured. The cases to execute through the generated workflow: an eligible preflight for srv15 resolves its scoped credential and approval and writes nothing; the same preflight with the approval withheld, and with an approval for another attempt, each refuse before any controller write.",
        out_of_scope: "Granting the approval itself, which is the operator's.",
        handback: "Evidence that an eligible dispatch reaches the point of actuation with the right credential and approval, before one is ever risked."
      )),
      dispatch: dispatchable(),
      parent: in_project(project: "site-boot-and-management-edge", contribution: "The eligible half of the generated-workflow wiring test."),
      centering: plan(text: "new_server_bringup_plan: the stages connect through the generated workflow before a real disk write enters the picture. Target: dag/gunbc/host/network_install_ci.dag."),
    ),
    roadmap_node(
      identity: "rn_51AP77FS7XG6AVKS5NCGAZN8KQ",
      id: "bobo-first-remote-build-executed",
      owner: "fleet",
      carriers: carrier(path: "dag/gunbc/compute/remote_build.dag"),
      line: ticket(t: fields(
        headline: "A CI job's build executes on srv15, and its reservation is released",
        boundary: "Owned by the remote-build lane, after bobo-first-boot-handoff-to-remote-build: srv15's join (tag:ci, trusted host key, memory reading, roster admission) and its first live build. The CI bridge runs the GitHub job on a hosted or placeholder runner and sends the build to a physical executor (remote-build-ci-bridge), so srv15 is never the GitHub runner; acceptance links one CI job and its revision to a successful build executed on srv15 and observes the capacity reservation released afterwards. The build may go through the admitted bridge or its durable successor (the route work-exec-2 and work-exec-4 move it onto), whichever is live when this runs, so the row does not depend on which lands first; pinning to srv15 restricts eligibility to that one host and is refused, never filled elsewhere, when srv15 has no capacity.",
        displaced_cost: "Without it the milestone could be accepted on a handoff while srv15 has executed nothing, or on a hosted job whose build ran elsewhere.",
        first_slice: "The join rows the handoff names, then one build pinned to srv15 through the admitted bridge or its durable successor.",
        red_control: "OPEN: not yet measured. The pair to execute: a CI job whose build executed on another host does not satisfy this row, and a pin to srv15 while srv15 has no capacity is refused rather than filled elsewhere; the job whose execution record names the job, the revision and srv15 as the actual executor, with its reservation observed released, does.",
        out_of_scope: "The bridge itself, its cutover to the durable route, and any other host.",
        handback: "One CI build executed on srv15, linked to its job and revision, with its capacity returned."
      )),
      dispatch: dispatchable(),
      parent: in_project(project: "site-boot-and-management-edge", contribution: "The workload evidence bobo's milestone ends on."),
      centering: plan(text: "new_server_bringup_plan: a unit is done when it has provided the service it was admitted for. Target: dag/gunbc/compute/remote_build.dag."),
    ),
    roadmap_node(
      identity: "rn_6NZVWFQ3VYYG10SDC9WSYZACVF",
      id: "edge-concurrent-install-offers",
      owner: "fleet",
      carriers: carrier(path: "dag/gunbc/host/network_install_store.dag"),
      line: ticket(t: fields(
        headline: "srv4's edge serves several active install attempts and retires only the one that ended",
        boundary: "Later work after the serialized first cut (install-holds-one-store-and-edge-reconciles-attempts): staging reconciles the edge to exactly one request and withdrawal to an empty list, so two concurrent attempts remove each other's offers. The edge reconciles the set of all active attempts and withdraws only the attempt that ended.",
        displaced_cost: "Until then installs at the site are one at a time, which is correct but slow once several units arrive together.",
        first_slice: "Make the edge's desired install set the active-attempt set read under the edge lock.",
        red_control: "OPEN: not yet measured. The pair to execute: withdrawing attempt A while attempt B is active leaves B's offer and files in place; withdrawing B afterwards leaves none.",
        out_of_scope: "Serialization and crash recovery, which the first cut owns.",
        handback: "Concurrent installs at the edge."
      )),
      dispatch: dispatchable(),
      parent: in_project(project: "site-boot-and-management-edge", contribution: "Concurrency at the edge, priced apart from the first cut."),
      centering: plan(text: "new_server_bringup_plan: one attempt's withdrawal never removes another's offer. Target: dag/gunbc/host/network_install_store.dag."),
    ),
    roadmap_node(
      identity: "rn_7DBCDCMJ7XBBCY2FG5ZJRXMZF5",
      id: "bringup-entry-verifies-managed-unit",
      owner: "fleet",
      carriers: carrier(path: "dag/gunbc/host/network_install_ci.dag"),
      line: ticket(t: fields(
        headline: "Bring-up's entry decides read-only what a dispatch for an already-managed unit means",
        boundary: "After bobo's install it is a managed host, and a second dispatch has no defined route: the install subject gate refuses managed hosts (gunbc.host.install_boot_subject) and the journal answers InstallAlreadyCompleted (gunbc.host.network_install), and neither establishes what root is running now. Put one read-only decision at the entry to bring-up: for a managed unit that is the dispatch's subject, verify its current identity and installed root and return that evidence; for a managed host that is not the subject's unit, refuse an install; for an unreachable unit, return unverified. All three run through the same entry with zero boot, power or storage writes. This is not hand-installed adoption (install-adoption-of-installed-units), which stays off bobo's path.",
        displaced_cost: "Without it the milestone's second dispatch either refuses for the wrong reason or is read as success without anyone having looked at the machine.",
        first_slice: "A verify arm on the entry that reads identity and the installed root over the attempt-scoped or enrolled SSH trust and returns evidence, with the three outcomes as witness cases.",
        red_control: "OPEN: not yet measured. The cases to execute through one entry: a dispatch for managed srv15 returns its verified identity and root with no controller, edge or storage write (red today: it refuses as a managed host or as already completed, establishing nothing); a dispatch naming an unrelated managed host refuses the install; an unreachable srv15 returns unverified.",
        out_of_scope: "Adopting a hand-installed unit; reinstalling; any write.",
        handback: "A repeatable, write-free second run for an installed unit."
      )),
      dispatch: dispatchable(),
      parent: in_project(project: "site-boot-and-management-edge", contribution: "The upsert's verify arm: an installed unit is verified, not reinstalled and not merely refused."),
      centering: plan(text: "new_server_bringup_plan: an install is an upsert, and its verify arm reads the machine. Target: dag/gunbc/host/network_install_ci.dag."),
    ),
    roadmap_node(
      identity: "rn_BB6M4C13XY1NWJ5XTM2DP5J4R9",
      id: "gunbhub-source-of-truth",
      owner: "source-intent",
      carriers: carrier(path: "dag/gunbc/plans/gunbhub_source_of_truth.dag"),
      line: ticket(t: level_fields(
        headline: "gunbhub is gunbc's source of truth and GitHub a mirror",
        boundary: "The long track the operator separated on 2026-11-24 (gunbc.design_ruling::github_stays_the_code_repository_until_gunbhub_2026_11_24): gunbc's own source control, served as gunbhub with a simple frontend, becomes the authority over what landed, and GitHub receives a one-way mirror. GitHub stays the code repository until this project's cutover; nothing outside it waits on it.",
        approach: "Members, in dependency order: the native SCM upstream models and landing spine already in the factory project (2-scm-*), linked by edge rather than moved; a simple gunbhub frontend over that spine; then the cutover that makes gunbhub the authority and GitHub the mirror.",
        red_control: "Met only through its members: the cutover row's own control, a change landed and read back through gunbhub while GitHub is unreachable.",
        displaced_cost: "While GitHub decides what landed, every trust chain that rests on reviewed main inherits GitHub as a root, however much else moves off it.",
        handback: "A landed change read back from gunbhub, and GitHub receiving only the mirror."
      )),
      parent: in_project(project: "gunbc-project-root", contribution: "The project's source history owned by its own source control, the last GitHub authority to move."),
    ),
    roadmap_node(
      identity: "rn_BVQ2T76G1H1BBST0G5KK6F856P",
      id: "gunbhub-simple-frontend",
      owner: "source-intent",
      carriers: carrier(path: "dag/gunbc/gunbhub_serve.dag"),
      line: ticket(t: fields(
        headline: "gunbhub serves browse, proposal, review and landing over gunbc's own source control",
        boundary: "A deliberately simple frontend, the operator's word, over the native landing spine: browse a revision's tree and history, read a proposal and its review threads, record a review decision, and land through the spine with the landed revision read back. gunbc.gunbhub_serve already renders a browse page and is the seed; this row extends it rather than adding a second server. No accounts, notifications, issue tracking or anything a person can do through the CLI already, unless a consumer is named.",
        displaced_cost: "Without a way to read and land changes, a native source of truth is usable only from the command line, and review would stay on GitHub after the history moved.",
        first_slice: "Browse and proposal read over a repository the native object store holds, served by the existing gunbhub_serve.",
        red_control: "OPEN: not yet measured. The pair to execute: a proposal whose review has an unresolved thread cannot be landed from the frontend; the same proposal with the thread decided lands, and the landed revision the page shows is the one read back from the store.",
        out_of_scope: "Identity and authorization of reviewers beyond what the landing spine already admits; any public hosting.",
        handback: "A frontend a person can review and land a change through."
      )),
      parent: in_project(project: "gunbhub-source-of-truth", contribution: "The simple frontend the track needs before people can work through gunbhub."),
      centering: plan(text: "gunbhub_source_of_truth_plan: gunbc's own source control is the authority over what landed. Target: dag/gunbc/gunbhub_serve.dag."),
    ),
    roadmap_node(
      identity: "rn_308N4SS4YMT39PCHRQ4ENPCCSH",
      id: "gunbhub-authoritative-cutover",
      owner: "source-intent",
      carriers: carrier(path: "dag/gunbc/plans/gunbhub_source_of_truth.dag"),
      line: ticket(t: fields(
        headline: "gunbhub becomes the authority over gunbc's source, and GitHub a one-way mirror",
        boundary: "The cutover: changes land through gunbhub, GitHub receives a one-way mirror, and source consumers -- remote builds (gunbc.compute.remote_build_client pushes and fetches through GitHub today), the belt, review tooling, the fleet's revision admission -- read from the gunbhub authority. A gap-intolerant boundary, so it is staged: gunbhub in shadow beside GitHub, then one transition (gunbc.design_argument::replacement_migration).",
        displaced_cost: "Until it happens, reviewed main remains a GitHub fact that every trust chain resting on main inherits.",
        first_slice: "Run gunbhub in shadow: mirror GitHub's main into the native store and compare revisions, landing nothing through it yet.",
        red_control: "OPEN: not yet measured. The pair to execute: a change landed through gunbhub while GitHub is unreachable is read back from gunbhub and reaches the mirror once GitHub returns; a change pushed directly to the GitHub mirror after cutover is refused or overwritten, never adopted as landed; and, with GitHub unreachable, an unlanded candidate submitted through the build route active at cutover executes the exact requested source, its result is retrieved, and the candidate stays unlanded -- because remote builds push and fetch refs/remote-build/* through GitHub today, a control over landed changes alone would pass while candidate builds still needed a writable GitHub ref.",
        out_of_scope: "Moving identity or execution off GitHub, which do not wait on this row.",
        handback: "gunbhub authoritative, GitHub a mirror, with the consumers that read source repointed."
      )),
      parent: in_project(project: "gunbhub-source-of-truth", contribution: "The track's terminal transition."),
      centering: plan(text: "gunbhub_source_of_truth_plan: gunbc's own source control is the authority over what landed. Target: dag/gunbc/plans/gunbhub_source_of_truth.dag."),
    ),
    roadmap_node(
      identity: "rn_S8GJNH5FEC0WXJVW1S1WTKGB69",
      id: "github-actions-deleted",
      owner: "fleet",
      carriers: carrier(path: "dag/gunbc/plans/github_actions_retirement.dag"),
      line: ticket(t: updated(t: fields(
        headline: "GitHub Actions is deleted: no workflows but the exempt gunb.ai Pages deploy, no runners, no credential trusting an Actions token",
        boundary: "The deletion milestone the operator asked for on 2026-11-24 (gunbc.design_ruling::github_actions_are_wound_down_entirely_2026_11_24). At this read main has nine workflows (branch-run-grant-broker, drift-watch, fleet-converge, heal-publish, heal, hosted-runner-shadow-gate, instrument-dispatch, microvm-shakedown, witnesses), each emitted from a .dag module, and gunbc.auth.github_gcp_federation admits GitHub's OIDC issuer into Google workload-identity pools. Each workflow's operation gets a named fabric route or is retired for want of a consumer; then the workflow, its emitter, the runner registrations and every pool, secret, environment and app permission that serves only Actions are deleted, not disabled. Moving the source repository off GitHub is not part of it. THE ONE EXEMPTION: gunbc.site.gunb_ai_pages_workflow (gunb-ai-pages, the gunb.ai GitHub Pages deploy) and the pages and id-token grants its job holds are exempt (gunbc.design_ruling::gunb_ai_pages_deploy_is_exempt_from_the_actions_wind_down_2026_11_26); it is among the last Actions uses to go, and moves to a route that is not GitHub Pages when gunb.ai needs more than a static site. It needs no Google workload-identity pool, so the Google-side deletion is unaffected.",
        displaced_cost: "Actions stays a second execution authority and its identity tokens stay a trust root: today any same-repository pull-request job can reach the srv3 BMC secret and the R2 token through the repository-wide pool, an exposure the operator accepted until this deletion rather than narrowing it.",
        first_slice: "Account for each of the nine workflows: its consumer, its fabric route or its retirement. Delete the retired github-heal-publisher pool and any workflow with no consumer first, since neither waits on the verdict switch.",
        red_control: "OPEN: not yet measured. The pair to execute: after deletion no workflow other than the exempt Pages deploy (gunbc.site.gunb_ai_pages_workflow) runs, a workflow file pushed on a branch runs nowhere and gets no token, and a token minted by any GitHub Actions run is refused by every Google project's security token service, read from the live estate; the required check on the same commit still publishes, from a fabric receipt.",
        out_of_scope: "GitHub as the code repository, a separate question. Narrowing the pools before deletion, which the operator skipped.",
        handback: "The per-workflow account, the deleted workflows, emitters, runner registrations and pools, and the live-estate read showing no provider admits the Actions issuer."
      ), on: "2026-11-26", note: "merry-eagle-717 (asked by keen-dove-217): headline, boundary and red control narrowed to except the gunb.ai Pages deploy, which the operator exempted (gunbc.design_ruling::gunb_ai_pages_deploy_is_exempt_from_the_actions_wind_down_2026_11_26). Actions stays enabled for that one workflow, so the red reads as no other workflow running.")),
      parent: in_project(project: "work-execution-redesign", contribution: "The end of the old execution route: once the verdict comes from a fabric receipt, Actions is deleted rather than kept beside it."),
      centering: plan(text: "github_actions_retirement_plan: gunbc runs no GitHub Actions. Target: dag/gunbc/plans/github_actions_retirement.dag."),
    ),
    roadmap_node(
      identity: "rn_G75EV6NFA5Y20CRRZKH42F629W",
      id: "empty-service-admissibility",
      owner: "self-host",
      carriers: carrier(path: "src/v2/extdeps/languages/dag.dag"),
      line: ticket(t: updated(t: fields(
        headline: "An empty service declaration is admitted or refused by a named decision",
        boundary: "Measured by loyal-carp-337 on srv1 at main with scratch discovery modules never committed: the source `module m` then `service S {}` PARSES (e_parses_holds PASS), because the grammar production dag_grammar_service_decl_expr uses repeat(service_body_entry), which admits zero entries, and normalize does NOT admit it (e_admits_holds FAIL). It is refused under none of 71 candidate reason symbols swept across body_lowering, normalize and normalized_tree (each of the 71 discovery claims FAILed), so the reason lives outside those symbol sets. The reason id and the diagnostic text are NOT yet named: no raw line has been captured, and a reading of body_lower_service_decl pointing at a service_realization_* reason is a suspicion, not a measurement. The first slice is to capture the emitted diagnostic verbatim, and if no route prints it, to record the routes tried with their exit statuses as the finding. The manager's ruling for this slice: document main's actual refusal, change no admission. Whether an empty service should be admitted is a separate language decision this row records as open, since no grammar row, ownership row or ruling settles it.",
        displaced_cost: "An author who writes an empty service gets a refusal naming a retained shell, a reason about something else, and cannot tell whether the declaration or the compiler is wrong.",
        first_slice: "Record main's actual refusal for the empty service, its measured reason id and diagnostic text, with the one-entry body as control. Then decide which side moves, as one named change: refuse the empty body at parse with a named reason (the grammar production stops disagreeing with normalize), or define the empty service's lowering so normalize admits it. The earlier slice instruction to change no admission applied to the measurement step only.",
        red_control: "`module m` / `service S {}` is asserted to yield main's measured refusal with its typed reason id, so a change in which stage refuses it, or a silent admission, reds; the input with one body entry still parses and normalizes unchanged. Each assertion names the typed diagnostic and the stage that raised it, never bare non-acceptance.",
        out_of_scope: "The five named parse-door refusals, and the lowering of non-empty services.",
        handback: "The decision, the typed outcome for the empty body, and the control pair (empty refused or admitted by name; one-entry body unchanged).",
      ), on: "2026-11-23", note: "Evidence added from loyal-carp-337: dag/gunbc/integration_concern/empty_service_parses_but_normalize_refuses_it.dag (self-host-service-family PR, head e679a90e) records the same disagreement as an integration concern. Reported by neat-badger-614: the disagreement is a defect, because the grammar and normalize are two authorities answering one validity question and they disagree; this row decides which side moves. That decision is relayed, not recorded in gunbc.design_ruling, so no ruling symbol is cited here.")),
      dispatch: dispatchable(),
      parent: in_project(project: "v2-compiler-live", contribution: "An accidental refusal becomes a stated one."),
      centering: plan(text: "gunbc.design_argument::fail_closed: a refusal is a named, located diagnostic, not a leftover. Target: src/v2/extdeps/languages/dag.dag, whose service_body_entry production admits the empty body, and the normalize stage that refuses it."),
    ),
    roadmap_node(
      identity: "rn_HF1AYSSPB2TE2YVZKERDB0WNBF",
      id: "effect-join-census-fallback-arm-removed",
      owner: "self-host",
      carriers: carrier(path: "src/v1/04_infer.dag"),
      line: ticket(t: fields(
        headline: "Remove the unreachable census-fallback arm from the effect join",
        boundary: "In src/v1/04_infer.dag call_target_for_direct_call answers through func_env_declared_func_sig first and consults func_sig_from_global_bare (and, in the declaration and method arms, census_declaration_identity then func_sig_from_global_bare) only on the func_env miss; both are imported from v1.compiler.infer_lookup. The census arms exist for a corpus-unique census homonym out-preceding a let callee and for the algebra method-template gate (see call_locals_shadow_note in 04_infer.dag), which is why their removal needs agreement evidence and not a probe: no probe can be RED before and GREEN after. Trying func_env_declared_func_sig first proves lookup order, not that its miss arm is unreachable, and removability has not been shown (#16884's own evidence). The node first establishes whether the miss branch is reachable and what callee identity it yields, and deletes only a branch shown redundant. It is a stage0 mirror change with heal rounds.",
        displaced_cost: "A fallback arm nothing reaches keeps a second authority for callee identity in the effect join and invites a later reader to rely on it (gunbc.design_argument::consumption).",
        first_slice: "Establish whether the census-fallback branch is reachable and which callee identity it returns for the named population, and only if it is shown redundant delete it and keep every caller compiling. No new broad census program.",
        red_control: "Complete per-member outcomes (PASS, FAIL, refused with its reason, or unobserved) for the named population, with the source sha and binary identity, are identical before and after the deletion; equal PASS sets are not enough because they hide a FAIL becoming UNOBSERVED, an omitted failing claim and a changed refusal reason. Any member whose outcome changes refuses the deletion.",
        out_of_scope: "Any behaviour change, and the listed-import behaviour itself (effect-summary-env-carries-listed-imports).",
        handback: "The reachability finding, and the two complete per-member outcome tables with source and binary identities and their diff, empty.",
      )),
      dispatch: dispatchable(),
      parent: in_project(project: "compiler-guarantee", contribution: "Resolve and effect summary keep one authority for a call's callee."),
      centering: plan(text: "Target: src/v1/04_infer.dag, the effect join arms around census_declaration_identity and func_sig_from_global_bare."),
    ),
    roadmap_node(
      identity: "rn_5ERZMZ9M7AMFBRAMW98VFMWEYW",
      id: "claim-three-source-roots-shared-index",
      owner: "self-host",
      carriers: carrier(path: "src/v1/stage0/src/cli_run.rs"),
      line: ticket(t: updated(t: fields(
        headline: "A claim run over three source roots does not refuse the shared index",
        boundary: "The predicate is a three-root outer claim run whose witness fixture performs its own inner emit check (compile_dag_rust_emit_check) demanding the two-root pool, not any three-root run: a three-root run with no such fixture passes (modeled_filesystem_witness). Such a run refuses fixture-render-refused SharedIndexSecondResidentPool: the outer run holds the pool for roots dag, src/v1 and src/v2 on a thread, and compile_dag_rust_emit_check then demands the two-root pool dag and src/v2, which src/v1/stage0/src/cli_run.rs refuses as a second resident pool on that thread. Measured at main 4a63370f4a67 by calm-swift-579 on srv1 under heavy-slot with the released claim_batch sha256 9cb21df4c20325fc53ba4187cf4c55bd08037862a45d3900c5cc5519e360a177 over dag/test/claim/emitter_generic_match_field_binding_witness.dag: over dag plus src/v2 its four witnesses PASS and the run exits EXIT=0; adding src/v1 makes all four FAIL with the same refusal and EXIT=1. The owner is whoever owns the closure and pool authority refused at src/v1/stage0/src/cli_run.rs, not the emitter. Dropping a root to avoid the refusal silently downgrades the run to two roots and loses the coverage src/v1 contributes, so that is out of scope here. The defect is the class, not one command. The emitter row's own red_control states no three-root command, so no edge is added to it; rows whose text cites src/v1 alongside src/v2 at that sha are names-bind-to-the-unique-declaration, emission-ownership-facts-survive-lowering, extdeps-subject-ref-facts-host-census, debt-grandfathered-fold-enrolled, dp-m4-discovery-floor-semantic and heal-observation-reuse-by-subject; none states it in its red_control, so no dependency edge is declared, and an owner whose red_control comes to run three roots adds one.",
        displaced_cost: "Every row whose stated command uses three roots cannot produce its control, so its acceptance waits on a defect nobody owns.",
        first_slice: "Reproduce the four-witness PASS-then-FAIL pair over two and three roots and decide whether the fixture's emit check should demand the outer roots or the outer run should release its pool.",
        red_control: "The same four emitter witnesses PASS over dag, src/v1 and src/v2 at one sha, exit 0, where they now exit 1; a three-root run that still refuses SharedIndexSecondResidentPool keeps this red.",
        out_of_scope: "Dropping src/v1 from the command to avoid the refusal.",
        handback: "Raw PASS/FAIL lines for the four witnesses over two roots and three roots, with real exit status, before and after.",
      ), on: "2026-11-23", note: "Evidence relayed 2026-11-23 by warm-fox-517 (corrected by its own second message), from loyal-carp-337's join on gunbc#16897 (head e679a90e670b, base 68dfd570fc02, released claim_batch sha256 9cb21df4c20325fc53ba4187cf4c55bd08037862a45d3900c5cc5519e360a177; logs on srv1 ~/scratch/loyal-carp-337/r12_reach_gh.log). In the head-side reach batch there are 158 claim lines, 132 joined and 26 excluded for want of a witness line (those 26 are closure-diagnostic compile failures, not this defect). Of the 132 joined claims, 52 distinct claims FAIL with SharedIndexSecondResidentPool, demanded at src/v1/stage0/src/cli_run.rs via build_multi_entry_index; sampled ones carry a witness line with an eval_steps figure, so they evaluated and were refused mid-evaluation. Consequence: under the three-roots instrument those 52 verdicts and their step figures are harness-caused and unusable as evidence about the code. merry-deer-252 hit the same wall on the per-function node. The sought fix is unchanged and is the first_slice decision: share or release the pool, or refuse early with a typed message naming the demanded roots. Counts are the reporter's from the join, not re-measured here.")),
      dispatch: dispatchable(),
      parent: in_project(project: "compiler-guarantee", contribution: "Multi-root claim runs stop refusing a shared index they should share."),
      centering: plan(text: "Target: the fixture render path that raises SharedIndexSecondResidentPool for the three-root source set."),
    ),
    roadmap_node(
      identity: "rn_RSSFZ2ATKD5QESN749SZ0E7FXT",
      id: "eval-call-memo-has-a-byte-bound",
      owner: "self-host",
      carriers: carrier(path: "src/v1/stage0/src/v1_interpreter.rs"),
      line: ticket(t: fields(
        headline: "The interpreter's eval-call memo grows to its entry cap with no byte budget",
        boundary: "eval_call_memo_put in src/v1/stage0/src/v1_interpreter.rs is capped by EVAL_CALL_MEMO_ENTRY_CAP (1,000,000) and enabled by default through eval_call_memo_env_default. Each stored entry holds its argument vector and result value strongly for the lifetime of the run context. The sibling cross-claim memo has a byte bound, CROSS_CLAIM_PURE_MEMO_BYTE_BUDGET (256 MiB); the asymmetry is the defect, not the memo's existence. Measured by keen-pike-826 on srv1 under heavy-slot with the released claim_batch sha256 9cb21df4c20325fc53ba4187cf4c55bd08037862a45d3900c5cc5519e360a177 at checkout b69155949654, program's own exit line: one P-256 verify with the memo on (default) took eval_steps 48,296,785, wall 101.6 s, VmHWM 14,983,500 kB; the same verify with the memo off through the existing read-only env switch took eval_steps 51,629,999, wall 78.3 s, VmHWM 6,697,188 kB, Exit status 0; the floor, a trivial witness in the same entry, VmHWM 6,815,264 kB. The memo accounts for 8,286,312 kB (55 percent), essentially the whole first-verify memory cost; seven verifies in one process reach 20,380,524 kB. Steps rose with the memo off while wall fell, so on this workload the memo cost both memory and time.",
        displaced_cost: "Every claim run that reaches a heavy pure computation pays gigabytes of retained memo entries, and the memory envelope refuses or throttles the run for memory the computation does not need.",
        first_slice: "Decide the byte bound for the eval-call memo and why that size, by its sibling's precedent and the measurement above, and apply it at eval_call_memo_put. This is hand-written seed Rust, so an operator ruling is needed before anyone edits; this row is a candidate and authorises nothing.",
        red_control: "A measurement, not a knob: the P-256 verify entry and one corpus witness of comparable size, memo on, VmHWM read by /usr/bin/time -v from the same run at the same sha and binary, falls toward the memo-off figure (6,697,188 kB) with the bound in place and every verdict unchanged, so the memo's residency is bounded; a run that still retains the unbounded growth keeps this red.",
        out_of_scope: "Disabling the memo, proposing the env switch as a knob, widening any floor budget, and the step-count problem.",
        handback: "The named site, the byte bound chosen and why that size, VmHWM before and after at one sha for the P-256 entry and one corpus witness of comparable size, and the eval-step figures beside them so a reader can see the memo does not carry the step cost.",
      )),
      parent: in_project(project: "compiler-guarantee", contribution: "The interpreter's memo stops retaining memory the computation does not need."),
      centering: plan(text: "Target: eval_call_memo_put and its entry cap in src/v1/stage0/src/v1_interpreter.rs, beside the cross-claim memo's byte budget."),
    ),
    roadmap_node(
      identity: "rn_G9RTSUE4V511HSQWYSZ9KLTLAE",
      id: "fleet-truth-follows-the-machine",
      owner: "fleet",
      carriers: carrier(path: "dag/gunbc/plans/desired_state_follows_the_machine.dag"),
      line: ticket(t: level_fields(
        headline: "What the model says about a host is matched by a read of that host, and a divergence refuses where a roster would rely on it",
        boundary: "The repository's claims about what a host IS -- which hardware enumerates, which units are enabled, how the host is keyed, which cap actually binds a role, what backing a presupposed limit rests on -- plus the one consumer that joins them: admission to the remote-build and serving rosters. It owns no mutation (converge applies, the operator applies), no cap value, and no scheduled job: the cadence is the operator's under gunbc.design_ruling::job_roster_closed_to_growth. It re-models nothing: hardware facts stay with gunbc.plans.fleet_hardware_fact_consumption, machine identity with gunbc.plans.fleet_machine_authority and gunbc.fleet.fleet_host_key_enrollment, the runner-slot shape with gunbc.host.memory_envelope and gunbc.recurring_failure_mode.the_live_runner_unit_memory_shape_drifts_from_the_declared_slot, tailnet membership with gunbc.tailscale_join_converge, arrival with gunbc.plans.new_server_bringup.",
        approach: "One read with five comparisons (enumerated hardware, enabled units against that hardware, presented host key against the enrolled anchor, the leaf cgroup cap against the working set the role declares, swap backing against the declared cap) and five typed divergence arms, proposed as a mode of the existing per-host fleet-converge route rather than as a new job; then both rosters consume it; then the named divergences close through their owners, each followed by the read showing agreement. The operator's tiered breakage report of 2026-11-21 is the specimen source, and its swap item is recorded there as a mis-stated premise rather than as work.",
        red_control: "A host admitted to either roster without a current read, or with a divergence arm that has no planted-divergence witness, keeps this open. So does any instrument in the path that reports absence where it failed instead of refusing -- the report's GPU sampler producing empty power columns is that control's RED case (gunbc.recurring_failure_mode.failed_value_read_scored_as_value_absent).",
        displaced_cost: "Every specimen in the report was paid for by a lane that had come to do something else: 32 s of re-prefill per turn where a cache hit costs 3 s; a fivefold decode cliff, 5.1 tok/s against 24.5-29.1 tok/s, with no alarm at the cap that caused it; a host key belonging to a previous occupant, indistinguishable from an attack; units enabled at boot into hardware that has left, pinning memory no role can use. Each repair is small. The missing read is what made each one expensive.",
        handback: "Both rosters admit only hosts whose current read agrees with the model, saying which arm diverges; each of the five arms has an owner and a witness; the enrolled-key roster is closed over every host in either roster; and drift is refused rather than discovered."
      )),
      dispatch: dispatchable(),
      parent: in_project(project: "gunbc-project-root", contribution: "A fleet whose repository says things about each host without ever reading that host is a fleet that finds out by collision. Joining what is claimed to what is read, and refusing where they diverge, is what makes admitting a host to the build or serving roster a claim anyone can stand behind."),
      centering: plan(text: "desired_state_follows_the_machine_plan: the model names what each host runs and nothing reads the machine, so desired state and the machine drift on three axes and every drift is found by collision. Target: the plan carrier, whose done-when is written as one consumer refusing rather than as four hosts repaired."),
    ),
    roadmap_node(
      identity: "rn_HXBFTP014GHZMG78NT4P7U8SGH",
      id: "fleet-truth-per-host-read",
      owner: "model",
      carriers: carrier(path: "dag/gunbc/fleet/fleet_converge_workflow.dag"),
      line: ticket(t: updated(t: fields(
        headline: "One per-host read of hardware, units, key identity, binding caps and swap backing, as a mode of the existing converge route",
        displaced_cost: "Nothing joins the halves. The hardware population, the systemd property read, the enrolled host key, the axis caps and the swap-backing fold all exist as separate authorities; no consumer compares them against the machine, so a model that is confidently wrong is indistinguishable from a model that is right until a lane collides with it.",
        boundary: "The read and its typed divergences: enumerated hardware (a PCI class count per declared device class), the enabled state of units the model declares (gunbc.systemctl_show_read, whose three arms already refuse rather than report empty), the host key as the host presents it against the enrolled anchor, the cgroup controls at the LEAF that runs each role, and swap total against the declared cap. Fail-closed on no-observation, copying gunbc.host.host_swap_backing's fold. No mutation, no new scheduled job: it is proposed as a mode of the route gunbc.fleet.fleet_converge_plan and gunbc.fleet.fleet_converge_timer already run, and the cadence was the operator's and is decided: operator ruling 2026-11-21, verbatim 'A is fine' -- the read rides the existing per-host ctrl-fleet-converge timer as a new OBSERVE-ONLY mode, no new scheduled job, no roster growth. Its cadence ruling is registered alongside this row (gunbc.design_ruling::fleet_truth_read_rides_the_converge_timer_2026_11_21); what is sequenced, not decided, is the merge order -- the read lands after the serving-converge increment whose witness closures contain the ruling file, so no in-flight lane is re-tallied underneath it. What riding the route costs is known and is not mine to grant: adding a mode regenerates .github/workflows/fleet-converge.yml, and two of its numbers are derived -- the converge job's timeout (the folded backstop plus three host-cap step budgets) and each cap step's RUNNER_HOST_CAP_STEP_BUDGET_SECONDS (the drain bracket) -- so the regen carries a budget raise, and gunbc.design_ruling::ci_job_budgets_closed_to_growth admits a raise only on the operator's own words with a grant row in gunbc.ci.ci_budget_raise (precedent: srv1_dashboard_deploy_step_timeout_raised, 2026-11-21). The figure-level ask goes to the operator before the PR, not inside it.",
        first_slice: "The five comparisons as one module with the five arms (HardwareGone, UnitOrphaned, IdentityUnanchored, CapBelowResidency, BackingUnobserved), each arm distinguishable from the read not having happened, plus one planted-divergence witness per arm and one admit witness per arm.",
        red_control: "A planted divergence that does not refuse, or an arm collapsed into another because the merged verdict was easier to carry, fails the row: the arms stay separate because their remedies are separate (remove hardware, retire a unit, re-anchor a key, refuse a placement, provision backing).",
        out_of_scope: "Scheduling -- ruled elsewhere and not by this item (gunbc.design_ruling::fleet_truth_read_rides_the_converge_timer_2026_11_21 puts the read on the already-scheduled per-host converge route; gunbc.design_ruling::job_roster_closed_to_growth still closes a new job to growth); any host run from this row; cap values; the retirement of any unit; the tailscale join itself, which stays with gunbc.tailscale_join_converge.",
        handback: "A standing per-host reading with typed divergence, cheap enough to run on every host in both rosters -- one SSH hop plus reads that already exist as converge steps."
      ), on: "2026-11-21", note: "Verified 2026-11-21 against the tree: no module compares a host's enumeration, unit enabledness, presented key, leaf caps and swap against the model's claims; gunbc.fleet.gpu_device_observation, gunbc.systemctl_show_read, gunbc.fleet.fleet_host_key_enrollment, gunbc.host.host_axis_caps and gunbc.host.host_swap_backing are each one-sided. The report's tiers 1-3 are one thing on three axes, which is why this is one row and not three. The report's swap item was checked and is a mis-stated premise: memory_envelope_verdict judges swap at the slot cgroup and host_swap_backing consults host swap only against a nonzero declared cap (the runner slot declares memory_swap_max = 0), so butch's /swap.img refuses nothing; recorded in gunbc.recurring_failure_mode.a_cap_set_here_surfaces_as_degradation_there so no row builds on it. The butch half of this read is already in flight with swift-koi-507 (its row: the host_memory_observe and identity read for butch), and this row does not duplicate it.")),
      dispatch: dispatchable(),
      parent: in_project(project: "fleet-truth-follows-the-machine", contribution: "The read itself: without it every other row here is a hope rather than a judgment."),
      centering: plan(text: "desired_state_follows_the_machine_plan: the single highest-leverage piece of the report. Target: a read module wired as a mode of dag/gunbc/fleet/fleet_converge_workflow.dag, whose legs already reach each host over SSH."),
    ),
    roadmap_node(
      identity: "rn_FTTHBL2H9F36L05V7532GS61R4",
      id: "fleet-truth-rosters-consume-the-read",
      owner: "model",
      carriers: carrier(path: "dag/gunbc/compute/remote_build_hosts.dag"),
      line: ticket(t: updated(t: fields(
        headline: "The build and serving rosters refuse a host whose read is missing or divergent",
        displaced_cost: "A host the model believes in and the machine contradicts still gets work: srv4 answered 429 at a concurrency nobody had declared, and butch's admission as a build host is already waiting on exactly this read (gunbc.design_ruling::butch_serving_retirement_is_operator_handled_2026_11_21 says butch enters the build roster only once a read shows the serving units gone and the envelope measured).",
        boundary: "The consumer, not the read: admission to gunbc.compute.remote_build_hosts / gunbc.compute.remote_build's roster and to the serving roster gunbc.serving.serving_host_memory with the router's layout. A missing read is a refusal naming that nothing was read, never an admission. The boot-time consumer (a unit that would start against absent hardware) is named here and built where units are decided, not re-invented.",
        first_slice: "The build roster's admission fold carrying the read's verdict, with a witness that admits a host whose read agrees and refuses one whose read diverges or is absent.",
        red_control: "An admission path that treats 'no read' and 'read agrees' identically is the RED case; so is a refusal that does not say which arm diverged.",
        out_of_scope: "The read's own module; changing any cap or cgroup; admitting any specific host -- admission is the machine's answer, not this row's.",
        handback: "Roster membership as a judgment with a date and an arm, rather than as a remembered list."
      ), on: "2026-11-21", note: "Verified 2026-11-21: remote_build_hosts carries roster rows as data and the converge route settles hosts, but no admission site consults a machine read. The ruling's butch clause is the consumer stated before this row existed.")),
      dispatch: dispatchable(),
      parent: in_project(project: "fleet-truth-follows-the-machine", contribution: "The reason the read exists: without a consumer it is a report nobody is obliged to read."),
      centering: plan(text: "desired_state_follows_the_machine_plan: the report's done-when is one consumer refusing. Target: the roster admission in dag/gunbc/compute/remote_build_hosts.dag and the serving roster's placement in dag/gunbc/serving/serving_host_memory.dag."),
    ),
    roadmap_node(
      identity: "rn_7EK7T4B13BYZ6SYV9NC6SG0GCN",
      id: "fleet-truth-enrolled-key-roster-closed",
      owner: "fleet",
      carriers: carrier(path: "dag/gunbc/fleet/fleet_host_key_enrollment.dag"),
      line: ticket(t: updated(t: fields(
        headline: "Every host in either roster has an enrolled host-key anchor, and the read compares what the host answers with",
        displaced_cost: "butch's address moved twice in nine days and the address it landed on carried another machine's host key, so the connection failed exactly as an interception would and was resolved by matching an ed25519 fingerprint by hand. srv3 was unreachable at its former address. Where no anchor exists, a location is trusted on first contact -- the enrollment module's own 2026-11-10 note says the first scan of butch proved who we are to the host, not which machine was reached.",
        boundary: "Closing the enrolled-anchor roster over every host in the build and serving rosters (it covers srv1-srv4 and ken today), and comparing the presented key against the anchor in the read. The tailnet join itself, per-host, stays with gunbc.tailscale_join_converge and the lanes handling each host; nothing here reaches a host by an address the model does not anchor.",
        first_slice: "The anchor roster with an explicit disposition for every roster host -- enrolled, or refused-with-a-reason -- and a witness that the fold refuses a host with neither.",
        red_control: "A roster host with no anchor row and no refusal reason keeps this open; a key mismatch resolved by hand rather than refused with both fingerprints named is the RED case (gunbc.recurring_failure_mode.a_fleet_route_keyed_by_an_unanchored_address_outlives_its_address).",
        out_of_scope: "Joining any host to the tailnet; the tag question for butch, already with its own lane; BMC transport, which is never touched from here.",
        handback: "A key mismatch that means what it says: enrolled anchor, presented key, both fingerprints, refusal."
      ), on: "2026-11-21", note: "Verified 2026-11-21: fleet_host_key_enrollment carries enrollments with explicit provenance standing and the known_hosts wire (extdeps.ssh.known_hosts, extdeps.ssh.client_options); the fleet-wide claim that hosts are reached by tailnet name is the ruling of 2026-11-17 in gunbc.plans.fleet_machine_authority. The gap is coverage and read-back, which is why this row cites rather than forks that plan.")),
      dispatch: dispatchable(),
      parent: in_project(project: "fleet-truth-follows-the-machine", contribution: "The identity axis: without an anchor, 'the machine at that address' is the only claim the model can make, and addresses are reassigned."),
      centering: plan(text: "desired_state_follows_the_machine_plan: address vs identity. Target: dag/gunbc/fleet/fleet_host_key_enrollment.dag's anchor roster, read back by the per-host read."),
    ),
    roadmap_node(
      identity: "rn_VBA8U9YSHCKNAQS8SMRPXUZCL8",
      id: "fleet-truth-unit-orphans-closed",
      owner: "model",
      carriers: carrier(path: "dag/gunbc/fleet/fleet_physical_inventory.dag"),
      line: ticket(t: updated(t: fields(
        headline: "The enabled units naming gone hardware are closed by their owners, and the read shows the host agreeing",
        displaced_cost: "butch (srv14) lost all four A2 boards on 2026-11-17 and its serving units stay enabled, ready to start at every boot; dan (operator_host_6ce85c, the host the report calls h11) runs strata-expert-lock.service enabled, pinning memory for A16s that left in the 2026-11-12 swap to R9700s. The stale desired state is not merely wrong -- it holds a resource no role can use, and it fails at boot where nobody is watching.",
        boundary: "The instances, through their owners: butch's serving engines retire by the operator's own hand (gunbc.design_ruling::butch_serving_retirement_is_operator_handled_2026_11_21, operator decision 2026-11-21, explicitly outside the converge route), and dan's expert-lock retires through the unit route. Neither retirement is this row's to perform. What this row owns is the join -- unit's declared device class against the host's enumeration -- and the follow-up read that shows agreement, so the class cannot recur at the next host.",
        first_slice: "The join expressed once: for each unit the model enables on a host, the device class it depends on and the enumeration that answers it, with the orphan as a typed arm; dan's expert-lock is the first instance closed with it.",
        red_control: "An enabled unit whose declared device class enumerates nothing, admitted to a roster, keeps this open (gunbc.recurring_failure_mode.an_enabled_unit_names_hardware_that_no_longer_enumerates). A retirement performed by hand on the host with no read afterwards is not accepted as closure.",
        out_of_scope: "Performing any retirement or package removal on a host; butch's untagged join, which is its own lane; anything that touches a BMC.",
        handback: "Two hosts whose desired state matches their hardware, and a join that makes the third one impossible."
      ), on: "2026-11-21", note: "Verified 2026-11-21: gunbc.fleet.fleet_physical_inventory::butch_a2s_removed_pending_sale carries the four A2 boards as removed on operator report with the sale still pending; the 2026-11-12 A16-out/R9700-in swap on the h1ssl board is recorded in the same module; strata-expert-lock.service appears in gunbc.serving.serving_host_memory. The hardware-to-derivation join itself stays with gunbc.plans.fleet_hardware_fact_consumption -- this row is its run-time instance, cited not duplicated.")),
      dispatch: dispatchable(),
      parent: in_project(project: "fleet-truth-follows-the-machine", contribution: "The units-vs-hardware axis, closed where it was actually found."),
      centering: plan(text: "desired_state_follows_the_machine_plan: units vs hardware. Target: the unit-to-enumeration join over dag/gunbc/fleet/fleet_physical_inventory.dag and gunbc.systemctl_show_read, with the named hosts as instances."),
    ),
    roadmap_node(
      identity: "rn_NZ70R0W7CR36XFSGJNDKPS74J0",
      id: "fleet-truth-serving-leaf-caps-joined-to-working-set",
      owner: "model",
      carriers: carrier(path: "dag/gunbc/serving/serving_host_memory.dag"),
      line: ticket(t: updated(t: fields(
        headline: "The cap that binds a serving role is read at the leaf and joined to the working set that role declares",
        displaced_cost: "srv4's service-level MemoryHigh of 40 GiB put the expert set below residency: 5.1 tok/s with 41.5 GB read per request, against 24.5-29.1 tok/s once the cap was 56 GiB with MemoryCurrent at 46.5 GiB. A fivefold cliff, no alarm at the cap, and the model's own slice figure described a shape that no longer bound anything. The tree recorded the repair and not the rule, so the next editor of a drop-in can repeat it.",
        boundary: "Reading the LEAF cap that binds each role (the service's own MemoryHigh, not the slice above it) and refusing a placement where that cap sits under the working set the role declares. Reads and refusals only: no cap value is changed here, and srv3/srv4/butch caps are explicitly fenced by the operator's priority ruling until clever-raven-401 signs off.",
        first_slice: "Leaf-cap read plus the declared working set on the engine rows, with the mismatch as a typed arm and a witness planting a cap under a declared working set.",
        red_control: "A role placed on a host whose binding leaf cap is under its declared working set keeps this open (gunbc.recurring_failure_mode.a_cap_set_here_surfaces_as_degradation_there). A cap read from a cgroup the role does not run in is the RED case -- that is how the 40 GiB was missed.",
        out_of_scope: "Any change to a cap, slice or drop-in on a live host; the runner-slot envelope, which gunbc.host.memory_envelope already owns; the concurrency limit srv4 answered 429 with, which arrives as a declared figure rather than as a discovered one.",
        handback: "Serving caps that say what they bind, joined to what the role needs, refusing instead of degrading."
      ), on: "2026-11-21", note: "Verified 2026-11-21: gunbc.serving.serving_layout::srv4_grant carries the 5.1 against 24.5/25.1/29.1 tok/s figures and the reads per request, and gunbc.serving.serving_host_memory::srv4_serving_engine_memory carries the 56 GiB cap with the old shape in its provenance. The slot-side shape is already enforced by gunbc.host.memory_envelope; the serving side is not, which is the whole of this row.")),
      dispatch: dispatchable(),
      parent: in_project(project: "fleet-truth-follows-the-machine", contribution: "The caps-vs-working-set axis: the report's quietest tier, because a fivefold slowdown is a legal answer."),
      centering: plan(text: "desired_state_follows_the_machine_plan: caps vs working set. Target: dag/gunbc/serving/serving_host_memory.dag's engine rows and the leaf-cap read, with the mismatch refused at placement."),
    ),
    roadmap_node(
      identity: "rn_DGSZ32J4QFKMKBQYC25T6WEZDG",
      id: "fleet-truth-prefix-cache-sized-to-population",
      owner: "model",
      carriers: carrier(path: "dag/gunbc/serving/serving_replica_configuration.dag"),
      line: ticket(t: updated(t: fields(
        headline: "A prefix cache's capacity stated against the concurrent-agent population, with the hit ratio carried as a typed observation",
        displaced_cost: "Strata's prefix cache defaults to six checkpoints, sized for one conversation at a time; four concurrent agents evict one another through it, the pass reports three hits against fifty misses, and every turn pays a 32 s re-prefill where a hit costs 3 s. Nothing anywhere carries a hit ratio, so the tree could not know, and the model already places by cache bytes against slots (serving_warm_sessions_within) without ever asking how many agents are inside those slots.",
        boundary: "The capacity stated in the units the workload consumes -- prefix bytes against resident cache, against the concurrent-agent population a host actually serves -- and the hit ratio carried as a typed observation so a future tuning decision reads a measurement instead of a default. srv1's LMCache configuration stays as configured; this is about the inherited default, not about that host.",
        first_slice: "The population joined to the cache capacity on the rows that already carry cache bytes and slot counts, plus the hit ratio as a typed observation on a serving pass.",
        red_control: "A host serving more concurrent agents than its declared cache capacity can hold, still placed, keeps this open (gunbc.recurring_failure_mode.a_capacity_default_sized_for_one_workload_shape_inherited_by_another). Empty or absent hit-ratio output counted as fine is the RED case.",
        out_of_scope: "Any --prompt-cache value on a live host -- no tuning from here; the ctrl harness's own cache, which is another repository and is raised as a question rather than taken as work.",
        handback: "A cache capacity the model can be wrong about loudly, instead of a latency its readers explain away."
      ), on: "2026-11-21", note: "Verified 2026-11-21: gunbc.serving.serving_host_memory carries conversation_cache bytes and conversation_slots per engine row and serving_warm_sessions_within declares cache against slots; gunbc.serving.turn_admission already carries the refusal vocabulary (ResidencyUnread, GpuPrefixUnread) a miss belongs in. No row carries a checkpoint count or a hit ratio.")),
      dispatch: dispatchable(),
      parent: in_project(project: "fleet-truth-follows-the-machine", contribution: "The silently-wrong face of the same axis: a limit whose breach never surfaces at all."),
      centering: plan(text: "desired_state_follows_the_machine_plan: the report's tier 0, the case with no refusal to stand on. Target: the cache and slot figures in dag/gunbc/serving/serving_host_memory.dag, joined to the population in dag/gunbc/serving/serving_replica_configuration.dag."),
    ),
    roadmap_node(
      identity: "rn_E3HDLEAVCJ0KA4579BUFTRU8AR",
      id: "fleet-truth-probes-refuse-not-absence",
      owner: "model",
      carriers: carrier(path: "dag/gunbc/serving/h11_r9700_strata_bench_receipt.dag"),
      line: ticket(t: updated(t: fields(
        headline: "An instrument that cannot read reports a refusal, never an empty column -- vendor-aware probes and no pattern-kills",
        displaced_cost: "The benchmark GPU sampler shells out to nvidia-smi; on the R9700 host it threw per sample inside a background thread and the receipt came out with empty power columns -- a completed run, a produced receipt, and a measurement that never happened. Separately, pkill -f matched the SSH command carrying it and killed the session three times.",
        boundary: "Missing data as a typed refusal rather than as absence, and an instrument never inside the population it reads or kills: a vendor-aware accelerator probe with an explicit not-applicable-on-this-vendor arm (the fleet is NVIDIA AND AMD), per-sample failures surfacing to the caller rather than dying off-thread, and fleet operations that address a work-instance identity instead of a text pattern.",
        first_slice: "The sampler's failure arms typed (probe absent on this vendor, probe failed, reading present) and a witness that a missing column cannot be produced silently.",
        red_control: "A receipt with an absent measurement and no refusal naming why is the RED case, whether the probe threw, was off-thread, or was never applicable (gunbc.recurring_failure_mode.failed_value_read_scored_as_value_absent). A kill or liveness check whose pattern can match its own invocation is the second RED case (gunbc.recurring_failure_mode.observer_inside_its_own_observed_population).",
        out_of_scope: "The truth-read's own arms, which are the read row's; benchmarking policy; any host run.",
        handback: "Receipts where an absence always carries its cause, and pattern-kills out of fleet operation."
      ), on: "2026-11-21", note: "Verified 2026-11-21: the sampler's crash on the AMD host is recorded in the comment on dag/gunbc/serving/h11_r9700_strata_bench_receipt.dag; the actuating twin of the self-match is the report's pkill specimen, added to the existing row rather than filed as a new one because the ceiling -- a liveness or kill operation keyed to a work-instance identity, executable identity having been refuted in review 61176 -- is the same one the row already states.")),
      dispatch: dispatchable(),
      parent: in_project(project: "fleet-truth-follows-the-machine", contribution: "The read is only as good as its instruments: a read that fails into absence is a lie with a timestamp."),
      centering: plan(text: "desired_state_follows_the_machine_plan: tier 4 of the report, the tier that would otherwise make the read itself untrustworthy. Target: the accelerator probe behind dag/gunbc/serving/h11_r9700_strata_bench_receipt.dag and the pattern-kill idiom in fleet operations."),
    ),
    roadmap_node(
      identity: "rn_AYHH104UYXBSJUVP94BE4X03S2",
      id: "fleet-truth-declared-incompleteness-refuses-use",
      owner: "model",
      carriers: carrier(path: "dag/extdeps/external_authority.dag"),
      line: ticket(t: updated(t: fields(
        headline: "A row whose own standing declares it incomplete refuses entry into a comparison, an access decision, or a receipt",
        displaced_cost: "The R9700 and Gigabyte figures are TranscribedUncited and still entered an accelerator purchase comparison; the RTX 2000 Ada catalog declares no memory_bandwidth and was still used where bandwidth decides; the h1ssl unit-1 intake receipt carries accounts_and_ssh_keys_report as NotRelayed while that host's access was gated by a key outside the fleet's authorized-keys roster. Three declarations of incompleteness, one consumer behavior: none was read before use.",
        boundary: "Standing read as an input to the decision: TranscribedUncited, NotRelayed, or an absent field must be visible to the consumer that selects the row, and a conclusion built on such rows carries that standing in its own text. This extends the rate-table rule already in place; it does not create a second provenance model.",
        first_slice: "The comparison and access paths that consume hardware-catalog and intake-receipt rows, refusing or downgrading with the standing named, with a witness per path.",
        red_control: "A decision whose inputs include a row whose standing says incomplete, with that standing nowhere in the conclusion, keeps this open (gunbc.recurring_failure_mode.declared_uncitedness_ignored_by_admission).",
        out_of_scope: "Sourcing the missing citations, which is the operator's and the intake lanes' work; relaying the h1ssl accounts-and-keys report, which is its own owed receipt; the purchase decision itself.",
        handback: "Rows that cannot be consumed as more complete than they declare themselves."
      ), on: "2026-11-21", note: "Verified 2026-11-21: extdeps.gpu.gigabyte carries gigabyte_r9700_ai_top_figures_standing as TranscribedUncited; extdeps.gpu.nvidia's nvidia_rtx_2000_ada_catalog has no memory_bandwidth figure; gunbc.machine_intake.supermicro_h11ssl_unit1_hand_install_receipt carries accounts_and_ssh_keys_report with a NotRelayed relay state. The rate-table refusal already exists; what is missing is the same rule at the comparison and access sites, which is why this row updates the existing one rather than filing another.")),
      dispatch: dispatchable(),
      parent: in_project(project: "fleet-truth-follows-the-machine", contribution: "The epistemic half: a read that is trusted past its own declared gaps is the same failure wearing a lab coat."),
      centering: plan(text: "desired_state_follows_the_machine_plan: tier 5, the model-gaps tier. Target: the standing fields in dag/extdeps/external_authority.dag and the machine-intake receipts that consume them."),
    ),
    roadmap_node(
      identity: "rn_6WBAWKDJWDPYQ0C2D1746B8C9T",
      id: "required-check-names-what-it-executed",
      owner: "ci-control",
      carriers: concat(carrier(path: "dag/gunbc/witness/compiler_gate_workflow.dag"), carrier(path: "src/v2/cli/population_verbs.dag")),
      line: ticket(t: fields(
        headline: "A required check that reports success names what it executed",
        boundary: "The required check v2-bootstrap is the only job in .github/workflows/witnesses.yml, 1060 lines with the job declared at :33, and it publishes nothing about its own execution. Measured on 2026-11-24 through the checks API: at head 19e07867777f the v2-bootstrap check-run has conclusion success with output.title null, output.summary null, output.text null and 0 annotations, and the same shape at head e661214d2b17f2d07009bf1fb116b95c49885131, where 0 of the 5 check runs publish any non-null summary at all. The workflow writes step outputs -- GITHUB_OUTPUT appears 45 times -- and writes no step summary: GITHUB_STEP_SUMMARY 0 hits and the key summary: 0 hits in the same file. So a reviewer, a merge bot and the admission model all see a green mark that carries no population: not which entry groups ran, not how many witnesses, not which corpus roots, and not whether the run stopped before the corpus at all. The workflow is not editable as text. Its first two lines are a generated-artifact header -- Generated by gunbc.witness.compiler_gate_workflow expected_compiler_gate_yml, do not hand-edit, authority gunbc.witness.compiler_gate_workflow compiler_gate_workflow, regen via gunbc.instruments.generated_artifact_gate main_wet -- so the only legitimate route to a published summary is the generator symbol expected_compiler_gate_yml in dag/gunbc/witness/compiler_gate_workflow.dag, regenerated through main_wet. And the registry does not cover it: dag/gunbc/generated_artifact_registry.dag carries 0 hits for workflows, 0 for witnesses, 0 for expected_compiler_gate_yml and 0 for gate_yml, beside a positive control of 19 hits for main_wet in dag/gunbc/instruments/generated_artifact_gate.dag. A generated artifact outside the registry is one heal cannot converge, which is the same hole this lane recorded for the stage0 mirrors, now measured on the check that gates merges. This is the rendering half of one contract, and the other half has a named owner that this row does not restate: the open node ci-executed-coverage-receipt, identity rn_8XBLW9DKZH5NCQ0RTVPMGJ4F2, same owner and same project, keeps the verdict half -- that is what its out_of_scope means by only that a verdict names the work that produced it -- and its row carries the partition note in its updates layer, added 2026-11-24, so the two rows are one contract read at two levels and not two owners of one question. That row is not edited here and its criteria do not move. The distinction is not decoration, it is measured: the verdict half is true and green by execution, while at the published level the same sentence is simply false today -- gunbc.merge_admission classifies coverage as CheckCoverageComplete, CheckCoverageStopped and CheckCoverageDeniedEmptyRequiredPopulation, and dag/test/claim/closing/ci_executed_coverage_receipt_closing_contract_witness.dag consumes that classifier and is green by execution at 227119c8e8c7cd3ff5d6affbefe42fc8d7f94863 with four PASS lines and CLAIMS_RC=0. A verdict naming its work and a check annotation naming its work are different carriers, and only the first is closed. Two claims about absence were measured and one of them is worthless, so it is recorded as worthless here rather than cited: the witnesses optional_field_read_admission_gap_witness and guarantee_floor_class_probe_witness have 0 hits in witnesses.yml beside a positive control that fires 7 times, which is evidence; the same two names have 0 hits in compiler_gate_workflow.dag, but that file names no claim witness at all -- the only *_witness token in its 1334 lines is build_witness, once -- so a zero there is the expected shape of the file and proves nothing about enrolment.",
        displaced_cost: "A required check that executed nothing is indistinguishable, from the published result, from one that executed everything. That is the precondition for the class this lane keeps meeting: a scheduled check reporting a verdict while its corpus never ran. Today the only way to learn what v2-bootstrap executed is to read step stdout in the Actions log, which is not part of the check, is not carried into admission, and disappears from the merge decision the moment the run ages out.",
        first_slice: "Read the published output of one required check at a named sha through the checks API and record output.title, output.summary and output.text exactly as observed, nulls included, with the check-run url. Then bind the executed population into that published output for the same check: the entry groups that ran, the witness count, the corpus roots, and -- when the run stopped before the corpus -- the upstream cause, so the published fields distinguish a corpus that ran and agreed, a corpus that ran and disagreed, and a corpus that never ran. The numbers must come from the run that produced them: src/v2/cli/population_verbs.dag already carries the parse-population verb, 16 hits, whose report reaches stdout and nothing else, so the binding is between that report and the generator, not a recount in the workflow.",
        red_control: "A run whose executed population is empty must not report success: with zero entry groups or zero witnesses the check refuses with a named cause in its published output rather than concluding success with null fields, and a run that did execute publishes a non-null summary naming its counts. Both arms at the same sha, in the same workflow, with the command's real exit status on its own line and the check-run JSON pasted for each arm. A control that only renames a verdict or a step is a resolve failure, not a red -- the discriminating input is an empty population reaching a check that would otherwise conclude success. And because the workflow is generated, the green arm must show the generated file and the generator agreeing byte for byte, not a hand-edited workflow that the next regen would erase.",
        out_of_scope: "Per-witness enrolment and what the corpus contains or how it is selected -- that is the coverage node's territory, and this row changes no population. No change to the verdict model in dag/gunbc/merge_admission.dag, which is landed and consumed. No hand-edit of .github/workflows/witnesses.yml: it is generated by expected_compiler_gate_yml and a hand edit is the defect this lane has been closing all week, not a route. Of the three routes to a published summary, two are fenced and one is not planned around: the generator dag/gunbc/witness/compiler_gate_workflow.dag waits on pull request 16895, the workflow it emits inherits that fence, and src/v1/stage0/src/cli_run/native_lane_runner.rs is hand-written seed Rust needing an operator ruling, so nothing is planned around it. Adding the workflow to dag/gunbc/generated_artifact_registry.dag is in scope for this row, since the registry gap above is measured here.",
        handback: "The check-run JSON before and after with the three output fields named and their values shown; the executed-population counts bound into the published output, read from the producing run; the zero-population refusal arm executed, with its own exit status; the generator and the generated file shown agreeing, with the regen path named; the registry row added for the workflow with its digest; the route taken named with the fence state at the time of the change; and a statement of what remains fenced, rather than a green mark that hides it."
      )),
      parent: in_project(project: "ci-end-to-end-execution", contribution: "A required check's published result carries the population it executed, so a green mark is evidence about work and not merely about a run"),
    ),
    roadmap_node(
      identity: "rn_U458I947BJB50XAHKWDIR9YBJI",
      id: "bare-124-timeout-readers-consume-the-bound-observation",
      owner: "fleet",
      carriers: concat(concat(carrier(path: "dag/extdeps/bmc/ipmi_session.dag"), carrier(path: "dag/gunbc/dispatch_credential_snapshot.dag")), carrier(path: "dag/gunbc/machine_intake/ampere_smpro_observation.dag")),
      line: ticket(t: fields(
        headline: "The three remaining bare exit-124 reads take the bounder's typed execution-bound observation, and each refuses when it cannot read it",
        displaced_cost: "A timeout label that was never observed is consumed as a fact. A BMC read that an operator interrupted is recorded as IpmitoolReadDeadlineExpired and the operator is never looked for; a credential-snapshot read that died another death is recorded as SnapshotReceiptReadTimedOut and retried as if the storage were the suspect; an SMPro probe that died of anything else is stamped timed_out and the machine is written off as slow. Each label sends the next decision -- retry, fallback, escalation, quarantine -- in a direction nothing observed.",
        boundary: "Three sites read GNU coreutils timeout's documented exit 124 as proof that a bound expired, with no observation that the bound fired: extdeps.bmc.ipmi_session::ipmitool_read_failure maps it to IpmitoolReadDeadlineExpired; gunbc.dispatch_credential_snapshot::snapshot_receipt_object_run_refused maps it to SnapshotReceiptReadTimedOut; gunbc.machine_intake.ampere_smpro_observation::smpro_probe_outcome stamps SmproTransportFailed { timed_out }. The repair consumes the ONE typed execution-bound observation that boot-probe-must-not-read-a-bare-124-as-a-deadline lands -- the receipt emitted by the layer that imposes the bound, reading that bounder's own enforcement diagnostic under a pinned C locale, with fired, did-not-fire and unknown kept distinct -- at each site, and deletes the bare read there. LAYERING IS PART OF THE CLASS: extdeps carries UPSTREAM facts, so what stays in extdeps.tools.gnu_coreutils is the cited exit contract (124 on expiry; 125/126/127; 128+N under --signal and --kill-after) and the diagnostic's text, while WHETHER THE BOUND FIRED IN A GIVEN RUN is a receipt and moves to the observing layer that bounds the invocation -- which means extdeps.bmc.ipmi_session, where that read sits today, is itself in the wrong layer, and this row relocates it rather than reproducing it there. An unreadable or unrecognized diagnostic is unknown and refuses by name at every site; it never defaults to fired and never defaults to did-not-fire. OUR OWN KILL ESCALATION THROUGH RunArgv IS A SEPARATE OBSERVABLE: it is observed as -1 under the v1 interpreter (src/v1/stage0/src/v1_interpreter.rs::shell_result_from_capture, code().unwrap_or(-1)); it is not 137, and it is not the same observable as GNU timeouts documented 124.",
        first_slice: "The shared execution-bound observation consumed at the three sites with the bare reads deleted: each site's verdict carries fired, did-not-fire and unknown as distinct arms, unknown refuses rather than choosing, and each site gets one named control.",
        red_control: "At each of the three sites on main: a bounded child that exits 124 of its own accord, with the bound never firing, is reported as a deadline (RED at that site, executed, with its raw lines), and after the repair it is refused while a real expiry is still reported; a planted unreadable or unrecognized diagnostic refuses by name rather than defaulting either way.",
        out_of_scope: "The boot probe's own verdict, which is boot-probe-must-not-read-a-bare-124-as-a-deadline's; the harness, which already does this correctly (gunbc.harness.harness_shell_job cross-checks an observed reap time and returns JobBackstopUndecided when it cannot observe one -- the pattern this class copies, not a site to repair); any new timeout mechanism; any wall-clock reading substituted for the observation; any change to what the bound is or when it is placed.",
        handback: "Three sites where a timeout claim is a receipt from the bounder or a named refusal, the bare-124 vocabulary gone from them, and the upstream exit contract cited once in extdeps.tools.gnu_coreutils."
      )),
      dispatch: dispatchable(),
      parent: in_project(project: "fleet-truth-follows-the-machine", contribution: "A timeout is something we observed our own bound do, not a property of an exit code; three of the fleet's timeout labels become receipts or refuse."),
    ),
    roadmap_node(
      identity: "rn_VBOJ5RN56RBVGNPOK3FPVVXBE2",
      id: "regen-round-executes-the-binary-its-digest-gate-reads",
      owner: "self-host",
      carriers: concat(carrier(path: "src/v1/stage0/src/required_regen_host.rs"), carrier(path: ".github/workflows/heal.yml")),
      line: ticket(t: fields(
        headline: "A regen round executes the same claim_executor image its own executable-digest gate reads",
        boundary: "THE GATE AND THE LAUNCH PATH MUST AGREE ABOUT WHICH BINARY THEY MEAN. The generation-2 admission gate at src/v1/stage0/src/required_regen_host.rs:7740 takes observed_executable_digest from current_exe_digest (defined :6502, which reads the bytes of the running image off disk) and compares it at :7741 against admitted_executable_digest, whose closure is supplied at :9199 as next_pass_executable_digest(workspace) -- defined :7663, path built at :7664 as workspace.join(target/release/claim_executor). CARGO_TARGET_DIR appears 0 times in this file (git show origin/main:src/v1/stage0/src/required_regen_host.rs | grep -c CARGO_TARGET_DIR, rc 1), so redirecting the build moves the binary a lane execs and not the file the gate reads. The refusal text is the literal at :7743. The arm sits on the install path, reached only when there is drift to install: a no-drift round prints first_generation_equal=true and stays green forever, so the instrument can be dead for exactly the case it exists for and no routine heal run will show it. Two lanes met it on 2026-11-24 with the same shape: bold-ibex-678 launched target_base/release/claim_executor (sha256 acc2ad47 prefix) while the gate read regen_scratch3/target/release/claim_executor (6b33d3e5 prefix) and got REGEN_RC=1 after seed_build 9 minutes and built_seed_regen 17 minutes, its 252 candidates never admitted; eager-heron-455 was refused in a cold copy with admitted fnv1a64:3b0e06e6494e3ef8 against would-run fnv1a64:c5d13686809c556f. The canonical invocation is .github/workflows/heal.yml:113, which builds in the workspace and execs target/release/claim_executor by RELATIVE path -- the form that makes the two digests the same file.",
        displaced_cost: "A lane with real drift spends a full round (about 26 minutes of seed build plus emit, and a shared heavy slot) and receives a checkpoint restore instead of an install, with the cause naming two digests and no path -- and lanes that never hit it cannot tell that the instrument is dead, because the no-drift path stays green.",
        first_slice: "Put the pre-flight in the lane recipe and prove it on one round: print sha256 of the binary about to be exec'd and sha256 of the workspace's target/release/claim_executor, require equality before the slot, and run one admitted round launched by the relative path with the heavy-slot acquisition line in the log.",
        red_control: "Red arm: at one named main sha, a --regen-round-cost --base-mirror round launched from any copy that is not the workspace's target/release/claim_executor must refuse with the text of the literal at required_regen_host.rs:7743 (CandidateGeneratedByDifferentSeed: stage admitted executable <digest> but next generation would run <digest> at <path>), with the real exit status on its own line and both digests printed. Green arm: the same tree, same sources, same round, launched as target/release/claim_executor, admitted. Dry arm, with the precedent already local at dag/test/claim/generated_artifact_merge_driver_recipe.dag:46: a claim witness asserting that every recipe line for --regen-round-cost names the relative target/release/claim_executor path, with a planted copy-path line that must make it fail. red_at and green_at are OPEN until that pair is recorded at one sha; two refusals exist on 2026-11-24 logs (bold-ibex-678 acq11, eager-heron-455 s5d) at different heads, which is not yet a recorded pair.",
        out_of_scope: "The two obvious fixes are BOTH edits to hand-written v1 seed Rust in src/v1/stage0/src/required_regen_host.rs -- naming both paths in the refusal, and honouring CARGO_TARGET_DIR at :7664 or refusing at launch. The operator ruled 'Hold, no seed growth' on a comparable instrument-only seed change on 2026-11-24, so implementing either waits on an operator seed-change ruling; prefer a route that does not touch the seed. There is no v2-side equivalent of the gate: src/v2/workflow/required_regen.dag carries digests as opaque Strings (:67, :68, :218) and has no executable-identity concept, so it cannot express the check. Not in scope either: what a round emits, the base-mirror selection, or the checkpoint restore itself.",
        handback: "The lane recipe with the pre-flight in it; one admitted round's log carrying the acquisition line, both sha256 values equal, and REGEN_RC on its own line; the refusal reproduced once at a named sha with its text pasted and its rc on its own line; red_at and green_at recorded; and the operator ruling that either freed the two seed sites or kept them frozen, quoted in gunbc.design_ruling."
      )),
      parent: in_project(project: "demand-engine", contribution: "A heal or regen round runs the image its own digest gate admits, so a lane carrying drift gets an install instead of a restore.")
    ),
    roadmap_node(
      identity: "rn_MDGKH2UR7XGMNPT3AMWLAXVFO2",
      id: "floor-optional-projection-wall",
      owner: "compiler-guarantee",
      carriers: concat(carrier(path: "src/v1/04_infer.dag"), carrier(path: "dag/test/claim/optional_field_read_admission_gap_witness.dag"), carrier(path: "dag/gunbc/recurring_failure_mode/optional_admitted_where_a_required_value_is_declared.dag")),
      line: ticket(t: updated(t: fields(
        headline: "A field read through an Optional refuses at the projection, not only where it is compared",
        boundary: "THREE POSITIONS CONSUME THE SAME .first(); TODAY TWO REFUSE AND THE THIRD IS SILENT. gunbc.recurring_failure_mode.optional_admitted_where_a_required_value_is_declared records that the direct-call argument, the declared list element and the undeclared list-literal member were all judged, but the field projection was not: levels().first().id compiled with no blocking diagnostic although .first() produces Level? and Absent has no id field (receipt 2026-09-29, found in review 72657 on gunbc#12572 at test.claim.machine_shape_catalog_integration_witness memory.first().id, measured admitted by gunbc#12633). Main's witness dag/test/claim/optional_field_read_admission_gap_witness.dag asserts the two positions that DO refuse: test fn a_field_read_through_first_compared_with_a_required_value_is_refused (:39) pins the equality wall EqualityOptionalityMismatch, closed for the comparison position by bbfdf92d0ca7 (gunbc#13179), and test fn the_same_first_at_a_call_argument_is_refused (:47) pins DeclaredTypeNotInhabited; both read the population through fn class_blocking_count (:27). What no row in the plan claims is the projection position itself -- a field read at a field position with nothing comparing it. Measured on 2026-11-24 by quiet-carp-72: of 7 roadmap_authority ids matching optional, projection or field, none takes it, and the function to extend appears 15 times in the tree and 0 times in dag/gunbc/roadmap/roadmap_authority.dag. The arm to extend is v1.compiler.infer::optional_at_required_obligation_diags, 6 mentions in src/v1/04_infer.dag, definition at :5754 -- a .dag change, so gunbc.v1.v1_maintenance_standing v1_seed_standing does not bar it and no new hand-written seed Rust is licensed by this row.",
        displaced_cost: "Every optional-carrying projection in the corpus is a place where absence is read as a value: the comparison catches it only when someone compares, so a projection that flows straight into a record field or a returned value carries Absent forward and the failure surfaces later, elsewhere, without a located diagnostic at the position that admitted it.",
        first_slice: "Add the projection position as a third arm of the existing witness module rather than a new test family: the projection fixture refuses with the field named, and the two arms already there stay green by name.",
        red_control: "RED ON MAIN, OBSERVABLE WITH THE INSTRUMENT ALREADY IN THE TREE: fn class_blocking_count (dag/test/claim/optional_field_read_admission_gap_witness.dag:27) returns 0 blocking rows for the projection fixture (levels().first().id at a field position) while the same source text at a call argument returns at least 1 DeclaredTypeNotInhabited via test fn the_same_first_at_a_call_argument_is_refused (:47) and the comparison arm refuses EqualityOptionalityMismatch via test fn a_field_read_through_first_compared_with_a_required_value_is_refused (:39). Green: the projection arm refuses, naming the field and the located span, and BOTH existing test fns still pass by name. A flipped, weakened or deleted existing arm is a rework, not a pass; a projection refusal whose subject is an internal error rather than a located diagnostic is a carrier, not a wall, and does not close this row.",
        out_of_scope: "Not the comparison position, which gunbc#13179 closed and main's witness already pins. Not the record-LITERAL field position, which belongs to optional-admitted-at-record-literal-field (rn_50P0GN3GQK5MSVMMKCZWWZ8YE5); that row puts the field-projection trigger in its out_of_scope, and this one takes exactly that trigger, so the two do not overlap. Not declaration naming: T? versus an explicitly authored Optional naming one declaration belongs to cardinality-optional-declaration (rn_X9MHZ7FXWXKKS32YBXJASTZJM5). No hand-written seed Rust, per gunbc.v1.v1_maintenance_standing v1_seed_standing. Stagger: this node edits src/v1/04_infer.dag and so waits for gunbc#16894 (the Char-at-a-run-of-Int element wall) and gunbc#16895 (floor-exhaustiveness), both of which edit the same file; it is therefore authored WITHOUT dispatch -- absent dispatch reads NotDispatchable -- and is flipped to dispatchable() only once both have merged.",
        handback: "The arm as authored in .dag and where it sits relative to the existing relation; the three-arm witness run with each test fn named in a PASS log and the real rc on its own line; the measured before/after blocking counts for the projection fixture from the same command form; and a statement of which positions now route through the same relation, so the next reader can tell a wall from a coincidence."
      ), on: "2026-11-24", note: "Rostered by neat-badger-614 on the finding of quiet-carp-72, whose ladder-probe-corpus enrolment measures this hole while no row owns it. Manager ruling, verbatim: 'ROSTER it, owner compiler-guarantee, as a floor-wall node. You author the planning PR; that IS the sanctioned route, not inventing a node.'")),
      parent: in_project(project: "compiler-guarantee", contribution: "Absence at a projection is refused where it is produced, not only where someone happens to compare it.")
    ),
    roadmap_node(
      identity: "rn_3PJTV4JA4RY3IRWQ2POQOPFEZK",
      id: "generic-substitution-skips-the-subtree-under-a-type-variable-inferred-node",
      owner: "compiler-guarantee",
      carriers: concat(carrier(path: "src/v1/04_infer.dag"), carrier(path: "src/v1/04_env.dag")),
      line: ticket(t: updated(t: fields(
        headline: "Substitution never visits the children or params of a node inferred as a TypeVariable, and the miss is silent",
        boundary: "ONE MAP, TWO LOOKUP ARMS, AND THE FIRST ONE IS TERMINAL. src/v1/04_infer.dag:18654 fn substitute_generics_apply dispatches on n.inferred before it looks at the node at all. Its first arm, :18656-18660, matches Present { value: TypeVariable { id: tv_id } } and consults map_get(subst, tv_id) at :18657; BOTH of its outcomes return -- the hit at :18658 yields n or preserve_outer_optional_cardinality, and the miss at :18659 is Absent => n, no diagnostic. The only three recursive calls in the body, :18671 children, :18672 params and :18675 the Resolved inferred node, all sit in the second arm (:18661-18696), which is reached only when n.inferred is NOT a TypeVariable and which additionally gates its own name lookup on is_bare at :18663. So a node carrying a TypeVariable inference has its whole subtree skipped by substitution, hit or miss, and nothing says so. THE MAP HAS ONE KEY DOMAIN: the only writer is unify_generics at :18434, which binds by NAME -- map_insert(acc, bind_name, actual) at :18441 and :18457, gated on membership in generic_names -- so subst is keyed by generic name. TypeVariable.id is minted FROM a name at src/v1/04_env.dag:1268 and src/v1/04_infer.dag:19793, which is why the two arms usually agree and why a key mismatch is not the defect. What makes the terminal arm bite is the minter that does NOT use a name: src/v1/04_infer.dag:11476-11484, the deferred-field-access path, builds make_named_expr_node(... children: [base_typed], inferred: Present { value: TypeVariable { id: field_of_type_var } }) -- a node WITH children and a synthetic sentinel id that can never equal a generic name, so it takes arm 1, misses at :18659, and comes back with base_typed never visited. OWNERSHIP, WHICH IS WHAT THIS ROW EXISTS TO FIX: dag/gunbc/roadmap/roadmap_authority.dag carries ZERO mentions of substitute_generics_apply, while five recurring_failure_mode rows name it -- error_type_fabricated_as_a_type_by_total_accessors, field_access_on_a_generic_call_result_keeps_the_uninstantiated_parameter, generic_identity_decided_by_spelling, generic_optional_over_a_type_application_argument_loses_the_optional and silent_first_wins_rebind_of_a_generic_type_variable_in_unify_generics. Five declared holes point at one mechanism that no roadmap row owns. NOT CLAIMED HERE, AND NOT TO BE READ AS CLAIMED: that any particular program is mis-judged, or that the sentinel site is the only way in. That is what first_slice measures. The spelling-decided half, is_type_variable_name at :18245-18247 hardcoding T, K, V, MappedElement and FoldAccumulator, is already carried by generic_identity_decided_by_spelling and is not this row's to take.",
        displaced_cost: "Six holes are unwitnessable until this is repaired: the five recurring_failure_mode rows above plus list-append-refuses-an-element-argument, whose repro stays silently accepted; whether the formal keeps an unsubstituted child is a HYPOTHESIS AND NOT A MEASURED CAUSE, because the executed census in first_slice returned SWALLOW=0 on the measured population. Each is currently carried as an accepted program, so every green in that neighbourhood is a green over a subtree the traversal never entered.",
        first_slice: "A census, not a fix. Count, over the corpus, the nodes that reach substitute_generics_apply with n.inferred = Present { value: TypeVariable { _ } } AND non-empty children or params -- the shape arm 1 swallows -- reported per module with the sites named and the totals printed, so the population is a number and not an impression. Then take src/v1/04_infer.dag:11476-11484 end to end as the concrete instance: construct the deferred-field-access-on-a-type-variable-base specimen, show its child keeping the unsubstituted spelling under main's RELEASED binary, and show what a refusal would require. The census decides whether the repair is local to arm 1 or reaches every generic application, and it is the number this row's dispatch is gated on. eager-heron-455 is taking it as input to list-append-refuses-an-element-argument; the measurement belongs to this row and the row waits for it. MEASURED 2026-11-25 by eager-heron-455 on an instrumented scratch build (HEAVY_OWNER slot 7/12 acquired 19:13:00Z, BOOT c095c0cd, cgroup heavy-slot-3995600.scope, build 14m23s, C1_SLOT_REAL_EXIT=0, seven entries all C1_RUN_REAL_EXIT=0, hard_diagnostics=0): over 7 modules applications=16508, visited=82143, arm1=19681, HIT at :18658 =19021, silent MISS at :18659 =660, and SWALLOW=0. The gate at :11474-11475 has both halves true at 8 sites, 5 in src/v2/compiler/tokenize.dag and 3 in src/v2/std/text.dag, so the sentinel minter path is ordinary rather than rare. Two consequences are fixed by that number rather than by reading. The repair direction is to recurse into the substituted node children after a hit, NOT to make arm 1 fall through to arm 2, because hits are 96.65 percent of arm1 and misses 3.35 percent. And on the measured population the arm-1 asymmetry is a LATENT hazard, not an established cause of any accepted program, because nothing was swallowed. ONE NAMED BLIND SPOT remains and it gates dispatch: the census wrapper early-returns on map_is_empty without emitting a record, so an application arriving with an empty substitution map is invisible to it, which is exactly the arrival shape that would print SWALLOW=0 while a real swallow sat underneath. Closing that counter on the same instrument is the first measurement at dispatch.",
        red_control: "NOT YET OBSERVED, AND THIS ROW IS NOT DISPATCHABLE UNTIL IT IS. Recorded honestly rather than retrofitted: no executed control names a compiler behaviour in this field today, which is the condition the lifecycle fixes by planning rather than by dispatch. WHAT IS ALREADY MEASURED is the ownerlessness, and it is what justifies the row existing at all: zero mentions of substitute_generics_apply in this file (git show origin/main:dag/gunbc/roadmap/roadmap_authority.dag | grep -ac substitute_generics_apply -> 0) against five recurring_failure_mode rows naming it (git grep -l substitute_generics_apply origin/main -- dag/gunbc/recurring_failure_mode/*.dag -> 5 files), plus the arm structure read from main's bytes at :18654-18696 with the citations in boundary above. WHAT MUST REPLACE THIS FIELD BEFORE DISPATCH: an executed control, run through HEAVY_OWNER on srv1 with the acquisition line, HOST, BOOT, pid, owner, tree sha and the real exit status each on their own line, in which a specimen whose formal is a deferred field access on a type-variable base is SILENTLY ACCEPTED on main's RELEASED claim_batch -- sha256 read from disk and matched to release-bins.manifest, never built from the PR lineage -- and REFUSED by the branch binary, with the instrument check printed first on the binary that runs: grep -ac over the diagnostic literal, with a control literal in the same log so a zero is an absence and not a missing string. RedProbe (dag/gunbc/roadmap/roadmap_status.dag:78) is the route if the behaviour is already correct on some tree; probe_ref red-control/generic-substitution-skips-the-subtree-under-a-type-variable-inferred-node is pushed and never merged.",
        out_of_scope: "Not the six symptom nodes own refusals, which stay in their own rows; this row makes them observable, it does not implement them. Not is_type_variable_name spelling identity at :18245-18247, carried by generic_identity_decided_by_spelling. Not the constructor-roster three-way split and its nineteen false-positive sites, carried by accepted_source_emits_uncompilable_target component (vi). Not the emit or Rust surfaces, not the v1 freeze, and not any change to a pinned design.",
        handback: "The census table with counts per module and the sites named; the verdict on locality, whether arm 1 can be made to recurse without disturbing generic applications that are correct today, with the before and after samples to back it; the executed control that replaces this field, carrying binary sha256 from disk, the acquisition line, the raw PASS and FAIL lines and the real exit statuses; and the list of which of the five sibling recurring_failure_mode rows the repair discharges, joined by named identity, so the holes retire together instead of one at a time.",
      ), on: "2026-11-25", note: "ROSTERED AS OWNED, NOT YET DISPATCHABLE, ON NEAT-BADGER-614'S RULING OF 2026-11-25. The defect being fixed is ownerlessness, and it was measured before the row was written: zero mentions of the mechanism in this file against five recurring_failure_mode rows naming it. The first arm's terminal structure was read from main's bytes by bold-pike-529 at 959a23ac01f, correcting an earlier two-key-domain reading that both the lane manager and eager-heron-455 had been repeating with wrong line numbers. Heron's census becomes this row's red_control by a later edit, before dispatch.")),
      parent: in_project(project: "compiler-guarantee", contribution: "A generic application is judged against the type its arguments actually have, so a formal that was instantiated cannot be compared against a child that was never instantiated"),
    ),
    roadmap_node(
      identity: "rn_RNY67KVQ3FG5GVXYZX75DGSH6L",
      id: "floor-class-probes-have-no-dark-suite-migration-disposition",
      owner: "compiler-guarantee",
      carriers: concat(carrier(path: "dag/gunbc/guarantee_probe_corpus.dag"), carrier(path: "dag/test/claim/guarantee_floor_class_probe_witness.dag")),
      line: ticket(t: fields(
        headline: "Every floor-class dag probe is absent from the dark-suite migration ledger, so no retained Rust witness for these classes can ever be retired",
        boundary: "MEASURED AT MAIN 0d399a799b64 by the lane manager, counts printed, replication independent of the reporter. In dag/gunbc/guarantee_probe_corpus.dag, fn guarantee_probe_rows() at :539 declares 39 GuaranteeProbeRow rows; 37 carry path: v1_compile_rust_path_id; 15 of those 37 have floor-prefixed probe names: floor_exhaustiveness_type_variable_hole_probe, floor_field_through_generics_record_control_probe, floor_field_through_generics_green_probe, floor_field_through_generics_hole_probe, floor_generic_instantiation_green_probe, floor_generic_instantiation_monomorphic_control_probe, floor_generic_instantiation_hole_probe, floor_parse_list_separator_control_probe, floor_parse_list_separator_green_probe, floor_parse_list_separator_hole_probe, floor_record_completeness_bare_name_control_probe, floor_record_completeness_green_probe, floor_record_completeness_red_probe, floor_record_completeness_zero_field_product_control_probe, floor_record_completeness_zero_field_variant_control_probe. fn guarantee_probe_dark_suite_dispositions() at :486 carries 5 MigratedToEnrolledDagProbe dispositions with 12 distinct dag_probes, and its intersection with those 15 is empty, so all 15 are uncovered. The witness that should catch this is dag/test/claim/guarantee_probe_corpus_witness.dag:897 dark_suite_dispositions_cover_migrated_v1_probes: it builds its population from a hard-coded dag_native_v1_compile_probe_ids list written inside the witness itself at :917, not from the corpus rows whose path is v1_compile_rust_path_id, so the floor class sits outside the partition the claim checks and the claim passes by construction for exactly the population that is missing. The ledger comment at :478-483 states the obligation this node enforces: one enrolled measurement authority per class, MIGRATE never duplicate, with a finite-classification gate naming when the Rust copy is dispositioned. With no disposition the retained Rust witnesses for the floor classes have no trigger, and the parallel maintenance that comment forbids becomes permanent and untracked.",
        displaced_cost: "The floor classes are the largest and newest group of enrolled probes (15 of the 37 v1-path rows) and the only group with no retirement path at all: the Rust dark suite keeps carrying equivalent coverage for them indefinitely, while the one witness that would report that instead reports coverage, so the gap is invisible to every gate on main.",
        first_slice: "Add one MigratedToEnrolledDagProbe disposition per floor class (exhaustiveness, field-through-generics, generic-instantiation, parse-list-separator, record-completeness: five classes) naming the retained Rust witness each replaces and listing its dag probes, then make the coverage claim non-vacuous by deriving its population from the corpus rows whose path is v1_compile_rust_path_id rather than from a list written inside the witness.",
        red_control: "RedProbe (roadmap_status.dag:78). Witness module dag/test/claim/guarantee_probe_corpus_witness.dag, fn dark_suite_dispositions_cover_migrated_v1_probes, executed by claim_batch --functions over that module. red_at: a child of a main sha in which one named floor probe id is omitted from the new dispositions; the claim must print the missing id and the batch must FAIL, and the same batch must show the derived-population run green, which is what proves the population is derived rather than listed. green_at: red_at first parent or later. A static count is not acceptance: the executed batch must name the witness by name and carry the planted omission in the same run.",
        out_of_scope: "NOT the canonical-ordering question. probe_ids_are_lexicographically_ordered (guarantee_probe_corpus.dag:892, comparing prev < current on id as String) over guarantee_probe_ids() at :782, which is guarantee_probe_rows() mapped to row.probe, has 39 entries and 0 order violations at main 0d399a799b64: the claim holds and no re-sort is owed. Anyone measuring a violation there is walking declaration order or another sequence and must print which sequence and its source expression. NOT the corpus row list itself. NOT the probe_set_digest receipts, which move only if the sequence moves. NOT ladder-probe-corpus, which enrols the sixth class; this node starts after that one merges, and it edits the same two files.",
        handback: "The new disposition rows, the derived-population witness, and one claim_batch PASS log naming dark_suite_dispositions_cover_migrated_v1_probes together with the planted-omission FAIL from the same run that proves the claim can go red."
      )),
      parent: in_project(project: "compiler-guarantee", contribution: "Each closes one ordinary-floor class the blocking door requires."),
    ),
    roadmap_node(
      identity: "rn_BXTBZQ7JL4H5AIXPPQ7JNG2GZD",
      id: "guarantee-probe-corpus-fixtures-exercise-no-flat-map-and-no-service",
      owner: "compiler-guarantee",
      carriers: concat(carrier(path: "dag/gunbc/guarantee_probe_corpus.dag"), carrier(path: "dag/test/claim/guarantee_floor_class_probe_witness.dag")),
      line: ticket(t: fields(
        headline: "No probe fixture exercises flat_map or a service, so the promise that a future wall cannot green by refusing the language is unmet for two of the five named invocation forms",
        boundary: "MEASURED AT MAIN 0d399a799b64 by the lane manager, counts printed with the blocks named. dag/test/claim/guarantee_probe_corpus_witness.dag declares 26 data blocks of the form source: String; counting inside the fixture string bodies only, map( occurs 2 times (method_missing_source, method_green_source), fold( 1 time (method_green_source), filter( 1 time (method_green_source), flat_map( 0 times and service 0 times. So of the five invocation forms the ladder-probe-corpus boundary names as positive controls, three are exercised and two are not exercised at all, and the guard against a wall that greens by refusing the language does not exist for those two. They are not absent because the language lacks them: flat_map( occurs 130 times and service 422 times across dag/extdeps, so the corpus simply never exercises forms that real gunbc programs depend on daily. Counting scope is part of the claim: whole-file greps count the claim bodies too and overstate coverage, which is why the numbers above are per-fixture-body.",
        displaced_cost: "A wall that refuses a legitimate flat_map or service invocation would be accepted by every probe in this corpus, and the corpus is the authority the floor classes are measured against, so the class could close while breaking ordinary code.",
        first_slice: "Enrol positive controls for the two unexercised forms as one new probe class in the guarantee probe corpus, keyed to the v1 compile path so the derived population in the coverage row counts them, each expecting a clean compile on a representative real-shaped input.",
        red_control: "RedProbe (roadmap_status.dag:78) on the same witness module. red_at: a child of a main sha in which the flat_map or service green probe is given an argument shape the wall should refuse, or the positive control is dropped while its class is claimed; the batch must FAIL naming that probe, proving the control is an observation and not a tautology. green_at: red_at first parent or later. The accepted pair is the wrong case refused and the correct case accepted in one run, with the probe named in the PASS log.",
        out_of_scope: "NOT map, fold or filter, which are measured exercised with their blocks named above; extending them is welcome but is not this node. NOT the dark-suite disposition row, which covers a different population defect. NOT the canonical probe ordering, which holds at main. NOT ladder-probe-corpus, whose boundary names the five forms; that row is deliberately NOT edited here, because boundary maps into brief and moving it would move a digest a live certification is pinned to.",
        handback: "The new probe rows and fixtures, plus one claim_batch PASS log naming both positive controls and the planted refusal FAIL from the same run."
      )),
      parent: in_project(project: "compiler-guarantee", contribution: "Each closes one ordinary-floor class the blocking door requires."),
    ),
  ], guarantee_ladder_nodes())
}

// AN EDGE HOLDS A CHILD UNTIL ITS PARENT HAS AN ACCEPTANCE RECEIPT, so a parent is chosen for what
// it OWES, never for what it historically preceded. `roadmap_program_view` puts a node in
// ObligationDependencyHeld for every declared parent lacking a receipt, which is why
// `2-scm-native-write-spine-acceptance` declares none: its only prerequisite was gunbc#10729
// landing, a landed change is not a roadmap node, and the nearest node that WOULD carry it,
// `2-scm-native-authority-program`, still owes the CAS slot consumers, the Git import wall and the
// bridge cutover. Edging to it would hold an executable row behind an entire unfinished program --
// the wrong dependency, made machine-readable, which is worse than the prose it replaced. Found by
// external review after the edge was added on exactly that reasoning.
// Shell→dag migration batch 1 edges: each node is a child of the completed exemplar
// shell-typed-invocation; the two same-file pairs (ci-deploy-invoke-prelude/ci-heal-regen-invoke,
// live-deploy-install-owned/live-deploy-restart-tailscale) carry NO edge between them — they are
// independent edits whose staggering constraint is a dispatch-scheduling fact recorded in their
// centering plans, not a dependency, and the graph has no exclusion-edge vocabulary.
fn declared_roadmap_edges() -> List<RoadmapEdge> {
  concat([
    // The capture-count debt admitted by the plan rather than by its author (vivid-swift-693, 2026-11-25):
    // the consumer row DissolutionCondition names this row, so the trigger is the plan own, not the worker own.
    edge(child: "source-annotation-fold-carries-absorbed-capture-count", parent: "parse-comment-gap-attachment-v2-consumed"),
    // The substitution skip holds list-append-refuses-an-element-argument: its repro stays silently accepted while
    // substitute_generics_apply never visits the subtree of a TypeVariable-inferred formal. See the row's boundary.
    edge(child: "list-append-refuses-an-element-argument", parent: "generic-substitution-skips-the-subtree-under-a-type-variable-inferred-node"),
    // The bare-124 class: the shared receipt lands with the boot probe's row.
    edge(child: "bare-124-timeout-readers-consume-the-bound-observation", parent: "boot-probe-must-not-read-a-bare-124-as-a-deadline"),
    // ---- #gunbc.plans.fabric_market::fabric_market_plan (2026-11-23), including the existing consumers of its common contracts:
    edge(child: "market-fix-product-mapping", parent: "market-fix-upstream-model"),
    edge(child: "execution-attempt-one-record", parent: "lease-fence-one-identity"),
    edge(child: "fabric-admission-and-delegation", parent: "lease-fence-one-identity"),
    edge(child: "market-buy-order-replacement", parent: "market-fix-product-mapping"),
    edge(child: "market-sell-order-replacement", parent: "market-fix-product-mapping"),
    edge(child: "venue-contract", parent: "market-fix-product-mapping"),
    edge(child: "venue-contract", parent: "execution-uncertainty-one-carrier"),
    edge(child: "venue-contract", parent: "execution-attempt-one-record"),
    edge(child: "venue-contract", parent: "fabric-admission-and-delegation"),
    edge(child: "matching-engine-on-std-decision", parent: "market-fix-product-mapping"),
    edge(child: "matching-engine-on-std-decision", parent: "fabric-admission-and-delegation"),
    edge(child: "matching-engine-on-std-decision", parent: "fabric-consequence-standing"),
    edge(child: "serving-router-native-transport", parent: "venue-contract"),
    edge(child: "serving-router-native-transport", parent: "matching-engine-on-std-decision"),
    edge(child: "serving-router-native-transport", parent: "router-behaviour-disposition"),
    edge(child: "serving-router-native-transport", parent: "fabric-market-plan-fold"),
    edge(child: "serving-relocation-realization", parent: "serving-router-native-transport"),
    edge(child: "serving-router-lua-cutover", parent: "serving-relocation-realization"),
    edge(child: "serving-router-lua-cutover", parent: "fabric-admission-and-delegation"),
    edge(child: "fabric-market-convergence", parent: "serving-router-lua-cutover"),
    edge(child: "fabric-market-convergence", parent: "market-buy-order-replacement"),
    edge(child: "fabric-market-convergence", parent: "market-sell-order-replacement"),
    edge(child: "fabric-market-convergence", parent: "work-exec-6-one-ledger-per-host"),
    edge(child: "fabric-market-convergence", parent: "factory-attempt-execution-on-fabric-lease"),
    edge(child: "fabric-market-convergence", parent: "demand-m5"),
    edge(child: "serving-engine-level-seller", parent: "venue-contract"),
    edge(child: "serving-engine-level-seller", parent: "fabric-admission-and-delegation"),
    edge(child: "serving-engine-level-seller", parent: "matching-engine-on-std-decision"),
    edge(child: "fabric-market-convergence", parent: "serving-engine-level-seller"),
    edge(child: "fabric-market-convergence", parent: "serving-capacity-qualification"),
    edge(child: "work-exec-2-durable-route-first-consumer", parent: "venue-contract"),
    edge(child: "work-exec-2-durable-route-first-consumer", parent: "matching-engine-on-std-decision"),
    edge(child: "work-exec-6-one-ledger-per-host", parent: "fabric-admission-and-delegation"),
    edge(child: "factory-attempt-execution-on-fabric-lease", parent: "venue-contract"),
    edge(child: "factory-attempt-execution-on-fabric-lease", parent: "execution-attempt-one-record"),
    edge(child: "demand-m5", parent: "fabric-admission-and-delegation"),
    edge(child: "demand-m5", parent: "fabric-market-plan-fold"),
    edge(child: "required-witness-floor-restored", parent: "ci-cost-floor-preparation-cut"),
    // Admitted 2026-11-24 (cool-crane-531, royal-newt-240 review 97779 on gunbc#16976): these three rows
    // consume what a run PRINTS. The acceptance recording path reads a node's plan digest out of a run and
    // names its pushed sha and ref on success; the CI-cost row's handback is the preparation measurement
    // re-derived by an entry point. Today each of those readings can only arrive inside a refusal, so the
    // rows cannot be closed while a report and a refusal are the same observation.
    edge(child: "roadmap-criteria-digest-validated-at-write", parent: "gunbc-run-success-output-surface"),
    edge(child: "acceptance-recorder-names-its-durable-destination", parent: "gunbc-run-success-output-surface"),
    edge(child: "ci-cost-floor-preparation-cut", parent: "gunbc-run-success-output-surface"),
    edge(child: "required-witness-floor-restored", parent: "required-check-named-witnesses-runs-no-claim-module"),
    edge(child: "required-witness-floor-restored", parent: "cc-evidence-to-consumers"),
    edge(child: "required-witness-floor-restored", parent: "generated-artifact-gate-red-at-main"),
    // demand_engine_program replanned as an intention (2026-11-23): identity before reuse; sidecars before
    // schedulers; the terminal waits on schedulers, measured reuse and heal's planning-only bar.
    edge(child: "native-artifact-reuse-through-request-key", parent: "compiler-identity-from-sources"),
    edge(child: "schedulers-on-the-engine", parent: "consumers-on-canonical-dependencies"),
    edge(child: "reuse-decided-by-measurement", parent: "native-artifact-reuse-through-request-key"),
    edge(child: "a-change-pays-only-for-what-it-invalidates", parent: "schedulers-on-the-engine"),
    edge(child: "a-change-pays-only-for-what-it-invalidates", parent: "reuse-decided-by-measurement"),
    edge(child: "a-change-pays-only-for-what-it-invalidates", parent: "heal-planning-only-in-a-minute"),
    // machine-shapes-join-the-cluster (2026-11-23): the cluster waits on the backend choice; each shape joins the
    // cluster; the cassette shape also waits on its printed tray.
    edge(child: "cluster-bringup-on-the-selected-backend", parent: "work-exec-1-placement-backend-selection"),
    edge(child: "h11ssl-shape-joins-the-cluster", parent: "cluster-bringup-on-the-selected-backend"),
    edge(child: "altrad8ud-shape-joins-the-cluster", parent: "cluster-bringup-on-the-selected-backend"),
    edge(child: "mtcollins-cassette-shape-joins-the-cluster", parent: "cluster-bringup-on-the-selected-backend"),
    edge(child: "mtcollins-cassette-shape-joins-the-cluster", parent: "printed-tray-realized-from-derived-partition"),
    edge(child: "gpu-families-schedulable-with-caps-held", parent: "h11ssl-shape-joins-the-cluster"),
    edge(child: "claim-entrypoints-cutover", parent: "claim-result-contract"),
    edge(child: "dp-m3-subject-ref-resolved", parent: "extdeps-subject-ref-facts-host-census"),
    edge(child: "lab-converges-release-pair", parent: "lab-standings-track-main"),
    // ---- dispatch from the simulated execution (gunbc.plans.planning_consolidation, 2026-11-17):
    // child depends on parent, the direction the witness reads. roadmap-return-to-principal-records-acceptance
    // is the return_to arm of roadmap-operator-attested-acceptance (rn_A0SYP0J1P3JE8W8OBX6M3BD777), so it
    // waits on that row: the edge names it by NAME, because the graph's endpoint law reads the node field
    // (id_exists compares e.parent against n.node), not the rn_ identity string.
    edge(child: "roadmap-return-to-principal-records-acceptance", parent: "roadmap-operator-attested-acceptance"),
    edge(child: "roadmap-schedule-list-scheduling", parent: "roadmap-schedule-leaf-expansion"),
    edge(child: "roadmap-schedule-calendar-binding", parent: "roadmap-schedule-list-scheduling"),
    edge(child: "roadmap-leaf-in-flight-set", parent: "roadmap-claim-names-leaf"),
    edge(child: "roadmap-leaf-realized-duration", parent: "roadmap-claim-names-leaf"),
    edge(child: "roadmap-leaf-realized-duration", parent: "roadmap-schedule-list-scheduling"),
    // A realized duration is a count of WORKING days, and the Monday..Friday week is
    // roadmap-schedule-calendar-binding's rule, not this row's: the fold imports
    // gunbc.roadmap.roadmap_schedule_calendar::working_days_between rather than restating a second week rule
    // (operator ruling 2026-11-18: make the calendar binding a parent and import its rule, holidays unmodelled).
    edge(child: "roadmap-leaf-realized-duration", parent: "roadmap-schedule-calendar-binding"),
    edge(child: "roadmap-schedule-from-now", parent: "roadmap-schedule-calendar-binding"),
    edge(child: "roadmap-schedule-from-now", parent: "roadmap-leaf-in-flight-set"),
    edge(child: "roadmap-schedule-bottlenecks-and-offer", parent: "roadmap-schedule-from-now"),
    // The barrier fix sits BETWEEN leaf-expansion (what it extends) and bottlenecks-and-offer (which reads the
    // edges the barrier produces): the barrier waits on leaf-expansion, and bottlenecks-and-offer -- already
    // waiting on from-now -- additionally waits on the barrier, so a wrong barrier cannot reach the offer. The
    // deferred LeafPath model change waits on the barrier, which is what makes the omitted composite work visible
    // first (gunb-ai/gunbc#16650).
    edge(child: "roadmap-schedule-barrier-through-empty-stages", parent: "roadmap-schedule-leaf-expansion"),
    edge(child: "roadmap-schedule-bottlenecks-and-offer", parent: "roadmap-schedule-barrier-through-empty-stages"),
    edge(child: "roadmap-schedule-composite-nested-addressing", parent: "roadmap-schedule-barrier-through-empty-stages"),
    // The unresolved-wait report the barrier creates gets its CONSUMER here: the surfacing frontier waits on the
    // barrier (the report must exist first), and bottlenecks-and-offer -- the offer already reads the barrier's edges
    // -- additionally waits on the surfacing frontier, so a schedule that dropped the report cannot reach the offer.
    edge(child: "roadmap-schedule-surfaces-unresolved-waits", parent: "roadmap-schedule-barrier-through-empty-stages"),
    edge(child: "roadmap-schedule-bottlenecks-and-offer", parent: "roadmap-schedule-surfaces-unresolved-waits"),
