    roadmap_node(
      identity: "rn_9JXQW2VTNB5KZCR7MHPD4GYL60",
      id: "census-job-level-observation-and-reprojection",
      owner: "buyer-review",
      carriers: carrier(path: "docs/plans/review-sheet-and-census-lane-handoff.md"),
      line: ticket(t: fields(
        headline: "Derive prospect rows from job-level observation, because the workflow-level scan cannot",
        boundary: "Read jobs?filter=all across every page AND every attempt, and derive from it the facts the prospect rows actually need: real runner and provider identity, job occupancy, pre-start observation, cancelled occupancy, and provider execution standing. Then reproject those into the private commercial reading and the operator-safe sheet rows. The bounded scan producer landed in gunbc#11656 yields a declared candidate POPULATION and is a prerequisite, not a substitute.",
        displaced_cost: "The 57 transcribed rows in the sheets-census prototype carry economic readings that were shown not to have the meanings assigned to them, and without this arc there is no route that re-derives them. Until it exists the sheet can be presented and cannot be refreshed, and its numbers cannot be quoted.",
        first_slice: "The job-level read with attempts and paging, and occupancy derived from it for one known repository, compared against the transcribed row for that same repository.",
        red_control: "Each of the four invalidated inferences must be refused rather than reproduced: a workflow wall duration offered as summed runner occupancy; a workflow-run admission delay offered as runner queue delay; a provider declaration read as provider execution; provider adoption read as positive spend. A repository whose jobs paginate must not report only its first page.",
        out_of_scope: "No re-presentation of the prototype totals as current, and no commercial projection over a population the job-level read has not covered.",
        handback: "The job-level observation carrier, the occupancy derivation, the reprojection, and a statement of which transcribed rows survived re-derivation and which did not."
      )),
      dispatch: dispatchable(),
      parent: in_project(project: "customer-workspace-service", contribution: "Prospect census and buyer review are the customer-facing edge of the service; their identity and custody belong with it."),
    ),
    roadmap_node(
      identity: "rn_2HKDQZ8WVNX4TBM6RCPJLG0517",
      id: "census-app-registration-installation-and-custody",
      owner: "buyer-review",
      carriers: carrier(path: "docs/plans/review-sheet-and-census-lane-handoff.md"),
      line: ticket(t: fields(
        headline: "Actually register, install and take custody of the census App",
        boundary: "gunbc#11552 landed the acquisition MODEL and its route; it did not achieve acquisition. The step that stalls is real: gunbc.github_app_acquisition tells the operator to paste the manifest into the App-creation form's manifest field, and GitHub exposes no such field -- the manifest protocol requires a form POST carrying a manifest parameter, and a GET renders the blank create page. This node covers manifest submission, installation consent, callback capture and credential custody, and it treats registration and INSTALLATION as the two separate facts they are.",
        displaced_cost: "gunbc#11677 consumes an App and an installation that have already been admitted; it creates neither. So every downstream census route that depends on an installation token is blocked on a fact no receipt in this corpus currently establishes, while the acquisition model reads as though it were done.",
        first_slice: "Make the submission step executable, or replace the instruction with one that is. The named dissolution path is browser automation driving the form under an owner session.",
        red_control: "An instruction a reader cannot execute must refuse rather than render: the step that names a form field GitHub does not expose is the specimen. A stored credential plus a failed live request must not read as an acquired App.",
        out_of_scope: "No claim that ownership consent can be automated away -- GitHub requires an owner to submit, and that is an honest HumanIntervention until browser automation drives it.",
        handback: "A receipt naming the registered App, the installation, and the custody location of its key, or a typed refusal saying which of the three is missing."
      )),
      dispatch: dispatchable(),
      parent: in_project(project: "customer-workspace-service", contribution: "Prospect census and buyer review are the customer-facing edge of the service; their identity and custody belong with it."),
    ),
    roadmap_node(
      identity: "rn_5TBHM9XKCWQ2VLF7NRJD8GYZ3E",
      id: "census-installation-token-via-app-jws-route",
      owner: "buyer-review",
      carriers: carrier(path: "docs/plans/review-sheet-and-census-lane-handoff.md"),
      line: ticket(t: fields(
        headline: "Lift the census API budget by reusing the App JWS route rather than building a second signer",
        boundary: "A second composed performer in gunbc.github_effect_perform consuming the clock/claims/jws/openssl/AppInstallationAccessTokens.Create prefix that gunbc#11677 establishes, factored into one function returning a sole_constructor installation-token carrier that each performer consumes inside its own call. Not a second module and not a second signer.",
        displaced_cost: "The census reads a public population under an unauthenticated rate limit, so its scans are truncated by budget rather than by the question. The route to fix it already exists; building a parallel one forks the custody authority.",
        first_slice: "The factored prefix and the composed performer. gunbc#11671, gunbc#11677 and gunbc#11679 are all merged, so the route is available to build against today and nothing external gates this.",
        red_control: "Run with the personal-access-token route unavailable, so a successful code-search page is attributable only to the token producer rather than proving a token could be rendered.",
        out_of_scope: "No rs256_sign host primitive: PRIMITIVE-EGRESS-0 admits openssl only as one handler behind a key-custody signer interface over a key reference, and CRYPTO-0 is actively deleting host crypto primitives, so a new one lands against that program. No bare Secret return, and no second environment-variable token that a personal access token could silently satisfy.",
        handback: "The carrier, the performer, and the live control taken with the fallback route removed."
      )),
      dispatch: dispatchable(),
      parent: in_project(project: "customer-workspace-service", contribution: "Prospect census and buyer review are the customer-facing edge of the service; their identity and custody belong with it."),
    ),
    roadmap_node(
      identity: "rn_6ZFZPYVBX39088FFTWTNF3SCXJ",
      id: "self-host-service-family-on-literal-terminal",
      owner: "self-host",
      carriers: carrier(path: "src/v2/extdeps/languages/dag.dag"),
      line: ticket(t: updated(t: updated(t: updated(t: updated(t: fields(
        headline: "Admit the service declaration family without taxing every identifier",
        boundary: "The G0 service family parses through a grammar terminal that matches one exact word, so the marker words stay ordinary identifiers everywhere else. The parse-door refusals the family needs - missing name, missing brace, volatile, exit-without-arrow, mock-without-expression - keep their separate meanings rather than collapsing into one refusal later in the pipeline.",
        displaced_cost: "Giving each marker word its own token class was measured as a corpus-wide cost defect: every plain-name slot became a thirteen-way choice and the lexer carried one more rule per marker word, so the cost was paid once per identifier in every parse. Against a fixed baseline a large minority of the shared witness population moved, and every one of them moved upward - a unidirectional shift, which is what distinguishes a real cost change from runner noise. The population and the magnitude are re-derived by joining eval_steps per witness identity from two claim_batch runs of the shared population, using the same released binary at the base and at the head, restricted to claims whose verdict is identical at both trees, with the excluded count stated. (The per-claim cost artifact required-floor-claim-cost came only from the withdrawn required-floor lane, gunbc.rung_drop v1_required_lanes_withdrawn, and cannot be produced.) The alternative of making the markers ordinary identifiers and refusing later loses five distinct refusals, because a service declaration has no later stage that could tell those five mistakes apart.",
        first_slice: "The re-expression is already on main at 5a9b1ab9ae4f (read by warm-fox-517 and loyal-carp-337): the service declaration, operation, requires, transport, exit, response and mock_response sites in src/v2/extdeps/languages/dag.dag are each a dag_grammar_literal_terminal on dag_token_ident, the terminal coming from src/v2/std/grammar.dag, and at 5a9b1ab9ae4f the lex rule list holds 21 dag_keyword_lex_rule calls and the file defines 21 distinct dag_token_kw_* names (alias, as, data, else, false, fn, if, import, in, is, let, loop, match, module, nominal_opaque, return, sole_constructor, then, true, type, where), none a service-family word, so there are no keyword lex rules for the family to delete and the earlier count of twelve was wrong; dag_contextual_value_name_keywords holds kw_module and kw_data only. Per-arm attribution, counted by warm-fox-517: the service declaration, operation, transport and exit sites blame to a3cb5d3ace2c (#11955, merged 2026-09-21T16:56:28Z) and git log -S on the interned service lexeme returns that one commit; the requires arm blames to 7284506da973 (#12911), which rewrote it later; response and mock_response are not yet individually attributed. What remains is to confirm by execution that the name-usability evidence is retained at the lexical and grammar boundary and keep the input-and-output field tail scoped to services; a slice that commands work already on main is not taken.",
        red_control: "Two alternatives that differ only in that one word validate as distinct, while the same pair keyed on the token class alone still reports an overlap; a wrong word in the marker position is refused at the parse door; and the matched word is not published as the node's identity, so no caret literal or generic parameter changes what it carries. A source using the marker words as ordinary names still parses, and that fixture is the retained name-usability control - it reds if any later change keywords a spelling again. Each named parse-door refusal asserts its own typed diagnostic and the stage that raised it, never bare non-acceptance: a helper that is the negation of parses folds a tokenize failure and a parse failure into one verdict, so it can pass for a reason the claim is not about.",
        out_of_scope: "Not the resolver's treatment of imports, and not the evaluation-step cost of the whole-service witness, which is its own item.",
        handback: "Return the two-run claim_batch eval_steps join (same released binary at base and head, verdict-identical claims only, excluded count stated) showing the moved population back at baseline, the refusal controls, and a statement of which service constructs still have no lowering."
      ), on: "2026-09-20", note: "The prepared branch is on the shared remote so the citation resolves for anyone with the repository, not only for its author. It was cut before the merges of 2026-09-20 that put the exact-word terminal on main, so it needs rebasing onto current main before it can be proposed for landing."), on: "2026-09-21", note: "CORRECTION to this row as first authored: the slice instructed retiring the name-usability claim as a climb, and that instruction was wrong on gunbc.design_argument::guarantee_ladder (dissolution on climb), which dissolves lower-rung PRODUCTION machinery and never the evidence. The prepared branch acted on it and its annotation argues the claim's RED is no longer authorable even against a hostile fixture. That is false, and gunbc.design_argument::guarantee_ladder decides it in the opposite direction: a state unrepresentable in the accepted corpus may still be representable as SOURCE HANDED TO THE COMPILER BY A FIXTURE, and this claim's fixture is exactly that - one module using from, input and transport as a parameter and a let binding. Deleting the keyword lex rules removes the mechanism that could break name usability today; it is not evidence that a later lexer or grammar change cannot reintroduce one. Re-express the control at the right boundary and consolidate it if it duplicates, but keep the obligation enrolled."), on: "2026-09-21", note: "SECOND CORRECTION, and it retracts this row's own citation. The tip cited above as PREPARED WORK does not compile, on its base or on main: dag_grammar_literal_terminal is called twelve times and declared nowhere in it, so resolve refuses with no established callee identity. The earlier claim that it merges current main with zero conflicts is true and was never the question -- a clean merge of source that never compiled is not prepared work, and verifying the merge instead of executing it is the specification-without-execution gunbc.design_argument::fail_closed names. What the implementation actually needed, found by running it: the algebra constructor grammar_expr_literal_terminal already exists in v2.std.grammar and only wanted a local wrapper in the file's existing idiom; and seven marker words -- service, operation, input, output, readonly, idempotent, hermetic -- are reserved in the SEED's extdeps.languages.dag.syntax dag_keyword_set, so a caret literal cannot spell them and they are interned from their String spelling by symbol_intern_lexeme, which no keyword rule intercepts. G0 carries no keyword entry for any of them, which is what keeps the name-usability control meaningful rather than vacuous."), on: "2026-09-30", note: "Prepared work: branch session/calm-eagle-42-service-on-literal at tip 80a560dffb01b6fa2cbf3f7cb710e5d8e7f6dcdc.")),
      dispatch: dispatchable(),
      parent: in_project(project: "v2-compiler-live", contribution: "Primitive egress, interpreter cost and self-host admission are what the self-hosted compiler needs before it is the one that runs."),
    ),
    roadmap_node(
      identity: "rn_4YXQ47680VA8B4GNGGVPV2DQZ8",
      id: "whole-service-witness-costs-more-than-its-budget",
      owner: "self-host",
      carriers: carrier(path: "docs/plans/floor-cost-distribution-near-the-ceiling.md"),
      line: ticket(t: fields(
        headline: "Decide what a witness over a whole real service is allowed to cost",
        boundary: "One witness parses a complete real service declaration end to end, and it is the only claim that runs that path for real. Decide whether it stays whole, and on what basis, rather than deciding by whichever budget happens to refuse it first.",
        displaced_cost: "It was measured several times over the evaluation-step budget, and separately above the per-subject processor-time line. Both readings are re-derived from the required floor's per-claim cost receipt, the required-floor-claim-cost artifact, read for this witness identity against the budget that v2.workflow.required_floor declares. Its cost was shown to be linear in the content rather than a defect in shape, so shrinking the fixture does not make it cheaper - it makes it stop being the real thing. The two budgets are separate gates and admission against one says nothing about the other, which is easy to miss.",
        first_slice: "Establish this witness's UNIQUE obligation before deciding anything about its size, because the sibling claims in the same module already execute the real tokenizer and parser on source - so this row is not the only execution of the service parse path in general, only of this particular composition of constructs, and those are different subjects. Where the obligation is one grammar behaviour, a minimal discriminating specimen carries it; where it is an INTERACTION between service constructs, keep the smallest composition that still exercises that interaction; where it is ingestion of the production file itself, bind the evidence to that file and state its scope honestly. Then re-measure after the service family moves onto the exact-word terminal, because the keyword machinery accounted for somewhere between a fifth and two fifths of the cost and the remainder is the service body itself.",
        red_control: "Whatever is decided, deleting the claim that runs the real path must make a control fail, so the cheap claims cannot stand alone.",
        out_of_scope: "Not a change to either budget's value, and not a licence to split the witness into pieces that each avoid the line while nothing exercises the whole. Two arguments are refused in advance: that the specimen is real and therefore cannot shrink, which is an exemption from the one-interface rule rather than an application of it; and that its cost is linear and therefore justified, since linear work can still be work no admitted consumer of this claim demands. An admission on the processor line is not an admission on the evaluation-step budget, and neither is permission on the other.",
        handback: "Return the re-measurement on both gates, the decision with its reason, and - if the witness is admitted over a line - a record that decides on the live reading rather than on a number typed into a row."
      )),
      dispatch: dispatchable(),
      parent: in_project(project: "v2-compiler-live", contribution: "Primitive egress, interpreter cost and self-host admission are what the self-hosted compiler needs before it is the one that runs."),
    ),
    roadmap_node(
      identity: "rn_ARHDM19A4Y5Z6EVGYFAWCJ434C",
      id: "required-floor-passes-with-a-failed-phase",
      owner: "ci-control",
      carriers: carrier(path: "dag/gunbc/witness/witness_floor_workflow.dag"),
      line: ticket(t: fields(
        headline: "A required run that had a phase fail must not report success",
        boundary: "When the required run reports how many phases it ran and how many failed, a nonzero failure count has to reach the verdict and the check result. Today it does not.",
        displaced_cost: "Observed on a live pull request: the job log recorded two phases run and one failed, with two located findings, while the same run reported a clean verdict and the check concluded success and the branch read as mergeable. A gate that passes while one of its phases failed certifies less than everyone reading it believes, and the belief is the point of having it.",
        first_slice: "Make the failed-phase count decide the verdict, then confirm on the run that already exhibits it.",
        red_control: "A run with a deliberately failed phase reports failure; a run with none still reports success, so the change does not simply make the gate refuse everything.",
        out_of_scope: "Not the content of any particular phase's findings, and not which phases the required run should contain.",
        handback: "Return the corrected verdict rule, a run showing it refusing, and a run showing it still passing when nothing failed."
      )),
      dispatch: dispatchable(),
      parent: in_project(project: "ci-end-to-end-execution", contribution: "The required run is the factory verification half; a gap in what it counts, bills or reports is a gap in every landing it gates."),
    ),
    roadmap_node(
      identity: "rn_02PRZ2Q7Q5Q8TJRANYM293HKJD",
      id: "runner-throughput-witness-imports-absent-members",
      owner: "language-integrity",
      carriers: carrier(path: "dag/test/claim/runner/runner_throughput_qualification_witness.dag"),
      line: ticket(t: fields(
        headline: "Repair a witness that imports two names its source does not declare",
        boundary: "One witness imports two members from a module that declares neither of them. The declarations phase reports both as absent.",
        displaced_cost: "The module declares a differently-named member whose spelling contains one of the requested names as a substring, so a casual search appears to confirm the import and does not. The finding is real and sits on the main line, where it was only visible because another change happened to surface the phase's output.",
        first_slice: "Decide whether the witness wants the member that does exist under its real name, or whether the source should export what the witness asks for.",
        red_control: "The declarations phase reports no absent member for this file, and a deliberately reintroduced bad import is reported again.",
        out_of_scope: "Not a rework of the witness's subject, and not the separate question of whether a failed phase should fail the run.",
        handback: "Return the corrected import and a phase run that reports it clean."
      )),
      dispatch: dispatchable(),
      parent: in_project(project: "ci-end-to-end-execution", contribution: "The required run is the factory verification half; a gap in what it counts, bills or reports is a gap in every landing it gates."),
    ),
    roadmap_node(
      identity: "rn_J01EG5E1CAAVTYVJPKPXFXZCGM",
      id: "action-use-yaml-reader-contract",
      owner: "generated-artifact",
      carriers: carrier(path: "dag/gunbc/action_use_admission.dag"),
      line: ticket(t: fields(
        headline: "Read a workflow file once, correctly, and delete the second reader",
        boundary: "extdeps.languages.yaml accepts only the YAML subset it reads with the correct meaning and refuses the rest with a located reason, parser and emitter fixed together, witnessed by comparing decoded structures rather than re-emitted bytes. The action-use census then reads every committed workflow through it, one claim per file joined to the directory listing, and gunbc.action_use_admission's line projection plus its frontier row are deleted.",
        displaced_cost: "Two readers of one medium disagree eventually, and the cheap one cannot see a flow-style mapping, an escaped key or a complex key at all. Until it is gone, the repository-wide ban on substituted action runtimes rests partly on a scanner that reads lines.",
        first_slice: "Land the bounded-subset contract and its decoded-structure witnesses; the projection deletes in the same change once the census reads every workflow through the modeled reader.",
        red_control: "A planted wrong-meaning case per construct turns its own control red, and the census refuses a workflow the projection could not see (flow-style `[\{uses: ...}]`).",
        out_of_scope: "The interpreter's eager `&&` operand demand, which has its own recurring-failure-mode row.",
        handback: "Return the contract, the witnesses, the deleted projection and the census cost re-derived by its named instrument."
      )),
      dispatch: dispatchable(),
      parent: in_project(project: "ci-end-to-end-execution", contribution: "The required run is the factory verification half; a gap in what it counts, bills or reports is a gap in every landing it gates."),
    ),
    roadmap_node(
      identity: "rn_PDMRS0Y8J3EBDYNRPWZFH23C93",
      id: "required-lane-exit-on-refused-phase",
      owner: "ci-control",
      carriers: carrier(path: "dag/gunbc/witness/witness_floor_workflow.dag"),
      line: ticket(t: fields(
        headline: "A required lane that refuses a phase must not exit zero",
        boundary: "When the required-CI lane reports FAILED PHASE and counts phases_failed, the process exits non-zero and the aggregating job cannot read it as green. The refusal itself stays: declining to plan on an unobservable base is correct.",
        displaced_cost: "Reproduced on two heads (runs 35503853026 and 35510547600): the floor refused with ChangedWitnessObservationFailed, the log carried phases_failed=1, and the step concluded success. Every change touching a file the base reconstruction needs has had its changed-witness observation skipped while CI reported green.",
        first_slice: "Map a refused phase to a non-zero exit at the one place that owns the lane's status, and audit every other refusal arm in that lane for the same shape.",
        red_control: "A refused phase that maps to exit 0 reds; a clean lane still exits 0.",
        out_of_scope: "Widening or narrowing the changed-witness subject to make the refusal disappear.",
        handback: "Return the exit mapping, the audit of the lane's other arms, the recurring-failure-mode row with both runs as receipts, and how far back the silent skipping reaches."
      )),
      dispatch: dispatchable(),
      parent: in_project(project: "ci-end-to-end-execution", contribution: "The required run is the factory verification half; a gap in what it counts, bills or reports is a gap in every landing it gates."),
    ),
    roadmap_node(
      identity: "rn_BR2JFR598QVXCXM82STJS2RW4S",
      id: "workflow-census-claim-budget-margin",
      owner: "ci-cost",
      carriers: carrier(path: "dag/extdeps/languages/yaml/ingest.dag"),
      line: ticket(t: fields(
        headline: "Cut the reader's per-entry cost so the workflow census is not one edit from red",
        boundary: "The census claim over the largest committed workflow sits within a couple of percent of the new-witness eval-step budget, and its subject grows from lanes that do not own it. Cut the modeled reader's per-entry path so the margin is structural rather than incidental.",
        displaced_cost: "A required claim that reds when an unrelated workflow gains lines teaches everyone that the gate is noise, and the tempting repairs are the forbidden ones: a raised budget, a second reader, or a declared drop.",
        first_slice: "Measure where the per-entry cost lives in the mapping-entry path and cut it there, re-deriving the cost with claim_batch eval_steps over ingest_yaml_source on the largest workflow.",
        red_control: "The census claim stays inside its budget with the largest committed workflow grown by a realistic increment.",
        out_of_scope: "Raising the budget, splitting the subject to fit, or reintroducing a line projection.",
