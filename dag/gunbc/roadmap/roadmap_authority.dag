    roadmap_node(
      identity: "rn_WNFHYN3C1DA917SQJMLCTUFX3",
      id: "v1-deletion-program",
      owner: "self-host",
      carriers: carrier(path: "dag/gunbc/v1/v1_deletion_plan.dag"),
      line: ticket(t: updated(t: fields(
        headline: "Delete the old compiler honestly",
        boundary: "The v1 deletion program: the interpreter's primitive surface becomes enumerable and then model-authoritative; the hand-written Rust population is read from the repository at a known revision rather than transcribed; deleting old tests loses no coverage; the products build and run with the old directory absent; and the seed-honesty ruling records whether independent rebuild must precede removal. This node is the program's decomposition level; the executable rows are its children.",
        displaced_cost: "'Mostly migrated' is not a state anyone can verify; without a derived frontier and a recorded trust ruling, deletion either waits forever or lands silently incomplete.",
        first_slice: "Read the rows in dependency order: the primitive-surface roster and dispatch authority, the host source observation, the honest-frontier census, test migration, the seed-honesty decision, then the queue drain, emitter deletion, and the v1-free product builds.",
        red_control: "A deletion-program row claimed by a second project refuses as typed ambiguity; a row whose membership walk does not arrive here refuses unrooted; each child's edge names what that row's work adds to this program.",
        out_of_scope: "No executable work lives on this node -- it is never dispatched and never carried by an execution contract -- and its bar does not replace the per-row tickets' own bars.",
        handback: "The rooted deletion chain, every attached child's edge contribution readable against this intent, and no v1-deletion row whose walk ends anywhere else."
      ), on: "2026-09-30", note: "Roster change (v2 worksheet, 2026-09-30): v1-ci-floor-cutover and v1-verification-ledger merged into native-production-admission, and v1-emitter-fixed-point moved to v2-emitter-production as successor promotion.")),
      parent: in_project(project: "v2-compiler-live", contribution: "Retiring the seed is the terminal fact of v2 being live. This program makes 'the old code is gone' a derived frontier instead of an assertion."),
    ),

    roadmap_node(
      identity: "rn_YYXCOYJGPXICGC4YYL8TPFQH9",
      id: "v2-emitter-production",
      owner: "self-host",
      carriers: carrier(path: "src/v2/compiler/self_host/candidate_generation.dag"),
      line: ticket(t: level_fields(
          headline: "The new compiler writes its own Rust, then rebuilds itself",
          boundary: "The v2 emitter writes Rust with provenance, reaches every artifact the seed retains (main.rs included), and builds generation two (the built v2 CLI emits v2.compiler.compile) and then generation three (fixed point). The end state is a v2-built compiler admitted as successor by admit_promotion.",
          approach: "Seed-emitted closures build under -D warnings (#11474, #12468), and behavioral receipts form a series (#12446). Next: second generation, with the typed filesystem door from #12391 already in place, then the fixed point, then promotion (D9).",
          red_control: "A generation whose build reached the seed, or a behavior difference on the discriminating corpus, blocks promotion. So does any remaining EmitterProducedDivergentRegistration row in v2.compiler.self_host.stage0_crate_layout.",
          displaced_cost: "Until the emitter produces every artifact and a second generation, every compiler change still goes through hand-maintained seed Rust.",
          handback: "SelfHostSuccessorPromotionAdmitted and SelfHostEmitterProducesEveryRetainedArtifact CLEAR; the interlock milestones SelfHostBehavioralEquivalenceReestablished and SelfHostCargoPhaseEnrolled are cited, not restated."
        )),
      parent: in_project(project: "v2-compiler-live", contribution: "A compiler that cannot build itself is not self-hosted. This project turns 'v2 emits Rust' into a second and third generation that need nothing from the seed."),
    ),

    roadmap_node(
      identity: "rn_GG8OZ558D0UB3R98N5MQCDPKB",
      id: "ci-end-to-end-execution",
      owner: "ci-control",
      carriers: carrier(path: "docs/plans/ci-process-end-to-end.md"),
      line: ticket(t: level_fields(
          headline: "CI verdicts name what they executed",
          boundary: "The CI end-to-end execution program under the factory: a required check carries the population it actually executed and refuses a verdict on an empty one; the floor fits the fleet's memory; the unit tests block again; the required run's cost is attributed.",
          approach: "Members in order of readiness: the executed-coverage receipt (its closing witness is bound), the floor memory peak, the unit-test lane, and the required-run cost.",
          red_control: "A required check that reports a verdict over an empty executed population refuses; a member whose parent walk does not reach this node refuses as unrooted.",
          displaced_cost: "A pipeline failure that cannot say what it ran reads as corpus failure, and every reviewer re-derives what CI actually proved.",
          handback: "Each member accepted, with the executed population named by its instrument."
        )),
      parent: in_project(project: "factory", contribution: "A CI verdict that names what it executed is the factory's verification half: without it, pipeline failure reads as corpus failure."),
    ),
    roadmap_node(
      identity: "rn_XSEKT13HXV12Z5BP4RM4S2F0HW",
      id: "vm-service",
      owner: "fleet",
      carriers: carrier(path: "dag/gunbc/product/fabric/selection.dag"),
      line: ticket(t: level_fields(
          headline: "End-of-year VM service: compute on our own fleet, every promised property observed rather than assumed",
          boundary: "Allocation, placement and serving follow the fabric/compute conformance domain (DESIGN §3b): product.fabric.selection select_supply, product.capacity.lease LeaseGrant, gunbc.serving.serving_availability, and classification against gunbc.host_assimilation_program. A service dimension may stay opaque only above a falsifiable quality floor with a named consequence (§4b). Commercial terms are not modeled here.",
          approach: "Six milestones, their alignment fields pending the operator-reviewed contracts document: fabric application authority; managed identity, access and dependencies; microVM runtime and durable state; direct website serving; the factory on the fabric; the customer workspace service. Wet bring-up and serving restores stay operator-driven.",
          red_control: "An unclassified machine artifact refuses before change. A stalled route takes no new work. A published property with no acceptance receipt is not published.",
          displaced_cost: "Without observed fleet state and liveness, every capacity or isolation claim is a claim about a model of the machine.",
          handback: "Per milestone: the acceptance receipts that show it, named by their instruments."
        )),
      parent: in_project(project: "fabric-bringup", contribution: "The end-of-year VM service turns the factory's own fleet into a service others can use; fleet, serving and compute facts become a contract only once each is observed rather than assumed."),
    ),
    roadmap_node(
      identity: "rn_0RV6KBTCG8ZYD6M76TV1PMXP7D",
      id: "debt-payoff",
      owner: "debt",
      carriers: carrier(path: "dag/gunbc/recurring_failure_mode.dag"),
      line: ticket(t: level_fields(
          headline: "Retire known gaps and recurring failure modes against their rostered triggers",
          boundary: "Scope is a named gap, a dag/gunbc/recurring_failure_mode/ class, a gunbc.rung_drop row or a named debt roster, retired to its next rung or shrunk toward its dissolution. It does not take a lane's feature work, and no new capability lands here. Each member is sized so one worker can finish it with a named witness.",
          approach: "Milestones DP-M1 to DP-M6, each done when a named roster reaches a stated size or a class a named rung. DP-M2 (the shell batch) first: land the finished shell candidates, then the ready ones; beside it, the DP-M1 dissolvable-now rows.",
          red_control: "A member with no witness or closing contract is not ready and does not dispatch. A fix that only moves the cost (a cache, a wider budget, a raised limit) is not payoff (DESIGN §6b). A class retired without its RED staying enrolled is not retired (§4b(4)).",
          displaced_cost: "Each item is paid on every run or every review until retired.",
          handback: "Per member: the witness green by execution, the deleted debt, the roster's new size or the class's new rung, and the acceptance receipt."
        )),
      parent: in_project(project: "gunbc-project-root", contribution: "Known gaps and recurring failure modes, each retired against its rostered trigger, stop charging every later change for the same defect."),
    ),
