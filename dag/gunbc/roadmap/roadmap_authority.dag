      carriers: carrier(path: "docs/plans/demand-engine-program.md"),
      line: ticket(t: updated(t: fields(
        headline: "NUMERIC-BIT cut 1: one sealed octet carrier minted only by admission (gunbc#11643)",
        boundary: "A sole_constructor QualifiedOctets { members: List<UInt8> } minted only by the admission functions, RealizableWidth sole_constructor, and every bit-width operation consuming the sealed carrier. UInt8 is a Phantom transparent to Int and cannot carry the proof, so 256 inhabits List<UInt8> today.",
        displaced_cost: "Every downstream encoder (base64, SHA-256, CBOR) re-checks or silently accepts an out-of-range octet; the forged-octet divergence row exists only because the carrier is literal-writable.",
        first_slice: "Retarget gunbc#11643 onto the sealed carrier, delete base64_encode_forged_qualified_octet_diverges, floor clean, side-chat APPROVE on the exact head, land.",
        red_control: "A literal QualifiedOctets outside the admission functions refuses at resolve; an admission fed 256 refuses with a typed cause; a forged-octet witness that once diverged has no author.",
        out_of_scope: "Kernel arms and multi-limb carriers are the next two rows.",
        handback: "Return the landed head, the admission roster, and the deleted divergence row."
      ), on: "2026-09-20", note: "LANDED: gunbc#11643 merged at 6bb950a5589 with the sealed QualifiedOctets / QualifiedWord / RealizableWidth carriers and the mint proxy closed. The row stays active until its acceptance receipt is recorded; no further slice is owed on it.")),
      dispatch: dispatchable(),
      parent: in_project(project: "v2-compiler-live", contribution: "Primitive egress, interpreter cost and self-host admission are what the self-hosted compiler needs before it is the one that runs."),
