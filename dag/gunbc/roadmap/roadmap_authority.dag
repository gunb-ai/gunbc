    roadmap_node(
      identity: "rn_CREDENTIAL0LIFECYCLE0REVOKE",
      id: "credential-lifecycle-revocation",
      owner: "fleet",
      carriers: carrier(path: "dag/gunbc/auth/privileged_effect_registry.dag"),
      line: ticket(t: level_fields(
          headline: "Every service credential can be rotated and revoked, proven by an executed revocation drill",
          boundary: "Issuance, scope, expiry, rotation and revocation for every machine and service credential: reviewer GitHub credentials, R2 publisher and reader identities, host identities, image signing, and customer-facing App credentials. Follows the leasing/grants/privileged-access conformance domain (gunbc.design_argument::conformance; gunbc.auth.authorization_pattern_selection, gunbc.auth.privileged_effect_registry).",
          approach: "DRAFT (operator 2026-10-03): first slice and closing contract pending; members join as implementation-ready tasks are cut.",
          red_control: "A credential with no executed revocation drill is not admitted to a customer-facing path. After revocation, no guest or workload retains access.",
          displaced_cost: "The fleet-wide reviewer 401 on 2026-10-03 froze every landing: a credential nobody could rotate on demand stopped the line, and the same gap exists for every customer-facing identity.",
          handback: "DRAFT: per member, the executed drill or witness named by its instrument."
        )),
      parent: in_project(project: "managed-identity-access-dependencies", contribution: "A service is only as safe as the credentials that reach it; every machine and service credential needs an issuance, scope, expiry, rotation and revocation path, proven by drill."),
    ),
    roadmap_node(
      identity: "rn_FAILURE0BILLING0OUTCOMES0A",
      id: "failure-billing-outcomes",
      owner: "fleet",
      carriers: carrier(path: "dag/product/fabric/selection.dag"),
      line: ticket(t: level_fields(
          headline: "Every non-success has a declared billing or credit outcome",
          boundary: "Each typed failure ending of the VM service (placement refusal, host or drive loss, storage outage, compound failure, operator cancellation) maps to exactly one declared billing disposition: no charge, credit, or charged with a named consequence. Commercial amounts stay in the private plan; this node owns the mapping's completeness.",
          approach: "DRAFT (operator 2026-10-03): first slice and closing contract pending; members join as implementation-ready tasks are cut.",
          red_control: "A failure ending with no billing disposition refuses admission of the service path that can produce it.",
          displaced_cost: "Without the mapping, every failure is billed by whoever notices it, and a degraded delivery keeps the premium price: the externalization gunbc.design_argument::fail_closed forbids.",
          handback: "DRAFT: per member, the executed drill or witness named by its instrument."
        )),
      parent: in_project(project: "vm-service", contribution: "A customer pays for outcomes; a failure that has no declared billing disposition is externalized degradation (gunbc.design_argument::fail_closed)."),
    ),
    roadmap_node(
      identity: "rn_SERVICE0EVIDENCE0CAPTURE0A",
      id: "service-evidence-capture",
      owner: "fleet",
      carriers: carrier(path: "dag/gunbc/roadmap/roadmap_service_evidence.dag"),
      line: ticket(t: updated(t: fields(
          headline: "Capture service evidence from the first qualifying run: usage, cache, placement, failures, recovery, intervention",
          boundary: "From the first qualifying end-to-end run onward, every run's durable records admit a joined receipt on read: workload class and resource request; wait, execution and completion time; cache hits, misses, shared misses and corrupt-hit refusals; placement and seat utilization; artifact bytes and egress; failure attribution and recovery action; operator intervention time; hardware health events; billable usage and credits; workspace recovery point and recovery time. Follows the process observability conformance domain (std.observation). Route acceptance and the dogfood start receipt are owned by factory-dogfood-route (gunbc#13077); this node owns the joined service-evidence fields captured from that route's runs, as one per-attempt receipt computed on read by gunbc.roadmap.roadmap_service_evidence service_evidence_observe_for_attempt, which consumes the readers that own each fact and measures nothing itself.",
          displaced_cost: "Evidence added late loses the observation period it should have covered, and the dogfood window cannot be backdated.",
          first_slice: "The receipt contract: the attempt bound by its per-attempt LAUNCH RECORD, whose identity names the node and the dashboard instance and whose attempt_key member names the attempt (a legacy record without that member is unbound and refused); one typed input per joined reader gathered once per attempt; and all 21 fields derived from those inputs into one closed product as Observed | Owed | Refused. G5 (gunbc.roadmap.roadmap_session_placement, landed) is bound: placement, workload class and the granted resource amount are observed from its grant record re-checked against the binding; wait time and seat utilization, which that record does not establish, are owed to this node. Every other field is owed to its reader's change (G3 metering #13073, G1 shared computation #13097, G4 result returned #13075) or to the node that owns its missing producer. Each later slice replaces one reader's not-on-main arm with its typed observation and derives its fields from named members of that record.",
          red_control: "An attempt whose launch record names another node, another dashboard instance or (in its attempt_key member) another attempt, whose launch record carries no attempt_key, or that has no launch record, is not joined; a placement observation that is foreign, unreadable or names another attempt never yields an observed field; an ordered field view that differs from the node's list by identity or order (a duplicate plus an omission at the same count included) is red; a run on the qualifying route whose records admit no receipt is not counted toward the dogfood window.",
          out_of_scope: "Building the producers the receipt names as owed to OTHER nodes (hardware health to fleet-health-0-live-receipt, credits to failure-billing-outcomes, workspace recovery point and time to fabric-storage) -- each is its owning node's work; egress, recovery action and operator intervention time have no other owner and are this node's own later slices; storing the joined receipt (the dogfood start receipt pins it once); pricing.",
          handback: "The module, its witnesses with one discriminating red per refusal, and per slice the reader bound and the fields it moved from owed to observed."
        ), on: "2026-11-19", note: "Source review at 398136026b345e087968a9db4ba42ec551c5ca4c (2026-11-19); source presence is not acceptance. The service evidence contract already has placement, metering and result readers; shared computation remains pending. Reuse those bindings. This node owns wait time, seat utilization, egress, recovery action and intervention time observations, not hardware health, credits or workspace recovery producers owned elsewhere. A real attempt still needs to establish the 21 field standings.")),
      dispatch: dispatchable(),
      execution: bound(contract: service_evidence_capture_execution_contract()),
      parent: in_project(project: "vm-service", contribution: "The operator's go/no-go on external customers is their own confidence from dogfooding; that confidence must rest on receipts captured from the first qualifying run, not reconstructed later."),
    ),
    roadmap_node(
      identity: "rn_A9QSP5ZMHYH0WDJR571D78N439",
      id: "contained-development-execution",
      owner: "fleet",
      carriers: carrier(path: "dag/gunbc/roadmap/roadmap_dispatch_actuator.dag"),
      line: ticket(t: level_fields(
          headline: "G0 — Contained development execution: no new autonomous worker/reviewer/auditor/supervisor dispatch until operator home, credentials, privilege groups, control-plane stores and shared state are proven unreachable",
          boundary: "DRAFT portfolio gate: the alignment fields come from the contracts document under operator review.",
          approach: "DRAFT: pending the reviewed contracts document.",
          red_control: "Not ready: a portfolio gate carries no dispatch facts; it is lifted only by the operator on proof that the named state is unreachable.",
          displaced_cost: "DRAFT: pending the reviewed contracts document.",
          handback: "DRAFT: pending the reviewed contracts document."
        )),
      parent: in_project(project: "managed-identity-access-dependencies", contribution: "The portfolio gate (G0) this milestone holds: autonomous dispatch stays contained until the operator's home, credentials, privilege groups, control-plane stores and shared state are proven unreachable."),
    ),
    roadmap_node(
      identity: "rn_K6EVN9SKS7WV617GECTH3N2TPQ",
      id: "ci-cost-floor-preparation-cut",
      owner: "ci-cost",
      carriers: carrier(path: "docs/design-rung-drops.md"),
      line: ticket(t: updated(t: fields(
        headline: "Make the floor affordable enough to be a merge gate again",
        boundary: "Cut the required fold's PREPARATION cost until the floor fits the fleet, then put it back on the merge path. THE CLAIMS WERE NEVER THE EXPENSE -- claim execution is a small fraction of the floor's wall time while strict-preparation and reach probes dominate it. Re-derive that split from the phase lines a required-witnesses-floor run prints (gunbc.witness.witness_floor_workflow); THAT NO ENTRY POINT RE-DERIVES IT IS PART OF WHAT THIS NODE FIXES, which is why no figure is carried here. The two candidate constructions are reusing resolved-module and reach-probe results across runs, or scoping preparation to a diff's closure.",
        displaced_cost: "The required gate is currently a compiler build. The witness floor, namespace-wave-admission, generated-artifact, the regen fixed point and the parse sweep all left the merge path, so main can break for any of them while every required check stays green -- which it already has, within three hours of the cut. Every session pays that risk on every change.",
        first_slice: "Measure where preparation time goes at module grain, then land whichever of the two constructions the measurement supports. Restoring the gate is the second step and not this one.",
        red_control: "Two halves, both executable today. (i) A planted break of a floor claim is refused at that revision, with the raw error, its locus and rc != 0, and the unmodified claim passes with rc = 0. (ii) The whole-run cost is re-derived from this node's own entry point and shown carryable alongside a build lane. The CI-enforcement sense, refused on the revision that LANDS on the required path, is the red_control of required-witness-floor-restored.",
        out_of_scope: "Re-emitting witnesses.yml from the old authority without the preparation repair, which restores the cost that caused the cut; and making the floor faster without returning it to the merge path.",
        handback: "The preparation measurement WITH AN ENTRY POINT THAT RE-DERIVES IT rather than a figure quoted from a log, the landed construction, and the two halves of the red control. Restoring the gate on the required path, and retiring gunbc.rung_drop witness_floor_off_the_required_gate, belong to required-witness-floor-restored."
      ), on: "2026-11-23", note: "Split on royal-newt-240's finding, ruled by neat-badger-614: first_slice said restoring the gate is not this step while handback ended by requiring it. The restore-the-gate clauses of the handback, and the CI-enforcement sense of the red control, moved to required-witness-floor-restored.")),
      dispatch: dispatchable(),
      parent: in_project(project: "ci-end-to-end-execution", contribution: "The required run is the factory verification half; a gap in what it counts, bills or reports is a gap in every landing it gates."),
    ),
    roadmap_node(
      identity: "rn_6C2SB1F7B7N04QHTWQ98WNBV3N",
      id: "required-witness-floor-restored",
      owner: "ci-cost",
      carriers: carrier(path: "dag/gunbc/rung_drop/v1_required_lanes_withdrawn.dag"),
      line: ticket(t: fields(
        headline: "The witness floor judges every landing revision on the required path again",
        boundary: "Split out of ci-cost-floor-preparation-cut, which makes the floor affordable and does not restore it. This row is the restoration: the capability named by the restoration_trigger of gunbc.rung_drop v1_required_lanes_withdrawn, that on every landing revision a binary built from an emission of v2 judges the withdrawn population on the required path with a discriminating red, so that no member can regress with the required context green. It depends on ci-cost-floor-preparation-cut and on the rows that carry members of the trigger. Mapped member by member by crisp-eagle-244 at main 0f036da75041 (a reading of the plan file, not a measurement of the gate): member (1), every claim the floor folded executed or its subject deleted, is carried by required-check-named-witnesses-runs-no-claim-module, the claim-execution half; the trigger's census prerequisite, which the 2026-10-30 process ruling retired, has cc-evidence-to-consumers as its census-half row; member (3), every committed generated artifact compared with one emission of its authority, has a gate row, generated-artifact-gate-red-at-main, but NO ROW that states the member itself. GAPS, named and not given rows in this change: member (2), every module the source-root ingestion admits resolved by the native compiler on the required path within the required slot's memory_max, has NO ROW (native-frontier-required-lane puts the ratchet on every landing and does not judge that); member (4), a change to the seed's own sources not landing with the required context green unless a required step judged it (the stage0 mirrors, the lint, the v1 unit tests), has NO ROW; and member (1a), the local_repo_wet_schedule claims executed natively with their host effects bounded, has NO ROW. The rows required-lane-exit-on-refused-phase and required-floor-passes-with-a-failed-phase are under the operator's decision and are neither edited nor given an edge by this row. Nothing here is measured.",
        displaced_cost: "The required gate stays a compiler build, so main can break a floor claim, a generated artifact or the seed's own sources while every required check is green, and every session pays that risk on every change.",
        first_slice: "Take the restoration_trigger member by member, record which row carries each member and which has none, then restore the members that have a row, in dependency order after ci-cost-floor-preparation-cut.",
        red_control: "OPEN: no red_at or green_at is measured. Red is a planted break of a floor claim that lands with the required context green. Green is that same planted break refused on the revision that lands, on the required path (not a manual or dispatched run), with the unmodified revision passing there, the run having planned and executed the enrolled population. Not a pair for gunbc.rung_drop witness_floor_off_the_required_gate to retire on until all four members hold.",
        out_of_scope: "Returning any of the four withdrawn lanes or handing the corpus to the v1 interpreter; a native row that judges part of the population (it narrows the drop member by member and retires nothing); a manual or dispatched run off the required path; and inventing rows for members (2) and (4) in this change.",
        handback: "A required run that planned and executed the enrolled population on a landing revision, the red and green arms of the red control on the required path, a row or a stated gap for every trigger member, and the retirement of gunbc.rung_drop witness_floor_off_the_required_gate."
      )),
      parent: in_project(project: "ci-end-to-end-execution", contribution: "The required run is the factory verification half; a gap in what it counts, bills or reports is a gap in every landing it gates."),
    ),
    roadmap_node(
      identity: "rn_P4WR8PZ5D6W4TMR1RZ7G87416F",
      id: "namespace-reference-derived-producer-bounded",
      owner: "namespace",
      carriers: carrier(path: "src/v2/lens/module_graph.dag"),
      line: ticket(t: updated(t: fields(
        headline: "Give the reference-derived graph producer a bounded realization",
        boundary: "Rewrite the producer so it retains only what its consumers demand. The demand was measured and it is a NAME TABLE, not a syntax population: every lookup the edge fold makes of the index discards the Node, the one genuine Node demand is an equality discriminant in index construction that a per-key digest supplies, and trees is read at one site for the importer's own root.",
        displaced_cost: "The producer holds the whole corpus in memory to answer questions that need a name table, and it sits upstream of the namespace cut. Its residency is a standing cost on every consumer that resolves through it.",
        first_slice: "Measure reference_derived_pool_from_located_roots at the current head, identifying retained trees versus the keyed declaration index; propose the smallest residency change and preserve its edge projection. The old #11683/#11574 prerequisites are historical, not instructions to wait on those PRs.",
        red_control: "Identical edge projection over the corpus before and after, plus the landed residency qualification passing on the rewritten producer rather than on a semantic receipt.",
        out_of_scope: "Editing module_graph.dag while gunbc#11683 is open; and claiming bounded realization from the semantic receipt, which the qualification instrument exists to refuse.",
        handback: "The rewritten producer, the before/after edge-projection equivalence evidence, and the qualification passing by invocation. A FALSIFIABLE PREDICTION IS ON RECORD RATHER THAN A BYTE FIGURE, because none was measured: run the census-resolve contrast of gunbc#11738 against this producer and the gap should be dominated by SymbolIndex.entries and ReferenceDerivedPool.trees rather than by the parse. Test it; do not inherit it."
      ), on: "2026-11-19", note: "Source review at 398136026b345e087968a9db4ba42ec551c5ca4c (2026-11-19); source presence is not acceptance. v2.lens.module_graph::reference_derived_pool_from_located_roots already builds a keyed index, trees and path roster once, but retains every supplied tree. The old first slice conflates landed declaration-graft work with this residency change. Residual: measure the existing producer, remove unnecessary retained trees without changing edges, then run the invocation qualification; a keyed map alone does not establish bounded residency.")),
      dispatch: dispatchable(),
      parent: in_project(project: "namespace-unique-on-chain", contribution: "Name resolution is unique on the chain only when imports bind and producers are bounded; this row closes one of those gaps."),
    ),
    roadmap_node(
      identity: "rn_5NTJP2XWCB7QVK0HDRM8FZ4136",
      id: "boot-probe-must-not-read-a-bare-124-as-a-deadline",
      owner: "fleet",
      carriers: carrier(path: "dag/gunbc/runner/runner_microvm.dag"),
      line: ticket(t: fields(
        headline: "A micro-VM boot that exits 124 for its own reasons must not be reported as a deadline that fired",
        boundary: "gunbc.runner.runner_microvm_boot_probe boot_probe_verdict reads a bare exit status and returns BootExceededHostDeadline, and boot_probe_verdict_text renders a deadline sentence with a duration nobody observed, discarding the cause BootVmmFailed exists to carry. The repair is the capability the landed failure-mode row declares as its trigger: a typed execution-bound observation emitted at the deadline-enforcement decision and carried to the classifier.",
        displaced_cost: "The two events are indistinguishable by exit status alone, and the pair is re-derived by running `timeout --kill-after=1s 5s sh -c 'exit 124'` (forwarded child status, no expiry) beside `timeout --kill-after=1s 0.1s sleep 2` (expiry) and comparing their statuses, which agree. The discriminating facts and this pair are carried by the failure-mode row gunbc.recurring_failure_mode.bare_exit_124_read_as_an_observed_timeout_event, which is the authority for this class. Contained today only because boot_probe_admitted refuses both verdicts, so the defect is a wrong explanation rather than a silenced failure; that containment belongs to this consumer and evaporates under any consumer that exempts a timeout from blocking.",
        first_slice: "The observation emitted where the bound is imposed, for one bounded invocation.",
        red_control: "A child exiting 124 without the bound firing is not reported as a deadline; a real expiry still is.",
        out_of_scope: "No 124 arm keyed on the bare exit status anywhere, and no wall-clock reading substituted for the observation; the withdrawn floor classifier must not be re-attempted (the floor path has no GNU timeout producer, so its only reachable 124 is a subject's own).",
        handback: "The typed observation reaching the verdict, with the two 124 events distinguished by it."
      )),
      dispatch: dispatchable(),
      parent: in_project(project: "microvm-runtime-durable-state", contribution: "A micro-VM boot verdict is the runtime layer: a misread exit code is a wrong runtime fact."),
    ),
    roadmap_node(
      identity: "rn_9HVXR4CBM0KT2WPND7FJ3QZY85",
      id: "claim-entry-resolution-population",
      owner: "ci-control",
      carriers: carrier(path: "src/v2/workflow/required_floor.dag"),
      line: ticket(t: updated(t: fields(
        headline: "Count and close the claim entries that cannot execute under any driver",
        boundary: "Two populations, reported separately because they have different owners: entries whose closure is incomplete (registry rows absent), and entries that do not typecheck at all. A census over dag/test/claim under claim_batch, at identity grain, with member lists.",
        displaced_cost: "The populations are produced by running `gunbc test //test/claim/<package>` over every package under dag/test/claim and partitioning the failures on whether the run reports registry-row-absent causes; a partial run in that shape found members of both, the second including production modules such as dag/std/algebra.dag and dag/std/effect_axes.dag. The counts belong to the run that produces them and are not restated here, because a partial scan in sorted path order is a lower bound rather than a rate. The required floor is green over all of them, because an entry that fails to resolve is indistinguishable at the floor from one never selected.",
        first_slice: "The complete census with both member lists and both counts.",
        red_control: "An entry that cannot resolve is reported as unexecuted rather than passing silently; a production module that does not typecheck is named.",
        out_of_scope: "No weakening or deletion of any claim to make it resolve; the import-binding repair is its own row.",
        handback: "Both counts, both member lists, and the disposition of each population."
      ), on: "2026-11-23", note: "Bounded tranche relayed by neat-badger-614 from tidy-fox-641 (vivid-swift-693's lane), the executability census of src/v2/test/claim/manual/: population 176 files, 142 with imports, 34 with none, 3 importing v1. Of the 8 sampled, 6 cannot execute, 1 is inert (no zero-argument witness) and 1 executes with 2 passing. The other 168 are UNPRICED (not sampled, no estimate). Relayed figures, not re-measured here.")),
      dispatch: dispatchable(),
      parent: in_project(project: "ci-end-to-end-execution", contribution: "The required run is the factory verification half; a gap in what it counts, bills or reports is a gap in every landing it gates."),
    ),
    roadmap_node(
      identity: "rn_Z4Z5N3JJ9M8D6XBGHFV5HQHJMY",
      id: "test-reference-discipline-remainder",
      owner: "ci-control",
      carriers: carrier(path: "src/v1/compile.dag"),
      line: ticket(t: updated(t: fields(
        headline: "Finish the test-reference discipline: its own evidence onto the gate",
        boundary: "The v1 and v2 test-reference walls are landed; what remains is around them. The v1 wall is now one rule -- a reference reaching a TestMarked declaration refuses with TestCodeReferenced -- and the corpus ledger (test_reference_debt, FixtureControlRow, the admitted/budget/orphan diagnostics) was deleted because no production CorpusDebtRow remained. (1) Put the v1 wall's discriminating reds (test.claim.test_reference_wall_witness) on a required_gate_prefixes entry; today they run nowhere on the merge path. (2) Enforce the v2 wall corpus-wide: no required lane compiles the corpus through v2 name resolution; this waits on the native route. (3) Close two instrument gaps: warm-roster admission does not execute in the restored floor, and a producer's emission (labels included) cannot be cheaply read.",
        displaced_cost: "A wall whose own red executes nowhere is the inflation gunbc.design_argument::guarantee_ladder (rung honesty) names: the class reports mechanically-preventable while nothing would catch its regression. The instrument gaps are why several of these rounds cost four passes each: an unmeasured cache row and a hand-reconstructed fixture are both cheap to write and expensive to disprove.",
        first_slice: "One prefix line so the v1 wall's reds execute on the gate.",
        red_control: "A test calling a test refuses on the required lane and not only locally; a reference to an ordinary declaration is accepted; and a real source carrying a test-fn reference reaches v2 name resolution through a required corpus route and refuses THERE, not only at the interface.",
        out_of_scope: "No re-enrolment of the cache rows deleted while landing this work without a controlled row-present against row-absent experiment on one host -- portability establishes that a value CAN be served, never that serving beats recomputing. No widening of the wall to shapes v1 inference cannot see: a function value reached through an import-all types as LocalValueBinding, and that is a declared gap rather than a silent one.",
        handback: "The prefix landed with its reds observed executing on a required run; the v2 corpus route either carrying a refusal for a real test-fn reference or that obligation transferred BY NAME to the node owning the native route; and the two instrument gaps either closed or written down as their own rows."
      ), on: "2026-09-24", note: "The brief before the 100-word re-cut, verbatim (obligations kept in the brief, context here): The walls themselves are landed -- v1 IDENTIFIES every test reference its typed frontier can see (a call from anywhere including another test, a function value, a parameter default, a named import) and refuses any that the shrink-only debt ledger does not exactly cover -- a reference matching a surviving row is ADMITTED, as a temporary admission awaiting deletion, not permitted; v2 refuses at name resolution. That frontier is not the whole language: out_of_scope names the import-all function value v1 inference cannot see. What remains is around them. THE LEDGER: test_reference_debt carries the surviving corpus rows plus one fixture control, an equality budget at (module, referrer, target) refusing in BOTH directions, so a row is paid down only by deleting the reference and its row together. THE EVIDENCE GAP: the v1 wall's discriminating reds live in test.claim.test_reference_wall_witness, which matches no entry in v2.workflow.required_floor required_gate_prefixes, so they execute nowhere on the merge path while every other gated class runs; the loss is covered generically by gunbc.rung_drop witness_floor_off_the_required_gate rather than specifically. THE V2 WALL'S COVERAGE IS NARROWER THAN ITS NAME: its refusal is established by execution AT THE INTERFACE, on supplied roots plus two route claims, and NO required lane compiles the corpus through v2 name resolution -- so a real test-fn reference in the tree does not red it, which is how one survived until a reviewer read for it. Corpus-wide v2 enforcement waits on the native route. TWO INSTRUMENT GAPS found while landing the four PRs: the warm-roster admission instrument does not execute in the restored floor -- a row naming a declaration that no longer existed passed green, though the roster's own rule says an unresolvable row stops preparation -- and there is no cheap way to read what a producer actually emits, labels included, which is what let a supplied fixture diverge silently until its pairing claim went red.")),
      dispatch: dispatchable(),
      execution: bound(contract: gunbc_claim_execution_contract(
        entry: "dag/test/claim/closing/test_reference_discipline_remainder_closing_contract_witness.dag" as FilePath,
        function: "test_reference_discipline_remainder_closing_contract_holds" as NonEmptyStr,
      )),
      parent: in_project(project: "ci-end-to-end-execution", contribution: "The required run is the factory verification half; a gap in what it counts, bills or reports is a gap in every landing it gates."),
    ),
    roadmap_node(
      identity: "rn_Z3FS3HMD5WWH1Z7FGPK1KAWJBM",
      id: "fleet-health-0-live-receipt",
      owner: "fleet",
      carriers: carrier(path: "dag/gunbc/fleet/fleet_health.dag"),
      line: TicketLine { ticket: fields(
        headline: "HEALTH-0 is built and green; it needs one live run under the qualified realization to leave draft",
        boundary: "gunbc.fleet.fleet_health fleet_health_check is an out-of-band, read-only, goal-blind check over fleet_intent_known_hosts: firmware-derived telemetry surface, five sampled fan/temperature windows, an event-log window with wrap/clear continuity, assessment over std.goal_assessment, and a receipt whose first line discloses the evaluation realization. gunbc#11681 carries it with 29 passing witnesses, including a call-reachability wall that no mutation is reachable from the entry. What remains is one live run under GUNBC_EVAL_MEMO=0 whose receipt matches the current code, and attaching it to the PR.",
        displaced_cost: "Three real conditions were found by the first live run and nothing else in the repository observes them: srv1 FAN4 rotating in 1 of 5 samples and FAN5 in 2 of 5, srv2 FAN5 in 2 of 5, srv3 logging 14 corrected memory errors and DIMM_HOT in a single half-hour window, srv4 DIMM_HOT on two channels. Until the check runs on a cadence those degrade unobserved.",
        first_slice: "One live fleet_health_check run against srv1-srv4 with an operator access token, its receipt attached to gunbc#11681, and the PR flipped out of draft.",
        red_control: "The enrolled fixture's bare-call mutations are found by the same reachability derivation that reports the health closure clean; a service-call mutation is asserted INVISIBLE so the claim fails when the instrument gains service-call identity.",
        out_of_scope: "Admitted baselines (HEALTH-1) and serving admission (HEALTH-2) are their own rows. No in-band fallback for any signal the BMC does not expose.",
        handback: "A merged gunbc#11681 with a live receipt in its body, and gunbc#11696 landed after it to delete the consumed namespace admission rows."
      ) },
      parent: in_project(project: "fabric-application-authority", contribution: "The fabric decides placement from observed fleet facts; fleet health, convergence and hardware observation are those facts."),
    ),
    roadmap_node(
      identity: "rn_TD7X82087026JR4X3XKSHAT7Z6",
      id: "fleet-health-1-admitted-baselines",
      owner: "fleet",
      carriers: carrier(path: "dag/product/host_health.dag"),
      line: TicketLine { ticket: fields(
        headline: "Health baselines: tell new errors from history without letting a divergent run rebaseline itself",
        boundary: "product.host_health already takes HostHealthBaselineBasis as an input seam and answers NoPriorBaseline today. This selects the last ADMITTED or explicitly dispositioned receipt, verifies subject, counter epoch and evidence manifest before subtracting, and makes diagnosis or operator disposition the only route to a replacement baseline.",
        displaced_cost: "Without it every host with any history stays indeterminate forever: srv3 and srv4 carry 1200-entry event logs that can never be dispositioned, so the check can report change but never quiet. The automatic-rebaseline trap is the specific harm: run A sees a new corrected error, run B takes A as its baseline, and the unresolved error disappears after one cycle.",
        first_slice: "Durable receipt selection plus the refusal that a divergent observation may not mint a baseline, with the four counter-window cases already witnessed re-expressed against a stored receipt.",
        red_control: "A divergent run cannot produce an admissible baseline; a baseline for another host, another counter epoch or another endpoint set refuses; history that was never dispositioned stays an unknown rather than becoming zero.",
        out_of_scope: "Serving admission consumption. Any new cache or store beyond the receipt the check already writes.",
        handback: "A health run that reports new-since-last-admitted for memory counters and event records, with the rebaseline refusal witnessed."
      ) },
      parent: in_project(project: "fabric-application-authority", contribution: "The fabric decides placement from observed fleet facts; fleet health, convergence and hardware observation are those facts."),
    ),
    roadmap_node(
      identity: "rn_YWBBMCMY5FHC2Q5VCX9AA8MA46",
      id: "fleet-health-2-serving-admission",
      owner: "fleet",
      carriers: carrier(path: "dag/product/host_health.dag"),
      line: TicketLine { ticket: fields(
        headline: "A host serves only on a fresh satisfied health receipt",
        boundary: "Serving admission consumes the health inspection and the convergence standing as a product: same host identity, expected fleet and policy revisions, satisfied assessment, freshness, window continuity, and where required a health window opened after a named apply receipt. Unknown health denies new placement without pretending an emergency shutdown was authorized.",
        displaced_cost: "Health that nothing consumes is a report nobody is obliged to read. Today a host with a dead fan or new uncorrected errors is as admissible for work as a clean one.",
        first_slice: "New-host admission requires a fresh satisfied receipt; previously serving hosts with divergence become drain candidates.",
        red_control: "A stale receipt, a receipt for another host, and an indeterminate assessment each deny admission; a satisfied fresh receipt admits.",
        out_of_scope: "Automatic workload kill, reboot or repair from the health route.",
        handback: "Admission consuming health, with the deny arms witnessed."
      ) },
      parent: in_project(project: "fabric-application-authority", contribution: "The fabric decides placement from observed fleet facts; fleet health, convergence and hardware observation are those facts."),
    ),
    roadmap_node(
      identity: "rn_FH7X3QWQJ14MVMN9ES41C4HNZ6",
      id: "srv1-srv2-bmc-firmware-exposes-memory-errors",
      owner: "fleet",
      carriers: carrier(path: "dag/gunbc/fleet/fleet_health.dag"),
      line: TicketLine { ticket: fields(
        headline: "srv1 and srv2 cannot report memory errors out of band on firmware 2.07",
        boundary: "Both hosts run the ASRock 2.07 image: no MemoryMetrics resource and an empty Redfish event log, so the out-of-band check is structurally unable to see memory errors there. srv3 and srv4 on OpenBMC 3.22 do report them as MemoryECCCorrectable records. The work is the flash and its qualification, not a health-side workaround.",
        displaced_cost: "srv1 has recorded 255 corrected memory errors in-band since its August boot with all of them unattributed to a DIMM; out of band the health check must report that host unknown on memory indefinitely. Two of four hosts are unobservable on the signal most likely to precede a failure.",
        first_slice: "Qualify the 3.22 image on one of the two hosts through the existing BMC firmware route, then confirm the health check reports memory events for it.",
        red_control: "After the flash, a health run reports the host's memory signal as observed rather than not-exposed-out-of-band.",
        out_of_scope: "Any in-band EDAC read as a substitute. The standing rule is out-of-band only.",
        handback: "Both hosts on an image whose event log carries memory records, with a health receipt showing the signal observed."
      ) },
      parent: in_project(project: "fabric-application-authority", contribution: "The fabric decides placement from observed fleet facts; fleet health, convergence and hardware observation are those facts."),
    ),
    roadmap_node(
      identity: "rn_W1PKZZXFM2CS3TKAXDG59PD29S",
      id: "srv3-srv4-fan-threshold-flapping-floods-the-event-log",
      owner: "fleet",
      carriers: carrier(path: "dag/gunbc/bmc/bmc_fan_converge.dag"),
      line: TicketLine { ticket: fields(
        headline: "Fan threshold flapping overwrites the BMC event log within hours",
        boundary: "srv3 and srv4 log a FAN threshold assert/deassert pair repeatedly: 982 of srv3's 1200 entries on 2026-09-18 were one fan's deassert, and the log wraps at about 1200, so entries roll off in hours. Either the fan curve or the thresholds are wrong for these chassis. gunbc.bmc.bmc_fan_converge already owns fan policy.",
        displaced_cost: "Event-log continuity is the health check's only out-of-band route to memory errors, and it survives only over windows shorter than the wrap. Every memory record older than a few hours is already lost on those two hosts.",
        first_slice: "Establish whether the flapping fan is below its own threshold because the threshold is wrong or because the fan is failing, then converge whichever is wrong.",
        red_control: "After the change, an event log read twice a day apart still contains its earlier newest entry.",
        out_of_scope: "Raising the health check's sampling rate as a substitute for fixing the flapping.",
        handback: "A log whose wrap horizon exceeds the health cadence, and a fan policy that stops asserting."
      ) },
      parent: in_project(project: "fabric-application-authority", contribution: "The fabric decides placement from observed fleet facts; fleet health, convergence and hardware observation are those facts."),
    ),
    roadmap_node(
      identity: "rn_H1TH1ZJTFQNC5G2Q7YHJ7RMZZF",
      id: "dimm-temperature-limits-need-a-citation",
      owner: "fleet",
      carriers: carrier(path: "dag/product/host_health.dag"),
      line: TicketLine { ticket: fields(
        headline: "No temperature limit is cited, so every sensor reads unestablished",
        boundary: "product.host_health carries TemperatureLimit with its authority as a field and refuses to invent one; the fleet goal declares all twenty board sensors with TemperatureLimitUnestablished. The work is citing limits for the DIMM parts and the board sensors that have them, per component grade, so the check can judge a reading rather than only carry the BMC's verdict.",
        displaced_cost: "srv1 DIMM C1 was read at 99 C with the BMC reporting OK, because the BMC carries only a 105 C critical line and no caution threshold. srv3 and srv4 assert DIMM_HOT. Nothing in the corpus can say whether those readings are acceptable.",
        first_slice: "Cite the JEDEC or vendor limit for the installed DDR4 parts and bind it to the DIMM sensors, leaving the rest unestablished rather than guessed.",
        red_control: "A sensor above its cited limit diverges; a sensor whose limit is uncited still cannot produce a green.",
        out_of_scope: "Fleet-wide default limits. An uncited number is refused by construction.",
        handback: "Cited limits on the sensors that have them, with the citation on the row."
      ) },
      parent: in_project(project: "fabric-application-authority", contribution: "The fabric decides placement from observed fleet facts; fleet health, convergence and hardware observation are those facts."),
    ),
    roadmap_node(
      identity: "rn_NBX7Z3E7CSV0JBT611DGGXG1AD",
      id: "eval-memo-admission-rewire-program",
      owner: "self-host",
      carriers: carrier(path: "dag/gunbc/recurring_failure_mode/memo_key_rehashes_a_growing_persistent_value.dag"),
      line: TicketLine { ticket: updated(
        t: updated(
          t: fields(
        headline: "The seed keys every pure call before admission; the rewires that make retirement landable",
        boundary: "The seed's eval-frame result memo keys every pure call before any admission decision, so a single-demand call pays full key construction -- and a key over a string argument is O(size), which makes any recursive fold over a document quadratic. The repair is root-first (option A): the demand and materialization judgment is consulted BEFORE result-memo key construction, and the shared producers the memo was concealing are rewired to carry their established value rather than re-derive it. Retirement of the provider is qualified on the repaired corpus as one combined cutover, never landed while the required floor is red.",
        displaced_cost: "JSON parsing is O(n squared) because every pure call re-hashes its whole string argument, so the cost of parsing a document grows with the square of its size and the same shape taxes every text-processing route under the interpreter. The shape is re-derived by running any large-document parse under the seed with the result memo enabled and again with GUNBC_EVAL_MEMO=0, which is the paired arm that shows the quadratic is the memo key and not the parse; the corpus-wide effect of removing it is re-derived by the required floor run's own per-claim eval-step and completion reporting, which stage 2 gunbc#11835 moved.",
        first_slice: "Land stages 1 and 2, then stage 3, each with per-claim before/after under both realizations and no claim crossing its ceiling on the memo-on path the floor runs today.",
        red_control: "A direct-recompute demand reaches neither key construction nor memo storage, with a control that fails when unconditional keying is restored; every stage keeps the floor population and terminal results unchanged.",
        out_of_scope: "A pointer-hash string cache, a function-name allowlist, a roster memo dressed as declared recurrence, and any global memo-default flip without consumer-wide qualification -- all refused by ruling.",
        handback: "The shared producers rewired, and retirement re-qualified on the repaired corpus as one combined cutover with the required floor green."
          ),
          on: "2026-09-20",
          note: "Status at wind-down: stage 1 gunbc#11784 (integer decode reads carried tables) and stage 2 gunbc#11835 (grammar backward selection resolves each emitted tree once) are green, approved and awaiting merge; the retirement gunbc#11741 is a held draft carrying its own handback; stage 3 (rust.dag's 64 nullary Node constants as data) is drafted, resolves and passes, and is preserved unopened at origin/session/merry-fox-260-stage3 c1c925060c with its nine-module comparison unfinished. Stage 2 also discharged the docs-regeneration blocker: the real regen route was run end to end on the memo-retired binary and completed with byte-identical projections, which is the check to repeat (the generated-artifact gate's own regen entry point) before the retirement is qualified.",
        ),
        on: "2026-09-20",
        note: "Four readings this lane took, each recorded with the producer that re-derives it rather than with its number, so a successor re-runs the instrument instead of trusting a figure that has rotted. Producer ranking must come from the required floor run's own required_floor_cross_claim_demand.tsv (evals minus claims), never from claim_batch, which installs no cross-claim roster and therefore charges producers the floor serves warm -- the lane's first ranking was wrong for exactly this reason. The diagnostics_merge repeat count that first looked like hot work is memo-hit verification cost instead, and what separates the two is the interpreter's own memo key trace (its keyed-call, distinct-key and duplicated-key counters), which is the instrument to re-run before treating any repeat count as work. The comparison between a bottom-up grammar resolution that matches all productions per node and the asked-lhs top-down form is re-derived by the bounded A/B harness gunbc#11835 carries, which measures both shapes on the memo-on path; the top-down form won. And claim_batch shares one ctx per entry, so a data row's first-touch cost lands on whichever claim runs first, which makes its per-claim comparisons unsound as a cost instrument regardless of what they report.",
      ) },
      parent: in_project(project: "v2-compiler-live", contribution: "Primitive egress, interpreter cost and self-host admission are what the self-hosted compiler needs before it is the one that runs."),
    ),
    roadmap_node(
      identity: "rn_2CB9RP256VFYH7KM4NXQ8WDT3A",
      id: "v1-interpreter-p256-verify-cost-shape",
      owner: "self-host",
      carriers: carrier(path: "dag/extdeps/crypto/nist_p256.dag"),
      line: ticket(t: updated(t: updated(t: updated(t: updated(t: fields(
        headline: "Measure where one interpreted P-256 verification spends its steps and memory, as the basis for cutting it",
        boundary: "Receipt gunbc#11645: one interpreted p256_ecdsa_verify_octets takes gigabytes resident and minutes, so the required floor budget-refuses all eight members of test.claim.p256_dag_ecdsa_witness and the interpreted approval broker cannot verify a signature, assertion or attestation chain in usable time. A 256-bit verification is a few thousand field multiplications (std.bignat Montgomery multiplication, the extdeps.crypto.nist_p256 ladder), so this is a cost-shape defect in how the interpreter realizes those folds (gunbc.design_argument::how_to_work), not a workload property. The instrument is claim_batch --hermetic --entry dag/test/claim/p256_dag_ecdsa_witness.dag --functions the_rfc6979_sample_signature_verifies, read by its [witness] line and VmHWM. RE-SCOPED as a measurement node by operator ruling 2026-11-23 (\"regarding the p256 - yes you can rescope it.\"). Reason, measured by warm-fox-517: one verification takes about 48.3M steps, 78-101 s and about 15 GB; about 93% of the steps are in one modular-multiplication routine (about 7,227 steps per call over about 6,200 calls); even at 1 step per 24-bit-limb multiply the floor is about 1.57M steps, 4.3x the floor's 361,500 per-claim budget, and the 256 doublings alone are 518,144 steps. So no interpreter optimisation reaches the budget, and fitting it is no longer this node's control. The cut itself is p256-verify-cost-cut.",
        displaced_cost: "Every interpreted consumer of std.bignat pays it: the approval device routes (four ECDSA verifications per phone approval), the App Attest chain (two P-384 verifications per enrolment), and any future big-integer fold. Until the shape is found, the approval broker's device routes have no execution route except the native emission that #11819 gates, and the floor cannot enroll the eight P-256 witnesses at all.",
        first_slice: "Run the instrument once and record its attribution of steps by routine and the memory residency beside the totals, then name which of the two candidate cut sites the numbers point at: the v1 interpreter fold realization or the std.bignat number representation.",
        red_control: "The verification cost is measured and recorded from one claim_batch --hermetic run of test.claim.p256_dag_ecdsa_witness the_rfc6979_sample_signature_verifies, giving steps, wall time and VmHWM from that same run, plus the attribution of steps by routine, with the RFC 6979 and Wycheproof refusal members still refusing. It does not require fitting the floor's 361,500 per-claim budget.",
        out_of_scope: "No host-Rust verification primitive (operator refusal on #11588/#11592 stands); no widening of the floor budget to admit the current cost; no change to the P-256 arithmetic's semantics -- the vectors are the oracle.",
        handback: "The one run's steps, wall time and VmHWM, the attribution of steps by routine, the refusal members' verdicts, and which cut site the measurement names."
      ), on: "2026-09-21", note: "The brief before the 100-word re-cut, verbatim (obligations kept in the brief, context here): The receipt is gunbc#11645: one interpreted p256_ecdsa_verify_octets peaks at 13.5 GiB resident (VmHWM 14,132,132 kB) and takes 192 s to 734 s depending on host residency, so the required floor budget-refuses all eight members of test.claim.p256_dag_ecdsa_witness and the interpreted approval broker cannot verify a device signature, an App Attest assertion or an attestation chain in usable time. The arithmetic is std.bignat Montgomery multiplication over limb lists and the double-scalar ladder in extdeps.crypto.nist_p256; a 256-bit verification is a few thousand field multiplications, so a resident set in the tens of gigabytes is a cost-shape defect in how the interpreter realizes those folds (gunbc.design_argument::how_to_work, bare minimum cost), not a property of the workload. The instrument that re-derives the figure is `claim_batch --source-root dag --source-root src/v2 --hermetic --entry dag/test/claim/p256_dag_ecdsa_witness.dag --functions the_rfc6979_sample_signature_verifies` read by its [witness] line and the process VmHWM; no number in this row is authoritative over that run. This is the B arm of the 2026-09-21 approval-app decision (parent ruling on msg_4d665941): filed for the v1-performance program, NOT started by the approval lane, whose terminal shape is the natively emitted verifier bound as one realization handler of the extdeps.crypto.signature and extdeps.apple.app_attest seams once MachineWidth<N> reification lands."), on: "2026-11-23", note: "Re-scoped as a measurement node under the operator ruling of 2026-11-23; the cost cut moved to p256-verify-cost-cut."), on: "2026-11-23", note: "RETIRE (ruling of neat-badger-614, carried by warm-fox-517): this row is no longer acceptance-shaped. Its red lives on p256-verify-cost-cut as the step budget (failing at main, passing after the cut); neither measurement below is red, the memo=0 arm is slower and not red. The retirement itself is an event in the one roadmap event log (kind retire), not a row edit; this note only carries the finding as data. FINDING, executed by keen-pike-826 at tree b69155949654bac604dd2f29ba0df22bf71869a5 with claim_batch sha256 9cb21df4c20325fc53ba4187cf4c55bd08037862a45d3900c5cc5519e360a177, --hermetic, source roots dag + src/v1 + src/v2: (1) entry dag/test/claim/p256_dag_ecdsa_witness.dag function the_rfc6979_sample_signature_verifies: PASS, eval_steps 48,296,785, witness cpu 101,627 ms, wall 101,633 ms, Maximum resident set size 14,983,500 kB, Exit status 0, process wall 5:49.88. (2) same witness with GUNBC_EVAL_MEMO=0: 51,629,999 steps, 78.3 s, 6,697,188 kB. (3) seven refusal or false members, all PASS with Exit status 0: a_signature_for_a_different_message_is_false 47,812,516 steps / 112.3 s; the_wrong_key_is_false 47,837,633 / 116.0 s; a_point_off_the_curve_is_absent 94,765; wycheproof_4_n_minus_r_is_false 47,820,682 / 114.5 s; wycheproof_11_r_and_s_zero_are_absent 96,265; wycheproof_26_r_equal_to_n_is_absent 97,033; wycheproof_2_r_plus_n_is_absent 43,183; VmHWM 17,300,220 kB. (4) Cut site: std.bignat's number representation, 253 limb multiplies per montgomery_mul call at about 28.6 eval steps each, measured marginal 7,227 steps per chained mul from the t0/t1/t3 probe (234,485 / 242,639 / 257,093); even 1 step per limb multiply is about 1.57M steps against the 361,500 budget, so no interpreter fold realization reaches it. Separate finding, memory and not steps: the eval-call memo has no byte bound (v1_interpreter.rs, no symbol cited because none was named). CAVEAT: per-routine attribution is an estimate (the mul count is read from source, not profiled), and the same witness's step count moves with shared memo state across processes (47,352,196 vs 47,812,516 for the same member). Also measured: base-point-only floor VmHWM 6,815,264 kB; all twelve witnesses in one process VmHWM 20,380,524 kB, the seven verifies 47.05-48.71M steps at 102-109 s each; memo-off memory difference traces to eval_call_memo_put storing args and result with a cap of 1,000,000 entries and no byte budget. Counterfactual (a nested Int fold, no limb lists): 20,283,019 steps, 5.39 s, VmHWM 6,693,772 kB, so the fold realization per se is not what pins memory. Idealised cost at 1 step per limb multiply is about 6.2k muls x 253 = 1,568,600 steps, 4.3x the 361,500 budget and 21.7x the 72,300 new-claim budget. Brief defects found: the row said eight witnesses and the file has twelve; the 81-91 GB figure was not reproducible (14.98 GB single verify, 20.4 GB all twelve). Open: whether Value::Int promotes on i64 overflow is unverified. Probe files, uncommitted, sha256: p256_cost_mont_mul_step_receipt_witness.dag 80d6615128e4c8cb8071e960b5fc3db5c81c924a79e0a44781131ff96516a4f1; p256_cost_counterfactual_fold_witness.dag b75439bb6472ec4d07f75ddbc63c2721ba4e722ec01eb5a66429d87070294858. Raw logs run1..run8.log and the runN.sh commands are uncommitted in srv1 ~/scratch/keen-pike-826."), on: "2026-11-23", note: "Sequencing relayed 2026-11-23 by warm-fox-517 from neat-badger-614's answer (not recorded in gunbc.design_ruling): the cut has standalone value and does not depend on the native-emission terminal; its consumers are the interpreted users of std.bignat, the approval broker's device routes and the App Attest chain, which get faster as soon as it lands. Only the floor enrolment of the eight P-256 witnesses waits on native emission, because the limb-multiply floor of about 1.57M steps is 4.3 times the floor's 361,500-step budget, so no bignat cut can bring a verification inside it and only the natively emitted verifier can. Do not gate the cut behind emission work, and do not add the eight witnesses to the floor as a done condition for the cut; a row that wants their floor enrolment depends on the v2 emitter and native emission lane, not on this cut. Figures as the reporter measured them: baseline one member 48,296,785 eval_steps, VmHWM 14,996,496 kB at tree 91d657a62d72 with the tree-built claim_batch a10ce5fb..77ff.")),
      dispatch: dispatchable(),
      parent: in_project(project: "v2-compiler-live", contribution: "Primitive egress, interpreter cost and self-host admission are what the self-hosted compiler needs before it is the one that runs."),
    ),
    roadmap_node(
      identity: "rn_7IM00JSRILQN51NO5H4GJVQZYD",
      id: "v1-interpreter-carrier-split-cost-instrument",
      owner: "self-host",
      carriers: carrier(path: "src/v2/std/text.dag"),
      line: ticket(t: fields(
        headline: "A bounded carrier-plus-three-splits witness exists that reports its own cost and refuses by exceeding its bound rather than by running on",
        boundary: "Reported by warm-fox-517 from calm-owl-786's measurement on srv1, durable at gunb-ai/gunbc#17008 comment 7133253574. A claim that reads one 215 KB committed carrier through extdeps.filesystem.filesystem_read and performs three string_split passes ran 37 minutes at 9.5 GB resident before it was killed, and that leg never emitted a step count -- so eval_steps is not observable for that shape today. The roughly 5 minutes and 7 GB figure belongs to the required-floor precompute of the same invocation, not to the split passes, and no per-split figure was ever captured. The code walked is fn string_split at src/v2/std/text.dag:137; the interpreter executing the claim is the v1 interpreter, and the cost may sit in its char-list representation rather than in either file's logic -- cause UNKNOWN, and this row chooses neither. Consequence while this row is open: any roadmap row whose red_control is a source-text structural claim over a large carrier is silently unsatisfiable, because there is no way to state its red without a hang.",
        displaced_cost: "Every claim that reads a committed carrier and splits it pays the cost blind, so the only honest answer to how long it takes is to start a run and wait. Worse structurally: planning cannot dispatch, and a manager cannot honestly accept, any row whose red_control is a structural claim over a large carrier, until a bounded witness exists that can be shown red on a tree.",
        first_slice: "Land the instrument and nothing else. One claim that reads one FIXED-SIZE carrier through extdeps.filesystem.filesystem_read, performs the same three string_split passes the reported run performed, prints eval_steps and resident memory, and enforces an explicit bound in eval steps AND a wall ceiling. It must fail BY EXCEEDING its bound and never by hanging -- the explicit bound is what turns this shape into a witness instead of a 37-minute wait. No cut, no optimisation, and no change to string_split, to filesystem_read or to the interpreter in this slice.",
        red_control: "NOT YET EXECUTED, stated plainly: the red is made by this row's own witness, and until it is run this row has a before-observation and no red. BEFORE, executed: calm-owl-786 on srv1, gunb-ai/gunbc#17008 comment 7133253574 -- the 215 KB three-split shape ran 37 minutes at 9.5 GB RSS and was killed; that comment carries the claim_batch invocation with its entry groups and source roots, the binary identity, the tree identities and the carrier sha256s. RED TO BE: this row's bounded witness, run at main over the 215 KB carrier shape, REFUSING by exceeding its explicit step bound or wall ceiling, with raw output and the command's own exit status. GREEN: the same witness over its fixed-size carrier inside the bound, inside the same run's named negative case. This row is not acceptable while its red is unexecuted.",
        out_of_scope: "No optimisation of string_split, of the char-list representation or of filesystem_read; no ruling on whether the cost site is v2 std text or the v1 interpreter; no change to the required floor budget and no new floor row; no wall-time figure promoted to a criterion -- 37 minutes and 9.5 GB are the reported BEFORE only; no host-side timing harness outside the limiter; no hand-written seed Rust.",
        handback: "The witness module and function name, the fixed carrier size with its sha256, the explicit step bound and wall ceiling as written in the claim, the bound-exceeding refusal at main with raw output and the command's real exit status, the inside-bound pass at head with its eval_steps and resident memory, the srv1 acquisition line with HOST, BOOT and the binary sha256 read from disk, and a plain statement of which candidate cost site the numbers implicate -- or that they implicate neither."
      )),
      dispatch: dispatchable(),
      parent: in_project(project: "v2-compiler-live", contribution: "Primitive egress, interpreter cost and self-host admission are what the self-hosted compiler needs before it is the one that runs."),
    ),
    roadmap_node(
      identity: "rn_CN2KZR66EFV6KB1YNJ5G32YEGF",
      id: "p256-verify-cost-cut",
      owner: "self-host",
      carriers: carrier(path: "dag/extdeps/crypto/nist_p256.dag"),
      line: ticket(t: updated(t: updated(t: updated(t: fields(
        headline: "Cut the step count and memory of one interpreted P-256 verification at the site the measurement names",
        boundary: "Follows v1-interpreter-p256-verify-cost-shape, which measures: about 48.3M steps, 78-101 s and about 15 GB per verification, about 93% in one modular-multiplication routine. The cut has two candidate sites and the measurement chooses between them: the v1 interpreter's fold realization (hand-written seed Rust, so a v1 change needs the v2 self-host purpose test) or std.bignat's number representation (v1 stdlib, which means regenerated Rust and heal rounds). Its terminal shape stays the natively emitted verifier noted in the measurement row.",
        displaced_cost: "Every interpreted consumer of std.bignat pays the cost: the approval device routes, the App Attest chain and any future big-integer fold; the P-256 witnesses cannot be enrolled in the floor while one verification costs about 48.3M steps.",
        first_slice: "The cost cut itself, at whichever of the two candidate sites the measurement names.",
        red_control: "The eval_steps of the named member test.claim.p256_dag_ecdsa_witness the_rfc6979_sample_signature_verifies, from one claim_batch --hermetic run, fall from the baseline 48,296,785 by at least 50 percent, and the same run's VmHWM does not rise, with every vector verdict unchanged and the RFC 6979 and Wycheproof refusal members still refusing. The threshold is a planning pick, revisable by an updated row; nothing is stated per routine, because claim_batch has no per-routine profile and a per-routine count cannot be falsified. Baseline, one member, hermetic, rc 0, verified by warm-fox-517 at source: tree 91d657a62d72, claim_batch built at that tree (binary sha256 a10ce5fb..77ff), the_rfc6979_sample_signature_verifies alone: eval_steps 48,296,785 and VmHWM 14,996,496 kB. Wall time (122.985 s) is host-load dependent and is not a control. The other seven members of the batch are evidenced by run11.log, not by this figure.",
        out_of_scope: "The floor's 361,500-step budget as a pass condition (the limb-multiply floor of about 1.57M steps is 4.3x over it, so no bignat cut reaches it; it is reachable only at the native-emission terminal); no host-Rust verification primitive (operator refusal on #11588/#11592 stands); no widening of the floor budget to admit the current cost; no change to the P-256 arithmetic's semantics -- the vectors are the oracle.",
        handback: "The site chosen and why, the before and after eval_steps and VmHWM of the named member from the same instrument, and every vector verdict before and after."
      ), on: "2026-11-23", note: "Measured baseline from the v1-interpreter-p256-verify-cost-shape (keen-pike-826, tree b69155949654bac604dd2f29ba0df22bf71869a5, claim_batch sha256 9cb21df4c20325fc53ba4187cf4c55bd08037862a45d3900c5cc5519e360a177): the_rfc6979_sample_signature_verifies is 48,296,785 eval steps, 101.6 s, VmHWM 14,983,500 kB, against the floor's 361,500-step budget; the budget failing at main and passing after the cut is this row's red control. The cut site named is std.bignat's number representation. Full data is on the retired row's note."), on: "2026-11-23", note: "Amended on warm-fox-517's verified baseline (srv1 tree 91d657a6, run11.log), relayed by neat-badger-614: the cut is stated as the named member's eval_steps falling from 48,296,785 by at least 50 percent, with VmHWM measured one-member; per-routine counts are stripped. The one-member baseline then landed (tree 91d657a62d72, eval_steps 48,296,785, VmHWM 14,996,496 kB) and is recorded in the red_control; it matches the earlier baseline in steps exactly and in VmHWM within 0.09 percent. The earlier note's sentence that the budget failing at main and passing after the cut is this row's red control is superseded: the control is the measured reduction at the named instrument, and the 361,500-step budget is context reachable only at the native-emission terminal. The earlier baseline (tree b6915594, released binary 9cb21df4, VmHWM 14,983,500 kB) stays above as history; the ticket baseline is re-pointed to tree 91d657a62d72 by this row. v1-interpreter-p256-verify-cost-shape retires into this row by an event, not by this edit."), on: "2026-11-23", note: "Sequencing relayed 2026-11-23 by warm-fox-517 from neat-badger-614's answer (not recorded in gunbc.design_ruling): the cut has standalone value and does not depend on the native-emission terminal; its consumers are the interpreted users of std.bignat, the approval broker's device routes and the App Attest chain, which get faster as soon as it lands. Only the floor enrolment of the eight P-256 witnesses waits on native emission, because the limb-multiply floor of about 1.57M steps is 4.3 times the floor's 361,500-step budget, so no bignat cut can bring a verification inside it and only the natively emitted verifier can. Do not gate the cut behind emission work, and do not add the eight witnesses to the floor as a done condition for the cut; a row that wants their floor enrolment depends on the v2 emitter and native emission lane, not on this cut. Figures as the reporter measured them: baseline one member 48,296,785 eval_steps, VmHWM 14,996,496 kB at tree 91d657a62d72 with the tree-built claim_batch a10ce5fb..77ff. Best variant so far 24,297,256 steps at VmHWM 9,308,652 kB, 49.69 percent against the required 50, all eight vector verdicts passing on baseline and the seven refusal members refusing; the remaining residual of about 45 steps per cell is inside the interpreter's fold realization, which is the v1 freeze and the operator's call. This is a reported measurement, not re-measured here.")),
      dispatch: dispatchable(),
      parent: in_project(project: "v2-compiler-live", contribution: "Primitive egress, interpreter cost and self-host admission are what the self-hosted compiler needs before it is the one that runs."),
    ),
    roadmap_node(
      identity: "rn_0B7NZNSZ40T350G5K0WW8Y1H5T",
      id: "reference-floor-names-the-refused-file",
      owner: "ci-control",
      carriers: carrier(path: "src/v2/cli/reference_check.dag"),
      line: ticket(t: fields(
        headline: "Make the reference-floor report name the module that dropped out of the load, not only the citers that could not resolve it",
        boundary: "v2.cli.reference_check checks marked references over the modules the load normalized. A .dag that fails a parse refusal drops out of that load and contributes no line, so the report names only its citers: the per-line builder emits RunStepTargetCallerUnread with c.file and c.caller, the citer, and the count line reads that N marked reference(s) or population member(s) did not resolve or could not be judged. The refused module is never named, so the failure reads as the citers' defect. Observed on gunbc#16878 (floor-parse-formation-wall), where the count moved 241 -> 257 between heads as main added files that fail the parse wall, none of them named. A fail-closed refusal must name its cause (gunbc.design_argument::fail_closed). Verified by bold-pike-529 at main f2c7ef1118d by reading the module; there is no line cap in the code (the earlier max_lines claim was a misreading of the CI log), so whether any layer truncates the printed set is open and not asserted here.",
        displaced_cost: "A reviewer or author reading the floor refusal chases the citers, none of which is wrong, while the refused file sits unnamed; every parse wall landing on a populated corpus pays that misdirection.",
        first_slice: "Carry the set of modules refused at the read or parse step into v2.cli.reference_check and print each by name before the per-citer lines; when the printed set is truncated at any layer, state how many lines were omitted.",
        red_control: "OPEN: red_at and green_at are not yet measured. The control is a fixture corpus whose one module fails a parse refusal and is cited by another: today the report names only the citer; after the change it names the refused module first, with the omitted count when it truncates. It must be run against the real v2.cli.reference_check path, not a reimplementation of its report.",
        out_of_scope: "Raising any line cap; changing which modules the parse wall refuses; the Wycheproof or juxtaposition walls themselves.",
        handback: "The report naming the refused module first with its omitted count, and the witness over a known-refused fixture module."
      )),
      dispatch: dispatchable(),
      parent: in_project(project: "ci-end-to-end-execution", contribution: "A verdict names the work that produced it: a refusal that names the citers and not the refused module misdirects the reader."),
    ),
    roadmap_node(
      identity: "rn_2K9ZFCX1SFDRND2D0GK9VWQFGJ",
      id: "identity-keyed-rosters-carry-multiplicity",
      owner: "ci-control",
      carriers: concat(carrier(path: "src/v2/compiler/effect_demand.dag"), carrier(path: "src/v2/test/claim/effect_demand/effect_demand_census.dag")),
      line: ticket(t: fields(
        headline: "An identity-keyed roster admits a second offender at the same key",
        boundary: "A waiver, allow-list, grandfather set or known-row roster keyed by identity -- module and declaration, module and operation -- holds one row per key, so a second offender that produces the same key is absorbed by the very set operation meant to record an exception. It is invisible exactly when it matters: the roster still reports its old count, the gate still passes, and the new site is covered by an exception written for a different one. Two sightings, both located. gunb-ai/gunbc pull request 16895 adds exhaustiveness_unknown_allowlist returning HashSet of String in src/v1/stage0/src/cli_run/compile_clean.rs, membership being one structural key line per site, and that same pull request carries the shape this row wants everywhere: a claim comparing per-scrutinee MULTISETs, so a length-equality test that a duplicate slips past fails. That sighting is about the pull request, not main: the symbol has 0 hits in src/v1 at origin/main 61d340d55cce4707c6c5ece828e41c5c0ab5158f and src/v2/workflow/floor_exhaustiveness_allowlist_data_file.dag is MISSING there, git cat-file -e refusing. gunb-ai/gunbc pull request 17016 keys a filesystem-reach verdict as ReachedThroughHandler carrying calling_entry_module and operation, which is the grain effect_demand_census already uses, so two call sites of one operation in one module read as one row; that grain is on main, effect_demand_census 26 hits in src/v2, in src/v2/compiler/effect_demand.dag and src/v2/test/claim/effect_demand/effect_demand_census.dag. A third place where grain decides, measured by this lane at authoring time and NOT this row to fix: src/v2/workflow/floor_grandfathered_roster.dag carries 3,781 rows while the floor routes 659 identities at main, because required_gate_prefixes went from 32 rows including v2.test. to 14 excluding it -- population drift, owned by node floor-ceiling-roster-cut-completeness, identity rn_3PM7CFJ2XQ8VZ5KDR4HB9TNW6L. That nodes file is cited as a measured fact and deliberately not carried by this row: a carrier is where a rows work lands, and naming another nodes file there would put two rows in charge of one file, which is gunbc.design_argument::single_authoritys fork. This row carries the census it changes and the witness file it writes into.",
        displaced_cost: "An exception written for one site silently covers every later site with the same key, and the roster's count -- the number a reviewer reads to judge whether exemptions are shrinking -- stays exactly as correct as it was while doing it. A waiver list grows with nobody deciding to grow it.",
        first_slice: "Finish the two rosters this row already names; build no census instrument. Work the roster that exists on main today: the effect_demand_census key grain carried by ReachedThroughHandler with calling_entry_module and operation, whose census lives in src/v2/compiler/effect_demand.dag and whose witness belongs in src/v2/test/claim/effect_demand/effect_demand_census.dag. Write its duplicate-key witness, red then green. The exhaustiveness_unknown_allowlist of pull request 16895 -- membership being one structural key line per site, in src/v1/stage0/src/cli_run/compile_clean.rs -- is a second sighting that is NOT workable yet and is not promised here: the symbol has 0 hits in src/v1 at origin/main, so a witness against it would have nothing to run against, and its fix location is hand-written seed Rust. It becomes this rows second arm once that pull request lands on main, and if its fix needs seed Rust it stops for an operator ruling rather than growing the seed in passing. Then run ONE bounded git grep for sibling sets or maps built from offenders, waivers, exemptions or known rows, and record each candidate with its file, symbol, key fields, and whether the key carries a site discriminator or a count. That list is a candidate set and says so: gunbc.design_argument::root_generalization holds that a fork list is a candidate set, not a mechanically complete census, and gunbc.design_argument::how_to_work retires census and audit machinery that has no concrete retained consumer. The retained consumer here is the pair of duplicate-key witnesses, so nothing is built to make the list complete and no completeness is claimed. The word counts measured at origin/main 61d340d55cce4707c6c5ece828e41c5c0ab5158f are recorded in the boundary precisely to show why a word count is not a census: roster 14,906 hits under src/v1, src/v2 and dag/gunbc against HashSet of String 130, allowlist 118, grandfather 356, waiver 33 and waived 23, each with its own grep rc and a positive control that fires.",
        red_control: "One witness per unguarded roster that exists on main today. With a single offender the gate admits, as it must. Add a SECOND site producing the same key: the witness must FAIL. Red while the key omits the site, green once the roster keys on the site or counts occurrences -- same witness, same command form, executed on srv1 through heavy-slot, real exit status on its own line, tree sha and porcelain state printed per arm. Renaming a verdict, a step or a key field produces a resolve failure, not a red: the discriminating input is a duplicate key and nothing else.",
        out_of_scope: "Not what population a roster should cover: that is floor-ceiling-roster-cut-completeness, identity rn_3PM7CFJ2XQ8VZ5KDR4HB9TNW6L, and this row neither repeats nor subsumes it. Not declaration cardinality, which is cardinality-optional-declaration. Not the six blocked-lookup scrutinee types that pull request 16895 schedules in order to retire its own allow-list. No census instrument, no audit job and no permanent roster-of-rosters artifact: the consumers this row retains are the duplicate-key witnesses. No hand-written seed Rust: the exhaustiveness allow-list lives in src/v1/stage0/src/cli_run/compile_clean.rs, and a fix that must land there stops and asks the operator for a ruling instead of growing the seed in passing.",
        handback: "For the roster workable on main today, the effect_demand_census grain: the duplicate-offender witness red then green, with both exit statuses on their own lines, both tree shas, and the porcelain state printed per arm. The same witness pair for the exhaustiveness allow-list once pull request 16895 is on main, or a statement that it is blocked on that pull request or on an operator ruling for the seed Rust. The candidate list from the one bounded grep, with its rc, marked as a candidate set claiming no completeness, and for each candidate one disposition -- already guarded, unguarded and fixed here, or deferred with its reason. The key fields of each roster before and after, so a later reader can see what the guard protects. And a plain statement of any roster left unguarded because its fix needs hand-written seed Rust and therefore stopped for an operator ruling."
      )),
      dispatch: dispatchable(),
      parent: in_project(project: "ci-end-to-end-execution", contribution: "A roster or waiver keyed by identity records one exception per key, so a new offender is decided on its merits rather than absorbed by a set operation"),
    ),
