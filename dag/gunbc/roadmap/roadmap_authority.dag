    roadmap_node(
      identity: "rn_2KZ8Q3XW7VJ5N9DRMYH6TC4BP1",
      id: "srv4-staging-artifact-ownership",
      owner: "fleet",
      carriers: carrier(path: "dag/gunbc/fleet/site_pxe_edge_converge.dag"),
      line: ticket(t: updated(t: fields(
        headline: "The srv4 staging ownership split: hand-placed edge artifacts become modeled rows",
        displaced_cost: "srv4 runs a boot edge whose artifacts were placed by hand. Nothing converges them, nothing witnesses them, and the fleet's own reading of the edge cannot say whether it is real.",
        boundary: "Settle and model who owns srv4's staged artifacts, and move them from hand-placed files into the rows that converge them. The split is being negotiated with still-fox-404, who owns the srv4 edge itself.",
        first_slice: "Agree the split with still-fox-404 and land the modeling half: the staged artifacts named as rows with owners, so the next change is a merge and not a hand.",
        red_control: "An artifact claimed as staged and converged while no row models it is refused; the same artifact passes once its row exists.",
        out_of_scope: "The Apply that puts them on srv4 (its own operator gate row); the user-data drift and the SitePxeEdgeLiveSource row, each of which is its own row here.",
        handback: "A staging ownership split stated in the model, with the artifacts' owners named."
      ), on: "2026-11-20", note: "Correction to the hand-down: the brief named a staging ownership PR as in flight. Live read 2026-11-20 found no such pull request open on gunb-ai/gunbc -- none by head-ref or author under still-fox-404 -- so what exists today is the negotiation with still-fox-404 plus this row. What is verifiable in the repository instead: the edge's desired-file set is modeled at dag/gunbc/fleet/site_pxe_edge_converge.dag (site_pxe_edge_desired_files, fed from site_pxe_edge_desired_inputs at :3020 and :3052), and its live-source roster is empty at :1757 -- the modeled half of the split has nowhere to land until this row's agreement holds.")),
      dispatch: dispatchable(),
      parent: in_project(project: "site-boot-and-management-edge", contribution: "The boot edge's artifacts as modeled state, so the edge is converged and witnessed like every other fleet authority."),
      centering: plan(text: "new_server_bringup_plan: srv4 is the site's boot edge, and a boot edge with hand-placed artifacts is not yet an authority. Target: dag/gunbc/fleet/site_pxe_edge_converge.dag and the desired-file set its roster feeds."),
    ),
    roadmap_node(
      identity: "rn_9XKQ4VZ2T7MH6NDYRCW8JB3FP5",
      id: "srv4-install-client-user-data-drift",
      owner: "fleet",
      carriers: carrier(path: "dag/gunbc/fleet/site_pxe_edge_converge.dag"),
      line: ticket(t: updated(t: fields(
        headline: "srv4's served install user-data for bobo's client 9c:6b:00:e7:ca:63 is modeled drift",
        displaced_cost: "The install client's MAC is modeled as an observation, but what srv4 actually serves that client as user-data is known only by reading the host. Unmodeled, a stale entry means an install that silently PXE-boots and seeds the wrong target.",
        boundary: "Model srv4's per-client install user-data for 9c:6b:00:e7:ca:63 as the drift it is -- the served document as a row that can disagree with the model -- so the client entry converges and a mismatch refuses instead of seeding a stranger.",
        first_slice: "Model the served install-user-data document for that client as a row with its MAC and its seed digest, and let the drift gate report it against what srv4 actually serves.",
        red_control: "A client entry whose MAC does not match the observed binding refuses, and the observed binding passes.",
        out_of_scope: "Applying it to srv4 (the operator's Apply gate row); the SitePxeEdgeLiveSource roster row; anything on the floor.",
        handback: "The install client and its served document in the model, with drift reported rather than discovered at install time."
      ), on: "2026-11-20", note: "Verified 2026-11-20: the MAC is modeled as an observation at gunbc.machine_intake.srv15_host_nic_observation (imported by dag/gunbc/fleet/site_pxe_edge_converge.dag:114 and dag/gunbc/machine_intake/inband_host_identity.dag:8), and it is the netboot I210 of the board srv13 and srv15 both named (serial BR80S6102300049, dag/gunbc/fleet/fleet_host_identity.dag:81). The literal string itself appears in no production row -- only in witness fixtures (dag/test/claim/host/network_install_witness.dag:262, dag/test/claim/machine_intake/arrival_bmc_witness.dag:273). The served document today exists only as a render keyed off the roster: site_pxe_edge_converge.dag:1336 renders the install-user-data file for site_pxe_edge_client_mac, and :1093-1132 renders one request's seed through admit_public_nocloud_seed -- and the roster it keys off is empty.")),
      dispatch: dispatchable(),
      parent: in_project(project: "site-boot-and-management-edge", contribution: "The edge's per-client install state, converged and drift-checked like the rest of the fleet record."),
      centering: plan(text: "new_server_bringup_plan: the install path is only safe if the client the edge serves and the document it serves are modeled, not remembered. Target: dag/gunbc/fleet/site_pxe_edge_converge.dag and the install-user-data file it renders per client."),
    ),
    roadmap_node(
      identity: "rn_5TRQ8ZKD2VX7N4JY6WHM9BC3FP",
      id: "srv4-site-pxe-edge-live-source-row",
      owner: "fleet",
      carriers: carrier(path: "dag/gunbc/fleet/site_pxe_edge_converge.dag"),
      line: ticket(t: updated(t: fields(
        headline: "The SitePxeEdgeLiveSource rows that let srv4's edge be read as live",
        displaced_cost: "site_pxe_edge_live_sources is an empty roster, so the edge has no live source at all: the client-MAC frontier stays withheld, the edge's liveness is asserted rather than read, and the install path the roster feeds cannot be graded.",
        boundary: "Give the edge its live-source rows -- read from srv4, not typed -- so the roster is non-empty and the frontier that waits on it can dissolve. The read is the repository's act; the Apply that made the live state is the operator's.",
        first_slice: "One SitePxeEdgeLiveSource row read from srv4, with the client MAC its dnsmasq observed, and the withheld site_pxe_edge_live_client_mac_frontier dissolving against it.",
        red_control: "A live-source row whose client MAC was not observed by the edge refuses; the empty roster keeps the frontier withheld today, which is the control's positive case.",
        out_of_scope: "Any live change on srv4 -- reading is allowed, applying and restarting are not. Those need the operator's Apply GO, its own gate row.",
        handback: "An edge with a read live source, and the frontier that waited on it dissolved."
      ), on: "2026-11-20", note: "Verified 2026-11-20: data site_pxe_edge_live_sources is [] at dag/gunbc/fleet/site_pxe_edge_converge.dag:1757, and site_pxe_edge_live_client_mac_frontier is withheld_at that roster (:1773), its trigger read verbatim -- srv4's dnsmasq having observed the MAC the data NIC sends in a PXE request, read back from the edge, after which one SitePxeEdgeLiveSource lands. Two sibling frontiers wait on the same roster for orphan collection and partial placement. The row's client MAC is the one this program's user-data row models, and the roster's first row is the one the plan's acceptance bar reads.")),
      dispatch: dispatchable(),
      parent: in_project(project: "site-boot-and-management-edge", contribution: "The census sees the boot edge: srv4's edge is a counted live source, not an unmodeled dependency."),
      centering: plan(text: "new_server_bringup_plan: the edge is only demonstrated once it can be read as live, which needs the roster the withheld frontier waits on. Target: dag/gunbc/fleet/site_pxe_edge_converge.dag, its empty site_pxe_edge_live_sources roster and the client-MAC frontier withheld at it."),
    ),
    roadmap_node(
      identity: "rn_6ZKD9QXW4VJT2N8RYH7MCB3FP5",
      id: "operator-boot-or-reset-go",
      owner: "operator",
      carriers: carrier(path: "dag/gunbc/auth/privileged_effect_registry.dag"),
      line: ticket(t: updated(t: fields(
        headline: "DECISION GATE: every reset and boot outside the admitted boot modes needs the operator's GO",
        displaced_cost: "Either a machine resets without the operator deciding it may, or the lane stalls forever because nobody named who says GO. Both are expensive; the second is cheap to avoid.",
        boundary: "One row that says plainly what the authority already holds: the fleet-converge mtcollins1_boot and host_reset_return modes run from main under their workload identity with no per-run or standing approval, provided each run takes the unit's maintenance hold -- while a cold reset outside those modes is approved per occasion, and exactly one has ever been given. Rows that dispatch a boot or a reset outside the admitted modes wait here.",
        first_slice: "State the standing rule and its boundary on this row, and make every boot- or reset-dispatching row in the program name it as a prerequisite.",
        red_control: "A boot or reset dispatch outside the admitted modes whose GO is absent refuses; the same dispatch passes once the GO is recorded for that occasion.",
        out_of_scope: "Giving the GO; issuing it on the operator's behalf; widening or narrowing which actions need one -- the boundary is the registry's, not this row's.",
        handback: "A legible rule: boots and resets inside the admitted modes run on the hold, anything else carries an operator GO, and a row that lacks one is visibly waiting."
      ), on: "2026-11-20", note: "Named as a decision-gate row at the operator's instruction. The two authorities it records are both on main: the standing no-approval ruling for the admitted modes at dag/gunbc/auth/privileged_effect_registry.dag:408 (operator chat rulings 2026-09-23 and 2026-09-25, quoted again at dag/gunbc/machine_intake/mtcollins1_boot_run.dag:3419), and the single approved cold reset at :553, which says on its face that a second dispatch has no approval behind it and needs a new operator go.")),
      parent: in_project(project: "site-boot-and-management-edge", contribution: "The operator's hold over destructive boot actions, recorded so no row can quietly skip it."),
    ),
    roadmap_node(
      identity: "rn_3WZK5VQD8XJT4N2RYH6MCB7FP9",
      id: "operator-mtcollins1-per-host-trust-policy",
      owner: "operator",
      carriers: carrier(path: "dag/gunbc/auth/authorization_pattern_selection.dag"),
      line: ticket(t: updated(t: fields(
        headline: "DECISION GATE: the per-host trust policy for mtcollins1's remaining duties",
        displaced_cost: "Two lanes wait on it and neither can move: butch's route past the executor-only cap, and mtcollins1's dispatch/collect/deregister leg. Without it the model cannot say what mtcollins1 may be trusted to do.",
        boundary: "The operator states, per host, what is trusted -- which actions may run without a per-run approval and which never may. The repository's half is to consume that statement at gunbc.auth.authorization_pattern_selection; the statement itself is the operator's.",
        first_slice: "The operator's per-host trust statement for mtcollins1, recorded and consumed by the authorization-pattern fold.",
        red_control: "A pattern selected for a host whose trust statement does not authorize it refuses by name.",
        out_of_scope: "Choosing the policy; any agent-side change to a trust statement; hosts outside this program.",
        handback: "A per-host trust policy the authorization fold can be checked against, with the two waiting lanes unblocked by name."
      ), on: "2026-11-20", note: "Recorded because the hand-down lists it as operator-held and two rows (butch-executor-route-under-the-ci-ruling and mtcollins1-runner-dispatch-collect-deregister) wait on it. Related but distinct, and already settled: the standing ruling at dag/gunbc/auth/privileged_effect_registry.dag:408 covers the BOOT (the admitted mtcollins1_boot and host_reset_return modes need no per-run approval); it does not speak to the runner duties this policy governs, which is why this row is still open.")),
      parent: in_project(project: "site-boot-and-management-edge", contribution: "The operator's trust decisions, kept as a row so the model's authority selections have a named source."),
    ),
    roadmap_node(
      identity: "rn_8XKD5QZJ2VT7N4WHY6RCMB3FP9",
      id: "operator-mtcollins1-runner-group-qualification-go",
      owner: "operator",
      carriers: carrier(path: "dag/gunbc/host/memory_envelope.dag"),
      line: ticket(t: updated(t: fields(
        headline: "DECISION GATE: the operator's GO on mtcollins1's runner group and its qualification",
        displaced_cost: "mtcollins1's first qualification run cannot be charged to a runner group that has not been agreed, so the qualification leg -- and with it the retirement of mtcollins1's boot duties -- waits indefinitely on an unstated decision.",
        boundary: "The operator names the runner group mtcollins1's work is qualified under and gives the GO for the qualification run itself. The memory envelope and the receipt are this program's modeling; the group and the GO are not.",
        first_slice: "The named runner group plus the GO for one qualification run, recorded here so the qualification row can cite it.",
        red_control: "A qualification receipt naming no group, or claiming a run with no GO recorded, refuses.",
        out_of_scope: "Naming the group or giving the GO; running the qualification; the memory-envelope modeling, which is its own row.",
        handback: "A runner group and a GO that the qualification row can be charged against."
      ), on: "2026-11-20", note: "Operator-held per the hand-down; recorded so mtcollins1-first-qualification-run has a named blocker rather than a vague one.")),
      parent: in_project(project: "site-boot-and-management-edge", contribution: "The operator's charge decisions over mtcollins1's runner work, held to the same accountability as every other charge."),
