      owner: "debt",
      carriers: carrier(path: "dag/gunbc/non_fold_residue.dag"),
      line: ticket(t: level_fields(
          headline: "DP-M4: closed matches are total",
          boundary: "gunbc.non_fold_residue non_fold_residue_frontier (about 186 rows on this tree) down to at most 100, draining the nfr_reason_mint_era rows first (82). The six seed-Rust wildcard sites are out of scope.",
