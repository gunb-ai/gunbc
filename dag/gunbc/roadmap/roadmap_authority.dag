    roadmap_node(
      identity: "rn_4XK7P2WQ9BNF6RTH3VJD8MCZ5L",
      id: "gate-refusal-reason-survives-wrapper",
      owner: "shell",
      carriers: carrier(path: "docs/plans/shell-to-dag-residual-census-and-arc-completion.md"),
      line: ticket(t: updated(t: fields(
        headline: "A gate's typed refusal reason survives the wrapper that reports it",
        boundary: "A wrapper that reports whether a gate passed carries the gate's reason with it. Collapsing a typed outcome to yes-or-no at the wrapper boundary is the defect, wherever the wrapper lives.",
        displaced_cost: "The gate already produces the reason and the wrapper discards it, so a consumer asking WHY a gate refused has to go back to the logs, and a ledger built on the wrapper cannot tell a subject refusal from an infrastructure failure. gunbc#11342 addresses exactly this shape one layer down -- an ExitFailure that collapses into a fabricated not-executed row -- and leaves the wrapper boundary standing.",
        first_slice: "emit_host_gate_passes reduces exit_ok(...) to a Bool; dissolve that collapse so the typed outcome std.process already carries reaches the gate's wrapper consumers. gunbc.instruments.emit_host_gate emit_host_verdict_narration_scaffold shells out a per-smoke verdict line ONLY because this wrapper discards ProcessExit.reason, and its dissolve-on fires when the claim path carries typed refusal reasons to the executor surface -- which gunbc#11342 does, and that PR deletes the scaffold and its trigger together. Either way this row's subject is untouched: the narration is the compensation, the wrapper collapse is the cause, and dissolving the compensation removes the marker without removing the collapse. That is why the collapse needs a home that does not depend on the marker surviving.",
        red_control: "A wrapper that reduces a typed outcome to a Bool is flagged, and a consumer asserting on the reason goes red when the collapse is reintroduced.",
        out_of_scope: "The accounting of hand-written shell sites, which is shell-residue-zero's subject; this row is about the typed outcome, not the shell that produced it.",
        handback: "No wrapper in the gate surface reduces a typed outcome to a Bool, with a consumer reading the reason green by execution. The handback is the collapse itself rather than a dissolution receipt, because the narration that compensated for it is retired by the same capability under gunbc.design_argument::guarantee_ladder (dissolution on climb) and cannot stand as evidence that the cause was addressed."
      ), on: "2026-09-30", note: "Not yet centered: needs a centering plan: no plan has been authored for this instance of bool_projection_over_a_typed_carrier.")),
      dispatch: dispatchable(),
      parent: in_project(project: "shell-typed-invocation", contribution: "Keeping the typed ProcessExit through the gate wrapper deletes the shell-out verdict narration that exists only because the wrapper collapses it to a Bool."),
    ),



    roadmap_node(
      identity: "rn_WWVQ07RC0HF55DPM2CXNKWY8RR",
      id: "fleet-state-frontier",
      owner: "fleet",
      carriers: carrier(path: "dag/gunbc/host/host_converge.dag"),
      line: ticket(t: fields(
        headline: "Write down which parts of our machines we actually manage",
        boundary: "Every file, service, credential, and device is either derived by us, owned by us, or someone else's with an agreed contract. Anything unclassified refuses.",
        displaced_cost: "Shrinks the number of possible machine states our automation has to cope with.",
        first_slice: "Classify one complete machine-touching workflow.",
        red_control: "An undeclared file, service, credential, or device refuses before anything is changed.",
        out_of_scope: "No inventory of everything on the machine for its own sake.",
        handback: "The classification plus one refusal on something unclassified."
      )),
      dispatch: dispatchable(),
      parent: in_project(project: "fabric-application-authority", contribution: "The application authority admits only machines whose every file, service, credential and device is classified; an unclassified artifact refusing before any change is its intake wall."),
      centering: plan(text: "Classify one complete machine-touching workflow. The classification names every file, service, credential and device the workflow touches as derived-by-us, owned-by-us, or someone-else's-with-a-contract; anything unclassified refuses before any change is attempted. The refusal is the handback alongside the classification."),
      execution: bound(contract: gunbc_claim_execution_contract(
        entry: "dag/test/claim/closing/fleet_state_frontier_closing_contract_witness_test.dag" as FilePath,
        function: "an_undeclared_artifact_refuses_before_anything_is_changed" as NonEmptyStr,
      )),
    ),

    roadmap_node(
      identity: "rn_G2BR1NCSAD24KP0TA14TA89PMV",
      id: "serving-liveness-route-withdrawal",
      owner: "fleet",
      carriers: carrier(path: "dag/gunbc/serving/serving_availability.dag"),
      line: ticket(t: updated(t: fields(
        headline: "A serving route that has stopped serving stops being routable, and the seats held against it are freed",
        boundary: "Whether a route can take new work is one reading, bound to the endpoint process that answered it, and every consumer projects from that reading rather than deciding separately. The reading covers three ways a route stops serving: the front door does not answer inside a bounded deadline; the endpoint process was replaced between observations; and the engine core is no longer advancing while requests are admitted. Seats and grants held against a launch that is gone become unusable rather than waiting out their term.",
        displaced_cost: "Group A was dark for 43 hours in September 2026 and nothing in the repository could say so: the health probes had no deadline, so a wedged engine held the roster gate, dispatch selection and placement open with no refusal, and one harness POST was held open for over thirty minutes against a backend that would never answer. A stalled engine still answers its front door, so the route stayed offerable throughout.",
        first_slice: "Cut 1 (merged): bounded probes with a caller-owned deadline, one sealed front-door availability verdict bracketed by two endpoint-process readings, endpoint-process continuity as its own sealed verdict for the seat fence, and model admission kept separate from availability. Cut 2: the engine-progress reading — the generation counter compared as exported text under one exporter, beside the running gauge, over an interval longer than a declared step bound — withholding a route only on an established stall. Cut 3: seats held against a replaced or stalled launch invalidated rather than held to term.",
        red_control: "An idle engine is not a stalled one: a motionless counter with nothing running is healthy however long it stands still, and calling it a stall evicts a working route. An interval shorter than one uninterruptible step establishes nothing and must read unread rather than stall. A restarted exporter resets its counters, so stillness or an apparent decrease across a replacement is unread. An unread progress reading is never a wall. A progress reading does not establish that the engine core behind the exporter is the same core, which remains the declared exporter-grain rung drop.",
        out_of_scope: "Cut 1 does not bound a POST already in flight, and a successful preflight read cannot: the request deadline belongs to the workload. Detecting a stall inside a running turn, which needs the endpoint on the turn configuration, is a later slice. Nothing here identifies the engine-core incarnation behind the exporter.",
        handback: "A route that does not answer, whose exporter was replaced, or whose engine has stopped advancing is refused as a placement candidate with a typed located reason and a countable refusal; seats held against a launch that is gone are released; and each refusal has a discriminating control that goes red when the rule is removed."
      ), on: "2026-09-30", note: "Not yet centered: needs a centering plan: Cut 2 (the engine-progress reading in gunbc.serving.serving_availability) has no plan yet.")),
      dispatch: dispatchable(),
      parent: in_project(project: "vm-service", contribution: "Work must not be routed to an inference endpoint that stopped serving; one bounded liveness reading withdraws the route and frees its seats."),
    ),




    roadmap_node(
      identity: "rn_ZXQH9CD43E8XH64CHYBT99WD9W",
      id: "discarded-bool-result-wall",
      owner: "language-integrity",
      carriers: carrier(path: "dag/gunbc/design_document.dag"),
      line: ticket(t: updated(t: fields(
        headline: "Produced values have a consumer or an explicit discard; authored named bindings have a resolved use",
        boundary: "Serves the operator decision of 2026-11-23 on value disposition and named-binding use. The decision is recorded as gunbc.design_ruling::value_disposition_and_named_binding_use_are_explicit_2026_11_23. A value-producing expression must be consumed, returned to an enclosing consumer, or explicitly discarded with the existing let _ = expr spelling; Bool and calls have no exemption. An authored named let, parameter (including lambda parameters), pattern-field or caught-value binding has a resolved use or is spelled _; caller-visible argument and field identity remain distinct from the local binder. Determine use by binding identity, not identifier text; no every-path or linear-use rule is silently added. No-result operations need no result acknowledgement, while a final block value transfers its disposition to the surrounding context. Explicit discard records intent, not success, authorization or discharge of another obligation, and must preserve the computation's declared effects, failure behavior and ordering. Judge the authored distinction before lowering or optimization erases it. Existing v2 refusals in v2.compiler.body_lowering_fold::body_lower_stmt_spine and the earlier gunbc.design_ruling::unread_catch_all_binder_refuses are preserved; v2.compiler.body_lowering_fold::body_lower_else_less_if_statement is a separately inspected discard path, not evidence that v2 drops every statement value. v1 implements the same chosen language contract under its existing maintenance standing.",
        displaced_cost: "A bare result can read like an enforced claim while nothing consumes it, and a named binding can suggest a dependency that does not exist. The operator's stated reason is that the code should match the actual intention. Acknowledging every existing site mechanically would preserve mistakes as intentional-looking code, so each affected site either uses, propagates, returns, deliberately discards or removes the computation under its contract.",
        first_slice: "Use bounded source inspection and focused fixtures to record the current v1 and v2 behavior by actual return type and binding kind: dropped call and non-call values, fall-through else-less if results, unread let/parameter/pattern/caught bindings, and existing explicit discards. A parse-only pass reports candidates and unresolved classification, never a complete semantic count; scope the measurement to the migration decision it serves. The fixture matrix separates already-refused cases from newly prohibited accepted cases. Resolve no-result versus ordinary unit behavior, named argument label versus local binding, nested block results and source-authored versus generated bindings in the owning language model before implementation. Reuse existing checks where they express the same rule. The observed affected population informs a direct cut or an explicitly admitted bounded migration, not an automatic exemption roster.",
        red_control: "On each in-scope production acceptance path, a newly prohibited implicit discard or unread binding is refused with a typed located cause; a case already refused at main remains refused rather than being required to show an impossible accepted baseline. Include dropped call/non-call and else-less-if values, unread let/parameter/pattern/caught bindings, and a nested block whose resulting value is silently dropped outside it. Positive controls retain let _ = expr, a genuine no-result statement, a resolved read, and a tail value consumed by its enclosing context; a same-spelled unrelated binding is not a read of the tested binder. An explicit discard of an effectful operation preserves its declared activation and failure/ordering contract. Where an existing contract requires admission evidence, explicit discard must not weaken that contract; adding a general effect-admission analysis is outside this node. Preserve the narrower unread-catch-all and juxtaposed-bare-value regression controls.",
        out_of_scope: "Adding bare _ = expr grammar, requiring every binding to be used on every runtime path, proving that every syntactic use changes the output, mechanical insertion of _ to conceal a missing consumer, a permanent repository-wide audit instrument, and motion/capability/browser work.",
        handback: "The exact contract and owning implementation sites; the bounded inspection population with unknowns; the before/after matrix for v1 and v2, retaining existing refusals and positive controls; executed receipts on the real changed acceptance paths; and any necessary admitted migration population with its capability-based dissolution trigger. Rung and node acceptance follow the executed evidence at the revision containing these criteria."
      ), on: "2026-11-23", note: "Supersedes the Boolean-only criterion while preserving node identity. The operator decision of 2026-11-23 is recorded as gunbc.design_ruling::value_disposition_and_named_binding_use_are_explicit_2026_11_23. This criteria rewrite establishes no implementation or acceptance; earlier receipts must be assessed against the live criteria digest.")),
      dispatch: dispatchable(),
      parent: in_project(project: "compiler-guarantee", contribution: "The language preserves expressed value disposition and binding use; an implicit discard or unread authored name is refused."),
    ),
    roadmap_node(
      identity: "rn_GUNBCROOT0PROJECT0FACTORY0A",
      id: "gunbc-project-root",
      owner: "program",
      carriers: carrier(path: "dag/gunbc/design_document.dag"),
      line: ticket(t: level_fields(
          headline: "Build the self-hosting, proof-carrying LLM software factory",
          boundary: "The admitted root of the functional decomposition: every node reaches this one through the parent its row declares, each member edge carrying why the child's work advances its parent. DESIGN.md is the principles authority orthogonal to this hierarchy, not a level of it.",
          approach: "Four member projects carry the work: v2-compiler-live (the self-hosted compiler goes live), fabric-bringup (our own fleet brought up as a fabric, with the end-of-year VM service and fabric storage under it), debt-payoff (known gaps and recurring failure modes retired against their triggers) and factory (the machine that lands and verifies work).",
          red_control: "A node whose parent walk ends anywhere but this root refuses its alignment resolution and every dispatch surface; this node is the only AdmittedRoot.",
          displaced_cost: "Without a declared root, a projectless task reads as its own justification and drift has no chain to be measured against.",
          handback: "The rooted hierarchy, the walk's refusal of unrooted chains, and the receipts binding both."
        )),
      parent: admitted_root(),
    ),
    roadmap_node(
      identity: "rn_FABRIC0BRINGUP0PROGRAM0A",
      id: "fabric-bringup",
      owner: "fleet",
      carriers: carrier(path: "dag/product/fabric/selection.dag"),
      line: ticket(t: level_fields(
          headline: "Fabric bring-up: our own fleet, its storage and the VM service on it, each observed rather than assumed",
          boundary: "Container for the fabric (operator ruling 2026-10-03: the VM service and fabric storage are both members of the fabric bring-up). Allocation, placement and serving follow the fabric/compute conformance domain (gunbc.design_argument::conformance); storage follows the materialization/realization domain. Host bring-up itself stays operator-driven.",
          approach: "Two member projects: vm-service (the end-of-year VM service) and fabric-storage (internal fabric state, a workload's checkpointed workspace, and customer-provided storage). The private year-end plan carries the dates; this node carries the decomposition.",
          red_control: "A member whose parent walk does not reach this node through vm-service or fabric-storage is not a fabric row.",
          displaced_cost: "With the VM service as a top-level project and storage parentless, the largest fabric risk had no place on the public roadmap and the service read as independent of the fabric it runs on.",
          handback: "Per member project: its acceptance receipts, named by their instruments."
        )),
      parent: in_project(project: "gunbc-project-root", contribution: "The fabric is what the VM service and the factory both run on; bringing our own fleet up as an observed fabric is the precondition for selling compute on it."),
    ),
    roadmap_node(
      identity: "rn_FABRIC0STORAGE0PROGRAM0A",
      id: "fabric-storage",
      owner: "fleet",
      carriers: carrier(path: "dag/std/artifact_store.dag"),
      line: ticket(t: level_fields(
          headline: "Fabric storage: internal fabric state, checkpointed workspaces and customer-provided storage",
          boundary: "DRAFT (operator ruling 2026-10-02, \"we can make a fabric parent - it's ongoing work for a while\"): a standing program, not one narrow proof. Members are the storage rows of the private year-end plan as they move onto this tree.",
          approach: "DRAFT: members join as the private StorageFabric rows are projected onto the public tree.",
          red_control: "Not ready: this program carries no dispatch facts and has no members yet.",
          displaced_cost: "Storage was the largest fabric risk with no public parent, so none of its promises could be ordered or seen beside the VM service.",
          handback: "DRAFT: per member, its acceptance receipt."
        )),
      parent: in_project(project: "fabric-bringup", contribution: "The fabric's state, checkpointed workspaces and customer storage are what make a VM service recoverable rather than volatile."),
    ),
    roadmap_node(
      identity: "rn_FABRIC0DEMAND0OBJECTIVE0A",
      id: "fabric-demand-objective",
      owner: "fleet",
      carriers: carrier(path: "dag/product/fabric/demand.dag"),
      line: ticket(t: fields(
        headline: "The demand's own objective decides every resource choice made for it, and switching that objective changes the choices",
        boundary: "A demand states once what it values: accepted work, cost, delay and interruption, each with its valuation, under hard spending limits. Every resource choice made for that demand reads this one statement: acquire or release supply, place, wait or move, keep or evict KV, batch or serve now, recover. No layer may put a local preference in its place (warm caches, even session counts, fast responses, bids that keep winning). Choices that affect each other, by sharing budget, memory or GPU throughput, are selected together as one std.decision subject. Choices that do not are carried out independently. Per gunbc.design_argument::selection_precedes_convergence, a repeating loop selects with std.decision under the demand's objective, carries the choice out per resource, observes the result, and selects again.",
        displaced_cost: "Today BuyTerms carries no delay or interruption valuation (product.fabric.demand records why it is absent: no carrier at the time). gunbc.serving.turn_admission fills the gap with one placeholder serving_delay_valuation for all work. So the operator has to restate, decision by decision, that debt-payoff work values latency and interruption at zero, and suggestions like keeping a spare or moving a session because it waited a few minutes slip in a preference that work never had.",
        first_slice: "Add a delay valuation (MoneyPerSecond, which std.measure now has) and an interruption stance (product.fabric.work revocation acceptance, from flex M0) to the demand's terms. Supply selection and serving admission read them, and the placeholder serving_delay_valuation is deleted. One choice uses them end to end: when admission is blocked, wait for the current replica or move elsewhere, priced with real supplier cost and an explicit reconstruction estimate.",
        red_control: "The policy switch. With the work and supply held fixed, two cases where the options genuinely trade off: (1) debt-payoff waits and latency-sensitive pays to move; (2) debt-payoff also moves, because moving raises accepted work per dollar. In both, the spending limits refuse an over-cap move for either profile. RED: a selector that ignores the demand's valuation picks the same option for both profiles in case 1. A third case where one option is both cheaper and faster must give the same answer under both profiles, so the test cannot pass just by flipping every answer.",
        out_of_scope: "KV transfer and spill, until an engine supports them; they then join the candidate set with no change to this model. Searching for an optimal operating point over the whole fleet. Learning the valuations: they are declared authority, and only consequence estimates such as interruption rate or reconstruction cost are observed and updated.",
        handback: "The objective carried on the demand, its consumers in selection and admission, the placeholder deleted, and the three-case policy-switch receipt."
      )),
      parent: in_project(project: "fabric-bringup", contribution: "Fabric decisions follow the declared objective of the work they serve, so one fabric serves both cost-sensitive batch work and latency-sensitive work without being re-tuned for each."),
    ),
    roadmap_node(
      identity: "rn_FABRIC0CONSEQUENCE0STAND0A",
      id: "fabric-consequence-standing",
      owner: "fleet",
      carriers: carrier(path: "dag/std/decision.dag"),
      line: ticket(t: fields(
        headline: "Every option carries a standing for every consequence its decision requires, and an unknown never becomes zero",
        boundary: "A decision subject declares the consequence dimensions it requires (supplier spend, accepted work, setup and reconstruction, outstanding liability, and later others). Every candidate carries exactly one disposition per required dimension: observed, estimated (with its conditioning facts and model version), conservatively bounded, proven irrelevant to this candidate, or unestablished. Unestablished asks for evidence or refuses the candidate; it is never read as zero. Keeping a running card is NoSetupRequired; renting one carries an estimated or bounded setup; moving work carries reconstruction. The disposition reuses std.decision axis readings and extdeps.external_authority CitedFigureStanding rather than a new evidence vocabulary.",
        displaced_cost: "Setup, interruption and reconstruction overhead are real but not fixed, and today they enter a comparison only when the author remembers them. A missing one silently counts as free, which is how a cheaper card looks better than it is and how a migration looks costless.",
        first_slice: "Add the required-dimension declaration and the per-candidate disposition, and make the flex wait-versus-move decision (fabric-demand-objective) consume it for setup and reconstruction.",
        red_control: "A candidate with no setup disposition refuses or needs evidence and is never selected as if setup were free; RED is the current path, which treats an absent setup as zero. A bounded setup admits against the cap only through its bound. An irrelevant disposition leaves the decision unchanged.",
        out_of_scope: "How the estimates are produced (fabric-scenario-evaluation). New valuation semantics (fabric-demand-objective).",
        handback: "The disposition carrier, its consumer in the wait-versus-move decision, and the missing, bounded and irrelevant controls."
      )),
      parent: in_project(project: "fabric-bringup", contribution: "Fabric decisions stop treating unmodelled overhead as free, so cheap and expensive supply are compared on what they actually cost."),
    ),
    roadmap_node(
      identity: "rn_FABRIC0DIMENSION0EXTEND0A",
      id: "fabric-dimension-extension-law",
      owner: "fleet",
      carriers: carrier(path: "dag/std/decision.dag"),
      line: ticket(t: fields(
        headline: "Adding a dimension to a decision changes it only through the shared evaluation, and leaves it unchanged where the dimension is irrelevant",
        boundary: "A new dimension (urgency, cache state, market response, failure domain) enters a decision as a required consequence, a constraint or a valuation of the existing decision subject. It never enters as a new controller or an unconditional rule beside selection. Every extension ships with two executed controls through the real consuming decision path: a case it must change, and a case it must preserve.",
        displaced_cost: "Each new concern has historically arrived as its own rule (keep running cards, equalise sessions, raise after losing) that competes with the selector. Thirty dimensions become thirty controllers whose combined decisions waste money while each one looks correct.",
        first_slice: "State the law as a witness pattern and apply it to the first added dimension after fabric-consequence-standing: reconstruction cost changes a move decision in one case and leaves an unrelated decision byte-identical in another.",
        red_control: "An extension implemented as a side rule (an unconditional keep-incumbent beside selection) passes its own change case but fails the preserve case, or changes decisions where its dimension is irrelevant. The control must go red on that implementation.",
        out_of_scope: "Choosing which dimensions to add. Monte Carlo estimation.",
        handback: "The witness pattern, its first application, and the side-rule RED."
      )),
      parent: in_project(project: "fabric-bringup", contribution: "The fabric can absorb new dimensions without each one becoming a competing controller."),
    ),
    roadmap_node(
      identity: "rn_FABRIC0SCENARIO0EVALUATE0A",
      id: "fabric-scenario-evaluation",
      owner: "fleet",
      carriers: carrier(path: "dag/std/decision.dag"),
      line: ticket(t: fields(
        headline: "Uncertain consequences are estimated over seeded joint scenarios, and a new model revision must do no worse than the old one under the same decision authority",
        boundary: "A scenario is one coherent possible world: market floors, setup duration and charges, lifetime, throughput, demand arrivals, interruptions, release completion. Coupled facts (cheap cards with slower setup and more interruptions) are drawn together, never as independent axes. Each candidate produces one distribution per outcome dimension; nothing is summed during simulation, and the selector still applies constraints, Pareto and the demand policy. Evaluation keeps a seeded corpus of historical traces and synthetic sweeps, and compares an old and a new MODEL OR IMPLEMENTATION revision on identical seeds while holding the decision authority fixed: decision subject, objective and valuations, hard constraints, candidate-field authority, horizon and outcome interpretation. A changed demand objective is a different decision judged under its own authority, never a regression against another. Gates: no added budget or correctness violation, no dominated choice, the preservation control owned by fabric-dimension-extension-law, and regret no worse than the old revision beyond a declared threshold. This runner is the implementation that law's preservation control consumes.",
        displaced_cost: "Bidder and balancer changes are judged by anecdote after deployment; the ownership-limit and failed-release overspends were found by hand-built repros after merge. A policy change has no pre-merge evidence that it makes fewer costly mistakes across plausible markets.",
        first_slice: "A deterministic seeded scenario runner for the flex keep, release, rent, release-then-rent and wait candidates over the four first dimensions, plus one paired old-versus-new comparison on a small fixed corpus.",
        red_control: "Structural failures, not profitability claims: (a) a revision whose only response to a loss is a higher bid with no declared update law crosses the budget or ceiling invariant in a named scenario; (b) a revision in which changing ONLY prior ownership changes the selection among otherwise equivalent present offers is refused. The same seed always gives the same outcome vectors; an independent-axis sampler is refused where a coupling is declared; comparing two different objectives under one regret is refused.",
        out_of_scope: "Learning market response. Random sampling in the required CI path: the corpus is seeded and deterministic.",
        handback: "The runner, the seeded corpus, the paired gate, and the two historical-defect REDs."
      )),
      parent: in_project(project: "fabric-bringup", contribution: "Fabric policy changes carry pre-merge evidence that they make fewer costly mistakes, rather than being judged after deployment."),
    ),
    roadmap_node(
      identity: "rn_FABRIC0CI0FAILOVER0SELECT0A",
      id: "fabric-customer-ci-failover",
      owner: "fleet",
      carriers: carrier(path: "dag/gunbc/ci/ci_runner_target.dag"),
      line: ticket(t: fields(
        headline: "Customer CI failover, balancing, cloud burst and return-to-owned-capacity are one policy-bound allocation over uncertain supply",
        boundary: "Customer CI hosting onboards to the shared decision interface (conformance-decision) as a named consumer. Demand is a job or job DAG with the customer's declared objective; supply is owned bare metal plus stable cloud (OCI, AWS, GCP), each described by observed facts (failure and recovery distributions, failure domains, startup, quota, price, storage reachability), never by a reliable or unreliable label. A candidate is the current allocation plus a transition sequence to a target, so the cost and feasibility of getting there is chosen too. Customer disruption stays decomposed: time to next accepted result, repeated work, interrupted jobs, SLO-miss probability. When capacity is scarce across N failed customers, the allocation is selected over the complete candidate field under the affected demands' declared objectives and constraints; delay relative to each customer's own allowance is carried as an axis reading or a contract constraint, not as the universal deciding rule, and a contract may select minimax normalized disruption as its own policy. Durable execution authority (job, attempt, fence, receipts) survives every host; portable state rides network storage, which is itself supply and a failure domain. Spare capacity is a selected operating point, not a constant.",
        displaced_cost: "Without this, customer CI failover becomes a separate system with its own priority rules, re-solving the selection, fencing and budget problems the fabric already owns, and inferring customer priority from whoever complained last.",
        first_slice: "One CI workload class, one customer profile, the owned runner pool, one cloud fallback and one durable storage path; candidates stay, move to another owned host, burst to cloud, wait; consequences spend, time to accepted result, repeated work, liability; one executed cutover with fencing and readback. Add customer CI failover to the conformance-decision named consumers.",
        red_control: "(1) Batch work: owned host fails; waiting or another owned host beats cloud. (2) Latency-sensitive PR: the same failure bursts to cloud. (3) A dominating destination is chosen by both profiles. (4) Storage unavailable: a healthy cloud runner is not a feasible destination. (5) Destination startup fails: old capacity is not released and no false cutover is published. (6) A late old runner cannot publish a second result. (7) N-customer outage: capacity goes where the affected demands' declared objectives and contracts select, and changing one customer's contract changes the outcome through that authority only. (8) Changing only the customer objective changes the winner in a real tradeoff.",
        out_of_scope: "Multi-provider procurement beyond one fallback. Selling CI capacity. Changing the repository's own runner target (gunbc.ci.ci_runner_target selected_ci_runner_target) until this consumer is green.",
        handback: "The CI consumer on the shared interface, the executed cutover with fencing, and the eight-case receipt."
      )),
      parent: in_project(project: "fabric-bringup", contribution: "Customer CI hosting rides the same fabric decision as inference serving, so failover and bursting are allocation choices rather than a second scheduler."),
    ),
    roadmap_node(
      identity: "rn_4A1V8V0AN0B51SYR1XJP64A4YC",
      id: "work-execution-redesign",
      owner: "fleet",
      carriers: carrier(path: "dag/gunbc/plans/fabric_market.dag"),
      line: ticket(t: level_fields(
          headline: "Ordinary work runs without anyone choosing a host: it waits when the fleet is full, runs inside an admitted budget, survives controller loss and returns a verifiable result",
          boundary: "gunbc keeps what work means and what counts as its result: source and work identity, materialization and reuse, the estimate and its evidence, durable acceptance, attempts, fencing, retry law, cancellation, outcomes and receipts. Generic node placement, per-job resource enforcement and batch admission are delegated to one scheduler per host, modeled as a cited extdeps upstream, which is the only memory and CPU ledger on every host it is given. GitHub only reads a verdict published from an admitted receipt. Today three allocators claim the same machines (runner slots through GitHub, gunbc.compute.host_capacity ComputeBuildPool and AgentSessionPool, whose cross-pool double promise is a declared frontier there), a CI job owns no bounded cgroup (gunbc.runner.runner_slot_desired gunbc_runner_slot_job_cgroup_ownership), a full pool returns HostComputeCapacityFull as a refusal, and sizing is part of WorkKey, so adaptive sizing could never be wired in. These rows are the program authority, amended when work-exec-1 records its backend ruling, and are not a second plan. Restated 2026-11-23 by gunbc.design_ruling::execution_is_one_first_principles_market_and_schedulers_are_venues: the scheduler is a venue of gunbc.plans.fabric_market, so the market fills an order and the scheduler places within the fill as a written delegated term, and the durable route consumes that plan's venue contract and matching engine (edges on work-exec-2). The operator adopted the program on 2026-11-19 (gunbc.design_ruling::hosted_ci_bridges_to_remote_builds_and_adopts_work_execution_redesign); it had been a proposal of 2026-11-08 for operator discussion, and is no longer one. Overlap with the factory-on-fabric drafts: factory-f3-host-budget-and-backstop is carried by work-exec-6 and factory-f5-off-the-control-host by work-exec-2 and work-exec-5; their disposition is the operator's once this program is accepted.",
          approach: "Seven members in dependency order: work-exec-0 splits sizing from identity and work-exec-1 selects the backend, in parallel; work-exec-2 builds one durable route for one ordinary build; work-exec-3 sizes automatically from evidence; work-exec-4 moves local work over and deletes its old launch paths; work-exec-5 moves CI over and switches the required verdict; work-exec-6 puts every consumer on a host under one ledger. Each member deletes the route it replaces, after naming that root's consumers. Of the original program PR list, PR 2, 3, 5, 6 and 9 to 12 are kept; PR 4 (host reservations and grant issuance) and PR 7 to 8 (remote host executor, SSH convergence, two-candidate selection) mostly dissolve into the scheduler if work-exec-1 selects one.",
          red_control: "The program bar: an ordinary gunbc build submitted with no host chosen and no fleet allocation edited waits while the fleet is full, runs inside its admitted budget, survives a controller kill without losing responsibility, and returns a receipt the CLI or GitHub verifies. A member whose parent walk does not reach this node is not part of the program.",
          displaced_cost: "The operator spends time arranging runner slots and reconciling competing limits by hand; about 25 GiB fixed slots make every small job pay for the largest; capacity refusals bounce work back to whoever submitted it; and roughly 110k lines of runner, fabric and compute machinery re-implement a generic scheduler without ever composing it.",
          handback: "Each member accepted with its executed controls, the plan carrier amended to the selected backend, and the deleted routes named."
        )),
      parent: in_project(project: "fabric-bringup", contribution: "The fleet becomes a fabric that places work by itself, so bringing up a host means joining it, not hand-arranging its slots."),
    ),
    roadmap_node(
      identity: "rn_TPS3J4RXCSR3Y4RA1NZJNKDKVX",
      id: "machine-shapes-join-the-cluster",
      owner: "fleet",
      carriers: carrier(path: "dag/gunbc/plans/new_server_bringup.dag"),
      line: ticket(t: level_fields(
          headline: "Every machine shape already held installs over PXE and joins one cluster as a schedulable node, its accelerators exposed and its power caps held",
          boundary: "Shapes held today: the Supermicro H11SSL-i hosts with T10 and R9700 cards, the ASRock ALTRAD8UD, the Ampere Mt. Collins board moved onto a printed cassette, and 2018-2022 server boards carrying V100 cards. The install route is PXE (gunbc.design_ruling pxe_default_install_and_no_standing_erase_2026_11_10) through the one boot transaction (one_physical_machine_boot_transaction); the cluster is whatever backend work-exec-1-placement-backend-selection records. No workflow branches on a board name: a shape differs only in its declared facts and adapters (boot_delivery_persistence_and_role_are_independent_axes).",
          approach: "Six members: the cluster on the selected backend first; then one member per shape family (H11SSL, ALTRAD8UD, Mt. Collins on its cassette); the GPU families with caps held across a cold boot; and the printed tray the cassette shape needs, realized from the derived partition.",
          red_control: "The project bar: a held unit of each shape, powered from bare metal with nobody present, installs over PXE, joins the cluster, and accepts a scheduled job on its CPU and on each of its card families with the declared caps read back; re-running the install on a converged unit changes nothing.",
          displaced_cost: "Each shape is brought up by hand, differently, and the fleet's capacity cannot be scheduled as one pool; the Mt. Collins lot stays undeployed.",
          handback: "Per member: its accepted controls. Per shape: the install receipt from bare metal and the no-drift rerun."
        )),
      parent: in_project(project: "fabric-bringup", contribution: "The fabric places work only on machines that have joined it; this is how every held shape joins."),
    ),
    roadmap_node(
      identity: "rn_JQPAHM7MHKV641PDD38RBW7ZAK",
      id: "cluster-bringup-on-the-selected-backend",
      owner: "fleet",
      carriers: carrier(path: "dag/gunbc/plans/new_server_bringup.dag"),
      line: ticket(t: updated(t: fields(
        headline: "One cluster runs on held machines on the backend the placement spike selected, and a new node joins it through the install route",
        boundary: "The production counterpart of work-exec-1-placement-backend-selection, whose spike excludes production cutover: the control plane on a held host, node join performed by the install route rather than by hand, and the admission controls the spike proved (memory request equal to limit, waiting when full, thermal taint) carried into it.",
        displaced_cost: "Without a cluster there is nothing for a converged machine to join, and each shape's install ends at an idle host.",
        first_slice: "Install the selected backend's control plane on one held host and join one already-converged worker through the install route.",
        red_control: "(1) A worker joined by the install route appears Ready without a manual step. (2) With the cluster full, a submitted job waits. (3) Restarting the control-plane host leaves running work running and re-observed.",
        out_of_scope: "Multi-host control-plane high availability. Tenant isolation beyond the spike's.",
        handback: "The control-plane receipt, the join receipt and the three controls."
      ), on: "2026-11-23", note: "Declared 2026-11-23 from the operator's direction that every machine shape already held joins one cluster by the PXE install route (gunbc.design_ruling pxe_default_install_and_no_standing_erase_2026_11_10, one_physical_machine_boot_transaction). Unstarted; v2 leads the operator's priorities, so the schedule reads this project's estimates behind the v2 program.")),
      parent: in_project(project: "machine-shapes-join-the-cluster", contribution: "The pool every held shape joins."),
    ),
    roadmap_node(
      identity: "rn_EP012BFWCTH3AQMNRR5S1786ZY",
      id: "h11ssl-shape-joins-the-cluster",
      owner: "fleet",
      carriers: carrier(path: "dag/extdeps/boards/supermicro_h11ssl.dag"),
      line: ticket(t: updated(t: fields(
        headline: "An H11SSL-i host installs over PXE from bare metal and joins the cluster with its T10 and R9700 cards schedulable",
        boundary: "The H11SSL-i hosts held today carry Tesla T10 and Radeon AI PRO R9700 cards. The install is the PXE route with the host's declared facts; the AMD card needs its own device exposure beside the NVIDIA one.",
        displaced_cost: "The serving hosts are rebuilt by hand and their cards cannot be scheduled from the pool.",
        first_slice: "PXE-install one H11SSL-i from bare metal and join it as a cluster node with its CPU schedulable.",
        red_control: "(1) Install from bare metal with nobody present ends Ready. (2) A job requesting a T10 runs on it and reads the device. (3) A job requesting the R9700 runs and reads the device. (4) A second install run reports no drift.",
        out_of_scope: "Choosing which model a card serves.",
        handback: "The install receipt, the device-read receipts and the no-drift rerun."
      ), on: "2026-11-23", note: "Declared 2026-11-23 from the operator's direction that every machine shape already held joins one cluster by the PXE install route (gunbc.design_ruling pxe_default_install_and_no_standing_erase_2026_11_10, one_physical_machine_boot_transaction). Unstarted; v2 leads the operator's priorities, so the schedule reads this project's estimates behind the v2 program.")),
      parent: in_project(project: "machine-shapes-join-the-cluster", contribution: "The first shape, already serving, so the route is proven where the cards are."),
    ),
    roadmap_node(
      identity: "rn_XXP5QRR15QRZ0VC8MDA7QSDQV9",
      id: "altrad8ud-shape-joins-the-cluster",
      owner: "fleet",
      carriers: carrier(path: "dag/extdeps/boards/asrock_rack.dag"),
      line: ticket(t: updated(t: fields(
        headline: "An ALTRAD8UD host installs over PXE from bare metal and joins the cluster as an arm64 node",
        boundary: "The ASRock ALTRAD8UD carries one Ampere Altra socket; its firmware facts are in extdeps.boards. The install is the same PXE route with the board's declared facts and an arm64 image.",
        displaced_cost: "The Altra boards held stay outside the pool, and arm64 work has nowhere to be scheduled but the hand-built hosts.",
        first_slice: "PXE-install one ALTRAD8UD from bare metal and join it as an arm64 node.",
        red_control: "(1) Install from bare metal with nobody present ends Ready. (2) An arm64 job is placed on it and an amd64-only job is not. (3) A second install run reports no drift.",
        out_of_scope: "Accelerators on this board.",
        handback: "The install receipt, the placement controls and the no-drift rerun."
      ), on: "2026-11-23", note: "Declared 2026-11-23 from the operator's direction that every machine shape already held joins one cluster by the PXE install route (gunbc.design_ruling pxe_default_install_and_no_standing_erase_2026_11_10, one_physical_machine_boot_transaction). Unstarted; v2 leads the operator's priorities, so the schedule reads this project's estimates behind the v2 program.")),
      parent: in_project(project: "machine-shapes-join-the-cluster", contribution: "Brings the Altra boards and arm64 work into the pool."),
    ),
    roadmap_node(
      identity: "rn_7EXCACE4E19AX6JBF9G6RYJVWM",
      id: "printed-tray-realized-from-derived-partition",
      owner: "fleet",
      carriers: carrier(path: "dag/product/printed_chassis/cassette_layout.dag"),
      line: ticket(t: updated(t: fields(
        headline: "The cassette tray's printed bodies come from the derived partition for a selected printer, with generated joins and no added fastening hardware",
        boundary: "Today the tray is four hand-listed panels joined by M3 clamps, and the residential assembly takes them from that fixed roster while bed_partition::allocate_axis already derives a minimum partition; cassette_layout::panel_print_policy reads one printer's envelope directly. The printer and process become inputs, the bodies and both sides of every remaining connection are generated from the partition, and the realization reports its physical pieces, connections and added hardware. Joins follow one shared construction in three sizes, with a positional code per connection so pieces that do not belong together cannot seat.",
        displaced_cost: "The tray is fragmented by a fixed roster rather than by the printer, screws hold printed parts together, and holes are cut that nothing mates.",
        first_slice: "Pass the printer and process into the tray policy and generate the tray's bodies and one hardware-free connection from the derived partition.",
        red_control: "(1) A printer whose bed fits the whole tray yields one body and no seam. (2) A smaller printer yields the derived partition with connector projections counted in bed fit. (3) A separate retaining key raises the reported piece count. (4) Two same-size connections with different codes cannot be seated in each other's places.",
        out_of_scope: "The stack posts, fan bank, ducts and bought-part retention, which follow once the tray's connection is qualified.",
        handback: "The realization report for two printers, the four controls, and a printed specimen."
      ), on: "2026-11-23", note: "Declared 2026-11-23 from the operator's direction that every machine shape already held joins one cluster by the PXE install route (gunbc.design_ruling pxe_default_install_and_no_standing_erase_2026_11_10, one_physical_machine_boot_transaction). Unstarted; v2 leads the operator's priorities, so the schedule reads this project's estimates behind the v2 program.")),
      parent: in_project(project: "machine-shapes-join-the-cluster", contribution: "The cassette shape cannot be built until its tray can."),
    ),
    roadmap_node(
      identity: "rn_KMN8EA32TJZ1SES7DVCCDAC8WX",
      id: "mtcollins-cassette-shape-joins-the-cluster",
      owner: "fleet",
      carriers: carrier(path: "dag/product/printed_chassis/cassette_profiles.dag"),
      line: ticket(t: updated(t: fields(
        headline: "A Mt. Collins board on its printed cassette installs over PXE from bare metal and joins the cluster",
        boundary: "The Mt. Collins lot is held undeployed and without memory; the board moves out of its 1U chassis onto a cassette (cassette_profiles mt_collins_profile) keeping its native power assembly. The install is the PXE route with the board's declared facts, and the CPU frequency ceiling is applied by the install before work runs.",
        displaced_cost: "The largest block of held compute stays undeployed.",
        first_slice: "One cassette-mounted Mt. Collins board PXE-installed from bare metal and joined as a node.",
        red_control: "(1) Install from bare metal with nobody present ends Ready. (2) The declared frequency ceiling is read back after a cold boot. (3) A second install run reports no drift.",
        out_of_scope: "Memory purchase for the lot, which follows a working unit.",
        handback: "The install receipt, the ceiling read-back and the no-drift rerun."
      ), on: "2026-11-23", note: "Declared 2026-11-23 from the operator's direction that every machine shape already held joins one cluster by the PXE install route (gunbc.design_ruling pxe_default_install_and_no_standing_erase_2026_11_10, one_physical_machine_boot_transaction). Unstarted; v2 leads the operator's priorities, so the schedule reads this project's estimates behind the v2 program.")),
      parent: in_project(project: "machine-shapes-join-the-cluster", contribution: "Brings the Mt. Collins lot into the pool once its cassette exists."),
    ),
    roadmap_node(
      identity: "rn_JMRKDG5PY2MC4DCM7MBYTJ3H3T",
      id: "gpu-families-schedulable-with-caps-held",
      owner: "fleet",
      carriers: carrier(path: "dag/gunbc/fleet/gpu_power_cap_converge.dag"),
      line: ticket(t: updated(t: fields(
        headline: "Each held GPU family is schedulable from the cluster, and its declared power cap holds across an unattended cold boot",
        boundary: "Families held: Tesla T10, Tesla V100 (16 and 32 GB; compute capability 7.0, which pins its toolkit to CUDA 12), Radeon AI PRO R9700. gunbc.fleet.gpu_power_cap_converge writes a cap and reads it back; this node makes the cap part of the install, applied before any workload can run, and read back after a cold boot with nobody present.",
        displaced_cost: "A cap that resets on reboot forces every circuit to be sized for uncapped draw, and cards of a family are exposed one host at a time by hand.",
        first_slice: "Apply and read back the declared cap for one T10 host as part of its install, then cold-boot it unattended and read it again.",
        red_control: "(1) After an unattended cold boot every card reads its declared cap before the first job starts. (2) A job is refused placement while a card's cap is unread. (3) A V100 job runs on the CUDA 12 toolchain.",
        out_of_scope: "Choosing the cap values, which are operator decisions.",
        handback: "The read-back receipts per family and the three controls."
      ), on: "2026-11-23", note: "Declared 2026-11-23 from the operator's direction that every machine shape already held joins one cluster by the PXE install route (gunbc.design_ruling pxe_default_install_and_no_standing_erase_2026_11_10, one_physical_machine_boot_transaction). Unstarted; v2 leads the operator's priorities, so the schedule reads this project's estimates behind the v2 program.")),
      parent: in_project(project: "machine-shapes-join-the-cluster", contribution: "Makes capped draw a fact the circuits can be sized on."),
    ),
    roadmap_node(
      identity: "rn_36K5STB3N22N3K61M5AY62JXNZ",
      id: "compiler-identity-from-sources",
      owner: "self-host",
      carriers: carrier(path: "dag/gunbc/plans/demand_engine_program.dag"),
      line: ticket(t: updated(t: fields(
        headline: "The compiler's identity is derived from the sources that cause it, so two builds of the same causes share one identity",
        boundary: "The remainder of the old demand-m1b: the keying cut landed (#13756), but no producer derives a compiler identity from its causal sources, so reuse keyed on the compiler cannot be trusted across runs.",
        displaced_cost: "Without a causal identity, reuse either misses on an unchanged compiler or serves a result from a different one.",
        first_slice: "Derive the native compiler's identity from its read set and toolchain inputs and use it as the key of one existing consumer.",
        red_control: "(1) Two builds from identical causal sources produce the same identity. (2) Changing one causal source changes it. (3) Changing a file outside the read set does not.",
        out_of_scope: "Cross-run serving (native-artifact-reuse-through-request-key).",
        handback: "The identity producer, its consumer and the three controls."
      ), on: "2026-11-23", note: "Declared 2026-11-23 when the demand engine was replanned as an intention (gunbc.plans.demand_engine_program section 5). Not yet centered.")),
      parent: in_project(project: "demand-engine", contribution: "Reuse needs a key that means the same compiler."),
    ),
    roadmap_node(
      identity: "rn_E1TAEA7FQEZPYG1XWFM9H9Z6YK",
      id: "native-artifact-reuse-through-request-key",
      owner: "self-host",
      carriers: carrier(path: "dag/gunbc/plans/demand_engine_program.dag"),
      line: ticket(t: updated(t: fields(
        headline: "A native compiler artifact is reused across runs through its request key and the provider, and the seed-side cache path is retired",
        boundary: "The remainder of the old demand-m1c: cross-run reuse exists today only as the seed's native product cache (six SHA-256 axes, a shared store). This moves it onto the request key and provider_serve, with the absent, stale and corrupt cases each taking its own typed arm (section 2.8).",
        displaced_cost: "Reuse lives in a frozen seed-side path that v2 cannot see or extend.",
        first_slice: "Serve one NativeCompilerArtifactRequest through the request key from the shared store with a verified read.",
        red_control: "(1) An unchanged request is served, not rebuilt. (2) A stale read set recomputes. (3) A corrupt stored result refuses and recomputes, never serves.",
        out_of_scope: "Deleting the seed cache before provider_serve is the only producer.",
        handback: "The served-hit receipt, the three controls and the retired seed path."
      ), on: "2026-11-23", note: "Declared 2026-11-23 when the demand engine was replanned as an intention (gunbc.plans.demand_engine_program section 5). Not yet centered.")),
      parent: in_project(project: "demand-engine", contribution: "The first cross-run reuse the engine owns."),
    ),
    roadmap_node(
      identity: "rn_PCDF3HEATT84831KGDB0HV21B6",
      id: "consumers-on-canonical-dependencies",
      owner: "self-host",
      carriers: carrier(path: "dag/gunbc/plans/demand_engine_program.dag"),
      line: ticket(t: updated(t: fields(
        headline: "The remaining consumers read the canonical derived dependencies and activation rules, keep their effect and refusal behaviour, and the authority that transition supersedes is removed",
        boundary: "The remainder of the old M2 and M2V, restated 2026-11-23 after review. program_run_dependencies is gone. activation_dependency is NOT a sidecar: it already derives activation from branch and match structure, keeps activation distinct from prerequisite edges so an untaken arm runs no effects, and requires consumers to respect incomplete derivation; it is a canonical authority to consume, not a target to delete. fold_lowering is semantic lowering of a fold into its loop, domain, accumulator and bound; it is absorbed only by a semantic replacement, never deleted by name. The parallelism classifier already maps containment and binding to StructuralNotACoupling. The work is to find the consumers that still decide dependencies or activation on their own, move each onto the canonical derivation with its effect ordering (D16) and incomplete-derivation refusal preserved, and remove only what that move supersedes, named in the handback.",
        displaced_cost: "A consumer that decides dependencies or activation on its own can disagree with the derivation, run an untaken arm's effects, or read an incomplete derivation as independence.",
        first_slice: "List the consumers that decide dependencies or activation outside the canonical derivation, with the rule each applies, and move the first one.",
        red_control: "(1) The moved consumer's results are unchanged on its population. (2) An untaken arm's effect does not run. (3) An incomplete derivation refuses rather than being read as independence.",
        out_of_scope: "The schedulers themselves (schedulers-on-the-engine).",
        handback: "Each moved consumer with its controls, and each superseded authority removed or named with the consumer that still holds it."
      ), on: "2026-11-23", note: "Declared 2026-11-23 when the demand engine was replanned as an intention (gunbc.plans.demand_engine_program section 5). Not yet centered.")),
      parent: in_project(project: "demand-engine", contribution: "Dependencies have one authority before scheduling moves onto it."),
    ),
    roadmap_node(
      identity: "rn_DYVC7JX3N33F67QGW8JVNA3EFC",
      id: "schedulers-on-the-engine",
      owner: "self-host",
      carriers: carrier(path: "dag/gunbc/plans/demand_engine_program.dag"),
      line: ticket(t: updated(t: fields(
        headline: "The remaining schedulers run on the engine and topological_layers, the workflow scheduler and executor and the realization_runner surfaces are deleted",
        boundary: "The old M3b. Overlaps the work-execution-redesign members, which also replace scheduling; one owner must be named before this is centered.",
        displaced_cost: "Several schedulers order the same work by different rules.",
        first_slice: "Name the owner against work-execution-redesign, then move v2.program onto the engine.",
        red_control: "Each deleted scheduler's former population runs on the engine with identical results.",
        out_of_scope: "Remote execution.",
        handback: "The moved programs and the deletions."
      ), on: "2026-11-23", note: "Declared 2026-11-23 when the demand engine was replanned as an intention (gunbc.plans.demand_engine_program section 5). Not yet centered.")),
      parent: in_project(project: "demand-engine", contribution: "One scheduler."),
    ),
    roadmap_node(
      identity: "rn_PHMYNF27MV9FJX537KKVX53BCF",
      id: "reuse-decided-by-measurement",
      owner: "self-host",
      carriers: carrier(path: "dag/gunbc/plans/demand_engine_program.dag"),
      line: ticket(t: updated(t: fields(
        headline: "Whether a result is served or recomputed is decided from measured cost, and the cost_floor_exempt roster is deleted",
        boundary: "The old M4. The materialization ladder (std.materialization_ladder) still reads a roster for its cost floor.",
        displaced_cost: "An authored roster decides what is cached, so it drifts from what is actually expensive.",
        first_slice: "Record serve and recompute cost for one provider and decide its floor from the record.",
        red_control: "(1) A result cheaper to recompute is recomputed. (2) A result dearer to recompute is served. (3) Removing the measurement refuses rather than defaulting.",
        out_of_scope: "Remote stores.",
        handback: "The measured floor and the deleted roster."
      ), on: "2026-11-23", note: "Declared 2026-11-23 when the demand engine was replanned as an intention (gunbc.plans.demand_engine_program section 5). Not yet centered.")),
      parent: in_project(project: "demand-engine", contribution: "Caching decided by evidence."),
    ),
    roadmap_node(
      identity: "rn_4BKMJHFC6Y5SGZ7JQDXF8Y743G",
      id: "a-change-pays-only-for-what-it-invalidates",
      owner: "self-host",
      carriers: carrier(path: "dag/gunbc/plans/demand_engine_program.dag"),
      line: ticket(t: updated(t: fields(
        headline: "A change pays only for what it invalidates: results stay correct, invalidation is sound, and a result is reused wherever its validity is established",
        boundary: "The old M6 and the intention's first done-when, restated 2026-11-23 after review: not recompute every dependent, which is too strong in the wrong direction, since a dependent whose inputs recompute to the same result need not run again (early cutoff, as the rustc incremental-compilation design describes). Each compiler stage is keyed and stored per judgment.",
        displaced_cost: "Every edit pays for work its change cannot affect.",
        first_slice: "Decompose when its prerequisites are accepted.",
        red_control: "On a named one-file change: (1) the results equal a cold build's; (2) a stale stored result is never served; (3) a dependent whose recomputed input is unchanged is reused rather than re-run, read from the engine's own records.",
        out_of_scope: "Lawful algebraic decomposition (the old M7), until a consumer needs it.",
        handback: "The recompute and reuse populations for a named change, read from the engine's records, beside a cold build's results."
      ), on: "2026-11-23", note: "Declared 2026-11-23 when the demand engine was replanned as an intention (gunbc.plans.demand_engine_program section 5). Not yet centered.")),
      parent: in_project(project: "demand-engine", contribution: "The intention's terminal."),
    ),
    roadmap_node(
      identity: "rn_P8TZEXXCDR0NBS11CFB3TA0BVV",
      id: "work-exec-0-identity-estimate-split",
      owner: "fleet",
      carriers: carrier(path: "dag/product/fabric/work.dag"),
      line: ticket(t: updated(t: fields(
        headline: "A resource estimate can change without changing which work it is, and a grant belongs to one attempt",
        boundary: "product.fabric.work work_identity_material folds shape_material (thread count and envelope_material, including minimum memory) into WorkKey, so a revised memory estimate mints a different key and breaks attachment, deduplication and reuse. envelope_material also omits the GPU, storage and network axes that product.fabric.envelope ResourceEnvelope carries and supply matching checks, so two works differing only in GPU derive one key. Split the three roles: a contract requirement stays in identity only when varying it can change the answer (architecture, isolation, allowed effects, toolchain); a ResourceEstimate carries the demand with its evidence standing (caller declared, measured from N samples, or bounded default) beside the work; a grant is per ExecutionAttemptKey. Supply fungibility compares a grant or estimate against an offer, not identities. Decide GPU, storage and network in the same change: contract requirement in identity, or estimate.",
        displaced_cost: "Automatic sizing cannot be added while a better estimate silently becomes different work, and a GPU requirement that the key ignores lets two different works be treated as one.",
        first_slice: "Move shape out of work_identity_material into a ResourceEstimate carrier, place GPU, storage and network explicitly, and update the supply matcher and the existing WorkKey witnesses.",
        red_control: "(1) Two works identical except for a memory estimate derive the same WorkKey; RED on main, where they differ. (2) Two works differing only in a GPU requirement derive different keys, or the requirement is shown to live in the estimate; RED on main, where they collide. (3) Changing isolation or architecture still changes the key.",
        out_of_scope: "How estimates are produced (work-exec-3). Any scheduler or backend.",
        handback: "The split carrier, the supply matcher reading it, and the three controls with their red runs on main."
      ), on: "2026-11-19", note: "Source review at 398136026b345e087968a9db4ba42ec551c5ca4c (2026-11-19); source presence is not acceptance. product.fabric.work::work_identity_material still includes requirements.shape. The identity/estimate split is not already done. Preserve semantic output obligations while moving only resource estimation out of identity, then update matcher and WorkKey controls together.")),
      parent: in_project(project: "work-execution-redesign", contribution: "Sizing can then adapt without changing what work is, which every later member relies on."),
    ),
    roadmap_node(
      identity: "rn_RQ6M9VDXVNV3HZQ1WGN5PGNVAN",
      id: "work-exec-1-placement-backend-selection",
      owner: "fleet",
      carriers: carrier(path: "dag/gunbc/plans/fabric_market.dag"),
      line: ticket(t: updated(t: fields(
        headline: "The placement backend is chosen by a bounded spike against fixed criteria, and the choice is recorded as a ruling",
        boundary: "Candidates: k3s with Kueue (recommended), Nomad, or keeping the systemd and cgroup realization and finishing gunbc's own allocator. Judge by the machinery and operator work each removes, not by current code volume. The spike runs one ordinary gunbc build as a Kubernetes Job with memory request equal to limit, an ephemeral volume and sccache reachable, on one host the operator grants for about one week. Nomad is evaluated only if k3s fails a criterion. The ruling records the criteria results and amends the PR 4 and PR 7 to 8 scope accordingly.",
        displaced_cost: "Without a chosen backend the program either keeps building a generic scheduler in gunbc or adopts one by accident, and every later member is designed twice.",
        first_slice: "Operator grants a spike host. Stand up a single k3s node with Kueue and run the criteria below once each.",
        red_control: "(1) An OOM is attributed from pod status and memory.peak. (2) With the node full, a second job waits rather than refusing. (3) Cancel yields termination evidence. (4) Killing the controller mid-run leaves the job running and it is re-observed. (5) A DIMM reading over 85 C taints the node and blocks new placement. (6) An arm64 job and an amd64 job each land on a matching node. (7) Manual operator steps are counted and reported. A criterion with no executed run counts as failed, never as passed.",
        out_of_scope: "Production cutover. Running agent sessions in the cluster. Multi-host high availability of the control plane.",
        handback: "The criteria receipts, the recorded gunbc.design_ruling, and the amended plan carrier."
      ), on: "2026-11-19", note: "Source review at 398136026b345e087968a9db4ba42ec551c5ca4c (2026-11-19); source presence is not acceptance. The backend choice is conditional: k3s/Kueue first, Nomad only if the recorded criteria fail. srv1 access for this review is not authorization to install a cluster or choose the backend. Keep the host grant and realization decision explicit; do not price all alternatives as committed work.")),
      parent: in_project(project: "work-execution-redesign", contribution: "Decides which generic machinery gunbc stops owning."),
    ),
    roadmap_node(
      identity: "rn_C62Z25H5J12ZRZZ6NSRKY1ERPK",
      id: "work-exec-2-durable-route-first-consumer",
      owner: "fleet",
      carriers: carrier(path: "dag/gunbc/plans/fabric_market.dag"),
      line: ticket(t: updated(t: fields(
        headline: "One ordinary gunbc build goes through durable acceptance, a fenced attempt on the selected backend, and a bound receipt",
        boundary: "Model first: cited, versioned extdeps modules for the selected backend (for Kubernetes, batch/v1 Job and core/v1 Pod resources and conditions; for Kueue, Workload and ClusterQueue admission). Then the controller, realized on it: acceptance through the #15310 request boundary, one Job per ExecutionAttemptKey, a pending admission projected to Waiting on capacity, and a receipt bound to attempt, source and work. A backend Job can start twice, so result publication is create-only and keyed by attempt. A pod on an unreachable node is never read as proof that it stopped; the attempt stays unresolved until fenced. Parking in this member means waiting before start or release at a durable output boundary; freezing a cgroup is not release, and process checkpoint is out of scope. The first consumer is an ordinary build, not heal.",
        displaced_cost: "Capacity shortage stops bouncing work back to its submitter, and a lost controller stops losing accepted work.",
        first_slice: "The extdeps model for the selected backend and a controller that accepts one build, creates its attempt and reads its terminal state back into a receipt.",
        red_control: "From the shadow matrix, each executed and each naming the mutation that turns it red: success, compile failure (domain failure, no retry), OOM (infrastructure ending, no compile-failure substitution), cancel, controller kill and resume, duplicate start publishing once, stale receipt rejected.",
        out_of_scope: "Automatic sizing (work-exec-3). Deleting old routes (work-exec-4). CI (work-exec-5).",
        handback: "The extdeps model, the controller, and the executed matrix cases."
      ), on: "2026-11-19", note: "Source review at 398136026b345e087968a9db4ba42ec551c5ca4c (2026-11-19); source presence is not acceptance. This node depends on the selected backend. Model the extdeps boundary first, then one accepted build, durable waiting/restart, fencing and create-only publication. These are separate failure contracts with shared route machinery; no per-state uniform multiplier is justified.")),
      parent: in_project(project: "work-execution-redesign", contribution: "The one route every later consumer moves onto."),
    ),
    roadmap_node(
      identity: "rn_31P66G12R309F6JHJVW1M23GX4",
      id: "work-exec-3-automatic-sizing",
      owner: "fleet",
      carriers: carrier(path: "dag/gunbc/compute/work_class_grant.dag"),
      line: ticket(t: updated(t: updated(t: fields(
        headline: "A caller may state a size; otherwise the system grants a bounded budget from evidence and learns from the result",
        boundary: "Precedence: the caller's stated estimate, then class evidence, then a bounded default for new work. gunbc.compute.work_class_grant already has the rule (rows, sample floor, ceiling fallback, retry at ceiling after an exceeded grant) but work_class_grant_rows is empty, so every grant is the ceiling. Fill rows from the memory.peak the backend reports for each attempt. An OOM at a smaller grant is a new attempt with a larger grant under the retry law, capped by the largest admissible node, never a hidden shell retry. Keep estimated demand, reserved capacity, enforced limit and observed use distinct; admit memory conservatively, without overcommit, in this member. The 14, 9 and 18 GiB figures from the private profile stay candidate inputs until their measurement scopes are reconciled.",
        displaced_cost: "Every job reserves the largest job's memory, so the fleet runs a fraction of the work it could, and nobody should have to supply an estimate by hand.",
        first_slice: "Persist completed-attempt WorkClassPeakSample rows and read them back into the existing work_class_grant rule. Show the second class run uses evidence and missing/insufficient samples retain the declared ceiling policy.",
        red_control: "(1) The second run of a class reserves from evidence, not the ceiling. (2) A run that OOMs at the small grant and then succeeds appears as two attempts with two grants. (3) A class below the sample floor reserves the bounded default and says why.",
        out_of_scope: "Memory overcommit. In-place resize. Thermal-aware sizing.",
        handback: "The sample writer, the populated grant rule and the three controls."
      ), on: "2026-11-19", note: "Source review at 398136026b345e087968a9db4ba42ec551c5ca4c (2026-11-19); source presence is not acceptance. gunbc.compute.work_class_grant already defines WorkClassPeakSample, work_class_peak_sample and work_class_grant. The current rule deliberately returns GrantAtCeiling for missing or insufficient samples, rather than refusing execution. Residual is durable sample writing/readback and second-run evidence; align the task with that actual policy instead of charging a new grant rule."), on: "2026-11-19", note: "Estimate basis: reuse the implemented sample and grant carriers; the revised leaves budget durable writer/readback wiring and its controls. The day values are working-day priors, not measured runtime or observed delivery duration. GrantAtCeiling for insufficient evidence is preserved, not silently changed into a refusal.")),
      parent: in_project(project: "work-execution-redesign", contribution: "Ends fixed largest-job sizing without asking callers for estimates."),
    ),
    roadmap_node(
      identity: "rn_V22G3K7YYFYCSRXDT5BYMW2JA9",
      id: "work-exec-4-local-work-cutover",
      owner: "fleet",
      carriers: carrier(path: "dag/gunbc/compute/work_provider_local.dag"),
      line: ticket(t: updated(t: fields(
        headline: "gunbc build, test and validate_worktree submit through the durable route, and the old local launch paths are deleted",
        boundary: "On the selected backend, every local build and test consumer submits through work-exec-2's route. Then delete the direct compute_provide launch, the worker bin/gunbc shell bypass, and ComputeBuildPool on hosts joined to the scheduler. Name each root's consumers by grep and source inspection before deleting; a negative search is not proof of no consumer.",
        displaced_cost: "Two launch routes for the same work keep two sets of limits and failure behavior alive, and the old one keeps refusing on a full pool.",
        first_slice: "Move validate_worktree onto the route and delete its direct launch.",
        red_control: "(1) A planted direct launch fails. (2) A caller or controller restart keeps accepted work. (3) A full fleet produces waiting, never HostComputeCapacityFull, on a joined host.",
        out_of_scope: "CI (work-exec-5). Agent sessions (work-exec-6).",
        handback: "The moved consumers, the deleted routes with their named consumers, and the controls."
      ), on: "2026-11-19", note: "Source review at 398136026b345e087968a9db4ba42ec551c5ca4c (2026-11-19); source presence is not acceptance. validate_worktree is the first consumer of the selected durable route. Build and test can reuse submission/readback but retain distinct verdicts. Delete direct launch routes only after restart/capacity/direct-launch controls; do not implement another controller inside this cutover.")),
      parent: in_project(project: "work-execution-redesign", contribution: "Local work stops having a second way to run."),
    ),
    roadmap_node(
      identity: "rn_4CMQW3464V4M24BHTWYDG141AJ",
      id: "work-exec-5-ci-verdict-from-receipt",
      owner: "fleet",
      carriers: carrier(path: "dag/gunbc/ci/ci_runner_target.dag"),
      line: ticket(t: updated(t: fields(
        headline: "The required CI verdict is published from an admitted receipt for the exact commit, and the fixed runner slots are gone",
        boundary: "On the selected backend, first the optional shadow job (roster addition already approved). Then hosts move one at a time: withdraw runner slots, quiesce, join as a node, so no host is ever under two authorities. Then a light publisher posts the required check from the admitted receipt, bound to the exact head or merge commit and restricted to one GitHub App; success is published only when the receipt establishes it. The first cut keeps today's grain, one Job per required v2-bootstrap run; the demand engine splits it later where measurement shows a gain. An interim actions-runner-controller bridge is a scaffold that needs operator approval outside the diff and dissolves at the verdict switch; it is not part of this plan unless approved.",
        displaced_cost: "CI keeps the fixed slots and their hand arrangement until the required verdict stops depending on them.",
        first_slice: "Run the shadow job through the route for every pull request and compare its verdict with v2-bootstrap.",
        red_control: "(1) Success is never published without a bound receipt for that commit. (2) A late result from an old attempt cannot publish. (3) A rollback rehearsal withdraws admission and proves quiescence before the old route resumes. (4) No host carries runner slots and scheduler admission at once.",
        out_of_scope: "Customer CI (fabric-customer-ci-failover). Fork pull requests, which stay unobserved.",
        handback: "The shadow comparison, the switched verdict, the rollback rehearsal, and the deleted runner slot desired-state, slot allocation, CI microVM sizing, FleetSelfHosted selection and ctrl-build or BuildBuddy integration."
      ), on: "2026-11-19", note: "Source review at 398136026b345e087968a9db4ba42ec551c5ca4c (2026-11-19); source presence is not acceptance. The CI switch is downstream of durable execution. Shadow comparison, verdict switch, rollback and runner-state deletion are different work with a shared route. A cached compiler or an isolated planning test is not evidence that CI can already abandon runner slots or BuildBuddy.")),
      parent: in_project(project: "work-execution-redesign", contribution: "GitHub becomes a reader of the fabric's verdict."),
    ),
    roadmap_node(
      identity: "rn_YW4B4KCWR1P4WEAF3AECRTMR8F",
      id: "work-exec-6-one-ledger-per-host",
      owner: "fleet",
      carriers: carrier(path: "dag/gunbc/compute/host_capacity.dag"),
      line: ticket(t: updated(t: fields(
        headline: "Every consumer on a host, agent sessions and serving included, is charged against one ledger",
        boundary: "Until this member, agent sessions keep a declared node reservation set from one host fact, so the split between sessions and scheduled work is stated rather than discovered. Here sessions and serving either run under the scheduler or keep that reservation with a stated reason; serving tenure stays its own contract. The cross-pool frontier and AgentSessionPool in gunbc.compute.host_capacity are deleted. A session waiting for a build must not hold the capacity that build needs.",
        displaced_cost: "Two allocators on one host can promise the same memory twice, which is the failure the operator reconciles by hand today.",
        first_slice: "Decide sessions in pods or a permanent reservation, with the reason recorded.",
        red_control: "A planted concurrent load of sessions and builds cannot over-promise a host's memory; RED is the current two-pool adjudication.",
        out_of_scope: "Moving serving engines between hosts.",
        handback: "The decision, the single-ledger control, and the deleted pool frontier."
      ), on: "2026-11-19", note: "Source review at 398136026b345e087968a9db4ba42ec551c5ca4c (2026-11-19); source presence is not acceptance. The ledger change needs a policy decision for session capacity, then a complete set of consumers charged to one host ledger. This review does not determine that consumer population. Reuse existing host_capacity and placement evidence; no speculative per-consumer total.")),
      parent: in_project(project: "work-execution-redesign", contribution: "Closes the last way two allocators can claim the same machine."),
    ),
    roadmap_node(
      identity: "rn_01M7TXSXC3G6ES2BKYBJF0MZ9Y",
      id: "remote-build-ci-bridge",
      owner: "fleet",
      carriers: carrier(path: "dag/gunbc/compute/remote_build_client.dag"),
      line: ticket(t: fields(
        headline: "The remote build serves the required check on hosted and placeholder runners",
        boundary: "The operator adopted the work-execution-redesign program on 2026-11-19 and admitted this bridge in the same ruling (gunbc.design_ruling::hosted_ci_bridges_to_remote_builds_and_adopts_work_execution_redesign). CI jobs run on standard GitHub-hosted runners for the public repo (free) and on small self-hosted placeholder runners for the private repo; the runner keeps no fleet state and shells out to the gunbc remote build over the tailnet, joining as an ephemeral node via Tailscale OAuth as tag:ci-dispatch (a dedicated dispatch tag: a tag:ci runner could not reach a tag:ci:22 host, so the operator approved it verbatim \"OK for ci-dispatch, as long as its all modeled/recorded for tailscale convergence\"; its ACL grant and credential are recorded for tailscale convergence in PR 16752, which cites the ruling). It is the admitted scaffold of gunbc.design_ruling::remote_build_ssh_dispatch_is_an_admitted_scaffold with its admitted scope extended to the CI substrate, not its status upgraded: the remote build now carries the required check's substrate, and it still dissolves when work-exec-2's durable route and work-exec-5's verdict-from-receipt serve the same requests. The self-hosted fleet runners are frozen (no new investment) and keep serving the required check until cutover; static slot sizing is frozen beyond the srv3/srv4 six-slot carve (gunbc.design_argument::replacement_migration). The hosted shadow job is admitted against gunbc.design_ruling::job_roster_closed_to_growth; work-exec-5 already records the shadow roster addition as approved.",
        displaced_cost: "A hosted runner lease per required run and a build-pool reservation on srv3 and srv4, standing in for the per-slot MemoryMax and the fixed seat count for the duration of the bridge.",
        first_slice: "One emitted_subject_build_rows label, the seed build plus gunbc test on that label, runs on a remote build under a reservation sized from the gate's measured profile, and a non-required hosted job drives it end to end.",
        red_control: "A remote-build request whose reservation does not fit the host ledger net of serving's charge is refused with a typed cause rather than oversubscribed; the required context still passes on the frozen fleet runners until the cutover node makes the remote path required.",
        out_of_scope: "The cutover that makes the hosted and remote path required, the retirement of the self-hosted fleet units, the srv3 and srv4 six-slot carve itself, and serving's ledger charge, each of which is its own member or node.",
        handback: "The verdict published from the remote build, the reservation figure it ran under, and the ledger entry that admitted or refused it.",
      )),
      parent: in_project(project: "work-execution-redesign", contribution: "Carries the required check through the remote build as the admitted interim bridge the operator adopted, dissolving into work-exec-2 and work-exec-5."),
    ),
    roadmap_node(
      identity: "rn_HARNESS0RECURSIVE0ALIGN0A",
      id: "harness-recursive-alignment",
      owner: "harness",
      carriers: carrier(path: "docs/plans/harness-work-lifecycle.md"),
      line: ticket(t: fields(
        headline: "Allow work to continue across durable epochs while preserving alignment to every project level and the task contract",
        boundary: "Continuation is unbounded in time but bounded in grounding: at each epoch boundary an independent adjudication reads the attempt's evidence against its rooted chain and resumes, steers, re-plans, routes, or stops the lineage.",
        displaced_cost: "A fixed round budget ends correct work mid-task; uncapped continuation without adjudication trades longer execution for quiet drift. Both failure shapes were measured on live workers.",
        first_slice: "Turn the harness's round-count terminal into a checkpoint-due announcement the workflow adjudicates outside the worker loop.",
        red_control: "A worker crosses two checkpoints on one lineage and submits one candidate; no checkpoint is reported as task failure or completion; a planted steer is accepted and visible in the next epoch.",
        out_of_scope: "The checkpoint never establishes submission, verification, publication, or readiness; those gates are untouched.",
        handback: "The checkpoint mechanism, the durable cadence state, the adjudication boundary, and the two-checkpoint acceptance receipt."
      )),
      parent: in_project(project: "factory", contribution: "Recursive alignment lets workers continue across durable epochs without trading longer execution for project drift."),
    ),
    roadmap_node(
      identity: "rn_HPROMPT0CONTEXT0MODEL00A",
      id: "harness-prompt-context-model",
      owner: "harness",
      carriers: carrier(path: "dag/gunbc/harness/harness_prompt_context.dag"),
      line: ticket(t: updated(t: fields(
        headline: "A prompt is a projection of an admitted context snapshot, never an authored string",
        boundary: "Prompt inputs are typed (authority declaration + revision, work contract + revision, evidence with standing, prior conversation turns, guidance receipts); a context snapshot binds them to an attempt lineage, epoch, and source revision; provider envelopes are late projections of a PromptPlan; a render receipt digests exactly what was rendered. A withdrawn item cannot render as established; a conversation turn cannot fork from bytes the lineage does not own.",
        displaced_cost: "Today the modeled guidance premises collapse into system_prompt: String at the config boundary, so a contradiction between two inputs is concatenated and shipped to the model, and a stale conclusion can resurface from a provider session as if it were a fact.",
        first_slice: "Stand up the PromptInput/PromptContextSnapshot/PromptSegment/PromptPlan types with the render receipt, and make harness_guidance emit modeled segments rather than the final system-prompt string.",
        red_control: "Identical snapshots render identical digests; changing an authority revision invalidates the old render; a Withdrawn input cannot reach a rendered segment; compaction cannot drop unresolved guidance or a tool result's matching call; restart reconstructs the same prompt from durable inputs.",
        out_of_scope: "Segment content is rendered prose, digested -- the type system guards input provenance and revision, not the prose itself. No semantic contradiction inference between free-text inputs; conflicts must be typed to refuse.",
        handback: "The snapshot/segment/plan model, the render receipt, harness_guidance emitting segments, and the controls."
      ), on: "2026-09-30", note: "Not yet centered: needs a centering plan: authored 2026-09-30 with no attempts, and its first slice has not been confirmed bounded.")),
      dispatch: dispatchable(),
      parent: in_project(project: "factory", contribution: "The lifecycle's mandatory steps are only workflow-owned if what the agent is TOLD is also derived and revisioned; modeled prompt inputs make prompt contradiction a dispatch-time refusal instead of a runtime prayer."),
    ),
    roadmap_node(
      identity: "rn_HCHECKPOINT0PLANNER000A",
      id: "harness-checkpoint-subject-planner",
      owner: "harness",
      carriers: carrier(path: "dag/gunbc/roadmap/roadmap_alignment.dag"),
      line: ticket(t: fields(
        headline: "Freeze the checkpoint subject and derive the per-level probe obligations, purely",
        boundary: "Given an AlignmentCheckpointIdentity and the resolved chain, derive the homogeneous probe population (principles, root project, each intermediate project, task), each obligation carrying its level contract, the edge contribution it judges against, the prior guidance outstanding at that level, and the PromptContextSnapshot identity it projects from. No model call, no workspace effect, no verdict: this is the pure plan the durable scheduler executes.",
        displaced_cost: "If probe obligations are derived inside the execution loop, a crash mid-fan-out cannot say which probes existed, and reruns risk minting duplicate verdicts for one checkpoint.",
        first_slice: "The obligation-derivation function and its witness: one checkpoint over the harness lineage derives exactly four obligations in root-to-leaf order, each keyed by the checkpoint identity.",
        red_control: "The same checkpoint identity derives the identical obligation set (idempotent re-derivation after a crash); an obligation's level contract digest and contribution digest come from the chain, not re-authored; a checkpoint whose chain fingerprint moved refuses re-derivation.",
        out_of_scope: "No probe execution, no roundup, no resume; those are the scheduler and adjudication folds. No PromptPlan rendering here either -- the probes' plans are assembled where they execute.",
        handback: "The derivation, the obligation carrier, the idempotency witness, and the join key the scheduler consumes."
      )),
      dispatch: dispatchable(),
      execution: bound(contract: harness_checkpoint_subject_planner_execution_contract()),
      parent: in_project(project: "harness-recursive-alignment", contribution: "The pure planner turns a checkpoint into durable, idempotent obligations, so the parallel probe fan-out is a schedule over derived facts rather than an in-loop improvisation."),
      centering: plan(text: "Target: dag/gunbc/roadmap/roadmap_checkpoint_plan.dag, the checkpoint_probe_obligations derivation, and its witness dag/test/claim/roadmap/roadmap_checkpoint_plan_witness.dag. (1) The witness is authored and green at dispatch; keep it green -- a witness edit refuses verification as oracle-moved. (2) The deliverable per the node row: the obligation carrier over the resolved chain, obligation keys idempotent under one AlignmentCheckpointIdentity, the fingerprint-mismatch refusal naming both fingerprints, and outstanding guidance read at leaf distance (task is distance 0; obligations derive root-to-leaf). (3) Scope wall: NO probe execution, NO verdicts, NO roundup -- this lane is the pure planner the scheduler consumes; the belt's adjudication lane joins it later. (4) Acceptance: the named test process, pattern //dag/test/claim/roadmap:roadmap_checkpoint_plan_witness_test."),
    ),
    roadmap_node(
      identity: "rn_HCONVO0LOG0FORK0POINTS0A",
      id: "harness-conversation-log-forking",
      owner: "harness",
      carriers: carrier(path: "dag/gunbc/harness/harness_turn.dag"),
      line: ticket(t: fields(
        headline: "The attempt lineage owns its conversation log; epochs resume and probes fork from typed fork points",
        boundary: "Every round's exact wire (messages sent, blocks received) persists under the attempt's state directory keyed by round, so any (attempt, epoch, round) names an exact conversation state. Epoch resume replays the log to its tip and appends the guidance bundle; an alignment probe forks at the checkpoint's log tip: shared chain prefix plus one level-specific suffix branch. The engine's prefix cache only accelerates what the log already makes correct; nothing may depend on the cache being warm.",
        displaced_cost: "Without a durable log, continuation re-briefs blind, a worker's hard-won context dies with its process, and 'fork from a known point' is impossible because no known point exists.",
        first_slice: "Persist per-round request/response bodies keyed by round in the attempt state directory; wire continuation resume to replay from the log instead of a fresh brief.",
        red_control: "A fork is typed: ForkAdmitted { tip } / ForkInvalid { cause }, where a model, weights, chat-template, or chain-fingerprint change invalidates the fork point; a crashed worker's next epoch resumes from the durable log, not from a re-authored brief; a probe can name the exact log tip it forked from.",
        out_of_scope: "No engine-side KV pinning or replica affinity; the cache stays an opportunistic derivation. No change to what the alignment probes judge.",
        handback: "The durable log, the fork-point typing, resume-from-log, and receipts for crash recovery and invalidation."
      )),
      dispatch: dispatchable(),
      execution: bound(contract: harness_conversation_log_forking_execution_contract()),
      parent: in_project(project: "harness-recursive-alignment", contribution: "The lineage-owned conversation log is what makes resume and probe forks possible at all: without it every epoch is a cold start and every fork point is imaginary."),
      centering: plan(text: "Target: dag/gunbc/harness/harness_turn.dag and dag/gunbc/harness/harness_conversation_fork.dag. The wire layout and fork typing are landed (per-round request/response under <attempt-state>/provider-events.jsonl.wire/, turn.wire_log_unwritable degradation, ConversationForkAdmittance with its three named invalidation causes, KvPrefixResidencyObservation as placement input only). (1) The witness dag/test/claim/harness_conversation_fork.dag is green; keep it green. (2) Remaining per the node row: resume-from-log -- the continuation path replays the durable wire log to its tip and appends the guidance bundle instead of re-briefing, and emits the fork receipt binding model/checkpoint/tokenizer/template/projection/prefix digests. (3) Scope wall: engine KV residency is a performance derivation, NEVER correctness state -- cache hit and cache miss must render the same bytes. (4) Acceptance: the named test process, pattern //dag/test/claim/harness_conversation_fork_test."),
    ),
    roadmap_node(
      identity: "rn_HALIGN0CHECKPOINT0RESUME0A",
      id: "harness-alignment-checkpoint-resume",
      owner: "harness",
      carriers: carrier(path: "dag/gunbc/harness/harness_turn.dag"),
      line: ticket(t: updated(t: fields(
        headline: "Replace fixed round exhaustion with an evidence-bound checkpoint whose verdict resumes, steers, re-plans, routes, or stops the same attempt lineage",
        boundary: "At the epoch boundary the harness emits turn.alignment_checkpoint_due bound to the chain fingerprint and returns control; adjudication runs outside the worker loop against durable evidence; the verdict and next cadence state publish atomically; only adjudication resumes the lineage.",
        displaced_cost: "An in-loop checkpoint that asks the worker to grade itself mints continuation on the worker's own word -- the drift the checkpoint exists to catch is exactly the drift such a worker would not report.",
        first_slice: "Typed TurnAlignmentCheckpointDue outcome plus the durable event, the admitted-root chain projection, and the belt's adjudication-and-resume wiring.",
        red_control: "An unrooted task refuses its chain; a worker's own aligned assertion cannot mint a continuation receipt; a changed node contract or edge contribution invalidates earlier receipts; a crash after verdict publication produces exactly one next epoch.",
        out_of_scope: "No change to submission, verification, or publication gates; reviewers, auditors and probes keep hard step budgets.",
        handback: "The outcome, the rooted projection, the adjudication boundary, durable cadence state, and witnesses for the red controls."
      ), on: "2026-09-30", note: "Not yet centered: needs a centering plan: authored 2026-09-30 with no attempts, and its first slice has not been confirmed bounded.")),
      dispatch: dispatchable(),
      parent: in_project(project: "harness-recursive-alignment", contribution: "The checkpoint turns an arbitrary terminal counter into the durable mechanism that enforces recursive alignment."),
    ),


    roadmap_node(
      identity: "rn_4K7LFFQ3V1B0NIZA5HUGNWWUD",
      id: "namespace-unique-on-chain",
      owner: "namespace",
      carriers: carrier(path: "dag/gunbc/plans/names_without_imports.dag"),
      line: ticket(t: updated(t: updated(t: updated(t: level_fields(
          headline: "Decide every name one canonical way",
          boundary: "Every declaration reference is fully qualified and binds to its declared path; a bare reference is a lexical binder or unbound. Imports are removed before production admission. The project includes later physical retirement of the unused seed mirror, so production admission consumes the concrete sole-resolver and grammar handbacks rather than waiting on this whole container.",
          approach: "Reuse the qualified resolver, carry declaration identities to consumers, migrate compatible callers and remove import syntax in both parsers. Prove the sole production decision route before admission; verify physical unused mirror removal with interpreter retirement.",
          red_control: "A name answered two ways by two code paths is a defect of this project.",
          displaced_cost: "Several mechanisms decide one name differently, so a proof about a program can be a proof about a program other than the one written.",
          handback: "Every declaration reference binds by its qualified declaration path, lexical binders retain their scope, import syntax refuses in both parsers, and the legacy production deciding mechanisms are deleted. Physical unused seed mirrors retire with the interpreter."
        ), on: "2026-11-16", note: "Operator ruling gunbc.design_ruling::imports_are_deleted_before_v2_is_accepted restores import deletion as this project's goal, sequenced before v2's acceptance as the production route and after native-seven: the edge native-production-admission <- namespace-unique-on-chain is declared, and the handback's 'explicit import' arm ends when the cut lands. The intention is gunbc.plans.names_without_imports. The boundary text above records the 2026-11-08 reading and is not rewritten here."), on: "2026-11-17", note: "gunbc.design_ruling::declaration_references_are_fully_qualified: every declaration reference is spelled by its full path, always; a bare name is a lexical binder or unbound; the explicit-import arm of this node's handback is superseded and the ambiguity-discharge member closes as vacuous under the rule. The layer nodes are re-cut accordingly."), on: "2026-11-19", note: "Source review at 398136026b345e087968a9db4ba42ec551c5ca4c (2026-11-19); source presence is not acceptance. Project rollup only. Its handback still describes explicit import as a canonical binding route, which conflicts with the recorded import-free production decision. Correct the endpoint; children own every implementation and validation charge.")),
      parent: in_project(project: "v2-compiler-live", contribution: "The live compiler must decide every name one way. Otherwise each proof it carries is about a program that may mean something other than what was written."),
    ),

    roadmap_node(
      identity: "rn_WNFHYN3C1DA917SQJMLCTUFX3",
      id: "v1-deletion-program",
      owner: "self-host",
      carriers: carrier(path: "dag/gunbc/v1/v1_deletion_plan.dag"),
      line: ticket(t: updated(t: fields(
        headline: "Delete the old compiler honestly",
        boundary: "The v1 deletion program: the interpreter's primitive surface becomes enumerable and then model-authoritative; the hand-written Rust population is read from the repository at a known revision rather than transcribed; deleting old tests loses no coverage; the products build and run with the old directory absent; and the seed-honesty ruling records whether independent rebuild must precede removal. This node is the program's decomposition level; the executable rows are its children.",
        displaced_cost: "'Mostly migrated' is not a state anyone can verify; without a derived frontier and a recorded trust ruling, deletion either waits forever or lands silently incomplete.",
        first_slice: "Read the rows in dependency order: the primitive-surface roster and dispatch authority, the host source observation, the honest-frontier census, test migration, the seed-honesty decision, then the queue drain, emitter deletion, and the v1-free product builds.",
        red_control: "A deletion-program row claimed by a second project refuses as typed ambiguity; a row whose membership walk does not arrive here refuses unrooted; each child's edge names what that row's work adds to this program.",
        out_of_scope: "No executable work lives on this node -- it is never dispatched and never carried by an execution contract -- and its bar does not replace the per-row tickets' own bars.",
        handback: "The rooted deletion chain, every attached child's edge contribution readable against this intent, and no v1-deletion row whose walk ends anywhere else."
      ), on: "2026-09-30", note: "Roster change (v2 worksheet, 2026-09-30): v1-ci-floor-cutover and v1-verification-ledger merged into native-production-admission, and v1-emitter-fixed-point moved to v2-emitter-production as successor promotion.")),
      parent: in_project(project: "v2-compiler-live", contribution: "Retiring the seed is the terminal fact of v2 being live. This program makes 'the old code is gone' a derived frontier instead of an assertion."),
    ),

    roadmap_node(
      identity: "rn_YYXCOYJGPXICGC4YYL8TPFQH9",
      id: "v2-emitter-production",
      owner: "self-host",
      carriers: carrier(path: "src/v2/compiler/self_host/candidate_generation.dag"),
      line: ticket(t: level_fields(
          headline: "The new compiler writes its own Rust, then rebuilds itself",
          boundary: "The v2 emitter writes Rust with provenance, reaches every artifact the seed retains (main.rs included), and builds generation two (the built v2 CLI emits v2.compiler.compile) and then generation three (fixed point). The end state is a v2-built compiler admitted as successor by admit_promotion.",
          approach: "Seed-emitted closures build under -D warnings (#11474, #12468), and behavioral receipts form a series (#12446). Next: second generation, with the typed filesystem door from #12391 already in place, then the fixed point, then promotion (D9).",
          red_control: "A generation whose build reached the seed, or a behavior difference on the discriminating corpus, blocks promotion. So does any remaining EmitterProducedDivergentRegistration row in v2.compiler.self_host.stage0_crate_layout.",
          displaced_cost: "Until the emitter produces every artifact and a second generation, every compiler change still goes through hand-maintained seed Rust.",
          handback: "SelfHostSuccessorPromotionAdmitted and SelfHostEmitterProducesEveryRetainedArtifact CLEAR; the interlock milestones SelfHostBehavioralEquivalenceReestablished and SelfHostCargoPhaseEnrolled are cited, not restated."
        )),
      parent: in_project(project: "v2-compiler-live", contribution: "A compiler that cannot build itself is not self-hosted. This project turns 'v2 emits Rust' into a second and third generation that need nothing from the seed."),
    ),

    roadmap_node(
      identity: "rn_B7B9QVT0KCWB5PVWG9SE6PHFS7",
      id: "emission-minimum-cost",
      owner: "self-host",
      carriers: carrier(path: "dag/gunbc/emit_copy_qualification.dag"),
      line: ticket(t: level_fields(
          headline: "Every .dag building block has an understood, minimum-cost Rust realization, proven by execution, and larger programs inherit it",
          boundary: "The .dag core is small and fold-heavy: Node and Edge, Value, Transform, Branch, Loop, Bind and Match, plus record and variant construction, field reads, generic instantiation and closures. Each of those building blocks gets a stated realization contract (what it may allocate, copy, retain or share, and why) and an executing specimen that holds it, through the real emitter, an untouched emitted crate, a release build and a run. Composite patterns are qualified only on top of qualified building blocks. The contracts are stated against the source construct, not against Rust spelling, so a later target adds realization rows under the same contracts. Rust is the first target.",
          approach: "Production-selected, bottom-up repair in short cycles. The real-consumer profile (emission-real-consumer-profiles) picks which building blocks to qualify first; each block is qualified alone (emission-building-block-realization), its failure is repaired at the earliest incorrect layer (emission-ownership-facts-survive-lowering), the fixed production workload is re-measured, and only then do composites built from repaired blocks qualify (emission-composite-patterns). The v2 emitter is attempted from the first specimen; emission-cost-native-successor owns terminal qualification and the required-route row, not the first look at v2 behavior. gunbc.emit_copy_qualification is the existing cost model and is extended, never forked; its battery has never executed (gunbc.rung_drop.emit_copy_qualification_without_a_consumer), and this project is what restores it.",
          red_control: "A building block or composite whose contract is stated but whose specimen did not execute through the production emitter reads unqualified, never qualified. A deliberately violating realization (a redundant owning retain on an observation, a copied accumulated prefix, a mutated retained snapshot) must turn its control red through the same observation path that greens the valid one.",
          displaced_cost: "The emitter's ownership and allocation choices are not stated anywhere a reader can check, so the cost of a .dag program is discovered after the fact. Receipt: the native parse-population control (v2.cli.population_verbs) added about 15 minutes to every pull request's witnesses run once it walked the whole corpus, and nobody could say from the source which part of that cost was the algorithm and which was the realization.",
          handback: "Every building block and composite family in this project reads qualified by execution under the v2-emitted producer and its successor, the seed result kept only as a measured baseline (seed repairs are made only where the native transition or selected operational relief needs them); the real consumers show the before and after; and gunbc.rung_drop.emit_copy_qualification_without_a_consumer is retired by its own trigger."
        )),
      parent: in_project(project: "v2-compiler-live", contribution: "v2 is meant to be better than the seed, not only to compile. A self-hosted compiler whose emitted code has no stated cost cannot scale to the corpus it compiles, and a fold-heavy language only stays cheap if its few building blocks are."),
    ),
    roadmap_node(
      identity: "rn_90MWFH4W3TY4WJCEYX1YEHBPKA",
      id: "emission-building-block-realization",
      owner: "self-host",
      carriers: carrier(path: "dag/gunbc/emit_copy_qualification.dag"),
      line: ticket(t: fields(
        headline: "Each .dag building block, alone, emits Rust whose ownership and allocation are stated and checked by execution",
        boundary: "One minimal specimen per building block: a Value (scalar, record, nonrecursive variant, generic instance over a scalar and over a nontrivial payload), a Transform, a Branch, a Loop with a record accumulator, a Bind, a Match (on an owned temporary and on a borrowed shared sum), a field read, a record rebuild with one field changed, a local and an escaping closure, and the collection operation families under them: sequence build, element read and sequential traversal (PersistentSequenceCarrier), and index build, lookup and traversal (PersistentMapCarrier). Each carries a contract in gunbc.emit_copy_qualification terms (OwnershipPattern, CarrierRealization, ControlShape, ConsumerContract) and v2.lens.cost, conditional on the state it runs in: input size and payload shape, observation versus consumption, live aliases or retained versions, escape, and the representation entering and leaving the operation. Owning retains, payload copies and collection copy-on-write are distinct observations. The measured lifetime includes teardown: construction, steady-state use and release are reported separately and in total, and a traversal count is reported where the claim depends on it. The specimen is ordinary .dag compiled by the production frontend and emitter into an untouched crate, built in release and run; the counters and the emitted operations are both read, because neither alone establishes the contract.",
        displaced_cost: "Today a reader cannot say what a record rebuild or a fold step costs in emitted Rust without reading generated code, and the seed's habits (an Rc around every record, a .clone() at every read) are inherited by every program above them unexamined.",
        first_slice: "Observation and state threading, chosen from the parse-population profile: a small nonescaping result and cursor advanced in a repeated walk, a match on a borrowed shared sum, and an owned record accumulator carrying unchanged context. Each lands with its contract, specimen, violating variant and discriminating run, under the seed emitter and attempted under the v2 emitter (where v2 cannot yet execute it, the exact blocker is named and the v2 result reads unqualified). Next: unique sequence and index construction versus retained snapshots.",
        red_control: "For each specimen a violating variant goes through the same path and goes red: an owning retain added to the observation, a per-step allocation of the accumulator, a copy of the unchanged context. A contract whose specimen did not execute reads unqualified.",
        out_of_scope: "Composite patterns (emission-composite-patterns). Repairing the emitter (emission-ownership-facts-survive-lowering). Partial evaluation or specialization of constant data: the reference realization executes the same algorithm as the source.",
        handback: "The building-block contracts, their executing specimens and violating variants, and the measured realization of each under the seed emitter and, where it executes, the v2 emitter, including the ones that currently fail."
      )),
      parent: in_project(project: "emission-minimum-cost", contribution: "The building blocks are the floor: every larger pattern's cost is only explainable if these are."),
    ),
    roadmap_node(
      identity: "rn_N8V3A6H9W3XX87NPVJ81E78M5X",
      id: "emission-ownership-facts-survive-lowering",
      owner: "self-host",
      carriers: carrier(path: "src/v2/compiler/wrap_decision.dag"),
      line: ticket(t: fields(
        headline: "A failing contract is repaired at its earliest incorrect layer: a missing fact, a wrong decision from available facts, the collection realization, or work no consumer demands",
        boundary: "For each building-block contract that fails, find the earliest incorrect layer (gunbc.design_argument::earliest_unjustified_boundary) and repair it there, with its consumer and a discriminating source-to-Rust control in the same change. It may be a missing or discarded fact (use kind: observe, transfer, retain, consume; coexistence across branches and joins; escape of closures and fields; liveness across a loop step), a wrong decision taken from facts that were available, or the collection or runtime realization that consumes a correct decision; correct ownership does not by itself establish a good collection realization, and replacing the collection library is not a first move. Result demand is in scope too (gunbc.design_argument::demand_before_materialization): a producer with two consumers, one retaining the full result and one needing only a verdict, as with v2.compiler.module_acquisition acquisition_parse, which builds provenance and span maps and keeps only Accepted or Rejected. A verdict-only realization must keep every acceptance and refusal the full producer performs, keep one production parsing authority (no hand-written recognizer), and leave the full-result consumer's occurrence identities, provenance and extents unchanged; an ignored field does not license deleting a check made while producing it. The v1 model conflates a use proven not to consume with a use never classified (Read in src/v1/ownership.dag); v2 must keep unknown distinct from proven, so an unknown neither becomes an unsafe borrow nor an expensive default reported as minimum cost. v2.compiler.translate and v2.compiler.wrap_decision already consume representation decisions and are extended, not paralleled.",
        displaced_cost: "Without the facts, the emitter can only choose the safe expensive realization everywhere, and every future emitter (a second target, the v2 successor) rediscovers the same missing facts.",
        first_slice: "Trace the first failing observation-and-state-threading contract to its earliest incorrect layer and land that repair with its consumer, its control and the re-measured parse-population workload.",
        red_control: "A repaired fact with no consumer in the emitter is dangling and refuses review. A use whose classification is unknown is emitted with the conservative realization and is counted as unknown, never as qualified.",
        out_of_scope: "Rewriting generated Rust by hand or by a post-pass. Name-keyed shortcuts (recognizing a function name and applying a special realization).",
        handback: "Each repair, the layer that now carries it, its consumer, the building-block contract that turned green because of it, and the production comparison after it."
      )),
      parent: in_project(project: "emission-minimum-cost", contribution: "Contracts expose where cost is lost; this node repairs the loss at its source so every program benefits."),
    ),
    roadmap_node(
      identity: "rn_PF21EXV44N0VP89DSHTG1E8ZNM",
      id: "emission-composite-patterns",
      owner: "self-host",
      carriers: carrier(path: "dag/gunbc/emit_copy_qualification.dag"),
      line: ticket(t: fields(
        headline: "Composite patterns built only from qualified building blocks keep the blocks' costs",
        boundary: "About ten small specimen families, each composed from building blocks already qualified: read-only fan-out, read then project then transfer, branch split and join, loop-carried state, unique sequence and text construction, persistent update with a retained old version, closure capture and invocation, a data-driven rule interpreter over runtime-supplied rules, and a parallel diamond. Each states which costs are necessary (a retained snapshot, a genuinely shared child, a task boundary) and which are not. Text specimens include multibyte Unicode and check byte spans separately from character positions; collection specimens use sizes on both sides of the pinned collection implementation's representation transitions, not only the existing 0, 4, 16, 64 grid.",
        displaced_cost: "Without composites, a qualified block can still be realized expensively once combined (a branch join that manufactures sharing, a closure that clones its environment per call), and that is where real programs spend.",
        first_slice: "Read-only fan-out, loop-carried state and unique sequence construction, each with its snapshot or violating control.",
        red_control: "A composite qualifies only over blocks whose contracts read qualified after repair, and only when each block's output state (aliases, retained versions, representation) meets the next block's stated preconditions; a cost beyond those conditional contracts without a stated necessary cost goes red. A snapshot specimen in which the old version is changed goes red even if it is faster. A composite over a block still reading failed is unqualified, not qualified.",
        out_of_scope: "Qualifying building blocks (emission-building-block-realization). Changing the algorithm a specimen executes.",
        handback: "The composite families, their stated necessary costs, and their executing controls."
      )),
      parent: in_project(project: "emission-minimum-cost", contribution: "Composites prove the blocks compose: confidence in a small set of patterns only holds if combining them adds no hidden cost."),
    ),
    roadmap_node(
      identity: "rn_4FHSKX20JR8S9SGE3E7GEG1S73",
      id: "emission-real-consumer-profiles",
      owner: "self-host",
      carriers: carrier(path: "src/v2/compiler/tokenize.dag"),
      line: ticket(t: fields(
        headline: "Real emitted hot paths are profiled against the building-block contracts and their cost is attributed to the realization or the algorithm",
        boundary: "An initial and recurring input, not a final step: the profile picks the first specimens, orders the repairs, and is re-run on the fixed workload after each relevant repair. Profile the emitted v2 lexer and parser (the parse-population verb over the live roots, and full-artifact parsing as a separate benchmark so a verdict-only speedup cannot hide unchanged map construction), one compiler graph traversal and one scheduler payload path, using the actual emitted artifacts. Self time in a named function is not the cost of its algorithm (its collection and allocation work runs in callees), unresolved samples stay unresolved, and a per-byte difference between populations is a scaling warning until a controlled size series of one source shape confirms it. Each hot spot is attributed to a building-block or composite contract it violates, or to the algorithm itself. A realization defect becomes a row for emission-ownership-facts-survive-lowering; an algorithmic cost (interpreting constant rules per character) is recorded separately and only then considered for preparation or specialization.",
        displaced_cost: "The parse-population control costs about 15 minutes on every pull request and its split between realization and algorithm is unknown, so any fix today is a guess at the measured link (gunbc.design_argument::earliest_unjustified_boundary, measurement is the adversary).",
        first_slice: "Record the baseline already taken (seed-emitted parse-population on the 5 largest dag modules and a 165-module sample, perf self time grouped by collection, allocation, provenance index, lexer and parser), fix those two populations as the benchmark, and close the attribution gaps it names: call graphs with frame pointers, and symbols for the unresolved samples.",
        red_control: "A claimed speedup must name the contract or algorithmic change it comes from and show the old computation gone; an improvement on a small specimen is not evidence for the consumer.",
        out_of_scope: "Reducing what the CI population control covers; that is a CI scope decision outside this project.",
        handback: "Per consumer, the attributed profile, the contract rows or algorithmic findings it produced, and before-and-after measurements on the fixed workloads for verdict-only and full-artifact parsing and the other declared consumers."
      )),
      parent: in_project(project: "emission-minimum-cost", contribution: "Real consumers are the test that the building blocks were the right ones and that qualifying them actually moved production cost."),
    ),
    roadmap_node(
      identity: "rn_W009PFM599AS8444GNDVTE2D3F",
      id: "emission-cost-native-successor",
      owner: "self-host",
      carriers: carrier(path: "dag/gunbc/emitted_subject_build_gate.dag"),
      line: ticket(t: fields(
        headline: "The qualified specimens hold under the v2 emitter and its successor, on the required route",
        boundary: "Terminal qualification: run the building-block and composite specimens through the v2-emitted subject and the successor-v2-emitted subject after a source change, with the v1 generator and interpreter unavailable on that route and producer identity on every result; the seed-emitted result is a baseline. An unsupported route reads unqualified and never substitutes the seed. The battery joins the required route as a row judged through gunbc test, not as a new job (the job roster is closed to growth), and reports the runner time it adds to that route.",
        displaced_cost: "A qualification that only holds for the seed's emitter is lost at promotion, which is exactly when the seed stops being available to compare against.",
        first_slice: "The first-slice building-block specimens run under the v2-emitted subject with producer identity recorded.",
        red_control: "A result whose producer is the seed while the run claims the v2 emitter refuses. A specimen that is qualified under the seed and unqualified under v2 blocks promotion of that claim.",
        out_of_scope: "Adding a CI job.",
        handback: "The specimens qualified under the v2 producer and its successor after a source change, the required-route row with its added runner cost, and gunbc.rung_drop.emit_copy_qualification_without_a_consumer retired."
      )),
      parent: in_project(project: "emission-minimum-cost", contribution: "Carries the qualification across self-hosting so it survives the seed's retirement."),
    ),
    roadmap_node(
      identity: "rn_GG8OZ558D0UB3R98N5MQCDPKB",
      id: "ci-end-to-end-execution",
      owner: "ci-control",
      carriers: carrier(path: "docs/plans/ci-process-end-to-end.md"),
      line: ticket(t: level_fields(
          headline: "CI verdicts name what they executed",
          boundary: "The CI end-to-end execution program under the factory: a required check carries the population it actually executed and refuses a verdict on an empty one; the floor fits the fleet's memory; the unit tests block again; the required run's cost is attributed.",
          approach: "Members in order of readiness: the executed-coverage receipt (its closing witness is bound), the floor memory peak, the unit-test lane, and the required-run cost.",
          red_control: "A required check that reports a verdict over an empty executed population refuses; a member whose parent walk does not reach this node refuses as unrooted.",
          displaced_cost: "A pipeline failure that cannot say what it ran reads as corpus failure, and every reviewer re-derives what CI actually proved.",
          handback: "Each member accepted, with the executed population named by its instrument."
        )),
      parent: in_project(project: "factory", contribution: "A CI verdict that names what it executed is the factory's verification half: without it, pipeline failure reads as corpus failure."),
    ),
    roadmap_node(
      identity: "rn_XSEKT13HXV12Z5BP4RM4S2F0HW",
      id: "vm-service",
      owner: "fleet",
      carriers: carrier(path: "dag/product/fabric/selection.dag"),
      line: ticket(t: level_fields(
          headline: "End-of-year VM service: compute on our own fleet, every promised property observed rather than assumed",
          boundary: "Allocation, placement and serving follow the fabric/compute conformance domain (gunbc.design_argument::conformance): product.fabric.selection select_supply, product.capacity.lease LeaseGrant, gunbc.serving.serving_availability, and classification against gunbc.host.host_assimilation_program. A service dimension may stay opaque only above a falsifiable quality floor with a named consequence (gunbc.design_argument::guarantee_ladder). Commercial terms are not modeled here.",
          approach: "Six milestones, their alignment fields pending the operator-reviewed contracts document: fabric application authority; managed identity, access and dependencies; microVM runtime and durable state; direct website serving; the factory on the fabric; the customer workspace service. Wet bring-up and serving restores stay operator-driven.",
          red_control: "An unclassified machine artifact refuses before change. A stalled route takes no new work. A published property with no acceptance receipt is not published.",
          displaced_cost: "Without observed fleet state and liveness, every capacity or isolation claim is a claim about a model of the machine.",
          handback: "Per milestone: the acceptance receipts that show it, named by their instruments."
        )),
      parent: in_project(project: "fabric-bringup", contribution: "The end-of-year VM service turns the factory's own fleet into a service others can use; fleet, serving and compute facts become a contract only once each is observed rather than assumed."),
    ),
    roadmap_node(
      identity: "rn_0RV6KBTCG8ZYD6M76TV1PMXP7D",
      id: "debt-payoff",
      owner: "debt",
      carriers: carrier(path: "dag/gunbc/recurring_failure_mode.dag"),
      line: ticket(t: updated(t: level_fields(
          headline: "Retire known gaps and recurring failure modes against their rostered triggers",
          boundary: "Scope is a named gap, a dag/gunbc/recurring_failure_mode/ class, a gunbc.rung_drop row or a named debt roster, retired to its next rung or shrunk toward its dissolution. It does not take a lane's feature work, and no new capability lands here. Each member is sized so one worker can finish it with a named witness.",
          approach: "Milestones DP-M1 to DP-M6, each done when a named roster reaches a stated size or a class a named rung. DP-M2 (the shell batch) first: land the finished shell candidates, then the ready ones; beside it, the DP-M1 dissolvable-now rows.",
          red_control: "A member with no witness or closing contract is not ready and does not dispatch. A fix that only moves the cost (a cache, a wider budget, a raised limit) is not payoff (gunbc.design_argument::earliest_unjustified_boundary). A class retired without its RED staying enrolled is not retired (gunbc.design_argument::guarantee_ladder (dissolution on climb)).",
          displaced_cost: "Each item is paid on every run or every review until retired.",
          handback: "Per member: the witness green by execution, the deleted debt, the roster's new size or the class's new rung, and the acceptance receipt."
        ), on: "2026-11-19", note: "Source review at 398136026b345e087968a9db4ba42ec551c5ca4c (2026-11-19); source presence is not acceptance. Campaign join only. Seven done-when conditions are acceptance questions, not seven implementation tasks. Charge fixes to their concrete debt nodes and retain the evidence rollup here.")),
      parent: in_project(project: "gunbc-project-root", contribution: "Known gaps and recurring failure modes, each retired against its rostered trigger, stop charging every later change for the same defect."),
    ),
    roadmap_node(
