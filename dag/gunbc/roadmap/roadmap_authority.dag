    roadmap_node(
      identity: "rn_2VQX8KZD5JWN4T7RYH6MCB3FP9",
      id: "operator-srv4-site-pxe-edge-apply-go",
      owner: "operator",
      carriers: carrier(path: "dag/gunbc/fleet/site_pxe_edge_converge.dag"),
      line: ticket(t: updated(t: fields(
        headline: "DECISION GATE: the operator's GO to Apply on srv4",
        displaced_cost: "Three rows end at this gate. Without a named GO they read as unfinished agent work instead of as work waiting on a person, and the edge stays hand-tended by default.",
        boundary: "The operator's GO to Apply the modeled state on srv4 -- the edge, its staged artifacts and the served install user-data. Everything up to the Apply is repository work; the Apply itself is the operator's.",
        first_slice: "The GO, recorded on this row, after which the Apply runs and the three srv4 rows can be closed on evidence.",
        red_control: "A live claim about srv4's edge that cites no Apply GO refuses; the same claim passes once the GO and the Apply's readback are recorded.",
        out_of_scope: "Giving the GO; running the Apply; the modeling rows that precede it.",
        handback: "A recorded GO and an Apply readback, with the srv4 rows closed on evidence rather than on expectation."
      ), on: "2026-11-20", note: "Operator-held per the hand-down; prerequisite of srv4-site-pxe-edge-live-source-row and of the live half of srv4-install-client-user-data-drift.")),
      parent: in_project(project: "site-boot-and-management-edge", contribution: "The one act that changes srv4's live edge stays the operator's, and is named as such."),
