    // compatibility-aware stage planner (v2.workflow.regen_convergence_transaction regen_plan_next_stage) are kept;
    // no item replaces either. Edges encode only real prerequisites, not an implementation order.
    roadmap_node(
      identity: "rn_NFVQAYKT70VJF1T47S6AJRYPS6",
      id: "heal-scope-relation-without-typecheck",
      owner: "ci-control",
      carriers: carrier(path: "dag/gunbc/plans/read_set_convergence.dag"),
      line: ticket(t: fields(
        headline: "Heal's scope reads the same dependency relation without typechecking the pool",
        boundary: "gunbc.plans.read_set_convergence P7 (1). The scope child (required_regen_host regen_module_edges) builds a whole-pool index that typechecks every module to read its edges: 9 to 12 minutes and about 16 GB per heal run. Derive the SAME relation, dotted references (imports included) and bare references, from parsing and name resolution alone, using the authoritative resolution semantics and its refusals.",
        displaced_cost: "Every heal run, including one that changes nothing, pays 9 to 12 minutes and about 16 GB to read edges a parse and a resolve already give.",
        first_slice: "An equivalence test against the current whole-pool edge index over the live pool: the edge sets are equal, with a bare-reference specimen an imports-only graph would miss.",
        red_control: "A bare-reference edge dropped by the cheaper path makes the equivalence test fail; a reference the cheaper path cannot resolve refuses the scope instead of being dropped; a planted ambiguous bare name refuses rather than picking one binding.",
        out_of_scope: "Recorded per-mirror read sets (P4) and the add/delete rule (heal-scope-population-evidence). No new CI job and no raised time or memory budget.",
        handback: "The equivalence receipt over the live pool, the refusal outputs, a before/after heal scope-step time and peak memory, and the diff."
      )),
      dispatch: dispatchable(),
      parent: in_project(project: "demand-engine", contribution: "The file-grain dependency relation heal scopes by is the demand engine's read set at its first consumer; deriving it without typechecking is what makes a scope cheap enough to ask every run."),
    ),
    roadmap_node(
      identity: "rn_APDCTBWQY09JWTACX5M07SYZS4",
      id: "heal-scope-population-evidence",
      owner: "ci-control",
      carriers: carrier(path: "dag/gunbc/regen_affected_change.dag"),
      line: ticket(t: fields(
        headline: "An added or deleted .dag file widens heal's round only when the dependency and output evidence says it must",
        boundary: "gunbc.regen_affected_change regen_affected_set_over_change answers WholePopulation for any added or deleted .dag file. Replace that rule with one derived from old and new evidence: what was reachable from the seed roots before and after, whether any resolved dependency changed, and which outputs must be created, regenerated or retired. WholePopulation stays where it is the derived answer, and a scope that cannot be established refuses. Exclusion follows from dependencies, never from a directory or category name. This can be established on the current authoritative graph; it does not wait for heal-scope-relation-without-typecheck.",
        displaced_cost: "In the six sampled heal runs (2026-11-22), every run that did work used the whole population, each because it added a .dag file, including two plan-only pull requests: about 35 minutes each where an unrelated addition needs none.",
        first_slice: "The five cases below as discriminating controls against the current graph, then the rule switched in regen_affected_change.",
        red_control: "An added module unreachable from the seed roots selects no mirror; an added module that becomes reachable is emitted and admitted; a deleted reachable module whose old mirror is still committed is regenerated or retired, never left orphaned; a changed binding between files that were already members selects the affected mirrors; a new bare-name ambiguity or an unresolvable reference refuses.",
        out_of_scope: "Making the relation cheaper (heal-scope-relation-without-typecheck); recorded read sets (P4).",
        handback: "The five control outputs, one real heal receipt for an unrelated plan-file addition answering NoAffectedMirrors, and the diff."
      )),
      dispatch: dispatchable(),
      parent: in_project(project: "demand-engine", contribution: "Population changes are invalidations of the read set like any other; deciding them from evidence keeps the selection denominated in the change."),
    ),
    roadmap_node(
      identity: "rn_4BRXDWRM94116QCG25DENVJ2NT",
      id: "heal-seed-build-artifacts-scoped",
