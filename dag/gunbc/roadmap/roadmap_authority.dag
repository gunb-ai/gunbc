    roadmap_node(
      identity: "rn_RSPTW7T9VRES9F7FHCP08QFGX5",
      id: "ci-required-run-cost",
      owner: "ci-cost",
      carriers: carrier(path: "src/v2/workflow/required_floor.dag"),
      line: ticket(t: updated(t: fields(
        headline: "Make the required run cost what its inputs require, measured on the run that owns the number",
        boundary: "The required run is one claim_executor --required-ci process with four phases (parse, regen, v2-emission, floor). Its cost is read from that run's own [floor-phase] rows and compile.frontend/normalize/reconcile/analyses lines, never transcribed. Work under this row attributes wall time to a phase by instrument, then removes computation whose inputs did not change, one phase at a time, with the attribution re-read from the run after each change.",
        displaced_cost: "Every PR waits for the whole run (about thirty minutes at the 2026-08-22 measurement, from the run named in DESIGN.md Building & checks); the fifteen rows this replaces optimised a plan, a scheduler and a scoped worker that no longer exist, so they could only be closed by re-creating what the floor cut deleted.",
        first_slice: "One row per phase in a receipt the run emits: phase name, wall time, and the subject size it ran over (modules parsed, entries emitted, witnesses routed), so a later change can be judged against the same instrument rather than a remembered number.",
        red_control: "A change that claims to cut a phase's time without the run's own receipt moving refuses review; a receipt whose phase list differs from the run's printed roster (phases_run) is a defect, not a report.",
        out_of_scope: "No return of batches, plan entries, selection flags or a second worker process; no corpus-denominated fallback; the tokenizer escape-scan row stays separate.",
        handback: "The per-phase receipt on the required run, and the first phase attribution read from it."
      ), on: "2026-09-30", note: "Not yet centered: needs a centering plan: handed off from the v2 worksheet to the CI lane with no plan.")),
      dispatch: dispatchable(),
      parent: in_project(project: "ci-end-to-end-execution", contribution: "The required run is paid on every landing; attributing and cutting its cost keeps verification affordable enough to stay required."),
    ),

    roadmap_node(
      identity: "rn_9WD4YB1TQK6RXA0PJM7N5GHVC2",
      id: "entry-graph-union-construction",
      owner: "",
      carriers: [],
      line: SupersededLine { by: "DESIGN.md Building & checks (the 2026-08-15 floor cut) and the re-cut row ci-required-run-cost", content: "The ci_floor plan, batch scheduler, scoped worker, discovery snapshot and falsifier cadence this row optimised were deleted at the floor cut — the required run is now one claim_executor --required-ci process running four phases, and none of the artifacts this row names exist to warm, share, stream or reconcile. The cost that survives (the required run's wall time, read from its own [floor-phase] and compile.* lines) is re-cut against the live mechanism as ci-required-run-cost." },
