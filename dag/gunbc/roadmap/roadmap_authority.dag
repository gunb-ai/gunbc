    roadmap_node(
      identity: "rn_9JXQW2VTNB5KZCR7MHPD4GYL60",
      id: "census-job-level-observation-and-reprojection",
      owner: "buyer-review",
      carriers: carrier(path: "docs/plans/review-sheet-and-census-lane-handoff.md"),
      line: ticket(t: fields(
        headline: "Derive prospect rows from job-level observation, because the workflow-level scan cannot",
        boundary: "Read jobs?filter=all across every page AND every attempt, and derive from it the facts the prospect rows actually need: real runner and provider identity, job occupancy, pre-start observation, cancelled occupancy, and provider execution standing. Then reproject those into the private commercial reading and the operator-safe sheet rows. The bounded scan producer landed in gunbc#11656 yields a declared candidate POPULATION and is a prerequisite, not a substitute.",
        displaced_cost: "The 57 transcribed rows in the sheets-census prototype carry economic readings that were shown not to have the meanings assigned to them, and without this arc there is no route that re-derives them. Until it exists the sheet can be presented and cannot be refreshed, and its numbers cannot be quoted.",
        first_slice: "The job-level read with attempts and paging, and occupancy derived from it for one known repository, compared against the transcribed row for that same repository.",
        red_control: "Each of the four invalidated inferences must be refused rather than reproduced: a workflow wall duration offered as summed runner occupancy; a workflow-run admission delay offered as runner queue delay; a provider declaration read as provider execution; provider adoption read as positive spend. A repository whose jobs paginate must not report only its first page.",
        out_of_scope: "No re-presentation of the prototype totals as current, and no commercial projection over a population the job-level read has not covered.",
        handback: "The job-level observation carrier, the occupancy derivation, the reprojection, and a statement of which transcribed rows survived re-derivation and which did not."
      )),
      dispatch: dispatchable(),
      parent: in_project(project: "customer-workspace-service", contribution: "Prospect census and buyer review are the customer-facing edge of the service; their identity and custody belong with it."),
    ),
    roadmap_node(
      identity: "rn_2HKDQZ8WVNX4TBM6RCPJLG0517",
      id: "census-app-registration-installation-and-custody",
      owner: "buyer-review",
      carriers: carrier(path: "docs/plans/review-sheet-and-census-lane-handoff.md"),
      line: ticket(t: fields(
        headline: "Actually register, install and take custody of the census App",
        boundary: "gunbc#11552 landed the acquisition MODEL and its route; it did not achieve acquisition. The step that stalls is real: gunbc.github_app_acquisition tells the operator to paste the manifest into the App-creation form's manifest field, and GitHub exposes no such field -- the manifest protocol requires a form POST carrying a manifest parameter, and a GET renders the blank create page. This node covers manifest submission, installation consent, callback capture and credential custody, and it treats registration and INSTALLATION as the two separate facts they are.",
        displaced_cost: "gunbc#11677 consumes an App and an installation that have already been admitted; it creates neither. So every downstream census route that depends on an installation token is blocked on a fact no receipt in this corpus currently establishes, while the acquisition model reads as though it were done.",
        first_slice: "Make the submission step executable, or replace the instruction with one that is. The named dissolution path is browser automation driving the form under an owner session.",
        red_control: "An instruction a reader cannot execute must refuse rather than render: the step that names a form field GitHub does not expose is the specimen. A stored credential plus a failed live request must not read as an acquired App.",
        out_of_scope: "No claim that ownership consent can be automated away -- GitHub requires an owner to submit, and that is an honest HumanIntervention until browser automation drives it.",
        handback: "A receipt naming the registered App, the installation, and the custody location of its key, or a typed refusal saying which of the three is missing."
      )),
      dispatch: dispatchable(),
      parent: in_project(project: "customer-workspace-service", contribution: "Prospect census and buyer review are the customer-facing edge of the service; their identity and custody belong with it."),
    ),
    roadmap_node(
      identity: "rn_5TBHM9XKCWQ2VLF7NRJD8GYZ3E",
      id: "census-installation-token-via-app-jws-route",
      owner: "buyer-review",
      carriers: carrier(path: "docs/plans/review-sheet-and-census-lane-handoff.md"),
      line: ticket(t: fields(
        headline: "Lift the census API budget by reusing the App JWS route rather than building a second signer",
        boundary: "A second composed performer in gunbc.github_effect_perform consuming the clock/claims/jws/openssl/AppInstallationAccessTokens.Create prefix that gunbc#11677 establishes, factored into one function returning a sole_constructor installation-token carrier that each performer consumes inside its own call. Not a second module and not a second signer.",
        displaced_cost: "The census reads a public population under an unauthenticated rate limit, so its scans are truncated by budget rather than by the question. The route to fix it already exists; building a parallel one forks the custody authority.",
        first_slice: "The factored prefix and the composed performer. gunbc#11671, gunbc#11677 and gunbc#11679 are all merged, so the route is available to build against today and nothing external gates this.",
        red_control: "Run with the personal-access-token route unavailable, so a successful code-search page is attributable only to the token producer rather than proving a token could be rendered.",
        out_of_scope: "No rs256_sign host primitive: PRIMITIVE-EGRESS-0 admits openssl only as one handler behind a key-custody signer interface over a key reference, and CRYPTO-0 is actively deleting host crypto primitives, so a new one lands against that program. No bare Secret return, and no second environment-variable token that a personal access token could silently satisfy.",
        handback: "The carrier, the performer, and the live control taken with the fallback route removed."
      )),
      dispatch: dispatchable(),
      parent: in_project(project: "customer-workspace-service", contribution: "Prospect census and buyer review are the customer-facing edge of the service; their identity and custody belong with it."),
    ),
    roadmap_node(
      identity: "rn_6WDPNLJ4RQKZXC2VTH7BM9SYFG",
      id: "ntfy-publisher-token-onto-gcp-custody",
      owner: "buyer-review",
      carriers: carrier(path: "docs/plans/review-sheet-and-census-lane-handoff.md"),
      line: ticket(t: fields(
        headline: "Dissolve the ntfy publisher-token HumanIntervention into the Mt Collins custody pattern",
        boundary: "Consolidate gunbc.auth.approval_ntfy_deployment approval_ntfy_publisher_token_intervention into the custody authority gunbc#11679 establishes, as ONE fleet-converge mode whose credential is a dispatch choice over a CLOSED ROSTER of custody rows. The controller key becomes that roster's first row rather than a constant. Each row carries a SecretRef, a path, an owner principal, a group principal, a mode ARM, and the directory's own owner, group and mode.",
        displaced_cost: "The read side is already modeled and only delivery is manual, so every credential rotation spends an operator. One converge mode per credential grows a hand-enumerated roster, and a free-text credential input is a stringly selector; the closed roster is what keeps both out.",
        first_slice: "The consolidation onto the custody authority gunbc#11679 established, with the controller key as the first roster row. gunbc#11679 is merged, so nothing external gates this.",
        red_control: "A 0640 token for a service group needs a directory that group can traverse, so a row whose directory mode refuses every group bit must fail; the exact-mode and forbidden-bits legs are derived from the mode arm, never taken as a caller octal.",
        out_of_scope: "This does NOT retire gunbc.rung_drop approval_store_single_writer_by_agreement. A find-metadata readback establishes which principals HOLD PERMISSION BITS and not that a non-writer cannot open the store; that trigger needs an execution-as-another-user leg, and its row already names a permission-bits readback among the things that do not retire it.",
        handback: "The custody authority with the controller key and the ntfy token as rows, and the HumanIntervention deleted rather than left beside it."
      )),
      dispatch: dispatchable(),
      parent: in_project(project: "managed-identity-access-dependencies", contribution: "A publisher token held outside managed custody is an ambient credential this milestone retires."),
    ),
    roadmap_node(
      identity: "rn_6ZFZPYVBX39088FFTWTNF3SCXJ",
      id: "self-host-service-family-on-literal-terminal",
      owner: "self-host",
      carriers: carrier(path: "docs/plans/namespace-cut-replacement-plan.md"),
      line: ticket(t: updated(t: updated(t: updated(t: updated(t: fields(
        headline: "Admit the service declaration family without taxing every identifier",
        boundary: "The G0 service family parses through a grammar terminal that matches one exact word, so the marker words stay ordinary identifiers everywhere else. The parse-door refusals the family needs - missing name, missing brace, volatile, exit-without-arrow, mock-without-expression - keep their separate meanings rather than collapsing into one refusal later in the pipeline.",
        displaced_cost: "Giving each marker word its own token class was measured as a corpus-wide cost defect: every plain-name slot became a thirteen-way choice and the lexer carried twelve more rules, so the cost was paid once per identifier in every parse. Against a fixed baseline a large minority of the shared witness population moved, and every one of them moved upward - a unidirectional shift, which is what distinguishes a real cost change from runner noise. The population and the magnitude are re-derived by joining the required floor's per-claim cost receipt across the two runs: the artifact named required-floor-claim-cost, which the required run uploads and which carries eval_steps per witness identity. The alternative of making the markers ordinary identifiers and refusing later loses five distinct refusals, because a service declaration has no later stage that could tell those five mistakes apart.",
        first_slice: "Re-express the service family on the exact-word terminal, which is already on the main line: delete the twelve keyword lex rules and the contextual-name machinery, keep the input-and-output field tail scoped to services, and RETAIN the name-usability regression evidence, re-expressed at the lexical and grammar boundary rather than retired.",
        red_control: "Two alternatives that differ only in that one word validate as distinct, while the same pair keyed on the token class alone still reports an overlap; a wrong word in the marker position is refused at the parse door; and the matched word is not published as the node's identity, so no caret literal or generic parameter changes what it carries. A source using the marker words as ordinary names still parses, and that fixture is the retained name-usability control - it reds if any later change keywords a spelling again. Each named parse-door refusal asserts its own typed diagnostic and the stage that raised it, never bare non-acceptance: a helper that is the negation of parses folds a tokenize failure and a parse failure into one verdict, so it can pass for a reason the claim is not about.",
        out_of_scope: "Not the resolver's treatment of imports, and not the evaluation-step cost of the whole-service witness, which is its own item.",
        handback: "Return the measurement against the same baseline showing the moved population back at baseline, the refusal controls, and a statement of which service constructs still have no lowering."
      ), on: "2026-09-20", note: "The prepared branch is on the shared remote so the citation resolves for anyone with the repository, not only for its author. It was cut before the merges of 2026-09-20 that put the exact-word terminal on main, so it needs rebasing onto current main before it can be proposed for landing."), on: "2026-09-21", note: "CORRECTION to this row as first authored: the slice instructed retiring the name-usability claim as a climb, and that instruction was wrong on DESIGN 4b(4), which dissolves lower-rung PRODUCTION machinery and never the evidence. The prepared branch acted on it and its annotation argues the claim's RED is no longer authorable even against a hostile fixture. That is false, and DESIGN 4b decides it in the opposite direction: a state unrepresentable in the accepted corpus may still be representable as SOURCE HANDED TO THE COMPILER BY A FIXTURE, and this claim's fixture is exactly that - one module using from, input and transport as a parameter and a let binding. Deleting the keyword lex rules removes the mechanism that could break name usability today; it is not evidence that a later lexer or grammar change cannot reintroduce one. Re-express the control at the right boundary and consolidate it if it duplicates, but keep the obligation enrolled."), on: "2026-09-21", note: "SECOND CORRECTION, and it retracts this row's own citation. The tip cited above as PREPARED WORK does not compile, on its base or on main: dag_grammar_literal_terminal is called twelve times and declared nowhere in it, so resolve refuses with no established callee identity. The earlier claim that it merges current main with zero conflicts is true and was never the question -- a clean merge of source that never compiled is not prepared work, and verifying the merge instead of executing it is the specification-without-execution DESIGN 5 names. What the implementation actually needed, found by running it: the algebra constructor grammar_expr_literal_terminal already exists in v2.std.grammar and only wanted a local wrapper in the file's existing idiom; and seven marker words -- service, operation, input, output, readonly, idempotent, hermetic -- are reserved in the SEED's extdeps.languages.dag.syntax dag_keyword_set, so a caret literal cannot spell them and they are interned from their String spelling by symbol_intern_lexeme, which no keyword rule intercepts. G0 carries no keyword entry for any of them, which is what keeps the name-usability control meaningful rather than vacuous."), on: "2026-09-30", note: "Prepared work: branch session/calm-eagle-42-service-on-literal at tip 80a560dffb01b6fa2cbf3f7cb710e5d8e7f6dcdc.")),
      dispatch: dispatchable(),
      parent: in_project(project: "v2-compiler-live", contribution: "Primitive egress, interpreter cost and self-host admission are what the self-hosted compiler needs before it is the one that runs."),
