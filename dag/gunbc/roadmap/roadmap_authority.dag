    roadmap_node(
      identity: "rn_CREDENTIAL0LIFECYCLE0REVOKE",
      id: "credential-lifecycle-revocation",
      owner: "fleet",
      carriers: carrier(path: "dag/gunbc/auth/privileged_effect_census.dag"),
      line: ticket(t: level_fields(
          headline: "Every service credential can be rotated and revoked, proven by an executed revocation drill",
          boundary: "Issuance, scope, expiry, rotation and revocation for every machine and service credential: reviewer GitHub credentials, R2 publisher and reader identities, host identities, image signing, and customer-facing App credentials. Follows the leasing/grants/privileged-access conformance domain (DESIGN §3b; gunbc.auth.authorization_pattern_selection, gunbc.auth.privileged_effect_census).",
          approach: "DRAFT (operator 2026-10-03): first slice and closing contract pending; members join as implementation-ready tasks are cut.",
          red_control: "A credential with no executed revocation drill is not admitted to a customer-facing path. After revocation, no guest or workload retains access.",
          displaced_cost: "The fleet-wide reviewer 401 on 2026-10-03 froze every landing: a credential nobody could rotate on demand stopped the line, and the same gap exists for every customer-facing identity.",
          handback: "DRAFT: per member, the executed drill or witness named by its instrument."
        )),
      parent: in_project(project: "managed-identity-access-dependencies", contribution: "A service is only as safe as the credentials that reach it; every machine and service credential needs an issuance, scope, expiry, rotation and revocation path, proven by drill."),
    ),
    roadmap_node(
      identity: "rn_FAILURE0BILLING0OUTCOMES0A",
      id: "failure-billing-outcomes",
      owner: "fleet",
      carriers: carrier(path: "dag/gunbc/product/fabric/selection.dag"),
      line: ticket(t: level_fields(
          headline: "Every non-success has a declared billing or credit outcome",
          boundary: "Each typed failure ending of the VM service (placement refusal, host or drive loss, storage outage, compound failure, operator cancellation) maps to exactly one declared billing disposition: no charge, credit, or charged with a named consequence. Commercial amounts stay in the private plan; this node owns the mapping's completeness.",
          approach: "DRAFT (operator 2026-10-03): first slice and closing contract pending; members join as implementation-ready tasks are cut.",
          red_control: "A failure ending with no billing disposition refuses admission of the service path that can produce it.",
          displaced_cost: "Without the mapping, every failure is billed by whoever notices it, and a degraded delivery keeps the premium price: the externalization DESIGN §5 forbids.",
          handback: "DRAFT: per member, the executed drill or witness named by its instrument."
        )),
      parent: in_project(project: "vm-service", contribution: "A customer pays for outcomes; a failure that has no declared billing disposition is externalized degradation (DESIGN §5)."),
    ),
    roadmap_node(
      identity: "rn_SERVICE0EVIDENCE0CAPTURE0A",
      id: "service-evidence-capture",
      owner: "fleet",
      carriers: carrier(path: "dag/gunbc/roadmap/roadmap_service_evidence.dag"),
      line: ticket(t: fields(
          headline: "Capture service evidence from the first qualifying run: usage, cache, placement, failures, recovery, intervention",
          boundary: "From the first qualifying end-to-end run onward, every run's durable records admit a joined receipt on read: workload class and resource request; wait, execution and completion time; cache hits, misses, shared misses and corrupt-hit refusals; placement and seat utilization; artifact bytes and egress; failure attribution and recovery action; operator intervention time; hardware health events; billable usage and credits; workspace recovery point and recovery time. Follows the process observability conformance domain (std.observation). Route acceptance and the dogfood start receipt are owned by factory-dogfood-route (gunbc#13077); this node owns the joined service-evidence fields captured from that route's runs, as one per-attempt receipt computed on read by gunbc.roadmap_service_evidence service_evidence_observe_for_attempt, which consumes the readers that own each fact and measures nothing itself.",
          displaced_cost: "Evidence added late loses the observation period it should have covered, and the dogfood window cannot be backdated.",
          first_slice: "The receipt contract: the attempt bound by its per-attempt LAUNCH RECORD, whose identity names the node and the dashboard instance and whose attempt_key member names the attempt (a legacy record without that member is unbound and refused); one typed input per joined reader gathered once per attempt; and all 21 fields derived from those inputs into one closed product as Observed | Owed | Refused. G5 (gunbc.roadmap_session_placement, landed) is bound: placement, workload class and the granted resource amount are observed from its grant record re-checked against the binding; wait time and seat utilization, which that record does not establish, are owed to this node. Every other field is owed to its reader's change (G3 metering #13073, G1 shared computation #13097, G4 result returned #13075) or to the node that owns its missing producer. Each later slice replaces one reader's not-on-main arm with its typed observation and derives its fields from named members of that record.",
          red_control: "An attempt whose launch record names another node, another dashboard instance or (in its attempt_key member) another attempt, whose launch record carries no attempt_key, or that has no launch record, is not joined; a placement observation that is foreign, unreadable or names another attempt never yields an observed field; an ordered field view that differs from the node's list by identity or order (a duplicate plus an omission at the same count included) is red; a run on the qualifying route whose records admit no receipt is not counted toward the dogfood window.",
          out_of_scope: "Building the producers the receipt names as owed to OTHER nodes (hardware health to fleet-health-0-live-receipt, credits to failure-billing-outcomes, workspace recovery point and time to fabric-storage) -- each is its owning node's work; egress, recovery action and operator intervention time have no other owner and are this node's own later slices; storing the joined receipt (the dogfood start receipt pins it once); pricing.",
          handback: "The module, its witnesses with one discriminating red per refusal, and per slice the reader bound and the fields it moved from owed to observed."
        )),
      dispatch: dispatchable(),
      execution: bound(contract: service_evidence_capture_execution_contract()),
      parent: in_project(project: "vm-service", contribution: "The operator's go/no-go on external customers is their own confidence from dogfooding; that confidence must rest on receipts captured from the first qualifying run, not reconstructed later."),
    ),
    roadmap_node(
      identity: "rn_A9QSP5ZMHYH0WDJR571D78N439",
      id: "contained-development-execution",
      owner: "fleet",
      carriers: carrier(path: "dag/gunbc/roadmap/roadmap_dispatch_actuator.dag"),
      line: ticket(t: level_fields(
          headline: "G0 — Contained development execution: no new autonomous worker/reviewer/auditor/supervisor dispatch until operator home, credentials, privilege groups, control-plane stores and shared state are proven unreachable",
          boundary: "DRAFT portfolio gate: the alignment fields come from the contracts document under operator review.",
          approach: "DRAFT: pending the reviewed contracts document.",
          red_control: "Not ready: a portfolio gate carries no dispatch facts; it is lifted only by the operator on proof that the named state is unreachable.",
          displaced_cost: "DRAFT: pending the reviewed contracts document.",
          handback: "DRAFT: pending the reviewed contracts document."
        )),
      parent: in_project(project: "managed-identity-access-dependencies", contribution: "The portfolio gate (G0) this milestone holds: autonomous dispatch stays contained until the operator's home, credentials, privilege groups, control-plane stores and shared state are proven unreachable."),
    ),
    roadmap_node(
      identity: "rn_GPNBAHVJ425GYW8DEWBD26144B",
      id: "ci-cost-floor-memory-term-attribution",
      owner: "ci-cost",
      carriers: carrier(path: "docs/plans/floor-memory-envelope-2026-09-12.md"),
      line: ticket(t: fields(
        headline: "Attribute the floor's memory to the terms that hold it, starting with pool_parse",
        boundary: "Give the existing per-term retention machinery a byte-measuring driver. v1_compiler.cli_run drop_attributable_terms_for_test and drop_private_term_for_test already state that the live-heap release measured across a call is that term's EXCLUSIVE retention, and already enumerate the terms -- pool_parse among them -- with NO driver and a single unit-test caller counting entries. A TIME accumulator for the same term exists in claim_batch's cost partition; only the memory side is missing. Read the term roster from those two declarations rather than from a count quoted here.",
        displaced_cost: "The floor's largest memory component cannot be named. First-touch attribution puts pool_parse's bytes on gate-closure or the whole-corpus resolve, and pool-root-index-warm reports zero growth because something upstream forced the parse first -- so the one number that would rank the work is the one nobody can produce. A cap or a slot sized without it is sized against an unattributed total.",
        first_slice: "Wire a driver to the existing terms and report pool_parse. The machinery is three-quarters built; this is a driver, not a model.",
        red_control: "A term whose retention the driver cannot measure REFUSES rather than reporting zero -- zero and unmeasured are the conflation this lane exists to prevent, and it is the same distinction the landed floor-memory carrier draws between a bound and a demand.",
        out_of_scope: "Re-measuring the whole-run peak, which the landed instrument already does; and fixing the floor's inability to report its own peak, which is a separate defect recorded below.",
        handback: "The driver, a pool_parse byte figure re-derivable by naming its producer, and a refusal receipt for a term it cannot measure. RELATED AND DELIBERATELY NOT BUNDLED: floor_cgroup_envelope is documented as emitted at entry AND EXIT and has no exit call, so a run outside the supervisor cannot report its maximum. If that is fixed it must be an RAII GUARD rather than a placed call, and the reason is countable in v1_compiler.cli_run run_required_floor rather than quotable from here: its early-return and propagation sites vastly outnumber its explicit successful returns, so a placed call is unreachable on most paths."
      )),
      dispatch: dispatchable(),
      parent: in_project(project: "ci-end-to-end-execution", contribution: "The required run is the factory verification half; a gap in what it counts, bills or reports is a gap in every landing it gates."),
    ),
    roadmap_node(
      identity: "rn_K6EVN9SKS7WV617GECTH3N2TPQ",
      id: "ci-cost-floor-preparation-cut",
      owner: "ci-cost",
      carriers: carrier(path: "docs/design-rung-drops.md"),
      line: ticket(t: fields(
        headline: "Make the floor affordable enough to be a merge gate again",
        boundary: "Cut the required fold's PREPARATION cost until the floor fits the fleet, then put it back on the merge path. THE CLAIMS WERE NEVER THE EXPENSE -- claim execution is a small fraction of the floor's wall time while strict-preparation and reach probes dominate it. Re-derive that split from the phase lines a required-witnesses-floor run prints (gunbc.witness_floor_workflow); THAT NO ENTRY POINT RE-DERIVES IT IS PART OF WHAT THIS NODE FIXES, which is why no figure is carried here. The two candidate constructions are reusing resolved-module and reach-probe results across runs, or scoping preparation to a diff's closure.",
        displaced_cost: "The required gate is currently a compiler build. The witness floor, namespace-wave-admission, generated-artifact, the regen fixed point and the parse sweep all left the merge path, so main can break for any of them while every required check stays green -- which it already has, within three hours of the cut. Every session pays that risk on every change.",
        first_slice: "Measure where preparation time goes at module grain, then land whichever of the two constructions the measurement supports. Restoring the gate is the second step and not this one.",
        red_control: "A change that breaks a floor claim is refused on the revision that lands, at a whole-run cost the fleet can carry concurrently with the build lane.",
        out_of_scope: "Re-emitting witnesses.yml from the old authority without the preparation repair, which restores the cost that caused the cut; and making the floor faster without returning it to the merge path.",
        handback: "The preparation measurement WITH AN ENTRY POINT THAT RE-DERIVES IT rather than a figure quoted from a log, the landed construction, a required run that planned and executed the enrolled population on a landing revision, and the retirement of gunbc.rung_drop witness_floor_off_the_required_gate."
      )),
      dispatch: dispatchable(),
      parent: in_project(project: "ci-end-to-end-execution", contribution: "The required run is the factory verification half; a gap in what it counts, bills or reports is a gap in every landing it gates."),
    ),
    roadmap_node(
      identity: "rn_B5WDFV02PYSHAYM68VKGVMGZW2",
      id: "ci-control-namespace-admission-billing",
      owner: "ci-control",
      carriers: carrier(path: "docs/design-rung-drops.md"),
      line: ticket(t: fields(
        headline: "Charge a transition-admission row to the change that owns it, and enforce it when the change lands",
        boundary: "Both halves and no smaller set, as the drop's own trigger states. One: adjudicate a row's consumption and deletion debt on the composition of the change that OWNS the row, so a merge_group run over bystanders cannot refuse on a row it did not touch. Two: run that adjudication on the composition that actually lands, so a base-consumed row is observed then rather than whenever the roster is next touched.",
        displaced_cost: "Getting the billing wrong in either direction has now been measured twice. Charging bystanders cost a large and recurring share of fleet time per queued pull request before refusal -- the figure and its reading are carried by the operator ruling recorded on gunbc#11774, which priced the gate and deleted it -- with ten open changes each independently deleting one stale row; removing the charge entirely left the wall unable to fire at all, and the wall was then deleted.",
        first_slice: "The ownership half, since it is what makes the enforcement half safe to run at landing time.",
        red_control: "A discriminating RED for each half on the real acceptance path: a bystander change is NOT refused by a row it does not own, and a change that consumes a row without deleting it IS refused on the revision that lands.",
        out_of_scope: "Re-enrolling the phase without the billing repair, which reproduces the cost that caused the deletion.",
        handback: "Both halves executing with their reds enrolled, the phase re-enrolled, and the retirement of gunbc.rung_drop namespace_wave_admission_wall_removed."
      )),
      dispatch: dispatchable(),
      parent: in_project(project: "ci-end-to-end-execution", contribution: "The required run is the factory verification half; a gap in what it counts, bills or reports is a gap in every landing it gates."),
    ),
    roadmap_node(
      identity: "rn_P4WR8PZ5D6W4TMR1RZ7G87416F",
      id: "namespace-reference-derived-producer-bounded",
      owner: "namespace",
      carriers: carrier(path: "docs/plans/namespace-cut-replacement-plan.md"),
      line: ticket(t: fields(
        headline: "Give the reference-derived graph producer a bounded realization",
        boundary: "Rewrite the producer so it retains only what its consumers demand. The demand was measured and it is a NAME TABLE, not a syntax population: every lookup the edge fold makes of the index discards the Node, the one genuine Node demand is an equality discriminant in index construction that a per-key digest supplies, and trees is read at one site for the importer's own root.",
        displaced_cost: "The producer holds the whole corpus in memory to answer questions that need a name table, and it sits upstream of the namespace cut. Its residency is a standing cost on every consumer that resolves through it.",
        first_slice: "TWO GATES IN ORDER, and the second is easy to miss: gunbc#11683 owns src/v2/lens/module_graph.dag, so racing it produces a conflict someone else pays for; and gunbc#11574 (type and data decls never become Named edges) blocks wiring the derivation to the producer's own declaration, because a TYPE declaration cannot be resolved from a live tree today. The qualification instrument any bounded-realization claim must pass has already landed and is unmintable from a semantic receipt alone.",
        red_control: "Identical edge projection over the corpus before and after, plus the landed residency qualification passing on the rewritten producer rather than on a semantic receipt.",
        out_of_scope: "Editing module_graph.dag while gunbc#11683 is open; and claiming bounded realization from the semantic receipt, which the qualification instrument exists to refuse.",
        handback: "The rewritten producer, the before/after edge-projection equivalence evidence, and the qualification passing by invocation. A FALSIFIABLE PREDICTION IS ON RECORD RATHER THAN A BYTE FIGURE, because none was measured: run the census-resolve contrast of gunbc#11738 against this producer and the gap should be dominated by SymbolIndex.entries and ReferenceDerivedPool.trees rather than by the parse. Test it; do not inherit it."
      )),
      dispatch: dispatchable(),
      parent: in_project(project: "namespace-unique-on-chain", contribution: "Name resolution is unique on the chain only when imports bind and producers are bounded; this row closes one of those gaps."),
    ),
    roadmap_node(
      identity: "rn_5NTJP2XWCB7QVK0HDRM8FZ4136",
      id: "boot-probe-must-not-read-a-bare-124-as-a-deadline",
      owner: "fleet",
      carriers: carrier(path: "dag/gunbc/runner/runner_microvm.dag"),
      line: ticket(t: fields(
        headline: "A micro-VM boot that exits 124 for its own reasons must not be reported as a deadline that fired",
        boundary: "gunbc.runner_microvm_boot_probe boot_probe_verdict reads a bare exit status and returns BootExceededHostDeadline, and boot_probe_verdict_text renders a deadline sentence with a duration nobody observed, discarding the cause BootVmmFailed exists to carry. The repair is the capability the landed failure-mode row declares as its trigger: a typed execution-bound observation emitted at the deadline-enforcement decision and carried to the classifier.",
        displaced_cost: "The two events are indistinguishable by exit status alone, and the pair is re-derived by running `timeout --kill-after=1s 5s sh -c 'exit 124'` (forwarded child status, no expiry) beside `timeout --kill-after=1s 0.1s sleep 2` (expiry) and comparing their statuses, which agree. The discriminating facts and this pair are carried by the failure-mode row gunbc.recurring_failure_mode.bare_exit_124_read_as_an_observed_timeout_event, which is the authority for this class. Contained today only because boot_probe_admitted refuses both verdicts, so the defect is a wrong explanation rather than a silenced failure; that containment belongs to this consumer and evaporates under any consumer that exempts a timeout from blocking.",
        first_slice: "The observation emitted where the bound is imposed, for one bounded invocation.",
        red_control: "A child exiting 124 without the bound firing is not reported as a deadline; a real expiry still is.",
        out_of_scope: "No 124 arm keyed on the bare exit status anywhere, and no wall-clock reading substituted for the observation; the withdrawn floor classifier must not be re-attempted (the floor path has no GNU timeout producer, so its only reachable 124 is a subject's own).",
        handback: "The typed observation reaching the verdict, with the two 124 events distinguished by it."
      )),
      dispatch: dispatchable(),
      parent: in_project(project: "microvm-runtime-durable-state", contribution: "A micro-VM boot verdict is the runtime layer: a misread exit code is a wrong runtime fact."),
    ),
    roadmap_node(
      identity: "rn_9HVXR4CBM0KT2WPND7FJ3QZY85",
      id: "claim-entry-resolution-population",
      owner: "ci-control",
      carriers: carrier(path: "src/v2/workflow/required_floor.dag"),
      line: ticket(t: fields(
        headline: "Count and close the claim entries that cannot execute under any driver",
        boundary: "Two populations, reported separately because they have different owners: entries whose closure is incomplete (registry rows absent), and entries that do not typecheck at all. A census over dag/test/claim under claim_batch, at identity grain, with member lists.",
        displaced_cost: "The populations are produced by running `claim_batch --entry <entry>` over every entry under dag/test/claim and partitioning the failures on whether the run reports registry-row-absent causes; a partial run in that shape found members of both, the second including production modules such as dag/std/algebra.dag and dag/std/effect_axes.dag. The counts belong to the run that produces them and are not restated here, because a partial scan in sorted path order is a lower bound rather than a rate. The required floor is green over all of them, because an entry that fails to resolve is indistinguishable at the floor from one never selected.",
        first_slice: "The complete census with both member lists and both counts.",
        red_control: "An entry that cannot resolve is reported as unexecuted rather than passing silently; a production module that does not typecheck is named.",
        out_of_scope: "No weakening or deletion of any claim to make it resolve; the import-binding repair is its own row.",
        handback: "Both counts, both member lists, and the disposition of each population."
      )),
      dispatch: dispatchable(),
      parent: in_project(project: "ci-end-to-end-execution", contribution: "The required run is the factory verification half; a gap in what it counts, bills or reports is a gap in every landing it gates."),
    ),
    roadmap_node(
      identity: "rn_6BFLC3WQZ8NKX1VTDR5HJMP902",
      id: "compiler-import-list-binds",
      owner: "namespace",
      carriers: carrier(path: "src/v2/compiler/03_name_resolve.dag"),
      line: ticket(t: fields(
        headline: "Decide whether a .dag import list binds, and make the answer enforceable",
        boundary: "Name resolution builds its symbol index from a tree-wide census, while the compiled population is the declared-import closure. Their reconciliation (the bare-reference pull) is short-circuited for any file that declares at least one import, so such a file silently gets no bare edges. Two candidate repairs: make the import list BIND and refuse a name resolving outside it, or complete the reconciliation for every file.",
        displaced_cost: "The discriminating experiment is a flip control: rebuild the host with source_declares_import_lines removed at both call sites, then run `claim_batch --entry dag/test/claim/ci/ci_failure_class_witness_test.dag` against it and against an unmodified build, and compare whether the entry resolves at all. The cost of the alternative is read the same way, by comparing closure membership per entry across the two builds rather than by citing a remembered total; it charges every already-correct entry, not only the failing ones. The transition scope of the binding repair is the population of files that resolve a name outside their declared imports, which the same instrument enumerates.",
        first_slice: "The operator decision between the two repairs, then the chosen one behind a declared bounded transition.",
        red_control: "The control is conditional on the policy chosen, because the decision is the operator's and a control that names one answer takes it. Under strict-import binding, a reference resolving outside the declared import closure refuses with its file and name located. Under complete reconciliation, a permitted bare dependency enters the compiled population and participates in the existing effect-summary checks. NEITHER policy may accept a resolved dependency that is absent from the population actually compiled -- that agreement is the invariant both answers owe. Retain the flip control as the instrument that distinguishes them.",
        out_of_scope: "No witness edits to route around the loader; the effect-summary join that currently notices this is CORRECT and must not be made quieter.",
        handback: "The chosen repair with its transition population named, and the flip control retained as the regression probe."
      )),
      dispatch: dispatchable(),
      parent: in_project(project: "namespace-unique-on-chain", contribution: "Name resolution is unique on the chain only when imports bind and producers are bounded; this row closes one of those gaps."),
    ),
    roadmap_node(
      identity: "rn_Z4Z5N3JJ9M8D6XBGHFV5HQHJMY",
      id: "test-reference-discipline-remainder",
      owner: "ci-control",
      carriers: carrier(path: "src/v1/compile.dag"),
      line: ticket(t: updated(t: fields(
        headline: "Finish the test-reference discipline: its own evidence onto the gate, and the ledger to zero",
        boundary: "The v1 and v2 test-reference walls are landed; what remains is around them. (1) Pay down test_reference_debt (equality budget at module, referrer, target) by deleting each reference with its row. (2) Put the v1 wall's discriminating reds (test.claim.test_reference_wall_witness) on a required_gate_prefixes entry; today they run nowhere on the merge path. (3) Enforce the v2 wall corpus-wide: no required lane compiles the corpus through v2 name resolution; this waits on the native route. (4) Close two instrument gaps: warm-roster admission does not execute in the restored floor, and a producer's emission (labels included) cannot be cheaply read.",
        displaced_cost: "A wall whose own red executes nowhere is the inflation DESIGN 4b(1) names: the class reports mechanically-preventable while nothing would catch its regression. The ledger is that debt in the other direction -- every CorpusDebtRow is a live reference someone must eventually delete, while the FixtureControlRow is not debt at all -- it admits nothing and exists to keep the paid-down arm discriminating, and while rows stand the corpus keeps teaching the pattern the wall exists to end. The instrument gaps are why several of these rounds cost four passes each: an unmeasured cache row and a hand-reconstructed fixture are both cheap to write and expensive to disprove.",
        first_slice: "One prefix line so the v1 wall's reds execute on the gate, then the rows the landed PRs already made deletable.",
        red_control: "A test calling a test refuses on the required lane and not only locally; a real source carrying a test-fn reference reaches v2 name resolution through a required corpus route and refuses THERE, not only at the interface; deleting a reference without its ledger row refuses; a ledger row whose module is gone refuses when the census is loaded; and at close, test_reference_debt contains ZERO CorpusDebtRow entries while the FixtureControlRow remains as the discriminating control.",
        out_of_scope: "No re-enrolment of the cache rows deleted while landing this work without a controlled row-present against row-absent experiment on one host -- portability establishes that a value CAN be served, never that serving beats recomputing. No widening of the wall to shapes v1 inference cannot see: a function value reached through an import-all types as LocalValueBinding, and that is a declared gap rather than a silent one.",
        handback: "The prefix landed with its reds observed executing on a required run; the v2 corpus route either carrying a refusal for a real test-fn reference or that obligation transferred BY NAME to the node owning the native route; test_reference_debt carrying zero corpus-debt rows, or that remainder transferred BY NAME to a successor node and this node's headline narrowed accordingly; and the two instrument gaps either closed or written down as their own rows."
      ), on: "2026-09-24", note: "The brief before the 100-word re-cut, verbatim (obligations kept in the brief, context here): The walls themselves are landed -- v1 IDENTIFIES every test reference its typed frontier can see (a call from anywhere including another test, a function value, a parameter default, a named import) and refuses any that the shrink-only debt ledger does not exactly cover -- a reference matching a surviving row is ADMITTED, as a temporary admission awaiting deletion, not permitted; v2 refuses at name resolution. That frontier is not the whole language: out_of_scope names the import-all function value v1 inference cannot see. What remains is around them. THE LEDGER: test_reference_debt carries the surviving corpus rows plus one fixture control, an equality budget at (module, referrer, target) refusing in BOTH directions, so a row is paid down only by deleting the reference and its row together. THE EVIDENCE GAP: the v1 wall's discriminating reds live in test.claim.test_reference_wall_witness, which matches no entry in v2.workflow.required_floor required_gate_prefixes, so they execute nowhere on the merge path while every other gated class runs; the loss is covered generically by gunbc.rung_drop witness_floor_off_the_required_gate rather than specifically. THE V2 WALL'S COVERAGE IS NARROWER THAN ITS NAME: its refusal is established by execution AT THE INTERFACE, on supplied roots plus two route claims, and NO required lane compiles the corpus through v2 name resolution -- so a real test-fn reference in the tree does not red it, which is how one survived until a reviewer read for it. Corpus-wide v2 enforcement waits on the native route. TWO INSTRUMENT GAPS found while landing the four PRs: the warm-roster admission instrument does not execute in the restored floor -- a row naming a declaration that no longer existed passed green, though the roster's own rule says an unresolvable row stops preparation -- and there is no cheap way to read what a producer actually emits, labels included, which is what let a supplied fixture diverge silently until its pairing claim went red.")),
      dispatch: dispatchable(),
      execution: bound(contract: gunbc_claim_execution_contract(
        entry: "dag/test/claim/closing/test_reference_discipline_remainder_closing_contract_witness_test.dag" as FilePath,
        function: "test_reference_discipline_remainder_closing_contract_holds" as NonEmptyStr,
      )),
      parent: in_project(project: "ci-end-to-end-execution", contribution: "The required run is the factory verification half; a gap in what it counts, bills or reports is a gap in every landing it gates."),
    ),
    roadmap_node(
      identity: "rn_Z3FS3HMD5WWH1Z7FGPK1KAWJBM",
      id: "fleet-health-0-live-receipt",
      owner: "fleet",
      carriers: carrier(path: "dag/gunbc/fleet/fleet_health.dag"),
      line: TicketLine { done: false, ticket: fields(
        headline: "HEALTH-0 is built and green; it needs one live run under the qualified realization to leave draft",
        boundary: "gunbc.fleet_health fleet_health_check is an out-of-band, read-only, goal-blind check over fleet_intent_known_hosts: firmware-derived telemetry surface, five sampled fan/temperature windows, an event-log window with wrap/clear continuity, assessment over std.goal_assessment, and a receipt whose first line discloses the evaluation realization. gunbc#11681 carries it with 29 passing witnesses, including a call-reachability wall that no mutation is reachable from the entry. What remains is one live run under GUNBC_EVAL_MEMO=0 whose receipt matches the current code, and attaching it to the PR.",
        displaced_cost: "Three real conditions were found by the first live run and nothing else in the repository observes them: srv1 FAN4 rotating in 1 of 5 samples and FAN5 in 2 of 5, srv2 FAN5 in 2 of 5, srv3 logging 14 corrected memory errors and DIMM_HOT in a single half-hour window, srv4 DIMM_HOT on two channels. Until the check runs on a cadence those degrade unobserved.",
        first_slice: "One live fleet_health_check run against srv1-srv4 with an operator access token, its receipt attached to gunbc#11681, and the PR flipped out of draft.",
        red_control: "The enrolled fixture's bare-call mutations are found by the same reachability derivation that reports the health closure clean; a service-call mutation is asserted INVISIBLE so the claim fails when the instrument gains service-call identity.",
        out_of_scope: "Admitted baselines (HEALTH-1) and serving admission (HEALTH-2) are their own rows. No in-band fallback for any signal the BMC does not expose.",
        handback: "A merged gunbc#11681 with a live receipt in its body, and gunbc#11696 landed after it to delete the consumed namespace admission rows."
      ) },
      parent: in_project(project: "fabric-application-authority", contribution: "The fabric decides placement from observed fleet facts; fleet health, convergence and hardware observation are those facts."),
    ),
    roadmap_node(
      identity: "rn_TD7X82087026JR4X3XKSHAT7Z6",
      id: "fleet-health-1-admitted-baselines",
      owner: "fleet",
      carriers: carrier(path: "dag/gunbc/product/host_health.dag"),
      line: TicketLine { done: false, ticket: fields(
        headline: "Health baselines: tell new errors from history without letting a divergent run rebaseline itself",
        boundary: "product.host_health already takes HostHealthBaselineBasis as an input seam and answers NoPriorBaseline today. This selects the last ADMITTED or explicitly dispositioned receipt, verifies subject, counter epoch and evidence manifest before subtracting, and makes diagnosis or operator disposition the only route to a replacement baseline.",
        displaced_cost: "Without it every host with any history stays indeterminate forever: srv3 and srv4 carry 1200-entry event logs that can never be dispositioned, so the check can report change but never quiet. The automatic-rebaseline trap is the specific harm: run A sees a new corrected error, run B takes A as its baseline, and the unresolved error disappears after one cycle.",
        first_slice: "Durable receipt selection plus the refusal that a divergent observation may not mint a baseline, with the four counter-window cases already witnessed re-expressed against a stored receipt.",
        red_control: "A divergent run cannot produce an admissible baseline; a baseline for another host, another counter epoch or another endpoint set refuses; history that was never dispositioned stays an unknown rather than becoming zero.",
        out_of_scope: "Serving admission consumption. Any new cache or store beyond the receipt the check already writes.",
        handback: "A health run that reports new-since-last-admitted for memory counters and event records, with the rebaseline refusal witnessed."
      ) },
      parent: in_project(project: "fabric-application-authority", contribution: "The fabric decides placement from observed fleet facts; fleet health, convergence and hardware observation are those facts."),
    ),
    roadmap_node(
      identity: "rn_YWBBMCMY5FHC2Q5VCX9AA8MA46",
      id: "fleet-health-2-serving-admission",
      owner: "fleet",
      carriers: carrier(path: "dag/gunbc/product/host_health.dag"),
      line: TicketLine { done: false, ticket: fields(
        headline: "A host serves only on a fresh satisfied health receipt",
        boundary: "Serving admission consumes the health inspection and the convergence standing as a product: same host identity, expected fleet and policy revisions, satisfied assessment, freshness, window continuity, and where required a health window opened after a named apply receipt. Unknown health denies new placement without pretending an emergency shutdown was authorized.",
        displaced_cost: "Health that nothing consumes is a report nobody is obliged to read. Today a host with a dead fan or new uncorrected errors is as admissible for work as a clean one.",
        first_slice: "New-host admission requires a fresh satisfied receipt; previously serving hosts with divergence become drain candidates.",
        red_control: "A stale receipt, a receipt for another host, and an indeterminate assessment each deny admission; a satisfied fresh receipt admits.",
        out_of_scope: "Automatic workload kill, reboot or repair from the health route.",
        handback: "Admission consuming health, with the deny arms witnessed."
      ) },
      parent: in_project(project: "fabric-application-authority", contribution: "The fabric decides placement from observed fleet facts; fleet health, convergence and hardware observation are those facts."),
    ),
    roadmap_node(
      identity: "rn_FH7X3QWQJ14MVMN9ES41C4HNZ6",
      id: "srv1-srv2-bmc-firmware-exposes-memory-errors",
      owner: "fleet",
      carriers: carrier(path: "dag/gunbc/fleet/fleet_health.dag"),
      line: TicketLine { done: false, ticket: fields(
        headline: "srv1 and srv2 cannot report memory errors out of band on firmware 2.07",
        boundary: "Both hosts run the ASRock 2.07 image: no MemoryMetrics resource and an empty Redfish event log, so the out-of-band check is structurally unable to see memory errors there. srv3 and srv4 on OpenBMC 3.22 do report them as MemoryECCCorrectable records. The work is the flash and its qualification, not a health-side workaround.",
        displaced_cost: "srv1 has recorded 255 corrected memory errors in-band since its August boot with all of them unattributed to a DIMM; out of band the health check must report that host unknown on memory indefinitely. Two of four hosts are unobservable on the signal most likely to precede a failure.",
        first_slice: "Qualify the 3.22 image on one of the two hosts through the existing BMC firmware route, then confirm the health check reports memory events for it.",
        red_control: "After the flash, a health run reports the host's memory signal as observed rather than not-exposed-out-of-band.",
        out_of_scope: "Any in-band EDAC read as a substitute. The standing rule is out-of-band only.",
        handback: "Both hosts on an image whose event log carries memory records, with a health receipt showing the signal observed."
      ) },
      parent: in_project(project: "fabric-application-authority", contribution: "The fabric decides placement from observed fleet facts; fleet health, convergence and hardware observation are those facts."),
    ),
    roadmap_node(
      identity: "rn_W1PKZZXFM2CS3TKAXDG59PD29S",
      id: "srv3-srv4-fan-threshold-flapping-floods-the-event-log",
      owner: "fleet",
      carriers: carrier(path: "dag/gunbc/bmc/bmc_fan_converge.dag"),
      line: TicketLine { done: false, ticket: fields(
        headline: "Fan threshold flapping overwrites the BMC event log within hours",
        boundary: "srv3 and srv4 log a FAN threshold assert/deassert pair repeatedly: 982 of srv3's 1200 entries on 2026-09-18 were one fan's deassert, and the log wraps at about 1200, so entries roll off in hours. Either the fan curve or the thresholds are wrong for these chassis. gunbc.bmc_fan_converge already owns fan policy.",
        displaced_cost: "Event-log continuity is the health check's only out-of-band route to memory errors, and it survives only over windows shorter than the wrap. Every memory record older than a few hours is already lost on those two hosts.",
        first_slice: "Establish whether the flapping fan is below its own threshold because the threshold is wrong or because the fan is failing, then converge whichever is wrong.",
        red_control: "After the change, an event log read twice a day apart still contains its earlier newest entry.",
        out_of_scope: "Raising the health check's sampling rate as a substitute for fixing the flapping.",
        handback: "A log whose wrap horizon exceeds the health cadence, and a fan policy that stops asserting."
      ) },
      parent: in_project(project: "fabric-application-authority", contribution: "The fabric decides placement from observed fleet facts; fleet health, convergence and hardware observation are those facts."),
    ),
    roadmap_node(
      identity: "rn_H1TH1ZJTFQNC5G2Q7YHJ7RMZZF",
      id: "dimm-temperature-limits-need-a-citation",
      owner: "fleet",
      carriers: carrier(path: "dag/gunbc/product/host_health.dag"),
      line: TicketLine { done: false, ticket: fields(
        headline: "No temperature limit is cited, so every sensor reads unestablished",
        boundary: "product.host_health carries TemperatureLimit with its authority as a field and refuses to invent one; the fleet goal declares all twenty board sensors with TemperatureLimitUnestablished. The work is citing limits for the DIMM parts and the board sensors that have them, per component grade, so the check can judge a reading rather than only carry the BMC's verdict.",
        displaced_cost: "srv1 DIMM C1 was read at 99 C with the BMC reporting OK, because the BMC carries only a 105 C critical line and no caution threshold. srv3 and srv4 assert DIMM_HOT. Nothing in the corpus can say whether those readings are acceptable.",
        first_slice: "Cite the JEDEC or vendor limit for the installed DDR4 parts and bind it to the DIMM sensors, leaving the rest unestablished rather than guessed.",
        red_control: "A sensor above its cited limit diverges; a sensor whose limit is uncited still cannot produce a green.",
        out_of_scope: "Fleet-wide default limits. An uncited number is refused by construction.",
        handback: "Cited limits on the sensors that have them, with the citation on the row."
      ) },
      parent: in_project(project: "fabric-application-authority", contribution: "The fabric decides placement from observed fleet facts; fleet health, convergence and hardware observation are those facts."),
    ),
    roadmap_node(
      identity: "rn_NBX7Z3E7CSV0JBT611DGGXG1AD",
      id: "eval-memo-admission-rewire-program",
      owner: "self-host",
      carriers: carrier(path: "dag/gunbc/recurring_failure_mode/memo_key_rehashes_a_growing_persistent_value.dag"),
      line: TicketLine { done: false, ticket: updated(
        t: updated(
          t: fields(
        headline: "The seed keys every pure call before admission; the rewires that make retirement landable",
        boundary: "The seed's eval-frame result memo keys every pure call before any admission decision, so a single-demand call pays full key construction -- and a key over a string argument is O(size), which makes any recursive fold over a document quadratic. The repair is root-first (option A): the demand and materialization judgment is consulted BEFORE result-memo key construction, and the shared producers the memo was concealing are rewired to carry their established value rather than re-derive it. Retirement of the provider is qualified on the repaired corpus as one combined cutover, never landed while the required floor is red.",
        displaced_cost: "JSON parsing is O(n squared) because every pure call re-hashes its whole string argument, so the cost of parsing a document grows with the square of its size and the same shape taxes every text-processing route under the interpreter. The shape is re-derived by running any large-document parse under the seed with the result memo enabled and again with GUNBC_EVAL_MEMO=0, which is the paired arm that shows the quadratic is the memo key and not the parse; the corpus-wide effect of removing it is re-derived by the required floor run's own per-claim eval-step and completion reporting, which stage 2 gunbc#11835 moved.",
        first_slice: "Land stages 1 and 2, then stage 3, each with per-claim before/after under both realizations and no claim crossing its ceiling on the memo-on path the floor runs today.",
        red_control: "A direct-recompute demand reaches neither key construction nor memo storage, with a control that fails when unconditional keying is restored; every stage keeps the floor population and terminal results unchanged.",
        out_of_scope: "A pointer-hash string cache, a function-name allowlist, a roster memo dressed as declared recurrence, and any global memo-default flip without consumer-wide qualification -- all refused by ruling.",
        handback: "The shared producers rewired, and retirement re-qualified on the repaired corpus as one combined cutover with the required floor green."
          ),
          on: "2026-09-20",
          note: "Status at wind-down: stage 1 gunbc#11784 (integer decode reads carried tables) and stage 2 gunbc#11835 (grammar backward selection resolves each emitted tree once) are green, approved and awaiting merge; the retirement gunbc#11741 is a held draft carrying its own handback; stage 3 (rust.dag's 64 nullary Node constants as data) is drafted, resolves and passes, and is preserved unopened at origin/session/merry-fox-260-stage3 c1c925060c with its nine-module comparison unfinished. Stage 2 also discharged the docs-regeneration blocker: the real regen route was run end to end on the memo-retired binary and completed with byte-identical projections, which is the check to repeat (the generated-artifact gate's own regen entry point) before the retirement is qualified.",
        ),
        on: "2026-09-20",
        note: "Four readings this lane took, each recorded with the producer that re-derives it rather than with its number, so a successor re-runs the instrument instead of trusting a figure that has rotted. Producer ranking must come from the required floor run's own required_floor_cross_claim_demand.tsv (evals minus claims), never from claim_batch, which installs no cross-claim roster and therefore charges producers the floor serves warm -- the lane's first ranking was wrong for exactly this reason. The diagnostics_merge repeat count that first looked like hot work is memo-hit verification cost instead, and what separates the two is the interpreter's own memo key trace (its keyed-call, distinct-key and duplicated-key counters), which is the instrument to re-run before treating any repeat count as work. The comparison between a bottom-up grammar resolution that matches all productions per node and the asked-lhs top-down form is re-derived by the bounded A/B harness gunbc#11835 carries, which measures both shapes on the memo-on path; the top-down form won. And claim_batch shares one ctx per entry, so a data row's first-touch cost lands on whichever claim runs first, which makes its per-claim comparisons unsound as a cost instrument regardless of what they report.",
      ) },
      parent: in_project(project: "v2-compiler-live", contribution: "Primitive egress, interpreter cost and self-host admission are what the self-hosted compiler needs before it is the one that runs."),
    ),
    roadmap_node(
      identity: "rn_2CB9RP256VFYH7KM4NXQ8WDT3A",
      id: "v1-interpreter-p256-verify-cost-shape",
      owner: "self-host",
      carriers: carrier(path: "dag/extdeps/crypto/nist_p256.dag"),
      line: ticket(t: updated(t: fields(
        headline: "Find why one interpreted P-256 verification costs 13.5 GiB and minutes, and remove the cost shape rather than the workload",
        boundary: "Receipt gunbc#11645: one interpreted p256_ecdsa_verify_octets takes gigabytes resident and minutes, so the required floor budget-refuses all eight members of test.claim.p256_dag_ecdsa_witness_test and the interpreted approval broker cannot verify a signature, assertion or attestation chain in usable time. A 256-bit verification is a few thousand field multiplications (std.bignat Montgomery multiplication, the extdeps.crypto.nist_p256 ladder), so this is a cost-shape defect in how the interpreter realizes those folds (DESIGN section 6), not a workload property. The instrument is claim_batch --hermetic --entry dag/test/claim/p256_dag_ecdsa_witness_test.dag --functions the_rfc6979_sample_signature_verifies, read by its [witness] line and VmHWM.",
        displaced_cost: "Every interpreted consumer of std.bignat pays it: the approval device routes (four ECDSA verifications per phone approval), the App Attest chain (two P-384 verifications per enrolment), and any future big-integer fold. Until the shape is found, the approval broker's device routes have no execution route except the native emission that #11819 gates, and the floor cannot enroll the eight P-256 witnesses at all.",
        first_slice: "Re-derive the slice (DESIGN section 6b): what one montgomery_mul allocates and retains in the interpreter, whether the memo or the List<Int> limb representation is what pins memory, and which link is the earliest unjustified boundary -- before any cache, batch or knob is proposed at the symptom link.",
        red_control: "The eight P-256 witnesses executing to a terminal verdict inside the floor's per-claim budget, with VmHWM read from the same run, and the RFC 6979 and Wycheproof refusal members still refusing.",
        out_of_scope: "No host-Rust verification primitive (operator refusal on #11588/#11592 stands); no widening of the floor budget to admit the current cost; no change to the P-256 arithmetic's semantics -- the vectors are the oracle.",
        handback: "The named boundary and its repair, the eight witnesses enrolled and green in the floor, and the [witness] eval-step and VmHWM readings beside the #11645 figures they replace."
      ), on: "2026-09-21", note: "The brief before the 100-word re-cut, verbatim (obligations kept in the brief, context here): The receipt is gunbc#11645: one interpreted p256_ecdsa_verify_octets peaks at 13.5 GiB resident (VmHWM 14,132,132 kB) and takes 192 s to 734 s depending on host residency, so the required floor budget-refuses all eight members of test.claim.p256_dag_ecdsa_witness_test and the interpreted approval broker cannot verify a device signature, an App Attest assertion or an attestation chain in usable time. The arithmetic is std.bignat Montgomery multiplication over limb lists and the double-scalar ladder in extdeps.crypto.nist_p256; a 256-bit verification is a few thousand field multiplications, so a resident set in the tens of gigabytes is a cost-shape defect in how the interpreter realizes those folds (DESIGN section 6, bare minimum cost), not a property of the workload. The instrument that re-derives the figure is `claim_batch --source-root dag --source-root src/v2 --hermetic --entry dag/test/claim/p256_dag_ecdsa_witness_test.dag --functions the_rfc6979_sample_signature_verifies` read by its [witness] line and the process VmHWM; no number in this row is authoritative over that run. This is the B arm of the 2026-09-21 approval-app decision (parent ruling on msg_4d665941): filed for the v1-performance program, NOT started by the approval lane, whose terminal shape is the natively emitted verifier bound as one realization handler of the extdeps.crypto.signature and extdeps.apple.app_attest seams once MachineWidth<N> reification lands.")),
      dispatch: dispatchable(),
      parent: in_project(project: "v2-compiler-live", contribution: "Primitive egress, interpreter cost and self-host admission are what the self-hosted compiler needs before it is the one that runs."),
    ),
    roadmap_node(
      identity: "rn_7CMXV1QBZ4KTPN9HDRJF08SW6",
      id: "fleet-assessment-build-provenance-join",
      owner: "fleet",
      carriers: carrier(path: "dag/gunbc/runner/runner_slot_retirement.dag"),
      line: ticket(t: fields(
        headline: "Bind the binary that ran a retirement assessment to the revision the assessment claims",
        boundary: "The assessment already corroborates the checked-out revision and refuses on disagreement; what is missing is that the EXECUTABLE which evaluated it was built from that revision. The join reads the running image's own reported build identity and admits it only through the trusted delivery route (the fleet-converge retire job taking release-bins from the build job), never from a self-report alone. It resumes when the retirement route lands; its consumers are that route's blockers, terminal and receipt.",
        displaced_cost: "Without it the assessment carries a named unresolved blocker and cannot complete the convergence package, so srv2 cannot be declared converged even after its registrations are removed.",
        first_slice: "The four-arm join (joined, mismatch, dirty, unobserved) consumed as a blocker by the assessment verdict.",
        red_control: "A checkout at R with a binary built from S refuses; an unreadable identity refuses as unobserved; a matching report from outside the admitted delivery route refuses.",
        out_of_scope: "No signing infrastructure; a --version string is not provenance on its own.",
        handback: "The join consumed by the assessment, with the delivery premise bound to the real steps rather than their names."
      )),
      dispatch: dispatchable(),
      parent: in_project(project: "fabric-application-authority", contribution: "The fabric decides placement from observed fleet facts; fleet health, convergence and hardware observation are those facts."),
    ),
    roadmap_node(
      identity: "rn_3WZQ8WHXK5CVTB1NDRM7FJ204P",
      id: "fleet-srv2-retirement-completion",
      owner: "fleet",
      carriers: carrier(path: "dag/gunbc/runner/runner_slot_retirement.dag"),
      line: ticket(t: updated(t: fields(
        headline: "Finish retiring srv2, from an executor that is not srv2, with a readback that proves it",
        boundary: "srv2's retirement as an explicit obligation over its host spec and owned identities. TWO POPULATIONS, NEITHER DERIVED FROM THE OTHER: seven local slot trees (01-05, 11, 12; 11 and 12 have NO systemd unit, so unit enumeration misses them) and four captured registrations: srv2-02 id 251463 and srv2-05 id 251484 PRESENT on the organization (2026-09-19 reads), srv2-11 id 91529 and srv2-12 id 91513 ABSENT (no DELETE, no receipt claiming one). Also decide the ctrl-runner-reclaim timer's disposition. Remaining: plan and apply reaching the target over SSH, graceful retirement, and the authorized removal with its postcondition.",
        displaced_cost: "srv2 was hand-converged to zero workers on 2026-09-18 and the model could not describe that state: the assessment refuses today on an ungrounded local population and an unread roster, and the capacity plan refuses for every host while srv2's registrations are unaccounted for. Until the route can act, every convergence is hand SSH and the next one repeats it.",
        first_slice: "Clear the three named blockers the closure already refuses on -- LocalPopulationUnavailable (no census is admitted into srv2_host_retirement; the model carries the census date in its cause), RosterReadUnavailable (the route holds no organization credential, so remote ownership cannot be established), and the unresolved build provenance -- and the plan/apply spine reaching a target that is not the executor. Those three blockers are typed and visible on every receipt, so they are the work list.",
        red_control: "Retiring srv2 must not require a runnable srv2 runner; a registration whose ownership is not established by the host capture refuses rather than being deleted; an unobserved roster refuses rather than reading as empty.",
        out_of_scope: "No second actuator beside the reviewed plan/apply spine; no deletion authorized by a name prefix; GracefulRetirement stays MethodUnavailable until implemented rather than being discovered as a surprise. srv2 has NO RunnerHostDeploy row at all -- its width is a typed refusal -- so nothing downstream may assume a deploy exists, and a capacity refusal is never a deletion instruction. One realization precondition, measured 2026-09-19: masking a unit whose fragment lives in /etc/systemd/system REFUSES until the fragment is moved (srv2's timer and service fragments were moved to /var/lib/gunbc-retired/20260919/ before both masked at 15:06:30Z); the retirement operation must handle that rather than fail on it, and BOTH the timer and its service must be masked, since an inactive service is not an inhibited one.",
        handback: "One transaction at one revision: plan artifact, authorized apply receipts, independent readback, and a second assessment with nothing remaining."
      ), on: "2026-09-24", note: "The brief before the 100-word re-cut, verbatim (obligations kept in the brief, context here): srv2's retirement as an explicit obligation over its host spec and its owned identities. TWO POPULATIONS, NEITHER DERIVED FROM THE OTHER: seven local slot trees (01-05, 11, 12) and FOUR captured registration bindings (srv2-02 id 251463, srv2-05 id 251484, srv2-11 id 91529, srv2-12 id 91513). 11 and 12 have directories but NO systemd unit, so anything enumerating by unit misses them. Of the four, the 2026-09-19 per-ID reads found 251463 and 251484 PRESENT on the organization and 91529 and 91513 ABSENT, so two need an authorized removal and two need no DELETE and no receipt claiming one. Also in scope: the runner trees and the ctrl-runner-reclaim timer's disposition, which is undecided pending whether it serves anything beyond the retired trees. The assessment route landed; what remains is plan and apply reaching the target over SSH rather than reading it locally, graceful retirement, and the authorized removal with its postcondition.")),
      dispatch: dispatchable(),
      parent: in_project(project: "fabric-application-authority", contribution: "The fabric decides placement from observed fleet facts; fleet health, convergence and hardware observation are those facts."),
    ),
    roadmap_node(
      identity: "rn_2GPKWK8FXAKETC8ATH3MJEXEXC",
      id: "fleet-convergence-census-closure",
      owner: "fleet",
      carriers: carrier(path: "docs/plans/convergence-one-program.md"),
      line: ticket(t: fields(
        headline: "Every effect that changes a machine goes through the one checked route",
        boundary: "The census already lists every effect that changes lasting state. Work through what it lists, one family of effects at a time, and for each one say who chose the desired state, what looked at reality, what compared them, what plan was allowed, what carried it out, and what checked afterwards. Where the honest answer is that it never converged, rename it to what it actually does.",
        displaced_cost: "Effects that change real machines while calling themselves converged, so nobody can tell which ones were actually checked.",
        first_slice: "Close one effect family, and let the census say which are left.",
        red_control: "An effect that reports success from its own write, with nothing reading the result back, must not pass.",
        out_of_scope: "No new migrations invented here; the census is the list.",
        handback: "The census, with every family either closed, truthfully renamed, or named as outstanding."
      )),
      dispatch: dispatchable(),
      parent: in_project(project: "fabric-application-authority", contribution: "The fabric decides placement from observed fleet facts; fleet health, convergence and hardware observation are those facts."),
    ),
    roadmap_node(
      identity: "rn_W964QANFVKCPEBGKP50F0036KH",
      id: "fleet-convergence-legacy-deletion",
      owner: "fleet",
      carriers: carrier(path: "docs/plans/convergence-one-program.md"),
      line: ticket(t: fields(
        headline: "Delete the routes that were replaced, and make them hard to grow back",
        boundary: "Once the checked route is the real one, the older ways of changing the same machine state are deleted rather than left beside it. A check then refuses a change that adds a new one, by comparing against the list of things that actually produce effects rather than by searching for suspicious names.",
        displaced_cost: "A replaced route left standing is where the next author looks first, so the old way quietly comes back.",
        first_slice: "Delete one superseded route whose replacement is executing, and prove what refuses when it is gone.",
        red_control: "Re-adding a second route for an effect that already has a checked one must fail the check.",
        out_of_scope: "No behaviour moves here; anything still needing one belongs in the census work.",
        handback: "Nothing left that changes lasting state outside the checked route, and a check that says so."
      )),
      dispatch: dispatchable(),
      parent: in_project(project: "fabric-application-authority", contribution: "The fabric decides placement from observed fleet facts; fleet health, convergence and hardware observation are those facts."),
    ),
    roadmap_node(
      identity: "rn_CUTD0TRANSACTION2026091DS41",
      id: "serving-v41-cut-d-d0-transaction",
      owner: "fleet",
      carriers: carrier(path: "docs/plans/dsv41-cut-d-redesign.md"),
      line: ticket(t: updated(t: fields(
        headline: "Cut D D0: suspend Group A under an exact operator consent, read the fleet inside it, settle to one typed terminal, and never free a host early",
        boundary: "gunbc.spark.pair_serving_d0 over gunbc.spark.pair_serving_authority_log on the fabric DB: one durable genesis per group partition, the host-placement partition as the linearization point, prepare -> append-claim -> authority -> finalize as one saga bound by a typed AuthorityWriteIntent, consumed/cancelled exclusivity, claim-bound quiescence evidence, total crash recovery by lifecycle identity, the operator consent slot as a fabric-DB head (gunbc.durable_cas_fabric_storage, generation-bearing objects), and a wet door that refuses while the store's write walls are missing.",
        displaced_cost: "Without D0 the V4.1 cut over Group A has no transaction: no consent that is spent exactly once across executors, no state in which the group is neither serving nor being mutated by two writers, and no receipt of the fleet as it was read before the authority moved -- the prior state, in which membership and placement were roster words and a crashed lane left no recoverable trace.",
        first_slice: "MERGED 2026-09-21: #11555 (the authority log, the saga, D0 recovery, the fabric-DB CAS, the quiescence observer, the front-door and head-host absence readings; 32+9 authority-log claims, 21+13+6 D0 claims, 2 CAS wet claims, host-commitment and seat gates), #11918 (Cut 0's network-derivable axes: the weight manifest admitted as an exact population reconciled against the index's read shard set, the index file and the tokenizer role manifest keyed; one generic gunbc.auth.approval_gate that Mt. Collins and D0 bind; gunbc.spark.pair_serving_d0_authorization -- the exact intent and request frozen before filing, the recorded approval joined to the held claim, live versus recovery approval semantics -- and the wet door gunbc.spark.pair_serving_d0_door), #11936 (the writer-identity reading gunbc.fabric_writer_identity_observe takes through the served door's identity operation; the drop row split into served and local writer populations with a two-wall trigger and the user-not-node grain stated), #11964 (the door as fleet-converge mode pair_serving_d0: Group A by construction, srv1 proved before credentials, consent as the reusable transaction identity, the executing revision joined to the checkout and frozen as the final field of D0FrozenFiling with a mismatched-revision recovery refused, the srv1 host key shared with the pair-serving apply). REMAINING, IN ORDER: (1) srv1's fabric DB endpoint (#11723) and approval broker (#11667) are NOT LIVE: on the operator's go the RLM chain ran (plan 35614110881, apply 35616060173 at eb81d1869c) and dashboard_deploy refused as on 2026-09-17 -- live_deploy cannot observe the host as the runner principal (git dubious ownership at /opt/gunbc/gunbc; /home/briansrls unlistable); the operator ruled that the CONVERGENCE-ONE live_deploy lane repairs its observing principal; and a second blocker found on the operator-local route, the approval-broker unit itself could not render on main (ServiceType carried the retired string mode; PatternMatchFailure at the unit), which #12005 repairs. The terminal is: make the srv1 endpoint and broker live. The writer-identity observations (2) and every D0 fleet execution (4) wait on that; the row-store digest (3) and the source side of the later cuts may proceed, but nothing mutates Group A before those control-plane prerequisites and the two store walls stand. (2) Dispatch fabric_writer_identity_observe once per fleet host (srv1..srv4) and author the writer USER-principal roster and the served-door refusal from the receipts, plus principal admission on the placed host's local write path -- both halves retire gunbc.rung_drop fabric_storage_append_principal_unrefused -- and restore gunbc.spark.pair_serving_d0 d0_store_operation_wall (per-operation D0 authorization at the store); the door consumes both and refuses until both stand. (3) The published-shard row-store content digest (a fleet read on a Spark) keys the last candidate axis. (4) Dispatch pair_serving_d0 on srv1 with a consent id and expected_revision: D0 on Group A. (5) D1 converger: freeze the host population on PairServingActive and consume released_baseline_retains_reservation; then D1a and D2. (6) Retire the detached-process wet-lane row (gunbc.ci_layer_roots excl_local_repo_wet_detached_process_reason) and the v1 resolver defect (a braced import of extdeps.http.client or v2.std.algebra { filter } makes the builtins split/last unresolvable inside a match-arm block; fixture on #11555 round 18) -- seed lane. Hardening noted by review, not required: a source-level apply claim at the pair-serving apply's effect point so a direct invocation also linearizes against D0's transition.",
        red_control: "A stranger's abort of a prepared or claimed preparation refuses with nothing written; a cancelled preparation cannot be consumed and a consumed one cannot be cancelled; an authority event that is not the exact write its append claim named is unread on every join; a cycled CAS value does not let a stale writer advance at fabric_storage_advance; the wet door refuses while either store wall is missing; a 401/500 front door is an answer and a failed connect is absence only when the head host is quiet.",
        out_of_scope: "Cut 0 candidate keying and the authorization producer; the fabric-DB principal and per-operation walls (fabric-DB lane); D1 convergence; P1 Cut 3 held-seat invalidation; any fleet mutation before the walls stand.",
        handback: "Group A suspended under an exact consent with the fleet reading recorded on the log, settled to Suspended / restored Active / FencedRefusal, the consent spent once, every host fence released only by observed quiescence, and the placement finalized -- by execution against the fleet, which no branch has yet done.",
      ), on: "2026-09-20", note: "Moved from the brief at the 100-word re-cut (context, not an obligation): STATE (2026-09-20, wound down under operator direction to re-prioritize v1 performance and v2 migration): the whole stack is one branch, plan/dsv41-cut-d-2b, re-rooted onto the rewritten main and source-approved through twenty-one review rounds; the operator ruled it may land under the widened fabric-DB principal drop. Its stacked follow-up branch, plan/dsv41-cut-d-2b-admission-cleanup, deletes the twenty transition-admission rows the stack consumed and carries the detached-process wet-lane admission row.")),
      dispatch: dispatchable(),
      parent: in_project(project: "fabric-application-authority", contribution: "The fabric decides placement from observed fleet facts; fleet health, convergence and hardware observation are those facts."),
    ),
    roadmap_node(
      identity: "rn_RVJ5GW9Q2D7Y3PKAKTNRT0DCSB",
