    roadmap_node(
      identity: "rn_4YXQ47680VA8B4GNGGVPV2DQZ8",
      id: "whole-service-witness-costs-more-than-its-budget",
      owner: "self-host",
      carriers: carrier(path: "docs/plans/floor-cost-distribution-near-the-ceiling.md"),
      line: ticket(t: fields(
        headline: "Decide what a witness over a whole real service is allowed to cost",
        boundary: "One witness parses a complete real service declaration end to end, and it is the only claim that runs that path for real. Decide whether it stays whole, and on what basis, rather than deciding by whichever budget happens to refuse it first.",
        displaced_cost: "It was measured several times over the evaluation-step budget, and separately above the per-subject processor-time line. Both readings are re-derived from the required floor's per-claim cost receipt, the required-floor-claim-cost artifact, read for this witness identity against the budget that v2.workflow.required_floor declares. Its cost was shown to be linear in the content rather than a defect in shape, so shrinking the fixture does not make it cheaper - it makes it stop being the real thing. The two budgets are separate gates and admission against one says nothing about the other, which is easy to miss.",
        first_slice: "Establish this witness's UNIQUE obligation before deciding anything about its size, because the sibling claims in the same module already execute the real tokenizer and parser on source - so this row is not the only execution of the service parse path in general, only of this particular composition of constructs, and those are different subjects. Where the obligation is one grammar behaviour, a minimal discriminating specimen carries it; where it is an INTERACTION between service constructs, keep the smallest composition that still exercises that interaction; where it is ingestion of the production file itself, bind the evidence to that file and state its scope honestly. Then re-measure after the service family moves onto the exact-word terminal, because the keyword machinery accounted for somewhere between a fifth and two fifths of the cost and the remainder is the service body itself.",
        red_control: "Whatever is decided, deleting the claim that runs the real path must make a control fail, so the cheap claims cannot stand alone.",
        out_of_scope: "Not a change to either budget's value, and not a licence to split the witness into pieces that each avoid the line while nothing exercises the whole. Two arguments are refused in advance: that the specimen is real and therefore cannot shrink, which is an exemption from the one-interface rule rather than an application of it; and that its cost is linear and therefore justified, since linear work can still be work no admitted consumer of this claim demands. An admission on the processor line is not an admission on the evaluation-step budget, and neither is permission on the other.",
        handback: "Return the re-measurement on both gates, the decision with its reason, and - if the witness is admitted over a line - a record that decides on the live reading rather than on a number typed into a row."
      )),
      dispatch: dispatchable(),
      parent: in_project(project: "v2-compiler-live", contribution: "Primitive egress, interpreter cost and self-host admission are what the self-hosted compiler needs before it is the one that runs."),
    ),
    roadmap_node(
