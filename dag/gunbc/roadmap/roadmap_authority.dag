// THE RETENTION-KERNEL CLOSING DISCRIMINATOR. REBOUND 2026-08-11 (gunbc#8146, review 51209) from
// legacy_test_behavior_unclassified_frontier_is_zero, which bound this node to the BEHAVIOR-grain
// disposition graph. That model is retired: the cutover inverted the authority from classifying
// departures to declaring residents (test.retirement.model retained_legacy_rust_test_modules), and
// legacy_test_behavior_dispositions() is now empty, so the old contract could never green under the
// model that replaced it. Leaving it bound would have left TWO authorities for one population
// (DESIGN section 3) and pointed downstream work at a completion criterion that no longer exists.
// The node now binds retained_rust_kernel_wall_holds_against_live_tree: a two-direction identity
// join between the live src/v1/tests/src discovery scan and the declared retained roster, plus the
// execution check (no #[ignore] / #[should_panic] in a retained module, default libtest harness).
// It does NOT bind the diff-scoped delete guard, which was deleted with the ratchets it served.
// Rung, stated rather than implied: the identity join is a construction wall (an undeclared module
// or a stale row is unwritable-and-green), the execution half is mechanically preventive text
// scanning with its false-negative class named at the lens.

// THE ONE NODE CONSTRUCTOR, roadmap_node (operator ruling, 2026-09-30). Every declared row goes
// through it, and the dispatch facts are its optional parameters, each defaulting to none: dispatch
// (absent reads NotDispatchable; sizing itself is derived, gunbc.roadmap_sizing), execution (absent reads ExecutionContractUnspecified), parent and
// centering. The defaults are `none` rather than the variant they stand for because a parameter
// default is evaluated in the CALLER's scope (observed 2026-09-30: `= Unsized` reached a caller
// that does not import Unsized as NoSuchVariable), and `none` resolves everywhere. A row that does not pass a
// fact is simply NOT READY, which gunbc.roadmap.roadmap_readiness derives; a project or milestone
// is a node that passes a parent and no centering or contract, and has members.
fn roadmap_node(
  identity: String,
  id: String,
  owner: String,
  carriers: List<Pointer>,
  line: RoadmapItem,
  dispatch: WorkItemDispatch? = none,
  execution: WorkItemExecutionContract? = none,
  parent: NodeParent? = none,
  centering: NonEmptyStr? = none
) -> RoadmapNode {
  RoadmapNode {
    identity: identity as RoadmapNodeIdentity,
    node: nid(s: id),
    line: line,
    carriers: carriers,
    dispatch: match dispatch {
      Present { value: d } => d
      Absent => NotDispatchable
    },
    execution: match execution {
      Present { value: e } => e
      Absent => ExecutionContractUnspecified
    },
    owner: owner,
    signoff: Unsigned,
    parent: parent,
    centering: centering,
  }
}

fn ticket(t: TicketFields) -> RoadmapItem {
  TicketLine { done: false, ticket: t }
}

fn dispatchable() -> WorkItemDispatch? {
  Present { value: Dispatchable { repo: "gunbc", acceptance: ManualAcceptance } }
}

fn bound(contract: WorkItemExecutionContract) -> WorkItemExecutionContract? {
  Present { value: contract }
}

fn in_project(project: String, contribution: String) -> NodeParent? {
  Present { value: MemberOf { project: project, contribution: contribution as NonEmptyStr } }
}

fn admitted_root() -> NodeParent? {
  Present { value: AdmittedRoot }
}

fn plan(text: String) -> NonEmptyStr? {
  Present { value: text as NonEmptyStr }
}

fn level_fields(
  headline: String,
  boundary: String,
  approach: String,
  red_control: String,
  displaced_cost: String,
  handback: String
) -> TicketFields {
  TicketFields {
    headline: headline,
    brief: boundary,
    displaced_cost: displaced_cost,
    current_state: approach,
    first_slice: approach,
    red_control: red_control,
    out_of_scope: "No executable work lives on this node: its dispatch fields are stubs, it is never dispatched, and its bar is met only through its members.",
    handback: handback,
    updates: [],
    authored_on: "",
    last_verified_on: "",
  }
}

fn carrier(path: String) -> List<Pointer> {
  [Pointer { label: "authority", path: path }]
}

fn fields(
  headline: String,
  boundary: String,
  displaced_cost: String,
  first_slice: String,
  red_control: String,
  out_of_scope: String,
  handback: String
) -> TicketFields {
  TicketFields {
    headline: headline,
    brief: boundary,
    displaced_cost: displaced_cost,
    current_state: concat("Unaccepted; next executable slice: ", first_slice),
    first_slice: first_slice,
    red_control: red_control,
    out_of_scope: out_of_scope,
    handback: handback,
    updates: [],
    authored_on: "",
    last_verified_on: "",
  }
}

// A dated status note goes on the ticket's updates thread, never into first_slice: the slice is
// consumed as "next executable slice" by current_state and the dispatch brief, so a position
// written there forks its meaning, and gunbc.roadmap_status's decomposition exists precisely so
// updates stop concatenating into a field with no time axis. The page renders the thread.
fn updated(t: TicketFields, on: String, note: String) -> TicketFields {
  TicketFields {
    headline: t.headline,
    brief: t.brief,
    displaced_cost: t.displaced_cost,
    current_state: t.current_state,
    first_slice: t.first_slice,
    red_control: t.red_control,
    out_of_scope: t.out_of_scope,
    handback: t.handback,
    updates: concat(t.updates, [TicketUpdate { on: on, note: note }]),
    authored_on: t.authored_on,
    last_verified_on: t.last_verified_on,
  }
}

fn edge(child: String, parent: String) -> RoadmapEdge {
  RoadmapEdge { child: nid(s: child), parent: nid(s: parent) }
}

// 2-scm-native-authority-program records an OPERATOR-RULED PROGRAM (2026-09-13): native SCM becomes
// the authority for authoring, proposals, integration and history; Git/GitHub become compatibility
// projections. It was dispatched as six sequential dashboard tickets, and the 2026-09-14 wind-down
// left it mid-stack, so the node carries what remains at the grain actually established. The ticket
// briefs and rulings live on the dashboard and are not restated here.
// SHELL→DAG MIGRATION BATCH 1 (operator ruling 2026-09-20). Ten verified shell-in-decision-code
// sites, one node each, sharing the shell-dag- id prefix because the roadmap model carries NO
// project/component grouping mechanism yet — dependency edges are the only parent relationship
// declared_roadmap_edges knows, and grouping for fanout/fanin delivery is slice 2's publication
// structure, not authored here. Every row is a child of shell-typed-invocation (its completed
// exemplar) and closes on a NEW witness dag/test/claim/shell/<id>_witness_test.dag asserting
// the rendered surface contains no shell control word (set -e, ||, &&, ;, 2>/dev/null) beside a
// typed-form positive control — the exact oracle idiom of
// test.claim.shell.shell_typed_invocation_witness_test. STAGGERING CONSTRAINT: two pairs share
// one file and must never be dispatched concurrently — shell-dag-ci-deploy-invoke-prelude with
// shell-dag-ci-heal-regen-invoke (both dag/gunbc/ci/ci_spec.dag), and
// shell-dag-live-deploy-install-owned with shell-dag-live-deploy-restart-tailscale (both
// dag/gunbc/live_deploy/emit.dag). The constraint is recorded in each pair member's plan in
// gunbc.roadmap.roadmap_centering; the graph has no exclusion-edge vocabulary to carry it.
