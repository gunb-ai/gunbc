// CENSUS, ASSERTED (replaces the census TEXT-CARRIER, which failed by design). The
// population is floor_census_sites; the planted positive control (main-bare-T-parameter-
// read, the shape the #11285 wall exists for) must be counted - population = not_planted
// + 1 - and NO field-miss site may come back with zero rows (that is the fabrication this
// node hunts), NO twin site may be blocked (that is the mislabeled-program failure mode
// review 17051 caught), and nothing may be NOT-RUNNABLE (an empty instrument is not a
// verdict). On failure the reason carries the full rendered census.
test fn floor_field_through_generics_census_residue_is_zero() -> ProcessExit {
  let rendered = join(map(floor_census_sites, f: fn(r) { floor_census_render_row(row: r) }), sep: "; ")
  let total = count(floor_census_sites)
  let planted = count(filter(floor_census_sites, f: fn(r) { r.planted }))
  let miss_sites = filter(floor_census_sites, f: fn(r) { r.is_field_miss })
  let miss_blocked = count(filter(miss_sites, f: fn(r) { string_contains(s: rendered, pattern: concat(r.site, ":BLOCKED")) }))
  let twin_blocked = count(filter(floor_census_sites, f: fn(r) { !r.is_field_miss && string_contains(s: rendered, pattern: concat(r.site, ":BLOCKED")) }))
  census_verdict_all([
    census_premise(concat("census population=planted+not_planted (", concat(concat(census_int_text(n: total), "="), concat(concat(census_int_text(n: planted), "+"), concat(census_int_text(n: total - planted), ") rows: ", rendered)))), total == 13 && planted == 1 && total - planted == 12),
    census_premise(concat("planted identity counted as a BLOCKING refusal: ", rendered), string_contains(s: rendered, pattern: "main-bare-T-parameter-read:BLOCKED")),
    census_premise(concat("no FABRICATED-RESIDUE (field-miss site with zero BLOCKING rows): ", rendered), !string_contains(s: rendered, pattern: "FABRICATED-RESIDUE")),
    census_premise(concat("no twin blocked (no refusal of a valid program); blocked twins=", concat(census_int_text(n: twin_blocked), "; rows: "), rendered), twin_blocked == 0),
    census_premise(concat("nothing NOT-RUNNABLE (an unrunnable census is not a verdict): ", rendered), !string_contains(s: rendered, pattern: "NOT-RUNNABLE")),
    census_premise(concat("every field-miss site refused by a BLOCKING row (", concat(concat(census_int_text(n: miss_blocked), "/"), concat(census_int_text(n: count(miss_sites)), "); rows: "), rendered)), miss_blocked == count(miss_sites))
  ])
}

// PLANTED NEGATIVE CASE (review 98226 follow-up, from the acceptor): the residue leg
// must be shown to go RED on a warning-only acceptance of a field-miss site, not just
// assert that it would. A REAL warning-only field-miss compile cannot be constructed
// while the wall holds (that IS the bug this census hunts - constructing it would mean
// the wall regressed), so the planted case is synthesized at the row level and fed
// through the SAME classifier the live census uses (floor_census_status_for over
// census_blocking_rows - the filter whose absence was the fault). The planted identity
// is named in every premise, so any red prints it; the live census leg runs in the same
// batch over the untouched population, which is the "removed again - population back to
// its prior counts" half: here population=13, planted=1, not_planted=12 asserted as
// absolute data premises, and the census leg re-asserts them against the compiled walk.
test fn floor_census_instrument_discriminates_planted_warning_only() -> ProcessExit {
  let planted_warning_only = [CompileDiagnosticCensusRow { diagnostic_class: "TypeMismatch" as NonEmptyStr, subject_name: "planted-warning-only-field-miss-on-T", blocking: false, count: 1, rendered_pair: Absent }]
  let planted_blocking = [CompileDiagnosticCensusRow { diagnostic_class: "InternalError" as NonEmptyStr, subject_name: "no field 'no_such_field' on type 'T'", blocking: true, count: 1, rendered_pair: Absent }]
  let s_warn = floor_census_status_for(rows: planted_warning_only, is_field_miss: true)
  let s_block = floor_census_status_for(rows: planted_blocking, is_field_miss: true)
  let s_twin = floor_census_status_for(rows: [], is_field_miss: false)
  let total = count(floor_census_sites)
  let planted = count(filter(floor_census_sites, f: fn(r) { r.planted }))
  let not_planted = total - planted
  census_verdict_all([
    census_premise(concat("planted-warning-only-field-miss-on-T must classify FABRICATED-RESIDUE (a warning is not a refusal); got: ", s_warn), s_warn == "FABRICATED-RESIDUE"),
    census_premise(concat("the same wall row marked blocking must classify BLOCKED; got: ", s_block), s_block == "BLOCKED"),
    census_premise(concat("a field-present twin with no rows must classify CLEAN; got: ", s_twin), s_twin == "CLEAN"),
    census_premise(concat("live census baseline absolutes: population=13 planted=1 not_planted=12, got population=", concat(census_int_text(n: total), concat(" planted=", concat(census_int_text(n: planted), concat(" not_planted=", concat(census_int_text(n: not_planted), " (population=", concat(concat(census_int_text(n: total), "="), concat(concat(census_int_text(n: planted), "+"), concat(census_int_text(n: not_planted), ")"))))))))), total == 13 && planted == 1 && not_planted == 12)
  ])
}

