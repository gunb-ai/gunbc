    roadmap_node(
      identity: "rn_3GKQ7WVZ4TNXPB8MHCDR5EJYA2",
      id: "review-sheet-identity-producer-and-admission",
      owner: "buyer-review",
      carriers: carrier(path: "docs/plans/review-sheet-and-census-lane-handoff.md"),
      line: ticket(t: fields(
        headline: "Give the landed review-sheet identity kernel its producers and its declared-id admission",
        boundary: "gunbc.review_sheet_identity landed as a pure kernel and is enrolled in the census closure frontier with three consumer rows whose triggers name EXECUTION rather than import. This node is the execution: the shared marker-query constructor, the Drive superseded-marker producer, and the subject-bound operator-declaration reader, each emitting LegacyExtentEvidence into the one complete join; then the declared-id admission that reconciles a LegacyFileSelection against a standing, a contradicting observation, an exact file-by-id preflight and the intended subject. The kernel decides standing and the producers decide none.",
        displaced_cost: "An empty appProperties search establishes only that the REQUESTING OAUTH CLIENT received no matching rows, never that no legacy-marked file exists, because appProperties are private to the requesting application and nothing in this corpus observes the application identity of its own token. Until a producer carries that distinction into the kernel, the live converge keeps reading an unresolved extent as an absent one, which is how the first duplicate sheet was minted.",
        first_slice: "The three producers and the complete join, discharging the kernel's enrolled consumer frontier rows; then the admission fold.",
        red_control: "A selection beside an unresolved extent stays unresolved; a positive find under unresolved visibility does not settle the extent empty; deleting the producer integration makes a control fail rather than leaving the supplied-input claims green.",
        out_of_scope: "No re-execution of the combined migration route of the closed gunbc#11596, which decided semantics inside effectful routing and is the shape this kernel replaces. No second relocation of the marker before these producers exist.",
        handback: "The producers, the join, the admission fold, and the frontier rows retired by execution rather than by import."
      )),
      dispatch: dispatchable(),
      parent: in_project(project: "customer-workspace-service", contribution: "Prospect census and buyer review are the customer-facing edge of the service; their identity and custody belong with it."),
    ),
    roadmap_node(
      identity: "rn_8QF2XJNLD6VKC3ZRW9HTYB4MSP",
