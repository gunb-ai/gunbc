    roadmap_node(
      identity: "rn_E4T64NMJ992QHGRWCCV9AS0J7M",
      id: "dp-m6-native-route-walls",
      owner: "debt",
      carriers: carrier(path: "dag/gunbc/rung_drop.dag"),
      line: ticket(t: level_fields(
          headline: "DP-M6: v2 native-route walls restored",
          boundary: "The native-route rung drops retired and the eval-step drop family shrunk. The three drops the census names (g0_type_decl_modifier_parse_without_sealing_property, variant_fields_unlowered_on_the_native_route, admit_callers_discarded_on_the_native_route) existed on main and not on this line. admit_callers_discarded_on_the_native_route is now retired by its own trigger -- the native route checks caller admission from the fn's declared admit_callers list, with the Arrow carrier and its consumer landing together (v2.compiler body_lowering_fold body_lower_fn_admit_clause_edges; v2.compiler.infer infer_caller_admission_diags) -- so it no longer counts. The other two remain, re-derived from gunbc.rung_drop once the line carries them.",
          approach: "Re-derive the population from gunbc.rung_drop, then one drop per change with its RED fixture and positive control.",
          red_control: "A drop retired without its restoration capability executing keeps this open (§4b(3)).",
          displaced_cost: "Each standing drop is a known wall down on the path v2 is meant to run on.",
          handback: "The drops retired, named by their restoring witnesses."
        )),
      parent: in_project(project: "debt-payoff", contribution: "Rung drops on the native route are declared safety regressions with a finite runway; restoring them returns the route to its prior rung."),
    ),
    roadmap_node(
      identity: "rn_TTZHRWWETX4EQ6HDABTT8AKMCV",
      id: "factory",
      owner: "harness",
      carriers: carrier(path: "docs/plans/harness-work-lifecycle.md"),
      line: ticket(t: level_fields(
          headline: "The factory: harness, workers, CI/floor and the daily workspace, the machine that lands and verifies work",
          boundary: "The steps every change traverses (orientation, implementation, test, commit, publication, review, verification) are owned by the workflow as durable state, not by an agent's memory. CI and floor verdicts name what they executed and cost what their inputs require.",
          approach: "Recursive alignment (harness-recursive-alignment) and prompt projection for the workers; the executed-coverage receipt and whole-population budgets for verification (ci-end-to-end-execution).",
          red_control: "A step the workflow claims to own survives process death and controller restart. A verdict over an empty executed population refuses. A worker crossing two checkpoints on one lineage submits one candidate.",
          displaced_cost: "Every obligation left in prose is re-learned per session and dropped under pressure. Every finished candidate that needs hand-integration spends operator time the factory exists to save.",
          handback: "Per member: the receipt of one journey completed by workflow ownership, and the verification-cost and executed-population figures, named by their instrument."
        )),
      parent: in_project(project: "gunbc-project-root", contribution: "The machine that lands and verifies work (harness, workers, CI/floor, daily workspace) is what turns every other project's tasks into landed, verified changes without operator hand-integration."),
    ),
    roadmap_node(
      identity: "rn_3E5NJVBW4DA73A581DTT7APKC7",
      id: "factory-dogfood-route",
      owner: "harness",
      carriers: carrier(path: "dag/gunbc/roadmap/roadmap_dogfood_route.dag"),
      line: ticket(t: updated(t: fields(
        headline: "One request travels the whole factory and comes back as an independently reviewed, published candidate",
        boundary: "The dogfood route as one acceptance case: request, immutable subject, shared computation, placement grant, isolated execution, durable result, metering, independent review, candidate published, cleanup, result returned (production order: the belt reviews a head before publishing it) -- each established by its own typed record from the durable records the real srv2 route wrote for ONE attempt (gunbc.roadmap_dogfood_route DogfoodRouteReceipt). The start receipt is the first complete attempt, selected in refname order, by the first successful recorder to observe one (scanning durable attempt history), recorded once, create-only; attempts operated by hand before the route existed do not qualify.",
        displaced_cost: "Without one executable case the factory is a set of stages that each pass alone while no request has crossed them all, and the operator's confidence -- the gate for the first external customer -- has nothing to rest on.",
        first_slice: "The receipt and its acceptance function, red with three stages owed, each to the change that writes its own record: G1 cutover (immutable subject, shared computation) and G5 isolated execution, owed to a record binding the granted unit's observed start and exit to its grant and fence. Produced and carried through the complete arm and the start receipt: the request (G4 request-binding record), placement grant and cleanup (G5, cleanup returning the placed grant and fence), metering (a Final G3 metering record), and the result returned (G4, a published result answering the request's claim at the submission's head). The start receipt also pins the attempt's joined service evidence (gunbc.roadmap_service_evidence) bound to its launch record",
        red_control: "A reading set with a stage missing or read twice is malformed, not judged; one owed or refused stage withholds the receipt and names it; an unreadable attempt population does not pass.",
        out_of_scope: "MicroVM isolation (a capped systemd unit plus a lease is the dogfood bar, operator ruling 2026-10-03); billing and pricing; a reviewer on a different model (same model, separate context window, operator ruling 2026-10-03).",
        handback: "The dogfood start receipt: the first attempt on srv2 whose DogfoodRouteReceipt is complete, read by the acceptance function."
      ), on: "2026-10-03", note: "Operator ruling 2026-10-03: the dogfood clock is what matters most for the first-external target.")),
      execution: bound(contract: dogfood_route_execution_contract()),
      parent: in_project(project: "factory", contribution: "The factory is proven by one request crossing every stage on the real route, not by each stage passing alone."),
    ),
    roadmap_node(
      identity: "rn_TCZ82BX9PRSBAW1Z4WVSFQT023",
      id: "fabric-worker-event-log",
      owner: "harness",
      carriers: carrier(path: "dag/gunbc/fabric/fabric_event_log.dag"),
      line: ticket(t: updated(t: fields(
        headline: "Publish each attempt's worker events to the fabric event log",
        boundary: "The harness's per-attempt worker events, today appended only to a host-local provider-events.jsonl that gunbc.roadmap_provider_events reads, are appended to gunbc.fabric_event_log as a new payload kind over its existing partitions (product.capacity.event_chain), one partition per attempt. Any consumer then reads an attempt's events from the fabric rather than from a file on the worker's host.",
        displaced_cost: "Without it, every live view depends on sharing a filesystem with the worker, and streaming cannot go through the fabric as ruled.",
        first_slice: "One payload kind and append path for the round and item events the harness already writes, with a reader that returns an attempt's events after a cursor.",
        red_control: "An attempt's events read from the log equal the events the harness produced, in order, with no gap or duplicate across a reader restart; an append the log refuses is a typed refusal, not a silent drop.",
        out_of_scope: "The held-open HTTP response, any change to what the events are, and any second transport.",
        handback: "The payload kind, the append and read paths, and the order, gap and refusal receipts."
      ), on: "2026-10-05", note: "Not yet centered: needs a centering plan: authored 2026-10-05 with no attempts. Owner ruling 2026-10-05: event streaming goes through the fabric, not a tail of a host-local file. This row is the prerequisite of serve-held-open-response, declared as a dependency edge.")),
      dispatch: dispatchable(),
      parent: in_project(project: "factory", contribution: "A worker's events must be readable from the fabric before any live view can stream them without sharing the worker's filesystem."),
    ),
    roadmap_node(
      identity: "rn_92JGQNTZK8FJC0X8C6AS7HZRYS",
      id: "serve-held-open-response",
      owner: "harness",
      carriers: carrier(path: "dag/extdeps/http/server.dag"),
      line: ticket(t: updated(t: fields(
        headline: "Let the server keep a response open and send events as they happen",
        boundary: "gunbc serve gains a response kind that stays open and writes a sequence of events, beside today's whole-body response (extdeps.http.server ServeHttpResponse has only body: String). It delivers one attempt's events as read from the fabric's event log (gunbc.fabric_event_log over product.capacity.event_chain), never from a file on the serving host. The first consumer is the per-attempt event cursor: the same events the cursor poll returns, delivered as they are appended.",
        displaced_cost: "Without it, every live view polls and rebuilds its whole answer every two seconds, and a progress view can only be as fresh as its poll.",
        first_slice: "One held-open route that reads one attempt's events from the fabric from a given cursor and resumes from the last one the client saw.",
        red_control: "A reconnect with a cursor never repeats or skips an event; a closed client releases the server's resources; a handler that cannot stream refuses instead of buffering silently.",
        out_of_scope: "No second transport beside the fabric, and no change to what the events are.",
        handback: "The response kind, the route, and receipts for resume and disconnect."
      ), on: "2026-10-04", note: "Not yet centered: needs a centering plan: authored 2026-10-04 with no attempts. Owner ruling 2026-10-05: event streaming goes through the fabric, not a tail of a host-local file. Read on that date: gunbc.fabric_event_log is generic over its event payload, but its only payloads are pool, redemption and pair-serving authority events; a worker's events live in a file its attempt owns (gunbc.roadmap_provider_events). Publishing them to the fabric log is its own row, fabric-worker-event-log, and this row's declared prerequisite edge.")),
      dispatch: dispatchable(),
      parent: in_project(project: "factory", contribution: "Live views of working agents need events delivered as they happen, not rebuilt on a timer."),
    ),
    roadmap_node(
      identity: "rn_VQ8RGFT438E36PHK9WXJ5TCJMC",
      id: "v2-compiler-live",
      owner: "self-host",
      carriers: carrier(path: "dag/gunbc/compiler_frontend_program_interlock.dag"),
      line: ticket(t: level_fields(
          headline: "The new compiler is the one that runs",
          boundary: "v2 reads, names, types and emits the whole corpus. It builds itself, then rebuilds itself. It is the required native route, admitted for production, and the v1 seed is retired. No work sits on this node; the work lives in its seven member projects.",
          approach: "Order: frontend first (the native seven, then the whole corpus), then generations (a second build made by the built CLI), then the native route made required and admitted (D10), then the seed retired. The namespace cutover (XL-6/XL-7) comes after seed retirement. gunbc.compiler_frontend_program_interlock owns this order, and this node does not restate it.",
          red_control: "Seed retirement stays unreachable while any SelfHostSeedRetirement prerequisite in gunbc.compiler_frontend_program_status reads OUTSTANDING. A v2 task whose membership walk does not reach this node refuses as unrooted.",
          displaced_cost: "v2 work is spread over about 12 disconnected roadmap components, and the page's focus filter hid most of them. So nobody can tell whether a v2 PR moves the compiler closer to running.",
          handback: "SelfHostSeedRetirement reads CLEAR in gunbc.compiler_frontend_program_status, and every member project's handback is met."
        )),
      parent: in_project(project: "gunbc-project-root", contribution: "Self-hosting is the root's identity. This program makes the self-hosted compiler the one that actually runs, and it ends when the old seed is gone."),
    ),
    roadmap_node(
      identity: "rn_4DXSRQ0TDK36EBTJHKF9YFRJ3A",
      id: "v2-frontend",
      owner: "self-host",
      carriers: carrier(path: "src/v2/compiler/04_infer.dag"),
      line: ticket(t: level_fields(
          headline: "v2 reads, names and types its own source",
          boundary: "Parse, body lowering, literal and construct elaboration, occurrence identity, resolve and type inference in src/v2/compiler, measured on the production ingest route. Emission and namespace policy are not part of it.",
          approach: "Converge first on the native seven, the seven native test modules v2 must parse and type end to end. Then work down the whole-corpus refusal roster by root cause, never file by file (DESIGN §6b). The first big root was the construct tag that refused v2.compiler.tokenize.",
          red_control: "Any native-seven module refusing before type inference keeps this red. Later, a whole-corpus self-host run with any refusal that no named row owns keeps it red.",
          displaced_cost: "Each refused file is a module v2 cannot compile, so the seed must keep compiling it. Every frontend gap extends the seed's life.",
          handback: "The native seven typed end to end, then the self-host whole-corpus run (gunbc test //gunbc/instruments:self-host) with its refusal population at zero or fully rostered with triggers; the interlock milestones SelfHostWholeCorpusPopulationDerived and SelfHostCorpusEmitsCleanly are cited, not restated."
        )),
      parent: in_project(project: "v2-compiler-live", contribution: "Nothing downstream can be real until v2 can read, name and type its own source. Today the whole-corpus run refuses roughly 720 to 1,000 files, and this project owns bringing that number down."),
    ),
    roadmap_node(
      identity: "rn_QDPV7AJRJDYKTD4R22N67BRCXK",
      id: "v2-shared-type-check",
      owner: "self-host",
      carriers: carrier(path: "src/v2/compiler/04_infer.dag"),
      line: ticket(t: level_fields(
          headline: "v2 type-checks every construct with one relation",
          boundary: "v2.compiler.infer judges declared returns, record fields, lets, matches, optionals, generic records and cross-module declarations through the single inhabitance relation from #12566. There is no inline per-construct check beside it.",
          approach: "Extend the one relation construct by construct. Landed so far: #12379, #12566, #12601, #12763, #12806. Next: lets and match binders (#12582, #12637, #12641).",
          red_control: "A construct kind that neither derives nor refuses turns the per-kind coverage census red, which was v2-node-kind-derivation-coverage's bar. A second inline check beside the relation is a §3 fork and is refused in review.",
          displaced_cost: "Each construct checked its own way means a wrong program passes wherever the local check is weaker. That is the \"accepted on well-formedness alone\" class.",
          handback: "The per-kind coverage table with no generic accept arm, and the member tasks accepted."
        )),
      parent: in_project(project: "v2-frontend", contribution: "Typing is where most refusals that survive resolve end up. One shared check means a type fact is decided once, not once per construct."),
    ),
    roadmap_node(
      identity: "rn_FE4ZD7DWESKYT47F704VFZHRG3",
      id: "native-route-to-live",
      owner: "self-host",
      carriers: carrier(path: "dag/gunbc/rung_drop.dag"),
      line: ticket(t: level_fields(
          headline: "The native route gates every landing and becomes the production route",
          boundary: "The v2-native-frontier ratchet runs as a required merge_group step, which retires gunbc.rung_drop v2_native_route_off_the_merge_path and v2_native_frontier_nightly_cadence. Then the whole-route NativeProductionAdmission verdict (D10) admits it, with every refusal and divergence dispositioned. The effects the route needs (D11: Filesystem plus the Gap-B host facts) are a prerequisite, not this project's work.",
          approach: "Mint the roster first (gunbc.native_frontier_roster is RosterUnminted), then add the merge-queue-only step inside an existing lane (operator ruling Q4, 2026-09-30: accepted, no new job). Admission comes after that. v1/v2 disagreements are investigated and neither side wins by age (D10).",
          red_control: "A landing that grows the native-frontier debt roster refuses, once the lane is required. Admission refuses on any refusal or divergence left undispositioned.",
          displaced_cost: "Nothing runs the ratchet today, so native regressions land silently. The nightly job was deleted (#12439), and the lane is not yet required.",
          handback: "SelfHostNativeRouteRequiredLane CLEAR, both drops retired, and NativeProductionAdmitted over the required subject denominator."
        )),
