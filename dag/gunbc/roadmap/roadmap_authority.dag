          handback: "Each roster re-joined against the tree with no dead identities, named by the witness that joins it."
        )),
      parent: in_project(project: "debt-payoff", contribution: "Rows whose own dissolution condition already holds are the cheapest debt there is: retiring them is deletion with an existing witness."),
    ),
