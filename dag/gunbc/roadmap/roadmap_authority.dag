    roadmap_node(
      identity: "rn_8XBLW9DKZH5NCQ0RTVPMGJ4F2",
      id: "ci-executed-coverage-receipt",
      owner: "ci-control",
      carriers: carrier(path: "docs/plans/ci-process-end-to-end.md"),
      line: ticket(t: updated(t: fields(
        headline: "A check reports what it actually executed, not merely that it ran",
        boundary: "Every required check carries the population it executed — which witnesses, which corpus, how many — and a run that executed nothing cannot report a verdict of any kind. A build failure that stops the corpus from running is its own outcome, distinct from the corpus running and disagreeing.",
        displaced_cost: "A scheduled check spent days reporting failures while executing no corpus at all, because a step ahead of it failed and the result looked exactly like a real disagreement. Nobody could tell the difference from outside, so a genuine signal was ignored for days.",
        first_slice: "Carry the executed population on one required check, and refuse a verdict when that population is empty.",
        red_control: "A run whose executed population is zero refuses rather than reporting either pass or fail. A failure ahead of the corpus is a different outcome from a corpus disagreement. A check that cannot say what it executed does not count as having executed.",
        out_of_scope: "Not what the corpus contains or how it is selected, and not per-witness enrolment — only that a verdict names the work that produced it.",
        handback: "One required check carrying its executed population, with the empty-population refusal and the distinct upstream-failure outcome both demonstrated."
      ), on: "2026-09-30", note: "Not yet centered: needs a centering plan: its carrier docs/plans/ci-process-end-to-end.md was deleted in #9635 and must be re-pointed first.")),
      dispatch: dispatchable(),
      execution: bound(contract: gunbc_claim_execution_contract(
      entry: "dag/test/claim/closing/ci_executed_coverage_receipt_closing_contract_witness_test.dag" as FilePath,
      function: "a_run_whose_executed_population_is_zero_refuses_rather_than_reporting_pass_or_fail" as NonEmptyStr,
    )),
      parent: in_project(project: "ci-end-to-end-execution", contribution: "Making one required check carry the population it actually executed -- and refuse a verdict on an empty one -- is the program's core honesty property: a verdict names the work that produced it."),
    ),
    roadmap_node(
      identity: "rn_3PM7CFJ2XQ8VZ5KDR4HB9TNW6L",
      id: "floor-ceiling-roster-cut-completeness",
      owner: "ci-control",
      carriers: carrier(path: "src/v2/workflow/floor_grandfathered_roster.dag"),
      line: ticket(t: updated(t: updated(t: fields(
        headline: "The exemption list for the per-claim work ceiling was drawn from a partial run",
        boundary: "The per-claim work ceiling has two tiers: checks that already existed keep the older allowance, and checks arriving after the cut get a much tighter one. Which tier a check falls into is decided by one list, and that list is the set of checks that ran on ONE PULL REQUEST -- the pull request that introduced the tiering. Everything outside it is treated as new work however old it is, so the next change to touch such a file inherits a ceiling its checks were never measured against.",
        displaced_cost: "Fourteen checks written months earlier blocked a merge hours after the tiering landed, every one of them reaching its verdict and passing, with nothing in the change touching what they assert. The cost lands on whichever unrelated effort next edits a file outside the list, and it arrives looking like a defect in that effort's own work rather than in how the list was drawn.",
        first_slice: "Draw the list from a run that reached the whole routed population, and have the list state the population it was drawn from.",
        red_control: "A list drawn from a run that reached less than the full routed population refuses rather than being adopted, and a list drawn from a pull request run refuses on that ground alone. A check that existed in the corpus at the cut and is missing from the list is a finding, never a silent reclassification into the tighter tier. The two allowances stay distinct -- a list that covers everything is the same as having no tiering at all.",
        out_of_scope: "Not the tiering itself and not either allowance, both of which are separately grounded; only which checks the older allowance is supposed to cover.",
        handback: "The list, the population it was drawn from stated beside it, and one previously-misclassified check shown moving to the tier it belongs in."
      ), on: "2026-09-24", note: "Moved from the brief at the 100-word re-cut (context, not an obligation): A pull request runs the checks its own change touches plus the standing set, so the list is that change's neighbourhood rather than the corpus: about a third of what a full run reaches."), on: "2026-09-30", note: "Not yet centered: needs a centering plan: its first slice needs a full-population floor run a worker cannot produce, so the brief must supply that receipt.")),
      dispatch: dispatchable(),
      parent: in_project(project: "factory", contribution: "The per-claim ceiling's grandfathered list must be drawn from the whole routed population, or unrelated changes keep paying for a mis-cut."),
    ),








