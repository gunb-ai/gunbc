// THE RETENTION-KERNEL CLOSING DISCRIMINATOR. REBOUND 2026-08-11 (gunbc#8146, review 51209) from
// legacy_test_behavior_unclassified_frontier_is_zero, which bound this node to the BEHAVIOR-grain
// disposition graph. That model is retired: the cutover inverted the authority from classifying
// departures to declaring residents (test.retirement.model retained_legacy_rust_test_modules), and
// legacy_test_behavior_dispositions() is now empty, so the old contract could never green under the
// model that replaced it. Leaving it bound would have left TWO authorities for one population
// (gunbc.design_argument::single_authority) and pointed downstream work at a completion criterion that no longer exists.
// The node now binds retained_rust_kernel_wall_holds_against_live_tree: a two-direction identity
// join between the live src/v1/tests/src discovery scan and the declared retained roster, plus the
// execution check (no #[ignore] / #[should_panic] in a retained module, default libtest harness).
// It does NOT bind the diff-scoped delete guard, which was deleted with the ratchets it served.
// Rung, stated rather than implied: the identity join is a construction wall (an undeclared module
// or a stale row is unwritable-and-green), the execution half is mechanically preventive text
// scanning with its false-negative class named at the lens.

// THE ONE NODE CONSTRUCTOR, roadmap_node (operator ruling, 2026-09-30). Every declared row goes
// through it, and the dispatch facts are its optional parameters, each defaulting to none: dispatch
// (absent reads NotDispatchable; sizing itself is derived, gunbc.roadmap.roadmap_sizing), execution (absent reads ExecutionContractUnspecified), parent and
// centering. The defaults are `none` rather than the variant they stand for because a parameter
// default is evaluated in the CALLER's scope (observed 2026-09-30: `= Unsized` reached a caller
// that does not import Unsized as NoSuchVariable), and `none` resolves everywhere. A row that does not pass a
// fact is simply NOT READY, which gunbc.roadmap.roadmap_readiness derives; a project or milestone
// is a node that passes a parent and no centering or contract, and has members.
fn roadmap_node(
  identity: String,
  id: String,
  owner: String,
  carriers: List<Pointer>,
  line: RoadmapItem,
  dispatch: WorkItemDispatch? = none,
  execution: WorkItemExecutionContract? = none,
  parent: NodeParent? = none,
  centering: NonEmptyStr? = none
) -> RoadmapNode {
  RoadmapNode {
    identity: identity as RoadmapNodeIdentity,
    node: nid(s: id),
    line: line,
    carriers: carriers,
    dispatch: match dispatch {
      Present { value: d } => d
      Absent => NotDispatchable
    },
    execution: match execution {
      Present { value: e } => e
      Absent => ExecutionContractUnspecified
    },
    owner: owner,
    parent: parent,
    centering: centering,
  }
}

fn ticket(t: TicketFields) -> RoadmapItem {
  TicketLine { ticket: t }
}

fn dispatchable() -> WorkItemDispatch? {
  Present { value: Dispatchable { repo: "gunbc", acceptance: ManualAcceptance } }
}

fn bound(contract: WorkItemExecutionContract) -> WorkItemExecutionContract? {
  Present { value: contract }
}

fn in_project(project: String, contribution: String) -> NodeParent? {
  Present { value: MemberOf { project: project, contribution: contribution as NonEmptyStr } }
}

fn admitted_root() -> NodeParent? {
  Present { value: AdmittedRoot }
}

fn plan(text: String) -> NonEmptyStr? {
  Present { value: text as NonEmptyStr }
}

fn level_fields(
  headline: String,
  boundary: String,
  approach: String,
  red_control: String,
  displaced_cost: String,
  handback: String
) -> TicketFields {
  TicketFields {
    headline: headline,
    brief: boundary,
    displaced_cost: displaced_cost,
    current_state: approach,
    first_slice: approach,
    red_control: red_control,
    out_of_scope: "No executable work lives on this node: its dispatch fields are stubs, it is never dispatched, and its bar is met only through its members.",
    handback: handback,
    updates: [],
    authored_on: "",
    last_verified_on: "",
  }
}

fn carrier(path: String) -> List<Pointer> {
  [Pointer { label: "authority", path: path }]
}

fn fields(
  headline: String,
  boundary: String,
  displaced_cost: String,
  first_slice: String,
  red_control: String,
  out_of_scope: String,
  handback: String
) -> TicketFields {
  TicketFields {
    headline: headline,
    brief: boundary,
    displaced_cost: displaced_cost,
    current_state: concat("Unaccepted; next executable slice: ", first_slice),
    first_slice: first_slice,
    red_control: red_control,
    out_of_scope: out_of_scope,
    handback: handback,
    updates: [],
    authored_on: "",
    last_verified_on: "",
  }
}

// A dated status note goes on the ticket's updates thread, never into first_slice: the slice is
// consumed as "next executable slice" by current_state and the dispatch brief, so a position
// written there forks its meaning, and gunbc.roadmap.roadmap_status's decomposition exists precisely so
// updates stop concatenating into a field with no time axis. The page renders the thread.
fn updated(t: TicketFields, on: String, note: String) -> TicketFields {
  TicketFields {
    headline: t.headline,
    brief: t.brief,
    displaced_cost: t.displaced_cost,
    current_state: t.current_state,
    first_slice: t.first_slice,
    red_control: t.red_control,
    out_of_scope: t.out_of_scope,
    handback: t.handback,
    updates: concat(t.updates, [TicketUpdate { on: on, note: note }]),
    authored_on: t.authored_on,
    last_verified_on: t.last_verified_on,
  }
}

fn edge(child: String, parent: String) -> RoadmapEdge {
  RoadmapEdge { child: nid(s: child), parent: nid(s: parent) }
}

// 2-scm-native-authority-program records an OPERATOR-RULED PROGRAM (2026-09-13): native SCM becomes
// the authority for authoring, proposals, integration and history; Git/GitHub become compatibility
// projections. It was dispatched as six sequential dashboard tickets, and the 2026-09-14 wind-down
// left it mid-stack, so the node carries what remains at the grain actually established. The ticket
// briefs and rulings live on the dashboard and are not restated here.
// SHELL→DAG MIGRATION BATCH 1 (operator ruling 2026-09-20). Ten verified shell-in-decision-code
// sites, one node each, sharing the shell-dag- id prefix because the roadmap model carries NO
// project/component grouping mechanism yet — dependency edges are the only parent relationship
// declared_roadmap_edges knows, and grouping for fanout/fanin delivery is slice 2's publication
// structure, not authored here. Every row is a child of shell-typed-invocation (its completed
// exemplar) and closes on a NEW witness dag/test/claim/shell/<id>_witness_test.dag asserting
// the rendered surface contains no shell control word (set -e, ||, &&, ;, 2>/dev/null) beside a
// typed-form positive control — the exact oracle idiom of
// test.claim.shell.shell_typed_invocation_witness. STAGGERING CONSTRAINT: one pair shares
// one file and must never be dispatched concurrently — shell-dag-live-deploy-install-owned with
// shell-dag-live-deploy-restart-tailscale (both dag/gunbc/live_deploy/emit.dag). The constraint is
// recorded in each pair member's plan in
// gunbc.roadmap.roadmap_centering; the graph has no exclusion-edge vocabulary to carry it.
fn declared_roadmap_nodes() -> List<RoadmapNode> {
  concat([
    // ---- #gunbc.plans.fabric_market::fabric_market_plan (operator, 2026-11-23, #gunbc.design_ruling::execution_is_one_first_principles_market_and_schedulers_are_venues,
    // #gunbc.design_ruling::market_vocabulary_is_fix_and_matching_is_std_decision, #gunbc.design_ruling::live_router_changes_of_2026_11_23_are_requirements_evidence):
    // layers are edge depths within the intention (#gunbc.roadmap.roadmap_intention_binding::fabric_market_intention); fabric-market-convergence is the terminal.
    roadmap_node(
      identity: "rn_AD2W7VKE1V833VP8MCYTXNX1X5",
      id: "market-fix-upstream-model",
      owner: "fleet",
      carriers: carrier(path: "dag/gunbc/plans/fabric_market.dag"),
      line: ticket(t: fields(
          headline: "FIX is modeled as a cited, versioned upstream: the order, cancellation, status and execution messages and their enumerations, with their real names",
          boundary: "Serves gunbc.plans.fabric_market, layer 0 (gunbc.design_ruling::market_vocabulary_is_fix_and_matching_is_std_decision). An extdeps module per gunbc.design_argument::external_upstreams: cite the FIX Trading Community specification and declare its version; model Side, OrdType, TimeInForce, OrdStatus and ExecType, and the messages NewOrderSingle, OrderCancelRequest, OrderCancelReplaceRequest, OrderCancelReject, OrderStatusRequest and ExecutionReport, as the specification defines them, including that ExecType (what this report is) and OrdStatus (where the order now stands) are distinct, and the identifiers that link an order, its replacements and its reports (ClOrdID, OrigClOrdID, OrderID, ExecID). Upstream only: no gunbc policy, no mapping to our units, no product enumeration.",
          displaced_cost: "Every market term in the repository is a nickname coined locally (BuyTerms, maximum_buy_order, SupplierOffer, contention), so the vocabulary drifts and has already had to withdraw a reading (product.fabric.contention: headroom is not margin).",
          first_slice: "Choose the FIX version (gunbc.plans.fabric_market section 7), then the enumerations and the six messages with their citations.",
          red_control: "A value outside a modeled enumeration is unwritable or refused at its constructor; a message missing a field the specification requires is refused; the specification's own lifecycle examples are transcribed as cases -- an immediate-or-cancel order partially filled and its remainder cancelled, a fill arriving while a cancel is pending, a cancel rejected -- each naming the clause it reads.",
          out_of_scope: "Market data, quote negotiation beyond the Quote vocabulary, allocation and post-trade messages; the product mapping (market-fix-product-mapping); any transport (FIX sessions are not used).",
          handback: "The extdeps module, its citations and version, and the executed cases."
        )),
      parent: in_project(project: "fabric-bringup", contribution: "One market for every match of work with resources, in one vocabulary, so a new application enters by declaring what it trades."),
    ),
    roadmap_node(
      identity: "rn_443TFKBD4E0FHSFJMM00AHJ1G4",
      id: "execution-uncertainty-one-carrier",
      owner: "fleet",
      carriers: carrier(path: "dag/gunbc/plans/fabric_market.dag"),
      line: ticket(t: fields(
          headline: "One carrier says whether an effect was answered, proven not sent, or of uncertain delivery, and uncertainty is settled only by readback",
          boundary: "Serves gunbc.plans.fabric_market, layer 0. Factor delivery knowledge out of the local outcome-unknown arms (HostOutcomeUnknown in gunbc.compute.remote_build, FabricBlobPutOutcomeUnknown, PrintStartOutcomeUnknown and their siblings; the survey's grep found about twenty-one, a candidate set and not a census) into one carrier at the earliest boundary that owns it, with one rule: an uncertain outcome resolves by reading back, never by re-sending a non-idempotent effect. Each domain keeps its own result and its cleanup or release obligation beside the carrier: an answered asynchronous operation may still be running, and an answered write may still owe a content readback. Migrate the siblings onto the carrier and delete the duplicated arms (gunbc.design_argument::root_generalization).",
          displaced_cost: "Each route re-invents uncertain delivery, so a reviewer must re-check per route that a lost response is never retried as a fresh mutation, and the venue contract has no shared term to require.",
          first_slice: "The carrier and its readback rule at its home, with gunbc.compute.remote_build's HostOutcomeUnknown as the first migrated consumer and its readback implemented.",
          red_control: "A lost response after a possible mutation stays uncertain and is not re-sent (remove the readback rule and the control re-sends); a proven-not-sent refusal may retry; a readback that observes completion settles without a second send; an answered operation that is still running is not reported finished.",
          out_of_scope: "Protocol-specific readbacks beyond the first consumer: a migrated consumer without one stays explicitly uncertain; the venue contract itself (venue-contract).",
          handback: "The carrier and the migrated consumers, listed in two groups -- reconciled (readback implemented) and carried (uncertainty preserved, no readback yet) -- with a cited grep of what was inspected, the deleted arms, and the executed controls."
        )),
      parent: in_project(project: "fabric-bringup", contribution: "One market for every match of work with resources, in one vocabulary, so a new application enters by declaring what it trades."),
    ),
    roadmap_node(
      identity: "rn_661NE623QDY0VFKYWMY1XW64J3",
      id: "lease-fence-one-identity",
      owner: "fleet",
      carriers: carrier(path: "dag/gunbc/plans/fabric_market.dag"),
      line: ticket(t: fields(
          headline: "One fence representation, built on std.durable_compare_and_set, serves every grant, reservation and seat while keeping each one's own scope",
          boundary: "Serves gunbc.plans.fabric_market, layer 0. The survey found five forms: std.temporal_effect LeaseEpoch, product.fabric.execution LeaseIdentity (an Int generation), product.capacity.lease LeaseFence, gunbc.fabric.fabric_control_plane CellReservation generations, and std.durable_exclusive_hold generations; gunbc.serving.caller_backlog AttemptFence joins two of them at one consumer. Generalize to the least general representation that covers them -- authority, resource or slot, holder, incarnation, generation over CasGeneration, resource fingerprint -- and delete the duplicated forms. A shared generation TYPE does not make a money-lease epoch, a durable-record version and a seat generation one counter: each keeps its own scope. Seat and cell occupancy stay two contracts (the serving-capacity-home ruling); only the fence representation is shared.",
          displaced_cost: "Every consumer that crosses two grant kinds needs its own adapter, and a stale-holder check written against one form silently misses the other.",
          first_slice: "The shared representation at its home and product.fabric.execution LeaseIdentity re-expressed on it, with admit_receipt_for_grant reading it.",
          red_control: "A receipt under a superseded generation is refused for every migrated kind; a receipt naming another resource fingerprint is refused; std.durable_exclusive_hold's cross-slot and reacquisition cases still refuse after migration; two counters of different scope never compare equal by sharing a type.",
          out_of_scope: "Merging seat and cell occupancy; admission and delegation (fabric-admission-and-delegation); the attempt record (execution-attempt-one-record).",
          handback: "The representation, each migrated consumer, the deleted forms, and the executed controls."
        )),
      parent: in_project(project: "fabric-bringup", contribution: "One market for every match of work with resources, in one vocabulary, so a new application enters by declaring what it trades."),
    ),
    roadmap_node(
      identity: "rn_Z1JMTR1HRVCD2YHJMNBGGK0SFD",
      id: "router-behaviour-disposition",
      owner: "fleet",
      carriers: carrier(path: "dag/gunbc/plans/fabric_market.dag"),
      line: ticket(t: fields(
          headline: "Every behaviour of the hand-written router, read back from the live configuration, has one disposition before the native router is built",
          boundary: "Serves gunbc.plans.fabric_market, layer 0 (gunbc.design_ruling::live_router_changes_of_2026_11_23_are_requirements_evidence). Read back the live router configuration and check gunbc.plans.fabric_market section 5 against it. Give each behaviour in the CUTOVER PARITY section of gunbc.instruments.router_proxy_falsifier, each 2026-11-23 change, and each rule carried only in router comments one disposition: preserved through the native route (with the falsifier case that proves it), moved to its lifecycle owner, expressed as market policy (naming the order term or matching term), or retired with a reason. The native router's acceptance is the preserved set; the cutover refreshes this table against the live file before the switch.",
          displaced_cost: "Parity with the old router is otherwise either inherited unquestioned (rented overflow, trim-bindings, which the relocation contract forbids) or decided ad hoc during the build.",
          first_slice: "The read-back of the live file, then the disposition table.",
          red_control: "A behaviour without a disposition keeps serving-router-native-transport from starting; a preserved behaviour without a falsifier case is not preserved; a disposition that keeps a router-local score, binding ledger or fallback contradicts gunbc.serving.router_realization router_capability_permission and is refused.",
          out_of_scope: "Building any of the dispositions; the switch itself (serving-router-lua-cutover).",
          handback: "The read-back with its date and host, and the disposition table."
        )),
      parent: in_project(project: "fabric-bringup", contribution: "One market for every match of work with resources, in one vocabulary, so a new application enters by declaring what it trades."),
    ),
    roadmap_node(
      identity: "rn_Q1W6GXFW82MK407N9YD8PX8RQ4",
      id: "fabric-market-plan-fold",
      owner: "planning",
      carriers: carrier(path: "dag/gunbc/plans/fabric_market.dag"),
      line: ticket(t: fields(
          headline: "The router plan's stages and acceptance move into the serving work items, the remote-build placement promise is one, and the demand engine's grant home is decided",
          boundary: "Serves gunbc.plans.fabric_market, layer 0. gunbc.plans.fabric_serving_router holds the S3 and R-S3 stages and acceptance as prose: move the exact obligations still owed into serving-router-native-transport and serving-relocation-realization, update every citation, then delete the plan or rewrite it as an intention under this one. Reconcile gunbc.compute.remote_build's two placement comments to gunbc.design_ruling::execution_is_one_first_principles_market_and_schedulers_are_venues. Resolve D7 of gunbc.plans.demand_engine_program (runner slots, fabric cell reservation or a new ledger as the grant home) against fabric-admission-and-delegation, and record demand-m5's M5(a) and M5(d) as consumers of the parent-grant contract. Leave M4's realization choices on std.decision without making them market allocations.",
          displaced_cost: "Two planning homes describe the serving router, the remote build promises two placement authorities, and the demand engine leaves its grant home open, so a worker on any of them has to choose between authorities.",
          first_slice: "The S3 and R-S3 obligations carried into the work items, with their citations moved.",
          red_control: "No plan prose restates a stage or an acceptance a work item now carries, and no citation names a removed section; gunbc.compute.remote_build makes one placement promise; D7 names one grant home; a cited grep of gunbc.plans states what was inspected.",
          out_of_scope: "Any code change beyond comments.",
          handback: "The moved obligations, the deleted or rewritten plan, the remote-build comment, the D7 resolution and the grep."
        )),
      parent: in_project(project: "fabric-bringup", contribution: "One market for every match of work with resources, in one vocabulary, so a new application enters by declaring what it trades."),
    ),
    roadmap_node(
      identity: "rn_AQTH8TAQ21SE1A99D8N5ZBMXEV",
      id: "market-fix-product-mapping",
      owner: "fleet",
      carriers: carrier(path: "dag/gunbc/plans/fabric_market.dag"),
      line: ticket(t: fields(
          headline: "The market module states what each FIX term means for execution resources, keeping order, allocation, computation and settlement apart",
          boundary: "Serves gunbc.plans.fabric_market, layer 1. Define the market layer over the FIX model and state its product mapping (gunbc.plans.fabric_market section 2): an order is a request to acquire a quantity of an identified instrument under declared terms; a selection is an attributable decision that admission can still refuse; a fill is a committed allocation linked to its grant and obligations; order status and execution reports are facts about the order and its allocations; a lease or fence is the authority to use what was allocated; a work attempt and its outcome are the computation; settlement and release dispose of the obligations on evidence. Three clocks stay separate: time in force bounds how long unmatched quantity may seek a fill; grant validity and occupancy bound the authority and when reuse is safe; work timing is the order's objective. Each instrument declares its divisibility; an indivisible bundle trades in quantity one. Quote keeps its FIX meaning. Roles carry stated obligations: a broker's best-execution duty against its client's objective; a market maker quotes both sides; the clearing role assumes that each fill is backed by capacity and is discharged by settlement. The objective belongs to the order, not to the work: two orders for one computation may differ in urgency without becoming different work. State the matching policy as the product's own (std.decision over several terms), which FIX permits rather than forbids. This item adds the vocabulary and the mapping; the replacements of existing names are their own cuts.",
          displaced_cost: "Without the mapping, workers implementing orders, grants, attempts and settlement can each follow the vocabulary and still build incompatible contracts, because a fill, a grant and a finished computation are easily read as one fact.",
          first_slice: "The mapping table and the order, time-in-force and fill types, with the lifecycle traces as controls.",
          red_control: "Executed traces: an immediate-or-cancel order partially filled and its remainder cancelled, with the fill still standing; an order expiring while work from an earlier fill keeps running and its grant is not released; a cancel racing a fill; a duplicate execution report leaving the original allocation unchanged; a fill whose quantity exceeds its order is refused; an order without a time in force is unwritable.",
          out_of_scope: "Renaming existing types (market-buy-order-replacement, market-sell-order-replacement); the matching rule (matching-engine-on-std-decision); the venue contract (venue-contract); the product_names anchor for fabric, decided when this lands (gunbc.plans.fabric_market section 7).",
          handback: "The module, the mapping, and the executed traces."
        )),
      parent: in_project(project: "fabric-bringup", contribution: "One market for every match of work with resources, in one vocabulary, so a new application enters by declaring what it trades."),
    ),
    roadmap_node(
      identity: "rn_C4X6RVKXFP41WGXYSZ1DAB1ZX9",
      id: "execution-attempt-one-record",
      owner: "fleet",
      carriers: carrier(path: "dag/gunbc/plans/fabric_market.dag"),
      line: ticket(t: fields(
          headline: "One execution-attempt record replaces the compute and fabric attempt records, keeping the effect attempts it contains distinct",
          boundary: "Serves gunbc.plans.fabric_market, layer 1. Canonicalize execution-attempt authority on product.fabric.execution Attempt and ExecutionAttemptLineage, re-expressing gunbc.compute.attempt_lifecycle AttemptRecord and gunbc.compute.durable_attempt_controller ControllerAttempt on it and deleting their duplicated identity. One work attempt contains several effect attempts -- submission, publication, cancellation, release -- each still bound to its own authorization and intent (std.temporal_effect EffectAttemptIntent); those relationships are kept, not flattened. The belt's own attempt state is migrated by factory-attempt-execution-on-fabric-lease, which consumes this record.",
          displaced_cost: "Two attempt records answer one question for compute and fabric, so a retry's cause and a stale attempt's fencing are checked twice and can disagree.",
          first_slice: "AttemptRecord re-expressed on the fabric Attempt, with the compute provider reading it.",
          red_control: "A retry that does not cite its cause receipt is refused; an effect attempt authorized for one intent cannot be replayed for another; the compute provider's recovery still refuses a stale generation after migration.",
          out_of_scope: "The belt's attempt state (factory-attempt-execution-on-fabric-lease); the fence representation (lease-fence-one-identity).",
          handback: "The record, the migrated consumers, the deleted duplicates, and the executed controls."
        )),
      parent: in_project(project: "fabric-bringup", contribution: "One market for every match of work with resources, in one vocabulary, so a new application enters by declaring what it trades."),
    ),
    roadmap_node(
      identity: "rn_FGMJS13Z3H0ZD6BTGJRT1E49Q7",
      id: "fabric-admission-and-delegation",
      owner: "fleet",
      carriers: carrier(path: "dag/gunbc/plans/fabric_market.dag"),
      line: ticket(t: fields(
          headline: "A fill authorizes execution only after one admission commits every resource and liability it needs, and delegated budgets conserve capacity down the hierarchy",
          boundary: "Serves gunbc.plans.fabric_market, layer 1 (the connection layer owns conservation; gunbc.plans.fabric_market section 2). Name the effect-facing admission boundary that turns a selection into a committed fill: it commits every required resource and money reservation together or none (the obligation product.fabric.execution and product.fabric.grant_issue already state), and decides between competing admissions for the same residual capacity. Establish delegation: a direct allocation or a delegated budget stays within its authority's bounds; a child consumes its parent's delegated budget and neither manufactures capacity nor charges it twice; a parent's expiry or revocation does not make capacity reusable while a child may still be running (std.resource_release_law); a relocation charges source and destination until the handoff establishes release. A venue allocating inside a pool grant is a child of that grant. work-exec-6-one-ledger-per-host stays the migration of every host consumer onto this authority.",
          displaced_cost: "Two matchers can select the same last slice and both believe they may dispatch; a venue or a nested scheduler inside a granted pool has no law that keeps it within the pool.",
          first_slice: "The admission boundary with all-or-none reservation commit, then the parent-child budget rules.",
          red_control: "Two concurrent admissions for one residual slice: exactly one commits; a selection without admission cannot dispatch; a child exceeding its parent's remaining budget is refused; a parent expiring with a live child leaves the capacity unreusable until the child is observed quiescent; a relocation overlap charges both sides; the assessable property is bounded overlapping commitments including unreleased occupancy, not one order per host.",
          out_of_scope: "Migrating every host consumer (work-exec-6-one-ledger-per-host); the fence representation (lease-fence-one-identity).",
          handback: "The admission boundary, the delegation rules, and the executed controls."
        )),
      parent: in_project(project: "fabric-bringup", contribution: "One market for every match of work with resources, in one vocabulary, so a new application enters by declaring what it trades."),
    ),
    roadmap_node(
      identity: "rn_16HWZMCDDBQTSNJSASQQ09D1BN",
      id: "market-buy-order-replacement",
      owner: "fleet",
      carriers: carrier(path: "dag/gunbc/plans/fabric_market.dag"),
      line: ticket(t: fields(
          headline: "BuyTerms and maximum_buy_order are replaced by the buy order, keeping every monetary distinction the current contract makes",
          boundary: "Serves gunbc.plans.fabric_market, layer 2; one atomic semantic replacement (gunbc.design_argument::replacement_migration): establish the replacement meaning, migrate every consumer, delete the predecessor. The current contract distinguishes MaximumLiability (reserved before granting), SelectionCost (compared, including valued delay), ActualSpend (settled afterwards) and maximum_buy_order (the liability ceiling for one grant). The buy order must keep each: quantity, price basis, duration or billing quantum, encumbered liability, comparison valuation and actual settlement. A unit limit price alone does not preserve a total liability ceiling.",
          displaced_cost: "Renaming without the monetary decomposition would silently lose the liability ceiling, which is what refuses an over-cap grant today.",
          first_slice: "The buy order with its monetary terms, and BuyTerms' first consumer migrated.",
          red_control: "An order whose encumbered liability exceeds its ceiling is refused before any grant; selection cost and actual spend stay distinct readings; a cited grep shows no surviving BuyTerms or maximum_buy_order declaration or consumer.",
          out_of_scope: "SupplierOffer (market-sell-order-replacement); the matching rule.",
          handback: "The replacement, the migrated consumers, the deleted predecessor and the executed controls."
        )),
      parent: in_project(project: "fabric-bringup", contribution: "One market for every match of work with resources, in one vocabulary, so a new application enters by declaring what it trades."),
    ),
    roadmap_node(
      identity: "rn_KQ8KP6WD5WBBYT0DJD5QCDV9C0",
      id: "market-sell-order-replacement",
      owner: "fleet",
      carriers: carrier(path: "dag/gunbc/plans/fabric_market.dag"),
      line: ticket(t: fields(
          headline: "SupplierOffer is decomposed into supply, instrument and sell-order terms, and deleted",
          boundary: "Serves gunbc.plans.fabric_market, layer 2; one atomic semantic replacement. product.fabric.supply SupplierOffer carries capabilities, route, availability, trust and isolation, and pricing evidence. Distribute each fact to its home -- the supply unit, the instrument, or the sell order -- migrate every consumer (including CandidateOffer construction in product.fabric.candidate_field), and delete SupplierOffer. Standing owned capacity is a resting sell order.",
          displaced_cost: "A type rename alone would keep five concerns fused under a new name.",
          first_slice: "The decomposition table: each SupplierOffer field and its new home.",
          red_control: "Each field's fact is readable from exactly one home; an offer without evidence for its price stays unknown, never zero; a cited grep shows no surviving SupplierOffer declaration or consumer.",
          out_of_scope: "The buy side (market-buy-order-replacement).",
          handback: "The decomposition, the migrated consumers, the deleted predecessor and the executed controls."
        )),
      parent: in_project(project: "fabric-bringup", contribution: "One market for every match of work with resources, in one vocabulary, so a new application enters by declaring what it trades."),
    ),
    roadmap_node(
      identity: "rn_YJYFSJQ7ZF5A1GYPADVF1QYFVJ",
      id: "venue-contract",
      owner: "fleet",
      carriers: carrier(path: "dag/gunbc/plans/fabric_market.dag"),
      line: ticket(t: fields(
          headline: "Every executor realizes one venue contract: it accepts a committed fill, never re-matches it, and states which execution guarantees it provides",
          boundary: "Serves gunbc.plans.fabric_market, layer 2 (gunbc.design_ruling::execution_is_one_first_principles_market_and_schedulers_are_venues). Build on product.fabric.execution (ExecutionGrant, Receipt, admit_receipt_for_grant). The contract: accept a committed fill and refuse a stale or foreign one; never re-match; enforce the granted limits; report typed terminal outcomes through execution-uncertainty-one-carrier; cancel with termination evidence; re-observe accepted work after a restart. Four execution guarantees are kept apart, and each venue's delegated terms state which it realizes: one logical acceptance of a repeated submission (durable dispatch identity and deduplication); one physical execution, only where an ownership mechanism actually provides it (a Kubernetes Job may start twice, which work-exec-2 already allows); one authoritative published result (fenced, create-only publication); and correct accounting while duplicates or overlaps run (every possible occupant within the authorized budget). An order resting in the book is market state; granted work awaiting placement inside a pool is venue state under a delegated term; the contract says which waiting interval each report describes. A venue's own placement inside a granted pool is a delegated term naming what we would build to take it back. First realizations: gunbc.compute.work_provider_local and gunbc.compute.remote_build. The Kubernetes and Kueue term list is written against work-exec-1's criteria.",
          displaced_cost: "Each route has its own accept and report vocabulary (a string receipt, a WorkOutcome, the belt's spawn outcomes), so every consumer and reviewer reconciles them, and a scheduler adopted later would arrive with a fourth.",
          first_slice: "The contract over product.fabric.execution, with gunbc.compute.work_provider_local as its first realization.",
          red_control: "A fill for another attempt or a superseded generation is refused; a repeated submission is accepted once; a duplicate physical start publishes one result and stays within budget; a venue that re-matches (the remote build roster walk, unchanged) fails the contract's control; an uncertain ending is reported uncertain, never as failure or success.",
          out_of_scope: "Choosing the scheduler (work-exec-1); the durable route (work-exec-2), which consumes this contract; the serving router's realization (serving-router-native-transport).",
          handback: "The contract, the first realizations, each venue's statement of which guarantees it provides, the Kubernetes and Kueue delegated-term list, and the executed controls."
        )),
      parent: in_project(project: "fabric-bringup", contribution: "One market for every match of work with resources, in one vocabulary, so a new application enters by declaring what it trades."),
    ),
    roadmap_node(
      identity: "rn_WRBW4MY22PEPH4GK3AATRW44RN",
      id: "matching-engine-on-std-decision",
      owner: "fleet",
      carriers: carrier(path: "dag/gunbc/plans/fabric_market.dag"),
      line: ticket(t: fields(
          headline: "One matching engine on std.decision, in both directions, with a run-time term per candidate, replaces select_supply's single-duration pricing and every other host pick",
          boundary: "Serves gunbc.plans.fabric_market, layer 2 (gunbc.design_ruling::market_vocabulary_is_fix_and_matching_is_std_decision). Rebuild product.fabric.selection select_supply and select_resource_budget_supply on std.decision over std.pareto axes; reconcile product.fabric.flex_market's ranking onto it; and give product.fabric.contention select_demand_for_offer (demand-side matching, no production importer today) an explicit disposition: folded into the engine if resting orders need demand-side matching, deleted otherwise, never kept alive by a manufactured consumer. The result is the whole attributed outcome, not only a receipt: order identity and decision scope (std.decision DecisionScope) on every arm -- selected, needs evidence, needs policy, refused, no feasible candidate, field unestablished -- and a successful selection is distinct from the admission that may still refuse it (fabric-admission-and-delegation), with the link from selection to committed fill recorded. Each candidate gets a run-time or throughput reading derived from the existing measurement authorities (product.fabric.serving_throughput, gunbc.compute.work_class_grant WorkloadProfile), conditioned on workload, configuration, retained state and load, with its evidence standing. Commissioned resource funding (ResourceBudgetPolicy) stays representable without inventing a money reading and never becomes an escape from an economic refusal. The host picks outside the core get their disposition from the route inventory (gunbc.plans.fabric_market section 4): remote-build roster order, fabric_control_plane and harness_seat roster-order tie-breaks. Consumes the objective and standing of fabric-demand-objective and fabric-consequence-standing rather than restating them.",
          displaced_cost: "Two decision engines answer one question, demand-side matching has no caller, and because one duration prices every candidate the operator's preference for faster owned hosts cannot be expressed at all.",
          first_slice: "select_supply returning the attributed std.decision outcome with its current cost terms unchanged, then the run-time term.",
          red_control: "Under a declared objective with every other funded term equal, a candidate whose read run time is shorter wins; with its run time unread it does not win on speed and the outcome says the reading is missing; changing the objective changes a genuine tradeoff and leaves a dominated choice unchanged; every non-selected arm carries the order identity and scope; a selected candidate refused at admission does not dispatch; removing the run-time axis turns the first control red.",
          out_of_scope: "The demand objective itself (fabric-demand-objective); relocation's realization (serving-relocation-realization); measuring owned operating cost (gunbc.rung_drop serving_cost_axes_asserted_unmeasured keeps its own trigger).",
          handback: "The rebuilt engine, the contention disposition, its consumers, the disposition of each host pick, and the executed controls."
        )),
      parent: in_project(project: "fabric-bringup", contribution: "One market for every match of work with resources, in one vocabulary, so a new application enters by declaring what it trades."),
    ),
    roadmap_node(
      identity: "rn_FYNA8RB27PJWTPJJ784FVAJ54G",
      id: "serving-router-native-transport",
      owner: "fleet",
      carriers: carrier(path: "dag/gunbc/plans/fabric_market.dag"),
      line: ticket(t: fields(
          headline: "A native serving router realizes router_capability_permission as a pure transport, and owned replicas reach the market as sell orders",
          boundary: "Serves gunbc.plans.fabric_market, layer 3; stage S3 of gunbc.plans.fabric_serving_router, whose obligations fabric-market-plan-fold moves here. The router normalises a request, asks the market for a fill, takes the endpoint from the committed fill, proxies bytes without re-encoding them, and releases the seat; it computes no score, picks no host, keeps no authoritative binding ledger and forwards nothing without a permit. Owned replicas become sell orders through product.fabric.candidate_field assemble_candidate_field. Acceptance runs against an isolated venue with real test grants; in production it first runs in side-effect-free shadow, which returns proposed matches only (a carrier that cannot dispatch), never a committed fill, so it reserves nothing and moves nothing. Never touches the hand-patched router on srv1. One permit header name, reconciling x-seat-permit and x-gunbc-seat-permit.",
          displaced_cost: "The live router decides placement in Lua outside the market, so no policy the market learns reaches serving.",
          first_slice: "Owned replicas admitted as sell orders, then the native router answering from fills against the isolated venue.",
          red_control: "Each behaviour router-behaviour-disposition preserves executes as its falsifier case against the native route on the isolated venue; a request with no committed fill is refused, never placed; a shadow decision cannot dispatch; a re-encoded body (gunbc.recurring_failure_mode a_request_rewrite_that_reencodes_the_body_it_edits_reorders_the_keys_downstream_reads) is caught.",
          out_of_scope: "Relocation (serving-relocation-realization); the switch and deletion of the Lua (serving-router-lua-cutover).",
          handback: "The native router, the owned-replica sell orders, the executed falsifier cases, and the shadow comparison."
        )),
      parent: in_project(project: "fabric-bringup", contribution: "One market for every match of work with resources, in one vocabulary, so a new application enters by declaring what it trades."),
    ),
    roadmap_node(
      identity: "rn_NY71EYG7YZ0P69TJN3KEEDN3G6",
      id: "serving-relocation-realization",
      owner: "fleet",
      carriers: carrier(path: "dag/gunbc/plans/fabric_market.dag"),
      line: ticket(t: fields(
          headline: "A session moves between replicas only through the fenced relocation handoff, selected when the gain beats the cost of moving",
          boundary: "Serves gunbc.plans.fabric_market, layer 4; the R-S3 frontier of gunbc.plans.fabric_serving_router, whose requirements and seven acceptance cases fabric-market-plan-fold moves here unchanged. gunbc.serving.serving_relocation decide_relocation and decide_evacuation get their evidence (the run-time term from matching-engine-on-std-decision and a reconstruction-cost estimate under the declared one-reconstruction allowance) and a production caller in the native router. Source and destination are both charged until the handoff establishes release (fabric-admission-and-delegation). A drain halts new admission on the replica and relocates or terminates the sessions already there: for relocation, stay is removed and the same decision chooses where to go.",
          displaced_cost: "The operator's arbitrage and drain-and-move goals are modeled and never run, while the hand-written router moves sessions outside any fenced handoff.",
          first_slice: "decide_relocation fed by real readings and called from the native router, with the successful-move case of the falsifier.",
          red_control: "The seven cases of the R-S3 acceptance, each red when its rule is removed, executed on the real route against the isolated venue.",
          out_of_scope: "Cross-engine KV transfer; a fleet-wide optimizer; the replay and measurement study (a named follow-up).",
          handback: "The realization and the seven executed cases."
        )),
      parent: in_project(project: "fabric-bringup", contribution: "One market for every match of work with resources, in one vocabulary, so a new application enters by declaring what it trades."),
    ),
    roadmap_node(
      identity: "rn_WKVMHRTS9DQ513E9NSBY5NXEEG",
      id: "serving-router-lua-cutover",
      owner: "fleet",
      carriers: carrier(path: "dag/gunbc/plans/fabric_market.dag"),
      line: ticket(t: fields(
          headline: "The hand-written Lua router is deleted in one switch, the deployed route is verified switched, and nothing falls back to it",
          boundary: "Serves gunbc.plans.fabric_market, layer 5. Refresh router-behaviour-disposition against the live file. Account for bindings and streams in flight at the switch: which owner finishes them and how their grants are released. Delete gunbc.serving.router_dev_policy, router_dev_scaffold and their debt rows in the same change (gunbc.design_argument::replacement_migration; gunbc.recurring_failure_mode the_replaced_route_is_the_replacement_s_miss_path). Two separate pieces of evidence: the source retirement (the modules gone from the tree) and a read-back that the deployed route is the native one and the Lua path is gone from the host. Before the first production fill, every target host either clears through the shared admission authority (fabric-admission-and-delegation), or provides an explicitly funded serving partition, a delegated budget whose capacity every remaining allocator (build, session and runner pools) excludes from what it offers; existing occupants and relocation overlap stay charged. The partition option lets serving cut over before work-exec-6-one-ledger-per-host migrates every host consumer.",
          displaced_cost: "Two routers decide placement for one fleet, and the hand-written one carries rulings that exist only as its comments.",
          first_slice: "The refreshed disposition table and the in-flight accounting, before any switch.",
          red_control: "A request the native route cannot place is refused and never reaches the Lua path; a stream in flight at the switch completes or is released by its owner; the deployed read-back shows the native route serving; before the switch, a concurrent-load control on each target host -- serving fills alongside build and session allocations at capacity -- shows no capacity promised twice and the excess refused.",
          out_of_scope: "Behaviour the disposition table retires; new market policy beyond what the dispositions require.",
          handback: "The refreshed table, the switch, the deletions, the deployed read-back, and the executed controls."
        )),
      parent: in_project(project: "fabric-bringup", contribution: "One market for every match of work with resources, in one vocabulary, so a new application enters by declaring what it trades."),
    ),
    roadmap_node(
      identity: "rn_9HTGHV23AEQG0SVCF8KGXSCXJ5",
      id: "fabric-market-convergence",
      owner: "fleet",
      carriers: carrier(path: "dag/gunbc/plans/fabric_market.dag"),
      line: ticket(t: level_fields(
          headline: "Every route that matches work with resources runs on the one market: serving, builds, CI, the belt and the demand engine",
          boundary: "Milestone of gunbc.plans.fabric_market, layer 6. It is met when its prerequisites are accepted: the serving cutover; the buy and sell replacements; work-exec-6-one-ledger-per-host (and through it the work-execution program's identity split, durable route, local-work and CI migrations); factory-attempt-execution-on-fabric-lease (the belt); demand-m5 (the demand engine's occupancy on the parent-grant contract); serving-capacity-qualification (every enrolled engine qualified, with requalification); and serving-engine-level-seller (the market one level down, inside an engine). Those keep their own intentions and owners; this node is the market's completion coverage over them. The intention's done-when is then assessed against the tree, executed controls, deployment read-back and the operator's judgement, each as section 1 of the plan labels it.",
          approach: "Prerequisite edges only: the market nodes of this intention, and the existing work-execution, belt and demand-engine nodes, which keep their own bindings.",
          red_control: "Executed traces over the converged routes: concurrent admission across serving, sessions and builds never over-commits a host; a stale selection cannot dispatch; missing evidence stays missing; an attached session does not move outside its declared transition; an uncertain ending does not cause a second execution elsewhere; release after disconnect, timeout, cancel or restart neither frees consumed capacity nor strands it; disconnecting the market from a consumer turns that consumer's control red.",
          displaced_cost: "Without a completion node the market's terminals cover only the serving chain, and the builds, CI, belt and demand-engine migrations its done-when promises sit outside its dependency closure.",
          handback: "Per prerequisite, its acceptance; for the milestone, the cross-route traces and the done-when assessment."
        )),
      parent: in_project(project: "fabric-bringup", contribution: "One market for every match of work with resources, in one vocabulary, so a new application enters by declaring what it trades."),
    ),
    roadmap_node(
      identity: "rn_PW3S88PGJQRNEP1YQR05YH1M1K",
      id: "serving-capacity-qualification",
      owner: "fleet",
      carriers: carrier(path: "dag/gunbc/plans/fabric_market.dag"),
      line: ticket(t: fields(
          headline: "Every enrolled serving engine is qualified from its own measured readings at several concurrencies and workloads, and requalified when its launch or grant changes",
          boundary: "Serves gunbc.plans.fabric_market (the market is recursive: a fixed cap is a standing offer sized from a reading). Today gunbc.serving.serving_capacity_anchor serving_capacity_shape takes turns as the concurrency of the row's single aggregate reading when its average per turn clears the least stream rate (no per-stream check), so two streams at 19 and 1 tok/s pass a 10 tok/s floor. At this node's writing (2026-11-25) that gives srv1 4 per card from the pair's 8-session run (gunbc.serving.srv1_topology_comparison, 679 tok/s split evenly over two boards, a pair average rather than a reading of either), srv3 2 from its engine log (26 tok/s at two groups), srv4 1 from a figure borrowed from srv3, and each h11 engine 1 from a router note, also bounded by its grant; the rows, not this text, are the authority. Scope is every enrolled engine or GPU group -- srv1's two replicas, srv3, srv4 and each h11 engine -- and every rented route records which authority enforces its limit (its launch's --max-concurrency, or a named provider). Give each gunbc.serving.serving_replica_profile row its own readings -- per board, at more than one concurrency, and per workload (short fresh turns, long cold prefills, warm continuations, a mixed arrival) -- produced by the serving benchmark (gunbc.serving.serving_benchmark) with per-stream decode rate, tail time to first token, tail inter-token latency, preemptions, OOMs, worker restarts and memory peaks (GPU and host) recorded. A reading is reused only while the run identity matches (model, engine build, cache settings, topology, resource grant); a change to the launch or grant withdraws the operating points it qualified and schedules requalification, and qualification runs as a job, not a manual exercise. The shape then selects turns among the readings through std.decision under the conversation policy (aggregate output with every stream at or above the least stream rate, zero preemptions, no OOM or restart). The hand-set cap 6 on srv1's live router (2026-11-25, out of band) becomes a reading on each srv1 row if its trial qualifies, and the rendered config is read back against the live one.",
          displaced_cost: "Caps are raised by hand on the live router and then drift from the repository, which renders 4; each deployment change asks the operator for another number.",
          first_slice: "srv1's two rows, each with its own readings at 4 and 6 active turns, and the shape selecting between them; then srv3, srv4 and h11 in the same row shape.",
          red_control: "A reading at higher concurrency with more aggregate output but one stream below the least stream rate is not selected even when the average clears it; a reading with a preemption is not selected; a reading where a worker OOMs or restarts with zero recorded preemptions is not selected; a reading taken under a different run identity refuses; a changed launch or grant withdraws the higher operating point; a reading taken on one board does not change the other board's cap; a rented route with no named limit authority refuses.",
          out_of_scope: "Per-request admission by cost (serving-engine-level-seller); choosing which engine runs where (the matching engine).",
          handback: "Per enrolled engine, its readings and selected operating point; the requalification trigger; each rented route's limit authority; the rendered caps against the live router; and the executed controls."
        )),
      parent: in_project(project: "fabric-bringup", contribution: "One market for every match of work with resources, in one vocabulary, so a new application enters by declaring what it trades."),
    ),
    roadmap_node(
      identity: "rn_V7JYZS9BHXS8YKZJYBD35ZZNPV",
      id: "serving-engine-level-seller",
      owner: "fleet",
      carriers: carrier(path: "dag/gunbc/plans/fabric_market.dag"),
      line: ticket(t: fields(
          headline: "An engine sells its own capacity: it quotes what a request of a given context and growth would reserve, and the router admits on that quote",
          boundary: "Serves gunbc.plans.fabric_market (the market is recursive), at the engine level: the instrument is KV blocks plus per-step tokens, the buyer a request, the seller the engine. With stock vLLM the engine is a black box and a count cap stands in for memory; an engine we realize (the new engine being trialled for Flash Next) can quote a reservation for a request's context and permitted growth, accept or refuse it atomically, and report a reclaimed reservation (a preemption) as a broken fill. Sellers quote; the one matching engine selects among eligible quotes under the order's terms (throughput is a term, arrival order is not); shared admission commits the reservation within the parent grant; and the router, as a venue, forwards the committed fill and never re-matches it. A bound conversation keeps its replica (its cached context lives there) unless the relocation operation moves it. A preemption is read against the fill's terms: a pause and resume under the same grant is an observation, a broken fill only where the seller withdrew an obligation it sold (such as uninterrupted residency), and occupancy stays charged until release is established. Host RAM is a constraint at the host level above, so an engine's quote never stands for the host's. A watched turn keeps its isolation rule (gunbc.serving.turn_admission) unless a measurement and a ruling change it.",
          displaced_cost: "A count cap is right only for one request size: it wastes cards on short turns and overcommits on long ones, and the router estimates memory it cannot see.",
          first_slice: "The engine's quote and reservation contract on one replica, with the router admitting on it.",
          red_control: "At the same active count, a short turn is admitted and a long one refused; two eligible quotes arriving in reverse order of their throughput ranking select the faster one when the order values throughput; two concurrent arrivals cannot both take the last reservation; a pause and resume under the same grant is recorded without being reported as a broken fill, and a withdrawn residency guarantee is; occupancy is not released before release is established; a bound conversation is not moved by a free quote elsewhere.",
          out_of_scope: "Choosing the engine; measuring caps for count-capped replicas (serving-capacity-qualification); relocation itself (serving-relocation-realization).",
          handback: "The quote and reservation contract, the router's admission on it, and the executed controls."
        )),
      parent: in_project(project: "fabric-bringup", contribution: "One market for every match of work with resources, in one vocabulary, so a new application enters by declaring what it trades."),
    ),
    // ---- gunbc.plans.claim_execution_consolidation (operator, 2026-11-22,
    // gunbc.design_ruling::claim_execution_has_one_v1_entrypoint): two slices. The cutover depends on the
    // result contract (edge below), and its public authority transition stays one atomic change.
    roadmap_node(
      identity: "rn_E730R1GNB3TG65E6TWZKBWEKAJ",
      id: "claim-result-contract",
      owner: "harness",
      carriers: carrier(path: "dag/gunbc/plans/claim_execution_consolidation.dag"),
      line: ticket(t: fields(
          headline: "gunbc test reports one located outcome per selected claim, and its seed adapter realizes the existing verdict rule",
          boundary: "Serves gunbc.plans.claim_execution_consolidation, layer 0. Keep the verdict policy in gunbc.target_invocation and repair its seed realization: claim_route_verdict stops reading every ExitFailure as did-not-hold, so a typed ProcessExit failure with code 2 is unobserved. The claim route establishes the selected claim identities once, gives each exactly one outcome, and derives both the printed lines and the exit status from that collection; a resolve failure is located and the other claims still run.",
          displaced_cost: "The same witness reads red, unreached or absent depending on the tool that ran it, so every caller and reviewer pays to know which reading they hold; a short report can read as held.",
          first_slice: "Fixture claims for held, false, non-Bool, runtime error, unwind, budget interrupt and ExitFailure code 2 and code 1, each run through the real gunbc test path with its printed verdict and exit status asserted; then the identity-keyed result collection in the seed claim route.",
          red_control: "Held, false and unobserved each map as gunbc.target_invocation says; false together with unobserved exits 1 and reports both; an empty selection exits 2; ExitFailure code 2 exits 2; A holds, B cannot resolve, C holds runs A and C, locates B and does not exit 0; a duplicated outcome for A cannot satisfy B. The checks execute the seed adapter and invocation path, not only the model's pure fold.",
          out_of_scope: "Repeated operands, the execution-mode option, caller migration and the deletion of claim_batch and gunbc run --claim-run (claim-entrypoints-cutover). Any change to the verdict policy itself, which already exists.",
          handback: "The repaired adapter and the identity-keyed result path, with each red control's command, revision and output; executed locally or on a fleet host and stated as such, not as required-CI enforcement."
        )),
      dispatch: dispatchable(),
      parent: in_project(project: "factory", contribution: "One meaning for a claim result, the factory's most trusted verdict channel."),
      centering: plan(text: "Work in src/v1/stage0/src/target_invocation_host.rs and the seed claim route in cli_run.rs against dag/gunbc/target_invocation.dag; author the fixture claims under dag/test/claim; run them with gunbc test on a fleet host under the memory envelope, one claim run at a time."),
    ),
    roadmap_node(
      identity: "rn_GZNX0MEATVZC3JHN1ZF1E8AG4M",
      id: "claim-entrypoints-cutover",
      owner: "harness",
      carriers: carrier(path: "dag/gunbc/plans/claim_execution_consolidation.dag"),
      line: ticket(t: fields(
          headline: "Every claim_batch and gunbc run --claim-run caller names claims through gunbc test, and both old entrypoints are deleted in one change",
          boundary: "Serves gunbc.plans.claim_execution_consolidation, layer 1. Give every caller named in the plan's observation a disposition: migrated, retired, or blocked on native support, whose route then stays frozen. gunbc test accepts several operands and runs exactly the claims they denote in one process, with overlapping operands selected once and no widening to a subtree. Add only the execution-mode option (std.execution_mode::ExecutionMode, Hermetic by default) and fixture-store support callers need; unsupported route combinations refuse. Never send a //v2/... label to the interpreter.",
          displaced_cost: "Three argument grammars and three outcome readings for one evaluator; every caller, instrument and release roster carries a second binary and its build.",
          first_slice: "The disposition of each named caller, read from its source: what observation its consumer needs, which source roots it passes and whether they matter, and whether any src/v2/test/claim or out-of-universe function it evaluates needs claim evaluation or native-execution evidence.",
          red_control: "A caller with no disposition, or one whose observation is lost, keeps the cutover open; a sparse request widened to :all or a subtree, or split into one process per claim, is refused; a mode the native or instrument route cannot honour refuses explicitly; a //v2/... label reaching the interpreter is refused. The cost comparison (one exact label against claim_batch on github_pull_request_decode_witness, and one representative pooled request) shows no repeated closure construction, unrelated discovery or material resource regression.",
          out_of_scope: "The verdict and result-collection repair (claim-result-contract); native claim execution itself; adding any CI claim-executing step, which gunbc.design_ruling::no_ci_claim_execution_until_native_frontier_clears forbids.",
          handback: "The caller disposition table, the migrated callers, the deletion of claim_batch, gunbc run --claim-run, their build and release entries and their own witnesses, a cited grep stating what it inspected, and the two cost readings with producer and revision."
        )),
      dispatch: dispatchable(),
      parent: in_project(project: "factory", contribution: "One command for running claims, inherited unchanged by the native compiler."),
      centering: plan(text: "Read each named caller first and write the disposition table into the pull request before any deletion; land the operand and mode support, the caller migrations and the deletions as one change; measure on a fleet host under the memory envelope."),
    ),
    roadmap_node(
      identity: "rn_44VKSHNX2ZNTDRCPGGNSFJWCWN",
      id: "2-scm-git-upstream-model",
      owner: "source-intent",
      carriers: carrier(path: "docs/plans/dag-scm-design.md"),
      line: ticket(t: fields(
        headline: "Write down how Git really stores things",
        boundary: "Describe Git on its own terms: files, folders, commits, tags, file permissions, symlinks, links to other repositories, and how it names and finds them. Prove it by reading a small repository and writing it back unchanged.",
        displaced_cost: "If we invent a one-size-fits-all model first, it quietly drops things like executable permissions and symlinks — and every tool built on top inherits the loss.",
        first_slice: "Finish the storage description, then read one small repository and write it back unchanged.",
        red_control: "A plain file, an executable file, a symlink, a link to another repository, and a tag all stay distinguishable; writing against an out-of-date starting point refuses instead of overwriting; a missing object never reads as empty.",
        out_of_scope: "No shared source-control interface, no hosting or server work, and no guessing that a renamed file is the same file.",
        handback: "The model with citations to Git's own docs, the read/write-back receipts, the refusal receipt, and a list of anything we still cannot represent."
      )),
      dispatch: dispatchable(),
      parent: in_project(project: "factory", contribution: "Write down how Git really stores things."),
    ),
    roadmap_node(
      identity: "rn_5JX128MQ9XYR760B5CFC3VECTN",
      id: "2-scm-mercurial-upstream-model",
      owner: "source-intent",
      carriers: carrier(path: "docs/plans/dag-scm-design.md"),
      line: ticket(t: fields(
        headline: "Write down how Mercurial really works, in its own words",
        boundary: "Describe Mercurial from its own documentation: its permanent change IDs versus the numbers local to one copy, its branches, bookmarks, tags, and its draft/published states. Use no Git vocabulary.",
        displaced_cost: "Mercurial's ideas are not Git's. Renaming them into Git words loses the differences, and a later shared design would be built on a mistranslation.",
        first_slice: "Write the description and read one small repository back out, leaving anything we cannot safely write marked unavailable.",
        red_control: "A copy-local revision number can change while the permanent change ID does not; draft, published, and hidden stay three different things; a bookmark, a named branch, and a branch tip cannot collapse into one idea.",
        out_of_scope: "No Mercurial support in the product, no shared source-control interface, and no faking missing facts from timestamps.",
        handback: "The description with citations, the read-back receipt, an explicit list of what we cannot do yet, and the differences that must survive into any later shared design."
      )),
      dispatch: dispatchable(),
      parent: in_project(project: "factory", contribution: "Write down how Mercurial really works, in its own words."),
    ),
    roadmap_node(
      identity: "rn_5MGS40RC9NE9HPFA4V5M2VVR19",
      id: "2-scm-pijul-upstream-model",
      owner: "source-intent",
      carriers: carrier(path: "docs/plans/dag-scm-design.md"),
      line: ticket(t: fields(
        headline: "Write down how Pijul really works, in its own words",
        boundary: "Describe Pijul from its own documentation: individual changes that carry their own identity, what each change depends on, and how a channel is a set of changes rather than a pointer to the newest one.",
        displaced_cost: "Pijul does not have a 'latest commit'. Modelling it as if it does erases the thing that makes it different, and a third viewpoint is what stops us from mistaking Git's habits for universal truth.",
        first_slice: "Write the description, then apply a small set of changes, read them back, and try them in a different order.",
        red_control: "A channel cannot be reduced to one newest commit; one change keeps the same identity in two channels; applying a change whose prerequisites are missing refuses instead of applying an empty change.",
        out_of_scope: "No Pijul support in the product, no adopting its conflict rules as ours, and no shared source-control interface.",
        handback: "The description with citations, the round-trip and out-of-order receipts, and an explicit list of what we cannot do yet."
      )),
      dispatch: dispatchable(),
      parent: in_project(project: "factory", contribution: "Write down how Pijul really works, in its own words."),
    ),
    roadmap_node(
      identity: "rn_629P2SF909R5C71V2HPCK4TJMD",
      id: "2-claim-indexed-evidence",
      owner: "deduction",
      carriers: carrier(path: "docs/plans/dag-scm-design.md"),
      line: ticket(t: fields(
        headline: "Say once what counts as evidence for a claim",
        boundary: "One shared way to record a fact, state a claim, and link evidence that supports or contradicts it — including how much a piece of evidence can prove on its own. Three existing features adopt it.",
        displaced_cost: "Right now each feature invents its own yes/no test, so a weak signal gets promoted into a confident claim. 'We stored a login' starts meaning 'the login works'.",
        first_slice: "Reuse what already exists for this, then run it through the three features that need it and check they agree.",
        red_control: "A stored login plus a failed live request supports 'we have a credential' but not 'the service is ready'; contradictory evidence stays contradictory and missing evidence stays missing, rather than the newest answer winning.",
        out_of_scope: "No source-control solver, no per-feature copy of the idea, and no treating 'we recorded this' as proof that it is true.",
        handback: "The shared model, receipts from all three features, the supports/contradicts/both/neither cases, and anything the substrate still cannot express."
      )),
      dispatch: dispatchable(),
      parent: in_project(project: "factory", contribution: "Say once what counts as evidence for a claim."),
    ),
    roadmap_node(
      identity: "rnfx_DQV1HD42VR40BA8WBP1Y",
      id: "2-scm-compatibility-shape",
      owner: "source-intent",
      carriers: carrier(path: "docs/plans/dag-scm-design.md"),
      line: ticket(t: fields(
        headline: "Extract the compatibility realization shape from three upstream receipts",
        boundary: "Consume the independently executing Git, Mercurial, and Pijul R0 boundaries and extract only their demonstrated roles: opaque target/generation handles, an independently required fidelity disposition for each retained or lost capture axis, projection/read-back identity, and modeled-or-unavailable conditional-advance capability. Native receipts retain every upstream-specific fact; dispatch is a generic handler value, never ScmKind or a vendor switch.",
        displaced_cost: "Lets the native edit → submit → outcome contract project through plural SCMs without forcing users into Git mechanics or erasing Mercurial/Pijul distinctions into a first-adapter abstraction.",
        first_slice: "Bind each R0 fixture through its native decoder and read-back assessment, replace C0's optional Git projection slot with realization-indexed receipts, and execute one fixed C0 proposal through Git, Mercurial, Pijul, and a synthetic fourth handler.",
        red_control: "C0 proposal identity, transition, and primary outcome stay unchanged across all realizations; missing or differently grounded conditional advance refuses; a read-back mismatch refuses; the fourth handler requires no primary-contract or kernel edit.",
        out_of_scope: "No semantic candidate space, admission policy, repair capability, executed transition, Applied receipt, universal commit/ref/channel type, hosted service, writable Mercurial/Pijul target, or central realization enum.",
        handback: "Return the shared role carrier, three native adapter receipts, fidelity/capability matrix, realization-indexed C0 projection with idempotent replacement identity, and the exact distinctions deliberately left native."
      )),
      dispatch: dispatchable(),
      parent: in_project(project: "factory", contribution: "The daily workspace is native SCM's only consumer today."),
    ),
    roadmap_node(
      identity: "rn_026DCFC306A7B44B061483AA71",
      id: "2-scm-p0-landing-spine",
      owner: "source-intent",
      carriers: carrier(path: "docs/plans/dag-scm-design.md"),
      line: ticket(t: fields(
        headline: "Make submit → landed the default source-control journey",
        boundary: "Model one submitted change through result finding, permission checks, committing, independent read-back, and compatibility projection. The normal user sees only landed, one concrete choice, or a plain reason the change could not land; synchronization and unfinished investigation stay inside the system.",
        displaced_cost: "Without the complete spine, each later solver or storage slice can leak its own vocabulary and repair ritual into the interface. This fixes the product boundary before the proof kernel and write transport make it expensive to change.",
        first_slice: "Carry the proposal contract, full-claim P−1 readiness receipts, all seven semantic closure receipts, zero/one/many/unclosed result space, admission, transition, projection status, 50-agent/10-overlap stress profile, and timestamp non-authority through one executing scenario corpus.",
        red_control: "Removing any closure receipt leaves the operation running inside the system; blocking evidence does not become a user question; both displayed answers resume automatically; unauthorized, self-amending, exhausted-bound, and permanent-effect cases retain typed refusals and plain explanations; a stale target retries internally; projection failure after a committed and independently read-back transition stays landed; primary messages contain neither internal theory words nor manual Git repair commands; an ordinary Git compatibility projection remains attached.",
        out_of_scope: "No P1 proof kernel, source parser or edit lens, effect transport, command-line product, hosted service, writable Mercurial/Pijul target, or claim that a modeled transition has executed.",
        handback: "Return the layered landing-spine carrier, the tightened two-or-more-option continuation contract, twenty-two executing journey witnesses, the R1 compatibility projection edge, and the exact P1/P2/P3 work still deliberately absent."
      )),
      dispatch: dispatchable(),
      parent: in_project(project: "factory", contribution: "The daily workspace is native SCM's only consumer today."),
    ),

    roadmap_node(
      identity: "rn_52ZXVWC7S94RYF4YJHZCN00GCS",
      id: "namespace-occurrence-transport",
      owner: "namespace",
      carriers: carrier(path: "dag/gunbc/plans/names_without_imports.dag"),
      line: ticket(t: fields(
        headline: "Keep track of exactly which name is which",
        boundary: "When the compiler sees a name, carry along exactly where it was written and exactly which declaration it came from. Carrying that information, not yet deciding what it means.",
        displaced_cost: "The compiler currently throws away where a name came from and then tries to reconstruct it, so two different things with the same short name can be confused.",
        first_slice: "Carry one ordinary type name and its declaration's location through the compiler without keeping a second copy of that information.",
        red_control: "Two things written in different places that happen to share a short name stay distinguishable; a missing or made-up location refuses instead of being guessed.",
        out_of_scope: "No nearest-match lookup, no falling back to 'there is only one of these anywhere', and no rules specific to one part of the compiler.",
        handback: "The working mechanism plus a test that two same-named things in different places really do stay apart."
      )),
      dispatch: dispatchable(),
      parent: in_project(project: "namespace-unique-on-chain", contribution: "Carrying occurrences exactly is what every later stage keys on."),
    ),
    roadmap_node(
      identity: "rn_KFQ7I41NISIGTPGPWND9NDJEML",
      id: "namespace-binding-kernel",
      owner: "namespace",
      carriers: carrier(path: "dag/gunbc/plans/names_without_imports.dag"),
      line: ticket(t: fields(
        headline: "One canonical decision authority, handed the candidates rather than finding them",
        boundary: "Given a list of things a name could refer to, decide: none, exactly one, or more than one. Checking that what it was handed is well formed and of a kind that could match. NOT working out which declarations are in view — that is the next step. Owns the canonical decision itself; does NOT own removing the older mechanisms that still decide it their own way.",
        displaced_cost: "Several lookup mechanisms exist today and they can disagree about the same name, which is how a program silently ends up meaning something other than what was written. Separating the decision from the search makes the decision reviewable on its own.",
        first_slice: "Validate what was handed in, then call the one decision function exactly once on a candidate list supplied from outside.",
        red_control: "Malformed occurrence transport refuses; a declaration of the wrong kind is excluded; a candidate given in the wrong role refuses, distinctly from one that is absent; the same declaration supplied twice refuses as a malformed population rather than counting as two; and supplied lists of nothing, one thing, and two distinct things give unresolved, resolved, and ambiguous respectively.",
        out_of_scope: "Does not work out which declarations are visible, does not order them by where they were written, does not build an index, and does not claim the wider naming work is finished. Does not require the older deciding mechanisms to be gone — that is the retirement node's job, and holding it here would block the next step on work the next step does not need.",
        handback: "The decision function plus worked none/one/many examples actually run, with the malformed-population and wrong-role refusals executing."
      )),
      dispatch: dispatchable(),
      parent: in_project(project: "namespace-unique-on-chain", contribution: "One kernel decides none/one/many given candidates."),
    ),
    roadmap_node(
      identity: "rn_7QF3M2KDX8VNAT6JWZR0PC5HY",
      id: "namespace-structural-observations",
      owner: "namespace",
      carriers: carrier(path: "dag/gunbc/plans/names_without_imports.dag"),
      line: ticket(t: updated(t: fields(
        headline: "Work out what a name can see from where it is written, inside one file",
        boundary: "Make an ordinary compiled path produce, for each name written in a file, the declarations actually in view from that position, and record which one answered. Four cases, each shown on its own: an ordinary neighbour written earlier in the same file is in view; a declaration inside a different branch of a decision is not; a declaration written further down is not; and two declarations spelled the same at genuinely different positions stay distinct rather than merging.",
        displaced_cost: "The parser walk that can answer this already exists and is switched on, but nothing in an ordinary compile asks it. Until it is asked on a real compile, every claim about what a name can see rests on hand-built examples, and the four rules above are asserted rather than observed.",
        first_slice: "Write the closing check for this row first, then make one ordinary compiled file produce all four observations through it.",
        red_control: "Each of the four cases fails on its own when the rule is broken: a neighbour written earlier goes missing, a declaration from another branch leaks in, one written further down leaks in, or two same-spelled declarations merge into one.",
        out_of_scope: "Names answered by another file, and working out what a file depends on — both belong to the next row. Does not change the check that closes the parent row, and does not stand in for the cases it does not cover.",
        handback: "One ordinary compiled file producing all four observations, each case shown failing on its own, and the closing check written and bound."
      ), on: "2026-09-30", note: "Awaiting the operator's acceptance event: namespace_structural_observations_closing_contract_holds_on_one_ordinary_compiled_file (dag/test/claim/namespace_structural_observations_acceptance.dag), its bound contract; evidence #9554.")),
      dispatch: dispatchable(),
      execution: bound(contract: namespace_structural_observations_execution_contract()),
