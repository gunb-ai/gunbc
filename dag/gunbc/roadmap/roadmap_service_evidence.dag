module gunbc.roadmap_service_evidence

import std.types { String, Bool, Int, List, NonEmptyStr }
import extdeps.filesystem.filesystem_io {
  FilesystemFileObservation, FilesystemFileAbsent, FilesystemFileRead, FilesystemFileIndeterminate,
  FilesystemFileObservationsDisagree, FilesystemFileSubjectRefused,
}
import gunbc.filesystem_file_observe { filesystem_file_observation_of_path }
import extdeps.languages.json.emit { JsonValue, serialize_json, json_object, json_kv, json_string, json_int, json_array }
import extdeps.languages.json.parse { parse_json_document, JsonDocumentParsed, JsonDocumentUnreadable }
import std.content_hash { content_hash_of_value }
import std.materialization_provider { wire_content_hash_to_hex }
import gunbc.roadmap_model { RoadmapNodeId }
import gunbc.roadmap_dashboard_instance { HostDashboardInstance }
import gunbc.roadmap_dispatch_actuator { dispatch_attempt_launch_path_for_instance }
import gunbc.roadmap_launch_admission {
  launch_identity_of_json, LaunchIdentityDecoded, LaunchIdentityUnreadable, launch_identity_node_id_text,
}

// THE SERVICE EVIDENCE RECEIPT (roadmap node service-evidence-capture). One joined reading per
// attempt, bound to the (node, attempt_key) identity the dogfood route uses, over every field the
// node lists. It is a PURE JOIN COMPUTED ON READ, never a stored copy: each joined reader's own
// record is already durable in attempt state, so persisting the join would give those facts a
// second home (DESIGN §2/§3), and a write on an early tick would freeze fields that mature later
// (ruling relayed by bold-bee-114, 2026-10-03). The immutable artifact is the dogfood START receipt
// (gunbc.roadmap_dogfood_route, gunbc#13077), which pins this receipt's digest and per-field
// standing once, when the start is recorded.
//
// THE JOIN RULE, BY CONSTRUCTION (review 74774). This module measures nothing, and the receipt
// cannot say otherwise. A field is either READER-OWNED (ReaderField: its one reader is
// reader_field_reader) or has NO PRODUCER YET (UnbuiltField: its owning node is
// unbuilt_field_owner). The receipt has ONE NAMED SLOT PER READER-OWNED FIELD and none for an
// unbuilt one, so a field cannot be missing, duplicated or out of order, an unbuilt field has no
// slot an observed value could be written into, and a slot's reading carries no source -- the
// source is derived from the slot, so a reading cannot name a reader other than its field's.
// There is therefore no validator: every receipt that can be written is valid.

// ── THE FIELDS, partitioned by whether a reader owns them ──
type ReaderField
  = WorkloadClass
  | ResourceRequest
  | WaitTime
  | ExecutionTime
  | CompletionTime
  | CacheHits
  | CacheMisses
  | CacheSharedMisses
  | CacheCorruptHitRefusals
  | Placement
  | SeatUtilization
  | ArtifactBytes
  | FailureAttribution
  | BillableUsage

type UnbuiltField
  = Egress
  | RecoveryAction
  | OperatorInterventionTime
  | HardwareHealth
  | BillableCredits
  | WorkspaceRecoveryPoint
  | WorkspaceRecoveryTime

type ServiceEvidenceField
  = ReaderOwnedField { field: ReaderField }
  | UnbuiltProducerField { field: UnbuiltField }

fn rf(f: ReaderField) -> ServiceEvidenceField { ReaderOwnedField { field: f } }
fn uf(f: UnbuiltField) -> ServiceEvidenceField { UnbuiltProducerField { field: f } }

// The node's list, in its order.
data service_evidence_fields: List<ServiceEvidenceField> = [
  rf(f: WorkloadClass), rf(f: ResourceRequest), rf(f: WaitTime), rf(f: ExecutionTime), rf(f: CompletionTime),
  rf(f: CacheHits), rf(f: CacheMisses), rf(f: CacheSharedMisses), rf(f: CacheCorruptHitRefusals),
  rf(f: Placement), rf(f: SeatUtilization), rf(f: ArtifactBytes), uf(f: Egress),
  rf(f: FailureAttribution), uf(f: RecoveryAction), uf(f: OperatorInterventionTime), uf(f: HardwareHealth),
  rf(f: BillableUsage), uf(f: BillableCredits), uf(f: WorkspaceRecoveryPoint), uf(f: WorkspaceRecoveryTime),
]

fn reader_field_wire(f: ReaderField) -> String {
  match f {
    WorkloadClass => "workload_class"
    ResourceRequest => "resource_request"
    WaitTime => "wait_time"
    ExecutionTime => "execution_time"
    CompletionTime => "completion_time"
    CacheHits => "cache_hits"
    CacheMisses => "cache_misses"
    CacheSharedMisses => "cache_shared_misses"
    CacheCorruptHitRefusals => "cache_corrupt_hit_refusals"
    Placement => "placement"
    SeatUtilization => "seat_utilization"
    ArtifactBytes => "artifact_bytes"
    FailureAttribution => "failure_attribution"
    BillableUsage => "billable_usage"
  }
}

fn unbuilt_field_wire(f: UnbuiltField) -> String {
  match f {
    Egress => "egress"
    RecoveryAction => "recovery_action"
    OperatorInterventionTime => "operator_intervention_time"
    HardwareHealth => "hardware_health"
    BillableCredits => "billable_credits"
    WorkspaceRecoveryPoint => "workspace_recovery_point"
    WorkspaceRecoveryTime => "workspace_recovery_time"
  }
}

fn service_evidence_field_wire(f: ServiceEvidenceField) -> String {
  match f {
    ReaderOwnedField { field } => reader_field_wire(f: field)
    UnbuiltProducerField { field } => unbuilt_field_wire(f: field)
  }
}

// ── THE READERS THIS RECEIPT MAY CONSUME, and nothing else ──
// Readers are compared by variant, never by text; the citation below is wire output only.
type ServiceEvidenceReader
  = MeteringReader
  | SessionPlacementReader
  | SharedComputationReader
  | ResultReturnedReader

fn service_evidence_reader_wire(r: ServiceEvidenceReader) -> String {
  match r {
    MeteringReader => "gunbc.roadmap_attempt_metering metering_observe_for_attempt"
    SessionPlacementReader => "gunbc.roadmap_session_placement session_placement_observe_for_attempt"
    SharedComputationReader => "gunbc.roadmap_belt_actuate shared_computation_observe_for_attempt"
    ResultReturnedReader => "gunbc.roadmap.roadmap_result_returned result_returned_observe_for_attempt"
  }
}

// Whether the reader is on main. A reader not yet landed makes every field it owns Owed naming its
// pull request; when the PR lands its arm here becomes ReaderLanded and the same change binds its
// fields' Observed readings in reader_slot_reading (one arm per reader).
type ServiceEvidenceReaderStanding
  = ReaderLanded
  | ReaderPending { pr: Int }

fn service_evidence_reader_standing(r: ServiceEvidenceReader) -> ServiceEvidenceReaderStanding {
  match r {
    MeteringReader => ReaderPending { pr: 13073 }
    SessionPlacementReader => ReaderPending { pr: 13074 }
    SharedComputationReader => ReaderPending { pr: 13097 }
    ResultReturnedReader => ReaderPending { pr: 13075 }
  }
}

// ── THE ONE SOURCE AUTHORITY PER FIELD ──
fn reader_field_reader(f: ReaderField) -> ServiceEvidenceReader {
  match f {
    WorkloadClass => SessionPlacementReader
    ResourceRequest => SessionPlacementReader
    WaitTime => SessionPlacementReader
    ExecutionTime => MeteringReader
    CompletionTime => ResultReturnedReader
    CacheHits => SharedComputationReader
    CacheMisses => SharedComputationReader
    CacheSharedMisses => SharedComputationReader
    CacheCorruptHitRefusals => SharedComputationReader
    Placement => SessionPlacementReader
    SeatUtilization => SessionPlacementReader
    ArtifactBytes => SharedComputationReader
    FailureAttribution => ResultReturnedReader
    BillableUsage => MeteringReader
  }
}

// The roadmap node that owns a missing producer. Where no other node owns it, the owner is this
// node, whose later slices build it (it is in scope here, not deferred elsewhere); naming it states
// the obligation rather than inventing a producer.
fn unbuilt_field_owner(f: UnbuiltField) -> String {
  match f {
    Egress => "service-evidence-capture"
    RecoveryAction => "service-evidence-capture"
    OperatorInterventionTime => "service-evidence-capture"
    HardwareHealth => "fleet-health-0-live-receipt"
    BillableCredits => "failure-billing-outcomes"
    WorkspaceRecoveryPoint => "fabric-storage"
    WorkspaceRecoveryTime => "fabric-storage"
  }
}

// ── A SLOT'S READING. There is no default: unknown is owed or refused, never zero. ──
// The reading carries no source and no producer: both are derived from the slot's field.
type ReaderSlotReading
  = SlotObserved { value: String }
  | SlotOwed
  | SlotRefused { reason: NonEmptyStr }

// The reading for one reader-owned field. Today every reader is pending, so it is owed; each
// reader's landing replaces its ReaderLanded arm with the bound reading.
fn reader_slot_reading(f: ReaderField) -> ReaderSlotReading {
  match service_evidence_reader_standing(r: reader_field_reader(f: f)) {
    ReaderPending { pr: _ } => SlotOwed
    ReaderLanded => SlotRefused { reason: join(["the reader ", service_evidence_reader_wire(r: reader_field_reader(f: f)), " is landed but no reading is bound for ", reader_field_wire(f: f)], "") as NonEmptyStr }
  }
}

// ── THE RECEIPT: one named slot per reader-owned field ──
type ServiceEvidenceReceipt {
  node_id: NonEmptyStr
  attempt_key: NonEmptyStr
  workload_class: ReaderSlotReading
  resource_request: ReaderSlotReading
  wait_time: ReaderSlotReading
  execution_time: ReaderSlotReading
  completion_time: ReaderSlotReading
  cache_hits: ReaderSlotReading
  cache_misses: ReaderSlotReading
  cache_shared_misses: ReaderSlotReading
  cache_corrupt_hit_refusals: ReaderSlotReading
  placement: ReaderSlotReading
  seat_utilization: ReaderSlotReading
  artifact_bytes: ReaderSlotReading
  failure_attribution: ReaderSlotReading
  billable_usage: ReaderSlotReading
}

fn service_evidence_receipt_slot(r: ServiceEvidenceReceipt, f: ReaderField) -> ReaderSlotReading {
  match f {
    WorkloadClass => r.workload_class
    ResourceRequest => r.resource_request
    WaitTime => r.wait_time
    ExecutionTime => r.execution_time
    CompletionTime => r.completion_time
    CacheHits => r.cache_hits
    CacheMisses => r.cache_misses
    CacheSharedMisses => r.cache_shared_misses
    CacheCorruptHitRefusals => r.cache_corrupt_hit_refusals
    Placement => r.placement
    SeatUtilization => r.seat_utilization
    ArtifactBytes => r.artifact_bytes
    FailureAttribution => r.failure_attribution
    BillableUsage => r.billable_usage
  }
}

// THE ONE MINT. The attempt is bound by its launch identity before this is called.
fn service_evidence_receipt_join(node_id: NonEmptyStr, attempt_key: NonEmptyStr) -> ServiceEvidenceReceipt {
  ServiceEvidenceReceipt {
    node_id: node_id,
    attempt_key: attempt_key,
    workload_class: reader_slot_reading(f: WorkloadClass),
    resource_request: reader_slot_reading(f: ResourceRequest),
    wait_time: reader_slot_reading(f: WaitTime),
    execution_time: reader_slot_reading(f: ExecutionTime),
    completion_time: reader_slot_reading(f: CompletionTime),
    cache_hits: reader_slot_reading(f: CacheHits),
    cache_misses: reader_slot_reading(f: CacheMisses),
    cache_shared_misses: reader_slot_reading(f: CacheSharedMisses),
    cache_corrupt_hit_refusals: reader_slot_reading(f: CacheCorruptHitRefusals),
    placement: reader_slot_reading(f: Placement),
    seat_utilization: reader_slot_reading(f: SeatUtilization),
    artifact_bytes: reader_slot_reading(f: ArtifactBytes),
    failure_attribution: reader_slot_reading(f: FailureAttribution),
    billable_usage: reader_slot_reading(f: BillableUsage),
  }
}

// ── THE CLOSED PER-FIELD READING, derived for every field of the roster ──
// Observed{value, source reader} | Owed{producer} | Refused{reason}. The source and the producer
// are computed from the field, so an Observed reading's reader is always the field's own and an
// unbuilt field is always owed to its owning node.
type ServiceEvidenceProducer
  = PendingReader { reader: ServiceEvidenceReader, pr: Int }
  | LandedReaderUnbound { reader: ServiceEvidenceReader }
  | UnbuiltProducer { owner_node: String }

type ServiceEvidenceReading
  = EvidenceObserved { value: String, source: ServiceEvidenceReader }
  | EvidenceOwed { producer: ServiceEvidenceProducer }
  | EvidenceRefused { reason: NonEmptyStr }

fn reader_owed_producer(reader: ServiceEvidenceReader) -> ServiceEvidenceProducer {
  match service_evidence_reader_standing(r: reader) {
    ReaderPending { pr } => PendingReader { reader: reader, pr: pr }
    ReaderLanded => LandedReaderUnbound { reader: reader }
  }
}

fn service_evidence_slot_projection(f: ReaderField, slot: ReaderSlotReading) -> ServiceEvidenceReading {
  match slot {
    SlotObserved { value } => EvidenceObserved { value: value, source: reader_field_reader(f: f) }
    SlotOwed => EvidenceOwed { producer: reader_owed_producer(reader: reader_field_reader(f: f)) }
    SlotRefused { reason } => EvidenceRefused { reason: reason }
  }
}

fn service_evidence_reading(r: ServiceEvidenceReceipt, f: ServiceEvidenceField) -> ServiceEvidenceReading {
  match f {
    UnbuiltProducerField { field } => EvidenceOwed { producer: UnbuiltProducer { owner_node: unbuilt_field_owner(f: field) } }
    ReaderOwnedField { field } => service_evidence_slot_projection(f: field, slot: service_evidence_receipt_slot(r: r, f: field))
  }
}

// ── THE OBSERVATION bold-bee-114's start receipt requires ──
type ServiceEvidenceObservation
  = ServiceEvidenceJoined { receipt: ServiceEvidenceReceipt }
  | ServiceEvidenceAttemptUnlaunched
  | ServiceEvidenceRefused { reason: String }

// Pure over the launch-identity file observation: the identity must be non-empty and the record at
// this attempt's path must decode and name this node, or there is no attempt to join evidence for.
// These are the only refusals: every receipt the join builds is valid by construction.
fn service_evidence_observe_from_launch(node_id: String, attempt_key: String, launch: FilesystemFileObservation) -> ServiceEvidenceObservation {
  if node_id == "" { ServiceEvidenceRefused { reason: "node_id is empty" } }
  else if attempt_key == "" { ServiceEvidenceRefused { reason: "attempt_key is empty" } }
  else { match launch {
    FilesystemFileAbsent(_) => ServiceEvidenceAttemptUnlaunched
    FilesystemFileIndeterminate { cause } => ServiceEvidenceRefused { reason: cause }
    FilesystemFileObservationsDisagree { path: _, cause } => ServiceEvidenceRefused { reason: cause }
    FilesystemFileSubjectRefused { directory: _, name: _, cause } => ServiceEvidenceRefused { reason: cause }
    FilesystemFileRead { path: _, content } =>
      match parse_json_document(s: content) {
        JsonDocumentUnreadable { gap: _ } => ServiceEvidenceRefused { reason: "the attempt's launch identity is not a JSON document" }
        JsonDocumentParsed { value: doc } =>
          match launch_identity_of_json(doc: doc) {
            LaunchIdentityUnreadable { reason } => ServiceEvidenceRefused { reason: reason }
            LaunchIdentityDecoded { identity } =>
              if launch_identity_node_id_text(id: identity) != node_id {
                ServiceEvidenceRefused { reason: join(["the launch identity at this attempt's path names node ", launch_identity_node_id_text(id: identity)], "") }
              } else {
                ServiceEvidenceJoined { receipt: service_evidence_receipt_join(node_id: node_id as NonEmptyStr, attempt_key: attempt_key as NonEmptyStr) }
              }
          }
      }
  } }
}

fn service_evidence_observe_for_attempt(instance: HostDashboardInstance, node_id: RoadmapNodeId, attempt_key: String) -> ServiceEvidenceObservation {
  service_evidence_observe_from_launch(
    node_id: node_id as String,
    attempt_key: attempt_key,
    launch: filesystem_file_observation_of_path(path: dispatch_attempt_launch_path_for_instance(instance: instance, node_id: node_id, attempt_key: attempt_key)),
  )
}

// ── THE CANONICAL WIRE AND ITS DIGEST, what the start receipt pins ──
fn service_evidence_producer_json(p: ServiceEvidenceProducer) -> JsonValue {
  match p {
    PendingReader { reader, pr } => json_object([
      json_kv(key: "kind", value: json_string(s: "pending_reader")),
      json_kv(key: "reader", value: json_string(s: service_evidence_reader_wire(r: reader))),
      json_kv(key: "pr", value: json_int(n: pr)),
    ])
    LandedReaderUnbound { reader } => json_object([
      json_kv(key: "kind", value: json_string(s: "landed_reader_unbound")),
      json_kv(key: "reader", value: json_string(s: service_evidence_reader_wire(r: reader))),
    ])
    UnbuiltProducer { owner_node } => json_object([
      json_kv(key: "kind", value: json_string(s: "unbuilt_producer")),
      json_kv(key: "owner_node", value: json_string(s: owner_node)),
    ])
  }
}

fn service_evidence_reading_json(f: ServiceEvidenceField, reading: ServiceEvidenceReading) -> JsonValue {
  let field = json_kv(key: "field", value: json_string(s: service_evidence_field_wire(f: f)))
  match reading {
    EvidenceObserved { value, source } => json_object([field,
      json_kv(key: "standing", value: json_string(s: "observed")),
      json_kv(key: "value", value: json_string(s: value)),
      json_kv(key: "source", value: json_string(s: service_evidence_reader_wire(r: source))),
    ])
    EvidenceOwed { producer } => json_object([field,
      json_kv(key: "standing", value: json_string(s: "owed")),
      json_kv(key: "producer", value: service_evidence_producer_json(p: producer)),
    ])
    EvidenceRefused { reason } => json_object([field,
      json_kv(key: "standing", value: json_string(s: "refused")),
      json_kv(key: "reason", value: json_string(s: reason as String)),
    ])
  }
}

data service_evidence_receipt_schema: String = "service-evidence-receipt/v1"

fn service_evidence_receipt_wire(r: ServiceEvidenceReceipt) -> String {
  serialize_json(v: json_object([
    json_kv(key: "schema", value: json_string(s: service_evidence_receipt_schema)),
    json_kv(key: "node_id", value: json_string(s: r.node_id as String)),
    json_kv(key: "attempt_key", value: json_string(s: r.attempt_key as String)),
    json_kv(key: "fields", value: json_array(map(service_evidence_fields, f => service_evidence_reading_json(f: f, reading: service_evidence_reading(r: r, f: f))))),
  ]))
}

fn service_evidence_receipt_digest(r: ServiceEvidenceReceipt) -> String {
  wire_content_hash_to_hex(hash: content_hash_of_value(value: service_evidence_receipt_wire(r: r) as NonEmptyStr))
}

// ── THE NODE'S CLOSING CONTRACT (roadmap node service-evidence-capture) ──
//
// The node closes when no field is owed or refused: every field is reader-owned and its reader is
// landed and bound. Missing fields are a set difference over the roster, never a count, so this is
// RED today and greens only when the last one binds. When the first reader binds, a slot's reading
// becomes per attempt, and this predicate is re-authored over the dogfood start receipt's pinned
// evidence (its consumer, gunbc#13077) in that same change.
fn service_evidence_owed_fields() -> List<ServiceEvidenceField> {
  filter(service_evidence_fields, f => match f {
    UnbuiltProducerField { field: _ } => true
    ReaderOwnedField { field } => match reader_slot_reading(f: field) {
      SlotObserved { value: _ } => false
      SlotOwed => true
      SlotRefused { reason: _ } => true
    }
  })
}

fn service_evidence_capture_acceptance_holds() -> Bool {
  count(service_evidence_owed_fields()) == 0
}
