module gunbc.roadmap_service_evidence

import std.types { String, Bool, Int, List, NonEmptyStr }
import extdeps.filesystem.filesystem_io {
  FilesystemFileObservation, FilesystemFileAbsent, FilesystemFileRead, FilesystemFileIndeterminate,
  FilesystemFileObservationsDisagree, FilesystemFileSubjectRefused,
}
import gunbc.filesystem_file_observe { filesystem_file_observation_of_path }
import extdeps.languages.json.emit { JsonValue, serialize_json, json_object, json_kv, json_string, json_int, json_array }
import extdeps.languages.json.parse { parse_json_document, JsonDocumentParsed, JsonDocumentUnreadable }
import std.content_hash { content_hash_of_value }
import std.materialization_provider { wire_content_hash_to_hex }
import gunbc.roadmap_model { RoadmapNodeId }
import gunbc.roadmap_dashboard_instance { HostDashboardInstance }
import gunbc.roadmap_dispatch_actuator { dispatch_attempt_launch_path_for_instance }
import std.measure { Kibibyte, kibibyte_count }
import gunbc.roadmap_session_placement {
  SessionPlacementObservation, SessionPlacementObserved, SessionPlacementAbsent, SessionPlacementUnreadable, SessionPlacementForeign,
  SessionGrantRecorded, SessionGrantNotRecorded, SessionGrantUnreadable, SessionGrantForeign, SessionPlacementRecord,
  session_placement_observe_for_attempt,
}
import gunbc.roadmap_launch_admission {
  attempt_launch_record_of_json, AttemptLaunchBound, AttemptLaunchUnbound, AttemptLaunchUnreadable,
  launch_identity_node_id_text, launch_identity_instance_text, launch_identity_revision_hex,
}

// THE SERVICE EVIDENCE RECEIPT (roadmap node service-evidence-capture). One joined reading per
// attempt over every field the node lists, bound to ONE attempt of ONE node on ONE dashboard
// instance. It is a PURE JOIN COMPUTED ON READ, never a stored copy: each joined reader's own
// record is already durable in attempt state, so persisting the join would give those facts a
// second home (DESIGN §2/§3), and a write on an early tick would freeze fields that mature later
// (ruling relayed by bold-bee-114, 2026-10-03). The immutable artifact is the dogfood START receipt
// (gunbc.roadmap_dogfood_route, gunbc#13077), which pins this receipt's digest and per-field
// standing once, when the start is recorded.
//
// THE SHAPE (side-chat NO-LAND ruling on c8b743d, relayed by bold-bee-114):
//   1. the effectful boundary BINDS the attempt from its durable launch record (which names the
//      node, the dashboard instance and the attempt) and GATHERS one typed input per reader, once
//      per attempt;
//   2. the receipt is that binding and that bundle, nothing else -- it carries no reading, so no
//      reading can be written into it;
//   3. every field's reading is DERIVED from the bundle into one closed product
//      (ServiceEvidenceReadings, 21 named fields), which the wire and the closing contract both
//      read. An Observed reading exists only as the projection of a landed reader's typed
//      observation (today G5, gunbc.roadmap_session_placement); every other reader is pending.
//   The ordered view (service_evidence_entries) is WITNESSED against the node's list, not
//   structurally guaranteed: the language has no record-member iteration (rung 2).

// ── 1. THE ATTEMPT BINDING ──
// Admitted only when the attempt's launch record (gunbc.roadmap_launch_admission
// AttemptLaunchRecordDecode) names the expected node, the expected dashboard instance AND the
// expected attempt. A legacy record that carries no attempt key is unbound and refuses: it cannot
// say which attempt it belongs to, and such attempts never qualify for the dogfood clock.
type AttemptBinding {
  instance_id: NonEmptyStr
  node_id: NonEmptyStr
  attempt_key: NonEmptyStr
  revision_hex: NonEmptyStr
}

type AttemptBindingOutcome
  = AttemptBound { binding: AttemptBinding }
  | AttemptUnlaunched
  | AttemptBindingRefused { reason: String }

fn file_refusal(o: FilesystemFileObservation, what: String) -> String? {
  match o {
    FilesystemFileRead { path: _, content: _ } => none
    FilesystemFileAbsent(_) => Present { value: join([what, " is absent"], "") }
    FilesystemFileIndeterminate { cause } => Present { value: join([what, ": ", cause], "") }
    FilesystemFileObservationsDisagree { path: _, cause } => Present { value: join([what, ": ", cause], "") }
    FilesystemFileSubjectRefused { directory: _, name: _, cause } => Present { value: join([what, ": ", cause], "") }
  }
}

fn file_content(o: FilesystemFileObservation) -> String {
  match o {
    FilesystemFileRead { path: _, content } => content
    FilesystemFileAbsent(_) => ""
    FilesystemFileIndeterminate { cause: _ } => ""
    FilesystemFileObservationsDisagree { path: _, cause: _ } => ""
    FilesystemFileSubjectRefused { directory: _, name: _, cause: _ } => ""
  }
}

fn launch_is_absent(o: FilesystemFileObservation) -> Bool {
  match o {
    FilesystemFileAbsent(_) => true
    FilesystemFileRead { path: _, content: _ } => false
    FilesystemFileIndeterminate { cause: _ } => false
    FilesystemFileObservationsDisagree { path: _, cause: _ } => false
    FilesystemFileSubjectRefused { directory: _, name: _, cause: _ } => false
  }
}

fn names_attempt(recorded: NonEmptyStr, attempt_key: String) -> Bool {
  (recorded as String) == attempt_key
}

fn service_evidence_bind_attempt(
  instance_id: String,
  node_id: String,
  attempt_key: String,
  launch: FilesystemFileObservation,
) -> AttemptBindingOutcome {
  if instance_id == "" { AttemptBindingRefused { reason: "instance_id is empty" } }
  else if node_id == "" { AttemptBindingRefused { reason: "node_id is empty" } }
  else if attempt_key == "" { AttemptBindingRefused { reason: "attempt_key is empty" } }
  else if launch_is_absent(o: launch) { AttemptUnlaunched }
  else {
    match file_refusal(o: launch, what: "the attempt's launch record") {
      Present { value: why } => AttemptBindingRefused { reason: why }
      Absent =>
        match parse_json_document(s: file_content(o: launch)) {
          JsonDocumentUnreadable { gap: _ } => AttemptBindingRefused { reason: "the attempt's launch record is not a JSON document" }
          JsonDocumentParsed { value: doc } =>
            match attempt_launch_record_of_json(doc: doc) {
              AttemptLaunchUnreadable { reason } => AttemptBindingRefused { reason: reason }
              AttemptLaunchUnbound { identity: _ } => AttemptBindingRefused { reason: "the attempt's launch record carries no attempt key, so it cannot be bound to this attempt" }
              AttemptLaunchBound { identity, attempt_key: recorded } =>
                if launch_identity_node_id_text(id: identity) != node_id {
                  AttemptBindingRefused { reason: join(["the launch record at this attempt's path names node ", launch_identity_node_id_text(id: identity)], "") }
                } else if launch_identity_instance_text(id: identity) != instance_id {
                  AttemptBindingRefused { reason: join(["the launch record at this attempt's path names instance ", launch_identity_instance_text(id: identity)], "") }
                } else if !names_attempt(recorded: recorded, attempt_key: attempt_key) {
                  AttemptBindingRefused { reason: join(["the launch record at this attempt's path names attempt ", recorded as String], "") }
                } else {
                  AttemptBound { binding: AttemptBinding {
                    instance_id: instance_id as NonEmptyStr,
                    node_id: node_id as NonEmptyStr,
                    attempt_key: attempt_key as NonEmptyStr,
                    revision_hex: launch_identity_revision_hex(id: identity) as NonEmptyStr,
                  } }
                }
            }
        }
    }
  }
}

// ── 2. THE READERS AND THEIR TYPED INPUTS ──
// The closed reader vocabulary. Readers are compared by variant; the citation is wire output only.
type ServiceEvidenceReader
  = MeteringReader
  | SessionPlacementReader
  | SharedComputationReader
  | ResultReturnedReader

fn service_evidence_reader_wire(r: ServiceEvidenceReader) -> String {
  match r {
    MeteringReader => "gunbc.roadmap_attempt_metering metering_observe_for_attempt"
    SessionPlacementReader => "gunbc.roadmap_session_placement session_placement_observe_for_attempt"
    SharedComputationReader => "gunbc.roadmap_belt_actuate shared_computation_observe_for_attempt"
    ResultReturnedReader => "gunbc.roadmap.roadmap_result_returned result_returned_observe_for_attempt"
  }
}

// ONE INPUT PER LANDED READER. A reader on main is a member of the bundle carrying that reader's
// own typed observation, gathered once per attempt; its fields are derived from NAMED members of that
// observation, re-checking the observation's (node, attempt) against the binding. A reader not yet on
// main has NO member: its fields are derived as owed to it (pending_reader_owed), and its pull
// request is derived from the reader (reader_pending_pr), so nothing a caller supplies can reach the
// canonical wire for it. No member carries a bare value, so no field can be observed without its
// reader's record. When a pending reader lands, its change adds its member exactly as G5's below.
type SessionPlacementInput = SessionPlacementRead { observation: SessionPlacementObservation }

type ServiceEvidenceInputs {
  session_placement: SessionPlacementInput
}

// THE READERS NOT YET ON MAIN, as their own coproduct: a landed reader (G5) has no arm here, so a
// field cannot be recorded as pending a reader that has already landed (side-chat note on b422c05).
// A reader's landing deletes its arm here and adds its member to ServiceEvidenceInputs.
type PendingServiceReader
  = PendingMetering
  | PendingSharedComputation
  | PendingResultReturned

fn pending_reader(r: PendingServiceReader) -> ServiceEvidenceReader {
  match r {
    PendingMetering => MeteringReader
    PendingSharedComputation => SharedComputationReader
    PendingResultReturned => ResultReturnedReader
  }
}

fn reader_pending_pr(r: PendingServiceReader) -> Int {
  match r {
    PendingMetering => 13073
    PendingSharedComputation => 13097
    PendingResultReturned => 13075
  }
}

// The effectful gather, once per bound attempt: every landed reader is called exactly once.
fn service_evidence_inputs_for_attempt(instance: HostDashboardInstance, binding: AttemptBinding) -> ServiceEvidenceInputs {
  ServiceEvidenceInputs {
    session_placement: SessionPlacementRead { observation: session_placement_observe_for_attempt(instance: instance, node_id: binding.node_id as String, attempt_key: binding.attempt_key as String) },
  }
}

// ── THE RECEIPT: the binding and the bundle, and no reading ──
type ServiceEvidenceReceipt {
  binding: AttemptBinding
  inputs: ServiceEvidenceInputs
}

// ── 3. THE CLOSED PER-FIELD READING, typed per field; there is no default and no zero ──
// Two slot kinds (review 75015, DESIGN §2: a String leaf hiding named parts is anemic modeling):
//   a field whose reader has LANDED holds ServiceEvidenceReading<T>, where T is the typed carrier the
//     reader's record establishes (a placement with named parts, the work-class grant, Kibibyte);
//   a field with no landed source holds ServiceEvidenceOwed, which has NO observed arm, so nothing can
//     be observed for it until its reader lands and that change gives the field its typed carrier.
// Values become text only in the wire encoder (service_evidence_entries / service_evidence_entry_json).
type ServiceEvidenceReading<T>
  = EvidenceObserved { value: T }
  | EvidenceRecordAbsent
  | EvidenceRefused { reason: NonEmptyStr }

type ServiceEvidenceOwed
  = OwedToPendingReader { reader: PendingServiceReader }
  | OwedToUnbuiltProducer { owner_node: String }

fn pending_reader_owed(reader: PendingServiceReader) -> ServiceEvidenceOwed {
  OwedToPendingReader { reader: reader }
}

// A field with no producer anywhere yet is owed to the node that owns building it. Where no other
// node owns it, that is this node, whose later slices build it.
fn owed_to(owner_node: String) -> ServiceEvidenceOwed {
  OwedToUnbuiltProducer { owner_node: owner_node }
}

fn refusal_reason(reason: String) -> NonEmptyStr {
  if reason == "" { "the reader refused without a reason" as NonEmptyStr } else { reason as NonEmptyStr }
}

// G5 (gunbc.roadmap_session_placement). What its grant record ESTABLISHES, and nothing else:
//   placement        -- host, capacity partition and unit of the granted session;
//   workload_class   -- the work-class grant the session was admitted under;
//   resource_request -- the amount the grant admitted (the request as granted), as Kibibyte.
// It does not establish wait time (no request-enqueued instant is recorded) or seat utilization (no
// usage against the grant is recorded); those stay owed to this node (service_evidence_readings).
// Every arm is mapped: Absent and a slot with no grant record yet are a record not yet written;
// Unreadable, Foreign, an unreadable or foreign grant, and a record naming another (node, attempt)
// than the binding are refused. None of them can produce an observed reading.
type PlacementObserved {
  host: String
  partition: String
  unit: String
}

type WorkloadClassObserved {
  class_grant: String
}

// The grant record of THIS attempt, or why there is none: one fold, read by all three G5 fields.
type SessionGrantOfAttempt
  = GrantOfAttempt { record: SessionPlacementRecord }
  | GrantNotYetWritten
  | GrantRefused { reason: NonEmptyStr }

fn session_grant_of_attempt(i: SessionPlacementInput, binding: AttemptBinding) -> SessionGrantOfAttempt {
  match i {
    SessionPlacementRead { observation } =>
      match observation {
        SessionPlacementAbsent { unit: _ } => GrantNotYetWritten
        SessionPlacementUnreadable { unit: _, detail } => GrantRefused { reason: refusal_reason(reason: join(["the session placement is unreadable: ", detail], "")) }
        SessionPlacementForeign { unit: _, detail } => GrantRefused { reason: refusal_reason(reason: join(["the session placement is not this attempt's: ", detail], "")) }
        SessionPlacementObserved { slot: _, grant, returned: _ } =>
          match grant {
            SessionGrantNotRecorded { path: _ } => GrantNotYetWritten
            SessionGrantUnreadable { path: _, detail } => GrantRefused { reason: refusal_reason(reason: join(["the session grant record is unreadable: ", detail], "")) }
            SessionGrantForeign { path: _, detail } => GrantRefused { reason: refusal_reason(reason: join(["the session grant record is not this attempt's: ", detail], "")) }
            SessionGrantRecorded { record } =>
              if record.node_id != (binding.node_id as String) || record.attempt_key != (binding.attempt_key as String) {
                GrantRefused { reason: refusal_reason(reason: join(["the session grant record names ", record.node_id, " attempt ", record.attempt_key, ", not the bound attempt"], "")) }
              } else {
                GrantOfAttempt { record: record }
              }
          }
      }
  }
}

fn placement_reading(g: SessionGrantOfAttempt) -> ServiceEvidenceReading<PlacementObserved> {
  match g {
    GrantOfAttempt { record } => EvidenceObserved { value: PlacementObserved { host: record.host, partition: record.partition, unit: record.unit } }
    GrantNotYetWritten => EvidenceRecordAbsent
    GrantRefused { reason } => EvidenceRefused { reason: reason }
  }
}

fn workload_class_reading(g: SessionGrantOfAttempt) -> ServiceEvidenceReading<WorkloadClassObserved> {
  match g {
    GrantOfAttempt { record } => EvidenceObserved { value: WorkloadClassObserved { class_grant: record.class_grant } }
    GrantNotYetWritten => EvidenceRecordAbsent
    GrantRefused { reason } => EvidenceRefused { reason: reason }
  }
}

fn resource_request_reading(g: SessionGrantOfAttempt) -> ServiceEvidenceReading<Kibibyte> {
  match g {
    GrantOfAttempt { record } => EvidenceObserved { value: record.amount }
    GrantNotYetWritten => EvidenceRecordAbsent
    GrantRefused { reason } => EvidenceRefused { reason: reason }
  }
}

// THE POPULATION: exactly the node's 21 fields, one named member each. A record literal must set
// every member exactly once, so the population is checked by the compiler, not by a count.
type ServiceEvidenceReadings {
  workload_class: ServiceEvidenceReading<WorkloadClassObserved>
  resource_request: ServiceEvidenceReading<Kibibyte>
  wait_time: ServiceEvidenceOwed
  execution_time: ServiceEvidenceOwed
  completion_time: ServiceEvidenceOwed
  cache_hits: ServiceEvidenceOwed
  cache_misses: ServiceEvidenceOwed
  cache_shared_misses: ServiceEvidenceOwed
  cache_corrupt_hit_refusals: ServiceEvidenceOwed
  placement: ServiceEvidenceReading<PlacementObserved>
  seat_utilization: ServiceEvidenceOwed
  artifact_bytes: ServiceEvidenceOwed
  egress: ServiceEvidenceOwed
  failure_attribution: ServiceEvidenceOwed
  recovery_action: ServiceEvidenceOwed
  operator_intervention_time: ServiceEvidenceOwed
  hardware_health: ServiceEvidenceOwed
  billable_usage: ServiceEvidenceOwed
  billable_credits: ServiceEvidenceOwed
  workspace_recovery_point: ServiceEvidenceOwed
  workspace_recovery_time: ServiceEvidenceOwed
}

// THE ONE SOURCE AUTHORITY PER FIELD: which input (and so which reader) or which owning node.
fn service_evidence_readings(r: ServiceEvidenceReceipt) -> ServiceEvidenceReadings {
  let g5 = session_grant_of_attempt(i: r.inputs.session_placement, binding: r.binding)
  ServiceEvidenceReadings {
    workload_class: workload_class_reading(g: g5),
    resource_request: resource_request_reading(g: g5),
    wait_time: owed_to(owner_node: "service-evidence-capture"),
    execution_time: pending_reader_owed(reader: PendingMetering),
    completion_time: pending_reader_owed(reader: PendingResultReturned),
    cache_hits: pending_reader_owed(reader: PendingSharedComputation),
    cache_misses: pending_reader_owed(reader: PendingSharedComputation),
    cache_shared_misses: pending_reader_owed(reader: PendingSharedComputation),
    cache_corrupt_hit_refusals: pending_reader_owed(reader: PendingSharedComputation),
    placement: placement_reading(g: g5),
    seat_utilization: owed_to(owner_node: "service-evidence-capture"),
    artifact_bytes: pending_reader_owed(reader: PendingSharedComputation),
    egress: owed_to(owner_node: "service-evidence-capture"),
    failure_attribution: pending_reader_owed(reader: PendingResultReturned),
    recovery_action: owed_to(owner_node: "service-evidence-capture"),
    operator_intervention_time: owed_to(owner_node: "service-evidence-capture"),
    hardware_health: owed_to(owner_node: "fleet-health-0-live-receipt"),
    billable_usage: pending_reader_owed(reader: PendingMetering),
    billable_credits: owed_to(owner_node: "failure-billing-outcomes"),
    workspace_recovery_point: owed_to(owner_node: "fabric-storage"),
    workspace_recovery_time: owed_to(owner_node: "fabric-storage"),
  }
}

// THE ONE ORDERED VIEW of the product, read by the wire AND the closing contract (no second list).
// This is the encoder's view: each typed reading becomes its wire standing here, and a typed value
// becomes JSON here and nowhere earlier. The language has no record-member iteration, so this
// enumeration is the one place a member could be repeated or dropped; the witness compares its
// names, by identity and in order, against the node's list, and a count-preserving
// duplicate-plus-omission is its discriminating red (rung 2).
//
// ReaderRecordAbsent: the reader is on main and has written nothing for this attempt yet.
type ServiceEvidenceProducer
  = PendingReader { reader: PendingServiceReader }
  | ReaderRecordAbsent { reader: ServiceEvidenceReader }
  | UnbuiltProducer { owner_node: String }

type ServiceEvidenceStanding
  = StandingObserved { value: JsonValue, source: ServiceEvidenceReader }
  | StandingOwed { producer: ServiceEvidenceProducer }
  | StandingRefused { reason: NonEmptyStr }

type ServiceEvidenceEntry {
  field: String
  standing: ServiceEvidenceStanding
}

fn owed_entry(field: String, o: ServiceEvidenceOwed) -> ServiceEvidenceEntry {
  ServiceEvidenceEntry { field: field, standing: StandingOwed { producer: match o {
    OwedToPendingReader { reader } => PendingReader { reader: reader }
    OwedToUnbuiltProducer { owner_node } => UnbuiltProducer { owner_node: owner_node }
  } } }
}

fn placement_json(v: PlacementObserved) -> JsonValue {
  json_object([
    json_kv(key: "host", value: json_string(s: v.host)),
    json_kv(key: "partition", value: json_string(s: v.partition)),
    json_kv(key: "unit", value: json_string(s: v.unit)),
  ])
}

fn workload_class_json(v: WorkloadClassObserved) -> JsonValue {
  json_object([json_kv(key: "class_grant", value: json_string(s: v.class_grant))])
}

fn kibibyte_json(v: Kibibyte) -> JsonValue {
  json_object([json_kv(key: "kib", value: json_int(n: kibibyte_count(k: v)))])
}

fn placement_entry(field: String, r: ServiceEvidenceReading<PlacementObserved>) -> ServiceEvidenceEntry {
  ServiceEvidenceEntry { field: field, standing: match r {
    EvidenceObserved { value } => StandingObserved { value: placement_json(v: value), source: SessionPlacementReader }
    EvidenceRecordAbsent => StandingOwed { producer: ReaderRecordAbsent { reader: SessionPlacementReader } }
    EvidenceRefused { reason } => StandingRefused { reason: reason }
  } }
}

fn workload_class_entry(field: String, r: ServiceEvidenceReading<WorkloadClassObserved>) -> ServiceEvidenceEntry {
  ServiceEvidenceEntry { field: field, standing: match r {
    EvidenceObserved { value } => StandingObserved { value: workload_class_json(v: value), source: SessionPlacementReader }
    EvidenceRecordAbsent => StandingOwed { producer: ReaderRecordAbsent { reader: SessionPlacementReader } }
    EvidenceRefused { reason } => StandingRefused { reason: reason }
  } }
}

fn kibibyte_entry(field: String, r: ServiceEvidenceReading<Kibibyte>) -> ServiceEvidenceEntry {
  ServiceEvidenceEntry { field: field, standing: match r {
    EvidenceObserved { value } => StandingObserved { value: kibibyte_json(v: value), source: SessionPlacementReader }
    EvidenceRecordAbsent => StandingOwed { producer: ReaderRecordAbsent { reader: SessionPlacementReader } }
    EvidenceRefused { reason } => StandingRefused { reason: reason }
  } }
}

fn service_evidence_entries(r: ServiceEvidenceReadings) -> List<ServiceEvidenceEntry> {
  [
    workload_class_entry(field: "workload_class", r: r.workload_class),
    kibibyte_entry(field: "resource_request", r: r.resource_request),
    owed_entry(field: "wait_time", o: r.wait_time),
    owed_entry(field: "execution_time", o: r.execution_time),
    owed_entry(field: "completion_time", o: r.completion_time),
    owed_entry(field: "cache_hits", o: r.cache_hits),
    owed_entry(field: "cache_misses", o: r.cache_misses),
    owed_entry(field: "cache_shared_misses", o: r.cache_shared_misses),
    owed_entry(field: "cache_corrupt_hit_refusals", o: r.cache_corrupt_hit_refusals),
    placement_entry(field: "placement", r: r.placement),
    owed_entry(field: "seat_utilization", o: r.seat_utilization),
    owed_entry(field: "artifact_bytes", o: r.artifact_bytes),
    owed_entry(field: "egress", o: r.egress),
    owed_entry(field: "failure_attribution", o: r.failure_attribution),
    owed_entry(field: "recovery_action", o: r.recovery_action),
    owed_entry(field: "operator_intervention_time", o: r.operator_intervention_time),
    owed_entry(field: "hardware_health", o: r.hardware_health),
    owed_entry(field: "billable_usage", o: r.billable_usage),
    owed_entry(field: "billable_credits", o: r.billable_credits),
    owed_entry(field: "workspace_recovery_point", o: r.workspace_recovery_point),
    owed_entry(field: "workspace_recovery_time", o: r.workspace_recovery_time),
  ]
}

// ── THE OBSERVATION the dogfood start receipt requires ──
type ServiceEvidenceObservation
  = ServiceEvidenceJoined { receipt: ServiceEvidenceReceipt }
  | ServiceEvidenceAttemptUnlaunched
  | ServiceEvidenceRefused { reason: String }

fn service_evidence_observe_for_attempt(instance: HostDashboardInstance, node_id: RoadmapNodeId, attempt_key: String) -> ServiceEvidenceObservation {
  match service_evidence_bind_attempt(
    instance_id: instance.instance_id as String,
    node_id: node_id as String,
    attempt_key: attempt_key,
    launch: filesystem_file_observation_of_path(path: dispatch_attempt_launch_path_for_instance(instance: instance, node_id: node_id, attempt_key: attempt_key)),
  ) {
    AttemptUnlaunched => ServiceEvidenceAttemptUnlaunched
    AttemptBindingRefused { reason } => ServiceEvidenceRefused { reason: reason }
    AttemptBound { binding } =>
      ServiceEvidenceJoined { receipt: ServiceEvidenceReceipt { binding: binding, inputs: service_evidence_inputs_for_attempt(instance: instance, binding: binding) } }
  }
}

// ── THE CANONICAL WIRE AND ITS DIGEST, what the start receipt pins ──
// The wire is a function of the receipt (binding + inputs) only: a reading built by hand is not an
// input to it, so it cannot be serialized or pinned as service evidence.
fn service_evidence_producer_json(p: ServiceEvidenceProducer) -> JsonValue {
  match p {
    PendingReader { reader } => json_object([
      json_kv(key: "kind", value: json_string(s: "pending_reader")),
      json_kv(key: "reader", value: json_string(s: service_evidence_reader_wire(r: pending_reader(r: reader)))),
      json_kv(key: "pr", value: json_int(n: reader_pending_pr(r: reader))),
    ])
    ReaderRecordAbsent { reader } => json_object([
      json_kv(key: "kind", value: json_string(s: "reader_record_absent")),
      json_kv(key: "reader", value: json_string(s: service_evidence_reader_wire(r: reader))),
    ])
    UnbuiltProducer { owner_node } => json_object([
      json_kv(key: "kind", value: json_string(s: "unbuilt_producer")),
      json_kv(key: "owner_node", value: json_string(s: owner_node)),
    ])
  }
}

fn service_evidence_entry_json(x: ServiceEvidenceEntry) -> JsonValue {
  let field = json_kv(key: "field", value: json_string(s: x.field))
  match x.standing {
    StandingObserved { value, source } => json_object([field,
      json_kv(key: "standing", value: json_string(s: "observed")),
      json_kv(key: "value", value: value),
      json_kv(key: "source", value: json_string(s: service_evidence_reader_wire(r: source))),
    ])
    StandingOwed { producer } => json_object([field,
      json_kv(key: "standing", value: json_string(s: "owed")),
      json_kv(key: "producer", value: service_evidence_producer_json(p: producer)),
    ])
    StandingRefused { reason } => json_object([field,
      json_kv(key: "standing", value: json_string(s: "refused")),
      json_kv(key: "reason", value: json_string(s: reason as String)),
    ])
  }
}

data service_evidence_receipt_schema: String = "service-evidence-receipt/v2"

fn service_evidence_receipt_wire(r: ServiceEvidenceReceipt) -> String {
  serialize_json(v: json_object([
    json_kv(key: "schema", value: json_string(s: service_evidence_receipt_schema)),
    json_kv(key: "instance_id", value: json_string(s: r.binding.instance_id as String)),
    json_kv(key: "node_id", value: json_string(s: r.binding.node_id as String)),
    json_kv(key: "attempt_key", value: json_string(s: r.binding.attempt_key as String)),
    json_kv(key: "launch_revision", value: json_string(s: r.binding.revision_hex as String)),
    json_kv(key: "fields", value: json_array(map(service_evidence_entries(r: service_evidence_readings(r: r)), x => service_evidence_entry_json(x: x)))),
  ]))
}

fn service_evidence_receipt_digest(r: ServiceEvidenceReceipt) -> String {
  wire_content_hash_to_hex(hash: content_hash_of_value(value: service_evidence_receipt_wire(r: r) as NonEmptyStr))
}

// ── THE NODE'S CLOSING CONTRACT (roadmap node service-evidence-capture) ──
//
// The node closes when EVERY FIELD HAS A LANDED SOURCE: no field is owed to a reader that is not on
// main or to a producer that does not exist. Runtime standings of a landed reader (its record not yet
// written, or refused for one attempt) are facts about one attempt, not about the node's capability,
// so they do not hold the node open. The predicate is evaluated over a probe receipt whose landed
// readers report no record (the weakest runtime standing), so it measures sources and nothing else.
// Read from the same ordered view as the wire. RED today: 18 of 21 fields are unsourced (G5 sources 3).
fn service_evidence_unsourced_fields(r: ServiceEvidenceReadings) -> List<String> {
  map(filter(service_evidence_entries(r: r), x => match x.standing {
    StandingObserved { value: _, source: _ } => false
    StandingRefused { reason: _ } => false
    StandingOwed { producer } => match producer {
      PendingReader { reader: _ } => true
      UnbuiltProducer { owner_node: _ } => true
      ReaderRecordAbsent { reader: _ } => false
    }
  }), x => x.field)
}

fn service_evidence_closing_probe() -> ServiceEvidenceReceipt {
  ServiceEvidenceReceipt {
    binding: AttemptBinding {
      instance_id: "closing-contract-probe" as NonEmptyStr,
      node_id: "service-evidence-capture" as NonEmptyStr,
      attempt_key: "closing-contract-probe" as NonEmptyStr,
      revision_hex: "0000000000000000000000000000000000000000" as NonEmptyStr,
    },
    inputs: ServiceEvidenceInputs {
      session_placement: SessionPlacementRead { observation: SessionPlacementAbsent { unit: "closing-contract-probe" } },
    },
  }
}

fn service_evidence_capture_acceptance_holds() -> Bool {
  count(service_evidence_unsourced_fields(r: service_evidence_readings(r: service_evidence_closing_probe()))) == 0
}
