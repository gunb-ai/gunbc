module gunbc.roadmap.native_emit_fixture_arms_both_typed

// THROWAWAY bisect matrix (node://adhoc-aade5300-c0e, R4). The fn's `if` has BOTH arms typed (two Present
// literals); NO bare `Absent {}` arm and NO module-data arm. If this EMITS, the bare `Absent {}` / module-data
// reference was the trigger. If it STILL refuses, an fn RETURNING Optional<T> that is then matched and its
// Present.value crossed with `as` fails at emit regardless of arm content.
import std.types { String, Bool, NonEmptyStr }

fn arms_both_typed(b: Bool) -> Optional<NonEmptyStr> {
  if b { Present { value: "x" as NonEmptyStr } } else { Present { value: "y" as NonEmptyStr } }
}

fn use_arms_both_typed(b: Bool) -> String {
  let p = arms_both_typed(b: b)
  match p {
    Absent {} => "none"
    Present { value: v } => v as String
  }
}

data fixture_emit_hook_d: String = use_arms_both_typed(b: true)
