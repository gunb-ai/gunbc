module gunbc.roadmap.roadmap_attempt_exit_spool

import std.types { String, NonEmptyStr, List, Bool, Int, FilePath }
import extdeps.shell
import std.optional { Optional, Present, Absent }
import extdeps.posix.identity { PosixOwnerNames }
import extdeps.tools.gnu_coreutils { install_directory_owned_argv_command, mkdir_create_only_command }
import gunbc.managed_directory { DeclaredDirectoryMode, DirectoryOwnerAllEveryoneTraverse, declared_directory_mode }
import gunbc.spool_queue {
  SpoolAttemptExit, RolePending, RoleHandedOff, RoleClaimed, RoleDone, RoleRefused,
  SpoolListing, SpoolListed, SpoolListingUnreadable, spool_open, spool_queue_list, spool_role_path, spool_enqueue_command, spool_entry_key_of_name, SpoolKeyMinted, SpoolKeyRefused,
}
import extdeps.systemd.service_exec {
  ServiceStopVariable, InvocationIdVariable, ServiceResultVariable, ExitCodeVariable, ExitStatusVariable,
  ServiceResult, service_result_of_wire, ServiceExitCode, service_exit_code_of_wire,
  ServiceExitCodeExited, ServiceExitCodeKilled, ServiceExitCodeDumped, ServiceExitCodeUnlisted,
  ExecWordPart, ExecLiteral, ExecVariable, ExecWordRendered, ExecWordRefused, exec_word_render,
  ExecCommandLineRendering, ExecCommandLineRendered, ExecCommandLineRefused, exec_command_line,
  exec_command_line_full_privileges,
}
import extdeps.posix.signal {
  LinuxStandardSignal, linux_standard_signal_of_name,
  linux_standard_signal_of_number, linux_standard_signal_wire_name,
}
import extdeps.filesystem.filesystem_io {
  Filesystem,
  FilesystemListingObservation, FilesystemDirectoryListed, FilesystemDirectoryListingRefused, FilesystemDirectorySubjectRefused,
  filesystem_listing_observation, filesystem_listing_entry_names,
}

// THE RECORD A WORKER UNIT LEAVES WHEN ITS PROCESS ENDS (dogfood interventions #4 and #6, gunbc#13124).
// The unit's stop hook creates ONE directory in the
// instance's exit inbox, and the directory's NAME is the record: the attempt it belongs to, the
// manager's invocation id, and the three stop-time facts systemd hands the hook
// (extdeps.systemd.service_exec ServiceStopVariable). There is no file to write and no shell to write
// it with -- the hook is `mkdir -- <name>` as a typed argv, the manager substitutes the variables,
// and mkdir(2) is atomic and create-only, so a repeated hook for one invocation fails harmlessly and
// two invocations can never merge into one record.
//
// THIS RECORD REPLACES UNIT-LOADED STATE AS THE EXIT EVIDENCE. The worker unit used to set
// RemainAfterExit=yes so that a successful exit stayed readable as `active (exited)` with its
// ExecMainStatus (2026-09-05). That state lives in the user manager's memory: it is gone on a
// reboot, a manager restart or a reap, and while it stands the unit never STOPS, so no stop hook can
// run at the moment the worker exits. The entry is on disk under the instance root and is written
// at exit, which is the event the capture obligation waits on.
//
// THE SEPARATOR IS "+". The name's parts are a roadmap node id (kebab-case), an attempt key (hex), the
// unit's ROLE within the attempt (AttemptUnitRole), an invocation id (32 hex), a $SERVICE_RESULT word
// (lowercase, may contain "-"), an $EXIT_CODE word and an $EXIT_STATUS (decimal or a signal name).
// None of those can contain "+", so the name splits into exactly seven parts or it is not a record;
// nothing is guessed from a partial split.
//
// THE ROLE IS IN THE NAME BECAUSE ONE ATTEMPT RUNS SEVERAL UNITS: its worker, one reviewer per
// criterion and an auditor, each of which now ends with an exit record (bold-bee-114 ruling,
// 2026-10-06: a reviewer finishing is the event its attempt's next obligation waits on, exactly as a
// worker finishing is). The role names one LAUNCH: the worker once per attempt, a reviewer once per
// (criterion, head), the auditor once per head -- so (node, attempt, role) identifies one unit run.

data attempt_exit_entry_separator: String = "+"

// THE STOP HOOK RUNS OUTSIDE THE UNIT'S SANDBOX ("+", extdeps.systemd.service_exec
// exec_command_line_full_privileges). A reviewer's or auditor's process may write only its own review
// directory; were the inbox added to its ReadWritePaths, the process it confines could create an exit
// record for any unit of any attempt. With the prefix, the hook writes the inbox and the confined
// process still cannot -- the record is the manager's statement, not the worker's.
//
// THE STOP HOOK'S ARGV, as one ExecStopPost= value. Refuses rather than renders if any literal part
// would be read as command-line syntax (extdeps.systemd.service_exec exec_word_render); a refused hook
// is a refused spawn, because a worker started without its exit record would leave its capture with
// nothing to fire on.
type AttemptExitHook
  = AttemptExitHookRendered { exec_line: NonEmptyStr }
  | AttemptExitHookRefused { reason: NonEmptyStr }

// THE UNIT'S ROLE WITHIN ITS ATTEMPT, rendered as one '+'-free token.
// A reviewer is launched per (criterion, head) and an auditor per head, so their roles carry the head:
// a re-review of a new head is a new launch with its own record, not a second record for one launch.
type AttemptUnitRole
  = AttemptWorkerRole
  | AttemptReviewerRole { criterion_key: String, head_sha: String }
  | AttemptAuditorRole { head_sha: String }
  | AttemptObligationRole
  | AttemptSupervisorRole { turn: Int }

fn attempt_unit_role_token(role: AttemptUnitRole) -> String {
  match role {
    AttemptWorkerRole => "worker"
    AttemptReviewerRole { criterion_key, head_sha } => join(["review.", criterion_key, ".", head_sha], "")
    AttemptAuditorRole { head_sha } => join(["audit.", head_sha], "")
    AttemptObligationRole => "obligation"
    AttemptSupervisorRole { turn } => join(["supervise.t", to_string(value: turn)], "")
  }
}

fn attempt_exit_entry_parts(inbox: String, node_id: String, attempt_key: String, role: AttemptUnitRole) -> List<ExecWordPart> {
  [
    ExecLiteral { text: join([inbox, "/", node_id, attempt_exit_entry_separator, attempt_key, attempt_exit_entry_separator, attempt_unit_role_token(role: role), attempt_exit_entry_separator], "") },
    ExecVariable { variable: InvocationIdVariable },
    ExecLiteral { text: attempt_exit_entry_separator },
    ExecVariable { variable: ServiceResultVariable },
    ExecLiteral { text: attempt_exit_entry_separator },
    ExecVariable { variable: ExitCodeVariable },
    ExecLiteral { text: attempt_exit_entry_separator },
    ExecVariable { variable: ExitStatusVariable },
  ]
}

// THE SPELLING THE MANAGER SUBSTITUTES, rebuilt rather than written as a literal so this file's own
// string interpolation cannot be mistaken for it.
fn attempt_exit_stop_variable_spelling(variable: ServiceStopVariable) -> String {
  join(["$", "{", service_stop_variable_name(variable: variable) as String, "}"], "")
}

// WHICH STOP VARIABLES AN ENTRY NAME STILL CARRIES UNEXPANDED. A name that still spells one of them
// was NOT written through the manager's substitution: the stop hook ran with the variables literal.
// THAT IS A FACT ABOUT ITS WRITER, NOT ABOUT THE HOLDER: a malformed artifact cannot show that a
// process is alive, and a settlement that reads it as "the holder's end is unknown" keeps a seat for
// something that has already ended. srv1 2026-10-28, attempt 6ea61c671002a6d4: the worker unit's ONLY
// exit artifact is such a name -- its audit, obligation and review units wrote expanded records in the
// same minute -- and the seat has been held ever since.
fn attempt_exit_entry_unexpanded_variables(entry_name: String) -> List<String> {
  [InvocationIdVariable, ServiceResultVariable, ExitCodeVariable, ExitStatusVariable]
    |> filter(v => string_contains(s: entry_name, pattern: attempt_exit_stop_variable_spelling(variable: v)))
    |> map(v => service_stop_variable_name(variable: v) as String)
}

// THE DISTINCT STOP VARIABLES ACROSS A SET OF SUCH NAMES, so the reader can name what the writer left
// unsubstituted instead of the caller re-deriving it.
fn attempt_exit_unexpanded_variables_of(entries: List<String>) -> List<String> {
  fold(entries |> flat_map(name => attempt_exit_entry_unexpanded_variables(entry_name: name)),
    init: [] as List<String>,
    f: fn(acc, name) { if any(acc, a => a == name) { acc } else { concat(acc, [name]) } })
}

// THE RECORD IS CREATED OWNED BY ITS CONSUMER. The hook runs as the system manager (root) for a unit with
// a foreign User=, so a bare mkdir leaves a root:root record that the drain -- the service user -- cannot
// rename from inbox to queued (renaming a directory needs write permission on the directory itself).
// record_owner is the drain's principal (HostDashboardInstance directory_owner), never a literal, and
// gunbc.roadmap.dispatch_unit_created_paths judges the same creation the hook is built from.
// install -d is idempotent where mkdir was create-only; the invocation id in the name keeps each record
// unique, so a repeated hook still names one record.
data attempt_exit_record_mode: DeclaredDirectoryMode = DirectoryOwnerAllEveryoneTraverse

fn attempt_exit_pending_dir(instance_root: String) -> Optional<String> {
  spool_role_path(store: spool_open(kind: SpoolAttemptExit, instance_root: instance_root), role: RolePending)
}

fn attempt_exit_hook(instance_root: String, node_id: String, attempt_key: String, role: AttemptUnitRole, record_owner: PosixOwnerNames) -> AttemptExitHook {
  match attempt_exit_pending_dir(instance_root: instance_root) {
    Absent => AttemptExitHookRefused { reason: "attempt exit spool declares no pending directory" }
    Present { value: pending } =>
      match exec_word_render(parts: attempt_exit_entry_parts(inbox: pending, node_id: node_id, attempt_key: attempt_key, role: role)) {
        ExecWordRefused { reason } => AttemptExitHookRefused { reason: reason }
        ExecWordRendered { word } =>
          match exec_command_line_full_privileges(command: install_directory_owned_argv_command(mode: declared_directory_mode(m: attempt_exit_record_mode), owner: record_owner.user, group: record_owner.group, path: word as String)) {
            ExecCommandLineRefused { reason } => AttemptExitHookRefused { reason: reason }
            ExecCommandLineRendered { line } => AttemptExitHookRendered { exec_line: line }
          }
      }
  }
}

// ONE DECODED RECORD. The process END is a closed pair: an exit with a status, or a signal. They are
// different facts -- a process killed by SIGTERM did not exit 15 -- and the record keeps them apart.
type AttemptProcessEnd
  = AttemptProcessExitedWith { status: Int }
  | AttemptProcessSignaled { signal: LinuxStandardSignal }

type AttemptExitRecord {
  node_id: String
  attempt_key: String
  role: String
  invocation_id: String
  result: ServiceResult
  end: AttemptProcessEnd
  entry_name: String
}

type AttemptExitEntryDecode
  = AttemptExitEntryDecoded { record: AttemptExitRecord }
  | AttemptExitEntryMalformed { entry_name: String, reason: String }

// THE END THE TWO STOP VARIABLES DESCRIBE, or why they describe none. "Exited" must carry a number;
// "killed" and "dumped" carry a signal name; a word systemd.exec(5) does not document is refused
// rather than read as either.
type AttemptProcessEndDecode
  = AttemptProcessEndOf { end: AttemptProcessEnd }
  | AttemptProcessEndRefused { reason: String }

fn attempt_process_signaled_of(status: String) -> AttemptProcessEndDecode {
  match linux_standard_signal_of_name(name: status) {
    Present { value: signal } => AttemptProcessEndOf { end: AttemptProcessSignaled { signal: signal } }
    Absent => AttemptProcessEndRefused { reason: join(["EXIT_STATUS is not a standard Linux signal name (signal(7)): ", status], "") }
  }
}

fn attempt_process_end_of(code: ServiceExitCode, status: String) -> AttemptProcessEndDecode {
  match code {
    ServiceExitCodeExited =>
      match parse_int(text: status) {
        Present { value: n } => AttemptProcessEndOf { end: AttemptProcessExitedWith { status: n } }
        Absent => AttemptProcessEndRefused { reason: join(["EXIT_CODE is exited but EXIT_STATUS is not a number: ", status], "") }
      }
    ServiceExitCodeKilled => attempt_process_signaled_of(status: status)
    ServiceExitCodeDumped => attempt_process_signaled_of(status: status)
    ServiceExitCodeUnlisted { word } => AttemptProcessEndRefused { reason: join(["EXIT_CODE is not a word systemd.exec(5) documents: ", word], "") }
  }
}

// The decoder checks the part count before reading any part, so an absent index here is a count
// already refused; the empty string it answers is then refused by the emptiness checks below.
fn attempt_exit_entry_part(parts: List<String>, index: Int) -> String {
  match parts.get(index) {
    Present { value: v } => v
    Absent => ""
  }
}

fn attempt_exit_entry_decode(entry_name: String) -> AttemptExitEntryDecode {
  let parts = entry_name.split(delimiter: attempt_exit_entry_separator)
  if count(parts) != 7 {
    AttemptExitEntryMalformed { entry_name: entry_name, reason: join(["an exit record has seven '+'-separated parts; this name has ", to_string(value: count(parts))], "") }
  } else {
    let node_id = attempt_exit_entry_part(parts: parts, index: 0)
    let attempt_key = attempt_exit_entry_part(parts: parts, index: 1)
    let role = attempt_exit_entry_part(parts: parts, index: 2)
    let invocation_id = attempt_exit_entry_part(parts: parts, index: 3)
    let result_word = attempt_exit_entry_part(parts: parts, index: 4)
    let code = service_exit_code_of_wire(word: attempt_exit_entry_part(parts: parts, index: 5))
    let status = attempt_exit_entry_part(parts: parts, index: 6)
    if string_length(s: node_id) == 0 || string_length(s: attempt_key) == 0 || string_length(s: role) == 0 || string_length(s: invocation_id) == 0 {
      AttemptExitEntryMalformed { entry_name: entry_name, reason: "an exit record names its node, attempt, role and invocation; one of them is empty" }
    } else {
      match attempt_process_end_of(code: code, status: status) {
        AttemptProcessEndRefused { reason } => AttemptExitEntryMalformed { entry_name: entry_name, reason: reason }
        AttemptProcessEndOf { end } =>
          AttemptExitEntryDecoded {
            record: AttemptExitRecord {
              node_id: node_id,
              attempt_key: attempt_key,
              role: role,
              invocation_id: invocation_id,
              result: service_result_of_wire(word: result_word),
              end: end,
              entry_name: entry_name,
            },
          }
      }
    }
  }
}

// WHERE IN THE SPOOL AN ENTRY STANDS, which is responsibility, not evidence: the record means the
// same thing in every stage. Inbox: no obligation has taken it. Queued: recorded and handed off, no run has
// claimed it. Running: a live run claimed it and has not settled it. Done: its obligation's receipt exists. Refused: the drain could not hand it off.
// THE EXIT RECORD OF ONE ATTEMPT, as the process observer needs it. Three arms and only three:
// a record was found; the spool was read in every stage and holds none for this attempt; or a
// stage could not be read. The third is never the second -- "I could not look" is not "there is
// none" -- and the second is never "the worker never ran": it is the absence of a RECORD, which the
// observer reports as exactly that (bold-bee-114 ruling, condition 1).
type AttemptExitRecordObservation
  = AttemptExitRecordFound { record: AttemptExitRecord }
  | AttemptExitRecordNone
  // AN ENTRY FOR THIS SUBJECT WHOSE NAME STILL SPELLS THE STOP VARIABLES UNEXPANDED. The arm names
  // its WRITER as defective -- whatever created the entry never went through the manager's
  // substitution -- and it is NOT an answer about the holder: a broken artifact cannot show that a
  // process is alive. A reader that treats it as "the end is unobserved" keeps a seat held for a
  // holder that has already ended (srv1 2026-10-28, attempt 6ea61c671002a6d4: a 22 GiB seat held for
  // twelve days on nothing but this artifact). Where this arm answers, the unit's standing in the
  // manager that ran it is what decides.
  | AttemptExitRecordWriterUnsubstituted { entries: List<String>, variables: List<String> }
  | AttemptExitRecordUnreadable { reason: String }

// PURE OVER THE THREE LISTINGS, so the decision is exercised on supplied listings and the wet read
// below is only the listing. A launch runs once per (attempt, role), so a second record for one subject
// is a second invocation of one unit, which the dispatch path does not do -- it is reported as
// unreadable, never chosen between.
fn attempt_exit_record_from_listings(
  node_id: String,
  attempt_key: String,
  role: AttemptUnitRole,
  listings: List<SpoolListing>,
) -> AttemptExitRecordObservation {
  attempt_exit_record_matching(matches: (n, a, r) => n == node_id && a == attempt_key && r == attempt_unit_role_token(role: role), listings: listings)
}

// DOES THIS ENTRY NAME IDENTIFY THE SUBJECT? An entry is for the subject when its first three parts
// are its node, attempt and role -- the parts every writer must put there, expanded or not.
fn attempt_exit_entry_names_subject(matches: fn(String, String, String) -> Bool, name: String) -> Bool {
  let parts = name.split(delimiter: attempt_exit_entry_separator)
  count(parts) >= 3 && matches(attempt_exit_entry_part(parts: parts, index: 0), attempt_exit_entry_part(parts: parts, index: 1), attempt_exit_entry_part(parts: parts, index: 2))
}

// THE SAME DECISION OVER ANY SUBJECT PREDICATE: the placement settlement knows a worker by its unit
// name, and the unit name is minted above this module (gunbc.roadmap.roadmap_dispatch_actuator
// dispatch_attempt_unit_name), so the caller supplies the predicate rather than this module
// re-deriving the name.
fn attempt_exit_record_matching(
  matches: fn(String, String, String) -> Bool,
  listings: List<SpoolListing>,
) -> AttemptExitRecordObservation {
  let unreadable = listings |> flat_map(l => match l {
    SpoolListingUnreadable { reason } => [reason]
    SpoolListed { names: _ } => [] as List<String>
  })
  match unreadable.first() {
    Present { value: why } => AttemptExitRecordUnreadable { reason: why }
    Absent => {
      let names = listings |> flat_map(l => match l {
        SpoolListed { names } => names
        SpoolListingUnreadable { reason: _ } => [] as List<String>
      })
      let malformed = names |> flat_map(name => match attempt_exit_entry_decode(entry_name: name) {
        AttemptExitEntryDecoded { record: _ } => [] as List<String>
        AttemptExitEntryMalformed { entry_name: _, reason: why } =>
          if attempt_exit_entry_names_subject(matches: matches, name: name) { [join([name, ": ", why], "")] } else { [] as List<String> }
      })
      // NAMES WHOSE OWN STOP-VARIABLE PARTS ARE STILL SPELLINGS. They are malformed, but they are
      // malformed in a way that says something specific: the writer ran the hook with the variables
      // literal, so the manager never substituted them.
      let unsubstituted = names |> filter(name =>
        attempt_exit_entry_names_subject(matches: matches, name: name)
          && count(attempt_exit_entry_unexpanded_variables(entry_name: name)) > 0)
      let records = listings
        |> flat_map(l => match l {
          SpoolListed { names } => names
          SpoolListingUnreadable { reason: _ } => [] as List<String>
        })
        |> flat_map(name => match attempt_exit_entry_decode(entry_name: name) {
          AttemptExitEntryDecoded { record } => if matches(record.node_id, record.attempt_key, record.role) { [record] } else { [] as List<AttemptExitRecord> }
          AttemptExitEntryMalformed { entry_name: _, reason: _ } => [] as List<AttemptExitRecord>
        })
      // A DECODABLE RECORD ANSWERS THE END, and it outranks a broken sibling artifact: the end is
      // known, and the broken name is still visible where it belongs -- the drain refuses it. With
      // nothing decodable, a name that spells the stop variables unexpanded is its own answer about
      // its WRITER, and only a malformed name that says nothing that specific is a plain "unobserved".
      if count(records) > 1 {
        AttemptExitRecordUnreadable { reason: join(["the attempt-exit spool holds ", to_string(value: count(records)), " exit records for one attempt, and its unit runs once: ", join(records |> map(r => r.entry_name), ", ")], "") }
      } else if count(records) == 1 {
        match records.first() {
          Present { value: r } => AttemptExitRecordFound { record: r }
          Absent => AttemptExitRecordNone
        }
      } else if count(unsubstituted) > 0 && count(unsubstituted) == count(malformed) {
        AttemptExitRecordWriterUnsubstituted { entries: unsubstituted, variables: attempt_exit_unexpanded_variables_of(entries: unsubstituted) }
      } else if count(malformed) > 0 {
        AttemptExitRecordUnreadable { reason: join(["the attempt-exit spool holds an exit entry for this attempt that cannot be decoded, so its end is unobserved rather than absent: ", join(malformed, "; ")], "") }
      } else {
        AttemptExitRecordNone
      }
    }
  }
}

fn attempt_exit_stage_listings(instance_root: String) -> List<SpoolListing> {
  [RolePending, RoleHandedOff, RoleClaimed, RoleDone, RoleRefused] |> map(r => spool_queue_list(store: spool_open(kind: SpoolAttemptExit, instance_root: instance_root), role: r))
}

fn attempt_exit_record_observe(instance_root: String, node_id: String, attempt_key: String, role: AttemptUnitRole) -> AttemptExitRecordObservation {
  attempt_exit_record_from_listings(node_id: node_id, attempt_key: attempt_key, role: role, listings: attempt_exit_stage_listings(instance_root: instance_root))
}

fn attempt_exit_spool_prepare(instance_root: String) -> Bool {
  fold(
    [RolePending, RoleHandedOff, RoleClaimed, RoleDone, RoleRefused],
    init: true,
    f: (ok, r) => ok && match spool_role_path(store: spool_open(kind: SpoolAttemptExit, instance_root: instance_root), role: r) {
      Present { value: dir } => shell.Mkdir.Parents(path: dir as FilePath).success
      Absent => false
    },
  )
}

type AttemptExitRecordPut
  = AttemptExitRecordPutOk
  | AttemptExitRecordPutFailed { reason: String }

// A vendor pane gives one number (`pane_dead_status`), not systemd's three stop variables. Zero is
// the documented success exit; any other number is an exit-code. The record is still the seven-part
// inbox name so the decoder can read `end`, but invocation `vendorpane` marks the belt as the
// writer — this is not ExecStopPost and must not mint `success` for a killed pane.
fn attempt_exit_vendor_pane_result_word(status: Int) -> String {
  if status == 0 {
    "success"
  } else {
    "exit-code"
  }
}

fn attempt_exit_vendor_pane_entry_name(node_id: String, attempt_key: String, status: Int) -> String {
  join([
    node_id,
    attempt_exit_entry_separator,
    attempt_key,
    attempt_exit_entry_separator,
    attempt_unit_role_token(role: AttemptWorkerRole),
    attempt_exit_entry_separator,
    "vendorpane",
    attempt_exit_entry_separator,
    attempt_exit_vendor_pane_result_word(status: status),
    attempt_exit_entry_separator,
    "exited",
    attempt_exit_entry_separator,
    to_string(value: status),
  ], "")
}

type VendorPaneDeath
  = VendorPaneExited { status: Int }
  | VendorPaneSignaled { signal: Int }

fn attempt_exit_vendor_pane_signaled_entry_name(node_id: String, attempt_key: String, signal_name: String) -> String {
  join([
    node_id,
    attempt_exit_entry_separator,
    attempt_key,
    attempt_exit_entry_separator,
    attempt_unit_role_token(role: AttemptWorkerRole),
    attempt_exit_entry_separator,
    "vendorpane",
    attempt_exit_entry_separator,
    "signal",
    attempt_exit_entry_separator,
    "killed",
    attempt_exit_entry_separator,
    signal_name,
  ], "")
}

fn attempt_exit_vendor_pane_entry_name_of_death(node_id: String, attempt_key: String, death: VendorPaneDeath) -> String? {
  match death {
    VendorPaneExited { status } =>
      Present { value: attempt_exit_vendor_pane_entry_name(node_id: node_id, attempt_key: attempt_key, status: status) }
    VendorPaneSignaled { signal } =>
      match linux_standard_signal_of_number(n: signal) {
        Absent => none
        Present { value: sig } =>
          Present {
            value: attempt_exit_vendor_pane_signaled_entry_name(
              node_id: node_id,
              attempt_key: attempt_key,
              signal_name: linux_standard_signal_wire_name(signal: sig),
            ),
          }
      }
  }
}

// Vendor tmux panes have no ExecStopPost. The belt writes an inbox mkdir-name when it first sees
// the dead pane, before it may reap. Callers that will reap must CHECK the result and keep the
// dead pane when the write fails. Create-only mkdir is `mkdir_create_only_command`: the spool must
// already exist; a missing or read-only inbox is a failed write, not a parent-creating success.
fn attempt_exit_record_put_mkdir_name(instance_root: String, entry_name: String) -> AttemptExitRecordPut {
  // A NAME THE WRITER NEVER EXPANDED IS NOT AN ENTRY. This mkdir route takes the entry name as TEXT
  // (the belt's vendor-pane route, a replay, a hand call), and a name still carrying the stop-hook
  // variable spelling is the writer's defect, not an exit fact: only the service manager substitutes
  // those variables, so no modeled writer may mint one and none may write one. srv1 2026-10-28
  // 06:17:02Z is exactly that artifact -- attempt-exit-spool/refused/debt-exclusion-frontier-
  // excludes-nothing+6ea61c671002a6d4+worker+${INVOCATION_ID}+${SERVICE_RESULT}+${EXIT_CODE}+
  // ${EXIT_STATUS}, mode 0755 owned by briansrls (not gunbc-worker), written outside the unit's
  // ExecStopPost by a path that carried the hook's dollar sign protected from the manager's own
  // expansion. Refusing it here is what makes that entry unwritable through any modeled route; the
  // reader arm (AttemptExitRecordWriterUnsubstituted) is what refuses to read one that already exists.
  let unexpanded = attempt_exit_entry_unexpanded_variables(entry_name: entry_name)
  if !unexpanded.is_empty() {
    AttemptExitRecordPutFailed {
      reason: join(
        ["the entry name carries service-manager variables that were never substituted (", join(unexpanded, ", "), "); a stop hook whose substitution did not run is a writer defect, not an exit record"],
        "",
      ),
    }
  } else {
  match attempt_exit_pending_dir(instance_root: instance_root) {
    Absent => AttemptExitRecordPutFailed { reason: "attempt exit spool declares no pending directory" }
    Present { value: pending } => {
      let path = join([pending, "/", entry_name], "")
      let command = mkdir_create_only_command(path: path)
      let ran = shell.Exec.RunArgv(
        program: command.program.invocation as String,
        arguments: command.arguments,
      )
      if ran.exit_code == 0 {
        AttemptExitRecordPutOk
      } else {
        AttemptExitRecordPutFailed {
          reason: join(["mkdir -- ", path, " failed: ", ran.stderr], ""),
        }
      }
    }
  }
  }
}

fn attempt_exit_record_put_vendor_pane_death(instance_root: String, node_id: String, attempt_key: String, death: VendorPaneDeath) -> AttemptExitRecordPut {
  match attempt_exit_record_observe(instance_root: instance_root, node_id: node_id, attempt_key: attempt_key, role: AttemptWorkerRole) {
    AttemptExitRecordFound { record: _ } => AttemptExitRecordPutOk
    AttemptExitRecordWriterUnsubstituted { entries: _, variables: _ } =>
      // The spool holds only names the writer never expanded. Writing the real record here IS the
      // repair: a decodable record outranks a malformed sibling in attempt_exit_record_matching, so the
      // subject becomes answerable and the broken name stops being read as anything about the attempt.
      match attempt_exit_vendor_pane_entry_name_of_death(node_id: node_id, attempt_key: attempt_key, death: death) {
        Absent =>
          AttemptExitRecordPutFailed {
            reason: "vendor pane signal is not a standard Linux signal name",
          }
        Present { value: entry_name } =>
          attempt_exit_record_put_mkdir_name(instance_root: instance_root, entry_name: entry_name)
      }
    AttemptExitRecordUnreadable { reason } => AttemptExitRecordPutFailed { reason: reason }
    AttemptExitRecordNone =>
      match attempt_exit_vendor_pane_entry_name_of_death(node_id: node_id, attempt_key: attempt_key, death: death) {
        Absent =>
          AttemptExitRecordPutFailed {
            reason: "vendor pane signal is not a standard Linux signal name",
          }
        Present { value: entry_name } =>
          attempt_exit_record_put_mkdir_name(instance_root: instance_root, entry_name: entry_name)
      }
  }
}

fn attempt_exit_record_put_worker_exited(instance_root: String, node_id: String, attempt_key: String, status: Int) -> AttemptExitRecordPut {
  attempt_exit_record_put_vendor_pane_death(
    instance_root: instance_root,
    node_id: node_id,
    attempt_key: attempt_key,
    death: VendorPaneExited { status: status },
  )
}
