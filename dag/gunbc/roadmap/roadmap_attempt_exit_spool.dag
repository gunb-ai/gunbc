  SpoolAttemptExit, SpoolComputeExit, SpoolStore, RolePending, RoleHandedOff, RoleClaimed, RoleDone, RoleRefused,
  SpoolListing, SpoolListed, SpoolListingUnreadable, spool_open, spool_open_uid, SpoolOpenVerdict, SpoolOpenReady, SpoolOpenRefused, spool_queue_list, spool_directory_listing, spool_role_path, spool_entry_key_of_name, SpoolKeyMinted, SpoolKeyRefused,
}
