module gunbc.citation.pdf_safe_profile


data pdf_safe_profile_note: String = "gunbc bounded admission policy for RFC 8118 PDF open parameters — NOT upstream semantics. extdeps.standards.rfc_8118 owns the full RFC vocabulary; this module declines parameters gunbc has not yet admitted for citation use."

type PdfRefusedParameterKind
  = PdfParameterComment
  | PdfParameterEmbeddedFile
  | PdfParameterZoom
  | PdfParameterView
  | PdfParameterViewRect
  | PdfParameterHighlight
  | PdfParameterSearch
  | PdfParameterFdf

type PdfProfileRefusalCause
  = ParameterOutsideCit1SafeProfile { parameter: PdfRefusedParameterKind }

type PdfSafeProfileParameter
  = SafeOpenPage(extdeps.standards.rfc_8118.PdfOpenPage)
  | SafeOpenNamedDest(extdeps.standards.rfc_8118.PdfOpenNamedDest)
  | SafeOpenStructElem(extdeps.standards.rfc_8118.PdfOpenStructElem)

type PdfSafeProfileParameterConstruction
  = SafeParameterConstructed(PdfSafeProfileParameter)
  | SafeParameterConstructionRefused { cause: PdfProfileRefusalCause }

type PdfSafeParameterSequence {
  parameters: List<PdfSafeProfileParameter>
}

type PdfSafeParameterSequenceConstruction
  = SafeSequenceConstructed(PdfSafeParameterSequence)
  | SafeSequenceConstructionRefused { cause: PdfProfileRefusalCause }

type PdfSafeParameterSequenceFoldState
  = SafeSequenceFoldBuilding { parameters: List<PdfSafeProfileParameter> }
  | SafeSequenceFoldRefused { cause: PdfProfileRefusalCause }

type NavigableUriSafeRefusalCause
  = SafeParameterConstructionRefusedInSequence { cause: PdfProfileRefusalCause }
  | BaseLocatorAlreadyCarriesFragmentFromRfc { locator: std.types.NonEmptyStr }
  | PdfOpenParameterPercentEncodeRefusedFromSafe {
      parameter: extdeps.standards.rfc_8118.PdfProfileParameter,
      cause: extdeps.uri.UriPercentEncodeRefusalCause,
    }

type NavigableUriSafeProjection
  = NavigableUriSafeProjected { uri: extdeps.uri.Uri }
  | NavigableUriSafeRefused { cause: NavigableUriSafeRefusalCause }

fn pdf_safe_open_page(page: std.integer.PositiveInt) -> PdfSafeProfileParameterConstruction {
  SafeParameterConstructed(SafeOpenPage(extdeps.standards.rfc_8118.PdfOpenPage { page: page }))
}

fn pdf_safe_open_nameddest(name: std.types.NonEmptyStr) -> PdfSafeProfileParameterConstruction {
  SafeParameterConstructed(SafeOpenNamedDest(extdeps.standards.rfc_8118.PdfOpenNamedDest { name: name }))
}

fn pdf_safe_open_structelem(struct_id: std.types.NonEmptyStr) -> PdfSafeProfileParameterConstruction {
  SafeParameterConstructed(SafeOpenStructElem(extdeps.standards.rfc_8118.PdfOpenStructElem { struct_id: struct_id }))
}

fn admit_rfc_pdf_profile_parameter(construction: extdeps.standards.rfc_8118.PdfProfileParameterConstruction) -> PdfSafeProfileParameterConstruction {
  match construction {
    extdeps.standards.rfc_8118.ParameterConstructed(parameter) =>
      match parameter {
        extdeps.standards.rfc_8118.OpenPage(p) => SafeParameterConstructed(SafeOpenPage(p))
        extdeps.standards.rfc_8118.OpenNamedDest(d) => SafeParameterConstructed(SafeOpenNamedDest(d))
        extdeps.standards.rfc_8118.OpenStructElem(e) => SafeParameterConstructed(SafeOpenStructElem(e))
        extdeps.standards.rfc_8118.OpenZoom(_) =>
          SafeParameterConstructionRefused {
            cause: ParameterOutsideCit1SafeProfile { parameter: PdfParameterZoom },
          }
        extdeps.standards.rfc_8118.OpenComment(_) =>
          SafeParameterConstructionRefused {
            cause: ParameterOutsideCit1SafeProfile { parameter: PdfParameterComment },
          }
        extdeps.standards.rfc_8118.OpenView(_) =>
          SafeParameterConstructionRefused {
            cause: ParameterOutsideCit1SafeProfile { parameter: PdfParameterView },
          }
        extdeps.standards.rfc_8118.OpenViewRect(_) =>
          SafeParameterConstructionRefused {
            cause: ParameterOutsideCit1SafeProfile { parameter: PdfParameterViewRect },
          }
        extdeps.standards.rfc_8118.OpenHighlight(_) =>
          SafeParameterConstructionRefused {
            cause: ParameterOutsideCit1SafeProfile { parameter: PdfParameterHighlight },
          }
        extdeps.standards.rfc_8118.OpenSearch(_) =>
          SafeParameterConstructionRefused {
            cause: ParameterOutsideCit1SafeProfile { parameter: PdfParameterSearch },
          }
        extdeps.standards.rfc_8118.OpenFdf(_) =>
          SafeParameterConstructionRefused {
            cause: ParameterOutsideCit1SafeProfile { parameter: PdfParameterFdf },
          }
      }
  }
}

fn pdf_safe_parameter_sequence(constructions: List<extdeps.standards.rfc_8118.PdfProfileParameterConstruction>) -> PdfSafeParameterSequenceConstruction {
  match fold(constructions, init: SafeSequenceFoldBuilding { parameters: [] }, f: fn(acc, construction) {
    match acc {
      SafeSequenceFoldRefused { cause: _ } => acc
      SafeSequenceFoldBuilding { parameters: admitted } =>
        match admit_rfc_pdf_profile_parameter(construction: construction) {
          SafeParameterConstructionRefused { cause: cause } => SafeSequenceFoldRefused { cause: cause }
          SafeParameterConstructed(parameter) =>
            SafeSequenceFoldBuilding { parameters: [parameter] |> concat(admitted) }
        }
    }
  }) {
    SafeSequenceFoldRefused { cause: cause } => SafeSequenceConstructionRefused { cause: cause }
    SafeSequenceFoldBuilding { parameters: parameters } =>
      SafeSequenceConstructed(PdfSafeParameterSequence { parameters: reverse(parameters) })
  }
}

fn pdf_safe_parameter_sequence_to_rfc(sequence: PdfSafeParameterSequence) -> extdeps.standards.rfc_8118.PdfOpenParameterSequence {
  extdeps.standards.rfc_8118.PdfOpenParameterSequence {
    parameters: map(
      sequence.parameters,
      parameter => match parameter {
        SafeOpenPage(p) => extdeps.standards.rfc_8118.OpenPage(p)
        SafeOpenNamedDest(d) => extdeps.standards.rfc_8118.OpenNamedDest(d)
        SafeOpenStructElem(e) => extdeps.standards.rfc_8118.OpenStructElem(e)
      },
    ),
  }
}

fn project_navigable_uri_safe(base: extdeps.uri.Uri, construction: PdfSafeParameterSequenceConstruction) -> NavigableUriSafeProjection {
  match construction {
    SafeSequenceConstructionRefused { cause: cause } =>
      NavigableUriSafeRefused {
        cause: SafeParameterConstructionRefusedInSequence { cause: cause },
      }
    SafeSequenceConstructed(sequence) =>
      match extdeps.standards.rfc_8118.project_navigable_uri(
        base: base,
        sequence: pdf_safe_parameter_sequence_to_rfc(sequence: sequence),
      ) {
        extdeps.standards.rfc_8118.NavigableUriProjected { uri: u } => NavigableUriSafeProjected { uri: u }
        extdeps.standards.rfc_8118.NavigableUriRefused { cause: extdeps.standards.rfc_8118.BaseLocatorAlreadyCarriesFragment { locator: l } } =>
          NavigableUriSafeRefused {
            cause: BaseLocatorAlreadyCarriesFragmentFromRfc { locator: l },
          }
        extdeps.standards.rfc_8118.NavigableUriRefused { cause: extdeps.standards.rfc_8118.PdfOpenParameterPercentEncodeRefused { parameter: p, cause: c } } =>
          NavigableUriSafeRefused {
            cause: PdfOpenParameterPercentEncodeRefusedFromSafe { parameter: p, cause: c },
          }
      }
  }
}

fn pdf_safe_parameters_include_page(sequence: PdfSafeParameterSequence, page: std.integer.PositiveInt) -> Bool {
  any(
    sequence.parameters,
    parameter => match parameter {
      SafeOpenPage(extdeps.standards.rfc_8118.PdfOpenPage { page: n }) => n == page
      _ => false
    },
  )
}
