module gunbc.citation.x86_64_abi_pdf_consumer


// Product-layer citation consumer for the x86_64 ABI PDF: admission, navigable URI
// projection, pin/citation receipts, and syscall-claim evidence. Upstream document
// facts (authority, identity, edition, calling convention) live in extdeps.runtime.abi.sysv_amd64.

type X86_64AbiPdfWetReceiptHexRefusalCause = WetReceiptHexMalformed { hex: String }

type X86_64AbiPdfPinRefusalCause
  = IndependentExpectedPinUnavailable
  | PinEstablishmentReceiptHexRefused { hex: String, cause: gunbc.citation.x86_64_abi_pdf_consumer.X86_64AbiPdfWetReceiptHexRefusalCause }

type X86_64AbiPdfCitationRungDisposition = BelowDigestMatchedRung { cause: gunbc.citation.x86_64_abi_pdf_consumer.X86_64AbiPdfPinRefusalCause }

type X86_64AbiPdfValidatedDigestConstruction = X86_64AbiPdfValidatedDigestConstructed(std.content_hash.Sha256Digest) | X86_64AbiPdfValidatedDigestHexRefused { hex: String, cause: gunbc.citation.x86_64_abi_pdf_consumer.X86_64AbiPdfWetReceiptHexRefusalCause }

type X86_64AbiPdfRetrievalObservationConstruction = X86_64AbiPdfRetrievalObserved(std.citation.CitationRetrievalObservation) | X86_64AbiPdfRetrievalDigestHexRefused { hex: String, cause: gunbc.citation.x86_64_abi_pdf_consumer.X86_64AbiPdfWetReceiptHexRefusalCause }

type X86_64AbiPdfExpectedDigestConstruction = X86_64AbiPdfExpectedDigestUnavailable { cause: gunbc.citation.x86_64_abi_pdf_consumer.X86_64AbiPdfPinRefusalCause }

type X86_64AbiPdfCitationSelectorRefusalCause = X86_64AbiPdfCitationSelectorFragmentRefused { cause: extdeps.standards.rfc_8118.NavigableUriRefusalCause } | X86_64AbiPdfCitationSelectorSafeSequenceRefused { cause: gunbc.citation.pdf_safe_profile.PdfProfileRefusalCause }

type X86_64AbiPdfCitationSelectorConstruction = X86_64AbiPdfCitationSelectorConstructed(std.citation.CitationSelector) | X86_64AbiPdfCitationSelectorRefused { cause: gunbc.citation.x86_64_abi_pdf_consumer.X86_64AbiPdfCitationSelectorRefusalCause }

type X86_64AbiPdfNavigableUriProjection = X86_64AbiPdfNavigableUriProjected { uri: extdeps.uri.Uri } | X86_64AbiPdfNavigableUriRefused { cause: gunbc.citation.pdf_safe_profile.NavigableUriSafeRefusalCause }

type X86_64AbiPdfPinConstruction = X86_64AbiPdfPinConstructed(extdeps.firmware.uefi_shell.Pin<std.citation.CitedRepresentationIdentity>) | X86_64AbiPdfPinRefused { cause: gunbc.citation.x86_64_abi_pdf_consumer.X86_64AbiPdfPinRefusalCause }

type X86_64AbiCitationFactConstruction = X86_64AbiCitationFactConstructed(RecordedFact<CitationRecordedFact<std.citation.CitationSelector>>) | X86_64AbiCitationFactRefused { pin: gunbc.citation.x86_64_abi_pdf_consumer.X86_64AbiPdfPinConstruction, selector: gunbc.citation.x86_64_abi_pdf_consumer.X86_64AbiPdfCitationSelectorConstruction }

type X86_64AbiEvidenceLinkConstruction = X86_64AbiEvidenceLinkConstructed(EvidenceLink<CitationRecordedFact<CitationSelector>, ClaimId, ExternalAuthority, std.types.NonEmptyStr, ReadBackProbe>) | X86_64AbiEvidenceLinkRefused { fact: gunbc.citation.x86_64_abi_pdf_consumer.X86_64AbiCitationFactConstruction }

fn x86_64_abi_pdf_validated_digest_from_wet_receipt(hex: String) -> gunbc.citation.x86_64_abi_pdf_consumer.X86_64AbiPdfValidatedDigestConstruction {
  match sha256_hex_digest(hex: hex) {
    Present { value: digest } => X86_64AbiPdfValidatedDigestConstructed(digest)
    Absent =>
      X86_64AbiPdfValidatedDigestHexRefused {
        hex: hex,
        cause: WetReceiptHexMalformed { hex: hex },
      }
  }
}

fn x86_64_abi_pdf_retrieval_observation_from_hex(hex: String) -> gunbc.citation.x86_64_abi_pdf_consumer.X86_64AbiPdfRetrievalObservationConstruction {
  match x86_64_abi_pdf_validated_digest_from_wet_receipt(hex: hex) {
    X86_64AbiPdfValidatedDigestConstructed(digest) =>
      X86_64AbiPdfRetrievalObserved(
        std.citation.RepresentationRetrieved {
          request: std.citation.CitationRetrievalRequest {
            locator: extdeps.runtime.abi.sysv_amd64.extdeps_external_authority_anchor.uri,
          },
          observed_at: 0,
          http_status: 200,
          observed: observed_cited_representation(
            identity: x86_64_abi_pdf_identity,
            media_type: x86_64_abi_application_pdf,
            observed_identity: digest,
          ),
        },
      )
    X86_64AbiPdfValidatedDigestHexRefused { hex: refused_hex, cause: cause } =>
      X86_64AbiPdfRetrievalDigestHexRefused { hex: refused_hex, cause: cause }
  }
}

data x86_64_abi_pdf_expected_digest_construction: gunbc.citation.x86_64_abi_pdf_consumer.X86_64AbiPdfExpectedDigestConstruction = X86_64AbiPdfExpectedDigestUnavailable { cause: IndependentExpectedPinUnavailable }

fn assemble_x86_64_abi_pdf_pin_construction() -> gunbc.citation.x86_64_abi_pdf_consumer.X86_64AbiPdfPinConstruction {
  X86_64AbiPdfPinRefused { cause: IndependentExpectedPinUnavailable }
}

data x86_64_abi_pdf_pin_construction: gunbc.citation.x86_64_abi_pdf_consumer.X86_64AbiPdfPinConstruction = assemble_x86_64_abi_pdf_pin_construction()

fn x86_64_abi_pdf_version_cover_sequence() -> gunbc.citation.pdf_safe_profile.PdfSafeParameterSequenceConstruction {
  pdf_safe_parameter_sequence(constructions: [pdf_open_page(page: 1)])
}

fn x86_64_abi_pdf_syscall_convention_sequence() -> gunbc.citation.pdf_safe_profile.PdfSafeParameterSequenceConstruction {
  pdf_safe_parameter_sequence(
    constructions: [pdf_open_page(page: x86_64_abi_syscall_convention_authoritative_page)],
  )
}

fn x86_64_abi_syscall_citation_page_is_authoritative(page: std.integer.PositiveInt) -> Bool {
  page == x86_64_abi_syscall_convention_authoritative_page
}

fn x86_64_abi_pdf_fragment_selector_from_page(page: std.integer.PositiveInt) -> gunbc.citation.x86_64_abi_pdf_consumer.X86_64AbiPdfCitationSelectorConstruction {
  match pdf_open_fragment_selector(
    sequence: match rfc_pdf_open_parameter_sequence(constructions: [pdf_open_page(page: page)]) {
      SequenceConstructed(seq) => seq
    },
  ) {
    PdfOpenFragmentSelectorConstructed(selector) => X86_64AbiPdfCitationSelectorConstructed(selector)
    PdfOpenFragmentSelectorRefused { cause: cause } =>
      X86_64AbiPdfCitationSelectorRefused {
        cause: X86_64AbiPdfCitationSelectorFragmentRefused { cause: cause },
      }
  }
}

fn x86_64_abi_pdf_citation_selector_from_safe(
  construction: gunbc.citation.pdf_safe_profile.PdfSafeParameterSequenceConstruction,
) -> gunbc.citation.x86_64_abi_pdf_consumer.X86_64AbiPdfCitationSelectorConstruction {
  match construction {
    SafeSequenceConstructed(sequence) =>
      match pdf_open_fragment_selector(
        sequence: pdf_safe_parameter_sequence_to_rfc(sequence: sequence),
      ) {
        PdfOpenFragmentSelectorConstructed(selector) => X86_64AbiPdfCitationSelectorConstructed(selector)
        PdfOpenFragmentSelectorRefused { cause: cause } =>
          X86_64AbiPdfCitationSelectorRefused {
            cause: X86_64AbiPdfCitationSelectorFragmentRefused { cause: cause },
          }
      }
    SafeSequenceConstructionRefused { cause: cause } =>
      X86_64AbiPdfCitationSelectorRefused {
        cause: X86_64AbiPdfCitationSelectorSafeSequenceRefused { cause: cause },
      }
  }
}

fn x86_64_abi_pdf_syscall_fragment_selector() -> gunbc.citation.x86_64_abi_pdf_consumer.X86_64AbiPdfCitationSelectorConstruction {
  x86_64_abi_pdf_citation_selector_from_safe(construction: x86_64_abi_pdf_syscall_convention_sequence())
}

data x86_64_abi_syscall_citation_rung_disposition: gunbc.citation.x86_64_abi_pdf_consumer.X86_64AbiPdfCitationRungDisposition = BelowDigestMatchedRung { cause: IndependentExpectedPinUnavailable }

fn x86_64_abi_syscall_citation_fact_construction() -> gunbc.citation.x86_64_abi_pdf_consumer.X86_64AbiCitationFactConstruction {
  match x86_64_abi_pdf_pin_construction {
    X86_64AbiPdfPinConstructed(pin) =>
      match x86_64_abi_pdf_syscall_fragment_selector() {
        X86_64AbiPdfCitationSelectorConstructed(selector) =>
          X86_64AbiCitationFactConstructed(
            citation_recorded_fact(
              id: "x86-64-abi-linux-syscall-arg3-r10-citation" as std.claim_evidence.RecordedFactId,
              cited: citation_target(expected_pin: pin, selector: selector),
            ),
          )
        X86_64AbiPdfCitationSelectorRefused { cause: selector_cause } =>
          X86_64AbiCitationFactRefused {
            pin: X86_64AbiPdfPinConstructed(pin),
            selector: X86_64AbiPdfCitationSelectorRefused { cause: selector_cause },
          }
      }
    X86_64AbiPdfPinRefused { cause: pin_cause } =>
      match x86_64_abi_pdf_syscall_fragment_selector() {
        X86_64AbiPdfCitationSelectorConstructed(selector) =>
          X86_64AbiCitationFactRefused {
            pin: X86_64AbiPdfPinRefused { cause: pin_cause },
            selector: X86_64AbiPdfCitationSelectorConstructed(selector),
          }
        X86_64AbiPdfCitationSelectorRefused { cause: selector_cause } =>
          X86_64AbiCitationFactRefused {
            pin: X86_64AbiPdfPinRefused { cause: pin_cause },
            selector: X86_64AbiPdfCitationSelectorRefused { cause: selector_cause },
          }
      }
  }
}

data x86_64_abi_syscall_convention_citation_fact_construction: gunbc.citation.x86_64_abi_pdf_consumer.X86_64AbiCitationFactConstruction = x86_64_abi_syscall_citation_fact_construction()

fn x86_64_abi_syscall_evidence_link_construction() -> gunbc.citation.x86_64_abi_pdf_consumer.X86_64AbiEvidenceLinkConstruction {
  match x86_64_abi_syscall_convention_citation_fact_construction {
    X86_64AbiCitationFactConstructed(fact) =>
      X86_64AbiEvidenceLinkConstructed(
        std.claim_evidence.EvidenceLink {
          fact: fact,
          direction: EvidenceSupports,
          inference_rule: "citation-extraction-supports-syscall-arg3-claim" as std.claim_evidence.InferenceRuleId,
          authority: extdeps.runtime.abi.sysv_amd64.extdeps_external_authority_anchor,
          provenance: std.claim_evidence.EvidenceProvenance {
            entity: "x86-64-abi-pdf-byte-extraction" as std.claim_evidence.ProvEntityId,
            activity: "wet-representation-retrieval" as std.claim_evidence.ProvActivityId,
            agent: "gunbc-citation-extraction-receipt" as std.claim_evidence.ProvAgentId,
          },
          freshness: std.claim_evidence.EvidenceFreshness {
            maximum_conclusion: "x86-64-abi-linux-syscall-arg3-is-r10" as std.claim_evidence.ClaimId,
            basis: "draft-edition-0.99.6-page-125-syscall-register-convention",
          },
          fidelity: std.claim_evidence.EvidenceFidelity {
            boundary: "raw-response-body-sha256" as std.types.NonEmptyStr,
            losses: [],
          },
          probe_independence: gunbc.readback_independence.ReadBackProbe {
            label: "independent-byte-extraction-receipt" as std.types.NonEmptyStr,
            subject: "x86-64-abi-pdf-raw-response-body" as std.types.NonEmptyStr,
            effect_on_subject: gunbc.readback_independence.ProbeMayEstablish {
              mechanism: "wet retrieval hashes bytes independently of authored pin",
            },
          },
        },
      )
    X86_64AbiCitationFactRefused { pin: pin_construction, selector: selector_construction } =>
      X86_64AbiEvidenceLinkRefused {
        fact: X86_64AbiCitationFactRefused {
          pin: pin_construction,
          selector: selector_construction,
        },
      }
  }
}

fn witness_syscall_citation_below_digest_matched_rung() -> Bool {
  match x86_64_abi_syscall_citation_rung_disposition {
    BelowDigestMatchedRung { cause: IndependentExpectedPinUnavailable } => true
  }
}

fn witness_syscall_evidence_link_binds_fact() -> Bool {
  match x86_64_abi_syscall_evidence_link_construction() {
    X86_64AbiEvidenceLinkConstructed(link) =>
      match x86_64_abi_syscall_convention_citation_fact_construction {
        X86_64AbiCitationFactConstructed(fact) => link.fact.id == fact.id
        X86_64AbiCitationFactRefused { pin: _, selector: _ } => false
      }
    X86_64AbiEvidenceLinkRefused { fact: X86_64AbiCitationFactConstructed(_) } => false
    X86_64AbiEvidenceLinkRefused { fact: X86_64AbiCitationFactRefused { pin: _, selector: _ } } => false
  }
}

fn x86_64_abi_pdf_navigable_uri_from_safe(
  construction: gunbc.citation.pdf_safe_profile.PdfSafeParameterSequenceConstruction,
) -> gunbc.citation.x86_64_abi_pdf_consumer.X86_64AbiPdfNavigableUriProjection {
  match project_navigable_uri_safe(
    base: extdeps.runtime.abi.sysv_amd64.extdeps_external_authority_anchor.uri,
    construction: construction,
  ) {
    NavigableUriSafeProjected { uri: u } => X86_64AbiPdfNavigableUriProjected { uri: u }
    NavigableUriSafeRefused { cause: cause } => X86_64AbiPdfNavigableUriRefused { cause: cause }
  }
}

fn x86_64_abi_pdf_navigable_uri_from_nameddest_scalar_code_points(
  name: std.types.NonEmptyStr,
  code_points: List<Int>,
) -> gunbc.citation.x86_64_abi_pdf_consumer.X86_64AbiPdfNavigableUriProjection {
  match pdf_open_nameddest_wire_from_scalar_code_points(name: name, code_points: code_points) {
    PdfProfileParameterWireRefused { parameter: p, cause: cause } =>
      X86_64AbiPdfNavigableUriRefused {
        cause: gunbc.citation.pdf_safe_profile.PdfOpenParameterPercentEncodeRefusedFromSafe { parameter: p, cause: cause },
      }
    PdfProfileParameterWired { wire: wire } =>
      match navigable_uri_projection_from_sequence_wire(
        base: extdeps.runtime.abi.sysv_amd64.extdeps_external_authority_anchor.uri,
        sequence_wire: extdeps.standards.rfc_8118.PdfOpenParameterSequenceWired { wire: wire },
      ) {
        NavigableUriProjected { uri: u } => X86_64AbiPdfNavigableUriProjected { uri: u }
        NavigableUriRefused { cause: BaseLocatorAlreadyCarriesFragment { locator: l } } =>
          X86_64AbiPdfNavigableUriRefused {
            cause: gunbc.citation.pdf_safe_profile.BaseLocatorAlreadyCarriesFragmentFromRfc { locator: l },
          }
        NavigableUriRefused { cause: PdfOpenParameterPercentEncodeRefused { parameter: p, cause: c } } =>
          X86_64AbiPdfNavigableUriRefused {
            cause: gunbc.citation.pdf_safe_profile.PdfOpenParameterPercentEncodeRefusedFromSafe { parameter: p, cause: c },
          }
      }
  }
}

fn x86_64_abi_pdf_version_navigable_uri_projection() -> gunbc.citation.x86_64_abi_pdf_consumer.X86_64AbiPdfNavigableUriProjection {
  x86_64_abi_pdf_navigable_uri_from_safe(construction: x86_64_abi_pdf_version_cover_sequence())
}

fn x86_64_abi_pdf_syscall_navigable_uri_projection() -> gunbc.citation.x86_64_abi_pdf_consumer.X86_64AbiPdfNavigableUriProjection {
  x86_64_abi_pdf_navigable_uri_from_safe(construction: x86_64_abi_pdf_syscall_convention_sequence())
}

fn x86_64_abi_pdf_base_locator_probe() -> std.types.NonEmptyStr {
  extdeps.runtime.abi.sysv_amd64.extdeps_external_authority_anchor.uri.locator
}
