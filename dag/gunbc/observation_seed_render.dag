}
import std.decl_ref { DeclarationRef, WholeDeclaration }
import std.render { RenderCapability, Clear }
import gunbc.observation_tty_render {
  TtyEmissionProjected,
  TtyEmissionRefused,
  tty_event_emission_under,
  tty_render_emission,
}
