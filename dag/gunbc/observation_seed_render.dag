  DynamicLineClosed,
  DynamicLineOpen,
  DynamicLineState,
  TerminalWriteProjected,
  TerminalWriteRefused,
  project_terminal_write,
}
import gunbc.observation_ci_render {
  ci_event_line,
  ci_render_line,
  ci_heartbeat_line,
  ci_hold_cause_text,
  ci_measurement_rss_line,
  HeartbeatSample,
  RenderedLine,
}

// The seed to .dag render boundary. The v1 seed (claim_executor and its siblings) emits progress
// lines, but the FORMAT is a single authority in gunbc.observation_ci_render — a raw eprintln in
// the seed forks that format the way a hand-rolled duration string forks std.measure. This module
// is the boundary the seed calls across, exactly as cli_run.install_output_policy calls
// output_policy.resolve_channel_policy: primitive arguments in, a rendered line out, no format
// logic on the seed side. It constructs the ObservationEvent the seed's occurrence corresponds to
// (a phase concluding is a Concluded event on a PhaseSegment subject) and projects it through the
// existing renderer, so the seed cannot drift from the model. It holds no telemetry source and
// computes no facts of its own; every field it fills came in as an argument the seed already had
// (observation law 5).

// The attention basis governs PLACEMENT (ambient collapses, an anomaly surfaces), not the rendered string — ci_render_line reads only the glyph and text. It is supplied here, not omitted, so a future placement consumer reads a real level rather than a fabricated one, and it is grounded in the clamp overhead the floor already models (the non-per-unit floor time gunbc.ci_spec budgets as gunbc_ci_floor_batch_clamp_params overhead_seconds) rather than a threshold invented in a formatting helper: a prelude phase completing inside the whole overhead budget is routine, so it reads Ambient. The seed passes that overhead in as overhead_ms — this module does not reach for it, keeping the module a pure projection.
fn seed_tier(emoji: Bool) -> Tier {
  if emoji { Emoji } else { Unicode }
}

type ScopedRunWriteProjection
  = ScopedRunWriteProjected { bytes: String, next: DynamicLineState }
  | ScopedRunWriteRefused { cause: NonEmptyStr }

type ScopedRunMeasuredProjection
  = ScopedRunMeasuredProjected { bytes: String, next: DynamicLineState, wall: Nanosecond }
  | ScopedRunMeasuredRefused { cause: NonEmptyStr }

type ScopedRunTimingReceipt
  = ScopedRunTimingProjected { wall: Nanosecond, seed_resolution: Nanosecond }

// The first real density-aware seed consumer. The user program's entry graph stays independent:
// cli_run resolves this authority as a dedicated graph and transports only the scoped run facts it
// already owns. The interpreter seed bridge is the narrow primitive-argument call into this module;
// its hand seam dissolves when the generated host-effect bridge can carry the same typed arguments
// without a stringly call scaffold. This module constructs the Run/Entry/Phase subject, derives
// attention and cursor action through observation_tty_render, and delegates every terminal byte and
// dynamic-line transition to extdeps.render.terminal. The seed may retain the returned canonical
// dynamic-line state; it may not spell a fallback line or reinterpret a refusal. Monotonic
// Nanosecond elapsed wall values include the bridge-resolution overhead by starting before
// authority resolution; no acceptance threshold is invented here, and the measured overhead is
// recorded by the seed witness receipt.

fn scoped_run_subject(entry_file: NonEmptyStr, module_path: NonEmptyStr, function: NonEmptyStr) -> ObservationSubject {
  ObservationSubject {
    segments: [
      RunSegment { id: "gunbc run" as NonEmptyStr },
      EntrySegment { source_path: entry_file },
      DeclarationSegment {
        declaration: DeclarationRef {
          module_path: module_path,
          decl_name: function,
          field: WholeDeclaration
        }
      },
      PhaseSegment { name: "eval" as NonEmptyStr }
    ]
  }
}

fn scoped_run_capability(addressable: Bool, emoji: Bool) -> RenderCapability {
  RenderCapability {
    color: false,
    tier: seed_tier(emoji: emoji),
    cursor_addressable: addressable
  }
}

fn scoped_run_project(
  event: ObservationEvent,
  addressable: Bool,
  emoji: Bool,
  prior: DynamicLineState
) -> ScopedRunWriteProjection {
  let cap = scoped_run_capability(addressable: addressable, emoji: emoji)
  match tty_event_emission_under(
    event: event,
    basis: MeasuredUnavailable { cause: "scoped run has no attention basis" as NonEmptyStr },
    cap: cap
  ) {
    TtyEmissionRefused { cause: c } => ScopedRunWriteRefused { cause: c }
    TtyEmissionProjected { emission: e } =>
      match project_terminal_write(
        prior: prior,
        requested: e.cursor,
        capability: cap,
        rendered: tty_render_emission(emission: e, tier: cap.tier)
      ) {
        TerminalWriteRefused { cause: c } => ScopedRunWriteRefused { cause: c }
        TerminalWriteProjected { bytes: b, next: n } =>
          ScopedRunWriteProjected {
            bytes: b,
            next: n
          }
      }
  }
}

fn scoped_run_event(
  entry_file: NonEmptyStr,
  module_path: NonEmptyStr,
  function: NonEmptyStr,
  transition: std.observation.ObservationTransition
) -> ObservationEvent {
  ObservationEvent {
    subject: scoped_run_subject(entry_file: entry_file, module_path: module_path, function: function),
    transition: transition,
    durations: observation_durations_wall_unavailable(cause: "scoped run wall is not measured" as NonEmptyStr),
    rss: MeasuredUnavailable { cause: "scoped run rss is not sampled" as NonEmptyStr }
  }
}

fn scoped_run_measured_event(
  entry_file: NonEmptyStr,
  module_path: NonEmptyStr,
  function: NonEmptyStr,
  wall: Nanosecond,
  transition: std.observation.ObservationTransition
) -> ObservationEvent {
  ObservationEvent {
    subject: scoped_run_subject(entry_file: entry_file, module_path: module_path, function: function),
    transition: transition,
    durations: observation_durations_wall(elapsed: wall),
    rss: MeasuredUnavailable { cause: "scoped run rss is not sampled" as NonEmptyStr }
  }
}

fn scoped_run_project_measured(
  event: ObservationEvent,
  addressable: Bool,
  emoji: Bool,
  prior: DynamicLineState
) -> ScopedRunMeasuredProjection {
  match observation_wall(event: event) {
    MeasuredUnavailable { cause: c } => ScopedRunMeasuredRefused { cause: c }
    MeasuredValue { value: wall } =>
      match scoped_run_project(event: event, addressable: addressable, emoji: emoji, prior: prior) {
        ScopedRunWriteRefused { cause: c } => ScopedRunMeasuredRefused { cause: c }
        ScopedRunWriteProjected { bytes: b, next: n } => ScopedRunMeasuredProjected { bytes: b, next: n, wall: wall }
      }
  }
}

fn scoped_run_timing_receipt(wall: Nanosecond, seed_resolution: Nanosecond) -> ScopedRunTimingReceipt {
  ScopedRunTimingProjected {
    wall: wall,
    seed_resolution: seed_resolution
  }
}

fn scoped_run_begin_write_measured(entry_file: NonEmptyStr, module_path: NonEmptyStr, function: NonEmptyStr, wall: Nanosecond, addressable: Bool, emoji: Bool, prior: DynamicLineState) -> ScopedRunMeasuredProjection {
  scoped_run_project_measured(
    event: scoped_run_measured_event(entry_file: entry_file, module_path: module_path, function: function, wall: wall, transition: Begin),
    addressable: addressable,
    emoji: emoji,
    prior: prior
  )
}

fn scoped_run_final_write_measured(entry_file: NonEmptyStr, module_path: NonEmptyStr, function: NonEmptyStr, wall: Nanosecond, addressable: Bool, emoji: Bool, prior: DynamicLineState) -> ScopedRunMeasuredProjection {
  scoped_run_project_measured(
    event: scoped_run_measured_event(entry_file: entry_file, module_path: module_path, function: function, wall: wall, transition: Concluded { outcome: Final { shown_failures: 0 } }),
    addressable: addressable,
    emoji: emoji,
    prior: prior
  )
}

fn scoped_run_refused_write_measured(entry_file: NonEmptyStr, module_path: NonEmptyStr, function: NonEmptyStr, diagnostic: NonEmptyStr, wall: Nanosecond, addressable: Bool, emoji: Bool, prior: DynamicLineState) -> ScopedRunMeasuredProjection {
  scoped_run_project_measured(
    event: scoped_run_measured_event(entry_file: entry_file, module_path: module_path, function: function, wall: wall, transition: Concluded { outcome: Refused { diagnostic: diagnostic } }),
    addressable: addressable,
    emoji: emoji,
    prior: prior
  )
}

fn scoped_run_failed_write_measured(entry_file: NonEmptyStr, module_path: NonEmptyStr, function: NonEmptyStr, error: NonEmptyStr, wall: Nanosecond, addressable: Bool, emoji: Bool, prior: DynamicLineState) -> ScopedRunMeasuredProjection {
  scoped_run_project_measured(
    event: scoped_run_measured_event(entry_file: entry_file, module_path: module_path, function: function, wall: wall, transition: Concluded { outcome: Failed { error: error, output: "" } }),
    addressable: addressable,
    emoji: emoji,
    prior: prior
  )
}

fn scoped_run_begin_write(entry_file: NonEmptyStr, module_path: NonEmptyStr, function: NonEmptyStr, addressable: Bool, emoji: Bool, prior: DynamicLineState) -> ScopedRunWriteProjection {
  scoped_run_project(
    event: scoped_run_event(entry_file: entry_file, module_path: module_path, function: function, transition: Begin),
    addressable: addressable,
    emoji: emoji,
    prior: prior
  )
}

fn scoped_run_final_write(entry_file: NonEmptyStr, module_path: NonEmptyStr, function: NonEmptyStr, addressable: Bool, emoji: Bool, prior: DynamicLineState) -> ScopedRunWriteProjection {
  scoped_run_project(
    event: scoped_run_event(entry_file: entry_file, module_path: module_path, function: function, transition: Concluded { outcome: Final { shown_failures: 0 } }),
    addressable: addressable,
    emoji: emoji,
    prior: prior
  )
}

fn scoped_run_refused_write(entry_file: NonEmptyStr, module_path: NonEmptyStr, function: NonEmptyStr, diagnostic: NonEmptyStr, addressable: Bool, emoji: Bool, prior: DynamicLineState) -> ScopedRunWriteProjection {
  scoped_run_project(
    event: scoped_run_event(entry_file: entry_file, module_path: module_path, function: function, transition: Concluded { outcome: Refused { diagnostic: diagnostic } }),
    addressable: addressable,
    emoji: emoji,
    prior: prior
  )
}

fn scoped_run_projection_refusal_write(entry_file: NonEmptyStr, module_path: NonEmptyStr, function: NonEmptyStr, diagnostic: NonEmptyStr, addressable: Bool, emoji: Bool, prior: DynamicLineState) -> ScopedRunWriteProjection {
  scoped_run_refused_write(
    entry_file: entry_file,
    module_path: module_path,
    function: function,
    diagnostic: diagnostic,
    addressable: addressable,
    emoji: emoji,
    prior: prior
  )
}

fn scoped_run_close_before_deferred_write(entry_file: NonEmptyStr, module_path: NonEmptyStr, function: NonEmptyStr, addressable: Bool, emoji: Bool, prior: DynamicLineState) -> ScopedRunWriteProjection {
  let cap = scoped_run_capability(addressable: addressable, emoji: emoji)
  match project_terminal_write(
    prior: prior,
    requested: Clear,
    capability: cap,
    rendered: ""
  ) {
    TerminalWriteRefused { cause: c } => ScopedRunWriteRefused { cause: c }
    TerminalWriteProjected { bytes: b, next: n } =>
      ScopedRunWriteProjected {
        bytes: b,
          next: n
      }
  }
}

fn scoped_run_failed_write(entry_file: NonEmptyStr, module_path: NonEmptyStr, function: NonEmptyStr, error: NonEmptyStr, addressable: Bool, emoji: Bool, prior: DynamicLineState) -> ScopedRunWriteProjection {
  scoped_run_project(
    event: scoped_run_event(entry_file: entry_file, module_path: module_path, function: function, transition: Concluded { outcome: Failed { error: error, output: "" } }),
    addressable: addressable,
    emoji: emoji,
    prior: prior
  )
}

fn scoped_run_timed_out_write(entry_file: NonEmptyStr, module_path: NonEmptyStr, function: NonEmptyStr, basis: ClockBasis, budget: Millisecond, elapsed: Millisecond, addressable: Bool, emoji: Bool, prior: DynamicLineState) -> ScopedRunWriteProjection {
  scoped_run_project(
    event: scoped_run_event(
      entry_file: entry_file,
      module_path: module_path,
      function: function,
      transition: Concluded {
        outcome: TimedOut {
          basis: basis,
          budget: budget,
          elapsed: elapsed
        }
      }
    ),
    addressable: addressable,
    emoji: emoji,
    prior: prior
  )
}

fn scoped_run_routine_measured_without_basis(
  entry_file: NonEmptyStr,
  module_path: NonEmptyStr,
  function: NonEmptyStr,
  elapsed: Millisecond,
  addressable: Bool,
  emoji: Bool,
  prior: DynamicLineState
) -> ScopedRunWriteProjection {
  let event = ObservationEvent {
    subject: scoped_run_subject(entry_file: entry_file, module_path: module_path, function: function),
    transition: Concluded { outcome: Done },
    durations: observation_durations_wall(elapsed: millisecond_to_nanosecond(m: elapsed)),
    rss: MeasuredUnavailable { cause: "scoped run rss is not sampled" as NonEmptyStr }
  }
  scoped_run_project(
    event: event,
    addressable: addressable,
    emoji: emoji,
    prior: prior
  )
}

fn seed_phase_basis(overhead_ms: Nat) -> AttentionBasis {
  AttentionBasis { average: millisecond(count: overhead_ms), maximum: millisecond(count: overhead_ms) }
}

fn seed_phase_subject(phase: NonEmptyStr) -> ObservationSubject {
  ObservationSubject { segments: [ PhaseSegment { name: phase } ] }
}

// A phase Begin is the matched half of observation law 1 for phase-grain subjects. The floor
// prelude historically only printed Concluded (the mark fires when the phase ends); compile-path
// gantt marks already pair .begin/.done, so the seed boundary exposes both arms. Wall at Begin is
// unmeasured by construction — elapsed does not exist yet — and RSS stays on heartbeat/measurement
// (ci_event_line does not project event.rss). The compile-path seed renders through a Rust MIRROR
// of these fns rather than the interpreter: trace_mark runs inside compile itself, and calling back
// into the interpreter to render would recurse. The mirror is proven byte-equal to this oracle by
// the seed RED (same pattern as seed_heartbeat_line / render_heartbeat_line_mirror).

fn phase_begin_line(phase: NonEmptyStr, overhead_ms: Nat, emoji: Bool) -> String {
  let event = ObservationEvent {
    subject: seed_phase_subject(phase: phase),
    transition: Begin,
    durations: observation_durations_wall_unavailable(cause: "begin has no elapsed yet" as NonEmptyStr),
    rss: MeasuredUnavailable { cause: "not sampled at a phase boundary" as NonEmptyStr }
  }
  ci_render_line(
    line: ci_event_line(event: event, basis: seed_phase_basis(overhead_ms: overhead_ms)),
    tier: seed_tier(emoji: emoji)
  )
}

fn phase_concluded_line(phase: NonEmptyStr, elapsed_ms: Nat, overhead_ms: Nat, emoji: Bool) -> String {
  let event = ObservationEvent {
    subject: seed_phase_subject(phase: phase),
    transition: Concluded { outcome: Done },
    durations: observation_durations_wall(elapsed: millisecond_to_nanosecond(m: millisecond(count: elapsed_ms))),
    rss: MeasuredUnavailable { cause: "not sampled at a phase boundary" as NonEmptyStr }
  }
  ci_render_line(
    line: ci_event_line(event: event, basis: seed_phase_basis(overhead_ms: overhead_ms)),
    tier: seed_tier(emoji: emoji)
  )
}

// UNREADABILITY CAUSES, ONE PER SOURCE THE FLOOR READS, so the rendered line names WHICH file did
// not read rather than a uniform sentinel. The seed's mirror carries the same spellings and the
// oracle RED holds them equal. The stall cause covers both its counters at once: the window is a
// pair (major faults, user cpu) over one wall, and a share from half a reading is not a share.
data seed_heartbeat_stat_unreadable_cause: NonEmptyStr = "/proc/self/stat unreadable" as NonEmptyStr
data seed_heartbeat_statm_unreadable_cause: NonEmptyStr = "/proc/self/statm unreadable" as NonEmptyStr
data seed_heartbeat_cgroup_current_unreadable_cause: NonEmptyStr = "memory.current unreadable" as NonEmptyStr
data seed_heartbeat_cgroup_events_unreadable_cause: NonEmptyStr = "memory.events unreadable" as NonEmptyStr
data seed_heartbeat_cgroup_events_local_unreadable_cause: NonEmptyStr = "memory.events.local unreadable" as NonEmptyStr
data seed_heartbeat_vmstat_unreadable_cause: NonEmptyStr = "/proc/vmstat unreadable" as NonEmptyStr
data seed_heartbeat_stall_unreadable_cause: NonEmptyStr = "stall counters unreadable" as NonEmptyStr

data seed_heartbeat_run_id: NonEmptyStr = "required floor" as NonEmptyStr

fn seed_measured_count(value: Nat, available: Bool, cause: NonEmptyStr) -> Measured<Nat> {
  if available { MeasuredValue { value: value } } else { MeasuredUnavailable { cause: cause } }
}

fn seed_measured_bytes(value: ByteSize, available: Bool, cause: NonEmptyStr) -> Measured<ByteSize> {
  if available { MeasuredValue { value: value } } else { MeasuredUnavailable { cause: cause } }
}

// The floor's subject on a beat: the run, and the seam it is in when one is set. An unset seam
// (the beat fired before the runner named its first phase) carries no PhaseSegment rather than a
// fabricated name, so the line reads `still in run required floor` and nothing more.
fn seed_heartbeat_subject(seam: String) -> ObservationSubject {
  ObservationSubject {
    segments: if seam == "" {
      [ RunSegment { id: seed_heartbeat_run_id } ]
    } else {
      [ RunSegment { id: seed_heartbeat_run_id }, PhaseSegment { name: seam as NonEmptyStr } ]
    }
  }
}

// The floor heartbeat's projection, RESTORED 2026-09-11. The heartbeat runs on a detached liveness thread in a memory-constrained context, so the seed renders it through a Rust MIRROR of ci_heartbeat_line (cli_run render_heartbeat_line_mirror) rather than calling the interpreter there — an interpreter render on that thread would build a duplicate module index, consuming the very memory the heartbeat watches (DESIGN section 2), and the thread's whole point is to stay alive when the main interpreter is busy. This fn is the ORACLE that keeps the mirror honest: the seed's Rust test runs this through the interpreter and its mirror on the same samples and asserts byte-equality, so the format authority stays in the one renderer and any drift reds. It WAS unwired: #9228 deleted claim_executor render_heartbeat_line_mirror and the cli_run HeartbeatFeed with the plan/walk surface they lived on, and the one-attempt floor that replaced them emitted a raw [floor-heartbeat] eprintln with no projection behind it (gunbc.observation_emit_census recorded the reversal as a CountedFrontierSite). The interface below is the seed's REAL input space on that floor -- wall since floor start, the seam label, and each /proc and cgroup reading with its own readability -- so the mirror is a complete reflection of this fn over what the seed actually holds, never a fabricated per-entry detail (observation law 2). UNIT-BEARING ARGUMENTS CROSS THE SEAM AS std.measure CARRIERS, not bare integers, on the precedent of ci_batch_summary_text's `work: Nanosecond`: the seed test builds each carrier by calling the `millisecond` / `byte_size` constructor through the interpreter, so a caller handing milliseconds where bytes were meant cannot typecheck (review 63436). Dimensionless counts (faults, events, swap-ins) stay Nat because a count has no unit to carry. The stall window arrives as its wall and two counters and is projected into the refusal authority's own MemoryStallObservation, so rate and share print by the functions the refusal decides on. The two cache counters of that observation are zero here as a TRUE statement about what this window measured -- the heartbeat does not read the typed cache -- not a stand-in for an unread counter.
fn seed_heartbeat_line(
  elapsed: Millisecond,
  seam: String,
  cpu: Millisecond,
  major_faults: Nat,
  stat_available: Bool,
  rss: ByteSize,
  rss_available: Bool,
  cgroup_charge: ByteSize,
  cgroup_charge_available: Bool,
  cgroup_high_events: Nat,
  cgroup_max_events: Nat,
  cgroup_events_available: Bool,
  cgroup_local_high_events: Nat,
  cgroup_events_local_available: Bool,
  host_swap_in: Nat,
  host_major_faults: Nat,
  vmstat_available: Bool,
  stall_window: Millisecond,
  stall_major_faults: Nat,
  stall_user_cpu: Millisecond,
  stall_available: Bool,
  emoji: Bool
) -> String {
  ci_render_line(
    line: ci_heartbeat_line(sample: HeartbeatSample {
      elapsed: elapsed,
      active: seed_heartbeat_subject(seam: seam),
      cpu: if stat_available { MeasuredValue { value: cpu } } else { MeasuredUnavailable { cause: seed_heartbeat_stat_unreadable_cause } },
      major_faults: seed_measured_count(value: major_faults, available: stat_available, cause: seed_heartbeat_stat_unreadable_cause),
      rss: seed_measured_bytes(value: rss, available: rss_available, cause: seed_heartbeat_statm_unreadable_cause),
      cgroup_charge: seed_measured_bytes(value: cgroup_charge, available: cgroup_charge_available, cause: seed_heartbeat_cgroup_current_unreadable_cause),
      cgroup_high_events: seed_measured_count(value: cgroup_high_events, available: cgroup_events_available, cause: seed_heartbeat_cgroup_events_unreadable_cause),
      cgroup_max_events: seed_measured_count(value: cgroup_max_events, available: cgroup_events_available, cause: seed_heartbeat_cgroup_events_unreadable_cause),
      cgroup_local_high_events: seed_measured_count(value: cgroup_local_high_events, available: cgroup_events_local_available, cause: seed_heartbeat_cgroup_events_local_unreadable_cause),
      host_swap_in: seed_measured_count(value: host_swap_in, available: vmstat_available, cause: seed_heartbeat_vmstat_unreadable_cause),
      host_major_faults: seed_measured_count(value: host_major_faults, available: vmstat_available, cause: seed_heartbeat_vmstat_unreadable_cause),
      stall: if stall_available && millisecond_count(m: stall_window) > 0 {
        MeasuredValue { value: MemoryStallObservation {
          window_wall: stall_window,
          major_faults_in_window: stall_major_faults,
          self_user_cpu_in_window: stall_user_cpu,
          cache_evictions_in_window: 0,
          cache_readmissions_in_window: 0
        } }
      } else {
        MeasuredUnavailable { cause: seed_heartbeat_stall_unreadable_cause }
      }
    }),
    tier: seed_tier(emoji: emoji)
  )
}

// Governor hold projection (wiring flip): HoldReason is already lockstep with SchedulerHold; the emit side now projects through ci_hold_cause_text rather than a bespoke [governor] printer. Attention is Anomaly (a hold is never Ambient). The seed renders through a Rust MIRROR in memory_governor — the governor is host physics without a source-root resolve context, same class as the heartbeat mirror. Oracle RED: seed_psi_hold_line / seed_high_water_hold_line byte-equal to render_governor_hold_line_mirror.
fn seed_governor_hold_line(hold: SchedulerHold, emoji: Bool) -> String {
  ci_render_line(
    line: RenderedLine {
      glyph: StatusBlocked,
      text: ci_hold_cause_text(hold: hold),
      attention: Anomaly
    },
    tier: seed_tier(emoji: emoji)
  )
}

fn seed_psi_hold_line(avg10_bp: Nat, emoji: Bool) -> String {
  seed_governor_hold_line(
    hold: PsiPressure { avg10: basis_point(count: avg10_bp) },
    emoji: emoji
  )
}

fn seed_high_water_hold_line(current_bytes: Nat, high_water_bytes: Nat, emoji: Bool) -> String {
  seed_governor_hold_line(
    hold: CurrentHighWater {
      current: byte_size(current_bytes),
      high_water: byte_size(high_water_bytes)
    },
    emoji: emoji
  )
}

// Per-module typecheck attribution (wiring flip): a Concluded event on
// ModuleSegment+PhaseSegment{typecheck} carrying the measured wall, rendered by ci_event_line —
// written as the module concludes rather than batched to walk end. The 2s threshold that kept the
// floor log quiet is preserved at the emit site (pathology lane only). Hot-path mirror in cli_run
// (interpreter render per module under resolve would dominate the wall); oracle RED keeps the
// mirror byte-equal to this seed.

fn seed_typecheck_subject(module_path: NonEmptyStr) -> ObservationSubject {
  ObservationSubject {
    segments: [
      ModuleSegment { module_path: module_path },
      PhaseSegment { name: "typecheck" as NonEmptyStr }
    ]
  }
}

fn typecheck_begin_line(module_path: NonEmptyStr, overhead_ms: Nat, emoji: Bool) -> String {
  let event = ObservationEvent {
    subject: seed_typecheck_subject(module_path: module_path),
    transition: Begin,
    durations: observation_durations_wall_unavailable(cause: "begin has no elapsed yet" as NonEmptyStr),
    rss: MeasuredUnavailable { cause: "not sampled at a typecheck boundary" as NonEmptyStr }
  }
  ci_render_line(
    line: ci_event_line(event: event, basis: seed_phase_basis(overhead_ms: overhead_ms)),
    tier: seed_tier(emoji: emoji)
  )
}

fn typecheck_concluded_line(module_path: NonEmptyStr, elapsed_ms: Nat, overhead_ms: Nat, emoji: Bool) -> String {
  let event = ObservationEvent {
    subject: seed_typecheck_subject(module_path: module_path),
    transition: Concluded { outcome: Done },
    durations: observation_durations_wall(elapsed: millisecond_to_nanosecond(m: millisecond(count: elapsed_ms))),
    rss: MeasuredUnavailable { cause: "not sampled at a typecheck boundary" as NonEmptyStr }
  }
  ci_render_line(
    line: ci_event_line(event: event, basis: seed_phase_basis(overhead_ms: overhead_ms)),
    tier: seed_tier(emoji: emoji)
  )
}

data seed_measurement_unreadable_cause: NonEmptyStr = "no /proc/self/status" as NonEmptyStr

// Measurement-feed projection (wiring flip): peak-RSS samples become ci_measurement_rss_line —
// identity-first label, human GiB, MeasuredUnavailable names its cause. Hot-path mirrors in
// claim_executor / claim_batch (same class as heartbeat). The typed receipt consumers are
// unchanged; only the log dialect migrates.

fn seed_peak_rss_line(label: NonEmptyStr, rss_bytes: Nat, rss_available: Bool, emoji: Bool) -> String {
  ci_render_line(
    line: ci_measurement_rss_line(
      label: label,
      rss: if rss_available {
        MeasuredValue { value: byte_size(rss_bytes) }
      } else {
        MeasuredUnavailable { cause: seed_measurement_unreadable_cause }
      }
    ),
    tier: seed_tier(emoji: emoji)
  )
}

// Shell host-effect projection (operator live-log 2026-07-25 acceptance): subjects are NAMED
// INTENTS — the typed service.op key (`git.Inspect.HeadCommit`, `shell.Env.Get`), never raw `$
// argv`. Argv is demoted to Failed.error (`$ <argv> (exit=N)`, whitespace-collapsed) and the
// Verbose/title channel. Routine Begin/Concluded{Done} are Ambient (ShellTrace-gated; Suppressed at
// Normal so scaffolding collapses); failing Concluded{Failed} is Anomaly (OutsideGroup by law 4),
// gated by divergence disposition alone — channel Suppressed must never silence a failure. Hot-path
// mirrors in v1_interpreter; oracle RED keeps them honest.

fn seed_shell_subject(intent: NonEmptyStr) -> ObservationSubject {
  ObservationSubject { segments: [ PhaseSegment { name: intent } ] }
}

fn shell_effect_begin_line(intent: NonEmptyStr, overhead_ms: Nat, emoji: Bool) -> String {
  let event = ObservationEvent {
    subject: seed_shell_subject(intent: intent),
    transition: Begin,
    durations: observation_durations_wall_unavailable(cause: "begin has no elapsed yet" as NonEmptyStr),
    rss: MeasuredUnavailable { cause: "not sampled at shell spawn" as NonEmptyStr }
  }
  ci_render_line(
    line: ci_event_line(event: event, basis: seed_phase_basis(overhead_ms: overhead_ms)),
    tier: seed_tier(emoji: emoji)
  )
}

fn shell_effect_done_line(intent: NonEmptyStr, elapsed_ms: Nat, overhead_ms: Nat, emoji: Bool) -> String {
  let event = ObservationEvent {
    subject: seed_shell_subject(intent: intent),
    transition: Concluded { outcome: Done },
    durations: observation_durations_wall(elapsed: millisecond_to_nanosecond(m: millisecond(count: elapsed_ms))),
    rss: MeasuredUnavailable { cause: "not sampled at shell completion" as NonEmptyStr }
  }
  ci_render_line(
    line: ci_event_line(event: event, basis: seed_phase_basis(overhead_ms: overhead_ms)),
    tier: seed_tier(emoji: emoji)
  )
}

fn shell_effect_failed_line(
  intent: NonEmptyStr,
  argv_collapsed: NonEmptyStr,
  exit_code: Nat,
  elapsed_ms: Nat,
  overhead_ms: Nat,
  emoji: Bool
) -> String {
  let error = concat(
    "$ ",
    concat(argv_collapsed, concat(" (exit=", concat(to_string(exit_code), ")")))
  ) as NonEmptyStr
  let event = ObservationEvent {
    subject: seed_shell_subject(intent: intent),
    transition: Concluded {
      outcome: Failed { error: error, output: "" }
    },
    durations: observation_durations_wall(elapsed: millisecond_to_nanosecond(m: millisecond(count: elapsed_ms))),
    rss: MeasuredUnavailable { cause: "not sampled at shell completion" as NonEmptyStr }
  }
  ci_render_line(
    line: ci_event_line(event: event, basis: seed_phase_basis(overhead_ms: overhead_ms)),
    tier: seed_tier(emoji: emoji)
  )
}

data observation_seed_render_disposition: Disposition = Terminal {
  reason: "The seed to .dag render boundary is Terminal, not a scaffold: a boundary the seed calls across to keep the format single-authority is the mechanism, not an interim stand-in. What dissolves is each raw eprintln the seed replaces with a call here — counted by gunbc.observation_emit_census — and, further out, the seed itself as v2 realizes the witnesses natively; neither changes what this module models, which is that a seed occurrence is an observation event projected by the one renderer."
}
