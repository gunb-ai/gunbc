module gunbc.flex_vast_credential

import std.types { NonEmptyStr }
import extdeps.cloud.gcp.secret_ref { SecretRef }
import product.host_identity { HostIdentity }
import gunbc.fleet.fleet_host_identity { operator_host_srv1 }
import gunbc.secret_provision { fleet_secret_ref, secret_ref_pin_version }

// THE FLEX POOL'S VAST.AI API KEY, read and write on the operator's Vast account. The operator created
// it in gunbai-secrets for the flex lane (product.fabric.flex_vast_shadow), which reads the host copy
// on srv1, where the flex loop runs as the operator account. The key is a credential and nothing else:
// no directory the tool writes, no rotation the tool performs, so the store stays the authority.
//
// The version is the latest alias, not an exact number, as for the OpenRouter key: replacing the key
// is the operator adding a version, and the custody read records the version it was served
// (extdeps.cloud.gcp.secret_ref resolve_returned_version), so the placed copy is attributable.
data flex_vast_api_key_secret_ref: SecretRef = secret_ref_pin_version(
  ref: fleet_secret_ref(secret_id: "flex-vast-api-key"),
  version: "latest",
)

data flex_vast_api_key_custody_host: HostIdentity = operator_host_srv1

data flex_vast_api_key_host_path: NonEmptyStr = "/etc/gunbc-flex/vast-api-key" as NonEmptyStr
