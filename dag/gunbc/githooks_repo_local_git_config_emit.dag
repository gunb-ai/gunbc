module gunbc.githooks_repo_local_git_config_emit

import extdeps.git { git_shell_join_argv }
import gunbc.repo_local_git_config {
  RepoLocalGitConfigBinding,
  desired_repo_local_git_config_bindings,
  reconcile_install_argv,
}

data githooks_repo_local_git_config_emit_note: String = "Self-healing carrier for repository-local Git integration bindings (generated-file conflict policy charter, lane 2, review 46518 / crisp-bat-830). Generated pre-commit and pre-push hooks run idempotent local binding installs derived from reconcile_install_argv — the same cited argv shapes the actuator uses — on every hook invocation once core.hooksPath is set. The one-time manual seed remains only core.hooksPath itself (DESIGN Building & checks); these hooks then converge merge.generated-artifact.driver and re-assert hooksPath. Clones that never set hooksPath degrade to vanilla git text-merge for generated-artifact paths (safe degradation: drift gate still guards at CI); the merge-driver binding is not self-healed until hooks run."

data githooks_repo_local_git_config_emit_dissolution_trigger: String = "🟡 dissolve-on: githooks_repo_local_git_config_emit_shell — hook-emitted git config argv lines are the foreign-executor interim for a runtime-absent site; DISSOLVES WHEN shell→intent bash grammar rows read forward emit the converge block from the same reconcile_install_argv authority without concat-built medium strings (DESIGN §4 one-grammar-both-directions; githooks_pre_push_emit medium disposition family)."

fn emit_install_binding_line(binding: RepoLocalGitConfigBinding) -> String {
  concat(
    concat("# repo-local git config: ", binding.key),
    concat("\n", concat(git_shell_join_argv(argv: reconcile_install_argv(binding: binding)), "\n"))
  )
}

fn emit_repo_local_git_config_converge_shell() -> String {
  concat(
    "# Idempotent repository-local Git integration bindings (gunbc.repo_local_git_config).\n",
    fold(
      desired_repo_local_git_config_bindings(),
      init: "",
      f: fn(acc, binding) { concat(acc, emit_install_binding_line(binding: binding)) }
    )
  )
}
