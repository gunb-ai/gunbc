module gunbc.command_runner



data command_runner_scaffold: std.disposition.Disposition = std.disposition.Scaffold {
  dissolves_to: RealizationDispatch,
  bind: std.decl_ref.DeclarationRef {
    module_path: "gunbc.command_runner",
    decl_name: "command_runner_dissolution_trigger",
    field: WholeDeclaration,
  }
}

data command_runner_dissolution_trigger: std.dissolution.DissolutionCondition = unbound_dissolution(description: "🟡 dissolve-on: run_shell_command — generic ArgvCommand runner routes the typed extdeps.exec.command shape through shell.Exec.Run via the shell_bash_runner heredoc transport; DISSOLVES WHEN host_effect_apply binds ArgvCommand execution as a typed transport handler and dag/gunbc/command_runner.dag retires its shell_exec_via_bash glue")

func run_shell_command(command: extdeps.exec.command.ArgvCommand, transport: extdeps.exec.command.CommandTransport) -> std.process.ProcessExit
  uses net: std.cache_interface.Network
{
  let rendered = shell_command_render(command: command_over_transport(command: command, transport: transport))
  let run = shell.Exec.Run(
    script: retained_runtime(
      body: shell_exec_via_bash(body: rendered),
      reason: "generic ArgvCommand runner heredoc transport, pending the typed host_effect_apply argv handler" as std.types.NonEmptyStr,
    )
  )
  if run.success {
    ExitSuccess
  } else {
    exit_failure(reason: concat("command failed: ", run.stderr))
  }
}

// Capture variant (CONVERGE acceptance, host-key enrollment): same admitted transport,
// but the caller receives the process observation instead of a collapsed ProcessExit —
// for wet observations whose PRODUCT is the stdout (ssh-keyscan, ssh-keygen -lf).
// Success/stdout/stderr travel together so a refusal cannot be read as empty output.
type ShellCaptureResult {
  success: Bool
  stdout: String
  stderr: String
}

func run_shell_command_capture(command: extdeps.exec.command.ArgvCommand, transport: extdeps.exec.command.CommandTransport) -> ShellCaptureResult
  uses net: std.cache_interface.Network
{
  let rendered = shell_command_render(command: command_over_transport(command: command, transport: transport))
  let run = shell.Exec.Run(
    script: retained_runtime(
      body: shell_exec_via_bash(body: rendered),
      reason: "generic ArgvCommand capture runner heredoc transport, pending the typed host_effect_apply argv handler" as std.types.NonEmptyStr,
    )
  )
  ShellCaptureResult { success: run.success, stdout: run.stdout, stderr: run.stderr }
}

// Receipt owner probe — admitted under command_runner_scaffold until
// extdeps.filesystem.filesystem_io carries typed owner observation.
fn stat_owner_name_capture(path: String) -> ShellCaptureResult {
  run_shell_command_capture(
    command: extdeps.exec.command.ArgvCommand { argv: ["stat", "-c", "%U", path] },
    transport: LocalExec,
  )
}

func run_shell_commands(commands: List<extdeps.exec.command.ArgvCommand>, transport: extdeps.exec.command.CommandTransport) -> std.process.ProcessExit
  uses net: std.cache_interface.Network
{
  fold(
    commands,
    init: ExitSuccess,
    f: (acc, c) => match acc {
      ExitFailure { code: _, reason: _ } => acc
      ExitSuccess => run_shell_command(command: c, transport: transport)
    }
  )
}
