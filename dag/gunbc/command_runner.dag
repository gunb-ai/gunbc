module gunbc.command_runner

data command_runner_scaffold: std.disposition.Disposition = std.disposition.Scaffold {
  dissolves_to: std.disposition.RealizationDispatch,
  bind: std.decl_ref.DeclarationRef {    module_path: "gunbc.command_runner",
    decl_name: "command_runner_dissolution_trigger",
    field: std.decl_ref.WholeDeclaration,
  }
}

data command_runner_dissolution_trigger: std.dissolution.DissolutionCondition = std.dissolution.unbound_dissolution(description: "🟡 dissolve-on: the SSH arm of run_shell_command / run_shell_command_capture. THE LOCAL ARM IS DONE -- it routes straight at shell.Exec.RunArgv, constructs no TransportScript, and reaches no shell. WORDING CORRECTED, and the correction is the point: this row previously named host_effect_apply binding ArgvCommand as a typed transport handler. host_effect_apply DOES exist -- gunbc.host_effect_realize declares host_effect_apply and host_effect_apply_gated, and they are production, not test scaffolding. What it does not do is reach an ArgvCommand: that module contains ZERO occurrences of the type and does not appear among its consumers at all. So the binding this trigger named was never built in the sense that matters -- host_effect_apply dispatches effects but is not, and has never been, a route from an ArgvCommand to a process. An earlier revision of this row said host_effect_apply did not exist, which is false and checkable in one grep; the correction is recorded rather than quietly overwritten because a replacement trigger carrying a false premise makes the next author re-derive the whole question, which is exactly the cost the original trigger imposed. Measured before rewriting: command_runner is the ONLY module that turns an ArgvCommand into a local process. The other ArgvCommand consumers reach shell_command_render, which serializes argv into TEXT for emission (githooks) or for the SSH leg, which is a different destination rather than a second local-exec path. DISSOLVES WHEN the SSH arm stops rendering argv to a string -- which needs the nested command-string target RFC 4254 actually requires, owned by another lane -- at which point shell_exec_via_bash and retained_runtime leave this module entirely.")

// WHAT GUARDS THIS, AND WHAT DOES NOT -- read before assuming the property below is enforced.
//
// The property "the local path reaches no shell" is established by execution, wet, against a real
// process: test/manual/command_runner_local_argv_receipt_test.dag runs printf against an operand
// containing a space and asserts the one-argument reading arrives while the shell-split reading
// does not. It passes. It is also EXCLUDED FROM THE FLOOR, so CI does not run it, and after this
// lands someone reintroducing a render-and-bash hop on this arm gets NO SIGNAL from CI.
//
// The exclusion is structural rather than convenient: hermetic evaluation replays an operation's
// declared mock_response and never constructs an argv, so how the words reach the process is not
// observable hermetically at all. A hermetic version of that receipt could only assert the mock,
// which is specification-without-execution -- it would look like coverage while proving nothing.
//
// RUNG: mitigatable. The invalid state (argv re-split by a shell) is writable, and the mechanism
// that detects it does not execute in CI. NEXT-RUNG TRIGGER: a wet lane that executes
// floor-excluded receipts, at which point this row's evidence enrolls and the class climbs to
// mechanically preventable. Stated here rather than left to be inferred from a passing receipt,
// because a green test that nothing runs is exactly the inert evidence DESIGN calls a lie.
data command_over_transport_refusal_reason_note: String = "Renders RemoteExecCommandRefusalCause (gunbc.remote_shell_command) into a diagnostic String -- the only refusal this generic runner can hit today is RemoteExecInterpretationUnknown, since every SshExec constructed in-tree names a determined interpretation (openssh_login_shell_interpretation / openbmc_dropbear_interpretation); the cause stays a match over the full type rather than a partial one so a newly added cause fails to compile here instead of falling through silently (DESIGN 4b: no untracked stall)."

fn command_over_transport_refusal_reason(cause: gunbc.remote_shell_command.RemoteExecCommandRefusalCause) -> String {
  match cause {
    RemoteExecInterpretationUnknown =>
      "the SSH target's RemoteExecCommandInterpretation is Unknown -- refusing rather than assuming a POSIX shell on the far side"
    SimpleCommandArgvRefused { cause: _ } =>
      "the inner command's argv was empty"
  }
}

// THE LOCAL ARM NO LONGER ROUND-TRIPS ARGV THROUGH A STRING.
//
// What it used to do, and why none of it was necessary: render the argv to quoted text, wrap the
// text in a bash heredoc, hand that to a shell, and let the shell split it back into an argument
// vector -- to reach a seed that ends in Command::new(argv[0]).args(argv[1..]) regardless. Every
// step in that chain existed only to undo the step before it. On LocalExec command_over_transport
// is the IDENTITY, so the render had nothing to transform either.
//
// The words now reach the process as words. Nothing is quoted, joined, split, or re-parsed, which
// is the whole point: an argv is a serialization, and a serialization that is immediately
// deserialized by a different grammar is where argument boundaries get lost.
//
// EMPTY ARGV REFUSES rather than defaulting. A command with no argv has no program, and there is
// no plausible process to run -- inventing one is exactly the fabricated output DESIGN forbids.
//
// THE SSH ARM IS UNTOUCHED, deliberately and not by oversight. Its prefix-append shape is wrong in
// kind -- RFC 4254 carries one string, so the inner command is a nested serialization target
// rather than a concatenation -- and that target is being built in another lane. Two sessions
// editing one contested branch is worse than either fix. Measured before leaving it: every one of
// the 22 live call sites of this module's entry points passes LocalExec, so this arm currently
// carries no traffic through here at all.
func run_shell_command(command: extdeps.exec.command.ArgvCommand, transport: extdeps.exec.command.CommandTransport) -> std.process.ProcessExit
  uses net: std.resources.Network
{
  match transport {
    LocalExec =>
      match v2.std.algebra.list_head(xs: command.argv) {
        HeadAbsent =>
          std.process.exit_failure(reason: "empty argv: a command with no words names no program to execute")
        HeadFound { value: program } => {
          let run = shell.Exec.RunArgv(
            program: program as std.types.NonEmptyStr,
            arguments: v2.std.compilers.cli_surface.process_argv_expansion(
              surface: v2.std.compilers.cli_surface.cli_surface_of_literal_words(words: argv_operands(command: command))
            ),
          )
          if extdeps.shell.exec.process_exit_is_admitted(policy: extdeps.shell.exec.ExitZeroSucceeds, exit_code: run.exit_code) {
            std.process.ExitSuccess
          } else {
            std.process.exit_failure(reason: concat("command failed: ", run.stderr))
          }
        }
      }
    SshExec { ssh_target: _ } =>
      match extdeps.exec.command.command_over_transport(command: command, transport: transport) {
        CommandOverTransportRefused { cause: c } =>
          std.process.exit_failure(reason: concat("command_over_transport refused: ", command_over_transport_refusal_reason(cause: c)))
        CommandOverTransportBuilt { command: over } => {
          let rendered = extdeps.exec.command.shell_command_render(command: over)
          let run = shell.Exec.Run(
            script: gunbc.retained_shell_script.retained_runtime(
              body: gunbc.shell_bash_runner.shell_exec_via_bash(body: rendered),
              reason: "SSH arm only: nested command-string target is owned by another lane; the local arm no longer routes here" as std.types.NonEmptyStr,
            )
          )
          if run.success {
            std.process.ExitSuccess
          } else {
            std.process.exit_failure(reason: concat("command failed: ", run.stderr))
          }
        }
      }
  }
}

// The operands are everything after the program. A missing tail is the one-word command, whose
// operand list is empty -- not an error, and not the same state as an empty argv.
fn argv_operands(command: extdeps.exec.command.ArgvCommand) -> std.types.List<String> {
  match v2.std.algebra.list_tail(xs: command.argv) {
    TailAbsent => std.algebra.Empty
    TailFound { tail: rest } => rest
  }
}

// Capture variant (CONVERGE acceptance, host-key enrollment): same admitted transport,
// but the caller receives the process observation instead of a collapsed ProcessExit —
// for wet observations whose PRODUCT is the stdout (ssh-keyscan, ssh-keygen -lf).
// Success/stdout/stderr travel together so a refusal cannot be read as empty output.

// SPAWN FAILURE IS ALREADY FAIL-CLOSED, and this is the transport fact that decides what the
// capture surface can and cannot say. Measured wet against the real local path: a command whose
// program does not exist does NOT come back as a failed result. It REFUSES the evaluation with a
// typed diagnostic naming the program and the OS error --
//   failed to execute 'no_such_binary': No such file or directory (os error 2)
// -- so no result record is produced at all.
//
// TWO CONSEQUENCES, and the second is the useful one.
//
// There is no unspawnable-versus-ran distinction for this surface to model. A fourth "not spawned"
// variant would be an uninhabited arm that every consumer must handle and none can ever reach, so
// it is deliberately absent.
//
// AND A CALLER CANNOT PROBE FOR A BINARY'S EXISTENCE BY TRYING TO RUN IT. The attempt does not
// return an answer; it stops the line. Presence must be asked of something that exists -- spawn a
// shell and let `command -v` report -- rather than spawning the candidate and interpreting the
// wreckage. That is why a separate presence probe has to exist, and it is a boundary fact about
// the transport rather than a limitation of this module.
//
// WHAT THE CAPTURE SURFACE RETURNS, and why it is a coproduct rather than a record.
// ShellCaptureResult carried success: Bool beside stdout: String, which made two states that a
// caller cannot tell apart: a program that RAN AND FAILED printing nothing, and one that RAN AND
// SUCCEEDED printing nothing. Both are stdout == "". Correlating them was the caller's duty, and
// measured across the live sites, EIGHT of them did not perform it -- they read stdout and acted
// on the empty string as though it were an answer. That is the empty-observation narrow: not a
// widen, its mirror, and it was live in production at eight sites.
//
// The coproduct makes the failure unignorable: output is reachable ONLY through the variant that
// carries it, so a caller cannot read text without having confronted the arm where there is none.
func run_shell_command_capture(command: extdeps.exec.command.ArgvCommand, transport: extdeps.exec.command.CommandTransport) -> extdeps.shell.exec.ProcessOutcome
  uses net: std.resources.Network
{
  match transport {
    LocalExec =>
      match v2.std.algebra.list_head(xs: command.argv) {
        HeadAbsent =>
          extdeps.shell.exec.ProcessRefused {
            exit_code: 0 - 1,
            stderr: "empty argv: a command with no words names no program to execute",
          }
        HeadFound { value: program } => {
          let run = shell.Exec.RunArgv(
            program: program as std.types.NonEmptyStr,
            arguments: v2.std.compilers.cli_surface.process_argv_expansion(
              surface: v2.std.compilers.cli_surface.cli_surface_of_literal_words(words: argv_operands(command: command))
            ),
          )
          extdeps.shell.exec.classify_process_observation(
            policy: extdeps.shell.exec.ExitZeroSucceeds,
            observation: extdeps.shell.exec.process_observation(
              exit_code: run.exit_code,
              stdout: run.stdout,
              stderr: run.stderr,
            ),
          )
        }
      }
    SshExec { ssh_target: _ } =>
      match extdeps.exec.command.command_over_transport(command: command, transport: transport) {
        CommandOverTransportRefused { cause: c } =>
          extdeps.shell.exec.ProcessRefused {
            exit_code: 0 - 1,
            stderr: concat("command_over_transport refused: ", command_over_transport_refusal_reason(cause: c)),
          }
        CommandOverTransportBuilt { command: over } => {
          let rendered = extdeps.exec.command.shell_command_render(command: over)
          let run = shell.Exec.Run(
            script: gunbc.retained_shell_script.retained_runtime(
              body: gunbc.shell_bash_runner.shell_exec_via_bash(body: rendered),
              reason: "SSH arm only: nested command-string target is owned by another lane; the local arm no longer routes here" as std.types.NonEmptyStr,
            )
          )
          extdeps.shell.exec.classify_process_observation(
            policy: extdeps.shell.exec.ExitZeroSucceeds,
            observation: extdeps.shell.exec.process_observation(
              exit_code: run.exit_code,
              stdout: run.stdout,
              stderr: run.stderr,
            ),
          )
        }
      }
  }
}

// Did the process do its job? Callers whose product is the EXIT STATUS rather than the output ask
// this instead of matching all three arms -- `test -f` has no stdout anyone wants, and forcing it
// through an output-bearing variant would add a field it cannot answer. This is not a flattening
// helper for output-consuming callers: it deliberately cannot reach the text.
fn process_outcome_admitted(outcome: extdeps.shell.exec.ProcessOutcome) -> Bool {
  match outcome {
    ProcessOutputPresent { text: _ } => true
    ProcessOutputAbsent => true
    ProcessRefused { exit_code: _, stderr: _ } => false
  }
}

// A receipt line's text, and it is NOT a flattening back to the conflated shape. The three arms
// render to three DISTINGUISHABLE strings: a refusal can never be mistaken for empty output, which
// is the exact property the old record lacked. Use it only where the value is being written into
// human-readable text; a caller that uses the value AS DATA -- a path, a hostname -- must match the
// arms itself, because "(refused: ...)" is a fine thing to print and a catastrophic thing to open.
fn process_outcome_receipt_text(outcome: extdeps.shell.exec.ProcessOutcome) -> String {
  match outcome {
    ProcessOutputPresent { text: t } => trim(s: t)
    ProcessOutputAbsent => "(no output)"
    ProcessRefused { exit_code: _, stderr: e } => join(["(refused: ", trim(s: e), ")"], "")  }
}

// gunbc.design.interaction.Receipt owner probe — admitted under command_runner_scaffold until
// extdeps.filesystem.filesystem_io carries typed owner observation.
fn stat_owner_name_capture(path: String) -> extdeps.shell.exec.ProcessOutcome {
  run_shell_command_capture(
    command: extdeps.exec.command.ArgvCommand { argv: ["stat", "-c", "%U", path] },
    transport: extdeps.exec.command.LocalExec,
  )
}

func run_shell_commands(commands: std.types.List<extdeps.exec.command.ArgvCommand>, transport: extdeps.exec.command.CommandTransport) -> std.process.ProcessExit
  uses net: std.resources.Network
{
  fold(
    commands,
    init: std.process.ExitSuccess,
    f: (acc, c) => match acc {
      ExitFailure { code: _, reason: _ } => acc
      ExitSuccess => run_shell_command(command: c, transport: transport)
    }
  )
}
