module gunbc.command_runner
import std.optional { Absent, Optional, Present }


import std.dissolution { DissolutionCondition, dissolution_description, unbound_dissolution }

import std.types { List, String, NonEmptyStr, Bool }
import std.process { ProcessExit, ExitSuccess, ExitFailure, exit_failure }
import extdeps.exec.command {
  ArgvCommand,
  CommandTransport,
  LocalExec,
  command_over_transport,
  CommandOverTransportBuilt,
  CommandOverTransportRefused,
}
import gunbc.remote_shell_command {
  RemoteExecCommandRefusalCause,
  RemoteExecInterpretationUnknown,
  SimpleCommandArgvRefused,
}
import extdeps.shell
import extdeps.transports.shell { ShellExited, ShellSpawnRefused }
import extdeps.tools.stat { stat_owner_user_name_command }
import std.algebra { Empty, trim }
import v2.std.compilers.cli_surface { cli_surface_of_literal_words, process_argv_expansion }
import extdeps.shell.exec {
  ExitZeroSucceeds, process_exit_is_admitted, ProcessExitPolicy,
  ProcessOutcome, ProcessOutputPresent, ProcessOutputAbsent, ProcessRefused,
  process_observation, classify_process_observation, ProcessRunOutcome, ProcessRan, ProcessNotSpawned,
  ProcessCaptureOutcome, ProcessCaptured, ProcessCaptureNotSpawned,
}
import extdeps.git { is_git_program }
import gunbc.git_argv_route_wall {
  GitWorkdirFreeSpawnAdmitted, GitWorkdirFreeSpawnRefused, spawn_git_argv_workdir_free,
}
import std.disposition { Disposition, Scaffold, RealizationDispatch }
import std.decl_ref { DeclarationRef, WholeDeclaration }

data command_runner_scaffold: Disposition = Scaffold {
  dissolves_to: RealizationDispatch,
  bind: DeclarationRef {
    module_path: "gunbc.command_runner",
    decl_name: "command_runner_dissolution_trigger",
    field: WholeDeclaration,
  }
}

data command_runner_dissolution_trigger: DissolutionCondition = unbound_dissolution(description: "🟡 dissolve-on: run_shell_command / run_shell_command_capture -- BOTH ARMS ARE NOW DONE, not just the local one. CORRECTED (this row previously said only the local arm routed straight at shell.Exec.RunArgv and that the SSH arm's nested command-string target was owned by another lane; that target landed in extdeps.exec.command command_over_transport (RFC 4254 fold, cited IEEE 1003.1-2017 section 2.2.2), which makes SshExec produce a plain, directly-executable outer ArgvCommand exactly as LocalExec's identity arm always did). With both arms yielding one plain ArgvCommand, re-deciding transport at this run site was re-answering a question command_over_transport already answered (gunbc.design_argument::single_authority: dispatch belongs at one seam). The per-transport match is deleted; both run_shell_command and run_shell_command_capture ask command_over_transport once, then hand the resulting argv straight to shell.Exec.RunArgv -- no TransportScript, no shell, no shell_command_render/shell_exec_via_bash/retained_runtime hop, for either transport. Measured before rewriting: command_runner remains the ONLY module that turns an ArgvCommand into a local process; the other ArgvCommand consumers reach shell_command_render for TEXT emission (githooks), a different destination. DISSOLVES WHEN host_effect_apply binds ArgvCommand execution as a typed transport handler and this module retires run_shell_command / run_shell_command_capture in its favor -- host_effect_apply exists (gunbc.host.host_effect_realize) but reaches zero ArgvCommand occurrences today, so that binding is still unbuilt.")

// RUNG: mitigatable. ssh overloads exit code 255 for its own transport failures (unreachable
// host, auth failure, connection reset), which classify_process_observation (extdeps.shell.exec)
// cannot distinguish by exit code alone from a remote command that legitimately exits 255 on its
// own terms -- both fold into one ProcessRefused { exit_code: 255, .. }. This collapse makes that
// the direct, un-mediated SshExec path (no intervening bash heredoc hop remains to obscure it);
// it does not introduce the collision, which was already latent in classify_process_observation.
// Harm is contained -- ProcessRefused is a typed, located refusal either way, never a silent wrong
// answer -- so the class does not fall below the floor; it simply cannot yet tell the two causes
// apart. ACCEPTED, NOT FIXED: disambiguating via ssh's stderr text is rejected, not deferred --
// stderr is prose from an external process, and matching on it is exactly the heuristic
// gunbc.design_argument::closed_grounded_substrate/5 rules out where a richer source exists in principle but is unbuilt.
data ssh_exit_255_conflation_dissolution: DissolutionCondition = unbound_dissolution(description: "🟡 dissolve-on: run_shell_command_capture over SshExec -- transport is KNOWN at command_over_transport's call site, so an SshExec-transported ProcessRefused { exit_code: 255 } is distinguishable IN PRINCIPLE from a LocalExec one, and wants its own typed ProcessOutcome variant (a policy parallel to ExitZeroSucceeds) rather than sharing ProcessRefused with every other nonzero exit. The richer source is in-band remote status -- the remote side reporting its own exit through stdout instead of this caller trusting ssh's own process exit code -- not stderr-sniffing, which stays rejected as a heuristic. NOT BUILT HERE: this row names the trigger, it does not build the variant. DISSOLVES WHEN a real caller of run_shell_command_capture retries on SshExec -- retrying an unreachable host and retrying a command that actually ran and exited 255 are opposite, non-idempotent-risk-bearing decisions, so building the structural arm before a consumer exists to prove the distinction against would be speculative modeling, not grounded modeling (gunbc.design_argument::closed_grounded_substrate: a heuristic is never necessary in a closed system, but neither is a structural arm with nothing to hold it accountable).")

// WHAT GUARDS THIS, AND WHAT DOES NOT -- read before assuming the property below is enforced.
//
// The property "the local path reaches no shell" is established by execution, wet, against a real
// process: test/manual/command_runner_local_argv_receipt.dag runs printf against an operand
// containing a space and asserts the one-argument reading arrives while the shell-split reading
// does not. It passes. It is also EXCLUDED FROM THE FLOOR, so CI does not run it, and after this
// lands someone reintroducing a render-and-bash hop on this arm gets NO SIGNAL from CI.
//
// The exclusion is structural rather than convenient: hermetic evaluation replays an operation's
// declared mock_response and never constructs an argv, so how the words reach the process is not
// observable hermetically at all. A hermetic version of that receipt could only assert the mock,
// which is specification-without-execution -- it would look like coverage while proving nothing.
//
// RUNG: mitigatable. The invalid state (argv re-split by a shell) is writable, and the mechanism
// that detects it does not execute in CI. NEXT-RUNG TRIGGER: a wet lane that executes
// floor-excluded receipts, at which point this row's evidence enrolls and the class climbs to
// mechanically preventable. Stated here rather than left to be inferred from a passing receipt,
// because a green test that nothing runs is exactly the inert evidence DESIGN calls a lie.

// Renders RemoteExecCommandRefusalCause (gunbc.remote_shell_command) into a diagnostic String --
// the only refusal this generic runner can hit today is RemoteExecInterpretationUnknown, since
// every SshExec constructed in-tree names a determined interpretation
// (openssh_login_shell_interpretation / openbmc_dropbear_interpretation); the cause stays a match
// over the full type rather than a partial one so a newly added cause fails to compile here instead
// of falling through silently (gunbc.design_argument::guarantee_ladder: no untracked stall).

fn command_over_transport_refusal_reason(cause: RemoteExecCommandRefusalCause) -> String {
  match cause {
    RemoteExecInterpretationUnknown =>
      "the SSH target's RemoteExecCommandInterpretation is Unknown -- refusing rather than assuming a POSIX shell on the far side"
    SimpleCommandArgvRefused { cause: _ } =>
      "the inner command's argv was empty"
  }
}

// THE RUN SITE NO LONGER MATCHES ON TRANSPORT.
//
// command_over_transport is transport-agnostic AT ITS OUTPUT: LocalExec is the identity, and
// SshExec folds the inner command through remote_exec_command_string into ONE RFC-4254-conformant
// command string carried as the final word of an outer sshpass/ssh argv
// (extdeps.exec.command command_over_transport_composition_note). Either way the result is one
// plain ArgvCommand of local-machine words. Re-deciding which transport built it here would be
// re-answering a question command_over_transport already answered (gunbc.design_argument::single_authority: dispatch
// belongs at one seam, never duplicated at its consumer).
//
// So there is exactly one execution path: ask command_over_transport once, decompose the
// resulting argv into program + operand words, and hand them straight to shell.Exec.RunArgv --
// no shell, no quoting, no re-parse on this machine. For LocalExec the words go directly to the
// named binary; for SshExec they go directly to sshpass/ssh, whose own single final argument
// already carries the correctly composed and quoted remote command string. Nothing about that
// composition depends on running it through a local shell first, which is why the former
// SSH-only shell_command_render / shell_exec_via_bash / retained_runtime heredoc hop is gone.
//
// THE EMPTY-ARGV REFUSAL IS GONE BECAUSE THE STATE IS GONE, which is a climb and not a relaxation
// (gunbc.design_argument::guarantee_ladder: structurally impossible beats mechanically preventable). Both run sites used
// to match list_head on the argv and refuse Absent with "empty argv: a command with no words
// names no program to execute". extdeps.exec.command ArgvCommand now carries `program: NonEmptyStr`
// beside `arguments`, so a command with no program has no representation to arrive here in -- the
// arm was not deleted for convenience, it became unreachable and an unreachable refusal arm is
// exactly the dead vocabulary this repository removes. What it protected against is now refused one
// layer earlier, by the type.
//
// THE BUILT/REFUSED DISTINCTION SURVIVES THE COLLAPSE, on purpose, as its own match arm rather
// than being folded into the exit-code decision below. A command that command_over_transport could
// not even BUILD (today, only RemoteExecInterpretationUnknown -- an SshExec whose remote shell
// dialect this runner refuses to assume) is NOT the same state as a command that reached a real
// process and exited nonzero: nothing ran in the first case, and treating it as though something
// ran and failed would erase that distinction. CommandOverTransportRefused therefore short-circuits
// to exit_failure directly and never reaches shell.Exec.RunArgv or the exit-code check at all.
//
// THE LocalExec ARM'S SHAPE BELOW IS THIS COLLAPSE'S OWN, not a preserved inheritance. Nothing
// about #8593's earlier LocalExec-only cut constrained what this run site had to look like once
// SshExec joined it through the same seam.
// THE STDIN SIBLING OF run_shell_command, LOCAL LEG ONLY. Same admitted shape -- a caller-named
// program and word list -- plus a payload that reaches the child as STDIN, never as an argv
// element, so data carrying spaces, quotes or metacharacters cannot change the command's meaning
// whatever it contains. Built for the typed append (tee -a) whose whole point is that the payload
// is data. There is NO transport parameter to misread: the name says local, and the ssh leg would
// forward the payload to a remote shell session -- admitting that is its own change with its own
// analysis, and until it exists a caller wanting that gets a compile error, not a runtime refusal.
// THE GIT ROUTE WALL GATE (gunbc.design_argument::fail_closed). ProcessExit is this operation's own
// outcome, so a refusal is the module's typed ProcessExit refusal -- exit_failure with a reason (a
// ProcessExit carrying WHY nothing ran), NOT an observed child exit code. The gate runs before
// command_over_transport so it classifies the INNER ArgvCommand, not the transport-wrapped one.
fn run_shell_command_stdin_local(command: ArgvCommand, stdin_payload: String) -> ProcessExit
{
  if !git_route_wall_admits(command: command) {
    git_route_wall_refusal_exit(command: command)
  } else {
    match command_over_transport(command: command, transport: LocalExec) {
      CommandOverTransportRefused { cause: c } =>
        exit_failure(reason: concat("command_over_transport refused: ", command_over_transport_refusal_reason(cause: c)))
      CommandOverTransportBuilt { command: over } => {
        let run = shell.Exec.RunArgvStdin(
          program: over.program.invocation,
          arguments: process_argv_expansion(
            surface: cli_surface_of_literal_words(words: over.arguments)
          ),
          stdin_payload: stdin_payload,
        )
        if process_exit_is_admitted(policy: ExitZeroSucceeds, exit_code: run.exit_code) {
          ExitSuccess
        } else {
          exit_failure(reason: concat("command failed: ", run.stderr))
        }
      }
    }
  }
}

// THE GIT ROUTE WALL GATE (gunbc.design_argument::fail_closed), BOTH arms. ProcessExit is this
// operation's own outcome, so a refusal is the module's typed ProcessExit refusal -- exit_failure with a
// reason (a ProcessExit carrying WHY nothing ran), NOT an observed child exit code. The gate runs before
// command_over_transport so it classifies the INNER ArgvCommand and refuses a bare mutating git on the
// LOCAL and the SSH arm alike (a remote `git commit` with no in-repo dressing would run in the SSH
// session's ambient CWD, the same hazard the wall guards, since the caller does not control that CWD).
fn run_shell_command(command: ArgvCommand, transport: CommandTransport) -> ProcessExit
{
  if !git_route_wall_admits(command: command) {
    git_route_wall_refusal_exit(command: command)
  } else {
    match command_over_transport(command: command, transport: transport) {
      CommandOverTransportRefused { cause: c } =>
        exit_failure(reason: concat("command_over_transport refused: ", command_over_transport_refusal_reason(cause: c)))
      CommandOverTransportBuilt { command: over } =>
        {
          let run = shell.Exec.RunArgv(
            program: over.program.invocation,
            arguments: process_argv_expansion(
              surface: cli_surface_of_literal_words(words: over.arguments)
            ),
          )
          if process_exit_is_admitted(policy: ExitZeroSucceeds, exit_code: run.exit_code) {
            ExitSuccess
          } else {
            exit_failure(reason: concat("command failed: ", run.stderr))
          }
        }
    }
  }
}

// argv_operands IS DELETED, not moved: it existed to recover the operands by dropping the head of a
// flat word list, and the carrier now carries them as their own field. A helper that re-derives a
// fact the type states is the second representation gunbc.design_argument::minimize_redundancy removes.

// Capture variant (CONVERGE acceptance, host-key enrollment): same admitted transport,
// but the caller receives the process observation instead of a collapsed ProcessExit —
// for wet observations whose PRODUCT is the stdout (ssh-keyscan, ssh-keygen -lf).
// Success/stdout/stderr travel together so a refusal cannot be read as empty output.

// SPAWN FAILURE IS ALREADY FAIL-CLOSED, and this is the transport fact that decides what the
// capture surface can and cannot say. Measured wet against the real local path: a command whose
// program does not exist does NOT come back as a failed result. It REFUSES the evaluation with a
// typed diagnostic naming the program and the OS error --
//   failed to execute 'no_such_binary': No such file or directory (os error 2)
// -- so no result record is produced at all.
//
// TWO CONSEQUENCES, and the second is the useful one.
//
// THE SPAWNED-VERSUS-NEVER-SPAWNED DISTINCTION IS REAL, but it lives where the decision is made,
// not in the child. A program that cannot exec aborts the evaluation as above, and there is no
// reading left to inspect: ProcessExit needs no variant for it. What DOES need an answer is the
// step before any exec -- the spawner declining to build the command at all. Nothing ran and no
// abort happens there, and this module used to answer that case by writing an exit code for a child
// that never existed (the `exit_code: 0 - 1` this text used to rationalize). The capture grain
// answers it as ProcessCaptureOutcome::ProcessCaptureNotSpawned { program, cause }: an arm with a
// real producer, not an uninhabited one, because the refusal path is reachable.
//
// AND A CALLER CANNOT PROBE FOR A BINARY'S EXISTENCE BY TRYING TO RUN IT. The attempt does not
// return an answer; it stops the line. Presence must be asked of something that exists -- spawn a
// shell and let `command -v` report -- rather than spawning the candidate and interpreting the
// wreckage. That is why a separate presence probe has to exist, and it is a boundary fact about
// the transport rather than a limitation of this module.
//
// THE BUILT/REFUSED DISTINCTION SURVIVES HERE TOO, and it needs no invented exit code to do it: a
// refusal returns Absent -- NO ProcessExit at all, because no child was created and an exit code
// written for a run that never happened is an observation nobody observed
// (gunbc.design_argument::fail_closed) -- while a command that reached shell.Exec.RunArgv returns
// Present { value: .. } carrying that process's OWN exit_code. At the capture entry the same fact
// is ProcessCaptureOutcome::ProcessCaptureNotSpawned { program, cause }, which is what the
// exit_code: 0 - 1 that used to be fabricated there was finally replaced with.
//
// THE SPAWN-REFUSAL ASYMMETRY SURVIVES THE COLLAPSE, and it survives because the collapse never
// touched what program each arm names -- only how the resulting argv reaches the process. LocalExec
// names a CALLER-SUPPLIED program, so the spawn-failure arm above is reachable on it: a typo'd or
// missing binary refuses the evaluation, as described. SshExec's local-machine program is always
// sshpass/ssh (extdeps.exec.command ssh_exec_prefix) -- present by construction wherever an SshExec
// value exists at all -- so that arm cannot hit an unspawnable-local-program refusal the same way.
// Both facts are real properties of the two transports, not an accident of the old per-transport
// match; collapsing the run site onto one path must not read as making the arms symmetric where
// they are not.
//
// THE SSH EXIT-255 COLLISION IS ACCEPTED, NOT RESOLVED, and stays that way here: ssh overloads
// exit 255 for its own transport failures, indistinguishable by exit code alone from a remote
// command that legitimately exits 255 on its own terms, so both arrive here as one
// ProcessRefused { exit_code: 255, .. }. ProcessRefused.stderr carries ssh's message as prose
// ONLY -- readable by a human debugging a failure, never matched on by a caller, since a retry
// policy branching on unparsed prose would treat "host unreachable" and "command ran and exited
// 255" as the same case when they demand OPPOSITE responses. Full disposition, rung, and
// dissolution trigger: ssh_exit_255_conflation_dissolution, above.
//
// WHAT THE CAPTURE SURFACE RETURNS, and why it is a coproduct rather than a record.
// ShellCaptureResult carried success: Bool beside stdout: String, which made two states that a
// caller cannot tell apart: a program that RAN AND FAILED printing nothing, and one that RAN AND
// SUCCEEDED printing nothing. Both are stdout == "". Correlating them was the caller's duty, and
// measured across the live sites, EIGHT of them did not perform it -- they read stdout and acted
// on the empty string as though it were an answer. That is the empty-observation narrow: not a
// widen, its mirror, and it was live in production at eight sites.
//
// The coproduct makes the failure unignorable: output is reachable ONLY through the variant that
// carries it, so a caller cannot read text without having confronted the arm where there is none.
// THE GIT ROUTE WALL GATE. Before any transport wrapping, classify whether the inner ArgvCommand's
// program is git (by basename, not exact spelling) and if so, consult the route wall.
// SCOPE OF THE GUARANTEE, stated at its real rung (gunbc.design_argument::guarantee_ladder): this gate
// (git_route_wall_admits + refusal surfaces git_route_wall_refusal / git_route_wall_refusal_exit /
// git_route_wall_refusal_capture) is compulsory for RECOGNIZED DIRECT-GIT argvs routed through ALL FOUR
// entries that reach a spawn: run_shell_command_observe_outcome, run_shell_command,
// run_shell_command_stdin_local and run_shell_command_capture. No entry that reaches a spawn is exempt:
// capture stood outside this gate only while its one refusal arm was the fabricated exit_code: 0 - 1
// sentinel -- routing the wall through a fabrication spreads it -- and with ProcessCaptureOutcome's typed
// ProcessCaptureNotSpawned the gate closed there as well, under its own capture-grain red controls on the
// route-wall witness. A recognized bare mutating
// git argv handed to a gated entry is refused on BOTH arms (local AND SSH): command_runner is the only
// module turning an ArgvCommand into a local process, and the gate runs before command_over_transport, so a
// remote `git commit -m x` without in-repo dressing -- which would run in the SSH session's ambient CWD, the
// same hazard the wall guards since the caller does not control that CWD -- is refused just as the local one is.
// COVERAGE LIMITATION, counted: a git invocation wrapped by extdeps.git::env_prefixed_command (the
// config writers and maintenance helpers) has program `env`, so is_git_program does not classify it and
// the wall never inspects the git tail inside it. Those builders are `-C`-dressed at their tail today,
// and the belt path that uses them (roadmap_belt_actuate) dispatches via host_exec_argv, not this gate;
// the limitation is stated rather than hidden (gunbc.design_argument::fail_closed).
fn git_route_wall_admits(command: ArgvCommand) -> Bool {
  if !is_git_program(invocation: command.program.invocation) {
    true
  } else {
    match spawn_git_argv_workdir_free(argv: command.arguments) {
      GitWorkdirFreeSpawnAdmitted { program: _, arguments: _ } => true
      GitWorkdirFreeSpawnRefused => false
    }
  }
}

// THE TYPED REFUSAL SURFACE: ProcessRunOutcome already carries ProcessNotSpawned { program, cause },
// which is the wall's answer without fabricating an exit code (gunbc.design_argument::fail_closed).
fn git_route_wall_refusal(command: ArgvCommand) -> ProcessRunOutcome {
  ProcessNotSpawned {
    program: command.program.invocation,
    cause: "git route wall: bare mutating argv refused at workdir-free route; use gunbc.git_workdir_free_route" as NonEmptyStr,
  }
}

// THE TYPED REFUSAL FOR A ProcessExit-RETURNING ENTRY (run_shell_command, run_shell_command_stdin_local).
// ProcessExit IS the operation's own outcome, so the honest refusal is the module's existing typed
// ProcessExit refusal -- exit_failure with a reason (a ProcessExit carrying WHY nothing ran). Its code is
// the general-error sentinel, NOT an observed child exit, so no observation is fabricated
// (gunbc.design_argument::fail_closed); the reason is what a caller/red control reads back.
fn git_route_wall_refusal_exit(command: ArgvCommand) -> ProcessExit {
  exit_failure(reason: concat("git route wall: bare mutating argv refused at workdir-free route for program ", concat(command.program.invocation, "; use gunbc.git_workdir_free_route")))
}


// THE TYPED REFUSAL FOR THE CAPTURE ENTRY (run_shell_command_capture). Same meaning as
// git_route_wall_refusal: no child was ever created, so the honest answer is the typed
// not-spawned arm of ProcessCaptureOutcome -- never a ProcessCaptured verdict, never an exit code.
fn git_route_wall_refusal_capture(command: ArgvCommand) -> ProcessCaptureOutcome {
  ProcessCaptureNotSpawned {
    program: command.program.invocation,
    cause: concat("git route wall: bare mutating argv refused at workdir-free route for program ", concat(command.program.invocation, "; use gunbc.git_workdir_free_route")) as NonEmptyStr,
  }
}

// THE TYPED REFUSAL SURFACE: at this entry, ProcessRunOutcome::ProcessNotSpawned is the meaning of
// "nothing ran". A transport that refuses to build the command spawned nothing either, so it is the
// same arm, never an exit code: no process ran, and a sentinel exit status would be a fabricated
// observation (gunbc.design_argument::fail_closed). At the CAPTURE grain the same rule has a declared
// second leaf, ProcessCaptureOutcome::ProcessCaptureNotSpawned -- one rule, two grains, until PR C
// folds both into SpawnOutcome<T> (the explanation and the machine-readable debt row sit on the type
// in extdeps/shell/exec.dag: ProcessCaptureOutcome's comment and process_capture_outcome_dissolve_on).
//
// THIS IS ALSO THE ONLY ENTRY WHOSE PRODUCT IS THE RAW OBSERVATION **EVEN WHEN THE PROCESS FAILED**,
// which is why the fleet's stdout-of-a-failed-run callers (the Firecracker serial-console receipts,
// the census image probes, the rootfs capture legs) route here rather than at
// run_shell_command_capture below. Capture answers "what did this print IF it succeeded":
// classify_process_observation returns ProcessRefused { exit_code, stderr } on a non-admitted exit
// and DISCARDS stdout. That is right for a caller reading a value out of a command, where output
// from a failed run is not a value. It is exactly wrong for a caller whose evidence IS the stdout of
// a run that failed: a Firecracker guest's serial console arrives on the VMM's stdout, so a guest
// that panics and is then killed by its deadline produces its most important output on the stream
// the classifier throws away -- and a receipt that then reported stderr as "the console" would be a
// fabricated label on missing evidence, which gunbc.design_argument::fail_closed forbids by name.
// So the triple is returned and the caller decides; the classifier is untouched.
//
// GIT COVERAGE, stated rather than assumed: the one caller on this entry whose program is git is
// test/claim/roadmap/worker_git_subtree_apply_spawn_wet_witness wre3_gate_observation, via
// extdeps.git git_absolute_git_dir_premise_argv (`-c safe.directory=.. --git-dir <repo>/.git
// rev-parse --absolute-git-dir`). It is ADMITTED, by the wall's leading-subcommand walk skipping the
// `-c`/`--git-dir` operands and landing on the read-only verb `rev-parse` -- no `-C`-first reordering
// was needed -- and the witness's own claim asserts that admission, so this sentence is checked and
// not merely written.
fn run_shell_command_observe_outcome(command: ArgvCommand, transport: CommandTransport) -> ProcessRunOutcome
  uses net: Network
{
  if !git_route_wall_admits(command: command) {
    git_route_wall_refusal(command: command)
  } else {
    match command_over_transport(command: command, transport: transport) {
      CommandOverTransportRefused { cause: c } =>
        ProcessNotSpawned {
          program: command.program.invocation,
          cause: concat("command_over_transport refused: ", command_over_transport_refusal_reason(cause: c)) as NonEmptyStr,
        }
      CommandOverTransportBuilt { command: over } =>
        {
          let run = shell.Exec.RunArgvOutcome(
            program: over.program.invocation,
            arguments: process_argv_expansion(
              surface: cli_surface_of_literal_words(words: over.arguments)
            ),
          )
          match run.outcome {
            ShellSpawnRefused { program: p, cause: why } => ProcessNotSpawned { program: p, cause: why }
            ShellExited => ProcessRan { observation: process_observation(exit_code: run.exit_code, stdout: run.stdout, stderr: run.stderr) }
          }
        }
    }
  }
}

// THE CAPTURE ROUTE, now fully guarded (gunbc.design_argument::guarantee_ladder / fail_closed). Capture's
// product is stdout, so its answer is ProcessCaptureOutcome: ProcessCaptured carries the
// classify_process_observation verdict under ExitZeroSucceeds over an observation that EXISTS, and
// ProcessCaptureNotSpawned carries the case where no child was ever created. It is the entry that
// used to answer a refusal with process_observation(exit_code: 0 - 1, ...) and therefore with
// ProcessRefused { exit_code: -1 } -- an exit code fabricated into a coproduct whose arms are all
// verdicts over an observed run. That fabrication is gone: the transport's refusal is now a typed
// arm naming the program and the cause, exactly as observe_outcome has always spelled it.
//
// GATED, LIKE THE OTHER THREE ENTRIES (round 6, brief goal 2). The wall gate now runs in
// observe_outcome, run_shell_command, run_shell_command_stdin_local AND capture: a bare mutating
// git argv (any spelling, local or ssh) answers ProcessCaptureNotSpawned with the wall's cause
// BEFORE command_over_transport is consulted -- no fabricated verdict, never a ProcessCaptured
// claim about a child that never ran (gunbc.design_argument::fail_closed). The original reason
// capture waited -- a refusal could only ride the fabricated -1 sentinel, so gating would spread
// the fabrication -- was retired by the typed not-spawned arm above; what kept the gate back
// since was its CONTROL SET, now landed in test/claim/git_command_runner_route_wall_witness:
// bare-mutating local/add, absolute /usr/bin/git, deep absolute, and the SSH arm over THIS entry,
// plus the gate-inversion mutation (muts M18) that proves those claims go red when the gate is
// deleted. ONE live git caller runs through capture today:
//   gunbc.runner.runner_revision_job_guest::revision_job_tree_steps (git init / add / snapshot commit /
//   diff-tree, L100-110) is executed through capture by test/claim/runner/runner_revision_job_guest_
//   wet_witness::run_all. Its commands are all `-C`-dressed (the shipped builders), so the wall
//   ADMITS them -- witnessed by that wet claim, not by prose.
fn run_shell_command_capture(command: ArgvCommand, transport: CommandTransport) -> ProcessCaptureOutcome
{
  if !git_route_wall_admits(command: command) {
    git_route_wall_refusal_capture(command: command)
  } else {
  match command_over_transport(command: command, transport: transport) {
    CommandOverTransportRefused { cause: c } =>
      ProcessCaptureNotSpawned {
        program: command.program.invocation,
        cause: concat("command_over_transport refused: ", command_over_transport_refusal_reason(cause: c)) as NonEmptyStr,
      }
    CommandOverTransportBuilt { command: over } =>
      {
        // shell.Exec.RunArgv, NOT RunArgvOutcome, and that is a decision rather than an oversight:
        // which shell.Exec operation an entry names decides where a HERMETIC claim stops
        // (HostEffectRefused at that operation), and capture is the entry the fleet's receipt
        // witnesses rest on. The spawn-abort fact is documented on run_shell_command above and is a
        // separate matter from the pre-spawn refusals this entry owns; moving both at once would
        // move 156 call sites' host-effect surface for a reason this PR does not have.
        let run = shell.Exec.RunArgv(
          program: over.program.invocation,
          arguments: process_argv_expansion(
            surface: cli_surface_of_literal_words(words: over.arguments)
          ),
        )
        ProcessCaptured {
          outcome: classify_process_observation(
            policy: ExitZeroSucceeds,
            observation: process_observation(exit_code: run.exit_code, stdout: run.stdout, stderr: run.stderr),
          ),
        }
      }
  }
  }
}

// Did a CAPTURED process do its job? The capture grain of process_outcome_admitted, and the reason it
// exists is the not-spawned arm: a caller that asked for output and got no child must be refused, not
// handed the verdict it would have gotten from a silent run. Nothing spawns here, so nothing is
// observed: false on ProcessCaptureNotSpawned is a refusal of a question that has no answer, not a
// reading of a failure. A caller that needs the CAUSE (a receipt, a diagnostic, an operator message)
// matches the arms itself -- this helper deliberately cannot reach it.
fn process_capture_admitted(captured: ProcessCaptureOutcome) -> Bool {
  match captured {
    ProcessCaptured { outcome: o } => process_outcome_admitted(outcome: o)
    ProcessCaptureNotSpawned { program: _, cause: _ } => false
  }
}

// ONE HOME for the not-spawned receipt rendering: how "there was never a child" reads on a receipt,
// shared by every grain that must say it (capture below, run above). Never blank, never invented:
// program and cause come from the refusal that stopped the spawn, and PR C dissolves this row together
// with the second not-spawned leaf it serves (see process_capture_outcome_dissolve_on).
fn process_not_spawned_text(program: NonEmptyStr, cause: NonEmptyStr) -> String {
  join(["(not spawned: ", trim(s: program), " -- ", trim(s: cause), ")"], "")
}

// A receipt line's text at the capture grain, and it is NOT a flattening back to the conflated shape:
// the four states render to four DISTINGUISHABLE strings, so 'the child never spawned' cannot be
// printed as '(no output)', which is the exact confusion ProcessOutputAbsent exists to prevent. Same
// rule as process_outcome_receipt_text: for human-readable text only; a caller using the value AS DATA
// matches the arms itself.
fn process_capture_receipt_text(captured: ProcessCaptureOutcome) -> String {
  match captured {
    ProcessCaptured { outcome: o } => process_outcome_receipt_text(outcome: o)
    ProcessCaptureNotSpawned { program: p, cause: c } => process_not_spawned_text(program: p, cause: c)
  }
}

// Did the process do its job? Callers whose product is the EXIT STATUS rather than the output ask
// this instead of matching all three arms -- `test -f` has no stdout anyone wants, and forcing it
// through an output-bearing variant would add a field it cannot answer. This is not a flattening
// helper for output-consuming callers: it deliberately cannot reach the text.
fn process_outcome_admitted(outcome: ProcessOutcome) -> Bool {
  match outcome {
    ProcessOutputPresent { text: _ } => true
    ProcessOutputAbsent => true
    ProcessRefused { exit_code: _, stderr: _ } => false
  }
}

// THE RUN GRAIN of the same question, and the reason it is not the outcome-grain helper: at this
// grain the caller holds a ProcessRunOutcome, which says WHETHER A CHILD EXISTED before it says how
// it did. The policy is a parameter, not a constant baked in here -- run_shell_command_observe_outcome
// is policy-free by design (its callers decide what a good exit is: most ExitZeroSucceeds, a
// readiness probe ExitZeroOrOneSucceeds), and a helper that picked the policy for them would quietly
// make one policy the module's answer. Not-spawned is false, which is a REFUSAL of a question that
// has no answer, not a reading of a failed run: nothing ran, so no policy can admit it
// (gunbc.design_argument::fail_closed). A caller that must REPORT why, as opposed to branch on
// whether, takes process_run_outcome_error_text or matches the arms itself.
fn process_run_outcome_admitted(policy: ProcessExitPolicy, run: ProcessRunOutcome) -> Bool {
  match run {
    ProcessRan { observation: o } => process_exit_is_admitted(policy: policy, exit_code: o.exit_code)
    ProcessNotSpawned { program: _, cause: _ } => false
  }
}

// The line a refusal receipt prints for a run: the child's OWN stderr when there was a child, and
// the program plus the cause when there never was one. The second half is the whole point -- the
// old shape printed trim(stderr) of an observation that did not exist, which rendered a refusal to
// spawn as an empty string, and an empty explanation is how a fabricated -1 used to look on a
// receipt. Never blank, never invented: every string here came from the child or from the refusal
// that stopped it. Text for receipts and diagnostics only; a caller reading the value AS DATA matches
// the arms, same rule as process_outcome_receipt_text.
fn process_run_outcome_error_text(run: ProcessRunOutcome) -> String {
  match run {
    ProcessRan { observation: o } => o.stderr
    ProcessNotSpawned { program: p, cause: c } => process_not_spawned_text(program: p, cause: c)
  }
}

// A receipt line's text, and it is NOT a flattening back to the conflated shape. The three arms
// render to three DISTINGUISHABLE strings: a refusal can never be mistaken for empty output, which
// is the exact property the old record lacked. Use it only where the value is being written into
// human-readable text; a caller that uses the value AS DATA -- a path, a hostname -- must match the
// arms itself, because "(refused: ...)" is a fine thing to print and a catastrophic thing to open.
fn process_outcome_receipt_text(outcome: ProcessOutcome) -> String {
  match outcome {
    ProcessOutputPresent { text: t } => trim(s: t)
    ProcessOutputAbsent => "(no output)"
    ProcessRefused { exit_code: _, stderr: e } => join(["(refused: ", trim(s: e), ")"], "")
  }
}

// Receipt owner probe — admitted under command_runner_scaffold until
// extdeps.filesystem.filesystem_io carries typed owner observation.
fn stat_owner_name_capture(path: String) -> ProcessCaptureOutcome {
  run_shell_command_capture(
    command: stat_owner_user_name_command(path: path),
    transport: LocalExec,
  )
}

fn run_shell_commands(commands: List<ArgvCommand>, transport: CommandTransport) -> ProcessExit
{
  fold(
    commands,
    init: ExitSuccess,
    f: (acc, c) => match acc {
      ExitFailure { code: _, reason: _ } => acc
      ExitSuccess => run_shell_command(command: c, transport: transport)
    }
  )
}
