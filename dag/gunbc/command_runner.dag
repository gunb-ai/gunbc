module gunbc.command_runner

import std.dissolution { DissolutionCondition, dissolution_description, unbound_dissolution }

import std.types { List, String, NonEmptyStr }
import std.process { ProcessExit, ExitSuccess, exit_failure }
import std.resources { Network }
import v2.std.algebra { list_head, list_tail, HeadFound, HeadAbsent, TailFound, TailAbsent }
import std.algebra { Empty }
import v2.std.compilers.cli_surface { cli_surface_of_literal_words, process_argv_expansion }
import extdeps.shell.exec { ExitZeroSucceeds, process_exit_is_admitted }
import extdeps.exec.command {
  ArgvCommand,
  CommandTransport,
  LocalExec,
  command_over_transport,
  CommandOverTransportBuilt,
  CommandOverTransportRefused,
}
import gunbc.remote_shell_command {
  RemoteExecCommandRefusalCause,
  RemoteExecInterpretationUnknown,
  SimpleCommandArgvRefused,
}
import extdeps.shell
import std.disposition { Disposition, Scaffold, RealizationDispatch }
import std.decl_ref { DeclarationRef, WholeDeclaration }

data command_runner_scaffold: Disposition = Scaffold {
  dissolves_to: RealizationDispatch,
  bind: DeclarationRef {
    module_path: "gunbc.command_runner",
    decl_name: "command_runner_dissolution_trigger",
    field: WholeDeclaration,
  }
}

data command_runner_dissolution_trigger: DissolutionCondition = unbound_dissolution(description: "🟡 dissolve-on: run_shell_command — generic ArgvCommand runner routes the typed extdeps.exec.command shape directly at shell.Exec.RunArgv, one uniform arm for every CommandTransport rather than a per-transport bash heredoc; DISSOLVES WHEN host_effect_apply binds ArgvCommand execution as a typed transport handler and dag/gunbc/command_runner.dag retires run_shell_command in favor of it")

// THE RUN SITE NO LONGER MATCHES ON TRANSPORT.
//
// command_over_transport is ALREADY transport-agnostic at its output: LocalExec is the identity
// and SshExec folds the inner command into ONE RFC-4254 command string carried as the final word
// of an outer sshpass/ssh argv (extdeps.exec.command command_over_transport_composition_note).
// Either way the result is one plain ArgvCommand of local-machine words -- there is no longer a
// reason to ask which transport built it. A per-transport match here would be re-deciding a
// question command_over_transport already answered (DESIGN §3: dispatch belongs at one seam, not
// duplicated at its consumer).
//
// So this runner has exactly one execution path: decompose the outer argv into program + operand
// words and hand them straight to shell.Exec.RunArgv, with no shell, no quoting, and no re-parse
// on this machine -- for LocalExec the words go directly to the named binary; for SshExec the
// words go directly to sshpass/ssh, whose own single final argument already carries the correctly
// composed and quoted remote command string. Nothing about that composition depends on running it
// through a local shell first.
//
// EMPTY ARGV REFUSES rather than defaulting. A command with no words names no program to execute,
// and inventing one would be the fabricated output DESIGN §5 forbids. command_over_transport never
// produces an empty argv on either arm (SshExec always prepends sshpass/ssh/target/opts), so this
// arm is reachable only from a caller-constructed empty ArgvCommand on LocalExec.
func run_shell_command(command: ArgvCommand, transport: CommandTransport) -> ProcessExit
  uses net: Network
{
  match command_over_transport(command: command, transport: transport) {
    CommandOverTransportRefused { cause: c } =>
      exit_failure(reason: concat("command_over_transport refused: ", command_over_transport_refusal_reason(cause: c)))
    CommandOverTransportBuilt { command: over } =>
      match list_head(xs: over.argv) {
        HeadAbsent =>
          exit_failure(reason: "empty argv: a command with no words names no program to execute")
        HeadFound { value: program } => {
          let run = shell.Exec.RunArgv(
            program: program as NonEmptyStr,
            arguments: process_argv_expansion(
              surface: cli_surface_of_literal_words(words: argv_operands(command: over))
            ),
          )
          if process_exit_is_admitted(policy: ExitZeroSucceeds, exit_code: run.exit_code) {
            ExitSuccess
          } else {
            exit_failure(reason: concat("command failed: ", run.stderr))
          }
        }
      }
  }
}

// The operands are everything after the program. A missing tail is the one-word command, whose
// operand list is empty -- not an error, and not the same state as an empty argv.
fn argv_operands(command: ArgvCommand) -> List<String> {
  match list_tail(xs: command.argv) {
    TailAbsent => Empty
    TailFound { tail: rest } => rest
  }
}

data command_over_transport_refusal_reason_note: String = "Renders RemoteExecCommandRefusalCause (gunbc.remote_shell_command) into a diagnostic String for ProcessExit -- the only refusal this generic runner can hit today is RemoteExecInterpretationUnknown, since every SshExec constructed in-tree names a determined interpretation (openssh_login_shell_interpretation / openbmc_dropbear_interpretation); the cause stays a match over the full type rather than a partial one so a newly added cause fails to compile here instead of falling through silently (DESIGN 4b: no untracked stall)."

fn command_over_transport_refusal_reason(cause: RemoteExecCommandRefusalCause) -> String {
  match cause {
    RemoteExecInterpretationUnknown =>
      "the SSH target's RemoteExecCommandInterpretation is Unknown -- refusing rather than assuming a POSIX shell on the far side"
    SimpleCommandArgvRefused { cause: _ } =>
      "the inner command's argv was empty"
  }
}

// Capture variant (CONVERGE acceptance, host-key enrollment): same admitted transport,
// but the caller receives the process observation instead of a collapsed ProcessExit —
// for wet observations whose PRODUCT is the stdout (ssh-keyscan, ssh-keygen -lf).
// Success/stdout/stderr travel together so a refusal cannot be read as empty output.
type ShellCaptureResult {
  success: Bool
  stdout: String
  stderr: String
}

// THE success FIELD IS DERIVED THROUGH A NAMED POLICY, not a bare exit_code == 0. RunArgv
// deliberately carries no success field, because success is a POLICY judgement about an
// observation rather than part of it -- jq exits 4 to mean "no output" and 1 to mean "false
// result", neither of which is failure. Routing through process_exit_is_admitted(ExitZeroSucceeds)
// states which convention this runner applies, so a caller needing a different one has something
// to change rather than a literal to discover.
func run_shell_command_capture(command: ArgvCommand, transport: CommandTransport) -> ShellCaptureResult
  uses net: Network
{
  match command_over_transport(command: command, transport: transport) {
    CommandOverTransportRefused { cause: c } =>
      ShellCaptureResult {
        success: false,
        stdout: "",
        stderr: concat("command_over_transport refused: ", command_over_transport_refusal_reason(cause: c)),
      }
    CommandOverTransportBuilt { command: over } =>
      match list_head(xs: over.argv) {
        HeadAbsent =>
          ShellCaptureResult {
            success: false,
            stdout: "",
            stderr: "empty argv: a command with no words names no program to execute",
          }
        HeadFound { value: program } => {
          let run = shell.Exec.RunArgv(
            program: program as NonEmptyStr,
            arguments: process_argv_expansion(
              surface: cli_surface_of_literal_words(words: argv_operands(command: over))
            ),
          )
          ShellCaptureResult {
            success: process_exit_is_admitted(policy: ExitZeroSucceeds, exit_code: run.exit_code),
            stdout: run.stdout,
            stderr: run.stderr,
          }
        }
      }
  }
}

// Receipt owner probe — admitted under command_runner_scaffold until
// extdeps.filesystem.filesystem_io carries typed owner observation.
fn stat_owner_name_capture(path: String) -> ShellCaptureResult {
  run_shell_command_capture(
    command: ArgvCommand { argv: ["stat", "-c", "%U", path] },
    transport: LocalExec,
  )
}

func run_shell_commands(commands: List<ArgvCommand>, transport: CommandTransport) -> ProcessExit
  uses net: Network
{
  fold(
    commands,
    init: ExitSuccess,
    f: (acc, c) => match acc {
      ExitFailure { code: _, reason: _ } => acc
      ExitSuccess => run_shell_command(command: c, transport: transport)
    }
  )
}
