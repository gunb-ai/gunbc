      "witness_zero_consume_is_not_movable", "witness_whole_read_then_consume_is_not_movable",
      "witness_threaded_then_consume_is_not_movable"
    ]
  }
]

fn frozen_path_deferral_function_listed(functions: List<String>, function: String) -> Bool {
  fold(
    functions,
    init: false,
    f: fn(found, name) { found || (name == function) }
  )
}

fn frozen_path_deferral_row_covers(
  row: FrozenPathDeferral,
  entry: String,
  function: String
) -> Bool {
  (row.entry == entry)
    && frozen_path_deferral_function_listed(functions: row.functions, function: function)
}

fn frozen_path_deferral_covers_in(
  rows: List<FrozenPathDeferral>,
  entry: String,
  function: String
) -> Bool {
  fold(
    rows,
    init: false,
    f: fn(found, row) {
      found || frozen_path_deferral_row_covers(row: row, entry: entry, function: function)
    }
  )
}

fn frozen_path_deferral_covers(entry: String, function: String) -> Bool {
  frozen_path_deferral_covers_in(
    rows: frozen_path_deferrals,
    entry: entry,
    function: function
  )
}

fn frozen_path_deferral_row_well_formed(row: FrozenPathDeferral) -> Bool {
  !(row.entry == "")
    && !(row.functions.length() == 0)
    && fold(
      row.functions,
      init: true,
      f: fn(ok, name) { ok && !(name == "") }
    )
}

fn frozen_path_deferrals_well_formed_in(rows: List<FrozenPathDeferral>) -> Bool {
  fold(
    rows,
    init: true,
    f: fn(ok, row) { ok && frozen_path_deferral_row_well_formed(row: row) }
  )
}

fn frozen_path_deferrals_well_formed() -> Bool {
  frozen_path_deferrals_well_formed_in(rows: frozen_path_deferrals)
}

fn frozen_path_deferral_identity_count_in(rows: List<FrozenPathDeferral>) -> Int {
  fold(
    rows,
    init: 0,
    f: fn(n, row) { n + row.functions.length() }
  )
}

data frozen_path_deferral_count_is_a_receipt_note: String = "frozen_path_deferral_identity_count_in is a RECEIPT projection and must never become an oracle. No witness may assert it against a literal: the roster was authored from the current tree, so a count equality would compare a measurement to a copy of itself and would go green on any pair of compensating edits. The executing oracles are the two identity joins in v2.workflow.witness_admission and its host projection — an unfrozen offline-classified witness refuses, and a frozen row the tree no longer carries refuses. This projection exists so the debt's size is readable in a receipt, and so its decline is visible."

fn frozen_path_deferral_identity_count() -> Int {
  frozen_path_deferral_identity_count_in(rows: frozen_path_deferrals)
}
