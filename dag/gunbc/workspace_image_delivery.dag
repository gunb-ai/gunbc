module gunbc.workspace_image_delivery

import std.types { String }
import std.process { ProcessExit, ExitSuccess, ExitFailure, exit_failure }
import gunbc.guest_image_delivery { guest_image_stage_inputs, guest_image_write_digest_receipt }
import gunbc.runner.microvm_guest_artifacts { runner_guest_kernel_artifact, runner_guest_base_rootfs_artifact, runner_guest_base_artifact_path }
import gunbc.runner.workspace_guest_image { workspace_image_build, workspace_image_path }

// Transport is not admission. The administrator installs these exact files, then checks the
// installed kernel and rootfs against the reviewed pins before commissioning can expose supply.
data workspace_image_staging_root: String = "target/workspace-image-artifact"
data workspace_image_artifact_name: String = "workspace-guest-image"
data workspace_image_build_receipt: String = "target/workspace-image-artifact/build-receipt.txt"

fn workspace_image_artifact_paths() -> String {
  join([workspace_image_path(root: workspace_image_staging_root),
    runner_guest_base_artifact_path(root: workspace_image_staging_root, artifact: runner_guest_kernel_artifact),
    workspace_image_build_receipt], "\n")
}

// Run the whole entry under fakeroot, so ownership survives extraction and mke2fs -d.
fn workspace_image_build_wet() -> ProcessExit {
  let root = workspace_image_staging_root
  match guest_image_stage_inputs(root: root, label: "WorkspaceImageBuildRefused", prepare: [], downloads: [runner_guest_base_rootfs_artifact]) {
    ExitFailure { code, reason } => ExitFailure { code: code, reason: reason }
    ExitSuccess => if !workspace_image_build(root: root) {
      exit_failure(reason: "WorkspaceImageBuildRefused: pinned base, SSH tools, ownership or image assembly failed")
    } else {
      guest_image_write_digest_receipt(image_path: workspace_image_path(root: root), receipt_path: workspace_image_build_receipt, key: "workspace-image-sha256")
    }
  }
}
