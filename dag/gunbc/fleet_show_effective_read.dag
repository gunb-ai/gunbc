data gunbc_fleet_runner_slice_cap_show_effective_read: ShowEffectiveRead<gunbc.ci_floor_measurement.RunnerSliceCapEffectiveness> = std.realization_reconcile.ReadAbsent {
  reason: "no live systemctl show -p MemoryMax on system-actions-runner.slice has run on the fleet yet; typed parse + transport live in gunbc.fleet_show_effective_read — bind ReadObserved at the apply increment"
}

data gunbc_fleet_runner_units_show_effective_read: ShowEffectiveRead<FleetRunnerUnitsLiveRead> = std.realization_reconcile.ReadAbsent {
  reason: "no live per-instance systemctl show loop has run on the fleet runner units yet; typed rows + transport live in gunbc.fleet_show_effective_read"
}

data gunbc_fleet_runner_width_show_effective_read: ShowEffectiveRead<RunnerWidthLiveRead> = std.realization_reconcile.ReadAbsent {
  reason: "no live systemctl list-units active-count read has run on the fleet runner glob yet; typed parse + transport live in gunbc.fleet_show_effective_read"
}

data gunbc_fleet_host_effective_read_show_effective_read: ShowEffectiveRead<FleetHostEffectiveReadReceipt> = std.realization_reconcile.ReadAbsent {
  reason: "no full-host effective read receipt has been collected on srv1/srv2 yet; compose the three v0-blocking knob reads here"
}

fn fleet_host_control_plane(host: product.placement_supply.HostIdentity) -> gunbc.host_effect.NodeControlPlane? {
  if host == operator_host_srv1 {
    Present { value: gunbc.host_effect.HostOs { node: srv1_host } }
  } else { if host == operator_host_srv2 {
    Present { value: gunbc.host_effect.HostOs { node: srv2_host } }
  } else { none } }
}

fn fleet_host_ssh_transport(host: product.placement_supply.HostIdentity) -> gunbc.host_effect.HostEffectTransport? {
  if host == operator_host_srv1 {
    Present { value: srv1_host_identity_ssh_transport() }
  } else { if host == operator_host_srv2 {
    Present { value: srv2_host_identity_ssh_transport() }
  } else { none } }
}

fn runner_slice_cap_live_read_typed(row: RunnerSliceCapLiveReadRow) -> RunnerSliceCapLiveRead {
  RunnerSliceCapLiveRead {
    slice_unit: row.slice_unit,
    memory_max: parse_systemd_memory_limit_show(raw: row.memory_max_raw),
    probed_at: row.probed_at,
  }
}

fn oom_pressure_limit_live_read_typed(row: OomPressureLimitLiveReadRow) -> OomPressureLimitLiveRead? {
  match parse_managed_oom_pressure_limit_show(raw: row.pressure_limit_raw) {
    Present { value: pct } =>
      Present {
        value: OomPressureLimitLiveRead {
          slice_unit: row.slice_unit,
          pressure_limit: pct,
          probed_at: row.probed_at,
        }
      }
    Absent => none
  }
}

fn runner_slice_cap_to_effectiveness(read: RunnerSliceCapLiveRead) -> gunbc.ci_floor_measurement.RunnerSliceCapEffectiveness? {
  memory_limit_to_cap_effectiveness(lim: read.memory_max)
}

fn show_effective_read_from_slice_cap_row(row: RunnerSliceCapLiveReadRow) -> std.realization_reconcile.ShowEffectiveRead<gunbc.ci_floor_measurement.RunnerSliceCapEffectiveness> {
  let read = runner_slice_cap_live_read_typed(row: row)
  match read.memory_max {
    MemoryLimitAbsent =>
      std.realization_reconcile.ReadAbsent { reason: "systemctl show MemoryMax returned empty (typed Absent); fail-closed, no fabricated cap" }
    _ =>
      match runner_slice_cap_to_effectiveness(read: read) {
        Present { value: eff } => std.realization_reconcile.ReadObserved { value: eff }
        Absent =>
          std.realization_reconcile.ReadAbsent { reason: "MemoryMax parse produced no RunnerSliceCapEffectiveness; fail-closed" }
      }
  }
}

fn show_effective_read_from_runner_units(host: product.placement_supply.HostIdentity, rows: List<gunbc.runner_unit_live_read.RunnerUnitLiveReadRow>) -> std.realization_reconcile.ShowEffectiveRead<FleetRunnerUnitsLiveRead> {
  if rows.length() == 0 {
    std.realization_reconcile.ReadAbsent { reason: "no runner unit rows to read; fail-closed" }
  } else {
    std.realization_reconcile.ReadObserved {
      value: FleetRunnerUnitsLiveRead {
        host: host,
        units: map(rows, f: fn(row) { runner_unit_live_read_typed(row: row) }),
      }
    }
  }
}

fn show_effective_read_from_width_row(row: RunnerWidthLiveReadRow) -> std.realization_reconcile.ShowEffectiveRead<RunnerWidthLiveRead> {
  match runner_width_live_read_typed(row: row) {
    Present { value: width } => std.realization_reconcile.ReadObserved { value: width }
    Absent => std.realization_reconcile.ReadAbsent { reason: "runner width list-units count parse failed (empty or non-numeric); fail-closed" }
  }
}

fn slice_property_memory_max_verdict(
  read: RunnerSliceCapLiveRead,
  property: String,
  expected: std.measure.ByteSize,
) -> gunbc.host_converge.ConvergeVerdict? {
  if property != systemd_memory_max_property {
    none
  } else {
    Present {
      value: memory_limit_converge_verdict(observed: read.memory_max, desired: expected)
    }
  }
}

fn oom_pressure_limit_converge_verdict(read: OomPressureLimitLiveRead, desired: std.measure.Percent) -> gunbc.host_converge.ConvergeVerdict {
  if percent_count(p: read.pressure_limit) == percent_count(p: desired) {
    VerdictConverged
  } else {
    Drifted
  }
}

fn parse_runner_width_active_count(raw: String) -> Int? {
  let trimmed = std.algebra.trim(raw)
  if trimmed == "" {
    none
  } else {
    match parse_int(s: trimmed) {
      Present { value: n } =>
        if n >= 0 { Present { value: n } } else { none }
      Absent => none
    }
  }
}

fn runner_width_live_read_typed(row: RunnerWidthLiveReadRow) -> RunnerWidthLiveRead? {
  match parse_runner_width_active_count(raw: row.active_count_raw) {
    Present { value: count } =>
      Present {
        value: RunnerWidthLiveRead {
          instance_glob: row.instance_glob,
          active_count: count,
          probed_at: row.probed_at,
        }
      }
    Absent => none
  }
}

fn runner_width_converge_verdict(observed: Int, desired: Int) -> gunbc.host_converge.ConvergeVerdict {
  if observed == desired { VerdictConverged } else { Drifted }
}

fn show_effective_read_cannot_converge(read: std.realization_reconcile.ShowEffectiveRead<gunbc.ci_floor_measurement.RunnerSliceCapEffectiveness>) -> Bool {
  match read {
    ReadAbsent { reason: _ } => true
    ReadObserved { value: CapUnbounded } => true
    ReadObserved { value: CapEffective { bytes: _ } } => false
  }
}

fn fleet_runner_units_from_rows(host: product.placement_supply.HostIdentity, rows: List<gunbc.runner_unit_live_read.RunnerUnitLiveReadRow>) -> FleetRunnerUnitsLiveRead {
  FleetRunnerUnitsLiveRead {
    host: host,
    units: map(rows, f: fn(row) { runner_unit_live_read_typed(row: row) }),
  }
}

fn fleet_host_effective_read_receipt(
  host: product.placement_supply.HostIdentity,
  slice_row: RunnerSliceCapLiveReadRow,
  unit_rows: List<gunbc.runner_unit_live_read.RunnerUnitLiveReadRow>,
  width_row: RunnerWidthLiveReadRow,
) -> FleetHostEffectiveReadReceipt? {
  match runner_width_live_read_typed(row: width_row) {
    Present { value: width } =>
      Present {
        value: FleetHostEffectiveReadReceipt {
          host: host,
          runner_slice_cap: runner_slice_cap_live_read_typed(row: slice_row),
          runner_units: fleet_runner_units_from_rows(host: host, rows: unit_rows),
          runner_width: width,
        }
      }
    Absent => none
  }
}

fn fleet_host_effective_read_grounded_from_fixture(
  host: product.placement_supply.HostIdentity,
  slice_row: RunnerSliceCapLiveReadRow,
  unit_rows: List<gunbc.runner_unit_live_read.RunnerUnitLiveReadRow>,
  width_row: RunnerWidthLiveReadRow,
  probed_at: std.types.NonEmptyStr,
) -> FleetHostEffectiveReadGroundedReceipt? {
  match fleet_host_effective_read_receipt(
    host: host,
    slice_row: slice_row,
    unit_rows: unit_rows,
    width_row: width_row,
  ) {
    Present { value: effective } =>
      Present {
        value: FleetHostEffectiveReadGroundedReceipt {
          host: host,
          effective: effective,
          runner_slice_cap_read: show_effective_read_from_slice_cap_row(row: slice_row),
          runner_units_read: show_effective_read_from_runner_units(host: host, rows: unit_rows),
          runner_width_read: show_effective_read_from_width_row(row: width_row),
          probed_at: probed_at,
        }
      }
    Absent => none
  }
}

fn fixture_srv1_runner_units_rows() -> List<gunbc.runner_unit_live_read.RunnerUnitLiveReadRow> {
  [gunbc_srv1_runner_unit_live_read_fixture, gunbc_srv1_runner_unit_live_read_fixture_02]
}

fn fixture_srv2_runner_units_rows() -> List<gunbc.runner_unit_live_read.RunnerUnitLiveReadRow> {
  [gunbc_srv2_runner_unit_live_read_fixture_01, gunbc_srv2_runner_unit_live_read_fixture_02]
}

fn fixture_srv1_host_effective_read_grounded_receipt() -> FleetHostEffectiveReadGroundedReceipt? {
  fleet_host_effective_read_grounded_from_fixture(
    host: operator_host_srv1,
    slice_row: gunbc_srv1_runner_slice_cap_fixture_row,
    unit_rows: fixture_srv1_runner_units_rows(),
    width_row: gunbc_srv1_runner_width_fixture_row,
    probed_at: gunbc_srv1_runner_slice_cap_fixture_row.probed_at,
  )
}

fn fixture_srv2_host_effective_read_grounded_receipt() -> FleetHostEffectiveReadGroundedReceipt? {
  fleet_host_effective_read_grounded_from_fixture(
    host: operator_host_srv2,
    slice_row: gunbc_srv2_runner_slice_cap_fixture_row,
    unit_rows: fixture_srv2_runner_units_rows(),
    width_row: gunbc_srv2_runner_width_fixture_row,
    probed_at: gunbc_srv2_runner_slice_cap_fixture_row.probed_at,
  )
}

fn fleet_receipt_unit_count(receipt: FleetHostEffectiveReadReceipt) -> Int {
  receipt.runner_units.units.length()
}

fn fleet_receipt_lists_unit(receipt: FleetHostEffectiveReadReceipt, unit: std.types.NonEmptyStr) -> Bool {
  any(receipt.runner_units.units, u => u.unit == unit)
}

fn grounded_receipt_has_observed_v0_knobs(r: FleetHostEffectiveReadGroundedReceipt) -> Bool {
  match r.runner_slice_cap_read {
    ReadObserved { value: _ } => true
    ReadAbsent { reason: _ } => false
  }
    && match r.runner_units_read {
      ReadObserved { value: units } => units.units.length() > 0
      ReadAbsent { reason: _ } => false
    }
    && match r.runner_width_read {
      ReadObserved { value: _ } => true
      ReadAbsent { reason: _ } => false
    }
}
