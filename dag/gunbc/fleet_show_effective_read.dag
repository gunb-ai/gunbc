module gunbc.fleet_show_effective_read


type RunnerSliceCapLiveReadRow {
  slice_unit: NonEmptyStr
  memory_max_raw: String
  probed_at: NonEmptyStr
}

type RunnerSliceCapLiveRead {
  slice_unit: NonEmptyStr
  memory_max: SystemdCgroupMemoryLimit
  probed_at: NonEmptyStr
}

type RunnerWidthLiveReadRow {
  instance_glob: NonEmptyStr
  active_count_raw: String
  probed_at: NonEmptyStr
}

type RunnerWidthLiveRead {
  instance_glob: NonEmptyStr
  active_count: Int
  probed_at: NonEmptyStr
}

type OomPressureLimitLiveReadRow {
  slice_unit: NonEmptyStr
  pressure_limit_raw: String
  probed_at: NonEmptyStr
}

type OomPressureLimitLiveRead {
  slice_unit: NonEmptyStr
  pressure_limit: Percent
  probed_at: NonEmptyStr
}

type FleetRunnerUnitsLiveRead {
  host: HostIdentity
  units: List<RunnerUnitMemoryLiveRead>
}

type FleetHostEffectiveReadReceipt {
  host: HostIdentity
  runner_slice_cap: RunnerSliceCapLiveRead
  runner_units: FleetRunnerUnitsLiveRead
  runner_width: RunnerWidthLiveRead
}

type FleetHostEffectiveReadGroundedReceipt {
  host: HostIdentity
  effective: FleetHostEffectiveReadReceipt
  runner_slice_cap_read: ShowEffectiveRead<RunnerSliceCapEffectiveness>
  runner_units_read: ShowEffectiveRead<FleetRunnerUnitsLiveRead>
  runner_width_read: ShowEffectiveRead<RunnerWidthLiveRead>
  probed_at: NonEmptyStr
}

data gunbc_fleet_show_effective_read_scope_disposition: Disposition = std.disposition.Terminal {
  reason: "Typed READ-ONLY live host-read seam for runner-allocation-v0 (three blocking knobs): (1) runner-slice MemoryMax on system-actions-runner.slice, (2) per-slot MemoryMax+MemorySwapMax on actions-runner@<host>-*.service, (3) runner_width active-unit count. Transport intent lives here; shell realization is scaffold-marked medium-as-string (fleet_show_effective_read_transport_script_scaffold) until host_effect orchestration emit binds grammar rows. Committed ShowEffectiveRead rows stay ReadAbsent until live or fixture-grounded read supplies ReadObserved. ManagedOOMMemoryPressureLimit percent-wire grounding lives in extdeps.os.oomd."
}

data fleet_show_effective_read_transport_script_scaffold: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.live_deploy.emit",
    decl_name: "live_deploy_emit_shell_dissolution_trigger",
    field: WholeDeclaration,
  }
}

fn fleet_runner_unit_property_read_script(unit: NonEmptyStr, property: NonEmptyStr) -> String {
  concat(
    concat(concat("systemctl show \"", unit, "\" --property="), property),
    " --value 2>/dev/null || true"
  )
}

fn runner_unit_live_read_row_from_stdout(
  unit: NonEmptyStr,
  stdout: String,
  probed_at: NonEmptyStr,
) -> RunnerUnitLiveReadRow? {
  let parts = split(s: stdout, delimiter: "\n")
  if length(parts) >= 3 {
    Present {
      value: RunnerUnitLiveReadRow {
        unit: unit,
        memory_max_raw: trim(parts.first()),
        memory_swap_max_raw: trim(parts.skip(n: 1).first()),
        memory_high_raw: trim(parts.skip(n: 2).first()),
        memory_current_raw: "",
        probed_at: probed_at,
      }
    }
  } else {
    none
  }
}

fn runner_unit_memory_live_read_from_stdout(
  unit: NonEmptyStr,
  stdout: String,
  probed_at: NonEmptyStr,
) -> RunnerUnitMemoryLiveRead? {
  match runner_unit_live_read_row_from_stdout(unit: unit, stdout: stdout, probed_at: probed_at) {
    Present { value: row } => Present { value: runner_unit_live_read_typed(row: row) }
    Absent => none
  }
}

fn fleet_runner_unit_memory_read_apply(
  host: HostIdentity,
  unit: NonEmptyStr,
) -> Reconciliation<HostEffectIntent, HostEffectEvidence>? {
  match fleet_host_control_plane(host: host) {
    Present { value: cp } =>
      match fleet_host_ssh_transport(host: host) {
        Present { value: transport } =>
          Present {
            value: host_effect_apply(
              target: cp,
              effect: SystemdUnitMemoryPropertiesRead { unit: unit },
              evidence: host_effect_read_evidence,
              transport: transport,
            )
          }
        Absent => none
      }
    Absent => none
  }
}

fn runner_unit_memory_live_read_from_apply(
  r: Reconciliation<HostEffectIntent, HostEffectEvidence>,
  unit: NonEmptyStr,
  probed_at: NonEmptyStr,
) -> RunnerUnitMemoryLiveRead? {
  match r {
    Converged { evidence: e, applied: _ } =>
      match e {
        ShellEffectApplied { stdout: out, exit_code: _ } =>
          runner_unit_memory_live_read_from_stdout(unit: unit, stdout: out, probed_at: probed_at)
        ConvergePlanApplied { stdout: _, exit_code: _ } => none
      }
    NotConverged { reason: _, applied: _ } => none
  }
}

fn show_effective_read_from_unit_row(
  host: HostIdentity,
  row: RunnerUnitLiveReadRow,
) -> ShowEffectiveRead<FleetRunnerUnitsLiveRead> {
  show_effective_read_from_runner_units(host: host, rows: [row])
}

fn per_slot_memory_cap_verdict_from_unit_read(
  read: RunnerUnitMemoryLiveRead,
  target: ConvergeTarget,
) -> ConvergeVerdict? {
  converge_target_live_verdict(read: read, target: target)
}

fn fleet_runner_width_count_read_script(instance_glob: NonEmptyStr) -> String {
  concat(
    concat("systemctl list-units --type=service --state=active --no-legend \"", instance_glob),
    "\" 2>/dev/null | wc -l | tr -d ' '"
  )
}

