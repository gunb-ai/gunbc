type RunnerSliceCapLiveReadRow {
  slice_unit: NonEmptyStr
  memory_max_raw: String
  probed_at: NonEmptyStr
}

type RunnerSliceCapLiveRead {
  slice_unit: NonEmptyStr
  memory_max: SystemdCgroupMemoryLimit
  probed_at: NonEmptyStr
}

type RunnerWidthLiveReadRow {
  instance_glob: NonEmptyStr
  active_count_raw: String
  probed_at: NonEmptyStr
}

type RunnerWidthLiveRead {
  instance_glob: NonEmptyStr
  active_count: Int
  probed_at: NonEmptyStr
}

type FleetRunnerUnitsLiveRead {
  host: HostIdentity
  units: List<RunnerUnitMemoryLiveRead>
  probed_at: NonEmptyStr
}

type FleetHostEffectiveReadReceipt {
  host: HostIdentity
  runner_slice_cap: RunnerSliceCapLiveRead
  runner_units: FleetRunnerUnitsLiveRead
  runner_width: RunnerWidthLiveRead
}

data gunbc_fleet_show_effective_read_scope_disposition: Disposition = Terminal {
  reason: "Typed live host-read seam for the three runner-allocation-v0 blocking knobs (READ-ONLY): (1) runner-slice MemoryMax on system-actions-runner.slice, (2) per-slot MemoryMax/MemorySwapMax on every active actions-runner@<host>-*.service instance, (3) runner_width active-unit count. Raw systemctl-show / list-units wire values parse into typed rows; fixtures ground ConvergeTarget verdict semantics. Does NOT replace committed ReadAbsent transport nodes (gunbc_runner_slot_show_effective_read, runner_unit_live_read Terminal fixture) — the live fleet transport binds here at the apply increment."
}

