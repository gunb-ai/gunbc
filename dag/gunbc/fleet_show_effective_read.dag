module gunbc.fleet_show_effective_read



type RunnerSliceCapLiveReadRow {
  slice_unit: std.types.NonEmptyStr
  memory_max_raw: String
  probed_at: std.types.NonEmptyStr
}

type RunnerSliceCapLiveRead {
  slice_unit: std.types.NonEmptyStr
  memory_max: extdeps.systemd.SystemdCgroupMemoryLimit
  probed_at: std.types.NonEmptyStr
}

type RunnerWidthLiveReadRow {
  instance_glob: std.types.NonEmptyStr
  active_count_raw: String
  probed_at: std.types.NonEmptyStr
}

type RunnerWidthLiveRead {
  instance_glob: std.types.NonEmptyStr
  active_count: Int
  probed_at: std.types.NonEmptyStr
}

type OomPressureLimitLiveReadRow {
  slice_unit: std.types.NonEmptyStr
  pressure_limit_raw: String
  probed_at: std.types.NonEmptyStr
}

type OomPressureLimitLiveRead {
  slice_unit: std.types.NonEmptyStr
  pressure_limit: std.measure.Percent
  probed_at: std.types.NonEmptyStr
}

type FleetRunnerUnitsLiveRead {
  host: product.placement_supply.HostIdentity
  units: List<gunbc.runner_unit_live_read.RunnerUnitMemoryLiveRead>
}

type FleetHostEffectiveReadReceipt {
  host: product.placement_supply.HostIdentity
  runner_slice_cap: RunnerSliceCapLiveRead
  runner_units: FleetRunnerUnitsLiveRead
  runner_width: RunnerWidthLiveRead
}

type FleetHostEffectiveReadGroundedReceipt {
  host: product.placement_supply.HostIdentity
  effective: FleetHostEffectiveReadReceipt
  runner_slice_cap_read: std.realization_reconcile.ShowEffectiveRead<gunbc.ci_floor_measurement.RunnerSliceCapEffectiveness>
  runner_units_read: std.realization_reconcile.ShowEffectiveRead<FleetRunnerUnitsLiveRead>
  runner_width_read: std.realization_reconcile.ShowEffectiveRead<RunnerWidthLiveRead>
  probed_at: std.types.NonEmptyStr
}

data gunbc_fleet_show_effective_read_scope_disposition: std.disposition.Disposition = std.disposition.Terminal {
  reason: "Typed READ-ONLY live host-read seam for runner-allocation-v0 (three blocking knobs): (1) runner-slice MemoryMax on system-actions-runner.slice, (2) per-slot MemoryMax+MemorySwapMax on actions-runner@<host>-*.service, (3) runner_width active-unit count. systemctl show reads dissolve through extdeps.systemd.systemctl.ShowProperty typed argv (gunbc.systemctl_show_read) — no per-command HostEffect nicknames, no concat shell strings. Committed ShowEffectiveRead rows stay ReadAbsent until live or fixture-grounded read supplies ReadObserved. ManagedOOMMemoryPressureLimit percent-wire grounding lives in extdeps.systemd.oomd."
}

data fleet_show_effective_read_transport_script_scaffold: std.disposition.Disposition = std.disposition.Scaffold {
  dissolves_to: SingleAuthority,
  bind: std.decl_ref.DeclarationRef {
    module_path: "gunbc.live_deploy.emit",
    decl_name: "live_deploy_emit_shell_dissolution_trigger",
    field: WholeDeclaration,
  }
}

fn fleet_runner_unit_memory_live_read(
  host: product.placement_supply.HostIdentity,
  unit: std.types.NonEmptyStr,
  probed_at: std.types.NonEmptyStr,
) -> gunbc.runner_unit_live_read.RunnerUnitMemoryLiveRead? {
  match fleet_host_ssh_transport(host: host) {
    Present { value: transport } =>
      match systemctl_show_property_read(transport: transport, unit: unit, property: MemoryMax) {
        SystemdPropertyCaptured { value: memory_max_raw } =>
          match systemctl_show_property_read(transport: transport, unit: unit, property: MemorySwapMax) {
            SystemdPropertyCaptured { value: memory_swap_max_raw } =>
              match systemctl_show_property_read(transport: transport, unit: unit, property: MemoryHigh) {
                SystemdPropertyCaptured { value: memory_high_raw } =>
                  Present {
                    value: runner_unit_live_read_typed(
                      row: gunbc.runner_unit_live_read.RunnerUnitLiveReadRow {
                        unit: unit,
                        memory_max_raw: memory_max_raw,
                        memory_swap_max_raw: memory_swap_max_raw,
                        memory_high_raw: memory_high_raw,
                        memory_current_raw: "",
                        probed_at: probed_at,
                      }
                    )
                  }
                SystemdPropertyCaptureRefused { reason: _ } => none
              }
            SystemdPropertyCaptureRefused { reason: _ } => none
          }
        SystemdPropertyCaptureRefused { reason: _ } => none
      }
    Absent => none
  }
}

fn fleet_runner_slice_cap_memory_max_raw(
  host: product.placement_supply.HostIdentity,
  slice_unit: std.types.NonEmptyStr,
) -> String? {
  match fleet_host_ssh_transport(host: host) {
    Present { value: transport } =>
      match systemctl_show_property_read(transport: transport, unit: slice_unit, property: MemoryMax) {
        SystemdPropertyCaptured { value: raw } => Present { value: raw }
        SystemdPropertyCaptureRefused { reason: _ } => none
      }
    Absent => none
  }
}

fn runner_unit_live_read_row_from_stdout(
  unit: std.types.NonEmptyStr,
  stdout: String,
  probed_at: std.types.NonEmptyStr,
) -> gunbc.runner_unit_live_read.RunnerUnitLiveReadRow? {
  let parts = split(s: stdout, delimiter: "\n")
  if length(parts) >= 3 {
    Present {
      value: gunbc.runner_unit_live_read.RunnerUnitLiveReadRow {
        unit: unit,
        memory_max_raw: std.algebra.trim(parts.first()),
        memory_swap_max_raw: std.algebra.trim(parts.skip(n: 1).first()),
        memory_high_raw: std.algebra.trim(parts.skip(n: 2).first()),
        memory_current_raw: "",
        probed_at: probed_at,
      }
    }
  } else {
    none
  }
}

fn runner_unit_memory_live_read_from_stdout(
  unit: std.types.NonEmptyStr,
  stdout: String,
  probed_at: std.types.NonEmptyStr,
) -> gunbc.runner_unit_live_read.RunnerUnitMemoryLiveRead? {
  match runner_unit_live_read_row_from_stdout(unit: unit, stdout: stdout, probed_at: probed_at) {
    Present { value: row } => Present { value: runner_unit_live_read_typed(row: row) }
    Absent => none
  }
}

fn show_effective_read_from_unit_row(
  host: product.placement_supply.HostIdentity,
  row: gunbc.runner_unit_live_read.RunnerUnitLiveReadRow,
) -> std.realization_reconcile.ShowEffectiveRead<FleetRunnerUnitsLiveRead> {
  show_effective_read_from_runner_units(host: host, rows: [row])
}

fn per_slot_memory_cap_verdict_from_unit_read(
  read: gunbc.runner_unit_live_read.RunnerUnitMemoryLiveRead,
  target: gunbc.host_converge.ConvergeTarget,
) -> gunbc.host_converge.ConvergeVerdict? {
  converge_target_live_verdict(read: read, target: target)
}

