module gunbc.namespace_cut.migration_kit

import std.types { Bool, Int, List, NonEmptyStr, String }
import std.optional { Optional, Present, Absent }
import std.algebra { length, list_at_optional }
import gunbc.compile_diagnostic_census { CompileDiagnosticCensusRow, census_blocking_rows, census_total_count }
import gunbc.compile_census_probe { ProbeCensusRows, census_rows_for }
import gunbc.namespace_cut.ambient_name_home { AmbientNameHome }
import gunbc.instruments.ambient_name_census_reading { binding_lines, field_at }

// THE NAMESPACE-MIGRATION ACCEPTANCE KIT (Seat 13). The proof shape every ambient-to-declared move repeats,
// as ONE verdict over ONE row of gunbc.namespace_cut.ambient_name_home (name, home, retired_contract): a wave
// supplies its row, never a hand-written claim. No new binding behavior: the producers are the existing
// compile_dag_diagnostic_census (via gunbc.compile_census_probe) and the existing census-reading route.
//
// CHECKS HERE: (1) no-import RED and (2-positive) with-import GREEN as ONE DIFFERENTIAL -- the two sources
// differ on the import axis alone, so the shared closure cancels (the exact form gunbc.compile_diagnostic_census
// names for a census row set) and the kit never authors a census key from a reading. Check 2's exact-identity
// half (target == row.home) needs the binding record, which only the census-reading route prints; it is the
// kit's CliWire label, not a claim. (3) retired contract absent is read by migration_contract_still_present.
// (4) realization by identity is the emit-check label. (5) is the required self-host job, only named.
// (6) no second route is the same differential over a source that ALSO declares a local of the name.
//
// WHERE THE INHABITANCE CLAIM EXECUTES (DESIGN section 3's pairing obligation): the fixtures below are SUPPLIED values
// at resolve's boundary; the REAL path is `gunbc test //gunbc/instruments:namespace-wave-binding-diff`
// (gunbc.instruments.namespace_wave_binding_diff), run by the wave's author on the wave's own PR over the real
// ambient-name-census population (`//gunbc/instruments:ambient-name-census`). It reads the wave's row in
// gunbc.namespace_cut.ambient_name_home ambient_name_homes() and admits only an occurrence that was ambient on base and
// binds row.home on head. Deleting that integration leaves these supplied-value checks green over a world that moved,
// so a wave PR is not accepted on this module alone: it names that run's result beside this module's.
//
// A VERDICT, NOT A BOOL: a claim over a not-yet-migrated name must say WHICH check fired, so the list_push
// reading on main is a located observation and not a bare false.

type KitFinding
  = KitMigrated
  | KitNotRunnable { cause: NonEmptyStr }
  | KitNoImportDoesNotRefuse
  | KitImportDoesNotClear
  | KitSecondRouteBinds

fn kit_call_source(row: AmbientNameHome, imported: Bool) -> String {
  "module probe_migration_kit\n"
    + "import std.types { Int, List }\n"
    + (if imported { "import " + row.home + " { " + row.name + " }\n" } else { "" })
    + "fn probe(xs: List<Int>) -> List<Int> { " + row.name + "(xs, 1) }\n"
}

fn kit_blocking_count(source: String) -> Int? {
  match census_rows_for(source: source) {
    Present { value: p } => Present { value: census_total_count(rows: census_blocking_rows(rows: p.rows)) }
    Absent => Absent
  }
}

// COUNT-BASED, PROVISIONAL (tidy-ant-251, Seat 13 review): a count of blocking rows is a count equality, not an
// identity join (DESIGN section 5), and can pass for the wrong reason (the call never reached). Checks 1 and 2 are
// to read the located binding record of THAT occurrence (BoundAmbient vs BoundToDeclaration{path}) once the
// census-reading label exists; until then these verdicts are provisional.
//
// A BASELINE WITHOUT THE CALL anchors both arms: the unimported call must add blocking rows over it (check 1: the name
// is unbound, not resolved ambiently), and the imported call must add none (check 2). Comparing the two call sources
// to each other is confounded on a not-yet-migrated name, where the import itself refuses and both add rows.
fn kit_baseline_source() -> String {
  "module probe_migration_kit\nimport std.types { Int, List }\nfn probe(xs: List<Int>) -> List<Int> { xs }\n"
}

fn kit_import_differential(row: AmbientNameHome) -> KitFinding {
  match kit_blocking_count(source: kit_baseline_source()) {
    Present { value: base } =>
      match kit_blocking_count(source: kit_call_source(row: row, imported: false)) {
        Present { value: red } =>
          match kit_blocking_count(source: kit_call_source(row: row, imported: true)) {
            Present { value: green } =>
              if red <= base { KitNoImportDoesNotRefuse } else { if green > base { KitImportDoesNotClear } else { KitMigrated } }
            Absent => KitNotRunnable { cause: "census not runnable on the imported source" as NonEmptyStr }
          }
        Absent => KitNotRunnable { cause: "census not runnable on the unimported source" as NonEmptyStr }
      }
    Absent => KitNotRunnable { cause: "census not runnable on the baseline source" as NonEmptyStr }
  }
}

// THE LOCATED-RECORD JUDGE (checks 1 and 2 as an identity join, not a count): over the census's printed lines for the
// fixture module (gunbc.instruments.ambient_name_census_reading), the row for THIS spelling in THIS module is read for
// its source and target. `binding\t<module>\t<spelling>\t<ordinal>\t<source>\t<target>\t<locus>` is resolve's one
// binding record; `binding_unbound\t<module>\t<spelling>\t<locus>` is a refused occurrence. No row at all is
// BindingNotReached, never read as clean.
type BindingReading
  = ReadBoundToDeclaration { target: String }
  | ReadBoundAmbient { source: String, target: String }
  | ReadUnbound
  | ReadNotReached

fn binding_reading(stdout: String, module: String, spelling: String) -> BindingReading {
  let rows = binding_lines(stdout: stdout) |> filter(l => (field_at(line: l, index: 1) == module) && (field_at(line: l, index: 2) == spelling))
  match first(rows) {
    Present { value: l } =>
      if field_at(line: l, index: 4) == "declared" { ReadBoundToDeclaration { target: field_at(line: l, index: 5) } }
      else { ReadBoundAmbient { source: field_at(line: l, index: 4), target: field_at(line: l, index: 5) } }
    Absent =>
      match first(split(s: stdout, delimiter: "\n") |> filter(l => starts_with(s: l, prefix: "binding_unbound\t" + module + "\t" + spelling + "\t"))) {
        Present { value: _ } => ReadUnbound
        Absent => ReadNotReached
      }
  }
}

// Check 1 holds when the unimported occurrence is Unbound; check 2 when the imported one is bound to exactly the
// row's declaration identity (home + "." + name) -- spelling-equal paths of another module do not satisfy it.
fn reading_is_unbound(r: BindingReading) -> Bool {
  match r { ReadUnbound => true  _ => false }
}

fn reading_is_bound_to(r: BindingReading, identity: String) -> Bool {
  match r { ReadBoundToDeclaration { target: t } => t == identity  _ => false }
}

// CHECK 3, RETIRED CONTRACT ABSENT: a source that imports the retired *_contract from std.primitives must add blocking
// rows over a baseline once the row is retired (the import refuses: nothing resolves through it), while a CONTROL
// contract that still exists adds none (the pairing positive: it proves the fixture can import a contract at all, so a
// refusal is about the retired name and not the import shape). A row with no retired_contract has nothing to check.
type ContractFinding
  = ContractNoneRetired
  | ContractAbsent
  | ContractStillPresent
  | ContractControlBroken
  | ContractNotRunnable

fn kit_contract_import_source(contract: String) -> String {
  "module probe_migration_kit_contract\nimport std.types { Int }\nimport std.primitives { " + contract + " }\nfn probe() -> Int { 0 }\n"
}

fn kit_contract_finding(row: AmbientNameHome, control_contract: String) -> ContractFinding {
  match row.retired_contract {
    Absent => ContractNoneRetired
    Present { value: retired } =>
      match kit_blocking_count(source: kit_contract_import_source(contract: control_contract)) {
        Present { value: control } =>
          match kit_blocking_count(source: "module probe_migration_kit_contract\nimport std.types { Int }\nfn probe() -> Int { 0 }\n") {
            Present { value: base } =>
              match kit_blocking_count(source: kit_contract_import_source(contract: retired)) {
                Present { value: probe } =>
                  if control > base { ContractControlBroken } else { if probe > base { ContractAbsent } else { ContractStillPresent } }
                Absent => ContractNotRunnable
              }
            Absent => ContractNotRunnable
          }
        Absent => ContractNotRunnable
      }
  }
}
