module gunbc.namespace_cut.reference_derived_candidate

import std.types { String }

// THE EMIT-RUST REFERENCE-DERIVED CANDIDATE, ONE HOME. v1.compiler.emit_rust produces rows of this
// shape. Its host-bridge consumer, v2.workflow.legacy_repair_tap, was deleted in the census
// retirement (gunbc.design_ruling bad_process_is_worse_than_no_process); the v1 emitter is now the
// only reader, and this module leaves with it.

type ReferenceDerivedCandidateDisposition
  = CandidateSurvived { provider_module: String }
  | CandidateOwnModule
  | CandidateVariantDelegatedToParent { parent_enum: String }
  | CandidateVariantParentUnresolved
  | CandidateRegistryAbsent
  | CandidateLeafAmbiguous
  | CandidateExportProofFailed { provider_module: String }

type ReferenceDerivedCandidateRow {
  module_name: String
  name: String
  disposition: ReferenceDerivedCandidateDisposition
}
