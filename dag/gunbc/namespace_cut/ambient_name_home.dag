module gunbc.namespace_cut.ambient_name_home

import std.types { List, NonEmptyStr, String }
import std.optional { Optional, Absent, optional_present }

// THE ONE ROSTER OF AMBIENT NAMES AND THEIR DECLARED HOMES (NAMESPACE-XL waves; operator ruling
// 2026-10-15: every name the corpus uses, the seed's "built-ins" included, is an ordinary declaration
// in a module that reaches its users by import through the one binding kernel). One row per name a
// wave moves: the name, the declaration that is its one home, the stopgap table the name leaves, and
// whether that home already existed or was minted (and why).
//
// Two consumers read it. The generated import sweep (owned by the #14017 generator's owner) inserts the
// home's import into every module the ambient-name census lists for the name; and the namespace-wave
// binding diff (gunbc.instruments.namespace_wave_binding_diff) admits exactly the re-bindings a row
// names -- an occurrence of `name` that was ambient on base and binds `home` on head -- and refuses
// every other one. A row is added by the wave that moves its name, in that wave's own PR.
//
// The table arms name the v2 tables the waves delete (v2.compiler.resolve AmbientBindingTable). A
// table that is gone takes its arm with it.

type AmbientNameTable
  = KernelTypeSpellingTable
  | KernelCanonicalSymbolTable
  | PrimitiveAuthorityTable
  | CollectionRosterTable

type AmbientNameHomeOrigin
  = ExistingDeclaration
  | MintedDeclaration { reason: NonEmptyStr }

// authored_on_head: the spelling the name's occurrences carry AFTER the wave, when the home declares the operation under
// another name (tidy-ant-251's map_get ruling A: map_get's callers move to std.algebra map_lookup, so each call head is
// rewritten). Absent is the common case: the occurrence keeps its spelling and only its binding moves. When present, the
// binding diff pairs a base occurrence of `name` with the head occurrence of `authored_on_head` that the generator's own
// rename edit put at the same carried position, and admits it only from the primitive-authority table to `home`.
// DECLARED FRONTIER (review 84850): every row here is Absent today. The first Present row is map_get's (authored_on_head
// map_lookup), added by the map_get wave's own change (branch wave/map-lookup-rename) together with the generator's
// RenameHead row that produces the renamed occurrences; until that lands the field's only reader with a Present value is
// the occurrence join's rename controls.

// The call the acceptance kit's fixture pair makes of the name, as TYPED DATA: a probe whose parameters are `params`
// and whose result is `result`, whose body forwards every parameter by name to `name`. A type reference names the
// declaration it means (`home` + `name`), so the fixture's imports are DERIVED from the references and never listed
// beside them. SUPPLIED BY THE WAVE with its row, because a call shape is a fact of the name's signature; it RESTATES
// that signature, a second authority named in gunbc.rung_drop kit_call_shape_restates_the_home_signature and retired
// when a signature reader callable before the census run exists. REQUIRED, not optional: a row without a call shape
// would never observe the name, and one such row would turn the whole label into no-observation for every wave.
type AmbientNameKitType {
  home: NonEmptyStr
  name: NonEmptyStr
  arguments: List<AmbientNameKitType>
}

type AmbientNameKitParam {
  name: NonEmptyStr
  type_ref: AmbientNameKitType
}

type AmbientNameKitCall {
  params: List<AmbientNameKitParam>
  result: AmbientNameKitType
}

type AmbientNameHome {
  name: NonEmptyStr
  home: NonEmptyStr
  table: AmbientNameTable
  origin: AmbientNameHomeOrigin
  // The ambient *_contract row (std.primitives) this move retires, when the name had one; Absent for a name
  // that left a table with no contract row. Read by the namespace-migration acceptance kit's contract-absent check.
  retired_contract: Optional<NonEmptyStr>
  kit_call: AmbientNameKitCall
  authored_on_head: Optional<NonEmptyStr>
}

// One row per wave. Wave 1 (tidy-ant-251's H2/H4 rulings, #14233): chars, answered by the std.primitives authority
// row where it binds at all, has its one declared home in std.host_text.
fn ambient_name_homes() -> List<AmbientNameHome> {
  [
    AmbientNameHome {
      name: "chars",
      home: "std.host_text.chars",
      table: PrimitiveAuthorityTable,
      origin: ExistingDeclaration,
      retired_contract: optional_present(value: "chars_contract" as NonEmptyStr),
      kit_call: chars_kit_call(),
      authored_on_head: Absent
    }
  ]
}

// ROWS A WAVE HAS PROPOSED BUT NOT YET LANDED. The acceptance kit censuses a candidate's fixture pair exactly as it
// does a landed row (ambient_census_kit_rows), so a candidate's checks read RED on main (its name still resolves
// ambiently) and flip when the wave moves it. The wave that lands a candidate adds the row to ambient_name_homes()
// and DELETES it here: a name present in both is read once, as the landed row.
fn ambient_name_candidates() -> List<AmbientNameHome> {
  [AmbientNameHome {
    name: "list_push" as NonEmptyStr,
    home: "std.algebra" as NonEmptyStr,
    table: PrimitiveAuthorityTable,
    origin: ExistingDeclaration,
    retired_contract: optional_present(value: "list_push_contract" as NonEmptyStr),
    kit_call: AmbientNameKitCall {
      params: [
        AmbientNameKitParam { name: "xs" as NonEmptyStr, type_ref: kit_list_of_int() },
        AmbientNameKitParam { name: "x" as NonEmptyStr, type_ref: kit_int() }
      ],
      result: kit_list_of_int()
    },
    authored_on_head: Absent
  }]
}

// chars's one declared home is std.host_text `fn chars(text: HostText) -> List<Char>`; the kit fixture calls it so.
fn chars_kit_call() -> AmbientNameKitCall {
  AmbientNameKitCall {
    params: [AmbientNameKitParam { name: "text" as NonEmptyStr, type_ref: AmbientNameKitType { home: "std.host_text" as NonEmptyStr, name: "HostText" as NonEmptyStr, arguments: [] } }],
    result: AmbientNameKitType { home: "std.types" as NonEmptyStr, name: "List" as NonEmptyStr, arguments: [AmbientNameKitType { home: "std.types" as NonEmptyStr, name: "Char" as NonEmptyStr, arguments: [] }] }
  }
}

fn kit_int() -> AmbientNameKitType {
  AmbientNameKitType { home: "std.types" as NonEmptyStr, name: "Int" as NonEmptyStr, arguments: [] }
}

fn kit_list_of_int() -> AmbientNameKitType {
  AmbientNameKitType { home: "std.types" as NonEmptyStr, name: "List" as NonEmptyStr, arguments: [kit_int()] }
}
