module gunbc.namespace_cut.ambient_name_home

import std.types { List, NonEmptyStr, String }
import std.optional { Optional, optional_present }

// THE ONE ROSTER OF AMBIENT NAMES AND THEIR DECLARED HOMES (NAMESPACE-XL waves; operator ruling
// 2026-10-15: every name the corpus uses, the seed's "built-ins" included, is an ordinary declaration
// in a module that reaches its users by import through the one binding kernel). One row per name a
// wave moves: the name, the declaration that is its one home, the stopgap table the name leaves, and
// whether that home already existed or was minted (and why).
//
// Two consumers read it. The generated import sweep (owned by the #14017 generator's owner) inserts the
// home's import into every module the ambient-name census lists for the name; and the namespace-wave
// binding diff (gunbc.instruments.namespace_wave_binding_diff) admits exactly the re-bindings a row
// names -- an occurrence of `name` that was ambient on base and binds `home` on head -- and refuses
// every other one. A row is added by the wave that moves its name, in that wave's own PR.
//
// The table arms name the v2 tables the waves delete (v2.compiler.resolve AmbientBindingTable). A
// table that is gone takes its arm with it.

type AmbientNameTable
  = KernelTypeSpellingTable
  | KernelCanonicalSymbolTable
  | PrimitiveAuthorityTable
  | CollectionRosterTable

type AmbientNameHomeOrigin
  = ExistingDeclaration
  | MintedDeclaration { reason: NonEmptyStr }

// The call the acceptance kit's fixture pair makes of the name: a probe function of `params` returning `result`
// whose body is `name(args)`, with `std.types` names `type_imports`. SUPPLIED BY THE WAVE with its row, because a
// call shape is a fact of the name's signature, which no fixture template can guess (list_push takes a list and an
// element; map_lookup does not). REQUIRED, not optional: a row without a call shape would make the kit's fixture
// never observe the name, and one such row would turn the whole label into no-observation for every wave.
type AmbientNameKitCall {
  type_imports: NonEmptyStr
  params: NonEmptyStr
  result: NonEmptyStr
  args: NonEmptyStr
}

type AmbientNameHome {
  name: NonEmptyStr
  home: NonEmptyStr
  table: AmbientNameTable
  origin: AmbientNameHomeOrigin
  // The ambient *_contract row (std.primitives) this move retires, when the name had one; Absent for a name
  // that left a table with no contract row. Read by the namespace-migration acceptance kit's contract-absent check.
  retired_contract: Optional<NonEmptyStr>
  kit_call: AmbientNameKitCall
}

// Empty until wave 1 adds its row: wave 0 lands the census and the diff, and moves no name.
fn ambient_name_homes() -> List<AmbientNameHome> {
  []
}

// ROWS A WAVE HAS PROPOSED BUT NOT YET LANDED. The acceptance kit censuses a candidate's fixture pair exactly as it
// does a landed row (ambient_census_kit_rows), so a candidate's checks read RED on main (its name still resolves
// ambiently) and flip when the wave moves it. The wave that lands a candidate adds the row to ambient_name_homes()
// and DELETES it here: a name present in both is read once, as the landed row.
fn ambient_name_candidates() -> List<AmbientNameHome> {
  [AmbientNameHome {
    name: "list_push" as NonEmptyStr,
    home: "std.algebra" as NonEmptyStr,
    table: PrimitiveAuthorityTable,
    origin: ExistingDeclaration,
    retired_contract: optional_present(value: "list_push_contract" as NonEmptyStr),
    kit_call: AmbientNameKitCall {
      type_imports: "Int, List" as NonEmptyStr,
      params: "xs: List<Int>" as NonEmptyStr,
      result: "List<Int>" as NonEmptyStr,
      args: "xs, 1" as NonEmptyStr
    }
  }]
}
