module gunbc.namespace_cut.ambient_name_home

import std.types { List, NonEmptyStr, String }
import std.optional { Optional, Absent }

// THE ONE ROSTER OF AMBIENT NAMES AND THEIR DECLARED HOMES (NAMESPACE-XL waves; operator ruling
// 2026-10-15: every name the corpus uses, the seed's "built-ins" included, is an ordinary declaration
// in a module that reaches its users by import through the one binding kernel). One row per name a
// wave moves: the name, the declaration that is its one home, the stopgap table the name leaves, and
// whether that home already existed or was minted (and why).
//
// Two consumers read it. The generated import sweep (owned by the #14017 generator's owner) inserts the
// home's import into every module the ambient-name census lists for the name; and the namespace-wave
// binding diff (gunbc.instruments.namespace_wave_binding_diff) admits exactly the re-bindings a row
// names -- an occurrence of `name` that was ambient on base and binds `home` on head -- and refuses
// every other one. A row is added by the wave that moves its name, in that wave's own PR.
//
// The table arms name the v2 tables the waves delete (v2.compiler.resolve AmbientBindingTable). A
// table that is gone takes its arm with it.

type AmbientNameTable
  = KernelTypeSpellingTable
  | KernelCanonicalSymbolTable
  | PrimitiveAuthorityTable
  | CollectionRosterTable

type AmbientNameHomeOrigin
  = ExistingDeclaration
  | MintedDeclaration { reason: NonEmptyStr }

// authored_on_head: the spelling the name's occurrences carry AFTER the wave, when the home declares the operation under
// another name (tidy-ant-251's map_get ruling A: map_get's callers move to std.algebra map_lookup, so each call head is
// rewritten). Absent is the common case: the occurrence keeps its spelling and only its binding moves. When present, the
// binding diff pairs a base occurrence of `name` with the head occurrence of `authored_on_head` that the generator's own
// rename edit put at the same carried position, and admits it only from the primitive-authority table to `home`.
// DECLARED FRONTIER (review 84850): every row here is Absent today. The first Present row is map_get's (authored_on_head
// map_lookup), added by the map_get wave's own change (branch wave/map-lookup-rename) together with the generator's
// RenameHead row that produces the renamed occurrences; until that lands the field's only reader with a Present value is
// the occurrence join's rename controls.
type AmbientNameHome {
  name: NonEmptyStr
  home: NonEmptyStr
  table: AmbientNameTable
  origin: AmbientNameHomeOrigin
  authored_on_head: Optional<NonEmptyStr>
}

// One row per wave. Wave 1 (tidy-ant-251's H2/H4 rulings, #14233): chars, answered by the std.primitives authority
// row where it binds at all, has its one declared home in std.host_text.
fn ambient_name_homes() -> List<AmbientNameHome> {
  [
    AmbientNameHome { name: "chars", home: "std.host_text.chars", table: PrimitiveAuthorityTable, origin: ExistingDeclaration, authored_on_head: Absent }
  ]
}
