module gunbc.affected_set_stop_line

import v2.std.text { String }

data affected_set_stop_line_note: String = "7933A temporary safety stop-line (operator recut calm-fox-44, 2026-08-06): when merge-base diff contains any non-docs .dag path, discovery skip admission must NOT skip dag_compile_clean_shard_a_witness_test.dag or dag_compile_clean_scope_witness_test.dag. This is a BROAD interim rule — not precise self-confirmation. It closes the #7915 failure mode (repair touched only dag/extdeps/systems/nvidia.dag and dag/test/claim/generated_artifact_drift_test.dag; import-closure never reached ci_layer_roots; shard_a was selection-skipped). Implementation is ONE hand-Rust bridge in cli_run.rs until 7933B lands (gunbc.plans.affected_set_self_confirmation)."

data repair_receipt_nvidia_path: String = "dag/extdeps/systems/nvidia.dag"

data repair_receipt_generated_artifact_drift_path: String = "dag/test/claim/generated_artifact_drift_test.dag"

data compile_clean_shard_a_validating_entry: String = "dag/test/claim/dag_compile_clean_shard_a_witness_test.dag"

data compile_clean_scope_validating_entry: String = "dag/test/claim/dag_compile_clean_scope_witness_test.dag"

data stop_line_cost_receipt_note: String = "Cost receipt (7933A broad rule): any non-docs .dag PR diff forces at least 2 compile-clean witness entries (shard_a + scope) to remain selection-eligible regardless of import-closure reach — widening vs import-closure-only skip by 2 witness evals per affected PR. Predicate is verdict-touch only (non-empty diff, not all docs/**, any .dag path); no mechanism roster. Executing proof: cargo test -p v1-compiler --lib stop_line (cli_run.rs)."
