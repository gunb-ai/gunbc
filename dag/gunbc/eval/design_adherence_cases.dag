    identity: "command-runner-transport-refusal-exit-code" as NonEmptyStr,
    fetch: pull_request_head_ref(pull_request: 12077),
    finding: DashboardReview { review_id: 70602 },
    frozen_base: sha1(hex: "ece34edae845feeda8c39c03277efb1b9706057e"),
    reference_fix: sha1(hex: "e017e484a596539ea45e960ee6c7d4449b81ecf9"),
