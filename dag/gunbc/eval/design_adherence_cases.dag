module gunbc.eval.design_adherence_cases

import std.types { NonEmptyStr, FilePath }
import std.content_hash { Sha1Digest }
import extdeps.git.object_store { GitObjectId, GitSha1ObjectId }
import gunbc.eval.design_adherence {
  EvalCase, DashboardReview, SideChatReview, pull_request_head_ref,
  DiscriminatingCheck, DesignCheck, MechanicallyGraded, JudgmentOnly,
  ClaimHolds, PatternAbsent, PatternPresent, FromReferenceFix, FromEvalStore,
}

// ONE ROW PER CASE. Each row is one review finding and the commit that fixed it; the frozen base is
// that commit's first parent, and the task is the brief its author was working to -- never the
// finding. Rows are verified in both directions by gunbc.eval.design_adherence_grader
// `validate_reference`: the frozen base must fail the case and the reference fix must pass it.
//
// WHY ONE LIST AND NOT ONE FILE PER CASE. A directory whose files are the membership (the
// recurring_failure_mode pattern) is synthesized into a roster module by seed Rust
// (v1_compiler.cli_run.derived_row_roster); a second such directory would grow the seed, which the
// v1 purpose test does not admit for an eval harness. The cost is that two lanes appending cases
// touch one list; the dissolution is that roster mechanism moving to .dag, after which these rows
// split one file each.

fn sha1(hex: String) -> GitObjectId {
  GitSha1ObjectId { digest: Sha1Digest { hex: hex } }
}

data spark_deforking_cut4_task: NonEmptyStr = "Deforking cut 4 of the GLM/V4.1 calibration program. Put the V4.1 arm behind the same memory wall GLM uses (plan_arm_launch_under_memory_fit) instead of its own path, and derive each bounded experiment's runtime bound from that launch's own facts -- its VLLM_ENGINE_READY_TIMEOUT_S (unset means vLLM's upstream default, cited; set twice or not an integer is refused) and its sequence ceiling -- rather than from GLM's engine-ready figure. Render each bounded-experiment unit's RuntimeMaxSec from that derivation." as NonEmptyStr

data spark_deforking_cut4b_task: NonEmptyStr = "Deforking cut 4b of the GLM/V4.1 calibration program, behaviour-preserving for GLM. The KV roster census in arm_memory_fit must take the checkpoint's expected roster rather than GLM's hybrid shape: model an expected KV roster (expected layout groups -- kind and layer count, the KPool interval, a minimum group count -- and expected allocation-plan censuses, each carrying its own message), make the roster and plan checkers generic over it, and have the cache-fit verdicts and frontier take a roster. Derive GLM's roster from its hybrid shape with the same counts and messages the witnesses pin. V4.1 has no roster yet." as NonEmptyStr

data spark_deforking_cut5_task: NonEmptyStr = "Deforking cut 5 of the GLM/V4.1 calibration program: one promotion step for every serving subject, bound to the exact subject. Model a serving promotion standing over five receipts -- execution compatibility, all-rank memory fit, resolved-layout cache fit, quality on the agentic acceptance set, and workload calibration on the real trace -- each bound to the serving subject key. Quality and calibration compare against the incumbent on the same set and trace. Missing receipts admit a bounded measurement serve and are all named; a refused fit refuses. Hold the thresholds in a promotion policy. Normal serving in plan_arm_launch_under_memory_fit additionally requires the promotion standing; V4.1's capacity report projects into the shared workload calibration receipt." as NonEmptyStr

// task spark_deforking_cut4_task is already declared in design_adherence_cases.dag

data ntfy_acl_readback_task: NonEmptyStr = "Gate approval-code issuance on a live, bound ntfy ACL readback. Read the running ntfy server over the command runner -- its systemd unit, process stat and command line, binary, version, config, auth file and the `ntfy access` listing -- parse the listing into per-principal grants, and refuse issuance unless every modeled join holds (exact config and auth file, deny-all default, operator and publisher grants as declared, no further admin or wildcard reader). A read that could not be performed refuses, naming it." as NonEmptyStr

data native_app_attest_task: NonEmptyStr = "App Attest native row: an instrument gunbc.instruments.native_app_attest (label //gunbc/instruments:native-app-attest) that executes verify_attestation and verify_assertion natively over Apple's published sample rows, one row per sample, with what each fold owes for that sample (the iOS 14.4 sample owes category-absent for both), plus the REDs: tampered nonce, wrong root, wrong App ID, wrong AAGUID and a non-zero attestation counter." as NonEmptyStr

data closure_census_task: NonEmptyStr = "The gen-two door's census must name every file it could not read, not only the first. In v2.compiler.self_host.closure_emission, closure_ingest records each refused file as a ClosureCensusRefusal (its path and located chain) and continues; emission still refuses while any exist. Carry the census refusals on ClosureEmissionLocated, render them as census_refused: [file, reason, at] JSON, and give v2.cli.compile_cli an arm that writes that set and fails with the located chain." as NonEmptyStr

data occurrence_role_task: NonEmptyStr = "XL-2 LoweringOccurrenceProjection PR3a: a v2 occurrence-role producer, v2.compiler.occurrence_role, that records std.occurrence_identity OccurrenceRole and OccurrenceCategory for the names a production binds or labels, by dispatching to the decoders that already find each name (keyword-then-identifier binders, field-init labels, named-argument labels, field-pattern names). Admit the dispatch table against the grammar in both directions with typed refusals naming an unlisted or unknown production; binder productions whose reader has not landed are listed and counted." as NonEmptyStr

data runner_placement_witness_task: NonEmptyStr = "Fix main: runner_placement_witness_test no longer builds after #12289 made the plan index return an Optional; match the indexed Optional. While there, re-derive the two claims that read live fleet facts so they supply the fleet inputs at the placement interfaces they are about instead of executing the live plan." as NonEmptyStr

data clippy_lane_unit_tests_task: NonEmptyStr = "Put the Rust unit tests back on the merge path as a step of the clippy lane in gunbc.compiler_gate_workflow. The step lands non-required (continue-on-error) so it completes once to be measured. Set the clippy job's own timeout to 60 minutes, a margin over the measured 38m25s job, and keep the rust_unit_tests_off_the_merge_path drop Standing." as NonEmptyStr

data bmc_web_model_task: NonEmptyStr = "bmc_model: MegaRAC web session and KVM stream rows plus a protocol adapter. Model the BMC's web world -- its provisioned account, sessions with CSRF tokens, the KVM stream state and other viewers -- with login and KVM transitions, and an adapter (gunbc.bmc_megarac_web_adapter) that explores the worlds reachable from an initial world to a bounded depth without revisiting a world already seen, and emits the resulting transition table as JSON the transport enforces per request." as NonEmptyStr

data approval_capability_parse_task: NonEmptyStr = "Fabric store per-operation admission fold (PR 4a of d0_store_operation_wall). The store verifies an operator-approved write by a receipt the approval broker mints; as part of this, gunbc.auth.approval_capability's parser for a presented capability must decode its base64url MAC strictly, admitting only the canonical encoding (std.encoding) and refusing anything else, before the MAC is compared." as NonEmptyStr

data census_remaster_task: NonEmptyStr = "Hermetic census remaster: pin the Rock Ridge owner, group and mode of the mapped members through typed xorriso path lists (extdeps.provisioning.ubuntu_seeded_install_media_remaster), and gate the census image on cross-host hermeticity and the stock boot chain, including an -lsl listing readback (gunbc.machine_intake.mtcollins1_census_member_readback) of the mapped seed directory and the boot config on the built ISO." as NonEmptyStr

data program_p_arrow_task: NonEmptyStr = "Program P: one Arrow encoding. Cut every producer of the positional-types Arrow [T1..Tn, U] over to the declared-signature encoding (named-binder domain plus declared-order edge) built through v2.std.arrow_signature declared_signature, including v2.std.decl_index export_signature_declared_facts, which lifts the v1 host seam's named domain through it." as NonEmptyStr

data native_import_refusal_task: NonEmptyStr = "Native prepare must name an import target's ingest refusal instead of only 'unbound'. native_module_resolve_verdict gains NativeModuleResolveImportTargetFileRefused, decided only when resolution already refused: if one of the module's captured import rows targets a module whose file the context refused at ingest, the verdict names that refusal first. NativeTestFileRefusal records the module the refused file declares, read from its header line (native_lane_declared_module_name)." as NonEmptyStr

data lexing_layout_task: NonEmptyStr = "Layout in the v2 lexer: the gap question (is there a line break before this token) currently folds over the whole source per question. Derive a per-token line-break index once per stream, in one walk over source and tokens, carried on StreamLayout by its only constructor, so a layout question is a lookup; a line feed inside a token is not layout. The stream digest must cover layout." as NonEmptyStr

data mq1_function_values_task: NonEmptyStr = "MQ-1: function values in value position (lambdas and fn literals) lower to the generic fn Arrow in v2 body lowering, and a type the author did not write becomes a fresh type parameter." as NonEmptyStr
data v2_refinement_obligation_task: NonEmptyStr = "v2: add a refinement-obligation carrier (RefinementObligation, an obligated inferred tree carrying root, facts and obligations) and a discharge step between infer and everything downstream; infer returns the obligated form and every infer caller is cut over, root-first." as NonEmptyStr
data fabric_writer_roster_task: NonEmptyStr = "The fabric served door admits put/advance only for a login in a writer roster derived from the fabric writer-identity observation receipts, and refuses every other writer with a typed refusal." as NonEmptyStr
data v2_parse_stream_layout_task: NonEmptyStr = "v2 parse, PR1 of 2: the token stream carries its line-break layout, derived once from the source at lexing (TokenStream gains an optional StreamLayout), so a production can ask whether a line break precedes a token; add RefuseOnMatch and AfterLineBreak grammar arms." as NonEmptyStr
data gcp_iam_converge_task: NonEmptyStr = "GCP IAM changes by convergence plus one operator approval: plan as iam-observe, file one request keyed by the whole-estate diff, redeem it at the approval broker for a short-lived iam-converge access token, re-plan and refuse if the diff moved, apply, and read back under iam-observe. Render the converge workflow steps from the model." as NonEmptyStr
data v41_engram_touch_counter_task: NonEmptyStr = "V4.1 Engram file-backed lookup: add a distinct-page touch counter (the distinct pages a batch of record-aligned offsets touches) and fetch_rows timing to the per-rank file receipt, with snapshot/reset." as NonEmptyStr
data v41_engram_differential_task: NonEmptyStr = "Design-B Engram cutover: bind the file-backed lookup in the overlay, derive the launch manifest, and add a differential fleet mode that runs only on a host whose occupancy reading shows it free (no GPU compute process, enough available memory per /proc/meminfo)." as NonEmptyStr
data rust_unit_tests_clippy_job_task: NonEmptyStr = "Put the Rust unit tests back on the merge path as a non-required step of the clippy job, running inside a hosted-runner memory cgroup like the heal publisher's, under a job timeout sized from a measured run." as NonEmptyStr
data heal_private_repository_task: NonEmptyStr = "Heal for gunbc-private: parameterise the heal candidate producer and publication over a repository subject, add a second publisher federation pinned to gunbc-private's numeric repository identity (observed 2026-09-27), and correct the gunbai-bot registry rows." as NonEmptyStr
data host_occupancy_admission_task: NonEmptyStr = "Host admission reads occupancy: take an occupancy reading on the host (systemctl is-active per serving unit, nvidia-smi compute processes, /proc/meminfo) and fold it into an admission verdict, so a held Spark host running its pair worker refuses GPU/memory effects; a failed read refuses." as NonEmptyStr
data v41_source_converge_task: NonEmptyStr = "V4.1 source converge: move a tree between patch sets by resetting only a tree this converge owns -- owned either by its recorded worktree diff digest or by content (pin plus a declared patch set reproduces the diff); foreign and untracked changes still refuse." as NonEmptyStr
data floor_scope_references_task: NonEmptyStr = "Floor-scope references: one JSON string authority; qualify cross-module homonyms by containment path. Relocate the forbidden-program fixture out of the dag/ source root and retire its debt rows with a relocation cause naming where the file went; a relocated row whose old path is still under a source root refuses." as NonEmptyStr
data mtcollins1_kvm_observer_task: NonEmptyStr = "mtcollins1 boot: a held KVM viewer observer retains timestamped, hash-bound screen stills as boot evidence; the owned-process launcher stops its child when the pid cannot be published and journals what it observed." as NonEmptyStr

data machine_intake_census_workload_fit_task: NonEmptyStr = "mtcollins1 census: bind the census workload to the boot milestone's one-socket 16 GiB profile (a bounded 2 x 2 GiB EDAC check for the one-socket milestone; keep the dual-socket 4 x 16 GiB shape for the whole-machine expectation). The workload stage preflights MemAvailable and /dev/shm free on the host, refuses before any write when the workload does not fit, records the exact bytes, and the verdict holds the capture to the profile's declared bytes." as NonEmptyStr

data bmc_megarac_web_rows_task: NonEmptyStr = "BMC model: add MegaRAC web session and KVM stream rows to gunbc.bmc_model (sessions, account, login/connect/logout behaviour) and a protocol adapter that answers the MegaRAC web endpoints from the model, so a witness can drive the web session and KVM flows against the modeled BMC instead of hardware." as NonEmptyStr

data live_deploy_safe_directory_task: NonEmptyStr = "live_deploy: srv1 dashboard_deploy refused at tree publication with 'detected dubious ownership' because the deploy principal does not own the deployed checkout. Make that repair a convergence: derive the git safe.directory grant from the deployment's repo root and deploy principal, add it with git config --global --add safe.directory only when absent, read it back, accept only the exact path (an existing '*' refuses), and run it in the apply fold before the deployment effect plan; when it refuses, the apply reports why." as NonEmptyStr

data xl2_census_occurrence_roles_task: NonEmptyStr = "XL-2 LoweringOccurrenceProjection 3b: the reference-conservation census consumes the occurrence-role producer (binders and labels become typed excluded populations instead of locus-erased), sample paths that no longer exist are reported as typed missing paths, and the census sample pins are repinned." as NonEmptyStr

data self_host_behavioral_receipt_series_task: NonEmptyStr = "Self-host behavioral equivalence as a deliberately taken receipt series: add the receipt carrier and a persisted series, a gunbc test label row as the taker (//gunbc/instruments:self-host-behavioral-equivalence), and bind the interlock so the SelfHostBehavioralEquivalenceReestablished milestone derives its standing from the latest receipt in the series (identity-joined to the behavioral transport roster) instead of being NotDerivable." as NonEmptyStr

data fabric_store_admission_fold_task: NonEmptyStr = "Fabric store per-operation admission fold (d0_store_operation_wall PR 4a): the fabric store admits each write operation through one fold that verifies the operator-approval receipt minted by the approval broker (an approval_capability envelope with the fabric store as audience) against the store receipt key, alongside the existing capability verification, refusing per cause." as NonEmptyStr

data function_value_body_task: NonEmptyStr = "FunctionValueBody: admit a function whose body is a function value -- add the ArrowBodyForm arm, give every reader of the body form a disposition for it, and make the body-lowering route infer such functions (direct and curried) with a typed refusal where the body cannot be inferred." as NonEmptyStr

data refinement_carrier_widening_task: NonEmptyStr = "v2: coercion admits a cast from a refinement to its DECLARED carrier (x as Int from x: Pos, type Pos = Int where positive) as Widened. Add an infer reader that goes from a reference to its refinement declaration by the reference's own path down the containment spine, one reader for this cast and the later literal-into-refinement producer; coercion_cast_crossing takes the source's declared carrier; a non-carrier target refuses with the original mismatch; lower a where-refined head as a type." as NonEmptyStr

data approval_store_receipt_mint_task: NonEmptyStr = "Approval broker mints fabric-store receipts over recorded approvals (d0_store_operation_wall PR 3b): in gunbc.auth.approval_store_receipt, mint a receipt (approval_capability envelope, audience = the fabric store) from a decided approval and its generation-1 filing, refusing per remedy (not filed, pending, denied, another attempt, another revision, no filing, no key); add store-side verification and the POST /approvals/<id>/store-receipt broker answer, authenticated by a submission-key MAC before any read." as NonEmptyStr

data serializer_std_layout_task: NonEmptyStr = "Serializer layout from std.layout: TargetText becomes a flat std.layout document and the EmitLayout token classes carry line breaks and indents; nesting is a grammar occurrence wrapped in std.layout nesting, where a producer may name its own indent unit; Verilog consumes it." as NonEmptyStr

data host_effect_label_residue_task: NonEmptyStr = "Host-effect release and recovery over a lane-supplied observation leg, with docker labels and a memory cap: extdeps.docker.cli gains labels, a ps-by-label filter and --memory/--memory-swap on ephemeral runs; the v41 runtime-image probe labels its container, declares its container residue by that label (and its process residue), runs capped, and claims and releases over the administrator context." as NonEmptyStr

data census_iso_member_readback_task: NonEmptyStr = "mtcollins1 census: read vmlinuz, initrd and grub.cfg out of the pinned stock and census ISOs on srv2 over fleet SSH (a census member readback, grub.cfg as the in-run discriminating control) using xorriso extraction run remotely, plus the module-identity census build input and the kernel-module decompression-refusal observation." as NonEmptyStr

data emit_module_member_fold_task: NonEmptyStr = "v2 emit: every module member has one target realization or one typed refusal. Decide each direct member of a module body once -- a bodied Arrow through the produced-decl rows, a plain Disj coproduct through emit_semantic_type_decl, every other kind its own located refusal -- fold the members in source order refusing on the first unrealized one, and route module emission through that member fold so coproducts emit beside functions." as NonEmptyStr

data arrow_order_edge_admission_task: NonEmptyStr = "A4: a Named-binder Arrow domain without its order edge is ill formed at Node admission. v2.std.node's order-conformance check answers an absent order edge by whether the Arrow's domain binds a name; infer gates its entry on well-formedness as resolve and the assemble root gate already do; migrate the remaining order-less producers; RED and positive controls on all three paths." as NonEmptyStr

data design_adherence_cases: List<EvalCase> = [

  EvalCase {
    identity: "spark-ready-timeout-default-unit" as NonEmptyStr,
    fetch: pull_request_head_ref(pull_request: 12979),
    finding: DashboardReview { review_id: 74213 },
    frozen_base: sha1(hex: "72610823af4133d2ea53649ab3dfe1c460ad64f0"),
