module gunbc.publication_grant

import std.types { CommitSha, FilePath, List, String }
import std.access {
  AccessDecision, AccessPolicy, AccessRequest,
  Permit, Deny, AccessRefusal, AccessRefusalLocation, AccessActionNotGranted,
}
import std.authorization_profile {
  AudienceSet, UniversalAudience,
  PublicationAdmissionAction, PublicationContext,
  PublicationAdmissionRequest, publication_access_request,
  audience_subset,
}
import gunbc.principal_projection { GunbcPrincipal }
import gunbc.publication_cutover {
  public_publication_root, public_publication_cutover_sha,
}

data publication_grant_note: String = "Stage-0 public-root publication roster. The one baseline row bulk-stamps every path already present at its exact cutover commit for the universal audience; each file first added after that commit needs one explicit PublicFilePublishGrant row. The gunbc#7541 Envelope + Verb::Publish + AudienceScopeTree carrier is dissolved. A row now carries PublicationAudienceGrant evidence, constructs std.authorization_profile.PublicationAdmissionRequest, projects it to std.access.AccessRequest, and asks public_publication_policy at the one AccessPolicy decision seam. The public checkout remains the only mounted root; this carrier introduces no authored principal or role."

type PublicPublicationContext {
  root: FilePath
}

type PublicPlacementPolicySubject {}

type PublicPlacementSource {
  root: FilePath
}

type PublicationAudienceGrant<P> {
  audience: AudienceSet<P>
}

type PublicRootPublishBaseline {
  root: FilePath
  cutover: CommitSha
  grant: PublicationAudienceGrant<GunbcPrincipal>
}

type PublicFilePublishGrant {
  path: FilePath
  grant: PublicationAudienceGrant<GunbcPrincipal>
}

type PublicPublicationGrantRoster {
  baseline: PublicRootPublishBaseline
  file_grants: List<PublicFilePublishGrant>
}

fn public_audience() -> AudienceSet<GunbcPrincipal> {
  UniversalAudience
}

fn public_publication_request(
  resource: FilePath,
  root: FilePath,
  grant: PublicationAudienceGrant<GunbcPrincipal>,
) -> PublicationAdmissionRequest<PublicPlacementPolicySubject, PublicPlacementSource, FilePath, PublicPublicationContext, PublicationAudienceGrant<GunbcPrincipal>, GunbcPrincipal> {
  PublicationAdmissionRequest {
    subject: PublicPlacementPolicySubject {},
    source: PublicPlacementSource { root: root },
    resource: resource,
    audience: public_audience(),
    context: PublicPublicationContext { root: root },
    evidence: grant,
  }
}

fn public_publication_decide(
  request: AccessRequest<PublicPlacementPolicySubject, PublicationAdmissionAction<PublicPlacementSource>, FilePath, PublicationContext<PublicPublicationContext, GunbcPrincipal>, PublicationAudienceGrant<GunbcPrincipal>>,
) -> AccessDecision {
  if audience_subset(
    left: request.context.value.audience,
    right: request.evidence.value.audience,
  ) {
    Permit
  } else {
    Deny {
      refusal: AccessRefusal {
        cause: AccessActionNotGranted { action: "publication" },
        location: AccessRefusalLocation {
          profile: "PublicationAdmissionRequest",
          subject: request.object,
          action: "publication",
          object: request.context.value.context.root,
        },
      }
    }
  }
}

data public_publication_policy: AccessPolicy<PublicPlacementPolicySubject, PublicationAdmissionAction<PublicPlacementSource>, FilePath, PublicationContext<PublicPublicationContext, GunbcPrincipal>, PublicationAudienceGrant<GunbcPrincipal>> = AccessPolicy { decide: public_publication_decide }

fn decide_publication_request(
  request: PublicationAdmissionRequest<PublicPlacementPolicySubject, PublicPlacementSource, FilePath, PublicPublicationContext, PublicationAudienceGrant<GunbcPrincipal>, GunbcPrincipal>,
) -> AccessDecision {
  public_publication_policy.decide(publication_access_request(request: request))
}

fn publish_public_audience_grant() -> PublicationAudienceGrant<GunbcPrincipal> {
  PublicationAudienceGrant { audience: public_audience() }
}

data public_root_publish_baseline: PublicRootPublishBaseline = PublicRootPublishBaseline {
  root: public_publication_root,
  cutover: public_publication_cutover_sha,
  grant: publish_public_audience_grant(),
}

fn public_file_publish_grant(path: FilePath) -> PublicFilePublishGrant {
  PublicFilePublishGrant {
    path: path,
    grant: publish_public_audience_grant(),
  }
}

