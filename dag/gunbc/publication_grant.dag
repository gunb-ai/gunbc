module gunbc.publication_grant

import std.types { CommitSha, FilePath, List, String }
import std.effect_grant {
  Publish,
  Envelope, Grant, RealTransport, LifecycleByConstruction,
}
import std.materialization_ladder { Frame, SharedStateFrame }
import std.visibility_grant { world_audience }
import gunbc.publication_cutover {
  public_publication_root, public_publication_cutover_sha,
}

data publication_grant_note: String = "Stage-0 public-root publication roster (docs/plans/node-subtree-visibility-grants.md section 6, P-B public half). The one baseline row bulk-stamps every path already present at its exact cutover commit Publish World; it does not mint thousands of per-file declarations. Post-cutover policy is declared at subtree grain: each SubtreePublishGrant supplies the inherited default for every descendant, and tools.publication_placement_gate resolves the nearest covering ancestor while enforcing Rule 2's downward closure. The six established repository directory roots are Publish World; a novel top-level root has no covering declaration and therefore refuses fail-closed. Both baseline and subtree rows carry the existing std.effect_grant.Envelope, and the placement gate asks std.effect_grant.admit_effect(Publish, world_audience) -- this carrier never owns a second admission rule. PROVISIONAL CARRIER DISPOSITION (operator directive 2026-08-01): the Publish verb and audience-tree request shape consumed here are frozen provisional, not the permanent publication authorization ontology; this placement gate is expected to re-home its request onto a PublicationAdmissionRequest profile over the std.access AccessRequest/AccessPolicy/decision_meet kernel when the kernel/profile grounding pass lands. This roster remains only the declared-placement-policy input and introduces no identity, principal, role, or broader audience model. The public checkout is the only mounted root in this stage. Private-root and composed-graph closure are deliberately absent and arrive at P-C."

type PublicRootPublishBaseline {
  root: FilePath
  cutover: CommitSha
  envelope: Envelope
}

type SubtreePublishGrant {
  root: FilePath
  envelope: Envelope
}

type PublicPublicationGrantRoster {
  baseline: PublicRootPublishBaseline
  subtree_grants: List<SubtreePublishGrant>
}

fn publication_frame(name: String) -> Frame {
  Frame { name: name, kind: SharedStateFrame }
}

fn publish_world_envelope(frame_name: String) -> Envelope {
  Envelope {
    frame: publication_frame(name: frame_name),
    grants: [Grant {
      verb: Publish,
      root: world_audience(),
      binding: RealTransport,
      lifecycle: LifecycleByConstruction,
    }],
  }
}

data public_root_publish_baseline: PublicRootPublishBaseline = PublicRootPublishBaseline {
  root: public_publication_root,
  cutover: public_publication_cutover_sha,
  envelope: publish_world_envelope(frame_name: "public-root-cutover"),
}

fn subtree_publish_world_grant(root: FilePath) -> SubtreePublishGrant {
  SubtreePublishGrant {
    root: root,
    envelope: publish_world_envelope(frame_name: root),
  }
}

data public_subtree_publish_grants: List<SubtreePublishGrant> = [
  subtree_publish_world_grant(root: ".cargo"),
  subtree_publish_world_grant(root: ".githooks"),
  subtree_publish_world_grant(root: ".github"),
  subtree_publish_world_grant(root: "dag"),
  subtree_publish_world_grant(root: "docs"),
  subtree_publish_world_grant(root: "src"),
]

data public_publication_grant_roster: PublicPublicationGrantRoster = PublicPublicationGrantRoster {
  baseline: public_root_publish_baseline,
  subtree_grants: public_subtree_publish_grants,
}
