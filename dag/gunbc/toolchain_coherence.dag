module gunbc.toolchain_coherence

import std.types { String, NonEmptyStr, List, Bool }
import std.content_hash {
  ContentHash,
  ContentHashComparison,
  ContentHashEqual,
  ContentHashDifferent,
  ContentHashCrossFamilyIncomparable,
  compare_content_hash,
}
import extdeps.realization.emit_on_demand_host { ObservedToolIdentity }
import gunbc.build_cache_instance { RunnerSlotIdentity }
import v2.std.optional { Present, Absent }

// THE SUBJECT IS ONE SPAWN, NOT ONE JOB, and that grain is the whole point of the carrier. A job
// that spawns rustfmt eleven times has eleven opportunities to exec different bytes, so a
// job-grained receipt would report a coherence it never established -- the denominator error where
// a fact about a population is asserted from a sample of one. The digest is taken AT SPAWN and
// travels with the observation, rather than being resolved once and looked up later: resolving a
// pathname and re-launching it afterwards is the defect this carrier exists to detect, so a shape
// that permits it would be the defect wearing a receipt.
type ToolchainSpawn {
  pass: NonEmptyStr
  slot: RunnerSlotIdentity
  observed: ObservedToolIdentity
}

// NOT-EVALUATED IS REACHED BY CONSTRUCTION, NEVER BY REMEMBERING TO SET IT. The empty observation
// list folds to ToolchainNeverObserved because that is what the fold's base case IS, so absence of
// evidence cannot render as agreement. That direction is the fail-closed one: a masked run and a
// clean run must not produce the same value, and today's standing -- nothing establishes that
// successive spawns reached the same bytes -- is honestly NotEvaluated rather than passed.
//
// THE CAUSES ARE NOT COLLAPSED, and the split is not cosmetic: "we could not tell" and "we checked
// and they differed" have opposite remedies. Incomparable is its own cause rather than a silent
// false because std.content_hash refuses to collapse a cross-family pair -- comparing an fnv1a64
// fingerprint against a sha256 digest establishes nothing about the bytes, and reporting that as
// "differed" would manufacture a finding while reporting it as "equal" would manufacture a pass.
type ToolchainCoherenceUnevaluated
  = ToolchainNeverObserved
  | ToolchainIdentityIncomparable { tool_name: NonEmptyStr }

// DIFFERED IS A FINDING AND SITS BESIDE NotEvaluated RATHER THAN INSIDE IT. It is the one arm that
// says the shared mutable path actually bit: two spawns of one tool in one pass reached different
// bytes. Folding it into NotEvaluated would lose exactly the signal the carrier was built to carry.
type ToolchainCoherence
  = ToolchainCoherenceNotEvaluated { cause: ToolchainCoherenceUnevaluated }
  | ToolchainIdentitiesDiffered { tool_name: NonEmptyStr }
  | ToolchainIdentitySingle { tool_name: NonEmptyStr }

// THE SCAN IS EXPLICIT RECURSION rather than a fold, and the reason is short-circuit: the first
// divergence decides the verdict, so a fold would keep comparing hashes after the answer is fixed.
// An earlier revision of this note claimed the corpus had no lambda-taking fold. That was false --
// std.graph and std.markdown both use one -- and it is corrected rather than softened, because a
// note asserting a corpus-wide absence is a claim about a population nobody measured.
fn toolchain_coherence_scan(
  spawns: List<ToolchainSpawn>,
  baseline: ContentHash,
  tool: NonEmptyStr
) -> ToolchainCoherence {
  match spawns.first() {
    Absent => ToolchainIdentitySingle { tool_name: tool }
    Present { value: s } =>
      match compare_content_hash(left: baseline, right: s.observed.observed_identity) {
        ContentHashDifferent => ToolchainIdentitiesDiffered { tool_name: tool }
        ContentHashCrossFamilyIncomparable =>
          ToolchainCoherenceNotEvaluated {
            cause: ToolchainIdentityIncomparable { tool_name: tool }
          }
        ContentHashEqual =>
          toolchain_coherence_scan(
            spawns: spawns.skip(n: 1),
            baseline: baseline,
            tool: tool
          )
      }
  }
}

fn toolchain_coherence_of(spawns: List<ToolchainSpawn>) -> ToolchainCoherence {
  match spawns.first() {
    Absent => ToolchainCoherenceNotEvaluated { cause: ToolchainNeverObserved }
    Present { value: head } =>
      toolchain_coherence_scan(
        spawns: spawns.skip(n: 1),
        baseline: head.observed.observed_identity,
        tool: head.observed.tool_name
      )
  }
}
