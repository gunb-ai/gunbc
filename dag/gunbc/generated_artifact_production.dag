module gunbc.generated_artifact_production

import std.types { String, List, Bool }
import std.optional { Present, Absent }
import gunbc.generated_artifact { GeneratedArtifact }

type ArtifactGenerationOutcome
  = ArtifactGenerated { content: String }
  | ArtifactGenerationRefused { reason: String }

type GeneratedWorkflowProvenance {
  generator: String
  authority: String
}

type GeneratedArtifactProduction {
  artifact: GeneratedArtifact
  generate: fn() -> ArtifactGenerationOutcome
  extra_valid: fn(ArtifactGenerationOutcome) -> Bool
  provenance: GeneratedWorkflowProvenance?
}

type GeneratedWorkflowProvenanceHeader
  = GeneratedWorkflowProvenanceHeaderProduced { content: String }
  | GeneratedWorkflowProvenanceHeaderNotApplicable

fn artifact_always_valid(_generated: ArtifactGenerationOutcome) -> Bool {
  true
}

fn artifact_generation_produced(generated: ArtifactGenerationOutcome) -> Bool {
  match generated {
    ArtifactGenerated { content: _ } => true
    ArtifactGenerationRefused { reason: _ } => false
  }
}

fn workflow_body_generated(content: String) -> ArtifactGenerationOutcome {
  if string_contains(s: content, pattern: "__GUNBC_INVOKE_EMIT_REFUSED__") {
    ArtifactGenerationRefused {
      reason: "generated workflow embeds a __GUNBC_INVOKE_EMIT_REFUSED__ emission refusal marker: a run-step target could not be rendered (word wall, orchestration refusal, or a module deriving no storage path through gunbc.source_layout layout_module_storage_path); the marker line in the generated bytes names the refused word or row, sanitized through the emitter shell alphabet; refusing rather than committing a workflow whose step was refused (gunbc.design_argument::fail_closed)"
    }
  } else {
    ArtifactGenerated { content: content }
  }
}

fn generated_workflow_provenance_header(provenance: GeneratedWorkflowProvenance?) -> GeneratedWorkflowProvenanceHeader {
  match provenance {
    Absent => GeneratedWorkflowProvenanceHeaderNotApplicable
    Present { value: p } => GeneratedWorkflowProvenanceHeaderProduced {
        content: join([
          concat("# Generated by ", concat(p.generator, " — do not hand-edit.")),
          concat("# Authority: ", concat(p.authority, "; regen via gunbc.instruments.generated_artifact_gate main_wet.")),
          ""
        ], "\n")
      }
  }
}
