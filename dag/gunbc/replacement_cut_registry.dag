module gunbc.replacement_cut_registry

import std.types { List }
import gunbc.replacement_cut {
  CutRegistration,
  CutRegistryStanding,
  admit_cut_registry,
}
import gunbc.interpreter_replacement_cut { interpreter_cut_registration }
import gunbc.endpoint_authority_replacement_cut { endpoint_authority_cut_registration }

// THE PRODUCTION CUT REGISTRY. This is the join that gunbc.replacement_cut's
// replacement_cut_unjoined_parent_rung_note named as its next-rung trigger: an existence check for
// DescendedFromRefusedCut.parent_cut needs a registry of authored cuts to consult, and this is it.
//
// WHY THE ROWS LIVE HERE AND THE MECHANISM LIVES IN gunbc.replacement_cut: the mechanism cannot
// import the cuts, because the cuts import the mechanism. Homing the rows under either cut module
// would fork the registry across the two, and homing them in the carrier would close that fork into
// an import cycle -- which the compiler refuses. So the placement is the acyclicity law of DESIGN §3
// rather than a preference.
//
// WHAT REGISTRATION DOES AND DOES NOT ESTABLISH. Membership here makes an identity RESOLVABLE, so a
// descent naming it stops being an unjoined string. It does not establish that the registry is
// COMPLETE: nothing walks the corpus for authored ReplacementCut values absent from this list, so a
// cut authored and never registered is invisible to the join, in exactly the way an omitted consumer
// is invisible to plan admission. That completeness producer is the declared next rung.
data replacement_cut_registry_note: String = "Two registrations, and they are deliberately in different arms. cut-router-endpoint-authority is RegisteredExactCut: authored at declaration grain, its plan admissible or refusable on its own terms. cut-v1-interpreter is RegisteredCutRemeasureRequired: its survey was authored at module-or-binary grain over a ten-of-125 sample, which the re-grounding of BoundaryConsumer onto declaration-grain relations made structurally unable to inhabit the exact carrier. Keeping both under one identity space is what lets a future descent name the interpreter boundary and refuse as RegistryParentRemeasureRequired -- the boundary was noticed, no exact plan exists at it -- rather than as RegistryParentAbsent, which would say the boundary is unknown. Those are different facts with different remedies and the registry is the only place they are distinguishable."

fn production_replacement_cuts() -> List<CutRegistration> {
  [
    interpreter_cut_registration(),
    endpoint_authority_cut_registration(),
  ]
}

fn production_registry_standing() -> CutRegistryStanding {
  admit_cut_registry(rs: production_replacement_cuts())
}
