module gunbc.design.gunb_ai_hues

import std.types { String, Int, List }
import std.optional { Optional, Absent, Present }
import extdeps.color.srgb { Srgb8 }
import extdeps.languages.css.values {
  CssHsl, CssColorComponent, ComponentVar, ComponentPercent, CssVarRef, CssDecimal,
}
import gunbc.design.palette {
  Swatch, SwatchSet, SwatchSetProvenance, SwatchMember,
  swatch_filed, swatches_of, swatch_set_admissible,
}

// Pick A, relayed from the operator 2026-10-16 (gunb.ai projection lane,
// docs/plans carrier `gunbc.plans.gunb_ai_projection_plan` §6): gunbc.design.palette
// gains gunb.ai's four hue families as named swatches so palette is the site's ONLY
// colour authority and the live look is unchanged. Names describe the colour, not the
// use — so a redesign renaming site usage never renames a swatch. Values are the live
// page's HSL ramp, projected once into Srgb8: re-derive any of them from
// gunb-ai/frontend's :root block (`grep -A40 ':root' assets/site.css`), never from
// this file's comments. When the redesign retunes a hue, the edit is HERE — swatch is
// the single value home (DESIGN §3). Consumer: gunbc.site.gunb_ai_tokens, which binds
// each of these into the site token set; nothing else imports this module (DESIGN §3c).

data gunb_ai_hues_provenance: SwatchSetProvenance = HouseAuthored {
  note: "The four live gunb.ai hue families (warm/umber-sand neutrals, moss, clay, brass) plus their in-family steps, lifted from the hand-maintained site's :root block so palette becomes the only colour authority. Operator pick A 2026-10-16; values track the live look and move when the redesign retunes them.",
}

data near_black: Swatch = Swatch { name: "near-black", color: Srgb8 { r: 13, g: 13, b: 13 } }
data soot: Swatch = Swatch { name: "soot", color: Srgb8 { r: 21, g: 21, b: 20 } }
data graphite: Swatch = Swatch { name: "graphite", color: Srgb8 { r: 29, g: 28, b: 27 } }

data sand: Swatch = Swatch { name: "sand", color: Srgb8 { r: 206, g: 197, b: 182 } }
data taupe: Swatch = Swatch { name: "taupe", color: Srgb8 { r: 154, g: 143, b: 126 } }
data umber: Swatch = Swatch { name: "umber", color: Srgb8 { r: 107, g: 99, b: 87 } }
data warm_white: Swatch = Swatch { name: "warm-white", color: Srgb8 { r: 244, g: 241, b: 236 } }
data off_white: Swatch = Swatch { name: "off-white", color: Srgb8 { r: 228, g: 223, b: 216 } }

data moss: Swatch = Swatch { name: "moss", color: Srgb8 { r: 78, g: 166, b: 99 } }
data moss_deep: Swatch = Swatch { name: "moss-deep", color: Srgb8 { r: 59, g: 125, b: 74 } }
data clay: Swatch = Swatch { name: "clay", color: Srgb8 { r: 166, g: 83, b: 78 } }
data clay_deep: Swatch = Swatch { name: "clay-deep", color: Srgb8 { r: 125, g: 62, b: 59 } }
data brass: Swatch = Swatch { name: "brass", color: Srgb8 { r: 178, g: 155, b: 98 } }
data brass_deep: Swatch = Swatch { name: "brass-deep", color: Srgb8 { r: 131, g: 114, b: 73 } }

data gunb_ai_hue_members: List<SwatchMember> = [
  swatch_filed(sw: near_black),
  swatch_filed(sw: soot),
  swatch_filed(sw: graphite),
  swatch_filed(sw: sand),
  swatch_filed(sw: taupe),
  swatch_filed(sw: umber),
  swatch_filed(sw: warm_white),
  swatch_filed(sw: off_white),
  swatch_filed(sw: moss),
  swatch_filed(sw: moss_deep),
  swatch_filed(sw: clay),
  swatch_filed(sw: clay_deep),
  swatch_filed(sw: brass),
  swatch_filed(sw: brass_deep),
]

// The page-chrome black, distinct from near_black on purpose. The served page's
// <meta name="theme-color"> is #0c0d0c (12,13,12) while its --void background is hsl(37,0%,5%) =
// (13,13,13) = near_black above; both were read off the live page 2026-10-18. Collapsing them into
// one swatch would silently change what the browser paints in the address bar, so the difference is
// kept as data.
//
// It is a row rather than a member of gunb_ai_hues because that set's completeness rule
// (gunbc.site.gunb_ai_tokens.token_binding_complete) ranges over every member and requires each to
// be bound to a token role — and this colour is not a custom property, it is the chrome colour one
// meta tag carries, so binding it to a --gunb-* role would model a consumer that does not exist.
// CONSUMER (§3c): gunbc.site.gunb_ai_page reads it through gunbc.design.palette.swatch_paint to
// fill <meta name="theme-color">; it is not filed in a SwatchSet because nothing would read the set.
data theme_chrome_black: Swatch = Swatch { name: "theme-chrome-black", color: Srgb8 { r: 12, g: 13, b: 12 } }

data gunb_ai_hues: SwatchSet = SwatchSet {
  name: "gunb-ai-hues",
  provenance: gunb_ai_hues_provenance,
  members: gunb_ai_hue_members,
}

fn gunb_ai_hues_admissible() -> Bool {
  swatch_set_admissible(s: gunb_ai_hues)
}

// The seal's body paint, as gunb.ai's assets/mark.svg fills it (#f4efe6, read off the served file
// 2026-10-19). It is NOT warm_white (#f4f1ec): the two differ in green and blue, and the favicon's
// seal reads warmer than the page's text, so collapsing them would repaint the tab icon. Like
// theme_chrome_black it is a row outside gunb_ai_hues, because it is not a --gunb-* role.
// CONSUMER (§3c): gunbc.site.gunb_ai_mark reads it through gunbc.design.palette.swatch_paint.
data seal_white: Swatch = Swatch { name: "seal-white", color: Srgb8 { r: 244, g: 239, b: 230 } }

// THE LIVE RAMP AS PARAMETERS. The served stylesheet does not spell its colours as sRGB; it spells
// four hue angles and two accent percentages once and writes every colour as hsl()/hsla() over
// var(--hue-*) references, so retuning a family is one number. The rows below ARE those values
// (read off the served assets/site.css :root block 2026-10-19), in the form the stylesheet needs.
// They are not the Srgb8 swatches above: the swatches are the gunb_ai_tokens binding's one-time
// projection, and the two disagree where the projection rounded or where gunb_ai_tokens chose a
// different step. The disagreements are listed in the PR that introduced these rows; reconciling
// them is a separate decision. CONSUMER (§3c): gunbc.site.gunb_ai_css.

type HueParameter {
  name: String
  magnitude: Int
}

data live_hue_warm: HueParameter = HueParameter { name: "hue-warm", magnitude: 37 }
data live_hue_moss: HueParameter = HueParameter { name: "hue-moss", magnitude: 134 }
data live_hue_clay: HueParameter = HueParameter { name: "hue-clay", magnitude: 3 }
data live_hue_brass: HueParameter = HueParameter { name: "hue-brass", magnitude: 43 }

data live_accent_saturation: HueParameter = HueParameter { name: "accent-sat", magnitude: 36 }
data live_accent_lightness: HueParameter = HueParameter { name: "accent-l", magnitude: 48 }

type LiveColorToken {
  name: String
  color: CssHsl
}

fn live_var(name: String) -> CssColorComponent {
  ComponentVar { reference: CssVarRef { name: name } }
}

fn live_pct(n: Int) -> CssColorComponent {
  ComponentPercent { n: n }
}

fn live_color(hue: HueParameter, saturation: CssColorComponent, lightness: CssColorComponent) -> CssHsl {
  CssHsl { hue: live_var(name: hue.name), saturation: saturation, lightness: lightness, alpha: Absent }
}

fn live_color_alpha(hue: HueParameter, saturation: CssColorComponent, lightness: CssColorComponent, milli: Int) -> CssHsl {
  CssHsl { hue: live_var(name: hue.name), saturation: saturation, lightness: lightness, alpha: Present { value: CssDecimal { milli: milli } } }
}

data live_color_tokens: List<LiveColorToken> = [
  LiveColorToken { name: "moss", color: live_color(hue: live_hue_moss, saturation: live_var(name: live_accent_saturation.name), lightness: live_var(name: live_accent_lightness.name)) },
  LiveColorToken { name: "moss-dim", color: live_color(hue: live_hue_moss, saturation: live_var(name: live_accent_saturation.name), lightness: live_pct(n: 36)) },
  LiveColorToken { name: "moss-subtle", color: live_color_alpha(hue: live_hue_moss, saturation: live_var(name: live_accent_saturation.name), lightness: live_var(name: live_accent_lightness.name), milli: 140) },
  LiveColorToken { name: "clay", color: live_color(hue: live_hue_clay, saturation: live_var(name: live_accent_saturation.name), lightness: live_var(name: live_accent_lightness.name)) },
  LiveColorToken { name: "clay-dim", color: live_color(hue: live_hue_clay, saturation: live_var(name: live_accent_saturation.name), lightness: live_pct(n: 36)) },
  LiveColorToken { name: "clay-subtle", color: live_color_alpha(hue: live_hue_clay, saturation: live_var(name: live_accent_saturation.name), lightness: live_var(name: live_accent_lightness.name), milli: 140) },
  LiveColorToken { name: "brass", color: live_color(hue: live_hue_brass, saturation: live_pct(n: 34), lightness: live_pct(n: 54)) },
  LiveColorToken { name: "brass-dim", color: live_color(hue: live_hue_brass, saturation: live_pct(n: 28), lightness: live_pct(n: 40)) },
  LiveColorToken { name: "brass-subtle", color: live_color_alpha(hue: live_hue_brass, saturation: live_pct(n: 34), lightness: live_pct(n: 54), milli: 130) },
  LiveColorToken { name: "void", color: live_color(hue: live_hue_warm, saturation: live_pct(n: 0), lightness: live_pct(n: 5)) },
  LiveColorToken { name: "void-up", color: live_color(hue: live_hue_warm, saturation: live_pct(n: 3), lightness: live_pct(n: 8)) },
  LiveColorToken { name: "void-up2", color: live_color(hue: live_hue_warm, saturation: live_pct(n: 4), lightness: live_pct(n: 11)) },
  LiveColorToken { name: "stone", color: live_color(hue: live_hue_warm, saturation: live_pct(n: 20), lightness: live_pct(n: 76)) },
  LiveColorToken { name: "stone-dim", color: live_color(hue: live_hue_warm, saturation: live_pct(n: 12), lightness: live_pct(n: 55)) },
  LiveColorToken { name: "stone-faint", color: live_color(hue: live_hue_warm, saturation: live_pct(n: 10), lightness: live_pct(n: 38)) },
  LiveColorToken { name: "warm-white", color: live_color(hue: live_hue_warm, saturation: live_pct(n: 27), lightness: live_pct(n: 94)) },
  LiveColorToken { name: "warm-white-dim", color: live_color(hue: live_hue_warm, saturation: live_pct(n: 18), lightness: live_pct(n: 87)) },
  LiveColorToken { name: "border-dark", color: live_color_alpha(hue: live_hue_warm, saturation: live_pct(n: 20), lightness: live_pct(n: 76), milli: 80) },
  LiveColorToken { name: "border-dark-strong", color: live_color_alpha(hue: live_hue_warm, saturation: live_pct(n: 20), lightness: live_pct(n: 76), milli: 160) },
]
