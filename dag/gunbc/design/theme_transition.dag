module gunbc.design.theme_transition


data theme_transition_note: String = "The general-purpose theme reframe (operator, eighth pass 2026-07-20: universally nail dark->light and light->dark — everyone either gets it for free or has to implement it). Model: a theme flip is a TOUCH (OS toggle or in-page control), so the still-until-touched law grants it exactly one answer — a page-wide cross-fade of every themed property on ONE clock (tokens.reframe_page), never a per-element ripple. Construction: the reframe CSS is DERIVED from the same BuildRule rows that made the colors themed — route a color through a role var and the transition is free BY DERIVATION; bypass the role system and the literal shows up in unthemed_color_decls, a counted census row (opting out is visible, never silent). ORDERING (proven by probe, 2026-07-20): a raw prefers-color-scheme media block recolors in the same style pass as the flip, BEFORE any change event runs — a class added afterwards has nothing left to animate (single-frame snap, measured). So the watcher OWNS the applied theme: at load it pins :root[data-theme] to the current scheme (same values the media block was painting — no flash), which makes the :root:not([data-theme]) media block inert; every subsequent flip is recolored by OUR attribute mutation, set in the same turn as html.reframing, so the cross-fade is structural, not a race. CSS ms and JS ms share one authority (tokens.reframe_page). No JS = media block drives, instant recolor (degraded, never removed); prefers-reduced-motion collapses the reframe to instant by the same guard as every response."

type ReframePair {
  selector: String
  props: List<String>
}

type UnthemedColorDecl {
  selector: String
  prop: String
  value: String
}

fn color_transition_prop(prop: String) -> String {
  if prop == "background" {
    "background-color"
  } else if prop == "color" {
    "color"
  } else if prop == "fill" {
    "fill"
  } else if prop == "stroke" {
    "stroke"
  } else if prop == "border" {
    "border-color"
  } else if prop == "border-color" {
    "border-color"
  } else if prop == "border-bottom" {
    "border-bottom-color"
  } else if prop == "border-left" {
    "border-left-color"
  } else {
    ""
  }
}

fn decl_is_color(d: gunbc.design.material.CssDecl) -> Bool {
  color_transition_prop(prop: extdeps.languages.css.properties.css_property_wire(p: d.prop)).length() > 0
}

fn decl_is_role_themed(d: gunbc.design.material.CssDecl) -> Bool {
  decl_is_color(d: d) && string_contains(s: d.value, pattern: "var(--")
}

fn decl_is_literal_color(d: gunbc.design.material.CssDecl) -> Bool {
  decl_is_color(d: d) && !string_contains(s: d.value, pattern: "var(--")
}

fn contains_prop(props: List<String>, prop: String) -> Bool {
  fold(props, init: false, f: (acc, p) => acc || p == prop)
}

fn themed_props_of(decls: List<gunbc.design.material.CssDecl>) -> List<String> {
  fold(decls, init: [], f: (acc, d) =>
    if decl_is_role_themed(d: d) {
      let tp = color_transition_prop(prop: extdeps.languages.css.properties.css_property_wire(p: d.prop))
      if contains_prop(props: acc, prop: tp) { acc } else { concat(acc, [tp]) }
    } else {
      acc
    })
}

data state_class_census_reach_note: String = "Both censuses reach state-class responses with no new arm, and that is the payoff of landing the still-until-touched amendment as a TRIGGER variant rather than a second rule shape. A new BuildRule variant would have left these two readers with their old arms while the emitter grew a shape — the wall silently ceasing to cover part of the surface it claims to cover, coverage by illusion in the one mechanism whose whole job is coverage. Because a detent is an ordinary ResponseRule carrying a different suffix, an unthemed colour or a raw pixel in a state's declarations is censused exactly as it is anywhere else, and rule_selector keeps reporting the base selector because that is the subject a census locates a violation ON."

fn rule_selector(rule: gunbc.design.material.BuildRule) -> String {
  match rule {
    gunbc.design.material.StaticRule { selector, decls: _ } => extdeps.languages.css.selectors.selector_subject_wire(s: selector)
    gunbc.design.material.ResponseRule { subject, shape, trigger: _, transition_props: _, timing: _, base_decls: _, response_decls: _ } =>
      gunbc.design.material.response_base_selector(subject: subject, shape: shape)
  }
}

fn rule_decls(rule: gunbc.design.material.BuildRule) -> List<gunbc.design.material.CssDecl> {
  match rule {
    gunbc.design.material.StaticRule { selector: _, decls } => decls
    gunbc.design.material.ResponseRule { subject: _, shape: _, trigger: _, transition_props: _, timing: _, base_decls, response_decls } =>
      concat(base_decls, response_decls)
  }
}

fn merge_pair(pairs: List<ReframePair>, selector: String, props: List<String>) -> List<ReframePair> {
  let found = fold(pairs, init: false, f: (acc, p) => acc || p.selector == selector)
  if found {
    map(pairs, p =>
      if p.selector == selector {
        ReframePair {
          selector: p.selector,
          props: fold(props, init: p.props, f: (acc, np) =>
            if contains_prop(props: acc, prop: np) { acc } else { concat(acc, [np]) }),
        }
      } else {
        p
      })
  } else {
    concat(pairs, [ReframePair { selector: selector, props: props }])
  }
}

fn reframe_pairs(rules: List<gunbc.design.material.BuildRule>) -> List<ReframePair> {
  fold(rules, init: [], f: (acc, r) => {
    let props = themed_props_of(decls: rule_decls(rule: r))
    if props.length() == 0 {
      acc
    } else {
      merge_pair(pairs: acc, selector: rule_selector(rule: r), props: props)
    }
  })
}

fn unthemed_color_decls(rules: List<gunbc.design.material.BuildRule>) -> List<UnthemedColorDecl> {
  fold(rules, init: [], f: (acc, r) =>
    fold(rule_decls(rule: r), init: acc, f: (inner, d) =>
      if decl_is_literal_color(d: d) {
        concat(inner, [UnthemedColorDecl { selector: rule_selector(rule: r), prop: extdeps.languages.css.properties.css_property_wire(p: d.prop), value: d.value }])
      } else {
        inner
      }))
}

data untokened_length_note: String = "The length/font sibling of the unthemed-color census (P2): a rule value carrying a raw pixel literal or a quoted font family bypasses the scale (gunbc.design.scale), so it is neither DRY (the value forks per site) nor retunable in one place. The rule is the same shape as the color census — every length/font must route through a token var — and the exclusion is the same by scope: this census runs over a surface's BuildRule rows, never the scale :root block (the one home of the literals). value_has_raw_length keys on 'px' and the single-quote of a font family; unitless 0, %, em, ms (a time, from the timing scale) are not lengths and are not flagged."

type UntokenedLengthDecl {
  selector: String
  prop: String
  value: String
}

fn value_has_raw_length(value: String) -> Bool {
  string_contains(s: value, pattern: "px") || string_contains(s: value, pattern: "'")
}

fn untokened_length_decls(rules: List<gunbc.design.material.BuildRule>) -> List<UntokenedLengthDecl> {
  fold(rules, init: [], f: (acc, r) =>
    fold(rule_decls(rule: r), init: acc, f: (inner, d) =>
      if value_has_raw_length(value: d.value) {
        concat(inner, [UntokenedLengthDecl { selector: rule_selector(rule: r), prop: extdeps.languages.css.properties.css_property_wire(p: d.prop), value: d.value }])
      } else {
        inner
      }))
}

fn reframe_transition_value(props: List<String>, t: gunbc.design.material.TimingToken) -> String {
  join(map(props, p => join([p, " ", to_string(t.duration_ms), "ms ", t.easing], "")), ", ")
}

fn reframe_selector(selector: String) -> String {
  concat("html.reframing ", selector)
}

fn reframe_css(rules: List<gunbc.design.material.BuildRule>) -> String {
  let pairs = reframe_pairs(rules: rules)
  if pairs.length() == 0 {
    ""
  } else {
    join([
      join(map(pairs, p =>
        gunbc.design.material.css_block(
          selector: reframe_selector(selector: p.selector),
          decls: [gunbc.design.material.decl(prop: Transition, value: reframe_transition_value(props: p.props, t: gunbc.design.material.reframe_page))])), "\n"),
      join([
        "@media (prefers-reduced-motion: reduce) { ",
        join(map(pairs, p =>
          gunbc.design.material.css_block(
            selector: reframe_selector(selector: p.selector),
            decls: [gunbc.design.material.decl(prop: Transition, value: "none")])), " "),
        " }",
      ], ""),
    ], "\n")
  }
}

fn alternate_scheme_query() -> String {
  join(["(prefers-color-scheme: ", day_theme.scheme, ")"], "")
}

fn reframe_watcher_program() -> extdeps.languages.typescript.program.TsProgram {
  extdeps.languages.typescript.program.TsProgram {
    ts_nocheck: false,
    header_lines: [
      "gunb.ai theme reframe watcher — emitted from gunbc.design.theme_transition",
      "duration is tokens.reframe_page: one authority for the CSS ms and this timeout",
      "applyTheme pins :root[data-theme]; the :not([data-theme]) media block goes inert,",
      "so every flip is our mutation, set in the same turn as html.reframing (no race)",
    ],
    statements: [
      extdeps.languages.typescript.program.ts_const(name: "mql", value: extdeps.languages.typescript.program.ts_call(
        callee: extdeps.languages.typescript.program.ts_member(object: extdeps.languages.typescript.program.ts_ident(name: "window"), property: "matchMedia"),
        args: [extdeps.languages.typescript.program.ts_lit_str(value: alternate_scheme_query())])),
      extdeps.languages.typescript.program.ts_const(name: "root", value: extdeps.languages.typescript.program.ts_member(object: extdeps.languages.typescript.program.ts_ident(name: "document"), property: "documentElement")),
      extdeps.languages.typescript.program.ts_const(name: "applyTheme", value: extdeps.languages.typescript.program.ts_arrow(params: [], body: extdeps.languages.typescript.program.ts_block(stmts: [
        extdeps.languages.typescript.program.ts_expr_stmt(expr: extdeps.languages.typescript.program.ts_call(
          callee: extdeps.languages.typescript.program.ts_member(object: extdeps.languages.typescript.program.ts_ident(name: "root"), property: "setAttribute"),
          args: [
            extdeps.languages.typescript.program.ts_lit_str(value: "data-theme"),
            extdeps.languages.typescript.program.ts_cond(
              test: extdeps.languages.typescript.program.ts_member(object: extdeps.languages.typescript.program.ts_ident(name: "mql"), property: "matches"),
              consequent: extdeps.languages.typescript.program.ts_lit_str(value: day_theme.name),
              alternate: extdeps.languages.typescript.program.ts_lit_str(value: night_theme.name)),
          ])),
      ]))),
      extdeps.languages.typescript.program.ts_let(name: "reframeTimer", value: extdeps.languages.typescript.program.ts_lit_num(text: "0")),
      extdeps.languages.typescript.program.ts_const(name: "pulse", value: extdeps.languages.typescript.program.ts_arrow(params: [], body: extdeps.languages.typescript.program.ts_block(stmts: [
        extdeps.languages.typescript.program.ts_expr_stmt(expr: extdeps.languages.typescript.program.ts_call(
          callee: extdeps.languages.typescript.program.ts_member(object: extdeps.languages.typescript.program.ts_member(object: extdeps.languages.typescript.program.ts_ident(name: "root"), property: "classList"), property: "add"),
          args: [extdeps.languages.typescript.program.ts_lit_str(value: "reframing")])),
        extdeps.languages.typescript.program.ts_expr_stmt(expr: extdeps.languages.typescript.program.ts_call(callee: extdeps.languages.typescript.program.ts_ident(name: "applyTheme"), args: [])),
        extdeps.languages.typescript.program.ts_expr_stmt(expr: extdeps.languages.typescript.program.ts_call(callee: extdeps.languages.typescript.program.ts_ident(name: "clearTimeout"), args: [extdeps.languages.typescript.program.ts_ident(name: "reframeTimer")])),
        extdeps.languages.typescript.program.ts_expr_stmt(expr: extdeps.languages.typescript.program.ts_binop(
          left: extdeps.languages.typescript.program.ts_ident(name: "reframeTimer"),
          op: "=",
          right: extdeps.languages.typescript.program.ts_call(callee: extdeps.languages.typescript.program.ts_ident(name: "setTimeout"), args: [
            extdeps.languages.typescript.program.ts_arrow(params: [], body: extdeps.languages.typescript.program.ts_block(stmts: [
              extdeps.languages.typescript.program.ts_expr_stmt(expr: extdeps.languages.typescript.program.ts_call(
                callee: extdeps.languages.typescript.program.ts_member(object: extdeps.languages.typescript.program.ts_member(object: extdeps.languages.typescript.program.ts_ident(name: "root"), property: "classList"), property: "remove"),
                args: [extdeps.languages.typescript.program.ts_lit_str(value: "reframing")])),
            ])),
            extdeps.languages.typescript.program.ts_lit_num(text: to_string(reframe_page.duration_ms)),
          ]))),
      ]))),
      extdeps.languages.typescript.program.ts_expr_stmt(expr: extdeps.languages.typescript.program.ts_call(callee: extdeps.languages.typescript.program.ts_ident(name: "applyTheme"), args: [])),
      extdeps.languages.typescript.program.ts_expr_stmt(expr: extdeps.languages.typescript.program.ts_call(
        callee: extdeps.languages.typescript.program.ts_member(object: extdeps.languages.typescript.program.ts_ident(name: "mql"), property: "addEventListener"),
        args: [extdeps.languages.typescript.program.ts_lit_str(value: "change"), extdeps.languages.typescript.program.ts_ident(name: "pulse")])),
    ],
  }
}

fn reframe_watcher_js() -> String {
  extdeps.languages.typescript.program.serialize_typescript_program(p: reframe_watcher_program())
}
