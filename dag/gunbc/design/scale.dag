module gunbc.design.scale

import std.types { Int, String, Bool }
import gunbc.design.material { CssDecl, decl, css_block }
import extdeps.languages.css.values {
  CssLength, css_px, css_length_wire,
  CssFontStack, CssFontFamily, NamedFamily, GenericFamily,
  CssGenericFamily, GenericSansSerif, GenericMonospace, GenericSystemUi,
  css_font_stack_wire,
}

data design_scale_note: String = "Layer 2 token axes (design-register-library.md, the sibling axes to material/theme): spacing, type, font stack, plus the dimension tokens (radius, border width, measure, fixed element extents) the roadmap surface consumes. THE single authority for every length/font literal the register emits — the whole point is that a page rule references a token (var(--space-8)), never a raw pixel, so the untokened-length census (gunbc.design.theme_transition.untokened_length_decls) has exactly one place to exclude by scope (this :root block, the analog of the theme var block the unthemed-color census excludes). D3 grounding: a token's value is a TYPED CssLength (magnitude x unit, extdeps.languages.css.values, cited CSS Values and Units) or a typed CssFontStack (a list of families) — the fused \"4px\"/'Noto Sans, ...' strings are decompressed (DESIGN section 2), and the value-encoded token NAME is DERIVED from the magnitude by the length_token constructor (space-4 from px 4), so name and value can no longer diverge — the fork is UNWRITABLE by construction, not caught by a witness (DESIGN section 5). A semantic re-tuning of the step values (a rhythm, not a per-value alias) is a named follow-on; today the axis's job is DRY (each value lives once) + census-ability + no magnitude-vs-name fork, all served now. Spacing/type/font are the three axes the brief names; dimension_scale is their companion so 'no raw px' is total, not partial."

type ScaleValue
  = LengthValue { length: CssLength }
  | FontStackValue { stack: CssFontStack }

fn scale_value_wire(v: ScaleValue) -> String {
  match v {
    LengthValue { length: l } => css_length_wire(l: l)
    FontStackValue { stack: s } => css_font_stack_wire(s: s)
  }
}

type ScaleToken {
  name: String
  value: ScaleValue
}

data scale_token_derive_note: String = "length_token DERIVES the token name from the magnitude (space-4 from px 4), so the number lives exactly once and a name/value divergence is unwritable (D3). named_length_token is for the semantic-named dimension tokens whose name does NOT encode the magnitude (measure, h-mark) — no fork to close there. font_token carries a typed CssFontStack."

fn length_token(prefix: String, px: Int) -> ScaleToken {
  ScaleToken { name: join([prefix, "-", to_string(px)], ""), value: LengthValue { length: css_px(n: px) } }
}

fn named_length_token(name: String, px: Int) -> ScaleToken {
  ScaleToken { name: name, value: LengthValue { length: css_px(n: px) } }
}

fn font_token(name: String, families: List<CssFontFamily>) -> ScaleToken {
  ScaleToken { name: name, value: FontStackValue { stack: CssFontStack { families: families } } }
}

fn scale_var(t: ScaleToken) -> String {
  join(["var(--", t.name, ")"], "")
}

fn scale_decl(t: ScaleToken) -> CssDecl {
  decl(prop: concat("--", t.name), value: scale_value_wire(v: t.value))
}

fn scale_pair(a: ScaleToken, b: ScaleToken) -> String {
  join([scale_var(t: a), " ", scale_var(t: b)], "")
}

fn scale_triple(a: ScaleToken, b: ScaleToken, c: ScaleToken) -> String {
  join([scale_var(t: a), " ", scale_var(t: b), " ", scale_var(t: c)], "")
}

fn scale_border(w: ScaleToken, color_var: String) -> String {
  join([scale_var(t: w), " solid ", color_var], "")
}

data space_0: ScaleToken = length_token(prefix: "space", px: 0)
data space_1: ScaleToken = length_token(prefix: "space", px: 1)
data space_2: ScaleToken = length_token(prefix: "space", px: 2)
data space_3: ScaleToken = length_token(prefix: "space", px: 3)
data space_4: ScaleToken = length_token(prefix: "space", px: 4)
data space_6: ScaleToken = length_token(prefix: "space", px: 6)
data space_8: ScaleToken = length_token(prefix: "space", px: 8)
data space_12: ScaleToken = length_token(prefix: "space", px: 12)
data space_16: ScaleToken = length_token(prefix: "space", px: 16)
data space_20: ScaleToken = length_token(prefix: "space", px: 20)
data space_24: ScaleToken = length_token(prefix: "space", px: 24)

data spacing_scale: List<ScaleToken> = [
  space_0, space_1, space_2, space_3, space_4, space_6, space_8,
  space_12, space_16, space_20, space_24,
]

data text_10: ScaleToken = length_token(prefix: "text", px: 10)
data text_11: ScaleToken = length_token(prefix: "text", px: 11)
data text_12: ScaleToken = length_token(prefix: "text", px: 12)
data text_13: ScaleToken = length_token(prefix: "text", px: 13)
data text_14: ScaleToken = length_token(prefix: "text", px: 14)
data text_15: ScaleToken = length_token(prefix: "text", px: 15)
data text_18: ScaleToken = length_token(prefix: "text", px: 18)

data type_scale: List<ScaleToken> = [
  text_10, text_11, text_12, text_13, text_14, text_15, text_18,
]

data font_sans: ScaleToken = font_token(name: "font-sans", families: [
  NamedFamily { name: "Noto Sans" },
  GenericFamily { kind: GenericSystemUi },
  GenericFamily { kind: GenericSansSerif },
])
data font_mono: ScaleToken = font_token(name: "font-mono", families: [
  NamedFamily { name: "JetBrains Mono" },
  GenericFamily { kind: GenericMonospace },
])

data font_stack: List<ScaleToken> = [font_sans, font_mono]

data radius_3: ScaleToken = length_token(prefix: "radius", px: 3)
data radius_5: ScaleToken = length_token(prefix: "radius", px: 5)
data border_1: ScaleToken = length_token(prefix: "border", px: 1)
data border_2: ScaleToken = length_token(prefix: "border", px: 2)
data measure_page: ScaleToken = named_length_token(name: "measure", px: 960)
data height_mark: ScaleToken = named_length_token(name: "h-mark", px: 24)
data height_bar: ScaleToken = named_length_token(name: "h-bar", px: 10)
data width_status: ScaleToken = named_length_token(name: "w-status", px: 52)
data width_brick_state: ScaleToken = named_length_token(name: "w-brick-state", px: 62)

data dimension_scale: List<ScaleToken> = [
  radius_3, radius_5, border_1, border_2, measure_page,
  height_mark, height_bar, width_status, width_brick_state,
]

fn all_scale_tokens() -> List<ScaleToken> {
  concat(concat(spacing_scale, type_scale), concat(font_stack, dimension_scale))
}

fn scale_var_decls() -> List<CssDecl> {
  map(all_scale_tokens(), t => scale_decl(t: t))
}

data scale_root_css_note: String = "The token :root block. Emitted alongside theme_root_css so a page's stylesheet carries both authorities in :root and every rule references them by var. This block is the ONE home of raw px/font literals; the untokened-length census excludes it by scope (it runs over the page's BuildRule rows, never this block) exactly as the unthemed-color census excludes the theme var block."

fn scale_root_css() -> String {
  css_block(selector: ":root", decls: scale_var_decls())
}

fn name_present(names: List<String>, name: String) -> Bool {
  fold(names, init: false, f: (acc, n) => acc || n == name)
}

type ScaleDistinctAcc {
  seen: List<String>
  ok: Bool
}

fn scale_names_distinct(tokens: List<ScaleToken>) -> Bool {
  let result = fold(tokens, init: ScaleDistinctAcc { seen: [], ok: true }, f: (acc, t) =>
    if name_present(names: acc.seen, name: t.name) {
      ScaleDistinctAcc { seen: acc.seen, ok: false }
    } else {
      ScaleDistinctAcc { seen: concat(acc.seen, [t.name]), ok: acc.ok }
    })
  result.ok
}

fn scale_well_formed() -> Bool {
  scale_names_distinct(tokens: all_scale_tokens())
    && all(all_scale_tokens(), t => t.name.length() > 0 && scale_value_wire(v: t.value).length() > 0)
    && spacing_scale.length() == 11
    && type_scale.length() == 7
    && font_stack.length() == 2
}
