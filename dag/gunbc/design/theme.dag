data night_theme: Theme = Theme { name: "night", scheme: "dark", assignments: [
  assign(role: CanvasRole, material: night_canvas),
  assign(role: SurfaceRole, material: night_surface),
  assign_alpha(role: BorderRole, material: night_border, alpha_pct: 45),
  assign(role: TextRole, material: night_text),
  assign(role: TextDimRole, material: night_text_dim),
  assign(role: FigureRole, material: warm_starlight),
  assign(role: FigureLitRole, material: warm_starlight_lit),
  assign_alpha(role: FigureHaloRole, material: warm_starlight, alpha_pct: 14),
  assign_alpha(role: FigureEdgeRole, material: starlight_edge, alpha_pct: 50),
  assign(role: FocusRole, material: night_brass),
  assign(role: BoundaryRole, material: night_clay),
] }

data day_theme: Theme = Theme { name: "day", scheme: "light", assignments: [
  assign(role: CanvasRole, material: day_canvas),
  assign(role: SurfaceRole, material: day_surface),
  assign_alpha(role: BorderRole, material: day_border, alpha_pct: 45),
  assign(role: TextRole, material: day_ink),
  assign(role: TextDimRole, material: day_ink_dim),
  assign(role: FigureRole, material: ink_star),
  assign(role: FigureLitRole, material: ink_star_lit),
  assign_alpha(role: FigureHaloRole, material: ink_star, alpha_pct: 12),
  assign_alpha(role: FigureEdgeRole, material: ink_edge, alpha_pct: 45),
  assign(role: FocusRole, material: day_brass),
  assign(role: BoundaryRole, material: day_clay),
] }

data site_themes: List<Theme> = [night_theme, day_theme]

fn role_eq(a: ThemeRole, b: ThemeRole) -> Bool {
  role_key(r: a) == role_key(r: b)
}

fn theme_has_role(t: Theme, r: ThemeRole) -> Bool {
  fold(t.assignments, init: false, f: (acc, a) => acc || role_eq(a: a.role, b: r))
}

fn theme_gaps(t: Theme, roles: List<ThemeRole>) -> List<ThemeRole> {
  fold(roles, init: [], f: (acc, r) =>
    if theme_has_role(t: t, r: r) { acc } else { concat(acc, [r]) })
}

fn theme_total(t: Theme, roles: List<ThemeRole>) -> Bool {
  theme_gaps(t: t, roles: roles).length() == 0
}

fn theme_area_coherent(t: Theme) -> Bool {
  all(t.assignments, a =>
    gunbc.design.material.area_key(area: a.material.area) == gunbc.design.material.area_key(area: role_area(r: a.role)))
}

fn theme_materials_admissible(t: Theme) -> Bool {
  all(t.assignments, a => gunbc.design.material.chroma_admissible(m: a.material))
}

fn assignment_material(t: Theme, r: ThemeRole) -> gunbc.design.material.Material {
  fold(t.assignments, init: gunbc.design.material.Material { name: "", hue: 0, sat_pct: 0, light_pct: 0, area: gunbc.design.material.FieldArea },
    f: (acc, a) => if role_eq(a: a.role, b: r) { a.material } else { acc })
}

fn roles_clear_wcag(t: Theme, fg: ThemeRole, bg: ThemeRole, threshold_hundredths: Int) -> Bool {
  let f = assignment_material(t: t, r: fg)
  let b = assignment_material(t: t, r: bg)
  extdeps.accessibility.wcag_contrast.hsl_contrast_at_least(
    hue_a: f.hue, sat_a: f.sat_pct, light_a: f.light_pct,
    hue_b: b.hue, sat_b: b.sat_pct, light_b: b.light_pct,
    threshold_hundredths: threshold_hundredths)
}

fn theme_contrast_ok(t: Theme) -> Bool {
  roles_clear_wcag(t: t, fg: TextRole, bg: CanvasRole, threshold_hundredths: extdeps.accessibility.wcag_contrast.wcag_aa_normal_text_hundredths)
    && roles_clear_wcag(t: t, fg: TextRole, bg: SurfaceRole, threshold_hundredths: extdeps.accessibility.wcag_contrast.wcag_aa_normal_text_hundredths)
    && roles_clear_wcag(t: t, fg: TextDimRole, bg: CanvasRole, threshold_hundredths: extdeps.accessibility.wcag_contrast.wcag_aa_normal_text_hundredths)
    && roles_clear_wcag(t: t, fg: TextDimRole, bg: SurfaceRole, threshold_hundredths: extdeps.accessibility.wcag_contrast.wcag_aa_normal_text_hundredths)
    && roles_clear_wcag(t: t, fg: FigureRole, bg: CanvasRole, threshold_hundredths: extdeps.accessibility.wcag_contrast.wcag_aa_large_text_and_graphics_hundredths)
    && roles_clear_wcag(t: t, fg: FocusRole, bg: CanvasRole, threshold_hundredths: extdeps.accessibility.wcag_contrast.wcag_aa_large_text_and_graphics_hundredths)
}

fn theme_coherent(t: Theme, roles: List<ThemeRole>) -> Bool {
  theme_total(t: t, roles: roles)
    && theme_area_coherent(t: t)
    && theme_materials_admissible(t: t)
    && theme_contrast_ok(t: t)
}

fn themes_coherent(themes: List<Theme>, roles: List<ThemeRole>) -> Bool {
  themes.length() > 0 && all(themes, t => theme_coherent(t: t, roles: roles))
}

fn assignment_paint(a: RoleAssignment) -> String {
  if a.alpha_pct >= 100 {
    gunbc.design.material.paint(m: a.material)
  } else {
    gunbc.design.material.paint_alpha(m: a.material, alpha_pct: a.alpha_pct)
  }
}

fn role_decl(prop: extdeps.languages.css.properties.CssPropertyName, r: ThemeRole) -> gunbc.design.material.CssDecl {
  gunbc.design.material.CssDecl { prop: prop, value: role_var(r: r) }
}

fn theme_var_decls(t: Theme) -> List<gunbc.design.material.CssDecl> {
  concat(
    map(t.assignments, a => gunbc.design.material.decl(prop: CustomProperty { name: role_key(r: a.role) }, value: assignment_paint(a: a))),
    [gunbc.design.material.decl(prop: ColorScheme, value: t.scheme)])
}

data theme_scoped_blocks_note: String = "ONE THEME-SELECTOR GRAMMAR, N VAR FAMILIES. The three-block shape below — :root for the base theme, :root[data-theme=NAME] for the alternate, and the same alternate again under prefers-color-scheme for readers who never touched the toggle — is what makes a theme switchable at all, and it was written out longhand once here for role vars and again in gunbc.roadmap_style band_root_css for band vars. A second copy of a selector grammar is a second place for the toggle to break in only one of them, which is precisely the failure a reader would never think to look for: the day/night switch would keep working for colors and silently stop working for bands. The family of declarations is now a parameter, so theme_root_css is the role-var instantiation, band_root_css is the band-var instantiation, and the instrument's emission vars are a third — one grammar, three families, and emission is unchanged in all of them."

fn theme_scoped_blocks(base: Theme, alternate: Theme, decls_for: fn(Theme) -> List<gunbc.design.material.CssDecl>) -> String {
  join([
    gunbc.design.material.css_block(selector: ":root", decls: decls_for(base)),
    gunbc.design.material.css_block(
      selector: join([":root[data-theme=\"", alternate.name, "\"]"], ""),
      decls: decls_for(alternate)),
    join([
      "@media (prefers-color-scheme: ", alternate.scheme, ") { ",
      gunbc.design.material.css_block(selector: ":root:not([data-theme])", decls: decls_for(alternate)),
      " }",
    ], ""),
  ], "\n")
}

fn theme_root_css(base: Theme, alternate: Theme) -> String {
  theme_scoped_blocks(base: base, alternate: alternate, decls_for: t => theme_var_decls(t: t))
}

