module gunbc.design.theme


data theme_note: String = "Layer 2 theme machinery: total role-to-material binding, WCAG contrast law, night/day atlas rows. Lifted from gunbc.site.tokens (design-register-library.md Phase A)."
type ThemeRole
  = CanvasRole
  | SurfaceRole
  | BorderRole
  | TextRole
  | TextDimRole
  | FigureRole
  | FigureLitRole
  | FigureHaloRole
  | FigureEdgeRole
  | FocusRole
  | BoundaryRole

data theme_roles: List<ThemeRole> = [
  CanvasRole, SurfaceRole, BorderRole, TextRole, TextDimRole,
  FigureRole, FigureLitRole, FigureHaloRole, FigureEdgeRole,
  FocusRole, BoundaryRole,
]

fn role_key(r: ThemeRole) -> String {
  match r {
    CanvasRole => "canvas"
    SurfaceRole => "surface"
    BorderRole => "border"
    TextRole => "text"
    TextDimRole => "text-dim"
    FigureRole => "figure"
    FigureLitRole => "figure-lit"
    FigureHaloRole => "figure-halo"
    FigureEdgeRole => "figure-edge"
    FocusRole => "focus"
    BoundaryRole => "boundary"
  }
}

fn role_area(r: ThemeRole) -> gunbc.design.material.AreaClass {
  match r {
    CanvasRole => gunbc.design.material.FieldArea
    SurfaceRole => gunbc.design.material.FieldArea
    BorderRole => gunbc.design.material.HairlineArea
    TextRole => gunbc.design.material.TextArea
    TextDimRole => gunbc.design.material.TextArea
    FigureRole => gunbc.design.material.PointArea
    FigureLitRole => gunbc.design.material.PointArea
    FigureHaloRole => gunbc.design.material.PointArea
    FigureEdgeRole => gunbc.design.material.HairlineArea
    FocusRole => gunbc.design.material.PointArea
    BoundaryRole => gunbc.design.material.HairlineArea
  }
}

fn role_var(r: ThemeRole) -> String {
  join(["var(--", role_key(r: r), ")"], "")
}

type RoleAssignment {
  role: ThemeRole
  material: gunbc.design.material.Material
  alpha_pct: Int
}

type Theme {
  name: String
  scheme: String
  assignments: List<RoleAssignment>
}

fn assign(role: ThemeRole, material: gunbc.design.material.Material) -> RoleAssignment {
  RoleAssignment { role: role, material: material, alpha_pct: 100 }
}

fn assign_alpha(role: ThemeRole, material: gunbc.design.material.Material, alpha_pct: Int) -> RoleAssignment {
  RoleAssignment { role: role, material: material, alpha_pct: alpha_pct }
}

