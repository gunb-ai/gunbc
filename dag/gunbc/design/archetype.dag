module gunbc.design.archetype

import std.types { Int, String, Bool }
import gunbc.design.theme {
  ThemeRole, role_key,
  CanvasRole, SurfaceRole, BorderRole, TextRole, TextDimRole,
  FigureRole, FigureEdgeRole, FocusRole, BoundaryRole,
}
import gunbc.design.interaction { InteractionVerb, Approach, Dispatch, Await, Accept, verb_key }

data design_archetype_note: String = "L4 surface archetypes, minimal Phase-B landing (design-register-library.md sect 2; manager-signed 2026-07-21). The second real site — the roadmap dashboard — fired the library's declared trigger, so the axes land as closed enums and Dashboard lands as the FIRST PRESET ROW: a named bundle over independent axes, never a new primitive (the Hermetic|Wet lesson). Deliberately NOT here (each with its trigger): the emission-grammar generalization (GrammarRelationRow archetype machinery — purity trap off one consumer; the roadmap keeps its own page emitter, law-checked); DataVizArea demand (its introduction stays a conscious event, tokens_note pin); the remaining presets (MarketingSite et al land when their surface binds — gunb.ai's binding rides the Phase-A lift). role_demand is the roles the surface CONSUMES by name (names-not-values interface law); the roadmap witness cross-checks the declared demand against the serialized stylesheet in BOTH directions — a demanded-but-unused role and a used-but-undeclared role each red. Liveness is honest to the SERVED surface: the belt-B dashboard reads the tree in-process (Live); the committed ROADMAP.md is a second realization of the same content at StaticEmit, named here, modeled when a consumer needs it."

type ReadingPosture
  = Contemplative
  | ReferencePosture
  | Operational

type ContentShape
  = Narrative
  | ReferenceGraph
  | LiveFacts

type Liveness
  = StaticEmit
  | Regenerated
  | Live

type SurfaceArchetype {
  name: String
  posture: ReadingPosture
  content_shape: ContentShape
  liveness: Liveness
  verbs: List<InteractionVerb>
  role_demand: List<ThemeRole>
}

data dashboard_verb_admission_note: String = "Await and Accept join the dashboard's admitted verbs, and the archetype is exactly where that belongs rather than being a formality to satisfy: the archetype's whole claim is that a surface with Live content and an Operational posture has a DIFFERENT interaction vocabulary from a reference page, and machine-caused state is the clearest case of it. A static reference surface answers fingers only; a live operational surface answers a machine that reports back, so admitting these two verbs here is what makes the roadmap's latched-and-released control admissible while keeping the same verbs inadmissible on a surface that declares itself static — the cross-check runs both directions, so a verb used but not declared reds exactly as a verb declared but unused does."

data dashboard_archetype: SurfaceArchetype = SurfaceArchetype {
  name: "dashboard",
  posture: Operational,
  content_shape: LiveFacts,
  liveness: Live,
  verbs: [Approach, Dispatch, Await, Accept, Enter],
  role_demand: [
    CanvasRole, SurfaceRole, BorderRole, TextRole, TextDimRole,
    FigureRole, FigureEdgeRole, FocusRole,
  ],
}

data dashboard_boundary_demand_dissolved_note: String = "BoundaryRole left the dashboard's demand 2026-07-24 (remodel W1c/W1d): the refusal chip was its only paint consumer on this surface, and refusal color now routes through the instrument band vars (gunbc.roadmap_style band_paint_note — venom, a workspace palette completion, deliberately outside the ThemeRole axis under the instrument-area amendment). The both-ways demand witness is what forced this row to move with the stylesheet instead of lying."

fn archetype_demands_role(a: SurfaceArchetype, r: ThemeRole) -> Bool {
  fold(a.role_demand, init: false, f: (acc, d) => acc || role_key(r: d) == role_key(r: r))
}

fn archetype_admits_verb(a: SurfaceArchetype, v: InteractionVerb) -> Bool {
  fold(a.verbs, init: false, f: (acc, w) => acc || verb_key(v: w) == verb_key(v: v))
}
