module gunbc.design.component


data design_component_note: String = "The component concept — a sibling of the L4 surface archetype (archetype = whole surface; component = one widget), justified by its second-consumer arrival (the dispatch button, design-register-library.md's second-consumer discipline). A component is FOUR axes held as one row: element structure (the ElementId it renders as, the interaction register's closed enum) x role/material bindings (base_roles + a per-state chip role) x interaction STATES (idle | requested | terminal-per-wire-arm) x wire-contract binding (each TerminalState carries the wire label it renders). The wire binding is the load-bearing move the dispatch-button incident (§5, 2026-07-23) demands: the states are NOT a free enum, they are pinned to a served contract, so component_wire_total cross-checks the terminal set against the wire vocabulary authority BOTH directions — a wire label with no state row (labels_missing_state) and a state that fabricates a label the wire never sends (states_missing_label) each red. This module is generic (no roadmap deps); the instance that binds the belt vocabulary lives one layer up (gunbc.roadmap_component), the same split as Component-type-here / dashboard_archetype-instance-in-archetype."

type ComponentStateKind
  = IdleState
  | RequestedState
  | TerminalState { wire_label: String, ok: Bool }

fn state_kind_key(k: ComponentStateKind) -> String {
  match k {
    IdleState => "idle"
    RequestedState => "requested"
    TerminalState { wire_label, ok: _ } => wire_label
  }
}

fn state_kind_is_terminal(k: ComponentStateKind) -> Bool {
  match k {
    TerminalState { wire_label: _, ok: _ } => true
    IdleState => false
    RequestedState => false
  }
}

fn state_kind_ok(k: ComponentStateKind) -> Bool {
  match k {
    TerminalState { wire_label: _, ok } => ok
    IdleState => false
    RequestedState => false
  }
}

type ComponentState {
  key: String
  kind: ComponentStateKind
  role: ThemeRole
}

type Component {
  name: String
  element: ElementId
  verbs: List<InteractionVerb>
  base_roles: List<ThemeRole>
  states: List<ComponentState>
}

fn component_terminal_labels(c: Component) -> List<String> {
  fold(c.states, init: [], f: (acc, s) =>
    if state_kind_is_terminal(k: s.kind) {
      concat(acc, [state_kind_key(k: s.kind)])
    } else {
      acc
    })
}

fn label_list_contains(xs: List<String>, x: String) -> Bool {
  fold(xs, init: false, f: (acc, e) => acc || e == x)
}

fn labels_missing_state(c: Component, wire_labels: List<String>) -> List<String> {
  let have = component_terminal_labels(c: c)
  fold(wire_labels, init: [], f: (acc, l) =>
    if label_list_contains(xs: have, x: l) { acc } else { concat(acc, [l]) })
}

fn states_missing_label(c: Component, wire_labels: List<String>) -> List<String> {
  fold(component_terminal_labels(c: c), init: [], f: (acc, l) =>
    if label_list_contains(xs: wire_labels, x: l) { acc } else { concat(acc, [l]) })
}

fn component_wire_total(c: Component, wire_labels: List<String>) -> Bool {
  labels_missing_state(c: c, wire_labels: wire_labels).length() == 0
    && states_missing_label(c: c, wire_labels: wire_labels).length() == 0
}

fn component_terminal_states(c: Component) -> List<ComponentState> {
  fold(c.states, init: [], f: (acc, s) =>
    if state_kind_is_terminal(k: s.kind) { concat(acc, [s]) } else { acc })
}

fn component_state_for_label(c: Component, wire_label: String) -> List<ComponentState> {
  fold(c.states, init: [], f: (acc, s) =>
    if state_kind_is_terminal(k: s.kind) && state_kind_key(k: s.kind) == wire_label {
      concat(acc, [s])
    } else {
      acc
    })
}

fn component_drop_state(c: Component, drop_key: String) -> Component {
  Component {
    name: c.name,
    element: c.element,
    verbs: c.verbs,
    base_roles: c.base_roles,
    states: fold(c.states, init: [], f: (acc, s) =>
      if s.key == drop_key { acc } else { concat(acc, [s]) }),
  }
}
