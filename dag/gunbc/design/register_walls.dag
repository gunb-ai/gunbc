module gunbc.design.register_walls

import std.types { Int, String, Bool }
import std.disposition { Disposition, Scaffold, SingleAuthority }
import std.decl_ref { DeclarationRef, WholeDeclaration }

data register_walls_note: String = "L1 house-register walls (design-register-library.md) — stub until gunb.ai site subsumption (#6927) lands gunbc.site.tokens as single authority. Glare envelope: bright OR chromatic, never both (sat_pct>45 AND light_pct>68 refused). Palette×register witnesses import this module; dissolve to gunbc.site.tokens on #6927 merge."

data quiet_envelope_hsl_scaffold: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.design.register_walls",
    decl_name: "quiet_envelope_hsl",
    field: WholeDeclaration
  }
}

fn quiet_envelope_hsl(sat_pct: Int, light_pct: Int) -> Bool {
  !(sat_pct > 45 && light_pct > 68)
}
