module gunbc.design.catalog


data design_catalog_note: String = "The palette catalogue: one home for approved color sets. Cited swatch rows live in extdeps/color/ as CitedColorRow; catalogue wraps provenance and SwatchMemberKind only. Register binding (gunbc.site.tokens quiet_envelope_srgb8) is checked at the (set × register) witness layer — island-pastel mint/ivory violate the quiet envelope by design."

data island_pastel_provenance_note: String = "Soft high-key pastel register, operator-supplied swatches 2026-07-21, inspired by Animal Crossing: New Horizons UI colorways (inspiration, not citation — no upstream spec exists to cite). loam is DERIVED from camel (text ink in-family); witness pins WCAG capability via loam only."

data island_mint: gunbc.design.palette.Swatch = gunbc.design.palette.Swatch { name: "mint", color: extdeps.color.srgb.Srgb8 { r: 157, g: 255, b: 176 } }
data island_aqua: gunbc.design.palette.Swatch = gunbc.design.palette.Swatch { name: "aqua", color: extdeps.color.srgb.Srgb8 { r: 129, g: 241, b: 247 } }
data island_ivory: gunbc.design.palette.Swatch = gunbc.design.palette.Swatch { name: "ivory", color: extdeps.color.srgb.Srgb8 { r: 255, g: 255, b: 250 } }
data island_camel: gunbc.design.palette.Swatch = gunbc.design.palette.Swatch { name: "camel", color: extdeps.color.srgb.Srgb8 { r: 196, g: 141, b: 63 } }
data island_butter: gunbc.design.palette.Swatch = gunbc.design.palette.Swatch { name: "butter", color: extdeps.color.srgb.Srgb8 { r: 255, g: 245, b: 99 } }
data island_loam: gunbc.design.palette.Swatch = gunbc.design.palette.Swatch { name: "loam", color: extdeps.color.srgb.Srgb8 { r: 114, g: 77, b: 21 } }

data island_pastel: gunbc.design.palette.SwatchSet = gunbc.design.palette.SwatchSet {
  name: "island-pastel",
  provenance: gunbc.design.palette.InspiredByExternal { note: island_pastel_provenance_note },
  members: [
    gunbc.design.palette.swatch_filed(sw: island_mint),
    gunbc.design.palette.swatch_filed(sw: island_aqua),
    gunbc.design.palette.swatch_filed(sw: island_ivory),
    gunbc.design.palette.swatch_filed(sw: island_camel),
    gunbc.design.palette.swatch_filed(sw: island_butter),
    gunbc.design.palette.swatch_derived(
      sw: island_loam,
      anchor_name: "camel",
      note: "camel hue projected to ink depth oklch(0.45 0.085 73) -> #724d15",
    ),
  ],
}

fn cited_rows_to_members(rows: List<extdeps.color.srgb.CitedColorRow>) -> List<gunbc.design.palette.SwatchMember> {
  map(rows, row => gunbc.design.palette.swatch_filed(sw: gunbc.design.palette.Swatch { name: row.name, color: row.color }))
}

data okabe_ito: gunbc.design.palette.SwatchSet = gunbc.design.palette.SwatchSet {
  name: "okabe-ito",
  provenance: gunbc.design.palette.CitedUpstream { authority: extdeps_external_authority_anchor, version: extdeps.color.okabe_ito.okabe_ito_version },
  members: cited_rows_to_members(rows: extdeps.color.okabe_ito.okabe_ito_swatches),
}

data solarized: gunbc.design.palette.SwatchSet = gunbc.design.palette.SwatchSet {
  name: "solarized",
  provenance: gunbc.design.palette.CitedUpstream { authority: extdeps_external_authority_anchor, version: extdeps.color.solarized.solarized_version },
  members: cited_rows_to_members(rows: extdeps.color.solarized.solarized_swatches),
}

data palette_catalog: List<gunbc.design.palette.SwatchSet> = [island_pastel, okabe_ito, solarized]

fn catalog_admissible() -> Bool {
  palette_catalog.length() == 3
    && all(palette_catalog, s => gunbc.design.palette.swatch_set_admissible(s: s))
    && okabe_ito_swatches.length() == 8
    && solarized_swatches.length() == 16
    && gunbc.design.palette.swatches_of(s: island_pastel).length() == 6
}
