module gunbc.design.interaction


data interaction_note: String = "Layer 2 interaction machinery (lifted from gunbc.site.interaction). Verbs x Responses x TimingToken, held as rows. ElementId is a closed enum — coverage_gaps is total by construction (design-register-library.md sect 10 Class 3, A.0)."

type InteractionVerb
  = Approach
  | Enter
  | StepBack
  | Copy
  | Traverse
  | Dispatch

type Response
  = Brighten
  | Reveal
  | CounterpartHighlight
  | Receipt

type ElementId
  = StarElement
  | HashElement
  | SwatchElement
  | DispatchBtnElement

fn element_id_key(id: ElementId) -> String {
  match id {
    StarElement => "star"
    HashElement => "hash"
    SwatchElement => "swatch"
    DispatchBtnElement => "dispatch-btn"
  }
}

fn verb_key(v: InteractionVerb) -> String {
  match v {
    Approach => "approach"
    Enter => "enter"
    StepBack => "step-back"
    Copy => "copy"
    Traverse => "traverse"
    Dispatch => "dispatch"
  }
}

fn response_key(r: Response) -> String {
  match r {
    Brighten => "brighten"
    Reveal => "reveal"
    CounterpartHighlight => "counterpart-highlight"
    Receipt => "receipt"
  }
}

type BehaviorRow {
  element: ElementId
  verb: InteractionVerb
  response: Response
  timing: TimingToken
}

type InteractiveElement {
  element: ElementId
  verbs: List<InteractionVerb>
}

type CoverageGap {
  element: ElementId
  verb: InteractionVerb
}

fn element_id_eq(a: ElementId, b: ElementId) -> Bool {
  element_id_key(id: a) == element_id_key(id: b)
}

fn interaction_verb_eq(a: InteractionVerb, b: InteractionVerb) -> Bool {
  verb_key(v: a) == verb_key(v: b)
}

fn row_covers(rows: List<BehaviorRow>, element: ElementId, verb: InteractionVerb) -> Bool {
  fold(rows, init: false, f: (acc, r) =>
    acc || (element_id_eq(a: r.element, b: element) && interaction_verb_eq(a: r.verb, b: verb)))
}

fn element_gaps(rows: List<BehaviorRow>, e: InteractiveElement) -> List<CoverageGap> {
  fold(e.verbs, init: [], f: (acc, v) =>
    if row_covers(rows: rows, element: e.element, verb: v) {
      acc
    } else {
      concat(acc, [CoverageGap { element: e.element, verb: v }])
    })
}

fn coverage_gaps(elements: List<InteractiveElement>, rows: List<BehaviorRow>) -> List<CoverageGap> {
  fold(elements, init: [], f: (acc, e) => concat(acc, element_gaps(rows: rows, e: e)))
}

fn coverage_complete(elements: List<InteractiveElement>, rows: List<BehaviorRow>) -> Bool {
  coverage_gaps(elements: elements, rows: rows).length() == 0
}
