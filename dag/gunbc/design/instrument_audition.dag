module gunbc.design.instrument_audition


data audition_note: String = "THE AUDITION IS A COMPARISON, NOT A DEMO. Its purpose is to let one focal control be seen at three energies on the SAME real subject, so the choice between restrained, expressive and hero is made by looking rather than by argument — which is the only way the selective-spectacle amendment can be calibrated without re-litigating it in prose every time. Two properties make it an audition rather than a mock-up: the subject is a real v1-deletion finish line carrying V0's own name, claim and roadmap node, so what the control says is true; and every intensity is admitted through the register's OWN gates (emission_for, attraction_envelope, displacement_admission) rather than through audition-local bounds, so a variant that looks good but breaks the register cannot be rendered at all. The hero variant deliberately sits at the envelope's admissible maximum: an audition whose loudest option is comfortably inside the bound tells you nothing about where the bound is."

type AuditionIntensity
  = AuditionRestrained
  | AuditionExpressive
  | AuditionHero

fn audition_intensity_key(i: AuditionIntensity) -> String {
  match i {
    AuditionRestrained => "restrained"
    AuditionExpressive => "expressive"
    AuditionHero => "hero"
  }
}

data restrained_has_no_emission_note: String = "The restrained variant carries no emission at all, and that is what makes the comparison honest: it is the register as it stood BEFORE the amendment, so the audition's baseline is the real previous state rather than a slightly-dimmer version of the new one. If restrained wins, the amendment costs nothing to withdraw."

type AuditionEmission
  = AuditionNoEmission
  | AuditionEmits { spec: gunbc.design.salience.EmissionSpec }

fn audition_emission(i: AuditionIntensity) -> AuditionEmission {
  match i {
    AuditionRestrained => AuditionNoEmission
    AuditionExpressive => AuditionEmits {
      spec: gunbc.design.salience.EmissionSpec {
        core_radius: extdeps.languages.css.values.css_px(4),
        corona_radius: extdeps.languages.css.values.css_px(20),
        core_alpha_pct: 60,
        corona_alpha_pct: 10,
      },
    }
    AuditionHero => AuditionEmits {
      spec: gunbc.design.salience.EmissionSpec {
        core_radius: extdeps.languages.css.values.css_px(6),
        corona_radius: extdeps.languages.css.values.css_px(48),
        core_alpha_pct: 80,
        corona_alpha_pct: 25,
      },
    }
  }
}

type AuditionAttraction
  = AuditionNoAttraction
  | AuditionAttracts { field: gunbc.design.salience.AttractionField }

fn audition_attraction(i: AuditionIntensity) -> AuditionAttraction {
  match i {
    AuditionRestrained => AuditionNoAttraction
    AuditionExpressive => AuditionNoAttraction
    AuditionHero => AuditionAttracts {
      field: gunbc.design.salience.AttractionField {
        activation_radius: extdeps.languages.css.values.css_px(gunbc.design.salience.attraction_activation_min_px),
        max_travel: extdeps.languages.css.values.css_px(gunbc.design.instrument_physical.focal_attraction_headroom_px(p: audition_instrument(i: AuditionHero))),
        settle: focal_attraction.settle,
      },
    }
  }
}

fn audition_instrument(i: AuditionIntensity) -> gunbc.design.instrument_physical.InstrumentPreference {
  match i {
    AuditionRestrained => gunbc.design.instrument_physical.preference_still
    AuditionExpressive => gunbc.design.instrument_physical.preference_default
    AuditionHero => gunbc.design.instrument_physical.preference_default
  }
}

data discriminator_note: String = "The non-emission discriminator emission_for demands is not a placeholder string here: it names the channel that actually carries selection in the emitted control — the selected state class plus the subject's own name text — so a no-emission or reduced-motion rendering keeps both. Deriving it from the subject key rather than writing a literal is what stops the three intensities from silently sharing one hardcoded discriminator that belongs to none of them."

fn focal_discriminator(subject_key: String) -> String {
  concat("selected-state-class+name-text:", subject_key)
}

data hero_travel_is_derived_note: String = "Hero used to request the register's full attraction travel while the enclosure independently carried its own six pixels, and both gates passed because neither saw the other — the review's composed-envelope finding. Its travel is now DERIVED from what the enclosure left unspent, so the loudest audition variant is by construction the largest one that still fits the single envelope.

COMPOSING THE ENVELOPE CHANGED THE AUDITION, WHICH IS THE POINT. Expressive used to borrow the register's canonical gunbc.design.salience.focal_attraction — activation 150, travel 12 — and under one envelope that no longer fits: 12 of the register's 14 declared pixels are already spent by the canonical field, so an enclosure carrying any character at all cannot also grant it. Rather than shrink the canonical field or inflate the envelope, the three variants now differ by exactly one channel each: restrained has neither emission nor attraction, expressive adds emission, hero adds the attraction the enclosure left affordable. That ordering is more useful for an audition than three variants differing on everything at once, and it surfaces the real constraint instead of hiding it — the register's own focal field is expensive enough that instrument character and canonical attraction are alternatives, not companions. If that trade is wrong, the number to revisit is gunbc.design.salience.attraction_travel_max_px, in the register, deliberately."

data audition_admission_note: String = "One admission per intensity, and every arm of it is the register's existing gate rather than a local re-check. A restrained variant is admitted with no emission grant to inspect; the other two must pass emission_for AT THE FOCAL ROLE, which is the point where an audition that tried to glow a Supporting subject would refuse. Instrument displacement is admitted separately because it is a property of the enclosure and not of the control, and both must hold for the variant to be renderable."

type AuditionAdmission
  = AuditionAdmitted {
      intensity: String
      emission: AuditionEmission
      attraction: AuditionAttraction
      displacement_px: Int
    }
  | AuditionEmissionRefused { intensity: String, grant: gunbc.design.salience.EmissionGrant }
  | AuditionAttractionOutsideEnvelope { intensity: String }
  | AuditionDisplacementOverBudget { intensity: String, total_px: Int, max_px: Int }

fn attraction_travel_of(a: AuditionAttraction) -> Int {
  match a {
    AuditionNoAttraction => 0
    AuditionAttracts { field } => field.max_travel.n
  }
}

fn attraction_admissible(a: AuditionAttraction) -> Bool {
  match a {
    AuditionNoAttraction => true
    AuditionAttracts { field } => gunbc.design.salience.attraction_envelope(f: field)
  }
}

data no_emission_skips_the_gate_note: String = "A restrained variant does not request emission, so it does not pass a zero-alpha spec through emission_for to obtain a grant it does not want. That shortcut was written first and is worth naming: fabricating an admissible-looking spec purely to satisfy a gate produces a REAL grant for emission nobody asked for, and the receipt then reports a granted emission on the one variant whose entire point is having none. NoEmissionRequested is a distinct outcome from a granted one, so the gate is skipped rather than gamed."

type AuditionEmissionOutcome
  = NoEmissionRequested
  | EmissionResolved { grant: gunbc.design.salience.EmissionGrant }

fn audition_emission_outcome(
  i: AuditionIntensity,
  role: gunbc.design.salience.SalienceRole,
  subject_key: String,
) -> AuditionEmissionOutcome {
  match audition_emission(i: i) {
    AuditionNoEmission => NoEmissionRequested
    AuditionEmits { spec } => EmissionResolved {
      grant: gunbc.design.salience.emission_for(
        role: role,
        spec: spec,
        discriminator: focal_discriminator(subject_key: subject_key),
      ),
    }
  }
}

fn emission_granted(g: gunbc.design.salience.EmissionGrant) -> Bool {
  match g {
    gunbc.design.salience.EmissionGranted { spec, discriminator } => true
    gunbc.design.salience.EmissionRefusedForRole { role } => false
    gunbc.design.salience.EmissionOutsideEnvelope { corona_alpha_pct, corona_radius_px } => false
    gunbc.design.salience.EmissionUnitNotComparable { core_unit, corona_unit } => false
    gunbc.design.salience.EmissionSoleDiscriminatorRefused => false
  }
}

fn admit_enclosure(i: AuditionIntensity) -> AuditionAdmission {
  let key = audition_intensity_key(i: i)
  let attraction = audition_attraction(i: i)
  if !attraction_admissible(a: attraction) {
    AuditionAttractionOutsideEnvelope { intensity: key }
  } else {
    match gunbc.design.instrument_physical.admit_composed_displacement(d: gunbc.design.instrument_physical.compose_displacement(
      p: audition_instrument(i: i),
      focal_attraction_px: attraction_travel_of(a: attraction),
    )) {
      gunbc.design.instrument_physical.DisplacementOverBudget { total_px, max_px } =>
        AuditionDisplacementOverBudget { intensity: key, total_px: total_px, max_px: max_px }
      gunbc.design.instrument_physical.EnclosureCharacterReachesResponseTravel { character_px, max_px } =>
        AuditionDisplacementOverBudget { intensity: key, total_px: character_px, max_px: max_px }
      gunbc.design.instrument_physical.DisplacementAdmitted { total_px } => AuditionAdmitted {
        intensity: key,
        emission: audition_emission(i: i),
        attraction: attraction,
        displacement_px: total_px,
      }
    }
  }
}

fn admit_audition(i: AuditionIntensity, role: gunbc.design.salience.SalienceRole, subject_key: String) -> AuditionAdmission {
  match audition_emission_outcome(i: i, role: role, subject_key: subject_key) {
    NoEmissionRequested => admit_enclosure(i: i)
    EmissionResolved { grant } =>
      if emission_granted(g: grant) {
        admit_enclosure(i: i)
      } else {
        AuditionEmissionRefused { intensity: audition_intensity_key(i: i), grant: grant }
      }
  }
}

data audition_intensities: List<AuditionIntensity> = [AuditionRestrained, AuditionExpressive, AuditionHero]

data reading_note: String = "THE CAMERA READS THE WORLD V0 ALREADY DERIVED, and the previous revision of this module did not — which is the defect worth recording rather than quietly fixing. It answered Status and Remaining out of gunbc.v1_deletion_plan's authored rows, and answered Why with a typed ReadingUnavailable carrying the cause 'no rationale carrier exists for a v1 finish line'. That cause was FALSE when it was written. gunbc.roadmap_program_view was already on this branch's base and its own header says the camera layers are deliberately absent because THAT module is the world the cameras look at; ConstraintView exists precisely to answer why-is-this-taking-so-long without inventing rationale prose. So the refusal was not the honest fail-closed arm its note claimed — it was the empty-observation narrow, rendering could-not-find as the verdict does-not-exist, in the module whose own notes warn against exactly that. It reached review green because nothing about a refusal looks wrong: no witness can tell a correct refusal from a lazy one without going and looking for the carrier, which is what nobody did. The lesson is cheap to state and was expensive here: before declaring a carrier absent, search for it."

data reading_grain_note: String = "DEPTH SELECTS THE SUBJECT GRAIN, MODE SELECTS THE QUESTION, and the two are genuinely independent because V0 derives a RemainingShape and a ConstraintView at more than one grain. Program reads the whole program's shape — from view.remaining, at EVERY focus, which is a correction rather than a restatement: this sentence was written while read_camera_at routed a focused program detent into the line reader, so the claim held only with nothing selected and the page mislabelled outcome-grain rows as program ones (review 48719, fixed by making the program grain unrepresentable in SubjectDepth rather than by adding an arm — see subject_depth_note). Outcome reads one FinishLineView; Front reads one contributing FrontView; Node reads the primary constraint's own subject. Evidence is deliberately NOT answered from these carriers: acceptance here comes from RoadmapAcceptanceReceipt rows, but the verification-receipt join that would let a camera show WHY a receipt was granted is test-only until the belt wiring lands, and gunbc.roadmap_program_view says so itself. That is a real absence with a named trigger, so Evidence refuses — and it is the one place in this module where a refusal is the correct answer rather than a search nobody performed."

type ProgramReading
  = ReadingNoSubject
  | ReadingProgramShape { remaining: gunbc.roadmap_program_view.RemainingShape }
  | ReadingOutcomeStatus { name: String, node: String, accepted: Bool, open_fronts: Int }
  | ReadingOutcomeRemaining { name: String, remaining: gunbc.roadmap_program_view.RemainingShape }
  | ReadingConstraint { subject: String, kind: String, headline: String, in_flight: Bool, depth: Int }
  | ReadingNoConstraint { subject_key: String, reason: String }
  | ReadingFront { key: String, name: String, closed: Bool, gates_accepted: Int, gates_total: Int }
  | ReadingUnavailable { mode: String, subject_key: String, cause: String }

data evidence_grain_cause: String = "the verification-receipt join is test-only until the belt wiring seam lands (gunbc.roadmap_program_view records the same gap), so a camera can read THAT a node was accepted but not the evidence behind the receipt"

data accepted_subject_has_no_constraint_reason: String = "the subject is accepted, so its closure holds no unresolved constraint — this is an answer, not a missing carrier"

data no_workable_frontier_reason: String = "no workable frontier remains in the subject's unaccepted closure"

fn constraint_kind_key(k: gunbc.roadmap_program_view.ConstraintKind) -> String {
  match k {
    gunbc.roadmap_program_view.ImplementationConstraint => "implementation"
    gunbc.roadmap_program_view.ContractConstraint => "contract"
  }
}

fn read_constraint(subject_key: String, c: gunbc.roadmap_program_view.ConstraintView?, accepted: Bool) -> ProgramReading {
  match c {
    Absent => ReadingNoConstraint {
      subject_key: subject_key,
      reason: if accepted { accepted_subject_has_no_constraint_reason } else { no_workable_frontier_reason },
    }
    Present { value } => ReadingConstraint {
      subject: value.subject as String,
      kind: constraint_kind_key(k: value.kind),
      headline: value.headline,
      in_flight: value.in_flight,
      depth: value.depth,
    }
  }
}

data subject_depth_note: String = "THE GRAIN THE LINE READER IS ALLOWED TO ANSWER AT, as a type rather than as a promise (review 48719, 2026-08-05). The bug it closes: read_line_view used to match ProgramDepth, so it carried a DepthProgram arm — and that arm was byte-identical to its DepthOutcome arm. read_camera_at then routed BOTH depths into it whenever a subject was focused, so the program detent silently produced outcome-grain readings while the page kept labelling the row program / …, and reading_grain_note's claim that Program reads the whole program's shape was true only when nothing was selected. That is the note-vs-code split this module has now produced three times, so the fix is not another corrected arm: the whole-program grain has no representation here at all. SubjectDepth enumerates exactly the grains that ARE a property of one finish line, DepthProgram cannot be projected into it, and read_line_view therefore cannot be handed the program grain by any caller. A DepthFront arm went with it, dead for a different reason — read_camera_at answers fronts through first_front_view, so the line reader's front arm had been unreachable since that fold landed."

type SubjectDepth
  = SubjectOutcome
  | SubjectNode
  | SubjectEvidence

fn read_line_view(lv: gunbc.roadmap_program_view.FinishLineView, camera: gunbc.design.instrument_camera.ProgramCamera, d: SubjectDepth) -> ProgramReading {
  match d {
    SubjectOutcome => match camera.mode {
      gunbc.design.instrument_camera.ModeStatus => ReadingOutcomeStatus {
        name: lv.name,
        node: lv.node as String,
        accepted: lv.accepted,
        open_fronts: lv.remaining.open_fronts,
      }
      gunbc.design.instrument_camera.ModeRemaining => ReadingOutcomeRemaining { name: lv.name, remaining: lv.remaining }
      gunbc.design.instrument_camera.ModeWhy => read_constraint(subject_key: lv.key, c: lv.constraint, accepted: lv.accepted)
    }
    SubjectNode => read_constraint(subject_key: lv.key, c: lv.constraint, accepted: lv.accepted)
    SubjectEvidence => ReadingUnavailable {
      mode: gunbc.design.instrument_camera.program_mode_key(m: camera.mode),
      subject_key: lv.key,
      cause: evidence_grain_cause,
    }
  }
}

data front_grain_note: String = "At front depth the camera shows the contributing fronts V0 derived for this outcome, and it shows the FIRST one rather than a list because a single reading is one answer — a camera at a grain reports the subject in view. Which front is in view is a tuning axis the operable instrument owns; this study fixes it at the first contributing front so the grain is genuinely different from Outcome rather than a relabelled copy of it.

FIRST IS ENFORCED BY THE FOLD, NOT PROMISED BY THIS PARAGRAPH (review finding 48579, 2026-08-05). The first cut folded the contributing fronts with a step that ignored its accumulator, so the LAST match won while this note said first — and it was not hypothetical: the exemplar subject contributes to namespace-pderive and then v2-generation, so the study rendered the wrong front. A fold whose step drops acc is a last-wins selection wearing a first-wins comment, and nothing caught it because no witness read the front grain at all. Selection is now a separate take-first over the list, so the reading step cannot express a preference between candidates, and witness_the_front_grain_shows_the_first_contributing_front reads the rendered key."

fn front_view_for(lv: gunbc.roadmap_program_view.FinishLineView, fronts: List<gunbc.roadmap_program_view.FrontView>) -> List<gunbc.roadmap_program_view.FrontView> {
  fronts |> filter(fv => lv.contributing_fronts |> any(f => gunbc.roadmap_program_view.program_front_key(front: f) == fv.key))
}

fn first_front_view(lv: gunbc.roadmap_program_view.FinishLineView, fronts: List<gunbc.roadmap_program_view.FrontView>) -> List<gunbc.roadmap_program_view.FrontView> {
  fold(front_view_for(lv: lv, fronts: fronts), init: [],
    f: (acc, fv) => if count(acc) == 0 { [fv] } else { acc })
}

fn read_front_view(fv: gunbc.roadmap_program_view.FrontView, camera: gunbc.design.instrument_camera.ProgramCamera) -> ProgramReading {
  match camera.mode {
    gunbc.design.instrument_camera.ModeStatus => ReadingFront {
      key: fv.key,
      name: fv.name,
      closed: fv.closed,
      gates_accepted: fv.gates_accepted,
      gates_total: fv.gates_total,
    }
    gunbc.design.instrument_camera.ModeRemaining => ReadingOutcomeRemaining { name: fv.name, remaining: fv.remaining }
    gunbc.design.instrument_camera.ModeWhy => read_constraint(subject_key: fv.key, c: fv.constraint, accepted: fv.closed)
  }
}

data no_contributing_front_cause: String = "no convergence front contributes to this finish line in the derived view"

fn read_front(lv: gunbc.roadmap_program_view.FinishLineView, camera: gunbc.design.instrument_camera.ProgramCamera) -> ProgramReading {
  ReadingUnavailable {
    mode: gunbc.design.instrument_camera.program_mode_key(m: camera.mode),
    subject_key: lv.key,
    cause: no_contributing_front_cause,
  }
}

data unresolved_subject_cause: String = "the focused subject key resolves to no finish line in the derived program view"

fn line_view_for(view: gunbc.roadmap_program_view.V1DeletionProgramView, subject_key: String) -> List<gunbc.roadmap_program_view.FinishLineView> {
  view.finish_lines |> filter(lv => lv.key == subject_key)
}

fn first_line_view(view: gunbc.roadmap_program_view.V1DeletionProgramView, subject_key: String) -> List<gunbc.roadmap_program_view.FinishLineView> {
  fold(line_view_for(view: view, subject_key: subject_key), init: [],
    f: (acc, lv) => if count(acc) == 0 { [lv] } else { acc })
}

fn read_program_depth(view: gunbc.roadmap_program_view.V1DeletionProgramView, camera: gunbc.design.instrument_camera.ProgramCamera) -> ProgramReading {
  match camera.mode {
    gunbc.design.instrument_camera.ModeRemaining => ReadingProgramShape { remaining: view.remaining }
    gunbc.design.instrument_camera.ModeStatus => ReadingProgramShape { remaining: view.remaining }
    gunbc.design.instrument_camera.ModeWhy => ReadingUnavailable {
      mode: "why",
      subject_key: "v1-deletion-program",
      cause: no_workable_frontier_reason,
    }
  }
}

fn read_camera(camera: gunbc.design.instrument_camera.ProgramCamera, view: gunbc.roadmap_program_view.V1DeletionProgramView) -> ProgramReading {
  match camera.focus {
    gunbc.design.instrument_camera.NoSubjectSelected => match camera.depth {
      gunbc.design.instrument_camera.DepthProgram => read_program_depth(view: view, camera: camera)
      gunbc.design.instrument_camera.DepthOutcome => ReadingNoSubject
      gunbc.design.instrument_camera.DepthFront => ReadingNoSubject
      gunbc.design.instrument_camera.DepthNode => ReadingNoSubject
      gunbc.design.instrument_camera.DepthEvidence => ReadingNoSubject
    }
    gunbc.design.instrument_camera.FinishLineFocused { line_key } => fold(
      first_line_view(view: view, subject_key: line_key),
      init: ReadingUnavailable {
        mode: gunbc.design.instrument_camera.program_mode_key(m: camera.mode),
        subject_key: line_key,
        cause: unresolved_subject_cause,
      },
      f: (acc, lv) => read_camera_at(lv: lv, camera: camera, view: view),
    )
  }
}

fn read_camera_at(lv: gunbc.roadmap_program_view.FinishLineView, camera: gunbc.design.instrument_camera.ProgramCamera, view: gunbc.roadmap_program_view.V1DeletionProgramView) -> ProgramReading {
  match camera.depth {
    gunbc.design.instrument_camera.DepthFront => fold(
      first_front_view(lv: lv, fronts: view.fronts),
      init: read_front(lv: lv, camera: camera),
      f: (acc, fv) => read_front_view(fv: fv, camera: camera),
    )
    gunbc.design.instrument_camera.DepthProgram => read_program_depth(view: view, camera: camera)
    gunbc.design.instrument_camera.DepthOutcome => read_line_view(lv: lv, camera: camera, d: SubjectOutcome)
    gunbc.design.instrument_camera.DepthNode => read_line_view(lv: lv, camera: camera, d: SubjectNode)
    gunbc.design.instrument_camera.DepthEvidence => read_line_view(lv: lv, camera: camera, d: SubjectEvidence)
  }
}

fn reading_key(r: ProgramReading) -> String {
  match r {
    ReadingNoSubject => "no-subject"
    ReadingProgramShape { remaining } => "program-shape"
    ReadingOutcomeStatus { name, node, accepted, open_fronts } => "status"
    ReadingOutcomeRemaining { name, remaining } => "remaining"
    ReadingConstraint { subject, kind, headline, in_flight, depth } => "constraint"
    ReadingNoConstraint { subject_key, reason } => "no-constraint"
    ReadingFront { key, name, closed, gates_accepted, gates_total } => "front"
    ReadingUnavailable { mode, subject_key, cause } => "unavailable"
  }
}
