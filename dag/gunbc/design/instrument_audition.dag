module gunbc.design.instrument_audition

import std.types { String, Bool, Int, List }
import extdeps.languages.css.values { css_px }
import gunbc.design.salience {
  SalienceRole, EmissionSpec, EmissionGrant, emission_for,
  EmissionGranted, EmissionRefusedForRole, EmissionOutsideEnvelope,
  EmissionUnitNotComparable, EmissionSoleDiscriminatorRefused,
  AttractionField, attraction_envelope, focal_attraction,
  attraction_travel_max_px, attraction_activation_min_px,
}
import gunbc.design.instrument_camera {
  ProgramCamera, ProgramMode, ModeStatus, ModeRemaining, ModeWhy,
  NoSubjectSelected, FinishLineFocused, program_mode_key,
}
import gunbc.design.instrument_physical {
  InstrumentPreference, preference_still, preference_default,
  displacement_admission, DisplacementAdmitted, DisplacementOverBudget,
}
import gunbc.v1_deletion_plan {
  V1FinishLineSpec, v1_exit_finish_lines, v1_finish_line_key, v1_finish_line_accepted,
}
import gunbc.roadmap_model { RoadmapNodeId }

data audition_note: String = "THE AUDITION IS A COMPARISON, NOT A DEMO. Its purpose is to let one focal control be seen at three energies on the SAME real subject, so the choice between restrained, expressive and hero is made by looking rather than by argument — which is the only way the selective-spectacle amendment can be calibrated without re-litigating it in prose every time. Two properties make it an audition rather than a mock-up: the subject is a real v1-deletion finish line carrying V0's own name, claim and roadmap node, so what the control says is true; and every intensity is admitted through the register's OWN gates (emission_for, attraction_envelope, displacement_admission) rather than through audition-local bounds, so a variant that looks good but breaks the register cannot be rendered at all. The hero variant deliberately sits at the envelope's admissible maximum: an audition whose loudest option is comfortably inside the bound tells you nothing about where the bound is."

type AuditionIntensity
  = AuditionRestrained
  | AuditionExpressive
  | AuditionHero

fn audition_intensity_key(i: AuditionIntensity) -> String {
  match i {
    AuditionRestrained => "restrained"
    AuditionExpressive => "expressive"
    AuditionHero => "hero"
  }
}

data restrained_has_no_emission_note: String = "The restrained variant carries no emission at all, and that is what makes the comparison honest: it is the register as it stood BEFORE the amendment, so the audition's baseline is the real previous state rather than a slightly-dimmer version of the new one. If restrained wins, the amendment costs nothing to withdraw."

type AuditionEmission
  = AuditionNoEmission
  | AuditionEmits { spec: EmissionSpec }

fn audition_emission(i: AuditionIntensity) -> AuditionEmission {
  match i {
    AuditionRestrained => AuditionNoEmission
    AuditionExpressive => AuditionEmits {
      spec: EmissionSpec {
        core_radius: css_px(4),
        corona_radius: css_px(20),
        core_alpha_pct: 60,
        corona_alpha_pct: 10,
      },
    }
    AuditionHero => AuditionEmits {
      spec: EmissionSpec {
        core_radius: css_px(6),
        corona_radius: css_px(48),
        core_alpha_pct: 80,
        corona_alpha_pct: 25,
      },
    }
  }
}

type AuditionAttraction
  = AuditionNoAttraction
  | AuditionAttracts { field: AttractionField }

fn audition_attraction(i: AuditionIntensity) -> AuditionAttraction {
  match i {
    AuditionRestrained => AuditionNoAttraction
    AuditionExpressive => AuditionAttracts { field: focal_attraction }
    AuditionHero => AuditionAttracts {
      field: AttractionField {
        activation_radius: css_px(attraction_activation_min_px),
        max_travel: css_px(attraction_travel_max_px),
        settle: focal_attraction.settle,
      },
    }
  }
}

fn audition_instrument(i: AuditionIntensity) -> InstrumentPreference {
  match i {
    AuditionRestrained => preference_still
    AuditionExpressive => preference_default
    AuditionHero => preference_default
  }
}

data discriminator_note: String = "The non-emission discriminator emission_for demands is not a placeholder string here: it names the channel that actually carries selection in the emitted control — the selected state class plus the subject's own name text — so a no-emission or reduced-motion rendering keeps both. Deriving it from the subject key rather than writing a literal is what stops the three intensities from silently sharing one hardcoded discriminator that belongs to none of them."

fn focal_discriminator(subject_key: String) -> String {
  concat("selected-state-class+name-text:", subject_key)
}

data audition_admission_note: String = "One admission per intensity, and every arm of it is the register's existing gate rather than a local re-check. A restrained variant is admitted with no emission grant to inspect; the other two must pass emission_for AT THE FOCAL ROLE, which is the point where an audition that tried to glow a Supporting subject would refuse. Instrument displacement is admitted separately because it is a property of the enclosure and not of the control, and both must hold for the variant to be renderable."

type AuditionAdmission
  = AuditionAdmitted {
      intensity: String
      emission: AuditionEmission
      attraction: AuditionAttraction
      displacement_px: Int
    }
  | AuditionEmissionRefused { intensity: String, grant: EmissionGrant }
  | AuditionAttractionOutsideEnvelope { intensity: String }
  | AuditionDisplacementOverBudget { intensity: String, total_px: Int, max_px: Int }

fn attraction_admissible(a: AuditionAttraction) -> Bool {
  match a {
    AuditionNoAttraction => true
    AuditionAttracts { field } => attraction_envelope(f: field)
  }
}

data no_emission_skips_the_gate_note: String = "A restrained variant does not request emission, so it does not pass a zero-alpha spec through emission_for to obtain a grant it does not want. That shortcut was written first and is worth naming: fabricating an admissible-looking spec purely to satisfy a gate produces a REAL grant for emission nobody asked for, and the receipt then reports a granted emission on the one variant whose entire point is having none. NoEmissionRequested is a distinct outcome from a granted one, so the gate is skipped rather than gamed."

type AuditionEmissionOutcome
  = NoEmissionRequested
  | EmissionResolved { grant: EmissionGrant }

fn audition_emission_outcome(
  i: AuditionIntensity,
  role: SalienceRole,
  subject_key: String,
) -> AuditionEmissionOutcome {
  match audition_emission(i: i) {
    AuditionNoEmission => NoEmissionRequested
    AuditionEmits { spec } => EmissionResolved {
      grant: emission_for(
        role: role,
        spec: spec,
        discriminator: focal_discriminator(subject_key: subject_key),
      ),
    }
  }
}

fn emission_granted(g: EmissionGrant) -> Bool {
  match g {
    EmissionGranted { spec, discriminator } => true
    EmissionRefusedForRole { role } => false
    EmissionOutsideEnvelope { corona_alpha_pct, corona_radius_px } => false
    EmissionUnitNotComparable { core_unit, corona_unit } => false
    EmissionSoleDiscriminatorRefused => false
  }
}

fn admit_enclosure(i: AuditionIntensity) -> AuditionAdmission {
  let key = audition_intensity_key(i: i)
  let attraction = audition_attraction(i: i)
  if !attraction_admissible(a: attraction) {
    AuditionAttractionOutsideEnvelope { intensity: key }
  } else {
    match displacement_admission(p: audition_instrument(i: i)) {
      DisplacementOverBudget { total_px, max_px } =>
        AuditionDisplacementOverBudget { intensity: key, total_px: total_px, max_px: max_px }
      DisplacementAdmitted { total_px } => AuditionAdmitted {
        intensity: key,
        emission: audition_emission(i: i),
        attraction: attraction,
        displacement_px: total_px,
      }
    }
  }
}

fn admit_audition(i: AuditionIntensity, role: SalienceRole, subject_key: String) -> AuditionAdmission {
  match audition_emission_outcome(i: i, role: role, subject_key: subject_key) {
    NoEmissionRequested => admit_enclosure(i: i)
    EmissionResolved { grant } =>
      if emission_granted(g: grant) {
        admit_enclosure(i: i)
      } else {
        AuditionEmissionRefused { intensity: audition_intensity_key(i: i), grant: grant }
      }
  }
}

data audition_intensities: List<AuditionIntensity> = [AuditionRestrained, AuditionExpressive, AuditionHero]

data reading_note: String = "WHAT THE CONTROL SAYS, AND WHERE IT REFUSES TO SAY ANYTHING. Status and Remaining are answered from facts gunbc.v1_deletion_plan actually carries — the bound roadmap node, whether it is accepted, and the finish line's own claim text. Why is NOT answered, and that is the load-bearing part: no carrier in this repository records why a finish line has the shape it has, so a Why reading returns a typed, located, countable ReadingUnavailable naming the missing carrier rather than paraphrasing the claim into something that sounds like a rationale. A mode that renders plausible filler is the fabricated-plausible-output arm wearing a UI, and it is far more dangerous here than in a compiler because nobody diffs a sentence on a screen. DISSOLVE-ON: a rationale carrier lands on the roadmap ticket and Why reads it."

type ProgramReading
  = ReadingNoSubject
  | ReadingStatus { node: String, accepted: Bool, name: String }
  | ReadingRemaining { name: String, claim: String, accepted: Bool }
  | ReadingUnavailable { mode: String, subject_key: String, cause: String }

data why_has_no_carrier_cause: String = "no rationale carrier exists for a v1 finish line: gunbc.v1_deletion_plan records the claim (what must become true) and the bound roadmap node, neither of which states why"

fn finish_line_spec_for(subject_key: String) -> List<V1FinishLineSpec> {
  v1_exit_finish_lines() |> filter(s => v1_finish_line_key(l: s.line) == subject_key)
}

fn read_spec(spec: V1FinishLineSpec, mode: ProgramMode, accepted: List<RoadmapNodeId>) -> ProgramReading {
  match mode {
    ModeStatus => ReadingStatus {
      node: spec.node,
      accepted: v1_finish_line_accepted(spec: spec, accepted: accepted),
      name: spec.name,
    }
    ModeRemaining => ReadingRemaining {
      name: spec.name,
      claim: spec.claim,
      accepted: v1_finish_line_accepted(spec: spec, accepted: accepted),
    }
    ModeWhy => ReadingUnavailable {
      mode: program_mode_key(m: mode),
      subject_key: v1_finish_line_key(l: spec.line),
      cause: why_has_no_carrier_cause,
    }
  }
}

data unknown_subject_refuses_note: String = "A focused key that resolves to no finish line refuses rather than reading as an empty subject. The two are different states — nothing is selected, versus something is selected that the authoritative view does not know — and collapsing the second into the first is the empty-observation narrow: it renders could-not-resolve as the verdict nothing-is-here, exactly where a drifted key most needs to be visible."

data unresolved_subject_cause: String = "the focused subject key resolves to no finish line in the authoritative view"

fn read_camera(camera: ProgramCamera, accepted: List<RoadmapNodeId>) -> ProgramReading {
  match camera.focus {
    NoSubjectSelected => ReadingNoSubject
    FinishLineFocused { line_key } => fold(
      finish_line_spec_for(subject_key: line_key),
      init: ReadingUnavailable {
        mode: program_mode_key(m: camera.mode),
        subject_key: line_key,
        cause: unresolved_subject_cause,
      },
      f: (acc, spec) => read_spec(spec: spec, mode: camera.mode, accepted: accepted),
    )
  }
}

fn reading_key(r: ProgramReading) -> String {
  match r {
    ReadingNoSubject => "no-subject"
    ReadingStatus { node, accepted, name } => "status"
    ReadingRemaining { name, claim, accepted } => "remaining"
    ReadingUnavailable { mode, subject_key, cause } => "unavailable"
  }
}
