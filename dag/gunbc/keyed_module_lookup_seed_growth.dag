module gunbc.keyed_module_lookup_seed_growth

import gunbc.roadmap.roadmap_model { RoadmapNodeId }
import gunbc.seed_growth { SeedGrowthJustification }
import std.decl_ref { DeclarationRef, WholeDeclaration }

// Receipt for the hand-Rust that answers the two KEYED reads (`module_declaration_facts_at`,
// `decl_facts_at` qualified-name arm) from a module's NAME instead of a walk of every pool file.
data keyed_module_lookup_seed_growth_justification: SeedGrowthJustification = SeedGrowthJustification {
  hand_authored_declarations: [
    DeclarationRef { module_path: "v1_compiler.cli_run.keyed_module_lookup", decl_name: "canonical_pool_roots", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.cli_run.keyed_module_lookup", decl_name: "custom_root_census_for", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.cli_run.keyed_module_lookup", decl_name: "keyed_module_sources", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.cli_run.keyed_module_lookup", decl_name: "refuse_unreadable", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.cli_run.keyed_module_lookup", decl_name: "keyed_module_path", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.cli_run.demand_acquire", decl_name: "read_layout_file", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.coproduct_reflection", decl_name: "decl_facts_of_source", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.coproduct_reflection", decl_name: "sort_decl_facts", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.coproduct_reflection", decl_name: "keyed_decl_facts", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.coproduct_reflection", decl_name: "DeclFactsKeyedRefusal", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.coproduct_reflection", decl_name: "decl_facts_keyed_refusal_sentence", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.coproduct_reflection", decl_name: "decl_facts_of_source_checked", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.coproduct_reflection.keyed_decl_facts_unreadable_file_tests", decl_name: "a_derived_file_that_does_not_parse_refuses_rather_than_answering_empty", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.coproduct_reflection.keyed_decl_facts_unreadable_file_tests", decl_name: "the_same_read_answers_the_row_when_the_derived_file_parses", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.cli_run.keyed_module_lookup.tests", decl_name: "the_refusal_names_the_file_the_module_and_the_parse_own_words", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.cli_run.keyed_module_lookup.tests", decl_name: "a_readable_derived_file_still_answers_its_row", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.module_path_index.parsed_dag_file", decl_name: "DagParseRefusal", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.module_path_index.parsed_dag_file", decl_name: "dag_parse_refusal_sentence", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.module_path_index.parsed_dag_file", decl_name: "parse_dag_content_checked", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.cli_run.keyed_module_lookup.tests", decl_name: "module_under_two_roots_yields_both_decl_rows_and_the_primary_fact", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.cli_run.keyed_module_lookup.tests", decl_name: "module_only_under_the_second_root_resolves_there", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.cli_run.keyed_module_lookup.tests", decl_name: "module_declared_nowhere_is_absent", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.cli_run.keyed_module_lookup.tests", decl_name: "the_same_root_twice_fabricates_no_ambiguity", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.cli_run.keyed_module_lookup.tests", decl_name: "keyed_reads_equal_the_whole_pool_census", field: WholeDeclaration }
  ],
  reason: "WHY RUST RATHER THAN .dag: the keyed reads are host free_calls of the v1 interpreter (`module_declaration_facts_at`, `decl_facts_at`), answered from the seed's pool acquisition; the v1 interpreter cannot call v2.compiler.source_authority module_file as a fold. The seed applies gunbc.source_layout through the existing source_layout_lookup module_storage_relative and the demand_acquire primitives (governed-root test, derived-roster read, custom-root walk, layout-file read), generalized and shared, not copied. WHY ADMITTED AGAINST THE v1 FREEZE: gunbc.v1.v1_maintenance_standing v1_seed_standing admits by PURPOSE - the first keyed call lexed, parsed and retained every pool file (~8.3 GiB, 16 s on the private composed pool of 10164 files), a memory burst in the v2 program's private CI lanes. gunbc.design_argument::single_authority: finding one module must not cost reading all of them.",
  owning_dissolution_lane: "v1-hand-queue-drain" as RoadmapNodeId,
  trigger: "Delete these declarations when the keyed module and declaration reads are native v2 (v2.compiler.source_authority module_file, v2.compiler.module_acquisition) and the v1 interpreter free_calls module_declaration_facts_at and decl_facts_at are retired, SUFFICIENT FOR strategy.audit_packet audit_module_facts to read one module without v1_compiler.cli_run.keyed_module_lookup. WHAT DOES NOT RETIRE IT: a cache over the whole-pool index; a census fallback behind the keyed read.",
  current_boundary: "module_declaration_fact_at and eval_decl_facts_at (qualified-name arm) call keyed_module_lookup. The decl_facts_at type_names (bare spelling) arm and the population reads module_declaration_facts and decl_facts remain on the census by design: they genuinely need the population. Controls: keyed_module_lookup tests (two roots, second root only, nowhere, same root twice) and the ignored differential keyed_reads_equal_the_whole_pool_census against the census as offline oracle. THE UNREADABLE DERIVED FILE: keyed_decl_facts returns Result<_, DeclFactsKeyedRefusal>, so a file the key derives that cannot be read or does not parse refuses with the file, the module and the parse's own words instead of contributing nothing; the census walk keeps reading the same failure as absence, because it counts a population and names its denominator. Witnessed by keyed_decl_facts_unreadable_file_tests (a_derived_file_that_does_not_parse_refuses_rather_than_answering_empty and its positive control the_same_read_answers_the_row_when_the_derived_file_parses, both at the unchanged eval_decl_facts_at signature so the pair also runs at the pre-refusal revision) and by the two typed-shape tests added to keyed_module_lookup.tests."
}
