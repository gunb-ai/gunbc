module gunbc.public_projection


data public_projection_note: String = "Derived public projection plan over authored subjects. Requires AdmittedPublicationPolicy from admit_publication_policy — illegal policies are unrepresentable on this path. Never the unrestricted authored tree and never a pathname census: policy resolves each subject's disposition, included_subjects carries only PublishPublic rows, omitted_subjects carries WithholdPrivate rows, and projection_digest fingerprints the admitted set."

type PublicProjectionSubject {
  subject_identity: std.content_hash.ContentHash
  content_identity: std.content_hash.ContentHash
  path: std.types.FilePath
}

type PublicProjectionPlan {
  source_revision: std.types.CommitSha
  policy_version: std.types.NonEmptyStr
  included_subjects: List<PublicProjectionSubject>
  omitted_subjects: List<PublicProjectionSubject>
  projection_digest: std.content_hash.ContentHash
}

fn publication_subject_digest(subject: PublicProjectionSubject) -> std.content_hash.ContentHash {
  content_hash_tagged(
    tag: "publication-subject",
    payload: content_hash_combine_structural(
      left: content_hash_atom(value: serialize_content_hash(hash: subject.subject_identity)),
      right: content_hash_atom(value: serialize_content_hash(hash: subject.content_identity)),
    ),
  )
}

fn projection_digest_from_subjects(subjects: List<PublicProjectionSubject>) -> std.content_hash.ContentHash {
  let digests = map(subjects, subject => publication_subject_digest(subject: subject))
  as_content_hash_structural(
    structural: fold(
      sort_by(digests, digest => serialize_content_hash(hash: digest) as String),
      init: content_hash_atom(value: "public-projection" as std.types.NonEmptyStr),
      f: fn(acc, digest) {
        content_hash_combine_structural(
          left: acc,
          right: content_hash_atom(value: serialize_content_hash(hash: digest)),
        )
      },
    )
  )
}

type AuthoredSubjectPartition {
  included: List<PublicProjectionSubject>
  omitted: List<PublicProjectionSubject>
}

fn partition_authored_subjects(
  admitted: gunbc.publication_policy.AdmittedPublicationPolicy,
  authored_subjects: List<PublicProjectionSubject>,
) -> AuthoredSubjectPartition {
  fold(
    authored_subjects,
    init: AuthoredSubjectPartition { included: [], omitted: [] },
    f: fn(parts, subject) {
      match resolve_disposition_for_path(
        policy: admitted.policy,
        path: subject.path,
      ) {
        PublishPublic =>
          AuthoredSubjectPartition {
            included: append(parts.included, items: [subject]),
            omitted: parts.omitted,
          }
        WithholdPrivate =>
          AuthoredSubjectPartition {
            included: parts.included,
            omitted: append(parts.omitted, items: [subject]),
          }
      }
    },
  )
}

fn derive_public_projection_plan(
  admitted: gunbc.publication_policy.AdmittedPublicationPolicy,
  source_revision: std.types.CommitSha,
  authored_subjects: List<PublicProjectionSubject>,
) -> PublicProjectionPlan {
  let parts = partition_authored_subjects(
    admitted: admitted,
    authored_subjects: authored_subjects,
  )
  PublicProjectionPlan {
    source_revision: source_revision,
    policy_version: admitted.policy.version,
    included_subjects: parts.included,
    omitted_subjects: parts.omitted,
    projection_digest: projection_digest_from_subjects(subjects: parts.included),
  }
}

fn public_projection_includes_subject(
  plan: PublicProjectionPlan,
  subject_identity: std.content_hash.ContentHash,
) -> Bool {
  fold(plan.included_subjects, init: false, f: fn(found, subject) {
    found || subject.subject_identity == subject_identity
  })
}

fn public_projection_omits_subject(
  plan: PublicProjectionPlan,
  subject_identity: std.content_hash.ContentHash,
) -> Bool {
  fold(plan.omitted_subjects, init: false, f: fn(found, subject) {
    found || subject.subject_identity == subject_identity
  })
}
