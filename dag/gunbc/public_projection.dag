module gunbc.public_projection

import std.types { CommitSha, ContentHash, FilePath, List, NonEmptyStr }
import std.content_hash { content_hash_atom, content_hash_combine, content_hash_tagged }
import gunbc.publication_policy {
  PublicationPolicy,
  resolve_disposition_for_path,
  publication_disposition_is_public,
}

data public_projection_note: String = "Derived public projection plan over authored subjects. Never the unrestricted authored tree and never a pathname census: policy resolves each subject's disposition, included_subjects carries only PublishPublic rows, omitted_subjects carries WithholdPrivate rows, and projection_digest fingerprints the admitted set."

type PublicationSubject {
  subject_identity: ContentHash
  content_identity: ContentHash
  path: FilePath
}

type PublicProjectionPlan {
  source_revision: CommitSha
  policy_version: NonEmptyStr
  included_subjects: List<PublicationSubject>
  omitted_subjects: List<PublicationSubject>
  projection_digest: ContentHash
}

fn publication_subject_digest(subject: PublicationSubject) -> ContentHash {
  content_hash_tagged(
    tag: "publication-subject",
    payload: content_hash_combine(
      content_hash_atom(value: subject.subject_identity as NonEmptyStr),
      content_hash_atom(value: subject.content_identity as NonEmptyStr),
    ),
  )
}

fn projection_digest_from_subjects(subjects: List<PublicationSubject>) -> ContentHash {
  let digests = map(subjects, subject => publication_subject_digest(subject: subject))
  fold(
    sort_by(digests, digest => digest as String),
    init: content_hash_atom(value: "public-projection" as NonEmptyStr),
    f: fn(acc, digest) { content_hash_combine(acc, digest) },
  )
}

type AuthoredSubjectPartition {
  included: List<PublicationSubject>
  omitted: List<PublicationSubject>
}

fn partition_authored_subjects(
  policy: PublicationPolicy,
  authored_subjects: List<PublicationSubject>,
) -> AuthoredSubjectPartition {
  fold(
    authored_subjects,
    init: AuthoredSubjectPartition { included: [], omitted: [] },
    f: fn(parts, subject) {
      if publication_disposition_is_public(
        disposition: resolve_disposition_for_path(policy: policy, path: subject.path),
      ) {
        AuthoredSubjectPartition {
          included: append(parts.included, items: [subject]),
          omitted: parts.omitted,
        }
      } else {
        AuthoredSubjectPartition {
          included: parts.included,
          omitted: append(parts.omitted, items: [subject]),
        }
      }
    },
  )
}

fn derive_public_projection_plan(
  policy: PublicationPolicy,
  source_revision: CommitSha,
  authored_subjects: List<PublicationSubject>,
) -> PublicProjectionPlan {
  let parts = partition_authored_subjects(
    policy: policy,
    authored_subjects: authored_subjects,
  )
  PublicProjectionPlan {
    source_revision: source_revision,
    policy_version: policy.version,
    included_subjects: parts.included,
    omitted_subjects: parts.omitted,
    projection_digest: projection_digest_from_subjects(subjects: parts.included),
  }
}

fn public_projection_includes_subject(
  plan: PublicProjectionPlan,
  subject_identity: ContentHash,
) -> Bool {
  fold(plan.included_subjects, init: false, f: fn(found, subject) {
    found || subject.subject_identity == subject_identity
  })
}

fn public_projection_omits_subject(
  plan: PublicProjectionPlan,
  subject_identity: ContentHash,
) -> Bool {
  fold(plan.omitted_subjects, init: false, f: fn(found, subject) {
    found || subject.subject_identity == subject_identity
  })
}
