module gunbc.floor_non_verdict_enrollment

import std.types { List, String, Int }
import std.decl_ref { DeclarationRef, decl_ref, WholeDeclaration }
import std.dissolution { DissolutionCondition, unbound_dissolution }
import gunbc.seed_growth { SeedGrowthJustification }
import gunbc.roadmap_authority { RoadmapNodeId }

// AN EXPECTED-RED ENROLLMENT DISCHARGED BY AN OUTCOME THAT IS NOT A VERDICT, REPORTED AND NOT
// GATING.
//
// v1_compiler.cli_run run_required_floor routes an enrolled identity that THREW to
// known_red_runtime_errored and one that answered a non-Bool to known_red_observation_unreadable,
// and its own message says why: "Enrollment asserts an expected verdict; a claim that threw
// produced none." Both collections are printed by claim_executor report_required_floor_outcome and
// NEITHER is read by required_floor_outcome_is_clean, whose comment records the choice: they "are
// REPORTED and deliberately NOT gating", because making them block "reds lanes with no connection
// to the defect, which needs an approved design and a shadow phase rather than an author's
// judgement".
//
// THAT CHOICE IS NOT RESTATED HERE AND IS NOT DISPUTED BY THIS MODULE. What is missing is the
// DESIGN section 4b(2) obligation that comes with it: a class below its ceiling must name its
// next-rung trigger and its population, or the stall is untracked. This module carries those two
// facts and nothing else -- no gate, no roster, no second copy of the arms.
//
// WHAT THE HEADLINE LOOKS LIKE WHILE THE CLASS IS OPEN, because that is the harm and it is exactly
// the shape the same receipt line already repaired once for route gaps: the run prints failed=0,
// and a reader takes failed=0 as "nothing is broken". The correcting counters are on the same line
// (known_red_runtime_errored, known_red_observation_unreadable) -- which is why this is a stall
// rather than a silence -- but the population they count has never been sized, classified, or
// bound.

// WHAT AN ENROLLED IDENTITY ACTUALLY DID INSTEAD OF ANSWERING. One variant per cause the census
// below observed, and no variant for a cause it did not: an arm nothing measured would be
// vocabulary claiming coverage. These are causes of the THROW, not a taxonomy of witness defects --
// a name that does not resolve in the run's loaded index and a call whose contract does not match
// have different owners and different repairs, which is the whole reason the census splits them.
type NonVerdictCause
  = NameNotInLoadedIndex
  | TypeError
  | UndefinedVariable
  | CallContractMismatch

type NonVerdictCauseCount {
  cause: NonVerdictCause
  identities: Int
}

// THE POPULATION IS MEASURED, AND THE MEASUREMENT IS A SNAPSHOT OF ONE RUN -- NOT A BOUND.
//
// DESIGN section 4b(3) requires a bounded population and section 5 rules that a count copied from
// the current tree is not an oracle. Both apply here and neither is satisfied by a number: nothing
// counts a witness that starts throwing after this row was written, and nothing refuses one. So the
// basis is carried as an arm rather than implied by the presence of a figure, and the figure below
// is what the named run measured at the moment it ran.
type PopulationBasis
  = MeasuredOnOneRun { run: String, head_commit: String }
  | BoundedByRefusal { refusal: String }

// A REPAIR IS ALREADY IN FLIGHT AGAINST THIS POPULATION, AND THE ROW IS DELIBERATELY NOT
// PRE-ADJUSTED FOR IT. gunbc#9020 resolves 99 of the 142 -- measured, not projected: its branch
// head c767f4c962 runs 43 where the base runs 142, over an identical planned population of 10791.
// The figure below is what MAIN reports, which is the only population any floor run today
// measures, and writing 43 here would be a count copied from a branch that has not landed --
// exactly the fix-carrying baseline that produced the false regression this carrier was dispatched
// under. The row is re-measured when that PR merges, and the basis arm is what says it must be.
data floor_non_verdict_population_basis: PopulationBasis = MeasuredOnOneRun {
  run: "github actions witnesses.yml run 32681700364",
  head_commit: "5482863b4e8c01c91bb0261481acfd727cea552b",
}

// THE CAUSE CENSUS AS MEASURED ON THAT RUN. The sum is the run's known_red_runtime_errored figure;
// known_red_observation_unreadable was 0 on the same run, so every non-verdict identity in this
// population threw.
data floor_non_verdict_cause_census: List<NonVerdictCauseCount> = [
  { cause: NameNotInLoadedIndex, identities: 119 },
  { cause: TypeError, identities: 13 },
  { cause: UndefinedVariable, identities: 9 },
  { cause: CallContractMismatch, identities: 1 },
]

data floor_non_verdict_measured_total: Int = 142

// THE DOMINANT CAUSE IS AN AUTHORED WITNESS DEFECT, NOT A FLOOR SCOPE DEFECT, and the distinction
// is stated because it decides who owns the repair. Four of the unresolved names were checked
// against the corpus by hand: every one IS declared (gunbc.design_argument design_argument,
// gunbc.srv3_os_install_diagnostic srv3_install_hang_no_router_lease_ms,
// v2.std.algebra_laws.nat_semiring nat_add_left_identity_input,
// v2.lens.extdeps_shape_transport_policy.module_refs extdeps_cargo_build_module) and the witness
// referencing it declares no import that would bring it into the run's loaded index. The refusal is
// correct; the witness is unimportable. That is why the next-rung trigger below is not "widen the
// scope".
//
// THE SAMPLE WAS FOUR AND THE POPULATION HAS A SECOND SHAPE, recorded because four names all
// lacking imports leaves the impression that the whole class does. It does not. An independent
// census of the erroring modules (valiant-lynx-227, run 32743601436) partitions them 53 declaring
// NO import against 8 that DECLARE imports and error anyway, and cross-joining that against the
// cause census here puts SIX of those 8 inside this same no-declaration-named bucket -- so the
// bucket is not homogeneous and a repairer working from the four names above would be surprised
// by the sixth file they opened.
//
// ONE OF THE SIX READ IN FULL, so the second shape is named from evidence rather than inferred:
// `v2.lens.vacuity_test` fails on `nat_add_left_identity_input` while declaring ten imports --
// including `v2.test.nat_semiring.rung_5`, a module that REFERENCES that name but is not the
// module that DECLARES it (`v2.std.algebra_laws.nat_semiring`). Importing a module does not
// transitively supply the names ITS OWN declarations reach for. So the second shape is an
// INCOMPLETE import set rather than an absent one.
//
// THE CONCLUSION IS UNCHANGED AND SLIGHTLY STRENGTHENED: both shapes are authored defects and
// both are repaired by adding the import that declares the referenced name. Neither is a floor
// scope defect, so "widen the scope" is still the wrong trigger. What moves is the repairer's
// expectation, not the remedy. The remaining five of the six are established only as "declares
// imports AND lands in this bucket"; each one's specific missing import is unread.
data floor_non_verdict_dominant_cause_specimen: DeclarationRef = decl_ref(module_path: "test.claim.design_argument_witness", decl_name: "design_s1_argument_form_is_valid")

// RUNG, PER SEAM, AND THE GOVERNING RUNG IS THE MINIMUM ACROSS THEM.
//
// An earlier revision of this row read "the class sits at MITIGATABLE: every identity is typed,
// located and counted on the receipt line, and the line does not stop", with the gating conjunct
// named as a next rung. That was too generous, and the correction is a ruling rather than a
// rewording: THE OBSERVATION ARM IS NOT THE DEFECT. `known_red_runtime_errored` and
// `known_red_observation_unreadable` say something TRUE -- this enrolled claim produced no
// Boolean verdict. What was wrong is the COMPOSITION that read them:
//
//   routing a thrown claim into its arm ................ mitigatable
//   printing the count on the receipt line ............. mitigatable
//   printing `failed=0` without distinguishing
//     verdict incompleteness ........................... misleading projection
//   returning CLEAN while an enrolled claim
//     produced no verdict .............................. BELOW FLOOR
//
// Below floor is not a rung. It is outside the ladder and forbidden outright, so it is not a
// stall to be tracked -- which is what the earlier revision made it -- and the remedy could not
// wait on the population being repaid. A diagnostic can describe the evidence truthfully while
// the gate draws a false conclusion from it, and that gap is where this class lived.
//
// WHAT CLOSED IT, and what deliberately did not. `v2.workflow.floor_non_verdict` freezes the
// population's GROWTH at identity grain: an enrolled identity that produces no verdict and is
// not on that roster stops the line. The two arms themselves are still not gating conjuncts,
// and making them so is still not this author's call -- the ruling did not change that half.
// So 142 -> 0 is admitted in any order, 142 -> 143 refuses, and a swap that leaves the count
// unmoved refuses too, which is the case that makes the identity-grain decision load-bearing
// rather than incidental.
// THE DECISION NOW HAS TWO IMPLEMENTATIONS, AND THE CLASS RUNG IS THE MINIMUM ACROSS THEM.
//
// `v2.workflow.floor_non_verdict_admission` models the admission -- added = observed - roster,
// admit iff added is empty -- and `v1_compiler.cli_run` `non_verdict_admission` recomputes it
// over two HashSets. That is a second representation of one rule, and it is recorded here rather
// than left for a reader to notice, on exactly the footing the corpus already uses for the same
// shape: `v1_compiler.required_regen_host` `run_required_regen` mirrors its carrier's ordering BY
// HAND and is therefore only MITIGATABLE, with its next-rung trigger declared as the host being
// derived from the carrier rather than written beside it.
//
// So: the modeled half may reach a higher rung; THE SEED HALF IS MITIGATABLE UNTIL DERIVED, and
// the class rung is the minimum, which is mitigatable. What keeps that honest rather than
// nominal is that the seed half carries its OWN discriminating red -- `non_verdict_admission` is
// a pure function of two identity sets precisely so it can be refuted without a floor run, and
// `floor_non_verdict_admission_seed_path` drives growth, the equal-count swap, and the empty
// roster through the code that actually gates. What that test does NOT reach is the wiring from
// a real thrown witness into the observed set; that is the residual gap and it is named here
// rather than papered over.

// THE WALL HAS TWO AXES AND ONLY ONE OF THEM EXECUTES.
//
// OBSERVED-VS-ROSTER is walled by execution every run: the two sets must be equal, growth and
// stale exemptions both refuse. ROSTER-VS-BASE-ROSTER is not walled at all. Nothing compares the
// roster authored at HEAD against the one admitted at the MERGE BASE, so a change that makes a
// new identity stop producing a verdict may add its row in the same change, satisfy both
// executing arms, and be admitted -- the roster legalising the regression it exists to bound.
//
// That is the same shape review 55361 caught for stale rows (the row becomes the permission),
// reached through authorship instead of through survival, and it is recorded here rather than
// left for a reader to infer from the wall's name. It is also the honest price of the
// single-run design: the admission was specified against a BASE OBSERVATION, and substituting
// the roster for it is what makes the wall runnable in one pass -- sound exactly to the degree
// the roster cannot be grown freely.
//
// RUNG ON THIS AXIS: MITIGATABLE -- confined by review diligence, which is strictly weaker than
// execution. The class rung stays the minimum across axes and paths, which is mitigatable.

// THE FUTURE AUTHORITY IS THE TARGET-BASE TIP, NOT THE MERGE BASE, and an earlier revision of
// this trigger named the merge base. That is not a wording preference: EXEMPTION RESURRECTION.
// Let M be the roster at the historical merge base, B the roster at the current base tip, H the
// roster in the composed result, O the observed population.
//
//   M = {a}. Main later repairs `a` and deletes its row, so B = {}. A stale branch reintroduces
//   `a` and it throws: H = {a}, O = {a}. Then O = H passes, and H subset-of M PASSES -- readmitting
//   an exemption main has already paid off. H subset-of B fails, which is the law actually wanted.
//
// The mirror is a FALSE RED: a row main legitimately adds after the fork is in B and in the
// composed result, but not in M, so a subset-of-M rule refuses a branch that did nothing wrong.
//
// CONSEQUENCE FOR THE CUT'S SHAPE, worth knowing before it is scoped: a BRANCH-HEAD-ONLY RUN
// CANNOT ESTABLISH THIS LAW. It needs the composed result AND that result's base parent, which
// is strictly stronger than "read the roster at another commit".

data floor_non_verdict_roster_growth_next_rung_trigger: DissolutionCondition = unbound_dissolution(description: "dissolve-on: the required floor establishes H subset-of B -- the roster in the COMPOSED RESULT is a subset of the roster at that result's CURRENT TARGET-BASE PARENT -- refusing when it is not, established by execution against a discriminating red: one composed result carrying a row for an identity the base roster does not carry, refused. NOT the merge base: a merge-base baseline admits exemption resurrection, where main repairs an identity and deletes its row while a stale branch reintroduces it, and it also false-reds a row main legitimately added after the fork. Identity grain, for the same reason the observed-vs-roster admission is: an addition and a deletion in one change leave every count unmoved. RECEIPT THE CUT PINS: target_base_sha, composed_result_sha, base_roster_identity_set, result_roster_identity_set, added_exemptions = result - base; and it refuses when the base subject or its roster cannot be evaluated, the same read-failure polarity the executing arms already carry.")

data floor_non_verdict_seed_mirror_next_rung_trigger: DissolutionCondition = unbound_dissolution(description: "dissolve-on: v1_compiler.cli_run non_verdict_admission is DERIVED from v2.workflow.floor_non_verdict_admission rather than written beside it -- the same trigger v1_compiler.required_regen_host carries for its hand-mirrored ordering -- at which point the two implementations become one and the minimum-across-paths rung stops being pinned by the seed. Not satisfied by the seed's unit test alone: a discriminating red proves the mirror is correct TODAY, which is what mitigatable means, and does not make a divergence unwritable.")

data floor_non_verdict_next_rung_trigger: DissolutionCondition = unbound_dissolution(description: "dissolve-on: known_red_runtime_errored and known_red_observation_unreadable are conjuncts of v1_compiler.claim_executor required_floor_outcome_is_clean, established by execution against a discriminating red -- one enrolled identity made to throw, the run refusing. Precondition, not a follow-up: the measured population is repaid to zero first (the unresolved-name majority by giving each witness the import its subject needs, or by deleting the witness), so the conjunct lands over an empty collection rather than converting a counted silence into an uncounted red.")

// WHERE THE ARMS AND THE GATE ACTUALLY LIVE. Cited rather than copied: this module must not become
// a second account of the seed's routing, which is the fork DESIGN section 3 forbids.
data floor_non_verdict_routing_authority: DeclarationRef = decl_ref(module_path: "v1_compiler.cli_run", decl_name: "run_required_floor")

data floor_non_verdict_gate_authority: DeclarationRef = decl_ref(module_path: "v1_compiler.claim_executor", decl_name: "required_floor_outcome_is_clean")

// THE FORWARD-FREEZE ENUMERATION FOR THIS CHANGE'S HAND-AUTHORED RUST.
//
// `gunbc.seed_growth_admission` `seed_growth_forward_freeze_policy_note` requires every PR that
// adds hand-written src/v1 Rust to enumerate exact item identity, .dag authority, why Rust is
// still needed, owning lane, deletion trigger, current boundary, hand-item delta and hand-LOC
// delta -- and rules that unenumerated hand growth is a stop-line, with no netting of deletions
// against additions. This change added hand Rust and shipped without the row; review 55361
// caught it. The row is authored here, beside the obligation it declares, and joined into the
// closed roster in that module.
data floor_non_verdict_seed_growth_justification: SeedGrowthJustification = SeedGrowthJustification {
  hand_authored_declarations: [
    DeclarationRef { module_path: "v1_compiler.cli_run", decl_name: "NonVerdictAdmission", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.cli_run", decl_name: "non_verdict_admission", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.cli_run", decl_name: "non_verdict_admits", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.tests.floor_non_verdict_admission_seed_path", decl_name: "unchanged_population_is_admitted", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.tests.floor_non_verdict_admission_seed_path", decl_name: "repayment_is_admitted_and_reported_per_identity", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.tests.floor_non_verdict_admission_seed_path", decl_name: "growth_stops_the_line", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.tests.floor_non_verdict_admission_seed_path", decl_name: "a_swap_that_leaves_the_count_unmoved_still_stops_the_line", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.tests.floor_non_verdict_admission_seed_path", decl_name: "an_empty_roster_refuses_every_observed_non_verdict", field: WholeDeclaration }
  ],
  reason: "WHY RUST IS STILL NEEDED: the required floor executes in the seed. `claim_executor` is the only witness-executing consumer in the tree, so a wall that must stop THAT line has to be readable by it; a modeled admission alone would be a specification with no consumer at the point the run is admitted or refused. The rule itself is modeled in v2.workflow.floor_non_verdict_admission and this Rust is its mirror, not a second authority -- the carrier records the mirror as MITIGATABLE with derivation as its next rung, on the footing v1_compiler.required_regen_host already carries for its hand-mirrored ordering.\n\nWHY IT IS ADMITTED AGAINST THE v1 FREEZE: gunbc.v1_maintenance_standing v1_seed_standing admits a change by PURPOSE -- it serves the v2 self-host program. The required floor is the instrument that guards that program, and the defect repaired here is below floor: the composition returned CLEAN while an enrolled expected-red assertion had ceased to assert anything. This is defect repair on the self-host path, not growth of the seed for its own sake, and the roster-plumbing seam it uses is the one floor_route_gap already established.\n\nHAND-ITEM DELTA: +8, enumerated above rather than counted from what was touched. Three are production -- the admission record, the pure function over two identity sets, and the admission predicate -- and five are the unit tests that discriminate it, including the equal-count swap that a count-based implementation passes in silence.\n\nHAND-LOC DELTA: +195 in cli_run.rs, +65 in claim_executor.rs and +85 in the new test file against origin/main, a large share of it doc comments carrying the receipts and the refusal strings.\n\nWHAT IS NOT GROWTH AND IS NOT LISTED: the two new fields on RequiredFloorOutcome (non_verdict_unenrolled, stale_non_verdict), the new conjuncts inside required_floor_outcome_is_clean, the roster read, and the report lines. None of them adds a declaration -- each modifies an existing item -- so their disposition is ExistingSeedItemModified, and listing them would net modifications into an addition census.",
  owning_dissolution_lane: "v1-hand-queue-drain" as RoadmapNodeId,
  trigger: "Delete all eight declarations when the self-emitted claim executor drives the floor's execution, at which point v2.workflow.floor_non_verdict_admission is the sole authority and the seed's copy goes with the rest of the mirror. This is the same trigger the terminal ledger's seam carries and it is joined here rather than restated.",
  current_boundary: "v2.workflow.floor_non_verdict_admission non_verdict_admits -> v1_compiler.cli_run non_verdict_admission -> v1_compiler.claim_executor required_floor_outcome_is_clean"
}
