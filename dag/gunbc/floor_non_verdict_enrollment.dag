module gunbc.floor_non_verdict_enrollment

import std.types { List, String, Int }
import std.decl_ref { DeclarationRef, decl_ref }
import std.dissolution { DissolutionCondition, unbound_dissolution }

// AN EXPECTED-RED ENROLLMENT DISCHARGED BY AN OUTCOME THAT IS NOT A VERDICT, REPORTED AND NOT
// GATING.
//
// v1_compiler.cli_run run_required_floor routes an enrolled identity that THREW to
// known_red_runtime_errored and one that answered a non-Bool to known_red_observation_unreadable,
// and its own message says why: "Enrollment asserts an expected verdict; a claim that threw
// produced none." Both collections are printed by claim_executor report_required_floor_outcome and
// NEITHER is read by required_floor_outcome_is_clean, whose comment records the choice: they "are
// REPORTED and deliberately NOT gating", because making them block "reds lanes with no connection
// to the defect, which needs an approved design and a shadow phase rather than an author's
// judgement".
//
// THAT CHOICE IS NOT RESTATED HERE AND IS NOT DISPUTED BY THIS MODULE. What is missing is the
// DESIGN section 4b(2) obligation that comes with it: a class below its ceiling must name its
// next-rung trigger and its population, or the stall is untracked. This module carries those two
// facts and nothing else -- no gate, no roster, no second copy of the arms.
//
// WHAT THE HEADLINE LOOKS LIKE WHILE THE CLASS IS OPEN, because that is the harm and it is exactly
// the shape the same receipt line already repaired once for route gaps: the run prints failed=0,
// and a reader takes failed=0 as "nothing is broken". The correcting counters are on the same line
// (known_red_runtime_errored, known_red_observation_unreadable) -- which is why this is a stall
// rather than a silence -- but the population they count has never been sized, classified, or
// bound.

// WHAT AN ENROLLED IDENTITY ACTUALLY DID INSTEAD OF ANSWERING. One variant per cause the census
// below observed, and no variant for a cause it did not: an arm nothing measured would be
// vocabulary claiming coverage. These are causes of the THROW, not a taxonomy of witness defects --
// a name that does not resolve in the run's loaded index and a call whose contract does not match
// have different owners and different repairs, which is the whole reason the census splits them.
type NonVerdictCause
  = NameNotInLoadedIndex
  | TypeError
  | UndefinedVariable
  | CallContractMismatch

type NonVerdictCauseCount {
  cause: NonVerdictCause
  identities: Int
}

// THE POPULATION IS MEASURED, AND THE MEASUREMENT IS A SNAPSHOT OF ONE RUN -- NOT A BOUND.
//
// DESIGN section 4b(3) requires a bounded population and section 5 rules that a count copied from
// the current tree is not an oracle. Both apply here and neither is satisfied by a number: nothing
// counts a witness that starts throwing after this row was written, and nothing refuses one. So the
// basis is carried as an arm rather than implied by the presence of a figure, and the figure below
// is what the named run measured at the moment it ran.
type PopulationBasis
  = MeasuredOnOneRun { run: String, head_commit: String }
  | BoundedByRefusal { refusal: String }

data floor_non_verdict_population_basis: PopulationBasis = MeasuredOnOneRun {
  run: "github actions witnesses.yml run 32681700364",
  head_commit: "5482863b4e8c01c91bb0261481acfd727cea552b",
}

// THE CAUSE CENSUS AS MEASURED ON THAT RUN. The sum is the run's known_red_runtime_errored figure;
// known_red_observation_unreadable was 0 on the same run, so every non-verdict identity in this
// population threw.
data floor_non_verdict_cause_census: List<NonVerdictCauseCount> = [
  { cause: NameNotInLoadedIndex, identities: 119 },
  { cause: TypeError, identities: 13 },
  { cause: UndefinedVariable, identities: 9 },
  { cause: CallContractMismatch, identities: 1 },
]

data floor_non_verdict_measured_total: Int = 142

// THE DOMINANT CAUSE IS AN AUTHORED WITNESS DEFECT, NOT A FLOOR SCOPE DEFECT, and the distinction
// is stated because it decides who owns the repair. Four of the unresolved names were checked
// against the corpus by hand: every one IS declared (gunbc.design_argument design_argument,
// gunbc.srv3_os_install_diagnostic srv3_install_hang_no_router_lease_ms,
// v2.std.algebra_laws.nat_semiring nat_add_left_identity_input,
// v2.lens.extdeps_shape_transport_policy.module_refs extdeps_cargo_build_module) and the witness
// referencing it declares no import that would bring it into the run's loaded index. The refusal is
// correct; the witness is unimportable. That is why the next-rung trigger below is not "widen the
// scope".
data floor_non_verdict_dominant_cause_specimen: DeclarationRef = decl_ref(module_path: "test.claim.design_argument_witness", decl_name: "design_s1_argument_form_is_valid")

// RUNG. The class sits at MITIGATABLE: every identity is typed, located and counted on the receipt
// line, and the line does not stop. The ceiling is MECHANICALLY PREVENTABLE -- the gate is one
// conjunct in required_floor_outcome_is_clean and the decidability is not in question -- and the
// only thing between the two is the population above: adding the conjunct today converts 142
// counted rows into a red with no owner, which is why the arm's own comment reserves the change.
// The ordering is the work, and it is the same ordering the empty-decl-file bypass records: the
// population is repaid first, the conjunct lands last.
data floor_non_verdict_next_rung_trigger: DissolutionCondition = unbound_dissolution(description: "dissolve-on: known_red_runtime_errored and known_red_observation_unreadable are conjuncts of v1_compiler.claim_executor required_floor_outcome_is_clean, established by execution against a discriminating red -- one enrolled identity made to throw, the run refusing. Precondition, not a follow-up: the measured population is repaid to zero first (the unresolved-name majority by giving each witness the import its subject needs, or by deleting the witness), so the conjunct lands over an empty collection rather than converting a counted silence into an uncounted red.")

// WHERE THE ARMS AND THE GATE ACTUALLY LIVE. Cited rather than copied: this module must not become
// a second account of the seed's routing, which is the fork DESIGN section 3 forbids.
data floor_non_verdict_routing_authority: DeclarationRef = decl_ref(module_path: "v1_compiler.cli_run", decl_name: "run_required_floor")

data floor_non_verdict_gate_authority: DeclarationRef = decl_ref(module_path: "v1_compiler.claim_executor", decl_name: "required_floor_outcome_is_clean")
