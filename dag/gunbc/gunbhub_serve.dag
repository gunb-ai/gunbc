module gunbc.gunbhub_serve

import std.types { HttpMethod, HttpStatus, GET }
import std.http_path { PathTemplate, UrlPathToken }
import extdeps.uri_path {
  PathTemplateParseResult,
  ParsedPathTemplate,
  MalformedPathTemplate,
  parse_path_template,
}
import std.markup {
  ElementNode,
  TextNode,
  MarkupAttr,
  MarkupNode,
}
import extdeps.languages.html {
  EmitOk,
  EmitRejected,
  try_serialize_html_source,
}
import extdeps.http.server {
  HttpServerRoute,
  HttpStatusResponse,
  HttpContentType,
  TextHtmlUtf8,
  http_content_type_wire_label,
  NoRequestBody,
  TextRequestBody,
  NodeHttpServerRouteBinding,
  NodeHttpRequestListener,
  ServedStaticRoute,
  ServedStaticRouteTable,
}

type GunbhubServeRequest {
  method: HttpMethod
  path: String
}

type GunbhubHttpResponse {
  status: HttpStatus
  body: String
}

type GunbhubServeResult
  = Served { response: GunbhubHttpResponse }
  | RenderRejectedBeforeServe { reason: String }
  | RouteNotFound
  | MethodNotAllowed

type GunbhubPageSource = ReactPage { node: MarkupNode }

type GunbhubRenderResult
  = RenderedHtml { html: String }
  | RenderRejected { reason: String }

fn gunbhub_header() -> MarkupNode {
  ElementNode {
    tag: "header",
    attrs: [],
    children: [
      ElementNode {
        tag: "h1",
        attrs: [],
        children: [ TextNode { text: "gunbc" } ],
      },
      ElementNode {
        tag: "nav",
        attrs: [],
        children: [
          ElementNode {
            tag: "a",
            attrs: [ MarkupAttr { name: "href", value: "/" } ],
            children: [ TextNode { text: "Browse" } ],
          },
        ],
      },
    ],
  }
}

fn gunbhub_browse_entry(name: String, path: String) -> MarkupNode {
  ElementNode {
    tag: "li",
    attrs: [],
    children: [
      ElementNode {
        tag: "a",
        attrs: [ MarkupAttr { name: "href", value: path } ],
        children: [ TextNode { text: name } ],
      },
    ],
  }
}

fn gunbhub_browse_page() -> MarkupNode {
  ElementNode {
    tag: "html",
    attrs: [],
    children: [
      ElementNode {
        tag: "head",
        attrs: [],
        children: [
          ElementNode {
            tag: "title",
            attrs: [],
            children: [ TextNode { text: "gunbc" } ],
          },
        ],
      },
      ElementNode {
        tag: "body",
        attrs: [],
        children: [
          gunbhub_header(),
          ElementNode {
            tag: "main",
            attrs: [],
            children: [
              ElementNode {
                tag: "ul",
                attrs: [],
                children: [
                  gunbhub_browse_entry(name: "dag", path: "/dag"),
                  gunbhub_browse_entry(name: "src", path: "/src"),
                  gunbhub_browse_entry(name: "ROADMAP.md", path: "/ROADMAP.md"),
                ],
              },
            ],
          },
        ],
      },
    ],
  }
}

fn gunbhub_hostile_page() -> MarkupNode {
  ElementNode {
    tag: "a",
    attrs: [ MarkupAttr { name: "href", value: "javascript:alert(1)" } ],
    children: [ TextNode { text: "x" } ],
  }
}

fn gunbhub_readme_page() -> MarkupNode {
  ElementNode {
    tag: "html",
    attrs: [],
    children: [
      ElementNode {
        tag: "head",
        attrs: [],
        children: [
          ElementNode {
            tag: "title",
            attrs: [],
            children: [ TextNode { text: "gunbc — README" } ],
          },
        ],
      },
      ElementNode {
        tag: "body",
        attrs: [],
        children: [
          gunbhub_header(),
          ElementNode {
            tag: "main",
            attrs: [],
            children: [
              ElementNode {
                tag: "article",
                attrs: [],
                children: [
                  ElementNode {
                    tag: "p",
                    attrs: [],
                    children: [
                      TextNode {
                        text: "DAG-modeled compiler and language project. Rust is bootstrap seed.",
                      },
                    ],
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
  }
}

type GunbhubComposeResult
  = ComposedOk { html: String }
  | ComposeRejected { reason: String }

fn gunbhub_compose_body(node: MarkupNode) -> GunbhubComposeResult {
  match try_serialize_html_source(node: node) {
    EmitOk { html: h } => ComposedOk { html: h }
    EmitRejected { reason: r } => ComposeRejected { reason: r }
  }
}

fn gunbhub_html_content_type() -> HttpContentType {
  TextHtmlUtf8
}

fn gunbhub_browse_path_template() -> PathTemplate {
  match parse_path_template(raw: "/") {
    ParsedPathTemplate { template: t } => t
    MalformedPathTemplate { raw: _, segment: _, reason: _ } =>
      PathTemplate { tokens: [] }
  }
}

fn gunbhub_repo_path_template() -> PathTemplate {
  PathTemplate { tokens: [ParamToken { name: "repo-path" }] }
}

fn normalize_request_path(path: String) -> String {
  if path == "" {
    "/"
  } else {
    path
  }
}

fn request_path_segments(path: String) -> List<String> {
  let path_only = match split(s: normalize_request_path(path: path), delimiter: "?") |> first {
    Present { value: p } => p
    Absent => normalize_request_path(path: path)
  }
  if path_only == "/" {
    []
  } else {
    filter(xs: split(s: path_only, delimiter: "/"), f: s => s != "")
  }
}

type PathMatchState {
  seg_idx: Int
  ok: Bool
}

fn path_matches_template(template: PathTemplate, path: String) -> Bool {
  let segs = request_path_segments(path: path)
  let st = fold(
    xs: template.tokens,
    init: PathMatchState { seg_idx: 0, ok: true },
    f: (acc, tok) =>
      if !acc.ok {
        acc
      } else {
        match tok {
          ParamToken { name: _ } =>
            match segs |> skip(acc.seg_idx) |> first {
              Present { value: _ } =>
                PathMatchState { seg_idx: acc.seg_idx + 1, ok: true }
              Absent =>
                PathMatchState { seg_idx: acc.seg_idx, ok: false }
            }
          LiteralToken { text: lit } =>
            match segs |> skip(acc.seg_idx) |> first {
              Present { value: seg } =>
                if seg == lit {
                  PathMatchState { seg_idx: acc.seg_idx + 1, ok: true }
                } else {
                  PathMatchState { seg_idx: acc.seg_idx, ok: false }
                }
              Absent =>
                PathMatchState { seg_idx: acc.seg_idx, ok: false }
            }
        }
      }
  )
  st.ok && st.seg_idx == count(xs: segs)
}

fn render_gunbhub_page(source: GunbhubPageSource) -> GunbhubRenderResult {
  match source {
    ReactPage { node } =>
      match try_serialize_html_source(node: node) {
        EmitOk { html: h } => RenderedHtml { html: h }
        EmitRejected { reason: r } => RenderRejected { reason: r }
      }
  }
}

fn serve_gunbhub_page_source(source: GunbhubPageSource) -> GunbhubServeResult {
  match render_gunbhub_page(source: source) {
    RenderedHtml { html: h } =>
      Served {
        response: GunbhubHttpResponse {
          status: 200,
          body: h,
        }
      }
    RenderRejected { reason: r } => RenderRejectedBeforeServe { reason: r }
  }
}

type GunbhubRouteRow {
  route: HttpServerRoute
  page: GunbhubPageSource
}

fn gunbhub_browse_route() -> HttpServerRoute {
  HttpServerRoute {
    operation_name: "browseRoot",
    method: GET,
    path_template: gunbhub_browse_path_template(),
    request_body: NoRequestBody,
    parameters: [],
    responses: [
      HttpStatusResponse { status: 200, body_kind: TextRequestBody },
    ],
  }
}

fn gunbhub_repo_path_route() -> HttpServerRoute {
  HttpServerRoute {
    operation_name: "repoPathDoc",
    method: GET,
    path_template: gunbhub_repo_path_template(),
    request_body: NoRequestBody,
    parameters: [],
    responses: [
      HttpStatusResponse { status: 200, body_kind: TextRequestBody },
    ],
  }
}

fn gunbhub_route_table() -> List<GunbhubRouteRow> {
  [
    GunbhubRouteRow {
      route: gunbhub_browse_route(),
      page: ReactPage { node: gunbhub_browse_page() },
    },
    GunbhubRouteRow {
      route: gunbhub_repo_path_route(),
      page: ReactPage { node: gunbhub_readme_page() },
    },
  ]
}

fn gunbhub_served_static_route_table() -> ServedStaticRouteTable {
  let routes = fold(
    xs: gunbhub_route_table(),
    init: [],
    f: (acc, row) =>
      match try_serialize_html_source(
        node: match row.page { ReactPage { node: n } => n }
      ) {
        EmitOk { html: h } =>
          concat(
            acc,
            [
              ServedStaticRoute {
                method: row.route.method,
                path_pattern: row.route.path_template,
                body: h,
                content_type: gunbhub_html_content_type(),
                status_on_hit: 200,
              },
            ]
          )
        EmitRejected { reason: _ } => acc
      }
  )
  ServedStaticRouteTable { routes: routes }
}

fn served_row_matches_request(row: ServedStaticRoute, req: GunbhubServeRequest) -> Bool {
  row.method == req.method
    && path_matches_template(template: row.path_pattern, path: req.path)
}

fn path_matches_any_served_pattern(path: String, table: ServedStaticRouteTable) -> Bool {
  fold(
    xs: table.routes,
    init: false,
    f: (acc, row) =>
      if acc {
        acc
      } else {
        path_matches_template(template: row.path_pattern, path: path)
      }
  )
}

type StaticRouteMatchState {
  found: Bool
  body: String
  status: HttpStatus
}

fn serve_gunbhub_request(req: GunbhubServeRequest) -> GunbhubServeResult {
  let table = gunbhub_served_static_route_table()
  let st = fold(
    xs: table.routes,
    init: StaticRouteMatchState { found: false, body: "", status: 404 },
    f: (acc, row) =>
      if acc.found {
        acc
      } else if served_row_matches_request(row: row, req: req) {
        StaticRouteMatchState {
          found: true,
          body: row.body,
          status: row.status_on_hit,
        }
      } else {
        acc
      }
  )
  if st.found {
    Served {
      response: GunbhubHttpResponse {
        status: st.status,
        body: st.body,
      }
    }
  } else if path_matches_any_served_pattern(path: req.path, table: table) {
    MethodNotAllowed
  } else {
    RouteNotFound
  }
}

fn gunbhub_node_route_bindings() -> List<NodeHttpServerRouteBinding> {
  map(
    xs: gunbhub_route_table(),
    f: row =>
      NodeHttpServerRouteBinding {
        route: row.route,
        listener: NodeHttpRequestListener {
          handler_name: concat("gunbhub_handle_", row.route.operation_name),
        },
      }
  )
}
