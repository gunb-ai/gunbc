module gunbc.runner_slot_provision


// RunnerSlotProvision owns runner installation end-to-end in gunbc (operator ruling 2026-08-06:
// ctrl is a dead repo; prior ctrl:install-actions-runner citations are void legacy pointers).
// Per slot: cited ActionsRunnerRelease fetch+verify, base dir, extract, ownership, per-slot caps
// BEFORE systemctl enable. srv3/srv4 materialization target is 6 slots; srv4 disk binding is
// apply-time preflight in gunbc.runner_lifecycle runner_width_disk_preflight (not a row pin).

data runner_slot_provision_scaffold: std.disposition.Disposition = std.disposition.Scaffold {
  dissolves_to: std.disposition.SingleAuthority,
  bind: std.decl_ref.DeclarationRef {
    module_path: "gunbc.host_effect",
    decl_name: "host_effect_apply",
    field: std.decl_ref.WholeDeclaration,
  }
}

type RunnerSlotMemberAt = std.types.NonEmptyStr

type RunnerSlotMember {
  instance_name: std.types.NonEmptyStr
  slot_dir: std.types.NonEmptyStr
}

type RunnerSlotObservation
  = RunnerSlotsObserved { members: List<RunnerSlotMember> }
  | RunnerSlotsUnobserved { reason: std.types.NonEmptyStr }

fn runner_slot_instance_dir(instance_name: std.types.NonEmptyStr) -> std.types.NonEmptyStr {
  join([extdeps.github.actions_runner.actions_runner_base_dir, "/", instance_name as String], "") as std.types.NonEmptyStr
}

fn runner_slot_member_from_instance_name(instance_name: String) -> RunnerSlotMember {
  let name = instance_name as std.types.NonEmptyStr
  RunnerSlotMember {
    instance_name: name,
    slot_dir: runner_slot_instance_dir(instance_name: name),
  }
}

// THE FABRIC SLOT IS NOT A PROVISIONING TARGET, AND UNTIL 2026-08-23 IT WAS ONE.
//
// This mapped runner_instance_names straight through, so desired was 1..runner_count and nothing
// asked what any of those slots was FOR. gunbc.runner_slot_allocation authors srv3-06 as
// SlotServesFabricExecution, so the desired set proposed installing a GitHub Actions runner ON TOP
// OF THE FABRIC EXECUTION SLOT -- and reconcile would have seen it as an ordinary missing member,
// so apply would have done it with no refusal anywhere.
//
// That is the count-as-authority failure runner_slot_allocation exists to prevent, reintroduced one
// layer above it. Its own note records the first occurrence: purpose was derived by comparing index
// against count, so the fabric slot MOVED WITH THE WIDTH -- at width 7, srv3-07 would have become
// fabric and srv3-06 would have been silently handed back to Actions, relabelling a slot that may be
// running work. The carve was made an AUTHORED identity so a width change could not do that. This
// module then consumed the width and ignored the carve, reaching the same outcome by the other road.
//
// THE FILTER IS ON THE FABRIC ROLE, NOT ON COMMITTED MEMBERSHIP, and that choice is load-bearing.
// Filtering on runner_slot_membership would ask the allocation authority whether each index is
// within the host's committed width -- which is the same question runner_count already answered, and
// which yields ZERO desired members for any host the fleet model does not know. The reconcile
// fixtures deliberately plant their own synthetic deploy row (host_label "wfix") precisely so their
// expected counts are literals authored beside a known input rather than a restatement of the live
// fleet; routing desired through the global width authority would have silently emptied them and
// turned four exact-count fixtures green-by-vacuity.
//
// So the width still comes from the deploy row, which already derives it from
// gunbc_runner_slots_per_host, and this function removes exactly the identities that are spoken for.
// Two questions, two answers: how many slots does this host carry, and which of them are Actions
// runners.
//
// It works on INDICES rather than on rendered names, so the fabric identity is compared as an
// identity and never by parsing a slot number back out of a string it was just formatted into.
//
// CONSEQUENCE ON THE FLEET: srv3 desires twenty against a committed width of twenty-one. srv1, srv2
// and srv4 carry no fabric member and are unchanged.
fn desired_runner_slot_members(deploy: gunbc.runner_host_deploy.RunnerHostDeploy) -> List<RunnerSlotMember> {
  let host = deploy.host_label as product.placement_supply.HostIdentity
  map(
    filter(
      gunbc.runner_host_deploy.runner_index_seq(n: deploy.runner_count),
      i => !gunbc.runner_slot_allocation.identity_is_fabric_execution_member(
        identity: gunbc.build_cache_instance.RunnerSlotIdentity { host: host, slot_index: i },
      ),
    ),
    i => runner_slot_member_from_instance_name(
      instance_name: gunbc.build_cache_instance.runner_slot_instance_name(
        slot: gunbc.build_cache_instance.RunnerSlotIdentity { host: host, slot_index: i },
      ),
    ),
  )
}

fn runner_slot_member_key(m: RunnerSlotMember) -> std.types.NonEmptyStr {
  m.instance_name
}

fn runner_slot_member_key_eq(a: std.types.NonEmptyStr, b: std.types.NonEmptyStr) -> Bool {
  a as String == b as String
}

fn runner_slot_member_value_eq(a: RunnerSlotMember, b: RunnerSlotMember) -> Bool {
  a.slot_dir as String == b.slot_dir as String
}

data runner_slot_member_ownership_scaffold_note: String = "Ownership is NOT asserted for every observed slot-dir under /opt/actions-runner. R5 teardown-owned-only requires a provenance signal (gunbc-managed systemd drop-in + unit template this lane writes) before apply lands; until host_effect observation can read that signal, ownership_of returns Absent so Removed out-of-band dirs yield MemberRemovalRefused rather than fabricated Owned (review 49707)."

fn runner_slot_member_ownership(m: RunnerSlotMember) -> gunbc.ownership.Ownership? {
  Absent
}

fn runner_slot_membership_reconcile(
  desired: List<RunnerSlotMember>,
  observed: List<RunnerSlotMember>,
) -> gunbc.membership_reconcile.MembershipPlan<RunnerSlotMember, RunnerSlotMemberAt> {
  gunbc.membership_reconcile.membership_plan_admitting_outcome(
    outcome: gunbc.membership_reconcile.membership_reconcile(
      desired: desired,
      observed: observed,
      key_of: runner_slot_member_key,
      key_eq: runner_slot_member_key_eq,
      value_eq: runner_slot_member_value_eq,
      ownership_of: runner_slot_member_ownership,
    ),
  )
}

type RunnerSlotEnumerationPostcondition
  = RunnerSlotEnumerationMatched
  | RunnerSlotEnumerationMismatch {
      host: product.placement_supply.HostIdentity
      declared_count: Int
      observed_count: Int
    }

fn runner_slot_enumeration_postcondition(
  host: product.placement_supply.HostIdentity,
  observed: List<RunnerSlotMember>,
) -> RunnerSlotEnumerationPostcondition {
  let declared = gunbc.fleet_host_budget.declared_runner_count_for(host: host)
  let observed_count = length(observed)
  if observed_count == declared {
    RunnerSlotEnumerationMatched
  } else {
    RunnerSlotEnumerationMismatch {
      host: host,
      declared_count: declared,
      observed_count: observed_count,
    }
  }
}

type RunnerSlotProvisionPlan {
  host_label: std.types.NonEmptyStr
  membership: gunbc.membership_reconcile.MembershipPlan<RunnerSlotMember, RunnerSlotMemberAt>
  base_dir_script: String
  upsert_extract_scripts: List<String>
}

// THE ONE PLACE THE GRANT ROSTER MEETS THE INSTALL SHAPE. extdeps.github.actions_runner describes
// what runner installation IS; this module knows which principal performs it here and therefore
// which binaries that principal is permitted to execute. Both paths come from the closed
// CiRunnerSudoBinary vocabulary, so a verb with no grant row has no spelling at this seam.
// THE COMMANDS THE SCRIPT RUNS ARE PROJECTED FROM THE SAME OPERATION ROW THE SUDOERS GRANT IS.
// This function is the seam: gunbc.executor_privileged_operation owns the operation, and both the
// executed shell word-vector and the authorizing sudoers match are DERIVED from its argv. Before
// this, extdeps rebuilt the argv from two binary paths while the roster granted the binary alone,
// so the script could name a command the principal was not authorized to run -- measured on srv3,
// an add-only apply refused at the first sudo with zero slots mutated.
fn gunbc_runner_slot_privileged_commands(
  slot_dir: NonEmptyStr,
  job_user: NonEmptyStr,
) -> ActionsRunnerSlotPrivilegedCommands {
  ActionsRunnerSlotPrivilegedCommands {
    remove_command: executor_privileged_operation_shell_command(
      op: RemoveDirectoryTree { path: slot_dir },
    ),
    install_command: executor_privileged_operation_shell_command(
      op: EnsureOwnedDirectory {
        path: slot_dir,
        owner: job_user,
        group: job_user,
        mode: executor_managed_directory_mode,
      },
    ),
  }
}

fn runner_slot_provision_plan(
  deploy: gunbc.runner_host_deploy.RunnerHostDeploy,
  artifact: extdeps.github.actions_runner.ActionsRunnerBinaryArtifact,
  observed: List<RunnerSlotMember>,
) -> RunnerSlotProvisionPlan {
  let membership = runner_slot_membership_reconcile(
    desired: desired_runner_slot_members(deploy: deploy),
    observed: observed,
  )
  RunnerSlotProvisionPlan {
    host_label: deploy.host_label,
    membership: membership,
    base_dir_script: actions_runner_base_dir_ensure_script(
      base_install_command: executor_privileged_operation_shell_command(
        op: gunbc.executor_privileged_operation.EnsureOwnedDirectory {
          path: actions_runner_base_dir as std.types.NonEmptyStr,
          owner: deploy.runner_user,
          group: deploy.runner_user,
          mode: executor_managed_directory_mode,
        },
      ),
      cache_install_command: executor_privileged_operation_shell_command(
        op: gunbc.executor_privileged_operation.EnsureOwnedDirectory {
          path: actions_runner_cache_dir as std.types.NonEmptyStr,
          owner: deploy.runner_user,
          group: deploy.runner_user,
          mode: executor_managed_directory_mode,
        },
      ),
    ),
    upsert_extract_scripts: flat_map(membership.actions, a =>
      match a {
        gunbc.membership_reconcile.MemberAdded { at: _, to: m } =>
          [extdeps.github.actions_runner.actions_runner_slot_extract_script(
            artifact: artifact,
            slot_dir: m.slot_dir,
            privileged: gunbc_runner_slot_privileged_commands(
              slot_dir: m.slot_dir,
              job_user: deploy.job_user,
            ),
          )]
        gunbc.membership_reconcile.MemberChanged { at: _, from: _, to: _ } => []
        gunbc.membership_reconcile.MemberRemoved { at: _, from: _ } => []
        gunbc.membership_reconcile.MemberRemovalRefused { from: _, cause: _ } => []
        MemberRosterDuplicateKeyRefused { roster: _, first: _, duplicate: _ } => []
      }
    ),
  }
}

fn runner_slot_provision_has_width_increase(plan: RunnerSlotProvisionPlan) -> Bool {
  gunbc.membership_reconcile.membership_added_count(plan: plan.membership) > 0
}

// --- observation: the third converge member family -------------------------------------------

data runner_slot_observation_refuses_note: String = "AN UNREADABLE HOST REFUSES; AN EMPTY HOST DOES NOT. These are different states and collapsing them is the empty-observation narrow: rendering 'I could not enumerate the slots' as 'this host has no slots' makes the reconcile propose ADDING every desired slot to a machine whose real population was never read, which on apply means installing over a live fleet. RunnerSlotsUnobserved carries the CAUSE AND NOT THE HOST, which is a correction rather than an omission: this observer runs LocalExec against whatever machine it is on and has no way to name that machine, so a host field here could only ever be fabricated. It was, briefly -- as the empty string -- and the empty string is not even a HostIdentity, so the fabrication refused to typecheck, which is the carrier shape doing the work a review would otherwise have had to do. The caller knows which host it is converging and supplies it; the observation reports only what it actually established. RunnerSlotsObserved with an empty list is a genuine answer about a genuinely empty host.\n\nTHE SIBLING FAMILIES DO NOT DRAW THIS LINE AND THAT IS THE DEFECT NOT TO COPY. gunbc.fleet_converge_plan_cli observe_cap_members_wet yields [] both when a drop-in is absent and when it cannot be read, and observe_timer_members_wet filters on a test that cannot distinguish 'no such unit' from 'could not run the test'. Those are tolerable for caps because an absent drop-in is the common real state; they are not tolerable for slots, where absent means 'provision it'.\n\nENUMERATION IS BY DIRECTORY, NOT BY PROBING THE DESIRED NAMES. Asking 'does each name I expect exist' can only ever return a subset of what I already intended, so an out-of-band slot -- one nobody desired -- would be invisible and could never be reported as MemberRemoved. Listing the base directory is what makes the observed population independent of the desired one, which is the whole point of a reconcile."

func observe_runner_slot_members_wet() -> RunnerSlotObservation
  uses net: Network
{
  match gunbc.command_runner.run_shell_command_capture(
    command: extdeps.tools.gnu_coreutils.ls_one_per_line_command(path: extdeps.github.actions_runner.actions_runner_base_dir),
    transport: extdeps.exec.command.LocalExec,
  ) {
    extdeps.shell.exec.ProcessRefused { exit_code: code, stderr: err } =>
      RunnerSlotsUnobserved {
        reason: concat(
          concat("could not enumerate ", extdeps.github.actions_runner.actions_runner_base_dir),
          concat(": the listing refused rather than returning an empty directory, so this host's slot population is UNKNOWN and must not be read as empty. stderr: ", err)
        ) as std.types.NonEmptyStr,
      }
    extdeps.shell.exec.ProcessOutputAbsent =>
      RunnerSlotsUnobserved {
        reason: concat(
          concat("enumerating ", extdeps.github.actions_runner.actions_runner_base_dir),
          " produced no output at all -- not an empty listing, which would be an empty string. A command that yields nothing has not answered the question, and treating it as 'no slots' would propose installing every desired slot onto a host whose population was never read."
        ) as std.types.NonEmptyStr,
      }
    extdeps.shell.exec.ProcessOutputPresent { text: t } =>
      RunnerSlotsObserved {
        members: map(
          filter(t.split("\n"), l => std.algebra.trim(s: l) != ""),
          l => runner_slot_member_from_instance_name(instance_name: std.algebra.trim(s: l)),
        ),
      }
  }
}

type RunnerSlotConvergeVerdict
  = RunnerSlotConvergePlanned { host: product.placement_supply.HostIdentity, plan: RunnerSlotProvisionPlan }
  | RunnerSlotConvergeRefused { host: product.placement_supply.HostIdentity, reason: std.types.NonEmptyStr }

data runner_slot_converge_verdict_note: String = "THE REFUSAL ARM IS THE REASON THIS FUNCTION EXISTS RATHER THAN CALLERS COMPOSING THE TWO HALVES THEMSELVES. A caller holding an observation and a deploy row can always pass the observed members straight into runner_slot_provision_plan, and the unobserved case would then be a list nobody looked at. Routing both through one verdict means the only way to reach a plan is to have actually read the host, and an unmodeled host or an unreadable directory produces a refusal that names which it was."

fn runner_slot_converge_verdict(
  host: product.placement_supply.HostIdentity,
  deploy: gunbc.runner_host_deploy.RunnerHostDeploy,
  artifact: extdeps.github.actions_runner.ActionsRunnerBinaryArtifact,
  observation: RunnerSlotObservation,
) -> RunnerSlotConvergeVerdict {
  match observation {
    RunnerSlotsUnobserved { reason: r } =>
      RunnerSlotConvergeRefused { host: host, reason: r }
    RunnerSlotsObserved { members: obs } =>
      RunnerSlotConvergePlanned {
        host: host,
        plan: runner_slot_provision_plan(deploy: deploy, artifact: artifact, observed: obs),
      }
  }
}
