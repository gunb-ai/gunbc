module gunbc.runner_slot_provision


// RunnerSlotProvision owns runner installation end-to-end in gunbc (operator ruling 2026-08-06:
// ctrl is a dead repo; prior ctrl:install-actions-runner citations are void legacy pointers).
// Per slot: cited ActionsRunnerRelease fetch+verify, base dir, extract, ownership, per-slot caps
// BEFORE systemctl enable. srv3/srv4 materialization target is 6 slots; srv4 disk binding is
// apply-time preflight in gunbc.runner_lifecycle runner_width_disk_preflight (not a row pin).

data runner_slot_provision_scaffold: std.disposition.Disposition = std.disposition.Scaffold {
  dissolves_to: std.disposition.SingleAuthority,
  bind: std.decl_ref.DeclarationRef {
    module_path: "gunbc.host_effect",
    decl_name: "host_effect_apply",
    field: std.decl_ref.WholeDeclaration,
  }
}

type RunnerSlotMemberAt = std.types.NonEmptyStr

type RunnerSlotMember {
  instance_name: std.types.NonEmptyStr
  slot_dir: std.types.NonEmptyStr
}

type RunnerSlotObservation
  = RunnerSlotsObserved { members: std.types.List<RunnerSlotMember> }
  | RunnerSlotsUnobserved { host: product.placement_supply.HostIdentity, reason: std.types.NonEmptyStr }

fn runner_slot_instance_dir(instance_name: std.types.NonEmptyStr) -> std.types.NonEmptyStr {
  join([extdeps.github.actions_runner.actions_runner_base_dir, "/", instance_name as String], "") as std.types.NonEmptyStr
}

fn runner_slot_member_from_instance_name(instance_name: String) -> RunnerSlotMember {
  let name = instance_name as std.types.NonEmptyStr
  RunnerSlotMember {
    instance_name: name,
    slot_dir: runner_slot_instance_dir(instance_name: name),
  }
}

fn desired_runner_slot_members(deploy: gunbc.runner_host_deploy.RunnerHostDeploy) -> std.types.List<RunnerSlotMember> {
  map(
    gunbc.runner_host_deploy.runner_instance_names(deploy: deploy),
    n => runner_slot_member_from_instance_name(instance_name: n),
  )
}

fn runner_slot_member_key(m: RunnerSlotMember) -> std.types.NonEmptyStr {
  m.instance_name
}

fn runner_slot_member_key_eq(a: std.types.NonEmptyStr, b: std.types.NonEmptyStr) -> std.types.Bool {
  a as String == b as String
}

fn runner_slot_member_value_eq(a: RunnerSlotMember, b: RunnerSlotMember) -> std.types.Bool {
  a.slot_dir as String == b.slot_dir as String
}

data runner_slot_member_ownership_scaffold_note: String = "Ownership is NOT asserted for every observed slot-dir under /opt/actions-runner. R5 teardown-owned-only requires a provenance signal (gunbc-managed systemd drop-in + unit template this lane writes) before apply lands; until host_effect observation can read that signal, ownership_of returns Absent so Removed out-of-band dirs yield MemberRemovalRefused rather than fabricated Owned (review 49707)."

fn runner_slot_member_ownership(m: RunnerSlotMember) -> gunbc.ownership.Ownership? {
  Absent
}

fn runner_slot_membership_reconcile(
  desired: std.types.List<RunnerSlotMember>,
  observed: std.types.List<RunnerSlotMember>,
) -> gunbc.membership_reconcile.MembershipPlan<RunnerSlotMember, RunnerSlotMemberAt> {
  gunbc.membership_reconcile.membership_plan_admitting_outcome(
    outcome: gunbc.membership_reconcile.membership_reconcile(
      desired: desired,
      observed: observed,
      key_of: runner_slot_member_key,
      key_eq: runner_slot_member_key_eq,
      value_eq: runner_slot_member_value_eq,
      ownership_of: runner_slot_member_ownership,
    ),
  )
}

type RunnerSlotEnumerationPostcondition
  = RunnerSlotEnumerationMatched
  | RunnerSlotEnumerationMismatch {
      host: product.placement_supply.HostIdentity
      declared_count: Int
      observed_count: Int
    }

fn runner_slot_enumeration_postcondition(
  host: product.placement_supply.HostIdentity,
  observed: std.types.List<RunnerSlotMember>,
) -> RunnerSlotEnumerationPostcondition {
  let declared = gunbc.fleet_host_budget.declared_runner_count_for(host: host)
  let observed_count = length(observed)
  if observed_count == declared {
    RunnerSlotEnumerationMatched
  } else {
    RunnerSlotEnumerationMismatch {
      host: host,
      declared_count: declared,
      observed_count: observed_count,
    }
  }
}

type RunnerSlotProvisionPlan {
  host_label: std.types.NonEmptyStr
  membership: gunbc.membership_reconcile.MembershipPlan<RunnerSlotMember, RunnerSlotMemberAt>
  base_dir_script: String
  upsert_extract_scripts: std.types.List<String>
}

fn runner_slot_provision_plan(
  deploy: gunbc.runner_host_deploy.RunnerHostDeploy,
  artifact: extdeps.github.actions_runner.ActionsRunnerBinaryArtifact,
  observed: std.types.List<RunnerSlotMember>,
) -> RunnerSlotProvisionPlan {
  let membership = runner_slot_membership_reconcile(
    desired: desired_runner_slot_members(deploy: deploy),
    observed: observed,
  )
  RunnerSlotProvisionPlan {
    host_label: deploy.host_label,
    membership: membership,
    base_dir_script: extdeps.github.actions_runner.actions_runner_base_dir_ensure_script(runner_user: deploy.runner_user),
    upsert_extract_scripts: flat_map(membership.actions, a =>
      match a {
        MemberAdded { at: _, to: m } =>
          [extdeps.github.actions_runner.actions_runner_slot_extract_script(
            artifact: artifact,
            slot_dir: m.slot_dir,
            job_user: deploy.job_user,
          )]
        gunbc.membership_reconcile.MemberChanged { at: _, from: _, to: _ } => []
        gunbc.membership_reconcile.MemberRemoved { at: _, from: _ } => []
        gunbc.membership_reconcile.MemberRemovalRefused { from: _, cause: _ } => []
        MemberRosterDuplicateKeyRefused { roster: _, first: _, duplicate: _ } => []
      }
    ),
  }
}

fn runner_slot_provision_has_width_increase(plan: RunnerSlotProvisionPlan) -> std.types.Bool {
  gunbc.membership_reconcile.membership_added_count(plan: plan.membership) > 0
}
