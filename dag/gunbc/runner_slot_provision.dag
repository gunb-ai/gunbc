module gunbc.runner_slot_provision

import std.types { NonEmptyStr, String, List, Bool, Int }
import std.disposition { Disposition, Scaffold, SingleAuthority }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import gunbc.membership_reconcile {
  MembershipPlan,
  MemberAdded,
  MemberChanged,
  MemberRemoved,
  MemberRemovalRefused,
  membership_reconcile,
  membership_plan_admitting_outcome,
  membership_added_count,
}
import gunbc.ownership { Ownership }
import gunbc.runner_host_deploy {
  RunnerHostDeploy,
  runner_instance_names,
}
import extdeps.github.actions_runner {
  ActionsRunnerBinaryArtifact,
  actions_runner_release_2_334_0,
  actions_runner_base_dir,
  actions_runner_base_dir_ensure_script,
  actions_runner_slot_extract_script,
}
import product.placement_supply { HostIdentity }
import gunbc.fleet_host_budget { declared_runner_count_for }

// RunnerSlotProvision owns runner installation end-to-end in gunbc (operator ruling 2026-08-06:
// ctrl is a dead repo; prior ctrl:install-actions-runner citations are void legacy pointers).
// Per slot: cited ActionsRunnerRelease fetch+verify, base dir, extract, ownership, per-slot caps
// BEFORE systemctl enable. srv3/srv4 materialization target is 6 slots; srv4 disk binding is
// apply-time preflight in gunbc.runner_lifecycle runner_width_disk_preflight (not a row pin).

data runner_slot_provision_scaffold: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.host_effect",
    decl_name: "host_effect_apply",
    field: WholeDeclaration,
  }
}

type RunnerSlotMemberAt = NonEmptyStr

type RunnerSlotMember {
  instance_name: NonEmptyStr
  slot_dir: NonEmptyStr
}

type RunnerSlotObservation
  = RunnerSlotsObserved { members: List<RunnerSlotMember> }
  | RunnerSlotsUnobserved { host: HostIdentity, reason: NonEmptyStr }

fn runner_slot_instance_dir(instance_name: NonEmptyStr) -> NonEmptyStr {
  join([actions_runner_base_dir, "/", instance_name as String], "") as NonEmptyStr
}

fn runner_slot_member_from_instance_name(instance_name: String) -> RunnerSlotMember {
  let name = instance_name as NonEmptyStr
  RunnerSlotMember {
    instance_name: name,
    slot_dir: runner_slot_instance_dir(instance_name: name),
  }
}

fn desired_runner_slot_members(deploy: RunnerHostDeploy) -> List<RunnerSlotMember> {
  map(
    runner_instance_names(deploy: deploy),
    n => runner_slot_member_from_instance_name(instance_name: n),
  )
}

fn runner_slot_member_key(m: RunnerSlotMember) -> NonEmptyStr {
  m.instance_name
}

fn runner_slot_member_key_eq(a: NonEmptyStr, b: NonEmptyStr) -> Bool {
  a as String == b as String
}

fn runner_slot_member_value_eq(a: RunnerSlotMember, b: RunnerSlotMember) -> Bool {
  a.slot_dir as String == b.slot_dir as String
}

data runner_slot_member_ownership_scaffold_note: String = "Ownership is NOT asserted for every observed slot-dir under /opt/actions-runner. R5 teardown-owned-only requires a provenance signal (gunbc-managed systemd drop-in + unit template this lane writes) before apply lands; until host_effect observation can read that signal, ownership_of returns Absent so Removed out-of-band dirs yield MemberRemovalRefused rather than fabricated Owned (review 49707)."

fn runner_slot_member_ownership(m: RunnerSlotMember) -> Ownership? {
  Absent
}

fn runner_slot_membership_reconcile(
  desired: List<RunnerSlotMember>,
  observed: List<RunnerSlotMember>,
) -> MembershipPlan<RunnerSlotMember, RunnerSlotMemberAt> {
  membership_plan_admitting_outcome(
    outcome: membership_reconcile(
      desired: desired,
      observed: observed,
      key_of: runner_slot_member_key,
      key_eq: runner_slot_member_key_eq,
      value_eq: runner_slot_member_value_eq,
      ownership_of: runner_slot_member_ownership,
    ),
  )
}

type RunnerSlotEnumerationPostcondition
  = RunnerSlotEnumerationMatched
  | RunnerSlotEnumerationMismatch {
      host: HostIdentity
      declared_count: Int
      observed_count: Int
    }

fn runner_slot_enumeration_postcondition(
  host: HostIdentity,
  observed: List<RunnerSlotMember>,
) -> RunnerSlotEnumerationPostcondition {
  let declared = declared_runner_count_for(host: host)
  let observed_count = length(observed)
  if observed_count == declared {
    RunnerSlotEnumerationMatched
  } else {
    RunnerSlotEnumerationMismatch {
      host: host,
      declared_count: declared,
      observed_count: observed_count,
    }
  }
}

type RunnerSlotProvisionPlan {
  host_label: NonEmptyStr
  membership: MembershipPlan<RunnerSlotMember, RunnerSlotMemberAt>
  base_dir_script: String
  upsert_extract_scripts: List<String>
}

fn runner_slot_provision_plan(
  deploy: RunnerHostDeploy,
  artifact: ActionsRunnerBinaryArtifact,
  observed: List<RunnerSlotMember>,
) -> RunnerSlotProvisionPlan {
  let membership = runner_slot_membership_reconcile(
    desired: desired_runner_slot_members(deploy: deploy),
    observed: observed,
  )
  RunnerSlotProvisionPlan {
    host_label: deploy.host_label,
    membership: membership,
    base_dir_script: actions_runner_base_dir_ensure_script(runner_user: deploy.runner_user),
    upsert_extract_scripts: flat_map(membership.actions, a =>
      match a {
        MemberAdded { at: _, to: m } =>
          [actions_runner_slot_extract_script(
            artifact: artifact,
            slot_dir: m.slot_dir,
            job_user: deploy.job_user,
          )]
        MemberChanged { at: _, from: _, to: _ } => []
        MemberRemoved { at: _, from: _ } => []
        MemberRemovalRefused { from: _, cause: _ } => []
        MemberRosterDuplicateKeyRefused { roster: _, first: _, duplicate: _ } => []
      }
    ),
  }
}

fn runner_slot_provision_has_width_increase(plan: RunnerSlotProvisionPlan) -> Bool {
  membership_added_count(plan: plan.membership) > 0
}
