module gunbc.systemctl_list_units



fn systemctl_list_units_local(instance_glob: std.types.NonEmptyStr) -> String? {
  let result = systemd.Systemctl.ListUnits(pattern: instance_glob)
  if result.success {
    Present { value: result.stdout }
  } else {
    none
  }
}

fn systemctl_list_units_line_trimmed(line: String) -> String {
  trim(line)
}

fn systemctl_list_units_line_nonempty(line: String) -> Bool {
  systemctl_list_units_line_trimmed(line: line) != ""
}

// `first()` answers `String?` because the split may yield nothing, and this reached the token with
// `as NonEmptyStr`, which does not eliminate the absence: a blank line produced a unit name whose
// text was the word `Absent`. Callers filter blank lines through
// `systemctl_list_units_line_nonempty`, so the absent arm is unreachable there; it is a loud word
// rather than a plausible unit name so a receipt reader cannot mistake the failure for a unit.
fn systemctl_list_units_line_as_unit(line: String) -> NonEmptyStr {
  match split(s: systemctl_list_units_line_trimmed(line: line), delimiter: " ").first() {
    Present { value: unit } => unit as NonEmptyStr
    Absent => "systemctl-unit-line-empty" as NonEmptyStr
  }
}

fn systemctl_list_units_active_services(instance_glob: std.types.NonEmptyStr) -> List<std.types.NonEmptyStr>? {
  match systemctl_list_units_local(instance_glob: instance_glob) {
    Present { value: stdout } =>
      let trimmed = trim(stdout)
      if trimmed == "" {
        Present { value: [] }
      } else {
        let lines = filter(split(s: trimmed, delimiter: "\n"), systemctl_list_units_line_nonempty)
        Present { value: map(lines, systemctl_list_units_line_as_unit) }
      }
    Absent => none
  }
}

// A dead-slot reaper or a liveness check that only ever asked systemctl for "active"
// units could never see the inactive/failed unit it exists to look at — the ordinary
// systemctl default this module's other function inherits from ListUnits. systemctl
// accepts a comma-joined --state list in one argv (no --all flag needed, and no second
// ListUnits operation to keep parallel with this one): this is the SAME declared
// operation, called with a different `state` binding, not a new op.
data systemctl_list_units_all_states: String = "active,inactive,failed"

fn systemctl_list_units_all_states_local(instance_glob: std.types.NonEmptyStr) -> String? {
  let result = systemd.Systemctl.ListUnits(pattern: instance_glob, state: systemctl_list_units_all_states)
  if result.success {
    Present { value: result.stdout }
  } else {
    none
  }
}

fn systemctl_list_units_all_states(instance_glob: std.types.NonEmptyStr) -> List<std.types.NonEmptyStr>? {
  match systemctl_list_units_all_states_local(instance_glob: instance_glob) {
    Present { value: stdout } =>
      let trimmed = trim(stdout)
      if trimmed == "" {
        Present { value: [] }
      } else {
        let lines = filter(split(s: trimmed, delimiter: "\n"), systemctl_list_units_line_nonempty)
        Present { value: map(lines, systemctl_list_units_line_as_unit) }
      }
    Absent => none
  }
}
