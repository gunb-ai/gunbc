module gunbc.nbd_proxy_virtual_media_install



type OsInstallActuatorStep
  = ActuatorNbdProxyServe {
      endpoint: extdeps.bmc.webui.nbd_proxy.BmcwebNbdProxyEndpointVariant
      slot: Int
      index: Int
      export: extdeps.bmc.webui.nbd_proxy.NbdProxyServeInterface
    }
  | ActuatorRedfishInsertMedia
  | ActuatorPxeNetworkBootStaging
  | ActuatorFirmwareUpdate
  | ActuatorBootOnce {
      target: extdeps.bmc.types.RedfishBootSourceOverrideTarget
      enabled: extdeps.bmc.types.RedfishBootSourceOverrideEnabled
    }
  | ActuatorForceRestart { reset_type: extdeps.bmc.types.RedfishResetType }

type OsInstallActuatorPlan {
  mechanism: gunbc.os_install_mechanism.OsInstallMechanism
  steps: List<OsInstallActuatorStep>
}

fn boot_once_step(target: extdeps.bmc.types.RedfishBootSourceOverrideTarget) -> OsInstallActuatorStep {
  ActuatorBootOnce {
    target: target,
    enabled: BootOverrideOnce,
  }
}

fn force_restart_step() -> OsInstallActuatorStep {
  ActuatorForceRestart { reset_type: ResetForceRestart }
}

fn nbd_proxy_serve_step(export: extdeps.bmc.webui.nbd_proxy.NbdProxyServeInterface) -> OsInstallActuatorStep {
  ActuatorNbdProxyServe {
    endpoint: asrock_altrad8ud_openbmc_2_07_00_nbd_proxy_primary_endpoint,
    slot: 0,
    index: 0,
    export: export,
  }
}

fn os_install_actuator_steps(mechanism: gunbc.os_install_mechanism.OsInstallMechanism, export: extdeps.bmc.webui.nbd_proxy.NbdProxyServeInterface) -> List<OsInstallActuatorStep> {
  let boot_target = install_boot_target_for(mechanism: mechanism)
  match mechanism {
    VirtualMediaInstall => [
      ActuatorRedfishInsertMedia,
      boot_once_step(target: boot_target),
      force_restart_step(),
    ]
    NbdProxyVirtualMediaInstall => [
      nbd_proxy_serve_step(export: export),
      boot_once_step(target: boot_target),
      force_restart_step(),
    ]
    PxeHttpInstall => [
      ActuatorPxeNetworkBootStaging,
      boot_once_step(target: boot_target),
      force_restart_step(),
    ]
    FirmwareUpdateThenVirtualMedia => [
      ActuatorFirmwareUpdate,
      ActuatorRedfishInsertMedia,
      boot_once_step(target: boot_target),
      force_restart_step(),
    ]
  }
}

fn os_install_actuator_plan(mechanism: gunbc.os_install_mechanism.OsInstallMechanism, export: extdeps.bmc.webui.nbd_proxy.NbdProxyServeInterface) -> OsInstallActuatorPlan {
  OsInstallActuatorPlan {
    mechanism: mechanism,
    steps: os_install_actuator_steps(mechanism: mechanism, export: export),
  }
}

data srv3_nbd_proxy_export_dissolution_trigger: std.disposition.Disposition = std.disposition.Scaffold {
  dissolves_to: SingleAuthority,
  bind: std.decl_ref.DeclarationRef {
    module_path: "gunbc.nbd_proxy_virtual_media_install",
    decl_name: "srv3_nbd_proxy_export_placeholder",
    field: WholeDeclaration
  }
}

data srv3_nbd_proxy_export_placeholder: extdeps.bmc.webui.nbd_proxy.NbdProxyServeInterface = extdeps.bmc.webui.nbd_proxy.NbdProxyServeInterface {
  export_byte_count: byte_size(0),
}

// The actuator plan carries the refusal rather than erasing it: a host whose firmware justifies
// no delivery mechanism has no actuator step sequence, and must not be handed a plausible one.
type OsInstallActuatorPlanRefusal
  = ActuatorMechanismRefused { cause: gunbc.os_install_mechanism.OsInstallMechanismRefusalCause }
  | ActuatorStepsUnrealized { refusals: List<ActuatorStepRefusal> }

type OsInstallActuatorPlanStanding
  = ActuatorPlanReady { plan: OsInstallActuatorPlan, intents: List<gunbc.host_effect.HostEffectIntent> }
  | ActuatorPlanRefused { cause: OsInstallActuatorPlanRefusal }

fn os_install_actuator_plan_standing_for(
  solution: gunbc.os_install_mechanism.OsInstallMechanismSolution,
  export: extdeps.bmc.webui.nbd_proxy.NbdProxyServeInterface,
) -> OsInstallActuatorPlanStanding {
  match solution {
    OsInstallMechanismSelected { mechanism: m } =>
      match os_install_actuator_plan(mechanism: m, export: export) {
        p =>
          match actuator_plan_realization(steps: p.steps) {
            ActuatorPlanRealized { intents: xs } => ActuatorPlanReady { plan: p, intents: xs }
            ActuatorPlanUnrealized { refusals: rs } =>
              ActuatorPlanRefused { cause: ActuatorStepsUnrealized { refusals: rs } }
          }
      }
    OsInstallMechanismRefused { cause: c } =>
      ActuatorPlanRefused { cause: ActuatorMechanismRefused { cause: c } }
  }
}

data srv3_os_install_actuator_plan_standing: OsInstallActuatorPlanStanding = os_install_actuator_plan_standing_for(
  solution: srv3_install_mechanism_solution,
  export: srv3_nbd_proxy_export_placeholder
)

// An unrealized step is a REFUSAL, not an absence. The Optional form below returned Absent for
// the three steps with no realization, and Absent is indistinguishable from "this step needs no
// host effect" — so a plan containing Redfish media insert, PXE staging or firmware update could
// be called ready while silently omitting exactly the effects that make it an install. Modelling
// a nonexistent implementation as a ready plan with missing steps is the fail-open this lane
// exists to remove.
type ActuatorStepRefusal
  = ActuatorStepRealizationAbsent { step: OsInstallActuatorStep }

type ActuatorStepRealization
  = ActuatorStepReady { intent: gunbc.host_effect.HostEffectIntent }
  | ActuatorStepRefused { cause: ActuatorStepRefusal }

type ActuatorPlanRealization
  = ActuatorPlanRealized { intents: List<gunbc.host_effect.HostEffectIntent> }
  | ActuatorPlanUnrealized { refusals: List<ActuatorStepRefusal> }

// Accumulates every unrealized step rather than stopping at the first: which effects are missing
// is the actionable fact, and reporting one of three hides the size of the gap.
fn actuator_plan_realization(steps: List<OsInstallActuatorStep>) -> ActuatorPlanRealization {
  fold(
    steps,
    init: ActuatorPlanRealized { intents: [] },
    f: fn(acc, step) {
      match actuator_step_realization(step: step) {
        ActuatorStepReady { intent: i } =>
          match acc {
            ActuatorPlanRealized { intents: xs } =>
              ActuatorPlanRealized { intents: concat(xs, [i]) }
            ActuatorPlanUnrealized { refusals: rs } => ActuatorPlanUnrealized { refusals: rs }
          }
        ActuatorStepRefused { cause: c } =>
          match acc {
            ActuatorPlanRealized { intents: _ } => ActuatorPlanUnrealized { refusals: [c] }
            ActuatorPlanUnrealized { refusals: rs } =>
              ActuatorPlanUnrealized { refusals: concat(rs, [c]) }
          }
      }
    },
  )
}

fn actuator_step_realization(step: OsInstallActuatorStep) -> ActuatorStepRealization {
  match step {
    ActuatorBootOnce { target: t, enabled: e } =>
      ActuatorStepReady {
        intent: gunbc.host_effect.HostEffectIntent {
          target: gunbc.host_effect.BmcController { node: srv3_host },
          effect: gunbc.host_effect.RedfishAction {
            action: extdeps.bmc.types.SetBootSourceOverride { target: t, enabled: e }
          },
          evidence: host_effect_identity_evidence,
          transport: LocalShell,
          privilege_denial: none,
        }
      }
    ActuatorForceRestart { reset_type: r } =>
      ActuatorStepReady {
        intent: gunbc.host_effect.HostEffectIntent {
          target: gunbc.host_effect.BmcController { node: srv3_host },
          effect: gunbc.host_effect.RedfishAction {
            action: extdeps.bmc.types.ResetSystem { reset_type: r }
          },
          evidence: host_effect_identity_evidence,
          transport: LocalShell,
          privilege_denial: none,
        }
      }
    ActuatorNbdProxyServe { endpoint: ep, slot: s, index: i, export: _ } =>
      ActuatorStepReady {
        intent: gunbc.host_effect.HostEffectIntent {
          target: gunbc.host_effect.HostOs { node: srv3_os_install_actuator_host },
          effect: gunbc.host_effect.Srv3NbdProxyServe {
            intent: nbd_proxy_serve_transport_intent(
              bmc_host: asrock_srv3_live_bmc_host,
              session_token: bmcweb_session_token_env_ref,
              ws_path: bmcweb_nbd_proxy_ws_path(variant: ep, slot: s, index: i),
              iso_path: gunbc.srv3_os_install_actuate_scope.srv3_actuator_virtual_media_iso_install_path,
              local_nbd_port: srv3_nbd_proxy_local_port,
            ),
            lease_key: srv3_nbd_proxy_lease_key,
          },
          evidence: host_effect_identity_evidence,
          transport: LocalShell,
          privilege_denial: none,
        }
      }
    ActuatorRedfishInsertMedia =>
      ActuatorStepRefused { cause: ActuatorStepRealizationAbsent { step: ActuatorRedfishInsertMedia } }
    ActuatorPxeNetworkBootStaging =>
      ActuatorStepRefused { cause: ActuatorStepRealizationAbsent { step: ActuatorPxeNetworkBootStaging } }
    ActuatorFirmwareUpdate =>
      ActuatorStepRefused { cause: ActuatorStepRealizationAbsent { step: ActuatorFirmwareUpdate } }
  }
}

fn os_install_actuator_step_count(plan: OsInstallActuatorPlan) -> Int {
  plan.steps.length()
}
