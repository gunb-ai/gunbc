module gunbc.site_segment_anchor_frontier

// THE ANCHOR'S MISSING PRODUCTION CONSUMER IS ROSTERED HERE, NOT PROMISED IN PROSE.
//
// gunbc.site_segment_anchor.host_interface_segment_anchor places a host's operating-system and
// controller interfaces on a site segment, and today only its witness calls it. DESIGN section 3c
// names that state: "consumed by a named later change (a declared frontier, with its trigger)". The
// named later change is S3 of gunbc.plans.site_segment_anchor_bmc_reach, the lookup with routerless
// refusal, which has to ask which segment a host's controller is on before it can find the controller.
//
// gunbc.dissolution_census folds gunbc.census_closure_frontier.census_closure_frontier_rows() and
// reports a row whose bound trigger APPEARS as fired, so the deferral cannot outlive the work.
// The trigger names a declaration that does not exist yet, as in
// gunbc.machine_intake.bmc_recovery_route_frontier: the ref is the contract for what must be added.
//
// NOT satisfied by: a witness calling the anchor, or a module importing it without a call site.
import std.types { NonEmptyStr, List }
import std.decl_ref { decl_ref }
import std.dissolution { bound_dissolution }
import std.roster_frontier { FrontierRow, frontier_rows_for_decls }

fn site_segment_anchor_consumer_frontier_rows() -> List<FrontierRow> {
  frontier_rows_for_decls(
    module_path: "gunbc.site_segment_anchor",
    decl_names: ["host_interface_segment_anchor" as NonEmptyStr],
    reason: "no production caller: git grep shows host_interface_segment_anchor is called only by test.claim.machine_intake.host_interface_segment_anchor_witness. Its consumer is S3 of gunbc.plans.site_segment_anchor_bmc_reach, the lookup that must place a controller on a segment before it can be reached",
    dissolution: bound_dissolution(
      ref: decl_ref(
        module_path: "gunbc.site_segment_lookup",
        decl_name: "site_segment_controller_lookup",
      ),
    ),
  )
}
