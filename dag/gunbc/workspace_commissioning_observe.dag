module gunbc.workspace_commissioning_observe

import gunbc.durable_cas_file_store { KeepAllGenerations }
import std.types { NonEmptyStr, String }
import gunbc.build_cache_instance { RunnerSlotIdentity, runner_slot_instance_name }
import gunbc.workspace_commissioning { WorkspaceObligationCensus, WorkspaceNoPriorObligations, WorkspacePriorObligationsRemain, WorkspaceObligationHistoryUnreadable }
import gunbc.runner_microvm_cell_readiness { StoreRead, StoreRootOwned, record_cell }
import gunbc.runner_microvm_cell_readiness_store { read_cell_readiness_store }
import gunbc.durable_exclusive_hold_file_store { observe_file_hold }
import gunbc.fabric_control_plane { fabric_cell_allocation_key }
import std.durable_exclusive_hold { HoldSlotAbsent, HoldSlotHeld, HoldSlotFree }

// Observe both existing authorities. Only an explicitly commissioned new lineage may use the
// empty census; this observation never authorizes creation or treats missing roots as empty.
fn workspace_observe_commissioning_obligations(root: NonEmptyStr, slot: RunnerSlotIdentity) -> WorkspaceObligationCensus {
  match read_cell_readiness_store() {
    StoreRead { ownership: StoreRootOwned, records: records } => if count(filter(records, r => (record_cell(record: r) as String) == (runner_slot_instance_name(slot: slot) as String))) != 0 {
      WorkspacePriorObligationsRemain { reason: "slot has readiness or in-flight history; initial commissioning cannot overwrite it" }
    } else { match observe_file_hold(root: root, key: fabric_cell_allocation_key(slot: slot), retention: KeepAllGenerations) {
      HoldSlotAbsent => WorkspaceNoPriorObligations { settled_generation: 0 }
      HoldSlotHeld { generation: _, owner: _ } => WorkspacePriorObligationsRemain { reason: "slot has an outstanding durable reservation" }
      HoldSlotFree { generation: _, released_by: _ } => WorkspaceObligationHistoryUnreadable { reason: "hold history exists without readiness history; recover it instead of creating initial generation zero" }
      other => WorkspaceObligationHistoryUnreadable { reason: "reservation history is unreadable; a missing allocation root is not an empty store" }
    } }
    other => WorkspaceObligationHistoryUnreadable { reason: "readiness authority is missing, unreadable or not root-owned; provision or recover through approved convergence" }
  }
}
