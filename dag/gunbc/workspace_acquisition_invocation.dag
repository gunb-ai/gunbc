module gunbc.workspace_acquisition_invocation

import std.optional { Absent, Present }
import extdeps.systemd.systemctl

import std.types { String, NonEmptyStr, Bool }
import std.algebra { trim }
import std.resources { Filesystem }
import std.decl_ref { decl_ref }
import std.content_hash { content_hash_of_value, serialize_content_hash }
import std.durable_compare_and_set { CasGeneration, ExpectSlotAbsent, ExpectSlotGeneration, CasCommitted, CasPreconditionFailed, CasStoreRefused, CasObservedReadable, CasObservedUnreadable, CasReadablePresent, CasReadableAbsent }
import extdeps.systemd.invocation_id { SystemdInvocationId, systemd_invocation_id_of }
import gunbc.fabric.durable_cas_fabric_storage { fabric_storage_compare_and_set, fabric_storage_observe_cas_slot }
import gunbc.durable_cas_file_store { admit_cas_attempt_for_derived_payload, DerivedPayloadAdmitted, DerivedPayloadKeyNotSlotAddressable }
import gunbc.fabric.fabric_storage_client { FabricStorageBinding }
import gunbc.workspace_reservation_record { WorkspaceReservationPlan, workspace_reservation_plan_json, workspace_reservation_plan_reservation }
import gunbc.runner.runner_microvm_slot_unit_identity { microvm_slot_unit_instance_name }
import gunbc.build_cache.build_cache_instance { runner_slot_instance_name }
import extdeps.systemd { InvocationIDProperty, MainPID, systemd_unit_property_wire }
import std.durable_exclusive_hold { HolderObservedLive, HolderObservedDead, HolderLivenessUnobservable }
import gunbc.systemd_unit_invocation_liveness {
  UnitInvocationObservation, UnitInvocationPresent, UnitInvocationAbsent, UnitInvocationUnreadable, UnitRunIdentity, SystemManager,
  unit_invocation_observation, unit_invocation_holder_liveness, unit_run_wire, unit_run_of_wire,
}
import extdeps.linux.kernel_random { kernel_boot_id_path }
import extdeps.linux.proc_stat { proc_stat_path }
import extdeps.languages.json.emit { serialize_json, json_object, json_kv, json_string }
import extdeps.languages.json.parse { parse_json_document, JsonDocumentParsed, JsonDocumentUnreadable, json_field_string, json_field_value }

// THE ONE DECLARATION OF THE ACQUISITION JOURNAL SLOT FAMILIES: the actor election slot and the protocol marker
// slot (see WorkspaceAllocationSlotsDeclaration for the shape). Both keys derive from it.
type WorkspaceAcquisitionSlotsDeclaration { actor_member: NonEmptyStr, protocol_member: NonEmptyStr }

data workspace_acquisition_slots: WorkspaceAcquisitionSlotsDeclaration = WorkspaceAcquisitionSlotsDeclaration {
  actor_member: "workspace-acquisition-actor" as NonEmptyStr,
  protocol_member: "workspace-acquisition-protocol" as NonEmptyStr,
}

// THE ACQUISITION JOURNAL STORE, SEALED: workspace_acquisition_store is the one mint (binding in, members from the declaration, no path).
type WorkspaceAcquisitionStore sole_constructor { binding: FabricStorageBinding, actor_member: NonEmptyStr, protocol_member: NonEmptyStr }

fn workspace_acquisition_store(binding: FabricStorageBinding) -> WorkspaceAcquisitionStore {
  WorkspaceAcquisitionStore { binding: binding, actor_member: workspace_acquisition_slots.actor_member, protocol_member: workspace_acquisition_slots.protocol_member }
}

// The environment identifier is accepted only when the manager identifies this interpreter as
// the selected controller's MainPID. An inherited or caller-supplied identifier is insufficient.
// The run it names is completed with the boot id and boot start read from the host, never supplied.
fn workspace_current_acquisition_invocation(plan: WorkspaceReservationPlan) -> UnitRunIdentity?
  uses fs: Filesystem
{
  let reservation = workspace_reservation_plan_reservation(plan: plan)
  let unit = microvm_slot_unit_instance_name(slot_instance: runner_slot_instance_name(slot: reservation.slot))
  let before = systemd.Systemctl.ShowProperty(unit: unit, property: systemd_unit_property_wire(property: InvocationIDProperty))
  let main = systemd.Systemctl.ShowProperty(unit: unit, property: systemd_unit_property_wire(property: MainPID))
  let own = Filesystem.Read(path: "/proc/self/stat")
  let boot = Filesystem.Read(path: kernel_boot_id_path)
  let stat = Filesystem.Read(path: proc_stat_path)
  let after = systemd.Systemctl.ShowProperty(unit: unit, property: systemd_unit_property_wire(property: InvocationIDProperty))
  if !before.success || !main.success || !own.success || !boot.success || !stat.success || !after.success { none }
  else { match shell.Env.Get(name: "INVOCATION_ID" as NonEmptyStr).value {
    Absent => none
    Present { value: actual } => match split(s: own.content, delimiter: " ").first() {
      Absent => none
      Present { value: pid } => if trim(s: actual) != "" && trim(s: before.value) == trim(s: actual)
        && trim(s: after.value) == trim(s: actual) && trim(s: main.value) == pid && pid != "0" {
        match unit_invocation_observation(manager: SystemManager, unit: unit as NonEmptyStr, boot_id_text: boot.content, proc_stat_text: stat.content, invocation_text: actual) {
          UnitInvocationPresent { unit: _, run: r } => Present { value: r }
          UnitInvocationAbsent { unit: _, manager: _, boot_id: _, boot_started_at: _ } => none
          UnitInvocationUnreadable { cause: _ } => none
        }
      } else { none }
    }
  } }
}

// One immutable actor record per exact reservation plan precedes the hold effect. A restart
// may observe the hold, but cannot impersonate the old actor or repeat a possibly queued CAS.
fn workspace_acquisition_actor_admits(store: WorkspaceAcquisitionStore, plan: WorkspaceReservationPlan) -> Bool
  admit_callers: [decl_ref(module_path: "gunbc.workspace_allocation_acquisition", decl_name: "workspace_apply_recorded_plan")]
{
  match workspace_current_acquisition_invocation(plan: plan) {
    Absent => false
    Present { value: run } => {
      let invocation = unit_run_wire(run: run)
      let plan_wire = serialize_json(v: workspace_reservation_plan_json(plan: plan))
      let key = workspace_acquisition_actor_key(store: store, plan: plan)
      let wire = serialize_json(v: json_object(members: [json_kv(key: "plan", value: json_string(s: plan_wire)), json_kv(key: "invocation", value: json_string(s: invocation))])) as NonEmptyStr
      match admit_cas_attempt_for_derived_payload(key: key, expected: ExpectSlotAbsent, proposed: wire) {
        DerivedPayloadAdmitted { verified: proposed } => match fabric_storage_compare_and_set(store: store.binding, verified: proposed) {
          CasCommitted { committed: _ } => true
          other => match fabric_storage_observe_cas_slot(store: store.binding, key: key) {
            CasObservedReadable { readable: CasReadablePresent { version: recorded } } => recorded.value == wire
            other => false
          }
        }
        other => false
      }
    }
  }
}

// Winning against actor election proves no admitted actor can ever issue this plan's hold effect.
// An existing actor, unreadable journal, or any other value retains the acquisition obligation.
fn workspace_cancel_unelected_actor(store: WorkspaceAcquisitionStore, plan: WorkspaceReservationPlan) -> Bool
  admit_callers: [decl_ref(module_path: "gunbc.workspace_allocation_acquisition", decl_name: "workspace_settle_unelected_retirement")]
{
  let plan_wire = serialize_json(v: workspace_reservation_plan_json(plan: plan))
  let key = workspace_acquisition_actor_key(store: store, plan: plan)
  let tombstone = serialize_json(v: json_object(members: [json_kv(key: "plan", value: json_string(s: plan_wire)), json_kv(key: "cancelled_before_actor", value: json_string(s: "true"))])) as NonEmptyStr
  if !workspace_actor_protocol_observed(store: store, plan: plan) { false }
  else { match admit_cas_attempt_for_derived_payload(key: key, expected: ExpectSlotAbsent, proposed: tombstone) {
    DerivedPayloadAdmitted { verified: proposed } => match fabric_storage_compare_and_set(store: store.binding, verified: proposed) {
      CasCommitted { committed: _ } => true
      other => match fabric_storage_observe_cas_slot(store: store.binding, key: key) {
        CasObservedReadable { readable: CasReadablePresent { version: recorded } } => recorded.value == tombstone
        other => false
      }
    }
    other => false
  } }
}

fn workspace_acquisition_protocol_key(store: WorkspaceAcquisitionStore, plan: WorkspaceReservationPlan) -> NonEmptyStr {
  concat(concat(store.protocol_member as String, "-"), serialize_content_hash(hash: content_hash_of_value(value: serialize_json(v: workspace_reservation_plan_json(plan: plan)) as NonEmptyStr)) as String) as NonEmptyStr
}

// Legacy Acquiring rows predate actor election. Only a new Recorded transition may install this
// marker, before its owner CAS, so absence of a legacy journal never becomes proof of no effect.
fn workspace_establish_actor_protocol(store: WorkspaceAcquisitionStore, plan: WorkspaceReservationPlan) -> Bool
  admit_callers: [decl_ref(module_path: "gunbc.workspace_allocation_acquisition", decl_name: "workspace_begin_acquisition")]
{
  match admit_cas_attempt_for_derived_payload(key: workspace_acquisition_protocol_key(store: store, plan: plan), expected: ExpectSlotAbsent, proposed: "actor-journal/1" as NonEmptyStr) {
    DerivedPayloadAdmitted { verified: proposed } => match fabric_storage_compare_and_set(store: store.binding, verified: proposed) {
      CasCommitted { committed: _ } => true
      other => workspace_actor_protocol_observed(store: store, plan: plan)
    }
    other => false
  }
}

fn workspace_actor_protocol_observed(store: WorkspaceAcquisitionStore, plan: WorkspaceReservationPlan) -> Bool {
  match fabric_storage_observe_cas_slot(store: store.binding, key: workspace_acquisition_protocol_key(store: store, plan: plan)) {
    CasObservedReadable { readable: CasReadablePresent { version: recorded } } => recorded.value == "actor-journal/1"
    other => false
  }
}

fn workspace_acquisition_actor_key(store: WorkspaceAcquisitionStore, plan: WorkspaceReservationPlan) -> NonEmptyStr {
  concat(concat(store.actor_member as String, "-"), serialize_content_hash(hash: content_hash_of_value(value: serialize_json(v: workspace_reservation_plan_json(plan: plan)) as NonEmptyStr)) as String) as NonEmptyStr
}

// The recorded actor slot, read as a value: the exact generation is what any replacement fences on.
type WorkspaceRecordedActor
  = RecordedActorAbsent
  | RecordedActorInvocation { generation: CasGeneration, run: UnitRunIdentity }
  | RecordedActorCancelled { generation: CasGeneration }
  | RecordedActorLegacyBareId { generation: CasGeneration, invocation_id: SystemdInvocationId }
  | RecordedActorUnreadable { reason: NonEmptyStr }

fn workspace_recorded_actor(store: WorkspaceAcquisitionStore, plan: WorkspaceReservationPlan) -> WorkspaceRecordedActor {
  match fabric_storage_observe_cas_slot(store: store.binding, key: workspace_acquisition_actor_key(store: store, plan: plan)) {
    CasObservedReadable { readable: CasReadableAbsent } => RecordedActorAbsent
    CasObservedReadable { readable: CasReadablePresent { version: recorded } } => workspace_recorded_actor_decode(generation: recorded.generation, wire: recorded.value as String)
    CasObservedUnreadable { cause: _ } => RecordedActorUnreadable { reason: "acquisition actor slot is unreadable" }
  }
}

fn workspace_recorded_actor_decode(generation: CasGeneration, wire: String) -> WorkspaceRecordedActor {
  match parse_json_document(s: wire) {
    JsonDocumentUnreadable { gap: _ } => RecordedActorUnreadable { reason: "acquisition actor record is not JSON" }
    JsonDocumentParsed { value: record } => match json_field_value(r: json_field_string(obj: record, key: "invocation")) {
      Present { value: invocation } => match unit_run_of_wire(wire: invocation) {
        Absent => match systemd_invocation_id_of(text: invocation) {
          Present { value: bare } => RecordedActorLegacyBareId { generation: generation, invocation_id: bare }
          Absent => RecordedActorUnreadable { reason: "acquisition actor names no unit run and no InvocationID" }
        }
        Present { value: run } => RecordedActorInvocation { generation: generation, run: run }
      }
      Absent => match json_field_value(r: json_field_string(obj: record, key: "cancelled_before_actor")) {
        Present { value: _ } => RecordedActorCancelled { generation: generation }
        Absent => match json_field_value(r: json_field_string(obj: record, key: "cancelled_after_actor")) {
          Present { value: _ } => RecordedActorCancelled { generation: generation }
          Absent => RecordedActorUnreadable { reason: "acquisition actor record names neither an invocation nor a cancellation" }
        }
      }
    }
  }
}

// Whether the recorded actor's invocation can still issue a hold effect, as read from the slot.
type WorkspacePriorActorStanding
  = PriorActorRunning
  | PriorActorTerminal
  | PriorActorUnobservable { reason: NonEmptyStr }

// The slot unit's current run, read once by the effectful caller and supplied to the takeover so
// the decision is a function of what was observed. If the unit now carries another run (or none),
// the recorded actor's process has ended and can issue no further hold effect.
fn workspace_slot_invocation_reading(plan: WorkspaceReservationPlan) -> UnitInvocationObservation
  uses fs: Filesystem
{
  let unit = microvm_slot_unit_instance_name(slot_instance: runner_slot_instance_name(slot: workspace_reservation_plan_reservation(plan: plan).slot))
  let observed = systemd.Systemctl.ShowProperty(unit: unit, property: systemd_unit_property_wire(property: InvocationIDProperty))
  let boot = Filesystem.Read(path: kernel_boot_id_path)
  let stat = Filesystem.Read(path: proc_stat_path)
  if !observed.success || !boot.success || !stat.success {
    UnitInvocationUnreadable { cause: "the slot unit's run is unreadable; the elected actor may still be running" as NonEmptyStr }
  } else {
    unit_invocation_observation(manager: SystemManager, unit: unit as NonEmptyStr, boot_id_text: boot.content, proc_stat_text: stat.content, invocation_text: observed.value)
  }
}

// The unit the elected actor runs in: the slot's unit instance. An observation of any other unit, or of another
// manager, is a foreign subject for this holder (unit_invocation_holder_liveness).
fn workspace_slot_unit(plan: WorkspaceReservationPlan) -> NonEmptyStr {
  microvm_slot_unit_instance_name(slot_instance: runner_slot_instance_name(slot: workspace_reservation_plan_reservation(plan: plan).slot)) as NonEmptyStr
}

fn workspace_prior_actor_standing(recorded: UnitRunIdentity, plan: WorkspaceReservationPlan, slot: UnitInvocationObservation) -> WorkspacePriorActorStanding {
  match unit_invocation_holder_liveness(recorded: recorded, holder_unit: workspace_slot_unit(plan: plan), observed: slot) {
    HolderObservedLive { evidence: _ } => PriorActorRunning
    HolderObservedDead { evidence: _ } => PriorActorTerminal
    HolderLivenessUnobservable { cause: c } => PriorActorUnobservable { reason: c }
  }
}

// Replace a terminal actor with this invocation, fenced on the exact recorded generation: of two
// concurrent replacements only one commits, so only one can go on to issue the hold CAS.
fn workspace_rearm_actor(store: WorkspaceAcquisitionStore, plan: WorkspaceReservationPlan, generation: CasGeneration, invocation: UnitRunIdentity) -> Bool
  admit_callers: [
    decl_ref(module_path: "gunbc.workspace_allocation_acquisition", decl_name: "workspace_take_over_recorded"),
    decl_ref(module_path: "test.claim.workspace_acquisition_storage_wet_witness", decl_name: "actor_rearm_race"),
  ]
{
  let plan_wire = serialize_json(v: workspace_reservation_plan_json(plan: plan))
  let wire = serialize_json(v: json_object(members: [json_kv(key: "plan", value: json_string(s: plan_wire)), json_kv(key: "invocation", value: json_string(s: unit_run_wire(run: invocation)))])) as NonEmptyStr
  workspace_actor_slot_replace(store: store, plan: plan, generation: generation, wire: wire)
}

// Cancel a terminal actor of a retired acquisition, fenced the same way; the tombstone names the
// invocation it ended so a late reader can attribute the cancellation.
// Admitted caller: workspace_take_over_recorded holds the decision that selects this effect. TakeoverCancelActor
// is reached only from PriorActorTerminal (an observed termination of the recorded holder's own unit run, with no hold)
// under the Retire intent; an unobservable or legacy standing retains and never reaches here.
fn workspace_cancel_elected_actor(store: WorkspaceAcquisitionStore, plan: WorkspaceReservationPlan, generation: CasGeneration, prior_wire: NonEmptyStr) -> Bool
  admit_callers: [decl_ref(module_path: "gunbc.workspace_allocation_acquisition", decl_name: "workspace_take_over_recorded")]
{
  let plan_wire = serialize_json(v: workspace_reservation_plan_json(plan: plan))
  let wire = serialize_json(v: json_object(members: [json_kv(key: "plan", value: json_string(s: plan_wire)), json_kv(key: "cancelled_after_actor", value: json_string(s: prior_wire))])) as NonEmptyStr
  workspace_actor_slot_replace(store: store, plan: plan, generation: generation, wire: wire)
}

fn workspace_actor_slot_replace(store: WorkspaceAcquisitionStore, plan: WorkspaceReservationPlan, generation: CasGeneration, wire: NonEmptyStr) -> Bool {
  let key = workspace_acquisition_actor_key(store: store, plan: plan)
  match admit_cas_attempt_for_derived_payload(key: key, expected: ExpectSlotGeneration { generation: generation }, proposed: wire) {
    DerivedPayloadAdmitted { verified: proposed } => match fabric_storage_compare_and_set(store: store.binding, verified: proposed) {
      CasCommitted { committed: _ } => true
      CasPreconditionFailed { expected: _, observed: _ } => false
      CasStoreRefused { cause: _ } => false
    }
    DerivedPayloadKeyNotSlotAddressable { key: _ } => false
  }
}
