module gunbc.ci_budget_tree


data gunbc_ci_budget_tree_deconfliction_disposition: Disposition = std.disposition.Terminal { reason: "DESIGN §3 deliberate carrier split: this BudgetNode governs INTER-run co-residence (host_ram partitioned as overhead + sessions_slice + runner_slice, conserving by construction via byte_size_saturating_sub). srv1_floor_memory_budget returns gunbc_ci_runner_slot_ram_speed_ceiling (min of live MemoryHigh 15GiB and live MemoryMax 16GiB per the applied 2026-07-11 allocation ruling; see srv1_floor_memory_budget_live_note - within-run width packs to the throttle line, memory.max stays the kill authority). gunbc_ci_dashboard_session_container_cap (31.27 GiB) is inter-run session pool only. Do NOT conflate. See gunbc_ci_footprint_granularity_disposition." }

fn host_overhead_bytes() -> ByteSize {
  match gunbc_ci_host_fixed_overhead {
    HostFixedOverheadMeasured { bytes: b } => b
    HostFixedOverheadUnmeasured => byte_size(0)
  }
}

fn host_ram_of(offer: ComputeOffer) -> ByteSize {
  compute_host_ram_bytes_total(host: offer.supply.physical)
}

fn host_allocatable_bytes(offer: ComputeOffer) -> ByteSize {
  byte_size_saturating_sub(total: host_ram_of(offer: offer), reserved: host_overhead_bytes())
}

fn session_pool_bytes_live(offer: ComputeOffer) -> ByteSize {
  match resolve_session_slice(mode: gunbc_ci_session_reservation_mode, oomd: gunbc_fleet_oomd_evidence) {
    SessionSliceResolved { bytes: s, per_session_cap: _, concurrency: _ } => s
    SessionSliceUnresolved { reason: _ } => host_allocatable_bytes(offer: offer)
  }
}

fn runner_pool_bytes_at(offer: ComputeOffer, session_slice: ByteSize) -> ByteSize {
  byte_size_saturating_sub(total: host_allocatable_bytes(offer: offer), reserved: session_slice)
}

fn appropriation_of(b: ByteSize) -> Appropriation<Memory, One> {
  Appropriation { ceiling: b }
}

fn ci_host_overhead_claim() -> BudgetClaim {
  BudgetClaim {
    item: LineItem { purpose: "host_fixed_overhead", amount: host_overhead_bytes() },
    priority: Guaranteed
  }
}

fn host_budget_tree_at(name: String, offer: ComputeOffer, session_slice: ByteSize) -> BudgetNode {
  BudgetNode {
    name: name,
    appropriation: appropriation_of(b: host_ram_of(offer: offer)),
    claims: [ci_host_overhead_claim()],
    children: [
      BudgetNode {
        name: "gha_runner_pool",
        appropriation: appropriation_of(b: runner_pool_bytes_at(offer: offer, session_slice: session_slice)),
        claims: [],
        children: []
      },
      BudgetNode {
        name: "dashboard_session_pool",
        appropriation: appropriation_of(b: session_slice),
        claims: [],
        children: []
      }
    ]
  }
}

fn host_budget_tree(name: String, offer: ComputeOffer) -> BudgetNode {
  host_budget_tree_at(name: name, offer: offer, session_slice: session_pool_bytes_live(offer: offer))
}

fn ci_session_pool_bytes(offer: ComputeOffer) -> ByteSize {
  session_pool_bytes_live(offer: offer)
}

fn runner_pool_bytes(offer: ComputeOffer) -> ByteSize {
  runner_pool_bytes_at(offer: offer, session_slice: session_pool_bytes_live(offer: offer))
}

data srv1_budget_tree: BudgetNode = host_budget_tree(name: "srv1", offer: srv1_offer)
data srv2_budget_tree: BudgetNode = host_budget_tree(name: "srv2", offer: srv2_offer)
data srv3_budget_tree: BudgetNode = host_budget_tree(name: "srv3", offer: srv3_offer)

data fleet_budget_trees: List<BudgetNode> = [srv1_budget_tree, srv2_budget_tree, srv3_budget_tree]

fn budget_tree_gha_runner_pool_node(tree: BudgetNode) -> BudgetChild {
  budget_child_named(node: tree, name: "gha_runner_pool")
}

fn budget_tree_dashboard_session_pool_node(tree: BudgetNode) -> BudgetChild {
  budget_child_named(node: tree, name: "dashboard_session_pool")
}

fn srv1_gha_runner_pool_budget() -> ByteSize {
  runner_pool_bytes(offer: srv1_offer)
}

fn srv1_dashboard_session_pool_budget() -> ByteSize {
  ci_session_pool_bytes(offer: srv1_offer)
}

fn srv1_host_ram() -> ByteSize {
  host_ram_of(offer: srv1_offer)
}

fn srv1_fixed_overhead_bytes() -> ByteSize {
  host_overhead_bytes()
}

data srv1_floor_memory_budget_live_note: String = "Floor width sizing reads the RAM-SPEED ceiling (gunbc_ci_runner_slot_ram_speed_ceiling = min(live MemoryHigh, live MemoryMax); 15GiB under the applied 2026-07-11 allocation ruling), not the kill line: between memory.high and memory.max the slot does not fail, it reclaim-throttles into swap (four floor_peak_post pins at exactly 16106127360+overshoot, runs 29137081535/29142398465/29159082043 - the 60m-timeout wedge signature), and a width budget denominated at the kill line buys its last GiB at swap speed (DESIGN 5: the widening arm; the 2026-07-10 24GiB-era wedges were this row reading the then-live 24GiB cap on slots already carved to 16/15). History: the 2026-07-09 discovery flip first forced the live-over-declared read (executor base ~8.3GiB could not fit the then-declared 8GiB slot); the 2026-07-10/11 ruling then converged declared to 16GiB max / 15GiB high and the apply landed. Dissolve-on: direct post-apply memory.max readback proves live == declared, collapse both live rows to the gunbc.runner_slot_allocation single authority (high stays a first-class axis there)."

fn srv1_floor_memory_budget() -> ByteSize {
  ci_runner_target_ram_speed_budget(target: selected_ci_runner_target())
}

fn srv1_ci_run_container_hard_cap() -> ByteSize {
  gunbc_ci_runner_cgroup_memory_cap
}

fn srv1_dashboard_session_container_cap() -> ByteSize {
  gunbc_ci_dashboard_session_container_cap
}

fn witness_floor_budget_equals_selected_target_budget() -> Bool {
  let budget = byte_size_count(b: srv1_floor_memory_budget())
  budget == byte_size_count(b: ci_runner_target_ram_speed_budget(target: selected_ci_runner_target()))
    && byte_size_count(b: ci_runner_target_ram_speed_budget(target: FleetSelfHosted)) == byte_size_count(b: gunbc_ci_runner_slot_ram_speed_ceiling())
}
