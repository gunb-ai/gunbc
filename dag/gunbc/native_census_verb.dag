module gunbc.native_census_verb

import std.types { String, List }
import std.optional { Optional, Present, Absent }
import std.algebra { fold_list }

// THE CENSUS VERBS ARE ROWS, NOT VARIANTS, AND THIS IS THEIR ONE AUTHORITY: the binding's producer
// (gunbc.target_binding NativeCensusVerbProducer), the emitted driver's parse and its dispatch
// (v2.compiler.source_root_eval native_census_verb_output) all read this closed type, so a verb spelled
// anywhere else is a type error, not a claim that has to be run. A new census is a variant here, an arm in
// the dispatch (exhaustive, so a missing one refuses) and an instrument_targets row naming it.
type NativeCensusVerbWord
  = CensusVerbDemand
  | CensusVerbDeclRef
  | CensusVerbTraversalOrder

// The ONE spelling of each verb: the word on the emitted binary's command line.
fn native_census_verb_word(v: NativeCensusVerbWord) -> String {
  match v {
    CensusVerbDemand => "demand-census"
    CensusVerbDeclRef => "decl-ref-census"
    CensusVerbTraversalOrder => "traversal-order-census"
  }
}

data native_census_verbs: List<NativeCensusVerbWord> = [CensusVerbDemand, CensusVerbDeclRef, CensusVerbTraversalOrder]

fn native_census_verb_of_word(word: String) -> Optional<NativeCensusVerbWord> {
  fold_list(xs: native_census_verbs, empty: Absent, cons: fn(found, v) {
    if native_census_verb_word(v: v) == word { Present { value: v } } else { found }
  })
}
