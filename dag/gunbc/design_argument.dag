module gunbc.design_argument

import std.types { String, List }
import std.decl_ref { DeclarationRef, decl_ref }
import std.syllogism { Argument, Axiom, NonLogicalAxiom, Proposition }

// A NONEMPTY COLLECTION OF DECLARATION REFERENCES. The DAG language has no generic NonEmptyList
// carrier, so this is the established corpus shape: one required first element plus the remaining
// list. Used for conformance domain homes (DESIGN section 3b), which must name at least one
// authority — a domain with no home has nothing to conform to, so this structure guarantees the
// invariant at the type level rather than through a post-hoc check.
type ConformanceHomes {
  first: DeclarationRef
  rest: List<DeclarationRef>
}

fn conformance_home_list(h: ConformanceHomes) -> List<DeclarationRef> {
  concat([h.first], h.rest)
}

// EACH PROPOSITION CARRIES ITS OWN REVIEW READING, OR NONE. A DesignRow is one proposition of the
// serial argument plus, where the proposition is checkable on a single change, the question a
// reviewer asks of that change and the tells that its answer is yes. gunbc.roadmap.roadmap_review_criteria
// DERIVES the review roster from these rows (one criterion per row with a review, key from the id),
// so adding, changing or retiring a criterion is an edit to the proposition's own row here and
// nowhere else (operator, 2026-09-06: DESIGN criteria flow to reviews with no dual representation).
// A proposition without a review reading (an axiom's consequence, or a program like self-hosting) is
// still part of the argument and simply mints no reviewer.
// HOW A REVIEWER'S ANSWER MAPS TO A VERDICT IS A PROPERTY OF THE QUESTION, NOT OF THE REVIEWER.
// Most criteria ask a yes/no question whose yes is a defect. Conformance (DESIGN section 3b) asks a
// three-valued one, and the middle value -- a divergence with its reason stated -- is admitted, so
// collapsing it to yes/no would either block every deliberate departure or admit every accidental
// one. The verdict words themselves belong to gunbc.roadmap.roadmap_review_role (HeadVerdict); this
// algebra only says which shape of answer the question has, and that module maps it.
type ReviewAnswerAlgebra
  = YesIsADefect
  | ConformanceThreeValued

type PropositionReview
  = DefectReview {
      part: String
      question: String
      tells: List<String>
    }
  | ConformanceReview {
      domain: ConformanceDomain
    }

// A CONFORMANCE DOMAIN IS ONE CONCEPT THE CORPUS ALREADY HOMES, WITH THE DECLARATIONS THAT ARE ITS
// HOME (DESIGN section 3b). The conformance proposition's review parts are DERIVED from these rows,
// one reviewer per domain, so the domain list has one authority and DESIGN.md renders it rather
// than repeating it. A domain is added by adding a row; a domain whose home does not yet exist is a
// modeling obligation, not a row; a home that does not resolve is a section-3 citation defect.
//
// QUESTION and TELLS are reviewer-facing. LABEL, OWNS, BOUNDARIES and each group's LABEL and PURPOSE
// are reader-facing: DESIGN.md renders a domain as a heading, what it owns, what it deliberately does
// not absorb, and its home declarations grouped by what they do. The home declarations are the
// flattened groups (conformance_domain_homes), so the reviewer brief and DESIGN.md name one
// population. The review-plan identity hashes key, question, tells, answer algebra and homes
// (gunbc.roadmap.roadmap_review_criteria review_criterion_identity_text); the reader-facing text is
// excluded, so rewording it never invalidates a prior observation.
type ConformanceHomeGroup {
  label: String
  purpose: String
  homes: ConformanceHomes
}

type ConformanceHomeGroups {
  first: ConformanceHomeGroup
  rest: List<ConformanceHomeGroup>
}

type ConformanceDomain {
  key: String
  label: String
  question: String
  tells: List<String>
  owns: String
  boundaries: List<String>
  home_groups: ConformanceHomeGroups
}

fn conformance_domain_home_groups(d: ConformanceDomain) -> List<ConformanceHomeGroup> {
  concat([d.home_groups.first], d.home_groups.rest)
}

fn conformance_domain_homes(d: ConformanceDomain) -> List<DeclarationRef> {
  flat_map(conformance_domain_home_groups(d: d), g => conformance_home_list(h: g.homes))
}

