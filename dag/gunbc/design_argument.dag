module gunbc.design_argument

import std.types { String, List }
import std.decl_ref { DeclarationRef, decl_ref }

// EACH PROPOSITION CARRIES ITS OWN REVIEW READING, OR NONE. A DesignRow is one proposition of the
// serial argument plus, where the proposition is checkable on a single change, the question a
// reviewer asks of that change and the tells that its answer is yes. gunbc.roadmap.roadmap_review_criteria
// DERIVES the review roster from these rows (one criterion per row with a review, key from the id),
// so adding, changing or retiring a criterion is an edit to the proposition's own row here and
// nowhere else (operator, 2026-09-06: DESIGN criteria flow to reviews with no dual representation).
// A proposition without a review reading (an axiom's consequence, or a program like self-hosting) is
// still part of the argument and simply mints no reviewer.
// HOW A REVIEWER'S ANSWER MAPS TO A VERDICT IS A PROPERTY OF THE QUESTION, NOT OF THE REVIEWER.
// Most criteria ask a yes/no question whose yes is a defect. Conformance (DESIGN section 3b) asks a
// three-valued one, and the middle value -- a divergence with its reason stated -- is admitted, so
// collapsing it to yes/no would either block every deliberate departure or admit every accidental
// one. The verdict words themselves belong to gunbc.roadmap.roadmap_review_role (HeadVerdict); this
// algebra only says which shape of answer the question has, and that module maps it.
type ReviewAnswerAlgebra
  = YesIsADefect
  | ConformanceThreeValued

type PropositionReview {
  part: String
  question: String
  tells: List<String>
  answer: ReviewAnswerAlgebra
  homes: List<DeclarationRef>
}

// A CONFORMANCE DOMAIN IS ONE CONCEPT THE CORPUS ALREADY HOMES, WITH THE DECLARATIONS THAT ARE ITS
// HOME (DESIGN section 3b). The conformance proposition's review parts are DERIVED from these rows,
// one reviewer per domain, so the domain list has one authority and the prose in DESIGN.md names it
// rather than repeating it. A domain is added by adding a row; a domain whose home does not yet exist
// is a modeling obligation, not a row; a home that does not resolve is a section-3 citation defect.
type ConformanceDomain {
  key: String
  question: String
  homes: List<DeclarationRef>
  tells: List<String>
}

data conformance_domains: List<ConformanceDomain> = [
  ConformanceDomain {
    key: "conformance-extdeps",
    question: "Does the change carry a fact that other parties already agree on -- an upstream specification, a vendor's product, a protocol, a unit, a tool's interface -- without pointing at the extdeps module that owns it, or put such a fact somewhere other than the layer that owns it: a cited upstream fact modeled inside a product or workflow module, or a product policy or observation authored inside extdeps?",
    homes: [decl_ref(module_path: "extdeps.external_authority", decl_name: "ExternalModelScope")],
    tells: [
      "a new type, enum or constant that restates what a standard, vendor sheet, man page or API document already defines, with no extdeps module citing it",
      "a value that is really an upstream fact (a port, a field name, a version, a limit, a wire shape) spelled as a literal in gunbc/ or a workflow module",
      "an extdeps module that carries our own policy, an observation this repository made, a coverage state, or a product-specific dispatch among upstreams",
      "a generic extdeps hub enumerating concrete products or versions instead of one module per independently versioned upstream"
    ],
  },
  ConformanceDomain {
    key: "conformance-realization",
    question: "Does the change cache, memoize, build, emit or execute something without inhabiting the corpus's realization model -- a content-addressed pure spec realized by a bound handler -- and if it departs from that model, does it say why?",
    homes: [
      decl_ref(module_path: "std.realization", decl_name: "Materialization"),
      decl_ref(module_path: "std.materialization_provider", decl_name: "ArtifactRequest"),
      decl_ref(module_path: "std.artifact_store", decl_name: "ArtifactStore"),
      decl_ref(module_path: "std.cache_interface", decl_name: "StorageSurface"),
      decl_ref(module_path: "std.content_hash", decl_name: "HashFamily"),
    ],
    tells: [
      "a hand-rolled map, memo flag or scratch directory keyed by something other than declared-input content",
      "a shell or host call that executes what a realization handler already binds",
      "an output attached to a request that did not succeed, or a cache read that cannot say what produced the hit"
    ],
  },
  ConformanceDomain {
    key: "conformance-leasing",
    question: "Does the change take exclusive or bounded use of something -- a slot, a head, a host, a file, a budget -- without inhabiting the corpus's lease and grant model, and if it departs from that model, does it say why?",
    homes: [
      decl_ref(module_path: "std.temporal_effect", decl_name: "HeldLease"),
      decl_ref(module_path: "std.durable_compare_and_set", decl_name: "CasExpectation"),
      decl_ref(module_path: "std.scoped_authorization", decl_name: "ScopedAuthorization"),
      decl_ref(module_path: "std.effect_grant", decl_name: "Grant"),
      decl_ref(module_path: "std.resources", decl_name: "ResourceHandle"),
    ],
    tells: [
      "a flag file, a sleep, a retry loop or a bare Bool standing where a lease with a declared deadline was available",
      "a write to a shared head that does not carry the expectation it was computed against",
      "an effect performed without the grant that names who may perform it and how it is released"
    ],
  },
  ConformanceDomain {
    key: "conformance-compute",
    question: "Does the change allocate, place or negotiate resources -- a machine, a serving head, a build slot, a budget -- without inhabiting the corpus's compute and fabric model, and if it departs from that model, does it say why?",
    homes: [
      decl_ref(module_path: "gunbc.compute.work_request", decl_name: "WorkOperation"),
      decl_ref(module_path: "gunbc.compute.work_provider_local", decl_name: "ComputeLayout"),
      decl_ref(module_path: "gunbc.fabric_control_plane", decl_name: "CellReservation"),
      decl_ref(module_path: "gunbc.fabric_executor_class", decl_name: "CapacityClassAdmission"),
    ],
    tells: [
      "a host name, address or port chosen in the change instead of resolved from the fabric",
      "work run in the caller's own process or tree instead of requested as an exact-tree operation from a provider",
      "a capacity or budget literal that the provider's admission already decides"
    ],
  },
]

fn conformance_review_part(d: ConformanceDomain) -> PropositionReview {
  PropositionReview {
    part: d.key,
    question: d.question,
    tells: d.tells,
    answer: ConformanceThreeValued,
    homes: d.homes,
  }
}

fn yes_no_review(part: String, question: String, tells: List<String>) -> PropositionReview {
  PropositionReview { part: part, question: question, tells: tells, answer: YesIsADefect, homes: [] }
}

// WHETHER A PROPOSITION IS REVIEWABLE ON ONE CHANGE IS ITSELF A MODELED FACT, with its reason when it
// is not: an omitted reviewer is a decision, never an oversight (review 5125854144 on the first cut,
// which had `review: PropositionReview?` and gave `none` no reason). A reviewable proposition may
// decompose into several atomic parts, each its own reviewer; the part name is the criterion key.
type PropositionReviewDisposition
  = ReviewableOnChange { parts: List<PropositionReview> }
  | NotReviewableOnChange { reason: String }

type DesignRow {
  proposition: Proposition
  review: PropositionReviewDisposition
}

data design_axioms: List<Axiom> = [
  Axiom {
    id: "A1",
    statement: "there is a goal: to solve a problem presupposes an agent with a goal to satisfy",
    kind: NonLogicalAxiom
  },
  Axiom {
    id: "A2",
    statement: "time is the value: every agent intrinsically values time — time is life — the one value assumed shared",
    kind: NonLogicalAxiom
  },
  Axiom {
    id: "A3",
    statement: "agreement is temporal: intersubjective agreement is possible only across time, on what stays stable under it",
    kind: NonLogicalAxiom
  }
]

data design_section_1_rows: List<DesignRow> = [

  DesignRow {
    proposition: Proposition {
      id: "s1.minimal-safe-efficient",
      statement: "the solution is minimal, safe, efficient: a solution is good insofar as it spends less of the only thing valued, time (cost, safety, complexity)",
      premises: ["A1", "A2"]
    },
    review: NotReviewableOnChange { reason: "a consequence of the axioms about what a good solution IS; the reviewable propositions below are that standard applied to a change, and a change is not decidable against the standard itself" },
  },

  DesignRow {
    proposition: Proposition {
      id: "s1.grounding-intersubjective",
      statement: "grounding is intersubjective: because time is the only assumed-shared value, a fact is grounded only by pointing at a shared, time-stable framework",
      premises: ["A2", "A3"]
    },
    review: NotReviewableOnChange { reason: "its checkable form on a change is conformance to the shared authority's home; that reviewer is the conformance-extdeps domain of s3b.conformance, and asking it here as well would be two authorities for one judgment" },
  },

  DesignRow {
    proposition: Proposition {
      id: "s1.reduce-to-physics",
      statement: "at the limit, reduce intersubjectivity to physics: the efficient, time-bound description of interactions that satisfies a goal — A1-A2 turned on grounding itself",
      premises: ["A1", "A2", "s1.grounding-intersubjective"]
    },
    review: NotReviewableOnChange { reason: "the limit the whole argument aims at; no single change is decidable against a limit" },
  }
]

data design_section_1_argument: Argument = Argument {
  axioms: design_axioms,
  propositions: design_section_1_propositions
}

data design_section_2_to_7_rows: List<DesignRow> = [

  DesignRow {
    proposition: Proposition {
      id: "s2.minimize-redundancy",
      statement: "minimize redundancy is the master move for cost and complexity: redundant work loses on all three of §1's quantities at once, so a perfectly DRY process is by meaning the minimal/efficient one",
      premises: ["s1.minimal-safe-efficient"]
    },
    review: ReviewableOnChange { parts: [yes_no_review(
      part: "minimize-redundancy",
      question: "Does the change add work that already exists somewhere in the repository: a second representation of a fact, a copied accumulator, a parallel path beside a modeled one?",
      tells: [
        "a new type or function whose shape matches an existing one under another name",
        "a hand-written projection of something the model could generate",
        "a quadratic fold or a copied list where a single fold would do"
      ]
    )] },
  },

  DesignRow {
    proposition: Proposition {
      id: "s3.single-authority",
      statement: "single authority keeps §2 from being undone: minimization holds only if each fact lives in exactly one place; the recurring violation is nicknaming (a second name for one concept)",
      premises: ["s2.minimize-redundancy"]
    },
    review: ReviewableOnChange { parts: [yes_no_review(
      part: "single-authority",
      question: "Does the change give one concept a second name or a second home, or cite a position where a symbol exists?",
      tells: [
        "a literal string where a modeled value exists",
        "a file:line citation in prose or a row where a module and symbol could be named",
        "the same fact now answerable from two carriers with no relation stated between them"
      ]
    )] },
  },

  DesignRow {
    proposition: Proposition {
      id: "s3b.conformance",
      statement: "conformance is §2–§3 applied to a change: for every concept domain a change touches the corpus already homes the concept, so the change inhabits that model or states why it diverges; an unstated divergence is a fork that will be consolidated later at interest",
      premises: ["s2.minimize-redundancy", "s3.single-authority"]
    },
    review: ReviewableOnChange { parts: map(conformance_domains, d => conformance_review_part(d: d)) },
  },

  DesignRow {
    proposition: Proposition {
      id: "s3c.consumption",
      statement: "consumption is the converse of conformance: every declaration a change adds is consumed by a named consumer over an executing route, or it is redundant work by §2 and specification-without-execution by §5, however well modeled it is",
      premises: ["s2.minimize-redundancy", "s5.fail-closed"]
    },
    review: ReviewableOnChange { parts: [yes_no_review(
      part: "consumption",
      question: "Does the change add a declaration -- a type, function, data row, module or witness -- that nothing consumes by execution, or whose only consumer is a typecheck, a grep, or a witness asserting it exists? For each added declaration name the consumer and the route by which it is reached at execution, or the later change that will consume it with its trigger; a declaration with neither is dangling.",
      tells: [
        "a pub declaration with no call site anywhere in the closure the change compiles",
        "a data row no fold reads, or a module no module imports",
        "a witness that asserts a declaration exists or has a shape, rather than exercising it through its consumer",
        "consumption described in the change's prose or PR body but absent from the diff",
        "a frontier row naming a future consumer with no trigger beside it"
      ]
    )] },
  },

  DesignRow {
    proposition: Proposition {
      id: "s3d.decision-completeness",
      statement: "a decision is a closed subject, not an optimizer's output: completeness is a receipt over required (term, variable) cells and named populations, and no absence may be read as irrelevance; Settled may mint only over a complete closure",
      premises: ["s3.single-authority", "s5.fail-closed", "s1.minimal-safe-efficient"]
    },
    review: ReviewableOnChange { parts: [yes_no_review(
      part: "decision-completeness",
      question: "Does the change recommend or settle a policy while a term, alternative, constraint or context dependency lacks a disposition, treat an authored invariant as whole-axis irrelevance, or introduce weights, defaults or a candidate universe the subject does not own?",
      tells: [
        "a recommendation that varies one quantity while another required variable, objective term, constraint or context parameter has no disposition",
        "an Invariant or Ignored claim authored for a variable without closed relations for every applicable objective term",
        "a method that drops an objective term without an order-preservation authority against the actual objective composition",
        "a required population taken from the same list that carries dispositions for it",
        "a Settled standing minted while sensitivity, variable-population, constraint or parameter closure is incomplete"
      ]
    )] },
  },

  DesignRow {
    proposition: Proposition {
      id: "s4.closed-grounded-substrate",
      statement: "the closed, grounded substrate makes §2–§3 decidable: you can unify and decompose mechanically only in a closed, grounded system, and grounding is intersubjective",
      premises: ["s2.minimize-redundancy", "s3.single-authority", "s1.grounding-intersubjective"]
    },
    review: ReviewableOnChange { parts: [yes_no_review(
      part: "closed-grounded-substrate",
      question: "Does the change leave something opaque that is not atomic, or route around the substrate: a stringly leaf hiding named parts, a heuristic where a fact was available, an annotation inside a body?",
      tells: [
        "a String field carrying structure a record could name",
        "a threshold or guess standing where the richer source exists",
        "a // annotation inside a fn or type body rather than above a module-scope declaration"
      ]
    )] },
  },

  DesignRow {
    proposition: Proposition {
      id: "s5.fail-closed",
      statement: "fail-closed is §1's safety axis: minimizing cost and complexity is worthless if a wrong thing passes silently; stronger than catching a wrong state is making it unwritable (correctness by construction, not validation)",
      premises: ["s1.minimal-safe-efficient"]
    },
    review: ReviewableOnChange { parts: [yes_no_review(
      part: "fail-closed",
      question: "Does any failure arm in the change widen, default, or fall silent instead of refusing with a typed, located reason; and does any check stand where a construction was available?",
      tells: [
        "an arm that returns a superset, an empty value, or 'proceed' when it could not compute its answer",
        "an Option or wildcard that collapses two states with different remedies",
        "a toggle, env var or flag whose only effect is to skip a refusal",
        "a validator for a state the model could have made unwritable"
      ]
    )] },
  },

  DesignRow {
    proposition: Proposition {
      id: "s6.how-to-work",
      statement: "how to work given §1–§5: model by DFS-ing the concept DAG, prioritize holistically and denominate the benefit as displaced cost, and enforce by construction-first then lenses for the unstructurable residue",
      premises: ["s2.minimize-redundancy", "s3.single-authority", "s4.closed-grounded-substrate", "s5.fail-closed"]
    },
    review: ReviewableOnChange { parts: [yes_no_review(
      part: "how-to-work",
      question: "Does the change land temporary work, a workaround, or an unmarked scaffold without an operator's verdict, or a proven cost-shape defect left in place?",
      tells: [
        "'for now', 'temporary', 'until', 'bridge', 'shim', 'compatibility' with no dissolution obligation beside it",
        "a second path beside an existing modeled route",
        "a change that routes around a substrate refusal instead of naming it"
      ]
    )] },
  },

  DesignRow {
    proposition: Proposition {
      id: "s7.self-hosting",
      statement: "self-hosting applies the principles to the compiler itself: it is an ordinary substrate fact written in itself, and because a wall is a row over a medium-agnostic substrate, language design opens up (compiler-fork × language → row + medium)",
      premises: ["s4.closed-grounded-substrate", "s6.how-to-work", "s1.reduce-to-physics"]
    },
    review: NotReviewableOnChange { reason: "a program over the compiler judged by execution of emitted modules, not a property one change carries" },
  }
]

data design_section_1_propositions: List<Proposition> = map(design_section_1_rows, r => r.proposition)

data design_section_2_to_7_propositions: List<Proposition> = map(design_section_2_to_7_rows, r => r.proposition)

data design_rows: List<DesignRow> = concat(design_section_1_rows, design_section_2_to_7_rows)

data design_propositions: List<Proposition> = concat(design_section_1_propositions, design_section_2_to_7_propositions)

data design_argument: Argument = Argument {
  axioms: design_axioms,
  propositions: design_propositions
}
