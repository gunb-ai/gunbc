module gunbc.design_argument

import std.types { String, List }
import std.algebra { FreeSemigroup, non_empty_to_list }
import std.decl_ref { DeclarationRef, decl_ref }
import std.syllogism { Argument, Axiom, NonLogicalAxiom, Proposition }

// A NONEMPTY COLLECTION OF DECLARATION REFERENCES IS FreeSemigroup. A domain with no home has
// nothing to conform to. Missing-head construction of that carrier is unwritable (MissingField /
// head). A [] / Empty literal at a FreeSemigroup position is still the inhabitance seam owned by
// cardinality-vertical-slice, not this first-slice construction wall.

// EACH PROPOSITION CARRIES ITS OWN REVIEW READING, OR NONE. A DesignRow is one proposition of the
// serial argument plus, where the proposition is checkable on a single change, the question a
// reviewer asks of that change and the tells that its answer is yes. gunbc.roadmap.roadmap_review_criteria
// DERIVES the review roster from these rows (one criterion per row with a review, key from the id),
// so adding, changing or retiring a criterion is an edit to the proposition's own row here and
// nowhere else (operator, 2026-09-06: DESIGN criteria flow to reviews with no dual representation).
// A proposition without a review reading (an axiom's consequence, or a program like self-hosting) is
// still part of the argument and simply mints no reviewer.
// HOW A REVIEWER'S ANSWER MAPS TO A VERDICT IS A PROPERTY OF THE QUESTION, NOT OF THE REVIEWER.
// Most criteria ask a yes/no question whose yes is a defect. Conformance (gunbc.design_argument::conformance) asks a
// three-valued one, and the middle value -- a divergence with its reason stated -- is admitted, so
// collapsing it to yes/no would either block every deliberate departure or admit every accidental
// one. The verdict words themselves belong to gunbc.roadmap.roadmap_review_role (HeadVerdict); this
// algebra only says which shape of answer the question has, and that module maps it.
type ReviewAnswerAlgebra
  = YesIsADefect
  | ConformanceThreeValued

type PropositionReview
  = DefectReview {
      part: String
      question: String
      tells: List<String>
    }
  | ConformanceReview {
      domain: ConformanceDomain
    }

// A CONFORMANCE DOMAIN IS ONE CONCEPT THE CORPUS ALREADY HOMES, WITH THE DECLARATIONS THAT ARE ITS
// HOME (gunbc.design_argument::conformance). The conformance proposition's review parts are DERIVED from these rows,
// one reviewer per domain, so the domain list has one authority and DESIGN.md renders it rather
// than repeating it. A domain is added by adding a row; a domain whose home does not yet exist is a
// modeling obligation, not a row; a home that does not resolve is a section-3 citation defect.
//
// QUESTION and TELLS are reviewer-facing. LABEL, OWNS, BOUNDARIES and each group's LABEL and PURPOSE
// are reader-facing: DESIGN.md renders a domain as a heading, what it owns, what it deliberately does
// not absorb, and its home declarations grouped by what they do. The home declarations are the
// flattened groups (conformance_domain_homes), so the reviewer brief and DESIGN.md name one
// population. The review-plan identity hashes key, question, tells, answer algebra and homes
// (gunbc.roadmap.roadmap_review_criteria review_criterion_identity_text); the reader-facing text is
// excluded, so rewording it never invalidates a prior observation.
type ConformanceHomeGroup {
  label: String
  purpose: String
  homes: FreeSemigroup<DeclarationRef>
}

type ConformanceDomain {
  key: String
  label: String
  question: String
  tells: List<String>
  owns: String
  boundaries: List<String>
  home_groups: FreeSemigroup<ConformanceHomeGroup>
}

fn conformance_home_list(h: FreeSemigroup<DeclarationRef>) -> List<DeclarationRef> {
  non_empty_to_list(xs: h)
}

fn conformance_domain_home_groups(d: ConformanceDomain) -> List<ConformanceHomeGroup> {
  non_empty_to_list(xs: d.home_groups)
}

fn conformance_domain_homes(d: ConformanceDomain) -> List<DeclarationRef> {
  flat_map(conformance_domain_home_groups(d: d), g => conformance_home_list(h: g.homes))
}

data conformance_domains: List<ConformanceDomain> = [
  ConformanceDomain {
    key: "conformance-extdeps",
    label: "External facts",
    question: "Does the change carry a fact that other parties already agree on -- an upstream specification, a vendor's product, a protocol, a unit, a tool's interface -- without pointing at the extdeps module that owns it, or put such a fact somewhere other than the layer that owns it: a cited upstream fact modeled inside a product or workflow module, or a product policy or observation authored inside extdeps?",
    tells: [
      "a new type, enum or constant that restates what a standard, vendor sheet, man page or API document already defines, with no extdeps module citing it",
      "a value that is really an upstream fact (a port, a field name, a version, a limit, a wire shape) spelled as a literal in gunbc/ or a workflow module",
      "an extdeps module that carries our own policy, an observation this repository made, a coverage state, or a product-specific dispatch among upstreams",
      "a generic extdeps hub enumerating concrete products or versions instead of one module per independently versioned upstream"
    ],
    owns: "Facts governed by an independently versioned upstream: a specification, product, implementation, vendor, protocol, unit or tool. Each such upstream has its own extdeps module (gunbc.design_argument::external_upstreams).",
    boundaries: [
      "Product policy, observations this repository makes, dispatch among upstreams and coverage state belong to the consuming layer, never to extdeps.",
    ],
    home_groups: FreeSemigroup {
      head: ConformanceHomeGroup {
        label: "Upstream ownership",
        purpose: "what an external model may own",
        homes: FreeSemigroup {
          head: decl_ref(module_path: "extdeps.external_authority", decl_name: "ExternalModelScope"),
          tail: [],
        },
      },
      tail: [],
    },
  },
