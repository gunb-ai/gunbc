module gunbc.compile_permit_scope

import std.types { String, NonEmptyStr, List, Bool, list_length }
import std.measure { HardwareThreadCount }

// WHAT A BORROWER'S DEATH DOES TO FUTURE COMPILE CAPACITY. That is the fact gunbc#9789's declared
// DESIGN 4b(3) drop turns on, and until now it existed only as a sentence in an annotation while the
// policy it governs was an authored literal -- so the containment could outlive its own reason.
//
// The fleet's builds are bounded by a GNU jobserver whose permits are returned COOPERATIVELY. A
// SIGKILLed cargo returns nothing and no owner reclaims it, so the permit is not so much outliving
// its borrower as being ABANDONED: capacity is lost for the daemon's lifetime, there is no reaper,
// and a host at zero permits still accepts jobs. That is why the symptom is a slow queue and not a
// failure, and why the drop was declared rather than the leak simply fixed.
//
// THREE LAYERS, BECAUSE THEY ARE THREE FACTS. A concrete realization is what a host runs; a
// disposition is what that realization implies for capacity under kill; a standing is what has been
// OBSERVED to be true of the running fleet. Collapsing the first into the third is what lets a
// desired-state row authorize a policy the hosts have not yet earned.
type CompileParallelismRealization
  = BorrowerHeldCooperativeHostFifo { fifo_path: String, daemon_service: NonEmptyStr }
  | InvocationLocalCargo { jobs_per_slot: HardwareThreadCount }

// THE SEMANTIC OUTCOME, WHICH IS WHAT POLICY IS ALLOWED TO SEE. Business policy that matched
// realization variants would have to learn FIFO paths and systemd service names, and would need a
// new business branch every time a realization appeared -- the layer inversion DESIGN section 3
// names. It reads this instead.
//
// CapacityPreservedByServerReclamation HAS NO CONCRETE REALIZATION TODAY, and it belongs here
// anyway: it is one of the two arms the controlling dissolve-on names as SUFFICIENT, it has an
// immediate consumer in the policy fold below, and it is fixture-authorable. Omitting it would
// narrow the trigger to one of its two arms -- the failure DESIGN 4b(3) warns about, where a trigger
// naming less than the capability is satisfied while the capability stays dead. What would be
// vocabulary ahead of its consumer is a concrete server realization with guessed fields, and that is
// deliberately absent until someone builds one.
type BorrowerDeathCapacityDisposition
  = CapacityLostUntilPoolRestart
  | CapacityPreservedByInvocationLifetime
  | CapacityPreservedByServerReclamation

// ONE DECISION PROCEDURE OVER THIS FACT, not two. An earlier draft declared a Boolean
// `permit_outlives_borrower` as "the decidable question" and then had the policy fold independently
// re-match the same realization type -- two procedures over one fact, which is what DESIGN section 2
// removes. A Boolean was also the wrong shape: unsafe, safe-by-local-lifetime and
// safe-by-server-reclamation are materially different states, and a fourth -- unobserved -- is not a
// property of the realization at all but of our knowledge of the fleet, which is why it lives on the
// standing below rather than here.
fn borrower_death_capacity_disposition(
  realization: CompileParallelismRealization,
) -> BorrowerDeathCapacityDisposition {
  match realization {
    BorrowerHeldCooperativeHostFifo { fifo_path: _, daemon_service: _ } => CapacityLostUntilPoolRestart
    InvocationLocalCargo { jobs_per_slot: _ } => CapacityPreservedByInvocationLifetime
  }
}

fn disposition_preserves_capacity(disposition: BorrowerDeathCapacityDisposition) -> Bool {
  match disposition {
    CapacityLostUntilPoolRestart => false
    CapacityPreservedByInvocationLifetime => true
    CapacityPreservedByServerReclamation => true
  }
}

// WHAT A HOST HAS BEEN OBSERVED TO BE RUNNING, which is not what a row desires it to run.
//
// This is the boundary the first draft of this module got wrong, and the error was a fail-open of
// exactly the kind DESIGN section 5 forbids. Deriving the workflow policy straight from a desired
// realization row would restore cancellation the moment the workflow change reached main, whether or
// not any host had received and restarted onto the new unit -- so between merge and convergence, CI
// would supersede running builds on hosts still leaking a permit for every kill. A generated
// artifact can make a rendered unit and a rendered workflow agree; it cannot make host deployment
// and GitHub workflow activation atomic.
//
// So the safe arm carries its READBACK rather than asserting itself: what the active unit says, not
// what the model wishes it said.
type HostCompileCancellationStanding
  = HostCancellationSafe {
      host: NonEmptyStr,
      disposition: BorrowerDeathCapacityDisposition,
      active_unit_readback: NonEmptyStr,
    }
  | HostCancellationUnsafe { host: NonEmptyStr, cause: NonEmptyStr }
  | HostCancellationUnobserved { host: NonEmptyStr, cause: NonEmptyStr }

type FleetCompileCancellationStanding
  = FleetCancellationSafe { hosts: List<NonEmptyStr> }
  | FleetCancellationNotSafe { unsafe_hosts: List<NonEmptyStr>, unobserved_hosts: List<NonEmptyStr> }

type FleetCancellationFoldAcc {
  unsafe_hosts: List<NonEmptyStr>
  unobserved_hosts: List<NonEmptyStr>
  safe_hosts: List<NonEmptyStr>
}

// ONE UNSAFE, MIXED OR UNREAD HOST KEEPS THE CONTAINMENT IN FORCE, and an EMPTY observation set is
// not safe either -- it is the empty-observation narrowing this repository has a named failure mode
// for. A fleet nobody has looked at is unobserved, and unobserved is on the refusing side.
//
// The caller supplies the eligible-host denominator, so a host that satisfies the workflow's runner
// selector and produced no observation arrives here as HostCancellationUnobserved rather than being
// silently absent from the fold. A fold that ranged only over the observations it happened to
// receive would answer SAFE for a fleet it had never asked about.
fn fleet_cancellation_standing(
  observations: List<HostCompileCancellationStanding>,
) -> FleetCompileCancellationStanding {
  let acc = fold(
    observations,
    init: FleetCancellationFoldAcc { unsafe_hosts: [], unobserved_hosts: [], safe_hosts: [] },
    f: (a, o) => match o {
      HostCancellationSafe { host: h, disposition: d, active_unit_readback: _ } =>
        match disposition_preserves_capacity(disposition: d) {
          true => FleetCancellationFoldAcc {
            unsafe_hosts: a.unsafe_hosts,
            unobserved_hosts: a.unobserved_hosts,
            safe_hosts: concat(a.safe_hosts, [h]),
          }
          // A readback that says SAFE while carrying a disposition that loses capacity is a
          // contradiction in the observation, not a safe host. It joins the unsafe side.
          false => FleetCancellationFoldAcc {
            unsafe_hosts: concat(a.unsafe_hosts, [h]),
            unobserved_hosts: a.unobserved_hosts,
            safe_hosts: a.safe_hosts,
          }
        }
      HostCancellationUnsafe { host: h, cause: _ } => FleetCancellationFoldAcc {
        unsafe_hosts: concat(a.unsafe_hosts, [h]),
        unobserved_hosts: a.unobserved_hosts,
        safe_hosts: a.safe_hosts,
      }
      HostCancellationUnobserved { host: h, cause: _ } => FleetCancellationFoldAcc {
        unsafe_hosts: a.unsafe_hosts,
        unobserved_hosts: concat(a.unobserved_hosts, [h]),
        safe_hosts: a.safe_hosts,
      }
    },
  )
  // SAFE REQUIRES BOTH a non-empty safe roster AND an empty not-safe one. The first conjunct is what
  // keeps an empty observation set on the refusing side: a fleet nobody looked at has no unsafe and
  // no unobserved host either, so testing only the second would report SAFE for silence.
  let blocking = list_length(items: concat(acc.unsafe_hosts, acc.unobserved_hosts))
  let observed_safe = list_length(items: acc.safe_hosts)
  let fleet_is_safe = (blocking == 0) && (observed_safe > 0)
  match fleet_is_safe {
    true => FleetCancellationSafe { hosts: acc.safe_hosts }
    false => FleetCancellationNotSafe {
      unsafe_hosts: acc.unsafe_hosts,
      unobserved_hosts: acc.unobserved_hosts,
    }
  }
}

// THE FLEET AS OBSERVED TODAY: nothing. No host readback exists yet, so the standing is NotSafe with
// an empty roster on both sides, and the policy below stays NeverSupersedeRunning BY REFUSAL rather
// than by a literal someone has to remember to keep. Publishing real observations is what moves it,
// and that is the second stage of the cutover -- deploy and restart the safe realization on every
// eligible host, read the active units back, bind the receipts, and only then does the policy move.
data fleet_compile_cancellation_standing: FleetCompileCancellationStanding =
  fleet_cancellation_standing(observations: [])
