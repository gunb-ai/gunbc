module gunbc.ci_workflow_expressions


fn ci_cache_hash_files() -> extdeps.github.expressions.Expression {
  extdeps.github.expressions.FunctionCall {
    function: extdeps.github.expressions.HashFiles,
    args: [
      extdeps.github.expressions.StringLiteral { value: "**/Cargo.lock" },
      extdeps.github.expressions.StringLiteral { value: "rust-toolchain.toml" }
    ]
  }
}

// MAIN COMMITS ARE NEVER SUPERSEDED (operator directive 2026-08-13: "we could really use
// the information from all main commits"). The discriminator has three arms, read in
// order by GitHub's `||`:
//   - a pull_request event groups by PR number, so pushing to a PR still cancels its own
//     in-flight run — supersession on a branch is the well-intended half and is retained;
//   - a push to main groups by github.sha, which is unique per commit, so two main
//     commits are never in the same concurrency group and neither can cancel the other;
//   - everything else (merge_group, tags, other branches) keeps the ref key unchanged.
// Precedence is GitHub's own — `==` binds tighter than `&&`, which binds tighter than
// `||` — so the serialized form needs no parentheses and the AST carries the grouping.
//
// This is deliberately NARROWER than a globally unique key, and the distinction is the
// one the stop-policy note below already drew: a run_id or a bare sha discriminator would
// give EVERY event its own group, making cancellation unreachable everywhere while the
// policy still read as if it worked. Only the main-push arm is exempted, and only because
// on main a cancelled run destroys the sole verdict that commit will ever get.
fn ci_concurrency_discriminator() -> extdeps.github.expressions.Expression {
  extdeps.github.expressions.LogicalOr {
    left: extdeps.github.expressions.LogicalOr {
      left: extdeps.github.expressions.ContextAccess { context: extdeps.github.expressions.Github, path: ["event", "pull_request", "number"] },
      right: extdeps.github.expressions.LogicalAnd {
        left: extdeps.github.expressions.Equals {
          left: extdeps.github.expressions.ContextAccess { context: extdeps.github.expressions.Github, path: ["ref"] },
          right: extdeps.github.expressions.StringLiteral { value: "refs/heads/main" }
        },
        right: extdeps.github.expressions.ContextAccess { context: extdeps.github.expressions.Github, path: ["sha"] }
      }
    },
    right: extdeps.github.expressions.ContextAccess { context: extdeps.github.expressions.Github, path: ["ref"] }
  }
}

data ci_concurrency_group_template: extdeps.github.expressions.ExpressionTemplate = {
  segments: [
    extdeps.github.expressions.Interpolation { expression: extdeps.github.expressions.ContextAccess { context: extdeps.github.expressions.Github, path: ["workflow"] } },
    extdeps.github.expressions.LiteralText { text: "-" },
    extdeps.github.expressions.Interpolation { expression: ci_concurrency_discriminator() }
  ]
}

data ci_setup_rust_home_template: extdeps.github.expressions.ExpressionTemplate = {
  segments: [
    extdeps.github.expressions.Interpolation { expression: extdeps.github.expressions.runner_temp() }
  ]
}

data ci_cache_path_template: extdeps.github.expressions.ExpressionTemplate = {
  segments: [
    extdeps.github.expressions.Interpolation { expression: extdeps.github.expressions.runner_temp() },
    extdeps.github.expressions.LiteralText { text: "/cargo/registry/index/\n" },
    extdeps.github.expressions.Interpolation { expression: extdeps.github.expressions.runner_temp() },
    extdeps.github.expressions.LiteralText { text: "/cargo/registry/cache/\n" },
    extdeps.github.expressions.Interpolation { expression: extdeps.github.expressions.runner_temp() },
    extdeps.github.expressions.LiteralText { text: "/cargo/git/db/\ntarget/" }
  ]
}

data ci_cache_key_template: extdeps.github.expressions.ExpressionTemplate = {
  segments: [
    extdeps.github.expressions.LiteralText { text: "cargo-ci-" },
    extdeps.github.expressions.Interpolation { expression: extdeps.github.expressions.runner_os() },
    extdeps.github.expressions.LiteralText { text: "-" },
    extdeps.github.expressions.Interpolation { expression: extdeps.github.expressions.runner_arch() },
    extdeps.github.expressions.LiteralText { text: "-" },
    extdeps.github.expressions.Interpolation { expression: ci_cache_hash_files() }
  ]
}

data ci_cache_restore_keys_template: extdeps.github.expressions.ExpressionTemplate = {
  segments: [
    extdeps.github.expressions.LiteralText { text: "cargo-ci-" },
    extdeps.github.expressions.Interpolation { expression: extdeps.github.expressions.runner_os() },
    extdeps.github.expressions.LiteralText { text: "-" },
    extdeps.github.expressions.Interpolation { expression: extdeps.github.expressions.runner_arch() },
    extdeps.github.expressions.LiteralText { text: "-\n" }
  ]
}

data ci_workflow_expression_templates: List<extdeps.github.expressions.ExpressionTemplate> = [
  ci_concurrency_group_template,
  ci_setup_rust_home_template,
  ci_cache_path_template,
  ci_cache_key_template,
  ci_cache_restore_keys_template
]

// UNIFIED FLEET JOB condition (operator request 2026-08-10: "a single fleet convergence
// job — it's overwhelming to see so many"). The ten former deploy/convergence/toolbox
// jobs collapse into one `fleet` job whose STEPS carry the per-event guard; this is the
// job-level gate that decides whether the job runs AT ALL, so on ordinary PRs the whole
// fleet job is skipped as ONE row instead of ~nine. Two arms:
//   - main-push convergence (deploy + collect + advance): !cancelled() +
//     needs.ci.result == 'success' + main + push;
//   - workflow_dispatch toolbox (scan/enroll/probe/observe/timer/authorized-key): the
//     manual fleet ops.
//
// THE !cancelled() + needs.ci.result GUARD ON THE PUSH ARM IS A WALL, NOT DECORATION
// (MEASURED REPAIR 2026-08-09, CONVERGE acceptance — carried forward from the former
// ci_deploy_push_to_main_if, which this expression replaced when the family collapsed
// into one job). Every job in the former push-to-main family had been SKIPPED on every
// main push for 30+ pushes: heal_generated_artifacts SKIPS on ordinary pushes, `ci`
// survives it via its own `!cancelled()`, but a needs:[ci] job whose `if` carries NO
// status function gets GitHub's implicit success() ANDed in, and success() is false
// downstream of any transitively skipped job — so the whole family silently skipped while
// every clause it named was true (an empty-observation narrow: 'dependency skipped'
// rendered as 'condition false'). The push arm therefore carries its own status guard
// explicitly. The RED control for this class lives in test.claim.ci_workflow_witness
// push_to_main_family_carries_explicit_status_guard, which now reads this expression.
data ci_fleet_job_if: String = "!cancelled() && ((github.ref == 'refs/heads/main' && github.event_name == 'push' && needs.ci.result == 'success') || github.event_name == 'workflow_dispatch')"

data ci_floor_runs_unless_cancelled_if: String = "!cancelled()"

data ci_floor_upstream_red_refusal_script: String = "set -e\nBUILD='${{ needs.build.result }}'\nREGEN='${{ needs.regen.result }}'\nHEAL='${{ needs.heal_generated_artifacts.result }}'\nif [ \"$BUILD\" != \"success\" ] || [ \"$REGEN\" != \"success\" ] || [ \"$HEAL\" = \"failure\" ]; then\necho \"::error::FloorUpstreamAlreadyRed build=$BUILD regen=$REGEN heal=$HEAL — an upstream job already established this branch is red, so the floor refuses before spending its budget. The located cause is that job's own diagnostic; this step adds no verdict of its own.\"\nexit 1\nfi\necho \"[floor-preflight] upstream clean: build=$BUILD regen=$REGEN heal=$HEAL\""

data ci_floor_upstream_red_refusal_note: String = "THE FLOOR REFUSES ON AN ALREADY-RED BRANCH BY RUNNING AND FAILING FAST, NEVER BY BEING SKIPPED. Goal (operator analysis 2026-08-05): 'a branch can already be known to have ci.yml or generated-artifact drift while the 65-minute floor continues consuming a runner'. ci needs [build, regen, heal_generated_artifacts] so the floor is orderable after the cheap preflights, and this step is its first step.\n\nTHE FIRST IMPLEMENTATION OF THIS ROW WAS A FAIL-OPEN AND IS RETRACTED (review 49309, cursor/composer-2.5, 2026-08-06). It set the job condition to `!failure() && !cancelled()`, so an upstream failure SKIPPED ci. The retracted note asserted 'a skipped job does not satisfy a required check, so this makes drift BLOCK the merge'. That sentence was false, and it was written from reasoning rather than from a receipt — the §5 trap of fluent output that was never run. GitHub's own troubleshooting-required-status-checks page states that a job skipped by a conditional REPORTS SUCCESS, and that a job skipped because a needed job failed 'may not block merging'. The live default-branch ruleset (id 16178731) names exactly one required context, `ci`; heal_generated_artifacts is not required. Composing those two facts: drift would have left ci skipped-as-success while only the non-required heal job was red, so GeneratedArtifactDriftGate and the merge-admission receipt stamping could be bypassed entirely. The change intended to remove wasted computation would have removed the only merge wall.\n\nWHAT HOLDS NOW. The condition is `!cancelled()`, so ci RUNS whenever the run is live — including when an upstream job failed — and the required check therefore always produces a real verdict. The refusal moved into this step, which is the job's first step and reads needs.<job>.result directly: build and regen must be `success`, and heal must not be `failure`. A refusal is a typed, located, exit-1 RED on the required context, not an absence. The budget saving is preserved because the step is a runner spin-up plus a string compare, not a floor run.\n\nheal is allowed to be `skipped` because it is pull_request-only (ci_regen_heal_if); on push to main, merge_group and workflow_dispatch it does not run and the floor proceeds, preserving main's cold control. Only `failure` refuses, which covers both HealAuthorCommitRequired (drift the app cannot push) and the deliberate SupersededByHealedHead exit that fires after heal auto-pushes a repair — in the latter case the superseded head correctly stops and the healed commit gets its own run.\n\nA SIDE EFFECT WORTH NAMING: before this change ci carried no condition at all, so a failed build or regen SKIPPED it, and by the same GitHub rule that skip did not reliably block merging either. Making the job unconditional-on-failure closes that pre-existing hole in the same motion rather than leaving a second instance of the class behind."

data ci_concurrency_cancel_in_progress_if: String = "${{ github.event_name != 'merge_group' }}"

data ci_concurrency_event_scoped_stop_policy_note: String = "Event-scoped stop policy (operator ruling 2026-07-22; CI RESET lane 2026-08-10; main-push exemption 2026-08-13): cancel-in-progress is true for pull_request / push / workflow_dispatch and false for merge_group (the queue must not kill an in-flight check when another PR enters the queue — gunbc.ci_workflow ci_merge_group_trigger_note). SUPERSESSION REQUIRES BOTH ARMS: cancel-in-progress plus a shared group key, and main is now exempted through the GROUP arm rather than the cancel arm. ci_concurrency_discriminator groups PR events by pull_request.number, push-to-main by github.sha, and everything else by github.ref — never run_id, which is unique per run and would give every event its own group, making cancellation unreachable everywhere while this note still read as if it worked.\n\nWHY THE GROUP ARM AND NOT THE CANCEL ARM. Setting cancel-in-progress false for main would leave main pushes sharing one group key, and GitHub QUEUES same-group runs when cancellation is off. Measured 2026-08-13: the floor's merge-critical wall is 84.2 minutes (run 31672107941, the last main run to complete) against a 9.8-minute median gap between main pushes — 8.6x — so a queued policy accumulates an unbounded backlog and delivers each verdict hours after the commit it judges. A per-commit group key runs them concurrently instead, which is the only arm that yields a verdict per main commit at this arrival rate.\n\nWHAT THIS COSTS, stated because it is a real load increase and not a free win: a superseded main run previously died after roughly 10 minutes, so cancellation was also acting as an unmeasured load shedder. Retaining every main run raises average main CI cost from that partial run to the full 84 minutes, roughly 8x aggregate main load on a fixed self-hosted fleet. That is the price of observing main at all, and it falls as the floor shortens. If fleet saturation appears before the floor lands, the next move is batching main verdicts across commits — NOT restoring cancellation, which trades the saturation problem for a blindness problem.\n\nThe expression pair is the single authority; dissolve-on: typed EventStopPolicy + group-key rows per trigger replace the hand-spelled strings when the workflow model carries event-grain policy by construction."

data ci_concurrency_event_scoped_stop_policy_disposition: std.disposition.Disposition = std.disposition.Scaffold {
  dissolves_to: std.disposition.SingleAuthority,
  bind: std.decl_ref.DeclarationRef {
    module_path: "gunbc.ci_workflow_expressions",
    decl_name: "ci_concurrency_cancel_in_progress_if",
    field: std.decl_ref.WholeDeclaration
  }
}

fn ci_concurrency_cancel_in_progress_expression() -> String { ci_concurrency_cancel_in_progress_if }

fn ci_concurrency_group() -> String { extdeps.github.expressions.serialize_template(template: ci_concurrency_group_template) }
fn ci_setup_rust_home() -> String { extdeps.github.expressions.serialize_template(template: ci_setup_rust_home_template) }
fn ci_cache_path() -> String { extdeps.github.expressions.serialize_template(template: ci_cache_path_template) }
fn ci_cache_key() -> String { extdeps.github.expressions.serialize_template(template: ci_cache_key_template) }
fn ci_cache_restore_keys() -> String { extdeps.github.expressions.serialize_template(template: ci_cache_restore_keys_template) }
