module gunbc.ci_workflow_expressions

import extdeps.github.expressions {
  Expression, ContextAccess, FunctionCall, StringLiteral, LogicalOr,
  ExpressionTemplate, TemplateSegment, LiteralText, Interpolation,
  HashFiles, Github,
  serialize_template, runner_os, runner_arch, runner_temp
}
import std.disposition { Disposition, Scaffold, SingleAuthority }
import std.decl_ref { DeclarationRef, WholeDeclaration }

fn ci_cache_hash_files() -> Expression {
  FunctionCall {
    function: HashFiles,
    args: [
      StringLiteral { value: "**/Cargo.lock" },
      StringLiteral { value: "rust-toolchain.toml" }
    ]
  }
}

fn ci_concurrency_discriminator() -> Expression {
  LogicalOr {
    left: ContextAccess { context: Github, path: ["event", "pull_request", "number"] },
    right: ContextAccess { context: Github, path: ["run_id"] }
  }
}

data ci_concurrency_group_template: ExpressionTemplate = {
  segments: [
    Interpolation { expression: ContextAccess { context: Github, path: ["workflow"] } },
    LiteralText { text: "-" },
    Interpolation { expression: ci_concurrency_discriminator() }
  ]
}

data ci_setup_rust_home_template: ExpressionTemplate = {
  segments: [
    Interpolation { expression: runner_temp() }
  ]
}

data ci_cache_path_template: ExpressionTemplate = {
  segments: [
    Interpolation { expression: runner_temp() },
    LiteralText { text: "/cargo/registry/index/\n" },
    Interpolation { expression: runner_temp() },
    LiteralText { text: "/cargo/registry/cache/\n" },
    Interpolation { expression: runner_temp() },
    LiteralText { text: "/cargo/git/db/\ntarget/" }
  ]
}

data ci_cache_key_template: ExpressionTemplate = {
  segments: [
    LiteralText { text: "cargo-ci-" },
    Interpolation { expression: runner_os() },
    LiteralText { text: "-" },
    Interpolation { expression: runner_arch() },
    LiteralText { text: "-" },
    Interpolation { expression: ci_cache_hash_files() }
  ]
}

data ci_cache_restore_keys_template: ExpressionTemplate = {
  segments: [
    LiteralText { text: "cargo-ci-" },
    Interpolation { expression: runner_os() },
    LiteralText { text: "-" },
    Interpolation { expression: runner_arch() },
    LiteralText { text: "-\n" }
  ]
}

data ci_workflow_expression_templates: List<ExpressionTemplate> = [
  ci_concurrency_group_template,
  ci_setup_rust_home_template,
  ci_cache_path_template,
  ci_cache_key_template,
  ci_cache_restore_keys_template
]

data ci_deploy_push_to_main_if: String = "github.ref == 'refs/heads/main' && github.event_name == 'push'"

data ci_floor_upstream_clean_if: String = "!failure() && !cancelled()"

data ci_floor_upstream_clean_if_note: String = "The floor does not start when an upstream job has ALREADY established the branch is red (operator analysis 2026-08-05: 'a branch can already be known to have ci.yml or generated-artifact drift while the 65-minute floor continues consuming a runner'). ci now needs [build, regen, heal_generated_artifacts]; this expression is what keeps that from breaking every non-pull_request event.\n\nWHY AN EXPRESSION IS REQUIRED AT ALL: a job whose `needs` includes a SKIPPED job is itself skipped by default, and heal is pull_request-only (ci_regen_heal_if). Adding heal to ci's needs without this would skip the floor on every push to main, on merge_group, and on workflow_dispatch - silently deleting main's cold control. Naming any status function in the `if` makes the job evaluate the condition instead of auto-skipping, so `!failure() && !cancelled()` reads as: run unless something upstream actually FAILED or was cancelled. A skipped dependency is neither.\n\nTHE FOUR CASES, all deliberate. (1) pull_request, heal finds no drift: HealNoChange exits 0, floor runs - the ordinary path, and heal is parallel with regen (both need only build) so this adds no wall time. (2) pull_request, heal reports HealAuthorCommitRequired: heal exits 1, floor is skipped rather than spending its budget proving what the drift gate would refuse anyway. (3) pull_request, heal auto-pushes a repair: heal deliberately exits 1 after 'SupersededByHealedHead ... revalidation-required', so the floor is skipped ON THE SUPERSEDED HEAD and the healed commit gets its own run - previously the run continued against a head that was already obsolete. (4) push to main / merge_group / workflow_dispatch: heal is skipped, no failure, floor runs unconditionally as before.\n\nWHY SKIPPING THE FLOOR IS NOT A FAIL-OPEN: the branch ruleset requires the `ci` context, and a skipped job does not satisfy a required check, so this makes drift BLOCK the merge instead of being a red the floor might have masked. It removes wasted computation, not a gate - the drift refusal that caused the skip is itself the typed, located diagnostic (DESIGN section 5), and it is emitted before the expensive stage rather than after it."

data ci_concurrency_cancel_in_progress_if: String = "${{ github.event_name != 'merge_group' }}"

data ci_concurrency_event_scoped_stop_policy_note: String = "Event-scoped stop policy (operator ruling 2026-07-22, fail-fast lane): cancel-in-progress is true for pull_request / push / workflow_dispatch (supersede stale runs on new commits) and false for merge_group (the queue must not kill an in-flight check when another PR enters the queue — gunbc.ci_workflow ci_merge_group_trigger_note). The expression is the single authority; dissolve-on: a typed EventStopPolicy row per trigger replaces the hand-spelled string when the workflow model carries event-grain policy by construction."

data ci_concurrency_event_scoped_stop_policy_disposition: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.ci_workflow_expressions",
    decl_name: "ci_concurrency_cancel_in_progress_if",
    field: WholeDeclaration
  }
}

fn ci_concurrency_cancel_in_progress_expression() -> String { ci_concurrency_cancel_in_progress_if }

fn ci_concurrency_group() -> String { serialize_template(template: ci_concurrency_group_template) }
fn ci_setup_rust_home() -> String { serialize_template(template: ci_setup_rust_home_template) }
fn ci_cache_path() -> String { serialize_template(template: ci_cache_path_template) }
fn ci_cache_key() -> String { serialize_template(template: ci_cache_key_template) }
fn ci_cache_restore_keys() -> String { serialize_template(template: ci_cache_restore_keys_template) }
