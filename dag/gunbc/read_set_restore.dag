// THE PULL-REQUEST SIDE OF THE PLANNING FAST LANE (gunbc.read_set_publish is the main side; the operator
// admitted the receipt it consumes in @ref(gunbc.design_ruling::seed_read_set_receipt_is_admitted), "so the
// required job can skip the emit and build when a pull request changes nothing that acquisition reads").
//
// ONE UNIT, ONE DECISION, THE FULL PATH AS THE FALLBACK. Early in the required job, a pull-request run
// restores the fast-lane unit main saved for the nearest first-parent ancestor of the base (the same located
// ancestors and selection policy as the parse-verdict chain, gunbc.parse_verdict_restore), and one step
// decides whether that unit covers the change. The unit is saved as main's LAST step, so its presence for a
// sha means every step of that sha's run went green; it holds the seed's read-set receipt for both emitted
// products, the native CLI that run built, and that binary's compiler identity. If no changed path since the
// restored ancestor is an input of that run, the closure-dependent steps (the seed build and
// both emit-and-build subjects) would compute what they computed there, so the run
// reuses that verdict and runs only the whole-tree checks over the pull request's tree with the restored
// binary. Anything else -- no unit, an incomplete or malformed unit, a diff git cannot answer, a changed input,
// a failure inside the step -- is the full path, unchanged.
//
// THE RULE IS fast_lane_decide; THE STEP IS ITS REALIZATION. The pure function below is what the witness
// (test.claim.read_set_restore_witness) executes. The emitted script is built from the same rule rows
// (fast_lane_declared_entries, the recording kinds of v2.std.read_set, std.content_hash
// sha256_hex_digit_count) and checks the same conditions in the same order; the two realizations of the
// matching itself (list membership and prefix tests here, grep there) are kept equal by construction of the
// rows, not by a shared executor -- that residue is stated, not hidden.
//
// THE DIFF IS FROM THE RESTORED ANCESTOR, NOT FROM THE BASE, so commits main gained after the restored
// ancestor are judged too. Rename detection is OFF (`--no-renames`), so a rename is reported as the deletion
// of its old path and the addition of its new one: both sides are tested against the rules with no parsing of
// rename records. The diff is NUL-delimited; a path carrying a newline cannot be decided line-wise and forces
// the full run.
//
// A RESTORED BINARY IS NOT CALLED FRESH. The emit steps that pass GUNBC_NATIVE_PRODUCT_REUSE=fresh do not run
// on a reused run, and the decision prints which ancestor's binary it reuses. The fresh-product label keeps
// its meaning: where it is passed, this run built the product.

// ═══ THE RULE ═══
//
// THE VALIDITY QUESTION IS v2.std.read_set's (validate_read_set, its one matcher and the recording format);
// this lane is its required-job consumer (gunbc.plans.read_set_convergence section 2.4): it adds the checks on
// the restored realization product (receipt present, binary executable, identity well formed), declares the
// inputs the recorder does not observe, and maps every outcome that is not valid to a full run with its cause.

// WHY AN INPUT IS DECLARED rather than observed.
type FastLaneDeclaredInput
  = FastLaneFixedInput
  | FastLaneDecisionImplementation

// THE FIXED INPUTS: what the guarded steps consume that the receipt does not record. The seed's own source
// (src/v1) builds the binary every guarded step runs, and stays an invalidating input until the current seed
// identity can be established independently of the restored binary (gunbc.plans.read_set_convergence, A1);
// the workspace manifests, lockfile, toolchain pin and cargo configuration decide how both the seed and the
// emitted crates are built; the native CLI's control walks read fixture roots; and .github holds the workflow
// that is executing, including this decision's own emitted script.
// The seed's build inputs are declared once in gunbc.seed_build_inputs (heal's scoped round reads the same
// list); this lane adds what is its own: the fixture roots and the executing workflow tree.
data fast_lane_fixed_input_members: List<ReadSetMember> = concat(seed_build_input_members, [
  ReadSetDir { path: "fixtures" },
  ReadSetDir { path: ".github" },
])

// THE DECISION'S OWN IMPLEMENTATION, AND THE LAYOUT POLICY THE CHECKS READ. Running a changed decision to
// judge whether its own change may skip is circular, so a change to any of these modules is a full run. The
// machinery they import reaches the job only through the regenerated workflow, which .github/ already covers.
// Named by module, so the path is the layout's (gunbc.source_layout layout_module_storage_path). A module the
// layout cannot place is a full run in the rule and refuses emission of the step (fast_lane_decision_script),
// so the lane switches itself off rather than miss its own implementation.
data fast_lane_decision_implementation_modules: List<String> = [
  "v2.std.read_set",
  "gunbc.seed_build_inputs",
  "gunbc.read_set_schema",
  "gunbc.read_set_publish",
  "gunbc.read_set_restore",
  "gunbc.parse_verdict_schema",
  "gunbc.parse_verdict_publish",
  "gunbc.parse_verdict_restore",
  "gunbc.witness.compiler_gate_workflow",
  "gunbc.source_layout",
  "gunbc.source_layout_namespaces",
  "gunbc.layout_namespace_row",
  "gunbc.layout_namespace_row.gunbc_tree",
]

fn fast_lane_unplaceable_modules() -> List<String> {
  filter(fast_lane_decision_implementation_modules, m => layout_module_storage_path(module: m) == Absent)
}

fn fast_lane_declared_entries() -> List<ReadSetEntry<FastLaneDeclaredInput>> {
  list_append(
    left: list_map(xs: fast_lane_fixed_input_members, f: fn(m) { ReadSetEntry { member: m, origin: ReadSetDeclared { reason: FastLaneFixedInput } } }),
    right: fold_list(xs: fast_lane_decision_implementation_modules, empty: [], cons: fn(acc, m) {
      match layout_module_storage_path(module: m) {
        Present { value: p } => concat(acc, [ReadSetEntry { member: ReadSetFile { path: p }, origin: ReadSetDeclared { reason: FastLaneDecisionImplementation } }])
        Absent => acc
      }
    })
  )
}

type FastLaneUnitObservation
  = FastLaneUnitAbsent
  | FastLaneUnitRestored { receipt_lines: List<String>, binary_executable: Bool, identity_text: String }

type FastLaneFullRunCause
  = FastLaneNoUnitRestored
  | FastLaneReceiptEmpty
  | FastLaneBinaryNotExecutable
  | FastLaneIdentityMalformed
  | FastLaneImplementationUnplaceable { module: String }
  | FastLaneReadSetUnestablished { cause: ReadSetUnestablishedCause }
  | FastLaneInputChanged { path: String, entry: ReadSetEntry<FastLaneDeclaredInput> }

type FastLaneVerdict
  = FastLaneReuse
  | FastLaneFullRun { cause: FastLaneFullRunCause }

// THE WHOLE IDENTITY FILE IS VALIDATED, not a line of it: exactly the digest followed by one newline, as the
// stage step writes it, so a valid line followed by an unterminated tail is malformed. The script checks the
// same three facts: the byte count, a single newline, and the first sha256_hex_digit_count bytes being the
// digest -- together they leave the newline nowhere but last.
fn fast_lane_identity_file_bytes() -> Int { sha256_hex_digit_count + 1 }

fn fast_lane_identity_is_well_formed(identity_text: String) -> Bool {
  string_length(s: identity_text) == fast_lane_identity_file_bytes()
    && substring(s: identity_text, start: sha256_hex_digit_count, end: fast_lane_identity_file_bytes()) == "\n"
    && lower_hex_64(value: substring(s: identity_text, start: 0, end: sha256_hex_digit_count))
}

// THE CONSUMER'S MAPPING: valid reuses; anything else is the full run, carrying why.
fn fast_lane_verdict_of_validity(validity: ReadSetValidity<FastLaneDeclaredInput>) -> FastLaneVerdict {
  match validity {
    ReadSetValid => FastLaneReuse
    ReadSetInvalidated { path: p, entry: e } => FastLaneFullRun { cause: FastLaneInputChanged { path: p, entry: e } }
    ReadSetUnestablished { cause: c } => FastLaneFullRun { cause: FastLaneReadSetUnestablished { cause: c } }
  }
}

// THE DECISION. Reuse only when a unit was restored, it is complete and well formed, the decision's own
// modules are placed, every receipt line is readable, git answered the diff, and no changed path is covered
// by a declared input (fixed or implementation) or a recorded file, probe or directory. The order is the
// emitted script's order.
fn fast_lane_decide(unit: FastLaneUnitObservation, changes: ReadSetChangeObservation) -> FastLaneVerdict {
  match unit {
    FastLaneUnitAbsent => FastLaneFullRun { cause: FastLaneNoUnitRestored }
    FastLaneUnitRestored { receipt_lines: receipt, binary_executable: executable, identity_text: identity } =>
      if length(xs: receipt) == 0 {
        FastLaneFullRun { cause: FastLaneReceiptEmpty }
      } else if !executable {
        FastLaneFullRun { cause: FastLaneBinaryNotExecutable }
      } else if !fast_lane_identity_is_well_formed(identity_text: identity) {
        FastLaneFullRun { cause: FastLaneIdentityMalformed }
      } else {
        match fast_lane_unplaceable_modules() |> first {
          Present { value: m } => FastLaneFullRun { cause: FastLaneImplementationUnplaceable { module: m } }
          Absent =>
            match read_set_recording_of_lines(lines: receipt) {
              ReadSetRecordingUnreadable { line: l } =>
                FastLaneFullRun { cause: FastLaneReadSetUnestablished { cause: ReadSetRecordingLineUnreadable { line: l } } }
              ReadSetRecordingRead { entries: recorded } =>
                fast_lane_verdict_of_validity(validity: validate_read_set(entries: list_append(left: fast_lane_declared_entries(), right: recorded), changes: changes))
            }
        }
      }
  }
}

data fast_lane_restore_id_prefix: String = "fast_lane_unit_"
data fast_lane_decision_step_name: String = "Decide whether the fast-lane unit covers this change"
data fast_lane_layout_check_step_name: String = "Check the layout with the restored native CLI (fast lane)"
data fast_lane_reference_check_step_name: String = "Check marked references with the restored native CLI (fast lane)"
data fast_lane_decision_unemittable_marker: String = "__GUNBC_FAST_LANE_DECISION_UNEMITTABLE__"
data fast_lane_ancestor_env: String = "FAST_LANE_ANCESTOR"
// ONE STRUCTURED CLASSIFICATION LINE per pull-request decision, so the reuse rate is countable from logs
// without re-deriving it (grep key: a timestamped line starting `fast lane: classify -- <category>`).
// Every category except `reuse` is a full run; a full run is never skipped. `full_stale_unit` names the
// CORRECT decline of a unit older than a compiler-input change main gained after the located ancestor --
// the remedy is a NEWER unit arriving sooner (save-after-native-cli, wider lookback, wait-for-base), never
// loosening this decision; the name is chosen so nobody later reads the stale decline as a decision bug.
// `full_indeterminate` is the fail-safe: the PR's own diff could not be computed to split own vs stale.
data fast_lane_class_prefix: String = "fast lane: classify -- "
data fast_lane_class_reuse: String = "reuse"
data fast_lane_class_miss_none: String = "miss_none"
data fast_lane_class_integrity: String = "full_integrity"
data fast_lane_class_full_own: String = "full_own"
data fast_lane_class_full_stale_unit: String = "full_stale_unit"
data fast_lane_class_full_indeterminate: String = "full_indeterminate"

// AFTER-WAIT NAMING (node adhoc-66aa884a-406, manager condition 3). When the wait step below waited for an
// in-flight main run and that run SAVED, the decision's category gains a suffix so the net effect of
// waiting is countable: a reuse that only exists because of the wait prints `reuse_after_wait`, and a full
// decline after a productive wait prints `full_after_wait|<reason>` -- the reason is the plain category, so
// every line still resolves to one of the six buckets above.
data fast_lane_class_reuse_after_wait: String = "reuse_after_wait"
data fast_lane_class_full_after_wait: String = "full_after_wait|"

// THE WAIT STEP'S MARKER. The wait step writes one word into it -- hit | timeout | too-far | failed | none |
// skipped-own-input | skipped-no-diff | no-jq | api-error | error -- and the decision step reads it back to
// name after-wait outcomes. Absent marker (main push, or the wait step skipped early) means "no wait".
// THE WAIT STEP READS THE EVENT BASE SHA TO ASK THE API WHICH MAIN RUN IS IN FLIGHT FOR THIS BASE.
// THE DECISION ITSELF NEVER READS IT (its pr-own set comes from the fork point, #16580).
data fast_lane_wait_marker_env: String = "GUNBC_FL_WAITED"
data fast_lane_wait_marker_basename: String = "gunbc-fl-waited.txt"
data fast_lane_wait_hit_word: String = "hit"

// THE WAIT BUDGET, measured 2026-11-16. The median completed main witnesses run is 51.3 minutes (97 runs
// sampled); FL_TYPICAL rounds that up to 55 minutes, so the estimate `created + FL_TYPICAL - now` is
// conservative: a run the model calls "within cap" is usually closer than the estimate says. THE CAP IS
// 0 -- THE WAIT IS DORMANT. Per DESIGN (operator bans any increase to a CI time budget without explicit
// sign-off) and review 95821, the wait may not run until a `gunbc.design_ruling` row records the
// operator's EXPLICIT approval of this occupancy increase (escalation msg_926f150f; a default-decided
// escalation is not sign-off). With cap 0 the step prints `wait -- disabled` and exits before any API
// call: zero added wall time, identical behavior to before this PR. Enabling = flip the cap to
// second(count: 720) in the same change that adds the ruling row. The manager ruled the 12-minute cap
// with four conditions (all implemented); the 90-minute job timeout is UNCHANGED either way, and a full
// run (~41-50) plus a worst-case wait (12, hard-deadlined) fits.
data fast_lane_wait_cap_secs: Second = second(count: 0)
data fast_lane_wait_typical_secs: Second = second(count: 3300)
data fast_lane_wait_poll_secs: Second = second(count: 30)
data fast_lane_wait_poll_steps: Int = 24

// Transport-boundary rendering: the poll script and its env consume decimal text; the model keeps
// durations in std.measure::Second and the poll count in Int (std.measure::second_count unwraps).
fn fast_lane_wait_secs_text(s: Second) -> String {
  int_to_decimal_string(value: second_count(s: s) as Int)
}

fn fast_lane_wait_poll_steps_text() -> String {
  int_to_decimal_string(value: fast_lane_wait_poll_steps)
}
data fast_lane_wait_step_name: String = "Wait for the base commit's fast-lane unit"

// THE WINDOW IS THE RESTORE WINDOW, one source of truth: the same ordinals the restore steps generate from.
fn fast_lane_wait_window_str() -> String {
  int_to_decimal_string(value: length(xs: parse_verdict_restore_ancestor_ordinals))
}


fn fast_lane_restore_step_name(ordinal: Int) -> String {
  join(["Restore fast-lane unit for base ancestor ", int_to_decimal_string(value: ordinal)], "")
}

fn fast_lane_restore_key(ordinal: Int) -> String {
  fast_lane_unit_cache_key(commit: parse_verdict_ancestor_sha_expr(ordinal: ordinal))
}

fn fast_lane_restore_step(ordinal: Int) -> Step {
  parse_verdict_cache_restore_step(
    name: fast_lane_restore_step_name(ordinal: ordinal),
    id: Present { value: materialization_restore_step_id(id_prefix: fast_lane_restore_id_prefix, ordinal: ordinal) },
    path: fast_lane_unit_path(),
    cache_key: fast_lane_restore_key(ordinal: ordinal),
    condition: materialization_restore_chain_condition(id_prefix: fast_lane_restore_id_prefix, ordinal: ordinal)
  )
}

fn fast_lane_restore_steps() -> List<Step> {
  list_map(xs: parse_verdict_restore_ancestor_ordinals, f: fn(o) { fast_lane_restore_step(ordinal: o) })
}

fn fast_lane_restored_ancestor_template() -> String {
  serialize_template(template: ExpressionTemplate {
    segments: [Interpolation { expression: materialization_restored_ancestor_expression(id_prefix: fast_lane_restore_id_prefix) }]
  })
}

// THE RECEIPT GRAMMAR AS EXTENDED REGULAR EXPRESSIONS, rendered from the kinds in v2.std.read_set. A
// readable line starts with a kind, the separator and a character that is not `/`; an abnormal path has a
// `.` or `..` segment, a doubled slash or a trailing slash (fast_lane_receipt_path_is_normal).
fn fast_lane_receipt_kind_alternation() -> String {
  join(["(", join(concat(read_set_exact_kinds, [read_set_kind_dir]), "|"), ")"], "")
}

fn fast_lane_receipt_readable_regex() -> String {
  join(["^", fast_lane_receipt_kind_alternation(), read_set_kind_separator, "[^/]"], "")
}

fn fast_lane_receipt_abnormal_regex() -> String {
  join(["^", fast_lane_receipt_kind_alternation(), read_set_kind_separator, "\\.\\.?(/|$)|/\\.\\.?(/|$)|//|/$"], "")
}

fn fast_lane_receipt_exact_sed() -> String {
  join(["s/^(", join(read_set_exact_kinds, "|"), ")", read_set_kind_separator, "//p"], "")
}

fn fast_lane_receipt_dir_sed() -> String {
  join(["s/^", read_set_kind_dir, read_set_kind_separator, "(.*)$/\\1\\//p"], "")
}

fn fast_lane_identity_regex() -> String {
  join(["[0-9a-f]{", int_to_decimal_string(value: sha256_hex_digit_count), "}"], "")
}

fn fl_lit(t: String) -> Node { bash_build_word_lit(text: t) }
fn fl_var(n: String) -> Node { bash_build_word_var(name: n) }
fn fl_cmd(ws: List<Node>) -> Node { bash_build_command_with_words(words: ws) }
fn fl_test(ws: List<Node>) -> Node { bash_build_test_bracket(words: ws, spelling: BracketQuoted) }

fn fl_scratch(basename: String) -> Node {
  bash_build_word_concat_from_nodes(parts: [fl_var(n: "RUNNER_TEMP"), fl_lit(t: join(["/gunbc-fast-lane-", basename], ""))])
}

fn fl_output(name: String, value: Node) -> Node {
  parse_verdict_tee_append(
    line: bash_build_word_concat_from_nodes(parts: [fl_lit(t: join([name, "="], "")), value]),
    path: fl_var(n: "GITHUB_OUTPUT")
  )
}

fn fl_say(text: String) -> Node { fl_cmd(ws: [fl_lit(t: "echo"), fl_lit(t: join(["fast lane: ", text], ""))]) }

// THE STRUCTURED CLASSIFICATION LINE, emitted once per decision right before the skip output, so the reuse
// rate is countable from the run log without re-deriving the bucket. It never changes the skip decision.
fn fl_classify(category: String) -> Node {
  fl_cmd(ws: [fl_lit(t: "echo"), fl_lit(t: join([fast_lane_class_prefix, category], ""))])
}

// THE SAME LINE, after-wait aware. `WAITRES` is read once at the top of the decision script from the wait
// marker. A wait that produced the unit renames the outcome so the wait's conversions are countable
// separately from plain hits; anything else prints the plain category. Declines use this form; the reuse
// path uses fl_classify_reuse_after.
fn fl_classify_after(category: String) -> Node {
  bash_build_if_else_from_stmts(
    cond: fl_test(ws: [fl_var(n: "WAITRES"), fl_lit(t: "="), fl_lit(t: fast_lane_wait_hit_word)]),
    then_stmts: [fl_cmd(ws: [fl_lit(t: "echo"), fl_lit(t: join([fast_lane_class_prefix, fast_lane_class_full_after_wait, category], ""))])],
    else_stmts: [fl_classify(category: category)]
  )
}

fn fl_classify_reuse_after() -> Node {
  bash_build_if_else_from_stmts(
    cond: fl_test(ws: [fl_var(n: "WAITRES"), fl_lit(t: "="), fl_lit(t: fast_lane_wait_hit_word)]),
    then_stmts: [fl_cmd(ws: [fl_lit(t: "echo"), fl_lit(t: join([fast_lane_class_prefix, fast_lane_class_reuse_after_wait], ""))])],
    else_stmts: [fl_classify(category: fast_lane_class_reuse)]
  )
}

// THE WAIT STEP, PR-only (node adhoc-66aa884a-406; manager conditions 1-3). Its whole case for existing:
// a unit for a fresh merge appears ~40 minutes after the merge (the main run must build the seed, both
// emitted products and walk before it can save), and a pull request based on that merge paid the full lane
// whenever it opened before the save. The step finds the main-push witnesses run whose head is one of the
// PR base's first-parent ancestors inside the restore window; if that run is IN FLIGHT and its estimated
// remaining time is within the wait cap (today 0: the step is dormant; see the dissolution row below), it polls until the run concludes, and the restore steps that
// follow then find the unit the run saves. Conditions it must honor, from the manager: it NEVER waits when
// the estimate already exceeds the cap (that is a straight full build), it stops the moment the run
// concludes non-success or cancelled, and the decision labels what the wait produced.
// SCAFFOLD (design_argument how_to_work): the poll loop is now built from bash_build Nodes (every
// statement the compiler checks; the medium-as-string raw sh -c retired 2026-11-17), but the wait is
// still a scaffold in TIME: data fast_lane_wait_cap_secs is 0, so today every PR run says disabled and
// the decision walks the full path. Marked on-carrier: see fast_lane_wait_script_dissolution_trigger --
// the row is READ (dissolution_description renders it into the wait step's FL_DISSOLVE env, printed in
// the run log while the wait is dormant), not dangling; it dissolves when the operator grants a
// positive wait cap (wait-occupancy ruling, manager message msg_b196bf0f).
data fast_lane_wait_script_dissolution_trigger: DissolutionCondition = unbound_dissolution(description: "🟡 dissolve-on: the wait step is a SCAFFOLD -- the poll loop is now built from bash_build Nodes (the raw sh -c string retired 2026-11-17), but data fast_lane_wait_cap_secs is 0, so on every PR the step says disabled and the decision walks the full path. DISSOLVES WHEN the operator grants a positive wait cap (the wait-occupancy ruling, manager message msg_b196bf0f): until then the loop body below the disabled guard is inert scaffolding and the step must not be relied on to produce hit markers.")

//
// FAIL CLOSED IN EVERY DIRECTION: every statement is a bash_build Node emitted with `set +e`
// semantics, and every error path funnels through `fl_done`, which writes the marker word and exits 0
// -- nothing the step does can fail the job, and a step that cannot be emitted at all renders the
// unemittable marker and fails the run BEFORE any reuse decision (fl_wait_script). It touches none of
// the decision's checks, and it only ever ADDS time -- a wait that mislabels can delay a full run,
// never skip one. The static-input skip guard is deliberately one-sided: if the PR's OWN diff matches a
// declared fixed input or decision-implementation module the full run is certain anyway, so waiting cannot
// help and the step skips; the read-set half of the decision's membership is unknown this early, and a
// wrong "no input touched, wait anyway" only costs at most the cap. jq and curl absence, API errors and
// empty listings all exit 0 like everything else.
// THE WAIT STEP, as bash_build Nodes. The poll loop is a self-recursive modeled
// function (`fl_poll`) bounded by a line-count file (`POLL=$(grep -c . CNT)`
// against `FL_STEPS`) and a deadline (`DEADLINE=$(expr $(date +%s) + FL_CAP)`),
// and the state dispatch is an if-chain over `test` -- no raw `sh -c` string,
// no unmodeled loop/case/arith grammar: every statement here is a Node the
// compiler checks, so `bash_emit_stmts` validates the real text (review 95948).
// Semantics are unchanged from the retired raw script: same say-words (the
// marker contract at THE WAIT STEP'S MARKER above), same bounds, same
// fail-closed posture (every failure path says a word and exits 0; the decision
// step treats any missing marker as a full run). The poll state is re-read
// from a freshly fetched file each iteration (`rm -f` before `curl`), so a
// failed fetch cannot replay a stale answer.
data fast_lane_wait_runs_basename: String = "gunbc-fl-wait-runs.json"
data fast_lane_wait_run_basename: String = "gunbc-fl-wait-run.json"

fn fl_wait_done(word: String) -> Node {
  fl_cmd(ws: [fl_lit(t: "fl_done"), fl_lit(t: word)])
}

fn fl_wait_curl(url: Node) -> Node {
  fl_cmd(ws: [
    fl_lit(t: "curl"), fl_lit(t: "-fsS"), fl_lit(t: "-m"), fl_lit(t: "15"),
    fl_lit(t: "-H"), bash_build_word_concat_from_nodes(parts: [fl_lit(t: "Authorization: Bearer "), fl_var(n: "GITHUB_TOKEN")]),
    fl_lit(t: "-H"), fl_lit(t: "Accept: application/vnd.github+json"),
    url,
  ])
}

fn fl_wait_jq_words(program: String, path: String) -> List<Node> {
  match jq_invocation_process_plan(invocation: JqInvocation {
    program: JqProgram { source: program },
    bindings: Empty,
    input: JqInputFile { path: path },
    output_encoding: JqRawOutput,
    exit_policy: JqLastResultExit,
  }) {
    Accepted { value: p, diagnostics: _ } =>
      concat([fl_lit(t: jq_executable as String)], map(cli_surface_arguments(surface: jq_admitted_plan_surface(plan: p)), a => fl_lit(t: cli_argument_text(argument: a))))
    // A refused plan renders as `false`, which the surrounding guards say
    // `api-error` on -- refusal fails closed, never silently empty.
    Rejected { diagnostics: _ } => [fl_lit(t: "false")]
  }
}

fn fl_wait_jq_extract(program: String, path: String) -> Node {
  bash_build_with_redir(inner: fl_cmd(ws: fl_wait_jq_words(program: program, path: path)), redir: ^bash_production_fold_redir_stderr_null)
}

fn fl_wait_suppressed(command: Node) -> Node {
  bash_build_with_redir(inner: command, redir: ^bash_production_fold_redir_stderr_null)
}

fn fl_wait_script_statements() -> Optional<List<Node>> {
  let input_pattern = join(read_set_exact_paths(entries: fast_lane_declared_entries()), "|")
  let impl_pattern = join(read_set_dir_prefixes(entries: fast_lane_declared_entries()), "|")
  let own = fl_scratch(basename: "own.txt")
  let anc = fl_scratch(basename: "anc.txt")
  let idsha = fl_scratch(basename: "idsha.txt")
  let matched = fl_scratch(basename: "match.txt")
  let counter = fl_scratch(basename: "poll.txt")
  let runs = fl_lit(t: fast_lane_wait_runs_basename)
  let runf = fl_lit(t: fast_lane_wait_run_basename)
  let url_runs = bash_build_word_concat_from_nodes(parts: [
    fl_lit(t: "https://api.github.com/repos/"), fl_var(n: "GUNBC_REPO"),
    fl_lit(t: "/actions/workflows/"), fl_var(n: "WF"),
    fl_lit(t: "/runs?event=push&branch=main&status=in_progress&per_page=20"),
  ])
  let url_run = bash_build_word_concat_from_nodes(parts: [
    fl_lit(t: "https://api.github.com/repos/"), fl_var(n: "GUNBC_REPO"),
    fl_lit(t: "/actions/runs/"), fl_var(n: "RID"),
  ])
  let done_def = bash_build_function_def(name: "fl_done", body: [
    fl_cmd(ws: [fl_lit(t: "echo"), fl_lit(t: "fast lane: wait --"), fl_var(n: "1")]),
    bash_build_with_redir_to_file(inner: fl_cmd(ws: [fl_lit(t: "echo"), fl_var(n: "1")]), path: fl_var(n: "MARK")),
    fl_cmd(ws: [fl_lit(t: "rm"), fl_lit(t: "-f"), runs, runf]),
    bash_build_exit(code: "0"),
  ])
  let poll_def = bash_build_function_def(name: "fl_poll", body: [
    fl_cmd(ws: [fl_lit(t: "sleep"), fl_lit(t: fast_lane_wait_secs_text(fast_lane_wait_poll_secs))]),
    bash_build_if_from_stmts(
      cond: fl_test(ws: [bash_build_word_cmdsubst(body: fl_cmd(ws: [fl_lit(t: "date"), fl_lit(t: "+%s")])), fl_lit(t: "-gt"), fl_var(n: "DEADLINE")]),
      then_stmts: [fl_wait_done(word: "timeout")]
    ),
    fl_cmd(ws: [fl_lit(t: "rm"), fl_lit(t: "-f"), runf]),
    fl_wait_suppressed(command: fl_wait_curl(url: url_run)),
    bash_build_assign(name: "ST_S", value: bash_build_word_cmdsubst(body: fl_wait_jq_extract(program: ".status", path: fast_lane_wait_run_basename))),
    bash_build_assign(name: "ST_C", value: bash_build_word_cmdsubst(body: fl_wait_jq_extract(program: ".conclusion // \"\"", path: fast_lane_wait_run_basename))),
    bash_build_if_from_stmts(
      cond: fl_test(ws: [fl_lit(t: "-n"), fl_var(n: "ST_S"), fl_lit(t: "-a"), fl_var(n: "ST_S"), fl_lit(t: "="), fl_lit(t: "completed"), fl_lit(t: "-a"), fl_var(n: "ST_C"), fl_lit(t: "="), fl_lit(t: "success")]),
      then_stmts: [fl_wait_done(word: "hit")]
    ),
    bash_build_if_from_stmts(
      cond: fl_test(ws: [fl_var(n: "ST_S"), fl_lit(t: "="), fl_lit(t: "completed")]),
      then_stmts: [fl_wait_done(word: "failed")]
    ),
    bash_build_with_redir_stdout_append_file(inner: fl_cmd(ws: [fl_lit(t: "echo"), fl_lit(t: "poll")]), path: counter),
    bash_build_assign(name: "POLL", value: bash_build_word_cmdsubst(body: fl_cmd(ws: [fl_lit(t: "grep"), fl_lit(t: "-c"), fl_lit(t: "."), counter]))),
    bash_build_if_from_stmts(
      cond: fl_test(ws: [fl_var(n: "POLL"), fl_lit(t: "-ge"), fl_var(n: "FL_STEPS")]),
      then_stmts: [fl_wait_done(word: "timeout")]
    ),
    fl_cmd(ws: [fl_lit(t: "fl_poll")]),
  ])
  match done_def {
    Absent => Absent
    Present { value: dd } => match poll_def {
      Absent => Absent
      Present { value: pd } => Present { value: [
        fl_cmd(ws: [fl_lit(t: "rm"), fl_lit(t: "-f"), fl_var(n: "MARK"), own, anc, idsha, matched, counter, runs, runf]),
        bash_build_assign_lit(name: "API", text: "https://api.github.com"),
        bash_build_assign_lit(name: "WF", text: "witnesses.yml"),
        bash_build_assign(name: "ANCHOR", value: bash_build_word_cmdsubst(body: bash_build_or_else(
          left: fl_wait_suppressed(command: fl_cmd(ws: [fl_lit(t: "git"), fl_lit(t: "rev-parse"), fl_lit(t: "--verify"), fl_lit(t: "-q"), fl_lit(t: "HEAD^1")])),
          right: fl_cmd(ws: [fl_lit(t: "echo")])
        ))),
        dd,
        bash_build_if_from_stmts(
          cond: fl_test(ws: [fl_var(n: "FL_CAP"), fl_lit(t: "-le"), fl_lit(t: "0")]),
          then_stmts: [
            fl_cmd(ws: [fl_lit(t: "echo"), fl_lit(t: "fast lane: dissolve:"), fl_var(n: "FL_DISSOLVE")]),
            fl_wait_done(word: "disabled"),
          ]
        ),
        fl_cmd(ws: [
          fl_lit(t: "echo"), fl_lit(t: "fast lane: anchor"), fl_var(n: "ANCHOR"),
          fl_lit(t: "head"), fl_lit(t: "${{ github.event.pull_request.head.sha }}"),
          fl_lit(t: "HEAD^1"), bash_build_word_cmdsubst(body: fl_wait_suppressed(command: fl_cmd(ws: [fl_lit(t: "git"), fl_lit(t: "rev-parse"), fl_lit(t: "HEAD^1")]))),
          fl_lit(t: "HEAD^2"), bash_build_word_cmdsubst(body: fl_wait_suppressed(command: fl_cmd(ws: [fl_lit(t: "git"), fl_lit(t: "rev-parse"), fl_lit(t: "HEAD^2")]))),
        ]),
        bash_build_if_from_stmts(
          cond: fl_test(ws: [fl_lit(t: "-z"), fl_var(n: "ANCHOR")]),
          then_stmts: [fl_wait_done(word: "none")]
        ),
        bash_build_with_redir_to_file(
          inner: fl_wait_suppressed(command: fl_cmd(ws: [fl_lit(t: "git"), fl_lit(t: "diff"), fl_lit(t: "--name-only"), fl_lit(t: "--no-renames"), bash_build_word_concat_from_nodes(parts: [fl_var(n: "ANCHOR"), fl_lit(t: "...HEAD")])])),
          path: own
        ),
        bash_build_if_from_stmts(
          cond: fl_test(ws: [fl_lit(t: "!"), fl_lit(t: "-s"), own]),
          then_stmts: [fl_wait_done(word: "skipped-no-diff")]
        ),
        bash_build_and_then(
          left: fl_wait_suppressed(command: fl_cmd(ws: [fl_lit(t: "grep"), fl_lit(t: "-qE"), fl_lit(t: join([input_pattern, "|", impl_pattern], "")), own])),
          right: fl_wait_done(word: "skipped-own-input")
        ),
        bash_build_or_else(
          left: fl_wait_suppressed(command: fl_cmd(ws: [fl_lit(t: "command"), fl_lit(t: "-v"), fl_lit(t: "jq")])),
          right: fl_wait_done(word: "no-jq")
        ),
        bash_build_or_else(
          left: bash_build_with_redir_to_file(inner: fl_wait_suppressed(command: fl_wait_curl(url: url_runs)), path: runs),
          right: fl_wait_done(word: "api-error")
        ),
        bash_build_or_else(
          left: bash_build_with_redir_to_file(
            inner: fl_cmd(ws: fl_wait_jq_words(program: ".workflow_runs[] | \"\\(.id) \\(.head_sha) \\(.created_at)\"", path: fast_lane_wait_runs_basename)),
            path: idsha
          ),
          right: fl_wait_done(word: "api-error")
        ),
        bash_build_with_redir_to_file(
          inner: fl_wait_suppressed(command: fl_cmd(ws: [fl_lit(t: "git"), fl_lit(t: "rev-list"), fl_lit(t: "--first-parent"), fl_lit(t: "-n"), fl_var(n: "FL_WINDOW"), fl_var(n: "ANCHOR")])),
          path: anc
        ),
        bash_build_with_redir_to_file(
          inner: bash_build_pipe(
            left: fl_wait_suppressed(command: fl_cmd(ws: [fl_lit(t: "grep"), fl_lit(t: "-F"), fl_lit(t: "-f"), anc, idsha])),
            right: fl_cmd(ws: [fl_lit(t: "head"), fl_lit(t: "-n"), fl_lit(t: "1")])
          ),
          path: matched
        ),
        bash_build_if_from_stmts(
          cond: fl_test(ws: [fl_lit(t: "!"), fl_lit(t: "-s"), matched]),
          then_stmts: [fl_wait_done(word: "none")]
        ),
        bash_build_assign(name: "RID", value: bash_build_word_cmdsubst(body: fl_cmd(ws: [fl_lit(t: "cut"), fl_lit(t: "-d "), fl_lit(t: "-f1"), matched]))),
        bash_build_assign(name: "CREATED", value: bash_build_word_cmdsubst(body: fl_cmd(ws: [fl_lit(t: "cut"), fl_lit(t: "-d "), fl_lit(t: "-f3"), matched]))),
        bash_build_assign(name: "CREATED_E", value: bash_build_word_cmdsubst(body: bash_build_or_else(
          left: fl_wait_suppressed(command: fl_cmd(ws: [fl_lit(t: "date"), fl_lit(t: "-d"), fl_var(n: "CREATED"), fl_lit(t: "+%s")])),
          right: fl_cmd(ws: [fl_lit(t: "echo"), fl_lit(t: "0")])
        ))),
        bash_build_assign(name: "NOW", value: bash_build_word_cmdsubst(body: fl_cmd(ws: [fl_lit(t: "date"), fl_lit(t: "+%s")]))),
        bash_build_assign(name: "EST", value: bash_build_word_cmdsubst(body: fl_cmd(ws: [fl_lit(t: "expr"), fl_var(n: "CREATED_E"), fl_lit(t: "+"), fl_var(n: "FL_TYPICAL"), fl_lit(t: "-"), fl_var(n: "NOW")]))),
        bash_build_if_from_stmts(
          cond: fl_test(ws: [fl_var(n: "EST"), fl_lit(t: "-le"), fl_lit(t: "0")]),
          then_stmts: [fl_wait_done(word: "too-far")]
        ),
        bash_build_if_from_stmts(
          cond: fl_test(ws: [fl_var(n: "EST"), fl_lit(t: "-gt"), fl_var(n: "FL_CAP")]),
          then_stmts: [fl_wait_done(word: "too-far")]
        ),
        bash_build_assign(name: "DEADLINE", value: bash_build_word_cmdsubst(body: fl_cmd(ws: [fl_lit(t: "expr"), bash_build_word_cmdsubst(body: fl_cmd(ws: [fl_lit(t: "date"), fl_lit(t: "+%s")])), fl_lit(t: "+"), fl_var(n: "FL_CAP")]))),
        pd,
        fl_cmd(ws: [fl_lit(t: "fl_poll")]),
        fl_wait_done(word: "timeout"),
      ] }
    }
  }
}

fn fl_wait_script_outcome() -> Optional<String> {
  match fl_wait_script_statements() {
    Absent => Absent
    Present { value: stmts } => match bash_emit_stmts(statements: stmts, set_e: false) {
      Accepted { value: v, diagnostics: _ } => Present { value: v }
      Rejected { diagnostics: _ } => Absent
    }
  }
}

// The wait step is fail-closed exactly like the decision step: an unrenderable poll script emits the
// unemittable marker, the step fails before any reuse decision is made, `skip` is never written, and
// every guarded step runs -- a broken wait is a full run, never a skipped one.
fn fl_wait_script() -> String {
  match fl_wait_script_outcome() {
    Present { value: v } => v
    Absent => fast_lane_decision_unemittable_marker
  }
}

fn fl_wait_step() -> Step {
  RunStep {
    name: Present { value: fast_lane_wait_step_name },
    id: none,
    run: fl_wait_script(),
    shell: none,
    env: Present { value: [
      kv(key: "MARK", value: yaml_string(s: join(["${{ runner.temp }}/", fast_lane_wait_marker_basename], ""))),
      kv(key: "GITHUB_TOKEN", value: yaml_string(s: "${{ github.token }}")),
      kv(key: "GUNBC_REPO", value: yaml_string(s: "${{ github.repository }}")),
      kv(key: "FL_WINDOW", value: yaml_string(s: fast_lane_wait_window_str())),
      kv(key: "FL_CAP", value: yaml_string(s: fast_lane_wait_secs_text(fast_lane_wait_cap_secs))),
      kv(key: "FL_TYPICAL", value: yaml_string(s: fast_lane_wait_secs_text(fast_lane_wait_typical_secs))),
      kv(key: "FL_STEPS", value: yaml_string(s: fast_lane_wait_poll_steps_text())),
      kv(key: "FL_DISSOLVE", value: yaml_string(s: dissolution_description(condition: fast_lane_wait_script_dissolution_trigger)))
    ] },
    working_directory: none,
    if_condition: Present { value: "github.event_name == 'pull_request'" },
    continue_on_error: none,
    timeout_minutes: none
  }
}

fn fl_decline(reason: String, category: String) -> List<Node> {
  [
    fl_say(text: join(["full run -- ", reason], "")),
    fl_classify_after(category: category),
    fl_output(name: fast_lane_skip_output, value: fl_lit(t: fast_lane_skip_false)),
    bash_build_exit(code: "0")
  ]
}

fn fl_decline_when(cond: Node, reason: String, category: String) -> Node {
  bash_build_if_from_stmts(cond: cond, then_stmts: fl_decline(reason: reason, category: category))
}

fn fl_decline_listing(cond: Node, reason: String, listing: Node, category: String) -> Node {
  bash_build_if_from_stmts(
    cond: cond,
    then_stmts: [
      fl_say(text: join(["full run -- ", reason], "")),
      fl_cmd(ws: [fl_lit(t: "cat"), listing]),
      fl_classify_after(category: category),
      fl_output(name: fast_lane_skip_output, value: fl_lit(t: fast_lane_skip_false)),
      bash_build_exit(code: "0")
    ]
  )
}

// THE PR-OWN DIFF, computed only to split an input-hit decline into full_own vs full_stale_unit. It is a
// labeling aid and nothing else, so it is strictly non-fatal: `pr-own.ok` is written only when `git diff`
// answered, and a failure to compute it leaves the marker absent so the decline labels `full_indeterminate`
// rather than guessing. It must never be able to turn a reuse into a full run, so it sits on a `|| true`.
//
// THE FORK POINT, NOT THE EVENT BASE. A pull_request run judges the merge ref (HEAD is main merged into the
// branch), and the event's base.sha is the base branch tip from when the PR was OPENED -- it goes stale as
// main advances. `BASE_SHA...HEAD` against that stale sha therefore diffs main's own commits in, and a
// stale-unit decline on a plan-only PR that merely predates main churn gets labeled `full_own` (run 43826192352
// of PR 16574, a roadmap-only change, was labeled full_own for dag/gunbc/parse_verdict_schema.dag -- a commit
// main gained after the PR opened). The honest own-set is what the branch contributed over its fork point:
// `git merge-base HEAD origin/main` to HEAD, where origin/main is the freshly fetched base branch. If git
// cannot answer, or answers with no fork point, the marker stays absent and the label is `full_indeterminate`.
fn fl_compute_pr_own(pr_own: Node, pr_own_ok: Node) -> Node {
  bash_build_or_else(
    left: bash_build_and_then(
      left: bash_build_and_then(
        left: bash_build_assign(
          name: "FAST_LANE_FORK",
          value: bash_build_word_cmdsubst(body: fl_cmd(ws: [
            fl_lit(t: "git"), fl_lit(t: "merge-base"), fl_lit(t: "HEAD"), fl_lit(t: "origin/main")
          ]))
        ),
        right: fl_cmd(ws: [fl_lit(t: "test"), fl_lit(t: "-n"), fl_var(n: "FAST_LANE_FORK")])
      ),
      right: bash_build_and_then(
        left: bash_build_with_redir_to_file(
          inner: fl_cmd(
            ws: [
              fl_lit(t: "git"), fl_lit(t: "diff"), fl_lit(t: "--name-only"), fl_lit(t: "--no-renames"),
              fl_var(n: "FAST_LANE_FORK"), fl_lit(t: "HEAD")
            ]
          ),
          path: pr_own
        ),
        right: bash_build_with_redir_to_file(inner: fl_cmd(ws: [fl_lit(t: "echo"), fl_lit(t: "ok")]), path: pr_own_ok)
      )
    ),
    right: fl_cmd(ws: [fl_lit(t: ":")])
  )
}

// THE CLASSIFICATION OF AN INPUT-HIT DECLINE. If the PR itself changed one of the offending paths it is
// `full_own` (the decision is doing its job for the right reason); otherwise the offending path came only
// from main commits after the located ancestor, so the restored unit is stale -- `full_stale_unit`, whose
// remedy is a newer unit arriving sooner, not a looser decision. If the PR-own set was unavailable, the
// label is `full_indeterminate` (still a full run).
fn fl_classify_input_hit(listing: Node, pr_own: Node, pr_own_ok: Node) -> Node {
  bash_build_if_else_from_stmts(
    cond: fl_test(ws: [fl_lit(t: "-s"), pr_own_ok]),
    then_stmts: [
      bash_build_if_else_from_stmts(
        cond: fl_cmd(ws: [fl_lit(t: "grep"), fl_lit(t: "-Fxq"), fl_lit(t: "-f"), pr_own, listing]),
        then_stmts: [ fl_classify_after(category: fast_lane_class_full_own) ],
        else_stmts: [ fl_classify_after(category: fast_lane_class_full_stale_unit) ]
      )
    ],
    else_stmts: [ fl_classify_after(category: fast_lane_class_full_indeterminate) ]
  )
}

fn fl_decline_input_hit(cond: Node, reason: String, listing: Node, pr_own: Node, pr_own_ok: Node) -> Node {
  bash_build_if_from_stmts(
    cond: cond,
    then_stmts: [
      fl_say(text: join(["full run -- ", reason], "")),
      fl_cmd(ws: [fl_lit(t: "cat"), listing]),
      fl_classify_input_hit(listing: listing, pr_own: pr_own, pr_own_ok: pr_own_ok),
      fl_output(name: fast_lane_skip_output, value: fl_lit(t: fast_lane_skip_false)),
      bash_build_exit(code: "0")
    ]
  )
}


// A grep whose "no line selected" (status 1) is an answer and whose error (status 2) is not: the selected
// lines go to `out`, and only an error fails the statement, which under `bash -e` ends the step before it can
// write skip=true.
fn fl_grep_into(words: List<Node>, out: Node) -> Node {
  bash_build_or_else(
    left: bash_build_with_redir_to_file(inner: fl_cmd(ws: words), path: out),
    right: fl_test(ws: [bash_build_word_exit_status(), fl_lit(t: "="), fl_lit(t: "1")])
  )
}

fn fl_append_lines(lines: List<String>, file: Node) -> Node {
  bash_build_with_redir_to_file(
    inner: bash_build_pipe(
      left: fl_cmd(ws: concat([fl_lit(t: "printf"), fl_lit(t: "%s\\n")], list_map(xs: lines, f: fn(l) { fl_lit(t: l) }))),
      right: fl_cmd(ws: [fl_lit(t: "tee"), fl_lit(t: "-a"), file])
    ),
    path: fl_lit(t: "/dev/null")
  )
}

fn fast_lane_decision_statements() -> List<Node> {
  let receipt = fl_lit(t: read_set_receipt_basename)
  let identity = fl_lit(t: fast_lane_compiler_identity_basename)
  let changed_z = fl_scratch(basename: "changed.z")
  let changed = fl_scratch(basename: "changed.txt")
  let exact = fl_scratch(basename: "exact.txt")
  let prefixes = fl_scratch(basename: "prefixes.txt")
  let prefix_patterns = fl_scratch(basename: "prefix-patterns.txt")
  let pr_own = fl_scratch(basename: "pr-own.txt")
  let pr_own_ok = fl_scratch(basename: "pr-own.ok")
  [
    bash_build_assign(
      name: "WAITRES",
      value: bash_build_word_cmdsubst(body: bash_build_or_else(
        left: fl_cmd(ws: [fl_lit(t: "cat"), fl_var(n: fast_lane_wait_marker_env), fl_lit(t: "2>/dev/null")]),
        right: fl_cmd(ws: [fl_lit(t: ":")])
      ))
    ),
    fl_decline_when(
      cond: fl_test(ws: [fl_lit(t: "-z"), fl_var(n: fast_lane_ancestor_env)]),
      reason: "no fast-lane unit was restored for any located first-parent ancestor of the base",
      category: fast_lane_class_miss_none
    ),
    fl_decline_when(
      cond: fl_test(ws: [fl_lit(t: "!"), fl_lit(t: "-s"), receipt]),
      reason: "the restored read-set receipt is empty or absent",
      category: fast_lane_class_integrity
    ),
    fl_decline_when(
      cond: fl_test(ws: [fl_lit(t: "!"), fl_lit(t: "-x"), fl_lit(t: fast_lane_native_cli_basename)]),
      reason: "the restored native CLI is not an executable file",
      category: fast_lane_class_integrity
    ),
    fl_decline_when(
      cond: fl_test(ws: [fl_lit(t: "!"), fl_lit(t: "-s"), identity]),
      reason: "the restored compiler identity is empty or absent",
      category: fast_lane_class_integrity
    ),
    bash_build_assign(
      name: "IDENTITY_BYTES",
      value: bash_build_word_cmdsubst(body: bash_build_with_redir_from_file(inner: fl_cmd(ws: [fl_lit(t: "wc"), fl_lit(t: "-c")]), path: identity))
    ),
    bash_build_assign(
      name: "IDENTITY_NEWLINES",
      value: bash_build_word_cmdsubst(body: bash_build_with_redir_from_file(inner: fl_cmd(ws: [fl_lit(t: "wc"), fl_lit(t: "-l")]), path: identity))
    ),
    fl_decline_when(
      cond: fl_test(ws: [fl_var(n: "IDENTITY_BYTES"), fl_lit(t: "!="), fl_lit(t: int_to_decimal_string(value: fast_lane_identity_file_bytes()))]),
      reason: "the restored compiler identity file is not exactly one digest and its newline",
      category: fast_lane_class_integrity
    ),
    fl_decline_when(
      cond: fl_test(ws: [fl_var(n: "IDENTITY_NEWLINES"), fl_lit(t: "!="), fl_lit(t: "1")]),
      reason: "the restored compiler identity file is not exactly one digest and its newline",
      category: fast_lane_class_integrity
    ),
    fl_decline_when(
      cond: bash_build_negation(inner: bash_build_pipe(
        left: fl_cmd(ws: [fl_lit(t: "head"), fl_lit(t: "-c"), fl_lit(t: int_to_decimal_string(value: sha256_hex_digit_count)), identity]),
        right: fl_cmd(ws: [fl_lit(t: "grep"), fl_lit(t: "-Eqx"), fl_lit(t: fast_lane_identity_regex())])
      )),
      reason: "the restored compiler identity is not a lowercase hex sha256 digest",
      category: fast_lane_class_integrity
    ),
    fl_grep_into(words: [fl_lit(t: "grep"), fl_lit(t: "-Ev"), fl_lit(t: fast_lane_receipt_readable_regex()), receipt], out: fl_scratch(basename: "unreadable.txt")),
    fl_decline_listing(
      cond: fl_test(ws: [fl_lit(t: "-s"), fl_scratch(basename: "unreadable.txt")]),
      reason: "these receipt lines have no recorded kind or name an empty or absolute path:",
      listing: fl_scratch(basename: "unreadable.txt"),
      category: fast_lane_class_integrity
    ),
    fl_grep_into(words: [fl_lit(t: "grep"), fl_lit(t: "-E"), fl_lit(t: fast_lane_receipt_abnormal_regex()), receipt], out: fl_scratch(basename: "abnormal.txt")),
    fl_decline_listing(
      cond: fl_test(ws: [fl_lit(t: "-s"), fl_scratch(basename: "abnormal.txt")]),
      reason: "these receipt paths are not normalized (an empty, . or .. segment):",
      listing: fl_scratch(basename: "abnormal.txt"),
      category: fast_lane_class_integrity
    ),
    fl_decline_when(
      cond: bash_build_negation(inner: bash_build_with_redir_to_file(
        inner: fl_cmd(ws: [
          fl_lit(t: "git"), fl_lit(t: "diff"), fl_lit(t: "--name-only"), fl_lit(t: "--no-renames"), fl_lit(t: "-z"),
          fl_var(n: fast_lane_ancestor_env), fl_lit(t: "HEAD")
        ]),
        path: changed_z
      )),
      reason: "git could not diff the restored ancestor against the judged commit",
      category: fast_lane_class_integrity
    ),
    bash_build_with_redir_to_file(
      inner: bash_build_with_redir_from_file(inner: fl_cmd(ws: [fl_lit(t: "tr"), fl_lit(t: "\\0"), fl_lit(t: "\\n")]), path: changed_z),
      path: changed
    ),
    bash_build_with_redir_to_file(
      inner: bash_build_with_redir_from_file(inner: fl_cmd(ws: [fl_lit(t: "tr"), fl_lit(t: "-cd"), fl_lit(t: "\\n")]), path: changed_z),
      path: fl_scratch(basename: "newlines.txt")
    ),
    fl_decline_when(
      cond: fl_test(ws: [fl_lit(t: "-s"), fl_scratch(basename: "newlines.txt")]),
      reason: "a changed path contains a newline, so no line-wise rule can decide it",
      category: fast_lane_class_integrity
    ),
    bash_build_with_redir_to_file(inner: fl_cmd(ws: [fl_lit(t: "sed"), fl_lit(t: "-En"), fl_lit(t: fast_lane_receipt_exact_sed()), receipt]), path: exact),
    fl_append_lines(lines: read_set_exact_paths(entries: fast_lane_declared_entries()), file: exact),
    bash_build_with_redir_to_file(inner: fl_cmd(ws: [fl_lit(t: "sed"), fl_lit(t: "-En"), fl_lit(t: fast_lane_receipt_dir_sed()), receipt]), path: prefixes),
    fl_append_lines(lines: read_set_dir_prefixes(entries: fast_lane_declared_entries()), file: prefixes),
    bash_build_with_redir_to_file(
      inner: fl_cmd(ws: [fl_lit(t: "sed"), fl_lit(t: "-e"), fl_lit(t: "s/[.[\\*^$]/\\\\&/g"), fl_lit(t: "-e"), fl_lit(t: "s/^/^/"), prefixes]),
      path: prefix_patterns
    ),
    fl_cmd(ws: [fl_lit(t: "rm"), fl_lit(t: "-f"), pr_own_ok]),
    fl_compute_pr_own(pr_own: pr_own, pr_own_ok: pr_own_ok),
    fl_grep_into(words: [fl_lit(t: "grep"), fl_lit(t: "-Fx"), fl_lit(t: "-f"), exact, changed], out: fl_scratch(basename: "exact-hits.txt")),
    fl_grep_into(words: [fl_lit(t: "grep"), fl_lit(t: "-f"), prefix_patterns, changed], out: fl_scratch(basename: "prefix-hits.txt")),
    fl_decline_input_hit(
      cond: fl_test(ws: [fl_lit(t: "-s"), fl_scratch(basename: "exact-hits.txt")]),
      reason: "these changed paths are recorded reads, fixed inputs or the decision's own implementation:",
      listing: fl_scratch(basename: "exact-hits.txt"),
      pr_own: pr_own,
      pr_own_ok: pr_own_ok
    ),
    fl_decline_input_hit(
      cond: fl_test(ws: [fl_lit(t: "-s"), fl_scratch(basename: "prefix-hits.txt")]),
      reason: "these changed paths are under a recorded directory or a fixed input prefix:",
      listing: fl_scratch(basename: "prefix-hits.txt"),
      pr_own: pr_own,
      pr_own_ok: pr_own_ok
    ),
    bash_build_assign(name: "IDENTITY", value: bash_build_word_cmdsubst(body: fl_cmd(ws: [fl_lit(t: "cat"), identity]))),
    fl_cmd(ws: [
      fl_lit(t: "echo"),
      bash_build_word_concat_from_nodes(parts: [
        fl_lit(t: "fast lane: reuse -- no path changed since "),
        fl_var(n: fast_lane_ancestor_env),
        fl_lit(t: " is an input of its unit; the closure-dependent steps are skipped and the whole-tree checks run with the native CLI main built at that commit (REUSED, not fresh), compiler identity "),
        fl_var(n: "IDENTITY")
      ])
    ]),
    fl_output(name: fast_lane_compiler_identity_output, value: fl_var(n: "IDENTITY")),
    fl_classify_reuse_after(),
    fl_output(name: fast_lane_skip_output, value: fl_lit(t: fast_lane_skip_true))
  ]
}

fn fast_lane_decision_script_outcome() -> Optional<String> {
  match bash_emit_stmts(statements: fast_lane_decision_statements(), set_e: true) {
    Accepted { value: v, diagnostics: _ } => Present { value: v }
    Rejected { diagnostics: _ } => Absent
  }
}

fn fast_lane_decision_script_is_renderable() -> Bool {
  fast_lane_decision_script_outcome() != Absent
}

// A DECISION MODULE THE LAYOUT CANNOT PLACE REFUSES EMISSION: the marker is not a command, so the step fails,
// `skip` is never written, and every guarded step runs -- the rule's FastLaneImplementationUnplaceable, realized.
fn fast_lane_decision_script() -> String {
  if length(xs: fast_lane_unplaceable_modules()) > 0 {
    fast_lane_decision_unemittable_marker
  } else {
    match fast_lane_decision_script_outcome() {
      Present { value: v } => v
      Absent => fast_lane_decision_unemittable_marker
    }
  }
}

// CONTINUE-ON-ERROR IS THE FAIL-CLOSED ARM, NOT A SOFTENING. `skip=true` is the script's last act; any
// failure before it leaves the output unwritten, and every guarded step runs on `skip != 'true'`, so a
// decision that errors is a full run and the job's verdict comes from the full path. Failing the job
// instead would make a broken shortcut a red pull request that the full path would have judged.
fn fast_lane_decision_step() -> Step {
  RunStep {
    name: Present { value: fast_lane_decision_step_name },
    id: Present { value: fast_lane_decision_step_id },
    run: fast_lane_decision_script(),
    shell: none,
    env: Present { value: [
      kv(key: fast_lane_ancestor_env, value: yaml_string(s: fast_lane_restored_ancestor_template())),
      kv(key: fast_lane_wait_marker_env, value: yaml_string(s: join(["${{ runner.temp }}/", fast_lane_wait_marker_basename], "")))
    ] },
    working_directory: none,
    if_condition: Present { value: parse_verdict_restore_if() },
    continue_on_error: Present { value: true },
    timeout_minutes: none
  }
}

// THE GUARD OF A CLOSURE-DEPENDENT STEP: it runs unless the decision answered skip. A step that already
// carries its own condition is left as it is -- running it on every run is the conservative reading -- and the
// witness asserts every guarded step of the job carries exactly this guard.
fn fast_lane_full_run_expression() -> Expression {
  NotEquals {
    left: ContextAccess { context: Steps, path: [fast_lane_decision_step_id, "outputs", fast_lane_skip_output] },
    right: StringLiteral { value: fast_lane_skip_true }
  }
}

fn fast_lane_full_run_if() -> String { serialize_expression(expression: fast_lane_full_run_expression()) }

fn fast_lane_reused_if() -> String { serialize_expression(expression: native_cli_reused_expression()) }

fn fast_lane_unless_reused(step: Step) -> Step {
  match step {
    RunStep { name: n, id: i, run: r, shell: sh, env: e, working_directory: w, if_condition: c, continue_on_error: co, timeout_minutes: t } =>
      match c {
        Present { value: _ } => step
        Absent => RunStep { name: n, id: i, run: r, shell: sh, env: e, working_directory: w, if_condition: Present { value: fast_lane_full_run_if() }, continue_on_error: co, timeout_minutes: t }
      }
    UsesStep { name: n, id: i, uses: u, with: wi, env: e, if_condition: c, continue_on_error: co, timeout_minutes: t } =>
      match c {
        Present { value: _ } => step
        Absent => UsesStep { name: n, id: i, uses: u, with: wi, env: e, if_condition: Present { value: fast_lane_full_run_if() }, continue_on_error: co, timeout_minutes: t }
      }
  }
}

// THE WHOLE-TREE CHECKS A REUSED RUN STILL OWES, with the restored binary over the pull request's tree: the
// two live-root walks the native CLI's control run carries (v1_compiler.cli_run.native_lane_runner
// walk_population_controls and walk_reference_controls), with the same verbs and roots. The third,
// parse-population over the live roots, is the parse-verdict reuse walk that already runs on every pull
// request (gunbc.parse_verdict_restore parse_verdict_reuse_walk_step), reading the shared native-CLI
// expressions. On a full run these checks are inside the emit step's control run, so these steps do not run.
fn fast_lane_check_command(verb: String) -> String {
  parse_verdict_invocation_command(
    bin: native_cli_bin(),
    verb: verb,
    args: parse_verdict_invocation_source_root_args(roots: v2_native_cli_source_roots())
  )
}

fn fast_lane_check_step(name: String, verb: String) -> Step {
  RunStep {
    name: Present { value: name },
    id: none,
    run: concat(fast_lane_check_command(verb: verb), "\n"),
    shell: none,
    env: Present { value: parse_verdict_publish_memory_env() },
    working_directory: none,
    if_condition: Present { value: fast_lane_reused_if() },
    continue_on_error: none,
    timeout_minutes: none
  }
}

fn fast_lane_layout_check_step() -> Step {
  fast_lane_check_step(name: fast_lane_layout_check_step_name, verb: cli_verb_check_layout)
}

fn fast_lane_reference_check_step() -> Step {
  fast_lane_check_step(name: fast_lane_reference_check_step_name, verb: cli_verb_check_references)
}
