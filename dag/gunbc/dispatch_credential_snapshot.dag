module gunbc.dispatch_credential_snapshot

import std.types { String, NonEmptyStr, FilePath, Bool, List }
import std.algebra { trim }
import std.optional { Present, Absent }
import std.content_hash { Sha256DigestHex, sha256_hex_digest }
import extdeps.filesystem.filesystem_io { Filesystem }
import extdeps.shell
import extdeps.tools.stat { stat_file_type_reading, StatFileTypeRead, StatFileTypeUnanswered, RegularFileKind, SymbolicLinkKind }
import extdeps.access.posix { file_mode_of_octal_text }
import extdeps.cloud.gcp.secret_ref {
  SecretRef,
  secret_ref_selector,
  ExactVersion,
  AliasLatest,
}
import extdeps.cloud.gcp.secret_manager {
  SmResolvedVersionIdentity,
  sm_resolved_version_secret_resource,
  sm_resolved_version_id,
  sm_version_id_is_number,
  SmVersionSecretProjected,
  SmVersionSecretNotAVersionResource,
  SmVersionIdProjected,
  SmVersionIdNotAVersionResource,
}
import gunbc.dispatch_attempt { DispatchAttempt }
import gunbc.host_custody_export_receipt {
  SnapshotCustodyDeclaration,
  HostCustodyExportReceipt,
  host_custody_export_receipt_path,
  host_custody_export_receipt_decode,
  HostCustodyExportReceiptDecoded,
  HostCustodyExportReceiptDecodeRefused,
  HostCustodyExportReceiptDecodeRefusal,
}

type SnapshotExecutor
  = ClaudeFromSnapshot
  | CursorFromSnapshot

type JoinedCustodyGeneration {
  sm_version: SmResolvedVersionIdentity
  content_sha256: Sha256DigestHex
}

type TakenCredentialSnapshot sole_constructor {
  attempt: DispatchAttempt
  executor: SnapshotExecutor
  path: NonEmptyStr
  generation: JoinedCustodyGeneration
}

fn taken_credential_snapshot_path(snapshot: TakenCredentialSnapshot) -> NonEmptyStr {
  snapshot.path
}

fn taken_credential_snapshot_attempt(snapshot: TakenCredentialSnapshot) -> DispatchAttempt {
  snapshot.attempt
}

fn taken_credential_snapshot_executor(snapshot: TakenCredentialSnapshot) -> SnapshotExecutor {
  snapshot.executor
}

fn taken_credential_snapshot_generation(snapshot: TakenCredentialSnapshot) -> JoinedCustodyGeneration {
  snapshot.generation
}

type DispatchSnapshotRefusal
  = SnapshotCustodyUnreadable { path: NonEmptyStr, detail: String }
  | SnapshotCustodyEmpty { path: NonEmptyStr }
  | SnapshotReceiptUnreadable { path: NonEmptyStr, detail: String }
  | SnapshotReceiptMetadataUnobservable { detail: String }
  | SnapshotReceiptNotRegularFile
  | SnapshotReceiptWrongOwner { observed: String, declared: NonEmptyStr }
  | SnapshotReceiptGroupOrOtherWritable
  | SnapshotReceiptDirectoryReaderWritable
  | SnapshotReceiptDirectoryWrongOwner { observed: String, declared: NonEmptyStr }
  | SnapshotReceiptDecodeRefused { cause: HostCustodyExportReceiptDecodeRefusal }
  | SnapshotReceiptDigestMismatch
  | SnapshotReceiptVersionMismatch
  | SnapshotReceiptPlacementMismatch
  | SnapshotReceiptReaderMismatch
  | SnapshotReceiptPublisherMismatch
  | SnapshotReceiptHostMismatch
  | SnapshotWriteFailed { path: NonEmptyStr, detail: String }

type DispatchCredentialSnapshot
  = DispatchSnapshotTaken { snapshot: TakenCredentialSnapshot }
  | DispatchSnapshotRefused { reason: DispatchSnapshotRefusal }

fn dispatch_snapshot_refusal_text(reason: DispatchSnapshotRefusal) -> NonEmptyStr {
  match reason {
    SnapshotCustodyUnreadable { path: p, detail: d } =>
      join(["the credential custody file ", p as String, " is unreadable on this host: ", d], "") as NonEmptyStr
    SnapshotCustodyEmpty { path: p } =>
      join(["the credential custody file ", p as String, " is empty"], "") as NonEmptyStr
    SnapshotReceiptUnreadable { path: p, detail: d } =>
      join(["the custody export receipt ", p as String, " is unreadable: ", d], "") as NonEmptyStr
    SnapshotReceiptMetadataUnobservable { detail: d } =>
      join(["the custody export receipt metadata is unobservable: ", d], "") as NonEmptyStr
    SnapshotReceiptNotRegularFile =>
      "the custody export receipt is not a regular file" as NonEmptyStr
    SnapshotReceiptWrongOwner { observed: o, declared: d } =>
      join(["the custody export receipt owner ", o, " is not the declared publisher ", d as String], "") as NonEmptyStr
    SnapshotReceiptGroupOrOtherWritable =>
      "the custody export receipt is writable by group or other" as NonEmptyStr
    SnapshotReceiptDirectoryReaderWritable =>
      "the custody export receipt directory is writable by the declared reader" as NonEmptyStr
    SnapshotReceiptDirectoryWrongOwner { observed: o, declared: d } =>
      join(["the custody export receipt directory owner ", o, " is not the declared publisher ", d as String], "") as NonEmptyStr
    SnapshotReceiptDecodeRefused { cause: _ } =>
      "the custody export receipt could not be decoded" as NonEmptyStr
    SnapshotReceiptDigestMismatch =>
      "the custody bytes do not match the export receipt digest" as NonEmptyStr
    SnapshotReceiptVersionMismatch =>
      "the export receipt version does not name the declared secret and pinned version" as NonEmptyStr
    SnapshotReceiptPlacementMismatch =>
      "the export receipt placement is not the declared custody path" as NonEmptyStr
    SnapshotReceiptReaderMismatch =>
      "the export receipt reader is not the declared reader" as NonEmptyStr
    SnapshotReceiptPublisherMismatch =>
      "the export receipt publisher is not the declared publisher" as NonEmptyStr
    SnapshotReceiptHostMismatch =>
      "the export receipt host is not the declared custody host" as NonEmptyStr
    SnapshotWriteFailed { path: p, detail: d } =>
      join(["the credential snapshot ", p as String, " could not be written owner-only: ", d], "") as NonEmptyStr
  }
}

type SnapshotPathWalk {
  count: Int
  at: Int
  acc: List<String>
}

fn snapshot_path_dirname(path: String) -> String {
  let parts = split(s: path, delimiter: "/")
  let kept = fold(parts, init: SnapshotPathWalk { count: count(parts), at: 0, acc: [] }, f: (acc, seg) =>
    SnapshotPathWalk {
      count: acc.count,
      at: acc.at + 1,
      acc: if acc.at + 1 < acc.count { concat(acc.acc, [seg]) } else { acc.acc },
    })
  let joined = join(kept.acc, "/")
  if joined == "" {
    "/"
  } else {
    joined
  }
}

fn snapshot_receipt_digest_agrees(buffer: String, digest: Sha256DigestHex) -> Bool {
  match sha256_hex_digest(hex: sha256_hex_of_text(text: buffer)) {
    Absent => false
    Present { value: d } => (d.hex as String) == (digest as String)
  }
}

fn snapshot_receipt_secret_id(identity: SmResolvedVersionIdentity) -> String? {
  match sm_resolved_version_secret_resource(identity: identity) {
    SmVersionSecretNotAVersionResource { supplied: _ } => none
    SmVersionSecretProjected { secret_resource } =>
      match split(s: secret_resource as String, delimiter: "/secrets/") |> skip(n: 1) |> first {
        Absent => none
        Present { value: id } => Present { value: id }
      }
  }
}

fn snapshot_receipt_version_agrees(declared: SecretRef, observed: SmResolvedVersionIdentity) -> Bool {
  match snapshot_receipt_secret_id(identity: observed) {
    Absent => false
    Present { value: sid } =>
      sid == (declared.secret as String)
        && match sm_resolved_version_id(identity: observed) {
          SmVersionIdNotAVersionResource { supplied: _ } => false
          SmVersionIdProjected { version: served } =>
            match secret_ref_selector(ref: declared) {
              ExactVersion { number: n } => (served as String) == (n as String)
              AliasLatest => sm_version_id_is_number(version: served as String)
            }
        }
  }
}

type SnapshotReceiptMetadata
  = SnapshotReceiptMetadataAsDeclared
  | SnapshotReceiptMetadataRefused { reason: DispatchSnapshotRefusal }

fn snapshot_mode_group_or_other_writable(mode_text: String) -> Bool? {
  match file_mode_of_octal_text(text: mode_text) {
    Absent => none
    Present { value: m } => Present { value: m.group.write || m.other.write }
  }
}

fn observe_snapshot_receipt_metadata(receipt_path: String, declared: SnapshotCustodyDeclaration) -> SnapshotReceiptMetadata {
  let kind = stat.File.FileType(path: receipt_path)
  match stat_file_type_reading(success: kind.success, output: kind.file_type) {
    StatFileTypeUnanswered { cause: c } =>
      SnapshotReceiptMetadataRefused { reason: SnapshotReceiptMetadataUnobservable { detail: c } }
    StatFileTypeRead { kind: k } =>
      match k {
        SymbolicLinkKind => SnapshotReceiptMetadataRefused { reason: SnapshotReceiptNotRegularFile }
        RegularFileKind => observe_snapshot_receipt_owner_and_mode(receipt_path: receipt_path, declared: declared)
        _ => SnapshotReceiptMetadataRefused { reason: SnapshotReceiptNotRegularFile }
      }
  }
}

fn observe_snapshot_receipt_owner_and_mode(receipt_path: String, declared: SnapshotCustodyDeclaration) -> SnapshotReceiptMetadata {
  let owner = shell.Stat.OwnerOf(path: receipt_path as FilePath)
  if !owner.success {
    SnapshotReceiptMetadataRefused { reason: SnapshotReceiptMetadataUnobservable { detail: owner.stderr } }
  } else {
    if trim(s: owner.stdout) != (declared.publisher as String) {
      SnapshotReceiptMetadataRefused {
        reason: SnapshotReceiptWrongOwner { observed: trim(s: owner.stdout), declared: declared.publisher },
      }
    } else {
      let mode = shell.Stat.ModeOf(path: receipt_path as FilePath)
      if !mode.success {
        SnapshotReceiptMetadataRefused { reason: SnapshotReceiptMetadataUnobservable { detail: mode.stderr } }
      } else {
        match snapshot_mode_group_or_other_writable(mode_text: trim(s: mode.stdout)) {
          Absent => SnapshotReceiptMetadataRefused { reason: SnapshotReceiptMetadataUnobservable { detail: trim(s: mode.stdout) } }
          Present { value: open } =>
            if open {
              SnapshotReceiptMetadataRefused { reason: SnapshotReceiptGroupOrOtherWritable }
            } else {
              observe_snapshot_receipt_directory(receipt_path: receipt_path, declared: declared)
            }
        }
      }
    }
  }
}

fn observe_snapshot_receipt_directory(receipt_path: String, declared: SnapshotCustodyDeclaration) -> SnapshotReceiptMetadata {
  let dir = snapshot_path_dirname(path: receipt_path)
  let dir_owner = shell.Stat.OwnerOf(path: dir as FilePath)
  if !dir_owner.success {
    SnapshotReceiptMetadataRefused { reason: SnapshotReceiptMetadataUnobservable { detail: dir_owner.stderr } }
  } else {
    if trim(s: dir_owner.stdout) != (declared.publisher as String) {
      SnapshotReceiptMetadataRefused {
        reason: SnapshotReceiptDirectoryWrongOwner { observed: trim(s: dir_owner.stdout), declared: declared.publisher },
      }
    } else {
      let dir_mode = shell.Stat.ModeOf(path: dir as FilePath)
      if !dir_mode.success {
        SnapshotReceiptMetadataRefused { reason: SnapshotReceiptMetadataUnobservable { detail: dir_mode.stderr } }
      } else {
        match snapshot_mode_group_or_other_writable(mode_text: trim(s: dir_mode.stdout)) {
          Absent => SnapshotReceiptMetadataRefused { reason: SnapshotReceiptMetadataUnobservable { detail: trim(s: dir_mode.stdout) } }
          Present { value: open } =>
            if open {
              SnapshotReceiptMetadataRefused { reason: SnapshotReceiptDirectoryReaderWritable }
            } else {
              SnapshotReceiptMetadataAsDeclared
            }
        }
      }
    }
  }
}

fn join_snapshot_receipt_fields(
  declared: SnapshotCustodyDeclaration,
  buffer: String,
  receipt: HostCustodyExportReceipt,
) -> DispatchSnapshotRefusal? {
  if !snapshot_receipt_digest_agrees(buffer: buffer, digest: receipt.content_sha256) {
    Present { value: SnapshotReceiptDigestMismatch }
  } else {
    if !snapshot_receipt_version_agrees(declared: declared.secret, observed: receipt.sm_version) {
      Present { value: SnapshotReceiptVersionMismatch }
    } else {
      if (receipt.placement as String) != (declared.path as String) {
        Present { value: SnapshotReceiptPlacementMismatch }
      } else {
        if (receipt.reader as String) != (declared.reader as String) {
          Present { value: SnapshotReceiptReaderMismatch }
        } else {
          if (receipt.publisher as String) != (declared.publisher as String) {
            Present { value: SnapshotReceiptPublisherMismatch }
          } else {
            if (receipt.host as String) != (declared.host as String) {
              Present { value: SnapshotReceiptHostMismatch }
            } else {
              none
            }
          }
        }
      }
    }
  }
}

fn dispatch_credential_snapshot_take(
  attempt: DispatchAttempt,
  executor: SnapshotExecutor,
  custody: SnapshotCustodyDeclaration,
  snapshot: NonEmptyStr,
) -> DispatchCredentialSnapshot {
  let read = Filesystem.Read(path: custody.path as String)
  if !read.success {
    DispatchSnapshotRefused { reason: SnapshotCustodyUnreadable { path: custody.path, detail: read.error } }
  } else {
    if trim(s: read.content) == "" {
      DispatchSnapshotRefused { reason: SnapshotCustodyEmpty { path: custody.path } }
    } else {
      let receipt_path = host_custody_export_receipt_path(placed_path: custody.path)
      let receipt_read = Filesystem.Read(path: receipt_path as String)
      if !receipt_read.success {
        DispatchSnapshotRefused { reason: SnapshotReceiptUnreadable { path: receipt_path, detail: receipt_read.error } }
      } else {
        match observe_snapshot_receipt_metadata(receipt_path: receipt_path as String, declared: custody) {
          SnapshotReceiptMetadataRefused { reason: r } => DispatchSnapshotRefused { reason: r }
          SnapshotReceiptMetadataAsDeclared =>
            match host_custody_export_receipt_decode(text: receipt_read.content) {
              HostCustodyExportReceiptDecodeRefused { cause: c } =>
                DispatchSnapshotRefused { reason: SnapshotReceiptDecodeRefused { cause: c } }
              HostCustodyExportReceiptDecoded { receipt } =>
                match join_snapshot_receipt_fields(declared: custody, buffer: read.content, receipt: receipt) {
                  Present { value: r } => DispatchSnapshotRefused { reason: r }
                  Absent => {
                    let write = Filesystem.WriteOwnerOnly(path: snapshot as String, content: read.content)
                    if !write.success {
                      DispatchSnapshotRefused { reason: SnapshotWriteFailed { path: snapshot, detail: write.error } }
                    } else {
                      DispatchSnapshotTaken {
                        snapshot: TakenCredentialSnapshot {
                          attempt: attempt,
                          executor: executor,
                          path: snapshot,
                          generation: JoinedCustodyGeneration {
                            sm_version: receipt.sm_version,
                            content_sha256: receipt.content_sha256,
                          },
                        },
                      }
                    }
                  }
                }
            }
        }
      }
    }
  }
}

type CredentialSnapshotDiscard
  = CredentialSnapshotRemoved
  | CredentialSnapshotRemovalFailed { reason: NonEmptyStr }

fn dispatch_credential_snapshot_discard(snapshot: TakenCredentialSnapshot) -> CredentialSnapshotDiscard {
  if shell.Remove.FileForce(path: snapshot.path as FilePath).success {
    CredentialSnapshotRemoved
  } else {
    CredentialSnapshotRemovalFailed {
      reason: join(["the credential snapshot ", snapshot.path as String, " could not be removed"], "") as NonEmptyStr,
    }
  }
}
