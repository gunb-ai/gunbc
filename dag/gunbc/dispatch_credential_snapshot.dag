module gunbc.dispatch_credential_snapshot

import std.types { String, NonEmptyStr, Bool, FilePath }
import std.algebra { trim }
import extdeps.filesystem.filesystem_io { Filesystem }
import extdeps.shell
import gunbc.roadmap_model { RoadmapNodeId }

// ONE CREDENTIAL SNAPSHOT PER ATTEMPT, AND THE PROOF THAT IT WAS TAKEN. The attempt copies the
// custody bytes once, owner-only, to a path derived from its identity
// (gunbc.roadmap_dispatch_actuator dispatch_credential_snapshot_path_for_instance); the standing trip
// reads that snapshot and keeps it, and the spawned child reads the same snapshot and removes it
// before exec. The path says WHERE the take writes. What it cannot say is THAT the take wrote: a
// launch argv built from the derived path alone looks identical whether or not any take ran, and the
// only signal was the child exiting 78 after a worktree, a session and a unit had been staged.
//
// So a taken snapshot is a sealed record, and this file is kept to the take and its carriers because
// the seal is per file (src/v1/04_infer.dag sole_constructor_construction_diags): the only expression
// that can build a TakenCredentialSnapshot is the success arm of dispatch_credential_snapshot_take
// below. The launch boundary -- the Claude and Cursor argv builders, and the belt's discard -- takes
// this value, never a path, so a launch for a snapshot no take wrote is not expressible.
//
// A TAKE IS FOR ONE ATTEMPT, AND THE SNAPSHOT SAYS WHICH. Proof that some take ran is not proof that
// this attempt's take ran: a snapshot carried from one selection could otherwise license the launch of
// another attempt, provider or instance, which a path re-derived at the spawn never could. So the take
// is given the attempt it is taken FOR, the sealed value records it, and the spawn fold refuses a
// snapshot whose subject is not the attempt it is launching
// (gunbc.roadmap_dispatch_actuator dispatch_credential_snapshot_subject_for_instance is the one
// derivation both sides use). The subject is the identity; the path is only where the bytes are, which
// in production is derived from the same attempt and in a witness is a directory the witness owns.
type CredentialSnapshotSubject {
  instance_id: NonEmptyStr
  host_identity: NonEmptyStr
  node_id: RoadmapNodeId
  attempt_key: String
  provider: NonEmptyStr
}

fn credential_snapshot_subjects_agree(a: CredentialSnapshotSubject, b: CredentialSnapshotSubject) -> Bool {
  (a.instance_id as String) == (b.instance_id as String)
    && (a.host_identity as String) == (b.host_identity as String)
    && (a.node_id as String) == (b.node_id as String)
    && a.attempt_key == b.attempt_key
    && (a.provider as String) == (b.provider as String)
}

fn credential_snapshot_subject_label(subject: CredentialSnapshotSubject) -> String {
  join([
    "instance ", subject.instance_id as String, " on ", subject.host_identity as String,
    ", node ", subject.node_id as String, " attempt ", subject.attempt_key, ", provider ", subject.provider as String,
  ], "")
}

// WHAT THE SEAL ESTABLISHES, AND WHAT IT DOES NOT. It establishes that an owner-only write of non-empty
// custody bytes to `path` succeeded when the take for `subject` ran, on the route that enforces
// sole_constructor (the seed; the native route carries the modifier and does not yet check it --
// gunbc.rung_drop.g0_type_decl_modifier_parse_without_sealing_property). It does NOT establish that
// the bytes are still there at exec -- the wrapper's exit 78 remains the mitigation for a file removed
// in between -- and it does NOT establish that `source` was the provider's custody file: that rests on
// the two selection functions being the only production callers of the take. A path is carried
// rather than the bytes because the child's wrapper must read a file and never receive the secret on
// argv.
type TakenCredentialSnapshot sole_constructor {
  subject: CredentialSnapshotSubject
  path: NonEmptyStr
}

fn taken_credential_snapshot_path(snapshot: TakenCredentialSnapshot) -> NonEmptyStr {
  snapshot.path
}

fn taken_credential_snapshot_subject(snapshot: TakenCredentialSnapshot) -> CredentialSnapshotSubject {
  snapshot.subject
}

type DispatchCredentialSnapshot
  = DispatchSnapshotTaken { snapshot: TakenCredentialSnapshot }
  | DispatchSnapshotRefused { reason: NonEmptyStr }

fn dispatch_credential_snapshot_take(subject: CredentialSnapshotSubject, source: NonEmptyStr, snapshot: NonEmptyStr) -> DispatchCredentialSnapshot {
  let read = Filesystem.Read(path: source as String)
  if !read.success {
    DispatchSnapshotRefused { reason: join(["the credential custody file ", source as String, " is unreadable on this host: ", read.error], "") as NonEmptyStr }
  } else {
    if trim(s: read.content) == "" {
      DispatchSnapshotRefused { reason: join(["the credential custody file ", source as String, " is empty"], "") as NonEmptyStr }
    } else {
      let write = Filesystem.WriteOwnerOnly(path: snapshot as String, content: read.content)
      if !write.success {
        DispatchSnapshotRefused { reason: join(["the credential snapshot ", snapshot as String, " could not be written owner-only: ", write.error], "") as NonEmptyStr }
      } else {
        DispatchSnapshotTaken { snapshot: TakenCredentialSnapshot { subject: subject, path: snapshot } }
      }
    }
  }
}

// Discard takes the taken value, so it can remove only a file a take wrote -- never an arbitrary path.
fn dispatch_credential_snapshot_discard(snapshot: TakenCredentialSnapshot) -> Bool {
  shell.Remove.FileForce(path: snapshot.path as FilePath).success
}

// WHAT AN ATTEMPT CARRIES FROM SELECTION TO SPAWN. A selection that took a snapshot holds it; every
// other selection holds none. The spawn matches on this, so a Claude or Cursor launch with no held
// snapshot refuses typed before anything is staged, and an executor that never reads a snapshot
// refuses a held one rather than leaving it on disk.
type AttemptCredentialSnapshot
  = NoCredentialSnapshot
  | CredentialSnapshotHeld { snapshot: TakenCredentialSnapshot }
