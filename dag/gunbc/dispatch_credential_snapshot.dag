  SnapshotCustodyDeclaration,
  HostCustodyExportReceipt,
  host_custody_export_receipt_path,
  host_custody_export_receipt_decode,
  host_custody_export_receipt_decode_refusal_text,
  HostCustodyExportReceiptDecoded,
  HostCustodyExportReceiptDecodeRefused,
  HostCustodyExportReceiptDecodeRefusal,
}
// ONE CREDENTIAL SNAPSHOT PER ATTEMPT, AND THE PROOF THAT IT WAS TAKEN. The attempt copies the
// custody bytes once, owner-only, to a path derived from its identity, HERE (the one derivation is
// credential_snapshot_path_for_attempt below, over this module's declaration row
// taken_credential_snapshot_slots and the attempt-state declaration's entry name); the standing trip
// reads that snapshot and keeps it, and the spawned child reads the same snapshot and removes it
// before exec. The path says WHERE the take writes. What it cannot say is THAT the take wrote: a
// launch argv built from the derived path alone looks identical whether or not any take ran, and the
// only signal was the child exiting 78 after a worktree, a session and a unit had been staged.
//
// So a taken snapshot is a sealed record, and this file is kept to the take and its carriers because
// the seal is per file on the seed route (src/v1/04_infer.dag sole_constructor_construction_diags):
// the only expression that can build a TakenCredentialSnapshot is the success arm of
// dispatch_credential_snapshot_take below. The launch boundary -- the Claude and Cursor argv builders,
// the standing probes and the belt's discard -- takes this value, never a path, so a launch for a
// snapshot no take wrote is not expressible.
//
// THE SNAPSHOT IS THE LAUNCH'S ATTEMPT, NOT A CLAIM ABOUT ONE. The take is given the attempt it is
// taken for and the executor that will read it, and the sealed value carries both. A launch holding a
// snapshot reads its attempt FROM the snapshot (gunbc.roadmap.roadmap_dispatch_actuator SnapshotLaunch), so
// there is no second, independently supplied attempt for it to disagree with: a snapshot taken for
// attempt A can only ever launch, probe or be discarded as attempt A. That replaced a runtime
// comparison between the snapshot's recorded subject and the attempt the spawn was given.
type SnapshotExecutor
  = ClaudeFromSnapshot
  | CursorFromSnapshot

// THE ONE DECLARATION OF A TAKEN SNAPSHOT'S FILE: the entry the attempt-state declaration names for the
// attempt (gunbc.roadmap.roadmap_attempt_state_store attempt_state_entry_name, the shared flat entry of the
// dispatch attempt-state root), this store's own separator and suffix, owner-only like the bytes it holds.
// Nothing else spells the name: the actuator's pre-seal `dispatch_credential_snapshot_path_for_attempt`,
// which spelled the same file out of its own literals beside the take's, is DELETED (DESIGN section 3), and
// the take derives the path from the attempt it is given -- a caller no longer hands the take a path at all
// (test.claim.c_roadmap2_credential_store_seal_witness the_take_cannot_be_handed_a_path_its_caller_chose).
data taken_credential_snapshot_slots: TakenCredentialSnapshotSlotsDeclaration = TakenCredentialSnapshotSlotsDeclaration {
  entry_separator: "." as NonEmptyStr,
  entry_suffix: "-credential" as NonEmptyStr,
}

// The owner-only mode is not a field of this row: it is the effect the take performs
// (Filesystem.WriteOwnerOnly), so the row carries only what is spelled into the name.
type TakenCredentialSnapshotSlotsDeclaration {
  entry_separator: NonEmptyStr
  entry_suffix: NonEmptyStr
}

// The provider half of the name, from the executor the take was given. The launch leg reads the SAME bytes
// through the sealed snapshot (taken_credential_snapshot_path), never by re-deriving a path.
fn credential_snapshot_provider_label(executor: SnapshotExecutor) -> NonEmptyStr {
  match executor {
    ClaudeFromSnapshot => "claude" as NonEmptyStr
    CursorFromSnapshot => "cursor" as NonEmptyStr
  }
}

// THE ONE DERIVATION: the attempt (the business key: instance, node, attempt key) in, the path out. No path
// enters, and the only production writers are the take below, the discard that tombstones what the take wrote,
// and the launch-leg readers that go through the sealed snapshot -- the dispatch actuator's own pre-seal
// spelling of this name is deleted.
fn credential_snapshot_path_for_attempt(attempt: DispatchAttempt, executor: SnapshotExecutor) -> NonEmptyStr {
  attempt_state_entry_path(
    instance: attempt.instance,
    entry: join([
      attempt_state_entry_name(node: attempt.node.node as String, attempt_key: attempt.attempt_key),
      taken_credential_snapshot_slots.entry_separator as String,
      credential_snapshot_provider_label(executor: executor) as String,
      taken_credential_snapshot_slots.entry_suffix as String,
    ], "") as NonEmptyStr,
  )
}

type JoinedCustodyGeneration {
  sm_version: SmResolvedVersionIdentity
  content_sha256: Sha256DigestHex
}

// WHAT THE SEAL ESTABLISHES, AND WHAT IT DOES NOT. It establishes that an owner-only write of
// non-empty custody bytes to `path` succeeded when the take for `attempt` and `executor` ran, on the
// routes that enforce sole_constructor (native: v2.compiler.infer infer_sole_constructor_diags; seed:
// record literal and cast), AND that those bytes are the generation named on a root-published export
// receipt for the declared secret, placement, reader, publisher and HostIdentity. Seed residual:
// coproduct variants (f13) and parameter defaults (f19). It does NOT establish that the bytes are
// still there at exec -- the wrapper's exit 78 remains the mitigation for a file removed in between.
// The instance's host is an unbranded dashboard NonEmptyStr; the Cursor draw compares it to the
// declaration host by string, and the take does not observe the execution host. A path is carried
// rather than the bytes because the child's wrapper must read a file and never receive the secret
// on argv.
type TakenCredentialSnapshot sole_constructor {
  attempt: DispatchAttempt
  executor: SnapshotExecutor
  path: NonEmptyStr
  generation: JoinedCustodyGeneration
}

fn taken_credential_snapshot_path(snapshot: TakenCredentialSnapshot) -> NonEmptyStr {
  snapshot.path
}

fn taken_credential_snapshot_attempt(snapshot: TakenCredentialSnapshot) -> DispatchAttempt {
  snapshot.attempt
}

fn taken_credential_snapshot_executor(snapshot: TakenCredentialSnapshot) -> SnapshotExecutor {
  snapshot.executor
}

fn taken_credential_snapshot_generation(snapshot: TakenCredentialSnapshot) -> JoinedCustodyGeneration {
  snapshot.generation
}

type DispatchSnapshotRefusal
  = SnapshotCustodyUnreadable { path: NonEmptyStr, detail: String }
  | SnapshotCustodyEmpty { path: NonEmptyStr }
  | SnapshotReceiptUnreadable { path: NonEmptyStr, detail: String }
  | SnapshotReceiptReadTimedOut { path: NonEmptyStr }
  | SnapshotReceiptMetadataUnobservable { detail: String }
  | SnapshotReceiptNotRegularFile
  | SnapshotReceiptWrongOwner { observed: String, declared: NonEmptyStr }
  | SnapshotReceiptGroupOrOtherWritable
  | SnapshotReceiptDirectoryGroupOrOtherWritable
  | SnapshotReceiptDirectoryWrongOwner { observed: String, declared: NonEmptyStr }
  | SnapshotReceiptDecodeRefused { cause: HostCustodyExportReceiptDecodeRefusal }
  | SnapshotReceiptDigestMismatch
  | SnapshotReceiptVersionMismatch
  | SnapshotReceiptPlacementMismatch
  | SnapshotReceiptReaderMismatch
  | SnapshotReceiptPublisherMismatch
  | SnapshotReceiptHostMismatch
  | SnapshotReceiptSecretRefNotPinned
  | SnapshotReceiptSecretProjectMismatch
  | SnapshotWriteFailed { path: NonEmptyStr, detail: String }

type DispatchCredentialSnapshot
  = DispatchSnapshotTaken { snapshot: TakenCredentialSnapshot }
  | DispatchSnapshotRefused { reason: DispatchSnapshotRefusal }

fn dispatch_snapshot_refusal_text(reason: DispatchSnapshotRefusal) -> NonEmptyStr {
  match reason {
    SnapshotCustodyUnreadable { path: p, detail: d } =>
      join(["the credential custody file ", p as String, " is unreadable on this host: ", d], "") as NonEmptyStr
    SnapshotCustodyEmpty { path: p } =>
      join(["the credential custody file ", p as String, " is empty"], "") as NonEmptyStr
    SnapshotReceiptUnreadable { path: p, detail: d } =>
      join(["the custody export receipt ", p as String, " is unreadable: ", d], "") as NonEmptyStr
    SnapshotReceiptReadTimedOut { path: p } =>
      join(["the custody export receipt ", p as String, " object read exceeded its timeout"], "") as NonEmptyStr
    SnapshotReceiptMetadataUnobservable { detail: d } =>
      join(["the custody export receipt metadata is unobservable: ", d], "") as NonEmptyStr
    SnapshotReceiptNotRegularFile =>
      "the custody export receipt is not a regular file" as NonEmptyStr
    SnapshotReceiptWrongOwner { observed: o, declared: d } =>
      join(["the custody export receipt owner ", o, " is not the declared publisher ", d as String], "") as NonEmptyStr
    SnapshotReceiptGroupOrOtherWritable =>
      "the custody export receipt is writable by group or other" as NonEmptyStr
    SnapshotReceiptDirectoryGroupOrOtherWritable =>
      "the custody export receipt directory is writable by group or other" as NonEmptyStr
    SnapshotReceiptDirectoryWrongOwner { observed: o, declared: d } =>
      join(["the custody export receipt directory owner ", o, " is not the declared publisher ", d as String], "") as NonEmptyStr
    SnapshotReceiptDecodeRefused { cause: c } =>
      join(["the custody export receipt could not be decoded: ", host_custody_export_receipt_decode_refusal_text(cause: c)], "") as NonEmptyStr
    SnapshotReceiptDigestMismatch =>
      "the custody bytes do not match the export receipt digest" as NonEmptyStr
    SnapshotReceiptVersionMismatch =>
      "the export receipt version does not name the declared secret and pinned version" as NonEmptyStr
    SnapshotReceiptPlacementMismatch =>
      "the export receipt placement is not the declared custody path" as NonEmptyStr
    SnapshotReceiptReaderMismatch =>
      "the export receipt reader is not the declared reader" as NonEmptyStr
    SnapshotReceiptPublisherMismatch =>
      "the export receipt publisher is not the declared publisher" as NonEmptyStr
    SnapshotReceiptHostMismatch =>
      "the export receipt host is not the declared custody host" as NonEmptyStr
    SnapshotReceiptSecretRefNotPinned =>
      "the declared secret ref is an alias, not an exact pinned version" as NonEmptyStr
    SnapshotReceiptSecretProjectMismatch =>
      "the declared secret project is not the fleet secrets project" as NonEmptyStr
    SnapshotWriteFailed { path: p, detail: d } =>
      join(["the credential snapshot ", p as String, " could not be written owner-only: ", d], "") as NonEmptyStr
  }
}

fn snapshot_receipt_digest_agrees(buffer: String, digest: Sha256DigestHex) -> Bool {
  match sha256_hex_digest(hex: sha256_hex_of_text(text: buffer)) {
    Absent => false
    Present { value: d } => (d.hex as String) == (digest as String)
  }
}

fn snapshot_receipt_version_join(declared: SnapshotCustodyDeclaration, observed: SmResolvedVersionIdentity) -> DispatchSnapshotRefusal? {
  if (declared.secret.project as String) != (fleet_secrets_project_id as String) {
    Present { value: SnapshotReceiptSecretProjectMismatch }
  } else {
    match resolve_returned_version(
      returned: observed,
      ref: declared.secret,
      project_number: fleet_secrets_project_number,
    ) {
      SecretRefVersionResolvedExact { version: _ } => none
      SecretRefVersionResolvedAlias { alias: _, version: _ } => Present { value: SnapshotReceiptSecretRefNotPinned }
      SecretRefVersionResolutionRefused { requested: _, returned: _ } => Present { value: SnapshotReceiptVersionMismatch }
    }
  }
}

type SnapshotReceiptMetadata
  = SnapshotReceiptMetadataAsDeclared
  | SnapshotReceiptMetadataRefused { reason: DispatchSnapshotRefusal }

type SnapshotReceiptDirectoryDecision
  = SnapshotReceiptDirectoryAsDeclared
  | SnapshotReceiptDirectoryDecisionRefused { reason: DispatchSnapshotRefusal }

type SnapshotReceiptObservedMetadata
  = SnapshotReceiptObservedNotRegular
  | SnapshotReceiptObservedRegular {
      file_owner: String
      file_mode: FileMode
    }

type SnapshotReceiptPathKind
  = SnapshotReceiptPathIsRegular
  | SnapshotReceiptPathIsNotRegular
  | SnapshotReceiptPathKindUnobservable { detail: String }

fn snapshot_mode_group_or_other_writable_bits(mode: FileMode) -> Bool {
  mode.group.write || mode.other.write
}

fn snapshot_receipt_directory_decision(
  dir_owner: String,
  dir_mode: FileMode,
  declared: SnapshotCustodyDeclaration,
) -> SnapshotReceiptDirectoryDecision {
  if dir_owner != (declared.publisher as String) {
    SnapshotReceiptDirectoryDecisionRefused {
      reason: SnapshotReceiptDirectoryWrongOwner { observed: dir_owner, declared: declared.publisher },
    }
  } else {
    if snapshot_mode_group_or_other_writable_bits(mode: dir_mode) {
      SnapshotReceiptDirectoryDecisionRefused { reason: SnapshotReceiptDirectoryGroupOrOtherWritable }
    } else {
      SnapshotReceiptDirectoryAsDeclared
    }
  }
}

fn snapshot_receipt_metadata_decision(
  observed: SnapshotReceiptObservedMetadata,
  declared: SnapshotCustodyDeclaration,
) -> SnapshotReceiptMetadata {
  match observed {
    SnapshotReceiptObservedNotRegular => SnapshotReceiptMetadataRefused { reason: SnapshotReceiptNotRegularFile }
    SnapshotReceiptObservedRegular { file_owner, file_mode } =>
      if file_owner != (declared.publisher as String) {
        SnapshotReceiptMetadataRefused {
          reason: SnapshotReceiptWrongOwner { observed: file_owner, declared: declared.publisher },
        }
      } else {
        if snapshot_mode_group_or_other_writable_bits(mode: file_mode) {
          SnapshotReceiptMetadataRefused { reason: SnapshotReceiptGroupOrOtherWritable }
        } else {
          SnapshotReceiptMetadataAsDeclared
        }
      }
  }
}

fn observe_snapshot_receipt_directory(receipt_path: String, declared: SnapshotCustodyDeclaration) -> SnapshotReceiptDirectoryDecision {
  let dir = path_parent_directory(path: receipt_path)
  let dir_owner = shell.Stat.OwnerOf(path: dir as FilePath)
  let dir_mode = shell.Stat.ModeOf(path: dir as FilePath)
  if !dir_owner.success {
    SnapshotReceiptDirectoryDecisionRefused { reason: SnapshotReceiptMetadataUnobservable { detail: dir_owner.stderr } }
  } else {
    if !dir_mode.success {
      SnapshotReceiptDirectoryDecisionRefused { reason: SnapshotReceiptMetadataUnobservable { detail: dir_mode.stderr } }
    } else {
      match file_mode_of_octal_text(text: trim(s: dir_mode.stdout)) {
        Absent => SnapshotReceiptDirectoryDecisionRefused { reason: SnapshotReceiptMetadataUnobservable { detail: trim(s: dir_mode.stdout) } }
        Present { value: directory_mode } =>
          snapshot_receipt_directory_decision(
            dir_owner: trim(s: dir_owner.stdout),
            dir_mode: directory_mode,
            declared: declared,
          )
      }
    }
  }
}

fn observe_snapshot_receipt_is_regular_path(receipt_path: String) -> SnapshotReceiptPathKind {
  let kind = stat.File.FileType(path: receipt_path)
  match stat_file_type_reading(success: kind.success, output: kind.file_type) {
    StatFileTypeUnanswered { cause: c } => SnapshotReceiptPathKindUnobservable { detail: c }
    StatFileTypeRead { kind: k } =>
      match k {
        SymbolicLinkKind => SnapshotReceiptPathIsNotRegular
        RegularFileKind => SnapshotReceiptPathIsRegular
        _ => SnapshotReceiptPathIsNotRegular
      }
  }
}

type SnapshotReceiptObjectParse
  = SnapshotReceiptObjectParsed { kind_word: String, file_owner: String, file_mode_octal: String, bytes: String }
  | SnapshotReceiptObjectParseRefused { detail: String }

type SnapshotReceiptObjectHeaderWalk {
  seen: Bool
  header: String
  body_parts: List<String>
}

type SnapshotReceiptObjectFieldWalk {
  n: Int
  kind_word: String
  file_owner: String
  file_mode_octal: String
}

fn snapshot_receipt_object_parse(stdout: String) -> SnapshotReceiptObjectParse {
  let lines = split(s: stdout, delimiter: "\n")
  let walked = fold(lines, init: SnapshotReceiptObjectHeaderWalk { seen: false, header: "", body_parts: [] }, f: (acc, line) =>
    if !acc.seen {
      SnapshotReceiptObjectHeaderWalk { seen: true, header: line, body_parts: [] }
    } else {
      SnapshotReceiptObjectHeaderWalk { seen: true, header: acc.header, body_parts: concat(acc.body_parts, [line]) }
    })
  if !walked.seen {
    SnapshotReceiptObjectParseRefused { detail: "the receipt object produced no metadata line" }
  } else {
    let fields = split(s: walked.header, delimiter: "|")
    let collected = fold(fields, init: SnapshotReceiptObjectFieldWalk { n: 0, kind_word: "", file_owner: "", file_mode_octal: "" }, f: (acc, field) =>
      if acc.n == 0 {
        SnapshotReceiptObjectFieldWalk { n: 1, kind_word: field, file_owner: acc.file_owner, file_mode_octal: acc.file_mode_octal }
      } else {
        if acc.n == 1 {
          SnapshotReceiptObjectFieldWalk { n: 2, kind_word: acc.kind_word, file_owner: field, file_mode_octal: acc.file_mode_octal }
        } else {
          if acc.n == 2 {
            SnapshotReceiptObjectFieldWalk { n: 3, kind_word: acc.kind_word, file_owner: acc.file_owner, file_mode_octal: field }
          } else {
            SnapshotReceiptObjectFieldWalk { n: acc.n + 1, kind_word: acc.kind_word, file_owner: acc.file_owner, file_mode_octal: acc.file_mode_octal }
          }
        }
      })
    if collected.n != 3 {
      SnapshotReceiptObjectParseRefused { detail: walked.header }
    } else {
      SnapshotReceiptObjectParsed {
        kind_word: collected.kind_word,
        file_owner: collected.file_owner,
        file_mode_octal: collected.file_mode_octal,
        bytes: join(walked.body_parts, "\n"),
      }
    }
  }
}

type SnapshotReceiptJoin
  = SnapshotReceiptJoined { receipt: HostCustodyExportReceipt }
  | SnapshotReceiptJoinRefused { reason: DispatchSnapshotRefusal }

fn snapshot_receipt_join_from_object_bytes(
  declared: SnapshotCustodyDeclaration,
  custody_buffer: String,
  object_stdout: String,
) -> SnapshotReceiptJoin {
  match snapshot_receipt_object_parse(stdout: object_stdout) {
    SnapshotReceiptObjectParseRefused { detail: d } =>
      SnapshotReceiptJoinRefused { reason: SnapshotReceiptMetadataUnobservable { detail: d } }
    SnapshotReceiptObjectParsed { kind_word, file_owner, file_mode_octal, bytes } =>
      match stat_file_kind_of(word: kind_word) {
        RegularFileKind =>
          match file_mode_of_octal_text(text: trim(s: file_mode_octal)) {
            Absent => SnapshotReceiptJoinRefused { reason: SnapshotReceiptMetadataUnobservable { detail: file_mode_octal } }
            Present { value: file_mode } =>
              match snapshot_receipt_metadata_decision(
                observed: SnapshotReceiptObservedRegular {
                  file_owner: file_owner,
                  file_mode: file_mode,
                },
                declared: declared,
              ) {
                SnapshotReceiptMetadataRefused { reason: r } => SnapshotReceiptJoinRefused { reason: r }
                SnapshotReceiptMetadataAsDeclared =>
                  match host_custody_export_receipt_decode(text: bytes) {
                    HostCustodyExportReceiptDecodeRefused { cause: c } =>
                      SnapshotReceiptJoinRefused { reason: SnapshotReceiptDecodeRefused { cause: c } }
                    HostCustodyExportReceiptDecoded { receipt } =>
                      match join_snapshot_receipt_fields(declared: declared, buffer: custody_buffer, receipt: receipt) {
                        Present { value: r } => SnapshotReceiptJoinRefused { reason: r }
                        Absent => SnapshotReceiptJoined { receipt: receipt }
                      }
                  }
              }
          }
        _ => SnapshotReceiptJoinRefused { reason: SnapshotReceiptNotRegularFile }
      }
  }
}

fn snapshot_receipt_object_run_refused(path: NonEmptyStr, exit_code: Int, stderr: String) -> DispatchSnapshotRefusal {
  if exit_code == coreutils_timeout_expired_exit_code {
    SnapshotReceiptReadTimedOut { path: path }
  } else {
    SnapshotReceiptUnreadable { path: path, detail: stderr }
  }
}

type SnapshotReceiptObjectRead
  = SnapshotReceiptObjectReadOk { stdout: String }
  | SnapshotReceiptObjectReadRefused { reason: DispatchSnapshotRefusal }

fn read_snapshot_receipt_object(receipt_path: NonEmptyStr) -> SnapshotReceiptObjectRead {
  match posix_sh_receipt_object_command(path: receipt_path) {
    PosixShReceiptObjectEmitRefused =>
      SnapshotReceiptObjectReadRefused {
        reason: SnapshotReceiptMetadataUnobservable { detail: "the receipt-object program could not be emitted" },
      }
    PosixShReceiptObjectReady { command } => {
      let wrapped = timeout_command(duration: second(count: 5), kill_after: second(count: 1), command: command)
      let object_run = run_shell_command_observe(command: wrapped, transport: LocalExec)
      if object_run.exit_code != 0 {
        SnapshotReceiptObjectReadRefused {
          reason: snapshot_receipt_object_run_refused(
            path: receipt_path,
            exit_code: object_run.exit_code,
            stderr: object_run.stderr,
          ),
        }
      } else {
        SnapshotReceiptObjectReadOk { stdout: object_run.stdout }
      }
    }
  }
}

fn join_snapshot_receipt_fields(
  declared: SnapshotCustodyDeclaration,
  buffer: String,
  receipt: HostCustodyExportReceipt,
) -> DispatchSnapshotRefusal? {
  if !snapshot_receipt_digest_agrees(buffer: buffer, digest: receipt.content_sha256) {
    Present { value: SnapshotReceiptDigestMismatch }
  } else {
    match snapshot_receipt_version_join(declared: declared, observed: receipt.sm_version) {
      Present { value: r } => Present { value: r }
      Absent =>
        if (receipt.placement as String) != (declared.path as String) {
          Present { value: SnapshotReceiptPlacementMismatch }
        } else {
          if (receipt.reader as String) != (declared.reader as String) {
            Present { value: SnapshotReceiptReaderMismatch }
          } else {
            if (receipt.publisher as String) != (declared.publisher as String) {
              Present { value: SnapshotReceiptPublisherMismatch }
            } else {
              if (receipt.host as String) != (declared.host as String) {
                Present { value: SnapshotReceiptHostMismatch }
              } else {
                none
              }
            }
          }
        }
    }
  }
}

// Directory authority is established before any content is read. The receipt is then lstat'd as a
// regular file and opened once; owner, mode and bytes come from that descriptor
// (extdeps.posix.sh_invocation posix_sh_receipt_object_command). Residual: after the directory is
// admitted, only the publisher can swap the path between the lstat and the open.
fn dispatch_credential_snapshot_take(
  attempt: DispatchAttempt,
  executor: SnapshotExecutor,
  custody: SnapshotCustodyDeclaration,
) -> DispatchCredentialSnapshot {
  // THE destination is derived HERE, from the attempt whose bytes are being taken: a caller cannot aim the
  // take at a file of its choosing (test.claim.c_roadmap2_credential_store_seal_witness
  // the_take_cannot_be_handed_a_path_its_caller_chose). The pre-seal signature took `snapshot: NonEmptyStr`
  // and the dispatch actuator spelled that path a second time from its own literals; both are deleted.
  let snapshot = credential_snapshot_path_for_attempt(attempt: attempt, executor: executor)
  let receipt_path = host_custody_export_receipt_path(placed_path: custody.path)
  match observe_snapshot_receipt_directory(receipt_path: receipt_path as String, declared: custody) {
    SnapshotReceiptDirectoryDecisionRefused { reason: r } => DispatchSnapshotRefused { reason: r }
    SnapshotReceiptDirectoryAsDeclared =>
      match observe_snapshot_receipt_is_regular_path(receipt_path: receipt_path as String) {
        SnapshotReceiptPathKindUnobservable { detail: d } =>
          DispatchSnapshotRefused { reason: SnapshotReceiptMetadataUnobservable { detail: d } }
        SnapshotReceiptPathIsNotRegular => DispatchSnapshotRefused { reason: SnapshotReceiptNotRegularFile }
        SnapshotReceiptPathIsRegular => {
          let read = Filesystem.Read(path: custody.path as String)
          if !read.success {
            DispatchSnapshotRefused { reason: SnapshotCustodyUnreadable { path: custody.path, detail: read.error } }
          } else {
            if trim(s: read.content) == "" {
              DispatchSnapshotRefused { reason: SnapshotCustodyEmpty { path: custody.path } }
            } else {
              match read_snapshot_receipt_object(receipt_path: receipt_path) {
                SnapshotReceiptObjectReadRefused { reason: r } => DispatchSnapshotRefused { reason: r }
                SnapshotReceiptObjectReadOk { stdout } =>
                  match snapshot_receipt_join_from_object_bytes(
                    declared: custody,
                    custody_buffer: read.content,
                    object_stdout: stdout,
                  ) {
                    SnapshotReceiptJoinRefused { reason: r } => DispatchSnapshotRefused { reason: r }
                    SnapshotReceiptJoined { receipt } => {
                      let write = Filesystem.WriteOwnerOnly(path: snapshot as String, content: read.content)
                      if !write.success {
                        DispatchSnapshotRefused { reason: SnapshotWriteFailed { path: snapshot, detail: write.error } }
                      } else {
                        DispatchSnapshotTaken {
                          snapshot: TakenCredentialSnapshot {
                            attempt: attempt,
                            executor: executor,
                            path: snapshot,
                            generation: JoinedCustodyGeneration {
                              sm_version: receipt.sm_version,
                              content_sha256: receipt.content_sha256,
                            },
                          },
                        }
                      }
                    }
                  }
              }
            }
          }
        }
      }
  }
}

// A DISCARD RETIRES THE SNAPSHOT IT IS GIVEN, which is a file a take wrote -- never an arbitrary path
// -- and which belongs to the attempt that holds it: the launch that carries the snapshot IS that
// attempt, so the owner deciding the child will not consume it occupies that same path with a
// tombstone. The secret is gone; the path stays, so a later reader cannot treat absence as "never taken".
type CredentialSnapshotDiscard
  = CredentialSnapshotTombstoned
  | CredentialSnapshotTombstoneFailed { reason: NonEmptyStr }

data credential_snapshot_tombstone_body: String = "{\"tombstone\":true}\n"

fn credential_snapshot_after_read_disposition() -> PosixShFileDisposition {
  PosixShReplaceFileAfterRead { body: credential_snapshot_tombstone_body }
}

type CredentialOccupy
  = CredentialOccupied
  | CredentialOccupyFailed { detail: String }

fn credential_occupy_tombstone(path: String) -> CredentialOccupy {
  let dir = path_parent_directory(path: path)
  let staged = shell.Mktemp.FileInDirectory(dir: dir as FilePath)
  if !staged.success {
    CredentialOccupyFailed { detail: "mktemp in the snapshot directory failed" }
  } else {
    let cleared = shell.Remove.FileForce(path: staged.path)
    if !cleared.success {
      CredentialOccupyFailed { detail: "could not clear the staging name for create-new" }
    } else {
      let created = Filesystem.WriteCreateNew(path: staged.path as String, content: credential_snapshot_tombstone_body)
      if created.success {
        let moved = shell.Move.Replace(source: staged.path, destination: path as FilePath)
        if moved.success {
          CredentialOccupied
        } else {
          let _ = shell.Remove.FileForce(path: staged.path)
          CredentialOccupyFailed { detail: "mv -f replace of the snapshot failed; staging residue was removed" }
        }
      } else if created.error_kind == "already_exists" {
        CredentialOccupyFailed { detail: join(["staging name already existed: ", staged.path as String], "") }
      } else {
        CredentialOccupyFailed { detail: created.error }
      }
    }
  }
}

fn dispatch_credential_snapshot_discard(snapshot: TakenCredentialSnapshot) -> CredentialSnapshotDiscard {
  // The path it tombstones is the path the take wrote: it comes from the sealed snapshot, never from a
  // caller, and the tombstone's create-new exclusion runs in THIS module (ruling: the create-once stays in
  // the store module, split by kind). A caller cannot aim it -- the only entry is this discard, over a
  // snapshot only dispatch_credential_snapshot can build.
  match credential_occupy_tombstone(path: snapshot.path as String) {
    CredentialOccupied => CredentialSnapshotTombstoned
    CredentialOccupyFailed { detail: d } =>
      CredentialSnapshotTombstoneFailed {
        reason: join(["the credential snapshot ", snapshot.path as String, " could not be occupied by a tombstone: ", d], "") as NonEmptyStr,
      }
  }
}
