type LandingAttemptId = std.types.NonEmptyStr where brand("LandingAttemptId")
type LandingTargetHandle = std.types.NonEmptyStr where brand("LandingTargetHandle")
type LandingAcceptedStateHandle = std.types.NonEmptyStr where brand("LandingAcceptedStateHandle")
type LandingTransformationHandle = std.types.NonEmptyStr where brand("LandingTransformationHandle")
type LandingFactHandle = std.types.NonEmptyStr where brand("LandingFactHandle")
type LandingScopeHandle = std.types.NonEmptyStr where brand("LandingScopeHandle")
type LandingActorAuthorityHandle = std.types.NonEmptyStr where brand("LandingActorAuthorityHandle")
type LandingResultHandle = std.types.NonEmptyStr where brand("LandingResultHandle")
type LandingContinuationHandle = std.types.NonEmptyStr where brand("LandingContinuationHandle")
type LandingClaimBound = std.types.NonEmptyStr where brand("LandingClaimBound")
type LandingEvidenceAuthorityHandle = std.types.NonEmptyStr where brand("LandingEvidenceAuthorityHandle")
type LandingFidelityBoundaryHandle = std.types.NonEmptyStr where brand("LandingFidelityBoundaryHandle")
type LandingEvidenceIndependenceHandle = std.types.NonEmptyStr where brand("LandingEvidenceIndependenceHandle")
type LandingEvidencePolicyHandle = std.types.NonEmptyStr where brand("LandingEvidencePolicyHandle")
type LandingAdmissionContractHandle = std.types.NonEmptyStr where brand("LandingAdmissionContractHandle")
type LandingEquivalenceHandle = std.types.NonEmptyStr where brand("LandingEquivalenceHandle")
type LandingAtomicGroupHandle = std.types.NonEmptyStr where brand("LandingAtomicGroupHandle")
type LandingAtomicIndependenceReceipt = std.content_hash.ContentHash where brand("LandingAtomicIndependenceReceipt")
type LandingTransitionIdentity = std.types.NonEmptyStr where brand("LandingTransitionIdentity")
type LandingResultingStateHandle = std.types.NonEmptyStr where brand("LandingResultingStateHandle")
type LandingObservationAuthorityHandle = std.types.NonEmptyStr where brand("LandingObservationAuthorityHandle")
type LandingTargetBindingReceipt = std.content_hash.ContentHash where brand("LandingTargetBindingReceipt")
type LandingAudienceQuestion = std.types.NonEmptyStr where brand("LandingAudienceQuestion")
type LandingAudienceLabel = std.types.NonEmptyStr where brand("LandingAudienceLabel")
type LandingAudiencePreview = std.types.NonEmptyStr where brand("LandingAudiencePreview")
type LandingAudienceReason = std.types.NonEmptyStr where brand("LandingAudienceReason")
type LandingAudienceParty = std.types.NonEmptyStr where brand("LandingAudienceParty")
type LandingAudienceAction = std.types.NonEmptyStr where brand("LandingAudienceAction")
type LandingAudienceStatus = std.types.NonEmptyStr where brand("LandingAudienceStatus")

type LandingGuaranteeProposition {
  statement: std.types.NonEmptyStr
}

type LandingEvidenceFact {
  proposal: LandingProposalOccurrenceId
  observation: LandingFactHandle
  claim: LandingRequiredClaim
}

type LandingRequiredClaim = std.claim_evidence.Claim<LandingTransformationHandle, LandingTargetHandle, LandingGuaranteeProposition, LandingScopeHandle, LandingClaimBound>

type LandingEvidenceLink = std.claim_evidence.EvidenceLink<LandingEvidenceFact, LandingRequiredClaim, LandingEvidenceAuthorityHandle, LandingFidelityBoundaryHandle, LandingEvidenceIndependenceHandle>

type LandingEvidenceAdmissionPolicy = std.claim_evidence.EvidenceAdmissionPolicy<LandingEvidenceFact, LandingRequiredClaim, LandingEvidenceAuthorityHandle, LandingFidelityBoundaryHandle, LandingEvidenceIndependenceHandle>

type LandingClaimReadinessReceipt = std.claim_evidence.ClaimReadinessReceipt<LandingEvidenceFact, LandingRequiredClaim, LandingEvidenceAuthorityHandle, LandingFidelityBoundaryHandle, LandingEvidenceIndependenceHandle>

type LandingClaimRequirementReadiness = std.claim_evidence.ClaimRequirementReadiness<LandingEvidenceFact, LandingRequiredClaim, LandingEvidenceAuthorityHandle, LandingFidelityBoundaryHandle, LandingEvidenceIndependenceHandle>

type LandingRequiredClaims {
  first: LandingRequiredClaim
  remaining: List<LandingRequiredClaim>
}

type LandingAtomicGroup {
  identity: LandingAtomicGroupHandle
  scopes: List<LandingScopeHandle>
}

type LandingAtomicity
  = LandingWholeProposalAtomic
  | LandingIndependentGroupsAllowed {
      first_group: LandingAtomicGroup,
      second_group: LandingAtomicGroup,
      additional_groups: List<LandingAtomicGroup>,
      independence: LandingAtomicIndependenceReceipt,
    }

type LandingProposalContract {
  occurrence: LandingProposalOccurrenceId
  attempt: LandingAttemptId
  target: LandingTargetHandle
  authored_parent: LandingAcceptedStateHandle
  transformation: LandingTransformationHandle
  reads_relies: List<LandingFactHandle>
  modifies_frame: List<LandingScopeHandle>
  ensures_guarantees: LandingRequiredClaims
  dependencies: List<LandingProposalOccurrenceId>
  atomicity: LandingAtomicity
  submit_authority: LandingActorAuthorityHandle
  submitted_at: std.types.Timestamp
}

fn landing_native_identity(
  proposal: LandingProposalContract,
) -> gunbc.native_scm_interaction_contract.NativeScmProposalIdentity {
  gunbc.native_scm_interaction_contract.NativeScmProposalIdentity {
    name: proposal.occurrence as String,
    attempt_key: proposal.attempt as String,
  }
}

type LandingStressProfile {
  agents_per_developer: std.integer.PositiveInt
  overlapping_proposals: std.integer.PositiveInt
  validation_path: std.measure.Minute
}

data gunbc_landing_stress_profile: LandingStressProfile = LandingStressProfile {
  agents_per_developer: 50,
  overlapping_proposals: 10,
  validation_path: minute(count: 30),
}

type LandingReadyEvidenceReceipt {
  proposal: LandingProposalContract
  policy: LandingEvidencePolicyHandle
  readiness: LandingClaimReadinessReceipt
}

type LandingEvidenceBlock
  = LandingDuplicateRequirement {
      claim: LandingRequiredClaim,
    }
  | LandingMissingEvidence {
      claim: LandingRequiredClaim,
    }
  | LandingClaimChallenged {
      claim: LandingRequiredClaim,
      challenging: List<LandingEvidenceLink>,
    }
  | LandingEvidenceConflicted {
      claim: LandingRequiredClaim,
      supporting: List<LandingEvidenceLink>,
      challenging: List<LandingEvidenceLink>,
    }
  | LandingEvidenceRefused {
      claim: LandingRequiredClaim,
      refusals: List<std.claim_evidence.EvidenceAdmissionRefusal>,
    }

type LandingEvidenceReadiness
  = LandingEvidenceReady {
      receipt: LandingReadyEvidenceReceipt,
    }
  | LandingEvidenceBlocking {
      proposal: LandingProposalContract,
      policy: LandingEvidencePolicyHandle,
      readiness: LandingClaimReadinessReceipt,
      first_blocking: LandingEvidenceBlock,
      remaining_blocking: List<LandingEvidenceBlock>,
    }

fn landing_required_claims(
  proposal: LandingProposalContract,
) -> List<LandingRequiredClaim> {
  append(
    [proposal.ensures_guarantees.first],
    items: proposal.ensures_guarantees.remaining,
  )
}

fn landing_requirement_is_duplicated(
  proposal: LandingProposalContract,
  claim: LandingRequiredClaim,
) -> Bool {
  count(
    landing_required_claims(proposal: proposal)
      |> filter(required => required == claim)
  ) > 1
}

fn landing_requirement_block(
  proposal: LandingProposalContract,
  readiness: LandingClaimRequirementReadiness,
) -> List<LandingEvidenceBlock> {
  claim_requirement_readiness_fold(
    readiness: readiness,
    fold: std.claim_evidence.ClaimRequirementReadinessFold {
      ready: fn(claim, _) {
        if landing_requirement_is_duplicated(
          proposal: proposal,
          claim: claim,
        ) {
          [LandingDuplicateRequirement { claim: claim }]
        } else {
          []
        }
      },
      missing: fn(claim) {
        [LandingMissingEvidence { claim: claim }]
      },
      challenged: fn(claim, challenging) {
        [LandingClaimChallenged {
          claim: claim,
          challenging: challenging,
        }]
      },
      conflicted: fn(claim, supporting, challenging) {
        [LandingEvidenceConflicted {
          claim: claim,
          supporting: supporting,
          challenging: challenging,
        }]
      },
      evidence_refused: fn(claim, _, _, refusals) {
        [LandingEvidenceRefused {
          claim: claim,
          refusals: refusals,
        }]
      },
    },
  )
}

fn landing_evidence_readiness(
  proposal: LandingProposalContract,
  policy: LandingEvidencePolicyHandle,
  admission: LandingEvidenceAdmissionPolicy,
  links: List<LandingEvidenceLink>,
) -> LandingEvidenceReadiness {
  let readiness = claim_readiness_receipt(
    policy: std.claim_evidence.ClaimReadinessPolicy {
      first_required: proposal.ensures_guarantees.first,
      remaining_required: proposal.ensures_guarantees.remaining,
      evidence_admission: admission,
    },
    links: links,
  )
  let blocks = concat(
    landing_requirement_block(
      proposal: proposal,
      readiness: readiness.first_required,
    ),
    readiness.remaining_required |> flat_map(required =>
      landing_requirement_block(
        proposal: proposal,
        readiness: required,
      )
    ),
  )
  match list_head(xs: blocks) {
    HeadAbsent =>
      LandingEvidenceReady {
        receipt: LandingReadyEvidenceReceipt {
          proposal: proposal,
          policy: policy,
          readiness: readiness,
        },
      }
    HeadFound { value } =>
      LandingEvidenceBlocking {
        proposal: proposal,
        policy: policy,
        readiness: readiness,
        first_blocking: value,
        remaining_blocking: blocks |> filter(block => block != value),
      }
  }
}

type LandingResultClass {
  result: LandingResultHandle
  preview: LandingAudiencePreview
}

type LandingProposalAmendment {
  transformation: LandingTransformationHandle
  preview: LandingAudiencePreview
}

type LandingNormativeAlternative
  = LandingSelectResult {
      result: LandingResultClass,
    }
  | LandingSelectProposalAmendment {
      amendment: LandingProposalAmendment,
    }

type LandingNormativeOption {
  label: LandingAudienceLabel
  preview: LandingAudiencePreview
  resume_hint: std.types.NonEmptyStr
  alternative: LandingNormativeAlternative
}

type LandingNormativeOptions {
  first_option: LandingNormativeOption
  second_option: LandingNormativeOption
  additional_options: List<LandingNormativeOption>
}

type LandingCandidateSpace
  = LandingNoResultClasses {
      incompatible_core: std.types.NonEmptyStr,
      counterexample: std.types.NonEmptyStr,
    }
  | LandingOneResultClass {
      result: LandingResultClass,
    }
  | LandingManyResultClasses {
      question: LandingAudienceQuestion,
      options: LandingNormativeOptions,
    }

type LandingIndependentReadBackAuthorityReceipt {
  observer: LandingObservationAuthorityHandle
  admission_contract: LandingAdmissionContractHandle
  established_by: LandingActorAuthorityHandle
  receipt: std.content_hash.ContentHash
}

type LandingClosureSubject {
  ready_evidence: LandingReadyEvidenceReceipt
  admission_contract: LandingAdmissionContractHandle
  read_back_authority: LandingIndependentReadBackAuthorityReceipt
  equivalence: LandingEquivalenceHandle
  candidates: LandingCandidateSpace
}

type LandingCaptureCompletenessReceipt { receipt: std.content_hash.ContentHash }
type LandingAffectedScopeReceipt { receipt: std.content_hash.ContentHash }
type LandingRuleClosureReceipt { receipt: std.content_hash.ContentHash }
type LandingCandidateGenerationReceipt { receipt: std.content_hash.ContentHash }
type LandingAdmissibilityReceipt { receipt: std.content_hash.ContentHash }
type LandingEquivalenceQuotientReceipt { receipt: std.content_hash.ContentHash }
type LandingMultiplicityReceipt { receipt: std.content_hash.ContentHash }

type LandingClosureEvidence {
  capture_completeness: LandingCaptureCompletenessReceipt
  affected_scope: LandingAffectedScopeReceipt
  rule_closure: LandingRuleClosureReceipt
  candidate_generation: LandingCandidateGenerationReceipt
  admissibility: LandingAdmissibilityReceipt
  equivalence_quotient: LandingEquivalenceQuotientReceipt
  multiplicity: LandingMultiplicityReceipt
}

type LandingClosedResultSpaceReceipt {
  subject: LandingClosureSubject
  closure: LandingClosureEvidence
}

type LandingClosureCertificateKind
  = LandingCaptureCompletenessCertificate
  | LandingAffectedScopeCertificate
  | LandingRuleClosureCertificate
  | LandingCandidateGenerationCertificate
  | LandingAdmissibilityCertificate
  | LandingEquivalenceQuotientCertificate
  | LandingMultiplicityCertificate

type LandingClosureAttempt
  = LandingClosureComplete {
      receipt: LandingClosedResultSpaceReceipt,
    }
  | LandingClosureIncomplete {
      subject: LandingClosureSubject,
      missing: LandingClosureCertificateKind,
      cause: std.types.NonEmptyStr,
    }

type LandingRefusalKind
  = LandingAuthorizationDenied
  | LandingPolicyDenied
  | LandingSelfAmendmentDenied
  | LandingBoundExhausted
  | LandingPermanentEffectFailure
  | LandingSemanticRequirementsIncompatible
  | LandingUnsupportedFragment
  | LandingEvidenceAdmissionDenied

type LandingRefusal {
  kind: LandingRefusalKind
  locus: std.types.NonEmptyStr
  occurrences: std.integer.PositiveInt
  internal_cause: std.types.NonEmptyStr
  plain_reason: LandingAudienceReason
  responsible_party: LandingAudienceParty
  next_action: LandingAudienceAction
  receipt: std.content_hash.ContentHash
}

fn landing_native_refusal(
  refusal: LandingRefusal,
) -> gunbc.native_scm_interaction_contract.NativeScmRefusal {
  gunbc.native_scm_interaction_contract.NativeScmRefusal {
    plain_reason: refusal.plain_reason as String,
    responsible_party: refusal.responsible_party as String,
    next_action: refusal.next_action as String,
    refusal_receipt: refusal.receipt as String,
  }
}

type LandingMachineContinuationKind
  = LandingContinueInvestigation
  | LandingResolveEvidenceConflict
  | LandingAwaitApproval
  | LandingRetryCurrentTarget
  | LandingRetryEffect
  | LandingRepairProjection
  | LandingPrepareTransition

type LandingMachineContinuation {
  handle: LandingContinuationHandle
  kind: LandingMachineContinuationKind
  status: LandingAudienceStatus
}

type LandingNormativeQuestion {
  proposal: LandingProposalContract
  question: LandingAudienceQuestion
  options: LandingNormativeOptions
}

fn landing_native_option(
  option: LandingNormativeOption,
) -> gunbc.native_scm_interaction_contract.NativeScmContinuationOption {
  gunbc.native_scm_interaction_contract.NativeScmContinuationOption {
    label: option.label as std.types.NonEmptyStr,
    result_preview: option.preview as std.types.NonEmptyStr,
    resume_token: option.resume_hint,
  }
}

fn landing_question_continuation(
  question: LandingNormativeQuestion,
) -> gunbc.native_scm_interaction_contract.NativeScmContinuation {
  gunbc.native_scm_interaction_contract.NativeScmContinuation {
    proposal: landing_native_identity(proposal: question.proposal),
    options: gunbc.native_scm_interaction_contract.NativeScmContinuationOptions {
      first_option: landing_native_option(
        option: question.options.first_option,
      ),
      second_option: landing_native_option(
        option: question.options.second_option,
      ),
      additional_options: question.options.additional_options
        |> map(option => landing_native_option(option: option)),
    },
  }
}

type LandingClosedManyReceipt {
  closed_space: LandingClosedResultSpaceReceipt
  question: LandingNormativeQuestion
}

type LandingChoiceContinuation {
  prior: LandingClosedManyReceipt
  selected: gunbc.native_scm_interaction_contract.NativeScmSelectedContinuationOption
  processing: LandingResumedSemanticProcessing
}

type LandingResumedSemanticProcessing
  = LandingSelectedResultProcessing {
      result: LandingResultClass,
    }
  | LandingProposalAmendmentProcessing {
      amendment: LandingProposalAmendment,
    }

fn landing_resume_alternative(
  alternative: LandingNormativeAlternative,
) -> LandingResumedSemanticProcessing {
  match alternative {
    LandingSelectResult { result } =>
      LandingSelectedResultProcessing { result: result }
    LandingSelectProposalAmendment { amendment } =>
      LandingProposalAmendmentProcessing { amendment: amendment }
  }
}

type LandingChoiceResolution
  = LandingChoiceAdvanced {
      continuation: LandingChoiceContinuation,
    }
  | LandingChoiceNotOffered {
      prior: LandingClosedManyReceipt,
      choice: gunbc.native_scm_interaction_contract.NativeScmContinuationChoice,
    }

fn landing_alternative_for_choice(
  options: LandingNormativeOptions,
  choice: gunbc.native_scm_interaction_contract.NativeScmContinuationChoice,
) -> Optional<LandingNormativeAlternative> {
  match choice {
    NativeScmFirstContinuationOption =>
      Present { value: options.first_option.alternative }
    NativeScmSecondContinuationOption =>
      Present { value: options.second_option.alternative }
    NativeScmAdditionalContinuationOption { index } =>
      list_at_optional(
        xs: options.additional_options,
        index: index,
      ) |> map(option => option.alternative)
  }
}

fn landing_resolve_question(
  prior: LandingClosedManyReceipt,
  choice: gunbc.native_scm_interaction_contract.NativeScmContinuationChoice,
) -> LandingChoiceResolution {
  let question = prior.question
  let continuation = landing_question_continuation(question: question)
  match native_scm_resolve_choice(
    continuation: continuation,
    choice: choice,
  ) {
    NativeScmContinuationChoiceMatched { selected } => {
      let alternative = landing_alternative_for_choice(
        options: question.options,
        choice: selected.identity.choice,
      )
      match alternative {
        Present { value } =>
          LandingChoiceAdvanced {
            continuation: LandingChoiceContinuation {
              prior: prior,
              selected: selected,
              processing: landing_resume_alternative(
                alternative: value,
              ),
            },
          }
        Absent =>
          LandingChoiceNotOffered {
            prior: prior,
            choice: selected.identity.choice,
          }
      }
    }
    NativeScmContinuationChoiceNotOffered { choice: not_offered } =>
      LandingChoiceNotOffered {
        prior: prior,
        choice: not_offered,
      }
  }
}

type LandingClosedZeroDisposition
  = LandingZeroTerminal {
      refusal: LandingRefusal,
    }

type LandingUnclosedCause
  = LandingEvidenceNotReady {
      first: LandingEvidenceBlock,
      remaining: List<LandingEvidenceBlock>,
    }
  | LandingClosureCertificateMissing {
      certificate: LandingClosureCertificateKind,
      cause: std.types.NonEmptyStr,
    }
  | LandingSearchBoundExhausted {
      cause: std.types.NonEmptyStr,
    }

type LandingUnclosedDisposition
  = LandingInvestigationContinues {
      continuation: LandingMachineContinuation,
    }
  | LandingEvidenceConflictContinues {
      continuation: LandingMachineContinuation,
    }
  | LandingUnclosedTerminal {
      refusal: LandingRefusal,
    }

type LandingClosedOneReceipt {
  closed_space: LandingClosedResultSpaceReceipt
  unique: LandingResultClass
}

type LandingSemanticResultSpace
  = LandingClosedZero {
      closed_space: LandingClosedResultSpaceReceipt,
      incompatible_core: std.types.NonEmptyStr,
      counterexample: std.types.NonEmptyStr,
      disposition: LandingClosedZeroDisposition,
    }
  | LandingClosedOne {
      receipt: LandingClosedOneReceipt,
    }
  | LandingClosedMany {
      receipt: LandingClosedManyReceipt,
    }
  | LandingUnclosed {
      proposal: LandingProposalContract,
      cause: LandingUnclosedCause,
      partial_results: List<LandingResultHandle>,
      disposition: LandingUnclosedDisposition,
    }

fn landing_closed_result_space(
  attempt: LandingClosureAttempt,
  zero_refusal: LandingRefusal,
  continuation: LandingMachineContinuation,
) -> LandingSemanticResultSpace {
  match attempt {
    LandingClosureComplete { receipt } =>
      match receipt.subject.candidates {
        LandingNoResultClasses { incompatible_core, counterexample } =>
          LandingClosedZero {
            closed_space: receipt,
            incompatible_core: incompatible_core,
            counterexample: counterexample,
            disposition: LandingZeroTerminal {
              refusal: zero_refusal,
            },
          }
        LandingOneResultClass { result } =>
          LandingClosedOne {
            receipt: LandingClosedOneReceipt {
              closed_space: receipt,
              unique: result,
            },
          }
        LandingManyResultClasses { question, options } =>
          LandingClosedMany {
            receipt: LandingClosedManyReceipt {
              closed_space: receipt,
              question: LandingNormativeQuestion {
                proposal: receipt.subject.ready_evidence.proposal,
                question: question,
                options: options,
              },
            },
          }
      }
    LandingClosureIncomplete { subject, missing, cause } =>
      LandingUnclosed {
        proposal: subject.ready_evidence.proposal,
        cause: LandingClosureCertificateMissing {
          certificate: missing,
          cause: cause,
        },
        partial_results: [],
        disposition: LandingInvestigationContinues {
          continuation: continuation,
        },
      }
  }
}

fn landing_blocked_evidence_result(
  readiness: LandingEvidenceReadiness,
  partial_results: List<LandingResultHandle>,
  continuation: LandingMachineContinuation,
  conflict_continuation: LandingMachineContinuation,
  terminal_refusal: LandingRefusal,
) -> LandingSemanticResultSpace {
  match readiness {
    LandingEvidenceReady { receipt } =>
      LandingUnclosed {
        proposal: receipt.proposal,
        cause: LandingSearchBoundExhausted {
          cause: "ready evidence requires a closure attempt",
        },
        partial_results: partial_results,
        disposition: LandingInvestigationContinues {
          continuation: continuation,
        },
      }
    LandingEvidenceBlocking {
      proposal,
      policy: _,
      readiness: _,
      first_blocking,
      remaining_blocking,
    } =>
      match first_blocking {
        LandingMissingEvidence { claim: _ } =>
          LandingUnclosed {
            proposal: proposal,
            cause: LandingEvidenceNotReady {
              first: first_blocking,
              remaining: remaining_blocking,
            },
            partial_results: partial_results,
            disposition: LandingInvestigationContinues {
              continuation: continuation,
            },
          }
        LandingEvidenceConflicted {
          claim: _,
          supporting: _,
          challenging: _,
        } =>
          LandingUnclosed {
            proposal: proposal,
            cause: LandingEvidenceNotReady {
              first: first_blocking,
              remaining: remaining_blocking,
            },
            partial_results: partial_results,
            disposition: LandingEvidenceConflictContinues {
              continuation: conflict_continuation,
            },
          }
        LandingClaimChallenged { claim: _, challenging: _ } =>
          LandingUnclosed {
            proposal: proposal,
            cause: LandingEvidenceNotReady {
              first: first_blocking,
              remaining: remaining_blocking,
            },
            partial_results: partial_results,
            disposition: LandingUnclosedTerminal {
              refusal: terminal_refusal,
            },
          }
        LandingEvidenceRefused { claim: _, refusals: _ } =>
          LandingUnclosed {
            proposal: proposal,
            cause: LandingEvidenceNotReady {
              first: first_blocking,
              remaining: remaining_blocking,
            },
            partial_results: partial_results,
            disposition: LandingUnclosedTerminal {
              refusal: terminal_refusal,
            },
          }
        LandingDuplicateRequirement { claim: _ } =>
          LandingUnclosed {
            proposal: proposal,
            cause: LandingEvidenceNotReady {
              first: first_blocking,
              remaining: remaining_blocking,
            },
            partial_results: partial_results,
            disposition: LandingUnclosedTerminal {
              refusal: terminal_refusal,
            },
          }
      }
  }
}

type LandingAdmissionReceipt {
  semantic: LandingClosedOneReceipt
  authority: LandingActorAuthorityHandle
  receipt: std.content_hash.ContentHash
}

type LandingAdmissionDecision
  = LandingAdmitted {
      receipt: LandingAdmissionReceipt,
    }
  | LandingApprovalRequired {
      semantic: LandingClosedOneReceipt,
      continuation: LandingMachineContinuation,
    }
  | LandingUnauthorized {
      semantic: LandingClosedOneReceipt,
      refusal: LandingRefusal,
    }
  | LandingPolicyRefused {
      semantic: LandingClosedOneReceipt,
      refusal: LandingRefusal,
    }
  | LandingSelfAmendmentRefused {
      semantic: LandingClosedOneReceipt,
      refusal: LandingRefusal,
    }

type LandingAdmittedResult {
  admission: LandingAdmissionReceipt
}

type LandingAdmissionAdvance
  = LandingAdmissionAdvanced {
      admitted: LandingAdmittedResult,
    }
  | LandingAdmissionNotAdvanced {
      decision: LandingAdmissionDecision,
    }

fn landing_admitted_result(
  admission: LandingAdmissionDecision,
) -> LandingAdmissionAdvance {
  match admission {
    LandingAdmitted { receipt } =>
      LandingAdmissionAdvanced {
        admitted: LandingAdmittedResult {
          admission: receipt,
        },
      }
    LandingApprovalRequired { semantic, continuation } =>
      LandingAdmissionNotAdvanced {
        decision: LandingApprovalRequired {
          semantic: semantic,
          continuation: continuation,
        },
      }
    LandingUnauthorized { semantic, refusal } =>
      LandingAdmissionNotAdvanced {
        decision: LandingUnauthorized {
          semantic: semantic,
          refusal: refusal,
        },
      }
    LandingPolicyRefused { semantic, refusal } =>
      LandingAdmissionNotAdvanced {
        decision: LandingPolicyRefused {
          semantic: semantic,
          refusal: refusal,
        },
      }
    LandingSelfAmendmentRefused { semantic, refusal } =>
      LandingAdmissionNotAdvanced {
        decision: LandingSelfAmendmentRefused {
          semantic: semantic,
          refusal: refusal,
        },
      }
  }
}

type LandingTransitionReceipt {
  admitted: LandingAdmittedResult
  identity: LandingTransitionIdentity
  resulting_state: LandingResultingStateHandle
  transition_authority: LandingActorAuthorityHandle
}

type LandingReadBackObservation {
  transition: LandingTransitionReceipt
  observed_state: LandingResultingStateHandle
  authority: LandingObservationAuthorityHandle
}

type LandingIndependentReadBackReceipt {
  observation: LandingReadBackObservation
}

type LandingReadBackAssessment
  = LandingReadBackMatched {
      receipt: LandingIndependentReadBackReceipt,
    }
  | LandingReadBackMismatched {
      observation: LandingReadBackObservation,
    }
  | LandingReadBackAuthorityRefused {
      observation: LandingReadBackObservation,
    }

fn landing_independent_read_back(
  observation: LandingReadBackObservation,
) -> LandingReadBackAssessment {
  let subject = observation.transition.admitted.admission.semantic.closed_space.subject
  let authority = subject.read_back_authority
  if authority.admission_contract != subject.admission_contract
    || observation.authority != authority.observer
    || authority.observer == observation.transition.transition_authority {
    LandingReadBackAuthorityRefused {
      observation: observation,
    }
  } else if observation.observed_state == observation.transition.resulting_state {
    LandingReadBackMatched {
      receipt: LandingIndependentReadBackReceipt {
        observation: observation,
      },
    }
  } else {
    LandingReadBackMismatched {
      observation: observation,
    }
  }
}

type LandingCompatibilityTargetBinding {
  semantic_target: LandingTargetHandle
  native_target: gunbc.scm_compatibility_shape.CompatibilityTargetHandle
  receipt: LandingTargetBindingReceipt
}

type LandingProjectionOfAcceptedTransition {
  transition: LandingTransitionReceipt
  binding: LandingCompatibilityTargetBinding
  projection: gunbc.scm_compatibility_shape.CompatibilityProjectionReceipt
}

type LandingProjectionRelation
  = LandingProjectionBound {
      receipt: LandingProjectionOfAcceptedTransition,
    }
  | LandingProjectionBindingRefused {
      cause: std.types.NonEmptyStr,
    }

fn landing_projection_of_transition(
  transition: LandingTransitionReceipt,
  binding: LandingCompatibilityTargetBinding,
  projection: gunbc.scm_compatibility_shape.CompatibilityProjectionReceipt,
) -> LandingProjectionRelation {
  let semantic_target = transition.admitted.admission.semantic.closed_space.subject.ready_evidence.proposal.target
  if binding.semantic_target != semantic_target {
    LandingProjectionBindingRefused {
      cause: "the target binding names another semantic target",
    }
  } else if binding.native_target != projection.target {
    LandingProjectionBindingRefused {
      cause: "the projection names another native target",
    }
  } else {
    LandingProjectionBound {
      receipt: LandingProjectionOfAcceptedTransition {
        transition: transition,
        binding: binding,
        projection: projection,
      },
    }
  }
}

type LandingProjectionStatus
  = LandingProjected {
      receipt: LandingProjectionOfAcceptedTransition,
    }
  | LandingProjectionPending {
      transition: LandingTransitionReceipt,
      realization: gunbc.scm_compatibility_shape.CompatibilityRealizationHandle,
      target: LandingCompatibilityTargetBinding,
      cause: std.types.NonEmptyStr,
    }
  | LandingProjectionFailed {
      transition: LandingTransitionReceipt,
      realization: gunbc.scm_compatibility_shape.CompatibilityRealizationHandle,
      target: LandingCompatibilityTargetBinding,
      cause: std.types.NonEmptyStr,
    }

type LandingProjectionStatusFold<R> {
  projected: fn(LandingProjectionOfAcceptedTransition) -> R
  pending: fn(
    LandingTransitionReceipt,
    CompatibilityRealizationHandle,
    LandingCompatibilityTargetBinding,
    NonEmptyStr,
  ) -> R
  failed: fn(
    LandingTransitionReceipt,
    CompatibilityRealizationHandle,
    LandingCompatibilityTargetBinding,
    NonEmptyStr,
  ) -> R
}

fn landing_projection_status_fold<R>(
  status: LandingProjectionStatus,
  fold: LandingProjectionStatusFold<R>,
) -> R {
  match status {
    LandingProjected { receipt } =>
      fold.projected(receipt)
    LandingProjectionPending {
      transition,
      realization,
      target,
      cause,
    } =>
      fold.pending(transition, realization, target, cause)
    LandingProjectionFailed {
      transition,
      realization,
      target,
      cause,
    } =>
      fold.failed(transition, realization, target, cause)
  }
}

fn landing_projection_status_matches(
  status: LandingProjectionStatus,
  transition: LandingTransitionReceipt,
) -> Bool {
  landing_projection_status_fold(
    status: status,
    fold: LandingProjectionStatusFold {
      projected: fn(receipt) {
        receipt.transition == transition
      },
      pending: fn(projected, _, _, _) {
        projected == transition
      },
      failed: fn(projected, _, _, _) {
        projected == transition
      },
    },
  )
}

type LandingCommittedTransition {
  read_back: LandingIndependentReadBackReceipt
  projections: List<LandingProjectionStatus>
}

type LandingCommitAssembly
  = LandingCommitAssembled {
      committed: LandingCommittedTransition,
    }
  | LandingCommitRelationRefused {
      cause: std.types.NonEmptyStr,
    }

fn landing_committed_transition(
  observation: LandingReadBackObservation,
  projections: List<LandingProjectionStatus>,
) -> LandingCommitAssembly {
  let read_back = landing_independent_read_back(observation: observation)
  match read_back {
    LandingReadBackAuthorityRefused { observation: _ } =>
      LandingCommitRelationRefused {
        cause: "read-back did not use the independent authority frozen by admission",
      }
    LandingReadBackMismatched { observation: _ } =>
      LandingCommitRelationRefused {
        cause: "independent read-back did not observe the transition result",
      }
    LandingReadBackMatched { receipt } =>
      if all(projections, projection =>
        landing_projection_status_matches(
          status: projection,
          transition: receipt.observation.transition,
        )
      ) {
        LandingCommitAssembled {
          committed: LandingCommittedTransition {
            read_back: receipt,
            projections: projections,
          },
        }
      } else {
        LandingCommitRelationRefused {
          cause: "a compatibility projection belongs to another transition",
        }
      }
  }
}

type LandingTransitionOutcome
  = LandingCommitObserved {
      observation: LandingReadBackObservation,
      projections: List<LandingProjectionStatus>,
      continuation: LandingMachineContinuation,
    }
  | LandingRetryStaleParent {
      admitted: LandingAdmittedResult,
      continuation: LandingMachineContinuation,
    }
  | LandingEffectRetryPending {
      admitted: LandingAdmittedResult,
      continuation: LandingMachineContinuation,
    }
  | LandingEffectFailed {
      admitted: LandingAdmittedResult,
      refusal: LandingRefusal,
    }

type LandingSpineReceipt
  = LandingSemanticSpine {
      result: LandingSemanticResultSpace,
    }
  | LandingAdmissionSpine {
      admission: LandingAdmissionDecision,
    }
  | LandingTransitionSpine {
      transition: LandingTransitionOutcome,
    }

type LandingUserBoundary
  = LandingTerminal {
      outcome: gunbc.native_scm_interaction_contract.NativeScmTerminalOutcome,
    }
  | LandingMachineOwned {
      status: LandingAudienceStatus,
      continuation: LandingMachineContinuation,
    }

fn landing_machine_owned(
  continuation: LandingMachineContinuation,
) -> LandingUserBoundary {
  LandingMachineOwned {
    status: continuation.status,
    continuation: continuation,
  }
}

fn landing_user_refusal(
  refusal: LandingRefusal,
) -> LandingUserBoundary {
  LandingTerminal {
    outcome: gunbc.native_scm_interaction_contract.NativeScmTerminalCouldNotLand {
      refusal: landing_native_refusal(refusal: refusal),
    },
  }
}

fn landing_user_question(
  question: LandingNormativeQuestion,
) -> LandingUserBoundary {
  LandingTerminal {
    outcome: gunbc.native_scm_interaction_contract.NativeScmTerminalChoiceRequired {
      question: question.question as String,
      continuation: landing_question_continuation(question: question),
    },
  }
}

fn landing_semantic_user_boundary(
  semantic: LandingSemanticResultSpace,
) -> LandingUserBoundary {
  match semantic {
    LandingClosedZero {
      closed_space: _,
      incompatible_core: _,
      counterexample: _,
      disposition: LandingZeroTerminal { refusal },
    } =>
      landing_user_refusal(refusal: refusal)
    LandingClosedOne { receipt: _ } =>
      landing_machine_owned(
        continuation: LandingMachineContinuation {
          handle: "landing-prepare-admission",
          kind: LandingPrepareTransition,
          status: "checking whether the change may land",
        },
      )
    LandingClosedMany { receipt } =>
      landing_user_question(question: receipt.question)
    LandingUnclosed {
      proposal: _,
      cause: _,
      partial_results: _,
      disposition,
    } =>
      match disposition {
        LandingInvestigationContinues { continuation } =>
          landing_machine_owned(continuation: continuation)
        LandingEvidenceConflictContinues { continuation } =>
          landing_machine_owned(continuation: continuation)
        LandingUnclosedTerminal { refusal } =>
          landing_user_refusal(refusal: refusal)
      }
  }
}

fn landing_admission_user_boundary(
  admission: LandingAdmissionDecision,
) -> LandingUserBoundary {
  match admission {
    LandingAdmitted { receipt: _ } =>
      landing_machine_owned(
        continuation: LandingMachineContinuation {
          handle: "landing-prepare-transition",
          kind: LandingPrepareTransition,
          status: "preparing the accepted change to land",
        },
      )
    LandingApprovalRequired { semantic: _, continuation } =>
      landing_machine_owned(continuation: continuation)
    LandingUnauthorized { semantic: _, refusal } =>
      landing_user_refusal(refusal: refusal)
    LandingPolicyRefused { semantic: _, refusal } =>
      landing_user_refusal(refusal: refusal)
    LandingSelfAmendmentRefused { semantic: _, refusal } =>
      landing_user_refusal(refusal: refusal)
  }
}

fn landing_transition_user_boundary(
  transition: LandingTransitionOutcome,
) -> LandingUserBoundary {
  match transition {
    LandingCommitObserved {
      observation,
      projections,
      continuation,
    } =>
      match landing_committed_transition(
        observation: observation,
        projections: projections,
      ) {
        LandingCommitAssembled { committed } => {
          let preview = committed.read_back.observation.transition.admitted.admission.semantic.unique.preview
          LandingTerminal {
            outcome: gunbc.native_scm_interaction_contract.NativeScmTerminalLanded {
              result_preview: preview as String,
            },
          }
        }
        LandingCommitRelationRefused { cause: _ } =>
          landing_machine_owned(continuation: continuation)
      }
    LandingRetryStaleParent { admitted: _, continuation } =>
      landing_machine_owned(continuation: continuation)
    LandingEffectRetryPending { admitted: _, continuation } =>
      landing_machine_owned(continuation: continuation)
    LandingEffectFailed { admitted: _, refusal } =>
      landing_user_refusal(refusal: refusal)
  }
}

fn landing_user_boundary(
  receipt: LandingSpineReceipt,
) -> LandingUserBoundary {
  match receipt {
    LandingSemanticSpine { result } =>
      landing_semantic_user_boundary(semantic: result)
    LandingAdmissionSpine { admission } =>
      landing_admission_user_boundary(admission: admission)
    LandingTransitionSpine { transition } =>
      landing_transition_user_boundary(transition: transition)
  }
}

data landing_timestamp_non_authority_note: std.types.NonEmptyStr = "LandingProposalContract.submitted_at is provenance only. Evidence readiness, closed-space classification, admission, and transition never use it to establish precedence. Exact-parent validity is carried by LandingProposalContract.authored_parent inside the admitted result and checked again by the transition realization; it is not represented by a semantic closure certificate."
