module gunbc.source_integration_landing_spine

import std.types {
  Bool,
  ContentHash,
  List,
  NonEmptyStr,
  String,
  Timestamp,
}
import std.integer { PositiveInt }
import std.measure { Minute, minute }
import std.claim_evidence {
  ClaimId,
  ClaimReadinessAssessment,
  ClaimReadinessAssessmentFold,
  claim_readiness_assessment_fold,
}
import gunbc.native_scm_interaction_contract {
  NativeScmProposalIdentity,
  NativeScmContinuation,
  NativeScmContinuationOption,
  NativeScmContinuationOptions,
  NativeScmContinuationChoice,
  NativeScmContinuationChoiceLookupFold,
  NativeScmPrimaryOutcome,
  NativeScmRefusal,
  Landed,
  ChoiceRequired,
  CouldNotLand,
  native_scm_resolve_choice,
  native_scm_continuation_choice_lookup_fold,
}
import gunbc.scm_compatibility_shape {
  CompatibilityProjectionReceipt,
  CompatibilityRealizationHandle,
  CompatibilityTargetHandle,
}

data source_integration_landing_spine_note: NonEmptyStr = "P0 landing spine. This carrier is the first semantic consumer behind the landed C0 presentation fixture and R1 compatibility boundary. It keeps proposal contract, admitted claim assessments, bounded result-space classification, admission, transition, and projection status in separate layers, then projects them through one user boundary. Closed-one carries only a ready-evidence profile plus all eight closure receipts; admission consumes that closed-one receipt; transition consumes the admitted receipt; no later stage accepts an unrelated proposal or raw result. A normative question owns the proposal contract and derives its C0 continuation identity from that one authority; answers select the displayed option's structural position, so equal labels cannot collapse distinct resume tokens. A committed result is writable only together with independent read-back. Stale-parent, approval, retryable-effect, projection-repair, and unfinished-investigation states retain machine continuations and cannot become user questions. A terminal refusal is typed, located, counted, and also carries a plain explanation. This is an executing scenario model, not the P1 reconciliation kernel, P2 source capture, P3 effect transport, or a CLI."

type LandingProposalOccurrenceId = NonEmptyStr where brand("LandingProposalOccurrenceId")
type LandingAttemptId = NonEmptyStr where brand("LandingAttemptId")
type LandingTargetHandle = NonEmptyStr where brand("LandingTargetHandle")
type LandingAcceptedStateHandle = NonEmptyStr where brand("LandingAcceptedStateHandle")
type LandingTransformationHandle = NonEmptyStr where brand("LandingTransformationHandle")
type LandingFactHandle = NonEmptyStr where brand("LandingFactHandle")
type LandingScopeHandle = NonEmptyStr where brand("LandingScopeHandle")
type LandingActorAuthorityHandle = NonEmptyStr where brand("LandingActorAuthorityHandle")
type LandingResultHandle = NonEmptyStr where brand("LandingResultHandle")
type LandingContinuationHandle = NonEmptyStr where brand("LandingContinuationHandle")

type LandingAtomicity
  = LandingWholeProposalAtomic
  | LandingIndependentGroupsAllowed

type LandingProposalContract {
  occurrence: LandingProposalOccurrenceId
  attempt: LandingAttemptId
  target: LandingTargetHandle
  authored_parent: LandingAcceptedStateHandle
  transformation: LandingTransformationHandle
  reads_relies: List<LandingFactHandle>
  modifies_frame: List<LandingScopeHandle>
  ensures_guarantees: List<ClaimId>
  dependencies: List<LandingProposalOccurrenceId>
  atomicity: LandingAtomicity
  submit_authority: LandingActorAuthorityHandle
  submitted_at: Timestamp
}

fn landing_native_identity(
  proposal: LandingProposalContract,
) -> NativeScmProposalIdentity {
  NativeScmProposalIdentity {
    name: proposal.occurrence as String,
    attempt_key: proposal.attempt as String,
  }
}

type LandingStressProfile {
  agents_per_developer: PositiveInt
  overlapping_proposals: PositiveInt
  validation_path: Minute
}

data gunbc_landing_stress_profile: LandingStressProfile = LandingStressProfile {
  agents_per_developer: 50,
  overlapping_proposals: 10,
  validation_path: minute(count: 30),
}

type LandingEvidenceProfile {
  first_required: ClaimReadinessAssessment<ClaimId>
  remaining_required: List<ClaimReadinessAssessment<ClaimId>>
}

type LandingReadyEvidenceProfile {
  first_required: ClaimId
  remaining_required: List<ClaimId>
}

type LandingEvidenceReadiness
  = LandingEvidenceReady {
      profile: LandingReadyEvidenceProfile,
    }
  | LandingEvidenceBlocking {
      first_blocking: ClaimId,
    }

fn landing_evidence_readiness_start(
  assessment: ClaimReadinessAssessment<ClaimId>,
) -> LandingEvidenceReadiness {
  claim_readiness_assessment_fold(
    assessment: assessment,
    fold: ClaimReadinessAssessmentFold {
      satisfied: fn(claim) {
        LandingEvidenceReady {
          profile: LandingReadyEvidenceProfile {
            first_required: claim,
            remaining_required: [],
          },
        }
      },
      blocking: fn(claim) {
        LandingEvidenceBlocking {
          first_blocking: claim,
        }
      },
    },
  )
}

fn landing_evidence_readiness_step(
  readiness: LandingEvidenceReadiness,
  assessment: ClaimReadinessAssessment<ClaimId>,
) -> LandingEvidenceReadiness {
  claim_readiness_assessment_fold(
    assessment: assessment,
    fold: ClaimReadinessAssessmentFold {
      satisfied: fn(claim) {
        match readiness {
          LandingEvidenceReady { profile } =>
            LandingEvidenceReady {
              profile: LandingReadyEvidenceProfile {
                first_required: profile.first_required,
                remaining_required: append(
                  profile.remaining_required,
                  [claim],
                ),
              },
            }
          LandingEvidenceBlocking { first_blocking } =>
            LandingEvidenceBlocking {
              first_blocking: first_blocking,
            }
        }
      },
      blocking: fn(claim) {
        match readiness {
          LandingEvidenceReady { profile: _ } =>
            LandingEvidenceBlocking {
              first_blocking: claim,
            }
          LandingEvidenceBlocking { first_blocking } =>
            LandingEvidenceBlocking {
              first_blocking: first_blocking,
            }
        }
      },
    },
  )
}

fn landing_evidence_readiness(
  profile: LandingEvidenceProfile,
) -> LandingEvidenceReadiness {
  fold(
    profile.remaining_required,
    init: landing_evidence_readiness_start(
      assessment: profile.first_required,
    ),
    f: fn(readiness, assessment) {
      landing_evidence_readiness_step(
        readiness: readiness,
        assessment: assessment,
      )
    },
  )
}

type LandingClosureCertificate {
  receipt: ContentHash
}

type LandingClosureCertificates {
  capture_completeness: LandingClosureCertificate
  affected_scope: LandingClosureCertificate
  rule_closure: LandingClosureCertificate
  candidate_generation: LandingClosureCertificate
  admissibility: LandingClosureCertificate
  equivalence_quotient: LandingClosureCertificate
  multiplicity: LandingClosureCertificate
  commit_validity: LandingClosureCertificate
}

type LandingClosureCertificateKind
  = LandingCaptureCompletenessCertificate
  | LandingAffectedScopeCertificate
  | LandingRuleClosureCertificate
  | LandingCandidateGenerationCertificate
  | LandingAdmissibilityCertificate
  | LandingEquivalenceQuotientCertificate
  | LandingMultiplicityCertificate
  | LandingCommitValidityCertificate

type LandingClosureAttempt
  = LandingClosureComplete {
      certificates: LandingClosureCertificates,
    }
  | LandingClosureIncomplete {
      missing: LandingClosureCertificateKind,
      cause: NonEmptyStr,
    }

type LandingClosureAttemptFold<R> {
  complete: fn(LandingClosureCertificates) -> R
  incomplete: fn(LandingClosureCertificateKind, NonEmptyStr) -> R
}

fn landing_closure_attempt_fold<R>(
  attempt: LandingClosureAttempt,
  fold: LandingClosureAttemptFold<R>,
) -> R {
  match attempt {
    LandingClosureComplete { certificates } =>
      fold.complete(certificates)
    LandingClosureIncomplete { missing, cause } =>
      fold.incomplete(missing, cause)
  }
}

type LandingRefusalKind
  = LandingAuthorizationDenied
  | LandingPolicyDenied
  | LandingSelfAmendmentDenied
  | LandingBoundExhausted
  | LandingPermanentEffectFailure
  | LandingSemanticRequirementsIncompatible
  | LandingUnsupportedFragment

type LandingRefusal {
  kind: LandingRefusalKind
  locus: NonEmptyStr
  occurrences: PositiveInt
  cause: NonEmptyStr
  plain_reason: NonEmptyStr
  responsible_party: NonEmptyStr
  next_action: NonEmptyStr
  receipt: ContentHash
}

fn landing_native_refusal(
  refusal: LandingRefusal,
) -> NativeScmRefusal {
  NativeScmRefusal {
    plain_reason: refusal.plain_reason as String,
    responsible_party: refusal.responsible_party as String,
    next_action: refusal.next_action as String,
    refusal_receipt: refusal.receipt as String,
  }
}

type LandingMachineContinuationKind
  = LandingContinueInvestigation
  | LandingAwaitApproval
  | LandingRetryCurrentTarget
  | LandingRetryEffect
  | LandingRepairProjection
  | LandingPrepareTransition

type LandingMachineContinuation {
  handle: LandingContinuationHandle
  kind: LandingMachineContinuationKind
  status: NonEmptyStr
}

type LandingNormativeQuestion {
  proposal: LandingProposalContract
  question: NonEmptyStr
  options: NativeScmContinuationOptions
}

fn landing_question_continuation(
  question: LandingNormativeQuestion,
) -> NativeScmContinuation {
  NativeScmContinuation {
    proposal: landing_native_identity(proposal: question.proposal),
    options: question.options,
  }
}

type LandingChoiceResolution
  = LandingChoiceResumed {
      proposal: NativeScmProposalIdentity,
      resume_token: NonEmptyStr,
    }
  | LandingChoiceNotOffered {
      proposal: NativeScmProposalIdentity,
      choice: NativeScmContinuationChoice,
    }

fn landing_resolve_question(
  question: LandingNormativeQuestion,
  choice: NativeScmContinuationChoice,
) -> LandingChoiceResolution {
  let continuation = landing_question_continuation(question: question)
  native_scm_continuation_choice_lookup_fold(
    lookup: native_scm_resolve_choice(
      continuation: continuation,
      choice: choice,
    ),
    fold: NativeScmContinuationChoiceLookupFold {
      matched: fn(option) {
        LandingChoiceResumed {
          proposal: continuation.proposal,
          resume_token: option.resume_token,
        }
      },
      not_offered: fn(not_offered) {
        LandingChoiceNotOffered {
          proposal: continuation.proposal,
          choice: not_offered,
        }
      },
    },
  )
}

type LandingClosedZeroDisposition
  = LandingZeroNeedsNormativeChoice {
      question: LandingNormativeQuestion,
    }
  | LandingZeroTerminal {
      refusal: LandingRefusal,
    }

type LandingClosedZeroDispositionFold<R> {
  normative_choice: fn(LandingNormativeQuestion) -> R
  terminal: fn(LandingRefusal) -> R
}

fn landing_closed_zero_disposition_fold<R>(
  disposition: LandingClosedZeroDisposition,
  fold: LandingClosedZeroDispositionFold<R>,
) -> R {
  match disposition {
    LandingZeroNeedsNormativeChoice { question } =>
      fold.normative_choice(question)
    LandingZeroTerminal { refusal } =>
      fold.terminal(refusal)
  }
}

type LandingUnclosedCause
  = LandingRequiredClaimBlocking
  | LandingClosureCertificateMissing {
      certificate: LandingClosureCertificateKind,
      cause: NonEmptyStr,
    }
  | LandingSearchBoundExhausted {
      cause: NonEmptyStr,
    }

type LandingUnclosedDisposition
  = LandingInvestigationContinues {
      continuation: LandingMachineContinuation,
    }
  | LandingUnclosedTerminal {
      refusal: LandingRefusal,
    }

type LandingUnclosedDispositionFold<R> {
  investigation: fn(LandingMachineContinuation) -> R
  terminal: fn(LandingRefusal) -> R
}

fn landing_unclosed_disposition_fold<R>(
  disposition: LandingUnclosedDisposition,
  fold: LandingUnclosedDispositionFold<R>,
) -> R {
  match disposition {
    LandingInvestigationContinues { continuation } =>
      fold.investigation(continuation)
    LandingUnclosedTerminal { refusal } =>
      fold.terminal(refusal)
  }
}

type LandingUniqueResult {
  result: LandingResultHandle
  preview: NonEmptyStr
  closure: LandingClosureCertificates
  ready_obligations: LandingReadyEvidenceProfile
}

type LandingClosedOneReceipt {
  proposal: LandingProposalContract
  unique: LandingUniqueResult
}

type LandingSemanticResultSpace
  = LandingClosedZero {
      proposal: LandingProposalContract,
      witnessed_core: NonEmptyStr,
      counterexample: NonEmptyStr,
      disposition: LandingClosedZeroDisposition,
    }
  | LandingClosedOne {
      receipt: LandingClosedOneReceipt,
    }
  | LandingClosedMany {
      question: LandingNormativeQuestion,
    }
  | LandingUnclosed {
      proposal: LandingProposalContract,
      cause: LandingUnclosedCause,
      partial_results: List<LandingResultHandle>,
      disposition: LandingUnclosedDisposition,
    }

type LandingSemanticResultSpaceFold<R> {
  closed_zero: fn(
    LandingProposalContract,
    NonEmptyStr,
    NonEmptyStr,
    LandingClosedZeroDisposition,
  ) -> R
  closed_one: fn(LandingClosedOneReceipt) -> R
  closed_many: fn(LandingNormativeQuestion) -> R
  unclosed: fn(
    LandingProposalContract,
    LandingUnclosedCause,
    List<LandingResultHandle>,
    LandingUnclosedDisposition,
  ) -> R
}

fn landing_semantic_result_space_fold<R>(
  semantic: LandingSemanticResultSpace,
  fold: LandingSemanticResultSpaceFold<R>,
) -> R {
  match semantic {
    LandingClosedZero {
      proposal,
      witnessed_core,
      counterexample,
      disposition,
    } =>
      fold.closed_zero(
        proposal,
        witnessed_core,
        counterexample,
        disposition,
      )
    LandingClosedOne { receipt } =>
      fold.closed_one(receipt)
    LandingClosedMany { question } =>
      fold.closed_many(question)
    LandingUnclosed {
      proposal,
      cause,
      partial_results,
      disposition,
    } =>
      fold.unclosed(proposal, cause, partial_results, disposition)
  }
}

fn landing_unique_candidate(
  proposal: LandingProposalContract,
  result: LandingResultHandle,
  preview: NonEmptyStr,
  evidence: LandingEvidenceProfile,
  closure: LandingClosureAttempt,
  continuation: LandingMachineContinuation,
) -> LandingSemanticResultSpace {
  match landing_evidence_readiness(profile: evidence) {
    LandingEvidenceBlocking { first_blocking: _ } =>
      LandingUnclosed {
        proposal: proposal,
        cause: LandingRequiredClaimBlocking,
        partial_results: [result],
        disposition: LandingInvestigationContinues {
          continuation: continuation,
        },
      }
    LandingEvidenceReady { profile } =>
      landing_closure_attempt_fold(
        attempt: closure,
        fold: LandingClosureAttemptFold {
          complete: fn(certificates) {
            LandingClosedOne {
              receipt: LandingClosedOneReceipt {
                proposal: proposal,
                unique: LandingUniqueResult {
                  result: result,
                  preview: preview,
                  closure: certificates,
                  ready_obligations: profile,
                },
              },
            }
          },
          incomplete: fn(missing, cause) {
            LandingUnclosed {
              proposal: proposal,
              cause: LandingClosureCertificateMissing {
                certificate: missing,
                cause: cause,
              },
              partial_results: [result],
              disposition: LandingInvestigationContinues {
                continuation: continuation,
              },
            }
          },
        },
      )
  }
}

type LandingAdmissionDecision
  = LandingAdmitted {
      semantic: LandingClosedOneReceipt,
      receipt: ContentHash,
    }
  | LandingApprovalRequired {
      semantic: LandingClosedOneReceipt,
      continuation: LandingMachineContinuation,
    }
  | LandingUnauthorized {
      semantic: LandingClosedOneReceipt,
      refusal: LandingRefusal,
    }
  | LandingPolicyRefused {
      semantic: LandingClosedOneReceipt,
      refusal: LandingRefusal,
    }
  | LandingSelfAmendmentRefused {
      semantic: LandingClosedOneReceipt,
      refusal: LandingRefusal,
    }

type LandingAdmissionDecisionFold<R> {
  admitted: fn(LandingClosedOneReceipt, ContentHash) -> R
  approval_required: fn(
    LandingClosedOneReceipt,
    LandingMachineContinuation,
  ) -> R
  unauthorized: fn(LandingClosedOneReceipt, LandingRefusal) -> R
  policy_refused: fn(LandingClosedOneReceipt, LandingRefusal) -> R
  self_amendment_refused: fn(
    LandingClosedOneReceipt,
    LandingRefusal,
  ) -> R
}

fn landing_admission_decision_fold<R>(
  admission: LandingAdmissionDecision,
  fold: LandingAdmissionDecisionFold<R>,
) -> R {
  match admission {
    LandingAdmitted { semantic, receipt } =>
      fold.admitted(semantic, receipt)
    LandingApprovalRequired { semantic, continuation } =>
      fold.approval_required(semantic, continuation)
    LandingUnauthorized { semantic, refusal } =>
      fold.unauthorized(semantic, refusal)
    LandingPolicyRefused { semantic, refusal } =>
      fold.policy_refused(semantic, refusal)
    LandingSelfAmendmentRefused { semantic, refusal } =>
      fold.self_amendment_refused(semantic, refusal)
  }
}

type LandingAdmittedResult {
  semantic: LandingClosedOneReceipt
  admission_receipt: ContentHash
}

type LandingAdmissionAdvance
  = LandingAdmissionAdvanced {
      admitted: LandingAdmittedResult,
    }
  | LandingAdmissionNotAdvanced {
      decision: LandingAdmissionDecision,
    }

fn landing_admitted_result(
  admission: LandingAdmissionDecision,
) -> LandingAdmissionAdvance {
  landing_admission_decision_fold(
    admission: admission,
    fold: LandingAdmissionDecisionFold {
      admitted: fn(semantic, receipt) {
        LandingAdmissionAdvanced {
          admitted: LandingAdmittedResult {
            semantic: semantic,
            admission_receipt: receipt,
          },
        }
      },
      approval_required: fn(_, _) {
        LandingAdmissionNotAdvanced { decision: admission }
      },
      unauthorized: fn(_, _) {
        LandingAdmissionNotAdvanced { decision: admission }
      },
      policy_refused: fn(_, _) {
        LandingAdmissionNotAdvanced { decision: admission }
      },
      self_amendment_refused: fn(_, _) {
        LandingAdmissionNotAdvanced { decision: admission }
      },
    },
  )
}

type LandingProjectionStatus
  = LandingProjected {
      receipt: CompatibilityProjectionReceipt,
    }
  | LandingProjectionPending {
      realization: CompatibilityRealizationHandle,
      target: CompatibilityTargetHandle,
      cause: NonEmptyStr,
    }
  | LandingProjectionFailed {
      realization: CompatibilityRealizationHandle,
      target: CompatibilityTargetHandle,
      cause: NonEmptyStr,
    }

type LandingTransitionOutcome
  = LandingCommittedAndReadBack {
      admitted: LandingAdmittedResult,
      transition_receipt: ContentHash,
      independent_read_back: ContentHash,
      projections: List<LandingProjectionStatus>,
    }
  | LandingRetryStaleParent {
      admitted: LandingAdmittedResult,
      continuation: LandingMachineContinuation,
    }
  | LandingEffectRetryPending {
      admitted: LandingAdmittedResult,
      continuation: LandingMachineContinuation,
    }
  | LandingEffectFailed {
      admitted: LandingAdmittedResult,
      refusal: LandingRefusal,
    }

type LandingTransitionOutcomeFold<R> {
  committed: fn(
    LandingAdmittedResult,
    ContentHash,
    ContentHash,
    List<LandingProjectionStatus>,
  ) -> R
  retry_stale_parent: fn(
    LandingAdmittedResult,
    LandingMachineContinuation,
  ) -> R
  effect_retry_pending: fn(
    LandingAdmittedResult,
    LandingMachineContinuation,
  ) -> R
  effect_failed: fn(LandingAdmittedResult, LandingRefusal) -> R
}

fn landing_transition_outcome_fold<R>(
  transition: LandingTransitionOutcome,
  fold: LandingTransitionOutcomeFold<R>,
) -> R {
  match transition {
    LandingCommittedAndReadBack {
      admitted,
      transition_receipt,
      independent_read_back,
      projections,
    } =>
      fold.committed(
        admitted,
        transition_receipt,
        independent_read_back,
        projections,
      )
    LandingRetryStaleParent { admitted, continuation } =>
      fold.retry_stale_parent(admitted, continuation)
    LandingEffectRetryPending { admitted, continuation } =>
      fold.effect_retry_pending(admitted, continuation)
    LandingEffectFailed { admitted, refusal } =>
      fold.effect_failed(admitted, refusal)
  }
}

type LandingSpineReceipt
  = LandingSemanticSpine {
      result: LandingSemanticResultSpace,
    }
  | LandingAdmissionSpine {
      admission: LandingAdmissionDecision,
    }
  | LandingTransitionSpine {
      transition: LandingTransitionOutcome,
    }

type LandingSpineReceiptFold<R> {
  semantic: fn(LandingSemanticResultSpace) -> R
  admission: fn(LandingAdmissionDecision) -> R
  transition: fn(LandingTransitionOutcome) -> R
}

fn landing_spine_receipt_fold<R>(
  receipt: LandingSpineReceipt,
  fold: LandingSpineReceiptFold<R>,
) -> R {
  match receipt {
    LandingSemanticSpine {
      result,
    } =>
      fold.semantic(result)
    LandingAdmissionSpine {
      admission,
    } =>
      fold.admission(admission)
    LandingTransitionSpine {
      transition,
    } =>
      fold.transition(transition)
  }
}

type LandingUserBoundary
  = LandingUserOutcome {
      outcome: NativeScmPrimaryOutcome,
    }
  | LandingMachineOwned {
      status: NonEmptyStr,
      continuation: LandingMachineContinuation,
    }

fn landing_machine_owned(
  continuation: LandingMachineContinuation,
) -> LandingUserBoundary {
  LandingMachineOwned {
    status: continuation.status,
    continuation: continuation,
  }
}

fn landing_user_refusal(
  refusal: LandingRefusal,
) -> LandingUserBoundary {
  LandingUserOutcome {
    outcome: CouldNotLand {
      refusal: landing_native_refusal(refusal: refusal),
    },
  }
}

fn landing_user_question(
  question: LandingNormativeQuestion,
) -> LandingUserBoundary {
  LandingUserOutcome {
    outcome: ChoiceRequired {
      question: question.question as String,
      continuation: landing_question_continuation(question: question),
    },
  }
}

fn landing_closed_zero_user_boundary(
  disposition: LandingClosedZeroDisposition,
) -> LandingUserBoundary {
  landing_closed_zero_disposition_fold(
    disposition: disposition,
    fold: LandingClosedZeroDispositionFold {
      normative_choice: fn(question) {
        landing_user_question(question: question)
      },
      terminal: fn(refusal) {
        landing_user_refusal(refusal: refusal)
      },
    },
  )
}

fn landing_unclosed_user_boundary(
  disposition: LandingUnclosedDisposition,
) -> LandingUserBoundary {
  landing_unclosed_disposition_fold(
    disposition: disposition,
    fold: LandingUnclosedDispositionFold {
      investigation: fn(continuation) {
        landing_machine_owned(continuation: continuation)
      },
      terminal: fn(refusal) {
        landing_user_refusal(refusal: refusal)
      },
    },
  )
}

fn landing_semantic_user_boundary(
  semantic: LandingSemanticResultSpace,
) -> LandingUserBoundary {
  landing_semantic_result_space_fold(
    semantic: semantic,
    fold: LandingSemanticResultSpaceFold {
      closed_zero: fn(_, _, _, disposition) {
        landing_closed_zero_user_boundary(disposition: disposition)
      },
      closed_one: fn(_) {
        landing_machine_owned(
          continuation: LandingMachineContinuation {
            handle: "landing-prepare-admission",
            kind: LandingPrepareTransition,
            status: "checking whether the change may land",
          },
        )
      },
      closed_many: fn(question) {
        landing_user_question(question: question)
      },
      unclosed: fn(_, _, _, disposition) {
        landing_unclosed_user_boundary(disposition: disposition)
      },
    },
  )
}

fn landing_admission_user_boundary(
  admission: LandingAdmissionDecision,
) -> LandingUserBoundary {
  landing_admission_decision_fold(
    admission: admission,
    fold: LandingAdmissionDecisionFold {
      admitted: fn(_, _) {
        landing_machine_owned(
          continuation: LandingMachineContinuation {
            handle: "landing-prepare-transition",
            kind: LandingPrepareTransition,
            status: "preparing the accepted change to land",
          },
        )
      },
      approval_required: fn(_, continuation) {
        landing_machine_owned(continuation: continuation)
      },
      unauthorized: fn(_, refusal) {
        landing_user_refusal(refusal: refusal)
      },
      policy_refused: fn(_, refusal) {
        landing_user_refusal(refusal: refusal)
      },
      self_amendment_refused: fn(_, refusal) {
        landing_user_refusal(refusal: refusal)
      },
    },
  )
}

fn landing_committed_user_boundary(
  admitted: LandingAdmittedResult,
) -> LandingUserBoundary {
  LandingUserOutcome {
    outcome: Landed {
      result_preview: admitted.semantic.unique.preview as String,
    },
  }
}

fn landing_transition_user_boundary(
  transition: LandingTransitionOutcome,
) -> LandingUserBoundary {
  landing_transition_outcome_fold(
    transition: transition,
    fold: LandingTransitionOutcomeFold {
      committed: fn(admitted, _, _, _) {
        landing_committed_user_boundary(admitted: admitted)
      },
      retry_stale_parent: fn(_, continuation) {
        landing_machine_owned(continuation: continuation)
      },
      effect_retry_pending: fn(_, continuation) {
        landing_machine_owned(continuation: continuation)
      },
      effect_failed: fn(_, refusal) {
        landing_user_refusal(refusal: refusal)
      },
    },
  )
}

fn landing_user_boundary(
  receipt: LandingSpineReceipt,
) -> LandingUserBoundary {
  landing_spine_receipt_fold(
    receipt: receipt,
    fold: LandingSpineReceiptFold {
      semantic: fn(result) {
        landing_semantic_user_boundary(semantic: result)
      },
      admission: fn(admission) {
        landing_admission_user_boundary(admission: admission)
      },
      transition: fn(transition) {
        landing_transition_user_boundary(
          transition: transition,
        )
      },
    },
  )
}

data landing_timestamp_non_authority_note: NonEmptyStr = "LandingProposalContract.submitted_at is provenance only. landing_unique_candidate and landing_user_boundary do not read it. Target selection, semantic classification, admission, and transition order are carried by their own typed inputs; changing or permuting timestamps cannot change a result."
