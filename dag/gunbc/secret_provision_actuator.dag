module gunbc.secret_provision_actuator

import std.types { Bool, String, NonEmptyStr, FilePath, Secret }
import std.content_hash { Sha256Digest, sha256_hex_digest }
import extdeps.shell
import std.resources { Network }
import extdeps.cloud.gcp.secret_manager
import extdeps.cloud.gcp.secret_manager { SmResolvedVersionIdentity, sm_resolved_version_id, SmVersionIdProjected, SmVersionIdNotAVersionResource, encode_sm_access_version_payload_wire, decode_sm_access_version_secret_wire, SmAccessVersionSecretDecoded, SmAccessVersionSecretDecodeRefused }
import extdeps.cloud.gcp.gcp { GcpProjectId }
import extdeps.transports.rest { RestOk, RestStatusRefused, RestTransportRefused, RestBodyUndecodable }
import extdeps.filesystem.filesystem_io { Filesystem }
import extdeps.crypto.hash { Digest, Sha256, Sha512 }
import extdeps.tools.sha256sum { Sha256FileDigest, Sha256FileDigestUnavailable, sha256sum_file_digest_via_shell }
import gunbc.secret_provision { SecretProvisionAttemptIdentity }

// THE EFFECT-EARNED HALF OF PROVISIONING, KEPT IN ITS OWN MODULE BECAUSE THE SEAL IS THE POINT.
// gunbc.secret_provision decides what a receipt MEANS and refuses malformed ones; this module is the
// only place a receipt can be EARNED, because the values that authorize each write are
// sole_constructor types whose only producers are the effectful functions below. A seal proves who
// may mint, never that the value handed in was deserved, so the mint has to sit beside the effect.

// ONE SNAPSHOT, TWO DERIVATIONS -- THE ORDERING IS THE WHOLE CARRIER. The obvious shape is to hash
// the operator's file and then read that same path again to build the upload body. Those are two
// reads of a file that can change in between, so the digest would certify bytes the upload never
// sent: a time-of-check-to-time-of-use gap on the one value provisioning exists to guarantee. This
// product therefore holds a path THIS RUN OWNS and the digest OF THAT COPY, so every later step is
// denominated in the same bytes. printed_chassis's delivery lane already fixed this class for sliced
// payloads; the same move is owed here.
//
// The digest is Sha256Digest rather than extdeps.crypto.hash Digest deliberately, and the difference
// is load-bearing rather than stylistic. sha256sum_file_digest_via_shell splits stdout, checks the
// field is non-empty, and hands it to sha256_digest, which only STAMPS algorithm: Sha256 -- it never
// validates that the text is 64 lowercase hex characters. sha256_hex_digest is the wall that does,
// so routing through it is what turns a printed line into a checked digest.
// THE CARRIER HOLDS BYTES, NOT A PATH, AND THAT CHANGE IS THE POINT OF THE SECOND REVISION.
// It first held { path, expected }, which reads as safe and is not: sole_constructor seals the
// CARRIER, never the filesystem object it names. The digest was measured at one moment and
// AddVersion would have opened that path again later -- after a CreateSecret round trip -- so bytes
// B could occupy the path after digest A was taken, and the receipt would certify content the write
// never sent. Sealing a path is sealing a name.
//
// WHAT THIS DOES AND DOES NOT CLOSE, MEASURED RATHER THAN CLAIMED. The bytes are now frozen in the
// value, so every step after the snapshot is denominated in one immutable payload and no later read
// can drift. What it does NOT close is the snapshot itself: this tree has NO in-memory SHA-256 --
// sha256_hex_digest only validates hex and sha256_digest only stamps an algorithm, and the sole
// hashing operation is sha256sum DigestFile, over a FILE. So the digest and the bytes still come
// from two reads, and they cannot come from one until a value-level digest exists.
//
// The residual is therefore narrow rather than absent: two ADJACENT reads of a file inside a
// directory this run just created, instead of two reads separated by a network call. Calling that
// structurally closed would be exactly the rung inflation §4b names. NEXT-RUNG TRIGGER, stated as
// the capability and not as an artifact: a digest computed over a value, at which point the snapshot
// reads once and hashes what it holds.
type OwnedCredentialSnapshot sole_constructor {
  payload: Secret
  expected: Sha256Digest
}

fn snapshot_payload(s: OwnedCredentialSnapshot) -> Secret { s.payload }
fn snapshot_expected(s: OwnedCredentialSnapshot) -> Sha256Digest { s.expected }

// A REFUSAL THAT LEFT BYTES BEHIND IS A DIFFERENT OUTCOME FROM ONE THAT DID NOT, and the credential
// here is the operator's printer access code, so a copy this run failed to remove is a plaintext
// secret on disk. Collapsing the two would report the dangerous case in the safe one's words.
type CredentialSnapshotOutcome
  = CredentialSnapshotTaken { snapshot: OwnedCredentialSnapshot }
  | CredentialSnapshotRefused { cause: NonEmptyStr }
  | CredentialSnapshotRefusedResidueRemains { workspace: FilePath, cause: NonEmptyStr }

fn snapshot_refusal(workspace: FilePath, cause: NonEmptyStr) -> CredentialSnapshotOutcome {
  if shell.Remove.RecursiveForce(path: workspace).success {
    CredentialSnapshotRefused { cause: cause }
  } else {
    CredentialSnapshotRefusedResidueRemains { workspace: workspace, cause: cause }
  }
}

// THE ALGORITHM ARM IS GUARDED RATHER THAN ASSUMED. sha256sum_file_digest_via_shell is named for
// SHA-256 and stamps that algorithm itself, so matching on it looks like ceremony. It is not: the
// carrier it returns is the general Digest, whose other inhabitant is SHA-512, and a caller that
// pattern-matches only the arm it expects is how a widened producer becomes a silent mis-identity
// later. The cost is one arm; the alternative is trusting a name.
fn checked_digest(observed: Digest) -> Sha256Digest? {
  match observed.algorithm {
    Sha512 => none
    Sha256 => sha256_hex_digest(hex: observed.hex as String)
  }
}

func snapshot_credential(source: FilePath) -> CredentialSnapshotOutcome {
  let created = shell.Mktemp.Dir()
  if created.success == false {
    CredentialSnapshotRefused {
      cause: "no private directory could be created, so the credential could not be copied anywhere this run owns" as NonEmptyStr,
    }
  } else {
    {
      let workspace = created.path as FilePath
      let destination = concat(created.path as String, "/credential") as FilePath
      if shell.Copy.File(source: source, destination: destination).success == false {
        snapshot_refusal(
          workspace: workspace,
          cause: "the credential file could not be copied into this run's own materialization" as NonEmptyStr)
      } else {
        match sha256sum_file_digest_via_shell(path: destination as NonEmptyStr) {
          Sha256FileDigestUnavailable { path: _, reason: _ } =>
            snapshot_refusal(
              workspace: workspace,
              cause: "the owned copy could not be digested, so its content identity was never observed" as NonEmptyStr)
          Sha256FileDigest { digest: observed } =>
            match checked_digest(observed: observed) {
              Absent =>
                snapshot_refusal(
                  workspace: workspace,
                  cause: "sha256sum printed a digest that is not 64 lowercase hex characters, so it was never a SHA-256 identity" as NonEmptyStr)
              Present { value: checked } => {
                let contents = Filesystem.Read(path: destination as String)
                if contents.success == false {
                  snapshot_refusal(
                    workspace: workspace,
                    cause: "the owned copy was digested but could not be read, so no payload was captured" as NonEmptyStr)
                } else {
                  CredentialSnapshotTaken {
                    snapshot: OwnedCredentialSnapshot {
                      payload: contents.content as Secret,
                      expected: checked,
                    },
                  }
                }
              }
            }
        }
      }
    }
  }
}

// THE CAPABILITY THAT AUTHORIZES THE SECOND WRITE, AND WHY IT IS NOT AN OBSERVATION.
// gunbc.secret_provision once carried SecretContainerPresentAwaitingAttemptVersion, an arm of the
// OBSERVATION coproduct meaning "present and awaiting this attempt's version". No read of Secret
// Manager can establish that, so it was effect-earned history wearing an observation's name, and it
// was the only route around the Conflict refusal that a present container with no receipt correctly
// produces. It is deleted; this is what replaces it.
//
// THE CRASH PROPERTY FALLS OUT OF THE CONSTRUCTION RATHER THAN BEING MAINTAINED. This value is
// transient and unforgeable: only a successful CreateSecret mints it, and it does not outlive the
// process. If the actuator dies between the two writes, the capability is simply gone, and a restart
// can recover only SecretContainerPresent -- which authorizes nothing. So the rule "a restart must
// not relabel someone else's container as awaiting my version" needs no enforcement; there is no
// value in which to express the relabelling.
//
// ALL THREE FIELDS ARE LOAD-BEARING AND THE THIRD IS THE ONE EASILY MISSED. Carrying only "CreateSecret
// succeeded" would let a capability earned for attempt A against secret A be paired at the call site
// with a DIFFERENT payload, so the version written would not be the bytes whose digest the receipt
// goes on to certify. The capability therefore binds every fact the next write is entitled to
// consume: which attempt earned it, WHICH RESOURCE THE SERVICE ACTUALLY RETURNED rather than the one
// requested, and the expected identity derived from the owned snapshot.
// THE CAPABILITY CARRIES THE SNAPSHOT ITSELF, NOT A DIGEST OF IT, AND THAT IS WHAT MAKES THE
// BINDING REAL. Holding only the expected digest looks equivalent and is not: AddVersion still needs
// BYTES from somewhere, so its signature would have to take a second argument, and a caller could
// hand capability A together with snapshot B. The mismatch would then be discovered at read-back --
// after the non-idempotent write had already landed a version of the wrong credential.
//
// With the snapshot inside, the effect takes ONE argument and derives both the wire body and the
// expected identity from it. There is no second value for a caller to disagree with, so the pairing
// error is not detected late; it cannot be expressed.
type CreatedSecretForAttempt sole_constructor {
  attempt: SecretProvisionAttemptIdentity
  project: GcpProjectId
  secret_id: NonEmptyStr
  created_resource: NonEmptyStr
  snapshot: OwnedCredentialSnapshot
}

fn created_attempt(c: CreatedSecretForAttempt) -> SecretProvisionAttemptIdentity { c.attempt }
fn created_resource(c: CreatedSecretForAttempt) -> NonEmptyStr { c.created_resource }
fn created_project(c: CreatedSecretForAttempt) -> GcpProjectId { c.project }
fn created_secret_id(c: CreatedSecretForAttempt) -> NonEmptyStr { c.secret_id }
fn created_snapshot(c: CreatedSecretForAttempt) -> OwnedCredentialSnapshot { c.snapshot }

// AN AMBIGUOUS WRITE IS ITS OWN OUTCOME AND MUST NEVER BE RETRIED, which is the arm a caller is most
// tempted to fold into failure. extdeps.transports.rest RestTransportRefused reports that no response
// arrived -- but it covers BOTH a connection refused before the request was sent AND a timeout after
// it was transmitted, so it cannot distinguish "definitely not sent" from "outcome unknown". A
// CreateSecret may therefore be committed at the service while the caller learns nothing.
//
// Re-observing does not resolve it either, and that is the correction that matters: Secret Manager is
// strongly consistent ONLY for "add a version, then access that exact version number". Every other
// operation, GetSecret included, is eventually consistent. So a 404 taken after an ambiguous create
// does NOT establish absence and may not authorize a second CreateSecret. The honest arm names the
// ambiguity and stops, leaving a human to resolve what no automatic read can.
type SecretCreationOutcome
  = SecretCreatedForAttempt { capability: CreatedSecretForAttempt }
  | SecretCreationRefused { cause: NonEmptyStr }
  | SecretCreationOutcomeUnknown { cause: NonEmptyStr }

fn creation_outcome_name(o: SecretCreationOutcome) -> String {
  match o {
    SecretCreatedForAttempt { capability: _ } => "created"
    SecretCreationRefused { cause: _ } => "refused"
    SecretCreationOutcomeUnknown { cause: _ } => "unknown"
  }
}

// A REFUSAL AND AN UNKNOWN OUTCOME HAVE OPPOSITE REMEDIES, so a caller that collapses them is the
// defect this predicate exists to make expressible. A refusal may be retried once its cause is
// addressed; an unknown outcome may not be retried at all, because the write may already have landed.
fn creation_may_be_retried(o: SecretCreationOutcome) -> Bool {
  match o {
    SecretCreatedForAttempt { capability: _ } => false
    SecretCreationRefused { cause: _ } => true
    SecretCreationOutcomeUnknown { cause: _ } => false
  }
}

// THE GUARD, PULLED OUT OF THE EFFECT SO IT CAN BE WITNESSED. Left inline it was unreachable by any
// test in this tree, which is the inert-check shape §4b names: a wall nobody can prove stands. The
// question it answers is narrow and worth stating -- a capability minted from a resource that names
// a DIFFERENT secret would authorize the second write against a container this attempt never
// created, so the mismatch has to refuse rather than be carried forward.
fn created_resource_names_requested_secret(name: String, secret_id: NonEmptyStr) -> Bool {
  name.ends_with(concat("/secrets/", secret_id as String))
}

// THE FIRST WRITE. Its only job beyond creating the container is to decide which of three states the
// attempt is in, and the third is the one a caller is tempted not to have: an outcome nobody knows.
// A refused status is a decision the service made and reported; a transport refusal or an undecodable
// body means the request may have been committed while the answer was lost, and those may not be
// retried. Both of the latter therefore map to Unknown rather than to Refused.
func create_secret_for_attempt(
  attempt: SecretProvisionAttemptIdentity,
  project: GcpProjectId,
  secret_id: NonEmptyStr,
  snapshot: OwnedCredentialSnapshot,
  token: Secret,
) -> SecretCreationOutcome uses net: Network {
  let created = gcp.SecretManager.CreateSecret(
    access_token: token,
    project_id: project,
    secret_id: secret_id,
  )
  match created.outcome {
    RestOk =>
      if !created_resource_names_requested_secret(name: created.name, secret_id: secret_id) {
        SecretCreationRefused {
          cause: concat(
            "CreateSecret returned a resource that does not name the requested secret, so the capability would authorize a write against a different container: ",
            created.name) as NonEmptyStr,
        }
      } else {
        SecretCreatedForAttempt {
          capability: CreatedSecretForAttempt {
            attempt: attempt,
            project: project,
            secret_id: secret_id,
            created_resource: created.name as NonEmptyStr,
            snapshot: snapshot,
          },
        }
      }
    RestStatusRefused { status: _, body: body } =>
      SecretCreationRefused { cause: concat("the service refused to create the container: ", body) as NonEmptyStr }
    RestTransportRefused { cause: cause } =>
      SecretCreationOutcomeUnknown {
        cause: concat(
          "no response arrived for CreateSecret, so the container may or may not exist and a second create is not authorized: ",
          cause as String) as NonEmptyStr,
      }
    RestBodyUndecodable { status: _, cause: cause } =>
      SecretCreationOutcomeUnknown {
        cause: concat(
          "CreateSecret answered with a body this client could not decode, so the outcome is unread rather than known: ",
          cause as String) as NonEmptyStr,
      }
  }
}

// THE SECOND WRITE AND ITS READ-BACK, WHICH IS THE ONLY PART OF THIS FLOW THE SERVICE GUARANTEES.
// Secret Manager is strongly consistent for exactly one sequence -- add a version, then access THAT
// EXACT VERSION -- so the read-back takes the version identity the write returned and never "latest".
// gunbc.tools.bmc_onboard reads back "latest" today, which is wrong twice over: it is a moving target
// between the two calls, and it sits outside the single consistency guarantee the service offers.
//
// THE COMPARISON IS BYTES AGAINST BYTES, NOT DIGEST AGAINST DIGEST, and that is a strength rather
// than a shortcut. There is no in-memory digest in this tree, so digesting the read-back would mean
// writing it to a file to hash it -- more surface, and a second place for the bytes to live. The
// snapshot already holds the payload, so the strongest available check is direct equality with what
// came back.
type VersionAdditionOutcome
  = VersionAddedAndVerified { version: SmResolvedVersionIdentity }
  | VersionAdditionRefused { cause: NonEmptyStr }
  | VersionAdditionOutcomeUnknown { cause: NonEmptyStr }
  | VersionAddedButUnverified { version: SmResolvedVersionIdentity, cause: NonEmptyStr }

// A VERSION THAT LANDED AND FAILED ITS READ-BACK IS NOT A FAILURE TO WRITE, and collapsing it into
// one would be the more dangerous direction: the version EXISTS and holds content this attempt did
// not intend, so the remedy is to investigate and disable it, never to write again.
fn addition_outcome_name(o: VersionAdditionOutcome) -> String {
  match o {
    VersionAddedAndVerified { version: _ } => "verified"
    VersionAdditionRefused { cause: _ } => "refused"
    VersionAdditionOutcomeUnknown { cause: _ } => "unknown"
    VersionAddedButUnverified { version: _, cause: _ } => "unverified"
  }
}

fn addition_may_be_retried(o: VersionAdditionOutcome) -> Bool {
  match o {
    VersionAddedAndVerified { version: _ } => false
    VersionAdditionRefused { cause: _ } => true
    VersionAdditionOutcomeUnknown { cause: _ } => false
    VersionAddedButUnverified { version: _, cause: _ } => false
  }
}

// THE SECOND WRITE, TAKING ONE ARGUMENT ON PURPOSE. The tempting signature threads the resource, the
// payload and the digest separately, and that shape is exactly what lets a caller pair bytes with a
// digest taken over different bytes -- the failure the snapshot carrier exists to make unwritable.
// Passing the capability whole means the container, the payload and the digest all arrived from one
// create, so there is no argument position in which they can disagree.
//
// THE RESIDUAL, STATED RATHER THAN HIDDEN: AccessVersion declares no RestOutcome, so a transport
// failure on the READ-BACK aborts instead of yielding VersionAddedButUnverified. That arm is still
// reachable -- a version whose identity does not project, or bytes that come back different -- so the
// variant is not decorative; but the read-back's own transport failure is currently outside the
// modelled outcome. Its next-rung trigger is an `outcome: RestOutcome` on AccessVersion, which is a
// change to every existing reader of that operation and is deliberately not made here.
//
// THE READ-BACK ADDRESSES THE EXACT VERSION THE WRITE RETURNED. Add a version, then access THAT
// version, is the one sequence Secret Manager documents as strongly consistent. Reading "latest"
// instead is wrong twice over -- it is a moving target between the two calls, and it sits outside
// the single guarantee the service offers -- and that is the defect standing in
// gunbc.tools.bmc_onboard today, on the live BMC credential path.
func add_initial_version(
  capability: CreatedSecretForAttempt,
  token: Secret,
) -> VersionAdditionOutcome uses net: Network {
  let added = gcp.SecretManager.AddVersion(
    access_token: token,
    secret_name: created_resource(capability) as String,
    payload_b64: encode_sm_access_version_payload_wire(credential: snapshot_payload(capability.snapshot)),
  )
  match added.outcome {
    RestStatusRefused { status: _, body: body } =>
      VersionAdditionRefused { cause: concat("the service refused to add the initial version: ", body) as NonEmptyStr }
    RestTransportRefused { cause: cause } =>
      VersionAdditionOutcomeUnknown {
        cause: concat(
          "no response arrived for AddVersion, so a version may already hold this payload and a second add is not authorized: ",
          cause as String) as NonEmptyStr,
      }
    RestBodyUndecodable { status: _, cause: cause } =>
      VersionAdditionOutcomeUnknown {
        cause: concat(
          "AddVersion answered with a body this client could not decode, so the outcome is unread rather than known: ",
          cause as String) as NonEmptyStr,
      }
    RestOk =>
      match sm_resolved_version_id(identity: added.name) {
        SmVersionIdNotAVersionResource { supplied: supplied } =>
          VersionAddedButUnverified {
            version: added.name,
            cause: concat(
              "AddVersion reported success but its resource does not name a version, so the exact-version read-back cannot be addressed: ",
              supplied) as NonEmptyStr,
          }
        SmVersionIdProjected { version: version } => {
          let seen = gcp.SecretManager.AccessVersion(
            access_token: token,
            project_id: created_project(capability),
            secret: created_secret_id(capability),
            version: version,
          )
          match decode_sm_access_version_secret_wire(data_b64: seen.data_b64) {
            SmAccessVersionSecretDecodeRefused { cause: _ } =>
              VersionAddedButUnverified {
                version: added.name,
                cause: "the version was added but its payload did not decode on read-back, so the stored bytes are unconfirmed" as NonEmptyStr,
              }
            SmAccessVersionSecretDecoded { credential: credential } =>
              if credential == snapshot_payload(capability.snapshot) {
                VersionAddedAndVerified { version: added.name }
              } else {
                VersionAddedButUnverified {
                  version: added.name,
                  cause: "the version was added but reads back as different bytes, so it holds content this attempt did not intend and must be disabled rather than rewritten" as NonEmptyStr,
                }
              }
          }
        }
      }
  }
}
