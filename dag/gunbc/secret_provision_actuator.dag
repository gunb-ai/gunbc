module gunbc.secret_provision_actuator

import std.types { Bool, String, NonEmptyStr, FilePath }
import std.content_hash { Sha256Digest, sha256_hex_digest }
import extdeps.shell
import extdeps.crypto.hash { Digest, Sha256, Sha512 }
import extdeps.tools.sha256sum { Sha256FileDigest, Sha256FileDigestUnavailable, sha256sum_file_digest_via_shell }
import gunbc.secret_provision { SecretProvisionAttemptIdentity }

// THE EFFECT-EARNED HALF OF PROVISIONING, KEPT IN ITS OWN MODULE BECAUSE THE SEAL IS THE POINT.
// gunbc.secret_provision decides what a receipt MEANS and refuses malformed ones; this module is the
// only place a receipt can be EARNED, because the values that authorize each write are
// sole_constructor types whose only producers are the effectful functions below. A seal proves who
// may mint, never that the value handed in was deserved, so the mint has to sit beside the effect.

// ONE SNAPSHOT, TWO DERIVATIONS -- THE ORDERING IS THE WHOLE CARRIER. The obvious shape is to hash
// the operator's file and then read that same path again to build the upload body. Those are two
// reads of a file that can change in between, so the digest would certify bytes the upload never
// sent: a time-of-check-to-time-of-use gap on the one value provisioning exists to guarantee. This
// product therefore holds a path THIS RUN OWNS and the digest OF THAT COPY, so every later step is
// denominated in the same bytes. printed_chassis's delivery lane already fixed this class for sliced
// payloads; the same move is owed here.
//
// The digest is Sha256Digest rather than extdeps.crypto.hash Digest deliberately, and the difference
// is load-bearing rather than stylistic. sha256sum_file_digest_via_shell splits stdout, checks the
// field is non-empty, and hands it to sha256_digest, which only STAMPS algorithm: Sha256 -- it never
// validates that the text is 64 lowercase hex characters. sha256_hex_digest is the wall that does,
// so routing through it is what turns a printed line into a checked digest.
type OwnedCredentialSnapshot sole_constructor {
  path: FilePath
  expected: Sha256Digest
}

fn snapshot_path(s: OwnedCredentialSnapshot) -> FilePath { s.path }
fn snapshot_expected(s: OwnedCredentialSnapshot) -> Sha256Digest { s.expected }

// A REFUSAL THAT LEFT BYTES BEHIND IS A DIFFERENT OUTCOME FROM ONE THAT DID NOT, and the credential
// here is the operator's printer access code, so a copy this run failed to remove is a plaintext
// secret on disk. Collapsing the two would report the dangerous case in the safe one's words.
type CredentialSnapshotOutcome
  = CredentialSnapshotTaken { snapshot: OwnedCredentialSnapshot }
  | CredentialSnapshotRefused { cause: NonEmptyStr }
  | CredentialSnapshotRefusedResidueRemains { workspace: FilePath, cause: NonEmptyStr }

fn snapshot_refusal(workspace: FilePath, cause: NonEmptyStr) -> CredentialSnapshotOutcome {
  if shell.Remove.RecursiveForce(path: workspace).success {
    CredentialSnapshotRefused { cause: cause }
  } else {
    CredentialSnapshotRefusedResidueRemains { workspace: workspace, cause: cause }
  }
}

// THE ALGORITHM ARM IS GUARDED RATHER THAN ASSUMED. sha256sum_file_digest_via_shell is named for
// SHA-256 and stamps that algorithm itself, so matching on it looks like ceremony. It is not: the
// carrier it returns is the general Digest, whose other inhabitant is SHA-512, and a caller that
// pattern-matches only the arm it expects is how a widened producer becomes a silent mis-identity
// later. The cost is one arm; the alternative is trusting a name.
fn checked_digest(observed: Digest) -> Sha256Digest? {
  match observed.algorithm {
    Sha512 => none
    Sha256 => sha256_hex_digest(hex: observed.hex as String)
  }
}

func snapshot_credential(source: FilePath) -> CredentialSnapshotOutcome {
  let created = shell.Mktemp.Dir()
  if created.success == false {
    CredentialSnapshotRefused {
      cause: "no private directory could be created, so the credential could not be copied anywhere this run owns" as NonEmptyStr,
    }
  } else {
    {
      let workspace = created.path as FilePath
      let destination = concat(created.path as String, "/credential") as FilePath
      if shell.Copy.File(source: source, destination: destination).success == false {
        snapshot_refusal(
          workspace: workspace,
          cause: "the credential file could not be copied into this run's own materialization" as NonEmptyStr)
      } else {
        match sha256sum_file_digest_via_shell(path: destination as NonEmptyStr) {
          Sha256FileDigestUnavailable { path: _, reason: _ } =>
            snapshot_refusal(
              workspace: workspace,
              cause: "the owned copy could not be digested, so its content identity was never observed" as NonEmptyStr)
          Sha256FileDigest { digest: observed } =>
            match checked_digest(observed: observed) {
              Absent =>
                snapshot_refusal(
                  workspace: workspace,
                  cause: "sha256sum printed a digest that is not 64 lowercase hex characters, so it was never a SHA-256 identity" as NonEmptyStr)
              Present { value: checked } =>
                CredentialSnapshotTaken {
                  snapshot: OwnedCredentialSnapshot { path: destination, expected: checked },
                }
            }
        }
      }
    }
  }
}

// THE CAPABILITY THAT AUTHORIZES THE SECOND WRITE, AND WHY IT IS NOT AN OBSERVATION.
// gunbc.secret_provision once carried SecretContainerPresentAwaitingAttemptVersion, an arm of the
// OBSERVATION coproduct meaning "present and awaiting this attempt's version". No read of Secret
// Manager can establish that, so it was effect-earned history wearing an observation's name, and it
// was the only route around the Conflict refusal that a present container with no receipt correctly
// produces. It is deleted; this is what replaces it.
//
// THE CRASH PROPERTY FALLS OUT OF THE CONSTRUCTION RATHER THAN BEING MAINTAINED. This value is
// transient and unforgeable: only a successful CreateSecret mints it, and it does not outlive the
// process. If the actuator dies between the two writes, the capability is simply gone, and a restart
// can recover only SecretContainerPresent -- which authorizes nothing. So the rule "a restart must
// not relabel someone else's container as awaiting my version" needs no enforcement; there is no
// value in which to express the relabelling.
//
// ALL THREE FIELDS ARE LOAD-BEARING AND THE THIRD IS THE ONE EASILY MISSED. Carrying only "CreateSecret
// succeeded" would let a capability earned for attempt A against secret A be paired at the call site
// with a DIFFERENT payload, so the version written would not be the bytes whose digest the receipt
// goes on to certify. The capability therefore binds every fact the next write is entitled to
// consume: which attempt earned it, WHICH RESOURCE THE SERVICE ACTUALLY RETURNED rather than the one
// requested, and the expected identity derived from the owned snapshot.
type CreatedSecretForAttempt sole_constructor {
  attempt: SecretProvisionAttemptIdentity
  created_resource: NonEmptyStr
  expected: Sha256Digest
}

fn created_attempt(c: CreatedSecretForAttempt) -> SecretProvisionAttemptIdentity { c.attempt }
fn created_resource(c: CreatedSecretForAttempt) -> NonEmptyStr { c.created_resource }
fn created_expected(c: CreatedSecretForAttempt) -> Sha256Digest { c.expected }

// AN AMBIGUOUS WRITE IS ITS OWN OUTCOME AND MUST NEVER BE RETRIED, which is the arm a caller is most
// tempted to fold into failure. extdeps.transports.rest RestTransportRefused reports that no response
// arrived -- but it covers BOTH a connection refused before the request was sent AND a timeout after
// it was transmitted, so it cannot distinguish "definitely not sent" from "outcome unknown". A
// CreateSecret may therefore be committed at the service while the caller learns nothing.
//
// Re-observing does not resolve it either, and that is the correction that matters: Secret Manager is
// strongly consistent ONLY for "add a version, then access that exact version number". Every other
// operation, GetSecret included, is eventually consistent. So a 404 taken after an ambiguous create
// does NOT establish absence and may not authorize a second CreateSecret. The honest arm names the
// ambiguity and stops, leaving a human to resolve what no automatic read can.
type SecretCreationOutcome
  = SecretCreatedForAttempt { capability: CreatedSecretForAttempt }
  | SecretCreationRefused { cause: NonEmptyStr }
  | SecretCreationOutcomeUnknown { cause: NonEmptyStr }

fn creation_outcome_name(o: SecretCreationOutcome) -> String {
  match o {
    SecretCreatedForAttempt { capability: _ } => "created"
    SecretCreationRefused { cause: _ } => "refused"
    SecretCreationOutcomeUnknown { cause: _ } => "unknown"
  }
}

// A REFUSAL AND AN UNKNOWN OUTCOME HAVE OPPOSITE REMEDIES, so a caller that collapses them is the
// defect this predicate exists to make expressible. A refusal may be retried once its cause is
// addressed; an unknown outcome may not be retried at all, because the write may already have landed.
fn creation_may_be_retried(o: SecretCreationOutcome) -> Bool {
  match o {
    SecretCreatedForAttempt { capability: _ } => false
    SecretCreationRefused { cause: _ } => true
    SecretCreationOutcomeUnknown { cause: _ } => false
  }
}
