module gunbc.parse_verdict_restore

import std.types { Bool, String, NonEmptyStr }
import std.optional { Present }
import std.dissolution { DissolutionCondition, unbound_dissolution }
import extdeps.languages.yaml.types { yaml_string, kv }
import extdeps.github.actions { Step, RunStep, UsesStep, github_event_name_pull_request }
import gunbc.action_use_admission { cache_restore_action }
import gunbc.ci.ci_failure_class { wrap_command_is_renderable, wrap_command_with_floor_attempt_receipt }
import v2.cli.population_verb_names { cli_verb_parse_population }
import gunbc.parse_verdict_schema {
  parse_verdict_request_family,
  parse_compiler_sha_identity_cache_key,
}
import gunbc.parse_verdict_publish {
  materialization_gha_cache_key_prefix,
  parse_verdict_compiler_expr,
  parse_verdict_generation_one_bin,
  parse_verdict_identity_blob_file,
  parse_verdict_receipts_file,
  parse_verdict_publish_memory_env,
  source_root_argv,
}

// POLICY: pull_request heads restore a default-branch blob and never save
// (extdeps.cache.github_actions gha_cache_entry_restorable_by).
//
// TRANSITION: PRs based on a main sha older than PR-1's first main publish of
// gunbc-parse-identity-<sha> refuse BaseIdentityUnobserved (typed, names base.sha)
// until they merge main. The identity write is PR-1; this module only restores
// and consumes. Paths match gunbc.parse_verdict_publish: runner.temp identity
// file, receipts file, generation-one argv — never a second blob directory.

data parse_verdict_pr2_pre_identity_publish_transition: String = "PRs based on a main sha older than the first main publish of gunbc-parse-identity-<sha> (PR-1 landing) refuse BaseIdentityUnobserved until they merge main; the refusal is typed and names base.sha."
fn materialization_restore_if() -> String {
  join(["github.event_name == '", github_event_name_pull_request, "'"], "")
}

data parse_verdict_identity_restore_step_id: String = "restore_parse_compiler_sha_identity"
data parse_verdict_identity_restore_step_name: String = "Restore parse-compiler identity for base.sha"
data parse_verdict_restore_step_id: String = "restore_parse_verdicts"
data parse_verdict_restore_step_name: String = "Restore parse-verdict receipts for base.sha"
data parse_verdict_restore_consume_step_name: String = "Reuse or walk parse-verdict receipts"
data parse_verdict_cache_hit_output: String = "cache-hit"

fn parse_verdict_restore_exact_key() -> String {
  join(
    [
      materialization_gha_cache_key_prefix(family: parse_verdict_request_family),
      parse_verdict_compiler_expr(),
      "-${{ github.event.pull_request.base.sha }}"
    ],
    ""
  )
}

fn parse_verdict_identity_restore_step() -> Step {
  UsesStep {
    name: Present { value: parse_verdict_identity_restore_step_name },
    id: Present { value: parse_verdict_identity_restore_step_id },
    uses: cache_restore_action,
    with: Present {
      value: [
        kv(key: "path", value: yaml_string(s: parse_verdict_identity_blob_file)),
        kv(key: "key", value: yaml_string(s: parse_compiler_sha_identity_cache_key(sha: "${{ github.event.pull_request.base.sha }}")))
      ]
    },
    env: none,
    if_condition: Present { value: materialization_restore_if() },
    continue_on_error: none,
    timeout_minutes: none
  }
}

fn parse_verdict_restore_step() -> Step {
  UsesStep {
    name: Present { value: parse_verdict_restore_step_name },
    id: Present { value: parse_verdict_restore_step_id },
    uses: cache_restore_action,
    with: Present {
      value: [
        kv(key: "path", value: yaml_string(s: parse_verdict_receipts_file)),
        kv(key: "key", value: yaml_string(s: parse_verdict_restore_exact_key()))
      ]
    },
    env: none,
    if_condition: Present { value: materialization_restore_if() },
    continue_on_error: none,
    timeout_minutes: none
  }
}

data parse_verdict_restore_shell_emit_dissolution_text: NonEmptyStr = "dissolve-on: parse_verdict_restore_consume_step -- hand-shell of parse_verdict_reuse_from. DISSOLVES WHEN v2.workflow.ci_workflow_run_emit renders this from modeled bash_build statements."
data parse_verdict_restore_shell_emit_dissolution_trigger: DissolutionCondition = unbound_dissolution(description: parse_verdict_restore_shell_emit_dissolution_text)

fn parse_verdict_restore_consume_command() -> String {
  join(
    [
      "set -o pipefail",
      "base_sha=\"${{ github.event.pull_request.base.sha }}\"",
      join(["idhit=\"${{ steps.", parse_verdict_identity_restore_step_id, ".outputs.", parse_verdict_cache_hit_output, " }}\""], ""),
      join(["hit=\"${{ steps.", parse_verdict_restore_step_id, ".outputs.", parse_verdict_cache_hit_output, " }}\""], ""),
      join(["bin=\"", parse_verdict_generation_one_bin(), "\""], ""),
      join(["compiler=\"", parse_verdict_compiler_expr(), "\""], ""),
      "if [ -z \"$bin\" ] || [ ! -x \"$bin\" ] || [ -z \"$compiler\" ]; then echo \"::error::IdentityUnknown: parser identity or generation-one executable missing after emit-build\"; exit 1; fi",
      join(["idfile=\"", parse_verdict_identity_blob_file, "\""], ""),
      join(["receipts=\"", parse_verdict_receipts_file, "\""], ""),
      "if [ \"$idhit\" != \"true\" ] || [ ! -s \"$idfile\" ]; then echo \"::error::BaseIdentityUnobserved: no parse-compiler identity for base.sha=$base_sha\"; exit 1; fi",
      "i_base=$(cat \"$idfile\")",
      join(
        [
          "if [ \"$compiler\" != \"$i_base\" ]; then \"$bin\" ",
          cli_verb_parse_population,
          " --compiler \"$compiler\" --receipts \"$receipts\"",
          source_root_argv(),
          "; echo \"parse-verdict reuse=FreshIdentityWalked compiler=$compiler\"; elif [ \"$hit\" = \"true\" ] && [ -s \"$receipts\" ]; then echo \"parse-verdict reuse=Reused compiler=$compiler\"; else echo \"::error::EvictedRefused: I_head equals I_base but receipts for base.sha=$base_sha are missing or empty\"; exit 1; fi"
        ],
        ""
      )
    ],
    "; "
  )
}

fn parse_verdict_restore_consume_step() -> Step {
  RunStep {
    name: Present { value: parse_verdict_restore_consume_step_name },
    id: none,
    run: wrap_command_with_floor_attempt_receipt(command: parse_verdict_restore_consume_command()),
    shell: none,
    env: Present { value: parse_verdict_publish_memory_env() },
    working_directory: none,
    if_condition: Present { value: materialization_restore_if() },
    continue_on_error: none,
    timeout_minutes: none
  }
}

fn parse_verdict_restore_script_is_renderable() -> Bool {
  wrap_command_is_renderable(command: parse_verdict_restore_consume_command())
}
