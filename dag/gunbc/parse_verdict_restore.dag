module gunbc.parse_verdict_restore

import std.types { String, List, Int }
import std.algebra { fold_list }
import std.integer { int_to_decimal_string }
import v2.std.node { Node }
import v2.std.diagnostic { Outcome, Accepted, Rejected }
import v2.workflow.bash_emit { bash_emit_stmts }
import v2.extdeps.languages.bash_build {
  bash_build_word_lit, bash_build_word_var, bash_build_word_cmdsubst, bash_build_word_concat_from_nodes,
  bash_build_assign, bash_build_pipe, bash_build_command_with_words, bash_build_or_else,
  bash_build_command_from_lits, bash_build_with_redir_to_file,
}
import std.optional { Present }
import extdeps.languages.yaml.types { YamlKeyValue, yaml_string, kv }
import extdeps.github.actions { Step, RunStep, UsesStep }
import gunbc.action_use_admission { cache_restore_action }
import v2.cli.population_verb_names { cli_verb_parse_population }
import extdeps.cache.github_actions { GhaCachePullRequestMergeRefScope }
import extdeps.github.expressions {
  Expression,
  ContextAccess,
  Github,
  Steps,
  ExpressionTemplate,
  Interpolation,
  serialize_expression,
  serialize_template,
  runner_temp,
}
import gunbc.parse_verdict_schema {
  parse_verdict_request_family,
  parse_compiler_sha_identity_cache_key,
  parse_verdict_restore_identity_basename,
  parse_verdict_restore_receipts_basename,
  parse_verdict_restore_ancestors_basename,
  parse_verdict_restore_ancestor_ordinals,
  parse_verdict_restore_slot_basename,
}
import gunbc.parse_verdict_publish {
  materialization_gha_cache_key_prefix,
  materialization_scope_guard,
  parse_verdict_compiler_expr,
  parse_verdict_generation_one_bin,
  parse_verdict_identity_blob_file,
  parse_verdict_receipts_file,
  parse_verdict_publish_memory_env,
  source_root_argv,
}

// THE PULL-REQUEST SIDE OF THE PARSE-VERDICT CACHE (gunbc.parse_verdict_publish is the main side).
// A pull-request run restores the two entries main saved for base.sha, then walks the population
// with `--reuse-from`; the verb (v2.cli.parse_verdict_reuse) reads them and decides each module's
// standing. NOTHING HERE DECIDES REUSE: a restore that found no entry leaves no file, and the verb
// reads that as a typed miss (MissIdentityAbsent / MissEntryAbsent), so eviction is a re-parse and
// never a pass and never an error (DESIGN.md section 5). The restore keys are exact; there are no
// restore-keys, because a prefix hit would be a near identity and reuse is exact or it is a miss.
//
// The guard is derived from the pull-request scope in the cache model, as the publisher's is from the
// default-branch scope, so the two sides cannot both fire on one event.

data parse_verdict_locate_step_name: String = "Locate first-parent ancestors of base.sha"
data parse_verdict_locate_step_id: String = "parse_ancestors"
data parse_verdict_reuse_walk_step_name: String = "Walk parse-population reusing the nearest published ancestor's receipts"

fn parse_verdict_restore_if() -> String {
  serialize_expression(expression: materialization_scope_guard(scope: GhaCachePullRequestMergeRefScope))
}

fn pull_request_base_sha_expr() -> String {
  serialize_template(template: ExpressionTemplate {
    segments: [Interpolation {
      expression: ContextAccess { context: Github, path: ["event", "pull_request", "base", "sha"] }
    }]
  })
}

fn parse_verdict_ordinal_output(ordinal: Int) -> String {
  join(["a", int_to_decimal_string(value: ordinal)], "")
}

fn parse_verdict_ancestor_sha_expr(ordinal: Int) -> String {
  serialize_template(template: ExpressionTemplate {
    segments: [Interpolation {
      expression: ContextAccess {
        context: Steps,
        path: [parse_verdict_locate_step_id, "outputs", parse_verdict_ordinal_output(ordinal: ordinal)]
      }
    }]
  })
}

fn parse_verdict_restore_receipts_key(ordinal: Int) -> String {
  join(
    [
      materialization_gha_cache_key_prefix(family: parse_verdict_request_family),
      parse_verdict_compiler_expr(),
      "-",
      parse_verdict_ancestor_sha_expr(ordinal: ordinal)
    ],
    ""
  )
}

// THE LOCATOR: the first-parent ancestors of the base, newest first, to the declared ordinals, each
// written as a step output (the restore keys read them) and appended to the record the verb reads to
// name the ancestor it used. The script is a bash node tree emitted through bash_emit, as the
// release-bins runners are; no shell is authored here. A `git rev-list` that cannot answer (a
// base sha outside the checkout) leaves the output empty, and an empty sha is a key no entry carries,
// so the restore is a typed miss rather than a failed required job.
fn parse_verdict_lit(t: String) -> Node { bash_build_word_lit(text: t) }
fn parse_verdict_var(n: String) -> Node { bash_build_word_var(name: n) }
fn parse_verdict_words(ws: List<Node>) -> Node { bash_build_word_concat_from_nodes(parts: ws) }

fn parse_verdict_tee_append(line: Node, path: Node) -> Node {
  bash_build_with_redir_to_file(
    inner: bash_build_pipe(
      left: bash_build_command_with_words(words: [parse_verdict_lit(t: "echo"), line]),
      right: bash_build_command_with_words(words: [parse_verdict_lit(t: "tee"), parse_verdict_lit(t: "-a"), path])
    ),
    path: parse_verdict_lit(t: "/dev/null")
  )
}

fn parse_verdict_locate_statements(ordinal: Int) -> List<Node> {
  let variable = join(["ANCESTOR_", int_to_decimal_string(value: ordinal)], "")
  [
    bash_build_or_else(
      left: bash_build_assign(
        name: variable,
        value: bash_build_word_cmdsubst(body: bash_build_command_with_words(words: [
          parse_verdict_lit(t: "git"),
          parse_verdict_lit(t: "rev-list"),
          parse_verdict_lit(t: "--first-parent"),
          parse_verdict_lit(t: join(["--skip=", int_to_decimal_string(value: ordinal)], "")),
          parse_verdict_lit(t: "--max-count=1"),
          parse_verdict_var(n: "BASE_SHA")
        ]))
      ),
      right: bash_build_command_from_lits(lits: ["true"])
    ),
    parse_verdict_tee_append(
      line: parse_verdict_words(ws: [parse_verdict_lit(t: join([parse_verdict_ordinal_output(ordinal: ordinal), "="], "")), parse_verdict_var(n: variable)]),
      path: parse_verdict_var(n: "GITHUB_OUTPUT")
    ),
    parse_verdict_tee_append(
      line: parse_verdict_var(n: variable),
      path: parse_verdict_words(ws: [parse_verdict_var(n: "RUNNER_TEMP"), parse_verdict_lit(t: join(["/", parse_verdict_restore_ancestors_basename], ""))])
    )
  ]
}

data parse_verdict_locate_unemittable_marker: String = "__GUNBC_PARSE_VERDICT_LOCATE_UNEMITTABLE__"

fn parse_verdict_locate_script() -> String {
  match bash_emit_stmts(
    statements: fold_list(xs: parse_verdict_restore_ancestor_ordinals, empty: [], cons: fn(acc, ordinal) { concat(acc, parse_verdict_locate_statements(ordinal: ordinal)) }),
    set_e: true
  ) {
    Accepted { value: v, diagnostics: _ } => v
    Rejected { diagnostics: _ } => parse_verdict_locate_unemittable_marker
  }
}

fn parse_verdict_locate_step() -> Step {
  RunStep {
    name: Present { value: parse_verdict_locate_step_name },
    id: Present { value: parse_verdict_locate_step_id },
    run: parse_verdict_locate_script(),
    shell: none,
    env: Present { value: [kv(key: "BASE_SHA", value: yaml_string(s: pull_request_base_sha_expr()))] },
    working_directory: none,
    if_condition: Present { value: parse_verdict_restore_if() },
    continue_on_error: none,
    timeout_minutes: none
  }
}

fn parse_verdict_slot_path(basename: String, ordinal: Int) -> String {
  join([runner_temp_text(), "/", parse_verdict_restore_slot_basename(basename: basename, ordinal: ordinal)], "")
}

fn runner_temp_text() -> String {
  serialize_template(template: ExpressionTemplate { segments: [Interpolation { expression: runner_temp() }] })
}

fn parse_verdict_cache_restore_step(name: String, path: String, cache_key: String) -> Step {
  UsesStep {
    name: Present { value: name },
    id: none,
    uses: cache_restore_action,
    with: Present {
      value: [
        kv(key: "path", value: yaml_string(s: path)),
        kv(key: "key", value: yaml_string(s: cache_key))
      ]
    },
    env: none,
    if_condition: Present { value: parse_verdict_restore_if() },
    continue_on_error: none,
    timeout_minutes: none
  }
}

fn parse_verdict_identity_restore_step_name(ordinal: Int) -> String {
  join(["Restore parse-compiler identity for base ancestor ", int_to_decimal_string(value: ordinal)], "")
}

fn parse_verdict_receipts_restore_step_name(ordinal: Int) -> String {
  join(["Restore parse-verdict receipts for base ancestor ", int_to_decimal_string(value: ordinal)], "")
}

fn parse_verdict_identity_restore_step(ordinal: Int) -> Step {
  parse_verdict_cache_restore_step(
    name: parse_verdict_identity_restore_step_name(ordinal: ordinal),
    path: parse_verdict_slot_path(basename: parse_verdict_restore_identity_basename, ordinal: ordinal),
    cache_key: parse_compiler_sha_identity_cache_key(sha: parse_verdict_ancestor_sha_expr(ordinal: ordinal))
  )
}

fn parse_verdict_receipts_restore_step(ordinal: Int) -> Step {
  parse_verdict_cache_restore_step(
    name: parse_verdict_receipts_restore_step_name(ordinal: ordinal),
    path: parse_verdict_slot_path(basename: parse_verdict_restore_receipts_basename, ordinal: ordinal),
    cache_key: parse_verdict_restore_receipts_key(ordinal: ordinal)
  )
}

fn parse_verdict_reuse_command() -> String {
  join(
    [
      parse_verdict_generation_one_bin(),
      " ",
      cli_verb_parse_population,
      " --compiler ",
      parse_verdict_compiler_expr(),
      " --reuse-from ",
      serialize_template(template: ExpressionTemplate { segments: [Interpolation { expression: runner_temp() }] }),
      source_root_argv()
    ],
    ""
  )
}

fn parse_verdict_reuse_walk_step() -> Step {
  RunStep {
    name: Present { value: parse_verdict_reuse_walk_step_name },
    id: none,
    run: concat(parse_verdict_reuse_command(), "\n"),
    shell: none,
    env: Present { value: parse_verdict_publish_memory_env() },
    working_directory: none,
    if_condition: Present { value: parse_verdict_restore_if() },
    continue_on_error: none,
    timeout_minutes: none
  }
}
