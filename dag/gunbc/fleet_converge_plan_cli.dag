module gunbc.fleet_converge_plan_cli

import std.types { String, List, Bool, NonEmptyStr, Int }
import std.process { ProcessExit, ExitSuccess, ExitFailure, exit_failure }
import std.resources { Network }
import std.algebra { trim }
import std.content_hash { serialize_content_hash }
import extdeps.filesystem.filesystem_io { Filesystem }
import extdeps.exec.command { ArgvCommand, LocalExec }
import gunbc.command_runner { run_shell_command_capture, run_shell_commands }
import gunbc.host_axis_caps { CapMember, caps_managed_dropin_paths }
import gunbc.fleet_converge_plan {
  TimerRetirementMember,
  fleet_converge_plan_artifact,
  fleet_converge_plan_body_path,
  fleet_converge_plan_baseline_hex_path,
  fleet_converge_plan_apply_shell_path,
  fleet_converge_plan_content_hash_path,
  fleet_converge_plan_subject_host_path,
  fleet_converge_plan_generation_path,
  fleet_converge_plan_prior_generation_path,
  fleet_converge_plan_member_set_fp_path,
  fleet_converge_plan_artifact_dir,
  fleet_converge_plan_content_hash,
  fleet_converge_observed_baseline_matches,
  fleet_converge_member_set_fingerprint_matches,
  timer_retirement_observed_legacy_srv1,
  fleet_converge_generation_store_path,
  fleet_converge_locked_apply_script,
  fleet_converge_parse_nonneg_generation_text,
  fleet_converge_generation_from_store_content,
  fleet_converge_plan_bundle_digest_hex,
  fleet_converge_plan_bundle_matches,
  fleet_converge_plan_content_hash_path,
  fleet_converge_spark_serving_typed_actions_wire,
}

data fleet_converge_plan_spark_typed_actions_wire_path: String = "/tmp/fleet-converge-plan/spark_serving_typed_actions.wire"

data fleet_converge_plan_cli_note: String = "Wet CLI for on-demand fleet converge plan/apply (sleek-heron-218). Plan observes the host, runs membership_reconcile once, names the subject (host + member-set fingerprint), mints a std.temporal_effect LeaseEpoch generation in the artifact, and writes the human-readable plan plus apply.sh. plan_content.hex is the Fnv1a64Structural bundle digest of plan.txt + apply.sh + spark_serving_typed_actions.wire (empty wire on non-Spark hosts); on success plan_wet prints plan.txt then that digest for workflow_dispatch plan_artifact_hash. Apply re-observes subject identity and observed-baseline fingerprint in .dag, refuses unless on-disk plan.txt + apply.sh + spark wire match plan_content.hex, then runs fleet_converge_locked_apply_script under flock. Generation store reads refuse corrupt or negative values; a missing store file is generation 0."

// STATED, NOT SILENTLY DEFAULTED. This value KEYS THE CONVERGE PLAN's subject identity, so a
// hostname that could not be read must not become "" and flow into a plan named for the wrong
// host. The old code took .stdout straight off the call expression -- no binding, so there was
// not even a variable a later author could think to check.
//
// WHAT THIS DOES AND DOES NOT FIX, stated because the residue is real. A `-> String` function
// has no way to refuse: the substrate offers no abort from this position, so the only honest
// options are to change the return type or to return a value. This returns a value that CANNOT
// BE MISTAKEN FOR A HOSTNAME -- deliberately implausible rather than plausibly empty -- so a
// plan keyed on it is visibly wrong at a glance instead of silently wrong forever. That is
// strictly better than "" and is still not a refusal.
//
// RUNG: mitigatable, not fixed. The conflation is surfaced, not closed. NEXT-RUNG TRIGGER: this
// function returns an optional (or a typed outcome) and its two callers handle the absent case;
// that cascades into plan subject identity, which is a different change from this migration and
// deliberately not attempted inside it.
//
// SECOND ROW, SEPARATE FROM THE ONE ABOVE BECAUSE ITS REACHABILITY IS DIFFERENT AND WORSE. The
// row above says the value is visibly wrong rather than plausibly empty. It does NOT say the
// value dies before it is recorded, and it does not: fleet_converge_plan_wet WRITES host_short
// verbatim to fleet_converge_plan_subject_host_path, coerces it to NonEmptyStr as the plan's
// subject host, and folds it into the member-set fingerprint and the plan content hash. So an
// unobserved hostname IS PERSISTED as a receipt that later reads as fact.
//
// AND IT DEFEATS THE GUARD THAT EXISTS TO CATCH EXACTLY THIS. fleet_converge_apply_wet re-observes
// the host and refuses on SubjectHostMismatch when observed != planned. Two consecutive refusals
// produce the SAME string, so the comparison SUCCEEDS and apply proceeds -- the check whose whole
// purpose is to stop a plan being applied on the wrong host is satisfied by two non-observations
// agreeing with each other. That is the empty-observation narrow at the guard: bottom == bottom
// read as "same host". Making the marker unique per call would NOT fix it -- it would convert a
// false match into a false mismatch, which is a different wrong answer, not an observation.
//
// NOT INTRODUCED HERE, AND SAYING SO PRECISELY: the prior code persisted "" and compared "" == "",
// which passed identically. The defect predates this migration and this migration does not repair
// it -- it makes the persisted evidence legible instead of blank. Rung: mitigatable. NEXT-RUNG
// TRIGGER: the subject-host comparison consumes an outcome rather than a String, so that
// unobserved-vs-unobserved is a REFUSAL to compare and not an equality.
func observe_host_short_wet() -> String
  uses net: Network
{
  match run_shell_command_capture(
    command: ArgvCommand { argv: ["hostname", "-s"] },
    transport: LocalExec,
  ) {
    ProcessOutputPresent { text: t } => trim(s: t)
    ProcessOutputAbsent => "(hostname-unreadable: admitted but printed nothing)"
    ProcessRefused { exit_code: _, stderr: _ } => "(hostname-unreadable: probe refused)"
  }
}

func observe_generation_store_wet() -> Int?
  uses net: Network
{
  let read = Filesystem.Read(path: fleet_converge_generation_store_path)
  fleet_converge_generation_from_store_content(store_present: read.success, content: read.content)
}

func observe_timer_members_wet() -> List<TimerRetirementMember>
  uses net: Network
{
  let legacy = timer_retirement_observed_legacy_srv1()
  filter(legacy, m =>
    // EXIT STATUS IS THE PRODUCT HERE and there is no stdout anyone wants, so this asks the
    // two-state question directly instead of matching three arms, two of which would be
    // indistinguishable to it. Forcing `test -f` through an output-bearing variant would add a
    // field it cannot answer -- cosmetic richness in the opposite direction.
    process_outcome_admitted(
      outcome: run_shell_command_capture(
        command: ArgvCommand { argv: ["test", "-f", concat("/etc/systemd/system/", m.unit_name as String)] },
        transport: LocalExec,
      )
    )
  )
}

func observe_cap_members_wet() -> List<CapMember>
  uses net: Network
{
  flat_map(caps_managed_dropin_paths, path => {
    let read = Filesystem.Read(path: path as String)
    if read.success {
      [CapMember { dropin_path: path, content: read.content }]
    } else {
      []
    }
  })
}

func fleet_converge_plan_wet() -> ProcessExit
  uses net: Network
{
  let host_short = observe_host_short_wet()
  let host = host_short as NonEmptyStr
  match observe_generation_store_wet() {
    Absent =>
      exit_failure(reason: "fleet_converge_plan: generation store unreadable or corrupt — refuse, do not coerce to 0")
    Present { value: prior_generation } => {
  let observed_timers = observe_timer_members_wet()
  let observed_caps = observe_cap_members_wet()
  match fleet_converge_plan_artifact(
    host: host,
    prior_generation: prior_generation,
    observed_timers: observed_timers,
    observed_caps: observed_caps,
  ) {
    Absent =>
      exit_failure(reason: "fleet_converge_plan: observed baseline is not Fnv1a64Structural — plan refused")
    Present { value: artifact } =>
      match fleet_converge_plan_bundle_digest_hex(
        plan_body: artifact.plan_body,
        apply_shell: artifact.apply_shell,
        spark_typed_actions_wire: fleet_converge_spark_serving_typed_actions_wire(
          rows: artifact.spark_serving_typed_actions,
        ),
      ) {
        Absent =>
          exit_failure(reason: "fleet_converge_plan: plan bundle hash is not Fnv1a64Structural — plan refused")
        Present { value: content_hash } => {
          let planned_generation = prior_generation + 1
          let spark_wire = fleet_converge_spark_serving_typed_actions_wire(
            rows: artifact.spark_serving_typed_actions,
          )
          let mkdir = run_shell_commands(
            commands: [ArgvCommand { argv: ["mkdir", "-p", fleet_converge_plan_artifact_dir] }],
            transport: LocalExec,
          )
          match mkdir {
            ExitFailure { code: _, reason: why } =>
              exit_failure(reason: concat("fleet_converge_plan: mkdir refused: ", why))
            ExitSuccess => {
              let w_plan = Filesystem.Write(path: fleet_converge_plan_body_path, content: artifact.plan_body)
              let w_base = Filesystem.Write(
                path: fleet_converge_plan_baseline_hex_path,
                content: artifact.observed_baseline_hex,
              )
              let w_hash = Filesystem.Write(path: fleet_converge_plan_content_hash_path, content: content_hash)
              let w_apply = Filesystem.Write(path: fleet_converge_plan_apply_shell_path, content: artifact.apply_shell)
              let w_host = Filesystem.Write(path: fleet_converge_plan_subject_host_path, content: host_short)
              let w_gen = Filesystem.Write(
                path: fleet_converge_plan_generation_path,
                content: to_string(planned_generation),
              )
              let w_prior = Filesystem.Write(
                path: fleet_converge_plan_prior_generation_path,
                content: to_string(prior_generation),
              )
              let w_member_fp = Filesystem.Write(
                path: fleet_converge_plan_member_set_fp_path,
                content: serialize_content_hash(hash: artifact.subject.member_set_fingerprint) as String,
              )
              let w_spark_wire = Filesystem.Write(
                path: fleet_converge_plan_spark_typed_actions_wire_path,
                content: spark_wire,
              )
              if w_plan.success
                && w_base.success
                && w_hash.success
                && w_apply.success
                && w_host.success
                && w_gen.success
                && w_prior.success
                && w_member_fp.success
                && w_spark_wire.success {
                run_shell_commands(
                  commands: [
                    ArgvCommand { argv: ["chmod", "0755", fleet_converge_plan_apply_shell_path] },
                    ArgvCommand { argv: ["cat", fleet_converge_plan_body_path] },
                    ArgvCommand { argv: ["cat", fleet_converge_plan_content_hash_path] },
                  ],
                  transport: LocalExec,
                )
              } else {
                exit_failure(reason: "fleet_converge_plan: artifact write refused")
              }
            }
          }
        }
      }
    }
  }
  }
}

func fleet_converge_apply_wet() -> ProcessExit
  uses net: Network
{
  let read_plan = Filesystem.Read(path: fleet_converge_plan_body_path)
  let read_base = Filesystem.Read(path: fleet_converge_plan_baseline_hex_path)
  let read_host = Filesystem.Read(path: fleet_converge_plan_subject_host_path)
  let read_prior = Filesystem.Read(path: fleet_converge_plan_prior_generation_path)
  let read_gen = Filesystem.Read(path: fleet_converge_plan_generation_path)
  let read_member_fp = Filesystem.Read(path: fleet_converge_plan_member_set_fp_path)
  let read_apply = Filesystem.Read(path: fleet_converge_plan_apply_shell_path)
  let read_hash = Filesystem.Read(path: fleet_converge_plan_content_hash_path)
  let read_spark_wire = Filesystem.Read(path: fleet_converge_plan_spark_typed_actions_wire_path)
  if !read_plan.success
    || !read_base.success
    || !read_host.success
    || !read_prior.success
    || !read_gen.success
    || !read_member_fp.success
    || !read_apply.success
    || !read_hash.success
    || !read_spark_wire.success {
    exit_failure(reason: "fleet_converge_apply: plan artifact missing — run plan first")
  } else {
    let host_short = observe_host_short_wet()
    let observed_host = trim(s: read_host.content) as NonEmptyStr
    match fleet_converge_parse_nonneg_generation_text(content: read_prior.content) {
      Absent =>
        exit_failure(reason: "fleet_converge_apply: prior_generation artifact corrupt — refuse, do not coerce to 0")
      Present { value: prior_generation } =>
        match fleet_converge_parse_nonneg_generation_text(content: read_gen.content) {
          Absent =>
            exit_failure(reason: "fleet_converge_apply: planned_generation artifact corrupt — refuse, do not coerce to 0")
          Present { value: planned_generation } => {
            if trim(s: host_short) != trim(s: read_host.content) {
              exit_failure(
                reason: concat(
                  "fleet_converge_apply: SubjectHostMismatch planned=",
                  trim(s: read_host.content),
                  concat(" observed=", host_short),
                ),
              )
            } else {
              let observed_timers = observe_timer_members_wet()
              let observed_caps = observe_cap_members_wet()
              if !fleet_converge_member_set_fingerprint_matches(
                planned_fingerprint_text: read_member_fp.content,
                host: observed_host,
                observed_timers: observed_timers,
                observed_caps: observed_caps,
              ) {
                exit_failure(reason: "fleet_converge_apply: SubjectIdentityMismatch — member set drifted since plan")
              } else if !fleet_converge_observed_baseline_matches(
                host: observed_host,
                observed_baseline_hex: trim(s: read_base.content),
                observed_timers: observed_timers,
                observed_caps: observed_caps,
              ) {
                exit_failure(reason: "fleet_converge_apply: ObservedBaselineMismatch — host drifted since plan; rerun plan and review")
              } else if !fleet_converge_plan_bundle_matches(
                plan_body: read_plan.content,
                apply_shell: read_apply.content,
                spark_typed_actions_wire: trim(s: read_spark_wire.content),
                claimed_hex: read_hash.content,
              ) {
                exit_failure(
                  reason: "fleet_converge_apply: PlanArtifactHashMismatch — the plan.txt + apply.sh + spark_serving_typed_actions.wire bundle does not match plan_content.hex (a plan artifact minted before the typed-actions wire joined the bundle will not match)",
                )
              } else {
                run_shell_commands(
                  commands: [
                    ArgvCommand {
                      argv: [
                        "bash",
                        "-c",
                        fleet_converge_locked_apply_script(
                          prior_generation: prior_generation,
                          planned_generation: planned_generation,
                          apply_shell_path: fleet_converge_plan_apply_shell_path,
                        ),
                      ],
                    },
                  ],
                  transport: LocalExec,
                )
              }
            }
          }
        }
      }
  }
}
