module gunbc.design_truth

import std.types { Bool, Int, NonEmptyStr, String }
import std.algebra { Empty, FreeMonoid }
import v2.std.algebra {
  HeadAbsent,
  HeadFound,
  any,
  length,
  list_head,
  list_snoc_item,
}
import v2.std.optional { Optional, Present, Absent }
import std.content_hash {
  Fnv1a64Structural,
  content_hash_combine_structural,
  content_hash_eq_structural,
  content_hash_tagged_structural,
}
import std.decl_ref { DeclarationRef }
import gunbc.roadmap_model { RoadmapNodeIdentity }
import v2.lens.module_graph {
  ModuleDeclarationFact,
  ModuleDependencyEdge,
  dependency_closure,
}
import v2.std.decl_index { DeclFact }
import v2.std.decl_ref_resolution {
  DeclarationIdentity,
  DeclarationRefResolution,
  DeclarationRefResolved,
  DeclarationRefModuleAbsent,
  DeclarationRefDeclarationAbsent,
  DeclarationRefFieldAbsent,
  DeclarationRefAmbiguous,
  resolve_declaration_ref,
}
import v2.std.node { Node, content_hash }

data design_truth_authority_note: String = "MUTABLE DOCUMENTARY STANDING IS DERIVED HERE OR IT IS NOT WRITTEN AT ALL. The repository already GENERATES its documents -- DESIGN.md, ROADMAP.md and every registered plan are GeneratedArtifact rows with a byte-drift wall -- and that wall proves only that checked-in Markdown equals prose stored in .dag. It does not prove the prose equals the standing of the implementation, which is why generation has not stopped staleness: gunbc.design_document builds its sections from literal p(text:) and li(text:) strings, so a sentence there can become false without any file it describes being touched, and no oracle in this repository sees it.\n\nTHE MEASURED LEDGER THAT PRODUCED THIS CARRIER (2026-08-08). A discharged prerequisite still described as a gate nearly commissioned a slice that was not needed. A landed keystone still described as future work nearly caused existing machinery to be rebuilt. A superseded numbered sequence stayed canonical in the design authority after the roadmap copy was corrected. Two of those sentences sat in ONE generated document beside correct ones, indistinguishable by any mechanism.\n\nWHY A LENS OVER PROSE IS THE WRONG ANSWER, with an in-tree receipt. gunbc.roadmap_authority already polices TicketFields.current_state with a token blacklist -- witness_authority_contains_no_mutable_execution_ledger refuses the substrings 'PR #', 'session/' and 'CI run'. It is merged, green, and structurally incapable of catching 'this prerequisite remains open' when the prerequisite is closed, because the false claim contains none of those tokens and an author can always spell one that does not. Recognising staleness in English infers semantics AFTER the false claim was made writable. The wall recognises the CONSTRUCTOR instead: a migrated section can build durable rationale or a typed projection, and cannot build a status sentence at all (DESIGN 5 construction before validation).\n\nWHAT THIS MODULE OWNS: subject identity, the contract digest, the realization binding, and the 0/1/many standing fold. It stores no status field and no rendered standing string, so a transcribed standing is unrepresentable rather than lens-caught -- the exclusion gunbc.native_witness_transition_receipt established for one subject, generalized on its SECOND inhabitant exactly as that module's generalization trigger named."

data design_subject_identity_non_fork_law: String = "A SUBJECT THAT IS A COMMITTED DELIVERABLE CARRIES THE ROADMAP NODE IDENTITY ITSELF. It does not carry a parallel key that must be kept in step with one, because this repository already has four subject key spaces -- RoadmapNodeIdentity, Plan.slug, and HandAuthoredDocBind.home+slug which gunbc.doc_graph_roots states is deliberately 'the same key space as Plan.slug' -- and a fifth minted here would be the DESIGN 3 nicknaming failure committed by the very program built to prevent it. The near-miss is on record: WitnessExecutionClass was drafted in prose beside the live WitnessExecutionDisposition vocabulary and caught before it hardened.\n\nTHE CUT IS SCHEDULED VERSUS UNSCHEDULED, and it is a real distinction rather than a hedge. A roadmap node is a COMMITTED DELIVERABLE; a design subject may be a consequence of the axioms that nobody has scheduled, and forcing such a subject to mint a roadmap row would corrupt the roadmap's own meaning -- its active set is declared minus accepted, so an unschedulable row could never leave it. DeliverableSubject therefore WRAPS RoadmapNodeIdentity with no second key, and UnscheduledDesignSubjectIdentity exists only for subjects with no deliverable. There is no representation for a scheduled subject with its own independent key, so the two cannot drift: the fork is unwritable, not witnessed."

type UnscheduledDesignSubjectIdentity = NonEmptyStr where brand("UnscheduledDesignSubjectIdentity")

type DesignSubjectIdentity
  = DeliverableSubject { node: RoadmapNodeIdentity }
  | UnscheduledSubject { identity: UnscheduledDesignSubjectIdentity }

fn design_subject_identity_key(subject: DesignSubjectIdentity) -> String {
  match subject {
    DeliverableSubject { node } => node as String
    UnscheduledSubject { identity } => identity as String
  }
}

fn design_subject_identity_eq(left: DesignSubjectIdentity, right: DesignSubjectIdentity) -> Bool {
  match left {
    DeliverableSubject { node: l } =>
      match right {
        DeliverableSubject { node: r } => (l as String) == (r as String)
        UnscheduledSubject { identity: _ } => false
      }
    UnscheduledSubject { identity: l } =>
      match right {
        DeliverableSubject { node: _ } => false
        UnscheduledSubject { identity: r } => (l as String) == (r as String)
      }
  }
}

data design_contract_stub_note: String = "THE CONTRACT EXISTS BEFORE THE IMPLEMENTATION, AND THAT IS THE WHOLE TEMPORAL POINT. If the implementation were the design authority there would be no source of truth before it lands, and every pre-implementation sentence would have to be prose again. A DesignContract names a typed requirement declaration -- a capability type, an interface, a closed set of required states, a signature -- which may be minimal but must be structural. It does not pretend the implementation exists: with no realization the derived standing is DesignDeclared, and the SAME subject reads DesignRealized once one lands, with no sentence edited anywhere."

type DesignContract {
  subject: DesignSubjectIdentity
  requirement: DeclarationRef
}

data design_contract_digest_derivation_note: String = "THE DIGEST IS THE REQUIREMENT DECLARATION'S OWN STRUCTURE, NOT AN AUTHORED REVISION NUMBER. gunbc.roadmap_model roadmap_criteria_digest hashes authored prose criteria, which is correct there because the criteria ARE prose. Here the contract is a declaration, so its content hash is v2.std.node content_hash over the declaration's Node -- strengthen the contract by editing that declaration and the digest moves by construction. A hand-bumped revision field would have been the change-detector DESIGN 5 rejects: automating its update collapses the assertion to measure() == measure().\n\nUNRESOLVABLE REFUSES RATHER THAN FABRICATING. An absent, ambiguous, or field-absent requirement yields ContractRequirementUnreadable carrying the typed resolution arm, never a digest over nothing -- a fabricated digest would make every realization read current against a contract that does not exist, which is the fail-open this whole carrier exists to close."

type DesignContractDigest
  = ContractDigestDerived { digest: Fnv1a64Structural }
  | ContractRequirementUnreadable { requirement: DeclarationRef, resolution: DeclarationRefResolution }

fn design_declaration_structure_digest(node: Node) -> Fnv1a64Structural {
  content_hash(n: node)
}

data design_truth_bare_name_capture_note: String = "EVERY LIST OPERATION BELOW IS A NAMED-ARGUMENT CALL, MIRRORING v2.std.decl_ref_resolution, AND THAT IS DELIBERATE. gunbc.commit_workflow commit_writer_index_filter_capture_scaffold records the measured failure this avoids: a bare filter over a List binds to the v2.std.algebra FreeMonoid declaration whenever any import drags that module into the pool, the element type stops unifying, and the module fails with an error naming a field rather than the capture. It is silent -- nothing reports that the name rebound. This module imports v2.lens.module_graph, v2.std.decl_index and v2.std.node, so that whole closure IS in its pool by construction, and the safe idiom is the one the resolver module already proves against exactly these types."

fn design_decl_facts_matching(qualified_name: String, facts: List<DeclFact>) -> List<DeclFact> {
  fold(facts, init: std.algebra.Empty, f: fn(acc, fact) {
    if fact.qualified_name == qualified_name {
      list_snoc_item(xs: acc, item: fact)
    } else {
      acc
    }
  })
}

fn design_decl_fact_for_identity(identity: DeclarationIdentity, facts: List<DeclFact>) -> DeclFact? {
  match list_head(xs: design_decl_facts_matching(qualified_name: identity.qualified_name, facts: facts)) {
    HeadFound { value } => Present { value: value }
    HeadAbsent => Absent
  }
}

fn design_contract_digest(
  contract: DesignContract,
  facts: List<DeclFact>,
  modules: List<ModuleDeclarationFact>,
) -> DesignContractDigest {
  let resolution = resolve_declaration_ref(ref: contract.requirement, facts: facts, modules: modules)
  match resolution {
    DeclarationRefResolved { declaration_identity } =>
      match design_decl_fact_for_identity(identity: declaration_identity, facts: facts) {
        Present { value } =>
          ContractDigestDerived {
            digest: content_hash_tagged_structural(
              tag: "design-contract-requirement-v1",
              payload: design_declaration_structure_digest(node: value.node),
            ),
          }
        Absent =>
          ContractRequirementUnreadable { requirement: contract.requirement, resolution: resolution }
      }
    DeclarationRefModuleAbsent { reference: _ } =>
      ContractRequirementUnreadable { requirement: contract.requirement, resolution: resolution }
    DeclarationRefDeclarationAbsent { reference: _ } =>
      ContractRequirementUnreadable { requirement: contract.requirement, resolution: resolution }
    DeclarationRefFieldAbsent { reference: _ } =>
      ContractRequirementUnreadable { requirement: contract.requirement, resolution: resolution }
    DeclarationRefAmbiguous { reference: _, candidates: _ } =>
      ContractRequirementUnreadable { requirement: contract.requirement, resolution: resolution }
  }
}

data design_realization_binding_note: String = "A REALIZATION NAMES THE PRODUCTION CONSUMER, OR IT IS CEREMONY. A row asserting 'this declaration implements that design' while production reaches something else is prose wearing a type -- the same claim the prose carried, with the same inability to be wrong. production_consumer is therefore a required field and design_realization_reach decides whether the implementation is actually reachable from it in the live dependency graph, so an unreachable realization REFUSES instead of counting toward standing.\n\ncontract_digest is the digest this realization was proven against. It is stored rather than derived because that is exactly the fact deriving it would destroy: the question standing asks is whether the contract has MOVED since, and a digest recomputed at read time can never answer it."

data realization_contract_proof_note: String = "AN UNMEASURED PROOF IS A STATE, NOT A DEFAULT VALUE, and this coproduct exists because the alternative was caught in this carrier's own first draft. contract_digest was a required Fnv1a64Structural, so the first production row had to carry SOMETHING, and what it carried was 0000000000000000 -- a fabricated plausible value in the exact position whose entire job is to say 'this realization was proven against that contract structure'. Nothing distinguished it from a real digest; the fold would have compared it, found a mismatch, and reported DesignContractChanged forever, with no way for a reader to tell a genuine drift from a placeholder.\n\nTHE MEASUREMENT IS EXPENSIVE, AND THAT IS THE SECOND REASON. Deriving the digest requires decl_facts over the pool; CONFIDENCE-0 measured a corpus-wide reverse query at 409s wall (~92% in load_bare_edge_index) and the bundled attempt here exceeded a 45-minute remote executor budget. So a pinned digest could not be re-derived by any per-PR consumer, which makes a stored one unfalsifiable in practice as well as unmeasured in fact.\n\nSO THE STATE IS TYPED RATHER THAN GUESSED, the same move CONFIDENCE-0's DeclarationGrainUnavailable makes one grain over: measure the absence, refuse to fabricate, name the trigger that dissolves it. ProvenAgainstContract carries a digest that was actually derived. ContractProofUnmeasured carries the reason and the trigger and cannot be mistaken for a proof, because the drift comparison is unreachable from it -- the fold has no arm in which an unmeasured proof compares equal to anything."

type RealizationContractProof
  = ProvenAgainstContract { digest: Fnv1a64Structural }
  | ContractProofUnmeasured { reason: String, trigger: String }

type DesignRealization {
  subject: DesignSubjectIdentity
  implementation: DeclarationRef
  production_consumer: DeclarationRef
  evidence: DeclarationRef
  contract_proof: RealizationContractProof
}

data design_realization_reach_second_query_disposition: String = "DECLARED SECOND QUERY, COUNTED RATHER THAN SILENT (reconciled with warm-crane-642 / CONFIDENCE-0, 2026-08-09). design_realization_reach below asks a MODULE-GRAIN reachability question by calling v2.lens.module_graph dependency_closure directly. tools.module_impact_query_front_door asks a question at the same grain, as a reverse (DependentsOf) query. Two reads at one grain is one too many, and the honest move is to say so in a typed row with a dissolution trigger rather than leave a silent duplicate for a later census to rediscover.\n\nTHE DISSOLUTION TARGET IS THE SHARED AUTHORITY, EXPLICITLY NOT THAT FRONT DOOR, and the correction is worth recording because the first draft of this row got it wrong. The front door is a WHOLE-CORPUS FOLD: it builds the corpus-wide edge index and then answers, which is where CONFIDENCE-0 measured 409s wall at ~92% in load_bare_edge_index. Consuming it from this wall would inherit the full index cost per invocation -- the exact shape ruled unusable two paragraphs down -- so re-grounding here means consuming the shared authority's POINT QUERY (subject in, consumers out, index amortized once per process), at which point that front door becomes another consumer of the same authority rather than this carrier's dependency. Cite the obligation, never inherit the cost.\n\nTHE REAL DISSOLUTION IS ONE GRAIN DOWN, and both lanes measured the same gap independently. Module grain is FAIL-OPEN for a declaration added to a module that already has dependents: the module is reached, so the new declaration reads reachable while nothing references it. CONFIDENCE-0 refuses that case explicitly as DeclarationGrainUnavailable and measured it at 8 of 10 subjects on its own diff. Declaration-grain consumption -- a symbol-to-consumer edge -- has NO authority in tree: module-to-module (dependency_closure), doc-to-doc (v2.lens.doc_reachability) and per-reference citation resolution (v2.std.decl_ref_resolution G1) all exist and none of them is it. DISSOLVE-ON: that one authority landing, consumed by BOTH this wall and gunbc.pr_delivery_check, never forked to fit either.\n\nSCOPE BOUND, measured on both sides rather than assumed: whole-corpus reachability is not available here. It is UNSOUND today because the src/v2 corpus does not whole-tree-resolve (wiring_liveness_whole_tree names v2.lens.resolved_imports as its blocker; gunbc.ci_layer_roots whole_tree_strict_resolve_scaffold_exclusion_note calls the resulting reds 'universe-relative artifacts'), so a consumer outside the universe renders its subject as unconsumed -- the empty-observation narrow, which invites deleting live code. And it is UNAFFORDABLE: CONFIDENCE-0 measured a whole-corpus reverse query at 409s wall, ~92% in load_bare_edge_index. This wall therefore asks about registered subjects only, and no consumer of it may read a corpus-wide liveness claim into it."

type RealizationReach
  = RealizationReachedFromConsumer { consumer_path: String, implementation_path: String }
  | RealizationUnreachableFromConsumer { consumer_path: String, implementation_path: String }
  | RealizationReachUnreadable { reference: DeclarationRef, resolution: DeclarationRefResolution }

fn design_declaration_rel_path(
  reference: DeclarationRef,
  facts: List<DeclFact>,
  modules: List<ModuleDeclarationFact>,
) -> String? {
  match resolve_declaration_ref(ref: reference, facts: facts, modules: modules) {
    DeclarationRefResolved { declaration_identity } => Present { value: declaration_identity.rel_path }
    DeclarationRefModuleAbsent { reference: _ } => Absent
    DeclarationRefDeclarationAbsent { reference: _ } => Absent
    DeclarationRefFieldAbsent { reference: _ } => Absent
    DeclarationRefAmbiguous { reference: _, candidates: _ } => Absent
  }
}

fn design_realization_reach(
  realization: DesignRealization,
  facts: List<DeclFact>,
  modules: List<ModuleDeclarationFact>,
  edges: List<ModuleDependencyEdge>,
) -> RealizationReach {
  match design_declaration_rel_path(reference: realization.production_consumer, facts: facts, modules: modules) {
    Absent =>
      RealizationReachUnreadable {
        reference: realization.production_consumer,
        resolution: resolve_declaration_ref(ref: realization.production_consumer, facts: facts, modules: modules),
      }
    Present { value: consumer_path } =>
      match design_declaration_rel_path(reference: realization.implementation, facts: facts, modules: modules) {
        Absent =>
          RealizationReachUnreadable {
            reference: realization.implementation,
            resolution: resolve_declaration_ref(ref: realization.implementation, facts: facts, modules: modules),
          }
        Present { value: implementation_path } =>
          if any(
            xs: dependency_closure(entry_path: consumer_path, edges: edges, nodes: modules),
            predicate: fn(p) { p == implementation_path }
          ) {
            RealizationReachedFromConsumer {
              consumer_path: consumer_path,
              implementation_path: implementation_path,
            }
          } else {
            RealizationUnreachableFromConsumer {
              consumer_path: consumer_path,
              implementation_path: implementation_path,
            }
          }
      }
  }
}

data declaration_presence_note: String = "MODULE-ABSENT IS NOT DECLARATION-ABSENT, and collapsing them is the fail-open this repository's own holed-universe finding predicts. resolve_declaration_ref returns five arms; only DeclarationRefDeclarationAbsent means 'the module is declared and the declaration is genuinely not in it'. Module-absent means the module never entered THIS pool, which on a corpus that does not whole-tree-resolve is routinely a universe hole rather than a deletion -- treating it as deliberate absence would let an excluded import target retire live work. Field-absent and ambiguous are likewise unreadable rather than absent: a reference resolving to two declarations has not established that anything was removed.\n\nTHE FUNCTION THIS REPLACES RETURNED Optional, so all four failure arms collapsed to Absent, and DeclarationAbsentCondition then read every one of them as DissolutionReached. An ambiguous or malformed reference could therefore retire a plan as though its declaration had been deliberately deleted. Found in review (cursor/composer-2.5 on gunbc#8066); it is the exact state-space conflation this carrier exists to remove, committed inside it."

type DeclarationPresence
  = DeclarationPresent { rel_path: String }
  | DeclarationDefinitelyAbsent { reference: DeclarationRef }
  | DeclarationResolutionUnreadable {
      reference: DeclarationRef,
      resolution: DeclarationRefResolution,
    }

fn design_declaration_presence(
  reference: DeclarationRef,
  facts: List<DeclFact>,
  modules: List<ModuleDeclarationFact>,
) -> DeclarationPresence {
  let resolution = resolve_declaration_ref(ref: reference, facts: facts, modules: modules)
  match resolution {
    DeclarationRefResolved { declaration_identity } =>
      DeclarationPresent { rel_path: declaration_identity.rel_path }
    DeclarationRefDeclarationAbsent { reference: _ } =>
      DeclarationDefinitelyAbsent { reference: reference }
    DeclarationRefModuleAbsent { reference: _ } =>
      DeclarationResolutionUnreadable { reference: reference, resolution: resolution }
    DeclarationRefFieldAbsent { reference: _ } =>
      DeclarationResolutionUnreadable { reference: reference, resolution: resolution }
    DeclarationRefAmbiguous { reference: _, candidates: _ } =>
      DeclarationResolutionUnreadable { reference: reference, resolution: resolution }
  }
}

fn design_realization_reach_admits(reach: RealizationReach) -> Bool {
  match reach {
    RealizationReachedFromConsumer { consumer_path: _, implementation_path: _ } => true
    RealizationUnreachableFromConsumer { consumer_path: _, implementation_path: _ } => false
    RealizationReachUnreadable { reference: _, resolution: _ } => false
  }
}

data realization_evidence_admission_note: String = "EVIDENCE IS PART OF ADMISSION, BECAUSE A STORED-AND-UNREAD FIELD IS PROSE WITH A TYPE. The first revision carried DesignRealization.evidence and no fold ever looked at it, so a row could name a witness that had been renamed, moved, or never written and the standing would still read DesignRealized -- the specification-without-execution failure committed inside the carrier built to close it, and the same failure the production_consumer field was added to avoid one field over. Found in review (cursor/composer-2.5 on gunbc#8066).\n\nSO A REALIZATION IS ADMITTED ONLY IF ITS EVIDENCE DECLARATION IS PRESENT, and the three-way presence answer is preserved rather than collapsed: a missing evidence declaration and an unreadable reference are different states with different remedies, exactly as declaration_presence_note argues for dissolution conditions.\n\nWHAT THIS DOES NOT CLAIM: presence is not execution. That the named witness declaration EXISTS is checkable from declaration facts; that it RUNS and is green is the CI floor's enrollment question, and asserting it here would be a rung this fold cannot support. Presence closes the rot channel (a renamed or deleted witness now reds); enrollment closes the execution channel and is the gate's obligation."

fn design_realization_evidence(
  realization: DesignRealization,
  facts: List<DeclFact>,
  modules: List<ModuleDeclarationFact>,
) -> DeclarationPresence {
  design_declaration_presence(reference: realization.evidence, facts: facts, modules: modules)
}

fn design_declaration_presence_admits(presence: DeclarationPresence) -> Bool {
  match presence {
    DeclarationPresent { rel_path: _ } => true
    DeclarationDefinitelyAbsent { reference: _ } => false
    DeclarationResolutionUnreadable { reference: _, resolution: _ } => false
  }
}

fn design_realization_admits(
  realization: DesignRealization,
  facts: List<DeclFact>,
  modules: List<ModuleDeclarationFact>,
  edges: List<ModuleDependencyEdge>,
) -> Bool {
  design_realization_reach_admits(
    reach: design_realization_reach(
      realization: realization, facts: facts, modules: modules, edges: edges,
    )
  ) && design_declaration_presence_admits(
    presence: design_realization_evidence(realization: realization, facts: facts, modules: modules)
  )
}

data design_retirement_event_note: String = "RETIREMENT IS AN EXPLICIT EVENT NAMING A SUCCESSOR, never the absence of a realization. Absence already means DesignDeclared -- a subject whose implementation was deleted must not read as retired, and a retired subject must not read as unstarted. The same shape gunbc.roadmap_model chose for acceptance after the 2026-07-28 verdict: the fact is recorded, never expressed by removing a row."

type DesignRetirementEvent {
  subject: DesignSubjectIdentity
  successor: DesignSubjectIdentity
}

data design_standing_fold_note: String = "STANDING IS A FOLD OVER FACTS, AND THERE IS NO FIELD THAT COULD DISAGREE WITH IT. Zero current realizations is DesignDeclared; exactly one is DesignRealized; two or more is DesignAmbiguous and REFUSES rather than selecting one, because a design with two claimed sole realizations is the DESIGN 3 fork this carrier exists to surface, not a tie to break. A realization whose stored digest differs from the contract's current digest is DesignContractChanged -- it does not stay green merely because its implementation symbol still exists, which is the exact failure a symbol-resolution lens cannot catch. An unreadable contract is its own arm and never collapses into Declared, because 'no realization' and 'cannot tell' have different remedies (the empty-observation narrow DESIGN names as the absorbing fallback's mirror).\n\nORDER MATTERS AND IS DELIBERATE: retirement is decided before realization population, so a retired subject with a lingering realization row reads retired rather than realized."

type DesignStanding
  = DesignDeclared { subject: DesignSubjectIdentity }
  | DesignRealized { subject: DesignSubjectIdentity, realization: DesignRealization }
  | DesignAmbiguous { subject: DesignSubjectIdentity, realizations: List<DesignRealization> }
  | DesignContractChanged {
      subject: DesignSubjectIdentity,
      stale_realization: DesignRealization,
      current_digest: Fnv1a64Structural,
    }
  | DesignRealizedContractProofUnmeasured {
      subject: DesignSubjectIdentity,
      realization: DesignRealization,
      reason: String,
      trigger: String,
    }
  | DesignRetired { subject: DesignSubjectIdentity, successor: DesignSubjectIdentity }
  | DesignStandingUnreadable { subject: DesignSubjectIdentity, requirement: DeclarationRef }
  | DesignRealizationUnreachable {
      subject: DesignSubjectIdentity,
      realization: DesignRealization,
      reach: RealizationReach,
    }
  | DesignRealizationUnreadable {
      subject: DesignSubjectIdentity,
      realization: DesignRealization,
      reach: RealizationReach,
    }
  | DesignMixedValidAndInvalidRealizations {
      subject: DesignSubjectIdentity,
      valid: List<DesignRealization>,
      invalid: List<DesignRealization>,
    }
  | DesignRetiredWithLiveRealization {
      subject: DesignSubjectIdentity,
      successor: DesignSubjectIdentity,
      realizations: List<DesignRealization>,
    }
  | DesignDuplicateRetirement {
      subject: DesignSubjectIdentity,
      retirements: List<DesignRetirementEvent>,
    }
  | DesignRealizationEvidenceMissing {
      subject: DesignSubjectIdentity,
      realization: DesignRealization,
      evidence: DeclarationRef,
    }
  | DesignRealizationEvidenceUnreadable {
      subject: DesignSubjectIdentity,
      realization: DesignRealization,
      evidence: DeclarationRef,
      resolution: DeclarationRefResolution,
    }

data design_authored_standing_split_note: String = "TWO FOLDS, BECAUSE A GENERATED DOCUMENT CANNOT AFFORD A CORPUS WALK AND MUST NOT PRETEND TO HAVE DONE ONE. design_standing below reads live declaration facts -- it resolves the requirement, hashes its Node, and walks the dependency closure -- which is the right cost for a gate and the wrong cost for expected_design_md, whose output must also stay a deterministic function of authored rows so the generated-artifact drift wall keeps meaning what it says.\n\nSO THE DOC RENDERS THIS ONE. AuthoredDesignStanding is a pure fold over the authored rows: retirement events, then the admitted realization count at zero, one, or many. Those arms cannot be authored directly and cannot disagree with the rows, which is the property the projection needs -- a section can no longer carry 'this prerequisite remains open' as a sentence, because the only standing it can build is a fold over the population.\n\nWHAT THIS DELIBERATELY DOES NOT CLAIM, stated rather than left for a reader to discover: the authored fold cannot see that a contract has MOVED or that an implementation has become unreachable, because both are facts about the tree rather than about the rows. Those arms live in design_standing and are the GATE's job, so the honest rung for the doc projection alone is mechanically preventable -- the document is corrected when the gate reds, not prevented from being wrong in the window before it runs. Collapsing the two folds into one would either put a corpus walk inside artifact generation or silently drop the arms that make the wall real."

data authored_unmeasured_arm_note: String = "THE PROOF STATE IS AUTHORED DATA, SO THE PURE FOLD CAN SEE IT AND MUST. An earlier revision of this coproduct had no unmeasured arm: design_authored_standing returned AuthoredRealized for a row carrying ContractProofUnmeasured, and design_projection rendered it with the same 'realized by X, reached in production from Y' sentence as a fully proven row. That directly contradicted the registry note declaring this subject's honest standing to be DesignRealizedContractProofUnmeasured with drift detection inactive -- two folds disagreeing about one row, with the WEAKER claim in the carrier nobody reads and the STRONGER one in the generated document. Caught in review (cursor/composer-2.5 on gunbc#8066).\n\nIT WAS RUNG INFLATION IN THE DOCUMENT-FACING DIRECTION, which is the direction that matters: a reader of DESIGN.md would have seen a proof strength no measurement supported. The reason the collapse happened is worth keeping, because it was a plausible mistake -- the authored fold exists to avoid live declaration facts, and contract DRIFT genuinely needs them. But whether a realization was ever MEASURED is not a fact about the tree; it is a field on the row. Nothing forced the collapse, and separating the two questions costs nothing."

type AuthoredDesignStanding
  = AuthoredDeclared { subject: DesignSubjectIdentity }
  | AuthoredRealized { subject: DesignSubjectIdentity, realization: DesignRealization }
  | AuthoredRealizedProofUnmeasured {
      subject: DesignSubjectIdentity,
      realization: DesignRealization,
      trigger: String,
    }
  | AuthoredAmbiguous { subject: DesignSubjectIdentity, realizations: List<DesignRealization> }
  | AuthoredRetired { subject: DesignSubjectIdentity, successor: DesignSubjectIdentity }
  | AuthoredDuplicateRetirement {
      subject: DesignSubjectIdentity,
      retirements: List<DesignRetirementEvent>,
    }

fn design_authored_standing(
  contract: DesignContract,
  realizations: List<DesignRealization>,
  retirements: List<DesignRetirementEvent>,
) -> AuthoredDesignStanding {
  let my_retirements = design_retirements_for_subject(
    subject: contract.subject,
    retirements: retirements,
  )
  let retirement_count = length(xs: my_retirements)
  if retirement_count > 1 {
    AuthoredDuplicateRetirement { subject: contract.subject, retirements: my_retirements }
  } else if retirement_count == 1 {
    match list_head(xs: my_retirements) {
      HeadAbsent => AuthoredDeclared { subject: contract.subject }
      HeadFound { value: event } =>
        AuthoredRetired { subject: contract.subject, successor: event.successor }
    }
  } else {
    {
      let mine = design_realizations_for_subject(subject: contract.subject, realizations: realizations)
      let n = length(xs: mine)
      if n == 0 {
        AuthoredDeclared { subject: contract.subject }
      } else if n > 1 {
        AuthoredAmbiguous { subject: contract.subject, realizations: mine }
      } else {
        match list_head(xs: mine) {
          HeadAbsent => AuthoredDeclared { subject: contract.subject }
          HeadFound { value: sole } =>
            match sole.contract_proof {
              ContractProofUnmeasured { reason: _, trigger } =>
                AuthoredRealizedProofUnmeasured {
                  subject: contract.subject,
                  realization: sole,
                  trigger: trigger,
                }
              ProvenAgainstContract { digest: _ } =>
                AuthoredRealized { subject: contract.subject, realization: sole }
            }
        }
      }
    }
  }
}

fn design_realizations_for_subject(
  subject: DesignSubjectIdentity,
  realizations: List<DesignRealization>,
) -> List<DesignRealization> {
  fold(realizations, init: std.algebra.Empty, f: fn(acc, r) {
    if design_subject_identity_eq(left: r.subject, right: subject) {
      list_snoc_item(xs: acc, item: r)
    } else {
      acc
    }
  })
}

data registry_cardinality_note: String = "AUTHORITY ROWS ARE COUNTED, NEVER list_head-SELECTED. An earlier revision took the first matching retirement and the first matching contract, so a second row for one subject was silently ignored -- the same defect the ambiguity arm exists to catch for realizations, left open one level up on the rows that DECIDE the standing. Two retirements naming different successors is a contradiction, not a tie to break, and picking the first would have made the answer depend on authoring order. Found in review (cursor/composer-2.5 on gunbc#8066)."

fn design_retirements_for_subject(
  subject: DesignSubjectIdentity,
  retirements: List<DesignRetirementEvent>,
) -> List<DesignRetirementEvent> {
  fold(retirements, init: std.algebra.Empty, f: fn(acc, e) {
    if design_subject_identity_eq(left: e.subject, right: subject) {
      list_snoc_item(xs: acc, item: e)
    } else {
      acc
    }
  })
}

fn design_standing(
  contract: DesignContract,
  realizations: List<DesignRealization>,
  retirements: List<DesignRetirementEvent>,
  facts: List<DeclFact>,
  modules: List<ModuleDeclarationFact>,
  edges: List<ModuleDependencyEdge>,
) -> DesignStanding {
  let mine = design_realizations_for_subject(subject: contract.subject, realizations: realizations)
  let my_retirements = design_retirements_for_subject(
    subject: contract.subject,
    retirements: retirements,
  )
  let retirement_count = length(xs: my_retirements)
  if retirement_count > 1 {
    DesignDuplicateRetirement { subject: contract.subject, retirements: my_retirements }
  } else if retirement_count == 1 {
    match list_head(xs: my_retirements) {
      HeadAbsent => DesignDeclared { subject: contract.subject }
      HeadFound { value: event } =>
        if length(xs: mine) > 0 {
          DesignRetiredWithLiveRealization {
            subject: contract.subject,
            successor: event.successor,
            realizations: mine,
          }
        } else {
          DesignRetired { subject: contract.subject, successor: event.successor }
        }
    }
  } else {
      match design_contract_digest(contract: contract, facts: facts, modules: modules) {
        ContractRequirementUnreadable { requirement, resolution: _ } =>
          DesignStandingUnreadable { subject: contract.subject, requirement: requirement }
        ContractDigestDerived { digest } => {
          let admitted = fold(mine, init: std.algebra.Empty, f: fn(acc, r) {
            if design_realization_admits(realization: r, facts: facts, modules: modules, edges: edges) {
              list_snoc_item(xs: acc, item: r)
            } else { acc }
          })
          let rejected = fold(mine, init: std.algebra.Empty, f: fn(acc, r) {
            if design_realization_admits(realization: r, facts: facts, modules: modules, edges: edges) {
              acc
            } else { list_snoc_item(xs: acc, item: r) }
          })
          let n = length(xs: admitted)
          let bad = length(xs: rejected)
          if bad > 0 && n > 0 {
            DesignMixedValidAndInvalidRealizations {
              subject: contract.subject,
              valid: admitted,
              invalid: rejected,
            }
          } else if bad > 0 {
            match list_head(xs: rejected) {
              HeadAbsent => DesignDeclared { subject: contract.subject }
              HeadFound { value: broken } => {
                let reach = design_realization_reach(
                  realization: broken, facts: facts, modules: modules, edges: edges,
                )
                match reach {
                  RealizationUnreachableFromConsumer { consumer_path: _, implementation_path: _ } =>
                    DesignRealizationUnreachable {
                      subject: contract.subject, realization: broken, reach: reach,
                    }
                  RealizationReachUnreadable { reference: _, resolution: _ } =>
                    DesignRealizationUnreadable {
                      subject: contract.subject, realization: broken, reach: reach,
                    }
                  RealizationReachedFromConsumer { consumer_path: _, implementation_path: _ } =>
                    match design_realization_evidence(
                      realization: broken, facts: facts, modules: modules,
                    ) {
                      DeclarationDefinitelyAbsent { reference } =>
                        DesignRealizationEvidenceMissing {
                          subject: contract.subject, realization: broken, evidence: reference,
                        }
                      DeclarationResolutionUnreadable { reference, resolution } =>
                        DesignRealizationEvidenceUnreadable {
                          subject: contract.subject,
                          realization: broken,
                          evidence: reference,
                          resolution: resolution,
                        }
                      DeclarationPresent { rel_path: _ } =>
                        DesignRealizationUnreadable {
                          subject: contract.subject, realization: broken, reach: reach,
                        }
                    }
                }
              }
            }
          } else if n == 0 {
            DesignDeclared { subject: contract.subject }
          } else if n > 1 {
            DesignAmbiguous { subject: contract.subject, realizations: admitted }
          } else {
            match list_head(xs: admitted) {
              HeadAbsent => DesignDeclared { subject: contract.subject }
              HeadFound { value: sole } =>
                match sole.contract_proof {
                  ContractProofUnmeasured { reason, trigger } =>
                    DesignRealizedContractProofUnmeasured {
                      subject: contract.subject,
                      realization: sole,
                      reason: reason,
                      trigger: trigger,
                    }
                  ProvenAgainstContract { digest: proven } =>
                    if content_hash_eq_structural(left: proven, right: digest) {
                      DesignRealized { subject: contract.subject, realization: sole }
                    } else {
                      DesignContractChanged {
                        subject: contract.subject,
                        stale_realization: sole,
                        current_digest: digest,
                      }
                    }
                }
            }
          }
        }
      }
  }
}

data design_dissolution_condition_note: String = "A DISSOLUTION TRIGGER THAT CANNOT BE EVALUATED IS A REMINDER, NOT AN INVALIDATOR. gunbc.plan DissolutionTrigger is HasTrigger { text: String } and the only generic enforcement anywhere is that the text is nonempty -- nothing observes whether the described end state arrived. That is why an interpreted serve loop's dissolution could fire in production while its plan went on presenting the interpreted loop as the plan. DissolutionCondition is the typed half: the prose may stay as explanation ATTACHED to a condition, but the condition is what decides.\n\nREFUSE, DO NOT SILENTLY OMIT. A plan whose condition is reached must not simply vanish from the active view: a misbound condition would then render as 'nothing to see', which is the empty-observation narrow -- strictly worse than a widen, because a widen is merely expensive while a narrow is silently uncovered. DissolutionReached with no recorded disposition REFUSES, forcing a deliberate retirement or supersession event."

type DissolutionCondition
  = SubjectRealizedCondition { subject: DesignSubjectIdentity }
  | SubjectRetiredCondition { subject: DesignSubjectIdentity }
  | DeclarationAbsentCondition { declaration: DeclarationRef }
  | DeclarationReplacedByCondition { old: DeclarationRef, replacement: DeclarationRef }

type DissolutionStanding
  = DissolutionNotReached { condition: DissolutionCondition }
  | DissolutionReached { condition: DissolutionCondition }
  | DissolutionUnreadable { condition: DissolutionCondition }

data realized_predicate_scope_note: String = "AN UNMEASURED CONTRACT PROOF STILL COUNTS AS REALIZED HERE, and the two questions must not be fused. This predicate answers 'does an implementation exist and is it reached from the named production consumer' -- which is what a dissolution condition asks. Whether the realization was proven against a MEASURED contract structure is a different question, answered by the standing ARM the caller matched, and a consumer that needs the stronger fact matches DesignRealized specifically rather than calling this. Collapsing them would either report an unmeasured realization as unrealized (false -- the code is there and reached) or silently upgrade it to proven (the fabrication this coproduct exists to prevent)."

fn design_standing_is_realized(standing: DesignStanding) -> Bool {
  match standing {
    DesignRealized { subject: _, realization: _ } => true
    DesignRealizedContractProofUnmeasured {
      subject: _, realization: _, reason: _, trigger: _,
    } => true
    DesignDeclared { subject: _ } => false
    DesignAmbiguous { subject: _, realizations: _ } => false
    DesignContractChanged { subject: _, stale_realization: _, current_digest: _ } => false
    DesignRetired { subject: _, successor: _ } => false
    DesignStandingUnreadable { subject: _, requirement: _ } => false
    DesignRealizationUnreachable { subject: _, realization: _, reach: _ } => false
    DesignRealizationUnreadable { subject: _, realization: _, reach: _ } => false
    DesignMixedValidAndInvalidRealizations { subject: _, valid: _, invalid: _ } => false
    DesignRetiredWithLiveRealization { subject: _, successor: _, realizations: _ } => false
    DesignRealizationEvidenceMissing { subject: _, realization: _, evidence: _ } => false
    DesignRealizationEvidenceUnreadable {
      subject: _, realization: _, evidence: _, resolution: _,
    } => false
    DesignDuplicateRetirement { subject: _, retirements: _ } => false
  }
}

fn design_standing_is_retired(standing: DesignStanding) -> Bool {
  match standing {
    DesignRetired { subject: _, successor: _ } => true
    DesignRealized { subject: _, realization: _ } => false
    DesignRealizedContractProofUnmeasured {
      subject: _, realization: _, reason: _, trigger: _,
    } => false
    DesignDeclared { subject: _ } => false
    DesignAmbiguous { subject: _, realizations: _ } => false
    DesignContractChanged { subject: _, stale_realization: _, current_digest: _ } => false
    DesignStandingUnreadable { subject: _, requirement: _ } => false
    DesignRealizationUnreachable { subject: _, realization: _, reach: _ } => false
    DesignRealizationUnreadable { subject: _, realization: _, reach: _ } => false
    DesignMixedValidAndInvalidRealizations { subject: _, valid: _, invalid: _ } => false
    DesignRetiredWithLiveRealization { subject: _, successor: _, realizations: _ } => false
    DesignRealizationEvidenceMissing { subject: _, realization: _, evidence: _ } => false
    DesignRealizationEvidenceUnreadable {
      subject: _, realization: _, evidence: _, resolution: _,
    } => false
    DesignDuplicateRetirement { subject: _, retirements: _ } => false
  }
}

fn design_dissolution_standing(
  condition: DissolutionCondition,
  contracts: List<DesignContract>,
  realizations: List<DesignRealization>,
  retirements: List<DesignRetirementEvent>,
  facts: List<DeclFact>,
  modules: List<ModuleDeclarationFact>,
  edges: List<ModuleDependencyEdge>,
) -> DissolutionStanding {
  match condition {
    SubjectRealizedCondition { subject } =>
      match design_contract_for_subject(subject: subject, contracts: contracts) {
        ContractSubjectUnregistered { subject: _ } => DissolutionUnreadable { condition: condition }
        ContractSubjectDuplicated { subject: _, contracts: _ } =>
          DissolutionUnreadable { condition: condition }
        ContractSelected { contract } =>
          if design_standing_is_realized(
            standing: design_standing(
              contract: contract,
              realizations: realizations,
              retirements: retirements,
              facts: facts,
              modules: modules,
              edges: edges,
            )
          ) {
            DissolutionReached { condition: condition }
          } else {
            DissolutionNotReached { condition: condition }
          }
      }
    SubjectRetiredCondition { subject } =>
      match design_contract_for_subject(subject: subject, contracts: contracts) {
        ContractSubjectUnregistered { subject: _ } => DissolutionUnreadable { condition: condition }
        ContractSubjectDuplicated { subject: _, contracts: _ } =>
          DissolutionUnreadable { condition: condition }
        ContractSelected { contract } =>
          if design_standing_is_retired(
            standing: design_standing(
              contract: contract,
              realizations: realizations,
              retirements: retirements,
              facts: facts,
              modules: modules,
              edges: edges,
            )
          ) {
            DissolutionReached { condition: condition }
          } else {
            DissolutionNotReached { condition: condition }
          }
      }
    DeclarationAbsentCondition { declaration } =>
      match design_declaration_presence(reference: declaration, facts: facts, modules: modules) {
        DeclarationDefinitelyAbsent { reference: _ } => DissolutionReached { condition: condition }
        DeclarationPresent { rel_path: _ } => DissolutionNotReached { condition: condition }
        DeclarationResolutionUnreadable { reference: _, resolution: _ } =>
          DissolutionUnreadable { condition: condition }
      }
    DeclarationReplacedByCondition { old, replacement } =>
      match design_declaration_presence(reference: replacement, facts: facts, modules: modules) {
        DeclarationDefinitelyAbsent { reference: _ } => DissolutionUnreadable { condition: condition }
        DeclarationResolutionUnreadable { reference: _, resolution: _ } =>
          DissolutionUnreadable { condition: condition }
        DeclarationPresent { rel_path: _ } =>
          match design_declaration_presence(reference: old, facts: facts, modules: modules) {
            DeclarationDefinitelyAbsent { reference: _ } => DissolutionReached { condition: condition }
            DeclarationPresent { rel_path: _ } => DissolutionNotReached { condition: condition }
            DeclarationResolutionUnreadable { reference: _, resolution: _ } =>
              DissolutionUnreadable { condition: condition }
          }
      }
  }
}

data contract_selection_note: String = "SELECTING A SUBJECT'S CONTRACT IS A CARDINALITY QUESTION, AND THE PREVIOUS REVISION ANSWERED IT WITH Optional. Absent then meant both 'no contract is registered for this subject' and nothing else -- while TWO registered contracts for one subject, which is a genuine authority fork, silently produced the first one and made every downstream standing depend on authoring order. The realization population already refuses that shape via DesignAmbiguous; the rows that DECIDE the standing were left unguarded one level up. Found in review (cursor/composer-2.5 on gunbc#8066).\n\nIT ALSO USED A BARE filter, which is the exact capture hazard design_truth_bare_name_capture_note documents for this module's own pool. Both defects are removed by the same rewrite: a named-argument fold with a typed three-arm result."

type DesignContractSelection
  = ContractSelected { contract: DesignContract }
  | ContractSubjectUnregistered { subject: DesignSubjectIdentity }
  | ContractSubjectDuplicated {
      subject: DesignSubjectIdentity,
      contracts: List<DesignContract>,
    }

fn design_contract_for_subject(
  subject: DesignSubjectIdentity,
  contracts: List<DesignContract>,
) -> DesignContractSelection {
  let matches = fold(contracts, init: std.algebra.Empty, f: fn(acc, c) {
    if design_subject_identity_eq(left: c.subject, right: subject) {
      list_snoc_item(xs: acc, item: c)
    } else {
      acc
    }
  })
  let n = length(xs: matches)
  if n > 1 {
    ContractSubjectDuplicated { subject: subject, contracts: matches }
  } else {
    match list_head(xs: matches) {
      HeadAbsent => ContractSubjectUnregistered { subject: subject }
      HeadFound { value } => ContractSelected { contract: value }
    }
  }
}
