module gunbc.lambda_argument_typing_gate


// THREE LOCATED E0282 SITES WHOSE CAUSE IS UNLOCATED.
//
// This row was authored asserting a cause: that `v1.compiler.emit_rust` `emit_typed_call` binds a
// lambda argument's parameters only when the callee's BARE NAME is one of four literals, and that
// the three sites below are what that gate produces. THE SITES ARE REAL AND THE CAUSE WAS WRONG.
// The correction is made here rather than by deleting the row, because everything except the cause
// survived the refutation and is the most expensive thing in this thread to re-derive.
//
// WHAT REFUTED IT, by execution rather than by reading. A two-arm emission over the closures of
// `v2.compiler.tokenize`, `v2.compiler.parse` and `v2.lens.reference_deps`, from two separately
// built binaries whose difference was confirmed by grep before either arm ran, produced IDENTICAL
// BYTES: same file set, no differing file, no differing line, same diagnostic counts. A third arm
// deleting the binding ENTIRELY -- not generalizing it, removing it -- was also identical, which is
// what makes this conclusive rather than "the replacement happens to agree with the roster".
//
// WHY THE MECHANISM CANNOT REACH THE EMITTED BYTES, which is the durable half. The scope that gate
// computes is read for `type_env`, `module_name` and `item_registry`; its `locals` -- the field the
// lambda parameters are bound into -- has exactly ONE reader in the whole Rust emitter,
// `is_already_optional`, on the arm taken only when a node carries no resolved type. Emission runs
// off the TYPED TREE. And the declared parameter types the gate was supposed to supply are already
// consulted one stage earlier: `v1.compiler.infer` `infer_expr` passes each callee formal as the
// argument's expected type, and its `ExprLambda` arm binds the lambda's parameters from that formal
// and writes the resolved types back onto the parameter nodes. So the gate is a DEAD DECISION
// SURFACE: it reads like a live choice about lambda typing and decides nothing observable.
//
// WHAT THE SURFACE STILL IS, stated at the weaker strength the evidence supports rather than
// withdrawn outright. A four-name literal deciding a question for which the resolved declaration was
// available is a genuine bare-name-keying shape; the null refutes its CONSEQUENCE, not its shape. So
// it is a SYNTACTIC instance of that pattern with no observable consequence -- the surface decides
// nothing that reaches emitted bytes -- which is a different weight from a surface that causes
// wrongness, and it is why the literal is worth deleting as a cleanup rather than tracked as a
// defect. That cleanup carries this null as its receipt. It is not a repair of the sites below and
// must not be recorded as one.

type LambdaTypingGateSite {
  caller: DeclarationRef
  index_coverage: CitationIndexCoverage
  callee_spelled: String
  miss: GateMiss
  cause: SiteCause
  cause_receipt: CauseReceipt
}

// CAUSE IS A PER-SITE FIELD, NOT A ROW-LEVEL ONE, and the reason is that the sites and the causes
// were established by DIFFERENT INSTRUMENTS WITH DIFFERENT GROUPINGS. The three sites were derived
// together, by one intersection over one subject. The causes were established one site at a time, by
// three separate cargo probes over three separate emitted closures. Collapsing them into a single
// row-level verdict would force one instrument's grouping onto the other's, and a single
// CauseAttributed here would be exactly the collapse this row already had to be corrected for once.
//
// THE DISCRIMINATOR THAT SEPARATES THE TWO CAUSES IS FREE AND SITS IN OUTPUT EVERYONE READS PAST:
// rustc's own help text names WHICH PARAMETER it wants annotated. `|acc, ch: /* Type */|` asks for
// THE ELEMENT -- the collection could not supply T. `|acc: /* Type */, row|` asks for THE
// ACCUMULATOR -- the fold's initial value could not supply its own type, and the element was never
// in question. Same error code, same closure shape, two different mechanisms, told apart by which
// half of the closure rustc points at.
type SiteCause
  = StringDeclarationSiteAlias
  | UntypedFoldInitAccumulator
  | SiteCauseUnmeasured

// The receipt is carried WITH the cause so no site's attribution can be repeated as a bare assertion
// detached from the run that established it. Subject is the emitted closure the probe compiled --
// NOT the corpus, and NOT comparable across rows: each probe emitted a different file set, so an
// error count from one is not a population for another.
type CauseReceipt
  = MeasuredByCargoProbe {
      probe_subject_entry: String
      emitted_file: String
      emitted_line: Int
      rustc_code: String
      rustc_help_annotates: String
    }
  | NotYetProbed

// Why the callee misses the roster. RETAINED AS A PROPERTY OF THE SITE, NOT AS A CAUSE: the
// distinction was authored to explain how the gate declined, and the gate does not decline anything
// that reaches the emitted bytes. It survives because it is a true and cheaply checkable fact about
// each site that a later investigation may or may not find relevant -- not because it explains the
// red.
type GateMiss
  = NearMissOfARosterName { roster_name: String }
  | AbsentFromRoster

data lambda_typing_gate_sites: List<LambdaTypingGateSite> = [
  {
    caller: decl_ref(module_path: "v2.compiler.parse", decl_name: "parse_lexeme_digest"),
    index_coverage: CitableThroughDeclIndex,
    callee_spelled: "fold_list",
    miss: NearMissOfARosterName { roster_name: "fold" },
    cause: StringDeclarationSiteAlias,
    cause_receipt: MeasuredByCargoProbe {
      probe_subject_entry: "src/v2/compiler/02_parse.dag",
      emitted_file: "v2_compiler_parse.rs",
      emitted_line: 532,
      rustc_code: "E0282",
      rustc_help_annotates: "ch (the element)",
    },
  },
  {
    caller: decl_ref(module_path: "v2.std.compilers.target_model", decl_name: "target_value_expr_effect_apply_callee"),
    index_coverage: CitableThroughDeclIndex,
    callee_spelled: "fold_list",
    miss: NearMissOfARosterName { roster_name: "fold" },
    cause: UntypedFoldInitAccumulator,
    cause_receipt: MeasuredByCargoProbe {
      probe_subject_entry: "src/v2/std/compilers/target_model.dag",
      emitted_file: "v2_std_compilers_target_model.rs",
      emitted_line: 2730,
      rustc_code: "E0282",
      rustc_help_annotates: "acc (the accumulator)",
    },
  },
  {
    caller: decl_ref(module_path: "v2.compiler.tokenize", decl_name: "lex_match_prefix"),
    index_coverage: CitableThroughDeclIndex,
    callee_spelled: "is_prefix_of",
    miss: AbsentFromRoster,
    cause: StringDeclarationSiteAlias,
    cause_receipt: MeasuredByCargoProbe {
      probe_subject_entry: "src/v2/compiler/01_tokenize.dag",
      emitted_file: "v2_compiler_tokenize.rs",
      emitted_line: 154,
      rustc_code: "E0282",
      rustc_help_annotates: "a (the element)",
    },
  },
]

// THE MECHANISM VERDICT IS A TYPED ROW, NOT PROSE, because it is the fact a later reader will act
// on and the prior version of this row proves how a cause stated only in a comment gets planned
// against. The measurement is carried WITH the verdict so the refutation cannot be repeated as an
// assertion detached from what established it.
type EmittedByteDelta {
  entry_closures_measured: Int
  files_per_arm: Int
  files_differing: Int
  lines_differing: Int
}

type MechanismDisposition
  = MechanismProducesTheSites { mechanism: String }
  | MechanismRefutedByEmittedByteNull {
      mechanism: String
      delta: EmittedByteDelta
      deletion_control_also_null: Bool
    }

data lambda_typing_gate_mechanism: MechanismDisposition = MechanismRefutedByEmittedByteNull {
  mechanism: "v1.compiler.emit_rust emit_typed_call four-name collection_scope gate (map, filter, flat_map, fold)",
  delta: {
    entry_closures_measured: 3,
    files_per_arm: 258,
    files_differing: 0,
    lines_differing: 0,
  },
  deletion_control_also_null: true,
}

// THE ROW-LEVEL CAUSE DISPOSITION IS RETIRED, AND IT IS RETIRED RATHER THAN ANSWERED. Each site now
// carries its own measured cause above. There is no single mechanism here to name, and minting one
// CauseAttributed would re-commit the exact collapse this row was corrected for: three sites found by
// one instrument do not thereby share one cause, and the earlier version of this file asserted they
// did. The three sites hold; the one explanation did not.
//
// WHAT THE PARTITION ACTUALLY TURNED OUT TO BE: three real reds, TWO causes. That is
// UpperBoundPendingResidueCheck being cashed in the direction it was hedging -- the membership
// survived probing and the shared explanation did not.
type CauseGrouping
  = OneCauseForEverySite { mechanism: String }
  | CausePerSite
  | NoSiteMeasured

data lambda_typing_gate_cause_grouping: CauseGrouping = CausePerSite

// THE SECOND CAUSE HAS ITS OWN ROW, AND THE SITE STAYS LISTED HERE. gunbc.untyped_fold_init_accumulator
// carries the target_model site's mechanism and its repair, because a cause with its own repair earns
// its own row. It is NOT removed from lambda_typing_gate_sites: this row records that the three were
// derived TOGETHER by one intersection over one subject, and deleting a member because its cause
// turned out to differ would destroy the only artifact of that derivation. A site does not stop being
// a member of the set it was found in.
data lambda_typing_gate_second_cause_row: DeclarationRef = decl_ref(module_path: "gunbc.untyped_fold_init_accumulator", decl_name: "untyped_fold_init_sites")

// TWO SPECIMENS OF ONE FAILURE MODE, KEPT BECAUSE THIS ROW IS WHERE BOTH HAPPENED.
//
// FIRST: rustc's own suggestion. At every one of these sites it says "consider giving this closure
// parameter an explicit type" and points AT THE CLOSURE. That is a statement about where the failure
// was DETECTED, never about where it was CAUSED -- at the tokenize site the declaration whose T
// cannot bind is two arguments to the left. That suggestion is what made a repair keyed on the
// callee's name look plausible, and it is why the original version of this row named the wrong
// mechanism with confidence.
//
// SECOND: a pre-registered hunch that was REFUTED, recorded because the refutation only exists
// because it was written down first. Before probing the target_model site it was observed that its
// closure is the only one of the three doing FIELD ACCESS on its lambda parameter
// (row.effect_kind, row.callee), and that was named in advance as the first place to look if that
// site came out red. It came out red -- and rustc's caret is on `acc`, never on `row`. The field
// access is incidental. Had that observation been made after seeing the red instead of before, "the
// only closure doing field access" would have read as an explanation and shipped as one.
data lambda_typing_gate_detection_is_not_causation_note: String = "Both specimens above share one shape: a signal that is TRUE and LOCAL and points at the wrong place. rustc's caret is at the closure because that is where inference ran out, not where the information was lost. A pre-registered hunch is the cheap defence, and it works by being falsifiable before the data arrives rather than by being correct."

// A WARNING ABOUT COUNTING E0282 ON THESE CRATES, because the next reader will try. The emitted
// closure for v2.compiler.parse carries SEVEN E0282 diagnostics and only ONE of them is this row's.
// FIVE belong to the HELD contains class -- v2_compiler_parse.rs 1117, 1406, 1471, 1626 and
// v2_std_find_witness.rs 77, each a v1_rt::contains call asking for the same annotation on its first
// closure parameter. The seventh is the target_model site. So a count over that crate is not a
// population for this row and never was.
//
// THE SEVENTH WAS EXAMINED RATHER THAN ASSUMED, and the reason is worth the line: the first
// extraction of these blocks was TRUNCATED at six by the reader, and reporting six as the population
// would have been a count of what the display happened to fit. An unexamined member of a seven-item
// set is exactly where a third cause would hide. It did not hide there -- 1626 is a fifth contains
// site, not a new mechanism -- but that is a measured result and not the reason it was safe to skip.

// THE POPULATION IS AN UPPER BOUND, NOT A MEASUREMENT, AND THE REFUTED CAUSE DOES NOT DISTURB THAT.
//
// The three were separated from ten by intersecting the inference-failure sites with the
// arity-failure sites: a site reporting both at one position is a companion of the membership
// call-target defect and belongs to that held class, not here. That direction is sound and
// mechanical, and it never depended on why the residue fails -- only on which sites report what. The
// residue direction is the weaker one: it is defined by an ABSENCE, and holds only if arity
// reporting is complete at those positions. A suppressed downstream diagnostic would leave a
// companion looking like a member of this class.
//
// STANDING PREDICTION, which converts the bound into a measurement at no cost: when the membership
// call-target defect is repaired, all three sites below must STILL be present and still report an
// inference failure. Any that vanishes with that repair was never a member of this class.
type PopulationConfidence
  = UpperBoundPendingResidueCheck
  | MeasuredPopulation

data lambda_typing_gate_population_confidence: PopulationConfidence = UpperBoundPendingResidueCheck

// THE TRIGGER IS KEYED TO THE SITES, AND THE PREVIOUS ONE WAS THE MOST DANGEROUS LINE IN THIS ROW.
//
// It read: dies when emit_typed_call binds a lambda argument's parameters from the callee's resolved
// declaration rather than from the four-name roster. With that mechanism refuted, the trigger is
// exactly satisfiable by a change that fixes nothing -- delete the roster, retire the row, three
// sites still red. A false cause misleads a reader; a false dissolution trigger DISPOSES OF THE
// EVIDENCE, so it is the failure this correction exists to close.
//
// The replacement keys on the only fact that can honestly retire this row: the three sites emitting
// and compiling without an inference failure. No repair of any mechanism satisfies it on its own.
data lambda_typing_gate_dissolution_trigger: DissolutionCondition = unbound_dissolution(description: "dissolve-on: EVERY site in lambda_typing_gate_sites emits and compiles with no inference-failure diagnostic at that position, established by execution against the emitted crate. The sites now carry TWO different causes, so no single repair can fire this trigger: the String declaration-site alias repair closes the parse and tokenize rows, and the untyped fold-init accumulator repair closes the target_model row, and this row survives until both have. NOT satisfied by any repair to v1.compiler.emit_rust emit_typed_call's bare-name gate -- that mechanism is refuted by lambda_typing_gate_mechanism and its removal is a separate cleanup with a measured zero emitted-byte delta.")

// MERGE NOTE. The trigger this replaced, and the reach paragraph that argued for it, came from main
// and are DELETED here rather than kept beside the replacement: both were premised on the four-name
// roster being the cause, and that mechanism was measured inert -- three arms, 258 files each, zero
// differing files. Two triggers on one row is two answers to when it dies, which is the fork this
// correction exists to close. The enrollment projection below is main's and is untouched by that.

// ENROLLMENT PROJECTION — the `caller` refs, exposed so `v2.lens.cited_symbol_resolution` can
// resolve them. This carrier's entire content is citations, so nothing else in it is checkable:
// rename `parse_lexeme_digest` and, before this projection existed, every required check stayed
// green while the row went quietly false. That is the stale-citation class living inside a
// structural carrier, and enrollment is the remedy the lens's own law already names as its next
// widening — every structural DeclarationRef carrier — so no second resolver is written here.
//
// `callee_spelled` is deliberately NOT projected and must stay a String. The finding this row
// records is that the callee is consulted BY SPELLING rather than by declaration; typing it would
// assert the resolution the defect proves does not happen, and erase the defect.
data lambda_typing_gate_empty_declaration_refs: List<DeclarationRef> = []

fn lambda_typing_gate_declaration_refs_from(
  sites: List<LambdaTypingGateSite>
) -> List<DeclarationRef> {
  fold_list(
    xs: sites,
    empty: lambda_typing_gate_empty_declaration_refs,
    cons: fn(acc, s) { concat(acc, [s.caller]) }
  )
}

// EVERY ROW HERE IS CitableThroughDeclIndex TODAY, and the filter is present anyway. Not symmetry
// for its own sake: the sibling carrier has two rows the index does not cover, and a carrier that
// only grows the filter once it needs one is a carrier whose green silently changes meaning on the
// day a witness-module producer is recorded. The count below is the readable half — zero here, two
// there — and it is what keeps "all refs resolve" from being satisfiable by having no refs.
fn lambda_typing_gate_citable_sites() -> List<LambdaTypingGateSite> {
  filter(lambda_typing_gate_sites, s => citation_is_outside_index(coverage: s.index_coverage) == false)
}

fn lambda_typing_gate_outside_index_sites() -> List<LambdaTypingGateSite> {
  filter(lambda_typing_gate_sites, s => citation_is_outside_index(coverage: s.index_coverage))
}

fn lambda_typing_gate_declaration_refs() -> List<DeclarationRef> {
  lambda_typing_gate_declaration_refs_from(sites: lambda_typing_gate_citable_sites())
}

fn lambda_typing_gate_outside_index_count() -> Int {
  length(xs: lambda_typing_gate_outside_index_sites())
}
