module gunbc.output_policy


type Verbosity = Quiet | Normal | Verbose

fn env_var_for(v: Verbosity) -> String {
  match v {
    Verbose => "GUNBC_VERBOSE"
    Quiet => "GUNBC_QUIET"
    Normal => ""
  }
}

data shell_trace_summary_max_columns: Int = 100

type OutputDecision = Suppressed | Condensed | Full

type OutputChannel
  = Diagnostic
  | ClaimResult
  | Progress
  | ShellTrace
  | Instrumentation

type VerbosityEnv {
  verbose: Bool
  quiet: Bool
}

fn resolve_verbosity(env: VerbosityEnv) -> Verbosity {
  if env.verbose {
    Verbose
  } else if env.quiet {
    Quiet
  } else {
    Normal
  }
}

fn channel_decision(channel: gunbc.output_policy.OutputChannel, verbosity: Verbosity) -> OutputDecision {
  match channel {
    gunbc.output_policy.Diagnostic => Full
    gunbc.output_policy.ClaimResult => match verbosity {
      Quiet => Suppressed
      Normal => Full
      Verbose => Full
    }
    gunbc.output_policy.Progress => match verbosity {
      Quiet => Suppressed
      Normal => Condensed
      Verbose => Full
    }
    gunbc.output_policy.ShellTrace => match verbosity {
      Quiet => Suppressed
      Normal => Suppressed
      Verbose => Full
    }
    gunbc.output_policy.Instrumentation => match verbosity {
      Quiet => Suppressed
      Normal => Suppressed
      Verbose => Full
    }
  }
}

type ChannelPolicy {
  diagnostic: OutputDecision
  claim_result: OutputDecision
  progress: OutputDecision
  shell_trace: OutputDecision
  instrumentation: OutputDecision
  routine_rollup_grain: std.observation.ObservationGrain?
}

// The display grain, and the reason it is NOT another OutputDecision variant.
// Suppressed | Condensed | Full are per-line formatting verdicts: each says what becomes of ONE
// line. The defect they cannot describe is that 4110 passing witnesses became 4110 lines at all, and
// no shorter spelling of a line fixes that — accumulating a batch's routine descendants into one
// conclusion is a fold over the stream, so the policy states the GRAIN to fold to and the fold lives
// in std.observation where the containment path already is.
// Absent means render at leaf grain, which is what Verbose asks for: the operator has explicitly
// asked to see the individual work. Present{BatchGrain} is Normal and Quiet, where the leaf
// identities live in the receipt artifact and the console carries batch conclusions, dwell
// heartbeats, and anomalies at their exact leaf subject.
// No new grain taxonomy is minted: BatchSegment and the floor plan already name the high-level work,
// and a second phase enum beside them would be the nickname DESIGN section 3 forbids.
fn routine_rollup_grain_for(verbosity: Verbosity) -> std.observation.ObservationGrain? {
  match verbosity {
    Quiet => Present { value: BatchGrain }
    Normal => Present { value: BatchGrain }
    Verbose => none
  }
}

// The seed's decodable form of the question above. It exists because a `T?` has no representation
// the seed can read without guessing — Absent, a null sentinel and a bare payload are all plausible
// encodings — and a decoder that guesses wrong answers "do not fold", which is silence wearing a
// safe default. A Bool has exactly two readings and no third.
//
// DERIVED from routine_rollup_grain_for rather than restating its table: two functions answering
// the same question from two hand-written matches is the dual representation this repository keeps
// removing, and the failure mode is that the seed folds while the policy says leaf.
fn routine_rollup_folds(verbose: Bool, quiet: Bool) -> Bool {
  match routine_rollup_grain_for(
    verbosity: resolve_verbosity(env: VerbosityEnv { verbose: verbose, quiet: quiet })
  ) {
    Present { value: _ } => true
    Absent => false
  }
}

fn channel_policy(verbosity: Verbosity) -> ChannelPolicy {
  ChannelPolicy {
    diagnostic: channel_decision(channel: gunbc.output_policy.Diagnostic, verbosity: verbosity)
    claim_result: channel_decision(channel: gunbc.output_policy.ClaimResult, verbosity: verbosity)
    progress: channel_decision(channel: gunbc.output_policy.Progress, verbosity: verbosity)
    shell_trace: channel_decision(channel: gunbc.output_policy.ShellTrace, verbosity: verbosity)
    instrumentation: channel_decision(channel: gunbc.output_policy.Instrumentation, verbosity: verbosity)
    routine_rollup_grain: routine_rollup_grain_for(verbosity: verbosity)
  }
}

fn resolve_channel_policy(verbose: Bool, quiet: Bool) -> ChannelPolicy {
  channel_policy(verbosity: resolve_verbosity(env: VerbosityEnv { verbose: verbose, quiet: quiet }))
}

fn is_emitted(channel: gunbc.output_policy.OutputChannel, verbosity: Verbosity) -> Bool {
  match channel_decision(channel: channel, verbosity: verbosity) {
    Suppressed => false
    Condensed => true
    Full => true
  }
}

fn is_condensed(channel: gunbc.output_policy.OutputChannel, verbosity: Verbosity) -> Bool {
  match channel_decision(channel: channel, verbosity: verbosity) {
    Condensed => true
    Suppressed => false
    Full => false
  }
}

data effect_expectation_note: String = "channel_decision above answers how loud a CHANNEL is. It cannot answer whether a given effect's captured streams are worth surfacing, because that needs a fact it was never given: what the caller EXPECTED. Before this row 'failure' was hand-coded downstream as exit != 0 — an untyped proxy that silently assumes every effect expects success (the empty set). Naming the expectation makes the rule one line: DIVERGENCE SURFACES, AGREEMENT COUNTS, where failure means observed differs from declared-expected at the grain that declared it. That closes two leaks in one dispatch. The noisy one: a red-control child failing exactly as declared is AGREEMENT, so its stderr is counted, not replayed — and a subject stderr carrying '::error::' stops minting annotations in the parent run. The silent one, which nobody has hit yet and which is the real payoff: a red control that SUCCEEDS (the wall failing to fire) is divergence, and today logs nothing at all — the single most diagnosis-worthy event in the system is currently the quietest. There is deliberately no ExpectAny arm: an effect whose expectation is unknown would make every observation agree, restoring the empty set (DESIGN 5 — a failure arm must refuse, never widen)."

data outcome_is_data_note: String = "OutcomeIsData is the third arm (operator ruling 2026-07-25), and it exists because ExpectSuccess|ExpectFailure mis-models a whole class of site: a PROBE whose exit code is an ANSWER, not a verdict. `test -x` returning 1 means 'subject absent' — ambient in BOTH contexts, because production's ensure-bins responds by building and a witness's discriminating arm responds by asserting. The effect layer's anomaly glyph there is a second, cruder judgment of an event whose real adjudicator is typed logic downstream, so the honest disposition is: render ambient regardless of exit; only DISPATCH failure (the probe itself could not run) is anomalous. That distinction — subject-absent versus probe-broken — is the DaemonUnsupervised lesson applied to exit codes. Loudness does not disappear under this arm, it MOVES to the layer holding the context, which is this model's whole thesis. It is annotatable on a shared helper's own call node, once, correct for every caller — which is why it dissolves the apparent trilemma between threading a test concern through production signatures and an ambient frame that can be left open. ADMISSIBILITY GUARD (§5, what stops this becoming a silence-anything sticker): OutcomeIsData is admissible ONLY where the exit provably feeds a typed consumer — the annotated helper returns a typed observation or verdict, never unit. Both clusters it was ruled for qualify today: witness_bin_artifact_readiness returns its WitnessBinReadiness arms, and belt_actuate_spawn_member's exit feeds the belt's per-variant status mapping. The guard is checkable, so it belongs in the wiring test and eventually a lens; until that lands it is a REVIEW obligation, not a mechanical one, and this note is where the criterion is written down."

data expectation_declaration_frontier_note: String = "WHETHER a site declared, kept type-distinct from WHAT it declared (operator ruling 2026-07-25: 'we should never have an undeclared expectation; get rid of the fallback'). Until 2026-07-26 the dispatch boundary closed the gap itself — `declared_expectation.unwrap_or(ExpectSuccess)` — which is textbook absorbing fallback (§5): the missing declaration was answered with a plausible one INSIDE the callee, so it left no trace, the frequency of undeclared sites was zero by construction, and the deficit could never rank for fixing. The boundary now takes `ExpectationDeclaration = Declared(ExpectedOutcome) | UntracedDefault`, so absence is a value the caller must construct rather than a default the callee manufactures. UntracedDefault resolves to the SAME ExpectSuccess: deliberately not a behaviour change, and deliberately NOT a floor-time refusal (operator guardrail — the wall is construction at the boundary, not a refusal sweep redding sites nobody has traced). What changed is that it is typed, located, and COUNTED, surfaced as the [expectation-frontier] receipt. THE MEASURED FRONTIER at landing is real, not notional: the census finds 340 service-op call sites in dag/ + src/v2 against 16 carrying `expect:`, and one ordinary witness run reported 67 undeclared Filesystem.Read dispatches. RE-ARMING IS EVIDENCE-GATED, never bulk: a site moves to Declared when someone establishes what it actually expects, because a speculative ExpectFailure would silence a real fault — which is why 324 mechanical annotations were NOT landed with this change. 🟡 dissolve-on: the counted frontier reaches zero corpus-wide, at which point the UntracedDefault arm deletes and an undeclared site becomes a hard typed refusal — absence unwritable rather than merely counted. Executing consumer: dag/test/claim/expectation_frontier_witness_test.dag (present-and-absent pair, both live)."

type ExpectedOutcome = ExpectSuccess | ExpectFailure | OutcomeIsData

type ObservedOutcome = ObservedSuccess | ObservedFailure { exit: Int }

// StreamDisposition is NOT a second spelling of OutputDecision (DESIGN 3 — the nicknaming check was run before minting it). They grade different payloads with different obligations: OutputDecision grades a trace LINE this repo authored (Condensed dims and truncates it to shell_trace_summary_max_columns), while StreamDisposition grades a captured SUBJECT stream this repo did not author (SummarizeCounts prints byte counts INSTEAD of content, and SurfaceContent carries the neutralization obligation a rendered line never needs). The third arm is StreamSuppressed rather than a reused Suppressed only because variant names share one namespace here; it is the same grade over the other payload.
type StreamDisposition = SurfaceContent | SummarizeCounts | StreamSuppressed

fn observed_outcome_from_exit(exit: Int) -> ObservedOutcome {
  if exit == 0 {
    ObservedSuccess
  } else {
    ObservedFailure { exit: exit }
  }
}

fn outcome_diverges(expected: ExpectedOutcome, observed: ObservedOutcome) -> Bool {
  match expected {
    ExpectSuccess => match observed {
      ObservedSuccess => false
      ObservedFailure { exit: exit } => true
    }
    ExpectFailure => match observed {
      ObservedSuccess => true
      ObservedFailure { exit: exit } => false
    }
    OutcomeIsData => match observed {
      ObservedSuccess => false
      ObservedFailure { exit: exit } => false
    }
  }
}

fn divergence_disposition(diverges: Bool) -> StreamDisposition {
  if diverges {
    SurfaceContent
  } else {
    SummarizeCounts
  }
}

data effect_stream_dispatch_note: String = "Observation dissolve (operator live-log 2026-07-25): Ambient gunbc.output_policy.ShellTrace silence at Normal must not force StreamSuppressed — Anomaly Failed still surfaces via divergence alone. Quiet no longer swallows divergence either (DESIGN §5: a failing effect is never silent). Verbose still surfaces every stream (Full). The channel grades Ambient scaffolding; the stream policy grades subject content; they compose rather than conflate."

fn effect_stream_disposition(
  channel: gunbc.output_policy.OutputChannel,
  verbosity: Verbosity,
  expected: ExpectedOutcome,
  observed: ObservedOutcome
) -> StreamDisposition {
  match channel_decision(channel: channel, verbosity: verbosity) {
    Suppressed => divergence_disposition(diverges: outcome_diverges(expected: expected, observed: observed))
    Condensed => divergence_disposition(diverges: outcome_diverges(expected: expected, observed: observed))
    Full => SurfaceContent
  }
}

// This is the ONLY producer of surfaced subject text, and it neutralizes on the SurfaceContent arm. That is what makes neutralization a property of the arm rather than a caller's duty: there is no route by which un-neutralized subject text reaches a log, so no caller can forget it and no reviewer has to check (DESIGN 5 — the bad state is unwritable, not caught after the fact). A Bool field on the arm would have been the validation shape instead: it can be set false at a call site, which is precisely the escape hatch construction removes.
fn surface_effect_stream(disposition: StreamDisposition, text: String) -> String? {
  match disposition {
    SurfaceContent => Present { value: neutralize_workflow_commands(text: text) }
    SummarizeCounts => Absent
    StreamSuppressed => Absent
  }
}

data effect_stream_policy_projection_note: String = "The four corners of effect_stream_disposition at a fixed channel and verbosity, bundled the way channel_policy bundles the five channels — the seed transports evaluated verdicts across the seed/.dag boundary and holds no rule. The ObservedFailure exit literal below is representative, not fabricated: effect_stream_disposition provably does not read the exit payload, and the witness effect_stream_disposition_is_exit_invariant pins that, so the four corners are the whole function and the projection is total."

type EffectStreamPolicy {
  expect_success_observed_success: StreamDisposition
  expect_success_observed_failure: StreamDisposition
  expect_failure_observed_success: StreamDisposition
  expect_failure_observed_failure: StreamDisposition
  outcome_is_data_observed_success: StreamDisposition
  outcome_is_data_observed_failure: StreamDisposition
  subject_line_guard: String
}

fn shell_trace_stream_policy(verbosity: Verbosity) -> EffectStreamPolicy {
  EffectStreamPolicy {
    expect_success_observed_success: effect_stream_disposition(
      channel: gunbc.output_policy.ShellTrace, verbosity: verbosity,
      expected: ExpectSuccess, observed: ObservedSuccess
    )
    expect_success_observed_failure: effect_stream_disposition(
      channel: gunbc.output_policy.ShellTrace, verbosity: verbosity,
      expected: ExpectSuccess, observed: observed_outcome_from_exit(exit: 1)
    )
    expect_failure_observed_success: effect_stream_disposition(
      channel: gunbc.output_policy.ShellTrace, verbosity: verbosity,
      expected: ExpectFailure, observed: ObservedSuccess
    )
    expect_failure_observed_failure: effect_stream_disposition(
      channel: gunbc.output_policy.ShellTrace, verbosity: verbosity,
      expected: ExpectFailure, observed: observed_outcome_from_exit(exit: 1)
    )
    outcome_is_data_observed_success: effect_stream_disposition(
      channel: gunbc.output_policy.ShellTrace, verbosity: verbosity,
      expected: OutcomeIsData, observed: ObservedSuccess
    )
    outcome_is_data_observed_failure: effect_stream_disposition(
      channel: gunbc.output_policy.ShellTrace, verbosity: verbosity,
      expected: OutcomeIsData, observed: observed_outcome_from_exit(exit: 1)
    )
    subject_line_guard: subject_text_line_guard
  }
}

fn resolve_shell_trace_stream_policy(verbose: Bool, quiet: Bool) -> EffectStreamPolicy {
  shell_trace_stream_policy(verbosity: resolve_verbosity(env: VerbosityEnv { verbose: verbose, quiet: quiet }))
}

data shell_trace_observation_convergence_note: String = "DISSOLVED (operator live-log 2026-07-25, run 30142403230): shell host-effects now emit as ObservationEvents with named-intent subjects (service.op); Ambient Begin/Done are gunbc.output_policy.ShellTrace-gated (Suppressed at Normal — silent scaffolding); Anomaly Failed surfaces from divergence disposition alone (channel Suppressed no longer forces StreamSuppressed). Derived attention + ci_line_placement supersede the dual-class conflation. Keep this note as the dissolve receipt; delete when a later census no longer needs the history."

// HOMED BESIDE routine_rollup_folds, NOT BESIDE THE RENDERER, and the reason is a measured one: the
// seed resolves both verdicts by name in one entry context, and gunbc.observation_ci_render is not
// in that entry's closure while gunbc.output_policy is. Living in the renderer, this resolved to
// "no such function" on every real CI run, so per-witness folding was DISABLED and all 9478 witness
// lines printed — the exact output this lane exists to remove, silently restored by a module
// placement. A policy question consumed by the process belongs with the process's other policy
// questions; the renderer consumes the density for its own projection and does not own the verdict.
//
// The verdict is still DERIVED from std.observation's density rather than restated: a concluded
// outcome folds exactly when its class is routine, so a class that becomes an anomaly stops folding
// without an edit here.
fn concluded_outcome_folds(passed: Bool) -> Bool {
  match observation_class_density(c: if passed { ClassDone } else { ClassFailed }) {
    RoutineCollapsible => true
    SummaryAlwaysShown => false
    AnomalyExpanded => false
  }
}
