// Cloudflare R2 CI run steps: the nine run steps that mint, write, read, cache and race-probe
// Cloudflare R2 objects for a fleet dispatch. They live beside gunbc.cloudflare because their only
// domain knowledge is Cloudflare R2 (the bucket, the object, the minted token) and the receipt paths
// they stamp are the R2 domain's own. Moved out of gunbc.ci.ci_spec (gunbc.plans.closure_consolidation
// P2) verbatim; the roster gunbc.ci.ci_spec.gunbc_run_step_targets still lists their targets.
module gunbc.cloudflare.r2_ci_step

import gunbc.ci.ci_layer_roots { witness_layer_roots }
import gunbc.ci.ci_run_step_target {
  gunbc_run_step_target,
  GunbcRunStepTarget,
}
import gunbc.cloudflare.r2_permission_group_observe { r2_mint_preflight_receipt_path }
import gunbc.cloudflare.r2_bucket_ensure { r2_bucket_ensure_receipt_path }
import gunbc.cloudflare.r2_conditional_put_race_probe { race_probe_receipt_path }
import v2.workflow.gunbc_invoke_step_emit {
  gunbc_run_step_script_for_target,
}

// THE R2 WRITE MINT AND ITS PREFLIGHT ARE TWO TARGETS, AND THE ORDER IS THE SAFETY ARGUMENT.
// gunbc.cloudflare.r2_token_mint_run issues cloudflare.AccountTokens.Create, which is
// non-idempotent and whose value is returned exactly once: a run that mints and then cannot reach
// Secret Manager has left a live credential on the account that nobody holds. So the reachability
// of the two hosts the mint depends on -- secretmanager.googleapis.com for the bootstrap read and
// its own writes, api.cloudflare.com for the token API -- is OBSERVED by a read-only listing first
// (gunbc.cloudflare.r2_permission_group_observe), which touches both and mutates neither. Dispatched
// before the operator's IAM grant lands, that preflight is also where the pre-grant refusal is read
// with nothing spent.
data gunbc_ci_r2_mint_preflight_target: GunbcRunStepTarget = gunbc_run_step_target(
  module: "gunbc.cloudflare.r2_permission_group_observe",
  function: "observe_account_permission_groups_wet",
)

// THE BUCKET ENSURE PRECEDES THE MINT IN MEANING, NOT ONLY IN ORDER. A bucket-scoped token names a
// bucket resource that must exist for any request it signs to succeed, and the account's R2
// entitlement is a precondition of both; gunbc.cloudflare.r2_bucket_ensure observes the two facts
// for every allocated purpose, creates an absent bucket, and refuses an unentitled account with the
// dashboard step (gunbc#11713: nine days of failed signed requests against a bucket nobody had
// observed).
data gunbc_ci_r2_bucket_ensure_target: GunbcRunStepTarget = gunbc_run_step_target(
  module: "gunbc.cloudflare.r2_bucket_ensure",
  function: "ensure",
)

data gunbc_ci_r2_bucket_admin_mint_target: GunbcRunStepTarget = gunbc_run_step_target(
  module: "gunbc.cloudflare.r2_token_mint_run",
  function: "run_bucket_admin",
)

data gunbc_ci_r2_object_write_mint_target: GunbcRunStepTarget = gunbc_run_step_target(
  module: "gunbc.cloudflare.r2_token_mint_run",
  function: "run_object_write",
)

data gunbc_ci_r2_workspace_object_read_mint_target: GunbcRunStepTarget = gunbc_run_step_target(
  module: "gunbc.cloudflare.r2_token_mint_run",
  function: "run_workspace_object_read",
)

data gunbc_ci_r2_workspace_object_write_mint_target: GunbcRunStepTarget = gunbc_run_step_target(
  module: "gunbc.cloudflare.r2_token_mint_run",
  function: "run_workspace_object_write",
)

data gunbc_ci_r2_cache_object_read_mint_target: GunbcRunStepTarget = gunbc_run_step_target(
  module: "gunbc.cloudflare.r2_token_mint_run",
  function: "run_cache_object_read",
)

data gunbc_ci_r2_cache_object_write_mint_target: GunbcRunStepTarget = gunbc_run_step_target(
  module: "gunbc.cloudflare.r2_token_mint_run",
  function: "run_cache_object_write",
)

data gunbc_ci_r2_conditional_put_race_probe_target: GunbcRunStepTarget = gunbc_run_step_target(
  module: "gunbc.cloudflare.r2_conditional_put_race_probe",
  function: "run_r2_conditional_put_race_probe",
)

// THE MINT RUNS AS THE RUN'S OWN FEDERATED IDENTITY, AND THERE IS NO PRELUDE HERE ON PURPOSE.
// The org-actions and App control-plane steps carry shell preludes because they mint credentials
// the typed effects could not reach; this pair needs none. gunbc.auth.access_token_source
// select_access_token_source reads WIF_ACCESS_TOKEN in-process and resolves WorkloadIdentityToken,
// so the token is never interpolated into a command line -- the argv exposure
// gunbc.credential_argv_exposure measures. The only thing the step supplies is the variable the WIF
// auth step already exports.
fn gunbc_ci_r2_mint_preflight_invoke() -> String {
  gunbc_run_step_script_for_target(
    source_roots: witness_layer_roots,
    target: gunbc_ci_r2_mint_preflight_target,
    claim_run: false,
    receipt_rel: r2_mint_preflight_receipt_path
  )
}

fn gunbc_ci_r2_bucket_ensure_invoke() -> String {
  gunbc_run_step_script_for_target(
    source_roots: witness_layer_roots,
    target: gunbc_ci_r2_bucket_ensure_target,
    claim_run: false,
    receipt_rel: r2_bucket_ensure_receipt_path
  )
}

