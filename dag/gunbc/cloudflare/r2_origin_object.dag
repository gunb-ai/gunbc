  S3TransferAnswer,
  R2PutVerdict, R2ObjectStored, R2ObjectAlreadyPresent, R2ObjectTagMoved, R2PutRefused, R2PutOutcomeUnknown,
  classify_r2_put,
  R2FetchVerdict, R2FetchStagedAt, R2FetchAbsent, R2FetchRefused, R2FetchUnanswered,
  classify_r2_fetch,
  R2TransferTarget,
  WriteCredentialCustody, WriteCredentialShredded, WriteCredentialResidueRemains,
  r2_put_staged_file,
  R2Fetch, R2FetchStaged, R2FetchObjectAbsent, R2FetchStoreRefused, R2FetchTransportUnanswered, R2FetchLocalFailure,
  r2_fetch_into_staging,
}
