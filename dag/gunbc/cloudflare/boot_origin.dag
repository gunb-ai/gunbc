module gunbc.cloudflare.boot_origin

import std.types { Bool, NonEmptyStr, String }
import std.content_hash { ContentHash, Sha256Hash, Fnv1a64, Sha1Hash, Sha512Hash, Sha256Digest }
import std.human_intervention {
  HumanIntervention,
  HumanInterventionIdentity,
  FleetOnce,
  NoDischargeSiteModeled,
}
import extdeps.uri { Uri, Https, uri_https }
import gunbc.network_boot_delivery { FleetBootServiceReceipt }
import gunbc.network_boot_predecessor_census { predecessor_disposition_of, DurableOriginNotBootOrigin }
import gunbc.cloudflare.r2_origin {
  FabricDurableOrigin,
  FabricBootOrigin,
  allocated_bucket_name,
  bucket_purpose_admits_public_read,
}

// THE BOOT ORIGIN: one R2 bucket, public only through a custom domain, holding immutable
// digest-keyed boot artifacts. Its separation from the durable origin is consumed, not restated:
// gunbc.network_boot_predecessor_census disposes gunbc.cloudflare.r2_origin
// fabric_durable_origin_standing as DurableOriginNotBootOrigin, and gunbc.cloudflare.r2_origin
// allocates the two purposes two buckets and admits public read to exactly one.

// THE ARM64 BUNDLE IS KERNEL + INITRD + ROOTFS IMAGE (parent lane ruling). The chainloader is not a
// member: it lives at the site edge and only its digest is on the signed manifest.
type BootBundleMember
  = BootKernel
  | BootInitrd
  | BootRootImage

type BootBundleObject {
  member: BootBundleMember
  digest: Sha256Digest
}

// A KEY IS THE DIGEST AND NOTHING ELSE. There is no mutable name ("latest", an arch alias) because a
// key that can be re-pointed makes the object at it a different fact over time, and the signed
// manifest names bytes, not pointers. Only SHA-256 is admitted: any other family refuses rather than
// minting a key a verifier would check under the wrong algorithm.
data boot_origin_key_prefix: String = "sha256/"

fn boot_object_key(digest: Sha256Digest) -> NonEmptyStr {
  join([boot_origin_key_prefix, digest.hex as String], "") as NonEmptyStr
}

type BootObjectKeyAdmission
  = BootObjectKeyAdmitted { key: NonEmptyStr }
  | BootObjectKeyRefusedHashFamily {}

fn admit_boot_object_key(hash: ContentHash) -> BootObjectKeyAdmission {
  match hash {
    Sha256Hash(d) => BootObjectKeyAdmitted { key: boot_object_key(digest: d) }
    Fnv1a64(_) => BootObjectKeyRefusedHashFamily {}
    Sha1Hash(_) => BootObjectKeyRefusedHashFamily {}
    Sha512Hash(_) => BootObjectKeyRefusedHashFamily {}
  }
}

// WHAT A CREATE-ONLY PUT MEANS. The transport sends If-None-Match: * (extdeps.tools.curl), so an
// occupied key answers 412 rather than being overwritten. A 412 is not yet a verdict: the occupant
// is read back and its digest compared. Identical bytes are the idempotent re-publish; different
// bytes are a refusal, never an overwrite and never a success.
type BootPutAnswer
  = BootPutCreated {}
  | BootPutKeyOccupied { occupant_digest: Sha256Digest }
  | BootPutFailed { cause: NonEmptyStr }

type BootPublishVerdict
  = BootObjectPublished { key: NonEmptyStr }
  | BootObjectAlreadyIdentical { key: NonEmptyStr }
  | BootObjectOccupiedByDifferentBytes { key: NonEmptyStr, occupant: Sha256Digest }
  | BootObjectPublishFailed { key: NonEmptyStr, cause: NonEmptyStr }

fn classify_boot_publish(object: BootBundleObject, answer: BootPutAnswer) -> BootPublishVerdict {
  let key = boot_object_key(digest: object.digest)
  match answer {
    BootPutCreated {} => BootObjectPublished { key: key }
    BootPutKeyOccupied { occupant_digest: o } =>
      if (o.hex as String) == (object.digest.hex as String) {
        BootObjectAlreadyIdentical { key: key }
      } else {
        BootObjectOccupiedByDifferentBytes { key: key, occupant: o }
      }
    BootPutFailed { cause: c } => BootObjectPublishFailed { key: key, cause: c }
  }
}

// THE HOSTNAME IS UNALLOCATED, AND THAT IS AN ARM. Which Cloudflare zone and FQDN serve the boot
// origin is an operator decision this repository cannot derive; until it is recorded every readback
// refuses rather than addressing a guessed host. Same shape as gunbc.cloudflare.r2_origin
// CloudflareAccountUnallocated.
type BootOriginHostnameStanding
  = BootOriginHostnameAllocated { zone: NonEmptyStr, fqdn: NonEmptyStr }
  | BootOriginHostnameUnallocated { intervention: HumanIntervention }

data boot_origin_hostname_intervention_identity: String = "cloudflare-r2-boot-origin-hostname"

fn boot_origin_hostname_standing() -> BootOriginHostnameStanding {
  BootOriginHostnameUnallocated {
    intervention: HumanIntervention {
      identity: boot_origin_hostname_intervention_identity as HumanInterventionIdentity,
      frequency: FleetOnce,
      subject: "the boot origin's production custom-domain hostname" as NonEmptyStr,
      instruction: "Choose the Cloudflare zone on the fleet account and the FQDN that will serve the gunbai-fabric-boot bucket, then record both as the BootOriginHostnameAllocated arm of boot_origin_hostname_standing. An r2.dev hostname is refused: it is rate-limited and development-only." as NonEmptyStr,
      completion_evidence: NoDischargeSiteModeled
    }
  }
}

// THE MACHINE-FACING ENDPOINT IS THE RECEIPT'S, NOT A SECOND SPELLING. Readback addresses
// FleetBootServiceReceipt.origin_custom_domain, and an r2.dev host is refused as a production origin
// (extdeps.cloudflare.r2 r2_custom_domain_reading).
data r2_dev_host_suffix: String = ".r2.dev"

fn host_is_r2_dev(locator: String) -> Bool {
  locator == "r2.dev"
    || starts_with(s: locator, prefix: "r2.dev/")
    || ends_with(s: locator, suffix: r2_dev_host_suffix)
    || string_contains(s: locator, pattern: join([r2_dev_host_suffix, "/"], ""))
}

type BootReadbackLocator
  = BootReadbackAt { url: Uri }
  | BootReadbackRefusedR2Dev { locator: NonEmptyStr }
  | BootReadbackRefusedNotHttps {}

fn boot_readback_locator(receipt: FleetBootServiceReceipt, key: NonEmptyStr) -> BootReadbackLocator {
  let domain = receipt.origin_custom_domain
  if domain.scheme != Https {
    BootReadbackRefusedNotHttps {}
  } else if host_is_r2_dev(locator: domain.locator as String) {
    BootReadbackRefusedR2Dev { locator: domain.locator }
  } else {
    BootReadbackAt {
      url: uri_https(locator: join([domain.locator as String, "/", key as String], "") as NonEmptyStr)
    }
  }
}

// A READBACK CONFIRMS ONLY THE DIGEST IT WAS PUBLISHED UNDER. Served bytes hashing to anything else
// (a stale edge, a wrong object) are a mismatch, and an unreadable object is not a confirmation.
type BootReadbackObservation
  = BootReadbackServed { served_digest: Sha256Digest }
  | BootReadbackUnserved { cause: NonEmptyStr }

type BootReadbackVerdict
  = BootObjectReadBackConfirmed { key: NonEmptyStr }
  | BootObjectReadBackMismatch { key: NonEmptyStr, served: Sha256Digest }
  | BootObjectReadBackUnavailable { key: NonEmptyStr, cause: NonEmptyStr }

fn classify_boot_readback(object: BootBundleObject, observation: BootReadbackObservation) -> BootReadbackVerdict {
  let key = boot_object_key(digest: object.digest)
  match observation {
    BootReadbackServed { served_digest: s } =>
      if (s.hex as String) == (object.digest.hex as String) {
        BootObjectReadBackConfirmed { key: key }
      } else {
        BootObjectReadBackMismatch { key: key, served: s }
      }
    BootReadbackUnserved { cause: c } => BootObjectReadBackUnavailable { key: key, cause: c }
  }
}

// THE CACHE POLICY FOLLOWS FROM IMMUTABILITY. A digest-keyed object never changes, so the edge may
// hold it indefinitely (RFC 8246 immutable); there is nothing to purge because no key is re-pointed.
data boot_origin_cache_control: NonEmptyStr = "public, max-age=31536000, immutable"

// THE SEPARATION, AS ONE FOLD OVER ITS THREE AUTHORITIES. Distinct buckets, public read admitted to
// the boot purpose only, and the census still disposing the durable origin as not-the-boot-origin.
fn boot_origin_is_separate_from_durable_origin() -> Bool {
  let names_distinct = match allocated_bucket_name(purpose: FabricBootOrigin {}) {
    Absent => false
    Present { value: boot } =>
      match allocated_bucket_name(purpose: FabricDurableOrigin {}) {
        Absent => true
        Present { value: durable } => (boot as String) != (durable as String)
      }
  }
  let census = match predecessor_disposition_of(module_path: "gunbc.cloudflare.r2_origin", decl_name: "fabric_durable_origin_standing") {
    Absent => false
    Present { value: d } => d == DurableOriginNotBootOrigin
  }
  names_distinct
    && census
    && bucket_purpose_admits_public_read(purpose: FabricBootOrigin {})
    && !bucket_purpose_admits_public_read(purpose: FabricDurableOrigin {})
}
