module gunbc.cloudflare.r2_mint_secret_access

// WHAT THE FEDERATED RUN NEEDS IN ORDER TO MINT, AS CELLS RATHER THAN AS AN OPERATOR'S MEMORY.
// gunbc.cloudflare.r2_token_mint_run can now resolve the workload identity arm, so a dispatched
// workflow job reaches Secret Manager as fleet-cloud-convergence@ instead of as whoever pasted a
// token. That identity holds no access to the secrets the mint touches, and the remedy on offer was
// an operator typing the bindings by hand. gunbc.spark.secret_access_ensure
// refused exactly that remedy for exactly this reason: a binding a human applies once by hand is
// manual application not committed as source, so nothing records that the grant is required and
// nothing notices when it is absent, wrong, or removed. These are the same modeled cells, for the
// mint's own secrets.
//
// WHICH IDENTITY, AND WHY IT IS NOT A NEW ONE. gunbc.auth.github_gcp_federation says a federating
// domain supplies its own service account, which argues for a least-privilege SA of the mint's own.
// This lane reuses fleet-cloud-convergence@ anyway, and the reason is structural rather than
// convenience: gunbc.auth.gcp_secret_access RESOLVES the granted member from
// fleet_cloud_principal_standing() and refuses when it cannot name its subject, so the member of
// every cell this ensure can write IS the convergence principal. A dedicated SA is not a different
// row here, it is a different ensure -- member would have to become a parameter of the grant, and a
// second federated principal would have to be provisioned and bound to the pool by an operator
// ceremony strictly larger than the one this lane exists to shrink. The least privilege that is
// actually available today is therefore per-SECRET rather than per-identity, which is what every
// cell below is: one secret and one role, nothing project-wide. THE NEXT RUNG IS THE DEDICATED SA,
// and its trigger is grant member becoming a parameter of gunbc.auth.gcp_secret_access rather than a
// resolution of one standing.
//
// THE CONTAINER ITSELF IS PART OF THE SAME CEREMONY, AND IT IS NOT A CELL BECAUSE IT CANNOT BE ONE.
// secretmanager.secrets.create is a PROJECT-level permission, and a SecretAccessGrant is one secret
// and one role -- so no cell can carry it, and no per-secret cell can be written for a secret that
// does not exist. The mint therefore no longer creates its own container: gunbc.cloudflare.r2_token_mint_run
// observes it as a precondition before spending anything at Cloudflare, and refuses with the
// instruction below when it is absent. The operator's part is:
//
//   gcloud secrets create cloudflare-r2-origin-write-token --project gunbai-secrets --replication-policy automatic
//
// followed by every converge entry in this module, one per cell. That ordering matters: a cell
// cannot be bound to a secret that is not there yet.
//
// THE ROSTER IS THE DECLARATIONS AND IS DELIBERATELY NOT RESTATED HERE. An earlier revision of this
// annotation spelled the cells as a count, and the count was already wrong by the time the container
// read was added -- prose saying "three cells" above four grant functions. That is the §4c rule
// earning itself in one move: an annotation may carry why a construction has its shape and may not
// restate what the declaration structurally says, because the restatement is what rots. It rots
// worst HERE, in the one module whose whole purpose is to replace an operator's memory of which
// bindings are required; an understated roster is precisely the defect this file exists to prevent.
// The roster is the grant functions and their converge entries below, and the witness
// test.claim.r2_mint_secret_access_witness_test asserts each cell against the effect that needs it.
//
// THESE ENTRIES AUTHENTICATE AS THE HUMAN RUNNING THEM, following gunbc.spark.secret_access_ensure
// spark_secret_access_converge: the control plane that may call setIamPolicy is deliberately NOT the
// workload (gunbc.auth.gcp_secret_access no_principal_can_both_grant_and_read), so the first binding
// is acted by FleetCloudGrantAdministratorPrincipal and its realization is an operator gcloud
// session. That is by design, and it is the whole of the operator's remaining part.
import extdeps.cloud.gcp.secret_ref { SecretRef }
import extdeps.cloud.gcp.iam {
  role_secretmanager_secret_accessor,
  role_secretmanager_secret_version_adder,
  role_secretmanager_viewer,
}
import gunbc.cloudflare.r2_origin {
  cloudflare_bootstrap_custody_secret_id,
  fabric_durable_origin_write_secret_id,
}
import gunbc.secret_provision { fleet_secret_ref }
import gunbc.auth.gcp_secret_access {
  SecretAccessGrant, secret_accessor_grant, secret_access_ensure_for,
}
import gunbc.auth.access_token_source { GcloudPrintToken }
import std.resources { Network }
import std.process { ProcessExit }

fn r2_mint_bootstrap_secret_target() -> SecretRef {
  fleet_secret_ref(secret_id: cloudflare_bootstrap_custody_secret_id)
}

fn r2_mint_write_secret_target() -> SecretRef {
  fleet_secret_ref(secret_id: fabric_durable_origin_write_secret_id)
}

// ── One cell per effect the mint performs ────────────────────────────────────────────────────
// EACH CELL IS DERIVED FROM THE EFFECT THAT NEEDS IT, not from a role someone thought would be
// enough. r2_mint_bootstrap reads the pinned bootstrap version through
// gunbc.auth.secret_ref_credential (AccessVersion -> accessor); store_minted_token adds the minted
// value as a version (AddSecretVersion -> versionAdder) and then reads THAT EXACT VERSION back to
// compare bytes (AccessVersion -> accessor). The read-back is not ceremony -- it is the only part
// of the write Secret Manager guarantees -- so its accessor cell is a requirement of the write, not
// a convenience, and omitting it would refuse the mint one call after the value had been written.
fn r2_mint_bootstrap_read_grant() -> SecretAccessGrant {
  secret_accessor_grant(target: r2_mint_bootstrap_secret_target())
}

// THE CONTAINER READ IS ITS OWN CELL, AND IT IS THE ONE AN AUTHOR WOULD MOST EASILY OMIT.
// gunbc.cloudflare.r2_token_mint_run now decides whether the custody container exists BEFORE
// cloudflare.AccountTokens.Create, by a GetSecret whose permission is secretmanager.secrets.get.
// secretAccessor does not carry it -- accessor is about a version's PAYLOAD -- so without this cell
// the precondition check 403s at exactly the moment it is supposed to be protecting a
// non-idempotent, value-returned-once mint.
fn r2_mint_write_container_read_grant() -> SecretAccessGrant {
  SecretAccessGrant {
    target: r2_mint_write_secret_target(),
    role: role_secretmanager_viewer,
    condition: none,
  }
}

fn r2_mint_write_version_add_grant() -> SecretAccessGrant {
  SecretAccessGrant {
    target: r2_mint_write_secret_target(),
    role: role_secretmanager_secret_version_adder,
    condition: none,
  }
}

fn r2_mint_write_readback_grant() -> SecretAccessGrant {
  secret_accessor_grant(target: r2_mint_write_secret_target())
}

func r2_mint_bootstrap_read_access_converge() -> ProcessExit uses net: Network {
  secret_access_ensure_for(grant: r2_mint_bootstrap_read_grant(), token_source: GcloudPrintToken)
}

func r2_mint_write_container_read_access_converge() -> ProcessExit uses net: Network {
  secret_access_ensure_for(grant: r2_mint_write_container_read_grant(), token_source: GcloudPrintToken)
}

func r2_mint_write_version_add_access_converge() -> ProcessExit uses net: Network {
  secret_access_ensure_for(grant: r2_mint_write_version_add_grant(), token_source: GcloudPrintToken)
}

func r2_mint_write_readback_access_converge() -> ProcessExit uses net: Network {
  secret_access_ensure_for(grant: r2_mint_write_readback_grant(), token_source: GcloudPrintToken)
}
