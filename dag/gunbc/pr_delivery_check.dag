module gunbc.pr_delivery_check

import v2.std.algebra { any, contains, fold_list, list_reverse }
import std.algebra { Cons }
import v2.std.collection { List, Map, empty_map, map_insert }
import v2.std.optional { Absent, Present }
import v2.std.text { String }
import v2.std.logic { Bool }
import gunbc.namespace_reference_derived_closure_admission {
  ReferenceDerivedClosureAdmission,
}
import v2.lens.module_graph {
  ModuleDeclarationFact,
  ModuleDependencyEdge,
  ImportResolutionFact,
  map_lookup_where_rejected_unreachable,
}
import v2.lens.module_impact_query {
  ChangedSurfaceComplete,
  ChangedSurfacePartial,
  ChangedSurfaceRefused,
  ChangedSurfaceImpactOutcome,
  DependentsOf,
  ModuleIdentity,
  impact_seeds_for_path,
  module_impact_reading,
}

data pr_delivery_check_subject_note: String = "'Someone actually uses the feature we built' as a PR-closing criterion (operator directive 2026-08-08), and the first machine consumer of the CONFIDENCE-0 reverse query. The tool polices delivery, including its own. A declaration that nothing references is the inert-analysis tier: it typechecks, it is reviewed, it merges, and no behaviour anywhere depends on it. This check makes that state VISIBLE at acceptance rather than discovered later, by taking the PR's newly added subjects and asking the reverse query who consumes them."

data pr_delivery_uses_grounding_note: String = "'Uses' means A RESOLVING REFERENCE IN THE MERGED TREE, and nothing stronger. It does NOT mean the code executes, is reachable at runtime, or is exercised by a test — the module graph cannot ground any of those, and a check that claimed them would be asserting a rung it has no evidence for. The merged-tree part is not an aspiration either: CI checks out github.sha, which on a pull_request event IS the merge commit, so the pool this resolves against already carries base plus PR. Reading the PR branch alone would race cross-PR consumers — a consumer landing in a sibling PR would read as absent — which is why the merged state is the required view rather than a nicety."

data pr_delivery_grain_note: String = "THE HONEST GRAIN, and the reason this check refuses more than it answers today. The reverse query is MODULE grain. For a newly added MODULE that is exactly right: its dependents are its consumers. For a new DECLARATION inside an EXISTING module it is not, and the failure direction is FAIL-OPEN: the module already has dependents, so a module-grain check would report the new declaration CONSUMED while nothing references it — the inert delivery this criterion exists to catch, waved through by the tool built to catch it, on the COMMON case, since most changes add declarations to existing modules. Such a check would manufacture evidence of delivery, which is worse than no check. So that case is a distinct typed arm, counted, never silently consumed. The decl-grain machinery in v2.lens.affected_set is deliberately NOT adopted: entry_file_touched_grain_interim_note records it as not live and carrying a decl-identity/output-type conflation (edit loci are decl.OUTPUT nodes, so every Bool-returning module reads as affected), and inheriting that into an acceptance gate is the trap, not the fix. Dissolve-on: the namespace lane's DeclarationGrain refinement, at which point DeclarationGrainUnavailable disappears and those subjects get real verdicts."

data pr_delivery_unconsumed_split_note: String = "FOUND BY DOGFOODING THIS CHECK ON ITS OWN PR. The first revision had one arm for 'no non-test consumer', so a subject consumed by NOTHING AT ALL rendered as 'only its own witnesses ()' — an empty list described as if it were witnesses. Consumed-only-by-tests and consumed-by-nothing are different states with different remedies (the first has a consumer that is the wrong KIND, the second has none), and collapsing them is the state-space conflation DESIGN 5 forbids, which this carrier committed while being written to catch inert delivery. Unconsumed is now its own arm."

data pr_delivery_witness_subject_note: String = "ALSO FOUND BY DOGFOODING. A newly added WITNESS module is a harness-invoked entry point: nothing imports a test, by construction, so judging it by inbound reference edges makes every new witness read as undelivered forever — a systematic false alarm that would train reviewers to ignore the receipt, which is worse than the check not existing. A test module subject is therefore WitnessEntryPoint: its consumer is the claim harness, an execution relation this graph does not carry, so the honest answer is that this check does not judge it rather than that it failed. This is NOT an exemption for untested delivery — the feature module still needs a real consumer, and a witness that nothing runs is the enrollment question the floor already owns, a different check with a different authority."

data pr_delivery_dogfood_note: String = "DESIGNED-IN, stated up front so no reviewer meets it as a gotcha: this checker's own PR verdicts CONSUMED only because it lands as a NEW MODULE whose consumer is the acceptance flow that invokes it. Had it instead grown as declarations inside an existing module, its own verdict would be DeclarationGrainUnavailable — the check would be unable to prove its own delivery. That is not a defect to hide; it is the same grain limit the note above declares, applied to the tool itself, and it is the sharpest available argument for prioritising DeclarationGrain."

type DeliveryVerdict
  = Consumed {
      consumers: List<ModuleIdentity>
    }
  | SelfConsumedOnly {
      test_consumers: List<ModuleIdentity>
    }
  | Unconsumed
  | WitnessEntryPoint {
      path: String
    }
  | ConsumerPending {
      work_item: String
    }
  | DeclarationGrainUnavailable {
      path: String
    }
  | DeliveryUndecidable {
      cause: String
    }

data pr_delivery_subject_carrier_note: String = "Found by review 50637 on this PR, and it is the SAME conflation capsule 1 made unwritable in the query core, re-opened one layer up by this receipt. ModuleIdentity is a record precisely so a path cannot be passed where a module identity is required; a DeclarationGrainUnavailable row then set subject: ModuleIdentity { name: path }, putting a file path into the identity field, so any consumer keying on subject rather than on verdict.path would mis-identify it. A modified path whose declarations this check cannot see is genuinely NOT a module subject — that is the whole content of the verdict — so the subject axis is a coproduct: ModuleSubject carries the identity, PathSubject carries the storage location, and neither can impersonate the other. The wall is that PathSubject has no ModuleIdentity field to fill, so the substitution has no constructor rather than a convention against it."

type DeliverySubject
  = ModuleSubject {
      module: ModuleIdentity
    }
  | PathSubject {
      path: String
    }

fn pr_delivery_subject_label(subject: DeliverySubject) -> String {
  match subject {
    ModuleSubject { module } => module.name
    PathSubject { path } => path
  }
}

type DeliverySubjectVerdict {
  subject: DeliverySubject
  verdict: DeliveryVerdict
}

type DeliveryReceipt {
  subjects: List<DeliverySubjectVerdict>
  declaration_grain_unavailable_count: Int
  consumed_count: Int
  self_consumed_only_count: Int
  consumer_pending_count: Int
  undecidable_count: Int
  unconsumed_count: Int
  witness_entry_point_count: Int
}

data no_delivery_subject_verdicts: List<DeliverySubjectVerdict> = []

data no_delivery_modules: List<ModuleIdentity> = []

data pr_delivery_test_path_markers: List<String> = [
  "/test/",
  "_test.dag",
  "/tests/",
]

data pr_delivery_self_consumption_note: String = "A consumer that is only the subject's own witness suite is NOT delivery — it is the inert-analysis tier the operator named: the thing exists, it is tested, and nothing in the system depends on it. SelfConsumedOnly is therefore a distinct verdict rather than a flavour of Consumed, and it refuses closure as 'delivered'. Test membership is decided by path markers, which is a heuristic over PRESENTATION rather than a structural fact — a module is a test because of where it lives, not because the graph says so. That is declared here rather than hidden: the honest structural form is a declared witness role on the module, and until that exists this axis is convention. It is deliberately conservative in the direction that matters: a non-test consumer misread as a test would understate delivery (refusing a PR that is fine), never overstate it."

fn pr_delivery_path_is_test(path: String) -> Bool {
  any(
    xs: pr_delivery_test_path_markers,
    predicate: fn(marker) { string_contains(path, marker) }
  )
}

fn pr_delivery_module_paths(
  nodes: List<ModuleDeclarationFact>,
  module_id: ModuleIdentity
) -> List<String> {
  list_reverse(xs: fold_list(
    xs: nodes,
    empty: pr_delivery_no_paths,
    cons: fn(acc, node) {
      if node.module == module_id.name {
        pr_delivery_prepend_path(acc: acc, path: node.path)
      } else {
        acc
      }
    }
  ))
}

data pr_delivery_no_paths: List<String> = []

fn pr_delivery_prepend_path(acc: List<String>, path: String) -> List<String> {
  Cons { head: path, tail: acc }
}

fn pr_delivery_prepend_module(
  acc: List<ModuleIdentity>,
  module_id: ModuleIdentity
) -> List<ModuleIdentity> {
  Cons { head: module_id, tail: acc }
}

fn pr_delivery_module_is_test(
  nodes: List<ModuleDeclarationFact>,
  module_id: ModuleIdentity
) -> Bool {
  any(
    xs: pr_delivery_module_paths(nodes: nodes, module_id: module_id),
    predicate: fn(path) { pr_delivery_path_is_test(path: path) }
  )
}

fn pr_delivery_consumers_excluding_self(
  reached: List<ModuleIdentity>,
  subject: ModuleIdentity
) -> List<ModuleIdentity> {
  list_reverse(xs: fold_list(
    xs: reached,
    empty: no_delivery_modules,
    cons: fn(acc, m) {
      if m.name == subject.name {
        acc
      } else {
        pr_delivery_prepend_module(acc: acc, module_id: m)
      }
    }
  ))
}

fn pr_delivery_non_test_consumers(
  nodes: List<ModuleDeclarationFact>,
  consumers: List<ModuleIdentity>
) -> List<ModuleIdentity> {
  list_reverse(xs: fold_list(
    xs: consumers,
    empty: no_delivery_modules,
    cons: fn(acc, m) {
      if pr_delivery_module_is_test(nodes: nodes, module_id: m) {
        acc
      } else {
        pr_delivery_prepend_module(acc: acc, module_id: m)
      }
    }
  ))
}

fn pr_delivery_verdict_for_module(
  subject: ModuleIdentity,
  edges: List<ModuleDependencyEdge>,
  nodes: List<ModuleDeclarationFact>,
  import_facts: List<ImportResolutionFact>,
  admissions: List<ReferenceDerivedClosureAdmission>
) -> DeliveryVerdict {
  let consumers = pr_delivery_consumers_excluding_self(
    reached: module_impact_reading(
      seeds: [subject],
      direction: DependentsOf,
      edges: edges,
      nodes: nodes,
      import_facts: import_facts,
      admissions: admissions
    ).reached,
    subject: subject
  )
  let non_test = pr_delivery_non_test_consumers(nodes: nodes, consumers: consumers)
  if pr_delivery_module_is_test(nodes: nodes, module_id: subject) {
    WitnessEntryPoint {
      path: pr_delivery_first_path_of(nodes: nodes, module_id: subject)
    }
  } else {
    if any(xs: non_test, predicate: fn(_) { true }) {
      Consumed { consumers: non_test }
    } else {
      if any(xs: consumers, predicate: fn(_) { true }) {
        SelfConsumedOnly { test_consumers: consumers }
      } else {
        Unconsumed
      }
    }
  }
}

data pr_delivery_first_path_note: String = "Found by review 50634 on this PR. The fold's cons discarded its accumulator and returned the item, so this yielded the LAST declared path while its name promised the first — a name standing where a fact was owed, harmless today only because the parse snapshot enforces one path per module, and therefore exactly the kind of claim that rots silently when the many-to-many end state the module-identity-vs-storage lane stages actually lands. Folding the reversed list makes last-of-reversed BE first, so the name is now true by construction rather than by a coincidence of the current 1:1 mapping."

fn pr_delivery_first_path_of(
  nodes: List<ModuleDeclarationFact>,
  module_id: ModuleIdentity
) -> String {
  fold_list(
    xs: list_reverse(xs: pr_delivery_module_paths(nodes: nodes, module_id: module_id)),
    empty: module_id.name,
    cons: fn(acc, path) { path }
  )
}

data pr_delivery_added_module_note: String = "An added PATH yields a delivery subject only when it declares a module in the merged pool. An added path that declares no module — a .rs file, a workflow yml, a doc — is not a subject of this graph at all and is simply not carried; that is different from a .dag path whose declaration the pool does not carry, which is a genuine gap. The distinction this carrier CAN see is only 'resolved to a module or not', so an added path with no module produces no subject rather than a fabricated one."

fn pr_delivery_subjects_for_added_paths(
  nodes: List<ModuleDeclarationFact>,
  added_paths: List<String>
) -> List<ModuleIdentity> {
  list_reverse(xs: fold_list(
    xs: added_paths,
    empty: no_delivery_modules,
    cons: fn(acc, path) {
      fold_list(
        xs: impact_seeds_for_path(nodes: nodes, path: path),
        empty: acc,
        cons: fn(inner, m) { pr_delivery_prepend_module(acc: inner, module_id: m) }
      )
    }
  ))
}

data pr_delivery_modified_subject_note: String = "A changed path that is NOT newly added is a modification to an existing module, so anything this PR added inside it is a DECLARATION, which module grain cannot see. Those paths become DeclarationGrainUnavailable subjects — counted, visible, never silently consumed. This is where the fail-open would have been."

fn pr_delivery_modified_dag_paths(
  changed_paths: List<String>,
  added_paths: List<String>,
  nodes: List<ModuleDeclarationFact>
) -> List<String> {
  let added_set = fold_list(
    xs: added_paths,
    empty: empty_map(),
    cons: fn(acc, path) { map_insert(m: acc, key: path, value: path) }
  )
  list_reverse(xs: fold_list(
    xs: changed_paths,
    empty: pr_delivery_no_paths,
    cons: fn(acc, path) {
      if pr_delivery_path_in_set(set: added_set, path: path) {
        acc
      } else {
        if any(
          xs: impact_seeds_for_path(nodes: nodes, path: path),
          predicate: fn(_) { true }
        ) {
          pr_delivery_prepend_path(acc: acc, path: path)
        } else {
          acc
        }
      }
    }
  ))
}

fn pr_delivery_path_in_set(set: Map<String, String>, path: String) -> Bool {
  match map_lookup_where_rejected_unreachable(m: set, key: path) {
    Present { value: _ } => true
    Absent => false
  }
}

fn pr_delivery_prepend_verdict(
  acc: List<DeliverySubjectVerdict>,
  item: DeliverySubjectVerdict
) -> List<DeliverySubjectVerdict> {
  Cons { head: item, tail: acc }
}

fn pr_delivery_count_verdicts(
  subjects: List<DeliverySubjectVerdict>,
  predicate: fn(DeliveryVerdict) -> Bool
) -> Int {
  fold_list(
    xs: subjects,
    empty: 0,
    cons: fn(acc, row) {
      if predicate(row.verdict) {
        acc + 1
      } else {
        acc
      }
    }
  )
}

fn pr_delivery_is_consumed(verdict: DeliveryVerdict) -> Bool {
  match verdict {
    Consumed { consumers: _ } => true
    SelfConsumedOnly { test_consumers: _ } => false
    ConsumerPending { work_item: _ } => false
    DeclarationGrainUnavailable { path: _ } => false
    DeliveryUndecidable { cause: _ } => false
    Unconsumed => false
    WitnessEntryPoint { path: _ } => false
  }
}

fn pr_delivery_is_self_consumed(verdict: DeliveryVerdict) -> Bool {
  match verdict {
    Consumed { consumers: _ } => false
    SelfConsumedOnly { test_consumers: _ } => true
    ConsumerPending { work_item: _ } => false
    DeclarationGrainUnavailable { path: _ } => false
    DeliveryUndecidable { cause: _ } => false
    Unconsumed => false
    WitnessEntryPoint { path: _ } => false
  }
}

fn pr_delivery_is_pending(verdict: DeliveryVerdict) -> Bool {
  match verdict {
    Consumed { consumers: _ } => false
    SelfConsumedOnly { test_consumers: _ } => false
    ConsumerPending { work_item: _ } => true
    DeclarationGrainUnavailable { path: _ } => false
    DeliveryUndecidable { cause: _ } => false
    Unconsumed => false
    WitnessEntryPoint { path: _ } => false
  }
}

fn pr_delivery_is_grain_unavailable(verdict: DeliveryVerdict) -> Bool {
  match verdict {
    Consumed { consumers: _ } => false
    SelfConsumedOnly { test_consumers: _ } => false
    ConsumerPending { work_item: _ } => false
    DeclarationGrainUnavailable { path: _ } => true
    DeliveryUndecidable { cause: _ } => false
    Unconsumed => false
    WitnessEntryPoint { path: _ } => false
  }
}

fn pr_delivery_is_undecidable(verdict: DeliveryVerdict) -> Bool {
  match verdict {
    Consumed { consumers: _ } => false
    SelfConsumedOnly { test_consumers: _ } => false
    ConsumerPending { work_item: _ } => false
    DeclarationGrainUnavailable { path: _ } => false
    DeliveryUndecidable { cause: _ } => true
    Unconsumed => false
    WitnessEntryPoint { path: _ } => false
  }
}

fn pr_delivery_is_unconsumed(verdict: DeliveryVerdict) -> Bool {
  match verdict {
    Consumed { consumers: _ } => false
    SelfConsumedOnly { test_consumers: _ } => false
    ConsumerPending { work_item: _ } => false
    DeclarationGrainUnavailable { path: _ } => false
    DeliveryUndecidable { cause: _ } => false
    Unconsumed => true
    WitnessEntryPoint { path: _ } => false
  }
}

fn pr_delivery_is_witness_entry(verdict: DeliveryVerdict) -> Bool {
  match verdict {
    Consumed { consumers: _ } => false
    SelfConsumedOnly { test_consumers: _ } => false
    ConsumerPending { work_item: _ } => false
    DeclarationGrainUnavailable { path: _ } => false
    DeliveryUndecidable { cause: _ } => false
    Unconsumed => false
    WitnessEntryPoint { path: _ } => true
  }
}
fn pr_delivery_receipt_of(subjects: List<DeliverySubjectVerdict>) -> DeliveryReceipt {
  DeliveryReceipt {
    subjects: subjects,
    declaration_grain_unavailable_count: pr_delivery_count_verdicts(subjects: subjects, predicate: pr_delivery_is_grain_unavailable),
    consumed_count: pr_delivery_count_verdicts(subjects: subjects, predicate: pr_delivery_is_consumed),
    self_consumed_only_count: pr_delivery_count_verdicts(subjects: subjects, predicate: pr_delivery_is_self_consumed),
    consumer_pending_count: pr_delivery_count_verdicts(subjects: subjects, predicate: pr_delivery_is_pending),
    undecidable_count: pr_delivery_count_verdicts(subjects: subjects, predicate: pr_delivery_is_undecidable),
    unconsumed_count: pr_delivery_count_verdicts(subjects: subjects, predicate: pr_delivery_is_unconsumed),
    witness_entry_point_count: pr_delivery_count_verdicts(subjects: subjects, predicate: pr_delivery_is_witness_entry)
  }
}

data pr_delivery_undecidable_note: String = "The same law the reverse query obeys, applied one level up: an incomplete view may never prove emptiness. If the changed-surface outcome is Partial or Refused, this check cannot conclude that nothing consumes a subject, because the population it would be reasoning over is itself admittedly incomplete. Every subject is therefore Undecidable, carrying the reason — never a confident SelfConsumedOnly derived from a view that was missing inputs. Getting this backwards is how a delivery gate turns into a delivery fabricator."

data pr_delivery_grain_rows_survive_partial_note: String = "Found by review 50637 on this PR, and it was a fail-open of the exact class this check exists to surface. The Partial and Refused arms built rows for ADDED subjects only and never called pr_delivery_modified_dag_paths, so a mixed PR — one modified .dag plus any unresolved path, the ordinary shape — produced a receipt with NO DeclarationGrainUnavailable row for the code change at all. The highest-priority subject class disappeared precisely when the surface was already incomplete, which is the silent narrow DESIGN 5 names: an incomplete view rendering as 'nothing to report' rather than 'here is what I cannot answer'. WHY THE VERDICT IS UNCHANGED BY PARTIAL, rather than being demoted to Undecidable: grain unavailability is a property of THIS CHECK'S RESOLUTION, not of the observed surface. The reverse query being incomplete cannot make a modified module's declarations more visible, and it cannot make them less visible either — the answer was already 'module grain cannot see this'. So the modified rows are emitted identically in all three arms, and only the ADDED subjects degrade to Undecidable, because those are the ones whose verdict actually depended on the completeness of the population. My own witness missed this because its modified-path set was empty; the control now authors a genuinely mixed surface."

fn pr_delivery_modified_path_rows(
  acc: List<DeliverySubjectVerdict>,
  modified_paths: List<String>
) -> List<DeliverySubjectVerdict> {
  fold_list(
    xs: modified_paths,
    empty: acc,
    cons: fn(inner, path) {
      pr_delivery_prepend_verdict(
        acc: inner,
        item: DeliverySubjectVerdict {
          subject: PathSubject { path: path },
          verdict: DeclarationGrainUnavailable { path: path }
        }
      )
    }
  )
}

fn pr_delivery_undecidable_receipt(
  subjects: List<ModuleIdentity>,
  modified_paths: List<String>,
  cause: String
) -> DeliveryReceipt {
  pr_delivery_receipt_of(
    subjects: list_reverse(xs: pr_delivery_modified_path_rows(
      acc: fold_list(
        xs: subjects,
        empty: no_delivery_subject_verdicts,
        cons: fn(acc, m) {
          pr_delivery_prepend_verdict(
            acc: acc,
            item: DeliverySubjectVerdict {
              subject: ModuleSubject { module: m },
              verdict: DeliveryUndecidable { cause: cause }
            }
          )
        }
      ),
      modified_paths: modified_paths
    ))
  )
}

fn pr_delivery_check(
  outcome: ChangedSurfaceImpactOutcome,
  changed_paths: List<String>,
  added_paths: List<String>,
  edges: List<ModuleDependencyEdge>,
  nodes: List<ModuleDeclarationFact>,
  import_facts: List<ImportResolutionFact>,
  admissions: List<ReferenceDerivedClosureAdmission>
) -> DeliveryReceipt {
  let added_subjects = pr_delivery_subjects_for_added_paths(
    nodes: nodes,
    added_paths: added_paths
  )
  let modified_paths = pr_delivery_modified_dag_paths(
    changed_paths: changed_paths,
    added_paths: added_paths,
    nodes: nodes
  )
  match outcome {
    ChangedSurfaceRefused { reason } =>
      pr_delivery_undecidable_receipt(
        subjects: added_subjects,
        modified_paths: modified_paths,
        cause: "the changed surface was refused: {reason}"
      )
    ChangedSurfacePartial { reading: _, unresolved_subjects: _ } =>
      pr_delivery_undecidable_receipt(
        subjects: added_subjects,
        modified_paths: modified_paths,
        cause: "the changed-surface outcome is Partial — an incomplete view may not prove that nothing consumes a subject"
      )
    ChangedSurfaceComplete { reading: _ } =>
      pr_delivery_receipt_of(
        subjects: pr_delivery_verdicts_for_subjects(
          added_subjects: added_subjects,
          modified_paths: modified_paths,
          edges: edges,
          nodes: nodes,
          import_facts: import_facts,
          admissions: admissions
        )
      )
  }
}

fn pr_delivery_verdicts_for_subjects(
  added_subjects: List<ModuleIdentity>,
  modified_paths: List<String>,
  edges: List<ModuleDependencyEdge>,
  nodes: List<ModuleDeclarationFact>,
  import_facts: List<ImportResolutionFact>,
  admissions: List<ReferenceDerivedClosureAdmission>
) -> List<DeliverySubjectVerdict> {
  let added_rows = fold_list(
    xs: added_subjects,
    empty: no_delivery_subject_verdicts,
    cons: fn(acc, m) {
      pr_delivery_prepend_verdict(
        acc: acc,
        item: DeliverySubjectVerdict {
          subject: ModuleSubject { module: m },
          verdict: pr_delivery_verdict_for_module(
            subject: m,
            edges: edges,
            nodes: nodes,
            import_facts: import_facts,
            admissions: admissions
          )
        }
      )
    }
  )
  list_reverse(xs: pr_delivery_modified_path_rows(
    acc: added_rows,
    modified_paths: modified_paths
  ))
}
