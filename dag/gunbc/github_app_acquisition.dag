// WHAT THIS MODULE IS FOR. Creating a GitHub App by hand is a form with a name, a URL, a webhook
// block and twenty-two permission toggles, and the operator has done it repeatedly because nothing
// declared its shape. The shape is declared once below, rendered to the manifest document GitHub's
// registration flow accepts, and the App that comes back is read INDEPENDENTLY through the public
// app record rather than believed from the exchange's own reply.
//
// WHY THIS IS THE AUTOMATABLE HALF AND WHERE IT STOPS. The code-for-credentials exchange
// authenticates with the temporary code alone and needs no JWT, so it runs in-process. Everything
// downstream of the stored private key - listing installations, minting an installation access token -
// requires an RS256-signed App JWT. The corpus signs one only on a host holding the key FILE
// (the extdeps.auth.jws signer, realized by gunbc.jws_signer_realize, performed by gunbc.github_effect_perform), and this
// acquisition flow runs where the stored key is not custodied as such a file, so it does not consume
// that signer: extdeps.github.app declares github.AppInstallations with auth_source EnvVar so an
// external step supplies the JWT at the transport. The wiring that would retire that is a key
// custody for the census App, not a signer.

// THE APP'S SHAPE, DECLARED ONCE. Each permission is here because a specific census read needs it,
// and the set is what makes an installation worth having: an installation multiplies this fleet's
// GitHub API budget, and it grants exactly these axes and no more.
data census_app_permissions: List<GitHubAppPermission> = [
  GitHubAppPermission { name: MetadataAxis, access: AppAccessRead },
  GitHubAppPermission { name: ContentsAxis, access: AppAccessRead },
  GitHubAppPermission { name: IssuesAxis, access: AppAccessRead },
  GitHubAppPermission { name: PullRequestsAxis, access: AppAccessRead },
  GitHubAppPermission { name: ChecksAxis, access: AppAccessRead },
  GitHubAppPermission { name: ActionsAxis, access: AppAccessRead },
  GitHubAppPermission { name: WorkflowsAxis, access: AppAccessRead }
]

// THE EVENTS THAT ARE WORTH RECEIVING ARE THE ONES THAT CHANGE THE BUDGET. An installation appearing
// or its repository selection changing is the only thing about this App that we do not learn by
// polling, so those two are the subscription and nothing else is. hook_attributes.active is false
// because no receiver exists yet: the manifest schema REQUIRES a hook URL, so the switch is what
// carries "nothing listens here" honestly rather than an omitted field.
data census_app_default_events: List<GitHubWebhookEvent> = [
  WebhookInstallation,
  WebhookInstallationRepositories
]

// THE NAME IS THE IDENTITY, AND IT IS A CONSTANT. GitHub App names are unique across GitHub, so a
// second registration under this name is refused upstream - which is the only reason a duplicate
// mint is structurally bounded rather than merely unlikely. Nothing in this module derives the name
// from a clock, a run id, or a nonce: a name carrying a nonce would make every re-run's registration
// SUCCEED, and the fleet would accumulate one App per run with the pem of each lost on the next.
// The per-run varying value in this flow is the state nonce, and it binds a redirect to a request;
// it never reaches the name.
data census_app_name: NonEmptyStr = "gunbc-global-census"

// THE MANIFEST'S IDENTITY, MADE A TYPE RATHER THAN LEFT AS TWO LOOSE FACTS. What makes "the App we
// meant" re-findable is the NAME (unique across GitHub, so upstream refuses a second registration
// under it) together with WHERE it is registered (a user App and an organization App of the same
// name are different registrations under different consent holders). Every human step and every
// registration URL takes this rather than the bare name, so a second App this fleet adopts carries
// its own identity instead of borrowing the census App's.
type GitHubAppDeclaredIdentity {
  name: NonEmptyStr
  target: GitHubAppRegistrationTarget
}

data census_app_homepage: Uri = uri_https(locator: "github.com/gunb-ai/gunbc")

// A WEBHOOK URL WITH NO RECEIVER IS STILL A DECLARED URL. It points at the repository rather than at
// a fabricated endpoint, so a delivery attempt fails visibly against a real host instead of resolving
// to something we do not own. Paired with active: false, nothing is delivered at all.
data census_app_hook_url: Uri = uri_https(locator: "github.com/gunb-ai/gunbc/blob/main/DESIGN.md")

// REDIRECT_URL IS DECLARED AND HAS NO SERVER BEHIND IT, AND THAT IS STATED RATHER THAN IMPLIED.
// Without a redirect_url GitHub sends the owner to the new App's settings page and the temporary code
// is never shown, so the field is effectively required for a flow a human can complete by hand.
// Declaring one this fleet owns and does not serve means the browser lands on a page that does not
// answer while the address bar carries ?code= and &state= - which is exactly what the operator copies
// into the two handoff files. A URL we do not own would hand a bearer credential to a third party in
// their referer and access logs; that is the reason this is gunb.ai rather than a convenient paste bin.
data census_app_redirect_url: Uri = uri_https(locator: "gunb.ai/github-app-manifest-return")

data census_app_registration_target: GitHubAppRegistrationTarget = RegisterUnderOrganization { organization: "gunb-ai" }

data census_app_identity: GitHubAppDeclaredIdentity = GitHubAppDeclaredIdentity {
  name: census_app_name,
  target: census_app_registration_target,
}

data census_app_manifest: GitHubAppManifest = GitHubAppManifest {
  name: census_app_name,
  url: census_app_homepage,
  hook_attributes: GitHubAppHookAttributes { url: census_app_hook_url, active: false },
  redirect_url: Present { value: census_app_redirect_url },
  callback_urls: [],
  setup_url: none,
  description: "Reads public repository metadata for the gunbc global GitHub census. Installations multiply this fleet's API budget; the App holds read-only axes and no write access.",
  public: AppPublic,
  default_events: census_app_default_events,
  request_oauth_on_install: false,
  setup_on_update: false,
  default_permissions: census_app_permissions,
}

// WHERE THE PRIVATE KEY LIVES, NAMED BEFORE THE EXCHANGE THAT PRODUCES IT. The exchange returns the
// pem ONCE and no endpoint re-reads it; an App whose pem is lost cannot be authenticated as, cannot
// mint installation tokens, and cannot be re-created under the same name because the name is taken.
// So the custody site is a declared fact of this module rather than a decision the actuator makes at
// the moment it is holding the only copy. version is "latest" because the secret does not exist yet:
// the FIRST AddVersion mints version 1, and a converge that named a version here would be asserting a
// resource it has not created. hash_state is HashPending for the same reason.
data census_app_private_key_custody: SecretRef = SecretRef {
  project: fleet_secrets_gcp_project,
  secret: "github-app-gunbc-global-census-pem" as NonEmptyStr,
  version: "latest" as NonEmptyStr,
  hash_state: HashPending,
}

data census_app_webhook_secret_custody: SecretRef = SecretRef {
  project: fleet_secrets_gcp_project,
  secret: "github-app-gunbc-global-census-webhook-secret" as NonEmptyStr,
  version: "latest" as NonEmptyStr,
  hash_state: HashPending,
}

data census_app_client_secret_custody: SecretRef = SecretRef {
  project: fleet_secrets_gcp_project,
  secret: "github-app-gunbc-global-census-client-secret" as NonEmptyStr,
  version: "latest" as NonEmptyStr,
  hash_state: HashPending,
}

type GitHubAppCustody {
  pem: SecretRef
  webhook_secret: SecretRef
  client_secret: SecretRef
}

fn census_app_custody() -> GitHubAppCustody {
  GitHubAppCustody {
    pem: census_app_private_key_custody,
    webhook_secret: census_app_webhook_secret_custody,
    client_secret: census_app_client_secret_custody,
  }
}

// CUSTODY HAS TWO HOPS AND THE MODEL SAYS SO, BECAUSE A CONVERGE THAT LOSES THE PEM HAS LOST THE APP.
// The declared DESTINATION is the SecretRef above, in GCP Secret Manager. This process cannot write
// there: gunbc.secret_provision_actuator reaches AddVersion through a WIF-authorized identity that a
// local acquire run does not hold, and that is its own converge. What this process CAN do -- and
// must, because the exchange returns the private key once and no endpoint returns it again -- is put
// the bytes somewhere durable before it exits.
//
// SO THE FIRST HOP IS A FILE, AND CALLING IT THE DESTINATION WOULD BE THE LIE. It is a HANDOFF, in
// the same sense and the same directory as the code and state files the operator hands inward: the
// operator moves it to Secret Manager and deletes it. The frontier row on the instrument's write
// names the AddVersion route that dissolves this hop.
//
// WHY THIS IS NOT PROSE ASSERTING A CONSUMER. An earlier cut of this module said the secrets "are
// written to the custody sites by gunbc.secret_provision" -- and nothing in the closure imported or
// called it, so the acquire path read the pem out of the reply, told the operator to store it, and
// dropped it. That is specification-without-execution on the one value in this flow that cannot be
// re-obtained (caught by review 67436). The paths below are consumed by an executing write.
data census_app_custody_handoff_directory: String = ".gunbc"

// THE HANDOFF IS ADDRESSED BY THE DECLARED NAME, NOT BY THE RETURNED SLUG, and getting this backwards
// is a bug this module briefly had. The slug is only known AFTER the exchange, so a slug-keyed write
// and a name-keyed read find each other only when GitHub's name-to-slug transformation happens to be
// the identity -- which this module explicitly refuses to assume anywhere else. The NAME is what is
// known on both sides of the exchange and is the identity by which this whole flow is re-findable, so
// it addresses the files; the slug lives INSIDE the identity document, where it is data rather than
// a path.
//
// IT IS STILL CHECKED RATHER THAN TRUSTED. The name is declared here today, but the check costs
// nothing and the carrier is reachable with any NonEmptyStr: a name carrying a separator or a parent
// reference would write the private key outside the git-ignored handoff directory.
fn custody_name_is_path_safe(name: NonEmptyStr) -> Bool {
  !string_contains(s: name as String, pattern: "/")
    && !string_contains(s: name as String, pattern: "\\")
    && !string_contains(s: name as String, pattern: ".")
    && !((name as String) == "")
}

// THE REGISTRATION FORM IS ADDRESSED HERE TOO, AND EXCLUDING IT IS WHAT LEFT A WRITE WITH NO WALL.
// It is not a secret -- the manifest is public and the document carries none -- so an earlier cut of
// this PR built its path with a bare custody_handoff_path call, reasoning that a non-secret does not
// belong in a custody record. The reasoning was about the wrong property. What this record IS, is the
// ADDRESSING of the per-App files in the handoff directory, and its constructor is the one place the
// name is checked before it becomes a path; a file that skips it is a Filesystem.Write whose target a
// name carrying a separator sends outside .gunbc/, with a modeled refusal for exactly that state
// sitting one function away (review 69495, DESIGN 5: make the wrong state unwritable rather than
// catching it). Membership is decided by "is this a path built from the App name", not by "is this
// file secret".
type CustodyHandoffPaths {
  pem: String
  webhook_secret: String
  client_secret: String
  identity: String
  registration_form: String
}

type CustodyHandoffAddressing
  = CustodyAddressed { paths: CustodyHandoffPaths }
  | CustodyNameNotPathSafe { name: NonEmptyStr }

fn custody_handoff_path(name: NonEmptyStr, suffix: String) -> String {
  join([census_app_custody_handoff_directory, "/github-app-", name as String, suffix], "")
}

fn custody_handoff_addressing(name: NonEmptyStr) -> CustodyHandoffAddressing {
  if custody_name_is_path_safe(name: name) {
    CustodyAddressed {
      paths: CustodyHandoffPaths {
        pem: custody_handoff_path(name: name, suffix: ".pem"),
        webhook_secret: custody_handoff_path(name: name, suffix: ".webhook-secret"),
        client_secret: custody_handoff_path(name: name, suffix: ".client-secret"),
        identity: custody_handoff_path(name: name, suffix: ".identity"),
        registration_form: custody_handoff_path(name: name, suffix: "-register.html"),
      }
    }
  } else {
    CustodyNameNotPathSafe { name: name }
  }
}

// THE IDENTITY FILE IS NOT A SECRET AND IS THE ACQUISITION RECORD ITSELF. Without it an operator
// holding three secret files cannot say which App they belong to -- but more than that, this document
// is what the NEXT run parses to learn that the App exists, which is why no human transcribes an id
// into source. It carries a record= line in the shape census_app_declared_adoption takes, so an
// operator ADOPTING an App can write that one line by hand and get the same reading.
fn custody_identity_document(issuance: GitHubAppCredentialIssuance) -> String {
  match issuance {
    CredentialIssuedOnce { app_id: id, slug: s, pem: _, webhook_secret: _, client_id: cid, client_secret: _ } =>
      join(
        [
          "app_id=", to_string(id.value), "\n",
          "slug=", s as String, "\n",
          "client_id=", cid as String, "\n",
          "record=AppAcquired { app_id: GitHubAppId { value: ", to_string(id.value), " }, slug: \"", s as String, "\" }\n",
          "destination_pem_secret=", census_app_private_key_custody.secret as String, "\n",
          "destination_webhook_secret=", census_app_webhook_secret_custody.secret as String, "\n",
          "destination_client_secret=", census_app_client_secret_custody.secret as String, "\n",
        ],
        "",
      )
  }
}

// THE SLUG IS NOT DERIVABLE FROM THE NAME AND THIS MODULE DOES NOT PRETEND IT IS. GitHub publishes
// no rule for the name-to-slug transformation, so inventing one would make the public readback address
// an App we guessed at - and a 404 from a wrong guess is indistinguishable from a 404 for an App that
// does not exist, which is exactly the confusion that authorizes a duplicate mint. The slug is a fact
// the conversion RETURNS, so before the first acquisition there is nothing to read and the honest
// state says so. After it, the operator records the returned slug here, the same way
// gunbc.review_sheet_operator records a spreadsheet id: the identifier is a declared fact, not a
// caller string.
type GitHubAppAcquisitionRecord
  = AppNeverAcquired
  | AppAcquired { app_id: GitHubAppId, slug: NonEmptyStr }

// THE ACQUISITION RECORD IS READ, NOT TRANSCRIBED (operator ruling, 2026-09-18). An earlier cut
// declared it here as AppNeverAcquired and instructed the operator to hand-copy the app id and slug
// out of a diagnostic into this row. That is the converge's OWN OUTPUT: the conversion response
// carries both, so asking a human to retype them is asking them to be the wire, and it put the one
// fact the next run's observation is addressed by behind a source edit nobody would notice was
// missing. The actuation writes them to the custody handoff beside the pem, and the observation
// parses them back from there.
//
// THE DECLARED ROW SURVIVES FOR ONE CASE AND IT IS NOT A FALLBACK: ADOPTION. An App created by hand
// before this converge existed has no handoff file, and naming it here is how the operator brings it
// under the model -- at which point the agreement fold and the drift arms do the rest without a
// second mechanism. So the two sources answer different questions: the file says "this converge
// acquired one", the row says "this fleet already had one". A row naming an App the file also names
// is a Conflict rather than a precedence rule, because two answers to one question is the fork
// DESIGN 3 forbids and silently preferring one would hide it.
data census_app_declared_adoption: GitHubAppAcquisitionRecord = AppNeverAcquired

type AcquisitionRecordReading
  = AcquisitionRecordRead { record: GitHubAppAcquisitionRecord, source: NonEmptyStr }
  | AcquisitionRecordConflict { declared_slug: NonEmptyStr, handoff_slug: NonEmptyStr }
  | AcquisitionRecordUnparseable { path: String, cause: NonEmptyStr }

fn acquisition_record_field(document: String, key: String) -> String? {
  fold(split(s: document, delimiter: "\n"), init: none, f: fn(found, line) {
    match found {
      Present { value: v } => Present { value: v }
      Absent =>
        if starts_with(line, prefix: concat(key, "=")) {
          match split(s: line, delimiter: "=") |> skip(n: 1) |> first {
            Absent => none
            Present { value: v } => Present { value: trim(v) }
          }
        } else {
          none
        }
    }
  })
}

// THE PARSE IS TOTAL AND REFUSES RATHER THAN PARTIALLY BELIEVING A HANDOFF FILE. A document carrying
// a slug but no app id describes an App this converge cannot address by id, and answering
// AppNeverAcquired for it would authorize a registration that duplicates the App the file is about -
// the exact class the Conflict arm exists to prevent, arriving through the reading instead.
fn acquisition_record_from_document(path: String, content_document: String) -> AcquisitionRecordReading {
  match acquisition_record_field(document: content_document, key: "slug") {
    Absent =>
      AcquisitionRecordUnparseable { path: path, cause: "custody handoff names no slug" as NonEmptyStr }
    Present { value: slug } =>
      if slug == "" {
        AcquisitionRecordUnparseable { path: path, cause: "custody handoff slug is empty" as NonEmptyStr }
      } else {
        match acquisition_record_field(document: content_document, key: "app_id") {
          Absent =>
            AcquisitionRecordUnparseable { path: path, cause: "custody handoff names no app_id" as NonEmptyStr }
          Present { value: raw_id } =>
            match parse_int(raw_id) {
              Absent =>
                AcquisitionRecordUnparseable {
                  path: path,
                  cause: concat("custody handoff app_id is not an integer: ", raw_id) as NonEmptyStr,
                }
              Present { value: id } =>
                AcquisitionRecordRead {
                  record: AppAcquired { app_id: GitHubAppId { value: id }, slug: slug as NonEmptyStr },
                  source: path as NonEmptyStr,
                }
            }
        }
      }
  }
}

fn reconcile_acquisition_record(
  declared: GitHubAppAcquisitionRecord,
  from_handoff: AcquisitionRecordReading?,
) -> AcquisitionRecordReading {
  match from_handoff {
    Absent =>
      AcquisitionRecordRead {
        record: declared,
        source: "gunbc.github_app_acquisition census_app_declared_adoption" as NonEmptyStr,
      }
    Present { value: reading } =>
      match reading {
        AcquisitionRecordUnparseable { path: p, cause: c } =>
          AcquisitionRecordUnparseable { path: p, cause: c }
        AcquisitionRecordConflict { declared_slug: d, handoff_slug: h } =>
          AcquisitionRecordConflict { declared_slug: d, handoff_slug: h }
        AcquisitionRecordRead { record: handoff_record, source: src } =>
          match declared {
            AppNeverAcquired => AcquisitionRecordRead { record: handoff_record, source: src }
            AppAcquired { app_id: _, slug: declared_slug } =>
              match handoff_record {
                AppNeverAcquired => AcquisitionRecordRead { record: declared, source: src }
                AppAcquired { app_id: _, slug: handoff_slug } =>
                  if (declared_slug as String) == (handoff_slug as String) {
                    AcquisitionRecordRead { record: handoff_record, source: src }
                  } else {
                    AcquisitionRecordConflict { declared_slug: declared_slug, handoff_slug: handoff_slug }
                  }
              }
          }
      }
  }
}

// THE HUMAN STEPS, SPLIT ONE PER ACT, EACH WITH ITS OWN TRIGGER (operator ruling, 2026-09-18).
// An earlier cut bundled four things into ONE FleetOnce identity with NoDischargeSiteModeled: submit
// the form, paste the manifest, copy the code out of the address bar, and hand-transcribe the app id
// and slug into a data row. They are not the same kind of thing, and bundling them made the whole
// group look irreducible when only one of them is.
//
// THE TEST A HUMAN STEP MUST PASS is that it truly cannot be automated, and out-of-band is admissible
// only when it is modeled as a HumanIntervention AND it passes that test. Browser automation is a
// named future path, so a step that a browser could drive is not permanent and owes its trigger; a
// step that no capability we could build would remove is, and says so. Of the four:
//
//   SUBMIT  - irreducibly human TODAY. GitHub requires the account or organization OWNER to submit
//             the manifest form; there is no API that creates an App. Dissolves on browser
//             automation driving that form under an owner session. Pasting the manifest is the same
//             act, not a second one.
//   CAPTURE - NOT irreducible, and modeling it as such would be presenting a design choice as a
//             constraint. It is human only because census_app_redirect_url points at a host with
//             nothing behind it; a redirect catcher, even a localhost listener, takes code and state
//             today with no browser automation and no capability this repository lacks. It is
//             therefore a DECLARED CHOICE with its trigger, not a fact about GitHub.
//   RECORD  - deleted, not modeled. The conversion response carries the id and the slug, so asking a
//             human to type them into a data row is asking them to be the wire. The acquisition
//             record is now READ from the custody handoff the actuation writes.
//   SUPPLY  - genuinely permanent, and it is the one step browser automation does not touch. An
//             App's private key was returned once at its creation and no endpoint reissues it, so
//             there is nothing to click: only the operator can produce those bytes. It is reached
//             whenever custody is the missing fact, for an App this converge registered as much as
//             for an adopted one, so it asserts nothing about which.
//
// AND THE IDENTITY KEYS ON THE APP, NOT THE FLEET. FleetOnce was right for exactly one App and wrong
// the moment a second exists or an existing hand-made App is adopted, which is a case this fleet
// wants. EveryProvision is the honest axis: registering an App is paid once per App provisioned, and
// it multiplies with the number of Apps rather than being paid once ever.
// THE INSTRUCTION NAMES AN ARTIFACT, NOT A FIELD THAT DOES NOT EXIST. The step this replaced said
// "open the registration URL, paste the manifest into the form's manifest field, and submit", and an
// operator followed it and reported a create page with no such field. That was not a wording defect:
// a GET of the registration URL renders GitHub's ORDINARY App-creation form, which ignores manifests,
// and the manifest protocol is a POST carrying a `manifest` form parameter
// (extdeps.github.app app_manifest_form_parameter_name). There was no field to paste into because
// there was no form -- the corpus had rendered only the action URL and left the form unwritten.
//
// SO THE INSTRUCTION TAKES THE PATH OF A DOCUMENT THE CONVERGE WROTE, and that path is a parameter
// rather than a constant here because the instruction must not be constructible without one: an
// intervention naming an artifact nobody produced is the same class of defect one layer along.
// census_app_registration_instruction only builds this after
// extdeps.github.app app_manifest_submission_document has rendered the document, and the acquire
// entry point writes that document to this path before it prints the instruction.
//
// WHAT REMAINS IRREDUCIBLY HUMAN IS NARROWER THAN THE OLD STEP CLAIMED, and the row says so now: the
// act GitHub requires is an OWNER submitting the form, not a human transcribing a document. The
// manifest, the action URL, the state binding and the form are all machine-produced.
//
// AND IT TAKES THE ADDRESSING RATHER THAN A PATH, so no caller can reach it with a name that was
// never checked. The path is the target of a real Filesystem.Write, and the module already models
// the refusal for a name that cannot address a file safely; taking a bare String here left that wall
// one call away from a write instead of in front of it (review 69495). Both arms are reachable --
// the carrier admits any NonEmptyStr name -- so this is a total fold over a real coproduct, not a
// defensive arm over a state the constructor forbids.
fn app_registration_submit_intervention(
  identity: GitHubAppDeclaredIdentity,
  addressing: CustodyHandoffAddressing,
) -> HumanIntervention {
  match addressing {
    CustodyNameNotPathSafe { name: unsafe_name } =>
      HumanIntervention {
        identity: join(["github-app-submit-", identity.name as String], "") as HumanInterventionIdentity,
        frequency: EveryProvision,
        subject: identity.name,
        instruction: join(
          [
            "NO SUBMISSION DOCUMENT WAS WRITTEN AND THERE IS NOTHING TO OPEN. The declared App name ",
            unsafe_name as String,
            " cannot address a file safely -- it carries a separator or a parent reference -- so writing the form would put it outside the git-ignored handoff directory. Correct the declared name; nothing about this flow is runnable until the artifact has a safe address.",
          ],
          "",
        ) as NonEmptyStr,
        completion_evidence: NoDischargeSiteModeled,
      }
    CustodyAddressed { paths: paths } => app_registration_submit_open_intervention(identity: identity, artifact_path: paths.registration_form)
  }
}

fn app_registration_submit_open_intervention(
  identity: GitHubAppDeclaredIdentity,
  artifact_path: String,
) -> HumanIntervention {
  HumanIntervention {
    identity: join(["github-app-submit-", identity.name as String], "") as HumanInterventionIdentity,
    frequency: EveryProvision,
    subject: identity.name,
    instruction: join(
      [
        "Open the file ",
        artifact_path,
        " in a browser that is signed in as an owner of the target account, and press the submit button on it. That page is a form whose action is the manifest registration endpoint and whose one hidden field carries the declared manifest under the parameter name GitHub reads it from, so the submission is a POST rather than a paste. DO NOT open the registration URL directly: a GET of it renders the ordinary App-creation form, which carries no field for a manifest and ignores it entirely -- that was the instruction this replaced, and an operator followed it and found exactly that. GitHub requires ownership consent to create an App and exposes no API for it, so pressing the button is the one act in this flow nothing here can perform.",
      ],
      "",
    ) as NonEmptyStr,
    completion_evidence: NoDischargeSiteModeled,
  }
}

// FACT 2 IS A SECOND CONSENT AND THEREFORE A SECOND STEP. Registering the App grants it access to
// nothing; an installation is where an account holder agrees to give it some of the permissions the
// manifest asked for, over some repositories. Its page is addressed by the SLUG the conversion
// returned, which is why this step cannot exist before registration and why no instruction for it can
// be built out of the declared name alone (census_app_installation_instruction refuses without one).
fn app_installation_consent_intervention(
  identity: GitHubAppDeclaredIdentity,
  install_url: String,
) -> HumanIntervention {
  HumanIntervention {
    identity: join(["github-app-install-", identity.name as String], "") as HumanInterventionIdentity,
    frequency: EveryProvision,
    subject: identity.name,
    instruction: join(
      [
        "Open ",
        install_url,
        " while signed in as an account holder for the target org, choose the repositories the census may read, and install. This is NOT the registration step and is not implied by it: a registered App with no installation has access to nothing and lifts no rate limit, and GitHub exposes no API that installs an App on an account -- consent is the account holder's act. Once it is granted, the installation id is read back automatically by the installations entry point; nothing needs transcribing.",
      ],
      "",
    ) as NonEmptyStr,
    completion_evidence: NoDischargeSiteModeled,
  }
}

fn app_registration_capture_intervention(identity: GitHubAppDeclaredIdentity) -> HumanIntervention {
  HumanIntervention {
    identity: join(["github-app-capture-code-", identity.name as String], "") as HumanInterventionIdentity,
    frequency: EveryProvision,
    subject: identity.name,
    instruction: join(
      [
        "After submitting, GitHub redirects to ",
        uri_wire(uri: census_app_redirect_url) as String,
        " with ?code= and &state= in the address bar and nothing serving that URL. Copy the code and the state into the handoff files the acquire entry point names, within one hour of the click. THIS STEP IS A DECLARED CHOICE, NOT A LIMIT: a redirect catcher would take both values automatically with no browser automation, and until one exists the operator pays this.",
      ],
      "",
    ) as NonEmptyStr,
    completion_evidence: NoDischargeSiteModeled,
  }
}

fn app_key_supply_intervention(identity: GitHubAppDeclaredIdentity) -> HumanIntervention {
  HumanIntervention {
    identity: join(["github-app-supply-pem-", identity.name as String], "") as HumanInterventionIdentity,
    frequency: EveryProvision,
    subject: identity.name,
    instruction: join(
      [
        "No private key for this App is at its custody path. GitHub returns an App private key ONCE, at the App's creation, and exposes no endpoint that reissues it -- so the original bytes are not retrievable now, and this step says nothing about how the App came to exist: it is the same act whether this converge registered it and the key was never stored or was later removed, or it was created by hand before this converge existed. Place a pem this fleet holds for it at the custody handoff path, or generate a NEW key in the App's settings and place that. This step does not dissolve with browser automation: there is nothing to click, because the original bytes no longer exist anywhere GitHub will show them.",
      ],
      "",
    ) as NonEmptyStr,
    completion_evidence: NoDischargeSiteModeled,
  }
}

// THE THREE HUMAN STEPS AS FRONTIER ROWS, so the dissolution census can see them. A bare
// DissolutionCondition beside an intervention is a promise nothing counts; a row enrolled in
// gunbc.census_closure_frontier is one the census reports until its trigger fires. The third row is
// deliberately a PERMANENT entry rather than an omission: a step no capability retires still belongs
// in the roster, because leaving it out reads as "no human step here".
data github_app_human_step_frontier_rows: List<FrontierRow> = [
  frontier_row_decl(
    ref: decl_ref(module_path: "gunbc.github_app_acquisition", decl_name: "app_registration_submit_intervention"),
    reason: "SUBMIT is irreducibly human today: GitHub requires the account or organization owner to submit the manifest form and exposes no API that creates an App, so no credential this fleet could hold substitutes for it. What is human is now ONLY the submission -- the form, its action URL, its state binding and the manifest it carries are produced by census_app_registration_instruction and written to disk by the acquire entry point",
    dissolution: unbound_dissolution(
      description: "dissolves when browser automation opens the document census_app_registration_instruction produces under an owner session and submits its form, so the converge performs the submission and census_app_registration_instruction stops producing an instruction. A Playwright dependency being modeled does not fire this; the form being submitted end to end does"
    )
  ),
  frontier_row_decl(
    ref: decl_ref(module_path: "gunbc.github_app_acquisition", decl_name: "app_installation_consent_intervention"),
    reason: "CONSENT is irreducibly human today and is a DIFFERENT act from SUBMIT, which is why it is a second row rather than a sentence inside the first: an App can be registered and never installed, and in that state it holds no access and lifts no rate limit. GitHub exposes no API that installs an App on an account -- the account holder chooses the repositories on the App's public install page",
    dissolution: unbound_dissolution(
      description: "dissolves when browser automation opens the App install page under an account-holder session, selects the declared repositories and grants the installation, so census_app_installation_instruction stops producing an instruction and the converge performs the consent. Reading the installation id back afterwards is ALREADY automated and does not fire this row"
    )
  ),
  frontier_row_decl(
    ref: decl_ref(module_path: "gunbc.github_app_acquisition", decl_name: "app_registration_capture_intervention"),
    reason: "CAPTURE is a DECLARED CHOICE and not a constraint, and it is rostered so it is not mistaken for one: the operator copies code and state out of the address bar only because census_app_redirect_url points at a host this fleet does not serve. A redirect catcher, a localhost listener included, takes both values today with no browser automation and no capability this repository lacks",
    dissolution: unbound_dissolution(
      description: "dissolves when a redirect catcher receives GitHub's redirect and writes the code and state where the acquire entry point reads them, so the operator never touches the address bar. It needs no browser automation, which is why this row is a choice rather than a limit; it retires when census_app_redirect_url points at something this fleet serves"
    )
  ),
  frontier_row_decl(
    ref: decl_ref(module_path: "gunbc.github_app_acquisition", decl_name: "app_key_supply_intervention"),
    reason: "SUPPLY is PERMANENT under the modeled world and is rostered as such rather than omitted. GitHub returns an App private key once at creation and exposes no endpoint that reissues it, so once those bytes are not held no capability retrieves them -- browser automation included, because there is nothing to click. The row is deliberately NOT scoped to an App created outside this converge: the step is reached from next_acquisition_step whenever custody is the missing fact, and an App this converge registered whose key was never stored or was later removed is in exactly the same unrecoverable position",
    dissolution: unbound_dissolution(
      description: "does NOT dissolve with browser automation and is not awaiting one. The only thing that ends it is generating a NEW key in the App's settings, which is itself the human act this row names, so the row retires only if GitHub begins reissuing existing private keys -- an upstream change, not a capability this fleet can build"
    )
  )
]

// THE CENSUS APP'S OWN SUBMIT STEP, NAMED ONCE SO NOTHING RE-CONSTRUCTS IT. The privileged-effect
// census embeds this step AND reports the effect's frequency beside it, and authoring those two
// independently is how one effect came to carry two frequencies in one row (review 69472). A caller
// that needs both takes them from here.
fn census_app_registration_submit_step() -> HumanIntervention {
  app_registration_submit_intervention(
    identity: census_app_identity,
    addressing: custody_handoff_addressing(name: census_app_identity.name),
  )
}

data census_app_submission_heading: String = "Register the gunbc global census GitHub App"

data census_app_submission_guidance: String = "Pressing the button below POSTs the manifest under the exact form parameter GitHub reads it from, to the registration endpoint for the declared owner, carrying the state nonce this converge issued. The manifest is shown below the button so it can be read before it is submitted. Opening the registration URL directly instead renders the ordinary App-creation form, which has no manifest field."

type AppRegistrationInstruction
  = RegistrationInstructionReady { intervention: HumanIntervention, artifact_path: String, artifact_html: String }
  | RegistrationInstructionUnavailable { reason: NonEmptyStr }

// THE INSTRUCTION AND THE ARTIFACT ARE PRODUCED TOGETHER OR NEITHER IS. RegistrationInstructionReady
// carries the document itself and not a promise that one exists, so the entry point that prints the
// instruction is the same one that writes the file the instruction names -- there is no arm in which
// an operator is told to open a path nothing wrote.
fn census_app_registration_instruction(state: GitHubAppManifestState) -> AppRegistrationInstruction {
  match app_manifest_submission_document(
    target: census_app_identity.target,
    state: state as NonEmptyStr,
    m: census_app_manifest,
    heading: census_app_submission_heading,
    guidance: census_app_submission_guidance,
  ) {
    ManifestSubmissionNotRenderable { cause: c } =>
      RegistrationInstructionUnavailable { reason: c }
    ManifestSubmissionRendered { html: html } =>
      match custody_handoff_addressing(name: census_app_identity.name) {
        CustodyNameNotPathSafe { name: unsafe_name } =>
          RegistrationInstructionUnavailable {
            reason: join(
              [
                "the declared App name ",
                unsafe_name as String,
                " cannot address a file safely, so the submission document has no write target inside the handoff directory",
              ],
              "",
            ) as NonEmptyStr
          }
        CustodyAddressed { paths: paths } =>
          RegistrationInstructionReady {
            intervention: app_registration_submit_intervention(
              identity: census_app_identity,
              addressing: CustodyAddressed { paths: paths },
            ),
            artifact_path: paths.registration_form,
            artifact_html: html,
          }
      }
  }
}

// FACT 2'S INSTRUCTION CANNOT BE BUILT FROM FACT 1'S DECLARATION, AND THAT REFUSAL IS THE POINT. The
// install page is addressed by the slug, the slug is a value the conversion returns, and an App that
// was never registered has none -- so asking for the installation step before registration produces a
// typed refusal rather than a URL assembled from the declared name. This is the same distinction
// census_app_read_address keeps for the public read: "we have not created it" is not "it is not
// installed", and only one of them is repaired by clicking an install button.
type AppInstallationInstruction
  = InstallationInstructionReady { intervention: HumanIntervention, install_url: String }
  | InstallationInstructionUnavailable { reason: NonEmptyStr }

fn census_app_installation_instruction(record: GitHubAppAcquisitionRecord) -> AppInstallationInstruction {
  match record {
    AppNeverAcquired =>
      InstallationInstructionUnavailable {
        reason: "the census App is not registered, so it has no slug and no install page; registration is a different fact and must be established first" as NonEmptyStr
      }
    AppAcquired { app_id: _, slug: slug } =>
      match app_install_url(slug: slug) {
        InstallUrlSlugUnencodable { cause: _ } =>
          InstallationInstructionUnavailable {
            reason: join(["the recorded slug ", slug as String, " is not percent-encodable, so no install page can be addressed for it"], "") as NonEmptyStr
          }
        InstallUrlBuilt { url: url } =>
          InstallationInstructionReady {
            intervention: app_installation_consent_intervention(
              identity: census_app_identity,
              install_url: url,
            ),
            install_url: url,
          }
      }
  }
}

// THE OBSERVATION IS THE PUBLIC APP RECORD, READ WITH THE ORDINARY FLEET PAT. It is independent of
// the exchange in the sense DESIGN 3d requires: a different credential, a different endpoint, and a
// record GitHub renders from its own state rather than the reply the mutation handed back. It is
// NOT the App JWT path - that would make every observation depend on the capability this lane cannot
// realize, and would report "no App" whenever the external minting step was stale.
type CensusAppObservation
  = AppRecordObserved { record: GitHubAppPublicRecord }
  | AppRecordAbsent
  | AppRecordUnreadable { reason: NonEmptyStr }
  | AppNotYetAddressable

fn app_observation_from_exchange(
  performance: RestExchangePerformance,
  record: GitHubAppPublicRecord,
) -> CensusAppObservation {
  match performance {
    RestExchangeSucceeded => AppRecordObserved { record: record }
    RestExchangeStatusRefused { status: status, body: body } =>
      if status == 404 {
        AppRecordAbsent
      } else {
        AppRecordUnreadable {
          reason: join(["public app read refused with status ", to_string(status), ": ", body], "") as NonEmptyStr
        }
      }
    RestExchangeCommitAmbiguous { detail: detail } =>
      AppRecordUnreadable { reason: detail }
    RestExchangeUnreached { cause: cause } =>
      AppRecordUnreadable { reason: join(["public app read never reached GitHub: ", cause as String], "") as NonEmptyStr }
    RestExchangeUndecodable { status: _, cause: cause } =>
      AppRecordUnreadable { reason: join(["public app record undecodable: ", cause as String], "") as NonEmptyStr }
  }
}

fn observe_census_app(
  record: GitHubAppPublicRecord,
  outcome: RestOutcome,
) -> CensusAppObservation {
  app_observation_from_exchange(
    performance: classify_rest_outcome(standing: RestReadExchange { rest: outcome }),
    record: record,
  )
}

// AGREEMENT IS PER-AXIS AND DIRECTIONAL. The declared set is what we asked for; the observed set is
// what the App holds. An axis the App holds and the manifest does not is not drift we would repair -
// GitHub grants nothing we did not request, and an operator who widened it deliberately is a fact
// about the App, not an error. An axis the manifest declares and the App lacks, or holds at a weaker
// access, IS drift, because a census read bound to it will fail at a point far from here.
type PermissionAgreement
  = PermissionsAgree
  | PermissionAxisMissing { axis: GitHubPermissionAxis }
  | PermissionAxisWeaker { axis: GitHubPermissionAxis, declared: GitHubAppPermissionAccess, observed: GitHubAppPermissionAccess }

fn permission_agreement(
  declared: List<GitHubAppPermission>,
  observed: List<ObservedGitHubPermission>,
) -> PermissionAgreement {
  fold(declared, init: PermissionsAgree, f: fn(acc, p) {
    match acc {
      PermissionAxisMissing { axis: a } => PermissionAxisMissing { axis: a }
      PermissionAxisWeaker { axis: a, declared: d, observed: o } =>
        PermissionAxisWeaker { axis: a, declared: d, observed: o }
      PermissionsAgree =>
        match observed_access_for(perms: observed, axis: p.name) {
          Absent => PermissionAxisMissing { axis: p.name }
          Present { value: held } =>
            if permission_access_at_least(held: held, requested: p.access) {
              PermissionsAgree
            } else {
              PermissionAxisWeaker { axis: p.name, declared: p.access, observed: held }
            }
        }
    }
  })
}

type EventAgreement
  = EventsAgree
  | EventNotSubscribed { event: GitHubWebhookEvent }

fn event_is_subscribed(observed: List<String>, event: GitHubWebhookEvent) -> Bool {
  fold(observed, init: false, f: fn(found, raw) {
    if found {
      true
    } else {
      match webhook_event_from_wire(name: raw) {
        Absent => false
        Present { value: e } => e == event
      }
    }
  })
}

fn event_agreement(
  declared: List<GitHubWebhookEvent>,
  observed: List<String>,
) -> EventAgreement {
  fold(declared, init: EventsAgree, f: fn(acc, e) {
    match acc {
      EventNotSubscribed { event: x } => EventNotSubscribed { event: x }
      EventsAgree =>
        if event_is_subscribed(observed: observed, event: e) {
          EventsAgree
        } else {
          EventNotSubscribed { event: e }
        }
    }
  })
}

type CensusAppAgreement
  = AppAgreesWithManifest
  | AppPermissionDrift { agreement: PermissionAgreement }
  | AppEventDrift { agreement: EventAgreement }
  | AppPermissionsUnreadable { decode: ObservedPermissionMapDecode }
  | AppIdentityDrift { expected_slug: NonEmptyStr, observed_slug: String }

fn census_app_agreement(
  expected_slug: NonEmptyStr,
  record: GitHubAppPublicRecord,
) -> CensusAppAgreement {
  if record.slug != (expected_slug as String) {
    AppIdentityDrift { expected_slug: expected_slug, observed_slug: record.slug }
  } else {
    match observed_permissions_from_wire_map(m: record.permissions) {
      ObservedPermissionAccessUnreadable { wire_name: n, access: a } =>
        AppPermissionsUnreadable { decode: ObservedPermissionAccessUnreadable { wire_name: n, access: a } }
      ObservedPermissionKeyUnanswered { wire_name: n } =>
        AppPermissionsUnreadable { decode: ObservedPermissionKeyUnanswered { wire_name: n } }
      ObservedPermissionsDecoded { permissions: observed } =>
        match permission_agreement(declared: census_app_permissions, observed: observed) {
          PermissionAxisMissing { axis: a } =>
            AppPermissionDrift { agreement: PermissionAxisMissing { axis: a } }
          PermissionAxisWeaker { axis: a, declared: d, observed: o } =>
            AppPermissionDrift { agreement: PermissionAxisWeaker { axis: a, declared: d, observed: o } }
          PermissionsAgree =>
            match event_agreement(declared: census_app_default_events, observed: record.events) {
              EventNotSubscribed { event: e } =>
                AppEventDrift { agreement: EventNotSubscribed { event: e } }
              EventsAgree => AppAgreesWithManifest
            }
        }
    }
  }
}

// THE PLAN IS THE EXCHANGE, AND IT CARRIES THE CODE RATHER THAN BEING THE CODE. A converge that
// decided Apply without a code in hand would be deciding to ask a human, which is a different
// decision from deciding to spend one.
// THE PLAN NAMES THE SUBJECT THE ACTUATION ADDRESSES, so the actuator honours the decision rather
// than re-deriving it. An earlier cut carried only the SecretRef destinations here and left the
// actuator reaching for census_app_identity directly, which made custody_name a second derivation of
// a fact the plan was already built from. It was harmless while both derived from one declaration --
// and that is exactly the shape that stopped being harmless once in this PR, when the custody write
// keyed on the returned slug while the read keyed on the declared name. Two derivations of one name
// is the defect; one derivation passed through the plan is the repair.
//
// custody_name AND custody ARE DIFFERENT FACTS AND BOTH BELONG HERE. custody_name is what the
// actuation ADDRESSES its handoff files by, now; custody is where those bytes are DESTINED, in
// Secret Manager, and is what custody_identity_document writes beside them so an operator holding
// four files knows where they go.
type CensusAppPlan {
  code: GitHubAppManifestCode
  custody_name: NonEmptyStr
  custody: GitHubAppCustody
}

// THE DECISION, AND THE ONE ARM THE WHOLE LANE EXISTS FOR. AppAcquired plus an absent public record
// is NOT "absent, so mint": it is a Conflict. The record says this App exists and the read says it
// does not, and the only action that reconciles those by creating something is the duplicate mint
// this lane is guarding against. Minting there would also be unrecoverable in the specific way this
// subject is unrecoverable - the second App gets a different pem, the first App's pem is still the
// only one that ever existed for it, and the name is already spent.
//
// AppAcquired plus an agreeing record is Noop, and Noop IS the adoption: a second run reads the App,
// finds it is the one the manifest declares, and does nothing. That is what "re-running adopts rather
// than duplicating" means here - not a lookup that finds a candidate, but a decision that produces no
// registration URL and no exchange.
fn classify_census_app(
  policy: EnsurePolicy,
  record: GitHubAppAcquisitionRecord,
  observation: CensusAppObservation,
  code: GitHubAppManifestCode?,
) -> UpsertClassification<CensusAppPlan> {
  match observation {
    AppRecordUnreadable { reason: r } =>
      UpsertClassification { verdict: Inaccessible, decision: Refuse { reason: r } }
    AppNotYetAddressable =>
      match record {
        AppAcquired { app_id: _, slug: s } =>
          UpsertClassification {
            verdict: UnknownRefused,
            decision: Refuse {
              reason: join(["census App ", s as String, " is recorded as acquired but the observation was not addressed at it"], "") as NonEmptyStr
            },
          }
        AppNeverAcquired => census_app_not_acquired_classification(policy: policy, code: code)
      }
    AppRecordAbsent =>
      match record {
        AppAcquired { app_id: _, slug: s } =>
          UpsertClassification {
            verdict: Conflict,
            decision: Refuse {
              reason: join(
                [
                  "census App ",
                  s as String,
                  " is recorded as acquired and the public app record is absent; a registration here would mint a SECOND App with a different private key while the first one's name stays spent. Read the App's settings page and reconcile the custody handoff (or census_app_declared_adoption, if this App was adopted) before any converge is authorized",
                ],
                "",
              ) as NonEmptyStr
            },
          }
        AppNeverAcquired => census_app_not_acquired_classification(policy: policy, code: code)
      }
    AppRecordObserved { record: observed } =>
      match record {
        AppNeverAcquired =>
          UpsertClassification {
            verdict: Conflict,
            decision: Refuse {
              reason: join(
                [
                  "a public App already answers at slug ",
                  observed.slug,
                  " while neither the custody handoff nor census_app_declared_adoption says this fleet acquired one; either this fleet holds an App it has not recorded, or the name is held by someone else, and neither is repaired by registering again",
                ],
                "",
              ) as NonEmptyStr
            },
          }
        AppAcquired { app_id: _, slug: s } =>
          match census_app_agreement(expected_slug: s, record: observed) {
            AppAgreesWithManifest =>
              UpsertClassification { verdict: Converged, decision: Noop }
            AppIdentityDrift { expected_slug: e, observed_slug: o } =>
              UpsertClassification {
                verdict: Conflict,
                decision: Refuse {
                  reason: join(["public app record answers for slug ", o, " which is not the recorded ", e as String], "") as NonEmptyStr
                },
              }
            AppPermissionsUnreadable { decode: _ } =>
              UpsertClassification {
                verdict: Inaccessible,
                decision: Refuse {
                  reason: join(["census App ", s as String, " permissions object could not be decoded"], "") as NonEmptyStr
                },
              }
            AppPermissionDrift { agreement: a } =>
              UpsertClassification {
                verdict: Drifted,
                decision: Refuse { reason: permission_drift_reason(slug: s, agreement: a) },
              }
            AppEventDrift { agreement: a } =>
              UpsertClassification {
                verdict: Drifted,
                decision: Refuse { reason: event_drift_reason(slug: s, agreement: a) },
              }
          }
      }
  }
}

// DRIFT ON AN EXISTING APP REFUSES RATHER THAN APPLYING, AND THE REASON IS UPSTREAM, NOT TIMIDITY.
// The manifest flow CREATES an App; there is no manifest endpoint that edits one. Repairing a
// permission or an event subscription on a live App is a different act performed on its settings
// page, and every existing installation must then approve the widened permission set before it takes
// effect. So an Apply here would be the wrong verb on the wrong subject - it would register a new App.
fn permission_drift_reason(slug: NonEmptyStr, agreement: PermissionAgreement) -> NonEmptyStr {
  match agreement {
    PermissionsAgree =>
      join(["census App ", slug as String, " permissions agree"], "") as NonEmptyStr
    PermissionAxisMissing { axis: a } =>
      join(
        [
          "census App ",
          slug as String,
          " does not hold declared permission ",
          permission_axis_wire_name(axis: a) as String,
          "; the manifest flow creates Apps and cannot edit one, so repair this on the App's settings page and re-approve the installations",
        ],
        "",
      ) as NonEmptyStr
    PermissionAxisWeaker { axis: a, declared: d, observed: o } =>
      join(
        [
          "census App ",
          slug as String,
          " holds ",
          permission_axis_wire_name(axis: a) as String,
          " at ",
          permission_access_wire_name(access: o) as String,
          " where the manifest declares ",
          permission_access_wire_name(access: d) as String,
        ],
        "",
      ) as NonEmptyStr
  }
}

fn event_drift_reason(slug: NonEmptyStr, agreement: EventAgreement) -> NonEmptyStr {
  match agreement {
    EventsAgree => join(["census App ", slug as String, " events agree"], "") as NonEmptyStr
    EventNotSubscribed { event: e } =>
      join(
        [
          "census App ",
          slug as String,
          " is not subscribed to declared event ",
          webhook_event_wire_name(event: e) as String,
        ],
        "",
      ) as NonEmptyStr
  }
}

fn census_app_not_acquired_classification(
  policy: EnsurePolicy,
  code: GitHubAppManifestCode?,
) -> UpsertClassification<CensusAppPlan> {
  match policy {
    EnsureObserveOnly =>
      UpsertClassification {
        verdict: Absent,
        decision: Refuse { reason: "census App is not acquired and the policy is observe-only" as NonEmptyStr },
      }
    EnsureMayApply =>
      match code {
        Absent =>
          UpsertClassification {
            verdict: Absent,
            decision: Refuse {
              reason: "census App is not acquired and no manifest code is in hand; the owner must submit the manifest form first, which is what app_registration_submit_intervention instructs" as NonEmptyStr
            },
          }
        Present { value: c } =>
          UpsertClassification {
            verdict: Absent,
            decision: Apply { plan: CensusAppPlan { code: c, custody_name: census_app_identity.name, custody: census_app_custody() } },
          }
      }
  }
}

// THE ACTUATION'S OWN REPLY, CLASSIFIED. A 404 on the conversion is not "the App is missing": the
// path names the CODE, so a 404 says the code is not a live code - spent by an earlier exchange, or
// past the one hour the registration flow allows. Naming that arm matters for credential custody,
// because the two readings prescribe opposite actions: re-run the exchange, or go back to the human
// step and get a fresh code.
//
// WHICH PERFORMANCE ARMS A MUTATION CAN ACTUALLY REACH, STATED SO THE MATCH BELOW IS NOT MISREAD AS
// FIVE LIVE OUTCOMES. classify_rest_outcome folds a mutation's transport refusal AND its undecodable
// body into RestExchangeCommitAmbiguous - only a READ exchange surfaces RestExchangeUnreached or
// RestExchangeUndecodable - so for this POST the reachable arms are Succeeded, StatusRefused and
// CommitAmbiguous. The other two are matched for totality and route to the same unknown-outcome
// carrier rather than carrying prose that describes a red they cannot produce (DESIGN 4b).
//
// AND UNKNOWN IS THE ARM THAT CANNOT BE RE-RUN BLIND. A mutation whose outcome we could not read may
// have created the App and issued the only private key it will ever have, so it demands a read of the
// account's Apps before anything else - which is what every route into this arm says.
type CensusAppExchangeOutcome
  = ExchangeIssued { issuance: GitHubAppCredentialIssuance }
  | ExchangeCodeNotLive { body: String }
  | ExchangeRefused { reason: NonEmptyStr }
  | ExchangeOutcomeUnknown { detail: NonEmptyStr }
  | ExchangeReplyIncomplete { issuance: ConversionIssuance }

fn exchange_outcome_unknown(detail: String) -> CensusAppExchangeOutcome {
  ExchangeOutcomeUnknown {
    detail: join(
      [
        detail,
        " -- READ THE ACCOUNT'S GitHub Apps SETTINGS BEFORE RETRYING: if the App was created, its private key was returned in the reply this client could not read and no endpoint will return it again",
      ],
      "",
    ) as NonEmptyStr
  }
}

fn classify_census_app_exchange(
  conversion: GitHubAppManifestConversion,
  outcome: RestOutcome,
) -> CensusAppExchangeOutcome {
  match classify_rest_outcome(standing: RestMutationExchange { rest: outcome }) {
    RestExchangeSucceeded =>
      match conversion_issuance(c: conversion) {
        IssuanceRead { issuance: i } => ExchangeIssued { issuance: i }
        IssuanceSlugEmpty => ExchangeReplyIncomplete { issuance: IssuanceSlugEmpty }
        IssuanceClientIdEmpty => ExchangeReplyIncomplete { issuance: IssuanceClientIdEmpty }
      }
    RestExchangeStatusRefused { status: status, body: body } =>
      if status == 404 {
        ExchangeCodeNotLive { body: body }
      } else {
        ExchangeRefused {
          reason: join(["manifest conversion refused with status ", to_string(status), ": ", body], "") as NonEmptyStr
        }
      }
    RestExchangeCommitAmbiguous { detail: detail } =>
      exchange_outcome_unknown(detail: detail as String)
    RestExchangeUnreached { cause: cause } =>
      exchange_outcome_unknown(detail: cause as String)
    RestExchangeUndecodable { status: _, cause: cause } =>
      exchange_outcome_unknown(detail: cause as String)
  }
}

// WHAT THE OPERATOR MUST RECORD AFTER A SUCCESSFUL EXCHANGE, projected from the issuance rather than
// retyped. What belongs in SOURCE is the App's IDENTITY, because the next converge's observation is
// addressed by it; the secrets go to the custody sites below and never into a declaration.
fn acquisition_record_from_issuance(issuance: GitHubAppCredentialIssuance) -> GitHubAppAcquisitionRecord {
  match issuance {
    CredentialIssuedOnce { app_id: id, slug: s, pem: _, webhook_secret: _, client_id: _, client_secret: _ } =>
      AppAcquired { app_id: id, slug: s }
  }
}

// THE READBACK IS A SECOND, INDEPENDENT OBSERVATION AND IT IS NOT OPTIONAL. It is the SAME public
// read as the pre-decision observation, addressed at the slug the exchange returned, and it is what
// converts an Apply into a convergence claim. A successful exchange reply is not that claim: the reply
// is the actuator describing its own effect, and DESIGN 3d rules that a successful actuation return
// cannot mint convergence. The distinction has teeth here because the exchange is the ONE call in this
// flow whose failure destroys the subject, so believing its own reply is the expensive mistake.
type CensusAppReadback
  = ReadbackConverged { record: GitHubAppAcquisitionRecord }
  | ReadbackDisagrees { agreement: CensusAppAgreement }
  | ReadbackUnavailable { reason: NonEmptyStr }

fn census_app_readback(
  issuance: GitHubAppCredentialIssuance,
  observation: CensusAppObservation,
) -> CensusAppReadback {
  match issuance {
    CredentialIssuedOnce { app_id: _, slug: slug, pem: _, webhook_secret: _, client_id: _, client_secret: _ } =>
      match observation {
        AppNotYetAddressable =>
          ReadbackUnavailable { reason: "readback was not addressed at the issued slug" as NonEmptyStr }
        AppRecordAbsent =>
          ReadbackUnavailable {
            reason: join(
              [
                "the exchange reported issuing App ",
                slug as String,
                " and the independent public read does not find it; the exchange's own reply is not evidence that it landed",
              ],
              "",
            ) as NonEmptyStr
          }
        AppRecordUnreadable { reason: r } => ReadbackUnavailable { reason: r }
        AppRecordObserved { record: observed } =>
          match census_app_agreement(expected_slug: slug, record: observed) {
            AppAgreesWithManifest =>
              ReadbackConverged { record: acquisition_record_from_issuance(issuance: issuance) }
            AppIdentityDrift { expected_slug: e, observed_slug: o } =>
              ReadbackDisagrees { agreement: AppIdentityDrift { expected_slug: e, observed_slug: o } }
            AppPermissionDrift { agreement: a } =>
              ReadbackDisagrees { agreement: AppPermissionDrift { agreement: a } }
            AppEventDrift { agreement: a } =>
              ReadbackDisagrees { agreement: AppEventDrift { agreement: a } }
            AppPermissionsUnreadable { decode: d } =>
              ReadbackDisagrees { agreement: AppPermissionsUnreadable { decode: d } }
          }
      }
  }
}

// THE SLUG THE PUBLIC READ IS ADDRESSED AT. Before the first acquisition there is none, and the
// observation is AppNotYetAddressable rather than a 404 against a guessed slug - which is the same
// distinction the record type exists to keep: "we have not created it" and "it is not there" are
// different facts, and only the first authorizes a registration.
type CensusAppReadAddress
  = ReadAddressedAt { slug: NonEmptyStr }
  | ReadNotAddressable

fn census_app_read_address(record: GitHubAppAcquisitionRecord) -> CensusAppReadAddress {
  match record {
    AppNeverAcquired => ReadNotAddressable
    AppAcquired { app_id: _, slug: s } => ReadAddressedAt { slug: s }
  }
}


// ── FACT 3: CALLBACK CAPTURE ───────────────────────────────────────────────────────────────────
// THE CAPTURE IS A MODEL FACT AND ITS FILE READS ARE NOT, so the classification lives here and the
// reads stay in the acquire entry point. It moved from that entry point in this change rather than
// being copied: the four facts this lane keeps distinct are not distinct if one of them is only ever
// a local type inside the instrument that consumes it, and a second spelling of the state wall would
// have been the fork DESIGN 3 forbids. ManifestHandoffValue comes with it because the admission is
// total over it -- a code, a state and their absences are one decision, not a decision plus three
// missing-file checks scattered through a route.
//
// WHERE THIS FACT ENDS. Admitting a code establishes ONLY that a code arrived bound to the state this
// converge issued. It does not establish that an App exists: the code is spendable exactly once and
// expires in an hour, so a retry on an already-consumed one is a distinct refusal
// (classify_census_app_exchange ExchangeCodeNotLive, a 404 on the conversion path) and not a
// transport failure, which is the arm that must never widen into "try again".

type ManifestHandoffValue
  = HandoffValueRead { value: NonEmptyStr }
  | HandoffValueMissing { path: String, cause: String }
  | HandoffValueEmpty { path: String }

fn handoff_value_refusal(v: ManifestHandoffValue) -> String {
  match v {
    HandoffValueRead { value: _ } => ""
    HandoffValueMissing { path: p, cause: c } =>
      join(["no value at ", p, ": ", c], "")
    HandoffValueEmpty { path: p } => join(["value at ", p, " is empty"], "")
  }
}

// THE STATE CHECK IS THE ONE WALL THIS PROCESS CAN STAND BEHIND ON THE HUMAN HALF. A code is a
// bearer credential that creates an App under whatever manifest its flow declared; accepting one that
// did not come back with the state we issued would spend it on someone else's registration. Comparing
// them is cheap, total, and the only thing between the exchange and a code of unknown provenance.
type ManifestCodeAdmission
  = ManifestCodeAdmitted { code: GitHubAppManifestCode }
  | ManifestCodeStateMismatch { issued: NonEmptyStr, observed: NonEmptyStr }
  | ManifestCodeUnavailable { reason: String }

fn admit_manifest_code(
  issued: ManifestHandoffValue,
  observed: ManifestHandoffValue,
  code: ManifestHandoffValue,
) -> ManifestCodeAdmission {
  match issued {
    HandoffValueMissing { path: p, cause: c } =>
      ManifestCodeUnavailable { reason: handoff_value_refusal(v: HandoffValueMissing { path: p, cause: c }) }
    HandoffValueEmpty { path: p } =>
      ManifestCodeUnavailable { reason: handoff_value_refusal(v: HandoffValueEmpty { path: p }) }
    HandoffValueRead { value: issued_state } =>
      match observed {
        HandoffValueMissing { path: p, cause: c } =>
          ManifestCodeUnavailable { reason: handoff_value_refusal(v: HandoffValueMissing { path: p, cause: c }) }
        HandoffValueEmpty { path: p } =>
          ManifestCodeUnavailable { reason: handoff_value_refusal(v: HandoffValueEmpty { path: p }) }
        HandoffValueRead { value: observed_state } =>
          if (issued_state as String) != (observed_state as String) {
            ManifestCodeStateMismatch { issued: issued_state, observed: observed_state }
          } else {
            match code {
              HandoffValueMissing { path: p, cause: c } =>
                ManifestCodeUnavailable { reason: handoff_value_refusal(v: HandoffValueMissing { path: p, cause: c }) }
              HandoffValueEmpty { path: p } =>
                ManifestCodeUnavailable { reason: handoff_value_refusal(v: HandoffValueEmpty { path: p }) }
              HandoffValueRead { value: c } =>
                ManifestCodeAdmitted { code: c as GitHubAppManifestCode }
            }
          }
      }
  }
}


// ── THE FOUR FACTS, FOLDED, WITH NO FACT IMPLIED BY ANOTHER ────────────────────────────────────
// WHAT THIS EXISTS TO PREVENT. Before this fold, "the census App" was one word covering four
// independently-establishable facts -- the App is REGISTERED, it is INSTALLED somewhere, a callback
// code was CAPTURED and spent, and its private key is in CUSTODY the unit can read -- and the model
// read as done while none of them held. A downstream success is the tempting evidence for an upstream
// one, and it is never evidence: a handoff file full of credentials says nothing about whether any
// account consented to an installation, and a successful installation read says nothing about whether
// THIS fleet registered the App it names. So the fold below refuses at the EARLIEST fact that is not
// established and names it, rather than reporting a standing assembled out of whichever readings
// happened to succeed.
//
// THE ORDER IS CAUSAL, NOT A PREFERENCE. Registration precedes installation because the install page
// is addressed by the slug registration returns; custody is asked last because the private key is
// returned by the registration exchange and an App with no key is still a registered App -- a broken
// one, which is why it is a missing fact rather than an ignorable one.

// CUSTODY HAS ONE ARM FOR "ESTABLISHED" AND IT IS DELIBERATELY THE WEAKER FACT. The declared
// destination for the pem is census_app_private_key_custody in GCP Secret Manager, and this process
// cannot write there. What it can establish is that the bytes reached the handoff file, so that is
// the only arm the type has -- there is no constructor here for "the key is at its destination",
// which makes the stronger claim unwritable rather than merely unasserted (DESIGN 4b(4)).
//
// THE SECOND HOP IS PENDING A SIBLING LANE AND IS NOT BUILT HERE. The delivery of a credential to a
// path under a declared owner, group and mode is being consolidated into ONE custody authority as a
// closed roster of rows (the roadmap node ntfy-publisher-token-onto-gcp-custody, over the authority
// gunbc#11679 established). The census App private key belongs in that roster AS A ROW, and minting a
// second delivery path here to close this fact sooner would be the fork DESIGN 3 forbids -- so this
// says plainly that it is pending instead. When that roster lands, this arm gains its sibling and the
// row carries the SecretRef below, the handoff path, the reading principal and the mode.
//
// AND THE ESTABLISHED FACT IS ITS OWN RECORD, SO A RECEIPT CANNOT CARRY A STANDING. An earlier cut
// typed CensusAppAcquisitionReceipt.key_custody as the STANDING, which made CustodyNotEstablished
// representable inside a value whose whole meaning is "acquired" -- and forced the renderer to carry
// a defensive arm whose own text admitted it was unreachable. That arm was not a refusal: it returned
// an ordinary line the caller writes to the receipt file on ExitSuccess, so the one state it existed
// to catch would have been REPORTED AS THE RECEIPT. Validation standing where construction was
// available, at the same seam this type was congratulating itself for closing one field earlier
// (review 69472, DESIGN 5). The receipt now carries CustodyAtHandoff, which has no "not established"
// inhabitant, and the arm is gone rather than made louder.
type CustodyAtHandoff {
  path: String
  destination: SecretRef
}

type CustodyStanding
  = CustodyAtHandoffOnly { custody: CustodyAtHandoff }
  | CustodyNotEstablished { reason: NonEmptyStr }

type RegistrationStanding
  = RegistrationEstablished { app_id: GitHubAppId, slug: NonEmptyStr }
  | RegistrationNotEstablished { reason: NonEmptyStr }

type InstallationStanding
  = InstallationEstablished { admitted: AdmittedCensusInstallation }
  | InstallationNotEstablished { reason: NonEmptyStr }
  | InstallationInsufficient { reason: NonEmptyStr }
  | InstallationAmbiguous { reason: NonEmptyStr }
  | InstallationUnreadable { reason: NonEmptyStr }

// REGISTRATION IS ESTABLISHED BY THE DECISION, NOT BY THE RECORD. A record saying an App was acquired
// is this fleet's own note; Converged is that note joined to an independent public read that found the
// App and found it agreeing with the manifest. Every other verdict -- Absent, Drifted, Conflict,
// Inaccessible, UnknownRefused -- leaves registration unestablished, including the ones that prove an
// App exists, because an App that disagrees with the declared manifest is not the App this lane is
// about.
fn registration_standing(
  record: GitHubAppAcquisitionRecord,
  classification: UpsertClassification<CensusAppPlan>,
) -> RegistrationStanding {
  match classification.decision {
    Noop =>
      match record {
        AppAcquired { app_id: id, slug: s } => RegistrationEstablished { app_id: id, slug: s }
        AppNeverAcquired =>
          RegistrationNotEstablished {
            reason: "the classification converged while no acquisition record names an App; nothing here establishes which App converged" as NonEmptyStr
          }
      }
    Apply { plan: _ } =>
      RegistrationNotEstablished {
        reason: "the census App is not registered: the classification decided to register one" as NonEmptyStr
      }
    Refuse { reason: r } => RegistrationNotEstablished { reason: r }
  }
}

// THE INSTALLATION IS ADMITTED AGAINST A SUBJECT, NOT FOUND BY ITS APP ID. An earlier cut filtered
// the listing by app_id and took the first element, and that was the whole admission: an
// installation under another account, one with the wrong repository selection, one lacking the
// permissions the census reads with, and the first of several all satisfied it, and the receipt then
// said "acquired" over a capability nobody had established (DESIGN 4b(1)). GitHubAppInstallation
// already carried every fact that tells installations apart; none of them reached the decision.
//
// SO THE SUBJECT NAMES EVERY FACT THE HUMAN STEP ASKS FOR. The consent instruction tells the account
// holder to install for the target account and to choose the repositories the census may read; the
// subject is that instruction made checkable, plus the manifest's permission set, which the
// installation must hold at least as strongly as declared. The APP ID comes from registration, so
// the subject cannot exist before the registration fact does -- no later fact mints an earlier one.
type CensusAppInstallationSubject {
  app_id: GitHubAppId
  expected_account: NonEmptyStr
  repository_selection: GitHubAppRepositorySelectionMode
  required_permissions: List<GitHubAppPermission>
}

// THE ACCOUNT THE CENSUS IS INSTALLED ON IS A DIFFERENT FACT FROM WHERE THE APP IS REGISTERED. The
// registration target names the account that OWNS the App; an App is installed on any number of
// accounts, and this row names the one whose consent the census lane is closed against. They hold
// the same login today and are kept as two rows because they answer two questions.
data census_app_installation_account: NonEmptyStr = "gunb-ai"

// SELECTED, BECAUSE THAT IS WHAT THE CONSENT STEP ASKS FOR. app_installation_consent_intervention
// tells the account holder to choose the repositories the census may read; an "all repositories"
// installation is a broader consent than the one this lane requested, and admitting it would let the
// receipt certify a grant nobody was asked to make.
data census_app_installation_selection: GitHubAppRepositorySelectionMode = SelectionSelected

fn census_app_installation_subject(app_id: GitHubAppId) -> CensusAppInstallationSubject {
  CensusAppInstallationSubject {
    app_id: app_id,
    expected_account: census_app_installation_account,
    repository_selection: census_app_installation_selection,
    required_permissions: census_app_permissions,
  }
}

// THE ADMITTED INSTALLATION HAS ONE WRITER, AND IT IS THE ADMISSION BELOW. InstallationEstablished
// used to carry a bare GitHubAppInstallation, so any caller could wrap any installation in it and
// census_app_acquisition_standing would mint a receipt from it. sole_constructor makes the only way
// to hold one passing the complete subject through admit_census_installation.
type AdmittedCensusInstallation sole_constructor {
  subject: CensusAppInstallationSubject
  installation: GitHubAppInstallation
}

// THE POPULATION IS READ TO EXHAUSTION OR IT IS UNREADABLE. PopulationWalked carries std.page_fold's
// outcome, which holds items only when the authority itself closed the listing; a walk that ran out,
// cycled or hit its budget is PagesRefused and admits nothing. A zero-match answer is therefore an
// absence only over a closed population -- one page of a longer listing does not establish that the
// intended installation is not on the next one.
type InstallationPopulation
  = PopulationWalked { outcome: PageFoldOutcome<GitHubAppInstallation> }
  | PopulationUnreadable { reason: NonEmptyStr }

fn first_unmet_permission(
  required: List<GitHubAppPermission>,
  observed: List<ObservedGitHubPermission>,
) -> GitHubAppPermission? {
  fold(required, init: none, f: fn(found, p) {
    match found {
      Present { value: v } => Present { value: v }
      Absent =>
        match observed_access_for(perms: observed, axis: p.name) {
          Absent => Present { value: p }
          Present { value: held } =>
            if permission_access_at_least(held: held, requested: p.access) { none } else { Present { value: p } }
        }
    }
  })
}

fn installation_unattributable(reason: NonEmptyStr) -> InstallationStanding {
  InstallationNotEstablished {
    reason: join(["no installation can be attributed to an unregistered App: ", reason as String], "") as NonEmptyStr
  }
}

// THE ARMS ARE SEPARATE BECAUSE THEIR REMEDIES ARE. No installation on the account is a missing
// consent; an installation on the account that grants too little is a consent to WIDEN; two for one
// account is a reading that contradicts upstream (GitHub installs an App at most once per account),
// most plausibly an offset walk that shifted under a concurrent change, and it is repaired by reading
// again -- never by admitting whichever came first.
fn admit_census_installation(
  subject: CensusAppInstallationSubject,
  slug: NonEmptyStr,
  population: InstallationPopulation,
) -> InstallationStanding {
  match population {
    PopulationUnreadable { reason: r } => InstallationUnreadable { reason: r }
    PopulationWalked { outcome: outcome } =>
      match outcome {
        PagesRefused { refusal: refusal } =>
          InstallationUnreadable {
            reason: join([
              "the installation population was not read to exhaustion (",
              page_fold_refusal_key(r: refusal) as String,
              "); an installation later in the listing may exist, so this is neither an absence nor an admission",
            ], "") as NonEmptyStr
          }
        PagesClosed { subject: _, pages_read: _, items: all } => {
          let of_app = filter(all, i => i.app_id.value == subject.app_id.value)
          let on_account = filter(of_app, i => i.account.login == (subject.expected_account as String))
          match first(on_account) {
            Absent =>
              InstallationNotEstablished {
                reason: join([
                  "census App ", slug as String,
                  " is registered and the complete installation listing (", to_string(count(all)),
                  " installation(s), ", to_string(count(of_app)),
                  " of this App) holds none on account ", subject.expected_account as String,
                  "; an installation on another account or of another App does not install this one, and registering an App grants it access to nothing, so the account holder must still consent on its install page",
                ], "") as NonEmptyStr
              }
            Present { value: i } =>
              if count(on_account) > 1 {
                InstallationAmbiguous {
                  reason: join([
                    "the installation listing holds ", to_string(count(on_account)),
                    " installations of app id ", to_string(subject.app_id.value),
                    " on account ", subject.expected_account as String,
                    "; GitHub installs an App once per account, so the reading contradicts itself and none is admitted",
                  ], "") as NonEmptyStr
                }
              } else if i.repository_selection != subject.repository_selection {
                InstallationInsufficient {
                  reason: join([
                    "installation ", to_string(i.installation_id.value),
                    " on ", subject.expected_account as String,
                    " has repository selection ", repository_selection_wire_name(mode: i.repository_selection) as String,
                    " and the census consent is for ", repository_selection_wire_name(mode: subject.repository_selection) as String,
                  ], "") as NonEmptyStr
                }
              } else {
                match first_unmet_permission(required: subject.required_permissions, observed: i.permissions) {
                  Present { value: p } =>
                    InstallationInsufficient {
                      reason: join([
                        "installation ", to_string(i.installation_id.value),
                        " on ", subject.expected_account as String,
                        " does not hold ", permission_axis_wire_name(axis: p.name) as String,
                        ":", permission_access_wire_name(access: p.access) as String,
                        ", which the census manifest declares; the account holder must approve the App's requested permissions on that installation",
                      ], "") as NonEmptyStr
                    }
                  Absent =>
                    InstallationEstablished {
                      admitted: AdmittedCensusInstallation { subject: subject, installation: i }
                    }
                }
              }
          }
        }
      }
  }
}

fn installation_standing_for(
  registration: RegistrationStanding,
  population: InstallationPopulation,
) -> InstallationStanding {
  match registration {
    RegistrationNotEstablished { reason: r } => installation_unattributable(reason: r)
    RegistrationEstablished { app_id: id, slug: s } =>
      admit_census_installation(subject: census_app_installation_subject(app_id: id), slug: s, population: population)
  }
}

type CensusAppAcquisitionReceipt {
  app_id: GitHubAppId
  slug: NonEmptyStr
  installation: AdmittedCensusInstallation
  key_custody: CustodyAtHandoff
}

// THE MISSING FACT KEEPS THE DISTINCTION THAT DECIDES WHAT TO DO NEXT, and collapsing the two
// installation arms into one is the defect this type was corrected for (review 69499). The rule is
// stated on read_census_app_installations -- unreadable must not collapse into empty, because "the
// JWT was stale" and "the App has no installation" prescribe OPPOSITE acts -- and an earlier cut
// obeyed it everywhere except where it mattered: both arms survived in InstallationStanding and in
// the printed reason, while the PRESCRIPTION was derived from a single collapsed arm and was
// identical for both. A stale-JWT 401 told the operator to go grant a consent that may already
// exist.
//
// SO THE ARMS ARE SEPARATE HERE AND THE CONSUMER MATCHES ON THEM, rather than the consumer re-reading
// the reason string to recover what this type discarded. Re-parsing would put the discrimination back
// in a consumer after the type had thrown it away, which is the same shape as the unguarded path
// builder deleted one commit earlier: a wall standing one call away from the thing it guards.
type AcquisitionFactMissing
  = RegistrationMissing { reason: NonEmptyStr }
  | InstallationConsentMissing { reason: NonEmptyStr }
  | InstallationConsentInsufficient { reason: NonEmptyStr }
  | InstallationReadingAmbiguous { reason: NonEmptyStr }
  | InstallationReadingUnavailable { reason: NonEmptyStr }
  | CustodyMissing { reason: NonEmptyStr }

type CensusAppAcquisitionStanding
  = CensusAppAcquired { receipt: CensusAppAcquisitionReceipt }
  | AcquisitionIncomplete { missing: AcquisitionFactMissing }

fn census_app_acquisition_standing(
  registration: RegistrationStanding,
  installation: InstallationStanding,
  custody: CustodyStanding,
) -> CensusAppAcquisitionStanding {
  match registration {
    RegistrationNotEstablished { reason: r } =>
      AcquisitionIncomplete { missing: RegistrationMissing { reason: r } }
    RegistrationEstablished { app_id: id, slug: slug } =>
      match installation {
        InstallationNotEstablished { reason: r } =>
          AcquisitionIncomplete { missing: InstallationConsentMissing { reason: r } }
        InstallationInsufficient { reason: r } =>
          AcquisitionIncomplete { missing: InstallationConsentInsufficient { reason: r } }
        InstallationAmbiguous { reason: r } =>
          AcquisitionIncomplete { missing: InstallationReadingAmbiguous { reason: r } }
        InstallationUnreadable { reason: r } =>
          AcquisitionIncomplete { missing: InstallationReadingUnavailable { reason: r } }
        InstallationEstablished { admitted: i } =>
          match custody {
            CustodyNotEstablished { reason: r } =>
              AcquisitionIncomplete { missing: CustodyMissing { reason: r } }
            CustodyAtHandoffOnly { custody: c } =>
              CensusAppAcquired {
                receipt: CensusAppAcquisitionReceipt {
                  app_id: id,
                  slug: slug,
                  installation: i,
                  key_custody: c,
                }
              }
          }
      }
  }
}

// THE RECEIPT, RENDERED FOR THE ONE READER THAT ASKED FOR IT. The roadmap node this lane is closed
// against hands back "a receipt naming the registered App, the installation, and the custody location
// of its key, or a typed refusal saying which of the three is missing", so the two arms below are that
// sentence and nothing else is added to them.
fn acquisition_standing_line(standing: CensusAppAcquisitionStanding) -> String {
  match standing {
    CensusAppAcquired { receipt: r } =>
      join(
        [
          "census App acquired: app_id=", to_string(r.app_id.value),
          " slug=", r.slug as String,
          " installation_id=", to_string(r.installation.installation.installation_id.value),
          " account=", r.installation.installation.account.login,
          " key at handoff ", r.key_custody.path,
          " destined for secret ", r.key_custody.destination.secret as String,
          " (the second hop into the fleet custody roster is pending; see CustodyStanding)",
        ],
        "",
      )
    AcquisitionIncomplete { missing: m } =>
      match m {
        RegistrationMissing { reason: r } =>
          join(["census App NOT acquired -- REGISTRATION is missing: ", r as String], "")
        InstallationConsentMissing { reason: r } =>
          join(["census App NOT acquired -- INSTALLATION is missing: ", r as String], "")
        InstallationConsentInsufficient { reason: r } =>
          join(["census App NOT acquired -- the INSTALLATION exists and grants less than the census consent: ", r as String], "")
        InstallationReadingAmbiguous { reason: r } =>
          join(["census App NOT acquired -- the INSTALLATION reading is ambiguous: ", r as String], "")
        InstallationReadingUnavailable { reason: r } =>
          join(["census App NOT acquired -- the INSTALLATION fact could not be READ, which is not the same as having none: ", r as String], "")
        CustodyMissing { reason: r } =>
          join(["census App NOT acquired -- KEY CUSTODY is missing: ", r as String], "")
      }
  }
}
