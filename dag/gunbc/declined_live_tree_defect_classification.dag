module gunbc.declined_live_tree_defect_classification

import std.types { String, List }
import v2.std.integer { Int }
import std.algebra { list_snoc_item, count_where, length, fold_list }

// WHY THIS CARRIER EXISTS. Thirteen witness identities were measured failing on
// royal-cat-509's run 32794539384 -- the only tree in which the required floor's
// DeclinedLiveTree arm is deleted, so the only tree in which these ever executed.
// They were routed here to be classified. A classification is a machine-consumed
// fact (which identity is a real defect, which is a wrong assertion, what closes
// it), so DESIGN 4c puts it in a typed carrier rather than in prose.
//
// WHAT THIS CARRIER IS NOT. It is not an expected-red enrolment and must never
// become one: enrolling a row here would assert that the floor runs it and that
// it fails, and the floor does not run it at all. That is the authority
// substitution DESIGN's failure-mode list names, and it is the specific mistake
// gunbc#8865 made. Every row below is UNGUARDED by construction, and the only
// mechanism that changes that is the DeclinedLiveTree deletion itself.
//
// PROVENANCE OF THE POPULATION vs PROVENANCE OF THE CLASSIFICATION, kept apart
// because they are different measurements on different trees. The population is
// royal-cat-509's; the classification is this session's, re-measured on main at
// 4ab80676e7 (plus whatever main had advanced to under the remote runner's
// rebase) with claim_batch --hermetic and --wet. Every one of the thirteen
// REPRODUCED, so no row is NotReproduced -- which is itself the load-bearing
// result, because it establishes that all thirteen are main-side facts and none
// is branch content of the cut.

// ONE SHAPE RECURS ACROSS THREE OF THE FOUR REAL SUBJECTS, and it is worth
// naming once rather than three times: a cut deletes a population, rows
// elsewhere go on naming what it removed, and nothing notices because the thing
// that would notice does not run. The 2026-08-15 floor cut left two stale
// non_fold_residue rows naming src/v2/workflow/ci_floor_plan.dag; the 2026-08-24
// measurement bankruptcy left 19 doc roots and 12 links naming deleted
// docs/probes/ files. Three separate cuts, the same residue, undetected for the
// same reason.

type DeclinedLiveIdentity {
  module_path: String
  function: String
}

// The three verdicts the brief asked for. NotReproduced is carried even though
// no row inhabits it: a verdict vocabulary that could not express "it passed on
// my head" would have made the reproduction claim unfalsifiable.
type DefectClassification =
    RealDefect { subject: RealDefectSubject }
  | WrongWitness { fault: WrongWitnessFault }
  | NotReproduced { explanation: String }

// What is actually broken, at the grain the remedy differs on.
type RealDefectSubject =
    StaleAuthorityAfterDeletion
  | UndeclaredResidentPopulation
  | MissingCitedAuthority
  | CompilerBehaviourRefusal

// Why the assertion, rather than the subject, is at fault.
type WrongWitnessFault =
    CriterionCannotHoldOnLiveCorpus { measured: Int, denominator: Int }

// NAMED ClassificationDisposition RATHER THAN Disposition, AND THE COLLISION IS
// NOT HYPOTHETICAL: the first revision of this carrier called it Disposition, and
// strict preparation over the whole pool then refused 3918 modules with
// `unresolved type 'Disposition'` AND `unresolved type 'Scaffold'` across ~20
// unrelated files. std.disposition declares `type Disposition` with a `Scaffold`
// variant, and modules such as gunbc.ci.ci_input_envelope use both as BARE names;
// a second top-level Disposition made that bare name ambiguous and dropped the
// whole binding, taking the variant with it. A closure-scoped `compile --entry`
// cannot see this -- it never resolves this module -- so the only instrument
// that discriminates is a whole-pool preparation.
//
// What closes the row. RepairedInThisChange is deliberately rare: most of these
// rows are owned by a lane that is not this one, and repairing another lane's
// authority from inside a classification pass is how a second authority gets
// minted for one fact.
// A CLOSED ROW IS STILL A ROW. A defect fixed by an earlier change keeps its identity, its
// classification, and its measured evidence; only its disposition moves, and the disposition must
// carry WHAT CLOSED IT: the commits that did the closing, and the head at which the claim was
// RE-EXECUTED (not re-read) to confirm it holds. Prose does not close a row; the tuple here does,
// because the re-measurement head is checkable against `git log` by anyone. Added for #14545
// (manager ruling: a 'closed by' string under `RoutedToOwner` would be one name with two meanings,
// DESIGN §3 nicknaming); `RepairedInThisChange` cannot carry it either — it names no repair and
// this change does not perform one.
type ClosureReceipt {
  closed_by: List<String>
  re_measured_at: String
}

type ClassificationDisposition =
    RoutedToOwner { owner: String }
  | NeedsOperatorRuling { question: String }
  | RepairedInThisChange
  | ClosedByPriorChange { receipt: ClosureReceipt }

// measured_evidence records what was EXECUTED to reach the verdict, never what
// was read: a classification derived from reading a lens is not a measurement.
type ClassifiedRow {
  identity: DeclinedLiveIdentity
  classification: DefectClassification
  measured_evidence: String
  disposition: ClassificationDisposition
}

fn identity(module_path: String, function: String) -> DeclinedLiveIdentity {
  DeclinedLiveIdentity { module_path: module_path, function: function }
}

// ---------------------------------------------------------------------------
// GROUP B -- the six doc-graph rows, and they are ONE root cause plus two
// secondaries. The 2026-08-24 measurement bankruptcy deleted docs/probes/ whole.
// It did not update gunbc.doc_graph_roots, whose hand-authored ProbeDoc binds
// still name 19 of the deleted files, and it did not update the prose that links
// to them. MEASURED ON 2026-08-24: 228 declared roots, 209 admitted (19 name no
// file, every one of them under docs/probes/); 16 dangling markdown links, 12 of
// them into docs/probes/ and 4 at docs/plans/ci-selection-vs-scheduling.md; 35
// orphan docs once the admitted roots are walked. RE-MEASURED 2026-10-21 at head
// a162e67d1af8: 27 declared, 27 admitted -- the population those counts described
// was removed by #9181 and #9186, so the 2026-08-24 figures are history, not the
// measurement, and each row below says which it is.
//
// THE PART THAT NEEDED A RULING RATHER THAN A REPAIR, AND HOW IT CLOSED (kept
// here because deleting it would hide a violation that had already landed). Three
// of the 19 dead binds were the g1-cited-symbol-control-* rows, which
// doc_graph_roots declared PlanHasNoRetirement -- permanent discriminating
// evidence, kept under DESIGN 4b(4) precisely so a climb could not delete it. The
// bankruptcy deleted it anyway, by a sweep that took docs/probes/ whole. The two
// available closures were NOT peers (manager ruling, swift-badger-524,
// 2026-08-25): deleting the three binds FINISHED a deletion 4b(4) forbids and made
// it invisible, while restoring the three files from history reversed part of an
// operator cut -- only the second is reversible by anyone other than the operator,
// which is why the question was theirs and no lane may have quietly taken the
// first. #9181 (0df5b4170c51) took a third path that answers it: the three
// controls were machine discriminators, not documents, so they were REHOMED as
// `cited_symbol_planted_controls` in v2.lens.cited_symbol_resolution -- the
// permanent evidence was moved, not finished -- and only then were their orphan
// binds deleted atomically. The account survives in data too, at
// dag/test/claim/doc_graph_reference_partition_witness.dag
// `cited_symbol_partition_third_bucket_note`; it is deliberately not repeated as a
// String here, because a String whose only purpose is commentary is misplaced data
// (DESIGN 4c) and this row's only reader was the NeedsOperatorRuling this change
// replaced. The other sixteen dead binds carried ordinary retirements and needed
// no ruling.
// ---------------------------------------------------------------------------

data doc_reachability_rows: List<ClassifiedRow> = [
  ClassifiedRow {
    identity: identity(module_path: "test.claim.doc_reachability_witness", function: "doc_graph_registered_plan_roots_all_admitted"),
    classification: RealDefect { subject: StaleAuthorityAfterDeletion },
    // RE-MEASURED, NOT RESTATED, because the census below is a 2026-08-24 snapshot and the thing it
    // counted has since changed twice. Executed at head a162e67d1af8 (2026-10-21) by the same route
    // the claim uses -- the claim_batch host over the live gunbc.doc_graph_roots -- the counts are
    // declared 27 == admitted 27, and the claim itself runs PASS on the schedule that
    // v2.workflow.local_repo_wet_terminal `local_repo_wet_schedule` now carries it on. The 19 dead
    // binds the census counted are gone: on 2026-08-25 the three g1-cited-symbol controls were
    // REHOMED as machine planted controls for the cited-symbol lens (so the permanent evidence
    // 4b(4) protects was MOVED, not finished -- which is also what retires the ruling question
    // below), and the 16 dead ProbeDoc binds plus the last emitted plan root were deleted. The
    // figure that was here ("228 declared roots, 209 admitted") was accurate on 2026-08-24 and
    // names the population that no longer exists; it is kept in that sentence, not as the
    // measurement.
    measured_evidence: "RE-MEASURED 2026-10-21 at a162e67d1af8: declared roots 27, admitted roots 27, claim runs PASS (executed). Historical census, now stale: 228 declared / 209 admitted on 2026-08-24; those 19 unadmitted binds were deleted on 2026-08-25 after the g1 controls were rehomed (account cited in closed_by).",
    disposition: ClosedByPriorChange {
      receipt: ClosureReceipt {
        // The commits of 2026-08-25 that rehomed the g1 controls and deleted the dead binds are NOT
        // CITED BY HASH, because the 2026-10 mega-squash rewrote history and those objects are no
        // longer reachable from this head -- a hash here would send a reader to a commit they cannot
        // check out. What is cited instead is main's own durable account of the same events, which
        // this row's author verified against the live tree before writing the re-measurement below.
        closed_by: [
          "2026-08-25, operator ruling: the three g1-cited-symbol discriminating controls were REHOMED as machine planted controls for the cited-symbol lens, and the 16 dead ProbeDoc binds plus the emitted plan root were deleted. Durable account: dag/gunbc/doc_graph_roots.dag header ('They moved to that lens as a typed control carrier on 2026-08-25 (operator ruling)'; 'SIXTEEN PROBE-DOC BINDS WERE DELETED THE SAME DAY, AND THE HOME AXIS DELIBERATELY SURVIVED THEM') and dag/test/claim/doc_graph_reference_partition_witness.dag `cited_symbol_partition_third_bucket_note`",
        ],
        re_measured_at: "2026-10-21 at head a162e67d1af8: doc_graph_roots_all() declared 27 == doc_graph_admitted_root_count 27, executed through the claim_batch host; test.claim.doc_reachability_witness.doc_graph_registered_plan_roots_all_admitted PASS on the same host",
      }
    }
  },
  ClassifiedRow {
    identity: identity(module_path: "test.claim.doc_reachability_witness", function: "doc_graph_has_no_dangling_links"),
    classification: RealDefect { subject: StaleAuthorityAfterDeletion },
    measured_evidence: "16 dangling .md links: 12 into deleted docs/probes/ targets, 4 at docs/plans/ci-selection-vs-scheduling.md (one of them from ROADMAP.md itself)",
    disposition: RoutedToOwner { owner: "the measurement-bankruptcy cut's owner: the residue DESIGN already names as the next cut" }
  },
  ClassifiedRow {
    identity: identity(module_path: "test.claim.doc_reachability_witness", function: "doc_graph_has_no_orphan_docs"),
    classification: RealDefect { subject: StaleAuthorityAfterDeletion },
    measured_evidence: "35 orphans against the admitted root set; 8 are docs/briefs/ authored 2026-08-24 with no bind at all, 2 are the surviving docs/probes/ files, the rest are docs/plans/ rows never registered",
    disposition: RoutedToOwner { owner: "doc-graph roots authority (gunbc.doc_graph_roots) plus each orphan's authoring lane" }
  },
  ClassifiedRow {
    identity: identity(module_path: "v2.test.lens_doc_reachability.doc_reachability", function: "doc_graph_has_no_dangling_links"),
    classification: RealDefect { subject: StaleAuthorityAfterDeletion },
    measured_evidence: "same 16 dangling links; this identity and the dag-side one read one report through two witnesses",
    disposition: RoutedToOwner { owner: "the measurement-bankruptcy cut's owner" }
  },
  ClassifiedRow {
    identity: identity(module_path: "v2.test.lens_doc_reachability.doc_reachability", function: "doc_graph_has_no_orphan_docs"),
    classification: RealDefect { subject: StaleAuthorityAfterDeletion },
    measured_evidence: "same 35 orphans",
    disposition: RoutedToOwner { owner: "doc-graph roots authority plus each orphan's authoring lane" }
  },
  ClassifiedRow {
    identity: identity(module_path: "v2.test.lens_doc_reachability.doc_reachability", function: "doc_graph_is_clean"),
    classification: RealDefect { subject: StaleAuthorityAfterDeletion },
    measured_evidence: "the conjunction of the orphan and dangling halves above; it carries no third fact and cannot green before both do",
    disposition: RoutedToOwner { owner: "doc-graph roots authority plus each orphan's authoring lane" }
  }
]

// ---------------------------------------------------------------------------
// GROUP A -- the seven exact identities.
// ---------------------------------------------------------------------------

// THE LENS-GATE PAIR, AND THIS WAS THE ONE WRONG WITNESS IN THE THIRTEEN.
// Execution decomposed the failure to redundant_blocking: the old criterion
// treated equal (verdict_authority, remedy) as invariant identity, producing 42
// false refusals, including two independently repaired complexity invariants
// owned by one module. The repair landed at the criterion: LensInvariantSurface
// now carries the registry entry's LensIdV0, and redundancy requires that same
// invariant identity in addition to equal reporting metadata. The audit-residue
// escape mechanism was deleted at its root; every duplicate identity blocks,
// and no hand-authored exemption roster can drift or absorb a new finding.
data lens_module_gate_rows: List<ClassifiedRow> = [
  ClassifiedRow {
    identity: identity(module_path: "v2.test.claim.enforcement.lens_module_gate_witness", function: "lens_module_gate_holds_live"),
    classification: WrongWitness { fault: CriterionCannotHoldOnLiveCorpus { measured: 42, denominator: 58 } },
    measured_evidence: "decomposed by execution on main: lens_module_gate_unenrolled_count() == 0 PASS, lens_module_gate_unjustified_count() == 0 PASS, lens_module_gate_redundant_blocking_count() == 0 FAIL; the 42 offending pairs were re-derived independently from the registry order and the surface table",
    disposition: RoutedToOwner { owner: "v2.lens.enforcement.lens_module_gate -- the fix is at the criterion (surface declared on-carrier, its own dissolution condition); adding exemption rows is ruled out" }
  },
  ClassifiedRow {
    identity: identity(module_path: "v2.test.claim.enforcement.lens_module_gate_witness", function: "question_zero_verdict_live_holds"),
    classification: WrongWitness { fault: CriterionCannotHoldOnLiveCorpus { measured: 42, denominator: 58 } },
    measured_evidence: "same redundant_claim leg; this witness passes facts: [] so its unenrolled and unjustified legs are vacuously clean and only the shared leg can fail",
    disposition: RoutedToOwner { owner: "v2.lens.enforcement.lens_module_gate -- same criterion, same prohibition on exemption rows" }
  }
]

// THE FOUR REMAINING GROUP-A ROWS, each a distinct real subject.
data group_a_remaining_rows: List<ClassifiedRow> = [
  ClassifiedRow {
    identity: identity(module_path: "v2.lens.mandatory_tag.corpus_scan_witness", function: "corpus_live_clean_tree_wall_holds"),
    classification: RealDefect { subject: MissingCitedAuthority },
    measured_evidence: "roster count is healthy (>150 PASS); the clean-tree half fails on exactly two modules, extdeps.cpu_attachment.lotes_azifa072 and extdeps.languages.rust.capabilities, both projecting anchor Absent -- an extdeps module with no external-authority anchor is the DESIGN 3 citation duty unmet",
    disposition: RoutedToOwner { owner: "the authoring lane of each extdeps module: the anchor must be the real upstream locator, which this session cannot invent" }
  },
  ClassifiedRow {
    identity: identity(module_path: "v2.test.lens_non_fold_residue.non_fold_residue_test", function: "non_fold_residue_no_unrostered_or_stale"),
    classification: RealDefect { subject: UndeclaredResidentPopulation },
    measured_evidence: "unrostered=21 stale=4 live=186; the 4 stale rows name sites that no longer exist, two of them in src/v2/workflow/ci_floor_plan.dag which the 2026-08-15 floor cut deleted; the 21 unrostered are live wildcard arms over closed coproducts, concentrated in src/v2/workflow/dag_acceptance.dag (11) and dag/product (5)",
    disposition: RoutedToOwner { owner: "each unrostered site's module owner -- DESIGN's total-at-the-level-examined class says the remedy is usually to descend the match, not to author a roster row for it" }
  },
  ClassifiedRow {
    identity: identity(module_path: "v2.test.claim.execution.emit_ingest_grammar_relation_round_trip", function: "same_grammar_parse_ingest_bridge_holds"),
    classification: RealDefect { subject: CompilerBehaviourRefusal },
    measured_evidence: "DECOMPOSED BY EXECUTION 2026-08-28, and the cause is not the one an earlier revision of this row named. That revision said only that parse_tree_to_emitted_node REFUSES with parse_tree_to_emitted_node_no_matching_row and that it is the parse-tree shape that selects none of the rows -- true, and under-stated in the direction that routes a reader into a non-repair, because it reads as a shape mismatch to be reconciled rather than as a fork. The two spines were printed side by side from a probe entry over the live tree: the row spine from v2.extdeps.languages.dag dag_concrete_tokens is 18 classes (kw_fn ident lparen ident colon ident comma ident colon ident rparen arrow ident lbrace ident plus ident rbrace); the frontier that v2.compiler.ingest operational_parse_tree_project_to_formal_captures builds over parse_module of ingested_add_module_source is 22 symbols (kw_module m kw_fn add lparen x colon Int comma y colon Int rparen arrow Int lbrace x plus y rbrace). TWO INDEPENDENT DISAGREEMENTS, and only the second is the subject. (1) the fixture is a MODULE, so the frontier carries the module header while the row covers only the fn -- a bridge over a module would have to descend to the fn declaration. (2) THE FORK: v2.extdeps.languages.dag carries TWO production tables for one language. dag_grammar_root is the real recursive surface grammar that dag_language_model parses with, and its identifier terminals are dag_grammar_terminal_lexeme, so v2.compiler.parse parse_stamp_terminal stamps StampLexeme atoms with the INTERNED LEXEME and the token class is not recoverable from the atom. dag_formal_production_fn_add is a FLAT 18-token production whose lhs dag_production_fn_add appears NOWHERE in dag_grammar_root, and it is what every grammar-relation row is grounded on. The four sibling witnesses pass because they stay entirely inside the flat table; this one is the only witness that crosses, so it asserts exactly what is false -- it is not the same grammar. The python bridge passes for the complementary reason: python uses grammar_formal_terminal (StampClass) and parses one production, so its atoms already carry token classes. Corollary, and it is why the surfaced reason misleads: v2.compiler.ingest parse_atom_frontier_class keys binding_to_class on BINDING symbols, so it can only ever cover StampBinding terminals, and on a miss it returns the atom identity -- FABRICATING a class rather than refusing, which converts an unrecoverable-token-class condition into a silent non-match reported as no_matching_row",
    disposition: RoutedToOwner { owner: "not a local repair in v2.compiler.ingest: closing this witness is a DESIGN 3 replacement migration in v2.extdeps.languages.dag -- the flat dag_formal_production_fn_add table dies, the grammar-relation rows key on dag_grammar_root's own productions, and the frontier is projected by walking the production's GrammarExpr against the captured tree instead of guessed from atom identities. Scoped as its own lane; the fabricated-class fallback above cannot be repaired ahead of it, because StampClass atoms legitimately carry their class as their identity and nothing at that layer can tell the two cases apart without the grammar" }
  },
  ClassifiedRow {
    identity: identity(module_path: "v2.test.claim.execution.self_host_candidate_generation", function: "candidate_generation_translate_self_emit_dag_add_slice_holds"),
    classification: RealDefect { subject: CompilerBehaviourRefusal },
    measured_evidence: "staged by execution: infer(dag_add_emitted_root) ACCEPTS, translate(inferred, dag_add_target_model) REFUSES with head reason infer_grounding_not_derived; identical under --hermetic and --wet, so the mode is not the discriminator. REPAIR RECEIPT, 2026-09-07: the owner lane's declared-inhabitant roster-membership derivation (v2.compiler.infer infer_node_declared_in_language_inhabitants) grounds the slice's ten type-spine nodes by lookup against the dag language authority's declared-inhabitants roster, and the witness now PASSES under claim_batch --hermetic on the repairing tree (re-measured after the merge onto main at 5ee9cab5fa). The classification and the first sentence are kept verbatim as the dated record of the defect as routed; this sentence is the repair measurement.",
    disposition: RepairedInThisChange
  },
  ClassifiedRow {
    identity: identity(module_path: "v2.test.claim.manual.test_migration_debt", function: "retained_rust_kernel_wall_holds_against_live_tree"),
    classification: RealDefect { subject: UndeclaredResidentPopulation },
    measured_evidence: "src/v1/tests/src/anonymous_record_struct_resolution_test.rs is discovered (column-anchored #[test] present), has no floor-witness stem covering it, and has no row in test.retirement.model retained_legacy_rust_test_modules, so every_discovered_module_is_retained() refuses; the file was added by gunbc#9089 on main",
    disposition: RoutedToOwner { owner: "gunbc#9089's lane: either migrate the module to a .dag witness or declare a retention row with a real non-migratable reason, which this session cannot assert on its behalf" }
  }
]

data no_classified_rows: List<ClassifiedRow> = []

data no_identity_keys: List<String> = []

fn declined_live_tree_classified_rows() -> List<ClassifiedRow> {
  fold_list(
    xs: [doc_reachability_rows, lens_module_gate_rows, group_a_remaining_rows],
    empty: no_classified_rows,
    cons: fn(acc, group) {
      fold_list(xs: group, empty: acc, cons: fn(inner, row) { list_snoc_item(xs: inner, item: row) })
    }
  )
}

fn classified_row_count() -> Int {
  length(xs: declined_live_tree_classified_rows())
}

fn identity_key(i: DeclinedLiveIdentity) -> String {
  concat(i.module_path, concat("::", i.function))
}

fn classified_identity_keys() -> List<String> {
  fold_list(
    xs: declined_live_tree_classified_rows(),
    empty: no_identity_keys,
    cons: fn(acc, row) { list_snoc_item(xs: acc, item: identity_key(i: row.identity)) }
  )
}

fn key_occurrence_count(key: String) -> Int {
  count_where(xs: classified_identity_keys(), predicate: fn(k) { k == key })
}

fn classified_identities_are_unique() -> Bool {
  !any(xs: classified_identity_keys(), predicate: fn(k) { key_occurrence_count(key: k) != 1 })
}

fn row_carries_measured_evidence(row: ClassifiedRow) -> Bool {
  string_length(s: row.measured_evidence) > 0
}

fn every_row_carries_measured_evidence() -> Bool {
  !any(xs: declined_live_tree_classified_rows(), predicate: fn(row) { !row_carries_measured_evidence(row: row) })
}

// The reproduction claim, stated as a derived property rather than as prose: no
// row is NotReproduced, because all thirteen were re-measured failing on main.
fn row_is_not_reproduced(row: ClassifiedRow) -> Bool {
  match row.classification {
    NotReproduced { explanation: _ } => true
    RealDefect { subject: _ } => false
    WrongWitness { fault: _ } => false
  }
}

fn not_reproduced_count() -> Int {
  count_where(xs: declined_live_tree_classified_rows(), predicate: row_is_not_reproduced)
}

fn all_thirteen_reproduced_on_main() -> Bool {
  not_reproduced_count() == 0
}

fn row_is_real_defect(row: ClassifiedRow) -> Bool {
  match row.classification {
    RealDefect { subject: _ } => true
    WrongWitness { fault: _ } => false
    NotReproduced { explanation: _ } => false
  }
}

fn real_defect_count() -> Int {
  count_where(xs: declined_live_tree_classified_rows(), predicate: row_is_real_defect)
}

fn wrong_witness_count() -> Int {
  count_where(xs: declined_live_tree_classified_rows(), predicate: fn(row) {
    match row.classification {
      WrongWitness { fault: _ } => true
      RealDefect { subject: _ } => false
      NotReproduced { explanation: _ } => false
    }
  })
}
