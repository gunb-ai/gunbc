    use: SpellingEscapesToCaller { escapes_as: "summary.name, returned as the canonical struct head for an anonymous literal", consumed_by: decl_ref(module_path: "v1.compiler.emit_rust", decl_name: "find_struct_name_by_fields") },
    lookup_expression_count: 1,
  },
  {
    site: decl_ref(module_path: "v1.compiler.emit_rust", decl_name: "emit_typed_record_lit"),
    keys_on: "the resolved type's authored name as a membership test, the chosen head name as a second membership test, and variant_summary_name for the defaults pass",
    ask: NodeHeldAtAsk { holder_expression: "resolved_type -- held throughout, and already gated on resolved_type.ident_span != none" },
    use: ReKeyedIntoForeignNameTable { table: decl_ref(module_path: "v1.compiler.emit_rust", decl_name: "rust_zero_value"), why_a_rekey_cannot_reach_it: "the field type spelling from field_type_map is passed to a name-keyed zero-value table that takes no identity parameter, so an identity-keyed summary map changes nothing at this hop until that table is keyed too" },
    lookup_expression_count: 3,
