    keys_on: "nothing -- it scans every summary asking whether ANY enum has this variant spelling",
    ask: NoKeyWholeMapScan { what_is_scanned: "map_values(type_summaries), testing each variant_name_set for the name" },
    use: TerminalAtSite { what_is_decided: "a Bool, deliberately quantified over the whole closure -- so the more collisions the map holds, the more often it answers true" },
    lookup_expression_count: 1,
  },
  {
    site: decl_ref(module_path: "v1.compiler.infer", decl_name: "enum_variant_shape_sets_for_item"),
    keys_on: "authored_name_at of the item being folded",
    ask: NodeHeldAtAsk { holder_expression: "item -- the declaration Node itself, together with its own module's source_indices" },
    use: SpellingEscapesToCaller { escapes_as: "concat(item_name, colon-colon, variant name) inserted into the fielded and positional_payload sets", consumed_by: decl_ref(module_path: "v1.compiler.infer_emit_info", decl_name: "variant_has_fields") },
