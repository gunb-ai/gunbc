    ask: NoKeyWholeMapScan { what_is_scanned: "map_values(type_summaries), selecting names whose repr and recursion make them Rc-shared" },
    use: SpellingEscapesToCaller { escapes_as: "a Set<String> of bare names, later tested with set_contains at 27 render sites -- of which only 6 pass an expression already reduced to a leaf, the rest passing a name binding that may be dotted (counted on main, 2026-08-22)", consumed_by: decl_ref(module_path: "v1.compiler.emit_rust", decl_name: "emit_struct_from_children") },
    lookup_expression_count: 1,
