module gunbc.spark_serving_plan_apply

import std.types { String, NonEmptyStr }
import std.algebra { trim }
import std.process { ProcessExit, ExitSuccess, exit_failure }
import std.resources { Network }
import std.content_hash {
  content_hash_atom,
  Fnv1a64Structural,
  fnv1a64_structural_hex_digest,
}
import extdeps.filesystem.filesystem_io { Filesystem }
import gunbc.fleet_intent_network { operator_host_srv5, operator_host_srv6 }
import gunbc.host_spark_serving_provision_script { spark_serving_provision_script_body }
import gunbc.spark_serving_provision_apply { spark_serving_provision_apply_for_host }
import gunbc.fleet_multi_principal_probe { fleet_ssh_attempt_raw_from_env }

data spark_serving_plan_apply_note: String = "Spark serving plan/apply (#8230 pattern at Spark grain). Plan materializes the provision script body and its content hash; apply refuses unless the on-disk plan matches the hash, then runs spark_serving_provision_apply_for_host over FleetSsh. Interim wet entrypoints (spark_serving_plan_apply_srv5/_srv6) delegate to the provision apply transport — not gunbc#8073 GHA sidecars; blocked from host_effect_apply until ProvisionSparkServing lands."

data spark_serving_plan_body_path: String = "/tmp/spark-serving-plan/install.sh"

data spark_serving_plan_hash_path: String = "/tmp/spark-serving-plan/plan_content.hex"

data spark_serving_plan_host_path: String = "/tmp/spark-serving-plan/host.txt"

fn spark_serving_plan_body() -> String {
  spark_serving_provision_script_body()
}

fn spark_serving_plan_content_hash(plan_body: String) -> Fnv1a64Structural {
  content_hash_atom(value: plan_body as NonEmptyStr)
}

fn spark_serving_plan_hash_from_hex(text: String) -> Fnv1a64Structural? {
  fnv1a64_structural_hex_digest(hex: trim(s: text))
}

fn spark_serving_plan_bundle_matches(
  plan_body: String,
  recorded_hash: Fnv1a64Structural,
) -> Bool {
  (spark_serving_plan_content_hash(plan_body: plan_body).digest as String)
    == (recorded_hash.digest as String)
}

func spark_serving_plan_wet(host: String) -> ProcessExit
  uses net: Network
{
  let body = spark_serving_plan_body()
  let hash = spark_serving_plan_content_hash(plan_body: body)
  let w_body = Filesystem.Write(path: spark_serving_plan_body_path, content: body)
  let w_hash = Filesystem.Write(
    path: spark_serving_plan_hash_path,
    content: hash.digest as String,
  )
  let w_host = Filesystem.Write(path: spark_serving_plan_host_path, content: host)
  if w_body.success && w_hash.success && w_host.success {
    ExitSuccess
  } else {
    exit_failure(reason: "spark_serving_plan: artifact write refused")
  }
}

func spark_serving_apply_wet(host: String) -> ProcessExit
  uses net: Network
{
  let read_body = Filesystem.Read(path: spark_serving_plan_body_path)
  let read_hash = Filesystem.Read(path: spark_serving_plan_hash_path)
  let read_host = Filesystem.Read(path: spark_serving_plan_host_path)
  if read_body.success == false || read_hash.success == false || read_host.success == false {
    exit_failure(reason: "spark_serving_apply: plan artifact missing — run plan first")
  } else {
    if read_host.content != host {
      exit_failure(reason: "spark_serving_apply: planned host does not match apply subject")
    } else {
      match spark_serving_plan_hash_from_hex(text: read_hash.content) {
        Absent =>
          exit_failure(reason: "spark_serving_apply: recorded plan hash unreadable — refuse")
        Present { value: recorded } =>
          if spark_serving_plan_bundle_matches(plan_body: read_body.content, recorded_hash: recorded) == false {
            exit_failure(reason: "spark_serving_apply: plan body drifted from recorded hash — refuse")
          } else {
            match fleet_ssh_attempt_raw_from_env() {
              Absent =>
                exit_failure(
                  reason: "spark_serving_apply: GUNBC_FLEET_SSH_ATTEMPT_RAW or GitHub env required",
                )
              Present { value: attempt_raw } =>
                spark_serving_provision_apply_for_host(attempt_raw: attempt_raw, host: host)
            }
          }
      }
    }
  }
}

func spark_serving_plan_apply_srv5() -> ProcessExit
  uses net: Network
{
  match spark_serving_plan_wet(host: operator_host_srv5 as String) {
    ExitSuccess => spark_serving_apply_wet(host: operator_host_srv5 as String)
    ExitFailure { code: _, reason: why } => exit_failure(reason: why)
  }
}

func spark_serving_plan_apply_srv6() -> ProcessExit
  uses net: Network
{
  match spark_serving_plan_wet(host: operator_host_srv6 as String) {
    ExitSuccess => spark_serving_apply_wet(host: operator_host_srv6 as String)
    ExitFailure { code: _, reason: why } => exit_failure(reason: why)
  }
}
