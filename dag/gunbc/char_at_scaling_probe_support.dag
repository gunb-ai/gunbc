module gunbc.char_at_scaling_probe_support

import std.disposition { Disposition, Terminal }

// Per DESIGN §4b: this probe IS the discriminating evidence for CHARAT-0's O(1)
// char_at claim, so it stays enrolled rather than dissolving — the disposition is
// Terminal, not Scaffold, and carries no DissolutionCondition: a Terminal thing
// does not dissolve by definition, and a free-standing dissolution row beside it
// would be a second, contradictory representation of the same fact (§3). If
// char_at's O(1) property later becomes structurally guaranteed, this probe's
// role transitions to a permanent regression control (§4b dissolution-on-climb)
// rather than retiring — evidence for a surviving claim is never deleted.
data char_at_scaling_probe_disposition: Disposition = Terminal {
  reason: "the entry point `src/v1/stage0/src/bin/char_at_scaling_probe.rs` resolves against — a single `char_at` call, isolated from every other primitive, so per-access cost can be fit against position and against string length without the JSON parser's independent list-materialization cost. NOT floor-enrolled; the acceptance evidence for CHARAT-0's O(1) claim."
}

fn char_at_probe(s: String, pos: Int) -> String {
  char_at(s: s, pos: pos)
}
