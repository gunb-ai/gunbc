module gunbc.review_sheet_sheets

import std.disposition { Disposition, Scaffold, RealizationDispatch }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import std.upsert_decision { UpsertDecision, Noop, Apply, Refuse }
import gunbc.ensure {
  EnsurePolicy,
  EnsureObserved,
  EnsurePlan,
  EnsurePlanAvailable,
  EnsurePlanUnavailable,
  ensure_decide,
}
import gunbc.review_sheet_projection {
  ObservedSheet,
  ObservedSheetRow,
  ReviewSheetProjection,
  ReviewSheetWritePlan,
  ReviewSheetClassification,
  ReviewSheetConverged,
  ReviewSheetNeedsWrite,
  ReviewSheetConflict,
  ReviewSheetUnreadable,
  DerivedCellWrite,
  AppendListingRow,
  append_row_a1,
  classify_review_sheet,
  conflict_reason,
  decide_review_sheet,
}
import extdeps.google.sheets {
  ValueRange,
  SheetsValueInputOption,
  InputUserEntered,
  sheets_major_dimension_wire,
  DimensionRows,
}
import extdeps.cloud.gcp.gcp { GcpOAuth2AccessTokenStrategy, AdcRefresh }
import extdeps.cloud.gcp.secret_ref { SecretRef }
import gunbc.review_sheet_operator {
  fleet_review_sheet_operator_admission,
  ReviewSheetOperatorAdmission,
  ReviewSheetOperatorAdmitted,
  ReviewSheetAwaitingHuman,
  ReviewSheetNeedsApiEnable,
  ReviewSheetEstateUnresolved,
  ReviewSheetOperatorRefused,
}

// ONE realization of the review-sheet projection: Google Sheets values.get as independent
// readback, values.batchUpdate only for the derived write plan. Auth is ADC / a SecretRef under
// gunbc.secret_provision; this module does not mint a credential type.

type SheetsAccess {
  spreadsheet_id: NonEmptyStr
  credential: SecretRef
  token_strategy: GcpOAuth2AccessTokenStrategy
}

fn sheets_access(spreadsheet_id: NonEmptyStr, credential: SecretRef) -> SheetsAccess {
  SheetsAccess {
    spreadsheet_id: spreadsheet_id,
    credential: credential,
    token_strategy: AdcRefresh { adc_path: none },
  }
}

type ReviewSheetLiveAccess
  = ReviewSheetLiveOpen { access: SheetsAccess }
  | ReviewSheetLiveNotAdmitted { admission: ReviewSheetOperatorAdmission }

fn review_sheet_live_access_from(
  admission: ReviewSheetOperatorAdmission,
  credential: SecretRef,
) -> ReviewSheetLiveAccess {
  match admission {
    ReviewSheetOperatorAdmitted { spreadsheet_id: id } =>
      ReviewSheetLiveOpen { access: sheets_access(spreadsheet_id: id, credential: credential) }
    ReviewSheetAwaitingHuman { intervention: i } =>
      ReviewSheetLiveNotAdmitted { admission: ReviewSheetAwaitingHuman { intervention: i } }
    ReviewSheetNeedsApiEnable { plan: p } =>
      ReviewSheetLiveNotAdmitted { admission: ReviewSheetNeedsApiEnable { plan: p } }
    ReviewSheetEstateUnresolved { subject: s, reason: r } =>
      ReviewSheetLiveNotAdmitted {
        admission: ReviewSheetEstateUnresolved { subject: s, reason: r },
      }
    ReviewSheetOperatorRefused { reason: r } =>
      ReviewSheetLiveNotAdmitted { admission: ReviewSheetOperatorRefused { reason: r } }
  }
}

fn review_sheet_live_access(credential: SecretRef) -> ReviewSheetLiveAccess {
  review_sheet_live_access_from(
    admission: fleet_review_sheet_operator_admission(),
    credential: credential,
  )
}

fn review_sheet_batch_value_input_option() -> SheetsValueInputOption {
  InputUserEntered
}

fn sheet_qualified_a1(tab: NonEmptyStr, a1: NonEmptyStr) -> NonEmptyStr {
  concat(tab as String, concat("!", a1 as String)) as NonEmptyStr
}

type A1ReadbackStanding
  = A1ReadbackAnchored { tab: NonEmptyStr }
  | A1ReadbackUnreadable { reason: NonEmptyStr }

fn a1_start_cell(cells: String) -> String {
  match cells.split(delimiter: ":") |> first {
    Present { value: start } => start
    Absent => cells
  }
}

fn a1_readback_standing(range: String) -> A1ReadbackStanding {
  let parts = range.split(delimiter: "!")
  if (parts |> count) != 2 {
    A1ReadbackUnreadable {
      reason: concat("unqualified A1 range; BatchUpdate would hit the first tab: ", range) as NonEmptyStr
    }
  } else {
    match parts.first() {
      Absent =>
        A1ReadbackUnreadable { reason: "A1 range missing sheet title" as NonEmptyStr }
      Present { value: tab } =>
        if (tab == "") || string_contains(s: tab, pattern: "'") {
          A1ReadbackUnreadable {
            reason: concat("A1 sheet title unreadable: ", tab) as NonEmptyStr
          }
        } else {
          match parts.skip(n: 1).first() {
            Absent =>
              A1ReadbackUnreadable { reason: "A1 range missing cell address" as NonEmptyStr }
            Present { value: cells } =>
              if a1_start_cell(cells: cells) == "A1" {
                A1ReadbackAnchored { tab: tab as NonEmptyStr }
              } else {
                A1ReadbackUnreadable {
                  reason: concat(
                    "readback not A1-anchored; write A1 would not match the compared cells: ",
                    range,
                  ) as NonEmptyStr
                }
              }
          }
        }
    }
  }
}

fn value_range_from_derived_write(write: DerivedCellWrite, tab: NonEmptyStr) -> ValueRange {
  ValueRange {
    range: sheet_qualified_a1(tab: tab, a1: write.a1) as String,
    majorDimension: Present { value: sheets_major_dimension_wire(d: DimensionRows) },
    values: Present { value: [[write.value]] },
  }
}

fn value_range_from_append(row: AppendListingRow, tab: NonEmptyStr) -> ValueRange? {
  match append_row_a1(row: row) {
    Absent => none
    Present { value: a1 } =>
      Present {
        value: ValueRange {
          range: sheet_qualified_a1(tab: tab, a1: a1) as String,
          majorDimension: Present { value: sheets_major_dimension_wire(d: DimensionRows) },
          values: Present { value: [row.cells] },
        }
      }
  }
}

fn value_ranges_from_write_plan(plan: ReviewSheetWritePlan, tab: NonEmptyStr) -> List<ValueRange> {
  concat(
    map(plan.patches, w => value_range_from_derived_write(write: w, tab: tab)),
    fold(plan.appends, init: [], f: fn(acc, row) {
      match value_range_from_append(row: row, tab: tab) {
        Absent => acc
        Present { value: vr } => concat(acc, [vr])
      }
    }),
  )
}

type ObservedSheetFromReadback
  = ReadbackObserved { observed: ObservedSheet, tab: NonEmptyStr }
  | ReadbackUnreadable { reason: NonEmptyStr }

fn observed_data_rows(rows: List<List<String>>) -> List<ObservedSheetRow> {
  rows |> enumerate |> filter(pair => pair.first > 0) |> map(pair => ObservedSheetRow {
    data_index: pair.first - 1,
    cells: pair.second,
  })
}

fn grid_from_value_rows(values: List<List<String>>?) -> ObservedSheet {
  match values {
    Absent => ObservedSheet { headers: [], rows: [] }
    Present { value: rows } =>
      match rows |> first {
        Absent => ObservedSheet { headers: [], rows: [] }
        Present { value: headers } => ObservedSheet {
          headers: headers,
          rows: observed_data_rows(rows: rows),
        }
      }
  }
}

fn observed_sheet_from_value_range(range: ValueRange) -> ObservedSheetFromReadback {
  match a1_readback_standing(range: range.range) {
    A1ReadbackUnreadable { reason: r } => ReadbackUnreadable { reason: r }
    A1ReadbackAnchored { tab: tab } =>
      ReadbackObserved { observed: grid_from_value_rows(values: range.values), tab: tab }
  }
}

fn review_sheet_from_readback(
  range: ValueRange,
  projection: ReviewSheetProjection,
) -> UpsertDecision<ReviewSheetWritePlan> {
  match observed_sheet_from_value_range(range: range) {
    ReadbackUnreadable { reason: r } => Refuse { reason: r }
    ReadbackObserved { observed: observed, tab: _ } =>
      decide_review_sheet(observed: observed, projection: projection)
  }
}

fn review_sheet_ensure_plan(classified: ReviewSheetClassification) -> EnsurePlan<ReviewSheetWritePlan> {
  match classified {
    ReviewSheetConverged => EnsurePlanUnavailable { reason: "already converged" }
    ReviewSheetNeedsWrite { plan: p } => EnsurePlanAvailable { plan: p }
    ReviewSheetConflict { conflict: c } => EnsurePlanUnavailable { reason: conflict_reason(conflict: c) as String }
    ReviewSheetUnreadable { reason: r } => EnsurePlanUnavailable { reason: r as String }
  }
}

fn review_sheet_ensure(
  policy: EnsurePolicy,
  range: ValueRange,
  projection: ReviewSheetProjection,
) -> UpsertDecision<ReviewSheetWritePlan> {
  match observed_sheet_from_value_range(range: range) {
    ReadbackUnreadable { reason: r } => Refuse { reason: r }
    ReadbackObserved { observed: observed, tab: _ } => {
      let classified = classify_review_sheet(observed: observed, projection: projection)
      ensure_decide(
        policy: policy,
        observation: EnsureObserved { evidence: observed },
        observation_satisfies: match classified {
          ReviewSheetConverged => true
          ReviewSheetNeedsWrite { plan: _ } => false
          ReviewSheetConflict { conflict: _ } => false
          ReviewSheetUnreadable { reason: _ } => false
        },
        mismatch_reason: match classified {
          ReviewSheetConverged => "derived region already equals the projection"
          ReviewSheetNeedsWrite { plan: _ } => "derived region differs from the projection"
          ReviewSheetConflict { conflict: c } => conflict_reason(conflict: c) as String
          ReviewSheetUnreadable { reason: r } => r as String
        },
        plan: review_sheet_ensure_plan(classified: classified),
      )
    }
  }
}

// sunny-carp-475 binds a live sheets.Spreadsheets GetValues and BatchUpdateValues adapter onto
// review_sheet_from_readback. Until that lands this is owed work, not a terminal.
data live_sheets_transport_frontier: Disposition = Scaffold {
  dissolves_to: RealizationDispatch,
  bind: DeclarationRef {
    module_path: "gunbc.review_sheet_sheets",
    decl_name: "review_sheet_from_readback",
    field: WholeDeclaration
  }
}
