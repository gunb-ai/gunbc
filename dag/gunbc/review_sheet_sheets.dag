// ONE realization of the review-sheet projection: Google Sheets values.get as independent
// readback, values.batchUpdate only for the derived write plan. Auth is ADC / a SecretRef under
// gunbc.secret_provision; this module does not mint a credential type.

type SheetsAccess {
  spreadsheet_id: NonEmptyStr
  credential: SecretRef
  token_strategy: GcpOAuth2AccessTokenStrategy
}

fn sheets_access(spreadsheet_id: NonEmptyStr, credential: SecretRef) -> SheetsAccess {
  SheetsAccess {
    spreadsheet_id: spreadsheet_id,
    credential: credential,
    token_strategy: AdcRefresh { adc_path: none },
  }
}

type ReviewSheetLiveAccess
  = ReviewSheetLiveOpen { access: SheetsAccess }
  | ReviewSheetLiveNotAdmitted { admission: ReviewSheetOperatorAdmission }

fn review_sheet_live_access_from(
  admission: ReviewSheetOperatorAdmission,
  credential: SecretRef,
) -> ReviewSheetLiveAccess {
  match admission {
    ReviewSheetOperatorAdmitted { spreadsheet_id: id } =>
      ReviewSheetLiveOpen { access: sheets_access(spreadsheet_id: id, credential: credential) }
    ReviewSheetAwaitingHuman { intervention: i } =>
      ReviewSheetLiveNotAdmitted { admission: ReviewSheetAwaitingHuman { intervention: i } }
    ReviewSheetNeedsApiEnable { plan: p } =>
      ReviewSheetLiveNotAdmitted { admission: ReviewSheetNeedsApiEnable { plan: p } }
    ReviewSheetEstateUnresolved { subject: s, reason: r } =>
      ReviewSheetLiveNotAdmitted {
        admission: ReviewSheetEstateUnresolved { subject: s, reason: r },
      }
    ReviewSheetOperatorRefused { reason: r } =>
      ReviewSheetLiveNotAdmitted { admission: ReviewSheetOperatorRefused { reason: r } }
  }
}

fn review_sheet_live_access(credential: SecretRef) -> ReviewSheetLiveAccess {
  review_sheet_live_access_from(
    admission: fleet_review_sheet_operator_admission(),
    credential: credential,
  )
}

// USER_ENTERED parses derived strings ("1/2", leading =/+/-) into dates, numbers, or formulas,
// so GetValues FORMATTED_VALUE readback is not the string this lane wrote and the next converge
// CellConflicts on its own output. RAW stores the projection string as a string.
fn review_sheet_batch_value_input_option() -> SheetsValueInputOption {
  InputRaw
}

// Pair with RAW writes: ValueRange.values is List<List<String>>, and UNFORMATTED_VALUE can
// return JSON numbers (structural_coverage_gap_value_range_cell_types). FORMATTED_VALUE
// is the cited default and keeps cells as strings, inverse of RAW for this model.
fn review_sheet_get_value_render_option() -> SheetsValueRenderOption {
  RenderFormattedValue
}

type SheetA1End
  = A1EndOpen { column: A1Column }
  | A1EndClosed { cell: A1Cell }
  | A1EndWholeTab

type SheetA1Range {
  tab: NonEmptyStr
  origin: A1Cell
  end: SheetA1End
}

fn sheet_a1_range_wire(range: SheetA1Range) -> String {
  match range.end {
    A1EndWholeTab => range.tab as String
    A1EndOpen { column: c } =>
      concat(
        range.tab as String,
        concat("!", concat(a1_cell_wire(cell: range.origin), concat(":", c.letter as String))),
      )
    A1EndClosed { cell: c } =>
      concat(
        range.tab as String,
        concat("!", concat(a1_cell_wire(cell: range.origin), concat(":", a1_cell_wire(cell: c)))),
      )
  }
}

fn sheet_qualified_cell(tab: NonEmptyStr, cell: A1Cell) -> String {
  concat(tab as String, concat("!", a1_cell_wire(cell: cell)))
}

fn sheet_qualified_span(tab: NonEmptyStr, span: A1RowSpan) -> String {
  concat(tab as String, concat("!", a1_row_span_wire(span: span)))
}

type A1ReadbackStanding
  = A1ReadbackAnchored { range: SheetA1Range }
  | A1ReadbackUnreadable { reason: NonEmptyStr }

fn review_sheet_get_values_request(tab: NonEmptyStr) -> SheetA1Range {
  SheetA1Range {
    tab: tab,
    origin: a1_origin_cell(),
    end: A1EndWholeTab,
  }
}

fn a1_readback_standing(range: String) -> A1ReadbackStanding {
  let parts = range.split(delimiter: "!")
  if (parts |> count) != 2 {
    A1ReadbackUnreadable {
      reason: concat("unqualified A1 range; BatchUpdate would hit the first tab: ", range) as NonEmptyStr
    }
  } else {
    match parts.first() {
      Absent =>
        A1ReadbackUnreadable { reason: "A1 range missing sheet title" as NonEmptyStr }
      Present { value: tab } =>
        if (tab == "") || string_contains(s: tab, pattern: "'") {
          A1ReadbackUnreadable {
            reason: concat("A1 sheet title unreadable: ", tab) as NonEmptyStr
          }
        } else {
          match parts.skip(n: 1).first() {
            Absent =>
              A1ReadbackUnreadable { reason: "A1 range missing cell address" as NonEmptyStr }
            Present { value: cells } => {
              let segs = cells.split(delimiter: ":")
              if (segs |> count) != 2 {
                A1ReadbackUnreadable {
                  reason: concat("A1 range is not start:end: ", range) as NonEmptyStr
                }
              } else {
                match segs.first() {
                  Absent =>
                    A1ReadbackUnreadable { reason: "A1 range missing cell address" as NonEmptyStr }
                  Present { value: start_tok } =>
                    match segs.skip(n: 1).first() {
                      Absent =>
                        A1ReadbackUnreadable { reason: "A1 range missing cell address" as NonEmptyStr }
                      Present { value: end_tok } =>
                        match a1_from_wire(token: start_tok) {
                          A1WireUnreadable { reason: r } => A1ReadbackUnreadable { reason: r }
                          A1WireOpenColumn { column: _ } =>
                            A1ReadbackUnreadable {
                              reason: concat(
                                "readback not A1-anchored; write A1 would not match the compared cells: ",
                                range,
                              ) as NonEmptyStr
                            }
                          A1WireCell { cell: origin } =>
                            if a1_cell_eq(a: origin, b: a1_origin_cell()) {
                              match a1_from_wire(token: end_tok) {
                                A1WireUnreadable { reason: r } => A1ReadbackUnreadable { reason: r }
                                A1WireOpenColumn { column: c } =>
                                  A1ReadbackAnchored {
                                    range: SheetA1Range {
                                      tab: tab as NonEmptyStr,
                                      origin: origin,
                                      end: A1EndOpen { column: c },
                                    }
                                  }
                                A1WireCell { cell: end } =>
                                  A1ReadbackAnchored {
                                    range: SheetA1Range {
                                      tab: tab as NonEmptyStr,
                                      origin: origin,
                                      end: A1EndClosed { cell: end },
                                    }
                                  }
                              }
                            } else {
                              A1ReadbackUnreadable {
                                reason: concat(
                                  "readback not A1-anchored; write A1 would not match the compared cells: ",
                                  range,
                                ) as NonEmptyStr
                              }
                            }
                        }
                    }
                }
              }
            }
          }
        }
    }
  }
}

// THE WRITE LOWERING IS BELOW, after TabBoundWritePlan. This position used to hold
// value_range_from_derived_write and value_ranges_from_append, which built the READ shape
// (ValueRange, Optional-wrapped values) and were never sent: extdeps.google.sheets ValueRangeWrite
// records why the Optional form is refused on the wire.

fn value_range_includes_column_letter(range: String, letter: String) -> Bool {
  match split(s: range, delimiter: "!") |> skip(n: 1) |> first {
    Absent => false
    Present { value: span_wire } =>
      match split(s: span_wire, delimiter: ":") |> first {
        Absent => false
        Present { value: start_wire } =>
          match a1_from_wire(token: start_wire) {
            A1WireOpenColumn { column: _ } => false
            A1WireUnreadable { reason: _ } => false
            A1WireCell { cell: start } =>
              match split(s: span_wire, delimiter: ":") |> skip(n: 1) |> first {
                Absent => (start.column.letter as String) == letter
                Present { value: end_wire } =>
                  match a1_from_wire(token: end_wire) {
                    A1WireOpenColumn { column: _ } => false
                    A1WireUnreadable { reason: _ } => false
                    A1WireCell { cell: end } =>
                      a1_row_span_includes_letter(
                        span: A1RowSpan { start: start, end: end },
                        letter: letter,
                      )
                  }
              }
          }
      }
  }
}

type TabBoundWritePlan {
  tab: NonEmptyStr
  plan: ReviewSheetWritePlan
}

// ONE LOWERING, TOTAL AND TYPED. A TabBoundWritePlan carries derived-cell patches and append runs
// in the projection's vocabulary (A1Cell, A1RowSpan, cells); Sheets values.batchUpdate takes
// ValueRangeWrite, whose wire fields are non-optional. This fold is the only place that crossing
// happens, and it either lowers EVERY range of the plan or refuses with every defect it found. It
// never drops a range: the identity join the witness asserts -- each plan element appears exactly
// once among the lowered ranges -- is a property of this fold and not of any caller.
//
// WHAT IS UNLOWERABLE, AND WHY EACH IS A REFUSAL RATHER THAN A REPAIR. An append run whose cell
// count does not equal its span width would write cells past, or short of, the frontier the
// classification chose; a run whose span is not one row, or not on the listing's sheet_row, was
// not produced by the projection fold (a1_row_span_cols builds one row on sheet_row) and so is a
// hand-authored plan; a span letter outside a1_column_letters has no width; a patch or run at a
// row below 1, or a patch at a column letter outside a1_column_letters, names no cell Sheets has
// (A0 and AA are refused on the wire, and refusing here keeps the refusal typed and before any
// request exists); a tab title carrying
// an apostrophe cannot be spelled in the A1 form this module qualifies with (a1_readback_standing
// refuses the same title on the read side, so the write side may not accept it); and a plan with
// nothing in it would issue a zero-range batch that Sheets answers 200 to, which is a success
// report over a write that never happened. Each of these refuses; none is widened into a guess.
type WritePlanLowering
  = WritePlanLowered { ranges: List<ValueRangeWrite> }
  | WritePlanUnlowerable { refusals: List<WritePlanRefusal> }

type PatchDefect
  = PatchColumnUnreadable
  | PatchRowBelowOrigin

type AppendRunDefect
  = AppendRunRowBelowOrigin
  | AppendRunSpanNotOneRow
  | AppendRunOffListingRow { sheet_row: Int }
  | AppendRunSpanColumnUnreadable
  | AppendRunWidthMismatch { cell_count: Int, span_width: Int }

type WritePlanRefusal
  = EmptyWritePlan
  | TabTitleUnquotable { tab: NonEmptyStr }
  | PatchMalformed { listing_id: NonEmptyStr, a1: A1Cell, defect: PatchDefect }
  | AppendRunMalformed { listing_id: NonEmptyStr, span: A1RowSpan, defect: AppendRunDefect }

type LoweringAcc {
  ranges: List<ValueRangeWrite>
  refusals: List<WritePlanRefusal>
}

fn patch_value_range_write(write: DerivedCellWrite, tab: NonEmptyStr) -> ValueRangeWrite {
  ValueRangeWrite {
    range: sheet_qualified_cell(tab: tab, cell: write.a1),
    majorDimension: sheets_major_dimension_wire(d: DimensionRows),
    values: [[write.value]],
  }
}

fn patch_defect(write: DerivedCellWrite) -> PatchDefect? {
  if write.a1.row < 1 {
    Present { value: PatchRowBelowOrigin }
  } else {
    match a1_letter_index(letter: write.a1.column.letter as String) {
      Absent => Present { value: PatchColumnUnreadable }
      Present { value: _ } => none
    }
  }
}

fn lower_patch(acc: LoweringAcc, write: DerivedCellWrite, tab: NonEmptyStr) -> LoweringAcc {
  match patch_defect(write: write) {
    Present { value: defect } =>
      LoweringAcc {
        ranges: acc.ranges,
        refusals: concat(acc.refusals, [PatchMalformed { listing_id: write.listing_id, a1: write.a1, defect: defect }]),
      }
    Absent =>
      LoweringAcc { ranges: concat(acc.ranges, [patch_value_range_write(write: write, tab: tab)]), refusals: acc.refusals }
  }
}

fn append_run_span_width(span: A1RowSpan) -> Int? {
  match a1_letter_index(letter: span.start.column.letter as String) {
    Absent => none
    Present { value: start_i } =>
      match a1_letter_index(letter: span.end.column.letter as String) {
        Absent => none
        Present { value: end_i } => Present { value: end_i - start_i + 1 }
      }
  }
}

fn append_run_defect(run: AppendCellRun, sheet_row: Int) -> AppendRunDefect? {
  if sheet_row < 1 || run.a1.start.row < 1 || run.a1.end.row < 1 {
    Present { value: AppendRunRowBelowOrigin }
  } else if run.a1.start.row != run.a1.end.row {
    Present { value: AppendRunSpanNotOneRow }
  } else if run.a1.start.row != sheet_row {
    Present { value: AppendRunOffListingRow { sheet_row: sheet_row } }
  } else {
    match append_run_span_width(span: run.a1) {
      Absent => Present { value: AppendRunSpanColumnUnreadable }
      Present { value: width } =>
        if width != count(run.cells) {
          Present { value: AppendRunWidthMismatch { cell_count: count(run.cells), span_width: width } }
        } else {
          none
        }
    }
  }
}

fn lower_append_run(acc: LoweringAcc, row: AppendListingRow, run: AppendCellRun, tab: NonEmptyStr) -> LoweringAcc {
  match append_run_defect(run: run, sheet_row: row.sheet_row) {
    Present { value: defect } =>
      LoweringAcc {
        ranges: acc.ranges,
        refusals: concat(acc.refusals, [AppendRunMalformed { listing_id: row.listing_id, span: run.a1, defect: defect }]),
      }
    Absent =>
      LoweringAcc {
        ranges: concat(acc.ranges, [ValueRangeWrite {
          range: sheet_qualified_span(tab: tab, span: run.a1),
          majorDimension: sheets_major_dimension_wire(d: DimensionRows),
          values: [run.cells],
        }]),
        refusals: acc.refusals,
      }
  }
}

fn lower_append_row(acc: LoweringAcc, row: AppendListingRow, tab: NonEmptyStr) -> LoweringAcc {
  fold(row.runs, init: acc, f: fn(inner, run) { lower_append_run(acc: inner, row: row, run: run, tab: tab) })
}

fn lower_write_plan(bound: TabBoundWritePlan) -> WritePlanLowering {
  let start = LoweringAcc {
    ranges: [],
    refusals: if string_contains(s: bound.tab as String, pattern: "'") {
      [TabTitleUnquotable { tab: bound.tab }]
    } else {
      []
    },
  }
  let patched = fold(bound.plan.patches, init: start, f: fn(acc, w) { lower_patch(acc: acc, write: w, tab: bound.tab) })
  let lowered = fold(bound.plan.appends, init: patched, f: fn(acc, row) {
    lower_append_row(acc: acc, row: row, tab: bound.tab)
  })
  let refusals = if count(lowered.ranges) == 0 && count(lowered.refusals) == 0 {
    [EmptyWritePlan]
  } else {
    lowered.refusals
  }
  if count(refusals) == 0 {
    WritePlanLowered { ranges: lowered.ranges }
  } else {
    WritePlanUnlowerable { refusals: refusals }
  }
}

fn write_plan_refusal_text(refusal: WritePlanRefusal) -> String {
  match refusal {
    EmptyWritePlan => "the write plan carries no patch and no append run, so there is nothing to send"
    TabTitleUnquotable { tab: t } =>
      concat("the tab title carries an apostrophe and cannot be spelled as an A1 qualifier: ", t as String)
    PatchMalformed { listing_id: id, a1: c, defect: d } =>
      concat(
        concat("patch for listing ", concat(id as String, concat(" at ", a1_cell_wire(cell: c)))),
        match d {
          PatchColumnUnreadable => " names a column letter outside the modeled A1 columns"
          PatchRowBelowOrigin => " names a row below 1"
        },
      )
    AppendRunMalformed { listing_id: id, span: s, defect: d } =>
      concat(
        concat("append run for listing ", concat(id as String, concat(" at ", a1_row_span_wire(span: s)))),
        match d {
          AppendRunRowBelowOrigin => " names a row below 1"
          AppendRunSpanNotOneRow => " spans more than one row"
          AppendRunOffListingRow { sheet_row: r } => concat(" is not on the listing's sheet row ", to_string(r))
          AppendRunSpanColumnUnreadable => " names a column letter outside the modeled A1 columns"
          AppendRunWidthMismatch { cell_count: c, span_width: w } =>
            concat(" carries ", concat(to_string(c), concat(" cells for a span ", concat(to_string(w), " wide"))))
        },
      )
  }
}

type ObservedSheetFromReadback
  = ReadbackObserved { observed: ObservedSheet, tab: NonEmptyStr }
  | ReadbackUnreadable { reason: NonEmptyStr }

fn observed_data_rows(rows: List<List<String>>) -> List<ObservedSheetRow> {
  rows |> enumerate |> filter(pair => pair.first > 0) |> map(pair => ObservedSheetRow {
    data_index: pair.first - 1,
    cells: pair.second,
  })
}

fn grid_from_value_rows(values: List<List<String>>?) -> ObservedSheet {
  match values {
    Absent => ObservedSheet { headers: [], rows: [] }
    Present { value: rows } =>
      match rows |> first {
        Absent => ObservedSheet { headers: [], rows: [] }
        Present { value: headers } => ObservedSheet {
          headers: headers,
          rows: observed_data_rows(rows: rows),
        }
      }
  }
}

fn observed_sheet_from_value_range(range: ValueRange) -> ObservedSheetFromReadback {
  match range.majorDimension {
    Absent =>
      observed_sheet_from_row_major_range(range: range)
    Present { value: raw } =>
      match sheets_major_dimension_from_wire(raw: raw) {
        Absent =>
          ReadbackUnreadable {
            reason: concat("foreign majorDimension: ", raw) as NonEmptyStr
          }
        Present { value: DimensionColumns } =>
          ReadbackUnreadable {
            reason: "column-major ValueRange is not a row-grid readback" as NonEmptyStr
          }
        Present { value: DimensionRows } =>
          observed_sheet_from_row_major_range(range: range)
      }
  }
}

fn observed_sheet_from_row_major_range(range: ValueRange) -> ObservedSheetFromReadback {
  match a1_readback_standing(range: range.range) {
    A1ReadbackUnreadable { reason: r } => ReadbackUnreadable { reason: r }
    A1ReadbackAnchored { range: parsed } =>
      ReadbackObserved { observed: grid_from_value_rows(values: range.values), tab: parsed.tab }
  }
}

fn review_sheet_ensure_plan(
  classified: ReviewSheetClassification,
  tab: NonEmptyStr,
) -> EnsurePlan<TabBoundWritePlan> {
  match classified {
    ReviewSheetConverged => EnsurePlanUnavailable { reason: "already converged" }
    ReviewSheetNeedsWrite { plan: p } =>
      EnsurePlanAvailable { plan: TabBoundWritePlan { tab: tab, plan: p } }
    ReviewSheetConflict { conflict: c } =>
      EnsurePlanUnavailable { reason: conflict_reason(conflict: c) as String }
    ReviewSheetUnreadable { reason: r } => EnsurePlanUnavailable { reason: r as String }
  }
}

// THE TYPED AUTHORITY STOPS BEFORE POLICY, AND THAT BOUNDARY IS THE WHOLE POINT. An earlier shape
// of this split returned EnsureDecided { decision: UpsertDecision<..> } beside a typed refusal sum,
// which is wrong in a way that is easy to miss: UpsertDecision carries its OWN Refuse arm, whose
// payload is prose, so a policy refusal -- a NeedsWrite under EnsureObserveOnly, an inaccessible
// observation, an unavailable plan -- would have travelled back OUTSIDE the typed sum. That is two
// representations of refusal again, and a typed consumer would still have to know which outer arm
// might secretly contain another one. So the assessment ends where policy begins: everything here
// is a fact about the REQUEST and the OBSERVATION, and nothing here has consulted EnsurePolicy.
//
// Readback causes are still carried as their rendered reason. Typing them is the next part of this
// refactor, not an omission: the arm exists so that work changes one constructor rather than this
// module's shape.
type ReviewSheetEnsureAssessment
  = ReviewSheetRequestRejected { cause: SheetRequestCause }
  | ReviewSheetReadbackRejected { reason: NonEmptyStr }
  | ReviewSheetProjectionClassified {
      observed: ObservedSheet
      tab: NonEmptyStr
      classification: ReviewSheetClassification
    }

// THE REQUEST-SHAPE WALLS, TYPED. These two refuse BEFORE anything is read, because an append past
// unobserved rows or columns is a data-loss risk and not a fact about any projection. They carry
// the range they refused so a consumer can say which request was rejected without re-deriving it.
type SheetRequestCause
  = BoundedRequest { range: SheetA1Range }
  | ColumnBoundedRequest { range: SheetA1Range }

fn sheet_request_cause_text(cause: SheetRequestCause) -> String {
  match cause {
    BoundedRequest { range: r } =>
      concat("bounded GetValues request; append would write past unobserved rows: ", sheet_a1_range_wire(range: r))
    ColumnBoundedRequest { range: r } =>
      concat("column-bounded GetValues request; append would write past unobserved columns: ", sheet_a1_range_wire(range: r))
  }
}

fn review_sheet_ensure_assess(
  requested: SheetA1Range,
  range: ValueRange,
  projection: ReviewSheetProjection,
  erasures: List<DerivedPayloadErasure>,
) -> ReviewSheetEnsureAssessment {
  match requested.end {
    A1EndClosed { cell: _ } =>
      ReviewSheetRequestRejected { cause: BoundedRequest { range: requested } }
    A1EndOpen { column: _ } =>
      ReviewSheetRequestRejected { cause: ColumnBoundedRequest { range: requested } }
    A1EndWholeTab =>
      match observed_sheet_from_value_range(range: range) {
        ReadbackUnreadable { reason: r } => ReviewSheetReadbackRejected { reason: r }
        ReadbackObserved { observed: observed, tab: tab } =>
          if (tab as String) != (requested.tab as String) {
            ReviewSheetReadbackRejected {
              reason: concat(
                "readback tab ",
                concat(tab as String, concat(" is not the requested tab ", requested.tab as String)),
              ) as NonEmptyStr
            }
          } else {
            ReviewSheetProjectionClassified {
              observed: observed,
              tab: tab,
              classification: classify_review_sheet(
                observed: observed,
                projection: projection,
                erasures: erasures,
              ),
            }
          }
      }
  }
}

fn review_sheet_ensure_decide(
  policy: EnsurePolicy,
  assessment: ReviewSheetEnsureAssessment,
) -> UpsertDecision<TabBoundWritePlan> {
  match assessment {
    ReviewSheetRequestRejected { cause: c } =>
      Refuse { reason: sheet_request_cause_text(cause: c) as NonEmptyStr }
    ReviewSheetReadbackRejected { reason: r } => Refuse { reason: r }
    ReviewSheetProjectionClassified { observed: observed, tab: tab, classification: classified } =>
      ensure_decide(
        policy: policy,
        observation: EnsureObserved { evidence: observed },
        observation_satisfies: match classified {
          ReviewSheetConverged => true
          ReviewSheetNeedsWrite { plan: _ } => false
          ReviewSheetConflict { conflict: _ } => false
          ReviewSheetUnreadable { reason: _ } => false
        },
        mismatch_reason: match classified {
          ReviewSheetConverged => "derived region already equals the projection"
          ReviewSheetNeedsWrite { plan: _ } => "derived region differs from the projection"
          ReviewSheetConflict { conflict: c } => conflict_reason(conflict: c) as String
          ReviewSheetUnreadable { reason: r } => r as String
        },
        plan: review_sheet_ensure_plan(classified: classified, tab: tab),
      )
  }
}

fn review_sheet_ensure(
  policy: EnsurePolicy,
  requested: SheetA1Range,
  range: ValueRange,
  projection: ReviewSheetProjection,
  erasures: List<DerivedPayloadErasure>,
) -> UpsertDecision<TabBoundWritePlan> {
  review_sheet_ensure_decide(
    policy: policy,
    assessment: review_sheet_ensure_assess(
      requested: requested,
      range: range,
      projection: projection,
      erasures: erasures,
    ),
  )
}

// sunny-carp-475 binds a live sheets.Spreadsheets GetValues and BatchUpdateValues adapter onto
// review_sheet_ensure (policy is the caller's EnsurePolicy, never a literal in this module).
// review_sheet_ensure takes caller-supplied DerivedPayloadErasure rows; empty means no erasure
// this pass. That same adapter is the named later consumer of sheets_spreadsheets_oauth_scope
// (writes) and sheets_spreadsheets_readonly_oauth_scope (get-only). sheets_api_base is already
// the service endpoint. Quota numbers are enrolled via sheets_rate_limits, not a citation grep.
data live_sheets_transport_frontier: Disposition = Scaffold {
  dissolves_to: RealizationDispatch,
  bind: DeclarationRef {
    module_path: "gunbc.review_sheet_sheets",
    decl_name: "review_sheet_ensure",
    field: WholeDeclaration
  }
}
