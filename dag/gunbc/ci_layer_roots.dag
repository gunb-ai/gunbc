data witness_layer_roots: List<String> = ["dag", "src/v2"]

data frontier_probe_witness_measure_receipt_note: String = "Measured durations cited on commit_gate SpanEnrolled cost_basis rows are WallClock: claim_batch performance receipts use wall_nanos (performance_receipt_from_witness), not the thread-CPU nanos that budget_completion_outcome gates on (operator msg_e24f4cab). Do not compare these figures to the per-witness eval CPU budget without stating the clock. The arm is named in std.measure ClockBasis, which is the single clock-basis authority; this sentence said WitnessCostWallEval until 2026-08-05, naming a second carrier that std.realization_schedule declared for one day and that witness_cost_clock_note records the dissolution of. The advice the sentence gives is exactly what the surviving carrier now enforces rather than advises: witness_row_cost_verdict answers BasisClockMismatch instead of comparing across clocks."

data frontier_probe_witness_measure_receipt_read_failure: String = "target/frontier-probe-survey/matrix_readthrough_claim_batch_receipt.log"

data frontier_probe_witness_measure_receipt_hash_mismatch: String = "target/frontier-probe-survey/matrix_readthrough_claim_batch_receipt.log"

data frontier_probe_witness_measure_receipt_elision_boundary: String = "target/frontier-probe-survey/matrix_readthrough_claim_batch_receipt.log"

data frontier_probe_witness_measure_receipt_below_cap: String = "target/frontier-probe-survey/matrix_integration_claim_batch_receipt.log"

data frontier_probe_witness_measure_receipt_second_root: String = "target/frontier-probe-survey/second_root_measure_receipt.log"

fn compile_clean_source_roots() -> List<String> {
  concat(witness_layer_roots, ["src/v1"])
}

data witness_discovery_scan_dirs: List<String> = ["dag/test/claim", "src/v2/test/claim/manual", "src/v2/test/claim/emit"]

type WitnessExclusionRow {
  pattern: String
  classification: WitnessConsumerCadence
  reason: String
  dissolution: DissolutionCondition
}

data excl_bin_wet_reason: String = "bin-execution witness class: fns run compiled seed witness binaries (host effects on non-commit-deterministic inputs) the hermetic envelope refuses by construction. THE SECOND HALF OF THIS SENTENCE WAS FALSE AND IS CORRECTED HERE (2026-08-19). It read `they run every PR as the declared bin-witness wet batch via bin_witness_wet_entries`, present tense, asserting that this class is covered. NOTHING HAS RUN THAT BATCH SINCE 2026-08-15: the per-PR wet batch died with the floor cut, main carries exactly two workflows, `witnesses.yml` is the one hermetic fold that refuses this class by construction, and `fleet-converge.yml` is workflow_dispatch-only and carries no bin-witness batch. So 94 bin_wet rows across 38 entry files name an executing consumer that does not execute. The sentence did not merely fail to warn -- anyone reading this row to answer `is this class covered` was told YES, which is the stale-present-tense class DESIGN section 3 names, in the authority a reader consults FIRST. Measured and corrected while landing the one member of this class that got an executor back (the src/v1 parse step in gunbc.witness_floor_workflow, gunbc#8526); the other 93 rows remain unexecuted and their restoration is not this row to decide (bin_witness_wet_note)"

data excl_bin_wet_dissolve: DissolutionCondition = unbound_dissolution(description: "the file migrates under the execution-corpus scope prefix and enrolls as ExecutionWitnessKind rows in gunbc.commit_workflow; then this row and the roster entries delete (bin_witness_wet_note)")

data excl_run_verdict_exit_status_reason: String = "SUBSTANTIATED per-row (found 2026-08-16, PR #8286 CI red, run 31922786399, batch 3 discovery-corpus, 3 of 9782): every fn in this file invokes the compiled `gunbc` seed as a SUBPROCESS and reads the status of that process, so the hermetic envelope refuses them — 'no mock_response for operation Run' and 'for operation IsExecutable', the class excl_install_media_reason names. The refusal is correct and the file cannot be made hermetic: the subject IS the process exit status, which no in-process assertion can observe, and mocking the invocation would let the witness pass against a fabricated status — precisely the defect it exists to detect. The file was authored into dag/test/claim/ and so was swept into unshrunk hermetic discovery by path; the witnesses were right and the enrolment was wrong. Per DESIGN 'witness cost derives from purpose', this row alone would only remove them from hermetic discovery, which is NOT an executing consumer — so all three fns are ALSO enrolled in bin_witness_wet_entries below, which is their real per-PR executing consumer under WitnessHasExecutingConsumer standing. Size is derived, not chosen: three subprocess invocations of a three-constructor fixture, one per arm of the driver's verdict map."

data excl_run_verdict_exit_status_dissolve: DissolutionCondition = unbound_dissolution(description: "the driver's exit-status seam becomes observable without a subprocess — i.e. the verdict boundary migrates under the execution-corpus scope prefix and enrolls as ExecutionWitnessKind rows in gunbc.commit_workflow, the same terminal excl_bin_wet_dissolve names; then this row and the three roster entries delete together. Publishing a mock_response for Run/IsExecutable does NOT discharge it: a mocked status is authored data, so the assertions would be re-checked against the fixture rather than against the seam, which is the vacuous pass this file's refusal-polarity note already records once.")

data excl_rehomed_bin_wet_reason: String = "bin-execution witness class re-homed to the falsifier wet cadence (CI floor endgame D6): the file's enrolled fn(s) exceed bin_witness_wet_per_row_wall_budget_seconds, so they are CLASSIFIED as falsifier batch 5 via falsifier_rehomed_bin_wet_entries (typed frontier rows in falsifier_rehomed_bin_wet_rows). CADENCE STANDING (2026-08-19, dashboard node adhoc-1eb1a9f9-ad9): falsifier.yml, the workflow that scheduled every falsifier-family cadence including this one, was deleted at 611fd02770/#8283 (2026-08-15); classification into FalsifierRehomedBinWet still routes the row off per-PR discovery but no longer implies anything executes it — witness_execution_standing_for_row now derives DeclaredCadenceUnrealized here, same as FalsifierSubstrateLongLane (see falsifier_substrate_long_lane_note)."

data excl_rehomed_bin_wet_dissolve: DissolutionCondition = unbound_dissolution(description: "per falsifier_rehomed_bin_wet_rows dissolve_on: the row's realization lands under the per-row budget on a measured run and re-enrolls per-PR (or deletes as a duplicate); then this classification flips back to BinWitnessWet")

data excl_substrate_long_lane_reason: String = "SubstrateInputsOnly long-lane witness class re-homed to the falsifier hermetic cadence (test-decomposition Class C, 2026-07-25): the row's own eval exceeds the per-PR 5s fast-lane budget but the mechanism is fixture-shaped ingest/parse pipeline coverage, not wet integration — so it is CLASSIFIED as falsifier batch 6 via falsifier_substrate_long_lane_entries (typed frontier rows in falsifier_substrate_long_lane_rows). CADENCE STANDING (2026-08-19, dashboard node adhoc-1eb1a9f9-ad9): falsifier.yml, the workflow that scheduled this cadence, was deleted at 611fd02770/#8283 (2026-08-15). Classification into this cadence still routes the row off per-PR discovery; it no longer implies anything executes it. std.witness_admission witness_cadence_has_scheduled_route returns false for FalsifierSubstrateLongLane, and witness_execution_standing_for_row now derives DeclaredCadenceUnrealized for every row here rather than WitnessHasExecutingConsumer. See falsifier_substrate_long_lane_note for the bounded population and restoration terms."

data excl_substrate_long_lane_dissolve: DissolutionCondition = unbound_dissolution(description: "per falsifier_substrate_long_lane_rows dissolve_on: the row's eval lands under gunbc_ci_fast_lane_witness_eval_budget on a measured run and re-enrolls per-PR discovery (or deletes as a duplicate); then this classification flips back to DiscoverySelection")

data excl_behavioral_receipt_reason: String = "emit->compile->run->equals-seed self-host behavioral receipt class: enrolled fns are CLASSIFIED onto the falsifier nightly Wet cadence (wet_receipt_enrollment / falsifier_self_host_wet_note); non-enrolled fns run by local recipe. CADENCE STANDING (2026-08-19, dashboard node adhoc-1eb1a9f9-ad9): falsifier.yml was deleted at 611fd02770/#8283 (2026-08-15), so classification into FalsifierSelfHostWet no longer implies scheduled execution — witness_execution_standing_for_row now derives DeclaredCadenceUnrealized for enrolled fns here, same as FalsifierSubstrateLongLane (see falsifier_substrate_long_lane_note). falsifier_self_host_wet_cadence_is_active() in wet_receipt_enrollment.dag is a narrower, separate mechanism specific to this cadence that predates and is not corrected by this note; it is disclosed, not fixed, here."
data excl_behavioral_receipt_dissolve: DissolutionCondition = unbound_dissolution(description: "per-module receipts graduate to per-PR admission when proven cheap enough (falsifier_self_host_wet_note); row deletes")

data excl_wet_integration_reason: String = "wet-integration class, operator-ruled OFFLINE (hermetic-floor posture 2026-07-11): performs genuinely live host effects the hermetic envelope refuses by construction (wet_integration_offline_note)"

data excl_wet_integration_dissolve: DissolutionCondition = unbound_dissolution(description: "the scheduled (nightly) lane un-darkens and admits wet integration rows under its own budget; then the file enrolls there as declared execution rows and this row deletes (wet_integration_offline_note)")

data excl_probe_universe_carrier_reason: String = "non-witness workflow carrier: discovery never scans it (not a *_test.dag); the row exists for the whole_tree_resolve_exclusion_substrings probe-universe consumers"

data excl_probe_universe_carrier_dissolve: DissolutionCondition = unbound_dissolution(description: "the probe universe derives from module identity (module-identity-storage-binding lane) or the carrier relocates; a row that excludes nothing deletes")

data excl_roster_gate_dissolve: DissolutionCondition = unbound_dissolution(description: "resolved-graph memoization receipts land AND G2 path-intersection (not G1 module-closure alone) is wired into floor admission axis (iv); then re-enroll consciously through the floor owner's lane")

data excl_predates_per_row_reason: String = "operator/lane-ruled discovery exclusion predating per-row reasons; Phase 0(b) admission classifies its witnesses OfflineLocalRecipe (local recipe: claim_batch --source-root dag --source-root src/v2 --entry <file> --functions <csv>)"

data excl_predates_per_row_dissolve: DissolutionCondition = unbound_dissolution(description: "the owning lane records a scheduled consumer for the file, or the row proves dead (excludes nothing) and deletes")

data excl_install_media_reason: String = "real host-effect execution witness (shell effects with no mock_response coverage, or real network/build effects) refused by the hermetic envelope; runs in the bin-witness wet lane (install_media_real_execution_wet_note)"

data excl_install_media_dissolve: DissolutionCondition = unbound_dissolution(description: "mock_response coverage lands and assertions are re-checked under a fixed mock; then the fns re-enroll as ordinary hermetic discovery rows and this row deletes (install_media_real_execution_wet_note)")

