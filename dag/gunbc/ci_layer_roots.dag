module gunbc.ci_layer_roots

data witness_layer_roots: List<String> = ["dag", "src/v2"]

data compile_clean_source_roots_note: String = "Compile-clean pool extends witness_layer_roots with src/v1 for cross-tree import resolution only (e.g. dag/test/claim/ownership_movable_test imports v1.compiler.ownership). src/v1 stays excluded from floor witness_layer_roots per gunbc.plans.seed_debt_bundle_item_2 §1 (parse-cursor fork deferred — no floor witness discovery over src/v1)."

fn compile_clean_source_roots() -> List<String> {
  concat(witness_layer_roots, ["src/v1"])
}

data witness_discovery_scan_dirs: List<String> = ["dag/test/claim", "src/v2/test/claim/manual"]

data discovery_flip_quarantine_note: String = "QUARANTINE (2026-07-09, discovery-flip pre-flight): the three rows below were found red by the first full-corpus selection run at the enrollment flip (gunbc.ci_spec ci_spec_discovery_flip_note) and verified PRE-EXISTING red on main by execution at the pre-flip commit - rot accumulated while the corpus was unenrolled, not new breakage. They are live-tree rows (never predict-skip), so unquarantined they would turn every PR and every falsifier window red on inherited debt, drowning new signal. This is the loud interim arm, not a silent cap: each row is named here, counted, and carries the same dissolution - its fix lands, its row is deleted. Failing fns at quarantine time: medium_structure_clean_tree_holds; medium_structure_canonical_read_back_holds; realization_vocab_clean_tree_holds. NOTE file-level granularity: sibling green fns in these files are quarantined with them (the discovery exclusion is path-substring). dag_import_closure_equals_declared_conformance_closure unquarantined 2026-07-09 (swift-pike-439). enforcement/grammar_coverage_witness_test.dag unquarantined 2026-07-09 (sharp-swift-243): v1 reject locus pins corrected by execution to parse-stage parse_grammar_choice_overlap_residue on both src/v1/00_core.dag and 01_tokenize.dag; Symbol reason equality grounded via symbol_identity_digest in grammar_coverage_symbol_reason_eq."

