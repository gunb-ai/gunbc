fn witness_exclusion_row_is_offline(row: WitnessExclusionRow) -> Bool {
  match row.classification {
    OfflineLocalRecipe => true
    DiscoverySelection => false
    FalsifierSelfHostWet => false
    FalsifierRehomedBinWet => false
    BinWitnessWet => false
    QuarantineProbeExpectRed => false
    FixtureExplicitRoster => false
    NoConsumer => false
  }
}

fn witness_exclusion_row_is_fixture(row: WitnessExclusionRow) -> Bool {
  match row.classification {
    FixtureExplicitRoster => true
    DiscoverySelection => false
    FalsifierSelfHostWet => false
    FalsifierRehomedBinWet => false
    BinWitnessWet => false
    QuarantineProbeExpectRed => false
    OfflineLocalRecipe => false
    NoConsumer => false
  }
}

fn witness_exclusion_row_is_discovery_selection(row: WitnessExclusionRow) -> Bool {
  match row.classification {
    DiscoverySelection => true
    FalsifierSelfHostWet => false
    FalsifierRehomedBinWet => false
    BinWitnessWet => false
    QuarantineProbeExpectRed => false
    OfflineLocalRecipe => false
    FixtureExplicitRoster => false
    NoConsumer => false
  }
}

fn witness_exclusion_row_is_rehomed_bin_wet(row: WitnessExclusionRow) -> Bool {
  match row.classification {
    FalsifierRehomedBinWet => true
    BinWitnessWet => false
    DiscoverySelection => false
    FalsifierSelfHostWet => false
    QuarantineProbeExpectRed => false
    OfflineLocalRecipe => false
    FixtureExplicitRoster => false
    NoConsumer => false
  }
}

fn witness_exclusion_row_is_bin_witness_wet(row: WitnessExclusionRow) -> Bool {
  match row.classification {
    BinWitnessWet => true
    DiscoverySelection => false
    FalsifierSelfHostWet => false
    FalsifierRehomedBinWet => false
    QuarantineProbeExpectRed => false
    OfflineLocalRecipe => false
    FixtureExplicitRoster => false
    NoConsumer => false
  }
}

fn witness_exclusion_row_is_known_red(row: WitnessExclusionRow) -> Bool {
  match row.classification {
    QuarantineProbeExpectRed => true
    DiscoverySelection => false
    FalsifierSelfHostWet => false
    FalsifierRehomedBinWet => false
    BinWitnessWet => false
    OfflineLocalRecipe => false
    FixtureExplicitRoster => false
    NoConsumer => false
  }
}

fn witness_exclusion_row_is_falsifier_wet(row: WitnessExclusionRow) -> Bool {
  match row.classification {
    FalsifierSelfHostWet => true
    FalsifierRehomedBinWet => false
    DiscoverySelection => false
    BinWitnessWet => false
    QuarantineProbeExpectRed => false
    OfflineLocalRecipe => false
    FixtureExplicitRoster => false
    NoConsumer => false
  }
}

fn witness_exclusion_row_is_no_consumer(row: WitnessExclusionRow) -> Bool {
  match row.classification {
    NoConsumer => true
    DiscoverySelection => false
    FalsifierSelfHostWet => false
    FalsifierRehomedBinWet => false
    BinWitnessWet => false
    QuarantineProbeExpectRed => false
    OfflineLocalRecipe => false
    FixtureExplicitRoster => false
  }
}

fn witness_exclusion_patterns(rows: List<WitnessExclusionRow>) -> List<String> {
  fold(rows, init: [], f: fn(acc, row) { concat(acc, [row.pattern]) })
}

fn witness_exclusion_substrings() -> List<String> {
  witness_exclusion_patterns(rows: witness_exclusion_frontier)
}

fn witness_admission_offline_exclusion_substrings() -> List<String> {
  witness_exclusion_patterns(
    rows: fold(
      witness_exclusion_frontier,
      init: [],
      f: fn(acc, row) {
        if witness_exclusion_row_is_offline(row: row) { concat(acc, [row]) } else { acc }
      }
    )
  )
}

fn witness_admission_fixture_exclusion_substrings() -> List<String> {
  witness_exclusion_patterns(
    rows: fold(
      witness_exclusion_frontier,
      init: [],
      f: fn(acc, row) {
        if witness_exclusion_row_is_fixture(row: row) { concat(acc, [row]) } else { acc }
      }
    )
  )
}




data witness_exclusion_single_authority_reconciliation_note: String = "Single-authority reconciliation (module-identity-storage-binding Phase 0(b) follow-on; the prior note's dissolve-on FIRED 2026-07-22 via the group-of-units ruling): witness_exclusion_frontier is the ONE typed discovery-exclusion roster — every row carries pattern, consumer classification (the std.witness_admission WitnessConsumerCadence authority, no minted twin), reason, and dissolve_on. The former parallel lists witness_admission_offline_exclusion_substrings / witness_admission_fixture_exclusion_substrings are now DERIVED projections (classification filters) — the hand-kept containment alignment they needed is unwritable, so the old one-way-containment witness dissolved with them; v2.test.claim.witness_exclusion_reconciliation_test now witnesses row well-formedness (no DiscoverySelection row; NoConsumer only for the synthetic admission RED-control path; nonempty reason and dissolve_on per row) and explicit-roster consistency (BinWitnessWet / QuarantineProbeExpectRed rows name files the corresponding rosters actually run). whole_tree_resolve_exclusion_substrings stays the ONE concat(witness_exclusion_substrings(), whole_tree_strict_resolve_exclusion_substrings) pattern authority in .dag; the host projection in cli_run.rs parses the frontier rows with the real front-end and must stay list-identical (Rust unit test witness_whole_tree_resolve_exclusion_matches_concat_authority). Strict-walk probe bins consume whole_tree_probe_exclusion_substrings() — pattern rows ∪ host-derived module-path closure (census_exclude_derive) with LiveImporterExclusion receipts; docs/probes/census_extra_excludes.txt is a historical drift witness only (not authority). The roster is enrolled in gunbc.roster_registry as a DeclaredFrontier group. Dissolves when the enforcement-intent registry absorbs the roster or floor admission consumes per-row cost and consumer declarations directly."

data witness_admission_offline_note: String = "Phase 0(b) admission invariant (module-identity-storage-binding): operator-ruled OFFLINE exclusion substrings whose witness rows carry OfflineLocalRecipe consumers — documented local recipes in the paired exclusion notes (wet_integration_offline_note, enforcement_coverage_exclusion_note, accumulator_copy_roster_gate_exclusion_note, identity_captured_navigation_roster_gate_exclusion_note, lever_a_local_receipt_witness_exclusion_note, long_lane_exclusion_note). Dissolves when each row graduates to a scheduled CI consumer or deletes."

data crate_layout_transport_exclusion_note: String = "self_host/crate_layout_witness_test.dag is excluded from hermetic discovery and consumed by v2.workflow.module_binding_supply_transport (run_module_binding_supply_gate, reached from source_root_ingest_gate) — the same posture as its siblings program_assembly/real_ingest_test.dag and self_host/compiler_closure_emit_from_ingest_test.dag, which are transport-run for the same reason.

WHY: as of task 3 these witnesses project off the derived ModuleStorageIndex, and the live index exists only inside that transport's overlay. Run hermetically they read host_module_bindings = Empty and REFUSE — correct behaviour, wrong lane.

DO NOT give this file bin_witness_wet_entries rows. That was tried and it is the wrong roster: a bin_wet row makes the fn an EXPLICIT discovery entry, which BYPASSES the exclusion above and runs it hermetically in batch 3, where it refuses and reds. The tell in that failure is diagnostic — projection_refuses_on_absent_index PASSED while the other two failed, which is precisely Empty-index behaviour rather than a broken projection.

Local recipe: gunbc run --source-root src/v2 --source-root dag --entry src/v2/workflow/module_binding_supply_transport.dag --function run_module_binding_supply_gate --claim-run

Dissolve-on: the crate-layout artifact moves to host-driven generation with the index supplied at the boundary — then the hand rows, the parity witness, and this exclusion delete together."

data witness_admission_fixture_note: String = "Phase 0(b): floor_skip control fixtures excluded at dir grain — consumers are explicit rosters in floor_skip_discovery_witness, not the discovery corpus. Dissolves when fixture-home policy changes."

