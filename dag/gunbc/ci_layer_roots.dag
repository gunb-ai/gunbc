fn witness_exclusion_patterns(rows: List<WitnessExclusionRow>) -> List<String> {
  fold(rows, init: [], f: fn(acc, row) { concat(acc, [row.pattern]) })
}

fn witness_exclusion_row_waits_on_wet_lane_undarken(row: WitnessExclusionRow) -> Bool {
  string_contains(s: dissolution_description(condition: row.dissolution), pattern: "falsifier_self_host_wet_cadence_active")
    || (dissolution_description(condition: row.dissolution) == dissolution_description(condition: excl_wet_integration_dissolve))
    || (dissolution_description(condition: row.dissolution) == dissolution_description(condition: excl_behavioral_receipt_dissolve))
    || string_contains(s: dissolution_description(condition: row.dissolution), pattern: "wet lane un-darken")
    || string_contains(s: dissolution_description(condition: row.dissolution), pattern: "wet lane un-darkens")
}

data witness_exclusion_row_mentions_wet_lane_dark_state_note: String = "witness_exclusion_row_mentions_wet_lane_dark_state is a broader candidate net than witness_exclusion_row_waits_on_wet_lane_undarken's positive arms: any row whose dissolve_on names the falsifier_self_host_wet lane, the cadence flag, or an un-darken trigger in ANY spelling. A row caught by this net but not matched by the positive predicate is a THIRD spelling the positive predicate has not learned yet -- surfaced via falsifier_self_host_wet_dark_lane_unclassified_rows, not silently dropped (still-bat-561 review, 2026-08-05: a derived count is only as good as its predicate, and a predicate with an unclassified residue silently deflates exactly like a hand-typed ordinal goes stale). This is a candidate net, not a second authority: false positives here (a row that mentions the wet lane only as one arm of an unrelated OR-condition) are expected and are why v2.test.claim.witness_exclusion_reconciliation_test asserts the PROPERTY -- every candidate is claimed by exactly one arm -- rather than asserting any specific count."

fn witness_exclusion_row_mentions_wet_lane_dark_state(row: WitnessExclusionRow) -> Bool {
  string_contains(s: dissolution_description(condition: row.dissolution), pattern: "falsifier_self_host_wet")
    || string_contains(s: dissolution_description(condition: row.dissolution), pattern: "un-darken")
}

fn falsifier_self_host_wet_dark_lane_waiting_rows() -> List<WitnessExclusionRow> {
  fold(
    witness_exclusion_frontier,
    init: [],
    f: fn(acc, row) {
      if witness_exclusion_row_waits_on_wet_lane_undarken(row: row) { concat(acc, [row]) } else { acc }
    }
  )
}

fn falsifier_self_host_wet_dark_lane_waiting_patterns() -> List<String> {
  witness_exclusion_patterns(rows: falsifier_self_host_wet_dark_lane_waiting_rows())
}

fn falsifier_self_host_wet_dark_lane_population() -> Int {
  falsifier_self_host_wet_dark_lane_waiting_patterns().length()
}

fn falsifier_self_host_wet_dark_lane_unclassified_rows() -> List<WitnessExclusionRow> {
  fold(
    witness_exclusion_frontier,
    init: [],
    f: fn(acc, row) {
      if witness_exclusion_row_mentions_wet_lane_dark_state(row: row)
        && !witness_exclusion_row_waits_on_wet_lane_undarken(row: row) {
        concat(acc, [row])
      } else {
        acc
      }
    }
  )
}

fn falsifier_self_host_wet_dark_lane_unclassified_patterns() -> List<String> {
  witness_exclusion_patterns(rows: falsifier_self_host_wet_dark_lane_unclassified_rows())
}

fn witness_exclusion_substrings() -> List<String> {
  witness_exclusion_patterns(rows: witness_exclusion_frontier)
}

fn witness_admission_offline_exclusion_substrings() -> List<String> {
  witness_exclusion_patterns(
    rows: fold(
      witness_exclusion_frontier,
      init: [],
      f: fn(acc, row) {
        if witness_exclusion_row_is_offline(row: row) { concat(acc, [row]) } else { acc }
      }
    )
  )
}

fn witness_admission_fixture_exclusion_substrings() -> List<String> {
  witness_exclusion_patterns(
    rows: fold(
      witness_exclusion_frontier,
      init: [],
      f: fn(acc, row) {
        if witness_exclusion_row_is_fixture(row: row) { concat(acc, [row]) } else { acc }
      }
    )
  )
}




data witness_exclusion_single_authority_reconciliation_note: String = "Single-authority reconciliation (module-identity-storage-binding Phase 0(b) follow-on; the prior note's dissolve-on FIRED 2026-07-22 via the group-of-units ruling): witness_exclusion_frontier is the ONE typed discovery-exclusion roster — every row carries pattern, consumer classification (the std.witness_admission WitnessConsumerCadence authority, no minted twin), reason, and dissolve_on. The former parallel lists witness_admission_offline_exclusion_substrings / witness_admission_fixture_exclusion_substrings are now DERIVED projections (classification filters) — the hand-kept containment alignment they needed is unwritable, so the old one-way-containment witness dissolved with them; v2.test.claim.witness_exclusion_reconciliation_test now witnesses row well-formedness (no DiscoverySelection row; NoConsumer only for the synthetic admission RED-control path; nonempty reason and dissolve_on per row) and explicit-roster consistency (BinWitnessWet / rehomed / substrate-long-lane rows name files the corresponding rosters actually run). As of 2026-08-03 it is a PATH POLICY roster: exact witness admission moved to gunbc.explicit_witness_admission at function grain and a QuarantineProbeExpectRed row here is refused outright, because a substring pattern can only be checked for containment against a schedule row and containment is not identity. whole_tree_resolve_exclusion_substrings stays the ONE concat(witness_exclusion_substrings(), whole_tree_strict_resolve_exclusion_substrings) pattern authority in .dag; the host projection in cli_run.rs parses the frontier rows with the real front-end and must stay list-identical (Rust unit test witness_whole_tree_resolve_exclusion_matches_concat_authority). Strict-walk probe bins consume whole_tree_probe_exclusion_substrings() — pattern rows ∪ host-derived module-path closure (census_exclude_derive) with LiveImporterExclusion receipts; docs/probes/census_extra_excludes.txt is a historical drift witness only (not authority). The roster is enrolled in gunbc.roster_registry as a DeclaredFrontier group. Dissolves when the enforcement-intent registry absorbs the roster or floor admission consumes per-row cost and consumer declarations directly."

data witness_admission_offline_note: String = "Phase 0(b) admission invariant (module-identity-storage-binding): operator-ruled OFFLINE exclusion substrings whose witness rows carry OfflineLocalRecipe consumers — documented local recipes in the paired exclusion notes (wet_integration_offline_note, enforcement_coverage_exclusion_note, accumulator_copy_roster_gate_exclusion_note, identity_captured_navigation_roster_gate_exclusion_note, lever_a_local_receipt_witness_exclusion_note, long_lane_exclusion_note). Dissolves when each row graduates to a scheduled CI consumer or deletes."

data crate_layout_transport_exclusion_note: String = "self_host/crate_layout_witness_test.dag is excluded from hermetic discovery and consumed by v2.workflow.module_binding_supply_transport (run_module_binding_supply_gate, reached from source_root_ingest_gate) — the same posture as its siblings program_assembly/real_ingest_test.dag and self_host/compiler_closure_emit_from_ingest_test.dag, which are transport-run for the same reason.

WHY: as of task 3 these witnesses project off the derived ModuleStorageIndex, and the live index exists only inside that transport's overlay. Run hermetically they read host_module_bindings = Empty and REFUSE — correct behaviour, wrong lane.

DO NOT give this file bin_witness_wet_entries rows. That was tried and it is the wrong roster: a bin_wet row makes the fn an EXPLICIT discovery entry, which BYPASSES the exclusion above and runs it hermetically in batch 3, where it refuses and reds. The tell in that failure is diagnostic — projection_refuses_on_absent_index PASSED while the other two failed, which is precisely Empty-index behaviour rather than a broken projection.

Local recipe: gunbc run --source-root src/v2 --source-root dag --entry src/v2/workflow/module_binding_supply_transport.dag --function run_module_binding_supply_gate --claim-run

Dissolve-on: the crate-layout artifact moves to host-driven generation with the index supplied at the boundary — then the hand rows, the parity witness, and this exclusion delete together."

data witness_admission_fixture_note: String = "Phase 0(b) admitted control fixtures excluded from tree-wide discovery at dir grain: their consumers are explicit rosters, never the discovery corpus. The floor_skip fixture home was deleted with affected-set selection itself (the rows it controlled no longer exist); walk_plan_stage remains. Dissolves when fixture-home policy changes."

data known_red_probe_note: String = "Phase 0(b) quarantine probe cadence (module-identity-storage-binding): known-red frontier witnesses that EXPECT RED on main — the falsifier probe batch's designed shape runs them SelectionApplied; greening is a counted un-quarantine event (per-row dissolve_on on the authority). Distinct from falsifier_self_host_wet (green-only SelfEmitted receipts). SINGLE AUTHORITY (2026-08-03): the rows live at function grain in gunbc.explicit_witness_admission explicit_witness_admissions and BOTH consumers derive from them — this roster is the falsifier batch's projection, and v2.workflow.floor_discovery_producer drops exactly the same (entry, function) pairs from per-PR discovery. The former shape was a dual representation: a QuarantineProbeExpectRed WitnessExclusionRow removing the whole FILE plus a probe_red(entry, f) row enrolling one FUNCTION, reconciled by a check instead of by construction. Those pattern rows are deleted; a pattern row that re-states a quarantine is now refused by witness_exclusion_row_well_formed. CADENCE STANDING (2026-08-19, dashboard node adhoc-1eb1a9f9-ad9): 'runs them' describes the batch's designed ordering, not a currently running schedule — falsifier.yml was deleted at 611fd02770/#8283 (2026-08-15), so nothing currently runs this probe batch and witness_execution_standing_for_row derives DeclaredCadenceUnrealized for QuarantineProbeExpectRed rows too (see falsifier_substrate_long_lane_note)."

fn known_red_probe_roster() -> List<ScheduleWitnessEntry> {
  concat(
    known_red_probe_corpus_roster(),
    known_red_probe_v1_envelope_roster()
  )
}

data long_lane_exclusion_note: String = "test/claim/long/ is the LONG-test home (operator 5-second rule, 2026-07-12; authority + enforcement: gunbc_ci_fast_lane_rule_note / gunbc_ci_fast_lane_witness_eval_budget in v2.workflow.ci_floor_plan): a witness whose own eval reaches 5s does not run in per-PR discovery — the executor's cooperative eval deadline REDs it by name (EvalBudgetExceeded), and the fix is moving its file here (dag/test/claim/long/, src/v2/test/claim/long/), where discovery excludes it at dir grain and it runs via the local recipe (claim_batch --source-root dag --source-root src/v2 --entry <file> --functions <csv>) or the scheduled lane's future enrollment. First residents (receipted): s1_closure_receipt_test (whole-closure re-parse through the interpreted v2 frontend, 90+min eval, the run-29183446733 wedge class) and self_host_module_emit_derisk_test (~31s/witness). Membership here was called a HOME rather than a per-file ruling on the ground that the 5s deadline makes an over-budget fast-lane witness unwritable-in-place, so the roster could not silently grow stale. THAT SENTENCE WAS FALSE AND IS RETRACTED (2026-08-04). The deadline is evaluated only while a witness RUNS; relocating its file under this prefix is precisely what stops it running, so the claimed construction backstop is disarmed by the exact move it was supposed to govern, and the home grew by whatever anyone moved into it. BudgetExceeded is an interruption plus a measured lower bound on cost — never a semantic verdict on a witness, and never a discharge of one by causing its relocation. Receipt: gunbc#7762 commit 0cfd199f8, thirteen witnesses relocated here under the title fix CI fast-lane budget failures with a claim_batch command line as their only stated consumer and no cadence row. WHAT NOW HOLDS THE LINE: this prefix still organizes the files, but it no longer answers the admission question. gunbc.witness_deferral_freeze enumerates the exact legacy identities path policy had already admitted, and any offline-classified witness outside that frozen set and outside gunbc.explicit_witness_admission refuses as UnclassifiedPathDeferral, while a frozen row the tree no longer carries refuses as StaleFrozenPathDeferral. Dissolve-on: the freeze reaching empty — every resident carrying an exact admission with a declared purpose, cost and executing cadence — at which point the pass-through arm and this dir row delete together."


data wet_integration_offline_note: String = "Four wet-integration entries above (host_effect_apply, deploy_access_privilege, ci_deploy_observed_wet, random_bytes_csprng) are OFFLINE per the hermetic-floor posture (operator 2026-07-11: integration-style witnesses must not run regularly; CI runs hermetic/mocked behavior checks). Each performs genuinely live host effects the hermetic envelope refuses by construction: host_effect_apply drives real LocalShell/SSH host effects (the 133s row atop the slow-witness census), deploy_access_privilege applies privileged shell mutations through fixture actors, ci_deploy_observed_wet shells whoami + sudo -n, random_bytes_csprng reads host entropy. Hermetic duals stay discovered where they exist (the ci_deploy split keeps the pure half; deploy_access_check(access, actor) is the mock-shaped dual). Local recipe: claim_batch --wet --source-root dag --source-root src/v2 --entry <entry> per file. Dissolve-on: the scheduled (nightly) lane un-darkens and admits wet integration rows under its own budget — then these four enroll there as declared execution rows and the exclusion rows delete."

data known_red_frontier_note: String = "HOW THE KNOWN-RED FRONTIER WORKS, and the receipts it has accumulated. The rows themselves live at function grain on gunbc.explicit_witness_admission explicit_witness_admissions, each carrying its own diagnosis and dissolve_on; this note deliberately does NOT restate them (that would be the parallel-ledger duplication the rows exist to prevent) and carries only what is not a property of a live row. WHAT THEY ARE: witnesses red on main for feature gaps owned by named lanes. They are RED CONTROLS for their lanes, not broken tests - deleting one would discard the discriminating input, while leaving it discovered would red every wide PR on a debt that PR did not create. So each sits as a declared, countable row (the typed self-host-frontier pattern applied to witnesses). Local recipe per row: claim_batch --source-root dag --source-root src/v2 --entry <entry> --functions <function>. THE ROSTER MUST NOT GROW SILENTLY: a new admission requires a per-row reason naming the diagnosis and owner plus a dissolve_on, and a row whose witness runs green locally is stale and deletes. Greening is the counted un-quarantine event of std.witness_admission: the row deletes in the SAME change that lands the fix, which promotes the unchanged witness to ordinary DiscoverySelection as a permanent regression control (DESIGN 4b(4) - the climb deletes the quarantine machinery, never the evidence). UN-QUARANTINE RECEIPTS (history, not live rows). emit_host_fold_closure_equals_eval_test (2026-07-20, smart-hawk-154 / witness-realization lane 3): three rows deleted - the eval walk now materializes RuntimeClosure for an Arrow TypeNode in runtime-argument position (eval_fold_is_closure_argument_edge / eval_fold_closure_argument_child_state in 05_eval.dag), so the closure at transform child 3 of fold_fixture_param_call_body evaluates to a real closure value instead of falling through eval_type_node_atom's non-Atom arm into allocate_literal and refusing. The interpreted leg reads the closure from the EVALUATED argument list rather than re-walking the node AST, so eval is genuinely exercised, and no literal-atom roster was extended (the PR 6879 diagnosis-table tripwire). emit_on_demand_field_access_family_witness_test + emit_on_demand_complement_family_witness_test (2026-07-20, witty-owl-841 / eval-repair arc): ten rows deleted - dag_node_is_eval_literal_atom plus eval_type_node_atom bind-miss and non-Atom TypeNode arms routing to allocate_literal repaired the lane-2 equals_eval BuildFailed roots. emit_host_meet_join_equals_eval_test and emit_host_variant_construct_equals_eval_test greened as byproducts of the same consolidation and never held rows of their own. WET ASSEMBLE-RED SelfEmitted MODULE RECEIPTS (admitted 2026-07-25, review #7199) are the same frontier at a different WitnessKind: six SelfEmitted wet behavioral receipts red on assemble (unresolved std_algebra/std_types/std_nat/List and target_carriers type-shape, cadence run 30126573464), which run Wet expect_red on the falsifier quarantine batch because Phase-0 forbids SelfEmitted-with-zero-executing-consumer. As of 2026-08-03 they are ExecutionWitnessKind rows on the one admission authority beside the hermetic ones, and v2.compiler.self_host.seed_emitter_behavioral_wet_known_red_entries derives from it rather than holding its own copy. Owner: #7199 falsifier lane / self-host assemble."

data bin_witness_wet_note: String = "The remaining excluded entries are the BIN-EXECUTION witness class: their test fns run compiled seed witness binaries via tools.host_prelude.run_witness_bin (git.Inspect.Toplevel to locate the checkout, shell.Test.IsExecutable against target/release build artifacts, then process execution) — host effects on non-commit-deterministic inputs, so the hermetic envelope refuses them by construction (audit 2026-07-12: every refusal typed as IsExecutable / Run / IsNonEmpty / Dir; the pure fns that merely read transport modules pass hermetically and stay discovered). They carry core per-PR compiler coverage, so unlike the offline four they DO keep running on every PR — as the declared bin-witness wet batch (bin_witness_wet_entries below, a Wet-profiled explicit-entry batch in v2.workflow.ci_floor_plan), never as silently-wet discovery rows. EXCEPTION (Wave 2, 2026-07-15): emit->compile->run->equals-seed self-host behavioral receipts (Gate-4 std/logic first) moved to the falsifier nightly Wet follow-on batch (falsifier_self_host_wet_entries) — per-PR stays hermetic/mocked for that class; the falsifier is the proven template lane. Dissolve-on: these files migrate under the execution-corpus scope prefix and enroll as ExecutionWitnessKind rows in gunbc.commit_workflow; then this roster and its exclusion rows delete."

data bin_witness_wet_per_row_actions_log_observation_gap_note: String = "CLOSED (measured 2026-08-06, Lane D / still-bat-561): main push run 31060353614 job 92492124511 (post-#7857 instrumentation) discriminates the four collapsed states. Batch 4 `bin-witness-corpus` PASS (146 witnesses); worker wrote `target/floor-wet-witness-row-outcome-receipt.tsv` with 192 rows; coordinator replayed 192 `[wet-witness-row-outcome]` lines; post-step dumps TSV + phase journal; `live_rust_observation_matches_actions_subject` row shows `outcome=passed` (batch=4). Prior zero-row reads conflated the regen job's legitimate 0-row receipt (no wet discovery batches) with the per-PR ci worker — observation collapse, not batch-not-reached or transport failure. HISTORY: COUNTED OBSERVATION GAP opened 2026-08-02 (#7698 run 30765850510); mechanism landed #7698 worker receipt + coordinator replay; scheduling proof #7857; observation extension #7857 labels + journal persistence + post-step dump."

data falsifier_self_host_wet_note: String = "The nightly falsifier Wet follow-on batch (gunbc_falsifier_batches batch 2 in v2.workflow.ci_floor_plan): explicit ExecutionWitnessKind rows whose fns realize the emit->compile->run->equals-seed self-host behavioral receipt chain (cargo build, process execution, real gunbc emit) — too heavy and fidelity-sensitive for per-PR hermetic discovery. Gate-4 std/logic (self_host_logic_behavioral_witness_test.dag) is the inaugural template migrated out of bin_witness_wet_entries; compiler modules enroll via v2.compiler.self_host.wet_receipt_enrollment through a SelfHostWetReceiptBinding (green-only — never known-red); the frontier-row flip that formerly gated that enrollment is gone with the self-host frontier roster, and the term it fed was already empty when it was deleted (wet_enrollment_roster_term_deleted_note), so the lane ran on template entries alone before and after. This DESCRIBES the batch's designed shape and ordering (SelectionApplied after the hermetic affected-set falsifier sweep), not a currently running schedule: falsifier.yml, the workflow that invoked claim_executor's batch plan, was deleted at 611fd02770/#8283 (2026-08-15), so nothing currently runs this batch (CADENCE STANDING, 2026-08-19, dashboard node adhoc-1eb1a9f9-ad9 — see falsifier_substrate_long_lane_note). Local recipe: claim_batch --wet --source-root dag --source-root src/v2 --entry <entry> --functions <csv>. Dissolve-on: per-module self-host receipts graduate to continuous CI only when the emit-on-demand / self-host cutover lane proves each module's receipt is cheap enough for per-PR admission — until then this lane has no scheduled consumer."

// The R1 dark-lane status note JOINS two authorities — this module's waiting-pattern
// projection and v2.compiler.self_host.wet_receipt_enrollment's cadence/enrollment facts —
// so it belongs with the consumer that already reaches both, not here. Homing it here cost
// this module an import of v2.compiler.self_host.wet_receipt_enrollment, and because
// gunbc.ci_spec imports this module and nearly every witness entry imports ci_spec, that
// single edge pulled the self_host subtree (and v2.lens.module_graph through it) into the
// import closure of ~63 additional witness entries. Two live-read carrier homes sit in that
// subtree, and affected-set selection's axis (iv)
// (runtime_data_dependency_touched_via_carrier_closure) treats "closure reaches a carrier
// home, and any path is touched" as a hit — so those entries stopped being skippable on
// EVERY diff. Measured: *_test.dag entries reaching a carrier home went 144/1200 to
// 210/1219, and the selection control's cross-entry specimen
// (affected_set_floor_runner_test.dag) became permanently unskippable, which is what took
// the scheduled falsifier dark at its build gate.

fn bin_wet(entry: String, f: String) -> ScheduleWitnessEntry {
  ScheduleWitnessEntry { entry: entry, function: f, kind: ExecutionWitnessKind }
}

data v1_claim_scoped_witness_batch_deleted_note: String = "THE SCOPED WITNESS BATCH IS DELETED (2026-08-15), and with it the only ScopedWitnessBatch instance that ever existed. It ran five file-grain v1 claim entries under a dag plus src/v1 source-root envelope, in a sequential child worker, so the v1 compiler closure could be resolved without widening witness_layer_roots for everything else.\n\nWHY IT COULD NOT SURVIVE AFFECTED-SET SELECTION. It was the last SelectionApplied consumer on the required path, and its 720-second clamp was derived (PR #8259) from a measured 565-second wall on the assumption that unrelated PRs skip it. With selection deleted the two available readings were both wrong: run it every PR and the required floor grows by roughly nine minutes under a clamp basis that no longer describes it, or keep a selection mechanism alive for one batch. Its cost was also never really the witnesses — the same receipt measured about 390 seconds of closure materialization before the first witness line and about 30 seconds of witness evaluation, so it was paying a whole second subject preparation to check thirty rows.\n\nWHAT THIS NARROWS, stated rather than implied: the five entries under src/v1/tests/claim have NO executing consumer. They are not covered by ordinary discovery, whose roots are dag plus src/v2. Their generated stage0 emissions still compile into the seed crate, which is not execution. This is a real loss of coverage over v1 parser and namespace-binding behavior, taken deliberately as part of deleting the floor rather than discovered later, and it is NOT backstopped by any cadence — the cadence lane those rows might have moved to was refused for the same reason the per-PR slot was: a second subject envelope is the defect, not the schedule it runs on.\n\nRESTORATION: one prepared subject spanning dag, src/v1 and src/v2, at which point a separate envelope, a separate worker, a separate clamp and a separate receipt family all stop existing and these rows are ordinary discovery."


data witness_fold_src_v1_coverage_gap_note: String = "DECLARED COVERAGE GAP (operator ruling relayed 2026-08-15, at the re-add #1 boundary). The required witness fold runs `claim_executor --required-floor --source-root dag --source-root src/v2`, so every witness under src/v1 is OUTSIDE it. Measured at declaration: 116 `test fn` declarations across 15 files under src/v1/tests/claim. Their previous consumer was the scoped witness batch deleted above; nothing has replaced it, and no cadence backstops them.\n\nWHY THE ONE-TOKEN FIX WAS REFUSED. Adding --source-root src/v1 would also admit the 52 non-test .dag modules under src/v1 into the ONE shared prepared subject the fold depends on. That subject is a single flat namespace per scope, and the v1 tree declares its own module population; poisoning the fold's first census with collisions to chase coverage costs more than the gap, and a first measurement taken against a subject nobody has run before is not a measurement worth having.\n\nWHY IT IS DECLARED RATHER THAN QUIET. run_required_floor refuses internally when planned, executed and terminal identity counts disagree, precisely so a narrowed roster cannot present as a roster. That wall operates INSIDE the subject; it cannot see a population the subject never admitted. So the same honesty has to be carried here, in prose, at the boundary: the fold runs every witness IN ITS SUBJECT, and its subject is two roots, not three.\n\nPOPULATION LOCATION IS BRANCH-DEPENDENT (relayed 2026-08-15, after this row was authored). The 15 files are present on main and DELETED on integration/v1-cut, where a src/v1/**/*.dag root deletion swept 16 witness .dag files under src/v1/tests/claim — this population — as collateral. So a reader checking main and a reader checking that cut branch will disagree about whether the gap has a subject at all, and the dissolve-on below is only satisfiable on a branch where the files still exist. A per-file disposition proposal (re-home under a surviving subject, or retire with a receipt naming the rejected behavior) is routed elsewhere and is deliberately NOT acted on here; several of the 16 witness LANGUAGE behavior rather than v1-compiler behavior (§4c annotation capture and erasure, the line-continuation operator-table derivation), so a blanket retire would drop evidence for obligations the replacement still claims. This row stays a declared gap until that proposal lands, at which point it either dissolves for real (files re-homed and inside the fold) or converts to a retirement receipt.\n\nDISSOLVE-ON: the boundary decision on these 15 files. The recommendation carried into that decision is RELOCATION into the dag test root rather than widening the root set — one tree, one namespace, consistent with every cut currently consolidating away from src/v1 — with the caveat that three sibling cuts are reshaping src/v1 concurrently and some of these 116 may die with them, so the relocation census is taken at the boundary and not before it."


data v1_dead_witness_tree_triage_receipt: String = "DISCHARGES witness_fold_src_v1_coverage_gap_note's routed-elsewhere per-file disposition proposal (dashboard node adhoc-9b80ec49-d63, session zesty-newt-828, 2026-08-18/19). COUNT CORRECTION: that note measured 116 test fn declarations across 15 files at 2026-08-15 declaration time; by the time this triage read the tree the population was 17 files (12 disposed directly in this receipt, plus 5 files — checkpoint_identity_keying_witness_test.dag, occurrence_binding_parser_walk_witness_test.dag, occurrence_identity_debt_receipt_test.dag, pattern_binder_declaration_node_test.dag, v1_match_pattern_identity_test.dag — dispositioned by a concurrent batch and not re-narrated here; ATTRIBUTION, confirmed against git show --stat 11113ac9e9: all 17 files, including these 5, were deleted in that ONE commit, one author (Brian Searls), on this same branch session/zesty-newt-828 — there is no separate sibling dashboard session to attribute for PR purposes, 'concurrent' here means a parallel work stream inside this session, not a different session's contribution; checkpoint_identity_keying_witness_test.dag alone is carved out to stern-fox-619's own PR per the binding scope exclusion, unaffected by this attribution). The 15-vs-17 gap is branch drift between 2026-08-15 and the triage read, not a miscount of either measurement.\n\nDISPOSITION, MIGRATED (relocated to dag/test/claim, rewritten onto compile_dag_rust_emit_check, running under ordinary discovery — source roots dag + src/v2, no v1 import): dag_parse_continuation_operator_witness_test.dag -> dag/test/claim/dag_parse_continuation_operator_witness_test.dag (8 of 9 tests migrated black-box; w_dual_role_exclusion_intersection_is_singleton_minus retired in-file, pure operator-table introspection with no compile-observable surface, its protected family covered black-box by the comparison-family test beside it). required_expr_newline_continuation_test.dag -> dag/test/claim/required_expr_newline_continuation_witness_test.dag (all 8 tests migrated 1:1, 5 parse-clean + 3 refuses-to-compile each paired against a proven-clean sibling). ordinary_frontend_observation_test.dag -> dag/test/claim/frontend_literal_and_compile_witness_test.dag (2 pure interpreter-literal tests moved unchanged, no v1 import ever needed; 2 compile-observation tests converted to compile_dag_rust_emit_check clean/broken-subject pairs). caret_parse_smoke_test.dag -> dag/test/claim/caret_syntax_witness_test.dag (3 black-box compile/emit-substring tests migrated; 7 white-box tokenizer/parser-internals tests retired in-file, no compile-observable equivalent). v1_annotation_target_emission_test.dag -> dag/test/claim/annotation_erasure_emission_witness_test.dag (the D-C property 4 erasure claim plus a non-vacuity control, both via compile_dag_rust_emit_check includes/excludes on emitted Rust text; not a byte-identical replay of the 2026-08-05 host-execution diff receipt, which stands as separate historical evidence).\n\nDISPOSITION, RETIRED (white-box, no compile-observable proxy for the same claim; deleted with this receipt as the record): v1_annotation_binding_test.dag, v1_annotation_capture_test.dag, v1_annotation_round_trip_test.dag, v1_annotation_erasure_test.dag — all four inspect v1-internal occurrence-identity/annotation-graph/span-provenance/node-fingerprint state directly (std.occurrence_identity, v1.compiler.annotation_bind, dag_node_surface_fingerprint) that has no representation in emitted Rust text; per DESIGN §4c, annotation capture/erasure is disjoint from semantic occurrence identity by construction, so these are facts about the FRONTEND's internal bookkeeping, not about a compiled program, and cannot be reduced to a compile_dag_rust_emit_check assertion without inventing a second v1-internal-state-reading surface this triage was not chartered to build. v1_annotation_erasure_test.dag's own erasure claim (prose does not leak into emitted output) is separately and already covered black-box by the migrated annotation_erasure_emission_witness_test.dag above — that file migrates v1_annotation_target_emission_test.dag, a distinct source, not this one; naming this precisely to avoid the false impression that this exact file was migrated rather than retired. v1_complexity_eviction_hazard_test.dag — retired with a live-defect note, not a clean retirement, structured as an explicit DESIGN §4b(3) declared bounded rung-drop rather than left as prose implying it: it documents a real fail-open in v1.compiler.complexity's evict_summary/lookup_summary (a §5 absorbing-fallback shape) that is orthogonal to emitted-Rust text and therefore not compile-observable, and the defect itself remains live and unfixed by this retirement. PREVIOUS RUNG: mechanically preventable — before v1_claim_scoped_witness_batch was deleted (2026-08-15), this file's assertions executed and would have caught a regression in the eviction fail-open shape. TEMPORARY RUNG: mitigatable — the fail-open itself is unrepaired, so this class sits at the floor rung DESIGN §5 names for an absorbing fallback (a typed, located, counted diagnostic is owed but not yet built); this retirement removes only the dead witness, it does not climb or lower the underlying defect's own rung. REASON: the witness's sole execution path (v1_claim_scoped_witness_batch) is gone and RESTORE (widening the required floor to admit src/v1) was measured and ruled out repo-wide in this same triage. RE-MEASURED 2026-08-19 (gunbc#8520, CI run 32219326621): the stall does NOT reproduce -- preparation completes in ~9 minutes and refuses with 532 typed located diagnostics, none of them in src/v1. The ruling stands on a different cause (twelve last-segment module collisions between src/v1 and src/v2 breaking bare cross-module references that resolve only by pool coincidence), and the trigger is namespace-only resolution rather than any floor speedup. The single corrected measurement lives in v1_dead_witness_tree_triage_receipt_remainder; this row cites it rather than restating it. RESTORATION TRIGGER: a v1-compiler-local cargo test (v1 is semantics-frozen with active maintenance per gunbc.v1_maintenance_standing, and a local Rust-side regression test is an admitted maintenance-class change under that standing, unlike widening the required floor's source roots) — or, separately and preferably, root-causing the fail-open itself into a typed refusal per §5, which would obsolete this witness's assertions rather than merely restore them. namespace_reference_derived_closure_production_admissions_witness_test.dag — retired: white-box, matched ReferenceBindingObservation variant shapes directly rather than compile outcomes; its own fixtures were already documented in-file as illustrative-only and not satisfying the namespace-structural-observations closing contract (see below).\n\nOUT OF SCOPE, NOT A WITNESS, LEFT IN PLACE: src/v1/gunbc/namespace_reference_derived_closure_production_observations.dag is a v1 PRODUCTION module (four ReferenceBindingObservation producers for the namespace-reference-derived-closure clauses a-d), not a test file, so it is outside this triage's 17-file population. Its only historical test consumer was the retired namespace_reference_derived_closure_production_admissions_witness_test.dag above, so it currently has zero executing consumers and zero test coverage — but it is not dead code: gunbc.roadmap_authority's namespace_reference_derived_closure_execution_contract (an open WorkItemExecutionContract, enrolled QuarantineProbeExpectRed) names 'the gated node' supplying production observations for clauses a-d as the precondition for that contract to green, and this module's namespace_structural_binding_observations_a_through_d export is the designated future producer for exactly that seam. Retiring it would delete a still-claimed future authority, not dead scaffolding; it is left in place with this receipt recording its coverage gap rather than silently carrying it.\n\nRECEIPT COMPLETENESS: undispositioned files = 0 among the 12 handled directly here; retired files' evidence is deleted with them (no discriminating claim survives that a compile-observable check could re-prove); migrated files' evidence is the new dag/test/claim files enumerated above, executing under ordinary per-PR discovery. witness_fold_src_v1_coverage_gap_note's dissolve-on ('the boundary decision on these 15 files... RELOCATION into the dag test root rather than widening the root set') is satisfied by this receipt for the population it could reach; that note is retained rather than deleted because it is still the correct historical account of why the gap existed and how the fold's subject is bounded, and because the 5-file concurrent-batch population is disposed under a separate session-local record this row does not restate."

data v1_dead_witness_tree_triage_receipt_remainder: String = "DISCHARGES the remainder of v1_dead_witness_tree_triage_receipt's routed-elsewhere concurrent-batch population (dashboard node adhoc-9b80ec49-d63, session zesty-newt-828, 2026-08-19) for 4 of the 5 files that receipt named but declined to narrate: occurrence_binding_parser_walk_witness_test.dag, occurrence_identity_debt_receipt_test.dag, pattern_binder_declaration_node_test.dag, v1_match_pattern_identity_test.dag. The 5th named file, checkpoint_identity_keying_witness_test.dag, is explicitly OUT OF SCOPE for this row — a sibling session (stern-fox-619) migrates it atomically in its own PR and this receipt does not touch it. All 4 files here share the same root cause as the 12-file receipt above: their only historical consumer, v1_claim_scoped_witness_batch, was deleted 2026-08-15, so none of their assertions had executed since. RESTORE (widening the required floor's source roots to include src/v1) is RULED OUT, and the REASON WAS RE-MEASURED 2026-08-19 because the original one no longer holds. ORIGINAL RECEIPT, retained as the record of what was true then: claim_executor --required-floor with --source-root src/v1 added stalled 8+ minutes in strict-preparation, RSS plateaued ~7.2GB, zero phase progress, killed. THAT NO LONGER REPRODUCES. Re-run on gunbc#8520 (CI run 32219326621, srv1-04, floor step 05:27:35Z-05:36:41Z): preparation ran to COMPLETION in ~9 minutes, no stall, no kill, and refused with 532 typed located diagnostics across 120 files. The performance objection is stale -- preparation cost fell out from under it the night before, when gunbc#8465 unblocked the prepare_grammar memo for every language and gunbc#8487 replaced 38 left-corner closures with one converging relation (measured: first row of a parse-bearing module 10890ms -> 1106ms). THE REAL BLOCKER IS NAME RESOLUTION, NOT COST, and it is sharper than the old receipt could see. ZERO of the 532 diagnostics are in src/v1: 525 are in src/v2 and 7 in dag/test. src/v1 and src/v2 share NO exact module path, but their module paths collide on the LAST SEGMENT in twelve places -- artifact, coercion, common, compile, complexity, emit, infer, normalize, ownership, parse, resolve, tokenize. Files carrying BARE cross-module references (v2.compiler.program_assembly calls tokenize at line 28 with no import for it) resolve today only by pool-membership coincidence; adding src/v1 supplies a second module whose last segment matches and the reference stops resolving. That is the Class B failure DESIGN's import-strip cascade thread already names, reached from the opposite direction. DISSOLVE-ON: this ruling is reconsidered when bare cross-module references bind by containment rather than by pool coincidence -- the namespace-only resolution lane -- NOT when the floor gets faster. Consequence to state plainly rather than leave implicit: src/v1's .dag sources therefore have NO per-PR gate on their source validity, since compile-clean was deleted with the floor cut and regen is red by construction, and a parse error inside src/v1 is invisible to CI until that lane lands (gunbc#8519 is the specimen that proved it).\n\nDISPOSITION, MIGRATED (partial — see dag/test/claim/match_arm_pattern_identity_emission_witness_test.dag's own migration note for the full accounting): v1_match_pattern_identity_test.dag. 2 of its 4 assertions (distinct-literal-pattern and distinct-variant-name fingerprint distinctness) migrate onto compile_dag_rust_emit_check as a black-box 'every arm's marker string survives, distinctly, to emitted Rust text' check. This is a genuine emitter-behaviour defect class, not merely v1-internal bookkeeping: the file's own note documents that Node.match_pattern was once missing from both v1 identity readers (dag_collect_support.dag_node_surface_fingerprint_rec, the content fingerprint used by compile.dag's DAG artifact node table, and dag_collect.dag_collect_node_tree, the DAG artifact collector), so two match arms differing only by pattern could silently alias to one cache identity and the second arm's body would be dropped or duplicated in emitted output — exactly what the migrated black-box check would catch. Grep confirmed dag_node_surface_fingerprint has zero consumers anywhere outside src/v1, so no wider corpus-side coverage already existed for this defect class; DESIGN.md's own still-open '§3 convergence thread — fnv1a64 dual surface' note tracks the underlying dual-representation defect (dag_node_surface_fingerprint_rec calling raw v1 intrinsics rather than std.content_hash) as unresolved, so this migration is consistent with, not superseding, that open thread. The remaining 2 assertions (w_variant_pattern_field_bindings_are_registered_as_dag_artifacts, w_unrelated_field_binding_is_not_registered) retire in-file within the new witness's own migration note: they test dag_collect_insert_slots/dag_node_key directly against a hand-built Node, asserting DAG-artifact-TABLE registration/membership — bookkeeping with no representation in a single compiled program's emitted text, since compile_dag_rust_emit_check observes one compile's output rather than the incremental artifact table's contents. Restoration path if that registration surface needs live regression coverage again: a v1-compiler-local cargo test, an admitted maintenance-class change under gunbc.v1_maintenance_standing's active-maintenance arm.\n\nDISPOSITION, RETIRED (white-box, no compile-observable proxy for the same claim; deleted with this receipt as the record): occurrence_binding_parser_walk_witness_test.dag — its own in-file governed-placement note already states dag/test/claim is structurally invalid as this file's home ('ordinary discovery resolves against witness_layer_roots = [dag, src/v2], where v1.compiler imports cannot resolve'), because its whole subject is proving the REAL v1 parser (v1.compiler.parse via v1.gunbc.occurrence_binding_parser_walk) feeds correctly into std.occurrence_binding_candidates's structural-candidate resolution — an internal OccurrenceTransport/candidate-index fact, not an emitted-text fact. That underlying resolution logic (resolve_reference_binding_via_structural_candidates, occurrence_candidate_index_build, structural_binding_walk) already has independent black-box coverage via hand-built transports in dag/test/claim/occurrence_binding_candidates_witness_test.dag and dag/test/claim/occurrence_binding_resolve_witness_test.dag — confirmed by grep, both files exist and both exercise the same core functions — so retiring this file loses only the narrower 'fed by the real production parser rather than a hand-built transport' fidelity, not the underlying resolution claim. The file's own dissolve-on ('witness_layer_roots admits src/v1 for parser-transport witnesses without Node ambiguity, or execution corpus carries per-entry source roots') cannot fire given RESTORE's repo-wide non-viability, so it is retired rather than left standing per DESIGN §4b(4). occurrence_identity_debt_receipt_test.dag — same reasoning: its own in-file note (parser_reaching_witness_governed_placement_note) states plainly that dag/test/claim is invalid for it, since ordinary discovery cannot resolve its v1.compiler.tokenize / v1.compiler.parse.parse_with_table_in_occurrence_scope imports. Its four assertions (rebuilt reference identity preservation across a parse, structurally-equal-but-distinct OccurrenceIds from two parses sharing an allocator, pattern-binder reachability across 5 binder shapes, same-spelling sibling-scope isolation) are all facts about the parser's internal allocator/containment bookkeeping — frontend internal state, not compiled-program output — with no compile_dag_rust_emit_check translation without inventing a second v1-internal-state-reading surface this triage was not chartered to build, the identical reasoning the 12-file receipt above already applied to the four v1_annotation_*_test.dag retirements. pattern_binder_declaration_node_test.dag — retired whole rather than split: its own defunct-enrollment note (pattern_binder_declaration_node_parser_transport_enrollment) already names the same deleted v1_claim_scoped_witness_batch/scoped_witness_batches/ci_floor_plan machinery as its only historical execution path. Its 13 tests split into two subjects, both white-box: (a) 4 tests calling v1.compiler.parse.parse_pattern/parse_with_table directly on raw fragments to check dedicated Bind-declaration-node materialization, shorthand/declaration-role distinctness, let-initializer lexical-reference-category retention, and sequential-parse ordinal-space disjointness/preservation-under-parse-error — parser-internal AST-shape and allocator facts, not emitted-text facts; and (b) 9 w_production_frontend_* tests hand-constructing synthetic OccurrenceTransport/OccurrenceIndexEntry/DeclarationOccurrence/ReferenceOccurrence fixtures with hand-set OccurrenceIds to assert v1.compiler.compile.resolve_frontend_occurrence_transport accepts a valid transport and refuses 6 exact malformed shapes with exact typed diagnostic variants and spans — a construction-wall correctness test over a purely internal validation function's input shape, with no parser and no emission involved at all. Neither subject reduces to 'this source compiles' / 'this substring is in the emitted text'; restoration path for either, if needed again, is the same v1-compiler-local cargo test route named above.\n\nRECEIPT COMPLETENESS: undispositioned files = 0 among these 4; migrated file's evidence is dag/test/claim/match_arm_pattern_identity_emission_witness_test.dag, executing under ordinary per-PR discovery; retired files' evidence is deleted with them, since no discriminating claim among them survives that a compile-observable check could re-prove without inventing new v1-internal-state-reading machinery this triage was not chartered to build. Together with v1_dead_witness_tree_triage_receipt above (12 files) and stern-fox-619's separate T7 PR (checkpoint_identity_keying_witness_test.dag), this receipt closes out the full 17-file population witness_fold_src_v1_coverage_gap_note originally measured (adjusted for branch drift, per that receipt's own count correction)."

data v1_dead_witness_tree_triage_receipt_emitter_ambiguous_variant_owner: String = "DISCHARGES a gap left by v1_dead_witness_tree_triage_receipt above: the commit that deleted this triage's 17-file population (dashboard node adhoc-9b80ec49-d63, session zesty-newt-828, 2026-08-19) also deleted src/v1/tests/claim/emitter_ambiguous_variant_owner_witness_test.dag, which the receipt did not name and for which no disposition existed anywhere in the tree until this row. Recovered from git history: the file was enrolled by commit b0dd1145ef (2026-08-17, 'Restore the witness, properly enrolled'), which claimed all four of its rows passed under v1_claim_scoped_witness_batch at that time; that machinery is the same population-wide dead consumer this entire triage responds to, and grep over the current dag/ and src/ trees confirms v1_claim_scoped_witness_batch exists nowhere as live code today, only as historical prose in other files' migration notes and in the two receipts above.\n\nWHAT THE FILE PROTECTED: a PERMANENT REGRESSION CONTROL, in its own words, for a real fixed emitter defect. v1.compiler.emit_info's derive_variant_to_enum folds a closure's type summaries into a variant-name -> owning-enum map and inserts the empty string when two enums in that closure claim one variant name, using the empty string as a third state (Ambiguous) a Map<String,String> cannot name. is_value_variant_type_arg read that map with map_contains_key, which cannot see the value, so an ambiguously-owned name tested positive as an unambiguous value-variant and the emitter collapsed the type argument to unit -- fabricated plausible output exactly where the emitter could not know the answer. This was fixed and merged as PR #8345 ('Emitter: honor the variant-owner ambiguity sentinel instead of collapsing to unit', commit a9d12c249f, merged 2026-08-17). Confirmed via grep against current production code that the fix is intact: is_value_variant_type_arg is defined at src/v1/stage0/src/v1_compiler_emit_rust.rs:1423 with live call sites at lines 1479, 1493, 4753. Only the regression witness for it, not the fix itself, is being lost by this deletion.\n\nWHY MIGRATION IS UNREACHABLE, NOT MERELY AWKWARD, PER §4b'S DISTINCTION: the file's own note already makes this argument and it is reproduced here rather than re-derived, because it does not weaken with restating. The compiler already refuses two enums claiming one variant name inside a single module, so the ambiguous state the sentinel guards against is only constructible ACROSS modules in one compiled closure. compile_dag_rust_emit_check compiles exactly one synthetic source string, so a single-source fixture has no second module to construct the collision with -- the subject this witness needs cannot be built through that surface at all, not merely inconveniently. This is the same class DESIGN.md's §3 replacement-migration guidance calls Y-incomplete against a maximal-cut attempt: the wall is real, and the fix is upstream (a multi-module compile_dag_rust_emit_check, or a dedicated multi-source compile surface), not a per-file workaround.\n\nDISPOSITION: RETIRED, as an explicit DESIGN §4b(3) declared bounded rung-drop, four fields named:\n  PREVIOUS RUNG: mechanically preventable. Per commit b0dd1145ef's own claim, all four rows executed and passed under v1_claim_scoped_witness_batch as of 2026-08-17 -- a live, enrolled, executing regression witness reliably exposing the collapse-to-unit defect class were it to recur.\n  TEMPORARY RUNG: mitigatable. The underlying fix (is_value_variant_type_arg's explicit non-empty-string check, matching the six other consumers of that map that already guarded it) remains intact in current production code, confirmed above by grep; only the automated regression check is gone, so a recurrence would rely on code review and the DESIGN §5 fail-closed discipline rather than an executing witness.\n\n  This is a below-baseline safety regression on this narrow subject, not compensated by anything else in the corpus -- named honestly rather than left implicit.\n  REASON: the witness's only historical execution path, v1_claim_scoped_witness_batch, was already deleted from the tree (2026-08-15, per the other receipts in this file) before this triage began, and RESTORE (widening the required floor's source roots to admit src/v1) was separately measured and conclusively ruled out for the whole src/v1 population in this same triage. RE-MEASURED 2026-08-19 (gunbc#8520, CI run 32219326621): the stall does NOT reproduce -- preparation completes in ~9 minutes and refuses with 532 typed located diagnostics, none of them in src/v1. The ruling stands on a different cause (twelve last-segment module collisions between src/v1 and src/v2 breaking bare cross-module references that resolve only by pool coincidence), and the trigger is namespace-only resolution rather than any floor speedup. The single corrected measurement lives in v1_dead_witness_tree_triage_receipt_remainder; this row cites it rather than restating it. ORIGINAL MEASUREMENT, retained as the record of what was true then: (claim_executor --required-floor with --source-root src/v1 added stalled 8+ minutes in strict-preparation, RSS plateaued ~7.2GB, zero phase progress, killed -- corroborated independently by smart-ram-730 via CI run 32196317824 on a dedicated srv4 runner, which measured the ordinary floor without src/v1 already costing ~7.0GB / 9 minutes in strict-preparation, so adding src/v1 pushes a already-expensive phase past its practical ceiling rather than adding a cheap increment). No third route existed within this triage's charter to build a multi-module-aware version of compile_dag_rust_emit_check.\n  RESTORATION TRIGGER: either (a) compile_dag_rust_emit_check, or a sibling builtin, gains the ability to compile a closure of multiple named .dag sources as one subject, at which point the ambiguous-owner-across-modules scenario becomes constructible from dag/test/claim and this witness's four assertions migrate directly using the same owner_map fixture already recovered above; or, sooner and independent of that, (b) a v1-compiler-local cargo test re-asserting the four rows against is_value_variant_type_arg directly -- an admitted maintenance-class restoration under gunbc.v1_maintenance_standing's active-maintenance arm, the same route already named for this triage's other v1-internal-state retirements (v1_complexity_eviction_hazard_test.dag, occurrence_identity_debt_receipt_test.dag, pattern_binder_declaration_node_test.dag's two subjects).\n\nEVIDENCE: the file's four assertions (ambiguous_owner_is_not_a_value_variant, sole_owner_is_a_value_variant covering two independently-owned names, unknown_name_is_not_a_value_variant, generic_param_shadows_a_sole_owner) and its full owner_map fixture are preserved verbatim in this receipt's own recovery record (git show 11113ac9e9^:src/v1/tests/claim/emitter_ambiguous_variant_owner_witness_test.dag) rather than only in git history, so restoration trigger (b) does not require archaeology to execute. Undispositioned files after this row = 0; the emitter_ambiguous_variant_owner_witness_test.dag gap named in parent session smart-ram-730's review is closed."

data excl_no_fake_anomalies_reason: String = "The expectation-backfill WALL spawns claim_batch as a child process to read a passing corpus's own stderr, so it is Wet BY CONSTRUCTION — its whole subject is what the observation layer prints, which only exists when the effects really run. The Hermetic discovery corpus refuses it exactly as install_media_real_execution_wet_note describes ('no mock_response for operation Run — refusing to fabricate Unit'), and that refusal is correct: a mocked child emits no real observation stream, so a hermetic version of this witness could only ever pass vacuously. Landed into hermetic discovery by filename convention on first authoring (run 30178544618 @ b2411f0, batch 3) and re-homed to BinWitnessWet; then D6-rehomed to FalsifierRehomedBinWet (run 30220304152: ~85–90s/row vs bin_witness_wet_per_row_wall_budget_seconds=60, batch-4 FLOOR-BATCH-OVER-BUDGET)."

data excl_expectation_frontier_reason: String = "Reads the [expectation-frontier] receipt out of a real child run's stderr, so it is Wet BY CONSTRUCTION for the same reason the anomaly wall beside it is: the receipt only exists when effects actually dispatch, and a hermetic child emits no real observation stream, so a mocked version could only pass vacuously. Sibling mechanism, same lane, deliberately not a forked one (DESIGN §3). D6-rehomed to FalsifierRehomedBinWet with its anomaly sibling (run 30220304152: ~89–136s/row vs the 60s per-row budget)."

data excl_expectation_frontier_dissolve: DissolutionCondition = unbound_dissolution(description: "fires with the UntracedDefault arm itself: when the counted frontier reaches zero corpus-wide, an undeclared expectation becomes a hard typed refusal at the dispatch boundary, the receipt has nothing left to report, and this witness plus these rows delete together. Until then the frontier is the thing being shrunk, so the receipt that measures it must keep executing.")

data excl_no_fake_anomalies_dissolve: DissolutionCondition = unbound_dissolution(description: "paired with falsifier_rehomed_bin_wet_rows dissolve_on for the two no_fake_anomalies check_fns: re-enroll per-PR (flip this row back to BinWitnessWet) only when a measured run lands both under bin_witness_wet_per_row_wall_budget_seconds; if the wall is ever superseded by a structural lens over the effect graph (task #15's call-node admissibility), this row deletes with the witness.")

data install_media_real_execution_wet_note: String = "The four srv3_install_media_fetch_real_execution_witness_test.dag / srv3_seeded_install_media_real_execution_witness_test.dag entries at the tail of bin_witness_wet_entries below share this lane with the bin-execution witnesses (same RunnableDiscoveryBatch Wet mechanism, not a forked one - DESIGN §3) though they are not bin-execution: they drive real shell.Mktemp.Dir/Filesystem.Write/shell.Remove.RecursiveForce effects that dag/extdeps/shell/shell.dag has no mock_response for (only shell.Exec.Run/Check do), so the Hermetic discovery corpus refuses them by construction (typed 'no mock_response for operation Dir' error). Split out of their parent files (shell-to-dag B1, 2026-07-14) so the parent files' pure classification witnesses keep hermetic per-PR discovery undiminished. Dissolve-on: shell.dag's file-effect operations gain mock_response coverage AND these fns' assertions are re-checked for correctness under a fixed mock (some assert behavior-dependent outcomes, e.g. matched == false on a wrong hash, which a naive fixed mock would falsify) - then they re-enroll as ordinary hermetic discovery rows and these rows delete."

