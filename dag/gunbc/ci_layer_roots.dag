module gunbc.ci_layer_roots

import std.realization_schedule { ScheduleWitnessEntry, ExecutionWitnessKind, CorpusWitnessKind }
import gunbc.cli_invoke {
  source_roots_shell_flags,
  SourceRootBare,
  SourceRootRooted
}
import std.witness_admission {
  WitnessConsumerCadence,
  DiscoverySelection,
  FalsifierSelfHostWet,
  FalsifierRehomedBinWet,
  BinWitnessWet,
  QuarantineProbeExpectRed,
  OfflineLocalRecipe,
  FixtureExplicitRoster,
  NoConsumer
}

data witness_layer_roots: List<String> = ["dag", "src/v2"]

fn compile_clean_source_roots() -> List<String> {
  concat(witness_layer_roots, ["src/v1"])
}

data witness_discovery_scan_dirs: List<String> = ["dag/test/claim", "src/v2/test/claim/manual", "src/v2/test/claim/emit"]

type WitnessExclusionRow {
  pattern: String
  classification: WitnessConsumerCadence
  reason: String
  dissolve_on: String
}

data excl_bin_wet_reason: String = "bin-execution witness class: fns run compiled seed witness binaries (host effects on non-commit-deterministic inputs) the hermetic envelope refuses by construction; they run every PR as the declared bin-witness wet batch via bin_witness_wet_entries (bin_witness_wet_note)"

data excl_bin_wet_dissolve: String = "the file migrates under the execution-corpus scope prefix and enrolls as ExecutionWitnessKind rows in gunbc.commit_workflow; then this row and the roster entries delete (bin_witness_wet_note)"

data excl_rehomed_bin_wet_reason: String = "bin-execution witness class re-homed to the falsifier wet cadence (CI floor endgame D6): the file's enrolled fn(s) exceed bin_witness_wet_per_row_wall_budget_seconds, so they run as falsifier batch 5 via falsifier_rehomed_bin_wet_entries (typed frontier rows in falsifier_rehomed_bin_wet_rows)"

data excl_rehomed_bin_wet_dissolve: String = "per falsifier_rehomed_bin_wet_rows dissolve_on: the row's realization lands under the per-row budget on a measured run and re-enrolls per-PR (or deletes as a duplicate); then this classification flips back to BinWitnessWet"

data excl_behavioral_receipt_reason: String = "emit->compile->run->equals-seed self-host behavioral receipt class: enrolled fns run on the falsifier nightly Wet cadence (wet_receipt_enrollment / falsifier_self_host_wet_note); non-enrolled fns run by local recipe"

data excl_behavioral_receipt_dissolve: String = "per-module receipts graduate to per-PR admission when proven cheap enough (falsifier_self_host_wet_note); row deletes"

data excl_wet_integration_reason: String = "wet-integration class, operator-ruled OFFLINE (hermetic-floor posture 2026-07-11): performs genuinely live host effects the hermetic envelope refuses by construction (wet_integration_offline_note)"

data excl_wet_integration_dissolve: String = "the scheduled (nightly) lane un-darkens and admits wet integration rows under its own budget; then the file enrolls there as declared execution rows and this row deletes (wet_integration_offline_note)"

data excl_probe_universe_carrier_reason: String = "non-witness workflow carrier: discovery never scans it (not a *_test.dag); the row exists for the whole_tree_resolve_exclusion_substrings probe-universe consumers"

data excl_probe_universe_carrier_dissolve: String = "the probe universe derives from module identity (module-identity-storage-binding lane) or the carrier relocates; a row that excludes nothing deletes"

data excl_roster_gate_dissolve: String = "resolved-graph memoization receipts land AND G2 path-intersection (not G1 module-closure alone) is wired into floor admission axis (iv); then re-enroll consciously through the floor owner's lane"

data excl_predates_per_row_reason: String = "operator/lane-ruled discovery exclusion predating per-row reasons; Phase 0(b) admission classifies its witnesses OfflineLocalRecipe (local recipe: claim_batch --source-root dag --source-root src/v2 --entry <file> --functions <csv>)"

data excl_predates_per_row_dissolve: String = "the owning lane records a scheduled consumer for the file, or the row proves dead (excludes nothing) and deletes"

data excl_install_media_reason: String = "real host-effect execution witness (shell effects with no mock_response coverage, or real network/build effects) refused by the hermetic envelope; runs in the bin-witness wet lane (install_media_real_execution_wet_note)"

data excl_install_media_dissolve: String = "mock_response coverage lands and assertions are re-checked under a fixed mock; then the fns re-enroll as ordinary hermetic discovery rows and this row deletes (install_media_real_execution_wet_note)"

