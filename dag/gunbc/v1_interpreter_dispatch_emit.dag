module gunbc.v1_interpreter_dispatch_emit


fn escape_rust_string_literal_body(s: String) -> String {
  replace(replace(replace(s, "\\", "\\\\"), "\"", "\\\""), "\n", "\\n")
}

fn to_upper_char(ch: Int) -> String {
  let cp = ch
  if cp >= 97 && cp <= 122 {
    from_code_point(cp: cp - 32)
  } else {
    from_code_point(cp: ch)
  }
}

fn capitalize_first(s: String) -> String {
  let chars_list = s |> chars
  if count(chars_list) == 0 {
    ""
  } else {
    chars_list
      |> enumerate
      |> map(pair =>
        if pair.first == 0 {
          gunbc.v1_interpreter_dispatch_emit.to_upper_char(ch: pair.second)
        } else {
          from_code_point(cp: pair.second)
        })
      |> join(separator: "")
  }
}

fn to_pascal_segment(segment: String) -> String {
  segment
    |> split(delimiter: "_")
    |> map(part => gunbc.v1_interpreter_dispatch_emit.capitalize_first(s: part))
    |> join(separator: "")
}

fn arm_identity_to_rust_variant(identity: String) -> String {
  identity
    |> split(delimiter: ".")
    |> map(segment => to_pascal_segment(segment: segment))
    |> join(separator: "")
}

data module_domain_prefix_note: String = "Every EvalCallBridgeFamilySite.module is REQUIRED to be dotted under the v2. namespace (v2.std.node, v2.std.data_index, ...); module_domain_prefix_ok checks that structurally rather than assuming it from what the roster happens to contain today (operator correction, PR 7801, 2026-08-04 — the prior note recorded an observation about the live roster, not a requirement, so a later non-v2 bridge family would have silently lost its domain segment through an unconditional drop). module_pascal_after_domain_prefix/module_slug_after_domain_prefix drop that leading segment before naming the per-family generated enum/lookup/macro, mirroring arm_identity_to_rust_variant's own dot-segment PascalCase fold — one algorithm, read twice — but only after the domain segment is confirmed to be the one being dropped."

fn expected_bridge_family_domain_segment() -> String {
  "v2"
}

fn drop_first_segment(segments: List<String>) -> List<String> {
  segments
    |> enumerate
    |> filter(pair => pair.first != 0)
    |> map(pair => pair.second)
}

fn module_domain_segments(module: v2.std.qualified_name.QualifiedName) -> List<String> {
  v2.std.qualified_name.qualified_name_to_dotted_string(qn: module) |> split(delimiter: ".")
}

fn module_domain_prefix_ok(module: v2.std.qualified_name.QualifiedName) -> Bool {
  match module_domain_segments(module: module) |> first {
    v2.std.optional.Present { value: head } => head == expected_bridge_family_domain_segment()
    v2.std.optional.Absent => false
  }
}

fn module_pascal_after_domain_prefix(module: v2.std.qualified_name.QualifiedName) -> String {
  drop_first_segment(segments: module_domain_segments(module: module))
    |> map(segment => to_pascal_segment(segment: segment))
    |> join(separator: "")
}

fn module_slug_after_domain_prefix(module: v2.std.qualified_name.QualifiedName) -> String {
  drop_first_segment(segments: module_domain_segments(module: module))
    |> join(separator: "_")
}

fn dispatch_emit_site_key(site: gunbc.v1_interpreter_primitive_surface.InterpreterDispatchEmitSite) -> String {
  match site {
    EvalBuiltinInnerSite => "eval_builtin_inner"
    EvalAlgebraMethodInnerSite => "eval_algebra_method_inner"
    EvalCallBridgeFamilySite { module } => concat("eval_call_bridge::", v2.std.qualified_name.qualified_name_to_dotted_string(qn: module))
    EvalCallNativeInterceptSite => "eval_call_native_intercept"
    TryV2StdCollectionMapPrimitiveGroundingSite => "try_v2_std_collection_map_primitive_grounding"
    TryParseTableMemoDispatchSite => "try_parse_table_memo_dispatch"
    EvalMethodCallShortCircuitSite => "eval_method_call_short_circuit"
    EvalServiceCallCarveOutSite => "eval_service_call_carve_out"
  }
}

fn roster_site_key(row: gunbc.v1_interpreter_primitive_surface.InterpreterPrimitiveDispatchArm) -> String {
  dispatch_emit_site_key(site: row.dispatch_emit_site)
}

fn emittable_dispatch_emit_sites(rows: List<gunbc.v1_interpreter_primitive_surface.InterpreterPrimitiveDispatchArm>) -> List<gunbc.v1_interpreter_primitive_surface.InterpreterDispatchEmitSite> {
  rows |> map(r => r.dispatch_emit_site)
}

fn distinct_strings(xs: List<String>) -> List<String> {
  xs |> fold(init: [], f: (acc, x) => if acc |> any(y => y == x) { acc } else { acc |> concat([x]) })
}

fn distinct_identities(rows: List<gunbc.v1_interpreter_primitive_surface.InterpreterPrimitiveDispatchArm>) -> List<String> {
  gunbc.v1_interpreter_dispatch_emit.distinct_strings(xs: rows |> map(r => concat(r.arm.identity, "")))
}

fn distinct_spellings(rows: List<gunbc.v1_interpreter_primitive_surface.InterpreterPrimitiveDispatchArm>) -> List<String> {
  gunbc.v1_interpreter_dispatch_emit.distinct_strings(xs: rows |> map(r => concat(r.authored_spelling, "")))
}

fn rust_variant_for_row(row: gunbc.v1_interpreter_primitive_surface.InterpreterPrimitiveDispatchArm) -> String {
  arm_identity_to_rust_variant(identity: concat(row.arm.identity, ""))
}

fn distinct_rust_variants(rows: List<gunbc.v1_interpreter_primitive_surface.InterpreterPrimitiveDispatchArm>) -> List<String> {
  gunbc.v1_interpreter_dispatch_emit.distinct_strings(xs: rows |> map(r => rust_variant_for_row(row: r)))
}

fn known_dispatch_emit_site_keys(rows: List<gunbc.v1_interpreter_primitive_surface.InterpreterPrimitiveDispatchArm>) -> List<String> {
  gunbc.v1_interpreter_dispatch_emit.distinct_strings(xs: rows |> map(r => roster_site_key(row: r)))
}

fn dispatch_emit_site_key_is_emittable(rows: List<gunbc.v1_interpreter_primitive_surface.InterpreterPrimitiveDispatchArm>, site_key: String) -> Bool {
  known_dispatch_emit_site_keys(rows: rows) |> any(k => k == site_key)
}

fn filter_roster_site(rows: List<gunbc.v1_interpreter_primitive_surface.InterpreterPrimitiveDispatchArm>, site_key: String) -> List<gunbc.v1_interpreter_primitive_surface.InterpreterPrimitiveDispatchArm> {
  rows |> filter(r => roster_site_key(row: r) == site_key)
}

fn site_has_rust_variant_collision(site_rows: List<gunbc.v1_interpreter_primitive_surface.InterpreterPrimitiveDispatchArm>) -> Bool {
  count(distinct_identities(rows: site_rows)) != count(distinct_rust_variants(rows: site_rows))
}

fn roster_site_has_rust_variant_collision(site_key: String, rows: List<gunbc.v1_interpreter_primitive_surface.InterpreterPrimitiveDispatchArm>) -> Bool {
  site_has_rust_variant_collision(site_rows: filter_roster_site(rows: rows, site_key: site_key))
}

fn any_roster_site_has_rust_variant_collision(rows: List<gunbc.v1_interpreter_primitive_surface.InterpreterPrimitiveDispatchArm>) -> Bool {
  known_dispatch_emit_site_keys(rows: rows)
    |> any(site_key => roster_site_has_rust_variant_collision(site_key: site_key, rows: rows))
}

fn rust_variant_collision_synthetic_red_control() -> Bool {
  arm_identity_to_rust_variant(identity: "synthetic.one_two") == arm_identity_to_rust_variant(identity: "synthetic.one.two")
    && !("synthetic.one_two" == "synthetic.one.two")
}

data spelling_collision_note: String = "A ROSTER ROW SPELLING COLLIDES ONLY WITHIN ITS OWN DISPATCH SITE. Two distinct arm identities at one site sharing one authored_spelling would emit two identical match-arm string literals into that site's generated lookup_* function -- Rust's own unreachable-pattern lint would flag it, but a lint is advisory, not a modeled refusal, so generation refuses first. Cross-site reuse of the same spelling is legitimate and already witnessed (lookup is dispatched both by the eval_method_call short-circuit and by the algebra arm it shadows) -- the check is scoped per site, never across the whole roster."

fn rows_with_spelling(site_rows: List<gunbc.v1_interpreter_primitive_surface.InterpreterPrimitiveDispatchArm>, spelling: String) -> List<gunbc.v1_interpreter_primitive_surface.InterpreterPrimitiveDispatchArm> {
  site_rows |> filter(r => r.authored_spelling == spelling)
}

fn site_has_spelling_collision(site_rows: List<gunbc.v1_interpreter_primitive_surface.InterpreterPrimitiveDispatchArm>) -> Bool {
  distinct_spellings(rows: site_rows)
    |> any(spelling => count(distinct_identities(rows: rows_with_spelling(site_rows: site_rows, spelling: spelling))) > 1)
}

fn roster_site_has_spelling_collision(site_key: String, rows: List<gunbc.v1_interpreter_primitive_surface.InterpreterPrimitiveDispatchArm>) -> Bool {
  site_has_spelling_collision(site_rows: filter_roster_site(rows: rows, site_key: site_key))
}

fn any_roster_site_has_spelling_collision(rows: List<gunbc.v1_interpreter_primitive_surface.InterpreterPrimitiveDispatchArm>) -> Bool {
  known_dispatch_emit_site_keys(rows: rows)
    |> any(site_key => roster_site_has_spelling_collision(site_key: site_key, rows: rows))
}

fn spelling_collision_synthetic_red_control() -> Bool {
  let rows = [
    gunbc.v1_interpreter_primitive_surface.InterpreterPrimitiveDispatchArm {
      arm: gunbc.v1_interpreter_primitive_surface.InterpreterPrimitiveArmId { identity: "synthetic.arm_one" },
      form: gunbc.v1_interpreter_primitive_surface.FreeCall,
      authored_spelling: "shared_spelling",
      realization_module: "v1_interpreter",
      dispatch_symbol: "eval_builtin_inner",
      dispatch_emit_site: EvalBuiltinInnerSite,
      enumeration: AuthoredInRoster,
    },
    gunbc.v1_interpreter_primitive_surface.InterpreterPrimitiveDispatchArm {
      arm: gunbc.v1_interpreter_primitive_surface.InterpreterPrimitiveArmId { identity: "synthetic.arm_two" },
      form: gunbc.v1_interpreter_primitive_surface.FreeCall,
      authored_spelling: "shared_spelling",
      realization_module: "v1_interpreter",
      dispatch_symbol: "eval_builtin_inner",
      dispatch_emit_site: EvalBuiltinInnerSite,
      enumeration: AuthoredInRoster,
    },
  ]
  any_roster_site_has_spelling_collision(rows: rows)
}

fn site_enum_name(site: gunbc.v1_interpreter_primitive_surface.InterpreterDispatchEmitSite) -> String {
  match site {
    EvalBuiltinInnerSite => "EvalBuiltinArm"
    EvalAlgebraMethodInnerSite => "EvalAlgebraMethodArm"
    EvalCallBridgeFamilySite { module } => concat("EvalCallBridge", concat(module_pascal_after_domain_prefix(module: module), "Arm"))
    EvalCallNativeInterceptSite => "EvalCallNativeInterceptArm"
    TryV2StdCollectionMapPrimitiveGroundingSite => "TryV2StdCollectionMapPrimitiveGroundingArm"
    TryParseTableMemoDispatchSite => "TryParseTableMemoDispatchArm"
    EvalMethodCallShortCircuitSite => "EvalMethodCallShortCircuitArm"
    EvalServiceCallCarveOutSite => "EvalServiceCallCarveOutArm"
  }
}

fn site_lookup_name(site: gunbc.v1_interpreter_primitive_surface.InterpreterDispatchEmitSite) -> String {
  match site {
    EvalBuiltinInnerSite => "lookup_eval_builtin_inner"
    EvalAlgebraMethodInnerSite => "lookup_eval_algebra_method_inner"
    EvalCallBridgeFamilySite { module } => concat("lookup_eval_call_bridge_", module_slug_after_domain_prefix(module: module))
    EvalCallNativeInterceptSite => "lookup_eval_call_native_intercept"
    TryV2StdCollectionMapPrimitiveGroundingSite => "lookup_try_v2_std_collection_map_primitive_grounding"
    TryParseTableMemoDispatchSite => "lookup_try_parse_table_memo_dispatch"
    EvalMethodCallShortCircuitSite => "lookup_eval_method_call_short_circuit"
    EvalServiceCallCarveOutSite => "lookup_eval_service_call_carve_out"
  }
}

fn render_lookup_match_rows(rows: List<gunbc.v1_interpreter_primitive_surface.InterpreterPrimitiveDispatchArm>, enum_name: String) -> String {
  v2.std.algebra.fold_list(rows, empty: "", cons: fn(acc, row) {
    let escaped = gunbc.v1_interpreter_dispatch_emit.escape_rust_string_literal_body(s: concat(row.authored_spelling, ""))
    let variant = rust_variant_for_row(row: row)
    let line = concat(
      "        \"",
      escaped,
      "\" => Some(",
      enum_name,
      "::",
      variant,
      "),"
    )
    if acc == "" {
      line
    } else {
      concat(acc, concat("\n", line))
    }
  })
}

fn qualified_enum_variant(enum_name: String, variant: String) -> String {
  concat(
    "$crate::v1_interpreter_dispatch_generated::",
    enum_name,
    "::",
    variant
  )
}

fn render_identity_arm_rows(rows: List<gunbc.v1_interpreter_primitive_surface.InterpreterPrimitiveDispatchArm>, enum_name: String) -> String {
  let identities = distinct_identities(rows: rows)
  v2.std.algebra.fold_list(identities, empty: "", cons: fn(acc, identity) {
    let variant = arm_identity_to_rust_variant(identity: identity)
    let line = concat(
      "    (\"",
      gunbc.v1_interpreter_dispatch_emit.escape_rust_string_literal_body(s: identity),
      "\") => { ",
      qualified_enum_variant(enum_name: enum_name, variant: variant),
      " };"
    )
    if acc == "" {
      line
    } else {
      concat(acc, concat("\n", line))
    }
  })
}

fn render_enum_variants(variants: List<String>) -> String {
  v2.std.algebra.fold_list(variants, empty: "", cons: fn(acc, variant) {
    let line = concat("    ", variant, ",")
    if acc == "" {
      line
    } else {
      concat(acc, concat("\n", line))
    }
  })
}

fn render_site_block(site: gunbc.v1_interpreter_primitive_surface.InterpreterDispatchEmitSite, rows: List<gunbc.v1_interpreter_primitive_surface.InterpreterPrimitiveDispatchArm>) -> String {
  let enum_name = site_enum_name(site: site)
  let lookup_name = site_lookup_name(site: site)
  let site_key = dispatch_emit_site_key(site: site)
  let site_rows = filter_roster_site(rows: rows, site_key: site_key)
  let variants = distinct_rust_variants(rows: site_rows)
  let macro_name = concat(site_key, "_arm") |> replace(old: ".", new: "_") |> replace(old: ":", new: "_")
  concat(
    "#[rustfmt::skip]\n",
    "#[derive(Copy, Clone, Debug, PartialEq, Eq)]\n",
    "pub enum ",
    enum_name,
    " {\n",
    render_enum_variants(variants: variants),
    "\n}\n\n",
    "#[rustfmt::skip]\n",
    "pub fn ",
    lookup_name,
    "(spelling: &str) -> Option<",
    enum_name,
    "> {\n",
    "    match spelling {\n",
    render_lookup_match_rows(rows: site_rows, enum_name: enum_name),
    "\n        _ => None,\n",
    "    }\n",
    "}\n\n",
    "#[rustfmt::skip]\n",
    "macro_rules! ",
    macro_name,
    " {\n",
    render_identity_arm_rows(rows: site_rows, enum_name: enum_name),
    "\n}\n"
  )
}

data distinct_dispatch_sites_note: String = "distinct_dispatch_sites keeps the typed InterpreterDispatchEmitSite carried by each row all the way through grouping -- it never drops to a String key and searches back for the site that produced it. The prior site_for_key/distinct_sites pairing did exactly that (known_dispatch_emit_site_keys() -> site_for_key() re-lookup), and its Absent arm papered over a lookup that structurally cannot fail (every key came from the very rows being searched) by silently returning EvalBuiltinInnerSite -- an absorbing fallback sitting inside the mechanism this closeout removes fallbacks from (operator finding, PR 7801, 2026-08-04). Deduplication still needs a comparable key (dispatch_emit_site_key), but the key is used only to test membership, never to recover a value -- the site itself always comes from the row's own dispatch_emit_site field."

fn distinct_dispatch_sites(rows: List<gunbc.v1_interpreter_primitive_surface.InterpreterPrimitiveDispatchArm>) -> List<gunbc.v1_interpreter_primitive_surface.InterpreterDispatchEmitSite> {
  rows
    |> fold(init: [], f: (acc, row) =>
      if acc |> any(s => dispatch_emit_site_key(site: s) == roster_site_key(row: row)) {
        acc
      } else {
        acc |> concat([row.dispatch_emit_site])
      })
}

type V1InterpreterDispatchEmitOutcome
  = V1InterpreterDispatchGenerated { content: String }
  | V1InterpreterDispatchGenerationRefused { reason: String }

fn render_dispatch_generated_rs(rows: List<gunbc.v1_interpreter_primitive_surface.InterpreterPrimitiveDispatchArm>) -> String {
  let sites = distinct_dispatch_sites(rows: rows)
  concat(
    "// Generated by gunbc v1_interpreter_dispatch_emit — do not hand-edit.\n",
    "// Authority: gunbc.v1_interpreter_primitive_surface v1_interpreter_authored_roster_arms(); rust_variant derived from arm identity.\n\n",
    v2.std.algebra.fold_list(sites, empty: "", cons: fn(acc, site) {
      let block = render_site_block(site: site, rows: rows)
      if acc == "" {
        block
      } else {
        concat(acc, block)
      }
    })
  )
}

fn row_has_invalid_bridge_family_domain_prefix(row: gunbc.v1_interpreter_primitive_surface.InterpreterPrimitiveDispatchArm) -> Bool {
  match row.dispatch_emit_site {
    EvalCallBridgeFamilySite { module: bridge_module } => !module_domain_prefix_ok(module: bridge_module)
    EvalBuiltinInnerSite => false
    EvalAlgebraMethodInnerSite => false
    EvalCallNativeInterceptSite => false
    TryV2StdCollectionMapPrimitiveGroundingSite => false
    TryParseTableMemoDispatchSite => false
    EvalMethodCallShortCircuitSite => false
    EvalServiceCallCarveOutSite => false
  }
}

fn any_row_has_invalid_bridge_family_domain_prefix(rows: List<gunbc.v1_interpreter_primitive_surface.InterpreterPrimitiveDispatchArm>) -> Bool {
  rows |> any(r => row_has_invalid_bridge_family_domain_prefix(row: r))
}

fn expected_v1_interpreter_dispatch_generated_rs() -> V1InterpreterDispatchEmitOutcome {
  let rows = v1_interpreter_authored_roster_arms()
  if any_row_has_invalid_bridge_family_domain_prefix(rows: rows) {
    V1InterpreterDispatchGenerationRefused {
      reason: concat(
        "an EvalCallBridgeFamilySite.module is not dotted under the required '",
        concat(expected_bridge_family_domain_segment(), "' domain segment — module_pascal_after_domain_prefix/module_slug_after_domain_prefix would silently drop the wrong segment")
      )
    }
  } else if any_roster_site_has_rust_variant_collision(rows: rows) {
    V1InterpreterDispatchGenerationRefused {
      reason: "two distinct arm identities collapse to the same PascalCase enum variant within one dispatch emit site — arm_identity_to_rust_variant must be injective per site"
    }
  } else if any_roster_site_has_spelling_collision(rows: rows) {
    V1InterpreterDispatchGenerationRefused {
      reason: "two distinct arm identities share the same authored_spelling within one dispatch emit site — that spelling could never route to more than one of them through generated lookup"
    }
  } else {
    V1InterpreterDispatchGenerated { content: render_dispatch_generated_rs(rows: rows) }
  }
}
