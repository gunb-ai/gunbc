module gunbc.roadmap_emit



fn roadmap_max_depth() -> Int { 12 }

fn node_is_superseded(rn: gunbc.roadmap_model.RoadmapNode) -> Bool {
  !(item_superseded_by(item: rn.line) == "")
}

fn node_is_done(rn: gunbc.roadmap_model.RoadmapNode, merged: List<Int>) -> Bool {
  signoff_accepts(s: rn.signoff) || node_is_superseded(rn: rn)
}

fn node_evidence_present(rn: gunbc.roadmap_model.RoadmapNode, merged: List<Int>) -> Bool {
  item_is_done(item: rn.line, merged: merged)
}

fn signoff_suffix_inlines(rn: gunbc.roadmap_model.RoadmapNode, merged: List<Int>) -> List<std.markdown.MarkdownInline> {
  if node_is_superseded(rn: rn) {
    []
  } else {
    if signoff_accepts(s: rn.signoff) {
      [std.markdown.TextInline { text: concat(" — ✓ signed off: ", signoff_by(s: rn.signoff)) }]
    } else {
      if node_evidence_present(rn: rn, merged: merged) {
        [std.markdown.TextInline { text: " — ⏳ awaiting sign-off" }]
      } else {
        []
      }
    }
  }
}

fn pointer_inlines(p: gunbc.roadmap_model.Pointer) -> List<std.markdown.MarkdownInline> {
  [
    std.markdown.TextInline { text: " " },
    std.markdown.LinkInline { inlines: [std.markdown.TextInline { text: p.label }], url: p.path },
  ]
}

fn carriers_inlines(carriers: List<gunbc.roadmap_model.Pointer>) -> List<std.markdown.MarkdownInline> {
  fold(carriers, init: [], f: (acc, p) => concat(acc, pointer_inlines(p: p)))
}

fn refs_text(prs: List<Int>) -> String {
  fold(prs, init: "", f: (acc, p) =>
    if acc == "" { concat("#", to_string(p)) } else { concat(acc, concat("/#", to_string(p))) })
}
fn refs_inlines(prs: List<Int>) -> List<std.markdown.MarkdownInline> {
  if count(prs) == 0 { [] } else { [std.markdown.TextInline { text: concat(" (", concat(refs_text(prs: prs), ")")) }] }
}

fn desc_inlines(description: String) -> List<std.markdown.MarkdownInline> {
  if description == "" { [] } else { [std.markdown.TextInline { text: concat(" ", description) }] }
}

data why_clause_note: String = "A reader of ROADMAP.md kept asking what a row actually accomplishes, and the answer was already on the row — displaced_cost, the pain that goes away — but the markdown projection never rendered it, so only the scope sentence showed. Rendering it here is a projection fix, not a new field: the authority still states the reason exactly once. An empty reason renders nothing rather than a dangling label, so a row that has not stated its why is visibly missing it instead of quietly padded."

fn why_clause(t: gunbc.roadmap_status.TicketFields) -> String {
  if t.displaced_cost == "" { "" } else { concat(" Why: ", t.displaced_cost) }
}

fn line_inlines(line: gunbc.roadmap_status.RoadmapItem) -> List<std.markdown.MarkdownInline> {
  match line {
    DerivableLine { prs, title, description } =>
      concat(
        concat([std.markdown.TextInline { text: title }], refs_inlines(prs: prs)),
        desc_inlines(description: description),
      )
    AuthoredLine { done: _, content } => [std.markdown.TextInline { text: content }]
    PlainLine { content } => [std.markdown.TextInline { text: content }]
    SupersededLine { by, content } => [std.markdown.TextInline { text: concat(concat("~~", content), concat("~~ **superseded →** ", by)) }]
    TicketLine { done: _, ticket } =>
      [std.markdown.TextInline { text: join(["**", ticket.headline, "** — ", ticket.brief, why_clause(t: ticket)], "") }]
  }
}

fn node_is_plain(rn: gunbc.roadmap_model.RoadmapNode) -> Bool {
  match rn.line {
    PlainLine { content: _ } => true
    DerivableLine { prs: _, title: _, description: _ } => false
    AuthoredLine { done: _, content: _ } => false
    SupersededLine { by: _, content: _ } => false
    TicketLine { done: _, ticket: _ } => false
  }
}

fn dependency_inlines(rn: gunbc.roadmap_model.RoadmapNode, edges: List<gunbc.roadmap_model.RoadmapEdge>) -> List<std.markdown.MarkdownInline> {
  let parents = roadmap_parent_ids(edges: edges, node: rn.node)
  if count(parents) > 1 {
    [
      std.markdown.TextInline {
        text: concat(
          " — requires all: ",
          join(map(parents, p => p as String), ", "),
        )
      },
    ]
  } else {
    []
  }
}

fn node_inlines(rn: gunbc.roadmap_model.RoadmapNode, edges: List<gunbc.roadmap_model.RoadmapEdge>) -> List<std.markdown.MarkdownInline> {
  concat(
    concat(
      line_inlines(line: rn.line),
      carriers_inlines(carriers: rn.carriers),
    ),
    dependency_inlines(rn: rn, edges: edges),
  )
}

fn children_of(nodes: List<gunbc.roadmap_model.RoadmapNode>, edges: List<gunbc.roadmap_model.RoadmapEdge>, parent: gunbc.roadmap_model.RoadmapNodeId) -> List<gunbc.roadmap_model.RoadmapNode> {
  nodes |> filter(n => match roadmap_primary_parent(edges: edges, node: n.node) {
    UnderParent { parent: p } => p == parent
    TopLevel => false
  })
}

fn task_item_with(done: Bool, blocks: List<std.markdown.MarkdownBlock>) -> std.markdown.MarkdownTaskItem {
  if done {
    std.markdown.MarkdownTaskItem { state: Checked, blocks: blocks }
  } else {
    std.markdown.MarkdownTaskItem { state: Unchecked, blocks: blocks }
  }
}

fn plain_item_for(rn: gunbc.roadmap_model.RoadmapNode, edges: List<gunbc.roadmap_model.RoadmapEdge>) -> std.markdown.MarkdownListItem {
  std.markdown.MarkdownListItem { blocks: [std.markdown.ParagraphBlock { inlines: node_inlines(rn: rn, edges: edges) }] }
}

fn task_item_for(rn: gunbc.roadmap_model.RoadmapNode, nodes: List<gunbc.roadmap_model.RoadmapNode>, edges: List<gunbc.roadmap_model.RoadmapEdge>, merged: List<Int>, fuel: Int) -> std.markdown.MarkdownTaskItem {
  let para = std.markdown.ParagraphBlock { inlines: concat(node_inlines(rn: rn, edges: edges), signoff_suffix_inlines(rn: rn, merged: merged)) }
  let kids = if fuel > 0 { gunbc.roadmap_emit.children_of(nodes: nodes, edges: edges, parent: rn.node) } else { [] }
  let blocks = if count(kids) > 0 {
    concat([para], nodes_to_blocks(items: kids, nodes: nodes, edges: edges, merged: merged, fuel: fuel - 1))
  } else {
    [para]
  }
  task_item_with(done: node_is_done(rn: rn, merged: merged), blocks: blocks)
}

fn flush_run(acc: { blocks: List<std.markdown.MarkdownBlock>, mode: Int, tbuf: List<std.markdown.MarkdownTaskItem>, pbuf: List<std.markdown.MarkdownListItem> }) -> List<std.markdown.MarkdownBlock> {
  if acc.mode == 1 {
    concat(acc.blocks, [std.markdown.TaskListBlock { items: acc.tbuf }])
  } else {
    if acc.mode == 2 {
      concat(acc.blocks, [std.markdown.UnorderedListBlock { items: acc.pbuf }])
    } else {
      acc.blocks
    }
  }
}

fn nodes_to_blocks(items: List<gunbc.roadmap_model.RoadmapNode>, nodes: List<gunbc.roadmap_model.RoadmapNode>, edges: List<gunbc.roadmap_model.RoadmapEdge>, merged: List<Int>, fuel: Int) -> List<std.markdown.MarkdownBlock> {
  let acc = fold(items, init: { blocks: [], mode: 0, tbuf: [], pbuf: [] }, f: (a, rn) => {
    if node_is_plain(rn: rn) {
      let flushed = if a.mode == 1 { concat(a.blocks, [std.markdown.TaskListBlock { items: a.tbuf }]) } else { a.blocks }
      { blocks: flushed, mode: 2, tbuf: [], pbuf: concat(a.pbuf, [plain_item_for(rn: rn, edges: edges)]) }
    } else {
      let flushed = if a.mode == 2 { concat(a.blocks, [std.markdown.UnorderedListBlock { items: a.pbuf }]) } else { a.blocks }
      { blocks: flushed, mode: 1, tbuf: concat(a.tbuf, [task_item_for(rn: rn, nodes: nodes, edges: edges, merged: merged, fuel: fuel)]), pbuf: [] }
    }
  })
  flush_run(acc: acc)
}

fn group_blocks(g: gunbc.roadmap_model.SectionGroup, merged: List<Int>) -> List<std.markdown.MarkdownBlock> {
  let tops = g.nodes |> filter(n => is_top_level(edges: g.edges, node: n.node))
  let list_blocks = nodes_to_blocks(items: tops, nodes: g.nodes, edges: g.edges, merged: merged, fuel: roadmap_max_depth())
  if g.label == "" {
    list_blocks
  } else {
    concat(
      [std.markdown.ParagraphBlock { inlines: [std.markdown.StrongInline { inlines: [std.markdown.TextInline { text: concat(g.label, ":") }] }] }],
      list_blocks,
    )
  }
}

fn element_blocks(e: gunbc.roadmap_model.SectionElement, merged: List<Int>) -> List<std.markdown.MarkdownBlock> {
  match e {
    Prose { prose } => [std.markdown.ParagraphBlock { inlines: [std.markdown.TextInline { text: prose.content }] }]
    Group { group } => group_blocks(g: group, merged: merged)
  }
}

fn project_roadmap_section(title: String, elements: List<gunbc.roadmap_model.SectionElement>, merged: List<Int>) -> std.markdown.MarkdownDocument {
  std.markdown.MarkdownDocument {
    blocks: fold(elements,
      init: [std.markdown.HeadingBlock { level: H2, inlines: [std.markdown.TextInline { text: title }] }],
      f: fn(acc, e) { concat(acc, element_blocks(e: e, merged: merged)) })
  }
}
