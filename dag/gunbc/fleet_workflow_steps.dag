fn ci_release_bins_unpack_verify_step() -> Step {
  RunStep {
    name: Present { value: "Unpack + verify release bins (claim_executor --verify-build-artifacts; fail-closed)" },
    id: Present { value: "release_bins" },
    run: ci_release_bins_unpack_verify_script(),
    shell: none,
    env: none,
    working_directory: none,
    if_condition: none,
    continue_on_error: none,
    timeout_minutes: Present { value: gunbc_ci_aux_step_timeout_minutes }
  }
}

fn ci_fleet_wif_auth_step() -> Step {
  UsesStep {
    name: Present { value: "WIF auth (OIDC -> fleet-cloud-convergence SA, access token only)" },
    id: Present { value: "wif_auth" },
    uses: google_auth_action,
    with: Present {
      value: [
        kv(key: "workload_identity_provider", value: yaml_string(s: probe_identity_secret_access_requirement.wif_provider_resource)),
        kv(key: "service_account", value: yaml_string(s: probe_identity_secret_access_requirement.service_account)),
        kv(key: "token_format", value: yaml_string(s: "access_token")),
        kv(key: "create_credentials_file", value: yaml_bool(b: false))
      ]
    },
    env: none,
    if_condition: none,
    continue_on_error: none,
    timeout_minutes: Present { value: gunbc_ci_aux_step_timeout_minutes }
  }
}

fn ci_fleet_key_agent_step() -> Step {
  RunStep {
    name: Present { value: "Materialize fleet key in-run (SM versions/1 pinned -> RUNNER_TEMP 0600 -> ssh-agent -> wipe file)" },
    id: none,
    run: gunbc_ci_fleet_key_agent_script(),
    shell: none,
    env: Present {
      value: [kv(key: "WIF_ACCESS_TOKEN", value: yaml_string(s: "${{ steps.wif_auth.outputs.access_token }}"))]
    },
    working_directory: none,
    if_condition: none,
    continue_on_error: none,
    timeout_minutes: Present { value: gunbc_ci_aux_step_timeout_minutes }
  }
}

// MATERIALIZED ONLY FOR THE MODE THAT NEEDS IT. The credential is fetched when the run is going to
// install a grant and not otherwise: a job that only observes has no business holding an
// administrator password, and gating the fetch on the mode keeps the blast radius of a leak equal to
// the set of runs that genuinely required privilege.
fn ci_spark_admin_credential_step(if_condition: String) -> Step {
  RunStep {
    name: Present { value: "Materialize the spark administrator credential in-run (SM versions/1 pinned -> RUNNER_TEMP 0600; PATH exported, credential not)" },
    id: none,
    run: gunbc_ci_spark_admin_credential_script(),
    shell: none,
    env: Present {
      value: [kv(key: "WIF_ACCESS_TOKEN", value: yaml_string(s: "${{ steps.wif_auth.outputs.access_token }}"))]
    },
    working_directory: none,
    if_condition: Present { value: if_condition },
    continue_on_error: none,
    timeout_minutes: Present { value: gunbc_ci_aux_step_timeout_minutes }
  }
}

fn ci_spark_admin_credential_cleanup_step() -> Step {
  RunStep {
    name: Present { value: "Remove the in-run administrator credential (never outlives the job)" },
    id: none,
    run: gunbc_ci_spark_admin_credential_cleanup_script(),
    shell: none,
    env: none,
    working_directory: none,
    if_condition: Present { value: "always()" },
    continue_on_error: none,
    timeout_minutes: Present { value: gunbc_ci_aux_step_timeout_minutes }
  }
}

fn ci_fleet_key_agent_cleanup_step() -> Step {
  RunStep {
    name: Present { value: "Kill the in-run ssh-agent (key never outlives the job)" },
    id: none,
    run: gunbc_ci_fleet_key_agent_cleanup_script(),
    shell: none,
    env: none,
    working_directory: none,
    if_condition: Present { value: "always()" },
    continue_on_error: none,
    timeout_minutes: Present { value: gunbc_ci_aux_step_timeout_minutes }
  }
}

data ci_native_cache_derive_step_name: String = "Derive native-cache root (rustc-version segment; after setup-rust-toolchain)"


data ci_native_cache_prelude_order_bridge_note: String = "Adjacency-as-proxy ordering witness (not a structural Step-order predicate): ci_native_cache_prelude_order_bridge builds the setup-rust HOME env line immediately followed by the native-cache step name at the emitter's six-space yaml indent. witness_prelude_native_cache_root_step_follows_setup_rust asserts expected_ci_yml/falsifier_yml contain that substring. The real invariant is only that segment derivation runs after setup-rust-toolchain installs rustc; this check over-constrains to textual adjacency and can false-RED on a legitimate step inserted between setup-rust and native-cache, emitter yaml reformatting, or setup-rust gaining fields after HOME — but not false-green if ordering regresses. A hand-rolled match on Step would be the structural alternative; non-fold-residue forbids the wildcard arms that predicate would need (receipt: nfr floor on 14bc815db4). Dissolves when prelude ordering is witnessed without coproduct-residue match arms."


data ci_release_bins_artifact_name: String = "release-bins"


data gunbc_ci_aux_step_timeout_minutes: Duration = 5

data gunbc_ci_spark_serving_step_timeout_minutes: Duration = 60

data gunbc_ci_spark_serving_step_timeout_note: String = "Spark serving converge/observe step budget, raised from the shared aux 5m (operator authorization 2026-08-19). STATED AS AN ENVELOPE, NOT A MEASUREMENT, because the neighbouring gates in this module earn their numbers and this one cannot yet. What IS modeled: the ollama runtime archive at 1542416321 bytes, cited on extdeps.ollama.binary_release. What is NOT: the model blob closure has no modeled byte size at all — the desired model is identified by its manifest digest rather than a size — and throughput from the executor to a spark target has never been measured. So a cold install downloads a ~1.5GB runtime plus a model of unmodeled size over a link of unmeasured bandwidth, and no honest derivation produces a minute count from that. 5m was not a considered budget for this step, it was the shared aux default, and it cannot cover a cold install under any plausible bandwidth.

WHAT IS OBSERVED, and why this is not a hypothetical envelope: run 32213195686 (2026-08-19T03:49:56Z, read-only spark_observe) reports state=absent for BOTH spark targets — on srv6 the user unit is-active exits 4, the api/version and api/tags probes exit 7 against a refused connection, and the runtime receipt file does not exist. So the first canary is a guaranteed cold install of the full closure rather than a converged no-op, and the step budget has to cover acquisition of an unmodeled model closure on a host observed to hold none of it. The 5m default would have killed that install mid-download every time, and because publication is split from acquisition it would have done so silently-safely — dying in the attempt workspace, publishing nothing, and looking like a timeout rather than a budget defect.

Why the step needed its own constant rather than a bump to gunbc_ci_aux_step_timeout_minutes: that value is multiplied by the step count in the fleet job backstop, so raising it would inflate every unrelated aux step and the job cap together — a per-site cost paid fleet-wide to fix one step.

STEADY STATE IS SECONDS, NOT MINUTES. A converged host plans zero rows and the slice returns without transferring anything; this envelope is paid only on a cold or drifted target. A run that approaches it is therefore evidence about the install path, not a budget to raise again.

DISSOLVE-ON: the first successful srv6 canary produces the measurement this envelope stands in for — replace the number with that receipt, dated and cited to its run id, per the rule the v1-compiler test-targets gate states one constant down (raising a budget needs a measurement, not a round number)."

data gunbc_ci_v1_compiler_tests_compile_gate_timeout_minutes: Duration = 15

data gunbc_ci_v1_compiler_tests_compile_gate_timeout_note: String = "v1-compiler-tests retained-kernel execution gate step budget. Originally a compile-contract gate (operator ruling 2026-08-05, PR A / fierce-heron-177): reordered after the release build and switched to cargo test --release --no-run so v1-compiler compiles once per job. --no-run removed 2026-08-11 with the suite cutover; the crate shrank from 98 modules / 740 tests to the 9 declared retained modules / 30 tests, which execute rather than only compile. Warm runs should complete in seconds once the release artifact is warm; 15m retains the prior cold-host envelope without raising the cap."

data gunbc_ci_stage0_partition_compile_gate_timeout_minutes: Duration = 15

data gunbc_ci_stage0_partition_compile_gate_timeout_note: String = "stage0 partition compile gate step budget (sharp-fox-403 C1): seven sequential cargo check -p v1-stage0-* partition crates enrolled as the build-job compile backstop over stage0_partition_crate_rows. Cold-host envelope matches v1-compiler-tests compile gate until a dedicated receipt exists; warm partition crates are smaller than the monolith test crate."

data gunbc_ci_v1_compiler_test_targets_compile_gate_timeout_minutes: Duration = 10

data gunbc_ci_v1_compiler_test_targets_compile_gate_timeout_note: String = "v1-compiler test-targets compile gate step budget. 10 minutes against 67s MEASURED for this step's exact argv (cargo check -p v1-compiler --all-targets, cold, remote runner, on the repaired tree after gunbc#8167 / gunbc#8173 landed the lib-test compile fix). The earlier figure recorded here was 99s from cargo check --workspace --all-targets, which was an upper BOUND rather than this step's cost — it was all that could be measured while main's lib test target did not compile, and it is superseded rather than kept beside the real number. Deliberately BELOW the 15m carried by the v1-compiler-tests and partition gates rather than copied from them: those two inherited a cold-host envelope with no dedicated receipt, and repeating a number nobody measured is how an unmeasured envelope becomes precedent. The gate runs AFTER the release build for the same reason the retained-kernel gate does — v1-compiler is already compiled in release with the shared feature set, so the check reuses that artifact instead of forcing a second compile. Raising this needs a measurement, not a round number."

data gunbc_ci_artifact_transfer_step_timeout_minutes: Duration = 10

data gunbc_ci_artifact_transfer_step_note: String = "Cross-job handoff of the release bins (operator job-split ruling 2026-07-11): the build job packs ci_floor_required_artifact_names into one tgz (tar preserves the executable bits a raw artifact zip would drop) and uploads it; the ci floor job downloads, unpacks into target/release, and re-verifies via claim_executor --verify-build-artifacts before any step consumes a bin (fail-closed: a missing or truncated artifact reds the job at the verify, never as a mid-floor bin fallback). 10m is the transfer envelope for a ~200MB archive under fleet pressure; upload uses if-no-files-found: error so an empty pack is loud."

data gunbc_ci_prelude_allowance_minutes: Duration = 5

data gunbc_ci_release_build_step_timeout_minutes: Duration = 45

data srv1_dashboard_deploy_concurrency_group: String = "srv1-dashboard-deploy"
data srv1_dashboard_deploy_serialization_note: String = "Blue/green selection is observe-then-mutate, so two deploy jobs may not overlap: both could observe blue active, then the first flips green while the second restarts what has become the active green slot, recreating the outage. Job-grain concurrency serializes the entire cutover with cancel-in-progress=false; QueueNotMax may replace an older pending deployment with the newest main revision, but it never interrupts the one holding the host mutation window."

fn gunbc_ci_build_job_backstop_timeout_minutes() -> Int {
  gunbc_ci_aux_step_timeout_minutes + gunbc_ci_v1_compiler_tests_compile_gate_timeout_minutes + gunbc_ci_stage0_partition_compile_gate_timeout_minutes + gunbc_ci_v1_compiler_test_targets_compile_gate_timeout_minutes + gunbc_ci_release_build_step_timeout_minutes + gunbc_ci_aux_step_timeout_minutes + gunbc_ci_artifact_transfer_step_timeout_minutes + gunbc_ci_prelude_allowance_minutes
}

data gunbc_ci_fleet_job_aux_tier_step_count: Int = 7

data gunbc_ci_fleet_job_artifact_transfer_tier_step_count: Int = 3

data gunbc_ci_fleet_job_spark_tier_step_count: Int = 5

data gunbc_ci_fleet_job_backstop_timeout_note: String = "Corrected 2026-08-21: the prior formula (prelude + 11*aux + 2*spark) hand-counted the aux and spark tiers against a step list that had since drifted, and omitted the artifact_transfer tier entirely (yielding 180m). Recounted directly against fleet_converge_job()'s actual step composition in fleet_converge_workflow.dag (excluding ci_checkout_step, which carries no per-step timeout): aux tier = ci_release_bins_unpack_verify_step, ci_fleet_wif_auth_step, ci_fleet_key_agent_step, fleet_converge_plan_step, fleet_converge_apply_step, ci_spark_admin_credential_cleanup_step, ci_fleet_key_agent_cleanup_step (7); artifact_transfer tier = ci_release_bins_download_step, fleet_converge_plan_upload_step, fleet_converge_plan_download_step (3); spark_serving tier = fleet_converge_spark_linger_step, fleet_converge_spark_grants_step, fleet_converge_spark_observe_step, fleet_converge_spark_reboot_step, fleet_converge_spark_durability_step (5). Corrected total: 5 + 7*5 + 3*10 + 5*60 = 370m, versus the prior 180m — the job could previously be killed by its own backstop before its correctly-budgeted spark steps finished. These counts are hand-authored cardinals, not derived from fleet_converge_job()'s step list by construction (fleet_workflow_steps cannot import fleet_converge_workflow without a cycle), so this note is the single authority to update alongside any change to that job's step composition or tier assignment."

fn gunbc_ci_fleet_job_backstop_timeout_minutes() -> Int {
  gunbc_ci_prelude_allowance_minutes
    + (gunbc_ci_fleet_job_aux_tier_step_count * gunbc_ci_aux_step_timeout_minutes)
    + (gunbc_ci_fleet_job_artifact_transfer_tier_step_count * gunbc_ci_artifact_transfer_step_timeout_minutes)
    + (gunbc_ci_fleet_job_spark_tier_step_count * gunbc_ci_spark_serving_step_timeout_minutes)
}

