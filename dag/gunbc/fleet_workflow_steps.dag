module gunbc.fleet_workflow_steps

// THE GITHUB ACTIONS STEP VOCABULARY THE FLEET WORKFLOW RUNS ON.
//
// Re-homed here on 2026-08-15 from gunbc.ci_workflow, which was deleted with the CI wipe. These
// steps were never CI facts: checking out a tree, installing a toolchain, building the release
// bins, handing them between jobs, and authenticating to the fleet are things the fleet-converge
// workflow does, and they lived in the CI module only because CI happened to be authored first.
//
// The wipe made that placement visible rather than debatable: with every CI job deleted, the
// only consumer left was fleet_converge_workflow, so the module was already fleet-owned in
// everything except its name. The alternative -- keeping ci_workflow alive as the home for its
// own last consumer -- is how a deleted structure grows back around whatever survived it.
//
// The new witness-floor workflow (gunbc.witness_floor_workflow) deliberately shares NOTHING with
// this module. It authors its own checkout, toolchain, build and run steps in four short
// constructors, because its build is one cargo invocation with no artifact handoff, and reusing
// a cross-job artifact-transfer vocabulary to express that would be borrowing an architecture it
// does not have.

import std.measure { minute_count }
import std.types { Duration }
import extdeps.languages.yaml.types { yaml_string, yaml_int, yaml_bool, kv }
import extdeps.github.actions {
  Step, RunStep, UsesStep,
  checkout_action, setup_rust_action, cache_action,
  google_auth_action,
  upload_artifact_action, download_artifact_action
}
import gunbc.ci_workflow_expressions {
  ci_setup_rust_home, ci_cache_path, ci_cache_key, ci_cache_restore_keys,
}
import gunbc.ci_compile_jobs { compile_jobs_count_or_serial }
import gunbc.ci_runner_target { ci_runner_target_ram_speed_budget, selected_ci_runner_target }
import gunbc.ci_floor_measurement { gunbc_ci_runner_slot_ram_speed_ceiling }
import gunbc.merge_admission_produce { ci_repo_root_shell }
import v2.workflow.ci_workflow_run_emit {
  ci_isolate_toolchain_script,
  ci_native_cache_root_script,
  ci_pin_rustup_default_script,
}
import v2.workflow.ci_release_build_emit { ci_release_build_script }
import gunbc.ci_spec {
  ci_release_bins_pack_script, ci_release_bins_unpack_verify_script,
  ci_release_bins_archive_name,
  gunbc_ci_fleet_key_agent_script,
  gunbc_ci_spark_admin_credential_script,
  gunbc_ci_spark_admin_credential_cleanup_script,
  gunbc_ci_fleet_key_agent_cleanup_script,
}
import gunbc.fleet_host_key_enrollment { probe_identity_secret_access_requirement }
import std.types { List, String, Int }

fn ci_checkout_step() -> Step {
  UsesStep {
    name: Present { value: "Checkout" },
    id: none,
    uses: checkout_action,
    with: Present {
      value: [kv(key: "fetch-depth", value: yaml_int(n: 0))]
    },
    env: none,
    if_condition: none,
    continue_on_error: none,
    timeout_minutes: none
  }
}

fn ci_prelude_steps_with_checkout(checkout: Step, exact_head_preflight: List<Step>) -> List<Step> {
  [
    checkout,
  ] |> concat(exact_head_preflight) |> concat([
    ci_isolate_toolchain_step(),
    UsesStep {
      name: Present { value: "Setup Rust" },
      id: none,
      uses: setup_rust_action,
      with: Present {
        value: [
          kv(key: "components", value: yaml_string(s: "rustfmt")),
          kv(key: "cache", value: yaml_bool(b: false)),
          kv(key: "rustflags", value: yaml_string(s: ""))
        ]
      },
      env: Present {
        value: [kv(key: "HOME", value: yaml_string(s: ci_setup_rust_home()))]
      },
      if_condition: none,
      continue_on_error: none,
      timeout_minutes: none
    },
    ci_native_cache_root_step(),
    RunStep {
      name: Present { value: "Pin rustup default (isolated RUSTUP_HOME has no default toolchain)" },
      id: none,
      run: ci_pin_rustup_default_script(),
      shell: none,
      env: none,
      working_directory: none,
      if_condition: none,
      continue_on_error: none,
      timeout_minutes: none
    },
    UsesStep {
      name: Present { value: "Cache Cargo" },
      id: none,
      uses: cache_action,
      with: Present {
        value: [
          kv(key: "path", value: yaml_string(s: ci_cache_path())),
          kv(key: "key", value: yaml_string(s: ci_cache_key())),
          kv(key: "restore-keys", value: yaml_string(s: ci_cache_restore_keys()))
        ]
      },
      env: none,
      if_condition: none,
      continue_on_error: none,
      timeout_minutes: none
    }
  ])
}

fn ci_prelude_steps() -> List<Step> {
  ci_prelude_steps_with_checkout(checkout: ci_checkout_step(), exact_head_preflight: [])
}

fn ci_isolate_toolchain_step() -> Step {
  RunStep {
    name: Present { value: "Isolate toolchain dirs" },
    id: none,
    run: ci_isolate_toolchain_script(build_jobs_count: ci_cargo_build_jobs_count()),
    shell: none,
    env: none,
    working_directory: none,
    if_condition: none,
    continue_on_error: none,
    timeout_minutes: none
  }
}

fn ci_native_cache_root_step() -> Step {
  RunStep {
    name: Present { value: ci_native_cache_derive_step_name },
    id: none,
    run: ci_native_cache_root_script(),
    shell: none,
    env: none,
    working_directory: none,
    if_condition: none,
    continue_on_error: none,
    timeout_minutes: none
  }
}

fn ci_native_cache_prelude_order_bridge() -> String {
  concat(
    concat("HOME: ", ci_setup_rust_home()),
    concat("\n      - name: ", ci_native_cache_derive_step_name)
  )
}

fn ci_cargo_build_jobs_count() -> Int {
  compile_jobs_count_or_serial(jobs: ci_compile_jobs(
    memory_budget: ci_runner_target_ram_speed_budget(target: selected_ci_runner_target()),
    force_serial: false
  ))
}

// STEP IDS ARE INLINE HERE, AND THE CONDITION THAT MAKES THAT SAFE IS A FACT ABOUT THE CURRENT
// POPULATION -- NOT A PROPERTY OF THIS CONSTRUCTION. Both ids ("release_build" below,
// "release_bins" in ci_release_bins_unpack_verify_step) were named constants in the deleted
// gunbc.ci_workflow: falsifier_release_build_step_id and ci_release_bins_step_id. Those
// constants existed to BIND a step's id to the if-condition gating on it, and their only
// consumer was gunbc.falsifier_run_control falsifier_control_prerequisite_if, which built
// "steps.<id>.outcome == 'success'" by concat over the constant. That file went in this cut, so
// measured at this head there is no reference to steps.release_build or steps.release_bins
// anywhere in the tree, and inlining is safe TODAY.
//
// WHY IT IS RECORDED RATHER THAN SCORED SMALL: GitHub Actions resolves steps.<id> job-scoped and
// a mismatch does not fail -- it resolves to null and the comparison is unconditionally false,
// silently. That exact defect ran at least sixteen days across three repair attempts, one of
// which (#7812) introduced a strictly worse version while fixing the prior one, and nineteen
// corpus diagnostics went uncaught in the window; the history is in the deleted module's
// falsifier_control_prerequisite_execution_proof_note (git history). The binding's only consumer
// went with the cut. THE NEXT PERSON TO ADD AN if: GATING ON steps.release_bins.outcome WILL
// HAND-WRITE THE STRING, AND NOTHING HERE BINDS IT TO THE ID -- that re-opens the class. If a
// condition ever consumes either id, restore the constant first and derive both sides from it.
// (Class and history: tidy-pike-117, 2026-08-15; consumer census verified at this head.)
fn ci_release_build_step() -> Step {
  RunStep {
    name: Present { value: "Build release bins (claim_executor + gunbc)" },
    id: Present { value: "release_build" },
    run: ci_release_build_script(),
    shell: none,
    env: none,
    working_directory: none,
    if_condition: none,
    continue_on_error: none,
    timeout_minutes: Present { value: gunbc_ci_release_build_step_timeout_minutes }
  }
}

fn ci_release_bins_pack_step() -> Step {
  RunStep {
    name: Present { value: "Pack release bins for cross-job handoff (tar keeps exec bits)" },
    id: none,
    run: ci_release_bins_pack_script(),
    shell: none,
    env: none,
    working_directory: none,
    if_condition: none,
    continue_on_error: none,
    timeout_minutes: Present { value: gunbc_ci_aux_step_timeout_minutes }
  }
}

fn ci_release_bins_upload_step() -> Step {
  UsesStep {
    name: Present { value: "Upload release-bins artifact" },
    id: none,
    uses: upload_artifact_action,
    with: Present {
      value: [
        kv(key: "name", value: yaml_string(s: ci_release_bins_artifact_name)),
        kv(key: "path", value: yaml_string(s: ci_release_bins_archive_name)),
        kv(key: "if-no-files-found", value: yaml_string(s: "error")),
        kv(key: "retention-days", value: yaml_int(n: 3)),
        kv(key: "compression-level", value: yaml_int(n: 0))
      ]
    },
    env: none,
    if_condition: none,
    continue_on_error: none,
    timeout_minutes: Present { value: gunbc_ci_artifact_transfer_step_timeout_minutes }
  }
}

fn ci_release_bins_download_step() -> Step {
  UsesStep {
    name: Present { value: "Download release-bins artifact" },
    id: none,
    uses: download_artifact_action,
    with: Present {
      value: [kv(key: "name", value: yaml_string(s: ci_release_bins_artifact_name))]
    },
    env: none,
    if_condition: none,
    continue_on_error: none,
