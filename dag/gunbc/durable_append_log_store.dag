module gunbc.durable_append_log_store

import std.types { NonEmptyStr, String, Bool, List, Int }
import std.durable_exclusive_hold { DurableHoldOwnerRef }
import std.durable_append_log {
  AppendFraming, RecordPerGeneration, NewlineDelimitedStream,
  MemberWriterPolicy, HostOnly, HostCreatesThenSandboxWrites, SandboxOnly,
}

// THE SEALED SHAPE OF AN APPEND-LOG / MULTI-WRITER STORE, and the per-member disposition of every row the
// sealed-store migration left `Blocked: append-only` or `Blocked: written by the worker sandbox`.
// Contract semantics (atomicity, order, torn tail, readback, writer windows) are std.durable_append_log's;
// the exclusion is std.durable_exclusive_hold's, released on evidence (ReleasedOnEvidence); host-authored
// generation logs are std.durable_compare_and_set's. This module adds only what those leave open: the
// sealed handle, its one mint, and the census.
//
// SEALED LIKE EVERY STORE THE MIGRATION HAS SEALED (gunbc.roadmap.roadmap_attempt_state_store AttemptState):
// AppendLogStore is `sole_constructor`, minted from a parent handle and a declared slot row, never from a
// path; AppendLogParent is itself `sole_constructor`, and the only producers of one are the owning cohort's
// own sealed store (the attempt-state store for the attempt members). The declaration is data: the slot
// rows below are the only place a log member's name is written.

// ONE SLOT ROW PER LOG MEMBER. The entry NAME is not written here: it is the owning sealed store's row
// (gunbc.roadmap.roadmap_attempt_state_store attempt_state_member_name for the attempt members), read by
// `member`, so a log member's name has one spelling (DESIGN 3).
type AppendLogSlot {
  member: NonEmptyStr
  framing: AppendFraming
  writers: MemberWriterPolicy
}

type AppendLogParent sole_constructor {
  directory: NonEmptyStr
}

type AppendLogStore sole_constructor {
  parent: NonEmptyStr
  slot: AppendLogSlot
}

// THE MINT REFUSES ON LEGACY. The parent directory is listed; an entry that is the slot's file under a
// different framing (a generation file where a stream is declared, or the reverse) or a second file claiming
// the slot is `AppendLogLegacyRefused`, never adopted and never read through. Bytes written under the
// unchanged literal name by the pre-seal path are NOT legacy for a stream slot: sealing is in place, and the
// old-bytes readback is a required control. An unlisted parent is Unready, not an empty log.
type AppendLogLegacyCause
  = LegacyFramingMismatch { entry: String }
  | LegacyDuplicateClaim { entries: List<String> }

type AppendLogMinting
  = AppendLogReady { store: AppendLogStore }
  | AppendLogUnready { detail: String }
  | AppendLogLegacyRefused { cause: AppendLogLegacyCause }

// THE ONE MINT. Pure over a listing the owning store took, so the legacy decision is a fold and not an effect.
// `claimants` is the listed entries that name this slot's member (the owner derives that from its own name row).
fn append_log_store_mint(parent: AppendLogParent, slot: AppendLogSlot, listed: Bool, claimants: List<String>, mismatched: List<String>) -> AppendLogMinting {
  if !listed {
    AppendLogUnready { detail: "parent directory did not list" }
  } else {
    match mismatched {
      Cons { head: entry, tail: _ } => AppendLogLegacyRefused { cause: LegacyFramingMismatch { entry: entry } }
      Empty {} => match claimants {
        Cons { head: _, tail: Cons { head: _, tail: _ } } => AppendLogLegacyRefused { cause: LegacyDuplicateClaim { entries: claimants } }
        _ => AppendLogReady { store: AppendLogStore { parent: parent.directory, slot: slot } }
      }
    }
  }
}

// ── THE DISPOSITION CENSUS, at identity grain ─────────────────────────────────────────────────────
// Identity is (inventory row_id, member name). Sixteen rows from Seeadecb2 (the per-attempt dispatch
// state), one from S88241eea (gcp_iam_bootstrap), one from the approval decision store. The census read the
// merged disposition tables of #15417, #15412, #15068, #15104, #15081, #15396 and #15414; the other
// `Blocked` rows there (capacity store, cleanup authority root-per-call, tailnet door cutover journal,
// transition lease) are blocked on other capabilities and are NOT this contract's: see `out_of_scope_rows`.
//
// THE GROUNDING THAT CHANGED THE SHAPE. `dispatch_attempt_events_initialize_for_instance` creates the events
// file (create-new, group-writable under a dedicated worker account) and the sandboxed worker then appends
// it; `attempt_state_prepare_argvs_for_instance` creates the wire directory the harness writes
// `<events>.wire/<round>.{request,response}.json` into. So every `multi-writer` member is a host create
// followed by ONE sandbox window, and the contract is a sequence of exclusive windows, not concurrent writers.
type MemberDisposition
  = MigrateToLogStore { slot: AppendLogSlot, readers: List<String> }
  | MigrateToCreateOnceMember { reason: String }
  | BlockedOnCapability { capability: String }
  | StaysSharedByAgreement { authority: String }

type MemberCensusRow {
  row_id: NonEmptyStr
  member: NonEmptyStr
  was: String
  disposition: MemberDisposition
}

fn sandbox_provider(owner: NonEmptyStr) -> DurableHoldOwnerRef {
  owner as DurableHoldOwnerRef
}

fn stream_slot(member: NonEmptyStr, writer: DurableHoldOwnerRef) -> AppendLogSlot {
  AppendLogSlot {
    member: member,
    framing: NewlineDelimitedStream {},
    writers: HostCreatesThenSandboxWrites { principal: writer },
  }
}

fn wire_slot(writer: DurableHoldOwnerRef) -> AppendLogSlot {
  AppendLogSlot {
    member: "AttemptDirectoryWire" as NonEmptyStr,
    framing: RecordPerGeneration {},
    writers: HostCreatesThenSandboxWrites { principal: writer },
  }
}

// THE PRINCIPAL IS THE ATTEMPT'S WORKER UNIT, whose identity the attempt-state store already derives; the
// literal here names the role the implementation lane binds, not a user name.
data attempt_worker_principal_role: NonEmptyStr = "attempt-worker-unit" as NonEmptyStr

data append_log_member_census: List<MemberCensusRow> = [
  MemberCensusRow {
    row_id: "Seeadecb2" as NonEmptyStr, member: "AttemptWorkerEvents" as NonEmptyStr,
    was: "Blocked: append-only log",
    disposition: MigrateToLogStore {
      slot: stream_slot(member: "AttemptWorkerEvents" as NonEmptyStr, writer: sandbox_provider(owner: attempt_worker_principal_role)),
      readers: ["roadmap_attempt_metering", "events projection subprocess (codex_provider_event_projection_args)", "roadmap_provider_events"],
    },
