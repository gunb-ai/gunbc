// ROWS THAT READ `Blocked` IN THE SAME TABLES BUT ARE NOT THIS CONTRACT'S, named so a reader does not
// mistake absence for omission: the capacity store (C-compute), the fabric cleanup authority (root per call),
// the tailnet door cutover journal (witness-seam), the deploy transition lease (hold-release-model; the
// ReleasedOnEvidence arm now exists in std.durable_exclusive_hold, so that row's own trigger should be
// re-read, not by this lane).
data out_of_scope_rows: List<String> = [
  "S9892f19f capacity store",
  "S703c0e8e fabric_control_plane_live_probe cleanup authority",
  "S78f330a6 tailnet_door_cutover_host journal",
  "S33f05980 deploy_transition transition lease",
]
