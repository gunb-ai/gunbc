  MemberCensusRow {
    row_id: "Seeadecb2" as NonEmptyStr, member: "AttemptAuditLog" as NonEmptyStr,
    was: "Blocked: written by the worker sandbox (multi-writer)",
    disposition: MigrateToLogStore {
      slot: stream_slot(member: "AttemptAuditLog" as NonEmptyStr, writer: sandbox_provider(owner: attempt_worker_principal_role)),
