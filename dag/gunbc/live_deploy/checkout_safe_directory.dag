module gunbc.live_deploy.checkout_safe_directory

import std.types { String, Bool, List, Int, NonEmptyStr }
import std.algebra { trim }
import extdeps.git {
  git_config_global_get_all_command, git_config_global_add_command,
  git_safe_directory_key, git_safe_directory_wildcard, SafeDirectoryGrant,
}
import extdeps.exec.command { ArgvCommand, LocalExec }
import gunbc.command_runner { run_shell_command_observe }
import extdeps.git.inspect { config_reading, ConfigReading, ConfigSet, ConfigUnset, ConfigUnreadable }
import gunbc.host_effect { HostEffectTransport, LocalShell }
import gunbc.host_effect_realize { run_typed_argv_transport }
import gunbc.typed_argv_exec { TypedArgvExecOutcome, TypedArgvExecConverged, TypedArgvExecRefused }
import gunbc.live_deploy.spec { DeploymentSpec }
import gunbc.ci_deploy_access { DeployAccess }

// THE DEPLOY PRINCIPAL MAY READ THE CHECKOUT IT DEPLOYS. The deployed tree (spec.service.repo_root)
// is owned by the publication principal, while the tree-publication member is observed by the deploy
// principal (DeployAccess.principal -- ghrunner on the CI path). git refuses every command in a
// repository its caller does not own ("detected dubious ownership") unless the caller's global
// safe.directory names it, so without this grant the plan cannot be derived at all: srv1's
// dashboard_deploy refused exactly so on 2026-09-24 and was repaired by hand with
// `git config --global --add safe.directory /opt/gunbc/gunbc`. This module is that repair as a
// convergence: the grant is DERIVED from the spec's checkout path and the access's principal, added
// only when absent, and read back.
//
// WHERE IT RUNS, AND WHY NOT THE PREAMBLE OR THE FLEET PLAN. The member plan is derived by the
// evaluator BEFORE the apply script is built (gunbc.live_deploy.apply
// live_deploy_apply_mutation_via_transport calls deployment_effect_plan first), so a step in
// gunbc.live_deploy.emit deploy_apply_preamble_steps would run after the observation it exists to
// enable. The fleet plan/apply is the wrong layer too: it converges accounts, not which checkout a
// deployment publishes, and the path is a fact of the DeploymentSpec, so a fleet row would restate
// it. So the ensure runs in the apply fold immediately before the plan is derived, over the same
// transport the observation uses.
//
// IT IS NOT GATED ON THE SUDO ROSTER because it spends no privilege: it writes the executing
// principal's own global config, the same principal that then runs the observation. `--global` is
// that principal's file by definition, which is why the grant names the principal rather than a
// file path.
//
// THE NARROWEST GRANT: the exact checkout path. A "*" entry already present is REFUSED rather than
// accepted -- it would satisfy git while granting every repository on the host, and this module will
// not report a host converged on a grant wider than the one it models, nor delete an entry it did
// not write. A different path is simply not the grant: it reads back as absent and the exact one is
// added.
type SafeDirectoryStanding
  = SafeDirectoryGranted
  | SafeDirectoryAbsent
  | SafeDirectoryWildcardRefused
  | SafeDirectoryUnreadable { cause: String }

type SafeDirectoryEnsure
  = SafeDirectoryAlreadyConverged { grant: SafeDirectoryGrant }
  | SafeDirectoryAdded { grant: SafeDirectoryGrant }
  | SafeDirectoryRefused { grant: SafeDirectoryGrant, cause: String }

fn deploy_checkout_safe_directory_grant(access: DeployAccess, spec: DeploymentSpec) -> SafeDirectoryGrant {
  SafeDirectoryGrant { principal: access.principal.posix.name, path: spec.service.repo_root }
}

fn safe_directory_entries(stdout: String) -> List<String> {
  split(s: stdout, delimiter: "\n") |> map(e => trim(s: e)) |> filter(e => e != "")
}

// THE READBACK DECISION, over the values `git config --global --get-all safe.directory` printed.
// A wildcard refuses before the exact path is consulted, so a host carrying both is still refused.
fn safe_directory_standing(grant: SafeDirectoryGrant, reading: ConfigReading) -> SafeDirectoryStanding {
  match reading {
    ConfigUnreadable { exit_code, stderr } =>
      SafeDirectoryUnreadable { cause: join(["git config --global --get-all ", git_safe_directory_key, " exited ", to_string(value: exit_code), ": ", stderr], "") }
    ConfigUnset => SafeDirectoryAbsent
    ConfigSet { value } => {
      let entries = safe_directory_entries(stdout: value)
      if any(entries, e => e == git_safe_directory_wildcard) { SafeDirectoryWildcardRefused }
      else { if any(entries, e => e == grant.path as String) { SafeDirectoryGranted } else { SafeDirectoryAbsent } }
    }
  }
}

type ConfigExec
  = ConfigExecRan { exit_code: Int, stdout: String, stderr: String }
  | ConfigExecRefused { cause: String }

// ONE ARGV, BOUND TO THE TRANSPORT AT ONE POINT. The command (program and operands) comes from extdeps.git once; on the host
// itself they run as a process argv through gunbc.command_runner run_shell_command_observe (no shell
// re-parse), and behind ssh the same
// words go through run_typed_argv_transport, which refuses LocalShell because it has no remote
// target. This is the only place the transport is consulted.
fn run_git_command(transport: HostEffectTransport, command: ArgvCommand) -> ConfigExec {
  match transport {
    LocalShell => {
      let r = run_shell_command_observe(command: command, transport: LocalExec)
      ConfigExecRan { exit_code: r.exit_code, stdout: r.stdout, stderr: r.stderr }
    }
    _ => match run_typed_argv_transport(argv: append([command.program as String], items: command.arguments), transport: transport) {
      TypedArgvExecRefused { reason } => ConfigExecRefused { cause: reason }
      TypedArgvExecConverged { result: r } => ConfigExecRan { exit_code: r.exit_code, stdout: r.stdout, stderr: r.stderr }
    }
  }
}

fn read_safe_directory(transport: HostEffectTransport) -> ConfigExec {
  run_git_command(transport: transport, command: git_config_global_get_all_command(key: git_safe_directory_key))
}

fn add_safe_directory(transport: HostEffectTransport, grant: SafeDirectoryGrant) -> ConfigExec {
  run_git_command(transport: transport, command: git_config_global_add_command(key: git_safe_directory_key, value: grant.path as String))
}

fn observed_standing(grant: SafeDirectoryGrant, exec: ConfigExec) -> SafeDirectoryStanding {
  match exec {
    ConfigExecRefused { cause } => SafeDirectoryUnreadable { cause: cause }
    ConfigExecRan { exit_code, stdout, stderr } =>
      safe_directory_standing(grant: grant, reading: config_reading(exit_code: exit_code, stdout: stdout, stderr: stderr))
  }
}

fn wildcard_refusal_cause(grant: SafeDirectoryGrant) -> String {
  join([
    "the global ", git_safe_directory_key, " of ", grant.principal as String,
    " carries the wildcard, which grants every repository; the modeled grant is exactly ", grant.path as String,
  ], "")
}

// THE DECISION AFTER THE WRITE, separated so the readback's two refusals are one function a claim
// can drive without a host: only the exact path reads back as converged.
fn safe_directory_after_add(grant: SafeDirectoryGrant, after: SafeDirectoryStanding) -> SafeDirectoryEnsure {
  match after {
    SafeDirectoryGranted => SafeDirectoryAdded { grant: grant }
    SafeDirectoryWildcardRefused => SafeDirectoryRefused { grant: grant, cause: wildcard_refusal_cause(grant: grant) }
    SafeDirectoryUnreadable { cause } => SafeDirectoryRefused { grant: grant, cause: join(["readback after add: ", cause], "") }
    SafeDirectoryAbsent => SafeDirectoryRefused { grant: grant, cause: join(["readback after add did not show ", grant.path as String], "") }
  }
}

fn ensure_deploy_checkout_safe_directory(grant: SafeDirectoryGrant, transport: HostEffectTransport) -> SafeDirectoryEnsure {
  match observed_standing(grant: grant, exec: read_safe_directory(transport: transport)) {
    SafeDirectoryGranted => SafeDirectoryAlreadyConverged { grant: grant }
    SafeDirectoryWildcardRefused => SafeDirectoryRefused { grant: grant, cause: wildcard_refusal_cause(grant: grant) }
    SafeDirectoryUnreadable { cause } => SafeDirectoryRefused { grant: grant, cause: cause }
    SafeDirectoryAbsent => match add_safe_directory(transport: transport, grant: grant) {
      ConfigExecRefused { cause } => SafeDirectoryRefused { grant: grant, cause: join(["adding ", git_safe_directory_key, ": ", cause], "") }
      ConfigExecRan { exit_code, stdout: _, stderr } =>
        if exit_code != 0 {
          SafeDirectoryRefused { grant: grant, cause: join(["git config --global --add ", git_safe_directory_key, " exited ", to_string(value: exit_code), ": ", stderr], "") }
        } else {
          safe_directory_after_add(grant: grant, after: observed_standing(grant: grant, exec: read_safe_directory(transport: transport)))
        }
    }
  }
}

fn safe_directory_refusal_reason(grant: SafeDirectoryGrant, cause: String) -> String {
  join(["live_deploy: the deploy checkout ", grant.path as String, " is not a git safe.directory of ", grant.principal as String, ": ", cause], "")
}
