module gunbc.live_deploy.repository_convergence

import std.types { String, Bool, Int, List, FilePath }
import std.process { ProcessExit, ExitSuccess, ExitFailure }
import extdeps.git.object_store { GitObjectId, git_object_id_eq, git_object_id_wire_hex }
import extdeps.git.enumeration {
  GitRefIdentity,
  GitRefSetObservation,
  GitRefSetObserved,
  GitRefSetReadRefused,
  GitRefSetUndecodable,
}
import extdeps.git.worktree_enumeration {
  GitWorktreeIdentity,
  GitWorktreeCheckout,
  GitWorktreeOnBranch,
  GitWorktreeDetachedAt,
  GitWorktreeBare,
  GitWorktreeSetObservation,
  GitWorktreeSetObserved,
  GitWorktreeSetReadRefused,
  GitWorktreeSetUndecodable,
}

// WHY THIS MODULE EXISTS, AS A MEASUREMENT RATHER THAN A PREFERENCE.
//
// The deployed-tree sync moves tracked bytes with rsync, moves `HEAD`/`objects`/`packed-refs`/`refs`
// by copying them as FILES, and excludes `index` entirely. Those are three transports over one
// repository, so nothing makes them agree. Measured on srv1 2026-08-27, `/opt/gunbc/gunbc` reports
// 5650 divergent paths from `git status --porcelain`: 1964 tracked-and-staged-present but absent
// from the worktree, 1731 present but unknown to HEAD, 1500 differing at BOTH levels. The first
// status column is index-vs-HEAD and the second is worktree-vs-index, so both are wrong.
//
// THAT IS ONE DEPLOYMENT'S OUTPUT, NOT TWO RACING. No lease, queue or concurrency group addresses
// it, which is why this cut is ordered ahead of the serialization work: the priority question is
// whether ONE isolated execution can produce a valid target state, and for the file-copy
// realization the answer is no.
//
// THE REPLACEMENT IS NOT "rsync PLUS THE INDEX". Copying `index` too would add a fourth file to the
// set that must agree, and the index references object content and path timestamps, so a copy
// between machines is exactly the fragile direction. The fix is to stop transporting repository
// state at all and let git perform the transition, which is the only thing that owns all three
// simultaneously.

// THE PRE- AND POST-STATE ARE THE SAME SHAPE, so one type carries both and the adjudication below is
// a comparison rather than two vocabularies that must be kept in step.
type RepositoryState {
  refs: GitRefSetObservation
  worktrees: GitWorktreeSetObservation
  head: String
  reflog: String
}

// EVERY ARM HAS A DIFFERENT OWNER, which is the whole reason this is not a Bool.
//
// A CAS that lost (`ConvergenceBaseRefMoved`) means another actor moved the ref and the remedy is to
// re-observe and retry; a refused update means git declined and the remedy is about the repository.
// A ref that VANISHED is the packed-refs deletion trap and the remedy is a bug fix here. A worktree
// that lost its binding stranded someone's dispatch attempt. Collapsing any of these into "failed"
// would hand every one of them the same response.
//
// `ConvergenceHeadMovedWithoutReflog` is the arm that catches the defect this module replaces:
// a file-level copy of `refs/**` moves HEAD and leaves no reflog entry, so a non-noop transition
// whose reflog did not grow was not performed by git. A converged HEAD alone cannot distinguish
// "git moved this" from "a file was written over it", and those are exactly the two states whose
// conflation produced the 5650 divergent paths.
type RepositoryConvergenceOutcome
  = ConvergenceCompleted { candidate: String, refs_preserved: Int, worktrees_preserved: Int }
  | ConvergenceAlreadyAtCandidate { candidate: String }
  | ConvergencePreStateUnobservable { detail: String }
  | ConvergencePostStateUnobservable { detail: String }
  | ConvergenceBaseRefMoved { expected: String, observed: String }
  | ConvergenceRefDisappeared { refname: String, objectname: String }
  | ConvergenceWorktreeDisappeared { path: String }
  | ConvergenceWorktreeRebound { path: String, detail: String }
  | ConvergenceHeadNotAtCandidate { candidate: String, observed: String }
  | ConvergenceHeadMovedWithoutReflog { candidate: String }
  | ConvergenceObjectImportRefused { candidate: String, exit_code: Int, stderr: String }
  | ConvergenceWorktreeTransitionRefused { candidate: String, exit_code: Int, stderr: String }

// COMPARED AS OBJECT IDS, NOT AS TEXT. `GitObjectId` is a coproduct over hash families
// (`GitSha1ObjectId | GitSha256ObjectId`), not a branded string, so there is no meaningful cast to
// String and `git_object_id_eq` is the authority for whether two ids name the same object -- it
// compares WITHIN a family and answers false across families, which a hex comparison could not do
// (a 40-character sha1 and a sha256 are not comparable by text even when both are lowercase hex).
// The first cut of this module cast `objectname as String` and every comparison silently failed.
//
// The hex form is used ONLY where a refusal is rendered for a human, through the authority's own
// `git_object_id_wire_hex`, never to decide equality.
fn convergence_ref_matches(identity: GitRefIdentity, refname: String, objectname: GitObjectId) -> Bool {
  identity.refname == refname && git_object_id_eq(left: identity.objectname, right: objectname)
}

fn convergence_refs_contain(refs: List<GitRefIdentity>, refname: String, objectname: GitObjectId) -> Bool {
  any(refs, r => convergence_ref_matches(identity: r, refname: refname, objectname: objectname))
}

// PRESERVATION IS CHECKED BY NAME, NOT BY COUNT, and the difference is the whole check. Equal
// cardinality is satisfied by a set that lost one ref and gained another, which is precisely what a
// wholesale `packed-refs` replacement does. DESIGN section 5 says completeness is an identity join.
//
// THE BASE REF IS EXEMPT BY NAME because it is the ref this operation exists to move. Exempting it
// by "whichever ref changed" would exempt the corruption too.
fn convergence_first_lost_ref(
  before: List<GitRefIdentity>,
  after: List<GitRefIdentity>,
  base_ref: String,
) -> GitRefIdentity? {
  let moved_or_lost = before |> filter(r =>
    r.refname != base_ref && !convergence_refs_contain(
      refs: after,
      refname: r.refname,
      objectname: r.objectname,
    )
  )
  moved_or_lost.first()
}

fn convergence_checkout_binding(checkout: GitWorktreeCheckout) -> String {
  match checkout {
    GitWorktreeOnBranch { head: _, branch: b } => join(["branch:", b], "")
    GitWorktreeDetachedAt { head: _ } => "detached"
    GitWorktreeBare => "bare"
  }
}

fn convergence_worktree_at(worktrees: List<GitWorktreeIdentity>, path: String) -> GitWorktreeIdentity? {
  worktrees |> filter(w => w.path == path) |> first()
}

// THE PRIMARY IS EXEMPT FROM THE BINDING CHECK AND THE LINKED WORKTREES ARE NOT. The primary is the
// tree being converged, so its head moves by design; every LINKED worktree is somebody's in-flight
// dispatch attempt, and a transition that silently reboundedit -- or dropped its registration --
// destroys work that has nothing to do with this release. Checking the primary the same way would
// make the operation refuse its own effect; not checking the linked ones is the failure this arm
// exists for.
fn convergence_first_worktree_fault(
  before: List<GitWorktreeIdentity>,
  after: List<GitWorktreeIdentity>,
  primary_path: String,
) -> RepositoryConvergenceOutcome? {
  let linked = before |> filter(w => w.path != primary_path)
  let faults = linked |> filter(w =>
    match convergence_worktree_at(worktrees: after, path: w.path) {
      Absent => true
      Present { value: seen } =>
        convergence_checkout_binding(checkout: seen.checkout)
          != convergence_checkout_binding(checkout: w.checkout)
    }
  )
  match faults.first() {
    Absent => Absent
    Present { value: w } =>
      match convergence_worktree_at(worktrees: after, path: w.path) {
        Absent => Present { value: ConvergenceWorktreeDisappeared { path: w.path } }
        Present { value: seen } =>
          Present {
            value: ConvergenceWorktreeRebound {
              path: w.path,
              detail: join([
                "expected ", convergence_checkout_binding(checkout: w.checkout),
                ", observed ", convergence_checkout_binding(checkout: seen.checkout),
              ], ""),
            },
          }
      }
  }
}

fn convergence_refs_of(observation: GitRefSetObservation) -> List<GitRefIdentity>? {
  match observation {
    GitRefSetObserved { refs: rs } => Present { value: rs }
    GitRefSetReadRefused { exit_code: _, stderr: _ } => Absent
    GitRefSetUndecodable { record_index: _, raw_record: _, reason: _ } => Absent
  }
}

fn convergence_worktrees_of(observation: GitWorktreeSetObservation) -> List<GitWorktreeIdentity>? {
  match observation {
    GitWorktreeSetObserved { worktrees: ws } => Present { value: ws }
    GitWorktreeSetReadRefused { exit_code: _, stderr: _ } => Absent
    GitWorktreeSetUndecodable { entry_index: _, raw_entry: _, reason: _ } => Absent
  }
}

fn convergence_ref_observation_detail(observation: GitRefSetObservation) -> String {
  match observation {
    GitRefSetObserved { refs: _ } => ""
    GitRefSetReadRefused { exit_code: c, stderr: e } =>
      join(["ref enumeration refused (exit ", to_string(c), "): ", e], "")
    GitRefSetUndecodable { record_index: i, raw_record: r, reason: why } =>
      join(["ref record ", to_string(i), " undecodable (", why, "): ", r], "")
  }
}

fn convergence_worktree_observation_detail(observation: GitWorktreeSetObservation) -> String {
  match observation {
    GitWorktreeSetObserved { worktrees: _ } => ""
    GitWorktreeSetReadRefused { exit_code: c, stderr: e } =>
      join(["worktree enumeration refused (exit ", to_string(c), "): ", e], "")
    GitWorktreeSetUndecodable { entry_index: i, raw_entry: r, reason: why } =>
      join(["worktree entry ", to_string(i), " undecodable (", why, "): ", r], "")
  }
}

// THE ORDER OF THESE CHECKS IS LOAD-BEARING, not stylistic. Unobservability is adjudicated FIRST,
// because every later comparison would otherwise read an absent observation as a preserved-nothing
// set and report preservation it never established -- the empty-observation narrow DESIGN names,
// where a read that could not answer becomes the answer. Only once both sides are genuinely
// observed does comparing them mean anything.
//
// THE REFLOG CHECK IS LAST AND ONLY ON A NON-NOOP. An already-converged repository legitimately adds
// no entry, so requiring growth unconditionally would refuse the correct no-op -- and a check that
// fires on the healthy case is worse than absent, because it will be disabled.
fn repository_convergence_verdict(
  before: RepositoryState,
  after: RepositoryState,
  candidate: String,
  base_ref: String,
  primary_path: String,
) -> RepositoryConvergenceOutcome {
  match convergence_refs_of(observation: before.refs) {
    Absent =>
      ConvergencePreStateUnobservable {
        detail: convergence_ref_observation_detail(observation: before.refs),
      }
    Present { value: refs_before } =>
      match convergence_worktrees_of(observation: before.worktrees) {
        Absent =>
          ConvergencePreStateUnobservable {
            detail: convergence_worktree_observation_detail(observation: before.worktrees),
          }
        Present { value: worktrees_before } =>
          match convergence_refs_of(observation: after.refs) {
            Absent =>
              ConvergencePostStateUnobservable {
                detail: convergence_ref_observation_detail(observation: after.refs),
              }
            Present { value: refs_after } =>
              match convergence_worktrees_of(observation: after.worktrees) {
                Absent =>
                  ConvergencePostStateUnobservable {
                    detail: convergence_worktree_observation_detail(observation: after.worktrees),
                  }
                Present { value: worktrees_after } =>
                  repository_convergence_compare(
                    refs_before: refs_before,
                    refs_after: refs_after,
                    worktrees_before: worktrees_before,
                    worktrees_after: worktrees_after,
                    before_head: before.head,
                    after_head: after.head,
                    before_reflog: before.reflog,
                    after_reflog: after.reflog,
                    candidate: candidate,
                    base_ref: base_ref,
                    primary_path: primary_path,
                  )
              }
          }
      }
  }
}

fn repository_convergence_compare(
  refs_before: List<GitRefIdentity>,
  refs_after: List<GitRefIdentity>,
  worktrees_before: List<GitWorktreeIdentity>,
  worktrees_after: List<GitWorktreeIdentity>,
  before_head: String,
  after_head: String,
  before_reflog: String,
  after_reflog: String,
  candidate: String,
  base_ref: String,
  primary_path: String,
) -> RepositoryConvergenceOutcome {
  if after_head != candidate {
    ConvergenceHeadNotAtCandidate { candidate: candidate, observed: after_head }
  } else {
    match convergence_first_lost_ref(before: refs_before, after: refs_after, base_ref: base_ref) {
      Present { value: lost } =>
        ConvergenceRefDisappeared {
          refname: lost.refname,
          objectname: git_object_id_wire_hex(oid: lost.objectname) as String,
        }
      Absent =>
        match convergence_first_worktree_fault(
          before: worktrees_before,
          after: worktrees_after,
          primary_path: primary_path,
        ) {
          Present { value: fault } => fault
          Absent =>
            if before_head == candidate {
              ConvergenceAlreadyAtCandidate { candidate: candidate }
            } else {
              if before_reflog == after_reflog {
                ConvergenceHeadMovedWithoutReflog { candidate: candidate }
              } else {
                ConvergenceCompleted {
                  candidate: candidate,
                  refs_preserved: count(refs_before),
                  worktrees_preserved: count(worktrees_before),
                }
              }
            }
        }
    }
  }
}

fn repository_convergence_converged(outcome: RepositoryConvergenceOutcome) -> Bool {
  match outcome {
    ConvergenceCompleted { candidate: _, refs_preserved: _, worktrees_preserved: _ } => true
    ConvergenceAlreadyAtCandidate { candidate: _ } => true
    ConvergencePreStateUnobservable { detail: _ } => false
    ConvergencePostStateUnobservable { detail: _ } => false
    ConvergenceBaseRefMoved { expected: _, observed: _ } => false
    ConvergenceRefDisappeared { refname: _, objectname: _ } => false
    ConvergenceWorktreeDisappeared { path: _ } => false
    ConvergenceWorktreeRebound { path: _, detail: _ } => false
    ConvergenceHeadNotAtCandidate { candidate: _, observed: _ } => false
    ConvergenceHeadMovedWithoutReflog { candidate: _ } => false
    ConvergenceObjectImportRefused { candidate: _, exit_code: _, stderr: _ } => false
    ConvergenceWorktreeTransitionRefused { candidate: _, exit_code: _, stderr: _ } => false
  }
}

// EXPECTING ABSENCE IS THE EMPTY STRING, which is git's own convention for `update-ref` meaning
// "verify this ref does not exist". A base ref that is genuinely absent -- a first convergence into
// a fresh clone -- must therefore produce "" here rather than a placeholder, and the CAS then
// refuses if anyone created it in the meantime. Rendering an absent ref as any non-empty text would
// ask git to verify a value that was never there.
fn convergence_ref_hex_at(refs: List<GitRefIdentity>, refname: String) -> String {
  match refs |> filter(r => r.refname == refname) |> first() {
    Present { value: r } => git_object_id_wire_hex(oid: r.objectname) as String
    Absent => ""
  }
}

// EVERY REFUSAL NAMES ITS OWN SUBJECT, so an operator reads what happened rather than that something
// did. A ref that vanished names the ref; a rebound worktree names the path and both bindings; the
// reflog arm says which distinction it is drawing, because "head moved without a reflog entry" is
// meaningless to anyone who has not read this module.
fn repository_convergence_detail(outcome: RepositoryConvergenceOutcome) -> String {
  match outcome {
    ConvergenceCompleted { candidate: c, refs_preserved: r, worktrees_preserved: w } =>
      join(["converged to ", c, " preserving ", to_string(r), " ref(s) and ", to_string(w), " worktree(s)"], "")
    ConvergenceAlreadyAtCandidate { candidate: c } =>
      join(["already at ", c, "; no transition performed"], "")
    ConvergencePreStateUnobservable { detail: d } =>
      join(["the repository state before the transition could not be observed: ", d], "")
    ConvergencePostStateUnobservable { detail: d } =>
      join(["the repository state after the transition could not be observed, so nothing is established about it: ", d], "")
    ConvergenceBaseRefMoved { expected: e, observed: o } =>
      join(["the base ref moved between observation and update (expected ", e, "): ", o], "")
    ConvergenceRefDisappeared { refname: r, objectname: o } =>
      join(["ref ", r, " at ", o, " existed before the transition and does not after it"], "")
    ConvergenceWorktreeDisappeared { path: p } =>
      join(["linked worktree ", p, " lost its registration during the transition"], "")
    ConvergenceWorktreeRebound { path: p, detail: d } =>
      join(["linked worktree ", p, " changed binding during the transition: ", d], "")
    ConvergenceHeadNotAtCandidate { candidate: c, observed: o } =>
      join(["HEAD is ", o, " after a transition to ", c], "")
    ConvergenceHeadMovedWithoutReflog { candidate: c } =>
      join([
        "HEAD reached ", c,
        " but the reflog did not grow, so the move was not performed by git -- a file-level write over refs leaves exactly this trace",
      ], "")
    ConvergenceObjectImportRefused { candidate: c, exit_code: x, stderr: e } =>
      join(["fetching objects for ", c, " refused (exit ", to_string(x), "): ", e], "")
    ConvergenceWorktreeTransitionRefused { candidate: c, exit_code: x, stderr: e } =>
      join(["the worktree transition to ", c, " refused (exit ", to_string(x), "): ", e], "")
  }
}

// THE EXIT MAPPING IS TOTAL AND FAIL-CLOSED: every non-converged arm is a nonzero exit carrying its
// own typed cause, so no refusal can leave the line running.
fn convergence_exit(outcome: RepositoryConvergenceOutcome) -> ProcessExit {
  if repository_convergence_converged(outcome: outcome) {
    ExitSuccess
  } else {
    ExitFailure { code: 1, reason: repository_convergence_detail(outcome: outcome) }
  }
}

// THE OBSERVATION IS ONE FUNCTION USED TWICE, so the pre- and post-states cannot be gathered by two
// code paths that drift apart. A comparison whose two sides were produced differently is comparing
// the readers as much as the repository.
fn observe_repository_state(repo: String) -> RepositoryState {
  let refs = git.Core.ForEachRefIn(repository_path: repo)
  let worktrees = git.Core.WorktreeListIn(repository_path: repo)
  let head = git.Core.RevParseInRepo(repo: repo as FilePath, target: "HEAD" as GitRef)
  let reflog = git.Core.ReflogInRepo(repo: repo as FilePath, ref: "HEAD")
  RepositoryState {
    refs: git_ref_set_observation_of(
      raw: refs.raw,
      exit_code: refs.exit_code,
      stderr: refs.stderr,
    ),
    worktrees: git_worktree_set_observation_of(
      raw: worktrees.raw,
      exit_code: worktrees.exit_code,
      stderr: worktrees.stderr,
    ),
    head: trim(head.revision),
    reflog: reflog.stdout,
  }
}

// THE ORDER OF EFFECTS IS THE SAFETY PROPERTY, and each step is refused rather than continued past.
//
// OBJECTS FIRST, REF SECOND, WORKTREE THIRD. Importing objects is the only step that is safe to
// repeat and safe to abandon: a fetched object nothing references is garbage collected, so a failure
// after step one leaves the repository exactly as it was. Advancing the ref before the objects exist
// would publish a ref pointing at nothing.
//
// THE CAS CARRIES THE EXPECTED PRIOR VALUE THE CALLER OBSERVED, so a ref moved by anyone between the
// pre-observation and this write refuses instead of clobbering. This is the ONLY step whose failure
// means "someone else is here" rather than "this repository is broken", which is why it has its own
// arm rather than a shared one.
//
// THE POST-OBSERVATION IS NOT OPTIONAL AND NOT CONDITIONAL. A transition that performed every step
// with a zero exit has established that git ACCEPTED each command, never that the repository now
// holds the intended state -- the deployed tree this replaces was assembled entirely from commands
// that succeeded. Only the readback answers that, so the verdict is always computed from a fresh
// observation rather than inferred from exit codes.
func repository_converge_wet(
  repo: String,
  remote: String,
  base_ref: String,
  candidate: String,
  primary_path: String,
) -> ProcessExit {
  let before = observe_repository_state(repo: repo)
  match convergence_refs_of(observation: before.refs) {
    Absent =>
      convergence_exit(outcome: ConvergencePreStateUnobservable {
        detail: convergence_ref_observation_detail(observation: before.refs),
      })
    Present { value: refs_before } => {
      let expected_old = convergence_ref_hex_at(refs: refs_before, refname: base_ref)
      let fetched = git.Core.FetchForcedRefInRepo(
        repo: repo as FilePath,
        remote: remote,
        refspec: candidate,
      )
      if fetched.exit_code != 0 {
        convergence_exit(outcome: ConvergenceObjectImportRefused {
          candidate: candidate,
          exit_code: fetched.exit_code,
          stderr: fetched.stderr,
        })
      } else {
        let swapped = git.Core.UpdateRefCompareAndSwapInRepo(
          repo: repo as FilePath,
          ref: base_ref,
          new_value: candidate,
          expected_old: expected_old,
        )
        if swapped.exit_code != 0 {
          convergence_exit(outcome: ConvergenceBaseRefMoved {
            expected: expected_old,
            observed: swapped.stderr,
          })
        } else {
          let reset = git.Core.ResetHardInRepo(repo: repo as FilePath, target: candidate)
          if reset.exit_code != 0 {
            convergence_exit(outcome: ConvergenceWorktreeTransitionRefused {
              candidate: candidate,
              exit_code: reset.exit_code,
              stderr: reset.stderr,
            })
          } else {
            convergence_exit(outcome: repository_convergence_verdict(
              before: before,
              after: observe_repository_state(repo: repo),
              candidate: candidate,
              base_ref: base_ref,
              primary_path: primary_path,
            ))
          }
        }
      }
    }
  }
}
