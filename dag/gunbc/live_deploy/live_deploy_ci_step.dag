module gunbc.live_deploy.live_deploy_ci_step

// THE CI RUN-STEP LEAF OF THE LIVE_DEPLOY DOMAIN: the `gunbc run` target and invoke of the
// steps whose entry is a dag/gunbc/live_deploy module (gunbc.live_deploy.apply,
// gunbc.live_deploy.apply_receipt, gunbc.live_deploy.pre_swap_admission). The shared run-step
// machinery is v2.workflow.gunbc_invoke_step_emit, gunbc.ci.ci_layer_roots and
// gunbc.ci.ci_run_step_target; the roster stays in gunbc.instruments.ci_run_step_roster, which imports these
// targets. A step module imports the shared machinery, never the roster.

import std.types { String }
import v2.workflow.gunbc_invoke_step_emit {
  gunbc_run_step_script_for_target,
  gunbc_run_step_script_with_prelude_for_target,
}
import gunbc.ci.ci_run_step_target {
  gunbc_run_step_target,
  GunbcRunStepTarget,
}
import gunbc.ci.ci_layer_roots { witness_layer_roots }
import gunbc.live_deploy.apply_receipt { live_deploy_apply_receipt_artifact_path_for }
import gunbc.roadmap.roadmap_dashboard_instance { srv1_dashboard_live_id }
import v2.std.diagnostic { Outcome, bind_outcome, outcome_accepted}
import gunbc.auth.github_app_credential_step {
  gunbc_ci_org_roster_read_app_token_prelude
}

// THE JOB-SIDE EXACTLY-ONE-RECEIPT ASSERTION (gunbc.live_deploy.apply_receipt): the rule -- exactly one
// decodable document, apply XOR refusal, zero never (named), the receipt/conclusion pairing -- lives in
// the receipt module with the documents it counts, not in shell in the workflow (gunbc.design_argument::how_to_work).
data gunbc_ci_assert_dashboard_deploy_receipts_target: GunbcRunStepTarget = gunbc_run_step_target(
  module: "gunbc.live_deploy.apply_receipt",
  function: "assert_dashboard_deploy_receipts",
)

// THE PLAN'S SERVE-ENTRY VERDICT (gunbc.live_deploy.pre_swap_admission): the plan job compiles the
// prod-role serve entry once, with the release pair the run itself built, and publishes the verdict
// beside the plan receipt; the swap transaction consumes it by identity instead of paying the cold
// resolve again (prod gap 1, failure b).
data gunbc_ci_record_plan_serve_entry_verdict_target: GunbcRunStepTarget = gunbc_run_step_target(
  module: "gunbc.live_deploy.pre_swap_admission",
  function: "record_plan_serve_entry_compile_verdict",
)

data gunbc_ci_live_deploy_apply_srv1_target: GunbcRunStepTarget = gunbc_run_step_target(
  module: "gunbc.live_deploy.apply",
  function: "live_deploy_apply_prod_role_wet",
)

// THE RECEIPTED DASHBOARD DEPLOY (RLM-2a): the same fold as live_deploy_apply_prod_role_wet, bound to
// the expected revision and the fleet transaction, minting gunbc.live_deploy.apply_receipt.
data gunbc_ci_live_deploy_transaction_target: GunbcRunStepTarget = gunbc_run_step_target(
  module: "gunbc.live_deploy.apply",
  function: "live_deploy_apply_prod_role_transaction_wet",
)

// THE INSTANCE-SCOPED DEPLOY (option C): converges the ONE roster row named by the run's packed subject,
// through the same modeled apply path as the dashboard deploy but WITHOUT the prod-role selection -- it
// calls the env-reading CI entry (live_deploy_apply_desired_wet_from_ci reads the packed '<host>:<instance_id>'
// subject from the env and parses it, since a run step reaches an entry only through the environment). Two
// receipts, two places: the run-step's OWN process receipt lands at this fixed per-run path under a stable
// label (GitHub isolates each run's workspace, so a stable label cannot collide; the prod-role label is not
// used here -- this job is never the prod-role route), while the transaction receipt the wet fold mints lands
// in the chosen instance's OWN receipt dir, located by the resolve step -- not by this path. See the deploy
// invoke comment beside gunbc_ci_desired_instance_deploy_invoke.
data gunbc_ci_desired_instance_deploy_target: GunbcRunStepTarget = gunbc_run_step_target(
  module: "gunbc.live_deploy.apply",
  function: "live_deploy_apply_desired_wet_from_ci",
)

// THE microVM SLOT CONTROLLER INSTALL is invoked on the host-pinned runner, never through
// apply_dispatch, like the dark install; unlike it, its elevated legs run as the fleet administrator
// over the SSH edge under the job's inherited approval, not under ci_deploy_srv1_access's sudo.
data gunbc_ci_microvm_controller_install_target: GunbcRunStepTarget = gunbc_run_step_target(
  module: "gunbc.live_deploy.apply",
  function: "microvm_controller_install_wet",
)

data gunbc_ci_microvm_controller_install_admission_target: GunbcRunStepTarget = gunbc_run_step_target(
  module: "gunbc.live_deploy.apply",
  function: "microvm_controller_install_admission_wet",
)

// The dashboard deploy, invoked as a fleet-converge mode rather than from a workflow of its own.
// The operation is unchanged and already correct: live_deploy_apply_prod_role_wet observes the candidate
// release BEFORE any mutation and refuses when it cannot name the release it would install, so a
// deploy that cannot identify itself stops the line with nothing touched. Only a caller was missing
// — gunbc#8676 deleted the invocation, never the operation.
fn gunbc_ci_live_deploy_apply_srv1_invoke() -> Outcome<String> {
  gunbc_run_step_script_for_target(
    source_roots: witness_layer_roots,
    target: gunbc_ci_live_deploy_apply_srv1_target,
    claim_run: false,
    receipt_rel: none
  )
}

fn gunbc_ci_live_deploy_transaction_invoke() -> Outcome<String> {
  gunbc_run_step_script_for_target(
    source_roots: witness_layer_roots,
    target: gunbc_ci_live_deploy_transaction_target,
    claim_run: false,
    receipt_rel: live_deploy_apply_receipt_artifact_path_for(instance_id: srv1_dashboard_live_id as String)
  )
}

// THE INSTANCE-SCOPED DEPLOY step script. Two receipts, two locations -- do not conflate them:
// (1) the run-step's OWN process receipt lands at a fixed per-run path under a stable label
//     ("desired-instance-deploy"); GitHub isolates each run's workspace, so a stable label cannot
//     collide across runs, and this is the file the step cats after the run;
// (2) the transaction receipt the wet fold mints lands in the CHOSEN instance's own receipt dir
//     (live_deploy_apply_receipt_dir_for(instance)), and the job locates THAT one through the resolve
//     step (live_deploy_ci_instance_receipt_identity_from_ci), never through this fixed path.
fn gunbc_ci_desired_instance_deploy_invoke() -> Outcome<String> {
  gunbc_run_step_script_for_target(
    source_roots: witness_layer_roots,
    target: gunbc_ci_desired_instance_deploy_target,
    claim_run: false,
    receipt_rel: live_deploy_apply_receipt_artifact_path_for(instance_id: "desired-instance-deploy")
  )
}

// THE RECEIPT-IDENTITY RESOLVER step target. It reads the run's packed subject from the env and writes the
// per-instance receipt name and dir to GITHUB_OUTPUT (a non-mutating read + output write), so the job's
// receipt upload/assert steps reference the SAME per-instance location the wet fold writes to, rather than
// the srv1-live-bound constant. See live_deploy_ci_instance_receipt_identity_from_ci.
data gunbc_ci_desired_instance_receipt_identity_target: GunbcRunStepTarget = gunbc_run_step_target(
  module: "gunbc.live_deploy.apply",
  function: "live_deploy_ci_instance_receipt_identity_from_ci",
)

fn gunbc_ci_desired_instance_receipt_identity_invoke() -> Outcome<String> {
  gunbc_run_step_script_for_target(
    source_roots: witness_layer_roots,
    target: gunbc_ci_desired_instance_receipt_identity_target,
    claim_run: false,
    receipt_rel: live_deploy_apply_receipt_artifact_path_for(instance_id: "desired-instance-deploy-identity")
  )
}

fn gunbc_ci_microvm_controller_install_invoke() -> Outcome<String> {
  gunbc_run_step_script_for_target(
    source_roots: witness_layer_roots,
    target: gunbc_ci_microvm_controller_install_target,
    claim_run: false,
    receipt_rel: none
  )
}

// THE INSTALL'S TENANCY ADMISSION READS THE ORG'S RUNNER GROUPS (gunbc.live_deploy.apply
// microvm_controller_install_admission_wet), so its step mints the roster reader's installation token,
// down-scoped at the mint to organization_self_hosted_runners read: the job reads the groups and can
// change none of them. The mint reads the app key with the job's workload-identity token, which the
// step's environment carries. The step holds no fleet key: it runs before the step that loads one.
fn gunbc_ci_microvm_controller_install_admission_invoke() -> Outcome<String> {
  gunbc_run_step_script_with_prelude_for_target(
    prelude: gunbc_ci_org_roster_read_app_token_prelude(),
    source_roots: witness_layer_roots,
    target: gunbc_ci_microvm_controller_install_admission_target,
    claim_run: false,
    receipt_rel: none
  )
}

fn gunbc_ci_assert_dashboard_deploy_receipts_invoke() -> Outcome<String> {
  gunbc_run_step_script_for_target(
    source_roots: witness_layer_roots,
    target: gunbc_ci_assert_dashboard_deploy_receipts_target,
    claim_run: false,
    receipt_rel: none
  )
}

fn gunbc_ci_record_plan_serve_entry_verdict_invoke() -> Outcome<String> {
  gunbc_run_step_script_for_target(
    source_roots: witness_layer_roots,
    target: gunbc_ci_record_plan_serve_entry_verdict_target,
    claim_run: false,
    receipt_rel: none
  )
}
