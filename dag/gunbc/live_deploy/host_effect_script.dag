module gunbc.live_deploy.host_effect_script

import std.types { String, Int }
import v2.std.collection { Present, Absent }
import std.disposition { Disposition, Scaffold, RealizationDispatch }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import gunbc.host_effect {
  HostEffect,
  ShellCommand,
  RedfishAction,
  ConvergePlan,
  Srv3InstallDiagnosticObserve,
  OsInstallActuatorToolchainEnsure,
  ProvisionBuildCache,
  SetHostnameCas,
  ReadEffectivePosixPrincipal,
  SudoNopasswdExecuteProbe,
  Srv3InstallReconcileObserve,
  DurableApprovalGrantRecord,
  DurableApprovalGrantRead,
  Srv3InstallMediaFetch,
  Srv3SeededInstallMediaRemaster,
  Srv3SeededInstallMediaToolchainEnsure,
  Srv3SolConsoleCapture,
  Srv3BmcwebSessionLogin,
  Srv3BmcwebTokenExtract,
  Srv3NbdProxyServe,
  Srv3BootOnceReadBackSleep,
  Srv3ReceiptEmit,
  LiveDeployApply,
  LiveDeployRetract,
  LiveDeployEnsureDependency,
  LiveDeployDigestReadback,
  DeployAccessPreflight,
}
import gunbc.live_deploy.spec { DeploymentSpec, DeploymentDependencyStep }
import gunbc.live_deploy.emit {
  live_deploy_apply_script_for,
  live_deploy_retract_script_for,
  deployment_ensure_dependency_script,
}
import gunbc.roadmap_static_site { roadmap_site_digest_readback_script }

data live_deploy_host_effect_script_dissolution_trigger: Disposition = Scaffold {
  dissolves_to: RealizationDispatch,
  bind: DeclarationRef {
    module_path: "gunbc.live_deploy.emit",
    decl_name: "live_deploy_remote_mutation_service_op_realization_dissolution_trigger",
    field: WholeDeclaration,
  }
}

fn live_deploy_apply_effect_script(spec: DeploymentSpec) -> String {
  live_deploy_apply_script_for(spec: spec)
}

fn live_deploy_retract_effect_script(spec: DeploymentSpec) -> String {
  live_deploy_retract_script_for(spec: spec)
}

fn live_deploy_ensure_dependency_effect_script(dep: DeploymentDependencyStep) -> String {
  deployment_ensure_dependency_script(dep: dep)
}

fn live_deploy_digest_readback_effect_script(port: Int) -> String {
  roadmap_site_digest_readback_script(port: port)
}

fn live_deploy_host_effect_script_for(effect: HostEffect) -> String? {
  match effect {
    LiveDeployApply { spec: s } =>
      Present { value: live_deploy_apply_effect_script(spec: s) }
    LiveDeployRetract { spec: s } =>
      Present { value: live_deploy_retract_effect_script(spec: s) }
    LiveDeployEnsureDependency { dep: d } =>
      Present { value: live_deploy_ensure_dependency_effect_script(dep: d) }
    LiveDeployDigestReadback { port: p } =>
      Present { value: live_deploy_digest_readback_effect_script(port: p) }
    DeployAccessPreflight {} => Absent
    ShellCommand { script: _ } => Absent
    RedfishAction { action: _ } => Absent
    ConvergePlan { policy: _ } => Absent
    Srv3InstallDiagnosticObserve { bmc: _, port: _, iso_path: _, iso_content_hash: _ } => Absent
    OsInstallActuatorToolchainEnsure {} => Absent
    ProvisionBuildCache { catalog_id: _ } => Absent
    SetHostnameCas { hostnamectl_path: _, base: _, desired: _ } => Absent
    ReadEffectivePosixPrincipal { read: _ } => Absent
    SudoNopasswdExecuteProbe { probe: _ } => Absent
    Srv3InstallReconcileObserve { include_git_meta: _ } => Absent
    DurableApprovalGrantRecord => Absent
    DurableApprovalGrantRead => Absent
    Srv3InstallMediaFetch => Absent
    Srv3SeededInstallMediaRemaster => Absent
    Srv3SeededInstallMediaToolchainEnsure => Absent
    Srv3SolConsoleCapture => Absent
    Srv3BmcwebSessionLogin => Absent
    Srv3BmcwebTokenExtract => Absent
    Srv3NbdProxyServe { intent: _, lease_key: _ } => Absent
    Srv3BootOnceReadBackSleep => Absent
    Srv3ReceiptEmit { lines: _ } => Absent
  }
}
