module gunbc.live_deploy.unit_install

import std.types { NonEmptyStr }
import extdeps.systemd.manager { SystemdManager }
import extdeps.systemd.unit_file { SystemdUnitFile }

// The apply leg carries this record until execution. A migration projects the same
// records; it does not infer units from destination paths or maintain a second roster.
// This describes one installation, not proof that a host has installed or drained it.
type DeploymentUnitInstall {
  manager: SystemdManager
  unit: NonEmptyStr
  destination: NonEmptyStr
  file: SystemdUnitFile
}
