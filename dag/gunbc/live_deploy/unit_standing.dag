module gunbc.live_deploy.unit_standing

import std.types { String, Bool, NonEmptyStr, Int, List }
import std.algebra { trim, length, list_push }
import extdeps.systemd.systemctl
import extdeps.systemd {
  systemd_unit_property_wire, SystemdUnitProperty,
  LoadState, UnitFileState, ActiveState, SubState, Result, ExecMainStatus, ExecStartProperty, User, WorkingDirectoryProperty, Unit,
}
import extdeps.systemd.unit_file {
  SystemdUnitFile, ServiceUnitFile, TimerUnitFile, SliceUnitFile, PathUnitFile,
  SystemdServiceDirective, SystemdServiceMode,
  SystemdPathDirective, PathUnit, DirectoryNotEmpty, PathChanged, MakeDirectory,
}

// EXACT SYSTEMD UNIT STANDING, MODELED ON WHAT THE EMITTED UNITS ACTUALLY ARE. Readiness alone
// cannot prove the belt's units are installed and armed. The RLM-2 ruling (section 7) keeps unit
// standing in scope and rejects the naive 'every unit enabled and active', because
// gunbc.live_deploy.emit gives the units different semantics -- the dashboard serve service is
// Type=simple, the belt service is Type=oneshot with no [Install] section, and the belt's event path
// units are what is enabled, under paths.target. (There was a belt timer; dogfood intervention #4
// removed it, and with it this module's timer standing.) The positive standing is one row per unit,
// and the discriminating POSITIVE control is that a correctly completed, currently INACTIVE oneshot
// stays green.
//
// THE OBSERVER IS `systemctl show --property=X --value` (extdeps.systemd.systemctl ShowProperty),
// system scope. There is still no modeled system-scope `is-enabled` operation (systemctl.dag's own
// note); UnitFileState carries the same fact through the show surface.
//
// WHAT IS COMPARED EXACTLY, member by member, stated so any residue would be visible. ExecStart, User
// and WorkingDirectory are compared exactly against the directives of R's emitted unit file
// (gunbc.live_deploy.emit live_deploy_serve_unit_file / live_deploy_belt_service_unit_file), reading
// systemd's `{ path=... ; argv[]=... ; ... }` rendering by its `argv[]=` segment. A path unit's target
// is compared exactly through the Unit property; its watched path is NOT read back (see
// BeltEventPathStanding), which is this module's one declared residue.
//
// EVERY REFUSAL NAMES THE UNIT AND THE PROPERTY that disagreed; an unreadable property is a
// refusal, never a pass by vacancy.
type UnitPropertyRead
  = UnitPropertyValue { value: String }
  | UnitPropertyUnreadable { unit: String, property: String }

fn read_unit_property(unit: NonEmptyStr, property: SystemdUnitProperty) -> UnitPropertyRead {
  let got = systemd.Systemctl.ShowProperty(unit: unit, property: systemd_unit_property_wire(property: property))
  if got.success {
    UnitPropertyValue { value: trim(s: got.value) }
  } else {
    UnitPropertyUnreadable { unit: unit as String, property: systemd_unit_property_wire(property: property) as String }
  }
}

type ServiceUnitObserved {
  load_state: String
  unit_file_state: String
  active_state: String
  sub_state: String
  result: String
  exec_main_status: String
  exec_start: String
  user: String
  working_directory: String
}

type ServiceUnitObservation
  = ServiceUnitObservedOk { observed: ServiceUnitObserved }
  | ServiceUnitUnobservable { unit: String, property: String }

fn observe_service_unit(unit: NonEmptyStr) -> ServiceUnitObservation {
  match read_unit_property(unit: unit, property: LoadState) {
    UnitPropertyUnreadable { unit: u, property: p } => ServiceUnitUnobservable { unit: u, property: p }
    UnitPropertyValue { value: load_state } =>
      match read_unit_property(unit: unit, property: UnitFileState) {
        UnitPropertyUnreadable { unit: u, property: p } => ServiceUnitUnobservable { unit: u, property: p }
        UnitPropertyValue { value: unit_file_state } =>
          match read_unit_property(unit: unit, property: ActiveState) {
            UnitPropertyUnreadable { unit: u, property: p } => ServiceUnitUnobservable { unit: u, property: p }
            UnitPropertyValue { value: active_state } =>
              match read_unit_property(unit: unit, property: SubState) {
                UnitPropertyUnreadable { unit: u, property: p } => ServiceUnitUnobservable { unit: u, property: p }
                UnitPropertyValue { value: sub_state } =>
                  match read_unit_property(unit: unit, property: Result) {
                    UnitPropertyUnreadable { unit: u, property: p } => ServiceUnitUnobservable { unit: u, property: p }
                    UnitPropertyValue { value: result } =>
                      match read_unit_property(unit: unit, property: ExecMainStatus) {
                        UnitPropertyUnreadable { unit: u, property: p } => ServiceUnitUnobservable { unit: u, property: p }
                        UnitPropertyValue { value: exec_main_status } =>
                          match read_unit_property(unit: unit, property: ExecStartProperty) {
                            UnitPropertyUnreadable { unit: u, property: p } => ServiceUnitUnobservable { unit: u, property: p }
                            UnitPropertyValue { value: exec_start } =>
                              match read_unit_property(unit: unit, property: User) {
                                UnitPropertyUnreadable { unit: u, property: p } => ServiceUnitUnobservable { unit: u, property: p }
                                UnitPropertyValue { value: user } =>
                                  match read_unit_property(unit: unit, property: WorkingDirectoryProperty) {
                                    UnitPropertyUnreadable { unit: u, property: p } => ServiceUnitUnobservable { unit: u, property: p }
                                    UnitPropertyValue { value: wd } =>
                                      ServiceUnitObservedOk {
                                        observed: ServiceUnitObserved {
                                          load_state: load_state,
                                          unit_file_state: unit_file_state,
                                          active_state: active_state,
                                          sub_state: sub_state,
                                          result: result,
                                          exec_main_status: exec_main_status,
                                          exec_start: exec_start,
                                          user: user,
                                          working_directory: wd,
                                        },
                                      }
                                  }
                              }
                          }
                      }
                  }
              }
          }
      }
  }
}

// THE EXPECTATION IS DERIVED FROM R'S EMITTED UNIT FILE, never typed beside it.
type ServiceUnitExpectation {
  exec_start: String
  user: String
  working_directory: String
}

type ServiceUnitExpectationDerivation
  = ServiceExpectationDerived { expectation: ServiceUnitExpectation }
  | ServiceExpectationUnderivable { detail: String }

fn service_directive_exec_start(directives: List<SystemdServiceDirective>) -> String? {
  fold(directives, init: none, f: (acc, d) => match acc {
    Present { value: v } => Present { value: v }
    Absent => match d {
      ExecStart { command: c } => Present { value: c as String }
      RuntimeMaxSec { duration: _ } => none
      ServiceType { mode: _ } => none
      RemainAfterExit { active: _ } => none
      ExecStartPre { command: _ } => none
      ExecStartPost { command: _ } => none
      ExecStop { command: _ } => none
      ExecStopPost { command: _ } => none
      ExecReload { command: _ } => none
      ExecStopPostIgnoringFailure { command: _ } => none
      ServiceStandardOutput { stream: _ } => none
      ServiceStandardError { stream: _ } => none
      Restart { policy: _ } => none
      Environment { assignment: _ } => none
      LoadCredential { identifier: _, source: _ } => none
      EnvironmentFile { path: _ } => none
      EnvironmentFileIfPresent { path: _ } => none
      WorkingDirectory { path: _ } => none
      ServiceUser { name: _ } => none
      ServiceGroup { name: _ } => none
      ServiceSlice { name: _ } => none
      ServiceNice { priority: _ } => none
      ServiceIoSchedulingClass { scheduling_class: _ } => none
      TimeoutStartSec { duration: _ } => none
      ServiceExitType { exit_type: _ } => none
      ServiceKillMode { mode: _ } => none
      RestartSec { duration: _ } => none
      ServiceTasksMax { count: _ } => none
      ServiceResourceControl { directive: _ } => none
      TimeoutStopSec { duration: _ } => none
      ServiceUMask { mask: _ } => none
      // A capability directive constrains what the process MAY do; it carries no ExecStart, user or
      // working-directory fact, so it is a no-op for this extraction -- like the neighbouring knobs.
      ServiceCapabilityBoundingSet { capabilities: _ } => none
      ServiceAmbientCapabilities { capabilities: _ } => none
    }
  })
}

// THE UNIT'S REQUIRED READ PATHS, derived by ONE exhaustive match over SystemdServiceDirective. Every
// directive classifies as: a path the unit MUST have installed to come up, an OPTIONAL (IfPresent)
// read that systemd tolerates absent, or no file read at all. A new SystemdServiceDirective variant
// fails to compile until it is classified here -- the same fail-closed rule as the apply-leg classifiers
// (gunbc.design_argument::fail_closed: "it can be satisfied by editing the declaration while the
// realization still lies" is closed off by the compiler, not by a comment). No wildcard arm.
//
// WHY EACH CLASSIFICATION:
//   * ExecStart / ExecStartPre / ExecStartPost binaries -- the unit's START job execs these; if the
//     binary is absent the unit never reaches running, so the deploy that is meant to bring it up must
//     install it. argv[0] is the binary.
//   * WorkingDirectory -- systemd chdirs here on start and requires the directory to exist.
//   * EnvironmentFile (required) -- systemd reads the file into the unit's environment BEFORE the
//     process runs. The deploy installs it via its own apply leg (ApplyLegDigestEnvFile); omitting it
//     must halt the deploy rather than start a unit with a missing required input.
//   * LoadCredential -- systemd reads the source file to populate the unit's credential; the unit needs
//     it to come up, so it is a required read.
//   * EnvironmentFileIfPresent -- explicitly OPTIONAL (systemd tolerates absence); NOT a required read.
//   * ExecStop / ExecStopPost / ExecReload / ExecStopPostIgnoringFailure -- run on stop/reload, not on
//     the start the deploy performs; their binaries are not required reads for bring-up.
//   * everything else (Restart/RestartSec knobs, User, Group, Slice, Nice, Timeout*, StandardOutput, ...)
//     -- a scalar setting the unit carries, no file the unit reads to come up.
// The single classification: what each service directive contributes to the unit's REQUIRED reads (the
// files it must have installed to come up). A genuine coproduct, not a {path, class} tag: each variant
// carries only what it means. UnparsableCommand carries the offending command and NO path, so the bad
// state -- an unparsable read masquerading as a path -- is unwritable rather than merely caught
// (fail_closed: "stronger than catching a wrong state is making it unwritable"; "no plausible output is
// fabricated"). The single authoritative classification of "what files a unit must have installed to come
// up"; each deploy layer maps each variant to its own read representation (this lower stack -> a path;
// the gate -> a DeclaredRead with a kind), so there is one classifier at the lowest PR and no second copy
// at the gate.
type RequiredDirectiveRead =
    CommandRead { path: String }
  | WorkingDirectoryRead { path: String }
  | RequiredFileRead { path: String }
  | UnparsableCommand { command: NonEmptyStr }

fn service_directive_required_reads(directives: List<SystemdServiceDirective>) -> List<RequiredDirectiveRead> {
  fold(directives, init: [], f: (acc, d) => match d {
    ExecStart { command: c } => push_command_read(acc, command: c)
    ExecStartPre { command: c } => push_command_read(acc, command: c)
    ExecStartPost { command: c } => push_command_read(acc, command: c)
    WorkingDirectory { path: p } => list_push(xs: acc, item: WorkingDirectoryRead { path: p as String })
    EnvironmentFile { path: p } => list_push(xs: acc, item: RequiredFileRead { path: p as String })
    LoadCredential { identifier: _, source: s } => list_push(xs: acc, item: RequiredFileRead { path: s as String })
    EnvironmentFileIfPresent { path: _ } => acc
    ExecStop { command: _ } => acc
    ExecStopPost { command: _ } => acc
    ExecReload { command: _ } => acc
    ExecStopPostIgnoringFailure { command: _ } => acc
    ServiceType { mode: _ } => acc
    RemainAfterExit { active: _ } => acc
    ServiceStandardOutput { stream: _ } => acc
    ServiceStandardError { stream: _ } => acc
    Restart { policy: _ } => acc
    Environment { assignment: _ } => acc
    ServiceUser { name: _ } => acc
    ServiceGroup { name: _ } => acc
    ServiceSlice { name: _ } => acc
    ServiceNice { priority: _ } => acc
    ServiceIoSchedulingClass { scheduling_class: _ } => acc
    TimeoutStartSec { duration: _ } => acc
    RuntimeMaxSec { duration: _ } => acc
    ServiceExitType { exit_type: _ } => acc
    ServiceKillMode { mode: _ } => acc
    RestartSec { duration: _ } => acc
    ServiceTasksMax { count: _ } => acc
    ServiceResourceControl { directive: _ } => acc
    TimeoutStopSec { duration: _ } => acc
    ServiceUMask { mask: _ } => acc
    ServiceCapabilityBoundingSet { capabilities: _ } => acc
    ServiceAmbientCapabilities { capabilities: _ } => acc
  })
}

// one start command -> a CommandRead carrying its argv[0], or an UnparsableCommand carrying the command
// itself (and NO path) when argv[0] cannot be extracted, so the consuming layer refuses rather than
// fabricating an empty path.
fn push_command_read(acc: List<RequiredDirectiveRead>, command: NonEmptyStr) -> List<RequiredDirectiveRead> {
  match argv0_of_command(command as String) {
    Present { value: b } => list_push(xs: acc, item: CommandRead { path: b })
    Absent => list_push(xs: acc, item: UnparsableCommand { command: command })
  }
}

// argv[0] of a systemd Exec command line: the first whitespace-delimited token, absent when the token is
// empty (e.g. a leading-space command) or there is none. This is the ONE argv[0] extraction; the
// classifier's push_command_read is built on it (single authority), not a second split.
fn argv0_of_command(command: String) -> String? {
  match first(xs: split(s: command, delimiter: " ")) {
    Present { value: tok } => if tok == "" { none } else { Present { value: tok } }
    Absent => none
  }
}

// The required reads of an emitted unit file: its service directives (empty for a non-service unit file)
// passed to the single exhaustive classifier above.
fn service_directive_required_reads_of_unit_file(file: SystemdUnitFile) -> List<RequiredDirectiveRead> {
  match file {
    ServiceUnitFile { unit: _, service: ds, install: _ } => service_directive_required_reads(ds)
    TimerUnitFile { unit: _, timer: _, install: _ } => []
    SliceUnitFile { unit: _, slice: _, install: _ } => []
    PathUnitFile { unit: _, path: _, install: _ } => []
  }
}

// THE DirectoryNotEmpty= watched directories of a [Path] UNIT, in order. A .path unit has no ExecStart;
// its read of record is what it watches — the dirs that must EXIST for the level trigger to fire. Read
// from the unit's own PathUnitFile so a closure control can compare it to the read the intent records
// without going through the same helper both sides call.
fn watched_paths_of_unit_file(file: SystemdUnitFile) -> List<String> {
  match file {
    PathUnitFile { unit: _, path: pd, install: _ } =>
      fold(pd, init: [] as List<String>, f: (acc, d) => match d {
        DirectoryNotEmpty { path: p } => list_push(xs: acc, item: p as String)
        _ => acc
      })
    _ => [] as List<String>
  }
}

fn service_directive_user(directives: List<SystemdServiceDirective>) -> String? {
  fold(directives, init: none, f: (acc, d) => match acc {
    Present { value: v } => Present { value: v }
    Absent => match d {
      ServiceUser { name: n } => Present { value: n as String }
      RuntimeMaxSec { duration: _ } => none
      ServiceType { mode: _ } => none
      RemainAfterExit { active: _ } => none
      ExecStartPre { command: _ } => none
      ExecStart { command: _ } => none
      ExecStartPost { command: _ } => none
      ExecStop { command: _ } => none
      ExecStopPost { command: _ } => none
      ExecReload { command: _ } => none
      ExecStopPostIgnoringFailure { command: _ } => none
      ServiceStandardOutput { stream: _ } => none
      ServiceStandardError { stream: _ } => none
      Restart { policy: _ } => none
      Environment { assignment: _ } => none
      LoadCredential { identifier: _, source: _ } => none
      EnvironmentFile { path: _ } => none
      EnvironmentFileIfPresent { path: _ } => none
      WorkingDirectory { path: _ } => none
      ServiceGroup { name: _ } => none
      ServiceSlice { name: _ } => none
      ServiceNice { priority: _ } => none
      ServiceIoSchedulingClass { scheduling_class: _ } => none
      TimeoutStartSec { duration: _ } => none
      ServiceExitType { exit_type: _ } => none
      ServiceKillMode { mode: _ } => none
      RestartSec { duration: _ } => none
      ServiceTasksMax { count: _ } => none
      ServiceResourceControl { directive: _ } => none
      TimeoutStopSec { duration: _ } => none
      ServiceUMask { mask: _ } => none
      // A capability directive constrains what the process MAY do; it carries no ExecStart, user or
      // working-directory fact, so it is a no-op for this extraction -- like the neighbouring knobs.
      ServiceCapabilityBoundingSet { capabilities: _ } => none
      ServiceAmbientCapabilities { capabilities: _ } => none
    }
  })
}

fn service_directive_working_directory(directives: List<SystemdServiceDirective>) -> String? {
  fold(directives, init: none, f: (acc, d) => match acc {
    Present { value: v } => Present { value: v }
    Absent => match d {
      WorkingDirectory { path: p } => Present { value: p as String }
      RuntimeMaxSec { duration: _ } => none
      ServiceType { mode: _ } => none
      RemainAfterExit { active: _ } => none
      ExecStartPre { command: _ } => none
      ExecStart { command: _ } => none
      ExecStartPost { command: _ } => none
      ExecStop { command: _ } => none
      ExecStopPost { command: _ } => none
      ExecReload { command: _ } => none
      ExecStopPostIgnoringFailure { command: _ } => none
      ServiceStandardOutput { stream: _ } => none
      ServiceStandardError { stream: _ } => none
      Restart { policy: _ } => none
      Environment { assignment: _ } => none
      LoadCredential { identifier: _, source: _ } => none
      EnvironmentFile { path: _ } => none
      EnvironmentFileIfPresent { path: _ } => none
      ServiceUser { name: _ } => none
      ServiceGroup { name: _ } => none
      ServiceSlice { name: _ } => none
      ServiceNice { priority: _ } => none
      ServiceIoSchedulingClass { scheduling_class: _ } => none
      TimeoutStartSec { duration: _ } => none
      ServiceExitType { exit_type: _ } => none
      ServiceKillMode { mode: _ } => none
      RestartSec { duration: _ } => none
      ServiceTasksMax { count: _ } => none
      ServiceResourceControl { directive: _ } => none
      TimeoutStopSec { duration: _ } => none
      ServiceUMask { mask: _ } => none
      // A capability directive constrains what the process MAY do; it carries no ExecStart, user or
      // working-directory fact, so it is a no-op for this extraction -- like the neighbouring knobs.
      ServiceCapabilityBoundingSet { capabilities: _ } => none
      ServiceAmbientCapabilities { capabilities: _ } => none
    }
  })
}

fn service_unit_expectation_of(file: SystemdUnitFile) -> ServiceUnitExpectationDerivation {
  match file {
    ServiceUnitFile { unit: _, service: directives, install: _ } =>
      match service_directive_exec_start(directives: directives) {
        Absent => ServiceExpectationUnderivable { detail: "emitted service unit carries no ExecStart" }
        Present { value: exec_start } =>
          match service_directive_user(directives: directives) {
            Absent => ServiceExpectationUnderivable { detail: "emitted service unit carries no User" }
            Present { value: user } =>
              match service_directive_working_directory(directives: directives) {
                Absent => ServiceExpectationUnderivable { detail: "emitted service unit carries no WorkingDirectory" }
                Present { value: wd } =>
                  ServiceExpectationDerived { expectation: ServiceUnitExpectation { exec_start: exec_start, user: user, working_directory: wd } }
              }
          }
      }
    TimerUnitFile { unit: _, timer: _, install: _ } => ServiceExpectationUnderivable { detail: "expected a service unit file, got a timer" }
    SliceUnitFile { unit: _, slice: _, install: _ } => ServiceExpectationUnderivable { detail: "expected a service unit file, got a slice" }
    PathUnitFile { unit: _, path: _, install: _ } => ServiceExpectationUnderivable { detail: "expected a service unit file, got a path unit" }
  }
}

// systemctl show renders ExecStart as `{ path=P ; argv[]=A B C ; ignore_errors=no ; ... }`. The
// argv[] segment is the command line the unit file declared, which is what the emitted ExecStart
// directive is, so that segment is the exact comparand.
type ExecStartRead
  = ExecStartArgv { argv_text: String }
  | ExecStartUnparseable { value: String }

fn exec_start_argv_of_show_value(value: String) -> ExecStartRead {
  let parts = split(s: value, delimiter: "argv[]=")
  if length(xs: parts) < 2 {
    ExecStartUnparseable { value: value }
  } else {
    let tail = fold(parts, init: "", f: fn(_, seg) { seg })
    let argv_text = fold(split(s: tail, delimiter: " ; "), init: "", f: fn(acc, seg) { if acc == "" { seg } else { acc } })
    if argv_text == "" { ExecStartUnparseable { value: value } } else { ExecStartArgv { argv_text: trim(s: argv_text) } }
  }
}

type DashboardServiceStanding
  = DashboardServiceConverged { unit: String }
  | DashboardServiceRefused { unit: String, property: String, expected: String, observed: String }

// THE BELT'S EVENT PATH UNITS (dogfood intervention #4: there is no belt timer). A path unit is
// converged when it is loaded, enabled, active and armed (`waiting`, or `running` while its unit runs)
// and activates the unit the emitted file names. Its watched path is not read back here -- systemctl
// renders Paths= as a composite this row does not parse -- so the path is established by the emitted
// file the deploy installed and its byte comparison, not by this read; and this row proves only that
// the watcher is ARMED. Whether events are CONSUMED is the receipt's event backlog row.
type BeltEventPathStanding
  = BeltEventPathConverged { unit: String }
  | BeltEventPathRefused { unit: String, property: String, expected: String, observed: String }

type BeltOneshotStanding
  = BeltOneshotConverged { unit: String, active_state: String }
  | BeltOneshotRefused { unit: String, property: String, expected: String, observed: String }

fn judge_exec_start(unit: String, expected: String, observed_show: String) -> DashboardServiceStanding? {
  match exec_start_argv_of_show_value(value: observed_show) {
    ExecStartUnparseable { value: v } =>
      Present { value: DashboardServiceRefused { unit: unit, property: "ExecStart", expected: expected, observed: v } }
    ExecStartArgv { argv_text: a } =>
      if a == expected { none } else {
        Present { value: DashboardServiceRefused { unit: unit, property: "ExecStart", expected: expected, observed: a } }
      }
  }
}

fn judge_dashboard_service(unit: String, expect: ServiceUnitExpectation, o: ServiceUnitObserved) -> DashboardServiceStanding {
  if o.load_state != "loaded" {
    DashboardServiceRefused { unit: unit, property: "LoadState", expected: "loaded", observed: o.load_state }
  } else if o.unit_file_state != "enabled" {
    DashboardServiceRefused { unit: unit, property: "UnitFileState", expected: "enabled", observed: o.unit_file_state }
  } else if o.active_state != "active" {
    DashboardServiceRefused { unit: unit, property: "ActiveState", expected: "active", observed: o.active_state }
  } else if o.user != expect.user {
    DashboardServiceRefused { unit: unit, property: "User", expected: expect.user, observed: o.user }
  } else if o.working_directory != expect.working_directory {
    DashboardServiceRefused { unit: unit, property: "WorkingDirectory", expected: expect.working_directory, observed: o.working_directory }
  } else {
    match judge_exec_start(unit: unit, expected: expect.exec_start, observed_show: o.exec_start) {
      Present { value: refused } => refused
      Absent => DashboardServiceConverged { unit: unit }
    }
  }
}


// THE ONESHOT IS NOT SEPARATELY ENABLED (it has no [Install] section, so its UnitFileState is
// `static`), and it is normally INACTIVE between ticks. Both are the correct state and both are
// accepted; what is required is that its last run SUCCEEDED and that what it runs is exactly what R
// emitted.
fn judge_belt_oneshot(unit: String, expect: ServiceUnitExpectation, o: ServiceUnitObserved) -> BeltOneshotStanding {
  if o.load_state != "loaded" {
    BeltOneshotRefused { unit: unit, property: "LoadState", expected: "loaded", observed: o.load_state }
  } else if o.unit_file_state != "static" {
    BeltOneshotRefused { unit: unit, property: "UnitFileState", expected: "static", observed: o.unit_file_state }
  } else if o.active_state != "inactive" && o.active_state != "active" && o.active_state != "activating" {
    BeltOneshotRefused { unit: unit, property: "ActiveState", expected: "inactive|active|activating", observed: o.active_state }
  } else if o.result != "success" {
    BeltOneshotRefused { unit: unit, property: "Result", expected: "success", observed: o.result }
  } else if o.exec_main_status != "0" {
    BeltOneshotRefused { unit: unit, property: "ExecMainStatus", expected: "0", observed: o.exec_main_status }
  } else if o.user != expect.user {
    BeltOneshotRefused { unit: unit, property: "User", expected: expect.user, observed: o.user }
  } else if o.working_directory != expect.working_directory {
    BeltOneshotRefused { unit: unit, property: "WorkingDirectory", expected: expect.working_directory, observed: o.working_directory }
  } else {
    match exec_start_argv_of_show_value(value: o.exec_start) {
      ExecStartUnparseable { value: v } =>
        BeltOneshotRefused { unit: unit, property: "ExecStart", expected: expect.exec_start, observed: v }
      ExecStartArgv { argv_text: a } =>
        if a == expect.exec_start {
          BeltOneshotConverged { unit: unit, active_state: o.active_state }
        } else {
          BeltOneshotRefused { unit: unit, property: "ExecStart", expected: expect.exec_start, observed: a }
        }
    }
  }
}

type LaunchUnitStanding {
  dashboard: DashboardServiceStanding
  exit_path: BeltEventPathStanding
  answer_path: BeltEventPathStanding
  publication_path: BeltEventPathStanding
  publication_helper: BeltOneshotStanding
  oneshot: BeltOneshotStanding
}

fn dashboard_service_standing_text(s: DashboardServiceStanding) -> String {
  match s {
    DashboardServiceConverged { unit: u } => join(["dashboard service ", u, " converged"], "")
    DashboardServiceRefused { unit: u, property: p, expected: e, observed: o } =>
      join(["dashboard service ", u, " ", p, " expected ", e, " observed ", o], "")
  }
}

fn belt_event_path_standing_text(s: BeltEventPathStanding) -> String {
  match s {
    BeltEventPathConverged { unit: u } => join(["belt event path ", u, " converged"], "")
    BeltEventPathRefused { unit: u, property: p, expected: e, observed: o } =>
      join(["belt event path ", u, " ", p, " expected ", e, " observed ", o], "")
  }
}

fn belt_oneshot_standing_text(s: BeltOneshotStanding) -> String {
  match s {
    BeltOneshotConverged { unit: u, active_state: a } => join(["belt service ", u, " converged (", a, ")"], "")
    BeltOneshotRefused { unit: u, property: p, expected: e, observed: o } =>
      join(["belt service ", u, " ", p, " expected ", e, " observed ", o], "")
  }
}

fn launch_unit_standing_text(s: LaunchUnitStanding) -> String {
  join([
    dashboard_service_standing_text(s: s.dashboard), "; ",
    belt_event_path_standing_text(s: s.exit_path), "; ",
    belt_event_path_standing_text(s: s.answer_path), "; ",
    belt_event_path_standing_text(s: s.publication_path), "; ",
    belt_oneshot_standing_text(s: s.publication_helper), "; ",
    belt_oneshot_standing_text(s: s.oneshot),
  ], "")
}

// THE LIVE READ, one per unit, each judged against the expectation derived from R's emission.
fn observe_dashboard_service_standing(unit: NonEmptyStr, file: SystemdUnitFile) -> DashboardServiceStanding {
  match service_unit_expectation_of(file: file) {
    ServiceExpectationUnderivable { detail: d } =>
      DashboardServiceRefused { unit: unit as String, property: "expectation", expected: "derivable from emitted unit", observed: d }
    ServiceExpectationDerived { expectation: e } =>
      match observe_service_unit(unit: unit) {
        ServiceUnitUnobservable { unit: u, property: p } =>
          DashboardServiceRefused { unit: u, property: p, expected: "readable", observed: "systemctl show refused" }
        ServiceUnitObservedOk { observed: o } => judge_dashboard_service(unit: unit as String, expect: e, o: o)
      }
  }
}

fn path_unit_target_of(file: SystemdUnitFile) -> String? {
  match file {
    PathUnitFile { unit: _, path: directives, install: _ } =>
      fold(directives, init: none, f: (acc, d) => match acc {
        Present { value: v } => Present { value: v }
        Absent => match d {
          PathUnit { target: t } => Present { value: t as String }
          DirectoryNotEmpty { path: _ } => none
          PathChanged { path: _ } => none
          MakeDirectory { enabled: _ } => none
          TriggerLimitIntervalSec { duration: _ } => none
          TriggerLimitBurst { count: _ } => none
        }
      })
    ServiceUnitFile { unit: _, service: _, install: _ } => none
    TimerUnitFile { unit: _, timer: _, install: _ } => none
    SliceUnitFile { unit: _, slice: _, install: _ } => none
  }
}

fn observe_belt_event_path_standing(unit: NonEmptyStr, file: SystemdUnitFile) -> BeltEventPathStanding {
  match path_unit_target_of(file: file) {
    Absent => BeltEventPathRefused { unit: unit as String, property: "expectation", expected: "derivable from emitted unit", observed: "the emitted unit is not a path unit naming a Unit= target" }
    Present { value: target } =>
      match read_unit_property(unit: unit, property: LoadState) {
        UnitPropertyUnreadable { unit: u, property: p } => BeltEventPathRefused { unit: u, property: p, expected: "readable", observed: "systemctl show refused" }
        UnitPropertyValue { value: load } =>
          if load != "loaded" { BeltEventPathRefused { unit: unit as String, property: "LoadState", expected: "loaded", observed: load } } else {
            match read_unit_property(unit: unit, property: UnitFileState) {
              UnitPropertyUnreadable { unit: u, property: p } => BeltEventPathRefused { unit: u, property: p, expected: "readable", observed: "systemctl show refused" }
              UnitPropertyValue { value: file_state } =>
                if file_state != "enabled" { BeltEventPathRefused { unit: unit as String, property: "UnitFileState", expected: "enabled", observed: file_state } } else {
                  match read_unit_property(unit: unit, property: ActiveState) {
                    UnitPropertyUnreadable { unit: u, property: p } => BeltEventPathRefused { unit: u, property: p, expected: "readable", observed: "systemctl show refused" }
                    UnitPropertyValue { value: active } =>
                      if active != "active" { BeltEventPathRefused { unit: unit as String, property: "ActiveState", expected: "active", observed: active } } else {
                        match read_unit_property(unit: unit, property: SubState) {
                          UnitPropertyUnreadable { unit: u, property: p } => BeltEventPathRefused { unit: u, property: p, expected: "readable", observed: "systemctl show refused" }
                          UnitPropertyValue { value: sub } =>
                            if sub != "waiting" && sub != "running" { BeltEventPathRefused { unit: unit as String, property: "SubState", expected: "waiting|running", observed: sub } } else {
                              match read_unit_property(unit: unit, property: Unit) {
                                UnitPropertyUnreadable { unit: u, property: p } => BeltEventPathRefused { unit: u, property: p, expected: "readable", observed: "systemctl show refused" }
                                UnitPropertyValue { value: observed_target } =>
                                  if observed_target != target { BeltEventPathRefused { unit: unit as String, property: "Unit", expected: target, observed: observed_target } } else { BeltEventPathConverged { unit: unit as String } }
                              }
                            }
                        }
                      }
                  }
                }
            }
          }
      }
  }
}

fn observe_belt_oneshot_standing(unit: NonEmptyStr, file: SystemdUnitFile) -> BeltOneshotStanding {
  match service_unit_expectation_of(file: file) {
    ServiceExpectationUnderivable { detail: d } =>
      BeltOneshotRefused { unit: unit as String, property: "expectation", expected: "derivable from emitted unit", observed: d }
    ServiceExpectationDerived { expectation: e } =>
      match observe_service_unit(unit: unit) {
        ServiceUnitUnobservable { unit: u, property: p } =>
          BeltOneshotRefused { unit: u, property: p, expected: "readable", observed: "systemctl show refused" }
        ServiceUnitObservedOk { observed: o } => judge_belt_oneshot(unit: unit as String, expect: e, o: o)
      }
  }
}

// NOTE: the file-level argv[0]/WorkingDirectory parse that the closure's file-agreement control needs lives
// in the witness module as a labeled TEST ORACLE, not here. Production derives a service unit's reads only
// through the exhaustive classifier service_directive_required_reads_of_unit_file above (single authority);
// a second production route to argv[0]/WorkingDirectory would be a meaning fork with no consumer.

// The [Service] Type= of a unit file, from its OWN directives -- the unit's kind (oneshot, simple, ...).
// Carried here (not re-derived at the gate) so the deploy-artifact gate can match a tree read's
// converger to the leg that brings it up (oneshot -> start/restart, long-running -> enable).
fn service_type_of_unit_file(file: SystemdUnitFile) -> SystemdServiceMode? {
  match file {
    ServiceUnitFile { unit: _, service: ds, install: _ } =>
      fold(ds, init: none, f: (acc, d) => match acc {
        Present { value: v } => Present { value: v }
        Absent => match d {
          ServiceType { mode: m } => Present { value: m }
          _ => none
        }
      })
    _ => none
  }
}

// Two independent accessors the closure WITNESS uses to cross-check the read set against the raw
// emitted unit text WITHOUT calling the same derivation the gate uses (an oracle must not reuse its
// subject). The read SET itself derives from service_directive_required_reads, NOT from these.
fn exec_start_binary_of_unit_file(file: SystemdUnitFile) -> String? {
  let command = service_directive_exec_start_of_unit_file(file)
  match command {
    Present { value: cmd } => argv0_of_command(cmd)
    Absent => none
  }
}

fn working_directory_of_unit_file(file: SystemdUnitFile) -> String? {
  service_directive_working_directory_of_unit_file(file)
}
