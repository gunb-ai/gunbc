module gunbc.live_deploy.coordination

import std.types { String, List, NonEmptyStr, Bool }
import gunbc.fleet_intent { HostIdentity }
import gunbc.host_effect {
  HostEffectTransport,
  LocalShell,
  SshShell,
  EmitArtifactThenThinRun,
}
import extdeps.exec.command { CommandTransport, LocalExec, SshExec }
import v2.std.algebra { list_head, ListHeadResult, HeadFound, HeadAbsent }
import gunbc.live_deploy.revision { DeploymentTarget, deploy_target_key }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import gunbc.output_policy { ExpectSuccess }
import extdeps.tools.hostname

data coordination_coverage_note: String = "THE FAILURE CLASS THIS MODULE EXISTS FOR IS COORDINATION-COVERAGE MISMATCH (operator ruling 2026-08-05): a coordination mechanism is valid only when its resource identity, execution locus, lifetime, participant population, and outcome partition COVER the effects it claims to coordinate. Every one of those is an axis on which a lock can be present, well-formed, and still protect nothing.\\n\\nTHIS REPLACES A POLICY MATCH, AND THE REPLACEMENT IS THE POINT. The first repair of the SSH defect was `match transport { LocalShell => admit, SshShell => refuse }` — correct in its verdict and wrong in its form, because the safety property was encoded as a list of transport NAMES. Under that shape a future remote-session transport becomes admissible by someone editing `SshShell => false` to `SshShell => true`, which would also re-admit today's discrete-command SSH realization: the edit that adds the safe case cannot be distinguished from the edit that admits the unsafe one.\\n\\nSo transports PROJECT OBSERVATIONS and this module DECIDES. A transport says where its effects land and how long a lock taken through it survives; coverage is then derived by comparing those facts against what the operation requires. A future transport becomes admissible by supplying the right behavioural facts — never by being added to an allow-list.\\n\\nTHE AXES ARE SEPARATE BECAUSE THEY FAIL SEPARATELY, and this PR's own history is the evidence: a lock on the wrong HOST (locus), a lock spanning one command instead of the whole cutover (extent), and apply leased while retract bypassed it (population) are three distinct defects that a single Bool would have collapsed into one indistinguishable 'is it locked' question."

data execution_locus_note: String = "WHERE THE EFFECTS ACTUALLY LAND, as an observation rather than a transport name. CurrentHost means the effects execute in this process's own machine, so a lock taken by this process is on the same host as the mutations BY CONSTRUCTION — that is the structural fact, not 'the CI runner happens to be srv1'. NamedHost means the effects land on a different, named machine, so a lock taken here is on the wrong one.\\n\\nDeferredExecution is separate from both because the effects are handed to ANOTHER process to run later: there is no interval during which this process could hold anything covering them. ExecutionLocusUnobserved is the fail-closed arm — 'I could not determine where these effects land' is not 'they land here', and collapsing them is the ⊥-as-ignorance-read-as-⊥-as-answer shape DESIGN §5 forbids."

type ExecutionLocus
  = CurrentHost { host: HostIdentity }
  | NamedHost { host: HostIdentity }
  | DeferredExecution
  | ExecutionLocusUnobserved

data coordination_extent_note: String = "HOW LONG A LOCK TAKEN THROUGH THIS MECHANISM SURVIVES. OneCommand is a lock that exists only for the duration of a single invocation — `ssh host flock ... cmd` releases the moment that command returns, so a caller performing several such invocations holds nothing between them. ProcessLifetime is flock(2)'s actual guarantee for a wrapped process: held across exec, released exactly on process exit including abnormal exit. SessionLifetime is the not-yet-built arm where one remote session holds a lock across many discrete remote effects.\\n\\nThe ordering matters and is deliberately NOT a numeric comparison: a required extent is satisfied by a provided one only when the provided arm's guarantee contains the required interval, which coordination_extent_covers states as a total fold rather than leaving each caller to compare enum positions."

type CoordinationExtent
  = OneCommand
  | ProcessLifetime
  | SessionLifetime

data mutation_kind_note: String = "THE POPULATION AXIS: every kind of change that touches this target's coordinated resources. A retract mutates the same slot, units and files an apply does, so a coordination mechanism covering only Apply leaves a real mutator outside the lock — which is exactly the state this PR shipped before the operator caught it (the carrier note claimed 'every public mutation entry routes through the leased launcher' while both retract entries did not).\\n\\nRouteFlip and SlotRevisionRecord are listed as their own kinds even though today they occur only inside an Apply, because the population question is 'what can change these resources', not 'what entrypoints exist'. A future entrypoint that flips the route alone would be a new participant, and it has to appear here to be checked."

type DeployMutationKind
  = MutateApply
  | MutateRetract
  | MutateRouteFlip
  | MutateSlotRevisionRecord

fn deploy_mutation_kind_key(kind: DeployMutationKind) -> String {
  match kind {
    MutateApply => "apply"
    MutateRetract => "retract"
    MutateRouteFlip => "route-flip"
    MutateSlotRevisionRecord => "slot-revision-record"
  }
}

data participant_grain_note: String = "THE POPULATION IS JOINED AT PARTICIPANT IDENTITY, NOT AT MUTATION KIND (operator ruling 2026-08-05). An earlier revision compared two lists of KINDS, and both listed the same four — so it detected a new kind added without coverage, and was blind to the thing that actually happens: a fifth public function performing an EXISTING kind. A new entrypoint flipping the route would find MutateRouteFlip already in both sets and the admission would stay green while a real mutator sat outside the lease. That is coverage measured at a grain coarser than the failure.\\n\\nSo a participant is a DeclarationRef paired with what it mutates, and the join is on the declaration. The kind survives because it still carries the answer to 'what would this change', which is what the refusal reason needs to be actionable.\\n\\nWHAT THIS IS AND IS NOT, stated so the rung is not inflated. The population roster below is HAND-AUTHORED, so this joins two authored lists at identity grain — it makes an uncovered participant unrepresentable in the admission once someone lists it, and it does NOT discover a participant nobody listed. Under the DESIGN §5 oracle rule that is a roster, not a closed subject universe: the discovering half needs a lens over the corpus that finds every declaration reaching a deploy mutation and joins it against this roster. 🟡 dissolve-on: that lens lands and supplies mutation_population by discovery, at which point this roster becomes the covered side only."

type DeployMutator {
  declaration: DeclarationRef
  kind: DeployMutationKind
}

fn deploy_mutator_key(m: DeployMutator) -> String {
  join(
    [
      m.declaration.module_path,
      ".",
      m.declaration.decl_name,
      " (",
      deploy_mutation_kind_key(kind: m.kind),
      ")"
    ],
    ""
  )
}

data coordination_subject_note: String = "ONE VALUE CARRYING BOTH SIDES OF EVERY AXIS, so coverage is a comparison rather than a judgement. The lease side and the mutation side are named separately on purpose: the whole class of defect here is the two silently differing while a lock is genuinely held, well-formed, and useless."

type DeployCoordinationSubject {
  target: DeploymentTarget
  lease_locus: ExecutionLocus
  mutation_locus: ExecutionLocus
  lease_extent: CoordinationExtent
  required_extent: CoordinationExtent
  mutation_population: List<DeployMutator>
  covered_population: List<DeployMutator>
}

type CoordinationRefusalCause
  = CoordinationLocusMismatch { lease_host: String, mutation_host: String }
  | CoordinationExtentTooShort
  | MutationEntrypointUncovered { participant: String }
  | CoordinationLocusUnobserved

type CoordinationAdmission
  = CoordinationCovers
  | CoordinationRefused { cause: CoordinationRefusalCause }

data locus_agreement_note: String = "TWO LOCI AGREE WHEN THEY NAME THE SAME MACHINE, AND THAT IS ALL THIS AXIS DECIDES (operator ruling 2026-08-05). An earlier revision refused EVERY NamedHost lease locus before it looked at extent, on the reasoning that 'a lock this process takes locally does not become a lock on that machine by naming it'. That sentence is true and it is about a DIFFERENT pair: a lock taken locally has lease locus CurrentHost, so the local-lock/SSH-effects fabrication is already caught as CurrentHost × NamedHost. Refusing NamedHost × NamedHost as well folded the extent question into the locus arm and made the module's own stated escape hatch unreachable — no SessionLifetime value could ever admit the future remote path, so enabling it would have required editing this match, which is precisely what transports-project-facts was built to avoid.\\n\\nSo the fold is now symmetric on identity: same machine covers, everything unequal, deferred or unobserved refuses. Today's SshExec reaches the correct named host and is refused on EXTENT, because `ssh host flock ... cmd` releases when that command returns — a fact about the realization, reported by the transport, not a policy about SSH. A future remote session holding one lock across the whole remote apply reports SessionLifetime on the same NamedHost locus and admits without a policy edit. That is the separation the two axes exist for."

fn execution_locus_host_text(locus: ExecutionLocus) -> String {
  match locus {
    CurrentHost { host: h } => concat("this process's own host (", concat(h as String, ")"))
    NamedHost { host: h } => concat("remote host ", h as String)
    DeferredExecution => "a deferred executor"
    ExecutionLocusUnobserved => "an unobserved locus"
  }
}

data deferred_is_not_unobserved_note: String = "DEFERRED AND UNOBSERVED ARE DIFFERENT REFUSALS, and collapsing them would be the state-space conflation this module was built to avoid — committed briefly while making the locus fold symmetric on identity. 'The effects are handed to another process to run later' is a KNOWN locus that no lease held here can cover, which is a mismatch; 'I could not determine where these effects land' is ignorance, which is the unobserved arm. The two have different remedies — the first needs a different coordination mechanism, the second needs an observation to succeed — so they keep different causes."

fn locus_machine_identity(locus: ExecutionLocus) -> ObservedMachine {
  match locus {
    CurrentHost { host: h } => MachineNamed { host: h }
    NamedHost { host: h } => MachineNamed { host: h }
    DeferredExecution => MachineDeferred
    ExecutionLocusUnobserved => MachineUnobserved
  }
}

type ObservedMachine
  = MachineNamed { host: HostIdentity }
  | MachineDeferred
  | MachineUnobserved

fn coordination_locus_covers(lease: ExecutionLocus, mutation: ExecutionLocus) -> CoordinationAdmission {
  match locus_machine_identity(locus: lease) {
    MachineUnobserved => CoordinationRefused { cause: CoordinationLocusUnobserved }
    MachineDeferred =>
      CoordinationRefused {
        cause: CoordinationLocusMismatch {
          lease_host: execution_locus_host_text(locus: lease),
          mutation_host: execution_locus_host_text(locus: mutation),
        }
      }
    MachineNamed { host: lease_host } =>
      match locus_machine_identity(locus: mutation) {
        MachineUnobserved => CoordinationRefused { cause: CoordinationLocusUnobserved }
        MachineDeferred =>
          CoordinationRefused {
            cause: CoordinationLocusMismatch {
              lease_host: execution_locus_host_text(locus: lease),
              mutation_host: execution_locus_host_text(locus: mutation),
            }
          }
        MachineNamed { host: mutation_host } =>
          if lease_host == mutation_host {
            CoordinationCovers
          } else {
            CoordinationRefused {
              cause: CoordinationLocusMismatch {
                lease_host: execution_locus_host_text(locus: lease),
                mutation_host: execution_locus_host_text(locus: mutation),
              }
            }
          }
      }
  }
}

data extent_covers_note: String = "A PROVIDED EXTENT COVERS A REQUIRED ONE WHEN ITS INTERVAL CONTAINS THE REQUIRED INTERVAL. OneCommand covers only OneCommand. ProcessLifetime covers a single command and a whole local process, but NOT a session spanning discrete remote effects — a local process's flock says nothing about a remote machine's state between SSH invocations. SessionLifetime covers all three. Written as a total fold rather than an ordering on positions, so adding an arm forces a decision instead of inheriting a comparison."

fn coordination_extent_covers(provided: CoordinationExtent, required: CoordinationExtent) -> Bool {
  match provided {
    OneCommand =>
      match required {
        OneCommand => true
        ProcessLifetime => false
        SessionLifetime => false
      }
    ProcessLifetime =>
      match required {
        OneCommand => true
        ProcessLifetime => true
        SessionLifetime => false
      }
    SessionLifetime =>
      match required {
        OneCommand => true
        ProcessLifetime => true
        SessionLifetime => true
      }
  }
}

data population_completeness_note: String = "EVERY MUTATOR MUST BE COVERED, and the check is an identity join over the population rather than a count. A count would green when one mutator was added and another dropped in the same change, which is the failure the DESIGN §5 oracle rule names: completeness is an identity join, not a count equality."

fn coordination_population_covers(
  mutation_population: List<DeployMutator>,
  covered: List<DeployMutator>,
) -> CoordinationAdmission {
  let uncovered = filter(
    mutation_population,
    m => !any(covered, c => deploy_mutator_key(m: c) == deploy_mutator_key(m: m))
  )
  match list_head(xs: uncovered) {
    HeadAbsent => CoordinationCovers
    HeadFound { value: m } =>
      CoordinationRefused {
        cause: MutationEntrypointUncovered { participant: deploy_mutator_key(m: m) }
      }
  }
}

data admission_conjunction_note: String = "THE AXES CONJOIN AND THE FIRST REFUSAL WINS, so a subject failing on two axes reports the one a reader should act on first: an unobserved or mismatched locus makes the extent question moot, and both make the population question moot. Nothing is widened — every arm that is not full coverage is a typed, located refusal."

fn deploy_coordination_admission(subject: DeployCoordinationSubject) -> CoordinationAdmission {
  match coordination_locus_covers(lease: subject.lease_locus, mutation: subject.mutation_locus) {
    CoordinationRefused { cause: why } => CoordinationRefused { cause: why }
    CoordinationCovers =>
      if !coordination_extent_covers(provided: subject.lease_extent, required: subject.required_extent) {
        CoordinationRefused { cause: CoordinationExtentTooShort }
      } else {
        coordination_population_covers(
          mutation_population: subject.mutation_population,
          covered: subject.covered_population,
        )
      }
  }
}

data transport_projection_note: String = "TRANSPORTS PROJECT FACTS; THEY DO NOT DECIDE POLICY. Each arm answers only 'where do effects driven through me land' and 'how long does a lock taken through me survive', and the admission above derives coverage from those answers. That is what lets a future remote-session transport become admissible by reporting SessionLifetime on a NamedHost lease locus, without anyone editing a match arm from refuse to admit — and it is why re-admitting today's discrete-command SSH realization would require claiming a lifetime it does not have, which is a lie about behaviour rather than a policy edit."

fn host_effect_mutation_locus(transport: HostEffectTransport) -> ExecutionLocus {
  match transport {
    LocalShell => observed_current_host()
    SshShell { ssh_host: h } => NamedHost { host: h as String as HostIdentity }
    EmitArtifactThenThinRun { bootstrap: _, invocation: _ } => DeferredExecution
  }
}

data current_host_must_be_observed_note: String = "CurrentHost CARRIES AN OBSERVED HOSTNAME, NOT THE TARGET CONSTANT, and the difference is the whole honesty of the locus axis. An earlier revision returned `CurrentHost { host: target_host }` for LocalExec — which ASSERTS that this process is running on the target rather than establishing it. That happens to be true for the CI runner and would be false for anyone running the launcher elsewhere, so the model would have reported locus agreement on the strength of an assumption dressed as an observation: the exact substitution this module exists to make impossible.\\n\\nSo the local arm reads `hostname -s` and reports what it finds. A failed read is ExecutionLocusUnobserved, never a fallback to the target — 'I could not tell which machine I am on' is not 'I am on the right one'. Remote transports need no observation because NamedHost is already a statement that the effects land somewhere this process is not."

fn observed_current_host() -> ExecutionLocus {
  let read = os.Hostname.ReadShort(expect: ExpectSuccess)
  if !read.success || read.value == "" {
    ExecutionLocusUnobserved
  } else {
    CurrentHost { host: read.value as HostIdentity }
  }
}

fn command_transport_lease_locus(transport: CommandTransport) -> ExecutionLocus {
  match transport {
    LocalExec => observed_current_host()
    SshExec { ssh_target: h } => NamedHost { host: h as String as HostIdentity }
  }
}

data lease_extent_projection_note: String = "flock(2) HOLDS ACROSS exec AND RELEASES ON PROCESS EXIT, so a locally wrapped process gives ProcessLifetime — the whole inner reconciliation, including abnormal exit. The same flock reached over SSH gives only OneCommand: the remote shell exits when that invocation returns, releasing the lock, so a caller performing several discrete remote effects holds nothing between them. That is a fact about the realization, not a policy about SSH, and it is why the extent axis refuses the remote-flock spelling independently of the locus axis."

fn command_transport_lease_extent(transport: CommandTransport) -> CoordinationExtent {
  match transport {
    LocalExec => ProcessLifetime
    SshExec { ssh_target: _ } => OneCommand
  }
}

data deploy_required_extent_note: String = "THE CUTOVER REQUIRES ProcessLifetime because it is one transaction across several host effects — observe the route, prepare and verify the idle slot, record its revision, flip the route, verify the routed result, retire the old runtime. A mechanism covering any single one of those leaves the others unguarded, which is the original observe-then-mutate race displaced by one phase rather than removed."

data deploy_required_extent: CoordinationExtent = ProcessLifetime

data deploy_mutation_population_note: String = "EVERY DECLARATION THAT CAN CHANGE THIS TARGET'S COORDINATED RESOURCES, NAMED. The four public entrypoints are here because they are what a caller reaches; the two internal actuators are here because the question is what can change the resources, not what is publicly callable — a future entrypoint that flips the route alone would be a new row and would have to be covered before the admission greens. Named symbolically per DESIGN §3: module plus declaration, never a file position."

fn deploy_mutator_of(decl_name: String, kind: DeployMutationKind) -> DeployMutator {
  DeployMutator {
    declaration: DeclarationRef {
      module_path: "gunbc.live_deploy.apply",
      decl_name: decl_name,
      field: WholeDeclaration,
    },
    kind: kind,
  }
}

fn deploy_mutation_population() -> List<DeployMutator> {
  [
    deploy_mutator_of(decl_name: "live_deploy_apply_srv1_wet", kind: MutateApply),
    deploy_mutator_of(decl_name: "live_deploy_apply_srv1_operator_wet", kind: MutateApply),
    deploy_mutator_of(decl_name: "live_deploy_retract_srv1_wet", kind: MutateRetract),
    deploy_mutator_of(decl_name: "live_deploy_retract_srv1_operator_wet", kind: MutateRetract),
    deploy_mutator_of(decl_name: "live_deploy_flip_route_to_recorded_candidate", kind: MutateRouteFlip),
    deploy_mutator_of(decl_name: "live_deploy_record_slot_revision", kind: MutateSlotRevisionRecord),
  ]
}

fn coordination_refusal_reason(target: DeploymentTarget, cause: CoordinationRefusalCause) -> NonEmptyStr {
  let prefix = concat("deploy refused on target ", concat(deploy_target_key(target: target), ": "))
  match cause {
    CoordinationLocusMismatch { lease_host: lh, mutation_host: mh } =>
      join(
        [
          prefix,
          "an exclusive lease taken on ", lh,
          " cannot serialize mutations that land on ", mh,
          ". Refusing rather than reporting a lease that excludes nobody"
        ],
        ""
      ) as NonEmptyStr
    CoordinationExtentTooShort =>
      join(
        [
          prefix,
          "the lease survives only one command while the cutover spans several host effects, so another mutator can act between them. Refusing rather than holding a lock that lapses mid-transaction"
        ],
        ""
      ) as NonEmptyStr
    MutationEntrypointUncovered { participant: p } =>
      join(
        [
          prefix,
          p,
          " can change this target's resources but is not covered by the lease, so a lease held by another mutator does not exclude it"
        ],
        ""
      ) as NonEmptyStr
    CoordinationLocusUnobserved =>
      join(
        [
          prefix,
          "the execution locus of the lease or of the mutations could not be observed. 'I could not determine where these effects land' is not 'they land here'"
        ],
        ""
      ) as NonEmptyStr
  }
}
