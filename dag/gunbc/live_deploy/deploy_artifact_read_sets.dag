module gunbc.live_deploy.deploy_artifact_read_sets

// gunbc/live_deploy/deploy_artifact_read_sets — the read-of-record for each enabled deployment
// artifact, joined to the deploy enable authority and consumed by the generic artifact closure.
//
// Roadmap node: deploy-intent-owns-artifact-closure (node://adhoc-3e6e9bfb-d59, identity
//   rn_Z0G9G30XDNQJG7QYJ0M6NAVY0T, dag/gunbc/roadmap/roadmap_authority.dag, landed by #16504).
//
// WHY THIS LIVES HERE (not in gunbc.live_deploy.spec, where owned_artifact_teardown_disposition
// sits): it is the same per-kind TOTAL-MATCH shape as that precedent — a new OwnedArtifactKind
// cannot inherit a read-set answer by omission, the match fails to compile until the kind states
// its own — but it needs to import each enabled unit's OWN module (for the launcher helpers root
// and, in follow-ups, the ExecStart argv of each unit module). spec cannot import those roadmap
// unit modules: attempt_system_unit_launch already reaches spec through the runner/fabric chain
// (attempt_system_unit_launch -> dispatch_worker_unit_confinement -> ... -> live_deploy.desired ->
// served_slice_charge -> spec), so spec -> attempt_system_unit_launch closes a cycle. This module
// is a leaf adapter: it imports the enable authority (spec) and the unit modules, and nothing
// imports it, so no cycle. The generic closure (gunbc.live_deploy.deploy_artifact_closure) stays
// model-agnostic and stays consumable by the fleet-converge actuation path over its own enable rows.

import std.types { List, String }
import std.optional { Optional, Present, Absent }
import std.algebra { list_map }
import gunbc.live_deploy.deploy_artifact_closure { ArtifactReadSet, DeployReadRow, ReadRow, Declared, NotYetModeled }
import gunbc.live_deploy.spec {
  DeploymentArtifactStep, ComposeOwned, UpsertOwned,
  SystemdUnit, FleetConvergeTimerUnit, FabricStorageServeUnit, FabricStorageServeMapping,
  TailnetDoorServeUnit, AgentDoorServeUnit, OidcConfigArtifact,
  ServeBinary, GunbcSourceTree, BeltEventPathUnit, TailscaleServeMapping,
  DeployedTreeRemoteUnit, PublicationHelperPathUnit, AttemptUnitDrainPathUnit, ApprovalBrokerFrontDoor
}
import gunbc.roadmap.attempt_system_unit_launch { attempt_unit_drain_read_paths }
import gunbc.roadmap.roadmap_dashboard_instance { HostDashboardInstance }
import gunbc.live_deploy.release_locus { ReleaseRevisionBinding }
import gunbc.live_deploy.spec { DeploymentSpec }
import gunbc.live_deploy.unit_standing { exec_start_binary_of_unit_file, working_directory_of_unit_file }
import gunbc.live_deploy.emit {
  live_deploy_serve_unit_file_over, live_deploy_approval_broker_unit_file_for_closure,
  live_deploy_tailnet_door_unit_file_for_closure, live_deploy_agent_door_unit_file_for_closure,
}
import extdeps.systemd.unit_file { SystemdUnitFile }

// THE READ-SET OF AN ENABLED ARTIFACT, per kind and total (the same total-over-kinds guarantee as
// gunbc.live_deploy.spec owned_artifact_teardown_disposition). WHAT a unit reads is sourced from
// that unit's OWN module: the serve binary from ServeBinary's admitted ExecStart path (the step's
// own path), the drain from gunbc.roadmap.attempt_system_unit_launch attempt_unit_drain_read_paths
// (its revision-bound helper snapshot). A kind whose read is a revision-bound snapshot is given the
// deployment's instance and revision so its module can derive the real path from its OWN authority;
// kinds that do not need them ignore them. A follow-up PR adds one read-set fn to a unit module and
// flips that arm to Declared; nothing in the generic closure changes (single_authority: a second
// place that independently decides a unit's reads is a fork; minimize_redundancy: net concepts must
// not grow by re-invention).
//
// A kind the closure cannot yet check is NotYetModeled WITH A NAMED REASON, never a silent allow:
// the three-valued verdict turns an uncheckable read into a typed, located, countable Unclosed
// (fail_closed: "every degradation is typed, located and countable"; "Failing to compute the answer
// is a different outcome from computing a conservative one"). Under the frontier contract on
// ClosureVerdict, Unclosed must refuse a deploy exactly as Refused does when the apply_legs verify
// leg lands; there is no "warn and continue" arm.
// THE read-set of a SERVICE unit, read from its OWN typed unit file via the unit_standing readers:
// {argv[0] (the binary it execs), WorkingDirectory (the tree it loads `--entry` from)}. The unit file
// is produced by the SAME emit function the deploy emits it through (for the doors, the OIDC-factored
// closure accessor), so the read is the unit's own declaration, not a transcription. A spec that does
// not enable the unit (accessor Absent) or a file with no service ExecStart is NotYetModeled WITH A
// REASON (never a silent allow).
fn unit_file_read_set(file: SystemdUnitFile?) -> ArtifactReadSet {
  match file {
    Absent => NotYetModeled { reason: "this spec does not enable the unit (its unit file is not emitted); no read of record to own" }
    Present { value: f } => match exec_start_binary_of_unit_file(file: f) {
      Absent => NotYetModeled { reason: "the emitted unit file carries no service ExecStart; its read is not modeled here (DISSOLUTION: model the unit's argv)" }
      Present { value: binary } => match working_directory_of_unit_file(file: f) {
        Present { value: wd } => Declared { paths: [binary, wd] }
        Absent => Declared { paths: [binary] }
      }
    }
  }
}

fn deployment_artifact_read_set(step: DeploymentArtifactStep, spec: DeploymentSpec, instance: HostDashboardInstance, revision: ReleaseRevisionBinding) -> ArtifactReadSet {
  match step.kind {
    ComposeOwned { kind: ck } => match ck {
      // THE SERVED UNIT reads {its ExecStart binary, its WorkingDirectory tree}, both read from its OWN
      // typed unit file (live_deploy_serve_unit_file_over with the OIDC Environment factored to []) via the
      // unit_standing readers — the same file the deploy emits, so if its ExecStart changes the read follows.
      SystemdUnit => unit_file_read_set(Present { value: live_deploy_serve_unit_file_over(spec: spec, revision: revision, oidc_env: []) })
      FleetConvergeTimerUnit => NotYetModeled { reason: "a fleet-converge timer is enabled by the fleet actuation path, not the deploy enable authority; it is not in the deploy roster. DISSOLUTION: the fleet-path node (separate) declares its unit read-set; nothing here should own it" }
      FabricStorageServeUnit => NotYetModeled { reason: "fabric storage is outside live-deploy ownership (gunbc.design_ruling::t6_fabric_storage_excluded_from_live_deploy_2026_11_10) and apply_legs refuses it as a deployment step, so the deploy never owns it. DISSOLUTION: none while the ruling stands; if fabric storage re-enters live deploy, declare its read-set then" }
      FabricStorageServeMapping => NotYetModeled { reason: "a tailscale serve mapping for fabric has no ExecStart and is excluded with fabric storage (gunbc.design_ruling::t6_fabric_storage_excluded_from_live_deploy_2026_11_10). DISSOLUTION: if it becomes a unit with a declared read, or the ruling is lifted" }
      // THE TAILNET DOOR's read = {argv[0] (serve binary), WorkingDirectory (svc.repo_root)} from its OWN
      // typed file (the OIDC-factored closure accessor builds it via the same over_listener the deploy uses).
      TailnetDoorServeUnit => unit_file_read_set(live_deploy_tailnet_door_unit_file_for_closure(spec: spec, revision: revision))
      AgentDoorServeUnit => unit_file_read_set(live_deploy_agent_door_unit_file_for_closure(spec: spec, revision: revision))
      OidcConfigArtifact => NotYetModeled { reason: "an OIDC config file (its own path) is read by the serve/SystemdUnit at startup, not by its own ExecStart; its reader is the serve unit row, not this artifact step. DISSOLUTION: the reader's read-set (the SystemdUnit dissolution above) declares it, or a reader-of-record for the config is added" }
    }
    UpsertOwned { kind: uk } => match uk {
      // The serve unit's ExecStart (gunbc.live_deploy.emit live_deploy_serve_unit_file_over_listener)
      // runs the admitted binary (fixed_serve_binary_path(svc.serve_binary) = this step's path) loading
      // `gunbc run --entry` from its WorkingDirectory = svc.repo_root — so the serve unit reads BOTH its
      // own binary AND the source tree it loads modules from. Both come from that unit's declaration, not
      // re-transcribed here: [step.path] the binary, [instance.repo_root] the tree (the SAME authority as
      // the GunbcSourceTree step path, so the gate requires the installed tree to be where serve reads it).
      ServeBinary => Declared { paths: [step.path as String, instance.repo_root as String] }
      // The source-tree step is an ARTIFACT, not a reader: its content is read by the units that
      // declare it — the ServeBinary row above (repo_root, the tree `gunbc serve --entry` loads)
      // and, once the gate is wired, the tree-remote/roadmap/door WorkingDirectory reads. A read of
      // its own step.path would restate the install fact ("read ⊆ owned" re-derives itself and never
      // goes red) — rung inflation (guarantee_ladder). NotYetModeled would be false: there is no read
      // left to model, it is a located installed artifact. So it is InstalledArtifact (its install is
      // owned and verified by the plan; its consumers carry the TreeContent read).
      GunbcSourceTree => InstalledArtifact
      // The belt is a systemd .path unit (BeltEventPathUnit): it watches the exit inbox becoming
      // non-empty and starts the drain service. A .path unit has no ExecStart; the read of the
      // service it triggers is carried by the AttemptUnitDrainPathUnit row. Its watched-inbox read
      // is a distinct obligation, not yet declared by a unit module.
      BeltEventPathUnit => NotYetModeled { reason: "the belt exit .path unit has no ExecStart; it watches the exit inbox becoming non-empty and starts the drain service (whose read the AttemptUnitDrainPathUnit row owns). The .path unit's own watched-inbox read is not declared by a unit module here. DISSOLUTION: a unit module exports the watched-inbox path the .path unit monitors and this arm consumes it" }
      TailscaleServeMapping => NotYetModeled { reason: "a tailscale serve mapping is applied via the tailscale CLI, not an enabled systemd unit with an ExecStart or a file it reads. DISSOLUTION: none expected while it stays a CLI mapping; if it becomes a unit with a read, declare it" }
      DeployedTreeRemoteUnit => NotYetModeled { reason: "the tree-remote unit ExecStarts its remote-tree sync script; that ExecStart is not exported by its module here. DISSOLUTION: a follow-up exports the tree-remote unit's ExecStart read from its own module (its install/serve authority) and this arm consumes it" }
      PublicationHelperPathUnit => NotYetModeled { reason: "the publication helper .path unit has no ExecStart; it triggers a service whose read is not declared by that service's module. DISSOLUTION: the triggered service's module exports its read-set and this arm consumes it" }
      // The drain service ExecStarts a helper from its revision-bound launcher snapshot. Its read and
      // the snapshot that installs it are BOTH derived from gunbc.roadmap.attempt_system_unit_launch
      // attempt_unit_drain_read_paths (attempt_system_unit_launcher_dir) — one authority, not a list
      // re-spelled here (single_authority; the brief: build on this closure, not a second inventory).
      AttemptUnitDrainPathUnit => Declared { paths: attempt_unit_drain_read_paths(instance: instance, revision: revision) }
      // THE APPROVAL BROKER's read = {argv[0] (serve binary), WorkingDirectory (release dir)} from its OWN
      // typed file via the closure accessor (same producer; broker_base_url is Environment-only, irrelevant here).
      ApprovalBrokerFrontDoor => unit_file_read_set(Present { value: live_deploy_approval_broker_unit_file_for_closure(spec: spec, revision: revision) })
    }
  }
}

// deployment_artifact_read_rows turns the enable authority's steps into the generic rows the closure
// reads, carrying each step's owned path as its location and its per-kind read-set. This is the one
// join between the deploy enable authority (gunbc.live_deploy.spec deployment_owned_steps) and the
// per-kind read-of-record; it adds no new decision — location is the step's own path and the
// read-set is deployment_artifact_read_set's total match.
fn deployment_artifact_read_rows(steps: List<DeploymentArtifactStep>, spec: DeploymentSpec, instance: HostDashboardInstance, revision: ReleaseRevisionBinding) -> List<DeployReadRow> {
  list_map(xs: steps, f: fn(step) { ReadRow { located: step.path as String, reads: deployment_artifact_read_set(step: step, spec: spec, instance: instance, revision: revision) } })
}

// THE OWNED / INSTALLED SET IS NOT HERE YET — and deliberately so. The set of artifacts the deploy
// installs (the `installed` argument to deploy_gate) is the gate's INPUT, and per the node's ordering
// the gate is wired ONCE, over the fully-closed roster, in the follow-up that adds the apply_legs
// closure-verify leg. When it is reintroduced it MUST be derived from the APPLY-LEG install authority
// (gunbc.live_deploy.apply_legs ApplyLegRootHelperSnapshot for the drain's snapshot, host_effect_realize
// ports.root_helper_snapshot for the realized dir), NOT from a read function — deriving owned from the
// read would make "read ⊆ owned" restate itself and never go red (fail_closed: "a check restating a
// constraint the model already carries is a second representation of it"). A unit's READ side is what
// this module owns today (the total match above); the install side returns with its consumer.

