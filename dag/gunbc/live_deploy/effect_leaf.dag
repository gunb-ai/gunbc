module gunbc.live_deploy.effect_leaf

import std.types { String, NonEmptyStr }
import v2.std.effect_plan { EffectPlan, Do }
import v2.std.orchestration { FailFast }
import std.operation_argv { OperationRef, operation_argv_bind_text }
import v2.std.effect_plan_observed_sha256 { ObservedSha256EnvWrite }
import v2.workflow.effect_plan_bash_materialize {
  BashPlanEffect,
  ObservedSha256EnvWriteEffect,
  EffectPlanBashMaterialized,
  EffectPlanBashMaterializationRefused,
  bash_bind_operation_invocation,
  bash_bind_operation_invocation_elevated,
  effect_plan_bash_materialize,
  effect_plan_bash_refusal_label,
}

data live_deploy_effect_materialization_refused_poison: String = "__GUNBC_EFFECT_PLAN_BASH_REFUSED__ live-deploy operation leaf could not be materialized from its extdeps declaration: "

// THE MUTATION LEAVES NAME AN OPERATION, THEY DO NOT CARRY A COMMAND. A leaf here is a
// BashPlanEffect -- an extdeps operation row plus that row's OWN declared inputs bound
// by name -- and its argv is derived from the declaration by shell_materialize_operation_argv. The
// carrier is the one that landed in Wave A/B (v2.std.effect_plan Do{effect} over
// std.operation_argv BoundOperationInvocation, materialized by
// v2.workflow.effect_plan_bash_materialize); no second vocabulary for "a mutating host operation"
// is minted here, and the host-effect lane's HostEffect surface is untouched.
//
// WHAT ACTUALLY DISSOLVED, since Pipeline wrapping is explicitly not completion: the words the host
// runs are no longer authored in this repository at all. They previously travelled as
// argv-builder -> quoted text -> String, where the argv builder was a SECOND spelling of the same
// `transport shell { argv: [...] }` row -- a fork the live_deploy witnesses could only test for
// equality, never remove. Deriving argv from the row deletes the fork where this was its last
// consumer: extdeps.package_managers.dpkg dpkg_status_argv and extdeps.package_managers.apt apt_install_argv are deleted with it. The
// systemctl argv builders are NOT deleted and this does not claim they are -- gunbc.host.host_effect_realize
// still consumes them through gunbc.live_deploy.operations, so they are a surviving fork with a
// different owner, and saying otherwise here would be the census error this repository keeps
// re-learning: a symbol is dead when its consumers are counted, not when one of them stops calling.
//
// FAIL-CLOSED IS PRESERVED AND LOCATED. A materialization refusal (unknown row, undeclared input
// bound, declared input unbound, NUL in an argument) renders effect_plan_bash_refusal_label behind
// a marker that is not valid shell, exactly as bash_intent_command_or_poison does for the grammar
// path -- the step fails loudly and names which operation and which cause, rather than a
// hand-spelled fallback standing in for the refused command (DESIGN section 5: refuse, never widen).
fn deploy_effect_command(inv: BashPlanEffect) -> String {
  match effect_plan_bash_materialize(plan: EffectPlan {
    steps: [Do { effect: inv }],
    on_failure: FailFast,
  }) {
    EffectPlanBashMaterialized { source: source } => source
    EffectPlanBashMaterializationRefused { refusal: refusal } =>
      concat(
        live_deploy_effect_materialization_refused_poison,
        effect_plan_bash_refusal_label(refusal: refusal),
      )
  }
}

data live_deploy_systemctl_operation_path: String = "dag/extdeps/systemd/systemctl.dag"
data live_deploy_systemctl_operation_service: String = "systemd.Systemctl"
data live_deploy_systemctl_unit_input: String = "unit"


// EVERY MUTATION ON THIS HOST CROSSES A PRIVILEGE BOUNDARY, so these constructors elevate rather
// than taking a `privileged` flag: the deploy principal is the unprivileged CI-runner account
// (gunbc.fleet.fleet_posix_accounts FleetAccountCiRunner), and a systemctl mutation it could issue
// unelevated does not exist.
// The package READ (dpkg -s) is the one leaf that does not, which is why it alone binds unelevated.
fn systemctl_unit_effect(operation: String, unit: NonEmptyStr) -> BashPlanEffect {
  bash_bind_operation_invocation_elevated(
    at: OperationRef {
      path: live_deploy_systemctl_operation_path,
      service: live_deploy_systemctl_operation_service,
      operation: operation,
    },
    bindings: [operation_argv_bind_text(
      name: live_deploy_systemctl_unit_input,
      text: unit as String,
    )],
  )
}

fn systemctl_restart_effect(unit: NonEmptyStr) -> BashPlanEffect {
  systemctl_unit_effect(operation: "Restart", unit: unit)
}

// THE OBSERVED-SHA-256 ENV FILE IS A LEAF, NOT A COMMAND: the constructor names the file observed at
// run time, the env variable and the destination, mode and owner it is installed with. Its lowering,
// including the fail-closed shape check and the two typed failure causes, is the one arm of
// effect_plan_bash_materialize (BashPlanEffect); there is no writer to call separately.
fn observed_sha256_env_write_effect(
  path: String,
  dest: String,
  env_name: String,
  mode: NonEmptyStr,
  owner: NonEmptyStr,
) -> BashPlanEffect {
  ObservedSha256EnvWriteEffect { write: ObservedSha256EnvWrite {
    path: path,
    dest: dest,
    env_name: env_name,
    mode: mode,
    owner: owner,
  } }
}
