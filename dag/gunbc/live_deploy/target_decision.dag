module gunbc.live_deploy.target_decision

import std.types { Bool, CommitSha, NonEmptyStr, String }
import extdeps.git.object_store { GitObjectId, git_object_id_from_untagged_hex }
import v2.std.collection { Present, Absent }
import gunbc.host_effect { HostEffectTransport }
import gunbc.systemctl_is_active_read {
  UnitIsActiveCapture,
  UnitIsActiveCaptured,
  UnitIsActiveCaptureRefused,
  systemctl_is_active_read,
}
import gunbc.running_release_identity {
  RunningReleaseIdentity,
  RunningReleaseIdentified,
  RunningReleaseUnidentified,
  observe_running_release_identity,
}
import gunbc.roadmap_site_surface_types { HealthzEffectiveRead, HealthzBodyRead, HealthzProbeRefused }
import gunbc.live_deploy.readiness {
  live_deploy_healthz_get_for_port,
  running_release_unidentified_detail,
}
import gunbc.live_deploy.revision {
  DeployRevisionRelation,
  DeployRevisionVerdict,
  RevisionAdvance,
  RevisionAlreadyConverged,
  RevisionSupersededNoOp,
  RevisionRefused,
  classify_deploy_revision,
}
import gunbc.fleet_main_revision { FleetRevisionRelationObservation }
import gunbc.fleet_desired_observe { observe_fleet_revision_relation }
import gunbc.live_deploy.spec { DeploymentSpec, deployment_plan_listen_port }

// THE FORWARD-ONLY WALL FOR THE DEPLOY HALF, WHICH IS THE HALF THAT NEVER HAD ONE.
//
// gunbc.live_deploy.revision has stated this policy since it was written -- four cases, three
// dispositions, refuse on unverifiable -- and until this module landed its ONLY caller was its own
// witness test. That is specification-without-execution (DESIGN section 5) in the shape
// gunbc.fleet_desired_admission's header already names for the ref-advance half: "the modeled wall
// stood beside an actuator that walked around it". The actuator here is
// gunbc.live_deploy.apply live_deploy_admitted_wet_with_access, which observed a candidate and
// applied it unconditionally, so an older deploy arriving second rsynced its older tree, converged,
// and greened -- exactly the silent regression srv1-deploy-serialization-and-false-greens.md
// section 6 predicted serialization alone would produce.
//
// THIS MODULE IS THE CONSUMER, NOT A SECOND POLICY. The four-case relation and its verdict come
// from gunbc.live_deploy.revision classify_deploy_revision; the ancestry reading comes from
// gunbc.fleet_desired_observe observe_fleet_revision_relation, which is already the sole production
// constructor of a merge-base-derived relation. Nothing here re-derives either. What is new is the
// PREDECESSOR question those authorities take as given: which revision is the target actually at.
// THE PREDECESSOR IS THE RUNNING PROCESS, AND THAT IS AN OPERATOR RULING RATHER THAN A PREFERENCE.
// gunbc.running_release_identity's header carries it (2026-08-05): a file on disk describes what
// some previous writer INTENDED and a git HEAD in the deployed tree describes the DISK, both of
// which diverge from the process exactly when a sync is interrupted or lands out of order, so
// "grounding deployment ordering on either re-admits the backward move the ordering exists to
// forbid". The process is the only party that can answer which release is being served.
//
// NoRunningRelease IS A POSITIVE STATE AND NOT A DEGRADED READ, and the distinction is what keeps
// this wall from being one an operator cannot get out of. A unit that is not active is not serving
// anything, so there is no release to move backward from and an advance onto an idle target is
// unconditionally forward. That is a FACT the host reported, not an absence of one: it is reached
// only when `systemctl is-active` ANSWERED, and it carries the state word it answered with. The
// arm that would have been dangerous -- reading a failed healthz probe as "nothing is running" --
// is deliberately not available: a refused probe cannot distinguish a down service from a broken
// credential, and admitting on it would be the empty-observation narrow DESIGN section 5 names,
// at the one seam where the consequence is an unordered production deploy.
//
// So the discriminator is systemd rather than the health endpoint. An INACTIVE unit is the absent
// predecessor; an ACTIVE unit whose identity is unreadable is a routed process demonstrably serving
// something this system cannot name, which gunbc.running_release_identity's own cause note maps to
// a refusal "never to an advance and never to a synthetic predecessor".
type DeployTargetPredecessor
  = NoRunningRelease { unit_state: NonEmptyStr }
  | RunningRelease { revision: CommitSha }
  | PredecessorUnobservable { cause: String }

fn deploy_target_predecessor_from_identity(identity: RunningReleaseIdentity) -> DeployTargetPredecessor {
  match identity {
    RunningReleaseIdentified { observation: obs } => RunningRelease { revision: obs.revision }
    RunningReleaseUnidentified { cause: why } =>
      PredecessorUnobservable {
        cause: join([
          "the target unit is ACTIVE but does not state a readable release identity, so no ancestry",
          " relation to the candidate is decidable and any advance from it would be unordered: ",
          running_release_unidentified_detail(cause: why),
        ], ""),
      }
  }
}

fn deploy_target_predecessor_from_healthz(read: HealthzEffectiveRead) -> DeployTargetPredecessor {
  match read {
    HealthzProbeRefused { probe_error: why } =>
      PredecessorUnobservable {
        cause: join([
          "the target unit is ACTIVE but its health endpoint did not answer, so the running release",
          " is unknown -- an unanswered probe is NOT evidence that nothing is running: ",
          why,
        ], ""),
      }
    HealthzBodyRead { body: b } =>
      deploy_target_predecessor_from_identity(identity: observe_running_release_identity(healthz_body: b))
  }
}

// THE UNIT READ DECIDES WHETHER A HEALTH PROBE IS EVEN ASKED FOR, and it says so by returning a
// step rather than by taking the probe's result as an argument. An argument would be evaluated
// whichever arm the match then selected, so the idle unit would be probed anyway and the refused
// probe of an idle unit would become indistinguishable from the refused probe of a live one -- the
// exact distinction this fold exists to preserve, defeated by the shape of the signature rather
// than by the logic inside it. Returning ProbeRunningProcess keeps the fold PURE and hands the one
// remaining observation back to the wet composition that owns effects.
type UnitPredecessorStep
  = PredecessorSettled { predecessor: DeployTargetPredecessor }
  | ProbeRunningProcess

fn deploy_target_step_from_unit_state(capture: UnitIsActiveCapture) -> UnitPredecessorStep {
  match capture {
    UnitIsActiveCaptureRefused { reason: why } =>
      PredecessorSettled {
        predecessor: PredecessorUnobservable {
          cause: join([
            "`systemctl is-active` did not answer for the target unit, so whether anything is serving",
            " is unknown and the deploy is not ordered against it: ",
            why,
          ], ""),
        },
      }
    UnitIsActiveCaptured { state: s, active: is_active } =>
      if is_active {
        ProbeRunningProcess
      } else {
        PredecessorSettled { predecessor: NoRunningRelease { unit_state: s } }
      }
  }
}

// THE DECISION'S INPUT CARRIES THE RELATION ALREADY OBSERVED, rather than an optional revision the
// decision would then have to probe. Only one arm has two revisions to relate, so only one arm can
// carry a relation, and a coproduct says that where an Optional beside a predecessor would have
// admitted the meaningless pairs -- a relation with no predecessor, a predecessor with none.
type DeployTargetInput
  = TargetIdle { unit_state: NonEmptyStr }
  | TargetRelated { running: CommitSha, relation: DeployRevisionRelation }
  | TargetUnreadable { cause: String }

// THREE DISPOSITIONS, MATCHING gunbc.live_deploy.revision's OWN SPLIT: one arm mutates, one arm is
// a correct do-nothing that must exit ZERO, one arm is the only red.
type DeployTargetDecision
  = DeployTargetProceed { note: String }
  | DeployTargetTerminalNoOp { note: String }
  | DeployTargetRefused { cause: String }

// SameRevision MAPS TO PROCEED HERE, AND THIS CONSUMER DIVERGES FROM
// deploy_revision_terminal_success ON EXACTLY THAT ARM. The divergence is deliberate, it is the
// only one, and it is stated here rather than left for a reader to find by diffing the two.
//
// That predicate answers for a consumer whose predecessor is the DEPLOYED TREE, where "the host
// already carries this exact tree" really does mean there is nothing to do. This consumer's
// predecessor is the RUNNING PROCESS, and the two are not the same question: a process announcing
// revision R proves only what its launch argument said, and the tree beneath it can be drifted,
// half-synced, or hand-edited while the announcement stays R. Skipping the deploy on that basis
// would convert an operator's repair -- re-running the deploy at the same revision to reconcile a
// damaged host -- into a silent success that changed nothing, which is the fabricated-plausible-
// output failure DESIGN section 5 forbids, arrived at from the direction that looks like thrift.
//
// It also costs nothing to admit. The harm this wall exists to prevent is the BACKWARD move, and
// an identical revision is not one; apply is a reconcile whose members are idempotent, so
// re-converging the same revision is the ordinary no-change case rather than a second deploy. The
// wall therefore refuses backward, unrelated and unverifiable, and admits same-or-forward.
fn decide_deploy_target(input: DeployTargetInput, candidate: CommitSha) -> DeployTargetDecision {
  match input {
    TargetIdle { unit_state: s } =>
      DeployTargetProceed {
        note: join([
          "no running release to order against: the target unit reports '", s as String,
          "', so installing ", candidate as String, " cannot be a backward move",
        ], ""),
      }
    TargetUnreadable { cause: c } => DeployTargetRefused { cause: c }
    TargetRelated { running: r, relation: rel } =>
      match classify_deploy_revision(relation: rel) {
        RevisionAdvance =>
          DeployTargetProceed {
            note: join([
              "forward: the running release ", r as String, " is an ancestor of the candidate ",
              candidate as String,
            ], ""),
          }
        RevisionAlreadyConverged =>
          DeployTargetProceed {
            note: join([
              "same revision: the running release already announces ", candidate as String,
              " -- re-converging rather than skipping, because an announcement is a launch argument",
              " and says nothing about the tree beneath it",
            ], ""),
          }
        RevisionSupersededNoOp =>
          DeployTargetTerminalNoOp {
            note: join([
              "superseded: the candidate ", candidate as String,
              " is an ancestor of the running release ", r as String,
              " -- the target is already in a strictly better state than this deploy would produce,",
              " so no mutation is performed and this run succeeds",
            ], ""),
          }
        RevisionRefused { cause: why } =>
          DeployTargetRefused {
            cause: join(["live_deploy target decision refused: ", why as String], ""),
          }
      }
  }
}

fn deploy_target_proceeds(decision: DeployTargetDecision) -> Bool {
  match decision {
    DeployTargetProceed { note: _ } => true
    DeployTargetTerminalNoOp { note: _ } => false
    DeployTargetRefused { cause: _ } => false
  }
}

fn deploy_target_terminal_success(decision: DeployTargetDecision) -> Bool {
  match decision {
    DeployTargetTerminalNoOp { note: _ } => true
    DeployTargetProceed { note: _ } => false
    DeployTargetRefused { cause: _ } => false
  }
}

fn deploy_target_refuses(decision: DeployTargetDecision) -> Bool {
  match decision {
    DeployTargetRefused { cause: _ } => true
    DeployTargetProceed { note: _ } => false
    DeployTargetTerminalNoOp { note: _ } => false
  }
}

// ONE RENDERING, so the receipt an operator reads and the refusal the process exits with derive
// from the same arm rather than each spelling their own sentence.
fn deploy_target_decision_line(decision: DeployTargetDecision) -> String {
  match decision {
    DeployTargetProceed { note: n } => join(["deploy-target PROCEED -- ", n], "")
    DeployTargetTerminalNoOp { note: n } => join(["deploy-target NO-OP -- ", n], "")
    DeployTargetRefused { cause: c } => join(["deploy-target REFUSED -- ", c], "")
  }
}

// THE RELATION IS READ IN THE DEPLOYING CHECKOUT, which is the only party holding both revisions as
// objects: it was fetched with full depth for the candidate, and the running release is a commit on
// the branch it deployed from. A missing object makes `git merge-base` exit 128, which
// gunbc.fleet_main_revision merge_base_relation folds to RelationUnverifiable and this module
// refuses on -- the fail-closed direction, since "I could not determine whether this is newer" is
// not "this is newer".
fn deploy_target_input_from_predecessor(
  predecessor: DeployTargetPredecessor,
  candidate: CommitSha,
) -> DeployTargetInput {
  match predecessor {
    NoRunningRelease { unit_state: s } => TargetIdle { unit_state: s }
    PredecessorUnobservable { cause: c } => TargetUnreadable { cause: c }
    RunningRelease { revision: running } =>
      match git_object_id_from_untagged_hex(hex: running as String) {
        Absent =>
          TargetUnreadable {
            cause: join([
              "the running release stated '", running as String,
              "', which passed the wire shape check but is not a decodable git object id",
            ], ""),
          }
        Present { value: running_oid } =>
          match git_object_id_from_untagged_hex(hex: candidate as String) {
            Absent =>
              TargetUnreadable {
                cause: join([
                  "the candidate revision '", candidate as String,
                  "' is not a decodable git object id",
                ], ""),
              }
            Present { value: candidate_oid } =>
              {
                let observed = observe_fleet_revision_relation(
                  current: running_oid,
                  accepted: candidate_oid,
                )
                TargetRelated { running: running, relation: observed.relation }
              }
          }
      }
  }
}

// THE WET COMPOSITION, AND IT RUNS BEFORE ANY MUTATION. Every observation it makes is read-only:
// one `systemctl is-active`, and at most one health probe. gunbc.live_deploy.apply calls it after
// the candidate is observed and before the preflight mutation gate, which is the cheapest place a
// backward deploy can be stopped -- nothing has been touched, so there is no half-applied state.
fn observe_deploy_target(
  spec: DeploymentSpec,
  transport: HostEffectTransport,
  candidate: CommitSha,
) -> DeployTargetDecision {
  let predecessor = match deploy_target_step_from_unit_state(
    capture: systemctl_is_active_read(transport: transport, unit: spec.names.unit_name),
  ) {
    PredecessorSettled { predecessor: p } => p
    ProbeRunningProcess =>
      deploy_target_predecessor_from_healthz(
        read: live_deploy_healthz_get_for_port(
          port: deployment_plan_listen_port(spec: spec),
          transport: transport,
        ),
      )
  }
  decide_deploy_target(
    input: deploy_target_input_from_predecessor(predecessor: predecessor, candidate: candidate),
    candidate: candidate,
  )
}
