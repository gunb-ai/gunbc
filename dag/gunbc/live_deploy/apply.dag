module gunbc.live_deploy.apply


type BlueGreenSlotSelection
  = BlueGreenSlotsSelected { active: gunbc.live_deploy.spec.DeploymentSpec, idle: gunbc.live_deploy.spec.DeploymentSpec }
  | BlueGreenSlotSelectionRefused { reason: String }

type TailscaleServeStatusRead
  = TailscaleServeStatusObserved { json: String }
  | TailscaleServeStatusReadRefused { reason: String }

fn srv1_blue_green_slot_selection(status_json: String) -> BlueGreenSlotSelection {
  let blue = deployment_spec_srv1()
  let green = deployment_spec_srv1_green()
  let proxies = tailscale_serve_status_proxy_targets(status_json: status_json, mount: ServeRootMount)
  let blue_proxy = tailscale_serve_proxy_url(endpoint: blue.names.tailscale_serve_endpoint)
  let green_proxy = tailscale_serve_proxy_url(endpoint: green.names.tailscale_serve_endpoint)
  let blue_hits = count(filter(proxies, p => p == blue_proxy))
  let green_hits = count(filter(proxies, p => p == green_proxy))
  if count(proxies) != 1 {
    BlueGreenSlotSelectionRefused {
      reason: concat("blue/green cutover refused: root Tailscale Serve endpoint did not carry exactly one Proxy; observed-count=", to_string(count(proxies)))
    }
  } else if blue_hits == 1 && green_hits == 0 {
    BlueGreenSlotsSelected { active: blue, idle: green }
  } else if green_hits == 1 && blue_hits == 0 {
    BlueGreenSlotsSelected { active: green, idle: blue }
  } else {
    BlueGreenSlotSelectionRefused {
      reason: "blue/green cutover refused: root Tailscale Serve Proxy names neither declared srv1 slot"
    }
  }
}

fn tailscale_serve_status_read(transport: gunbc.host_effect.HostEffectTransport) -> TailscaleServeStatusRead {
  let argv = concat(["tailscale"], tailscale_serve_status_json_argv())
  match transport {
    LocalShell => {
      let result = tailscale.Serve.StatusJson()
      TailscaleServeStatusObserved { json: result.stdout }
    }
    FleetSsh { target: t, context: _ } =>
      TailscaleServeStatusReadRefused {
        reason: concat("tailscale serve status is not yet migrated to the FleetSsh sealed context; the leg was NOT attempted for ", t.endpoint as String),
      }
    SshShell { ssh_host } =>
      match typed_argv_exec_over_ssh(host: ssh_host, argv: argv) {
        TypedArgvExecConverged { result } =>
          if result.success {
            TailscaleServeStatusObserved { json: result.stdout }
          } else {
            TailscaleServeStatusReadRefused { reason: concat("tailscale serve status --json over ssh failed: ", result.stderr) }
          }
        TypedArgvExecRefused { reason } => TailscaleServeStatusReadRefused { reason: reason }
      }
    EmitArtifactThenThinRun { bootstrap: _, invocation: _ } =>
      TailscaleServeStatusReadRefused { reason: "blue/green slot observation refused EmitArtifactThenThinRun transport" }
  }
}

data blue_green_cutover_order_note: String = "Operator-signed 2026-08-01: straight to blue/green, no socket-activation interim. Tailscale's currently routed root Proxy selects active and idle from the two declared HostDashboardInstance slots. The candidate mutation is the slot footprint only; its existing readiness path polls /healthz until the digest proves it serves THIS source tree and then performs the deeper roadmap asset readback. Only after both converge does the route-only spec replay the scoped root endpoint toward the candidate. Old-slot retirement is route-free and runtime-only: it stops the old serve unit and belt timer but preserves the reusable slot files, worktrees, and published attempt evidence. Full retract remains a distinct operator action with the empty-directory refusal wall. Every pre-flip refusal returns before route mutation, leaving the old process mapped and serving; a post-flip retirement failure leaves the new process mapped, so absence is not a failure arm."

fn live_deploy_blue_green_cutover_with_selection(
  selection: BlueGreenSlotSelection,
  candidate: gunbc.live_deploy.candidate.CandidateRelease,
  transport: gunbc.host_effect.HostEffectTransport,
  access: gunbc.ci_deploy_access.DeployAccess,
) -> std.realization_reconcile.Reconciliation<gunbc.host_effect.HostEffectIntent, gunbc.host_effect.HostEffectEvidence> {
  match selection {
    BlueGreenSlotSelectionRefused { reason } =>
      std.realization_reconcile.NotConverged { reason: reason, applied: live_deploy_preflight_intent(access: access) }
    BlueGreenSlotsSelected { active, idle } => {
      let converged_slot = live_deploy_apply_via_transport(
        spec: deployment_slot_spec(spec: idle),
        candidate: candidate,
        transport: transport,
        access: access,
      )
      if !reconciliation_converged(r: converged_slot) {
        converged_slot
      } else {
        let flip = live_deploy_apply_mutation_via_transport(
          spec: deployment_route_spec(spec: idle),
          candidate: candidate,
          transport: transport,
          access: access,
        )
        if !reconciliation_converged(r: flip) {
          flip
        } else {
          let teardown = live_deploy_retract_via_transport(
            spec: deployment_retiring_slot_spec(spec: active),
            transport: transport,
            access: access,
          )
          if reconciliation_converged(r: teardown) { flip } else { teardown }
        }
      }
    }
  }
}

fn live_deploy_preflight_intent(access: gunbc.ci_deploy_access.DeployAccess) -> gunbc.host_effect.HostEffectIntent {
  gunbc.host_effect.HostEffectIntent {
    target: gunbc.host_effect.HostOs { node: access.host },
    effect: gunbc.host_effect.DeployAccessPreflight {},
    evidence: host_effect_identity_evidence,
    transport: access.transport,
    privilege_denial: none,
  }
}

fn live_deploy_mutation_denied(
  target: gunbc.host_effect.NodeControlPlane,
  effect: gunbc.host_effect.HostEffect,
  transport: gunbc.host_effect.HostEffectTransport,
  gate: std.access.AccessDecision
) -> std.realization_reconcile.Reconciliation<gunbc.host_effect.HostEffectIntent, gunbc.host_effect.HostEffectEvidence> {
  std.realization_reconcile.NotConverged {
    reason: deploy_access_decision_reason(d: gate),
    applied: gunbc.host_effect.HostEffectIntent {
      target: target,
      effect: effect,
      evidence: host_effect_identity_evidence,
      transport: transport,
      privilege_denial: Present { value: gate },
    },
  }
}

fn live_deploy_fold(
  spec: gunbc.live_deploy.spec.DeploymentSpec,
  effect: gunbc.host_effect.HostEffect,
  transport: gunbc.host_effect.HostEffectTransport,
  access: gunbc.ci_deploy_access.DeployAccess,
  fixture_actor: gunbc.ci_deploy_access.DeployAccessActor?,
  fixture_host: gunbc.ci_deploy_target_host.DeployTargetHostObservation?
) -> std.realization_reconcile.Reconciliation<gunbc.host_effect.HostEffectIntent, gunbc.host_effect.HostEffectEvidence> {
  let target = gunbc.host_effect.HostOs { node: spec.target.host }
  let gate = deploy_mutation_gate(
    access: access,
    fixture_actor: fixture_actor,
    fixture_host: fixture_host
  )
  match gate {
    Deny { refusal: _ } =>
      live_deploy_mutation_denied(
        target: target,
        effect: effect,
        transport: transport,
        gate: gate
      )
    Permit =>
      host_effect_apply_gated(
        access: access,
        target: target,
        effect: effect,
        evidence: host_effect_identity_evidence,
        transport: transport,
        fixture_actor: fixture_actor
      )
  }
}

fn live_deploy_ensure_dependency(
  spec: gunbc.live_deploy.spec.DeploymentSpec,
  dep: gunbc.live_deploy.spec.DeploymentDependencyStep,
  transport: gunbc.host_effect.HostEffectTransport,
  access: gunbc.ci_deploy_access.DeployAccess
) -> std.realization_reconcile.Reconciliation<gunbc.host_effect.HostEffectIntent, gunbc.host_effect.HostEffectEvidence> {
  live_deploy_fold(
    spec: spec,
    effect: gunbc.host_effect.LiveDeployEnsureDependency { dep: dep },
    transport: transport,
    access: access,
    fixture_actor: Absent,
    fixture_host: Absent
  )
}

fn live_deploy_apply_mutation_via_transport(
  spec: gunbc.live_deploy.spec.DeploymentSpec,
  candidate: gunbc.live_deploy.candidate.CandidateRelease,
  transport: gunbc.host_effect.HostEffectTransport,
  access: gunbc.ci_deploy_access.DeployAccess
) -> std.realization_reconcile.Reconciliation<gunbc.host_effect.HostEffectIntent, gunbc.host_effect.HostEffectEvidence> {
  live_deploy_fold(
    spec: spec,
    effect: gunbc.host_effect.LiveDeployApply { spec: spec, candidate: candidate },
    transport: transport,
    access: access,
    fixture_actor: Absent,
    fixture_host: Absent
  )
}

fn live_deploy_apply_readiness_gate(
  spec: gunbc.live_deploy.spec.DeploymentSpec,
  candidate: gunbc.live_deploy.candidate.CandidateRelease,
  transport: gunbc.host_effect.HostEffectTransport,
  access: gunbc.ci_deploy_access.DeployAccess,
  mutation: std.realization_reconcile.Reconciliation<gunbc.host_effect.HostEffectIntent, gunbc.host_effect.HostEffectEvidence>
) -> std.realization_reconcile.Reconciliation<gunbc.host_effect.HostEffectIntent, gunbc.host_effect.HostEffectEvidence> {
  live_deploy_apply_readiness_gate_with_readiness(
    mutation: mutation,
    readiness: live_deploy_poll_until_service_ready_for_deploy(
      spec: spec,
      candidate: candidate,
      transport: transport,
      access: access,
    ),
  )
}

fn live_deploy_apply_readiness_gate_with_readiness(
  mutation: std.realization_reconcile.Reconciliation<gunbc.host_effect.HostEffectIntent, gunbc.host_effect.HostEffectEvidence>,
  readiness: std.realization_reconcile.Reconciliation<gunbc.live_deploy.readiness.ServiceReadyApplyEffect, gunbc.live_deploy.readiness.ServiceReadyEvidence>,
) -> std.realization_reconcile.Reconciliation<gunbc.host_effect.HostEffectIntent, gunbc.host_effect.HostEffectEvidence> {
  if !reconciliation_converged(r: mutation) {
    mutation
  } else {
    if reconciliation_converged(r: readiness) {
      mutation
    } else {
      match readiness {
        std.realization_reconcile.NotConverged { reason: why, applied: _ } =>
          match mutation {
            std.realization_reconcile.Converged { evidence: _, applied: intent } =>
              std.realization_reconcile.NotConverged { reason: why, applied: intent }
            std.realization_reconcile.NotConverged { reason: _, applied: intent } =>
              std.realization_reconcile.NotConverged { reason: why, applied: intent }
          }
        std.realization_reconcile.Converged { evidence: _, applied: _ } => mutation
      }
    }
  }
}

fn live_deploy_apply_digest_readback_via_transport(
  spec: gunbc.live_deploy.spec.DeploymentSpec,
  transport: gunbc.host_effect.HostEffectTransport,
  access: gunbc.ci_deploy_access.DeployAccess,
) -> std.realization_reconcile.Reconciliation<gunbc.host_effect.HostEffectIntent, gunbc.host_effect.HostEffectEvidence> {
  live_deploy_fold(
    spec: spec,
    effect: gunbc.host_effect.LiveDeployDigestReadback { port: deployment_plan_listen_port(spec: spec) },
    transport: transport,
    access: access,
    fixture_actor: Absent,
    fixture_host: Absent
  )
}

fn live_deploy_apply_via_transport(
  spec: gunbc.live_deploy.spec.DeploymentSpec,
  candidate: gunbc.live_deploy.candidate.CandidateRelease,
  transport: gunbc.host_effect.HostEffectTransport,
  access: gunbc.ci_deploy_access.DeployAccess
) -> std.realization_reconcile.Reconciliation<gunbc.host_effect.HostEffectIntent, gunbc.host_effect.HostEffectEvidence> {
  let mutation = live_deploy_apply_mutation_via_transport(
    spec: spec,
    candidate: candidate,
    transport: transport,
    access: access,
  )
  let gated = live_deploy_apply_readiness_gate(
    spec: spec,
    candidate: candidate,
    transport: transport,
    access: access,
    mutation: mutation,
  )
  if !reconciliation_converged(r: gated) {
    gated
  } else {
    let digest = live_deploy_apply_digest_readback_via_transport(
      spec: spec,
      transport: transport,
      access: access,
    )
    if reconciliation_converged(r: digest) {
      gated
    } else {
      match digest {
        std.realization_reconcile.NotConverged { reason: why, applied: _ } =>
          match gated {
            std.realization_reconcile.Converged { evidence: _, applied: intent } =>
              std.realization_reconcile.NotConverged { reason: why, applied: intent }
            std.realization_reconcile.NotConverged { reason: _, applied: intent } =>
              std.realization_reconcile.NotConverged { reason: why, applied: intent }
          }
        std.realization_reconcile.Converged { evidence: _, applied: _ } => gated
      }
    }
  }
}

fn live_deploy_retract_via_transport(
  spec: gunbc.live_deploy.spec.DeploymentSpec,
  transport: gunbc.host_effect.HostEffectTransport,
  access: gunbc.ci_deploy_access.DeployAccess
) -> std.realization_reconcile.Reconciliation<gunbc.host_effect.HostEffectIntent, gunbc.host_effect.HostEffectEvidence> {
  live_deploy_fold(
    spec: spec,
    effect: gunbc.host_effect.LiveDeployRetract { spec: spec },
    transport: transport,
    access: access,
    fixture_actor: Absent,
    fixture_host: Absent
  )
}

fn live_deploy_access_preflight_for(access: gunbc.ci_deploy_access.DeployAccess) -> std.realization_reconcile.Reconciliation<gunbc.host_effect.HostEffectIntent, gunbc.host_effect.HostEffectEvidence> {
  let proof = deploy_target_proof_from_access(access: access)
  let intent = live_deploy_preflight_intent(access: access)
  if !deploy_target_ssh_proof_structurally_valid(proof: proof) {
    std.realization_reconcile.NotConverged {
      reason: "live_deploy: deploy target-host proof structurally invalid; fail-closed",
      applied: intent,
    }
  } else {
    let gate = deploy_mutation_gate(
      access: access,
      fixture_actor: Absent,
      fixture_host: Absent
    )
    match gate {
      Permit =>
        std.realization_reconcile.Converged {
          evidence: gunbc.host_effect.ShellEffectApplied {
            exit_code: 0,
            stdout: deploy_access_preflight_pass_message(access: access),
            stderr: "",
          },
          applied: intent,
        }
      Deny { refusal: _ } =>
        std.realization_reconcile.NotConverged {
          reason: deploy_access_decision_reason(d: gate),
          applied: gunbc.host_effect.HostEffectIntent {
            target: intent.target,
            effect: intent.effect,
            evidence: intent.evidence,
            transport: intent.transport,
            privilege_denial: Present { value: gate },
          },
        }
    }
  }
}

fn live_deploy_access_preflight() -> std.realization_reconcile.Reconciliation<gunbc.host_effect.HostEffectIntent, gunbc.host_effect.HostEffectEvidence> {
  live_deploy_access_preflight_for(access: ci_deploy_srv1_access)
}

fn live_deploy_apply_srv1_with_access(
  access: gunbc.ci_deploy_access.DeployAccess,
  candidate: gunbc.live_deploy.candidate.CandidateRelease,
) -> std.realization_reconcile.Reconciliation<gunbc.host_effect.HostEffectIntent, gunbc.host_effect.HostEffectEvidence> {
  match tailscale_serve_status_read(transport: access.transport) {
    TailscaleServeStatusReadRefused { reason } =>
      std.realization_reconcile.NotConverged { reason: reason, applied: live_deploy_preflight_intent(access: access) }
    TailscaleServeStatusObserved { json } =>
      live_deploy_blue_green_cutover_with_selection(
        selection: srv1_blue_green_slot_selection(status_json: json),
        candidate: candidate,
        transport: access.transport,
        access: access,
      )
  }
}

data retract_carries_no_candidate_note: String = "A RETRACT OBSERVES NO CANDIDATE, WHICH IS WHY IT CANNOT FAIL FOR WANT OF ONE. It removes what this deployment owns; there is no release being installed, so there is nothing whose identity a retract could state and nothing for readiness to compare. While the revision rode on DeploymentServiceConfig this path had to construct one anyway, and worse, it called observe_candidate_release first — so a retract could refuse because git HEAD was unreadable, a condition with no bearing whatsoever on tearing down a unit.\\n\\nThe fold now passes RevisionNotInstalled, so the arm that would render an ExecStart refuses loudly instead of naming a revision this operation never had."

fn live_deploy_retract_srv1_with_access(
  access: gunbc.ci_deploy_access.DeployAccess,
) -> std.realization_reconcile.Reconciliation<gunbc.host_effect.HostEffectIntent, gunbc.host_effect.HostEffectEvidence> {
  live_deploy_retract_via_transport(
    spec: deployment_spec_srv1(),
    transport: access.transport,
    access: access
  )
}

fn live_deploy_apply_srv1(candidate: gunbc.live_deploy.candidate.CandidateRelease) -> std.realization_reconcile.Reconciliation<gunbc.host_effect.HostEffectIntent, gunbc.host_effect.HostEffectEvidence> {
  live_deploy_apply_srv1_with_access(access: ci_deploy_srv1_access, candidate: candidate)
}

fn live_deploy_retract_srv1() -> std.realization_reconcile.Reconciliation<gunbc.host_effect.HostEffectIntent, gunbc.host_effect.HostEffectEvidence> {
  live_deploy_retract_srv1_with_access(access: ci_deploy_srv1_access)
}

fn live_deploy_reconciliation_exit(r: std.realization_reconcile.Reconciliation<gunbc.host_effect.HostEffectIntent, gunbc.host_effect.HostEffectEvidence>) -> std.process.ProcessExit {
  if reconciliation_converged(r: r) {
    ExitSuccess
  } else {
    match r {
      std.realization_reconcile.NotConverged { reason: why, applied: _ } => exit_failure(reason: why)
      std.realization_reconcile.Converged { evidence: _, applied: _ } => ExitSuccess
    }
  }
}

data live_deploy_candidate_observed_at_launcher_note: String = "THE ONE OBSERVATION POINT OF THE INVOCATION, AND IT IS HERE BECAUSE HERE IS BEFORE EVERY MUTATION. The preflight has not run, no rsync has touched the host, no unit has been written; the deploying checkout is exactly the tree the job was handed. Observing later — inside the cutover, inside the emitter, inside a readiness retry — would read a tree the deploy itself may have altered, and would give the invocation two revisions that both look right locally.\n\nA REFUSAL HERE STOPS THE LINE BEFORE ANYTHING IS TOUCHED. A deploy that cannot name the release it is installing has nothing to write into ExecStart and nothing to verify the routed process against, so it exits with the typed cause rather than proceeding with a placeholder. This is the cheapest possible place to refuse: nothing has been mutated, so there is no half-applied state to reason about and no rollback to perform."

fn live_deploy_wet_with_access(access: gunbc.ci_deploy_access.DeployAccess) -> std.process.ProcessExit {
  match observe_candidate_release() {
    CandidateUnobservable { cause: why } =>
      exit_failure(reason: candidate_unobservable_detail(cause: why))
    CandidateObserved { candidate: candidate } => {
      let preflight = live_deploy_access_preflight_for(access: access)
      if !reconciliation_converged(r: preflight) {
        live_deploy_reconciliation_exit(r: preflight)
      } else {
        live_deploy_reconciliation_exit(
          r: live_deploy_apply_srv1_with_access(access: access, candidate: candidate)
        )
      }
    }
  }
}

fn live_deploy_retract_wet_with_access(access: gunbc.ci_deploy_access.DeployAccess) -> std.process.ProcessExit {
  let preflight = live_deploy_access_preflight_for(access: access)
  if !reconciliation_converged(r: preflight) {
    live_deploy_reconciliation_exit(r: preflight)
  } else {
    live_deploy_reconciliation_exit(
      r: live_deploy_retract_srv1_with_access(access: access)
    )
  }
}

func live_deploy_apply_srv1_wet() -> std.process.ProcessExit {
  live_deploy_wet_with_access(access: ci_deploy_srv1_access)
}

func live_deploy_apply_srv1_operator_wet() -> std.process.ProcessExit {
  live_deploy_wet_with_access(access: ci_deploy_srv1_operator_access)
}

func live_deploy_retract_srv1_wet() -> std.process.ProcessExit {
  live_deploy_retract_wet_with_access(access: ci_deploy_srv1_access)
}

func live_deploy_retract_srv1_operator_wet() -> std.process.ProcessExit {
  live_deploy_retract_wet_with_access(access: ci_deploy_srv1_operator_access)
}
