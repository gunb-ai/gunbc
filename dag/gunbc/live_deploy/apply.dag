module gunbc.live_deploy.apply

import gunbc.live_deploy.spec {
  DeploymentSpec,
  DeploymentDependencyStep,
  deployment_spec_srv1,
  deployment_plan_listen_port,
}
import gunbc.roadmap_static_site { roadmap_site_digest_readback_script }
import gunbc.live_deploy.emit {
  live_deploy_apply_script_for,
  live_deploy_retract_script_for,
  deployment_ensure_dependency_script,
}
import gunbc.ci_deploy_access {
  ci_deploy_srv1_access,
  ci_deploy_srv1_operator_access,
  DeployAccess,
  DeployAccessActor,
  deploy_access_preflight_pass_message,
  deploy_access_decision_reason,
  deploy_target_proof_from_access,
  deploy_target_host_preflight_script,
}
import gunbc.ci_deploy_access_observe {
  deploy_mutation_gate,
}
import gunbc.host_effect_realize { deploy_access_check_observed }
import gunbc.ci_deploy_target_host {
  DeployTargetHostObservation,
  deploy_target_ssh_proof_structurally_valid,
}
import std.types { String }
import std.access { AccessDecision, Permit, Deny }
import gunbc.host_effect {
  ShellCommand,
  HostOs,
  NodeControlPlane,
  host_effect_identity_evidence,
  HostEffectTransport,
  HostEffectIntent,
  HostEffectEvidence,
  ShellEffectApplied,
}
import gunbc.host_effect_realize { host_effect_apply, host_effect_apply_gated }
import gunbc.live_deploy.readiness {
  live_deploy_poll_until_service_ready_for_deploy,
  ServiceReadyApplyEffect,
  ServiceReadyEvidence,
}
import std.realization_reconcile { Reconciliation, reconciliation_converged, Converged, NotConverged }
import std.process { ProcessExit, ExitSuccess, exit_failure }

fn live_deploy_mutation_denied(
  target: NodeControlPlane,
  script: String,
  transport: HostEffectTransport,
  gate: AccessDecision
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  NotConverged {
    reason: deploy_access_decision_reason(d: gate),
    applied: HostEffectIntent {
      target: target,
      effect: ShellCommand { script: script },
      evidence: host_effect_identity_evidence,
      transport: transport,
      privilege_denial: Present { value: gate },
    },
  }
}

fn live_deploy_fold(
  spec: DeploymentSpec,
  script: String,
  transport: HostEffectTransport,
  access: DeployAccess,
  fixture_actor: DeployAccessActor?,
  fixture_host: DeployTargetHostObservation?
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  let target = HostOs { node: spec.target.host }
  let gate = deploy_mutation_gate(
    access: access,
    fixture_actor: fixture_actor,
    fixture_host: fixture_host
  )
  match gate {
    Deny { reason: _ } =>
      live_deploy_mutation_denied(
        target: target,
        script: script,
        transport: transport,
        gate: gate
      )
    Permit =>
      host_effect_apply_gated(
        access: access,
        target: target,
        effect: ShellCommand { script: script },
        evidence: host_effect_identity_evidence,
        transport: transport,
        fixture_actor: fixture_actor
      )
  }
}

fn live_deploy_ensure_dependency(
  spec: DeploymentSpec,
  dep: DeploymentDependencyStep,
  transport: HostEffectTransport,
  access: DeployAccess
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  live_deploy_fold(
    spec: spec,
    script: deployment_ensure_dependency_script(dep: dep),
    transport: transport,
    access: access,
    fixture_actor: Absent,
    fixture_host: Absent
  )
}

fn live_deploy_apply_mutation_via_transport(
  spec: DeploymentSpec,
  transport: HostEffectTransport,
  access: DeployAccess
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  live_deploy_fold(
    spec: spec,
    script: live_deploy_apply_script_for(spec: spec),
    transport: transport,
    access: access,
    fixture_actor: Absent,
    fixture_host: Absent
  )
}

fn live_deploy_apply_readiness_gate(
  spec: DeploymentSpec,
  transport: HostEffectTransport,
  access: DeployAccess,
  mutation: Reconciliation<HostEffectIntent, HostEffectEvidence>
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  live_deploy_apply_readiness_gate_with_readiness(
    mutation: mutation,
    readiness: live_deploy_poll_until_service_ready_for_deploy(
      spec: spec,
      transport: transport,
      access: access,
    ),
  )
}

fn live_deploy_apply_readiness_gate_with_readiness(
  mutation: Reconciliation<HostEffectIntent, HostEffectEvidence>,
  readiness: Reconciliation<ServiceReadyApplyEffect, ServiceReadyEvidence>,
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  if !reconciliation_converged(r: mutation) {
    mutation
  } else {
    if reconciliation_converged(r: readiness) {
      mutation
    } else {
      match readiness {
        NotConverged { reason: why, applied: _ } =>
          match mutation {
            Converged { evidence: _, applied: intent } =>
              NotConverged { reason: why, applied: intent }
            NotConverged { reason: _, applied: intent } =>
              NotConverged { reason: why, applied: intent }
          }
        Converged { evidence: _, applied: _ } => mutation
      }
    }
  }
}

fn live_deploy_apply_digest_readback_via_transport(
  spec: DeploymentSpec,
  transport: HostEffectTransport,
  access: DeployAccess,
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  live_deploy_fold(
    spec: spec,
    script: roadmap_site_digest_readback_script(port: deployment_plan_listen_port(spec: spec)),
    transport: transport,
    access: access,
    fixture_actor: Absent,
    fixture_host: Absent
  )
}

fn live_deploy_apply_via_transport(
  spec: DeploymentSpec,
  transport: HostEffectTransport,
  access: DeployAccess
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  let mutation = live_deploy_apply_mutation_via_transport(
    spec: spec,
    transport: transport,
    access: access,
  )
  let gated = live_deploy_apply_readiness_gate(
    spec: spec,
    transport: transport,
    access: access,
    mutation: mutation,
  )
  if !reconciliation_converged(r: gated) {
    gated
  } else {
    let digest = live_deploy_apply_digest_readback_via_transport(
      spec: spec,
      transport: transport,
      access: access,
    )
    if reconciliation_converged(r: digest) {
      gated
    } else {
      match digest {
        NotConverged { reason: why, applied: _ } =>
          match gated {
            Converged { evidence: _, applied: intent } =>
              NotConverged { reason: why, applied: intent }
            NotConverged { reason: _, applied: intent } =>
              NotConverged { reason: why, applied: intent }
          }
        Converged { evidence: _, applied: _ } => gated
      }
    }
  }
}

fn live_deploy_retract_via_transport(
  spec: DeploymentSpec,
  transport: HostEffectTransport,
  access: DeployAccess
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  live_deploy_fold(
    spec: spec,
    script: live_deploy_retract_script_for(spec: spec),
    transport: transport,
    access: access,
    fixture_actor: Absent,
    fixture_host: Absent
  )
}

fn live_deploy_access_preflight_for(access: DeployAccess) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  let proof = deploy_target_proof_from_access(access: access)
  if !deploy_target_ssh_proof_structurally_valid(proof: proof) {
    NotConverged {
      reason: "live_deploy: deploy target-host proof structurally invalid; fail-closed",
      applied: HostEffectIntent {
        target: HostOs { node: access.host },
        effect: ShellCommand { script: "" },
        evidence: host_effect_identity_evidence,
        transport: access.transport,
        privilege_denial: none,
      },
    }
  } else {
    let target_host = host_effect_apply(
      target: HostOs { node: access.host },
      effect: ShellCommand { script: deploy_target_host_preflight_script(access: access) },
      evidence: host_effect_identity_evidence,
      transport: access.transport
    )
    if !reconciliation_converged(r: target_host) {
      target_host
    } else {
      let intent = HostEffectIntent {
        target: HostOs { node: access.host },
        effect: ShellCommand { script: "" },
        evidence: host_effect_identity_evidence,
        transport: access.transport,
        privilege_denial: none,
      }
      let privilege_verdict = deploy_access_check_observed(access: access)
      match privilege_verdict {
        Permit =>
          Converged {
            evidence: ShellEffectApplied {
              exit_code: 0,
              stdout: deploy_access_preflight_pass_message(access: access),
            },
            applied: intent,
          }
        Deny { reason: _ } =>
          NotConverged {
            reason: deploy_access_decision_reason(d: privilege_verdict),
            applied: HostEffectIntent {
              target: HostOs { node: access.host },
              effect: ShellCommand { script: "" },
              evidence: host_effect_identity_evidence,
              transport: access.transport,
              privilege_denial: Present { value: privilege_verdict },
            },
          }
      }
    }
  }
}

fn live_deploy_access_preflight() -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  live_deploy_access_preflight_for(access: ci_deploy_srv1_access)
}

fn live_deploy_apply_srv1_with_access(access: DeployAccess) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  live_deploy_apply_via_transport(
    spec: deployment_spec_srv1(),
    transport: access.transport,
    access: access
  )
}

fn live_deploy_retract_srv1_with_access(access: DeployAccess) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  live_deploy_retract_via_transport(
    spec: deployment_spec_srv1(),
    transport: access.transport,
    access: access
  )
}

fn live_deploy_apply_srv1() -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  live_deploy_apply_srv1_with_access(access: ci_deploy_srv1_access)
}

fn live_deploy_retract_srv1() -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  live_deploy_retract_srv1_with_access(access: ci_deploy_srv1_access)
}

fn live_deploy_reconciliation_exit(r: Reconciliation<HostEffectIntent, HostEffectEvidence>) -> ProcessExit {
  if reconciliation_converged(r: r) {
    ExitSuccess
  } else {
    match r {
      NotConverged { reason: why, applied: _ } => exit_failure(reason: why)
      Converged { evidence: _, applied: _ } => ExitSuccess
    }
  }
}

fn live_deploy_wet_with_access(access: DeployAccess) -> ProcessExit {
  let preflight = live_deploy_access_preflight_for(access: access)
  if !reconciliation_converged(r: preflight) {
    live_deploy_reconciliation_exit(r: preflight)
  } else {
    live_deploy_reconciliation_exit(r: live_deploy_apply_srv1_with_access(access: access))
  }
}

fn live_deploy_retract_wet_with_access(access: DeployAccess) -> ProcessExit {
  let preflight = live_deploy_access_preflight_for(access: access)
  if !reconciliation_converged(r: preflight) {
    live_deploy_reconciliation_exit(r: preflight)
  } else {
    live_deploy_reconciliation_exit(r: live_deploy_retract_srv1_with_access(access: access))
  }
}

func live_deploy_apply_srv1_wet() -> ProcessExit {
  live_deploy_wet_with_access(access: ci_deploy_srv1_access)
}

func live_deploy_apply_srv1_operator_wet() -> ProcessExit {
  live_deploy_wet_with_access(access: ci_deploy_srv1_operator_access)
}

func live_deploy_retract_srv1_wet() -> ProcessExit {
  live_deploy_retract_wet_with_access(access: ci_deploy_srv1_access)
}

func live_deploy_retract_srv1_operator_wet() -> ProcessExit {
  live_deploy_retract_wet_with_access(access: ci_deploy_srv1_operator_access)
}
