fn live_deploy_preflight_intent(access: DeployAccess) -> HostEffectIntent {
  HostEffectIntent {
    target: HostOs { node: access.host },
    effect: DeployAccessPreflight {},
    evidence: host_effect_identity_evidence,
    transport: access.transport,
    privilege_denial: none,
  }
}

fn live_deploy_mutation_denied(
  target: NodeControlPlane,
  effect: HostEffect,
  transport: HostEffectTransport,
  gate: AccessDecision
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  NotConverged {
    reason: deploy_access_decision_reason(d: gate),
    applied: HostEffectIntent {
      target: target,
      effect: effect,
      evidence: host_effect_identity_evidence,
      transport: transport,
      privilege_denial: Present { value: gate },
    },
  }
}

// ONE DEPLOYMENT, ONE PORT. Blue/green was deleted at the root on 2026-08-19 by operator directive,
// and the reason is the one its own predecessor note recorded against itself: blue/green is sound
// for a STATELESS server, and this dashboard is stateful. The compromise it reached -- the slot
// owns source, binary, unit and port while dispatch worktrees, attempt evidence and the tmux server
// stay host-shared -- is a two-copy deployment that is only half two copies, and it cost more to
// reason about than the zero-downtime swap was worth for a single-operator dashboard.
//
// WHAT WENT, AS ONE POPULATION: the slot selection coproduct and its Tailscale-status read, the
// deploy-idle-then-flip-then-retire fold, the slot/route/retiring spec projections, and the second
// HostDashboardInstance. What replaces them is this: apply converges a caller-supplied
// DeploymentSpec in place (gunbc.live_deploy.desired selected_deployment_spec), members in
// declared order, and the Tailscale mapping is an ordinary member pointing at that spec's port
// rather than a route flipped between two.
//
// WHAT IS HONESTLY LOST is the property blue/green existed to buy: a failed candidate can no longer
// be discovered on an idle slot while the old process keeps serving. A bad deploy now restarts the
// one service, and the readiness gate refuses AFTER the restart rather than before a flip -- so the
// failure mode is downtime, not a silent bad cutover. That trade is the point of the directive, not
// an oversight, and the mitigation is that every member is idempotent and a retract remains
// available.
//
// THE HAZARD THIS ALSO CLOSES: two slots meant two belt timers, both enabled, sharing one dispatch-
// worktree root and one attempt-state root. Nothing prevented a collision except that both belts
// happened to be crashing; with one deployment there is one belt and the prepare/activate split it
// would have needed is no longer owed.
//
// A SECOND ORDERING CONSEQUENCE, named because the loss above is not the only one. Under the
// deleted cutover fold the route write ran AFTER the candidate slot converged, readiness gate
// included. The mapping is now an ordinary member, last in deployment_owned_steps and inside the
// mutation, so the route is asserted BEFORE live_deploy_apply_readiness_gate runs -- which is, in
// shape, the pre-blue/green ordering that blue_green_spec_partition_note recorded as having
// recreated a 502 window. It is not that defect here, because with one port the write is an
// idempotent re-assert of the same endpoint-to-8080 mapping rather than a redirection to an
// unverified process, so it opens no window beyond the restart downtime already accepted above. The
// residual is bounded by the realization: if the Tailscale mapping is ever applied as remove-then-
// add rather than as a replace, the route is briefly ABSENT while the service is unverified. That
// is a property of extdeps.tailscale.serve, not of this fold, and it is stated here so the ordering
// is a known quantity rather than something a later reader rediscovers as a surprise.
fn live_deploy_fold(
  spec: DeploymentSpec,
  effect: HostEffect,
  transport: HostEffectTransport,
  access: DeployAccess,
  fixture_actor: DeployAccessActor?,
  fixture_host: DeployTargetHostObservation?
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  let target = HostOs { node: spec.target.host }
  let gate = deploy_mutation_gate(
    access: access,
    fixture_actor: fixture_actor,
    fixture_host: fixture_host
  )
  match gate {
    Deny { refusal: _ } =>
      live_deploy_mutation_denied(
        target: target,
        effect: effect,
        transport: transport,
        gate: gate
      )
    Permit =>
      host_effect_apply_gated(
        access: access,
        target: target,
        effect: effect,
        evidence: host_effect_identity_evidence,
        transport: transport,
        fixture_actor: fixture_actor
      )
  }
}

fn live_deploy_ensure_dependency(
  spec: DeploymentSpec,
  dep: DeploymentDependencyStep,
  transport: HostEffectTransport,
  access: DeployAccess
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  live_deploy_fold(
    spec: spec,
    effect: LiveDeployEnsureDependency { dep: dep },
    transport: transport,
    access: access,
    fixture_actor: Absent,
    fixture_host: Absent
  )
}

// THE PLAN IS DERIVED FROM THE HOST BEFORE THE MUTATION IS BUILT (gunbc.live_deploy.member_observe):
// the same evaluation that decides also acts, and a plan that could not be derived refuses here with
// every member's cause, installing nothing -- never the whole roster as a fallback.
fn live_deploy_apply_mutation_via_transport(
  spec: DeploymentSpec,
  candidate: CandidateRelease,
  transport: HostEffectTransport,
  access: DeployAccess
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  match deployment_effect_plan(spec: spec, candidate: candidate, transport: transport) {
    EffectsRefused { refusals } =>
      NotConverged {
        reason: join(["live_deploy: the deployment plan could not be derived from the host: ", join(map(refusals, d => decision_label(d: d)), "; ")], ""),
        applied: live_deploy_preflight_intent(access: access),
      }
    EffectsDerived { plan } =>
      live_deploy_fold(
        spec: spec,
        effect: LiveDeployApply { spec: spec, candidate: candidate, plan: plan },
        transport: transport,
        access: access,
        fixture_actor: Absent,
        fixture_host: Absent
      )
  }
}

fn live_deploy_apply_readiness_gate(
  spec: DeploymentSpec,
  candidate: CandidateRelease,
  transport: HostEffectTransport,
  access: DeployAccess,
  mutation: Reconciliation<HostEffectIntent, HostEffectEvidence>
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  live_deploy_apply_readiness_gate_with_readiness(
    mutation: mutation,
    readiness: live_deploy_poll_until_service_ready_for_deploy(
      spec: spec,
      candidate: candidate,
      transport: transport,
      access: access,
    ),
  )
}

// One NotConverged, reached from both non-Ready arms. The Pending/Refused
// distinction is NOT erased by the collapse: service_readiness_reason carries the
// readiness value into the reason, and the retry decision that consumes the
// distinction lives in the poll, not in this gate.
fn readiness_gate_not_converged(
  mutation: Reconciliation<HostEffectIntent, HostEffectEvidence>,
  readiness: ServiceReadiness,
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  let intent = match mutation {
    Converged { evidence: _, applied: applied_intent } => applied_intent
    NotConverged { reason: _, applied: applied_intent } => applied_intent
  }
  NotConverged { reason: service_readiness_reason(r: readiness), applied: intent }
}

fn live_deploy_apply_readiness_gate_with_readiness(
  mutation: Reconciliation<HostEffectIntent, HostEffectEvidence>,
  readiness: ServiceReadiness,
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  if !reconciliation_converged(r: mutation) {
    mutation
  } else {
    match readiness {
      Ready { evidence: _ } => mutation
      Pending { cause: _ } => readiness_gate_not_converged(mutation: mutation, readiness: readiness)
      Refused { cause: _ } => readiness_gate_not_converged(mutation: mutation, readiness: readiness)
    }
  }
}

fn live_deploy_apply_digest_readback_via_transport(
  spec: DeploymentSpec,
  transport: HostEffectTransport,
  access: DeployAccess,
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  live_deploy_fold(
    spec: spec,
    effect: LiveDeployDigestReadback { port: deployment_plan_listen_port(spec: spec) },
    transport: transport,
    access: access,
    fixture_actor: Absent,
    fixture_host: Absent
  )
}

// THE MEMBER IDENTITIES ARE READ BACK AFTER READINESS, and readiness is not a substitute for it.
// Readiness proves the unit answers /healthz as the candidate; an equivalent binary reporting the
// same revision, or a unit file rewritten after the copy, would pass it. The plan was derived from
// the host's member identities, so the transaction closes by observing them again
// (gunbc.live_deploy.member_observe deployment_identity_readback) and requiring every member
// AlreadyConverged -- a remaining mutation names which member the apply failed to land, and a refusal
// names which member could not be read afterwards. Both are NotConverged, never a green with a note.
fn live_deploy_apply_identity_readback_gate(
  spec: DeploymentSpec,
  candidate: CandidateRelease,
  transport: HostEffectTransport,
  mutation: Reconciliation<HostEffectIntent, HostEffectEvidence>,
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  let intent = match mutation {
    Converged { evidence: _, applied: i } => i
    NotConverged { reason: _, applied: i } => i
  }
  match deployment_identity_readback(spec: spec, candidate: candidate, transport: transport) {
    IdentityReadbackConverged => mutation
    IdentityReadbackDrift { remaining } =>
      NotConverged {
        reason: join(["live_deploy: the apply completed and readiness held, but the host's member identities still differ from the release: ", join(remaining, "; ")], ""),
        applied: intent,
      }
    IdentityReadbackRefused { refusals } =>
      NotConverged {
        reason: join(["live_deploy: the apply completed but the member identities could not be read back: ", join(map(refusals, d => decision_label(d: d)), "; ")], ""),
        applied: intent,
      }
  }
}

fn live_deploy_apply_via_transport(
  spec: DeploymentSpec,
  candidate: CandidateRelease,
  transport: HostEffectTransport,
  access: DeployAccess
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  let mutation = live_deploy_apply_mutation_via_transport(
    spec: spec,
    candidate: candidate,
    transport: transport,
    access: access,
  )
  let gated = live_deploy_apply_readiness_gate(
    spec: spec,
    candidate: candidate,
    transport: transport,
    access: access,
    mutation: mutation,
  )
  if !reconciliation_converged(r: gated) {
    gated
  } else {
    let digest = live_deploy_apply_digest_readback_via_transport(
      spec: spec,
      transport: transport,
      access: access,
    )
    if reconciliation_converged(r: digest) {
      live_deploy_apply_identity_readback_gate(spec: spec, candidate: candidate, transport: transport, mutation: gated)
    } else {
      match digest {
        NotConverged { reason: why, applied: _ } =>
          match gated {
            Converged { evidence: _, applied: intent } =>
              NotConverged { reason: why, applied: intent }
            NotConverged { reason: _, applied: intent } =>
              NotConverged { reason: why, applied: intent }
          }
        Converged { evidence: _, applied: _ } => gated
      }
    }
  }
}

fn live_deploy_retract_via_transport(
  spec: DeploymentSpec,
  transport: HostEffectTransport,
  access: DeployAccess
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  live_deploy_fold(
    spec: spec,
    effect: LiveDeployRetract { spec: spec },
    transport: transport,
    access: access,
    fixture_actor: Absent,
    fixture_host: Absent
  )
}

fn live_deploy_access_preflight_for(access: DeployAccess) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  let proof = deploy_target_proof_from_access(access: access)
  let intent = live_deploy_preflight_intent(access: access)
  if !deploy_target_ssh_proof_structurally_valid(proof: proof) {
    NotConverged {
      reason: "live_deploy: deploy target-host proof structurally invalid; fail-closed",
      applied: intent,
    }
  } else {
    let gate = deploy_mutation_gate(
      access: access,
      fixture_actor: Absent,
      fixture_host: Absent
    )
    match gate {
      Permit =>
        Converged {
          evidence: ShellEffectApplied {
            exit_code: 0,
            stdout: deploy_access_preflight_pass_message(access: access),
            stderr: "",
          },
          applied: intent,
        }
      Deny { refusal: _ } =>
        NotConverged {
          reason: deploy_access_decision_reason(d: gate),
          applied: HostEffectIntent {
            target: intent.target,
            effect: intent.effect,
            evidence: intent.evidence,
            transport: intent.transport,
            privilege_denial: Present { value: gate },
          },
        }
    }
  }
}

fn live_deploy_access_preflight() -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  live_deploy_access_preflight_for(access: ci_deploy_srv1_access)
}

fn live_deploy_apply_with_access(
  spec: DeploymentSpec,
  access: DeployAccess,
  candidate: CandidateRelease,
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  live_deploy_apply_via_transport(
    spec: spec,
    candidate: candidate,
    transport: access.transport,
    access: access,
  )
}

fn live_deploy_apply_srv1_with_access(
  access: DeployAccess,
  candidate: CandidateRelease,
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  live_deploy_apply_with_access(
    spec: deployment_spec_srv1(),
    access: access,
    candidate: candidate,
  )
}

// A RETRACT OBSERVES NO CANDIDATE, WHICH IS WHY IT CANNOT FAIL FOR WANT OF ONE. It removes what
// this deployment owns; there is no release being installed, so there is nothing whose identity a
// retract could state and nothing for readiness to compare. While the revision rode on
// DeploymentServiceConfig this path had to construct one anyway, and worse, it called
// observe_candidate_release first — so a retract could refuse because git HEAD was unreadable, a
// condition with no bearing whatsoever on tearing down a unit.\n\nThe fold now passes
// RevisionNotInstalled, so the arm that would render an ExecStart refuses loudly instead of naming
// a revision this operation never had.
fn live_deploy_retract_with_access(
  spec: DeploymentSpec,
  access: DeployAccess,
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  live_deploy_retract_via_transport(
    spec: spec,
    transport: access.transport,
    access: access
  )
}

fn live_deploy_retract_srv1_with_access(
  access: DeployAccess,
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  live_deploy_retract_with_access(spec: deployment_spec_srv1(), access: access)
}

fn live_deploy_apply_srv1(candidate: CandidateRelease) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  live_deploy_apply_srv1_with_access(access: ci_deploy_srv1_access, candidate: candidate)
}

fn live_deploy_retract_srv1() -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  live_deploy_retract_srv1_with_access(access: ci_deploy_srv1_access)
}

fn live_deploy_reconciliation_exit(r: Reconciliation<HostEffectIntent, HostEffectEvidence>) -> ProcessExit {
  if reconciliation_converged(r: r) {
    ExitSuccess
  } else {
    match r {
      NotConverged { reason: why, applied: _ } => exit_failure(reason: why)
      Converged { evidence: _, applied: _ } => ExitSuccess
    }
  }
}

// THE ONE OBSERVATION POINT OF THE INVOCATION, AND IT IS HERE BECAUSE HERE IS BEFORE EVERY
// MUTATION. The preflight has not run, no rsync has touched the host, no unit has been written; the
// deploying checkout is exactly the tree the job was handed. Observing later — inside the cutover,
// inside the emitter, inside a readiness retry — would read a tree the deploy itself may have
// altered, and would give the invocation two revisions that both look right locally.
//
// A REFUSAL HERE STOPS THE LINE BEFORE ANYTHING IS TOUCHED. A deploy that cannot name the release
// it is installing has nothing to write into ExecStart and nothing to verify the routed process
// against, so it exits with the typed cause rather than proceeding with a placeholder. This is the
// cheapest possible place to refuse: nothing has been mutated, so there is no half-applied state to
// reason about and no rollback to perform.

// THE ADMISSION IS CHECKED AHEAD OF THE CANDIDATE OBSERVATION, not after it, and the ordering is the
// point rather than an economy. The paragraph above calls this position the cheapest place to
// refuse because nothing has been mutated yet; a realization that cannot
// produce a valid target state is refusable one step EARLIER still, since it does not depend on
// which candidate was handed over. Observing first would make the log read as though the candidate
// were the problem.
//
// RETRACT DELIBERATELY DOES NOT CONSULT THIS. Removing a deployment does not perform the repository
// transition, and a wall that also blocked retraction would strand an operator with a host they
// could neither converge nor take down -- a refusal with no exit is not fail-closed, it is stuck.
fn live_deploy_wet_with_access_for_realization(
  spec: DeploymentSpec,
  access: DeployAccess,
  realization: RepositoryTransitionRealization,
) -> ProcessExit {
  match repository_transition_admission(realization: realization) {
    LegacyGitFileSyncNotAdmitted { reason: why } => exit_failure(reason: why)
    RepositoryTransitionAdmitted => live_deploy_admitted_wet_with_access(spec: spec, access: access)
  }
}

fn live_deploy_wet_with_access(spec: DeploymentSpec, access: DeployAccess) -> ProcessExit {
  live_deploy_wet_with_access_for_realization(
    spec: spec,
    access: access,
    realization: deployed_tree_repository_transition,
  )
}

// THE ORDERING GATE IS GONE (operator ruling 2026-09-07). This entry observes the candidate and
// hands it to the apply fold; there is no target-decision arm between those two, and a SUPERSEDED
// ancestry relation is not an exit. Whether anything mutates is decided later, per member, by
// gunbc.live_deploy.member_identity from observation of the host. Retract still does not consult
// ancestry, on the same grounds the repository-transition admission above states for itself: a
// wall that also blocked teardown would strand an operator with a host they could neither
// converge nor take down.
fn live_deploy_admitted_wet_with_access(spec: DeploymentSpec, access: DeployAccess) -> ProcessExit {
  match observe_candidate_release() {
    CandidateUnobservable { cause: why } =>
      exit_failure(reason: candidate_unobservable_detail(cause: why))
    CandidateObserved { candidate: candidate } =>
      live_deploy_candidate_wet_with_access(spec: spec, access: access, candidate: candidate)
  }
}

// THE OPERATOR'S CANDIDATE IS THE CANDIDATE. There is no ordering gate in front of this any more
// (operator ruling 2026-09-07, gunbc.live_deploy.revision carries the reasoning): the deploy no
// longer observes the running release to decide whether it may proceed. Convergence is decided
// where it is actually knowable -- per member, from observation of the host, by
// gunbc.live_deploy.member_identity -- so a re-deploy at the same revision is an ordinary
// zero-mutation plan rather than a short circuit, and a host whose tree drifted beneath an
// unchanged announcement is repaired rather than skipped.
fn live_deploy_candidate_wet_with_access(
  spec: DeploymentSpec,
  access: DeployAccess,
  candidate: CandidateRelease,
) -> ProcessExit {
  let preflight = live_deploy_access_preflight_for(access: access)
  if !reconciliation_converged(r: preflight) {
    live_deploy_reconciliation_exit(r: preflight)
  } else {
    live_deploy_reconciliation_exit(
      r: live_deploy_apply_with_access(spec: spec, access: access, candidate: candidate)
    )
  }
}

fn live_deploy_retract_wet_with_access(spec: DeploymentSpec, access: DeployAccess) -> ProcessExit {
  let preflight = live_deploy_access_preflight_for(access: access)
  if !reconciliation_converged(r: preflight) {
    live_deploy_reconciliation_exit(r: preflight)
  } else {
    live_deploy_reconciliation_exit(
      r: live_deploy_retract_with_access(spec: spec, access: access)
    )
  }
}

// ── STAGE 1 OF THE APPROVAL-BROKER CUTOVER, AS A DEPLOY RATHER THAN AS A TERMINAL SESSION ───
// IT RUNS THE SAME PREFLIGHT AND THE SAME MUTATION GATE as every other deploy on this spine, which
// is the point: an additive install is still a privileged host mutation, and giving it its own path
// around the gate would be the escape hatch DESIGN section 5 forbids at exactly the boundary the
// gate exists to hold.
//
// WHAT IT DOES NOT DO is restart gunbc-roadmap.service or write anything that deployment owns
// (operator directive 2026-09-19: roadmap redeploys are frozen at the current release until the
// cutover completes). That is a property of the EFFECT, not of this wrapper -- the arm's script
// writes the broker's two files and starts one unit -- so a later edit cannot quietly widen it here
// without widening the emitter the byte oracles pin.
//
// IT OBSERVES A CANDIDATE because the unit it writes names a release in its ExecStart, and a broker
// whose launch identity is not a revision must never be started: the cutover's next stage reads that
// identity back, and every reading after it would otherwise be about an unknown build.
fn approval_broker_dark_install_wet_with_access(
  spec: DeploymentSpec,
  access: DeployAccess,
) -> ProcessExit {
  match observe_candidate_release() {
    CandidateUnobservable { cause: why } =>
      exit_failure(reason: candidate_unobservable_detail(cause: why))
    CandidateObserved { candidate: candidate } => {
      let preflight = live_deploy_access_preflight_for(access: access)
      if !reconciliation_converged(r: preflight) {
        live_deploy_reconciliation_exit(r: preflight)
      } else {
        let mutation = live_deploy_fold(
          spec: spec,
          effect: LiveDeployApprovalBrokerDarkInstall { spec: spec, candidate: candidate },
          transport: access.transport,
          access: access,
          fixture_actor: Absent,
          fixture_host: Absent,
        )
        if !reconciliation_converged(r: mutation) {
          live_deploy_reconciliation_exit(r: mutation)
        } else {
          approval_broker_dark_install_readback_exit(spec: spec)
        }
      }
    }
  }
}

// THE INSTALL IS NOT THE POINT; THE READBACK IS. A converged mutation says the unit files were
// written and systemd was asked to start one -- it says nothing about whether a process came up,
// bound the port, or is the release this deploy just named. Stage 2 of the cutover is exactly that
// question, and this is where it is asked, so the plan has a production consumer rather than being
// an authority nobody calls (review 68050: an inert lens is a lie, DESIGN section 4b).
//
// THE PORT IS THE SPEC'S, which gunbc.live_deploy.spec derives from the cutover switch -- so the
// probe reaches the process this deploy actually placed, and cannot drift to the serving port while
// the roadmap is still a writer.
//
// THE ADMITTING ARM CARRIES NO MESSAGE because ProcessExit's success arm has no field to carry one;
// what the probe said reaches an operator through the refusal path, where it is needed, and through
// the journal of the unit that answered.
//
// IT EXITS ON THE STAGE BEING DISCHARGED, NOT ON BEING ADMITTED TO IT, and the difference is the
// defect review 68058 found in the first cut of this function: admission for ProveRelease asks
// whether the readback MAY BE ATTEMPTED and was a constant pass from here, so a broker that never
// bound its port still exited success while this annotation claimed the opposite.
//
// What goes red now: an unanswered probe, non-JSON bytes, a JSON value that is not an object, a
// missing or duplicated revision member, a non-string revision, and a revision that is not 40
// lowercase hex -- a converged mutation with any of those is a FAILED deploy.
fn approval_broker_dark_install_readback_exit(spec: DeploymentSpec) -> ProcessExit {
  let port = spec.approval_broker.listen.port
  let read = live_deploy_liveness_get_local(port: port, spec: spec)
  match dark_install_release_discharged(listening_port: port, read: read) {
    StageAdmitted { stage: _ } => ExitSuccess
    StageRefused { stage: _, cause: c } =>
      exit_failure(reason: join([
        "approval broker dark install: the unit was written but stage 2 (prove-release) refuses: ",
        cutover_refusal_reason(c: c) as String,
      ], ""))
  }
}

fn approval_broker_dark_install_srv1_operator_local_wet() -> ProcessExit {
  approval_broker_dark_install_wet_with_access(
    spec: deployment_spec_srv1(),
    access: ci_deploy_srv1_operator_local_access,
  )
}

fn approval_broker_dark_install_srv1_wet() -> ProcessExit {
  approval_broker_dark_install_wet_with_access(
    spec: deployment_spec_srv1(),
    access: ci_deploy_srv1_access,
  )
}

fn live_deploy_apply_srv1_wet() -> ProcessExit {
  live_deploy_wet_with_access(spec: deployment_spec_srv1(), access: ci_deploy_srv1_access)
}

fn live_deploy_apply_srv1_operator_wet() -> ProcessExit {
  live_deploy_wet_with_access(spec: deployment_spec_srv1(), access: ci_deploy_srv1_operator_access)
}

// The converge verb's deploy mode: the same admitted path the CI entry runs, under the operator
// principal on the host itself. Candidate observation, preflight, mutation and the readiness
// gate are all shared; nothing here is a second deploy.
fn live_deploy_apply_srv1_operator_local_wet() -> ProcessExit {
  live_deploy_wet_with_access(spec: deployment_spec_srv1(), access: ci_deploy_srv1_operator_local_access)
}

fn live_deploy_retract_srv1_wet() -> ProcessExit {
  live_deploy_retract_wet_with_access(spec: deployment_spec_srv1(), access: ci_deploy_srv1_access)
}

fn live_deploy_retract_srv1_operator_wet() -> ProcessExit {
  live_deploy_retract_wet_with_access(spec: deployment_spec_srv1(), access: ci_deploy_srv1_operator_access)
}


// ---------------------------------------------------------------- the receipted transaction entry
// THE DASHBOARD-DEPLOY MODE OF THE RLM-2 TRANSACTION. live_deploy_apply_srv1_wet stays as the
// operator's plain entry; this one is what the fleet-converge workflow's dashboard_deploy mode
// invokes, and it differs in exactly three ways, all of them additions around the SAME fold: (1) it
// binds its run and refuses unless GITHUB_SHA equals RLM_EXPECTED_REVISION and the observed
// candidate equals it too -- a deploy asked to install R must not install what it happens to have
// checked out; (2) it reads the fleet plan/apply provenance the dispatch named (RLM_PLAN_RUN_ID,
// RLM_APPLY_RUN_ID, RLM_PLAN_ARTIFACT_HASH) and carries it as provenance, never as eligibility; (3)
// it mints gunbc.live_deploy.apply_receipt LiveDeployApplyReceipt after the fold returns, with one
// independent post-apply /healthz observation and a completion instant, and writes it to the
// artifact path the workflow uploads. Whether the fold installed anything is LiveDeployApplyOutcome
// on that receipt, not a deleted target-decision label: the join reads apply_outcome.

fn live_deploy_post_apply_readiness(spec: DeploymentSpec, access: DeployAccess) -> LiveDeployReadinessOutcome {
  match live_deploy_healthz_get_for_port(port: deployment_plan_listen_port(spec: spec), spec: spec, transport: access.transport) {
    HealthzProbeRefused { probe_error: e } => LiveDeployReadinessRefused { detail: e }
    HealthzBodyRead { body: b } =>
      match observe_running_release_identity(healthz_body: b) {
        RunningReleaseIdentified { observation: o } =>
          LiveDeployReadinessObserved { revision: o.revision as String, surface: o.surface_bundle_identity.digest as String }
        RunningReleaseUnidentified { cause: c } => LiveDeployReadinessRefused { detail: running_release_unidentified_detail(cause: c) }
      }
  }
}

fn live_deploy_write_transaction_receipt(spec: DeploymentSpec, receipt: LiveDeployApplyReceipt, exit: ProcessExit) -> ProcessExit {
  let dir = live_deploy_apply_receipt_dir_for(instance_id: spec.instance_id as String)
  let path = live_deploy_apply_receipt_artifact_path_for(instance_id: spec.instance_id as String)
  match run_shell_commands(commands: [mkdir_parents_command(path: dir)], transport: LocalExec) {
    ExitFailure { code: _, reason: why } => exit_failure(reason: join(["live_deploy transaction: receipt dir refused: ", why], ""))
    ExitSuccess => {
      let wrote = Filesystem.Write(path: path, content: serialize_json(v: live_deploy_apply_receipt_json(r: receipt)))
      if !wrote.success {
        exit_failure(reason: join(["live_deploy transaction: receipt write refused at ", path, ": ", wrote.error], ""))
      } else {
        exit
      }
    }
  }
}

fn live_deploy_transaction_receipt_for(
  spec: DeploymentSpec,
  run: ActionsRunBinding,
  expected: String,
  candidate: CandidateRelease,
  candidate_tree: String,
  apply_outcome: LiveDeployApplyOutcome,
  readiness: LiveDeployReadinessOutcome,
  provenance: LiveDeployFleetProvenance,
) -> LiveDeployApplyReceipt {
  LiveDeployApplyReceipt {
    run: run,
    target: deployment_plan_host_identity(spec: spec),
    instance_id: spec.instance_id as String,
    expected_revision: expected,
    candidate_revision: candidate.revision as String,
    candidate_surface_identity: candidate.expected_surface_identity.digest as String,
    candidate_tree_oid: candidate_tree,
    apply_outcome: apply_outcome,
    readiness: readiness,
    provenance: provenance,
    completed_at: clock_now_probed_at_or_unknown() as String,
  }
}

fn live_deploy_transaction_decided(
  spec: DeploymentSpec,
  access: DeployAccess,
  run: ActionsRunBinding,
  expected: String,
  candidate: CandidateRelease,
  candidate_tree: String,
  provenance: LiveDeployFleetProvenance,
) -> ProcessExit {
      let preflight = live_deploy_access_preflight_for(access: access)
      if !reconciliation_converged(r: preflight) {
        live_deploy_write_transaction_receipt(
          spec: spec,
          receipt: live_deploy_transaction_receipt_for(spec: spec, run: run, expected: expected, candidate: candidate, candidate_tree: candidate_tree, apply_outcome: LiveDeployApplyNotConverged { reason: (match preflight { NotConverged { reason: why, applied: _ } => why  Converged { evidence: _, applied: _ } => "preflight" }) }, readiness: LiveDeployReadinessRefused { detail: "not observed: preflight refused" }, provenance: provenance),
          exit: live_deploy_reconciliation_exit(r: preflight),
        )
      } else {
        let applied = live_deploy_apply_with_access(spec: spec, access: access, candidate: candidate)
        let outcome = match applied {
          Converged { evidence: _, applied: _ } => LiveDeployApplyConverged
          NotConverged { reason: why, applied: _ } => LiveDeployApplyNotConverged { reason: why }
        }
        live_deploy_write_transaction_receipt(
          spec: spec,
          receipt: live_deploy_transaction_receipt_for(spec: spec, run: run, expected: expected, candidate: candidate, candidate_tree: candidate_tree, apply_outcome: outcome, readiness: live_deploy_post_apply_readiness(spec: spec, access: access), provenance: provenance),
          exit: live_deploy_reconciliation_exit(r: applied),
        )
  }
}

fn live_deploy_transaction_admitted(spec: DeploymentSpec, access: DeployAccess, run: ActionsRunBinding, expected: String, provenance: LiveDeployFleetProvenance) -> ProcessExit {
  match observe_candidate_release() {
    CandidateUnobservable { cause: why } =>
      exit_failure(reason: candidate_unobservable_detail(cause: why))
    CandidateObserved { candidate: candidate } =>
      if (candidate.revision as String) != expected {
        exit_failure(reason: join(["live_deploy transaction: CandidateNotExpected — the checkout is ", candidate.revision as String, " but R is ", expected], ""))
      } else {
        match observe_candidate_root_tree_oid(repo: ".") {
          CandidateTreeOidUnobservable { detail: d } =>
            exit_failure(reason: join(["live_deploy transaction: CandidateTreeUnobservable — ", d], ""))
          CandidateTreeOidObserved { oid_hex: candidate_tree } =>
            live_deploy_transaction_decided(
              spec: spec,
              access: access,
              run: run,
              expected: expected,
              candidate: candidate,
              candidate_tree: candidate_tree,
              provenance: provenance,
            )
        }
      }
  }
}

fn live_deploy_transaction_admitted_wet_with_access(spec: DeploymentSpec, access: DeployAccess) -> ProcessExit {
  match observe_actions_run_binding() {
    ActionsRunUnbound { variable: v, detail: d } =>
      exit_failure(reason: join(["live_deploy transaction: RunUnbound — ", v, " ", d, "; the transaction entry runs only inside the fleet-converge workflow"], ""))
    ActionsRunBound { binding: run } =>
      match read_expected_revision() {
        ExpectedRevisionAbsent { variable: v, detail: d } =>
          exit_failure(reason: join(["live_deploy transaction: ExpectedRevisionAbsent — ", v, " ", d], ""))
        ExpectedRevisionPresent { revision: expected } =>
          match admit_run_revision(binding: run, expected: expected) {
            RunRevisionRefused { expected: e, observed: o } =>
              exit_failure(reason: join(["live_deploy transaction: RunRevisionNotExpected — this run executes ", o, " but R is ", e], ""))
            RunRevisionAdmitted { revision: _ } =>
              match read_live_deploy_fleet_provenance() {
                FleetProvenanceAbsent { variable: v, detail: d } =>
                  exit_failure(reason: join(["live_deploy transaction: FleetProvenanceAbsent — ", v, " ", d], ""))
                FleetProvenancePresent { inputs: inputs } =>
                  match read_fleet_converge_plan_receipt_at(path: fleet_converge_plan_receipt_path) {
                    FleetConvergePlanReceiptUnreadable { reason: why } =>
                      exit_failure(reason: join(["live_deploy transaction: PlanReceiptUnreadable — ", why, "; the dashboard transaction refuses to run without the predecessor receipts it must cite"], ""))
                    FleetConvergePlanReceiptDecoded { receipt: plan_receipt } =>
                  match read_fleet_converge_apply_receipt_at(path: fleet_converge_apply_receipt_path) {
                    FleetConvergeApplyReceiptUnreadable { reason: why } =>
                      exit_failure(reason: join(["live_deploy transaction: FleetApplyReceiptUnreadable — ", why], ""))
                    FleetConvergeApplyReceiptDecoded { receipt: fleet_apply_receipt } => {
                  let provenance = LiveDeployFleetProvenance {
                    plan_run_id: inputs.plan_run_id,
                    apply_run_id: inputs.apply_run_id,
                    plan_artifact_hash: inputs.plan_artifact_hash,
                    plan_receipt_identity: fleet_converge_plan_receipt_identity_hex(r: plan_receipt),
                    apply_receipt_identity: fleet_converge_apply_receipt_identity_hex(r: fleet_apply_receipt),
                  }
                  live_deploy_transaction_admitted(spec: spec, access: access, run: run, expected: expected, provenance: provenance)
                  }
                  }
                  }
              }
          }
      }
  }
}

// THE TRANSACTION CONSULTS THE SAME ADMISSION BEFORE READING ITS WORKFLOW ENVIRONMENT OR RECEIPTS.
// Keeping realization injectable at this internal seam makes the refusing arm executable in a
// hermetic witness while the production entry below remains constructed from the one bound row.
fn live_deploy_transaction_wet_with_access_for_realization(
  spec: DeploymentSpec,
  access: DeployAccess,
  realization: RepositoryTransitionRealization,
) -> ProcessExit {
  match repository_transition_admission(realization: realization) {
    LegacyGitFileSyncNotAdmitted { reason: why } => exit_failure(reason: why)
    RepositoryTransitionAdmitted => live_deploy_transaction_admitted_wet_with_access(spec: spec, access: access)
  }
}

fn live_deploy_transaction_wet_with_access(spec: DeploymentSpec, access: DeployAccess) -> ProcessExit {
  live_deploy_transaction_wet_with_access_for_realization(
    spec: spec,
    access: access,
    realization: deployed_tree_repository_transition,
  )
}

fn live_deploy_apply_srv1_transaction_wet() -> ProcessExit {
  live_deploy_transaction_wet_with_access(spec: deployment_spec_srv1(), access: ci_deploy_srv1_access)
}
