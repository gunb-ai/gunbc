module gunbc.live_deploy.apply

data single_deployment_note: String = "ONE DEPLOYMENT, ONE PORT. Blue/green was deleted at the root on 2026-08-19 by operator directive, and the reason is the one its own predecessor note recorded against itself: blue/green is sound for a STATELESS server, and this dashboard is stateful. The compromise it reached -- the slot owns source, binary, unit and port while dispatch worktrees, attempt evidence and the tmux server stay host-shared -- is a two-copy deployment that is only half two copies, and it cost more to reason about than the zero-downtime swap was worth for a single-operator dashboard.\n\nWHAT WENT, AS ONE POPULATION: the slot selection coproduct and its Tailscale-status read, the deploy-idle-then-flip-then-retire fold, the slot/route/retiring spec projections, and the second HostDashboardInstance. What replaces them is this: apply converges deployment_spec_srv1 IN PLACE, members in declared order, and the Tailscale mapping is an ordinary member pointing at the one port rather than a route flipped between two.\n\nWHAT IS HONESTLY LOST is the property blue/green existed to buy: a failed candidate can no longer be discovered on an idle slot while the old process keeps serving. A bad deploy now restarts the one service, and the readiness gate refuses AFTER the restart rather than before a flip -- so the failure mode is downtime, not a silent bad cutover. That trade is the point of the directive, not an oversight, and the mitigation is that every member is idempotent and a retract remains available.\n\nTHE HAZARD THIS ALSO CLOSES: two slots meant two belt timers, both enabled, sharing one dispatch-worktree root and one attempt-state root. Nothing prevented a collision except that both belts happened to be crashing; with one deployment there is one belt and the prepare/activate split it would have needed is no longer owed.\n\nA SECOND ORDERING CONSEQUENCE, named because the loss above is not the only one. Under the deleted cutover fold the route write ran AFTER the candidate slot converged, readiness gate included. The mapping is now an ordinary member, last in deployment_owned_steps and inside the mutation, so the route is asserted BEFORE live_deploy_apply_readiness_gate runs -- which is, in shape, the pre-blue/green ordering that blue_green_spec_partition_note recorded as having recreated a 502 window. It is not that defect here, because with one port the write is an idempotent re-assert of the same endpoint-to-8080 mapping rather than a redirection to an unverified process, so it opens no window beyond the restart downtime already accepted above. The residual is bounded by the realization: if the Tailscale mapping is ever applied as remove-then-add rather than as a replace, the route is briefly ABSENT while the service is unverified. That is a property of extdeps.tailscale.serve, not of this fold, and it is stated here so the ordering is a known quantity rather than something a later reader rediscovers as a surprise."

fn live_deploy_preflight_intent(access: gunbc.ci_deploy_access.DeployAccess) -> gunbc.host_effect.HostEffectIntent {
  gunbc.host_effect.HostEffectIntent {
    target: gunbc.host_effect.HostOs { node: access.host },
    effect: gunbc.host_effect.DeployAccessPreflight {},
    evidence: gunbc.host_effect.host_effect_identity_evidence,
    transport: access.transport,
    privilege_denial: none,
  }
}

fn live_deploy_mutation_denied(
  target: gunbc.host_effect.NodeControlPlane,
  effect: gunbc.host_effect.HostEffect,
  transport: gunbc.host_effect.HostEffectTransport,
  gate: std.access.AccessDecision
) -> std.realization_reconcile.Reconciliation<gunbc.host_effect.HostEffectIntent, gunbc.host_effect.HostEffectEvidence> {
  std.realization_reconcile.NotConverged {
    reason: gunbc.ci_deploy_access.deploy_access_decision_reason(d: gate),
    applied: gunbc.host_effect.HostEffectIntent {
      target: target,
      effect: effect,
      evidence: gunbc.host_effect.host_effect_identity_evidence,
      transport: transport,
      privilege_denial: v2.std.optional.Present { value: gate },
    },
  }
}

fn live_deploy_fold(
  spec: gunbc.live_deploy.spec.DeploymentSpec,
  effect: gunbc.host_effect.HostEffect,
  transport: gunbc.host_effect.HostEffectTransport,
  access: gunbc.ci_deploy_access.DeployAccess,
  fixture_actor: gunbc.ci_deploy_access.DeployAccessActor?,
  fixture_host: gunbc.ci_deploy_target_host.DeployTargetHostObservation?
) -> std.realization_reconcile.Reconciliation<gunbc.host_effect.HostEffectIntent, gunbc.host_effect.HostEffectEvidence> {
  let target = gunbc.host_effect.HostOs { node: spec.target.host }
  let gate = gunbc.ci_deploy_access_observe.deploy_mutation_gate(
    access: access,
    fixture_actor: fixture_actor,
    fixture_host: fixture_host
  )
  match gate {
    std.access.Deny { refusal: _ } =>
      live_deploy_mutation_denied(
        target: target,
        effect: effect,
        transport: transport,
        gate: gate
      )
    Permit =>
      gunbc.host_effect_realize.host_effect_apply_gated(
        access: access,
        target: target,
        effect: effect,
        evidence: gunbc.host_effect.host_effect_identity_evidence,
        transport: transport,
        fixture_actor: fixture_actor
      )
  }
}

fn live_deploy_ensure_dependency(
  spec: gunbc.live_deploy.spec.DeploymentSpec,
  dep: gunbc.live_deploy.spec.DeploymentDependencyStep,
  transport: gunbc.host_effect.HostEffectTransport,
  access: gunbc.ci_deploy_access.DeployAccess
) -> std.realization_reconcile.Reconciliation<gunbc.host_effect.HostEffectIntent, gunbc.host_effect.HostEffectEvidence> {
  live_deploy_fold(
    spec: spec,
    effect: gunbc.host_effect.LiveDeployEnsureDependency { dep: dep },
    transport: transport,
    access: access,
    fixture_actor: v2.std.optional.Absent,
    fixture_host: v2.std.optional.Absent
  )
}

fn live_deploy_apply_mutation_via_transport(
  spec: gunbc.live_deploy.spec.DeploymentSpec,
  candidate: gunbc.live_deploy.candidate.CandidateRelease,
  transport: gunbc.host_effect.HostEffectTransport,
  access: gunbc.ci_deploy_access.DeployAccess
) -> std.realization_reconcile.Reconciliation<gunbc.host_effect.HostEffectIntent, gunbc.host_effect.HostEffectEvidence> {
  live_deploy_fold(
    spec: spec,
    effect: gunbc.host_effect.LiveDeployApply { spec: spec, candidate: candidate },
    transport: transport,
    access: access,
    fixture_actor: v2.std.optional.Absent,
    fixture_host: v2.std.optional.Absent
  )
}

fn live_deploy_apply_readiness_gate(
  spec: gunbc.live_deploy.spec.DeploymentSpec,
  candidate: gunbc.live_deploy.candidate.CandidateRelease,
  transport: gunbc.host_effect.HostEffectTransport,
  access: gunbc.ci_deploy_access.DeployAccess,
  mutation: std.realization_reconcile.Reconciliation<gunbc.host_effect.HostEffectIntent, gunbc.host_effect.HostEffectEvidence>
) -> std.realization_reconcile.Reconciliation<gunbc.host_effect.HostEffectIntent, gunbc.host_effect.HostEffectEvidence> {
  live_deploy_apply_readiness_gate_with_readiness(
    mutation: mutation,
    readiness: gunbc.live_deploy.readiness.live_deploy_poll_until_service_ready_for_deploy(
      spec: spec,
      candidate: candidate,
      transport: transport,
      access: access,
    ),
  )
}

fn live_deploy_apply_readiness_gate_with_readiness(
  mutation: std.realization_reconcile.Reconciliation<gunbc.host_effect.HostEffectIntent, gunbc.host_effect.HostEffectEvidence>,
  readiness: std.realization_reconcile.Reconciliation<gunbc.live_deploy.readiness.ServiceReadyApplyEffect, gunbc.live_deploy.readiness.ServiceReadyEvidence>,
) -> std.realization_reconcile.Reconciliation<gunbc.host_effect.HostEffectIntent, gunbc.host_effect.HostEffectEvidence> {
  if !std.realization_reconcile.reconciliation_converged(r: mutation) {
    mutation
  } else {
    if std.realization_reconcile.reconciliation_converged(r: readiness) {
      mutation
    } else {
      match readiness {
        NotConverged { reason: why, applied: _ } =>
          match mutation {
            std.realization_reconcile.Converged { evidence: _, applied: intent } =>
              std.realization_reconcile.NotConverged { reason: why, applied: intent }
            NotConverged { reason: _, applied: intent } =>
              std.realization_reconcile.NotConverged { reason: why, applied: intent }
          }
        std.realization_reconcile.Converged { evidence: _, applied: _ } => mutation
      }
    }
  }
}

fn live_deploy_apply_digest_readback_via_transport(
  spec: gunbc.live_deploy.spec.DeploymentSpec,
  transport: gunbc.host_effect.HostEffectTransport,
  access: gunbc.ci_deploy_access.DeployAccess,
) -> std.realization_reconcile.Reconciliation<gunbc.host_effect.HostEffectIntent, gunbc.host_effect.HostEffectEvidence> {
  live_deploy_fold(
    spec: spec,
    effect: gunbc.host_effect.LiveDeployDigestReadback { port: gunbc.live_deploy.spec.deployment_plan_listen_port(spec: spec) },
    transport: transport,
    access: access,
    fixture_actor: v2.std.optional.Absent,
    fixture_host: v2.std.optional.Absent
  )
}

fn live_deploy_apply_via_transport(
  spec: gunbc.live_deploy.spec.DeploymentSpec,
  candidate: gunbc.live_deploy.candidate.CandidateRelease,
  transport: gunbc.host_effect.HostEffectTransport,
  access: gunbc.ci_deploy_access.DeployAccess
) -> std.realization_reconcile.Reconciliation<gunbc.host_effect.HostEffectIntent, gunbc.host_effect.HostEffectEvidence> {
  let mutation = live_deploy_apply_mutation_via_transport(
    spec: spec,
    candidate: candidate,
    transport: transport,
    access: access,
  )
  let gated = live_deploy_apply_readiness_gate(
    spec: spec,
    candidate: candidate,
    transport: transport,
    access: access,
    mutation: mutation,
  )
  if !std.realization_reconcile.reconciliation_converged(r: gated) {
    gated
  } else {
    let digest = live_deploy_apply_digest_readback_via_transport(
      spec: spec,
      transport: transport,
      access: access,
    )
    if std.realization_reconcile.reconciliation_converged(r: digest) {
      gated
    } else {
      match digest {
        NotConverged { reason: why, applied: _ } =>
          match gated {
            std.realization_reconcile.Converged { evidence: _, applied: intent } =>
              std.realization_reconcile.NotConverged { reason: why, applied: intent }
            NotConverged { reason: _, applied: intent } =>
              std.realization_reconcile.NotConverged { reason: why, applied: intent }
          }
        std.realization_reconcile.Converged { evidence: _, applied: _ } => gated
      }
    }
  }
}

fn live_deploy_retract_via_transport(
  spec: gunbc.live_deploy.spec.DeploymentSpec,
  transport: gunbc.host_effect.HostEffectTransport,
  access: gunbc.ci_deploy_access.DeployAccess
) -> std.realization_reconcile.Reconciliation<gunbc.host_effect.HostEffectIntent, gunbc.host_effect.HostEffectEvidence> {
  live_deploy_fold(
    spec: spec,
    effect: gunbc.host_effect.LiveDeployRetract { spec: spec },
    transport: transport,
    access: access,
    fixture_actor: v2.std.optional.Absent,
    fixture_host: v2.std.optional.Absent
  )
}

fn live_deploy_access_preflight_for(access: gunbc.ci_deploy_access.DeployAccess) -> std.realization_reconcile.Reconciliation<gunbc.host_effect.HostEffectIntent, gunbc.host_effect.HostEffectEvidence> {
  let proof = gunbc.ci_deploy_access.deploy_target_proof_from_access(access: access)
  let intent = live_deploy_preflight_intent(access: access)
  if !gunbc.ci_deploy_target_host.deploy_target_ssh_proof_structurally_valid(proof: proof) {
    std.realization_reconcile.NotConverged {
      reason: "live_deploy: deploy target-host proof structurally invalid; fail-closed",
      applied: intent,
    }
  } else {
    let gate = gunbc.ci_deploy_access_observe.deploy_mutation_gate(
      access: access,
      fixture_actor: v2.std.optional.Absent,
      fixture_host: v2.std.optional.Absent
    )
    match gate {
      Permit =>
        std.realization_reconcile.Converged {
          evidence: gunbc.host_effect.ShellEffectApplied {
            exit_code: 0,
            stdout: gunbc.ci_deploy_access.deploy_access_preflight_pass_message(access: access),
            stderr: "",
          },
          applied: intent,
        }
      std.access.Deny { refusal: _ } =>
        std.realization_reconcile.NotConverged {
          reason: gunbc.ci_deploy_access.deploy_access_decision_reason(d: gate),
          applied: gunbc.host_effect.HostEffectIntent {
            target: intent.target,
            effect: intent.effect,
            evidence: intent.evidence,
            transport: intent.transport,
            privilege_denial: v2.std.optional.Present { value: gate },
          },
        }
    }
  }
}

fn live_deploy_access_preflight() -> std.realization_reconcile.Reconciliation<gunbc.host_effect.HostEffectIntent, gunbc.host_effect.HostEffectEvidence> {
  live_deploy_access_preflight_for(access: gunbc.ci_deploy_access.ci_deploy_srv1_access)
}

fn live_deploy_apply_srv1_with_access(
  access: gunbc.ci_deploy_access.DeployAccess,
  candidate: gunbc.live_deploy.candidate.CandidateRelease,
) -> std.realization_reconcile.Reconciliation<gunbc.host_effect.HostEffectIntent, gunbc.host_effect.HostEffectEvidence> {
  live_deploy_apply_via_transport(
    spec: gunbc.live_deploy.spec.deployment_spec_srv1(),
    candidate: candidate,
    transport: access.transport,
    access: access,
  )
}

data retract_carries_no_candidate_note: String = "A RETRACT OBSERVES NO CANDIDATE, WHICH IS WHY IT CANNOT FAIL FOR WANT OF ONE. It removes what this deployment owns; there is no release being installed, so there is nothing whose identity a retract could state and nothing for readiness to compare. While the revision rode on DeploymentServiceConfig this path had to construct one anyway, and worse, it called observe_candidate_release first — so a retract could refuse because git HEAD was unreadable, a condition with no bearing whatsoever on tearing down a unit.\\n\\nThe fold now passes RevisionNotInstalled, so the arm that would render an ExecStart refuses loudly instead of naming a revision this operation never had."

fn live_deploy_retract_srv1_with_access(
  access: gunbc.ci_deploy_access.DeployAccess,
) -> std.realization_reconcile.Reconciliation<gunbc.host_effect.HostEffectIntent, gunbc.host_effect.HostEffectEvidence> {
  live_deploy_retract_via_transport(
    spec: gunbc.live_deploy.spec.deployment_spec_srv1(),
    transport: access.transport,
    access: access
  )
}

fn live_deploy_apply_srv1(candidate: gunbc.live_deploy.candidate.CandidateRelease) -> std.realization_reconcile.Reconciliation<gunbc.host_effect.HostEffectIntent, gunbc.host_effect.HostEffectEvidence> {
  live_deploy_apply_srv1_with_access(access: gunbc.ci_deploy_access.ci_deploy_srv1_access, candidate: candidate)
}

fn live_deploy_retract_srv1() -> std.realization_reconcile.Reconciliation<gunbc.host_effect.HostEffectIntent, gunbc.host_effect.HostEffectEvidence> {
  live_deploy_retract_srv1_with_access(access: gunbc.ci_deploy_access.ci_deploy_srv1_access)
}

fn live_deploy_reconciliation_exit(r: std.realization_reconcile.Reconciliation<gunbc.host_effect.HostEffectIntent, gunbc.host_effect.HostEffectEvidence>) -> std.process.ProcessExit {
  if std.realization_reconcile.reconciliation_converged(r: r) {
    std.process.ExitSuccess
  } else {
    match r {
      NotConverged { reason: why, applied: _ } => std.process.exit_failure(reason: why)
      std.realization_reconcile.Converged { evidence: _, applied: _ } => std.process.ExitSuccess
    }
  }
}

data live_deploy_candidate_observed_at_launcher_note: String = "THE ONE OBSERVATION POINT OF THE INVOCATION, AND IT IS HERE BECAUSE HERE IS BEFORE EVERY MUTATION. The preflight has not run, no rsync has touched the host, no unit has been written; the deploying checkout is exactly the tree the job was handed. Observing later — inside the cutover, inside the emitter, inside a readiness retry — would read a tree the deploy itself may have altered, and would give the invocation two revisions that both look right locally.\n\nA REFUSAL HERE STOPS THE LINE BEFORE ANYTHING IS TOUCHED. A deploy that cannot name the release it is installing has nothing to write into ExecStart and nothing to verify the routed process against, so it exits with the typed cause rather than proceeding with a placeholder. This is the cheapest possible place to refuse: nothing has been mutated, so there is no half-applied state to reason about and no rollback to perform."

fn live_deploy_wet_with_access(access: gunbc.ci_deploy_access.DeployAccess) -> std.process.ProcessExit {
  match gunbc.live_deploy.candidate.observe_candidate_release() {
    CandidateUnobservable { cause: why } =>
      std.process.exit_failure(reason: gunbc.live_deploy.candidate.candidate_unobservable_detail(cause: why))
    CandidateObserved { candidate: candidate } => {
      let preflight = live_deploy_access_preflight_for(access: access)
      if !std.realization_reconcile.reconciliation_converged(r: preflight) {
        live_deploy_reconciliation_exit(r: preflight)
      } else {
        live_deploy_reconciliation_exit(
          r: live_deploy_apply_srv1_with_access(access: access, candidate: candidate)
        )
      }
    }
  }
}

fn live_deploy_retract_wet_with_access(access: gunbc.ci_deploy_access.DeployAccess) -> std.process.ProcessExit {
  let preflight = live_deploy_access_preflight_for(access: access)
  if !std.realization_reconcile.reconciliation_converged(r: preflight) {
    live_deploy_reconciliation_exit(r: preflight)
  } else {
    live_deploy_reconciliation_exit(
      r: live_deploy_retract_srv1_with_access(access: access)
    )
  }
}

func live_deploy_apply_srv1_wet() -> std.process.ProcessExit {
  live_deploy_wet_with_access(access: gunbc.ci_deploy_access.ci_deploy_srv1_access)
}

func live_deploy_apply_srv1_operator_wet() -> std.process.ProcessExit {
  live_deploy_wet_with_access(access: gunbc.ci_deploy_access.ci_deploy_srv1_operator_access)
}

func live_deploy_retract_srv1_wet() -> std.process.ProcessExit {
  live_deploy_retract_wet_with_access(access: gunbc.ci_deploy_access.ci_deploy_srv1_access)
}

func live_deploy_retract_srv1_operator_wet() -> std.process.ProcessExit {
  live_deploy_retract_wet_with_access(access: gunbc.ci_deploy_access.ci_deploy_srv1_operator_access)
}
