module gunbc.live_deploy.operations

import std.types { String, List, NonEmptyStr }
import extdeps.dpkg { dpkg_status_argv }
import extdeps.apt { apt_install_argv }
import extdeps.systemd.systemctl {
  systemctl_daemon_reload_argv,
  systemctl_enable_argv,
  systemctl_restart_argv,
  systemctl_disable_now_argv,
}
import gunbc.shell_command_text {
  shell_command_text_of_argv,
  shell_privileged_command_text_of_argv,
}

// Package-ensure and systemd unit-upsert argv spellings are derived from extdeps operation transport rows (dpkg.Package.Status, apt.PackageManager.Install, systemd.Systemctl daemon-reload/enable/restart/disable) — not hand-concatenated shell in emit.dag. Per shell-emission-model CUT: no minted EnsurePackage/UnitUpsert verb; emit composes inline If-Not-ExitZero(dpkg -s) then apt-install intent from these authorities. Privileged ops prefix sudo -n at the orchestration leaf (deploy access grant), never a root shell.
// The argv -> text step is gunbc.shell_command_text, a modeled bash command serialized by
// v2.workflow.bash_command_fold_serialize. It replaces a local `join(argv, " ")`, which put no
// quoting on any element: an argv element carrying a space, a quote or a metacharacter lost its
// boundary on the way to the host and re-parsed as several words. Element boundaries now survive
// structurally, and a shape the grammar cannot express refuses instead of emitting text.
fn dpkg_status_command(package: NonEmptyStr) -> String {
  shell_command_text_of_argv(argv: dpkg_status_argv(package: package))
}

fn apt_install_command(package: NonEmptyStr, privileged: Bool) -> String {
  if privileged {
    shell_privileged_command_text_of_argv(argv: apt_install_argv(package: package))
  } else {
    shell_command_text_of_argv(argv: apt_install_argv(package: package))
  }
}

fn systemctl_daemon_reload_command(privileged: Bool) -> String {
  if privileged {
    shell_privileged_command_text_of_argv(argv: systemctl_daemon_reload_argv())
  } else {
    shell_command_text_of_argv(argv: systemctl_daemon_reload_argv())
  }
}

fn systemctl_enable_command(unit: NonEmptyStr, privileged: Bool) -> String {
  if privileged {
    shell_privileged_command_text_of_argv(argv: systemctl_enable_argv(unit: unit))
  } else {
    shell_command_text_of_argv(argv: systemctl_enable_argv(unit: unit))
  }
}

fn systemctl_restart_command(unit: NonEmptyStr, privileged: Bool) -> String {
  if privileged {
    shell_privileged_command_text_of_argv(argv: systemctl_restart_argv(unit: unit))
  } else {
    shell_command_text_of_argv(argv: systemctl_restart_argv(unit: unit))
  }
}

fn systemctl_disable_now_command(unit: NonEmptyStr, privileged: Bool) -> String {
  if privileged {
    shell_privileged_command_text_of_argv(argv: systemctl_disable_now_argv(unit: unit))
  } else {
    shell_command_text_of_argv(argv: systemctl_disable_now_argv(unit: unit))
  }
}
