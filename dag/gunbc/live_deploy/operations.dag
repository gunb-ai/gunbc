module gunbc.live_deploy.operations

import std.types { String, List, NonEmptyStr, Bool }
import extdeps.dpkg { dpkg_status_argv }
import extdeps.apt { apt_install_argv }
import extdeps.os.systemctl {
  systemctl_daemon_reload_argv,
  systemctl_enable_argv,
  systemctl_restart_argv,
  systemctl_disable_now_argv,
}
import v2.std.orchestration {
  PipelineStep,
  Pipeline,
  Do,
  Run,
  If,
  Not,
  ExitZero,
  FailFast,
  DiscardAll,
}
import v2.std.collection { Absent, Present }

data live_deploy_operations_note: String = "Package-ensure and systemd unit-upsert pipeline leaves built from extdeps operation argv authorities (dpkg.Package.Status, apt.PackageManager.Install, systemd.Systemctl daemon-reload/enable/restart/disable) — not hand-concatenated shell spellings. Per shell-emission-model CUT: no minted EnsurePackage/UnitUpsert verb; package-ensure is inline If-Not-ExitZero(dpkg -s) then apt-install intent, and unit-upsert is the derived composition of write+install+daemon-reload+enable+restart at the artifact handler. Privileged ops prefix sudo -n at the orchestration leaf (deploy access grant), never a root shell."

fn argv_join(argv: List<String>) -> String {
  join(argv, " ")
}

fn privileged_command(argv: List<String>) -> String {
  concat("sudo -n ", argv_join(argv: argv))
}

fn deploy_run(command: String) -> PipelineStep {
  Do {
    run: Run {
      command: command,
      env: [],
      redirect: Absent,
      capture: Absent
    }
  }
}

fn deploy_run_discard_stderr(command: String) -> PipelineStep {
  Do {
    run: Run {
      command: command,
      env: [],
      redirect: Present { value: DiscardAll },
      capture: Absent
    }
  }
}

fn package_ensure_step(pkg: NonEmptyStr, privileged: Bool) -> PipelineStep {
  let dpkg_cmd = argv_join(argv: dpkg_status_argv(package: pkg))
  let install_cmd = if privileged {
    privileged_command(argv: apt_install_argv(package: pkg))
  } else {
    argv_join(argv: apt_install_argv(package: pkg))
  }
  If {
    cond: Not { inner: ExitZero {
      run: Run {
        command: dpkg_cmd,
        env: [],
        redirect: Present { value: DiscardAll },
        capture: Absent
      }
    } },
    then_: Pipeline {
      steps: [deploy_run(command: install_cmd)],
      on_failure: FailFast
    },
    else_: Absent
  }
}

fn systemd_unit_disable_step(unit: NonEmptyStr) -> PipelineStep {
  deploy_run_discard_stderr(
    command: concat(
      privileged_command(argv: systemctl_disable_now_argv(unit: unit)),
      " 2>/dev/null || true"
    )
  )
}

fn systemd_unit_daemon_reload_step() -> PipelineStep {
  deploy_run(command: privileged_command(argv: systemctl_daemon_reload_argv()))
}

fn systemd_unit_upsert_steps(unit: NonEmptyStr) -> List<PipelineStep> {
  [
    systemd_unit_daemon_reload_step(),
    deploy_run(command: privileged_command(argv: systemctl_enable_argv(unit: unit))),
    deploy_run(command: privileged_command(argv: systemctl_restart_argv(unit: unit))),
  ]
}
