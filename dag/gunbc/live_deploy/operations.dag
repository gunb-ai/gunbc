fn install_directory_owned_command(
  mode: FileMode,
  owner: NonEmptyStr,
  group: NonEmptyStr,
  path: String,
) -> String {
  shell_privileged_command_text_of_argv(
    argv: coreutils_install_directory_owned_argv(mode: mode, owner: owner, group: group, path: path),
  )
}
