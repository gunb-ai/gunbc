// THE SINGLE AUTHORITY for where the incoming pack lands (dir + serve member) is release_pair_delivery's
// release_pair_incoming_pack_dir / release_pair_incoming_serve_source; the entry derives them and passes them to the
// decode fns below, so the CLI never re-spells the incoming directory.

// The repo whose release-bins run carries the pair, the artifact's name and the job that publishes it are NOT spelled
// here — they are read from their single authorities so a rename cannot drift:
// gunbc.ci.repository_ci_profile::gunbc_repository_slug, gunbc.fleet.fleet_workflow_steps::ci_release_bins_artifact_name
// and gunbc.fleet.fleet_workflow_steps::fleet_converge_release_bins_job_id. The entry consumes them directly.

// THE BRANCH THE LAB TRACKS (gunbc.design_ruling::lab_tracks_main_lab_dev_retired_2026_11_22): main. Its head is
// observed, and the pair delivered is the NEWEST ANCESTOR of that head whose build job published a verified pack
// (not the exact head: main moves faster than a pack is built, so an exact-head lookup almost never finds one).
data release_pair_tracked_branch: NonEmptyStr = "main" as NonEmptyStr

// How far back from the head the delivery looks for a built ancestor: one page of GitHub's commit listing, the
// largest page its REST API serves (docs.github.com/rest/commits/commits#list-commits, per_page max 100). An
// ancestor further back than this is not delivered; the tick waits for a newer build instead.
data release_pair_ancestry_window: Int = 100
// Why the pair keeps serving when the fetch leg did not produce a pack (consumed by pack_fetch's PackAbsent).
data release_pair_fetch_refused_reason: NonEmptyStr = "the release-bins pack download for the bound head failed on the executing host"
// Why the pair keeps serving when the pack was fetched but its digest could not be observed (consumed by pack_fetch).
data release_pair_digest_unreadable_reason: NonEmptyStr = "the fetched release-bins manifest's line for the serve member does not carry a valid sha256"
// Why the pair keeps serving when the build-key verdict did not admit the fetched pack (consumed by pack_verify).
data release_pair_verdict_refused_reason: NonEmptyStr = "the lab consumer did not admit the fetched release-bins pack and named no refusal"
// Why the pair refuses when the fetched pack's manifest could not be read (absent or unreadable).
data release_pair_manifest_unreadable_reason: NonEmptyStr = "the fetched release-bins pack's manifest could not be read on the executing host"
// Why the pair refuses when the manifest does not name the serve member exactly once.
data release_pair_manifest_member_missing_reason: NonEmptyStr = "the fetched release-bins manifest does not name the serve member exactly once"
// Why the pair refuses when the lab consumer could not be started at all.
data release_pair_verdict_not_run_reason: NonEmptyStr = "the lab consumer program could not be started on the executing host"
// The prefix of a refusal the lab consumer NAMED; the name follows, read from its own ::error line.
data release_pair_verdict_named_prefix: String = "the lab consumer refused the fetched release-bins pack: "
// The gh api path that OBSERVES origin/main's head (the head TO DEPLOY), DERIVED from the one repo-slug row so the
// slug is written once (single_authority). Consumed by the staged fn's call to gh_main_head_command.
fn release_pair_main_head_api_path(slug: NonEmptyStr) -> String {
  join(["repos/", slug, "/commits/", release_pair_tracked_branch as String], "")
}

// The head's ancestry, newest first, one window long. Every SHA in it is reachable from the head.
fn release_pair_ancestry_api_path(slug: NonEmptyStr, head: NonEmptyStr) -> String {
  join(["repos/", slug, "/commits?sha=", head as String, "&per_page=", int_to_decimal_string(value: release_pair_ancestry_window)], "")
}

// The runs that published release-bins (only fleet-converge's build job uploads an artifact of that name). The
// command pages through every result, so per_page here only sets the page size, not a window.
fn release_pair_built_runs_api_path(slug: NonEmptyStr) -> String {
  join(["repos/", slug, "/actions/artifacts?name=", ci_release_bins_artifact_name, "&per_page=", int_to_decimal_string(value: release_pair_ancestry_window)], "")
}

// The jobs of one run, to read its build job's conclusion.
fn release_pair_run_jobs_api_path(slug: NonEmptyStr, run_id: NonEmptyStr) -> String {
  join(["repos/", slug, "/actions/runs/", run_id as String, "/jobs?per_page=100"], "")
}

// THE DEDICATED DELIVERY CLONE, separate from the runtime checkout at /opt/gunbc/gunbc. Every placement of a
// candidate source (and its worktree) is served from a fetch INTO THIS clone; the source head is then OBSERVED
// from that placed tree. Placing straight from the runtime checkout is exactly the wrong-subject defect item-2
// closes: /opt/gunbc/gunbc's own HEAD is not the delivered source and must never be what the source receipt names
// (#gunbc.design_argument::single_authority — the delivery clone is the sole placement origin).
fn release_pair_delivery_repo_dir(base_root: String) -> String {
  join([base_root, "/delivery-repo"], "")
}

// The ssh-agent-context attempt tag for the source-head observation leg (a diagnostic label for the placed-tree
// read over the fleet locus; the observation authority is observe_deployed_tree_at, not this label).
data release_pair_source_head_attempt_raw: String = "pair-deliver-source-head"

// Why the pair keeps serving when origin/main's head could not be observed (consumed by the entry's head leg).
data release_pair_no_head_reason: NonEmptyStr = "origin/main's head could not be observed on the executing host"
// Why the pair keeps serving when no ancestor of the head inside the window has a release-bins pack. A BENIGN wait:
// nothing new is built yet; keep last-good, retry next tick.
data release_pair_no_built_ancestor_reason: NonEmptyStr = "no ancestor of origin/main's head within the ancestry window has a release-bins pack to fetch"
// Why the pair keeps serving when it already serves the newest built ancestor (a benign no-op; no fetch runs).
data release_pair_at_newest_built_ancestor_reason: NonEmptyStr = "the pair already serves the newest built ancestor of origin/main's head — nothing to deliver this tick"
// Why the pair keeps serving when the newest built ancestor's build job did not conclude success: a pack uploaded by
// a job that later failed or was cancelled is never delivered. A wait, not a fallback to an older pack.
data release_pair_build_job_not_succeeded_reason: NonEmptyStr = "the newest built ancestor's build job did not conclude success; its pack is never delivered, waiting for a newer successful build"
// Why the pair refuses when the build job's conclusion could not be read (no such job, or the read failed).
data release_pair_build_job_unobservable_reason: NonEmptyStr = "the newest built ancestor's build job conclusion could not be observed; refusing to deliver an unverified pack"
// Why the pair refuses when the ancestry listing could not be read, or does not start at the observed head.
data release_pair_ancestry_unobserved_reason: NonEmptyStr = "the ancestry of origin/main's head could not be observed; refusing to choose a revision"
data release_pair_ancestry_not_at_head_reason: NonEmptyStr = "the ancestry listing does not start at the observed head; refusing to choose a revision from it"
// Why the pair keeps serving when the run DISCOVERY command itself could not run (auth expired, network, rate limit,
// wrong workflow name). NOT a CI wait — the delivery could not OBSERVE whether a pack exists, so it is a refusal the
// timer must surface (fail_closed), never a green tick that silently stops tracking main (review 96216).
data release_pair_run_discovery_refused_reason: NonEmptyStr = "the release-bins run discovery (gh api artifacts) could not be executed on the host (auth, network, rate limit, or workflow name); this is a delivery refusal, not a CI wait"
// Why the pair refuses when the discovery RAN but its stdout is NON-EMPTY yet unparseable (no tab separator / empty
// head field): the observation is untrustworthy (a gh output-shape or jq change), so this is a refusal, NOT the
// benign "no successful run" wait — otherwise delivery would silently stop tracking main forever (review 96219).
data release_pair_run_list_malformed_reason: NonEmptyStr = "the release-bins run discovery returned unparseable output (expected <run-id>TAB<head-sha>); refusing to guess a run"
// NOTE: the already-at-head benign-wait reason (review 96219) now lives in release_pair_delivery (with PlanWaits
// and release_pair_converged_noop, its reader) and is imported above — it is no longer spelled here.

// ── command argv: obtained through the admitted production builders, never re-spelled here (Route A) ────────────
// The head to deploy and the release-bins run for that head are discovered gh-only through extdeps.tools.gh's
// admitted builders (gh_main_head_command via `gh api .../commits/main --jq .sha`; gh_commit_ancestry_command,
// gh_branch_artifact_runs_command and gh_run_job_conclusion_command for the newest built ancestor), the fetch through
// gh_run_download_command, and the lab admission through extdeps.languages.bash.invocation::bash_program_command (the
// admission is a bash program, emitted from bash grammar Nodes by gunbc.fleet.fleet_release_bins_key). This module does NOT build argv itself: the sealed ArgvCommand is
// minted only at those admitted sites (git is not in the program census, so origin/main's head is observed via the
// cataloged gh program). The effectful entry composes those commands through the command seam and hands each leg's
// ProcessOutcome to the decode fns below.

// ── pure observation-decode fns (ProcessOutcome -> typed observation) ────────────────────────────────────────────
// The head the executing host OBSERVED on origin/main: Present only when a command that ran (exit 0) printed a
// non-empty head; none on an absent output or a refusal (a failed git rev-parse is NOT a head).
fn release_pair_decode_head(outcome: ProcessOutcome) -> NonEmptyStr? {
  match outcome {
    ProcessOutputPresent { text: t } =>
      if (trim(s: t) as String) == "" {
        none
      } else {
        Present { value: trim(s: t) as NonEmptyStr }
      }
    ProcessOutputAbsent => none
    ProcessRefused { exit_code: _, stderr: _ } => none
  }
}

// The release-bins run for the head: Present only when the discovery printed a run id; none on absent (no success run
// for the head — a typed refusal the entry turns into keep-last-good) or on a refusal (gh itself failed).
// The run-list observation, both sides read from the run metadata the gh call returned: the run id (to download
// its pack) and the run's head_sha — the BINARY side of the pair, decoded and checked, not assumed from the query
// filter. head_sha is the binary-side observation the fold compares against the observed source head; it is
// threaded into the fold when the source-side placement lands (node://lab-converges-release-pair, git-census Hold).
type ReleasePairRunObservation {
  run_id: NonEmptyStr
  head_sha: NonEmptyStr
}

// The run-list decode is a declared three-way sum, NOT an option collapsed onto none (review 96216): "a successful
// run exists for the head", "no successful run for the head yet (benign CI wait)" and "discovery itself refused"
// are three distinct outcomes that must not be conflated — only the middle one is a benign wait.
type ReleasePairRunLookup
  = RunLookupFound { run: ReleasePairRunObservation }
  | RunLookupNoBuiltAncestor
  | RunLookupDiscoveryRefused { reason: NonEmptyStr }

// One "<run-id>TAB<head-sha>" line. Fail-closed (gunbc.design_argument::fail_closed): any line that is not exactly
// two fields (no tab, or a third field from a changed gh/jq output shape), or an empty run or head field, is none —
// never a guessed run.
fn release_pair_parse_run_line(line: String) -> ReleasePairRunObservation? {
  let parts = split(s: trim(s: line), delimiter: "\t")
  if length(xs: parts) != 2 { none } else {
    // first/last return String? — match Present/Absent first, then compare and cast the UNWRAPPED Strings.
    match first(l: parts) {
      Absent => none
      Present { value: run_field } =>
        match last(l: parts) {
          Absent => none
          Present { value: head_field } =>
            if (run_field as String) == "" || (head_field as String) == "" || (head_field as String) == (run_field as String) {
              none
            } else {
              Present { value: ReleasePairRunObservation { run_id: run_field as NonEmptyStr, head_sha: head_field as NonEmptyStr } }
            }
        }
    }
  }
}

// The head's ancestry as observed: the listed SHAs newest first, or a refusal. An empty listing is a refusal, never
// "no ancestors": the head itself must be listed.
type ReleasePairAncestry
  = AncestryObserved { shas: List<String> }
  | AncestryRefused { reason: NonEmptyStr }

fn release_pair_decode_ancestry(outcome: ProcessOutcome) -> ReleasePairAncestry {
  match outcome {
    ProcessOutputPresent { text: t } =>
      let shas = filter(map(split(s: trim(s: t), delimiter: "\n"), l => trim(s: l) as String), l => l != "")
      if length(xs: shas) == 0 {
        AncestryRefused { reason: release_pair_ancestry_unobserved_reason }
      } else {
        AncestryObserved { shas: shas }
      }
    ProcessOutputAbsent => AncestryRefused { reason: release_pair_ancestry_unobserved_reason }
    ProcessRefused { exit_code: _, stderr: _ } => AncestryRefused { reason: release_pair_ancestry_unobserved_reason }
  }
}

// The runs on the tracked branch that published a release-bins pack, as observed. No output is an observed empty
// set (nothing built); any malformed line refuses the whole observation rather than dropping it.
type ReleasePairBuiltRuns
  = BuiltRunsObserved { runs: List<ReleasePairRunObservation> }
  | BuiltRunsRefused { reason: NonEmptyStr }

fn release_pair_decode_built_runs(outcome: ProcessOutcome) -> ReleasePairBuiltRuns {
  match outcome {
    ProcessOutputPresent { text: t } =>
      let lines = filter(split(s: trim(s: t), delimiter: "\n"), l => (trim(s: l) as String) != "")
      let parsed = map(lines, l => release_pair_parse_run_line(line: l))
      if any(parsed, p => match p { Absent => true  Present { value: _ } => false }) {
        BuiltRunsRefused { reason: release_pair_run_list_malformed_reason }
      } else {
        BuiltRunsObserved { runs: flat_map(parsed, p => match p { Present { value: r } => [r]  Absent => [] }) }
      }
    ProcessOutputAbsent => BuiltRunsObserved { runs: [] }
    ProcessRefused { exit_code: _, stderr: _ } => BuiltRunsRefused { reason: release_pair_run_discovery_refused_reason }
  }
}

// THE SELECTION: the first SHA of the head's ancestry (newest first) that some observed run published a pack for.
// It can never name a non-ancestor, because it only ever returns a SHA taken from the ancestry listing, and the
// listing must start at the observed head. Pure, so the red controls run without a network.
fn release_pair_select_built_ancestor(head: NonEmptyStr, ancestry: ReleasePairAncestry, built: ReleasePairBuiltRuns) -> ReleasePairRunLookup {
  match ancestry {
    AncestryRefused { reason } => RunLookupDiscoveryRefused { reason: reason }
    AncestryObserved { shas } =>
      match built {
        BuiltRunsRefused { reason } => RunLookupDiscoveryRefused { reason: reason }
        BuiltRunsObserved { runs } =>
          match first(l: shas) {
            Absent => RunLookupDiscoveryRefused { reason: release_pair_ancestry_unobserved_reason }
            Present { value: tip } =>
              if (tip as String) != (head as String) {
                RunLookupDiscoveryRefused { reason: release_pair_ancestry_not_at_head_reason }
              } else {
                match first_where(xs: shas, keep: sha => any(runs, r => (r.head_sha as String) == sha)) {
                  Absent => RunLookupNoBuiltAncestor
                  Present { value: chosen } =>
                    match first_where(xs: runs, keep: r => (r.head_sha as String) == chosen) {
                      Absent => RunLookupNoBuiltAncestor
                      Present { value: run } => RunLookupFound { run: run }
                    }
                }
              }
          }
      }
  }
}

// THE BUILD JOB'S CONCLUSION for the chosen run. Only the literal conclusion "success" admits; any other printed
// conclusion (failure, cancelled, skipped, timed_out ...) is NotSucceeded, and no output or a failed read is
// Unobservable. The pack is still build-key verified after this; this check is what keeps a half-built pack from
// a failed or cancelled job out, which an artifact merely existing cannot.
type ReleasePairBuildJob
  = BuildJobSucceeded
  | BuildJobNotSucceeded
  | BuildJobUnobservable

fn release_pair_decode_build_job(outcome: ProcessOutcome) -> ReleasePairBuildJob {
  match outcome {
    ProcessOutputPresent { text: t } =>
      let c = trim(s: t) as String
      if c == "success" {
        BuildJobSucceeded
      } else if c == "" {
        BuildJobUnobservable
      } else {
        BuildJobNotSucceeded
      }
    ProcessOutputAbsent => BuildJobUnobservable
    ProcessRefused { exit_code: _, stderr: _ } => BuildJobUnobservable
  }
}


// THE SERVE MEMBER'S DIGEST AS THE PACK DECLARES IT. The manifest IS `sha256sum` output ("<hex>  <name>" per member,
// written by the producer's pack statements), so the one line naming exactly the serve member is read with the
// same parser the belt's member_observe uses (extdeps.crypto.hash::sha256sum_line_digest), admitted only as a valid
// lower_hex_64. The lab consumer later proves the PROMOTED bytes match this manifest under --strict, so the digest
// bound here is the digest of the file installed. A manifest that names the member zero or several times, or with a
// non-hex digest, is a named refusal, never a false PackPresent.
fn release_pair_manifest_line_names(line: String, member: String) -> Bool {
  let parts = split(s: trim(s: line), delimiter: "  ")
  if length(xs: parts) != 2 { false } else {
    match last(l: parts) {
      Present { value: name } => (name as String) == member
      Absent => false
    }
  }
}

fn release_pair_manifest_member_line(manifest: String, member: String) -> String? {
  let hits = filter(xs: split(s: manifest, delimiter: "\n"), predicate: l => release_pair_manifest_line_names(line: l, member: member))
  if length(xs: hits) != 1 { none } else { first(l: hits) }
}

fn release_pair_pack_digest_bound(manifest_read: FilesystemReadOutcome, pack_dir: String, member_src: String) -> PackFetch {
  match manifest_read {
    FilesystemReadRefused { error: _ } => PackAbsent { reason: release_pair_manifest_unreadable_reason }
    FilesystemReadSucceeded { content: m } =>
      match release_pair_manifest_member_line(manifest: m, member: gunbc_release_bin_name) {
        Absent => PackAbsent { reason: release_pair_manifest_member_missing_reason }
        Present { value: line } =>
          match sha256sum_line_digest(line: line) {
            Present { value: dg } => PackPresent {
              sha256: dg.hex,
              pack_dir: pack_dir as NonEmptyStr,
              binary_source: member_src as NonEmptyStr,
            }
            none => PackAbsent { reason: release_pair_digest_unreadable_reason }
          }
      }
  }
}

// THE CAPTURE GRAIN UNWRAPPED AT THE EDGE (PR #16847 retype): run_shell_command_capture now answers with
// ProcessCaptureOutcome, whose ProcessCaptureNotSpawned arm says NO CHILD EVER RAN. Each wrapper folds that
// fact onto the refusal shape the inner decode already names -- a not-spawned child never reaches a decode as
// an observation, and no exit code is fabricated for it.
fn release_pair_decode_head_capture(outcome: ProcessCaptureOutcome) -> NonEmptyStr? {
  match outcome {
    ProcessCaptured { outcome: captured } => release_pair_decode_head(outcome: captured)
    ProcessCaptureNotSpawned { program: _, cause: _ } => none
  }
}

fn release_pair_decode_ancestry_capture(outcome: ProcessCaptureOutcome) -> ReleasePairAncestry {
  match outcome {
    ProcessCaptured { outcome: captured } => release_pair_decode_ancestry(outcome: captured)
    ProcessCaptureNotSpawned { program: _, cause: _ } => AncestryRefused { reason: release_pair_ancestry_unobserved_reason }
  }
}

fn release_pair_decode_built_runs_capture(outcome: ProcessCaptureOutcome) -> ReleasePairBuiltRuns {
  match outcome {
    ProcessCaptured { outcome: captured } => release_pair_decode_built_runs(outcome: captured)
    ProcessCaptureNotSpawned { program: _, cause: _ } => BuiltRunsRefused { reason: release_pair_run_discovery_refused_reason }
  }
}

fn release_pair_decode_build_job_capture(outcome: ProcessCaptureOutcome) -> ReleasePairBuildJob {
  match outcome {
    ProcessCaptured { outcome: captured } => release_pair_decode_build_job(outcome: captured)
    ProcessCaptureNotSpawned { program: _, cause: _ } => BuildJobUnobservable
  }
}

fn release_pair_pack_fetch_capture(
  fetch: ProcessCaptureOutcome,
  manifest_read: FilesystemReadOutcome,
  pack_dir: String,
  member_src: String,
) -> PackFetch {
  match fetch {
    ProcessCaptured { outcome: captured } => release_pair_pack_fetch(fetch_outcome: captured, manifest_read: manifest_read, pack_dir: pack_dir, member_src: member_src)
    ProcessCaptureNotSpawned { program: _, cause: _ } => PackAbsent { reason: release_pair_fetch_refused_reason }
  }
}


// THE FETCH OBSERVATION: a pack the executing host OBSERVED. Present only when the download ran (exit 0 — `gh run
// download` is silent on success — or present stdout) AND its manifest declares a valid digest for the serve member;
// a refused download is a named PackAbsent, never a falsely-bound PackPresent. member_src is where the lab consumer
// promotes the verified member (release_pair_incoming_serve_source); nothing is read from the archive in place.
fn release_pair_pack_fetch(
  fetch_outcome: ProcessOutcome,
  manifest_read: FilesystemReadOutcome,
  pack_dir: String,
  member_src: String,
) -> PackFetch {
  match fetch_outcome {
    ProcessRefused { exit_code: _, stderr: _ } => PackAbsent { reason: release_pair_fetch_refused_reason }
    ProcessOutputAbsent => release_pair_pack_digest_bound(manifest_read: manifest_read, pack_dir: pack_dir, member_src: member_src)
    ProcessOutputPresent { text: _ } => release_pair_pack_digest_bound(manifest_read: manifest_read, pack_dir: pack_dir, member_src: member_src)
  }
}

// THE LAB ADMISSION VERDICT OBSERVED on that fetched pack: VerifiedOn(pack_dir, source_dir) only when the lab consumer
// ran and exited 0; otherwise Refused, naming the refusal the consumer itself printed (its `::error title=release-bins
// <Name>::` line, gunbc.fleet.fleet_release_bins_key refuse), so a tampered member, a pack keyed on another tree and
// a pack missing a member refuse with three different reasons. The pack_dir and source_dir named here are the values
// the entry ran the consumer on; release_pair_install_plan refuses unless they are the pack the fetch observed and
// the source dir of the observed source head.
// THE LAB CONSUMER IS A MULTI-STATEMENT BASH PROGRAM, not a single argv (review 96241 finding 2): file guards, a
// kind and source-closure check, listing/manifest/member checks and the promotion, with control flow and shell
// variables, so it cannot collapse to one sealed ArgvCommand. It is emitted from bash grammar Nodes through
// v2.workflow.bash_emit and runs under bash (not sh: the emitter's grammar is Bash), kept as a declared row (below).
// Admitted as declared scaffolding by operator ruling #gunbc.design_ruling::pair_delivery_shell_as_medium_steps_admitted (RULED 2026-11-18).
data release_pair_verify_shell_scaffold: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.live_deploy.release_pair_delivery",
    decl_name: "release_pair_verify_dispatch",
    field: WholeDeclaration
  }
}

data release_pair_verify_shell_dissolution_trigger: DissolutionCondition = unbound_dissolution(description: "dissolve-on: release_pair_verify_dispatch ships the lab consumer as a rendered bash program String (emitted from bash grammar Nodes by gunbc.fleet.fleet_release_bins_key release_bins_lab_consumer_statements); the CLI runs it via bash_program_command. DISSOLVES WHEN the dispatch yields a typed program (a sealed TransportScript or a typed host-effect realization) rather than a script String, so no medium-as-string program remains in the pair-delivery verify path.")

// The refusal the lab consumer NAMED on stdout, if any: the text between "title=release-bins " and the next "::".
fn release_pair_lab_refusal_name(stdout: String) -> String? {
  let after = split(s: stdout, delimiter: "title=release-bins ")
  if length(xs: after) < 2 { none } else {
    match first(l: skip(xs: after, n: 1)) {
      Absent => none
      Present { value: rest } =>
        match first(l: split(s: rest, delimiter: "::")) {
          Absent => none
          Present { value: name } => if (name as String) == "" { none } else { Present { value: name } }
        }
    }
  }
}

fn release_pair_pack_verify(verify_run: ProcessRunOutcome, pack_dir: String, source_dir: String) -> PackVerify {
  match verify_run {
    ProcessNotSpawned { program: _, cause: _ } => Refused { reason: release_pair_verdict_not_run_reason }
    ProcessRan { observation: o } =>
      if o.exit_code == 0 {
        VerifiedOn { pack_dir: pack_dir as NonEmptyStr, source_dir: source_dir as NonEmptyStr }
      } else {
        match release_pair_lab_refusal_name(stdout: o.stdout) {
          Present { value: name } => Refused { reason: concat(release_pair_verdict_named_prefix, name) as NonEmptyStr }
          Absent => Refused { reason: release_pair_verdict_refused_reason }
        }
      }
  }
}

// STAGE 2 ON THE PLACED SOURCE, THEN STAGE 3. The lab consumer admits the fetched pack against the source tree just
// placed (or reused) for the observed source head, so the pack's source closure is checked against the very tree
// installed beside it, and only then is the install planned. Both placement arms reach the install through here.
fn release_pair_admit_and_plan(base_root: String, serving: ReleaseRevisionBinding, target: CommitSha, source_head: CommitSha, fetch: PackFetch, pack_dir: String, serve_unit: NonEmptyStr) -> DeliveryPlan {
  let source_dir = release_pair_source_dir(base_root: base_root, revision: source_head)
  let verify = match release_pair_verify_dispatch(fetch: fetch, source_dir: source_dir) {
    Present { value: script } =>
      release_pair_pack_verify(
        verify_run: run_shell_command_observe_outcome(command: bash_program_command(script: script), transport: LocalExec),
        pack_dir: pack_dir,
        source_dir: source_dir,
      )
    none => Refused { reason: release_pair_verdict_refused_reason }
  }
  release_pair_install_plan(
    base_root: base_root,
    serving: serving,
    main_head: target,
    source_head: source_head,
    fetch: fetch,
    verify: verify,
    serve_unit: serve_unit,
  )
}

// ── the effectful entry: THE executing consumer of the dry plan ──────────────────────────────────────────────────
// The consumer the fold's plan was written for. It OBSERVES every stage through the admitted command seam and hands
// each OBSERVED ProcessOutcome to the decode fns above — no stage is handed its predecessor's result as an input it
// did not observe. It (1) observes origin/main's head (what to DEPLOY) via the cataloged gh program, (2) discovers the
// fleet-converge run for THAT head, (3) downloads its release-bins pack and reads the serve member's digest from the
// pack's own manifest, (4) places the target's source tree, (5) runs the lab consumer ON the fetched pack against
// that placed tree (kind, source closure, listing, every member digest; then it promotes the verified members), and
// only then asks release_pair_install_plan for the ordered install (which folds the pair and either places+restarts
// or keeps the last good). The two discovery legs
// that yield nothing are typed outcomes — a benign PlanWaits ONLY when there is genuinely nothing to deliver yet:
// no built ancestor of the head (RunLookupNoBuiltAncestor, review 96214) or the pair is already at head (review 96219),
// never a guess. A fetch/digest failure AFTER a run was found is a REFUSAL (PlanKeepsLastGood, red), not a wait
// (review 96234: gh auth expired / disk full must not keep the timer green). Whether a tick
// exits green (a wait) or red (a refusal) follows from the DeliveryPlan VARIANT (PlanWaits vs PlanKeepsLastGood),
// never from comparing the reason text: the old string classifier is gone (review 96225). Executed by the
// pair-delivery unit's own run (roadmap item lab-converges-release-pair, PR3b); its decision halves are witnessed by
// release_pair_deliver_cli_witness and the plan arms by release_pair_delivery_plan_witness.

fn release_pair_deliver_run(base_root: String, serving: ReleaseRevisionBinding, serve_unit: NonEmptyStr, host_identity: NonEmptyStr) -> DeliveryPlan {
  let head_outcome = run_shell_command_capture(
    command: gh_main_head_command(api_path: release_pair_main_head_api_path(slug: gunbc_repository_slug)),
    transport: LocalExec,
  )
  match release_pair_decode_head_capture(outcome: head_outcome) {
    none => PlanKeepsLastGood { kept: serving, reason: release_pair_no_head_reason }
    Present { value: main_head } =>
      // STEADY-STATE SHORT-CIRCUIT BEFORE THE FETCH (review 96219 / 96225): the pure release_pair_converged_noop
      // route decides, from the OBSERVED serving binding and the OBSERVED head, whether this tick is a benign no-op.
      // If the serving pair already equals the head, it returns PlanWaits and NO fetch runs (no re-download of the
      // same pack, no re-link of the same revision — the create-only link would fail red on a healthy pair). Absent
      // means the head is new (or the tree is not installed), so the entry proceeds to discovery and the fetch. The
      // fold still checks source/binary drift on the ticks that DO fetch, so short-circuiting a healthy pair cannot
      // mask a real mismatch.
      match release_pair_converged_noop(serving: serving, head: main_head, reason: release_pair_already_at_head_reason) {
        Present { value: noop } => noop
        none => {
      let ancestry_outcome = run_shell_command_capture(
        command: gh_commit_ancestry_command(api_path: release_pair_ancestry_api_path(slug: gunbc_repository_slug, head: main_head)),
        transport: LocalExec,
      )
      let built_outcome = run_shell_command_capture(
        command: gh_branch_artifact_runs_command(
          api_path: release_pair_built_runs_api_path(slug: gunbc_repository_slug),
          branch: release_pair_tracked_branch as String,
        ),
        transport: LocalExec,
      )
      match release_pair_select_built_ancestor(
        head: main_head,
        ancestry: release_pair_decode_ancestry_capture(outcome: ancestry_outcome),
        built: release_pair_decode_built_runs_capture(outcome: built_outcome),
      ) {
        RunLookupDiscoveryRefused { reason } => PlanKeepsLastGood { kept: serving, reason: reason }
        // Nothing built inside the window yet is a BENIGN WAIT (review 96214), not a refusal: keep serving, retry.
        RunLookupNoBuiltAncestor => PlanWaits { kept: serving, reason: release_pair_no_built_ancestor_reason }
        RunLookupFound { run } =>
          match release_pair_converged_noop(serving: serving, head: run.head_sha, reason: release_pair_at_newest_built_ancestor_reason) {
            Present { value: noop } => noop
            none => {
          match release_pair_decode_build_job_capture(
            outcome: run_shell_command_capture(
              command: gh_run_job_conclusion_command(
                api_path: release_pair_run_jobs_api_path(slug: gunbc_repository_slug, run_id: run.run_id),
                job: fleet_converge_release_bins_job_id as String,
              ),
              transport: LocalExec,
            ),
          ) {
            BuildJobUnobservable => PlanKeepsLastGood { kept: serving, reason: release_pair_build_job_unobservable_reason }
            BuildJobNotSucceeded => PlanWaits { kept: serving, reason: release_pair_build_job_not_succeeded_reason }
            BuildJobSucceeded => {
          // THE DELIVERY TARGET is the chosen ancestor, not the head: every leg below places and verifies it.
          let target = run.head_sha
          let pack_dir = release_pair_incoming_pack_dir(base_root: base_root, revision: target as String)
          let member_src = release_pair_incoming_serve_source(base_root: base_root, revision: target as String)
          let fetch_outcome = run_shell_command_capture(
            command: gh_run_download_command(
              run_id: run.run_id as String,
              repo: gunbc_repository_slug as String,
              artifact: ci_release_bins_artifact_name,
              dir: pack_dir,
            ),
            transport: LocalExec,
          )
          let manifest = Filesystem.Read(path: join([pack_dir, "/", release_bins_manifest_name], ""))
          let fetch = release_pair_pack_fetch_capture(
            fetch: fetch_outcome,
            manifest_read: filesystem_read_outcome(content: manifest.content, success: manifest.success, error: manifest.error),
            pack_dir: pack_dir,
            member_src: member_src,
          )
          // The lab admission (stage 2) runs once the source tree for the target is placed, so it can check the pack's
          // source closure against that tree: see release_pair_admit_and_plan, reached from both placement arms below.
          // SOURCE-SIDE F1 (item-2) + idempotent placement (review 96353): the delivered source head is the head
          // OBSERVED from a tree placed from the DEDICATED DELIVERY CLONE (<base_root>/delivery-repo), NEVER the gh head
          // query and NEVER /opt/gunbc/gunbc. First probe that the clone is seeded (seeding is a deploy step under the
          // operator gate -- never bootstrapped here), then OBSERVE the target locus /source BEFORE adding: already at the
          // requested head => REUSE (no fetch, no add -- a re-run after a later-leg failure is idempotent); a tree at some
          // OTHER head => REFUSE (never remove or overwrite it silently); absent => fetch + worktree-add, then OBSERVE the
          // placed tree. 'unobservable' is reserved for the observe step; every placement condition carries its own reason.
          let delivery_repo = release_pair_delivery_repo_dir(base_root: base_root)
          let source_dir = release_pair_source_dir(base_root: base_root, revision: target as CommitSha)
          // Is the dedicated delivery clone seeded? git itself answers; only a ProcessOutputPresent (a printed head) counts,
          // never a wildcard (review 96360). Any other ProcessOutcome is "not seeded / not readable" -> PlacementCloneMissing.
          let clone_present = release_pair_delivery_clone_present(
            outcome: run_shell_command_observe_outcome(
              command: git_rev_parse_head_command(repository_dir: delivery_repo),
              transport: LocalExec,
            ),
          )
          match prepare_fleet_ssh_agent_context(attempt_raw: release_pair_source_head_attempt_raw) {
            // Context prep is part of observing, so its failure carries the observe step's 'unobservable' reason.
            FleetSshContextRefused { cause: _ } =>
              PlanKeepsLastGood { kept: serving, reason: release_pair_source_head_unobservable_reason }
            FleetSshContextReady { context: context, receipt: _ } =>
              match release_pair_source_placement_decision(
                clone_present: clone_present,
                clone_path: delivery_repo,
                pre_observed: observe_deployed_tree_at(
                  context: context,
                  target: fleet_locus_ssh_target(host: host_identity as HostIdentity),
                  repo: source_dir as NonEmptyStr,
                ),
                requested: target as CommitSha,
              ) {
                // The delivery clone is absent. Seeding it is a deploy step under the operator gate -- NEVER bootstrap it
                // here. Its own typed refusal, distinct from 'unobservable' (review 96353).
                PlacementCloneMissing { reason: why } =>
                  PlanKeepsLastGood { kept: serving, reason: why }
                // Already placed at the requested head: REUSE it -- no fetch, no add. A re-run after any later-leg failure
                // lands here again, so placement is idempotent and never a clobber.
                PlacementReuse { revision: source_head } =>
                  release_pair_admit_and_plan(
                    base_root: base_root,
                    serving: serving,
                    target: target as CommitSha,
                    source_head: source_head,
                    fetch: fetch,
                    pack_dir: pack_dir,
                    serve_unit: serve_unit,
                  )
                // A placed tree on a DIFFERENT head: REFUSE. Never remove or overwrite it silently (review 96353).
                PlacementPresentAtOtherHead { reason: why } =>
                  PlanKeepsLastGood { kept: serving, reason: why }
                // Absent: fetch the head into the clone and hang a detached worktree at the locus /source. The placement
                // legs are best-effort; the OBSERVE step is the sole authority that the tree is there and on the requested
                // head -- a failed fetch/add leaves it unreadable and release_pair_source_head_verdict refuses 'unobservable'.
                PlacementAdd => {
                  // Fetch the head into the clone; a REFUSED fetch refuses with its OWN reason (never a misleading
                  // 'unobservable' / 'other head' from the later observe). Exit-0 (stdout present or absent) is progress.
                  match release_pair_source_fetch_verdict(
                    outcome: run_shell_command_observe_outcome(
                      command: git_fetch_shallow_revision_command(
                        repository_dir: delivery_repo,
                        remote: "origin",
                        revision: target as String,
                      ),
                      transport: LocalExec,
                    ),
                    rev: target as String,
                  ) {
                    ActionRefused { reason: why } =>
                      PlanKeepsLastGood { kept: serving, reason: why }
                    ActionPlaced =>
                      // Hang the detached worktree; a REFUSED add refuses with its OWN reason (review 96360).
                      match release_pair_source_add_verdict(
                        outcome: run_shell_command_observe_outcome(
                          command: git_worktree_add_detached_command(
                            repository_dir: delivery_repo,
                            path: source_dir,
                            revision: target as String,
                          ),
                          transport: LocalExec,
                        ),
                      ) {
                        ActionRefused { reason: why } =>
                          PlanKeepsLastGood { kept: serving, reason: why }
                        // Both actions placed -- NOW the observe step is the sole authority on the placed tree.
                        ActionPlaced =>
                          match release_pair_source_head_verdict(
                            observed: observe_deployed_tree_at(
                              context: context,
                              target: fleet_locus_ssh_target(host: host_identity as HostIdentity),
                              repo: source_dir as NonEmptyStr,
                            ),
                            requested: target as CommitSha,
                          ) {
                            SourceHeadRefused { reason: reason } =>
                              PlanKeepsLastGood { kept: serving, reason: reason }
                            SourceHeadObserved { revision: source_head } =>
                              release_pair_admit_and_plan(
                                base_root: base_root,
                                serving: serving,
                                target: target as CommitSha,
                                source_head: source_head,
                                fetch: fetch,
                                pack_dir: pack_dir,
                                serve_unit: serve_unit,
                              )
                          }
                      }
                  }
                }
              }
          }
            }
          }
            }
          }
      }
      }
      }
  }
}

// The typed result of mapping the serve gate's OBSERVED deployed binding onto the fold's keep-last-good binding.
// A bound tree maps to a usable binding; the mixed / surface-mixed / unobserved states are REFUSALS in their own
// right, NOT RevisionNotInstalled. Collapsing them to RevisionNotInstalled made the fold read a poison state as
// "proceed to a fresh fetch" (RevisionNotInstalled never short-circuits), which contradicts fail_closed: a state you
// cannot trust must refuse, not fetch. The refusal is carried in the sum and handled by the entry (review 96348 —
// the refusal IS the mapping's job, not a separate predicate bolted on after it).
type ServingMapping
  = ServingMapped { binding: ReleaseRevisionBinding }
  | ServingRefused { reason: NonEmptyStr }

// The refusal reason a poison (mixed / surface-mixed / unobserved) deployed state maps to. The exit code follows
// the variant, never this text (re-wording it cannot flip green<->red).
data release_pair_serving_poison_reason: NonEmptyStr = "the deployed pair is in an untrustworthy (mixed / surface-mixed / unobserved) state; never deliver a pair from it"

// Maps the OBSERVED deployed binding (from the serve gate) onto the fold's keep-last-good binding. What keep-last-
// good protects is the revision the deployed TREE is on, so the usable arm is read from the bound arm's GitObjectId
// via the single GitObjectId->hex authority (extdeps.git.object_store). The mixed / surface-mixed / unobserved arms
// are the REFUSED arm (gunbc.design_argument::fail_closed): the caller surfaces them as red and never reaches the
// fold with a poison state. There is no separate poison predicate — refusing them is exactly this mapping (96348).
fn release_pair_deliver_serving(binding: DeployedReleaseBinding) -> ServingMapping {
  match binding {
    ReleaseBoundToTree { revision: r, surface: _ } =>
      ServingMapped { binding: RevisionBoundAtEmission { revision: git_object_id_wire_hex(oid: r) as CommitSha } }
    ReleaseMixed { tree_revision: _, process_revision: _ } =>
      ServingRefused { reason: release_pair_serving_poison_reason }
    ReleaseSurfaceMixed { revision: _, expected_surface: _, process_surface: _ } =>
      ServingRefused { reason: release_pair_serving_poison_reason }
    ReleaseBindingUnobserved { cause: _ } =>
      ServingRefused { reason: release_pair_serving_poison_reason }
  }
}

// REVIEW 96121 (SOURCE-SIDE F1). The delivered pair's SOURCE half is the head OBSERVED from a PLACED source tree,
// never the value of the gh origin/main head query. The placement leg adds the tree detached from the delivery clone
// at the requested revision; the source head we deliver is that tree's OWN observed HEAD (a GitObjectId read by the
// canonical observer, rendered through the single extdeps.git.object_store hex authority), and it must EQUAL the
// revision we asked to place. A placed tree whose observed HEAD differs from the requested revision is a REFUSAL
// (red) -- we never install a pair whose source we could not confirm; and a tree whose HEAD cannot be observed is
// likewise a refusal, because with no observation there is no bound source to deliver (fail_closed). The exit code
// follows the variant, not the reason text.
type SourceHeadVerdict
  = SourceHeadObserved { revision: CommitSha }
  | SourceHeadRefused { reason: NonEmptyStr }

data release_pair_source_head_mismatch_reason: NonEmptyStr = "the placed source tree's observed HEAD does not equal the requested revision; refusing to deliver a pair on an unverified source"
data release_pair_source_head_unobservable_reason: NonEmptyStr = "the placed source tree's HEAD could not be observed; refusing to deliver a pair on an unobserved source"

fn release_pair_source_head_verdict(observed: DeployedTreeObservation, requested: CommitSha) -> SourceHeadVerdict {
  match observed {
    DeployedTreeObserved { revision: oid, tree: _, content: _ } =>
      let observed_hex = git_object_id_wire_hex(oid: oid)
      if observed_hex == (requested as String) {
        SourceHeadObserved { revision: requested }
      } else {
        SourceHeadRefused { reason: release_pair_source_head_mismatch_reason }
      }
    DeployedTreeUnobservable { cause: _ } =>
      SourceHeadRefused { reason: release_pair_source_head_unobservable_reason }
  }
}

// Idempotent placement decision (review 96353). Before the actuator adds anything it OBSERVES the target source tree
// at release_pair_source_dir(target), so a re-run after a later-leg failure REUSES an already-correct placement
// rather than refusing, and a tree sitting on a DIFFERENT head is REFUSED (never silently clobbered or removed). Each
// distinct condition is a distinct variant with a distinct reason: an unseeded delivery clone (seeding is a deploy step
// under the operator gate -- never bootstrapped here), a placed tree already at the requested head (reuse, no add), a
// placed tree at some OTHER head (refuse), or an absent tree (add). 'unobservable' is reserved for the OBSERVE step
// alone (release_pair_source_head_verdict) and is never reused as a placement condition.
// #gunbc.design_argument::single_authority
type PlacementDecision
  = PlacementCloneMissing { reason: NonEmptyStr }
  | PlacementReuse { revision: CommitSha }
  | PlacementPresentAtOtherHead { reason: NonEmptyStr }
  | PlacementAdd

// Reason prefixes: the condition is the variant; the interpolated path/head is operator detail. A witness reconstructs
// the exact expected string from the same inputs, so no string predicate is needed to assert them.
data release_pair_delivery_clone_missing_prefix: NonEmptyStr = "delivery clone not seeded / not readable at "
data release_pair_source_placed_at_other_head_prefix: NonEmptyStr = "placed source tree is at "

fn release_pair_source_placement_decision(
  clone_present: Bool,
  clone_path: String,
  pre_observed: DeployedTreeObservation,
  requested: CommitSha,
) -> PlacementDecision {
  if !clone_present {
    PlacementCloneMissing {
      reason: join([release_pair_delivery_clone_missing_prefix as String, clone_path], "") as NonEmptyStr,
    }
  } else {
    match pre_observed {
      DeployedTreeObserved { revision: oid, tree: _, content: _ } =>
        let observed_hex = git_object_id_wire_hex(oid: oid)
        if observed_hex == (requested as String) {
          PlacementReuse { revision: requested }
        } else {
          PlacementPresentAtOtherHead {
            reason: join([release_pair_source_placed_at_other_head_prefix as String, observed_hex, ", not ", requested as String], "") as NonEmptyStr,
          }
        }
      DeployedTreeUnobservable { cause: _ } => PlacementAdd
    }
  }
}

// (1) The delivery clone counts as present ONLY when the seed-probe actually printed a head (ProcessOutputPresent).
// There is NO wildcard success: ProcessOutputAbsent (exit 0 but no stdout) and ProcessRefused (nonzero exit) are BOTH
// "not seeded / not readable" and route to PlacementCloneMissing (review 96360). ProcessOutcome's variants, from source
// (gunbc.command_runner): ProcessOutputPresent { text: String } | ProcessOutputAbsent | ProcessRefused { exit_code: Int, stderr: String }.
fn release_pair_delivery_clone_present(outcome: ProcessRunOutcome) -> Bool {
  match outcome {
    ProcessRan { observation: observation } =>
      match classify_process_observation(policy: ExitZeroSucceeds, observation: observation) {
        ProcessOutputPresent { text: _ } => true
        ProcessOutputAbsent => false
        ProcessRefused { exit_code: _, stderr: _ } => false
      }
    ProcessNotSpawned { program: _, cause: _ } => false
  }
}

// (2) A placement ACTION (the clone-side fetch, or the worktree-add) either PLACED (the command ran to exit 0 -- stdout
// present OR absent, since git fetch/worktree write their progress to stderr) or was REFUSED, and a refusal carries its
// OWN typed reason -- it must not collapse later into the observe step's 'unobservable' or a 'tree at another head'
// (review 96360). Kept pure so the refusal reasons are witnessed; the observe step stays the authority on the tree only
// once both actions have placed.
type PlacementActionVerdict
  = ActionPlaced
  | ActionRefused { reason: NonEmptyStr }

fn release_pair_source_fetch_verdict(outcome: ProcessRunOutcome, rev: String) -> PlacementActionVerdict {
  match outcome {
    ProcessRan { observation: observation } =>
      match classify_process_observation(policy: ExitZeroSucceeds, observation: observation) {
        ProcessOutputPresent { text: _ } => ActionPlaced
        ProcessOutputAbsent => ActionPlaced
        ProcessRefused { exit_code: _, stderr: e } =>
          ActionRefused { reason: join(["fetch of ", rev, " refused: ", e], "") as NonEmptyStr }
      }
    ProcessNotSpawned { program: _, cause: c } =>
      ActionRefused { reason: join(["fetch of ", rev, " not spawned: ", c], "") as NonEmptyStr }
  }
}

fn release_pair_source_add_verdict(outcome: ProcessRunOutcome) -> PlacementActionVerdict {
  match outcome {
    ProcessRan { observation: observation } =>
      match classify_process_observation(policy: ExitZeroSucceeds, observation: observation) {
        ProcessOutputPresent { text: _ } => ActionPlaced
        ProcessOutputAbsent => ActionPlaced
        ProcessRefused { exit_code: _, stderr: e } =>
          ActionRefused { reason: join(["worktree add refused: ", e], "") as NonEmptyStr }
      }
    ProcessNotSpawned { program: _, cause: c } =>
      ActionRefused { reason: join(["worktree add not spawned: ", c], "") as NonEmptyStr }
  }
}

// ── the unit's own operator entry (zero-arg `function:` target) ──────────────────────────────────────────────
// Config that is the UNIT'S OWN static identity (where the release locus lives, which serve unit to restart, the repo
// root that locates the dashboard instance) may come from the environment. What keep-last-good PROTECTS — the served
// revision — is NEVER from env: it is OBSERVED through the pair serve gate (belt_pair_serve_gate -> the deployed-tree
// observation at the sealed locus), so a caller cannot claim a serving binding and have last-good protect a fiction.
// An unobservable/mixed pair at the gate is a typed refusal (the gate's own not-bound arm handles the first deploy);
// the actuator delivers nothing and exits non-zero rather than trust a hand-written head.
// (The three env-var NAME rows live in gunbc.live_deploy.spec, shared with the emitted unit that sets them.)

fn release_pair_deliver_once_cli() -> ProcessExit {
  match shell.Env.Get(name: release_pair_deliver_base_root_env).value {
    Absent => exit_failure(reason: "pair-deliver: GUNBC_PAIR_DELIVER_BASE_ROOT not set — the release locus root is the unit's own identity (fail-closed)")
    Present { value: base_root } =>
      if trim(s: base_root) == "" {
        exit_failure(reason: "pair-deliver: GUNBC_PAIR_DELIVER_BASE_ROOT is empty (fail-closed)")
      } else {
        release_pair_deliver_read_serve_unit(base_root: base_root)
      }
  }
}

fn release_pair_deliver_read_serve_unit(base_root: String) -> ProcessExit {
  match shell.Env.Get(name: release_pair_deliver_serve_unit_env).value {
    Absent => exit_failure(reason: "pair-deliver: GUNBC_PAIR_DELIVER_SERVE_UNIT not set (fail-closed)")
    Present { value: serve_unit_name } =>
      if trim(s: serve_unit_name) == "" {
        exit_failure(reason: "pair-deliver: GUNBC_PAIR_DELIVER_SERVE_UNIT is empty (fail-closed)")
      } else {
        release_pair_deliver_read_repo_root(base_root: base_root, serve_unit: serve_unit_name)
      }
  }
}

fn release_pair_deliver_read_repo_root(base_root: String, serve_unit: String) -> ProcessExit {
  match shell.Env.Get(name: release_pair_deliver_repo_root_env).value {
    Absent => exit_failure(reason: "pair-deliver: GUNBC_PAIR_DELIVER_REPO_ROOT not set (fail-closed)")
    Present { value: repo_root } =>
      if trim(s: repo_root) == "" {
        exit_failure(reason: "pair-deliver: GUNBC_PAIR_DELIVER_REPO_ROOT is empty (fail-closed)")
      } else {
        release_pair_deliver_observe_and_deliver(base_root: base_root, serve_unit: serve_unit, repo_root: repo_root)
      }
  }
}

fn release_pair_deliver_observe_and_deliver(base_root: String, serve_unit: String, repo_root: String) -> ProcessExit {
  match dashboard_instance_for_repo_root(repo_root: repo_root) {
    DashboardInstanceRootUnknown { repo_root: _ } =>
      exit_failure(reason: "pair-deliver: the repo root resolves to no dashboard instance — the served pair cannot be located (fail-closed)")
    DashboardInstanceResolved { instance: instance } =>
      match belt_pair_serve_gate(instance: instance) {
        PairServeRefused { binding: _, reason: why } =>
          exit_failure(reason: join(["pair-deliver: the serve gate refused (", why, ") — keep serving, deliver nothing (fail-closed)"], ""))
        PairBoundToServe { binding: binding } =>
          match release_pair_deliver_serving(binding: binding) {
            // Poison observed deployed state (mixed / surface-mixed / unobserved): REFUSE RED at the mapping itself
            // (review 96348). It never reaches the fold, so there is no RevisionNotInstalled fall-through to a fresh
            // fetch, and no separate poison predicate to keep in sync with the mapping.
            ServingRefused { reason: why } =>
              exit_failure(reason: join(["pair-deliver: ", why, " (fail-closed, review 96348)"], ""))
            ServingMapped { binding: serving } =>
              release_pair_deliver_actuate(
                base_root: base_root,
                serving: serving,
                serve_unit: serve_unit as NonEmptyStr,
                host_identity: instance.host_identity,
              )
          }
      }
  }
}

// Run the staged wet pipeline and PERFORM its observed effects: place the fetched serve member at the per-revision
// locus (create-only hard link), write the per-revision tree receipt naming the placed revision + its digest, then
// restart the serve unit through the plan's OWN command. Every step is a real effect; if any fails the rest is NOT
// performed (fail-closed: never restart onto a half-placed pair). Keep-last-good performs NO effect and exits success —
// the unit ran and correctly delivered nothing. This IS the unit's own delivery, not a hand step.
// THE SERVE RESTART IS A RENDERED STRING FROM THE SINGLE REGISTERED PRIVILEGED AUTHORITY, declared scaffold (review
// 96241 finding 2). The reviewer's typed-argv ask is legitimate, but typing it means CONVERTING
// gunbc.live_deploy.operations::systemctl_restart_command — the one sudo restart authority, registered at
// gunbc.auth.privileged_effect_registry:1376 and shared by other apply legs — from a String builder to an ArgvCommand
// builder. That conversion is its OWN authority transition (privileged builder + registry + census), not this PR's, and
// adding a second ArgvCommand restart beside it would create an unregistered sudo restart. So both shell-as-medium
// legs on this path (this restart and the consumer key-check verify) take the reviewer's declared-scaffold option,
// each a declared row with a dissolution trigger, no new mint and no census change here — both shell-as-medium
// STEPS here are admitted as declared scaffolding by operator ruling #gunbc.design_ruling::pair_delivery_shell_as_medium_steps_admitted (RULED 2026-11-18).
data release_pair_restart_shell_scaffold: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.live_deploy.operations",
    decl_name: "systemctl_restart_command",
    field: WholeDeclaration
  }
}

data release_pair_restart_shell_dissolution_trigger: DissolutionCondition = unbound_dissolution(description: "dissolve-on: the pair-delivery restart renders operations::systemctl_restart_command to a String and posix_sh_program_command's it; the service restart should be a sealed argv like start/enable. DISSOLVES WHEN operations::systemctl_restart_command returns ArgvCommand under its existing privileged_effect_registry row (its other String consumers migrate to shell_command_text_of_argv at their call sites), leaving no shell-as-medium medium in the pair-delivery restart leg.")

// PLACE-LEG HELPERS (review 96241 finding 1): split so both the AlreadyPlaced resume and the NotYetPlaced fresh path
// share ONE write-then-restart. They perform the effects; the pure resume DECISION is release_pair_resume_decision (fold).
// The restart carries the rendered command from the SINGLE registered privileged restart authority
// (operations::systemctl_restart_command, privileged_effect_registry). Its typed-argv realization (review 96241
// finding 2) needs a privileged ArgvCommand mint the manager owns — tracked, not silently widened into a second
// sudo restart builder here.
fn release_pair_restart_serve(restart: String) -> ProcessExit {
  match run_shell_command_capture(command: posix_sh_program_command(script: restart), transport: LocalExec) {
    ProcessCaptured { outcome: ProcessRefused { exit_code: _, stderr: _ } } =>
      exit_failure(reason: "pair-deliver: the pair was placed but the serve restart was refused — operator attention needed (kept, not restarted)")
    // The restart child NEVER EXISTED: the transport refused to build the command. Nothing restarted, so this
    // is the same operator-attention refusal — with no exit code invented for a child that never ran.
    ProcessCaptureNotSpawned { program: _, cause: _ } =>
      exit_failure(reason: "pair-deliver: the pair was placed but the serve restart was never spawned — the transport refused to build the command (kept, not restarted)")
    _ => ExitSuccess
  }
}

fn release_pair_deliver_write_receipt(receipt: SourceReceiptWrite, body: String, restart: String) -> ProcessExit {
  let w = Filesystem.WriteCreateNew(path: receipt.destination, content: body)
  match filesystem_create_new(
    path: receipt.destination, success: w.success, error: w.error, error_kind: w.error_kind,
  ) {
    FilesystemCreated { path: _ } => release_pair_restart_serve(restart: restart)
    _ => exit_failure(reason: "pair-deliver: the tree receipt could not be created (fail-closed: do not restart a half-placed pair)")
  }
}

fn release_pair_deliver_actuate(base_root: String, serving: ReleaseRevisionBinding, serve_unit: NonEmptyStr, host_identity: NonEmptyStr) -> ProcessExit {
  match release_pair_deliver_run(base_root: base_root, serving: serving, serve_unit: serve_unit, host_identity: host_identity) {
    // THE EXIT CODE FOLLOWS FROM THE VARIANT, NEVER THE REASON TEXT (review 96225 + 96234).
    // PlanWaits — genuinely nothing to deliver YET (no successful run for the head, or the pair is already at head):
    //   the serve unit keeps serving last-good and the timer retries. GREEN. The reason is carried for observability
    //   but is never compared to decide this.
    // PlanKeepsLastGood — the delivery was REFUSED for a real defect (gh head unobservable, discovery refused, pack
    //   absent from a refused download / unreadable digest, pack unverified, source/binary drift, missing placement):
    //   surface the reason and exit non-zero so a broken delivery is a located diagnostic, not silence (fail_closed,
    //   review 96234: an expired gh auth or full disk must NOT stay green). The reason is never discarded.
    // Re-wording a reason cannot flip green<->red — only choosing the wrong arm can, and every arm is witnessed.
    // The wait reason is carried in the arm (observable to callers and witnesses); a steady-state no-op tick stays
    // quiet on the journal rather than flooding it every 600s (the refusal below is the loud path).
    PlanWaits { kept: _, reason: _ } => ExitSuccess
    PlanKeepsLastGood { kept: _, reason: reason } =>
      exit_failure(reason: join(["pair-deliver kept last good, not a no-op — ", reason as String], ""))
    PlanToInstall { place_binary: place, write_source_receipt: receipt, restart_command: restart, revision: _ } => {
      // RESUME / IDEMPOTENCE (review 96241 finding 1). The link and receipt are CREATE-ONLY, so a tick that created
      // the link and then died on the receipt or the restart would hit FilesystemLinkCreateFailed on EVERY later tick
      // and stay red forever. The source receipt we WOULD write is the completion authority (written last, after the
      // link lands), so read it first: byte-identical content means the pair is already placed and only the restart
      // remains; absent means nothing placed yet (run the create legs, tolerating a link a half-done tick left); a
      // DIFFERENT receipt is a foreign/stale placement at the per-revision locus and refuses red.
      let body = release_locus_tree_receipt_body(
        revision_hex: receipt.revision as String,
        installed_digest: receipt.digest as String,
      )
      let rread = Filesystem.Read(path: receipt.destination)
      match release_pair_resume_decision(
        receipt_read: filesystem_read_outcome(content: rread.content, success: rread.success, error: rread.error),
        expected_body: body,
      ) {
        // Already placed for this exact revision — the restart leg is all that remains (a re-tick converges, not reds).
        AlreadyPlaced => release_pair_restart_serve(restart: restart)
        // A foreign or stale receipt at the per-revision locus — refuse (red control: a mismatched placement refuses).
        MismatchRefusal { reason } =>
          exit_failure(reason: join(["pair-deliver refused a foreign placement — ", reason as String], ""))
        // Nothing placed yet (or the read itself was refused — the ordinary fresh tick, not the red one): place it.
        NotYetPlaced => {
          let link = Filesystem.LinkCreateNew(source: place.source, path: place.destination)
          match filesystem_link_create_new(
            source: place.source, path: place.destination,
            success: link.success, error: link.error, error_kind: link.error_kind,
          ) {
            // Linked now: proceed to write the receipt.
            FilesystemLinked { path: _ } => release_pair_deliver_write_receipt(receipt: receipt, body: body, restart: restart)
            // The locus link already exists (a tick died after the link, before the receipt). Benign ONLY if it
            // already points at THIS revision's fetched member — read it back with the admitted readlink_command and
            // compare; an occupied link pointing elsewhere is a foreign placement and refuses (manager guard B).
            FilesystemLinkTargetOccupied { path: p } =>
              match release_pair_occupied_link_benign(
                link_read: run_shell_command_capture(command: readlink_command(path: p), transport: LocalExec),
                expected_source: place.source,
              ) {
                true => release_pair_deliver_write_receipt(receipt: receipt, body: body, restart: restart)
                false => exit_failure(reason: "pair-deliver: the per-revision release locus link is occupied by a target other than this revision's fetched member (or is not a symlink) — refusing rather than adopting a foreign placement (fail-closed, review 96241 f1)")
              }
            _ => exit_failure(reason: "pair-deliver: the fetched serve member could not be placed at the locus (fail-closed)")
          }
        }
      }
    }
  }
}

