module gunbc.live_deploy.release_pair_deliver_cli
// THE EXECUTING CONSUMER of the staged wet plan (PR-2a). This module turns the lab's release pair into a real,
// observed delivery: it OBSERVES the head, DISCOVERS the release-bins run for that exact head, FETCHES the pack,
// OBSERVES its digest and build-key verdict ON the fetched pack, and only then feeds those OBSERVED results through
// release_pair_install_plan -> deliver_release_pair. No stage takes a predecessor's result as an input it did not
// observe. The raw effectful entry (which runs the argv through the admissible command seam) is a later step; THIS
// step establishes the argv builders and the PURE decode fns that turn a ProcessOutcome into a typed observation, so
// the fail-closed decoding is witnessable by execution independently of the wet runtime.
//
// RUNG: the decode fns are total pure functions over ProcessOutcome and are witnessed green by execution; the
// command-seam composition that produces those ProcessOutcomes lives in the (pending) effectful entry and is
// exercised by the unit's own run at deploy, not by the claim. Frontier (executing trigger): roadmap work item
// `lab-converges-release-pair`.

import std.types { String, NonEmptyStr, List, Bool, Int }
import std.optional { Optional, Present, Absent }
import std.algebra { trim }
import extdeps.crypto.hash { sha256sum_line_digest }
import extdeps.shell.exec { ProcessOutcome, ProcessOutputPresent, ProcessOutputAbsent, ProcessRefused }
import gunbc.live_deploy.release_pair_delivery {
  PackFetch, PackPresent, PackAbsent, PackVerify, VerifiedOn, Refused,
}

// THE SINGLE AUTHORITY for where the incoming pack lands (dir + serve member) is release_pair_delivery's
// release_pair_incoming_pack_dir / release_pair_incoming_serve_source; the entry derives them and passes them to the
// decode fns below, so the CLI never re-spells the incoming directory.

// The repo whose release-bins run carries the pair, as ONE row (single_authority), consumed by the argv builders.
data release_pair_deliver_repo_slug: NonEmptyStr = "gunb-ai/gunbc"
// The fleet-converge workflow whose successful run publishes the release-bins pack for a head. ONE row; confirmed
// against `gh run list` at deploy time (the release-bins ARTIFACT is published by .github/workflows/fleet-converge.yml);
// it is the only place this is written, consumed by the effectful entry's call to gh_release_bins_run_list_command.
data release_pair_release_bins_workflow: NonEmptyStr = "fleet-converge.yml"
// Why the pair keeps serving when the fetch leg did not produce a pack (consumed by pack_fetch's PackAbsent).
data release_pair_fetch_refused_reason: NonEmptyStr = "the release-bins pack download for the bound head failed on the executing host"
// Why the pair keeps serving when the pack was fetched but its digest could not be observed (consumed by pack_fetch).
data release_pair_digest_unreadable_reason: NonEmptyStr = "the fetched release-bins pack's sha256 could not be observed on the executing host"
// Why the pair keeps serving when the build-key verdict did not admit the fetched pack (consumed by pack_verify).
data release_pair_verdict_refused_reason: NonEmptyStr = "the consumer build-key check did not admit the fetched release-bins pack on the executing host"

// ── command argv: obtained through the admitted production builders, never re-spelled here (Route A) ────────────
// The head to deploy and the release-bins run for that head are discovered gh-only through extdeps.tools.gh's
// admitted builders (gh_main_head_command via `gh api .../commits/main --jq .sha`; gh_release_bins_run_list_command
// for the fleet-converge run at a head), the fetch through gh_run_download_command, and the pack's digest through
// extdeps.crypto.hash.sha256sum_file_command. This module does NOT build argv itself: the sealed ArgvCommand is
// minted only at those admitted sites (git is not in the program census, so origin/main's head is observed via the
// cataloged gh program). The effectful entry composes those commands through the command seam and hands each leg's
// ProcessOutcome to the decode fns below.

// ── pure observation-decode fns (ProcessOutcome -> typed observation) ────────────────────────────────────────────
// The head the executing host OBSERVED on origin/main: Present only when a command that ran (exit 0) printed a
// non-empty head; none on an absent output or a refusal (a failed git rev-parse is NOT a head).
fn release_pair_decode_head(outcome: ProcessOutcome) -> NonEmptyStr? {
  match outcome {
    ProcessOutputPresent { text: t } =>
      if (trim(s: t) as String) == "" {
        none
      } else {
        Present { value: trim(s: t) as NonEmptyStr }
      }
    ProcessOutputAbsent => none
    ProcessRefused { exit_code: _, stderr: _ } => none
  }
}

// The release-bins run for the head: Present only when the discovery printed a run id; none on absent (no success run
// for the head — a typed refusal the entry turns into keep-last-good) or on a refusal (gh itself failed).
fn release_pair_decode_run(outcome: ProcessOutcome) -> NonEmptyStr? {
  match outcome {
    ProcessOutputPresent { text: t } =>
      if (trim(s: t) as String) == "" {
        none
      } else {
        Present { value: trim(s: t) as NonEmptyStr }
      }
    ProcessOutputAbsent => none
    ProcessRefused { exit_code: _, stderr: _ } => none
  }
}

// THE DIGEST BINDING: the observed `sha256sum` line's first field, admitted only as a valid lower_hex_64 through
// extdeps.crypto.hash::sha256sum_line_digest (the same parser the belt's member_observe uses — never re-parsed here);
// a refusal, an empty output, or a non-hex/wrong-width line is a named digest-unreadable, never a false PackPresent.
fn release_pair_pack_digest_bound(digest_outcome: ProcessOutcome, pack_dir: String, member_src: String) -> PackFetch {
  match digest_outcome {
    ProcessOutputPresent { text: d } =>
      match sha256sum_line_digest(line: d) {
        Present { value: dg } => PackPresent {
          sha256: dg.hex,
          pack_dir: pack_dir as NonEmptyStr,
          binary_source: member_src as NonEmptyStr,
        }
        none => PackAbsent { reason: release_pair_digest_unreadable_reason }
      }
    ProcessOutputAbsent => PackAbsent { reason: release_pair_digest_unreadable_reason }
    ProcessRefused { exit_code: _, stderr: _ } => PackAbsent { reason: release_pair_digest_unreadable_reason }
  }
}

// THE FETCH OBSERVATION: a pack the executing host OBSERVED. Present only when the download ran (exit 0 — `gh run
// download` is silent on success — or present stdout) AND the digest leg OBSERVED a valid hex; a refused download is
// a named PackAbsent, never a falsely-bound PackPresent. dir and serve-member source are the entry's OBSERVED values.
fn release_pair_pack_fetch(
  fetch_outcome: ProcessOutcome,
  digest_outcome: ProcessOutcome,
  pack_dir: String,
  member_src: String,
) -> PackFetch {
  match fetch_outcome {
    ProcessRefused { exit_code: _, stderr: _ } => PackAbsent { reason: release_pair_fetch_refused_reason }
    ProcessOutputAbsent => release_pair_pack_digest_bound(digest_outcome: digest_outcome, pack_dir: pack_dir, member_src: member_src)
    ProcessOutputPresent { text: _ } => release_pair_pack_digest_bound(digest_outcome: digest_outcome, pack_dir: pack_dir, member_src: member_src)
  }
}

// THE BUILD-KEY VERDICT OBSERVED on that fetched pack: VerifiedOn(pack_dir) only when the consumer build-key check
// ran clean (exit 0); Refused with a named reason otherwise. The pack_dir named here is the SAME directory the entry
// observed the fetch wrote into; release_pair_install_plan then refuses unless verify and fetch name the same pack
// (the typed same-pack_dir comparison), so a verdict for a different directory cannot authorize an install.
fn release_pair_pack_verify(verify_outcome: ProcessOutcome, pack_dir: String) -> PackVerify {
  match verify_outcome {
    ProcessOutputPresent { text: _ } => VerifiedOn { pack_dir: pack_dir as NonEmptyStr }
    ProcessOutputAbsent => VerifiedOn { pack_dir: pack_dir as NonEmptyStr }
    ProcessRefused { exit_code: _, stderr: _ } => Refused { reason: release_pair_verdict_refused_reason }
  }
}
