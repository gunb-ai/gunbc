module gunbc.live_deploy.release_pair_deliver_cli
// THE EXECUTING CONSUMER of the staged wet plan (PR-2a). This module turns the lab's release pair into a real,
// observed delivery: release_pair_deliver_run OBSERVES origin/main's head (what to deploy), DISCOVERS the release-bins
// run for that exact head, FETCHES its pack, OBSERVES the fetched serve member's digest and the consumer build-key
// verdict ON the fetched pack, and only then feeds those OBSERVED results through release_pair_install_plan ->
// deliver_release_pair. No stage takes a predecessor's result as an input it did not observe. Discovery and command
// minting stay gh-only through extdeps.tools.gh's admitted builders (git is not in the sealed program census); the
// digest is admitted through extdeps.crypto.hash::sha256sum_line_digest.
//
// RUNG: the decode fns are total pure functions over ProcessOutcome and are witnessed green by execution
// (release_pair_deliver_cli_witness); the effectful entry release_pair_deliver_run composes those legs through the
// admissible command seam and is executed by the pair-delivery unit's own run — its consumer/trigger frontier is the
// PR3b unit registered under roadmap item `lab-converges-release-pair`. It typechecks in the same claim closure as
// the witnessed decode fns; its wet behaviour is proven at the paired deploy, not by a hand step.

import std.types { String, NonEmptyStr, List, Bool, Int, CommitSha }
import std.optional { Optional, Present, Absent }
import std.algebra { trim }
import extdeps.crypto.hash { sha256sum_line_digest, sha256sum_file_command }
import extdeps.exec.command { ArgvCommand, LocalExec }
import extdeps.tools.gh {
  gh_main_head_command, gh_release_bins_run_list_command, gh_run_download_command,
}
import extdeps.posix.sh_invocation { posix_sh_program_command }
import gunbc.command_runner { run_shell_command_capture }
import gunbc.live_deploy.release_locus {
  ReleaseRevisionBinding,
  RevisionBoundAtEmission,
  RevisionNotInstalled,
  release_pair_bins_unbuilt_reason,
}
import gunbc.live_deploy.release_binding {
  DeployedReleaseBinding,
  ReleaseBoundToTree,
  ReleaseMixed,
  ReleaseSurfaceMixed,
  ReleaseBindingUnobserved,
  LabServePairVerdict,
  PairBoundToServe,
  PairServeRefused,
}
import extdeps.git.object_store { git_object_id_wire_hex }
import gunbc.live_deploy.release_pair_delivery {
  PackFetch, PackPresent, PackAbsent, PackVerify, VerifiedOn, Refused,
  DeliveryPlan, PlanKeepsLastGood, PlanToInstall,
  release_pair_incoming_pack_dir, release_pair_incoming_serve_source,
  release_pair_verify_dispatch, release_pair_install_plan,
  release_pair_release_bins_artifact_name,
}
import std.process { ProcessExit, ExitSuccess, exit_failure }
import gunbc.live_deploy.spec {
  release_pair_deliver_base_root_env,
  release_pair_deliver_serve_unit_env,
  release_pair_deliver_repo_root_env,
}
import extdeps.shell
import extdeps.filesystem.filesystem_io {
  Filesystem, filesystem_link_create_new, filesystem_create_new,
  FilesystemLinked, FilesystemCreated,
}
import gunbc.cli_run_workspace_root_scaffold { release_locus_tree_receipt_body }
import gunbc.roadmap.roadmap_dashboard_instance {
  HostDashboardInstance, DashboardInstanceResolved, DashboardInstanceRootUnknown,
  dashboard_instance_for_repo_root,
}
import gunbc.roadmap.roadmap_belt_tick_cli { belt_pair_serve_gate }

// THE SINGLE AUTHORITY for where the incoming pack lands (dir + serve member) is release_pair_delivery's
// release_pair_incoming_pack_dir / release_pair_incoming_serve_source; the entry derives them and passes them to the
// decode fns below, so the CLI never re-spells the incoming directory.

// The repo whose release-bins run carries the pair, as ONE row (single_authority), consumed by the argv builders.
data release_pair_deliver_repo_slug: NonEmptyStr = "gunb-ai/gunbc"
// The fleet-converge workflow whose successful run publishes the release-bins pack for a head. ONE row; confirmed
// against `gh run list` at deploy time (the release-bins ARTIFACT is published by .github/workflows/fleet-converge.yml);
// it is the only place this is written, consumed by the effectful entry's call to gh_release_bins_run_list_command.
data release_pair_release_bins_workflow: NonEmptyStr = "fleet-converge.yml"
// Why the pair keeps serving when the fetch leg did not produce a pack (consumed by pack_fetch's PackAbsent).
data release_pair_fetch_refused_reason: NonEmptyStr = "the release-bins pack download for the bound head failed on the executing host"
// Why the pair keeps serving when the pack was fetched but its digest could not be observed (consumed by pack_fetch).
data release_pair_digest_unreadable_reason: NonEmptyStr = "the fetched release-bins pack's sha256 could not be observed on the executing host"
// Why the pair keeps serving when the build-key verdict did not admit the fetched pack (consumed by pack_verify).
data release_pair_verdict_refused_reason: NonEmptyStr = "the consumer build-key check did not admit the fetched release-bins pack on the executing host"
// The gh api path that OBSERVES origin/main's head (the head TO DEPLOY), DERIVED from the one repo-slug row so the
// slug is written once (single_authority). Consumed by the staged fn's call to gh_main_head_command.
fn release_pair_main_head_api_path(slug: NonEmptyStr) -> String {
  join(["repos/", slug, "/commits/main"], "")
}
// Why the pair keeps serving when origin/main's head could not be observed (consumed by the entry's head leg).
data release_pair_no_head_reason: NonEmptyStr = "origin/main's head could not be observed on the executing host"
// Why the pair keeps serving when the bound head has no successful fleet-converge run (consumed by the entry's run leg).
data release_pair_no_run_for_head_reason: NonEmptyStr = "the bound head has no successful release-bins run to fetch"

// ── command argv: obtained through the admitted production builders, never re-spelled here (Route A) ────────────
// The head to deploy and the release-bins run for that head are discovered gh-only through extdeps.tools.gh's
// admitted builders (gh_main_head_command via `gh api .../commits/main --jq .sha`; gh_release_bins_run_list_command
// for the fleet-converge run at a head), the fetch through gh_run_download_command, and the pack's digest through
// extdeps.crypto.hash.sha256sum_file_command. This module does NOT build argv itself: the sealed ArgvCommand is
// minted only at those admitted sites (git is not in the program census, so origin/main's head is observed via the
// cataloged gh program). The effectful entry composes those commands through the command seam and hands each leg's
// ProcessOutcome to the decode fns below.

// ── pure observation-decode fns (ProcessOutcome -> typed observation) ────────────────────────────────────────────
// The head the executing host OBSERVED on origin/main: Present only when a command that ran (exit 0) printed a
// non-empty head; none on an absent output or a refusal (a failed git rev-parse is NOT a head).
fn release_pair_decode_head(outcome: ProcessOutcome) -> NonEmptyStr? {
  match outcome {
    ProcessOutputPresent { text: t } =>
      if (trim(s: t) as String) == "" {
        none
      } else {
        Present { value: trim(s: t) as NonEmptyStr }
      }
    ProcessOutputAbsent => none
    ProcessRefused { exit_code: _, stderr: _ } => none
  }
}

// The release-bins run for the head: Present only when the discovery printed a run id; none on absent (no success run
// for the head — a typed refusal the entry turns into keep-last-good) or on a refusal (gh itself failed).
// The run-list observation, both sides read from the run metadata the gh call returned: the run id (to download
// its pack) and the run's head_sha — the BINARY side of the pair, decoded and checked, not assumed from the query
// filter. head_sha is the binary-side observation the fold compares against the observed source head; it is
// threaded into the fold when the source-side placement lands (node://lab-converges-release-pair, git-census Hold).
type ReleasePairRunObservation {
  run_id: NonEmptyStr
  head_sha: NonEmptyStr
}

fn release_pair_decode_run(outcome: ProcessOutcome) -> ReleasePairRunObservation? {
  match outcome {
    ProcessOutputPresent { text: t } =>
      if (trim(s: t) as String) == "" {
        none
      } else {
        let parts = split(s: trim(s: t), delimiter: "\t")
        if (last(l: parts) as String) == (first(l: parts) as String) || (last(l: parts) as String) == "" {
          none
        } else {
          Present {
            value: ReleasePairRunObservation {
              run_id: first(l: parts) as NonEmptyStr,
              head_sha: last(l: parts) as NonEmptyStr,
            },
          }
        }
      }
    ProcessOutputAbsent => none
    ProcessRefused { exit_code: _, stderr: _ } => none
  }
}

// THE DIGEST BINDING: the observed `sha256sum` line's first field, admitted only as a valid lower_hex_64 through
// extdeps.crypto.hash::sha256sum_line_digest (the same parser the belt's member_observe uses — never re-parsed here);
// a refusal, an empty output, or a non-hex/wrong-width line is a named digest-unreadable, never a false PackPresent.
fn release_pair_pack_digest_bound(digest_outcome: ProcessOutcome, pack_dir: String, member_src: String) -> PackFetch {
  match digest_outcome {
    ProcessOutputPresent { text: d } =>
      match sha256sum_line_digest(line: d) {
        Present { value: dg } => PackPresent {
          sha256: dg.hex,
          pack_dir: pack_dir as NonEmptyStr,
          binary_source: member_src as NonEmptyStr,
        }
        none => PackAbsent { reason: release_pair_digest_unreadable_reason }
      }
    ProcessOutputAbsent => PackAbsent { reason: release_pair_digest_unreadable_reason }
    ProcessRefused { exit_code: _, stderr: _ } => PackAbsent { reason: release_pair_digest_unreadable_reason }
  }
}

// THE FETCH OBSERVATION: a pack the executing host OBSERVED. Present only when the download ran (exit 0 — `gh run
// download` is silent on success — or present stdout) AND the digest leg OBSERVED a valid hex; a refused download is
// a named PackAbsent, never a falsely-bound PackPresent. dir and serve-member source are the entry's OBSERVED values.
fn release_pair_pack_fetch(
  fetch_outcome: ProcessOutcome,
  digest_outcome: ProcessOutcome,
  pack_dir: String,
  member_src: String,
) -> PackFetch {
  match fetch_outcome {
    ProcessRefused { exit_code: _, stderr: _ } => PackAbsent { reason: release_pair_fetch_refused_reason }
    ProcessOutputAbsent => release_pair_pack_digest_bound(digest_outcome: digest_outcome, pack_dir: pack_dir, member_src: member_src)
    ProcessOutputPresent { text: _ } => release_pair_pack_digest_bound(digest_outcome: digest_outcome, pack_dir: pack_dir, member_src: member_src)
  }
}

// THE BUILD-KEY VERDICT OBSERVED on that fetched pack: VerifiedOn(pack_dir) only when the consumer build-key check
// ran clean (exit 0); Refused with a named reason otherwise. The pack_dir named here is the SAME directory the entry
// observed the fetch wrote into; release_pair_install_plan then refuses unless verify and fetch name the same pack
// (the typed same-pack_dir comparison), so a verdict for a different directory cannot authorize an install.
fn release_pair_pack_verify(verify_outcome: ProcessOutcome, pack_dir: String) -> PackVerify {
  match verify_outcome {
    ProcessOutputPresent { text: _ } => VerifiedOn { pack_dir: pack_dir as NonEmptyStr }
    ProcessOutputAbsent => VerifiedOn { pack_dir: pack_dir as NonEmptyStr }
    ProcessRefused { exit_code: _, stderr: _ } => Refused { reason: release_pair_verdict_refused_reason }
  }
}

// ── the effectful entry: THE executing consumer of the dry plan ──────────────────────────────────────────────────
// The consumer the fold's plan was written for. It OBSERVES every stage through the admitted command seam and hands
// each OBSERVED ProcessOutcome to the decode fns above — no stage is handed its predecessor's result as an input it
// did not observe. It (1) observes origin/main's head (what to DEPLOY) via the cataloged gh program, (2) discovers the
// fleet-converge run for THAT head, (3) downloads its release-bins pack, (4) digests the fetched serve member, then
// (5) runs the consumer build-key check ON the fetched pack, and only then asks release_pair_install_plan for the
// ordered install (which folds the pair and either places+restarts or keeps the last good). The two discovery legs
// that yield nothing are typed keep-last-good refusals, never a guess. Executed by the pair-delivery unit's own run
// (roadmap item lab-converges-release-pair, PR3b); its decision halves are witnessed by release_pair_deliver_cli_witness.
// A keep-last-good is a benign wait for CI ONLY when the release-bins pack for the head is not built yet; every
// other keep-last-good names a refusal the operator must see (fail-closed default: anything else is not a no-op).
fn release_pair_reason_is_benign_wait(reason: NonEmptyStr) -> Bool {
  (reason as String) == (release_pair_bins_unbuilt_reason as String)
}

fn release_pair_deliver_run(base_root: String, serving: ReleaseRevisionBinding, serve_unit: NonEmptyStr) -> DeliveryPlan {
  let head_outcome = run_shell_command_capture(
    command: gh_main_head_command(api_path: release_pair_main_head_api_path(slug: release_pair_deliver_repo_slug)),
    transport: LocalExec,
  )
  match release_pair_decode_head(outcome: head_outcome) {
    none => PlanKeepsLastGood { kept: serving, reason: release_pair_no_head_reason }
    Present { value: main_head } =>
      let run_outcome = run_shell_command_capture(
        command: gh_release_bins_run_list_command(
          repo: release_pair_deliver_repo_slug as String,
          workflow: release_pair_release_bins_workflow as String,
          commit: main_head as String,
        ),
        transport: LocalExec,
      )
      match release_pair_decode_run(outcome: run_outcome) {
        none => PlanKeepsLastGood { kept: serving, reason: release_pair_no_run_for_head_reason }
        Present { value: run } =>
          let pack_dir = release_pair_incoming_pack_dir(base_root: base_root)
          let member_src = release_pair_incoming_serve_source(base_root: base_root)
          let fetch_outcome = run_shell_command_capture(
            command: gh_run_download_command(
              run_id: run.run_id as String,
              repo: release_pair_deliver_repo_slug as String,
              artifact: release_pair_release_bins_artifact_name as String,
              dir: pack_dir,
            ),
            transport: LocalExec,
          )
          let digest_outcome = run_shell_command_capture(
            command: sha256sum_file_command(path: member_src),
            transport: LocalExec,
          )
          let fetch = release_pair_pack_fetch(
            fetch_outcome: fetch_outcome,
            digest_outcome: digest_outcome,
            pack_dir: pack_dir,
            member_src: member_src,
          )
          let verify = match release_pair_verify_dispatch(fetch: fetch) {
            Present { value: script } =>
              release_pair_pack_verify(
                verify_outcome: run_shell_command_capture(
                  command: posix_sh_program_command(script: script),
                  transport: LocalExec,
                ),
                pack_dir: pack_dir,
              )
            none => Refused { reason: release_pair_verdict_refused_reason }
          }
          release_pair_install_plan(
            base_root: base_root,
            serving: serving,
            // BINARY-SIDE OBSERVATION: the run's head_sha decoded from the run-list metadata (review 96117 F1 /
            // 96121). It is CHECKED by the fold, not trusted — the run was selected by commit = the observed
            // origin/main head, but the fold refuses unless the pack's own recorded head equals the source half, so
            // a run whose head_sha drifted from the head we asked for cannot install. The source half below is the
            // OTHER independent observation (the gh head read); once the source-tree placement lands (census ruling)
            // it becomes the head OBSERVED from the placed tree via the deployed-tree authority, not this query value.
            main_head: run.head_sha as CommitSha,
            source_head: main_head as CommitSha,
            fetch: fetch,
            verify: verify,
            serve_unit: serve_unit,
          )
      }
  }
}

// Maps the OBSERVED deployed binding (from the serve gate) to the fold's ReleaseRevisionBinding: what
// keep-last-good protects is the revision the deployed TREE is on, so it is read from the bound arm's
// GitObjectId via the single GitObjectId->hex authority (extdeps.git.object_store). Reached only with a
// bound tree — the serve gate refuses the unobserved/mixed arms before the actuator runs the fold — so the
// mixed and unobserved arms are fail-closed poison here (gunbc.design_argument::fail_closed): they must
// never yield a usable binding, and reaching one reds the golden gate rather than placing a wrong pair.
fn release_pair_deliver_serving(binding: DeployedReleaseBinding) -> ReleaseRevisionBinding {
  match binding {
    ReleaseBoundToTree { revision: r, surface: _ } =>
      RevisionBoundAtEmission { revision: git_object_id_wire_hex(oid: r) as CommitSha }
    ReleaseMixed { tree_revision: _, process_revision: _ } => RevisionNotInstalled
    ReleaseSurfaceMixed { revision: _, expected_surface: _, process_surface: _ } => RevisionNotInstalled
    ReleaseBindingUnobserved { cause: _ } => RevisionNotInstalled
  }
}

// ── the unit's own operator entry (zero-arg `function:` target) ──────────────────────────────────────────────
// Config that is the UNIT'S OWN static identity (where the release locus lives, which serve unit to restart, the repo
// root that locates the dashboard instance) may come from the environment. What keep-last-good PROTECTS — the served
// revision — is NEVER from env: it is OBSERVED through the pair serve gate (belt_pair_serve_gate -> the deployed-tree
// observation at the sealed locus), so a caller cannot claim a serving binding and have last-good protect a fiction.
// An unobservable/mixed pair at the gate is a typed refusal (the gate's own not-bound arm handles the first deploy);
// the actuator delivers nothing and exits non-zero rather than trust a hand-written head.
// (The three env-var NAME rows live in gunbc.live_deploy.spec, shared with the emitted unit that sets them.)

fn release_pair_deliver_once_cli() -> ProcessExit {
  match shell.Env.Get(name: release_pair_deliver_base_root_env).value {
    Absent => exit_failure(reason: "pair-deliver: GUNBC_PAIR_DELIVER_BASE_ROOT not set — the release locus root is the unit's own identity (fail-closed)")
    Present { value: base_root } =>
      if trim(s: base_root) == "" {
        exit_failure(reason: "pair-deliver: GUNBC_PAIR_DELIVER_BASE_ROOT is empty (fail-closed)")
      } else {
        release_pair_deliver_read_serve_unit(base_root: base_root)
      }
  }
}

fn release_pair_deliver_read_serve_unit(base_root: String) -> ProcessExit {
  match shell.Env.Get(name: release_pair_deliver_serve_unit_env).value {
    Absent => exit_failure(reason: "pair-deliver: GUNBC_PAIR_DELIVER_SERVE_UNIT not set (fail-closed)")
    Present { value: serve_unit_name } =>
      if trim(s: serve_unit_name) == "" {
        exit_failure(reason: "pair-deliver: GUNBC_PAIR_DELIVER_SERVE_UNIT is empty (fail-closed)")
      } else {
        release_pair_deliver_read_repo_root(base_root: base_root, serve_unit: serve_unit_name)
      }
  }
}

fn release_pair_deliver_read_repo_root(base_root: String, serve_unit: String) -> ProcessExit {
  match shell.Env.Get(name: release_pair_deliver_repo_root_env).value {
    Absent => exit_failure(reason: "pair-deliver: GUNBC_PAIR_DELIVER_REPO_ROOT not set (fail-closed)")
    Present { value: repo_root } =>
      if trim(s: repo_root) == "" {
        exit_failure(reason: "pair-deliver: GUNBC_PAIR_DELIVER_REPO_ROOT is empty (fail-closed)")
      } else {
        release_pair_deliver_observe_and_deliver(base_root: base_root, serve_unit: serve_unit, repo_root: repo_root)
      }
  }
}

fn release_pair_deliver_observe_and_deliver(base_root: String, serve_unit: String, repo_root: String) -> ProcessExit {
  match dashboard_instance_for_repo_root(repo_root: repo_root) {
    DashboardInstanceRootUnknown { repo_root: _ } =>
      exit_failure(reason: "pair-deliver: the repo root resolves to no dashboard instance — the served pair cannot be located (fail-closed)")
    DashboardInstanceResolved { instance: instance } =>
      match belt_pair_serve_gate(instance: instance) {
        PairServeRefused { binding: _, reason: why } =>
          exit_failure(reason: join(["pair-deliver: the serve gate refused (", why, ") — keep serving, deliver nothing (fail-closed)"], ""))
        PairBoundToServe { binding: binding } =>
          release_pair_deliver_actuate(
            base_root: base_root,
            serving: release_pair_deliver_serving(binding: binding),
            serve_unit: serve_unit as NonEmptyStr,
          )
      }
  }
}

// Run the staged wet pipeline and PERFORM its observed effects: place the fetched serve member at the per-revision
// locus (create-only hard link), write the per-revision tree receipt naming the placed revision + its digest, then
// restart the serve unit through the plan's OWN command. Every step is a real effect; if any fails the rest is NOT
// performed (fail-closed: never restart onto a half-placed pair). Keep-last-good performs NO effect and exits success —
// the unit ran and correctly delivered nothing. This IS the unit's own delivery, not a hand step.
fn release_pair_deliver_actuate(base_root: String, serving: ReleaseRevisionBinding, serve_unit: NonEmptyStr) -> ProcessExit {
  match release_pair_deliver_run(base_root: base_root, serving: serving, serve_unit: serve_unit) {
    // A timer tick keeps serving the last good pair for one of two reasons: the release-bins pack for the head is
    // simply not built yet (a benign wait for CI — exit green), or the delivery was REFUSED for a real defect (gh
    // head unobservable, no run, build-key refused, source/binary mismatch, missing placement). The latter must not
    // look green: surface the reason and exit non-zero, so a broken delivery is a located diagnostic, not silence
    // (fail_closed). The reason is never discarded.
    PlanKeepsLastGood { kept: _, reason: reason } =>
      if release_pair_reason_is_benign_wait(reason: reason) {
        ExitSuccess
      } else {
        exit_failure(reason: join(["pair-deliver kept last good, not a no-op — ", reason as String], ""))
      }
    PlanToInstall { place_binary: place, write_source_receipt: receipt, restart_command: restart, revision: _ } => {
      let link = Filesystem.LinkCreateNew(source: place.source, path: place.destination)
      match filesystem_link_create_new(
        source: place.source, path: place.destination,
        success: link.success, error: link.error, error_kind: link.error_kind,
      ) {
        FilesystemLinked { path: _ } => {
          let body = release_locus_tree_receipt_body(
            revision_hex: receipt.revision as String,
            installed_digest: receipt.digest as String,
          )
          let w = Filesystem.WriteCreateNew(path: receipt.destination, content: body)
          match filesystem_create_new(
            path: receipt.destination, success: w.success, error: w.error, error_kind: w.error_kind,
          ) {
            FilesystemCreated { path: _ } =>
              match run_shell_command_capture(command: posix_sh_program_command(script: restart), transport: LocalExec) {
                ProcessRefused { exit_code: _, stderr: _ } =>
                  exit_failure(reason: "pair-deliver: the pair was placed but the serve restart was refused — operator attention needed (kept, not restarted)")
                _ => ExitSuccess
              }
            _ => exit_failure(reason: "pair-deliver: the tree receipt could not be created (fail-closed: do not restart a half-placed pair)")
          }
        }
        _ => exit_failure(reason: "pair-deliver: the fetched serve member could not be placed at the locus (fail-closed)")
      }
    }
  }
}

