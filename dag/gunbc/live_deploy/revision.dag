module gunbc.live_deploy.revision

import std.types { NonEmptyStr, FilePath, CommitSha, String }
import gunbc.live_deploy.spec {
  DeploymentSpec,
  deployment_spec_srv1,
  deployment_spec_srv1_green,
}

data deploy_guarantee_note: String = "THE GUARANTEE THIS MODULE EXISTS TO HOLD, stated once so every arm below can be read as a consequence of it (operator ruling 2026-08-04): after admitted work settles, the public srv1 dashboard serves the newest deploy-admitted main revision; during convergence the public route never moves backward and never points at an unverified candidate. 'Deploy-admitted' means the revision completed build, artifact verification and CI admission — deliberately NOT 'every commit must execute a deploy job'. That splits into SAFETY (the candidate slot is prepared and verified before the route changes; the active revision never decreases under Git ancestry; an unrelated or unverifiable relation refuses before mutation) and LIVENESS (once admitted candidates stop arriving, the active revision becomes the newest admitted candidate). The blue/green order already holds the first safety clause. This module holds the second and third, and is the reason the scheduler no longer has to preserve commit order."

data deploy_ordering_is_not_the_queues_job_note: String = "THE QUEUE KNOWS WHICH JOB STARTED WAITING MOST RECENTLY; IT DOES NOT KNOW WHICH CONTENT IS NEWEST, and the previous design asked it the second question. GitHub orders concurrency entries by when they begin waiting — after `needs:` resolves — never by push order or commit ancestry, and documents that ordering is not guaranteed. srv1-deploy-serialization-and-false-greens.md §2.3 carries the receipt that arrival is ALREADY inverted relative to commit order, and the live incident on run 30863337319 showed both failure modes in one window: the NEWEST commit's deploy was cancelled while pending with zero steps, and the OLDEST commit's deploy ran last, installed its older tree and reported success.\\n\\nThe repair is to stop needing the order. Once the actuator is monotonic under ancestry, executing candidates in ANY order converges to the newest, so the scheduler's job shrinks to 'do not discard admitted candidates' (queue: max) and correctness stops depending on a property the platform never promised."

data deploy_monotonic_join_note: String = "THE TRANSITION IS A JOIN ON THE ANCESTRY ORDER: next_active = active ⊔ candidate. That is the whole ordering law, and the three algebraic properties it buys are why order-independence is a theorem here rather than a hope — on a linear main history the transition is IDEMPOTENT (retrying one candidate changes nothing), ORDER-INDEPENDENT (executing B,A,C or C,A,B both end at C), and MONOTONIC (an older candidate cannot replace a newer active revision). The permutation acceptance test asserts exactly that: every permutation of three ordered revisions ends active at the newest."

data deploy_target_is_the_public_service_note: String = "THE TARGET IS THE PUBLIC DEPLOYMENT, NOT ONE OF ITS ALTERNATING RUNTIME UNITS. The previous carrier named a host, a destination directory and a single service unit `gunbc-dashboard` — a unit that does not exist on the machine, on a model that predates blue/green. Under blue/green there is no one unit to name: production currently runs `gunbc-roadmap.service`, the green slot carries its own derived unit and tree-sync names, the two slots share one public root Tailscale route, and a cutover mutates an idle slot, the route, and the retiring runtime.\\n\\nSo the identity is the public service with its two slots, and everything else DERIVES from it: the scheduler queue group, the host-side exclusive lease, the slot specifications, the root route, and the active-revision observation. Deriving them from one target is what makes 'same target' mean 'same bytes at risk' — a job name is a CI-side label, so renaming the job would silently mint a different lock while the same host resources are still being mutated, and naming one slot's unit would mean the lock alternates with the cutover it is supposed to serialize."

data deploy_target_single_variant_note: String = "One variant, declared with the leading-pipe form so it is a CLOSED COPRODUCT rather than a type alias. `type DeploymentTarget = Srv1Dashboard` parses as an alias to an undeclared type, which is why the sum form is spelled this way (the sole corpus precedent is extdeps.crypto.hash HashAlgorithm). The distinction is load-bearing: every derivation below matches on the target, so a second deployment target added here fails to compile until it states its own queue group, lease path, and slots — an alias would have silently accepted anything."

type DeploymentTarget =
  | Srv1Dashboard

fn deploy_target_key(target: DeploymentTarget) -> String {
  match target {
    Srv1Dashboard => "srv1-dashboard"
  }
}

fn deploy_target_blue_slot(target: DeploymentTarget) -> DeploymentSpec {
  match target {
    Srv1Dashboard => deployment_spec_srv1()
  }
}

fn deploy_target_green_slot(target: DeploymentTarget) -> DeploymentSpec {
  match target {
    Srv1Dashboard => deployment_spec_srv1_green()
  }
}

data deploy_target_queue_group_note: String = "THE GROUP STRING IS DERIVED FROM THE TARGET BUT DELIBERATELY STILL SPELLS THE LEGACY NAME, and the rename is deferred rather than dropped.\\n\\nAn earlier revision returned `gunbc-deploy-<key>` and argued the rename was safe because a concurrency group is a mutex namespace with no persisted state, so nothing migrates. That reasoning is beside the point (operator review 2026-08-04): what changes at a rename is the MUTUAL-EXCLUSION IDENTITY itself. Across the merge window, jobs already in flight occupy `srv1-dashboard-deploy` while the merge run occupies the new name — two groups that do not exclude each other — and those older jobs also predate the host lease, so they take no lock either. For exactly that window the deploy would have had NO exclusion from either mechanism, which is worse than the state this change exists to repair.\\n\\nSo the first lease-and-monotonicity landing keeps the legacy string. It is a projection of the target rather than a literal at the call site, so 'same target' still means 'same lock and same group', and renaming later is a one-line change here.\\n\\nDISSOLVE-ON: old unleased deploy jobs have drained (no run started before this change is still in flight), after which this returns the derived `gunbc-deploy-<key>` form. The rename must not ride the same merge as the lease.\\n\\nThe scheduler group remains PRESSURE SHAPING and is explicitly not the mutual-exclusion authority — deploy_target_lease_path carries that, because a GitHub group constrains only jobs routed through it and this repository exposes a second operator entrypoint into the same actuator."

fn deploy_target_queue_group(target: DeploymentTarget) -> String {
  match target {
    Srv1Dashboard => "srv1-dashboard-deploy"
  }
}

data deploy_target_queue_group_renamed_form_note: String = "The form the group takes once the drain completes, kept beside its current value so the dissolve-on is a one-line swap rather than a re-derivation. It is not referenced by the emitted workflow today; the witness asserts both that the emitted group is the legacy string AND that this derived form differs from it, so the deferral stays visible rather than quietly becoming permanent."

fn deploy_target_queue_group_after_drain(target: DeploymentTarget) -> String {
  concat("gunbc-deploy-", deploy_target_key(target: target))
}

data deploy_target_lease_note: String = "THE LEASE IS THE ACTUAL MUTUAL-EXCLUSION AUTHORITY and it spans the whole cutover, not one phase of it. Monotonicity alone does not close the observe-then-mutate race: two callers can both observe blue active, both classify their own candidate as an Advance from that same active revision, and both prepare the idle green slot with different trees. So the lease is acquired BEFORE the route observation and held through the final routed-identity readback — an exclusion boundary that ends at the route flip lets the next caller mutate the host while this one is still proving readiness, which is the same race one phase later."

fn deploy_target_lease_path(target: DeploymentTarget) -> FilePath {
  concat(concat("/var/lib/gunbc/deploy-lease/", deploy_target_key(target: target)), ".lock") as FilePath
}

data deploy_slot_revision_receipt_note: String = "THE ACTIVE REVISION IS READ FROM THE ROUTED SLOT, so the receipt is keyed PER SLOT rather than being one global file keyed by a service unit. Under blue/green a crash can land between preparing a slot, flipping the route, and updating a global marker, so a single marker can describe a tree that is not the one being served. Per-slot receipts make the PUBLIC ROUTE select the authority: whichever slot the route points at is by definition the one serving the public, and its receipt is the revision the public is getting. A half-prepared idle slot cannot mislead the next run, because nothing reads the idle slot's receipt to decide.\\n\\nIT LIVES OUTSIDE THE RSYNCED TREE, and that placement is load-bearing rather than tidy. A marker inside repo_root is destroyed by the very `rsync --delete` whose outcome it describes, so after a partial or interrupted sync the record would describe a tree that was never fully written — the state the guard exists to detect becomes the state it cannot see. Keeping it beside the destination means it is written ONLY after the slot has restarted and its surface has been read back, so a crash mid-deploy leaves the previous revision recorded and the next run correctly classifies the incomplete slot as still-at-the-old-revision rather than trusting a marker a failed run had already advanced.\\n\\n🟡 dissolve-on: the served process publishing the immutable identity it was launched with, so the active revision is read from the RUNNING process rather than from a file beside it. A file states what the last successful writer intended; only the process can state what is actually bound. Until then readiness's existing surface-digest equality is what ties the receipt to the running graph, and this file is the weaker of the two facts."

fn deploy_slot_revision_receipt_path(slot: DeploymentSpec) -> FilePath {
  join(["/var/lib/gunbc/deploy-revision/", slot.names.unit_name as String, ".sha"], "") as FilePath
}

data deploy_revision_probe_note: String = "The relation is OBSERVED, not inferred from timestamps or run numbers. `git merge-base --is-ancestor A B` answers it in one exit code — 0 for yes, 1 for no, 128 for a bad object — and the exit-1 case is a legitimate ANSWER rather than an error, which is precisely what lets UnrelatedHistories and RelationUnverifiable stay separate variants. Two probes are needed because a single direction cannot distinguish 'candidate is older' from 'unrelated': is_ancestor(deployed, candidate) and is_ancestor(candidate, deployed) together give (true,true)=same, (true,false)=advance, (false,true)=superseded, (false,false)=unrelated. Equality is decided by SHA comparison BEFORE any probe, because it is the common no-op case and deserves neither a subprocess nor a chance to misclassify. Timestamps are explicitly NOT an input: wall-clock ordering of CI runs is exactly the signal that is already inverted, and commit dates are attacker- and rebase-controlled."

type DeployRevisionRelation
  = SameRevision
  | DeployedIsAncestor
  | CandidateIsAncestor
  | UnrelatedHistories
  | RelationUnverifiable { cause: NonEmptyStr }

data deploy_revision_probe_relation_note: String = "The (deployed→candidate, candidate→deployed) probe pair folded into a relation. SHA equality is checked first and short-circuits both probes. Note that (true,true) is reachable ONLY when the SHAs are equal — a commit is its own ancestor and ancestry is antisymmetric — so this arm is defensive rather than expected, and it agrees with the equality short-circuit instead of contradicting it."

fn deploy_revision_relation_from_probes(
  deployed: CommitSha,
  candidate: CommitSha,
  deployed_is_ancestor_of_candidate: Bool,
  candidate_is_ancestor_of_deployed: Bool,
) -> DeployRevisionRelation {
  if deployed == candidate {
    SameRevision
  } else {
    if deployed_is_ancestor_of_candidate {
      if candidate_is_ancestor_of_deployed { SameRevision } else { DeployedIsAncestor }
    } else {
      if candidate_is_ancestor_of_deployed { CandidateIsAncestor } else { UnrelatedHistories }
    }
  }
}

data deploy_decision_is_one_value_note: String = "ONE VALUE, NOT THREE PREDICATES. The previous shape exposed deploy_revision_proceeds / _terminal_success / _refuses as three independent Booleans over the verdict and left every caller to compose them correctly — which is the composition that never happened, so the module sat inert while the actuator mutated unguarded. A caller that reads only `proceeds` cannot distinguish 'nothing to do' from 'refuse', and nothing forces it to ask the other two.\\n\\nSo the decision is a single value whose arms ARE the three dispositions, and mutation requires the Advance arm's payload. Keep and Refuse differ in exit code and in what they emit, never in what they mutate: both perform zero deployment effects."

type KeepReason
  = AlreadyActive
  | CandidateSuperseded

type DeployRelationFailure
  = UnrelatedRevisionHistories
  | RevisionRelationUnverifiable { cause: NonEmptyStr }

data revision_advance_is_the_admission_note: String = "RevisionAdvance IS THE ADMISSION TOKEN, and it is `sole_constructor` so it cannot be forged from another module. That is the structural composition #7462 was missing: it landed a pure classifier and a witness file and changed no consumer, so 'the freshness precondition exists' was false at the system boundary — a function existed. Calling the classifier near the top of the apply path would repeat that mistake one level in, because the mutating cutover would remain independently callable and the guard would be a convention.\\n\\nInstead the cutover TAKES a RevisionAdvance. The only value of that type in the corpus comes out of decide_deploy_revision's Advance arm, so an unguarded mutation path does not typecheck. The wall consumed here is the existing cross-module `sole_constructor` refusal (SoleConstructorViolation) rather than a new checker; DESIGN §4b records that its completeness for every construction form is unverified, so the honest rung is accepted-refinement-with-executing-refusal, and the discriminating RED is the forge attempt from a foreign module."

data advance_predecessor_note: String = "THE PREDECESSOR IS A COPRODUCT, NOT A CommitSha, BECAUSE 'THE SLOT HAS NEVER RECORDED A REVISION' IS A REAL OBSERVATION AND NOT A MISSING ONE. On the first deploy after this lands, no slot carries a receipt — there is no prior revision, so there is no ancestry question and monotonicity is vacuous rather than violated. Spelling that as AdvanceFromUnrecordedSlot keeps it distinguishable from an ordinary advance in every downstream reader, so the rate at which deploys take the bootstrap arm stays observable.\\n\\nWHAT THIS TYPE MAKES UNWRITABLE, which is the whole reason it is a separate carrier from ObservedDeployedRevision: there is no arm here for an UNREADABLE receipt. 'I could not read the routed slot's revision' and 'the routed slot has recorded no revision' are the DESIGN §5 ⊥-as-ignorance / ⊥-as-answer pair, and only the second can become an admission. The first has no constructor into this type at all, so an unreadable receipt cannot be laundered into a deploy — it is refused by the shape rather than by a check that a later edit could drop.\\n\\nWHY THE BOOTSTRAP ARM CANNOT SILENTLY BECOME PERMANENT: the receipt write is inside the converged path, so a slot that fails to record its revision makes the deploy NotConverged and red. 'Unrecorded forever' therefore cannot happen quietly — it would have to survive a red on every single deploy.\\n\\n🟡 dissolve-on: the served process publishing the immutable identity it was launched with (deploy_slot_revision_receipt_note's own trigger). Once the routed slot always states a revision, this arm becomes unreachable and its witness flips from a bootstrap acceptance to a permanent regression control rather than retiring."

type AdvancePredecessor
  = AdvanceFromRevision { revision: CommitSha }
  | AdvanceFromUnrecordedSlot

type RevisionAdvance sole_constructor {
  from: AdvancePredecessor
  to: CommitSha
}

type DeployDecision
  = Keep { reason: KeepReason }
  | Advance { admission: RevisionAdvance }
  | Refuse { cause: DeployRelationFailure }

data observed_deployed_revision_note: String = "THE THREE THINGS THE ROUTED SLOT CAN SAY, kept apart because two of them are answers and one is an admission of ignorance. Recorded carries the revision the slot last converged to. Unrecorded means the receipt does not exist — a determinate fact about a slot that has never completed a deploy under this scheme. Unreadable means the read itself failed (permissions, I/O, a malformed receipt), which is NOT 'no revision' and must never be folded into it: collapsing them is exactly the absorbing shape that lets a broken observation present as a clean slate and re-admit an arbitrary tree.\\n\\nThe malformed case belongs with the failure arm rather than with Unrecorded for the same reason. A receipt whose contents are not a commit sha means something wrote it wrongly, and answering 'then nothing is deployed' would let a corrupted receipt authorize a deploy that monotonicity would otherwise have refused."

type ObservedDeployedRevision
  = DeployedRevisionRecorded { revision: CommitSha }
  | DeployedRevisionUnrecorded
  | DeployedRevisionUnreadable { cause: NonEmptyStr }

data deploy_decision_superseded_is_success_note: String = "A SUPERSEDED CANDIDATE EXITS ZERO, and that is a correctness requirement rather than leniency. A naive guard refuses everything that is not a strict descendant, which turns the ORDINARY case — an older run finishing after a newer one — into a red. That fires on every rapid push pair, so it trains the operator to ignore deploy failures, which is the opposite of a safety property (operator ruling 2026-07-30). CandidateIsAncestor means a NEWER revision is already live: the fleet is in a strictly better state than this run would have produced, so there is nothing to do and nothing to report as failure.\\n\\nUnrelatedHistories and RelationUnverifiable are the only refusals. Refusing on unverifiable is the fail-closed direction: 'I could not determine whether this is newer' is NOT 'this is newer', and collapsing the two is the absorbing-fallback shape DESIGN §5 forbids.\\n\\nA SCHEDULER CANCELLATION IS NOT A DEPLOYMENT VERDICT. SchedulerCancelled(candidate) ≠ Keep{CandidateSuperseded}: the second is an observed ancestry fact, the first means only that GitHub removed a job. Nothing in this module may be produced from a cancellation, which is why the cancellation law lives on the queue side (a candidate may be discarded only when another surviving work item is proven to subsume it) and pending-replacement provides no such proof."

fn decide_deploy_revision(
  deployed: CommitSha,
  candidate: CommitSha,
  relation: DeployRevisionRelation,
) -> DeployDecision {
  match relation {
    SameRevision => Keep { reason: AlreadyActive }
    CandidateIsAncestor => Keep { reason: CandidateSuperseded }
    DeployedIsAncestor =>
      Advance {
        admission: RevisionAdvance {
          from: AdvanceFromRevision { revision: deployed },
          to: candidate,
        }
      }
    UnrelatedHistories => Refuse { cause: UnrelatedRevisionHistories }
    RelationUnverifiable { cause: why } => Refuse { cause: RevisionRelationUnverifiable { cause: why } }
  }
}

data decide_for_observation_is_the_only_entry_note: String = "THE ONLY WAY INTO A DECISION FROM A LIVE OBSERVATION, and it is total over ObservedDeployedRevision so a new observation arm cannot be added without stating its disposition. The ancestry probes are supplied by the caller because they are effects, but they are only CONSULTED on the Recorded arm — the other two arms decide without reference to them, so a caller that cannot run the probes (because there is nothing to compare against) has nothing to fabricate.\\n\\nThis is the composition #7462 lacked. decide_deploy_revision alone still leaves 'what if the slot said nothing' to each caller's judgment, and a caller answering that question locally is a second decision authority — the fork DESIGN §3 forbids, in the one place where getting it wrong redeploys an arbitrary tree."

fn decide_deploy_for_observation(
  observed: ObservedDeployedRevision,
  candidate: CommitSha,
  deployed_is_ancestor_of_candidate: Bool,
  candidate_is_ancestor_of_deployed: Bool,
) -> DeployDecision {
  match observed {
    DeployedRevisionRecorded { revision: deployed } =>
      decide_deploy_revision(
        deployed: deployed,
        candidate: candidate,
        relation: deploy_revision_relation_from_probes(
          deployed: deployed,
          candidate: candidate,
          deployed_is_ancestor_of_candidate: deployed_is_ancestor_of_candidate,
          candidate_is_ancestor_of_deployed: candidate_is_ancestor_of_deployed,
        ),
      )
    DeployedRevisionUnrecorded =>
      Advance {
        admission: RevisionAdvance {
          from: AdvanceFromUnrecordedSlot,
          to: candidate,
        }
      }
    DeployedRevisionUnreadable { cause: why } =>
      Refuse { cause: RevisionRelationUnverifiable { cause: why } }
  }
}

data advance_predecessor_text_note: String = "The predecessor rendered for the deploy's own log line. The bootstrap arm says so in words rather than printing an empty or zero sha, because a reader who cannot tell 'advancing from nothing' from 'advancing from 0000…' is exactly the reader who will not notice the bootstrap arm firing on every deploy."

fn advance_predecessor_text(from: AdvancePredecessor) -> String {
  match from {
    AdvanceFromRevision { revision: r } => r as String
    AdvanceFromUnrecordedSlot => "(no revision recorded for the routed slot)"
  }
}

fn deploy_advance_text(admission: RevisionAdvance) -> NonEmptyStr {
  join(
    [
      "deploy advancing srv1 dashboard from ",
      advance_predecessor_text(from: admission.from),
      " to ",
      admission.to as String,
    ],
    ""
  ) as NonEmptyStr
}

fn deploy_relation_failure_reason(cause: DeployRelationFailure) -> NonEmptyStr {
  match cause {
    UnrelatedRevisionHistories =>
      "deployed and candidate revisions share no ancestry (force-push, rewritten history, or foreign repository) — refusing rather than guessing which is newer" as NonEmptyStr
    RevisionRelationUnverifiable { cause: why } => why
  }
}

data deploy_keep_reason_text_note: String = "Keep is COUNTED, not silent. A no-op that reports nothing is indistinguishable from a deploy that never ran, and the whole point of the four-case split is that a superseded run leaves the fleet healthy — so the rate at which candidates are superseded has to stay observable, or the liveness half loses its only signal that ordering inversion is still happening."

fn deploy_keep_reason_text(reason: KeepReason) -> NonEmptyStr {
  match reason {
    AlreadyActive =>
      "deploy no-op: the routed slot already serves this exact revision" as NonEmptyStr
    CandidateSuperseded =>
      "deploy no-op: a newer revision is already routed, so this candidate is superseded" as NonEmptyStr
  }
}
