// THE HOST'S SIDE OF THE RECONCILE, read by the evaluator that plans the deploy so the decision and
// the mutation are one evaluation (operator direction, 2026-09-06: one semantic evaluation per
// convergence transaction; nothing here starts a second evaluator on the host). Each observation is
// ONE interface with TWO realizations, which is DESIGN section 3's rule for transport: when the
// executor is the host (LocalShell) the read is the tool's own typed operation -- extdeps.git.inspect,
// extdeps.crypto.hash, extdeps.systemd.systemctl, extdeps.filesystem, extdeps.shell -- and when the
// host is behind ssh the same invocation goes as argv through gunbc.host.host_effect_realize
// run_typed_argv_transport, which rightly refuses LocalShell because it has no remote target. The
// argv builders and the operations spell one invocation each; that pair is the extdeps seam every
// shell-transported operation carries today, and it folds when an operation's transport row can be
// read back.
type ObservationArm
  = OnTheHostItself
  | OverTransport { transport: HostEffectTransport }

fn observation_arm(transport: HostEffectTransport) -> ObservationArm {
  match transport {
    LocalShell => OnTheHostItself
    SshShell { ssh_host: _ } => OverTransport { transport: transport }
    FleetSsh { target: _, context: _ } => OverTransport { transport: transport }
    EmitArtifactThenThinRun { bootstrap: _, invocation: _ } => OverTransport { transport: transport }
  }
}

// A REMOTE LEG: one argv, its stdout on exit zero, a typed refusal otherwise.
type Leg
  = LegOut { stdout: String }
  | LegRefused { cause: String }

fn remote_leg(transport: HostEffectTransport, argv: List<String>, leg: String) -> Leg {
  match run_typed_argv_transport(argv: argv, transport: transport) {
    TypedArgvExecRefused { reason } => LegRefused { cause: join([leg, ": ", reason], "") }
    TypedArgvExecConverged { result: r } =>
      if r.exit_code != 0 { LegRefused { cause: join([leg, " failed (exit ", to_string(value: r.exit_code), "): ", r.stderr], "") } }
      else { LegOut { stdout: r.stdout } }
  }
}

fn leg_of(success: Bool, stdout: String, stderr: String, leg: String) -> Leg {
  if success { LegOut { stdout: stdout } } else { LegRefused { cause: join([leg, " failed: ", stderr], "") } }
}

// ABSENCE IS ESTABLISHED BY A SUCCESSFUL LISTING OF THE PARENT, never by a failed read of the child
// (extdeps.filesystem.filesystem_io's rule). Locally that is the modeled listing observation; over a
// transport it is `ls -1 -A` of the parent and membership of the basename in its lines.
//
// AN ABSENT ANCESTOR ESTABLISHES ABSENCE TOO. On a host that has never been deployed the executable's
// parent directory does not exist, so listing it refuses -- and the first cut read that refusal as
// indeterminate and refused the whole plan before the effect that creates the directory could run
// (review on PR #10696). A listing that refuses is followed by the presence question one level up:
// an ancestor that is itself absent (established by listing ITS parent) means the child is absent;
// an ancestor that is present but cannot be listed is a real refusal and stays indeterminate. The
// walk is bounded by the path's depth and stops at the root, which is listed directly.
type EntryPresence
  = EntryPresent
  | EntryAbsent
  | EntryPresenceIndeterminate { cause: String }

fn path_parent(path: String) -> String {
  let parts = split(s: path, delimiter: "/")
  let kept = fold(parts, init: ParentWalk { count: count(parts), at: 0, acc: [] }, f: (acc, seg) =>
    ParentWalk { count: acc.count, at: acc.at + 1, acc: if acc.at + 1 < acc.count { concat(acc.acc, [seg]) } else { acc.acc } })
  let joined = join(kept.acc, "/")
  if joined == "" { "/" } else { joined }
}

type ParentWalk {
  count: Int
  at: Int
  acc: List<String>
}

fn path_basename(path: String) -> String {
  fold(split(s: path, delimiter: "/"), init: "", f: (acc, seg) => if seg == "" { acc } else { seg })
}

// THE TWO PURE HALVES OF A TRANSPORT LISTING, named so a caller that must supply its OWN transport
// consumes them rather than re-minting them. The elevated arms of the fleet converges cannot use
// entry_presence itself -- it reaches the far side as the bootstrap principal, and a root:root 0700
// parent refuses that listing -- but the argv and the membership read are the same facts whichever
// principal runs them, and two copies of a membership predicate can drift into two answers about
// one question (DESIGN §2: net concepts must not grow by re-invention).
fn parent_listing_argv(parent: String) -> List<String> {
  ["ls", "-1", "-A", "--", parent]
}

fn listing_contains_entry(stdout: String, name: String) -> Bool {
  any(split(s: stdout, delimiter: "\n"), entry => entry == name)
}

fn entry_presence_in_parent(arm: ObservationArm, parent: String, name: String) -> EntryPresence {
  match arm {
    OnTheHostItself => {
      let listing = Filesystem.List(path: parent)
      match filesystem_entry_presence(
        listing: filesystem_listing_observation(directory: parent, success: listing.success, entries: listing.entries, error: listing.error),
        name: name,
      ) {
        FilesystemEntryAbsent(_) => EntryAbsent
        FilesystemEntryListed { directory: _, name: _ } => EntryPresent
        FilesystemEntryPresenceIndeterminate { cause } => EntryPresenceIndeterminate { cause: cause }
        FilesystemEntrySubjectRefused { directory: _, name: _, cause } => EntryPresenceIndeterminate { cause: cause }
      }
    }
    OverTransport { transport } => match remote_leg(transport: transport, argv: parent_listing_argv(parent: parent), leg: join(["listing ", parent], "")) {
      LegRefused { cause } => EntryPresenceIndeterminate { cause: cause }
      LegOut { stdout } => if listing_contains_entry(stdout: stdout, name: name) { EntryPresent } else { EntryAbsent }
    }
  }
}

fn entry_presence(arm: ObservationArm, path: String) -> EntryPresence {
  entry_presence_above(arm: arm, path: path, below: Absent)
}

// The ancestor walk in tail position, so the Rust realization lowers it to a loop. `below` is the
// cause read one level down: an ancestor that is present answers with that cause, an absent one
// answers absent, and the root answers with its own cause -- the same answers the nested walk gave.
fn entry_presence_above(arm: ObservationArm, path: String, below: Optional<String>) -> EntryPresence {
  let parent = path_parent(path: path)
  let name = path_basename(path: path)
  match entry_presence_in_parent(arm: arm, parent: parent, name: name) {
    EntryPresent => match below {
      Absent => EntryPresent
      Present { value: cause } => EntryPresenceIndeterminate { cause: cause }
    }
    EntryAbsent => EntryAbsent
    EntryPresenceIndeterminate { cause } =>
      if parent == "/" {
        EntryPresenceIndeterminate { cause: cause }
      } else {
        entry_presence_above(arm: arm, path: parent, below: Present { value: cause })
      }
  }
}

// THE EXECUTABLE: the host's own sha256 of the installed file (coreutils sha256sum, cited in
// extdeps.crypto.hash), read the same way on both arms and parsed once.
fn sha256_leg(arm: ObservationArm, path: String) -> Leg {
  match arm {
    OnTheHostItself => {
      let r = crypto.Sha256Sum.File(path: path)
      leg_of(success: r.success, stdout: r.line, stderr: r.stderr, leg: join(["sha256sum ", path], ""))
    }
    OverTransport { transport } => remote_leg(transport: transport, argv: sha256sum_argv(path: path), leg: join(["sha256sum ", path], ""))
  }
}

fn observe_executable(arm: ObservationArm, path: String) -> ObservedMember {
  match entry_presence(arm: arm, path: path) {
    EntryPresenceIndeterminate { cause } => MemberUnobservable { member: Executable, cause: cause }
    EntryAbsent => MemberAbsentOnHost { member: Executable }
    EntryPresent => match sha256_leg(arm: arm, path: path) {
      LegRefused { cause } => MemberUnobservable { member: Executable, cause: cause }
      LegOut { stdout } => match sha256sum_line_digest(line: stdout) {
        Absent => MemberUnobservable { member: Executable, cause: join(["sha256sum output is not a digest line: ", stdout], "") }
        Present { value: digest } => MemberObserved { identity: ExecutableIdentity { digest: digest } }
      }
    }
  }
}

// The release's executable is the deploying checkout's build, the same source the install step
// copies from; its digest is read where the evaluator runs, whatever transport the host is behind.
// The emitter verifies the source against this digest again immediately before the copy, so a build
// that changes between planning and actuation stops the line rather than installing under a stale
// identity (gunbc.live_deploy.emit emit_release_member_effects).
data release_executable_source_path: String = concat(cargo_default_release_dir_rel, "/gunbc")

fn desired_executable() -> ObservedMember {
  observe_executable(arm: OnTheHostItself, path: release_executable_source_path)
}

// THE UNIT FILE: the installed document's content hash.
//
// ONE LEG, TWO STANDING POLICIES OVER ABSENCE, because two members read unit documents for different
// reasons. observe_unit_file has ALREADY established presence via entry_presence before calling, so a
// document missing at read time contradicts the listing -- that IS a refusal, with the contradiction
// named. The repository-shared-posture member has no such prior: the two maintenance units are
// installed BY THAT MEMBER, so on a host that never ran it absence is the expected standing, the same
// re-writable standing as an unset config key -- it moves the digest and the member re-asserts. A
// single policy could not serve both: forcing the refusal policy is what killed the re-root's first
// fresh-lab deploy (absent units refused the plan), and forcing the standing policy would let the
// serve unit's listing-and-read contradiction pass as a standing.
type UnitDocumentAbsence
  = AbsentContradictsListing
  | AbsentIsTheStanding

fn unit_document_leg(arm: ObservationArm, path: String, absent: UnitDocumentAbsence) -> Leg {
  match arm {
    OnTheHostItself => {
      let parent = path_parent(path: path)
      let listing = Filesystem.List(path: parent)
      let read = Filesystem.Read(path: path)
      match filesystem_file_observation(
        listing: filesystem_listing_observation(directory: parent, success: listing.success, entries: listing.entries, error: listing.error),
        name: path_basename(path: path),
        path: path,
        read: filesystem_read_outcome(content: read.content, success: read.success, error: read.error),
      ) {
        FilesystemFileRead { path: _, content } => LegOut { stdout: content }
        FilesystemFileAbsent(_) => match absent {
          AbsentContradictsListing => LegRefused { cause: join([path, " vanished between listing and read"], "") }
          AbsentIsTheStanding => LegOut { stdout: posture_missing_sentinel }
        }
        FilesystemFileIndeterminate { cause } => match absent {
          AbsentContradictsListing => LegRefused { cause: cause }
          AbsentIsTheStanding => LegRefused { cause: join(["reading ", path, ": ", cause], "") }
        }
        FilesystemFileObservationsDisagree { path: _, cause } => match absent {
          AbsentContradictsListing => LegRefused { cause: cause }
          AbsentIsTheStanding => LegRefused { cause: join(["reading ", path, ": ", cause], "") }
        }
        FilesystemFileSubjectRefused { directory: _, name: _, cause } => match absent {
          AbsentContradictsListing => LegRefused { cause: cause }
          AbsentIsTheStanding => LegRefused { cause: join(["reading ", path, ": ", cause], "") }
        }
      }
    }
    OverTransport { transport } => remote_leg(transport: transport, argv: ["cat", "--", path], leg: join(["reading ", path], ""))
  }
}

fn observe_unit_file(arm: ObservationArm, spec: DeploymentSpec) -> ObservedMember {
  let unit = spec.service.unit_name
  let path = deployment_systemd_unit_path(names: spec.names) as String
  match entry_presence(arm: arm, path: path) {
    EntryPresenceIndeterminate { cause } => MemberUnobservable { member: UnitFile, cause: cause }
    EntryAbsent => MemberAbsentOnHost { member: UnitFile }
    EntryPresent => match unit_document_leg(arm: arm, path: path, absent: AbsentContradictsListing) {
      LegRefused { cause } => MemberUnobservable { member: UnitFile, cause: cause }
      LegOut { stdout: document } =>
        MemberObserved { identity: UnitFileAt { file: UnitFileIdentity { unit: unit, document: content_hash_atom(value: document as NonEmptyStr) } } }
    }
  }
}

fn desired_unit_file(spec: DeploymentSpec, candidate: CandidateRelease, now_epoch: Second?) -> MemberIdentity {
  UnitFileAt { file: UnitFileIdentity {
    unit: spec.service.unit_name,
    document: content_hash_atom(value: live_deploy_systemd_unit_for(spec: spec, revision: RevisionBoundAtEmission { revision: candidate.revision }, now_epoch: now_epoch) as NonEmptyStr),
  } }
}

fn observe_oidc_config_file(arm: ObservationArm, spec: DeploymentSpec) -> ObservedMember {
  match tracker_web_oidc_serve_placement(instance_id: spec.instance_id) {
    TrackerWebOidcPlacementUnassigned { instance_id: _ } => MemberAbsentOnHost { member: OidcConfigFile }
    TrackerWebOidcPlacementUnbound { instance_id: _, reason: _ } => MemberAbsentOnHost { member: OidcConfigFile }
    TrackerWebOidcPlacementMissingRealization { instance_id: _, environment: _ } => MemberAbsentOnHost { member: OidcConfigFile }
    TrackerWebOidcServeReady { config: cfg } => {
      let path = cfg.config_path as String
      match entry_presence(arm: arm, path: path) {
        EntryPresenceIndeterminate { cause } => MemberUnobservable { member: OidcConfigFile, cause: cause }
        EntryAbsent => MemberAbsentOnHost { member: OidcConfigFile }
        EntryPresent => match unit_document_leg(arm: arm, path: path, absent: AbsentContradictsListing) {
          LegRefused { cause } => MemberUnobservable { member: OidcConfigFile, cause: cause }
          LegOut { stdout: document } =>
            MemberObserved { identity: OidcConfigAt { file: OidcConfigFileIdentity {
              path: cfg.config_path,
              document: content_hash_atom(value: document as NonEmptyStr),
            } } }
        }
      }
    }
  }
}

fn desired_oidc_config_file(cfg: TrackerWebOidcServeConfig) -> MemberIdentity {
  OidcConfigAt { file: OidcConfigFileIdentity {
    path: cfg.config_path,
    document: content_hash_atom(value: tracker_web_oidc_config_document(cfg: cfg) as NonEmptyStr),
  } }
}

// THE MANAGER: systemd's own answer to whether the loaded unit matches the file on disk. The wire
// values are `yes` and `no` (measured on srv1, 2026-09-06, for a loaded unit and for a not-found
// one, which also answers `no`); anything else is a vocabulary the model does not know and refuses.
fn manager_standing_leg(arm: ObservationArm, unit: NonEmptyStr) -> Leg {
  match arm {
    OnTheHostItself => {
      let r = systemd.Systemctl.ShowProperty(unit: unit, property: systemd_unit_property_wire(property: NeedDaemonReload))
      leg_of(success: r.success, stdout: r.value, stderr: "systemctl show failed", leg: join(["systemctl show NeedDaemonReload ", unit as String], ""))
    }
    OverTransport { transport } => remote_leg(transport: transport, argv: ["systemctl", "show", unit as String, "--property=NeedDaemonReload", "--value"], leg: join(["systemctl show NeedDaemonReload ", unit as String], ""))
  }
}

fn observe_unit_manager(arm: ObservationArm, unit: NonEmptyStr) -> ObservedMember {
  match manager_standing_leg(arm: arm, unit: unit) {
    LegRefused { cause } => MemberUnobservable { member: UnitManager, cause: cause }
    LegOut { stdout: raw } => {
      let answer = trim(s: raw)
      if answer == "no" { MemberObserved { identity: UnitManagerAt { standing: ManagerLoadedCurrent } } }
      else if answer == "yes" { MemberObserved { identity: UnitManagerAt { standing: ManagerNeedsReload } } }
      else { MemberUnobservable { member: UnitManager, cause: join(["NeedDaemonReload is neither yes nor no: ", answer], "") } }
    }
  }
}

fn desired_unit_manager() -> MemberIdentity {
  UnitManagerAt { standing: ManagerLoadedCurrent }
}

// THE PROCESS: its ActiveState from the manager and, when Active, the release it reports over
// /healthz through the same probe readiness uses (gunbc.live_deploy.readiness), read through
// gunbc.running_release_identity so a body the identity channel cannot decode refuses here with the
// same cause readiness would give. An Active process that cannot be probed is unobservable, not
// stale: refusing is the honest answer, and a plan that restarted it would be acting on a guess.
fn active_state_leg(arm: ObservationArm, unit: NonEmptyStr) -> Leg {
  match arm {
    OnTheHostItself => {
      let r = systemd.Systemctl.ShowProperty(unit: unit, property: systemd_unit_property_wire(property: ActiveState))
      leg_of(success: r.success, stdout: r.value, stderr: "systemctl show failed", leg: join(["systemctl show ActiveState ", unit as String], ""))
    }
    OverTransport { transport } => remote_leg(transport: transport, argv: ["systemctl", "show", unit as String, "--property=ActiveState", "--value"], leg: join(["systemctl show ActiveState ", unit as String], ""))
  }
}

// THE ACTIVE STATE TRAVELS WITH THE ANSWER, because the two together are the incident's shape:
// Active and answering-503 is a service the manager believes in and the network says is not
// serving, which is a different thing from Failed-and-silent. A restart policy makes that pair the
// normal look of a crash-loop, and the pair is what decide_member judges.
fn running_process_identity(active: SystemdUnitActiveState, spec: DeploymentSpec, transport: HostEffectTransport) -> ObservedMember {
  match live_deploy_healthz_get_for_port(port: deployment_plan_listen_port(spec: spec), spec: spec, transport: transport) {
    HealthzProbeRefused { probe_error } => MemberUnobservable { member: ServiceProcess, cause: join(["the process is active but /healthz refused: ", probe_error], "") }
    // THE ARM THE LEDGER'S THIRD OCCURRENCE TURNED ON. systemd said Active (a service in a
    // restart-flurry is Active) and /healthz ANSWERED, and the pair was reported as "could not
    // observe the host" -- the same arm as an unreachable host -- so decide_member refused and the
    // only modeled route to repair the service required the service to be healthy. It was observed:
    // what was observed was that it is not serving. That is a fact the plan may act on, and it is
    // not an inability to look (the annotation above this function's caller's own words: an Active
    // process that cannot be probed is unobservable, NOT stale -- and this one could be probed).
    // Whether it means a replacement is decide_member's domain assessment, over the member's own
    // revision; nothing is decided here (DESIGN 6b, D14).
    HealthzAnsweredUnhealthy { status, detail } =>
      MemberObserved { identity: ProcessAt { process: ProcessObservedUnhealthy { active: active, status: status, detail: detail } } }
    HealthzBodyRead { body } => match observe_running_release_identity(healthz_body: body) {
      RunningReleaseUnidentified { cause } =>
        MemberUnobservable { member: ServiceProcess, cause: healthz_refusal_reason(cause: healthz_release_identity_refusal(body: body, cause: cause)) }
      RunningReleaseIdentified { observation } =>
        MemberObserved { identity: ProcessAt { process: ProcessRunningRelease { revision: observation.revision } } }
    }
  }
}

fn observe_service_process(spec: DeploymentSpec, transport: HostEffectTransport) -> ObservedMember {
  let arm = observation_arm(transport: transport)
  match active_state_leg(arm: arm, unit: spec.service.unit_name) {
    LegRefused { cause } => MemberUnobservable { member: ServiceProcess, cause: cause }
    LegOut { stdout: raw } => match parse_systemd_unit_active_state(raw: trim(s: raw)) {
      Absent => MemberUnobservable { member: ServiceProcess, cause: join(["ActiveState not in the systemd vocabulary: ", trim(s: raw)], "") }
      Present { value: active } => match active {
        Active => running_process_identity(active: active, spec: spec, transport: transport)
        Inactive => MemberObserved { identity: ProcessAt { process: ProcessNotRunning { active: active } } }
        Activating => MemberObserved { identity: ProcessAt { process: ProcessNotRunning { active: active } } }
        Deactivating => MemberObserved { identity: ProcessAt { process: ProcessNotRunning { active: active } } }
        Reloading => MemberObserved { identity: ProcessAt { process: ProcessNotRunning { active: active } } }
        Failed => MemberObserved { identity: ProcessAt { process: ProcessNotRunning { active: active } } }
      }
    }
  }
}

fn desired_service_process(candidate: CandidateRelease) -> MemberIdentity {
  ProcessAt { process: ProcessRunningRelease { revision: candidate.revision } }
}

// THE PUBLISHED TREE: HEAD, then the three-leg tracked-projection comparison the deployed-tree record
// established as the instrument (read-tree into a private index, status against it, ignored paths),
// reusing its argv builders and its reading so two observers cannot disagree about what clean means.
//
// THE PRIVATE INDEX IS A SCRATCH FILE THE OBSERVATION OWNS: minted by mktemp so two observations --
// of the same release, under two principals, from the workflow and the operator path at once --
// never share a path or a lock, and removed after the reads on every arm, including the refusing
// ones. The first cut used one fixed path per revision under /tmp and never removed it, and declared
// the write readonly (review on PR #10696). The scratch's creation and removal are effects and are
// modeled as such (extdeps.shell shell.Mktemp, extdeps.filesystem Filesystem.Delete, coreutils rm -f
// over a transport); a scratch that could not be removed refuses the observation, because an
// observation that leaves state on the host has not finished.
fn head_leg(arm: ObservationArm, repo: String) -> Leg {
  match arm {
    OnTheHostItself => {
      let r = git.Inspect.HeadCommitIn(repository_path: repo)
      leg_of(success: r.success, stdout: r.sha, stderr: r.stderr, leg: "head")
    }
    OverTransport { transport } => remote_leg(transport: transport, argv: deployed_tree_revision_argv(repo: repo as NonEmptyStr), leg: "head")
  }
}

type ScratchPath
  = ScratchAt { path: String }
  | ScratchRefused { cause: String }

data scratch_index_directory: String = "/tmp"

fn scratch_index(arm: ObservationArm) -> ScratchPath {
  match arm {
    OnTheHostItself => {
      let r = shell.Mktemp.FileInDirectory(dir: scratch_index_directory as FilePath)
      if r.success { ScratchAt { path: trim(s: r.path as String) } } else { ScratchRefused { cause: "mktemp for the scratch index failed" } }
    }
    OverTransport { transport } => match remote_leg(transport: transport, argv: ["mktemp", "-p", scratch_index_directory], leg: "scratch index") {
      LegRefused { cause } => ScratchRefused { cause: cause }
      LegOut { stdout } => ScratchAt { path: trim(s: stdout) }
    }
  }
}

fn scratch_release(arm: ObservationArm, path: String) -> Leg {
  match arm {
    OnTheHostItself => {
      let r = Filesystem.Delete(path: path)
      leg_of(success: r.success, stdout: "", stderr: r.error, leg: join(["scratch index removal ", path], ""))
    }
    OverTransport { transport } => remote_leg(transport: transport, argv: coreutils_rm_force_argv(paths: [path]), leg: join(["scratch index removal ", path], ""))
  }
}

fn read_tree_leg(arm: ObservationArm, repo: NonEmptyStr, revision_hex: String, index_path: String) -> Leg {
  match arm {
    OnTheHostItself => {
      let r = git.Inspect.ReadTreeIntoIndex(repository_path: repo as String, revision_hex: revision_hex, index_path: index_path)
      leg_of(success: r.success, stdout: "", stderr: r.stderr, leg: "index materialization")
    }
    OverTransport { transport } => remote_leg(transport: transport, argv: deployed_tree_read_tree_argv(repo: repo, revision_hex: revision_hex, index_path: index_path), leg: "index materialization")
  }
}

fn status_leg(arm: ObservationArm, repo: NonEmptyStr, index_path: String) -> Leg {
  match arm {
    OnTheHostItself => {
      let r = git.Inspect.StatusAgainstIndex(repository_path: repo as String, index_path: index_path)
      leg_of(success: r.success, stdout: r.entries_nul, stderr: r.stderr, leg: "worktree comparison")
    }
    OverTransport { transport } => remote_leg(transport: transport, argv: deployed_tree_status_argv(repo: repo, index_path: index_path), leg: "worktree comparison")
  }
}

fn ignored_leg(arm: ObservationArm, repo: NonEmptyStr, index_path: String) -> Leg {
  match arm {
    OnTheHostItself => {
      let r = git.Inspect.IgnoredAgainstIndex(repository_path: repo as String, index_path: index_path)
      leg_of(success: r.success, stdout: r.paths_nul, stderr: r.stderr, leg: "ignored deployed paths")
    }
    OverTransport { transport } => remote_leg(transport: transport, argv: deployed_tree_ignored_argv(repo: repo, index_path: index_path), leg: "ignored deployed paths")
  }
}

type ProjectionReading
  = ProjectionClean
  | ProjectionDirty
  | ProjectionUnreadable { cause: String }

fn projection_legs(arm: ObservationArm, repo: NonEmptyStr, revision_hex: String, index_path: String) -> ProjectionReading {
  match read_tree_leg(arm: arm, repo: repo, revision_hex: revision_hex, index_path: index_path) {
    LegRefused { cause } => ProjectionUnreadable { cause: cause }
    LegOut { stdout: _ } => match status_leg(arm: arm, repo: repo, index_path: index_path) {
      LegRefused { cause } => ProjectionUnreadable { cause: cause }
      LegOut { stdout: status } => match ignored_leg(arm: arm, repo: repo, index_path: index_path) {
        LegRefused { cause } => ProjectionUnreadable { cause: cause }
        LegOut { stdout: ignored } => match deployed_tree_content_reading(entries_nul: status, ignored_nul: ignored) {
          ContentUnreadable { detail } => ProjectionUnreadable { cause: detail }
          ContentRead { state: DeployedScopeMatchesCommit } => ProjectionClean
          ContentRead { state: DeployedScopeDiverged { changed_paths: _ } } => ProjectionDirty
        }
      }
    }
  }
}

// Mint, read, release, then answer: the reading is computed before the scratch is removed, and the
// removal's outcome is adjudicated before the reading is returned, so a leaked scratch cannot ride
// under a clean answer.
fn tracked_projection(arm: ObservationArm, repo: NonEmptyStr, revision_hex: String) -> ProjectionReading {
  match scratch_index(arm: arm) {
    ScratchRefused { cause } => ProjectionUnreadable { cause: cause }
    ScratchAt { path } => {
      let reading = projection_legs(arm: arm, repo: repo, revision_hex: revision_hex, index_path: path)
      match scratch_release(arm: arm, path: path) {
        LegRefused { cause } => ProjectionUnreadable { cause: join(["the observation left a scratch index behind: ", cause], "") }
        LegOut { stdout: _ } => reading
      }
    }
  }
}

fn tree_at(local: String, clean: Bool) -> ObservedMember {
  MemberObserved { identity: TreeIdentity { tree: TreePublicationIdentity { revision: local as CommitSha, tracked_projection_clean: clean } } }
}

fn observe_tree(arm: ObservationArm, spec: DeploymentSpec, candidate: CandidateRelease) -> ObservedMember {
  let repo = spec.service.repo_root
  let revision_hex = candidate.revision as String
  match entry_presence(arm: arm, path: repo as String) {
    EntryPresenceIndeterminate { cause } => MemberUnobservable { member: TreePublication, cause: cause }
    EntryAbsent => MemberAbsentOnHost { member: TreePublication }
    EntryPresent => match head_leg(arm: arm, repo: repo as String) {
      LegRefused { cause } => MemberUnobservable { member: TreePublication, cause: cause }
      LegOut { stdout: head } => {
        let local = trim(s: head)
        if local != revision_hex {
          tree_at(local: local, clean: false)
        } else {
          match tracked_projection(arm: arm, repo: repo, revision_hex: revision_hex) {
            ProjectionUnreadable { cause } => MemberUnobservable { member: TreePublication, cause: cause }
            ProjectionClean => tree_at(local: local, clean: true)
            ProjectionDirty => tree_at(local: local, clean: false)
          }
        }
      }
    }
  }
}

fn desired_tree(candidate: CandidateRelease) -> MemberIdentity {
  TreeIdentity { tree: TreePublicationIdentity { revision: candidate.revision, tracked_projection_clean: true } }
}

// THE DECISIONS ARE MAPPED FROM THE ROSTER, not assembled slot by slot. Naming each member on the
// left of an assignment made the roster and the decisions two lists an author had to keep in step;
// mapping the roster makes them one. Adding a member is a row in the roster and an arm in each of
// these two total functions -- the compiler names the arm it is missing, which a record of slots
// could not do because a slot left unwritten is a type error somewhere else entirely.
// THE ROOT ROSTER IS THE DEPLOYMENT'S DIRECTORY DEMANDS, not a list here and not the steps. Every
// directory the deployment creates is an owned-directory target in
// gunbc.live_deploy.spec deployment_directory_demands -- the instance's consumers' demands
// (gunbc.roadmap.dashboard_instance_directories) and the host's -- and each joins the roster as one
// DirectoryRoot, so the directories created and the directories read back are one list. The first
// roster read the dispatch roots and the compute root off the step kinds and the provider-state root
// off the spec, and left out every auth store, the event worktree and the inbox: the production route
// neither created nor read them back.
fn deployment_member_roster(spec: DeploymentSpec) -> List<ConvergedMember> {
  concat(
    concat(
      concat(
        release_member_roster(),
        map(deployment_directory_demands(spec: spec), t => DirectoryRoot { path: owned_directory_path(t: t) as String as NonEmptyStr }),
      ),
      deployment_git_worker_subtree_members(spec: spec),
    ),
    concat(
      deployment_oidc_config_members(spec: spec),
      deployment_repository_shared_posture_members(spec: spec),
    ),
  )
}

// THE WORKER-ROOT-EQUIVALENT-3 MEMBERS, GATED ON THE WORKER BEING A SEPARATE ACCOUNT. These exist
// because a SECOND POSIX identity -- the dedicated gunbc-worker -- has to be able to COMMIT into the
// instance's repository, and committing writes loose objects into existing fan-out directories, refs and
// reflogs. When the worker IS the service user (srv1_live, WorkerIsServiceUser) there is no second
// identity to grant to: the service user already owns the tree, and these members would be asserting a
// group-writeness nobody consumes -- worse, they would put writes into srv1_live's plan that its prod
// posture does not want. So the gate is exactly the discriminator: dedicated -> these members ride the
// roster; service-user -> the roster is byte-for-byte what it was before this slice (the prod-untouched
// claim). The path is derived from the instance row, never from a caller-supplied string, so no spec can
// claim a subtree by spelling one.
fn deployment_dedicated_worker_instance(spec: DeploymentSpec) -> Optional<HostDashboardInstance> {
  match dashboard_instance_for_id(instance_id: spec.instance_id as String) {
    DashboardInstanceForId { instance } =>
      match instance.worker {
        WorkerDedicatedAccount => Present { value: instance }
        WorkerIsServiceUser => none
      }
    DashboardInstanceIdUnknown { instance_id: _ } => none
  }
}

fn deployment_git_worker_subtree_members(spec: DeploymentSpec) -> List<ConvergedMember> {
  match deployment_dedicated_worker_instance(spec: spec) {
    none => []
    Present { value: instance } =>
      map(
        dashboard_git_worker_directory_children,
        child => GitWorkerSubtree {
          path: dashboard_git_worker_subtree_path(instance: instance, child: child) as NonEmptyStr,
          child: child,
        },
      )
  }
}

fn deployment_repository_shared_posture_members(spec: DeploymentSpec) -> List<ConvergedMember> {
  match deployment_dedicated_worker_instance(spec: spec) {
    none => []
    Present { value: instance } => [RepositorySharedPosture { path: instance.repo_root as NonEmptyStr }]
  }
}

// ONE SUBTREE, READ AS ITS INTERIORS: the model's own bounded walk (extdeps.tools.findutils
// find_subtree_mode_readback_command, the same command the migration's readback and the claims use) run
// under the deploy principal, then decided by the model's OWN grantedness fold
// dashboard_git_subtree_readback_is_granted -- so the observer, the apply and the claims cannot drift
// into disagreeing about what "granted" means, because they call the same function. THE STANDING IS
// BINARY ON PURPOSE: converged when the fold passes, needs-regroup when it does not -- INCLUDING a
// receipt that came back empty or a top not yet created, because the fix for "absent" and for
// "present-but-wrong" is the same idempotent re-group + additive sweep, and the sweep fragment runs
// AFTER the sibling DirectoryRoot's install created the top (fragment injection order). Only a read that
// could not be attempted at all (transport refused, process not spawned) is MemberUnobservable: that
// refuses the derivation rather than silently planning a re-group on a host we could not look at.
//
// THE GROUP IS THE DECLARED TOKEN: the fold compares find's `%g` against fleet_posix_worker_shared_group_name,
// the one row production grants and proves under. This is the PRODUCTION route (DESIGN 3 pairing): a wet
// witness that groups a throwaway tree to a token its own host resolves passes that token to the fold
// directly, and keeps this production spelling executed so the substituted value is never the only route.
fn observe_git_worker_subtree(arm: ObservationArm, instance: HostDashboardInstance, path: String, child: NonEmptyStr) -> ObservedMember {
  let member = GitWorkerSubtree { path: path as NonEmptyStr, child: child }
  match subtree_readback_leg(arm: arm, instance: instance, child: child) {
    SubtreeReadUnobservable { cause } => MemberUnobservable { member: member, cause: cause }
    SubtreeReadOut { receipt } =>
      if dashboard_git_subtree_readback_is_granted(child: child, group: fleet_posix_worker_shared_group_name, receipt: receipt) {
        MemberObserved { identity: GitWorkerSubtreeAt { path: path as NonEmptyStr, child: child, standing: SubtreeConverged } }
      } else {
        MemberObserved { identity: GitWorkerSubtreeAt { path: path as NonEmptyStr, child: child, standing: SubtreeNeedsRegroup { observed: subtree_receipt_note(receipt: receipt) } } }
      }
  }
}

type SubtreeRead
  = SubtreeReadOut { receipt: String }
  | SubtreeReadUnobservable { cause: String }

// THE LOCAL ARM runs find directly (the deploy principal is the instance's directory owner, which is a
// member of the attempt group and can already read every entry -- so this needs no privilege the deploy
// does not have; a find that cannot read a dir prints what it can and exits nonzero, and an unreadable
// top is simply a not-yet-granted tree, decided by the fold, not an unobservable). The REMOTE ARM sends
// the same argv through the transport; if the transport refuses a token (the portable-allowlist refusal)
// the read is honestly unobservable rather than faked.
fn subtree_readback_leg(arm: ObservationArm, instance: HostDashboardInstance, child: NonEmptyStr) -> SubtreeRead {
  let command = find_subtree_mode_readback_command(
    target: dashboard_git_worker_subtree_path(instance: instance, child: child),
    pruned: dashboard_git_worker_subtree_confined_children(child: child),
    depth: dashboard_git_worker_subtree_walk_depth,
  )
  match arm {
    OnTheHostItself =>
      match run_shell_command_observe_outcome(command: command, transport: LocalExec) {
        ProcessNotSpawned { program: _, cause } => SubtreeReadUnobservable { cause: cause as String }
        ProcessRan { observation: o } => SubtreeReadOut { receipt: o.stdout }
      }
    OverTransport { transport } =>
      match run_typed_argv_transport(argv: command.arguments, transport: transport) {
        TypedArgvExecRefused { reason } => SubtreeReadUnobservable { cause: reason }
        TypedArgvExecConverged { result: r } => SubtreeReadOut { receipt: r.stdout }
      }
  }
}

// A BOUNDED NOTE about what the receipt said, for the refusal text and the stale-plan fingerprint. A
// converged vs needs-regroup distinction does not need the WHOLE find printout (which could be thousands
// of fan-out lines) carried into a fingerprint -- it needs enough to say, in a refusal, roughly how much
// the host held. The line count and whether the top appeared is that summary; it is derived, not a
// copy of the raw bytes.
fn subtree_receipt_note(receipt: String) -> NonEmptyStr {
  let lines = filter(split(s: receipt, delimiter: "\n"), l => trim(s: l) != "")
  join(["lines=", to_string(value: length(lines))], "") as NonEmptyStr
}

// THE REPOSITORY POSTURE, READ AS ONE DOCUMENT. The same five things the deploy writes -- three local
// config keys and the two maintenance unit files -- are read back from the host in the order that builds
// the document (git asks for each key via extdeps.git's typed read, mirroring repo_local_git_config's
// ConfigLocalGetInRepo read; the two unit files are read through the SAME leg the UnitFile member uses),
// laid out by the shared dashboard_git_shared_repository_posture_document, and hashed to one digest.
// Comparing that digest to the desired digest (declared pairs + declared unit serializations, hashed the
// same way) decides the standing. If a key is missing, git reports a different value, a unit drifted on
// disk, or an extra unit appeared, the digest moves and the member re-asserts -- all five at once, because
// they are one obligation. A read that cannot be attempted at all is MemberUnobservable.
//
// WHY READ EVERYTHING RATHER THAN TRUSTING A WRITER: writing and believing is the failure this slice
// exists to kill. The posture member's readback is independent of the write -- the observer does not know
// or care whether a prior deploy wrote the keys; it asks git and the filesystem and decides from the
// answer, exactly like the UnitFile member does not trust that a unit is installed because a step ran.
fn observe_repository_shared_posture(arm: ObservationArm, instance: HostDashboardInstance) -> ObservedMember {
  let member = RepositorySharedPosture { path: instance.repo_root as NonEmptyStr }
  let repo = instance.repo_root as FilePath
  // THE REPOSITORY IS ESTABLISHED PRESENT FIRST, by the corpus rule (extdeps.filesystem.filesystem_io):
  // absence is a SUCCESSFUL PARENT LISTING without the entry -- never a failed read of the child, and
  // here, decisively, never git's exit code. The re-root's first fresh-lab deploy is the case this
  // establishes: on a fresh instance the source repository DOES NOT EXIST YET (the same apply clones
  // it later in the script stage, after the artifact stage that carries the clone), so every leg below
  // would have been reading a path with no repository in it. Absence is not unobservable: it is the
  // member's ordinary MemberAbsentOnHost, which the generic Create arm decides as
  // AssertRepositorySharedPosture -- a step the emitted script already runs AFTER the step that creates
  // the repository. A present-but-unreadable repository (exit 128 from git inside it) stays honestly
  // unobservable through the config legs; only a parent listing that itself failed is refused here.
  match entry_presence(arm: arm, path: repo as String) {
    EntryPresenceIndeterminate { cause } => MemberUnobservable { member: member, cause: join(["listing the parent of ", repo as String, " to establish the repository: ", cause], "") }
    EntryAbsent => MemberAbsentOnHost { member: member }
    EntryPresent => {
      let key_reads = map(dashboard_git_worker_posture_readback_keys(), key =>
        posture_config_leg(arm: arm, repo: repo, key: key))
      let service_leg = unit_document_leg(arm: arm, path: dashboard_git_maintenance_service_unit_path(instance: instance) as String, absent: AbsentIsTheStanding)
      let timer_leg = unit_document_leg(arm: arm, path: dashboard_git_maintenance_timer_unit_path(instance: instance) as String, absent: AbsentIsTheStanding)
      match posture_document_from_legs(key_legs: key_reads, service_leg: service_leg, timer_leg: timer_leg) {
      PostureReadUnobservable { cause } => MemberUnobservable { member: member, cause: cause }
      PostureReadOut { document } =>
        MemberObserved { identity: RepositorySharedPostureAt { posture: RepositorySharedPostureIdentity {
          path: instance.repo_root as NonEmptyStr,
          document: content_hash_atom(value: document as NonEmptyStr),
        } } }
      }
    }
  }
}

type PostureRead
  = PostureReadOut { document: String }
  | PostureReadUnobservable { cause: String }

// ONE CONFIG-KEY READBACK, carrying the key it read so the pairs assemble from the legs alone (the legs
// are mapped over dashboard_git_worker_posture_readback_keys, which is the declared order, so the observed
// document lays out exactly like the desired one and differs only in content). A key git reports is its
// value; a key git does not report is the sentinel -- a MISSING key is a real, re-writable standing, not a
// refusal, and it moves the digest; only a transport refusal or a process that never spawned is
// unobservable.
type PostureConfigLeg
  = PostureConfigPair { key: NonEmptyStr, value: String }
  | PostureConfigUnobservable { cause: String }

data posture_missing_sentinel: String = "\u{0}absent"

// BOTH ARMS read through argv (extdeps.git's git_config_local_get_command -- the READ whose write mirror
// the posture's config step is). The local arm runs it under the deploy principal (the instance owner,
// which already owns and can read its repository config, so this asks for no privilege the deploy lacks);
// the remote arm sends the same argv through the transport and is honestly unobservable on a transport
// refusal, never a faked "missing".
// THE REPOSITORY IS ESTABLISHED PRESENT BEFORE ANY LEG RUNS (see observe_repository_shared_posture),
// so this leg never has to guess existence from git's exit code. git's documented outcome vocabulary
// then splits cleanly: exit 0 is the value; exit 1 is THE KEY UNSET -- a real, re-writable standing,
// the sentinel; ANY OTHER nonzero exit is a failed read of a repository the filesystem says is there
// (128: not a repository, unreadable config, ...), and a failed read is unobservable, never a silent
// "unset". Conflating them is the class: at the re-root's first fresh-lab deploy, `git config` died
// with 128 because the repository did not exist yet, and every key was being recorded as "unset"
// while the units beside it refused -- one half lying, the other refusing, the plan dead either way.
fn posture_config_leg(arm: ObservationArm, repo: FilePath, key: NonEmptyStr) -> PostureConfigLeg {
  let command = git_local_config_get_command(repo: repo, key: key as String)
  let read_failure_cause = join(["git config --get ", key as String, " at ", repo as String], "")
  match arm {
    OnTheHostItself =>
      match run_shell_command_observe_outcome(command: command, transport: LocalExec) {
        ProcessNotSpawned { program: _, cause } => PostureConfigUnobservable { cause: join([read_failure_cause, ": ", cause], "") }
        ProcessRan { observation: o } =>
          if o.exit_code == 0 { PostureConfigPair { key: key, value: trim(s: o.stdout) } }
          else if o.exit_code == 1 { PostureConfigPair { key: key, value: posture_missing_sentinel } }
          else { PostureConfigUnobservable { cause: join([read_failure_cause, " failed: git exited ", to_string(o.exit_code)], "") } }
      }
    OverTransport { transport } =>
      match run_typed_argv_transport(argv: command.arguments, transport: transport) {
        TypedArgvExecRefused { reason } => PostureConfigUnobservable { cause: join([read_failure_cause, ": ", reason], "") }
        TypedArgvExecConverged { result: r } =>
          if r.exit_code == 0 { PostureConfigPair { key: key, value: trim(s: r.stdout) } }
          else if r.exit_code == 1 { PostureConfigPair { key: key, value: posture_missing_sentinel } }
          else { PostureConfigUnobservable { cause: join([read_failure_cause, " failed: git exited ", to_string(r.exit_code)], "") } }
      }
  }
}

fn posture_document_from_legs(
  key_legs: List<PostureConfigLeg>,
  service_leg: Leg,
  timer_leg: Leg,
) -> PostureRead {
  match collect_posture_pairs(key_legs: key_legs) {
    PosturePairsRefused { cause } => PostureReadUnobservable { cause: cause }
    PosturePairs { pairs } => match service_leg {
      LegRefused { cause } => PostureReadUnobservable { cause: cause }
      LegOut { stdout: service_document } => match timer_leg {
        LegRefused { cause } => PostureReadUnobservable { cause: cause }
        LegOut { stdout: timer_document } => PostureReadOut { document: dashboard_git_shared_repository_posture_document(
          pairs: pairs, service_unit_document: service_document, timer_unit_document: timer_document) }
      }
    }
  }
}

type PosturePairs
  = PosturePairs { pairs: List<DashboardGitConfigPosturePair> }
  | PosturePairsRefused { cause: String }

fn collect_posture_pairs(key_legs: List<PostureConfigLeg>) -> PosturePairs {
  fold(
    key_legs,
    init: PosturePairs { pairs: [] } as PosturePairs,
    f: (acc, leg) => match acc {
      PosturePairsRefused { cause: _ } => acc
      PosturePairs { pairs } => match leg {
        PostureConfigUnobservable { cause } => PosturePairsRefused { cause: cause }
        PostureConfigPair { key, value } => PosturePairs { pairs: concat(pairs, [DashboardGitConfigPosturePair { key: key, value: value }]) }
      }
    },
  )
}

fn desired_git_worker_subtree(instance: HostDashboardInstance, child: NonEmptyStr) -> MemberIdentity {
  GitWorkerSubtreeAt {
    path: dashboard_git_worker_subtree_path(instance: instance, child: child) as NonEmptyStr,
    child: child,
    standing: SubtreeConverged,
  }
}

fn desired_repository_shared_posture(instance: HostDashboardInstance) -> MemberIdentity {
  RepositorySharedPostureAt { posture: RepositorySharedPostureIdentity {
    path: instance.repo_root as NonEmptyStr,
    document: content_hash_atom(value: dashboard_git_shared_repository_posture_desired_document(instance: instance) as NonEmptyStr),
  } }
}


fn deployment_oidc_config_members(spec: DeploymentSpec) -> List<ConvergedMember> {
  match tracker_web_oidc_serve_placement(instance_id: spec.instance_id) {
    TrackerWebOidcServeReady { config: _ } => [OidcConfigFile]
    TrackerWebOidcPlacementUnassigned { instance_id: _ } => []
    TrackerWebOidcPlacementUnbound { instance_id: _, reason: _ } => []
    TrackerWebOidcPlacementMissingRealization { instance_id: _, environment: _ } => []
  }
}

// THE DIRECTORY'S METADATA, READ UNDER THE DEPLOY PRINCIPAL'S PINNED READ-ONLY GRANTS. A managed
// directory may admit only its owner (the fabric store's root derives owner-execute alone), so the job
// user can neither list it nor stat what is under it, while a correctly protected tree must still read
// as converged in planning and readback. Both reads are gunbc.executor_privileged_operation operations
// bound to one named directory -- ListDirectoryEntries and ReadDirectoryIdentity -- rendered into the
// runner host's sudoers by gunbc.runner.runner_host_grants for exactly the directories this deployment
// demands and their ancestors, the same authorization machinery every other root operation of this
// principal goes through; no path-unrestricted grant is added. The local arm runs the elevated command
// with its spawn as a value (gunbc.command_runner run_shell_command_observe_outcome); the remote arm
// sends the same elevated argv through the transport. Either way the read's origin stays typed
// (gunbc.owned_directory ObserverFailure) and presence and absence are the provider's to decide.
fn privileged_directory_read(arm: ObservationArm, op: ExecutorPrivilegedOperation) -> ObserverRead {
  match arm {
    OnTheHostItself =>
      match run_shell_command_observe_outcome(command: executor_privileged_operation_elevated_command(op: op), transport: LocalExec) {
        ProcessNotSpawned { program: _, cause } => ObserverReadFailed { origin: ObserverNotSpawned { cause: cause as String } }
        ProcessRan { observation: o } =>
          if o.exit_code == 0 { ObserverReadOut { stdout: o.stdout } }
          else { ObserverReadFailed { origin: ObserverExited { exit_code: o.exit_code, stderr: o.stderr } } }
      }
    OverTransport { transport } =>
      match run_typed_argv_transport(argv: executor_privileged_operation_elevated_argv(op: op), transport: transport) {
        TypedArgvExecRefused { reason } => ObserverReadFailed { origin: ObserverTransportRefused { cause: reason } }
        TypedArgvExecConverged { result: r } =>
          if r.exit_code == 0 { ObserverReadOut { stdout: r.stdout } }
          else { ObserverReadFailed { origin: ObserverExited { exit_code: r.exit_code, stderr: r.stderr } } }
      }
  }
}

fn owned_directory_observation_on_host(arm: ObservationArm, path: String) -> EnsureObservation<OwnedDirectoryReading> {
  owned_directory_observe(
    path: path as FilePath,
    list: p => privileged_directory_read(arm: arm, op: ListDirectoryEntries { path: p as String as NonEmptyStr }),
    stat: p => privileged_directory_read(arm: arm, op: ReadDirectoryIdentity { path: p as String as NonEmptyStr }),
  )
}

// THE PROVIDER DECIDES; THIS ONLY PROJECTS ITS DECISION ONTO THE MEMBER VOCABULARY. The decision is
// gunbc.owned_directory owned_directory_decide's -- the same one the dashboard apply's provider makes --
// so a directory is converged, created, repaired or refused here for exactly the reasons it would be
// there:
//   Noop                          -> observed at RootConverged (the desired identity: keep)
//   Apply, the directory absent   -> MemberAbsentOnHost (Create -> CreateRoot)
//   Apply, the directory present  -> observed at RootModeRepairable (Replace -> RepairRootMode)
//   Refuse, nothing could be read -> MemberUnobservable (refuses the derivation)
//   Refuse, a state it will not change (another principal's directory, a non-directory, a mode that
//          cannot be derived)      -> MemberRefusedOnHost (refuses the derivation; never re-owned)
// The post-apply readback (deployment_identity_readback) re-derives through this same function, so
// the readback is a second independent observation of every demanded directory.
fn observe_owned_directory(arm: ObservationArm, spec: DeploymentSpec, path: NonEmptyStr) -> ObservedMember {
  let member = DirectoryRoot { path: path }
  match owned_directory_demand_at(ts: deployment_directory_demands(spec: spec), path: path as String) {
    Absent => MemberRefusedOnHost { member: member, cause: join(["no owned-directory demand names ", path as String], "") }
    Present { value: target } => {
      let observation = owned_directory_observation_on_host(arm: arm, path: path as String)
      match observation {
        EnsureInaccessible { reason } => MemberUnobservable { member: member, cause: reason }
        EnsureAbsent { reason: _ } => owned_directory_member_of_decision(member: member, path: path, target: target, observation: observation)
        EnsureObserved { evidence: _ } => owned_directory_member_of_decision(member: member, path: path, target: target, observation: observation)
      }
    }
  }
}

fn owned_directory_member_of_decision(
  member: ConvergedMember,
  path: NonEmptyStr,
  target: OwnedDirectoryTarget,
  observation: EnsureObservation<OwnedDirectoryReading>,
) -> ObservedMember {
  match owned_directory_decide(policy: EnsureMayApply, target: target, observation: observation) {
    Noop => MemberObserved { identity: RootAt { root: DirectoryRootIdentity { path: path, standing: RootConverged } } }
    Refuse { reason } => match observation {
      EnsureInaccessible { reason: why } => MemberUnobservable { member: member, cause: why }
      EnsureObserved { evidence: _ } => MemberRefusedOnHost { member: member, cause: reason as String }
      EnsureAbsent { reason: _ } => MemberRefusedOnHost { member: member, cause: reason as String }
    }
    Apply { plan: _ } => match observation {
      EnsureObserved { evidence } =>
        MemberObserved { identity: RootAt { root: DirectoryRootIdentity {
          path: path,
          standing: RootModeRepairable { observed_mode: file_mode_octal(mode: evidence.mode) as NonEmptyStr },
        } } }
      EnsureAbsent { reason: _ } => MemberAbsentOnHost { member: member }
      EnsureInaccessible { reason } => MemberUnobservable { member: member, cause: reason }
    }
  }
}

fn desired_member_identity(
  member: ConvergedMember,
  spec: DeploymentSpec,
  candidate: CandidateRelease,
  desired_bin: MemberIdentity,
  now_epoch: Second?,
) -> MemberIdentity? {
  match member {
    Executable => Present { value: desired_bin }
    TreePublication => Present { value: desired_tree(candidate: candidate) }
    UnitFile => Present { value: desired_unit_file(spec: spec, candidate: candidate, now_epoch: now_epoch) }
    UnitManager => Present { value: desired_unit_manager() }
    ServiceProcess => Present { value: desired_service_process(candidate: candidate) }
    DirectoryRoot { path } => Present { value: RootAt { root: DirectoryRootIdentity { path: path, standing: RootConverged } } }
    OidcConfigFile => match tracker_web_oidc_serve_placement(instance_id: spec.instance_id) {
      TrackerWebOidcServeReady { config: cfg } => Present { value: desired_oidc_config_file(cfg: cfg) }
      TrackerWebOidcPlacementUnassigned { instance_id: _ } => none
      TrackerWebOidcPlacementUnbound { instance_id: _, reason: _ } => none
      TrackerWebOidcPlacementMissingRealization { instance_id: _, environment: _ } => none
    }
    // The desired standing of a git-worker subtree is "converged" -- the declared state it is meant to
    // hold. The declared PATH is derived from the instance row (never from the member's own field), so the
    // comparison is against what the model means, not what a caller spelled. A member that reaches here on
    // a non-dedicated instance is a roster defect (nothing put it there), and the closed-world answer is
    // none -- no desired identity, so nothing can be planned for it.
    GitWorkerSubtree { path: _, child } => match deployment_dedicated_worker_instance(spec: spec) {
      none => none
      Present { value: instance } => Present { value: desired_git_worker_subtree(instance: instance, child: child) }
    }
    RepositorySharedPosture { path: _ } => match deployment_dedicated_worker_instance(spec: spec) {
      none => none
      Present { value: instance } => Present { value: desired_repository_shared_posture(instance: instance) }
    }
  }
}

fn observed_member_on_host(
  member: ConvergedMember,
  spec: DeploymentSpec,
  candidate: CandidateRelease,
  transport: HostEffectTransport,
  arm: ObservationArm,
) -> ObservedMember {
  match member {
    Executable => observe_executable(arm: arm, path: fixed_serve_binary_path(binary: spec.service.serve_binary))
    TreePublication => observe_tree(arm: arm, spec: spec, candidate: candidate)
    UnitFile => observe_unit_file(arm: arm, spec: spec)
    UnitManager => observe_unit_manager(arm: arm, unit: spec.service.unit_name)
    ServiceProcess => observe_service_process(spec: spec, transport: transport)
    DirectoryRoot { path } => observe_owned_directory(arm: arm, spec: spec, path: path)
    OidcConfigFile => observe_oidc_config_file(arm: arm, spec: spec)
    // The observation reads the host; the instance row is looked up, not supplied, and a member on a
    // non-dedicated instance is a roster defect. Refusing to observe it (unobservable, so the derivation
    // refuses rather than silently planning) is the closed-world arm.
    GitWorkerSubtree { path, child } => match deployment_dedicated_worker_instance(spec: spec) {
      none => MemberUnobservable { member: member, cause: "git-worker subtree on a non-dedicated-worker instance" }
      Present { value: instance } => observe_git_worker_subtree(arm: arm, instance: instance, path: path as String, child: child)
    }
    RepositorySharedPosture { path: _ } => match deployment_dedicated_worker_instance(spec: spec) {
      none => MemberUnobservable { member: member, cause: "repository shared posture on a non-dedicated-worker instance" }
      Present { value: instance } => observe_repository_shared_posture(arm: arm, instance: instance)
    }
  }
}

fn release_member_plan(
  spec: DeploymentSpec,
  candidate: CandidateRelease,
  transport: HostEffectTransport,
  desired_bin: MemberIdentity,
  target: ReleaseTarget,
  now_epoch: Second?,
) -> EffectDerivation {
  let arm = observation_arm(transport: transport)
  derive_member_plan(
    roster: deployment_member_roster(spec: spec),
    desired: m => desired_member_identity(member: m, spec: spec, candidate: candidate, desired_bin: desired_bin, now_epoch: now_epoch),
    observed: m => observed_member_on_host(member: m, spec: spec, candidate: candidate, transport: transport, arm: arm),
    target: target,
  )
}

// THE DESIRED EXECUTABLE READ BACK AS ANOTHER MEMBER'S IDENTITY: one refusal, shared by every
// non-executable MemberIdentity arm of deployment_effect_plan.
fn desired_executable_is_another_member(desired_bin: MemberIdentity) -> EffectDerivation {
  EffectsRefused { refusals: [MemberRefused { member: Executable, cause: DesiredIdentityIsForAnotherMember { desired: gunbc.live_deploy.member_identity.member_identity_member(i: desired_bin) } }] }
}

fn deployment_effect_plan(spec: DeploymentSpec, candidate: CandidateRelease, transport: HostEffectTransport) -> EffectDerivation {
  let now_epoch = tracker_web_oidc_deploy_now_epoch()
  match desired_executable() {
    MemberUnobservable { member: _, cause } =>
      EffectsRefused { refusals: [MemberRefused { member: Executable, cause: DesiredExecutableUnreadable { cause: cause } }] }
    MemberAbsentOnHost { member: _ } =>
      EffectsRefused { refusals: [MemberRefused { member: Executable, cause: DesiredExecutableAbsent }] }
    MemberRefusedOnHost { member: _, cause } =>
      EffectsRefused { refusals: [MemberRefused { member: Executable, cause: DesiredExecutableUnreadable { cause: cause } }] }
    MemberObserved { identity: desired_bin } => match desired_bin {
      ExecutableIdentity { digest } =>
        release_member_plan(
          spec: spec,
          candidate: candidate,
          transport: transport,
          desired_bin: desired_bin,
          target: ReleaseTarget { revision: candidate.revision, executable: digest, unit: spec.service.unit_name },
          now_epoch: now_epoch,
        )
      TreeIdentity { tree: _ } =>
        desired_executable_is_another_member(desired_bin: desired_bin)
      UnitFileAt { file: _ } =>
        desired_executable_is_another_member(desired_bin: desired_bin)
      UnitManagerAt { standing: _ } =>
        desired_executable_is_another_member(desired_bin: desired_bin)
      ProcessAt { process: _ } =>
        desired_executable_is_another_member(desired_bin: desired_bin)
      RootAt { root: _ } =>
        desired_executable_is_another_member(desired_bin: desired_bin)
      OidcConfigAt { file: _ } =>
        desired_executable_is_another_member(desired_bin: desired_bin)
      GitWorkerSubtreeAt { path: _, child: _, standing: _ } =>
        desired_executable_is_another_member(desired_bin: desired_bin)
      RepositorySharedPostureAt { posture: _ } =>
        desired_executable_is_another_member(desired_bin: desired_bin)
    }
  }
}

// THE READBACK AFTER MUTATION IS THE SAME OBSERVATION RUN AGAIN. Process readiness proves the unit
// answers as the candidate; it cannot prove the executable and unit file on disk are the identities
// the plan declared, because an equivalent binary or a rewritten unit would answer the same. So
// after the readiness gate the deploy re-derives its plan and requires it empty: every member is
// AlreadyConverged, or the transaction did not converge and says which members still differ.
type IdentityReadback
  = IdentityReadbackConverged
  | IdentityReadbackDrift { remaining: List<String> }
  | IdentityReadbackRefused { refusals: List<MemberDecision> }

fn deployment_identity_readback(spec: DeploymentSpec, candidate: CandidateRelease, transport: HostEffectTransport) -> IdentityReadback {
  match deployment_effect_plan(spec: spec, candidate: candidate, transport: transport) {
    EffectsRefused { refusals } => IdentityReadbackRefused { refusals: refusals }
    EffectsDerived { plan } =>
      if plan_mutation_count(plan: plan) == 0 { IdentityReadbackConverged }
      else { IdentityReadbackDrift { remaining: effect_labels(plan: plan) } }
  }
}
