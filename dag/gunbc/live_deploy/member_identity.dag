module gunbc.live_deploy.member_identity

import gunbc.non_fold_residue { nfr_dissolve_owning_fold, nfr_reason_wildcard_found_by_join_measurement }
import std.roster_frontier { FrontierRow, PathSubject }
import std.types { String, Bool, List, Int, NonEmptyStr, CommitSha, HttpStatus }
import std.optional { Present, Absent }
import extdeps.crypto.hash { Digest, HashAlgorithm, Sha256, Sha512 }
import std.content_hash {
  Fnv1a64Structural,
  as_content_hash_structural,
  content_hash_eq_structural,
  serialize_content_hash,
}
import extdeps.systemd { SystemdUnitActiveState, Active, Inactive, Activating, Deactivating, Reloading, Failed, systemd_unit_active_state_wire_label }
import extdeps.rust.cargo { cargo_default_release_dir_rel }

// A DEPLOYMENT CONVERGES ON IDENTITIES, NOT ON PATHS. gunbc.live_deploy.emit deployment_apply_plan
// reconciles the desired roster against `observed: []`, so every member is an add on every apply
// and an already-converged host replays its whole installation -- measured 2026-09-06 at nineteen
// minutes, of which the deploy's real mutations were seconds and the rest was five source-compiling
// evaluators started in series by unconditional restarts. docs/plans/deploy-convergence-observed-side.md
// refutes the obvious repair (feed the same path-keyed roster an observed side): a member whose value
// is a function of its own key cannot be seen to be stale, so a non-degenerate diff over paths would
// report CONVERGED over a stale host. The member therefore needs a real identity -- the smallest fact
// whose equality means the host already holds what is desired -- and this module carries that for
// the members that consume the release. Every other owned artifact stays on the apply-all path until
// it earns an identity here; the roster below is the declared frontier, not an oversight.
//
// FIVE MEMBERS, NOT THREE, because the serve unit is three facts with three remedies (review on PR
// #10696): the unit FILE on disk, whose drift is repaired by writing it; the MANAGER's loaded copy,
// whose staleness is repaired by daemon-reload; and the PROCESS, whose absence or stale release is
// repaired by a restart. Fusing them into one identity did both sides wrong at once -- an Active
// process running the PREVIOUS release under a current unit file compared equal and was never
// restarted (an absorbing state: readiness refused, the next plan was empty again), while a Failed
// process under a current file derived a file rewrite and a reload it did not need.
//
// The executable form of the class, from the same record: every reconcile binding must have a
// control that holds the KEY fixed, varies meaningful STATE, and expects a replacement. The
// executable fixture in member_identity_witness_test is exactly that control.
// A MEMBER CARRIES ITS OWN KEY WHERE IT HAS ONE. The release members are singular -- there is one
// executable, one published tree, one serve unit -- so they are nullary. A directory root is not:
// the deployment owns several, they differ only by path, and minting a nullary variant per root
// (one per dispatch, compute or store directory) would be several names
// for one concept (DESIGN section 2, one concept at every breadth). The path is the key, so it
// lives on the variant and converged_member_label renders it -- which is also what keeps
// converged_member_eq correct for a payload-carrying member, since that equality is defined
// through the label.
type ConvergedMember
  = TreePublication
  | Executable
  | UnitFile
  | UnitManager
  | ServiceProcess
  | DirectoryRoot { path: NonEmptyStr }
  | OidcConfigFile
  // WORKER-ROOT-EQUIVALENT-3 (WORKER-ROOT-EQUIVALENT round 3, bright-moth-475 2026-10-20). These two
  // members are the WRE-3 git posture, MOVED onto the route the lab deploy actually runs
  // (live_deploy_apply_desired_operator_local_wet) from the FROZEN dashboard-instance provision route
  // that never executes. They are NOT folded into the three git-directory DirectoryRoot members, and
  // that separation is load-bearing, not tidiness: a DirectoryRoot's identity is its TOP directory's
  // standing (gunbc.owned_directory owned_directory_decide), and once the top converges the emitter
  // skips the whole fragment set (emit.dag owned_directory_will_install is false on a Keep top, so even
  // the EntriesReadableByDependents recursive leg is dead there) -- the interiors are never swept, and
  // the host's existing fan-out/reflog children stay briansrls:briansrls 755/775. The worker's first
  // commit needs those INTERIORS group-writable; that is a standing about the SUBTREE's contents, which
  // is genuinely independent of whether the top is 2770. A member's identity must say what is actually
  // decided, so it gets its own member whose observation is the interior receipt, not a bit smuggled
  // onto the top. Both are gated on instance.worker = dedicated, so srv1_live (WorkerIsServiceUser,
  // where the worker IS the service user) never carries them -- see the roster's gate.
  | GitWorkerSubtree { path: NonEmptyStr, child: NonEmptyStr }
  | RepositorySharedPosture { path: NonEmptyStr }

fn converged_member_label(m: ConvergedMember) -> String {
  match m {
    TreePublication => "tree-publication"
    Executable => "executable"
    UnitFile => "unit-file"
    UnitManager => "unit-manager"
    ServiceProcess => "service-process"
    DirectoryRoot { path } => join(["directory-root:", path as String], "")
    OidcConfigFile => "oidc-config-file"
    GitWorkerSubtree { path, child } => join(["git-worker-subtree:", path as String, ":", child as String], "")
    RepositorySharedPosture { path } => join(["repository-shared-posture:", path as String], "")
  }
}

// THE PUBLISHED TREE'S IDENTITY IS THE REVISION AND WHETHER THE TRACKED PROJECTION MATCHES IT. The
// observed-side record found that revision alone is insufficient: a checkout can sit at the right
// HEAD with a stale or dirty tracked projection, and that is the state the rsync-era sync produced.
// So a tree is converged only when both hold; a clean projection at another revision is a Replace.
type TreePublicationIdentity {
  revision: CommitSha
  tracked_projection_clean: Bool
}

// THE UNIT FILE'S IDENTITY IS ITS DOCUMENT: the content hash of the installed bytes against the
// content hash of the rendered document. Both sides are text this evaluator holds, so the
// substrate's own structural hash (std.content_hash) is the identity; the executable, whose bytes we
// never hold, is identified by the host's sha256 instead.
type UnitFileIdentity {
  unit: NonEmptyStr
  document: Fnv1a64Structural
}

// THE MANAGER'S STANDING IS WHETHER ITS LOADED COPY IS THE FILE ON DISK, which systemd reports as the
// unit property NeedDaemonReload (extdeps.systemd). A current file over a stale manager is exactly
// the state an interrupted deploy leaves -- written, never reloaded -- and it is decidable only from
// this property, never from the file.
type UnitManagerStanding
  = ManagerLoadedCurrent
  | ManagerNeedsReload

// THE PROCESS'S IDENTITY IS THE RELEASE IT IS RUNNING, read from the process itself over /healthz
// (gunbc.running_release_identity), or the fact that no process is running. ActiveState alone is
// not an identity: an Active process may be the previous release, and that is the case a restart
// exists to repair.
//
// THE THIRD ARM IS THE ONE THE LEDGER COST FOURTEEN HOURS AND TWO OUT-OF-BAND RECOVERIES.
// ProcessNotRunning and "I could not look" used to be the only two answers, so a process systemd
// calls Active whose /healthz ANSWERS -- 503, from a serve still starting, crash-looping, or running
// over a tree its binary no longer matches -- arrived as MemberUnobservable and was refused. That
// folded the row's harm into the observation: the only modeled route to repair the service required
// the service to be healthy. This arm says what was actually measured: the process answered, it was
// in a server-error class, and its reply carried no release identity to read. It is NOT a readiness
// verdict and decides nothing here on its own -- whether that means a replacement is the domain's
// call, taken below over the member's own revision (DESIGN 6b, D14).
type ServiceProcessIdentity
  = ProcessRunningRelease { revision: CommitSha }
  | ProcessNotRunning { active: SystemdUnitActiveState }
  | ProcessObservedUnhealthy {
    active: SystemdUnitActiveState,
    status: HttpStatus,
    detail: String,
  }

// A ROOT'S IDENTITY IS THE OWNED-DIRECTORY PROVIDER'S STANDING FOR IT, not a second judgement of owner
// and mode made here. Presence is already carried by ObservedMember (an established absence is
// MemberAbsentOnHost and derives a Create), and gunbc.owned_directory owned_directory_decide is the one
// authority on what a present directory's owner, group and mode mean: converged, a mode the provider
// will re-apply on a directory the demanded principal already owns, or a refusal. The refusal is not an
// identity at all -- a directory under another principal is never re-owned -- so it arrives as
// MemberRefusedOnHost and refuses the whole derivation. The owner used to be this identity, and a wrong
// owner derived a Replace that re-owned the directory: adoption from an observation, now deleted.
type DirectoryRootStanding
  = RootConverged
  | RootModeRepairable { observed_mode: NonEmptyStr }

type DirectoryRootIdentity {
  path: NonEmptyStr
  standing: DirectoryRootStanding
}

type OidcConfigFileIdentity {
  path: NonEmptyStr
  document: Fnv1a64Structural
}

// THE GIT-WORKER SUBTREE'S STANDING, as a closed pair rather than a set of observed modes. The repair
// is idempotent and re-asserts the WHOLE subtree (chgrp -R the declared group, then the additive
// g+w/g+s/+t walk restricted to the children), so a plan derived from an under-granted interior does
// not depend on WHICH child was under-granted -- it re-walks the subtree either way. Two arms is
// therefore enough, and adding a per-mode arm would be a second copy of a fact the repair does not
// branch on (DESIGN 3). The observed rendering is carried only so the refusal/readback text can say
// what the host held, exactly as DirectoryRootStanding carries observed_mode for the same reason.
type GitWorkerSubtreeStanding
  = SubtreeConverged
  | SubtreeNeedsRegroup { observed: NonEmptyStr }

// THE REPOSITORY'S SHARED REPOSITORY POSTURE, as ONE structural fact. It is the three git config keys
// (core.sharedRepository, gc.auto=0, maintenance.auto=false) PLUS the git-maintenance unit+timer the
// deferred keys stand in for -- and those are ONE member, not two, because they are one obligation:
// turning off the automatic repack (the gc keys) without installing the scheduled repack (the unit)
// leaves the repository growing loose objects with no owner. The keys and the unit are hashed together
// into one document so they cannot drift apart across deploys (the same reason OidcConfigFileIdentity
// hashes a config to one digest). Its repair re-writes the keys and re-installs+re-enables the unit as
// one step group.
type RepositorySharedPostureIdentity {
  path: NonEmptyStr
  document: Fnv1a64Structural
}

type MemberIdentity
  = TreeIdentity { tree: TreePublicationIdentity }
  | ExecutableIdentity { digest: Digest }
  | UnitFileAt { file: UnitFileIdentity }
  | UnitManagerAt { standing: UnitManagerStanding }
  | ProcessAt { process: ServiceProcessIdentity }
  | RootAt { root: DirectoryRootIdentity }
  | OidcConfigAt { file: OidcConfigFileIdentity }
  | GitWorkerSubtreeAt { path: NonEmptyStr, child: NonEmptyStr, standing: GitWorkerSubtreeStanding }
  | RepositorySharedPostureAt { posture: RepositorySharedPostureIdentity }

fn member_identity_member(i: MemberIdentity) -> ConvergedMember {
  match i {
    TreeIdentity { tree: _ } => TreePublication
    ExecutableIdentity { digest: _ } => Executable
    UnitFileAt { file: _ } => UnitFile
    UnitManagerAt { standing: _ } => UnitManager
    ProcessAt { process: _ } => ServiceProcess
    RootAt { root } => DirectoryRoot { path: root.path }
    OidcConfigAt { file: _ } => OidcConfigFile
    GitWorkerSubtreeAt { path, child, standing: _ } => GitWorkerSubtree { path: path, child: child }
    RepositorySharedPostureAt { posture } => RepositorySharedPosture { path: posture.path }
  }
}

// WHAT THE HOST SAID ABOUT A MEMBER. Absent is an established absence (the observer listed the
// parent, or an ancestor, and the entry was not there, extdeps.filesystem.filesystem_io's rule);
// unobservable is a refused or indeterminate read and is NEVER folded into either of the other two --
// a member we could not observe is refused below, not created and not skipped.
type ObservedMember
  = MemberObserved { identity: MemberIdentity }
  | MemberAbsentOnHost { member: ConvergedMember }
  | MemberUnobservable { member: ConvergedMember, cause: String }
  | MemberRefusedOnHost { member: ConvergedMember, cause: String }

fn observed_member_member(o: ObservedMember) -> ConvergedMember {
  match o {
    MemberObserved { identity } => member_identity_member(i: identity)
    MemberAbsentOnHost { member } => member
    MemberUnobservable { member, cause: _ } => member
    MemberRefusedOnHost { member, cause: _ } => member
  }
}

fn hash_algorithm_wire(a: HashAlgorithm) -> String {
  match a {
    Sha256 => "sha256"
    Sha512 => "sha512"
  }
}

fn digest_wire(d: Digest) -> String {
  join([hash_algorithm_wire(a: d.algorithm), ":", d.hex as String], "")
}

fn structural_digest_wire(h: Fnv1a64Structural) -> String {
  serialize_content_hash(hash: as_content_hash_structural(structural: h)) as String
}

fn tree_publication_identity_wire(t: TreePublicationIdentity) -> String {
  join(
    [
      t.revision as String,
      ":",
      if t.tracked_projection_clean { "clean" } else { "dirty" },
    ],
    "",
  )
}

fn unit_file_identity_wire(f: UnitFileIdentity) -> String {
  join([f.unit as String, ":", structural_digest_wire(h: f.document)], "")
}

fn unit_manager_standing_wire(s: UnitManagerStanding) -> String {
  match s {
    ManagerLoadedCurrent => "loaded-current"
    ManagerNeedsReload => "needs-reload"
  }
}

fn service_process_identity_wire(p: ServiceProcessIdentity) -> String {
  match p {
    ProcessRunningRelease { revision } => join(["running-release:", revision as String], "")
    ProcessNotRunning { active } =>
      join(["not-running:", systemd_unit_active_state_wire_label(s: active)], "")
    ProcessObservedUnhealthy { active, status, detail: _ } =>
      join(["observed-unhealthy:", systemd_unit_active_state_wire_label(s: active), ":answered:", to_string(status) as String], "")
  }
}

fn directory_root_standing_wire(s: DirectoryRootStanding) -> String {
  match s {
    RootConverged => "converged"
    RootModeRepairable { observed_mode } => join(["mode-repairable=", observed_mode as String], "")
  }
}

fn directory_root_identity_wire(r: DirectoryRootIdentity) -> String {
  join([r.path as String, ":", directory_root_standing_wire(s: r.standing)], "")
}

// TOTAL: every MemberIdentity arm contributes every field that distinguishes it. A forgotten
// field here is a forgotten field in the stale-plan fingerprint.
fn oidc_config_file_identity_wire(f: OidcConfigFileIdentity) -> String {
  join([f.path as String, ":", structural_digest_wire(h: f.document)], "")
}

// The subtree's standing renders the host's reading only as text (the repair does not branch on it,
// see GitWorkerSubtreeStanding), and the posture renders as ONE digest because the three config keys
// and the maintenance unit are one obligation -- a stale-plan fingerprint that could separate them
// would be a second authority for a fact the document hash already closes.
fn git_worker_subtree_standing_wire(s: GitWorkerSubtreeStanding) -> String {
  match s {
    SubtreeConverged => "converged"
    SubtreeNeedsRegroup { observed } => join(["needs-regroup=", observed as String], "")
  }
}

fn repository_shared_posture_identity_wire(p: RepositorySharedPostureIdentity) -> String {
  join([p.path as String, ":", structural_digest_wire(h: p.document)], "")
}

fn member_identity_wire(i: MemberIdentity) -> String {
  match i {
    TreeIdentity { tree } => join(["tree:", tree_publication_identity_wire(t: tree)], "")
    ExecutableIdentity { digest } => join(["executable:", digest_wire(d: digest)], "")
    UnitFileAt { file } => join(["unit-file:", unit_file_identity_wire(f: file)], "")
    UnitManagerAt { standing } => join(["unit-manager:", unit_manager_standing_wire(s: standing)], "")
    ProcessAt { process } => join(["process:", service_process_identity_wire(p: process)], "")
    RootAt { root } => join(["root:", directory_root_identity_wire(r: root)], "")
    OidcConfigAt { file } => join(["oidc-config:", oidc_config_file_identity_wire(f: file)], "")
    GitWorkerSubtreeAt { path, child, standing } =>
      join(
        ["git-worker-subtree:", path as String, ":", child as String, ":", git_worker_subtree_standing_wire(s: standing)],
        "",
      )
    RepositorySharedPostureAt { posture } => join(["repository-shared-posture:", repository_shared_posture_identity_wire(p: posture)], "")
  }
}

fn observed_member_wire(o: ObservedMember) -> String {
  match o {
    MemberObserved { identity: i } => join(["member-observed:", member_identity_wire(i: i)], "")
    MemberAbsentOnHost { member: m } => join(["member-absent:", converged_member_label(m: m)], "")
    MemberUnobservable { member: m, cause: c } =>
      join(["member-unobservable:", converged_member_label(m: m), ":", c], "")
    MemberRefusedOnHost { member: m, cause: c } =>
      join(["member-refused:", converged_member_label(m: m), ":", c], "")
  }
}

// WHY A MEMBER'S DECISION COULD NOT BE MADE, as a closed vocabulary rather than prose, so a
// consumer can branch on the cause and the text is rendered once.
//
// RepositoryBootstrapUnavailable IS GONE, and it is deleted rather than left unreachable because its
// entire content was a claim that is now false. It said no route in this repository could turn an
// empty directory into a repository at the candidate. #10722 built that route and proved it wet, and
// #10724 made the publication member invoke it and nothing else. A refusal cause whose text asserts
// the absence of a capability that exists would be read by the next author as a standing limitation.
type MemberRefusalCause
  = DesiredIdentityIsForAnotherMember { desired: ConvergedMember }
  | ObservationIsOfAnotherMember { observed: ConvergedMember }
  | HostUnobservable { cause: String }
  | HostStateRefused { cause: String }
  // THE TWO ARMS THAT KEEP AN OBSERVED-UNHEALTHY PROCESS FROM BECOMING A RESTART HAMMER. The reading
  // is sound -- the process answered and said it is not serving -- but a replacement is a repair only
  // when this deploy has something NEW to put under the process. With the revision it would install
  // equal to the revision installed on the host, a restart re-runs the release that just refused, so
  // nothing is mutated and the refusal says why: repair is not the same word as retry (the row's
  // guard that a refusal must not become a retry loop). The second arm is the same caution when the
  // installed revision was never observed: not knowing what is running is not a licence to replace it.
  | UnhealthyAtInstalledRelease { status: HttpStatus, detail: String, revision: CommitSha }
  | UnhealthyReleasePositionUnobserved { status: HttpStatus, detail: String }
  | DecisionFiledUnderAnotherMember { found: ConvergedMember }
  | DesiredExecutableUnreadable { cause: String }
  | DesiredExecutableAbsent
  | DesiredIdentityUnavailable

fn member_refusal_text(c: MemberRefusalCause) -> String {
  match c {
    DesiredIdentityIsForAnotherMember { desired } => join(["desired identity is for ", converged_member_label(m: desired)], "")
    ObservationIsOfAnotherMember { observed } => join(["observation is of ", converged_member_label(m: observed)], "")
    HostUnobservable { cause } => join(["could not observe the host: ", cause], "")
    HostStateRefused { cause } => join(["the host holds a state this deploy refuses to change: ", cause], "")
    UnhealthyAtInstalledRelease { status, detail, revision } =>
      join([
        "the service process answered ",
        to_string(status) as String,
        " and is not serving, but the release this deploy would install is the revision already installed (",
        revision as String,
        "); a restart would re-run the release that just refused, so this is not a repair. Nothing was mutated. ",
        detail,
      ], "")
    UnhealthyReleasePositionUnobserved { status, detail } =>
      join([
        "the service process answered ",
        to_string(status) as String,
        " and is not serving, but the release installed on the host was not observed, and not knowing what is running is not a licence to replace it. Nothing was mutated. ",
        detail,
      ], "")
    DecisionFiledUnderAnotherMember { found } => join(["decision slot holds a decision about ", converged_member_label(m: found)], "")
    DesiredExecutableUnreadable { cause } => join(["the release executable could not be read in the deploying checkout: ", cause], "")
    DesiredExecutableAbsent => join(["the release executable ", cargo_default_release_dir_rel, "/gunbc is absent from the deploying checkout; build before deploying"], "")
    DesiredIdentityUnavailable => "this member has no desired identity in the current placement; fabricating a placeholder identity is refused"
  }
}

type MemberDecision
  = AlreadyConverged { member: ConvergedMember }
  | Create { member: ConvergedMember, to: MemberIdentity }
  | Replace { member: ConvergedMember, from: MemberIdentity, to: MemberIdentity }
  | MemberRefused { member: ConvergedMember, cause: MemberRefusalCause }

fn hash_algorithm_eq(a: HashAlgorithm, b: HashAlgorithm) -> Bool {
  match a {
    Sha256 => match b { Sha256 => true  Sha512 => false }
    Sha512 => match b { Sha512 => true  Sha256 => false }
  }
}

fn digest_eq(a: Digest, b: Digest) -> Bool {
  hash_algorithm_eq(a: a.algorithm, b: b.algorithm) && (a.hex as String) == (b.hex as String)
}

fn manager_standing_eq(a: UnitManagerStanding, b: UnitManagerStanding) -> Bool {
  match a {
    ManagerLoadedCurrent => match b { ManagerLoadedCurrent => true  ManagerNeedsReload => false }
    ManagerNeedsReload => match b { ManagerNeedsReload => true  ManagerLoadedCurrent => false }
  }
}

// A PROCESS IS EQUAL TO ANOTHER ONLY WHEN BOTH RUN THE SAME RELEASE. Two not-running observations
// are never "equal" in the sense convergence needs -- the desired side is always a running release,
// so the comparison that matters is running-to-running.
fn process_identity_eq(a: ServiceProcessIdentity, b: ServiceProcessIdentity) -> Bool {
  match a {
    ProcessRunningRelease { revision: ra } => match b {
      ProcessRunningRelease { revision: rb } => (ra as String) == (rb as String)
      ProcessNotRunning { active: _ } => false
      ProcessObservedUnhealthy { active: _, status: _, detail: _ } => false
    }
    ProcessNotRunning { active: _ } => false
    // An unhealthy answer is never CONVERGED with anything, and never equal to another unhealthy
    // answer either: two answers of 503 are not "the same state the release should be in", because
    // no release is supposed to answer 503. Treating them as equal would have made a crash-looping
    // serve look already-converged once it was typed distinctly -- the fold's whole point, undone.
    ProcessObservedUnhealthy { active: _, status: _, detail: _ } => false
  }
}

fn converged_member_eq(a: ConvergedMember, b: ConvergedMember) -> Bool {
  converged_member_label(m: a) == converged_member_label(m: b)
}

// IDENTITY EQUALITY IS PER MEMBER KIND AND TOTAL; a pair of different kinds is not "unequal", it is
// a wiring defect and the caller refuses it before reaching here (decide_member).
fn member_identity_eq(a: MemberIdentity, b: MemberIdentity) -> Bool {
  match a {
    TreeIdentity { tree: ta } => match b {
      TreeIdentity { tree: tb } => (ta.revision as String) == (tb.revision as String) && ta.tracked_projection_clean && tb.tracked_projection_clean
      ExecutableIdentity { digest: _ } => false
      UnitFileAt { file: _ } => false
      UnitManagerAt { standing: _ } => false
      ProcessAt { process: _ } => false
      RootAt { root: _ } => false
      OidcConfigAt { file: _ } => false
      GitWorkerSubtreeAt { path: _, child: _, standing: _ } => false
      RepositorySharedPostureAt { posture: _ } => false
    }
    ExecutableIdentity { digest: da } => match b {
      ExecutableIdentity { digest: db } => digest_eq(a: da, b: db)
      TreeIdentity { tree: _ } => false
      UnitFileAt { file: _ } => false
      UnitManagerAt { standing: _ } => false
      ProcessAt { process: _ } => false
      RootAt { root: _ } => false
      OidcConfigAt { file: _ } => false
      GitWorkerSubtreeAt { path: _, child: _, standing: _ } => false
      RepositorySharedPostureAt { posture: _ } => false
    }
    UnitFileAt { file: fa } => match b {
      UnitFileAt { file: fb } => (fa.unit as String) == (fb.unit as String) && content_hash_eq_structural(left: fa.document, right: fb.document)
      TreeIdentity { tree: _ } => false
      ExecutableIdentity { digest: _ } => false
      UnitManagerAt { standing: _ } => false
      ProcessAt { process: _ } => false
      RootAt { root: _ } => false
      OidcConfigAt { file: _ } => false
      GitWorkerSubtreeAt { path: _, child: _, standing: _ } => false
      RepositorySharedPostureAt { posture: _ } => false
    }
    UnitManagerAt { standing: sa } => match b {
      UnitManagerAt { standing: sb } => manager_standing_eq(a: sa, b: sb)
      TreeIdentity { tree: _ } => false
      ExecutableIdentity { digest: _ } => false
      UnitFileAt { file: _ } => false
      ProcessAt { process: _ } => false
      RootAt { root: _ } => false
      OidcConfigAt { file: _ } => false
      GitWorkerSubtreeAt { path: _, child: _, standing: _ } => false
      RepositorySharedPostureAt { posture: _ } => false
    }
    ProcessAt { process: pa } => match b {
      ProcessAt { process: pb } => process_identity_eq(a: pa, b: pb)
      TreeIdentity { tree: _ } => false
      ExecutableIdentity { digest: _ } => false
      UnitFileAt { file: _ } => false
      UnitManagerAt { standing: _ } => false
      RootAt { root: _ } => false
      OidcConfigAt { file: _ } => false
      GitWorkerSubtreeAt { path: _, child: _, standing: _ } => false
      RepositorySharedPostureAt { posture: _ } => false
    }
    RootAt { root: ra } => match b {
      RootAt { root: rb } => (ra.path as String) == (rb.path as String) && directory_root_standing_wire(s: ra.standing) == directory_root_standing_wire(s: rb.standing)
      TreeIdentity { tree: _ } => false
      ExecutableIdentity { digest: _ } => false
      UnitFileAt { file: _ } => false
      UnitManagerAt { standing: _ } => false
      ProcessAt { process: _ } => false
      OidcConfigAt { file: _ } => false
      GitWorkerSubtreeAt { path: _, child: _, standing: _ } => false
      RepositorySharedPostureAt { posture: _ } => false
    }
    OidcConfigAt { file: fa } => match b {
      OidcConfigAt { file: fb } => (fa.path as String) == (fb.path as String) && content_hash_eq_structural(left: fa.document, right: fb.document)
      TreeIdentity { tree: _ } => false
      ExecutableIdentity { digest: _ } => false
      UnitFileAt { file: _ } => false
      UnitManagerAt { standing: _ } => false
      ProcessAt { process: _ } => false
      RootAt { root: _ } => false
      GitWorkerSubtreeAt { path: _, child: _, standing: _ } => false
      RepositorySharedPostureAt { posture: _ } => false
    }
    GitWorkerSubtreeAt { path: pa, child: ca, standing: sa } => match b {
      // THE WHOLE STANDING IS THE FACT: two converged renderings of the same subtree are equal;
      // a converged and a needs-regroup rendering are not; two needs-regroup renderings of the SAME
      // subtree are equal only when they saw the same deficiency, because the plan derived from them
      // re-walks either way and the wire keeps the refusal text honest.
      GitWorkerSubtreeAt { path: pb, child: cb, standing: sb } =>
        (pa as String) == (pb as String) && (ca as String) == (cb as String)
          && git_worker_subtree_standing_wire(s: sa) == git_worker_subtree_standing_wire(s: sb)
      TreeIdentity { tree: _ } => false
      ExecutableIdentity { digest: _ } => false
      UnitFileAt { file: _ } => false
      UnitManagerAt { standing: _ } => false
      ProcessAt { process: _ } => false
      RootAt { root: _ } => false
      OidcConfigAt { file: _ } => false
      RepositorySharedPostureAt { posture: _ } => false
    }
    RepositorySharedPostureAt { posture: ua } => match b {
      RepositorySharedPostureAt { posture: ub } =>
        (ua.path as String) == (ub.path as String) && content_hash_eq_structural(left: ua.document, right: ub.document)
      TreeIdentity { tree: _ } => false
      ExecutableIdentity { digest: _ } => false
      UnitFileAt { file: _ } => false
      UnitManagerAt { standing: _ } => false
      ProcessAt { process: _ } => false
      RootAt { root: _ } => false
      OidcConfigAt { file: _ } => false
      GitWorkerSubtreeAt { path: _, child: _, standing: _ } => false
    }
  }
}

// ONE MEMBER, ONE DECISION. Desired is what this release wants; observed is what the host holds.
// The tree's desired identity is always clean by construction (a release is a revision, and the
// projection we publish is its tracked set), so an observed dirty projection at the right revision
// compares unequal and is a Replace -- the stale-projection case the rsync era hid. An absent tree
// is a CREATE like any other member: the publication oneshot bootstraps an empty root to the
// candidate and reads HEAD, index and tracked worktree back as that one revision (#10722), and the
// publication member invokes that oneshot and nothing else (#10724). The absent arm therefore needs
// no member special case at all.
// WHERE THE RELEASE THAT THE BROKEN PROCESS WAS STARTED FROM SITS. The assessment of an
// observed-unhealthy process cannot be made from the process alone: a replacement is a repair only if
// this deploy has a different release to put under the process, and the release installed on a host is
// a fact about the TREE member, not about the process. So the roster-level decision hands the process
// decision the tree's own observation, and the position is read from it -- the same reading the tree
// member's convergence uses, not a second account of it.
//
// The Unknown arm is not a placeholder for "nobody looked": it carries why the tree could not be read,
// and it refuses the replacement rather than guessing one.
type InstalledReleasePosition
  = InstalledReleaseAt { revision: CommitSha }
  | InstalledReleaseUnobserved { reason: String }

fn installed_release_position(observed: fn(ConvergedMember) -> ObservedMember) -> InstalledReleasePosition {
  match observed(TreePublication) {
    MemberObserved { identity: TreeIdentity { tree } } => InstalledReleaseAt { revision: tree.revision }
    MemberObserved { identity: _ } =>
      InstalledReleaseUnobserved { reason: "the tree member reported an identity that is not a tree" }
    MemberAbsentOnHost { member: _ } =>
      InstalledReleaseUnobserved { reason: "no release tree is present on the host" }
    MemberUnobservable { member: _, cause } =>
      InstalledReleaseUnobserved { reason: join(["the release tree could not be observed: ", cause], "") }
    MemberRefusedOnHost { member: _, cause } =>
      InstalledReleaseUnobserved { reason: join(["the host refused the release tree observation: ", cause], "") }
  }
}

fn decide_member(
  member: ConvergedMember,
  desired: MemberIdentity,
  observed: ObservedMember,
  installed: InstalledReleasePosition,
) -> MemberDecision {
  if !converged_member_eq(a: member, b: member_identity_member(i: desired)) {
    MemberRefused { member: member, cause: DesiredIdentityIsForAnotherMember { desired: member_identity_member(i: desired) } }
  } else if !converged_member_eq(a: member, b: observed_member_member(o: observed)) {
    MemberRefused { member: member, cause: ObservationIsOfAnotherMember { observed: observed_member_member(o: observed) } }
  } else {
    match observed {
      MemberUnobservable { member: _, cause } => MemberRefused { member: member, cause: HostUnobservable { cause: cause } }
      MemberRefusedOnHost { member: _, cause } => MemberRefused { member: member, cause: HostStateRefused { cause: cause } }
      MemberAbsentOnHost { member: _ } => Create { member: member, to: desired }
      MemberObserved { identity } =>
        // THE DOMAIN ASSESSMENT FOR AN OBSERVED-UNHEALTHY PROCESS, taken here and not upstream, and
        // over this member's own revision rather than a generic satisfied/unsatisfied Boolean (D14).
        // The observer said only what it measured; whether 'active and answering 503' is something this
        // deploy can repair is decided by what the deploy would install:
        //   * a DIFFERENT release than the one installed -- the replacement the row's NEXT TRIGGER asks
        //     the plan to carry, and the reason the 2026-10-15 refusal was wrong: that deploy was
        //     precisely a new release over an old tree, so the repair existed and was withheld because
        //     the process had to be healthy to receive it;
        //   * the SAME release -- a restart would re-run the release that just refused, so nothing is
        //     mutated and the refusal says why. A refusal must not become a retry loop.
        //   * an UNREADABLE installed release -- not knowing what is running is not a licence to
        //     replace it.
        // Every other identity keeps the existing comparison, unchanged.
        match identity {
          ProcessAt { process: ProcessObservedUnhealthy { status, detail, active: _ } } =>
            match desired {
              ProcessAt { process: ProcessRunningRelease { revision: want } } =>
                match installed {
                  InstalledReleaseAt { revision: at } =>
                    if (want as String) == (at as String) {
                      MemberRefused { member: member, cause: UnhealthyAtInstalledRelease { status: status, detail: detail, revision: at } }
                    } else {
                      Replace { member: member, from: identity, to: desired }
                    }
                  InstalledReleaseUnobserved { reason: _ } =>
                    MemberRefused { member: member, cause: UnhealthyReleasePositionUnobserved { status: status, detail: detail } }
                }
              _ => member_identity_compare(member: member, identity: identity, desired: desired)
            }
          _ => member_identity_compare(member: member, identity: identity, desired: desired)
        }
    }
  }
}

// THE ORDINARY COMPARISON, spelled once so the unhealthy arm above cannot accidentally shadow it.
fn member_identity_compare(member: ConvergedMember, identity: MemberIdentity, desired: MemberIdentity) -> MemberDecision {
  if member_identity_eq(a: identity, b: desired) { AlreadyConverged { member: member } }
  else { Replace { member: member, from: identity, to: desired } }
}

fn decision_is_converged(d: MemberDecision) -> Bool {
  match d {
    AlreadyConverged { member: _ } => true
    Create { member: _, to: _ } => false
    Replace { member: _, from: _, to: _ } => false
    MemberRefused { member: _, cause: _ } => false
  }
}

fn decision_changes(d: MemberDecision) -> Bool {
  match d {
    Create { member: _, to: _ } => true
    Replace { member: _, from: _, to: _ } => true
    AlreadyConverged { member: _ } => false
    MemberRefused { member: _, cause: _ } => false
  }
}

fn decision_is_refused(d: MemberDecision) -> Bool {
  match d {
    MemberRefused { member: _, cause: _ } => true
    AlreadyConverged { member: _ } => false
    Create { member: _, to: _ } => false
    Replace { member: _, from: _, to: _ } => false
  }
}

fn decision_member(d: MemberDecision) -> ConvergedMember {
  match d {
    AlreadyConverged { member } => member
    Create { member, to: _ } => member
    Replace { member, from: _, to: _ } => member
    MemberRefused { member, cause: _ } => member
  }
}

fn decision_label(d: MemberDecision) -> String {
  match d {
    AlreadyConverged { member } => join([converged_member_label(m: member), ": already converged"], "")
    Create { member, to: _ } => join([converged_member_label(m: member), ": create"], "")
    Replace { member, from: _, to: _ } => join([converged_member_label(m: member), ": replace"], "")
    MemberRefused { member, cause } => join([converged_member_label(m: member), ": refused -- ", member_refusal_text(c: cause)], "")
  }
}

fn member_decision_review_line(d: MemberDecision) -> String {
  match d {
    AlreadyConverged { member } =>
      join([converged_member_label(m: member), ": already-converged"], "")
    Create { member, to } =>
      join([converged_member_label(m: member), ": create to=", member_identity_wire(i: to)], "")
    Replace { member, from, to } =>
      join(
        [
          converged_member_label(m: member),
          ": replace from=",
          member_identity_wire(i: from),
          " to=",
          member_identity_wire(i: to),
        ],
        "",
      )
    MemberRefused { member, cause } =>
      join([converged_member_label(m: member), ": refused -- ", member_refusal_text(c: cause)], "")
  }
}

// ONE DECISION PER MEMBER BY CONSTRUCTION, AND THE ROSTER IS THE DOMAIN.
//
// A caller-supplied `List<MemberDecision>` made completeness and ordering the caller's obligation:
// an empty or partial list derived an accepted empty plan (review on PR #10696). The first repair
// was a record with one slot per member, which closed that hole for FIVE members and could not be
// extended past them -- the deployment owns eleven artifacts, and a shape whose cost is one named
// slot in three places per member stops paying somewhere around here.
//
// The roster closes the same hole without the ceiling. Decisions are produced by MAPPING the
// deployment's own member roster, so the list cannot omit a member, cannot hold two decisions about
// one member, and cannot be ordered differently from the roster -- map is total and order-preserving
// over its input. That is the same guarantee the record gave, obtained from the authority instead of
// from a hand-written slot per member, and it is why decide_release_members takes the observation
// and desired-identity functions rather than the finished list: there is no way to CALL it with a
// partial answer. The slot-agreement check the record needed is gone with the slots; a decision is
// about the member it was mapped from, by construction.
fn decide_release_members(
  roster: List<ConvergedMember>,
  desired: fn(ConvergedMember) -> MemberIdentity?,
  observed: fn(ConvergedMember) -> ObservedMember,
) -> List<MemberDecision> {
  // The installed release position is read ONCE from the roster's own tree observation and handed to
  // every member decision: the process member's assessment needs it, and reading it from the same
  // observation the tree member is judged by is what keeps one meaning to 'what is installed'.
  let installed = installed_release_position(observed: observed)
  map(roster, m => match desired(m) {
    Present { value: d } => decide_member(member: m, desired: d, observed: observed(m), installed: installed)
    Absent => MemberRefused { member: m, cause: DesiredIdentityUnavailable }
  })
}

// THE RELEASE A PLAN INSTALLS, CARRIED ONCE. The plan's effects used to each carry their own operand
// (a revision on PublishTree, a digest on InstallExecutable, a unit name on WriteUnit) beside a
// second revision the emitter received as a separate argument; the emitter then discarded every one
// of them and copied the ambient source path. Two operands for one fact is the section 3 nickname,
// and an operand nothing reads is a label. The target lives here, once, and the emitter binds
// actuation to it: the executable it copies is verified against `executable` before and after the
// copy, and the unit it renders names `revision`.
type ReleaseTarget {
  revision: CommitSha
  executable: Digest
  unit: NonEmptyStr
}

// THE MUTATION A MEMBER MAY RECEIVE, one closed vocabulary rather than one switch type per member.
// A member gets exactly one, so a plan still has no spelling that installs the executable twice or
// restarts before it writes -- that canonicality came from one-effect-per-member, not from the
// effects being separate types, and it survives the roster unchanged.
type MemberMutation
  = KeepMember
  | InstallExecutable
  | PublishTree
  | WriteUnit
  | WriteOidcConfig
  | DaemonReload
  | RestartService
  | CreateRoot
  | RepairRootMode
  // The git-worker subtree's interiors re-grouped and made group-writable, and the repository's shared
  // posture (three config keys + the maintenance unit) asserted. Both idempotent re-assertions of the
  // declared posture, like RepairRootMode.
  | RegroupGitWorkerSubtree
  | AssertRepositorySharedPosture

fn member_mutation_label(e: MemberMutation) -> String {
  match e {
    KeepMember => "keep"
    InstallExecutable => "install-executable"
    PublishTree => "publish-tree"
    WriteUnit => "write-unit"
    WriteOidcConfig => "write-oidc-config"
    DaemonReload => "daemon-reload"
    RestartService => "restart-service"
    CreateRoot => "create-root"
    RepairRootMode => "repair-root-mode"
    RegroupGitWorkerSubtree => "regroup-git-worker-subtree"
    AssertRepositorySharedPosture => "assert-repository-shared-posture"
  }
}

type MemberEffectRow {
  member: ConvergedMember
  mutation: MemberMutation
}

// ROWS ARE IN ROSTER ORDER, which is the deployment's own apply order, because they are mapped from
// it. Nothing here re-sorts them and nothing downstream may: gunbc.live_deploy.emit folds over
// spec.steps and asks this plan what each member does, so the ordering authority stays in one place
// (review on PR #10696 found the previous emitter prepending the whole plan ahead of the deployment).
// THE PLAN HAS ONE MINT, AND IT IS IN THIS MODULE. Rows mapped from the roster are complete by
// construction, but a plain record would let any module write `ReleaseEffectPlan { target, rows: [] }`
// and hand an empty population straight to the emitter -- the same accepted-empty-plan hole read
// from the construction side rather than the argument side. sole_constructor makes that literal
// refuse outside this module, so the roster-mapping constructors below are the ONLY way a plan comes
// into existence, and completeness is a property of the type rather than of who called what.
type ReleaseEffectPlan sole_constructor {
  target: ReleaseTarget
  rows: List<MemberEffectRow>
}

type EffectDerivation

  = EffectsDerived { plan: ReleaseEffectPlan }
  | EffectsRefused { refusals: List<MemberDecision> }

// THE DEPENDENCY EDGES ARE PER MEMBER, NOT HARDWIRED INTO ONE RECORD. The previous derivation read
// five named slots and encoded the edges in its own body. Read over a roster the same edges are
// stated once each, as a function of what the member IS and what changed around it:
//
//   executable changed   -> InstallExecutable
//   tree changed         -> PublishTree
//   unit file changed    -> WriteUnit
//   manager stale OR the unit file changed -> DaemonReload
//   any release member changed, or the process itself is stale or down -> RestartService
//   a root is absent     -> CreateRoot;  a root the demanded principal owns at another mode -> RepairRootMode (a root under another principal refuses, never re-owned)
//   nothing changed      -> KeepMember
//
// A ROOT DOES NOT RESTART THE SERVE PROCESS, and that is a claim rather than an omission. Roots are
// PREREQUISITES the process needs to exist, not inputs whose content it serves: creating one that
// was missing does not make a healthy process wrong. If the process was in fact broken by the
// missing root it is not running the desired release, so ServiceProcess is itself stale and restarts
// on its own account. Folding root creation into the restart condition would restart a healthy
// process on every fresh-host repair for no reason the identities can state.
fn release_member_changed(d: MemberDecision) -> Bool {
  match decision_member(d: d) {
    DirectoryRoot { path: _ } => false
    TreePublication => decision_changes(d: d)
    Executable => decision_changes(d: d)
    UnitFile => decision_changes(d: d)
    UnitManager => decision_changes(d: d)
    ServiceProcess => decision_changes(d: d)
    OidcConfigFile => decision_changes(d: d)
    // NEITHER MOVES THE SERVE PROCESS. The subtree's interiors and the repository posture are facts
    // about the repository on disk; the process reads git through its worktrees, and re-grouping the
    // object fan-out or re-writing the three local config keys does not make a running process wrong
    // about the release it serves. The same reading the comment on release_member_changed gives for
    // roots: prerequisites, not served inputs.
    GitWorkerSubtree { path: _, child: _ } => false
    RepositorySharedPosture { path: _ } => false
  }
}

fn member_mutation_for(d: MemberDecision, decisions: List<MemberDecision>) -> MemberMutation {
  let file_changed = any(decisions, x => converged_member_eq(a: decision_member(d: x), b: UnitFile) && decision_changes(d: x))
  let release_changed = any(decisions, x => release_member_changed(d: x))
  match decision_member(d: d) {
    Executable => if decision_changes(d: d) { InstallExecutable } else { KeepMember }
    TreePublication => if decision_changes(d: d) { PublishTree } else { KeepMember }
    UnitFile => if file_changed { WriteUnit } else { KeepMember }
    UnitManager => if file_changed || decision_changes(d: d) { DaemonReload } else { KeepMember }
    ServiceProcess => if release_changed || decision_changes(d: d) { RestartService } else { KeepMember }
    OidcConfigFile => if decision_changes(d: d) { WriteOidcConfig } else { KeepMember }
    GitWorkerSubtree { path: _, child: _ } =>
      if decision_changes(d: d) { RegroupGitWorkerSubtree } else { KeepMember }
    RepositorySharedPosture { path: _ } =>
      if decision_changes(d: d) { AssertRepositorySharedPosture } else { KeepMember }
    DirectoryRoot { path: _ } => match d {
      Create { member: _, to: _ } => CreateRoot
      Replace { member: _, from: _, to: _ } => RepairRootMode
      AlreadyConverged { member: _ } => KeepMember
      MemberRefused { member: _, cause: _ } => KeepMember
    }
  }
}

// THE PLAN IS DERIVED FROM THE ROSTER, AND A DECISION LIST NEVER CROSSES THIS BOUNDARY.
//
// This is the review's objection closed at the consumer rather than only at the producer, and the
// first roster draft got it wrong: it kept `derive_effects(decisions: List<MemberDecision>, ...)`
// and relied on decide_release_members being the only caller. But the TYPE still admitted a
// hand-built list, so an empty one derived a plan with no rows, no mutations, and an accepted empty
// plan -- which is exactly the hole the slot record was introduced to close (review on PR #10696),
// reopened by a shape whose guarantee lived in a convention about who calls it.
//
// So the only way to obtain a plan is to hand over the ROSTER and the two functions. There is no
// spelling of this call that omits a member, decides one twice, or orders them differently from the
// authority, because the caller never builds the list at all. derive_effects_from_decisions stays
// as the internal fold and is deliberately not exported: a decision list is an intermediate, not an
// interface.
fn derive_member_plan(
  roster: List<ConvergedMember>,
  desired: fn(ConvergedMember) -> MemberIdentity?,
  observed: fn(ConvergedMember) -> ObservedMember,
  target: ReleaseTarget,
) -> EffectDerivation {
  derive_effects_from_decisions(
    decisions: decide_release_members(roster: roster, desired: desired, observed: observed),
    target: target,
  )
}

// ANY REFUSED DECISION REFUSES THE WHOLE DERIVATION: a plan over a member nobody could observe would
// either reinstall blindly or skip blindly. The refusals are returned together rather than one at a
// time, so a run that could not observe three members says so once.
fn derive_effects_from_decisions(decisions: List<MemberDecision>, target: ReleaseTarget) -> EffectDerivation {
  let refused = filter(decisions, d => decision_is_refused(d: d))
  if count(refused) > 0 {
    EffectsRefused { refusals: refused }
  } else {
    EffectsDerived { plan: ReleaseEffectPlan {
      target: target,
      rows: map(decisions, d => MemberEffectRow {
        member: decision_member(d: d),
        mutation: member_mutation_for(d: d, decisions: decisions),
      }),
    } }
  }
}

// A MEMBER THE PLAN DOES NOT COVER IS NOT "KEEP", AND THE FIRST DRAFT SAID IT WAS.
//
// This fold used to init at KeepMember, which made a member with NO ROW indistinguishable from one
// the plan explicitly decided to keep -- the accepted-empty-plan failure again, one layer down:
// absence of knowledge rendered as a decision to do nothing. It was reachable and it was reached.
// The canonical plans were built over release_member_roster() while the emitter asked them about
// DirectoryRoot members, so every root silently gated OFF and the attempt-state root stopped being
// provisioned. Two pre-existing witnesses caught it; nothing in the types did.
//
// The lookup is typed instead, and the consumer decides. gunbc.live_deploy.emit treats
// MemberNotInPlan as "this plan makes no claim about this member, so emit what the apply-all era
// emitted" -- never as a skip. A member we have no decision about must not be silently dropped;
// doing the unconditional thing is the fail-safe direction, and it is what unmigrated kinds already
// do.
type PlanMutationLookup
  = MutationInPlan { mutation: MemberMutation }
  | MemberNotInPlan

fn plan_mutation_of(plan: ReleaseEffectPlan, member: ConvergedMember) -> PlanMutationLookup {
  fold(
    plan.rows,
    init: MemberNotInPlan,
    f: (acc, r) => if converged_member_eq(a: r.member, b: member) { MutationInPlan { mutation: r.mutation } } else { acc },
  )
}

fn plan_mutation_is(plan: ReleaseEffectPlan, member: ConvergedMember, expected: MemberMutation) -> Bool {
  match plan_mutation_of(plan: plan, member: member) {
    MemberNotInPlan => false
    MutationInPlan { mutation } => member_mutation_label(e: mutation) == member_mutation_label(e: expected)
  }
}

fn mutation_is_keep(e: MemberMutation) -> Bool {
  match e {
    KeepMember => true
    InstallExecutable => false
    PublishTree => false
    WriteUnit => false
    WriteOidcConfig => false
    DaemonReload => false
    RestartService => false
    CreateRoot => false
    RepairRootMode => false
    RegroupGitWorkerSubtree => false
    AssertRepositorySharedPosture => false
  }
}

fn plan_installs_executable(plan: ReleaseEffectPlan) -> Bool {
  plan_mutation_is(plan: plan, member: Executable, expected: InstallExecutable)
}

fn plan_publishes_tree(plan: ReleaseEffectPlan) -> Bool {
  plan_mutation_is(plan: plan, member: TreePublication, expected: PublishTree)
}

fn plan_writes_unit(plan: ReleaseEffectPlan) -> Bool {
  plan_mutation_is(plan: plan, member: UnitFile, expected: WriteUnit)
}

fn plan_writes_oidc_config(plan: ReleaseEffectPlan) -> Bool {
  plan_mutation_is(plan: plan, member: OidcConfigFile, expected: WriteOidcConfig)
}

fn plan_reloads_manager(plan: ReleaseEffectPlan) -> Bool {
  plan_mutation_is(plan: plan, member: UnitManager, expected: DaemonReload)
}

fn plan_restarts_process(plan: ReleaseEffectPlan) -> Bool {
  plan_mutation_is(plan: plan, member: ServiceProcess, expected: RestartService)
}

// THE LABELS ARE READ OFF THE ROWS, so a member added to the roster appears here without editing
// this function. The previous form enumerated five named accessors and would have needed a sixth
// line per member -- the same per-member cost the roster exists to remove.
fn member_row_label(r: MemberEffectRow, target: ReleaseTarget) -> List<String> {
  match r.mutation {
    KeepMember => []
    InstallExecutable => [join(["install-executable sha256:", target.executable.hex as String], "")]
    PublishTree => [join(["publish-tree ", target.revision as String], "")]
    WriteUnit => [join(["write-unit ", target.unit as String], "")]
    WriteOidcConfig => ["write-oidc-config"]
    DaemonReload => ["daemon-reload"]
    RestartService => [join(["restart ", target.unit as String], "")]
    CreateRoot => [join(["create-root ", converged_member_label(m: r.member)], "")]
    RepairRootMode => [join(["repair-root-mode ", converged_member_label(m: r.member)], "")]
    RegroupGitWorkerSubtree => [join(["regroup-git-worker-subtree ", converged_member_label(m: r.member)], "")]
    AssertRepositorySharedPosture => [join(["assert-repository-shared-posture ", converged_member_label(m: r.member)], "")]
  }
}

fn effect_labels(plan: ReleaseEffectPlan) -> List<String> {
  flat_map(plan.rows, r => member_row_label(r: r, target: plan.target))
}

fn plan_mutation_count(plan: ReleaseEffectPlan) -> Int {
  count(effect_labels(plan: plan))
}

// THE RELEASE ROSTER: the five members that consume the release, in deployment order. The directory
// roots are NOT here -- their roster is per-spec, since a spec names its own roots, and it is joined
// on in gunbc.live_deploy.member_observe where the spec is in hand.
fn release_member_roster() -> List<ConvergedMember> {
  [Executable, TreePublication, UnitFile, UnitManager, ServiceProcess]
}

fn plan_of_rows(target: ReleaseTarget, rows: List<MemberEffectRow>) -> ReleaseEffectPlan {
  ReleaseEffectPlan { target: target, rows: rows }
}

// EVERY CONSTRUCTOR TAKES THE ROSTER IT COVERS. A plan built over a smaller roster than its consumer
// walks is the defect above; making the roster an argument means a plan is always about a stated set
// of members rather than an implied one, and the caller that knows the deployment supplies it.
fn uniform_release_plan(
  roster: List<ConvergedMember>,
  target: ReleaseTarget,
  mutation_for: fn(ConvergedMember) -> MemberMutation,
) -> ReleaseEffectPlan {
  plan_of_rows(
    target: target,
    rows: map(roster, m => MemberEffectRow { member: m, mutation: mutation_for(m) }),
  )
}

fn converged_effect_plan(roster: List<ConvergedMember>, target: ReleaseTarget) -> ReleaseEffectPlan {
  uniform_release_plan(roster: roster, target: target, mutation_for: m => KeepMember)
}

// THE FULL-INSTALL PLAN: every member changed. It is what an apply against a host holding a
// repository at another revision, no executable and no unit derives, and it is the plan the emit
// witnesses hand the emitter so the rendered script they pin is the complete installation. It is
// NOT a fallback for a plan that could not be derived -- a refused observation refuses the deploy
// (gunbc.live_deploy.member_observe deployment_effect_plan), it does not install everything.
fn full_install_plan(roster: List<ConvergedMember>, target: ReleaseTarget) -> ReleaseEffectPlan {
  uniform_release_plan(roster: roster, target: target, mutation_for: m => match m {
    Executable => InstallExecutable
    TreePublication => PublishTree
    UnitFile => WriteUnit
    UnitManager => DaemonReload
    ServiceProcess => RestartService
    DirectoryRoot { path: _ } => CreateRoot
    OidcConfigFile => WriteOidcConfig
    GitWorkerSubtree { path: _, child: _ } => RegroupGitWorkerSubtree
    RepositorySharedPosture { path: _ } => AssertRepositorySharedPosture
  })
}

data non_fold_residue_frontier: List<FrontierRow> = [
  FrontierRow { subject: PathSubject { path: "decide_member" }, reason: nfr_reason_wildcard_found_by_join_measurement, dissolution: nfr_dissolve_owning_fold },
]
