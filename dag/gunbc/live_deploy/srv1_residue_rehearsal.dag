fn residue_disposition_is_delete(row: ResiduePathDisposition) -> Bool {
  match row.disposition {
    Delete { deletion_commit: _, reason: _ } => true
    _ => false
  }
}

fn srv1_rehearsal_every_residue_path_is_explicitly_deleted() -> Bool {
  count(srv1_predicted_residue_dispositions) == 148
    && all(srv1_predicted_residue_dispositions, row => residue_disposition_is_delete(row: row))
}

fn srv1_rehearsal_population_is_complete() -> Bool {
  count(srv1_paths_becoming_tracked()) == 1891
    && count(srv1_predicted_residue_dispositions) == 148
    && count(srv1_preserved_ref_lines()) == 1455
    && count(srv1_preserved_linked_worktrees) == 17
}

fn srv1_rehearsal_primary_is_detached() -> Bool {
  srv1_capture_identity.live_head_detached
}
