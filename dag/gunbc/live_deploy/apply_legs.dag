// THE APPLY FOLD'S LEGS AS DATA, replacing the apply bash script the way gunbc.live_deploy.retract_legs
// replaced the retract script. A leg is one typed operation on the host; the runner
// (gunbc.host.host_effect_realize realize_live_deploy_apply_on_host) matches the closed sum totally and
// folds the first failure into a NotConverged naming that leg's step.
//
// THE PLAN DECIDES EVERY REFUSAL BEFORE ANY LEG RUNS. The script's refusals were Decide fragments and a
// refused fold dropped every Mutate; DeployApplyPlan keeps that: ApplyPlanRefused carries the step and
// reason and returns no leg for the runner to start.
type DeployApplyLeg
  = ApplyLegEnsureDirectory { target: OwnedDirectoryTarget }
  | ApplyLegRepairDirectoryEntries { command: ArgvCommand }
  | ApplyLegCommand { step: String, command: ArgvCommand }
  | ApplyLegInstallFile { step: String, command: ArgvCommand, payload: String }
  | ApplyLegReport { step: String, line: String }
  | ApplyLegObjectSource
  | ApplyLegDigestVerify { step: String, path: String, digest: Digest }
  | ApplyLegDiagnosedCommand { step: String, command: ArgvCommand, diagnosis: ArgvCommand }
  | ApplyLegBrokerStateDirectories { revision: ReleaseRevisionBinding }
  | ApplyLegRootHelperSnapshot { locus: HelperLocus, spine: List<String>, revision: ReleaseRevisionBinding, action: HelperSnapshotAction }
  | ApplyLegBrokerTree { revision: ReleaseRevisionBinding }
  | ApplyLegRetract { step: String, leg: DeployRetractLeg }
  | ApplyLegDependency { dep: DeploymentDependencyStep }
  | ApplyLegDigestEnvFile { step: String, binary: String, env_name: String, dest: String, owner: NonEmptyStr }
  | ApplyLegCredstoreCopy { step: String, source: NonEmptyStr, dest: NonEmptyStr, file_name: NonEmptyStr }

// A root-owned release snapshot is installed before the units that name it and its superseded siblings are
// retired after them, so the two halves are separate legs of one effect.
type HelperSnapshotAction
  = HelperSnapshotInstall
  // THE 127-FIVE-HOURS ARM (prod gap 1, S1). The lab's hand deploys enabled the attempt-unit drain
  // while nothing had installed the revision the drain unit's ExecStart names -- workers failed with
  // 127 for hours because the question "does /opt/gunbc/attempt-system-unit-helpers/<instance>/<rev>/
  // exist, with its members" was asked by NO link of the chain. The drain plan now asks it, at apply
  // time, BEFORE the enable/restart legs, and refuses by path.
  | HelperSnapshotRetireSuperseded
  | HelperSnapshotVerify

type DeployApplyPlan
  = ApplyPlanReady { legs: List<DeployApplyLeg> }
  | ApplyPlanRefused { step: String, reason: String }

fn deploy_apply_leg_step(leg: DeployApplyLeg) -> String {
  match leg {
    ApplyLegEnsureDirectory { target: _ } => "ensure-owned-directory"
    ApplyLegRepairDirectoryEntries { command: _ } => "repair-directory-entries"
    ApplyLegCommand { step: st, command: _ } => st
    ApplyLegInstallFile { step: st, command: _, payload: _ } => st
    ApplyLegReport { step: st, line: _ } => st
    ApplyLegObjectSource => "object-source"
    ApplyLegDigestVerify { step: st, path: _, digest: _ } => st
    ApplyLegDiagnosedCommand { step: st, command: _, diagnosis: _ } => st
    ApplyLegBrokerStateDirectories { revision: _ } => "broker-state-directories"
    ApplyLegRootHelperSnapshot { locus: l, spine: _, revision: _, action: a } => match a {
      HelperSnapshotInstall => join([l.step_stem as String, "-helper-snapshot"], "")
      HelperSnapshotRetireSuperseded => join([l.step_stem as String, "-helper-snapshot-retire"], "")
      HelperSnapshotVerify => join([l.step_stem as String, "-helper-snapshot-verify"], "")
    }
    ApplyLegBrokerTree { revision: _ } => "approval-broker-tree"
    ApplyLegRetract { step: st, leg: _ } => st
    ApplyLegDependency { dep: _ } => "dependency"
    ApplyLegDigestEnvFile { step: st, binary: _, env_name: _, dest: _, owner: _ } => st
    ApplyLegCredstoreCopy { step: st, source: _, dest: _, file_name: _ } => st
  }
}

// ── OWNED DIRECTORIES ────────────────────────────────────────────────────────────────────────────
//
// One target's legs: the ensure (observe, decide, install, independent readback -- gunbc.owned_directory
// owned_directory_ensure), then for a managed directory whose entries its dependents read, the
// unprivileged additive chmod of the entries the applying principal owns. A mode derivation with no
// plan, a writer the owner and group do not cover, and a refused entry-mode derivation each refuse the
// whole plan with the step that named it.
fn deploy_apply_directory_target_plan(t: OwnedDirectoryTarget) -> DeployApplyPlan {
  match owned_directory_install_plan_of(t: t) {
    EnsurePlanUnavailable { reason } =>
      ApplyPlanRefused { step: "owned-directory", reason: join(["owned directory NOT ENSURED: owned_directory_install_plan_of has no plan: ", reason], "") }
    EnsurePlanAvailable { plan: _ } =>
      match t {
        OwnedDirectoryDeclared { member: _, path: _, owner: _, mode: _ } =>
          ApplyPlanReady { legs: [ApplyLegEnsureDirectory { target: t }] }
        OwnedDirectoryManaged { directory } =>
          match managed_directory_admit(d: directory) {
            ManagedDirectoryRefused { member: m, path: p, writer: w } =>
              ApplyPlanRefused {
                step: "owned-directory",
                reason: join([m as String, " writer uncovered path=", p as String, " writer=", w as String], ""),
              }
            ManagedDirectoryAdmitted { dir } =>
              match dir.entries {
                EntriesUnmanaged => ApplyPlanReady { legs: [ApplyLegEnsureDirectory { target: t }] }
                EntriesReadableByDependents { repaired_by } =>
                  match managed_directory_entry_mode(d: dir) {
                    ManagedEntryModeRefused { member: m, path: p, reason: r } =>
                      ApplyPlanRefused {
                        step: "owned-directory",
                        reason: join(["managed host directory entries NOT REPAIRED: managed_directory_entry_mode refused. member=", m as String, " path=", p as String, " reason=", r as String], ""),
                      }
                    ManagedEntryModeDerived { mode } =>
                      ApplyPlanReady {
                        legs: [
                          ApplyLegEnsureDirectory { target: t },
                          ApplyLegRepairDirectoryEntries {
                            command: find_owned_regular_files_exec_command(
                              dir: dir.path as String,
                              owner: repaired_by.name as String,
                              command: [chmod_binary_path as String, entry_mode_add_read_symbolic(mode: mode)],
                            ),
                          },
                        ],
                      }
                  }
              }
          }
      }
  }
}

fn deploy_apply_directories_plan_from(targets: List<OwnedDirectoryTarget>, legs: List<DeployApplyLeg>) -> DeployApplyPlan {
  match targets {
    Empty => ApplyPlanReady { legs: legs }
    Cons { head: t, tail: rest } =>
      match deploy_apply_directory_target_plan(t: t) {
        ApplyPlanRefused { step: s, reason: r } => ApplyPlanRefused { step: s, reason: r }
        ApplyPlanReady { legs: more } => deploy_apply_directories_plan_from(targets: rest, legs: list_append(left: legs, right: more))
      }
  }
}

// THE ONE CLAIM PREDICATE FOR THE GIT-WORKER SUBTREE DEMANDS (WORKER-ROOT-EQUIVALENT-3, typed-legs
// port). A demand for one of the instance's git children (objects, refs, logs) belongs to the subtree
// plan when ALL of: the tree group is ACTIVE (the plan publishes the tree AND the spec carries the
// GunbcSourceTree step -- the only host for the group; with either absent the demands keep today's
// standing position, so a spec without that step is unchanged: BOTH WAYS, this exclusion fires exactly
// when the subtree plan installs them); the demand's member is one of the minted git-worker members by
// PATH-FREE MEMBER EQUALITY at the mint authority (is_dashboard_git_worker_directory_demand -- never a
// substring of the path, which would misclassify any unrelated owned directory whose path merely
// contains /logs, /refs or /objects); and the owned-directory model itself says the target needs
// installing (owned_directory_will_install -- the SAME test the standing route applies, so a declined
// install declines in both routes and nothing is silently dropped). The standing directories plan
// EXCLUDES exactly what this includes and the subtree plan INCLUDES by this SAME predicate:
// complementary by construction, no demand installed twice. Prod (WorkerIsServiceUser) mints no such
// demand at all, so nothing moves there.
fn git_worker_subtree_group_active(spec: DeploymentSpec, plan: ReleaseEffectPlan) -> Bool {
  plan_publishes_tree(plan: plan) && spec_has_artifact_kind(spec: spec, kind: UpsertOwned { kind: GunbcSourceTree })
}

fn git_worker_subtree_demand_claimed(spec: DeploymentSpec, plan: ReleaseEffectPlan, t: OwnedDirectoryTarget) -> Bool {
  git_worker_subtree_group_active(spec: spec, plan: plan)
    && is_dashboard_git_worker_directory_demand(t: t)
    && owned_directory_will_install(spec: spec, plan: plan, t: t)
}

fn deploy_apply_directories_plan(spec: DeploymentSpec, plan: ReleaseEffectPlan) -> DeployApplyPlan {
  deploy_apply_directories_plan_from(
    targets: filter(xs: deployment_directory_demands(spec: spec), predicate: t =>
      owned_directory_will_install(spec: spec, plan: plan, t: t) && !git_worker_subtree_demand_claimed(spec: spec, plan: plan, t: t)),
    legs: [],
  )
}

// A git child is SWEPT exactly when the roster DECIDED that child's regroup: plan_mutation_is over the
// member is the ONLY authority (the same test the bash cut applied, ported unchanged), never path text.
fn git_worker_subtree_child_decided(plan: ReleaseEffectPlan, instance: HostDashboardInstance, child: NonEmptyStr) -> Bool {
  plan_mutation_is(
    plan: plan,
    member: GitWorkerSubtree { path: dashboard_git_worker_subtree_path(instance: instance, child: child) as NonEmptyStr, child: child },
    expected: RegroupGitWorkerSubtree,
  )
}

// THE SWEEP, RECURSIVELY, in children order. Each claimed child contributes the modeled migration legs
// (re-group to the declared attempt group, then assert modes), named per child so a refusal on the
// record says WHICH child stopped the fold.
fn git_worker_subtree_sweep_legs(plan: ReleaseEffectPlan, instance: HostDashboardInstance, remaining: List<NonEmptyStr>, legs: List<DeployApplyLeg>) -> List<DeployApplyLeg> {
  match remaining {
    Empty => legs
    Cons { head: child, tail: rest } =>
      if !git_worker_subtree_child_decided(plan: plan, instance: instance, child: child) {
        git_worker_subtree_sweep_legs(plan: plan, instance: instance, remaining: rest, legs: legs)
      } else {
        git_worker_subtree_sweep_legs(
          plan: plan,
          instance: instance,
          remaining: rest,
          legs: list_append(
            left: legs,
            right: map(
              dashboard_git_worker_subtree_child_migration(instance: instance, child: child, group: fleet_posix_worker_shared_group_name),
              argv => ApplyLegCommand { step: join(["git-worker-subtree-regroup-", child as String], ""), command: argv },
            ),
          ),
        )
      }
  }
}

// THE POSTURE, RECURSIVELY, in declared order: the shared-repository git config the modeled posture
// builder derives. Numbered per leg so a refusal names its position among the posture assertions.
fn git_worker_subtree_posture_legs(remaining: List<ArgvCommand>, n: Int, legs: List<DeployApplyLeg>) -> List<DeployApplyLeg> {
  match remaining {
    Empty => legs
    Cons { head: argv, tail: rest } =>
      git_worker_subtree_posture_legs(remaining: rest, n: n + 1, legs: list_append(left: legs, right: [ApplyLegCommand { step: join(["repository-shared-posture-", to_string(n)], ""), command: argv }]))
  }
}

// THE GIT-WORKER SUBTREE GROUP, AS TYPED LEGS (WORKER-ROOT-EQUIVALENT-3; typed-effects port of #14246/
// #14270, manager ruling msg_dd453af6 + plan approval msg_d56f89c8). WHAT A COMMIT IN A LINKED WORKTREE
// WRITES, derived rather than guessed: LOOSE OBJECTS in existing and new fan-out directories under
// .git/objects (so those directories must be group-writable AND new ones must inherit the group -- the
// setgid bit on directories, which the sweep asserts), REFS and REFLOGS under .git/refs and .git/logs
// (same), the worktree's OWN .git/worktrees/<key> administrative entry (covered by the .git/refs/logs
// sibling grant model: the per-attempt entry is written through the worktree's own gitdir, not by the
// standing grant -- see the PR body), and CONFIG only through the modeled git tool. It does NOT rewrite
// packed-refs: a normal commit on a new branch writes a loose ref; only branch deletion or `git
// pack-refs` rewrite that file, and the worker does neither -- so the worker MUST NOT hold it, and the
// .git directory itself stays unwritable (the lock files a rewrite needs live there, which is exactly
// why #13942 keeps them out of the worker's reach and why the claim stays green).
// THE PREMISE FIRST, AS AN EXIT STATUS: `git -c safe.directory=<repo> --git-dir=<repo>/.git rev-parse
// --absolute-git-dir` from extdeps.git's builder. It is the ONLY leg allowed to touch the repository
// before ownership is settled, it runs as the APPLYING principal, and a nonzero exit stops the fold AT
// this leg (ApplyRunFailed step "git-worker-subtree-premise") so nothing downstream runs against a
// directory that is not a repository. No shell, no capture, no comparison -- see the builder's comment
// for why the bash-cut gate was deleted.
// THE PRINCIPAL IS NEVER ROOT for anything that touches the repository (plan-approval ruling): a root
// chgrp or a root `git config` under a tree the worker can already write is redirectable, and `git
// config` writes .git/config.lock and renames it, so running it as root would leave .git/config owned by
// root. Only the maintenance unit-file install and its systemctl legs take root, as in the belt pattern.
// NO ACCOUNT-NAME LITERAL APPEARS HERE: owner, group and mode ride in from the owned-directory targets
// and the fleet_posix_accounts group, never re-spelled (gunbc.design_argument::single_authority).
// THE PROD PATH IS UNTOUCHED: WorkerIsServiceUser declares no dedicated-worker member, so no demand is
// claimed and this plan emits zero legs. A spec without the GunbcSourceTree step likewise emits zero
// legs and its demands keep today's standing position (the both-ways gate).
fn deploy_apply_git_worker_subtree_plan(spec: DeploymentSpec, plan: ReleaseEffectPlan) -> DeployApplyPlan {
  if !git_worker_subtree_group_active(spec: spec, plan: plan) {
    ApplyPlanReady { legs: [] }
  } else {
    match dashboard_instance_for_id(instance_id: spec.instance_id as String) {
      // A fabricated default ("" for the repo root) would run the premise `git -C ""` against whatever
      // directory the applying process happens to be in. Refuse by name at plan time, like every other
      // unknown-instance arm; never fall through with an empty root.
      DashboardInstanceIdUnknown { instance_id: unknown_id } =>
        ApplyPlanRefused {
          step: "git-worker-subtree-premise",
          reason: join(["live-deploy apply refused: the git-worker subtree group reached an unknown dashboard instance (gunbc.roadmap.roadmap_dashboard_instance dashboard_instance_for_id): no repository root to premise the worker grants on. instance=", unknown_id], ""),
        }
      DashboardInstanceForId { instance: instance } =>
        match instance.worker {
          WorkerIsServiceUser => ApplyPlanReady { legs: [] }
          WorkerDedicatedAccount => deploy_apply_git_worker_subtree_group(spec: spec, plan: plan, instance: instance)
        }
    }
  }
}

// THE DEDICATED-WORKER BODY: premise, installs (through the OWNED-DIRECTORY MODEL, manager ruling (a):
// observe/decide/install/independent readback per target, owner group and mode from the target -- no
// hand-built install argv, no account name spelled here), the re-group sweep, the shared posture, and
// last the maintenance unit pair with its systemctl legs (the only ROOT legs, as in the belt pattern).
// The premise leads because every later leg presumes a repository; the fold stops at the premise when it
// fails, so the .git contents are never touched on a host whose .git is not a git directory.
fn deploy_apply_git_worker_subtree_group(spec: DeploymentSpec, plan: ReleaseEffectPlan, instance: HostDashboardInstance) -> DeployApplyPlan {
  let repo = instance.repo_root as NonEmptyStr
  let premise_leg = ApplyLegDiagnosedCommand {
    step: "git-worker-subtree-premise",
    command: git_absolute_git_dir_premise_argv(repo: repo),
    // The diagnosis reads the path the premise refused: owner, group and mode of <repo>/.git as they
    // stand, which is exactly the fact a refused premise needs on the record.
    diagnosis: stat_default_report_command(path: join([repo as String, "/.git"], "")),
  }
  let install_plan = deploy_apply_directories_plan_from(
    targets: filter(xs: deployment_directory_demands(spec: spec), predicate: t => git_worker_subtree_demand_claimed(spec: spec, plan: plan, t: t)),
    legs: [premise_leg],
  )
  let posture_group =
    if plan_mutation_is(plan: plan, member: RepositorySharedPosture { path: instance.repo_root as NonEmptyStr }, expected: AssertRepositorySharedPosture) {
      list_append(
        left: git_worker_subtree_posture_legs(remaining: dashboard_ensure_git_shared_repository_posture(instance: instance), n: 0, legs: []),
        right: [
          apply_belt_unit_leg(step: "git-maintenance-service-unit", dest: dashboard_git_maintenance_service_unit_path(instance: instance), file: dashboard_git_maintenance_service_unit_file(instance: instance)),
          apply_belt_unit_leg(step: "git-maintenance-timer-unit", dest: dashboard_git_maintenance_timer_unit_path(instance: instance), file: dashboard_git_maintenance_timer_unit_file(instance: instance)),
          apply_root_leg(step: "git-maintenance-daemon-reload", argv: systemctl_daemon_reload_argv()),
          apply_root_leg(step: "git-maintenance-timer-enable", argv: systemctl_enable_argv(unit: dashboard_git_maintenance_timer_unit_name(instance: instance) as NonEmptyStr)),
        ],
      )
    } else {
      []
    }
  match install_plan {
    ApplyPlanRefused { step: s, reason: r } => ApplyPlanRefused { step: s, reason: r }
    ApplyPlanReady { legs: base } =>
      ApplyPlanReady {
        legs: list_append(
          left: list_append(
            left: base,
            right: git_worker_subtree_sweep_legs(plan: plan, instance: instance, remaining: dashboard_git_worker_directory_children, legs: []),
          ),
          right: posture_group,
        ),
      }
  }
}

// ── THE FOLD ─────────────────────────────────────────────────────────────────────────────────────
//
// lab plan, then the tailscale client capability, then the wholesale membership refusal, then each
// family's legs in the order the script ran them. A family appears here when its legs are typed; the
// cutover to this plan happens when the last family does.
fn deploy_apply_chain(first: DeployApplyPlan, rest: DeployApplyPlan) -> DeployApplyPlan {
  match first {
    ApplyPlanRefused { step: s, reason: r } => ApplyPlanRefused { step: s, reason: r }
    ApplyPlanReady { legs: a } =>
      match rest {
        ApplyPlanRefused { step: s, reason: r } => ApplyPlanRefused { step: s, reason: r }
        ApplyPlanReady { legs: b } => ApplyPlanReady { legs: list_append(left: a, right: b) }
      }
  }
}

// THE APPROVAL BROKER'S STATE DIRECTORIES (device store, JWKS cache): one leg, owed only on the host whose
// spec owns the broker and only when the plan writes the broker unit. Its execution is the shared
// managed-directory convergence the dark install runs.
fn deploy_apply_broker_state_directories_plan(spec: DeploymentSpec, plan: ReleaseEffectPlan) -> DeployApplyPlan {
  if deployment_owns_the_host_approval_broker(spec: spec) && plan_writes_unit(plan: plan) {
    ApplyPlanReady { legs: [ApplyLegBrokerStateDirectories { revision: RevisionBoundAtEmission { revision: plan.target.revision } }] }
  } else {
    ApplyPlanReady { legs: [] }
  }
}

// THE OBJECT SOURCE THE TRANSFER READS FROM: one leg whose execution is extdeps.git.partial_clone
// observe_object_source_serve over the apply's source root. It leads the plan, as the Decide fragment led
// the script, so a source that cannot serve stops the run before any mutation.
fn deploy_apply_object_source_plan() -> DeployApplyPlan {
  ApplyPlanReady { legs: [ApplyLegObjectSource] }
}

// ── RELEASE MEMBERS ──────────────────────────────────────────────────────────────────────────────
//
// Every file a member installs travels as a stdin payload to the root install, never through a staged
// path on the host, so a leg carries the bytes it writes. The checkout's own paths are absolute under
// the apply's source root (the root the object-source leg observes), where the script read `$PWD`.
fn apply_root_leg(step: String, argv: List<String>) -> DeployApplyLeg {
  ApplyLegCommand { step: step, command: sudo_elevate_command(command: argv) }
}

fn apply_staged_leg(step: String, dest: String, payload: String) -> DeployApplyLeg {
  ApplyLegInstallFile {
    step: step,
    command: sudo_elevate_command(command: coreutils_install_file_owned_argv(
      mode: install_file_shared_mode,
      owner: approval_broker_helper_root_principal, group: approval_broker_helper_root_principal,
      source: "/dev/stdin", dest: dest)),
    payload: payload,
  }
}

fn apply_owned_directory_leg(spec: DeploymentSpec, step: String, path: String) -> DeployApplyLeg {
  apply_root_leg(step: step, argv: coreutils_install_directory_owned_argv(
    mode: install_d_shared_mode, owner: spec.service.service_user, group: spec.service.service_user, path: path))
}

fn apply_unit_text(file_text: String) -> String {
  render(doc: doc_text(text: file_text), proto: live_deploy_protocol)
}

// THE PUBLISHED TREE: the shared root, the service-owned repo root, the tree-sync environment naming
// the source root, the instance slice, the user-work and repository-convergence slices, the
// convergence unit, a reload, the restart whose failure carries the unit's status tail, and the
// readback of the receipt through the INSTALLED binary. A user-work slice that cannot derive its
// bounds refuses the plan with that cause.
fn deploy_apply_tree_plan(spec: DeploymentSpec, plan: ReleaseEffectPlan, source_root: String) -> DeployApplyPlan {
  if !plan_publishes_tree(plan: plan) {
    ApplyPlanReady { legs: [] }
  } else {
    match user_work_slice_unit_file() {
      UserWorkSliceUnitFileRefused { cause: c } =>
        ApplyPlanRefused { step: "user-work-slice", reason: join(["live-deploy apply refused: ", c, " (gunbc.design_argument::fail_closed: refuse, never widen)"], "") }
      UserWorkSliceUnitFileReady { file: f } =>
        match gunbc_installed_run_with_named_arguments_command(
          binary: fixed_serve_binary_path(binary: spec.service.serve_binary) as NonEmptyStr,
          source_roots: [join([source_root, "/dag"], ""), join([source_root, "/src/v2"], "")],
          entry: convergence_placement_entry_path,
          function: "repository_convergence_readback_wet",
          arguments: [
            NamedArgumentRequest { name: "receipt", value: convergence_receipt_path(instance_root: spec.service.instance_root as String) },
            // THE READBACK IS BOUND TO THE RUN IT ANSWERS FOR. The candidate is the very string this
            // apply's convergence unit was written with on its ExecStart -- the same plan field, the
            // same rendering row -- so the installed readback compares the receipt's candidate against
            // THIS plan's revision and a receipt left by a prior run refuses as stale (S83469995).
            NamedArgumentRequest { name: "candidate", value: release_revision_execstart_text(binding: RevisionBoundAtEmission { revision: plan.target.revision }) },
          ],
        ) {
          Absent => ApplyPlanRefused { step: "convergence-readback", reason: "live-deploy apply refused: the convergence readback arguments (receipt path and plan candidate) were not admitted", }
          Present { value: readback } =>
            ApplyPlanReady { legs: [
              apply_root_leg(step: "tree-root", argv: coreutils_install_directory_argv(mode: install_d_shared_mode, path: "/opt/gunbc")),
              apply_owned_directory_leg(spec: spec, step: "tree-repo-root", path: spec.service.repo_root as String),
              apply_staged_leg(step: "tree-sync-env", dest: spec.names.tree_sync_env_path as String, payload: join(["GUNBC_TREE_SRC=", source_root, "\n"], "")),
              apply_staged_leg(step: "instance-slice", dest: deployment_slice_unit_path(names: spec.names) as String, payload: render(doc: emit_slice_unit_doc(spec: spec), proto: live_deploy_protocol)),
              apply_owned_directory_leg(spec: spec, step: "instance-receipts-dir", path: instance_receipts_dir(instance_root: spec.service.instance_root as String)),
              apply_staged_leg(step: "user-work-slice", dest: gunbc_user_work_slice_unit_path() as String, payload: apply_unit_text(file_text: serialize_systemd_unit_file(file: f))),
              apply_root_leg(step: "user-work-slice-reload", argv: systemctl_user_daemon_reload_argv(uid: gunbc_service_uid)),
              apply_staged_leg(step: "repository-convergence-slice", dest: gunbc_repository_convergence_slice_unit_path() as String, payload: render(doc: emit_repository_convergence_slice_unit_doc(), proto: live_deploy_protocol)),
              apply_staged_leg(
                step: "tree-sync-unit",
                dest: tree_sync_unit_path(names: spec.names) as String,
                payload: convergence_unit_doc(
                  spec: spec,
                  candidate: release_revision_execstart_text(binding: RevisionBoundAtEmission { revision: plan.target.revision }),
                  receipt_path: convergence_receipt_path(instance_root: spec.service.instance_root as String),
                  working_directory: source_root,
                )),
              apply_root_leg(step: "tree-sync-reload", argv: systemctl_daemon_reload_argv()),
              ApplyLegDiagnosedCommand {
                step: "tree-sync-restart",
                command: sudo_elevate_command(command: systemctl_restart_argv(unit: spec.names.tree_sync_unit_name)),
                diagnosis: sudo_elevate_command(command: systemctl_status_argv(unit: spec.names.tree_sync_unit_name)),
              },
              ApplyLegCommand { step: "convergence-readback", command: readback },
            ] }
        }
    }
  }
}

// THE RELEASE EXECUTABLE: the built binary is verified against the plan's digest BEFORE it is copied and
// the installed copy AFTER, so an installed executable can never differ from the identity the plan
// declared converged.
fn deploy_apply_executable_plan(spec: DeploymentSpec, plan: ReleaseEffectPlan, source_root: String) -> DeployApplyPlan {
  if !plan_installs_executable(plan: plan) {
    ApplyPlanReady { legs: [] }
  } else {
    let source = join([source_root, "/", release_executable_install_source], "")
    ApplyPlanReady { legs: [
      ApplyLegDigestVerify { step: "executable-source-digest", path: source, digest: plan.target.executable },
      apply_root_leg(step: "executable-dir", argv: coreutils_install_directory_argv(mode: install_d_shared_mode, path: path_parent_dir(path: fixed_serve_binary_path(binary: spec.service.serve_binary)))),
      apply_root_leg(step: "executable-install", argv: coreutils_install_file_owned_argv(
        mode: install_executable_shared_mode,
        owner: spec.service.service_user, group: spec.service.service_user,
        source: source, dest: fixed_serve_binary_path(binary: spec.service.serve_binary))),
      ApplyLegDigestVerify { step: "executable-installed-digest", path: fixed_serve_binary_path(binary: spec.service.serve_binary), digest: plan.target.executable },
      apply_owned_directory_leg(spec: spec, step: "instance-receipts-dir", path: instance_receipts_dir(instance_root: spec.service.instance_root as String)),
    ] }
  }
}

// ── THE UNIT FILE AND ITS LIFECYCLE ──────────────────────────────────────────────────────────────
//
// The attempt-worker sandbox the lab plan selected (its slice, the per-instance spool, and the launcher's
// root-owned helper grant), the broker's release tree and units on the host that owns the broker, the
// serve unit; then the reload, and the enable and restart of the serve unit and the owned broker. A serve
// unit whose OIDC readback was refused refuses the plan: the script emitted nothing for that member and
// the run converged without a unit, which read an unknown as nothing to do.
fn apply_install_directory_leg(step: String, mode: FileMode, owner: NonEmptyStr, group: NonEmptyStr, path: String) -> DeployApplyLeg {
  apply_root_leg(step: step, argv: coreutils_install_directory_owned_argv(mode: mode, owner: owner, group: group, path: path))
}

fn apply_root_directory_leg(step: String, mode: FileMode, group: NonEmptyStr, path: String) -> DeployApplyLeg {
  apply_install_directory_leg(step: step, mode: mode, owner: approval_broker_helper_root_principal, group: group, path: path)
}

fn deploy_apply_attempt_spool_legs(spec: DeploymentSpec) -> List<DeployApplyLeg> {
  let root = approval_broker_helper_root_principal
  let service = spec.service.service_user
  let instance_root = spec.service.instance_root as String
  [
    apply_root_directory_leg(step: "attempt-spool-root", mode: declared_directory_mode(m: DirectoryOwnerAllEveryoneTraverse), group: root, path: attempt_unit_spool_root(instance_root: instance_root)),
    apply_root_directory_leg(step: "attempt-spool-staging", mode: publication_spool_request_mode, group: service, path: attempt_unit_spool_staging_dir(instance_root: instance_root)),
    apply_root_directory_leg(step: "attempt-spool-request", mode: publication_spool_request_mode, group: service, path: attempt_unit_spool_request_dir(instance_root: instance_root)),
    apply_root_directory_leg(step: "attempt-spool-claimed", mode: declared_directory_mode(m: DirectoryOwnerOnly), group: root, path: attempt_unit_spool_claimed_dir(instance_root: instance_root)),
    apply_root_directory_leg(step: "attempt-spool-deferred", mode: declared_directory_mode(m: DirectoryOwnerOnly), group: root, path: attempt_unit_spool_deferred_dir(instance_root: instance_root)),
    apply_root_directory_leg(step: "attempt-spool-answer", mode: attempt_unit_spool_answer_mode, group: service, path: attempt_unit_spool_answer_dir(instance_root: instance_root)),
    apply_root_directory_leg(step: "attempt-spool-stalled", mode: publication_spool_request_mode, group: service, path: attempt_unit_spool_stalled_dir(instance_root: instance_root)),
  ]
}

// THE ROOT-OWNED CREDSTORE COPY A DEDICATED WORKER UNIT IS HANDED (gunbc.roadmap.dispatch_worker_unit_confinement
// dispatch_worker_credentials, whose credstore_path the launcher's LoadCredential= line names too). The custody
// file is read AS THE APPLY'S PRINCIPAL -- the service user, whose file it is -- and root installs the copy, 0400
// root:root, from a stage that principal owns. Root never opens the custody path, so a relinked custody file
// cannot turn a deploy into a root read of an arbitrary file, and the copy can only ever hold bytes the custody
// owner could read itself.
//
// THIS IS THE HOST-SIDE REALIZATION OF gunbc.auth.private_secret_file with_private_secret_file, AND A STATED
// DIVERGENCE FROM CALLING IT. The bracket's discipline is kept exactly: a fresh `mktemp -d` (0700, the principal's
// own), the file created owner-only inside it, the one use (here the root install), then `rm -f` of the file and
// `rmdir` of the directory, the rmdir being the removal check; four outcomes, four remedies, and no arm carries a
// path (a stage path dereferences to the secret). It cannot CALL the bracket: the bracket holds the secret
// in-process (Filesystem.WriteOwnerOnly of a Secret value), and this leg must never hold it -- the bytes stay on
// the host and are copied there by the host's own commands, so they never ride the apply's transport (under
// SshShell, a read through the command port would carry the key to the controller and back). So the leg names
// the five commands (credstore_copy_stage_command, credstore_copy_commands) and the runner
// (gunbc.host.host_effect_realize credstore_copy_bracket) folds their outcomes into
// CredstoreCopyBracket. No credential, no legs: a service-user worker reads its own custody.
data credstore_copy_stage_template: NonEmptyStr = "/tmp/gunbc-credstore.XXXXXX"

data credstore_copy_stage_file_mode: NonEmptyStr = "0600"

data credstore_copy_installed_file_mode: NonEmptyStr = "0400"

fn credstore_copy_stage_command() -> ArgvCommand {
  mktemp_directory_command(template: credstore_copy_stage_template)
}

// THE FOUR COMMANDS THAT FOLLOW THE STAGE, in run order: the principal's own copy, root's install from the stage,
// then the removal. Only root_install runs elevated, and its words name the stage file, never the source.
type CredstoreCopyCommands {
  user_copy: ArgvCommand
  root_install: ArgvCommand
  remove_file: ArgvCommand
  remove_dir: ArgvCommand
}

fn credstore_copy_commands(stage: NonEmptyStr, source: NonEmptyStr, dest: NonEmptyStr, file_name: NonEmptyStr) -> CredstoreCopyCommands {
  let staged = join([stage as String, "/", file_name as String], "")
  CredstoreCopyCommands {
    user_copy: install_file_mode_command(source: source as String, destination: staged, mode: credstore_copy_stage_file_mode),
    root_install: sudo_elevate_command(command: coreutils_install_file_owned_argv(
      mode: credstore_copy_installed_file_mode,
      owner: approval_broker_helper_root_principal, group: approval_broker_helper_root_principal,
      source: staged, dest: dest as String)),
    remove_file: rm_force_command(path: staged),
    remove_dir: rmdir_command(path: stage as String),
  }
}

// THE BRACKET'S FOUR REMEDIES (gunbc.auth.private_secret_file PrivateSecretFileBracket). Entered means the root
// install ran; `installed` is its result, carried because the effect may have happened.
type CredstoreCopyBracket
  = CredstoreCopyCompleted { installed: Bool }
  | CredstoreCopyCompletedResidueRemains { installed: Bool }
  | CredstoreCopyNotEntered { cause: NonEmptyStr }
  | CredstoreCopyNotEnteredResidueRemains { cause: NonEmptyStr }

fn credstore_copy_legs(instance: HostDashboardInstance) -> List<DeployApplyLeg> {
  match dispatch_worker_credentials(instance: instance).first() {
    Absent => []
    Present { value: _ } =>
      concat(
        [apply_root_directory_leg(step: "worker-credstore-dir", mode: declared_directory_mode(m: DirectoryOwnerOnly), group: approval_broker_helper_root_principal, path: systemd_system_credstore_directory as String)],
        map(dispatch_worker_credentials(instance: instance), c => ApplyLegCredstoreCopy {
          step: "worker-credstore-copy",
          source: c.custody_source,
          dest: c.credstore_path,
          file_name: c.identifier,
        }),
      )
  }
}

// THE ROOT SIDE OF THE ATTEMPT-UNIT SPOOL, WITHOUT A SUDO GRANT. The requester writes its request into the
// spool; a .path unit on the request directory starts the drain, a system oneshot (deploy_apply_attempt_drain_plan).
// So the sandbox half installs the spool, removes the retired sudo route (the sudoers drop-in, the revision
// receipt and the flock file), checks the sudoers policy still parses, and installs the root-owned release
// snapshot the drain unit's ExecStart names. The superseded snapshots are retired by the drain plan, after
// the units that name the new one stand.
fn deploy_apply_attempt_launcher_plan(spec: DeploymentSpec, revision: ReleaseRevisionBinding) -> DeployApplyPlan {
  match dashboard_instance_for_id(instance_id: spec.instance_id as String) {
    DashboardInstanceIdUnknown { instance_id: id } =>
      ApplyPlanRefused { step: "attempt-unit-drain", reason: join(["live-deploy apply refused: the attempt-unit drain has no HostDashboardInstance for instance ", id, ", so it will not install a snapshot for an unknown instance"], "") }
    DashboardInstanceForId { instance: instance } =>
      match retired_attempt_unit_sudo_route_paths(instance: instance) {
        Empty => ApplyPlanRefused { step: "attempt-unit-sudo-route-retire", reason: "live-deploy apply refused: the retired sudo route names no path" }
        Cons { head: h, tail: rest } =>
          ApplyPlanReady { legs: concat(
            concat(deploy_apply_attempt_spool_legs(spec: spec), credstore_copy_legs(instance: instance)),
            [
              ApplyLegRetract { step: "attempt-unit-sudo-route-retire", leg: retract_remove_files(head: h as NonEmptyStr, rest: map(rest, p => p as NonEmptyStr)) },
              ApplyLegCommand { step: "attempt-unit-sudoers-check", command: visudo_check_command(file: "/etc/sudoers") },
              ApplyLegRootHelperSnapshot {
                locus: attempt_system_unit_launcher_locus(instance: instance),
                spine: [attempt_system_unit_launcher_helpers_root, attempt_system_unit_launcher_locus(instance: instance).base],
                revision: revision,
                action: HelperSnapshotInstall,
              },
            ],
          ) }
      }
  }
}

// THE DRAIN: a system oneshot service and the path unit that starts it when the request directory is
// non-empty, then the retire of the superseded snapshots. The retire is the LAST leg: the units that name
// the new snapshot are installed and the path unit restarted before the old release is removed.
// THE FIRST CONSUMER OF gunbc.live_deploy.intent DeploymentIntent: the attempt-unit drain's
// helper closure. The intent says WHICH instance's revision the act owes; this is the plan's ONE
// resolution of that instance — it refuses no roster row, and for a resolved instance it carries
// both the verify leg and the instance whose locus the retire leg will name. The verify leg asks,
// at apply time and BEFORE any enable, that the snapshot the drain unit names exists with its
// declared members ({gunbc, dag, src/v2} -- the same three attempt_system_unit_launch copies) and
// that the locus tree and its ancestors are root-owned with no untrusted entry (the same readback
// the install arm runs, so verify and install cannot disagree about what "installed" means). This
// turns the lab's 127-falling-five-hours drain -- a drain unit enabled while nothing had installed
// its snapshot -- into one refused apply step that names the missing path.

type AttemptHelperClosure {
  instance: HostDashboardInstance,
  verify: DeployApplyLeg,
}

fn attempt_helper_snapshot_closure(intent: DeploymentIntent) -> Optional<AttemptHelperClosure> {
  match dashboard_instance_for_id(instance_id: intent.instance_id) {
    DashboardInstanceForId { instance: instance } => Present {
      value: AttemptHelperClosure {
        instance: instance,
        verify: ApplyLegRootHelperSnapshot {
          locus: attempt_system_unit_launcher_locus(instance: instance),
          spine: [attempt_system_unit_launcher_helpers_root, attempt_system_unit_launcher_locus(instance: instance).base],
          revision: intent.revision,
          action: HelperSnapshotVerify,
        },
      },
    }
    DashboardInstanceIdUnknown { instance_id: _ } => Absent
  }
}

fn deploy_apply_attempt_drain_plan(spec: DeploymentSpec, revision: ReleaseRevisionBinding) -> DeployApplyPlan {
  match attempt_helper_snapshot_closure(
    intent: DeploymentIntent { instance_id: spec.instance_id as String, revision: revision },
  ) {
    Absent =>
      ApplyPlanRefused { step: "attempt-unit-drain", reason: join(["live-deploy apply refused: the attempt-unit drain has no HostDashboardInstance for instance ", spec.instance_id as String, " -- no roster row, so no locus to verify; enabling a drain unit whose snapshot cannot be witnessed is the 127-after-enable this plan exists to refuse"], "") }
    Present { value: closure } =>
      match live_deploy_attempt_unit_drain_service_unit_file(spec: spec, instance: closure.instance, revision: revision) {
        AttemptUnitDrainServiceRefused { cause: c } =>
          ApplyPlanRefused { step: "attempt-unit-drain", reason: join(["live-deploy apply refused: the attempt-unit launch argument was refused, so it will not pin a false argv: ", attempt_system_unit_launch_argv_refused_detail(cause: c)], "") }
        AttemptUnitDrainServiceReady { file: service } =>
          ApplyPlanReady { legs: concat(concat([
            apply_staged_leg(step: "attempt-unit-drain-service-unit", dest: deployment_attempt_unit_drain_service_unit_path(names: spec.names) as String, payload: apply_unit_text(file_text: serialize_systemd_unit_file(file: service))),
            apply_staged_leg(step: "attempt-unit-drain-path-unit", dest: deployment_attempt_unit_drain_path_unit_path(names: spec.names) as String, payload: apply_unit_text(file_text: serialize_systemd_unit_file(file: live_deploy_attempt_unit_drain_path_unit_file(spec: spec)))),
            apply_root_leg(step: "attempt-unit-drain-reload", argv: systemctl_daemon_reload_argv()),
            closure.verify,
          ], apply_enable_restart_legs(step: "attempt-unit-drain", unit: deployment_attempt_unit_drain_path_unit_name(names: spec.names))), [
            ApplyLegRootHelperSnapshot {
              locus: attempt_system_unit_launcher_locus(instance: closure.instance),
              spine: [attempt_system_unit_launcher_helpers_root, attempt_system_unit_launcher_locus(instance: closure.instance).base],
              revision: revision,
              action: HelperSnapshotRetireSuperseded,
            },
          ]) }
      }
  }
}

// THE INSTALLED SLICE FILE MUST BE THE EFFECTIVE VALUE. A `systemctl set-property` leaves
// 50-MemoryMax.conf / 50-MemoryHigh.conf under system.control, and those directories outrank
// /etc/systemd/system, so srv1's attempt-worker slice read 66 GiB (written 2026-11-04 17:01, modeled
// nowhere) over the 44 GiB file. This removes exactly the two MEMORY residue files (never swap, never
// `systemctl revert`, which removes every drop-in:
// gunbc.recurring_failure_mode a_residue_teardown_removes_every_dropin_of_the_unit_it_names),
// reusing gunbc.host.host_axis_caps control_shadow_removal_argvs. The daemon-reload that makes the
// file effective is the lifecycle leg deploy_apply_lifecycle_legs appends after every unit write.
fn attempt_worker_slice_memory_residue_legs() -> List<DeployApplyLeg> {
  map(
    control_shadow_removal_argvs(
      unit: attempt_worker_slice_unit_name,
      properties: [systemd_memory_max_property as NonEmptyStr, systemd_memory_high_property as NonEmptyStr]),
    argv => apply_root_leg(step: "attempt-worker-slice-memory-residue", argv: argv))
}

fn deploy_apply_worker_sandbox_plan(spec: DeploymentSpec, revision: ReleaseRevisionBinding) -> DeployApplyPlan {
  match spec.target.lab_plan {
    LabPlanRefused { cause: c } =>
      ApplyPlanRefused { step: "worker-sandbox", reason: join(["live-deploy apply refused: lab plan refused (", lab_plan_refusal_reason(cause: c) as String, ")"], "") }
    LabPlanReady { host: _, os_package_manager: _, tailscale_client: _, git_path: _, jq_path: _, timeout_path: _, worker_sandbox: choice } =>
      match choice {
        SystemManagerLauncherSelected =>
          match attempt_worker_slice_unit_file() {
            AttemptWorkerSliceUnitFileRefused { cause: c } =>
              ApplyPlanRefused { step: "attempt-worker-slice", reason: join(["live-deploy apply refused: ", c, " (gunbc.design_argument::fail_closed: refuse, never widen)"], "") }
            AttemptWorkerSliceUnitFileReady { file: f } =>
              deploy_apply_chain(
                first: ApplyPlanReady { legs: list_append(
                  left: [apply_staged_leg(step: "attempt-worker-slice", dest: gunbc_attempt_worker_slice_unit_path() as String, payload: apply_unit_text(file_text: serialize_systemd_unit_file(file: f)))],
                  right: attempt_worker_slice_memory_residue_legs(),
                ) },
                rest: deploy_apply_attempt_launcher_plan(spec: spec, revision: revision),
              )
          }
      }
  }
}

// THE BROKER'S RELEASE, AND THE SIDECAR STANDING BEFORE THE BROKER UNIT IS SWAPPED (#14685). The tree
// install puts every member of approval_broker_release_locus_executables into the locus, the sidecar
// binary among them, and reads each back. Then: the env file naming the digest of the sidecar AS
// INSTALLED (read back off the host, never off the build or a constant), the sidecar unit, a reload, the
// sidecar's enable and restart, and only then the broker's slice and unit. The broker unit loads that
// env file and orders itself after the sidecar unit, so a broker swap ahead of them leaves systemd
// unable to start it (run 39545280023). The broker's own enable and restart are lifecycle legs.
fn deploy_apply_broker_unit_write_legs(spec: DeploymentSpec, revision: ReleaseRevisionBinding) -> List<DeployApplyLeg> {
  if deployment_owns_the_host_approval_broker(spec: spec) {
    let owner = spec.approval_broker.service_user
    concat(concat([
      ApplyLegBrokerTree { revision: revision },
      ApplyLegDigestEnvFile {
        step: "device-crypto-digest-env",
        binary: device_crypto_sidecar_binary_path(spec: spec, revision: revision),
        env_name: approval_device_crypto_deployed_digest_env_name as String,
        dest: device_crypto_deployed_digest_env_file_path(root: spec.approval_broker.repo_root as String, revision: revision),
        owner: owner,
      },
      apply_staged_leg(step: "device-crypto-sidecar-unit", dest: gunbc_device_crypto_sidecar_unit_path() as String, payload: serialize_systemd_unit_file(file: live_deploy_device_crypto_sidecar_unit_file(spec: spec, revision: revision))),
      apply_root_leg(step: "device-crypto-sidecar-reload", argv: systemctl_daemon_reload_argv()),
    ], apply_enable_restart_legs(step: "device-crypto-sidecar", unit: gunbc_device_crypto_sidecar_unit_name)), [
      apply_staged_leg(step: "approval-broker-slice-unit", dest: gunbc_approval_broker_slice_unit_path() as String, payload: serialize_systemd_unit_file(file: approval_broker_slice_unit_file())),
      apply_staged_leg(
        step: "approval-broker-unit",
        dest: gunbc_approval_broker_unit_path() as String,
        payload: serialize_systemd_unit_file(file: live_deploy_approval_broker_unit_file_on(spec: spec, revision: revision, port: spec.approval_broker.listen.port))),
    ])
  } else {
    []
  }
}

fn deploy_apply_lifecycle_legs(spec: DeploymentSpec, plan: ReleaseEffectPlan) -> List<DeployApplyLeg> {
  list_append(
    left: if plan_reloads_manager(plan: plan) { [apply_root_leg(step: "unit-daemon-reload", argv: systemctl_daemon_reload_argv())] } else { [] },
    right: if !plan_restarts_process(plan: plan) { [] } else { list_append(
      left: [
        apply_root_leg(step: "serve-enable", argv: systemctl_enable_argv(unit: plan.target.unit)),
        apply_root_leg(step: "serve-restart", argv: systemctl_restart_argv(unit: plan.target.unit)),
      ],
      right: if deployment_owns_the_host_approval_broker(spec: spec) { [
        apply_root_leg(step: "approval-broker-enable", argv: systemctl_enable_argv(unit: gunbc_approval_broker_unit_name)),
        apply_root_leg(step: "approval-broker-restart", argv: systemctl_restart_argv(unit: gunbc_approval_broker_unit_name)),
      ] } else { [] },
    ) },
  )
}

// THE BOARD-FUNCTION CONVERGE UNIT (gunbc.live_deploy.board_function_converge_unit), a host singleton
// installed only by the deployment that holds the host's role singletons, on EVERY apply rather than only
// when the serve unit is rewritten: its own state -- unit, gate drop-ins, snapshot, the converge's result --
// is not the serve unit's, so a drifted or missing converge is repaired by the next apply whatever the
// serve unit's standing. The order: the root-owned snapshot the unit runs from; the unit; the gate drop-ins
// on the workload units (gunbc.live_deploy.board_function_converge_unit board_function_converge_gated_workloads);
// the retirement of any hand-installed removal it replaces (disable if loaded, then remove its files, both
// idempotent); a reload; enable; then reload-or-restart, which runs the converge now -- a start on first
// install, ExecReload after -- so a removal that does not read back stops the apply here, and the workloads
// that require it are not restarted (a restart would propagate to them). Only then is the superseded snapshot
// retired, once the unit that names the new one stands.
fn deploy_apply_board_function_converge_plan(spec: DeploymentSpec, revision: ReleaseRevisionBinding) -> DeployApplyPlan {
  if !deployment_owns_the_host_approval_broker(spec: spec) { ApplyPlanReady { legs: [] } } else {
    board_function_converge_install_plan(host: spec.target.host.identity, revision: revision, stage: BoardFunctionConvergeFullStage)
  }
}

// WHICH LEGS OF THE CONVERGE INSTALL A CALLER ASKS FOR. A deployment that owns the host runs them all, in the
// order above. A host with no deployment (srv2-srv4, gunbc.fleet.board_function_converge_delivery) runs the
// UNGATED stage first -- snapshot, unit, run -- and the GATE stage only after the run's admission latch reads
// back, so a tree that differs from the route leaves the host's workloads running and the refusal loud,
// rather than holding the container runtime and the runners down. The legs are the same rows either way.
type BoardFunctionConvergeStage
  = BoardFunctionConvergeFullStage
  | BoardFunctionConvergeUngatedStage
  | BoardFunctionConvergeGateStage

fn board_function_converge_gate_legs() -> List<DeployApplyLeg> {
  let gate = serialize_systemd_drop_in(drop_in: board_function_converge_gate_drop_in())
  flat_map(board_function_converge_gated_workloads(), w => [
    apply_root_leg(step: "board-function-converge-gate-dir", argv: coreutils_install_directory_argv(mode: install_d_shared_mode, path: path_parent_dir(path: w.drop_in_path as String))),
    apply_staged_leg(step: "board-function-converge-gate", dest: w.drop_in_path as String, payload: apply_unit_text(file_text: gate)),
  ])
}

fn board_function_converge_install_plan(host: HostIdentity, revision: ReleaseRevisionBinding, stage: BoardFunctionConvergeStage) -> DeployApplyPlan {
  match board_function_converge_unit_file(host: host, revision: revision) {
    BoardFunctionConvergeUnitRefused { cause: _ } =>
      ApplyPlanRefused { step: "board-function-converge-unit", reason: "live-deploy apply refused: the board-function converge host argument was not admitted, so no unit naming a false argv is installed" }
    BoardFunctionConvergeUnitReady { file: unit } => {
      let locus = board_function_converge_locus()
      let gates = board_function_converge_gate_legs()
      let retire = flat_map(retired_hand_installed_removals_on(host), r => match r.paths {
        Empty => [ApplyLegRetract { step: "board-function-hand-unit-disable", leg: RetractDisableIfLoaded { unit: r.unit } }]
        Cons { head: h, tail: rest } => [
          ApplyLegRetract { step: "board-function-hand-unit-disable", leg: RetractDisableIfLoaded { unit: r.unit } },
          ApplyLegRetract { step: "board-function-hand-unit-remove", leg: retract_remove_files(head: h, rest: rest) },
        ]
      })
      let install = [
        ApplyLegRootHelperSnapshot { locus: locus, spine: [board_function_converge_helpers_root], revision: revision, action: HelperSnapshotInstall },
        apply_staged_leg(step: "board-function-converge-unit", dest: board_function_converge_unit_path() as String, payload: apply_unit_text(file_text: serialize_systemd_unit_file(file: unit))),
      ]
      let run = [
        apply_root_leg(step: "board-function-converge-reload", argv: systemctl_daemon_reload_argv()),
        apply_root_leg(step: "board-function-converge-enable", argv: systemctl_enable_argv(unit: board_function_converge_unit_name)),
        apply_root_leg(step: "board-function-converge-run", argv: systemctl_reload_or_restart_argv(unit: board_function_converge_unit_name)),
      ]
      let retire_superseded = [ApplyLegRootHelperSnapshot { locus: locus, spine: [board_function_converge_helpers_root], revision: revision, action: HelperSnapshotRetireSuperseded }]
      match stage {
        BoardFunctionConvergeFullStage => ApplyPlanReady { legs: concat(concat(concat(concat(install, gates), retire), run), retire_superseded) }
        BoardFunctionConvergeUngatedStage => ApplyPlanReady { legs: concat(concat(concat(install, retire), run), retire_superseded) }
        BoardFunctionConvergeGateStage => ApplyPlanReady { legs: concat(gates, [apply_root_leg(step: "board-function-converge-gate-reload", argv: systemctl_daemon_reload_argv())]) }
      }
    }
  }
}

// SRV1'S GPU POWER CAPS (gunbc.live_deploy.srv1_gpu_power_cap_unit), installed and enabled so the NEXT BOOT
// applies every admitted cap and reads it back; the engine unit Requires= it. Like the serving engine this
// STARTS NOTHING: no leg runs the converge now, so applying a deploy never changes a live card's limit.
// The unit runs from the board-function converge's root-owned snapshot of this revision, which the chain
// installs before this plan. A card without an admitted cap is a REPORT leg on every deploy, never a refusal:
// the selected configuration's service does not depend on a card that is not in it. A cap outside its card's
// reported range refuses the plan, because the unit would fail at boot and keep the engine down.
fn gpu_cap_report_legs(admissions: List<GpuCapAdmission>) -> List<DeployApplyLeg> {
  flat_map(admissions, a => match a {
    GpuCapDevicePending { board: b, cap: c, read_obligation: o } => [ApplyLegReport { step: "gpu-power-cap-pending", line: join(["gpu power cap pending for ", b as String, " at ", to_string(watt_count(w: c)), " W (reported, not a failure): ", o as String], "") }]
    GpuCapAdmitted { host: _, board: _, gpu_uuid: _, cap: _ } => []
    GpuCapOutsideDeviceRange { board: _, cap: _, minimum: _, maximum: _ } => []
  })
}

fn gpu_cap_refused_boards(admissions: List<GpuCapAdmission>) -> List<String> {
  flat_map(admissions, a => match a {
    GpuCapOutsideDeviceRange { board: b, cap: _, minimum: _, maximum: _ } => [b as String]
    GpuCapAdmitted { host: _, board: _, gpu_uuid: _, cap: _ } => []
    GpuCapDevicePending { board: _, cap: _, read_obligation: _ } => []
  })
}

fn deploy_apply_srv1_gpu_power_cap_plan(spec: DeploymentSpec, revision: ReleaseRevisionBinding) -> DeployApplyPlan {
  if !deployment_owns_the_host_approval_broker(spec: spec) || !srv1_gpu_power_cap_hosted_on(host: spec.target.host.identity) { ApplyPlanReady { legs: [] } } else {
    let admissions = gpu_cap_admissions_on(host: spec.target.host.identity)
    let refused = gpu_cap_refused_boards(admissions: admissions)
    if length(refused) > 0 {
      ApplyPlanRefused { step: "gpu-power-cap", reason: join(["live-deploy apply refused: the GPU power cap for ", join(refused, ", "), " is outside the device's reported range, so the cap unit would fail at boot and keep the serving engine down (DESIGN 5: refuse, never clamp)"], "") }
    } else {
      match srv1_gpu_power_cap_unit_file(host: spec.target.host.identity, revision: revision) {
        Srv1GpuPowerCapUnitRefused { cause: _ } =>
          ApplyPlanRefused { step: "gpu-power-cap", reason: "live-deploy apply refused: the GPU power-cap unit's host argument was not admitted (DESIGN 5: refuse, never widen)" }
        Srv1GpuPowerCapUnitReady { file: f } =>
          ApplyPlanReady { legs: concat(gpu_cap_report_legs(admissions: admissions), [
            apply_staged_leg(step: "gpu-power-cap-unit", dest: srv1_gpu_power_cap_unit_path() as String, payload: apply_unit_text(file_text: serialize_systemd_unit_file(file: f))),
            apply_root_leg(step: "gpu-power-cap-reload", argv: systemctl_daemon_reload_argv()),
            apply_root_leg(step: "gpu-power-cap-enable", argv: systemctl_enable_argv(unit: srv1_gpu_power_cap_unit_name)),
          ]) }
      }
    }
  }
}

// SRV1'S SERVING BOOT PATH (gunbc.live_deploy.srv1_serving_engine_unit), converged by the deployment that
// holds srv1's role singletons, on every apply. THE LEGACY SINGLETON IS NO LONGER INSTALLED. Since
// 2026-11-08 srv1 serves from TWO TP=1 replicas owned by the operator's systemd template lil-replica@.service
// (enabled @0 and @1); the old single gpu=all container that this leg used to install -- whose retained
// wrapper's first act is `docker rm -f lil-flash-next` -- would collide with that layout, so its install legs
// (wrapper-dir / wrapper / unit / enable-singleton) are GONE. What this leg does now:
//   (1) RETIRE the legacy singleton by path only -- its unit file, its WantedBy enablement link and its
//       wrapper -- plus the older hand unit. Removing files is a disable-without-stop; it is NEVER done with
//       RetractDisableIfLoaded, whose `disable --now` is a stop that runs the unit's stop hooks and kills what
//       remains in its cgroup (side-chat review of #15684). This is the guard: convergence is the authority
//       that KEEPS the gpu=all launch off srv1, not merely one that stopped installing it.
//   (2) a reload, then ENABLE the two replica instances, their names derived from the SAME roster the router
//       rows derive from (srv1_serving_replica_roster via srv1_replica_boot_unit_names).
// NO LEG STOPS, STARTS OR RESTARTS ANYTHING and NO LEG CARRIES `--now`: `systemctl enable` arms the next boot
// only, so the apply never touches a running engine; and the replica unit files/helper themselves are the
// operator's ADOPTED hand install (recorded on srv1_replica_unit_contract), not staged here while the operator
// configures live serving.
fn deploy_apply_srv1_serving_engine_plan(spec: DeploymentSpec) -> DeployApplyPlan {
  if !deployment_owns_the_host_approval_broker(spec: spec) || !srv1_serving_engine_hosted_on(host: spec.target.host.identity) { ApplyPlanReady { legs: [] } } else {
    // ONE route through the admission guard: the boot outcome is the guard's typed verdict over the
    // declared launch configuration. A REFUSAL stops the whole leg -- ApplyPlanRefused carries the defect
    // identity and cause -- rather than proceeding with the retire legs and no enables while reporting
    // green (fail_closed: a refusal that fires stops the line; proceeding as if it had not is an escape
    // hatch, and an already-enabled lil-replica@ would have stayed armed unnoticed).
    let boot = srv1_replica_boot_unit_names(config: srv1_admitted_launch_config)
    if srv1_boot_outcome_admitted(outcome: boot) {
      // (1) Retirement: every retired unit's files (the legacy singleton's unit, enablement link and wrapper;
      // the older hand unit) removed by path. One retract leg per retired removal, stepped by its unit name.
      let retire = flat_map(filter(srv1_serving_engine_retired_hand_units, r => host_identity_eq(a: r.host, b: spec.target.host.identity)), r => match r.paths {
        Empty => []
        Cons { head: h, tail: rest } => [ApplyLegRetract { step: join(["serving-engine-retire-", r.unit as String], "") as String, leg: retract_remove_files(head: h, rest: rest) }]
      })
      // (2) Enable the two replica boot instances, derived from the roster. `systemctl enable` (no --now): arms
      // the next boot, never starts the running engine.
      let enable_replicas = map(srv1_boot_outcome_units(outcome: boot), name => apply_root_leg(step: join(["serving-replica-enable-", name as String], "") as String, argv: systemctl_enable_argv(unit: name)))
      ApplyPlanReady { legs: concat(concat(retire, [
        apply_root_leg(step: "serving-engine-reload", argv: systemctl_daemon_reload_argv()),
      ]), enable_replicas) }
    } else {
      ApplyPlanRefused { step: "serving-replica-boot", reason: join(["launch admission refused -- boot is not armed and the apply stops: ", srv1_boot_outcome_refusal(outcome: boot)], "") as String }
    }
  }
}

fn deploy_apply_unit_plan(spec: DeploymentSpec, plan: ReleaseEffectPlan, oidc_now: Second?) -> DeployApplyPlan {
  let revision = RevisionBoundAtEmission { revision: plan.target.revision }
  match live_deploy_serve_unit_emission(spec: spec, revision: revision, now_epoch: oidc_now) {
    LiveDeployServeUnitOidcReadbackRefused { cause: c } =>
      ApplyPlanRefused { step: "serve-unit", reason: join(["live-deploy apply refused: the serve unit's OIDC readback was refused (", c as String, "), so no unit, reload or restart is applied (gunbc.design_argument::fail_closed: refuse, never widen)"], "") }
    LiveDeployServeUnitGrammarRefused { binary_path: bp, reason: r } =>
      ApplyPlanRefused { step: "serve-unit", reason: join(["live-deploy apply refused: the admitted serve binary ", bp as String, " cannot answer the seed CLI grammar the unit spells (", r as String, "); name the source at admission (gunbc.live_deploy.serve_binary.admit_fixed_serve_path) so the emitter knows what it is standing up (gunbc.design_argument::fail_closed: refuse, never widen)"], "") }
    LiveDeployServeUnitEmitted { file: f } =>
      deploy_apply_chain(
        first: if !plan_writes_unit(plan: plan) { ApplyPlanReady { legs: [] } } else {
          deploy_apply_chain(
            first: deploy_apply_worker_sandbox_plan(spec: spec, revision: revision),
            rest: ApplyPlanReady { legs: list_append(
              left: deploy_apply_broker_unit_write_legs(spec: spec, revision: revision),
              right: [apply_staged_leg(step: "serve-unit", dest: deployment_systemd_unit_path(names: spec.names) as String, payload: apply_unit_text(file_text: serialize_systemd_unit_file(file: f)))],
            ) },
          )
        },
        rest: deploy_apply_chain(
          first: deploy_apply_board_function_converge_plan(spec: spec, revision: revision),
          rest: deploy_apply_chain(
            first: deploy_apply_srv1_gpu_power_cap_plan(spec: spec, revision: revision),
            rest: deploy_apply_chain(
              first: deploy_apply_srv1_serving_engine_plan(spec: spec),
              rest: ApplyPlanReady { legs: deploy_apply_lifecycle_legs(spec: spec, plan: plan) },
            ),
          ),
        ),
      )
  }
}

// ── THE OIDC CONFIG FILE ─────────────────────────────────────────────────────────────────────────
//
// An instance the OIDC placement does not assign, or whose environment is unbound, owes no file. A missing
// realization, an unread observer clock, and an unsatisfied console readback each refuse the plan.
fn deploy_apply_oidc_refused(cause: String) -> DeployApplyPlan {
  ApplyPlanRefused { step: "oidc-config", reason: join(["live-deploy apply refused: the tracker-web OIDC readback was refused (", cause, ") (gunbc.design_argument::fail_closed: refuse, never widen)"], "") }
}

fn deploy_apply_oidc_plan(spec: DeploymentSpec, plan: ReleaseEffectPlan, oidc_now: Second?) -> DeployApplyPlan {
  match tracker_web_oidc_serve_placement(instance_id: spec.instance_id) {
    TrackerWebOidcPlacementUnassigned { instance_id: _ } => ApplyPlanReady { legs: [] }
    TrackerWebOidcPlacementUnbound { instance_id: _, reason: _ } => ApplyPlanReady { legs: [] }
    TrackerWebOidcPlacementMissingRealization { instance_id: _, environment: _ } => deploy_apply_oidc_refused(cause: "tracker-web OIDC realization missing")
    TrackerWebOidcServeReady { config: _ } =>
      match oidc_now {
        Absent => deploy_apply_oidc_refused(cause: "observer clock unreadable")
        Present { value: now } =>
          match tracker_web_oidc_serve_standing(instance_id: spec.instance_id, now_epoch: now) {
            TrackerWebOidcInstanceUnassigned { instance_id: _ } => ApplyPlanReady { legs: [] }
            TrackerWebOidcEnvironmentUnbound { instance_id: _, reason: _ } => ApplyPlanReady { legs: [] }
            TrackerWebOidcRealizationMissing { instance_id: _, environment: _ } => deploy_apply_oidc_refused(cause: "tracker-web OIDC realization missing")
            TrackerWebOidcConsoleReadbackUnsatisfied { instance_id: _, cause: c } => deploy_apply_oidc_refused(cause: c as String)
            TrackerWebOidcServeConfigured { config: cfg } =>
              if !plan_writes_oidc_config(plan: plan) {
                ApplyPlanReady { legs: [] }
              } else {
                ApplyPlanReady { legs: [
                  apply_root_leg(step: "oidc-config-dir", argv: coreutils_install_directory_argv(mode: install_d_shared_mode, path: path_parent_dir(path: cfg.config_path as String))),
                  ApplyLegInstallFile {
                    step: "oidc-config",
                    command: sudo_elevate_command(command: coreutils_install_file_owned_argv(
                      mode: install_file_owner_only_mode,
                      owner: spec.service.service_user, group: spec.service.service_user,
                      source: "/dev/stdin", dest: cfg.config_path as String)),
                    payload: tracker_web_oidc_config_document(cfg: cfg),
                  },
                ] }
              }
          }
      }
  }
}

// ── THE DEPLOYMENT'S STEPS, IN THE DEPLOYMENT'S ORDER ────────────────────────────────────────────
//
// Each step of spec.steps (gunbc.live_deploy.spec deployment_steps_apply_order, the one ordering
// authority) is planned in turn: an identity member's step by its family, every other step by the
// membership effects the reconcile derived for its key. The fold adds no order of its own.
// ── THE OWNED UPSERTS THE MEMBERSHIP EFFECTS DRIVE ───────────────────────────────────────────────
//
// A step that is no identity member is applied by the effects the reconcile derived for its key: an Add
// runs its kind's legs; a Replace and a Remove are unreachable on apply (retract owns removal) and refuse.
// A leftover timer is retired through the retract fold's own legs, run by the retract runner.
fn apply_serve_route_leg(step: String, endpoint: TailscaleServeEndpoint) -> DeployApplyLeg {
  apply_root_leg(step: step, argv: concat([tailscale_program().invocation as String], tailscale_serve_enable_argv(endpoint: endpoint)))
}

fn apply_leftover_timer_legs(step: String, unit: NonEmptyStr, path: NonEmptyStr) -> List<DeployApplyLeg> {
  map(retract_leftover_timer_legs(unit: unit, path: path), l => ApplyLegRetract { step: step, leg: l })
}

fn apply_enable_restart_legs(step: String, unit: NonEmptyStr) -> List<DeployApplyLeg> {
  [
    apply_root_leg(step: join([step, "-enable"], ""), argv: systemctl_enable_argv(unit: unit)),
    apply_root_leg(step: join([step, "-restart"], ""), argv: systemctl_restart_argv(unit: unit)),
  ]
}

fn deploy_apply_publication_legs(spec: DeploymentSpec, path: NonEmptyStr) -> List<DeployApplyLeg> {
  let pub = spec.names.publication_principal
  let instance_root = spec.service.instance_root as String
  concat(
    [
      apply_install_directory_leg(step: "publication-spool-root", mode: publication_spool_answer_mode, owner: pub, group: pub, path: publication_spool_root(instance_root: instance_root)),
      apply_install_directory_leg(step: "publication-spool-request", mode: publication_spool_request_mode, owner: pub, group: spec.service.service_user, path: publication_request_dir(instance_root: instance_root)),
      apply_install_directory_leg(step: "publication-spool-answer", mode: publication_spool_answer_mode, owner: pub, group: pub, path: publication_answer_dir(instance_root: instance_root)),
      apply_install_directory_leg(step: "publication-spool-refused", mode: publication_spool_answer_mode, owner: pub, group: pub, path: publication_refused_dir(instance_root: instance_root)),
      apply_install_directory_leg(step: "publication-bare-mirror", mode: declared_directory_mode(m: DirectoryOwnerOnly), owner: pub, group: pub, path: publication_bare_mirror_path(instance_root: instance_root) as String),
      apply_staged_leg(step: "publication-service-unit", dest: deployment_publication_service_unit_path(names: spec.names) as String, payload: render(doc: emit_publication_service_unit_doc(spec: spec), proto: live_deploy_protocol)),
      apply_staged_leg(step: "publication-path-unit", dest: path as String, payload: render(doc: emit_publication_path_unit_doc(spec: spec), proto: live_deploy_protocol)),
    ],
    concat(
      apply_leftover_timer_legs(step: "publication-timer-retire", unit: deployment_publication_timer_unit_name(names: spec.names), path: deployment_publication_timer_unit_path(names: spec.names)),
      apply_enable_restart_legs(step: "publication-path", unit: deployment_publication_path_unit_name(names: spec.names)),
    ),
  )
}

fn apply_belt_unit_leg(step: String, dest: NonEmptyStr, file: SystemdUnitFile) -> DeployApplyLeg {
  apply_staged_leg(step: step, dest: dest as String, payload: apply_unit_text(file_text: serialize_systemd_unit_file(file: file)))
}

fn deploy_apply_belt_legs(spec: DeploymentSpec, path: NonEmptyStr) -> List<DeployApplyLeg> {
  let instance_root = spec.service.instance_root as String
  let n = spec.names
  concat(
    [
      apply_owned_directory_leg(spec: spec, step: "instance-receipts-dir", path: instance_receipts_dir(instance_root: instance_root)),
      apply_owned_directory_leg(spec: spec, step: "attempt-exit-spool", path: attempt_exit_spool_root(instance_root: instance_root)),
      apply_owned_directory_leg(spec: spec, step: "attempt-exit-inbox", path: attempt_exit_inbox_dir(instance_root: instance_root)),
      apply_owned_directory_leg(spec: spec, step: "attempt-exit-queued", path: attempt_exit_queued_dir(instance_root: instance_root)),
      apply_owned_directory_leg(spec: spec, step: "attempt-exit-running", path: attempt_exit_running_dir(instance_root: instance_root)),
      apply_owned_directory_leg(spec: spec, step: "attempt-exit-done", path: attempt_exit_done_dir(instance_root: instance_root)),
      apply_owned_directory_leg(spec: spec, step: "attempt-exit-refused", path: attempt_exit_refused_dir(instance_root: instance_root)),
      apply_staged_leg(step: "belt-service-unit", dest: deployment_belt_service_unit_path(names: n) as String, payload: render(doc: emit_belt_service_unit_doc(spec: spec), proto: live_deploy_protocol)),
      apply_belt_unit_leg(step: "belt-exit-drain-unit", dest: deployment_belt_exit_drain_service_unit_path(names: n), file: live_deploy_belt_exit_drain_service_unit_file(spec: spec)),
      apply_belt_unit_leg(step: "belt-discovery-unit", dest: deployment_belt_discovery_service_unit_path(names: n), file: live_deploy_belt_discovery_service_unit_file(spec: spec)),
      apply_belt_unit_leg(step: "belt-credential-recovery-unit", dest: deployment_belt_credential_recovery_unit_path(names: n), file: live_deploy_belt_credential_recovery_unit_file(spec: spec)),
      apply_belt_unit_leg(step: "belt-credential-recovery-timer", dest: deployment_belt_credential_recovery_timer_unit_path(names: n), file: live_deploy_belt_credential_recovery_timer_unit_file(spec: spec)),
      apply_belt_unit_leg(step: "belt-answer-path-unit", dest: deployment_belt_answer_path_unit_path(names: n), file: live_deploy_belt_answer_path_unit_file(spec: spec)),
      apply_belt_unit_leg(step: "belt-exit-path-unit", dest: path, file: live_deploy_belt_exit_path_unit_file(spec: spec)),
      apply_root_leg(step: "belt-daemon-reload", argv: systemctl_daemon_reload_argv()),
      apply_root_leg(step: "belt-exit-drain-enable", argv: systemctl_enable_argv(unit: deployment_belt_exit_drain_service_unit_name(names: n))),
    ],
    concat(
      concat(
        apply_enable_restart_legs(step: "belt-exit-path", unit: deployment_belt_exit_path_unit_name(names: n)),
        concat(
          apply_enable_restart_legs(step: "belt-answer-path", unit: deployment_belt_answer_path_unit_name(names: n)),
          apply_enable_restart_legs(step: "belt-credential-recovery-timer", unit: deployment_belt_credential_recovery_timer_unit_name(names: n)),
        ),
      ),
      apply_leftover_timer_legs(step: "belt-retired-timer-retire", unit: deployment_retired_belt_timer_unit_name(names: n), path: deployment_retired_belt_timer_unit_path(names: n)),
    ),
  )
}

fn deploy_apply_tree_remote_legs(spec: DeploymentSpec, path: NonEmptyStr) -> List<DeployApplyLeg> {
  [
    apply_staged_leg(step: "tree-remote-unit", dest: path as String, payload: render(doc: emit_tree_remote_unit_doc(spec: spec), proto: live_deploy_protocol)),
    apply_root_leg(step: "tree-remote-reload", argv: systemctl_daemon_reload_argv()),
    apply_root_leg(step: "tree-remote-restart", argv: systemctl_restart_argv(unit: deployment_tree_remote_unit_name(names: spec.names))),
  ]
}

fn deploy_apply_upsert_plan(kind: UpsertArtifactKind, path: NonEmptyStr, spec: DeploymentSpec, plan: ReleaseEffectPlan, source_root: String) -> DeployApplyPlan {
  match kind {
    // THE GIT-WORKER SUBTREE GROUP ENTERS AT THE TREE MEMBER'S POSITION, after the tree plan's own legs
    // (whose tail is the convergence readback): the repository must exist before the premise reads it,
    // and nothing in the group runs if the tree step itself refuses (the chain short-circuits).
    GunbcSourceTree => deploy_apply_chain(first: deploy_apply_tree_plan(spec: spec, plan: plan, source_root: source_root), rest: deploy_apply_git_worker_subtree_plan(spec: spec, plan: plan))
    ServeBinary => deploy_apply_executable_plan(spec: spec, plan: plan, source_root: source_root)
    PublicationHelperPathUnit => ApplyPlanReady { legs: deploy_apply_publication_legs(spec: spec, path: path) }
    BeltEventPathUnit => ApplyPlanReady { legs: deploy_apply_belt_legs(spec: spec, path: path) }
    AttemptUnitDrainPathUnit => deploy_apply_attempt_drain_plan(spec: spec, revision: RevisionBoundAtEmission { revision: plan.target.revision })
    DeployedTreeRemoteUnit => ApplyPlanReady { legs: deploy_apply_tree_remote_legs(spec: spec, path: path) }
    TailscaleServeMapping =>
      match deployment_tailnet_door_socket(names: spec.names) {
        Present { value: _ } => ApplyPlanReady { legs: [] }
        Absent => ApplyPlanReady { legs: [apply_serve_route_leg(step: "tailscale-serve-mapping", endpoint: spec.names.tailscale_serve_endpoint)] }
      }
    ApprovalBrokerFrontDoor =>
      ApplyPlanReady { legs: map(deployment_approval_broker_front_door_endpoints(), e => apply_serve_route_leg(step: "approval-broker-front-door", endpoint: e)) }
  }
}

fn deploy_apply_effect_plan(effect: MemberEffect<DeploymentStep>, spec: DeploymentSpec, plan: ReleaseEffectPlan, source_root: String) -> DeployApplyPlan {
  match effect {
    EffectAdd { to: step } =>
      match step {
        Dependency { step: dep } => ApplyPlanReady { legs: [ApplyLegDependency { dep: dep }] }
        ArtifactStep { step: art } =>
          match art.kind {
            UpsertOwned { kind: uk } => deploy_apply_upsert_plan(kind: uk, path: art.path, spec: spec, plan: plan, source_root: source_root)
            ComposeOwned { kind: _ } =>
              ApplyPlanRefused { step: "spec-step", reason: join(["live-deploy apply refused: a composed step reached the membership effects (", deployment_step_key(step: step) as String, "); composed steps are planned by their kind"], "") }
          }
      }
    EffectReplace { from: _, to: step } =>
      ApplyPlanRefused { step: "replace", reason: join(["live-deploy apply refused: a Replace effect is unreachable on apply: ", deployment_step_key(step: step) as String], "") }
    EffectRemove { from: step } =>
      ApplyPlanRefused { step: "remove", reason: join(["live-deploy apply refused: a Remove effect is realized by the retract fold, never by apply: ", deployment_step_key(step: step) as String], "") }
  }
}

fn deploy_apply_effects_plan(effects: List<MemberEffect<DeploymentStep>>, spec: DeploymentSpec, plan: ReleaseEffectPlan, source_root: String) -> DeployApplyPlan {
  match effects {
    Empty => ApplyPlanReady { legs: [] }
    Cons { head: e, tail: rest } =>
      deploy_apply_chain(
        first: deploy_apply_effect_plan(effect: e, spec: spec, plan: plan, source_root: source_root),
        rest: deploy_apply_effects_plan(effects: rest, spec: spec, plan: plan, source_root: source_root),
      )
  }
}

// ── THE COMPOSED UNITS ───────────────────────────────────────────────────────────────────────────
//
// Fabric storage is one unit and one serve route, planned once whichever of its two steps the spec
// carries; a spec holding no prod role has no door socket and refuses. The tailnet door is a unit whose
// OIDC readback can refuse. The fleet-converge timer is retired from deployment membership: a spec that
// still names it refuses.
fn deploy_apply_unit_lifecycle_legs(step: String, unit: NonEmptyStr, dest: NonEmptyStr, file: SystemdUnitFile) -> List<DeployApplyLeg> {
  concat(
    [
      apply_staged_leg(step: join([step, "-unit"], ""), dest: dest as String, payload: apply_unit_text(file_text: serialize_systemd_unit_file(file: file))),
      apply_root_leg(step: join([step, "-reload"], ""), argv: systemctl_daemon_reload_argv()),
    ],
    apply_enable_restart_legs(step: step, unit: unit),
  )
}

fn deploy_apply_fabric_storage_plan(spec: DeploymentSpec, revision: ReleaseRevisionBinding) -> DeployApplyPlan {
  match deployment_fabric_storage_door_socket(spec: spec) {
    Absent =>
      ApplyPlanRefused { step: "fabric-storage", reason: join(["live-deploy apply refused: the fabric storage step was reached with a deployment that holds no prod role, so it has no door socket. instance=", spec.instance_id as String], "") }
    Present { value: door } =>
      ApplyPlanReady { legs: concat(
        deploy_apply_unit_lifecycle_legs(
          step: "fabric-storage",
          unit: deployment_fabric_storage_unit_name(names: spec.names),
          dest: deployment_fabric_storage_unit_path(names: spec.names),
          file: live_deploy_fabric_storage_unit_file(spec: spec, revision: revision, door_socket: door)),
        [apply_serve_route_leg(step: "fabric-storage-serve", endpoint: deployment_fabric_storage_serve_endpoint(door_socket: door))],
      ) }
  }
}

fn deploy_apply_tailnet_door_plan(spec: DeploymentSpec, revision: ReleaseRevisionBinding, oidc_now: Second?) -> DeployApplyPlan {
  match live_deploy_tailnet_door_unit_file(spec: spec, revision: revision, now_epoch: oidc_now) {
    LiveDeployTailnetDoorUnitNotDeployed => ApplyPlanReady { legs: [] }
    LiveDeployTailnetDoorUnitOidcReadbackRefused { cause: c } =>
      ApplyPlanRefused { step: "tailnet-door", reason: join(["live-deploy apply refused: the tailnet door unit's OIDC readback was refused (", c as String, ") (gunbc.design_argument::fail_closed: refuse, never widen)"], "") }
    LiveDeployTailnetDoorUnitEmitted { file: f } =>
      ApplyPlanReady { legs: deploy_apply_unit_lifecycle_legs(
        step: "tailnet-door",
        unit: deployment_tailnet_door_unit_name(names: spec.names),
        dest: deployment_tailnet_door_unit_path(names: spec.names),
        file: f) }
  }
}

fn deploy_apply_agent_door_plan(spec: DeploymentSpec, revision: ReleaseRevisionBinding, oidc_now: Second?) -> DeployApplyPlan {
  match live_deploy_agent_door_unit_file(spec: spec, revision: revision, now_epoch: oidc_now) {
    LiveDeployTailnetDoorUnitNotDeployed => ApplyPlanReady { legs: [] }
    LiveDeployTailnetDoorUnitOidcReadbackRefused { cause: c } =>
      ApplyPlanRefused { step: "agent-door", reason: join(["live-deploy apply refused: the agent door unit's OIDC readback was refused (", c as String, ") (gunbc.design_argument::fail_closed: refuse, never widen)"], "") }
    LiveDeployTailnetDoorUnitEmitted { file: f } =>
      ApplyPlanReady { legs: deploy_apply_unit_lifecycle_legs(
        step: "agent-door",
        unit: deployment_agent_door_unit_name(names: spec.names),
        dest: deployment_agent_door_unit_path(names: spec.names),
        file: f) }
  }
}

fn deploy_apply_step_effects_plan(step: DeploymentStep, effects: List<MemberEffect<DeploymentStep>>, spec: DeploymentSpec, plan: ReleaseEffectPlan, source_root: String) -> DeployApplyPlan {
  deploy_apply_effects_plan(
    effects: filter(effects, e => deployment_step_key_eq(a: deployment_step_key(step: member_effect_step(e: e)), b: deployment_step_key(step: step))),
    spec: spec, plan: plan, source_root: source_root,
  )
}

fn deploy_apply_step_plan(step: DeploymentStep, effects: List<MemberEffect<DeploymentStep>>, spec: DeploymentSpec, plan: ReleaseEffectPlan, source_root: String, oidc_now: Second?) -> DeployApplyPlan {
  match step {
    Dependency { step: _ } => deploy_apply_step_effects_plan(step: step, effects: effects, spec: spec, plan: plan, source_root: source_root)
    ArtifactStep { step: art } =>
      match art.kind {
        ComposeOwned { kind: ck } =>
          match ck {
            OidcConfigArtifact => deploy_apply_oidc_plan(spec: spec, plan: plan, oidc_now: oidc_now)
            SystemdUnit => deploy_apply_unit_plan(spec: spec, plan: plan, oidc_now: oidc_now)
            FabricStorageServeUnit => deploy_apply_fabric_storage_plan(spec: spec, revision: RevisionBoundAtEmission { revision: plan.target.revision })
            FabricStorageServeMapping =>
              if spec_has_artifact_kind(spec: spec, kind: ComposeOwned { kind: FabricStorageServeUnit }) {
                ApplyPlanReady { legs: [] }
              } else {
                deploy_apply_fabric_storage_plan(spec: spec, revision: RevisionBoundAtEmission { revision: plan.target.revision })
              }
            TailnetDoorServeUnit => deploy_apply_tailnet_door_plan(spec: spec, revision: RevisionBoundAtEmission { revision: plan.target.revision }, oidc_now: oidc_now)
            AgentDoorServeUnit => deploy_apply_agent_door_plan(spec: spec, revision: RevisionBoundAtEmission { revision: plan.target.revision }, oidc_now: oidc_now)
            FleetConvergeTimerUnit =>
              ApplyPlanRefused { step: "fleet-converge-timer", reason: "live-deploy apply refused: FleetConvergeTimerUnit is retired from deployment membership; timer cadence is on-demand via fleet-converge plan/apply, not live_deploy apply" }
          }
        UpsertOwned { kind: uk } =>
          match uk {
            GunbcSourceTree => deploy_apply_chain(first: deploy_apply_tree_plan(spec: spec, plan: plan, source_root: source_root), rest: deploy_apply_git_worker_subtree_plan(spec: spec, plan: plan))
            ServeBinary => deploy_apply_executable_plan(spec: spec, plan: plan, source_root: source_root)
            AttemptUnitDrainPathUnit => deploy_apply_step_effects_plan(step: step, effects: effects, spec: spec, plan: plan, source_root: source_root)
            BeltEventPathUnit => deploy_apply_step_effects_plan(step: step, effects: effects, spec: spec, plan: plan, source_root: source_root)
            TailscaleServeMapping => deploy_apply_step_effects_plan(step: step, effects: effects, spec: spec, plan: plan, source_root: source_root)
            DeployedTreeRemoteUnit => deploy_apply_step_effects_plan(step: step, effects: effects, spec: spec, plan: plan, source_root: source_root)
            PublicationHelperPathUnit => deploy_apply_step_effects_plan(step: step, effects: effects, spec: spec, plan: plan, source_root: source_root)
            ApprovalBrokerFrontDoor => deploy_apply_step_effects_plan(step: step, effects: effects, spec: spec, plan: plan, source_root: source_root)
          }
      }
  }
}

fn deploy_apply_steps_plan(steps: List<DeploymentStep>, effects: List<MemberEffect<DeploymentStep>>, spec: DeploymentSpec, plan: ReleaseEffectPlan, source_root: String, oidc_now: Second?) -> DeployApplyPlan {
  match steps {
    Empty => ApplyPlanReady { legs: [] }
    Cons { head: st, tail: rest } =>
      deploy_apply_chain(
        first: deploy_apply_step_plan(step: st, effects: effects, spec: spec, plan: plan, source_root: source_root, oidc_now: oidc_now),
        rest: deploy_apply_steps_plan(steps: rest, effects: effects, spec: spec, plan: plan, source_root: source_root, oidc_now: oidc_now),
      )
  }
}

fn deploy_apply_family_plans(spec: DeploymentSpec, effects: List<MemberEffect<DeploymentStep>>, plan: ReleaseEffectPlan, source_root: String, oidc_now: Second?) -> DeployApplyPlan {
  deploy_apply_chain(
    first: deploy_apply_object_source_plan(),
    rest: deploy_apply_chain(
    first: deploy_apply_directories_plan(spec: spec, plan: plan),
    rest: deploy_apply_chain(
      first: deploy_apply_broker_state_directories_plan(spec: spec, plan: plan),
      rest: deploy_apply_steps_plan(steps: spec.steps, effects: effects, spec: spec, plan: plan, source_root: source_root, oidc_now: oidc_now),
    ),
    ),
  )
}

fn deploy_apply_plan_legs(spec: DeploymentSpec, plan: ReleaseEffectPlan, source_root: String, oidc_now: Second?) -> DeployApplyPlan {
  match spec.target.lab_plan {
    LabPlanRefused { cause: c } =>
      ApplyPlanRefused {
        step: "lab-plan",
        reason: join(["live-deploy apply refused: lab plan refused (", lab_plan_refusal_reason(cause: c) as String, ") (gunbc.design_argument::fail_closed: refuse, never widen)"], ""),
      }
    LabPlanReady { host: _, os_package_manager: _, tailscale_client: _, git_path: _, jq_path: _, timeout_path: _, worker_sandbox: _ } =>
      match spec.target.tailscale_client {
        ScopedRemovalUnobserved { reason: r } =>
          ApplyPlanRefused {
            step: "tailscale-client",
            reason: join(["live-deploy apply refused: this target's tailscale client version is UNOBSERVED (", r, "), so whether scoped serve exists on it is unknown. An unobserved version is not a capable one (gunbc.design_argument::fail_closed: refuse, never widen)"], ""),
          }
        ScopedRemovalUnsupported { observed: _ } => deploy_apply_membership_plan(spec: spec, plan: plan, source_root: source_root, oidc_now: oidc_now)
        ScopedRemovalSupported { observed: _ } => deploy_apply_membership_plan(spec: spec, plan: plan, source_root: source_root, oidc_now: oidc_now)
      }
  }
}

fn deploy_apply_membership_plan(spec: DeploymentSpec, plan: ReleaseEffectPlan, source_root: String, oidc_now: Second?) -> DeployApplyPlan {
  match membership_effects(plan: deployment_apply_plan(spec: spec)) {
    ApplyRefused { refusals: rs } =>
      ApplyPlanRefused {
        step: "wholesale",
        reason: join(["live-deploy apply refused WHOLESALE: the plan carried member teardown-refusals (a member the deploy does not own, or ownership unknown); the entire fold is refused rather than partially applied. refused-member-count=", to_string(count(rs))], ""),
      }
    EffectsReady { effects: es } => deploy_apply_family_plans(spec: spec, effects: es, plan: plan, source_root: source_root, oidc_now: oidc_now)
  }
}
