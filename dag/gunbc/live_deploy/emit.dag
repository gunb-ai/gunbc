    std.layout.doc_line_of(text: concat("OnCalendar=", gunbc.fleet_converge_timer.fleet_converge_timer_on_calendar)),
    std.layout.doc_line_of(text: "Persistent=true"),
    std.layout.doc_line_of(text: concat("RandomizedDelaySec=", to_string(std.measure.second_count(s: gunbc.fleet_converge_timer.fleet_converge_timer_randomized_delay)))),
    std.layout.doc_line_of(text: ""),
    std.layout.doc_line_of(text: "[Install]"),
    std.layout.doc_line_of(text: "WantedBy=timers.target"),
  ])
}

