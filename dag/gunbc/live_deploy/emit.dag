data live_deploy_protocol: LayoutProtocol = LayoutProtocol { indent_unit: "" }

data live_deploy_apply_emit_refused_poison: String = "__GUNBC_ORCH_EMIT_REFUSED__ live-deploy APPLY intent emission was rejected by v2.compiler.emit_orchestration; this marker is not valid deploy shell, so the committed .github/live-deploy-srv1-apply.sh drift gate goes red rather than a hand-spelled fallback masking the refusal (DESIGN §5: refuse, never widen)\n"

data live_deploy_retract_emit_refused_poison: String = "__GUNBC_ORCH_EMIT_REFUSED__ live-deploy RETRACT intent emission was rejected by v2.compiler.emit_orchestration; this marker is not valid deploy shell, so the committed .github/live-deploy-srv1-retract.sh drift gate goes red rather than a hand-spelled fallback masking the refusal (DESIGN §5: refuse, never widen)\n"

data live_deploy_ensure_dep_emit_refused_poison: String = "__GUNBC_ORCH_EMIT_REFUSED__ live-deploy ensure-dependency intent emission was rejected by v2.compiler.emit_orchestration; this marker is not valid reconcile-step shell, so the per-dep ConvergePlan step fails loudly rather than a hand-spelled fallback masking the refusal (DESIGN §5: refuse, never widen)\n"

fn deploy_raw(command: String) -> PipelineStep {
  Do {
    run: Run {
      command: command,
      env: [],
      redirect: Absent,
      capture: Absent
    }
  }
}

fn ensure_apt_package_step(pkg: NonEmptyStr, privileged: Bool) -> PipelineStep {
  If {
    cond: Not { inner: ExitZero {
      run: Run {
        command: dpkg_status_command(package: pkg),
        env: [],
        redirect: Present { value: DiscardAll },
        capture: Absent
      }
    } },
    then_: Pipeline {
      steps: [deploy_raw(command: apt_install_command(package: pkg, privileged: privileged))],
      on_failure: FailFast
    },
    else_: Absent
  }
}

fn emit_pipeline_or_poison(p: Pipeline, refused: String) -> String {
  match orch_emit_pipeline(p: p, medium: bash_orchestration_emit_medium()) {
    Accepted { value: source, diagnostics: d } =>
      match d {
        None => source.carried
        Some { diagnostics: _ } => refused
      }
    Rejected { diagnostics: _ } => refused
  }
}

data emit_systemd_unit_serve_note: String = "The belt-B unit: ExecStart is `gunbc serve` (the seed binary answering every request through the ONE .dag entry gunbc.roadmap_serve.roadmap_serve_handle — no emitted JS, no subprocess dispatch). User=briansrls, NOT root: claude auth exists only under briansrls on srv1 (parent lane verification 2026-07-20), so a root-run belt would spawn unauthed dead sessions; port 8080 is non-privileged so briansrls binds it. WorkingDirectory = the repo root — the source roots and entry are relative to it, and the belt's spawn workdir projects the same gunbc.host_layout fact."

fn emit_systemd_unit_doc(spec: DeploymentSpec) -> Doc {
  let svc = spec.service
  let port = to_string(svc.listen.port)
  let host = svc.listen.host
  doc_concat(parts: [
    doc_line_of(text: "[Unit]"),
    doc_line_of(text: "Description=gunbc roadmap HTTP server (gunbc serve)"),
    doc_line_of(text: "After=network-online.target tailscaled.service"),
    doc_line_of(text: "Wants=network-online.target"),
    doc_line_of(text: ""),
    doc_line_of(text: "[Service]"),
    doc_line_of(text: "Type=simple"),
    doc_line_of(text: concat("User=", svc.service_user)),
    doc_line_of(text: concat("Group=", svc.service_user)),
    doc_line_of(text: concat("WorkingDirectory=", svc.repo_root)),
    doc_line_of(text: join([
      "ExecStart=", svc.serve_binary,
      " serve --source-root dag --source-root src/v2",
      " --entry dag/gunbc/roadmap_serve.dag --function ", svc.serve_function as String,
      " --host ", host, " --port ", port,
    ], "")),
    doc_line_of(text: "Restart=on-failure"),
    doc_line_of(text: ""),
    doc_line_of(text: "[Install]"),
    doc_line_of(text: "WantedBy=multi-user.target"),
  ])
}

data live_deploy_reconcile_binding_note: String = "apply/retract are the two degenerate POLES of the ONE grain-agnostic membership_reconcile (gunbc.membership_reconcile) — no bespoke fold. apply = reconcile(desired = all deploy members, observed = none) => every member Added => Upsert. retract = reconcile(desired = none, observed = the owned artifacts) => every member Removed => Teardown (all Owned, so no refusal). The DeploymentStep (key_of/key_eq/value_eq/ownership_of) bundle is this consumer's Realization of the spine — not a copy of it. ownership_of projects through deployment_step_ownership onto the single gunbc.ownership authority, so it is ALWAYS Present (a deploy member's ownership is known by construction); the OwnershipUnknown/MemberNotOwned refusal arms are the safety backstop for a future non-degenerate observed provider, exercised only by the synthetic spine witness. key_of returns stable member IDENTITY (artifact path / dependency package); value_eq never fires in the degenerate poles (no Modified — one side is always empty)."

fn deployment_step_key(step: DeploymentStep) -> NonEmptyStr {
  match step {
    ArtifactStep { step: art } => art.path
    Dependency { step: dep } => dep.package
  }
}

fn deployment_step_key_eq(a: NonEmptyStr, b: NonEmptyStr) -> Bool { a == b }

fn deployment_step_value_eq(a: DeploymentStep, b: DeploymentStep) -> Bool { a == b }

fn deployment_step_ownership_opt(step: DeploymentStep) -> Ownership? {
  Present { value: deployment_step_ownership(step: step) }
}

fn deployment_apply_plan(spec: DeploymentSpec) -> MembershipPlan<DeploymentStep> {
  membership_reconcile(
    desired: spec.steps,
    observed: [],
    key_of: deployment_step_key,
    key_eq: deployment_step_key_eq,
    value_eq: deployment_step_value_eq,
    ownership_of: deployment_step_ownership_opt,
  )
}

fn deployment_retract_plan(spec: DeploymentSpec) -> MembershipPlan<DeploymentStep> {
  membership_reconcile(
    desired: [],
    observed: map(deployment_owned_steps_retract_order(spec: spec), s => ArtifactStep { step: s }),
    key_of: deployment_step_key,
    key_eq: deployment_step_key_eq,
    value_eq: deployment_step_value_eq,
    ownership_of: deployment_step_ownership_opt,
  )
}

data staged_unit_filename_note: String = "The staged filename reads from spec.service.unit_name for the same reason the install does: these two steps write and then install THE SAME FILE, and while both were the literal gunbc-roadmap.service that agreement was a coincidence of two independent constants rather than a fact. Parameterizing only the install side would have left the writer staging one name and the installer copying another — a deploy that fails on a missing file, which is at least loud, or worse installs a stale unit left in the stage directory from a previous run."

fn apply_systemd_unit_write_step(spec: DeploymentSpec) -> PipelineStep {
  deploy_raw(command: concat(
    concat(
      join(["cat > \"$_gunbc_stage/", spec.service.unit_name as String, "\" <<'GUNBC_UNIT_EOF'\n"], ""),
      render(doc: emit_systemd_unit_doc(spec: spec), proto: live_deploy_protocol),
    ),
    "GUNBC_UNIT_EOF"
  ))
}

data tree_sync_git_whitelist_note: String = "The .git/ leg is a WHITELIST sync (2026-07-22, journal receipt on srv1: three deploys failed rsync exit 23 on ONE file — objects/pack/pack-25d0810548020708d75d5510c2107766baaf86d2.keep, a git fetch-time marker written 0600 by ghrunner, unreadable to the User= principal; and /opt/gunbc/gunbc/.git/config was found carrying a live actions extraheader auth token from an earlier blanket sync — a credential leak). The belt needs exactly four things for `git worktree add` resolving origin/main: HEAD (repo validity), objects/ (minus *.keep / tmp_pack_* fetch transients, which are 0600 runner-private and never needed), packed-refs, and refs/. Everything else — config (CREDENTIALS), config.worktree, index, hooks, logs — never syncs, so both failure classes are unwritable by construction: no runner-private 0600 file can red the sync, and no credential can reach the service tree (DESIGN 5 construction over validation; the blacklist alternative re-reds on the next unknown transient). Still additive (no --delete): target-local worktree registrations, session refs, and their objects must survive redeploys (apply_tree_split_sync_note). Filter order is load-bearing: the two pack-transient excludes precede the /objects/*** include (first match wins), and the terminal --exclude=* is the whitelist wall."

fn emit_tree_sync_unit_doc(spec: DeploymentSpec, tree_path: String) -> Doc {
  let user = spec.service.service_user
  doc_concat(parts: [
    doc_line_of(text: "[Unit]"),
    doc_line_of(text: "Description=gunbc source tree sync (service-user-principal rsync from CI runner checkout)"),
    doc_line_of(text: ""),
    doc_line_of(text: "[Service]"),
    doc_line_of(text: "Type=oneshot"),
    doc_line_of(text: concat("User=", user)),
    doc_line_of(text: concat("Group=", user)),
    doc_line_of(text: concat("EnvironmentFile=", spec.identity.tree_sync_env_path as String)),
    doc_line_of(text: join([
      "ExecStart=/usr/bin/rsync -rlpt --delete --exclude /target --exclude /.git \"$\{GUNBC_TREE_SRC\}/\" ", tree_path, "/",
    ], "")),
    doc_line_of(text: join([
      "ExecStart=/usr/bin/rsync -rlpt --exclude=objects/pack/*.keep --exclude=objects/pack/tmp_pack_* --include=/HEAD --include=/objects/*** --include=/packed-refs --include=/refs/*** --exclude=* \"$\{GUNBC_TREE_SRC\}/.git/\" ", tree_path, "/.git/",
    ], "")),
  ])
}

fn apply_tree_sync_unit_write_step(spec: DeploymentSpec, tree_path: String) -> PipelineStep {
  deploy_raw(command: concat(
    concat("cat > \"$_gunbc_stage/gunbc-tree-sync.service\" <<'GUNBC_TREE_SYNC_EOF'\n", render(doc: emit_tree_sync_unit_doc(spec: spec, tree_path: tree_path), proto: live_deploy_protocol)),
    "GUNBC_TREE_SYNC_EOF"
  ))
}

data tree_sync_restart_diagnosis_note: String = "gunbc-tree-sync.service (#7011 realization) failed its control process on every srv1 deploy since landing (receipt 29928424523 and its predecessor 29926422286), and the bare 'sudo -n systemctl restart' stderr — 'Job for gunbc-tree-sync.service failed because the control process exited with error code' — never carries WHY: the actual ExecStart failure (the rsync exit) lives only in the unit's own journal, unreachable from this refusal (DESIGN 5 — a stopped, typed, but unlocated line, the same gap #7038 closed for gunbc-roadmap.service's async ServiceNotReady). This restart is SYNCHRONOUS, ahead of that poll-based unit_diagnosis capture entirely (GunbcSourceTree upsert runs before the SystemdUnit member), so it needs its own capture rather than waiting on one that never runs. Reuses the single unit-status-tail authority (live_deploy_unit_status_tail_command, gunbc.live_deploy.intent) the roadmap-unit capture already owns — no second diagnosis format. On failure the tail is appended to stderr and the step still fails (exit 1): a diagnosis, never an escape hatch (DESIGN 5 forbids proceeding as if the refusal had not fired)."

fn tree_sync_restart_step_with_diagnosis(spec: DeploymentSpec) -> PipelineStep {
  deploy_raw(command: join([
    systemctl_restart_command(unit: spec.identity.tree_sync_unit_name, privileged: true),
    " || { echo '--- gunbc-tree-sync.service control-process diagnosis ---' >&2; ",
    live_deploy_unit_status_tail_command(unit: spec.identity.tree_sync_unit_name),
    " >&2; exit 1; }",
  ], ""))
}

data tailscale_teardown_cannot_be_scoped_note: String = "THE TEARDOWN WAS A GLOBAL RESET AND THERE IS NO SCOPED ALTERNATIVE. `sudo -n tailscale serve reset` removes the ENTIRE serve configuration for the node, so retracting a lab removed production's routing along with its own. That was invisible while one deployment existed per host and became a live hazard the moment placement became a parameter — the same shape as the shared serve binary, found by the same review and missed by the same path-disjointness witness (review, 2026-07-30).\\n\\nIT CANNOT SIMPLY BE FIXED, because the CLI offers no per-port removal. `tailscale serve --help` on this host lists exactly three top-level forms — serve <target>, serve status, serve reset — plus service-level subcommands (drain, clear, advertise) that operate on advertised Services rather than on a port mapping this deployment created. There is no `serve <port> off`.\\n\\nSo the arm REFUSES rather than widening. A global reset issued to remove one mapping is the absorbing fallback stated exactly: the precise operation is unavailable, so the superset runs and nothing is missed — while another deployment's routing is destroyed and the retract reports success. A typed, loud refusal leaves the route in place and tells the operator what it could not do, which is recoverable; the reset is not.\\n\\nDISSOLVES ON either tailscale gaining a scoped removal, or this deployment learning whether it is the sole serve mapping on the host — at which point a reset is provably safe and can run unconditionally."

data live_deploy_tailscale_teardown_refused_poison: String = "__GUNBC_TAILSCALE_TEARDOWN_UNSCOPED__ tailscale serve exposes no per-port removal (only a node-global `serve reset`), so this retract will not remove the mapping: doing so would delete every other deployment's routing on this host. Remove it deliberately, or dissolve this refusal by teaching the deployment whether it owns the only mapping (DESIGN 5: refuse, never widen)"

data refusal_command_quoting_note: String = "THE REFUSAL ARM EMITTED A BASH SYNTAX ERROR AND THEREFORE DID NOT REFUSE (review 45173, confirmed by running bash -n on the emitted script). The poison text contains an apostrophe — deployment's routing — and this constructor wrapped it in single quotes by concatenation. A POSIX single-quoted string cannot contain a single quote, so the shell read the apostrophe as CLOSING the string, then reopened at the next quote and hit EOF unterminated. The text also carries backticks around serve reset, which land in the resulting unquoted stretch as command substitution.\n\nThe consequence is worse than a garbled message. Under set -euo pipefail the parse error aborts the whole script at that line, so every teardown step after it — systemd disable and removal, daemon-reload, worktree and binary removal, tree-sync teardown — silently never ran, and neither did the refusal message the arm exists to print. An arm designed to stop the line instead dropped the rest of the line on the floor.\n\nThe fix consumes the shared POSIX authority rather than hand-spelling quotes: extdeps.exec.command.shell_quote splits on the quote character and rejoins through the close-escape-reopen form, which is the one correct spelling and already what tmux_staged_provider_start_note instructs callers to use for exactly this reason. Hand-concatenating quotes at a call site is how this class recurs, and the git_pathspec_exclude_note records the same lesson from the same failure — a shell word quoted by hand, caught by bash -n."

fn tailscale_teardown_refusal_command() -> String {
  concat("echo ", concat(shell_quote(arg: live_deploy_tailscale_teardown_refused_poison), " >&2; false"))
}

fn tailscale_serve_apply_step(spec: DeploymentSpec) -> PipelineStep {
  let port = deployment_plan_listen_port(spec: spec)
  If {
    cond: Not { inner: ExitZero {
      run: Run {
        command: concat("sudo -n tailscale serve status 2>/dev/null | grep -q ':", to_string(port), "'"),
        env: [],
        redirect: Absent,
        capture: Absent
      }
    } },
    then_: Pipeline {
      steps: [deploy_raw(command: concat("sudo -n tailscale serve --bg ", to_string(port)))],
      on_failure: FailFast
    },
    else_: Absent
  }
}

data emit_deploy_principal_note: String = "The deploy principal on srv1 is the UNPRIVILEGED CI-runner account — DeployRunnerPrincipal.job_user grounds on gunbc.fleet_posix_accounts FleetAccountCiRunner (ghrunner, uid 1001); unit_user=root is NOT the authorization principal. Exactly the six NOPASSWD sudo grants that fleet_posix_ci_runner_sudo_grants() enumerates (apt-get, install, visudo, systemctl, tailscale, rm) — NOT root, and no blessed-helper grant (#7011 realization). The prior note here claimed ROOT from a hand ssh verification (parent lane 2026-07-20) that CONTRADICTED the repo's own single authority (fleet_posix_accounts, probed 2026-07-02) — a DESIGN 3 fork of the principal fact — and reality sided with the authority: the first flip deploy (run 29822498755, 2026-07-21) died on bare-rsync EACCES/chgrp-EPERM into the service-user-owned tree. The corrected realization stays INSIDE the granted set: directories and the binary install with -o/-g service-user via the granted install (ownership at creation, never a chown fixup — the root-writes-then-chown two-step is dissolved, the wrongly-owned intermediate state unwritable); the tree sync runs AS the service user through gunbc-tree-sync.service (a oneshot unit, User=service-user, installed and started via the granted install+systemctl — the owner writes its own tree); teardown rm goes through the granted rm. Deploy authorization is runtime-present: live_deploy_fold runs deploy_mutation_gate before host_effect_apply, and the gate observes ReadEffectivePosixPrincipal plus SudoNopasswdExecuteProbe / SudoNopasswdGrantListProbe through typed service-op argv transports. The roster selects grant-list verification for package-managed tailscale, whose binary may be absent before ensure. The former gunbc.ci_deploy_access_emit in-script duplicate is deleted; these committed scripts are HostReconciler projections, not standalone authorization entrypoints. Their shared preamble only installs the roster-derived /etc/sudoers.d/gunbc-deploy after the typed gate has permitted execution. RESIDUE (named): emit-construction refusal of bare rsync/chown outside the granted set rides the effect-namespace-grants lane. The former install_d_shared_setup_latent_coupling marker fired as designed: /opt/gunbc now has MULTIPLE owned writers, so the shared-prefix `install -d /opt/gunbc` rides the FIRST owned writer in apply order (GunbcSourceTree) once, and each deeper parent (/opt/gunbc/bin) rides its own writer."

fn install_d_owned_command(spec: DeploymentSpec, path: String) -> String {
  join([
    "sudo -n install -d -m 0755 -o ", spec.service.service_user,
    " -g ", spec.service.service_user, " ", path,
  ], "")
}

fn deploy_apply_preamble_steps(access: DeployAccess) -> List<PipelineStep> {
  [deploy_raw(command: deploy_sudoers_install_shell(access: access))]
}

data apply_tree_split_sync_note: String = "GunbcSourceTree apply is a SPLIT sync (review 40332, DESIGN 5 — the retract-side rmdir wall alone gave false assurance): the shared repo at /opt/gunbc/gunbc accumulates target-LOCAL git state the runner checkout never has — .git/worktrees/<name> registrations for every live dispatch worktree, the session branch refs those worktrees are on, and the objects their commits wrote into the shared store — so a single rsync --delete of ./ would destroy live agent sessions on every redeploy. The working tree syncs with --delete (stale sources must not linger) but excludes /.git; .git syncs ADDITIVELY (no --delete), which keeps origin/main fresh from the runner checkout (the belt's git worktree add resolves origin/main from these remote-tracking refs — srv1 does no fetch) while never deleting worktree metadata, session refs, or their objects. Accumulation of pruned-worktree residue is the safe direction and is reaped by git itself, never by deploy. Flags are -rlpt, not -a: the sync principal is the service user (emit_deploy_principal_note), so -a's owner/group replication would chgrp toward the runner's group and fail EPERM — ownership is the destination principal's by construction, never replicated from the source."

fn emit_artifact_upsert(art: DeploymentArtifactStep, spec: DeploymentSpec) -> List<PipelineStep> {
  match art.kind {
    GunbcSourceTree => [
      deploy_raw(command: "sudo -n install -d -m 0755 /opt/gunbc"),
      deploy_raw(command: install_d_owned_command(spec: spec, path: art.path as String)),
      deploy_raw(command: "printf 'GUNBC_TREE_SRC=%s\\n' \"$PWD\" > \"$_gunbc_stage/gunbc-tree-sync.env\""),
      deploy_raw(command: concat("sudo -n install -m 0644 \"$_gunbc_stage/gunbc-tree-sync.env\" ", spec.identity.tree_sync_env_path as String)),
      apply_tree_sync_unit_write_step(spec: spec, tree_path: art.path as String),
      deploy_raw(command: concat("sudo -n install -m 0644 \"$_gunbc_stage/gunbc-tree-sync.service\" ", tree_sync_unit_path(identity: spec.identity) as String)),
      deploy_raw(command: systemctl_daemon_reload_command(privileged: true)),
      tree_sync_restart_step_with_diagnosis(spec: spec),
    ]
    ServeBinary => [
      deploy_raw(command: "sudo -n install -d -m 0755 /opt/gunbc/bin"),
      deploy_raw(command: join([
        "sudo -n install -m 0755 -o ", spec.service.service_user,
        " -g ", spec.service.service_user,
        " target/release/gunbc ", art.path as String,
      ], "")),
    ]
    DispatchWorktreeRoot => [
      deploy_raw(command: install_d_owned_command(spec: spec, path: art.path as String)),
    ]
    SystemdUnit => [
      apply_systemd_unit_write_step(spec: spec),
      deploy_raw(command: join([
        "sudo -n install -m 0644 \"$_gunbc_stage/", spec.service.unit_name as String, "\" ",
        art.path as String,
      ], "")),
      deploy_raw(command: systemctl_daemon_reload_command(privileged: true)),
      deploy_raw(command: systemctl_enable_command(unit: spec.service.unit_name, privileged: true)),
      deploy_raw(command: systemctl_restart_command(unit: spec.service.unit_name, privileged: true)),
    ]
    TailscaleServeMapping => [
      tailscale_serve_apply_step(spec: spec),
    ]
  }
}

data teardown_worktree_rmdir_note: String = "DispatchWorktreeRoot teardown is rm -d (empty-directory removal via the granted rm — the unprivileged principal has no rmdir grant and no write on the root-owned parent), NEVER rm -rf: a non-empty worktree root means live agent worktrees exist, so the retract FAILS LOUDLY there instead of silently destroying sessions (DESIGN 5 — the refusal is the empty-dir precondition itself, identical to the former rmdir). GunbcSourceTree teardown runs AFTER the worktree rm -d succeeds, so the repo the worktrees are registered in is never deleted from under them."

fn emit_artifact_teardown(art: DeploymentArtifactStep, spec: DeploymentSpec) -> List<PipelineStep> {
  match art.kind {
    TailscaleServeMapping => [
      deploy_raw(command: tailscale_teardown_refusal_command()),
    ]
    SystemdUnit => [
      deploy_raw(command: concat(systemctl_disable_now_command(unit: spec.service.unit_name, privileged: true), " 2>/dev/null || true")),
      deploy_raw(command: concat("sudo -n rm -f ", art.path as String)),
      deploy_raw(command: systemctl_daemon_reload_command(privileged: true)),
    ]
    DispatchWorktreeRoot => [
      deploy_raw(command: concat("sudo -n rm -d ", art.path as String)),
    ]
    ServeBinary => [
      deploy_raw(command: concat("sudo -n rm -f ", art.path as String)),
    ]
    GunbcSourceTree => [
      deploy_raw(command: concat("sudo -n rm -f ", concat(tree_sync_unit_path(identity: spec.identity) as String, concat(" ", spec.identity.tree_sync_env_path as String)))),
      deploy_raw(command: systemctl_daemon_reload_command(privileged: true)),
      deploy_raw(command: concat("sudo -n rm -rf ", art.path as String)),
    ]
  }
}

data emit_deploy_member_effect_note: String = "The per-member realization HANDLER: share the DIFF (membership_reconcile), dispatch the APPLY (this). One handler for both fold directions — EffectUpsert dispatches on member kind to the artifact/dependency install fragments; EffectTeardown to the removal fragments. Orchestration is DERIVED from the effect kind, not an always-on envelope: a SystemdUnit upsert carries its own daemon-reload/enable/restart (once, part of the unit's realization); ServerScript carries the /opt/gunbc install -d it writes into. MemberEffect is a bidirectional sum, so each POLE has one structurally-unreachable direction (apply never Teardown, retract never Upsert) — those ARE reached across the two poles combined. The ONE arm unreachable across BOTH poles is EffectTeardown of a Dependency: a dependency is Ensured, so a Removed dependency is MemberTeardownRefused, never an EffectTeardown. That arm REFUSES loudly (emit_deploy_teardown_dependency_refusal — a typed/located poison step), it does NOT fabricate a no-op (DESIGN §5: an unreachable arm refuses, never a silent pass)."

data live_deploy_teardown_dependency_unreachable_poison: String = "__GUNBC_DEPLOY_UNREACHABLE__ R5 wall breach — EffectTeardown of an Ensured dependency reached the emit dispatch. A dependency is Ensured, so a Removed dependency is MemberTeardownRefused (never an EffectTeardown); reaching this arm means deployment_step_ownership or membership_effects is broken. This marker is not valid deploy shell, so the golden drift gate reds — DESIGN §5: an unreachable arm REFUSES loudly (typed/located/counted), never fabricates a no-op. dependency="

fn emit_deploy_teardown_dependency_refusal(dep: DeploymentDependencyStep) -> List<PipelineStep> {
  [deploy_raw(command: concat(live_deploy_teardown_dependency_unreachable_poison, dep.package))]
}

fn emit_deploy_member_effect(effect: MemberEffect<DeploymentStep>, spec: DeploymentSpec) -> List<PipelineStep> {
  match effect {
    EffectUpsert { member: step } =>
      match step {
        Dependency { step: dep } => [
          ensure_apt_package_step(pkg: dep.package, privileged: true),
        ]
        ArtifactStep { step: art } => emit_artifact_upsert(art: art, spec: spec)
      }
    EffectTeardown { member: step } =>
      match step {
        ArtifactStep { step: art } => emit_artifact_teardown(art: art, spec: spec)
        Dependency { step: dep } => emit_deploy_teardown_dependency_refusal(dep: dep)
      }
  }
}

fn apply_intent_from_effects(
  spec: DeploymentSpec,
  effects: List<MemberEffect<DeploymentStep>>,
  access: DeployAccess
) -> Pipeline {
  Pipeline {
    steps: concat(
      [
        deploy_raw(command: "set -euo pipefail"),
        deploy_raw(command: concat("# GENERATED APPLY by dag/gunbc/live_deploy/emit.dag host=", spec.target.host.identity)),
        deploy_raw(command: "# Principal: job_user=ghrunner (DeployRunnerPrincipal.job_user). unit_user=root is NOT the deploy principal."),
        deploy_raw(command: "# Mutation rides six sudo -n grants (roster incl. visudo); tree sync AS service user via gunbc-tree-sync.service."),
        deploy_raw(command: "# Wave C envelope: typed deploy-access gate runs before this HostReconciler artifact; roster sudoers install precedes mutation."),
        deploy_raw(command: "_gunbc_stage=\"$(mktemp -d)\""),
        deploy_raw(command: "trap 'rm -rf \"$_gunbc_stage\"' EXIT"),
      ],
      concat(
        deploy_apply_preamble_steps(access: access),
        concat(
          flat_map(effects, e => emit_deploy_member_effect(effect: e, spec: spec)),
          [
            deploy_raw(command: concat("echo live-deploy-receipt host=", spec.target.host.identity, " fold=apply verdict=converged")),
          ]
        )
      )
    ),
    on_failure: FailFast
  }
}

data refusal_must_not_precede_sibling_teardowns_note: String = "A REFUSAL ON ONE ARTIFACT WAS SILENTLY BLOCKING EVERY OTHER TEARDOWN (review 45016, proven by execution: set -euo pipefail with a leading `false` aborts and no later line runs). Retract order is the reverse of apply order, and TailscaleServeMapping is applied LAST — so it was torn down FIRST, and its refusal arm ends in `false`. Under FailFast that aborted the pipeline at the first teardown, so the systemd unit, the worktree root, the serve binary, the tree-sync files and the repo tree were never removed. EVERY retract, production and twin, tore down nothing.\\n\\nThis is a DIFFERENT defect from the quoting bug fixed beside it, with the same symptom, and fixing the quoting did not fix it: a syntactically valid `false` aborts a fail-fast pipeline just as effectively as a parse error. Two independent causes of one silent outcome is exactly why the emitted artifact needs oracles beyond byte-equality with its golden.\\n\\nTHE ORDERING IS NOT HAND-EDITED, because the retract order is DERIVED — deployment_owned_steps_retract_order reverses what this spec actually applied, and re-transcribing a list here would reinstate the two-places-one-fact defect that derivation removed. Instead the effects are PARTITIONED: teardowns that can act, in their derived reverse-apply order, then teardowns that refuse. A refusal cannot be emitted before a real teardown because the partition puts it in the second group, so the class is closed by construction rather than by choosing a lucky order.\\n\\nWHY REFUSING LAST IS FAIL-CLOSED, and emitting the refusal without `false` would not be: the refusal must still stop the line, and it now does so AFTER the removable artifacts are gone and BEFORE the `verdict=converged` receipt — so the retract removes everything it legitimately can, never widens to the node-global tailscale reset, exits nonzero, and never prints a convergence receipt while the mapping is still live. Dropping the `false` to let the pipeline finish would print that receipt, which is the fabricated-success arm §5 forbids."

fn deploy_teardown_refuses(effect: MemberEffect<DeploymentStep>) -> Bool {
  match effect {
    EffectUpsert { member: _ } => false
    EffectTeardown { member: step } =>
      match step {
        Dependency { step: _ } => true
        ArtifactStep { step: art } =>
          match art.kind {
            TailscaleServeMapping => true
            SystemdUnit => false
            DispatchWorktreeRoot => false
            ServeBinary => false
            GunbcSourceTree => false
          }
      }
  }
}

fn retract_effects_acting_before_refusing(
  effects: List<MemberEffect<DeploymentStep>>,
) -> List<MemberEffect<DeploymentStep>> {
  concat(
    effects |> filter(e => !deploy_teardown_refuses(effect: e)),
    effects |> filter(e => deploy_teardown_refuses(effect: e)),
  )
}

fn retract_intent_from_effects(
  spec: DeploymentSpec,
  effects: List<MemberEffect<DeploymentStep>>,
  access: DeployAccess
) -> Pipeline {
  Pipeline {
    steps: concat(
      [
        deploy_raw(command: "set -euo pipefail"),
        deploy_raw(command: concat("# GENERATED RETRACT by dag/gunbc/live_deploy/emit.dag host=", spec.target.host.identity)),
        deploy_raw(command: "# owned-artifacts only — ensured deps (tailscale, tmux) intentionally NOT purged"),
        deploy_raw(command: "# Wave C envelope: typed deploy-access gate runs before this HostReconciler artifact; retract also installs/refreshes"),
        deploy_raw(command: "# /etc/sudoers.d/gunbc-deploy (idempotent; first retract-after-flip may be the dropin install)."),
        deploy_raw(command: "# Principal: UNPRIVILEGED ci-runner. dispatch-worktrees teardown is rm -d (granted rm,"),
        deploy_raw(command: "# empty-dir only): live worktrees fail it LOUDLY — the same empty-dir refusal wall."),
        deploy_raw(command: "_gunbc_stage=\"$(mktemp -d)\""),
        deploy_raw(command: "trap 'rm -rf \"$_gunbc_stage\"' EXIT"),
      ],
      concat(
        deploy_apply_preamble_steps(access: access),
        concat(
          flat_map(
            retract_effects_acting_before_refusing(effects: effects),
            e => emit_deploy_member_effect(effect: e, spec: spec),
          ),
          [
            deploy_raw(command: concat("echo live-deploy-receipt host=", spec.target.host.identity, " fold=retract verdict=converged")),
          ]
        )
      )
    ),
    on_failure: FailFast
  }
}

data live_deploy_wholesale_refused_poison_prefix: String = "__GUNBC_DEPLOY_REFUSED__ live-deploy reconcile refused WHOLESALE — the plan carried member teardown-refusals (a member the deploy does not own, or ownership unknown). Per the wholesale-refuse execution policy (gunbc.membership_reconcile.membership_effects_wholesale_refuse_policy_trigger) the ENTIRE fold is refused before emit rather than partially applied — R5 owned-only teardown is a construction wall, never emit-around. This marker is not valid deploy shell, so the committed golden drift gate reds (DESIGN §5: refuse, never widen). "

fn live_deploy_wholesale_refused_poison(refusals: List<MemberRefusal<DeploymentStep>>, fold_label: String) -> String {
  concat(
    live_deploy_wholesale_refused_poison_prefix,
    concat(fold_label, concat(" refused-member-count=", to_string(count(refusals))))
  )
}

fn live_deploy_apply_script_for(spec: DeploymentSpec) -> String {
  match ci_deploy_srv1_access_or_refusal() {
    DeployAccessJobPrincipalRefused { refusal: r } =>
      deploy_access_job_principal_refused_emit_poison(refusal: r)
    DeployAccessReady { access: access } =>
      match membership_effects(plan: deployment_apply_plan(spec: spec)) {
        EffectsReady { effects: es } =>
          emit_pipeline_or_poison(
            p: apply_intent_from_effects(spec: spec, effects: es, access: access),
            refused: live_deploy_apply_emit_refused_poison
          )
        ApplyRefused { refusals: rs } =>
          live_deploy_wholesale_refused_poison(refusals: rs, fold_label: "APPLY")
      }
  }
}

fn live_deploy_retract_script_for(spec: DeploymentSpec) -> String {
  match ci_deploy_srv1_access_or_refusal() {
    DeployAccessJobPrincipalRefused { refusal: r } =>
      deploy_access_job_principal_refused_emit_poison(refusal: r)
    DeployAccessReady { access: access } =>
      match membership_effects(plan: deployment_retract_plan(spec: spec)) {
        EffectsReady { effects: es } =>
          emit_pipeline_or_poison(
            p: retract_intent_from_effects(spec: spec, effects: es, access: access),
            refused: live_deploy_retract_emit_refused_poison
          )
        ApplyRefused { refusals: rs } =>
          live_deploy_wholesale_refused_poison(refusals: rs, fold_label: "RETRACT")
      }
  }
}

fn expected_live_deploy_apply_script() -> String {
  live_deploy_apply_script_for(spec: deployment_spec_srv1())
}

fn expected_live_deploy_retract_script() -> String {
  live_deploy_retract_script_for(spec: deployment_spec_srv1())
}

fn live_deploy_systemd_unit_for(spec: DeploymentSpec) -> String {
  render(doc: emit_systemd_unit_doc(spec: spec), proto: live_deploy_protocol)
}

fn live_deploy_tree_sync_unit_for(spec: DeploymentSpec) -> String {
  render(doc: emit_tree_sync_unit_doc(spec: spec, tree_path: spec.service.repo_root as String), proto: live_deploy_protocol)
}

fn deployment_ensure_dependency_intent(dep: DeploymentDependencyStep) -> Pipeline {
  Pipeline {
    steps: [
      ensure_apt_package_step(pkg: dep.package, privileged: false)
    ],
    on_failure: FailFast
  }
}

fn deployment_ensure_dependency_script(dep: DeploymentDependencyStep) -> String {
  emit_pipeline_or_poison(p: deployment_ensure_dependency_intent(dep: dep), refused: live_deploy_ensure_dep_emit_refused_poison)
}

data live_deploy_emit_shell_dissolution_trigger: Disposition = Scaffold {
  dissolves_to: RealizationDispatch,
  bind: DeclarationRef {
    module_path: "gunbc.live_deploy.emit",
    decl_name: "live_deploy_apply_script_for",
    field: WholeDeclaration
  }
}

data live_deploy_retract_emit_shell_dissolution_trigger: Disposition = Scaffold {
  dissolves_to: RealizationDispatch,
  bind: DeclarationRef {
    module_path: "gunbc.live_deploy.emit",
    decl_name: "live_deploy_retract_script_for",
    field: WholeDeclaration
  }
}

data live_deploy_remote_mutation_service_op_realization_dissolution_trigger: Disposition = Scaffold {
  dissolves_to: RealizationDispatch,
  bind: DeclarationRef {
    module_path: "gunbc.live_deploy.emit",
    decl_name: "live_deploy_emit_shell_dissolution_trigger",
    field: WholeDeclaration,
  }
}

data live_deploy_intent_dependency_graph_emit_dissolution_trigger: Disposition = Scaffold {
  dissolves_to: RealizationDispatch,
  bind: DeclarationRef {
    module_path: "v2.compiler.emit_orchestration",
    decl_name: "orch_emit_pipeline",
    field: WholeDeclaration,
  }
}

data live_deploy_golden_freeze_note: String = "The apply/retract scripts are now ONE orchestration-intent Pipeline each, built from the two degenerate POLES of the grain-agnostic gunbc.membership_reconcile (apply = reconcile desired=all-members/observed=none => all Upsert; retract = reconcile desired=none/observed=owned-artifacts => all Teardown) — apply_intent_from_effects / retract_intent_from_effects fold the resulting MemberEffects into the Pipeline via the per-kind emit_deploy_member_effect handler (share the diff, dispatch the apply), framing (preamble/receipt) wrapping OUTSIDE the reconcile. A refusal (a non-owned/unknown member) refuses the WHOLE fold before emit (EffectsOrRefusal sum — un-emittable by type; never reached by the degenerate poles). The Pipeline is emitted through the signed v2.compiler.emit_orchestration.orch_emit_pipeline path over the bash_orchestration_emit medium — NOT assembled by workflow-code string concat. The smuggled-program class (control flow / sequencing joins built by concat in this module — the former ensure_apt_package function-def, the deployment_ensure_dependency_script nested if/then concat, the tailscale if/fi) is dissolved: dependency-ensure is inline If-Not-ExitZero(dpkg -s) then Do(sudo -n apt-get install) intent (DESIGN §2 CUT: desugar inline, no minted verb), and the emission JOIN lives in extdeps/languages/bash_orchestration_emit, not here (no-smuggled-programs wall: a string literal is an ATOM, joins live in extdeps/languages rows). An emission refusal returns a poison marker (live_deploy_*_emit_refused_poison) so the committed golden drift gate reds instead of a hand-spelled fallback (DESIGN §5: refuse, never widen). The scripts are still frozen as committed golden artifacts (gunbc.generated_artifact LiveDeployApplyScriptArtifact / LiveDeployRetractScriptArtifact, gated byte-for-byte in test.claim.live_deploy.emit) — green by execution + a discriminating RED — killing the #6023-class self-referential drift check. RESIDUE (named, not this slice): Run.command is still a String leaf (v2.std.orchestration.Run), so the heredoc file bodies (server.js, systemd unit) and per-command argv interpolation ride inside command: strings as the anemic-leaf residue — they dissolve when Do-effect gains a typed file-write leaf (heredoc file bodies as typed orchestration intent, live_deploy_intent_dependency_graph_emit_dissolution_trigger binds orch_emit_pipeline). Transport-aware remote-mutation service-op realization (live_deploy runs shell, not yet a transport-realized service op) is OUT OF SCOPE — live_deploy_remote_mutation_service_op_realization_dissolution_trigger. Healthz readiness and digest read-back run on the DAG reconcile spine after mutation (live_deploy.readiness transport curl poll, then live_deploy.apply digest read-back); the apply script ships mutation only (no in-script curl read-back)."
