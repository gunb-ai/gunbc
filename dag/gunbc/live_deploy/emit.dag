data live_deploy_protocol: LayoutProtocol = LayoutProtocol { indent_unit: "" }

data live_deploy_apply_emit_refused_poison: String = "__GUNBC_ORCH_EMIT_REFUSED__ live-deploy APPLY intent emission was rejected by v2.compiler.emit_orchestration; this marker is not valid deploy shell, so the committed .github/live-deploy-srv1-apply.sh drift gate goes red rather than a hand-spelled fallback masking the refusal (DESIGN §5: refuse, never widen)\n"

data live_deploy_retract_emit_refused_poison: String = "__GUNBC_ORCH_EMIT_REFUSED__ live-deploy RETRACT intent emission was rejected by v2.compiler.emit_orchestration; this marker is not valid deploy shell, so the committed .github/live-deploy-srv1-retract.sh drift gate goes red rather than a hand-spelled fallback masking the refusal (DESIGN §5: refuse, never widen)\n"

data live_deploy_ensure_dep_emit_refused_poison: String = "__GUNBC_ORCH_EMIT_REFUSED__ live-deploy ensure-dependency intent emission was rejected by v2.compiler.emit_orchestration; this marker is not valid reconcile-step shell, so the per-dep ConvergePlan step fails loudly rather than a hand-spelled fallback masking the refusal (DESIGN §5: refuse, never widen)\n"

data live_deploy_systemd_retirement_emit_refused_poison: String = "__GUNBC_BASH_EMIT_REFUSED__ systemd runtime-retirement intent was rejected by v2.workflow.bash_command_fold_serialize; this marker is not valid deploy shell, so the committed retract artifact drift gate goes red rather than a hand-spelled fallback masking the refusal (DESIGN §5: refuse, never widen)"

// WHAT IS LEFT IN THIS FUNCTION IS THE COUNTED RESIDUAL, and it is named here rather than left to
// a reader to infer from call sites. Every leaf whose words are an extdeps operation row now goes
// through deploy_effect instead: systemd.Systemctl DaemonReload/Enable/Restart, apt.PackageManager
// Install, dpkg.Package Status. What still arrives as a String does so for one of four reasons,
// and each names a different missing capability rather than a shared "not done yet":
//
//   1. NO OPERATION ROW EXISTS for the program -- install(1), rm(1), printf(1), tailscale serve.
//      These are already argv-derived (gunbc.live_deploy.operations, extdeps.tools.gnu_coreutils),
//      so the gap is an extdeps service surface, not a spelling.
//   2. THE COMMAND IS NOT ONE INVOCATION -- the staged writes carry a redirection to a word built
//      from a variable reference, and the tree-sync restart carries a `|| { ...; exit 1; }`
//      diagnosis tail. BoundOperationInvocation names an operation and its inputs; it cannot carry
//      a redirect, a word with an expansion in it, or a failure branch.
//   3. THE LINE IS NOT A COMMAND AT ALL -- `set -euo pipefail`, the EXIT trap, and the
//      __GUNBC_*_REFUSED__ poison markers, which are deliberately not valid shell.
//   4. THE BODY IS HAND-AUTHORED SHELL from another module (the sudoers install, the memory-cap
//      block, the receipt echo), which is that module's own census row, not this one's.
//
// 🟡 dissolve-on: class 1 dissolves when the coreutils/tailscale surfaces carry shell-transport
// operation rows this leaf can bind against; class 2 dissolves when the effect-plan band can carry
// a redirect target and a failure arm on a Do-effect leaf, which is the same capability
// effect_plan_bash_materialize's UnsupportedEffectPlanStep arms currently refuse; class 3 has no
// dissolution -- a marker that must not parse as shell is correctly a String; class 4 is owned by
// the module that authors the body.
fn deploy_raw(command: String) -> PipelineStep {
  Do {
    run: Run {
      command: command,
      env: Empty,
      redirect: Absent,
      capture: Absent
    }
  }
}

// The PipelineStep wrapper is all that stays here: the one-step EffectPlan and the operation
// constructors live in gunbc.live_deploy.effect_leaf because EffectPlanStep and PipelineStep both
// declare Do/If/For/While/Retry/Let/Call, and variant names resolve corpus-wide -- a module holding
// both coproducts does not resolve. The split is forced by the substrate, not a layering choice.
fn deploy_effect_run(inv: BashBoundOperationInvocation) -> Run {
  Run {
    command: deploy_effect_command(inv: inv),
    env: Empty,
    redirect: Absent,
    capture: Absent
  }
}

fn deploy_effect(inv: BashBoundOperationInvocation) -> PipelineStep {
  Do { run: deploy_effect_run(inv: inv) }
}

fn systemctl_disable_now_argv_for_deploy(unit: NonEmptyStr, privileged: Bool) -> List<String> {
  if privileged {
    sudo_elevate_argv(command: systemctl_disable_now_argv(unit: unit))
  } else {
    systemctl_disable_now_argv(unit: unit)
  }
}

// Runtime retirement is idempotent only for the explicit systemd LoadState=not-found observation.
// The decision is a bash grammar tree at this foreign-executor realization edge: a fail-fast
// assignment captures LoadState, then a modeled If disables every state other than not-found. A
// show/read failure therefore stops before the conditional, and a disable/stop failure remains
// loud. This replaces the former `2>/dev/null || true` without smuggling command substitution or
// control flow through a String leaf.
fn systemctl_load_state_assignment_intent(unit: NonEmptyStr) -> Node {
  bash_build_assign(
    name: "_gunbc_load_state",
    value: bash_build_word_cmdsubst(
      body: bash_build_command_from_lits(
        lits: systemctl_show_load_state_argv(unit: unit)
      )
    )
  )
}

fn systemctl_disable_now_when_loaded_intent(unit: NonEmptyStr, privileged: Bool) -> Node {
  bash_build_if_from_stmts(
    cond: bash_build_test_bracket(words: [
      bash_build_word_var(name: "_gunbc_load_state"),
      bash_build_word_lit(text: "!="),
      bash_build_word_lit(text: systemd_unit_load_state_not_found_wire as String),
    ]),
    then_stmts: [
      bash_build_command_from_lits(
        lits: systemctl_disable_now_argv_for_deploy(unit: unit, privileged: privileged)
      )
    ]
  )
}

fn bash_intent_command_or_poison(intent: Node) -> String {
  match bash_fold_serialize_node(stmt: intent) {
    Accepted { value: source, diagnostics: d } =>
      match d {
        None => source
        Some { diagnostics: _ } => live_deploy_systemd_retirement_emit_refused_poison
      }
    Rejected { diagnostics: _ } => live_deploy_systemd_retirement_emit_refused_poison
  }
}

fn systemctl_disable_now_if_present_steps(unit: NonEmptyStr, privileged: Bool) -> List<PipelineStep> {
  [
    deploy_raw(command: bash_intent_command_or_poison(
      intent: systemctl_load_state_assignment_intent(unit: unit)
    )),
    deploy_raw(command: bash_intent_command_or_poison(
      intent: systemctl_disable_now_when_loaded_intent(unit: unit, privileged: privileged)
    )),
  ]
}

fn ensure_apt_package_step(pkg: NonEmptyStr, privileged: Bool) -> PipelineStep {
  If {
    cond: Not { inner: ExitZero {
      run: Run {
        command: deploy_effect_command(inv: dpkg_status_effect(package: pkg)),
        env: Empty,
        redirect: Present { value: DiscardAll },
        capture: Absent
      }
    } },
    then_: Pipeline {
      steps: [deploy_effect(inv: if privileged {
        apt_install_effect(package: pkg)
      } else {
        apt_install_unelevated_effect(package: pkg)
      })],
      on_failure: FailFast
    },
    else_: Absent
  }
}

// The staging directory is a BINDING, not a command whose text happens to assign. PipelineStep
// already carries Let with an ExprCmdSubst value, so the name, the callee and its argument are
// three modeled parts instead of one quoted line an author assembled — and the variable name is
// the same single authority the staged-path word reads (operations.deploy_stage_dir_var).
fn deploy_stage_directory_let_step() -> PipelineStep {
  Let {
    name: deploy_stage_dir_var,
    value: ExprCmdSubst { callee: "mktemp", args: ["-d"] },
  }
}


// The end-of-fold receipt line, named once for both folds. Its fields are argv elements rather
// than a sentence assembled by concat, so a host identity carrying a space cannot split
// `host=` from its value and turn one field into two.
fn deploy_receipt_command(host: NonEmptyStr, fold: String) -> String {
  shell_command_text_of_argv(argv: [
    "echo",
    "live-deploy-receipt",
    concat("host=", host as String),
    concat("fold=", fold),
    "verdict=converged",
  ])
}

fn emit_pipeline_or_poison(p: Pipeline, refused: String) -> String {
  match orch_emit_pipeline(p: p, medium: bash_orchestration_emit_medium()) {
    Accepted { value: source, diagnostics: d } =>
      match d {
        None => source.carried
        Some { diagnostics: _ } => refused
      }
    Rejected { diagnostics: _ } => refused
  }
}

// WHERE THE LAUNCH REVISION COMES FROM IS ITSELF A MODELED FACT, AND THERE ARE EXACTLY TWO ARMS
// BECAUSE ONLY TWO ARE HONEST. RevisionBoundAtEmission is the production apply: the launcher
// observed one candidate, the unit installed at the host bakes exactly that value, and readiness
// compares against the same single subject. RevisionNotInstalled is the retract fold, and it exists
// so a retract cannot name a revision even accidentally — the arm that would render ExecStart under
// it REFUSES with a poison marker, the same unreachable-arm discipline
// emit_deploy_teardown_dependency_refusal uses.\n\nA THIRD ARM WAS TRIED AND DELETED, AND THE
// REASON IS WORTH KEEPING. RevisionBoundAtInvocation rendered a bash parameter expansion into the
// unit so a committed script could defer its revision to invocation. It could never have worked:
// the unit body reaches the host as a single-quoted printf argument (it was a quoted-delimiter
// heredoc when this was found, and the property that mattered survived the change), so bash
// performs no expansion inside it and the literal dollar-brace text lands in the unit file; systemd
// does not run ExecStart through bash, implements no :? operator, and this unit sets no such
// Environment. The chain script-invocation to unit to launch argument did not exist at any link.
// Proven by execution, not by reading — which is the point: it typechecked, it read plausibly, and
// it was inert.\n\nWhat it was protecting turned out not to need protecting. It existed to keep a
// committed script as the byte oracle over this ExecStart line, on the belief that deleting the
// artifact would lose that coverage. A fixture sha is forbidden in a committed PRODUCTION artifact,
// not in a witness — so the oracle lives in the test corpus against RevisionBoundAtEmission with a
// fixture, and the artifact was simply dead (no execution consumer, and a HostReconciler consumer
// row that named a reader which does not exist).
type ReleaseRevisionBinding
  = RevisionBoundAtEmission { revision: CommitSha }
  | RevisionNotInstalled

data release_revision_not_installed_poison: String = "__GUNBC_DEPLOY_UNREACHABLE__ the systemd unit writer was reached with RevisionNotInstalled — a retract fold dispatched a unit install. This marker is not a valid release revision, so the golden drift gate reds rather than emitting a unit whose ExecStart names no release (DESIGN section 5: an unreachable arm refuses loudly, never fabricates)."

// A LIMIT RENDERS ITS FLAG OR RENDERS NOTHING, AND THE EMPTY ARM IS NOT A DEFAULT.
// LimitUnset is a declared policy state (std.evaluation_budget
// evaluation_limit_unset_is_a_state_not_a_default_note), so it emits no flag and the
// process announces `unset` at startup — the same visible operational fact it announces
// today. What changes is that production no longer REACHES that arm by omission.
fn eval_budget_flag_text(flag: String, limit: EvaluationLimit) -> String {
  match limit {
    LimitUnset => ""
    LimitSet { limit: l } =>
      join([" ", flag, " ", to_string(positive_millisecond_count(m: l))], "")
  }
}

fn release_revision_execstart_text(binding: ReleaseRevisionBinding) -> String {
  match binding {
    RevisionBoundAtEmission { revision: r } => r as String
    RevisionNotInstalled => release_revision_not_installed_poison
  }
}

// THE TYPED UNIT VALUE IS A NAMED PRODUCER, so a reader that compares the EFFECTIVE unit on a host
// against what this revision would install (gunbc.live_deploy.unit_standing) consumes the same
// directive list the emission serializes, rather than re-parsing the rendered text. The doc
// producers below delegate here; behaviour is unchanged.
// THE BOUND IS THE RUNNER SLOT'S, BY IDENTITY OF WORKLOAD RATHER THAN BY COINCIDENCE OF NUMBER. The
// deployment's oneshots run `gunbc run` over the same corpus a CI job resolves, and the server is
// the same binary; gunbc_runner_slot_desired is the fleet's one authored allowance for that
// process, and a second literal here would be the section-3 fork. Measured on srv1 2026-09-04 for
// scale: the serve process peaked at 3.46 GB and the belt at 0.97 GB, both well inside it.
fn live_deploy_slice_unit_file(spec: DeploymentSpec) -> SystemdUnitFile {
  let slot = gunbc_runner_slot_desired()
  SliceUnitFile {
    unit: [
      Description { text: join(["gunbc deployment cgroup bound for ", spec.names.unit_name as String], "") as NonEmptyStr },
    ],
    slice: [
      slice_memory_max(bytes: slot.memory_max),
      slice_memory_high(bytes: slot.memory_high),
    ],
    install: NotInstallable,
  }
}

fn emit_slice_unit_doc(spec: DeploymentSpec) -> Doc {
  doc_text(text: serialize_systemd_unit_file(file: live_deploy_slice_unit_file(spec: spec)))
}

// THE USER-MANAGER ENVIRONMENT FOR UNITS THAT START OR OBSERVE USER UNITS. Both the serve unit (POST
// /dispatch starts a worker) and the belt unit (spawns reviewers and auditors, reads every attempt
// unit's SubState and ExecMainStatus) run as system services under the service principal; the user
// manager they must reach is addressed by the principal's uid (gunbc.live_deploy.spec
// gunbc_service_uid). Emitted as two Environment= lines rather than resolved at runtime because the
// unit file is the authority the deploy installs and the oracle witness pins.
fn user_manager_environment_directives(uid: Int) -> List<SystemdServiceDirective> {
  [
    Environment { assignment: join(["XDG_RUNTIME_DIR=/run/user/", to_string(uid)], "") as NonEmptyStr },
    Environment { assignment: join(["DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/", to_string(uid), "/bus"], "") as NonEmptyStr },
  ]
}

// The belt-B unit: ExecStart is `gunbc serve` (the seed binary answering every request through the
// ONE .dag entry gunbc.roadmap_serve.roadmap_serve_handle — no emitted JS, no subprocess dispatch).
// User=briansrls, NOT root: claude auth exists only under briansrls on srv1 (parent lane
// verification 2026-07-20), so a root-run belt would spawn unauthed dead sessions; port 8080 is
// non-privileged so briansrls binds it. WorkingDirectory = the repo root — the source roots and
// entry are relative to it, and the belt's spawn workdir projects the same gunbc.host_layout fact.
fn live_deploy_serve_unit_file(spec: DeploymentSpec, revision: ReleaseRevisionBinding) -> SystemdUnitFile {
  let svc = spec.service
  let port = to_string(svc.listen.port)
  let host = svc.listen.host
  ServiceUnitFile {
    unit: [
      Description { text: "gunbc roadmap HTTP server (gunbc serve)" as NonEmptyStr },
      After { target: "network-online.target tailscaled.service" as NonEmptyStr },
      Wants { target: "network-online.target" as NonEmptyStr },
    ],
    service: concat([
      ServiceType { mode: "simple" as NonEmptyStr },
      ServiceUser { name: svc.service_user },
      ServiceGroup { name: svc.service_user },
      ServiceSlice { name: deployment_slice_unit_name(names: spec.names) },
      WorkingDirectory { path: svc.repo_root },
    ], concat(user_manager_environment_directives(uid: svc.service_uid), [
      ExecStart { command: join([
        svc.serve_binary as String,
        " serve --source-root dag --source-root src/v2",
        " --entry dag/gunbc/roadmap/roadmap_serve.dag --function ", svc.serve_function as String,
        " --host ", host, " --port ", port,
        " --release-revision ", release_revision_execstart_text(binding: revision),
        eval_budget_flag_text(flag: "--eval-budget-cpu-ms", limit: svc.serve_cpu_limit),
        eval_budget_flag_text(flag: "--eval-budget-wall-ms", limit: svc.serve_wall_limit),
      ], "") as NonEmptyStr },
      Restart { policy: "on-failure" as NonEmptyStr },
    ])),
    install: Installable { directives: [WantedBy { target: "multi-user.target" as NonEmptyStr }] },
  }
}

fn emit_systemd_unit_doc(spec: DeploymentSpec, revision: ReleaseRevisionBinding) -> Doc {
  doc_text(text: serialize_systemd_unit_file(file: live_deploy_serve_unit_file(spec: spec, revision: revision)))
}

// OnUnitInactiveSec, NOT OnUnitActiveSec, and the difference is a fail-closed choice rather than a
// formatting one. OnUnitActiveSec measures from when the tick STARTED, so a tick that runs longer
// than the cadence schedules its successor while it is still running and ticks pile up back-to-back
// — for a unit whose job is spawning agent sessions, that converts a slow tick into overlapping
// spawns. OnUnitInactiveSec measures from when the previous tick FINISHED, so the gap is real
// regardless of how long a tick takes and the belt can never outrun itself. systemd additionally
// refuses to start a Type=oneshot unit that is already active, so the two together make overlap
// unwritable rather than unlikely.
//
// 60s is the operator's stated default for this lane and is deliberately not tuned against
// anything: a tick against an unchanged frontier is an idempotent reconcile that observes live tmux
// sessions and does nothing (belt_run_once_note), so the cost of a too-fast cadence is an
// observation, not an action. AccuracySec=5s keeps systemd from coalescing the timer into a distant
// wakeup window, which is the default behavior and would otherwise make the effective cadence
// unpredictable.
//
// OnBootSec=2min rather than firing immediately: at boot the tree sync, the serve unit and
// tailscale are all converging, and a belt tick that spawns before the repo tree is in place
// produces SpawnFailed rows for a condition that resolves itself within seconds. The delay costs
// one cadence period and removes a class of self-inflicted refusals from the receipt.

data belt_tick_cadence: String = "60s"

fn live_deploy_belt_service_unit_file(spec: DeploymentSpec) -> SystemdUnitFile {
  let svc = spec.service
  ServiceUnitFile {
    unit: [
      Description { text: "gunbc roadmap belt tick (one reconcile pass over the ready frontier)" as NonEmptyStr },
      After { target: "network-online.target" as NonEmptyStr },
      Wants { target: "network-online.target" as NonEmptyStr },
    ],
    service: concat([
      ServiceType { mode: "oneshot" as NonEmptyStr },
      ServiceUser { name: svc.service_user },
      ServiceGroup { name: svc.service_user },
      ServiceSlice { name: deployment_slice_unit_name(names: spec.names) },
      WorkingDirectory { path: svc.repo_root },
      Environment { assignment: join([
        belt_spawn_workdir_env_var as String, "=", svc.repo_root as String,
      ], "") as NonEmptyStr },
    ], concat(user_manager_environment_directives(uid: svc.service_uid), [
      ExecStart { command: join([
        svc.serve_binary as String,
        " run --source-root dag --source-root src/v2",
        " --entry dag/gunbc/roadmap/roadmap_belt_tick_cli.dag --function belt_run_once_cli",
      ], "") as NonEmptyStr },
    ])),
    install: NotInstallable,
  }
}

fn emit_belt_service_unit_doc(spec: DeploymentSpec) -> Doc {
  doc_text(text: serialize_systemd_unit_file(file: live_deploy_belt_service_unit_file(spec: spec)))
}

// THE PUBLICATION HELPER: THE ONLY UNIT IN THIS DEPLOYMENT THAT BINDS A CREDENTIAL, AND THE ONLY
// ONE WHOSE User= IS NOT THE SERVICE PRINCIPAL. gunbc.live_deploy.spec deployment_credential_env_path
// carries the full argument for why that pairing is the boundary rather than the file being one;
// what this emission adds is the enforcement, and it is worth stating what each line is doing:
//
// User=/Group= name the publication principal, so the credential file this unit reads is owned by
// an account the service user is not. EnvironmentFileIfPresent is the `-` prefixed form, so an
// absent file leaves the unit startable and the helper answers with a recorded refusal naming the
// variable -- the located refusal is a FEATURE, and the required form would replace it with a unit
// that will not start. Type=oneshot with no Restart, because a run either answers its spool or
// reports why it could not, and the timer is what asks again.
//
// THERE IS NO Environment= LINE AND NO SPAWN ROOT. The belt unit carries GUNBC_BELT_SPAWN_WORKDIR
// because a tick creates worktrees and launches provider sessions; this unit reads documents and
// writes documents, so it is handed one argument -- the instance root whose spool it answers -- and
// nothing that would let it act on a tree.
fn emit_publication_service_unit_doc(spec: DeploymentSpec) -> Doc {
  let svc = spec.service
  doc_text(text: serialize_systemd_unit_file(file: ServiceUnitFile {
    unit: [
      Description { text: "gunbc roadmap publication helper (answers publication requests under its own principal)" as NonEmptyStr },
      After { target: "network-online.target" as NonEmptyStr },
      Wants { target: "network-online.target" as NonEmptyStr },
    ],
    service: [
      ServiceType { mode: "oneshot" as NonEmptyStr },
      ServiceUser { name: spec.names.publication_principal },
      ServiceGroup { name: spec.names.publication_principal },
      ServiceSlice { name: deployment_slice_unit_name(names: spec.names) },
      WorkingDirectory { path: svc.repo_root },
      EnvironmentFileIfPresent { path: deployment_credential_env_path(names: spec.names) },
      ExecStart { command: join([
        svc.serve_binary as String,
        " run --source-root dag --source-root src/v2",
        " --entry dag/gunbc/roadmap/roadmap_publication_helper.dag",
        " --function publication_helper_run_once_cli",
        " --arg instance_root=", svc.instance_root as String,
      ], "") as NonEmptyStr },
    ],
    install: NotInstallable,
  }))
}

// THE HELPER'S CADENCE MIRRORS THE BELT'S, and the mirroring is load-bearing rather than tidy: a
// publication request is written by a belt tick and answered by a helper run, so the two cadences
// compose into the latency an operator actually sees. Equal periods make that one tick of extra
// latency; a slower helper would make the belt's own cadence meaningless for this pass.
//
// OnUnitInactiveSec for the same reason belt_tick_cadence's annotation gives: it measures from when the
// previous run FINISHED, so a run that outlasts the period cannot schedule its own successor. A
// helper run performs one network read per unanswered request, so that property matters here for
// the same reason it matters there.
fn emit_publication_timer_unit_doc(spec: DeploymentSpec) -> Doc {
  doc_text(text: serialize_systemd_unit_file(file: TimerUnitFile {
    unit: [Description { text: "gunbc roadmap publication helper cadence" as NonEmptyStr }],
    timer: [
      TimerUnit { target: deployment_publication_service_unit_name(names: spec.names) },
      OnBootSec { duration: "2min" as NonEmptyStr },
      OnUnitInactiveSec { duration: belt_tick_cadence as NonEmptyStr },
      AccuracySec { duration: "5s" as NonEmptyStr },
    ],
    install: Installable { directives: [WantedBy { target: "timers.target" as NonEmptyStr }] },
  }))
}

fn apply_publication_service_unit_write_step(spec: DeploymentSpec) -> PipelineStep {
  deploy_raw(command: deploy_stage_write_command(
    stage_name: deployment_publication_service_unit_name(names: spec.names) as String,
    content: render(doc: emit_publication_service_unit_doc(spec: spec), proto: live_deploy_protocol),
  ))
}

fn apply_publication_timer_unit_write_step(spec: DeploymentSpec) -> PipelineStep {
  deploy_raw(command: deploy_stage_write_command(
    stage_name: deployment_publication_timer_unit_name(names: spec.names) as String,
    content: render(doc: emit_publication_timer_unit_doc(spec: spec), proto: live_deploy_protocol),
  ))
}

// THE TWO SPOOL DIRECTORIES CARRY OPPOSITE PERMISSIONS, AND THAT IS THE WHOLE ENFORCEMENT.
//
// requests/ is owned by the publication principal with the SERVICE user's group and mode 0730:
// group write plus group search, and NO group read. The service user can therefore CREATE a request
// and cannot list the directory, read another request, or replace one it did not name; the helper,
// as owner, can do all three.
//
// answers/ is owned by the publication principal outright at 0755. The service user can read an
// answer -- a publication receipt carries no secret -- and cannot write one. That asymmetry is what
// makes a forged answer unwritable rather than merely unlikely: an answer the service user could
// create would be a publication receipt the belt then copies to the attempt's own address as though
// GitHub had been asked, which is the fabricated-plausible-output failure with a filesystem write
// standing in for a network read.
//
// THE MODE IS STATED RATHER THAN DERIVED, and install_d_shared_mode's annotation already records
// that this is the open frontier: a member's mode should be derived from which principals need which
// verbs on it. These two are the first members in this emitter whose modes are NOT the shared 0755
// constant, and they are stated here with the dependents that force them written above -- which is
// the input that derivation will eventually consume, not a second convention beside it.
data publication_spool_request_mode: NonEmptyStr = "0730"

data publication_spool_answer_mode: NonEmptyStr = "0755"

fn apply_publication_spool_steps(spec: DeploymentSpec) -> List<PipelineStep> {
  [
    deploy_raw(command: install_directory_owned_command(
      mode: publication_spool_answer_mode,
      owner: spec.names.publication_principal,
      group: spec.names.publication_principal,
      path: publication_spool_root(instance_root: spec.service.instance_root as String),
    )),
    deploy_raw(command: install_directory_owned_command(
      mode: publication_spool_request_mode,
      owner: spec.names.publication_principal,
      group: spec.service.service_user,
      path: publication_request_dir(instance_root: spec.service.instance_root as String),
    )),
    deploy_raw(command: install_directory_owned_command(
      mode: publication_spool_answer_mode,
      owner: spec.names.publication_principal,
      group: spec.names.publication_principal,
      path: publication_answer_dir(instance_root: spec.service.instance_root as String),
    )),
  ]
}

fn live_deploy_belt_timer_unit_file(spec: DeploymentSpec) -> SystemdUnitFile {
  TimerUnitFile {
    unit: [Description { text: "gunbc roadmap belt tick cadence" as NonEmptyStr }],
    timer: [
      TimerUnit { target: deployment_belt_service_unit_name(names: spec.names) },
      OnBootSec { duration: "2min" as NonEmptyStr },
      OnUnitInactiveSec { duration: belt_tick_cadence as NonEmptyStr },
      AccuracySec { duration: "5s" as NonEmptyStr },
    ],
    install: Installable { directives: [WantedBy { target: "timers.target" as NonEmptyStr }] },
  }
}

fn emit_belt_timer_unit_doc(spec: DeploymentSpec) -> Doc {
  doc_text(text: serialize_systemd_unit_file(file: live_deploy_belt_timer_unit_file(spec: spec)))
}

// THE DEPLOYED TREE'S REMOTE, CONVERGED BY ITS OWNER.
//
// `gunbc.fleet_desired_observe` reads refs/fleet/desired with `git ls-remote origin`, a network
// call through a CONFIGURED remote, and `tree_sync_git_whitelist_note` excludes .git/config from
// the sync because a blanket sync once carried a live Actions token into the service tree. Both are
// correct and neither was checked against the other, so the deploy produced a tree that could not
// answer an observation the belt makes every sixty seconds (srv1, measured 2026-08-18).
//
// WHY A UNIT AND NOT AN APPLY STEP: the tree is service-user-owned and the deploy principal is the
// unprivileged ci-runner, whose NOPASSWD roster (gunbc.fleet_posix_accounts
// fleet_posix_ci_runner_sudo_grants) contains no git, so
// `git config` from the apply is refused on one side and EACCES on the other. The same reasoning
// that produced gunbc-tree-sync.service produces this one -- the owner writes its own tree.
//
// WHY NOT A LEG ON THE TREE-SYNC UNIT, which already has the right principal: that unit is started
// inside the GunbcSourceTree step, and ServeBinary is installed in the step AFTER it, so the gunbc
// binary this invocation needs does not exist yet on a fresh instance. Ordering this member AFTER
// ServeBinary in deployment_owned_steps is what makes the binary a precondition the membership
// establishes -- concretely THIRD, before the belt timer that depends on the remote, not last
// (see deployment_tree_remote_unit_name's header for why last was wrong).
//
// The ExecStart names the tree explicitly rather than deriving it, because a host can run two slots
// and the unit of one slot must not converge the other's tree.
fn emit_tree_remote_unit_doc(spec: DeploymentSpec) -> Doc {
  let svc = spec.service
  doc_text(text: serialize_systemd_unit_file(file: ServiceUnitFile {
    unit: [Description {
      text: "gunbc deployed tree remote convergence (origin URL for fleet desired observation)" as NonEmptyStr,
    }],
    service: [
      ServiceType { mode: "oneshot" as NonEmptyStr },
      ServiceUser { name: svc.service_user },
      ServiceGroup { name: svc.service_user },
      ServiceSlice { name: deployment_slice_unit_name(names: spec.names) },
      WorkingDirectory { path: svc.repo_root },
      ExecStart { command: join([
        svc.serve_binary as String,
        " run --source-root dag --source-root src/v2",
        " --entry dag/gunbc/deployed_tree_remote.dag --function ensure_deployed_tree_remote_wet",
        " --arg repository_path=", svc.repo_root as String,
      ], "") as NonEmptyStr },
    ],
    install: NotInstallable,
  }))
}

fn apply_tree_remote_unit_write_step(spec: DeploymentSpec) -> PipelineStep {
  deploy_raw(command: deploy_stage_write_command(
    stage_name: deployment_tree_remote_unit_name(names: spec.names) as String,
    content: render(doc: emit_tree_remote_unit_doc(spec: spec), proto: live_deploy_protocol),
  ))
}

fn apply_belt_service_unit_write_step(spec: DeploymentSpec) -> PipelineStep {
  deploy_raw(command: deploy_stage_write_command(
    stage_name: deployment_belt_service_unit_name(names: spec.names) as String,
    content: render(doc: emit_belt_service_unit_doc(spec: spec), proto: live_deploy_protocol),
