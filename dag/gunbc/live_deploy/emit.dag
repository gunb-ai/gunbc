data live_deploy_protocol: LayoutProtocol = LayoutProtocol { indent_unit: "" }

// WHAT IS LEFT IN THIS FUNCTION IS THE COUNTED RESIDUAL, and it is named here rather than left to
// a reader to infer from call sites. Every leaf whose words are an extdeps operation row now goes
// through deploy_effect instead: systemd.Systemctl DaemonReload/Enable/Restart, apt.PackageManager
// Install, dpkg.Package Status. What still arrives as a String does so for one of four reasons,
// and each names a different missing capability rather than a shared "not done yet":
//
//   1. NO OPERATION ROW EXISTS for the program -- install(1), rm(1), printf(1), tailscale serve.
//      These are already argv-derived (gunbc.live_deploy.operations, extdeps.tools.gnu_coreutils),
//      so the gap is an extdeps service surface, not a spelling.
//   2. THE COMMAND IS NOT ONE INVOCATION -- the staged writes carry a redirection to a word built
//      from a variable reference, and the tree-sync restart carries a `|| { ...; exit 1; }`
//      diagnosis tail. BoundOperationInvocation names an operation and its inputs; it cannot carry
//      a redirect, a word with an expansion in it, or a failure branch.
//   3. THE LINE IS NOT A COMMAND AT ALL -- `set -euo pipefail` and the
//      __GUNBC_*_REFUSED__ poison markers, which are deliberately not valid shell.
//   4. THE BODY IS HAND-AUTHORED SHELL from another module (the sudoers install, the memory-cap
//      block, the receipt echo), which is that module's own census row, not this one's.
//
// 🟡 dissolve-on: class 1 dissolves when the coreutils/tailscale surfaces carry shell-transport
// operation rows this leaf can bind against; class 2 dissolves when the effect-plan band can carry
// a redirect target and a failure arm on a Do-effect leaf, which is the same capability
// effect_plan_bash_materialize's UnsupportedEffectPlanStep arms currently refuse; class 3 has no
// dissolution -- a marker that must not parse as shell is correctly a String; class 4 is owned by
// the module that authors the body.
fn deploy_raw(command: String) -> PipelineStep {
  Do {
    run: Run {
      command: command,
      env: Empty,
      redirect: Absent,
      capture: Absent
    }
  }
}

// A LIMIT RENDERS ITS FLAG OR RENDERS NOTHING, AND THE EMPTY ARM IS NOT A DEFAULT.
// LimitUnset is a declared policy state (std.evaluation_budget
// evaluation_limit_unset_is_a_state_not_a_default_note), so it emits no flag and the
// process announces `unset` at startup — the same visible operational fact it announces
// today. What changes is that production no longer REACHES that arm by omission.
fn eval_budget_flag_text(flag: String, limit: EvaluationLimit) -> String {
  match limit {
    LimitUnset => ""
    LimitSet { limit: l } =>
      join([" ", flag, " ", to_string(positive_millisecond_count(m: l))], "")
  }
}

// THE TYPED UNIT VALUE IS A NAMED PRODUCER, so a reader that compares the EFFECTIVE unit on a host
// against what this revision would install (gunbc.live_deploy.unit_standing) consumes the same
// directive list the emission serializes, rather than re-parsing the rendered text. The doc
// producers below delegate here; behaviour is unchanged.
fn live_deploy_slice_unit_file(spec: DeploymentSpec) -> SystemdUnitFile {
  SliceUnitFile {
    unit: [
      Description { text: join(["gunbc deployment cgroup bound for ", spec.names.unit_name as String], "") as NonEmptyStr },
    ],
    slice: [
      slice_memory_max(bytes: live_deploy_slice_memory_max),
      slice_memory_high(bytes: live_deploy_slice_memory_high),
      slice_memory_swap_max(bytes: live_deploy_slice_memory_swap_max),
    ],
    install: NotInstallable,
  }
}

fn emit_slice_unit_doc(spec: DeploymentSpec) -> Doc {
  doc_text(text: serialize_systemd_unit_file(file: live_deploy_slice_unit_file(spec: spec)))
}

// THE USER-MANAGER ENVIRONMENT FOR UNITS THAT START OR OBSERVE USER UNITS. Both the serve unit (POST
// /dispatch starts a worker) and the belt unit (spawns reviewers and auditors, reads every attempt
// unit's SubState and ExecMainStatus) run as system services under the service principal; the user
// manager they must reach is addressed by the principal's uid (gunbc.live_deploy.spec
// gunbc_service_uid). Emitted as two Environment= lines rather than resolved at runtime because the
// unit file is the authority the deploy installs and the oracle witness pins.
fn user_manager_environment_directives(uid: Int) -> List<SystemdServiceDirective> {
  [
    Environment { assignment: join(["XDG_RUNTIME_DIR=/run/user/", to_string(uid)], "") as NonEmptyStr },
    Environment { assignment: join(["DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/", to_string(uid), "/bus"], "") as NonEmptyStr },
  ]
}

type LiveDeployServeUnitEmission
  = LiveDeployServeUnitEmitted { file: SystemdUnitFile }
  | LiveDeployServeUnitOidcReadbackRefused { cause: NonEmptyStr }

// Admitted env is empty when the instance is unassigned or the environment is unbound.
// Unsatisfied / missing realization is Refused — never an empty list on a Configured-looking unit.
type LiveDeployOidcUnitEnv
  = LiveDeployOidcEnvAdmitted { directives: List<SystemdServiceDirective> }
  | LiveDeployOidcEnvRefused { cause: NonEmptyStr }

fn live_deploy_oidc_unit_env(standing: TrackerWebOidcServeStanding) -> LiveDeployOidcUnitEnv {
  match standing {
    TrackerWebOidcServeConfigured { config: cfg } =>
      LiveDeployOidcEnvAdmitted { directives: [Environment { assignment: tracker_web_oidc_env_assignment(cfg: cfg) }] }
    TrackerWebOidcInstanceUnassigned { instance_id: _ } =>
      LiveDeployOidcEnvAdmitted { directives: [] }
    TrackerWebOidcEnvironmentUnbound { instance_id: _, reason: _ } =>
      LiveDeployOidcEnvAdmitted { directives: [] }
    TrackerWebOidcRealizationMissing { instance_id: _, environment: _ } =>
      LiveDeployOidcEnvRefused { cause: "tracker-web OIDC realization missing" as NonEmptyStr }
    TrackerWebOidcConsoleReadbackUnsatisfied { instance_id: _, cause } =>
      LiveDeployOidcEnvRefused { cause: cause }
  }
}

fn live_deploy_oidc_unit_env_for(spec: DeploymentSpec, now_epoch: Second?) -> LiveDeployOidcUnitEnv {
  match tracker_web_oidc_serve_placement(instance_id: spec.instance_id) {
    TrackerWebOidcPlacementUnassigned { instance_id: _ } =>
      LiveDeployOidcEnvAdmitted { directives: [] }
    TrackerWebOidcPlacementUnbound { instance_id: _, reason: _ } =>
      LiveDeployOidcEnvAdmitted { directives: [] }
    TrackerWebOidcPlacementMissingRealization { instance_id: _, environment: _ } =>
      LiveDeployOidcEnvRefused { cause: "tracker-web OIDC realization missing" as NonEmptyStr }
    TrackerWebOidcServeReady { config: _ } =>
      match now_epoch {
        Absent => LiveDeployOidcEnvRefused { cause: "observer clock unreadable" as NonEmptyStr }
        Present { value: now } =>
          live_deploy_oidc_unit_env(standing: tracker_web_oidc_serve_standing(instance_id: spec.instance_id, now_epoch: now))
      }
  }
}

fn live_deploy_oidc_unit_env_at(spec: DeploymentSpec, now_epoch: Second) -> LiveDeployOidcUnitEnv {
  live_deploy_oidc_unit_env_for(spec: spec, now_epoch: Present { value: now_epoch })
}

// The belt-B unit: ExecStart is `gunbc serve` (the seed binary answering every request through the
// ONE .dag entry gunbc.roadmap.roadmap_serve.roadmap_serve_handle — no emitted JS, no subprocess dispatch).
// User=briansrls, NOT root: claude auth exists only under briansrls on srv1 (parent lane
// verification 2026-07-20), so a root-run belt would spawn unauthed dead sessions; port 8080 is
// non-privileged so briansrls binds it. WorkingDirectory = the repo root — the source roots and
// entry are relative to it, and the belt's spawn workdir projects the same gunbc.host.host_layout fact.
fn live_deploy_serve_unit_emission(
  spec: DeploymentSpec, revision: ReleaseRevisionBinding, now_epoch: Second?,
) -> LiveDeployServeUnitEmission {
  match live_deploy_oidc_unit_env_for(spec: spec, now_epoch: now_epoch) {
    LiveDeployOidcEnvAdmitted { directives } =>
      LiveDeployServeUnitEmitted { file: live_deploy_serve_unit_file_over(spec: spec, revision: revision, oidc_env: directives) }
    LiveDeployOidcEnvRefused { cause } =>
      LiveDeployServeUnitOidcReadbackRefused { cause: cause }
  }
}

fn live_deploy_serve_unit_emission_at(
  spec: DeploymentSpec, revision: ReleaseRevisionBinding, now_epoch: Second,
) -> LiveDeployServeUnitEmission {
  live_deploy_serve_unit_emission(spec: spec, revision: revision, now_epoch: Present { value: now_epoch })
}

// One unit shape for both of an instance's listeners: the principal, slice, tree, binary, user
// manager environment and evaluation caps are the same value, and the two differ only in the
// entry function they launch and the listener they bind.
fn live_deploy_serve_unit_file_over(
  spec: DeploymentSpec, revision: ReleaseRevisionBinding, oidc_env: List<SystemdServiceDirective>,
) -> SystemdUnitFile {
  let svc = spec.service
  live_deploy_serve_unit_file_over_listener(
    spec: spec, revision: revision, oidc_env: oidc_env,
    description: "gunbc roadmap HTTP server (gunbc serve)" as NonEmptyStr,
    function: svc.serve_function,
    listener: join([" --host ", svc.listen.host, " --port ", to_string(svc.listen.port)], ""),
  )
}

fn live_deploy_serve_unit_file_over_listener(
  spec: DeploymentSpec, revision: ReleaseRevisionBinding, oidc_env: List<SystemdServiceDirective>,
  description: NonEmptyStr, function: NonEmptyStr, listener: String,
) -> SystemdUnitFile {
  let svc = spec.service
  ServiceUnitFile {
    unit: [
      Description { text: description },
      After { target: "network-online.target tailscaled.service" as NonEmptyStr },
      Wants { target: "network-online.target" as NonEmptyStr },
    ],
    service: concat([
      ServiceType { mode: SimpleMode },
      ServiceUser { name: svc.service_user },
      ServiceGroup { name: svc.service_user },
      ServiceSlice { name: deployment_slice_unit_name(names: spec.names) },
      WorkingDirectory { path: svc.repo_root },
    ], concat(user_manager_environment_directives(uid: svc.service_uid), concat(oidc_env, [
      ExecStart { command: join([
        fixed_serve_binary_path(binary: svc.serve_binary),
        " serve",
        deployment_serve_source_root_flags_text(),
        " --entry ", svc.serve_entry as String, " --function ", function as String,
        listener,
        " --release-revision ", release_revision_execstart_text(binding: revision),
        eval_budget_flag_text(flag: "--eval-budget-cpu-ms", limit: svc.serve_cpu_limit),
        eval_budget_flag_text(flag: "--eval-budget-wall-ms", limit: svc.serve_wall_limit),
      ], "") as NonEmptyStr },
      Restart { policy: "on-failure" as NonEmptyStr },
    ]))),
    install: Installable { directives: [WantedBy { target: "multi-user.target" as NonEmptyStr }] },
  }
}

// THE TAILNET DOOR'S UNIT: the same server as the unit above, launched on the door entry and bound
// to the socket the deployment's serve route targets (gunbc.live_deploy.spec
// deployment_tailnet_door_socket). Three arms: emitted, not deployed (no socket), refused (OIDC).
type LiveDeployTailnetDoorUnitEmission
  = LiveDeployTailnetDoorUnitEmitted { file: SystemdUnitFile }
  | LiveDeployTailnetDoorUnitNotDeployed
  | LiveDeployTailnetDoorUnitOidcReadbackRefused { cause: NonEmptyStr }

fn live_deploy_tailnet_door_unit_file(
  spec: DeploymentSpec, revision: ReleaseRevisionBinding, now_epoch: Second?,
) -> LiveDeployTailnetDoorUnitEmission {
  match live_deploy_oidc_unit_env_for(spec: spec, now_epoch: now_epoch) {
    LiveDeployOidcEnvRefused { cause } =>
      LiveDeployTailnetDoorUnitOidcReadbackRefused { cause: cause }
    LiveDeployOidcEnvAdmitted { directives } =>
      match deployment_tailnet_door_socket(names: spec.names) {
        Absent => LiveDeployTailnetDoorUnitNotDeployed
        Present { value: socket } => LiveDeployTailnetDoorUnitEmitted {
          file: live_deploy_serve_unit_file_over_listener(
            spec: spec, revision: revision, oidc_env: directives,
            description: "gunbc roadmap tailnet door (gunbc serve)" as NonEmptyStr,
            function: concat(spec.service.serve_function as String, deployment_tailnet_door_function_suffix) as NonEmptyStr,
            listener: concat(" --unix-socket ", socket as String),
          )
        }
      }
  }
}

// THE FABRIC DB ENDPOINT'S UNIT: `gunbc serve` answering every request through the ONE .dag entry
// gunbc.fabric.fabric_storage_serve fabric_storage_serve_handle, bound to LOOPBACK ONLY -- tailscale serve is the sole
// route to it (FabricStorageServeMapping), which is the deployment fact extdeps.tailscale.identity says
// the identity header's trust rests on. Same principal, slice, tree, binary and declared evaluation
// caps as the dashboard's unit: a request is one store operation on local files, and the caps turn an
// unbounded hold of the serial accept loop into a typed refusal exactly as they do there. The process
// keeps no state between requests -- the store is the files under the ensured fabric DB directory --
// so Restart=on-failure loses nothing.
fn live_deploy_fabric_storage_unit_file(spec: DeploymentSpec, revision: ReleaseRevisionBinding, door_socket: NonEmptyStr) -> SystemdUnitFile {
  let svc = spec.service
  ServiceUnitFile {
    unit: [
      Description { text: "gunbc fabric DB endpoint (gunbc serve)" as NonEmptyStr },
      After { target: "network-online.target tailscaled.service" as NonEmptyStr },
      Wants { target: "network-online.target" as NonEmptyStr },
    ],
    service: concat([
      ServiceType { mode: SimpleMode },
      ServiceUser { name: svc.service_user },
      ServiceGroup { name: svc.service_user },
      ServiceSlice { name: deployment_slice_unit_name(names: spec.names) },
      WorkingDirectory { path: svc.repo_root },
    ], concat(user_manager_environment_directives(uid: svc.service_uid), [
      ExecStart { command: join([
        fixed_serve_binary_path(binary: svc.serve_binary),
        " serve",
        deployment_serve_source_root_flags_text(),
        " --entry dag/gunbc/fabric/fabric_storage_serve.dag --function fabric_storage_serve_handle",
        " --unix-socket ", door_socket as String,
        " --release-revision ", release_revision_execstart_text(binding: revision),
        eval_budget_flag_text(flag: "--eval-budget-cpu-ms", limit: svc.serve_cpu_limit),
        eval_budget_flag_text(flag: "--eval-budget-wall-ms", limit: svc.serve_wall_limit),
      ], "") as NonEmptyStr },
      Restart { policy: "on-failure" as NonEmptyStr },
    ])),
    install: Installable { directives: [WantedBy { target: "multi-user.target" as NonEmptyStr }] },
  }
}

data oidc_readback_refused_poison: String = "__GUNBC_OIDC_READBACK_REFUSED__ "

fn oidc_readback_refused_command(cause: String) -> String {
  concat(oidc_readback_refused_poison, cause)
}

fn emit_systemd_unit_doc(spec: DeploymentSpec, revision: ReleaseRevisionBinding, now_epoch: Second?) -> Doc {
  match live_deploy_serve_unit_emission(spec: spec, revision: revision, now_epoch: now_epoch) {
    LiveDeployServeUnitEmitted { file } =>
      doc_text(text: serialize_systemd_unit_file(file: file))
    LiveDeployServeUnitOidcReadbackRefused { cause } =>
      doc_text(text: concat(oidc_readback_refused_command(cause: cause as String), "\n"))
  }
}

// ── THE APPROVAL BROKER'S SLICE AND UNIT ─────────────────────────────────────────────────────
// The two byte bounds this unit carries are declared in gunbc.live_deploy.slice_bounds, and the
// derivation of each number lives with the row rather than here.
//
// THE SWAP DENIAL IS THE DEPLOYMENT'S POLICY, CONSUMED, NOT RESTATED HERE (review 68287). This slice
// used to inline byte_size(0) while the roadmap slice one function above consumed the declared row,
// so "this deployment's served slices forbid swap" had two sources that could drift in either
// direction invisibly -- admitting swap on the row would have left this one silently pinned at
// zero, and the reverse edit would have been just as quiet.
//
// WHY IT IS ONE FACT AND NOT TWO EQUAL NUMBERS, which is the distinction this corpus keeps having
// to make: the max and high bounds are PER-SLICE and genuinely differ, because they are sized from
// each process's own demand. The swap denial is not sized from anything -- it follows from both
// processes being latency-bound and operator-facing, which is one argument covering both. Declaring
// a second zero beside this one would be two names for that argument.
//
// The receipt is the same receipt: boot 15 did not fail because the roadmap process was large, it
// failed because that process was SWAPPED and then OOM-killed, and a swapped process is one whose
// latency is unbounded while it still looks alive.
fn approval_broker_slice_unit_file() -> SystemdUnitFile {
  SliceUnitFile {
    unit: [
      Description { text: "gunbc approval broker cgroup bound (separate from the roadmap deployment slice)" as NonEmptyStr },
    ],
    slice: [
      slice_memory_max(bytes: approval_broker_slice_memory_max),
      slice_memory_high(bytes: approval_broker_slice_memory_high),
      slice_memory_swap_max(bytes: live_deploy_slice_memory_swap_max),
    ],
    install: NotInstallable,
  }
}

// THE BROKER UNIT IS THE ROADMAP UNIT WITH THREE FIELDS DIFFERENT AND ONE DIRECTIVE REMOVED, and
// every difference is the split.
//
// Slice= names the broker's own slice, which is the whole construction: two cgroups means the
// roadmap's resident set cannot evict the broker's.
//
// THE USER-MANAGER ENVIRONMENT IS ABSENT ON PURPOSE. The roadmap unit carries XDG_RUNTIME_DIR and
// DBUS_SESSION_BUS_ADDRESS because POST /dispatch starts a user unit and the belt observes them.
// The broker starts nothing and observes nothing: it files a request, renders a page, redeems a
// capability and reads a standing. Handing it an address for the user manager would be handing it a
// capability its routes have no use for, and a capability a process does not need is one more thing
// a defect in it can reach.
//
// Restart=on-failure and a distinct MainPID are the other half of the availability property: a
// broker that dies is restarted by systemd on its own lifecycle, rather than waiting for whoever
// notices the dashboard is down.
fn live_deploy_approval_broker_unit_file(spec: DeploymentSpec, revision: ReleaseRevisionBinding) -> SystemdUnitFile {
  live_deploy_approval_broker_unit_file_on(spec: spec, revision: revision, port: spec.approval_broker.listen.port)
}

// THE PORT IS AN ARGUMENT SO THE DARK STAGE IS THE SAME UNIT, NOT A SECOND ONE. Stage 1 of
// gunbc.auth.approval_broker_cutover installs this unit on the broker's one port, and stage 4's repoint
// installs it on the serving port; if those were two unit producers, the process measured at stage
// 2 would not be the process routed to at stage 5, and every reading taken would be about a build
// nobody ran. One producer, one argument.
fn live_deploy_approval_broker_unit_file_on(
  spec: DeploymentSpec,
  revision: ReleaseRevisionBinding,
  port: Port,
) -> SystemdUnitFile {
  let svc = spec.approval_broker
  let release_dir = release_locus_dir(root: svc.repo_root as String, revision: revision)
  ServiceUnitFile {
    unit: [
      Description { text: "gunbc approval broker HTTP server (gunbc serve)" as NonEmptyStr },
      After { target: join(["network-online.target tailscaled.service ", gunbc_device_crypto_sidecar_unit_name as String], "") as NonEmptyStr },
      Wants { target: join(["network-online.target ", gunbc_device_crypto_sidecar_unit_name as String], "") as NonEmptyStr },
    ],
    service: [
      ServiceType { mode: SimpleMode },
      ServiceUser { name: svc.service_user },
      ServiceGroup { name: svc.service_user },
      ServiceSlice { name: gunbc_approval_broker_slice_unit_name },
      WorkingDirectory { path: release_dir as NonEmptyStr },
      EnvironmentFile { path: device_crypto_deployed_digest_env_file_path(root: svc.repo_root as String, revision: revision) as NonEmptyStr },
      release_locus_workspace_root_environment(release_dir: release_dir),
      approval_broker_base_url_environment(spec: spec),
      ExecStart { command: join([
        serve_binary_path(binary: svc.serve_binary, release_root: svc.repo_root as String, revision: revision),
        " serve",
        deployment_serve_source_root_flags_text(),
        " --entry ", svc.serve_entry as String, " --function ", svc.serve_function as String,
        " --host ", svc.listen.host, " --port ", to_string(port),
        " --release-revision ", release_revision_execstart_text(binding: revision),
        eval_budget_flag_text(flag: "--eval-budget-cpu-ms", limit: svc.serve_cpu_limit),
        eval_budget_flag_text(flag: "--eval-budget-wall-ms", limit: svc.serve_wall_limit),
      ], "") as NonEmptyStr },
      Restart { policy: "on-failure" as NonEmptyStr },
    ],
    install: Installable { directives: [WantedBy { target: "multi-user.target" as NonEmptyStr }] },
  }
}

// THE SIDECAR IS THE BROKER'S DEPENDENCY, SO ITS UNIT IS THE BROKER'S LOCUS-MEMBER: same service user, same release
// directory, a native binary installed beside gunbc. The bind is the typed Port row the broker's client dials
// (approval_device_crypto_sidecar_port), never a literal, so moving the port moves both ends.
fn live_deploy_device_crypto_sidecar_unit_file(spec: DeploymentSpec, revision: ReleaseRevisionBinding) -> SystemdUnitFile {
  let svc = spec.approval_broker
  let release_dir = release_locus_dir(root: svc.repo_root as String, revision: revision)
  ServiceUnitFile {
    unit: [
      Description { text: "gunbc device-crypto verifier sidecar (native serve entry)" as NonEmptyStr },
      After { target: "network-online.target" as NonEmptyStr },
    ],
    service: [
      ServiceType { mode: SimpleMode },
      ServiceUser { name: svc.service_user },
      ServiceGroup { name: svc.service_user },
      ServiceSlice { name: gunbc_approval_broker_slice_unit_name },
      WorkingDirectory { path: release_dir as NonEmptyStr },
      ExecStart { command: join([
        device_crypto_sidecar_binary_path(spec: spec, revision: revision),
        " --host ", approval_device_crypto_sidecar_host as String,
        " --port ", to_string(approval_device_crypto_sidecar_port as Int),
        " --release-revision ", release_revision_execstart_text(binding: revision),
      ], "") as NonEmptyStr },
      Restart { policy: "on-failure" as NonEmptyStr },
    ],
    install: Installable { directives: [WantedBy { target: "multi-user.target" as NonEmptyStr }] },
  }
}

fn device_crypto_sidecar_binary_path(spec: DeploymentSpec, revision: ReleaseRevisionBinding) -> String {
  release_locus_member_path(root: spec.approval_broker.repo_root as String, revision: revision, name: approval_device_crypto_serve_release_bin_name)
}

data device_crypto_deployed_digest_env_file_name: String = "device-crypto-deployed-digest.env"

fn device_crypto_deployed_digest_env_file_path(root: String, revision: ReleaseRevisionBinding) -> String {
  release_locus_member_path(root: root, revision: revision, name: device_crypto_deployed_digest_env_file_name)
}

fn emit_device_crypto_sidecar_unit_doc(spec: DeploymentSpec, revision: ReleaseRevisionBinding) -> Doc {
  doc_text(text: serialize_systemd_unit_file(file: live_deploy_device_crypto_sidecar_unit_file(spec: spec, revision: revision)))
}

fn emit_approval_broker_unit_doc(spec: DeploymentSpec, revision: ReleaseRevisionBinding) -> Doc {
  doc_text(text: serialize_systemd_unit_file(file: live_deploy_approval_broker_unit_file(spec: spec, revision: revision)))
}

fn live_deploy_belt_service_unit_file(spec: DeploymentSpec) -> SystemdUnitFile {
  let svc = spec.service
  ServiceUnitFile {
    unit: [
      Description { text: "gunbc roadmap belt launch (queues the one launch obligation: admission, spawn, teardown, discovery)" as NonEmptyStr },
      After { target: "network-online.target" as NonEmptyStr },
      Wants { target: "network-online.target" as NonEmptyStr },
      OnSuccess { unit: deployment_belt_credential_recovery_unit_name(names: spec.names) },
      OnFailure { unit: deployment_belt_credential_recovery_unit_name(names: spec.names) },
    ],
    service: concat([
      ServiceType { mode: OneshotMode },
      TimeoutStartSec { duration: systemd_time_span_of_seconds(d: instance_obligation_run_bound(kind: LaunchObligation)) },
      ServiceUser { name: svc.service_user },
      ServiceGroup { name: svc.service_user },
      ServiceSlice { name: deployment_slice_unit_name(names: spec.names) },
      WorkingDirectory { path: svc.repo_root },
      Environment { assignment: join([
        belt_spawn_workdir_env_var as String, "=", svc.repo_root as String,
      ], "") as NonEmptyStr },
    ], concat(user_manager_environment_directives(uid: svc.service_uid), [
      ExecStart { command: join([
        fixed_serve_binary_path(binary: svc.serve_binary),
        " run --source-root dag --source-root src/v2",
        " --entry dag/gunbc/roadmap/roadmap_belt_tick_cli.dag --function belt_launch_enqueue_cli",
      ], "") as NonEmptyStr },
    ])),
    install: NotInstallable,
  }
}

fn emit_belt_service_unit_doc(spec: DeploymentSpec) -> Doc {
  doc_text(text: serialize_systemd_unit_file(file: live_deploy_belt_service_unit_file(spec: spec)))
}

// THE PUBLICATION HELPER: THE ONLY UNIT WHOSE User= IS NOT THE SERVICE PRINCIPAL. It mints a
// gunbai-bot installation token from the host-custodied App key (group-readable by this principal)
// and binds no environment file. Type=oneshot with no Restart, because a run either answers its
// spool or reports why it could not, and the path unit is what asks again.
//
// THERE IS NO Environment= LINE AND NO SPAWN ROOT. The belt unit carries GUNBC_BELT_SPAWN_WORKDIR
// because a tick creates worktrees and launches provider sessions; this unit reads documents and
// writes documents, so it is handed one argument -- the instance root whose spool it answers -- and
// nothing that would let it act on a tree.
fn live_deploy_publication_service_unit_file(spec: DeploymentSpec) -> SystemdUnitFile {
  let svc = spec.service
  ServiceUnitFile {
    unit: [
      Description { text: "gunbc roadmap publication helper (answers publication requests under its own principal)" as NonEmptyStr },
      After { target: "network-online.target" as NonEmptyStr },
      Wants { target: "network-online.target" as NonEmptyStr },
    ],
    service: [
      ServiceType { mode: OneshotMode },
      ServiceUser { name: spec.names.publication_principal },
      ServiceGroup { name: spec.names.publication_principal },
      ServiceSlice { name: deployment_slice_unit_name(names: spec.names) },
      WorkingDirectory { path: svc.repo_root },
      ExecStart { command: join([
        fixed_serve_binary_path(binary: svc.serve_binary),
        " run --source-root dag --source-root src/v2",
        " --entry dag/gunbc/roadmap/roadmap_publication_helper.dag",
        " --function publication_helper_run_once_cli",
        " --arg instance_root=", svc.instance_root as String,
      ], "") as NonEmptyStr },
    ],
    install: NotInstallable,
  }
}

fn emit_publication_service_unit_doc(spec: DeploymentSpec) -> Doc {
  doc_text(text: serialize_systemd_unit_file(file: live_deploy_publication_service_unit_file(spec: spec)))
}

// THE HELPER RUNS WHEN A REQUEST LANDS, not on a clock. A publication request is a file in the
// instance's request spool; DirectoryNotEmpty starts the helper. Stopping outcomes move the
// request out of the pending set (publication_helper_retire_request); a leftover that cannot
// move would otherwise retrigger immediately until systemd's default trigger limit failed the
// .path unit until the next apply. TriggerLimit* / StartLimit* bound that residual to the
// retired timer's cadence (belt_tick_cadence). A quarantine write is the re-ask: PathChanged on
// refused/ starts belt discovery, which re-enqueues PublishObligation. The residual stall after
// the bound is gunbc.rung_drop publication_path_unbounded_retrigger.
fn live_deploy_publication_path_unit_file(spec: DeploymentSpec) -> SystemdUnitFile {
  PathUnitFile {
    unit: [
      Description { text: "gunbc roadmap publication helper: a request was written" as NonEmptyStr },
      StartLimitIntervalSec { duration: systemd_time_span_of_seconds(d: belt_tick_cadence) },
      StartLimitBurst { count: "2" as NonEmptyStr },
    ],
    path: concat(
      concat(
        [PathUnit { target: deployment_publication_service_unit_name(names: spec.names) }],
        map(spool_role_dirs(kind: SpoolPublication, instance_root: spec.service.instance_root as String, roles: spool_watched_roles(kind: SpoolPublication)), d => DirectoryNotEmpty { path: d as NonEmptyStr }),
      ),
      [
        TriggerLimitIntervalSec { duration: systemd_time_span_of_seconds(d: belt_tick_cadence) },
        TriggerLimitBurst { count: "2" as NonEmptyStr },
      ],
    ),
    install: Installable { directives: [WantedBy { target: "paths.target" as NonEmptyStr }] },
  }
}

fn emit_publication_path_unit_doc(spec: DeploymentSpec) -> Doc {
  doc_text(text: serialize_systemd_unit_file(file: live_deploy_publication_path_unit_file(spec: spec)))
}

// THE TWO SPOOL DIRECTORIES CARRY OPPOSITE PERMISSIONS, AND THAT IS THE WHOLE ENFORCEMENT.
//
// requests/ is owned by the publication principal with the SERVICE user's group and mode 0730:
// group write plus group search, and NO group read. The service user can therefore CREATE a request
// and cannot list the directory, read another request, or replace one it did not name; the helper,
// as owner, can do all three.
//
// answers/ is owned by the publication principal outright at 0755. The service user can read an
// answer -- a publication receipt carries no secret -- and cannot write one. That asymmetry is what
// makes a forged answer unwritable rather than merely unlikely: an answer the service user could
// create would be a publication receipt the belt then copies to the attempt's own address as though
// GitHub had been asked, which is the fabricated-plausible-output failure with a filesystem write
// standing in for a network read.
//
// THE MODE IS STATED RATHER THAN DERIVED, and install_d_shared_mode's annotation already records
// that this is the open frontier: a member's mode should be derived from which principals need which
// verbs on it. These two are the first members in this emitter whose modes are NOT the shared 0755
// constant, and they are stated here with the dependents that force them written above -- which is
// the input that derivation will eventually consume, not a second convention beside it.
data publication_spool_request_mode: FileMode = FileMode {
  owner: PermissionBits { read: true, write: true, execute: true },
  group: PermissionBits { read: false, write: true, execute: true },
  other: PermissionBits { read: false, write: false, execute: false },
  setuid: false,
  setgid: false,
  sticky: false,
}

data publication_spool_answer_mode: FileMode = declared_directory_mode(m: DirectoryOwnerAllEveryoneTraverse)

data attempt_unit_spool_answer_mode: FileMode = FileMode {
  owner: PermissionBits { read: true, write: true, execute: true },
  group: PermissionBits { read: true, write: false, execute: true },
  other: PermissionBits { read: false, write: false, execute: false },
  setuid: false,
  setgid: false,
  sticky: false,
}

// THE ROOT SIDE OF THE ATTEMPT-UNIT SPOOL IS A SYSTEM ONESHOT STARTED BY A .path UNIT, the publication
// helper's shape (PublicationHelperPathUnit): a request was written, so the service runs the
// launcher entry from the root-owned release and answers the spool. No requester holds a sudo grant
// for it and none waits on it. systemd runs one activation of the service at a time, which is the
// mutual exclusion the retired drain.lock flock provided; a request written while a drain runs
// leaves requests/ non-empty, and the path unit starts the service again when it finishes.
// TimeoutStartSec is the start path's own watchdog (belt_tick_run_bound): a start-wait request holds
// the activation for one worker's whole lifetime.
type AttemptUnitDrainServiceFile
  = AttemptUnitDrainServiceReady { file: SystemdUnitFile }
  | AttemptUnitDrainServiceRefused { cause: NamedArgumentAdmission }

fn live_deploy_attempt_unit_drain_service_unit_file(
  spec: DeploymentSpec,
  instance: HostDashboardInstance,
  revision: ReleaseRevisionBinding,
) -> AttemptUnitDrainServiceFile {
  match attempt_system_unit_launch_gunbc_argv_at(instance: instance, revision: revision) {
    AttemptSystemUnitLaunchArgvRefused { cause } => AttemptUnitDrainServiceRefused { cause: cause }
    AttemptSystemUnitLaunchArgvReady { argv } =>
      AttemptUnitDrainServiceReady { file: ServiceUnitFile {
        unit: [
          Description { text: "gunbc attempt-unit spool drain (starts the dashboard's attempt worker units as the system manager)" as NonEmptyStr },
          Condition { kind: ConditionDirectoryNotEmpty, negated: true, argument: attempt_unit_spool_stalled_dir(instance_root: spec.service.instance_root as String) as NonEmptyStr },
        ],
        service: [
          ServiceType { mode: OneshotMode },
          TimeoutStartSec { duration: systemd_time_span_of_seconds(d: belt_tick_run_bound) },
          // THE DEPLOYMENT SLICE, like every other service that runs gunbc: without Slice= the oneshot lands in
          // system.slice, where gunbc refuses to run (user_work_scope: UncappedSystemSlice) and the .path
          // unit then trips its start limit. Measured on the srv1 lab, 2026-10-21.
          ServiceSlice { name: deployment_slice_unit_name(names: spec.names) },
          ExecStart { command: join(argv, " ") as NonEmptyStr },
        ],
        install: NotInstallable,
      } }
  }
}

fn live_deploy_attempt_unit_drain_path_unit_file(spec: DeploymentSpec) -> SystemdUnitFile {
  PathUnitFile {
    unit: [
      Description { text: "gunbc attempt-unit spool drain: a start request was written" as NonEmptyStr },
    ],
    path: concat(
      concat(
        [PathUnit { target: deployment_attempt_unit_drain_service_unit_name(names: spec.names) }],
        map(spool_role_dirs(kind: SpoolAttemptUnit, instance_root: spec.service.instance_root as String, roles: spool_watched_roles(kind: SpoolAttemptUnit)), d => DirectoryNotEmpty { path: d as NonEmptyStr }),
      ),
      [
        TriggerLimitIntervalSec { duration: systemd_time_span_of_seconds(d: belt_exit_trigger_limit_interval) },
        TriggerLimitBurst { count: to_string(value: belt_exit_trigger_limit_burst) as NonEmptyStr },
      ],
    ),
    install: Installable { directives: [WantedBy { target: "paths.target" as NonEmptyStr }] },
  }
}

// THE RETIRED SUDO ROUTE, REMOVED FROM HOSTS THAT CONVERGED UNDER IT. Before the root drain was a path-triggered
// oneshot, apply installed a per-instance sudoers drop-in for the launcher, an `installed-revision` receipt in the
// helper locus, and the requester flocked `drain.lock` in the spool. This apply deletes all three (rm -f is
// idempotent), so a host that held the grant does not keep a standing root-by-sudo route beside the new one
// (DESIGN section 3: the old authority ends in one motion), then `visudo -cf /etc/sudoers` validates what remains.
// SHAPE FOLLOWS leftover_systemd_timer_retire_steps (named retired-artifact rows, rm -f, then a readback that fails
// the apply); the dissolution is attempt_unit_sudo_route_retire_dissolution.
data attempt_unit_sudo_route_retire_dissolution: DissolutionCondition = unbound_dissolution(description: "delete retired_attempt_unit_sudo_route_paths and its apply step once every deployed instance's apply has run the removal and passed the sudoers check" as NonEmptyStr)

fn retired_attempt_unit_sudo_route_paths(instance: HostDashboardInstance) -> List<String> {
  [
    join(["/etc/sudoers.d/gunbc-attempt-system-unit-", instance.instance_id as String], ""),
    join([attempt_system_unit_launcher_locus(instance: instance).base, "/installed-revision"], ""),
    join([attempt_unit_spool_root(instance_root: instance.instance_root as String), "/drain.lock"], ""),
  ]
}

// THE BELT'S EVENT UNITS (dogfood intervention #4). Each service is one `gunbc run` entry of
// gunbc.roadmap.roadmap_belt_tick_cli under the belt service's principal, slice and spawn root, so the two
// event services resolve the same instance the belt service does and start obligation units in the
// same user manager the belt's workers run in.
//
// THE EXIT PATH IS A LEVEL, NOT AN EDGE (extdeps.systemd.unit_file SystemdPathDirective): with
// DirectoryNotEmpty= systemd re-checks the inbox when the drain finishes, so an exit recorded while
// the drain was running starts it again instead of waiting for the next one. The drain moves every
// entry it hands off out of the inbox, so the inbox empties and the path goes quiet. `queued` is a
// second level on the same unit: it holds exits no run has CLAIMED (a run claims queued -> running
// before its first observation, so a long run does not keep the level up), so an exit that arrived
// while its attempt's unit was held, or that a lost unit or a reboot left behind, starts the drain
// again with no other event, and the drain's sweep hands it to a run.
//
// THE DRAIN SERVICE IS ALSO WANTED BY multi-user.target: starting once at boot is the reconciliation that
// returns a claim orphaned by a reboot (no stop hook ran) to `queued`. The path unit cannot do it -- the
// orphan sits in `running`, and DirectoryNotEmpty= on a directory a long run legitimately holds would
// re-trigger while the run lives and fail the path unit at its rate limit. A unit that ends while the
// manager is up is rescued by its own stop hook instead (belt_attempt_obligations_enqueue).
//
// THE PUBLICATION ANSWER PATH IS AN EDGE: answers are kept, not moved, so a level would fire forever.
// It starts the publication-answer drain, which enqueues that attempt's obligation directly. It
// does not start discovery. refused/ is the same edge for a quarantine: the helper left the pending
// set without an answer, and the drain re-enqueues PublishObligation.
fn live_deploy_belt_event_service_unit_file(spec: DeploymentSpec, description: String, function: String, gates: List<SystemdUnitDirective>, install: SystemdInstallSection) -> SystemdUnitFile {
  let svc = spec.service
  ServiceUnitFile {
    unit: concat([
      Description { text: description as NonEmptyStr },
      After { target: "network-online.target" as NonEmptyStr },
      Wants { target: "network-online.target" as NonEmptyStr },
    ], gates),
    service: concat([
      ServiceType { mode: OneshotMode },
      TimeoutStartSec { duration: systemd_time_span_of_seconds(d: belt_tick_run_bound) },
      ServiceUser { name: svc.service_user },
      ServiceGroup { name: svc.service_user },
      ServiceSlice { name: deployment_slice_unit_name(names: spec.names) },
      WorkingDirectory { path: svc.repo_root },
      Environment { assignment: join([
        belt_spawn_workdir_env_var as String, "=", svc.repo_root as String,
      ], "") as NonEmptyStr },
    ], concat(user_manager_environment_directives(uid: svc.service_uid), [
      ExecStart { command: join([
        fixed_serve_binary_path(binary: svc.serve_binary),
        " run --source-root dag --source-root src/v2",
        " --entry dag/gunbc/roadmap/roadmap_belt_tick_cli.dag --function ", function,
      ], "") as NonEmptyStr },
    ])),
    install: install,
  }
}

fn live_deploy_belt_exit_drain_service_unit_file(spec: DeploymentSpec) -> SystemdUnitFile {
  live_deploy_belt_event_service_unit_file(spec: spec, description: "gunbc roadmap belt exit drain (hands recorded unit exits to their attempt obligations)", function: "belt_exit_drain_cli", gates: [Condition { kind: ConditionDirectoryNotEmpty, negated: true, argument: attempt_exit_stalled_dir(instance_root: spec.service.instance_root as String) as NonEmptyStr }], install: Installable { directives: [WantedBy { target: deployment_belt_unit_install_target(names: spec.names) }] })
}

fn live_deploy_belt_discovery_service_unit_file(spec: DeploymentSpec) -> SystemdUnitFile {
  live_deploy_belt_event_service_unit_file(spec: spec, description: "gunbc roadmap belt publication-answer drain (enqueues the attempt's publish obligation)", function: "belt_publication_answer_drain_cli", gates: [], install: NotInstallable)
}

fn live_deploy_belt_credential_recovery_unit_file(spec: DeploymentSpec) -> SystemdUnitFile {
  live_deploy_belt_event_service_unit_file(
    spec: spec,
    description: "gunbc roadmap belt credential recovery (observes the recorded belt cgroup from its own unit)",
    function: "belt_credential_recovery_cli",
    gates: [],
    install: NotInstallable)
}

fn live_deploy_belt_credential_recovery_timer_unit_file(spec: DeploymentSpec) -> SystemdUnitFile {
  TimerUnitFile {
    unit: [Description { text: "gunbc roadmap belt credential recovery backstop (does not depend on the belt continuing to tick)" as NonEmptyStr }],
    timer: [
      TimerUnit { target: deployment_belt_credential_recovery_unit_name(names: spec.names) },
      OnBootSec { duration: systemd_time_span_of_seconds(d: belt_credential_recovery_backstop) },
      OnUnitInactiveSec { duration: systemd_time_span_of_seconds(d: belt_credential_recovery_backstop) },
      AccuracySec { duration: systemd_time_span_of_seconds(d: belt_tick_cadence) },
    ],
    install: Installable { directives: [WantedBy { target: "timers.target" as NonEmptyStr }] },
  }
}

fn live_deploy_belt_exit_path_unit_file(spec: DeploymentSpec) -> SystemdUnitFile {
  PathUnitFile {
    unit: [Description { text: "gunbc roadmap belt: a unit exit was recorded" as NonEmptyStr }],
    path: concat(
      concat(
        [PathUnit { target: deployment_belt_exit_drain_service_unit_name(names: spec.names) }],
        map(spool_role_dirs(kind: SpoolAttemptExit, instance_root: spec.service.instance_root as String, roles: spool_watched_roles(kind: SpoolAttemptExit)), d => DirectoryNotEmpty { path: d as NonEmptyStr }),
      ),
      [
        TriggerLimitIntervalSec { duration: systemd_time_span_of_seconds(d: belt_exit_trigger_limit_interval) },
        TriggerLimitBurst { count: to_string(value: belt_exit_trigger_limit_burst) as NonEmptyStr },
      ],
    ),
    install: Installable { directives: [WantedBy { target: "paths.target" as NonEmptyStr }] },
  }
}

fn live_deploy_belt_answer_path_unit_file(spec: DeploymentSpec) -> SystemdUnitFile {
  PathUnitFile {
    unit: [Description { text: "gunbc roadmap belt: a publication answer arrived" as NonEmptyStr }],
    path: concat(
      [
        PathUnit { target: deployment_belt_discovery_service_unit_name(names: spec.names) },
        PathChanged { path: publication_answer_dir(instance_root: spec.service.instance_root as String) as NonEmptyStr },
      ],
      map(spool_role_dirs(kind: SpoolPublication, instance_root: spec.service.instance_root as String, roles: [RoleRefused]), d => PathChanged { path: d as NonEmptyStr }),
    ),
    install: Installable { directives: [WantedBy { target: "paths.target" as NonEmptyStr }] },
  }
}

fn deployment_serve_source_root_flags_text() -> String {
  join(map(deployment_serve_source_roots, r => concat(" --source-root ", r)), "")
}

// THE DEPLOYED TREE'S REMOTE, CONVERGED BY ITS OWNER.
//
// `gunbc.fleet.origin_main_revision_observe` reads origin/main with `git ls-remote origin`, a network
// call through a CONFIGURED remote, and `tree_sync_git_whitelist_note` excludes .git/config from
// the sync because a blanket sync once carried a live Actions token into the service tree. Both are
// correct and neither was checked against the other, so the deploy produced a tree that could not
// answer an observation the belt makes every sixty seconds (srv1, measured 2026-08-18).
//
// WHY A UNIT AND NOT AN APPLY STEP: the tree is service-user-owned and the deploy principal is the
// unprivileged ci-runner, whose NOPASSWD roster (gunbc.fleet.fleet_posix_accounts
// fleet_posix_ci_runner_sudo_grants) contains no git, so
// `git config` from the apply is refused on one side and EACCES on the other. The same reasoning
// that produced gunbc-tree-sync.service produces this one -- the owner writes its own tree.
//
// WHY NOT A LEG ON THE TREE-SYNC UNIT, which already has the right principal: that unit is started
// inside the GunbcSourceTree step, and ServeBinary is installed in the step AFTER it, so the gunbc
// binary this invocation needs does not exist yet on a fresh instance. Ordering this member AFTER
// ServeBinary in deployment_owned_steps is what makes the binary a precondition the membership
// establishes -- concretely THIRD, before the belt event units that depend on the remote, not last
// (see deployment_tree_remote_unit_name's header for why last was wrong).
//
// The ExecStart names the tree explicitly rather than deriving it, because a host can run two slots
// and the unit of one slot must not converge the other's tree.
//
// IT IS A CONVERGENCE ONESHOT, SO ITS SLICE AND START BOUND ARE NOT ITS OWN: this member supplies the
// work and gunbc.live_deploy.repository_convergence_placement convergence_oneshot_unit_text places it.
// It used to name the deployment's serving slice with no start bound; the af66aa62 production apply on
// srv1 (2026-10-12) then waited behind it while the serving members held the slice over MemoryHigh.
fn tree_remote_convergence_oneshot(spec: DeploymentSpec) -> ConvergenceOneshot {
  let svc = spec.service
  ConvergenceOneshot {
    description: "gunbc deployed tree remote convergence (origin URL for fleet desired observation)" as NonEmptyStr,
    principal: svc.service_user,
    working_directory: svc.repo_root,
    environment_files: [] as List<NonEmptyStr>,
    exec_start: join([
      fixed_serve_binary_path(binary: svc.serve_binary),
      " run --source-root dag --source-root src/v2",
      " --entry dag/gunbc/deployed_tree_remote.dag --function ensure_deployed_tree_remote_wet",
      " --arg repository_path=", svc.repo_root as String,
    ], "") as NonEmptyStr,
  }
}

fn emit_tree_remote_unit_doc(spec: DeploymentSpec) -> Doc {
  doc_text(text: convergence_oneshot_unit_text(spec: spec, oneshot: tree_remote_convergence_oneshot(spec: spec)))
}

// apply/retract are the two degenerate POLES of the ONE grain-agnostic membership_reconcile
// (gunbc.membership_reconcile) — no bespoke fold. apply = reconcile(desired = all deploy members,
// observed = none) => every member Added => Upsert. retract = reconcile(desired = none, observed =
// the owned artifacts) => every member Removed => Teardown (all Owned, so no refusal). The
// DeploymentStep (key_of/key_eq/value_eq/ownership_of) bundle is this consumer's Realization of the
// spine — not a copy of it. ownership_of projects through deployment_step_ownership onto the single
// gunbc.ownership authority, so it is ALWAYS Present (a deploy member's ownership is known by
// construction); the OwnershipUnknown/MemberNotOwned refusal arms are the safety backstop for a
// future non-degenerate observed provider, exercised only by the synthetic spine witness. key_of
// returns stable member IDENTITY (artifact path / dependency package); value_eq never fires in the
// degenerate poles (no Modified — one side is always empty).
type DeploymentStepMemberAt = NonEmptyStr

fn deployment_step_key(step: DeploymentStep) -> NonEmptyStr {
  match step {
    ArtifactStep { step: art } => art.path
    Dependency { step: dep } => ensured_subject_identity(subject: dep.subject)
  }
}

fn deployment_step_key_eq(a: NonEmptyStr, b: NonEmptyStr) -> Bool { a == b }

fn deployment_step_value_eq(a: DeploymentStep, b: DeploymentStep) -> Bool { a == b }

fn deployment_step_ownership_opt(step: DeploymentStep) -> Ownership? {
  Present { value: deployment_step_ownership(step: step) }
}

// THE RELEASE-CONSUMING MEMBERS LEAVE THE APPLY-ALL ROSTER. Their desired/observed identities are
// decided in gunbc.live_deploy.member_identity and their mutations arrive as a ReleaseEffectPlan the
// caller derived by observing the host (gunbc.live_deploy.member_observe), so an already-converged
// host installs none of them. Every other owned artifact still reconciles against `observed: []`
// below -- the declared frontier, one member kind at a time, never a silent skip. Three deployment
// steps carry the five members: the unit step is where the unit file is written AND where the
// manager reloads and the process restarts, because those two members have no artifact of their own
// on the host and the deployment order already places the unit after the roots its process writes.
fn identity_member_of_step(step: DeploymentStep) -> ConvergedMember? {
  match step {
    ArtifactStep { step: art } => match art.kind {
      UpsertOwned { kind: uk } => match uk {
        GunbcSourceTree => Present { value: TreePublication }
        ServeBinary => Present { value: Executable }
        BeltEventPathUnit => none
        TailscaleServeMapping => none
        DeployedTreeRemoteUnit => none
        PublicationHelperPathUnit => none
        AttemptUnitDrainPathUnit => none
        ApprovalBrokerFrontDoor => none
      }
      ComposeOwned { kind: ck } => match ck {
        SystemdUnit => Present { value: UnitFile }
        OidcConfigArtifact => Present { value: OidcConfigFile }
        FleetConvergeTimerUnit => none
        FabricStorageServeUnit => none
        FabricStorageServeMapping => none
        TailnetDoorServeUnit => none
      }
    }
    Dependency { step: _ } => none
  }
}

// TWO QUESTIONS, NOT ONE, AND CONFLATING THEM SILENTLY DROPPED THE RUNTIME ROOTS.
//
// `identity_member_of_step` answers WHICH MEMBER a step is, and it has two consumers that need
// opposite things. deployment_apply_plan excludes a step from the membership reconcile when the
// step's commands come from emit_release_member_effects instead -- otherwise the step would be
// emitted twice. apply_step_effects asks the same function to decide whether the plan GATES the
// step. Those coincided while every identity member rendered its own commands.
//
// A directory root breaks the coincidence: its identity decides WHETHER it is installed, but the
// command still comes from the step's own upsert, because the attempt-state root installs a managed
// directory and the other owned roots an owned one. So a root must stay IN the reconcile and still
// be gated. Answering the exclusion question with "is it an identity member" removed the runtime
// roots from the reconcile, left no effect for their steps to match, and emitted nothing for them
// -- caught by two pre-existing witnesses, not by anything in the types.
fn step_renders_its_own_member_commands(step: DeploymentStep) -> Bool {
  match identity_member_of_step(step: step) {
    Absent => false
    Present { value: member } => match member {
      DirectoryRoot { path: _ } => false
      // WORKER-ROOT-EQUIVALENT-3: the two git-subtree members are NOT DeploymentSteps -- they ride the
      // roster and emit their own apply through the typed group in gunbc.live_deploy.apply_legs
      // (deploy_apply_git_worker_subtree_plan), so a step never carries them. False here is
      // total-and-unreached, not a behaviour.
      GitWorkerSubtree { path: _, child: _ } => false
      RepositorySharedPosture { path: _ } => false
      TreePublication => true
      Executable => true
      UnitFile => true
      UnitManager => true
      ServiceProcess => true
      OidcConfigFile => true
    }
  }
}

fn deployment_apply_plan(spec: DeploymentSpec) -> MembershipPlan<DeploymentStep, DeploymentStepMemberAt> {
  membership_plan_admitting_outcome(
    outcome: membership_reconcile(
      desired: filter(spec.steps, s => !step_renders_its_own_member_commands(step: s)),
      observed: [],
      key_of: deployment_step_key,
      key_eq: deployment_step_key_eq,
      value_eq: deployment_step_value_eq,
      ownership_of: deployment_step_ownership_opt,
    ),
  )
}

fn deployment_retract_plan(spec: DeploymentSpec) -> MembershipPlan<DeploymentStep, DeploymentStepMemberAt> {
  membership_plan_admitting_outcome(
    outcome: membership_reconcile(
      desired: [],
      observed: map(deployment_owned_steps_retract_order(spec: spec), s => ArtifactStep { step: s }),
      key_of: deployment_step_key,
      key_eq: deployment_step_key_eq,
      value_eq: deployment_step_value_eq,
      ownership_of: deployment_step_ownership_opt,
    ),
  )
}

// THE SAME PER-INSTANCE ONESHOT CHANGES REALIZATION AFTER ITS TWO INPUTS EXIST. GunbcSourceTree
// first installs the owner-run working-byte sync; ServeBinary then installs the admitted binary and
// replaces that unit document with Git-native convergence. There is no second unit name, lifecycle,
// or environment carrier to keep aligned, and no repository metadata is ever copied as files.
// Starting convergence before ServeBinary would execute the target's stale binary/corpus; leaving
// the rsync document installed would make the next deploy's first phase run convergence before its
// candidate binary exists. The two writes therefore bracket the binary install deliberately.
// ── THE REPOSITORY CONVERGENCE ONESHOT'S SLICE ──────────────────────────────────────────────
// The bounds and their derivation are gunbc.live_deploy.slice_bounds'; the admission that keeps the
// oneshot out of every serving slice is gunbc.live_deploy.repository_convergence_placement's. This is
// only the unit file, installed immediately before the convergence unit in both arms that install
// that unit and ahead of the daemon-reload those arms already run, so the slice the oneshot names
// exists with its bound before systemd starts it. A Slice= naming a missing slice file does not fail:
// systemd creates the slice with NO bound, which is the outcome this change must not produce silently.
fn repository_convergence_slice_unit_file() -> SystemdUnitFile {
  SliceUnitFile {
    unit: [
      Description { text: "gunbc repository convergence cgroup bound (separate from every serving slice)" as NonEmptyStr },
    ],
    slice: [
      slice_memory_max(bytes: repository_convergence_slice_memory_max),
      slice_memory_high(bytes: repository_convergence_slice_memory_high),
      slice_memory_swap_max(bytes: repository_convergence_slice_memory_swap_max),
    ],
    install: NotInstallable,
  }
}

fn emit_repository_convergence_slice_unit_doc() -> Doc {
  doc_text(text: serialize_systemd_unit_file(file: repository_convergence_slice_unit_file()))
}

type UserWorkSliceUnitFile
  = UserWorkSliceUnitFileReady { file: SystemdUnitFile }
  | UserWorkSliceUnitFileRefused { cause: String }

fn user_work_slice_unit_file() -> UserWorkSliceUnitFile {
  match user_work_pool_slots() {
    UserWorkPoolSlotsDerived { slots } => {
      let max = user_work_slice_memory_max_of(slots: slots)
      match user_work_slice_memory_high_of(memory_max: max) {
        UserWorkSliceHighGapExceedsMax =>
          UserWorkSliceUnitFileRefused {
            cause: "user-work MemoryMax is below the declared High gap, so MemoryHigh cannot be derived",
          }
        UserWorkSliceHighDerived { bytes: high } =>
          UserWorkSliceUnitFileReady {
            file: SliceUnitFile {
              unit: [
                Description { text: "gunbc user-manager cgroup bound for --user transients (attempts, reviews, audit, supervisor, compute, gunbc test/run scopes)" as NonEmptyStr },
              ],
              slice: [
                slice_memory_max(bytes: max),
                slice_memory_high(bytes: high),
                slice_memory_swap_max(bytes: user_work_slice_memory_swap_max),
              ],
              install: NotInstallable,
            },
          }
      }
    }
  }
}

type AttemptWorkerSliceUnitFile
  = AttemptWorkerSliceUnitFileReady { file: SystemdUnitFile }
  | AttemptWorkerSliceUnitFileRefused { cause: String }

fn attempt_worker_slice_unit_file() -> AttemptWorkerSliceUnitFile {
  match attempt_worker_slice_memory_high() {
    UserWorkSliceHighGapExceedsMax =>
      AttemptWorkerSliceUnitFileRefused {
        cause: "attempt-worker MemoryMax is below the declared High gap, so MemoryHigh cannot be derived",
      }
    UserWorkSliceHighDerived { bytes: high } =>
      AttemptWorkerSliceUnitFileReady {
        file: SliceUnitFile {
          unit: [
            Description { text: "gunbc system-manager cgroup bound for attempt worker transients" as NonEmptyStr },
          ],
          slice: [
            slice_memory_max(bytes: attempt_worker_slice_memory_max),
            slice_memory_high(bytes: high),
            slice_memory_swap_max(bytes: live_deploy_slice_memory_swap_max),
          ],
          install: NotInstallable,
        },
      }
  }
}

// gunbc-tree-sync.service (#7011 realization) failed its control process on every srv1 deploy since
// landing (receipt 29928424523 and its predecessor 29926422286), and the bare 'sudo -n systemctl
// restart' stderr — 'Job for gunbc-tree-sync.service failed because the control process exited with
// error code' — never carries WHY: the actual ExecStart failure (the rsync exit) lives only in the
// unit's own journal, unreachable from this refusal (DESIGN 5 — a stopped, typed, but unlocated
// line, the same gap #7038 closed for gunbc-roadmap.service's async ServiceNotReady). This restart
// is SYNCHRONOUS, ahead of that poll-based unit_diagnosis capture entirely (GunbcSourceTree upsert
// runs before the SystemdUnit member), so it needs its own capture rather than waiting on one that
// never runs. Reuses the single unit-status-tail authority (live_deploy_unit_status_tail_command,
// gunbc.live_deploy.intent) the roadmap-unit capture already owns — no second diagnosis format. On
// failure the tail is appended to stderr and the step still fails (exit 1): a diagnosis, never an
// escape hatch (DESIGN 5 forbids proceeding as if the refusal had not fired).
fn tree_sync_restart_step_with_diagnosis(spec: DeploymentSpec) -> PipelineStep {
  deploy_raw(command: join([
    deploy_effect_command(inv: systemctl_restart_effect(unit: spec.names.tree_sync_unit_name)),
    " || { echo '--- gunbc-tree-sync.service control-process diagnosis ---' >&2; ",
    live_deploy_unit_status_tail_command(unit: spec.names.tree_sync_unit_name),
    " >&2; exit 1; }",
  ], ""))
}

// THE IDEMPOTENCE GUARD IS DELETED, AND ITS REMOVAL IS THE POINT. The apply used to wrap the serve
// command in `if ! tailscale serve status | grep -q ':<port>'`, which is a pseudo-observation twice
// over: it greps unstructured status text for a port number that appears nowhere in the
// configuration key, and a mapping for a DIFFERENT deployment on the same port would satisfy it —
// so the guard skipped precisely when another deployment held the endpoint, which is the collision
// it looked like it was preventing.\n\nThere is nothing to guard. Configuring an endpoint to a
// backend it already has is a no-op at the upstream, because the endpoint IS the key; issuing it
// twice cannot produce a second mapping. So the correct number of observations here is zero, and
// the replacement for a wrong observation is not a better observation but no observation at
// all.\n\nThe argv is built by extdeps.tailscale.serve rather than concatenated here, so the apply
// and the teardown cannot disagree about the flags — which is the property the upstream `off` form
// actually requires.
fn tailscale_serve_apply_step(spec: DeploymentSpec) -> PipelineStep {
  deploy_raw(command: shell_privileged_command_text_of_argv(
    argv: concat(["tailscale"], tailscale_serve_enable_argv(endpoint: spec.names.tailscale_serve_endpoint)),
  ))
}

// THE BINARY PATH BECAME A PARAMETER AND ITS PARENT DIRECTORY DID NOT (review 45197). This PR
// derives serve_binary from the instance root, so a twin installs to its own tree — but the step
// that CREATES the destination directory still read `sudo -n install -d -m 0755 /opt/gunbc/bin`,
// production's literal. `install` does not create missing parents, so a twin apply reaches the copy
// with no `<instance-root>/bin` to copy into and fails on a path that looks like a permissions
// problem.
//
// That is the same half-parameterization the placement de-fork exists to remove, surviving one
// level down: the value moved to the argument and the directory that has to exist for the value to
// be writable stayed behind. Nothing caught it because production's parent and the literal agree,
// which is exactly the condition that made every srv1-only gap in this lane invisible until a
// second instance existed.
//
// Deriving the parent FROM the path being installed is what keeps them from drifting again — there
// is no second literal to update, and the emitted command for srv1-live is byte-identical because
// the derivation of /opt/gunbc/bin/gunbc is /opt/gunbc/bin. The mode and ownership are deliberately
// unchanged: production's bin directory is root-owned, and switching this to the service-user-owned
// install_d_owned_command would silently re-own a live directory to satisfy a twin.

fn path_parent_dir(path: String) -> String {
  match list_tail(xs: reverse(split(s: path, delimiter: "/"))) {
    Absent => "/"
    Present { value: rest } => join(reverse(rest), "/")
  }
}
// THE 0755 IS A SHARED CONSTANT, NOT A DERIVED FACT, and every member still on it inherits it
// regardless of what that member's readers and writers actually need. That is why
// /opt/gunbc/attempt-state converges world-readable while the per-attempt directories the belt
// creates under it are owner-only, or group-traversable for a dedicated worker account
// (attempt_state_prepare_argvs_for_instance) — the leaf states its
// requirement, the root cannot, so the root is loose by default rather than by decision. Ownership
// is already derived (-o/-g project the service user from the spec, install_d_owned_command); the
// mode is the one field on the triple still hand-picked.
//
// THE FIX IS NOT A TIGHTER LITERAL — replacing 0755 with 0700 would move the same undeclared
// number, and a member whose dependents genuinely need traversal would then break with no statement
// of why. The mode must be DERIVED FROM THE MEMBER'S DECLARED DEPENDENTS: which principals need
// which verbs on that position, folded into extdeps.access.posix.FilePermissions (PermissionBits
// per owner/group/other class, cited to Open Group sys/stat.h) — the same requirement rows
// std.effect_grant already carries as (verb x subtree x principal) for the execute direction, read
// here to construct the permission instead of to admit against it. Once a member carries its
// dependents, an over-permissive mode is unwritable rather than merely unreviewed, and this helper
// loses its mode argument entirely (operator direction 2026-07-30: precise, and derived from the
// needs/dependents).
//
// The retirement itself is carried by install_d_mode_derivation_dissolution below rather than by
// this paragraph. How far the migration has got is deliberately NOT written here either: a count
// copied out of the current tree is an oracle for nothing, and it goes stale in the one direction
// nobody notices.

// The three mode literals this module installs with, named once each. They were previously
// spelled inline at ten call sites, which is what let the shared 0755 look like ten independent
// decisions rather than one constant inherited ten times. Naming
// them changes no emitted byte and does not derive them — that derivation is exactly what the
// paragraph above says is still owed — but it makes the inheritance visible to the reader and gives
// the eventual derivation one place to land per class.
data install_d_shared_mode: FileMode = declared_directory_mode(m: DirectoryOwnerAllEveryoneTraverse)

data install_file_shared_mode: NonEmptyStr = "0644"

data install_file_owner_only_mode: NonEmptyStr = "0600"

data install_executable_shared_mode: NonEmptyStr = "0755"

// THE MODE DEBT ENDS WHEN THE SHARED CONSTANT DOES. A member carrying FilePermissions derived from
// its declared dependents has no use for a hand-picked 0755 to inherit, so install_d_shared_mode
// going away IS the discharge — which makes the trigger a retirement over a declaration that
// exists today rather than a forward reference to a carrier nobody has written.
data install_d_mode_derivation_dissolution: DissolutionCondition = retires_dissolution(
  ref: DeclarationRef {
    module_path: "gunbc.live_deploy.emit",
    decl_name: "install_d_shared_mode",
    field: WholeDeclaration,
  }
)

fn install_d_owned_for_user(user: NonEmptyStr, path: String) -> String {
  install_directory_owned_command(
    mode: install_d_shared_mode,
    owner: user,
    group: user,
    path: path,
  )
}

// WHY THIS INSTALLS WITH -o/-g RATHER THAN WRITING AS ROOT AND FIXING UP, and the history is the
// irreducible part. The principal itself is not stated here: gunbc.fleet.fleet_posix_accounts owns it —
// FleetAccountCiRunner is the deploy principal (unit_user=root is NOT the authorization principal)
// and fleet_posix_ci_runner_sudo_grants() enumerates its NOPASSWD roster. Reading it from there is
// the point of this paragraph; an earlier revision spelled the roster and its size inline and went
// stale twice.
//
// AN EARLIER NOTE HERE CLAIMED ROOT, on the strength of a hand ssh verification (parent lane,
// 2026-07-20) that CONTRADICTED the repo's own single authority (fleet_posix_accounts, probed
// 2026-07-02). That is a §3 fork of the principal fact, and reality sided with the authority: the
// first flip deploy (run 29822498755, 2026-07-21) died on bare-rsync EACCES and chgrp EPERM into
// the service-user-owned tree. So the corrected realization stays INSIDE the granted set, and each
// arm is shaped by which grant it has rather than by what would be convenient: directories and the
// binary install with -o/-g service-user through the granted install, which puts ownership at
// CREATION and dissolves the root-writes-then-chown two-step — the wrongly-owned intermediate state
// is unwritable rather than merely repaired; the tree sync runs AS the service user through a
// oneshot unit, because the owner writing its own tree is what install+systemctl compose into when
// no `sudo -u` form is granted; teardown rm goes through the granted rm.
//
// RESIDUE, NAMED: emit-construction refusal of bare rsync/chown outside the granted set is not
// built here and rides the effect-namespace-grants lane. And the former
// install_d_shared_setup_latent_coupling marker fired as designed — /opt/gunbc now has MULTIPLE
// owned writers, so the shared-prefix `install -d /opt/gunbc` rides the FIRST owned writer in apply
// order (GunbcSourceTree) once, and each deeper parent (/opt/gunbc/bin) rides its own writer.
fn install_d_owned_command(spec: DeploymentSpec, path: String) -> String {
  install_d_owned_for_user(user: spec.service.service_user, path: path)
}

fn owned_directory_will_install(spec: DeploymentSpec, plan: ReleaseEffectPlan, t: OwnedDirectoryTarget) -> Bool {
  match plan_mutation_of(plan: plan, member: DirectoryRoot { path: owned_directory_path(t: t) as String as NonEmptyStr }) {
    MemberNotInPlan => true
    MutationInPlan { mutation } => !mutation_is_keep(e: mutation)
  }
}

// GunbcSourceTree stages working bytes with rsync --delete while excluding .git, then the
// ServeBinary step replaces the owner-run oneshot with Git-native repository convergence.
// Repository metadata is never transported as files: git imports the candidate objects from the
// runner checkout, compare-and-swaps the base ref, resets the index/worktree, and the deploy reads
// back its receipt before continuing. Target-local worktree registrations, session refs and
// unrelated refs are preserved by the convergence adjudication rather than by an additive file
// copy. Flags are -rlpt, not -a: the sync principal is the service user
// (gunbc.fleet.fleet_posix_accounts FleetAccountCiRunner is the deploy principal, not the tree's owner),
// so -a's owner/group replication would chgrp toward the runner's
// group and fail EPERM — ownership is the destination principal's by construction, never replicated
// from the source.

// ── THE BROKER'S TREE, COPIED FROM THE CANDIDATE ────────────────────────────────────────────
// STAGE A INSTALLED A UNIT WITH NO TREE BEHIND IT. WorkingDirectory pointed at the roadmap's
// deployed tree, which is frozen at a release predating this module, so `gunbc serve --entry
// dag/gunbc/auth/approval_broker_serve.dag` could not resolve its own entry and systemd
// restart-looped the unit. The unit was correct; the bytes it was pointed at were not there.
//
// SCOPED DELIBERATELY NARROW (operator ruling 2026-09-20: "do not generalize it into a second
// tree-sync"). This is not a sync: no unit, no timer, no reconciliation, no drift detection. It is
// two source directories and one binary copied once, at install, from the checkout the dark install
// is running in -- the same $PWD the existing tree-publication step already names as GUNBC_TREE_SRC.
// What the broker needs to serve four routes is the .dag corpus, the v2 sources its closure reaches,
// and a binary that can interpret them.
//
// THE BINARY IS COPIED INTO A PER-CANDIDATE RELEASE LOCUS, AND THE PREVIOUS TWO NOTES HERE WERE
// BOTH WRONG IN OPPOSITE DIRECTIONS. The first asserted a copy the diff did not contain; the second
// corrected it to "shared, and that is a real open hazard" and left the hazard standing. The hazard
// was real: ExecStart took spec.approval_broker.serve_binary -- the instance's /opt/gunbc/bin/gunbc,
// which is the ROADMAP's binary, frozen at its release by operator ruling. A seed binary older than
// the sources it is handed refuses to parse constructs those sources use, and the broker's modules
// are newer than that binary by construction, so the unit would have started, refused at parse and
// restart-looped: the same symptom as the missing tree, from the other half of the pair.
//
// THE CANDIDATE BINARY WAS ALREADY ON THE HOST AND NOTHING WAS POINTING AT IT (operator ruling
// 2026-09-20). The dark-install job carries its OWN download and verify steps -- gunbc.ci.ci_spec
// ci_release_bins_download_step and ci_release_bins_unpack_verify_step, listed by
// gunbc.fleet.fleet_converge_workflow fleet_converge_approval_broker_dark_install_job immediately before
// the install step -- so release-bins.tgz is unpacked into $ROOT/target/release and every member is
// put through claim_executor --verify-build-artifacts in this job, not inherited from some earlier
// one. That is what makes the copy source a verified artifact rather than a file that happens to be
// on disk: the verification and the copy are two steps of one job, and a failed verify stops the
// job before the install step runs.
//
// THE COPY IS LOCAL, AND THAT IS A PROPERTY OF THE TRANSPORT RATHER THAN A HOPE. The job runs on a
// self-hosted runner labelled with the dispatch's own host input, and the DeployAccess the gated
// dispatch hands this emitter binds LocalShell (gunbc.ci.ci_deploy_access ci_deploy_srv1_access for the
// CI entry, ci_deploy_srv1_operator_local_access for the operator-local one) -- so the script executes ON the target host,
// and "$PWD" is that job's checkout. The same fact is what makes the rsync above work; the binary
// copy is not reaching any further than the tree copy already does. Were the transport ever remote,
// both would break together and loudly, rather than this one silently copying a file that is not
// there.
// The copy source is that artifact; gunbc.ci.ci_release_bins gunbc_release_bin_name is the row both
// the pack verification and this copy read, so the two spellings cannot drift.
//
// THE LOCUS IS PER-CANDIDATE AND IMMUTABLE, which is what makes the readback mean anything. Under a
// single mutable root, "the tree is the candidate" is a claim about what the last rsync did, and a
// redeploy of an older revision overwrites the evidence of the newer one in place. Under
// releases/<sha>/ the installed digest, the binary and the sources are one directory that either
// exists for this sha or does not, ExecStart names that directory, and /livez reporting the sha is
// a statement about a locus a reader can go and hash. Requested-equals-installed becomes decidable
// rather than asserted.
//
// WHAT THIS DELIBERATELY DOES NOT ADD: retention, garbage collection, a `current` symlink, or any
// reconciliation between release directories. Each is a real obligation and none is needed to
// observe one dark install; inventing a release-manager here would be the second tree-sync the
// operator ruled out, arriving under a different name. The unbounded growth is named rather than
// papered over -- see approval_broker_release_retention_note.
//
// UNBOUND REVISIONS REFUSE RATHER THAN NAMING A PATH. RevisionNotInstalled has no sha, so there is
// no directory it could mean; the path folds emit a poison marker that is not a valid path, which
// fails the stage loudly instead of installing a release into a directory literally named after a
// diagnostic (DESIGN section 5: refuse, never widen).
data approval_broker_release_retention_note: String = "The broker's release locus grows one directory per deployed candidate and nothing prunes it. Each holds the .dag corpus, the v2 sources and a gunbc binary. This is ACCEPTED for the cutover and is not a background obligation to be discovered later: retention is a policy question (how many releases must stay rollback-able, and against what) that has no answer until the broker has a rollback story, which it does not have while it is being stood up dark. It is bounded in practice by the number of dark installs the cutover performs. DISSOLVES WHEN the broker has a declared rollback target: at that point the number of releases that must survive is derivable from it, and a prune step belongs beside the install step reading that number -- never a timer reconciling the directory against a guess."

// EVERY UNIT THAT EXECS A gunbc BINARY FROM A RELEASE LOCUS SETS THE CHECKOUT ROOT AT SPAWN
// (gunbc.cli_run_workspace_root_scaffold gunbc_workspace_root_env_name): the seed refuses to run
// from a directory that is not a git checkout, and a locus is not one -- measured on srv1
// 2026-09-21, where both the broker's serve unit and the microVM slot unit exited 101 in
// workspace_root before any stage ran. One row feeds both units.
// THE BROKER IS GIVEN ITS PUBLIC BASE URL, built from the holder token the spec carries
// (gunbc.auth.approval_broker_placement approval_broker_base_url_of_holder), so the serving broker
// reads where it runs instead of resolving it. A spec holding no role never reaches a broker unit
// write (apply_approval_broker_unit_write_steps is empty for it); if one is rendered anyway the
// binding is a refusal marker the broker's address read rejects as a non-URL, never a guessed host.
data approval_broker_base_url_unbound_marker: String = "__GUNBC_DEPLOY_REFUSED__no-prod-role-holder"

fn approval_broker_base_url_environment(spec: DeploymentSpec) -> SystemdServiceDirective {
  let value = match spec.role_singletons {
    HoldsProdRoleSingletons { holder } => approval_broker_base_url_of_holder(holder: holder) as String
    HoldsNoRoleSingleton => approval_broker_base_url_unbound_marker
  }
  Environment { assignment: join([approval_broker_base_url_env_name as String, "=", value], "") as NonEmptyStr }
}

fn release_locus_workspace_root_environment(release_dir: String) -> SystemdServiceDirective {
  installed_release_environment(release_dir: release_dir)
}

// ── THE microVM SLOT CONTROLLER'S RELEASE LOCUS AND UNIT ──────────────────────────────────────
//
// THE SAME LOCUS, OWNED BY root, PLUS THE VMM AND THE JAILER. gunbc.runner.runner_microvm_slot_unit owns
// the root, the owner and the unit's shape; this module owns the install because the locus is the
// live_deploy one. The two binaries the controller execs beside gunbc -- Firecracker and its jailer
// -- are installed INTO the locus from the upstream release tarball, digest-verified against
// extdeps.virtualization.firecracker's cited sha256 before extraction, as root-owned 0755 files.
// They were previously installed under the job user's HOME by gunbc.runner.runner_microvm_host_ready
// (firecracker only; the jailer was never copied out of the archive), which is a job-user-writable
// binary that a root controller would exec -- the same class the slot-network frontier names for
// staged sources -- so the controller reads them from here and from nowhere else.
//
// THE RECEIPT NAMES BOTH DIGESTS beside the tree digest, so requested-equals-installed is decidable
// for the VMM as it is for the sources: a locus whose firecracker hashes differently from the
// cited release is not the release, whatever `--version` prints.
fn microvm_controller_release_dir(revision: ReleaseRevisionBinding) -> String {
  release_locus_dir(root: microvm_controller_root, revision: revision)
}

// THE TARBALL IS STAGED UNDER THE JOB'S OWN CHECKOUT, beside the verified release bins it copies
// from, because the fetch and the extraction run as the job user and the locus is root's: the only
// privileged steps are the two installs into the locus, exactly as the gunbc binary's install is.
// The directory is named RELATIVE to the checkout root and carries no variable; the install plan
// resolves it against the checkout root it is given (gunbc.host.host_effect_realize
// microvm_controller_install_staging), because its elevated legs run as another principal whose
// working directory is not the checkout.
data microvm_controller_stage_dir: String = "target/microvm-controller-stage"

fn microvm_controller_stage_tarball_path(stage: String) -> String {
  join([stage, "/", firecracker_release_tarball_filename(rel: microvm_controller_firecracker_release)], "")
}

fn microvm_controller_vmm_receipt_path(revision: ReleaseRevisionBinding) -> String {
  join([microvm_controller_release_dir(revision: revision), "/.gunbc-vmm-receipt"], "")
}

// THE SLOT UNIT IS RENDERED HERE WITH THE SPAWN ROOT ADDED, because the env row and the locus
// belong to this module while the unit's shape belongs to gunbc.runner.runner_microvm_slot_unit: the
// service section is that module's list plus one directive, inserted rather than re-authored.
// EVERY UNIT THAT RUNS `gunbc run` FROM THE LOCUS NEEDS THE SAME ROW, so the insertion is one function
// over any such unit: the slot controller and the shakedown broker both exec from this locus.
fn microvm_locus_unit_with_workspace_root(file: SystemdUnitFile, release_dir: String) -> SystemdUnitFile {
  installed_release_unit(file: file, release_dir: release_dir)
}

fn microvm_slot_unit_file_with_workspace_root(release_dir: String) -> SystemdUnitFile {
  microvm_locus_unit_with_workspace_root(
    file: microvm_slot_unit_file(release_dir: release_dir, timeout_stop_sec: microvm_slot_unit_timeout_stop_sec()),
    release_dir: release_dir,
  )
}

// The mode of a root-owned sudoers grant file (visudo's required 0440).
data helper_sudoers_grant_mode: NonEmptyStr = "0440"

// ── THE ROOT-OWNED SNAPSHOT ──────────────────────────────────────────────────────────────────
// Every path from / down to the snapshot base, so the readback covers the ancestors too.
fn path_ancestors_inclusive(path: String) -> List<String> {
  fold(split(s: path, delimiter: "/"), init: ["/"], f: (acc, seg) =>
    if seg == "" {
      acc
    } else {
      match acc |> last {
        Present { value: prev } => concat(acc, [if prev == "/" { concat("/", seg) } else { join([prev, "/", seg], "") }])
        Absent => acc
      }
    })
}

// THE READBACK THAT MAKES "A SOURCE BYTE REPLACED AFTER INSTALL" IMPOSSIBLE RATHER THAN UNLIKELY.
// It fails the stage if any entry in the snapshot, or any ancestor of it, is not root-owned, is
// group- or world-writable, or is a symlink. Owned by root and writable only by root means the
// grantee cannot change a byte the grant executes.
//
// THREE OUTCOMES, AND ONLY ONE OF THEM PASSES: the observation failed (a path missing, unreadable,
// or an I/O error), it found a violation, or it is clean. Each find is captured into its OWN
// assignment. The status of `v="$(cmd)"` is cmd's status, so bash's -e stops the stage on a find that
// failed. A find nested inside `test -z "$(...)"` would lose its status to test's, and a failed
// observation prints nothing, so it would read as clean (side-chat HOLD on f8beaa6f63). A negated
// pipeline is no better: -e ignores a command whose status is inverted with `!`. Only after both
// observations succeed does test decide between violation and clean. That is the same fail-fast
// assignment shape systemctl_load_state_assignment_intent uses, built from the same grammar rows, so
// none of it is shell assembled as a string.
//
// The ancestors are checked for being a symlink explicitly (-type l), not only through their
// permission bits. find's default -P does not follow a starting point, so a symlinked ancestor is
// seen as a link. The finds run BARE, as the deploy principal: every directory they read is
// root-owned 0755, and an entry they cannot read is an observation failure, which stops the stage.
//
// The owner is a WORD, so the same statements can be executed against a scratch tree owned by
// whoever runs the check (test.claim.live_deploy.approval_broker_helper_readback_real_execution
// passes `$(id -un)`). Production passes the literal root.
fn helper_snapshot_find_intent(roots: List<String>, top_only: Bool, owner: Node) -> Node {
  bash_build_command_with_words(words: concat(
    concat(
      [bash_build_word_lit(text: find_program().invocation as String)],
      map(roots, r => bash_build_word_lit(text: r)),
    ),
    concat(
      if top_only { [bash_build_word_lit(text: "-maxdepth"), bash_build_word_lit(text: "0")] } else { [] },
      [
        bash_build_word_lit(text: "("), bash_build_word_lit(text: "!"), bash_build_word_lit(text: "-user"), owner,
        bash_build_word_lit(text: "-o"), bash_build_word_lit(text: "-perm"), bash_build_word_lit(text: "/022"),
        bash_build_word_lit(text: "-o"), bash_build_word_lit(text: "-type"), bash_build_word_lit(text: "l"),
        bash_build_word_lit(text: ")"), bash_build_word_lit(text: "-print"),
      ],
    ),
  ))
}

data helper_snapshot_ancestors_var: String = "_gunbc_helper_ancestors"
data helper_snapshot_entries_var: String = "_gunbc_helper_snapshot"

fn helper_snapshot_readback_intents(ancestors: List<String>, dir: String, owner: Node) -> List<Node> {
  [
    bash_build_assign(
      name: helper_snapshot_ancestors_var,
      value: bash_build_word_cmdsubst(body: helper_snapshot_find_intent(roots: ancestors, top_only: true, owner: owner)),
    ),
    bash_build_assign(
      name: helper_snapshot_entries_var,
      value: bash_build_word_cmdsubst(body: helper_snapshot_find_intent(roots: [dir], top_only: false, owner: owner)),
    ),
    bash_build_command_with_words(words: [
      bash_build_word_lit(text: "test"),
      bash_build_word_lit(text: "-z"),
      bash_build_word_concat_from_nodes(parts: [
        bash_build_word_var(name: helper_snapshot_ancestors_var),
        bash_build_word_var(name: helper_snapshot_entries_var),
      ]),
    ]),
  ]
}

data helper_snapshot_readback_emit_refused_poison: String = "__GUNBC_ORCH_EMIT_REFUSED__ approval-broker helper snapshot readback: the bash grammar refused a statement; this marker is not valid shell, so the stage fails before any grant is written (DESIGN section 5: refuse, never widen)"

fn helper_snapshot_intent_text(intent: Node) -> String {
  match bash_fold_serialize_node(stmt: intent) {
    Accepted { value: source, diagnostics: d } =>
      match d {
        None => source
        Some { diagnostics: _ } => helper_snapshot_readback_emit_refused_poison
      }
    Rejected { diagnostics: _ } => helper_snapshot_readback_emit_refused_poison
  }
}

// ONE STATEMENT PER LINE, each serialized by the grammar. A statement the grammar refuses renders as
// the poison, which fails the stage.
fn helper_snapshot_readback_command_at(ancestors: List<String>, dir: String, owner: Node) -> String {
  join(map(helper_snapshot_readback_intents(ancestors: ancestors, dir: dir, owner: owner), n => helper_snapshot_intent_text(intent: n)), "\n")
}

// The deploying checkout's build, the one source the install copies from; the same path the planner
// digests (gunbc.live_deploy.member_observe release_executable_source_path) so the verification
// line above and the planned identity name one file.
data release_executable_install_source: String = concat(cargo_default_release_dir_rel, "/gunbc")

// REALIZATION FOR THE BUILD SERVICE'S ARTIFACT STORE, which is an ENSURED host directory rather
// than an owned artifact, and the difference is the whole safety content. Ensured means converged
// on every apply and never torn down; owned means removed by retract. Produced artifacts are
// precisely what a deploy must never delete, so the owned category was wrong -- and it was not
// wrong in the abstract: with the root on every per-instance spec, a lab twin's retract would have
// removed the production store, which is what the twin disjointness claims caught.\n\nTHE DEPLOY
// ENSURES THE DIRECTORY; THE SERVICE MAKES IT A REPOSITORY. That split is forced rather than
// chosen. The deploy principal's sudo roster grants exactly six commands -- apt-get, install,
// visudo, systemctl, tailscale, rm -- and git is not among them, so a `sudo -n -u <service> git
// init --bare` step would be refused by sudoers and would red every deploy of this host. An earlier
// revision emitted precisely that line. `install -d` is granted and idempotent, so the deploy
// converges ownership and existence; `git init --bare` is idempotent by upstream contract and runs
// as the account that owns the directory, so no privilege boundary is crossed and no grant needs
// widening.\n\nTHERE IS NO TEARDOWN ARM, and its absence is the point rather than an omission. An
// ensured resource reaches EffectRemove only through the R5 wall breach poison, so a retract cannot
// remove this store even by mistake -- the property the previous `rm -d` arm tried to approximate
// by refusing on a non-empty directory is now structural, and the awkward consequence that arm
// carried (a full retract could never complete once the store existed) simply does not arise.
// The dispatch worktree root's refusal is rm -d (empty-directory removal via the granted rm — the
// unprivileged principal has no rmdir grant and no write on the root-owned parent), NEVER rm -rf: a
// non-empty worktree root means live agent worktrees exist, so the retract FAILS LOUDLY there
// instead of silently destroying sessions (DESIGN 5 — the refusal is the empty-dir precondition
// itself, identical to the former rmdir). GunbcSourceTree teardown runs its rm -rf only AFTER that rm -d
// succeeds, so the repo the worktrees are registered in is never deleted from under them.

// THE TRAP LINE IS STILL A STRING, AND IT IS THE ONLY REMAINING ONE IN EITHER PREAMBLE.
// v2.extdeps.languages.bash_build has no trap node and PipelineStep has no trap variant, so
// there is nothing to build it from. It is left as authored text rather than approximated:
// every nearby shape (a Do-run of `trap`, a subshell) either re-assembles the same quoting by
// hand or changes what the trap does. Adding the grammar row is the fix and it is out of this
// PR's scope; naming the gap here is what keeps the next reader from reaching for the
// approximation. See also the brace-group gap at tree_sync_restart_step_with_diagnosis.
fn member_effect_step(e: MemberEffect<DeploymentStep>) -> DeploymentStep {
  match e {
    EffectAdd { to } => to
    EffectReplace { from: _, to } => to
    EffectRemove { from } => from
  }
}

fn spec_has_artifact_kind(spec: DeploymentSpec, kind: OwnedArtifactKind) -> Bool {
  any(spec.steps, st => match st {
    ArtifactStep { step: art } => art.kind == kind
    Dependency { step: _ } => false
  })
}

// The additive broker install (stage 1 of the cutover) is typed in gunbc.host.host_effect_realize
// approval_broker_dark_install; its script, intent and poison markers are deleted. The shared
// emitters below (release_locus_install_steps, approval_broker_helper_grant_fragments,
// apply_approval_broker_unit_write_steps, approval_broker_lifecycle_steps, the slice-control
// converge fragments) stay while the ordinary apply path consumes them.

fn live_deploy_systemd_unit_for(spec: DeploymentSpec, revision: ReleaseRevisionBinding, now_epoch: Second?) -> String {
  render(doc: emit_systemd_unit_doc(spec: spec, revision: revision, now_epoch: now_epoch), proto: live_deploy_protocol)
}

// THE SERVE ROUTE BUILDER BELOW IS THE PATTERN this site's ensure-dependency route followed when
// it dissolved (#13988). Its companion, `deployment_ensure_dependency_script`, is gone: the
// ensure-dependency route now runs its probe/install and write/install trees as typed effects at
// the site in gunbc.host.host_effect_realize (realize_live_deploy_ensure_dependency_on_host), so
// no script of its is rendered here any more. What remains in this module is the PIPELINE the
// bulk-apply frame still embeds (ensure_dependency_steps, used by the bulk apply plan's
// mutate_steps) -- that route composes steps inside a larger pipeline the frame itself renders,
// which is a different consumer with a different owner (the retained bulk-apply script), not this
// site's.

// ONE SERVE ROUTE, WRITTEN OR TURNED OFF, as a typed command of its own: the same privileged argv the
// mapping member's apply and teardown steps carry, for the tailnet door cutover
// (gunbc.live_deploy.tailnet_door_cutover), which applies the re-point and its restore singly.
//
// THE CARRIER CHANGED, THE WIRE DID NOT. The old builder folded the words into a bash script body
// (shell_privileged_command_text_of_argv -> RetainedShellScript) and let the Bash emitter run it
// (retained_srvn / realize_shell_on_host). That body was a single privileged command with no env,
// no cwd, no redirect and no pipe (deploy_raw: env Empty, redirect Absent), so the shell added
// nothing the words did not already say. This typed builder keeps the identical privileged wire
// (sudo_elevate -> /usr/bin/sudo -n tailscale <serve argv>) as an ArgvCommand and runs it through
// the typed transport (shell.Exec.RunArgv / typed ssh), so no quoting layer stands between the
// words and the exec. No policy literal is minted here: the elevation, the program path and the
// -n flag all come from extdeps.sudo.elevation, and the serve flags from extdeps.tailscale.serve.
fn deployment_serve_route_command(endpoint: TailscaleServeEndpoint, enabled: Bool) -> ArgvCommand {
  sudo_elevate_command(
    command: concat(["tailscale"], if enabled { tailscale_serve_enable_argv(endpoint: endpoint) } else { tailscale_serve_off_argv(endpoint: endpoint) }),
  )
}

// THE ORACLE THIS PR'S OWN DIAGNOSIS ARGUES FOR AND DOES NOT YET BUILD, written down rather than
// left implicit (review, 2026-07-30). The refusal-arm defect established that a byte-equality
// golden gate and target-language VALIDITY are different oracle families, and only the first exists
// over these two artifacts. What landed in response was a string-shape claim about one call site —
// the escape form present, the raw apostrophe absent — which closes that site and says nothing
// about the next hand-quoted one.\n\nSo the class is open and this row names its closure rather
// than implying the point fix covered it. The repo already has the machinery: a bounded bash
// grammar and serialize_bash, read forward, ingest the emitted script and refuse on a parse failure
// — the same one-grammar-both-directions move DESIGN 4 describes, with a bash -n gate over the two
// committed artifacts as the cheaper interim if the grammar's coverage of this dialect proves
// short.\n\nThe point fix it described is now gone with its subject: the arm that needed quoting
// was the tailscale teardown refusal, and that refusal was itself built on a false claim about the
// CLI, so the emitter no longer quotes anything by hand. That REMOVES a call site; it does not
// close the class, and the bound is now worse rather than better — with no hand-quoted site left in
// this module, nothing here would red if the next one were introduced.\n\nDISSOLVES ON: both
// generated deploy scripts parsed by an executing consumer on every emit, with a discriminating RED
// that introduces a hand-concatenated quote at any call site and goes red on the parse rather than
// on a string shape. The shared authority itself stays independently witnessed at
// shell_quote_escapes_an_embedded_apostrophe, which does not depend on this module having a caller.
//
// THE TWO SCRIPTS ARE GONE; THE SHELL THIS MODULE STILL RENDERS IS NOT. The apply and the retract
// are typed legs (gunbc.live_deploy.apply_legs, gunbc.live_deploy.retract_legs), so no generated
// deploy script remains for the parse oracle to read. What still renders privileged shell here is
// tree_sync_restart_step_with_diagnosis and tailscale_serve_apply_step (the roadmap nodes
// shell-dag-live-deploy-restart-tailscale and shell-dag-live-deploy-install-owned own their typed
// replacement), so the row binds the first of them: it dissolves when that rendered step does.
data live_deploy_remote_mutation_service_op_realization_dissolution_trigger: Disposition = Scaffold {
  dissolves_to: RealizationDispatch,
  bind: DeclarationRef {
    module_path: "gunbc.live_deploy.emit",
    decl_name: "tree_sync_restart_step_with_diagnosis",
    field: WholeDeclaration,
  }
}

// The apply script is ONE orchestration-intent Pipeline (the retract fold is typed legs, gunbc.live_deploy.retract_legs), built from the two
// degenerate POLES of the grain-agnostic gunbc.membership_reconcile (apply = reconcile
// desired=all-members/observed=none => all Upsert; retract = reconcile
// desired=none/observed=owned-artifacts => all Teardown) — apply_intent_from_effects
// folds the resulting MemberEffects into the Pipeline via the per-kind
// emit_deploy_member_effect handler (share the diff, dispatch the apply), framing
// (preamble/receipt) wrapping OUTSIDE the reconcile. A refusal (a non-owned/unknown member) refuses
// the WHOLE fold before emit (EffectsOrRefusal sum — un-emittable by type; never reached by the
// degenerate poles). The Pipeline is emitted through the signed
// v2.compiler.emit_orchestration.orch_emit_pipeline path over the bash_orchestration_emit medium —
// NOT assembled by workflow-code string concat. The smuggled-program class (control flow /
// sequencing joins built by concat in this module — the former ensure_apt_package function-def, the
// deployment_ensure_dependency_script nested if/then concat, the tailscale if/fi) is dissolved:
// dependency-ensure is inline If-Not-ExitZero(dpkg -s) then Do(sudo -n apt-get install) intent
// (DESIGN §2 CUT: desugar inline, no minted verb), and the emission JOIN lives in
// extdeps/languages/bash_orchestration_emit, not here (no-smuggled-programs wall: a string literal
// is an ATOM, joins live in extdeps/languages rows). An emission refusal returns a poison marker
// (live_deploy_*_emit_refused_poison) so the marker reaches a consumer instead of a hand-spelled
// fallback (DESIGN §5: refuse, never widen). THE COMMITTED GOLDEN ARTIFACTS ARE DELETED: nothing
// executed .github/live-deploy-srv1-apply.sh or -retract.sh, and their registry rows named a
// HostReconciler consumer that does not exist — the real deploy runs live_deploy_apply_prod_role_wet
// through gunbc run. A committed artifact nobody reads is not coverage. The byte oracle those
// goldens provided now lives where a fixture revision is legitimate, in test.claim.live_deploy.emit
// against RevisionBoundAtEmission, and it is strictly stronger there: the goldens compared whole
// files and located nothing, while the witnesses pin the exact ExecStart line with three REDs (flag
// absent, wrong candidate's value, flag duplicated). RESIDUE (named, not this slice): Run.command
// is still a String leaf (v2.std.orchestration.Run), so the heredoc file bodies (server.js, systemd
// unit) and per-command argv interpolation ride inside command: strings as the anemic-leaf residue
// — they dissolve when Do-effect gains a typed file-write leaf (heredoc file bodies as typed
// orchestration intent, live_deploy_intent_dependency_graph_emit_dissolution_trigger binds
// orch_emit_pipeline). Transport-aware remote-mutation service-op realization (live_deploy runs
// shell, not yet a transport-realized service op) is OUT OF SCOPE —
// live_deploy_remote_mutation_service_op_realization_dissolution_trigger. Healthz readiness and
// digest read-back run on the DAG reconcile spine after mutation (live_deploy.readiness transport
// curl poll, then live_deploy.apply digest read-back); the apply script ships mutation only (no
// in-script curl read-back).
data live_deploy_intent_dependency_graph_emit_dissolution_trigger: Disposition = Scaffold {
  dissolves_to: RealizationDispatch,
  bind: DeclarationRef {
    module_path: "v2.compiler.emit_orchestration",
    decl_name: "orch_emit_pipeline",
    field: WholeDeclaration,
  }
}

