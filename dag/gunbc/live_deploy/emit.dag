fn apply_belt_timer_unit_write_step(spec: DeploymentSpec) -> PipelineStep {
  deploy_raw(command: deploy_stage_write_command(
    stage_name: deployment_belt_timer_unit_name(names: spec.names) as String,
    content: render(doc: emit_belt_timer_unit_doc(spec: spec), proto: live_deploy_protocol),
  ))
}

// apply/retract are the two degenerate POLES of the ONE grain-agnostic membership_reconcile
// (gunbc.membership_reconcile) — no bespoke fold. apply = reconcile(desired = all deploy members,
// observed = none) => every member Added => Upsert. retract = reconcile(desired = none, observed =
// the owned artifacts) => every member Removed => Teardown (all Owned, so no refusal). The
// DeploymentStep (key_of/key_eq/value_eq/ownership_of) bundle is this consumer's Realization of the
// spine — not a copy of it. ownership_of projects through deployment_step_ownership onto the single
// gunbc.ownership authority, so it is ALWAYS Present (a deploy member's ownership is known by
// construction); the OwnershipUnknown/MemberNotOwned refusal arms are the safety backstop for a
// future non-degenerate observed provider, exercised only by the synthetic spine witness. key_of
// returns stable member IDENTITY (artifact path / dependency package); value_eq never fires in the
// degenerate poles (no Modified — one side is always empty).
type DeploymentStepMemberAt = NonEmptyStr

fn deployment_step_key(step: DeploymentStep) -> NonEmptyStr {
  match step {
    ArtifactStep { step: art } => art.path
    Dependency { step: dep } => ensured_subject_identity(subject: dep.subject)
  }
}

fn deployment_step_key_eq(a: NonEmptyStr, b: NonEmptyStr) -> Bool { a == b }

fn deployment_step_value_eq(a: DeploymentStep, b: DeploymentStep) -> Bool { a == b }

fn deployment_step_ownership_opt(step: DeploymentStep) -> Ownership? {
  Present { value: deployment_step_ownership(step: step) }
}

// THE RELEASE-CONSUMING MEMBERS LEAVE THE APPLY-ALL ROSTER. Their desired/observed identities are
// decided in gunbc.live_deploy.member_identity and their mutations arrive as a ReleaseEffectPlan the
// caller derived by observing the host (gunbc.live_deploy.member_observe), so an already-converged
// host installs none of them. Every other owned artifact still reconciles against `observed: []`
// below -- the declared frontier, one member kind at a time, never a silent skip. Three deployment
// steps carry the five members: the unit step is where the unit file is written AND where the
// manager reloads and the process restarts, because those two members have no artifact of their own
// on the host and the deployment order already places the unit after the roots its process writes.
fn identity_member_of_step(step: DeploymentStep) -> ConvergedMember? {
  match step {
    ArtifactStep { step: art } => match art.kind {
      GunbcSourceTree => Present { value: TreePublication }
      ServeBinary => Present { value: Executable }
      SystemdUnit => Present { value: UnitFile }
      DispatchWorktreeRoot => Present { value: DirectoryRoot { path: art.path } }
      AttemptStateRoot => Present { value: DirectoryRoot { path: art.path } }
      ComputeRoot => Present { value: DirectoryRoot { path: art.path } }
      _ => none
    }
    Dependency { step: _ } => none
  }
}

// TWO QUESTIONS, NOT ONE, AND CONFLATING THEM SILENTLY DROPPED THE RUNTIME ROOTS.
//
// `identity_member_of_step` answers WHICH MEMBER a step is, and it has two consumers that need
// opposite things. deployment_apply_plan excludes a step from the membership reconcile when the
// step's commands come from emit_release_member_effects instead -- otherwise the step would be
// emitted twice. apply_step_effects asks the same function to decide whether the plan GATES the
// step. Those coincided while every identity member rendered its own commands.
//
// A directory root breaks the coincidence: its identity decides WHETHER it is installed, but the
// command still comes from the step's own upsert, because the attempt-state root installs a managed
// directory and the other owned roots an owned one. So a root must stay IN the reconcile and still
// be gated. Answering the exclusion question with "is it an identity member" removed the runtime
// roots from the reconcile, left no effect for their steps to match, and emitted nothing for them
// -- caught by two pre-existing witnesses, not by anything in the types.
fn step_renders_its_own_member_commands(step: DeploymentStep) -> Bool {
  match identity_member_of_step(step: step) {
    Absent => false
    Present { value: member } => match member {
      DirectoryRoot { path: _ } => false
      _ => true
    }
  }
}

fn deployment_apply_plan(spec: DeploymentSpec) -> MembershipPlan<DeploymentStep, DeploymentStepMemberAt> {
  membership_plan_admitting_outcome(
    outcome: membership_reconcile(
      desired: filter(spec.steps, s => !step_renders_its_own_member_commands(step: s)),
      observed: [],
      key_of: deployment_step_key,
      key_eq: deployment_step_key_eq,
      value_eq: deployment_step_value_eq,
      ownership_of: deployment_step_ownership_opt,
    ),
  )
}

fn deployment_retract_plan(spec: DeploymentSpec) -> MembershipPlan<DeploymentStep, DeploymentStepMemberAt> {
  membership_plan_admitting_outcome(
    outcome: membership_reconcile(
      desired: [],
      observed: map(deployment_owned_steps_retract_order(spec: spec), s => ArtifactStep { step: s }),
      key_of: deployment_step_key,
      key_eq: deployment_step_key_eq,
      value_eq: deployment_step_value_eq,
      ownership_of: deployment_step_ownership_opt,
    ),
  )
}

// The staged filename reads from spec.service.unit_name for the same reason the install does: these
// two steps write and then install THE SAME FILE, and while both were the literal
// gunbc-roadmap.service that agreement was a coincidence of two independent constants rather than a
// fact. Parameterizing only the install side would have left the writer staging one name and the
// installer copying another — a deploy that fails on a missing file, which is at least loud, or
// worse installs a stale unit left in the stage directory from a previous run.
fn apply_systemd_unit_write_step(spec: DeploymentSpec, revision: ReleaseRevisionBinding) -> PipelineStep {
  deploy_raw(command: deploy_stage_write_command(
    stage_name: spec.service.unit_name as String,
    content: render(doc: emit_systemd_unit_doc(spec: spec, revision: revision), proto: live_deploy_protocol),
  ))
}



// THE SAME PER-INSTANCE ONESHOT CHANGES REALIZATION AFTER ITS TWO INPUTS EXIST. GunbcSourceTree
// first installs the owner-run working-byte sync; ServeBinary then installs the admitted binary and
// replaces that unit document with Git-native convergence. There is no second unit name, lifecycle,
// or environment carrier to keep aligned, and no repository metadata is ever copied as files.
// Starting convergence before ServeBinary would execute the target's stale binary/corpus; leaving
// the rsync document installed would make the next deploy's first phase run convergence before its
// candidate binary exists. The two writes therefore bracket the binary install deliberately.
fn apply_repository_convergence_unit_write_step(
  spec: DeploymentSpec,
  revision: ReleaseRevisionBinding,
) -> PipelineStep {
  deploy_raw(command: deploy_stage_write_expansion_command(
    stage_name: spec.names.tree_sync_unit_name as String,
    format: convergence_unit_doc(
      spec: spec,
      candidate: release_revision_execstart_text(binding: revision),
      receipt_path: convergence_receipt_path(instance_root: spec.service.instance_root as String),
      working_directory: "%s",
    ),
    expansion_var: "PWD",
  ))
}

fn repository_convergence_readback_command(
  spec: DeploymentSpec,
) -> String {
  shell_command_text_of_argv(argv: [
    spec.service.serve_binary as String,
    "run",
    "--source-root",
    "dag",
    "--source-root",
    "src/v2",
    "--entry",
    convergence_placement_entry_path,
    "--function",
    "repository_convergence_readback_wet",
    "--arg",
    concat("receipt=", convergence_receipt_path(instance_root: spec.service.instance_root as String)),
  ])
}


// gunbc-tree-sync.service (#7011 realization) failed its control process on every srv1 deploy since
// landing (receipt 29928424523 and its predecessor 29926422286), and the bare 'sudo -n systemctl
// restart' stderr — 'Job for gunbc-tree-sync.service failed because the control process exited with
// error code' — never carries WHY: the actual ExecStart failure (the rsync exit) lives only in the
// unit's own journal, unreachable from this refusal (DESIGN 5 — a stopped, typed, but unlocated
// line, the same gap #7038 closed for gunbc-roadmap.service's async ServiceNotReady). This restart
// is SYNCHRONOUS, ahead of that poll-based unit_diagnosis capture entirely (GunbcSourceTree upsert
// runs before the SystemdUnit member), so it needs its own capture rather than waiting on one that
// never runs. Reuses the single unit-status-tail authority (live_deploy_unit_status_tail_command,
// gunbc.live_deploy.intent) the roadmap-unit capture already owns — no second diagnosis format. On
// failure the tail is appended to stderr and the step still fails (exit 1): a diagnosis, never an
// escape hatch (DESIGN 5 forbids proceeding as if the refusal had not fired).
fn tree_sync_restart_step_with_diagnosis(spec: DeploymentSpec) -> PipelineStep {
  deploy_raw(command: join([
    deploy_effect_command(inv: systemctl_restart_effect(unit: spec.names.tree_sync_unit_name)),
    " || { echo '--- gunbc-tree-sync.service control-process diagnosis ---' >&2; ",
    live_deploy_unit_status_tail_command(unit: spec.names.tree_sync_unit_name),
    " >&2; exit 1; }",
  ], ""))
}

// THE IDEMPOTENCE GUARD IS DELETED, AND ITS REMOVAL IS THE POINT. The apply used to wrap the serve
// command in `if ! tailscale serve status | grep -q ':<port>'`, which is a pseudo-observation twice
// over: it greps unstructured status text for a port number that appears nowhere in the
// configuration key, and a mapping for a DIFFERENT deployment on the same port would satisfy it —
// so the guard skipped precisely when another deployment held the endpoint, which is the collision
// it looked like it was preventing.\n\nThere is nothing to guard. Configuring an endpoint to a
// backend it already has is a no-op at the upstream, because the endpoint IS the key; issuing it
// twice cannot produce a second mapping. So the correct number of observations here is zero, and
// the replacement for a wrong observation is not a better observation but no observation at
// all.\n\nThe argv is built by extdeps.tailscale.serve rather than concatenated here, so the apply
// and the teardown cannot disagree about the flags — which is the property the upstream `off` form
// actually requires.
fn tailscale_serve_apply_step(spec: DeploymentSpec) -> PipelineStep {
  deploy_raw(command: shell_privileged_command_text_of_argv(
    argv: concat(["tailscale"], tailscale_serve_enable_argv(endpoint: spec.names.tailscale_serve_endpoint)),
  ))
}

fn tailscale_serve_teardown_step(spec: DeploymentSpec) -> PipelineStep {
  deploy_raw(command: shell_privileged_command_text_of_argv(
    argv: concat(["tailscale"], tailscale_serve_off_argv(endpoint: spec.names.tailscale_serve_endpoint)),
  ))
}

// THE BINARY PATH BECAME A PARAMETER AND ITS PARENT DIRECTORY DID NOT (review 45197). This PR
// derives serve_binary from the instance root, so a twin installs to its own tree — but the step
// that CREATES the destination directory still read `sudo -n install -d -m 0755 /opt/gunbc/bin`,
// production's literal. `install` does not create missing parents, so a twin apply reaches the copy
// with no `<instance-root>/bin` to copy into and fails on a path that looks like a permissions
// problem.
//
// That is the same half-parameterization the placement de-fork exists to remove, surviving one
// level down: the value moved to the argument and the directory that has to exist for the value to
// be writable stayed behind. Nothing caught it because production's parent and the literal agree,
// which is exactly the condition that made every srv1-only gap in this lane invisible until a
// second instance existed.
//
// Deriving the parent FROM the path being installed is what keeps them from drifting again — there
// is no second literal to update, and the emitted command for srv1-live is byte-identical because
// the derivation of /opt/gunbc/bin/gunbc is /opt/gunbc/bin. The mode and ownership are deliberately
// unchanged: production's bin directory is root-owned, and switching this to the service-user-owned
// install_d_owned_command would silently re-own a live directory to satisfy a twin.

fn path_parent_dir(path: String) -> String {
  match list_tail(xs: reverse(split(s: path, delimiter: "/"))) {
    TailAbsent => "/"
    TailFound { tail: rest } => join(reverse(rest), "/")
  }
}
// THE 0755 IS A SHARED CONSTANT, NOT A DERIVED FACT, and every member still on it inherits it
// regardless of what that member's readers and writers actually need. That is why
// /opt/gunbc/attempt-state converges world-readable while the per-attempt directories the belt
// creates under it are 0700 (attempt_state_prepare_argv_for_instance) — the leaf states its
// requirement, the root cannot, so the root is loose by default rather than by decision. Ownership
// is already derived (-o/-g project the service user from the spec, install_d_owned_command); the
// mode is the one field on the triple still hand-picked.
//
// THE FIX IS NOT A TIGHTER LITERAL — replacing 0755 with 0700 would move the same undeclared
// number, and a member whose dependents genuinely need traversal would then break with no statement
// of why. The mode must be DERIVED FROM THE MEMBER'S DECLARED DEPENDENTS: which principals need
// which verbs on that position, folded into extdeps.access.posix.FilePermissions (PermissionBits
// per owner/group/other class, cited to Open Group sys/stat.h) — the same requirement rows
// std.effect_grant already carries as (verb x subtree x principal) for the execute direction, read
// here to construct the permission instead of to admit against it. Once a member carries its
// dependents, an over-permissive mode is unwritable rather than merely unreviewed, and this helper
// loses its mode argument entirely (operator direction 2026-07-30: precise, and derived from the
// needs/dependents).
//
// The retirement itself is carried by install_d_mode_derivation_dissolution below rather than by
// this paragraph. How far the migration has got is deliberately NOT written here either: a count
// copied out of the current tree is an oracle for nothing, and it goes stale in the one direction
// nobody notices.

// The three mode literals this module installs with, named once each. They were previously
// spelled inline at ten call sites, which is what let the shared 0755 look like ten independent
// decisions rather than one constant inherited ten times. Naming
// them changes no emitted byte and does not derive them — that derivation is exactly what the
// paragraph above says is still owed — but it makes the inheritance visible to the reader and gives
// the eventual derivation one place to land per class.
data install_d_shared_mode: NonEmptyStr = "0755"

data install_file_shared_mode: NonEmptyStr = "0644"

data install_executable_shared_mode: NonEmptyStr = "0755"

// THE MODE DEBT ENDS WHEN THE SHARED CONSTANT DOES. A member carrying FilePermissions derived from
// its declared dependents has no use for a hand-picked 0755 to inherit, so install_d_shared_mode
// going away IS the discharge — which makes the trigger a retirement over a declaration that
// exists today rather than a forward reference to a carrier nobody has written.
data install_d_mode_derivation_dissolution: DissolutionCondition = retires_dissolution(
  ref: DeclarationRef {
    module_path: "gunbc.live_deploy.emit",
    decl_name: "install_d_shared_mode",
    field: WholeDeclaration,
  }
)

// THE BELT'S RECEIPT WRITE IS NOT CRASH-SAFE, AND THAT IS ADMITTED RATHER THAN OVERLOOKED. The tick
// writes its receipt in place instead of through the same-directory staging + rename that
// gunbc.fleet_converge_cli uses. In-place is correct on ownership grounds — the directory is
// service-user-owned and the file is not a stale root-owned artifact — but a tick interrupted
// mid-write leaves a truncated receipt, which renders as BeltPassOutcomeUnreadable rather than as a
// wrong verdict. Adopting the atomic publish is the strictly better construction and is not done
// here, so the weaker one is a decision on the record.
//
// The trigger is UNBOUND deliberately. The discharge is the belt tick adopting the atomic publish,
// and no declaration carries that today — binding forward to a name nobody has written is the §3
// fabricated-citation class std.dissolution refuses by name.
data belt_receipt_in_place_write_residue_dissolution: DissolutionCondition = unbound_dissolution(
  description: "dissolves-on: the belt tick publishes its receipt through the same-directory staging + rename gunbc.fleet_converge_cli uses, so an interrupted tick cannot leave a truncated receipt behind." as NonEmptyStr
)

fn install_d_owned_for_user(user: NonEmptyStr, path: String) -> String {
  install_directory_owned_command(
    mode: install_d_shared_mode,
    owner: user,
    group: user,
    path: path,
  )
}

// WHY THIS INSTALLS WITH -o/-g RATHER THAN WRITING AS ROOT AND FIXING UP, and the history is the
// irreducible part. The principal itself is not stated here: gunbc.fleet_posix_accounts owns it —
// FleetAccountCiRunner is the deploy principal (unit_user=root is NOT the authorization principal)
// and fleet_posix_ci_runner_sudo_grants() enumerates its NOPASSWD roster. Reading it from there is
// the point of this paragraph; an earlier revision spelled the roster and its size inline and went
// stale twice.
//
// AN EARLIER NOTE HERE CLAIMED ROOT, on the strength of a hand ssh verification (parent lane,
// 2026-07-20) that CONTRADICTED the repo's own single authority (fleet_posix_accounts, probed
// 2026-07-02). That is a §3 fork of the principal fact, and reality sided with the authority: the
// first flip deploy (run 29822498755, 2026-07-21) died on bare-rsync EACCES and chgrp EPERM into
// the service-user-owned tree. So the corrected realization stays INSIDE the granted set, and each
// arm is shaped by which grant it has rather than by what would be convenient: directories and the
// binary install with -o/-g service-user through the granted install, which puts ownership at
// CREATION and dissolves the root-writes-then-chown two-step — the wrongly-owned intermediate state
// is unwritable rather than merely repaired; the tree sync runs AS the service user through a
// oneshot unit, because the owner writing its own tree is what install+systemctl compose into when
// no `sudo -u` form is granted; teardown rm goes through the granted rm.
//
// RESIDUE, NAMED: emit-construction refusal of bare rsync/chown outside the granted set is not
// built here and rides the effect-namespace-grants lane. And the former
// install_d_shared_setup_latent_coupling marker fired as designed — /opt/gunbc now has MULTIPLE
// owned writers, so the shared-prefix `install -d /opt/gunbc` rides the FIRST owned writer in apply
// order (GunbcSourceTree) once, and each deeper parent (/opt/gunbc/bin) rides its own writer.
fn install_d_owned_command(spec: DeploymentSpec, path: String) -> String {
  install_d_owned_for_user(user: spec.service.service_user, path: path)
}

// THE DISPATCH THAT ADMITS A SECOND KIND OF ENSURED RESOURCE, written so the package arm is
// untouched. A package still lowers to exactly the ensure step it always did, at both privilege
// settings, so no existing emitted byte moves -- the widening adds a kind, it does not redefine
// what ensuring a package means.\n\nA directory lowers to the same owned install -d the artifact
// steps use, through the same single authority, with the owner taken from the ensured subject
// rather than from a deployment spec. That is what lets a host-level resource be stated without an
// instance: an ensured host directory is a fact about the host, and threading a spec through it
// would have made it look like a per-instance fact again -- the exact confusion that put this root
// in the owned roster to begin with.\n\nprivileged is consumed only by the package arm because it
// describes how apt is invoked; install -d is privileged in both contexts and takes the same form
// either way.
fn ensure_dependency_steps(dep: DeploymentDependencyStep, privileged: Bool) -> List<PipelineStep> {
  match dep.subject {
    EnsuredPackage { package } => [ensure_apt_package_step(pkg: package, privileged: privileged)]
    EnsuredHostDirectory { path, owner } => [
      deploy_raw(command: install_d_owned_for_user(user: owner, path: path as String)),
    ]
  }
}

// `-g` is spelled with the OWNER'S USER NAME, not a modeled group name, and that is inherited from
// install_d_owned_command rather than introduced here: PosixUser carries a gid but no group name,
// and srv1's per-user groups happen to share their user's name so the emitted argv is
// byte-identical either way. It is written down because the coincidence is load-bearing and silent
// — a host whose service account sat in a differently-named primary group would emit a `-g` that
// does not resolve, and the failure would look like a permissions bug rather than a modeling gap.
// dissolve-on = PosixUser (or a PosixGroup beside it) carries the group name, at which point this
// projects it instead of reusing the user's.
fn install_d_managed_command(dir: ManagedDirectory) -> String {
  install_directory_owned_command(
    mode: managed_directory_mode_octal(d: dir) as NonEmptyStr,
    owner: dir.owner.name,
    group: dir.owner.name,
    path: dir.path as String,
  )
}

// THE PUBLICATION PRINCIPAL EXISTS BEFORE ANY MEMBER NAMES IT. Creation is idempotent at the shell
// -- `id -u` answers before useradd is asked -- and the useradd argv is the one projection the grant
// roster also enrolls, so the executed command and its authorization are one value. It rides the
// preamble rather than the publication member because the member's first act is `install -o` for
// that principal, and a member that creates its own principal on the way in would conflate two
// ownership facts in one step.
// THE GUARD IS NO LONGER SPELLED HERE. `id -u ... ||` used to be authored inline, which made this
// caller the place EnsureSystemAccount's idempotence lived -- so the operation read as idempotent
// while any second caller inherited `useradd` exiting 9. The precondition now belongs to the
// operation (gunbc.executor_privileged_operation executor_privileged_operation_converge_command)
// and this function consumes it.
//
// THE EMITTED BYTES DID CHANGE, and an earlier revision of this very annotation claimed they did
// not -- a machine claim stated in prose, contradicted by this PR's own witness update, and §4c is
// explicit that an annotation is never evidence a machine claim holds. The check now runs through
// the same posix_single_quote authority as the operation it guards, so the login arrives
// single-quoted: `'id' '-u' 'gunbc-publication'` rather than `id -u gunbc-publication`. Equivalent
// shell, one fewer place deciding quoting, and the witness asserts the guard's shape rather than a
// spelling. What is verified is that all 59 live_deploy emit witnesses pass -- not that the bytes
// are identical, because they are not.
fn deploy_publication_principal_ensure_command(spec: DeploymentSpec) -> String {
  executor_privileged_operation_converge_command(op: EnsureSystemAccount {
    login: spec.names.publication_principal,
    shell: fleet_posix_nologin_shell_path,
  })
}

// THE PROVIDER-STATE ENSURE RIDES THE PREAMBLE, DERIVED FROM THE SPEC RATHER THAN FOUND IN ITS STEP
// LIST (C7). Every apply emits it because gunbc.live_deploy.spec deployment_provider_state_step is a
// function of the spec, not a row an author may forget: there is no spec for which it returns
// nothing, so there is no state in which the deploy silently stops creating the directory the
// provider login writes into. That is the construction the earlier refusal arm was standing in for.
//
// Ensured means converged on every apply and never torn down, so it emits unconditionally rather
// than gated on a plan mutation: `install -d` is idempotent, and a converged host re-running it is
// what the category means. The read-back member reports the directory's OWNER; it does not decide
// whether the directory is created.
fn provider_state_ensure_steps(spec: DeploymentSpec) -> List<PipelineStep> {
  ensure_dependency_steps(dep: deployment_provider_state_step(spec: spec), privileged: true)
}

fn deploy_apply_preamble_steps(access: DeployAccess, spec: DeploymentSpec) -> List<PipelineStep> {
  concat(
    [
      deploy_raw(command: deploy_sudoers_install_shell(access: access)),
      deploy_raw(command: deploy_publication_principal_ensure_command(spec: spec)),
    ],
    provider_state_ensure_steps(spec: spec),
  )
}

// THE CAP APPLY CONSUMES RETIREMENT AUTHORIZATION, AND WITHOUT ONE IT REFUSES.
//
// THIS IS THE PRODUCTION WRITER. `gunbc.host_axis_caps` authors the per-slot drop-in content and
// THIS path applies it -- `gunbc converge` does not (operator privilege hold, 2026-08-13) -- so a
// gate that lives only beside the authoring helpers leaves the reachable route intact. Until this
// parameter existed the guard here checked author-before-shadow-revert composition and a nonempty
// unit list, neither of which is evidence that the surplus old slots have finished.
//
// THE DEFAULT IS WITHHELD AND THAT IS DELIBERATE. No caller yet supplies a live
// `SurplusSlotObservation` (`gunbc.runner_slot_population_census` produces one but is not wired to
// a converge call site), so every caller today reaches the refusal arm. A deploy that cannot prove
// retirement does not write caps; it stops and says which evidence is missing. That is the safe
// default the previous shape did not have.
//
// IT REFUSES BOTH HALVES. The withheld arm emits neither the authoring script NOR the per-unit
// shadow reverts that follow it, because a revert is a change to the same subject and authorising
// half a transaction is how the ordering hazard returns under a different name.
// THE WITHHELD LINE IS A REPORT, NOT A FAILURE: the same __GUNBC_CONVERGE_WITHHELD__ spelling the
// fleet plan's slot teardown uses (gunbc.runner_slot_provision slot_removal_withheld_line), so a
// reader of the apply transcript sees one vocabulary for "this member was not performed and why".
// Single quotes in the cause are dropped rather than escaped: the cause is prose for the operator,
// and a quote inside a single-quoted echo would end the word and run the rest.
fn memory_cap_withheld_line(host: HostIdentity, cause: String) -> String {
  join([
    "echo '__GUNBC_CONVERGE_WITHHELD__ memory-cap apply: ",
    cause.replace(from: "'", to: ""),
    "; existing caps left exactly as observed host=",
    host as String,
    "' >&2",
  ], "")
}

fn deploy_memory_cap_apply_steps(
  spec: DeploymentSpec,
  authorization: CapConvergeDecision,
) -> List<PipelineStep> {
  let host = spec.target.host.identity
  match cap_authorization_for_host(d: authorization, host: host) {
    CapAuthorizationWithheld { cause: why } =>
      [deploy_raw(command: memory_cap_withheld_line(host: host, cause: why))]
    CapAuthorizationRefused { cause: why } =>
      [
        deploy_raw(
          command: concat(
            concat("__GUNBC_DEPLOY_REFUSED__ memory-cap apply not authorized for this host: ", why),
            concat(" host=", host as String),
          ),
        ),
      ]
    CapAuthorizedForThisHost { desired: members, authorized_retiring: _, target_units: units } => {
      let script = deploy_memory_cap_apply_script_from_authorization(members: members, units: units)
      if host_axis_caps_author_before_revert_enforced
        && deploy_memory_cap_script_author_precedes_shadow_revert(
          script: script,
          members: members,
          units: units,
        ) {
        [deploy_raw(command: script)]
      } else {
        [
          deploy_raw(
            command: concat(
              "__GUNBC_DEPLOY_REFUSED__ memory-cap apply ordering gate failed host=",
              host as String,
            ),
          ),
        ]
      }
    }
  }
}

// GunbcSourceTree stages working bytes with rsync --delete while excluding .git, then the
// ServeBinary step replaces the owner-run oneshot with Git-native repository convergence.
// Repository metadata is never transported as files: git imports the candidate objects from the
// runner checkout, compare-and-swaps the base ref, resets the index/worktree, and the deploy reads
// back its receipt before continuing. Target-local worktree registrations, session refs and
// unrelated refs are preserved by the convergence adjudication rather than by an additive file
// copy. Flags are -rlpt, not -a: the sync principal is the service user
// (gunbc.fleet_posix_accounts FleetAccountCiRunner is the deploy principal, not the tree's owner),
// so -a's owner/group replication would chgrp toward the runner's
// group and fail EPERM — ownership is the destination principal's by construction, never replicated
// from the source.

// THE BELT MEMBER CARRIES THE install -d FOR THE DIRECTORY ITS TICK WRITES INTO, which is the
// orchestration-is-derived-from-the-member rule emit_deploy_member_effect_note already states (a
// ServerScript carries the install -d it writes into). The belt tick publishes its receipt to
// instance_receipts_dir(instance_root) and the workflow UI reads that receipt to answer whether a
// tick ran; with no directory owned by the service principal the write is EACCES, which is what
// every instance was in fact doing — belt-last-tick.json was absent from BOTH srv1 roots when read
// on 2026-08-19, so this receipt has never been written anywhere, not merely on the new slot.
//
// THIS ALSO RESTORES A BOOTSTRAP THAT WENT DEAD RATHER THAN ADDING A NEW ONE.
// fleet_converge_receipt_atomic_publish_note FORMERLY named the deploy install-d on
// fleet_converge_receipt_dir as riding FleetConvergeTimerUnit apply (that clause is itself now
// corrected in gunbc.host_layout, so this sentence describes the prior revision rather than the
// current text), and that member is a retired refusal poison (the cadence moved to on-demand
// plan/apply, sleek-heron-218), so nothing has bootstrapped a receipts directory on any fresh
// instance root since. Green has no receipts directory at all; production's exists only because it
// predates the retirement. Riding the belt member is correct rather than convenient: the belt is
// the consumer that needs the directory on every instance it is installed on, so the bootstrap
// travels with a member that is unconditionally present wherever a receipt gets written.
//
// THERE IS DELIBERATELY NO TEARDOWN ARM. Receipts are produced artifacts, and
// devboot_root_realization_note draws exactly this line — a deploy must never delete what it
// produced — so the directory is bootstrapped and never removed, and a retract that also destroyed
// the converge receipts sharing the directory would be the failure that note exists to prevent.
// install -d is idempotent, so converging an existing correctly-owned directory (production's)
// emits the same command and changes nothing.
//
// The in-place-write residue this member leaves is carried by
// belt_receipt_in_place_write_residue_dissolution rather than by this paragraph.
// ONE MEMBER, ITS FRAGMENTS, IN THE DEPLOYMENT'S ORDER. These are the SAME fragments the apply-all
// arms below emit for the identity members, regrouped by the member that needs them and emitted at
// that member's position in spec.steps (apply_intent_from_effects), never prepended to the whole
// script: the first cut emitted every release mutation before every remaining membership effect, so
// on a fresh or partially repaired host the new process was started before the roots it writes
// existed and before the ensured packages were present (review on PR #10696).
//
// Publishing the tree is the repository-convergence unit and its oneshot (the rsync-era tree-sync
// unit that GunbcSourceTree also wrote is not re-emitted here -- the convergence unit overwrote it in
// the same script, so it was never the document the host ran); installing the executable is the
// install and the receipts directory; writing the unit is the render and install. The manager and
// process members have no artifact of their own and ride the unit step: daemon-reload once, iff the
// plan says the manager is stale or the file changed, then the restart that closes the transaction.
//
// THE PLANNED IDENTITY BINDS THE ACTUATION. The executable copied is the file at the source path, a
// path that is mutable between planning and copying; so the source is verified against the plan's
// digest immediately before the copy and the destination immediately after, each under set -e. A
// build that changed in between, or a copy that did not land, stops the line -- an installed
// executable can never differ from the identity the plan declared converged. The unit renders from
// the plan's own revision, the one carrier of that fact.
// A ROOT IS EMITTED THROUGH ITS OWN STEP, NOT HERE, because the command differs per root -- the
// attempt-state root installs a managed directory and the other two an owned one -- and the step
// knows its kind while a DirectoryRoot member carries only a path. apply_step_effects gates that
// step's existing emission on this plan's mutation, so the identity decides WHETHER the root is
// installed and the step decides HOW. The DirectoryRoot arm below exists because the match is total
// over ConvergedMember, and it is genuinely unreached from this function.
// THE BROKER'S TWO FILES RIDE THE UNIT MEMBER, and that placement is the same one the deployment
// slice already uses: the slice unit is written inside the tree-publication effect rather than
// enrolled as an owned artifact step, because a cgroup bound is part of installing the units that
// join it, not a separately reconciled resource. The broker's slice and service are the same kind
// of fact, with the additional reason that gunbc_approval_broker_unit_name is a HOST singleton
// (gunbc.live_deploy.spec): enrolling it as an owned member would make a twin's retract remove the
// host's broker.
//
// THE SLICE IS WRITTEN BEFORE THE UNIT that joins it, in the same order the roadmap's is: a
// [Service] carrying Slice= for a slice that does not exist yet starts under the default bound,
// which is the unbounded state the bound exists to remove.
// A NON-OWNING SPEC EMITS NOTHING (review 68094). The broker unit is a HOST singleton whose content
// is instance-derived, and srv1-lab deploys to the same host as production -- so before this, a lab
// apply overwrote the host's broker unit to point at the lab tree and restarted it, killing
// production's broker. The steps are now CONSTRUCTED from the ownership predicate rather than
// guarded after the fact: a non-owner produces an empty list, so there is no write to skip.
fn apply_approval_broker_unit_write_steps(spec: DeploymentSpec, revision: ReleaseRevisionBinding) -> List<PipelineStep> {
  if deployment_owns_the_host_approval_broker(spec: spec) {
    approval_broker_unit_write_steps_on(spec: spec, revision: revision, port: spec.approval_broker.listen.port)
  } else {
    []
  }
}

// THE LIFECYCLE STEPS FOLLOW THE SAME OWNERSHIP, and they are separate because a restart is the
// half that actually killed the other instance's process: writing an identical unit is idempotent,
// restarting one is not. Both are empty for a non-owner.
fn approval_broker_lifecycle_steps(spec: DeploymentSpec) -> List<PipelineStep> {
  if deployment_owns_the_host_approval_broker(spec: spec) {
    [
      deploy_effect(inv: systemctl_enable_effect(unit: gunbc_approval_broker_unit_name)),
      deploy_effect(inv: systemctl_restart_effect(unit: gunbc_approval_broker_unit_name)),
    ]
  } else {
    []
  }
}

// ── THE BROKER'S TREE, COPIED FROM THE CANDIDATE ────────────────────────────────────────────
// STAGE A INSTALLED A UNIT WITH NO TREE BEHIND IT. WorkingDirectory pointed at the roadmap's
// deployed tree, which is frozen at a release predating this module, so `gunbc serve --entry
// dag/gunbc/auth/approval_broker_serve.dag` could not resolve its own entry and systemd
// restart-looped the unit. The unit was correct; the bytes it was pointed at were not there.
//
// SCOPED DELIBERATELY NARROW (operator ruling 2026-09-20: "do not generalize it into a second
// tree-sync"). This is not a sync: no unit, no timer, no reconciliation, no drift detection. It is
// two source directories and one binary copied once, at install, from the checkout the dark install
// is running in -- the same $PWD the existing tree-publication step already names as GUNBC_TREE_SRC.
// What the broker needs to serve four routes is the .dag corpus, the v2 sources its closure reaches,
// and a binary that can interpret them.
//
// THE BINARY IS COPIED INTO A PER-CANDIDATE RELEASE LOCUS, AND THE PREVIOUS TWO NOTES HERE WERE
// BOTH WRONG IN OPPOSITE DIRECTIONS. The first asserted a copy the diff did not contain; the second
// corrected it to "shared, and that is a real open hazard" and left the hazard standing. The hazard
// was real: ExecStart took spec.approval_broker.serve_binary -- the instance's /opt/gunbc/bin/gunbc,
// which is the ROADMAP's binary, frozen at its release by operator ruling. A seed binary older than
// the sources it is handed refuses to parse constructs those sources use, and the broker's modules
// are newer than that binary by construction, so the unit would have started, refused at parse and
// restart-looped: the same symptom as the missing tree, from the other half of the pair.
//
// THE CANDIDATE BINARY WAS ALREADY ON THE HOST AND NOTHING WAS POINTING AT IT (operator ruling
// 2026-09-20). The dark-install job carries its OWN download and verify steps -- gunbc.ci_spec
// ci_release_bins_download_step and ci_release_bins_unpack_verify_step, listed by
// gunbc.fleet_converge_workflow fleet_converge_approval_broker_dark_install_job immediately before
// the install step -- so release-bins.tgz is unpacked into $ROOT/target/release and every member is
// put through claim_executor --verify-build-artifacts in this job, not inherited from some earlier
// one. That is what makes the copy source a verified artifact rather than a file that happens to be
// on disk: the verification and the copy are two steps of one job, and a failed verify stops the
// job before the install step runs.
//
// THE COPY IS LOCAL, AND THAT IS A PROPERTY OF THE TRANSPORT RATHER THAN A HOPE. The job runs on a
// self-hosted runner labelled with the dispatch's own host input, and gunbc.ci_deploy_access
// ci_deploy_srv1_access_or_refusal binds LocalShell -- so the script executes ON the target host,
// and "$PWD" is that job's checkout. The same fact is what makes the rsync above work; the binary
// copy is not reaching any further than the tree copy already does. Were the transport ever remote,
// both would break together and loudly, rather than this one silently copying a file that is not
// there.
// The copy source is that artifact; gunbc.ci_release_bins gunbc_release_bin_name is the row both
// the pack verification and this copy read, so the two spellings cannot drift.
//
// THE LOCUS IS PER-CANDIDATE AND IMMUTABLE, which is what makes the readback mean anything. Under a
// single mutable root, "the tree is the candidate" is a claim about what the last rsync did, and a
// redeploy of an older revision overwrites the evidence of the newer one in place. Under
// releases/<sha>/ the installed digest, the binary and the sources are one directory that either
// exists for this sha or does not, ExecStart names that directory, and /livez reporting the sha is
// a statement about a locus a reader can go and hash. Requested-equals-installed becomes decidable
// rather than asserted.
//
// WHAT THIS DELIBERATELY DOES NOT ADD: retention, garbage collection, a `current` symlink, or any
// reconciliation between release directories. Each is a real obligation and none is needed to
// observe one dark install; inventing a release-manager here would be the second tree-sync the
// operator ruled out, arriving under a different name. The unbounded growth is named rather than
// papered over -- see approval_broker_release_retention_note.
//
// UNBOUND REVISIONS REFUSE RATHER THAN NAMING A PATH. RevisionNotInstalled has no sha, so there is
// no directory it could mean; the path folds emit a poison marker that is not a valid path, which
// fails the stage loudly instead of installing a release into a directory literally named after a
// diagnostic (DESIGN section 5: refuse, never widen).
data approval_broker_release_retention_note: String = "The broker's release locus grows one directory per deployed candidate and nothing prunes it. Each holds the .dag corpus, the v2 sources and a gunbc binary. This is ACCEPTED for the cutover and is not a background obligation to be discovered later: retention is a policy question (how many releases must stay rollback-able, and against what) that has no answer until the broker has a rollback story, which it does not have while it is being stood up dark. It is bounded in practice by the number of dark installs the cutover performs. DISSOLVES WHEN the broker has a declared rollback target: at that point the number of releases that must survive is derivable from it, and a prune step belongs beside the install step reading that number -- never a timer reconciling the directory against a guess."

data approval_broker_release_dir_unbound_poison: String = "__GUNBC_DEPLOY_UNREACHABLE__ the approval broker release locus was asked for a path under RevisionNotInstalled. A release directory is named by the candidate sha, so there is no directory this could mean; emitting this marker fails the stage rather than installing a release into a path named after a diagnostic (DESIGN section 5)."

// THE ROOT IS THE SERVICE CONFIG'S, NOT host_layout's, READ DIRECTLY. Both name the same directory
// today, and reading the row here would still be correct -- but it would make the broker's root a
// fact this fold knows independently of the service it is emitting a unit for, so a deployment
// whose config named a different root would install its tree under one path and start its unit from
// another. The config is the parameter every other member of this unit comes from; the root is not
// an exception to that.
fn approval_broker_release_dir(root: String, revision: ReleaseRevisionBinding) -> String {
  match revision {
    RevisionBoundAtEmission { revision: r } => join([root, "/releases/", r as String], "")
    RevisionNotInstalled => approval_broker_release_dir_unbound_poison
  }
}

fn approval_broker_releases_dir(root: String) -> String {
  join([root, "/releases"], "")
}

fn approval_broker_release_binary_path(root: String, revision: ReleaseRevisionBinding) -> String {
  join([approval_broker_release_dir(root: root, revision: revision), "/", gunbc_release_bin_name], "")
}

fn approval_broker_tree_receipt_path_for(root: String, revision: ReleaseRevisionBinding) -> String {
  join([approval_broker_release_dir(root: root, revision: revision), "/.gunbc-tree-receipt"], "")
}

data approval_broker_tree_subdirs: List<String> = ["dag", "src/v2"]

// THE DIGEST IS OVER CONTENT, ORDER-INDEPENDENTLY, so two trees with the same bytes in the same
// paths agree regardless of how either was walked. sort -z before hashing is what makes that true:
// find's order is filesystem order and differs between the source and the copy, so hashing the
// concatenation without sorting would report a mismatch between identical trees -- a false refusal
// at the stage whose whole job is to say the tree IS the candidate.
// EVERY PROGRAM NAME HERE IS CONSUMED FROM THE MODULE THAT OWNS IT, not re-spelled (review 68927).
// The first cut minted "find", "sha256sum", "sort", "xargs" and "cut" as bare literals inside this
// join, which gave the digest relation a SECOND, POSITIONAL authority unreachable from the extdeps
// modules that own those tools -- the section 3 fork, and the section 2 test it fails is "net
// concepts must not grow by re-invention". find and xargs come from extdeps.tools.findutils
// (xargs ships with findutils, not coreutils), sort and cut from extdeps.tools.gnu_coreutils, and
// sha256sum from extdeps.crypto.hash. Two of those rows did not exist and were added to their
// OWNING modules rather than declared here, which is the difference between consuming an authority
// and minting a local one that happens to agree.
//
// 🟡 dissolve-on: this fold assembles shell SYNTAX -- a subshell, &&, and a pipeline -- as a string
// rather than emitting a Node through grammar rows, which is the medium-as-string shape. It
// dissolves when v2.workflow.bash_emit can render a piped command from modeled parts, at which
// point the program rows above become the arguments to that emitter instead of substrings of a
// join. The names are already correct by then; only the assembly changes.
// IT RETURNS THE PIPELINE, NOT A SUBSHELL, and the caller wraps it. The first cut returned
// "(cd ... | cut -d' ' -f1)" -- a BARE parenthesised group with no `$` -- and spliced it into
// printf's argument position, where `(` is a bash SYNTAX ERROR. With
// deploy_shell_strict_options_command at the head of the same script, that aborts the entire dark
// install before any step runs: not a wrong digest, no install at all (review 69066).
//
// It shipped because nothing ever rendered it. The only witness over this script asked
// string_contains for "rsync -a --delete" and the receipt path -- a SHAPE check over bytes nobody
// executed, which is DESIGN section 5's "a .contains() grep is not a consumer" exactly. The marker
// one declaration up names medium-as-string as a hazard; this is that hazard landing.
//
// Returning the pipeline and substituting at the use site also puts the quoting where a reader can
// see it: one "$( ... )" at the caller rather than parentheses buried in a join.
fn approval_broker_tree_digest_expr(root: String) -> String {
  join([
    "cd ", root, " && ", find_program as String, " ", join(approval_broker_tree_subdirs, " "),
    " -type f -print0 | ", sort_program as String, " -z | ",
    xargs_program as String, " -0 ", sha256sum_program as String, " | ",
    sha256sum_program as String, " | ", cut_program as String, " -d' ' -f1",
  ], "")
}

fn approval_broker_tree_copy_command(src_sub: String, root: String) -> String {
  join([
    "rsync -a --delete ", deployed_tree_rsync_exclude_flags(),
    " \"$PWD\"/", src_sub, "/ ", root, "/", src_sub, "/",
  ], "")
}

// THE RECEIPT IS WRITTEN BY THE COPY AND READ BY STAGE 2 -- and that second half was FALSE when
// this note was written (review 68965). The receipt was written and nothing read it, while this
// paragraph asserted the stage consumed it, so the only release evidence stage 2 actually had was
// the revision the process reports on /livez: a launch argument this emitter writes into ExecStart,
// echoed back whatever tree the unit loaded. The reader now exists
// (gunbc.auth.approval_broker_cutover observe_broker_tree_receipt, consumed by
// dark_install_release_discharged), which is what makes the sentence true rather than aspirational.
//
// WHAT IT ESTABLISHES, at its real strength: the copy for THIS candidate ran and recorded a digest,
// which a stale tree from an earlier deploy fails. What it does NOT yet establish is that the
// installed digest equals one computed independently over the deploying checkout -- that needs the
// source-side digest at readback time and is named as the open half beside the reader. Without it the only evidence is the revision
// the unit reports on /livez -- and that revision is a LAUNCH ARGUMENT this emitter wrote into
// ExecStart, so the process echoes whatever it was told regardless of which bytes it loaded. A
// control-plane fact standing in for the subject observation is the substitution
// gunbc.recurring_failure_mode control_plane_acknowledgement_minted_as_effect exists to refuse; the
// tree digest is the subject-side fact that closes it.
//
// ONLY THE INSTALLED DIGEST IS WRITTEN HERE, and that is a deliberate simplification over recording
// both sides. The first cut of this command computed the SOURCE digest too, inside the emitted
// shell, which meant a nested command substitution inside a printf inside an install -- four levels
// of quoting hand-escaped in a string literal, unverifiable without rendering, and a malformed
// quote fails the stage in a way that looks like a copy failure. The comparison does not need to
// happen in shell: the readback runs IN the deploying checkout, so it computes the source digest
// itself and compares against what it reads here. Shell reports one fact; the fold decides.
// ONE ROOT IN, BOTH PATHS DERIVED. An earlier cut of this took the release directory AND the broker
// root as separate parameters, which let a caller hand it a pair that did not correspond -- hash one
// release and write the receipt into another -- and made the release directory a fact two folds knew
// independently. The directory the digest covers and the directory the receipt lands in are the same
// directory by construction now, which is a stronger statement than any check over two arguments.
fn approval_broker_tree_receipt_command(base_root: String, revision: ReleaseRevisionBinding) -> String {
  join([
    printf_program as String, " 'candidate_revision=", release_revision_execstart_text(binding: revision),
    "\\ninstalled_digest=%s\\n' ",
    "\"$(", approval_broker_tree_digest_expr(root: approval_broker_release_dir(root: base_root, revision: revision)), ")\"",
    " | ", install_program as String, " -m 0644 /dev/stdin ",
    approval_broker_tree_receipt_path_for(root: base_root, revision: revision),
  ], "")
}

// THE BINARY IS INSTALLED BEFORE THE RECEIPT AND AFTER THE SOURCES, and the order is the only thing
// that makes a partially-installed locus distinguishable from a complete one. The receipt is the
// last write, so a locus carrying a receipt carries everything the receipt describes; a locus
// without one was interrupted. install -m 0755 rather than cp because the mode is part of what is
// being installed -- a binary copied without it starts nothing and the failure surfaces as a unit
// that will not exec, several steps from the copy that caused it.
//
// THE PROGRAM NAME IS CONSUMED, AND THIS FORK ARRIVED BY MERGE RATHER THAN BY AUTHORING. main
// minted extdeps.tools.gnu_coreutils install_program while this branch spelled "install" as a bare
// literal in two commands; neither side was wrong when written, and the moment they composed there
// were two spellings of one concept with only one of them reachable from the module that owns it.
// That is the same defect review 68927 raised against find/sort/xargs/cut here, arriving through a
// merge -- so it is repaired in the merge that creates it rather than left for the next reader to
// find, which is the whole reason a merge is a place to look for defects and not only a place to
// reconcile text.
//
// THE DIGEST COVERS THE SOURCES, NOT THE BINARY, and that is honest rather than an oversight: the
// binary's identity is established upstream by claim_executor --verify-build-artifacts in the same
// job, against the pack this deploy unpacked. Re-hashing it here would add a second authority for a
// fact already verified, while the sources -- which nothing else in the job checks -- are exactly
// what the receipt exists to pin.
fn approval_broker_binary_install_command(release_dir: String) -> String {
  join([
    install_program as String, " -m 0755 \"$PWD\"/target/release/", gunbc_release_bin_name, " ",
    release_dir, "/", gunbc_release_bin_name,
  ], "")
}

fn approval_broker_tree_copy_steps(spec: DeploymentSpec, revision: ReleaseRevisionBinding) -> List<PipelineStep> {
  release_locus_install_steps(
    owner: spec.service.service_user,
    copy: LocusCopiedByJobUser,
    base_root: spec.approval_broker.repo_root as String,
    revision: revision,
  )
}

// HOW THE TREE AND BINARY REACH THE LOCUS IS THE OWNER'S CONSEQUENCE, AND THE FIRST srv1 RUN OF THE
// ROOT-OWNED LOCUS IS WHAT SAID SO (fleet-converge run 35655377521: rsync as the job user into
// root-owned directories, `Permission denied`). The broker's locus is owned by the service user and
// the job user's unprivileged rsync populates it. A root-owned locus can only be populated by a
// privileged mover, and gunbc.ci_deploy_sudoers REFUSES the generic movers (rsync, chown) as sudo
// grants by design -- so the privileged copy is install(1), the one granted mover, ONE FILE AT A
// TIME: every directory `install -d -o root`, every file `install -m 0644 -o root` from the job's
// checkout, driven by find over the same subdirectories and never by a recursive tool root would
// have to trust. Slower than rsync by the sudo per file, and that is the price of a tree root
// execs that the job user cannot write.
type ReleaseLocusCopy
  = LocusCopiedByJobUser
  | LocusInstalledPrivilegedPerFile { owner: NonEmptyStr }

fn release_locus_tree_copy_steps(copy: ReleaseLocusCopy, root: String) -> List<PipelineStep> {
  match copy {
    LocusCopiedByJobUser =>
      map(approval_broker_tree_subdirs, sub =>
        deploy_raw(command: approval_broker_tree_copy_command(src_sub: sub, root: root))
      )
    LocusInstalledPrivilegedPerFile { owner: o } =>
      flat_map(approval_broker_tree_subdirs, sub => [
        deploy_raw(command: privileged_tree_directories_install_command(src_sub: sub, root: root, owner: o)),
        deploy_raw(command: privileged_tree_files_install_command(src_sub: sub, root: root, owner: o)),
      ])
  }
}

// 🟡 dissolve-on: the two commands below assemble a find | xargs pipeline as a string, the same
// medium-as-string shape approval_broker_tree_digest_expr names, and dissolve with it.
fn privileged_tree_directories_install_command(src_sub: String, root: String, owner: NonEmptyStr) -> String {
  join([
    "(cd \"$PWD\" && ", find_program as String, " ", src_sub, " -type d -print0) | ",
    xargs_program as String, " -0 -I{} ", join(sudo_elevate_argv(command: [
      install_program as String, "-d", "-m", "0755", "-o", owner as String, "-g", owner as String,
    ]), " "), " ", root, "/{}",
  ], "")
}

fn privileged_tree_files_install_command(src_sub: String, root: String, owner: NonEmptyStr) -> String {
  join([
    "(cd \"$PWD\" && ", find_program as String, " ", src_sub, " -type f -print0 | ", sort_program as String, " -z) | ",
    xargs_program as String, " -0 -I{} ", join(sudo_elevate_argv(command: [
      install_program as String, "-m", "0644", "-o", owner as String, "-g", owner as String,
    ]), " "), " \"$PWD\"/{} ", root, "/{}",
  ], "")
}

fn release_locus_binary_install_step(copy: ReleaseLocusCopy, root: String) -> PipelineStep {
  match copy {
    LocusCopiedByJobUser => deploy_raw(command: approval_broker_binary_install_command(release_dir: root))
    LocusInstalledPrivilegedPerFile { owner: o } =>
      deploy_raw(command: install_file_owned_command(
        mode: install_executable_shared_mode,
        owner: o,
        group: o,
        source: join(["\"$PWD\"/target/release/", gunbc_release_bin_name], ""),
        dest: join([root, "/", gunbc_release_bin_name], ""),
      ))
  }
}

// THE RELEASE LOCUS INSTALL, PARAMETERIZED BY OWNER AND BY ROOT AND BY NOTHING ELSE. The approval
// broker's per-candidate locus (releases/<sha>/ holding binary + sources + digest receipt, ExecStart
// pinned to it, requested-equals-installed decidable) and the microVM slot controller's are ONE
// concept -- the same download -> verify -> copy pair feeds both from the same verified artifact in
// the same job -- so the second consumer reuses these steps rather than mirroring them (parent
// ruling on the microVM lane, 2026-09-21: a second locus with the same shape is the section 3
// fork; 'the controller is root' is a difference in OWNER and CONSUMER, not in the locus). What
// differs is exactly the two parameters: who owns the directories, and which root they hang under.
// approval_broker_release_retention_note applies to every root this installs under; the microVM
// controller inherits that named obligation rather than re-declaring it.
fn release_locus_install_steps(owner: NonEmptyStr, copy: ReleaseLocusCopy, base_root: String, revision: ReleaseRevisionBinding) -> List<PipelineStep> {
  let root = approval_broker_release_dir(root: base_root, revision: revision)
  concat(
    concat(
      [
        deploy_raw(command: install_directory_command(mode: install_d_shared_mode, path: "/opt/gunbc", privileged: true)),
        deploy_raw(command: install_d_owned_for_user(user: owner, path: base_root)),
        deploy_raw(command: install_d_owned_for_user(user: owner, path: approval_broker_releases_dir(root: base_root))),
        deploy_raw(command: install_d_owned_for_user(user: owner, path: root)),
      ],
      map(approval_broker_tree_subdirs, sub =>
        deploy_raw(command: install_d_owned_for_user(user: owner, path: join([root, "/", sub], "")))
      ),
    ),
    concat(
      release_locus_tree_copy_steps(copy: copy, root: root),
      [
        release_locus_binary_install_step(copy: copy, root: root),
        release_locus_tree_receipt_step(copy: copy, base_root: base_root, revision: revision),
      ],
    ),
  )
}

// THE RECEIPT IS WRITTEN BY THE SAME PRINCIPAL THAT OWNS THE LOCUS: `install -m 0644 /dev/stdin`
// into a root-owned directory needs root, and the digest pipeline feeding it is the same either way.
fn release_locus_tree_receipt_step(copy: ReleaseLocusCopy, base_root: String, revision: ReleaseRevisionBinding) -> PipelineStep {
  match copy {
    LocusCopiedByJobUser => deploy_raw(command: approval_broker_tree_receipt_command(base_root: base_root, revision: revision))
    LocusInstalledPrivilegedPerFile { owner: o } =>
      deploy_raw(command: join([
        printf_program as String, " 'candidate_revision=", release_revision_execstart_text(binding: revision),
        "\\ninstalled_digest=%s\\n' ",
        "\"$(", approval_broker_tree_digest_expr(root: approval_broker_release_dir(root: base_root, revision: revision)), ")\"",
        " | ", join(sudo_elevate_argv(command: [install_program as String, "-m", "0644", "-o", o as String, "-g", o as String, "/dev/stdin",
          approval_broker_tree_receipt_path_for(root: base_root, revision: revision)]), " "),
      ], ""))
  }
}

// ── THE microVM SLOT CONTROLLER'S RELEASE LOCUS AND UNIT ──────────────────────────────────────
//
// THE SAME LOCUS, OWNED BY root, PLUS THE VMM AND THE JAILER. gunbc.runner_microvm_slot_unit owns
// the root, the owner and the unit's shape; this module owns the install because the locus is the
// live_deploy one. The two binaries the controller execs beside gunbc -- Firecracker and its jailer
// -- are installed INTO the locus from the upstream release tarball, digest-verified against
// extdeps.virtualization.firecracker's cited sha256 before extraction, as root-owned 0755 files.
// They were previously installed under the job user's HOME by gunbc.runner_microvm_host_ready
// (firecracker only; the jailer was never copied out of the archive), which is a job-user-writable
// binary that a root controller would exec -- the same class the slot-network frontier names for
// staged sources -- so the controller reads them from here and from nowhere else.
//
// THE RECEIPT NAMES BOTH DIGESTS beside the tree digest, so requested-equals-installed is decidable
// for the VMM as it is for the sources: a locus whose firecracker hashes differently from the
// cited release is not the release, whatever `--version` prints.
fn microvm_controller_release_dir(revision: ReleaseRevisionBinding) -> String {
  approval_broker_release_dir(root: microvm_controller_root, revision: revision)
}

// THE TARBALL IS STAGED UNDER THE JOB'S OWN CHECKOUT, beside the verified release bins it copies
// from, because the fetch and the extraction run as the job user and the locus is root's: the only
// privileged steps are the two installs into the locus, exactly as the gunbc binary's install is.
// The path is RELATIVE to the job's working directory (the checkout root, as "$PWD" is for the
// tree copy) and carries no variable, because digest_shell_verify_line single-quotes the path it
// checks and a "$PWD" inside single quotes would be verified as a literal.
data microvm_controller_stage_dir: String = "target/microvm-controller-stage"

fn microvm_controller_tarball_stage_path() -> String {
  join([microvm_controller_stage_dir, "/", firecracker_release_tarball_filename(rel: microvm_controller_firecracker_release)], "")
}

fn microvm_controller_vmm_receipt_path(revision: ReleaseRevisionBinding) -> String {
  join([microvm_controller_release_dir(revision: revision), "/.gunbc-vmm-receipt"], "")
}

fn microvm_controller_vmm_install_steps(revision: ReleaseRevisionBinding) -> List<PipelineStep> {
  let rel = microvm_controller_firecracker_release
  let dir = microvm_controller_release_dir(revision: revision)
  let stage = microvm_controller_tarball_stage_path()
  let extracted = microvm_controller_stage_dir
  [
    deploy_raw(command: join(argv_words(command: mkdir_parents_command(path: extracted)), " ")),
    deploy_raw(command: join(argv_words(command: curl_download_command(url: firecracker_release_download_url(rel: rel), destination: stage)), " ")),
    deploy_raw(command: digest_shell_verify_line(digest: sha256_digest(hex: firecracker_release_aarch64_tarball_sha256), file_path: stage as NonEmptyStr)),
    deploy_raw(command: join(argv_words(command: tar_extract_command(archive: stage, into_directory: extracted, strip_components: 0)), " ")),
    deploy_raw(command: install_file_owned_command(
      mode: install_executable_shared_mode,
      owner: microvm_controller_owner,
      group: microvm_controller_owner,
      source: join([extracted, "/", firecracker_release_binary_path_in_tarball(rel: rel)], ""),
      dest: microvm_controller_vmm_binary(release_dir: dir),
    )),
    deploy_raw(command: install_file_owned_command(
      mode: install_executable_shared_mode,
      owner: microvm_controller_owner,
      group: microvm_controller_owner,
      source: join([extracted, "/", firecracker_release_jailer_path_in_tarball(rel: rel)], ""),
      dest: microvm_controller_jailer_binary(release_dir: dir),
    )),
    deploy_raw(command: join([
      sha256sum_program as String, " ",
      microvm_controller_vmm_binary(release_dir: dir), " ",
      microvm_controller_jailer_binary(release_dir: dir),
      " | ", join(sudo_elevate_argv(command: [install_program as String, "-m", "0644", "-o", microvm_controller_owner as String, "-g", microvm_controller_owner as String, "/dev/stdin",
        microvm_controller_vmm_receipt_path(revision: revision)]), " "),
    ], "")),
  ]
}

fn microvm_slot_unit_write_steps(revision: ReleaseRevisionBinding) -> List<PipelineStep> {
  [
    deploy_raw(command: deploy_stage_write_command(
      stage_name: microvm_slot_unit_template_name as String,
      content: microvm_slot_unit_text(
        release_dir: microvm_controller_release_dir(revision: revision),
        timeout_stop_sec: microvm_slot_unit_timeout_stop_sec(),
      ),
    )),
    deploy_raw(command: deploy_stage_install_command(
      stage_name: microvm_slot_unit_template_name as String,
      mode: install_file_shared_mode,
      dest: microvm_slot_unit_path() as String,
    )),
  ]
}

// THE INSTALL IS ADDITIVE AND STARTS NOTHING: it writes the locus and the TEMPLATE unit and reloads
// the manager. An instance is started by the shakedown's own dispatch (systemctl start
// gunbc-microvm-slot@srv1-13), never by the deploy, because starting the controller IS running an
// attempt and an attempt is admitted by the readiness store and a reservation, not by a deploy.
fn microvm_controller_install_intent(revision: ReleaseRevisionBinding) -> Pipeline {
  Pipeline {
    steps: concat(
      concat(
        [deploy_raw(command: deploy_shell_strict_options_command), deploy_stage_directory_let_step()],
        concat(
          release_locus_install_steps(
            owner: microvm_controller_owner,
            copy: LocusInstalledPrivilegedPerFile { owner: microvm_controller_owner },
            base_root: microvm_controller_root,
            revision: revision,
          ),
          microvm_controller_vmm_install_steps(revision: revision),
        ),
      ),
      concat(microvm_slot_unit_write_steps(revision: revision), [deploy_effect(inv: systemctl_daemon_reload_effect())]),
    ),
    on_failure: FailFast,
  }
}

data microvm_controller_install_emit_refused_poison: String = "__GUNBC_DEPLOY_UNREACHABLE__ the microVM slot controller install pipeline did not emit; the stage refuses rather than running a partial script (DESIGN section 5)."

fn microvm_controller_install_script(revision: ReleaseRevisionBinding) -> String {
  emit_pipeline_or_poison(
    p: microvm_controller_install_intent(revision: revision),
    refused: microvm_controller_install_emit_refused_poison,
  )
}

fn approval_broker_unit_write_steps_on(
  spec: DeploymentSpec,
  revision: ReleaseRevisionBinding,
  port: Port,
) -> List<PipelineStep> {
  [
    deploy_raw(command: deploy_stage_write_command(
      stage_name: gunbc_approval_broker_slice_unit_name as String,
      content: render(doc: emit_approval_broker_slice_unit_doc(), proto: live_deploy_protocol),
    )),
    deploy_raw(command: deploy_stage_install_command(
      stage_name: gunbc_approval_broker_slice_unit_name as String,
      mode: install_file_shared_mode,
      dest: gunbc_approval_broker_slice_unit_path() as String,
    )),
    deploy_raw(command: deploy_stage_write_command(
      stage_name: gunbc_approval_broker_unit_name as String,
      content: render(doc: emit_approval_broker_unit_doc_on(spec: spec, revision: revision, port: port), proto: live_deploy_protocol),
    )),
    deploy_raw(command: deploy_stage_install_command(
      stage_name: gunbc_approval_broker_unit_name as String,
      mode: install_file_shared_mode,
      dest: gunbc_approval_broker_unit_path() as String,
    )),
  ]
}

fn emit_release_member_effects(member: ConvergedMember, plan: ReleaseEffectPlan, spec: DeploymentSpec) -> List<PipelineStep> {
  let revision = RevisionBoundAtEmission { revision: plan.target.revision }
  match member {
    TreePublication => if !plan_publishes_tree(plan: plan) { [] } else { [
      deploy_raw(command: install_directory_command(mode: install_d_shared_mode, path: "/opt/gunbc", privileged: true)),
      deploy_raw(command: install_d_owned_command(spec: spec, path: spec.service.repo_root as String)),
      deploy_raw(command: deploy_stage_write_expansion_command(
        stage_name: "gunbc-tree-sync.env",
        format: "GUNBC_TREE_SRC=%s\n",
        expansion_var: "PWD",
      )),
      deploy_raw(command: deploy_stage_install_command(
        stage_name: "gunbc-tree-sync.env",
        mode: install_file_shared_mode,
        dest: spec.names.tree_sync_env_path as String,
      )),
      deploy_raw(command: deploy_stage_write_command(
        stage_name: deployment_slice_unit_name(names: spec.names) as String,
        content: render(doc: emit_slice_unit_doc(spec: spec), proto: live_deploy_protocol),
      )),
      deploy_raw(command: deploy_stage_install_command(
        stage_name: deployment_slice_unit_name(names: spec.names) as String,
        mode: install_file_shared_mode,
        dest: deployment_slice_unit_path(names: spec.names) as String,
      )),
      deploy_raw(command: install_d_owned_command(
        spec: spec,
        path: instance_receipts_dir(instance_root: spec.service.instance_root as String),
      )),
      apply_repository_convergence_unit_write_step(spec: spec, revision: revision),
      deploy_raw(command: deploy_stage_install_command(
        stage_name: spec.names.tree_sync_unit_name as String,
        mode: install_file_shared_mode,
        dest: tree_sync_unit_path(names: spec.names) as String,
      )),
      deploy_effect(inv: systemctl_daemon_reload_effect()),
      tree_sync_restart_step_with_diagnosis(spec: spec),
      deploy_raw(command: repository_convergence_readback_command(spec: spec)),
    ] }
    Executable => if !plan_installs_executable(plan: plan) { [] } else { [
      deploy_raw(command: digest_shell_verify_line(digest: plan.target.executable, file_path: release_executable_install_source as NonEmptyStr)),
      deploy_raw(command: install_directory_command(
        mode: install_d_shared_mode,
        path: path_parent_dir(path: spec.service.serve_binary as String),
        privileged: true,
      )),
      deploy_raw(command: install_file_owned_command(
        mode: install_executable_shared_mode,
        owner: spec.service.service_user,
        group: spec.service.service_user,
        source: release_executable_install_source,
        dest: spec.service.serve_binary as String,
      )),
      deploy_raw(command: digest_shell_verify_line(digest: plan.target.executable, file_path: spec.service.serve_binary)),
      deploy_raw(command: install_d_owned_command(
        spec: spec,
        path: instance_receipts_dir(instance_root: spec.service.instance_root as String),
      )),
    ] }
    UnitFile => concat(
      if !plan_writes_unit(plan: plan) { [] } else { concat([
        apply_systemd_unit_write_step(spec: spec, revision: revision),
        deploy_raw(command: deploy_stage_install_command(
          stage_name: spec.service.unit_name as String,
          mode: install_file_shared_mode,
          dest: deployment_systemd_unit_path(names: spec.names) as String,
        )),
      ], apply_approval_broker_unit_write_steps(spec: spec, revision: revision)) },
      concat(
        if !plan_reloads_manager(plan: plan) { [] } else { [deploy_effect(inv: systemctl_daemon_reload_effect())] },
        if !plan_restarts_process(plan: plan) { [] } else { concat([
          deploy_effect(inv: systemctl_enable_effect(unit: plan.target.unit)),
          deploy_effect(inv: systemctl_restart_effect(unit: plan.target.unit)),
        ], approval_broker_lifecycle_steps(spec: spec)) },
      ),
    )
    UnitManager => []
    ServiceProcess => []
    DirectoryRoot { path: _ } => []
  }
}

// The deploying checkout's build, the one source the install copies from; the same path the planner
// digests (gunbc.live_deploy.member_observe release_executable_source_path) so the verification
// line above and the planned identity name one file.
data release_executable_install_source: String = "target/release/gunbc"

fn emit_artifact_upsert(art: DeploymentArtifactStep, spec: DeploymentSpec, revision: ReleaseRevisionBinding) -> List<PipelineStep> {
  match art.kind {
    GunbcSourceTree => [
      deploy_raw(command: install_directory_command(mode: install_d_shared_mode, path: "/opt/gunbc", privileged: true)),
      deploy_raw(command: install_d_owned_command(spec: spec, path: art.path as String)),
      deploy_raw(command: deploy_stage_write_expansion_command(
        stage_name: "gunbc-tree-sync.env",
        format: "GUNBC_TREE_SRC=%s\n",
        expansion_var: "PWD",
      )),
      deploy_raw(command: deploy_stage_install_command(
        stage_name: "gunbc-tree-sync.env",
        mode: install_file_shared_mode,
        dest: spec.names.tree_sync_env_path as String,
      )),
      deploy_raw(command: deploy_stage_write_command(
        stage_name: deployment_slice_unit_name(names: spec.names) as String,
        content: render(doc: emit_slice_unit_doc(spec: spec), proto: live_deploy_protocol),
      )),
      deploy_raw(command: deploy_stage_install_command(
        stage_name: deployment_slice_unit_name(names: spec.names) as String,
        mode: install_file_shared_mode,
        dest: deployment_slice_unit_path(names: spec.names) as String,
      )),
      deploy_effect(inv: systemctl_daemon_reload_effect()),
    ]
    ServeBinary => [
      deploy_raw(command: install_directory_command(
        mode: install_d_shared_mode,
        path: path_parent_dir(path: art.path as String),
        privileged: true,
      )),
      deploy_raw(command: install_file_owned_command(
        mode: install_executable_shared_mode,
        owner: spec.service.service_user,
        group: spec.service.service_user,
        source: "target/release/gunbc",
        dest: art.path as String,
      )),
      deploy_raw(command: install_d_owned_command(
        spec: spec,
        path: instance_receipts_dir(instance_root: spec.service.instance_root as String),
      )),
      apply_repository_convergence_unit_write_step(spec: spec, revision: revision),
      deploy_raw(command: deploy_stage_install_command(
        stage_name: spec.names.tree_sync_unit_name as String,
        mode: install_file_shared_mode,
        dest: tree_sync_unit_path(names: spec.names) as String,
      )),
      deploy_effect(inv: systemctl_daemon_reload_effect()),
      tree_sync_restart_step_with_diagnosis(spec: spec),
      deploy_raw(command: repository_convergence_readback_command(spec: spec)),
    ]
    DispatchWorktreeRoot => [
      deploy_raw(command: install_d_owned_command(spec: spec, path: art.path as String)),
    ]
    AttemptStateRoot => [
      deploy_raw(command: install_d_managed_command(
        dir: attempt_state_directory_at(path: art.path as String as FilePath),
      )),
    ]
    ComputeRoot => [
      deploy_raw(command: install_d_owned_command(spec: spec, path: art.path as String)),
    ]
    SystemdUnit => concat(concat([
      apply_systemd_unit_write_step(spec: spec, revision: revision),
      deploy_raw(command: deploy_stage_install_command(
        stage_name: spec.service.unit_name as String,
        mode: install_file_shared_mode,
        dest: art.path as String,
      )),
    ], apply_approval_broker_unit_write_steps(spec: spec, revision: revision)), concat([
      deploy_effect(inv: systemctl_daemon_reload_effect()),
      deploy_effect(inv: systemctl_enable_effect(unit: spec.service.unit_name)),
      deploy_effect(inv: systemctl_restart_effect(unit: spec.service.unit_name)),
    ], approval_broker_lifecycle_steps(spec: spec)))
    PublicationHelperTimerUnit => concat(
      apply_publication_spool_steps(spec: spec),
      [
        apply_publication_service_unit_write_step(spec: spec),
        apply_publication_timer_unit_write_step(spec: spec),
        deploy_raw(command: deploy_stage_install_command(
          stage_name: deployment_publication_service_unit_name(names: spec.names) as String,
          mode: install_file_shared_mode,
          dest: deployment_publication_service_unit_path(names: spec.names) as String,
        )),
        deploy_raw(command: deploy_stage_install_command(
          stage_name: deployment_publication_timer_unit_name(names: spec.names) as String,
          mode: install_file_shared_mode,
          dest: art.path as String,
        )),
        deploy_effect(inv: systemctl_daemon_reload_effect()),
        deploy_effect(inv: systemctl_enable_effect(unit: deployment_publication_timer_unit_name(names: spec.names))),
        deploy_effect(inv: systemctl_restart_effect(unit: deployment_publication_timer_unit_name(names: spec.names))),
      ]
    )
    BeltTimerUnit => [
      deploy_raw(command: install_d_owned_command(
        spec: spec,
        path: instance_receipts_dir(instance_root: spec.service.instance_root as String),
      )),
      apply_belt_service_unit_write_step(spec: spec),
      apply_belt_timer_unit_write_step(spec: spec),
      deploy_raw(command: deploy_stage_install_command(
        stage_name: deployment_belt_service_unit_name(names: spec.names) as String,
        mode: install_file_shared_mode,
        dest: deployment_belt_service_unit_path(names: spec.names) as String,
      )),
      deploy_raw(command: deploy_stage_install_command(
        stage_name: deployment_belt_timer_unit_name(names: spec.names) as String,
        mode: install_file_shared_mode,
        dest: art.path as String,
      )),
      deploy_effect(inv: systemctl_daemon_reload_effect()),
      deploy_effect(inv: systemctl_enable_effect(unit: deployment_belt_timer_unit_name(names: spec.names))),
      deploy_effect(inv: systemctl_restart_effect(unit: deployment_belt_timer_unit_name(names: spec.names))),
    ]
    FleetConvergeTimerUnit => [
      deploy_raw(command: "__GUNBC_FLEET_CONVERGE_REFUSED__ FleetConvergeTimerUnit retired from deployment membership — timer cadence is on-demand via fleet-converge.yml plan/apply, not live_deploy apply (sleek-heron-218)"),
    ]
    TailscaleServeMapping => [
      tailscale_serve_apply_step(spec: spec),
    ]
    FabricStorageServeUnit => [
      apply_fabric_storage_unit_write_step(spec: spec, revision: revision),
      deploy_raw(command: deploy_stage_install_command(
        stage_name: deployment_fabric_storage_unit_name(names: spec.names) as String,
        mode: install_file_shared_mode,
        dest: art.path as String,
      )),
      deploy_effect(inv: systemctl_daemon_reload_effect()),
      deploy_effect(inv: systemctl_enable_effect(unit: deployment_fabric_storage_unit_name(names: spec.names))),
      deploy_effect(inv: systemctl_restart_effect(unit: deployment_fabric_storage_unit_name(names: spec.names))),
    ]
    FabricStorageServeMapping => [
      deploy_raw(command: shell_privileged_command_text_of_argv(
        argv: concat(["tailscale"], tailscale_serve_enable_argv(endpoint: deployment_fabric_storage_serve_endpoint())),
      )),
    ]
    DeployedTreeRemoteUnit => [
      apply_tree_remote_unit_write_step(spec: spec),
      deploy_raw(command: deploy_stage_install_command(
        stage_name: deployment_tree_remote_unit_name(names: spec.names) as String,
        mode: install_file_shared_mode,
        dest: art.path as String,
      )),
      deploy_effect(inv: systemctl_daemon_reload_effect()),
      deploy_effect(inv: systemctl_restart_effect(unit: deployment_tree_remote_unit_name(names: spec.names))),
    ]
  }
}

// REALIZATION FOR THE BUILD SERVICE'S ARTIFACT STORE, which is an ENSURED host directory rather
// than an owned artifact, and the difference is the whole safety content. Ensured means converged
// on every apply and never torn down; owned means removed by retract. Produced artifacts are
// precisely what a deploy must never delete, so the owned category was wrong -- and it was not
// wrong in the abstract: with the root on every per-instance spec, a lab twin's retract would have
// removed the production store, which is what the twin disjointness claims caught.\n\nTHE DEPLOY
// ENSURES THE DIRECTORY; THE SERVICE MAKES IT A REPOSITORY. That split is forced rather than
// chosen. The deploy principal's sudo roster grants exactly six commands -- apt-get, install,
// visudo, systemctl, tailscale, rm -- and git is not among them, so a `sudo -n -u <service> git
// init --bare` step would be refused by sudoers and would red every deploy of this host. An earlier
// revision emitted precisely that line. `install -d` is granted and idempotent, so the deploy
// converges ownership and existence; `git init --bare` is idempotent by upstream contract and runs
// as the account that owns the directory, so no privilege boundary is crossed and no grant needs
// widening.\n\nTHERE IS NO TEARDOWN ARM, and its absence is the point rather than an omission. An
// ensured resource reaches EffectRemove only through the R5 wall breach poison, so a retract cannot
// remove this store even by mistake -- the property the previous `rm -d` arm tried to approximate
// by refusing on a non-empty directory is now structural, and the awkward consequence that arm
// carried (a full retract could never complete once the store existed) simply does not arise.
// DispatchWorktreeRoot teardown is rm -d (empty-directory removal via the granted rm — the
// unprivileged principal has no rmdir grant and no write on the root-owned parent), NEVER rm -rf: a
// non-empty worktree root means live agent worktrees exist, so the retract FAILS LOUDLY there
// instead of silently destroying sessions (DESIGN 5 — the refusal is the empty-dir precondition
// itself, identical to the former rmdir). GunbcSourceTree teardown runs AFTER the worktree rm -d
// succeeds, so the repo the worktrees are registered in is never deleted from under them.

fn emit_artifact_teardown(art: DeploymentArtifactStep, spec: DeploymentSpec) -> List<PipelineStep> {
  match art.kind {
    TailscaleServeMapping => [
      tailscale_serve_teardown_step(spec: spec),
    ]
    FabricStorageServeMapping => [
      deploy_raw(command: shell_privileged_command_text_of_argv(
        argv: concat(["tailscale"], tailscale_serve_off_argv(endpoint: deployment_fabric_storage_serve_endpoint())),
      )),
    ]
    FabricStorageServeUnit => concat(
      systemctl_disable_now_if_present_steps(unit: deployment_fabric_storage_unit_name(names: spec.names), privileged: true),
      [
        deploy_raw(command: gunbc.live_deploy.operations.rm_force_command(paths: [art.path as String])),
        deploy_effect(inv: systemctl_daemon_reload_effect()),
      ]
    )
    SystemdUnit => concat(
      systemctl_disable_now_if_present_steps(unit: spec.service.unit_name, privileged: true),
      [
        deploy_raw(command: gunbc.live_deploy.operations.rm_force_command(paths: [art.path as String])),
        deploy_effect(inv: systemctl_daemon_reload_effect()),
      ]
    )
    BeltTimerUnit => concat(
      systemctl_disable_now_if_present_steps(unit: deployment_belt_timer_unit_name(names: spec.names), privileged: true),
      [
        deploy_raw(command: gunbc.live_deploy.operations.rm_force_command(paths: [
          art.path as String,
          deployment_belt_service_unit_path(names: spec.names) as String,
        ])),
        deploy_effect(inv: systemctl_daemon_reload_effect()),
      ]
    )
    FleetConvergeTimerUnit => concat(
      systemctl_disable_now_if_present_steps(unit: deployment_fleet_converge_timer_unit_name(names: spec.names), privileged: true),
      [
        deploy_raw(command: gunbc.live_deploy.operations.rm_force_command(paths: [
          art.path as String,
          deployment_fleet_converge_service_unit_path(names: spec.names) as String,
        ])),
        deploy_effect(inv: systemctl_daemon_reload_effect()),
      ]
    )
    PublicationHelperTimerUnit => concat(
      systemctl_disable_now_if_present_steps(unit: deployment_publication_timer_unit_name(names: spec.names), privileged: true),
      [
        deploy_raw(command: gunbc.live_deploy.operations.rm_force_command(paths: [
          art.path as String,
          deployment_publication_service_unit_path(names: spec.names) as String,
        ])),
        deploy_effect(inv: systemctl_daemon_reload_effect()),
      ]
    )
    DeployedTreeRemoteUnit => concat(
      systemctl_disable_now_if_present_steps(unit: deployment_tree_remote_unit_name(names: spec.names), privileged: true),
      [
        deploy_raw(command: gunbc.live_deploy.operations.rm_force_command(paths: [art.path as String])),
        deploy_effect(inv: systemctl_daemon_reload_effect()),
      ]
    )
    DispatchWorktreeRoot => [
      deploy_raw(command: rm_empty_directory_command(path: art.path as String)),
    ]
    AttemptStateRoot => [
      deploy_raw(command: rm_empty_directory_command(path: art.path as String)),
    ]
    ComputeRoot => [
      deploy_raw(command: rm_force_recursive_command(path: art.path as String)),
    ]
    ServeBinary => [
      deploy_raw(command: gunbc.live_deploy.operations.rm_force_command(paths: [art.path as String])),
    ]
    GunbcSourceTree => [
      deploy_raw(command: gunbc.live_deploy.operations.rm_force_command(paths: [
        tree_sync_unit_path(names: spec.names) as String,
        spec.names.tree_sync_env_path as String,
        deployment_slice_unit_path(names: spec.names) as String,
      ])),
      deploy_effect(inv: systemctl_daemon_reload_effect()),
      deploy_raw(command: rm_force_recursive_command(path: art.path as String)),
    ]
  }
}

// The per-member realization HANDLER: share the DIFF (membership_reconcile), dispatch the APPLY
// (this). One handler for both fold directions — EffectAdd dispatches on member kind to the
// artifact/dependency install fragments; EffectRemove to the removal fragments. Orchestration is
// DERIVED from the effect kind, not an always-on envelope: a SystemdUnit upsert carries its own
// daemon-reload/enable/restart (once, part of the unit's realization); ServerScript carries the
// /opt/gunbc install -d it writes into. MemberEffect is a bidirectional sum, so each POLE has one
// structurally-unreachable direction (apply never Remove, retract never Add) — those ARE reached
// across the two poles combined. TWO arms are unreachable across BOTH poles. EffectRemove of a
// Dependency: a dependency is Ensured, so a Removed dependency is MemberRemovalRefused, never an
// EffectRemove. And EffectReplace in either direction: both poles are DEGENERATE (apply observes
// nothing, retract desires nothing), so neither can produce a Modified hunk at all — a replace here
// would mean a pole stopped being degenerate, which is a real observed-provider arriving and needs
// its staged-replacement intermediates declared (gunbc.change_realization) before it may emit
// anything. That arm REFUSES loudly (emit_deploy_teardown_dependency_refusal — a typed/located
// poison step), it does NOT fabricate a no-op (DESIGN §5: an unreachable arm refuses, never a
// silent pass).
data live_deploy_replace_unreachable_poison: String = "__GUNBC_DEPLOY_UNREACHABLE__ EffectReplace reached the deploy emit dispatch. Both deploy poles are degenerate — apply observes the empty set, retract desires the empty set — so no Modified hunk can arise and no replace can be emitted. Reaching this arm means a NON-degenerate observed provider landed without its realization being modeled: a replace on a host resource is an in-place update only if the address survived, and a STAGED replacement with declared intermediates otherwise (gunbc.change_realization). Emitting an unconditional overwrite here would be the srv4 failure exactly — a transition that believed it had nothing to retire. This marker is not valid deploy shell, so the golden drift gate reds. member="

fn emit_deploy_replace_unreachable_refusal(step: DeploymentStep) -> List<PipelineStep> {
  [deploy_raw(command: concat(live_deploy_replace_unreachable_poison, deployment_step_key(step: step) as String))]
}

data live_deploy_teardown_dependency_unreachable_poison: String = "__GUNBC_DEPLOY_UNREACHABLE__ R5 wall breach — EffectRemove of an Ensured dependency reached the emit dispatch. A dependency is Ensured, so a Removed dependency is MemberRemovalRefused (never an EffectRemove); reaching this arm means deployment_step_ownership or membership_effects is broken. This marker is not valid deploy shell, so the golden drift gate reds — DESIGN §5: an unreachable arm REFUSES loudly (typed/located/counted), never fabricates a no-op. dependency="

fn emit_deploy_teardown_dependency_refusal(dep: DeploymentDependencyStep) -> List<PipelineStep> {
  [deploy_raw(command: concat(live_deploy_teardown_dependency_unreachable_poison, ensured_subject_identity(subject: dep.subject) as String))]
}

fn emit_deploy_member_effect(effect: MemberEffect<DeploymentStep>, spec: DeploymentSpec, revision: ReleaseRevisionBinding) -> List<PipelineStep> {
  match effect {
    EffectAdd { to: step } =>
      match step {
        Dependency { step: dep } => ensure_dependency_steps(dep: dep, privileged: true)
        ArtifactStep { step: art } => emit_artifact_upsert(art: art, spec: spec, revision: revision)
      }
    EffectReplace { from: _, to: step } => emit_deploy_replace_unreachable_refusal(step: step)
    EffectRemove { from: step } =>
      match step {
        ArtifactStep { step: art } => emit_artifact_teardown(art: art, spec: spec)
        Dependency { step: dep } => emit_deploy_teardown_dependency_refusal(dep: dep)
      }
  }
}

// THE TRAP LINE IS STILL A STRING, AND IT IS THE ONLY REMAINING ONE IN EITHER PREAMBLE.
// v2.extdeps.languages.bash_build has no trap node and PipelineStep has no trap variant, so
// there is nothing to build it from. It is left as authored text rather than approximated:
// every nearby shape (a Do-run of `trap`, a subshell) either re-assembles the same quoting by
// hand or changes what the trap does. Adding the grammar row is the fix and it is out of this
// PR's scope; naming the gap here is what keeps the next reader from reaching for the
// approximation. See also the brace-group gap at tree_sync_restart_step_with_diagnosis.
fn member_effect_step(e: MemberEffect<DeploymentStep>) -> DeploymentStep {
  match e {
    EffectAdd { to } => to
    EffectReplace { from: _, to } => to
    EffectRemove { from } => from
  }
}

// EVERY STEP OF THE DEPLOYMENT, IN THE DEPLOYMENT'S ORDER, PROJECTED TO ITS EFFECTS. An identity
// member's step projects to the release plan's fragments for that member (possibly none); every other
// step projects to the membership effects the apply-all reconcile derived for its key. The order is
// therefore spec.steps' order -- gunbc.live_deploy.spec deployment_steps_apply_order, the one
// authority -- and this function adds no ordering of its own.
// A ROOT THE PLAN DOES NOT COVER IS EMITTED, NOT SKIPPED. MemberNotInPlan means the plan makes no
// claim about the member -- not that it decided to keep it -- so the only safe reading is the one
// the apply-all era used. Skipping on absent knowledge is how the roots silently stopped being
// provisioned when the canonical plans covered a smaller roster than the emitter walked.
fn apply_step_effects(
  step: DeploymentStep,
  effects: List<MemberEffect<DeploymentStep>>,
  spec: DeploymentSpec,
  plan: ReleaseEffectPlan,
) -> List<PipelineStep> {
  match identity_member_of_step(step: step) {
    Present { value: member } => match member {
      DirectoryRoot { path: _ } => match plan_mutation_of(plan: plan, member: member) {
        MemberNotInPlan => step_membership_effects(step: step, effects: effects, spec: spec, plan: plan)
        MutationInPlan { mutation } =>
          if mutation_is_keep(e: mutation) { [] }
          else { step_membership_effects(step: step, effects: effects, spec: spec, plan: plan) }
      }
      _ => emit_release_member_effects(member: member, plan: plan, spec: spec)
    }
    Absent => step_membership_effects(step: step, effects: effects, spec: spec, plan: plan)
  }
}

// THE STEP'S OWN EMISSION, unchanged from the apply-all era. A step whose kind names no converged
// member still renders exactly what it always did; a root renders it only when its identity says so.
fn step_membership_effects(
  step: DeploymentStep,
  effects: List<MemberEffect<DeploymentStep>>,
  spec: DeploymentSpec,
  plan: ReleaseEffectPlan,
) -> List<PipelineStep> {
  flat_map(
    filter(effects, e => deployment_step_key_eq(a: deployment_step_key(step: member_effect_step(e: e)), b: deployment_step_key(step: step))),
    e => emit_deploy_member_effect(effect: e, spec: spec, revision: RevisionBoundAtEmission { revision: plan.target.revision }),
  )
}

// THE CAP AUTHORIZATION IS A PARAMETER ALL THE WAY UP, NOT A DEFAULT BURIED AT THE BOTTOM.
//
// An earlier revision hardcoded `CapConvergeWithheld` inside this function. That was safe and
// INVISIBLE: a reader of the deploy boundary could not tell that cap application was gated, and
// whoever eventually wires a live observation had no compiler-enforced place to put it. Threading
// the decision to the boundary makes the gap a signature rather than a comment -- the withheld
// default now lives at exactly one visible call site, and supplying a real decision means changing
// an argument rather than finding a literal.
// THE APPLY FOLD'S TAIL, DECLARED ONCE SO A CLAIM CAN READ IT WITHOUT RENDERING THE PROGRAM.
//
// The convergence receipt is the last thing the apply emits and it is FRAME rather than step: it is
// appended after the per-step effects, so a projection over `spec.steps` cannot see it. The claim
// that the apply emits a receipt for THIS host under THIS fold therefore had no cheap seam, and
// asserting it meant rendering the whole program. Naming the tail gives it one, and the assertion
// stays discriminating rather than tautological: the host and the fold are derived independently on
// the reading side, so a tail built for the wrong host, or labelled `retract`, still reds.
fn deploy_apply_receipt_steps(spec: DeploymentSpec) -> List<PipelineStep> {
  [deploy_raw(command: deploy_receipt_command(host: spec.target.host.identity, fold: "apply"))]
}

fn apply_intent_from_effects(
  spec: DeploymentSpec,
  effects: List<MemberEffect<DeploymentStep>>,
  access: DeployAccess,
  plan: ReleaseEffectPlan,
  cap_authorization: CapConvergeDecision,
) -> Pipeline {
  Pipeline {
    steps: concat(
      [
        deploy_raw(command: deploy_shell_strict_options_command),
        Comment { text: concat("GENERATED APPLY by dag/gunbc/live_deploy/emit.dag host=", spec.target.host.identity as String) },
        Comment { text: "Principal: job_user=ghrunner (DeployRunnerPrincipal.job_user). unit_user=root is NOT the deploy principal." },
        Comment { text: "Mutation rides six sudo -n grants (roster incl. visudo); tree sync AS service user via gunbc-tree-sync.service." },
        Comment { text: "Wave C envelope: typed deploy-access gate runs before this HostReconciler artifact; roster sudoers install precedes mutation." },
        deploy_stage_directory_let_step(),
        deploy_raw(command: "trap 'rm -rf \"$_gunbc_stage\"' EXIT"),
      ],
      concat(
        deploy_apply_preamble_steps(access: access, spec: spec),
        concat(
          deploy_memory_cap_apply_steps(spec: spec, authorization: cap_authorization),
          concat(
            flat_map(spec.steps, step => apply_step_effects(step: step, effects: effects, spec: spec, plan: plan)),
            deploy_apply_receipt_steps(spec: spec)
          )
        )
      )
    ),
    on_failure: FailFast
  }
}

// THE PARTITION THAT PROTECTED SIBLING TEARDOWNS IS DELETED BECAUSE ITS SUBJECT IS GONE. review
// 45016 found that a refusal arm ending in `false` aborted the whole fail-fast retract at the FIRST
// teardown, so the unit, worktree root, serve binary, tree-sync files and repo tree were never
// removed — every retract, production and twin, tore down nothing. The repair sorted refusing
// teardowns after acting ones, which was correct for the model as it then stood.\n\nThat model was
// wrong one layer up. The only refusing owned artifact was TailscaleServeMapping, and it refused on
// an uncited claim that the CLI has no scoped removal. With the endpoint modeled, its teardown
// ACTS, and no owned artifact refuses — so the partition sorts a list by a predicate that is now
// constant, which is a node whose validation cannot fail.\n\nThe class it guarded is closed
// differently and more strongly: a retract for a host whose client cannot do scoped removal is not
// EMITTED at all (retract_capability_refusal), so a stop-the-line arm cannot appear among the
// teardowns in the first place, and there is no ordering left to get right. Keeping the partition
// would preserve the shape of a fix for a defect that no longer has a way to occur, which is
// exactly the dead-scaffold class.
fn retract_unsupported_client_poison(observed: String) -> String {
  concat(
    "__GUNBC_DEPLOY_REFUSED__ live-deploy retract NOT EMITTED: this target's tailscale client is ",
    concat(
      observed,
      ", below the 1.52 release that introduced scoped `serve <flags> off`. Removing the serve mapping would require the node-global reset, which destroys every other deployment's routing on this host — so no retract artifact is produced (DESIGN 5: refuse, never widen)",
    ),
  )
}

fn retract_unobserved_client_poison(reason: String) -> String {
  concat(
    "__GUNBC_DEPLOY_REFUSED__ live-deploy retract NOT EMITTED: this target's tailscale client version is UNOBSERVED (",
    concat(
      reason,
      "), so whether scoped `serve <flags> off` exists on it is unknown. An unobserved version is not a capable one; observe the client and record it on the target (DESIGN 5: refuse, never widen)",
    ),
  )
}


// THE RETRACT FRAME'S COMMENT BLOCK, DECLARED ONCE SO A CLAIM CAN READ IT WITHOUT RENDERING THE
// WHOLE PROGRAM.
//
// These six lines are the only place the retract fold explains itself to whoever reads the emitted
// script -- that ensured dependencies are deliberately not purged, that retract may itself be the
// run that installs the sudoers drop-in, and that the worktree teardown is the empty-dir refusal
// wall rather than a recursive delete. `witness_retract_preamble_acknowledges_shared_sudoers_install`
// asserts on the fourth of them, and asserting on it used to mean rendering the entire retract
// program: 86,034 eval steps against a per-claim ceiling of 72,300 (required floor run 34927164902).
// Naming the block makes the same fact readable at its producer.
fn deploy_retract_frame_comments(spec: DeploymentSpec) -> List<PipelineStep> {
  [
  Comment { text: concat("GENERATED RETRACT by dag/gunbc/live_deploy/emit.dag host=", spec.target.host.identity as String) },
  Comment { text: "owned-artifacts only — ensured deps (tailscale, tmux) intentionally NOT purged" },
  Comment { text: "Wave C envelope: typed deploy-access gate runs before this HostReconciler artifact; retract also installs/refreshes" },
  Comment { text: "/etc/sudoers.d/gunbc-deploy (idempotent; first retract-after-flip may be the dropin install)." },
  Comment { text: "Principal: UNPRIVILEGED ci-runner. dispatch-worktrees teardown is rm -d (granted rm," },
  Comment { text: "empty-dir only): live worktrees fail it LOUDLY — the same empty-dir refusal wall." },
  ]
}
fn retract_intent_from_effects(
  spec: DeploymentSpec,
  effects: List<MemberEffect<DeploymentStep>>,
  access: DeployAccess
) -> Pipeline {
  Pipeline {
    steps: concat(
      concat(
        [deploy_raw(command: deploy_shell_strict_options_command)],
        concat(
          deploy_retract_frame_comments(spec: spec),
          [
            deploy_stage_directory_let_step(),
            deploy_raw(command: "trap 'rm -rf \"$_gunbc_stage\"' EXIT"),
          ]
        )
      ),
      concat(
        deploy_apply_preamble_steps(access: access, spec: spec),
        concat(
          flat_map(
            effects,
            e => emit_deploy_member_effect(effect: e, spec: spec, revision: RevisionNotInstalled),
          ),
          [
            deploy_raw(command: deploy_receipt_command(host: spec.target.host.identity, fold: "retract")),
          ]
        )
      )
    ),
    on_failure: FailFast
  }
}

data live_deploy_wholesale_refused_poison_prefix: String = "__GUNBC_DEPLOY_REFUSED__ live-deploy reconcile refused WHOLESALE — the plan carried member teardown-refusals (a member the deploy does not own, or ownership unknown). Per the wholesale-refuse execution policy (gunbc.membership_reconcile.membership_effects_wholesale_refuse_policy_trigger) the ENTIRE fold is refused before emit rather than partially applied — R5 owned-only teardown is a construction wall, never emit-around. This marker is not valid deploy shell, so the committed golden drift gate reds (DESIGN §5: refuse, never widen). "

fn live_deploy_wholesale_refused_poison(refusals: List<MemberRefusal<DeploymentStep>>, fold_label: String) -> String {
  concat(
    live_deploy_wholesale_refused_poison_prefix,
    concat(fold_label, concat(" refused-member-count=", to_string(count(refusals))))
  )
}

// ── THE ADDITIVE BROKER INSTALL: STAGE 1 OF THE CUTOVER ─────────────────────────────────────
// IT TOUCHES gunbc-roadmap.service AND NOTHING IT DEPENDS ON, WHICH IS THE WHOLE REQUIREMENT
// (operator directive 2026-09-19: roadmap redeploys are FROZEN at the current release until the
// cutover completes). The ordinary apply path installs the broker beside the roadmap unit, and it
// also reloads the manager and RESTARTS the roadmap -- correct for a release deploy, and exactly
// wrong for a stage that is supposed to add a process without disturbing the one already serving.
//
// So stage 1 has its own intent: write the broker's slice, write its unit on its one port, reload
// the manager, enable and start ONLY gunbc-approval-broker.service. A daemon-reload does not
// restart running units, so the roadmap keeps its PID and its incarnation across this.
//
// IT IS A MODELED PIPELINE, NOT A HAND SCRIPT. DESIGN section 6 files a hand-authored deployment
// script as out-of-band actuation; what makes this the other thing is that every command in it is
// the same projection of the same unit value the byte oracles pin and the cutover plan reasons
// about, so "what did stage 1 install" is answerable from the model rather than from a terminal
// transcript.
//
// IT BINDS THE BROKER'S ONE PORT, the same one every later stage observes (side-chat HOLD item 1).
// This stage and the ordinary release apply therefore write the SAME placement, which is what lets
// the release readback, the MainPID and the measured demand taken here describe the process that
// later serves. What makes this stage DARK is not the address: nothing routes the public paths to
// the broker yet (gunbc.auth.approval_broker_cutover approval_route_ownership) and the broker does
// not hold the store (gunbc.auth.approval_writer_authority), so a loopback client that finds the
// port is REFUSED rather than merely unlikely to look.
fn approval_broker_dark_install_intent(
  spec: DeploymentSpec,
  revision: ReleaseRevisionBinding,
) -> Pipeline {
  Pipeline {
    steps: concat(
      concat(
        [deploy_raw(command: deploy_shell_strict_options_command), deploy_stage_directory_let_step()],
        concat(
          approval_broker_tree_copy_steps(spec: spec, revision: revision),
          apply_approval_broker_unit_write_steps(spec: spec, revision: revision),
        ),
      ),
      concat([deploy_effect(inv: systemctl_daemon_reload_effect())], approval_broker_lifecycle_steps(spec: spec)),
    ),
    on_failure: FailFast,
  }
}

// A NON-OWNING SPEC REACHING THE DARK INSTALL REFUSES LOUDLY RATHER THAN EMITTING A SCRIPT THAT
// DOES NOTHING. With the ownership predicate constructing the steps, a twin's dark install would
// otherwise render a well-formed script containing a strict-mode line, a mktemp and a daemon-reload
// -- a stage that reports success having installed nothing, which is the absorbing fallback DESIGN
// section 5 forbids at exactly the seam where the operator is being told a stage completed. The
// marker is not valid shell, so the stage fails and names the owner.
data approval_broker_dark_install_not_owner_poison: String = "__GUNBC_DEPLOY_REFUSED__ approval-broker DARK INSTALL was reached with a deployment that does not own this host's broker unit. gunbc-approval-broker.service is a HOST singleton owned by gunbc.live_deploy.spec gunbc_approval_broker_owning_instance; a twin apply installing it would point the host's broker at the twin's tree and restart it over production's process (review 68094). This marker is not valid deploy shell, so the stage fails loudly rather than emitting a script that installs nothing and reports success. instance="

data approval_broker_dark_install_emit_refused_poison: String = "__GUNBC_ORCH_EMIT_REFUSED__ approval-broker DARK INSTALL intent emission was rejected by v2.compiler.emit_orchestration; this marker is not valid deploy shell, so stage 1 of the cutover fails loudly rather than a hand-spelled fallback masking the refusal (DESIGN section 5: refuse, never widen)\n"

fn approval_broker_dark_install_script(spec: DeploymentSpec, revision: ReleaseRevisionBinding) -> String {
  if !deployment_owns_the_host_approval_broker(spec: spec) {
    join([approval_broker_dark_install_not_owner_poison, spec.instance_id as String, "\n"], "")
  } else {
    emit_pipeline_or_poison(
      p: approval_broker_dark_install_intent(spec: spec, revision: revision),
      refused: approval_broker_dark_install_emit_refused_poison,
    )
  }
}

fn live_deploy_apply_script_for(
  spec: DeploymentSpec,
  plan: ReleaseEffectPlan,
  cap_authorization: CapConvergeDecision,
) -> String {
  match ci_deploy_srv1_access_or_refusal() {
    DeployAccessJobPrincipalRefused { refusal: r } =>
      deploy_access_job_principal_refused_emit_poison(refusal: r)
    DeployAccessReady { access: access } =>
      match membership_effects(plan: deployment_apply_plan(spec: spec)) {
        EffectsReady { effects: es } =>
          emit_pipeline_or_poison(
            p: apply_intent_from_effects(
              spec: spec,
              effects: es,
              access: access,
              plan: plan,
              cap_authorization: cap_authorization,
            ),
            refused: live_deploy_apply_emit_refused_poison
          )
        ApplyRefused { refusals: rs } =>
          live_deploy_wholesale_refused_poison(refusals: rs, fold_label: "APPLY")
      }
  }
}

fn live_deploy_retract_script_for(spec: DeploymentSpec) -> String {
  match spec.target.tailscale_client {
    ScopedRemovalUnsupported { observed: v } =>
      retract_unsupported_client_poison(observed: semver_version_label(v: v))
    ScopedRemovalUnobserved { reason: r } =>
      retract_unobserved_client_poison(reason: r)
    ScopedRemovalSupported { observed: _ } =>
      live_deploy_retract_script_with_scoped_removal(spec: spec)
  }
}

fn live_deploy_retract_script_with_scoped_removal(spec: DeploymentSpec) -> String {
  match ci_deploy_srv1_access_or_refusal() {
    DeployAccessJobPrincipalRefused { refusal: r } =>
      deploy_access_job_principal_refused_emit_poison(refusal: r)
    DeployAccessReady { access: access } =>
      match membership_effects(plan: deployment_retract_plan(spec: spec)) {
        EffectsReady { effects: es } =>
          emit_pipeline_or_poison(
            p: retract_intent_from_effects(spec: spec, effects: es, access: access),
            refused: live_deploy_retract_emit_refused_poison
          )
        ApplyRefused { refusals: rs } =>
          live_deploy_wholesale_refused_poison(refusals: rs, fold_label: "RETRACT")
      }
  }
}

fn live_deploy_systemd_unit_for(spec: DeploymentSpec, revision: ReleaseRevisionBinding) -> String {
  render(doc: emit_systemd_unit_doc(spec: spec, revision: revision), proto: live_deploy_protocol)
}


fn deployment_ensure_dependency_intent(dep: DeploymentDependencyStep) -> Pipeline {
  Pipeline {
    steps: ensure_dependency_steps(dep: dep, privileged: false),
    on_failure: FailFast
  }
}

fn deployment_ensure_dependency_script(dep: DeploymentDependencyStep) -> String {
  emit_pipeline_or_poison(p: deployment_ensure_dependency_intent(dep: dep), refused: live_deploy_ensure_dep_emit_refused_poison)
}

// THE ORACLE THIS PR'S OWN DIAGNOSIS ARGUES FOR AND DOES NOT YET BUILD, written down rather than
// left implicit (review, 2026-07-30). The refusal-arm defect established that a byte-equality
// golden gate and target-language VALIDITY are different oracle families, and only the first exists
// over these two artifacts. What landed in response was a string-shape claim about one call site —
// the escape form present, the raw apostrophe absent — which closes that site and says nothing
// about the next hand-quoted one.\n\nSo the class is open and this row names its closure rather
// than implying the point fix covered it. The repo already has the machinery: a bounded bash
// grammar and serialize_bash, read forward, ingest the emitted script and refuse on a parse failure
// — the same one-grammar-both-directions move DESIGN 4 describes, with a bash -n gate over the two
// committed artifacts as the cheaper interim if the grammar's coverage of this dialect proves
// short.\n\nThe point fix it described is now gone with its subject: the arm that needed quoting
// was the tailscale teardown refusal, and that refusal was itself built on a false claim about the
// CLI, so the emitter no longer quotes anything by hand. That REMOVES a call site; it does not
// close the class, and the bound is now worse rather than better — with no hand-quoted site left in
// this module, nothing here would red if the next one were introduced.\n\nDISSOLVES ON: both
// generated deploy scripts parsed by an executing consumer on every emit, with a discriminating RED
// that introduces a hand-concatenated quote at any call site and goes red on the parse rather than
// on a string shape. The shared authority itself stays independently witnessed at
// shell_quote_escapes_an_embedded_apostrophe, which does not depend on this module having a caller.
data live_deploy_emit_shell_dissolution_trigger: Disposition = Scaffold {
  dissolves_to: RealizationDispatch,
  bind: DeclarationRef {
    module_path: "gunbc.live_deploy.emit",
    decl_name: "live_deploy_apply_script_for",
    field: WholeDeclaration
  }
}

data live_deploy_retract_emit_shell_dissolution_trigger: Disposition = Scaffold {
  dissolves_to: RealizationDispatch,
  bind: DeclarationRef {
    module_path: "gunbc.live_deploy.emit",
    decl_name: "live_deploy_retract_script_for",
    field: WholeDeclaration
  }
}

data live_deploy_remote_mutation_service_op_realization_dissolution_trigger: Disposition = Scaffold {
  dissolves_to: RealizationDispatch,
  bind: DeclarationRef {
    module_path: "gunbc.live_deploy.emit",
    decl_name: "live_deploy_emit_shell_dissolution_trigger",
    field: WholeDeclaration,
  }
}

// The apply/retract scripts are now ONE orchestration-intent Pipeline each, built from the two
// degenerate POLES of the grain-agnostic gunbc.membership_reconcile (apply = reconcile
// desired=all-members/observed=none => all Upsert; retract = reconcile
// desired=none/observed=owned-artifacts => all Teardown) — apply_intent_from_effects /
// retract_intent_from_effects fold the resulting MemberEffects into the Pipeline via the per-kind
// emit_deploy_member_effect handler (share the diff, dispatch the apply), framing
// (preamble/receipt) wrapping OUTSIDE the reconcile. A refusal (a non-owned/unknown member) refuses
// the WHOLE fold before emit (EffectsOrRefusal sum — un-emittable by type; never reached by the
// degenerate poles). The Pipeline is emitted through the signed
// v2.compiler.emit_orchestration.orch_emit_pipeline path over the bash_orchestration_emit medium —
// NOT assembled by workflow-code string concat. The smuggled-program class (control flow /
// sequencing joins built by concat in this module — the former ensure_apt_package function-def, the
// deployment_ensure_dependency_script nested if/then concat, the tailscale if/fi) is dissolved:
// dependency-ensure is inline If-Not-ExitZero(dpkg -s) then Do(sudo -n apt-get install) intent
// (DESIGN §2 CUT: desugar inline, no minted verb), and the emission JOIN lives in
// extdeps/languages/bash_orchestration_emit, not here (no-smuggled-programs wall: a string literal
// is an ATOM, joins live in extdeps/languages rows). An emission refusal returns a poison marker
// (live_deploy_*_emit_refused_poison) so the marker reaches a consumer instead of a hand-spelled
// fallback (DESIGN §5: refuse, never widen). THE COMMITTED GOLDEN ARTIFACTS ARE DELETED: nothing
// executed .github/live-deploy-srv1-apply.sh or -retract.sh, and their registry rows named a
// HostReconciler consumer that does not exist — the real deploy runs live_deploy_apply_srv1_wet
// through gunbc run. A committed artifact nobody reads is not coverage. The byte oracle those
// goldens provided now lives where a fixture revision is legitimate, in test.claim.live_deploy.emit
// against RevisionBoundAtEmission, and it is strictly stronger there: the goldens compared whole
// files and located nothing, while the witnesses pin the exact ExecStart line with three REDs (flag
// absent, wrong candidate's value, flag duplicated). RESIDUE (named, not this slice): Run.command
// is still a String leaf (v2.std.orchestration.Run), so the heredoc file bodies (server.js, systemd
// unit) and per-command argv interpolation ride inside command: strings as the anemic-leaf residue
// — they dissolve when Do-effect gains a typed file-write leaf (heredoc file bodies as typed
// orchestration intent, live_deploy_intent_dependency_graph_emit_dissolution_trigger binds
// orch_emit_pipeline). Transport-aware remote-mutation service-op realization (live_deploy runs
// shell, not yet a transport-realized service op) is OUT OF SCOPE —
// live_deploy_remote_mutation_service_op_realization_dissolution_trigger. Healthz readiness and
// digest read-back run on the DAG reconcile spine after mutation (live_deploy.readiness transport
// curl poll, then live_deploy.apply digest read-back); the apply script ships mutation only (no
// in-script curl read-back).
data live_deploy_intent_dependency_graph_emit_dissolution_trigger: Disposition = Scaffold {
  dissolves_to: RealizationDispatch,
  bind: DeclarationRef {
    module_path: "v2.compiler.emit_orchestration",
    decl_name: "orch_emit_pipeline",
    field: WholeDeclaration,
  }
}
