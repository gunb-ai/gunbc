module gunbc.live_deploy.emit

import std.types { String, List, Bool, NonEmptyStr, Int }
import std.disposition { Disposition, Scaffold, RealizationDispatch }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import std.layout {
  Doc, DocConcat,
  LayoutProtocol,
  doc_concat, doc_line_of,
  render
}
import gunbc.live_deploy.spec {
  DeploymentSpec,
  DeploymentDependencyStep,
  DeploymentArtifactStep,
  deployment_spec_srv1,
  deployment_plan_listen_port,
  gunbc_roadmap_server_path,
  gunbc_roadmap_systemd_unit_path,
}
import gunbc.node_http_server_emit { roadmap_dashboard_node_http_server_source }
import v2.std.orchestration {
  Pipeline, PipelineStep,
  Do, If, Run,
  FailFast, ExitZero, Not, DiscardAll
}
import v2.std.collection { Absent, Present }
import v2.std.diagnostic { Accepted, Rejected, None }
import v2.compiler.emit_orchestration { orch_emit_pipeline }
import v2.extdeps.languages.bash_orchestration_emit { bash_orchestration_emit_medium }

data live_deploy_protocol: LayoutProtocol = LayoutProtocol { indent_unit: "" }

data live_deploy_apply_emit_refused_poison: String = "__GUNBC_ORCH_EMIT_REFUSED__ live-deploy APPLY intent emission was rejected by v2.compiler.emit_orchestration; this marker is not valid deploy shell, so the committed .github/live-deploy-srv1-apply.sh drift gate goes red rather than a hand-spelled fallback masking the refusal (DESIGN §5: refuse, never widen)\n"

data live_deploy_retract_emit_refused_poison: String = "__GUNBC_ORCH_EMIT_REFUSED__ live-deploy RETRACT intent emission was rejected by v2.compiler.emit_orchestration; this marker is not valid deploy shell, so the committed .github/live-deploy-srv1-retract.sh drift gate goes red rather than a hand-spelled fallback masking the refusal (DESIGN §5: refuse, never widen)\n"

data live_deploy_ensure_dep_emit_refused_poison: String = "__GUNBC_ORCH_EMIT_REFUSED__ live-deploy ensure-dependency intent emission was rejected by v2.compiler.emit_orchestration; this marker is not valid reconcile-step shell, so the per-dep ConvergePlan step fails loudly rather than a hand-spelled fallback masking the refusal (DESIGN §5: refuse, never widen)\n"

fn deploy_raw(command: String) -> PipelineStep {
  Do {
    run: Run {
      command: command,
      env: [],
      redirect: Absent,
      capture: Absent
    }
  }
}

fn ensure_apt_package_step(pkg: String, install_command: String) -> PipelineStep {
  If {
    cond: Not { inner: ExitZero {
      run: Run {
        command: concat("dpkg -s ", pkg),
        env: [],
        redirect: Present { value: DiscardAll },
        capture: Absent
      }
    } },
    then_: Pipeline {
      steps: [deploy_raw(command: install_command)],
      on_failure: FailFast
    },
    else_: Absent
  }
}

fn emit_pipeline_or_poison(p: Pipeline, refused: String) -> String {
  match orch_emit_pipeline(p: p, medium: bash_orchestration_emit_medium()) {
    Accepted { value: source, diagnostics: d } =>
      match d {
        None => source.carried
        Some { diagnostics: _ } => refused
      }
    Rejected { diagnostics: _ } => refused
  }
}

fn emit_systemd_unit_doc(spec: DeploymentSpec) -> Doc {
  let svc = spec.service
  let port = to_string(svc.listen.port)
  let host = svc.listen.host
  doc_concat(parts: [
    doc_line_of(text: "[Unit]"),
    doc_line_of(text: "Description=gunbc roadmap HTTP server"),
    doc_line_of(text: "After=network-online.target tailscaled.service"),
    doc_line_of(text: "Wants=network-online.target"),
    doc_line_of(text: ""),
    doc_line_of(text: "[Service]"),
    doc_line_of(text: "Type=simple"),
    doc_line_of(text: concat("Environment=PORT=", port)),
    doc_line_of(text: concat("Environment=HOST=", host)),
    doc_line_of(text: concat("WorkingDirectory=/opt/gunbc")),
    doc_line_of(text: concat("ExecStart=/usr/bin/node ", svc.server_path)),
    doc_line_of(text: "Restart=on-failure"),
    doc_line_of(text: ""),
    doc_line_of(text: "[Install]"),
    doc_line_of(text: "WantedBy=multi-user.target"),
  ])
}

fn deployment_ensured_steps_from_spec(spec: DeploymentSpec) -> List<DeploymentDependencyStep> {
  fold(
    spec.steps,
    init: [],
    f: (acc, step) =>
      match step {
        Dependency { step: s } => concat(acc, [s])
        Artifact { step: _ } => acc
      }
  )
}

fn apply_server_js_write_step() -> PipelineStep {
  deploy_raw(command: concat(
    concat("cat > \"$_gunbc_stage/server.js\" <<'GUNBC_SERVER_EOF'\n", roadmap_dashboard_node_http_server_source()),
    "\nGUNBC_SERVER_EOF"
  ))
}

fn apply_systemd_unit_write_step(spec: DeploymentSpec) -> PipelineStep {
  deploy_raw(command: concat(
    concat("cat > \"$_gunbc_stage/gunbc-roadmap.service\" <<'GUNBC_UNIT_EOF'\n", render(doc: emit_systemd_unit_doc(spec: spec), proto: live_deploy_protocol)),
    "GUNBC_UNIT_EOF"
  ))
}

fn apply_intent(spec: DeploymentSpec) -> Pipeline {
  let port = deployment_plan_listen_port(spec: spec)
  let dep_steps = map(
    deployment_ensured_steps_from_spec(spec: spec),
    d => ensure_apt_package_step(
      pkg: d.package,
      install_command: concat("sudo -n apt-get install -y ", d.package)
    )
  )
  Pipeline {
    steps: concat(
      [
        deploy_raw(command: "set -euo pipefail"),
        deploy_raw(command: concat("# GENERATED APPLY by dag/gunbc/live_deploy/emit.dag host=", spec.target.host.identity)),
        deploy_raw(command: "# Runs UNPRIVILEGED. Every privileged op is a single sudo -n <command> drawn from"),
        deploy_raw(command: "# the minimal grant set (apt-get, install, systemctl, tailscale) — no root shell."),
        deploy_raw(command: "_gunbc_stage=\"$(mktemp -d)\""),
        deploy_raw(command: "trap 'rm -rf \"$_gunbc_stage\"' EXIT"),
      ],
      dep_steps,
      [
        deploy_raw(command: "sudo -n install -d -m 0755 /opt/gunbc"),
        apply_server_js_write_step(),
        deploy_raw(command: concat("sudo -n install -m 0644 \"$_gunbc_stage/server.js\" ", gunbc_roadmap_server_path)),
        apply_systemd_unit_write_step(spec: spec),
        deploy_raw(command: concat("sudo -n install -m 0644 \"$_gunbc_stage/gunbc-roadmap.service\" ", gunbc_roadmap_systemd_unit_path)),
        deploy_raw(command: "sudo -n systemctl daemon-reload"),
        deploy_raw(command: concat("sudo -n systemctl enable ", spec.service.unit_name)),
        deploy_raw(command: concat("sudo -n systemctl restart ", spec.service.unit_name)),
        If {
          cond: Not { inner: ExitZero {
            run: Run {
              command: concat("sudo -n tailscale serve status 2>/dev/null | grep -q ':", to_string(port), "'"),
              env: [],
              redirect: Absent,
              capture: Absent
            }
          } },
          then_: Pipeline {
            steps: [deploy_raw(command: concat("sudo -n tailscale serve --bg ", to_string(port)))],
            on_failure: FailFast
          },
          else_: Absent
        },
        deploy_raw(command: concat("echo live-deploy-receipt host=", spec.target.host.identity, " fold=apply verdict=converged")),
      ]
    ),
    on_failure: FailFast
  }
}

fn retract_intent(spec: DeploymentSpec) -> Pipeline {
  Pipeline {
    steps: [
      deploy_raw(command: "set -euo pipefail"),
      deploy_raw(command: concat("# GENERATED RETRACT by dag/gunbc/live_deploy/emit.dag host=", spec.target.host.identity)),
      deploy_raw(command: "# owned-artifacts only — ensured deps (tailscale, nodejs) intentionally NOT purged"),
      deploy_raw(command: "# Runs UNPRIVILEGED; privileged ops via sudo -n <command> (tailscale, systemctl, rm)."),
      deploy_raw(command: "sudo -n tailscale serve reset || true"),
      deploy_raw(command: concat("sudo -n systemctl disable --now ", spec.service.unit_name, " 2>/dev/null || true")),
      deploy_raw(command: concat("sudo -n rm -f ", gunbc_roadmap_systemd_unit_path)),
      deploy_raw(command: "sudo -n systemctl daemon-reload"),
      deploy_raw(command: concat("sudo -n rm -f ", gunbc_roadmap_server_path)),
      deploy_raw(command: concat("echo live-deploy-receipt host=", spec.target.host.identity, " fold=retract verdict=converged")),
    ],
    on_failure: FailFast
  }
}

fn live_deploy_apply_script_for(spec: DeploymentSpec) -> String {
  emit_pipeline_or_poison(p: apply_intent(spec: spec), refused: live_deploy_apply_emit_refused_poison)
}

fn live_deploy_retract_script_for(spec: DeploymentSpec) -> String {
  emit_pipeline_or_poison(p: retract_intent(spec: spec), refused: live_deploy_retract_emit_refused_poison)
}

fn expected_live_deploy_apply_script() -> String {
  live_deploy_apply_script_for(spec: deployment_spec_srv1())
}

fn expected_live_deploy_retract_script() -> String {
  live_deploy_retract_script_for(spec: deployment_spec_srv1())
}

fn live_deploy_systemd_unit_for(spec: DeploymentSpec) -> String {
  render(doc: emit_systemd_unit_doc(spec: spec), proto: live_deploy_protocol)
}

fn deployment_ensure_dependency_intent(dep: DeploymentDependencyStep) -> Pipeline {
  Pipeline {
    steps: [
      ensure_apt_package_step(
        pkg: dep.package,
        install_command: concat("apt-get install -y ", dep.package)
      )
    ],
    on_failure: FailFast
  }
}

fn deployment_ensure_dependency_script(dep: DeploymentDependencyStep) -> String {
  emit_pipeline_or_poison(p: deployment_ensure_dependency_intent(dep: dep), refused: live_deploy_ensure_dep_emit_refused_poison)
}

data live_deploy_emit_shell_dissolution_trigger: Disposition = Scaffold {
  dissolves_to: RealizationDispatch,
  bind: DeclarationRef {
    module_path: "gunbc.live_deploy.emit",
    decl_name: "live_deploy_apply_script_for",
    field: WholeDeclaration
  }
}

data live_deploy_retract_emit_shell_dissolution_trigger: Disposition = Scaffold {
  dissolves_to: RealizationDispatch,
  bind: DeclarationRef {
    module_path: "gunbc.live_deploy.emit",
    decl_name: "live_deploy_retract_script_for",
    field: WholeDeclaration
  }
}

data live_deploy_remote_mutation_service_op_realization_dissolution_trigger: Disposition = Scaffold {
  dissolves_to: RealizationDispatch,
  bind: DeclarationRef {
    module_path: "gunbc.live_deploy.emit",
    decl_name: "live_deploy_emit_shell_dissolution_trigger",
    field: WholeDeclaration,
  }
}

data live_deploy_intent_dependency_graph_emit_dissolution_trigger: Disposition = Scaffold {
  dissolves_to: RealizationDispatch,
  bind: DeclarationRef {
    module_path: "v2.compiler.emit_orchestration",
    decl_name: "orch_emit_pipeline",
    field: WholeDeclaration,
  }
}

data live_deploy_golden_freeze_note: String = "The apply/retract scripts are now ONE orchestration-intent Pipeline each (apply_intent / retract_intent), emitted through the signed v2.compiler.emit_orchestration.orch_emit_pipeline path over the bash_orchestration_emit medium — NOT assembled by workflow-code string concat. The smuggled-program class (control flow / sequencing joins built by concat in this module — the former ensure_apt_package function-def, the deployment_ensure_dependency_script nested if/then concat, the tailscale if/fi) is dissolved: dependency-ensure is inline If-Not-ExitZero(dpkg -s) then Do(sudo -n apt-get install) intent (DESIGN §2 CUT: desugar inline, no minted verb), and the emission JOIN lives in extdeps/languages/bash_orchestration_emit, not here (no-smuggled-programs wall: a string literal is an ATOM, joins live in extdeps/languages rows). An emission refusal returns a poison marker (live_deploy_*_emit_refused_poison) so the committed golden drift gate reds instead of a hand-spelled fallback (DESIGN §5: refuse, never widen). The scripts are still frozen as committed golden artifacts (gunbc.generated_artifact LiveDeployApplyScriptArtifact / LiveDeployRetractScriptArtifact, gated byte-for-byte in test.claim.live_deploy.emit) — green by execution + a discriminating RED — killing the #6023-class self-referential drift check. RESIDUE (named, not this slice): Run.command is still a String leaf (v2.std.orchestration.Run), so the heredoc file bodies (server.js, systemd unit) and per-command argv interpolation ride inside command: strings as the anemic-leaf residue — they dissolve when Do-effect gains a typed file-write leaf (heredoc file bodies as typed orchestration intent, live_deploy_intent_dependency_graph_emit_dissolution_trigger binds orch_emit_pipeline). Transport-aware remote-mutation service-op realization (live_deploy runs shell, not yet a transport-realized service op) is OUT OF SCOPE — live_deploy_remote_mutation_service_op_realization_dissolution_trigger. Healthz readiness and digest read-back run on the DAG reconcile spine after mutation (live_deploy.readiness transport curl poll, then live_deploy.apply digest read-back); the apply script ships mutation only (no in-script curl read-back)."
