module gunbc.live_deploy.emit

import std.types { String, List, Bool, NonEmptyStr, Int }
import std.disposition { Disposition, Scaffold, RealizationDispatch }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import std.layout {
  Doc, DocConcat,
  LayoutProtocol,
  doc_concat, doc_line_of,
  render
}
import gunbc.live_deploy.spec {
  DeploymentSpec,
  DeploymentEnsuredStep,
  DeploymentOwnedStep,
  deployment_spec_srv1,
  deployment_plan_listen_port,
  gunbc_roadmap_server_path,
  gunbc_roadmap_systemd_unit_path,
}
import gunbc.node_http_server_emit { roadmap_dashboard_node_http_server_source }
import gunbc.roadmap_static_site { roadmap_site_readback_script }

data live_deploy_protocol: LayoutProtocol = LayoutProtocol { indent_unit: "" }

fn sh_arg(s: String) -> String {
  concat(concat("\"", s), "\"")
}

fn emit_systemd_unit_doc(spec: DeploymentSpec) -> Doc {
  let svc = spec.service
  let port = to_string(svc.listen.port)
  let host = svc.listen.host
  doc_concat(parts: [
    doc_line_of(text: "[Unit]"),
    doc_line_of(text: "Description=gunbc roadmap HTTP server"),
    doc_line_of(text: "After=network-online.target tailscaled.service"),
    doc_line_of(text: "Wants=network-online.target"),
    doc_line_of(text: ""),
    doc_line_of(text: "[Service]"),
    doc_line_of(text: "Type=simple"),
    doc_line_of(text: concat("Environment=PORT=", port)),
    doc_line_of(text: concat("Environment=HOST=", host)),
    doc_line_of(text: concat("WorkingDirectory=/opt/gunbc")),
    doc_line_of(text: concat("ExecStart=/usr/bin/node ", svc.server_path)),
    doc_line_of(text: "Restart=on-failure"),
    doc_line_of(text: ""),
    doc_line_of(text: "[Install]"),
    doc_line_of(text: "WantedBy=multi-user.target"),
  ])
}

fn deployment_ensured_steps_from_spec(spec: DeploymentSpec) -> List<DeploymentEnsuredStep> {
  fold(
    spec.steps,
    init: [],
    f: (acc, step) =>
      match step {
        Ensured { step: s } => concat(acc, [s])
        Owned { step: _ } => acc
      }
  )
}

fn emit_apply_script_body(spec: DeploymentSpec) -> Doc {
  let port = deployment_plan_listen_port(spec: spec)
  let dep_lines = map(
    deployment_ensured_steps_from_spec(spec: spec),
    d => doc_line_of(text: concat("ensure_apt_package ", sh_arg(s: d.package)))
  )
  doc_concat(parts: concat(
    [
      doc_line_of(text: "set -euo pipefail"),
      doc_line_of(text: concat("# GENERATED APPLY by dag/gunbc/live_deploy/emit.dag host=", spec.target.host.identity)),
      doc_line_of(text: "# Runs UNPRIVILEGED. Every privileged op is a single sudo -n <command> drawn from"),
      doc_line_of(text: "# the minimal grant set (apt-get, install, systemctl, tailscale) — no root shell."),
      doc_line_of(text: "_gunbc_stage=\"$(mktemp -d)\""),
      doc_line_of(text: "trap 'rm -rf \"$_gunbc_stage\"' EXIT"),
      doc_line_of(text: "ensure_apt_package() {"),
      doc_line_of(text: "  local pkg=\"$1\""),
      doc_line_of(text: "  if ! dpkg -s \"$pkg\" >/dev/null 2>&1; then"),
      doc_line_of(text: "    sudo -n apt-get install -y \"$pkg\""),
      doc_line_of(text: "  fi"),
      doc_line_of(text: "}"),
      doc_line_of(text: ""),
    ],
    dep_lines,
    [
      doc_line_of(text: ""),
      doc_line_of(text: "sudo -n install -d -m 0755 /opt/gunbc"),
      doc_line_of(text: "cat > \"$_gunbc_stage/server.js\" <<'GUNBC_SERVER_EOF'"),
      doc_line_of(text: roadmap_dashboard_node_http_server_source()),
      doc_line_of(text: "GUNBC_SERVER_EOF"),
      doc_line_of(text: concat("sudo -n install -m 0644 \"$_gunbc_stage/server.js\" ", gunbc_roadmap_server_path)),
      doc_line_of(text: ""),
      doc_line_of(text: "cat > \"$_gunbc_stage/gunbc-roadmap.service\" <<'GUNBC_UNIT_EOF'"),
    ],
    [
      emit_systemd_unit_doc(spec: spec),
      doc_line_of(text: "GUNBC_UNIT_EOF"),
      doc_line_of(text: concat("sudo -n install -m 0644 \"$_gunbc_stage/gunbc-roadmap.service\" ", gunbc_roadmap_systemd_unit_path)),
      doc_line_of(text: ""),
      doc_line_of(text: "sudo -n systemctl daemon-reload"),
      doc_line_of(text: concat("sudo -n systemctl enable ", spec.service.unit_name)),
      doc_line_of(text: concat("sudo -n systemctl restart ", spec.service.unit_name)),
      doc_line_of(text: ""),
      doc_line_of(text: concat("if ! sudo -n tailscale serve status 2>/dev/null | grep -q ':", to_string(port), "'; then")),
      doc_line_of(text: concat("  sudo -n tailscale serve --bg ", to_string(port))),
      doc_line_of(text: "fi"),
      doc_line_of(text: ""),
      doc_line_of(text: roadmap_site_readback_script(port: port)),
      doc_line_of(text: ""),
      doc_line_of(text: concat("echo live-deploy-receipt host=", spec.target.host.identity, " fold=apply verdict=converged")),
    ]
  ))
}

fn emit_retract_script_body(spec: DeploymentSpec) -> Doc {
  doc_concat(parts: [
    doc_line_of(text: "set -euo pipefail"),
    doc_line_of(text: concat("# GENERATED RETRACT by dag/gunbc/live_deploy/emit.dag host=", spec.target.host.identity)),
    doc_line_of(text: "# owned-artifacts only — ensured deps (tailscale, nodejs) intentionally NOT purged"),
    doc_line_of(text: "# Runs UNPRIVILEGED; privileged ops via sudo -n <command> (tailscale, systemctl, rm)."),
    doc_line_of(text: "sudo -n tailscale serve reset || true"),
    doc_line_of(text: concat("sudo -n systemctl disable --now ", spec.service.unit_name, " 2>/dev/null || true")),
    doc_line_of(text: concat("sudo -n rm -f ", gunbc_roadmap_systemd_unit_path)),
    doc_line_of(text: "sudo -n systemctl daemon-reload"),
    doc_line_of(text: concat("sudo -n rm -f ", gunbc_roadmap_server_path)),
    doc_line_of(text: concat("echo live-deploy-receipt host=", spec.target.host.identity, " fold=retract verdict=converged")),
  ])
}

fn live_deploy_apply_script_for(spec: DeploymentSpec) -> String {
  render(doc: emit_apply_script_body(spec: spec), proto: live_deploy_protocol)
}

fn live_deploy_retract_script_for(spec: DeploymentSpec) -> String {
  render(doc: emit_retract_script_body(spec: spec), proto: live_deploy_protocol)
}

fn expected_live_deploy_apply_script() -> String {
  live_deploy_apply_script_for(spec: deployment_spec_srv1())
}

fn expected_live_deploy_retract_script() -> String {
  live_deploy_retract_script_for(spec: deployment_spec_srv1())
}

fn live_deploy_systemd_unit_for(spec: DeploymentSpec) -> String {
  render(doc: emit_systemd_unit_doc(spec: spec), proto: live_deploy_protocol)
}

fn deployment_ensure_dependency_script(dep: DeploymentEnsuredStep) -> String {
  concat(
    concat(
      concat("if ! dpkg -s ", dep.package),
      concat(" >/dev/null 2>&1; then apt-get install -y ", dep.package)
    ),
    "; fi"
  )
}

data live_deploy_emit_shell_dissolution_trigger: Disposition = Scaffold {
  dissolves_to: RealizationDispatch,
  bind: DeclarationRef {
    module_path: "gunbc.live_deploy.emit",
    decl_name: "live_deploy_apply_script_for",
    field: WholeDeclaration
  }
}

data live_deploy_retract_emit_shell_dissolution_trigger: Disposition = Scaffold {
  dissolves_to: RealizationDispatch,
  bind: DeclarationRef {
    module_path: "gunbc.live_deploy.emit",
    decl_name: "live_deploy_retract_script_for",
    field: WholeDeclaration
  }
}

data live_deploy_remote_mutation_service_op_realization_dissolution_trigger: Disposition = Scaffold {
  dissolves_to: RealizationDispatch,
  bind: DeclarationRef {
    module_path: "gunbc.live_deploy.emit",
    decl_name: "live_deploy_emit_shell_dissolution_trigger",
    field: WholeDeclaration,
  }
}

data live_deploy_golden_freeze_note: String = "The apply/retract scripts rendered here are frozen as committed golden artifacts (gunbc.generated_artifact LiveDeployApplyScriptArtifact / LiveDeployRetractScriptArtifact, gated byte-for-byte in test.claim.live_deploy.emit) so live_deploy's current shell-emission behavior is provable (green by execution + a discriminating RED), killing the #6023-class self-referential drift check that compared expected_live_deploy_apply_script() to itself. This is a SCAFFOLD, not the end-state: live_deploy is RUNTIME-PRESENT (docs/plans/shell-emission-model.md Slice 3) and dissolves when heredoc file bodies become typed Filesystem.Write effects and apt/systemctl/tailscale become typed argv invocations — see live_deploy_emit_shell_dissolution_trigger / live_deploy_retract_emit_shell_dissolution_trigger. Transport-aware remote mutation service-op realization (Filesystem.Write/systemctl/tailscale executed on srv1 over ssh without emitted-script indirection) is OUT OF SCOPE for Slice 3 and retires on the same axis as live_deploy_emit_shell_dissolution_trigger — see live_deploy_remote_mutation_service_op_realization_dissolution_trigger."
