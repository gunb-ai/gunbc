module gunbc.live_deploy.emit



data live_deploy_protocol: std.layout.LayoutProtocol = std.layout.LayoutProtocol { indent_unit: "" }

data live_deploy_apply_emit_refused_poison: String = "__GUNBC_ORCH_EMIT_REFUSED__ live-deploy APPLY intent emission was rejected by v2.compiler.emit_orchestration; this marker is not valid deploy shell, so the committed .github/live-deploy-srv1-apply.sh drift gate goes red rather than a hand-spelled fallback masking the refusal (DESIGN §5: refuse, never widen)\n"

data live_deploy_retract_emit_refused_poison: String = "__GUNBC_ORCH_EMIT_REFUSED__ live-deploy RETRACT intent emission was rejected by v2.compiler.emit_orchestration; this marker is not valid deploy shell, so the committed .github/live-deploy-srv1-retract.sh drift gate goes red rather than a hand-spelled fallback masking the refusal (DESIGN §5: refuse, never widen)\n"

data live_deploy_ensure_dep_emit_refused_poison: String = "__GUNBC_ORCH_EMIT_REFUSED__ live-deploy ensure-dependency intent emission was rejected by v2.compiler.emit_orchestration; this marker is not valid reconcile-step shell, so the per-dep ConvergePlan step fails loudly rather than a hand-spelled fallback masking the refusal (DESIGN §5: refuse, never widen)\n"

data live_deploy_systemd_retirement_emit_refused_poison: String = "__GUNBC_BASH_EMIT_REFUSED__ systemd runtime-retirement intent was rejected by v2.workflow.bash_command_fold_serialize; this marker is not valid deploy shell, so the committed retract artifact drift gate goes red rather than a hand-spelled fallback masking the refusal (DESIGN §5: refuse, never widen)"

fn deploy_raw(command: String) -> v2.std.orchestration.PipelineStep {
  v2.std.orchestration.Do {
    run: v2.std.orchestration.Run {
      command: command,
      env: [],
      redirect: Absent,
      capture: Absent
    }
  }
}

fn systemctl_disable_now_argv_for_deploy(unit: std.types.NonEmptyStr, privileged: std.types.Bool) -> std.types.List<String> {
  if privileged {
    concat(["sudo", "-n"], extdeps.systemd.systemctl.systemctl_disable_now_argv(unit: unit))
  } else {
    extdeps.systemd.systemctl.systemctl_disable_now_argv(unit: unit)
  }
}

data systemctl_disable_now_if_present_note: String = "Runtime retirement is idempotent only for the explicit systemd LoadState=not-found observation. The decision is a bash grammar tree at this foreign-executor realization edge: a fail-fast assignment captures LoadState, then a modeled If disables every state other than not-found. A show/read failure therefore stops before the conditional, and a disable/stop failure remains loud. This replaces the former `2>/dev/null || true` without smuggling command substitution or control flow through a String leaf."

fn systemctl_load_state_assignment_intent(unit: std.types.NonEmptyStr) -> v2.std.node.Node {
  v2.extdeps.languages.bash_build.bash_build_assign(
    name: "_gunbc_load_state",
    value: v2.extdeps.languages.bash_build.bash_build_word_cmdsubst(
      body: v2.extdeps.languages.bash_build.bash_build_command_from_lits(
        lits: extdeps.systemd.systemctl.systemctl_show_load_state_argv(unit: unit)
      )
    )
  )
}

fn systemctl_disable_now_when_loaded_intent(unit: std.types.NonEmptyStr, privileged: std.types.Bool) -> v2.std.node.Node {
  v2.extdeps.languages.bash_build.bash_build_if_from_stmts(
    cond: v2.extdeps.languages.bash_build.bash_build_test_bracket(words: [
      v2.extdeps.languages.bash_build.bash_build_word_var(name: "_gunbc_load_state"),
      v2.extdeps.languages.bash_build.bash_build_word_lit(text: "!="),
      v2.extdeps.languages.bash_build.bash_build_word_lit(text: extdeps.systemd.systemd_unit_load_state_not_found_wire as String),
    ]),
    then_stmts: [
      v2.extdeps.languages.bash_build.bash_build_command_from_lits(
        lits: systemctl_disable_now_argv_for_deploy(unit: unit, privileged: privileged)
      )
    ]
  )
}

fn bash_intent_command_or_poison(intent: v2.std.node.Node) -> String {
  match v2.workflow.bash_command_fold_serialize.bash_fold_serialize_node(stmt: intent) {
    Accepted { value: source, diagnostics: d } =>
      match d {
        v2.std.diagnostic.None => source
        Some { diagnostics: _ } => live_deploy_systemd_retirement_emit_refused_poison
      }
    Rejected { diagnostics: _ } => live_deploy_systemd_retirement_emit_refused_poison
  }
}

fn systemctl_disable_now_if_present_steps(unit: std.types.NonEmptyStr, privileged: std.types.Bool) -> std.types.List<v2.std.orchestration.PipelineStep> {
  [
    deploy_raw(command: bash_intent_command_or_poison(
      intent: systemctl_load_state_assignment_intent(unit: unit)
    )),
    deploy_raw(command: bash_intent_command_or_poison(
      intent: systemctl_disable_now_when_loaded_intent(unit: unit, privileged: privileged)
    )),
  ]
}

fn ensure_apt_package_step(pkg: std.types.NonEmptyStr, privileged: std.types.Bool) -> v2.std.orchestration.PipelineStep {
  v2.std.orchestration.If {
    cond: v2.std.orchestration.Not { inner: v2.std.orchestration.ExitZero {
      run: v2.std.orchestration.Run {
        command: gunbc.live_deploy.operations.dpkg_status_command(package: pkg),
        env: [],
        redirect: Present { value: v2.std.orchestration.DiscardAll },
        capture: Absent
      }
    } },
    then_: v2.std.orchestration.Pipeline {
      steps: [deploy_raw(command: gunbc.live_deploy.operations.apt_install_command(package: pkg, privileged: privileged))],
      on_failure: v2.std.orchestration.FailFast
    },
    else_: Absent
  }
}

fn emit_pipeline_or_poison(p: v2.std.orchestration.Pipeline, refused: String) -> String {
  match v2.compiler.emit_orchestration.orch_emit_pipeline(p: p, medium: v2.extdeps.languages.bash_orchestration_emit.bash_orchestration_emit_medium()) {
    Accepted { value: source, diagnostics: d } =>
      match d {
        v2.std.diagnostic.None => source.carried
        Some { diagnostics: _ } => refused
      }
    Rejected { diagnostics: _ } => refused
  }
}

data emit_systemd_unit_serve_note: String = "The belt-B unit: ExecStart is `gunbc serve` (the seed binary answering every request through the ONE .dag entry gunbc.roadmap_serve.roadmap_serve_handle — no emitted JS, no subprocess dispatch). User=briansrls, NOT root: claude auth exists only under briansrls on srv1 (parent lane verification 2026-07-20), so a root-run belt would spawn unauthed dead sessions; port 8080 is non-privileged so briansrls binds it. WorkingDirectory = the repo root — the source roots and entry are relative to it, and the belt's spawn workdir projects the same gunbc.host_layout fact."

data release_revision_binding_note: String = "WHERE THE LAUNCH REVISION COMES FROM IS ITSELF A MODELED FACT, AND THERE ARE EXACTLY TWO ARMS BECAUSE ONLY TWO ARE HONEST. RevisionBoundAtEmission is the production apply: the launcher observed one candidate, the unit installed at the host bakes exactly that value, and readiness compares against the same single subject. RevisionNotInstalled is the retract fold, and it exists so a retract cannot name a revision even accidentally — the arm that would render ExecStart under it REFUSES with a poison marker, the same unreachable-arm discipline emit_deploy_teardown_dependency_refusal uses.\\n\\nA THIRD ARM WAS TRIED AND DELETED, AND THE REASON IS WORTH KEEPING. RevisionBoundAtInvocation rendered a bash parameter expansion into the unit so a committed script could defer its revision to invocation. It could never have worked: the unit is written through a heredoc whose delimiter is QUOTED (<<'GUNBC_UNIT_EOF'), so bash performs no expansion inside it and the literal dollar-brace text lands in the unit file; systemd does not run ExecStart through bash, implements no :? operator, and this unit sets no such Environment. The chain script-invocation to unit to launch argument did not exist at any link. Proven by execution, not by reading — which is the point: it typechecked, it read plausibly, and it was inert.\\n\\nWhat it was protecting turned out not to need protecting. It existed to keep a committed script as the byte oracle over this ExecStart line, on the belief that deleting the artifact would lose that coverage. A fixture sha is forbidden in a committed PRODUCTION artifact, not in a witness — so the oracle lives in the test corpus against RevisionBoundAtEmission with a fixture, and the artifact was simply dead (no execution consumer, and a HostReconciler consumer row that named a reader which does not exist)."

type ReleaseRevisionBinding
  = RevisionBoundAtEmission { revision: std.types.CommitSha }
  | RevisionNotInstalled

data release_revision_not_installed_poison: String = "__GUNBC_DEPLOY_UNREACHABLE__ the systemd unit writer was reached with RevisionNotInstalled — a retract fold dispatched a unit install. This marker is not a valid release revision, so the golden drift gate reds rather than emitting a unit whose ExecStart names no release (DESIGN section 5: an unreachable arm refuses loudly, never fabricates)."

// A LIMIT RENDERS ITS FLAG OR RENDERS NOTHING, AND THE EMPTY ARM IS NOT A DEFAULT.
// LimitUnset is a declared policy state (std.evaluation_budget
// evaluation_limit_unset_is_a_state_not_a_default_note), so it emits no flag and the
// process announces `unset` at startup — the same visible operational fact it announces
// today. What changes is that production no longer REACHES that arm by omission.
fn eval_budget_flag_text(flag: String, limit: std.evaluation_budget.EvaluationLimit) -> String {
  match limit {
    std.evaluation_budget.LimitUnset => ""
    LimitSet { limit: l } =>
      join([" ", flag, " ", to_string(std.measure.positive_millisecond_count(m: l))], "")
  }
}

fn release_revision_execstart_text(binding: ReleaseRevisionBinding) -> String {
  match binding {
    RevisionBoundAtEmission { revision: r } => r as String
    RevisionNotInstalled => release_revision_not_installed_poison
  }
}

fn emit_systemd_unit_doc(spec: gunbc.live_deploy.spec.DeploymentSpec, revision: ReleaseRevisionBinding) -> std.layout.Doc {
  let svc = spec.service
  let port = to_string(svc.listen.port)
  let host = svc.listen.host
  std.layout.doc_concat(parts: [
    std.layout.doc_line_of(text: "[Unit]"),
    std.layout.doc_line_of(text: "Description=gunbc roadmap HTTP server (gunbc serve)"),
    std.layout.doc_line_of(text: "After=network-online.target tailscaled.service"),
    std.layout.doc_line_of(text: "Wants=network-online.target"),
    std.layout.doc_line_of(text: ""),
    std.layout.doc_line_of(text: "[Service]"),
    std.layout.doc_line_of(text: "Type=simple"),
    std.layout.doc_line_of(text: concat("User=", svc.service_user)),
    std.layout.doc_line_of(text: concat("Group=", svc.service_user)),
    std.layout.doc_line_of(text: concat("WorkingDirectory=", svc.repo_root)),
    std.layout.doc_line_of(text: join([
      "ExecStart=", svc.serve_binary,
      " serve --source-root dag --source-root src/v2",
      " --entry dag/gunbc/roadmap_serve.dag --function ", svc.serve_function as String,
      " --host ", host, " --port ", port,
      " --release-revision ", release_revision_execstart_text(binding: revision),
      eval_budget_flag_text(flag: "--eval-budget-cpu-ms", limit: svc.serve_cpu_limit),
      eval_budget_flag_text(flag: "--eval-budget-wall-ms", limit: svc.serve_wall_limit),
    ], "")),
    std.layout.doc_line_of(text: "Restart=on-failure"),
    std.layout.doc_line_of(text: ""),
    std.layout.doc_line_of(text: "[Install]"),
    std.layout.doc_line_of(text: "WantedBy=multi-user.target"),
  ])
}

data belt_tick_cadence_note: String = "OnUnitInactiveSec, NOT OnUnitActiveSec, and the difference is a fail-closed choice rather than a formatting one. OnUnitActiveSec measures from when the tick STARTED, so a tick that runs longer than the cadence schedules its successor while it is still running and ticks pile up back-to-back — for a unit whose job is spawning agent sessions, that converts a slow tick into overlapping spawns. OnUnitInactiveSec measures from when the previous tick FINISHED, so the gap is real regardless of how long a tick takes and the belt can never outrun itself. systemd additionally refuses to start a Type=oneshot unit that is already active, so the two together make overlap unwritable rather than unlikely.\\n\\n60s is the operator's stated default for this lane and is deliberately not tuned against anything: a tick against an unchanged frontier is an idempotent reconcile that observes live tmux sessions and does nothing (belt_run_once_note), so the cost of a too-fast cadence is an observation, not an action. AccuracySec=5s keeps systemd from coalescing the timer into a distant wakeup window, which is the default behavior and would otherwise make the effective cadence unpredictable.\\n\\nOnBootSec=2min rather than firing immediately: at boot the tree sync, the serve unit and tailscale are all converging, and a belt tick that spawns before the repo tree is in place produces SpawnFailed rows for a condition that resolves itself within seconds. The delay costs one cadence period and removes a class of self-inflicted refusals from the receipt."

data belt_tick_cadence: String = "60s"

fn emit_belt_service_unit_doc(spec: gunbc.live_deploy.spec.DeploymentSpec) -> std.layout.Doc {
  let svc = spec.service
  std.layout.doc_concat(parts: [
    std.layout.doc_line_of(text: "[Unit]"),
    std.layout.doc_line_of(text: "Description=gunbc roadmap belt tick (one reconcile pass over the ready frontier)"),
    std.layout.doc_line_of(text: "After=network-online.target"),
    std.layout.doc_line_of(text: "Wants=network-online.target"),
    std.layout.doc_line_of(text: ""),
    std.layout.doc_line_of(text: "[Service]"),
    std.layout.doc_line_of(text: "Type=oneshot"),
    std.layout.doc_line_of(text: concat("User=", svc.service_user)),
    std.layout.doc_line_of(text: concat("Group=", svc.service_user)),
    std.layout.doc_line_of(text: concat("WorkingDirectory=", svc.repo_root)),
    std.layout.doc_line_of(text: join([
      "Environment=", gunbc.host_layout.belt_spawn_workdir_env_var as String, "=", svc.repo_root,
    ], "")),
    std.layout.doc_line_of(text: join([
      "ExecStart=", svc.serve_binary,
      " run --source-root dag --source-root src/v2",
      " --entry dag/gunbc/roadmap_belt_actuate.dag --function belt_run_once_cli",
    ], "")),
  ])
}

fn emit_belt_timer_unit_doc(spec: gunbc.live_deploy.spec.DeploymentSpec) -> std.layout.Doc {
  std.layout.doc_concat(parts: [
    std.layout.doc_line_of(text: "[Unit]"),
    std.layout.doc_line_of(text: "Description=gunbc roadmap belt tick cadence"),
    std.layout.doc_line_of(text: ""),
    std.layout.doc_line_of(text: "[Timer]"),
    std.layout.doc_line_of(text: concat("Unit=", gunbc.live_deploy.spec.deployment_belt_service_unit_name(names: spec.names) as String)),
    std.layout.doc_line_of(text: "OnBootSec=2min"),
    std.layout.doc_line_of(text: concat("OnUnitInactiveSec=", belt_tick_cadence)),
    std.layout.doc_line_of(text: "AccuracySec=5s"),
    std.layout.doc_line_of(text: ""),
    std.layout.doc_line_of(text: "[Install]"),
    std.layout.doc_line_of(text: "WantedBy=timers.target"),
  ])
}

fn apply_belt_service_unit_write_step(spec: gunbc.live_deploy.spec.DeploymentSpec) -> v2.std.orchestration.PipelineStep {
  deploy_raw(command: join([
    "cat > \"$_gunbc_stage/", gunbc.live_deploy.spec.deployment_belt_service_unit_name(names: spec.names) as String, "\" <<'GUNBC_BELT_SERVICE_EOF'\n",
    std.layout.render(doc: emit_belt_service_unit_doc(spec: spec), proto: live_deploy_protocol),
    "GUNBC_BELT_SERVICE_EOF",
  ], ""))
}

// b1 fix (CONVERGE close): the fleet-converge unit runs `gunbc converge --host self`, whose
// first act is `git ls-remote origin refs/fleet/desired` inside WorkingDirectory=svc.repo_root
// (/opt/gunbc/gunbc on srv1). That tree is owned by svc.service_user (briansrls), and the
// private-remote credential exists ONLY under that principal on srv1 (emit_systemd_unit_serve_note:
// "claude auth exists only under briansrls"). A root run therefore hits git dubious-ownership
// AND has no credential, so the desired ref is never observed and every cadence renders
// verdict=absent (fleet_converge_cli converge_cli_revision_verdict RevisionUnobserved). Running
// as the repo owner is exactly what the sibling serve/belt/tree-sync units already do
// (emit_systemd_unit_doc / emit_belt_service_unit_doc: User=+Group=svc.service_user).
// Receipt *publication* (superseding a stale root-owned file) is atomic rename in
// gunbc.fleet_converge_cli (gunbc.host_layout fleet_converge_receipt_atomic_publish_note).
// Receipt *directory bootstrap* (existence + service-principal ownership) stays on deploy
// via install_d_owned_command on gunbc.host_layout.fleet_converge_receipt_dir — orthogonal problems.
fn emit_fleet_converge_service_unit_doc(spec: gunbc.live_deploy.spec.DeploymentSpec) -> std.layout.Doc {
  let svc = spec.service
  std.layout.doc_concat(parts: [
    std.layout.doc_line_of(text: "[Unit]"),
    std.layout.doc_line_of(text: "Description=gunbc fleet converge (self)"),
    std.layout.doc_line_of(text: "After=network-online.target"),
    std.layout.doc_line_of(text: "Wants=network-online.target"),
    std.layout.doc_line_of(text: ""),
    std.layout.doc_line_of(text: "[Service]"),
    std.layout.doc_line_of(text: "Type=oneshot"),
    std.layout.doc_line_of(text: concat("User=", svc.service_user)),
    std.layout.doc_line_of(text: concat("Group=", svc.service_user)),
    std.layout.doc_line_of(text: concat("WorkingDirectory=", svc.repo_root)),
    std.layout.doc_line_of(text: join([
      "ExecStart=", svc.serve_binary, " converge --host self",
    ], "")),
  ])
}

fn emit_fleet_converge_timer_unit_doc(spec: gunbc.live_deploy.spec.DeploymentSpec) -> std.layout.Doc {
  std.layout.doc_concat(parts: [
    std.layout.doc_line_of(text: "[Unit]"),
