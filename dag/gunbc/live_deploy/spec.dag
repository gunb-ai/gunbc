module gunbc.live_deploy.spec

import std.types { String, NonEmptyStr, List, Int, Bool, FilePath }
import std.os.types { NobleNumbat2404Lts, OsPackageManager }
import extdeps.os.ubuntu { ubuntu_distribution_catalog_row }
import extdeps.apt {
  package_tailscale,
  package_tmux,
}
import gunbc.fleet_intent { srv1_host, ComputeHost }
import gunbc.fleet_intent_network {
  srv1_tailscale_endpoint,
  fleet_intent_network,
  operator_host_srv1,
}
import gunbc.host_layout {
  srv1_gunbc_repo_root,
  srv1_gunbc_serve_binary,
  srv1_dispatch_worktree_root,
  srv1_dispatch_attempt_state_root,
}
import extdeps.http.server { HttpServerListenConfig }
import product.network_topology { NetworkEndpoint }
import gunbc.ownership { Ownership, Owned, Ensured }

data live_deploy_spec_belt_b_note: String = "Belt B membership (docs/plans/gunbc-served-dashboard-design.md section 5): the service is `gunbc serve` (the seed binary), not an emitted node server.js, so the members flip — ServeBinary + GunbcSourceTree + DispatchWorktreeRoot in (paths from the ONE gunbc.host_layout authority the belt also projects), ServerScript and the NodeJsPackage dependency out (the Ensured nodejs is never torn down — R5; the stale /opt/gunbc/server.js file is left inert on disk and reaped when belt A's interim retires). Deploy principal is ghrunner (DeployRunnerPrincipal.job_user; unit_user=root is NOT the authorization principal). #7011 realization: tree sync AS service user via gunbc-tree-sync.service; six roster sudo grants (Wave C adds visudo for dropin gate). Wave C envelope: in-script preflight + roster-emitted sudoers dropin (gunbc.live_deploy.emit deploy_apply_preamble_shell)."

data gunbc_service_user: NonEmptyStr = "briansrls"

data attempt_state_root_member_note: String = "AttemptStateRoot is an owned member for the same reason DispatchWorktreeRoot is: the belt WRITES there, under the service user, on every dispatch. It was missing until 2026-07-30, and the gap was not visible as a gap — #7368 made a published attempt state a hard precondition of dispatch while the path lived only in gunbc.roadmap_dashboard_instance's srv1 row, so this roster had nothing to add it to. The result on the live host was EACCES from `install -d` against a root-owned /opt/gunbc, AFTER the worktree had been created: an orphan branch per click and a progress row reading `legacy attempt`. Ownership is Owned, not Ensured, because the deploy creates it; teardown mirrors DispatchWorktreeRoot's empty-directory refusal rather than a recursive remove, since a non-empty attempt-state root means published attempt evidence for sessions that may still be live (teardown_worktree_rmdir_note carries the same argument for the same reason)."

type OwnedArtifactKind =
    ServeBinary
  | GunbcSourceTree
  | DispatchWorktreeRoot
  | AttemptStateRoot
  | SystemdUnit
  | TailscaleServeMapping

type EnsuredDependencyKind =
    TailscalePackage
  | TmuxPackage

type DeploymentArtifactStep {
  kind: OwnedArtifactKind
  path: NonEmptyStr
}

type DeploymentDependencyStep {
  kind: EnsuredDependencyKind
  package: NonEmptyStr
}

type DeploymentStep
  = ArtifactStep { step: DeploymentArtifactStep }
  | Dependency { step: DeploymentDependencyStep }

fn deployment_step_ownership(step: DeploymentStep) -> Ownership {
  match step {
    ArtifactStep { step: _ } => Owned
    Dependency { step: _ } => Ensured
  }
}

type DeploymentHostTarget {
  host: ComputeHost
  ssh_host: NonEmptyStr
  tailscale_endpoint: NetworkEndpoint
  tailnet_domain: NonEmptyStr?
  os_package_manager: OsPackageManager
}

type DeploymentServiceConfig {
  unit_name: NonEmptyStr
  serve_binary: NonEmptyStr
  repo_root: NonEmptyStr
  service_user: NonEmptyStr
  listen: HttpServerListenConfig
}

data gunbc_roadmap_unit_name: NonEmptyStr = "gunbc-roadmap.service"
data gunbc_roadmap_systemd_unit_path: NonEmptyStr = "/etc/systemd/system/gunbc-roadmap.service"
data tailscale_serve_owned_path: NonEmptyStr = "tailscale-serve"

data gunbc_tree_sync_note: String = "gunbc-tree-sync.service is the GunbcSourceTree member's sync TRANSPORT, not an independent member: a oneshot unit running AS the service user (the tree's owner writes its own tree — ownership by construction, no chown), installed/started by the deploy through the granted install+systemctl channel because the ci-runner principal holds no rsync grant and no write access to the service-user-owned tree (emit_deploy_principal_note). Its EnvironmentFile carries the runner checkout path (varies per runner slot), written by the apply at run time. Both files are owned host state and are torn down with the tree in the GunbcSourceTree teardown arm."
data gunbc_tree_sync_unit_name: NonEmptyStr = "gunbc-tree-sync.service"
data gunbc_tree_sync_unit_path: NonEmptyStr = "/etc/systemd/system/gunbc-tree-sync.service"
data gunbc_tree_sync_env_path: NonEmptyStr = "/etc/gunbc-tree-sync.env"

fn srv1_os_package_manager() -> OsPackageManager {
  ubuntu_distribution_catalog_row(distro: NobleNumbat2404Lts).package_manager
}

data deployment_apply_order_note: String = "Apply order is dependency-honest: the tree lands before the binary (the binary serves that tree), both before the two belt-spawn roots (the worktree root and the attempt-state root, which a dispatch writes in that order — worktree first, then the published attempt evidence), all before the unit (ExecStart references binary + tree), and the tailscale mapping last (routes to a live service). Retract is the reverse, with DispatchWorktreeRoot AND AttemptStateRoot torn down by empty-directory removal — LOUD failure when worktrees or published attempts exist, so a retract cannot silently destroy live agent sessions or the evidence of what they did (a construction-level refusal, not a check)."

fn deployment_owned_steps() -> List<DeploymentArtifactStep> {
  [
    DeploymentArtifactStep { kind: GunbcSourceTree, path: srv1_gunbc_repo_root as String as NonEmptyStr },
    DeploymentArtifactStep { kind: ServeBinary, path: srv1_gunbc_serve_binary as String as NonEmptyStr },
    DeploymentArtifactStep { kind: DispatchWorktreeRoot, path: srv1_dispatch_worktree_root as String as NonEmptyStr },
    DeploymentArtifactStep { kind: AttemptStateRoot, path: srv1_dispatch_attempt_state_root as String as NonEmptyStr },
    DeploymentArtifactStep { kind: SystemdUnit, path: gunbc_roadmap_systemd_unit_path },
    DeploymentArtifactStep { kind: TailscaleServeMapping, path: tailscale_serve_owned_path },
  ]
}

fn deployment_ensured_steps() -> List<DeploymentDependencyStep> {
  [
    DeploymentDependencyStep { kind: TailscalePackage, package: package_tailscale },
    DeploymentDependencyStep { kind: TmuxPackage, package: package_tmux },
  ]
}

fn deployment_steps_apply_order() -> List<DeploymentStep> {
  concat(
    map(deployment_ensured_steps(), s => Dependency { step: s }),
    map(deployment_owned_steps(), s => ArtifactStep { step: s })
  )
}

fn deployment_owned_steps_retract_order() -> List<DeploymentArtifactStep> {
  [
    DeploymentArtifactStep { kind: TailscaleServeMapping, path: tailscale_serve_owned_path },
    DeploymentArtifactStep { kind: SystemdUnit, path: gunbc_roadmap_systemd_unit_path },
    DeploymentArtifactStep { kind: AttemptStateRoot, path: srv1_dispatch_attempt_state_root as String as NonEmptyStr },
    DeploymentArtifactStep { kind: DispatchWorktreeRoot, path: srv1_dispatch_worktree_root as String as NonEmptyStr },
    DeploymentArtifactStep { kind: ServeBinary, path: srv1_gunbc_serve_binary as String as NonEmptyStr },
    DeploymentArtifactStep { kind: GunbcSourceTree, path: srv1_gunbc_repo_root as String as NonEmptyStr },
  ]
}

fn deployment_srv1_target() -> DeploymentHostTarget {
  DeploymentHostTarget {
    host: srv1_host,
    ssh_host: operator_host_srv1 as NonEmptyStr,
    tailscale_endpoint: srv1_tailscale_endpoint,
    tailnet_domain: fleet_intent_network.tailnet_domain,
    os_package_manager: srv1_os_package_manager(),
  }
}

fn deployment_service_config() -> DeploymentServiceConfig {
  DeploymentServiceConfig {
    unit_name: gunbc_roadmap_unit_name,
    serve_binary: srv1_gunbc_serve_binary as String as NonEmptyStr,
    repo_root: srv1_gunbc_repo_root as String as NonEmptyStr,
    service_user: gunbc_service_user,
    listen: HttpServerListenConfig {
      host: "0.0.0.0",
      port: 8080,
    },
  }
}

fn deployment_spec_srv1() -> DeploymentSpec {
  DeploymentSpec {
    target: deployment_srv1_target(),
    steps: deployment_steps_apply_order(),
    service: deployment_service_config(),
  }
}

type DeploymentSpec {
  target: DeploymentHostTarget
  steps: List<DeploymentStep>
  service: DeploymentServiceConfig
}

fn deployment_plan_host_identity(spec: DeploymentSpec) -> String {
  spec.target.host.identity
}

fn deployment_plan_ssh_host(spec: DeploymentSpec) -> NonEmptyStr {
  spec.target.ssh_host
}

fn deployment_plan_listen_port(spec: DeploymentSpec) -> Int {
  spec.service.listen.port
}

fn deployment_tailnet_url(spec: DeploymentSpec) -> String? {
  match spec.target.tailnet_domain {
    Present { value: domain } =>
      Present {
        value: concat(
          concat("https://", spec.target.host.identity),
          concat(".", domain)
        )
      }
    Absent => none
  }
}
