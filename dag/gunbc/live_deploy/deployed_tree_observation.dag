// ONE HOST, SEALED WITH ITS CREDENTIAL AND ITS REPO PATH, SO A CROSS-HOST JOIN HAS NO CONSTRUCTOR.
//
// The revision and the tree state are two facts that only mean something together: the deployed tree
// IS the admitted revision exactly when the revision matches AND nothing has been modified since.
// If each were observed through its own host parameter, a join could read the revision from one
// machine and the modification state from another and report a convergence about neither -- and it
// would typecheck, because two host-parameterized observations and one join is a well-formed program
// with no arm in which to refuse.
//
// So neither observation takes a host. Both are taken THROUGH this locus, and the observation carries
// the locus it was taken through, which is why `observe_deployed_tree` returns BOTH facts from ONE
// call rather than exposing two readers and a join. There is no constructor for the pair other than
// the one that takes both readings in a single traversal of a single locus, so the mixed-host verdict
// is unrepresentable rather than refused.
//
// `FleetSshExecutionContext` deliberately does not carry a host -- it carries the attempt identity,
// the trust policy and the credential, all of which are per-ATTEMPT and shared across the hosts an
// attempt touches. Binding the host here rather than widening that context keeps one attempt able to
// observe many hosts while keeping any single observation about exactly one.
type DeployedTreeLocus sole_constructor =
    FleetSshTreeLocus { context: FleetSshExecutionContext, target: SshTarget, repo: NonEmptyStr }
  | LocalTreeLocus { host: HostIdentity, repo: NonEmptyStr, attempt: NonEmptyStr }

// THE REPO IS READ THROUGH AN ACCESSOR, NOT A FIELD, because the two arms carry it in different
// records and a caller must not be able to name an arm it did not mint.
fn deployed_tree_locus_repo(locus: DeployedTreeLocus) -> NonEmptyStr {
  match locus {
    FleetSshTreeLocus { repo: r } => r
    LocalTreeLocus { repo: r } => r
  }
}

// THE HOST THE LEG WAS TAKEN AT, as the locus seals it. The ssh arm's host is the resolved target's;
// the local arm's is the identity the join admitted against the kernel's own answer.
fn deployed_tree_locus_host(locus: DeployedTreeLocus) -> String {
  match locus {
    FleetSshTreeLocus { target: t } => t.principal as String
    LocalTreeLocus { host: h } => h as String
  }
}

fn deployed_tree_locus(
  context: FleetSshExecutionContext,
  target: SshTarget,
  repo: NonEmptyStr,
) -> DeployedTreeLocus {
  FleetSshTreeLocus { context: context, target: target, repo: repo }
}

fn deployed_tree_locus_transport(locus: DeployedTreeLocus) -> HostEffectTransport {
  match locus {
    // THE FLEET ARM DECLARES ITS OWN KIND. Every leg this module sends is a fixed command the module
    // writes itself -- rev-parse HEAD, rev-parse HEAD^{tree}, read-tree, status --porcelain, ls-files
    // --ignored, and an rm -f -- so this is the fixed-argv case of the wrapper rule and the wrapper
    // declares, rather than taking a kind from a caller who cannot see the command.
    FleetSshTreeLocus { target: t, context: c } => FleetSsh { target: t, context: c, kind: ProbeLeg}
    // THE LOCAL ARM CARRIES NO KIND BECAUSE IT IS NOT A FLEET LEG: it is shell.Exec.RunArgv on this host,
    // with no ssh session to bound. Reading the tree you are standing in needs no ceiling on a remote
    // machine, and pretending otherwise is how the observation came to depend on an agent it never used.
    LocalTreeLocus { host: _ } => LocalShell
  }
}

// THE INSTRUMENT IS GIT, AND IT IS FOUR SINGLE COMMANDS BECAUSE IT HAS TO BE.
//
// The portable-word alphabet admits no pipe, so a content digest of the deployed directory cannot be
// a shell pipeline -- and that constraint turned out to point at a better instrument than the one it
// forbade. git is ALREADY the content-identity authority for the deployed scope. THIS SENTENCE USED TO
// SAY the tracked set is exactly what the rsync leg ships, and that was FALSE -- the sync publishes the
// working directory wholesale modulo the exclusion authority, so untracked and ignored paths inside the
// deployed scope ship too, which is why the observation reads all three and not one. Corrected in place
// rather than left standing beside the later paragraph that says the opposite: two accounts of one fact
// is the state this module exists to refuse. So there is no digest to compute, no second content
// domain to normalize, and no dependency on the exclusion authority: comparing a source tree against
// a deployed directory would compare two different projections and disagree forever, which fails safe
// and is indistinguishable from real drift, which is how a signal gets silenced.
// THE FIVE git CALLS ARE TYPED ArgvCommands BUILT IN extdeps.git AND DELIVERED THROUGH THE SHARED
// DISPATCHER, NOT WORDS THIS FOLD COMPOSES. An argv shape is a git fact, so the builders live in
// git's extdeps module, one per operation, each naming its caller (review 97601, PR #16918: the first
// shape of this fold hand-laid these words here and grew a second local delivery leaf of its own --
// both were this fold inventing machinery that git's module and the host dispatcher already own). The
// repo, the revision and the index path are the fold's inputs; which endpoint and which credential
// decide only WHERE the command is delivered, never WHAT it says. A witness reaches the same builders
// production does and compares argv_words -- the execution context stays sealed behind its admitted
// caller list, so a wall that makes the wrong factoring untestable is still the wall doing its job.
// EVERY CALL TRUSTS THE DEPLOYED REPOSITORY FOR ITS OWN INVOCATION ONLY (extdeps.git
// git_in_trusted_repository_args). The deployed tree is owned by the publication principal and read
// by the deploy principal, and git refuses a repository its caller does not own; the trust rides the
// command line with the exact path `-C` names, so nothing is written to any principal's config and no
// other git call is widened (srv1 dashboard_deploy, 2026-09-24).

// THE WORKTREE IS COMPARED AGAINST AN INDEX WE BUILD, AND THE DEPLOYED REPO'S OWN INDEX IS NEVER
// CONSULTED. This is the third instrument this observation has had, and the first two were both
// wrong in the same way, so the reasoning is recorded rather than just the answer.
//
// The .git leg is a WHITELIST sync -- HEAD, objects, packed-refs, refs -- and its own carrier note
// lists what never crosses: "config, config.worktree, INDEX, hooks, logs". So a correctly synced host
// is in a state git never produces on its own: HEAD and objects at the new revision, the worktree at
// the new revision, and .git/index still recording whatever the target held before. An earlier
// observation on srv1 found 4,604 files staged as DELETED while present on disk -- that is this state
// at production scale, already measured.
//
// `git status` reports every changed path modified in both columns against such an index. `git diff
// --name-only HEAD` was then adopted on a measurement that turned out to be an artifact of a
// one-file fixture: on a three-file repo whose worktree was verified byte-identical to HEAD, it
// reported two of the three as drifted. Tolerating a stale index was never a property git offers --
// it was a coincidence of which files happened to be re-hashed.
//
// So the construction does not tolerate a stale index, it CANNOT SEE ONE: read-tree materializes a
// TEMPORARY index from the revision the host is actually on, and status runs against that. Nothing
// inherits the deployed repo's staged state or its index flags. Verified: on the same stale-index
// tree the temp-index form answers empty, a corrupted tracked file answers ` M <path>`, restoring it
// answers empty again, and the real .git/index md5 is unchanged across all three.
//
// WHY diff AND status WERE REJECTED, WITH THE DISCRIMINATOR NAMED -- because both of them WORK on
// some machines, and a later reader who tries one on a nanosecond filesystem will see it succeed and
// conclude this was precious. git stores index ctime/mtime as seconds PLUS a nanosecond field and
// compares both. Where the filesystem populates nanoseconds, two writes in the same second still
// differ and the stat cache cannot collide. Where that field is coarse or zero, same-second writes
// collide exactly, git trusts the cache, never reads the file, and reports the worktree as matching
// the STALE index rather than the commit.
//
// Measured on both kinds by two people: one index recording `ctime: 1787281139:854780220` never
// collided across repeated deliberate attempts; another recording whole seconds collided on exactly
// the file whose ctime matched, which `git ls-files --debug` shows directly. The failure is PER-FILE
// AND SILENT -- some paths answer correctly and one does not, in the same run, with nothing in the
// output distinguishing them.
//
// This matters more in production than in a scratch repo, not less: rsync -t takes mtime from the
// SOURCE rather than minting a fresh local one, and the index being compared against was written by
// an earlier sync of the same kind. Whether /opt/gunbc's filesystem populates nanoseconds is one
// read-only stat away and is worth knowing for anything ELSE that consults the deployed index -- but
// it is deliberately NOT a dependency of this module, which is correct on both kinds because it does
// not consult the artifact the divergence lives in.
// `--no-optional-locks` IS LOAD-BEARING AND NOT COSMETIC: plain `git status` WRITES the index back
// (measured -- the md5 changes), so without the flag an "observation" would mutate the host it claims
// to be reading. The same defect is live in extdeps.git.inspect WorkingTreeStatus, which declares
// `readonly` while omitting the flag; that is a separate repair.
//
// THE SUBJECT IS THE DEPLOYED SCOPE, NOT THE TRACKED SET, and an earlier revision of this module said
// otherwise: it read `--untracked-files=no` and its note dispositioned untracked-but-shipped to
// candidate admission as "a different class". That disposition was false and it was false in the
// unsafe direction. Candidate admission owns the SOURCE checkout; nothing owned the target. The sync
// leg publishes the working directory wholesale modulo the deployment exclusion authority, so a
// target could carry HEAD=desired, tracked files clean, and an untracked or ignored `.dag` source
// inside the deployed scope -- and the observation would report converged while the deployed bytes
// were not the ones the commit names. Membership is projected through `path_is_deployed`, the same
// single authority the source side projects through, so the two sides cannot disagree about scope.
//
// ONE PRECONDITION, CLEAN TODAY AND WITH AN ENFORCEABLE HOME. The comparison runs through
// gitattributes, so a clean/smudge filter, text=auto, eol= or working-tree-encoding would report
// clean while the deployed bytes differ by normalization -- and rsync ships bytes. Verified with
// `git check-attr`, which is the authority rather than a grep because it accounts for attributes at
// any depth and for info/attributes: text, eol, filter and working-tree-encoding all report
// `unspecified`. .gitattributes is generated from gunbc.gitattributes_emit, whose two attribute
// constants are literals with no mechanism to admit a third, so the premise is structural rather than
// merely observed.
// THE COMPOSED CLAIM, stated because the status leg alone proves less than it looks like it proves.
// `status` reports HEAD-versus-index as well as worktree-versus-index. Here the temp index is built
// from the revision the rev-parse leg OBSERVED, so the HEAD-versus-index half is equal by
// construction and every reported entry is a worktree difference. That is what makes the empty result
// mean "the tracked worktree realizes the commit HEAD names" without needing any external fact --
// and it is why the index is built from the observed revision rather than the admitted one.
//
// The temp index is named for the ATTEMPT, so two observations running under different attempts cannot
// collide on it. FleetSshAttemptIdentity is a PathSegment admitted through path_segment_is_safe, so
// the path is safe by construction rather than by escaping -- there is no spelling of an attempt that
// makes this argv unportable.
// THE PER-RUN NONCE THAT MAKES THE TEMP INDEX PRIVATE TO THIS PROCESS. The index path was named for
// the attempt ALONE, and both arms carry a CONSTANT attempt, so two folds running concurrently on the
// same host (the timer and a belt tick) shared one GIT_INDEX_FILE: one run's read-tree overwrote the
// other's between read-tree and status, and a wrong clean/dirty verdict came back with no error. The
// nonce is the executor's own process identity -- boot id, pid and start-time ticks from /proc, which
// survives pid reuse; a process that cannot name itself gets no shared path either, so a fold that
// cannot prove its own uniqueness refuses rather than racing.
fn deployed_tree_run_nonce() -> Optional<String> {
  match self_process_identity() {
    SelfIdentified { process: p, pid_namespace: _ } =>
      Present {
        value: join(
          [p.boot_id as String, "-", int_to_decimal_string(value: p.pid), "-", p.start_time as String],
          "",
        ),
      }
    SelfUnidentified { cause: _ } => Absent
  }
}

// THE TEMPORARY INDEX PATH THE OBSERVATION SETS AND CLEANS ITSELF. On the ssh arm the writer and the
// reader are separate fleet-ssh invocations on the far host and only the far-side shell can bridge
// them, so a path written by one must be readable by the next. On the local arm the same path travels
// to every leg in-process. The path is named for the ATTEMPT AND the per-run nonce: the attempt alone
// does not separate two runs of THIS fold (it is constant), and the nonce alone would let two readers
// of different attempts collide on one file. The nonce's characters -- hex boot id, decimal pid and
// ticks, joined by '-' -- are the character class the attempt is admitted under.
fn deployed_tree_temp_index_name(attempt: NonEmptyStr, run_nonce: String) -> String {
  join(["/tmp/gunbc-deployed-tree-index-", attempt as String, "-", run_nonce], "")
}

fn deployed_tree_temp_index_path(locus: DeployedTreeLocus, run_nonce: String) -> String {
  match locus {
    FleetSshTreeLocus { context: c } =>
      deployed_tree_temp_index_name(attempt: c.attempt, run_nonce: run_nonce)
    LocalTreeLocus { attempt: a } =>
      deployed_tree_temp_index_name(attempt: a, run_nonce: run_nonce)
  }
}

// THE CLEANUP IS gnu_coreutils' rm_force_command DELIVERED THROUGH THE SAME DISPATCHER on every
// terminal path of the observation (review 97601 B1). `rm -f` is idempotent, and a residue that a
// cleanup refusal leaves behind is a file no future run can name, because this run's nonce will not
// come again -- so the verdict stands and the refusal is not folded into it. What is NOT acceptable is
// what this fold used to do: name the index for the constant attempt alone, so the timer's refresh and
// a concurrent belt tick raced on one GIT_INDEX_FILE (see the nonce's note above; the ssh arm's
// constant belt_pair_serve_gate_attempt_raw carried the same latent class until the nonce joined the
// path on both arms).

// THE INDEX-BOUND CALLS ARE BUILT IN extdeps.git (git_in_trusted_repository_read_tree_command,
// ..._status_command, ..._ls_files_ignored_command), and WHY THEY LOOK THE WAY THEY DO -- GIT_INDEX_FILE
// as a typed binding because it has no command-line equivalent and `--index-output` is NOT a substitute
// (it redirects writes but still locks the real index, and an existing index.lock is the NORMAL case on
// this host, so a lock-taking observation would fail in proportion to how busy the host is and train
// its readers to ignore it), why --no-sparse-checkout is load-bearing and its absence silent (a missing
// tracked path reading as intentionally absent is a false CLEAN on exactly the failure this fold exists
// to catch), and why the ignored leg exists at all (the sync ships ignored paths and `status` never
// reports them; candidate admission owns the same subject on the SOURCE side) -- is recorded ONCE there,
// beside the words. The three calls receive THE SAME index path this observation allocated, so
// read-tree, status and ls-files all speak about ONE index; that shared identity is what makes the
// reading coherent, and it is also what a shared NAME across runs would destroy (review 97601 B1).

// ONE DELIVERY FOR BOTH ARMS: THE SHARED DISPATCHER, selected by the locus.
// run_argv_over_host_effect_transport (gunbc.host.host_effect_realize) is the host transport's own
// dispatcher -- it takes a typed ArgvCommand and already carries LocalShell (RunArgv), SshShell and
// FleetSsh (fleet-ssh exec), and the fold is no longer in the business of owning a delivery leaf. The
// ADMISSION is the locus: only deployed_tree_local_locus_admit can mint the Local arm, and it mints it
// only when the host's own `hostname -s` reading joins the claimed host (the seal above), so running
// the local route is not a free choice a caller makes -- it is a fact the host agreed to. The earlier
// shape of this fold ran the local arm through a module-local RunArgv leaf with its own result shape,
// which was a second same-host typed-argv reader beside realize_effective_principal_read_on_host's
// inline one, while the transport's typed-argv path refuses LocalShell ON PURPOSE to stop a remote
// subject being read locally by mistake. Review 97601 B2 named the single home; this is it.
//
// WHY THE TYPED-ARGV TRANSPORT'S LocalShell REFUSAL STAYS EXACTLY WHERE IT IS: it gates every
// product's remote-subject reads (host_effect_realize records the ruling and its fail-closed
// intent), and this fold's localness is not a transport preference but an admitted join. Lifting the
// refusal for all callers would let any caller read a REMOTE subject locally; selecting the local arm
// here needs the same-host proof the locus already carries.
//
// A TRANSPORT REFUSAL IS ITS OWN ARM, NEVER A SYNTHETIC EXIT CODE. Rendering a leg that was never
// attempted as `exit_code: 127` manufactures a plausible observation of a host nobody contacted, and
// every downstream reader then cannot distinguish "the command ran and failed" from "no command ran".
// The pure mapping below keeps that distinction testable without dispatching anything.
type DeployedTreeLegOutcome
  = DeployedTreeLegRan { result: SshSessionExecResult }
  | DeployedTreeLegOverran { deadline: Second }
  | DeployedTreeLegNotAttempted { reason: String }

// THE HOST STRING A DEADLINE RECEIPT NAMES. Derived from the locus's own resolved target, so the host a
// leg overran on is spelled the one way it can be; the local arm has no ssh target to name, and naming
// its own host is what a local deadline receipt would want -- there is no ssh session to have overran.
fn deployed_tree_locus_host_text(locus: DeployedTreeLocus) -> String {
  match locus {
    FleetSshTreeLocus { target: t, context: _ } => ssh_target_wire(target: t) as String
    LocalTreeLocus { host: h } => h as String
  }
}

fn deployed_tree_leg_outcome_of(observed: RunArgvTransportOutcome) -> DeployedTreeLegOutcome {
  match observed {
    RunArgvTransportObserved { observed: o } =>
      DeployedTreeLegRan {
        result: SshSessionExecResult { exit_code: o.exit_code, success: o.success, stdout: o.stdout, stderr: o.stderr },
      }
    RunArgvTransportRefused { reason: why } => DeployedTreeLegNotAttempted { reason: why }
  }
}

// THE PRESERVING VIEW, for this module's own legs. Three arms, each named, no wildcard, so a future arm
// of the carrier cannot be read as "the leg ran". The deadline stays a Second here; the text is built
// where the verdict is built, from leg + host + argv + deadline together, because a receipt that cannot
// name which leg died on which host at what ceiling is indistinguishable from no receipt.
fn deployed_tree_leg_outcome_of_preserving(observed: HostEffectArgvOutcome) -> DeployedTreeLegOutcome {
  match observed {
    HostEffectArgvObserved { observed: o } =>
      DeployedTreeLegRan {
        result: SshSessionExecResult { exit_code: o.exit_code, success: o.success, stdout: o.stdout, stderr: o.stderr },
      }
    HostEffectArgvRefused { reason: why } => DeployedTreeLegNotAttempted { reason: why }
    HostEffectArgvOverran { deadline: d } => DeployedTreeLegOverran { deadline: d }
  }
}

// The incident leg's command, exposed as a name a claim can read. The observation call site below
// passes THIS to the incident leg, so a claim comparing it against the shared builder reads the
// value the module actually sends rather than recomputing the same expression: plant a different
// command here and that claim goes red. It forwards to the one argv authority and adds none.
fn deployed_tree_incident_leg_command(repo: NonEmptyStr) -> ArgvCommand {
  git_in_trusted_repository_head_revision_command(repo: repo)
}

fn deployed_tree_leg(locus: DeployedTreeLocus, command: ArgvCommand) -> DeployedTreeLegOutcome {
  deployed_tree_leg_outcome_of_preserving(
    observed: run_argv_over_host_effect_transport_preserving_overrun(
      command: command,
      transport: deployed_tree_locus_transport(locus: locus),
    ),
  )
}

// FOUR STATES, NONE COLLAPSIBLE, AND THE THIRD IS THE ONE THE EXISTING STANDING CANNOT EXPRESS.
//
// A deployed tree at the right commit with modified tracked files is NOT converged and NOT drifted:
// its revision agrees while its bytes do not, so reporting it as either is wrong in a way that
// matters. `origin_main_revision_observe` `fleet_revision_standing` compares revisions alone and has no arm
// for it, which means a hand-edited deployed file reads as converged there and reads as modified here.
// THE REFUSAL IS TYPED TO WHAT IS DECIDABLE, AND NO FURTHER. The tempting split is "not a git
// repository" versus "permission denied on .git", because those have different remedies. It is NOT
// AVAILABLE: git exits 128 for a missing repository, for an unreadable .git, AND for a valid
// repository with no commits -- measured, all three. Separating them means matching stderr prose,
// which is a heuristic, and gunbc.design_argument::closed_grounded_substrate holds that a heuristic is never necessary in a closed system: the
// richer source either exists or can be written, and here it does not exist yet.
//
// So the arms are the distinctions the exit status actually carries, and the stderr is CARRIED
// UNINTERPRETED rather than parsed. A reader gets the remedy; the model does not guess at it. The
// split that matters operationally is already here and was previously collapsed into prose: a leg
// that never ran (the credential or transport is wrong -- nothing was asked of the host) is a
// different situation from a leg that ran and failed (the host answered, and its answer is bad),
// and a consumer can now branch on that without reading a sentence.
type DeployedTreeUnobservableCause
  = TreeLegNotAttempted { leg: String, reason: String }
  | TreeCommandFailed { leg: String, exit_code: Int, stderr: String }
  // The leg RAN and was killed by its own total-wall deadline. It is neither a refusal (something
  // was asked of the host) nor a command failure (the host never answered), so it is its own arm,
  // and it carries the deadline as a VALUE alongside the host and the exact argv it tripped on.
  | TreeLegDeadlineExceeded { leg: String, host: String, argv: List<String>, deadline: Second }
  | TreeRevisionUndecodable { text: String }
  | TreeStatusUnreadable { detail: String }

type DeployedTreeObservation
  = DeployedTreeObserved { revision: GitObjectId, tree: GitObjectId, content: DeployedTreeContentState }
  | DeployedTreeUnobservable { cause: DeployedTreeUnobservableCause }

// ONE RENDERING, so every consumer that needs prose derives it from the arms rather than each
// re-inventing a sentence -- which is how one fact acquires several spellings.
fn deployed_tree_unobservable_text(cause: DeployedTreeUnobservableCause) -> String {
  match cause {
    TreeLegNotAttempted { leg: leg, reason: why } =>
      join(["the ", leg, " leg was never attempted, so the host was not asked: ", why], "")
    TreeCommandFailed { leg: leg, exit_code: code, stderr: err } =>
      join(["the ", leg, " leg ran and failed (exit ", int_to_decimal_string(value: code), "): ", err], "")
    TreeLegDeadlineExceeded { leg: leg, host: host, argv: argv, deadline: d } =>
      join([
        "the ", leg, " leg on host ", host, " overran its ", int_to_decimal_string(value: second_count(s: d)),
        "s wall-clock deadline (argv=", join(argv, " "),
        "); it ran too long and its process group was killed before the host answered -- an overrun is neither a refusal nor a command failure",
      ], "")
    TreeRevisionUndecodable { text: t } =>
      join(["the revision was read but is not a decodable git object id: ", t], "")
    TreeStatusUnreadable { detail: d } =>
      join(["the deployed tree answered, but its state is not readable and is not assumed clean: ", d], "")
  }
}

// The ONE construction of the deadline cause. Every deadline-bearing leg routes through here so the
// shape (leg, host, argv, deadline) has a single spelling and a single witness.
fn deployed_tree_leg_overran_cause(
  leg: String,
  host: String,
  argv: List<String>,
  deadline: Second,
) -> DeployedTreeUnobservableCause {
  TreeLegDeadlineExceeded { leg: leg, host: host, argv: argv, deadline: deadline }
}

// MODIFIED CARRIES THE PATHS IT SAW, as a NonEmptyStr so that "modified, with nothing to show for it"
// has no constructor. An empty diff body and a clean tree are the same bytes, so a single field with
// emptiness meaning clean would be the state-space conflation this coproduct exists to prevent -- and
// the receipt ruling applies here as everywhere: a verdict must name what it observed, not merely that
// it disagreed.
type DeployedTreeContentState
  = DeployedScopeMatchesCommit
  | DeployedScopeDiverged { changed_paths: NonEmptyStr }

// A SCAN THAT CANNOT PARSE ITS INPUT REFUSES; IT DOES NOT ANSWER CLEAN. Both refusals are the ones
// candidate admission already names, because the grammar is the same grammar: a field that is neither
// a well-formed record nor a rename source, and a list that ends owing a rename source. Rendering
// either as an empty change set would be the empty-observation narrow -- the deploy proceeds because
// nothing was found, when in fact nothing was readable.
type DeployedTreeContentReading
  = ContentRead { state: DeployedTreeContentState }
  | ContentUnreadable { detail: String }

fn deployed_tree_content_reading(entries_nul: String, ignored_nul: String) -> DeployedTreeContentReading {
  let scan = scan_checkout_status(entries_nul: entries_nul)
  let ignored_deployed = scan_ignored_deployed_paths(paths_nul: ignored_nul)
  if scan.malformed {
    ContentUnreadable {
      detail: "git status --porcelain=v1 -z produced a field that is neither a well-formed record nor a rename source",
    }
  } else if scan.expect_rename_source {
    ContentUnreadable {
      detail: "git status --porcelain=v1 -z ended on a rename or copy record with no source field; the entry list is truncated",
    }
  } else {
    let changed = list_append(
      scan.staged,
      list_append(scan.tracked, list_append(scan.untracked, ignored_deployed)),
    )
    if length(changed) == 0 {
      ContentRead { state: DeployedScopeMatchesCommit }
    } else {
      ContentRead { state: DeployedScopeDiverged { changed_paths: string_concat_join(fields: changed, separator: " ") as NonEmptyStr } }
    }
  }
}

// THE FOUR LEGS ARE ONE PER-HOST OBSERVATION AND NOT ONE PER-TIME OBSERVATION, AND THAT REMAINS OPEN.
// The sealed locus makes a cross-HOST join unrepresentable; it does not make the readings atomic. A
// tree sync landing between the revision leg and the status leg yields revision D joined to a clean
// reading taken at revision L, and the pair never described one target state. The temp index narrows
// this -- the status and ignored legs are both bound to the revision the FIRST leg observed, so a
// mid-flight sync presents as divergence rather than as a false clean -- but it does not close it: the
// worktree could move to L in full while the index still names D, and every path would then read as
// changed, which is a false MODIFIED rather than a false CONVERGED. Fail-safe in direction, still
// wrong in fact.
//
// RUNG: mitigatable. NEXT-RUNG TRIGGER: the deployment execution lease. The two candidate closers are
// one git operation carrying revision and state together (porcelain v2 `--branch` emits `# branch.oid`
// beside the entries) and an exclusive lease held across observation, publication and read-back. The
// second is required anyway -- publication has to hold it -- so the atomic read arrives as a property
// of the lease rather than as a separate mechanism, and building the v2 scanner first would be a
// second grammar for one concept that the lease then obsoletes.
// BOTH READINGS OR NEITHER. The revision read is attempted first and a failure there ends the
// observation, because a modification count without a revision to attach it to is a fact about no
// particular commit -- and reporting it beside a fabricated or absent revision is the state-space
// conflation this type exists to prevent.
// THE OBSERVATION AT A FLEET HOST'S RESOLVED TARGET. A target that does not resolve is a leg that was
// not attempted, read as unobservable with the target's own refusal, never a leg run at unexamined
// text.
fn observe_deployed_tree_at(context: FleetSshExecutionContext, target: SshTargetResolution, repo: NonEmptyStr) -> DeployedTreeObservation {
  match target {
    SshTargetResolved { target: t } => observe_deployed_tree(locus: deployed_tree_locus(context: context, target: t, repo: repo))
    SshTargetRefused { endpoint: e, refusal: why } =>
      DeployedTreeUnobservable { cause: TreeLegNotAttempted { leg: "target", reason: ssh_target_refusal_text(endpoint: e, refusal: why) } }
  }
}

// EVERY OBSERVATION OWNS ITS INDEX FROM read-tree THROUGH BOTH READS, AND CLEANS IT UP ON EVERY
// TERMINAL PATH (review 97601 B1, reproduced with real git by the reviewing side: reader A read-tree's
// its revision, reader B -- the timer's refresh and a ServedObservationObligation, which emit.dag
// explicitly allows to run at the same time -- overwrites the SHARED index with a checkout to
// revision B, and A's status comes back EMPTY: a false clean, no error, standing published as
// converged). Ownership is what the per-run name buys; the acquisition refusing to name a run is
// therefore itself a refusal to observe, and the cleanup runs whatever the verdict said, including on
// the revision-leg refusals (rm -f on a file that was never created is success).
fn observe_deployed_tree(locus: DeployedTreeLocus) -> DeployedTreeObservation {
  match deployed_tree_run_nonce() {
    Absent =>
      DeployedTreeUnobservable {
        cause: TreeLegNotAttempted {
          leg: "temporary index identity",
          reason: "the executor could not name its own process identity, so this observation could not own an index and no reading of it could be told apart from a sibling fold's",
        },
      }
    Present { value: run_nonce } => {
      let index_path = deployed_tree_temp_index_path(locus: locus, run_nonce: run_nonce)
      let verdict = observe_deployed_tree_owned(locus: locus, index_path: index_path)
      deployed_tree_discard_index(locus: locus, index_path: index_path, verdict: verdict)
    }
  }
}

// THE CLEANUP, AFTER THE VERDICT AND WITHOUT TOUCHING IT: a residue under this run's nonce is a file
// no future run can name, so the refusal leaks nothing that can mislead -- the only failure mode it
// leaves is a file in /tmp, and discarding a true verdict over it would be a false 409, the exact
// class this fold's 2026-10-10 outage was.
fn deployed_tree_discard_index(
  locus: DeployedTreeLocus,
  index_path: String,
  verdict: DeployedTreeObservation,
) -> DeployedTreeObservation {
  // THE CLEANUP LEG'S OUTCOME IS DELIBERATELY NOT READ -- the verdict is already settled and the discard
  // is an idempotent rm -f -- but each arm is named rather than caught, so a new arm of the leg sum can
  // never arrive here and be quietly swallowed as "the verdict came back".
  let cleanup = deployed_tree_leg(locus: locus, command: rm_force_command(path: index_path))
  match cleanup {
    DeployedTreeLegRan { result: _ } => verdict
    DeployedTreeLegOverran { deadline: _ } => verdict
    DeployedTreeLegNotAttempted { reason: _ } => verdict
  }
}

fn observe_deployed_tree_owned(
  locus: DeployedTreeLocus,
  index_path: String,
) -> DeployedTreeObservation {
  match deployed_tree_leg(
    locus: locus,
    command: deployed_tree_incident_leg_command(repo: deployed_tree_locus_repo(locus: locus)),
  ) {
    DeployedTreeLegNotAttempted { reason: why } =>
      DeployedTreeUnobservable { cause: TreeLegNotAttempted { leg: "revision", reason: why } }
    DeployedTreeLegOverran { deadline: d } =>
      DeployedTreeUnobservable {
        cause: deployed_tree_leg_overran_cause(
            leg: "revision",
            host: deployed_tree_locus_host_text(locus: locus),
            argv: revision_argv,
            deadline: d,
          ),
      }
    DeployedTreeLegRan { result: rev } =>
      if rev.exit_code != 0 {
        DeployedTreeUnobservable {
          cause: TreeCommandFailed { leg: "revision", exit_code: rev.exit_code, stderr: rev.stderr },
        }
      } else {
        match git_object_id_from_untagged_hex(hex: trim(s: rev.stdout)) {
          Absent =>
            DeployedTreeUnobservable { cause: TreeRevisionUndecodable { text: trim(s: rev.stdout) } }
          Present { value: oid } =>
            match deployed_tree_leg(
              locus: locus,
              command: git_in_trusted_repository_head_root_tree_command(repo: deployed_tree_locus_repo(locus: locus)),
            ) {
              DeployedTreeLegNotAttempted { reason: why } =>
                DeployedTreeUnobservable { cause: TreeLegNotAttempted { leg: "root tree", reason: why } }
              DeployedTreeLegOverran { deadline: d } =>
                DeployedTreeUnobservable {
                  cause: deployed_tree_leg_overran_cause(
                      leg: "root tree",
                      host: deployed_tree_locus_host_text(locus: locus),
                      command: git_in_trusted_repository_head_root_tree_command(repo: deployed_tree_locus_repo(locus: locus)),
                      deadline: d,
                    ),
                }
              DeployedTreeLegRan { result: tr } =>
                if tr.exit_code != 0 {
                  DeployedTreeUnobservable {
                    cause: TreeCommandFailed { leg: "root tree", exit_code: tr.exit_code, stderr: tr.stderr },
                  }
                } else {
                  match git_object_id_from_untagged_hex(hex: trim(s: tr.stdout)) {
                    Absent =>
                      DeployedTreeUnobservable { cause: TreeRevisionUndecodable { text: trim(s: tr.stdout) } }
                    Present { value: tree_oid } =>
                      observe_deployed_tree_against_revision(
                        locus: locus,
                        revision: oid,
                        tree: tree_oid,
                        revision_hex: trim(s: rev.stdout),
                        index_path: index_path,
                      )
                  }
                }
            }
        }
      }
  }
}

// THE TEMP INDEX IS BUILT FROM THE REVISION THE HOST IS ACTUALLY ON, not from the admitted one. That
// keeps this observation answering ONE question -- does the deployed scope realize the commit HEAD names --
// and leaves "is that the right commit" to the standing. Building it from the desired revision would
// fuse the two, and a host on the wrong commit would then report modifications for every path that
// differs between the two revisions, which is drift wearing a modification's label.
fn observe_deployed_tree_against_revision(
  locus: DeployedTreeLocus,
  revision: GitObjectId,
  tree: GitObjectId,
  revision_hex: String,
  index_path: String,
) -> DeployedTreeObservation {
  match deployed_tree_leg(
    locus: locus,
    command: git_in_trusted_repository_read_tree_command(
      repo: deployed_tree_locus_repo(locus: locus),
      index_path: index_path,
      revision_hex: revision_hex,
    ),
  ) {
    DeployedTreeLegNotAttempted { reason: why } =>
      DeployedTreeUnobservable { cause: TreeLegNotAttempted { leg: "index materialization", reason: why } }
    DeployedTreeLegOverran { deadline: d } =>
      DeployedTreeUnobservable {
        cause: deployed_tree_leg_overran_cause(
            leg: "index materialization",
            host: deployed_tree_locus_host_text(locus: locus),
            command: git_in_trusted_repository_read_tree_command(repo: deployed_tree_locus_repo(locus: locus), revision_hex: revision_hex, index_path: index_path),
            deadline: d,
          ),
      }
    DeployedTreeLegRan { result: rt } =>
      if rt.exit_code != 0 {
        DeployedTreeUnobservable {
          cause: TreeCommandFailed { leg: "index materialization", exit_code: rt.exit_code, stderr: rt.stderr },
        }
      } else {
        match deployed_tree_leg(
          locus: locus,
          command: git_in_trusted_repository_status_command(
            repo: deployed_tree_locus_repo(locus: locus),
            index_path: index_path,
          ),
        ) {
          DeployedTreeLegNotAttempted { reason: why2 } =>
            DeployedTreeUnobservable {
              cause: TreeLegNotAttempted { leg: "worktree comparison", reason: why2 },
            }
          DeployedTreeLegOverran { deadline: d } =>
            DeployedTreeUnobservable {
              cause: deployed_tree_leg_overran_cause(
                  leg: "worktree comparison",
                  host: deployed_tree_locus_host_text(locus: locus),
                  command: git_in_trusted_repository_status_command(repo: deployed_tree_locus_repo(locus: locus), index_path: index_path),
                  deadline: d,
                ),
            }
          DeployedTreeLegRan { result: st } =>
            if st.exit_code != 0 {
              DeployedTreeUnobservable {
                cause: TreeCommandFailed { leg: "worktree comparison", exit_code: st.exit_code, stderr: st.stderr },
              }
            } else {
              match deployed_tree_leg(
                locus: locus,
                command: git_in_trusted_repository_ls_files_ignored_command(
                  repo: deployed_tree_locus_repo(locus: locus),
                  index_path: index_path,
                ),
              ) {
                DeployedTreeLegNotAttempted { reason: why3 } =>
                  DeployedTreeUnobservable {
                    cause: TreeLegNotAttempted { leg: "ignored deployed paths", reason: why3 },
                  }
                DeployedTreeLegOverran { deadline: d } =>
                  DeployedTreeUnobservable {
                    cause: deployed_tree_leg_overran_cause(
                        leg: "ignored deployed paths",
                        host: deployed_tree_locus_host_text(locus: locus),
                        command: git_in_trusted_repository_ls_files_ignored_command(repo: deployed_tree_locus_repo(locus: locus), index_path: index_path),
                        deadline: d,
                      ),
                  }
                DeployedTreeLegRan { result: ig } =>
                  if ig.exit_code != 0 {
                    DeployedTreeUnobservable {
                      cause: TreeCommandFailed {
                        leg: "ignored deployed paths",
                        exit_code: ig.exit_code,
                        stderr: ig.stderr,
                      },
                    }
                  } else {
                    match deployed_tree_content_reading(entries_nul: st.stdout, ignored_nul: ig.stdout) {
                      ContentUnreadable { detail: d } =>
                        DeployedTreeUnobservable { cause: TreeStatusUnreadable { detail: d } }
                      ContentRead { state: s } =>
                        DeployedTreeObserved { revision: revision, tree: tree, content: s }
                    }
                  }
              }
            }
        }
      }
  }
}

// FOUR ARMS, AND THE THIRD IS WHY THIS EXISTS. `gunbc.fleet.origin_main_revision_observe` `fleet_revision_standing`
// compares revisions and nothing else, so a deployed tree sitting at the admitted commit with edited
// tracked files reads as CONVERGED there. It is not: its revision agrees while its bytes do not, and
// the whole point of publishing a tree is the bytes. That state gets its own arm here rather than
// being folded into drift, because the remedies differ -- drift is answered by moving to another
// commit, modification by restoring the one already named.
type DeployedTreeStanding
  = DeployedTreeConverged { revision: GitObjectId }
  | DeployedTreeRevisionDrifted { desired: GitObjectId, local: GitObjectId }
  | DeployedTreeModifiedAtRevision { revision: GitObjectId, changed_paths: NonEmptyStr }
  | DeployedTreeStandingUnobserved { cause: DeployedTreeUnobservableCause }

// DRIFT DOMINATES MODIFICATION, and the reason is about meaning rather than precedence. The
// modification state answers "do the bytes match THE COMMIT THE TREE IS ON". When that commit is not
// the admitted one, a clean answer and a dirty answer are both statements about a revision nobody
// asked for, so reporting either as the standing would attach a true fact to the wrong subject.
// Drift is therefore reported first and the modification state is not consulted -- not because it is
// less important, but because at that point it is not evidence about the question.
//
// A PURE FOLD: observation and desired revision in, standing out, no effect. The effectful read
// stays at the call site, which is what lets a witness drive every arm through the real decision
// without a host -- the same extraction the belt revision gate needed before its arms could be
// tested at all.
fn deployed_tree_standing(
  desired: GitObjectId,
  observation: DeployedTreeObservation,
) -> DeployedTreeStanding {
  match observation {
    DeployedTreeUnobservable { cause: c } => DeployedTreeStandingUnobserved { cause: c }
    DeployedTreeObserved { revision: local, content: content } =>
      if !git_object_id_eq(left: desired, right: local) {
        DeployedTreeRevisionDrifted { desired: desired, local: local }
      } else {
        match content {
          DeployedScopeMatchesCommit => DeployedTreeConverged { revision: local }
          DeployedScopeDiverged { changed_paths: body } =>
            DeployedTreeModifiedAtRevision { revision: local, changed_paths: body }
        }
      }
  }
}

// ONE PREDICATE FOR THE ONLY QUESTION AN ACTUATOR MAY ASK, so no caller re-derives "is this good
// enough" from the arms and quietly admits a third state. Exactly one arm is publication-satisfied;
// every other arm, including the unobserved one, is not -- an unobserved standing treated as
// satisfied would be the empty-observation narrow, could-not-look rendered as nothing-is-wrong.
fn deployed_tree_standing_is_converged(standing: DeployedTreeStanding) -> Bool {
  match standing {
    DeployedTreeConverged { revision: _ } => true
    DeployedTreeRevisionDrifted { desired: _, local: _ } => false
    DeployedTreeModifiedAtRevision { revision: _, changed_paths: _ } => false
    DeployedTreeStandingUnobserved { cause: _ } => false
  }
}


// THE ROOT-TREE JOIN: candidate tree OID (read from the deploying checkout at R) equals the deployed
// tree OID, AND the deployed scope matches its commit. Both are required; a tree that matches by
// object identity but carries a modified deployed path is still not R.
type DeployedRootTreeStanding
  = DeployedRootTreeMatches { tree_hex: String }
  | DeployedRootTreeMismatch { candidate_hex: String, deployed_hex: String }
  | DeployedRootTreeScopeDiverged { tree_hex: String, changed_paths: NonEmptyStr }
  | DeployedRootTreeUnobserved { cause: DeployedTreeUnobservableCause }

fn deployed_root_tree_standing(candidate_tree_hex: String, observation: DeployedTreeObservation) -> DeployedRootTreeStanding {
  match observation {
    DeployedTreeUnobservable { cause: c } => DeployedRootTreeUnobserved { cause: c }
    DeployedTreeObserved { revision: _, tree: t, content: content } => {
      let deployed_hex = git_object_id_wire_hex(oid: t) as String
      if deployed_hex != candidate_tree_hex {
        DeployedRootTreeMismatch { candidate_hex: candidate_tree_hex, deployed_hex: deployed_hex }
      } else {
        match content {
          DeployedScopeMatchesCommit => DeployedRootTreeMatches { tree_hex: deployed_hex }
          DeployedScopeDiverged { changed_paths: p } => DeployedRootTreeScopeDiverged { tree_hex: deployed_hex, changed_paths: p }
        }
      }
    }
  }
}

fn deployed_root_tree_standing_text(s: DeployedRootTreeStanding) -> String {
  match s {
    DeployedRootTreeMatches { tree_hex: h } => join(["deployed root tree ", h, " matches the candidate"], "")
    DeployedRootTreeMismatch { candidate_hex: c, deployed_hex: d } => join(["deployed root tree ", d, " is not the candidate tree ", c], "")
    DeployedRootTreeScopeDiverged { tree_hex: h, changed_paths: p } => join(["deployed root tree ", h, " matches but the deployed scope diverged: ", p as String], "")
    DeployedRootTreeUnobserved { cause: c } => join(["deployed root tree unobserved: ", deployed_tree_unobservable_text(cause: c)], "")
  }
}

// THE SAME INSTRUMENT, READ ON THE MACHINE THAT RUNS THE CALLER.
//
// The remote arm exists to observe a tree that is NOT on this machine: it carries a credential and a
// trust policy because a cross-host reading is a claim about a host the caller cannot see. When the
// executor IS the subject host, that ceremony proves only that the executor holds the fleet key --
// about a machine already standing here -- and it fails CLOSED wherever no credential agent exists,
// which is every systemd unit live_deploy emits (none carries SSH_AUTH_SOCK, and
// gunbc.fleet.fleet_key_agent is CI-runner-only). srv1's standings refresh died exactly there: the
// fold's pair gate took its own host's tree over FleetSsh, every run since 2026-11-22T02:12Z refused
// with "SSH_AUTH_SOCK is unset or empty", and '/' has served the frozen 2026-10-10 body at 409 since.
//
// So the local arm is admitted by the ONE fact that makes a local reading honest: the kernel's own
// answer for this machine's hostname, joined through the fleet registry's one join authority with the
// host the caller CLAIMS to be reading (gunbc.hostname_allocation::observed_host_selector_join). A
// caller cannot choose this arm; it can only ask whether the machine it is standing on is the host it
// named, and the join answers. No join, no locus -- and the ssh arm stays the only way to observe any
// other machine, so the cross-host conflation this module exists to prevent keeps its single mint.
data deployed_tree_local_attempt_raw: String = "deployed-tree-local-read"

type DeployedTreeLocalAdmission
  = DeployedTreeLocalAdmitted { locus: DeployedTreeLocus }
  | DeployedTreeLocalAdmissionRefused { cause: String }

// THE JOIN, PURE, so the arm selection has a witness that does not have to spawn a hostname binary:
// expected is the host the caller names, observed is what the kernel said. Both sides go through the
// registry; neither spelling is trusted as a host on its own. The `_in` form takes the ROSTER as an
// argument -- the same join, the same two-sided resolution, a caller-supplied roster -- because the
// wet live pairing (dag/test/manual/deployed_tree_local_arm_live_pairing.dag) must join THIS container
// through the production join over a fixture entry, and the production form below is that same code
// with the fleet roster welded back in. No second join exists.
fn deployed_tree_local_admission_verdict_in(
  allocations: List<HostnameAllocation>,
  host: HostIdentity,
  observed_hostname: String,
) -> ObservedHostSelectorJoin {
  observed_host_selector_join_in(allocations: allocations, expected: host as String, observed: observed_hostname)
}

fn deployed_tree_local_admission_verdict(
  host: HostIdentity,
  observed_hostname: String,
) -> ObservedHostSelectorJoin {
  deployed_tree_local_admission_verdict_in(
    allocations: fleet_machine_registry,
    host: host,
    observed_hostname: observed_hostname,
  )
}

// THE SANCTIONED MINT FOR THE LOCAL ARM. It reads this machine's hostname over LocalShell (a typed
// host operation, not a caller-supplied command line) and admits only when the registry join agrees; the
// admitted locus then seals the JOINED identity with the repo path, exactly as the ssh arm seals the
// resolved target with its repo path. sole_constructor confines construction to this module; the
// admission IS the security boundary at production sites.
fn deployed_tree_local_locus_admit(
  host: HostIdentity,
  repo: NonEmptyStr,
) -> DeployedTreeLocalAdmission {
  deployed_tree_local_locus_admit_in(allocations: fleet_machine_registry, host: host, repo: repo)
}

fn deployed_tree_local_locus_admit_in(
  allocations: List<HostnameAllocation>,
  host: HostIdentity,
  repo: NonEmptyStr,
) -> DeployedTreeLocalAdmission admit_callers: [
  // The production wrapper, which passes the fleet registry and nothing else.
  decl_ref(module_path: "gunbc.live_deploy.deployed_tree_observation", decl_name: "deployed_tree_local_locus_admit"),
  // The manual live pairing, run by hand on a host that joins NO fleet registry: it needs the
  // real admit and observe over the shared dispatcher with a one-row fixture roster, because its
  // own hostname cannot join srv1. It is listed exactly for that; the roster argument is otherwise
  // not open to anyone, so no caller may map its own hostname to a host it does not own.
  decl_ref(module_path: "test.manual.deployed_tree_local_arm_live_pairing", decl_name: "live_pairing_local_route_and_index_ownership"),
] {
  match hostname_short_read(transport: LocalShell) {
    HostnameShortCaptureRefused { reason: why } =>
      DeployedTreeLocalAdmissionRefused {
        cause: join(["the local host identity is unobservable, so the deployed tree is undecidable locally: ", why], ""),
      }
    HostnameShortCaptured { value: observed } =>
      local_admission_from_verdict(
        verdict: deployed_tree_local_admission_verdict_in(
          allocations: allocations,
          host: host,
          observed_hostname: observed,
        ),
        repo: repo,
      )
  }
}

// PURE locus construction from an already-computed verdict. sole_constructor confines LocalTreeLocus
// to this module; admit_callers restricts who outside may call this mint. The witness module is listed
// so that structural claims on the locus accessors can proceed without spawning a hostname binary.
fn local_admission_from_verdict(
  verdict: ObservedHostSelectorJoin,
  repo: NonEmptyStr,
) -> DeployedTreeLocalAdmission admit_callers: [
  decl_ref(module_path: "gunbc.live_deploy.deployed_tree_observation", decl_name: "deployed_tree_local_locus_admit"),
  decl_ref(module_path: "gunbc.live_deploy.deployed_tree_observation", decl_name: "deployed_tree_local_locus_admit_in"),
  decl_ref(module_path: "test.claim.live_deploy.deployed_tree_local_arm_witness", decl_name: "local_locus_for_srv1"),
  decl_ref(module_path: "test.claim.live_deploy.deployed_tree_local_arm_witness", decl_name: "witness_a_mismatched_host_is_never_admitted"),
] {
  match verdict {
    ObservedHostSelectorAgreed { host: agreed } =>
      DeployedTreeLocalAdmitted {
        locus: LocalTreeLocus {
          host: agreed,
          repo: repo,
          attempt: deployed_tree_local_attempt_raw,
        },
      }
    ObservedHostSelectorJoinRefused { cause: c } =>
      DeployedTreeLocalAdmissionRefused {
        cause: join(["this machine is not the host the deployed tree is claimed to sit on: ", observed_host_join_refusal_text(cause: c)], ""),
      }
  }
}
