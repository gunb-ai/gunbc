module gunbc.live_deploy.deployed_tree_observation

import std.types { String, NonEmptyStr, List, Bool }
import std.algebra { trim }
import extdeps.git
import extdeps.git.object_store { GitObjectId, git_object_id_from_untagged_hex, git_object_id_eq }
import extdeps.ssh.session { SshSessionExecResult }
import gunbc.fleet_known_hosts_anchor { FleetSshExecutionContext, SshTarget }
import gunbc.host_effect_realize {
  run_typed_argv_transport,
  TypedArgvExecOutcome,
  TypedArgvExecConverged,
  TypedArgvExecRefused,
  HostEffectTransport,
  FleetSsh,
}

// ONE HOST, SEALED WITH ITS CREDENTIAL AND ITS REPO PATH, SO A CROSS-HOST JOIN HAS NO CONSTRUCTOR.
//
// The revision and the tree state are two facts that only mean something together: the deployed tree
// IS the admitted revision exactly when the revision matches AND nothing has been modified since.
// If each were observed through its own host parameter, a join could read the revision from one
// machine and the modification state from another and report a convergence about neither -- and it
// would typecheck, because two host-parameterized observations and one join is a well-formed program
// with no arm in which to refuse.
//
// So neither observation takes a host. Both are taken THROUGH this locus, and the observation carries
// the locus it was taken through, which is why `observe_deployed_tree` returns BOTH facts from ONE
// call rather than exposing two readers and a join. There is no constructor for the pair other than
// the one that takes both readings in a single traversal of a single locus, so the mixed-host verdict
// is unrepresentable rather than refused.
//
// `FleetSshExecutionContext` deliberately does not carry a host -- it carries the attempt identity,
// the trust policy and the credential, all of which are per-ATTEMPT and shared across the hosts an
// attempt touches. Binding the host here rather than widening that context keeps one attempt able to
// observe many hosts while keeping any single observation about exactly one.
type DeployedTreeLocus sole_constructor {
  context: FleetSshExecutionContext
  target: SshTarget
  repo: NonEmptyStr
}

fn deployed_tree_locus(
  context: FleetSshExecutionContext,
  target: SshTarget,
  repo: NonEmptyStr,
) -> DeployedTreeLocus {
  DeployedTreeLocus { context: context, target: target, repo: repo }
}

fn deployed_tree_locus_transport(locus: DeployedTreeLocus) -> HostEffectTransport {
  FleetSsh { target: locus.target, context: locus.context }
}

// THE INSTRUMENT IS GIT, AND IT IS TWO SINGLE COMMANDS BECAUSE IT HAS TO BE.
//
// The portable-word alphabet admits no pipe, so a content digest of the deployed directory cannot be
// a shell pipeline -- and that constraint turned out to point at a better instrument than the one it
// forbade. git is ALREADY the content-identity authority for the tracked set, and the tracked set is
// exactly what the working-tree rsync leg ships. So there is no digest to compute, no second content
// domain to normalize, and no dependency on the exclusion authority: comparing a source tree against
// a deployed directory would compare two different projections and disagree forever, which fails safe
// and is indistinguishable from real drift, which is how a signal gets silenced.
// THE ARGV TAKES THE REPO, NOT THE LOCUS, and that is a modelling fact rather than a testing
// convenience: these words are a function of WHICH TREE is being asked about and of nothing else --
// the credential and the endpoint decide where the question is delivered, never what it says. Taking
// the whole locus would also make the builders unreachable to any witness, because the execution
// context is sealed with an admitted caller list and no test can mint one. A wall that makes the
// wrong factoring untestable is the wall doing its job.
fn deployed_tree_revision_argv(repo: NonEmptyStr) -> List<String> {
  ["git", "-C", repo as String, "rev-parse", "HEAD"]
}

// `git diff --name-only HEAD` AND NOT `git status`, AND THE REASON IS A PROPERTY OF THIS DEPLOY.
// The .git leg is a WHITELIST sync -- HEAD, objects, packed-refs, refs -- and its own carrier note
// lists what never crosses: "config, config.worktree, INDEX, hooks, logs". So after a CORRECT sync the
// deployed repo is in a state git never produces on its own: HEAD and objects at the new revision, the
// worktree at the new revision, and .git/index still recording whatever the target held before. git
// status compares HEAD to index to worktree, so with a stale index every path that changed reports
// modified in BOTH columns, permanently, on a host that is exactly right.
//
// MEASURED, not reasoned: a repo at D with its index restored from L reports `MM f.txt` from
// `status --porcelain --untracked-files=no`, while the same command on the same repo with a correct
// index reports nothing. `git diff --name-only HEAD` compares worktree CONTENT against HEAD's tree
// and tolerates the stale index -- empty when the host is right, naming the path when a tracked file
// is actually wrong, empty again on restore. All three arms were driven.
//
// It also dissolves the untracked question rather than managing it with a flag: `git diff HEAD` has no
// untracked concept, so the subject is exactly "do the tracked bytes equal this commit" and there is no
// option for a later reader to simplify away. Untracked-but-shipped remains candidate admission's
// class, which already owns and refuses it.
//
// THE MIRROR FAILURE WAS TESTED AND DOES NOT REACH US. git may skip re-hashing when stat data matches
// the index, and rsync -t preserves mtimes, which would be a false CLEAN -- the silent direction. But
// git's stat cache records ctime too, and ctime cannot be set by touch or preserved by rsync: a synced
// file's ctime is the sync time, so the cache never matches and git re-hashes unconditionally. A
// deliberate same-size, mtime-restored content change was caught. The property that makes the index
// stale is the same one that blocks the silent failure.
// ONE PRECONDITION, CLEAN TODAY AND WITH AN ENFORCEABLE HOME. `git diff HEAD` compares worktree
// content to HEAD's blobs THROUGH gitattributes, so a clean/smudge filter, `text=auto`, `eol=`, or
// `working-tree-encoding` would make it report clean when the deployed bytes differ from the blob
// bytes by normalization -- and rsync ships bytes, so that is not the claim wanted. Measured: zero
// occurrences of text=, eol=, filter= or working-tree-encoding in .gitattributes, which carries only
// `linguist-language` (presentation) and `merge=generated-artifact` (merge driver, no clean/smudge).
// So the comparison is raw bytes today. Unlike most preconditions this one has an AUTHORITY rather
// than only an inspection: .gitattributes is generated from gunbc.gitattributes_emit, so a refusal to
// emit a normalizing attribute would make the premise unwritable instead of true-by-inspection. That
// row lands with the publication vertical rather than ahead of it, because reaching the bad state
// requires someone to author a normalizing row in a generated file, which is not an accident.
fn deployed_tree_status_argv(repo: NonEmptyStr) -> List<String> {
  ["git", "-C", repo as String, "diff", "--name-only", "HEAD"]
}

// A TRANSPORT REFUSAL IS ITS OWN ARM, NEVER A SYNTHETIC EXIT CODE. Rendering a leg that was never
// attempted as `exit_code: 127` manufactures a plausible observation of a host nobody contacted, and
// every downstream reader then cannot distinguish "the command ran and failed" from "no command ran".
type DeployedTreeLegOutcome
  = DeployedTreeLegRan { result: SshSessionExecResult }
  | DeployedTreeLegNotAttempted { reason: String }

fn deployed_tree_leg(locus: DeployedTreeLocus, argv: List<String>) -> DeployedTreeLegOutcome {
  match run_typed_argv_transport(argv: argv, transport: deployed_tree_locus_transport(locus: locus)) {
    TypedArgvExecConverged { result: r } => DeployedTreeLegRan { result: r }
    TypedArgvExecRefused { reason: why } => DeployedTreeLegNotAttempted { reason: why }
  }
}

// FOUR STATES, NONE COLLAPSIBLE, AND THE THIRD IS THE ONE THE EXISTING STANDING CANNOT EXPRESS.
//
// A deployed tree at the right commit with modified tracked files is NOT converged and NOT drifted:
// its revision agrees while its bytes do not, so reporting it as either is wrong in a way that
// matters. `fleet_desired_observe` `fleet_revision_standing` compares revisions alone and has no arm
// for it, which means a hand-edited deployed file reads as converged there and reads as modified here.
type DeployedTreeObservation
  = DeployedTreeObserved { revision: GitObjectId, tracked: DeployedTrackedState }
  | DeployedTreeUnobservable { cause: String }

// MODIFIED CARRIES THE PATHS IT SAW, as a NonEmptyStr so that "modified, with nothing to show for it"
// has no constructor. An empty diff body and a clean tree are the same bytes, so a single field with
// emptiness meaning clean would be the state-space conflation this coproduct exists to prevent -- and
// the receipt ruling applies here as everywhere: a verdict must name what it observed, not merely that
// it disagreed.
type DeployedTrackedState
  = TrackedMatchesCommit
  | TrackedModified { changed_paths: NonEmptyStr }

fn deployed_tracked_state_of(changed_paths: String) -> DeployedTrackedState {
  let body = trim(s: changed_paths)
  if body == "" { TrackedMatchesCommit } else { TrackedModified { changed_paths: body as NonEmptyStr } }
}

// BOTH READINGS OR NEITHER. The revision read is attempted first and a failure there ends the
// observation, because a modification count without a revision to attach it to is a fact about no
// particular commit -- and reporting it beside a fabricated or absent revision is the state-space
// conflation this type exists to prevent.
fn observe_deployed_tree(locus: DeployedTreeLocus) -> DeployedTreeObservation {
  match deployed_tree_leg(locus: locus, argv: deployed_tree_revision_argv(repo: locus.repo)) {
    DeployedTreeLegNotAttempted { reason: why } =>
      DeployedTreeUnobservable {
        cause: join(["deployed tree revision leg was never attempted: ", why], ""),
      }
    DeployedTreeLegRan { result: rev } =>
      if rev.exit_code != 0 {
        DeployedTreeUnobservable {
          cause: join(["deployed tree revision unreadable (git rev-parse exit ", rev.exit_code as String, "): ", rev.stderr], ""),
        }
      } else {
        match git_object_id_from_untagged_hex(hex: trim(s: rev.stdout)) {
          Absent =>
            DeployedTreeUnobservable {
              cause: "deployed tree revision read but undecodable as a git object id",
            }
          Present { value: oid } =>
            match deployed_tree_leg(locus: locus, argv: deployed_tree_status_argv(repo: locus.repo)) {
              DeployedTreeLegNotAttempted { reason: why2 } =>
                DeployedTreeUnobservable {
                  cause: join(["deployed tree status leg was never attempted: ", why2], ""),
                }
              DeployedTreeLegRan { result: st } =>
                if st.exit_code != 0 {
                  DeployedTreeUnobservable {
                    cause: join(["deployed tree status unreadable (git status exit ", st.exit_code as String, "): ", st.stderr], ""),
                  }
                } else {
                  DeployedTreeObserved {
                    revision: oid,
                    tracked: deployed_tracked_state_of(changed_paths: st.stdout),
                  }
                }
            }
        }
      }
  }
}

// FOUR ARMS, AND THE THIRD IS WHY THIS EXISTS. `gunbc.fleet_desired_observe` `fleet_revision_standing`
// compares revisions and nothing else, so a deployed tree sitting at the admitted commit with edited
// tracked files reads as CONVERGED there. It is not: its revision agrees while its bytes do not, and
// the whole point of publishing a tree is the bytes. That state gets its own arm here rather than
// being folded into drift, because the remedies differ -- drift is answered by moving to another
// commit, modification by restoring the one already named.
type DeployedTreeStanding
  = DeployedTreeConverged { revision: GitObjectId }
  | DeployedTreeRevisionDrifted { desired: GitObjectId, local: GitObjectId }
  | DeployedTreeModifiedAtRevision { revision: GitObjectId, changed_paths: NonEmptyStr }
  | DeployedTreeStandingUnobserved { cause: String }

// DRIFT DOMINATES MODIFICATION, and the reason is about meaning rather than precedence. The
// modification state answers "do the bytes match THE COMMIT THE TREE IS ON". When that commit is not
// the admitted one, a clean answer and a dirty answer are both statements about a revision nobody
// asked for, so reporting either as the standing would attach a true fact to the wrong subject.
// Drift is therefore reported first and the modification state is not consulted -- not because it is
// less important, but because at that point it is not evidence about the question.
//
// A PURE FOLD: observation and desired revision in, standing out, no effect. The effectful read
// stays at the call site, which is what lets a witness drive every arm through the real decision
// without a host -- the same extraction the belt revision gate needed before its arms could be
// tested at all.
fn deployed_tree_standing(
  desired: GitObjectId,
  observation: DeployedTreeObservation,
) -> DeployedTreeStanding {
  match observation {
    DeployedTreeUnobservable { cause: c } => DeployedTreeStandingUnobserved { cause: c }
    DeployedTreeObserved { revision: local, tracked: tracked } =>
      if !git_object_id_eq(left: desired, right: local) {
        DeployedTreeRevisionDrifted { desired: desired, local: local }
      } else {
        match tracked {
          TrackedMatchesCommit => DeployedTreeConverged { revision: local }
          TrackedModified { changed_paths: body } =>
            DeployedTreeModifiedAtRevision { revision: local, changed_paths: body }
        }
      }
  }
}

// ONE PREDICATE FOR THE ONLY QUESTION AN ACTUATOR MAY ASK, so no caller re-derives "is this good
// enough" from the arms and quietly admits a third state. Exactly one arm is publication-satisfied;
// every other arm, including the unobserved one, is not -- an unobserved standing treated as
// satisfied would be the empty-observation narrow, could-not-look rendered as nothing-is-wrong.
fn deployed_tree_standing_is_converged(standing: DeployedTreeStanding) -> Bool {
  match standing {
    DeployedTreeConverged { revision: _ } => true
    DeployedTreeRevisionDrifted { desired: _, local: _ } => false
    DeployedTreeModifiedAtRevision { revision: _, changed_paths: _ } => false
    DeployedTreeStandingUnobserved { cause: _ } => false
  }
}
