module gunbc.live_deploy.serving_child_observations

import std.types { List, Bool }
import std.optional { Present, Absent }
import std.measure { ByteSize, byte_size, byte_size_count }
import std.list { first_where }
import gunbc.fleet.fleet_host_identity { HostIdentity }

// ── THE SERVING CHILD'S RESIDENT MEMORY ─────────────────────────────────────────────────────
// WHEN A REMOTE BUILD ARRIVES THROUGH THE SERVING DOOR, THE DOOR HANDS OFF TO A CHILD `gunbc run`
// OF THE SERVING ENTRY, AND THAT CHILD STAYS RESIDENT FOR THE WHOLE BUILD: it boots the engine,
// pays the entry's own closure resolve, and its unit then runs the build. The child's own footprint
// is therefore NOT the unit's MemoryMax and is NOT charged to the capacity ledger -- it is the
// uncharged resident that rides beside the charged seat inside gunbc-user-work.slice. A slice sized
// only by (slots x unit ceiling) is sized blind to this process, which is the defect class that
// OOM-killed every srv3 request leg on 2026-11-26 (manager's live read: slice 25 GiB,
// memory.events oom_kill 40, while the seats alone could account for 25 of 25 GiB).
//
// THE RESIDENCY IS A FACT OF THE ENGINE, AND THE ENGINE IS ONE BINARY ON EVERY HOST -- so the
// standing figure is one measured row, not per-host transcriptions. Where a HOST has its own
// resident read (a receipt measuring that host's serving child), it joins the override list below
// as one row keyed by host identity; the override may only RAISE the figure, never lower it under
// the engine's own measurement (fail-closed: a host read cannot fabricate headroom the engine has
// already been caught taking).

// THE ENGINE'S MEASURED SERVING CHILD. 3.5 GiB declared against a measured serve-resident peak of
// ~3.46 GB (the 2026-09-04 serving measurement recorded in gunbc.live_deploy.slice_bounds' own
// history) and ~3.4 GiB (remote-build program plan, section 2) -- ROUNDED UP, the fail-closed
// direction for an admission bound (gunbc.design_argument::fail_closed).
data serving_child_engine_measurement: ByteSize = byte_size(3758096384)

// ONE HOST'S OWN RESIDENT READ. The row is evidence, not policy: it joins only when a receipt
// measured that host, and it speaks for exactly one host.
type ServingChildHostOverride {
  host: HostIdentity
  bytes: ByteSize
}

// THE HOST ROWS ESTABLISHED SO FAR. srv14 (butch) will join here from quiet-pike-440's committed
// serving-child observation when its receipt is recorded; until then butch is governed by the
// engine's own figure, which is the fail-closed default, not an absence.
data serving_child_host_overrides: List<ServingChildHostOverride> = []

// THE LOOKUP OVER AN EXPLICIT ROW TABLE — pure, so a claim can hand it rows of its own.
fn serving_child_residency_for(raised: List<ServingChildHostOverride>, host: HostIdentity) -> ByteSize {
  match first_where(raised, o => o.host == host) {
    Present { value: o } => match byte_size_count(b: o.bytes) >= byte_size_count(b: serving_child_engine_measurement) {
      true => o.bytes
      false => serving_child_engine_measurement
    }
    Absent => serving_child_engine_measurement
  }
}

// THE RESIDENCY FOR A HOST: its own row when established and at least the engine figure, the
// engine measurement otherwise. Total by construction -- no host is left without a bound, and no
// host row can shrink the bound under the engine's own measurement.
fn serving_child_residency(host: HostIdentity) -> ByteSize {
  serving_child_residency_for(raised: serving_child_host_overrides, host: host)
}

// THE ENGINE FIGURE IS A POSITIVE BOUND -- a zero residency would silently erase the uncharged
// resident from every admission sum.
fn serving_child_engine_measurement_is_positive() -> Bool {
  byte_size_count(b: serving_child_engine_measurement) > 0
}

// NO HOST ROW SITS UNDER THE ENGINE'S OWN MEASUREMENT. A host read may exceed it (a host that
// measures more resident memory needs more), never undercut it.
fn no_serving_child_host_override_undercuts_the_engine() -> Bool {
  first_where(serving_child_host_overrides, o => byte_size_count(b: o.bytes) < byte_size_count(b: serving_child_engine_measurement)) == Absent
}
