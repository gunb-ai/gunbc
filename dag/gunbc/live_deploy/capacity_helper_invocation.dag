module gunbc.live_deploy.capacity_helper_invocation

import std.types { String, NonEmptyStr, List }
import std.error_primitives { Result, Ok, Err }
import std.optional { Present, Absent }
import std.measure { second }
import std.content_hash { Sha256Digest }
import extdeps.exec.command { argv_words }
import gunbc.cli_invoke { NamedArgumentRequest }
import gunbc.gunbc_cli_command { gunbc_installed_run_with_named_arguments_command }
import gunbc.ci.ci_release_bins { gunbc_release_bin_name }
import gunbc.fleet.fleet_generation_execution { fleet_generation_lock }
import gunbc.typed_remote_file_write { FleetHostLock, RemoteFileViaNonInteractiveSudo, typed_remote_file_locked_step_argv }
import gunbc.live_deploy.release_locus { ReleaseRevisionBinding, RevisionNotInstalled, RevisionBoundAtEmission, helper_locus_dir }
import gunbc.live_deploy.capacity_helper_snapshot { capacity_helper_locus, capacity_helper_entry, capacity_helper_function, capacity_helper_manifest_admission }

// One elevated flock wraps ONE fixed helper process. The helper's first journal
// read, claim, every leg and final CAS all occur before that process exits. Never
// apply this wrapper separately to individual file writes or journal operations.
// The helper CLI must decode these request/plan files and re-read the SAME live
// broker gate under the lock. srv1_root_mutation_after_gate's receipt is a log,
// never authority that can be deserialized into a grant. The v7 plan/journal
// readers bind data; argv construction itself grants no execution.
type CapacityHelperInvocation sole_constructor {
  words: List<String>
  helper_digest: Sha256Digest
}

fn capacity_helper_invocation(revision: ReleaseRevisionBinding, approved_helper: Sha256Digest,
  observed_helper: Result<Sha256Digest, String>, request_path: NonEmptyStr,
  plan_path: NonEmptyStr) -> Result<CapacityHelperInvocation, String> {
  match revision { RevisionNotInstalled => { return Err { value: "cutover invocation requires a pinned helper revision" } } RevisionBoundAtEmission { revision: _ } => {} }
  let digest = match capacity_helper_manifest_admission(approved: approved_helper, observed: observed_helper) {
    Err { value: why } => { return Err { value: why } } Ok { value: value } => value
  }
  if !all([request_path, plan_path], path => starts_with(s: path as String, prefix: "/")) {
    return Err { value: "cutover helper inputs must be absolute data paths" }
  }
  let dir = helper_locus_dir(locus: capacity_helper_locus, revision: revision)
  match gunbc_installed_run_with_named_arguments_command(
    binary: join([dir, "/", gunbc_release_bin_name], "") as NonEmptyStr,
    source_roots: [concat(dir, "/dag"), concat(dir, "/src/v2")],
    entry: join([dir, "/", capacity_helper_entry], ""), function: capacity_helper_function,
    arguments: [NamedArgumentRequest { name: "request_path", value: request_path as String },
      NamedArgumentRequest { name: "plan_path", value: plan_path as String }]) {
    Absent => Err { value: "fixed cutover helper arguments refused" }
    Present { value: command } => Ok { value: CapacityHelperInvocation {
      helper_digest: digest,
      words: typed_remote_file_locked_step_argv(lock: FleetHostLock {
        lock_path: fleet_generation_lock as NonEmptyStr, wait: second(count: 120), conflict_exit_code: 75 },
        privilege: RemoteFileViaNonInteractiveSudo, argv: argv_words(command: command)) } }
  }
}
