// PRE-MUTATION ADMISSION FOR A LIVE SWAP. Two observed holes, one decision, used by the CI
// transaction, the operator-local converge deploy, and the desired-instance apply. Nothing here
// mutates a host; a refusal is the only answer a wet caller may act on besides proceed.
//
// (1) SERVE-ENTRY COMPILE. A revision whose server did not compile (a source annotation inside a
// fn body) was installed; the new process crash-looped; deploy learned this only at readiness.
// The candidate's declared serve entry file (DeploymentServiceConfig.serve_entry, the same
// path ExecStart binds) is compiled before any apply fold runs. The path is a spec fact, not
// a reverse lookup of a module name (DESIGN §3: paths follow names; this does not invent a
// second path-to-name table).
//
// THE COMPILE IS THE CANDIDATE COMPILER'S OWN, OVER THE SERVE ROUTE'S CLOSURE. The candidate's
// gunbc compiles the entry under deployment_serve_source_roots (the roots ExecStart passes to
// `serve`) to the dag target, and its exit status is the verdict. An earlier cut fed the file's
// text to the compile_dag_diagnostic_census builtin, whose declared scope is a synthetic
// single-module source on the Rust render target and which states it says nothing about the
// interpreter's disposition of the same program, so it refused real candidates whose serve entry
// compiles clean. What this
// still cannot see is a failure of `serve` itself after its compile (a bind, a listener); that
// stays with readiness after the swap.
//
// (2) TARGET-BOUND BRANCH. Operator 2026-10-09 let an empty --candidate-branch admit any nonempty
// checkout (fleet_converge_deploy_branch_admits). Operator 2026-10-13 (gunbc.design_ruling
// production_is_main_only_lab_admits_integration) narrows that: each DesiredDeployment row
// carries the one NonEmptyStr branch it admits. There is no class default.
// The CLI flag check remains a second, optional equality; it does not widen the row.

type TargetBranchAdmission
  = TargetBranchAdmitted
  | TargetBranchRefused { reason: String }

type ServeEntryCompileVerdict
  = ServeEntryCompileAdmitted
  | ServeEntryCompileBlocked { blocking: Int, diagnostics: List<String> }
  | ServeEntryCompileUnobserved { detail: String }

type PreSwapAdmission
  = PreSwapAdmitted
  | PreSwapRefused { reason: String }

fn target_branch_admission(admitted: NonEmptyStr, observed: String) -> TargetBranchAdmission {
  let required = trim(s: admitted as String)
  let seen = trim(s: observed)
  if seen != "" && seen == required {
    TargetBranchAdmitted
  } else {
    TargetBranchRefused {
      reason: join([
        "live_deploy: DeployTargetBranchRefused — checkout '",
        seen,
        "' is not the admitted branch '",
        required,
        "'",
      ], ""),
    }
  }
}

// The verdict is the compiler's own: exit 0 admits whatever it printed; a nonzero exit with error
// lines is blocked and carries them; a nonzero exit with none (the binary missing, a spawn
// failure) is unobserved, never admitted.
fn serve_entry_compile_verdict_of(exit_success: Bool, exit_code: Int, stderr: String) -> ServeEntryCompileVerdict {
  let errors = filter(split(s: stderr, sep: "\n"), l => starts_with(s: l, prefix: "error"))
  if exit_success {
    ServeEntryCompileAdmitted
  } else if count(errors) > 0 {
    ServeEntryCompileBlocked { blocking: count(errors), diagnostics: errors }
  } else {
    ServeEntryCompileUnobserved { detail: join([
      "the serve-entry compile exited ",
      int_to_decimal_string(value: exit_code),
      " with no error line",
    ], "") }
  }
}

// A refusal names what blocked it: the compiler's first eight error lines, then how many it left out.
data serve_entry_blocking_lines_shown: Int = 8

fn serve_entry_blocking_summary(diagnostics: List<String>) -> String {
  let shown = diagnostics.take(n: serve_entry_blocking_lines_shown)
  let hidden = count(diagnostics) - count(shown)
  if hidden > 0 {
    join([join(shown, "; "), "; and ", int_to_decimal_string(value: hidden), " more"], "")
  } else {
    join(shown, "; ")
  }
}

fn serve_entry_compile_args(roots: List<String>, entry: String, out_dir: String) -> List<String> {
  concat(
    concat(["compile"], fold(roots, init: [], f: (acc, r) => concat(acc, ["--source-root", r]))),
    ["--entry", entry, "--output-dir", out_dir, "--target", "dag"],
  )
}

fn observe_serve_entry_compile_clean(repo_root: String, bin_path: String, roots: List<String>, entry: String) -> ServeEntryCompileVerdict {
  let path = trim(s: entry)
  if path == "" {
    ServeEntryCompileUnobserved { detail: "serve entry path is empty" }
  } else {
    let tmp = shell.Mktemp.Dir()
    if !tmp.success {
      ServeEntryCompileUnobserved { detail: "no scratch directory for the serve-entry compile output" }
    } else {
      let run = gunbc.WitnessBin.Run(
        workdir: repo_root,
        bin_path: bin_path,
        args: serve_entry_compile_args(roots: roots, entry: path, out_dir: concat(tmp.path as String, "/out")),
        expect: OutcomeIsData,
      )
      let _ = shell.Remove.RecursiveForce(path: tmp.path)
      serve_entry_compile_verdict_of(exit_success: run.success, exit_code: run.exit_code, stderr: run.stderr)
    }
  }
}

// The candidate checkout's HEAD hex. Same read the detached-HEAD admission uses; recorded in the
// plan's serve-entry verdict so the swap can bind the verdict to the revision it admits.
fn observe_checkout_head_hex() -> String {
  trim(s: git.Inspect.HeadCommit(expect: OutcomeIsData).sha as String)
}

// Named checkout as git reports it. A detached HEAD is the literal "HEAD"; provenance for that
// case is checkout_branch_for_admission (merge-base of HEAD and refs/remotes/origin/<B>), never
// GITHUB_REF_NAME. An environment variable that names a CI event is not proof of a commit's
// ancestry (DESIGN §5). Operator-local and CI share this function; neither reads GITHUB_*.
fn observe_checkout_branch() -> String {
  trim(s: git.Core.CurrentBranch().branch)
}

fn origin_tracking_ref(branch: NonEmptyStr) -> GitRef {
  join(["refs/remotes/origin/", branch as String], "") as GitRef
}

// Detached HEAD is on admitted branch B iff git's merge-base of HEAD and
// refs/remotes/origin/<B> equals HEAD (HEAD is reachable from B's origin ref).
// Exit 0 / 1 / 128 stay typed through merge_base_outcome; none of them admits.
type CheckoutBranchForAdmission
  = CheckoutNamedBranch { branch: String }
  | DetachedHeadOnAdmittedBranch { head: String, branch: String }
  | DetachedHeadNotOnAdmittedBranch { head: String, branch: String, cause: String }

fn detached_head_on_admitted_branch(
  head: String,
  admitted: NonEmptyStr,
  outcome: MergeBaseOutcome,
) -> CheckoutBranchForAdmission {
  let h = trim(s: head)
  let b = admitted as String
  match outcome {
    MergeBaseReported { base_hex } => {
      let base = trim(s: base_hex)
      if h != "" && base == h {
        DetachedHeadOnAdmittedBranch { head: h, branch: b }
      } else {
        DetachedHeadNotOnAdmittedBranch {
          head: h,
          branch: b,
          cause: join([
            "live_deploy: DetachedHeadNotOnAdmittedBranch — merge-base of HEAD and ",
            origin_tracking_ref(branch: admitted) as String,
            " is '",
            base,
            "', not HEAD '",
            h,
            "'",
          ], ""),
        }
      }
    }
    NoCommonAncestor =>
      DetachedHeadNotOnAdmittedBranch {
        head: h,
        branch: b,
        cause: join([
          "live_deploy: DetachedHeadNotOnAdmittedBranch — HEAD '",
          h,
          "' and ",
          origin_tracking_ref(branch: admitted) as String,
          " share no merge base",
        ], ""),
      }
    MergeBaseRefused { exit_code, stderr } =>
      DetachedHeadNotOnAdmittedBranch {
        head: h,
        branch: b,
        cause: join([
          "live_deploy: DetachedHeadNotOnAdmittedBranch — merge-base of HEAD '",
          h,
          "' and ",
          origin_tracking_ref(branch: admitted) as String,
          " refused (exit ",
          int_to_decimal_string(value: exit_code),
          "): ",
          trim(s: stderr),
        ], ""),
      }
  }
}

fn checkout_branch_for_admission(
  named: String,
  admitted: NonEmptyStr,
  head: String,
  outcome: MergeBaseOutcome,
) -> CheckoutBranchForAdmission {
  let seen = trim(s: named)
  if seen != "" && seen != "HEAD" {
    CheckoutNamedBranch { branch: seen }
  } else {
    detached_head_on_admitted_branch(head: head, admitted: admitted, outcome: outcome)
  }
}

fn observe_detached_merge_base(admitted: NonEmptyStr) -> MergeBaseOutcome {
  let root = git.Inspect.Toplevel()
  let probe = git.Inspect.MergeBase(
    repository_path: trim(s: root.path as String),
    left: "HEAD" as GitRef,
    right: origin_tracking_ref(branch: admitted),
    expect: OutcomeIsData,
  )
  merge_base_outcome(exit_code: probe.exit_code, stdout: probe.sha as String, stderr: probe.stderr)
}

fn observe_checkout_for_admission(admitted: NonEmptyStr) -> CheckoutBranchForAdmission {
  let named = observe_checkout_branch()
  if named != "" && named != "HEAD" {
    checkout_branch_for_admission(
      named: named,
      admitted: admitted,
      head: "",
      outcome: NoCommonAncestor,
    )
  } else {
    let head = git.Inspect.HeadCommit(expect: OutcomeIsData)
    checkout_branch_for_admission(
      named: named,
      admitted: admitted,
      head: trim(s: head.sha as String),
      outcome: observe_detached_merge_base(admitted: admitted),
    )
  }
}

fn pre_swap_from_checkout(
  standing: CheckoutBranchForAdmission,
  admitted: NonEmptyStr,
  compile: ServeEntryCompileVerdict,
) -> PreSwapAdmission {
  match standing {
    CheckoutNamedBranch { branch } =>
      live_deploy_pre_swap_admission(admitted: admitted, observed_branch: branch, compile: compile)
    DetachedHeadOnAdmittedBranch { head: _, branch } =>
      live_deploy_pre_swap_admission(admitted: admitted, observed_branch: branch, compile: compile)
    DetachedHeadNotOnAdmittedBranch { cause, head: _, branch: _ } =>
      PreSwapRefused { reason: cause }
  }
}

fn live_deploy_pre_swap_admission(
  admitted: NonEmptyStr,
  observed_branch: String,
  compile: ServeEntryCompileVerdict,
) -> PreSwapAdmission {
  match target_branch_admission(admitted: admitted, observed: observed_branch) {
    TargetBranchRefused { reason } => PreSwapRefused { reason: reason }
    TargetBranchAdmitted =>
      match compile {
        ServeEntryCompileAdmitted => PreSwapAdmitted
        ServeEntryCompileBlocked { blocking, diagnostics } =>
          PreSwapRefused {
            reason: join([
              "live_deploy: ServeEntryCompileBlocked — the candidate serve entry has ",
              int_to_decimal_string(value: blocking),
              " blocking diagnostic(s): ",
              serve_entry_blocking_summary(diagnostics: diagnostics),
              "; nothing was mutated",
            ], ""),
          }
        ServeEntryCompileUnobserved { detail } =>
          PreSwapRefused {
            reason: join([
              "live_deploy: ServeEntryCompileUnobserved — ",
              detail,
              "; nothing was mutated",
            ], ""),
          }
      }
  }
}

fn live_deploy_pre_swap_for_deployment(deployment: DesiredDeployment) -> PreSwapAdmission {
  pre_swap_from_checkout(
    standing: observe_checkout_for_admission(admitted: deployment.admitted_branch),
    admitted: deployment.admitted_branch,
    compile: swap_serve_entry_compile_for(deployment: deployment),
  )
}

// THE VERDICT REQUIREMENT IS SCOPED TO THE FLEET PROD-ROLE (STAGE) INSTANCE. The plan job mints
// the serve-entry verdict for the prod-role spec only (record_plan_serve_entry_verdict_for runs
// over the prod-role row), so the swap demands it only when the deployment IS that row -- decided
// by the single authority for who holds the fleet prod role (prod_role_desired_deployment; an
// unreadable realization fails CLOSED into the verdict arm). The LAB route is left alone (manager
// rule): the operator-local lab live_deploy apply (live_deploy_apply_desired_wet over a lab row,
// Plan B from an integration checkout) has no plan job, so it keeps the pre-gap mechanism -- the
// cold serve-entry compile -- UNCHANGED, slowness and all. Changing the lab's wet route is a
// separate node, not a ride-along in this one.
fn swap_serve_entry_compile_for(deployment: DesiredDeployment) -> ServeEntryCompileVerdict {
  if deployment_requires_plan_serve_entry_verdict(deployment: deployment) {
    observe_plan_serve_entry_verdict(spec: selected_deployment_spec(row: deployment))
  } else {
    let spec = selected_deployment_spec(row: deployment)
    let root = git.Inspect.Toplevel()
    let root_path = root.path as String
    let bin = witness_bin_release_path(root: root_path, bin_name: "gunbc")
    observe_serve_entry_compile_clean(
      repo_root: root_path,
      bin_path: bin,
      roots: deployment_serve_source_roots,
      entry: spec.service.serve_entry as String,
    )
  }
}

// The scope predicate: true exactly when the deployment is the row the fleet holds as its prod
// role (STAGE). Every refusal of the role lookup FAILS CLOSED -- a swap that cannot see who holds
// the role cannot be trusted to be a lab swap.
fn deployment_requires_plan_serve_entry_verdict(deployment: DesiredDeployment) -> Bool {
  match prod_role_desired_deployment() {
    ProdRoleDeploymentSelected { deployment: stage } =>
      instance_id_text(id: deployment.instance.instance_id) == instance_id_text(id: stage.instance.instance_id)
    ProdRoleDeploymentRefused => true
    ProdRoleDeploymentRosterRefused => true
    ProdRoleDeploymentHolderRowMismatch => true
  }
}

// ---------------------------------------------------------------------------
// THE PLAN'S SERVE-ENTRY VERDICT, CONSUMED BY IDENTITY (prod gap 1, failure b).
//
// THE OLD CUT compiled the candidate's serve entry cold, inside the swap transaction, under
// pre_swap_admission: resolve_entry_graph_inclusive over the full closure took 614964 ms and the
// step still exited 1 (job 117824998335). The compile is a plan-time fact — it belongs where the
// plan is made and the fold is expected to be paid — and the swap must consume that verdict by
// IDENTITY rather than re-derive it. The identity is the four things the swap actually admits:
// the source revision, the serve entry path, the serve argv (the ExecStart command text the
// unit binds, digested through the same fragment builders the emit uses), and the release binary
// that the swap promotes — the checkout's own target/release/gunbc, digested by sha256sum.
//
// THERE IS NO COLD-RESOLVE FALLBACK. A missing, unreadable, or foreign-identity verdict is a
// refusal, never a licence to re-compile here: paying the fold in the swap "just in case" is the
// §5 absorbing widen that made this step both slow and untestable. The producer entry below
// runs in the plan job (after the plan step, before the artifact upload), so every uploaded
// plan artifact carries its verdict; a deploy whose pointer run predates this rule refuses by
// name and the operator re-runs the plan.
// ---------------------------------------------------------------------------

data serve_entry_verdict_schema: String = "live-deploy-serve-entry-verdict/v1"

fn serve_entry_verdict_path() -> String {
  join([fleet_converge_plan_artifact_dir, "/serve_entry_verdict.json"], "")
}

type ServeEntryVerdictConsumption
  = ConsumedAdmitted
  | ConsumedAbsent { detail: String }
  | ConsumedIdentityMismatch { field: String, expected: String, seen: String }
  | ConsumedCompileBlocked { blocking: Int, diagnostics_text: String }
  | ConsumedCompileUnobserved { detail: String }

type ServeEntryVerdictRecord
  = ServeEntryVerdictAdmitted {
      source_revision: String,
      entry: String,
      argv_digest: String,
      compiler_bin_sha256_hex: String,
    }
  | ServeEntryVerdictBlocked {
      source_revision: String,
      entry: String,
      argv_digest: String,
      compiler_bin_sha256_hex: String,
      blocking: Int,
      diagnostics_text: String,
    }
  | ServeEntryVerdictUnobserved {
      source_revision: String,
      entry: String,
      argv_digest: String,
      compiler_bin_sha256_hex: String,
      detail: String,
    }

type ServeEntryVerdictDecode
  = ServeEntryVerdictDecoded { record: ServeEntryVerdictRecord }
  | ServeEntryVerdictUndecoded { detail: String }

// The serve argv the unit's ExecStart binds, as one text. Built from the same helpers the emit
// uses for ExecStart (deployment_serve_source_root_flags_text, eval_budget_flag_text), so this
// is the unit's argv digested, not a second spelling of it minus the launch directory, the
// binary path, and --release-revision -- those are covered by the compiler digest and the
// revision in the same record.
fn serve_entry_argv_identity_text(spec: DeploymentSpec) -> String {
  let svc = spec.service
  join([
    "serve",
    deployment_serve_source_root_flags_text(),
    " --entry ",
    svc.serve_entry as String,
    " --function ",
    svc.serve_function as String,
    live_deploy_serve_listener_fragment(svc: svc),
    eval_budget_flag_text(flag: "--cpu-budget", limit: svc.serve_cpu_limit),
    eval_budget_flag_text(flag: "--wall-budget", limit: svc.serve_wall_limit),
  ], "")
}

fn serve_entry_argv_digest_of_text(text: String) -> String {
  content_hash_tagged_structural(
    tag: "live-deploy-serve-argv-v1" as NonEmptyStr,
    payload: content_hash_atom(value: text as NonEmptyStr),
  ).digest as String
}

fn serve_entry_argv_digest(spec: DeploymentSpec) -> String {
  serve_entry_argv_digest_of_text(text: serve_entry_argv_identity_text(spec: spec))
}

fn serve_entry_verdict_json(record: ServeEntryVerdictRecord) -> JsonValue {
  match record {
    ServeEntryVerdictAdmitted { source_revision, entry, argv_digest, compiler_bin_sha256_hex } =>
      json_object(members: [
        json_kv(key: "schema", value: json_string(s: serve_entry_verdict_schema)),
        json_kv(key: "source_revision", value: json_string(s: source_revision)),
        json_kv(key: "entry", value: json_string(s: entry)),
        json_kv(key: "argv_digest", value: json_string(s: argv_digest)),
        json_kv(key: "compiler_bin_sha256_hex", value: json_string(s: compiler_bin_sha256_hex)),
        json_kv(key: "compile_arm", value: json_string(s: "admitted")),
      ])
    ServeEntryVerdictBlocked { source_revision, entry, argv_digest, compiler_bin_sha256_hex, blocking, diagnostics_text } =>
      json_object(members: [
        json_kv(key: "schema", value: json_string(s: serve_entry_verdict_schema)),
        json_kv(key: "source_revision", value: json_string(s: source_revision)),
        json_kv(key: "entry", value: json_string(s: entry)),
        json_kv(key: "argv_digest", value: json_string(s: argv_digest)),
        json_kv(key: "compiler_bin_sha256_hex", value: json_string(s: compiler_bin_sha256_hex)),
        json_kv(key: "compile_arm", value: json_string(s: "blocked")),
        json_kv(key: "compile_blocking", value: json_string(s: int_to_decimal_string(value: blocking))),
        json_kv(key: "compile_diagnostics_text", value: json_string(s: diagnostics_text)),
      ])
    ServeEntryVerdictUnobserved { source_revision, entry, argv_digest, compiler_bin_sha256_hex, detail } =>
      json_object(members: [
        json_kv(key: "schema", value: json_string(s: serve_entry_verdict_schema)),
        json_kv(key: "source_revision", value: json_string(s: source_revision)),
        json_kv(key: "entry", value: json_string(s: entry)),
        json_kv(key: "argv_digest", value: json_string(s: argv_digest)),
        json_kv(key: "compiler_bin_sha256_hex", value: json_string(s: compiler_bin_sha256_hex)),
        json_kv(key: "compile_arm", value: json_string(s: "unobserved")),
        json_kv(key: "compile_detail", value: json_string(s: detail)),
      ])
  }
}

fn serve_entry_verdict_decode(raw: String) -> ServeEntryVerdictDecode {
  match parse_json_document(s: raw) {
    JsonDocumentUnreadable { gap } =>
      ServeEntryVerdictUndecoded { detail: join(["verdict document is ", json_document_gap_text(gap: gap)], "") }
    JsonDocumentParsed { value: doc } =>
      match json_required_string_member(doc: doc, key: "schema") {
        JsonStringMemberRefused { reason } => ServeEntryVerdictUndecoded { detail: reason }
        JsonStringMemberFound { value: schema } =>
          if schema != serve_entry_verdict_schema {
            ServeEntryVerdictUndecoded {
              detail: join(["verdict schema is not ", serve_entry_verdict_schema, ": ", schema], ""),
            }
          } else {
            match json_required_string_member(doc: doc, key: "source_revision") {
              JsonStringMemberRefused { reason } => ServeEntryVerdictUndecoded { detail: reason }
              JsonStringMemberFound { value: source_revision } =>
                match json_required_string_member(doc: doc, key: "entry") {
                  JsonStringMemberRefused { reason } => ServeEntryVerdictUndecoded { detail: reason }
                  JsonStringMemberFound { value: entry } =>
                    match json_required_string_member(doc: doc, key: "argv_digest") {
                      JsonStringMemberRefused { reason } => ServeEntryVerdictUndecoded { detail: reason }
                      JsonStringMemberFound { value: argv_digest } =>
                        match json_required_string_member(doc: doc, key: "compiler_bin_sha256_hex") {
                          JsonStringMemberRefused { reason } => ServeEntryVerdictUndecoded { detail: reason }
                          JsonStringMemberFound { value: compiler_bin_sha256_hex } =>
                            match json_required_string_member(doc: doc, key: "compile_arm") {
                              JsonStringMemberRefused { reason } => ServeEntryVerdictUndecoded { detail: reason }
                              JsonStringMemberFound { value: arm } =>
                                if arm == "admitted" {
                                  ServeEntryVerdictDecoded {
                                    record: ServeEntryVerdictAdmitted {
                                      source_revision: source_revision,
                                      entry: entry,
                                      argv_digest: argv_digest,
                                      compiler_bin_sha256_hex: compiler_bin_sha256_hex,
                                    },
                                  }
                                } else if arm == "blocked" {
                                  match receipt_int_member(doc: doc, key: "compile_blocking") {
                                    ReceiptIntRefused { reason } => ServeEntryVerdictUndecoded { detail: reason }
                                    ReceiptIntFound { value: blocking } =>
                                      match json_required_string_member(doc: doc, key: "compile_diagnostics_text") {
                                        JsonStringMemberRefused { reason } => ServeEntryVerdictUndecoded { detail: reason }
                                        JsonStringMemberFound { value: diagnostics_text } =>
                                          ServeEntryVerdictDecoded {
                                            record: ServeEntryVerdictBlocked {
                                              source_revision: source_revision,
                                              entry: entry,
                                              argv_digest: argv_digest,
                                              compiler_bin_sha256_hex: compiler_bin_sha256_hex,
                                              blocking: blocking,
                                              diagnostics_text: diagnostics_text,
                                            },
                                          }
                                      }
                                  }
                                } else if arm == "unobserved" {
                                  match json_required_string_member(doc: doc, key: "compile_detail") {
                                    JsonStringMemberRefused { reason } => ServeEntryVerdictUndecoded { detail: reason }
                                    JsonStringMemberFound { value: detail } =>
                                      ServeEntryVerdictDecoded {
                                        record: ServeEntryVerdictUnobserved {
                                          source_revision: source_revision,
                                          entry: entry,
                                          argv_digest: argv_digest,
                                          compiler_bin_sha256_hex: compiler_bin_sha256_hex,
                                          detail: detail,
                                        },
                                      }
                                  }
                                } else {
                                  ServeEntryVerdictUndecoded {
                                    detail: join(["verdict compile arm is not admitted, blocked, or unobserved: ", arm], ""),
                                  }
                                }
                            }
                        }
                    }
                }
            }
          }
      }
  }
}

type ServeEntryVerdictIdentity
  = IdentityChecked
  | IdentityMismatched { field: String, expected: String, seen: String }

// The four things the swap admits, checked one at a time and named at the first mismatch. The
// check is ordered revision, entry, argv, binary so a witness that flips exactly one field sees
// exactly one name.
fn serve_entry_verdict_identity_check(
  source_revision: String,
  entry: String,
  argv_digest: String,
  compiler_bin_sha256_hex: String,
  expected_source_revision: String,
  expected_entry: String,
  expected_argv_digest: String,
  admitted_bin_sha256_hex: String,
) -> ServeEntryVerdictIdentity {
  if source_revision != expected_source_revision {
    IdentityMismatched { field: "source_revision", expected: expected_source_revision, seen: source_revision }
  } else if entry != expected_entry {
    IdentityMismatched { field: "entry", expected: expected_entry, seen: entry }
  } else if argv_digest != expected_argv_digest {
    IdentityMismatched { field: "argv_digest", expected: expected_argv_digest, seen: argv_digest }
  } else if compiler_bin_sha256_hex != admitted_bin_sha256_hex {
    IdentityMismatched { field: "compiler_bin_sha256_hex", expected: admitted_bin_sha256_hex, seen: compiler_bin_sha256_hex }
  } else {
    IdentityChecked
  }
}

// Pure admission: the recorded identity against the four facts the swap itself holds, then the
// verdict's own arm. A blocked or unobserved verdict still passes identity first -- a verdict
// about someone else's bytes must be named as such, not laundered into a compile answer.
fn admit_plan_serve_entry_verdict(
  record: ServeEntryVerdictRecord,
  expected_source_revision: String,
  expected_entry: String,
  expected_argv_digest: String,
  admitted_bin_sha256_hex: String,
) -> ServeEntryVerdictConsumption {
  match record {
    ServeEntryVerdictAdmitted { source_revision, entry, argv_digest, compiler_bin_sha256_hex } =>
      match serve_entry_verdict_identity_check(
        source_revision: source_revision,
        entry: entry,
        argv_digest: argv_digest,
        compiler_bin_sha256_hex: compiler_bin_sha256_hex,
        expected_source_revision: expected_source_revision,
        expected_entry: expected_entry,
        expected_argv_digest: expected_argv_digest,
        admitted_bin_sha256_hex: admitted_bin_sha256_hex,
      ) {
        IdentityMismatched { field, expected, seen } =>
          ConsumedIdentityMismatch { field: field, expected: expected, seen: seen }
        IdentityChecked => ConsumedAdmitted
      }
    ServeEntryVerdictBlocked { source_revision, entry, argv_digest, compiler_bin_sha256_hex, blocking, diagnostics_text } =>
      match serve_entry_verdict_identity_check(
        source_revision: source_revision,
        entry: entry,
        argv_digest: argv_digest,
        compiler_bin_sha256_hex: compiler_bin_sha256_hex,
        expected_source_revision: expected_source_revision,
        expected_entry: expected_entry,
        expected_argv_digest: expected_argv_digest,
        admitted_bin_sha256_hex: admitted_bin_sha256_hex,
      ) {
        IdentityMismatched { field, expected, seen } =>
          ConsumedIdentityMismatch { field: field, expected: expected, seen: seen }
        IdentityChecked => ConsumedCompileBlocked { blocking: blocking, diagnostics_text: diagnostics_text }
      }
    ServeEntryVerdictUnobserved { source_revision, entry, argv_digest, compiler_bin_sha256_hex, detail } =>
      match serve_entry_verdict_identity_check(
        source_revision: source_revision,
        entry: entry,
        argv_digest: argv_digest,
        compiler_bin_sha256_hex: compiler_bin_sha256_hex,
        expected_source_revision: expected_source_revision,
        expected_entry: expected_entry,
        expected_argv_digest: expected_argv_digest,
        admitted_bin_sha256_hex: admitted_bin_sha256_hex,
      ) {
        IdentityMismatched { field, expected, seen } =>
          ConsumedIdentityMismatch { field: field, expected: expected, seen: seen }
        IdentityChecked => ConsumedCompileUnobserved { detail: detail }
      }
  }
}

// Consumption projected onto the swap's existing pre-swap shape, so the refusal carries the same
// PreSwapRefused arm and text surface as every other pre-swap question. Absence and foreign
// identity both say Unobserved truthfully -- the candidate's compile was genuinely never
// observed by THIS process -- and both name the cause and the no-fallback rule.
fn serve_entry_verdict_as_compile_verdict(consumption: ServeEntryVerdictConsumption) -> ServeEntryCompileVerdict {
  match consumption {
    ConsumedAdmitted => ServeEntryCompileAdmitted
    ConsumedCompileBlocked { blocking, diagnostics_text } =>
      ServeEntryCompileBlocked { blocking: blocking, diagnostics: [diagnostics_text] as List<String> }
    ConsumedAbsent { detail } =>
      ServeEntryCompileUnobserved {
        detail: join(["the plan run published no serve-entry verdict (", detail, "); refusing without a cold resolve -- re-run the plan"], ""),
      }
    ConsumedIdentityMismatch { field, expected, seen } =>
      ServeEntryCompileUnobserved {
        detail: join(["plan serve-entry verdict identity mismatch on ", field, ": expected '", expected, "', saw '", seen, "'; the verdict certifies different bytes and there is no cold resolve fallback"], ""),
      }
    ConsumedCompileUnobserved { detail } => ServeEntryCompileUnobserved { detail: detail }
  }
}

// THE SWAP'S QUESTION, ANSWERED FROM THE PLAN. Reads the plan artifact's verdict, digests the
// release binary the swap itself would promote, and admits only on a four-way identity match.
// No branch of this function compiles anything: that is the whole point.
fn observe_plan_serve_entry_verdict(spec: DeploymentSpec) -> ServeEntryCompileVerdict {
  let path = serve_entry_verdict_path()
  let read = Filesystem.Read(path: path)
  if !read.success {
    serve_entry_verdict_as_compile_verdict(
      consumption: ConsumedAbsent { detail: join(["could not read ", path, ": ", read.error], "") },
    )
  } else {
    match serve_entry_verdict_decode(raw: read.content) {
      ServeEntryVerdictUndecoded { detail } =>
        serve_entry_verdict_as_compile_verdict(consumption: ConsumedAbsent { detail: detail })
      ServeEntryVerdictDecoded { record } => {
        let root = git.Inspect.Toplevel()
        let bin = witness_bin_release_path(root: root.path as String, bin_name: "gunbc")
        match sha256sum_file_digest_via_shell(path: bin as NonEmptyStr) {
          Sha256FileDigestUnavailable { path: wanted, reason } =>
            serve_entry_verdict_as_compile_verdict(
              consumption: ConsumedAbsent {
                detail: join(["the release binary the swap admits (", wanted as String, ") has no readable digest: ", reason], ""),
              },
            )
          Sha256FileDigest { digest } =>
            serve_entry_verdict_as_compile_verdict(
              consumption: admit_plan_serve_entry_verdict(
                record: record,
                expected_source_revision: observe_checkout_head_hex(),
                expected_entry: spec.service.serve_entry as String,
                expected_argv_digest: serve_entry_argv_digest(spec: spec),
                admitted_bin_sha256_hex: digest.hex as String,
              ),
            )
        }
      }
    }
  }
}

// The plan job's compile answer recorded as the verdict document the swap consumes. One arm per
// compile outcome; the identity fields are the plan checkout's own facts.
fn serve_entry_verdict_record_of(
  compile: ServeEntryCompileVerdict,
  source_revision: String,
  entry: String,
  argv_digest: String,
  compiler_bin_sha256_hex: String,
) -> ServeEntryVerdictRecord {
  match compile {
    ServeEntryCompileAdmitted =>
      ServeEntryVerdictAdmitted {
        source_revision: source_revision,
        entry: entry,
        argv_digest: argv_digest,
        compiler_bin_sha256_hex: compiler_bin_sha256_hex,
      }
    ServeEntryCompileBlocked { blocking, diagnostics } =>
      ServeEntryVerdictBlocked {
        source_revision: source_revision,
        entry: entry,
        argv_digest: argv_digest,
        compiler_bin_sha256_hex: compiler_bin_sha256_hex,
        blocking: blocking,
        diagnostics_text: join(diagnostics, "\n"),
      }
    ServeEntryCompileUnobserved { detail } =>
      ServeEntryVerdictUnobserved {
        source_revision: source_revision,
        entry: entry,
        argv_digest: argv_digest,
        compiler_bin_sha256_hex: compiler_bin_sha256_hex,
        detail: detail,
      }
  }
}

fn record_plan_serve_entry_verdict_for(row: DesiredDeployment) -> ProcessExit {
  let spec = selected_deployment_spec(row: row)
  let root = git.Inspect.Toplevel()
  let root_path = root.path as String
  let bin = witness_bin_release_path(root: root_path, bin_name: "gunbc")
  match sha256sum_file_digest_via_shell(path: bin as NonEmptyStr) {
    Sha256FileDigestUnavailable { path: wanted, reason } =>
      exit_failure(reason: join(["live_deploy: record_plan_serve_entry_compile_verdict — the pair build produced no digestable gunbc at ", wanted as String, ": ", reason], ""))
    Sha256FileDigest { digest } => {
      let compile = observe_serve_entry_compile_clean(
        repo_root: root_path,
        bin_path: bin,
        roots: deployment_serve_source_roots,
        entry: spec.service.serve_entry as String,
      )
      let record = serve_entry_verdict_record_of(
        compile: compile,
        source_revision: observe_checkout_head_hex(),
        entry: spec.service.serve_entry as String,
        argv_digest: serve_entry_argv_digest(spec: spec),
        compiler_bin_sha256_hex: digest.hex as String,
      )
      let path = serve_entry_verdict_path()
      let write = Filesystem.Write(path: path, content: serialize_json(value: serve_entry_verdict_json(record: record)))
      if !write.success {
        exit_failure(reason: join(["live_deploy: record_plan_serve_entry_compile_verdict — could not write ", path, ": ", write.error], ""))
      } else {
        match compile {
          ServeEntryCompileAdmitted => ExitSuccess
          ServeEntryCompileBlocked { blocking, diagnostics } =>
            exit_failure(reason: join(["live_deploy: record_plan_serve_entry_compile_verdict — the serve entry does not compile cleanly; ", int_to_decimal_string(value: blocking), " blocking: ", serve_entry_blocking_summary(diagnostics: diagnostics)], ""))
          ServeEntryCompileUnobserved { detail } =>
            exit_failure(reason: join(["live_deploy: record_plan_serve_entry_compile_verdict — the serve-entry compile was not observed: ", detail], ""))
        }
      }
    }
  }
}

// PLAN-JOB ENTRY (fleet-converge job, after the plan step, before the artifact upload): compile
// the prod-role serve entry with the release pair the run itself built, and publish the verdict
// beside the plan receipt so the swap consumes it by identity. A blocked or unobserved compile
// fails the PLAN RUN here, where the fold belongs -- the deploy chain then never starts, and
// PR 1's run-pointer admission names the refused plan run.
fn record_plan_serve_entry_compile_verdict() -> ProcessExit {
  match prod_role_desired_deployment() {
    ProdRoleDeploymentSelected { deployment } => record_plan_serve_entry_verdict_for(row: deployment)
    ProdRoleDeploymentRefused =>
      exit_failure(reason: "live_deploy: record_plan_serve_entry_compile_verdict — the prod-role desired deployment is refused; the serve-entry verdict has no subject")
    ProdRoleDeploymentRosterRefused =>
      exit_failure(reason: "live_deploy: record_plan_serve_entry_compile_verdict — the desired roster is refused; the serve-entry verdict has no subject")
    ProdRoleDeploymentHolderRowMismatch =>
      exit_failure(reason: "live_deploy: record_plan_serve_entry_compile_verdict — the prod-role holder row mismatches the roster")
  }
}
