module gunbc.live_deploy.lab_host_plan

import std.types { Bool, Int, NonEmptyStr, String, FilePath }
import std.dissolution { DissolutionCondition, unbound_dissolution }
import std.optional { Absent, Present }
import std.os.types { OsPackageManager, Apt, Winget, HomebrewDeFacto }
import gunbc.host.host_software_surface {
  HostSoftwareSurface,
  HostPackageManagerKnown,
  HostPackageManagerUnobserved,
  UserManagerDoesNotEnforceSandbox,
  UserManagerSandboxUnobserved,
  UserManagerSandboxEnforcementUnobserved,
  UserManagerSandboxSysctlUnreadable,
  UserManagerSandboxEnforcement,
  host_software_surface_for_identity,
  host_os_package_manager,
  user_manager_sandbox_enforcement,
  host_tailscale_client,
  host_toolchain_read_obligation,
  srv1_software_surface,
}
import product.host_identity { HostIdentity }
import gunbc.fleet.fleet_intent { ComputeHost }
import extdeps.tailscale.serve { TailscaleServeCapability, ScopedRemovalUnobserved }

// FIRST CONSUMER of the per-host software surface (DESIGN 3c). gunbc.live_deploy.spec
// deployment_srv1_target matches srv1_lab_deploy_plan: LabPlanReady fills os_package_manager and
// tailscale_client; LabPlanRefused maps to none / ScopedRemovalUnobserved so emit refuses to
// produce a retract (and apply, once the client is unobserved) rather than deploying past a
// refused plan. Witnesses are not this consumer.
//
// WORKER-SANDBOX SELECTION. A host whose user manager does not enforce ProtectHome must not yield a
// plan that claims user-manager confinement (sysctl 1 → system-manager launcher). Sysctl 0 is a
// bet that the user manager would enforce, not an observation of confinement, so the plan refuses
// rather than minting ProtectHome (DESIGN 4d). The selected identity is SystemManagerLauncherSelected.
// Wiring that identity into the launcher / apply path is a declared frontier
// (system_manager_launcher_wiring_frontier), not a comment.

type WorkerSandboxChoice
  = SystemManagerLauncherSelected

type WorkerSandboxSelection
  = WorkerSandboxChosen { choice: WorkerSandboxChoice }
  | WorkerSandboxRefused { cause: UserManagerSandboxEnforcement }

type LabDeployPlanRefusal
  = LabOsUnobserved { obligation: NonEmptyStr }
  | LabSandbox { cause: UserManagerSandboxEnforcement }
  | LabToolchainUnobserved { obligation: NonEmptyStr }

type LabDeployPlan
  = LabPlanReady {
      host: HostIdentity
      os_package_manager: OsPackageManager
      tailscale_client: TailscaleServeCapability
      git_path: FilePath
      jq_path: FilePath
      timeout_path: FilePath
      worker_sandbox: WorkerSandboxChoice
    }
  | LabPlanRefused { cause: LabDeployPlanRefusal }

fn select_worker_sandbox(surface: HostSoftwareSurface) -> WorkerSandboxSelection {
  match user_manager_sandbox_enforcement(surface: surface) {
    UserManagerDoesNotEnforceSandbox { wrote_into_home: _ } =>
      WorkerSandboxChosen { choice: SystemManagerLauncherSelected }
    UserManagerSandboxUnobserved { obligation: o } =>
      WorkerSandboxRefused { cause: UserManagerSandboxUnobserved { obligation: o } }
    UserManagerSandboxEnforcementUnobserved { obligation: o } =>
      WorkerSandboxRefused { cause: UserManagerSandboxEnforcementUnobserved { obligation: o } }
    UserManagerSandboxSysctlUnreadable { value: n } =>
      WorkerSandboxRefused { cause: UserManagerSandboxSysctlUnreadable { value: n } }
  }
}

fn lab_deploy_plan_from_software(surface: HostSoftwareSurface) -> LabDeployPlan {
  match host_os_package_manager(surface: surface) {
    HostPackageManagerUnobserved { obligation: o } => LabPlanRefused { cause: LabOsUnobserved { obligation: o } }
    HostPackageManagerKnown { manager: manager } =>
      match select_worker_sandbox(surface: surface) {
        WorkerSandboxRefused { cause: c } => LabPlanRefused { cause: LabSandbox { cause: c } }
        WorkerSandboxChosen { choice: choice } =>
          match surface.toolchain_paths.value.git {
            Absent => LabPlanRefused {
              cause: LabToolchainUnobserved { obligation: host_toolchain_read_obligation(surface: surface) }
            }
            Present { value: git } =>
              match surface.toolchain_paths.value.jq {
                Absent => LabPlanRefused {
                  cause: LabToolchainUnobserved { obligation: host_toolchain_read_obligation(surface: surface) }
                }
                Present { value: jq } =>
                  match surface.toolchain_paths.value.timeout {
                    Absent => LabPlanRefused {
                      cause: LabToolchainUnobserved { obligation: host_toolchain_read_obligation(surface: surface) }
                    }
                    Present { value: timeout } => LabPlanReady {
                      host: surface.host,
                      os_package_manager: manager,
                      tailscale_client: host_tailscale_client(surface: surface),
                      git_path: git,
                      jq_path: jq,
                      timeout_path: timeout,
                      worker_sandbox: choice,
                    }
                  }
              }
          }
      }
  }
}

fn lab_deploy_plan_for_host_identity(identity: HostIdentity) -> LabDeployPlan {
  lab_deploy_plan_from_software(surface: host_software_surface_for_identity(identity: identity))
}

fn lab_deploy_plan_for_compute_host(host: ComputeHost) -> LabDeployPlan {
  lab_deploy_plan_for_host_identity(identity: host.identity)
}

fn srv1_lab_deploy_plan() -> LabDeployPlan {
  lab_deploy_plan_from_software(surface: srv1_software_surface())
}

data system_manager_launcher_wiring_frontier: DissolutionCondition = unbound_dissolution(
  description: "dissolve-on: gunbc#13942 (session/bold-dove-819) lands a consumed system-manager launcher identity, and live_deploy emit / host_effect realize bind LabPlanReady.worker_sandbox SystemManagerLauncherSelected to that identity on the applying path. NOT satisfied by this module importing those types while apply still launches without them. Trigger: the apply emitter takes WorkerSandboxChoice from the Ready plan and emits that launcher." as NonEmptyStr,
)

fn lab_plan_refusal_reason(cause: LabDeployPlanRefusal) -> NonEmptyStr {
  match cause {
    LabOsUnobserved { obligation: o } => o
    LabToolchainUnobserved { obligation: o } => o
    LabSandbox { cause: e } =>
      match e {
        UserManagerSandboxUnobserved { obligation: o } => o
        UserManagerSandboxEnforcementUnobserved { obligation: o } => o
        UserManagerDoesNotEnforceSandbox { wrote_into_home: r } => r
        UserManagerSandboxSysctlUnreadable { value: n } =>
          join(["apparmor userns sysctl unreadable: ", to_string(n)], "") as NonEmptyStr
      }
  }
}

type LabPlanDeployFields {
  os_package_manager: OsPackageManager?
  tailscale_client: TailscaleServeCapability
}

fn lab_plan_deploy_fields(plan: LabDeployPlan) -> LabPlanDeployFields {
  match plan {
    LabPlanReady { host: _, os_package_manager: m, tailscale_client: ts, git_path: _, jq_path: _, timeout_path: _, worker_sandbox: _ } =>
      LabPlanDeployFields {
        os_package_manager: Present { value: m },
        tailscale_client: ts,
      }
    LabPlanRefused { cause: c } =>
      LabPlanDeployFields {
        os_package_manager: none,
        tailscale_client: ScopedRemovalUnobserved { reason: lab_plan_refusal_reason(cause: c) as String },
      }
  }
}

fn plan_selects_system_manager_launcher(plan: LabDeployPlan) -> Bool {
  match plan {
    LabPlanRefused { cause: _ } => false
    LabPlanReady { host: _, os_package_manager: _, tailscale_client: _, git_path: _, jq_path: _, timeout_path: _, worker_sandbox: choice } =>
      match choice {
        SystemManagerLauncherSelected => true
      }
  }
}

fn plan_package_manager(plan: LabDeployPlan) -> OsPackageManager? {
  match plan {
    LabPlanRefused { cause: _ } => none
    LabPlanReady { host: _, os_package_manager: m, tailscale_client: _, git_path: _, jq_path: _, timeout_path: _, worker_sandbox: _ } =>
      Present { value: m }
  }
}

fn plan_git_path(plan: LabDeployPlan) -> FilePath? {
  match plan {
    LabPlanRefused { cause: _ } => none
    LabPlanReady { host: _, os_package_manager: _, tailscale_client: _, git_path: p, jq_path: _, timeout_path: _, worker_sandbox: _ } =>
      Present { value: p }
  }
}

fn plan_jq_path(plan: LabDeployPlan) -> FilePath? {
  match plan {
    LabPlanRefused { cause: _ } => none
    LabPlanReady { host: _, os_package_manager: _, tailscale_client: _, git_path: _, jq_path: p, timeout_path: _, worker_sandbox: _ } =>
      Present { value: p }
  }
}

fn plan_timeout_path(plan: LabDeployPlan) -> FilePath? {
  match plan {
    LabPlanRefused { cause: _ } => none
    LabPlanReady { host: _, os_package_manager: _, tailscale_client: _, git_path: _, jq_path: _, timeout_path: p, worker_sandbox: _ } =>
      Present { value: p }
  }
}

fn package_manager_is_apt(m: OsPackageManager) -> Bool {
  match m {
    Apt => true
    Winget => false
    HomebrewDeFacto => false
  }
}

// WHY DispatchHostEnvironment SUBSTRING PROBES ARE NOT REPLACED HERE. Those probes are a live
// preflight of the process about to exec (this binary, now). The host software surface is a
// standing figure used to PLAN. Substituting the catalogued version label into identity_contains
// would make dispatch refuse when the live binary drifted from the last transcribed row, which is
// the opposite of what preflight is for. The typed versions are what THIS plan reads; dispatch
// preflight stays a reading of the bytes on PATH. Dissolve-on: dispatch preflight takes a
// HostSoftwareSurface and checks the live --version output against the typed label as an
// inhabitance claim, at which point the substring needles can go.
