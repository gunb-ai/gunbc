module gunbc.live_deploy.service_ready

import std.types { NonEmptyStr, String, Duration, Bool, List }
import std.disposition { Disposition, Scaffold, RealizationDispatch }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import gunbc.live_deploy.spec { gunbc_roadmap_unit_name }
import gunbc.roadmap_static_site { roadmap_site_health_path }
import gunbc.roadmap_health { roadmap_health_probe_path }
import v2.std.dependency { ready_set }
import v2.std.node { Node }

data live_deploy_service_ready_scaffold_disposition: Disposition = Scaffold {
  dissolves_to: RealizationDispatch,
  bind: DeclarationRef {
    module_path: "gunbc.live_deploy.service_ready",
    decl_name: "live_deploy_service_ready_predicate",
    field: WholeDeclaration,
  }
}

type ServiceReadyPredicate {
  unit: NonEmptyStr
  health_endpoint: NonEmptyStr
}

type ServiceNotReady {
  unit: NonEmptyStr
  endpoint: NonEmptyStr
  waited: Duration
  last_probe: String
}

data live_deploy_service_ready_poll_bound_seconds: Duration = 30

fn live_deploy_service_ready_predicate() -> ServiceReadyPredicate {
  ServiceReadyPredicate {
    unit: gunbc_roadmap_unit_name,
    health_endpoint: roadmap_site_health_path,
  }
}

fn service_ready_predicate_unit(predicate: ServiceReadyPredicate) -> NonEmptyStr {
  predicate.unit
}

fn service_ready_predicate_endpoint(predicate: ServiceReadyPredicate) -> NonEmptyStr {
  predicate.health_endpoint
}

fn service_not_ready_reason(refusal: ServiceNotReady) -> String {
  concat(
    concat(
      concat(
        concat("ServiceNotReady unit=", refusal.unit as String),
        concat(" endpoint=", refusal.endpoint as String)
      ),
      concat(" waited_s=", to_string(refusal.waited))
    ),
    concat(" last_probe=", refusal.last_probe)
  )
}

fn live_deploy_readback_ready_set(graph_node: Node) -> List<Node> {
  ready_set(graph_node: graph_node)
}

fn live_deploy_readiness_poll_bound_seconds() -> Duration {
  live_deploy_service_ready_poll_bound_seconds
}

fn live_deploy_readiness_poll_bound_is_positive() -> Bool {
  live_deploy_service_ready_poll_bound_seconds > 0
}
