module gunbc.live_deploy.capacity_capture_provider

import std.decl_ref { decl_ref }
import std.types { String, NonEmptyStr, Timestamp }
import std.error_primitives { Result, Ok, Err }
import std.optional { Present, Absent }
import std.cache_identity { cutover_capture_artifact_kind }
import std.materialization_provider { ArtifactRequest, CutoverCaptureRequest }
import std.materialization_object { StoreCommit, StoreCommitSettled, StoreCommitRefused }
import std.judgment_contract { output_fabric_blob }
import extdeps.realization.materialization_store_local {
  LocalStoreCapability, LocalStoreBracket, LocalStoreFamilyHeld, LocalStoreStagedPart,
  LocalStoreRetentionRefusal, local_store_binding_path, local_store_held_session,
  local_store_bind_retention, local_store_commit_under_request,
}
import gunbc.durable_cas_file_store { SlotStore, slot_observe }
import std.durable_compare_and_set { CasObservedReadable, CasObservedUnreadable, CasReadableAbsent, CasReadablePresent }
import extdeps.languages.json.emit { serialize_json, json_array, json_string }
import gunbc.live_deploy.capacity_capture_store { CapacityCaptureStore, CapturedUnitBlob, capacity_capture_blob_lookup, capacity_capture_blob_path }
import gunbc.live_deploy.capacity_cutover_recovery { CapacityCutoverRecord, CapacityCapturingGeneration, capacity_generation_request }
import gunbc.live_deploy.capacity_cutover_record { capacity_cutover_record_decode }
import gunbc.live_deploy.capacity_migration_approval { CapacityCutoverAuthorization, CapacityCutoverFileOperation, CapacityCaptureCreate, capacity_cutover_file_admission }

// A supplied record is useful to hermetic witnesses; the production binding
// below reads this same input from the durable CAS store INSIDE the family hold.
// No capture can be published before the journal records its identity. Therefore
// a crash after blob commit cannot leave an unrooted prior-generation capture.
fn capacity_capture_journal_admission(store: CapacityCaptureStore, request: ArtifactRequest,
  journal: Result<CapacityCutoverRecord, String>) -> Result<ArtifactRequest, String> {
  match journal {
    Err { value: why } => Err { value: why }
    Ok { value: record } => if record.attempt != store.attempt {
      Err { value: "capture journal belongs to another cutover" }
    } else if record.phase != CapacityCapturingGeneration {
      Err { value: "capture must finish before inhibition or installation begins" }
    } else if !fold(record.prior + record.target, init: false,
      f: (found, file) => found || capacity_generation_request(file: file) == request) {
      Err { value: "capture identity is not retained by the cutover journal" }
    } else { Ok { value: request } }
  }
}

fn capacity_capture_read_journal(journal: SlotStore, key: NonEmptyStr) -> Result<CapacityCutoverRecord, String> {
  match slot_observe(store: journal, key: key) {
    CasObservedUnreadable { cause: _ } => Err { value: "capture journal is unreadable; do not publish or reclaim" }
    CasObservedReadable { readable: CasReadableAbsent } => Err { value: "capture journal is absent; do not publish or reclaim" }
    CasObservedReadable { readable: CasReadablePresent { version: version } } => capacity_cutover_record_decode(text: version.value as String)
  }
}

type CapacityCaptureFault
  = CapacityCaptureBoundaryRefused { detail: String }
  | CapacityCaptureRetentionRefused { refusal: LocalStoreRetentionRefusal }
  | CapacityCaptureCommitRefused { commit: StoreCommit }

// The store's existing retention binding pins the exact journal root/key, not
// just an apply label. It forbids opening the same store with a different owner.
// Journal advancement and eventual reclamation must use this same family hold.
// No journal advancement or reclamation transport is implemented in this module.
// Reclamation stays unavailable here until discharge/recovery provides its
// terminal receipt; an absent or unreadable journal is never permission to GC.
fn capacity_capture_approval_admission(store: CapacityCaptureStore, request: ArtifactRequest,
  approval: CapacityCutoverAuthorization, now: fn() -> Result<Timestamp, String>) -> Result<ArtifactRequest, String> {
  if approval.intent.attempt != store.attempt { return Err { value: "capture approval belongs to another cutover" } }
  match request {
    CutoverCaptureRequest { host: host, source_unit: _, digest: _ } => if host != approval.intent.host { return Err { value: "capture host differs from the approved host" } }
    _ => { return Err { value: "not a cutover capture request" } }
  }
  let path = match capacity_capture_blob_path(store: store, request: request) {
    Err { value: why } => { return Err { value: why } }
    Ok { value: value } => value
  }
  let at = match now() { Err { value: why } => { return Err { value: why } } Ok { value: value } => value }
  match capacity_cutover_file_admission(authorization: approval,
    operation: CapacityCutoverFileOperation { path: path, verb: CapacityCaptureCreate }, at: at) {
    Err { value: why } => Err { value: why }
    Ok { value: _ } => Ok { value: request }
  }
}

fn capacity_capture_publish(store: CapacityCaptureStore, provider: LocalStoreCapability,
  journal: SlotStore, key: NonEmptyStr, request: ArtifactRequest,
  approval: CapacityCutoverAuthorization, now: fn() -> Result<Timestamp, String>) -> Result<LocalStoreBracket<Result<CapturedUnitBlob, CapacityCaptureFault>>, CapacityCaptureFault> {
  // Approval precedes even the provider's hold-acquisition writes. Recheck it
  // inside the bracket immediately before publication after waiting for the hold.
  if local_store_binding_path(b: provider.binding) != (store.root as String) {
    return Err { value: CapacityCaptureBoundaryRefused { detail: "capture provider and ownership roots differ" } }
  }
  match capacity_capture_approval_admission(store: store, request: request, approval: approval, now: now) {
    Err { value: why } => Err { value: CapacityCaptureBoundaryRefused { detail: why } }
    Ok { value: admitted } => Ok { value: local_store_held_session(capability: provider, family: cutover_capture_artifact_kind, run: held =>
      capacity_capture_publish_held(store: store, provider: provider, held: held, journal: journal,
        key: key, request: admitted, approval: approval, now: now)) }
  }
}

fn capacity_capture_publish_held(store: CapacityCaptureStore, provider: LocalStoreCapability,
  held: LocalStoreFamilyHeld, journal: SlotStore, key: NonEmptyStr, request: ArtifactRequest,
  approval: CapacityCutoverAuthorization, now: fn() -> Result<Timestamp, String>) -> Result<CapturedUnitBlob, CapacityCaptureFault>
  admit_callers: [decl_ref(module_path: "gunbc.live_deploy.capacity_capture_provider", decl_name: "capacity_capture_publish")]
{
  if local_store_binding_path(b: provider.binding) != (store.root as String) {
    return Err { value: CapacityCaptureBoundaryRefused { detail: "capture provider and ownership roots differ" } }
  }
  let admitted = match capacity_capture_journal_admission(store: store, request: request,
    journal: capacity_capture_read_journal(journal: journal, key: key)) {
    Err { value: why } => { return Err { value: CapacityCaptureBoundaryRefused { detail: why } } }
    Ok { value: value } => value
  }
  match capacity_capture_approval_admission(store: store, request: admitted, approval: approval, now: now) {
    Err { value: why } => { return Err { value: CapacityCaptureBoundaryRefused { detail: why } } }
    Ok { value: _ } => {}
  }
  let scope = serialize_json(v: json_array(elements: [json_string(s: journal.root as String), json_string(s: key as String)])) as NonEmptyStr
  match local_store_bind_retention(held: held, scope: scope) {
    Present { value: refusal } => Err { value: CapacityCaptureRetentionRefused { refusal: refusal } }
    Absent => match admitted {
      CutoverCaptureRequest { host: host, source_unit: source, digest: _ } => {
        if host != approval.intent.host { return Err { value: CapacityCaptureBoundaryRefused { detail: "capture host differs from the approved host" } } }
        let saved = local_store_commit_under_request(held: held, req: admitted, payloads: [],
          parts: [LocalStoreStagedPart { id: output_fabric_blob, staged: source }])
        match saved.commit {
          StoreCommitRefused { key: _, refusal: _ } => Err { value: CapacityCaptureCommitRefused { commit: saved.commit } }
          StoreCommitSettled { receipt: _ } => match capacity_capture_blob_lookup(store: store, request: admitted, provider: provider) {
            Err { value: why } => Err { value: CapacityCaptureBoundaryRefused { detail: why } }
            Ok { value: capture } => Ok { value: capture }
          }
        }
      }
      _ => Err { value: CapacityCaptureBoundaryRefused { detail: "not a cutover capture request" } }
    }
  }
}
