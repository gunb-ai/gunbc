module gunbc.live_deploy.intent

import std.types { String, NonEmptyStr, Int, List }
import std.measure { Second, second, second_count }
import v2.std.orchestration {
  Pipeline,
  PipelineStep,
  Do,
  Run,
  Retry,
  FailFast,
}
import gunbc.live_deploy.service_ready {
  ServiceNotReady,
  service_not_ready_reason,
  live_deploy_service_ready_poll_bound,
  live_deploy_service_ready_unit_authority,
  live_deploy_service_ready_endpoint_authority,
}
import gunbc.roadmap_static_site {
  roadmap_site_health_path,
  roadmap_site_readback_curl_digest_check,
  roadmap_site_roadmap_url_path,
  roadmap_site_dispatch_url_path,
  roadmap_site_roadmap_md_artifact,
  roadmap_site_dispatch_json_artifact,
}
import gunbc.live_deploy.spec { DeploymentSpec, deployment_plan_listen_port }

type TransportCurlHealthzProbe {
  health_url: NonEmptyStr
}

type ServiceReadyGate {
  probe: TransportCurlHealthzProbe
  timeout: Second
  on_not_ready: ServiceNotReady
}

type LiveDeployReadback {
  after: ServiceReadyGate
  port: Int
}

fn live_deploy_health_url_for_port(port: Int) -> NonEmptyStr {
  concat(concat("http://127.0.0.1:", to_string(port)), roadmap_site_health_path) as NonEmptyStr
}

fn live_deploy_service_ready_gate_for_spec(spec: DeploymentSpec) -> ServiceReadyGate {
  let port = deployment_plan_listen_port(spec: spec)
  ServiceReadyGate {
    probe: TransportCurlHealthzProbe {
      health_url: live_deploy_health_url_for_port(port: port),
    },
    timeout: live_deploy_service_ready_poll_bound,
    on_not_ready: ServiceNotReady {
      unit: live_deploy_service_ready_unit_authority,
      endpoint: live_deploy_service_ready_endpoint_authority,
      waited: live_deploy_service_ready_poll_bound,
      last_probe: "health probe never succeeded",
    },
  }
}

fn live_deploy_readback_for_spec(spec: DeploymentSpec) -> LiveDeployReadback {
  LiveDeployReadback {
    after: live_deploy_service_ready_gate_for_spec(spec: spec),
    port: deployment_plan_listen_port(spec: spec),
  }
}

fn live_deploy_health_probe_curl_command(health_url: NonEmptyStr) -> String {
  concat(
    concat("curl -sf ", "\""),
    concat(health_url as String, "\"")
  )
}

fn live_deploy_service_ready_gate_probe_run(gate: ServiceReadyGate) -> Run {
  Run {
    command: live_deploy_health_probe_curl_command(health_url: gate.probe.health_url),
    env: [],
    redirect: Absent,
    capture: Absent,
  }
}

fn live_deploy_service_ready_gate_exhausted_pipeline(gate: ServiceReadyGate) -> Pipeline {
  Pipeline {
    steps: [
      Do {
        run: Run {
          command: concat(
            "echo ",
            sh_single_quote(s: service_not_ready_reason(refusal: gate.on_not_ready)),
            " >&2; exit 1"
          ),
          env: [],
          redirect: Absent,
          capture: Absent,
        },
      },
    ],
    on_failure: FailFast,
  }
}

fn live_deploy_readback_digest_steps(port: Int) -> List<PipelineStep> {
  let base = concat("http://127.0.0.1:", to_string(port))
  let roadmap = roadmap_site_roadmap_md_artifact()
  let dispatch = roadmap_site_dispatch_json_artifact()
  [
    Do {
      run: Run {
        command: roadmap_site_readback_curl_digest_check(
          url: concat(base, roadmap.url_path),
          expected: roadmap.digest
        ),
        env: [],
        redirect: Absent,
        capture: Absent,
      },
    },
    Do {
      run: Run {
        command: roadmap_site_readback_curl_digest_check(
          url: concat(base, dispatch.url_path),
          expected: dispatch.digest
        ),
        env: [],
        redirect: Absent,
        capture: Absent,
      },
    },
  ]
}

fn sh_single_quote(s: String) -> String {
  concat(concat("'", s), "'")
}
