module gunbc.live_deploy.intent

import std.types { String, NonEmptyStr, Int, CommitSha, List }
import std.disposition { Disposition, Scaffold, Terminal, SingleAuthority }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import std.measure { Second }
import gunbc.live_deploy.service_ready {
  ServiceNotReady,
  live_deploy_service_ready_poll_bound,
  live_deploy_service_ready_unit_authority,
  live_deploy_service_ready_endpoint_authority,
  UnitDiagnosisUnavailable,
}
import gunbc.roadmap_static_site { roadmap_site_health_path, sh_single_quote }
import gunbc.live_deploy.spec { DeploymentSpec, deployment_plan_listen_port }
import gunbc.live_deploy.revision {
  deploy_slot_revision_receipt_path,
  deploy_slot_revision_receipt_dir,
}

type TransportCurlHealthzProbe {
  health_url: NonEmptyStr
}

type ServiceReadyGate {
  probe: TransportCurlHealthzProbe
  timeout: Second
  on_not_ready: ServiceNotReady
}

type LiveDeployReadback {
  after: ServiceReadyGate
  port: Int
}

fn live_deploy_health_url_for_port(port: Int) -> NonEmptyStr {
  concat(concat("http://127.0.0.1:", to_string(port)), roadmap_site_health_path) as NonEmptyStr
}

fn live_deploy_service_ready_gate_for_spec(spec: DeploymentSpec) -> ServiceReadyGate {
  let port = deployment_plan_listen_port(spec: spec)
  ServiceReadyGate {
    probe: TransportCurlHealthzProbe {
      health_url: live_deploy_health_url_for_port(port: port),
    },
    timeout: live_deploy_service_ready_poll_bound,
    on_not_ready: ServiceNotReady {
      unit: live_deploy_service_ready_unit_authority,
      endpoint: live_deploy_service_ready_endpoint_authority,
      waited: live_deploy_service_ready_poll_bound,
      last_probe: "health probe never succeeded",
      unit_diagnosis: UnitDiagnosisUnavailable,
    },
  }
}

fn live_deploy_readback_for_spec(spec: DeploymentSpec) -> LiveDeployReadback {
  LiveDeployReadback {
    after: live_deploy_service_ready_gate_for_spec(spec: spec),
    port: deployment_plan_listen_port(spec: spec),
  }
}

data live_deploy_unit_diagnosis_capture_exit_note: String = "DECLARED SCAFFOLD — live_deploy_unit_status_tail_command was an unmarked workaround (justification without a dissolution trigger). Poll-bound readiness capture now routes through gunbc.systemctl_status_read (typed Systemctl.Status, exit code as data, never masked). RESIDUE: tree_sync_restart_step_with_diagnosis in emit.dag still shells this concat into foreign-executor bash until typed host_effect_apply lands there. dissolves-on: unit-diagnosis modeled as a typed systemd.Systemctl.Status observation that reports exit code as data in UnitStatusCapture, never masked by '| tail' or trailing 'exit 0'; delete live_deploy_unit_status_tail_command concat."

data live_deploy_unit_diagnosis_dissolution_trigger: String = "dissolves-on: unit-diagnosis modeled as a typed systemd.Systemctl.Status observation (exit code recorded as data in UnitStatusCapture, never masked by '| tail' or trailing 'exit 0'); delete live_deploy_unit_status_tail_command concat."

data live_deploy_unit_status_emit_scaffold_note: String = "Emit-only residue: tree_sync_restart_step_with_diagnosis (gunbc.live_deploy.emit) still shells live_deploy_unit_status_tail_command into foreign-executor bash. Readiness unit_diagnosis now routes through systemd.Systemctl.Status (gunbc.systemctl_status_read); dissolve this concat when tree-sync restart migrates to typed host_effect_apply."

data live_deploy_unit_status_tail_scaffold: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.live_deploy.intent",
    decl_name: "live_deploy_unit_diagnosis_dissolution_trigger",
    field: WholeDeclaration,
  }
}

fn live_deploy_unit_status_tail_command(unit: NonEmptyStr) -> String {
  concat(
    concat("systemctl status --no-pager --full ", unit as String),
    " 2>&1 | tail -n 40"
  )
}

data slot_revision_receipt_transport_note: String = "THE RECEIPT SCRIPTS LIVE HERE AND NOT IN gunbc.live_deploy.revision, because that module is the DECISION authority and every witness over it runs hermetically. Giving it a shell dependency would put host-effect construction inside the one module whose whole value is being a pure fold from an observation to a disposition. The path is still revision.dag's — imported, never re-spelled — so there is exactly one place that knows where a slot records its revision.\\n\\nWHY THE READ DISTINGUISHES ABSENCE FROM FAILURE AT THE SCRIPT BOUNDARY. The three-way split ObservedDeployedRevision makes is only real if the shell can express it, so a missing file exits ZERO with the literal token below, and every other problem — an unreadable file, a failed dispatch, a transport error — exits nonzero and lands in the Unreadable arm. Encoding absence as a nonzero exit would fuse it with failure at the boundary and leave the typed split downstream describing a distinction the observation never carried.\\n\\nTHE CONTENT IS PASSED THROUGH EXACTLY, NOT NORMALIZED, AND AN EARLIER REVISION GOT THIS BACKWARDS (operator ruling 2026-08-05). It ran `tr -d '[:space:]'` before validating, described as stripping a trailing newline — but `tr -d` deletes INTERNAL whitespace too, so a receipt corrupted into fragments separated by spaces or newlines collapses into a well-formed 40-character hex string and is ACCEPTED. The note claimed anything other than a valid sha is refused while the realization was actively repairing corruption into validity.\\n\\nSo the read is `cat --` and the decoder demands exact bytes. The writer emits no trailing newline, so exact-bytes is also the simplest contract.\\n\\nTHE SIZE GATE IS IN THE SCRIPT BECAUSE THE TRANSPORT TRIMS, AND WITHOUT IT THE EXACT-BYTE CLAIM WAS SPECIFICATION WITHOUT EXECUTION (operator ruling 2026-08-05). The wet shell dispatcher applies `.trim_end()` to stdout (`v1_interpreter.rs`, the ShellResult construction), so a receipt of 40 hex bytes followed by LF, CR, space or TAB arrives at the decoder as a clean 40-byte sha and is ACCEPTED — while the witness asserting a trailing newline refuses passed, because it called the parser directly and never crossed that boundary. Internal corruption still refused, so the repair-into-validity class stayed closed; what was false was the exactness claim itself.\\n\\nSo the file's SIZE is checked before anything is emitted, at the only boundary that executes. A receipt that is not exactly 40 bytes exits nonzero and lands in the Unreadable arm; trailing whitespace is now a refusal in fact and not only in prose. The decoder keeps its own hex validation, because size alone does not make 40 bytes a sha."

data slot_revision_unrecorded_token: String = "unrecorded"

data slot_revision_receipt_exact_bytes: Int = 40

fn live_deploy_slot_revision_read_script(spec: DeploymentSpec) -> String {
  let path = deploy_slot_revision_receipt_path(slot: spec) as String
  join(
    [
      "set -euo pipefail\n",
      "# routed-slot revision receipt read (gunbc.live_deploy.revision deploy_slot_revision_receipt_path)\n",
      "_gunbc_receipt=", sh_single_quote(s: path), "\n",
      "if [ ! -e \"$_gunbc_receipt\" ]; then printf '%s' ", sh_single_quote(s: slot_revision_unrecorded_token), "; exit 0; fi\n",
      "_gunbc_receipt_bytes=$(wc -c < \"$_gunbc_receipt\")\n",
      "if [ \"$_gunbc_receipt_bytes\" -ne ", to_string(slot_revision_receipt_exact_bytes), " ]; then exit 1; fi\n",
      "cat -- \"$_gunbc_receipt\"\n",
    ],
    ""
  )
}

data slot_revision_tree_head_note: String = "GROUNDING A SLOT THAT PREDATES THE RECEIPT MODEL, from the slot's own synced git metadata rather than from anything the deploy remembers. The tree sync whitelists HEAD, objects, packed-refs and refs into the slot's repo root (gunbc.live_deploy.emit apply_tree_split_sync_note and its unit ExecStart), so `git rev-parse HEAD` inside that root answers what the last successful sync put there — an observation of the slot, not a claim by the run doing the observing.\\n\\nWHY THIS IS ALLOWED TO CREATE THE FIRST RECEIPT WHEN AN ABSENT RECEIPT OTHERWISE REFUSES. The refusal exists because 'no receipt' means the routed slot's revision is UNKNOWN while it is demonstrably serving something — the danger is authorizing a candidate against an unknown, not the absence of a file. Grounding removes the unknown by reading the slot, so the receipt it writes states a fact that was already true. What it must never do is invent one: an unreadable root, a non-repository, a detached or malformed HEAD all exit nonzero here and land in the Unreadable arm, which refuses. There is no arm that guesses.\\n\\nIT IS NOT A CANDIDATE ADMISSION. Grounding writes the ACTIVE slot's receipt and then the ordinary decision runs against it unchanged, so a stale candidate still keeps and an unrelated one still refuses. The only thing it changes is that the comparison has a grounded left-hand side."

fn live_deploy_slot_tree_head_read_script(spec: DeploymentSpec, tree_root: String) -> String {
  join(
    [
      "set -euo pipefail\n",
      "# legacy active-slot revision grounding (gunbc.live_deploy.intent slot_revision_tree_head_note)\n",
      "_gunbc_tree=", sh_single_quote(s: tree_root), "\n",
      "git -C \"$_gunbc_tree\" rev-parse HEAD\n",
    ],
    ""
  )
}

data slot_revision_shared_parent_ownership_note: String = "THE SHARED PARENT IS CREATED WITHOUT -o/-g, AND THAT IS WHAT MAKES A SECOND SLOT USER UNWRITABLE RATHER THAN MERELY UNLIKELY (review 48335). An earlier revision created /var/lib/gunbc/deploy-revision with `-o <service_user> -g <service_user>`, taken from whichever slot happened to be writing. Both slots share a service user today, so it was idempotent — and that agreement was a coincidence of two values, not a fact. A future slot with a different service_user would have made each deploy re-chown the SHARED parent to its own user, so the two slots would fight over a directory neither of them owns in any meaningful sense.\\n\\nThe repair is to notice the ownership was never needed. The file is placed by `sudo install` running as root, so root does not need the directory to belong to the service user in order to write into it; the service user only ever READS the receipt, which mode 0755 on the directory and 0644 on the file already permit. Dropping the flags removes the contention by construction instead of leaving a note asking the next author to remember — which is the same shape as the existing shared-prefix coupling marker on /opt/gunbc, resolved rather than recorded.\\n\\nTHE FILE IS ROOT-OWNED TOO, AND AN EARLIER REVISION GAVE THE SERVICE PRINCIPAL WRITE ON IT (operator ruling 2026-08-05). It installed with `-o <service_user> -g <service_user>` at mode 0644 — and 0644 grants the OWNER write. The service user is `briansrls`, which is the principal the serve unit and the belt timer run as, while the deploy principal is `ghrunner`. So every long-lived process on that host could rewrite the single fact the next deployment treats as the active revision, and the rollback is direct: overwrite C's receipt with an older A, and a candidate B with A < B < C is admitted as an advance that moves the public service backward.\\n\\nThe write authority was never needed. `ghrunner` places the file through the granted `sudo install`, so the writer is root either way, and the service only ever READS the receipt — which 0644 grants to everyone. Dropping the flags removes the capability rather than documenting it. The dissolve-on has the served process publishing its own identity; a narrower process-writer capability belongs to that change, not to this one, and granting it early is exactly how an unneeded authority becomes load-bearing before anyone notices."

data slot_revision_record_grants_note: String = "THE WRITE STAYS INSIDE THE SIX NOPASSWD GRANTS (gunbc.fleet_posix_accounts fleet_posix_ci_runner_sudo_grants — apt-get, install, visudo, systemctl, tailscale, rm). The deploy principal is the unprivileged CI-runner account and /var/lib/gunbc is not writable by it, so the receipt is staged into a mktemp file the runner owns and then placed with the GRANTED install, which also creates the parent directory with ownership at creation rather than a chown fixup. That is the same construction emit_deploy_principal_note records for every other deploy-owned path: the wrongly-owned intermediate state is unwritable rather than corrected afterwards.\\n\\nThe staged file is removed on the success path only. A failed install leaves it behind under the runner's own temp directory, which is the correct trade: `rm -f` after a failure would run under `set -e` having already lost the exit status, and a stray temp file is a diagnosable residue while a swallowed failure is not."

fn live_deploy_slot_revision_record_script(spec: DeploymentSpec, revision: CommitSha) -> String {
  let path = deploy_slot_revision_receipt_path(slot: spec) as String
  let dir = deploy_slot_revision_receipt_dir as String
  join(
    [
      "set -euo pipefail\n",
      "# routed-slot revision receipt write (gunbc.live_deploy.revision deploy_slot_revision_receipt_path)\n",
      "_gunbc_receipt_stage=\"$(mktemp)\"\n",
      "printf '%s' ", sh_single_quote(s: revision as String), " > \"$_gunbc_receipt_stage\"\n",
      "sudo -n install -d -m 0755 ", sh_single_quote(s: dir), "\n",
      "sudo -n install -m 0644 \"$_gunbc_receipt_stage\" ", sh_single_quote(s: path), "\n",
      "rm -f \"$_gunbc_receipt_stage\"\n",
    ],
    ""
  )
}
