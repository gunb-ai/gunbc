module gunbc.live_deploy.readiness

import std.types { String, Bool, Int, NonEmptyStr, List }
import std.realization_reconcile {
  ShowEffectiveRead,
  ReadObserved,
  ReadAbsent,
  Grounding,
  Grounds,
  DoesNotGround,
  Reconciliation,
  Converged,
  NotConverged,
  reconcile_grounded,
  reconciliation_converged,
}
import gunbc.live_deploy.service_ready {
  ServiceNotReady,
  service_not_ready_reason,
  service_not_ready_with_captured_diagnosis,
  live_deploy_service_ready_poll_bound,
  live_deploy_service_ready_poll_cadence,
  live_deploy_service_ready_poll_max_attempts,
  live_deploy_service_ready_unit_authority,
  live_deploy_service_ready_endpoint_authority,
  UnitDiagnosis,
  UnitDiagnosisUnavailable,
  UnitDiagnosisCaptured,
}
import gunbc.live_deploy.intent {
  live_deploy_health_url_for_port,
  live_deploy_unit_diagnosis_command,
}
import gunbc.roadmap_site_healthz_validate { roadmap_site_healthz_json_string_parses }
import gunbc.live_deploy.spec {
  DeploymentSpec,
  deployment_spec_srv1,
  deployment_plan_listen_port,
}
import gunbc.ci_deploy_access {
  DeployAccess,
  ci_deploy_srv1_access,
}
import gunbc.host_effect {
  ShellCommand,
  HostOs,
  host_effect_read_evidence,
  HostEffectTransport,
  HostEffectIntent,
  HostEffectEvidence,
  ShellEffectApplied,
  ConvergePlanApplied,
  LocalShell,
  SshShell,
  EmitArtifactThenThinRun,
}
import gunbc.host_effect_realize { host_effect_apply_gated }
import gunbc.typed_argv_exec {
  typed_argv_exec_over_ssh,
  typed_argv_shell_safe_refusal_argv,
  TypedArgvExecConverged,
  TypedArgvExecRefused,
}
import extdeps.http.client
import extdeps.tools.sleep { sleep_delay_seconds_second_carrier_projection }

data http_client_get_path: String = "dag/extdeps/http/client.dag"
data http_client_get_service: String = "http.Client"
data http_client_get_operation: String = "Get"

type ServiceReadyEvidence {
  body: String
}

type ServiceReadyApplyEffect {
  unit: NonEmptyStr
  endpoint: NonEmptyStr
}

type HealthzEffectiveRead {
  body: String
  probe_error: String
}

fn service_ready_apply_effect() -> ServiceReadyApplyEffect {
  ServiceReadyApplyEffect {
    unit: live_deploy_service_ready_unit_authority,
    endpoint: live_deploy_service_ready_endpoint_authority,
  }
}

fn http_client_get_operation_argv(url: NonEmptyStr) -> List<String> {
  shell_materialize_argv_for_operation(
    http_client_get_path,
    http_client_get_service,
    http_client_get_operation,
    "url",
    url as String,
    [],
    ""
  )
}

fn healthz_effective_read_from_get(success: Bool, body: String, error: String) -> HealthzEffectiveRead {
  if success {
    HealthzEffectiveRead { body: body, probe_error: "" }
  } else {
    HealthzEffectiveRead { body: "", probe_error: error }
  }
}

fn live_deploy_healthz_get_local(port: Int) -> HealthzEffectiveRead {
  let url = live_deploy_health_url_for_port(port: port)
  let got = http.Client.Get(url: url)
  healthz_effective_read_from_get(
    success: got.success,
    body: got.body,
    error: "http client GET failed"
  )
}

fn live_deploy_healthz_get_ssh(port: Int, host: NonEmptyStr) -> HealthzEffectiveRead {
  let url = live_deploy_health_url_for_port(port: port)
  let argv = http_client_get_operation_argv(url: url)
  match typed_argv_shell_safe_refusal_argv(argv: argv) {
    Present { value: why } => HealthzEffectiveRead { body: "", probe_error: why }
    Absent =>
      match typed_argv_exec_over_ssh(host: host, argv: argv) {
        TypedArgvExecConverged { result: r } =>
          healthz_effective_read_from_get(
            success: r.success,
            body: r.stdout,
            error: "http client GET over ssh failed"
          )
        TypedArgvExecRefused { reason: why } =>
          HealthzEffectiveRead { body: "", probe_error: why }
      }
  }
}

fn live_deploy_healthz_get_for_port(port: Int, transport: HostEffectTransport) -> HealthzEffectiveRead {
  match transport {
    LocalShell => live_deploy_healthz_get_local(port: port)
    SshShell { ssh_host: h } => live_deploy_healthz_get_ssh(port: port, host: h)
    EmitArtifactThenThinRun { bootstrap: _, invocation: _ } =>
      HealthzEffectiveRead {
        body: "",
        probe_error: "health probe refused EmitArtifactThenThinRun transport",
      }
  }
}

fn healthz_body_groundable(body: String) -> Bool {
  roadmap_site_healthz_json_string_parses(body: body)
}

fn ground_service_ready_from_healthz(read: HealthzEffectiveRead) -> Grounding<ServiceReadyEvidence> {
  if read.probe_error != "" {
    DoesNotGround { reason: read.probe_error }
  } else {
    if healthz_body_groundable(body: read.body) {
      Grounds { evidence: ServiceReadyEvidence { body: read.body } }
    } else {
      DoesNotGround { reason: "healthz body failed JSON.parse" }
    }
  }
}

fn show_healthz_read_for_deploy(
  spec: DeploymentSpec,
  transport: HostEffectTransport,
  access: DeployAccess,
) -> ShowEffectiveRead<HealthzEffectiveRead> {
  let _ = access
  ReadObserved {
    value: live_deploy_healthz_get_for_port(
      port: deployment_plan_listen_port(spec: spec),
      transport: transport,
    )
  }
}

fn show_healthz_read_fixture_healthy() -> ShowEffectiveRead<HealthzEffectiveRead> {
  ReadObserved {
    value: HealthzEffectiveRead {
      body: "{\"status\":\"ok\"}",
      probe_error: "",
    }
  }
}

fn reconcile_service_ready_read(
  read: ShowEffectiveRead<HealthzEffectiveRead>
) -> Reconciliation<ServiceReadyApplyEffect, ServiceReadyEvidence> {
  match read {
    ReadAbsent { reason: why } =>
      reconcile_grounded(
        apply_effect: service_ready_apply_effect(),
        show_read: read,
        grounding: DoesNotGround { reason: why }
      )
    ReadObserved { value: observed } =>
      reconcile_grounded(
        apply_effect: service_ready_apply_effect(),
        show_read: read,
        grounding: ground_service_ready_from_healthz(read: observed)
      )
  }
}

fn live_deploy_service_ready_once_for_deploy(
  spec: DeploymentSpec,
  transport: HostEffectTransport,
  access: DeployAccess,
) -> Reconciliation<ServiceReadyApplyEffect, ServiceReadyEvidence> {
  reconcile_service_ready_read(
    read: show_healthz_read_for_deploy(
      spec: spec,
      transport: transport,
      access: access,
    )
  )
}

fn live_deploy_service_ready_once() -> Reconciliation<ServiceReadyApplyEffect, ServiceReadyEvidence> {
  reconcile_service_ready_read(read: show_healthz_read_fixture_healthy())
}

fn unit_diagnosis_from_shell_apply(
  r: Reconciliation<HostEffectIntent, HostEffectEvidence>
) -> String {
  match r {
    Converged { evidence: e, applied: _ } =>
      match e {
        ShellEffectApplied { stdout: out, exit_code: _ } => out
        ConvergePlanApplied { stdout: _, exit_code: _ } =>
          "unit diagnosis capture returned ConvergePlanApplied; typed mismatch"
      }
    NotConverged { reason: why, applied: _ } =>
      concat("unit diagnosis capture failed: ", why)
  }
}

fn capture_unit_diagnosis(
  spec: DeploymentSpec,
  transport: HostEffectTransport,
  access: DeployAccess,
) -> String {
  unit_diagnosis_from_shell_apply(
    r: host_effect_apply_gated(
      access: access,
      target: HostOs { node: spec.target.host },
      effect: ShellCommand {
        script: live_deploy_unit_diagnosis_command(
          unit: live_deploy_service_ready_unit_authority
        ),
      },
      evidence: host_effect_read_evidence,
      transport: transport,
      fixture_actor: Absent,
    )
  )
}

type ServiceReadyPollOutcome =
    PollSettled { result: Reconciliation<ServiceReadyApplyEffect, ServiceReadyEvidence> }
  | PollRefusedAtBound { refusal: ServiceNotReady }

fn poll_bound_refusal(last_probe: String) -> ServiceNotReady {
  ServiceNotReady {
    unit: live_deploy_service_ready_unit_authority,
    endpoint: live_deploy_service_ready_endpoint_authority,
    waited: live_deploy_service_ready_poll_bound,
    last_probe: last_probe,
    unit_diagnosis: UnitDiagnosisUnavailable,
  }
}

fn refusal_to_reconciliation(refusal: ServiceNotReady) -> Reconciliation<ServiceReadyApplyEffect, ServiceReadyEvidence> {
  NotConverged {
    reason: service_not_ready_reason(refusal: refusal),
    applied: service_ready_apply_effect(),
  }
}

fn live_deploy_poll_service_ready_outcome_after_attempts(
  spec: DeploymentSpec,
  transport: HostEffectTransport,
  access: DeployAccess,
  attempt: Int,
  last_probe: String,
) -> ServiceReadyPollOutcome {
  let max_attempts = live_deploy_service_ready_poll_max_attempts()
  if attempt >= max_attempts {
    PollRefusedAtBound { refusal: poll_bound_refusal(last_probe: last_probe) }
  } else {
    let probe = live_deploy_service_ready_once_for_deploy(
      spec: spec,
      transport: transport,
      access: access,
    )
    if reconciliation_converged(r: probe) {
      PollSettled { result: probe }
    } else {
      let delay = sleep_delay_seconds_second_carrier_projection(duration: live_deploy_service_ready_poll_cadence)
      if delay {
        live_deploy_poll_service_ready_outcome_after_attempts(
          spec: spec,
          transport: transport,
          access: access,
          attempt: attempt + 1,
          last_probe: last_probe_from_attempt(attempt: probe)
        )
      } else {
        PollRefusedAtBound {
          refusal: poll_bound_refusal(last_probe: "sleep between health probes failed")
        }
      }
    }
  }
}

fn live_deploy_poll_service_ready_after_attempts(
  spec: DeploymentSpec,
  transport: HostEffectTransport,
  access: DeployAccess,
  attempt: Int,
  last_probe: String,
) -> Reconciliation<ServiceReadyApplyEffect, ServiceReadyEvidence> {
  match live_deploy_poll_service_ready_outcome_after_attempts(
    spec: spec,
    transport: transport,
    access: access,
    attempt: attempt,
    last_probe: last_probe,
  ) {
    PollSettled { result: r } => r
    PollRefusedAtBound { refusal: refusal } => refusal_to_reconciliation(refusal: refusal)
  }
}

fn last_probe_from_attempt(
  attempt: Reconciliation<ServiceReadyApplyEffect, ServiceReadyEvidence>
) -> String {
  match attempt {
    NotConverged { reason: why, applied: _ } => why
    Converged { evidence: _, applied: _ } => "converged"
  }
}

fn live_deploy_poll_until_service_ready_for_deploy(
  spec: DeploymentSpec,
  transport: HostEffectTransport,
  access: DeployAccess,
) -> Reconciliation<ServiceReadyApplyEffect, ServiceReadyEvidence> {
  match live_deploy_poll_service_ready_outcome_after_attempts(
    spec: spec,
    transport: transport,
    access: access,
    attempt: 0,
    last_probe: "no probe yet",
  ) {
    PollSettled { result: r } => r
    PollRefusedAtBound { refusal: refusal } =>
      refusal_to_reconciliation(
        refusal: service_not_ready_with_captured_diagnosis(
          refusal: refusal,
          text: capture_unit_diagnosis(
            spec: spec,
            transport: transport,
            access: access,
          )
        )
      )
  }
}

fn live_deploy_poll_until_service_ready() -> Reconciliation<ServiceReadyApplyEffect, ServiceReadyEvidence> {
  live_deploy_poll_until_service_ready_for_deploy(
    spec: deployment_spec_srv1(),
    transport: ci_deploy_srv1_access.transport,
    access: ci_deploy_srv1_access,
  )
}
