type ServiceReadyEvidence {
  body: String
}

type HealthzRefusalCause
  = HealthzBodyUnparseable { body: String }
  | ProcessIdentityAbsent { body: String }
  | ProcessIdentityMalformed { detail: String, body: String }
  | ProcessRevisionMismatch { expected: String, observed: String }
  | ProcessSurfaceMismatch { expected: String, observed: String }
  | ServedSurfaceStale { observed: String, expected: String }

type ServiceReadinessPending
  = ServiceProbeUnanswered { detail: String }
  | ServiceReadinessIdentityPending { cause: HealthzRefusalCause }

type ServiceReadinessRefusal
  = ServiceReadinessAccessDenied { reason: String }
  | ServiceReadinessPollBound { refusal: ServiceNotReady }

type ServiceReadiness
  = Readiness<ServiceReadyEvidence, ServiceReadinessPending, ServiceReadinessRefusal>

fn service_readiness_reason(r: ServiceReadiness) -> String {
  match r {
    Ready { evidence: e } => e.body
    Pending { cause: ServiceProbeUnanswered { detail } } => detail
    Pending { cause: ServiceReadinessIdentityPending { cause } } =>
      healthz_refusal_reason(cause: cause)
    Refused { cause: ServiceReadinessAccessDenied { reason } } => reason
    Refused { cause: ServiceReadinessPollBound { refusal } } =>
      service_not_ready_reason(refusal: refusal)
  }
}

fn observe_service_readiness_from_healthz(
  read: HealthzEffectiveRead,
  bundle: RoadmapSiteSurfaceBundle,
  expected_revision: CommitSha,
  expected_surface_identity: Fnv1a64Structural,
) -> ServiceReadiness {
  match read {
    HealthzProbeRefused { probe_error: detail } =>
      Pending { cause: ServiceProbeUnanswered { detail: detail } }
    HealthzBodyRead { body: observed_body } =>
      match healthz_body_verdict(
        body: observed_body,
        bundle: bundle,
        expected_revision: expected_revision,
        expected_surface_identity: expected_surface_identity,
      ) {
        HealthzBodyGrounds { evidence: e } => Ready { evidence: e }
        HealthzBodyDoesNotGround { cause } =>
          Pending { cause: ServiceReadinessIdentityPending { cause: cause } }
      }
  }
}

fn healthz_effective_read_from_get(success: Bool, body: String, error: String) -> HealthzEffectiveRead {
  if success {
    HealthzBodyRead { body: body }
  } else {
    HealthzProbeRefused { probe_error: error }
  }
}

// THE PROBE DEADLINE IS DERIVED FROM THE UNIT'S OWN WALL LIMIT, NOT FROM THE CURL TOOL DEFAULT.
// The roadmap server is one interpreter serving one request at a time, and its unit declares that
// a request may take up to serve_wall_limit (dashboard_serve_wall_limit, 120 s). A /healthz that
// arrives behind such a request is answered only after it, so a probe bounded at the tool's 5 s
// (extdeps.tools.curl curl_localhost_max_time) refused three deploys on 2026-09-17/18 whose server
// answered /healthz in 0.1 s the moment it was idle -- two authorities on how long a request may
// take, disagreeing by 24x (DESIGN 3). The bound is twice the wall limit: the request in service
// plus the probe's own, each within what the unit promises. A unit with no wall limit cannot
// ground a deadline, and the probe refuses rather than guessing one.
fn live_deploy_healthz_probe_deadline(spec: DeploymentSpec) -> Second? {
  match spec.service.serve_wall_limit {
    LimitUnset => none
    LimitSet { limit: l } => Present { value: second(count: (2 * positive_millisecond_count(m: l) + 999) / 1000) }
  }
}

data healthz_probe_deadline_ungrounded: String = "the serve unit declares no wall limit, so no probe deadline can be derived from it"

fn live_deploy_healthz_get_local(port: Int, spec: DeploymentSpec) -> HealthzEffectiveRead {
  let url = live_deploy_health_url_for_port(port: port)
  match live_deploy_healthz_probe_deadline(spec: spec) {
    Absent => HealthzProbeRefused { probe_error: healthz_probe_deadline_ungrounded }
    Present { value: deadline } => {
      let got = http.Client.GetWithin(url: url, max_seconds: http_client_max_time_flag(max_time: deadline))
      healthz_effective_read_from_get(
        success: got.success,
        body: got.body,
        error: join(["http client GET failed within the ", http_client_max_time_flag(max_time: deadline) as String, " s probe deadline derived from the serve wall limit"], "")
      )
    }
  }
}

fn healthz_effective_read_from_outcome(outcome: TypedArgvExecOutcome) -> HealthzEffectiveRead {
  match outcome {
    TypedArgvExecConverged { result: r } =>
      healthz_effective_read_from_get(
        success: r.success,
        body: r.stdout,
        error: "http client GET over ssh failed"
      )
    TypedArgvExecRefused { reason: why } => HealthzProbeRefused { probe_error: why }
  }
}

fn live_deploy_healthz_get_fleet_ssh(
  port: Int,
  spec: DeploymentSpec,
  target: SshTarget,
  context: FleetSshExecutionContext,
) -> HealthzEffectiveRead {
  match live_deploy_healthz_probe_deadline(spec: spec) {
    Absent => HealthzProbeRefused { probe_error: healthz_probe_deadline_ungrounded }
    Present { value: deadline } =>
      healthz_effective_read_from_outcome(
        outcome: typed_argv_exec_over_fleet_ssh(
          target: target,
          context: context,
          argv: http_client_get_argv_within(url: live_deploy_health_url_for_port(port: port), max_time: deadline),
        ),
      )
  }
}

fn live_deploy_healthz_get_ssh(port: Int, spec: DeploymentSpec, host: NonEmptyStr) -> HealthzEffectiveRead {
  let url = live_deploy_health_url_for_port(port: port)
  match live_deploy_healthz_probe_deadline(spec: spec) {
    Absent => HealthzProbeRefused { probe_error: healthz_probe_deadline_ungrounded }
    Present { value: deadline } => live_deploy_healthz_get_ssh_within(url: url, host: host, deadline: deadline)
  }
}

fn live_deploy_healthz_get_ssh_within(url: NonEmptyStr, host: NonEmptyStr, deadline: Second) -> HealthzEffectiveRead {
  let argv = http_client_get_argv_within(url: url, max_time: deadline)
  match typed_argv_shell_safe_refusal_argv(argv: argv) {
    Present { value: why } => HealthzProbeRefused { probe_error: why }
    Absent =>
      match typed_argv_exec_over_ssh(host: host, argv: argv) {
        TypedArgvExecConverged { result: r } =>
          healthz_effective_read_from_get(
            success: r.success,
            body: r.stdout,
            error: "http client GET over ssh failed"
          )
        TypedArgvExecRefused { reason: why } =>
          HealthzProbeRefused { probe_error: why }
      }
  }
}

fn live_deploy_healthz_get_for_port(port: Int, spec: DeploymentSpec, transport: HostEffectTransport) -> HealthzEffectiveRead {
  match transport {
    LocalShell => live_deploy_healthz_get_local(port: port, spec: spec)
    SshShell { ssh_host: h } => live_deploy_healthz_get_ssh(port: port, spec: spec, host: h)
    FleetSsh { target: t, context: c } => live_deploy_healthz_get_fleet_ssh(port: port, spec: spec, target: t, context: c)
    EmitArtifactThenThinRun { bootstrap: _, invocation: _ } =>
      HealthzProbeRefused {
        probe_error: "health probe refused EmitArtifactThenThinRun transport",
      }
  }
}

fn healthz_body_groundable(body: String) -> Bool {
  roadmap_site_healthz_json_string_parses(body: body)
}

// READY was under-specified and the gap was live: it meant 'something answered /healthz', which the
// PRE-RESTART process satisfies. `gunbc serve` binds its compiled graph ONCE at process start, so
// between `systemctl restart` and the new process finishing its ~35 s load the OLD process is still
// answering — a poll that grounds on any answer can therefore green against the very process the
// deploy is replacing, and the deploy reports success while the dashboard still serves the previous
// tree. That is not a hypothetical: on 2026-07-24 the live srv1 page was serving the escaped
// `.node-superseded &gt; .title` selector, the pre-fix `width` chip, no disclosure and no
// centering, and every check in the system was green. So readiness now means the STRONGER and
// actually intended thing — the unit is answering AND the surface it answers with is this tree's —
// which the healthz digest map makes a plain equality (roadmap_site_healthz_surface_is_current).
// The three refusal causes stay type-distinct because their remedies differ: the probe never landed
// (network/unit down), the body is not JSON (wrong process on the port), the body is a well-formed
// fingerprint of ANOTHER tree (graph not rebound / sync incomplete). Each is a typed, located,
// countable refusal that the poll retries within its bound and that REFUSES at the bound — never a
// widen, and never a mode that proceeds as if it had not fired. Known and accepted race, named
// rather than hidden: two main pushes deploying concurrently can have deploy N observe deploy N+1's
// surface, which refuses honestly ('the surface is not the one I deployed' is true) and self-heals
// on the next deploy.

// READINESS NOW ASKS BOTH QUESTIONS THE PROCESS ANSWERS, AND KEEPS THEM APART. The surface half
// ('is this tree's surface what the unit serves') was already here and is unchanged in meaning. The
// revision half is new and is the one the receipt could not supply: the running process reports
// which release it was LAUNCHED as, so 'the unit answering on this port is the candidate I just
// installed' becomes a comparison against an immutable fact of that process rather than an
// inference from a file, a directory, or the fact that something answered.\n\nWHY THE SURFACE CHECK
// DOES NOT ALREADY COVER IT. Two deploys of the SAME tree at different commits render
// byte-identical surfaces — a commit touching only Rust, only tests, or only documents changes the
// revision and not one served artifact — so a surface-only readiness greens against the previous
// process on every such deploy. That is not an exotic case; it is most of them. Conversely a
// process can serve a fresh surface at an unexpected revision when another candidate won the route.
// Neither half implies the other, which is exactly why the wire carries two members.\n\nTHE
// EXPECTED REVISION IS NOT RE-OBSERVED HERE. It is candidate.revision — the same single value the
// launcher observed once and the emitter wrote into ExecStart — so 'the checkout's sha, the emitted
// launch sha, and the process-reported sha are equal' is a claim about ONE subject read back, not
// three readings that happen to agree. A readiness that observed its own expectation could only
// ever prove the host agrees with whatever the host currently says.\n\nProcessIdentityAbsent and
// ProcessIdentityMalformed stay distinct from ProcessRevisionMismatch because a process that cannot
// state its release has not disagreed with anything — it is the pre-identity process, or a wrong
// process on the port, and the remedy is to look at what is listening rather than at which commit
// won.

// THESE ARMS ARE PEERS, NOT KINDS OF ONE ANOTHER, WHICH IS WHY THE GROUPING WAS REMOVED HERE AND
// KEPT ONE LAYER DOWN. Identity refusals used to collapse into a single ReleaseIdentityUnreadable
// carrying a rendered sentence, so 'the process states no release' and 'the process states a
// malformed one' arrived as the same verdict distinguished only by prose — and a mismatch, which is
// not an identity failure at all, sat beside them as if it were a sibling of the same kind.\n\nThe
// distinctions are operational. ProcessIdentityAbsent is the MIGRATION arm: a process launched
// before this channel existed. It is a refusal, never a synthetic predecessor, but its remedy is
// 'restart it under a unit that passes --release-revision'. ProcessIdentityMalformed means the
// channel exists and the process is answering wrongly, which is a defect rather than an old
// process. ProcessRevisionMismatch means identity was read cleanly and disagrees.
// ProcessSurfaceMismatch means the reported surface digest is not the one the candidate expected.
// ServedSurfaceStale means the projected artifact map differs. Four different remedies, four
// arms. ServiceReadinessIdentityPending carries HealthzRefusalCause, not a rendered sentence.
//
// THE OBSERVATION CARRIER STAYS GROUPED, DELIBERATELY. gunbc.running_release_identity
// keeps RunningReleaseIdentified | RunningReleaseUnidentified{cause} because a real consumer
// branches on identified-versus-not WITHOUT enumerating causes — this fold's own match. A grouping
// that some consumer reads is a level; a grouping nobody reads is a nickname. These two carriers
// are two layers of one model, not two names for one thing, and collapsing either into the other
// would lose a distinction something depends on.

fn running_release_unidentified_detail(cause: RunningReleaseUnidentifiedCause) -> String {
  match cause {
    ReleaseIdentityBodyUnparseable => "the healthz body did not parse as JSON"
    ReleaseRevisionAbsent =>
      "the unit answered without a release identity: it is a process launched before the identity channel existed, so which release it serves is not readable and no advance from it is ordered"
    ReleaseRevisionDuplicated { count: n } =>
      join(["the healthz body carried ", to_string(n), " revision members, so no single release identity is stated"], "")
    HealthzBodyNotAnObject => "the healthz body is not a JSON object"
    ReleaseRevisionNotAString => "the healthz revision member is not a string"
    ReleaseRevisionMalformed { text: t } =>
      join(["the healthz revision member is '", t, "', which is not a 40-digit lowercase object name"], "")
    SurfaceBundleIdentityAbsent => "the healthz body states a revision but no surface bundle identity"
    SurfaceBundleIdentityDuplicated { count: m } =>
      join(["the healthz body carried ", to_string(m), " surface bundle identity members"], "")
    SurfaceBundleIdentityNotAString => "the healthz surface bundle identity member is not a string"
    SurfaceBundleIdentityMalformed { text: t } =>
      join(["the healthz surface bundle identity member is '", t, "', which is not a 16-digit lowercase fnv1a64 structural digest"], "")
  }
}

fn healthz_release_identity_refusal(body: String, cause: RunningReleaseUnidentifiedCause) -> HealthzRefusalCause {
  let detail = running_release_unidentified_detail(cause: cause)
  match cause {
    ReleaseRevisionAbsent => ProcessIdentityAbsent { body: body }
    _ => ProcessIdentityMalformed { detail: detail, body: body }
  }
}

fn healthz_refusal_reason(cause: HealthzRefusalCause) -> String {
  match cause {
    ProcessIdentityAbsent { body: b } =>
      join([
        "ProcessIdentityAbsent: the unit answered /healthz but stated no release identity, so it is a",
        " process launched before the identity channel existed. Which release it serves is not readable,",
        " and no advance from it is ordered. body=", b,
      ], "")
    ProcessIdentityMalformed { detail: d, body: b } =>
      join(["ProcessIdentityMalformed: ", d, "; body=", b], "")
    ProcessSurfaceMismatch { expected: e, observed: o } =>
      join([
        "ProcessSurfaceMismatch: the unit reported a surface bundle identity other than the one this",
        " deploy's candidate expects — the process is rendering a different source tree than the",
        " checkout that was admitted. expected=", e, " observed=", o,
      ], "")
    ProcessRevisionMismatch { expected: e, observed: o } =>
      join([
        "ProcessRevisionMismatch: the unit answered /healthz as a different release than the one this",
        " deploy installed — gunbc serve binds its release identity once at process start, so this is the",
        " pre-restart process still answering, or another candidate won this port. expected=", e,
        " observed=", o,
      ], "")
    HealthzBodyUnparseable { body: b } =>
      join(["healthz body failed JSON.parse; body=", b], "")
    ServedSurfaceStale { observed: o, expected: e } =>
      join([
        "ServedSurfaceStale: the unit answered /healthz but its served surface is not this tree's",
        " — gunbc serve binds its graph once at process start, so the pre-restart process is still",
        " answering (or the source sync did not land). observed=", o, " expected=", e,
      ], "")
  }
}

// THE EXPECTATION IS THE ADMITTED CANDIDATE, NOT A FRESH OBSERVATION, AND THAT IS THE ENTIRE VALUE
// OF PASSING IT DOWN. Both halves compare against values the launcher captured ONCE before any
// mutation: candidate.revision and candidate.expected_surface_identity. Readiness therefore reads
// back the subject the deploy admitted, rather than re-deriving an expectation at comparison time.
//
// Re-materializing the bundle here would reopen exactly the time-of-check/time-of-use hole the
// candidate exists to close: if the deploying checkout changed after admission, a recomputed
// expectation would describe the CHANGED tree, and readiness could then agree with a process other
// than the one admitted — a self-consistent false green that no downstream check can see, because
// the expectation and the verdict would have drifted together.
//
// THE TWO SURFACE CHECKS ARE NOT REDUNDANT. ProcessSurfaceMismatch compares the process's REPORTED
// bundle identity against the candidate's captured one — a claim about which tree the process
// bound. ServedSurfaceStale compares the projected artifact map — a claim about what it is actually
// serving. A process could report the expected identity while serving stale artifacts (a rendering
// defect), or serve correct artifacts under an unexpected identity (a different tree that happens
// to render the same). Each has its own discriminating control, because a single check covering
// both would green whenever either happened to agree.

// healthz_body_verdict only ever sees a body, because only HealthzBodyRead can reach it -- which
// is the climb: the probe stage cannot be forgotten, mis-ordered, or reached past, because a
// refusal has no body to hand it.
type HealthzBodyVerdict
  = HealthzBodyGrounds { evidence: ServiceReadyEvidence }
  | HealthzBodyDoesNotGround { cause: HealthzRefusalCause }

fn healthz_body_verdict(
  body: String,
  bundle: RoadmapSiteSurfaceBundle,
  expected_revision: CommitSha,
  expected_surface_identity: Fnv1a64Structural,
) -> HealthzBodyVerdict {
  if !healthz_body_groundable(body: body) {
    HealthzBodyDoesNotGround { cause: HealthzBodyUnparseable { body: body } }
  } else {
    match observe_running_release_identity(healthz_body: body) {
      RunningReleaseUnidentified { cause: why } =>
        HealthzBodyDoesNotGround {
          cause: healthz_release_identity_refusal(body: body, cause: why),
        }
      RunningReleaseIdentified { observation: obs } =>
        if (obs.revision as String) != (expected_revision as String) {
          HealthzBodyDoesNotGround {
            cause: ProcessRevisionMismatch {
              expected: expected_revision as String,
              observed: obs.revision as String,
            },
          }
        } else if (obs.surface_bundle_identity.digest as String) != (expected_surface_identity.digest as String) {
          HealthzBodyDoesNotGround {
            cause: ProcessSurfaceMismatch {
              expected: expected_surface_identity.digest as String,
              observed: obs.surface_bundle_identity.digest as String,
            },
          }
        } else if !roadmap_site_healthz_surface_is_current(bundle: bundle, observed_body: body) {
          HealthzBodyDoesNotGround {
            cause: ServedSurfaceStale {
              observed: body,
              expected: bundle.healthz_body,
            },
          }
        } else {
          HealthzBodyGrounds { evidence: ServiceReadyEvidence { body: body } }
        }
    }
  }
}

// THE ORDER IS PARSE, IDENTITY, REVISION, SURFACE, AND IT IS CHOSEN SO THE FIRST REFUSAL IS THE
// MOST LOCATING ONE. A process at the wrong revision usually also serves the wrong surface, so
// checking the surface first would report 'stale surface' for what is really 'the pre-restart
// process is still answering' — true but one inference away from the remedy. Checking the revision
// first names the process; checking the surface after names the rebind. Identity precedes both
// because a body with no readable identity cannot be compared on either axis, and reporting a
// surface verdict about a process we cannot identify would attribute the surface to the wrong
// party.
//
// THIS ROW USED TO NAME FIVE STAGES AND NOW NAMES FOUR, and the missing one is the point: PROBE is
// no longer ordered by this note because it is no longer ordered by anything. HealthzEffectiveRead
// became a coproduct (gunbc.roadmap_site_surface_types), so a refused probe carries no body at all
// and the parse stage is unreachable from it — not checked-first, but unreachable. The four above
// remain ordering-by-discipline inside healthz_body_verdict: they are stages over
// ONE String, and nothing structural stops a future edit from reordering them, so this note is
// still doing real work for them. It is stated this way rather than deleted wholesale because a
// note that shrank silently would read as though the whole ordering had been made structural, which
// is the rung inflation DESIGN §4b calls worse than sitting low.

fn show_healthz_read_fixture_healthy(
  bundle: RoadmapSiteSurfaceBundle,
  release_revision: CommitSha,
) -> ShowEffectiveRead<HealthzEffectiveRead> {
  ReadObserved {
    value: HealthzBodyRead {
      body: healthz_body_with_release_identity(
        roadmap: bundle.roadmap_md,
        dispatch: bundle.dispatch_json,
        daily: bundle.daily_html,
        full: bundle.full_html,
        dispatch_js: bundle.dispatch_js,
        release_revision: release_revision,
        surface_bundle_identity: bundle.bundle_identity,
      ),
    }
  }
}

// THE HEALTHY FIXTURE MOVED FROM bundle.healthz_body TO THE FULL SERVED DOCUMENT, AND IT HAD TO.
// bundle.healthz_body is the SURFACE projection — what the deploying tree expects the surface to be
// — and a running process never serves it, because a running process also states its release
// identity. Once readiness checks that identity, a fixture spelling the surface alone is no longer
// a healthy read: it is the pre-identity process, and the converges-on-healthy witnesses would have
// been asserting the refusal they exist to exclude.
//
// The fixture is rendered by
// healthz_body_with_release_identity — the SAME producer the live route uses — so the healthy case
// is a document the process could actually emit rather than a hand-assembled approximation of one.
// That is the same discipline the original fixture note recorded when it refused a hand-spelled
// {\"status\":\"ok\"}, applied one layer up.

fn live_deploy_service_ready_once_for_deploy(
  spec: DeploymentSpec,
  candidate: CandidateRelease,
  transport: HostEffectTransport,
  access: DeployAccess,
) -> ServiceReadiness {
  let verdict = host_effect_privilege_verdict(access: access, fixture_actor: Absent)
  match verdict {
    Deny { refusal: _ } =>
      Refused {
        cause: ServiceReadinessAccessDenied {
          reason: deploy_access_decision_reason(d: verdict),
        },
      }
    Permit =>
      observe_service_readiness_from_healthz(
        read: live_deploy_healthz_get_for_port(
          port: deployment_plan_listen_port(spec: spec),
          spec: spec,
          transport: transport,
        ),
        bundle: materialize_live_roadmap_site_surface_bundle(),
        expected_revision: candidate.revision,
        expected_surface_identity: candidate.expected_surface_identity,
      )
  }
}

fn live_deploy_service_ready_once_for_bundle(
  bundle: RoadmapSiteSurfaceBundle,
  release_revision: CommitSha,
) -> ServiceReadiness {
  match show_healthz_read_fixture_healthy(bundle: bundle, release_revision: release_revision) {
    ReadAbsent { reason: why } =>
      Pending { cause: ServiceProbeUnanswered { detail: why } }
    ReadObserved { value: observed } =>
      observe_service_readiness_from_healthz(
        read: observed,
        bundle: bundle,
        expected_revision: release_revision,
        expected_surface_identity: bundle.bundle_identity,
      )
  }
}

fn capture_unit_diagnosis(
  spec: DeploymentSpec,
  transport: HostEffectTransport,
  access: DeployAccess,
) -> String {
  let verdict = host_effect_privilege_verdict(access: access, fixture_actor: Absent)
  match verdict {
    Deny { refusal: _ } =>
      concat("unit diagnosis capture failed: ", deploy_access_decision_reason(d: verdict))
    Permit =>
      unit_status_capture_text(
        capture: systemctl_status_read(
          transport: transport,
          unit: spec.service.unit_name,
        )
      )
  }
}

// Retry cadence and the terminal bound are transaction policy. They live next to
// the one-attempt observer until the apply path owns the loop; the observer
// itself (live_deploy_service_ready_once_*) never sleeps. Pending retries;
// Refused does not.
// UNPROVEN: the poll's Ready arm exits without a further attempt. The deleted
// witness_bounded_poll_early_exit_on_grounded_read called
// live_deploy_service_ready_once, not this loop, so it never discriminated that
// arm. TRIGGER: a fixture that can supply a Ready ServiceReadiness into
// live_deploy_poll_service_ready_outcome_after_attempts without materializing
// the live site (injected one-attempt observation). Until then the once-Ready
// property is held by
// test.claim.roadmap_site_surface_readiness
// witness_roadmap_site_surface_readiness_materialized_batch_holds via
// service_ready_once_converges_on_healthy_fixture_for_bundle.

type ServiceReadyPollOutcome =
    PollSettled { result: ServiceReadiness }
  | PollRefusedAtBound { refusal: ServiceNotReady }

fn poll_bound_refusal(spec: DeploymentSpec, last_probe: String) -> ServiceNotReady {
  ServiceNotReady {
    unit: spec.service.unit_name,
    endpoint: live_deploy_service_ready_endpoint_authority,
    waited: live_deploy_service_ready_poll_bound,
    last_probe: last_probe,
    unit_diagnosis: UnitDiagnosisUnavailable,
  }
}

fn poll_bound_readiness(refusal: ServiceNotReady) -> ServiceReadiness {
  Refused { cause: ServiceReadinessPollBound { refusal: refusal } }
}

fn live_deploy_poll_service_ready_outcome_after_attempts(
  spec: DeploymentSpec,
  candidate: CandidateRelease,
  transport: HostEffectTransport,
  access: DeployAccess,
  attempt: Int,
  last_probe: String,
) -> ServiceReadyPollOutcome {
  let max_attempts = live_deploy_service_ready_poll_max_attempts()
  if attempt >= max_attempts {
    PollRefusedAtBound { refusal: poll_bound_refusal(spec: spec, last_probe: last_probe) }
  } else {
    let probe = live_deploy_service_ready_once_for_deploy(
      spec: spec,
      candidate: candidate,
      transport: transport,
      access: access,
    )
    match probe {
      Ready { evidence: _ } => PollSettled { result: probe }
      Refused { cause: _ } => PollSettled { result: probe }
      Pending { cause: _ } => {
        let delay = sleep_delay_seconds_second_carrier_projection(duration: live_deploy_service_ready_poll_cadence)
        if delay {
          live_deploy_poll_service_ready_outcome_after_attempts(
            spec: spec,
            candidate: candidate,
            transport: transport,
            access: access,
            attempt: attempt + 1,
            last_probe: last_probe_from_attempt(attempt: probe)
          )
        } else {
          PollRefusedAtBound {
            refusal: poll_bound_refusal(spec: spec, last_probe: "sleep between health probes failed")
          }
        }
      }
    }
  }
}

fn live_deploy_poll_service_ready_after_attempts(
  spec: DeploymentSpec,
  candidate: CandidateRelease,
  transport: HostEffectTransport,
  access: DeployAccess,
  attempt: Int,
  last_probe: String,
) -> ServiceReadiness {
  match live_deploy_poll_service_ready_outcome_after_attempts(
    spec: spec,
    candidate: candidate,
    transport: transport,
    access: access,
    attempt: attempt,
    last_probe: last_probe,
  ) {
    PollSettled { result: r } => r
    PollRefusedAtBound { refusal: refusal } => poll_bound_readiness(refusal: refusal)
  }
}

fn last_probe_from_attempt(
  attempt: ServiceReadiness
) -> String {
  service_readiness_reason(r: attempt)
}

fn live_deploy_poll_until_service_ready_for_deploy(
  spec: DeploymentSpec,
  candidate: CandidateRelease,
  transport: HostEffectTransport,
  access: DeployAccess,
) -> ServiceReadiness {
  match live_deploy_poll_service_ready_outcome_after_attempts(
    spec: spec,
    candidate: candidate,
    transport: transport,
    access: access,
    attempt: 0,
    last_probe: "no probe yet",
  ) {
    PollSettled { result: r } => r
    PollRefusedAtBound { refusal: refusal } =>
      poll_bound_readiness(
        refusal: service_not_ready_with_captured_diagnosis(
          refusal: refusal,
          text: capture_unit_diagnosis(
            spec: spec,
            transport: transport,
            access: access,
          )
        )
      )
  }
}

fn live_deploy_poll_until_service_ready(
  candidate: CandidateRelease,
) -> ServiceReadiness {
  live_deploy_poll_until_service_ready_for_deploy(
    spec: deployment_spec_srv1(),
    candidate: candidate,
    transport: ci_deploy_srv1_access.transport,
    access: ci_deploy_srv1_access,
  )
}
