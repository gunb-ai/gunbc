module gunbc.live_deploy.readiness

import std.types { String, Bool, Int, NonEmptyStr }
import std.measure { Second, second_count }
import std.realization_reconcile {
  ShowEffectiveRead,
  ReadObserved,
  ReadAbsent,
  Grounding,
  Grounds,
  DoesNotGround,
  Reconciliation,
  Converged,
  NotConverged,
  reconcile_grounded,
  reconciliation_converged,
}
import gunbc.live_deploy.service_ready {
  ServiceNotReady,
  service_not_ready_reason,
  live_deploy_service_ready_poll_bound,
  live_deploy_service_ready_unit_authority,
  live_deploy_service_ready_endpoint_authority,
}
import gunbc.live_deploy.intent {
  live_deploy_health_probe_curl_command,
  live_deploy_health_url_for_port,
}
import gunbc.live_deploy.spec {
  DeploymentSpec,
  deployment_spec_srv1,
  deployment_plan_listen_port,
}
import gunbc.ci_deploy_access {
  DeployAccess,
  ci_deploy_srv1_access,
}
import gunbc.host_effect {
  ShellCommand,
  HostOs,
  host_effect_read_evidence,
  HostEffectTransport,
  HostEffectIntent,
  HostEffectEvidence,
  ShellEffectApplied,
  ConvergePlanApplied,
}
import gunbc.host_effect_realize { host_effect_apply_gated }
import extdeps.tools.sleep

type ServiceReadyEvidence {
  body: String
}

type ServiceReadyApplyEffect {
  unit: NonEmptyStr
  endpoint: NonEmptyStr
}

type HealthzEffectiveRead {
  body: String
  probe_error: String
}

fn service_ready_apply_effect() -> ServiceReadyApplyEffect {
  ServiceReadyApplyEffect {
    unit: live_deploy_service_ready_unit_authority,
    endpoint: live_deploy_service_ready_endpoint_authority,
  }
}

fn live_deploy_healthz_probe_script_for_port(port: Int) -> String {
  live_deploy_health_probe_curl_command(
    health_url: live_deploy_health_url_for_port(port: port)
  )
}

fn healthz_body_groundable(body: String) -> Bool {
  starts_with(s: body, prefix: "{")
    && ends_with(s: body, suffix: "}")
    && string_contains(s: body, pattern: "\"status\"")
}

fn ground_service_ready_from_healthz(read: HealthzEffectiveRead) -> Grounding<ServiceReadyEvidence> {
  if read.probe_error != "" {
    DoesNotGround { reason: read.probe_error }
  } else {
    if healthz_body_groundable(body: read.body) {
      Grounds { evidence: ServiceReadyEvidence { body: read.body } }
    } else {
      DoesNotGround { reason: "healthz body is not parseable json shape" }
    }
  }
}

fn healthz_read_from_shell_apply(
  r: Reconciliation<HostEffectIntent, HostEffectEvidence>
) -> ShowEffectiveRead<HealthzEffectiveRead> {
  match r {
    Converged { evidence: e, applied: _ } =>
      match e {
        ShellEffectApplied { stdout: out, exit_code: _ } =>
          ReadObserved {
            value: HealthzEffectiveRead {
              body: out,
              probe_error: "",
            }
          }
        ConvergePlanApplied { stdout: _, exit_code: _ } =>
          ReadAbsent {
            reason: "health probe returned ConvergePlanApplied; typed mismatch",
          }
      }
    NotConverged { reason: why, applied: _ } =>
      ReadObserved {
        value: HealthzEffectiveRead {
          body: "",
          probe_error: why,
        }
      }
  }
}

fn live_deploy_service_ready_probe_apply(
  spec: DeploymentSpec,
  transport: HostEffectTransport,
  access: DeployAccess,
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  host_effect_apply_gated(
    access: access,
    target: HostOs { node: spec.target.host },
    effect: ShellCommand {
      script: live_deploy_healthz_probe_script_for_port(
        port: deployment_plan_listen_port(spec: spec)
      ),
    },
    evidence: host_effect_read_evidence,
    transport: transport,
    fixture_actor: Absent,
  )
}

fn show_healthz_read_for_deploy(
  spec: DeploymentSpec,
  transport: HostEffectTransport,
  access: DeployAccess,
) -> ShowEffectiveRead<HealthzEffectiveRead> {
  healthz_read_from_shell_apply(
    r: live_deploy_service_ready_probe_apply(
      spec: spec,
      transport: transport,
      access: access,
    )
  )
}

fn show_healthz_read_fixture_healthy() -> ShowEffectiveRead<HealthzEffectiveRead> {
  ReadObserved {
    value: HealthzEffectiveRead {
      body: "{\"status\":\"ok\"}",
      probe_error: "",
    }
  }
}

fn reconcile_service_ready_read(
  read: ShowEffectiveRead<HealthzEffectiveRead>
) -> Reconciliation<ServiceReadyApplyEffect, ServiceReadyEvidence> {
  match read {
    ReadAbsent { reason: why } =>
      reconcile_grounded(
        apply_effect: service_ready_apply_effect(),
        show_read: read,
        grounding: DoesNotGround { reason: why }
      )
    ReadObserved { value: observed } =>
      reconcile_grounded(
        apply_effect: service_ready_apply_effect(),
        show_read: read,
        grounding: ground_service_ready_from_healthz(read: observed)
      )
  }
}

fn live_deploy_service_ready_once_for_deploy(
  spec: DeploymentSpec,
  transport: HostEffectTransport,
  access: DeployAccess,
) -> Reconciliation<ServiceReadyApplyEffect, ServiceReadyEvidence> {
  reconcile_service_ready_read(
    read: show_healthz_read_for_deploy(
      spec: spec,
      transport: transport,
      access: access,
    )
  )
}

fn live_deploy_service_ready_once() -> Reconciliation<ServiceReadyApplyEffect, ServiceReadyEvidence> {
  reconcile_service_ready_read(read: show_healthz_read_fixture_healthy())
}

fn live_deploy_poll_service_ready_after_seconds(
  spec: DeploymentSpec,
  transport: HostEffectTransport,
  access: DeployAccess,
  elapsed: Int,
  last_probe: String,
) -> Reconciliation<ServiceReadyApplyEffect, ServiceReadyEvidence> {
  let bound = second_count(s: live_deploy_service_ready_poll_bound)
  if elapsed >= bound {
    NotConverged {
      reason: service_not_ready_reason(refusal: ServiceNotReady {
        unit: live_deploy_service_ready_unit_authority,
        endpoint: live_deploy_service_ready_endpoint_authority,
        waited: live_deploy_service_ready_poll_bound,
        last_probe: last_probe,
      }),
      applied: service_ready_apply_effect(),
    }
  } else {
    let attempt = live_deploy_service_ready_once_for_deploy(
      spec: spec,
      transport: transport,
      access: access,
    )
    if reconciliation_converged(r: attempt) {
      attempt
    } else {
      let delay = sleep.Delay.Seconds(seconds: "1" as NonEmptyStr)
      if delay.success {
        live_deploy_poll_service_ready_after_seconds(
          spec: spec,
          transport: transport,
          access: access,
          elapsed: elapsed + 1,
          last_probe: last_probe_from_attempt(attempt: attempt)
        )
      } else {
        NotConverged {
          reason: service_not_ready_reason(refusal: ServiceNotReady {
            unit: live_deploy_service_ready_unit_authority,
            endpoint: live_deploy_service_ready_endpoint_authority,
            waited: live_deploy_service_ready_poll_bound,
            last_probe: "sleep between health probes failed",
          }),
          applied: service_ready_apply_effect(),
        }
      }
    }
  }
}

fn last_probe_from_attempt(
  attempt: Reconciliation<ServiceReadyApplyEffect, ServiceReadyEvidence>
) -> String {
  match attempt {
    NotConverged { reason: why, applied: _ } => why
    Converged { evidence: _, applied: _ } => "converged"
  }
}

fn live_deploy_poll_until_service_ready_for_deploy(
  spec: DeploymentSpec,
  transport: HostEffectTransport,
  access: DeployAccess,
) -> Reconciliation<ServiceReadyApplyEffect, ServiceReadyEvidence> {
  live_deploy_poll_service_ready_after_seconds(
    spec: spec,
    transport: transport,
    access: access,
    elapsed: 0,
    last_probe: "no probe yet",
  )
}

fn live_deploy_poll_until_service_ready() -> Reconciliation<ServiceReadyApplyEffect, ServiceReadyEvidence> {
  live_deploy_poll_until_service_ready_for_deploy(
    spec: deployment_spec_srv1(),
    transport: ci_deploy_srv1_access.transport,
    access: ci_deploy_srv1_access,
  )
}
