}
import gunbc.host_effect_realize { host_effect_apply_gated }
import extdeps.tools.sleep { sleep_delay_seconds_second_carrier_projection }

type ServiceReadyEvidence {
  body: String
}

type ServiceReadyApplyEffect {
  unit: NonEmptyStr
  endpoint: NonEmptyStr
}

type HealthzEffectiveRead {
  body: String
  probe_error: String
}

fn service_ready_apply_effect() -> ServiceReadyApplyEffect {
  ServiceReadyApplyEffect {
    unit: live_deploy_service_ready_unit_authority,
    endpoint: live_deploy_service_ready_endpoint_authority,
  }
}

fn live_deploy_healthz_probe_script_for_port(port: Int) -> String {
  live_deploy_health_probe_curl_command(
    health_url: live_deploy_health_url_for_port(port: port)
  )
}

fn healthz_body_groundable(body: String) -> Bool {
  roadmap_site_healthz_json_string_parses(body: body)
}

data service_ready_means_serving_this_tree_note: String = "READY was under-specified and the gap was live: it meant 'something answered /healthz', which the PRE-RESTART process satisfies. `gunbc serve` binds its compiled graph ONCE at process start, so between `systemctl restart` and the new process finishing its ~35 s load the OLD process is still answering — a poll that grounds on any answer can therefore green against the very process the deploy is replacing, and the deploy reports success while the dashboard still serves the previous tree. That is not a hypothetical: on 2026-07-24 the live srv1 page was serving the escaped `.node-superseded &gt; .title` selector, the pre-fix `width` chip, no disclosure and no centering, and every check in the system was green. So readiness now means the STRONGER and actually intended thing — the unit is answering AND the surface it answers with is this tree's — which the healthz digest map makes a plain equality (roadmap_site_healthz_surface_is_current). The three refusal causes stay type-distinct because their remedies differ: the probe never landed (network/unit down), the body is not JSON (wrong process on the port), the body is a well-formed fingerprint of ANOTHER tree (graph not rebound / sync incomplete). Each is a typed, located, countable refusal that the poll retries within its bound and that REFUSES at the bound — never a widen, and never a mode that proceeds as if it had not fired. Known and accepted race, named rather than hidden: two main pushes deploying concurrently can have deploy N observe deploy N+1's surface, which refuses honestly ('the surface is not the one I deployed' is true) and self-heals on the next deploy."

type HealthzRefusalCause
  = HealthzProbeFailed { detail: String }
  | HealthzBodyUnparseable { body: String }
  | HealthzSurfaceStale { observed: String, expected: String }

fn healthz_refusal_reason(cause: HealthzRefusalCause) -> String {
  match cause {
    HealthzProbeFailed { detail: d } => d
    HealthzBodyUnparseable { body: b } =>
      join(["healthz body failed JSON.parse; body=", b], "")
    HealthzSurfaceStale { observed: o, expected: e } =>
      join([
        "ServedSurfaceStale: the unit answered /healthz but its served surface is not this tree's",
        " — gunbc serve binds its graph once at process start, so the pre-restart process is still",
        " answering (or the source sync did not land). observed=", o, " expected=", e,
      ], "")
  }
}

fn ground_service_ready_from_healthz(read: HealthzEffectiveRead) -> Grounding<ServiceReadyEvidence> {
  if read.probe_error != "" {
    DoesNotGround { reason: healthz_refusal_reason(cause: HealthzProbeFailed { detail: read.probe_error }) }
  } else if !healthz_body_groundable(body: read.body) {
    DoesNotGround { reason: healthz_refusal_reason(cause: HealthzBodyUnparseable { body: read.body }) }
  } else if !roadmap_site_healthz_surface_is_current(observed_body: read.body) {
    DoesNotGround {
      reason: healthz_refusal_reason(cause: HealthzSurfaceStale {
        observed: read.body,
        expected: roadmap_site_healthz_body(),
      })
    }
  } else {
    Grounds { evidence: ServiceReadyEvidence { body: read.body } }
  }
}

fn healthz_read_from_shell_apply(
  r: Reconciliation<HostEffectIntent, HostEffectEvidence>
) -> ShowEffectiveRead<HealthzEffectiveRead> {
  match r {
    Converged { evidence: e, applied: _ } =>
      match e {
        ShellEffectApplied { stdout: out, exit_code: _ } =>
          ReadObserved {
            value: HealthzEffectiveRead {
              body: out,
              probe_error: "",
            }
          }
        ConvergePlanApplied { stdout: _, exit_code: _ } =>
          ReadAbsent {
            reason: "health probe returned ConvergePlanApplied; typed mismatch",
          }
      }
    NotConverged { reason: why, applied: _ } =>
      ReadObserved {
        value: HealthzEffectiveRead {
          body: "",
          probe_error: why,
        }
      }
  }
}

fn live_deploy_service_ready_probe_apply(
  spec: DeploymentSpec,
  transport: HostEffectTransport,
  access: DeployAccess,
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  host_effect_apply_gated(
    access: access,
    target: HostOs { node: spec.target.host },
    effect: ShellCommand {
      script: live_deploy_healthz_probe_script_for_port(
        port: deployment_plan_listen_port(spec: spec)
      ),
    },
    evidence: host_effect_read_evidence,
    transport: transport,
    fixture_actor: Absent,
  )
}

fn show_healthz_read_for_deploy(
  spec: DeploymentSpec,
  transport: HostEffectTransport,
  access: DeployAccess,
) -> ShowEffectiveRead<HealthzEffectiveRead> {
  healthz_read_from_shell_apply(
    r: live_deploy_service_ready_probe_apply(
      spec: spec,
      transport: transport,
      access: access,
    )
  )
}

data healthz_healthy_fixture_note: String = "The healthy fixture is the REAL healthz body, not a hand-spelled {\"status\":\"ok\"}. Once readiness means 'answering AND serving this tree', a fixture that merely parses is no longer a healthy read — it is precisely the stale-surface case — so a stand-in body would have made the converges-on-healthy witnesses assert the opposite of the contract. Its counterpart witness_stale_surface_read_does_not_ground keeps the hand-spelled body as the discriminating RED."

fn show_healthz_read_fixture_healthy() -> ShowEffectiveRead<HealthzEffectiveRead> {
  ReadObserved {
    value: HealthzEffectiveRead {
      body: roadmap_site_healthz_body(),
      probe_error: "",
    }
  }
}

fn reconcile_service_ready_read(
  read: ShowEffectiveRead<HealthzEffectiveRead>
) -> Reconciliation<ServiceReadyApplyEffect, ServiceReadyEvidence> {
  match read {
    ReadAbsent { reason: why } =>
      reconcile_grounded(
        apply_effect: service_ready_apply_effect(),
        show_read: read,
        grounding: DoesNotGround { reason: why }
      )
    ReadObserved { value: observed } =>
      reconcile_grounded(
        apply_effect: service_ready_apply_effect(),
        show_read: read,
        grounding: ground_service_ready_from_healthz(read: observed)
      )
  }
}

fn live_deploy_service_ready_once_for_deploy(
  spec: DeploymentSpec,
  transport: HostEffectTransport,
  access: DeployAccess,
) -> Reconciliation<ServiceReadyApplyEffect, ServiceReadyEvidence> {
  reconcile_service_ready_read(
    read: show_healthz_read_for_deploy(
      spec: spec,
      transport: transport,
      access: access,
    )
  )
}

fn live_deploy_service_ready_once() -> Reconciliation<ServiceReadyApplyEffect, ServiceReadyEvidence> {
  reconcile_service_ready_read(read: show_healthz_read_fixture_healthy())
}

fn unit_diagnosis_from_shell_apply(
  r: Reconciliation<HostEffectIntent, HostEffectEvidence>
) -> String {
  match r {
    Converged { evidence: e, applied: _ } =>
      match e {
        ShellEffectApplied { stdout: out, exit_code: _ } => out
        ConvergePlanApplied { stdout: _, exit_code: _ } =>
          "unit diagnosis capture returned ConvergePlanApplied; typed mismatch"
      }
    NotConverged { reason: why, applied: _ } =>
      concat("unit diagnosis capture failed: ", why)
  }
}

fn capture_unit_diagnosis(
  spec: DeploymentSpec,
  transport: HostEffectTransport,
  access: DeployAccess,
) -> String {
  unit_diagnosis_from_shell_apply(
    r: host_effect_apply_gated(
      access: access,
      target: HostOs { node: spec.target.host },
      effect: ShellCommand {
        script: live_deploy_unit_diagnosis_command(
          unit: live_deploy_service_ready_unit_authority
        ),
      },
      evidence: host_effect_read_evidence,
      transport: transport,
      fixture_actor: Absent,
    )
  )
}

type ServiceReadyPollOutcome =
    PollSettled { result: Reconciliation<ServiceReadyApplyEffect, ServiceReadyEvidence> }
  | PollRefusedAtBound { refusal: ServiceNotReady }

fn poll_bound_refusal(last_probe: String) -> ServiceNotReady {
  ServiceNotReady {
    unit: live_deploy_service_ready_unit_authority,
    endpoint: live_deploy_service_ready_endpoint_authority,
    waited: live_deploy_service_ready_poll_bound,
    last_probe: last_probe,
    unit_diagnosis: UnitDiagnosisUnavailable,
  }
}

fn refusal_to_reconciliation(refusal: ServiceNotReady) -> Reconciliation<ServiceReadyApplyEffect, ServiceReadyEvidence> {
  NotConverged {
    reason: service_not_ready_reason(refusal: refusal),
    applied: service_ready_apply_effect(),
  }
}

fn live_deploy_poll_service_ready_outcome_after_attempts(
  spec: DeploymentSpec,
  transport: HostEffectTransport,
  access: DeployAccess,
  attempt: Int,
  last_probe: String,
) -> ServiceReadyPollOutcome {
  let max_attempts = live_deploy_service_ready_poll_max_attempts()
  if attempt >= max_attempts {
    PollRefusedAtBound { refusal: poll_bound_refusal(last_probe: last_probe) }
  } else {
    let probe = live_deploy_service_ready_once_for_deploy(
      spec: spec,
      transport: transport,
      access: access,
    )
    if reconciliation_converged(r: probe) {
      PollSettled { result: probe }
    } else {
      let delay = sleep_delay_seconds_second_carrier_projection(duration: live_deploy_service_ready_poll_cadence)
      if delay {
        live_deploy_poll_service_ready_outcome_after_attempts(
          spec: spec,
          transport: transport,
          access: access,
          attempt: attempt + 1,
          last_probe: last_probe_from_attempt(attempt: probe)
        )
      } else {
        PollRefusedAtBound {
          refusal: poll_bound_refusal(last_probe: "sleep between health probes failed")
        }
      }
    }
  }
}

fn live_deploy_poll_service_ready_after_attempts(
  spec: DeploymentSpec,
  transport: HostEffectTransport,
  access: DeployAccess,
  attempt: Int,
  last_probe: String,
) -> Reconciliation<ServiceReadyApplyEffect, ServiceReadyEvidence> {
  match live_deploy_poll_service_ready_outcome_after_attempts(
    spec: spec,
    transport: transport,
    access: access,
    attempt: attempt,
    last_probe: last_probe,
  ) {
    PollSettled { result: r } => r
    PollRefusedAtBound { refusal: refusal } => refusal_to_reconciliation(refusal: refusal)
  }
}

fn last_probe_from_attempt(
  attempt: Reconciliation<ServiceReadyApplyEffect, ServiceReadyEvidence>
) -> String {
  match attempt {
    NotConverged { reason: why, applied: _ } => why
    Converged { evidence: _, applied: _ } => "converged"
  }
}

fn live_deploy_poll_until_service_ready_for_deploy(
  spec: DeploymentSpec,
  transport: HostEffectTransport,
  access: DeployAccess,
) -> Reconciliation<ServiceReadyApplyEffect, ServiceReadyEvidence> {
  match live_deploy_poll_service_ready_outcome_after_attempts(
    spec: spec,
    transport: transport,
    access: access,
    attempt: 0,
    last_probe: "no probe yet",
  ) {
    PollSettled { result: r } => r
    PollRefusedAtBound { refusal: refusal } =>
      refusal_to_reconciliation(
        refusal: service_not_ready_with_captured_diagnosis(
          refusal: refusal,
          text: capture_unit_diagnosis(
            spec: spec,
            transport: transport,
            access: access,
          )
        )
      )
  }
}

fn live_deploy_poll_until_service_ready() -> Reconciliation<ServiceReadyApplyEffect, ServiceReadyEvidence> {
  live_deploy_poll_until_service_ready_for_deploy(
    spec: deployment_spec_srv1(),
    transport: ci_deploy_srv1_access.transport,
    access: ci_deploy_srv1_access,
  )
}
