module gunbc.live_deploy.user_work_pool_slots

import std.nat { Nat }

// OPERATOR RULING 2026-10-16 (escalation msg_16bbe1f1, recommended option default-approved): FOUR
// slots, 88 GiB. Measured on srv1 2026-10-16: each lab belt tick starts ~6 obligation units at once
// (metering, snapshot-census, result-return, compute-seats, dogfood-start, observe), each a ~4-5 GiB
// gunbc compile, all in this slice; a harness worker's test job landing in that fan-out was OOM-killed
// at a 6 GiB peak under the 44 GiB cap (attempt eb468ff555a87e18). The raise is charged the same way
// the two slots were, so srv1's derived CI runner width falls by the slots this takes. Moving the
// lab's obligations into its own instance slice is the end state (they are user-manager transients,
// so that needs system-manager launching) and does not revert this ruling by itself.
//
// SUPERSEDED: OPERATOR RULING 2026-10-14 (sleek-owl-397 via clever-crane-830), OPTION C MAXIMIZED.
// The slice held TWO concurrent 22 GiB units (gunbc_runner_slot_desired MemoryMax): belt
// attempts, compute, and ad-hoc gunbc test/run share this envelope. That is smaller than the
// concurrent review/audit/supervisor population that still injects Slice=; the cap is policy,
// not a claim those members fit without queuing or OOM. Charging that appropriation (44 GiB)
// into served_deployment_slice_allowance is the same ruling.
data user_work_charged_slots: Nat = Succ { prev: Succ { prev: Succ { prev: Succ { prev: Zero } } } }

type UserWorkPoolSlots
  = UserWorkPoolSlotsDerived { slots: Nat }

fn user_work_pool_slots() -> UserWorkPoolSlots {
  UserWorkPoolSlotsDerived { slots: user_work_charged_slots }
}
