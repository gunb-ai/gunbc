module gunbc.live_deploy.release_locus

import std.types { String, List, NonEmptyStr, CommitSha, Bool }
import gunbc.cli_run_workspace_root_scaffold { release_locus_tree_receipt_name, release_locus_tree_receipt_revision_key, release_locus_tree_receipt_digest_key }
import gunbc.ci.ci_release_bins { gunbc_release_bin_name, approval_device_crypto_serve_release_bin_name }

// THE RELEASE IDENTITY AND THE PER-CANDIDATE RELEASE LOCUS, HOMED AS A LEAF. These were declared in
// gunbc.live_deploy.emit, so every reader of a release path -- the approval broker's own routes and
// its ntfy readback among them -- imported the whole deploy emitter to name a sha-keyed directory,
// and through it v2.compiler.emit_orchestration: the broker's serve closure typechecked the whole
// deploy emitter at every boot (srv1, 2026-09-27: not listening 17 min after start). A release
// revision and the paths it names are facts about a release, not about how a deploy script is
// emitted; the emitter consumes them from here like every other reader. This removes the emitter
// edge only -- the closure still reaches v2.compiler through gunbc.shell_command_text, a separate
// layer inversion with its own work item.
//
// WHERE THE LAUNCH REVISION COMES FROM IS ITSELF A MODELED FACT, AND THERE ARE EXACTLY TWO ARMS
// BECAUSE ONLY TWO ARE HONEST. RevisionBoundAtEmission is the production apply: the launcher
// observed one candidate, the unit installed at the host bakes exactly that value, and readiness
// compares against the same single subject. RevisionNotInstalled is the retract fold, and it exists
// so a retract cannot name a revision even accidentally — the arm that would render ExecStart under
// it REFUSES with a poison marker, the same unreachable-arm discipline
// the deleted retract emitter used.\n\nA THIRD ARM WAS TRIED AND DELETED, AND THE
// REASON IS WORTH KEEPING. RevisionBoundAtInvocation rendered a bash parameter expansion into the
// unit so a committed script could defer its revision to invocation. It could never have worked:
// the unit body reaches the host as a single-quoted printf argument (it was a quoted-delimiter
// heredoc when this was found, and the property that mattered survived the change), so bash
// performs no expansion inside it and the literal dollar-brace text lands in the unit file; systemd
// does not run ExecStart through bash, implements no :? operator, and this unit sets no such
// Environment. The chain script-invocation to unit to launch argument did not exist at any link.
// Proven by execution, not by reading — which is the point: it typechecked, it read plausibly, and
// it was inert.\n\nWhat it was protecting turned out not to need protecting. It existed to keep a
// committed script as the byte oracle over this ExecStart line, on the belief that deleting the
// artifact would lose that coverage. A fixture sha is forbidden in a committed PRODUCTION artifact,
// not in a witness — so the oracle lives in the test corpus against RevisionBoundAtEmission with a
// fixture, and the artifact was simply dead (no execution consumer, and a HostReconciler consumer
// row that named a reader which does not exist).
type ReleaseRevisionBinding
  = RevisionBoundAtEmission { revision: CommitSha }
  | RevisionNotInstalled

data release_revision_not_installed_poison: String = "__GUNBC_DEPLOY_UNREACHABLE__ the systemd unit writer was reached with RevisionNotInstalled — a retract fold dispatched a unit install. This marker is not a valid release revision, so the golden drift gate reds rather than emitting a unit whose ExecStart names no release (gunbc.design_argument::fail_closed: an unreachable arm refuses loudly, never fabricates)."

fn release_revision_execstart_text(binding: ReleaseRevisionBinding) -> String {
  match binding {
    RevisionBoundAtEmission { revision: r } => r as String
    RevisionNotInstalled => release_revision_not_installed_poison
  }
}

// THE LOCUS IS NAMED FOR WHAT IT IS, NOT ITS FIRST TENANT. These folds were spelled
// approval_broker_* while the microVM controller, the attempt units and workspace commissioning
// already resolved their release directories through them: one concept carrying one consumer's name
// (gunbc.design_argument::single_authority). The dashboard and belt move onto the same locus under
// gunbc.plans.deploy_convergence_observed_side (deleted 2026-11-08) (staged release generations), so the name is the
// locus's own before a second service family reads it.
data release_locus_dir_unbound_poison: String = "__GUNBC_DEPLOY_UNREACHABLE__ the release locus was asked for a path under RevisionNotInstalled. A release directory is named by the candidate sha, so there is no directory this could mean; emitting this marker fails the stage rather than installing a release into a path named after a diagnostic (gunbc.design_argument::fail_closed)."

// THE ROOT IS THE SERVICE CONFIG'S, NOT host_layout's, READ DIRECTLY. Both name the same directory
// today, and reading the row here would still be correct -- but it would make the broker's root a
// fact this fold knows independently of the service it is emitting a unit for, so a deployment
// whose config named a different root would install its tree under one path and start its unit from
// another. The config is the parameter every other member of this unit comes from; the root is not
// an exception to that.
fn release_locus_dir(root: String, revision: ReleaseRevisionBinding) -> String {
  match revision {
    RevisionBoundAtEmission { revision: r } => join([root, "/releases/", r as String], "")
    RevisionNotInstalled => release_locus_dir_unbound_poison
  }
}

fn release_locus_releases_dir(root: String) -> String {
  join([root, "/releases"], "")
}

// A RELEASE LOCUS IS ONE RECORD, NOT A HANDFUL OF STRINGS THAT CAN DRIFT APART. The install that lays
// a tree into a locus needs the spine (the parent directories it may create), the locus directory and
// the revision the locus is named for; when those were three arguments, a caller could pair a locus
// built for one revision with a different revision argument and nothing in the signature stopped it
// (review 95699). `release_locus_record` is the ONE mint for the release shape: it derives spine and
// locus from (base_root, revision) together, so a caller that mints cannot pair a locus with a
// revision it was not minted for. `helper_release_locus_record` is the one mint for the root-helper
// snapshot shape under a HelperLocus; it likewise derives the directory from the revision it names.
// The type's constructor stays open (a record is a plain carrier), so the guarantee is "these two
// folds are the sanctioned mints; every release/helper install obtains its locus through one of them,"
// NOT "a mismatched record is unwritable" -- the constructor is public. Stated at that rung per
// gunbc.design_argument::guarantee_ladder: the reported rung equals the rung the code establishes.
type ReleaseLocus {
  revision: ReleaseRevisionBinding
  spine: List<String>
  locus: String
}

fn release_locus_record(base_root: String, revision: ReleaseRevisionBinding) -> ReleaseLocus {
  ReleaseLocus {
    revision: revision,
    spine: [base_root, release_locus_releases_dir(root: base_root)],
    locus: release_locus_dir(root: base_root, revision: revision),
  }
}

// A MEMBER OF THE LOCUS IS NAMED BY ONE FOLD: the gunbc binary and any further binary installed beside it (the
// device-crypto sidecar) resolve their path through it, so a second binary is a name, not a second path rule.
fn release_locus_member_path(root: String, revision: ReleaseRevisionBinding, name: String) -> String {
  join([release_locus_dir(root: root, revision: revision), "/", name], "")
}

// THE BROKER'S RELEASE LOCUS HAS EXACTLY THESE EXECUTABLE MEMBERS, AND THIS ROW IS THE ONLY ENUMERATION. The broker unit
// loads an EnvironmentFile named from the sidecar binary and orders itself after the sidecar unit, so a locus holding only
// the gunbc binary cannot start the broker (2026-10-21: run 39545280023 installed the gunbc binary alone and systemd
// refused the unit with "Failed to load environment files"). Staging installs and reads back every name here; a member
// is added by adding a name, never by a second install step. The helper snapshot is a different locus and holds only
// gunbc_release_bin_name.
data approval_broker_release_locus_executables: List<String> = [gunbc_release_bin_name, approval_device_crypto_serve_release_bin_name]

fn release_locus_binary_path(root: String, revision: ReleaseRevisionBinding) -> String {
  release_locus_member_path(root: root, revision: revision, name: gunbc_release_bin_name)
}

fn release_locus_tree_receipt_path(root: String, revision: ReleaseRevisionBinding) -> String {
  join([release_locus_dir(root: root, revision: revision), "/", release_locus_tree_receipt_name], "")
}

data release_locus_tree_subdirs: List<String> = ["dag", "src/v2"]

data approval_broker_helper_root_principal: NonEmptyStr = "root"

// WHERE A HELPER RUNS FROM, AND WHO CAN WRITE IT. The owner is the principal that owns every entry in
// the locus (the install makes it so, and the snapshot readback checks it). The step stem names the
// locus's install and retire legs in an apply, so two root-helper loci in one apply are told apart by
// their steps rather than both reporting under one name.
type HelperLocus {
  base: String
  owner: NonEmptyStr
  step_stem: NonEmptyStr
}

fn helper_locus_dir(locus: HelperLocus, revision: ReleaseRevisionBinding) -> String {
  match revision {
    RevisionBoundAtEmission { revision: r } => join([locus.base, "/", r as String], "")
    RevisionNotInstalled => release_locus_dir_unbound_poison
  }
}

// THE ONE MINT FOR THE ROOT-HELPER SNAPSHOT INSTALL. Its directory is helper_locus_dir(locus, revision) --
// derived from the SAME revision the record carries. The root-helper snapshot install port
// (live_deploy_apply_root_helper_snapshot_on_host, reached from deploy_apply_ports_on_host and the fleet
// board-function converge delivery) now mints the directory once from (locus, revision) instead of its two
// call sites hand-computing helper_locus_dir beside an independent revision argument (review 95713: a
// hand-copied dir could drift from the revision it was built for -- the very split this record exists to
// remove). Other helper_locus_dir callers (the board-function converge / srv1 gpu-power-cap unit renderers,
// the attempt-system-unit launch) compute a path for their OWN verify/display purpose, not the install
// directory; they are unrelated and unchanged. The spine is a caller-supplied list (the helper's parent
// dirs are not derived from a base root the way the release spine is).
fn helper_release_locus_record(locus: HelperLocus, spine: List<String>, revision: ReleaseRevisionBinding) -> ReleaseLocus {
  ReleaseLocus {
    revision: revision,
    spine: spine,
    locus: helper_locus_dir(locus: locus, revision: revision),
  }
}

// ── THE TREE RECEIPT, READ BACK ───────────────────────────────────────────────────────────────
// Homed here, beside the receipt's path, because every release locus carries one: the approval broker, the microVM
// controller, workspace commissioning and the service-slot controller each read the receipt of their own locus.
// WHAT THIS READS AND WHAT IT ESTABLISHES, stated at its real strength rather than the strength the
// old annotation claimed. The receipt is a FILE ON THE HOST, written by the copy step in the release
// locus, carrying the candidate revision that copy was for and the digest of the bytes it installed.
// Reading it establishes that THE COPY FOR THIS CANDIDATE RAN AND RECORDED A DIGEST -- which a
// stale tree from an earlier deploy fails, and which the /livez echo cannot tell you at all.
//
// THE PATH IS PER-CANDIDATE NOW, AND THAT CHANGES WHAT "STALE" CAN EVEN MEAN (operator ruling
// 2026-09-20). The receipt lives inside releases/<candidate sha>/, and the readback derives the path
// it reads from the candidate it just deployed -- so an earlier deploy's receipt is not an older
// line at the same path that this fold must out-argue, it is a file somewhere else entirely. The
// failure mode collapses from "read the wrong revision's receipt and believe it" to "the file is
// absent", which is the arm below that refuses. A mutable shared root is what made the first
// reading necessary; the immutable locus makes it structural.
//
// WHAT IT DOES NOT YET ESTABLISH, named rather than implied: that the installed digest EQUALS a
// digest computed independently over the deploying checkout. That comparison needs the source-side
// digest computed at readback time, and this fold does not compute it. So the receipt is a subject
// side fact about which candidate was copied, not yet a proof that the bytes match. The trigger
// that closes it: the readback computing the source tree digest in the deploying checkout with the
// same fold the copy step uses, and refusing on inequality.
type ReleaseTreeReceiptRead
  = TreeReceiptUnreadable { detail: NonEmptyStr }
  | TreeReceiptMalformed { detail: NonEmptyStr }
  | TreeReceiptObserved { revision: NonEmptyStr, installed_digest: NonEmptyStr }

// THE FIRST MATCHING LINE WINS and later ones are ignored, which is the safe direction here: the
// copy step writes each key once, so a second occurrence means the receipt was appended to rather
// than replaced -- and reading the FIRST is reading the older value, which fails the revision
// comparison below rather than silently accepting a newer line over a stale file.
fn tree_receipt_field(text: String, key: String) -> String {
  let marker = join([key, "="], "")
  fold(split(s: text, delimiter: "\n"), init: "", f: (acc, line) =>
    if acc != "" { acc }
    else if starts_with(s: line, prefix: marker) {
      substring(s: line, start: string_length(s: marker), end: string_length(s: line))
    } else { acc }
  )
}

fn observe_release_tree_receipt(success: Bool, body: String, error: NonEmptyStr) -> ReleaseTreeReceiptRead {
  if !success {
    TreeReceiptUnreadable { detail: error }
  } else {
    let rev = tree_receipt_field(text: body, key: release_locus_tree_receipt_revision_key)
    let dig = tree_receipt_field(text: body, key: release_locus_tree_receipt_digest_key)
    if rev == "" {
      TreeReceiptMalformed { detail: "the tree receipt carries no candidate_revision line, so it cannot say which candidate the copy was for" as NonEmptyStr }
    } else if dig == "" {
      TreeReceiptMalformed { detail: "the tree receipt carries no installed_digest line, so the copy recorded nothing about the bytes it installed" as NonEmptyStr }
    } else {
      TreeReceiptObserved { revision: rev as NonEmptyStr, installed_digest: dig as NonEmptyStr }
    }
  }
}

// ── THE PAIR IS DELIVERED AS ONE UNIT, OR THE LAST GOOD PAIR KEEPS SERVING ───────────────────────
// THE LAB SERVES A PAIR, NOT A BINARY. The belt fold refuses to serve unless the serving binary and the
// source tree it reads carry the SAME main head (gunbc.live_deploy.release_binding::lab_pair_serve_verdict).
// A person at a terminal used to make that pair by hand — fetch CI's release bins, check out the matching
// source, drop both into a locus, restart the serve — and a hand redeploy is exactly where a MIXED pair is
// born: the two halves land at different times, so in between the lab serves a binary from one head against
// a tree from another, and the gate refuses. This fold is that delivery as ONE authority: the observed facts
// of a candidate delivery in, a bound pair out, or a refusal that keeps the last good pair serving. Its
// consumer is the co-located install stage @ref(gunbc.live_deploy.release_pair_delivery::release_pair_install_plan),
// which consults this fold and turns a PairInstalled into the ordered typed install and a PairRefused into
// PlanKeepsLastGood. The install stage is itself consumed by the executing route — the lab's own delivery unit
// (a NAMED, TRACKED later change, declared frontier: roadmap work item `lab-converges-release-pair`, PR3b — unit
// gunbc-srv1-lab-codex-feedback-v0-pair-delivery .service, its trigger the sibling .timer on a 600 s OnUnitActiveSec,
// to be emitted and registered in emit.dag/spec.dag/apply_legs.dag) runs the observed fetch -> build-key verify ->
// install stages in order, so a node merged to main reaches the served standings with no hand redeploy.
//
// THE REFUSAL HAS ONE PLACE (gunbc.fail_closed::fail_closed, "every degradation is typed and named"): every
// refusal arm returns the `serving` binding it was handed as `kept`, so "keep the last good locus serving" is
// not re-decided at each call site — the fold that could refuse is the ONLY fold that decides what keeps
// serving. The red controls (a head whose release bins are not built yet, whose pack fails build-key
// verification, or whose fetched source is not the head delivered for) are PairRefused arms: on the modelled
// leg it cannot install BOTH halves, so the previous pair keeps serving and the refusal is visible.
//
// WHAT IT ESTABLISHES, at the rung the code reaches (gunbc.design_argument::guarantee_ladder): given the
// caller's OBSERVED inputs — the pack fetch that yielded the binary digest and the consumer verify script's
// build-key verdict for that SAME fetched pack, neither recomputed here — the installed pair is bound exactly
// when the pack exists (not none), was verified on the fetched pack, and the fetched source head IS the main
// head being delivered for. It does NOT itself download or hash bytes; the delivery stages' fetch and verify
// effects carry that (gh_run_download_argv + the consumer build-key verify dispatch).
//
// The OBSERVED build-key verdict of the consumer script, carrying the digest it verified against. Its single
// producer is the staged plan's verification derivation (it names this digest ONLY when the verify observation ran
// on the same pack_dir the fetch observed); the fold cross-checks it against the binary it binds, so a verdict for
// an unverified — or different — pack cannot be handed to the fold to authorize an install (fail_closed).
type VerifiedPack { digest: NonEmptyStr }

// THE PAIR CARRIES ONE HEAD, ONE DIGEST, AND THE FILE THAT WAS DELIVERED (reviews 96050, 96059). The pair is the
// delivered binary as ONE identity: the single head (deliver_release_pair builds a pair only where source_head ==
// main_head, so storing main_head too duplicated one fact), the CI-verified digest that names it in the release
// locus, and the path of the file the fetch OBSERVED (its placement source). Carrying the source here — not
// re-deriving it at the placement site — is what makes the install a single authority: the file placed is provably
// the file fetched, with no path left for the executing unit to invent (review 96059).
type DeliveredReleasePair {
  head: CommitSha
  binaries_sha256: NonEmptyStr
  binary_source: NonEmptyStr
}

type ReleasePairDelivery
  = PairInstalled { pair: DeliveredReleasePair, locus: ReleaseLocus }
  | PairRefused { reason: NonEmptyStr, kept: ReleaseRevisionBinding }

data release_pair_bins_unbuilt_reason: NonEmptyStr = "the release bins for this main head are not built yet — no release-bins pack was handed off for the head, so there is no verified binary to pair the source with; the lab keeps serving the last good pair"
data release_pair_pack_unverified_reason: NonEmptyStr = "the release-bins pack for this main head failed build-key verification (--verify-build-artifacts refused it), so its binaries are not trusted; the lab keeps serving the last good pair"
data release_pair_source_head_mismatch_reason: NonEmptyStr = "the fetched source head is not the main head being delivered for, so the source half of the pair would not match the binary half; the lab keeps serving the last good pair"
data release_pair_source_missing_reason: NonEmptyStr = "a binary digest was reported for this head but no fetched file was observed to carry it, so the install would have no modeled placement source; the lab keeps serving the last good pair"

// ONE HEAD, ONE PAIR, OR THE LAST GOOD PAIR KEEPS SERVING. `binaries_sha256` and `binary_source` are `none` when
// the observed fetch produced no pack for the head (unbuilt); when a pack was fetched they are its OBSERVED digest
// and the path of the file the fetch produced. `verified` is a `VerifiedPack?` — the OBSERVED build-key verdict,
// carrying the digest the consumer script verified against. It is `none` when no verdict was observed (pack not
// verified); its single producer, @ref(gunbc.live_deploy.release_pair_delivery::release_pair_install_plan), emits
// it only when the verify observation names the SAME pack_dir the fetch observed. The fold then CROSS-CHECKS that
// the verdict's digest equals the `binaries_sha256` it is about to bind, and refuses otherwise — so a caller
// cannot hand a verdict for a pack it did not verify (fail_closed: the wrong state cannot be USED, not merely
// warned against). Every refusal returns the handed-in `serving` binding as `kept`, so a refused
// delivery installs nothing and restarts nothing — the previous pair keeps serving with the refusal visible. A
// digest reported WITHOUT an observed source file is incoherent and is refused as its own named degradation
// (fail_closed), rather than binding a pair whose placement source is unknown.
fn deliver_release_pair(base_root: String, serving: ReleaseRevisionBinding, main_head: CommitSha, source_head: CommitSha, binaries_sha256: NonEmptyStr?, binary_source: NonEmptyStr?, verified: VerifiedPack?) -> ReleasePairDelivery {
  match binaries_sha256 {
    none => PairRefused { reason: release_pair_bins_unbuilt_reason, kept: serving }
    Present { value: sha } =>
      match verified {
        none => PairRefused { reason: release_pair_pack_unverified_reason, kept: serving }
        Present { value: vp } =>
          // The verdict must name the very pack being bound: its digest equals the binary digest, or it verified
          // something else and this pack is, for our purposes, unverified (fail_closed cross-check).
          if (vp.digest as String) != (sha as String) {
            PairRefused { reason: release_pair_pack_unverified_reason, kept: serving }
          } else if (source_head as String) != (main_head as String) {
            PairRefused { reason: release_pair_source_head_mismatch_reason, kept: serving }
          } else {
            match binary_source {
              none => PairRefused { reason: release_pair_source_missing_reason, kept: serving }
              Present { value: src } =>
                // source_head == main_head here (the arm above), so the pair names its single head once (source_head);
                // the pair carries the fetched file so the install places exactly what was fetched (review 96059).
                let pair = DeliveredReleasePair { head: source_head, binaries_sha256: sha, binary_source: src }
                PairInstalled {
                  pair: pair,
                  locus: release_locus_record(base_root: base_root, revision: delivered_pair_revision(pair: pair)),
                }
            }
          }
      }
  }
}

// THE PAIR'S ONE IDENTITY. The serve unit's release_revision, the locus directory it names, and the standings
// readback all read this ONE value — the head whose CI release bins were verified against its source — so the
// identity is spelled once and never hand-copied (one authority).
fn delivered_pair_revision(pair: DeliveredReleasePair) -> ReleaseRevisionBinding {
  RevisionBoundAtEmission { revision: pair.head }
}
