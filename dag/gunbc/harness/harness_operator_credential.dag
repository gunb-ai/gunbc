module gunbc.harness.harness_operator_credential

import std.types { NonEmptyStr }

// THE OPERATOR ROUTE'S CREDENTIAL FILE, A LEAF BOTH ITS READER AND ITS LAUNCHER IMPORT. The harness reads the
// file (gunbc.harness.harness_operator_route, which carries this value as the route's `credential`); the root
// attempt-unit launcher hands it to a dedicated worker's unit (gunbc.roadmap.dispatch_worker_unit_confinement
// dispatch_worker_credentials). The launcher re-derives its confinement from source on every start and may not
// reach the harness world to learn one file's name: the route module's import closure is ~640 files and would
// grow the launcher's from ~400 to ~680. So the fact lives below both, and both read THIS datum -- the identifier
// the launcher's LoadCredential= line names is the identifier the harness looks up in $CREDENTIALS_DIRECTORY,
// by construction rather than by agreement.
//
// Two locations, one per custody (gunbc.harness.harness_operator_route OperatorCredentialCustody):
//   relative_path  under $HOME of the user running the harness, the service user's own 0600 custody file;
//   identifier     the file's name in the per-invocation credentials directory the service manager hands a
//                  unit (systemd.exec(5) LoadCredential=ID:PATH), for a worker account that has no home.
type OperatorCredentialFile {
  relative_path: NonEmptyStr
  identifier: NonEmptyStr
}

// THE ROUTE'S KEY, AND THE CERTIFICATE ITS WORKER PINS: one datum pair for the one operator route, no per-route fork.
// The worker's unit is handed both (gunbc.roadmap.dispatch_worker_unit_confinement dispatch_worker_credentials).
// The key is the srv1 fabric router's bearer key; the certificate is the router's self-signed LISTENER certificate
// (a server certificate to pin, not an mTLS client certificate). gunbc.harness.harness_operator_route reads both:
// the key as the request header, the certificate through operator_read_certificate to pin every request and probe.
data operator_route_credential_file: OperatorCredentialFile = OperatorCredentialFile {
  relative_path: ".config/gunbc-router/client.key" as NonEmptyStr,
  identifier: "gunbc-router-client-key" as NonEmptyStr,
}

data operator_route_certificate_file: OperatorCredentialFile = OperatorCredentialFile {
  relative_path: ".config/gunbc-router/server.pem" as NonEmptyStr,
  identifier: "gunbc-router-server-pem" as NonEmptyStr,
}

// THE SRV4 STRATA ROUTE'S PAIR: the daily engine's api-key and its self-signed server certificate,
// both read by path on this host (the lab deploy's paths, session eager-lynx-183, 2026-10-28). The
// worker hands the api-key to curl through LoadCredential (systemd-materialized, private 0700) under
// the identifier below, and the launcher hands exactly this identifier; the two agree by construction
// because both read the row, and the worker refuses naming the key file if the pair is not installed.
data operator_strata_credential_file: OperatorCredentialFile = OperatorCredentialFile {
  relative_path: ".config/gunbc-srv4-strata/api-key" as NonEmptyStr,
  identifier: "gunbc-srv4-strata-api-key" as NonEmptyStr,
}
data operator_strata_certificate_file: OperatorCredentialFile = OperatorCredentialFile {
  relative_path: ".config/gunbc-srv4-strata/server.pem" as NonEmptyStr,
  identifier: "gunbc-srv4-strata-server-pem" as NonEmptyStr,
}
