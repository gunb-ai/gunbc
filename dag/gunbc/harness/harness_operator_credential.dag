module gunbc.harness.harness_operator_credential

import std.types { NonEmptyStr }

// THE OPERATOR ROUTE'S CREDENTIAL FILE, A LEAF BOTH ITS READER AND ITS LAUNCHER IMPORT. The harness reads the
// file (gunbc.harness.harness_operator_route, which carries this value as the route's `credential`); the root
// attempt-unit launcher hands it to a dedicated worker's unit (gunbc.roadmap.dispatch_worker_unit_confinement
// dispatch_worker_credentials). The launcher re-derives its confinement from source on every start and may not
// reach the harness world to learn one file's name: the route module's import closure is ~640 files and would
// grow the launcher's from ~400 to ~680. So the fact lives below both, and both read THIS datum -- the identifier
// the launcher's LoadCredential= line names is the identifier the harness looks up in $CREDENTIALS_DIRECTORY,
// by construction rather than by agreement.
//
// Two locations, one per custody (gunbc.harness.harness_operator_route OperatorCredentialCustody):
//   relative_path  under $HOME of the user running the harness, the service user's own 0600 custody file;
//   identifier     the file's name in the per-invocation credentials directory the service manager hands a
//                  unit (systemd.exec(5) LoadCredential=ID:PATH), for a worker account that has no home.
type OperatorCredentialFile {
  relative_path: NonEmptyStr
  identifier: NonEmptyStr
}

data operator_route_credential_file: OperatorCredentialFile = OperatorCredentialFile {
  relative_path: ".config/gunbc-gpu-pod/api-key" as NonEmptyStr,
  identifier: "gunbc-gpu-pod-api-key" as NonEmptyStr,
}
