  JsonValue, JsonKeyValue, JsonNull, JsonBool, JsonNumber, JsonString, JsonArray, JsonObject,
  json_kv, json_string, json_int, json_array, json_object, serialize_json,
}
import extdeps.languages.json.parse {
  JsonDocumentParse, JsonDocumentParsed, JsonDocumentUnreadable,
  JsonMemberLookup, JsonMemberFound, JsonMemberAbsent, JsonMemberDuplicated, JsonMemberNotAnObject,
  parse_json_document, json_object_unique_member, json_document_gap_text,
}
import gunbc.harness.harness_reasoning_wire {
  HarnessServingUnit, Glm53FlashOnVllm, DeepseekV4FlashOnVllm,
  harness_unit_model_id, harness_unit_reasoning_field, harness_unit_reasoning_field_aliases,
}
import extdeps.llm.anthropic_messages_api {
  AnthropicToolDefinition,
  AnthropicStopReason, EndTurn, MaxTokens, StopSequence, ToolUse, PauseTurn, Refusal,
  ModelContextWindowExceeded,
}
import extdeps.ollama.api { ollama_default_port }
import gunbc.fleet_intent_network { srv5_host_lan_endpoint, srv6_host_lan_endpoint, host_lan_address }
import gunbc.spark.pair_serving_desired { spark_pair_serving_groups, spark_pair_serving_head }
import product.placement_supply { HostIdentity }

// THE WIRE CODEC FOR THE DEDICATED HARNESS, over the shape DCH-1 already hoisted off the vendor.
//
// extdeps.llm.anthropic_messages_api owns WHAT a messages request and response ARE; it carries no
// codec, so nothing in the corpus could yet turn one of its values into bytes or bytes into one of
// its values. This module is that codec and nothing else: no policy, no endpoint choice, no loop.
//
// It is authored HERE rather than in extdeps because a codec is a realization of the shape and the
// shape is the specification -- the same split gunbc.provider_interface_binding already draws
// between an interface and its transport. A second implementation of the same wire (the Anthropic
// service itself, or a different local server) reuses this codec unchanged, which is the property
// that makes the shared-standard modelling worth having.
//
// WHAT IS DELIBERATELY NOT HERE. Streaming is not decoded: DCH's own hypothesis list records that a
// streaming request may terminate a response early where an otherwise identical non-streaming
// request returns it complete, and that hypothesis has NO observation behind it yet. Encoding a
// stream decoder before that isolating run would be building on an unmeasured claim, so the codec
// speaks the non-streaming form only and a stream field is not emitted at all.

// A WIRE STOP REASON IS DECODED TOTALLY OR REFUSED, never defaulted.
//
// The tempting arm is `_ => EndTurn`, and it is the absorbing fallback in its most expensive
// position: an unrecognized stop reason would become the one value the harness reads as "the model
// finished", so a NEW upstream terminal state would present as successful completion. The refusal
// carries the unrecognized lexeme so the gap is nameable rather than silent.
type HarnessStopReasonRead
  = StopReasonRead { reason: AnthropicStopReason }
  | StopReasonUnrecognized { wire: String }

fn harness_decode_stop_reason(wire: String) -> HarnessStopReasonRead {
  if wire == "end_turn" {
    StopReasonRead { reason: EndTurn }
  } else if wire == "tool_use" {
    StopReasonRead { reason: ToolUse }
  } else if wire == "max_tokens" {
    StopReasonRead { reason: MaxTokens }
  } else if wire == "stop_sequence" {
    StopReasonRead { reason: StopSequence }
  } else if wire == "pause_turn" {
    StopReasonRead { reason: PauseTurn }
  } else if wire == "refusal" {
    StopReasonRead { reason: Refusal }
  } else if wire == "model_context_window_exceeded" {
    StopReasonRead { reason: ModelContextWindowExceeded }
  } else {
    StopReasonUnrecognized { wire: wire }
  }
}

fn harness_stop_reason_wire(reason: AnthropicStopReason) -> String {
  match reason {
    EndTurn => "end_turn"
    ToolUse => "tool_use"
    MaxTokens => "max_tokens"
    StopSequence => "stop_sequence"
    PauseTurn => "pause_turn"
    Refusal => "refusal"
    ModelContextWindowExceeded => "model_context_window_exceeded"
  }
}

// REQUEST ENCODING ------------------------------------------------------------------------
//
// THE TYPED MESSAGE ENCODER THAT SAT HERE IS DELETED, and the deletion is the point rather than
// tidiness. It was a SECOND encoder for one fact -- an assistant message projected to wire JSON --
// beside the live one in gunbc.harness.harness_turn, with no caller anywhere in the corpus. The
// fork was also the LOSSY half: its tool_use arm wrote `input` as an empty object, so a history
// replayed through it would have shown the model its own prior commands with the commands removed,
// and a worker that cannot see what it already ran re-runs it. Nothing was reaching that arm, which
// is exactly why it survived: a dead fork is invisible until someone repoints at the tidier-looking
// surface. Per DESIGN section 3 the live path is the single authority; per section 6 an artifact
// with no consumer is a dead scaffold. Both say delete rather than annotate.

fn harness_tool_result_block(tool_use_id: String, text: String, is_error: Bool) -> JsonValue {
  json_object([
    json_kv(key: "type", value: json_string(s: "tool_result")),
    json_kv(key: "tool_use_id", value: json_string(s: tool_use_id)),
    json_kv(key: "content", value: json_string(s: text)),
    json_kv(key: "is_error", value: JsonBool { value: is_error }),
  ])
}

fn harness_encode_tool(tool: AnthropicToolDefinition, schema: JsonValue) -> JsonValue {
  json_object([
    json_kv(key: "name", value: json_string(s: tool.name)),
    json_kv(key: "description", value: json_string(s: tool.description)),
    json_kv(key: "input_schema", value: schema),
  ])
}

// RESPONSE DECODING ------------------------------------------------------------------------

type HarnessWireBlock
  = WireTextBlock { text: String }
  | WireThinkingBlock { thinking: String }
  | WireToolUseBlock { id: String, name: String, input: JsonValue }

// USAGE RIDES ON THE PARSED RESPONSE AS A READ, NOT AS TWO INTS, and the shape is the safety.
//
// A decoded response and a counted usage are two independent observations: a turn whose content
// decoded perfectly may carry a usage object this codec cannot read, and collapsing that into
// `input_tokens: 0` makes the second observation's ABSENCE wear the first one's success. Carrying
// HarnessUsageRead forces every consumer to say what it does when the counts were not observed --
// which is the whole point, because the consumer that matters (the context budget check in
// gunbc.harness.harness_turn) must stop the line rather than compare against a number nobody
// measured. This is the same move the turn already makes for the clock: ClockUnixMillisRead carries
// its refusal into the event stream instead of fabricating an epoch.
type HarnessResponseRead
  = HarnessResponseParsed {
      blocks: List<HarnessWireBlock>
      stop_reason: AnthropicStopReason
      usage: HarnessUsageRead
    }
  | HarnessResponseUnreadable { cause: String }

// A STRING MEMBER IS READ, GENUINELY ABSENT, OR MALFORMED -- THREE ANSWERS, because two collapsed
// the second and third and that is this file's own failure class read one level up (review from the
// operator's side chat, 2026-09-11).
//
// `json_object_unique_member` already distinguishes four outcomes: found, absent, DUPLICATED, and
// not-an-object. The predecessor of this function mapped the last three onto one `none`, so a
// response carrying a member TWICE was indistinguishable from one carrying it not at all. That is
// not a hypothetical shape: `tool_calls` arriving twice made the decoder report zero tool calls,
// which `harness_turn_round` reads as "the model finished talking", writes `turn.completed` for,
// and exits zero on -- a duplicated member becoming a successful completion. Absence is the only
// outcome that may take a no-op arm; a member this codec cannot read uniquely is a refusal.
//
// PRESENT-AND-NULL IS THE FOURTH ANSWER, and collapsing it into the third was this repair's own
// over-correction (side-chat review, 2026-09-11). The OpenAI chat completion schema vLLM serves
// types the assistant message's `content` and its reasoning field as NULLABLE strings, so a
// tool-only round arrives as `"content": null` on a perfectly well-formed body. Reading that as
// malformed refuses a response the peer was entitled to send -- and refuses it BEFORE its tool
// calls are decoded, so the model's commands are lost to a decoder defect rather than to a wire
// one. `null` is the peer SAYING there is no string here; absent is the peer not speaking; a
// duplicate is unknowable; a number is a type error. Four wire facts, four outcomes, and each
// consumer decides what present-null means for ITS member rather than the codec deciding once.
type HarnessStringRead
  = StringRead { value: String }
  | StringAbsent
  | StringNull
  | StringMalformed { cause: String }

fn harness_member_string(doc: JsonValue, key: String) -> HarnessStringRead {
  match json_object_unique_member(v: doc, key: key) {
    JsonMemberFound { value: v } =>
      match v {
        JsonString { value: s } => StringRead { value: s }
        JsonNull => StringNull
        _ => StringMalformed { cause: join(["member '", key, "' is not a JSON string"], "") }
      }
    JsonMemberAbsent => StringAbsent
    JsonMemberDuplicated =>
      StringMalformed { cause: join(["member '", key, "' appears more than once; which one the sender meant is unknowable"], "") }
    JsonMemberNotAnObject =>
      StringMalformed { cause: join(["the value that should carry member '", key, "' is not a JSON object"], "") }
  }
}

// AN INTEGER MEMBER IS READ OR THE GAP IS NAMED. The predecessor of this function answered 0 for
// every way of not having a number -- member absent, member present but not a number, number whose
// lexeme does not parse as an integer -- and 0 is a LEGAL token count, so three distinct wire faults
// arrived at the consumer wearing the costume of a real measurement. That is the absorbing fallback
// of DESIGN section 5 in the position where it costs the most: input_tokens is what
// gunbc.harness.harness_turn harness_context_exhausted and harness_compaction_due compare against
// the declared budget, so a defaulted 0 says "the context is empty" for a turn that may be at the
// ceiling, and the two mechanisms that exist to stop the line never fire.
//
// THE LOOKUP'S FOUR OUTCOMES ARE CARRIED THROUGH HERE TOO, AND A WILDCARD IS WHAT LOST THEM
// (review 63762). The first version of this reader closed with `_ => IntAbsent`, so a usage object
// carrying `prompt_tokens` TWICE, and a `usage` member that is not an object at all, both arrived
// at the diagnostic as "carries no 'prompt_tokens' member". Nothing failed open -- the turn still
// refuses, and the count is still unavailable rather than zero -- but the refusal STATED A FALSE
// FACT ABOUT THE WIRE, which is exactly the collapse this module removed one type over for strings,
// surviving in the place a reader is least likely to look: the text of a message that is already
// saying no. A diagnostic is read by a person deciding what to fix, and "the field is missing"
// sends them somewhere different from "the field arrived twice". So the arms are written out and
// there is no wildcard: adding a fifth lookup outcome must break this fold rather than be absorbed
// by it.
type HarnessIntRead
  = IntRead { value: Int }
  | IntAbsent
  | IntDuplicated
  | IntNotAnObject
  | IntNotANumber
  | IntNotAnInteger { lexeme: String }

fn harness_member_int(doc: JsonValue, key: String) -> HarnessIntRead {
  match json_object_unique_member(v: doc, key: key) {
    JsonMemberFound { value: v } =>
      match v {
        JsonNumber { lexeme: lex } =>
          match parse_int(s: lex as String) {
            Present { value: n } => IntRead { value: n }
            Absent => IntNotAnInteger { lexeme: lex as String }
          }
        _ => IntNotANumber
      }
    JsonMemberAbsent => IntAbsent
    JsonMemberDuplicated => IntDuplicated
    JsonMemberNotAnObject => IntNotAnObject
  }
}

fn harness_int_read_gap(key: String, read: HarnessIntRead) -> String {
  match read {
    IntRead { value: n } => join(["member '", key, "' was read as ", to_string(value: n)], "")
    IntAbsent => join(["carries no '", key, "' member"], "")
    IntDuplicated =>
      join(["carries member '", key, "' duplicated; which count the sender meant is unknowable"], "")
    IntNotAnObject => join(["is not a JSON object, so member '", key, "' could not be read"], "")
    IntNotANumber => join(["member '", key, "' is not a JSON number"], "")
    IntNotAnInteger { lexeme: lx } => join(["member '", key, "' is not an integer: '", lx, "'"], "")
  }
}

// THE USAGE OBJECT IS READ AS A PAIR OR THE TURN STAYS UNREADABLE, never as a pair of zeros. The
// two counts are read together because they are one observation: a response that reports only one of
// them is not a response with a missing field, it is a usage object this codec does not understand,
// and reading the half that parsed would report a measurement that was never made.
type HarnessUsageRead
  = UsageRead { input_tokens: TokenCount, output_tokens: TokenCount }
  | UsageUnreadable { cause: String }

// THE COUNTS ARE TokenCount, NOT Int, and that is the other half of this repair rather than a
// flourish (review 63491). std.measure already owns the concept, and the same consumer already
// speaks it: gunbc.harness.harness_turn declares context_budget: TokenCount, so a bare Int decoded
// here had to be unwrapped through token_count_value to be compared against the budget -- and an
// unwrap-to-compare is the tell that the carrier exists and is being stepped around (DESIGN
// section 2: net concepts must not grow by re-invention). A PR whose thesis is that a token count
// must not be INVENTED owes the matching half, that a token count must be TYPED as one.
//
// A NEGATIVE COUNT REFUSES RATHER THAN BECOMING A MAGNITUDE. TokenCount is Nat-valued, so the
// crossing has to happen somewhere; it happens after the sign is checked, which is why
// nat_magnitude is exact here and fabricates nothing -- for a value already proven nonnegative the
// magnitude IS the value. Reversing that order would turn "-3 tokens" into "3 tokens", which is
// this file's own failure class one field over.
fn harness_token_count_of(n: Int) -> TokenCount {
  token_count(count: nat_magnitude(a: n))
}

fn harness_usage_read(doc: JsonValue, input_key: String, output_key: String) -> HarnessUsageRead {
  match json_object_unique_member(v: doc, key: "usage") {
    JsonMemberFound { value: u } => {
      let i = harness_member_int(doc: u, key: input_key)
      let o = harness_member_int(doc: u, key: output_key)
      match i {
        IntRead { value: iv } =>
          match o {
            IntRead { value: ov } =>
              if iv < 0 {
                UsageUnreadable { cause: join(["response usage member '", input_key, "' is negative"], "") }
              } else if ov < 0 {
                UsageUnreadable { cause: join(["response usage member '", output_key, "' is negative"], "") }
              } else {
                UsageRead {
                  input_tokens: harness_token_count_of(n: iv),
                  output_tokens: harness_token_count_of(n: ov),
                }
              }
            // Over HarnessIntRead, whose every non-read arm harness_int_read_gap names by outcome.
            _ => UsageUnreadable { cause: join(["response usage ", harness_int_read_gap(key: output_key, read: o)], "") }
          }
        _ => UsageUnreadable { cause: join(["response usage ", harness_int_read_gap(key: input_key, read: i)], "") }
      }
    }
    JsonMemberAbsent => UsageUnreadable {
      cause: "response carries no usage object; the token counts the context budget is checked against were not observed",
    }
    JsonMemberDuplicated => UsageUnreadable {
      cause: "response carries the usage object more than once; which counts the sender meant is unknowable",
    }
    JsonMemberNotAnObject => UsageUnreadable {
      cause: "the response body is not a JSON object, so its usage could not be read",
    }
  }
}

// A BLOCK IS READ, DECLARED UNMODELLED, OR REFUSED -- three answers, because the predecessor had
// two and the missing one was the one that mattered.
//
// The old decoder returned an option, so "this is a block kind a later vendor version added" and
// "this is a block kind we DO model, arriving malformed" were the same answer: drop it. Dropping the
// first is correct and is why BlockNotModelled survives. Dropping the second deletes work the model
// actually did -- a tool_use block whose id is missing is a command the model issued, and a decoder
// that silently omits it produces a turn in which the model asked for nothing.
//
// THE SHARPEST CASE IS `input`. A tool_use block whose input member is absent used to decode as an
// EMPTY OBJECT, which is not a marker: it is a well-formed, dispatchable set of arguments. The
// dispatcher in gunbc.harness.harness_tool then reads the tool's parameters off that object and
// finds none. WHAT HAPPENS NEXT IS NARROWER THAN AN EARLIER DRAFT OF THIS COMMENT CLAIMED (side-chat
// review, 2026-09-11): harness_execute_tool_use declares run_command's `command` required and
// refuses a call without it as ToolInputMemberMissing, so on today's one implemented tool nothing
// executes. The harm is a MISATTRIBUTION plus a spent round -- the model's real arguments are
// discarded and the model is told back that it sent a call with no command, which is a fact about
// the codec reported as a fact about the model. That refusal is a property of run_command's single
// required member, not of the decoder: a tool with an optional or defaulted parameter would
// dispatch on the empty object. The fabricated value is INDISTINGUISHABLE at every consumer from a
// model that genuinely sent `{}`, which is why the repair belongs here rather than in the
// dispatcher, and why it is silent wrongness rather than a weak default.
//
// The rule is therefore: an unknown `type` is not modelled and is skipped; a MODELLED kind missing a
// member its shape requires is a refusal naming the kind and the member.
type HarnessBlockRead
  = BlockRead { block: HarnessWireBlock }
  | BlockNotModelled
  | BlockUnreadable { cause: String }

fn harness_block_member_gap(kind: String, key: String) -> String {
  join(["a ", kind, " content block carries no string '", key, "' member"], "")
}

// PRESENT-AND-NULL IS A REFUSAL FOR EVERY MEMBER A SHAPE REQUIRES. Nullability is a fact about a
// specific member of a specific schema, not a property of JSON, so it is granted one member at a
// time: the chat assistant message's content and reasoning are typed nullable upstream and take a
// no-text arm, and every other member here is required, so `null` there is the peer declining to
// send something the shape says must be present. Naming it separately from a type error keeps the
// diagnostic honest about which of the two happened.
fn harness_null_member_cause(subject: String, key: String) -> String {
  join([subject, " carries '", key, "' as null; the shape requires a string there"], "")
}

// A LOOKUP HAS FOUR OUTCOMES AND A REFUSAL MAY NOT STATE A FALSE FACT ABOUT WHICH ONE HAPPENED.
// Every `json_object_unique_member` in this file now writes its three non-found arms out; the
// wildcards that used to close them reported "carries no 'function' member" for a tool_call that
// carried `function` TWICE, and the same for `message`, `choices` and the messages shape's
// `content` (review 63850). Nothing failed open -- each still refused -- but the sentence sent a
// reader looking for a member that was in fact there, and a diagnostic is read by a person
// deciding what to fix. These two helpers are the arms that were missing; the absent arm stays
// per-site because what a missing member COSTS differs at each one.
fn harness_duplicate_member_cause(subject: String, key: String) -> String {
  join([subject, " carries '", key, "' more than once; which one the sender meant is unknowable"], "")
}

fn harness_not_an_object_cause(subject: String, key: String) -> String {
  join([subject, " is not a JSON object, so its '", key, "' could not be read"], "")
}

fn harness_decode_block(v: JsonValue) -> HarnessBlockRead {
  match harness_member_string(doc: v, key: "type") {
    StringAbsent => BlockUnreadable { cause: "a content block carries no string type member; its kind is unknown" }
    StringNull => BlockUnreadable { cause: harness_null_member_cause(subject: "a content block", key: "type") }
    StringMalformed { cause: c } => BlockUnreadable { cause: join(["a content block's type is unreadable: ", c], "") }
    StringRead { value: kind } =>
      if kind == "text" {
        match harness_member_string(doc: v, key: "text") {
          StringRead { value: t } => BlockRead { block: WireTextBlock { text: t } }
          StringAbsent => BlockUnreadable { cause: harness_block_member_gap(kind: "text", key: "text") }
          StringNull => BlockUnreadable { cause: harness_null_member_cause(subject: "a text block", key: "text") }
          StringMalformed { cause: c } => BlockUnreadable { cause: join(["a text block is unreadable: ", c], "") }
        }
      } else if kind == "thinking" {
        match harness_member_string(doc: v, key: "thinking") {
          StringRead { value: t } => BlockRead { block: WireThinkingBlock { thinking: t } }
          StringAbsent => BlockUnreadable { cause: harness_block_member_gap(kind: "thinking", key: "thinking") }
          StringNull => BlockUnreadable { cause: harness_null_member_cause(subject: "a thinking block", key: "thinking") }
          StringMalformed { cause: c } => BlockUnreadable { cause: join(["a thinking block is unreadable: ", c], "") }
        }
      } else if kind == "tool_use" {
        match harness_member_string(doc: v, key: "id") {
          StringAbsent => BlockUnreadable {
            cause: "a tool_use block carries no string id member; its result could not be addressed back to the call",
          }
          StringNull => BlockUnreadable { cause: harness_null_member_cause(subject: "a tool_use block", key: "id") }
          StringMalformed { cause: c } => BlockUnreadable { cause: join(["a tool_use block's id is unreadable: ", c], "") }
          StringRead { value: id } =>
            match harness_member_string(doc: v, key: "name") {
              StringAbsent => BlockUnreadable { cause: harness_block_member_gap(kind: "tool_use", key: "name") }
              StringNull => BlockUnreadable { cause: harness_null_member_cause(subject: "a tool_use block", key: "name") }
              StringMalformed { cause: c } => BlockUnreadable { cause: join(["a tool_use block's name is unreadable: ", c], "") }
              StringRead { value: name } =>
                match json_object_unique_member(v: v, key: "input") {
                  JsonMemberFound { value: iv } =>
                    BlockRead { block: WireToolUseBlock { id: id, name: name, input: iv } }
                  JsonMemberAbsent => BlockUnreadable {
                    cause: join([
                      "the tool_use block calling '", name, "' carries no input member; refusing rather than ",
                      "dispatching that tool with its arguments removed",
                    ], ""),
                  }
                  JsonMemberDuplicated => BlockUnreadable {
                    cause: join(["the tool_use block calling '", name, "' carries input twice; which arguments the model meant is unknowable"], ""),
                  }
                  JsonMemberNotAnObject => BlockUnreadable {
                    cause: join(["the tool_use block calling '", name, "' is not a JSON object"], ""),
                  }
                }
            }
        }
      } else {
        BlockNotModelled
      }
  }
}

type HarnessBlocksRead
  = BlocksRead { blocks: List<HarnessWireBlock> }
  | BlocksUnreadable { cause: String }

// ONE FOLD FOR BOTH SHAPES, PARAMETERIZED BY THE PER-ELEMENT DECODER. The two wire shapes decode
// DIFFERENT elements -- a messages content block, a chat tool_call -- but they fold them the same
// way: skip what is not modelled, keep what read, and let the first refusal decide for the list.
// That is one concept, and it had been written twice (review 63807); the copy is what let the
// SEMANTICS drift too, since a later edit to either arm has no reason to reach the other.
//
// THE FOLD IS FAIL-CLOSED ACROSS THE WHOLE LIST: one unreadable element makes the response
// unreadable, because a partially decoded content list is exactly the fabricated-plausible-output
// shape -- it reads as a complete turn that happens to be shorter.
//
// AND IT IS LINEAR. Both predecessors recursed on `els.skip(n: 1)`, which COPIES the remainder in
// this realization, so decoding n elements copied n + (n-1) + ... elements -- quadratic in the
// block count for a fold that reads each element once. DESIGN section 6: a proven cost-shape defect
// is always fixed regardless of the realized n, because n is not a time-stable fact. Three linear
// passes over the decoded reads -- map, the first-refusal scan, flat_map -- replace the recursion,
// and the only behaviour that changes is that a refused list still decodes its remaining elements
// before answering, which is work on the path that ends the turn.
fn harness_decode_each(els: List<JsonValue>, decode: fn(JsonValue) -> HarnessBlockRead) -> HarnessBlocksRead {
  let reads = map(els, e => decode(e))
  match fold(reads, init: none, f: (acc, r) =>
         match acc {
           Present { value: c } => Present { value: c }
           Absent =>
             match r {
               BlockUnreadable { cause: c } => Present { value: c }
               BlockNotModelled => none
               BlockRead { block: _ } => none
             }
         }) {
    Present { value: c } => BlocksUnreadable { cause: c }
    Absent =>
      BlocksRead { blocks: flat_map(reads, r =>
        match r {
          BlockRead { block: b } => [b]
          BlockNotModelled => []
          BlockUnreadable { cause: _ } => []
        }) }
  }
}

fn harness_decode_blocks(v: JsonValue) -> HarnessBlocksRead {
  match v {
    JsonArray { elements: els } => harness_decode_each(els: els, decode: e => harness_decode_block(v: e))
    // The wildcard here is over the VALUE's type, not over a lookup: duplicated and not-an-object
    // were decided by the lookup that produced this value and never reach it, so "not an array" is
    // the only fact left to state.
    _ => BlocksUnreadable { cause: "the response content member is not an array of content blocks" }
  }
}

// THE RESPONSE IS DECODED OR REFUSED, and every refusal names which member failed.
//
// The arms that matter are the ones a fabricating decoder would collapse: a body that is not JSON
// at all, a body that is JSON but carries no stop_reason, and a stop_reason whose lexeme this
// version does not know. All three are DIFFERENT failures with different remedies -- a transport
// problem, a schema disagreement, and an upstream that has grown a state we do not model -- and a
// decoder that answered `EndTurn` for any of them would report a completed turn for all three.
fn harness_decode_response(body: String) -> HarnessResponseRead {
  match parse_json_document(s: body) {
    JsonDocumentUnreadable { gap: g } =>
      HarnessResponseUnreadable {
        cause: join(["response body is not readable as JSON: ", json_document_gap_text(gap: g)], ""),
      }
    JsonDocumentParsed { value: doc } =>
      match harness_member_string(doc: doc, key: "stop_reason") {
        StringAbsent =>
          HarnessResponseUnreadable {
            cause: "response carries no string stop_reason member; the turn's terminal state is unknown",
          }
        StringNull =>
          HarnessResponseUnreadable { cause: harness_null_member_cause(subject: "the response", key: "stop_reason") }
        StringMalformed { cause: c } =>
          HarnessResponseUnreadable { cause: join(["the response stop_reason is unreadable: ", c], "") }
        StringRead { value: wire } =>
          match harness_decode_stop_reason(wire: wire) {
            StopReasonUnrecognized { wire: w } =>
              HarnessResponseUnreadable {
                cause: join([
                  "response carries an unrecognized stop_reason '", w,
                  "'; refusing rather than reading an unmodelled terminal state as completion",
                ], ""),
              }
            StopReasonRead { reason: r } =>
              match json_object_unique_member(v: doc, key: "content") {
                JsonMemberFound { value: c } =>
                  match harness_decode_blocks(v: c) {
                    BlocksUnreadable { cause: bc } => HarnessResponseUnreadable { cause: bc }
                    BlocksRead { blocks: bs } =>
                      HarnessResponseParsed {
                        blocks: bs,
                        stop_reason: r,
                        usage: harness_usage_read(doc: doc, input_key: "input_tokens", output_key: "output_tokens"),
                      }
                  }
                JsonMemberDuplicated => HarnessResponseUnreadable {
                  cause: harness_duplicate_member_cause(subject: "the response", key: "content"),
                }
                JsonMemberNotAnObject => HarnessResponseUnreadable {
                  cause: harness_not_an_object_cause(subject: "the response body", key: "content"),
                }
                JsonMemberAbsent => HarnessResponseUnreadable {
                  cause: "response carries no content member; what the model produced this round is unknown",
                }
              }
          }
      }
  }
}

// THE BACKEND ENDPOINT, cited rather than spelled.
//
// The address comes from the enrolled fleet endpoint row DCH-0 authored, the port from
// extdeps.ollama.api, and the path from the messages specification. Writing "192.168.1.225:11434"
// here would be three literals standing where three authorities already answer, and each would rot
// independently -- the address when the operator re-reserves it, which has already happened once
// when both units moved to the wireless SSID.
// THE WIRE SHAPE IS A REALIZATION OF ONE INTERFACE. Both shapes decode to the same HarnessWireBlock
// list and the same HarnessResponseRead, and both are encoded from them; what differs is transport
// vocabulary. The choice is a config fact because it is a property of the serving fleet, measured:
// on this fleet vLLM's Anthropic-shaped endpoint accepts a replayed thinking block and renders none
// of it, while the chat completions shape renders a replayed reasoning_content (extdeps.deepseek
// deepseek_v4_replay_rendering_*). A tool-using harness that wants the encoder's retention rule
// therefore speaks the chat shape here.
type HarnessWireShape = AnthropicMessagesShape | OpenAiChatCompletionsShape

data harness_messages_path: String = "/v1/messages"
// The path extdeps.llm.openai_rest ChatCompletion declares; spelled here as the route this harness
// posts to, cited rather than derived because that operation's path lives inside its transport row.
data harness_chat_completions_path: String = "/v1/chat/completions"

fn harness_backend_path(shape: HarnessWireShape) -> String {
  match shape {
    AnthropicMessagesShape => harness_messages_path
    OpenAiChatCompletionsShape => harness_chat_completions_path
  }
}

fn harness_backend_url_on_port(address: String, port: Int, shape: HarnessWireShape) -> String {
  join(["http://", address, ":", to_string(value: port), harness_backend_path(shape: shape)], "")
}

fn harness_backend_url(address: String, shape: HarnessWireShape) -> String {
  harness_backend_url_on_port(address: address, port: ollama_default_port, shape: shape)
}



// THE SECOND PAIR, AS ADDRESSES RATHER THAN HOST IDENTITIES, and the distinction is the whole
// reason these rows are here instead of in fleet_intent_network.
//
// FOUR HOSTS WERE SURVEYED ON 2026-09-02 AND NO TWO ARE ALIKE. Recorded as a measurement because
// the differences are what select the row below, and every one of them is invisible to the corpus:
//
//   .232  reachable, ZERO models -- /api/tags returns an empty list, /v1/models a null data member
//   .233  held the desired model, then went unreachable within the same minute
//   .225  unreachable (operator: out of memory, expected to return)
//   .226  reachable, eight models including the desired one, stable across the whole session
//
// TWO INDEPENDENT GAPS PRODUCE THAT TABLE, and neither is this module's to close.
//
// Residency (DCH-0b): spark_serving_desired_manifest governs exactly one member, so "which models
// this host holds" is representable nowhere. A harness choosing a backend from one authority and a
// model from another produces a pairing only the wire can refuse -- which is exactly what happened,
// as a not_found_error naming the model, on the first request to .232.
//
// Liveness: nothing observes whether a chosen backend is serving before it is chosen. The hosts
// that HOLD models are the ones dropping out, which is consistent with memory pressure under load
// rather than with configuration alone, so the failure is expected to recur rather than to have
// been a one-off.
//
// The row below therefore names the host measured to be both reachable and holding the model, and
// says outright that this is an observation with a shelf life. Selecting a backend from observed
// serving standing is DCH-0's subject and dissolves all of these functions when it lands.
//
// WHY NOT AN ENDPOINT ROW BESIDE srv5/srv6. In gunbc.fleet_intent_network, membership in
// `endpoints` IS enrollment -- that module says so about itself -- and enrolling srv7/srv8 needs a
// fact that does not exist in data: WHICH unit takes which slot. The second pair is described in
// prose there as spark-c2b1 at .232 and spark-ac79 at .233, but unlike srv5/srv6 -- whose
// assignment was decided under an explicit operator delegation on a recorded ascending-address
// basis, precisely so the tie-break would be attributable -- no such decision exists for this pair.
// Authoring `srv7_host_lan_endpoint` would therefore invent the mapping, which is the exact failure
// that module's own note records a lane committing once already.
//
// So these rows name ADDRESSES and assert nothing about identity. That is also the more honest
// layer: which backend the harness sends inference to is sense TWO of "provider" in
// gunbc.provider_interface_binding's homonym note -- a backend selection, not a fact about fleet
// membership -- and the earlier srv5/srv6 helpers above borrow a fleet row for it only because one
// happened to exist. Selecting a backend from OBSERVED serving standing is DCH-0's subject and
// dissolves all four of these functions when it lands.




// THE HARNESS TALKS TO THE ENGINE DIRECTLY. OPERATOR RULING 2026-09-04: gunbc must not depend on
// ctrl's session-dashboard router (192.168.1.188:3738), which is co-tenanted with that dashboard's
// process and closed every in-flight request on each rollout restart (curl exit 52; five runs lost
// in one morning, the long Think Max steps preferentially). There is nothing to route: one model,
// served by two vLLM replicas that each answer the OpenAI surface on port 30000, measured
// 2026-09-04 (/v1/models 200 on both, advertising harness_engine_model). A replica is chosen per
// worker from a seed (the worktree path) so concurrent attempts spread across both machines
// without a process in the middle; a transport refusal stays a typed turn failure, never a widen.
// THE ROSTER IS DERIVED, NOT AUTHORED: one replica per serving pair, at the pair's HEAD, because the
// vLLM front door of a TP=2 pair answers on its head unit only. Which unit is a pair's head is the
// attributable row `gunbc.spark.pair_serving_desired` `spark_pair_serving_head`, and the address is
// the fleet topology's LAN endpoint for that host (`gunbc.fleet_intent_network` `host_lan_address`).
// A head with no LAN endpoint row makes the roster UNRESOLVED, which the backend observer refuses on
// naming the host -- never a shorter list. History, because it is the reason this is a derivation:
// the row was `[srv6.address, "192.168.1.232"]`, .232 being srv7 as the first pair's front door;
// the heads moved to srv6 and srv9, nothing observed the literal, and a dispatch on 2026-09-05
// refused against a dead address while both heads served. NEXT MOVE, deliberately not here: the LAN
// answer is still a locality choice made by this module. The fabric owes a locus-to-locus resolution
// (dispatching host -> head's front door), the same relation `gunbc.fleet_ssh_locus`
// `fleet_locus_ssh_target` computes for ssh; when it exists this fn asks it and stops naming Lan.
data harness_engine_port: Int = 30000

type HarnessReplicaRoster
  = HarnessReplicasResolved { addresses: List<String> }
  | HarnessReplicasUnresolved { hosts: List<HostIdentity> }

fn harness_engine_replica_roster() -> HarnessReplicaRoster {
  let heads = map(spark_pair_serving_groups, g => spark_pair_serving_head(group: g))
  let unresolved = filter(heads, h => match host_lan_address(host: h) { Present { value: _ } => false  Absent => true })
  if count(unresolved) > 0 {
    HarnessReplicasUnresolved { hosts: unresolved }
  } else {
    HarnessReplicasResolved { addresses: flat_map(heads, h => match host_lan_address(host: h) { Present { value: a } => [a as String]  Absent => [] }) }
  }
}

fn harness_backend_url_for_address(shape: HarnessWireShape, address: String) -> String {
  harness_backend_url_on_port(address: address, port: harness_engine_port, shape: shape)
}


// THE SERVING STACK THE OPERATOR ACTUALLY RUNS FOR THIS WORK, which is not the one every row above
// assumes, and the difference is worth stating because it invalidated four probes before it was
// found.
//
// Everything above reaches an OLLAMA daemon on its default port and asks Ollama-shaped questions.
// .232 and .233 answer there too -- same version string, same 200s -- with an EMPTY store, because
// on those two hosts Ollama is not what serves: a llama-server pair sits behind a router on
// .188:3738, holding deepseek-v4-flash split across both machines. So the Ollama surface on those
// hosts is live, truthful and completely beside the point, which is the worst shape a wrong probe
// can have -- it answers, so nothing refuses, and the emptiness reads as "no models" rather than as
// "you are asking the wrong daemon".
//
// TWO CONSEQUENCES FOR THE MODEL. The router's model identity is deepseek-v4-flash:iq3s-split and
// it is NOT gunbc.spark.serving_desired's desired model: that authority governs the Ollama serving
// unit's single converged member, and this is a different serving realization with its own
// identity, its own residency and its own lifecycle. Citing the spark desired row here would be a
// meaning fork -- one name over two serving stacks -- so the router's model is declared beside the
// router, and the earlier ollama_model_ref_wire citation stays correct for the surface it names.
//
// The port is a parameter now for the same reason the address was: 11434 is Ollama's, 3738 is this
// router's, and a helper that could only spell one of them made the second stack unreachable
// without an edit rather than a row.
//
// Measured 2026-09-03: /v1/models advertises exactly this id, /props answers 200, and a
// /v1/messages request returns Anthropic-shaped content blocks -- a thinking block, a stop_reason
// and a usage object -- so this codec speaks to it unchanged. That last fact is what DCH-1's
// shared-standard modelling bought: a second implementation of the same wire reused the decoder
// with no second decoder written.

// WHICH SERVING UNIT THE HARNESS TALKS TO. This row replaced a bare model STRING, and the
// replacement is the point: the string was one of three independent spellings of one model identity
// (this row, the pair's observed served_model_name, and the llama.cpp router's observed alias), so
// a model change had to be remembered in three places and could be forgotten in two. The unit is now
// the single thing chosen, and the model id is DERIVED from it through the seam, which in turn
// derives it from the model's own upstream authority.
//
// THE ORDINARY HARNESS TALKS TO DEEPSEEK, BECAUSE THAT IS WHAT THE PRODUCTION ROUTE SERVES. This row
// briefly read Glm53FlashOnVllm while the pair route this harness reaches was restored to DeepSeek --
// so the global selector carried a canary experiment, and every ordinary harness action would have
// encoded GLM's reasoning kwargs, effort key and tool parser into requests aimed at an endpoint
// serving DeepSeek from an image measured not to register GLM at all.
//
// A CANARY IS NOT A DEFAULT. The GLM arm is reached through gunbc.spark.glm_canary_converge, which
// names its own host, port and alias together; a caller that wants it selects that binding explicitly
// rather than inheriting it from a row every other caller also reads. Making the one global selector
// carry an experiment is how an experiment becomes production without anyone deciding it should.
data harness_serving_unit: HarnessServingUnit = DeepseekV4FlashOnVllm

data harness_engine_model: String = harness_unit_model_id(unit: harness_serving_unit) as String

// THE ROUTER'S WINDOW IS DECLARED BESIDE THE ROUTER, for the reason the model directly above it is.
// gunbc.spark.serving_desired owns spark_serving_desired_context_length, and that row is the OLLAMA
// roster ceiling -- the value the Ollama serving units are launched with. The harness does not talk
// to those units; it talks to the llama-server pair behind this router. Binding the harness window
// to the Ollama row would be the same meaning fork this module already refused for the model: one
// name over two serving stacks.
//
// THE TWO NUMBERS ARE EQUAL TODAY AND THAT IS NOT A REASON TO SHARE A ROW. Both read 1048576, which
// is exactly what makes the fork cheap to write and expensive to find -- a derivation from the
// wrong authority is invisible while the values agree and silently wrong the moment they do not.
// The engine's cap is being changed independently of the Ollama roster, so they are free to diverge
// on any restart.
//
// WHAT THIS IS NOT: a claim that 1M is verified on this router. It is the admission ceiling the
// harness will not exceed, which is a different fact from a window a request has completed at. The
// harness refuses at this bound rather than letting the engine reject a request mid-run with the
// turn's work already spent.
//
// DISSOLVES ON: fabric serving. When the pair is served through the compute fabric rather than a
// hand-run router, the window becomes a property of the served work contract and this row's
// consumer moves with it -- the sparks are not stable enough for that today, which is why the
// router exists at all.
// THE ENGINE'S ADMISSION CAP AND THE HARNESS'S WORKING WINDOW ARE TWO NUMBERS, NOT ONE, and this
// row is the second. The serving side admits up to 1,048,576 tokens deliberately; that ceiling is a
// LIMIT, not an allowance, and a client that adopts it as its working window is not respecting the
// cap -- it is spending the whole pool. The KV pool holds roughly 4.1M tokens, so four sessions at
// the cap exhaust it exactly and every further request queues on capacity rather than on compute.
// That queueing is the pathology behind this deployment's slow-token measurements: rounds whose
// duration tracked router occupancy instead of request size, a 17 KB request taking 480s while a
// 50 KB one took 60s.
//
// 200k IS THE OPERATOR'S NUMBER (router owner, 2026-09-04), from a stated 100k-250k band. It is not
// derived here from pool-divided-by-slots, and deliberately so: that arithmetic would give ~1M and
// would be wrong, because the pool is shared with everything else the engine is doing and the
// divisor is not a constant this module can see.
// THE ENGINE'S ADMISSION CEILING, carried so the working window above can be checked against it.
// This is the number the serving side actually enforces; the row above is what this client chooses
// to spend. They are recorded separately because they answer different questions and move for
// different reasons -- the cap moves when the engine is reconfigured, the window moves when this
// harness decides how much of a shared pool it is entitled to. A single row would have made the
// client's choice indistinguishable from the server's limit, which is precisely the confusion that
// put 1,048,576 in the window field in the first place.
data harness_engine_admission_cap: TokenCount = token_count(count: 1048576)

data harness_engine_context_window: TokenCount = token_count(count: 200000)

// THE CHAT COMPLETIONS DECODER, to the same carrier the messages decoder fills. finish_reason maps
// onto the stop vocabulary the harness already consumes: stop is an end of turn, tool_calls is a
// tool use, length is the token ceiling, content_filter is a refusal. Reasoning is read from the
// guide's field and vLLM's alias; content may still carry the inline closer when the server has no
// reasoning parser, and the turn loop's split handles that after decode exactly as it does for the
// messages shape. Tool-call arguments arrive as a JSON STRING and are parsed here into the same
// JsonValue input the messages shape delivers, so the tool dispatcher sees one shape.
fn harness_chat_finish_reason(wire: String) -> HarnessStopReasonRead {
  if wire == "stop" {
    StopReasonRead { reason: EndTurn }
  } else if wire == "tool_calls" {
    StopReasonRead { reason: ToolUse }
  } else if wire == "length" {
    StopReasonRead { reason: MaxTokens }
  } else if wire == "content_filter" {
    StopReasonRead { reason: Refusal }
  } else {
    StopReasonUnrecognized { wire: wire }
  }
}

// THE CHAT SHAPE'S TOOL CALL CARRIES THE SAME THREE OBLIGATIONS AS THE MESSAGES SHAPE'S, and its
// predecessor fabricated all three.
//
// The id defaulted to the EMPTY STRING. That id is what gunbc.harness.harness_turn writes into the
// tool_result message so the server can join a result to the call it answers; an empty one is not a
// missing id on the wire, it is a well-formed id that matches nothing, so the model is handed the
// output of a command it cannot attribute -- and when two calls arrive in one round they both carry
// it and become indistinguishable.
//
// The arguments defaulted to an EMPTY OBJECT twice over: once when the member was absent and once
// when it was present but not parseable as JSON. The second is the worse of the pair, because
// malformed arguments are a thing a model actually produces under sampling -- a truncated object, a
// trailing comma -- and answering `{}` converts "the model emitted a call this codec could not
// read" into "the model called this tool with no arguments" -- and hands that invented call to the
// dispatcher, which on run_command refuses it as ToolInputMemberMissing for a member the model
// actually sent, spending the round and reporting the codec's fault as the model's.
fn harness_chat_tool_call_block(v: JsonValue) -> HarnessBlockRead {
  match json_object_unique_member(v: v, key: "function") {
    JsonMemberFound { value: f } =>
      match harness_member_string(doc: f, key: "name") {
        StringAbsent => BlockUnreadable { cause: "a chat tool_call carries no string function.name member" }
        StringNull => BlockUnreadable { cause: harness_null_member_cause(subject: "a chat tool_call", key: "function.name") }
        StringMalformed { cause: c } => BlockUnreadable { cause: join(["a chat tool_call's function.name is unreadable: ", c], "") }
        StringRead { value: name } =>
          match harness_member_string(doc: v, key: "id") {
            StringAbsent => BlockUnreadable {
              cause: join([
                "the chat tool_call for '", name, "' carries no string id member; its result could not ",
                "be addressed back to the call",
              ], ""),
            }
            StringNull => BlockUnreadable {
              cause: harness_null_member_cause(subject: join(["the chat tool_call for '", name, "'"], ""), key: "id"),
            }
            StringMalformed { cause: c } =>
              BlockUnreadable { cause: join(["the chat tool_call for '", name, "' has an unreadable id: ", c], "") }
            StringRead { value: id } =>
              match harness_member_string(doc: f, key: "arguments") {
                StringAbsent => BlockUnreadable {
                  cause: join([
                    "the chat tool_call for '", name, "' carries no arguments member; refusing rather ",
                    "than dispatching that tool with its arguments removed",
                  ], ""),
                }
                StringNull => BlockUnreadable {
                  cause: harness_null_member_cause(subject: join(["the chat tool_call for '", name, "'"], ""), key: "arguments"),
                }
                StringMalformed { cause: c } =>
                  BlockUnreadable { cause: join(["the chat tool_call for '", name, "' has unreadable arguments: ", c], "") }
                StringRead { value: args } =>
                  match parse_json_document(s: args) {
                    JsonDocumentParsed { value: a } =>
                      BlockRead { block: WireToolUseBlock { id: id, name: name, input: a } }
                    JsonDocumentUnreadable { gap: g } => BlockUnreadable {
                      cause: join([
                        "the chat tool_call for '", name, "' carries arguments that are not a JSON document: ",
                        json_document_gap_text(gap: g),
                      ], ""),
                    }
                  }
              }
          }
      }
    JsonMemberDuplicated =>
      BlockUnreadable { cause: harness_duplicate_member_cause(subject: "a chat tool_call", key: "function") }
    JsonMemberNotAnObject =>
      BlockUnreadable { cause: harness_not_an_object_cause(subject: "a chat tool_call", key: "function") }
    JsonMemberAbsent => BlockUnreadable { cause: "a chat tool_call carries no function member" }
  }
}

// THE THREE PARTS OF A CHAT MESSAGE ARE READ INDEPENDENTLY AND ANY ONE OF THEM CAN REFUSE.
//
// Reasoning and content are legitimately ABSENT -- a round may be all tool calls, or all prose --
// so absence takes the empty arm. Neither may be MALFORMED silently: a duplicated content member
// would drop the assistant's message, and a duplicated tool_calls member would drop the model's
// commands and leave a response that reads as a completed turn with nothing in it. That last one
// is the sharpest arm in this function and the reason it is written out rather than closed with a
// wildcard: zero tool calls is what `harness_turn_round` reads as "the model stopped talking", so
// it writes `turn.completed`, returns TurnProviderStopped, and the process exits ZERO. A member
// this codec cannot read uniquely must never reach that arm.
fn harness_chat_message_blocks(unit: HarnessServingUnit, msg: JsonValue) -> HarnessBlocksRead {
  match harness_chat_message_reasoning(unit: unit, msg: msg) {
    BlocksUnreadable { cause: c } => BlocksUnreadable { cause: c }
    BlocksRead { blocks: reasoning } =>
      match harness_chat_message_text(msg: msg) {
        BlocksUnreadable { cause: c } => BlocksUnreadable { cause: c }
        BlocksRead { blocks: text } =>
          match harness_chat_message_calls(msg: msg) {
            BlocksUnreadable { cause: c } => BlocksUnreadable { cause: c }
            BlocksRead { blocks: calls } => BlocksRead { blocks: concat(concat(reasoning, text), calls) }
          }
      }
  }
}

// REASONING IS NULLABLE ON THIS SHAPE, AND A NULL PRIMARY STILL CONSULTS THE ALIASES. The upstream
// schema types the reasoning field as an optional string, and a serving build that populates the
// alias spelling while leaving the primary explicitly null is a shape this decoder has to read: the
// two spellings are one fact, so a null on one of them is not yet an answer about the fact. Only
// when the alias fold also reports null or absence is there no reasoning to carry.
fn harness_chat_message_reasoning(unit: HarnessServingUnit, msg: JsonValue) -> HarnessBlocksRead {
  match harness_member_string(doc: msg, key: harness_unit_reasoning_field(unit: unit) as String) {
    StringRead { value: r } => BlocksRead { blocks: [WireThinkingBlock { thinking: r }] }
    StringMalformed { cause: c } =>
      BlocksUnreadable { cause: join(["the chat message's reasoning field is unreadable: ", c], "") }
    StringNull => harness_chat_message_reasoning_alias(unit: unit, msg: msg)
    StringAbsent => harness_chat_message_reasoning_alias(unit: unit, msg: msg)
  }
}

fn harness_chat_message_reasoning_alias(unit: HarnessServingUnit, msg: JsonValue) -> HarnessBlocksRead {
  match harness_first_member_string(doc: msg, keys: harness_unit_reasoning_field_aliases(unit: unit)) {
    StringRead { value: r } =>
      BlocksRead { blocks: if r == "" { [] } else { [WireThinkingBlock { thinking: r }] } }
    StringMalformed { cause: c } =>
      BlocksUnreadable { cause: join(["the chat message's reasoning alias is unreadable: ", c], "") }
    StringNull => BlocksRead { blocks: [] }
    StringAbsent => BlocksRead { blocks: [] }
  }
}

// CONTENT IS NULLABLE ON THIS SHAPE AND NULL IS NOT A FAULT. A tool-only round is served as
// `"content": null` beside a populated `tool_calls`, so refusing here would discard the model's
// commands over a member the schema explicitly permits to be null -- the decoder's own defect
// wearing the costume of a wire fault. Present-null and absent both mean the same thing for THIS
// member, no assistant text, and they are written as separate arms rather than one wildcard because
// they are different wire facts and a later member may need to tell them apart. A duplicated or
// wrong-typed content member still refuses: those are unknowable, not empty.
fn harness_chat_message_text(msg: JsonValue) -> HarnessBlocksRead {
  match harness_member_string(doc: msg, key: "content") {
    StringRead { value: c } => BlocksRead { blocks: if c == "" { [] } else { [WireTextBlock { text: c }] } }
    StringNull => BlocksRead { blocks: [] }
    StringAbsent => BlocksRead { blocks: [] }
    StringMalformed { cause: c } =>
      BlocksUnreadable { cause: join(["the chat message's content is unreadable: ", c], "") }
  }
}

fn harness_chat_message_calls(msg: JsonValue) -> HarnessBlocksRead {
  match json_object_unique_member(v: msg, key: "tool_calls") {
    JsonMemberFound { value: tc } =>
      match tc {
        JsonArray { elements: es } =>
          harness_decode_each(els: es, decode: e => harness_chat_tool_call_block(v: e))
        // Over the value's type, not the lookup: the three non-found outcomes are the arms below.
        _ => BlocksUnreadable { cause: "the chat message tool_calls member is not an array" }
      }
    JsonMemberAbsent => BlocksRead { blocks: [] }
    JsonMemberDuplicated => BlocksUnreadable {
      cause: "the chat message carries tool_calls more than once; refusing rather than reporting a round with no tool calls, which reads as a completed turn",
    }
    JsonMemberNotAnObject => BlocksUnreadable { cause: "the chat completion message is not a JSON object" }
  }
}

fn harness_decode_chat_completion(unit: HarnessServingUnit, body: String) -> HarnessResponseRead {
  match parse_json_document(s: body) {
    JsonDocumentUnreadable { gap: g } =>
      HarnessResponseUnreadable { cause: join(["response body is not a JSON document: ", json_document_gap_text(gap: g)], "") }
    JsonDocumentParsed { value: doc } =>
      match json_object_unique_member(v: doc, key: "choices") {
        JsonMemberDuplicated => HarnessResponseUnreadable {
          cause: harness_duplicate_member_cause(subject: "the chat completion", key: "choices"),
        }
        JsonMemberNotAnObject => HarnessResponseUnreadable {
          cause: harness_not_an_object_cause(subject: "the chat completion body", key: "choices"),
        }
        JsonMemberAbsent => HarnessResponseUnreadable { cause: "chat completion carries no choices array" }
        JsonMemberFound { value: cv } =>
          harness_decode_chat_choices(unit: unit, doc: doc, choices_value: cv)
      }
  }
}

// THE CHOICES MEMBER IS FOUND, THEN IT IS AN ARRAY, AND THOSE ARE TWO FACTS. Reading them in one
// nested pattern left the not-an-array case to the lookup's wildcard, where "choices is a string"
// came out as "carries no choices array" -- true of nothing that happened.
fn harness_decode_chat_choices(unit: HarnessServingUnit, doc: JsonValue, choices_value: JsonValue) -> HarnessResponseRead {
  match choices_value {
    JsonArray { elements: choices } =>
          match choices.first() {
            Absent => HarnessResponseUnreadable { cause: "chat completion carries no choices" }
            Present { value: choice } =>
              match harness_member_string(doc: choice, key: "finish_reason") {
                StringAbsent => HarnessResponseUnreadable { cause: "chat completion choice carries no finish_reason" }
                StringNull => HarnessResponseUnreadable {
                  cause: harness_null_member_cause(subject: "the chat completion choice", key: "finish_reason"),
                }
                StringMalformed { cause: c } =>
                  HarnessResponseUnreadable { cause: join(["the chat completion finish_reason is unreadable: ", c], "") }
                StringRead { value: fr } =>
                  match harness_chat_finish_reason(wire: fr) {
                    StopReasonUnrecognized { wire: w } =>
                      HarnessResponseUnreadable { cause: join(["chat completion carries an unrecognized finish_reason '", w, "'"], "") }
                    StopReasonRead { reason: r } =>
                      match json_object_unique_member(v: choice, key: "message") {
                        JsonMemberFound { value: m } =>
                          match harness_chat_message_blocks(unit: unit, msg: m) {
                            BlocksUnreadable { cause: bc } => HarnessResponseUnreadable { cause: bc }
                            BlocksRead { blocks: bs } =>
                              HarnessResponseParsed {
                                blocks: bs,
                                stop_reason: r,
                                usage: harness_usage_read(doc: doc, input_key: "prompt_tokens", output_key: "completion_tokens"),
                              }
                          }
                        JsonMemberDuplicated => HarnessResponseUnreadable {
                          cause: harness_duplicate_member_cause(subject: "the chat completion choice", key: "message"),
                        }
                        JsonMemberNotAnObject => HarnessResponseUnreadable {
                          cause: harness_not_an_object_cause(subject: "the chat completion choice", key: "message"),
                        }
                        JsonMemberAbsent =>
                          HarnessResponseUnreadable { cause: "the chat completion choice carries no message member" }
                      }
                  }
              }
          }
    _ => HarnessResponseUnreadable {
      cause: "the chat completion's choices member is not an array; what the model returned this round is unknown",
    }
  }
}

fn harness_decode_for_shape(unit: HarnessServingUnit, shape: HarnessWireShape, body: String) -> HarnessResponseRead {
  match shape {
    AnthropicMessagesShape => harness_decode_response(body: body)
    OpenAiChatCompletionsShape => harness_decode_chat_completion(unit: unit, body: body)
  }
}

// THE ALIAS FOLD. A unit may expose the same reasoning text under a second spelling -- vLLM's
// "reasoning" beside the guide's reasoning_content -- and a unit may expose none. Folding a LIST
// rather than branching on an empty sentinel keeps "this unit has no alias" as an empty list, which
// is the state itself rather than a string standing in for it. A spelling that is present and NULL
// ends the scan rather than continuing it: null is the unit answering about that spelling, and the
// caller decides what the answer means, which for reasoning is no thinking block.
//
// THIS ONE RECURSES ON `keys.skip` AND STAYS, unlike the two block folds (review 63807): the list
// is a unit's declared alias spellings -- one, today -- so the copy is bounded by a constant the
// corpus authors rather than by anything on the wire. Said out loud because a reader who has just
// seen the block folds linearized will ask, and because the exemption is the bound, not the size:
// if a unit ever declared aliases by the dozen this would be the same defect.
fn harness_first_member_string(doc: JsonValue, keys: List<NonEmptyStr>) -> HarnessStringRead {
  match keys.first() {
    Absent => StringAbsent
    Present { value: k } =>
      match harness_member_string(doc: doc, key: k as String) {
        StringRead { value: v } => StringRead { value: v }
        StringMalformed { cause: c } => StringMalformed { cause: c }
        StringNull => StringNull
        StringAbsent => harness_first_member_string(doc: doc, keys: keys.skip(n: 1))
      }
  }
}
