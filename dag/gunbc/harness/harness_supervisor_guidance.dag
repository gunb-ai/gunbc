module gunbc.harness.harness_supervisor_guidance

import std.types { String, Int }
import gunbc.roadmap.roadmap_supervisor {
  SupervisorVerdictReceipt, VerdictContinue,
  supervisor_verdict_text,
}

// THE SUPERVISOR'S GUIDANCE CONTRACT (gunbc.plans.harness_session_lifecycle, requirement 2): a
// bounded turn on the worker's own seat, convened by the alignment check while the worker's session
// waits, with one typed output -- the verdict receipt. It reads what the check read and the check's
// own judgement, decides the next action of the session, and does not continue the implementation.
// Every fact in the brief is PROJECTED -- the chain, the check's verdict, the observation, the
// verdict's own schema -- and never hand-copied, so the brief follows the authorities it cites.

// THE VERDICT SHAPE THE SESSION WRITES, emitted by the verdict's own codec with the adjudicated turn
// bound in -- so the example the supervisor copies is byte-for-byte what the session's reader
// accepts AND bound to this boundary. The placeholder route is Continue only because the example
// needs one route; the four route keys below carry the vocabulary.
fn supervisor_verdict_skeleton(adjudicated_turn: Int) -> String {
  supervisor_verdict_text(receipt: SupervisorVerdictReceipt {
    adjudicated_turn: adjudicated_turn,
    verdict: VerdictContinue { basis: "the evidence that the work should continue as it is" },
  })
}

fn supervisor_system_prompt_at(worktree: String, verdict_path: String) -> String {
  join([
    "You are the supervisor of one coding worker's session, convened by its alignment check, which needs a broader decision than a correction. ",
    "The worker's session is paused until you decide. Your one tool is run_command; it runs in ", worktree,
    ", the worker's worktree: read the diff, the files and the receipts there, but do not modify, create or delete anything in it, and do not continue the implementation yourself. ",
    "The session is complete only once ", verdict_path,
    " names your verdict in the declared schema: exactly one of continue, steer, plan-defect or stuck, bound to the turn you adjudicated.",
  ], "")
}

// THE BRIEF. The chain leads (what the work is for, at every level), the check's verdict follows
// (why you were convened), then the observation the check read, and the four routes close it as the
// ONLY verdicts, each an action the paused session carries out.
fn supervisor_brief_for(chain: String, check_verdict: String, observation: String, adjudicated_turn: Int) -> String {
  join([
    "THE ALIGNMENT CHAIN OF THE WORKER'S TASK:\n\n", chain, "\n\n",
    "THE ALIGNMENT CHECK AFTER TURN ", to_string(value: adjudicated_turn), " RETURNED: ", check_verdict, "\n\n",
    "WHAT THE CHECK OBSERVED OF THE WORKER'S LATEST ROUND:\n\n", observation, "\n\n",
    "Your verdict is one of FOUR routes and no fifth, written in this exact shape (copy it and fill route and statement): ",
    supervisor_verdict_skeleton(adjudicated_turn: adjudicated_turn),
    "\n- continue: the check was too strict; the session continues unchanged with a renewed round, on the evidence you state.\n",
    "- steer: the work can be brought back; the statement is ONE direction, sent to the worker verbatim as its next message, so write it as an instruction to the worker.\n",
    "- plan-defect: the brief or plan sent the worker wrong; the statement names the defect, the session stops, and the route goes to the node's owner -- the worker never continues against a known-bad plan.\n",
    "- stuck: the task itself cannot advance; the statement is the typed cause and the session stops.\n",
    "The route binds the turn you adjudicated: a verdict for any other turn decides nothing.\n",
  ], "")
}
