      harness_turn_exit_released(outcome: outcome, seat: seat_release)
    }
  }
}

// AND THE REPORTING FORM TAKES IT TOO. Two entries reached one turn; a seat on one of them is a wall
// with a door beside it.
fn harness_probe_report() -> String {
  let binding = harness_bind_seat(short_hostname: harness_executor_short_hostname(), class: BatchQualityTolerant, requirement: AnyAdmittedModel, shape: harness_default_wire_shape, actor: "probe-report" as NonEmptyStr, attempt: harness_probe_attempt(label: "probe-report"), policy: harness_seat_policy)
  match binding {
    HarnessSeatRefused { detail } => join(["harness probe refused before the turn: ", detail, "\n"], "")
    HarnessSeatPending { detail } => join(["harness probe is pending placement: ", detail, "\n"], "")
    HarnessSeatBound { url, grant: _, partition: _, ceiling: _, group_wire: _, launch: _, layout: _, model: bound_model, unit: bound_unit, class: _ } => {
      let outcome = harness_probe_outcome(backend_url: url, model: bound_model, unit: bound_unit)
      let seat_release = harness_release_seat(binding: binding, reason: harness_outcome_label(outcome: outcome) as NonEmptyStr)
      join([
        "harness probe outcome: ", harness_outcome_label(outcome: outcome), "\n",
        harness_outcome_detail(outcome: outcome), "\n",
        "seat: ", harness_seat_release_wire(r: seat_release), "\n",
      ], "")
    }
  }
}
