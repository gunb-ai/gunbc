module gunbc.harness.harness_cli

import std.types { String, Bool, Int, List, FilePath, NonEmptyStr }
import std.measure { TokenCount, token_count, token_count_value, Second, second }
import std.process { ProcessExit, ExitSuccess, ExitFailure }
import gunbc.harness.harness_tool { HarnessToolEnvironment }
import gunbc.harness.harness_turn {
  HarnessTurnConfig, HarnessTurnOutcome,
  TurnProviderStopped, TurnStepBudgetExhausted, TurnTransportRefused,
  TurnResponseUnreadable, TurnRequestUnwritable,
  harness_run_turn, harness_outcome_label, harness_outcome_detail,
}
import gunbc.harness.harness_guidance { harness_guidance_prose, harness_worker_guidance, harness_probe_guidance }
import gunbc.harness.harness_wire {
  harness_router_backend_url, harness_router_model, harness_router_context_window,
}

// THE FIRST WET ENTRY FOR THE DEDICATED HARNESS. It exists to make DCH-2 provable by execution
// rather than by typecheck -- DESIGN section 5's specification-without-execution trap names exactly
// this artifact as the one that looks finished without running.

// The model is the SERVING desired value, not a literal. gunbc.spark.serving_desired is the single
// authority for which model these hosts are converged to hold, and a second spelling here would
// disagree with it the first time that row is amended -- which has already happened once, when the
// desired model moved to deepseek-v4-gguf:no-h3-stop.
// THE WIRE PROJECTION IS CITED, NOT REBUILT. The first wet run cast the OllamaModelRef straight to
// String and sent `OllamaModelRef { name: deepseek-v4-gguf, tag: no-h3-stop }` -- the record's
// rendering, not its wire form -- and the backend answered `invalid model name`. Building
// `name + ":" + tag` here instead would have worked and been the DESIGN section 3 violation:
// extdeps.ollama.api already owns how a model reference is spelled on the wire, and a second
// spelling drifts the moment upstream changes it. The refusal was cheap precisely because the
// backend carried a structured cause; that is the argument for keeping the body on a failed post.
fn harness_default_model() -> String {
  harness_router_model
}

// THE MACBOOK'S TOOL ENVIRONMENT. The timeout program is the GNU build, for the reason
// harness_timeout_kill_exit_code records: the 124 exit is what makes "the harness killed this"
// decidable, and BSD has no timeout at all.
data harness_macbook_timeout_program: FilePath = "/opt/homebrew/bin/gtimeout" as FilePath

data harness_macbook_working_directory: FilePath = "/Users/briansrls/gunbc" as FilePath

data harness_request_scratch_path: FilePath = "/tmp/gunbc-harness-request.json" as FilePath

data harness_probe_events_path: FilePath = "/tmp/gunbc-harness-probe-events.jsonl" as FilePath

data harness_default_duration_limit_seconds: Int = 120

data harness_default_step_budget: Int = 8

// THE OUTPUT BUDGET, DERIVED FROM WHAT THE MODEL ACTUALLY DECLARES -- which is that it declares no
// output ceiling at all. extdeps.deepseek.deepseek_v4 records the research: no primary source
// documents a maximum output for V4-Flash, and the GGUF carries no output or thinking key. What
// bounds output is the ENGINE, measured against the router: input plus output must fit the context,
// with no separate ceiling beneath it.
//
// SO THIS IS A POLICY ROW, NOT A CAPABILITY ROW, and it lives here rather than in extdeps for that
// reason. A deepseek_v4_max_output_tokens row would have attributed the serving engine's admission
// rule to the model, which is the authority substitution the corpus keeps catching.
//
// 64Ki IS CHOSEN AGAINST TWO MEASURED FACTS. The 2048 it replaces was chat-shaped and its cost is
// visible in the transcripts: a thinking model spent its whole allowance reasoning and emitted the
// same sentence twice rather than acting, and a heredoc carrying real file content does not fit in
// it -- a worker that cannot emit a file cannot write one. Against the other side, observed turns
// peak near 40k input tokens, so 64Ki of output sits far under the shared 1M window and cannot be
// the binding constraint. It is deliberately generous rather than tuned: nothing yet measures what
// a successful edit actually costs, and the honest reading of an unmeasured axis is headroom.
//
// DISSOLVES ON: a measured distribution of output tokens across attempts that COMPLETE a task, at
// which point this is derived from that distribution instead of chosen against a ceiling.
// WHAT ONE RESPONSE MAY GENERATE. It was 65,536, raised earlier from 2,048 on an instruction to use
// the maximum the model allows -- which was the wrong reading of "allows": the engine ADMITS that
// many, it does not produce them quickly. vLLM's KV cache is paged and commits blocks per token
// actually generated, so a large ceiling reserves nothing; the cost is entirely in the tail. At the
// measured decode floor below, 65,536 tokens is roughly forty-five minutes of generation, so one
// legitimate long answer exceeded any deadline this harness could carry -- which is a far better
// explanation of the observed hangs than router state was.
data harness_default_max_tokens: Int = token_count_value(t: token_count(count: 8192))

// THE SLOWEST DECODE THIS DEPLOYMENT IS EXPECTED TO SUSTAIN, in tokens per second. It is a declared
// policy floor rather than a measurement of any one run: observed rates here span 2.4 tok/s under
// contention to 16.59 on the fastest rounds, and the router reports ~40 tok/s serving four to five
// concurrent sessions. The floor is set at 24 because a deadline derived from an optimistic rate
// kills healthy generations, and one derived from the worst contended reading would never fire.
data harness_decode_floor_tokens_per_second: Int = 24

// TIME TO FIRST TOKEN IS NOT DECODE TIME, so it is a separate term. A 200k working window prefills
// at the rates this deployment measured (up to ~1800 tok/s once fixed overhead amortizes), which is
// on the order of two minutes; 300s carries that with margin for a cold or contended round.
data harness_request_prefill_allowance_seconds: Int = 300

// THE DEADLINE IS DERIVED, NOT AUTHORED BESIDE THE BUDGET IT MUST COVER. This is the repair for the
// exact defect the router owner identified: a flat 900s and a 65,536-token ceiling were two
// independent numbers, and nothing related them, so raising the token budget silently created a
// generation the deadline could not admit. Here the deadline is a FUNCTION of the budget, so the
// two cannot drift: change max_tokens and the deadline follows. A refusal now means the backend
// genuinely failed to sustain the declared floor, which is a real fault, rather than meaning the
// model was answering at a perfectly ordinary rate for longer than a hand-written constant allowed.
data harness_request_deadline: Second = second(
  count: (harness_default_max_tokens / harness_decode_floor_tokens_per_second)
    + harness_request_prefill_allowance_seconds,
)

data harness_default_system_prompt: String = harness_guidance_prose(rows: harness_probe_guidance())

fn harness_macbook_environment() -> HarnessToolEnvironment {
  HarnessToolEnvironment {
    working_directory: harness_macbook_working_directory,
    timeout_program: harness_macbook_timeout_program,
    duration_limit_seconds: harness_default_duration_limit_seconds,
  }
}

// THE WINDOW COMES FROM THE SURFACE THE HARNESS ACTUALLY POSTS TO. The first cut of this row read
// spark_serving_desired_context_length, which is the OLLAMA roster ceiling -- and the harness does
// not post to the Ollama units, it posts to the llama-server pair behind the router. That is the
// meaning fork gunbc.harness.harness_wire already refused for the MODEL ("one name over two serving
// stacks"), written again one field over.
//
// It was invisible because both rows read 1048576. A derivation from the wrong authority is exactly
// this cheap to write and this expensive to find: correct-looking while the values agree, silently
// wrong the moment an engine restart moves one of them. The engine's cap is being changed
// independently of the Ollama roster, so they are free to diverge on any boot.
//
// The binding stays at the CLI rather than inside the turn. harness_turn takes the budget as a
// field the way it takes the worktree, the timeout program and its two paths -- so the same loop
// runs against a different serving surface by being handed a different number, not by importing a
// different authority.
data harness_context_budget: TokenCount = harness_router_context_window

fn harness_macbook_config() -> HarnessTurnConfig {
  HarnessTurnConfig {
    backend_url: harness_router_backend_url(),
    model: harness_default_model(),
    max_tokens: harness_default_max_tokens,
    system_prompt: harness_default_system_prompt,
    request_scratch_path: harness_request_scratch_path,
    events_path: harness_probe_events_path,
    context_budget: harness_context_budget,
    request_deadline: harness_request_deadline,
    environment: harness_macbook_environment(),
  }
}

// THE PROBE PROMPT IS CHOSEN TO BE DISCRIMINATING, not to be easy. It cannot be answered from the
// model's own knowledge, so a turn that returns a plausible answer WITHOUT a tool round has failed
// the thing this run is testing -- which is the tool loop, not the model's fluency. The count is
// whatever the repository actually holds at run time; the property under test is that the harness
// posted, received a tool_use, executed it, posted the result back, and received a terminal.
data harness_probe_prompt: String = "How many files in the dag/gunbc/harness directory of this repository end in .dag? Use run_command to find out, then state the number."

fn harness_probe_outcome() -> HarnessTurnOutcome {
  harness_run_turn(
    config: harness_macbook_config(),
    prompt: harness_probe_prompt,
    step_budget: harness_default_step_budget,
  )
}

// A PROVIDER TERMINAL EXITS ZERO AND A HARNESS REFUSAL DOES NOT, and the exit code says which
// happened rather than whether the task succeeded. Nothing here inspects the assistant's text for
// correctness: that is external verification's subject, and a harness that graded its own worker's
// answer would be the same conflation DCH-2 forbids between a stop reason and a completed task.
fn harness_probe_cli() -> ProcessExit {
  let outcome = harness_probe_outcome()
  match outcome {
    TurnProviderStopped { wire_stop_reason: _, assistant_text: _, steps_taken: _, input_tokens: _, output_tokens: _ } =>
      ExitSuccess
    _ =>
      ExitFailure {
        code: 1,
        reason: join([
          harness_outcome_label(outcome: outcome), ": ", harness_outcome_detail(outcome: outcome),
        ], ""),
      }
  }
}

// THE WORKER ENTRY THE BELT SPAWNS. Its two facts arrive as named arguments rather than through the
// environment, because `gunbc run` has had --arg since the scm read landed and the belt's own
// annotation saying otherwise ("gunbc run --function cannot pass an argument (no --arg flag)") is
// stale -- measured against `gunbc run --help` on 2026-09-03, which lists it. That staleness is why
// belt_dispatch_node_cli reads its node id from GUNBC_BELT_NODE_ID; repairing that is not this
// lane's, but repeating the workaround here would propagate a dead constraint into new code.
//
// The working directory is the ATTEMPT WORKTREE, not the repository root, and that is the whole
// point of taking it as an argument: an attempt edits its own checkout, and a harness that ran its
// commands in the shared repo root would write outside the attempt's boundary while every receipt
// said otherwise.
// THE REQUEST BODY'S SCRATCH PATH IS PER ATTEMPT, NOT PER HOST, and it arrives as an argument for
// the same reason the worktree and the timeout program do: it is a fact about WHERE this attempt
// keeps its bytes, which the controller knows and the worker cannot derive.
//
// harness_request_scratch_path is a single fixed /tmp file, and every worker on a host writes it
// once per turn. That is invisible while exactly one worker runs and is silent corruption the
// moment two do -- one worker's request body overwritten by another's between the write and the
// POST that reads it back. Nothing would refuse; the model would simply answer the wrong prompt.
//
// Deriving it from the attempt's own state directory rather than from a host-global temp root also
// makes the location a PARAMETER rather than an assumption, which is the property a distributed
// harness needs: an attempt that runs elsewhere carries its scratch with it instead of contending
// for one host's /tmp.
fn harness_worker_config(
  worktree: FilePath,
  timeout_program: FilePath,
  request_scratch_path: FilePath,
  events_path: FilePath,
) -> HarnessTurnConfig {
  HarnessTurnConfig {
    backend_url: harness_router_backend_url(),
    model: harness_default_model(),
    max_tokens: harness_default_max_tokens,
    system_prompt: harness_worker_system_prompt,
    request_scratch_path: request_scratch_path,
    events_path: events_path,
    context_budget: harness_context_budget,
    request_deadline: harness_request_deadline,
    environment: HarnessToolEnvironment {
      working_directory: worktree,
      timeout_program: timeout_program,
      duration_limit_seconds: harness_default_duration_limit_seconds,
    },
  }
}

data harness_worker_system_prompt: String = harness_guidance_prose(rows: harness_worker_guidance())

data harness_worker_step_budget: Int = 24

// EXIT SAYS WHETHER THE HARNESS COMPLETED A TURN, NOT WHETHER THE TASK WAS DONE. A provider
// terminal exits zero; every harness refusal exits non-zero with its typed cause. Whether the WORK
// satisfies the node is decided by the belt's pinned verification against the attempt head, which
// is the separation DCH-2 requires and the reason there is nothing here that inspects the diff.
fn harness_worker_cli(
  worktree: String,
  brief: String,
  timeout_program: String,
  request_scratch_path: String,
  events_path: String,
) -> ProcessExit {
  let outcome = harness_run_turn(
    config: harness_worker_config(
      worktree: worktree as FilePath,
      timeout_program: timeout_program as FilePath,
      request_scratch_path: request_scratch_path as FilePath,
      events_path: events_path as FilePath,
    ),
    prompt: brief,
    step_budget: harness_worker_step_budget,
  )
  match outcome {
    TurnProviderStopped { wire_stop_reason: _, assistant_text: _, steps_taken: _, input_tokens: _, output_tokens: _ } =>
      ExitSuccess
    _ =>
      ExitFailure {
        code: 1,
        reason: join([
          harness_outcome_label(outcome: outcome), ": ", harness_outcome_detail(outcome: outcome),
        ], ""),
      }
  }
}

fn harness_probe_report() -> String {
  let outcome = harness_probe_outcome()
  join([
    "harness probe outcome: ", harness_outcome_label(outcome: outcome), "\n",
    harness_outcome_detail(outcome: outcome), "\n",
  ], "")
}
