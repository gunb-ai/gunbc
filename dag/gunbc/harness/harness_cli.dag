fn harness_auditor_cli(
  worktree: String,
  brief: String,
  timeout_program: String,
  request_scratch_path: String,
  events_path: String,
  verdict_dir: String,
  verdict_name: String,
) -> ProcessExit {
  let verdict_path = join([verdict_dir, "/", verdict_name], "")
  let binding = harness_bind_seat(short_hostname: harness_executor_short_hostname(), class: BatchQualityTolerant, requirement: AnyAdmittedModel, shape: harness_default_wire_shape, actor: join(["auditor:", verdict_path], "") as NonEmptyStr, attempt: join(["auditor:", verdict_path], "") as NonEmptyStr, policy: harness_seat_policy)
  match binding {
    HarnessSeatRefused { detail } => harness_backend_refusal_exit(detail: detail)
    HarnessSeatPending { detail } => harness_placement_pending_exit(detail: detail)
    HarnessSeatBound { url, grant: _, partition: _, ceiling: _, group_wire: _, launch: _, layout: _, model: bound_model, unit: bound_unit, class: _ } => {
      let outcome = harness_run_turn(
        config: harness_auditor_config(
          worktree: worktree as FilePath,
          timeout_program: timeout_program as FilePath,
