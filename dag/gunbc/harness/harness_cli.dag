  HarnessTurnConfig {
    backend_url: backend_url,
    model: model as String,
    max_tokens: harness_default_max_tokens,
    serving_unit: unit,
    reasoning_mode: harness_reasoning_mode,
    wire_shape: harness_default_wire_shape,
    system_prompt: harness_auditor_system_prompt_at(worktree: worktree as String, verdict_path: verdict_path),
    request_scratch_path: request_scratch_path,
    events_path: events_path,
    context_budget: harness_context_budget_for(unit: unit),
    request_deadline: harness_request_deadline,
    environment: HarnessToolEnvironment {
