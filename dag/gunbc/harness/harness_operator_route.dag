import std.list { list_member }

// THE OPERATOR-RUN ENDPOINT: a serving process the OPERATOR runs on a rented GPU pod, reached from the
// harness host through an ssh -L tunnel. It is neither a fleet seat (this repository launches no engine and
// holds no replica) nor a hosted quota (no per-request lease; the server bounds itself), so it is its own
// route kind rather than a FabricGroup or a hosted row (gunbc.serving.serving_enrollment names a route
// identity that is not a FabricGroup as the trigger for exactly this).
//
// THE RULING THAT PUTS THE HARNESS'S DEFAULT REQUIREMENT HERE. The operator said, 2026-10-11: "could you just
// make our harness pick this pod, and for our dispatch to pick the harness instead of the claude backend".
// It is recorded as gunbc.design_ruling harness_default_requirement_places_on_operator_endpoint and it
// OVERRULES the earlier rule that AnyAdmittedModel lands only on a fleet seat. The placement cites it from
// operator_placement_ruling below.
data operator_placement_ruling: DeclarationRef = decl_ref(
  module_path: "gunbc.design_ruling",
  decl_name: "harness_default_requirement_places_on_operator_endpoint",
)

// THE ROUTE IS THE INFERENCE POOL'S TLS FRONT (extdeps.pool.pool_front), reached directly over HTTPS. The hand-placed
// systemd --user ssh -L tunnel to one rented Vast card (127.0.0.1:18090, ninfer-serve, model "qwen"; recorded as
// gunbc.recurring_failure_mode the_labs_only_model_route_is_a_hand_placed_tunnel_to_a_single_rented_card) is retired
// with that card, which went away on 2026-10-17 03:28Z: there is no second path, and nothing else in this repository
// reads the tunnel (operator_pod_launch survives only as the allocation record rented_allocation_witness imports).
// THE LAB'S DEPLOYMENT OF THE FRONT, parameters of this binding and not upstream facts: the origin, and the
// self-signed mkcert development certificate (notAfter 2028-09-17) the lab pins. The two paths are the front's own
// declarations (extdeps.pool.pool_front), not a second spelling of them.
// THE HOST IS SRV2'S TAILNET NAME, joined from the authorities that own its parts (gunbc.fleet.fleet_tailnet
// tailnet_base_url_from, the host from gunbc.fleet.fleet_host_identity), not srv2's LAN address: that address is a
// DHCP lease and moved (192.168.1.188 to .201, seen 2026-10-24), which left the origin dead. The pinned certificate
// names the tailnet host among its subject alternative names and not the new lease, so the tailnet name is also the
// one name that verifies. The port is the front's deployment (the dashboard listener).
data operator_pool_front_port: Port = 3737

data operator_pool_front_origin: NonEmptyStr = tailnet_base_url_from(
  host: operator_host_srv2 as NonEmptyStr,
  domain: fleet_tailnet_domain,
  port: Present { value: operator_pool_front_port },
)

data operator_pinned_certificate: PoolFrontCertificate = PoolFrontCertificate {
  sha256_fingerprint: "23:34:E0:C1:03:32:F8:0C:82:CA:D8:7F:D1:32:1E:1C:DF:0C:B6:CE:CF:B2:98:73:73:A0:12:3C:A4:F7:F1:CF" as NonEmptyStr,
  not_after: "2028-09-17" as NonEmptyStr,
}

fn operator_endpoint_origin() -> NonEmptyStr? {
  Present { value: operator_pool_front_origin }
}

fn operator_endpoint_url(path: NonEmptyStr) -> NonEmptyStr? {
  match operator_endpoint_origin() {
    Absent => none
    Present { value: o } => Present { value: join([o as String, path as String], "") as NonEmptyStr }
  }
}

fn operator_models_url() -> NonEmptyStr? {
  operator_endpoint_url(path: pool_front_models_path)
}

// The URL a turn POSTs to: the existing chat-completions POST (harness_wire) is reused, only its target
// is this route's.
fn operator_chat_completions_url() -> NonEmptyStr? {
  operator_endpoint_url(path: pool_front_chat_completions_path)
}

// THE QUALITY FLOOR. Swapping GLM-5.3-Flash for the pool's Qwen3.8-Flash-Next is a different quality product, and it must not
// be silent. The floor admits only the class that tolerates it; the other class REFUSES with the consequence
// named. The declared consequence: a turn that needs the quality of the flagship fleet model is refused on
// this route, never answered by it, and a batch turn placed here is answered by the pool's model, whose size and quantization the pool operator has not stated.
type OperatorQualityFloor {
  admitted_class: ServingCoTenancyClass
  consequence: NonEmptyStr
}

// DECLARED GAP (frontier): the ceiling is carried, not yet enforced by an admission step; the server's own
// 64-deep pending queue is the only bound. Trigger: a route-keyed occupancy pool (serving_enrollment's named
// growth surface) that counts open turns per route and refuses the ninth with a typed cause.
type HarnessOperatorRoute {
  unit: HarnessServingUnit
  group_wire: NonEmptyStr
  credential_relative_path: NonEmptyStr
  certificate_relative_path: NonEmptyStr
  credential_identifier: NonEmptyStr
  certificate_identifier: NonEmptyStr
  concurrency_ceiling: Nat
  quality_floor: OperatorQualityFloor
}

// The lab's own concurrency budget for the pool route: the operator said each card runs about 5-7 at once and
// sets no per-client cap, so the lab chooses the high end as its ceiling before any live reading.
data pool_concurrency_budget_policy: PoolBudgetPolicy = PoolBudgetPolicy {
  value: 7,
  reason: "the pool operator states a card runs about 5-7 requests at once and no per-client cap (ctrl #2375); the lab bounds its own fan-out at the high end until the figure is read" as NonEmptyStr,
}

data harness_operator_route: HarnessOperatorRoute = HarnessOperatorRoute {
  unit: Qwen38FlashNextOnPoolFront,
  group_wire: "operator:pool-front" as NonEmptyStr,
  credential_relative_path: ".config/gunbc-pool-front/api-key" as NonEmptyStr,
  certificate_relative_path: ".config/gunbc-pool-front/server.pem" as NonEmptyStr,
  credential_identifier: "gunbc-pool-front-api-key" as NonEmptyStr,
  certificate_identifier: "gunbc-pool-front-server-pem" as NonEmptyStr,
  concurrency_ceiling: pool_budget_enforced(policy: pool_concurrency_budget_policy, upstream: pool_front_card_concurrency_high),
  quality_floor: OperatorQualityFloor {
    admitted_class: BatchQualityTolerant,
    consequence: "the operator route serves the pool's Qwen3.8-Flash-Next (any card behind the front), not the fleet's GLM-5.3-Flash: a quality-sensitive (interactive) turn is REFUSED here rather than answered by it, and a batch turn placed here is answered by it knowingly" as NonEmptyStr,
  },
}

type OperatorClassAdmission
  = OperatorClassAdmitted
  | OperatorClassRefused { detail: String }

fn operator_class_admission(route: HarnessOperatorRoute, class: ServingCoTenancyClass) -> OperatorClassAdmission {
  let admitted = match class {
    InteractiveQualitySensitive => match route.quality_floor.admitted_class { InteractiveQualitySensitive => true  BatchQualityTolerant => false }
    BatchQualityTolerant => true
  }
  if admitted {
    OperatorClassAdmitted
  } else {
    OperatorClassRefused { detail: join(["the operator route admits ", serving_co_tenancy_class_wire(c: route.quality_floor.admitted_class) as String, " turns only (", route.quality_floor.consequence as String, "); this turn is ", serving_co_tenancy_class_wire(c: class) as String, "; placement ruling ", operator_placement_ruling.decl_name as String], "") }
  }
}

// ── THE CREDENTIAL AND THE PINNED CERTIFICATE: two files on the consuming host ──────────────────
//
// CUSTODY (declared for the host that provisions them, srv1): the client key is host-originated -- the pool's
// POST /api/settings/pool-front reply carries it exactly once -- and is written by that host's operator straight to
// $HOME/.config/gunbc-pool-front/api-key, owner the user that runs the harness, mode 0600, directory 0700. It is
// read here into a 0600 header file and never appears in argv, a log or an event. The certificate is public:
// $HOME/.config/gunbc-pool-front/server.pem, mode 0644, any provenance, because it is trusted only if its SHA-256
// fingerprint equals the pinned one (operator_pinned_certificate) -- a different file refuses.
//
// A HARNESS THE SERVICE MANAGER STARTED WITH THE FILES HANDED IN READS THEM THERE, NOT FROM A HOME. A dedicated
// worker account (gunbc.roadmap.roadmap_dashboard_instance WorkerDedicatedAccount) is the untrusted principal and
// has no home, so the custody above cannot be its own. The worker unit is handed both files by the manager
// (systemd.exec(5) LoadCredential=, from root-owned credstore copies the deploy makes as the service user:
// gunbc.roadmap.roadmap_dispatch_actuator dispatch_worker_credentials), under the two identifiers on the route,
// in the per-invocation directory the manager names in $CREDENTIALS_DIRECTORY, owned by the unit's user and
// removed when the unit stops. The two locations are not tried in turn: a process the manager handed a
// credentials directory reads only that directory, so a unit started without this route's credential refuses
// naming the missing file there and never falls through to a home.
type OperatorCredentialCustody
  = OperatorCredentialHandedByManager { directory: NonEmptyStr }
  | OperatorCredentialInHome { home: NonEmptyStr }
  | OperatorCredentialUnlocated

fn operator_credential_custody() -> OperatorCredentialCustody {
  match shell.Env.Get(name: "CREDENTIALS_DIRECTORY").value {
    Present { value: d } => if d == "" { OperatorCredentialUnlocated } else { OperatorCredentialHandedByManager { directory: d as NonEmptyStr } }
    Absent =>
      match shell.Env.Get(name: "HOME").value {
        Absent => OperatorCredentialUnlocated
        Present { value: h } => if h == "" { OperatorCredentialUnlocated } else { OperatorCredentialInHome { home: h as NonEmptyStr } }
      }
  }
}

fn operator_custody_file_path(custody: OperatorCredentialCustody, identifier: NonEmptyStr, relative: NonEmptyStr) -> NonEmptyStr? {
  match custody {
    OperatorCredentialHandedByManager { directory: d } => Present { value: join([d as String, "/", identifier as String], "") as NonEmptyStr }
    OperatorCredentialInHome { home: h } => Present { value: join([h as String, "/", relative as String], "") as NonEmptyStr }
    OperatorCredentialUnlocated => none
  }
}

data operator_custody_unlocated_detail: String = "neither CREDENTIALS_DIRECTORY nor HOME is set"

fn operator_credential_path(route: HarnessOperatorRoute) -> NonEmptyStr? {
  operator_custody_file_path(custody: operator_credential_custody(), identifier: route.credential_identifier, relative: route.credential_relative_path)
}

fn operator_certificate_path(route: HarnessOperatorRoute) -> NonEmptyStr? {
  operator_custody_file_path(custody: operator_credential_custody(), identifier: route.certificate_identifier, relative: route.certificate_relative_path)
}

// THE HEADER FILE'S TEXT, ONE SPELLING: the bearer line and the x-pool-session line. The session value is the
// worker's conversation identity, which is the attempt id; a resume of the same attempt rebinds with the same
// attempt, so the same text is written and the front keeps the conversation on the card holding its cache.
// Trailing newlines are the key file's, not the key's; an empty key is refused rather than sent as `Bearer `, and
// a session value that could end its header line is refused rather than sent.
fn operator_header_text(key_text: String, session: NonEmptyStr) -> NonEmptyStr? {
  let key = trim(s: key_text)
  if key == "" {
    none
  } else {
    match pool_front_session_header_line(session: session) {
      Absent => none
      Present { value: session_line } =>
        Present { value: join([pool_front_authorization_header_line(key: key as NonEmptyStr), session_line as String], "") as NonEmptyStr }
    }
  }
}

// WHERE THE PINNED FILES SIT: beside the header file, in the same fresh 0700 directory the header dir names.
fn operator_header_sibling(header_file: NonEmptyStr, name: String) -> NonEmptyStr {
  join([join(list_init(xs: split(s: header_file as String, delimiter: "/")), "/"), "/", name], "") as NonEmptyStr
}

// THE PIN PLAN: the two files the pin lives in, one spelling. The route writes the certificate to ca_file,
// fingerprints and extracts the public key FROM ca_file, writes pubkey_file, and curl is handed exactly these two
// (--cacert, --pinnedpubkey), so the checked bytes are the trusted bytes by construction.
type OperatorPinPlan {
  ca_file: NonEmptyStr
  pubkey_file: NonEmptyStr
}

fn operator_pin_plan(header_file: NonEmptyStr) -> OperatorPinPlan {
  OperatorPinPlan {
    ca_file: operator_header_sibling(header_file: header_file, name: "pinned-ca.pem"),
    pubkey_file: operator_header_sibling(header_file: header_file, name: "pinned-pubkey.pem"),
  }
}

// THE ARGUMENTS EACH PINNED REQUEST IS HANDED, built once and purely. Both call sites (the turn's POST and the
// front-door probe) take every field of the effect call from these records, and the claims materialize the real
// client argv from the same records, so a call site cannot spell a path the claims did not see.
type OperatorPinnedPostRequest {
  url: NonEmptyStr
  request_body_file: NonEmptyStr
  header_file: NonEmptyStr
  response_headers_file: NonEmptyStr
  ca_file: NonEmptyStr
  pinned_pubkey_file: NonEmptyStr
  max_seconds: NonEmptyStr
}

fn operator_pinned_post_request(url: NonEmptyStr, request_body_file: NonEmptyStr, response_headers_file: NonEmptyStr, max_seconds: NonEmptyStr, hf: NonEmptyStr) -> OperatorPinnedPostRequest {
  let plan = operator_pin_plan(header_file: hf)
  OperatorPinnedPostRequest {
    url: url,
    request_body_file: request_body_file,
    header_file: hf,
    response_headers_file: response_headers_file,
    ca_file: plan.ca_file,
    pinned_pubkey_file: plan.pubkey_file,
    max_seconds: max_seconds,
  }
}

type OperatorPinnedProbeRequest {
  url: NonEmptyStr
  header_file: NonEmptyStr
  response_headers_file: NonEmptyStr
  ca_file: NonEmptyStr
  pinned_pubkey_file: NonEmptyStr
  max_seconds: NonEmptyStr
}

fn operator_pinned_probe_request(url: NonEmptyStr, dir: NonEmptyStr, max_seconds: NonEmptyStr, hf: NonEmptyStr) -> OperatorPinnedProbeRequest {
  let plan = operator_pin_plan(header_file: hf)
  OperatorPinnedProbeRequest {
    url: url,
    header_file: hf,
    response_headers_file: join([dir as String, "/probe-response-headers"], "") as NonEmptyStr,
    ca_file: plan.ca_file,
    pinned_pubkey_file: plan.pubkey_file,
    max_seconds: max_seconds,
  }
}

type OperatorHeaderOpen
  = OperatorHeaderOpened { header_dir: NonEmptyStr, header_file: NonEmptyStr }
  | OperatorHeaderRefused { detail: String }

// THE CERTIFICATE IS PINNED BEFORE A REQUEST EXISTS. The custody PEM's fingerprint must equal the pinned one;
// a different certificate refuses here, so no request -- and no byte of any request -- is built for it. The
// refusal is fail-closed on every unreadable step too: an openssl that did not run, or printed nothing, is not
// a match. Returns the PEM and the public key text curl pins, or the refusal.
type OperatorCertificatePin
  = OperatorCertificatePinned { certificate_pem: String, public_key_pem: String }
  | OperatorCertificateRefused { detail: String }

fn operator_certificate_pin_decision(fingerprint_stdout: String) -> Bool {
  match pool_front_fingerprint_from_openssl_text(stdout: fingerprint_stdout) {
    Absent => false
    Present { value: f } => pool_front_certificate_is_pinned(pinned: operator_pinned_certificate, presented: f)
  }
}

// THE CERTIFICATE IS READ ONCE; THE BYTES CHECKED ARE THE BYTES CURL TRUSTS. The file is read a single time here,
// copied into the private temp directory, and the fingerprint and the public key are taken from THAT copy
// (operator_pin_staged_certificate), so nothing can change the file between the check and the pin.
type OperatorCertificateText
  = OperatorCertificateTextRead { certificate_pem: String }
  | OperatorCertificateTextRefused { detail: String }

fn operator_read_certificate(route: HarnessOperatorRoute) -> OperatorCertificateText {
  match operator_certificate_path(route: route) {
    Absent => OperatorCertificateTextRefused { detail: join([operator_custody_unlocated_detail, ", so the pool front's pinned certificate file cannot be located"], "") }
    Present { value: path } => {
      let read = Filesystem.Read(path: path as String)
      match filesystem_read_outcome(content: read.content, success: read.success, error: read.error) {
        FilesystemReadRefused { error: e } => OperatorCertificateTextRefused { detail: join(["the pool front's certificate file ", path as String, " could not be read: ", e], "") }
        FilesystemReadSucceeded { content: pem } => OperatorCertificateTextRead { certificate_pem: pem }
      }
    }
  }
}

fn operator_pin_staged_certificate(staged: NonEmptyStr, pem: String) -> OperatorCertificatePin {
  let fp = openssl.X509.Sha256Fingerprint(cert_file: staged as String)
  if fp.exit_code != 0 || !operator_certificate_pin_decision(fingerprint_stdout: fp.stdout) {
    OperatorCertificateRefused { detail: join(["the pool front's certificate file is not the pinned certificate (expected SHA-256 ", operator_pinned_certificate.sha256_fingerprint as String, "); nothing was sent"], "") }
  } else {
    let pub = openssl.X509.PublicKeyPem(cert_file: staged as String)
    if pub.exit_code != 0 || trim(s: pub.stdout) == "" {
      OperatorCertificateRefused { detail: "the public key of the pool front's certificate could not be extracted, so it cannot be pinned" }
    } else {
      OperatorCertificatePinned { certificate_pem: pem, public_key_pem: pub.stdout }
    }
  }
}

// The key is read from its file into a 0600 header file in a fresh temp directory (curl -H @file), the way
// harness_hosted_route does for OpenRouter, beside the pinned certificate and public key curl is given. A
// refusal after the directory exists removes it. `session` is the worker's conversation identity (see
// operator_header_text).
fn operator_open_header(route: HarnessOperatorRoute, session: NonEmptyStr) -> OperatorHeaderOpen {
  match operator_credential_path(route: route) {
    Absent => OperatorHeaderRefused { detail: join([operator_custody_unlocated_detail, ", so the operator endpoint's credential file cannot be located"], "") }
    Present { value: path } => {
      let read = Filesystem.Read(path: path as String)
      match filesystem_read_outcome(content: read.content, success: read.success, error: read.error) {
        FilesystemReadRefused { error: e } => OperatorHeaderRefused { detail: join(["the operator endpoint's credential file ", path as String, " could not be read: ", e], "") }
        FilesystemReadSucceeded { content: text } =>
          match operator_header_text(key_text: text, session: session) {
            Absent => OperatorHeaderRefused { detail: join(["the operator endpoint's credential file ", path as String, " is empty, or the session identity cannot be carried in a header"], "") }
            Present { value: line } =>
              match operator_read_certificate(route: route) {
                OperatorCertificateTextRefused { detail: d } => OperatorHeaderRefused { detail: d }
                OperatorCertificateTextRead { certificate_pem: pem } => {
                  let dir = shell.Mktemp.Dir()
                  if !dir.success {
                    OperatorHeaderRefused { detail: "mktemp -d failed for the operator bearer header file" }
                  } else {
                    let header_file = join([dir.path as String, "/authorization"], "") as NonEmptyStr
                    let plan = operator_pin_plan(header_file: header_file)
                    let wrote = Filesystem.WriteOwnerOnly(path: header_file as String, content: line as String)
                    let wrote_ca = Filesystem.Write(path: plan.ca_file as String, content: pem)
                    if !wrote.success || !wrote_ca.success {
                      let cleaned = shell.Remove.RecursiveForce(path: dir.path)
                      OperatorHeaderRefused { detail: "could not write the operator bearer header file or the pinned certificate file" }
                    } else {
                      match operator_pin_staged_certificate(staged: plan.ca_file, pem: pem) {
                        OperatorCertificateRefused { detail: d } => {
                          let cleaned = shell.Remove.RecursiveForce(path: dir.path)
                          OperatorHeaderRefused { detail: d }
                        }
                        OperatorCertificatePinned { certificate_pem: _, public_key_pem: pub } => {
                          let wrote_pub = Filesystem.Write(path: plan.pubkey_file as String, content: pub)
                          if !wrote_pub.success {
                            let cleaned = shell.Remove.RecursiveForce(path: dir.path)
                            OperatorHeaderRefused { detail: "could not write the pinned public key file" }
                          } else {
                            OperatorHeaderOpened { header_dir: dir.path as String as NonEmptyStr, header_file: header_file }
                          }
                        }
                      }
                    }
                  }
                }
              }
          }
      }
    }
  }
}

fn operator_close_header(header_dir: NonEmptyStr) -> Bool {
  let removed = shell.Remove.RecursiveForce(path: header_dir as String as FilePath)
  removed.success
}

// WHAT A POOL-FRONT ROUND CAN FAIL WITH THAT IS NEITHER AN UNEXPLAINED ENGINE REFUSAL NOR AN ENDED SESSION.
// No capacity is the front's own 503: requireTls clients are sent only to TLS cards and none serves, so nothing
// was forwarded, the request had no effect and may be sent again. A card that did not answer is the front's own
// 502: the request reached a card that returned nothing, so it too carries no output and may be sent again. Its
// 429 (every compatible upstream busy) is capacity again: nothing was served. The certificate refusal is curl's peer
// verification failing in the handshake, before any request byte. Both are read from the post's evidence by
// operator_round_fault, never from the body's text.
type OperatorRoundFault
  = OperatorNoCapacity
  | OperatorCardUnanswered
  | OperatorUpstreamsBusy
  | OperatorCertificateNotPinned { curl_exit: Int }
  | OperatorCertificateNotVerifiedForHost { curl_exit: Int }

fn operator_round_fault(success: Bool, curl_exit: Int, status: HttpStatus?) -> OperatorRoundFault? {
  if success {
    none
  } else {
    match curl_exit_outcome(code: curl_exit) {
      // CurlPeerFailedVerification is the chain, the expiry or the host name (a missing IP SAN) failing against the
      // trusted anchor, not a different certificate: typed apart so a SAN defect is never read as "not the pinned
      // certificate". CurlPinnedPubkeyMismatch is the pin itself firing.
      CurlPeerFailedVerification => Present { value: OperatorCertificateNotVerifiedForHost { curl_exit: curl_exit } }
      CurlPinnedPubkeyMismatch => Present { value: OperatorCertificateNotPinned { curl_exit: curl_exit } }
      _ =>
        match status {
          Absent => none
          Present { value: st } =>
            match pool_front_status_meaning(status: st) {
              PoolFrontNoTlsCardServing => Present { value: OperatorNoCapacity }
              PoolFrontCardUnanswered => Present { value: OperatorCardUnanswered }
              PoolFrontUpstreamsBusy => Present { value: OperatorUpstreamsBusy }
              PoolFrontAnswered => none
              PoolFrontKeyRejected => none
              PoolFrontRefused { status: _ } => none
            }
        }
    }
  }
}

// ── WHAT A PROBE ESTABLISHED, as supplied readings ─────────────────────────────────────────────
//
// THE PROBE IS ONE AUTHORISED GET OF /pool/v1/models. The front answers 401 to an unauthorised one, so a
// rejected key is a distinct reading from a front that did not answer at all, and a certificate that is not
// the pinned one is a third: none of them is "no model serving".
type OperatorModelsReading
  = OperatorFrontUnanswered { url: String }
  | OperatorFrontCertificateRefused { url: String, detail: String }
  | OperatorProbeNotSent { url: String, detail: String }
  | OperatorModelsRefused { url: String, status: String }
  | OperatorModelsAnswered { body: String }

type OperatorRouteStanding
  = OperatorRouteServing { model: NonEmptyStr }
  | OperatorRouteModelNotAdmitted { advertised: String }
  | OperatorRouteUnreachable { url: String }
  | OperatorRouteUnreadable { cause: String }

fn operator_route_standing(route: HarnessOperatorRoute, reading: OperatorModelsReading) -> OperatorRouteStanding {
  match reading {
    OperatorFrontUnanswered { url: u } => OperatorRouteUnreachable { url: u }
    OperatorFrontCertificateRefused { url: u, detail: d } => OperatorRouteUnreadable { cause: join(["the certificate ", u, " presented is not the pinned pool front certificate (", d, "); nothing was sent"], "") }
    OperatorProbeNotSent { url: u, detail: d } => OperatorRouteUnreadable { cause: join(["the probe of ", u, " was not sent: ", d], "") }
    OperatorModelsRefused { url: u, status: st } => OperatorRouteUnreadable { cause: join(["the pool front answered ", u, " with HTTP status ", st, " (401 is the client key being rejected)"], "") }
    OperatorModelsAnswered { body: b } =>
      match parse_json_document(s: b) {
        JsonDocumentUnreadable { gap: g } => OperatorRouteUnreadable { cause: json_document_gap_text(gap: g) }
        JsonDocumentParsed { value: doc } => {
          match ninfer_models_list(doc: doc) {
            NinferModelsUnreadable { cause: c } => OperatorRouteUnreadable { cause: c as String }
            NinferModelsAdvertised { ids: ids } => {
              let wanted = harness_unit_model_id(unit: route.unit)
              // The request names the any-card alias, so the alias must be listed AND every other listed id must be
              // the card model whose wire facts the unit carries: a second family behind the alias refuses here.
              let one_family = fold(ids, init: true, f: (ok, i) => ok && (i == (wanted as String) || i == (pool_front_model_id as String)))
              if list_member(xs: ids, x: wanted as String, eq: (a, b) => a == b) && one_family {
                OperatorRouteServing { model: wanted }
              } else {
                OperatorRouteModelNotAdmitted { advertised: join(ids, ", ") }
              }
            }
          }
        }
      }
  }
}
