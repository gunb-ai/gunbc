module gunbc.harness.harness_operator_route

import std.types { String, Bool, Int, List, NonEmptyStr, FilePath }
import std.algebra { trim, list_init }
import std.nat { Nat }
import std.optional { Present, Absent }
import std.decl_ref { DeclarationRef, decl_ref }
import extdeps.shell
import extdeps.filesystem.filesystem_io { Filesystem, filesystem_read_outcome, FilesystemReadSucceeded, FilesystemReadRefused }
import extdeps.languages.json.parse { JsonDocumentParsed, JsonDocumentUnreadable, parse_json_document, json_document_gap_text }
import extdeps.tools.openssl
import extdeps.tools.curl { curl_exit_outcome, CurlPeerFailedVerification, CurlPinnedPubkeyMismatch }
import extdeps.vllm.server { vllm_route_models, vllm_route_chat_completions }
import extdeps.ninfer.ninfer_serve { NinferModelsList, NinferModelsAdvertised, NinferModelsUnreadable, ninfer_models_list, ninfer_authorization_header_line }
import extdeps.http.header_dump { http_ascii_fold }
import extdeps.tools.openssl { openssl_fingerprint_from_stdout }
import gunbc.serving.router_dev_policy { router_dev_srv1_site }
import gunbc.harness.harness_reasoning_wire { HarnessServingUnit, Qwen38FlashNextOnFabricRouter, harness_unit_model_id, PoolBudgetPolicy }
import gunbc.serving.turn_admission { ServingCoTenancyClass, InteractiveQualitySensitive, BatchQualityTolerant, serving_co_tenancy_class_wire }
import gunbc.harness.harness_operator_credential { OperatorCredentialFile, operator_route_credential_file, operator_route_certificate_file }
import std.list { list_member }

// THE OPERATOR-RUN ENDPOINT: a serving process the OPERATOR runs, reached from the harness host over pinned HTTPS
// (today the srv1 OpenResty fabric router, gunbc-router; formerly a rented GPU pod behind an ssh -L tunnel, retired). It is neither a fleet seat (this repository launches no engine and
// holds no replica) nor a hosted quota (no per-request lease; the server bounds itself), so it is its own
// route kind rather than a FabricGroup or a hosted row (gunbc.serving.serving_enrollment names a route
// identity that is not a FabricGroup as the trigger for exactly this).
//
// THE RULING THAT PUTS THE HARNESS'S DEFAULT REQUIREMENT HERE. The operator said, 2026-10-11: "could you just
// make our harness pick this pod, and for our dispatch to pick the harness instead of the claude backend".
// It is recorded as gunbc.design_ruling harness_default_requirement_places_on_operator_endpoint and it
// OVERRULES the earlier rule that AnyAdmittedModel lands only on a fleet seat. The placement cites it from
// operator_placement_ruling below.
data operator_placement_ruling: DeclarationRef = decl_ref(
  module_path: "gunbc.design_ruling",
  decl_name: "harness_default_requirement_places_on_operator_endpoint",
)

// THE ROUTER'S LISTENER IS gunbc.serving.router_dev_policy router_dev_srv1_site, not a second spelling of its
// address; this module adds only the scheme and the route's pinned certificate (below).
fn operator_router_origin() -> NonEmptyStr {
  join(["https://", router_dev_srv1_site().listen_address, ":", to_string(router_dev_srv1_site().listen_port)], "") as NonEmptyStr
}

// THE SERVER CERTIFICATE A ROUTE PINS, by the SHA-256 of its DER encoding (the `openssl x509 -fingerprint -sha256`
// reading; the certificate structure itself is extdeps.standards.rfc_5280's, not re-modeled here). Only the
// fingerprint is part of the pin decision: expiry and chain are enforced by curl (exit 60), never by this value.
type PinnedServerCertificate {
  sha256_fingerprint: NonEmptyStr
}

fn pinned_server_certificate_canonical(text: String) -> String {
  http_ascii_fold(s: trim(s: text))
}

// WHETHER THE CERTIFICATE A HOST PRESENTED IS THE PINNED ONE. Total on any text: an unreadable or empty
// fingerprint is a different certificate, never a pass.
fn pinned_server_certificate_is_pinned(pinned: PinnedServerCertificate, presented: String) -> Bool {
  let p = pinned_server_certificate_canonical(text: presented)
  p != "" && p == pinned_server_certificate_canonical(text: pinned.sha256_fingerprint as String)
}

// THE ROUTER'S LISTENER CERTIFICATE (self-signed; `openssl x509 -fingerprint -sha256` of srv1:~/router/tls/cert.pem,
// read 2026-11-04). The deployment's value, pinned here and enforced on every request and probe.
data operator_router_certificate: PinnedServerCertificate = PinnedServerCertificate {
  sha256_fingerprint: "1B:A2:8E:1C:CE:C3:5B:91:39:8F:63:17:8E:35:99:3D:9D:26:F0:A5:E6:35:D0:A7:45:07:FB:C5:6E:81:4C:52" as NonEmptyStr,
}

fn operator_endpoint_origin(route: HarnessOperatorRoute) -> NonEmptyStr? {
  Present { value: route.origin }
}

fn operator_endpoint_url(route: HarnessOperatorRoute, path: NonEmptyStr) -> NonEmptyStr? {
  Present { value: join([route.origin as String, path as String], "") as NonEmptyStr }
}

fn operator_models_url(route: HarnessOperatorRoute) -> NonEmptyStr? {
  operator_endpoint_url(route: route, path: route.models_path)
}

// The URL a turn POSTs to: the existing chat-completions POST (harness_wire) is reused, only its target
// is this route's.
fn operator_chat_completions_url(route: HarnessOperatorRoute) -> NonEmptyStr? {
  operator_endpoint_url(route: route, path: route.chat_completions_path)
}

// THE QUALITY FLOOR. A route that answers at a quantization the caller does not choose is a different quality
// product, and it must not be silent. The floor admits only the class that tolerates it; the other class REFUSES
// with the consequence named (each route row states its own).
type OperatorQualityFloor {
  admitted_class: ServingCoTenancyClass
  consequence: NonEmptyStr
}

// ONE ROW TYPE FOR EVERY OPERATOR ROUTE (the shape of the lab integration branch bright-moth-475/lab-dev; srv4-strata
// and pool-front land as further rows of it). The credential and the pinned certificate's file are D2's datum
// (gunbc.harness.harness_operator_credential), read through OperatorCredentialFile and never respelled; where
// lab-dev carries credential_relative_path / credential_identifier / certificate_* inline, that single datum
// wins.
//
// DECLARED GAP (frontier): the ceiling is carried, not yet enforced by an admission step. Trigger: a
// route-keyed occupancy pool (serving_enrollment's named growth surface) that counts open turns per route and
// refuses the one past the ceiling with a typed cause.
type HarnessOperatorRoute {
  unit: HarnessServingUnit
  origin: NonEmptyStr
  models_path: NonEmptyStr
  chat_completions_path: NonEmptyStr
  pinned_certificate: PinnedServerCertificate
  group_wire: NonEmptyStr
  credential: OperatorCredentialFile
  certificate: OperatorCredentialFile
  concurrency_ceiling: Nat
  quality_floor: OperatorQualityFloor
}

// THE LAB'S OWN FAN-OUT BOUND ON THE ROUTER, a policy and not a reading. The router's upstream rows
// (gunbc.serving.router_dev_policy router_dev_first_party) declare their own caps and an overflow
// pool; the lab chooses to hold well under them so that one lab's workers cannot crowd the router's other
// clients. No live reading of the router's occupancy is claimed.
data router_concurrency_budget_policy: PoolBudgetPolicy = PoolBudgetPolicy {
  value: 8,
  reason: "the lab bounds its own fan-out on the srv1 fabric router at 8 concurrent turns, a policy below the sum of the router's declared upstream caps (gunbc.serving.router_dev_policy router_dev_first_party), chosen so the lab cannot crowd the router's other clients; it is not a reading of the router's occupancy" as NonEmptyStr,
}

data harness_router_operator_route: HarnessOperatorRoute = HarnessOperatorRoute {
  unit: Qwen38FlashNextOnFabricRouter,
  origin: operator_router_origin(),
  models_path: vllm_route_models.path,
  chat_completions_path: vllm_route_chat_completions.path,
  pinned_certificate: operator_router_certificate,
  group_wire: "operator:fabric-router" as NonEmptyStr,
  credential: operator_route_credential_file,
  certificate: operator_route_certificate_file,
  concurrency_ceiling: router_concurrency_budget_policy.value,
  quality_floor: OperatorQualityFloor {
    admitted_class: BatchQualityTolerant,
    consequence: "the operator route is the fabric router: a turn is answered by ANY upstream behind it (srv1 vLLM, srv3 and h11 Strata, or the overflow pool) at THAT UPSTREAM'S quantization, which the caller does not choose and the router may change; it is not the fleet's GLM-5.3-Flash, so a quality-sensitive (interactive) turn is REFUSED here, and a batch turn placed here is answered by it knowingly" as NonEmptyStr,
  },
}

data harness_operator_route: HarnessOperatorRoute = harness_router_operator_route

type OperatorClassAdmission
  = OperatorClassAdmitted
  | OperatorClassRefused { detail: String }

fn operator_class_admission(route: HarnessOperatorRoute, class: ServingCoTenancyClass) -> OperatorClassAdmission {
  let admitted = match class {
    InteractiveQualitySensitive => match route.quality_floor.admitted_class { InteractiveQualitySensitive => true  BatchQualityTolerant => false }
    BatchQualityTolerant => true
  }
  if admitted {
    OperatorClassAdmitted
  } else {
    OperatorClassRefused { detail: join(["the operator route admits ", serving_co_tenancy_class_wire(c: route.quality_floor.admitted_class) as String, " turns only (", route.quality_floor.consequence as String, "); this turn is ", serving_co_tenancy_class_wire(c: class) as String, "; placement ruling ", operator_placement_ruling.decl_name as String], "") }
  }
}

// ── THE CREDENTIAL: a file path read into a Bearer header, never inlined ────────────────────────
//
// A HARNESS THE SERVICE MANAGER STARTED WITH THE FILE HANDED IN READS IT THERE, NOT FROM A HOME. The route's
// custody is a 0600 file under $HOME of the user running the harness (the credential's relative_path). A
// dedicated worker account (gunbc.roadmap.roadmap_dashboard_instance WorkerDedicatedAccount) is the untrusted
// principal and has no home, so that custody cannot be its own. Its unit is handed the file by the manager
// (systemd.exec(5) LoadCredential=, from a root-owned credstore copy the deploy makes as the service user:
// gunbc.roadmap.dispatch_worker_unit_confinement dispatch_worker_credentials, installed by
// gunbc.live_deploy.apply_legs credstore_copy_legs) under the credential's identifier,
// in the per-invocation directory the manager names in $CREDENTIALS_DIRECTORY, owned by the unit's user and
// removed when the unit stops. The two locations are not tried in turn: a process the manager handed a
// credentials directory reads only that directory, so a unit started without this route's credential refuses
// naming the missing file there and never falls through to a home.
type OperatorCredentialCustody
  = OperatorCredentialHandedByManager { directory: NonEmptyStr }
  | OperatorCredentialInHome { home: NonEmptyStr }
  | OperatorCredentialUnlocated

fn operator_credential_custody() -> OperatorCredentialCustody {
  operator_credential_custody_of(
    credentials_directory: shell.Env.Get(name: "CREDENTIALS_DIRECTORY").value,
    home: shell.Env.Get(name: "HOME").value,
  )
}

// The precedence over the two readings, apart from the environment read so a claim can supply them.
fn operator_credential_custody_of(credentials_directory: String?, home: String?) -> OperatorCredentialCustody {
  match credentials_directory {
    Present { value: d } => if d == "" { OperatorCredentialUnlocated } else { OperatorCredentialHandedByManager { directory: d as NonEmptyStr } }
    Absent =>
      match home {
        Absent => OperatorCredentialUnlocated
        Present { value: h } => if h == "" { OperatorCredentialUnlocated } else { OperatorCredentialInHome { home: h as NonEmptyStr } }
      }
  }
}

fn operator_custody_file_path(custody: OperatorCredentialCustody, file: OperatorCredentialFile) -> NonEmptyStr? {
  match custody {
    OperatorCredentialHandedByManager { directory: d } => Present { value: join([d as String, "/", file.identifier as String], "") as NonEmptyStr }
    OperatorCredentialInHome { home: h } => Present { value: join([h as String, "/", file.relative_path as String], "") as NonEmptyStr }
    OperatorCredentialUnlocated => none
  }
}

fn operator_credential_path(route: HarnessOperatorRoute) -> NonEmptyStr? {
  operator_custody_file_path(custody: operator_credential_custody(), file: route.credential)
}

// The header line a request carries, from the key file's text. Trailing newlines are the file's, not the
// key's; an empty file is refused rather than sent as `Bearer `.
fn operator_header_line_from_key_text(text: String) -> NonEmptyStr? {
  let key = trim(s: text)
  if key == "" { none } else { Present { value: ninfer_authorization_header_line(key: key as NonEmptyStr) as NonEmptyStr } }
}

data operator_custody_unlocated_detail: String = "neither CREDENTIALS_DIRECTORY nor HOME is set"

// The route's pinned server certificate, located through D2's datum (route.certificate), never respelled.
fn operator_certificate_path(route: HarnessOperatorRoute) -> NonEmptyStr? {
  operator_custody_file_path(custody: operator_credential_custody(), file: route.certificate)
}

// WHERE THE PINNED FILES SIT: beside the header file, in the same fresh 0700 directory the header dir names.
fn operator_header_sibling(header_file: NonEmptyStr, name: String) -> NonEmptyStr {
  join([join(list_init(xs: split(s: header_file as String, delimiter: "/")), "/"), "/", name], "") as NonEmptyStr
}

// THE PIN PLAN: the two files the pin lives in, one spelling. The route writes the certificate to ca_file,
// fingerprints and extracts the public key FROM ca_file, writes pubkey_file, and curl is handed exactly these two
// (--cacert, --pinnedpubkey), so the checked bytes are the trusted bytes by construction.
type OperatorPinPlan {
  ca_file: NonEmptyStr
  pubkey_file: NonEmptyStr
}

fn operator_pin_plan(header_file: NonEmptyStr) -> OperatorPinPlan {
  OperatorPinPlan {
    ca_file: operator_header_sibling(header_file: header_file, name: "pinned-ca.pem"),
    pubkey_file: operator_header_sibling(header_file: header_file, name: "pinned-pubkey.pem"),
  }
}

// THE ARGUMENTS EACH PINNED REQUEST IS HANDED, built once and purely. Both call sites (the turn's POST and the
// probe) take every field of the effect call from these records, and the claims materialize the real client
// argv from the same records, so a call site cannot spell a path the claims did not see.
type OperatorPinnedPostRequest {
  url: NonEmptyStr
  request_body_file: NonEmptyStr
  header_file: NonEmptyStr
  response_headers_file: NonEmptyStr
  ca_file: NonEmptyStr
  pinned_pubkey_file: NonEmptyStr
  max_seconds: NonEmptyStr
}

fn operator_pinned_post_request(url: NonEmptyStr, request_body_file: NonEmptyStr, response_headers_file: NonEmptyStr, max_seconds: NonEmptyStr, hf: NonEmptyStr) -> OperatorPinnedPostRequest {
  let plan = operator_pin_plan(header_file: hf)
  OperatorPinnedPostRequest {
    url: url,
    request_body_file: request_body_file,
    header_file: hf,
    response_headers_file: response_headers_file,
    ca_file: plan.ca_file,
    pinned_pubkey_file: plan.pubkey_file,
    max_seconds: max_seconds,
  }
}

type OperatorPinnedProbeRequest {
  url: NonEmptyStr
  header_file: NonEmptyStr
  response_headers_file: NonEmptyStr
  ca_file: NonEmptyStr
  pinned_pubkey_file: NonEmptyStr
  max_seconds: NonEmptyStr
}

fn operator_pinned_probe_request(url: NonEmptyStr, dir: NonEmptyStr, max_seconds: NonEmptyStr, hf: NonEmptyStr) -> OperatorPinnedProbeRequest {
  let plan = operator_pin_plan(header_file: hf)
  OperatorPinnedProbeRequest {
    url: url,
    header_file: hf,
    response_headers_file: join([dir as String, "/probe-response-headers"], "") as NonEmptyStr,
    ca_file: plan.ca_file,
    pinned_pubkey_file: plan.pubkey_file,
    max_seconds: max_seconds,
  }
}

type OperatorHeaderOpen
  = OperatorHeaderOpened { header_dir: NonEmptyStr, header_file: NonEmptyStr }
  | OperatorHeaderRefused { detail: String }

// THE CERTIFICATE IS PINNED BEFORE A REQUEST EXISTS. The custody PEM's fingerprint must equal the route's pinned
// one; a different certificate refuses here, so no request -- and no byte of any request -- is built for it. The
// refusal is fail-closed on every unreadable step too: an openssl that did not run, or printed nothing, is not
// a match. An unreachable or mismatched router refuses and never falls back to another route (DESIGN §5).
type OperatorCertificatePin
  = OperatorCertificatePinned { certificate_pem: String, public_key_pem: String }
  | OperatorCertificateRefused { detail: String }

fn operator_certificate_pin_decision(pinned: PinnedServerCertificate, fingerprint_stdout: String) -> Bool {
  match openssl_fingerprint_from_stdout(stdout: fingerprint_stdout) {
    Absent => false
    Present { value: f } => pinned_server_certificate_is_pinned(pinned: pinned, presented: f)
  }
}

// THE CERTIFICATE IS READ ONCE; THE BYTES CHECKED ARE THE BYTES CURL TRUSTS. The file is read a single time,
// copied into the private temp directory, and the fingerprint and the public key are taken from THAT copy.
type OperatorCertificateText
  = OperatorCertificateTextRead { certificate_pem: String }
  | OperatorCertificateTextRefused { detail: String }

fn operator_read_certificate(route: HarnessOperatorRoute) -> OperatorCertificateText {
  match operator_certificate_path(route: route) {
    Absent => OperatorCertificateTextRefused { detail: join([operator_custody_unlocated_detail, ", so the route's pinned certificate file cannot be located"], "") }
    Present { value: path } => {
      let read = Filesystem.Read(path: path as String)
      match filesystem_read_outcome(content: read.content, success: read.success, error: read.error) {
        FilesystemReadRefused { error: e } => OperatorCertificateTextRefused { detail: join(["the route's certificate file ", path as String, " could not be read: ", e], "") }
        FilesystemReadSucceeded { content: pem } => OperatorCertificateTextRead { certificate_pem: pem }
      }
    }
  }
}

fn operator_pin_staged_certificate(route: HarnessOperatorRoute, staged: NonEmptyStr, pem: String) -> OperatorCertificatePin {
  let fp = openssl.X509.Sha256Fingerprint(cert_file: staged as String)
  if fp.exit_code != 0 || !operator_certificate_pin_decision(pinned: route.pinned_certificate, fingerprint_stdout: fp.stdout) {
    OperatorCertificateRefused { detail: join(["the route's certificate file is not the pinned certificate (expected SHA-256 ", route.pinned_certificate.sha256_fingerprint as String, "); nothing was sent"], "") }
  } else {
    let pub = openssl.X509.PublicKeyPem(cert_file: staged as String)
    if pub.exit_code != 0 || trim(s: pub.stdout) == "" {
      OperatorCertificateRefused { detail: "the public key of the route's certificate could not be extracted, so it cannot be pinned" }
    } else {
      OperatorCertificatePinned { certificate_pem: pem, public_key_pem: pub.stdout }
    }
  }
}

// The key is read from its file into a 0600 header file in a fresh temp directory (curl -H @file), beside the
// pinned certificate and public key curl is given. A refusal after the directory exists removes it.
fn operator_open_header(route: HarnessOperatorRoute) -> OperatorHeaderOpen {
  match operator_credential_path(route: route) {
    Absent => OperatorHeaderRefused { detail: join([operator_custody_unlocated_detail, ", so the operator endpoint's credential file cannot be located"], "") }
    Present { value: path } => {
      let read = Filesystem.Read(path: path as String)
      match filesystem_read_outcome(content: read.content, success: read.success, error: read.error) {
        FilesystemReadRefused { error: e } => OperatorHeaderRefused { detail: join(["the operator endpoint's credential file ", path as String, " could not be read: ", e], "") }
        FilesystemReadSucceeded { content: text } =>
          match operator_header_line_from_key_text(text: text) {
            Absent => OperatorHeaderRefused { detail: join(["the operator endpoint's credential file ", path as String, " is empty"], "") }
            Present { value: line } =>
              match operator_read_certificate(route: route) {
                OperatorCertificateTextRefused { detail: d } => OperatorHeaderRefused { detail: d }
                OperatorCertificateTextRead { certificate_pem: pem } => {
                  let dir = shell.Mktemp.Dir()
                  if !dir.success {
                    OperatorHeaderRefused { detail: "mktemp -d failed for the operator bearer header file" }
                  } else {
                    let header_file = join([dir.path as String, "/authorization"], "") as NonEmptyStr
                    let plan = operator_pin_plan(header_file: header_file)
                    let wrote = Filesystem.WriteOwnerOnly(path: header_file as String, content: line as String)
                    let wrote_ca = Filesystem.Write(path: plan.ca_file as String, content: pem)
                    if !wrote.success || !wrote_ca.success {
                      let cleaned = shell.Remove.RecursiveForce(path: dir.path)
                      OperatorHeaderRefused { detail: "could not write the operator bearer header file or the pinned certificate file" }
                    } else {
                      match operator_pin_staged_certificate(route: route, staged: plan.ca_file, pem: pem) {
                        OperatorCertificateRefused { detail: d } => {
                          let cleaned = shell.Remove.RecursiveForce(path: dir.path)
                          OperatorHeaderRefused { detail: d }
                        }
                        OperatorCertificatePinned { certificate_pem: _, public_key_pem: pub } => {
                          let wrote_pub = Filesystem.Write(path: plan.pubkey_file as String, content: pub)
                          if !wrote_pub.success {
                            let cleaned = shell.Remove.RecursiveForce(path: dir.path)
                            OperatorHeaderRefused { detail: "could not write the pinned public key file" }
                          } else {
                            OperatorHeaderOpened { header_dir: dir.path as String as NonEmptyStr, header_file: header_file }
                          }
                        }
                      }
                    }
                  }
                }
              }
          }
      }
    }
  }
}

fn operator_close_header(header_dir: NonEmptyStr) -> Bool {
  let removed = shell.Remove.RecursiveForce(path: header_dir as String as FilePath)
  removed.success
}

// WHAT A ROUND CAN FAIL WITH THAT IS NOT AN ENGINE REFUSAL: the certificate refusals, curl's peer verification
// failing in the handshake, before any request byte. CurlPeerFailedVerification is the chain, the expiry or the
// host name (a missing IP SAN) failing against the trusted anchor, not a different certificate: typed apart so a
// SAN defect is never read as "not the pinned certificate". CurlPinnedPubkeyMismatch is the pin itself firing.
// Neither is retried or routed elsewhere.
type OperatorRoundFault
  = OperatorCertificateNotPinned { curl_exit: Int }
  | OperatorCertificateNotVerifiedForHost { curl_exit: Int }

fn operator_round_fault(success: Bool, curl_exit: Int) -> OperatorRoundFault? {
  if success {
    none
  } else {
    match curl_exit_outcome(code: curl_exit) {
      CurlPeerFailedVerification => Present { value: OperatorCertificateNotVerifiedForHost { curl_exit: curl_exit } }
      CurlPinnedPubkeyMismatch => Present { value: OperatorCertificateNotPinned { curl_exit: curl_exit } }
      _ => none
    }
  }
}

fn operator_round_fault_text(fault: OperatorRoundFault) -> String {
  match fault {
    OperatorCertificateNotPinned { curl_exit: c } => join(["the router presented a certificate that is not the pinned one (curl exit ", to_string(c), "); the request was refused in the handshake and not retried. "], "")
    OperatorCertificateNotVerifiedForHost { curl_exit: c } => join(["the router's certificate did not verify against the trusted anchor or the host (curl exit ", to_string(c), "); the request was refused in the handshake and not retried. "], "")
  }
}

// ── WHAT A PROBE ESTABLISHED, as supplied readings ─────────────────────────────────────────────
//
// THE PROBE IS ONE AUTHORISED GET OF THE ROUTE'S MODELS PATH. The router answers 401 to an unauthorised one, so a
// rejected key is a distinct reading from a router that did not answer, and a certificate that is not the pinned
// one is a third: none of them is "no model serving".
type OperatorModelsReading
  = OperatorFrontUnanswered { url: String }
  | OperatorFrontCertificateRefused { url: String, fault: OperatorRoundFault }
  | OperatorProbeNotSent { url: String, detail: String }
  | OperatorModelsRefused { url: String, status: String }
  | OperatorModelsAnswered { body: String }

type OperatorRouteStanding
  = OperatorRouteServing { model: NonEmptyStr }
  | OperatorRouteModelNotAdmitted { advertised: String }
  | OperatorRouteUnreachable { url: String }
  | OperatorRouteUnreadable { cause: String }

fn operator_route_standing(route: HarnessOperatorRoute, reading: OperatorModelsReading) -> OperatorRouteStanding {
  match reading {
    OperatorFrontUnanswered { url: u } => OperatorRouteUnreachable { url: u }
    OperatorFrontCertificateRefused { url: u, fault: f } => OperatorRouteUnreadable { cause: join([u, ": ", operator_round_fault_text(fault: f), "nothing was sent"], "") }
    OperatorProbeNotSent { url: u, detail: d } => OperatorRouteUnreadable { cause: join(["the probe of ", u, " was not sent: ", d], "") }
    OperatorModelsRefused { url: u, status: st } => OperatorRouteUnreadable { cause: join(["the router answered ", u, " with HTTP status ", st, " (401 is the client key being rejected)"], "") }
    OperatorModelsAnswered { body: b } =>
      match parse_json_document(s: b) {
        JsonDocumentUnreadable { gap: g } => OperatorRouteUnreadable { cause: json_document_gap_text(gap: g) }
        JsonDocumentParsed { value: doc } => {
          match ninfer_models_list(doc: doc) {
            NinferModelsUnreadable { cause: c } => OperatorRouteUnreadable { cause: c as String }
            NinferModelsAdvertised { ids: ids } => {
              let wanted = harness_unit_model_id(unit: route.unit)
              if list_member(xs: ids, x: wanted as String, eq: (a, b) => a == b) {
                OperatorRouteServing { model: wanted }
              } else {
                OperatorRouteModelNotAdmitted { advertised: join(ids, ", ") }
              }
            }
          }
        }
      }
  }
}
