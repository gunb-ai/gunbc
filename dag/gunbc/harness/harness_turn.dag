// THE TURN LOOP: post a request, and while the response stops on tool use, execute the tools and
// post the results back. Everything else in this module exists to make that sentence honest.
//
// THE LOOP IS BOUNDED AND THE BOUND IS AN ARGUMENT. Execution here is forward and terminating by
// construction (DESIGN section 4), so the recursion carries a step budget that strictly decreases
// and the exhausted case is a NAMED terminal, not a silent stop. An unbounded "while tool_use"
// would be a program whose termination depends on the remote model's behaviour, which is precisely
// the fact we are least entitled to assume.

// WHAT ENDS A TURN BESIDES THE PROVIDER. A worker's turn ends when the provider stops; its work is
// judged by external verification. A reviewer's or auditor's turn has ONE typed output -- the verdict
// file -- and the first live run (2026-09-06, attempt eca90231) showed why the provider's stop is the
// wrong terminal for it: a reviewer wrote its verdict at round 19 and kept spending rounds until the
// budget refused, so its unit reported failure over a verdict the belt then accepted. When the
// artifact the turn exists to produce is present, the turn is complete; presence is established by a
// successful listing of its directory (extdeps.filesystem.filesystem_io), never by a failed read.
type HarnessTurnCompletion
  = CompletesOnProviderStop
  | CompletesWhenEntryPresent { directory: String, name: String }

type HarnessCompletionObservation
  = CompletionNotReached
  | CompletionReached { path: String }
  | CompletionIndeterminate { cause: String }

fn harness_completion_observe(completion: HarnessTurnCompletion) -> HarnessCompletionObservation {
  match completion {
    CompletesOnProviderStop => CompletionNotReached
    CompletesWhenEntryPresent { directory, name } => {
      let listing = Filesystem.List(path: directory)
      match filesystem_entry_presence(
        listing: filesystem_listing_observation(directory: directory, success: listing.success, entries: listing.entries, error: listing.error),
        name: name,
      ) {
        FilesystemEntryAbsent(_) => CompletionNotReached
        FilesystemEntryListed { directory: d, name: n } => CompletionReached { path: join([d as String, "/", n], "") }
        FilesystemEntryPresenceIndeterminate { cause } => CompletionIndeterminate { cause: cause }
        FilesystemEntrySubjectRefused { directory: _, name: _, cause } => CompletionIndeterminate { cause: cause }
      }
    }
  }
}

fn harness_event_completion_indeterminate(cause: String) -> String {
  serialize_json(v: json_object([
    json_kv(key: "type", value: json_string(s: "completion.indeterminate")),
    json_kv(key: "cause", value: json_string(s: cause)),
  ]))
}

fn harness_event_turn_completed_by_artifact(path: String) -> String {
  serialize_json(v: json_object([
    json_kv(key: "type", value: json_string(s: "turn.completed")),
    json_kv(key: "artifact", value: json_string(s: path)),
  ]))
}

// THE SUBMISSION GATE. Prompt guidance (gunbc.harness.harness_guidance) is advisory, and two
// production workers proved it: both wrote .gunbc-submission.json in the habit format
// (known_limitations, no schema member) -- one of them AFTER writing the correct shape mid-turn
// and reverting it on its final write. The belt's sweep read every one undecodable and swept
// preservation checkpoints where candidates should have been. So a worker's turn may not end as
// complete over a submission artifact that does not decode: presence is not a declaration, and
// only the REAL decoder (gunbc.roadmap.roadmap_submission submission_decode -- the same authority
// the belt sweeps with, never a second parse) judges the artifact. An ABSENT artifact is a yield
// and ends the turn exactly as before; a decodable one ends it normally whatever readiness the
// worker declared. Only the present-but-undecodable middle is gated: the worker gets the decode
// reason back as its next round's input, up to the declared bound, and past the bound the turn
// ends failed with the decode failure named in the terminal event.
type SubmissionGateObservation
  = GateArtifactAbsent
  | GateArtifactDeclared { ready: Bool }
  | GateArtifactUndecodable { reason: String }
  | GateArtifactUnobservable { cause: String }

type SubmissionGateVerdict
  = GateProceed
  | GateRepair { reason: String }
  | GateRefuse { reason: String }

// TWO REPAIR ROUNDS. The first tells the worker the decoder's exact reason; the second is the
// benefit of the doubt that the reason was misread. Past that, a worker still writing an
// undecodable artifact is evidence about the worker or the contract, not a reason for a third
// round -- the turn ends with the failure named rather than spending the whole step budget on one
// file.
data harness_submission_repair_bound: Int = 2

// THE PURE READ, separated from the filesystem so a witness can feed it the production shapes
// verbatim. The decoder is the belt's own; a gate that checked only the file's presence would
// declare the habit format here, which is exactly the production defect.
fn harness_submission_gate_read(artifact: String?) -> SubmissionGateObservation {
  match artifact {
    Absent => GateArtifactAbsent
    Present { value: content } =>
      match submission_decode(text: content) {
        SubmissionDecoded { submission } => GateArtifactDeclared { ready: match submission.readiness { SubmissionReady => true  SubmissionBlocked => false  SubmissionNeedsContext => false } }
        SubmissionNotDecodable { reason } => GateArtifactUndecodable { reason: reason }
      }
  }
}

// ABSENCE IS ESTABLISHED BY A SUCCESSFUL LISTING, never by a failed read -- the same rule the
// completion observation above and the belt's own sweep carry, and for the same reason: a failed
// read answers both "not there" and "there but unreadable", and the two worlds gate differently.
// An artifact whose presence or content cannot be established is not repairable by the worker --
// no edit fixes an unreadable filesystem -- so it is refused outright rather than repaired.
fn harness_submission_gate_observe(environment: HarnessToolEnvironment) -> SubmissionGateObservation {
  let dir = environment.working_directory as String
  let path = join([dir, "/", submission_artifact_name as String], "")
  let listing = Filesystem.List(path: dir)
  let read = Filesystem.Read(path: path)
  match filesystem_file_observation(
    listing: filesystem_listing_observation(directory: dir, success: listing.success, entries: listing.entries, error: listing.error),
    name: submission_artifact_name as String,
    path: path,
    read: filesystem_read_outcome(content: read.content, success: read.success, error: read.error),
  ) {
    FilesystemFileAbsent(_) => GateArtifactAbsent
    FilesystemFileRead { path: _, content } => harness_submission_gate_read(artifact: Present { value: content })
    FilesystemFileIndeterminate { cause } => GateArtifactUnobservable { cause: cause }
    FilesystemFileObservationsDisagree { path: _, cause } => GateArtifactUnobservable { cause: cause }
    FilesystemFileSubjectRefused { directory: _, name: _, cause } => GateArtifactUnobservable { cause: cause }
  }
}

fn harness_submission_gate_judge(observation: SubmissionGateObservation, repairs_used: Int) -> SubmissionGateVerdict {
  match observation {
    GateArtifactAbsent => GateProceed
    GateArtifactDeclared { ready: _ } => GateProceed
    GateArtifactUnobservable { cause } => GateRefuse { reason: cause }
    GateArtifactUndecodable { reason } =>
      if repairs_used >= harness_submission_repair_bound {
        GateRefuse { reason: reason }
      } else {
        GateRepair { reason: reason }
      }
  }
}

// THE REPAIR ROUND'S INPUT, carrying the decoder's exact reason so the worker repairs against the
// message and not against a paraphrase. The round count is spelled so the worker can see the bound
// approaching rather than discovering it at the terminal.
fn harness_submission_repair_text(reason: String, repairs_used: Int) -> String {
  join([
    "[harness] Your submission artifact ", submission_artifact_name as String,
    " exists but does not decode, so it is not a declaration: ", reason,
    ". Repair it to the exact declared shape (the schema member, readiness, explanation and limitations keys from the completion term) and stop again. This is repair round ",
    to_string(value: repairs_used), " of ", to_string(value: harness_submission_repair_bound),
    "; if it still does not decode after that, the turn ends with the decode failure recorded.",
  ], "")
}

fn harness_event_submission_repair(reason: String, repair_round: Int) -> String {
  serialize_json(v: json_object([
    json_kv(key: "type", value: json_string(s: "submission.repair")),
    json_kv(key: "reason", value: json_string(s: reason)),
    json_kv(key: "repair_round", value: json_int(n: repair_round)),
  ]))
}

// THE TERMINAL CAUSE, one spelling for the event stream and the outcome detail so the belt and the
// operator read the same sentence.
fn harness_submission_terminal_cause(reason: String) -> String {
  join([
    "the submission artifact ", submission_artifact_name as String,
    " exists but does not decode after ", to_string(value: harness_submission_repair_bound),
    " repair rounds: ", reason,
    " -- the tree is preserved as a checkpoint and never advances",
  ], "")
}


// THE ROUND BOUNDARY IS A SUPERVISION CADENCE, NOT A TERMINAL (gunbc.plans.harness_session_lifecycle,
// requirements 1 and 2). An unsupervised turn -- a reviewer, an auditor, a probe -- ends when its
// rounds run out, and its notices say so. A supervised session pauses at each boundary, synchronously
// and invisibly, while a bounded alignment check reads its work; the verdict decides the next turn,
// and nothing about the boundary is said to the worker unless the verdict is a steer.
// WHERE A SUPERVISED SESSION HANDS IN (slice S2): the inbox its hand-in entry is written to, and the
// node and attempt that entry names. The outcome comes back in outcome_directory, which the belt writes
// and the session only reads. It is NOT the check directory: the session writes its own check and
// supervisor artifacts, so a session that could also write where its acceptance is decided could accept
// itself. Under a dedicated worker account the two directories have different writers and so different
// modes (gunbc.roadmap.roadmap_dispatch_actuator attempt_state_prepare_argvs_for_instance); the srv1 lab
// refused the first supervised worker's check write into the attempt directory's place for both.
type HarnessAcceptanceRoute {
  inbox: String
  node_id: String
  attempt_key: String
  outcome_directory: String
}

type HarnessSupervision
  = Unsupervised
  | SupervisedRounds { chain_fingerprint: String, check_prompt: String, check_directory: String, round_steps: Int, acceptance: HarnessAcceptanceRoute }

type HarnessTurnConfig {
  backend_url: String
  model: String
  max_tokens: Int
  serving_unit: HarnessServingUnit
  reasoning_mode: HarnessReasoningLevel
  wire_shape: HarnessWireShape
  system_prompt: String
  supervision: HarnessSupervision
  request_scratch_path: FilePath
  events_path: FilePath
  context_budget: TokenCount
  request_deadline: Second
  environment: HarnessToolEnvironment
  completion: HarnessTurnCompletion
  backend_access: HarnessBackendAccess
  acceptance_capacity: HarnessAcceptanceCapacity
}

// THE WAITING PROCESS STAYS ON THE OPERATOR-ENDPOINT ROUTE. A fleet seat is capacity acceptance
// itself needs, so a quiescent hand-in releases it and the process keeps polling the outcome file.
type HarnessAcceptanceCapacity
  = KeepBindingAlive
  | FleetSeatHeld { binding: HarnessSeatBinding, admission: AdmissionTerms }
  | FleetSeatReleasedForAcceptance { binding: HarnessSeatBinding, admission: AdmissionTerms }

// THE WINDOW THE HARNESS WORKS IN AND THE WINDOW THE ENGINE ADMITS ARE ONE NUMBER, and this field
// is how the second reaches the first. gunbc.spark.serving_desired declares the roster ceiling the
// serving units are launched with; a harness that carried its own literal would be a second
// spelling of that ceiling, free to drift the moment the serving row moves -- and the drift would
// be silent in the worst direction, because a harness budget ABOVE the engine cap does not refuse,
// it produces a request the engine rejects mid-run with the turn's work already spent.
//
// THE MEASUREMENT IS THE RUNTIME'S OWN, NOT AN ESTIMATE. gunbc.model.choice already rules on this
// for the serving side -- an observation's point is derived from an execution receipt, the prompt
// token count the runtime reported back -- and the same rule applies here: the response carries
// usage.input_tokens, so the check compares a counted fact against a declared budget rather than
// dividing bytes by an assumed characters-per-token. A chars-per-token factor would be exactly the
// heuristic DESIGN section 4 says is never necessary when the richer source exists, and here the
// richer source is already parsed and already discarded.
//
// The check fires AFTER a response rather than before a request because that is when a counted
// input size exists. It bounds the NEXT turn: this turn's input plus its tool results is a lower
// bound on what the next request carries, so a turn that already sits at the budget cannot make
// another one.
fn harness_context_exhausted(input_tokens: TokenCount, budget: TokenCount) -> Bool {
  token_count_value(t: input_tokens) >= token_count_value(t: budget)
}

// THE HARNESS EMITS THE PROVIDER EVENT SCHEMA ITSELF, rather than having its liveness reconstructed
// from outside. gunbc.roadmap.roadmap_provider_events already declares what an attempt's event stream is --
// turn.started, item.started, item.completed, turn.completed, turn.budget_exhausted, turn.failed,
// error, round.usage, the checkpoint announcement turn.alignment_checkpoint_due and the wire-log
// refusal turn.wire_log_unwritable, read line by line through jq -- and every consumer of agent
// evidence is written against it. A second stream shape
// for this one provider would be the section 3 fork; emitting the existing one makes the harness a
// first-class provider on a contract that already has readers.
//
// IT IS EMITTED BY THE TURN, NOT OBSERVED FROM THE PROCESS, and that is the load-bearing choice. An
// external observer can see that a process exists and can see that it stopped; only the turn knows
// whether it stopped having COMPLETED or having run out of steps, and only the turn knows a tool
// round happened at all. A terminal event written here is the completion receipt that separates
// done from crashed -- the distinction an outside observation of a vanished process cannot make,
// whatever container is holding it.
//
// THE WHOLE FILE IS REWRITTEN EACH STEP because Filesystem.Write is the modeled write and it is a
// replace. That is not a workaround: the event list is the fold's own accumulator, so rewriting it
// is a projection of state the loop already carries, and it means a reader sees progress DURING the
// turn rather than only at exit -- which a block-buffered stdout capture cannot offer.
type HarnessEventWrite
  = HarnessEventsWritten
  | HarnessEventsUnwritable { detail: String }

fn harness_event_type_only(event_type: String) -> String {
  serialize_json(v: json_object([json_kv(key: "type", value: json_string(s: event_type))]))
}

fn harness_event_item(event_type: String, item_type: String) -> String {
  serialize_json(v: json_object([
    json_kv(key: "type", value: json_string(s: event_type)),
    json_kv(key: "item", value: json_object([
      json_kv(key: "type", value: json_string(s: item_type)),
    ])),
  ]))
}

fn harness_event_agent_message(message: String) -> String {
  serialize_json(v: json_object([
    json_kv(key: "type", value: json_string(s: "item.completed")),
    json_kv(key: "item", value: json_object([
      json_kv(key: "type", value: json_string(s: "agent_message")),
      json_kv(key: "message", value: json_string(s: message)),
    ])),
  ]))
}

// PER-ROUND USAGE, WRITTEN RATHER THAN DECODED AND DROPPED. input_tokens and output_tokens have
// always been parsed -- the compaction gate reads the first and the terminal line prints both --
// but nothing persisted them, so the context size at each round and the tokens produced for it were
// observable only while the turn was still in memory. Reconstructing a rate afterwards meant
// pairing assistant-message CHARACTER counts against durations the host log rounds to the nearest
// minute, which answers "roughly" and cannot answer "did this round decode slowly or wait in a
// queue". Both are now recorded at the round that produced them.
//
// THE CLOCK IS READ THROUGH ITS TYPED SURFACE AND ITS REFUSAL IS CARRIED, not defaulted. A failed
// clock read emits clock_refused with the detail instead of an epoch_ms, so "the clock did not
// answer" and "this round happened at time T" are different states in the stream. Writing a zero
// would fabricate an instant, and a consumer differencing two of them would compute a plausible
// interval from an event that never had a time -- the fabricated-plausible-output failure applied
// to a measurement, which is the one place it is hardest to notice.
// HOW MANY TOOL CALLS THE ROUND CARRIED, COUNTED FROM THE RESPONSE BLOCKS. Zero is a round the model
// spent entirely on reasoning or prose, which the strip paints as its own kind: a worker that thinks
// for four rounds and reads for none is a different shape from one that reads for four, and a count
// of the model's tool_use blocks is a fact the harness holds, not a parse of a shell string.
fn harness_event_round_usage(
  step: Int,
  input_tokens: TokenCount,
  output_tokens: TokenCount,
  clock: ClockUnixMillisRead,
  tool_calls: Int,
  files_changed: Int?,
) -> String {
  serialize_json(v: json_object(concat([
    json_kv(key: "type", value: json_string(s: "round.usage")),
    json_kv(key: "step", value: json_int(n: step)),
    json_kv(key: "input_tokens", value: json_int(n: token_count_value(t: input_tokens))),
    json_kv(key: "output_tokens", value: json_int(n: token_count_value(t: output_tokens))),
    json_kv(key: "tool_calls", value: json_int(n: tool_calls)),
    match clock {
      ClockUnixMillisObserved { millis: m } => json_kv(key: "epoch_ms", value: json_int(n: m))
      ClockUnixMillisRefused { detail: d } =>
        json_kv(key: "clock_refused", value: json_string(s: d))
    },
  ], match files_changed {
    Present { value: n } => [json_kv(key: "files_changed", value: json_int(n: n))]
    Absent => []
  })))
}

// THE ROUND WHOSE COUNTS WERE NOT OBSERVED, WRITTEN AS ITS OWN EVENT. It is a separate type rather
// than a round.usage with zeros for the same reason clock_refused is a separate key beside epoch_ms:
// a reader differencing zeros computes a plausible rate from a measurement that never happened.
// THE READER'S HALF OF THAT SENTENCE WAS FALSE WHEN IT WAS FIRST WRITTEN (review 63779): it claimed
// gunbc.harness.harness_throughput already refused a round.usage missing its output_tokens, and
// that module was in fact defaulting the count to 0, so emitting fabricated counts here would have
// been absorbed rather than caught. It refuses now -- an unreadable required count makes the ledger
// RoundsUnobserved with a located cause -- and that is what makes writing this event, rather than a
// round.usage of zeros, the difference between a refusal the reader reports and a rate nobody can
// tell is wrong.
fn harness_event_round_usage_unavailable(step: Int, cause: String, clock: ClockUnixMillisRead) -> String {
  serialize_json(v: json_object([
    json_kv(key: "type", value: json_string(s: "round.usage_unavailable")),
    json_kv(key: "step", value: json_int(n: step)),
    json_kv(key: "cause", value: json_string(s: cause)),
    match clock {
      ClockUnixMillisObserved { millis: m } => json_kv(key: "epoch_ms", value: json_int(n: m))
      ClockUnixMillisRefused { detail: d } => json_kv(key: "clock_refused", value: json_string(s: d))
    },
  ]))
}

// HOW MANY PATHS THE WORKTREE REPORTS AS CHANGED, READ AFTER THE ROUND'S TOOLS RAN. This is the
// fact the dashboard strip paints a write round with, and it is an OBSERVATION of the tree rather
// than a classification of the command that ran -- parsing a shell string for a redirect or a
// heredoc would be a heuristic where a fact is available. The git op is repository-addressed and
// pointed at the attempt worktree explicitly; the ambient form would have counted the harness's
// own checkout, which is the wrong tree and would have reported a clean run on every round.
//
// A FAILED READ IS ABSENT, NOT ZERO. "git did not answer" and "git answered zero" have opposite
// meanings for the strip, and the ledger's files_changed is optional for exactly this case.
fn harness_worktree_files_changed(environment: HarnessToolEnvironment) -> Int? {
  let status = git.Inspect.WorkingTreeStatus(repository_path: environment.working_directory as String)
  if !status.success {
    none
  } else {
    Present { value: list_length(items: split(s: status.entries_nul, delimiter: "\u{0}") |> filter(e => e != "")) }
  }
}

// A SPENT STEP BUDGET IS ITS OWN TERMINAL, NOT A FAILURE. The budget is the harness's construction --
// the bound that makes the loop total -- so reaching it is the loop ending exactly as designed, with
// whatever work the rounds produced sitting in the worktree for the belt to commit and judge. It was
// written as turn.failed until 2026-09-05, and the dashboard duly read "Agent failed" beside
// "Verification passed" on the same row, which the operator could not reconcile: the agent had not
// failed, it had been stopped. A consumer that wants the two conflated can join them; one that wants
// them apart could not split a single event type, so the split is made where the fact is known.

fn harness_event_turn_budget_exhausted(steps_taken: Int) -> String {
  serialize_json(v: json_object([
    json_kv(key: "type", value: json_string(s: "turn.budget_exhausted")),
    json_kv(key: "steps_taken", value: json_int(n: steps_taken)),
  ]))
}

fn harness_event_turn_failed(message: String) -> String {
  serialize_json(v: json_object([
    json_kv(key: "type", value: json_string(s: "turn.failed")),
    json_kv(key: "error", value: json_object([
      json_kv(key: "message", value: json_string(s: message)),
    ])),
  ]))
}

// THE WIRE LOG'S REFUSAL IS AN EVENT, NOT A TERMINAL. The event stream is the terminal record of a
// turn; the wire log is recoverable evidence -- its bytes can be reconstructed from durable state,
// and its absence degrades diagnosis, never the work. Killing the turn on a logging write would
// trade the work for the receipt, so a refused wire-log write is recorded here with the host's
// detail and the round proceeds exactly as it would have. The reader (gunbc.roadmap.roadmap_provider_events)
// admits it as non-terminal with provider state unchanged, following the round.usage arm.
fn harness_event_wire_log_unwritable(detail: String) -> String {
  serialize_json(v: json_object([
    json_kv(key: "type", value: json_string(s: "turn.wire_log_unwritable")),
    json_kv(key: "detail", value: json_string(s: detail)),
  ]))
}

// A TURN WAITING FOR A SEAT IS ANNOUNCED, NOT FAILED. Before any provider call, the seat bind can
// answer Pending -- every admissible group is busy -- and the remedy harness_seat states is to ask
// again in a moment. The worker does that in place (gunbc.harness.harness_cli
// harness_bind_seat_waiting) and records each wait here so the dashboard can say "waiting for a
// serving seat" and why, instead of reading a live process with no events as a turn that never
// started. Non-terminal: the first real provider event replaces the whole stream.
fn harness_event_placement_waiting(wait: Int, wait_cap: Int, reason: String) -> String {
  serialize_json(v: json_object([
    json_kv(key: "type", value: json_string(s: "turn.placement_waiting")),
    json_kv(key: "wait", value: json_int(n: wait)),
    json_kv(key: "wait_cap", value: json_int(n: wait_cap)),
    json_kv(key: "reason", value: json_string(s: reason)),
  ]))
}

// EACH TOOL USE IS WRITTEN AS THE KIND OF TOOL IT WAS. The item type is derived from the use's own
// HarnessTool through gunbc.harness.harness_tool_kind -- the declaration the reader inverts -- so a
// file read is not reported as a command. A name the harness does not declare is written as the
// unrecognized kind, which is what the dispatcher did with it: it refused. A block that is not a
// tool use is no item at all; harness_tool_use_blocks never hands one over, and the arms say so
// rather than labelling it.
fn harness_tool_use_item_events(block: HarnessWireBlock) -> List<String> {
  match block {
    WireToolUseBlock { id: _, name: name, input: _ } => {
      let item_type = harness_tool_read_item_type(read: harness_tool_of_wire_name(name: name))
      [
        harness_event_item(event_type: "item.started", item_type: item_type),
        harness_event_item(event_type: "item.completed", item_type: item_type),
      ]
    }
    WireTextBlock { text: _ } => []
    WireThinkingBlock { thinking: _ } => []
  }
}

fn harness_tool_round_events(uses: List<HarnessWireBlock>) -> List<String> {
  fold(
    uses,
    init: [],
    f: (acc, u) => concat(acc, harness_tool_use_item_events(block: u)),
  )
}

fn harness_events_body(events: List<String>) -> String {
  concat(join(events, "\n"), "\n")
}

fn harness_write_events(config: HarnessTurnConfig, events: List<String>) -> HarnessEventWrite {
  let written = Filesystem.Write(
    path: config.events_path as String,
    content: harness_events_body(events: events),
  )
  if written.success {
    HarnessEventsWritten
  } else {
    HarnessEventsUnwritable { detail: written.error }
  }
}

// A TERMINAL IS A PROVIDER OBSERVATION OR A HARNESS REFUSAL, and neither of them is "the task is
// done". That separation is the whole of DCH-2's ruling on stop reasons, and it is structural here:
// there is no TurnSucceeded constructor to reach for.
//
// The reason is measured rather than cautious. On this transport at least two upstream causes
// produce the same observed end_turn -- a model genuinely finishing, and a serving package whose
// configured stop string collides with ordinary content, which DCH-0p reproduced with a tiny prompt
// and removed by rebuilding the package. The wire label cannot distinguish them, so the harness
// reports the label and says so, and whether the WORK was done is decided by external pinned
// verification against the attempt head -- never here.
// TurnUsageUnavailable IS ITS OWN OUTCOME rather than a reuse of TurnResponseUnreadable, because
// the two have different remedies: an unreadable response is a transport or schema problem, while
// this is a response the codec READ whose usage object the serving side did not supply in the shape
// it declares. It is not folded into the ordinary continuation either -- harness_context_exhausted
// and harness_compaction_due are the two mechanisms that keep a turn inside its window, both compare
// the backend's COUNTED input against the declared budget, and neither can run on a count that was
// never observed. Continuing with a fabricated 0 would report "the context is empty" for a turn that
// may be at the ceiling, so the line stops and names which member was missing.
type HarnessTurnOutcome
  = TurnProviderStopped {
      wire_stop_reason: String
      assistant_text: String
      steps_taken: Int
      input_tokens: Int
      output_tokens: Int
    }
  | TurnCompletedByArtifact { path: String, steps_taken: Int }
  | TurnStepBudgetExhausted { steps_taken: Int }
  | TurnTransportRefused { detail: String }
  | TurnResponseUnreadable { cause: String }
  | TurnBackendRefusedUnexplained { cause: String, resumable: Bool, steps_taken: Int }
  | TurnResumeRefused { cause: String }
  | TurnRequestUnwritable { path: String, detail: String }
  | TurnContextWindowExhausted { input_tokens: Int, budget: Int, steps_taken: Int }
  | TurnTruncatedMidToolCall { output_tokens: Int, ceiling: Int, steps_taken: Int }
  | TurnThinkingFormatInvalid { cause: String, steps_taken: Int }
  | TurnUsageUnavailable { cause: String, steps_taken: Int }
  | TurnSubmissionUndecodable { reason: String, steps_taken: Int }
  | TurnStoppedBySupervision { verdict: String, detail: String, steps_taken: Int }
  | TurnSupervisionUnavailable { cause: String, steps_taken: Int }
  | TurnAcceptanceUnavailable { cause: String, steps_taken: Int }
  | TurnHostedQuotaFull { wire: String, steps_taken: Int }
  | TurnHostedQuotaUnleasable { detail: String, steps_taken: Int }
  | TurnHostedFailure { failure: HostedHttpFailure, steps_taken: Int }
  | TurnRequestPending { re_deliveries: Int, steps_taken: Int }

fn harness_outcome_label(outcome: HarnessTurnOutcome) -> String {
  match outcome {
    TurnProviderStopped { wire_stop_reason: r, assistant_text: _, steps_taken: _, input_tokens: _, output_tokens: _ } =>
      join(["provider-stopped:", r], "")
    TurnCompletedByArtifact { path: _, steps_taken: _ } => "completed-by-artifact"
    TurnStepBudgetExhausted { steps_taken: _ } => "step-budget-exhausted"
    TurnTransportRefused { detail: _ } => "transport-refused"
    TurnResponseUnreadable { cause: _ } => "response-unreadable"
    TurnBackendRefusedUnexplained { cause: _, resumable: _, steps_taken: _ } => "backend-refused-unexplained"
    TurnResumeRefused { cause: _ } => "resume-refused"
    TurnRequestUnwritable { path: _, detail: _ } => "request-unwritable"
    TurnContextWindowExhausted { input_tokens: _, budget: _, steps_taken: _ } =>
      "context-window-exhausted"
    TurnTruncatedMidToolCall { output_tokens: _, ceiling: _, steps_taken: _ } =>
      "truncated-mid-tool-call"
    TurnThinkingFormatInvalid { cause: _, steps_taken: _ } => "thinking-format-invalid"
    TurnUsageUnavailable { cause: _, steps_taken: _ } => "usage-unavailable"
    TurnSubmissionUndecodable { reason: _, steps_taken: _ } => "submission-undecodable"
    TurnStoppedBySupervision { verdict: _, detail: _, steps_taken: _ } => "stopped-by-supervision"
    TurnSupervisionUnavailable { cause: _, steps_taken: _ } => "supervision-unavailable"
    TurnAcceptanceUnavailable { cause: _, steps_taken: _ } => "acceptance-unavailable"
    TurnHostedQuotaFull { wire: _, steps_taken: _ } => "hosted-quota-full"
    TurnHostedQuotaUnleasable { detail: _, steps_taken: _ } => "hosted-quota-unleasable"
    TurnHostedFailure { failure: f, steps_taken: _ } => hosted_http_failure_label(f: f)
    TurnRequestPending { re_deliveries: _, steps_taken: _ } => "request-pending"
  }
}

fn harness_outcome_detail(outcome: HarnessTurnOutcome) -> String {
  match outcome {
    TurnProviderStopped { wire_stop_reason: r, assistant_text: t, steps_taken: n, input_tokens: i, output_tokens: o } =>
      join([
        "stop_reason=", r,
        " steps=", to_string(value: n),
        " input_tokens=", to_string(value: i),
        " output_tokens=", to_string(value: o),
        "\n--- assistant text ---\n", t,
        "\n--- end ---\n",
        "NOTE: the wire stop reason is a provider observation, not a claim that the task was done.",
      ], "")
    TurnCompletedByArtifact { path, steps_taken: n } =>
      join(["the artifact the turn exists to produce is present at ", path, " after ", to_string(value: n), " tool rounds"], "")
    TurnStepBudgetExhausted { steps_taken: n } =>
      join([
        "the turn used its whole step budget of ", to_string(value: n),
        " tool rounds without the provider reaching a terminal stop reason",
      ], "")
    TurnContextWindowExhausted { input_tokens: i, budget: b, steps_taken: n } =>
      join([
        "the backend counted ", to_string(value: i),
        " input tokens after ", to_string(value: n),
        " tool rounds, against a declared budget of ", to_string(value: b),
        "; the turn stopped rather than issuing a request the engine would refuse mid-run",
      ], "")
    TurnTruncatedMidToolCall { output_tokens: o, ceiling: c, steps_taken: n } =>
      join([
        "the provider stopped at the max_tokens ceiling of ", to_string(value: c),
        " after ", to_string(value: n), " tool rounds, having emitted ", to_string(value: o),
        " output tokens, with a tool call still open. Its arguments are truncated, so the command was",
        " NOT executed: this harness writes files by heredoc, and running a cut-off command would",
        " have written a partial file and returned success. Raise the ceiling if the work genuinely",
        " needs a longer single call; the refusal is not evidence that it does.",
      ], "")
    TurnThinkingFormatInvalid { cause: c, steps_taken: n } =>
      join(["after ", to_string(value: n), " tool rounds: ", c], "")
    TurnUsageUnavailable { cause: c, steps_taken: n } =>
      join([
        "after ", to_string(value: n), " tool rounds the round's token counts were not observed: ", c,
        "; the turn stopped rather than checking its context budget against a count nobody measured",
      ], "")
    TurnSubmissionUndecodable { reason, steps_taken: n } =>
      join([
        "after ", to_string(value: n), " tool rounds: ", harness_submission_terminal_cause(reason: reason),
      ], "")
    TurnStoppedBySupervision { verdict: v, detail: d, steps_taken: n } =>
      join(["after ", to_string(value: n), " tool rounds the alignment check returned ", v, " and the session stopped: ", d], "")
    TurnAcceptanceUnavailable { cause: c, steps_taken: n } =>
      join(["after ", to_string(value: n), " tool rounds the worker handed in, and acceptance could not decide: ", c], "")
    TurnSupervisionUnavailable { cause: c, steps_taken: n } =>
      join(["after ", to_string(value: n), " tool rounds the alignment check could not decide, so the session stopped rather than continue unsupervised: ", c], "")
    TurnHostedQuotaFull { wire: w, steps_taken: n } =>
      join([
        "after ", to_string(value: n), " tool rounds the local quota ledger refused the request (", w,
        "); it was not sent. The ledger is this fleet's own pre-check, not an answer from the upstream, whose count it can differ from at a window boundary",
      ], "")
    TurnHostedQuotaUnleasable { detail: d, steps_taken: n } =>
      join([
        "after ", to_string(value: n), " tool rounds the hosted upstream's quota could not be leased (", d,
        "); the request was not sent, because an unleased request is one the fleet cannot account for",
      ], "")
    TurnHostedFailure { failure: f, steps_taken: k } =>
      join([
        "after ", to_string(value: k), " tool rounds ", hosted_http_failure_wire(f: f),
        "; the turn stopped rather than retrying, and a caller that waits owns when it asks again",
      ], "")
    TurnRequestPending { re_deliveries: w, steps_taken: n } =>
      join([
        "after ", to_string(value: n), " tool rounds the request drew no answer: the pool front answered 503, 502 or 429, or the post returned without any response at all",
        " (the client's --max-time is only its observation window). No output came back and the request had no effect, so IT STANDS: this worker slept beside nothing and",
        " retried nothing in-process; the session carries one durable turn.request_pending event and the belt re-delivers the same round when the next",
        " re-delivery is due (", to_string(value: w), " recorded so far), for as long as it takes. The session is not ended, not failed, and not an engine refusal.",
      ], "")
    TurnTransportRefused { detail: d } => d
    TurnResponseUnreadable { cause: c } => c
    TurnBackendRefusedUnexplained { cause: c, resumable: _, steps_taken: _ } => c
    TurnResumeRefused { cause: c } => c
    TurnRequestUnwritable { path: p, detail: d } =>
      join(["could not write the request body to ", p, ": ", d], "")
  }
}

// REQUEST CONSTRUCTION. The message list is carried as already-encoded JSON values rather than as
// modelled AnthropicChatMessage values, and that is a deliberate narrowing for this slice: the loop
// appends an assistant turn it received as JSON and a user turn of tool results it just built, so
// round-tripping both through the modelled type and back would add a decode it does not need and a
// re-encode that could differ from the bytes the provider actually sent. The DCH-2 requirement to
// echo an assistant turn back VERBATIM, thinking blocks included, is exactly the property that
// re-encoding puts at risk.
fn harness_request_json(
  config: HarnessTurnConfig,
  messages: List<JsonValue>,
  reasoning_kwargs: List<JsonKeyValue>,
) -> JsonValue {
  match config.wire_shape {
    AnthropicMessagesShape => harness_messages_request_json(config: config, messages: messages, reasoning_kwargs: reasoning_kwargs)
    OpenAiChatCompletionsShape => harness_chat_request_json(config: config, messages: messages, reasoning_kwargs: reasoning_kwargs)
  }
}

fn harness_messages_request_json(
  config: HarnessTurnConfig,
  messages: List<JsonValue>,
  reasoning_kwargs: List<JsonKeyValue>,
) -> JsonValue {
  json_object(concat([
    json_kv(key: "model", value: json_string(s: config.model)),
    json_kv(key: "max_tokens", value: json_int(n: config.max_tokens)),
    json_kv(key: "system", value: json_string(s: config.system_prompt)),
    json_kv(key: "messages", value: json_array(elements: messages)),
    json_kv(key: "tools", value: harness_tool_contract_json(shape: AnthropicMessagesShape)),
  ], reasoning_kwargs))
}

// THE CHAT SHAPE: the system prompt is the first message, and a tool is a function whose parameters
// are the same schema the messages shape sends as input_schema -- one schema, two envelopes.
fn harness_chat_request_json(
  config: HarnessTurnConfig,
  messages: List<JsonValue>,
  reasoning_kwargs: List<JsonKeyValue>,
) -> JsonValue {
  json_object(concat([
    json_kv(key: "model", value: json_string(s: config.model)),
    json_kv(key: "max_tokens", value: json_int(n: config.max_tokens)),
    json_kv(key: "messages", value: json_array(elements: concat([
      json_object([
        json_kv(key: "role", value: json_string(s: "system")),
        json_kv(key: "content", value: json_string(s: config.system_prompt)),
      ]),
    ], messages))),
    json_kv(key: "tools", value: harness_tool_contract_json(shape: OpenAiChatCompletionsShape)),
  ], reasoning_kwargs))
}

// THE TOOL CONTRACT IS RENDERED ONCE AND READ TWICE: it is the tools array the request carries, and
// it is part of the normalized request identity a turn is placed under (gunbc.harness.harness_cli
// harness_model_request_inputs), so the identity cannot drift from what the model is actually
// offered. One schema, two envelopes.
fn harness_tool_contract_json(shape: HarnessWireShape) -> JsonValue {
  harness_offered_tools_json(shape: shape)
}

fn harness_tool_contract_wire(shape: HarnessWireShape) -> String {
  serialize_json(v: harness_tool_contract_json(shape: shape))
}

// INLINE REASONING IS DECODED, NOT REFUSED. When the serving unit carries no reasoning parser, a
// thinking-mode completion arrives as one text block: reasoning, the end token, then speech. That
// is the encoder's documented completion format, and the vendor ships the decoder for it
// (parse_message_from_completion_text); splitting it here is the harness realizing that parse, the
// same parse a runtime reasoning parser would realize server-side, where one exists for the model
// -- this fleet's build reportedly has none for v4, so the client parse is the only one available. What the encoder calls
// invalid -- thinking requested and no closer, or more than one closer -- refuses below.
// THE SPLIT IS ON THE FIRST CLOSER, AND ONLY THE FIRST. parse_message_from_completion_text reads
// until the end token once and treats everything after it as speech; a later occurrence of the same
// string is content -- the model quoting the token, or writing a file that mentions it -- and the
// encoder never asserts on it. An earlier revision of this arm refused a second closer as an invalid
// format; that rule was this harness's invention, and it stopped a sixteen-round Think Max run that
// had done nothing wrong. The encoder's one assertion, a MISSING closer under thinking, stands.
fn harness_split_text_block(unit: HarnessServingUnit, text: String) -> List<HarnessWireBlock> {
  match harness_unit_thinking_end_token(unit: unit) {
    Absent => [WireTextBlock { text: text }]
    Present { value: token } => {
      let parts = split(s: text, delimiter: token as String)
      match parts.first() {
        Absent => [WireTextBlock { text: text }]
        Present { value: reasoning } =>
          if list_length(items: parts) < 2 {
            [WireTextBlock { text: text }]
          } else {
            let speech = join(parts.skip(n: 1), token as String)
            concat(
              if reasoning == "" { [] } else { [WireThinkingBlock { thinking: reasoning }] },
              if speech == "" { [] } else { [WireTextBlock { text: speech }] },
            )
          }
      }
    }
  }
}

fn harness_split_inline_reasoning(unit: HarnessServingUnit, blocks: List<HarnessWireBlock>) -> List<HarnessWireBlock> {
  flat_map(blocks, b => match b {
    WireTextBlock { text } =>
      match harness_unit_thinking_end_token(unit: unit) {
        Absent => [b]
        Present { value: token } => if text.contains(token as String) { harness_split_text_block(unit: unit, text: text) } else { [b] }
      }
    WireThinkingBlock { thinking: _ } => [b]
    WireToolUseBlock { id: _, name: _, input: _ } => [b]
  })
}

fn harness_has_thinking_block(blocks: List<HarnessWireBlock>) -> Bool {
  any(blocks, b => match b {
    WireThinkingBlock { thinking: _ } => true
    WireTextBlock { text: _ } => false
    WireToolUseBlock { id: _, name: _, input: _ } => false
  })
}

fn harness_assistant_message_json(unit: HarnessServingUnit, shape: HarnessWireShape, blocks: List<HarnessWireBlock>) -> JsonValue {
  match shape {
    AnthropicMessagesShape =>
      json_object([
        json_kv(key: "role", value: json_string(s: "assistant")),
        json_kv(key: "content", value: json_array(elements: map(blocks, b => harness_wire_block_json(block: b)))),
      ])
    OpenAiChatCompletionsShape => harness_chat_assistant_message_json(unit: unit, blocks: blocks)
  }
}

// THE CHAT SHAPE'S ASSISTANT REPLAY carries the model's speech as content, its reasoning as the
// guide's reasoning_content -- the field the encoder re-renders when tools are defined -- and its
// tool calls with their arguments serialized back to the JSON string they arrived as.
fn harness_chat_assistant_message_json(unit: HarnessServingUnit, blocks: List<HarnessWireBlock>) -> JsonValue {
  let speech = join(flat_map(blocks, b => match b { WireTextBlock { text } => [text]  WireThinkingBlock { thinking: _ } => []  WireToolUseBlock { id: _, name: _, input: _ } => [] }), "")
  let reasoning = join(flat_map(blocks, b => match b { WireThinkingBlock { thinking } => [thinking]  WireTextBlock { text: _ } => []  WireToolUseBlock { id: _, name: _, input: _ } => [] }), "")
  let calls = flat_map(blocks, b => match b {
    WireToolUseBlock { id, name, input } => [json_object([
      json_kv(key: "id", value: json_string(s: id)),
      json_kv(key: "type", value: json_string(s: "function")),
      json_kv(key: "function", value: json_object([
        json_kv(key: "name", value: json_string(s: name)),
        json_kv(key: "arguments", value: json_string(s: serialize_json(v: input))),
      ])),
    ])]
    WireTextBlock { text: _ } => []
    WireThinkingBlock { thinking: _ } => []
  })
  json_object(concat(concat(
    [json_kv(key: "role", value: json_string(s: "assistant")),
     json_kv(key: "content", value: json_string(s: speech))],
    match harness_unit_reasoning_field(unit: unit) {
      Absent => []
      Present { value: field } => if reasoning == "" { [] } else { [json_kv(key: field as String, value: json_string(s: reasoning))] }
    }),
    if list_length(items: calls) == 0 { [] } else { [json_kv(key: "tool_calls", value: json_array(elements: calls))] }))
}

// A THINKING BLOCK REPLAYS AS A THINKING BLOCK. Until 2026-09-04 this arm re-labelled the model's
// reasoning as a text block on the next turn, which never mattered because no thinking block had
// ever arrived. With the reasoning switch declared and a parser-equipped server, they will -- and
// the official guide requires prior turns' reasoning to be passed back AS reasoning, concatenated
// into the context. Replaying it as speech hands the model a transcript in which it said aloud what
// it had only thought, and then asks it to continue from there. extdeps records the requirement
// (deepseek_v4_tool_use_requires_reasoning_replay); this arm is the harness honoring it.
fn harness_wire_block_json(block: HarnessWireBlock) -> JsonValue {
  match block {
    WireTextBlock { text } =>
      json_object([
        json_kv(key: "type", value: json_string(s: "text")),
        json_kv(key: "text", value: json_string(s: text)),
      ])
    WireThinkingBlock { thinking } =>
      json_object([
        json_kv(key: "type", value: json_string(s: "thinking")),
        json_kv(key: "thinking", value: json_string(s: thinking)),
      ])
    WireToolUseBlock { id, name, input } =>
      json_object([
        json_kv(key: "type", value: json_string(s: "tool_use")),
        json_kv(key: "id", value: json_string(s: id)),
        json_kv(key: "name", value: json_string(s: name)),
        json_kv(key: "input", value: input),
      ])
  }
}

// ALL TOOL RESULTS FOR ONE TURN GO BACK IN ONE USER MESSAGE. Treated as a hypothesis with a
// predicted failure rather than as a fact inherited from prior art: if this transport does not
// require the batching, nothing breaks; if it does, splitting them is the failure that presents as
// the model losing track of what it asked for.
// THE WORKER IS TOLD WHAT IT IS SPENDING, because until now it was not and it behaved exactly like
// something with no budget. Transcripts show the failure precisely: on t08 the worker reached a
// correct and complete plan at round six -- "I need to: 1. Delete roadmap_site_readback_script
// 2. Delete roadmap_site_digest_readback_script ..." -- and then spent rounds seven through
// twenty-one re-checking imports it had already read. It never acted, and nothing ever told it that
// deferring had a cost.
//
// THE ROUND COUNT IS A FACT THE HARNESS ALREADY HOLDS, so surfacing it is not a prompt trick: the
// loop carries steps_remaining and the worker cannot see it. A budget the executor knows and the
// actor does not is the same asymmetry harness_tool's own annotation objects to -- "the harness knew
// the limit and the caller could not see it" -- written one layer up.
//
// It rides on the tool-result message rather than a new message because the pairing after the
// opening brief must stay assistant/user: an extra turn between them would break the alternation
// the compaction logic depends on.
//
// ONLY A TURN THAT ENDS AT ZERO COUNTS DOWN. An unsupervised turn ends when its rounds run out, so its
// notice presses to act before they do. A supervised session never ends at a round boundary
// (gunbc.plans.harness_session_lifecycle, requirement 1), so it gets no notice at all: a countdown
// to a boundary the worker should not be aware of is exactly what made workers yield and plan to
// resume (srv1 lab, 2026-10-11).
fn harness_budget_notice_text(steps_remaining: Int) -> String {
  join([
    harness_premise_text(p: RoundsRemaining { rounds: steps_remaining }), " ",
    harness_conclusion_text(c: ActBeforeTheRoundsRun { rounds: steps_remaining }),
  ], "")
}

fn harness_budget_notice_block(steps_remaining: Int) -> JsonValue {
  json_object([
    json_kv(key: "type", value: json_string(s: "text")),
    json_kv(key: "text", value: json_string(s: harness_budget_notice_text(steps_remaining: steps_remaining))),
  ])
}

fn harness_supervision_counts_down(s: HarnessSupervision) -> Bool {
  match s {
    Unsupervised => true
    SupervisedRounds { chain_fingerprint: _, check_prompt: _, check_directory: _, round_steps: _, acceptance: _ } => false
  }
}

fn harness_tool_result_messages_json(
  shape: HarnessWireShape,
  results: List<HarnessToolResult>,
  steps_remaining: Int,
  countdown: Bool,
) -> List<JsonValue> {
  match shape {
    AnthropicMessagesShape =>
      [json_object([
        json_kv(key: "role", value: json_string(s: "user")),
        json_kv(key: "content", value: json_array(
          elements: concat(
            map(results, r => harness_tool_result_block(tool_use_id: r.tool_use_id, text: r.text, is_error: r.is_error)),
            if countdown { [harness_budget_notice_block(steps_remaining: steps_remaining)] } else { [] as List<JsonValue> },
          ),
        )),
      ])]
    OpenAiChatCompletionsShape =>
      concat(
        map(results, r => json_object([
          json_kv(key: "role", value: json_string(s: "tool")),
          json_kv(key: "tool_call_id", value: json_string(s: r.tool_use_id)),
          json_kv(key: "content", value: json_string(s: r.text)),
        ])),
        if countdown {
          [json_object([
            json_kv(key: "role", value: json_string(s: "user")),
            json_kv(key: "content", value: json_string(s: harness_budget_notice_text(steps_remaining: steps_remaining))),
          ])]
        } else { [] as List<JsonValue> },
      )
  }
}

fn harness_user_text_message_json(shape: HarnessWireShape, text: String) -> JsonValue {
  match shape {
    AnthropicMessagesShape =>
      json_object([
        json_kv(key: "role", value: json_string(s: "user")),
        json_kv(key: "content", value: json_array(elements: [
          json_object([
            json_kv(key: "type", value: json_string(s: "text")),
            json_kv(key: "text", value: json_string(s: text)),
          ]),
        ])),
      ])
    OpenAiChatCompletionsShape =>
      json_object([
        json_kv(key: "role", value: json_string(s: "user")),
        json_kv(key: "content", value: json_string(s: text)),
      ])
  }
}

fn harness_blocks_text(blocks: List<HarnessWireBlock>) -> String {
  join(
    map(blocks, b => match b {
      WireTextBlock { text } => text
      WireThinkingBlock { thinking: _ } => ""
      WireToolUseBlock { id: _, name: n, input: _ } => join(["[tool_use ", n, "]"], "")
    }),
    "",
  )
}

fn harness_tool_use_blocks(blocks: List<HarnessWireBlock>) -> List<HarnessWireBlock> {
  filter(blocks, b => match b {
    WireToolUseBlock { id: _, name: _, input: _ } => true
    WireTextBlock { text: _ } => false
    WireThinkingBlock { thinking: _ } => false
  })
}

fn harness_tool_use_id(block: HarnessWireBlock) -> String {
  match block {
    WireToolUseBlock { id, name: _, input: _ } => id
    WireTextBlock { text: _ } => ""
    WireThinkingBlock { thinking: _ } => ""
  }
}

// A TOOL RESULT IS ONE FACT, ENCODED TWO WAYS. The execution yields a neutral record; the messages
// shape wraps it as a tool_result content block inside a user message, the chat shape sends it as
// its own role=tool message keyed by the call id. Neither encoder is the result.
type HarnessToolResult {
  tool_use_id: String
  text: String
  is_error: Bool
}

type HarnessExecutedTools {
  environment: HarnessToolEnvironment
  results: List<HarnessToolResult>
}

fn harness_accumulate_tool(acc: HarnessExecutedTools, block: HarnessWireBlock) -> HarnessExecutedTools {
  let step = harness_execute_tool_use(environment: acc.environment, block: block)
  HarnessExecutedTools {
    environment: step.environment,
    results: concat(acc.results, [
      HarnessToolResult {
        tool_use_id: harness_tool_use_id(block: block),
        text: harness_outcome_text(outcome: step.outcome),
        is_error: harness_outcome_is_error(outcome: step.outcome),
      },
    ]),
  }
}

fn harness_execute_tools(
  environment: HarnessToolEnvironment,
  uses: List<HarnessWireBlock>,
) -> HarnessExecutedTools {
  fold(
    uses,
    init: HarnessExecutedTools { environment: environment, results: [] },
    f: (acc, u) => harness_accumulate_tool(acc: acc, block: u),
  )
}

// THE RESPONSE IS KEPT BESIDE THE REQUEST, EVERY ROUND. A refusal raised on a completion used to
// destroy its own evidence: the request was on disk, the body that triggered the refusal was not,
// and the first over-strict refusal this harness raised in production was therefore undiagnosable
// after the fact. The body is written before it is decoded, so whatever the decoder says about it
// can be checked against the bytes it said it about.
// ONE ROUND: write the request, post it, decode the answer.
// A TOOL CALL THAT RAN OUT OF TOKENS IS NOT A TOOL CALL. The provider reports max_tokens when it
// stopped because the ceiling was reached rather than because the answer ended, and a tool_use block
// cut off at that boundary is TRUNCATED -- its arguments are whatever fitted. This harness's one
// tool runs a shell command, and its declared write forms are heredoc and in-place edit, so a
// truncated command is a PARTIAL FILE WRITE that returns exit 0. The loop would then continue
// against a tree it had silently corrupted, which is the fabricated-plausible-output failure DESIGN
// section 5 forbids, arrived at through a hole nobody opened deliberately: the round arm branched on
// whether tool calls were PRESENT and never asked whether they were COMPLETE.
//
// THE REFUSAL IS NOT A SMALLER CEILING. Raising max_tokens moves the boundary; it does not remove
// it, and a ceiling large enough for every possible file is not a thing that exists. The wall is
// that a truncated call must not execute at all.
fn harness_stop_reason_truncated(reason: AnthropicStopReason) -> Bool {
  match reason {
    MaxTokens => true
    EndTurn => false
    ToolUse => false
    StopSequence => false
    PauseTurn => false
    Refusal => false
    ModelContextWindowExceeded => false
  }
}


// THE INVALID SHAPE IS A TRUNCATED THINKING BLOCK, AND TRUNCATION IS A PROPERTY OF THE STOP REASON,
// NOT OF THE BLOCK LIST. The hazard this refuses is the one the seam names at
// harness_unit_server_parses_reasoning: thinking requested, the completion stopped at the token
// ceiling mid-thought, and the closer never arrived -- so whatever text exists is partial reasoning,
// and a truncated chain of thought must not be transcribed as speech. Checked on the RAW blocks so a
// multiple-closer text is judged before any split could hide it, and only when thinking was requested
// -- which is asked of the SEAM rather than of the level alone, and the difference is load-bearing:
// on DeepSeek the off level genuinely requests nothing and a completion with no closer is well-formed.
// A thinking block already present (a parser-equipped server, which vLLM is for the GLM family)
// satisfies the requirement.
//
// A COMPLETED COMPLETION CARRYING NO REASONING IS NOT THAT SHAPE. An earlier revision of this
// predicate refused ANY closer-less completion under a requested thinking mode, on the claim that
// GLM-5.3-Flash reasons unconditionally so an empty reasoning half is always a defect. Production
// falsified the claim, 2026-09-20 (dispatch probe, attempt-state
// shell-typed-invocation-a19c151825c6f6eff): at reasoning_effort max the model answered a tool round
// with finish_reason `tool_calls`, reasoning null and zero reasoning tokens -- it went straight to
// its tool calls, the completion was complete, and the refusal killed a healthy four-round turn.
// The stop reason is the discriminator the invariant actually needs: `length` mid-thinking is the
// truncation; a completed stop with no thinking block is a model that did not think this round.
fn harness_thinking_format_cause(unit: HarnessServingUnit, blocks: List<HarnessWireBlock>, mode: HarnessReasoningLevel, stop: AnthropicStopReason) -> String {
  if harness_unit_thinking_requested(unit: unit, level: mode)
    && harness_stop_reason_truncated(reason: stop)
    && !harness_has_thinking_block(blocks: harness_split_inline_reasoning(unit: unit, blocks: blocks)) {
    "invalid thinking format: thinking was requested and the completion stopped at the token ceiling with no end-of-thinking closer and no thinking block; the chain of thought is truncated, and a truncated chain of thought must not be transcribed as speech"
  } else {
    ""
  }
}

// THE WIRE LOG MAKES EVERY ROUND DURABLE, not just the last one. The request scratch pair is
// overwritten each round -- its job is the POST and the decode -- so a finished turn left exactly
// one round's bytes on disk and a multi-round conversation's earlier wire content existed only in
// the process's memory. This log is the attempt lineage owning its wire record: one file per
// round per direction under the attempt's log directory, named by the SAME round number the
// round.usage event carries (round N is the request posted with steps_taken == N - 1), so the
// event stream and the byte log cross-reference without a second numbering.
//
// THE LAYOUT DERIVES FROM events_path the way the response-keep derives from the request scratch
// path: join([config.events_path as String, ".wire/", to_string(round), kind]) with kind one of
// ".request.json" and ".response.json" -- beside the events file, in a directory the reader can
// derive without guessing. Filesystem.Write does not create parent directories, and these writes
// do not invent one: they rely on the wire directory already existing, the SAME reliance the
// request scratch and response-keep writes carry for the attempt state directory the dispatch
// layer provisions. Where the directory has not been provisioned the write refuses, the round
// records turn.wire_log_unwritable, and the turn continues -- the wire log is recoverable
// evidence, and trading the turn's work for its receipt would be the wrong trade in both
// directions.
type HarnessPostedRound {
  read: HarnessResponseRead
  wire_log_detail: String?
  inflight_release_detail: String?
  hosted_failure: HostedHttpFailure?
  unexplained: UnexplainedEngineRefusal?
  pool_fault: OperatorRoundFault?
  // WHY THIS ROUND STANDS PENDING, in the front's own words, or none when the round is not a patient-request
  // case. Read ONCE from the post's evidence, so a reader never has to re-derive a request's standing.
  pending_cause: String?
}

// AN IN-FLIGHT SEAT THAT DID NOT RELEASE IS NOT A REFUSAL OF THE ROUND -- the request went out and its
// answer is real -- but it keeps charging every later window until someone releases it, so it is an event
// with the seat's name, the same standing the wire log has.
fn harness_event_inflight_release_unrecorded(detail: String) -> String {
  serialize_json(v: json_object([
    json_kv(key: "type", value: json_string(s: "turn.inflight_release_unrecorded")),
    json_kv(key: "detail", value: json_string(s: detail)),
  ]))
}

// A HOSTED ROUND THAT COULD NOT BE CHARGED IS NOT POSTED, and the loop is told which way it was refused.
// The charge is recorded before the request goes out (gunbc.harness.harness_hosted_route
// harness_hosted_round_charge), so nothing about the round's quota is left to do after the answer.
type HarnessRoundPost
  = RoundPosted { posted: HarnessPostedRound }
  | RoundQuotaFull { wire: String }
  | RoundQuotaUnleasable { detail: String }


fn harness_wire_log_path(config: HarnessTurnConfig, round: Int, kind: String) -> String {
  join([config.events_path as String, ".wire/", to_string(value: round), kind], "")
}

// THE LEVEL IS RESOLVED AGAINST THE UNIT BEFORE A BYTE IS WRITTEN, and a unit that cannot express
// the requested level stops the line here rather than sending its nearest neighbour. The refusal is
// typed, located and carries both names, so the run reports which unit refused which level instead
// of returning a completion produced under a setting nobody chose.
fn harness_post_round(
  config: HarnessTurnConfig,
  messages: List<JsonValue>,
  round: Int,
) -> HarnessRoundPost {
  match harness_reasoning_kwargs_for(unit: config.serving_unit, level: config.reasoning_mode) {
    ReasoningLevelUnsupported { unit, level, cause } =>
      RoundPosted { posted: HarnessPostedRound {
        read: HarnessResponseUnreadable {
          cause: join([
            "the serving unit ", unit as String, " cannot express reasoning level ", level as String,
            ": ", cause as String,
          ], ""),
        },
        wire_log_detail: none,
        inflight_release_detail: none,
        hosted_failure: none,
        unexplained: none,
        pool_fault: none,
        pending_cause: none,
      } }
    ReasoningKwargsAdmitted { kwargs } =>
      match harness_prepare_round(config: config, messages: messages, reasoning_kwargs: kwargs, round: round) {
        RoundUnprepared { posted: p } => RoundPosted { posted: p }
        RoundPrepared { wire_request_detail: wd } =>
          match config.backend_access {
            BackendAdmittedBySeat => RoundPosted { posted: harness_send_round(config: config, round: round, header_file: none, wire_request_detail: wd) }
            BackendAdmittedByOperatorEndpoint { header_file: hf } => RoundPosted { posted: harness_send_round(config: config, round: round, header_file: Present { value: hf }, wire_request_detail: wd) }
            BackendAdmittedByHostedQuota { header_file: hf, quota: q } => harness_hosted_round_post(config: config, round: round, header_file: hf, quota: q, wire_request_detail: wd)
          }
      }
  }
}

// A HOSTED ROUND IS PREPARED, THEN CHARGED, THEN SENT -- in that order, because the charge is counted in
// the window the request ARRIVES in. Everything that can take time on this side (serializing the body,
// writing the scratch and the wire log) is done before the charge, so the charge is as close to the send
// as this process can put it. Nothing here bounds when the first byte actually leaves, so the send also
// holds an in-flight seat from before it until the transport returns (gunbc.harness.harness_seat, in-flight
// hosted sends): every later window counts the seats still held from earlier ones and charges for them as
// well as for its own send.
//
// THE CHARGE IS A CLOSE PRE-CHECK AND THE UPSTREAM'S TYPED FAILURE IS THE BACKSTOP (operator decision,
// escalation msg_46a417a3; gunbc.harness.hosted_failure): a request the pre-check admitted that the
// hosted OpenAI-compatible endpoint still refuses (429, 5xx, other 4xx, in-stream error, severed
// stream) ends the turn as TurnHostedFailure and is never retried here. POST chat/completions is not
// idempotent.
fn harness_hosted_round_post(config: HarnessTurnConfig, round: Int, header_file: NonEmptyStr, quota: HarnessHostedQuota, wire_request_detail: String?) -> HarnessRoundPost {
  match harness_hosted_inflight_read(quota: quota) {
    HostedInflightUnread { detail: d } => RoundQuotaUnleasable { detail: join(["the in-flight sends could not be counted, so the charge cannot cover them: ", d], "") }
    HostedInflightRead { pool: p, generation: _, store: store, release_hint: hint } =>
      match now_epoch_seconds() {
        Absent => RoundQuotaUnleasable { detail: "the clock could not be read as epoch seconds" }
        Present { value: now } =>
          match quota_window_start(limit: quota.per_minute, at: now) {
            Absent => RoundQuotaUnleasable { detail: "the minute window has no start at this instant" }
            Present { value: minute_start } =>
              match quota_window_start(limit: quota.per_day, at: now) {
                Absent => RoundQuotaUnleasable { detail: "the day window has no start at this instant" }
                Present { value: day_start } =>
                  harness_hosted_round_charged_post(
                    config: config, round: round, header_file: header_file, quota: quota, wire_request_detail: wire_request_detail, store: store,
                    reference: join([quota.actor as String, "@", to_string(value: now), "#round", to_string(value: round)], "") as NonEmptyStr,
                    charge: harness_hosted_round_charge(
                      quota: quota,
                      carried_minute: hosted_inflight_carried(pool: p, window_start: minute_start),
                      carried_day: hosted_inflight_carried(pool: p, window_start: day_start),
                      release_hint: hint,
                    ),
                  )
              }
          }
      }
  }
}

fn harness_hosted_round_charged_post(config: HarnessTurnConfig, round: Int, header_file: NonEmptyStr, quota: HarnessHostedQuota, wire_request_detail: String?, store: FabricStorageBinding, reference: NonEmptyStr, charge: HostedRoundLease) -> HarnessRoundPost {
  match charge {
    HostedRoundQuotaFull { wire: w } => RoundQuotaFull { wire: w }
    HostedRoundUnleasable { detail: d } => RoundQuotaUnleasable { detail: d }
    HostedRoundCharged =>
      match harness_hosted_inflight_acquire(quota: quota, store: store, reference: reference, term: config.request_deadline) {
        HostedInflightRefused { detail: d } => RoundQuotaUnleasable { detail: d }
        HostedInflightHeld { reference: r, store: st } => {
          let hold = HostedInflightHeld { reference: r, store: st }
          let posted = harness_send_round(config: config, round: round, header_file: Present { value: header_file }, wire_request_detail: wire_request_detail)
          let released = harness_hosted_inflight_release(quota: quota, hold: hold, reason: "the transport returned" as NonEmptyStr)
          RoundPosted { posted: HarnessPostedRound { read: posted.read, wire_log_detail: posted.wire_log_detail, inflight_release_detail: released, hosted_failure: posted.hosted_failure, unexplained: posted.unexplained, pool_fault: posted.pool_fault, pending_cause: posted.pending_cause } }
        }
      }
  }
}

type HarnessRoundPreparation
  = RoundPrepared { wire_request_detail: String? }
  | RoundUnprepared { posted: HarnessPostedRound }

fn harness_prepare_round(
  config: HarnessTurnConfig,
  messages: List<JsonValue>,
  reasoning_kwargs: List<JsonKeyValue>,
  round: Int,
) -> HarnessRoundPreparation {
  let body = serialize_json(v: harness_request_json(config: config, messages: messages, reasoning_kwargs: reasoning_kwargs))
  let written = Filesystem.Write(path: config.request_scratch_path as String, content: body)
  if !written.success {
    RoundUnprepared { posted: HarnessPostedRound {
      read: HarnessResponseUnreadable {
        cause: join([
          "request body could not be written to ", config.request_scratch_path as String,
          ": ", written.error,
        ], ""),
      },
      wire_log_detail: none,
      inflight_release_detail: none,
      hosted_failure: none,
      unexplained: none,
      pool_fault: none,
      pending_cause: none,
    } }
  } else {
    let wire_request_path = harness_wire_log_path(config: config, round: round, kind: ".request.json")
    let wire_request = Filesystem.Write(path: wire_request_path, content: body)
    RoundPrepared {
      wire_request_detail: if wire_request.success { none } else { Present { value: join(["request wire log ", wire_request_path, " could not be written: ", wire_request.error], "") } },
    }
  }
}

// A FLEET ENGINE is the only route a refusal without explanation can be read on: a seat or the operator
// endpoint answers for itself, and a hosted-quota route has its own classified failures
// (gunbc.harness.hosted_failure) and never qualifies (operator decision 2026-10-16, condition 2).
fn harness_route_is_fleet_engine(access: HarnessBackendAccess) -> Bool {
  match access {
    BackendAdmittedBySeat => true
    BackendAdmittedByOperatorEndpoint { header_file: _ } => true
    BackendAdmittedByHostedQuota { header_file: _, quota: _ } => false
  }
}

fn harness_send_round(
  config: HarnessTurnConfig,
  round: Int,
  header_file: NonEmptyStr?,
  wire_request_detail: String?,
) -> HarnessPostedRound {
    let posted = harness_post_json(config: config, header_file: header_file)
    let wire_response_path = harness_wire_log_path(config: config, round: round, kind: ".response.json")
    let wire_response = Filesystem.Write(path: wire_response_path, content: posted.body)
    let kept = Filesystem.Write(
      path: join([config.request_scratch_path as String, ".response.json"], ""),
      content: posted.body,
    )
    let wire_details = concat(
      match wire_request_detail { Present { value: d } => [d] Absent => [] },
      if wire_response.success { [] } else { [join(["response wire log ", wire_response_path, " could not be written: ", wire_response.error], "")] },
    )
    let wire_log_detail = if count(wire_details) == 0 {
      none
    } else {
      Present { value: join(wire_details, "; ") }
    }
    match harness_hosted_failure(config: config, posted: posted) {
      Present { value: f } =>
        HarnessPostedRound {
          read: HarnessResponseUnreadable { cause: hosted_http_failure_wire(f: f) },
          wire_log_detail: wire_log_detail,
          inflight_release_detail: none,
          hosted_failure: Present { value: f },
          unexplained: none,
          pool_fault: none,
          pending_cause: none,
        }
      Absent =>
    if !posted.success {
      HarnessPostedRound {
        read: HarnessResponseUnreadable {
          cause: join([
            "the backend refused the request or the transport failed; ", harness_refusal_body_text(config: config, body: posted.body),
          ], ""),
        },
        wire_log_detail: wire_log_detail,
        inflight_release_detail: none,
        hosted_failure: none,
        // A POOL FRONT'S OWN TYPED ANSWER (503 no TLS card, a certificate that is not the pinned one) IS EXPLAINED:
        // it is the front speaking or the handshake refusing, so it is never classified as an engine that refused
        // for no reason (the S3 recovery would otherwise resume a session against a front that has no card).
        unexplained: match posted.fault {
          Present { value: _ } => none
          Absent => harness_unexplained_refusal(
            route_qualifies: harness_route_is_fleet_engine(access: config.backend_access),
            success: posted.success,
            body: posted.body,
            headers: posted.headers,
            request_body: Filesystem.Read(path: config.request_scratch_path as String).content,
          )
        },
        pool_fault: posted.fault,
        pending_cause: harness_request_pending_cause(access: config.backend_access, posted: posted),
      }
    } else if !kept.success {
      HarnessPostedRound {
        read: HarnessResponseUnreadable {
          cause: join(["the response could not be kept beside the request: ", kept.error, "; refusing to decode a body no one can re-read"], ""),
        },
        wire_log_detail: wire_log_detail,
        inflight_release_detail: none,
        hosted_failure: none,
        unexplained: none,
        pool_fault: none,
        pending_cause: none,
      }
    } else {
      HarnessPostedRound {
        read: harness_decode_for_shape(unit: config.serving_unit, shape: config.wire_shape, body: posted.body),
        wire_log_detail: wire_log_detail,
        inflight_release_detail: none,
        hosted_failure: none,
        unexplained: none,
        pool_fault: none,
        pending_cause: none,
      }
    }
    }
}

// ONE POST, TWO ADMISSIONS. A seat-admitted backend is the fleet's own engine over its network and takes
// no credential; a quota-admitted one is a hosted upstream and takes the bearer header file by path.
type HarnessPostOutcome {
  body: String
  success: Bool
  headers: HttpHeaderDump?
  fault: OperatorRoundFault?
}

// HOSTED FAILURES ARE CLASSIFIED ONCE (gunbc.harness.hosted_failure) and never retried. A fleet
// engine has no such refusal. OpenRouter's JSON 429 decode remains that product's enrichment when
// the generic status/SSE classifier has no status to read.
fn harness_hosted_failure(config: HarnessTurnConfig, posted: HarnessPostOutcome) -> HostedHttpFailure? {
  match config.backend_access {
    BackendAdmittedBySeat => none
    BackendAdmittedByOperatorEndpoint { header_file: _ } => none
    BackendAdmittedByHostedQuota { header_file: _, quota: _ } => {
      let dump = match posted.headers {
        Present { value: d } => d
        Absent => HeaderDumpUnread { cause: "no response header dump was taken for this request" }
      }
      match hosted_classify_round(body: posted.body, dump: dump) {
        Present { value: f } => Present { value: f }
        Absent =>
          match openrouter_decode_rate_limited(body: posted.body, header_dump: dump) {
            Present { value: r } =>
              Present { value: HostedRateLimited { status: 429, retry_after: r.hints.retry_after, body_note: openrouter_rate_limit_wire(r: r) } }
            Absent => none
          }
      }
    }
  }
}

fn harness_response_headers_path(config: HarnessTurnConfig) -> String {
  join([config.request_scratch_path as String, ".response.headers"], "")
}

// A REQUEST THAT DREW NO RESPONSE HAD NO EFFECT, so it stands and the belt re-delivers it (F85; operator
// direction 2026-10-27). "No response" is exact: the transport failed, no body came back, and no response
// header was received -- an engine that answered anything, an error included, is in the terminal-refusal
// hands it always was. THE WORKER NEVER SLEEPS BESIDE A REQUEST AND NEVER RETRIES IN-PROCESS: an earlier
// shape of this path re-posted after a policy delay until a budget ended -- a live process as a queue
// entry. It is deleted. What a fleet-engine route (seat-admitted or operator-endpoint) does on a request
// that drew no answer is record ONE durable turn.request_pending event and exit; the belt owns the
// re-delivery schedule (gunbc.harness.harness_transport_retry_policy) and the hosted route keeps today's
// behaviour (no retry, no pending: gunbc.harness.hosted_failure classifies and stops, operator direction:
// a client timeout means "stopped watching", never "failed" and never "cancelled").
fn harness_post_drew_no_response(posted: HarnessPostOutcome) -> Bool {
  !posted.success && trim(posted.body) == "" && (match posted.headers {
    Absent => true
    Present { value: HeaderDumpRead { text } } => trim(text) == ""
    Present { value: HeaderDumpUnread { cause: _ } } => true
  })
}

// WHY THE REQUEST STANDS PENDING, in the front's own words, or none when the round was not a patient-request
// case. The front's typed 503 (no TLS card serving), 502 (a card was chosen and did not answer) and 429
// (every compatible upstream busy) each mean NOTHING WAS SERVED and no effect was taken, so the request
// stands. A post that drew no response at all -- including one the client's --max-time window closed: that
// window is only the client's observation, never the request's deadline -- stands for the same reason. A
// refused certificate is terminal (the same certificate fails the same way; no byte was sent), any 4xx is
// the front refusing THIS request, and a hosted route never holds: today's behaviour stands.
fn harness_request_pending_cause(access: HarnessBackendAccess, posted: HarnessPostOutcome) -> String? {
  if !harness_route_is_fleet_engine(access: access) {
    none
  } else {
    match posted.fault {
      Present { value: OperatorNoCapacity } => Present { value: "the pool front answered 503 (no TLS card serving)" }
      Present { value: OperatorCardUnanswered } => Present { value: "the pool front answered 502 (the card did not answer)" }
      Present { value: OperatorUpstreamsBusy } => Present { value: "the pool front answered 429 (every compatible upstream busy)" }
      // A refused certificate is terminal even though it drew no bytes back: the same certificate fails
      // the same way and no byte of the request was sent, so there is nothing for the belt to re-deliver
      // differently. It must not fall into the no-response reading.
      Present { value: OperatorCertificateNotPinned { curl_exit: _ } } => none
      Present { value: OperatorCertificateNotVerifiedForHost { curl_exit: _ } } => none
      _ =>
        if harness_post_drew_no_response(posted: posted) {
          // --max-time expiry lands here: the client stopped watching; the request it delivered does not die with the watch.
          Present { value: "the request drew no response at all; the client's --max-time is only its observation window, and a timeout means stopped watching -- never failed, never cancelled" }
        } else {
          none
        }
    }
  }
}

// ONE POST, AS A PATIENT REQUEST CONTRACT REQUIRES: deliver, look once, and leave the waiting to the
// belt. The sleep/retry loop this path carried is deleted -- it made a worker process into the queue
// entry for its own request, and its budget could end a request that had drawn no answer.
fn harness_post_json(config: HarnessTurnConfig, header_file: NonEmptyStr?) -> HarnessPostOutcome {
  harness_post_json_once(config: config, header_file: header_file)
}

type HarnessRawPost {
  body: String
  success: Bool
  curl_exit: Int?
}

fn harness_post_unpinned(config: HarnessTurnConfig, hf: NonEmptyStr, max_seconds: NonEmptyStr) -> HarnessRawPost {
  let posted = http.Client.PostJsonFromFileWithHeaderFile(
    url: config.backend_url as NonEmptyStr,
    request_body_file: config.request_scratch_path as String as NonEmptyStr,
    header_file: hf,
    response_headers_file: harness_response_headers_path(config: config) as NonEmptyStr,
    max_seconds: max_seconds,
  )
  HarnessRawPost { body: posted.body, success: posted.success, curl_exit: none }
}

fn harness_post_json_once(config: HarnessTurnConfig, header_file: NonEmptyStr?) -> HarnessPostOutcome {
  match header_file {
    Absent => {
      let posted = http.Client.PostJsonFromFile(
        url: config.backend_url as NonEmptyStr,
        request_body_file: config.request_scratch_path as String as NonEmptyStr,
        max_seconds: to_string(value: second_count(s: config.request_deadline)) as NonEmptyStr,
      )
      HarnessPostOutcome { body: posted.body, success: posted.success, headers: none, fault: none }
    }
    Present { value: hf } => {
      let max_seconds = to_string(value: second_count(s: config.request_deadline)) as NonEmptyStr
      // ONE POST, WHICHEVER BACKEND: only the transport arguments differ. The operator endpoint is the pool's TLS
      // front, so its post pins the certificate (the same operation shape plus the pinned files); a refused pin
      // fails in the handshake, before the request body is sent.
      let posted = match config.backend_access {
        BackendAdmittedByOperatorEndpoint { header_file: _ } => {
          let req = operator_pinned_post_request(url: config.backend_url as NonEmptyStr, request_body_file: config.request_scratch_path as String as NonEmptyStr, response_headers_file: harness_response_headers_path(config: config) as NonEmptyStr, max_seconds: max_seconds, hf: hf)
          // RESIDUAL, REVIEW-GUARDED: an operation takes fields, not a record, so each field is copied from req here by
          // hand; the claims render the argv from req and cannot see this copy. A repointed field is the seam.
          let pinned = http.Client.PostJsonFromFileWithHeaderFilePinned(
            url: req.url,
            request_body_file: req.request_body_file,
            header_file: req.header_file,
            response_headers_file: req.response_headers_file,
            ca_file: req.ca_file,
            pinned_pubkey_file: req.pinned_pubkey_file,
            max_seconds: req.max_seconds,
          )
          HarnessRawPost { body: pinned.body, success: pinned.success, curl_exit: Present { value: pinned.exit_code } }
        }
        BackendAdmittedBySeat => harness_post_unpinned(config: config, hf: hf, max_seconds: max_seconds)
        BackendAdmittedByHostedQuota { header_file: _, quota: _ } => harness_post_unpinned(config: config, hf: hf, max_seconds: max_seconds)
      }
      let dump = Filesystem.Read(path: harness_response_headers_path(config: config))
      let header_dump = if dump.success { HeaderDumpRead { text: dump.content } } else { HeaderDumpUnread { cause: join(["the curl header dump ", harness_response_headers_path(config: config), " could not be read: ", dump.error], "") } }
      HarnessPostOutcome {
        body: posted.body,
        success: posted.success,
        headers: Present { value: header_dump },
        fault: match config.backend_access {
          BackendAdmittedByOperatorEndpoint { header_file: _ } =>
            match posted.curl_exit {
              Present { value: x } => operator_round_fault(success: posted.success, curl_exit: x, status: http_header_dump_status(dump: header_dump))
              Absent => none
            }
          BackendAdmittedBySeat => none
          BackendAdmittedByHostedQuota { header_file: _, quota: _ } => none
        },
      }
    }
  }
}

// A HOSTED UPSTREAM'S REFUSAL IS DECODED TO ITS TYPED ERROR, so a 402 says which budget refused and a
// 429 says whose limit it was; a fleet engine's body is reported as it came.
fn harness_refusal_body_text(config: HarnessTurnConfig, body: String) -> String {
  match config.backend_access {
    BackendAdmittedBySeat => join(["body was: ", body], "")
    BackendAdmittedByOperatorEndpoint { header_file: _ } => join(["operator endpoint answered: ", body], "")
    BackendAdmittedByHostedQuota { header_file: _, quota: _ } => join(["upstream answered: ", harness_hosted_refusal_cause(body: body)], "")
  }
}

// THE LOOP. Each round either reaches a provider terminal, or executes the tool calls and recurses
// with a strictly smaller budget. There is no arm that continues without either consuming a step or
// terminating, which is what makes the descent argument readable rather than asserted.
// COMPACTION, AT ITS MOST BASIC: A SLIDING WINDOW WITH A PINNED HEAD.
//
// The loop grows `messages` monotonically -- concat(messages, [assistant, tool_results]) -- so every
// turn re-sends the whole history and nothing is ever dropped. That is why one 162KB tool result
// poisoned an entire turn: the cap added to harness_tool bounds what ENTERS history and can do
// nothing about what is already in it.
//
// WHOLE PAIRS ARE DROPPED, NEVER SINGLE MESSAGES, and that is a correctness constraint rather than
// tidiness. After the opening brief the list alternates assistant(tool_use) / user(tool_result), and
// a tool_result whose matching tool_use has been dropped is a malformed request the backend rejects
// outright. Dropping an even count starting at index 1 preserves the pairing by construction.
//
// THE BRIEF IS PINNED because it is the only message that says what the task IS. A window that
// dropped it would leave a worker executing tool calls with no statement of purpose -- which is the
// failure this is supposed to prevent, arrived at from the other side.
//
// WHAT THIS IS NOT: summarization. Nothing is read, condensed or re-stated; the dropped rounds are
// simply gone, and the model is told so. That is deliberate for a first cut -- a summarizer is a
// second model call whose output is unverified text entering the context that the real work depends
// on, and it should not land before there is a measurement saying the window is the binding
// constraint. Today's measurement says it is not: peak context is roughly 78KB against a 1M budget.
//
// SO THIS WILL NOT FIRE IN NORMAL OPERATION, and that is the honest state rather than a defect. It
// is a bound on pathological growth, not the compaction strategy -- the trigger worth building is
// task-oriented (a repeated command, a round that changed nothing), and this is the mechanism such
// a trigger would eventually drive.
// THE TRIGGER IS THE MEASURED INPUT, NOT A ROUND COUNT, and the first cut got this exactly wrong.
// It retained a fixed six rounds, which fires at about thirteen messages REGARDLESS OF SIZE -- so on
// a run using 40k tokens of a 1048576-token window, roughly 4% of the budget, the worker had its own
// working history discarded about once per round. Measured on t01: 25 rounds executed, 14 messages
// retained, compaction notice present, nothing near the window. A worker that repeatedly forgets
// what it just learned is a plausible cause of the non-convergence this was meant to measure.
//
// So compaction now fires only when the backend's own counted input crosses a share of the budget.
// Below that the history is kept whole, which is the right default when the window is three orders
// of magnitude larger than the conversation. The share is three quarters: high enough that ordinary
// runs never compact, low enough that the drop happens before the context refusal rather than at it.
data harness_compaction_input_share_numerator: Int = 3

data harness_compaction_input_share_denominator: Int = 4

data harness_retained_tool_rounds: Int = 24

fn harness_compaction_due(input_tokens: TokenCount, budget: TokenCount) -> Bool {
  token_count_value(t: input_tokens) * harness_compaction_input_share_denominator
    >= token_count_value(t: budget) * harness_compaction_input_share_numerator
}

fn harness_compaction_notice(shape: HarnessWireShape, dropped_rounds: Int) -> JsonValue {
  harness_user_text_message_json(
    shape: shape,
    text: join([
      harness_premise_text(p: EarlierRoundsDropped { rounds: dropped_rounds }), " ",
      harness_conclusion_text(c: ReRunForDroppedOutput { rounds: dropped_rounds }),
    ], ""),
  )
}

fn harness_compact_messages(
  messages: List<JsonValue>,
  input_tokens: TokenCount,
  budget: TokenCount,
 shape: HarnessWireShape) -> List<JsonValue> {
  if !harness_compaction_due(input_tokens: input_tokens, budget: budget) {
    messages
  } else {
    harness_compact_messages_now(shape: shape, messages: messages)
  }
}

fn harness_compact_messages_now(messages: List<JsonValue>, shape: HarnessWireShape) -> List<JsonValue> {
  let total = list_length(items: messages)
  let retained = harness_retained_tool_rounds * 2
  if total <= retained + 1 {
    messages
  } else {
    let dropped = total - retained - 1
    concat(
      concat(messages.take(n: 1), [harness_compaction_notice(shape: shape, dropped_rounds: dropped / 2)]),
      messages.skip(n: total - retained),
    )
  }
}

fn harness_event_write_refusal(config: HarnessTurnConfig, detail: String) -> HarnessTurnOutcome {
  TurnRequestUnwritable {
    path: config.events_path as String,
    detail: join(["provider event stream could not be written: ", detail], ""),
  }
}

fn harness_turn_loop(
  config: HarnessTurnConfig,
  messages: List<JsonValue>,
  steps_remaining: Int,
  steps_taken: Int,
  events: List<String>,
  repairs_used: Int,
) -> HarnessTurnOutcome {
  if steps_remaining <= 0 {
    match config.supervision {
      Unsupervised => {
        let exhausted = concat(events, [harness_event_turn_budget_exhausted(steps_taken: steps_taken)])
        match harness_write_events(config: config, events: exhausted) {
          HarnessEventsUnwritable { detail: d } => harness_event_write_refusal(config: config, detail: d)
          HarnessEventsWritten => TurnStepBudgetExhausted { steps_taken: steps_taken }
        }
      }
      SupervisedRounds { chain_fingerprint: _, check_prompt, check_directory, round_steps, acceptance: _ } =>
        harness_turn_supervise(
          config: config,
          check_prompt: check_prompt,
          check_directory: check_directory,
          round_steps: round_steps,
          messages: messages,
          steps_taken: steps_taken,
          events: events,
          repairs_used: repairs_used,
        )
    }
  } else {
    match harness_post_round(config: config, messages: messages, round: steps_taken + 1) {
      RoundQuotaFull { wire: w } => {
        let failed = concat(events, [harness_event_turn_failed(message: join(["hosted quota full: ", w], ""))])
        match harness_write_events(config: config, events: failed) {
          HarnessEventsUnwritable { detail: d } => harness_event_write_refusal(config: config, detail: d)
          HarnessEventsWritten => TurnHostedQuotaFull { wire: w, steps_taken: steps_taken }
        }
      }
      RoundQuotaUnleasable { detail: qd } => {
        let failed = concat(events, [harness_event_turn_failed(message: join(["hosted quota unleasable: ", qd], ""))])
        match harness_write_events(config: config, events: failed) {
          HarnessEventsUnwritable { detail: d } => harness_event_write_refusal(config: config, detail: d)
          HarnessEventsWritten => TurnHostedQuotaUnleasable { detail: qd, steps_taken: steps_taken }
        }
      }
      RoundPosted { posted: posted_round } => harness_turn_after_post(config: config, messages: messages, steps_remaining: steps_remaining, steps_taken: steps_taken, events: events, repairs_used: repairs_used, posted_round: posted_round)
    }
  }
}

// A ROUND WHOSE REQUEST DREW NO ANSWER IS RECORDED AS STANDING PENDING and the worker exits: no sleep,
// no in-process re-post, no clock on the wait (the patient request contract). ONE durable event opens
// (or keeps) the round's window; the belt owns the re-delivery schedule. This replaces the pool hold
// that re-posted until a budget ended -- a live process used as its own queue entry, deleted per the
// operator direction of 2026-10-27.
fn harness_record_request_pending(config: HarnessTurnConfig, events: List<String>, cause: String, steps_taken: Int, messages: List<JsonValue>) -> HarnessTurnOutcome {
  match now_epoch_seconds() {
    // THE WINDOW CANNOT BE OPENED WITHOUT THE CLOCK. The request is still delivered and still stands --
    // nothing here ends it -- but the event that says so must name its opening instant, so this worker
    // stops visibly and the belt re-delivers the same round on its next sweep.
    Absent => TurnTransportRefused { detail: join(["the request drew no answer and the clock could not be read as epoch seconds, so the pending window could not be recorded; the request still stands and the belt re-delivers this round on its next sweep", " (", cause, ")"], "") }
    Present { value: now } => {
      let round = steps_taken + 1
      let validation = session_messages_validation(messages: messages)
      let pending = concat(events, [
        session_event_request_pending(round: round, cause: cause, since: session_request_pending_since_of(lines: events, round: round, now: now), validation: validation),
      ])
      match harness_write_events(config: config, events: pending) {
        HarnessEventsUnwritable { detail: d } => harness_event_write_refusal(config: config, detail: d)
        HarnessEventsWritten => TurnRequestPending { re_deliveries: session_request_redeliveries_of(lines: events, round: round), steps_taken: steps_taken }
      }
    }
  }
}

fn harness_turn_after_post(
  config: HarnessTurnConfig,
  messages: List<JsonValue>,
  steps_remaining: Int,
  steps_taken: Int,
  events: List<String>,
  repairs_used: Int,
  posted_round: HarnessPostedRound,
) -> HarnessTurnOutcome {
    let events_after_release = match posted_round.inflight_release_detail {
      Present { value: detail } => concat(events, [harness_event_inflight_release_unrecorded(detail: detail)])
      Absent => events
    }
    let events_after_wire = match posted_round.wire_log_detail {
      Present { value: detail } => concat(events_after_release, [harness_event_wire_log_unwritable(detail: detail)])
      Absent => events_after_release
    }
    match posted_round.read {
      HarnessResponseUnreadable { cause: c } =>
        match posted_round.hosted_failure {
          Present { value: failed_hosted } => {
            let failed = concat(events_after_wire, [harness_event_turn_failed(message: hosted_http_failure_wire(f: failed_hosted))])
            match harness_write_events(config: config, events: failed) {
              HarnessEventsUnwritable { detail: d } => harness_event_write_refusal(config: config, detail: d)
              HarnessEventsWritten => TurnHostedFailure { failure: failed_hosted, steps_taken: steps_taken }
            }
          }
          Absent =>
            match posted_round.pending_cause {
              // THE PATIENT REQUEST CONTRACT (operator route): the front's 503/502/429, or a post that drew no
              // response at all, means NOTHING WAS SERVED and no effect was taken. ONE durable event, one typed
              // outcome, and the worker exits -- it does not sleep and does not re-post.
              Present { value: pending } =>
                harness_record_request_pending(config: config, events: events_after_wire, cause: pending, steps_taken: steps_taken, messages: messages)
              Absent =>
            // THE FRONT'S TYPED 503/502/429 NEVER REACH HERE: they are the pending cases above, read once
            // from the post's evidence. What remains typed here is the certificate refusal -- terminal,
            // because the same certificate fails the same way and no byte of the request was sent.
            match posted_round.pool_fault {
              Present { value: OperatorCertificateNotPinned { curl_exit: x } } => {
                let failed = concat(events_after_wire, [harness_event_turn_failed(message: c)])
                match harness_write_events(config: config, events: failed) {
                  HarnessEventsUnwritable { detail: d } => harness_event_write_refusal(config: config, detail: d)
                  HarnessEventsWritten => TurnTransportRefused { detail: join(["the pool front's certificate is not the pinned one (curl exit ", to_string(value: x), "); the request was refused in the handshake and no byte of it was sent"], "") }
                }
              }
              Present { value: OperatorCertificateNotVerifiedForHost { curl_exit: x } } => {
                let failed = concat(events_after_wire, [harness_event_turn_failed(message: c)])
                match harness_write_events(config: config, events: failed) {
                  HarnessEventsUnwritable { detail: d } => harness_event_write_refusal(config: config, detail: d)
                  HarnessEventsWritten => TurnTransportRefused { detail: join(["the pool front's certificate did not verify for its host (curl exit ", to_string(value: x), "; the chain or a missing IP SAN, not a different certificate); the request was refused in the handshake and no byte of it was sent"], "") }
                }
              }
              Absent =>
            match posted_round.unexplained {
              Present { value: refusal } => {
                // THE SESSION STOPPED AT THE STATE `messages` HOLDS: every call of the last answered
                // response has its recorded result when this round was posted, so the conversation is
                // validated and the stream records the refusal as a recovery the belt may resume.
                let validation = session_messages_validation(messages: messages)
                let cause = session_cause_text(round: steps_taken + 1, refusal: refusal)
                let failed = concat(events_after_wire, [
                  harness_event_turn_failed(message: c),
                  session_event_recovery_needed(round: steps_taken + 1, refusal: refusal, validation: validation),
                ])
                match harness_write_events(config: config, events: failed) {
                  HarnessEventsUnwritable { detail: d } => harness_event_write_refusal(config: config, detail: d)
                  HarnessEventsWritten =>
                    TurnBackendRefusedUnexplained { cause: cause, resumable: session_validation_resumable(v: validation), steps_taken: steps_taken }
                }
              }
              Absent => {
                let failed = concat(events_after_wire, [harness_event_turn_failed(message: c)])
                match harness_write_events(config: config, events: failed) {
                  HarnessEventsUnwritable { detail: d } => harness_event_write_refusal(config: config, detail: d)
                  HarnessEventsWritten => TurnResponseUnreadable { cause: c }
                }
              }
            }
            }
            }
        }
      HarnessResponseParsed { blocks: raw_blocks, stop_reason, usage: usage_read } =>
        match usage_read {
          UsageUnreadable { cause: uc } => {
            let unavailable = concat(events_after_wire, [
              harness_event_round_usage_unavailable(step: steps_taken + 1, cause: uc, clock: clock_unix_millis_read()),
              harness_event_turn_failed(
                message: join([
                  "the round's token counts were not observed (", uc,
                  "); the context budget cannot be checked against a count that does not exist",
                ], ""),
              ),
            ])
            match harness_write_events(config: config, events: unavailable) {
              HarnessEventsUnwritable { detail: d } => harness_event_write_refusal(config: config, detail: d)
              HarnessEventsWritten => TurnUsageUnavailable { cause: uc, steps_taken: steps_taken + 1 }
            }
          }
          UsageRead { input_tokens, output_tokens } =>
            harness_turn_round(
              config: config, messages: messages, raw_blocks: raw_blocks, stop_reason: stop_reason,
              input_tokens: input_tokens, output_tokens: output_tokens,
              steps_remaining: steps_remaining, steps_taken: steps_taken, events: events_after_wire,
              repairs_used: repairs_used,
            )
        }
    }
}

// THE ROUND THAT DECODED AND WAS COUNTED. Factored out of the loop when usage became a typed read:
// everything below needs both counts, so the unavailable arm is decided once, above, rather than
// each of these branches defaulting its own.
//
// THE WORKER'S ORDINARY TERMINAL, ONE SPELLING. The model stopped talking; its text is recorded
// and the wire stop reason goes down as the provider observation it always was. The submission
// gate's three verdicts share this spelling for "the turn ends as complete", so a gate change can
// never fork what completion means.
fn harness_turn_provider_stopped(
  config: HarnessTurnConfig,
  events: List<String>,
  usage: String,
  text: String,
  stop_reason: AnthropicStopReason,
  input_tokens: TokenCount,
  output_tokens: TokenCount,
  steps_taken: Int,
) -> HarnessTurnOutcome {
  let completed = concat(events, [
    usage,
    harness_event_agent_message(message: text),
    harness_event_type_only(event_type: "turn.completed"),
  ])
  match harness_write_events(config: config, events: completed) {
    HarnessEventsUnwritable { detail: d } => harness_event_write_refusal(config: config, detail: d)
    HarnessEventsWritten =>
      TurnProviderStopped {
        wire_stop_reason: harness_stop_reason_wire(reason: stop_reason),
        assistant_text: text,
        steps_taken: steps_taken + 1,
        input_tokens: token_count_value(t: input_tokens),
        output_tokens: token_count_value(t: output_tokens),
      }
  }
}

// TRUNCATION WITH AN OPEN TOOL CALL IS JUDGED FIRST in the round below: when both arms could fire
// on one max_tokens stop, the open call is the more specific cause and the one whose consequence (a
// partial file write executed as a complete command) is the worse to bury in a format verdict.
fn harness_turn_round(
  config: HarnessTurnConfig,
  messages: List<JsonValue>,
  raw_blocks: List<HarnessWireBlock>,
  stop_reason: AnthropicStopReason,
  input_tokens: TokenCount,
  output_tokens: TokenCount,
  steps_remaining: Int,
  steps_taken: Int,
  events: List<String>,
  repairs_used: Int,
) -> HarnessTurnOutcome {
        let blocks = harness_split_inline_reasoning(unit: config.serving_unit, blocks: raw_blocks)
        let clock = clock_unix_millis_read()
        let uses = harness_tool_use_blocks(blocks: blocks)
        let usage = harness_event_round_usage(
          step: steps_taken + 1,
          input_tokens: input_tokens,
          output_tokens: output_tokens,
          clock: clock,
          tool_calls: list_length(items: uses),
          files_changed: none,
        )
        if list_length(items: uses) > 0 && harness_stop_reason_truncated(reason: stop_reason) {
          let truncated = concat(events, [
            usage,
            harness_event_turn_failed(
              message: join([
                "the provider stopped at the max_tokens ceiling of ",
                to_string(value: config.max_tokens),
                " with a tool call still open, so its arguments are truncated; refusing to execute a",
                " partial command rather than write an incomplete file and continue",
              ], ""),
            ),
          ])
          match harness_write_events(config: config, events: truncated) {
            HarnessEventsUnwritable { detail: d } => harness_event_write_refusal(config: config, detail: d)
            HarnessEventsWritten =>
              TurnTruncatedMidToolCall {
                output_tokens: token_count_value(t: output_tokens),
                ceiling: config.max_tokens,
                steps_taken: steps_taken + 1,
              }
          }
        } else if harness_thinking_format_cause(unit: config.serving_unit, blocks: blocks, mode: config.reasoning_mode, stop: stop_reason) != "" {
          let invalid = concat(events, [
            usage,
            harness_event_turn_failed(message: harness_thinking_format_cause(unit: config.serving_unit, blocks: blocks, mode: config.reasoning_mode, stop: stop_reason)),
          ])
          match harness_write_events(config: config, events: invalid) {
            HarnessEventsUnwritable { detail: d } => harness_event_write_refusal(config: config, detail: d)
            HarnessEventsWritten =>
              TurnThinkingFormatInvalid {
                cause: harness_thinking_format_cause(unit: config.serving_unit, blocks: blocks, mode: config.reasoning_mode, stop: stop_reason),
                steps_taken: steps_taken + 1,
              }
          }
        } else if list_length(items: uses) == 0 {
          let text = harness_blocks_text(blocks: blocks)
          match config.completion {
            CompletesWhenEntryPresent { directory: _, name: _ } =>
              harness_turn_provider_stopped(
                config: config, events: events, usage: usage, text: text, stop_reason: stop_reason,
                input_tokens: input_tokens, output_tokens: output_tokens, steps_taken: steps_taken,
              )
            CompletesOnProviderStop => {
              let observed = harness_submission_gate_observe(environment: config.environment)
              match harness_submission_gate_judge(
                observation: observed,
                repairs_used: repairs_used,
              ) {
                GateProceed =>
                  match harness_handin_route(supervision: config.supervision, observed: observed) {
                    Absent =>
                      harness_turn_provider_stopped(
                        config: config, events: events, usage: usage, text: text, stop_reason: stop_reason,
                        input_tokens: input_tokens, output_tokens: output_tokens, steps_taken: steps_taken,
                      )
                    Present { value: route } =>
                      harness_turn_hand_in(
                        config: config,
                        route: route,
                        messages: concat(messages, [harness_assistant_message_json(unit: config.serving_unit, shape: config.wire_shape, blocks: blocks)]),
                        events: concat(events, [usage, harness_event_agent_message(message: text)]),
                        steps_taken: steps_taken + 1,
                        text: text,
                        stop_reason: stop_reason,
                        input_tokens: input_tokens,
                        output_tokens: output_tokens,
                        tool_use_id: none,
                        prior_results: [],
                        steps_remaining: steps_remaining,
                        repairs_used: repairs_used,
                        blocks: blocks,
                      )
                  }
                GateRepair { reason } => {
                  let noticed = concat(events, [
                    usage,
                    harness_event_agent_message(message: text),
                    harness_event_submission_repair(reason: reason, repair_round: repairs_used + 1),
                  ])
                  match harness_write_events(config: config, events: noticed) {
                    HarnessEventsUnwritable { detail: d } => harness_event_write_refusal(config: config, detail: d)
                    HarnessEventsWritten =>
                      harness_turn_loop(
                        config: config,
                        messages: harness_compact_messages(
                          shape: config.wire_shape,
                          messages: concat(messages, [
                            harness_assistant_message_json(unit: config.serving_unit, shape: config.wire_shape, blocks: blocks),
                            harness_user_text_message_json(
                              shape: config.wire_shape,
                              text: harness_submission_repair_text(reason: reason, repairs_used: repairs_used + 1),
                            ),
                          ]),
                          input_tokens: input_tokens,
                          budget: config.context_budget,
                        ),
                        steps_remaining: steps_remaining - 1,
                        steps_taken: steps_taken + 1,
                        events: noticed,
                        repairs_used: repairs_used + 1,
                      )
                  }
                }
                GateRefuse { reason } => {
                  let failed = concat(events, [
                    usage,
                    harness_event_agent_message(message: text),
                    harness_event_turn_failed(message: harness_submission_terminal_cause(reason: reason)),
                  ])
                  match harness_write_events(config: config, events: failed) {
                    HarnessEventsUnwritable { detail: d } => harness_event_write_refusal(config: config, detail: d)
                    HarnessEventsWritten =>
                      TurnSubmissionUndecodable { reason: reason, steps_taken: steps_taken + 1 }
                  }
                }
              }
            }
          }
        } else if harness_context_exhausted(
          input_tokens: input_tokens,
          budget: config.context_budget,
        ) {
          let exhausted = concat(events, [
            usage,
            harness_event_turn_failed(
              message: join([
                "context window exhausted: the backend counted ", to_string(value: token_count_value(t: input_tokens)),
                " input tokens against a declared budget of ",
                to_string(value: token_count_value(t: config.context_budget)),
                "; this turn cannot make another request",
              ], ""),
            ),
          ])
          match harness_write_events(config: config, events: exhausted) {
            HarnessEventsUnwritable { detail: d } => harness_event_write_refusal(config: config, detail: d)
            HarnessEventsWritten =>
              TurnContextWindowExhausted {
                input_tokens: token_count_value(t: input_tokens),
                budget: token_count_value(t: config.context_budget),
                steps_taken: steps_taken + 1,
              }
          }
        } else {
          match harness_hand_in_block(uses: uses) {
            Present { value: hand_block } =>
              harness_turn_execute_hand_in(
                config: config,
                messages: messages,
                blocks: blocks,
                uses: uses,
                hand_block: hand_block,
                events: events,
                steps_taken: steps_taken,
                steps_remaining: steps_remaining,
                input_tokens: input_tokens,
                output_tokens: output_tokens,
                clock: clock,
                repairs_used: repairs_used,
                text: harness_blocks_text(blocks: blocks),
                stop_reason: stop_reason,
              )
            Absent => {
          let executed = harness_execute_tools(environment: config.environment, uses: uses)
          let config_after = harness_turn_config_with_environment(
            config: config,
            environment: executed.environment,
          )
          let results = executed.results
          let usage_after_tools = harness_event_round_usage(
            step: steps_taken + 1,
            input_tokens: input_tokens,
            output_tokens: output_tokens,
            clock: clock,
            tool_calls: list_length(items: uses),
            files_changed: harness_worktree_files_changed(environment: config_after.environment),
          )
          let stepped = concat(concat(events, [usage_after_tools]), harness_tool_round_events(uses: uses))
          match harness_write_events(config: config_after, events: stepped) {
            HarnessEventsUnwritable { detail: d } => harness_event_write_refusal(config: config_after, detail: d)
            HarnessEventsWritten => match harness_completion_observe(completion: config_after.completion) {
              CompletionReached { path } => {
                let done = concat(stepped, [harness_event_turn_completed_by_artifact(path: path)])
                match harness_write_events(config: config_after, events: done) {
                  HarnessEventsUnwritable { detail: d } => harness_event_write_refusal(config: config_after, detail: d)
                  HarnessEventsWritten => TurnCompletedByArtifact { path: path, steps_taken: steps_taken + 1 }
                }
              }
              CompletionIndeterminate { cause } => harness_turn_continue(
                config: config_after, messages: messages, blocks: blocks, results: results,
                steps_remaining: steps_remaining, steps_taken: steps_taken, input_tokens: input_tokens,
                events: concat(stepped, [harness_event_completion_indeterminate(cause: cause)]),
                repairs_used: repairs_used,
              )
              CompletionNotReached => harness_turn_continue(
                config: config_after, messages: messages, blocks: blocks, results: results,
                steps_remaining: steps_remaining, steps_taken: steps_taken, input_tokens: input_tokens,
                events: stepped,
                repairs_used: repairs_used,
              )
            }
          }
            }
          }
        }
}

// THE NEXT ROUND, factored out so the completion observation above has one continuation rather than
// two copies of the recursion.
fn harness_turn_continue(
  config: HarnessTurnConfig,
  messages: List<JsonValue>,
  blocks: List<HarnessWireBlock>,
  results: List<HarnessToolResult>,
  steps_remaining: Int,
  steps_taken: Int,
  input_tokens: TokenCount,
  events: List<String>,
  repairs_used: Int,
) -> HarnessTurnOutcome {
              harness_turn_loop(
                config: config,
                messages: harness_compact_messages(shape: config.wire_shape, 
                  messages: concat(
                    messages,
                    concat(
                      [harness_assistant_message_json(unit: config.serving_unit, shape: config.wire_shape, blocks: blocks)],
                      harness_tool_result_messages_json(
                        shape: config.wire_shape,
                        results: results,
                        steps_remaining: steps_remaining - 1,
                        countdown: harness_supervision_counts_down(s: config.supervision),
                      ),
                    ),
                  ),
                  input_tokens: input_tokens,
                  budget: config.context_budget,
                ),
                steps_remaining: steps_remaining - 1,
                steps_taken: steps_taken + 1,
                events: events,
                repairs_used: repairs_used,
              )
}

// turn.started IS WRITTEN BEFORE THE FIRST POST, NOT CARRIED UNTIL THE FIRST WRITE POINT. The loop
// only writes when a round resolves, and the first round is the slowest thing in the turn -- a cold
// model call runs one to two minutes here. Seeding the accumulator without flushing it left the
// event stream EMPTY for exactly that window, so an observer polling during the longest part of the
// turn saw an initialized-but-silent stream and could not distinguish it from a worker that never
// started. Writing here makes "the agent began" observable at the moment it becomes true.
fn harness_run_turn(config: HarnessTurnConfig, prompt: String, step_budget: Int) -> HarnessTurnOutcome {
  let started = [harness_event_type_only(event_type: "turn.started")]
  match harness_write_events(config: config, events: started) {
    HarnessEventsUnwritable { detail: d } => harness_event_write_refusal(config: config, detail: d)
    HarnessEventsWritten =>
      harness_turn_loop(
        config: config,
        messages: [harness_user_text_message_json(shape: config.wire_shape, text: prompt)],
        steps_remaining: step_budget,
        steps_taken: 0,
        events: started,
        repairs_used: 0,
      )
  }
}

// ── THE RESUME (gunbc.plans.harness_session_lifecycle, slice S3) ────────────────────────────────────────
//
// A resume continues the SAME session: the conversation is the one the refused request carried, read
// back from the wire log the refused round wrote before it posted, the events are the stream the first
// run left, and the loop picks up at the refused round with the steps already taken. It is never a
// fresh conversation and never a blind resend: the state is validated first, and a state with an
// interrupted tool effect is refused here exactly as the belt refuses it, because the harness is the
// last place a resume can be stopped. The bound is checked here too, so a caller that miscounts
// cannot resume a fourth time.
fn harness_resume_turn(config: HarnessTurnConfig, step_budget: Int) -> HarnessTurnOutcome {
  let prior = Filesystem.Read(path: config.events_path as String)
  if !prior.success {
    TurnResumeRefused { cause: join(["the session's event stream ", config.events_path as String, " could not be read: ", prior.error], "") }
  } else {
    let lines = split(s: prior.content, delimiter: "\n") |> filter(l => trim(l) != "")
    match session_recovery_of_events(lines: lines) {
      SessionRecoveryNone => TurnResumeRefused { cause: "the session's stream records no recovery-needed refusal that is still unanswered, so there is nothing to resume" }
      SessionRecoveryMalformed { mismatch: mismatch } => TurnResumeRefused { cause: join(["the session's recovery record is unreadable, so it is not resumable: ", mismatch], "") }
      SessionRecoveryRequestPending { cause: _, since: _, re_deliveries: woken, resumable: _, interrupted_calls: interrupted, resume_round: round } =>
        match now_epoch_seconds() {
          // THE RE-DELIVERY IS STAMPED AT THE INSTANT THE WORKER ARRIVES (the belt delivered by spawning it).
          // An unstamped re-delivery cannot feed the schedule, so this one refuses visibly and the request
          // simply stays pending: the belt re-delivers it on its next sweep. Nothing here ends a request.
          Absent => TurnResumeRefused { cause: "the clock could not be read as epoch seconds, so this re-delivery of the pending round could not be stamped; the request still stands pending and the belt re-delivers it on its next sweep" }
          Present { value: now } => harness_resume_from_round(config: config, step_budget: step_budget, prior_content: prior.content, round: round, interrupted: interrupted, resumed_event: session_event_request_redelivered(ordinal: woken + 1, round: round, at: now))
        }
      SessionRecoveryPending { causes: causes, resumes_made: made, interrupted_calls: interrupted, resume_round: round } =>
        if made >= session_resume_bound {
          TurnResumeRefused { cause: join(["the session has already been resumed ", to_string(value: made), " times, the bound; causes: ", join(causes, " | ")], "") }
        } else {
          harness_resume_from_round(config: config, step_budget: step_budget, prior_content: prior.content, round: round, interrupted: interrupted, resumed_event: session_event_resumed(ordinal: made + 1, round: round, cause: join(causes, " | ")))
        }
    }
  }
}

// THE SHARED RESUME: the refused round's request is the state, the conversation is validated, the resumed event
// (S3's turn.resumed or a capacity wake's turn.capacity_resumed, each counted apart) is appended, and the loop
// picks up at that round with the steps already taken. The same conversation, the same events file, the same
// x-pool-session: only what is recorded as answering the stop differs.
fn harness_resume_from_round(config: HarnessTurnConfig, step_budget: Int, prior_content: String, round: Int, interrupted: List<String>, resumed_event: String) -> HarnessTurnOutcome {
  if list_length(items: interrupted) > 0 {
    TurnResumeRefused { cause: join(["the session stopped with tool calls that have no recorded result (", join(interrupted, ", "), "); their effects are not established, so it is not resumable"], "") }
  } else {
    let request = Filesystem.Read(path: harness_wire_log_path(config: config, round: round, kind: ".request.json"))
    if !request.success {
      TurnResumeRefused { cause: join(["the refused round's request ", harness_wire_log_path(config: config, round: round, kind: ".request.json"), " could not be read: ", request.error], "") }
    } else {
      let leading_system = match config.wire_shape { OpenAiChatCompletionsShape => true AnthropicMessagesShape => false }
      match session_conversation_from_request(request_body: request.content, leading_system: leading_system) {
        Absent => TurnResumeRefused { cause: "the refused round's request does not decode into a conversation" }
        Present { value: conversation } => {
          let messages = session_conversation_messages(conversation: conversation)
          let validation = session_messages_validation(messages: messages)
          if !session_validation_resumable(v: validation) {
            TurnResumeRefused { cause: join(["the refused round's conversation is not a validated state (unrecorded calls: ", join(session_validation_interrupted_ids(v: validation), ", "), ")"], "") }
          } else {
            let resumed = concat(split(s: prior_content, delimiter: "\n") |> filter(l => trim(l) != ""), [resumed_event])
            match harness_write_events(config: config, events: resumed) {
              HarnessEventsUnwritable { detail: d } => harness_event_write_refusal(config: config, detail: d)
              HarnessEventsWritten =>
                harness_turn_loop(
                  config: config,
                  messages: messages,
                  steps_remaining: step_budget - (round - 1),
                  steps_taken: round - 1,
                  events: resumed,
                  repairs_used: 0,
                )
            }
          }
        }
      }
    }
  }
}

// The Bearer header file a turn's requests carry, if its backend access has one: the supplied-value seam the
// operator-route witnesses read instead of running a turn.
fn harness_backend_header_file(access: HarnessBackendAccess) -> NonEmptyStr? {
  match access {
    BackendAdmittedBySeat => none
    BackendAdmittedByOperatorEndpoint { header_file: hf } => Present { value: hf }
    BackendAdmittedByHostedQuota { header_file: hf, quota: _ } => Present { value: hf }
  }
}

// ── THE SYNCHRONOUS SUPERVISION PAUSE (gunbc.plans.harness_session_lifecycle, slice S1) ───────────────
//
// At a supervised session's round boundary the harness does not exit and says nothing to the worker.
// It persists an observation of the round, runs a bounded alignment check over it -- a nested turn on
// the worker's own seat, with its own system prompt, request scratch and event stream under the
// attempt's state directory, so nothing reaches the worker's conversation -- and applies the verdict:
// aligned renews the round and sends the next turn unchanged; misaligned appends its direction as a
// steer first; extremely misaligned or a routed conflict convenes the supervisor the same way and the
// pause lasts until its decision; catastrophically misaligned stops the session. A check or supervisor
// that cannot decide stops the session too: an undecided check is not an aligned one, and continuing
// unsupervised would hide exactly the deficit the pause exists to catch.

data harness_supervision_check_step_budget: Int = 12

data harness_supervision_supervisor_step_budget: Int = 24

// ONE OBSERVED MESSAGE IS BOUNDED, so a round of large tool outputs cannot crowd the check's context;
// the cut is marked, and the worktree the check runs in holds the whole of every file.
data harness_supervision_message_bound: Int = 600

fn harness_supervision_artifact_path(check_directory: String, kind: String, steps_taken: Int, extension: String) -> String {
  join([check_directory, "/supervision-", kind, "-after-turn-", to_string(value: steps_taken), extension], "")
}

fn harness_supervision_bounded(text: String) -> String {
  if string_length(s: text) <= harness_supervision_message_bound {
    text
  } else {
    concat(substring(s: text, start: 0, end: harness_supervision_message_bound), " ...[cut]")
  }
}

// THE ROUND, AS THE CHECK SEES IT: the messages the round added, each bounded. A round adds an
// assistant message and its tool results per turn (one tool message per call on the chat shape), so
// the tail is three messages per turn of the round, and never more than the cap: a hundred-turn
// round would otherwise hand a twelve-step check some 180k characters. The check reads the
// worktree for the rest; the brief, which the chain restates, is never re-sent.
data harness_supervision_observed_message_cap: Int = 120

fn harness_supervision_observation_text(messages: List<JsonValue>, round_steps: Int) -> String {
  let n = list_length(items: messages)
  let tail = if 3 * round_steps < harness_supervision_observed_message_cap { 3 * round_steps } else { harness_supervision_observed_message_cap }
  let from = if n - tail < 1 { 1 } else { n - tail }
  join(
    enumerate(messages)
      |> filter(pair => pair.first >= from)
      |> map(pair => harness_supervision_bounded(text: serialize_json(v: pair.second))),
    "\n",
  )
}

fn harness_supervision_system_prompt(verdict_path: String) -> String {
  join([
    "You are the alignment check for a coding worker's session. You do not do the work and you do not talk to the worker. ",
    "Read the alignment chain and the observation of the worker's latest round below, then inspect the worker's worktree (your working directory): run git status and git diff, and read files if you need to. ",
    "Judge the DIRECTION of the work against its task contract and the levels above it, not its quality or completeness. Exactly one verdict: ",
    "aligned -- the work advances the task and stays inside its boundary; ",
    "misaligned -- a named drift with one concrete correction the worker can act on next (the direction is sent to the worker verbatim, so write it as one short instruction to the worker); ",
    "extremely-misaligned -- the work is off the task contract and a correction is not enough (a supervisor is convened); ",
    "routed-conflict -- the levels of the chain disagree and the worker cannot resolve it (a supervisor is convened); ",
    "catastrophically-misaligned -- the work violates a root principle or the project's declared approach (the session stops). ",
    "Do not modify, create or delete anything in the worktree. Write exactly one JSON object to ", verdict_path, " and then stop. Its shape is one of: ",
    "\{\"kind\": \"aligned\"}, \{\"kind\": \"misaligned\", \"direction\": \"...\"}, \{\"kind\": \"extremely-misaligned\", \"direction\": \"...\"}, \{\"kind\": \"routed-conflict\", \"conflict\": \"...\"}, \{\"kind\": \"catastrophically-misaligned\", \"reason\": \"...\"}.",
  ], "")
}

fn harness_supervision_check_prompt(check_prompt: String, observation: String, steps_taken: Int) -> String {
  join([
    "THE ALIGNMENT CHAIN OF THE WORKER'S TASK:\n\n", check_prompt, "\n\n",
    "THE WORKER'S LATEST ROUND (it has taken ", to_string(value: steps_taken), " turns so far):\n\n", observation, "\n\n",
    "Inspect its worktree and write your verdict.",
  ], "")
}

// A NESTED TURN OF THE PAUSE: the worker's backend, seat, model and worktree, with its own prompt,
// scratch, event stream and verdict path. It is unsupervised -- its hard step budget is its bound.
fn harness_supervision_nested_config(
  config: HarnessTurnConfig,
  check_directory: String,
  kind: String,
  steps_taken: Int,
  system_prompt: String,
) -> HarnessTurnConfig {
  HarnessTurnConfig {
    backend_url: config.backend_url,
    model: config.model,
    max_tokens: config.max_tokens,
    serving_unit: config.serving_unit,
    reasoning_mode: config.reasoning_mode,
    wire_shape: config.wire_shape,
    system_prompt: system_prompt,
    supervision: Unsupervised,
    request_scratch_path: harness_supervision_artifact_path(check_directory: check_directory, kind: join([kind, "-request"], ""), steps_taken: steps_taken, extension: ".json") as FilePath,
    events_path: harness_supervision_artifact_path(check_directory: check_directory, kind: join([kind, "-events"], ""), steps_taken: steps_taken, extension: ".jsonl") as FilePath,
    context_budget: config.context_budget,
    request_deadline: config.request_deadline,
    environment: config.environment,
    completion: CompletesWhenEntryPresent {
      directory: check_directory,
      name: harness_supervision_verdict_name(kind: kind, steps_taken: steps_taken),
    },
    backend_access: config.backend_access,
    acceptance_capacity: KeepBindingAlive,
  }
}

fn harness_supervision_verdict_name(kind: String, steps_taken: Int) -> String {
  join(["supervision-", kind, "-verdict-after-turn-", to_string(value: steps_taken), ".json"], "")
}

type HarnessSupervisionVerdictRead
  = SupervisionVerdictDecoded { verdict: AlignmentVerdict }
  | SupervisionVerdictUnreadable { cause: String }

// PURE: the verdict file's text to a verdict, refusing anything the check cannot act on.
fn harness_supervision_verdict_decode(text: String) -> HarnessSupervisionVerdictRead {
  match parse_json_document(s: text) {
    JsonDocumentUnreadable { gap } => SupervisionVerdictUnreadable { cause: join(["the verdict is ", json_document_gap_text(gap: gap)], "") }
    JsonDocumentParsed { value: doc } =>
      match alignment_verdict_decode_json(v: doc) {
        Present { value: v } => SupervisionVerdictDecoded { verdict: v }
        Absent => SupervisionVerdictUnreadable { cause: "the verdict names no kind the check can act on, or omits the direction, conflict or reason its kind requires" }
      }
  }
}

// PURE: the supervisor's receipt, refused unless it decodes AND adjudicates this boundary's turn.
fn harness_supervisor_receipt_decode(text: String, steps_taken: Int) -> HarnessSupervisorRead {
  match supervisor_verdict_decode(text: text) {
    VerdictNotDecodable { reason } => SupervisorReadUnreadable { cause: reason }
    VerdictDecoded { receipt } =>
      if receipt.adjudicated_turn == steps_taken {
        SupervisorReadDecoded { verdict: receipt.verdict }
      } else {
        SupervisorReadUnreadable {
          cause: join(["the supervisor's verdict adjudicates turn ", to_string(value: receipt.adjudicated_turn), ", not this boundary's turn ", to_string(value: steps_taken)], ""),
        }
      }
  }
}

type HarnessSupervisorRead
  = SupervisorReadDecoded { verdict: SupervisorVerdict }
  | SupervisorReadUnreadable { cause: String }

type HarnessNestedTurnRead
  = NestedTurnWrote { text: String, carried: List<String> }
  | NestedTurnUndecided { cause: String, carried: List<String> }

fn harness_outcome_artifact_path(outcome: HarnessTurnOutcome) -> String? {
  match outcome {
    TurnCompletedByArtifact { path, steps_taken: _ } => Present { value: path }
    TurnProviderStopped { wire_stop_reason: _, assistant_text: _, steps_taken: _, input_tokens: _, output_tokens: _ } => none
    TurnStepBudgetExhausted { steps_taken: _ } => none
    TurnTransportRefused { detail: _ } => none
    TurnResponseUnreadable { cause: _ } => none
    TurnBackendRefusedUnexplained { cause: _, resumable: _, steps_taken: _ } => none
    TurnResumeRefused { cause: _ } => none
    TurnRequestUnwritable { path: _, detail: _ } => none
    TurnContextWindowExhausted { input_tokens: _, budget: _, steps_taken: _ } => none
    TurnTruncatedMidToolCall { output_tokens: _, ceiling: _, steps_taken: _ } => none
    TurnThinkingFormatInvalid { cause: _, steps_taken: _ } => none
    TurnUsageUnavailable { cause: _, steps_taken: _ } => none
    TurnSubmissionUndecodable { reason: _, steps_taken: _ } => none
    TurnStoppedBySupervision { verdict: _, detail: _, steps_taken: _ } => none
    TurnSupervisionUnavailable { cause: _, steps_taken: _ } => none
    TurnAcceptanceUnavailable { cause: _, steps_taken: _ } => none
    TurnHostedQuotaFull { wire: _, steps_taken: _ } => none
    TurnHostedQuotaUnleasable { detail: _, steps_taken: _ } => none
    TurnHostedFailure { failure: _, steps_taken: _ } => none
    TurnRequestPending { re_deliveries: _, steps_taken: _ } => none
  }
}

// THE PAUSE'S TOKENS ARE THE ATTEMPT'S TOKENS. A nested turn spends the worker's seat, so its usage
// rows join the worker's own stream, where attempt metering and the throughput ledger already read
// usage; leaving them in a side file nobody meters would be an uncounted cost. Every line that is
// not known to be another event is carried verbatim -- an unreadable or usage-unavailable row
// included -- so a gap refuses where usage is read rather than vanishing here.
fn harness_nested_usage_lines(body: String) -> List<String> {
  split(s: body, delimiter: "\n") |> filter(line => harness_nested_line_carried(line: line))
}

fn harness_nested_line_carried(line: String) -> Bool {
  if trim(line) == "" {
    false
  } else {
    match parse_json_document(s: line) {
      JsonDocumentUnreadable { gap: _ } => true
      JsonDocumentParsed { value: doc } =>
        match throughput_is_usage_row(doc: doc) {
          UsageRowIsOurs => true
          UsageRowUnreadable { cause: _ } => true
          UsageRowIsAnotherEvent => line.contains("\"round.usage_unavailable\"")
        }
    }
  }
}

// RUN ONE NESTED TURN AND READ WHAT IT WROTE. Its usage is carried whatever it ended with; an
// unreadable event stream after the turn ran is itself a cause, because usage the attempt spent
// would otherwise go unmetered without a trace. A VERDICT THAT EXISTS BEFORE THE TURN RUNS IS NOT
// ITS VERDICT: the worker's own commands can write under the attempt's state directory, so a file
// already at the verdict path is refused rather than read as this boundary's judgement.
fn harness_nested_turn(config: HarnessTurnConfig, prompt: String, step_budget: Int, verdict_path: String) -> HarnessNestedTurnRead {
  if Filesystem.Read(path: verdict_path).success {
    NestedTurnUndecided {
      cause: join(["found a verdict already at ", verdict_path, " before it ran; a verdict written before the pause is never read as the pause's own"], ""),
      carried: [] as List<String>,
    }
  } else {
    harness_nested_turn_run(config: config, prompt: prompt, step_budget: step_budget)
  }
}

fn harness_nested_turn_run(config: HarnessTurnConfig, prompt: String, step_budget: Int) -> HarnessNestedTurnRead {
  let outcome = harness_run_turn(config: config, prompt: prompt, step_budget: step_budget)
  let events = Filesystem.Read(path: config.events_path as String)
  let carried = if events.success { harness_nested_usage_lines(body: events.content) } else { [] as List<String> }
  if !events.success {
    NestedTurnUndecided { cause: join(["its event stream at ", config.events_path as String, " could not be read back, so its usage cannot be metered: ", events.error], ""), carried: carried }
  } else {
    match harness_outcome_artifact_path(outcome: outcome) {
      Absent =>
        NestedTurnUndecided {
          cause: join(["it ended ", harness_outcome_label(outcome: outcome), ": ", harness_outcome_detail(outcome: outcome)], ""),
          carried: carried,
        }
      Present { value: path } => {
        let read = Filesystem.Read(path: path)
        if read.success {
          NestedTurnWrote { text: read.content, carried: carried }
        } else {
          NestedTurnUndecided { cause: join(["its verdict at ", path, " could not be read: ", read.error], ""), carried: carried }
        }
      }
    }
  }
}

fn harness_event_supervision_verdict(steps_taken: Int, verdict: AlignmentVerdict) -> String {
  serialize_json(v: json_object([
    json_kv(key: "type", value: json_string(s: "supervision.verdict")),
    json_kv(key: "after_turn", value: json_int(n: steps_taken)),
    json_kv(key: "verdict", value: alignment_verdict_json(v: verdict)),
  ]))
}

fn harness_event_supervisor_verdict(steps_taken: Int, verdict: SupervisorVerdict) -> String {
  serialize_json(v: json_object([
    json_kv(key: "type", value: json_string(s: "supervision.supervisor_verdict")),
    json_kv(key: "after_turn", value: json_int(n: steps_taken)),
    json_kv(key: "route", value: json_string(s: supervisor_verdict_route_key(verdict: verdict))),
    json_kv(key: "statement", value: json_string(s: supervisor_verdict_statement(verdict: verdict))),
  ]))
}

fn harness_event_stopped_by_supervision(steps_taken: Int, verdict: String, detail: String) -> String {
  serialize_json(v: json_object([
    json_kv(key: "type", value: json_string(s: "turn.stopped_by_supervision")),
    json_kv(key: "after_turn", value: json_int(n: steps_taken)),
    json_kv(key: "verdict", value: json_string(s: verdict)),
    json_kv(key: "detail", value: json_string(s: detail)),
  ]))
}

fn harness_event_supervision_unavailable(steps_taken: Int, cause: String) -> String {
  serialize_json(v: json_object([
    json_kv(key: "type", value: json_string(s: "turn.supervision_unavailable")),
    json_kv(key: "after_turn", value: json_int(n: steps_taken)),
    json_kv(key: "cause", value: json_string(s: cause)),
  ]))
}

// A STEER IS THE ONLY TEXT A BOUNDARY EVER ADDS, and it is the direction verbatim. On the chat shape
// it is the next user message, which that shape takes after tool messages. On the messages shape the
// round's tool results already form the trailing user message, so the steer joins it as a text block
// -- where the round countdown used to ride -- rather than relying on a second consecutive user turn.
fn harness_messages_with_steer(shape: HarnessWireShape, messages: List<JsonValue>, steer: String) -> List<JsonValue> {
  match shape {
    OpenAiChatCompletionsShape => concat(messages, [harness_user_text_message_json(shape: shape, text: steer)])
    AnthropicMessagesShape => {
      let n = list_length(items: messages)
      match messages.last() {
        Absent => [harness_user_text_message_json(shape: shape, text: steer)]
        Present { value: last } =>
          match harness_user_message_with_text_block(message: last, text: steer) {
            Absent => concat(messages, [harness_user_text_message_json(shape: shape, text: steer)])
            Present { value: joined } =>
              concat(enumerate(messages) |> filter(pair => pair.first < n - 1) |> map(pair => pair.second), [joined])
          }
      }
    }
  }
}

fn harness_member_is(m: JsonKeyValue, key: String, text: String) -> Bool {
  m.key == key && (match m.value { JsonString { value: v } => v == text  _ => false })
}

fn harness_member_is_array(m: JsonKeyValue, key: String) -> Bool {
  m.key == key && (match m.value { JsonArray { elements: _ } => true  _ => false })
}

// A USER MESSAGE WHOSE CONTENT IS A BLOCK ARRAY, with one more text block; anything else is Absent.
fn harness_user_message_with_text_block(message: JsonValue, text: String) -> JsonValue? {
  match message {
    JsonObject { members } =>
      if any(members, m => harness_member_is(m: m, key: "role", text: "user")) && any(members, m => harness_member_is_array(m: m, key: "content")) {
        Present {
          value: JsonObject {
            members: members |> map(m => match m.value {
              JsonArray { elements } =>
                if m.key == "content" {
                  json_kv(key: "content", value: json_array(elements: concat(elements, [json_object([
                    json_kv(key: "type", value: json_string(s: "text")),
                    json_kv(key: "text", value: json_string(s: text)),
                  ])])))
                } else {
                  m
                }
              _ => m
            }),
          },
        }
      } else {
        none
      }
    _ => none
  }
}

fn harness_turn_stop_by_supervision(config: HarnessTurnConfig, verdict: String, detail: String, steps_taken: Int, events: List<String>) -> HarnessTurnOutcome {
  match harness_write_events(config: config, events: concat(events, [harness_event_stopped_by_supervision(steps_taken: steps_taken, verdict: verdict, detail: detail)])) {
    HarnessEventsUnwritable { detail: d } => harness_event_write_refusal(config: config, detail: d)
    HarnessEventsWritten => TurnStoppedBySupervision { verdict: verdict, detail: detail, steps_taken: steps_taken }
  }
}

fn harness_turn_supervision_unavailable(config: HarnessTurnConfig, cause: String, steps_taken: Int, events: List<String>) -> HarnessTurnOutcome {
  match harness_write_events(config: config, events: concat(events, [harness_event_supervision_unavailable(steps_taken: steps_taken, cause: cause)])) {
    HarnessEventsUnwritable { detail: d } => harness_event_write_refusal(config: config, detail: d)
    HarnessEventsWritten => TurnSupervisionUnavailable { cause: cause, steps_taken: steps_taken }
  }
}

// THE PAUSE'S CONTEXT, carried from the check to the supervisor it may convene.
type HarnessSupervisionPause {
  config: HarnessTurnConfig
  check_prompt: String
  check_directory: String
  round_steps: Int
  observation: String
  messages: List<JsonValue>
  steps_taken: Int
  repairs_used: Int
}

fn harness_pause_continue(pause: HarnessSupervisionPause, events: List<String>) -> HarnessTurnOutcome {
  harness_turn_loop(config: pause.config, messages: pause.messages, steps_remaining: pause.round_steps, steps_taken: pause.steps_taken, events: events, repairs_used: pause.repairs_used)
}

fn harness_pause_steer(pause: HarnessSupervisionPause, direction: String, events: List<String>) -> HarnessTurnOutcome {
  harness_turn_loop(
    config: pause.config,
    messages: harness_messages_with_steer(shape: pause.config.wire_shape, messages: pause.messages, steer: direction),
    steps_remaining: pause.round_steps,
    steps_taken: pause.steps_taken,
    events: events,
    repairs_used: pause.repairs_used,
  )
}

fn harness_pause_convene_supervisor(pause: HarnessSupervisionPause, check_verdict: AlignmentVerdict, events: List<String>) -> HarnessTurnOutcome {
  let verdict_path = join([pause.check_directory, "/", harness_supervision_verdict_name(kind: "supervisor", steps_taken: pause.steps_taken)], "")
  let config = harness_supervision_nested_config(
    config: pause.config,
    check_directory: pause.check_directory,
    kind: "supervisor",
    steps_taken: pause.steps_taken,
    system_prompt: supervisor_system_prompt_at(worktree: pause.config.environment.working_directory as String, verdict_path: verdict_path),
  )
  let brief = supervisor_brief_for(
    chain: pause.check_prompt,
    check_verdict: serialize_json(v: alignment_verdict_json(v: check_verdict)),
    observation: pause.observation,
    adjudicated_turn: pause.steps_taken,
  )
  match harness_nested_turn(config: config, prompt: brief, step_budget: harness_supervision_supervisor_step_budget, verdict_path: verdict_path) {
    NestedTurnUndecided { cause, carried } =>
      harness_turn_supervision_unavailable(config: pause.config, cause: join(["the supervisor ", cause], ""), steps_taken: pause.steps_taken, events: concat(events, carried))
    NestedTurnWrote { text, carried } =>
      match harness_supervisor_receipt_decode(text: text, steps_taken: pause.steps_taken) {
        SupervisorReadUnreadable { cause } =>
          harness_turn_supervision_unavailable(config: pause.config, cause: cause, steps_taken: pause.steps_taken, events: concat(events, carried))
        SupervisorReadDecoded { verdict } => {
          let recorded = concat(concat(events, carried), [harness_event_supervisor_verdict(steps_taken: pause.steps_taken, verdict: verdict)])
          match verdict {
            VerdictContinue { basis: _ } => harness_pause_continue(pause: pause, events: recorded)
            VerdictSteer { direction } => harness_pause_steer(pause: pause, direction: direction, events: recorded)
            VerdictPlanDefect { defect } =>
              harness_turn_stop_by_supervision(config: pause.config, verdict: supervisor_verdict_route_key(verdict: verdict), detail: defect, steps_taken: pause.steps_taken, events: recorded)
            VerdictStuck { cause } =>
              harness_turn_stop_by_supervision(config: pause.config, verdict: supervisor_verdict_route_key(verdict: verdict), detail: cause, steps_taken: pause.steps_taken, events: recorded)
          }
        }
      }
  }
}

fn harness_pause_apply(pause: HarnessSupervisionPause, verdict: AlignmentVerdict, events: List<String>) -> HarnessTurnOutcome {
  let recorded = concat(events, [harness_event_supervision_verdict(steps_taken: pause.steps_taken, verdict: verdict)])
  match verdict {
    Aligned => harness_pause_continue(pause: pause, events: recorded)
    Misaligned { direction } => harness_pause_steer(pause: pause, direction: direction, events: recorded)
    ExtremelyMisaligned { direction: _ } => harness_pause_convene_supervisor(pause: pause, check_verdict: verdict, events: recorded)
    RoutedConflict { conflict: _ } => harness_pause_convene_supervisor(pause: pause, check_verdict: verdict, events: recorded)
    CatastrophicallyMisaligned { reason } =>
      harness_turn_stop_by_supervision(config: pause.config, verdict: alignment_verdict_key(v: verdict), detail: reason, steps_taken: pause.steps_taken, events: recorded)
  }
}

fn harness_turn_supervise(
  config: HarnessTurnConfig,
  check_prompt: String,
  check_directory: String,
  round_steps: Int,
  messages: List<JsonValue>,
  steps_taken: Int,
  events: List<String>,
  repairs_used: Int,
) -> HarnessTurnOutcome {
  let observation = harness_supervision_observation_text(messages: messages, round_steps: round_steps)
  let observation_path = harness_supervision_artifact_path(check_directory: check_directory, kind: "observation", steps_taken: steps_taken, extension: ".txt")
  let persisted = Filesystem.Write(path: observation_path, content: observation)
  if !persisted.success {
    harness_turn_supervision_unavailable(
      config: config,
      cause: join(["the round's observation could not be persisted at ", observation_path, ": ", persisted.error], ""),
      steps_taken: steps_taken,
      events: events,
    )
  } else {
    let pause = HarnessSupervisionPause {
      config: config,
      check_prompt: check_prompt,
      check_directory: check_directory,
      round_steps: round_steps,
      observation: observation,
      messages: messages,
      steps_taken: steps_taken,
      repairs_used: repairs_used,
    }
    let verdict_path = join([check_directory, "/", harness_supervision_verdict_name(kind: "check", steps_taken: steps_taken)], "")
    let check_config = harness_supervision_nested_config(
      config: config,
      check_directory: check_directory,
      kind: "check",
      steps_taken: steps_taken,
      system_prompt: harness_supervision_system_prompt(verdict_path: verdict_path),
    )
    match harness_nested_turn(
      config: check_config,
      prompt: harness_supervision_check_prompt(check_prompt: check_prompt, observation: observation, steps_taken: steps_taken),
      step_budget: harness_supervision_check_step_budget,
      verdict_path: verdict_path,
    ) {
      NestedTurnUndecided { cause, carried } =>
        harness_turn_supervision_unavailable(config: config, cause: join(["the alignment check ", cause], ""), steps_taken: steps_taken, events: concat(events, carried))
      NestedTurnWrote { text, carried } =>
        match harness_supervision_verdict_decode(text: text) {
          SupervisionVerdictUnreadable { cause } =>
            harness_turn_supervision_unavailable(config: config, cause: cause, steps_taken: steps_taken, events: concat(events, carried))
          SupervisionVerdictDecoded { verdict } => harness_pause_apply(pause: pause, verdict: verdict, events: concat(events, carried))
        }
    }
  }
}

// ── HAND-IN: THE SESSION WAITS FOR ITS ACCEPTANCE OUTCOME (gunbc.plans.harness_session_lifecycle, S2) ───
//
// A supervised worker that stops with a READY submission has handed in a candidate. It does not end:
// it records the hand-in under a fresh id, wakes acceptance through the event spool, and waits --
// making no model calls and running no tools -- for the one outcome addressed to that hand-in. Accepted
// ends the session at the delivery handoff; a requested change comes back into this conversation as
// one message and the round renews; acceptance that cannot decide, or does not answer within the
// deadline, stops the session typed. A worker that stops blocked, needing context, or with nothing
// handed in ends as before.

data harness_acceptance_poll_seconds: Int = 30

// THREE HOURS: verification, review and the goal audit run in sequence on a shared host, and a review
// alone has taken over half an hour on the srv1 lab. Past this the session stops and says why.
data harness_acceptance_deadline_polls: Int = 360

type HarnessHandInRoute {
  route: HarnessAcceptanceRoute
  check_directory: String
  round_steps: Int
}

fn harness_handin_route(supervision: HarnessSupervision, observed: SubmissionGateObservation) -> HarnessHandInRoute? {
  match supervision {
    Unsupervised => none
    SupervisedRounds { chain_fingerprint: _, check_prompt: _, check_directory, round_steps, acceptance } =>
      match observed {
        GateArtifactDeclared { ready } =>
          if ready { Present { value: HarnessHandInRoute { route: acceptance, check_directory: check_directory, round_steps: round_steps } } } else { none }
        GateArtifactAbsent => none
        GateArtifactUndecodable { reason: _ } => none
        GateArtifactUnobservable { cause: _ } => none
      }
  }
}

fn harness_handin_ordinal(events: List<String>) -> Int {
  1 + list_length(items: events |> filter(e => e.contains("\"session.handed_in\"")))
}

// THE HAND-IN ID BINDS THE SAME TWO FACTS CAPTURE WILL RECORD: git head_sha and the tree object
// (%T) as the content half of the candidate. The SCM envelope locator does not exist until the
// belt mints capture, so the tree sha is the root binding observable at hand-in. A refused git
// read is Unreadable, never an empty string treated as a head.
type HandInWorktreeObservation
  = HandInWorktreeObserved { head_sha: String, tree_sha: String }
  | HandInWorktreeUnreadable { cause: String }

fn harness_handin_candidate_from_observations(
  worktree: String,
  head_success: Bool,
  head_sha: String,
  head_stderr: String,
  tree_success: Bool,
  tree_sha: String,
  tree_stderr: String,
) -> HandInWorktreeObservation {
  if !head_success {
    HandInWorktreeUnreadable { cause: join(["git.Inspect.HeadCommitIn refused in ", worktree, ": ", head_stderr], "") }
  } else if !tree_success {
    HandInWorktreeUnreadable { cause: join(["git.Inspect.ShowTreeIn refused in ", worktree, ": ", tree_stderr], "") }
  } else {
    HandInWorktreeObserved { head_sha: trim(head_sha), tree_sha: trim(tree_sha) }
  }
}

fn harness_observe_handin_candidate(worktree: String) -> HandInWorktreeObservation {
  let head = git.Inspect.HeadCommitIn(repository_path: worktree)
  let tree = git.Inspect.ShowTreeIn(repository_path: worktree, ref: "HEAD" as GitRef)
  harness_handin_candidate_from_observations(
    worktree: worktree,
    head_success: head.success,
    head_sha: head.sha,
    head_stderr: head.stderr,
    tree_success: tree.success,
    tree_sha: tree.tree,
    tree_stderr: tree.stderr,
  )
}

fn harness_mint_handin_id(events: List<String>, attempt_key: String, head_sha: String, tree_sha: String) -> String {
  handin_identity(attempt_key: attempt_key, ordinal: harness_handin_ordinal(events: events), head: head_sha, scm_root: tree_sha)
}

fn harness_next_handin_id(events: List<String>) -> String {
  join(["h", to_string(value: harness_handin_ordinal(events: events))], "")
}

fn harness_block_is_hand_in(block: HarnessWireBlock) -> Bool {
  match block {
    WireToolUseBlock { id: _, name: n, input: _ } =>
      match harness_tool_of_wire_name(name: n) {
        HarnessToolRecognized { tool: HandInTool } => true
        HarnessToolRecognized { tool: _ } => false
        HarnessToolUnrecognized { name: _ } => false
      }
    WireTextBlock { text: _ } => false
    WireThinkingBlock { thinking: _ } => false
  }
}

fn harness_hand_in_block(uses: List<HarnessWireBlock>) -> HarnessWireBlock? {
  (uses |> filter(u => harness_block_is_hand_in(block: u))).first()
}

fn harness_acceptance_outcome_tool_text(o: AcceptanceOutcome) -> String {
  match o {
    AcceptanceAccepted => "accepted"
    AcceptanceChangesRequested { stage, findings } =>
      join(["changes-requested\nstage: ", stage, "\n", findings], "")
    AcceptanceUnavailable { cause } => join(["unavailable\n", cause], "")
  }
}

type HarnessHandInSeat
  = HandInSeatReady { config: HarnessTurnConfig }
  | HandInSeatReleaseRefused { detail: String }

fn harness_turn_config_with_environment(config: HarnessTurnConfig, environment: HarnessToolEnvironment) -> HarnessTurnConfig {
  HarnessTurnConfig {
    backend_url: config.backend_url,
    model: config.model,
    max_tokens: config.max_tokens,
    serving_unit: config.serving_unit,
    reasoning_mode: config.reasoning_mode,
    wire_shape: config.wire_shape,
    system_prompt: config.system_prompt,
    supervision: config.supervision,
    request_scratch_path: config.request_scratch_path,
    events_path: config.events_path,
    context_budget: config.context_budget,
    request_deadline: config.request_deadline,
    environment: environment,
    completion: config.completion,
    backend_access: config.backend_access,
    acceptance_capacity: config.acceptance_capacity,
  }
}

fn harness_turn_config_with_capacity(config: HarnessTurnConfig, acceptance_capacity: HarnessAcceptanceCapacity) -> HarnessTurnConfig {
  HarnessTurnConfig {
    backend_url: config.backend_url,
    model: config.model,
    max_tokens: config.max_tokens,
    serving_unit: config.serving_unit,
    reasoning_mode: config.reasoning_mode,
    wire_shape: config.wire_shape,
    system_prompt: config.system_prompt,
    supervision: config.supervision,
    request_scratch_path: config.request_scratch_path,
    events_path: config.events_path,
    context_budget: config.context_budget,
    request_deadline: config.request_deadline,
    environment: config.environment,
    completion: config.completion,
    backend_access: config.backend_access,
    acceptance_capacity: acceptance_capacity,
  }
}

fn harness_release_fleet_seat_for_handin(config: HarnessTurnConfig) -> HarnessHandInSeat {
  match config.acceptance_capacity {
    KeepBindingAlive => HandInSeatReady { config: config }
    FleetSeatReleasedForAcceptance { binding: _, admission: _ } => HandInSeatReady { config: config }
    FleetSeatHeld { binding, admission } =>
      match harness_release_seat(binding: binding, reason: "awaiting acceptance" as NonEmptyStr) {
        HarnessSeatReleased { partition: _ } =>
          HandInSeatReady { config: harness_turn_config_with_capacity(config: config, acceptance_capacity: FleetSeatReleasedForAcceptance { binding: binding, admission: admission }) }
        HarnessHostedCredentialRemoved =>
          HandInSeatReleaseRefused { detail: "a fleet seat release answered as a hosted credential removal; the seat may still be held" }
        HarnessSeatReleaseRefused { detail } => HandInSeatReleaseRefused { detail: detail }
        HarnessSeatReleaseNotApplicable { why } => HandInSeatReleaseRefused { detail: why }
      }
  }
}

fn harness_rebind_fleet_for_revision(config: HarnessTurnConfig, prior: HarnessSeatBinding, admission: AdmissionTerms, handin: String) -> HarnessHandInSeat {
  match prior {
    HarnessSeatRefused { detail: d } => HandInSeatReleaseRefused { detail: d }
    HarnessSeatPending { detail: d } => HandInSeatReleaseRefused { detail: d }
    HarnessHostedBound { url: _, model: _, unit: _, level: _, access: _ } => HandInSeatReleaseRefused { detail: "a hosted binding cannot be rebound as a fleet seat after acceptance" }
    HarnessOperatorBound { url: _, model: _, unit: _, header_dir: _, header_file: _ } => HandInSeatReady { config: config }
    HarnessSeatBound { url: _, grant: _, partition: _, ceiling: _, replica_wire: _, launch: _, store: _, model: _, unit: _, class: class, seat: seat } => {
      let host = os.Hostname.ReadShort()
      if !host.success {
        HandInSeatReleaseRefused { detail: "the executor hostname could not be read, so a fleet seat cannot be rebound after acceptance" }
      } else {
        let worktree = config.environment.working_directory as String
        let attempt = join([seat.attempt as String, "+rev+", handin], "") as NonEmptyStr
        let rebound = harness_bind_seat(
          short_hostname: host.value,
          class: class,
          requirement: AnyAdmittedModel,
          shape: config.wire_shape,
          inputs: [config.system_prompt, handin],
          actor: join(["worker:", worktree], "") as NonEmptyStr,
          attempt: attempt,
          policy: LeasePolicy {
            maximum_duration_seconds: second_count(s: config.request_deadline) + 60,
            release_law: QuiescenceRequired,
          },
          session: none,
          admission: admission,
          turn: none,
        )
        match rebound {
          HarnessSeatRefused { detail: d } => HandInSeatReleaseRefused { detail: d }
          HarnessSeatPending { detail: d } => HandInSeatReleaseRefused { detail: join(["fleet seat pending after acceptance, so revision cannot continue on a released seat: ", d], "") }
          HarnessHostedBound { url: _, model: _, unit: _, level: _, access: _ } => HandInSeatReleaseRefused { detail: "revision rebind answered as a hosted quota binding" }
          HarnessOperatorBound { url: _, model: _, unit: _, header_dir: _, header_file: _ } => HandInSeatReleaseRefused { detail: "revision rebind answered as an operator endpoint" }
          HarnessSeatBound { url: u, grant: _, partition: _, ceiling: _, replica_wire: _, launch: _, store: _, model: m, unit: un, class: _, seat: _ } =>
            HandInSeatReady {
              config: HarnessTurnConfig {
                backend_url: u,
                model: m as String,
                max_tokens: config.max_tokens,
                serving_unit: un,
                reasoning_mode: config.reasoning_mode,
                wire_shape: config.wire_shape,
                system_prompt: config.system_prompt,
                supervision: config.supervision,
                request_scratch_path: config.request_scratch_path,
                events_path: config.events_path,
                context_budget: harness_context_budget_for(unit: un),
                request_deadline: config.request_deadline,
                environment: config.environment,
                completion: config.completion,
                backend_access: BackendAdmittedBySeat,
                acceptance_capacity: FleetSeatHeld { binding: rebound, admission: admission },
              }
            }
        }
      }
    }
  }
}

fn harness_resume_after_acceptance_wait(config: HarnessTurnConfig, handin: String) -> HarnessHandInSeat {
  match config.acceptance_capacity {
    KeepBindingAlive => HandInSeatReady { config: config }
    FleetSeatHeld { binding: _, admission: _ } => HandInSeatReady { config: config }
    FleetSeatReleasedForAcceptance { binding, admission } => harness_rebind_fleet_for_revision(config: config, prior: binding, admission: admission, handin: handin)
  }
}

fn harness_outcome_steps_taken(outcome: HarnessTurnOutcome) -> Int {
  match outcome {
    TurnProviderStopped { wire_stop_reason: _, assistant_text: _, steps_taken: n, input_tokens: _, output_tokens: _ } => n
    TurnCompletedByArtifact { path: _, steps_taken: n } => n
    TurnStepBudgetExhausted { steps_taken: n } => n
    TurnTransportRefused { detail: _ } => 0
    TurnResponseUnreadable { cause: _ } => 0
    TurnBackendRefusedUnexplained { cause: _, resumable: _, steps_taken: n } => n
    TurnResumeRefused { cause: _ } => 0
    TurnRequestUnwritable { path: _, detail: _ } => 0
    TurnContextWindowExhausted { input_tokens: _, budget: _, steps_taken: n } => n
    TurnTruncatedMidToolCall { output_tokens: _, ceiling: _, steps_taken: n } => n
    TurnThinkingFormatInvalid { cause: _, steps_taken: n } => n
    TurnUsageUnavailable { cause: _, steps_taken: n } => n
    TurnSubmissionUndecodable { reason: _, steps_taken: n } => n
    TurnStoppedBySupervision { verdict: _, detail: _, steps_taken: n } => n
    TurnSupervisionUnavailable { cause: _, steps_taken: n } => n
    TurnAcceptanceUnavailable { cause: _, steps_taken: n } => n
    TurnHostedQuotaFull { wire: _, steps_taken: n } => n
    TurnHostedQuotaUnleasable { detail: _, steps_taken: n } => n
    TurnHostedFailure { failure: _, steps_taken: n } => n
    TurnRequestPending { re_deliveries: _, steps_taken: n } => n
  }
}

fn harness_release_capacity_if_held(config: HarnessTurnConfig, outcome: HarnessTurnOutcome) -> HarnessTurnOutcome {
  match config.acceptance_capacity {
    KeepBindingAlive => outcome
    FleetSeatReleasedForAcceptance { binding: _, admission: _ } => outcome
    FleetSeatHeld { binding, admission: _ } =>
      match harness_release_seat(binding: binding, reason: harness_outcome_label(outcome: outcome) as NonEmptyStr) {
        HarnessSeatReleased { partition: _ } => outcome
        HarnessSeatReleaseNotApplicable { why: _ } => outcome
        HarnessHostedCredentialRemoved =>
          TurnAcceptanceUnavailable {
            cause: "the rebound fleet seat release answered as a hosted credential removal; the seat may still be held",
            steps_taken: harness_outcome_steps_taken(outcome: outcome),
          }
        HarnessSeatReleaseRefused { detail } =>
          TurnAcceptanceUnavailable {
            cause: join(["the rebound fleet seat could not be released after revision: ", detail], ""),
            steps_taken: harness_outcome_steps_taken(outcome: outcome),
          }
      }
  }
}

fn harness_event_handed_in(handin: String) -> String {
  serialize_json(v: json_object([
    json_kv(key: "type", value: json_string(s: "session.handed_in")),
    json_kv(key: "handin", value: json_string(s: handin)),
  ]))
}

fn harness_event_session_outcome(event_type: String, handin: String, detail: String) -> String {
  serialize_json(v: json_object([
    json_kv(key: "type", value: json_string(s: event_type)),
    json_kv(key: "handin", value: json_string(s: handin)),
    json_kv(key: "detail", value: json_string(s: detail)),
  ]))
}

type HarnessHandInRoundPrep
  = HandInRoundBlocked {
      environment: HarnessToolEnvironment
      results: List<HarnessToolResult>
      detail: String
    }
  | HandInRoundClear {
      environment: HarnessToolEnvironment
      results: List<HarnessToolResult>
    }

fn harness_prepare_hand_in_round(
  environment: HarnessToolEnvironment,
  uses: List<HarnessWireBlock>,
) -> HarnessHandInRoundPrep {
  let others = uses |> filter(u => !harness_block_is_hand_in(block: u))
  let executed = harness_execute_tools(environment: environment, uses: others)
  match harness_hand_in_blocked_by_running_jobs(jobs: executed.environment.jobs) {
    Present { value: detail } =>
      HandInRoundBlocked {
        environment: executed.environment,
        results: executed.results,
        detail: detail,
      }
    Absent =>
      HandInRoundClear {
        environment: executed.environment,
        results: executed.results,
      }
  }
}

fn harness_turn_execute_hand_in(
  config: HarnessTurnConfig,
  messages: List<JsonValue>,
  blocks: List<HarnessWireBlock>,
  uses: List<HarnessWireBlock>,
  hand_block: HarnessWireBlock,
  events: List<String>,
  steps_taken: Int,
  steps_remaining: Int,
  input_tokens: TokenCount,
  output_tokens: TokenCount,
  clock: ClockUnixMillisRead,
  repairs_used: Int,
  text: String,
  stop_reason: AnthropicStopReason,
) -> HarnessTurnOutcome {
  match harness_prepare_hand_in_round(environment: config.environment, uses: uses) {
    HandInRoundBlocked { environment: env_after, results: other_results, detail: blocked } => {
      let config_after = harness_turn_config_with_environment(
        config: config,
        environment: env_after,
      )
      let refused = HarnessToolResult {
        tool_use_id: harness_tool_use_id(block: hand_block),
        text: blocked,
        is_error: true,
      }
      let usage_after = harness_event_round_usage(
        step: steps_taken + 1,
        input_tokens: input_tokens,
        output_tokens: output_tokens,
        clock: clock,
        tool_calls: list_length(items: uses),
        files_changed: harness_worktree_files_changed(environment: config_after.environment),
      )
      let stepped = concat(concat(events, [usage_after]), harness_tool_round_events(uses: uses))
      match harness_write_events(config: config_after, events: stepped) {
        HarnessEventsUnwritable { detail: d } => harness_event_write_refusal(config: config_after, detail: d)
        HarnessEventsWritten =>
          harness_turn_continue(
            config: config_after, messages: messages, blocks: blocks,
            results: concat(other_results, [refused]),
            steps_remaining: steps_remaining, steps_taken: steps_taken, input_tokens: input_tokens,
            events: stepped, repairs_used: repairs_used,
          )
      }
    }
    HandInRoundClear { environment: env_after, results: other_results } => {
      let config_after = harness_turn_config_with_environment(
        config: config,
        environment: env_after,
      )
      let usage_after = harness_event_round_usage(
        step: steps_taken + 1,
        input_tokens: input_tokens,
        output_tokens: output_tokens,
        clock: clock,
        tool_calls: list_length(items: uses),
        files_changed: harness_worktree_files_changed(environment: config_after.environment),
      )
      let stepped = concat(concat(events, [usage_after]), harness_tool_round_events(uses: uses))
      match harness_write_events(config: config_after, events: stepped) {
        HarnessEventsUnwritable { detail: d } => harness_event_write_refusal(config: config_after, detail: d)
        HarnessEventsWritten => {
          let observed = harness_submission_gate_observe(environment: config_after.environment)
          match harness_handin_route(supervision: config.supervision, observed: observed) {
            Absent => {
              let refused = HarnessToolResult {
                tool_use_id: harness_tool_use_id(block: hand_block),
                text: "hand_in refused: the submission is not a ready candidate, or this session is not on the hand-in route",
                is_error: true,
              }
              harness_turn_continue(
                config: config_after, messages: messages, blocks: blocks,
                results: concat(other_results, [refused]),
                steps_remaining: steps_remaining, steps_taken: steps_taken, input_tokens: input_tokens,
                events: stepped, repairs_used: repairs_used,
              )
            }
            Present { value: route } =>
              harness_turn_hand_in(
                config: config_after,
                route: route,
                messages: messages,
                events: stepped,
                steps_taken: steps_taken + 1,
                text: text,
                stop_reason: stop_reason,
                input_tokens: input_tokens,
                output_tokens: output_tokens,
                tool_use_id: Present { value: harness_tool_use_id(block: hand_block) },
                prior_results: other_results,
                steps_remaining: steps_remaining,
                repairs_used: repairs_used,
                blocks: blocks,
              )
          }
        }
      }
    }
  }
}

fn harness_event_acceptance_unavailable(handin: String?, cause: String) -> String {
  match handin {
    Absent =>
      serialize_json(v: json_object([
        json_kv(key: "type", value: json_string(s: "turn.acceptance_unavailable")),
        json_kv(key: "detail", value: json_string(s: cause)),
      ]))
    Present { value: h } => harness_event_session_outcome(event_type: "turn.acceptance_unavailable", handin: h, detail: cause)
  }
}

fn harness_turn_acceptance_unavailable(config: HarnessTurnConfig, handin: String?, cause: String, steps_taken: Int, events: List<String>) -> HarnessTurnOutcome {
  match harness_write_events(config: config, events: concat(events, [harness_event_acceptance_unavailable(handin: handin, cause: cause)])) {
    HarnessEventsUnwritable { detail: d } => harness_event_write_refusal(config: config, detail: d)
    HarnessEventsWritten => TurnAcceptanceUnavailable { cause: cause, steps_taken: steps_taken }
  }
}

fn harness_turn_hand_in(
  config: HarnessTurnConfig,
  route: HarnessHandInRoute,
  messages: List<JsonValue>,
  events: List<String>,
  steps_taken: Int,
  text: String,
  stop_reason: AnthropicStopReason,
  input_tokens: TokenCount,
  output_tokens: TokenCount,
  tool_use_id: String?,
  prior_results: List<HarnessToolResult>,
  steps_remaining: Int,
  repairs_used: Int,
  blocks: List<HarnessWireBlock>,
) -> HarnessTurnOutcome {
  let worktree = config.environment.working_directory as String
  match harness_observe_handin_candidate(worktree: worktree) {
    HandInWorktreeUnreadable { cause } =>
      harness_turn_acceptance_unavailable(
        config: config,
        handin: none,
        cause: cause,
        steps_taken: steps_taken,
        events: events,
      )
    HandInWorktreeObserved { head_sha, tree_sha } => {
      let handin = harness_mint_handin_id(
        events: events,
        attempt_key: route.route.attempt_key,
        head_sha: head_sha,
        tree_sha: tree_sha,
      )
      let recorded = concat(events, [harness_event_handed_in(handin: handin)])
      match harness_write_events(config: config, events: recorded) {
        HarnessEventsUnwritable { detail: d } => harness_event_write_refusal(config: config, detail: d)
        HarnessEventsWritten => {
          let entry = join([route.route.inbox, "/", attempt_handin_entry_name(node_id: route.route.node_id, attempt_key: route.route.attempt_key, handin: handin)], "")
          let woke = Filesystem.Write(path: entry, content: "")
          if !woke.success {
            harness_turn_acceptance_unavailable(config: config, handin: Present { value: handin }, cause: join(["the hand-in could not be recorded in the event spool at ", entry, ": ", woke.error], ""), steps_taken: steps_taken, events: recorded)
          } else {
            match harness_release_fleet_seat_for_handin(config: config) {
              HandInSeatReleaseRefused { detail } =>
                harness_turn_acceptance_unavailable(
                  config: config,
                  handin: Present { value: handin },
                  cause: join(["fleet seat could not be released at a quiescent hand-in: ", detail], ""),
                  steps_taken: steps_taken,
                  events: recorded,
                )
              HandInSeatReady { config: waiting } =>
                harness_await_acceptance(
                  config: waiting,
                  route: route, handin: handin, polls_left: harness_acceptance_deadline_polls,
                  messages: messages, events: recorded, steps_taken: steps_taken,
                  text: text, stop_reason: stop_reason, input_tokens: input_tokens, output_tokens: output_tokens,
                  tool_use_id: tool_use_id, prior_results: prior_results, steps_remaining: steps_remaining,
                  repairs_used: repairs_used, blocks: blocks,
                )
            }
          }
        }
      }
    }
  }
}

// PURE: the outcome file's text to the outcome for THIS hand-in, or none -- an absent, undecodable or
// other hand-in's outcome all mean "still waiting", so a stale outcome can neither steer nor finish.
fn harness_acceptance_outcome_for(text: String?, handin: String) -> AcceptanceOutcome? {
  match text {
    Absent => none
    Present { value: t } =>
      match acceptance_outcome_decode(text: t) {
        AcceptanceOutcomeUndecodable { reason: _ } => none
        AcceptanceOutcomeDecoded { record } =>
          if acceptance_outcome_addresses(record: record, handin: handin) { Present { value: record.outcome } } else { none }
      }
  }
}

fn harness_acceptance_wait_expired_cause(handin: String) -> String {
  join(["no acceptance outcome named hand-in ", handin, " within ", to_string(value: harness_acceptance_deadline_polls * harness_acceptance_poll_seconds), " s"], "")
}

fn harness_await_acceptance(
  config: HarnessTurnConfig,
  route: HarnessHandInRoute,
  handin: String,
  polls_left: Int,
  messages: List<JsonValue>,
  events: List<String>,
  steps_taken: Int,
  text: String,
  stop_reason: AnthropicStopReason,
  input_tokens: TokenCount,
  output_tokens: TokenCount,
  tool_use_id: String?,
  prior_results: List<HarnessToolResult>,
  steps_remaining: Int,
  repairs_used: Int,
  blocks: List<HarnessWireBlock>,
) -> HarnessTurnOutcome {
  let read = Filesystem.Read(path: join([route.route.outcome_directory, "/", acceptance_outcome_basename as String], ""))
  match harness_acceptance_outcome_for(text: if read.success { Present { value: read.content } } else { none }, handin: handin) {
    Present { value: outcome } =>
      harness_apply_acceptance(
        config: config, route: route, handin: handin, outcome: outcome, messages: messages, events: events,
        steps_taken: steps_taken, text: text, stop_reason: stop_reason, input_tokens: input_tokens, output_tokens: output_tokens,
        tool_use_id: tool_use_id, prior_results: prior_results, steps_remaining: steps_remaining,
        repairs_used: repairs_used, blocks: blocks,
      )
    Absent =>
      if polls_left <= 0 {
        harness_turn_acceptance_unavailable(
          config: config, handin: Present { value: handin },
          cause: harness_acceptance_wait_expired_cause(handin: handin),
          steps_taken: steps_taken, events: events,
        )
      } else {
        let waited = sleep_delay_seconds_second_carrier_projection(duration: second(count: harness_acceptance_poll_seconds))
        harness_await_acceptance(
          config: config, route: route, handin: handin, polls_left: polls_left - 1,
          messages: messages, events: events, steps_taken: steps_taken,
          text: text, stop_reason: stop_reason, input_tokens: input_tokens, output_tokens: output_tokens,
          tool_use_id: tool_use_id, prior_results: prior_results, steps_remaining: steps_remaining,
          repairs_used: repairs_used, blocks: blocks,
        )
      }
  }
}

// A REQUESTED CHANGE IS ONE MESSAGE, naming the stage and carrying its findings, and the handed-in
// submission is kept beside the worktree under its hand-in id so the next hand-in is the worker's own
// new declaration, never this one swept again.
fn harness_revision_text(handin: String, stage: String, findings: String) -> String {
  join([
    "Acceptance of your hand-in ", handin, " requested changes (", stage, "):\n", findings,
    "\nMake the changes, then call hand_in again after writing a new ", submission_artifact_name as String, ".",
  ], "")
}

fn harness_apply_acceptance(
  config: HarnessTurnConfig,
  route: HarnessHandInRoute,
  handin: String,
  outcome: AcceptanceOutcome,
  messages: List<JsonValue>,
  events: List<String>,
  steps_taken: Int,
  text: String,
  stop_reason: AnthropicStopReason,
  input_tokens: TokenCount,
  output_tokens: TokenCount,
  tool_use_id: String?,
  prior_results: List<HarnessToolResult>,
  steps_remaining: Int,
  repairs_used: Int,
  blocks: List<HarnessWireBlock>,
) -> HarnessTurnOutcome {
  match outcome {
    AcceptanceAccepted => {
      let accepted = concat(events, [
        harness_event_session_outcome(event_type: "session.accepted", handin: handin, detail: "verification passed and review and the goal audit approved"),
        harness_event_type_only(event_type: "turn.completed"),
      ])
      match harness_write_events(config: config, events: accepted) {
        HarnessEventsUnwritable { detail: d } => harness_event_write_refusal(config: config, detail: d)
        HarnessEventsWritten =>
          TurnProviderStopped {
            wire_stop_reason: harness_stop_reason_wire(reason: stop_reason),
            assistant_text: harness_acceptance_outcome_tool_text(o: AcceptanceAccepted),
            steps_taken: steps_taken,
            input_tokens: token_count_value(t: input_tokens),
            output_tokens: token_count_value(t: output_tokens),
          }
      }
    }
    AcceptanceUnavailable { cause } =>
      harness_turn_acceptance_unavailable(config: config, handin: Present { value: handin }, cause: cause, steps_taken: steps_taken, events: events)
    AcceptanceChangesRequested { stage, findings } => {
      let dir = config.environment.working_directory as String
      let submitted = join([dir, "/", submission_artifact_name as String], "")
      let kept = join([dir, "/.gunbc-submission.", handin, ".json"], "")
      let moved = shell.Move.File(source: submitted as FilePath, destination: kept as FilePath)
      if !moved.success {
        harness_turn_acceptance_unavailable(config: config, handin: Present { value: handin }, cause: join(["changes were requested, but the handed-in submission could not be moved aside to ", kept], ""), steps_taken: steps_taken, events: events)
      } else {
        let revising = concat(events, [harness_event_session_outcome(event_type: "session.revision_started", handin: handin, detail: stage)])
        match harness_write_events(config: config, events: revising) {
          HarnessEventsUnwritable { detail: d } => harness_event_write_refusal(config: config, detail: d)
          HarnessEventsWritten =>
            match harness_resume_after_acceptance_wait(config: config, handin: handin) {
              HandInSeatReleaseRefused { detail } =>
                harness_turn_acceptance_unavailable(
                  config: config,
                  handin: Present { value: handin },
                  cause: join(["changes were requested, but a fleet seat could not be rebound for revision: ", detail], ""),
                  steps_taken: steps_taken,
                  events: revising,
                )
              HandInSeatReady { config: resumed } =>
                harness_release_capacity_if_held(
                  config: resumed,
                  outcome: match tool_use_id {
                    Present { value: id } =>
                      harness_turn_continue(
                        config: resumed,
                        messages: messages,
                        blocks: blocks,
                        results: concat(prior_results, [HarnessToolResult {
                          tool_use_id: id,
                          text: harness_acceptance_outcome_tool_text(o: outcome),
                          is_error: false,
                        }]),
                        steps_remaining: steps_remaining,
                        steps_taken: steps_taken,
                        input_tokens: input_tokens,
                        events: revising,
                        repairs_used: 0,
                      )
                    Absent =>
                      harness_turn_loop(
                        config: resumed,
                        messages: harness_messages_with_steer(shape: config.wire_shape, messages: messages, steer: harness_revision_text(handin: handin, stage: stage, findings: findings)),
                        steps_remaining: route.round_steps,
                        steps_taken: steps_taken,
                        events: revising,
                        repairs_used: 0,
                      )
                  },
                )
            }
        }
      }
    }
  }
}
