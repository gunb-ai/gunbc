// THE OPERATOR'S HAND-RENTED VAST CARD, IMPORTED AS ONE RENTED SERVING ALLOCATION. The operator rented it
// on 2026-10-14 (Vast instance 55954143, label `daily workspace`, RTX PRO 6000 Blackwell Max-Q, 97887 MiB) to
// replace contract 55807382, unreachable since 03:25Z that day, and started ninfer-serve on it at 16:12:59Z;
// this repository did not acquire it, so the origin is Imported and names the launch it found running. The
// facts below were read from srv1 at about 18:00Z: nvidia-smi name and memory, the host key at first contact,
// the ninfer-serve command line, and /v1/models through the tunnel. Every field that already has an
// authority is that authority, not a copy:
// - the engine is gunbc.harness.operator_pod_launch operator_pod_ninfer_launch on operator_pod_listen_port;
// - the route is gunbc.harness.harness_operator_route operator_endpoint_tunnel, the srv1 ssh -L forward the
//   harness already dials, so the allocation and the harness cannot name two different tunnels;
// - the operator is gunbc.workspace_allocation_policy workspace_operator_principal.
//
// WHAT IS NOT YET READ, each standing in its own type rather than as a guessed value:
// - the contract terms (machine id, dph_total, rental start) are behind the Vast API key, which has no
//   custody here yet, so the contract is RentedContractUnread with that obligation;
// - srv1 reaches the card's sshd through Vast's gateway ssh7.vast.ai on port 15648, which passes through to
//   the instance's own sshd (public address 133.206.145.128). The declaration and the host key row carry
//   that SocketAddress (S2), so the row is pinned under [ssh7.vast.ai]:15648 exactly as srv1's known_hosts
//   holds it, and a leg dials the gateway port rather than 22;
// - the authorized key is srv1's host-held id_ed25519_gpu_pod (gap register G10), not an operator agent key.
//
// imported_at is the day this row was authored, at day grain: the import is this declaration, not an
// observed event with a finer instant.
data operator_pod_allocation_contract_obligation: NonEmptyStr = "Read Vast instance 55954143 (machine_id, dph_total, start_date) through the Vast API once its key has custody, and replace this standing with the RentedContractRead offer" as NonEmptyStr

data operator_pod_card_address: SocketAddress = socket_address(host: host_by_name(name: HostName { name: DomainName { labels: ["ssh7" as DnsLabel, "vast" as DnsLabel, "ai" as DnsLabel] }, qualification: PartiallyQualified }), port: 15648)

data operator_pod_card_host_key: KnownHostKeyRow = KnownHostKeyRow {
  host: "vast-55954143" as HostIdentity,
  address: operator_pod_card_address,
  key_type: "ssh-ed25519",
  public_key_base64: "AAAAC3NzaC1lZDI1NTE5AAAAIB0yPz+2aPqwpIrAxGB70Mb2+7cpVPZ+dlBtT9QS78bH",
  sha256_fingerprint: "SHA256:2CtTlTTdlb/nFoKqzSO3mNSc6KRU+qarCYGrYuU1yB0",
  provenance: ScannedFirstContact { scanned_from: "srv1 ssh first contact to [ssh7.vast.ai]:15648 (gateway to instance 55954143), 2026-10-14" as NonEmptyStr },
}

data operator_pod_allocation: RentedServingAllocation = RentedServingAllocation {
  identity: rented_allocation_identity(
    provider: decl_ref(module_path: "extdeps.cloud.vast_ai", decl_name: "extdeps_external_authority_anchor"),
    contract: "55954143" as NonEmptyStr,
  ),
  origin: RentedAllocationImported {
    imported_by: workspace_operator_principal(),
    imported_at: 1791936000000,
    found_running: decl_ref(module_path: "gunbc.harness.operator_pod_launch", decl_name: "operator_pod_ninfer_launch"),
  },
  contract: RentedContractUnread { obligation: operator_pod_allocation_contract_obligation },
  card: RentedGpuDevice { index: 0, model: "NVIDIA RTX PRO 6000 Blackwell Max-Q Workstation Edition" as NonEmptyStr, memory: byte_size(count: 102641958912) },
  end: RentedEndsOnOperatorRelease { decided_by: workspace_operator_principal() },
  engine: RentedNinferEngine { engine_release: ninfer_serve_81c8ce09_sm120_release, launch: operator_pod_ninfer_launch, listen_port: operator_pod_listen_port },
  artifact: qwen3_8_27b_nvfp4_row,
  host: RentedHostAccessDeclaration {
    node: "vast-55954143" as NonEmptyStr,
    address: operator_pod_card_address,
    principal: "root" as NonEmptyStr,
    host_key: operator_pod_card_host_key,
    operator_key: SshPublicKey { algorithm: Ed25519, material: "AAAAC3NzaC1lZDI1NTE5AAAAIAukWcfqhITs2EVxCXBGTcwKLTFHkzZePU5Yy3WFWSpY" as NonEmptyStr, comment: "srv1-gunbc-gpu-pod-tunnel" },
    operator_key_fingerprint: "SHA256:o0M7fTVtH/AlET5TrrzsMPXp2+Dp3KselRa1oWIvdRQ" as NonEmptyStr,
  },
  route: RentedSshLocalForward { forward_host: operator_host_srv1, forward: operator_endpoint_tunnel },
}

// CONSUMED BY S4, a declared frontier (DESIGN §3c). Today only its inhabitance claim reads this row
// (test.claim.serving.operator_pod_allocation_witness). The enroll-and-seat slice reads it through
// gunbc.serving.rented_allocation_roster rented_allocation_roster: it probes, enrolls and seats the card
// from the allocation and retires gunbc.harness.harness_operator_route. The row dissolves when that roster
// declaration appears.
data operator_pod_allocation_frontier_rows: List<FrontierRow> = [
  frontier_row_decl(
    ref: decl_ref(module_path: "gunbc.harness.operator_pod_allocation", decl_name: "operator_pod_allocation"),
    reason: "the imported card's allocation is read by its inhabitance claim until S4's rented_allocation_roster enrolls and seats it and retires harness_operator_route",
    dissolution: bound_dissolution(ref: decl_ref(module_path: "gunbc.serving.rented_allocation_roster", decl_name: "rented_allocation_roster")),
  )
]
