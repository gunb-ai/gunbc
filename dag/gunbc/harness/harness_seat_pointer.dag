module gunbc.harness.harness_seat_pointer

import std.types { String, NonEmptyStr }
import std.optional { Present, Absent }
import extdeps.languages.json.emit { JsonValue, JsonNull, JsonBool, JsonNumber, JsonString, JsonArray, JsonObject, json_kv, json_string, json_object, serialize_json }
import extdeps.languages.json.parse { JsonDocumentParsed, JsonDocumentUnreadable, JsonMemberFound, JsonMemberAbsent, JsonMemberDuplicated, JsonMemberNotAnObject, parse_json_document, json_object_unique_member }
import product.capacity.event_chain { PartitionId }

// THE SEAT A HARNESS PROCESS BOUND, NAMED BESIDE ITS EVENTS STREAM. The pointer carries identity
// only -- partition, the ledger reference, and the attempt identity the seat was minted for -- so
// the per-attempt metering (gunbc.roadmap_attempt_metering) can find this seat's grant and release
// on the ledger and refuse a pointer that belongs to another role or attempt; the instants stay the
// ledger's. It lives in a sibling file because harness_turn rewrites the events file from its own
// accumulator.
type HarnessSeatPointer {
  partition: PartitionId
  reference: NonEmptyStr
  owner: NonEmptyStr
}

fn harness_seat_pointer_path(events_path: String) -> String {
  join([events_path, ".seat.json"], "")
}

fn harness_seat_pointer_json(pointer: HarnessSeatPointer) -> String {
  serialize_json(v: json_object(members: [
    json_kv(key: "partition", value: json_string(s: pointer.partition as String)),
    json_kv(key: "reference", value: json_string(s: pointer.reference as String)),
    json_kv(key: "owner", value: json_string(s: pointer.owner as String)),
  ]))
}

type HarnessSeatPointerDecode
  = HarnessSeatPointerDecoded { pointer: HarnessSeatPointer }
  | HarnessSeatPointerUndecodable { cause: String }

fn harness_seat_pointer_member(doc: JsonValue, key: String) -> String? {
  match json_object_unique_member(v: doc, key: key) {
    JsonMemberFound { value: v } =>
      match v {
        JsonString { value: t } => if t == "" { none } else { Present { value: t } }
        JsonNull => none
        JsonBool { value: _ } => none
        JsonNumber { lexeme: _ } => none
        JsonArray { elements: _ } => none
        JsonObject { members: _ } => none
      }
    JsonMemberAbsent => none
    JsonMemberDuplicated { count: _ } => none
    JsonMemberNotAnObject => none
  }
}

fn harness_seat_pointer_decode(raw: String) -> HarnessSeatPointerDecode {
  match parse_json_document(s: raw) {
    JsonDocumentUnreadable { gap: _ } => HarnessSeatPointerUndecodable { cause: "the seat pointer is not a JSON document" }
    JsonDocumentParsed { value: doc } =>
      match harness_seat_pointer_member(doc: doc, key: "partition") {
        Absent => HarnessSeatPointerUndecodable { cause: "the seat pointer carries no single non-empty string 'partition'" }
        Present { value: p } =>
          match harness_seat_pointer_member(doc: doc, key: "reference") {
            Absent => HarnessSeatPointerUndecodable { cause: "the seat pointer carries no single non-empty string 'reference'" }
            Present { value: r } =>
              match harness_seat_pointer_member(doc: doc, key: "owner") {
                Absent => HarnessSeatPointerUndecodable { cause: "the seat pointer carries no single non-empty string 'owner'" }
                Present { value: o } =>
                  HarnessSeatPointerDecoded { pointer: HarnessSeatPointer { partition: p as NonEmptyStr as PartitionId, reference: r as NonEmptyStr, owner: o as NonEmptyStr } }
              }
          }
      }
  }
}


// THE REFERENCE NAMES ITS OWNER. gunbc.harness.harness_seat harness_seat_reference_wire renders a
// seat reference as `<len>:<attempt>@...`, so a pointer whose reference was not minted for its
// declared owner is detectable without the ledger.
fn harness_seat_pointer_reference_names_owner(pointer: HarnessSeatPointer) -> Bool {
  starts_with(s: pointer.reference as String, prefix: join([to_string(string_length(s: pointer.owner as String)), ":", pointer.owner as String, "@"], ""))
}
