module gunbc.harness.harness_shell_job

import std.types { String, Bool, Int, List, FilePath, NonEmptyStr, Timestamp }
import std.algebra { trim }
import extdeps.posix.process
import extdeps.posix.signal
import extdeps.tools.sleep
import extdeps.filesystem.filesystem_io
import extdeps.exec.command { ArgvCommand, argv_command, env_prefixed_command_in }
import extdeps.exec.program { uncataloged_program }
import extdeps.shell
import extdeps.clock { Clock }
import std.measure { Second, second, measure_le, measure_sub, MeasureDifference, MeasureSubtrahendExceedsMinuend }
import gunbc.harness.harness_shell_job_policy {
  ShellJobSchedule, schedule_seconds,
}

// A BACKGROUND JOB IS A RESOURCE OF THE ATTEMPT, not a second process roster. StartDetached
// already makes the child its own process group (POSIX_SPAWN_SETPGROUP 0), so the pid is the
// pgid. Manager B's AttemptResourceSet (#13929) is the attempt-owned hold set; this type is the
// shell-job inhabitant of that set.
//
// Discharge of leftover jobs at attempt end is the attempt unit's cgroup: systemd stops every
// process in the unit's control group when the unit ends. That is the authority; there is no
// second roster function here. Hand-in refuses while any job is still Running, because
// gunbc.plans.harness_session_lifecycle requires the candidate not be mutated while acceptance
// checks it.

type HarnessShellJobOutcome
  = JobExitedOutcome { code: Int }
  | JobSignaledOutcome { signal: Int }
  | JobReapRefusedOutcome { cause: NonEmptyStr }

type HarnessShellJobState
  = JobRunning
  | JobFinished { outcome: HarnessShellJobOutcome, elapsed: Second? }

type HarnessShellJob {
  id: String
  pid: Int
  command: String
  stdout_file: FilePath
  stderr_file: FilePath
  stdio_note: String
  started_at: Timestamp
  backstop: Second
  state: HarnessShellJobState
}

// GNU timeout exits 124 when it kills the child. A command may also exit 124 itself, so 124 is
// DurationExceeded only when elapsed time from started_at has reached this job's backstop.
// Elapsed unknown is not "not the backstop": it is a third standing, because guessing either
// DurationExceeded or ToolCompleted would fabricate the missing clock read. Whole-unix-second
// subtraction has the same hole one grain below the backstop: a real timeout kill can read as
// backstop minus that grain.
data harness_gnu_timeout_killed_exit: Int = 124

// Clock.Now is `date -u +%Y-%m-%dT%H:%M:%SZ`; TimestampToUnixSecs is `date +%s`. Both truncate
// to a POSIX second, so elapsed is quantized to this grain — not a policy slack, the clock's
// resolution cited from those transports in extdeps.clock.
data harness_elapsed_clock_resolution: Second = second(count: 1)

type HarnessBackstopUndecidedCause
  = ElapsedUnreadable
  | ElapsedWithinClockGrain

type HarnessJobBackstopStanding
  = JobBackstopHit
  | JobOwnExit
  | JobBackstopUndecided { cause: HarnessBackstopUndecidedCause }

fn harness_exit_is_harness_backstop(code: Int, elapsed: Second, backstop: Second) -> Bool {
  code == harness_gnu_timeout_killed_exit && measure_le(a: backstop, b: elapsed)
}

fn harness_elapsed_in_backstop_clock_grain(elapsed: Second, backstop: Second) -> Bool {
  match measure_sub(a: backstop, b: harness_elapsed_clock_resolution) {
    MeasureSubtrahendExceedsMinuend => false
    MeasureDifference { value: floor } =>
      measure_le(a: floor, b: elapsed) && !measure_le(a: backstop, b: elapsed)
  }
}

fn harness_elapsed_from_started_at(started_at: Timestamp) -> Second? {
  let now = Clock.Now()
  let start = Clock.TimestampToUnixSecs(timestamp: started_at)
  let end = Clock.TimestampToUnixSecs(timestamp: now.timestamp)
  match parse_int(s: trim(s: start.unix_secs)) {
    Absent => none
    Present { value: t0 } =>
      match parse_int(s: trim(s: end.unix_secs)) {
        Absent => none
        Present { value: t1 } =>
          if t1 < t0 {
            none
          } else {
            Present { value: second(count: t1 - t0) }
          }
      }
  }
}

fn harness_finish_job(job: HarnessShellJob, outcome: HarnessShellJobOutcome) -> HarnessShellJob {
  harness_job_with_state(
    job: job,
    state: JobFinished {
      outcome: outcome,
      elapsed: harness_elapsed_from_started_at(started_at: job.started_at),
    },
  )
}

fn harness_job_recorded_elapsed(job: HarnessShellJob) -> Second? {
  match job.state {
    JobRunning => none
    JobFinished { outcome: _, elapsed } => elapsed
  }
}

fn harness_backstop_standing(code: Int, elapsed: Second?, backstop: Second) -> HarnessJobBackstopStanding {
  match elapsed {
    Absent =>
      if code == harness_gnu_timeout_killed_exit {
        JobBackstopUndecided { cause: ElapsedUnreadable }
      } else {
        JobOwnExit
      }
    Present { value: observed } =>
      if harness_exit_is_harness_backstop(code: code, elapsed: observed, backstop: backstop) {
        JobBackstopHit
      } else if code == harness_gnu_timeout_killed_exit
        && harness_elapsed_in_backstop_clock_grain(elapsed: observed, backstop: backstop) {
        JobBackstopUndecided { cause: ElapsedWithinClockGrain }
      } else {
        JobOwnExit
      }
  }
}

fn harness_job_backstop_standing(job: HarnessShellJob, code: Int) -> HarnessJobBackstopStanding {
  harness_backstop_standing(
    code: code,
    elapsed: harness_job_recorded_elapsed(job: job),
    backstop: job.backstop,
  )
}

type HarnessShellJobObservation
  = JobStillRunning { job: HarnessShellJob }
  | JobExited { job: HarnessShellJob, code: Int }
  | JobSignaled { job: HarnessShellJob, signal: Int }
  | JobReapRefused { job: HarnessShellJob, cause: NonEmptyStr }

fn harness_job_with_state(job: HarnessShellJob, state: HarnessShellJobState) -> HarnessShellJob {
  HarnessShellJob {
    id: job.id,
    pid: job.pid,
    command: job.command,
    stdout_file: job.stdout_file,
    stderr_file: job.stderr_file,
    stdio_note: job.stdio_note,
    started_at: job.started_at,
    backstop: job.backstop,
    state: state,
  }
}

fn harness_refresh_job(job: HarnessShellJob) -> HarnessShellJob {
  match job.state {
    JobFinished { outcome: _, elapsed: _ } => job
    JobRunning =>
      match posix.Process.Reap(pid: job.pid).reaped {
        StillRunning => job
        Exited { code } =>
          harness_finish_job(job: job, outcome: JobExitedOutcome { code: code })
        Signaled { signal } =>
          harness_finish_job(job: job, outcome: JobSignaledOutcome { signal: signal })
        ReapRefused { cause } =>
          harness_finish_job(job: job, outcome: JobReapRefusedOutcome { cause: cause })
      }
  }
}

fn harness_refresh_jobs(jobs: List<HarnessShellJob>) -> List<HarnessShellJob> {
  map(jobs, j => harness_refresh_job(job: j))
}

fn harness_job_is_running(job: HarnessShellJob) -> Bool {
  match job.state {
    JobRunning => true
    JobFinished { outcome: _, elapsed: _ } => false
  }
}

fn harness_observe_standing(job: HarnessShellJob) -> HarnessShellJobObservation {
  match job.state {
    JobRunning => JobStillRunning { job: job }
    JobFinished { outcome, elapsed: _ } =>
      match outcome {
        JobExitedOutcome { code } => JobExited { job: job, code: code }
        JobSignaledOutcome { signal } => JobSignaled { job: job, signal: signal }
        JobReapRefusedOutcome { cause } => JobReapRefused { job: job, cause: cause }
      }
  }
}

fn harness_observe_job(job: HarnessShellJob) -> HarnessShellJobObservation {
  harness_observe_standing(job: harness_refresh_job(job: job))
}

fn harness_command_table_exit_label(
  job: HarnessShellJob,
  code: Int,
  standing: HarnessJobBackstopStanding,
) -> String {
  match standing {
    JobBackstopHit =>
      join(["  ", job.id, "  duration exceeded  $ ", job.command], "")
    JobOwnExit =>
      join(["  ", job.id, "  exit ", to_string(value: code), "  $ ", job.command], "")
    JobBackstopUndecided { cause: _ } =>
      join([
        "  ", job.id, "  exit ", to_string(value: code),
        ", backstop undecided  $ ", job.command,
      ], "")
  }
}

fn harness_command_table_line(obs: HarnessShellJobObservation) -> String {
  match obs {
    JobStillRunning { job } =>
      join(["  ", job.id, "  running  $ ", job.command], "")
    JobExited { job, code } =>
      harness_command_table_exit_label(
        job: job,
        code: code,
        standing: harness_job_backstop_standing(job: job, code: code),
      )
    JobSignaled { job, signal } =>
      join(["  ", job.id, "  signaled ", to_string(value: signal), "  $ ", job.command], "")
    JobReapRefused { job, cause } =>
      join(["  ", job.id, "  reap refused: ", cause as String, "  $ ", job.command], "")
  }
}

fn harness_command_table(jobs: List<HarnessShellJob>) -> String {
  if list_length(items: jobs) == 0 {
    "COMMAND TABLE: (no jobs)"
  } else {
    join(
      concat(
        ["COMMAND TABLE:"],
        map(jobs, j => harness_command_table_line(obs: harness_observe_standing(job: j))),
      ),
      "\n",
    )
  }
}

type HarnessJobText
  = JobTextRead { text: String }
  | JobTextUnreadable { path: String, cause: String }

fn harness_read_job_text(job: HarnessShellJob) -> HarnessJobText {
  let out = Filesystem.Read(path: job.stdout_file as String)
  let err = Filesystem.Read(path: job.stderr_file as String)
  if !out.success {
    JobTextUnreadable { path: job.stdout_file as String, cause: out.error }
  } else if !err.success {
    JobTextUnreadable { path: job.stderr_file as String, cause: err.error }
  } else {
    JobTextRead { text: join([out.content, err.content], "") }
  }
}

fn harness_kept_stdio_path(pending: FilePath, dest: FilePath, moved: Bool) -> FilePath {
  if moved {
    dest
  } else {
    pending
  }
}

fn harness_stdio_move_note(
  moved_out: Bool,
  moved_err: Bool,
  pending_out: FilePath,
  pending_err: FilePath,
) -> String {
  if moved_out && moved_err {
    ""
  } else {
    join([
      "job output kept at the mktemp paths that hold the live fds",
      if !moved_out { join([" (stdout: ", pending_out as String, ")"], "") } else { "" },
      if !moved_err { join([" (stderr: ", pending_err as String, ")"], "") } else { "" },
    ], "")
  }
}

fn harness_await_pid(pid: Int, remaining: Second) -> ProcessReapOutcome {
  let reaped = posix.Process.Reap(pid: pid)
  match reaped.reaped {
    StillRunning =>
      if measure_le(a: remaining, b: second(count: 0)) {
        StillRunning
      } else {
        let _pause = sleep.Delay.Seconds(seconds: "1" as NonEmptyStr)
        match measure_sub(a: remaining, b: second(count: 1)) {
          MeasureDifference { value: next } => harness_await_pid(pid: pid, remaining: next)
          MeasureSubtrahendExceedsMinuend => StillRunning
        }
      }
    Exited { code } => Exited { code: code }
    Signaled { signal } => Signaled { signal: signal }
    ReapRefused { cause } => ReapRefused { cause: cause }
  }
}

fn harness_replace_job(jobs: List<HarnessShellJob>, job: HarnessShellJob) -> List<HarnessShellJob> {
  concat(filter(jobs, j => !(j.id == job.id)), [job])
}

fn harness_find_job(jobs: List<HarnessShellJob>, id: String) -> HarnessShellJob? {
  fold(jobs, init: none, f: (acc, j) =>
    if j.id == id {
      Present { value: j }
    } else {
      acc
    })
}

fn harness_first_running_now_finished(before: List<HarnessShellJob>, after: List<HarnessShellJob>) -> HarnessShellJobObservation? {
  fold(after, init: none, f: (acc, j) =>
    match acc {
      Present { value: _ } => acc
      Absent =>
        match harness_find_job(jobs: before, id: j.id) {
          Absent => none
          Present { value: prior } =>
            if harness_job_is_running(job: prior) && !harness_job_is_running(job: j) {
              Present { value: harness_observe_standing(job: j) }
            } else {
              none
            }
        }
    })
}

type HarnessWaitLoop
  = WaitLoopFinished { jobs: List<HarnessShellJob>, observation: HarnessShellJobObservation }
  | WaitLoopExpired { jobs: List<HarnessShellJob> }
  | WaitLoopNoRunningJob { jobs: List<HarnessShellJob> }

fn harness_wait_until_any(jobs: List<HarnessShellJob>, remaining: Second) -> HarnessWaitLoop {
  let stamped = harness_refresh_jobs(jobs: jobs)
  match harness_first_running_now_finished(before: jobs, after: stamped) {
    Present { value: obs } => WaitLoopFinished { jobs: stamped, observation: obs }
    Absent =>
      if list_length(items: filter(stamped, j => harness_job_is_running(job: j))) == 0 {
        WaitLoopNoRunningJob { jobs: stamped }
      } else if measure_le(a: remaining, b: second(count: 0)) {
        WaitLoopExpired { jobs: stamped }
      } else {
        let _pause = sleep.Delay.Seconds(seconds: "1" as NonEmptyStr)
        match measure_sub(a: remaining, b: second(count: 1)) {
          MeasureDifference { value: next } => harness_wait_until_any(jobs: stamped, remaining: next)
          MeasureSubtrahendExceedsMinuend => WaitLoopExpired { jobs: stamped }
        }
      }
  }
}

fn harness_job_stdio_path(output_dir: FilePath, pid: Int, suffix: String) -> FilePath {
  join([output_dir as String, "/job-", to_string(value: pid), suffix], "") as FilePath
}

fn harness_backstopped_shell_command(
  timeout_program: FilePath,
  backstop_seconds: Int,
  command: String,
) -> ArgvCommand
{
  argv_command(
    program: uncataloged_program(invocation: timeout_program as NonEmptyStr),
    arguments: [to_string(value: backstop_seconds), "/bin/sh", "-c", command],
  )
}

type HarnessShellSpawn
  = ShellSpawned { job: HarnessShellJob }
  | ShellSpawnFailed { program: NonEmptyStr, cause: NonEmptyStr }

fn harness_start_shell_job(
  worktree: FilePath,
  job_output_directory: FilePath,
  timeout_program: FilePath,
  command: String,
  schedule: ShellJobSchedule,
) -> HarnessShellSpawn {
  let pending_out = shell.Mktemp.FileInDirectory(dir: job_output_directory)
  let pending_err = shell.Mktemp.FileInDirectory(dir: job_output_directory)
  if !(pending_out.success && pending_err.success) {
    ShellSpawnFailed {
      program: timeout_program as NonEmptyStr,
      cause: "could not create job output files in the attempt-state directory" as NonEmptyStr,
    }
  } else {
    let inner = harness_backstopped_shell_command(
      timeout_program: timeout_program,
      backstop_seconds: schedule_seconds(s: schedule.backstop),
      command: command,
    )
    let wrapped = env_prefixed_command_in(
      directory: worktree as String,
      bindings: [],
      command: inner,
    )
    // Stamp before StartDetached: GNU timeout starts its clock at or after that instant, so
    // elapsed from this stamp is an upper bound on timeout's own count. Stamping after spawn
    // and the stdio moves biased elapsed low.
    let started_at = Clock.Now().timestamp
    let spawn = posix.Process.StartDetached(
      program: wrapped.program.invocation,
      arguments: wrapped.arguments,
      stdout_file: pending_out.path as String as NonEmptyStr,
      stderr_file: pending_err.path as String as NonEmptyStr,
    )
    match spawn.spawn {
      SpawnRefused { program, cause } => ShellSpawnFailed { program: program, cause: cause }
      Spawned { pid } => {
        let dest_out = harness_job_stdio_path(output_dir: job_output_directory, pid: pid, suffix: ".out")
        let dest_err = harness_job_stdio_path(output_dir: job_output_directory, pid: pid, suffix: ".err")
        let moved_out = shell.Move.File(source: pending_out.path, destination: dest_out)
        let moved_err = shell.Move.File(source: pending_err.path, destination: dest_err)
        ShellSpawned {
          job: HarnessShellJob {
            id: to_string(value: pid),
            pid: pid,
            command: command,
            stdout_file: harness_kept_stdio_path(
              pending: pending_out.path,
              dest: dest_out,
              moved: moved_out.success,
            ),
            stderr_file: harness_kept_stdio_path(
              pending: pending_err.path,
              dest: dest_err,
              moved: moved_err.success,
            ),
            stdio_note: harness_stdio_move_note(
              moved_out: moved_out.success,
              moved_err: moved_err.success,
              pending_out: pending_out.path,
              pending_err: pending_err.path,
            ),
            started_at: started_at,
            backstop: schedule.backstop,
            state: JobRunning,
          },
        }
      }
    }
  }
}

type HarnessTerminateProcessGroup {
  success: Bool
  stderr: String
}

fn harness_kill_process_group(pid: Int) -> HarnessTerminateProcessGroup {
  let r = posix.Signal.TerminateProcessGroup(pgid: to_string(value: pid) as NonEmptyStr)
  HarnessTerminateProcessGroup { success: r.success, stderr: r.stderr }
}

fn harness_kill_signal_note(signaled: HarnessTerminateProcessGroup) -> String {
  if signaled.success {
    ""
  } else {
    join([" TerminateProcessGroup failed: ", signaled.stderr], "")
  }
}

type HarnessJobKill
  = JobKillConfirmed { job: HarnessShellJob }
  | JobKillUnconfirmed { job: HarnessShellJob, detail: String }

fn harness_kill_running_job(job: HarnessShellJob) -> HarnessJobKill {
  let signaled = harness_kill_process_group(pid: job.pid)
  match harness_await_pid(pid: job.pid, remaining: second(count: 5)) {
    Exited { code } =>
      JobKillConfirmed {
        job: harness_finish_job(job: job, outcome: JobExitedOutcome { code: code }),
      }
    Signaled { signal } =>
      JobKillConfirmed {
        job: harness_finish_job(job: job, outcome: JobSignaledOutcome { signal: signal }),
      }
    StillRunning =>
      JobKillUnconfirmed {
        job: job,
        detail: join(
          [
            "job ",
            job.id,
            " is still running after TerminateProcessGroup",
            harness_kill_signal_note(signaled: signaled),
          ],
          "",
        ),
      }
    ReapRefused { cause } =>
      JobKillUnconfirmed {
        job: job,
        detail: join(
          [
            "job ",
            job.id,
            " reap refused after TerminateProcessGroup: ",
            cause as String,
            harness_kill_signal_note(signaled: signaled),
          ],
          "",
        ),
      }
  }
}

fn harness_hand_in_blocked_by_running_jobs(jobs: List<HarnessShellJob>) -> String? {
  if list_length(items: filter(jobs, j => harness_job_is_running(job: j))) == 0 {
    none
  } else {
    Present {
      value: "hand_in refused: a shell job is still running; wait or job_kill first so the candidate is not mutated while acceptance checks it",
    }
  }
}
