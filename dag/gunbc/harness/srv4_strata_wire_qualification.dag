module gunbc.harness.srv4_strata_wire_qualification

import std.types { NonEmptyStr, List }
import std.nat { Nat }
import std.decl_ref { decl_ref }
import extdeps.external_authority { CitedFigure, CitedFigureStanding, ObservedByReceipt, observed_receipt }

// THE OBSERVING LAYER'S RECEIPT for the srv4 daily Strata engine (DESIGN 3: an observation is a receipt downstream,
// never a property inside extdeps.strata.strata_server). Session eager-lynx-183 ran the live wire qualification on
// 2026-10-28 at 02:30 UTC against the deployed engine; the raw credential-free requests and responses are kept on
// srv4 under record_directory. Re-qualified on the swapped engine (checkpoint build: native 406c9de18cef, upstream
// layer-split persistence; Python frontend unchanged), whose one-slot admission receipt is under checkpoint-qualification/wire.
// The binary digest is the post-swap executable recorded in that swap's receipt (private#249,
// docs/strategy/2026-10-28-srv4-checkpoint/receipt.json); ca210071 was the pre-swap build.
// The served Python frontend is upstream 8183c6b6 plus one pinned local patch (request-bound save, gunbc#15344
// commit 2c77e18a700, dag/extdeps/strata/patches/request-bound-save-8183c6b6.patch); 8c5fafc1, recorded here
// before, is an ARM patch commit, not what srv4 serves. The patch edits no qualified reasoning, effort, admission
// or context behaviour (eager-lynx-183's provenance check, 2026-10-29).
type Srv4StrataWireQualification {
  engine_source_commit: NonEmptyStr
  engine_source_patch_sha256: NonEmptyStr
  served_frontend_sha256: NonEmptyStr
  engine_native_commit: NonEmptyStr
  engine_binary_sha256: NonEmptyStr
  record_directory: NonEmptyStr
  // Every value of the top-level reasoning_effort member the engine accepted; an unknown word answered 400.
  accepted_reasoning_efforts: List<NonEmptyStr>
  // "none" disables thinking (effort_kwargs maps it to enable_thinking=False): the tool-none reply had no reasoning.
  reasoning_off_effort: NonEmptyStr
  // A thinking reply carries reasoning in this assistant member, content null, and structured tool_calls
  // (type function, id, function.name, function.arguments as a JSON string); no think block reaches content.
  message_reasoning_field: NonEmptyStr
  // max_tokens 1000000 with a 16-token prompt was clamped to 229352 (229376 - 8 - 16): the window bounds output,
  // and there is no separate fixed output cap.
  max_context_tokens: Nat
  // One request processed, a concurrent second answered 429, both slots idle again after (no leaked capacity).
  active_turns: Nat
}

data srv4_strata_wire_qualification_receipt: Srv4StrataWireQualification = Srv4StrataWireQualification {
  engine_source_commit: "8183c6b67162340c09b67360860177c577a65f2e" as NonEmptyStr,
  engine_source_patch_sha256: "56f20cb522f1534bc30f170febbd9b61d0ef7ae60242495acd98a090d1c12287" as NonEmptyStr,
  served_frontend_sha256: "c387b3bcda8df95e5341af9ed57c698dd6d307740d45db9b3b18e8fc9bad3673" as NonEmptyStr,
  engine_native_commit: "406c9de18cef885946be0e42a3b01c46531272ac" as NonEmptyStr,
  engine_binary_sha256: "1af9a21ce77d9d2377843b6a1eacf19bef5f645dc685d40cbc38364b18828af2" as NonEmptyStr,
  record_directory: "/opt/gunbc-serving/srv4-daily/state/checkpoint-qualification" as NonEmptyStr,
  accepted_reasoning_efforts: [
    "none" as NonEmptyStr, "off" as NonEmptyStr, "minimal" as NonEmptyStr, "disabled" as NonEmptyStr, "false" as NonEmptyStr,
    "low" as NonEmptyStr, "medium" as NonEmptyStr, "high" as NonEmptyStr, "xhigh" as NonEmptyStr, "max" as NonEmptyStr, "maximum" as NonEmptyStr,
  ],
  reasoning_off_effort: "none" as NonEmptyStr,
  message_reasoning_field: "reasoning_content" as NonEmptyStr,
  max_context_tokens: 229376,
  active_turns: 1,
}

fn srv4_strata_wire_qualification_ground() -> CitedFigureStanding {
  ObservedByReceipt {
    observed: observed_receipt(receipt: decl_ref(
      module_path: "gunbc.harness.srv4_strata_wire_qualification",
      decl_name: "srv4_strata_wire_qualification_receipt",
    ))
  }
}

// The receipt's readings as figures that stand on it. The harness reads these, not the engine operator's
// statement in extdeps.strata.strata_server, which stays a transcription.
fn srv4_strata_observed_reasoning_field() -> CitedFigure<NonEmptyStr> {
  CitedFigure { value: srv4_strata_wire_qualification_receipt.message_reasoning_field, standing: srv4_strata_wire_qualification_ground() }
}

fn srv4_strata_observed_active_turns() -> CitedFigure<Nat> {
  CitedFigure { value: srv4_strata_wire_qualification_receipt.active_turns, standing: srv4_strata_wire_qualification_ground() }
}

fn srv4_strata_observed_max_context_tokens() -> CitedFigure<Nat> {
  CitedFigure { value: srv4_strata_wire_qualification_receipt.max_context_tokens, standing: srv4_strata_wire_qualification_ground() }
}
