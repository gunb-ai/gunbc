module gunbc.harness.harness_throughput

import std.types { String, Bool, Int, List, NonEmptyStr }
import std.algebra { trim }
import extdeps.languages.json.emit { JsonValue, JsonNumber, JsonString }
import extdeps.languages.json.parse {
  JsonDocumentParse, JsonDocumentParsed, JsonDocumentUnreadable,
  JsonMemberFound,
  parse_json_document, json_object_unique_member,
}

// READING THE ROUND.USAGE STREAM THE HARNESS WRITES. This module sits beside the writer rather than
// beside the dashboard that renders it, because the events file's shape is the harness's fact: the
// module that emits round.usage owns the module that decodes it, and a decoder living next to a
// consumer would be a second authority on a format it does not define.
//
// WHY A RATE IS DERIVED AND NEVER STORED. The observation carries tokens, an interval and a round
// count; tokens-per-second is a function of those three. Storing it alongside would be a second
// representation of one fact, free to disagree with its own inputs after any edit.

type HarnessThroughput
  = ThroughputObserved { output_tokens: Int, elapsed_ms: Int, rounds: Int }
  | ThroughputUnobserved { reason: NonEmptyStr }

// ONE ROUND AS OBSERVED, NOT AS SUMMARISED. The strip on the dashboard and the throughput cell are
// two projections of the same rows, so the rows are carried once and both are derived -- carrying
// a rate beside the rounds it is computed from would be two representations of one fact.
// files_changed is optional because the harness that wrote older streams did not observe it; an
// absent count is "not measured", which must stay distinct from "measured zero", since the strip
// paints a write round differently from a read round and must never paint an unmeasured one as
// either.
type RoundObservation {
  step: Int
  input_tokens: Int
  output_tokens: Int
  epoch_ms: Int
  files_changed: Int?
  tool_calls: Int?
}

type HarnessRoundLedger
  = RoundsObserved { rounds: List<RoundObservation> }
  | RoundsUnobserved { reason: NonEmptyStr }

// THE FIRST ROUND'S TOKENS ARE EXCLUDED FROM THE NUMERATOR ON PURPOSE, and the reason is that they
// were produced BEFORE the first timestamp exists. A usage row is written when a response has
// already arrived, so the earliest clock reading marks the END of round 1's generation, not its
// start. Dividing every round's tokens by the interval between the first and last readings would
// credit round 1's output to a window it did not run in and overstate the rate by exactly that
// round -- worst at the small round counts where the dashboard is most often read. The honest
// measure over the same rows is the tokens produced BETWEEN two readings, which is rounds 2..N.
type ThroughputAccumulator {
  rounds: Int
  later_tokens: Int
  first_ms: Int
  last_ms: Int
  clocked: Int
}

fn throughput_member_int(doc: JsonValue, key: String) -> Int? {
  match json_object_unique_member(v: doc, key: key) {
    JsonMemberFound { value: v } =>
      match v {
        JsonNumber { lexeme: lex } => parse_int(s: lex as String)
        _ => none
      }
    _ => none
  }
}

fn throughput_is_usage_row(doc: JsonValue) -> Bool {
  match json_object_unique_member(v: doc, key: "type") {
    JsonMemberFound { value: v } =>
      match v {
        JsonString { value: s } => s == "round.usage"
        _ => false
      }
    _ => false
  }
}

fn throughput_absorb_row(acc: ThroughputAccumulator, doc: JsonValue) -> ThroughputAccumulator {
  match throughput_member_int(doc: doc, key: "epoch_ms") {
    Absent => acc
    Present { value: ms } => {
      let toks = match throughput_member_int(doc: doc, key: "output_tokens") {
        Present { value: t } => t
        Absent => 0
      }
      ThroughputAccumulator {
        rounds: acc.rounds + 1,
        later_tokens: if acc.clocked == 0 { 0 } else { acc.later_tokens + toks },
        first_ms: if acc.clocked == 0 { ms } else { acc.first_ms },
        last_ms: ms,
        clocked: acc.clocked + 1,
      }
    }
  }
}

fn throughput_absorb_line(acc: ThroughputAccumulator, line: String) -> ThroughputAccumulator {
  if trim(line) == "" {
    acc
  } else {
    match parse_json_document(s: line) {
      JsonDocumentUnreadable { gap: _ } => acc
      JsonDocumentParsed { value: doc } =>
        if throughput_is_usage_row(doc: doc) {
          throughput_absorb_row(acc: acc, doc: doc)
        } else {
          acc
        }
    }
  }
}

// THE REFUSAL ARMS ARE SEPARATE BECAUSE THEIR REMEDIES DIFFER. No usage rows at all means the run
// predates this stream or never reached a response; rows present but unclocked means the host clock
// refused and the fix is on the host; a single clocked row means the turn is still in its first
// round and an interval does not exist yet. Collapsing these into one "unknown" would hand the
// reader one symbol for three different situations.
fn harness_throughput_from_events(body: String) -> HarnessThroughput {
  let acc = fold(
    split(s: body, delimiter: "\n"),
    init: ThroughputAccumulator { rounds: 0, later_tokens: 0, first_ms: 0, last_ms: 0, clocked: 0 },
    f: (a, line) => throughput_absorb_line(acc: a, line: line),
  )
  if acc.clocked == 0 {
    ThroughputUnobserved {
      reason: "no clocked round.usage row in the event stream" as NonEmptyStr,
    }
  } else if acc.clocked < 2 {
    ThroughputUnobserved {
      reason: "one clocked round so far; an interval needs two" as NonEmptyStr,
    }
  } else if acc.last_ms <= acc.first_ms {
    ThroughputUnobserved {
      reason: "clock did not advance between the first and last round" as NonEmptyStr,
    }
  } else {
    ThroughputObserved {
      output_tokens: acc.later_tokens,
      elapsed_ms: acc.last_ms - acc.first_ms,
      rounds: acc.rounds,
    }
  }
}


fn round_observation_of(doc: JsonValue) -> RoundObservation? {
  match throughput_member_int(doc: doc, key: "epoch_ms") {
    Absent => none
    Present { value: ms } =>
      Present { value: RoundObservation {
        step: match throughput_member_int(doc: doc, key: "step") { Present { value: n } => n  Absent => 0 },
        input_tokens: match throughput_member_int(doc: doc, key: "input_tokens") { Present { value: n } => n  Absent => 0 },
        output_tokens: match throughput_member_int(doc: doc, key: "output_tokens") { Present { value: n } => n  Absent => 0 },
        epoch_ms: ms,
        files_changed: throughput_member_int(doc: doc, key: "files_changed"),
        tool_calls: throughput_member_int(doc: doc, key: "tool_calls"),
      } }
  }
}

fn ledger_absorb_line(acc: List<RoundObservation>, line: String) -> List<RoundObservation> {
  if trim(line) == "" {
    acc
  } else {
    match parse_json_document(s: line) {
      JsonDocumentUnreadable { gap: _ } => acc
      JsonDocumentParsed { value: doc } =>
        if throughput_is_usage_row(doc: doc) {
          match round_observation_of(doc: doc) {
            Present { value: r } => concat(acc, [r])
            Absent => acc
          }
        } else {
          acc
        }
    }
  }
}

fn harness_round_ledger_from_events(body: String) -> HarnessRoundLedger {
  let rounds = fold(split(s: body, delimiter: "\n"), init: [], f: (a, line) => ledger_absorb_line(acc: a, line: line))
  if list_length(items: rounds) == 0 {
    RoundsUnobserved { reason: "no clocked round.usage row in the event stream" as NonEmptyStr }
  } else {
    RoundsObserved { rounds: rounds }
  }
}

// THE RATE IS A FOLD OVER THE LEDGER. This is the same derivation the accumulator below performs
// over the raw stream, re-based on the decoded rows so the two cannot disagree; the stream-based
// form is kept as the entry point existing witnesses pin.
fn harness_throughput_from_ledger(ledger: HarnessRoundLedger) -> HarnessThroughput {
  match ledger {
    RoundsUnobserved { reason: r } => ThroughputUnobserved { reason: r }
    RoundsObserved { rounds: rs } =>
      if list_length(items: rs) < 2 {
        ThroughputUnobserved { reason: "one clocked round so far; an interval needs two" as NonEmptyStr }
      } else {
        let first = rs.first()
        let last = rs.last()
        match first {
          Absent => ThroughputUnobserved { reason: "ledger reported rounds but yielded none" as NonEmptyStr }
          Present { value: f } =>
            match last {
              Absent => ThroughputUnobserved { reason: "ledger reported rounds but yielded none" as NonEmptyStr }
              Present { value: l } =>
                if l.epoch_ms <= f.epoch_ms {
                  ThroughputUnobserved { reason: "clock did not advance between the first and last round" as NonEmptyStr }
                } else {
                  ThroughputObserved {
                    output_tokens: fold(rs.skip(n: 1), init: 0, f: (a, r) => a + r.output_tokens),
                    elapsed_ms: l.epoch_ms - f.epoch_ms,
                    rounds: list_length(items: rs),
                  }
                }
            }
        }
      }
  }
}


// ONE PAINTED SEGMENT OF THE ROUND STRIP, DERIVED HERE AND ONLY PAINTED BY THE PAGE. The strip is
// time-proportional: a segment's width is the wall interval that ended at its round, so a long
// round is a wide segment rather than one averaged away. The first clocked round is the strip's
// origin and has no interval of its own -- its timestamp marks the END of its generation, exactly
// as the throughput fold treats it -- so a ledger of N rounds paints N-1 segments, rounds 2..N.
//
// KIND IS A DELTA, NOT A LEVEL. files_changed is the worktree's cumulative changed-path count when
// the round's tools finished, so a round WROTE when that count rose over the previous measured
// value. A level test would paint every round after the first write as a write.
//
// A ROUND WITH NO TOOL CALL IS ITS OWN KIND. The harness counts the model's tool_use blocks per round
// (tool_calls); zero means the round was spent on reasoning or prose alone, which is neither a read
// nor a write of the tree. Older ledgers carry no count, and a round without one is classified by
// its file delta as before -- the absent count widens nothing, it only withholds the finer kind.
type RoundSegmentKind = ReadRound | WriteRound | ReasonRound | UnmeasuredRound

type RoundSegment {
  step: Int
  duration_ms: Int
  output_tokens: Int
  kind: RoundSegmentKind
}

type SegmentFold {
  previous: RoundObservation?
  last_measured: Int?
  segments: List<RoundSegment>
}

fn round_segment_kind(now: Int?, last_measured: Int?, tool_calls: Int?) -> RoundSegmentKind {
  match now {
    Absent => UnmeasuredRound
    Present { value: n } =>
      match last_measured {
        Absent => if n > 0 { WriteRound } else { round_segment_kind_unwritten(tool_calls: tool_calls) }
        Present { value: m } => if n > m { WriteRound } else { round_segment_kind_unwritten(tool_calls: tool_calls) }
      }
  }
}

fn round_segment_kind_unwritten(tool_calls: Int?) -> RoundSegmentKind {
  match tool_calls {
    Absent => ReadRound
    Present { value: n } => if n == 0 { ReasonRound } else { ReadRound }
  }
}

fn segment_fold_step(acc: SegmentFold, r: RoundObservation) -> SegmentFold {
  match acc.previous {
    Absent =>
      SegmentFold { previous: Present { value: r }, last_measured: r.files_changed, segments: acc.segments }
    Present { value: p } =>
      SegmentFold {
        previous: Present { value: r },
        last_measured: match r.files_changed { Present { value: n } => Present { value: n }  Absent => acc.last_measured },
        segments: concat(acc.segments, [RoundSegment {
          step: r.step,
          duration_ms: r.epoch_ms - p.epoch_ms,
          output_tokens: r.output_tokens,
          kind: round_segment_kind(now: r.files_changed, last_measured: acc.last_measured, tool_calls: r.tool_calls),
        }]),
      }
  }
}

// THE WORKER'S STEP BUDGET IS THE STRIP'S TRACK. A live attempt occupies the share of the track its
// completed rounds have spent and leaves the rest empty; the empty remainder is projected at the
// mean pace so far, so a slow run shows as a long unspent tail and the track is full only when the
// budget is spent or the attempt ends. The CLI reads this row for its own budget, one authority.
data harness_round_budget_steps: Int = 40

fn round_remaining_flex(ledger: HarnessRoundLedger, budget_steps: Int) -> Int {
  match ledger {
    RoundsUnobserved { reason: _ } => 0
    RoundsObserved { rounds } => {
      let segs = round_segments(ledger: ledger)
      let n = list_length(items: segs)
      let spent_rounds = list_length(items: rounds)
      let remaining_rounds = if spent_rounds >= budget_steps { 0 } else { budget_steps - spent_rounds }
      if n == 0 || remaining_rounds == 0 {
        0
      } else {
        let total = fold(segs, init: 0, f: (acc, s) => acc + s.duration_ms)
        let mean = if total / n < 1 { 1 } else { total / n }
        remaining_rounds * mean
      }
    }
  }
}

type RoundPlayback {
  segment: RoundSegment
  delay_ms: Int
  duration_ms: Int
}

type PlaybackFold {
  elapsed: Int
  out: List<RoundPlayback>
}

data round_playback_floor_ms: Int = 120

fn round_playback_total(segs: List<RoundSegment>) -> Int {
  let total = fold(segs, init: 0, f: (acc, s) => acc + s.duration_ms)
  if total < 1 { 1 } else { total }
}

fn round_playback_step(acc: PlaybackFold, seg: RoundSegment, total: Int, playback_ms: Int) -> PlaybackFold {
  let scaled = seg.duration_ms * playback_ms / total
  let shown = if scaled < round_playback_floor_ms { round_playback_floor_ms } else { scaled }
  PlaybackFold {
    elapsed: acc.elapsed + seg.duration_ms,
    out: concat(acc.out, [ RoundPlayback { segment: seg, delay_ms: acc.elapsed * playback_ms / total, duration_ms: shown } ]),
  }
}

fn round_playback(segs: List<RoundSegment>, playback_ms: Int) -> List<RoundPlayback> {
  let total = round_playback_total(segs: segs)
  (fold(segs, init: PlaybackFold { elapsed: 0, out: [] }, f: (a, s) => round_playback_step(acc: a, seg: s, total: total, playback_ms: playback_ms))).out
}

fn round_segments(ledger: HarnessRoundLedger) -> List<RoundSegment> {
  match ledger {
    RoundsUnobserved { reason: _ } => []
    RoundsObserved { rounds: rs } =>
      (fold(rs, init: SegmentFold { previous: none, last_measured: none, segments: [] },
            f: (a, r) => segment_fold_step(acc: a, r: r))).segments
  }
}

fn round_segment_kind_word(k: RoundSegmentKind) -> String {
  match k {
    ReadRound => "read"
    WriteRound => "write"
    ReasonRound => "reasoning"
    UnmeasuredRound => "unmeasured"
  }
}

// Hundredths of a token per second, so the rate is an exact Int ratio rather than a rounded one.
fn throughput_centi_tokens_per_second(t: HarnessThroughput) -> Int? {
  match t {
    ThroughputUnobserved { reason: _ } => none
    ThroughputObserved { output_tokens: toks, elapsed_ms: ms, rounds: _ } =>
      if ms <= 0 { none } else { Present { value: (toks * 100000) / ms } }
  }
}

fn throughput_rate_text(t: HarnessThroughput) -> String {
  match throughput_centi_tokens_per_second(t: t) {
    Absent => "-- tok/s"
    Present { value: centi } => {
      let whole = centi / 100
      let frac = centi - (whole * 100)
      join([
        to_string(value: whole), ".",
        if frac < 10 { join(["0", to_string(value: frac)], "") } else { to_string(value: frac) },
        " tok/s",
      ], "")
    }
  }
}

// A BAND IS A CONCEPT, THE GLYPH IS ITS PRESENTATION, and they are two functions because they are
// two facts. A single fn returning "turtle" would make the SYMBOL the carrier of the distinction --
// a renderer wanting different glyphs, or a text log wanting words, would have to match on
// presentation strings and would silently break when one is retitled.
type ThroughputBand = Crawling | Walking | Running | Sprinting

// THE BOUNDARIES ARE A DECLARED POLICY OVER MEASURED RATES, NOT A GUESS, and they are stated here
// so the number behind each symbol is auditable. They come from this deployment's own runs of
// deepseek-v4-flash:iq3s-split: a contended run measured 0.60 tok/s end to end, an uncontended
// 24-round run measured 4.22, a 9-round run measured 8.72, and the fastest individual rounds
// observed reached 16.59. The boundaries sit BETWEEN those clusters rather than inside any of them.
// They describe THIS backend on THIS hardware and are expected to move when either changes -- which
// is why they are one row to edit rather than a threshold buried in a renderer.
fn throughput_band_of_centi(centi: Int) -> ThroughputBand {
  if centi < 100 {
    Crawling
  } else if centi < 500 {
    Walking
  } else if centi < 1500 {
    Running
  } else {
    Sprinting
  }
}

fn throughput_band(t: HarnessThroughput) -> ThroughputBand? {
  match throughput_centi_tokens_per_second(t: t) {
    Absent => none
    Present { value: centi } => Present { value: throughput_band_of_centi(centi: centi) }
  }
}

fn throughput_band_glyph(band: ThroughputBand) -> String {
  match band {
    Crawling => "🐢"
    Walking => "🚶"
    Running => "🏃"
    Sprinting => "⚡"
  }
}

fn throughput_band_word(band: ThroughputBand) -> String {
  match band {
    Crawling => "crawling"
    Walking => "walking"
    Running => "running"
    Sprinting => "sprinting"
  }
}

// WHAT A DASHBOARD CELL SHOWS. An unmeasured rate renders as the refusal's own mark, never as a
// zero and never as a fast glyph -- "not yet measurable" and "measured at zero" are different
// claims and only one of them is ever true here.
fn throughput_cell_text(t: HarnessThroughput) -> String {
  match throughput_band(t: t) {
    Absent => "unmeasured"
    Present { value: b } =>
      join([throughput_band_glyph(band: b), " ", throughput_rate_text(t: t)], "")
  }
}
