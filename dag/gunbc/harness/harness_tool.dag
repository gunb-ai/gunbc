// THE HARNESS TOOL SURFACE, and the rule every disposition below is one instance of:
// A TOOL'S CONTRACT IS CARRIED IN ITS DECLARED SHAPE, AND ANY LIMIT IT ENFORCES IS REPORTED IN ITS
// RESULT RATHER THAN INFERRED FROM A TRUNCATED OR MISSING ONE.
//
// That rule is not a preference. Every quirk in the relayed harness transcript DCH reviewed was a
// real semantic of this surface that nothing announced -- a caller that complied with an
// undocumented working-directory convention by luck, a build killed by a chat-shaped timeout that
// arrived looking like the build's own failure, a prompt-shaped hang that presented as a timeout.
// In each case the harness knew the limit and the caller could not see it.

// THE SIX DISPOSITIONS DCH-2 OWES, as one closed coproduct so that a tool result is either an
// outcome or a NAMED refusal -- never an empty string that the model must guess the meaning of.
//
// WorkingDirectoryAbsent: the working directory is part of the call's declared input, so a caller
// never complies with a convention by accident. An absent one refuses rather than defaulting to
// wherever the harness process happens to be standing.
//
// DurationExceeded: a limit that kills a build is a real refusal and arrives as one, distinguished
// from the command's own failure by the timeout program's documented 124 exit. A default chosen for
// a chat turn is the wrong default for a compile, so the limit is per-call and reported.
//
// StandardInputRequested: no stdin means anything that prompts hangs until the limit kills it, and
// the operator sees a timeout rather than a prompt. The tool declares that it supplies no input, so
// a command that would read stdin gets an immediate typed refusal instead of a slow false timeout.
//
// OutputTruncated: a cap that ANNOUNCES itself, so a large result is distinguishable from a
// complete one. Adopted deliberately from the reviewed prior art, which had this right.
//
// EditMatchCount: zero or several matches refuse rather than patching the first. Construction over
// validation, and also adopted rather than reinvented.
//
// ContextWindowExhausted: a full window is a typed refusal, not a turn that begins to fail.
// Compaction is a later capability; without this disposition, exhaustion presents to the operator
// as the model quietly getting worse, which is the failure that cannot be debugged from outside.
type HarnessToolDisposition
  = WorkingDirectoryAbsent { path: String }
  | DurationExceeded { limit_seconds: Int }
  | StandardInputRequested { detail: String }
  | EditMatchCount { pattern: String, found: Int }
  | ContextWindowExhausted { detail: String }
  | ToolInputMemberMissing { tool: String, member: String }
  | ToolUnrecognized { name: String }
  | ToolEffectRefused { detail: String }

fn harness_disposition_text(d: HarnessToolDisposition) -> String {
  match d {
    WorkingDirectoryAbsent { path } =>
      join(["working directory does not exist: ", path], "")
    DurationExceeded { limit_seconds } =>
      join([
        "command exceeded the shell-job backstop of ", to_string(value: limit_seconds),
        "s and its process group was killed; this is the harness's backstop, not the command's own failure",
      ], "")
    StandardInputRequested { detail } =>
      join(["command attempted to read standard input, which this tool does not supply: ", detail], "")
    EditMatchCount { pattern, found } =>
      join([
        "edit refused: pattern occurs ", to_string(value: found),
        " times and an edit is applied only at exactly one match; pattern was: ", pattern,
      ], "")
    ContextWindowExhausted { detail } =>
      join(["context window exhausted: ", detail], "")
    ToolInputMemberMissing { tool, member } =>
      join(["tool ", tool, " was called without its required input member '", member, "'"], "")
    ToolUnrecognized { name } =>
      join(["no tool named '", name, "' is declared by this harness"], "")
    ToolEffectRefused { detail } =>
      join(["tool effect refused: ", detail], "")
  }
}

// AN OUTCOME CARRIES ITS OWN TRUNCATION STANDING, so "complete" is a claim the result makes rather
// than an assumption the reader brings.
type HarnessOutputStanding
  = OutputComplete
  | OutputTruncated { retained_bytes: Int, total_bytes: Int }

type HarnessToolOutcome
  = ToolCompleted {
      text: String
      exit_code: Int
      standing: HarnessOutputStanding
    }
  | ToolJob { id: String, text: String }
  | ToolRefused { disposition: HarnessToolDisposition }

fn harness_outcome_is_error(outcome: HarnessToolOutcome) -> Bool {
  match outcome {
    ToolCompleted { text: _, exit_code: code, standing: _ } => !(code == 0)
    ToolJob { id: _, text: _ } => false
    ToolRefused { disposition: _ } => true
  }
}

fn harness_outcome_text(outcome: HarnessToolOutcome) -> String {
  match outcome {
    ToolCompleted { text, exit_code: code, standing } =>
      join([
        text,
        "\n[exit ", to_string(value: code), "]",
        match standing {
          OutputComplete => ""
          OutputTruncated { retained_bytes: kept, total_bytes: total } =>
            join([
              "\n[output truncated: ", to_string(value: kept), " of ",
              to_string(value: total), " bytes retained]",
            ], "")
        },
      ], "")
    ToolJob { id: _, text } => text
    ToolRefused { disposition: d } => harness_disposition_text(d: d)
  }
}

type HarnessToolStep {
  environment: HarnessToolEnvironment
  outcome: HarnessToolOutcome
}

// THE EXECUTION ENVIRONMENT THE TOOLS RUN IN, declared per call rather than inherited.
// jobs / wait_pace are the attempt's shell-job resource set (see gunbc.harness.harness_shell_job).
type HarnessToolEnvironment {
  working_directory: FilePath
  timeout_program: FilePath
  job_output_directory: FilePath
  duration_limit_seconds: Int
  jobs: List<HarnessShellJob>
  wait_pace: HarnessWaitPace
}

fn harness_tool_environment(
  working_directory: FilePath,
  timeout_program: FilePath,
  job_output_directory: FilePath,
) -> HarnessToolEnvironment {
  HarnessToolEnvironment {
    working_directory: working_directory,
    timeout_program: timeout_program,
    job_output_directory: job_output_directory,
    duration_limit_seconds: schedule_seconds(s: harness_shell_job_schedule.backstop),
    jobs: [],
    wait_pace: WaitPaceReset,
  }
}

// GNU timeout exits 124 when it kills its child, which is what makes "the harness stopped this" a
// DECIDABLE fact rather than a guess from a nonzero exit. Cited to coreutils' documented behaviour
// and executed against /opt/homebrew/bin/gtimeout 9.11 on 2026-09-02, which returned exactly 124.
data harness_timeout_kill_exit_code: Int = 124

// THE TOOL RESULT CARRIES A DECLARED CAP, AND STDOUT IS THE CHANNEL THAT NEEDED ONE. extdeps.gunbc
// WitnessBin.Run declares stderr_capture: BoundedTail{16384} and reports stderr_truncated with its
// byte counts -- and declares NOTHING for stdout, which is the channel that actually returns bulk
// output. So harness_run_command announced truncation for the small channel while pasting the large
// one into the turn verbatim, and HarnessOutputStanding's own annotation ("a cap that ANNOUNCES
// itself, so a large result is distinguishable from a complete one") was true of stderr only.
//
// MEASURED, NOT ANTICIPATED. A worker ran `cat` on the plan document its brief names. That single
// tool_result was 162KB of a 170KB request -- five messages, roughly 42k tokens -- and the backend
// closed the connection without a reply after four minutes (curl 52). Nothing refused: the turn
// simply stopped, and the operator saw a hang.
//
// THE BUDGET IS THE HARNESS'S OWN, NOT THE TRANSPORT'S. Bounding here rather than waiting for a
// stdout capture policy keeps the cap where the contract that announces it lives, and it is the
// tool result -- what enters the context -- that must be bounded, which is a different question
// from how much the transport chose to read. When a stdout policy does land, this stays the
// narrower of the two rather than being replaced by it.
data harness_tool_output_budget: CharacterCount = character_count(count: 16384)

type HarnessBoundedToolText {
  text: String
  standing: HarnessOutputStanding
}

fn harness_bounded_tool_text(text: String) -> HarnessBoundedToolText {
  let total = text.length()
  let budget = character_count_value(c: harness_tool_output_budget)
  if total <= budget {
    HarnessBoundedToolText { text: text, standing: OutputComplete }
  } else {
    HarnessBoundedToolText {
      text: text.substring(start: 0, end: budget),
      standing: OutputTruncated { retained_bytes: budget, total_bytes: total },
    }
  }
}

fn harness_env_with_jobs(
  environment: HarnessToolEnvironment,
  jobs: List<HarnessShellJob>,
  wait_pace: HarnessWaitPace,
) -> HarnessToolEnvironment {
  HarnessToolEnvironment {
    working_directory: environment.working_directory,
    timeout_program: environment.timeout_program,
    job_output_directory: environment.job_output_directory,
    duration_limit_seconds: environment.duration_limit_seconds,
    jobs: jobs,
    wait_pace: wait_pace,
  }
}

fn harness_wait_note(seconds: Second, clamped: Bool, raised_to_minimum: Bool, capped_at_backstop: Bool, asked_seconds: Second) -> String {
  let clamped_note = if clamped {
    join([
      " [wait clamped from ", to_string(value: second_count(s: asked_seconds) as Int),
      "s to ", to_string(value: second_count(s: seconds) as Int), "s (request above 4x previous)]",
    ], "")
  } else {
    ""
  }
  let raised_note = if raised_to_minimum {
    join([
      " [wait raised from ", to_string(value: second_count(s: asked_seconds) as Int),
      "s to the minimum ", to_string(value: second_count(s: seconds) as Int), "s; polling is refused]",
    ], "")
  } else {
    ""
  }
  let backstop_note = if capped_at_backstop {
    join([
      " [wait capped at the shell-job backstop of ",
      to_string(value: second_count(s: seconds) as Int),
      "s; no job outlives it]",
    ], "")
  } else {
    ""
  }
  join([clamped_note, raised_note, backstop_note], "")
}

fn harness_text_with_table(text: String, jobs: List<HarnessShellJob>) -> HarnessToolOutcome {
  let bounded = harness_bounded_tool_text(text: join([text, "\n", harness_command_table(jobs: jobs)], ""))
  ToolCompleted {
    text: bounded.text,
    exit_code: 0,
    standing: bounded.standing,
  }
}

fn harness_run_command_scheduled(
  environment: HarnessToolEnvironment,
  command: String,
  schedule: ShellJobSchedule,
) -> HarnessToolStep {
  let spawn = harness_start_shell_job(
    worktree: environment.working_directory,
    job_output_directory: environment.job_output_directory,
    timeout_program: environment.timeout_program,
    command: command,
    schedule: schedule,
  )
  match spawn {
    ShellSpawnFailed { program, cause } =>
      HarnessToolStep {
        environment: environment,
        outcome: ToolRefused {
          disposition: ToolEffectRefused {
            detail: join(["spawn refused for ", program as String, ": ", cause as String], ""),
          },
        },
      }
    ShellSpawned { job } => {
      let hold = harness_await_pid(pid: job.pid, remaining: schedule.inline_hold)
      match hold {
        StillRunning => {
          let jobs = harness_replace_job(jobs: environment.jobs, job: job)
          HarnessToolStep {
            environment: harness_env_with_jobs(
              environment: environment,
              jobs: jobs,
              wait_pace: harness_pace_after_window_change(),
            ),
            outcome: ToolJob {
              id: job.id,
              text: join([
                "started background job ", job.id,
                " (still running after the inline hold of ",
                to_string(value: schedule_seconds(s: schedule.inline_hold)),
                "s; not killed). Wait with wait; read with job_output; stop with job_kill.\n",
                harness_command_table(jobs: jobs),
              ], ""),
            },
          }
        }
        Exited { code } =>
          if code == harness_timeout_kill_exit_code {
            HarnessToolStep {
              environment: harness_env_with_jobs(
                environment: environment,
                jobs: environment.jobs,
                wait_pace: harness_pace_after_window_change(),
              ),
              outcome: ToolRefused {
                disposition: DurationExceeded { limit_seconds: schedule_seconds(s: schedule.backstop) },
              },
            }
          } else {
            let bounded = harness_bounded_tool_text(text: harness_read_job_text(job: job))
            HarnessToolStep {
              environment: harness_env_with_jobs(
                environment: environment,
                jobs: environment.jobs,
                wait_pace: harness_pace_after_window_change(),
              ),
              outcome: ToolCompleted {
                text: join([bounded.text, "\n", harness_command_table(jobs: environment.jobs)], ""),
                exit_code: code,
                standing: bounded.standing,
              },
            }
          }
        Signaled { signal } =>
          HarnessToolStep {
            environment: environment,
            outcome: ToolRefused {
              disposition: ToolEffectRefused {
                detail: join(["command signaled ", to_string(value: signal)], ""),
              },
            },
          }
        ReapRefused { cause } =>
          HarnessToolStep {
            environment: environment,
            outcome: ToolRefused { disposition: ToolEffectRefused { detail: cause as String } },
          }
      }
    }
  }
}

fn harness_run_command(
  environment: HarnessToolEnvironment,
  command: String,
) -> HarnessToolStep {
  harness_run_command_scheduled(
    environment: environment,
    command: command,
    schedule: harness_shell_job_schedule,
  )
}

fn harness_wait_jobs_scheduled(
  environment: HarnessToolEnvironment,
  schedule: ShellJobSchedule,
  request: HarnessWaitRequest,
) -> HarnessToolStep {
  match harness_admit_wait(
    schedule: schedule,
    pace: environment.wait_pace,
    request: request,
  ) {
    WaitRefusedNotADuration { minutes, cause } =>
      HarnessToolStep {
        environment: environment,
        outcome: ToolRefused {
          disposition: ToolEffectRefused {
            detail: join([
              "wait minutes must be a positive duration, got ",
              to_string(value: minutes),
              " (",
              cause,
              ")",
            ], ""),
          },
        },
      }
    WaitAdmitted { seconds, clamped, raised_to_minimum, capped_at_backstop, asked_seconds } => {
      let note = harness_wait_note(
        seconds: seconds,
        clamped: clamped,
        raised_to_minimum: raised_to_minimum,
        capped_at_backstop: capped_at_backstop,
        asked_seconds: asked_seconds,
      )
      match harness_wait_until_any(jobs: environment.jobs, remaining: seconds) {
        WaitLoopNoRunningJob { jobs: stamped } =>
          HarnessToolStep {
            environment: harness_env_with_jobs(
              environment: environment,
              jobs: stamped,
              wait_pace: environment.wait_pace,
            ),
            outcome: ToolRefused {
              disposition: ToolEffectRefused { detail: "wait: no running job" },
            },
          }
        WaitLoopFinished { jobs: stamped, observation: _ } =>
          HarnessToolStep {
            environment: harness_env_with_jobs(
              environment: environment,
              jobs: stamped,
              wait_pace: harness_pace_after_window_change(),
            ),
            outcome: harness_text_with_table(
              text: join(["a job finished before the wait elapsed", note], ""),
              jobs: stamped,
            ),
          }
        WaitLoopExpired { jobs: stamped } =>
          HarnessToolStep {
            environment: harness_env_with_jobs(
              environment: environment,
              jobs: stamped,
              wait_pace: harness_pace_after_expired_wait(seconds: seconds),
            ),
            outcome: harness_text_with_table(
              text: join(["wait elapsed with no job finishing", note], ""),
              jobs: stamped,
            ),
          }
      }
    }
  }
}

fn harness_wait_jobs(
  environment: HarnessToolEnvironment,
  request: HarnessWaitRequest,
) -> HarnessToolStep {
  harness_wait_jobs_scheduled(
    environment: environment,
    schedule: harness_shell_job_schedule,
    request: request,
  )
}

fn harness_read_job_output(environment: HarnessToolEnvironment, id: String) -> HarnessToolStep {
  match harness_find_job(jobs: environment.jobs, id: id) {
    Absent =>
      HarnessToolStep {
        environment: environment,
        outcome: ToolRefused {
          disposition: ToolEffectRefused { detail: join(["no job ", id], "") },
        },
      }
    Present { value: job } => {
      let stamped = harness_refresh_job(job: job)
      let jobs = harness_replace_job(jobs: environment.jobs, job: stamped)
      let bounded = harness_bounded_tool_text(text: harness_read_job_text(job: stamped))
      HarnessToolStep {
        environment: harness_env_with_jobs(
          environment: environment,
          jobs: jobs,
          wait_pace: environment.wait_pace,
        ),
        outcome: ToolCompleted {
          text: join([bounded.text, "\n", harness_command_table(jobs: jobs)], ""),
          exit_code: 0,
          standing: bounded.standing,
        },
      }
    }
  }
}

fn harness_kill_job(environment: HarnessToolEnvironment, id: String) -> HarnessToolStep {
  match harness_find_job(jobs: environment.jobs, id: id) {
    Absent =>
      HarnessToolStep {
        environment: environment,
        outcome: ToolRefused {
          disposition: ToolEffectRefused { detail: join(["no job ", id], "") },
        },
      }
    Present { value: job } =>
      if !harness_job_is_running(job: job) {
        HarnessToolStep {
          environment: environment,
          outcome: ToolRefused {
            disposition: ToolEffectRefused {
              detail: join(["job ", id, " has finished; job_kill acts only on a running job"], ""),
            },
          },
        }
      } else {
        match harness_kill_running_job(job: job) {
          JobKillUnconfirmed { job: still, detail } =>
            HarnessToolStep {
              environment: harness_env_with_jobs(
                environment: environment,
                jobs: harness_replace_job(jobs: environment.jobs, job: still),
                wait_pace: environment.wait_pace,
              ),
              outcome: ToolRefused { disposition: ToolEffectRefused { detail: detail } },
            }
          JobKillConfirmed { job: dead } => {
            let jobs = harness_replace_job(jobs: environment.jobs, job: dead)
            HarnessToolStep {
              environment: harness_env_with_jobs(
                environment: environment,
                jobs: jobs,
                wait_pace: harness_pace_after_window_change(),
              ),
              outcome: harness_text_with_table(
                text: join(["killed process group ", dead.id], ""),
                jobs: jobs,
              ),
            }
          }
        }
      }
  }
}

// THE TOOL DECLARATIONS SENT TO THE MODEL. The schema is authored as JSON because that is what the
// wire member IS -- a JSON Schema document -- and inventing a modelled mirror of JSON Schema to
// project back into JSON would be a second representation of a specification we do not own.
fn harness_run_command_schema() -> JsonValue {
  json_object([
    json_kv(key: "type", value: json_string(s: "object")),
    json_kv(key: "properties", value: json_object([
      json_kv(key: "command", value: json_object([
        json_kv(key: "type", value: json_string(s: "string")),
        json_kv(key: "description", value: json_string(
          s: "Shell command to run in the attempt working directory. A command that finishes within the inline hold returns its output here. One that does not becomes a background job (not killed at the hold); wait, job_output and job_kill follow it. The backstop is the only kill.",
        )),
      ])),
    ])),
    json_kv(key: "required", value: json_array(elements: [json_string(s: "command")])),
  ])
}

fn harness_tool_use_input_string(block: HarnessWireBlock, member: String) -> String? {
  match block {
    WireToolUseBlock { id: _, name: _, input: input } =>
      match json_object_unique_member(v: input, key: member) {
        JsonMemberFound { value: v } =>
          match v {
            JsonString { value: s } => Present { value: s }
            JsonNull => none
            JsonBool { value: _ } => none
            JsonNumber { lexeme: _ } => none
            JsonArray { elements: _ } => none
            JsonObject { members: _ } => none
          }
        JsonMemberAbsent => none
        JsonMemberDuplicated { count: _ } => none
        JsonMemberNotAnObject => none
      }
    WireTextBlock { text: _ } => none
    WireThinkingBlock { thinking: _ } => none
  }
}

// DISPATCH IS TOTAL. An unrecognized name and a missing required member are each their own refusal
// carrying the offending name, so a malformed call is reported back to the model as a fact it can
// act on rather than as an empty result it must interpret.
fn harness_wait_request_from_block(block: HarnessWireBlock) -> HarnessWaitRequest {
  match block {
    WireToolUseBlock { id: _, name: _, input: input } =>
      match json_field_int(obj: input, key: "minutes") {
        FieldRead { value: n } => WaitRequestedMinutes { minutes: n }
        FieldAbsent => WaitUseDefault
        FieldMalformed { cause } => WaitMalformedMinutes { cause: cause }
      }
    WireTextBlock { text: _ } => WaitUseDefault
    WireThinkingBlock { thinking: _ } => WaitUseDefault
  }
}

fn harness_unchanged_refusal(
  environment: HarnessToolEnvironment,
  disposition: HarnessToolDisposition,
) -> HarnessToolStep {
  HarnessToolStep {
    environment: environment,
    outcome: ToolRefused { disposition: disposition },
  }
}

fn harness_execute_tool_use(
  environment: HarnessToolEnvironment,
  block: HarnessWireBlock,
) -> HarnessToolStep {
  match block {
    WireToolUseBlock { id: _, name: name, input: _ } =>
      match harness_tool_of_wire_name(name: name) {
        HarnessToolUnrecognized { name: n } =>
          harness_unchanged_refusal(
            environment: environment,
            disposition: ToolUnrecognized { name: n },
          )
        HarnessToolRecognized { tool: t } =>
          match t {
            RunCommandTool =>
              match harness_tool_use_input_string(block: block, member: "command") {
                Present { value: c } =>
                  harness_run_command(environment: environment, command: c)
                Absent =>
                  harness_unchanged_refusal(
                    environment: environment,
                    disposition: ToolInputMemberMissing { tool: "run_command", member: "command" },
                  )
              }
            WaitJobsTool =>
              harness_wait_jobs(
                environment: environment,
                request: harness_wait_request_from_block(block: block),
              )
            ReadJobOutputTool =>
              match harness_tool_use_input_string(block: block, member: "id") {
                Present { value: id } => harness_read_job_output(environment: environment, id: id)
                Absent =>
                  harness_unchanged_refusal(
                    environment: environment,
                    disposition: ToolInputMemberMissing { tool: "job_output", member: "id" },
                  )
              }
            KillJobTool =>
              match harness_tool_use_input_string(block: block, member: "id") {
                Present { value: id } => harness_kill_job(environment: environment, id: id)
                Absent =>
                  harness_unchanged_refusal(
                    environment: environment,
                    disposition: ToolInputMemberMissing { tool: "job_kill", member: "id" },
                  )
              }
            ReadFileTool =>
              harness_unchanged_refusal(
                environment: environment,
                disposition: ToolEffectRefused {
                  detail: harness_unimplemented_tool_detail(tool: ReadFileTool),
                },
              )
            WriteFileTool =>
              harness_unchanged_refusal(
                environment: environment,
                disposition: ToolEffectRefused {
                  detail: harness_unimplemented_tool_detail(tool: WriteFileTool),
                },
              )
            EditFileTool =>
              harness_unchanged_refusal(
                environment: environment,
                disposition: ToolEffectRefused {
                  detail: harness_unimplemented_tool_detail(tool: EditFileTool),
                },
              )
            HandInTool =>
              harness_unchanged_refusal(
                environment: environment,
                disposition: ToolEffectRefused {
                  detail: "hand_in is realized by the turn, which binds the candidate and waits for its outcome; this dispatcher does not run it",
                },
              )
          }
      }
    WireTextBlock { text: _ } =>
      harness_unchanged_refusal(
        environment: environment,
        disposition: ToolEffectRefused { detail: "block is not a tool use" },
      )
    WireThinkingBlock { thinking: _ } =>
      harness_unchanged_refusal(
        environment: environment,
        disposition: ToolEffectRefused { detail: "block is not a tool use" },
      )
  }
}

// THE THREE TOOLS THAT ARE DECLARED AND NOT YET REALIZED REFUSE BY NAME, and they are NOT offered
// to the model until they are. This is the honest shape of a vertical slice: the type carries the
// four-tool surface DCH-2 specifies so that adding one is a realization rather than a re-modelling,
// while harness_offered_tools below advertises only what actually runs. A tool advertised but
// unimplemented would be the worst of both -- the model would plan around a capability that refuses
// at the moment of use, having already spent the turn.
fn harness_unimplemented_tool_detail(tool: HarnessTool) -> String {
  join([
    "tool ", harness_tool_wire_name(tool: tool),
    " is declared in the harness tool surface but has no realization yet; it is deliberately not ",
    "advertised to the model, so reaching this arm means a caller invoked a tool it was never offered",
  ], "")
}

// OFFERED TOOLS ARE THE ONES THAT RUN. run_command is the shell; hand_in is the typed acceptance
// wait (operator ruling 2026-10-14: trusted operations may block to their own budget). The three
// file tools stay declared and unadvertised until they have a realization.
type OfferedHarnessTool
  = OfferedRunCommandTool
  | OfferedHandInTool
  | OfferedWaitJobsTool
  | OfferedReadJobOutputTool
  | OfferedKillJobTool

fn harness_offered_tool_kind(tool: OfferedHarnessTool) -> HarnessTool {
  match tool {
    OfferedRunCommandTool => RunCommandTool
    OfferedHandInTool => HandInTool
    OfferedWaitJobsTool => WaitJobsTool
    OfferedReadJobOutputTool => ReadJobOutputTool
    OfferedKillJobTool => KillJobTool
  }
}

fn harness_offered_tool_rows() -> List<OfferedHarnessTool> {
  [
    OfferedRunCommandTool, OfferedWaitJobsTool, OfferedReadJobOutputTool,
    OfferedKillJobTool, OfferedHandInTool,
  ]
}

fn harness_offered_tools() -> List<HarnessTool> {
  map(harness_offered_tool_rows(), t => harness_offered_tool_kind(tool: t))
}

data harness_run_command_description: String = "Run a shell command in the attempt's working directory. Finishes inline if it exits within the hold; otherwise returns a background job. Do not poll with sleep."

data harness_wait_description: String = "Sleep until any background job finishes, or until the admitted wait elapses. The next wait doubles; a request may be at most 4x the previous; the minimum is one minute so polling is impossible."

data harness_job_output_description: String = "Read one finished or running job's output by id from the command table."

data harness_job_kill_description: String = "Stop a background job and everything it started (its process group)."

data harness_hand_in_description: String = "Hand in the ready candidate written to .gunbc-submission.json. This call blocks until acceptance returns; the tool result is Accepted, ChangesRequested with evidence, or Unavailable with its cause. Do not run the node's acceptance witness yourself."

fn harness_hand_in_schema() -> JsonValue {
  json_object([
    json_kv(key: "type", value: json_string(s: "object")),
    json_kv(key: "properties", value: json_object([])),
    json_kv(key: "required", value: json_array(elements: [])),
  ])
}

fn harness_wait_schema() -> JsonValue {
  json_object([
    json_kv(key: "type", value: json_string(s: "object")),
    json_kv(key: "properties", value: json_object([
      json_kv(key: "minutes", value: json_object([
        json_kv(key: "type", value: json_string(s: "integer")),
        json_kv(key: "description", value: json_string(
          s: "Requested wait in minutes. Omitted uses the next backoff. Below the minimum is raised; above 4x the previous is clamped; both are said in the result.",
        )),
      ])),
    ])),
    json_kv(key: "required", value: json_array(elements: [])),
  ])
}

fn harness_job_id_schema(description: String) -> JsonValue {
  json_object([
    json_kv(key: "type", value: json_string(s: "object")),
    json_kv(key: "properties", value: json_object([
      json_kv(key: "id", value: json_object([
        json_kv(key: "type", value: json_string(s: "string")),
        json_kv(key: "description", value: json_string(s: description)),
      ])),
    ])),
    json_kv(key: "required", value: json_array(elements: [json_string(s: "id")])),
  ])
}

fn harness_offered_tool_schema(tool: OfferedHarnessTool) -> JsonValue {
  match tool {
    OfferedRunCommandTool => harness_run_command_schema()
    OfferedHandInTool => harness_hand_in_schema()
    OfferedWaitJobsTool => harness_wait_schema()
    OfferedReadJobOutputTool => harness_job_id_schema(description: "Job id from the command table.")
    OfferedKillJobTool => harness_job_id_schema(description: "Job id whose process group to kill.")
  }
}

fn harness_offered_tool_description(tool: OfferedHarnessTool) -> String {
  match tool {
    OfferedRunCommandTool => harness_run_command_description
    OfferedHandInTool => harness_hand_in_description
    OfferedWaitJobsTool => harness_wait_description
    OfferedReadJobOutputTool => harness_job_output_description
    OfferedKillJobTool => harness_job_kill_description
  }
}

fn harness_offered_tool_json(shape: HarnessWireShape, tool: OfferedHarnessTool) -> JsonValue {
  let kind = harness_offered_tool_kind(tool: tool)
  match shape {
    AnthropicMessagesShape =>
      json_object([
        json_kv(key: "name", value: json_string(s: harness_tool_wire_name(tool: kind))),
        json_kv(key: "description", value: json_string(s: harness_offered_tool_description(tool: tool))),
        json_kv(key: "input_schema", value: harness_offered_tool_schema(tool: tool)),
      ])
    OpenAiChatCompletionsShape =>
      json_object([
        json_kv(key: "type", value: json_string(s: "function")),
        json_kv(key: "function", value: json_object([
          json_kv(key: "name", value: json_string(s: harness_tool_wire_name(tool: kind))),
          json_kv(key: "description", value: json_string(s: harness_offered_tool_description(tool: tool))),
          json_kv(key: "parameters", value: harness_offered_tool_schema(tool: tool)),
        ])),
      ])
  }
}

fn harness_offered_tools_json(shape: HarnessWireShape) -> JsonValue {
  json_array(elements: map(harness_offered_tool_rows(), t => harness_offered_tool_json(shape: shape, tool: t)))
}
