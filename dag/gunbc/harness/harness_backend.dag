module gunbc.harness.harness_backend

import std.types { String, Bool, Int, List, NonEmptyStr }
import extdeps.http.client
import extdeps.languages.json.emit { JsonValue, JsonString, JsonArray }
import extdeps.languages.json.parse {
  JsonDocumentParse, JsonDocumentParsed, JsonDocumentUnreadable,
  JsonMemberFound, parse_json_document, json_object_unique_member, json_document_gap_text,
}
import extdeps.vllm.metrics { VllmServingMetric, NumRequestsWaiting, NumRequestsRunning, vllm_metric_name }
import gunbc.serving.turn_dispatch { ServingQueueReading, QueueDepthRead, QueueDepthUnread }
import gunbc.harness.harness_wire {
  harness_engine_replica_roster, HarnessReplicaRoster, HarnessReplicasResolved, HarnessReplicasUnresolved,
  harness_engine_port, harness_engine_model,
  HarnessWireShape, harness_backend_url_for_address,
}

// THE HARNESS REPORTS ITS OWN STANDING, WHICH IS THE POINT RATHER THAN A CONVENIENCE.
//
// Every vendor provider in this repository is assessed from OUTSIDE: a login-status probe, a
// transcript scraped for state, an entitlement axis nobody can read. That observation layer is what
// dominates the vendor modules, and it is why Codex selection cannot resolve today -- the offer is
// constructed with an unobserved standing and eligibility requires an observed one, so the honest
// answer is permanently "unknown" and unknown refuses.
//
// The harness has no such gap because the question is different. It has no account, so there is no
// entitlement to read; no quota, so there is no limit bucket to model. The only thing that decides
// whether it can work is whether the backend it posts to is serving the model it will name, and
// that is one GET away and answerable by us.

data harness_models_path: String = "/v1/models"

fn harness_models_url(address: String) -> String {
  join([
    "http://", address, ":", to_string(value: harness_engine_port),
    harness_models_path,
  ], "")
}

type HarnessBackendStanding
  = HarnessBackendServing { model: String }
  | HarnessBackendModelAbsent { model: String, advertised: String }
  | HarnessBackendUnreachable { url: String }
  | HarnessBackendUnreadable { cause: String }

fn harness_standing_label(standing: HarnessBackendStanding) -> String {
  match standing {
    HarnessBackendServing { model: _ } => "serving"
    HarnessBackendModelAbsent { model: _, advertised: _ } => "model-absent"
    HarnessBackendUnreachable { url: _ } => "unreachable"
    HarnessBackendUnreadable { cause: _ } => "unreadable"
  }
}

fn harness_standing_detail(standing: HarnessBackendStanding) -> String {
  match standing {
    HarnessBackendServing { model: m } =>
      join(["backend advertises ", m], "")
    HarnessBackendModelAbsent { model: m, advertised: a } =>
      join([
        "backend is reachable but does not advertise ", m,
        "; it advertises: ", a,
      ], "")
    HarnessBackendUnreachable { url: u } =>
      join(["backend did not answer ", u], "")
    HarnessBackendUnreadable { cause: c } =>
      join(["backend answered but the model list was unreadable: ", c], "")
  }
}

// THE MODEL LIST IS PARSED, NOT SUBSTRING-MATCHED. A `contains` over the raw body would pass on a
// model whose id merely shares a prefix with ours, and would pass on an error document that happens
// to quote the name back -- which is exactly the shape of the not_found_error this backend returns.
// Four states, and the middle two are the ones a weaker check would fuse: reachable-but-wrong-model
// is a different remedy from unreachable, and both are different from a malformed answer.
fn harness_model_ids(doc: JsonValue) -> List<String> {
  match json_object_unique_member(v: doc, key: "data") {
    JsonMemberFound { value: d } =>
      match d {
        JsonArray { elements: els } =>
          els |> flat_map(e => match json_object_unique_member(v: e, key: "id") {
            JsonMemberFound { value: idv } =>
              match idv {
                JsonString { value: s } => [s]
                _ => []
              }
            _ => []
          })
        _ => []
      }
    _ => []
  }
}

fn harness_observe_replica(address: String) -> HarnessBackendStanding {
  let url = harness_models_url(address: address)
  let read = http.Client.Get(url: url as NonEmptyStr)
  if !read.success {
    HarnessBackendUnreachable { url: url }
  } else {
    match parse_json_document(s: read.body) {
      JsonDocumentUnreadable { gap: g } =>
        HarnessBackendUnreadable { cause: json_document_gap_text(gap: g) }
      JsonDocumentParsed { value: doc } => {
        let ids = harness_model_ids(doc: doc)
        if any(ids, id => id == harness_engine_model) {
          HarnessBackendServing { model: harness_engine_model }
        } else {
          HarnessBackendModelAbsent {
            model: harness_engine_model,
            advertised: join(ids, ", "),
          }
        }
      }
    }
  }
}

fn harness_standing_is_serving(standing: HarnessBackendStanding) -> Bool {
  match standing {
    HarnessBackendServing { model: _ } => true
    HarnessBackendModelAbsent { model: _, advertised: _ } => false
    HarnessBackendUnreachable { url: _ } => false
    HarnessBackendUnreadable { cause: _ } => false
  }
}

// THE ROSTER IS OBSERVED ONE REPLICA AT A TIME AND THE ANSWER KEEPS BOTH HALVES. The previous fold
// answered for the whole backend with the first non-serving replica's standing, so one Spark down
// refused every dispatch while the other served -- measured 2026-09-05 on srv1, .232 unreachable,
// .225 advertising the model, dispatch refused at selection. That was the all-or-nothing reading of
// a roster whose whole point is that attempts spread across it. Now: serving replicas are the set an
// attempt may bind to; declined replicas are carried with their typed standing, so the count of what
// is down is observable and never absorbed. None serving refuses, naming every replica's cause.
type HarnessReplicaDecline {
  address: String
  standing: HarnessBackendStanding
}

type HarnessBackendRoster
  = HarnessRosterServing { model: String, serving: List<String>, declined: List<HarnessReplicaDecline> }
  | HarnessRosterNoneServing { model: String, declined: List<HarnessReplicaDecline> }
  | HarnessRosterUnresolved { hosts: List<String> }

type HarnessRosterFold {
  serving: List<String>
  declined: List<HarnessReplicaDecline>
}

fn harness_observe_roster() -> HarnessBackendRoster {
  match harness_engine_replica_roster() {
    HarnessReplicasUnresolved { hosts } => HarnessRosterUnresolved { hosts: map(hosts, h => h as String) }
    HarnessReplicasResolved { addresses } => harness_observe_addresses(addresses: addresses)
  }
}

fn harness_observe_addresses(addresses: List<String>) -> HarnessBackendRoster {
  let folded = fold(addresses, init: HarnessRosterFold { serving: [], declined: [] }, f: (acc, a) => {
    let standing = harness_observe_replica(address: a)
    if harness_standing_is_serving(standing: standing) {
      HarnessRosterFold { serving: concat(acc.serving, [a]), declined: acc.declined }
    } else {
      HarnessRosterFold { serving: acc.serving, declined: concat(acc.declined, [HarnessReplicaDecline { address: a, standing: standing }]) }
    }
  })
  if count(folded.serving) == 0 {
    HarnessRosterNoneServing { model: harness_engine_model, declined: folded.declined }
  } else {
    HarnessRosterServing { model: harness_engine_model, serving: folded.serving, declined: folded.declined }
  }
}

fn harness_declines_detail(declined: List<HarnessReplicaDecline>) -> String {
  join(map(declined, d => join([
    d.address, ": ", harness_standing_label(standing: d.standing), " -- ", harness_standing_detail(standing: d.standing),
  ], "")), "; ")
}

fn harness_roster_unresolved_detail(hosts: List<String>) -> String {
  join(["harness replica roster unresolved: pair head(s) with no LAN endpoint row in gunbc.fleet_intent_network: ", join(hosts, ", ")], "")
}

// THE URL AN ATTEMPT POSTS TO, bound at process start from the replicas serving at that moment. The
// seed spreads concurrent attempts across the serving set; a roster with nothing serving is a typed
// refusal the entry point exits on, never a URL that will fail on the first turn.
type HarnessBackendUrl
  = BackendUrlBound { url: String, declined_count: Int }
  | BackendUrlRefused { detail: String }

// THE PROBE BINDS TO THE FIRST REPLICA OBSERVED SERVING. This is an observation entry, not a turn:
// a turn takes its endpoint from a granted seat (gunbc.harness.harness_seat), and the seed hash
// that used to spread turns here is gone with the picker it belonged to.
fn harness_serving_backend_url(shape: HarnessWireShape) -> HarnessBackendUrl {
  match harness_observe_roster() {
    HarnessRosterServing { model: _, serving, declined } =>
      match first(serving) {
        Present { value: a } => BackendUrlBound { url: harness_backend_url_for_address(shape: shape, address: a), declined_count: count(declined) }
        Absent => BackendUrlRefused { detail: "the serving roster is empty" }
      }
    HarnessRosterNoneServing { model: m, declined } =>
      BackendUrlRefused { detail: join(["no harness replica serves ", m, ": ", harness_declines_detail(declined: declined)], "") }
    HarnessRosterUnresolved { hosts } => BackendUrlRefused { detail: harness_roster_unresolved_detail(hosts: hosts) }
  }
}

fn harness_backend_report() -> String {
  match harness_engine_replica_roster() {
    HarnessReplicasUnresolved { hosts } =>
      join(["harness replica roster unresolved: no LAN endpoint row for ", join(map(hosts, h => h as String), ", "), "\n"], "")
    HarnessReplicasResolved { addresses } => harness_addresses_report(addresses: addresses)
  }
}

fn harness_addresses_report(addresses: List<String>) -> String {
  join(map(addresses, a => {
    let standing = harness_observe_replica(address: a)
    join([
      "harness engine ", a, ": ", harness_standing_label(standing: standing), " -- ",
      harness_standing_detail(standing: standing), "\n",
    ], "")
  }), "")
}

// ── THE QUEUE THE HARNESS NEVER READ ──────────────────────────────────────────────────────────
//
// harness_observe_replica reads /v1/models and nothing else, so until now the harness took a seat
// without ever asking whether the group already had work queued. Its capacity pool bounded the
// damage to three seats, but the decision itself was made on ignorance -- the same class of defect
// as the router's, milder only because a CAS stood behind it.
//
// gunbc.serving.turn_dispatch makes that unrepresentable: ServingQueueReading has no default, and
// an unread queue reaches selection as AvailabilityUnobserved carrying an obligation rather than as
// an idle engine. This is the reading that lets the harness answer.
//
// THE METRIC NAME COMES FROM THE UPSTREAM AUTHORITY, not from a literal here. extdeps.vllm.metrics
// owns what vLLM exposes and what each series means; a second spelling in this module would be a
// nickname for the same fact, and the last time this repository read a vLLM gauge by guessing what
// its name implied it concluded a warm cache was a saturated engine.
fn harness_metrics_url(address: String) -> String {
  join(["http://", address, ":", to_string(value: harness_engine_port), "/metrics"], "")
}

// A PROMETHEUS LINE IS name{labels} value. The gauge is found by its authored name and the value is
// the last space-separated field; anything that does not parse that way is UNREAD rather than zero,
// because a gauge that could not be read is not a gauge reading nothing.
fn harness_gauge_line_value(body: String, metric: VllmServingMetric) -> String? {
  let wanted = vllm_metric_name(m: metric) as String
  let lines = split(s: body, delimiter: "\n")
  let matching = filter(lines, l => string_contains(s: l, pattern: join([wanted, "{"], "")))
  match first(matching) {
    Absent => none
    Present { value: line } => {
      let parts = split(s: line, delimiter: " ")
      if length(parts) < 2 { none } else { last(parts) }
    }
  }
}

// vLLM PRINTS GAUGES AS FLOATS, so "0.0" is the ordinary shape and an integer parse fails on it. A
// leading "0." is zero; anything else is a count this parse cannot name, which is still not a
// licence to call it zero.
fn harness_gauge_count(text: String) -> Nat? {
  let t = trim(s: text)
  match parse_int(s: t) {
    Present { value: n } =>
      if n <= 0 { Present { value: 0 as Nat } } else { Present { value: n as Nat } }
    Absent =>
      if starts_with(s: t, prefix: "0.") { Present { value: 0 as Nat } }
      else { Present { value: 1 as Nat } }
  }
}

// BOTH GAUGES OR NEITHER. gunbc.serving.turn_dispatch prices a queue as the delay before an arriving
// turn can start, and it needs waiting AND running: waiting says how much is ahead in line, running
// says whether the group is already displacing someone. A reading carrying one and defaulting the
// other would be an observation half-invented, so a body missing either is unread.
fn harness_queue_from_body(body: String) -> ServingQueueReading {
  match harness_gauge_line_value(body: body, metric: NumRequestsWaiting) {
    Absent => QueueDepthUnread { obligation: "the served metrics carried no waiting-requests series" as NonEmptyStr }
    Present { value: waiting_text } =>
      match harness_gauge_line_value(body: body, metric: NumRequestsRunning) {
        Absent => QueueDepthUnread { obligation: "the served metrics carried no running-requests series" as NonEmptyStr }
        Present { value: running_text } =>
          match harness_gauge_count(text: waiting_text) {
            Absent => QueueDepthUnread { obligation: "the waiting-requests gauge had no readable value" as NonEmptyStr }
            Present { value: w } =>
              match harness_gauge_count(text: running_text) {
                Absent => QueueDepthUnread { obligation: "the running-requests gauge had no readable value" as NonEmptyStr }
                Present { value: r } => QueueDepthRead { waiting: w, running: r }
              }
          }
      }
  }
}

fn harness_observe_queue(address: String) -> ServingQueueReading {
  let url = harness_metrics_url(address: address)
  let read = http.Client.Get(url: url as NonEmptyStr)
  if !read.success {
    QueueDepthUnread { obligation: join(["the metrics endpoint at ", url, " did not answer"], "") as NonEmptyStr }
  } else {
    harness_queue_from_body(body: read.body)
  }
}
