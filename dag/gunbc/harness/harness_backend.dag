import extdeps.languages.json.emit { JsonValue, JsonString, JsonArray }
import extdeps.languages.json.parse {
  JsonDocumentParsed, JsonDocumentUnreadable, JsonMemberFound, parse_json_document,
  json_object_unique_member, json_document_gap_text,
}


// THE HARNESS REPORTS ITS OWN STANDING, WHICH IS THE POINT RATHER THAN A CONVENIENCE.
//
// Every vendor provider in this repository is assessed from OUTSIDE: a login-status probe, a
// transcript scraped for state, an entitlement axis nobody can read. That observation layer is what
// dominates the vendor modules, and it is why Codex selection cannot resolve today -- the offer is
// constructed with an unobserved standing and eligibility requires an observed one, so the honest
// answer is permanently "unknown" and unknown refuses.
//
// The harness has no such gap because the question is different. It has no account, so there is no
// entitlement to read; no quota, so there is no limit bucket to model. The only thing that decides
// whether it can work is whether the backend it posts to is serving the model it will name, and
// that is one GET away and answerable by us.

data harness_models_path: String = "/v1/models"

// THE URL IS BUILT FROM THE ROUTE'S OWN ENDPOINT, port included. It used to be built from the
// address plus one global port row, which made a second route on a second port unreachable without
// an edit -- and the second route is the canary, which answers on its own. The endpoint travels as
// one value for the reason the launch does: an address and a port that can be passed separately can
// be passed inconsistently.
fn harness_endpoint_url(endpoint: ServingRouteEndpoint, path: String) -> String {
  join(["http://", serving_route_endpoint_wire(e: endpoint) as String, path], "")
}

fn harness_models_url(endpoint: ServingRouteEndpoint) -> String {
  harness_endpoint_url(endpoint: endpoint, path: harness_models_path)
}

// ── WHAT A ROUTE IS SERVING, RATHER THAN WHETHER IT IS SERVING OURS ───────────────────────────
//
// THE ARM THIS REPLACES ASKED THE WRONG QUESTION. HarnessBackendModelAbsent meant "this route does
// not advertise the id our global selector names", so a route serving a perfectly good model the
// harness can speak to was reported as absent and never became a candidate. The question a placement
// path needs answered is which model the route IS serving, and whether that is one we are admitted
// to ask -- gunbc.serving.admitted_model owns the second half.
//
// THE SERVING ARM THEREFORE CARRIES THE UNIT AS WELL AS THE ID, because the two answer different
// questions downstream: the id is what goes in the request's model field, the unit is how the
// request is shaped -- its reasoning kwargs, its tool-call parser, its context window. Carrying only
// the id would force every consumer to resolve the unit again from a name.
type HarnessBackendStanding
  = HarnessBackendServing { model: NonEmptyStr, unit: HarnessServingUnit, readback: VllmModelsRouteReadbackStanding }
  | HarnessBackendModelNotAdmitted { advertised: String }
  | HarnessBackendUnreachable { url: String }
  | HarnessBackendUnreadable { cause: String }

fn harness_standing_label(standing: HarnessBackendStanding) -> String {
  match standing {
    HarnessBackendServing { model: _, unit: _, readback: _ } => "serving"
    HarnessBackendModelNotAdmitted { advertised: _ } => "model-not-admitted"
    HarnessBackendUnreachable { url: _ } => "unreachable"
    HarnessBackendUnreadable { cause: _ } => "unreadable"
  }
}

fn harness_standing_detail(standing: HarnessBackendStanding) -> String {
  match standing {
    HarnessBackendServing { model: m, unit: u, readback: r } =>
      join([
        "route advertises ", m as String,
        ", which this harness speaks to as ", harness_serving_unit_wire(unit: u) as String,
        "; /v1/models ", vllm_models_route_standing_wire(s: r),
      ], "")
    HarnessBackendModelNotAdmitted { advertised: a } =>
      join([
        "route is reachable but advertises no model this harness is admitted to ask; it advertises: ", a,
      ], "")
    HarnessBackendUnreachable { url: u } =>
      join(["backend did not answer ", u], "")
    HarnessBackendUnreadable { cause: c } =>
      join(["backend answered but the model list was unreadable: ", c], "")
  }
}

// THE MODEL LIST IS PARSED, NOT SUBSTRING-MATCHED. A `contains` over the raw body would pass on a
// model whose id merely shares a prefix with ours, and would pass on an error document that happens
// to quote the name back -- which is exactly the shape of the not_found_error this backend returns.
// Four states, and the middle two are the ones a weaker check would fuse: reachable-but-wrong-model
// is a different remedy from unreachable, and both are different from a malformed answer.
fn harness_model_ids(doc: JsonValue) -> List<String> {
  match json_object_unique_member(v: doc, key: "data") {
    JsonMemberFound { value: d } =>
      match d {
        JsonArray { elements: els } =>
          els |> flat_map(e => match json_object_unique_member(v: e, key: "id") {
            JsonMemberFound { value: idv } =>
              match idv {
                JsonString { value: s } => [s]
                _ => []
              }
            _ => []
          })
        _ => []
      }
    _ => []
  }
}

// THE ADMITTED SET DECIDES, AND THE ROUTE'S OWN LIST IS WHAT IT DECIDES OVER. Every advertised id is
// offered to gunbc.serving.admitted_model in the order the route reported them; the first one this
// harness can express a turn for wins, and if none can, the whole advertised list travels on the
// refusal so the remedy is readable -- a model we could admit by writing a unit row looks nothing
// like an Ollama daemon with an empty store, and both have answered this probe on this fleet.
fn harness_observe_replica(endpoint: ServingRouteEndpoint) -> HarnessBackendStanding {
  let url = harness_models_url(endpoint: endpoint)
  let read = http.Client.Get(url: url as NonEmptyStr)
  if !read.success {
    HarnessBackendUnreachable { url: url }
  } else {
    match parse_json_document(s: read.body) {
      JsonDocumentUnreadable { gap: g } =>
        HarnessBackendUnreadable { cause: json_document_gap_text(gap: g) }
      JsonDocumentParsed { value: doc } => {
        match serving_admit_advertised(advertised: harness_model_ids(doc: doc)) {
          ServingModelAdmitted { id: i, unit: u } =>
            HarnessBackendServing {
              model: i,
              unit: u,
              readback: vllm_models_route_standing(doc: doc, served_model_id: i),
            }
          ServingModelNotAdmitted { advertised: a } => HarnessBackendModelNotAdmitted { advertised: a }
        }
      }
    }
  }
}

// THE ROSTER IS OBSERVED ONE ROUTE AT A TIME AND THE ANSWER KEEPS BOTH HALVES. An earlier fold
// answered for the whole backend with the first non-serving replica's standing, so one Spark down
// refused every dispatch while the other served -- measured 2026-09-05 on srv1, .232 unreachable,
// .225 advertising the model, dispatch refused at selection. Serving routes are the set an attempt
// may bind to; declined routes are carried with their typed standing, so what is down is countable
// and never absorbed. None serving refuses, naming every route's cause.
//
// WHAT CHANGED IS WHAT A ROW IS ABOUT. It walked a list of ADDRESSES derived from the convergence
// roster; it now walks gunbc.serving.serving_enrollment's ROUTES, which carry their own front door
// and are enrolled independently of whose hosts this repository claims. A route whose head has no
// endpoint row is unresolved and is named, rather than making the list quietly shorter.
//
// AND THE MODELS ARE AN OUTPUT RATHER THAN AN INPUT. The serving arm used to carry the one model id
// the harness demanded, which is the question this branch stopped asking; it now carries the ids the
// routes were OBSERVED to advertise, one per serving route, so two routes serving two admitted
// models is representable instead of being a contradiction.
type HarnessRouteDecline {
  endpoint: NonEmptyStr
  group_wire: NonEmptyStr
  standing: HarnessBackendStanding
}

type HarnessRouteServing {
  endpoint: NonEmptyStr
  group_wire: NonEmptyStr
  model: NonEmptyStr
  unit: HarnessServingUnit
}

type HarnessBackendRoster
  = HarnessRosterServing { serving: List<HarnessRouteServing>, declined: List<HarnessRouteDecline>, unresolved: List<NonEmptyStr> }
  | HarnessRosterNoneServing { declined: List<HarnessRouteDecline>, unresolved: List<NonEmptyStr> }

type HarnessRosterFold {
  serving: List<HarnessRouteServing>
  declined: List<HarnessRouteDecline>
  unresolved: List<NonEmptyStr>
}

fn harness_observe_route(acc: HarnessRosterFold, route: ServingRoute) -> HarnessRosterFold {
  match route {
    ServingRouteUnresolved { group: _, obligation: o } =>
      HarnessRosterFold { serving: acc.serving, declined: acc.declined, unresolved: concat(acc.unresolved, [o]) }
    ServingRouteResolved { endpoint: e, ceiling: _ } => {
      let standing = harness_observe_replica(endpoint: e)
      match standing {
        HarnessBackendServing { model: m, unit: u, readback: _ } =>
          HarnessRosterFold {
            serving: concat(acc.serving, [HarnessRouteServing {
              endpoint: serving_route_endpoint_wire(e: e),
              group_wire: fabric_group_wire(g: e.group),
              model: m,
              unit: u,
            }]),
            declined: acc.declined,
            unresolved: acc.unresolved,
          }
        _ =>
          HarnessRosterFold {
            serving: acc.serving,
            declined: concat(acc.declined, [HarnessRouteDecline {
              endpoint: serving_route_endpoint_wire(e: e),
              group_wire: fabric_group_wire(g: e.group),
              standing: standing,
            }]),
            unresolved: acc.unresolved,
          }
      }
    }
  }
}

fn harness_observe_roster() -> HarnessBackendRoster {
  let folded = fold(serving_enrolled_routes(), init: HarnessRosterFold { serving: [], declined: [], unresolved: [] }, f: (acc, r) =>
    harness_observe_route(acc: acc, route: r))
  if count(folded.serving) == 0 {
    HarnessRosterNoneServing { declined: folded.declined, unresolved: folded.unresolved }
  } else {
    HarnessRosterServing { serving: folded.serving, declined: folded.declined, unresolved: folded.unresolved }
  }
}

fn harness_declines_detail(declined: List<HarnessRouteDecline>, unresolved: List<NonEmptyStr>) -> String {
  join(concat(
    map(declined, d => join([
      d.group_wire as String, " at ", d.endpoint as String, ": ",
      harness_standing_label(standing: d.standing), " -- ", harness_standing_detail(standing: d.standing),
    ], "")),
    map(unresolved, u => u as String)
  ), "; ")
}

// THE LAST LOCAL PICKER IS GONE, AND SO IS THE REPORT THAT OUTLIVED IT. This module used to hand
// out a URL bound at process start from the first replica observed serving, and every turn that took
// one was choosing its own host beside the fabric rather than through it; the probe was its final
// consumer and now acquires a seat like every other turn. A rendering function survived that cut
// with NO CONSUMER ANYWHERE -- no entry point, no CLI arm, no witness -- and this branch deletes it
// rather than porting it to the new route shape: a projection nothing reads is authoring, review and
// maintenance cost against a benefit of zero (DESIGN section 3c), and rewriting one to keep it
// compiling is that cost paid twice. What is observable is observable through the roster above,
// which the dispatch and belt preflights do consume.

// ── ONE READ OF THE SERVED METRICS ANSWERS BOTH QUESTIONS THE PLACEMENT PATH ASKS ─────────────
//
// The placement path needs two facts about a group before it can offer it: which LAUNCH is
// answering, and whether that launch is busy. Both are lines in one Prometheus exposition, so they
// are taken in one GET. Reading the endpoint twice would cost two round trips per group per attempt
// and, worse, would let the two facts come from different launches -- a restart between the reads
// and the queue depth belongs to a process the launch identity does not name.
//
// THE PLACEMENT THIS REPLACES DECIDED ON IGNORANCE. The harness walked its roster and took the first
// group that granted a seat; nothing in that path could see that a group was already serving a
// stream. A compare-and-set stood behind it, so the damage was bounded to the seat ceiling, but the
// decision itself was made blind.

fn harness_metrics_url(endpoint: ServingRouteEndpoint) -> String {
  harness_endpoint_url(endpoint: endpoint, path: "/metrics")
}

// A PROMETHEUS LINE IS `name{labels} value` FOR THE APPLICATION GAUGES AND `name value` FOR THE
// PROCESS COLLECTOR'S, so the two shapes are matched separately rather than by one loose pattern.
// The application gauges are found by their name followed by a brace, which is what stops a series
// whose name merely has ours as a prefix from answering for it.
// AN AMBIGUOUS SERIES IS UNREAD, NOT THE FIRST ONE. Taking the first line that matches is a silent
// pick: a body serving two models exports one gauge per label set, and the first is whichever the
// exporter happened to render first. The reading here is a fleet-level count for ONE engine, so more
// than one matching line means the body is not the body this reader models -- and that is an
// obligation to model the label set, never a licence to choose (review 62155).
// AND A LABELLED MEMBER OF A FAMILY IS SELECTED BY ITS LABEL, THROUGH THE SAME READER. The
// capacity-reason queue renders one line per reason, so the name-plus-brace prefix matches several
// and the uniqueness check above would refuse the whole family. That is a narrower SELECTOR, not a
// second way to read a line: a copy of this body with one extra predicate would mean the exactly-one
// law, the value-field position and every future repair to Prometheus line reading were written
// twice, and a repair would land in one copy and silently not the other (DESIGN section 2).
type MetricLineSelector
  = SeriesByName
  | SeriesByNameAndLabel { pair: NonEmptyStr }

fn harness_metric_line_matches(line: String, prefix: String, selector: MetricLineSelector) -> Bool {
  if !starts_with(s: trim(s: line), prefix: prefix) {
    false
  } else {
    match selector {
      SeriesByName => true
      SeriesByNameAndLabel { pair: p } => string_contains(s: line, pattern: p as String)
    }
  }
}

fn harness_metric_line_value(body: String, prefix: String, selector: MetricLineSelector) -> String? {
  let lines = split(s: body, delimiter: "\n")
  let matching = filter(lines, l => harness_metric_line_matches(line: l, prefix: prefix, selector: selector))
  if length(matching) != 1 {
    none
  } else {
    match first(matching) {
      Absent => none
      Present { value: line } => {
        let parts = split(s: trim(s: line), delimiter: " ")
        if length(parts) < 2 { none } else { last(parts) }
      }
    }
  }
}

fn harness_gauge_value(body: String, metric: VllmServingMetric) -> String? {
  harness_metric_line_value(body: body, prefix: join([vllm_metric_name(m: metric) as String, "{"], ""), selector: SeriesByName)
}

// THE LABEL PAIR IS BUILT ONCE, HERE, from the label key and value rows the upstream module carries,
// so no consumer spells a Prometheus label rendering of its own.
fn harness_labelled_gauge_value(body: String, metric: VllmServingMetric, label: NonEmptyStr, value: NonEmptyStr) -> String? {
  harness_metric_line_value(
    body: body,
    prefix: join([vllm_metric_name(m: metric) as String, "{"], ""),
    selector: SeriesByNameAndLabel { pair: join([label as String, "=\"", value as String, "\""], "") as NonEmptyStr },
  )
}

// ── A POSITIVE FLOAT IS A COUNT, AND COLLAPSING IT TO ONE IS A WRONG ANSWER ───────────────────
//
// THE DEFECT THIS FIXES, BECAUSE IT SHIPPED. vLLM renders every gauge as a float, so an integer
// parse of `4.0` FAILS. The previous reading treated the failure as "some positive amount" and
// returned 1: waiting=4.0 read as 1, running=3.0 read as 1. Those values were then used as COUNTS.
// It is not lost precision -- it is a different number, arrived at silently, with the shape of an
// answer.
//
// SO AN INTEGRAL FLOAT IS PARSED EXACTLY AND EVERYTHING ELSE REFUSES. A count with a non-zero
// fractional part is not a count this reader can name, and an exponent rendering is not one either;
// both produce no reading rather than a plausible integer. A gauge that could not be read is not a
// gauge reading nothing.
fn harness_fraction_is_zero(text: String) -> Bool {
  match parse_int(s: text) {
    Absent => false
    Present { value: n } => n == 0
  }
}

fn harness_gauge_nat(n: Int) -> Nat? {
  if n < 0 {
    none
  } else {
    match checked_int_magnitude(a: n) {
      CheckedNatOverflow { cause: _ } => none
      CheckedNatReady { value: v } => Present { value: v }
    }
  }
}

fn harness_gauge_count(text: String) -> Nat? {
  let t = trim(s: text)
  match parse_int(s: t) {
    Present { value: n } => harness_gauge_nat(n: n)
    Absent => {
      let parts = split(s: t, delimiter: ".")
      if length(parts) != 2 {
        none
      } else {
        match first(parts) {
          Absent => none
          Present { value: whole } =>
            match last(parts) {
              Absent => none
              Present { value: frac } =>
                if !harness_fraction_is_zero(text: frac) {
                  none
                } else {
                  match parse_int(s: whole) {
                    Absent => none
                    Present { value: n } => harness_gauge_nat(n: n)
                  }
                }
            }
        }
      }
    }
  }
}

// BOTH GAUGES OR NEITHER. The admission rule needs waiting AND running: running says whether a
// decode is in flight now, waiting says whether one starts the moment the engine frees. A reading
// carrying one and defaulting the other is an observation half-invented, and the invented half is
// always the one that admits.
// THE ROUTE'S OWN ANSWER ABOUT WHETHER IT WILL TAKE MORE. A route that reports requests held back
// for scheduling capacity is refusing work right now, whatever a declared ceiling says; a route that
// reports none has said only that it is not refusing at this instant, which is why a ceiling still
// bounds admission above it. An absent family is UNREAD and refuses: a reader that treated a missing
// series as "no pressure" would turn the one present-tense signal the route gives into a silent yes.
fn harness_capacity_pressure_from_body(body: String) -> ServingCapacityPressure {
  match harness_labelled_gauge_value(body: body, metric: NumRequestsWaitingByReason, label: vllm_waiting_reason_label, value: vllm_waiting_reason_capacity) {
    Absent =>
      CapacityPressureUnread { obligation: "the served metrics carried no unique capacity-reason waiting series, so whether this route is holding requests back for scheduling capacity is unknown" as NonEmptyStr }
    Present { value: text } =>
      match harness_gauge_count(text: text) {
        Absent =>
          CapacityPressureUnread { obligation: join(["the capacity-reason waiting gauge value was not an exact count: ", text], "") as NonEmptyStr }
        Present { value: n } =>
          if n == 0 { RouteAdmittingMore } else { RouteHoldingForCapacity { held: n } }
      }
  }
}

fn harness_queue_from_body(body: String) -> ServingQueueReading {
  match harness_gauge_value(body: body, metric: NumRequestsWaiting) {
    Absent => QueueDepthUnread { obligation: "the served metrics carried no waiting-requests series" as NonEmptyStr }
    Present { value: waiting_text } =>
      match harness_gauge_value(body: body, metric: NumRequestsRunning) {
        Absent => QueueDepthUnread { obligation: "the served metrics carried no running-requests series" as NonEmptyStr }
        Present { value: running_text } =>
          match harness_gauge_count(text: waiting_text) {
            Absent => QueueDepthUnread { obligation: join(["the waiting-requests gauge value was not an exact count: ", waiting_text], "") as NonEmptyStr }
            Present { value: w } =>
              match harness_gauge_count(text: running_text) {
                Absent => QueueDepthUnread { obligation: join(["the running-requests gauge value was not an exact count: ", running_text], "") as NonEmptyStr }
                Present { value: r } => QueueDepthRead { waiting: w, running: r, pressure: harness_capacity_pressure_from_body(body: body) }
              }
          }
      }
  }
}

// THE LAUNCH DISCRIMINATOR IS CARRIED AS THE EXPORTED FIELD, BYTE FOR BYTE. Nothing here parses it
// into a time: the only operation on it is equality between two readings of one endpoint, and
// parsing would lose the discrimination between two launches inside one second while buying nothing.
fn harness_launch_from_body(group: FabricGroup, address: String, body: String) -> VllmEndpointProcessLaunchObservation {
  match harness_metric_line_value(body: body, prefix: join([prometheus_process_series_name(s: ProcessStartTimeSeconds) as String, " "], ""), selector: SeriesByName) {
    Absent =>
      LaunchUnobserved { group: group, obligation: "the served metrics carried no process start-time series, so which launch answered cannot be named and the group cannot be offered" as NonEmptyStr }
    Present { value: field } =>
      LaunchObserved {
        launch: vllm_endpoint_process_launch(group: group, endpoint: address as NonEmptyStr, process_start_field: trim(s: field) as NonEmptyStr),
        receipt: "gunbc.harness.metrics-probe" as ObservationReceiptRef,
      }
  }
}

type HarnessEngineReading {
  queue: ServingQueueReading
  launch: VllmEndpointProcessLaunchObservation
}

fn harness_observe_engine(endpoint: ServingRouteEndpoint) -> HarnessEngineReading {
  let url = harness_metrics_url(endpoint: endpoint)
  let group = endpoint.group
  let read = http.Client.Get(url: url as NonEmptyStr)
  if !read.success {
    HarnessEngineReading {
      queue: QueueDepthUnread { obligation: join(["the metrics endpoint at ", url, " did not answer"], "") as NonEmptyStr },
      launch: LaunchUnobserved { group: group, obligation: join(["the metrics endpoint at ", url, " did not answer, so which launch is serving is unknown"], "") as NonEmptyStr },
    }
  } else {
    HarnessEngineReading {
      queue: harness_queue_from_body(body: read.body),
      launch: harness_launch_from_body(group: group, address: serving_route_endpoint_wire(e: endpoint) as String, body: read.body),
    }
  }
}
