// THE REASONING WIRE SEAM. The harness used to import extdeps.deepseek.deepseek_v4 directly and name
// its kwargs, its end token and its reasoning field in twelve places, so "which model is served" and
// "how a turn asks for reasoning" were one fact spelled once, in the consumer. That is the fork this
// module removes, and repointing those twelve imports at a GLM module would have preserved it exactly
// -- the same fork under a new name.
//
// THE QUESTION THE HARNESS IS ENTITLED TO ASK IS "WHAT IS THIS SERVING UNIT'S REASONING WIRE", and
// the answer is dispatched here rather than inside either citation, because DESIGN section 3 places
// the dispatch that selects a realization at the periphery: a generic hub may not enumerate concrete
// products or dispatch among their authorities. Each arm below DELEGATES to its own upstream module
// and spells no protocol fact of its own.
//
// A UNIT IS A MODEL PLUS THE FLAGS IT IS SERVED UNDER, not a model, because the facts the harness
// needs are not all model facts. Whether reasoning arrives already split into reasoning_content or
// inline behind an end token is decided by whether the engine was launched with a reasoning parser
// for that family -- vLLM ships glm45 for GLM and, on this fleet's build, nothing for DeepSeek V4.
// Attributing that to the model would be authority substitution; attributing it to the unit is
// exactly right.
//
// A HOSTED UNIT IS A MODEL PLUS THE ROUTER IT IS REACHED THROUGH, by the same reasoning: whether reasoning
// comes back split, under which member, and which efforts are accepted are the router's facts about its
// listing (extdeps.openrouter.nvidia_nemotron_3_ultra_free), not the model's. How the harness PLACES a turn
// on each unit -- a fleet seat or a hosted quota lease -- is asked of harness_unit_placement below.
type HarnessServingUnit
  = DeepseekV4FlashOnVllm
  | Glm53FlashOnVllm
  | NemotronUltraFreeOnOpenRouter
  | Qwen3_8_27bOnNinfer
  | Qwen38FlashNextOnPoolFront
  | Qwen38FlashNextOnSrv1Card

// Compatibility is a catalog fact beside the unit, not model-id equality.
// A pair is fungible only when it is the same unit or an explicit row that
// names the same model AND the same request wire/parser. Qwen3_8_27bOnNinfer
// has no vLLM sibling: ninfer kwargs, parser none, operator placement. A
// vLLM Qwen unit would be a different wire, so no pair is admitted.
type HarnessServingUnitFungibilityPair {
  left: HarnessServingUnit
  right: HarnessServingUnit
}

data harness_serving_unit_fungible_pairs: List<HarnessServingUnitFungibilityPair> = []

type HarnessServingUnitCompatibility
  = HarnessUnitsIdentical
  | HarnessUnitsCatalogFungible
  | HarnessUnitsIncompatible { required: HarnessServingUnit, observed: HarnessServingUnit }

fn harness_serving_unit_eq(left: HarnessServingUnit, right: HarnessServingUnit) -> Bool {
  match left {
    DeepseekV4FlashOnVllm =>
      match right { DeepseekV4FlashOnVllm => true  Glm53FlashOnVllm => false  NemotronUltraFreeOnOpenRouter => false  Qwen3_8_27bOnNinfer => false  Qwen38FlashNextOnPoolFront => false  Qwen38FlashNextOnSrv1Card => false }
    Glm53FlashOnVllm =>
      match right { Glm53FlashOnVllm => true  DeepseekV4FlashOnVllm => false  NemotronUltraFreeOnOpenRouter => false  Qwen3_8_27bOnNinfer => false  Qwen38FlashNextOnPoolFront => false  Qwen38FlashNextOnSrv1Card => false }
    NemotronUltraFreeOnOpenRouter =>
      match right { NemotronUltraFreeOnOpenRouter => true  DeepseekV4FlashOnVllm => false  Glm53FlashOnVllm => false  Qwen3_8_27bOnNinfer => false  Qwen38FlashNextOnPoolFront => false  Qwen38FlashNextOnSrv1Card => false }
    Qwen3_8_27bOnNinfer =>
      match right { Qwen3_8_27bOnNinfer => true  DeepseekV4FlashOnVllm => false  Glm53FlashOnVllm => false  NemotronUltraFreeOnOpenRouter => false  Qwen38FlashNextOnPoolFront => false  Qwen38FlashNextOnSrv1Card => false }
    Qwen38FlashNextOnPoolFront =>
      match right { Qwen38FlashNextOnPoolFront => true  Qwen38FlashNextOnSrv1Card => false  DeepseekV4FlashOnVllm => false  Glm53FlashOnVllm => false  NemotronUltraFreeOnOpenRouter => false  Qwen3_8_27bOnNinfer => false }
    Qwen38FlashNextOnSrv1Card =>
      match right { Qwen38FlashNextOnSrv1Card => true  DeepseekV4FlashOnVllm => false  Glm53FlashOnVllm => false  NemotronUltraFreeOnOpenRouter => false  Qwen3_8_27bOnNinfer => false  Qwen38FlashNextOnPoolFront => false }
  }
}

fn harness_serving_unit_pair_matches(
  pair: HarnessServingUnitFungibilityPair,
  required: HarnessServingUnit,
  observed: HarnessServingUnit,
) -> Bool {
  (harness_serving_unit_eq(left: pair.left, right: required)
    && harness_serving_unit_eq(left: pair.right, right: observed))
    || (harness_serving_unit_eq(left: pair.left, right: observed)
      && harness_serving_unit_eq(left: pair.right, right: required))
}

fn harness_serving_unit_compatibility(
  required: HarnessServingUnit,
  observed: HarnessServingUnit,
) -> HarnessServingUnitCompatibility {
  if harness_serving_unit_eq(left: required, right: observed) {
    HarnessUnitsIdentical
  } else {
    if any(harness_serving_unit_fungible_pairs, p =>
      harness_serving_unit_pair_matches(pair: p, required: required, observed: observed)
    ) {
      HarnessUnitsCatalogFungible
    } else {
      HarnessUnitsIncompatible { required: required, observed: observed }
    }
  }
}

fn harness_serving_unit_wire(unit: HarnessServingUnit) -> NonEmptyStr {
  match unit {
    DeepseekV4FlashOnVllm => "deepseek-v4-flash on vllm" as NonEmptyStr
    Glm53FlashOnVllm => "glm-5.3-flash on vllm" as NonEmptyStr
    NemotronUltraFreeOnOpenRouter => "nemotron-3-ultra:free on openrouter" as NonEmptyStr
    Qwen3_8_27bOnNinfer => "qwen3.8-27b on ninfer" as NonEmptyStr
    Qwen38FlashNextOnPoolFront => "qwen3.8-flash-next on pool front" as NonEmptyStr
    Qwen38FlashNextOnSrv1Card => "qwen3.8-flash-next on the srv1 card" as NonEmptyStr
  }
}

// HOW A TURN ON THIS UNIT IS ADMITTED. A fleet unit is served by an engine this repository launches, so a
// turn takes a seat on a serving group (gunbc.harness.harness_seat harness_bind_seat). A hosted unit has no
// group, no replica and no loaded state to share: what bounds it is the upstream's per-request quota, so a
// turn leases that quota (gunbc.fabric.fabric_quota) before each request instead. The two are different capacity
// facts, which is why this is a closed choice and not a flag.
type HarnessUnitPlacement
  = PlacedOnFleetSeat
  | LeasedFromHostedQuota
  | RunOnOperatorEndpoint

fn harness_unit_placement(unit: HarnessServingUnit) -> HarnessUnitPlacement {
  match unit {
    DeepseekV4FlashOnVllm => PlacedOnFleetSeat
    Glm53FlashOnVllm => PlacedOnFleetSeat
    NemotronUltraFreeOnOpenRouter => LeasedFromHostedQuota
    Qwen3_8_27bOnNinfer => RunOnOperatorEndpoint
    Qwen38FlashNextOnPoolFront => RunOnOperatorEndpoint
    Qwen38FlashNextOnSrv1Card => RunOnOperatorEndpoint
  }
}

// THE LEVEL IS THE HARNESS'S OWN VOCABULARY, AND IT IS DELIBERATELY NOT EITHER MODEL'S. DeepSeek
// names non-think / high / max; GLM names low / high / max and has no off at all. A shared type that
// spelled one vendor's arms would make the other's wire a translation of a nickname, so the arms here
// are the harness's three intents -- do not reason, reason ordinarily, reason as hard as you can --
// and each unit's arm below is responsible for expressing or REFUSING each one.
type HarnessReasoningLevel
  = ReasoningOff
  | ReasoningStandard
  | ReasoningMaximum

fn harness_reasoning_level_wire(level: HarnessReasoningLevel) -> NonEmptyStr {
  match level {
    ReasoningOff => "off" as NonEmptyStr
    ReasoningStandard => "standard" as NonEmptyStr
    ReasoningMaximum => "maximum" as NonEmptyStr
  }
}

// A LEVEL A UNIT CANNOT EXPRESS IS REFUSED, NOT APPROXIMATED. GLM-5.3-Flash's generation prompt opens
// the think block unconditionally and its effort key defaults to max when absent, so there is no
// request this harness can send that turns reasoning off. Silently sending the model's floor instead
// would be the fabricated plausible output DESIGN section 5 forbids: the caller asked for no
// reasoning, would be billed for the deepest available, and nothing on the wire would say so.
type HarnessReasoningKwargs
  = ReasoningKwargsAdmitted { kwargs: List<JsonKeyValue> }
  | ReasoningLevelUnsupported { unit: NonEmptyStr, level: NonEmptyStr, cause: NonEmptyStr }

// THE DEEPSEEK ARM, unchanged in behaviour from the harness's former inline spelling and moved here
// whole. Non-think sends nothing, because on vLLM the ABSENCE of the switch is the non-think mode.
// Think High sends the thinking switch alone: the canonical encoder carries a preamble string only
// for "max", "high" is the thinking mode's own default, and measured on the live artifact an effort
// key of "high" renders nothing. Only Think Max carries the effort key.
fn harness_deepseek_reasoning_kwargs(level: HarnessReasoningLevel) -> HarnessReasoningKwargs {
  match level {
    ReasoningOff => ReasoningKwargsAdmitted { kwargs: [] }
    ReasoningStandard =>
      ReasoningKwargsAdmitted { kwargs: [json_kv(key: "chat_template_kwargs", value: json_object([
        json_kv(key: deepseek_v4_vllm_thinking_kwarg as String, value: JsonBool { value: true }),
      ]))] }
    ReasoningMaximum =>
      ReasoningKwargsAdmitted { kwargs: [json_kv(key: "chat_template_kwargs", value: json_object([
        json_kv(key: deepseek_v4_vllm_thinking_kwarg as String, value: JsonBool { value: true }),
        json_kv(key: deepseek_v4_vllm_reasoning_effort_kwarg as String,
                value: json_string(s: deepseek_v4_reasoning_mode_wire(mode: DeepseekV4ThinkMax) as String)),
      ]))] }
  }
}

// THE GLM ARM, AND IT IS NOT THE DEEPSEEK ARM WITH A DIFFERENT STRING IN IT. Three differences, each
// of which would have been a silent defect had the import simply been repointed:
//
//   - THE EFFORT KEY IS ALWAYS SENT, INCLUDING AT THE STANDARD LEVEL. On DeepSeek, omitting the
//     effort means "the thinking mode's default"; on GLM, omitting it means MAX. So the arm that
//     sends nothing extra is the one that costs the most, and expressing "reason ordinarily" REQUIRES
//     naming "high" explicitly.
//   - THERE IS NO THINKING BOOLEAN. GLM's chat template carries no `thinking` key; sending DeepSeek's
//     would be an unrecognised kwarg, and unrecognised effort values on this model resolve to max
//     without an error, so a mistake here is invisible on the wire.
//   - CLEAR_THINKING IS SENT FALSE, EXPLICITLY, AND THAT IS THE TEMPLATE'S OWN DEFAULT. It is spelled
//     rather than omitted because this is a TOOL-USING loop: the model card recommends true for chat
//     scenarios, and a future caller reading an absent key cannot tell a considered default from an
//     oversight. Prior turns' reasoning must stay in context, and this row is the harness saying so.
fn harness_glm_reasoning_kwargs(level: HarnessReasoningLevel) -> HarnessReasoningKwargs {
  match level {
    ReasoningOff => ReasoningLevelUnsupported {
      unit: harness_serving_unit_wire(unit: Glm53FlashOnVllm),
      level: harness_reasoning_level_wire(level: ReasoningOff),
      cause: "GLM-5.3-Flash reasons unconditionally: its generation prompt opens the think block and reasoning_effort defaults to max when the key is absent, so no request turns reasoning off. Its floor is the low effort, which is a reduction and not a disable; sending it under the name of off would answer a question the model cannot be asked" as NonEmptyStr,
    }
    ReasoningStandard =>
      ReasoningKwargsAdmitted { kwargs: [json_kv(key: "chat_template_kwargs", value: json_object([
        json_kv(key: glm_5_3_flash_reasoning_effort_kwarg as String,
                value: json_string(s: glm_5_3_flash_reasoning_effort_wire(effort: GlmEffortHigh) as String)),
        json_kv(key: glm_5_3_flash_clear_thinking_kwarg as String, value: JsonBool { value: false }),
      ]))] }
    ReasoningMaximum =>
      ReasoningKwargsAdmitted { kwargs: [json_kv(key: "chat_template_kwargs", value: json_object([
        json_kv(key: glm_5_3_flash_reasoning_effort_kwarg as String,
                value: json_string(s: glm_5_3_flash_reasoning_effort_wire(effort: GlmEffortMax) as String)),
        json_kv(key: glm_5_3_flash_clear_thinking_kwarg as String, value: JsonBool { value: false }),
      ]))] }
  }
}

// THE OPENROUTER ARM, AND ITS WIRE IS THE ROUTER'S, NOT THE MODEL'S. The request carries OpenRouter's
// top-level `reasoning` object, never Nemotron's chat_template_kwargs: the router owns the translation to
// the provider, and a client spelling the model's template keys past it would be addressing a template
// it cannot see.
//
// EACH LEVEL IS MAPPED TO AN EFFORT AND THE EFFORT IS ADMITTED AGAINST THE LISTING'S PUBLISHED SET, so
// what this arm may send is decided by the listing's row and never by this function. Standard is medium
// and maximum is high, because those are the two efforts the listing accepts and that is their order;
// off is `enabled: false`, which the listing admits because its reasoning is not mandatory. A listing
// whose set lacks the mapped effort, or whose reasoning is mandatory, refuses the level with both names.
fn harness_openrouter_level_effort(level: HarnessReasoningLevel) -> OpenRouterReasoningEffort? {
  match level {
    ReasoningOff => none
    ReasoningStandard => Present { value: EffortMedium }
    ReasoningMaximum => Present { value: EffortHigh }
  }
}

fn harness_openrouter_reasoning_kwargs(unit: HarnessServingUnit, level: HarnessReasoningLevel, supported: List<OpenRouterReasoningEffort>, mandatory: Bool) -> HarnessReasoningKwargs {
  match harness_openrouter_level_effort(level: level) {
    Absent =>
      if mandatory {
        ReasoningLevelUnsupported {
          unit: harness_serving_unit_wire(unit: unit),
          level: harness_reasoning_level_wire(level: level),
          cause: "the listing marks reasoning mandatory, so a request with reasoning disabled is not one it admits" as NonEmptyStr,
        }
      } else {
        ReasoningKwargsAdmitted { kwargs: [json_kv(key: "reasoning", value: json_object([
          json_kv(key: "enabled", value: JsonBool { value: false }),
        ]))] }
      }
    Present { value: effort } =>
      match openrouter_effort_admitted(effort: effort, supported: supported) {
        EffortNotSupported { effort: e, supported: _ } => ReasoningLevelUnsupported {
          unit: harness_serving_unit_wire(unit: unit),
          level: harness_reasoning_level_wire(level: level),
          cause: join([
            "the level maps to reasoning effort ", openrouter_reasoning_effort_wire(e: e) as String,
            ", which the listing's supported_efforts do not include; an unsupported effort is translated by the router to a setting the caller never sees, so it is refused rather than sent",
          ], "") as NonEmptyStr,
        }
        EffortAdmitted { effort: e } =>
          ReasoningKwargsAdmitted { kwargs: [json_kv(key: "reasoning", value: json_object([
            json_kv(key: "effort", value: json_string(s: openrouter_reasoning_effort_wire(e: e) as String)),
          ]))] }
      }
  }
}

// NINFER'S REASONING IS ON BY DEFAULT AND NO PER-REQUEST SWITCH HAS BEEN READ. Standard and Maximum therefore
// send nothing (the server's default is the thinking mode they ask for), and Off is REFUSED: the only
// readings of turning it off are launch flags (--no-thinking), which a request cannot set, so sending
// nothing would bill the deepest reasoning for a caller who asked for none (DESIGN 5).
fn harness_ninfer_reasoning_kwargs(unit: HarnessServingUnit, level: HarnessReasoningLevel) -> HarnessReasoningKwargs {
  match level {
    ReasoningOff => ReasoningLevelUnsupported {
      unit: harness_serving_unit_wire(unit: unit),
      level: harness_reasoning_level_wire(level: level),
      cause: "thinking is on server-side by default and only the launch flag --no-thinking is known to turn it off; no per-request switch has been read" as NonEmptyStr,
    }
    ReasoningStandard => ReasoningKwargsAdmitted { kwargs: [] }
    ReasoningMaximum => ReasoningKwargsAdmitted { kwargs: [] }
  }
}

// THE POOL FRONT'S REASONING SWITCH HAS NOT BEEN READ. extdeps.pool.pool_front states an OpenAI-compatible
// surface and says nothing about a per-request thinking switch, so off is REFUSED rather than sent as an
// unread kwarg, and standard/maximum send nothing (DESIGN 5; the same stance the ninfer unit takes for the
// same missing fact, held separately because it is a different upstream).
fn harness_pool_front_reasoning_kwargs(unit: HarnessServingUnit, level: HarnessReasoningLevel) -> HarnessReasoningKwargs {
  match level {
    ReasoningOff => ReasoningLevelUnsupported {
      unit: harness_serving_unit_wire(unit: unit),
      level: harness_reasoning_level_wire(level: level),
      cause: "no per-request thinking switch has been read from the pool front's contract" as NonEmptyStr,
    }
    ReasoningStandard => ReasoningKwargsAdmitted { kwargs: [] }
    ReasoningMaximum => ReasoningKwargsAdmitted { kwargs: [] }
  }
}

// A BUDGET THE LAB CHOOSES, NOT A FACT THE UPSTREAM PROVED (DESIGN 4d). The pool operator's limits are its
// word (extdeps.pool.pool_front CitedFigure<Nat>, TranscribedUncited), so what the harness enforces is this
// policy: a declared value with the reason it was chosen. Once the upstream's own limit is read (cited or
// observed) the enforced budget is the smaller of the two; until then the policy alone is enforced.
type PoolBudgetPolicy {
  value: Nat
  reason: NonEmptyStr
}

fn pool_budget_enforced(policy: PoolBudgetPolicy, upstream: CitedFigure<Nat>) -> Nat {
  match cited_figure_read(figure: upstream) {
    Absent => policy.value
    Present { value: read } => if read < policy.value { read } else { policy.value }
  }
}

data pool_output_budget_policy: PoolBudgetPolicy = PoolBudgetPolicy {
  value: 32768,
  reason: "the pool operator's directive (ctrl #2375) is at most 32k output per request; the lab adopts it as its own cap before any live reading, because exceeding it can only be refused" as NonEmptyStr,
}
data pool_context_budget_policy: PoolBudgetPolicy = PoolBudgetPolicy {
  value: 262144,
  reason: "the pool operator's stated maximum context (ctrl #2375); the lab adopts it as its own ceiling before any live reading, so a turn over it refuses locally instead of being sent" as NonEmptyStr,
}

// THE LARGEST OUTPUT BUDGET A REQUEST MAY ASK. Absent where no upstream states one; the pool unit is capped by
// pool_output_budget_policy, so a request budget above it is capped by harness_capped_max_tokens, never sent.
fn harness_unit_output_cap(unit: HarnessServingUnit) -> Int? {
  match unit {
    Qwen38FlashNextOnPoolFront => Present { value: pool_budget_enforced(policy: pool_output_budget_policy, upstream: pool_front_max_output_tokens) as Int }
    Qwen38FlashNextOnSrv1Card => Present { value: pool_budget_enforced(policy: pool_output_budget_policy, upstream: pool_front_max_output_tokens) as Int }
    DeepseekV4FlashOnVllm => none
    Glm53FlashOnVllm => none
    NemotronUltraFreeOnOpenRouter => none
    Qwen3_8_27bOnNinfer => none
  }
}

fn harness_capped_max_tokens(unit: HarnessServingUnit, asked: Int) -> Int {
  match harness_unit_output_cap(unit: unit) {
    Absent => asked
    Present { value: cap } => if asked < cap { asked } else { cap }
  }
}

fn harness_reasoning_kwargs_for(unit: HarnessServingUnit, level: HarnessReasoningLevel) -> HarnessReasoningKwargs {
  match unit {
    DeepseekV4FlashOnVllm => harness_deepseek_reasoning_kwargs(level: level)
    Glm53FlashOnVllm => harness_glm_reasoning_kwargs(level: level)
    NemotronUltraFreeOnOpenRouter =>
      harness_openrouter_reasoning_kwargs(unit: unit, level: level, supported: nemotron_ultra_free_supported_efforts, mandatory: nemotron_ultra_free_reasoning_mandatory)
    Qwen3_8_27bOnNinfer => harness_ninfer_reasoning_kwargs(unit: unit, level: level)
    Qwen38FlashNextOnPoolFront => harness_pool_front_reasoning_kwargs(unit: unit, level: level)
    Qwen38FlashNextOnSrv1Card => harness_pool_front_reasoning_kwargs(unit: unit, level: level)
  }
}

// WHETHER THINKING WAS REQUESTED IS A PROPERTY OF THE PAIR, NOT OF THE LEVEL, which is precisely what
// the former harness-local predicate could not express: it read the level alone and answered false
// for off. On GLM that answer is wrong at every level, because the model reasons whether or not the
// request says so -- and the completion-format check downstream depends on this, so a level-only
// answer would have let a GLM completion with no reasoning at all pass unexamined.
fn harness_unit_thinking_requested(unit: HarnessServingUnit, level: HarnessReasoningLevel) -> Bool {
  match unit {
    Glm53FlashOnVllm => true
    DeepseekV4FlashOnVllm =>
      match level {
        ReasoningOff => false
        ReasoningStandard => true
        ReasoningMaximum => true
      }
    NemotronUltraFreeOnOpenRouter =>
      match level {
        ReasoningOff => false
        ReasoningStandard => true
        ReasoningMaximum => true
      }
    Qwen3_8_27bOnNinfer =>
      match level {
        ReasoningOff => false
        ReasoningStandard => true
        ReasoningMaximum => true
      }
    Qwen38FlashNextOnPoolFront =>
      match level {
        ReasoningOff => false
        ReasoningStandard => true
        ReasoningMaximum => true
      }
    Qwen38FlashNextOnSrv1Card =>
      match level {
        ReasoningOff => false
        ReasoningStandard => true
        ReasoningMaximum => true
      }
  }
}

// THE POOL ARM ASKS FOR ANY CARD (operator direction 2026-10-26: use the slop pool generously). The front
// places "slop" on whichever card is free; the unit's wire facts (reasoning member, tool-call parser) are the
// card model's, so the alias is admitted only while every card the front lists is that model
// (gunbc.harness.harness_operator_route operator_route_standing), and a front that adds another family refuses
// rather than being misparsed.
// THE MODEL IDENTITY, ONCE. This is the seam's answer to "what do I put in the request's model
// field", and each arm delegates to its own upstream authority rather than spelling a string here.
fn harness_unit_model_id(unit: HarnessServingUnit) -> NonEmptyStr {
  match unit {
    DeepseekV4FlashOnVllm => "deepseek-v4-flash:iq3s-split" as NonEmptyStr
    Glm53FlashOnVllm => glm_5_3_flash_model_id
    NemotronUltraFreeOnOpenRouter => nemotron_ultra_free_model_id
    Qwen3_8_27bOnNinfer => operator_pod_ninfer_launch.model_id
    Qwen38FlashNextOnPoolFront => pool_front_any_card_model_id
    Qwen38FlashNextOnSrv1Card => pool_card_qwen38_flash_next_model_id
  }
}

// THE ENGINE'S TOOL-CALL PARSER FOR THIS UNIT, delegated for the same reason. The DeepSeek arm keeps
// the string because extdeps.deepseek.deepseek_v4 carries no parser row; that asymmetry is the
// DeepSeek module's gap, named here rather than papered over with a second GLM-shaped row.
// A HOSTED UNIT HAS NO ENGINE THIS REPOSITORY LAUNCHES, so there is no parser for it to name: the
// router's provider parses tool calls and returns them already structured. The answer is absent rather
// than a borrowed name, because a launch reading a name here would launch a parser nobody chose.
fn harness_unit_tool_call_parser(unit: HarnessServingUnit) -> NonEmptyStr? {
  match unit {
    DeepseekV4FlashOnVllm => Present { value: "deepseek_v4" as NonEmptyStr }
    Glm53FlashOnVllm => Present { value: glm_5_3_flash_vllm_tool_call_parser }
    NemotronUltraFreeOnOpenRouter => none
    Qwen3_8_27bOnNinfer => none
    Qwen38FlashNextOnPoolFront => none
    Qwen38FlashNextOnSrv1Card => none
  }
}

// THE FIELD PRIOR REASONING RIDES ON, and its alias where the engine exposes a second spelling.
// Both models use the DeepSeek-originated reasoning_content on the chat-completions shape; vLLM
// additionally exposes "reasoning". The alias is empty where a unit has none, so a consumer folds a
// list rather than branching on a sentinel.
// THE FIELD NAME COMES FROM THE RUNTIME THAT EMITS IT, AND THIS SEAM ASKED TWO MODEL AUTHORITIES FOR
// IT INSTEAD. Which member carries the split reasoning is decided by the ENGINE BUILD -- by whether it
// was launched with a reasoning parser and by what that parser names its output -- so it is a runtime
// fact in exactly the sense this module's own header describes, and gunbc.spark.serving_arm already
// owns it as ReasoningResponseProjection on the runtime row, measured inside each pinned image.
//
// THE GLM ARM PREVIOUSLY CITED DEEPSEEK'S ALIAS ROW, which is one model authority answering for
// another model's wire, green only because the two values coincide. The repair attempted first was to
// give GLM its own alias row in extdeps.zhipu -- which is the SAME defect relocated, because the
// annotation over ReasoningResponseProjection had already established that the model authority's name
// is not this unit's primary. A third spelling of a fact the runtime row measured would have been the
// fork this branch exists to remove, introduced by the commit removing it.
//
// SO BOTH ANSWERS ARE DERIVED FROM THE PROJECTION. A parsed unit's primary is the member the engine
// actually emits; an inline unit has no member at all, and the harness must split client-side on the
// end token, so the list is empty rather than carrying a name that will never appear. The model
// authorities keep their rows -- `reasoning_content` IS what Zhipu's and DeepSeek's own APIs return --
// and they are simply not what this fleet's engines emit.
// THE PROJECTION IS OPTIONAL AT ITS SOURCE, SO IT IS OPTIONAL HERE. ServingRuntimeRow carries
// reasoning_projection as ReasoningResponseProjection? because a runtime that has never served cannot
// say how its reasoning comes back. This function used to declare the bare type and hand back the
// row's field directly, which only looked right while every row it reads happened to carry one.
fn harness_unit_reasoning_projection(unit: HarnessServingUnit) -> ReasoningResponseProjection? {
  match unit {
    DeepseekV4FlashOnVllm => gunbc_sparkrun_ds4_row.reasoning_projection
    Glm53FlashOnVllm => gitcommit90_sm121_exl3_row.reasoning_projection
    NemotronUltraFreeOnOpenRouter => Present { value: ParsedReasoningField { field: openrouter_message_reasoning_field } }
    Qwen3_8_27bOnNinfer => Present { value: ParsedReasoningField { field: ninfer_message_reasoning_field } }
    Qwen38FlashNextOnPoolFront =>
      match cited_figure_read(figure: pool_front_message_reasoning_field) {
        Present { value: f } => Present { value: ParsedReasoningField { field: f } }
        Absent => none
      }
    Qwen38FlashNextOnSrv1Card =>
      match cited_figure_read(figure: pool_front_message_reasoning_field) {
        Present { value: f } => Present { value: ParsedReasoningField { field: f } }
        Absent => none
      }
  }
}

// AN ABSENT PROJECTION TAKES THE SAME PLACEHOLDER AS AN INLINE ONE, AND THAT IS NOT AN OBSERVATION
// CLAIM. Neither arm has a field name on the wire to report: an inline unit emits none, and an
// unprobed runtime has told us nothing. Naming the model's own field keeps this function total
// without minting a sentinel every caller would have to branch on, exactly as the inline arm already
// does -- it does not assert that the runtime answers under that name.
//
// THE ABSENT ARM IS REACHABLE: the pool-front unit's reasoning field is an uncited figure and answers none until
// the lab qualification reads it. It also keeps a unit whose runtime has never served from silently unwrapping
// into a fabricated name, which is what the previous bare-typed signature would have done.
fn harness_unit_reasoning_field(unit: HarnessServingUnit) -> NonEmptyStr? {
  match harness_unit_reasoning_projection(unit: unit) {
    Absent => harness_unit_model_reasoning_field(unit: unit)
    Present { value: ParsedReasoningField { field: f } } => Present { value: f }
    Present { value: InlineReasoning { end_token: _ } } => harness_unit_model_reasoning_field(unit: unit)
  }
}

// WHAT AN INLINE UNIT ANSWERS, AND WHY IT IS THE MODEL'S NAME RATHER THAN A REFUSAL. Nothing on the
// wire carries reasoning for such a unit, so any name is unused by the decoder; naming the model's own
// field keeps the answer meaningful if that unit is later relaunched WITH a parser, and keeps this
// function total without inventing a sentinel the caller would have to branch on.
fn harness_unit_model_reasoning_field(unit: HarnessServingUnit) -> NonEmptyStr? {
  match unit {
    DeepseekV4FlashOnVllm => Present { value: deepseek_v4_chat_reasoning_field }
    Glm53FlashOnVllm => Present { value: glm_5_3_flash_chat_reasoning_field }
    NemotronUltraFreeOnOpenRouter => Present { value: openrouter_message_reasoning_field }
    Qwen3_8_27bOnNinfer => Present { value: ninfer_message_reasoning_field }
    Qwen38FlashNextOnPoolFront => cited_figure_read(figure: pool_front_message_reasoning_field)
    Qwen38FlashNextOnSrv1Card => cited_figure_read(figure: pool_front_message_reasoning_field)
  }
}

// THE ALIASES ARE THE OTHER NAMES A READER SHOULD TRY, and for a parsed unit that is the model
// authority's own spelling -- the one the vendor's hosted API returns, which a future engine build
// may well switch to. For an inline unit there is no member to alias.
// AN ABSENT PROJECTION OFFERS NO ALIASES, for the same reason an inline one does not: there is no
// second name to try on a wire that carries no reasoning member. This arm was not part of the review
// that found the other two; it is here because the same widening reached three consumers and only two
// were named.
fn harness_unit_reasoning_field_aliases(unit: HarnessServingUnit) -> List<NonEmptyStr> {
  match harness_unit_reasoning_projection(unit: unit) {
    Absent => [] as List<NonEmptyStr>
    Present { value: ParsedReasoningField { field: _ } } =>
      match harness_unit_model_reasoning_field(unit: unit) {
        Present { value: f } => [f]
        Absent => [] as List<NonEmptyStr>
      }
    Present { value: InlineReasoning { end_token: _ } } => [] as List<NonEmptyStr>
  }
}

// WHETHER THE ENGINE SPLITS REASONING SERVER-SIDE, AND THIS IS A FACT ABOUT THE PINNED IMAGE RATHER
// THAN ABOUT UPSTREAM vLLM. The distinction is the whole reason this answer is per UNIT and not per
// model, and an earlier revision of this row got it wrong in exactly the way the seam exists to
// prevent.
//
// WHAT WAS ASSERTED AND WHY IT WAS WRONG. This row read `Glm53FlashOnVllm => true`, citing the vLLM
// recipe's `--reasoning-parser glm45`. The recipe is correct about CURRENT upstream vLLM; the fleet
// does not run current upstream vLLM. Measured on the running container of the serving head
// (image sparkrun_vllm_ds4_gb10, vLLM 0.21.1rc1.dev339+g1967a5627bc3): `vllm/reasoning/` holds
// twenty parser modules and NOT ONE of them is GLM, and a find for any GLM-named file on a reasoning
// path returns nothing. So on this image `--reasoning-parser glm45` names a parser that is not there.
//
// THE INSTRUMENT IS FILE PRESENCE, AND IT IS CONTROL-VERIFIED. A registry introspection was tried
// first and DISCARDED as invalid: it reported zero tool parsers and zero reasoning parsers, including
// `deepseek_v4`, which this very engine is serving with at that moment -- the registries populate
// lazily, so an empty reading is not an absence. File presence tracks availability in the direction
// that matters, checked against that same control: `deepseekv4_tool_parser.py` is present and
// `deepseek_v4` is in the live serve line.
//
// TOOL CALLING IS AVAILABLE; REASONING SPLITTING IS NOT. `glm47_moe_tool_parser.py` IS present in
// `vllm/tool_parsers/`, so the tool-call half of the GLM serve line has its parser. Only the
// reasoning half is missing, which is why this is a one-value correction rather than a verdict that
// the image cannot serve the model.
//
// THE GLM ROW WAS FALSE AND THE RUNNING CANARY FALSIFIED IT, 2026-09-08. Everything above is a
// measurement of the PINNED DEEPSEEK IMAGE, and the conclusion was carried across to a unit that does
// not run on that image. The canary runs the community SM121 runtime, whose serve line the live engine
// echoes back as `reasoning_parser: glm45` inside its own StructuredOutputsConfig -- so this unit's
// server DOES split reasoning, and the row said it did not. That is the same fault the checkpoint's
// attention row carried: a fact established about one artifact, asserted about another.
//
// THE EVIDENCE IS A PARSED COMPLETION, NOT A FILE LISTING, which matters because the previous row was
// inferred from `ls` over a parser directory. Asked a question that forces deliberation, the canary
// returns the reasoning SPLIT OUT under its own key -- 539 characters of it -- with the answer alone
// in `content`. The server is parsing, and this row now says so.
//
// FOUR EARLIER MEASUREMENTS SAID THE OPPOSITE AND EVERY ONE OF THEM WAS READING THE WRONG KEY. This
// engine returns `reasoning`; it returns no `reasoning_content` at all. Reading the canonical name got
// zero four times running, which was very nearly recorded here as "the server does not surface
// reasoning" -- a conclusion drawn from an absent field rather than from an observed one. The alias is
// now a measured row on the model's own authority
// (extdeps.zhipu.glm_5_3_flash glm_5_3_flash_chat_reasoning_field_vllm_alias) instead of being
// borrowed from DeepSeek's, which is what let the mistake stand: the borrowed value was correct, so
// nothing failed, and the seam looked settled while the fact underneath it was unowned.
//
// THE HAZARD THIS SEAM MUST NOT HIDE is what a TRUNCATED thinking block does. Capped at 1500 tokens
// the same question returned finish_reason `length` with BOTH fields null -- the reasoning block's end
// token never arrived, so there was no completed reasoning for one field and no speech for the other.
// That is a well-formed 200 carrying no text anywhere, which a consumer checking only for an HTTP
// error reads as an empty answer instead of as a truncation. It is named rather than modelled because
// the honest fix is the token budget, and the seam's job is to say WHICH FIELD to read, not to invent
// content when neither is populated.
fn harness_unit_server_parses_reasoning(unit: HarnessServingUnit) -> Bool {
  match unit {
    DeepseekV4FlashOnVllm => false
    Glm53FlashOnVllm => true
    NemotronUltraFreeOnOpenRouter => true
    Qwen3_8_27bOnNinfer => true
    // Not read from the front (the reasoning figures are uncited), so no parse is claimed.
    Qwen38FlashNextOnPoolFront => false
    Qwen38FlashNextOnSrv1Card => false
  }
}

// THE INLINE CLOSER, for the client-side split the unit above still needs. Carried even where the
// server parses, because a parser can be absent from a rebuilt engine and the token is the model's
// either way.
fn harness_unit_thinking_end_token(unit: HarnessServingUnit) -> NonEmptyStr? {
  match unit {
    DeepseekV4FlashOnVllm => Present { value: deepseek_v4_thinking_end_token }
    Glm53FlashOnVllm => Present { value: glm_5_3_flash_thinking_end_token }
    NemotronUltraFreeOnOpenRouter => Present { value: nemotron_ultra_thinking_end_token }
    Qwen3_8_27bOnNinfer => Present { value: ninfer_inline_think_end_token.token }
    Qwen38FlashNextOnPoolFront => cited_figure_read(figure: pool_front_thinking_end_token)
    Qwen38FlashNextOnSrv1Card => cited_figure_read(figure: pool_front_thinking_end_token)
  }
}

// THE MODEL'S DECLARED WINDOW. A CEILING, and the seam says so by name: neither arm's figure is a
// measurement of a deployment, and neither may be read as one.
fn harness_unit_declared_context_ceiling(unit: HarnessServingUnit) -> TokenCount {
  match unit {
    DeepseekV4FlashOnVllm => deepseek_v4_context_length
    Glm53FlashOnVllm => glm_5_3_flash_context_length
    NemotronUltraFreeOnOpenRouter => nemotron_ultra_free_context_length
    Qwen3_8_27bOnNinfer => qwen3_8_27b_nvfp4_row.context_tokens
    Qwen38FlashNextOnPoolFront => token_count(count: pool_budget_enforced(policy: pool_context_budget_policy, upstream: pool_front_max_context_tokens))
    Qwen38FlashNextOnSrv1Card => token_count(count: pool_budget_enforced(policy: pool_context_budget_policy, upstream: pool_front_max_context_tokens))
  }
}
