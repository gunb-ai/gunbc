module gunbc.claude_code_credential

import std.types { String, List, NonEmptyStr }
import v2.std.optional { Present, Absent }
import extdeps.cloud.gcp.secret_ref { SecretRef }
import gunbc.secret_provision { fleet_secret_ref, secret_ref_pin_version }
import extdeps.llm.claude_setup_token_cli { claude_code_oauth_token_env_var }
import extdeps.exec.command { ArgvCommand }
import extdeps.posix.shell_command_language { admit_posix_shell_name, PosixShellNameAdmitted, PosixShellNameRefused }
import extdeps.posix.sh_invocation { posix_sh_export_from_file_then_exec_command }

// THE CLAUDE CODE SUBSCRIPTION CREDENTIAL ROSTER, ONE ROW TODAY (operator selection, 2026-10-05,
// relayed by swift-ibex-601). The credential is a `claude setup-token` OAuth token for a Claude
// Max subscription, enrolled by the operator out of band and stored as a Secret Manager secret in
// the fleet secrets project (gunbai-secrets, gunbc.auth.github_gcp_federation fleet_secrets_project_id
// -- ALL secrets live there). The secret id follows the operator-approved naming
// <upstream>[-<scope>]-<credential-kind>-<consumer>[-<account>]: claude-code-oauth-harness. The
// -<account> suffix is added only when a second account arrives, at which point this roster gains a
// row and each row's label keys its own limit standing (gunbc.claude_code_limit_standing), so an
// exhausted account is skipped rather than failing the turn. No account email is carried here; the
// label is the only identity the corpus holds.
//
// The operator's account roster with enable/rebalance lives in the ctrl session dashboard
// (api_key_slots), which stores the raw token in its own database and exposes no read surface; it
// stays the operator's surface and is NOT read from here (ruling, swift-ibex-601, 2026-10-05). The
// one fact the two share is the label set.
//
// The in-band enrollment producer (gunbc.claude_setup_token_enrollment) is not on this path: the
// token already exists, so nothing here runs `claude setup-token`.

data claude_code_harness_credential_label: NonEmptyStr = "harness"

data claude_code_oauth_harness_secret_ref: SecretRef = secret_ref_pin_version(
  ref: fleet_secret_ref(secret_id: "claude-code-oauth-harness"),
  version: "latest",
)

// WHERE THE TOKEN LIVES ON THE DISPATCH HOST. Reading Secret Manager on every dispatch would be a
// recurring automated privileged effect from the belt process; instead the token is delivered once
// per version by gunbc.host_credential_custody_converge (federated workload identity, accessor grant
// in gunbc.auth.fleet_secret_accessor_roster) to this srv1 path, owned root with the operator's
// group, 0640, under a 0750 directory -- the belt runs as the operator user (gunbc.live_deploy.emit
// live_deploy_serve_unit_file). The spawn reads only this local file.
data claude_code_oauth_harness_host_path: NonEmptyStr = "/etc/gunbc-claude-code/oauth-token-harness"

// THE TOKEN REACHES THE CLAUDE PROCESS AS AN ENVIRONMENT VARIABLE, NEVER AS AN ARGUMENT. Measured
// 2026-10-05 against claude 2.1.289: CLAUDE_CODE_OAUTH_TOKEN set to an invalid token overrides an
// authenticated ambient ~/.claude and the turn ends api_error_status 401, so the variable is honored
// and wins; CLAUDE_CODE_OAUTH_TOKEN_FILE_DESCRIPTOR pointed at an invalid token was IGNORED and the
// turn authenticated from the ambient credential, so it is not used. The dispatch argv is visible in
// the process table, so the token cannot ride it; the wrapper below reads the custody file in the
// pane's own shell and exports the value only into the exec'd child, whose environment is readable
// by its owner alone. The operation is POSIX sh's, so it is extdeps.posix.sh_invocation
// posix_sh_export_from_file_then_exec_*: a fixed script, the custody path as $0 and the provider
// argv as "$@", so neither is ever quoted into the script text.
type ClaudeCodeEnvWrapping
  = ClaudeCodeEnvWrapped { command: ArgvCommand }
  | ClaudeCodeEnvNameRefused { spelling: String }

// The variable name is admitted as a POSIX name before it reaches the script; a name the upstream
// row spells badly refuses here rather than becoming shell text.
fn claude_code_oauth_env_wrapped_command(token_path: NonEmptyStr, argv: List<String>) -> ClaudeCodeEnvWrapping {
  match admit_posix_shell_name(spelling: claude_code_oauth_token_env_var as String) {
    PosixShellNameAdmitted { name } =>
      ClaudeCodeEnvWrapped {
        command: posix_sh_export_from_file_then_exec_command(name: name, path: token_path, command: argv),
      }
    PosixShellNameRefused { spelling } => ClaudeCodeEnvNameRefused { spelling: spelling }
  }
}

// The custody path for a credential secret this roster names; a secret the roster does not name has
// no custody on any host, and the spawn refuses rather than guessing a path.
fn claude_code_custody_path(secret_ref: SecretRef) -> NonEmptyStr? {
  if secret_ref.secret == claude_code_oauth_harness_secret_ref.secret {
    Present { value: claude_code_oauth_harness_host_path }
  } else {
    none
  }
}

// THE STANDING TRIP: one headless turn under the credential, writing the stream-json wire
// (extdeps.llm.claude_code_stream_json). It is the cheapest call that makes the CLI report both
// facts selection needs -- whether the upstream accepts the token, and where each usage window of the
// subscription stands -- and it consumes a sliver of that same window, which is the price of reading
// it: the CLI exposes no usage read that is not a turn. --max-turns 1 bounds it to one model reply.
data claude_code_standing_trip_prompt: String = "Reply with the single word ok."
