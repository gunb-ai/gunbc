module gunbc.documentary_refs


data documentary_refs_note: String = "THE SYSTEMS A GENERATED DOCUMENT NAMES, CARRIED AS TYPED REFERENCES RATHER THAN SPELLED IN PROSE. gunbc.doc_graph_roots already does exactly this for HAND-AUTHORED documents: HandAuthoredDocBind carries primary_work plus additional_works as std.decl_ref.DeclarationRef rows, and v2.lens.cited_symbol_resolution resolves that population against live declaration facts and refuses a missing, ambiguous, or field-absent reference. Generated documents had no equivalent, so a system named inside gunbc.design_document existed only as characters inside a string literal -- unreachable by that lens and by every other structural reader.\n\nTHE MEASURED CONSEQUENCE, which is why this module exists rather than a wider one. The body-lowering paragraph named v2.std.symbol_index SymbolIndex as an open prerequisite. The prerequisite was discharged; the declaration existed the whole time; the sentence stayed. Nothing was wrong with the declaration, so no declaration-level check could fire, and the sentence was not a reference to anything, so no reference-level check could either. Four copies of that one claim were live across DESIGN.md and two plan documents.\n\nWHAT THIS DOES AND DOES NOT ESTABLISH, stated because the distinction is the whole scope of this change. A resolved reference proves the named system EXISTS and is uniquely identified -- so a rename, a deletion, or a fork into two same-named declarations reds through the required cited-symbol path without anyone editing the document. It does NOT prove a production relationship between the named systems: that a consumer actually invokes an implementation on a live path is a different claim, and a reference population cannot carry it. Where a document needs that stronger claim it cites an executing witness for that exact relationship. Reference resolution is the honest rung here, and claiming the stronger one from the weaker mechanism is what the earlier draft of this work did."

data generated_document_ref_rows_note: String = "ONE ROW PER SYSTEM THE GENERATED DESIGN DOCUMENT NAMES IN A MIGRATED PARAGRAPH, and the rendered bytes come from these rows rather than beside them. A row typed here while the paragraph independently spells the same name would be two representations of one fact, which is the shape this program exists to remove -- so the paragraph builds its symbol text by rendering the row, and a rename that moves the row moves the document."

data v1_maintenance_standing_ref: DeclarationRef = decl_ref(module_path: "gunbc.v1_maintenance_standing", decl_name: "v1_seed_standing")

fn documentary_ref_symbol_text(reference: DeclarationRef) -> String {
  concat("`", reference.module_path as String, " ", reference.decl_name as String, "`")
}

fn generated_document_declaration_refs() -> List<DeclarationRef> {
  [v1_maintenance_standing_ref]
}

data documentary_population_union_note: String = "ONE POPULATION, TWO SOURCES, AND THE UNION IS THE POINT. The cited-symbol lens already had a denominator; it counted hand-authored binds only, so a generated document could name a system that no longer existed and stay green while a hand-authored document naming the same system reddened. Widening the denominator rather than adding a second resolution algorithm keeps v2.std.decl_ref_resolution the single authority for what resolving a reference means -- a second algorithm agreeing today is a fork that disagrees later."

fn all_documentary_declaration_refs() -> List<std.decl_ref.DeclarationRef> {
  concat(gunbc.doc_graph_roots.hand_authored_doc_declaration_refs(), generated_document_declaration_refs())
}
