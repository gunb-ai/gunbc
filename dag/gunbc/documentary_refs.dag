module gunbc.documentary_refs

import std.types { String }
import std.decl_ref { DeclarationRef, decl_ref }
import std.markdown { MarkdownBlock, MarkdownListItem }
import gunbc.plans.md_helpers { h1, h2, h3, p, li_blocks, ul, ol, hr }

// THE SYSTEMS A GENERATED DOCUMENT NAMES, CARRIED AS TYPED REFERENCES RATHER THAN SPELLED IN PROSE.
// gunbc.doc_graph_roots already does exactly this for HAND-AUTHORED documents: HandAuthoredDocBind
// carries primary_work plus additional_works as DeclarationRef rows, and
// v2.lens.cited_symbol_resolution resolves that population against live declaration facts and
// refuses a missing, ambiguous, or field-absent reference. Generated documents had no equivalent,
// so a system named inside gunbc.design_document existed only as characters inside a string literal
// -- unreachable by that lens and by every other structural reader.
//
// THE MEASURED CONSEQUENCE, which is why this module exists rather than a wider one. The
// body-lowering paragraph named v2.std.symbol_index SymbolIndex as an open prerequisite. The
// prerequisite was discharged; the declaration existed the whole time; the sentence stayed. Nothing
// was wrong with the declaration, so no declaration-level check could fire, and the sentence was
// not a reference to anything, so no reference-level check could either. Four copies of that one
// claim were live across DESIGN.md and two plan documents.
//
// WHAT THIS DOES AND DOES NOT ESTABLISH, stated because the distinction is the whole scope of this
// change. A resolved reference proves the named system EXISTS and is uniquely identified -- so a
// rename, a deletion, or a fork into two same-named declarations reds through the required
// cited-symbol path without anyone editing the document. It does NOT prove a production
// relationship between the named systems: that a consumer actually invokes an implementation on a
// live path is a different claim, and a reference population cannot carry it. Where a document
// needs that stronger claim it cites an executing witness for that exact relationship. Reference
// resolution is the honest rung here, and claiming the stronger one from the weaker mechanism is
// what the earlier draft of this work did.

// ONE ROW PER SYSTEM THE GENERATED DESIGN DOCUMENT NAMES IN A MIGRATED PARAGRAPH, and the rendered
// bytes come from these rows rather than beside them. A row typed here while the paragraph
// independently spells the same name would be two representations of one fact, which is the shape
// this program exists to remove -- so the paragraph builds its symbol text by rendering the row,
// and a rename that moves the row moves the document.

data v1_maintenance_standing_ref: DeclarationRef = decl_ref(module_path: "gunbc.v1.v1_maintenance_standing", decl_name: "v1_seed_standing")

// THE REQUIRED GATE'S SUBJECTS. Until the 2026-10-09 ruling (the v1 withdrawal) this row named
// v2.workflow.required_floor required_gate_prefixes, the roster the deleted floor lane prepared. The
// one required lane now compiles the import closures of the entries these rows emit, so this is the
// declaration that says what "inside the required gate" means.
data required_gate_subjects_ref: DeclarationRef = decl_ref(module_path: "gunbc.emitted_subject_build_gate", decl_name: "emitted_subject_build_rows")

fn documentary_ref_symbol_text(reference: DeclarationRef) -> String {
  concat("`", reference.module_path as String, " ", reference.decl_name as String, "`")
}

// A citation is part of the document construction, not a second list of all rulings.
// Both projections consume these same parts: rendering cannot erase the reference population.
type DocumentaryText
  = DocumentaryLiteral { text: String }
  | DocumentaryCitation { reference: DeclarationRef }
  | DocumentaryJoin { parts: List<DocumentaryText> }

type DocumentaryBlock { block: MarkdownBlock, references: List<DeclarationRef> }
type DocumentaryListItem { item: MarkdownListItem, references: List<DeclarationRef> }

fn documentary_text_render(text: DocumentaryText) -> String {
  match text {
    DocumentaryLiteral { text } => text
    DocumentaryCitation { reference } => documentary_ref_symbol_text(reference: reference)
    DocumentaryJoin { parts } => join(map(parts, part => documentary_text_render(text: part)), "")
  }
}

fn documentary_text_refs(text: DocumentaryText) -> List<DeclarationRef> {
  match text {
    DocumentaryLiteral { text } => []
    DocumentaryCitation { reference } => [reference]
    DocumentaryJoin { parts } => flat_map(parts, part => documentary_text_refs(text: part))
  }
}

fn documentary_plain_block(block: MarkdownBlock) -> DocumentaryBlock {
  DocumentaryBlock { block: block, references: [] }
}

fn documentary_blocks_refs(blocks: List<DocumentaryBlock>) -> List<DeclarationRef> {
  flat_map(blocks, b => b.references)
}

fn documentary_cited_p(text: DocumentaryText) -> DocumentaryBlock {
  DocumentaryBlock {
    block: p(text: documentary_text_render(text: text)),
    references: documentary_text_refs(text: text),
  }
}

fn documentary_p(text: String) -> DocumentaryBlock {
  documentary_cited_p(text: DocumentaryLiteral { text: text })
}

fn documentary_h1(text: String) -> DocumentaryBlock {
  documentary_plain_block(block: h1(text: text))
}
fn documentary_h2(text: String) -> DocumentaryBlock {
  documentary_plain_block(block: h2(text: text))
}
fn documentary_h3(text: String) -> DocumentaryBlock {
  documentary_plain_block(block: h3(text: text))
}
fn documentary_hr() -> DocumentaryBlock { documentary_plain_block(block: hr()) }

fn documentary_li_blocks(blocks: List<DocumentaryBlock>) -> DocumentaryListItem {
  DocumentaryListItem {
    item: li_blocks(blocks: map(blocks, b => b.block)),
    references: documentary_blocks_refs(blocks: blocks),
  }
}
fn documentary_li(text: String) -> DocumentaryListItem {
  documentary_li_blocks(blocks: [documentary_p(text: text)])
}
fn documentary_cited_li(text: DocumentaryText) -> DocumentaryListItem {
  documentary_li_blocks(blocks: [documentary_cited_p(text: text)])
}
fn documentary_ul(items: List<DocumentaryListItem>) -> DocumentaryBlock {
  DocumentaryBlock {
    block: ul(items: map(items, i => i.item)),
    references: flat_map(items, i => i.references),
  }
}
fn documentary_ol(items: List<DocumentaryListItem>) -> DocumentaryBlock {
  DocumentaryBlock {
    block: ol(items: map(items, i => i.item)),
    references: flat_map(items, i => i.references),
  }
}
