module gunbc.workspace_reservation_record

import std.types { NonEmptyStr, String }
import std.decl_ref { decl_ref }
import gunbc.workspace_allocation { WorkspaceRequest, WorkspaceReservation, workspace_reservation_json, workspace_reservation_from_json, workspace_json_string }
import extdeps.languages.json.emit { JsonValue, JsonString, json_object, json_kv, json_string }
import extdeps.languages.json.parse { json_object_unique_member, JsonMemberFound, JsonMemberAbsent }

// The durable contract and codec do not import host acquisition. The preparation authority alone
// mints a new plan; the existing privileged-document decoder retains the same wire validation.
type WorkspaceReservationPlan sole_constructor { root: NonEmptyStr, reservation: WorkspaceReservation, selection_policy: NonEmptyStr }

fn workspace_reservation_plan_seal(root: NonEmptyStr, selection_policy: NonEmptyStr, reservation: WorkspaceReservation) -> WorkspaceReservationPlan
  admit_callers: [decl_ref(module_path: "gunbc.workspace_allocation_plan", decl_name: "workspace_reservation_prepare")]
{
  WorkspaceReservationPlan { root: root, reservation: reservation, selection_policy: selection_policy }
}

fn workspace_reservation_plan_request(plan: WorkspaceReservationPlan) -> WorkspaceRequest { plan.reservation.request }
fn workspace_reservation_plan_reservation(plan: WorkspaceReservationPlan) -> WorkspaceReservation { plan.reservation }
fn workspace_reservation_plan_json(plan: WorkspaceReservationPlan) -> JsonValue {
  json_object(members: [json_kv(key: "selection_policy", value: json_string(s: plan.selection_policy as String)), json_kv(key: "root", value: json_string(s: plan.root as String)), json_kv(key: "reservation", value: workspace_reservation_json(reservation: plan.reservation))])
}

// The administrator-owned durable plan is re-admitted through the same request/grant codec.
// This is not an HTTP payload decoder: callers load only their committed convergence artifact.
fn workspace_reservation_plan_from_json(value: JsonValue) -> WorkspaceReservationPlan? {
  let selection_policy = match json_object_unique_member(v: value, key: "selection_policy") {
    JsonMemberFound { value: member } => match member { JsonString { value: reference } => reference _ => "" }
    JsonMemberAbsent => "legacy-price-ranked"
    _ => ""
  }
  if selection_policy == "" { none } else {
  match workspace_json_string(value: value, key: "root") {
    Absent => none
    Present { value: root } => if root == "" { none } else {
      match json_object_unique_member(v: value, key: "reservation") {
        JsonMemberFound { value: body } => match workspace_reservation_from_json(value: body) {
          Present { value: reservation } => Present { value: WorkspaceReservationPlan { root: root as NonEmptyStr, reservation: reservation, selection_policy: selection_policy as NonEmptyStr } }
          Absent => none
        }
        _ => none
      }
    }
  }
}
}
