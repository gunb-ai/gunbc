// ONE CURSOR API KEY, READ FROM gunbai-secrets, BOUND AS CURSOR_API_KEY. extdeps.llm.cursor_cli
// records that the CLI authenticates per invocation with a value, so the fleet credential is a secret
// and nothing else: no directory, no rotation, nothing to write back. The dispatch credential is the
// existing CursorApiKeySecretRef arm (gunbc.dispatch_selection declared_provider_inventory_for_instance
// builds it from this ref), and gunbc.cursor_sdk_local_binding admits it unchanged.
//
// The version is EXACT, not latest: gunbc.cursor_sdk_secret_admission refuses latest for Cursor, and
// that ruling stands. Version 1 is the operator's first upload; replacing the key is a new version
// and an edit to this row.

data cursor_api_key_harness_secret_id: NonEmptyStr = "cursor-api-key-harness" as NonEmptyStr

data cursor_api_key_harness_secret_ref: SecretRef = secret_ref_pin_version(
  ref: fleet_secret_ref(secret_id: cursor_api_key_harness_secret_id),
  version: "1",
)


// THE CLI'S STATUS COMMAND READS STORED AUTH UNDER THE CONFIG ROOT IT RUNS WITH, NOT THE KEY IN
// CURSOR_API_KEY (extdeps.llm.cursor_cli, observed 2026-10-17: under an empty config root both an
// invalid key and the custody key read unauthenticated). The 2026-10-05 observation below, with a
// deliberately invalid key on cursor-agent 2026.10.01-e373342, saw {"status":"unauthenticated",
// "isAuthenticated":false,...} and mistook an ambient-config answer for a verdict on the key. The key is
// judged by CursorKeyProbeReading below; this reading is retained only until the standing stops
// consulting stored auth (the wiring that consumes CursorKeyProbeReading deletes it). A --print turn
// with the same invalid key exits 1 with prose on stderr and no JSON, which is why the standing
// (gunbc.worker_turn_standing cursor_observed_standing_from_snapshot) runs this before the turn
// rather than letting the turn's failure stand in for it.
data cursor_status_is_authenticated_key: NonEmptyStr = "isAuthenticated" as NonEmptyStr
data cursor_status_status_key: NonEmptyStr = "status" as NonEmptyStr

type CursorStatusReading
  = CursorStatusAuthenticated
  | CursorStatusUnauthenticated { status: String }
  | CursorStatusUnreadable { detail: String }

fn cursor_status_status_text(doc: JsonValue) -> String {
  match json_object_unique_member(v: doc, key: cursor_status_status_key as String) {
    JsonMemberFound { value } =>
      match value {
        JsonString { value: s } => s
        JsonNull => ""
        JsonBool { value: _ } => ""
        JsonNumber { lexeme: _ } => ""
        JsonArray { elements: _ } => ""
        JsonObject { members: _ } => ""
      }
    JsonMemberAbsent => ""
    JsonMemberDuplicated { count: _ } => ""
    JsonMemberNotAnObject => ""
  }
}

fn cursor_status_reading(stdout: String) -> CursorStatusReading {
  match parse_json_document(s: stdout) {
    JsonDocumentUnreadable { gap: _ } => CursorStatusUnreadable { detail: "status output is not a JSON document" }
    JsonDocumentParsed { value: doc } =>
      match json_object_unique_member(v: doc, key: cursor_status_is_authenticated_key as String) {
        JsonMemberFound { value } =>
          match value {
            JsonBool { value: authenticated } =>
              if authenticated {
                CursorStatusAuthenticated
              } else {
                CursorStatusUnauthenticated { status: cursor_status_status_text(doc: doc) }
              }
            JsonNull => CursorStatusUnreadable { detail: "isAuthenticated is not a boolean" }
            JsonNumber { lexeme: _ } => CursorStatusUnreadable { detail: "isAuthenticated is not a boolean" }
            JsonString { value: _ } => CursorStatusUnreadable { detail: "isAuthenticated is not a boolean" }
            JsonArray { elements: _ } => CursorStatusUnreadable { detail: "isAuthenticated is not a boolean" }
            JsonObject { members: _ } => CursorStatusUnreadable { detail: "isAuthenticated is not a boolean" }
          }
        JsonMemberAbsent => CursorStatusUnreadable { detail: "isAuthenticated absent" }
        JsonMemberDuplicated { count: _ } => CursorStatusUnreadable { detail: "isAuthenticated duplicated" }
        JsonMemberNotAnObject => CursorStatusUnreadable { detail: "status output is not a JSON object" }
      }
  }
}

// THE KEY PROBE'S READING: whether the CLI accepts the CURSOR_API_KEY of the invocation, read from
// `<pinned cursor-agent> --disable-auto-update --list-models` (extdeps.llm.cursor_cli
// cursor_key_probe_command). Accepted needs exit 0 AND at least one non-empty model row after the
// header: an empty successful process is not acceptance. Rejected only on the CLI's invalid-key marker
// on a non-zero exit. Anything else keeps its status and detail. Credential acceptance ONLY: quota,
// entitlement and paid-turn success stay with the entitlement trip (operator ruling D2). Its consumer is
// the Cursor standing, a declared frontier: it must run under an attempt-owned config root
// (the keyed invocation persists the key), which the runtime-root ownership change supplies first.
type CursorKeyProbeReading
  = CursorKeyAccepted
  | CursorKeyRejected { detail: String }
  | CursorKeyProbeUnreadable { exit_code: Int, detail: String }

// The model rows are the non-empty lines AFTER the first line that is exactly the header (lines trimmed);
// everything through that line, a preamble or warning included, never counts. A header-less stdout has none.
fn cursor_list_models_rows(stdout: String) -> List<String> {
  let delimiter = join(["\n", cursor_list_models_header as String, "\n"], "")
  let framed = join(["\n", join(cursor_sandbox_preflight_lines(stdout: stdout), "\n"), "\n"], "")
  match split(s: framed, delimiter: delimiter).get(index: 1) {
    Absent => []
    Present { value: after } => filter(split(s: after, delimiter: "\n"), l => l != "")
  }
}

fn cursor_key_probe_reading(exit_code: Int, stdout: String, stderr: String) -> CursorKeyProbeReading {
  if exit_code == 0 {
    if length(cursor_list_models_rows(stdout: stdout)) != 0 {
      CursorKeyAccepted
    } else {
      CursorKeyProbeUnreadable { exit_code: exit_code, detail: "exit 0 without a model row after the header" }
    }
  } else if string_contains(s: stderr, pattern: cursor_invalid_api_key_marker as String) {
    CursorKeyRejected { detail: trim(s: stderr) }
  } else {
    CursorKeyProbeUnreadable { exit_code: exit_code, detail: trim(s: stderr) }
  }
}

// THE SANDBOX PREFLIGHT'S READING, A THIRD FACT beside whether Cursor accepts the key and whether the
// account is entitled: whether this host can build the sandbox a sandbox-enabled turn runs in. It is
// read from extdeps.llm.cursor_cli cursor_sandbox_preflight_command, which prints CURSOR_SANDBOX from
// inside the sandbox, and it is a fact about the HOST, so it never folds into CursorStatusUnreadable.
//
// OBSERVED on srv2, 2026-10-16 (Ubuntu 24.04.4, AppArmor 4.0.1, with
// kernel.apparmor_restrict_unprivileged_userns=1, cursor-agent 2026.09.15-d2fe57e): exit 1; stdout
// carries "Failed to execute command:
// SandboxUnsupportedError: Sandbox policy 'workspace_readwrite' is not supported on this system ...
// Landlock error: ... Failed to write /proc/self/uid_map (mapping UID 0 -> 1000): Operation not
// permitted ... Bubblewrap error: ... (same)"; stderr is "Error: command failed unexpectedly."
//
// READY NEEDS THE SUBJECT'S OWN READ, AND THE READ MUST DISCRIMINATE: exit 0 AND a stdout line that
// is exactly the documented in-sandbox value. The CLI documents INJECTING CURSOR_SANDBOX=native into a
// sandboxed child, not that the variable is absent outside one, so a caller whose environment already
// holds native would hand it to an unsandboxed fallback and manufacture Ready. The preflight therefore
// starts its outer process with CURSOR_SANDBOX set to this module's sentinel
// (cursor_sandbox_discriminating_preflight_command): a real sandbox replaces it with native, and an
// unsandboxed run prints the sentinel back. Exit 0 without native is CursorSandboxNotEntered, which
// names the surviving sentinel when that is what the subject read. A non-zero exit is unavailable only when the CLI named its
// unsupported-sandbox error class; any other non-zero exit, 124 included, is an unreadable preflight
// carrying its status. 124 is not read as the bound firing: timeout returns the managed command's own
// status as well (gunbc.recurring_failure_mode bare_exit_124_read_as_an_observed_timeout_event), so
// both causes stay open in the reason rather than one being asserted.
type CursorSandboxPreflightReading
  = CursorSandboxReady
  | CursorSandboxUnavailable { detail: String }
  | CursorSandboxNotEntered { detail: String }
  | CursorSandboxPreflightUnreadable { exit_code: Int, detail: String }

fn cursor_sandbox_preflight_lines(stdout: String) -> List<String> {
  map(split(s: stdout, delimiter: "\n"), l => trim(s: l))
}

data cursor_sandbox_outside_sentinel: NonEmptyStr = "gunbc-outside-the-cursor-sandbox" as NonEmptyStr

// THE ONE PREFLIGHT INVOCATION: the CLI's own command under an outer CURSOR_SANDBOX that only a real
// sandbox can overwrite. Every reader of sandbox readiness runs this, so the discriminator cannot be
// dropped at one call site and kept at another.
fn cursor_sandbox_discriminating_preflight_command(program: ProgramIdentity) -> ArgvCommand {
  env_prefixed_command(
    bindings: [EnvSet { name: cursor_sandbox_env_var as String, value: cursor_sandbox_outside_sentinel as String }],
    command: cursor_sandbox_preflight_command(program: program),
  )
}

fn cursor_sandbox_preflight_reading(exit_code: Int, stdout: String, stderr: String) -> CursorSandboxPreflightReading {
  let lines = cursor_sandbox_preflight_lines(stdout: stdout)
  if exit_code == 0 {
    if any(lines, l => l == (cursor_sandbox_linux_native_value as String)) {
      CursorSandboxReady
    } else if any(lines, l => l == (cursor_sandbox_outside_sentinel as String)) {
      CursorSandboxNotEntered { detail: "the outer CURSOR_SANDBOX sentinel survived into the command, so it ran outside the sandbox" }
    } else {
      CursorSandboxNotEntered { detail: trim(s: stdout) }
    }
  } else {
    match filter(lines, l => string_contains(s: l, pattern: cursor_sandbox_unsupported_error_class as String)).first() {
      Present { value: line } => CursorSandboxUnavailable { detail: line }
      Absent => CursorSandboxPreflightUnreadable { exit_code: exit_code, detail: trim(s: stderr) }
    }
  }
}

// ── The spawn: the custody file becomes CURSOR_API_KEY in the child, never argv ─────────────────
//
// gunbc.fleet.host_credential_custody_converge CursorWorkerTurnApiKey places the key at this path on this
// host, root-owned with the operator group readable, so the dispatch spawn can read it and cannot
// replace the sibling export receipt through directory permissions. The spawn exports it from the
// file inside the child through the shared extdeps.posix.sh_invocation wrapper, which exits 78 if the
// file cannot be read, so the key is never on an argv the process table shows.

data cursor_worker_turn_custody_host: HostIdentity = operator_host_srv2
data cursor_worker_turn_api_key_host_path: NonEmptyStr = "/etc/gunbc-cursor-harness/api-key" as NonEmptyStr

// THE UNATTENDED RUN: print mode with stream-json events, the default editing mode, --force so the
// agent may run commands without a human to approve them, the sandbox explicitly enabled so --force
// does not also mean unconfined, and --trust because an untrusted workspace prompts and an
// unattended run would hang there (extdeps.llm.cursor_cli).
fn cursor_worker_turn_run(worktree_path: String, prompt: NonEmptyStr) -> CursorRunShape {
  CursorRunShape {
    model: cursor_model_auto,
    mode: CursorDefaultEditMode,
    sandbox: CursorSandboxEnabled,
    output_format: CursorStreamJson,
    force: true,
    trust_workspace: true,
    workspace: worktree_path as FilePath,
    prompt: prompt,
  }
}

// snapshot is the attempt's credential snapshot as the selection TOOK it (a
// gunbc.dispatch_credential_snapshot TakenCredentialSnapshot, which only the take can build), removed
// by the shell before exec -- so this builder cannot name a file no take wrote. The env-var name is admitted as a POSIX name before it reaches the wrapper (extdeps.posix.
// shell_command_language admit_posix_shell_name), and the wrapper's program is emitted from the bash
// grammar, which may refuse; either refusal is one arm carrying its reason.
// The CLI's own words for the turn, before the credential wrapper: the interface the pinned-program
// witness reads, since a TakenCredentialSnapshot can only be built by a take.
fn cursor_worker_turn_inner_argv(program: ProgramIdentity, worktree_path: String, prompt: NonEmptyStr) -> List<String> {
  cursor_environment_authenticated_argv(program: program, run: cursor_worker_turn_run(worktree_path: worktree_path, prompt: prompt))
}

type CursorWorkerTurnArgv
  = CursorWorkerTurnArgvReady { argv: List<String> }
  | CursorWorkerTurnRefused { reason: NonEmptyStr }

fn cursor_worker_turn_argv(program: ProgramIdentity, snapshot: TakenCredentialSnapshot, worktree_path: String, prompt: NonEmptyStr) -> CursorWorkerTurnArgv {
  match admit_posix_shell_name(spelling: cursor_api_key_env_var as String) {
    PosixShellNameAdmitted { name } =>
      match posix_sh_export_from_file_then_exec_command(
        name: name,
        path: taken_credential_snapshot_path(snapshot: snapshot),
        command: cursor_worker_turn_inner_argv(program: program, worktree_path: worktree_path, prompt: prompt),
        disposition: credential_snapshot_after_read_disposition(),
      ) {
        PosixShExportExecReady { command } => CursorWorkerTurnArgvReady { argv: argv_words(command: command) }
        PosixShExportExecEmitRefused { name: n } =>
          CursorWorkerTurnRefused { reason: join(["the sh emitter refused the export-and-exec program for ", n as String], "") as NonEmptyStr }
      }
    PosixShellNameRefused { spelling } =>
      CursorWorkerTurnRefused { reason: join(["the cursor credential variable name ", spelling, " is not a POSIX shell name"], "") as NonEmptyStr }
  }
}
