module gunbc.srv3_sol_console_capture


data srv3_sol_console_capture_scaffold: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "extdeps.bmc.serial_console",
    decl_name: "sol_console_capture_bash_emit_dissolution_trigger",
    field: WholeDeclaration,
  }
}

func srv3_sol_console_capture() -> ProcessExit {
  srv3_reconciliation_to_process_exit(
    r: srv3_sol_console_capture_apply(),
    failure_prefix: "sol-console-capture: ",
  )
}

fn srv3_sol_console_capture_log_path_is_declared() -> Bool {
  string_contains(s: srv3_sol_console_log_path as String, pattern: "srv3-install-sol-console")
}

fn srv3_sol_console_capture_carries_dissolution_trigger() -> Bool {
  match sol_console_capture_bash_emit_dissolution_trigger {
    Scaffold { dissolves_to: _, bind: _ } => true
    Terminal { reason: _ } => false
  }
}
