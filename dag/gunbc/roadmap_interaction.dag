module gunbc.roadmap_interaction

import std.types { Int, String, Bool }
import gunbc.design.material {
  TimingToken, respond_fast,
  MotionTrigger, OnActive,
  BuildRule, ResponseRule, SelfResponse,
  CssDecl, decl,
}
import gunbc.design.interaction {
  InteractionVerb, Approach, Dispatch,
  Response, Brighten, Receipt,
  BehaviorRow, InteractiveElement,
  ElementId, DispatchBtnElement, element_id_key, element_id_eq,
  verb_key, response_key,
  coverage_gaps, coverage_complete, CoverageGap,
}
import gunbc.site.moodboard {
  RealizedBehavior, RealizedRules, UnrealizedBehavior,
  approach_triggers,
}

data roadmap_interaction_note: String = "The roadmap dashboard's interaction rows (slice 2 of roadmap-onto-register, manager-signed): the dispatch button declares Approach and Dispatch, and its stylesheet responses are DERIVED from these rows through roadmap_realize_behavior — the register law (no dead hovers; responses derived) applied to the second site. Approach realizes as the border brighten over the shared approach_triggers (hover + focus-visible, one authority with the site pages); Dispatch realizes as the OnActive press receipt — background flips to the border material for the pressed frame, the CSS-layer receipt; the belt-side dispatch receipt is the served effect (belt_dispatch_node, serving layer) and never this module's concern. The realize fold mirrors moodboard's shape (RealizedRules | UnrealizedBehavior, unrealized countable); the Phase-A lift unifies the two folds behind a realize-parametric L2 carrier — declared convergence, not a silent fork. Known residue, named: the roadmap's a:hover underline is a hand StaticRule with no declared element (links are unmodeled site-wide today); it joins the element roster when the site models link elements, and the stray-response census belongs to the lift."

data roadmap_elements: List<InteractiveElement> = [
  InteractiveElement { element: DispatchBtnElement, verbs: [Approach, Dispatch] },
]

data roadmap_behaviors: List<BehaviorRow> = [
  BehaviorRow { element: DispatchBtnElement, verb: Approach, response: Brighten, timing: respond_fast },
  BehaviorRow { element: DispatchBtnElement, verb: Dispatch, response: Receipt, timing: respond_fast },
]

fn dispatch_btn_brighten_rules(timing: TimingToken) -> List<BuildRule> {
  map(approach_triggers(), t =>
    ResponseRule {
      subject: ClassSelector { name: "dispatch-btn" },
      shape: SelfResponse,
      trigger: t,
      transition_props: "border-color",
      timing: timing,
      base_decls: [],
      response_decls: [ decl(prop: BorderColor, value: "var(--focus)") ],
    })
}

fn dispatch_btn_receipt_rules(timing: TimingToken) -> List<BuildRule> {
  [
    ResponseRule {
      subject: ClassSelector { name: "dispatch-btn" },
      shape: SelfResponse,
      trigger: OnActive,
      transition_props: "background-color",
      timing: timing,
      base_decls: [],
      response_decls: [ decl(prop: Background, value: "var(--border)") ],
    },
  ]
}

fn roadmap_realize_behavior(row: BehaviorRow) -> RealizedBehavior {
  let e = row.element
  let r = response_key(r: row.response)
  if element_id_eq(a: e, b: DispatchBtnElement) && r == "brighten" {
    RealizedRules { rules: dispatch_btn_brighten_rules(timing: row.timing) }
  } else if element_id_eq(a: e, b: DispatchBtnElement) && r == "receipt" {
    RealizedRules { rules: dispatch_btn_receipt_rules(timing: row.timing) }
  } else {
    UnrealizedBehavior { element: element_id_key(id: e), verb: verb_key(v: row.verb), response: r }
  }
}

fn roadmap_unrealized_behaviors(rows: List<BehaviorRow>) -> List<RealizedBehavior> {
  fold(rows, init: [], f: (acc, row) => match roadmap_realize_behavior(row: row) {
    RealizedRules { rules: _ } => acc
    UnrealizedBehavior { element, verb, response } =>
      concat(acc, [UnrealizedBehavior { element: element, verb: verb, response: response }])
  })
}

fn roadmap_behavior_rules(rows: List<BehaviorRow>) -> List<BuildRule> {
  fold(rows, init: [], f: (acc, row) => match roadmap_realize_behavior(row: row) {
    RealizedRules { rules } => concat(acc, rules)
    UnrealizedBehavior { element: _, verb: _, response: _ } => acc
  })
}
