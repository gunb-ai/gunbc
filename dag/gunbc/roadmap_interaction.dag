  TimingToken, respond_fast, reveal_deliberate, settle_spring,
  MotionTrigger, OnHover, OnActive, OnStateClass,
  BuildRule, StaticRule, ResponseRule, SelfResponse,
  CssDecl, decl,
  rest_scale_per_mille, press_scale_per_mille, hold_scale_per_mille,
}
import gunbc.design.interaction {
  InteractionVerb, Approach, Dispatch, Await, Accept,
  Response, Brighten, Receipt, Lift, Depress, Settle,
  BehaviorRow, InteractiveElement,
  ElementId, DispatchBtnElement, SoundToggleElement, element_id_key, element_id_eq,
