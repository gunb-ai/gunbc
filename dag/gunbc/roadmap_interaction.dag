module gunbc.roadmap_interaction


data roadmap_interaction_note: String = "The roadmap dashboard's interaction rows (slice 2 of roadmap-onto-register, manager-signed): the dispatch button declares Approach and Dispatch, and its stylesheet responses are DERIVED from these rows through roadmap_realize_behavior — the register law (no dead hovers; responses derived) applied to the second site. Approach realizes as the border brighten over the shared approach_triggers (hover + focus-visible, one authority with the site pages); Dispatch realizes as the OnActive press receipt — the fill deepens one press stop (band-invite-pressed, in-family; formerly the border material, retargeted with the W1c fills) for the pressed frame, the CSS-layer receipt; the belt-side dispatch receipt is the served effect (belt_dispatch_node, serving layer) and never this module's concern. The realize fold mirrors moodboard's shape (RealizedRules | UnrealizedBehavior, unrealized countable); the Phase-A lift unifies the two folds behind a realize-parametric L2 carrier — declared convergence, not a silent fork. Known residue, named: the roadmap's a:hover underline is a hand StaticRule with no declared element (links are unmodeled site-wide today); it joins the element roster when the site models link elements, and the stray-response census belongs to the lift."

data roadmap_physical_behavior_note: String = "The dispatch button's full mechanical story, as rows. Before this it had two: the edge brightens on approach, the background flips on press — both responses of APPEARANCE, which is exactly the critique the analog root principle answers, because a control that only changes colour is a diagram that lights up rather than an object that moves. The four added rows are the travel.

Read as one mechanism at successive positions: gunbc.design.interaction.Approach lifts it 1 px toward the hand while the edge brightens (two rows, one verb — genuinely two answers to one event). gunbc.design.interaction.Dispatch is the engagement, and it fires on pointer-DOWN through gunbc.design.material.OnActive rather than on release, because acknowledgment belongs to the press; the control travels down and compresses. gunbc.design.interaction.Await holds it compressed while the request is in flight, deeper than the press, because a request in flight IS the control still actuated — and because a spring needs travel to return over. gunbc.design.interaction.Accept releases it into unity on the settle curve, which overshoots and comes back: the detent catching.

gunbc.design.interaction.Await and gunbc.design.interaction.Accept realize as StateRule rather than gunbc.design.material.ResponseRule for a structural reason, not a stylistic one: their trigger is a server answer arriving long after the pointer is gone, and CSS has no pseudo-class for that. So they key on the SAME class names the client program flips (gunbc.roadmap_component.dispatch_class_requested / gunbc.roadmap_component.dispatch_class_ok), which is what keeps the CSS and the JS on one authority instead of two hand-matched string sets.

The sound toggle joins the roster because it is a control, and the register's coverage law does not exempt small ones — an unresponsive mute button would be precisely the dead hover the law exists to forbid. It gets travel and brightening and no sound of its own: a mute control that clicked when you muted it would be arguing with you."

data roadmap_elements: List<gunbc.design.interaction.InteractiveElement> = [
  gunbc.design.interaction.InteractiveElement { element: gunbc.design.interaction.DispatchBtnElement, verbs: [gunbc.design.interaction.Approach, gunbc.design.interaction.Dispatch, gunbc.design.interaction.Await, gunbc.design.interaction.Accept] },
  gunbc.design.interaction.InteractiveElement { element: gunbc.design.interaction.SoundToggleElement, verbs: [gunbc.design.interaction.Approach, gunbc.design.interaction.Dispatch] },
  gunbc.design.interaction.InteractiveElement { element: gunbc.design.interaction.DisclosureElement, verbs: [gunbc.design.interaction.Approach, gunbc.design.interaction.Enter] },
]

data roadmap_timing_assignment_note: String = "Which clock each verb runs on, reusing the existing scale rather than minting near-misses (operator, 2026-07-24). APPROACH runs on reveal_deliberate (160 ms): an approach is a reveal — the control coming toward the hand — and the earlier 90 ms on the brighten row was the press clock borrowed for a gesture that is not a press. DISPATCH runs on respond_fast (90 ms), the press-acknowledge clock, because engagement must land under the finger and anything slower reads as lag. AWAIT also runs on respond_fast: the control latching down when the request leaves is an engagement, not a reveal. ACCEPT runs on settle_spring, which is restore_gentle's 240 ms carrying the overshoot curve — the only mint, and only on the easing axis."

data roadmap_behaviors: List<gunbc.design.interaction.BehaviorRow> = [
  gunbc.design.interaction.BehaviorRow { element: gunbc.design.interaction.DispatchBtnElement, verb: gunbc.design.interaction.Approach, response: gunbc.design.interaction.Brighten, timing: gunbc.design.material.reveal_deliberate },
  gunbc.design.interaction.BehaviorRow { element: gunbc.design.interaction.DispatchBtnElement, verb: gunbc.design.interaction.Approach, response: gunbc.design.interaction.Lift, timing: gunbc.design.material.reveal_deliberate },
  gunbc.design.interaction.BehaviorRow { element: gunbc.design.interaction.DispatchBtnElement, verb: gunbc.design.interaction.Dispatch, response: gunbc.design.interaction.Receipt, timing: gunbc.design.material.respond_fast },
  gunbc.design.interaction.BehaviorRow { element: gunbc.design.interaction.DispatchBtnElement, verb: gunbc.design.interaction.Dispatch, response: gunbc.design.interaction.Depress, timing: gunbc.design.material.respond_fast },
  gunbc.design.interaction.BehaviorRow { element: gunbc.design.interaction.DispatchBtnElement, verb: gunbc.design.interaction.Await, response: gunbc.design.interaction.Depress, timing: gunbc.design.material.respond_fast },
  gunbc.design.interaction.BehaviorRow { element: gunbc.design.interaction.DispatchBtnElement, verb: gunbc.design.interaction.Accept, response: gunbc.design.interaction.Settle, timing: gunbc.design.material.settle_spring },
  gunbc.design.interaction.BehaviorRow { element: gunbc.design.interaction.DisclosureElement, verb: gunbc.design.interaction.Approach, response: gunbc.design.interaction.Brighten, timing: gunbc.design.material.reveal_deliberate },
  gunbc.design.interaction.BehaviorRow { element: gunbc.design.interaction.DisclosureElement, verb: gunbc.design.interaction.Enter, response: gunbc.design.interaction.Turn, timing: gunbc.design.material.respond_fast },
  gunbc.design.interaction.BehaviorRow { element: gunbc.design.interaction.SoundToggleElement, verb: gunbc.design.interaction.Approach, response: gunbc.design.interaction.Brighten, timing: gunbc.design.material.reveal_deliberate },
  gunbc.design.interaction.BehaviorRow { element: gunbc.design.interaction.SoundToggleElement, verb: gunbc.design.interaction.Approach, response: gunbc.design.interaction.Lift, timing: gunbc.design.material.reveal_deliberate },
  gunbc.design.interaction.BehaviorRow { element: gunbc.design.interaction.SoundToggleElement, verb: gunbc.design.interaction.Dispatch, response: gunbc.design.interaction.Depress, timing: gunbc.design.material.respond_fast },
]

data roadmap_detent_note: String = "The dispatch button's detent table — the mechanical spec the CSS is DERIVED from, pinned as data because a transition that connects two equal transforms is inert (gunbc.design.interaction.detent_table_note).

The positions read as one latching mechanism. REST sits at unity with no travel. HOVER rises 1 px toward the hand at unity scale — a reveal, not a compression. PRESSED is the finger's own travel: 1 px down and 3% in. REQUESTED is the control LATCHED, and it sits DEEPER than the finger left it (4% in, no vertical travel) which is the one choice here worth defending. A momentary switch would return to rest when released; this control does not, because the request is still in flight and the honest analog is a latching push-button that holds its engaged position until the mechanism releases it. The depth is also what buys the settle its travel: this curve's peak excursion is about a tenth of the delta, so the doc's illustrative 0.985 would have produced a spring under a tenth of a pixel on a chip-sized control — a beat that has to be believed rather than seen. ACCEPTED returns to unity, so the visible event is a 4% growth carrying a small overshoot, and the terminal position is the resting one exactly as the contract says terminals are 1.0.

ACCEPTED and REST share a transform deliberately: a settled control IS at rest, and the accepted→rest edge is not one that needs to beat. Which edges DO need to beat is declared separately in roadmap_detent_edges, so the sharing is a stated fact rather than an accident the distinctness check has to be weakened to tolerate."

data detent_rest: String = "rest"
data detent_hover: String = "hover"
data detent_pressed: String = "pressed"
data detent_requested: String = "requested"
data detent_accepted: String = "accepted"

data roadmap_dispatch_detents: List<gunbc.design.interaction.Detent> = concat(
  gunbc.design.interaction.house_pointer_detents(rest_state: detent_rest, hover_state: detent_hover, pressed_state: detent_pressed),
  [
    gunbc.design.interaction.Detent {
      state: detent_requested,
      reach: gunbc.design.interaction.ByTrigger { cause: gunbc.design.interaction_cause.ObservedStateEntered { state_name: gunbc.roadmap_component.dispatch_class_requested } },
      travel: gunbc.design.interaction.NoTravel,
      scale_per_mille: gunbc.design.material.hold_scale_per_mille,
      turn_deg: 0,
    },
    gunbc.design.interaction.Detent {
      state: detent_accepted,
      reach: gunbc.design.interaction.ByTrigger { cause: gunbc.design.interaction_cause.ObservedStateEntered { state_name: gunbc.roadmap_component.dispatch_class_ok } },
      travel: gunbc.design.interaction.NoTravel,
      scale_per_mille: gunbc.design.material.rest_scale_per_mille,
      turn_deg: 0,
    },
  ])

data disclosure_detent_rest: String = "disclosure-rest"

data roadmap_disclosure_detents: List<gunbc.design.interaction.Detent> = [
  gunbc.design.interaction.Detent { state: disclosure_detent_rest, reach: gunbc.design.interaction.AtRest, travel: gunbc.design.interaction.NoTravel, scale_per_mille: gunbc.design.material.rest_scale_per_mille, turn_deg: 0 },
  gunbc.design.interaction.Detent {
    state: gunbc.roadmap_component.disclosure_open_class,
    reach: gunbc.design.interaction.ByTrigger { cause: gunbc.design.interaction_cause.ObservedStateEntered { state_name: gunbc.roadmap_component.disclosure_open_class } },
    travel: gunbc.design.interaction.NoTravel,
    scale_per_mille: gunbc.design.material.rest_scale_per_mille,
    turn_deg: 90,
  },
]

data roadmap_sound_toggle_detents: List<gunbc.design.interaction.Detent> = gunbc.design.interaction.house_pointer_detents(
  rest_state: detent_rest,
  hover_state: detent_hover,
  pressed_state: detent_pressed,
)

data roadmap_detent_edges: List<gunbc.design.interaction.DetentEdge> = [
  gunbc.design.interaction.DetentEdge { from_state: detent_rest, to_state: detent_hover },
  gunbc.design.interaction.DetentEdge { from_state: detent_hover, to_state: detent_pressed },
  gunbc.design.interaction.DetentEdge { from_state: detent_rest, to_state: detent_pressed },
  gunbc.design.interaction.DetentEdge { from_state: detent_pressed, to_state: detent_requested },
  gunbc.design.interaction.DetentEdge { from_state: detent_requested, to_state: detent_accepted },
]

data dispatch_brighten_neutral_note: String = "Approach emphasis on the FILLED instrument is band-neutral (operator ruling 2026-07-24): the earlier target was var(--focus) — brass — and brass is hue-ambiguous next to the band fills (on mint it reads venom-adjacent brown, on venom it reads mint-adjacent yellow-green), so hover appeared to INVERT the state colors. The theme's ink (var(--text)) is the one color that reads as pure emphasis on every fill under both themes, so approach = ink ring + the existing lift, and never a hue that could be mistaken for a band. Brass remains the focus material elsewhere (the review mark); this retarget is the instrument's own row."

fn dispatch_btn_brighten_rules(timing: gunbc.design.material.TimingToken) -> List<gunbc.design.material.BuildRule> {
  map(gunbc.site.moodboard.approach_triggers(), t =>
    gunbc.design.material.ResponseRule {
      subject: ClassSelector { name: "dispatch-btn" },
      shape: gunbc.design.material.SelfResponse,
      trigger: t,
      transition_props: "border-color",
      timing: timing,
      base_decls: [],
      response_decls: [ gunbc.design.material.decl(prop: BorderColor, value: "var(--text)") ],
    })
}

data dispatch_state_family_note: String = "The dispatch instrument's state family — the SINGLE authority for the state-class-to-band mapping (composition slice 1). Before this roster the mapping was spelled at three sites: the style's four per-state paint StaticRules, the receipt rules' four hand call sites, and the base rule's inline invite vars — the same fact three times, which is exactly the fork the round-5 flash grew in. The roster order is the emission order (rest first), pinned by the byte oracle. A presentation state the button can wear that is missing from this roster has no selector anywhere downstream — the realize folds and the census both walk this list, so joining the family IS the single edit."

data dispatch_state_family: gunbc.design.state_response.StateFamily = gunbc.design.state_response.StateFamily {
  component_class: "dispatch-btn",
  var_prefix: "band-",
  members: [
    gunbc.design.state_response.StateFamilyMember { binding: gunbc.design.state_response.RestBinding, key: "invite" },
    gunbc.design.state_response.StateFamilyMember { binding: gunbc.design.state_response.StateClassBinding { class_name: gunbc.roadmap_component.dispatch_class_requested }, key: "in-progress" },
    gunbc.design.state_response.StateFamilyMember { binding: gunbc.design.state_response.StateClassBinding { class_name: gunbc.roadmap_component.dispatch_class_ok }, key: "ok" },
    gunbc.design.state_response.StateFamilyMember { binding: gunbc.design.state_response.StateClassBinding { class_name: gunbc.roadmap_component.dispatch_class_refused }, key: "fail" },
    gunbc.design.state_response.StateFamilyMember { binding: gunbc.design.state_response.StateClassBinding { class_name: gunbc.roadmap_component.dispatch_class_loud }, key: "loud" },
  ],
}

data dispatch_sound_constant_ratchet_note: String = "RULING ROW (composition slice 1, the honesty boundary): the engage sound is constant across the state family — one tick spec whichever band the instrument wears — and that constancy is DECLARED here as a ratchet, never left in the undeclared middle and never silent. It is a ratchet, not a wall: the tick cannot route per band until SoundOccasion becomes its closed sum (gunbc.design.sound.sound_growth_trigger, the settle-tone / refusal-thud PR), at which point the sound channel flips to PerStateFamily in dispatch_stateful_channels and this row deletes. Until then the census counts the channel as a signed constant with this row as its ruling."

data dispatch_stateful_channels_note: String = "The dispatch instrument's stateful-channel table (composition slice 1) — every channel through which state reaches the operator, each carrying its scope BY TYPE: PerStateFamily rows are realized by the state_response folds (rest paints into the base rule and the per-state blocks; the press response multiplied across the family), ConstantByLaw rows name the recorded ruling that signed their constancy — the approach ring's band-neutrality (dispatch_brighten_neutral_note, operator 2026-07-24) and the sound ratchet (dispatch_sound_constant_ratchet_note). A response row with neither scope is unwritable: the table's element type has no third arm. Channel order within the rest group is the base rule's authored decl order (ink, fill, border), pinned by the byte oracle."

data dispatch_stateful_channels: List<gunbc.design.state_response.ChannelScope> = [
  gunbc.design.state_response.PerStateFamily { channel: gunbc.design.state_response.RestChannel { prop: Color, role: gunbc.design.state_response.InkVar } },
  gunbc.design.state_response.PerStateFamily { channel: gunbc.design.state_response.RestChannel { prop: Background, role: gunbc.design.state_response.FillVar } },
  gunbc.design.state_response.PerStateFamily { channel: gunbc.design.state_response.RestChannel { prop: BorderColor, role: gunbc.design.state_response.FillVar } },
  gunbc.design.state_response.PerStateFamily { channel: gunbc.design.state_response.ResponseChannel { trigger: gunbc.design.material.OnActive, prop: Background, role: gunbc.design.state_response.PressedVar, transition_props: "background-color" } },
  gunbc.design.state_response.ConstantByLaw {
    channel_name: "approach-emphasis",
    ruling: std.decl_ref.DeclarationRef { module_path: "gunbc.roadmap_interaction", decl_name: "dispatch_brighten_neutral_note", field: std.decl_ref.WholeDeclaration },
  },
  gunbc.design.state_response.ConstantByLaw {
    channel_name: "engage-sound",
    ruling: std.decl_ref.DeclarationRef { module_path: "gunbc.roadmap_interaction", decl_name: "dispatch_sound_constant_ratchet_note", field: std.decl_ref.WholeDeclaration },
  },
]

data dispatch_receipt_family_note: String = "The press receipt realizes PER STATE FAMILY (round-5 fix, re-derived through the state_response fold in composition slice 1): the first cut was one constant on the base selector — the invite press fill for every state the button can wear — so pressing an orange fault pill flashed deep green. A press deepens the material it presses: the press-fill channel is authored ONCE in dispatch_stateful_channels as a function of state, and family_response_rules multiplies it across the roster — each member's selector targets ITS band's derived pressed var, the rest member on the base selector. The four hand call sites this replaces were byte-identical under the fold (digest oracle), and the family-preservation witness in the tactile suite holds a RED against any cross-family press returning."

fn dispatch_btn_receipt_rules(timing: gunbc.design.material.TimingToken) -> List<gunbc.design.material.BuildRule> {
  gunbc.design.state_response.family_response_rules(f: dispatch_state_family, channels: dispatch_stateful_channels, timing: timing)
}

data detent_realization_note: String = "Every transform rule is READ from the detent table, never restated beside it. That is the whole reason the table exists as data: a position written once in a table and again in a rule builder is the same fact in two places, and the copy that drifts is always the one nobody is looking at. So a position response (Lift, Depress, Settle) resolves its state in the table and emits whatever the table says; if the state is missing the realization yields NO rules, which surfaces through the existing unrealized-behaviour census as a counted row rather than as a silently absent transition.

gunbc.design.interaction.AtRest emits a gunbc.design.material.StaticRule because the resting transform is the property's base value — it must be DECLARED for a transition to have somewhere to return to, and it carries no timing because arriving at rest is governed by the edge that leaves the other state."

fn detent_rules(class_name: String, detents: List<gunbc.design.interaction.Detent>, state: String, timing: gunbc.design.material.TimingToken) -> List<gunbc.design.material.BuildRule> {
  match gunbc.design.interaction.detent_named(detents: detents, state: state) {
    Absent => []
    Present { value: d } => {
      let transform = gunbc.design.material.decl(prop: Transform, value: gunbc.design.interaction.detent_transform_wire(d: d))
      match d.reach {
        gunbc.design.interaction.AtRest => [ gunbc.design.material.StaticRule { selector: ClassSelector { name: class_name }, decls: [transform] } ]
        gunbc.design.interaction.ByTrigger { cause } => [
          gunbc.design.material.ResponseRule {
            subject: ClassSelector { name: class_name },
            shape: gunbc.design.material.SelfResponse,
            trigger: gunbc.design.material.css_trigger_for(cause: cause),
            transition_props: "transform",
            timing: timing,
            base_decls: [],
            response_decls: [transform],
          },
        ]
      }
    }
  }
}

fn control_lift_rules(class_name: String, detents: List<gunbc.design.interaction.Detent>, timing: gunbc.design.material.TimingToken) -> List<gunbc.design.material.BuildRule> {
  concat(
    detent_rules(class_name: class_name, detents: detents, state: detent_rest, timing: timing),
    detent_rules(class_name: class_name, detents: detents, state: detent_hover, timing: timing))
}

fn control_depress_rules(class_name: String, detents: List<gunbc.design.interaction.Detent>, timing: gunbc.design.material.TimingToken) -> List<gunbc.design.material.BuildRule> {
  detent_rules(class_name: class_name, detents: detents, state: detent_pressed, timing: timing)
}

fn dispatch_btn_hold_rules(timing: gunbc.design.material.TimingToken) -> List<gunbc.design.material.BuildRule> {
  detent_rules(
    class_name: "dispatch-btn",
    detents: roadmap_dispatch_detents,
    state: detent_requested,
    timing: timing)
}

fn dispatch_btn_settle_rules(timing: gunbc.design.material.TimingToken) -> List<gunbc.design.material.BuildRule> {
  detent_rules(
    class_name: "dispatch-btn",
    detents: roadmap_dispatch_detents,
    state: detent_accepted,
    timing: timing)
}

fn disclosure_brighten_rules(timing: gunbc.design.material.TimingToken) -> List<gunbc.design.material.BuildRule> {
  map(gunbc.site.moodboard.approach_triggers(), t =>
    gunbc.design.material.ResponseRule {
      subject: ElementSelector { tag: "summary" },
      shape: gunbc.design.material.SelfResponse,
      trigger: t,
      transition_props: "color",
      timing: timing,
      base_decls: [],
      response_decls: [ gunbc.design.material.decl(prop: Color, value: "var(--text)") ],
    })
}

fn disclosure_turn_rules(timing: gunbc.design.material.TimingToken) -> List<gunbc.design.material.BuildRule> {
  concat(
    detent_rules(class_name: gunbc.roadmap_component.disclosure_mark_class, detents: roadmap_disclosure_detents, state: disclosure_detent_rest, timing: timing),
    detent_rules(class_name: gunbc.roadmap_component.disclosure_mark_class, detents: roadmap_disclosure_detents, state: gunbc.roadmap_component.disclosure_open_class, timing: timing))
}

fn roadmap_realize_behavior(row: gunbc.design.interaction.BehaviorRow) -> gunbc.site.moodboard.RealizedBehavior {
  let e = row.element
  let r = gunbc.design.interaction.response_key(r: row.response)
  let v = gunbc.design.interaction.verb_key(v: row.verb)
  if gunbc.design.interaction.element_id_eq(a: e, b: gunbc.design.interaction.DispatchBtnElement) && r == "brighten" {
    gunbc.site.moodboard.RealizedRules { rules: dispatch_btn_brighten_rules(timing: row.timing) }
  } else if gunbc.design.interaction.element_id_eq(a: e, b: gunbc.design.interaction.DispatchBtnElement) && r == "receipt" {
    gunbc.site.moodboard.RealizedRules { rules: dispatch_btn_receipt_rules(timing: row.timing) }
  } else if gunbc.design.interaction.element_id_eq(a: e, b: gunbc.design.interaction.DispatchBtnElement) && r == "lift" {
    gunbc.site.moodboard.RealizedRules {
      rules: control_lift_rules(
        class_name: "dispatch-btn",
        detents: roadmap_dispatch_detents,
        timing: row.timing)
    }
  } else if gunbc.design.interaction.element_id_eq(a: e, b: gunbc.design.interaction.DispatchBtnElement) && r == "depress" && v == "dispatch" {
    gunbc.site.moodboard.RealizedRules {
      rules: control_depress_rules(
        class_name: "dispatch-btn",
        detents: roadmap_dispatch_detents,
        timing: row.timing)
    }
  } else if gunbc.design.interaction.element_id_eq(a: e, b: gunbc.design.interaction.DispatchBtnElement) && r == "depress" && v == "await" {
    gunbc.site.moodboard.RealizedRules { rules: dispatch_btn_hold_rules(timing: row.timing) }
  } else if gunbc.design.interaction.element_id_eq(a: e, b: gunbc.design.interaction.DispatchBtnElement) && r == "settle" {
    gunbc.site.moodboard.RealizedRules { rules: dispatch_btn_settle_rules(timing: row.timing) }
  } else if gunbc.design.interaction.element_id_eq(a: e, b: gunbc.design.interaction.DisclosureElement) && r == "brighten" {
    gunbc.site.moodboard.RealizedRules { rules: disclosure_brighten_rules(timing: row.timing) }
  } else if gunbc.design.interaction.element_id_eq(a: e, b: gunbc.design.interaction.DisclosureElement) && r == "turn" {
    gunbc.site.moodboard.RealizedRules { rules: disclosure_turn_rules(timing: row.timing) }
  } else if gunbc.design.interaction.element_id_eq(a: e, b: gunbc.design.interaction.SoundToggleElement) && r == "brighten" {
    gunbc.site.moodboard.RealizedRules { rules: sound_toggle_brighten_rules(timing: row.timing) }
  } else if gunbc.design.interaction.element_id_eq(a: e, b: gunbc.design.interaction.SoundToggleElement) && r == "lift" {
    gunbc.site.moodboard.RealizedRules {
      rules: control_lift_rules(
        class_name: gunbc.roadmap_component.sound_toggle_class,
        detents: roadmap_sound_toggle_detents,
        timing: row.timing)
    }
  } else if gunbc.design.interaction.element_id_eq(a: e, b: gunbc.design.interaction.SoundToggleElement) && r == "depress" {
    gunbc.site.moodboard.RealizedRules {
      rules: control_depress_rules(
        class_name: gunbc.roadmap_component.sound_toggle_class,
        detents: roadmap_sound_toggle_detents,
        timing: row.timing)
    }
  } else {
    gunbc.site.moodboard.UnrealizedBehavior { element: gunbc.design.interaction.element_id_key(id: e), verb: v, response: r }
  }
}

fn sound_toggle_brighten_rules(timing: gunbc.design.material.TimingToken) -> List<gunbc.design.material.BuildRule> {
  map(gunbc.site.moodboard.approach_triggers(), t =>
    gunbc.design.material.ResponseRule {
      subject: ClassSelector { name: gunbc.roadmap_component.sound_toggle_class },
      shape: gunbc.design.material.SelfResponse,
      trigger: t,
      transition_props: "border-color",
      timing: timing,
      base_decls: [],
      response_decls: [ gunbc.design.material.decl(prop: BorderColor, value: "var(--focus)") ],
    })
}

fn roadmap_unrealized_behaviors(rows: List<gunbc.design.interaction.BehaviorRow>) -> List<gunbc.site.moodboard.RealizedBehavior> {
  fold(rows, init: [], f: (acc, row) => match roadmap_realize_behavior(row: row) {
    gunbc.site.moodboard.RealizedRules { rules: _ } => acc
    gunbc.site.moodboard.UnrealizedBehavior { element, verb, response } =>
      concat(acc, [gunbc.site.moodboard.UnrealizedBehavior { element: element, verb: verb, response: response }])
  })
}

fn roadmap_behavior_rules(rows: List<gunbc.design.interaction.BehaviorRow>) -> List<gunbc.design.material.BuildRule> {
  fold(rows, init: [], f: (acc, row) => match roadmap_realize_behavior(row: row) {
    gunbc.site.moodboard.RealizedRules { rules } => concat(acc, rules)
    gunbc.site.moodboard.UnrealizedBehavior { element: _, verb: _, response: _ } => acc
  })
}

fn roadmap_dispatch_detent_defects() -> List<gunbc.design.interaction.DetentEdgeDefect> {
  gunbc.design.interaction.detent_edge_defects(detents: roadmap_dispatch_detents, edges: roadmap_detent_edges)
}
