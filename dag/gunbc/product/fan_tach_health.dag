module product.fan_tach_health

import std.types { Bool, Int, List, NonEmptyStr }
import std.measure { RevolutionsPerMinute }
import product.placement_supply { HostIdentity }
import gunbc.fleet_fan_tach_expectation {
  ChassisBayHeader,
  FanHeaderExpectationRow,
  FanHeaderRole,
  HostFanTachExpectation,
  ProcessorCoolerHeader,
  TachExpected,
  TachNotExpected,
}
import product.fan_tach { FanTachEndpointIdentity, FanTachWindow }
import v2.std.cardinality { Never }
import std.goal_assessment {
  GoalAssessment,
  GoalAssessmentRefused,
  GoalInspection,
  ObservationAttempt,
  ObservationEstablished,
  assess_by_deviations_and_unknowns,
  inspect_goal,
}

// THE JOIN, AND IT IS DRIVEN BY THE EXPECTATION RATHER THAN BY THE OBSERVATIONS.
//
// That direction is the whole safety property. Folding over the observations - which an earlier
// revision did - means a header the collector simply OMITTED produces no verdict at all: the
// judged denominator silently shrinks to whatever the collector happened to return, and the
// module whose entire purpose is to notice a missing reading fails open on a missing reading.
// It looked safe only because the witness hand-authored an explicit absent row for every gap,
// which is not an ingestion contract, it is the author remembering.
//
// So: every EXPECTED header must find exactly one observation or produce a typed gap, and every
// OBSERVATION must find exactly one declared header or produce a typed gap. Duplicates on either
// side refuse outright rather than being silently resolved by first-match, which is what both
// lookup folds used to do.

// WHY ABSENCE IS SPLIT. Rotation that was expected and did not happen is ONE verdict with TWO
// distinguishable causes, and the difference decides who looks at it: a rotor reading zero is
// evidence about a fan, while a sensor publishing nothing may be a missing Redfish object, a
// failed publication, or a header the BMC declines to report - which is evidence about the
// telemetry path.
type FanRotationAbsence
  = RotorNeverRotatedInWindow
  | TachValueNotPublished

// DEGRADED IS NOT ABSENT, AND IT TOOK A CONTROL TO SEE IT. A verdict vocabulary with only
// "rotating" and "not rotating" forced srv1's FAN4 and FAN5 into the wrong one: they rotate, at
// roughly 60% of the speed the same fans reach on the control host at the same duty, dropping
// out at 11/20 and 16/20 against a healthy baseline of 1-4/20. Called absent, they read as a
// hardware emergency; called healthy, they read as nothing. Neither is true.
//
// The floor and the reference are PARAMETERS rather than constants because both are policy about
// one fleet's telemetry, not facts about tachometers - and because a constant here would be a
// number measured on the current tree standing in as an oracle.

// NOTE WHAT IS ABSENT FROM THIS COPRODUCT: there is no FanFailed arm.
//
// A tach that does not report rotation is consistent with a stopped fan, a disconnected fan, a
// missing tach conductor, a failed splitter or connector, a sensor publication failure, a stale
// Redfish object, and a simply-wrong expectation. An earlier revision collapsed all seven into
// one verdict named for the first. Header grain can conclude that expected rotation was not
// observed; concluding that a FAN FAILED needs a like-for-like comparison and a physical
// inspection, and belongs to whoever does those.
// WHY THE SEVEN ARMS ARE THREE TYPES AND NOT ONE. `std.goal_assessment` separates evidence, proved
// deviations and facts that could not be established, and it separates them IN THE TYPE: a
// `GoalDiverged` carries `FreeSemigroup<Deviation>`. Handing that parameter a single seven-arm
// verdict would let a divergence list hold `RotationObserved` -- a healthy reading filed as a
// mismatch -- which is the exact edit that algebra's own annotation says nothing in the type would
// stop. Splitting the carriers makes that state unwritable rather than merely unwritten (DESIGN
// section 4b: construction over validation).
type FanTachHealthy
  = RotationObserved { header: NonEmptyStr, speed: RevolutionsPerMinute }
  | RotationCorrectlyAbsent { header: NonEmptyStr }

// A DEVIATION IS A FACT THAT WAS READ AND DISAGREES. Each of these four had a reading in hand: a
// rotor that turned too seldom, one that never turned, a header spinning that should not, a header
// reporting that the authority does not declare.
type FanTachDeviation
  = ExpectedRotationNotObserved {
      header: NonEmptyStr,
      role: FanHeaderRole,
      absence: FanRotationAbsence,
    }
  | RotationDegraded {
      header: NonEmptyStr,
      role: FanHeaderRole,
      rotating_count: Int,
      sample_count: Int,
    }
  | UnexpectedRotation { header: NonEmptyStr, speed: RevolutionsPerMinute }
  | ObservationForUndeclaredHeader { header: NonEmptyStr }

// AN UNKNOWN IS A HEADER THE COLLECTOR NEVER ANSWERED FOR, and it is the one arm whose migration
// CHANGES the reported answer rather than relabelling it. Under the old coproduct an expected
// header with no observation row was a verdict beside the others, so a host carrying one read as
// assessed. It is not: nothing about that fan was established, and `assess_by_deviations_and_unknowns`
// ranks it above any proved deviation for the reason that algebra states -- remediating a subject
// whose state is partly unread is licensed by an answer nobody has.
type FanTachUnknown
  = ExpectedHeaderObservationMissing { header: NonEmptyStr, role: FanHeaderRole }

// The per-header judgement, minted once so the classification logic stays one authority (DESIGN
// section 2). The three extractors below are projections of this sum, never a second fold that
// re-derives the same decision.
type FanTachJudgement
  = JudgedHealthy { healthy: FanTachHealthy }
  | JudgedDeviant { deviation: FanTachDeviation }
  | JudgedUnknown { unknown: FanTachUnknown }

type FanTachRefusalCause
  = DuplicateExpectedHeader { header: NonEmptyStr }
  | DuplicateObservedHeader { header: NonEmptyStr }
  | HostIdentityMismatch

// THE GOAL CARRIES THE FLOOR, because the floor is part of what is WANTED rather than part of what
// is seen: "every expected header rotates in at least N of its samples" is one sentence, and
// splitting it across a goal and a loose parameter would let a caller assess one host's
// expectation against another host's definition of healthy. It stays a parameter of the goal
// rather than a constant for the reason the fleet witness gives: a number measured on the current
// fleet must not quietly become the definition.
type FanTachGoal sole_constructor {
  expectation: HostFanTachExpectation,
  minimum_rotating: Int,
}

type FanTachObserved sole_constructor { windows: List<FanTachWindow> }

// The receipt a satisfied assessment carries. `headers_judged` is the DENOMINATOR the verdict was
// reached over -- the count this module exists to keep honest -- and the healthy rows ride with it
// so a green is inspectable rather than a bare token.
type FanTachReceipt sole_constructor {
  headers_judged: Int,
  healthy: List<FanTachHealthy>,
}

// The corpus row that declares the three facts together, destructured by `inspect_fan_tach` so no
// stage receives more than its own question needs.
//
// THERE IS NO `host` FIELD, AND ITS ABSENCE IS THE POINT. An earlier cut carried one beside
// `expectation.host` with nothing constraining them to agree, while the note here claimed invalid
// assembly was unwritable. It was not: a mismatched pair was constructible, `inspect_fan_tach`
// labelled the receipt from the subject's copy and `assess_fan_tach` joined windows against the
// expectation's, so an inspection could be filed under a host that was never assessed. The host is
// one fact, so it lives in one place (DESIGN section 3) and the inspection subject is DERIVED from
// it -- which is construction rather than an equality check bolted on afterwards.
type FanTachSubject sole_constructor {
  expectation: HostFanTachExpectation,
  minimum_rotating: Int,
  windows: List<FanTachWindow>,
}

type FanTachAssessment = GoalAssessment<FanTachReceipt, FanTachDeviation, FanTachUnknown, FanTachRefusalCause>

// THE CONSTRUCTORS LIVE HERE BECAUSE THE TYPES ARE `sole_constructor`: one authority mints them, so
// no caller can assemble a subject that skips a field or pairs a goal with a floor the row did not
// declare (DESIGN section 4b -- the invalid state has no constructor rather than a validator).
fn fan_tach_subject(
  expectation: HostFanTachExpectation,
  minimum_rotating: Int,
  windows: List<FanTachWindow>,
) -> FanTachSubject {
  FanTachSubject {
    expectation: expectation,
    minimum_rotating: minimum_rotating,
    windows: windows,
  }
}

fn fan_tach_goal(
  expectation: HostFanTachExpectation,
  minimum_rotating: Int,
) -> FanTachGoal {
  FanTachGoal { expectation: expectation, minimum_rotating: minimum_rotating }
}

fn fan_tach_observed(windows: List<FanTachWindow>) -> FanTachObserved {
  FanTachObserved { windows: windows }
}

fn count_header_in(headers: List<NonEmptyStr>, header: NonEmptyStr) -> Int {
  fold(headers, init: 0, f: (acc, h) => if h == header { acc + 1 } else { acc })
}

fn first_duplicate(headers: List<NonEmptyStr>) -> NonEmptyStr? {
  fold(
    headers,
    init: none,
    f: (acc, h) =>
      match acc {
        Present { value } => Present { value: value }
        none => if count_header_in(headers: headers, header: h) > 1 { Present { value: h } } else { none }
      },
  )
}

// NO HOST COMPARISON HERE, DELIBERATELY. assess_fan_tach refuses the whole assessment if any
// window carries a host other than the expectation's, so by the time this runs every window is
// already this host's. A host check here would be a SECOND representation of a constraint the
// boundary already holds - and it was measured unreachable rather than merely quiet: removing it
// left the witness green, because no input can reach this function carrying a foreign host.
fn window_for(
  windows: List<FanTachWindow>,
  header: NonEmptyStr,
) -> FanTachWindow? {
  fold(
    windows,
    init: none,
    f: (acc, w) =>
      match acc {
        Present { value } => Present { value: value }
        none =>
          if w.endpoint.name == header {
            Present { value: w }
          } else {
            none
          }
      },
  )
}

fn expectation_for(
  expectation: HostFanTachExpectation,
  header: NonEmptyStr,
) -> FanHeaderExpectationRow? {
  fold(
    expectation.headers,
    init: none,
    f: (acc, row) =>
      match acc {
        Present { value } => Present { value: value }
        none => if row.header == header { Present { value: row } } else { none }
      },
  )
}

fn judge_expected(
  header: NonEmptyStr,
  role: FanHeaderRole,
  windows: List<FanTachWindow>,
  minimum_rotating: Int,
) -> FanTachJudgement {
  match window_for(windows: windows, header: header) {
    none => JudgedUnknown {
      unknown: ExpectedHeaderObservationMissing { header: header, role: role },
    }
    Present { value: w } =>
      if w.rotating_count == 0 {
        if w.unavailable_count == w.sample_count {
          JudgedDeviant {
            deviation: ExpectedRotationNotObserved {
              header: header,
              role: role,
              absence: TachValueNotPublished,
            },
          }
        } else {
          JudgedDeviant {
            deviation: ExpectedRotationNotObserved {
              header: header,
              role: role,
              absence: RotorNeverRotatedInWindow,
            },
          }
        }
      } else {
        if w.rotating_count >= minimum_rotating {
          JudgedHealthy { healthy: RotationObserved { header: header, speed: w.median } }
        } else {
          JudgedDeviant {
            deviation: RotationDegraded {
              header: header,
              role: role,
              rotating_count: w.rotating_count,
              sample_count: w.sample_count,
            },
          }
        }
      }
  }
}

fn judge_unexpected(
  header: NonEmptyStr,
  windows: List<FanTachWindow>,
) -> FanTachJudgement {
  match window_for(windows: windows, header: header) {
    none => JudgedHealthy { healthy: RotationCorrectlyAbsent { header: header } }
    Present { value: w } =>
      if w.rotating_count > 0 {
        JudgedDeviant { deviation: UnexpectedRotation { header: header, speed: w.median } }
      } else {
        JudgedHealthy { healthy: RotationCorrectlyAbsent { header: header } }
      }
  }
}

fn fan_tach_judgements(
  goal: FanTachGoal,
  observed: FanTachObserved,
) -> List<FanTachJudgement> {
  flat_map(
    [
      map(
        goal.expectation.headers,
        row =>
          match row.expectation {
            TachExpected { role } =>
              judge_expected(
                header: row.header,
                role: role,
                windows: observed.windows,
                minimum_rotating: goal.minimum_rotating,
              )
            TachNotExpected =>
              judge_unexpected(header: row.header, windows: observed.windows)
          },
      ),
      map(
        filter(
          observed.windows,
          w =>
            match expectation_for(expectation: goal.expectation, header: w.endpoint.name) {
              Present { value } => false
              none => true
            },
        ),
        w => JudgedDeviant {
          deviation: ObservationForUndeclaredHeader { header: w.endpoint.name },
        },
      ),
    ],
    group => group,
  )
}

fn judged_healthy(judgements: List<FanTachJudgement>) -> List<FanTachHealthy> {
  flat_map(
    judgements,
    j =>
      match j {
        JudgedHealthy { healthy } => [healthy]
        JudgedDeviant { deviation } => []
        JudgedUnknown { unknown } => []
      },
  )
}

fn judged_deviations(judgements: List<FanTachJudgement>) -> List<FanTachDeviation> {
  flat_map(
    judgements,
    j =>
      match j {
        JudgedHealthy { healthy } => []
        JudgedDeviant { deviation } => [deviation]
        JudgedUnknown { unknown } => []
      },
  )
}

fn judged_unknowns(judgements: List<FanTachJudgement>) -> List<FanTachUnknown> {
  flat_map(
    judgements,
    j =>
      match j {
        JudgedHealthy { healthy } => []
        JudgedDeviant { deviation } => []
        JudgedUnknown { unknown } => [unknown]
      },
  )
}

// THE THREE REFUSAL CAUSES ARE ILL-FORMED QUESTIONS, NOT UNHEALTHY FANS, and that distinction is
// why this binding is the one `std.goal_assessment` named as the trigger for its
// `GoalAssessmentRefused` frontier. A host paired to another host's windows, a roster naming one
// header twice, a collector answering twice for one endpoint: none of them is a state of the
// cooling system, and none can be honestly reported as agreement or divergence.
//
// THE HOST CHECK RUNS BEFORE THE DUPLICATE CHECKS, deliberately and in this order. Windows
// belonging to another host make every downstream join meaningless, so a duplicate found among
// them would name a header on a machine nobody asked about.
fn assess_fan_tach(
  goal: FanTachGoal,
  observed: FanTachObserved,
) -> FanTachAssessment {
  if fold(
    observed.windows,
    init: false,
    f: (acc, w) => if acc { true } else { w.endpoint.host != goal.expectation.host },
  ) {
    GoalAssessmentRefused { cause: HostIdentityMismatch }
  } else {
    match first_duplicate(headers: map(goal.expectation.headers, row => row.header)) {
      Present { value: header } =>
        GoalAssessmentRefused { cause: DuplicateExpectedHeader { header: header } }
      none =>
        match first_duplicate(headers: map(observed.windows, w => w.endpoint.name)) {
          Present { value: header } =>
            GoalAssessmentRefused { cause: DuplicateObservedHeader { header: header } }
          none => {
            let judgements = fan_tach_judgements(goal: goal, observed: observed)
            assess_by_deviations_and_unknowns(
              evidence: FanTachReceipt {
                headers_judged: judgements.length(),
                healthy: judged_healthy(judgements: judgements),
              },
              deviations: judged_deviations(judgements: judgements),
              unknowns: judged_unknowns(judgements: judgements),
            )
          }
        }
    }
  }
}

// THE OBSERVER CANNOT SEE THE GOAL, and that is enforced by `inspect_goal`'s shape rather than by
// this module's restraint: `observe` receives the subject and the request only. Here the windows
// arrive already read, so the observation is total and its refusal parameter is `Never` -- an
// arm with no constructor, not an arm nobody happens to build.
fn observe_fan_tach_attempt(
  host: HostIdentity,
  request: List<FanTachWindow>,
) -> ObservationAttempt<FanTachObserved, Never> {
  ObservationEstablished { observed: FanTachObserved { windows: request } }
}

type FanTachInspection = GoalInspection<HostIdentity, FanTachGoal, List<FanTachWindow>, FanTachObserved, FanTachReceipt, FanTachDeviation, FanTachUnknown, Never, FanTachRefusalCause>

fn inspect_fan_tach(subject: FanTachSubject) -> FanTachInspection {
  inspect_goal(
    subject: subject.expectation.host,
    goal: FanTachGoal {
      expectation: subject.expectation,
      minimum_rotating: subject.minimum_rotating,
    },
    request: subject.windows,
    observe: observe_fan_tach_attempt,
    assess: assess_fan_tach,
  )
}

// COUNTS ARE SPLIT BY OWNER, NOT COLLAPSED INTO ONE NUMBER. An earlier revision summed rotation
// anomalies, expectation drift and authority gaps into a single failure_count while its own
// annotation correctly said the three have different owners - a hardware investigation, a stale
// inventory, and an incomplete authority. A combined number is a display summary at best; as the
// module's semantic output it re-does the conflation one level up.

// THE HEALTHY ARMS GET COUNTERS TOO, so that all seven judgement arms are counted by one typed
// authority rather than six here and one re-minted at each call site. A consumer asking "how many
// endpoints are spinning" is asking about the same classification as one asking how many drifted.
fn rotation_observed_count(healthy: List<FanTachHealthy>) -> Int {
  fold(
    healthy,
    init: 0,
    f: (acc, h) =>
      match h {
        RotationObserved { header, speed } => acc + 1
        other => acc
      },
  )
}

fn rotation_correctly_absent_count(healthy: List<FanTachHealthy>) -> Int {
  fold(
    healthy,
    init: 0,
    f: (acc, h) =>
      match h {
        RotationCorrectlyAbsent { header } => acc + 1
        other => acc
      },
  )
}

fn rotation_anomaly_count(deviations: List<FanTachDeviation>) -> Int {
  fold(
    deviations,
    init: 0,
    f: (acc, d) =>
      match d {
        ExpectedRotationNotObserved { header, role, absence } => acc + 1
        other => acc
      },
  )
}

fn rotation_degraded_count(deviations: List<FanTachDeviation>) -> Int {
  fold(
    deviations,
    init: 0,
    f: (acc, d) =>
      match d {
        RotationDegraded { header, role, rotating_count, sample_count } => acc + 1
        other => acc
      },
  )
}

fn expectation_drift_count(deviations: List<FanTachDeviation>) -> Int {
  fold(
    deviations,
    init: 0,
    f: (acc, d) =>
      match d {
        UnexpectedRotation { header, speed } => acc + 1
        other => acc
      },
  )
}

fn authority_gap_count(deviations: List<FanTachDeviation>) -> Int {
  fold(
    deviations,
    init: 0,
    f: (acc, d) =>
      match d {
        ObservationForUndeclaredHeader { header } => acc + 1
        other => acc
      },
  )
}

// THE OBSERVATION GAP IS COUNTED OVER UNKNOWNS, NOT DEVIATIONS, and the type now says so. Before
// the split this count folded the same list as the four above, which read as though a header
// nobody answered for were one more anomaly beside a degraded rotor.
fn observation_gap_count(unknowns: List<FanTachUnknown>) -> Int {
  fold(
    unknowns,
    init: 0,
    f: (acc, u) =>
      match u {
        ExpectedHeaderObservationMissing { header, role } => acc + 1
      },
  )
}
