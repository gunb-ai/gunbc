module product.printed_chassis.export_profile

import std.types { Bool, String, NonEmptyStr, List }
import std.nat { Nat }
import std.measure { Micrometer, micrometer, Nanometer, nanometer, nanometer_count, micrometer_to_nanometer }
import extdeps.cadquery.cadquery { StlExportKnobs, stl_export_knobs, stl_export_knobs_eq, RelativeDeflection, AbsoluteDeflection }

// HOW ROUND A HOLE COMES OUT IS A MEASUREMENT DECISION, NOT A FILE-FORMAT DETAIL.
//
// STL is a mesh format, so every modelled circle leaves the kernel as a polygon inscribed in it.
// An inscribed polygon lies inside the circle everywhere between its vertices, so an exported hole
// is systematically UNDERSIZE by the chord sagitta -- one-directional, never oversize. For a
// hole-diameter calibration coupon that is not cosmetic: the coupon exists to resolve one ladder
// rung, and if tessellation moves a diameter by an appreciable fraction of that rung, the coupon is
// measuring the exporter as much as the printer.
//
// gunbc.product.printed_chassis.cadquery_realization deliberately emitted no export call and left
// this open with its trigger stated as a runner with cadquery importable. That trigger has fired --
// extdeps.package_managers.conda_forge records the route -- so the profile is authored against
// MEASURED deviation rather than the seven blind literals the obligation was filed to avoid.

// THE SUBJECT IS THE JOIN KEY, and it exists so an observation and a requirement about the same
// feature can be authored independently and still be adjudicated against each other. Two features
// of identical nominal diameter can carry different requirements, because the requirement comes
// from the consumer question, not from the size.
type ChordSubject sole_constructor { feature: NonEmptyStr }

fn chord_subject(feature: NonEmptyStr) -> ChordSubject { ChordSubject { feature: feature } }
fn chord_subject_feature(s: ChordSubject) -> NonEmptyStr { s.feature }
fn chord_subject_eq(a: ChordSubject, b: ChordSubject) -> Bool {
  (a.feature as String) == (b.feature as String)
}

// WHAT THE INSTRUMENT REPORTED, AND NOTHING ELSE. An earlier shape of this module hung the required
// distinction off the observation itself, which quietly asserts that the instrument measured the
// requirement. It did not: a mesh export reports a deviation, and how small that deviation must be
// is a decision someone AUTHORED. Storing them in one row makes a decision look like a reading.
//
// The undersize is nanometres because it is genuinely sub-micrometre on the smallest features, and
// rounding to micrometres would report zero deviation for exactly the cases whose margin is claimed.
// THE OBSERVATION CARRIES THE PROFILE IT WAS MEASURED UNDER, so a deviation can never be presented
// as evidence for a profile it never ran against. The earlier shape took knobs as a free argument
// beside the standings, which admits measure-under-P1 then admit-P2 -- and this module's own history
// says why that is not paranoia: the first tolerance study re-exported a cached mesh, so a number
// here can be about a different export than the one being authorized without anything looking wrong.
type ChordObservation sole_constructor {
  subject: ChordSubject
  nominal_diameter: Micrometer
  measured_undersize: Nanometer
  measured_under: StlExportKnobs
  instrument: NonEmptyStr
}

fn chord_observation(
  subject: ChordSubject,
  nominal_diameter: Micrometer,
  measured_undersize: Nanometer,
  measured_under: StlExportKnobs,
  instrument: NonEmptyStr,
) -> ChordObservation {
  ChordObservation {
    subject: subject,
    nominal_diameter: nominal_diameter,
    measured_undersize: measured_undersize,
    measured_under: measured_under,
    instrument: instrument,
  }
}

fn observation_profile(o: ChordObservation) -> StlExportKnobs { o.measured_under }

fn observation_subject(o: ChordObservation) -> ChordSubject { o.subject }

// THE REQUIREMENT, AUTHORED, WITH THE AUTHORITY THAT SETTLES IT. Undeclared is a real arm rather
// than a missing row: for some features the consumer question genuinely has no measured answer yet,
// and a default would answer for it in the flattering direction.
type ChordRequirement
  = DistinctionDeclared {
      subject: ChordSubject
      smallest: Micrometer
      authority: NonEmptyStr
    }
  | DistinctionUndeclared { subject: ChordSubject, because: NonEmptyStr }

fn requirement_subject(r: ChordRequirement) -> ChordSubject {
  match r {
    DistinctionDeclared { subject: s, smallest: _, authority: _ } => s
    DistinctionUndeclared { subject: s, because: _ } => s
  }
}

// THE FACTOR IS A POLICY BUDGET WITH AN EXTERNAL REFERENT, not a number chosen because it looked
// safe. An earlier revision carried a bare 20 governing which observations refuse, which is the
// ungrounded literal DESIGN section 5 refuses in a merge-blocking position: nothing beside it said
// what would make it wrong.
//
// THE REFERENT IS THE GAUGEMAKER'S RULE, the metrology convention that a measuring instrument
// should resolve about ten times finer than the tolerance it is used to judge. Under that rule the
// mesh is the instrument and the ladder rung is the tolerance, so the rule alone would set this at
// ten.
//
// WHY THIS REPOSITORY DOUBLES IT. The rule is stated for RANDOM instrument error, which partially
// cancels across repeated readings. Tessellation error is not random: an inscribed polygon lies
// inside the circle every time, so the deviation is SYSTEMATIC and one-directional and averages
// away to nothing. A bias does not earn the cancellation the rule assumes, so the budget is set at
// twice the conventional ratio. That is the whole justification, and it is falsifiable: establish a
// bound showing the bias is compensated elsewhere in the chain and the doubling should go.
// THE TWO FACTS ARE HELD APART AND THE RATIO IS DERIVED, so attribution is exact. Authoring 20 with
// the rule named beside it would read as though the gaugemaker convention said twenty. It does not:
// it says ten. The doubling is this repository's policy and it is separately falsifiable.
type ChordBudgetPolicy sole_constructor {
  cited_ratio: Nat
  cited_convention: NonEmptyStr
  directional_bias_margin: Nat
  margin_rationale: NonEmptyStr
}

fn budget_required_ratio(b: ChordBudgetPolicy) -> Nat { b.cited_ratio * b.directional_bias_margin }

data chord_error_budget: ChordBudgetPolicy = ChordBudgetPolicy {
  cited_ratio: 10,
  cited_convention: "gaugemaker's rule: an instrument resolves ten times finer than the tolerance it judges",
  directional_bias_margin: 2,
  margin_rationale: "the cited rule is stated for random error that partially cancels; an inscribed polygon undersizes every time, so this bias never averages out and does not earn that cancellation",
}

// THE COMPARISON IS A MULTIPLICATION, NOT A SUBTRACTION, and that is load-bearing rather than
// stylistic. Nat subtraction in this substrate yields a NEGATIVE value: it neither saturates nor
// refuses, so `smallest - undersize > 0` would silently read as satisfied for exactly the
// observations that blow the budget. Scaling the observation up has no such arm.
data chord_error_safety_factor: Nat = budget_required_ratio(b: chord_error_budget)

// ADJUDICATION JOINS THE TWO BY SUBJECT. A pair whose subjects disagree is not a weak verdict, it is
// a mis-join, and it takes its own arm rather than being folded into a refusal that would read as a
// finding about the geometry.
type ChordStanding
  = WithinRequiredDistinction { observation: ChordObservation, requirement: ChordRequirement }
  | ExceedsRequiredDistinction { observation: ChordObservation, requirement: ChordRequirement }
  | RequiredDistinctionUndeclared { observation: ChordObservation, requirement: ChordRequirement }
  | ChordSubjectMismatch { observation: ChordObservation, requirement: ChordRequirement }

fn adjudicate_chord(o: ChordObservation, r: ChordRequirement) -> ChordStanding {
  if chord_subject_eq(a: observation_subject(o: o), b: requirement_subject(r: r)) == false {
    ChordSubjectMismatch { observation: o, requirement: r }
  } else {
    match r {
      DistinctionUndeclared { subject: _, because: _ } =>
        RequiredDistinctionUndeclared { observation: o, requirement: r }
      DistinctionDeclared { subject: _, smallest: s, authority: _ } =>
        if nanometer_count(n: o.measured_undersize) * chord_error_safety_factor
             <= nanometer_count(n: micrometer_to_nanometer(m: s)) {
          WithinRequiredDistinction { observation: o, requirement: r }
        } else {
          ExceedsRequiredDistinction { observation: o, requirement: r }
        }
    }
  }
}

fn standing_profile(s: ChordStanding) -> StlExportKnobs {
  match s {
    WithinRequiredDistinction { observation: o, requirement: _ } => observation_profile(o: o)
    ExceedsRequiredDistinction { observation: o, requirement: _ } => observation_profile(o: o)
    RequiredDistinctionUndeclared { observation: o, requirement: _ } => observation_profile(o: o)
    ChordSubjectMismatch { observation: o, requirement: _ } => observation_profile(o: o)
  }
}

fn standing_subject(s: ChordStanding) -> ChordSubject {
  match s {
    WithinRequiredDistinction { observation: o, requirement: _ } => observation_subject(o: o)
    ExceedsRequiredDistinction { observation: o, requirement: _ } => observation_subject(o: o)
    RequiredDistinctionUndeclared { observation: o, requirement: _ } => observation_subject(o: o)
    ChordSubjectMismatch { observation: o, requirement: _ } => observation_subject(o: o)
  }
}

fn count_standings_for(subject: ChordSubject, standings: List<ChordStanding>) -> Nat {
  fold(standings, init: 0, f: (acc, st) =>
    if chord_subject_eq(a: standing_subject(s: st), b: subject) { acc + 1 } else { acc })
}

fn subject_in_roster(subject: ChordSubject, roster: List<ChordSubject>) -> Bool {
  fold(roster, init: false, f: (acc, r) => acc || chord_subject_eq(a: r, b: subject))
}

fn standing_is_within(s: ChordStanding) -> Bool {
  match s {
    WithinRequiredDistinction { observation: _, requirement: _ } => true
    ExceedsRequiredDistinction { observation: _, requirement: _ } => false
    RequiredDistinctionUndeclared { observation: _, requirement: _ } => false
    ChordSubjectMismatch { observation: _, requirement: _ } => false
  }
}

// THE ROSTER IS THE DENOMINATOR, AND IT IS DECLARED RATHER THAN INFERRED FROM THE EVIDENCE.
//
// This is the defect that a review found and that an earlier witness in this module DEMONSTRATED
// while being read as closing it. The admission used to take only the standings a caller chose to
// supply, so "every standing I was handed passed" was returned as "the profile is safe". A caller
// holding one green coupon standing and omitting both fan features received an admission, and the
// paired witness that removed the undeclared feature and watched the call flip to admitted was
// exhibiting exactly that writable state rather than proving a refusal.
//
// The repair is the same one this module already applies one level down. There, a measurement may
// not carry its own pass criterion; here, evidence may not select its own subject population. Both
// are the wrong-denominator error, and this one is worse because it is invisible: nothing about a
// short list looks short.
data export_profile_subject_roster: List<ChordSubject> = [
  coupon_top_rung_subject,
  fan_mounting_hole_subject,
  fan_bore_subject,
]

// COVERAGE IS AN IDENTITY JOIN, NOT A COUNT. Equal cardinality is satisfied by a foreign subject
// standing in for a missing one, which is the substitution most likely to occur and least likely to
// be noticed. Missing, foreign and duplicated are separate arms because they have separate remedies:
// measure the feature, remove the stray, or resolve which of two readings is the one that counts.
type SubjectCoverage
  = CoverageComplete
  | CoverageMissing { subjects: List<ChordSubject> }
  | CoverageForeign { subjects: List<ChordSubject> }
  | CoverageDuplicated { subjects: List<ChordSubject> }

fn cover_roster(roster: List<ChordSubject>, standings: List<ChordStanding>) -> SubjectCoverage {
  let missing = filter(roster, r => count_standings_for(subject: r, standings: standings) == 0)
  let duplicated = filter(roster, r => count_standings_for(subject: r, standings: standings) > 1)
  let foreign = filter(
    map(standings, st => standing_subject(s: st)),
    sub => subject_in_roster(subject: sub, roster: roster) == false,
  )
  if missing.length() > 0 {
    CoverageMissing { subjects: missing }
  } else {
    if foreign.length() > 0 {
      CoverageForeign { subjects: foreign }
    } else {
      if duplicated.length() > 0 {
        CoverageDuplicated { subjects: duplicated }
      } else {
        CoverageComplete
      }
    }
  }
}

// THE ADMITTED PROFILE IS DERIVED FROM THE EVIDENCE, NEVER SUPPLIED BESIDE IT. There is no `knobs`
// parameter: the profile an admission authorizes is the one every observation was measured under,
// and if the standings do not agree on that profile the admission refuses. A caller cannot name the
// profile it wants blessed.
type ExportProfileAdmission
  = ExportProfileAdmitted { knobs: StlExportKnobs, standings: List<ChordStanding> }
  | ExportProfileRefusedIncomplete { coverage: SubjectCoverage }
  | ExportProfileRefusedUnsettled { unsettled: List<ChordStanding> }
  | ExportProfileRefusedProfileDisagreement { standings: List<ChordStanding> }

// COVERAGE IS PROVEN BEFORE ANY GEOMETRY IS FOLDED, so a short or mismatched evidence set can never
// reach the arm that reports on deviations. The empty list needs no special case any more: it is
// simply the coverage failure that misses every rostered subject, which is a better diagnostic than
// the bare "unmeasured" arm it replaces because it names WHICH subjects are unaccounted for.
fn standings_share_one_profile(standings: List<ChordStanding>) -> Bool {
  fold(standings, init: true, f: (acc, st) =>
    acc && fold(standings, init: true, f: (inner, other) =>
      inner && stl_export_knobs_eq(a: standing_profile(s: st), b: standing_profile(s: other))))
}

// THE ROSTER IS CLOSED OVER, NOT RECEIVED. An earlier revision took the roster as a parameter, which
// moved the writable denominator one argument to the left rather than removing it: a caller could
// still name [coupon_top_rung_subject], omit both fan features, and be admitted. The paired witness
// that watched a one-subject roster admit was exhibiting that state, not closing it. Coverage stays
// roster-parametric in cover_roster, where varying the roster against fixed evidence is the whole
// content of the discriminator; production admission may not offer that knob to anyone.
fn admit_export_profile(standings: List<ChordStanding>) -> ExportProfileAdmission {
  match cover_roster(roster: export_profile_subject_roster, standings: standings) {
    CoverageMissing { subjects: m } =>
      ExportProfileRefusedIncomplete { coverage: CoverageMissing { subjects: m } }
    CoverageForeign { subjects: f } =>
      ExportProfileRefusedIncomplete { coverage: CoverageForeign { subjects: f } }
    CoverageDuplicated { subjects: d } =>
      ExportProfileRefusedIncomplete { coverage: CoverageDuplicated { subjects: d } }
    CoverageComplete =>
      if standings_share_one_profile(standings: standings) == false {
        ExportProfileRefusedProfileDisagreement { standings: standings }
      } else {
        let unsettled = filter(standings, s => standing_is_within(s: s) == false)
        if unsettled.length() > 0 {
          ExportProfileRefusedUnsettled { unsettled: unsettled }
        } else {
          ExportProfileAdmitted {
            knobs: fold(standings, init: exercised_stl_knobs, f: (acc, st) => standing_profile(s: st)),
            standings: standings,
          }
        }
      }
  }
}

// THE PROFILE THAT WAS ACTUALLY EXERCISED.
//
// WHY THESE VALUES. Under ABSOLUTE deflection the linear tolerance is the control that matters: it
// bounds the chord error as a length, and at one micrometre every feature from a 3 mm hole to a
// 76 mm bore lands near 1000 nm undersize regardless of size. That size-independence is the property
// worth having, because a coupon and a bore should not be held to accidentally different fidelity.
//
// AN EARLIER REVISION CLAIMED THE LINEAR KNOB WAS INERT AND THAT WAS WRONG. It is inert under
// RELATIVE deflection, which is what cq.exporters.export silently selects, and the deviation there
// scales with diameter instead -- 932 nm on a 3 mm hole against 23622 nm on the bore, a 24x spread
// that had nothing to do with either part's requirement. Declaring the interpretation is what turned
// the knob back into a control.
//
// HOW THAT MEASUREMENT WENT WRONG FIRST, because the failure is reproducible and quiet. OCC caches a
// triangulation on the shape, so re-exporting one shape at five tolerances returns the FIRST mesh
// five times -- the facet count sat unchanged and read as evidence that the knob did nothing. The
// control only flips when the shape is rebuilt per setting.
data exercised_stl_knobs: StlExportKnobs = stl_export_knobs(
  linear_tolerance: micrometer(count: 1),
  angular_tolerance_text: "0.1",
  deflection: AbsoluteDeflection,
)

// THE SUBJECT NAMES A FEATURE ON A PART, NOT A DIAMETER. An earlier revision of this roster labelled
// the 4.4 mm measurement a coupon rung. It is not one: the coupon ladder runs 3.00 to 4.00 mm, and
// 4.4 mm is the fan mount's FASTENER hole. Attaching the coupon's rung spacing to it would have been
// the wrong-denominator error a second time, wearing a subject name instead of a bare number.
data coupon_top_rung_subject: ChordSubject = chord_subject(feature: "coupon ladder top rung hole, 4.00 mm")
data fan_mounting_hole_subject: ChordSubject = chord_subject(feature: "fan mount fastener hole, 4.40 mm")
data fan_bore_subject: ChordSubject = chord_subject(feature: "fan mount bore, 76.00 mm")

// THE DEVIATION IS A DIAMETER DEVIATION, and saying so is a correction rather than a clarification.
// The first numbers carried here were RADIUS deviations reported under a diameter's name -- a factor
// of two, in the flattering direction, on the one quantity the coupon exists to resolve. The
// instrument string records which quantity is meant so the same conflation cannot be re-entered
// silently. The undersize is worst at the LARGEST rung, so the top rung is the one measured.
data exercised_chord_observations: List<ChordObservation> = [
  chord_observation(
    subject: coupon_top_rung_subject,
    nominal_diameter: micrometer(count: 4000),
    measured_undersize: nanometer(count: 993),
    measured_under: exercised_stl_knobs,
    instrument: "141 segments under absolute deflection; (r - r*cos(pi/n)) * 2, a DIAMETER undersize",
  ),
  chord_observation(
    subject: fan_mounting_hole_subject,
    nominal_diameter: micrometer(count: 4400),
    measured_undersize: nanometer(count: 991),
    measured_under: exercised_stl_knobs,
    instrument: "148 segments under absolute deflection; (r - r*cos(pi/n)) * 2, a DIAMETER undersize",
  ),
  chord_observation(
    subject: fan_bore_subject,
    nominal_diameter: micrometer(count: 76000),
    measured_undersize: nanometer(count: 998),
    measured_under: exercised_stl_knobs,
    instrument: "613 segments under absolute deflection; (r - r*cos(pi/n)) * 2, a DIAMETER undersize",
  ),
]

// WHAT THE RATIO DOES AND DOES NOT ESTABLISH, stated because the stronger reading is the tempting
// one. The measured undersize is a small fraction of the coupon's rung spacing. That is a statement
// about ONE DEVIATION AGAINST ONE SPACING. It is NOT yet a guarantee that two independently
// approximated rungs stay distinguishable: that conclusion needs the error LAW, not one sample, and
// what has been established about the law so far is only its DIRECTION -- an inscribed polygon can
// only undersize -- not a bound holding across every rung. So the requirement below is authored as
// the rung spacing with a safety factor, and the distinguishability claim is deliberately not made.
data exercised_chord_requirements: List<ChordRequirement> = [
  DistinctionDeclared {
    subject: coupon_top_rung_subject,
    smallest: micrometer(count: 100),
    authority: "hole_ladder_spec step in gunbc.product.printed_chassis.coupon",
  },
  DistinctionUndeclared {
    subject: fan_mounting_hole_subject,
    because: "the fit this hole must hold against an M4 fastener has not been measured",
  },
  DistinctionUndeclared {
    subject: fan_bore_subject,
    because: "the clearance an 80 mm fan body needs through this bore has not been measured",
  },
]
