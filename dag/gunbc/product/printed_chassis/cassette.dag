module product.printed_chassis.cassette

import std.types { Bool, Int, String, List }
import std.measure { micrometer_count }
import std.euclidean_geometry { Axis3X, Axis3Y, Axis3Z }
import product.printed_chassis.assembly_geometry {
  Primitive, AssemblyPart, MechanicalInterface, Printed, Purchased, Metal, Clearance,
  Cassette, FixedFrame, LayOnXZ, LayOnXY, LayOnYZ, block, round, part, mechanical_interface, M3PanelClamp,PrintedRetainingPin,M4FanThroughBolt,BoardSupportPending,ProtectedDcBranch,BondingHardwarePending,Proposed,OriginalPlateFitOnly,Unresolved,
}
import extdeps.boards.asrock_rack { asrock_altrad8ud_extent_along_rear_io, asrock_altrad8ud_extent_depth }
import product.printed_chassis.fan_mount {
  arctic_p8_fan_mount, FanMountAdmitted, FanMountBoreReachesMountingHoles, FanMountBoreNotEnclosedByPlate, FanMountPlateSmallerThanPattern, fan_mount_plate, fan_mount_bore, fan_mount_mounting_holes,
}
import product.printed_chassis.coupon { OpThroughHole }
import extdeps.fans.arctic { arctic_p8_mounting_pattern }

// This root owns the entire review assembly formerly authored in the browser.
// Nominal board lengths come from the board authority; design allowances below are proposals.
// No measured board thickness, standoff thread, PSU rating or thermal result is invented.
data board_w: Int = micrometer_count(m: asrock_altrad8ud_extent_along_rear_io)
data board_d: Int = micrometer_count(m: asrock_altrad8ud_extent_depth)
data margin: Int = 14000
data tray_w: Int = board_w + 2 * margin
data tray_d: Int = board_d + 2 * margin
data panel_t: Int = 8000
data seam: Int = 400
data panel_w: Int = (tray_w-seam)/2
data panel_d: Int = (tray_d-seam)/2
data bay_pitch: Int = 140000
data bay_w: Int = tray_w+48000
data rear_plate_z: Int = 0-tray_d/2-76000
data rear_beam_z: Int = rear_plate_z+20000
data fan_spacing: Int = 94000
data fan_hole_offset: Int = micrometer_count(m:arctic_p8_mounting_pattern.hole_pitch)/2
data fan_hole_d: Int = micrometer_count(m:arctic_p8_mounting_pattern.hole_clearance_diameter)
data m3_clearance: Int = 3400
data joint_clearance: Int = 250

type LapJoint {id:String,donor:String,receiver:String,x:Int,z:Int,along_x:Bool,span:Int,clamp_x:Int,clamp_z:Int}
fn lap_joints() -> List<LapJoint> {
 let cx=(tray_w+seam)/4
 let cz=(tray_d+seam)/4
 let dx=panel_w/2-36000
 let dz=panel_d/2-36000
 [LapJoint {id:"rear-row",donor:"P1",receiver:"P2",x:9500-seam/2,z:0-cz,along_x:true,span:dz,clamp_x:10000,clamp_z:0-cz+dz},
  LapJoint {id:"front-row",donor:"P3",receiver:"P4",x:9500-seam/2,z:cz,along_x:true,span:dz,clamp_x:10000,clamp_z:cz+dz},
  LapJoint {id:"left-column",donor:"P1",receiver:"P3",x:0-cx,z:9500-seam/2,along_x:false,span:dx,clamp_x:0-cx-dx,clamp_z:10000},
  LapJoint {id:"right-column",donor:"P2",receiver:"P4",x:cx,z:9500-seam/2,along_x:false,span:dx,clamp_x:cx+dx,clamp_z:10000}]
}
fn lap_features(j:LapJoint,receiver:Bool,cx:Int,cz:Int) -> List<Primitive> {
 let clearance=if receiver {joint_clearance} else {0}
 flat_map([-1,1],fn(sign){[block(w:(if j.along_x {21000} else {28000})+2*clearance,h:4000+2*clearance,d:(if j.along_x {28000} else {21000})+2*clearance,x:j.x-cx+(if j.along_x {0} else {sign*j.span}),y:2000,z:j.z-cz+(if j.along_x {sign*j.span} else {0}))]})
}
fn hole_y(d:Int,x:Int,z:Int) -> Primitive {round(diameter:d,length:50000,axis:Axis3Y,x:x,y:0,z:z)}
fn panel(sx:Int,sz:Int,id:String) -> AssemblyPart {
 let cx=sx*(tray_w+seam)/4
 let cz=sz*(tray_d+seam)/4
 let own=filter(lap_joints(),j=>j.donor==id)
 let receiving=filter(lap_joints(),j=>j.receiver==id)
 let laps=flat_map(own,j=>lap_features(j:j,receiver:false,cx:cx,cz:cz))
 let pockets=flat_map(receiving,j=>lap_features(j:j,receiver:true,cx:cx,cz:cz))
 let clamps=map(filter(lap_joints(),j=>j.donor==id||j.receiver==id),j=>hole_y(d:m3_clearance,x:j.clamp_x-cx,z:j.clamp_z-cz))
 let slot_w=(panel_w-56000)/4
 let vents=flat_map([0,1,2,3],fn(i){
  let x=0-panel_w/2+28000+slot_w/2+i*slot_w
  let width=slot_w-5000
  let half=(panel_d-65000-width)/2
  [block(w:width,h:12000,d:2*half,x:x,y:4000,z:0),round(diameter:width,length:12000,axis:Axis3Y,x:x,y:4000,z:half),round(diameter:width,length:12000,axis:Axis3Y,x:x,y:4000,z:0-half)]
 })
 let rails=[block(w:14000,h:4000,d:panel_d,x:sx*(panel_w/2-1000),y: -2000,z:0),block(w:6000,h:12000,d:panel_d,x:sx*(panel_w/2+2000),y:4000,z:0)]
 let handle=if sz==1 {[block(w:54800,h:8000,d:10000,x:sx*27600-cx,y:4000,z:tray_d/2+22000-cz),block(w:10000,h:8000,d:28000,x:sx*50000-cx,y:4000,z:tray_d/2+13000-cz)]} else {[]}
 let dock_x=sx*(tray_w/2-7000)-cx
 let dock_z=0-tray_d/2+24000-cz
 let socket=if sz== -1 {[block(w:27000,h:3000,d:42000,x:dock_x,y: -13500,z:dock_z),block(w:3000,h:11000,d:42000,x:dock_x-12000,y: -6500,z:dock_z),block(w:3000,h:11000,d:42000,x:dock_x+12000,y: -6500,z:dock_z)]} else {[]}
 let pin=if sz== -1 {[hole_y(d:4400,x:dock_x,z:0-tray_d/2+22000-cz)]} else {[]}
 part(id:id,name:concat("Keyed tray panel ",id),kind:Printed,scope:Cassette,adds:concat([block(w:panel_w,h:panel_t,d:panel_d,x:0,y:4000,z:0)],concat(laps,concat(rails,concat(handle,socket)))),cuts:concat(pockets,concat(vents,concat(clamps,pin))),x:cx,y:0,z:cz,ex:sx*65000,ey:12000,ez:sz*55000,plane:LayOnXZ,notes:"Two keyed laps per seam register and carry shear; one M3 clamp per seam, four total. Rail and front handle features are integral. Rear sockets accept the slide-in support arms. Joint clearance is a proposal; first assembly is unpowered.")
}
fn extension(sx:Int,id:String) -> AssemblyPart {
 part(id:id,name:"Slide-in rear support arm",kind:Printed,scope:Cassette,adds:[block(w:20000,h:8000,d:112000,x:0,y:0,z:0)],cuts:[hole_y(d:4400,x:0,z:32000),hole_y(d:4400,x:0,z: -46000)],x:sx*(tray_w/2-7000),y: -8000,z:0-tray_d/2-10000,ex:sx*50000,ey: -20000,ez: -60000,plane:LayOnXZ,notes:"Slides into an integral tray socket. Two removable pins retain the tray and fan-bank interfaces; no threaded fasteners. Pin retention and loaded cantilever behavior remain unqualified.")
}
fn fan_plate_adds() -> List<Primitive> {
 match arctic_p8_fan_mount {FanMountAdmitted {geometry:g}=>{
  let p=fan_mount_plate(g:g)
  [block(w:micrometer_count(m:p.size_x),h:micrometer_count(m:p.size_y),d:micrometer_count(m:p.size_z),x:0,y:55000,z:0)]
 } FanMountBoreReachesMountingHoles {bore_radius:_,hole_center_distance:_}=>[] FanMountBoreNotEnclosedByPlate {bore_diameter:_,plate_edge:_}=>[] FanMountPlateSmallerThanPattern {plate_edge:_,required_edge:_}=>[]}
}
fn fan_plate_cuts() -> List<Primitive> {
 match arctic_p8_fan_mount {FanMountAdmitted {geometry:g}=>{
  let p=fan_mount_plate(g:g)
  map(concat([fan_mount_bore(g:g)],fan_mount_mounting_holes(g:g)),op=>match op {OpThroughHole {diameter:d,center_x:x,center_y:y}=>round(diameter:micrometer_count(m:d),length:12000,axis:Axis3Z,x:micrometer_count(m:x)-micrometer_count(m:p.size_x)/2,y:55000+micrometer_count(m:y)-micrometer_count(m:p.size_y)/2,z:0)})
 } FanMountBoreReachesMountingHoles {bore_radius:_,hole_center_distance:_}=>[] FanMountBoreNotEnclosedByPlate {bore_diameter:_,plate_edge:_}=>[] FanMountPlateSmallerThanPattern {plate_edge:_,required_edge:_}=>[]}
}
fn fan_frame(i:Int,id:String) -> AssemblyPart {
 let outer=i!=0
 let base=[block(w:92000,h:8000,d:36000,x:0,y:0,z:20000),block(w:92000,h:14000,d:8000,x:0,y:6000,z:2000)]
 let tab=if outer {[block(w:16000,h:4000,d:24000,x:0-i*53000,y: -2000,z:20000)]} else {[block(w:92000,h:2000,d:36000,x:0,y: -5000,z:20000)]}
 let tracks=if outer {[]} else {flat_map([-1,1],side=>[block(w:16500,h:4500,d:33000,x:side*41000,y: -2000,z:24200)])}
 let guide=if outer {[block(w:3000,h:80000,d:120000,x:i*49000,y:53000,z:60000),block(w:10000,h:8000,d:12000,x:i*46000,y:17000,z:4000)]} else {[]}
 let arm=if outer {[hole_y(d:4400,x:i*(tray_w/2-7000-fan_spacing),z:20000)]} else {[]}
 let lock=if i== -1 {[hole_y(d:4400,x:55000,z:26000)]} else {if i==0 {[hole_y(d:4400,x: -39000,z:26000)]} else {[]}}
 part(id:id,name:"Interlocking rear fan frame",kind:Printed,scope:Cassette,adds:concat(fan_plate_adds(),concat(base,concat(tab,guide))),cuts:concat(fan_plate_cuts(),concat(tracks,concat(arm,lock))),x:i*fan_spacing,y:0,z:rear_plate_z,ex:i*50000,ey:0,ez: -65000,plane:LayOnXZ,notes:"Fitted fan pattern retained; plate and foot are one piece. Center slides over keyed outer feet and one pin retains the bank. Outer frames include airflow guides. Two diagonal M4 bolts secure each fan and guard; the other holes take locating pins.")
}
fn guard(i:Int,id:String) -> AssemblyPart {
 let rim=[block(w:92000,h:8000,d:3000,x:0,y:42000,z:0),block(w:92000,h:8000,d:3000,x:0,y: -42000,z:0),block(w:8000,h:92000,d:3000,x:42000,y:0,z:0),block(w:8000,h:92000,d:3000,x: -42000,y:0,z:0)]
 let pads=flat_map([-1,1],x=>flat_map([-1,1],y=>[block(w:12000,h:12000,d:3000,x:x*fan_hole_offset,y:y*fan_hole_offset,z:0),round(diameter:8000,length:7000,axis:Axis3Z,x:x*fan_hole_offset,y:y*fan_hole_offset,z:5000)]))
 let bars=flat_map([-3,-2,-1,0,1,2,3],j=>[block(w:84000,h:4000,d:3000,x:0,y:j*11000,z:0)])
 let pins=flat_map([-1,1],x=>[round(diameter:3800,length:9000,axis:Axis3Z,x:x*fan_hole_offset,y:0-x*fan_hole_offset,z:13000)])
 let holes=flat_map([-1,1],x=>[round(diameter:fan_hole_d,length:24000,axis:Axis3Z,x:x*fan_hole_offset,y:x*fan_hole_offset,z:5000)])
 part(id:id,name:"Guard with integral spacers and locating pins",kind:Printed,scope:Cassette,adds:concat(rim,concat(pads,concat(bars,pins))),cuts:holes,x:i*fan_spacing,y:55000,z:rear_plate_z-10500,ex:i*40000,ey:0,ez: -100000,plane:LayOnXY,notes:"Two diagonal bolts secure the guard/plate/fan stack; integral posts replace all loose spacers and opposite locating pins register the fan. Guard gap and blade clearance are proposals, not a certified finger-protection rating.")
}
fn retaining_pin(x:Int,z:Int,bottom:Int,top:Int,id:String) -> AssemblyPart {
 part(id:id,name:"Large removable retaining pin",kind:Printed,scope:Cassette,adds:[round(diameter:4100,length:top-bottom,axis:Axis3Y,x:0,y:(top+bottom)/2,z:0),block(w:14000,h:4000,d:10000,x:0,y:top+2000,z:0)],cuts:[],x:x,y:0,z:z,ex:0,ey:45000,ez:0,plane:LayOnXZ,notes:"Unthreaded prototype retainer with a broad grip. Positive retention under vibration/load still needs assembly review; do not treat a friction fit as qualified service retention.")
}
fn printed_parts() -> List<AssemblyPart> {
 [panel(sx: -1,sz: -1,id:"P1"),panel(sx:1,sz: -1,id:"P2"),panel(sx: -1,sz:1,id:"P3"),panel(sx:1,sz:1,id:"P4"),
 extension(sx: -1,id:"E1"),extension(sx:1,id:"E2"),fan_frame(i: -1,id:"M1"),fan_frame(i:0,id:"M2"),fan_frame(i:1,id:"M3"),guard(i: -1,id:"G1"),guard(i:0,id:"G2"),guard(i:1,id:"G3"),
 retaining_pin(x:0-tray_w/2+7000,z:0-tray_d/2+22000,bottom: -15000,top:11000,id:"K1"),retaining_pin(x:tray_w/2-7000,z:0-tray_d/2+22000,bottom: -15000,top:11000,id:"K2"),
 retaining_pin(x:0-tray_w/2+7000,z:rear_beam_z,bottom: -12000,top:4000,id:"K3"),retaining_pin(x:tray_w/2-7000,z:rear_beam_z,bottom: -12000,top:4000,id:"K4"),retaining_pin(x: -39000,z:rear_plate_z+26000,bottom: -6000,top:4000,id:"K5")]
}
fn interfaces() -> List<MechanicalInterface> {
 [mechanical_interface(id:"keyed-panel-laps",members:["P1","P2","P3","P4"],fastener:M3PanelClamp,quantity:4,status:Proposed,requirement:"Two keyed laps and one clamp per seam. Four top-accessible screws for the entire tray; joint clearance and engagement need assembly review."),
 mechanical_interface(id:"slide-in-arms",members:["P1","P2","E1","E2","K1","K2"],fastener:PrintedRetainingPin,quantity:2,status:Proposed,requirement:"Slide arms into integral sockets, then insert broad-grip pins. No underside splice screws."),
 mechanical_interface(id:"rear-bank-keys",members:["M1","M2","M3","K5"],fastener:PrintedRetainingPin,quantity:1,status:Proposed,requirement:"Center slides over outer keyed feet; one retainer holds the assembled bank."),
 mechanical_interface(id:"rear-bank-arms",members:["M1","M3","E1","E2","K3","K4"],fastener:PrintedRetainingPin,quantity:2,status:Proposed,requirement:"Seat rear bank on arms and insert two retainers."),
 mechanical_interface(id:"fan-and-guard",members:["M1","M2","M3","G1","G2","G3","F1","F2","F3"],fastener:M4FanThroughBolt,quantity:6,status:OriginalPlateFitOnly,requirement:"Two diagonal bolts per fan; opposite integral pins register it. Nominal 39 mm stack plus washers/nut; final bolt engagement unresolved."),
 mechanical_interface(id:"board-support",members:["BOARD","P1","P2","P3","P4"],fastener:BoardSupportPending,quantity:0,status:Unresolved,requirement:"Known hole alignment passes are retained. Standoff thread/height and underside keep-outs remain open; no new gauge sequence."),
 mechanical_interface(id:"shared-power",members:["PSU","PDB","DC","FEEDS"],fastener:ProtectedDcBranch,quantity:4,status:Unresolved,requirement:"Select rated protected/isolatable branches and fixed shared 12 V supply; no live hot-swap."),
 mechanical_interface(id:"rack-ground",members:["FRAME","SHELF","PSU"],fastener:BondingHardwarePending,quantity:0,status:Unresolved,requirement:"Metal rack joining, runner attachment and permanent protective-earth bond remain hardware interfaces.")]
}
