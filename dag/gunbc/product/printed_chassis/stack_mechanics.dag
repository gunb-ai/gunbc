module product.printed_chassis.stack_mechanics

import std.types { Bool, Int, List, NonEmptyStr, String }
import std.nat { Nat }
import std.measure {
  Gram, gram, gram_count, Millinewton, millinewton, millinewton_count, Kilopascal, kilopascal, kilopascal_count,
  Megapascal, megapascal_count, KilogramPerCubicMetre, kilogram_per_cubic_metre_count, Percent, percent_count,
  micrometer_count, MicrometrePerSecondSquared, micrometre_per_second_squared, micrometre_per_second_squared_count,
  Newton, newton, newton_count,
}
import v2.std.optional { Present, Absent }
import product.printed_chassis.assembly_geometry { AssemblyPart, Primitive, Block, RoundPrism, Printed, Purchased, Metal, Clearance }
import product.printed_chassis.stack_geometry { cassette_parts, stack_pitch, pillar_side, pillar_section_area_mm2, pillar_height, footprint_half_depth, footprint_half_width }
import product.printed_chassis.power_cassette { PowerCassette, PowerCassettePlacement, TopOfColumn, BottomOfColumn, BesideColumn, nodes_above }
import extdeps.printing.fdm { FilamentTechnicalDataSheetRow }
import extdeps.cooling.dynatron { dynatron_w1_mass_active }
import extdeps.fans.arctic { arctic_p8_mass }

// Legacy uniform-unit sensitivity screen. It is not the complete node mass ledger and
// must not be used to qualify a populated stack. component_mass folds the complete
// component inventory; placed_mass_model handles explicit load positions.
// Positive primitive volume here is only a solid-envelope estimate (not sliced mass).
// Euler buckling assumes an ideal homogeneous square column. No compressive allowable,
// printed-joint stiffness, anisotropy or long-term creep rating is supplied.
// Standard gravity is 9.80665 m/s^2.
data standard_gravity: MicrometrePerSecondSquared = micrometre_per_second_squared(count: 9806650)

// pi to four places, used only for cylinder volumes in the mass estimate.
data pi_ten_thousandths: Nat = 31416
data no_mass: Nat = 0

type MassBasis
  = VendorStated
  | DerivedFromModeledVolume { density: KilogramPerCubicMetre }
  | DeclaredByCaller { basis: NonEmptyStr }

type MassRow { part_id: String, mass: Gram, basis: MassBasis }

type DeclaredMass { part_id: String, mass: Gram, basis: NonEmptyStr }

// Volume of a part's positive solids in cubic millimetres; cuts are ignored so the figure is an
// positive-volume estimate. It is not a conservative stability input: extra mass can add restoring moment.
// Use measured/sliced masses and intervals for actual load cases.
fn primitive_volume_mm3(p: Primitive) -> Nat {
  match p {
    Block { size: s, center: _ } => micrometer_count(m: s.size_x) * micrometer_count(m: s.size_y) / 1000000 * micrometer_count(m: s.size_z) / 1000
    RoundPrism { diameter: d, length: l, axis: _, center: _ } => {
      let dmm = micrometer_count(m: d) / 1000
      pi_ten_thousandths * dmm * dmm / 4 * (micrometer_count(m: l) / 1000) / 10000
    }
  }
}
fn part_volume_mm3(p: AssemblyPart) -> Nat { fold(p.adds, init: 0, f: (acc, q) => acc + primitive_volume_mm3(p: q)) }

// grams = mm3 * kg/m3 / 1e6
fn printed_mass(p: AssemblyPart, sheet: FilamentTechnicalDataSheetRow) -> Gram {
  gram(count: part_volume_mm3(p: p) * kilogram_per_cubic_metre_count(d: sheet.density) / 1000000)
}

fn declared_for(declared: List<DeclaredMass>, id: String) -> DeclaredMass? {
  fold(declared, init: none, f: (acc, d) => if d.part_id == id { Present { value: d } } else { acc })
}

// The vendor rows the cassette's purchased parts have. Ids are the cassette model's own.
fn vendor_mass(id: String) -> Gram? {
  if id == "CPU" { Present { value: dynatron_w1_mass_active } }
  else { if id == "F1" || id == "F2" || id == "F3" { Present { value: arctic_p8_mass } } else { none } }
}

type MassRosterReading
  = MassRosterComplete { rows: List<MassRow>, declared_count: Nat }
  | MassRosterIncomplete { unweighed: List<String> }

// Space reservations that stand for real mass: the board and DIMM slabs are Clearance parts in
// the cassette model because their geometry is a reservation, but they weigh what they weigh.
// Named here so the roster demands a figure for them rather than skipping them with the volumes.
data mass_bearing_reservations: List<String> = ["BOARD", "RAM1", "RAM2"]

fn mass_roster(sheet: FilamentTechnicalDataSheetRow, declared: List<DeclaredMass>) -> MassRosterReading {
  let subjects = filter(cassette_parts(), p => match p.kind { Printed => true Purchased => true Metal => true Clearance => any(mass_bearing_reservations, id => id == p.id) })
  let rows = flat_map(subjects, p => match p.kind {
    Printed => [MassRow { part_id: p.id, mass: printed_mass(p: p, sheet: sheet), basis: DerivedFromModeledVolume { density: sheet.density } }]
    Purchased => match vendor_mass(id: p.id) {
      Present { value: m } => [MassRow { part_id: p.id, mass: m, basis: VendorStated }]
      Absent => match declared_for(declared: declared, id: p.id) { Present { value: d } => [MassRow { part_id: p.id, mass: d.mass, basis: DeclaredByCaller { basis: d.basis } }] Absent => [] }
    }
    Metal => match declared_for(declared: declared, id: p.id) { Present { value: d } => [MassRow { part_id: p.id, mass: d.mass, basis: DeclaredByCaller { basis: d.basis } }] Absent => [] }
    Clearance => match declared_for(declared: declared, id: p.id) { Present { value: d } => [MassRow { part_id: p.id, mass: d.mass, basis: DeclaredByCaller { basis: d.basis } }] Absent => [] }
  })
  let unweighed = flat_map(subjects, p => if any(rows, r => r.part_id == p.id) { [] } else { [p.id] })
  if count(unweighed) > 0 { MassRosterIncomplete { unweighed: unweighed } }
  else { MassRosterComplete { rows: rows, declared_count: count(filter(rows, r => match r.basis { DeclaredByCaller { basis: _ } => true VendorStated => false DerivedFromModeledVolume { density: _ } => false })) } }
}

fn roster_mass(rows: List<MassRow>) -> Gram { gram(count: fold(rows, init: 0, f: (acc, r) => acc + gram_count(g: r.mass))) }

// Pillars are not in the r06 cassette model yet; their mass is derived from the proposal section.
fn pillar_set_mass(sheet: FilamentTechnicalDataSheetRow) -> Gram {
  let side_mm = pillar_side / 1000
  gram(count: 4 * side_mm * side_mm * (pillar_height() / 1000) * kilogram_per_cubic_metre_count(d: sheet.density) / 1000000)
}

fn unit_mass(rows: List<MassRow>, sheet: FilamentTechnicalDataSheetRow) -> Gram {
  gram(count: gram_count(g: roster_mass(rows: rows)) + gram_count(g: pillar_set_mass(sheet: sheet)))
}

// Weight in millinewtons: g * um/s^2 = nN, / 1e6 = mN.
fn weight_mn(m: Gram) -> Millinewton { millinewton(count: gram_count(g: m) * micrometre_per_second_squared_count(a: standard_gravity) / 1000000) }

// Declared sensitivity inputs. Bending strength is deliberately not used as a
// compressive allowable. Top push and base acceleration use different lever arms.
type StackPolicy {
  effective_length_factor_percent: Nat
  service_push: Newton
  service_acceleration: MicrometrePerSecondSquared
}

type StackLimit
  = PillarBucklingExceeded { level_from_bottom: Nat, pillar_load: Millinewton, critical: Millinewton }
  | TipsUnderServicePush { tip_force: Newton, push: Newton }
  | TipsUnderServiceAcceleration { tip_acceleration: MicrometrePerSecondSquared, required: MicrometrePerSecondSquared }

type StackVerdict {
  node_count: Nat
  unit_mass: Gram
  column_mass: Gram
  bottom_pillar_load: Millinewton
  bottom_bearing_stress: Kilopascal
  pillar_critical_load: Millinewton
  tip_force: Newton
  tip_acceleration: MicrometrePerSecondSquared
  rests_on_declared_masses: Nat
}

type StackAdmission
  = StackScreeningOnly { verdict: StackVerdict, creep_unqualified: NonEmptyStr }
  | StackLimited { first_limit: StackLimit, verdict: StackVerdict }
  | StackRefusedUnweighed { unweighed: List<String> }

// Mass resting on level i's pillars: every node above it, plus the station if it is above.
fn mass_above_level(unit: Gram, station: PowerCassette, node_count: Nat, level: Nat) -> Gram {
  let nodes_above = nodes_above(node_count: node_count, node_index_from_bottom: level)
  let station_above = match station.placement { TopOfColumn => gram_count(g: station.mass) BottomOfColumn => no_mass BesideColumn => no_mass }
  gram(count: nodes_above * gram_count(g: unit) + station_above)
}

// Euler critical load for one pillar, in millinewtons: pi^2 E I / (K L)^2 with E in MPa (N/mm^2),
// I = a^4/12 in mm^4, L in mm, so the quotient is newtons.
fn pillar_critical_load(sheet: FilamentTechnicalDataSheetRow, policy: StackPolicy) -> Millinewton {
  let a = pillar_side / 1000
  let i_mm4 = a * a * a * a / 12
  let kl = policy.effective_length_factor_percent * (pillar_height() / 1000) / 100
  let pi_squared_ten_thousandths = 98696
  millinewton(count: pi_squared_ten_thousandths * megapascal_count(p: sheet.bending_modulus) * i_mm4 / (kl * kl) / 10)
}

// Approximate uniform-unit CG. Bottom power cassette shifts every node upward one pitch.
// Top-applied push uses the TOP HEIGHT, not this CG height. The centre
// of mass of N equal units at pitch p is at N p / 2 above the floor; a station adds its own term.
fn centre_of_mass_height_mm(unit: Gram, station: PowerCassette, node_count: Nat) -> Nat {
  let p = stack_pitch() / 1000
  let offset = match station.placement {BottomOfColumn=>p TopOfColumn=>0 BesideColumn=>0}
  let node_moment = node_count * gram_count(g: unit) * (node_count * p + 2 * offset) / 2
  let station_height = match station.placement { TopOfColumn => node_count * p + p / 2 BottomOfColumn => p / 2 BesideColumn => p / 2 }
  let station_term = match station.placement { TopOfColumn => gram_count(g: station.mass) * station_height BottomOfColumn => gram_count(g: station.mass) * station_height BesideColumn => no_mass }
  let total = match station.placement { TopOfColumn => node_count * gram_count(g: unit) + gram_count(g: station.mass) BottomOfColumn => node_count * gram_count(g: unit) + gram_count(g: station.mass) BesideColumn => node_count * gram_count(g: unit) }
  if total == 0 { total } else { (node_moment + station_term) / total }
}

fn column_mass(unit: Gram, station: PowerCassette, node_count: Nat) -> Gram {
  let station_mass = match station.placement { TopOfColumn => gram_count(g: station.mass) BottomOfColumn => gram_count(g: station.mass) BesideColumn => no_mass }
  gram(count: node_count * gram_count(g: unit) + station_mass)
}

fn tip_force(unit: Gram, station: PowerCassette, node_count: Nat) -> Newton {
  let station_levels = match station.placement {BesideColumn=>0 TopOfColumn=>1 BottomOfColumn=>1}
  let h = (node_count + station_levels) * (stack_pitch()/1000)
  let half_base = footprint_half_width() / 1000
  if h == 0 { newton(count: no_mass) } else { newton(count: millinewton_count(f: weight_mn(m: column_mass(unit: unit, station: station, node_count: node_count))) * half_base / h / 1000) }
}

// Lateral acceleration that tips the column: g * half-base / centre-of-mass height.
fn tip_acceleration(unit: Gram, station: PowerCassette, node_count: Nat) -> MicrometrePerSecondSquared {
  let h = centre_of_mass_height_mm(unit: unit, station: station, node_count: node_count)
  if h == 0 { micrometre_per_second_squared(count: no_mass) } else { micrometre_per_second_squared(count: micrometre_per_second_squared_count(a: standard_gravity) * (footprint_half_width() / 1000) / h) }
}

// Bending strength is not a compressive allowable. Bearing stress is reported, not admitted.
fn first_limit(unit: Gram, station: PowerCassette, sheet: FilamentTechnicalDataSheetRow, policy: StackPolicy, node_count: Nat) -> StackLimit? {
  let per_pillar = millinewton(count: millinewton_count(f: weight_mn(m: mass_above_level(unit: unit, station: station, node_count: node_count, level: 0))) / 4)
  let critical = pillar_critical_load(sheet: sheet, policy: policy)
  let tip = tip_force(unit: unit, station: station, node_count: node_count)
  let tip_a = tip_acceleration(unit: unit, station: station, node_count: node_count)
  if millinewton_count(f: per_pillar) > millinewton_count(f: critical) { Present { value: PillarBucklingExceeded { level_from_bottom: 0, pillar_load: per_pillar, critical: critical } } }
  else { if newton_count(f: tip) < newton_count(f: policy.service_push) { Present { value: TipsUnderServicePush { tip_force: tip, push: policy.service_push } } }
  else { if micrometre_per_second_squared_count(a: tip_a) < micrometre_per_second_squared_count(a: policy.service_acceleration) { Present { value: TipsUnderServiceAcceleration { tip_acceleration: tip_a, required: policy.service_acceleration } } } else { none } } }
}

fn verdict_for(unit: Gram, station: PowerCassette, sheet: FilamentTechnicalDataSheetRow, policy: StackPolicy, node_count: Nat, declared_count: Nat) -> StackVerdict {
  let per_pillar = millinewton(count: millinewton_count(f: weight_mn(m: mass_above_level(unit: unit, station: station, node_count: node_count, level: 0))) / 4)
  StackVerdict {
    node_count: node_count,
    unit_mass: unit,
    column_mass: column_mass(unit: unit, station: station, node_count: node_count),
    bottom_pillar_load: per_pillar,
    bottom_bearing_stress: kilopascal(count: millinewton_count(f: per_pillar) / pillar_section_area_mm2()),
    pillar_critical_load: pillar_critical_load(sheet: sheet, policy: policy),
    tip_force: tip_force(unit: unit, station: station, node_count: node_count),
    tip_acceleration: tip_acceleration(unit: unit, station: station, node_count: node_count),
    rests_on_declared_masses: declared_count,
  }
}

data creep_boundary: NonEmptyStr = "SCREENING ONLY: uniform unit CG approximation, ideal Euler column, unknown joint/contact stiffness, compressive allowable, print anisotropy, creep, friction and cable forces. No result admits a populated stack or states a safe height. Use placed_mass_model for actual load locations; qualify physical joints/material separately."

fn stack_screening(sheet: FilamentTechnicalDataSheetRow, declared: List<DeclaredMass>, station: PowerCassette, policy: StackPolicy, node_count: Nat) -> StackAdmission {
  match mass_roster(sheet: sheet, declared: declared) {
    MassRosterIncomplete { unweighed: u } => StackRefusedUnweighed { unweighed: u }
    MassRosterComplete { rows: rows, declared_count: dc } => {
      let unit = unit_mass(rows: rows, sheet: sheet)
      let verdict = verdict_for(unit: unit, station: station, sheet: sheet, policy: policy, node_count: node_count, declared_count: dc)
      match first_limit(unit: unit, station: station, sheet: sheet, policy: policy, node_count: node_count) {
        Present { value: l } => StackLimited { first_limit: l, verdict: verdict }
        Absent => StackScreeningOnly { verdict: verdict, creep_unqualified: creep_boundary }
      }
    }
  }
}

// Largest uniform approximation passing these screens; NOT a safe stack height.
fn max_screened_height(sheet: FilamentTechnicalDataSheetRow, declared: List<DeclaredMass>, station: PowerCassette, policy: StackPolicy, ceiling: Nat) -> Nat {
  height_search(sheet: sheet, declared: declared, station: station, policy: policy, n: 1, ceiling: ceiling, best: 0)
}
fn height_search(sheet: FilamentTechnicalDataSheetRow, declared: List<DeclaredMass>, station: PowerCassette, policy: StackPolicy, n: Nat, ceiling: Nat, best: Nat) -> Nat {
  if n > ceiling { best } else {
    match stack_screening(sheet: sheet, declared: declared, station: station, policy: policy, node_count: n) {
      StackScreeningOnly { verdict: _, creep_unqualified: _ } => height_search(sheet: sheet, declared: declared, station: station, policy: policy, n: n + 1, ceiling: ceiling, best: n)
      StackLimited { first_limit: _, verdict: _ } => best
      StackRefusedUnweighed { unweighed: _ } => best
    }
  }
}
