module product.printed_chassis.review_realization

import std.types { String,List }
import product.printed_chassis.assembly_geometry {AssemblyPart,MechanicalInterface}
import gunbc.cli_wire { CliWireResponse, CliWirePrintable, CliWireUnprintable }
import std.process { ExitSuccess,exit_failure }
import product.printed_chassis.cadquery_realization {realize_review_parts,ReviewCadQueryEmitted,ReviewCadQueryRefused,review_program_source}
import product.printed_chassis.cassette_review {all_parts,manifest_for}
import extdeps.languages.json.emit {serialize_json,json_string,json_object,json_kv}
import product.printed_chassis.cassette {interfaces}
import product.printed_chassis.assembly_review_checks {review_model_checks}

// Review-only host adapter. Mechanical geometry, placements, materials and tolerances
// are inputs from cassette_review, never decisions made here. This emits no printer
// command and grants no AdmittedRealizationV0 / fabrication capability. The existing
// admission workflow remains mandatory after assembly review and before printing.
// Exercise with CadQuery 2.8.0; rejection is atomic (no partial review package).
// Python is emitted transiently because this repository owns tools in .dag/.rs.
fn adapter_source() -> String { join([
  "#!/usr/bin/env python3\n",
  "\"\"\"Realize a DAG-emitted review manifest. No cassette dimensions live in this adapter.\n",
  "\n",
  "CadQuery 2.8.0 is the exercised kernel. Only the closed box/cylinder union/difference\n",
  "vocabulary is accepted; unknown operations, disconnected printed solids and oversized\n",
  "parts refuse. This is review-output validation, not powered/structural qualification.\n",
  "\"\"\"\n",
  "import argparse, collections, csv, hashlib, io, json, math, pathlib, re, shutil, tempfile, zipfile\n",
  "import cadquery as cq\n",
  "from OCP.Bnd import Bnd_Box\n",
  "from OCP.BRepBndLib import BRepBndLib\n",
  "from vtkmodules.vtkIOGeometry import vtkSTLReader\n",
  "from vtkmodules.vtkFiltersCore import vtkFeatureEdges, vtkMassProperties\n",
  "\n",
  "\n",
  "def mm(values):\n",
  "    assert all(type(v) is int for v in values), 'Expected integer micrometres'\n",
  "    return [v / 1000 for v in values]\n",
  "\n",
  "\n",
  "def exact_bounds(shape):\n",
  "    b=Bnd_Box(); BRepBndLib.AddOptimal_s(shape.wrapped,b,False,False)\n",
  "    return b.Get()\n",
  "\n",
  "def extent(shape):\n",
  "    b=exact_bounds(shape); return [b[i+3]-b[i] for i in range(3)]\n",
  "\n",
  "\n",
  "def near(a,b,tolerance=2e-5):\n",
  "    assert len(a)==len(b) and all(abs(x-y)<tolerance for x,y in zip(a,b)), (a,b)\n",
  "\n",
  "\n",
  "def mesh_check(path, shape, tolerance):\n",
  "    r=vtkSTLReader(); r.SetFileName(str(path)); r.Update(); mesh=r.GetOutput()\n",
  "    assert mesh.GetNumberOfCells()>0\n",
  "    e=vtkFeatureEdges(); e.SetInputData(mesh); e.BoundaryEdgesOn(); e.NonManifoldEdgesOn(); e.FeatureEdgesOff(); e.ManifoldEdgesOff(); e.Update()\n",
  "    assert e.GetOutput().GetNumberOfCells()==0, 'Open/nonmanifold STL'\n",
  "    b=mesh.GetBounds(); near([b[1]-b[0],b[3]-b[2],b[5]-b[4]],extent(shape),2*tolerance+2e-5)\n",
  "    mass=vtkMassProperties();mass.SetInputData(mesh);mass.Update()\n",
  "    assert math.isclose(mass.GetVolume(),shape.Volume(),rel_tol=3e-4), 'STL volume divergence'\n",
  "    return mesh.GetNumberOfCells()\n",
  "\n",
  "\n",
  "def primitive_bounds(p):\n",
  "    c=mm(p['center_um'])\n",
  "    if p['op']=='box': s=mm(p['size_um'])\n",
  "    else:\n",
  "        s=[p['diameter_um']/1000]*3;s['xyz'.index(p['axis'])]=p['length_um']/1000\n",
  "    return [c[i]-s[i]/2 for i in range(3)]+[c[i]+s[i]/2 for i in range(3)]\n",
  "\n",
  "\n",
  "def model_bounds(p):\n",
  "    b=[primitive_bounds(a) for a in p['adds']]\n",
  "    return [min(r[i] for r in b) for i in range(3)]+[max(r[i+3] for r in b) for i in range(3)]\n",
  "\n",
  "\n",
  "def overlaps(a,b):\n",
  "    return all(min(a[i+3],b[i+3])-max(a[i],b[i])>1e-5 for i in range(3))\n",
  "\n",
  "\n",
  "def realize(model, out):\n",
  "    assert dict(model,source_manifest_sha256=None) == dict(_expected_manifest,source_manifest_sha256=None), 'Manifest differs from the emitted geometry'\n",
  "    assert model['schema']=='gunbc.cassette-review.v1' and model['quantum']=='micrometre'\n",
  "    assert model['release']=='review-only; no print or powered-operation admission'\n",
  "    assert cq.__version__=='2.8.0', 'Use the recorded CadQuery 2.8.0 environment'\n",
  "    ids=[p['id'] for p in model['parts']];assert len(set(ids))==len(ids)\n",
  "    assert all(re.fullmatch(r'[A-Za-z0-9_-]+',i) for i in ids)\n",
  "    for interface in model['interfaces']:\n",
  "        assert set(interface['members'])<=set(ids), interface\n",
  "    shapes=\{\}; world=\{\}; bounds=\{\}; groups=\{\}; errors=[]\n",
  "    tol=model['export']['linear_tolerance_um']/1000\n",
  "    angular=float(model['export']['angular_tolerance_radians'])\n",
  "    for part_index,p in enumerate(model['parts']):\n",
  "        try:\n",
  "            assert p['adds'], 'No positive geometry (upstream admission refused?)'\n",
  "            body=_review_shapes[part_index]\n",
  "            body=body.clean(); assert body.isValid() and body.Volume()>0\n",
  "            if p['kind']=='printed': assert len(body.Solids())==1, f'\{len(body.Solids())\} disconnected solids'\n",
  "            expected=model_bounds(p)\n",
  "            near(extent(body),[expected[i+3]-expected[i] for i in range(3)])\n",
  "            vertices, faces=body.tessellate(tol,angular)\n",
  "            mesh=\{'vertices':[c for v in vertices for c in v.toTuple()], 'indices':[i for f in faces for i in f]\}\n",
  "            (out/f'\{p[\"id\"]\}.mesh.json').write_text(json.dumps(mesh,separators=(',',':')))\n",
  "            p['mesh']=f'\{p[\"id\"]\}.mesh.json';p['extent_mm']=extent(body);p['volume_mm3']=body.Volume()\n",
  "            shapes[p['id']]=body;at=mm(p['at_um']);world[p['id']]=body.translate(at)\n",
  "            bounds[p['id']]=[expected[i]+at[i%3] for i in range(6)]\n",
  "            if p['kind']=='printed':\n",
  "                oriented=body\n",
  "                if p['print_plane']=='XZ':oriented=body.rotate((0,0,0),(1,0,0),90)\n",
  "                elif p['print_plane']=='YZ':oriented=body.rotate((0,0,0),(0,1,0),-90)\n",
  "                else:assert p['print_plane']=='XY'\n",
  "                b=exact_bounds(oriented);oriented=oriented.translate(tuple(-v for v in b[:3]))\n",
  "                assert all(n<=limit for n,limit in zip(extent(oriented),model['print_envelope_mm'])), 'Build envelope exceeded'\n",
  "                stl=out/f'\{p[\"id\"]\}.stl';oriented.exportStl(str(stl),tolerance=tol,angularTolerance=angular,ascii=False,relative=False,parallel=True)\n",
  "                triangles=mesh_check(stl,oriented,tol)\n",
  "                step=out/f'\{p[\"id\"]\}.step';cq.exporters.export(body,str(step),exportType='STEP')\n",
  "                readback=cq.importers.importStep(str(step)).val();near(extent(readback),extent(body))\n",
  "                assert math.isclose(readback.Volume(),body.Volume(),rel_tol=1e-8)\n",
  "                p.update(stl=stl.name,step=step.name,print_extent_mm=extent(oriented),triangles=triangles,sha256=hashlib.sha256(stl.read_bytes()).hexdigest(),checks='single solid; STEP round-trip; closed STL; volume/bounds; bed fit')\n",
  "                identity=hashlib.sha256(json.dumps(\{k:p[k] for k in ['adds','cuts','print_plane']\},sort_keys=True).encode()).hexdigest()\n",
  "                groups.setdefault(identity,[]).append(p['id'])\n",
  "            print('OK',p['id'],p['name'],flush=True)\n",
  "        except Exception as exc:\n",
  "            errors.append(f'\{p[\"id\"]\}: \{exc\}');print('REFUSED',errors[-1],flush=True)\n",
  "    if errors: raise ValueError('\\n'.join(errors))\n",
  "    # Exact CAD intersections between moving printed parts, after a broad-phase AABB check.\n",
  "    printed=[p for p in model['parts'] if p['kind']=='printed'];collisions=[]\n",
  "    for n,a in enumerate(printed):\n",
  "        for b in printed[n+1:]:\n",
  "            if overlaps(bounds[a['id']],bounds[b['id']]):\n",
  "                volume=world[a['id']].intersect(world[b['id']]).Volume()\n",
  "                if volume>1e-4:collisions.append(\{'a':a['id'],'b':b['id'],'volume_mm3':volume\})\n",
  "    if collisions:raise ValueError('Printed-part collisions: '+json.dumps(collisions))\n",
  "    model['validation']=\{'cadquery':cq.__version__,'printed_part_count':len(printed),'unique_print_geometries':len(groups),'printed_pair_collisions':collisions,'source_model_checks':'DAG bed/mate/member checks','scope':'geometry only; no fastener engagement, thermal, structural or electrical qualification'\}\n",
  "    model['print_groups']=[\{'representative':items[0],'quantity':len(items),'instances':items\} for items in groups.values()]\n",
  "    if model.get('stacking'):\n",
  "        config=model['stacking']; pitch=config['pitch_um']/1000\n",
  "        frame=[p for p in printed if p['id'] in config['frame_ids']]\n",
  "        moving=[p for p in printed if p['scope']=='cassette']\n",
  "        upper=\{p['id']:world[p['id']].translate((0,pitch,0)) for p in printed\}\n",
  "        stack_collisions=[]\n",
  "        for a in printed:\n",
  "            for b in printed:\n",
  "                if overlaps(exact_bounds(world[a['id']]),exact_bounds(upper[b['id']])):\n",
  "                    volume=world[a['id']].intersect(upper[b['id']]).Volume()\n",
  "                    if volume>1e-5:stack_collisions.append([a['id'],b['id'],volume])\n",
  "        assert not stack_collisions, ('Stack interference',stack_collisions)\n",
  "        distances=[config['withdrawal_um']/1000*i/6 for i in range(7)]\n",
  "        for distance in distances:\n",
  "            for a in moving:\n",
  "                displaced=world[a['id']].translate((0,0,distance))\n",
  "                for b in frame:\n",
  "                    if b['id']==config['removed_before_extraction']:continue\n",
  "                    if overlaps(exact_bounds(displaced),exact_bounds(world[b['id']])):\n",
  "                        volume=displaced.intersect(world[b['id']]).Volume()\n",
  "                        assert volume<1e-5, ('Withdrawal interference',distance,a['id'],b['id'],volume)\n",
  "        model['validation']['stacked_printed_intersections']=stack_collisions\n",
  "        model['validation']['withdrawal_sample_mm']=distances\n",
  "        model['validation']['withdrawal_scope']='Printed cassette versus lower frame, stop removed; sampled positions, not continuous swept-volume or cable validation'\n",
  "        stack=cq.Assembly()\n",
  "        for level in range(2):\n",
  "            for p in model['parts']:\n",
  "                if p['kind']=='clearance':continue\n",
  "                if p['scope']=='cassette' or p['id'] in config['frame_ids']:\n",
  "                    at=mm(p['at_um']);at[1]+=level*pitch\n",
  "                    stack.add(shapes[p['id']],name='N'+str(level+1)+'_'+p['id'],loc=cq.Location(cq.Vector(*at)))\n",
  "        stack.export(str(out/'stack-assembly.step'))\n",
  "    assembly=cq.Assembly()\n",
  "    for p in model['parts']:\n",
  "        if p['scope']=='cassette' and p['kind']!='clearance':assembly.add(shapes[p['id']],name=p['id'],loc=cq.Location(cq.Vector(*mm(p['at_um']))))\n",
  "    assembly.export(str(out/'cassette-assembly.step'))\n",
  "    (out/'assembly.json').write_text(json.dumps(model,indent=2)+'\\n')\n",
  "    with (out/'parts.csv').open('w') as f:\n",
  "        w=csv.writer(f);w.writerow(['id','part','kind','scope','x_mm','y_mm','z_mm','notes'])\n",
  "        for p in model['parts']:w.writerow([p['id'],p['name'],p['kind'],p['scope'],*p['extent_mm'],p['notes']])\n",
  "    with (out/'interfaces.csv').open('w') as f:\n",
  "        w=csv.writer(f);w.writerow(['interface','members','fastener','quantity','status','requirement'])\n",
  "        for i in model['interfaces']:w.writerow([i['id'],' '.join(i['members']),i['fastener'],i['quantity'],i['status'],i['requirement']])\n",
  "    with (out/'print-list.csv').open('w') as f:\n",
  "        w=csv.writer(f);w.writerow(['representative','quantity','instances','print_file'])\n",
  "        for g in model['print_groups']:w.writerow([g['representative'],g['quantity'],' '.join(g['instances']),g['representative']+'.stl'])\n",
  "    (out/'README.txt').write_text('Cassette/frame review package. Generated from the DAG source manifest.\\n'+model['release']+'\\nSTLs are bed-oriented; individual STEPs and assembly STEP use assembly-local axes.\\nparts.csv / print-list.csv list all parts and repeat quantities. One M fan plate is already fit-tested.\\nNo additional gauge sequence. Review assembly, fasteners and unresolved board support before scheduling cassette prints.\\n')\n",
  "    with zipfile.ZipFile(out/'cassette-review.zip','w',zipfile.ZIP_DEFLATED) as z:\n",
  "        for f in sorted(out.iterdir()):\n",
  "            if f.suffix in ['.stl','.step','.csv','.txt'] or f.name=='assembly.json':z.write(f,f.name)\n",
  "\n",
  "\n",
  "def main():\n",
  "    ap=argparse.ArgumentParser();ap.add_argument('manifest',type=pathlib.Path);ap.add_argument('output',type=pathlib.Path);args=ap.parse_args()\n",
  "    model=json.loads(args.manifest.read_text());model['source_manifest_sha256']=hashlib.sha256(args.manifest.read_bytes()).hexdigest()\n",
  "    args.output.parent.mkdir(parents=True,exist_ok=True)\n",
  "    staging=pathlib.Path(tempfile.mkdtemp(prefix='cad-review-',dir=args.output.parent))\n",
  "    try:\n",
  "        realize(model,staging)\n",
  "        if args.output.exists():raise ValueError('Output already exists; choose a fresh version directory')\n",
  "        staging.rename(args.output)\n",
  "    except Exception:\n",
  "        shutil.rmtree(staging);raise\n",
  "    print(json.dumps(model['validation']))\n",
  "\n",
  "if __name__=='__main__':main()\n"
], "") }
fn program_for(parts:List<AssemblyPart>,joints:List<MechanicalInterface>) -> CliWireResponse {
 if !review_model_checks(parts:parts,interfaces:joints) {return CliWirePrintable {bytes:"Assembly source checks refused",exit:exit_failure(reason:"Assembly source checks refused")}}
 match realize_review_parts(parts:parts) {ReviewCadQueryRefused {reason:_}=>CliWirePrintable {bytes:"Review CAD emission refused",exit:exit_failure(reason:"Review CAD emission refused")} ReviewCadQueryEmitted {program:p}=>CliWirePrintable {bytes:join([review_program_source(p:p),"import json\n_expected_manifest = json.loads(",serialize_json(v:json_string(s:serialize_json(v:manifest_for(parts:parts,joints:joints)))),")\n",adapter_source()],""),exit:ExitSuccess}}
}
fn main() -> CliWireResponse {program_for(parts:all_parts(),joints:interfaces())}

// Both payloads derive from the same parts and joints. Callers cannot supply a
// manifest from another model, and program_for owns the single admission check.
fn bundle_for(parts:List<AssemblyPart>,joints:List<MechanicalInterface>) -> CliWireResponse {
 match program_for(parts:parts,joints:joints) {CliWirePrintable {bytes:b,exit:e}=>CliWirePrintable {bytes:serialize_json(v:json_object(members:[json_kv(key:"manifest",value:manifest_for(parts:parts,joints:joints)),json_kv(key:"program",value:json_string(s:b))])),exit:e} CliWireUnprintable {cause:c}=>CliWireUnprintable {cause:c}}
}
fn bundle() -> CliWireResponse {bundle_for(parts:all_parts(),joints:interfaces())}
