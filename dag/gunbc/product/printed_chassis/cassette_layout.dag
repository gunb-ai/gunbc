module product.printed_chassis.cassette_layout
import std.types {Int,List}
import std.nat {nat_range_inclusive}
import std.measure {Micrometer, micrometer, micrometer_count, millimeter_count}
import extdeps.printing.bambu_lab_a1_mini {a1_mini_build_envelope}
import extdeps.printing.fdm {build_envelope_x,build_envelope_y}
import product.printed_chassis.tray_panel_features {donor_joint_overhang_um,side_panel_overhang_um,front_handle_overhang_um}
import product.printed_chassis.bed_partition {AxisPrintAllowance,allocate_axis,AxisAllocated,AxisAllocationInvalid,AxisAllocationNoFit}
import product.printed_chassis.cassette_profile {CassetteProfile,BoardOutlineKnown,BoardOutlinePending}
import extdeps.boards.asrock_rack {asrock_altrad8ud_extent_along_rear_io,asrock_altrad8ud_extent_depth}
type CassetteLayout {board_width:Micrometer,board_depth:Micrometer,edge_margin:Micrometer,tray_width:Micrometer,tray_depth:Micrometer}
type LayoutReading = LayoutKnown {layout:CassetteLayout} | LayoutNeedsBoardOutline | InvalidEdgeMargin
fn layout_for(profile:CassetteProfile,edge_margin_um:Int) -> LayoutReading {
 if edge_margin_um<0 {return InvalidEdgeMargin}
 match profile.outline {BoardOutlinePending=>LayoutNeedsBoardOutline BoardOutlineKnown {width:w,depth:d,standing:_}=>LayoutKnown {layout:layout_from_outline(width_um:w,depth_um:d,edge_margin_um:micrometer(count: edge_margin_um))}}
}
// One owner for tray allowances. These dimensions reserve only the board; retained
// power/cooling/IO assemblies can enlarge the final envelope after their BOM is placed.
fn layout_from_outline(width_um:Micrometer,depth_um:Micrometer,edge_margin_um:Micrometer) -> CassetteLayout {
 CassetteLayout {board_width:width_um,board_depth:depth_um,edge_margin:edge_margin_um,tray_width:micrometer(count: micrometer_count(m: width_um)+2*micrometer_count(m: edge_margin_um)),tray_depth:micrometer(count: micrometer_count(m: depth_um)+2*micrometer_count(m: edge_margin_um))}
}
// Existing printed configuration retains its exact source dimensions. Resolve its
// known outline explicitly; unknown profiles never fall back to this row.
fn current_layout() -> CassetteLayout {
 layout_from_outline(width_um:asrock_altrad8ud_extent_along_rear_io,depth_um:asrock_altrad8ud_extent_depth,edge_margin_um:micrometer(count: 14000))
}

// The allocator accounts for the actual retained panel feature dimensions. The
// new multi-cell solid generator must still realize and validate these envelopes.
type TrayPrintPolicy {along_width:AxisPrintAllowance,along_depth:AxisPrintAllowance}
fn panel_print_policy(brim_each_side_um:Micrometer,edge_clearance_each_side_um:Micrometer) -> TrayPrintPolicy {
 TrayPrintPolicy {
 along_width:AxisPrintAllowance {bed_um:micrometer(count: 1000*millimeter_count(m:build_envelope_x(e:a1_mini_build_envelope))),brim_each_side_um:brim_each_side_um,edge_clearance_each_side_um:edge_clearance_each_side_um,outer_low_um:side_panel_overhang_um(),outer_high_um:side_panel_overhang_um(),internal_low_um:micrometer(count: 0),internal_high_um:donor_joint_overhang_um()},
 along_depth:AxisPrintAllowance {bed_um:micrometer(count: 1000*millimeter_count(m:build_envelope_y(e:a1_mini_build_envelope))),brim_each_side_um:brim_each_side_um,edge_clearance_each_side_um:edge_clearance_each_side_um,outer_low_um:micrometer(count: 0),outer_high_um:front_handle_overhang_um(),internal_low_um:micrometer(count: 0),internal_high_um:donor_joint_overhang_um()}
 }
}
// Proposed slicing allowances, not a statement about previously printed jobs.
// A larger required brim must be supplied here and causes the layout to recompute.
data proposed_panel_print_policy:TrayPrintPolicy = panel_print_policy(brim_each_side_um:micrometer(count: 2000),edge_clearance_each_side_um:micrometer(count: 500))
type TrayCell {index:Int,column:Int,row:Int,x0_um:Micrometer,x1_um:Micrometer,z0_um:Micrometer,z1_um:Micrometer,print_width_um:Micrometer,print_depth_um:Micrometer}
type TrayEdge = AcrossColumns {donor:Int,receiver:Int} | AcrossRows {donor:Int,receiver:Int}
type TrayPartition {columns:Int,rows:Int,cells:List<TrayCell>,edges:List<TrayEdge>,policy:TrayPrintPolicy}
type TrayPartitionReading = TrayPartitionKnown {partition:TrayPartition} | TrayPartitionInvalid | TrayPartitionNeedsOutline
fn partition_layout(layout:CassetteLayout,policy:TrayPrintPolicy) -> TrayPartitionReading {
 match allocate_axis(span_um:layout.tray_width,allowance:policy.along_width) {
 AxisAllocationInvalid=>TrayPartitionInvalid AxisAllocationNoFit=>TrayPartitionInvalid
 AxisAllocated {cells:xs}=>match allocate_axis(span_um:layout.tray_depth,allowance:policy.along_depth) {
 AxisAllocationInvalid=>TrayPartitionInvalid AxisAllocationNoFit=>TrayPartitionInvalid
 AxisAllocated {cells:zs}=>{
 let cols=count(xs)
 let rows=count(zs)
 let cells=flat_map(enumerate(zs),r=>map(enumerate(xs),c=>TrayCell {index:r.first*cols+c.first,column:c.first,row:r.first,x0_um:c.second.start_um,x1_um:c.second.end_um,z0_um:r.second.start_um,z1_um:r.second.end_um,print_width_um:c.second.occupied_with_process_um,print_depth_um:r.second.occupied_with_process_um}))
 let edges=flat_map(cells,c=>concat(if c.column+1<cols {[AcrossColumns {donor:c.index,receiver:c.index+1}]} else {[]},if c.row+1<rows {[AcrossRows {donor:c.index,receiver:c.index+cols}]} else {[]}))
 TrayPartitionKnown {partition:TrayPartition {columns:cols,rows:rows,cells:cells,edges:edges,policy:policy}}
 }
 }
 }
}
fn partition_profile(profile:CassetteProfile,edge_margin_um:Int,policy:TrayPrintPolicy) -> TrayPartitionReading {
 match layout_for(profile:profile,edge_margin_um:edge_margin_um) {
 LayoutKnown {layout:l}=>partition_layout(layout:l,policy:policy)
 LayoutNeedsBoardOutline=>TrayPartitionNeedsOutline
 InvalidEdgeMargin=>TrayPartitionInvalid
 }
}
