module product.printed_chassis.harness_census

import std.types { Bool, Int, List, NonEmptyStr }
import std.nat { Nat, nat_sub, NatSubtraction, NatDifference, NatSubtrahendExceedsMinuend }
import std.measure { Millimeter, millimeter, millimeter_count }
import product.printed_chassis.stack_geometry { stack_pitch, footprint_half_depth }
import product.printed_chassis.cassette { tray_d, tray_w }
import product.printed_chassis.power_cassette { PowerCassette, PowerCassettePlacement, TopOfColumn, BottomOfColumn, BesideColumn, units_lifted_to_pop, nodes_above }
import extdeps.fans.arctic { arctic_p8_cable_length, arctic_p8_pwm_sharing, PwmSharingChain, PstPassThrough, NoPassThrough }
import extdeps.boards.asrock_rack { asrock_altrad8ud_connector_edge, BoardEdge, RearIoEdge, FrontEdge, SideEdgeNearDimmBankA, SideEdgeNearPcieSlots }

// HOW MUCH CABLE A STACK ACTUALLY CARRIES, counted and measured from the geometry rather than
// guessed. The operator's suspicion was that the naive picture undercounts; this is the
// instrument that answers it, and the things it finds are not in the naive picture:
//
//   - the board's 12 V inputs and fan headers are on the FRONT edge (the manual's layout), so a
//     feed arriving at the rear must cross the tray, and the rear fan bank's header cable must
//     cross it the other way;
//   - a fan bank on PST is one header cable plus short links, not three header cables;
//   - a branch's length is a function of how many levels separate the node from the station,
//     so placement decides the total.
//
// Lengths are nominal runs along the modeled geometry plus a declared service allowance; they
// are what a harness order is cut from, not a swept-volume proof.

type CableRole
  = DcBranch
  | Atx12vPigtail
  | FanHeaderCable
  | FanPstLink
  | EthernetPatch

type CableRun {
  node_index_from_bottom: Nat
  role: CableRole
  count: Nat
  each: Millimeter
}

// WHERE THE NODE'S DC INLET SITS. The board wants power at the front; the pillar raceway is at
// the rear corners. Inlet at the rear means a long internal pigtail; inlet at the front means
// the branch drop runs down the front pillars. A selection, exposed as the two arms it has.
type DcInletPlacement = InletAtRear | InletAtFront

type HarnessPlan {
  node_count: Nat
  station: PowerCassette
  inlet: DcInletPlacement
  inputs_populated: Nat
  fans_per_node: Nat
  ethernet_per_node: Nat
  switch_level_from_bottom: Nat
  service_allowance: Millimeter
}

fn pitch_mm() -> Nat { stack_pitch() / 1000 }

data no_levels: Nat = 0
fn nat_minus(a: Nat, b: Nat) -> Nat { match nat_sub(a: a, b: b) { NatDifference { value: v } => v NatSubtrahendExceedsMinuend => no_levels } }
fn level_distance(a: Nat, b: Nat) -> Nat { if a > b { nat_minus(a: a, b: b) } else { nat_minus(a: b, b: a) } }

// The station's level for a vertical run: above the top node, below the bottom one, or beside
// the column at the bottom node's level plus a lateral tray width.
fn station_vertical_levels(plan: HarnessPlan, node: Nat) -> Nat {
  match plan.station.placement {
    TopOfColumn => nodes_above(node_count: plan.node_count, node_index_from_bottom: node) + 1
    BottomOfColumn => node + 1
    BesideColumn => node + 1
  }
}
fn station_lateral_mm(plan: HarnessPlan) -> Nat {
  match plan.station.placement { TopOfColumn => 0 BottomOfColumn => 0 BesideColumn => tray_w / 1000 }
}

// One node's branch: vertical levels times pitch, a lateral run if beside, the tray crossing if
// the inlet is at the front and the raceway at the rear, plus the allowance.
fn dc_branch_length(plan: HarnessPlan, node: Nat) -> Millimeter {
  let vertical = station_vertical_levels(plan: plan, node: node) * pitch_mm()
  let crossing = match plan.inlet { InletAtRear => 0 InletAtFront => tray_d / 1000 }
  millimeter(count: vertical + station_lateral_mm(plan: plan) + crossing + millimeter_count(m: plan.service_allowance))
}

// Inside the cassette: from the inlet to the front-edge header. Rear inlet crosses the tray.
fn pigtail_length(plan: HarnessPlan) -> Millimeter {
  let crossing = match plan.inlet { InletAtRear => tray_d / 1000 InletAtFront => 0 }
  millimeter(count: crossing + millimeter_count(m: plan.service_allowance))
}

// The fan bank: fans at the rear, header at the front, so one header cable crosses the tray.
// The fan's own 400 mm lead covers it if the crossing fits; otherwise an extension is a second
// cable and the census says so by exceeding the lead.
fn fan_header_run(plan: HarnessPlan) -> Millimeter {
  millimeter(count: tray_d / 1000 + millimeter_count(m: plan.service_allowance))
}
fn fan_header_needs_extension(plan: HarnessPlan) -> Bool {
  millimeter_count(m: fan_header_run(plan: plan)) > millimeter_count(m: arctic_p8_cable_length)
}

fn fan_cables(plan: HarnessPlan, node: Nat) -> List<CableRun> {
  match arctic_p8_pwm_sharing {
    PstPassThrough { max_chained_standing: _ } => [
      CableRun { node_index_from_bottom: node, role: FanHeaderCable, count: 1, each: fan_header_run(plan: plan) },
      CableRun { node_index_from_bottom: node, role: FanPstLink, count: nat_minus(a: plan.fans_per_node, b: 1), each: millimeter(count: 100) },
    ]
    NoPassThrough => [CableRun { node_index_from_bottom: node, role: FanHeaderCable, count: plan.fans_per_node, each: fan_header_run(plan: plan) }]
  }
}

fn ethernet_length(plan: HarnessPlan, node: Nat) -> Millimeter {
  millimeter(count: level_distance(a: plan.switch_level_from_bottom, b: node) * pitch_mm() + millimeter_count(m: plan.service_allowance))
}

fn node_cables(plan: HarnessPlan, node: Nat) -> List<CableRun> {
  concat([
    CableRun { node_index_from_bottom: node, role: DcBranch, count: 1, each: dc_branch_length(plan: plan, node: node) },
    CableRun { node_index_from_bottom: node, role: Atx12vPigtail, count: plan.inputs_populated, each: pigtail_length(plan: plan) },
    CableRun { node_index_from_bottom: node, role: EthernetPatch, count: plan.ethernet_per_node, each: ethernet_length(plan: plan, node: node) },
  ], fan_cables(plan: plan, node: node))
}

fn node_indices(n: Nat) -> List<Nat> { nat_range_below(n: n) }
fn nat_range_below(n: Nat) -> List<Nat> { range_acc(i: 0, n: n, acc: []) }
fn range_acc(i: Nat, n: Nat, acc: List<Nat>) -> List<Nat> { if i >= n { acc } else { range_acc(i: i + 1, n: n, acc: concat(acc, [i])) } }

type HarnessCensus {
  runs: List<CableRun>
  cable_count: Nat
  total_length: Millimeter
  fan_header_extension_needed: Bool
}

fn harness_census(plan: HarnessPlan) -> HarnessCensus {
  let runs = flat_map(node_indices(n: plan.node_count), node => node_cables(plan: plan, node: node))
  HarnessCensus {
    runs: runs,
    cable_count: fold(runs, init: 0, f: (acc, r) => acc + r.count),
    total_length: millimeter(count: fold(runs, init: 0, f: (acc, r) => acc + r.count * millimeter_count(m: r.each))),
    fan_header_extension_needed: fan_header_needs_extension(plan: plan),
  }
}

// THE SERVICE COST OF A POP, in disconnects: every unit lifted has its cables unplugged first,
// and the target itself. A stack of eight with the station on top pays nine unplug sets to
// reach the bottom node; two columns of four pay five.
fn disconnect_sets_to_pop(plan: HarnessPlan, node: Nat) -> Nat {
  units_lifted_to_pop(station: plan.station, node_count: plan.node_count, node_index_from_bottom: node) + 1
}
