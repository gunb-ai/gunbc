module product.printed_chassis.platform_projects_review
import std.types {List,String}
import product.printed_chassis.board_mechanical_reference {mounting_reference_json,cited_figure_json}
import std.measure {micrometer_count}
import std.optional {Present,Absent}
import product.printed_chassis.cassette_profile {CassetteProfile,BoardOutlineKnown,BoardOutlinePending,RetainPlatformPowerAssembly,IndependentPowerCassette,board_grid_tiles}
import product.printed_chassis.cassette_profiles {cassette_profiles}
import product.printed_chassis.cassette_layout {proposed_panel_print_policy,partition_profile,TrayPartitionKnown,TrayPartitionInvalid,TrayPartitionNeedsOutline,layout_for,LayoutKnown,LayoutNeedsBoardOutline,InvalidEdgeMargin}
import extdeps.languages.json.emit {JsonValue,json_object,json_kv,json_array,json_string,json_int,json_null}
fn platform_projects_review() -> JsonValue {
 json_array(elements:map(cassette_profiles,p=>json_object(members:[json_kv(key:"id",value:json_string(s:p.id as String)),json_kv(key:"hardware",value:json_string(s:p.requested_hardware as String)),json_kv(key:"board_outline_um",value:match p.outline {BoardOutlinePending=>json_null() BoardOutlineKnown {width:w,depth:d,standing:_}=>json_array(elements:[json_int(n:micrometer_count(m:w)),json_int(n:micrometer_count(m:d))])}),json_kv(key:"outline_evidence",value:match p.outline {BoardOutlinePending=>json_null() BoardOutlineKnown {width:_,depth:_,standing:s}=>cited_figure_json(standing:s)}),json_kv(key:"mounting_reference",value:mounting_reference_json(reference:p.mounting)),json_kv(key:"power_intent",value:json_string(s:match p.power {RetainPlatformPowerAssembly=>"retain vendor power assembly with node; compatibility unresolved" IndependentPowerCassette=>"separate power cassette"})),json_kv(key:"board_only_180mm_grid_tiles",value:match board_grid_tiles(project:p,usable_tile_um:180000) {Absent=>json_null() Present {value:n}=>json_int(n:n)}),json_kv(key:"shared_tray_outline_um",value:match layout_for(profile:p,edge_margin_um:14000) {LayoutKnown {layout:l}=>json_array(elements:[json_int(n:l.tray_width),json_int(n:l.tray_depth)]) LayoutNeedsBoardOutline=>json_null() InvalidEdgeMargin=>json_null()}),json_kv(key:"shared_partition",value:match partition_profile(profile:p,edge_margin_um:14000,policy:proposed_panel_print_policy) {TrayPartitionKnown {partition:g}=>json_object(members:[json_kv(key:"columns",value:json_int(n:g.columns)),json_kv(key:"rows",value:json_int(n:g.rows)),json_kv(key:"cells",value:json_int(n:count(g.cells))),json_kv(key:"joints",value:json_int(n:count(g.edges))),json_kv(key:"brim_each_side_um",value:json_int(n:g.policy.along_width.brim_each_side_um)),json_kv(key:"edge_clearance_each_side_um",value:json_int(n:g.policy.along_width.edge_clearance_each_side_um)),json_kv(key:"cell_envelopes",value:json_array(elements:map(g.cells,c=>json_object(members:[json_kv(key:"column",value:json_int(n:c.column)),json_kv(key:"row",value:json_int(n:c.row)),json_kv(key:"panel_width_um",value:json_int(n:c.x1_um-c.x0_um)),json_kv(key:"panel_depth_um",value:json_int(n:c.z1_um-c.z0_um)),json_kv(key:"print_width_with_process_um",value:json_int(n:c.print_width_um)),json_kv(key:"print_depth_with_process_um",value:json_int(n:c.print_depth_um))])))),json_kv(key:"standing",value:json_string(s:"minimum axis grid under declared feature envelopes and proposed slicing allowances; solid realization and mounting map still required"))]) TrayPartitionInvalid=>json_null() TrayPartitionNeedsOutline=>json_null()}),json_kv(key:"open_design_obligations",value:json_int(n:count(p.open))),json_kv(key:"standing",value:json_string(s:"project and interface model; no fabrication-ready tray or electrical redesign"))])))
}
