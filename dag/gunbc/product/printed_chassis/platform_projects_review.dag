module product.printed_chassis.platform_projects_review
import std.types {List,String}
import product.printed_chassis.board_mechanical_reference {mounting_reference_json}
import std.measure {micrometer_count}
import v2.std.optional {Present,Absent}
import product.printed_chassis.cassette_profile {CassetteProfile,ProvisionalBoardOutline,PublishedBoardOutline,BoardOutlinePending,RetainPlatformPowerAssembly,IndependentPowerCassette,board_grid_tiles}
import product.printed_chassis.cassette_profiles {cassette_profiles}
import product.printed_chassis.cassette_layout {partition_profile,TrayPartitionKnown,TrayPartitionInvalid,TrayPartitionNeedsOutline,layout_for,LayoutKnown,LayoutNeedsBoardOutline,InvalidEdgeMargin}
import extdeps.languages.json.emit {JsonValue,json_object,json_kv,json_array,json_string,json_int,json_null}
fn platform_projects_review() -> JsonValue {
 json_array(elements:map(cassette_profiles,p=>json_object(members:[json_kv(key:"id",value:json_string(s:p.id as String)),json_kv(key:"hardware",value:json_string(s:p.requested_hardware as String)),json_kv(key:"board_outline_um",value:match p.outline {ProvisionalBoardOutline {width:w,depth:d,reference:_}=>json_array(elements:[json_int(n:micrometer_count(m:w)),json_int(n:micrometer_count(m:d))]) BoardOutlinePending=>json_null() PublishedBoardOutline {width:w,depth:d}=>json_array(elements:[json_int(n:micrometer_count(m:w)),json_int(n:micrometer_count(m:d))])}),json_kv(key:"outline_evidence",value:json_string(s:match p.outline {BoardOutlinePending=>"unresolved" PublishedBoardOutline {width:_,depth:_}=>"published outline; mounting coordinates separate" ProvisionalBoardOutline {width:_,depth:_,reference:r}=>r as String})),json_kv(key:"mounting_reference",value:mounting_reference_json(id:p.id as String)),json_kv(key:"power_intent",value:json_string(s:match p.power {RetainPlatformPowerAssembly=>"retain vendor power assembly with node; compatibility unresolved" IndependentPowerCassette=>"separate power cassette"})),json_kv(key:"board_only_180mm_grid_tiles",value:match board_grid_tiles(project:p,usable_tile_um:180000) {Absent=>json_null() Present {value:n}=>json_int(n:n)}),json_kv(key:"shared_tray_outline_um",value:match layout_for(profile:p,edge_margin_um:14000) {LayoutKnown {layout:l}=>json_array(elements:[json_int(n:l.tray_width),json_int(n:l.tray_depth)]) LayoutNeedsBoardOutline=>json_null() InvalidEdgeMargin=>json_null()}),json_kv(key:"shared_partition",value:match partition_profile(profile:p,edge_margin_um:14000,bed_um:180000,feature_budget_um:30000) {TrayPartitionKnown {partition:g}=>json_object(members:[json_kv(key:"columns",value:json_int(n:g.columns)),json_kv(key:"rows",value:json_int(n:g.rows)),json_kv(key:"cells",value:json_int(n:count(g.cells))),json_kv(key:"joints",value:json_int(n:count(g.edges))),json_kv(key:"standing",value:json_string(s:"bed allocation graph; local features and mounting map still required"))]) TrayPartitionInvalid=>json_null() TrayPartitionNeedsOutline=>json_null()}),json_kv(key:"open_design_obligations",value:json_int(n:count(p.open))),json_kv(key:"standing",value:json_string(s:"project and interface model; no fabrication-ready tray or electrical redesign"))])))
}
