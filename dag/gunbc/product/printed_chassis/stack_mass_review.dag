module product.printed_chassis.stack_mass_review
import std.types {String,List}
import std.measure {gram_count}
import std.affine_space {signed_frame_component_count}
import gunbc.fleet_intent {srv3_memory_population,srv4_memory_population}
import product.printed_chassis.component_mass {MassComponent,MassLedger,MassIncomplete,MassComplete,MassNeeded,VendorNominal,BoundedMass,node_components,station_components,with_board_cpu_group,mass_ledger}
import product.printed_chassis.placed_mass_model {load_from_ledger,LowerMassEndpoint,SupportRectangle,InvalidLoadScenario,RigidBodyScreen}
import product.printed_chassis.stack_geometry {stack_pitch,footprint_half_width,footprint_half_depth}
import extdeps.languages.json.emit {JsonValue,json_object,json_kv,json_string,json_int,json_array,json_null,serialize_json}
import gunbc.cli_wire {CliWireResponse,CliWirePrintable}
import std.process {ExitSuccess}
fn row_json(r:MassComponent) -> JsonValue {
 let bounds=match r.mass {MassNeeded {reason:_}=>json_null() VendorNominal {mass:g}=>json_array(elements:[json_int(n:gram_count(g:g)),json_int(n:gram_count(g:g))]) BoundedMass {lower:l,upper:u,basis:_}=>json_array(elements:[json_int(n:gram_count(g:l)),json_int(n:gram_count(g:u))])}
 json_object(members:[json_kv(key:"id",value:json_string(s:r.id)),json_kv(key:"quantity",value:json_int(n:r.quantity)),json_kv(key:"each_mass_bounds_g",value:bounds),json_kv(key:"position_um",value:json_array(elements:[json_int(n:signed_frame_component_count(c:r.at.x)),json_int(n:signed_frame_component_count(c:r.at.y)),json_int(n:signed_frame_component_count(c:r.at.z))])),json_kv(key:"position_evidence",value:json_string(s:"review placement; centre of mass not surveyed"))])
}
fn node_json(id:String,rows:List<MassComponent>) -> JsonValue {
 let ledger=mass_ledger(components:rows,measurements:[])
 let reading=load_from_ledger(ledger:ledger,endpoint:LowerMassEndpoint,support:SupportRectangle {half_x_um:footprint_half_width(),half_z_um:footprint_half_depth()},push_height_um:stack_pitch())
 json_object(members:[json_kv(key:"id",value:json_string(s:id)),json_kv(key:"components",value:json_array(elements:map(rows,r=>row_json(r:r)))),json_kv(key:"load_screen",value:json_string(s:match reading {InvalidLoadScenario {reason:r}=>r as String RigidBodyScreen {mass_g:_,cg_x_um:_,cg_y_um:_,cg_z_um:_,restoring_x_positive_mn_mm:_,restoring_x_negative_mn_mm:_,restoring_z_positive_mn_mm:_,restoring_z_negative_mn_mm:_,tip_push_mn:_,tip_base_acceleration_um_s2:_,corner_reactions_mn:_,boundary:b}=>b as String}))])
}
fn main() -> CliWireResponse {
 let report=json_object(members:[json_kv(key:"schema",value:json_string(s:"gunbc.stack-mass-review.v1")),json_kv(key:"nodes",value:json_array(elements:[node_json(id:"srv3",rows:with_board_cpu_group(components:node_components(population:srv3_memory_population))),node_json(id:"srv4",rows:with_board_cpu_group(components:node_components(population:srv4_memory_population)))])),json_kv(key:"power_station",value:json_array(elements:map(station_components(),r=>row_json(r:r)))),json_kv(key:"safe_stack_height",value:json_null())])
 CliWirePrintable {bytes:serialize_json(v:report),exit:ExitSuccess}
}
