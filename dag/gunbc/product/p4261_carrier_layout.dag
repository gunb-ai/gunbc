    ObservedComponent {
      designators: ["F300", "F302"],
      quantity: 1,
      role: "fuse body spanning the F300/F302 pads",
      identification: RatingPrintedOnBody {
        voltage: Present { value: ComponentVoltageRating { kind: FuseInterruptRating, maximum: volt(count: 75) } },
        current: Present { value: ampere(count: 100) },
        marking_read: "75V 100A (leading maker glyph not legible)",
      },
      path: MainInputPath,
      membership: k1_adjacency_main,
    },
    ObservedComponent {
      designators: [],
      quantity: 1,
      role: "power inductor in the main input stage",
      identification: MarkingUnresolved { marking_read: "A850 / Coilcraft / D", discriminator: "look up Coilcraft's part for code A850 and read its current and inductance" },
      path: MainInputPath,
      membership: k1_adjacency_main,
    },
    ObservedComponent {
      designators: ["D2"],
      quantity: 2,
      role: "diodes in SMA/SMB-class packages, one in the main stage and D2 beside J20",
      identification: MarkingUnresolved { marking_read: "5P0X / ZCNSU (as read)", discriminator: "a sharper photograph of the marking, matched to a diode maker's marking table" },
      path: AuxiliaryInputPath,
      membership: k1_adjacency_aux,
    },
    ObservedComponent {
      designators: ["F1"],
      quantity: 1,
      role: "fuse beside J20",
      identification: RatingPrintedOnBody { voltage: Absent, current: Present { value: ampere(count: 12) }, marking_read: "12A (leading maker glyph not legible)" },
      path: AuxiliaryInputPath,
      membership: k1_adjacency_aux,
    },
    ObservedComponent {
      designators: [],
      quantity: 1,
      role: "current-sense resistor beside F1",
      identification: ResistanceCodeRead { milliohms: 10, marking_read: "R010" },
      path: AuxiliaryInputPath,
      membership: k1_adjacency_aux,
    },
    ObservedComponent {
      designators: [],
      quantity: 2,
      role: "resistors marked R150, one above the upper capacitor and one below F1",
      identification: ResistanceCodeRead { milliohms: 150, marking_read: "R150" },
      path: AuxiliaryInputPath,
      membership: k1_adjacency_aux,
