module product.printing.deposited_geometry
import std.types {String}

// Generic readback of functional and sacrificial deposition, independent of part IDs.
// Support geometry is exact motion centerlines (including arcs), not a solid scaffold
// or proof of stiffness, adhesion, collision clearance or successful deposition.
fn deposited_geometry_source() -> String {join([
 "def toolpaths(gcode):\n",
 "    x=y=z=e=0.;absolute=True;erel=False;active=False;pts=[];arcs=0;feed=None;observation=ProcessObservation()\n",
 "    extrusion=collections.defaultdict(float);supports=collections.defaultdict(float);kind='unclassified';obj='outside-object'\n",
 "    object_bounds=\{\};support_geometry=collections.defaultdict(list)\n",
 "    for line in gcode.splitlines():\n",
 "        if line.startswith('; CHANGE_LAYER'):active=True;observation.new_layer()\n",
 "        if line.startswith('; filament end gcode'):active=False\n",
 "        if line.startswith('; FEATURE: '):kind=line[len('; FEATURE: '):]\n",
 "        if line.startswith('; printing object '):obj=line[len('; printing object '):].split(' id:')[0]\n",
 "        if line.startswith('; stop printing object '):obj='outside-object'\n",
 "        code=line.split(';')[0].strip();words=code.split()\n",
 "        if not words:continue\n",
 "        cmd=words[0]\n",
 "        if active and cmd in ('G0','G1','G2','G3','G92'):\n",
 "            for word in words[1:]:\n",
 "                if word[0] in 'XYZEFIJKR':assert re.fullmatch(r'[XYZEFIJKR][+-]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)',word), 'Unparsed motion word'\n",
 "        v=\{k:float(n) for k,n in re.findall(r'([XYZEFIJKR])([+-]?(?:\\d+(?:\\.\\d*)?|\\.\\d+))',code)\}\n",
 "        assert all(math.isfinite(n) for n in v.values())\n",
 "        if cmd=='G90':absolute=True\n",
 "        if cmd=='G91':absolute=False\n",
 "        if cmd=='M83':erel=True\n",
 "        if cmd=='M82':erel=False\n",
 "        if active:assert cmd not in ('G18','G19','G20','G90.1','G91.1'), 'Unsupported in-print coordinate mode'\n",
 "        if active and cmd=='G92':assert not any(k in v for k in ('X','Y','Z')), 'Unsupported coordinate reset'\n",
 "        if cmd=='G92':x=v.get('X',x);y=v.get('Y',y);z=v.get('Z',z);e=v.get('E',e)\n",
 "        if active and cmd in ('G10','G11'):observation.layer['firmware_retraction_commands']+=1\n",
 "        if cmd not in ('G0','G1','G2','G3'):continue\n",
 "        feed=v.get('F',feed)\n",
 "        nx=v.get('X',x) if absolute else x+v.get('X',0)\n",
 "        ny=v.get('Y',y) if absolute else y+v.get('Y',0)\n",
 "        nz=v.get('Z',z) if absolute else z+v.get('Z',0)\n",
 "        de=v.get('E',0) if erel else v.get('E',e)-e\n",
 "        arc_length=None\n",
 "        depositing=de>0 and any(k in v for k in ('X','Y','I','J','R'))\n",
 "        if active and depositing:\n",
 "            point_start=len(pts)\n",
 "            pts.extend(((x,y,z),(nx,ny,nz)));extrusion[kind]+=de\n",
 "            if kind in ('Support','Support interface'):supports[obj]+=de\n",
 "            if cmd in ('G2','G3'):\n",
 "                assert 'R' not in v and ('I' in v or 'J' in v), 'Unsupported radius arc'\n",
 "                cx=x+v.get('I',0);cy=y+v.get('J',0);r=math.hypot(x-cx,y-cy)\n",
 "                assert r>0 and abs(math.hypot(nx-cx,ny-cy)-r)<.05, 'Invalid arc radius'\n",
 "                a=math.atan2(y-cy,x-cx);b=math.atan2(ny-cy,nx-cx);ccw=cmd=='G3';tau=2*math.pi\n",
 "                sweep=((b-a) if ccw else (a-b))%tau\n",
 "                if math.hypot(nx-x,ny-y)<1e-7:sweep=tau\n",
 "                for theta in (0,math.pi/2,math.pi,3*math.pi/2):\n",
 "                    travel=((theta-a) if ccw else (a-theta))%tau\n",
 "                    if travel<=sweep+1e-7:pts.extend(((cx+r*math.cos(theta),cy+r*math.sin(theta),z),(cx+r*math.cos(theta),cy+r*math.sin(theta),nz)))\n",
 "                arcs+=1;arc_length=math.hypot(r*sweep,nz-z)\n",
 "            points=pts[point_start:]\n",
 "            prior=object_bounds.get(obj,[math.inf]*3+[-math.inf]*3)\n",
 "            object_bounds[obj]=[min(prior[i],*(p[i] for p in points)) for i in range(3)]+[max(prior[i+3],*(p[i] for p in points)) for i in range(3)]\n",
 "            if kind in ('Support','Support interface'):\n",
 "                support_geometry[obj].append(dict(feature=kind,command=cmd,start_mm=[x,y,z],end_mm=[nx,ny,nz],center_xy_mm=[cx,cy] if cmd in ('G2','G3') else None,filament_mm=de))\n",
 "        if active:observation.move(cmd,(x,y,z),(nx,ny,nz),de,feed,obj,kind,depositing,arc_length)\n",
 "        x,y,z=nx,ny,nz;e=e+v.get('E',0) if erel else v.get('E',e)\n",
 "    assert pts, 'No deposited toolpath observed'\n",
 "    return dict(bounds=[min(p[i] for p in pts) for i in range(3)]+[max(p[i] for p in pts) for i in range(3)],arcs=arcs,extrusion=dict(extrusion),supports=dict(supports),object_bounds=object_bounds,support_geometry=dict(support_geometry),process_observation=observation.result())\n",
 "\n",
 "class ProcessObservation:\n",
 "    def __init__(self):\n",
 "        self.layers=[];self.debt=0.;self.travel_since_deposition=False\n",
 "    def new_layer(self):\n",
 "        self.layer=dict(index=len(self.layers)+1,deposited_z_min_mm=None,deposited_z_max_mm=None,objects=[],negative_e_moves=0,retraction_episodes=0,retracted_filament_mm=0.,recovered_filament_mm=0.,negative_e_xy_moves=0,nonextruding_xy_moves=0,nonextruding_xy_chord_mm=0.,deposition_runs_after_travel=0,commanded_motion_seconds=0.,unestimated_motion_moves=0,firmware_retraction_commands=0)\n",
 "        self.layers.append(self.layer)\n",
 "    def move(self,cmd,start,end,de,feed,obj,kind,depositing,arc_length):\n",
 "        row=self.layer;xy=math.hypot(end[0]-start[0],end[1]-start[1]);xyz=math.dist(start,end)\n",
 "        if de < -1e-9:\n",
 "            row['negative_e_moves']+=1;row['retraction_episodes']+=int(self.debt<=1e-9)\n",
 "            row['retracted_filament_mm']-=de;row['negative_e_xy_moves']+=int(xy>1e-9);self.debt-=de\n",
 "        elif de>0:\n",
 "            recovered=min(self.debt,de);self.debt-=recovered;row['recovered_filament_mm']+=recovered\n",
 "        if de<=0 and (xy>1e-9 or cmd in ('G2','G3')):\n",
 "            row['nonextruding_xy_moves']+=1;row['nonextruding_xy_chord_mm']+=xy;self.travel_since_deposition=True\n",
 "        if depositing:\n",
 "            row['deposition_runs_after_travel']+=int(self.travel_since_deposition);self.travel_since_deposition=False\n",
 "            lo=min(start[2],end[2]);hi=max(start[2],end[2])\n",
 "            row['deposited_z_min_mm']=lo if row['deposited_z_min_mm'] is None else min(row['deposited_z_min_mm'],lo)\n",
 "            row['deposited_z_max_mm']=hi if row['deposited_z_max_mm'] is None else max(row['deposited_z_max_mm'],hi)\n",
 "            if obj!='outside-object' and kind not in ('Support','Support interface','Brim','Skirt') and obj not in row['objects']:row['objects'].append(obj)\n",
 "        distance=arc_length if cmd in ('G2','G3') else (xyz if xyz>1e-9 else abs(de))\n",
 "        if distance is None or (distance>0 and (feed is None or feed<=0)):row['unestimated_motion_moves']+=1\n",
 "        elif distance>0:row['commanded_motion_seconds']+=60*distance/feed\n",
 "    def result(self):\n",
 "        return dict(schema='gunbc.print-process-observation.v1',standing='commanded toolpath observations; no physical success or stringing verdict',timing_basis='path length divided by modal commanded feed; includes deposited arcs; excludes acceleration, firmware limits, dwell, synchronization and temperature waits; unestimated moves counted; not actual layer time',travel_basis='nonextruding XY commands including retracting wipes; deposition runs after travel are not geometric islands',extrusion_basis='negative-E episodes and positive-E recovery debt across layer/G92 boundaries; firmware G10/G11 counted separately, not resolved',measured_layer_seconds=None,slicer_layer_seconds=None,unrecovered_filament_mm=self.debt,layers=self.layers)\n",
 "\n",
],"")}
