module product.printing.process_geometry
import std.types {Int,Bool,List}
import std.measure {Micrometer, micrometer, micrometer_count}
import extdeps.languages.json.emit {JsonValue,JsonKeyValue,json_object,json_kv,json_int,json_bool,json_string}

import std.decimal {ExactDecimal,exact_decimal_wire}

// Manufacturing geometry is separate from functional geometry. The pinned slicer
// is the first generic support realizer; no part name selects handcrafted supports.
// These are process-policy inputs, not claims of material or stability qualification.
type AutomaticSupportPolicy {threshold_degrees:Int,top_gap_um:Micrometer,bottom_gap_um:Micrometer,xy_gap_um:Micrometer,bed_only:Bool}
data prototype_support_policy:AutomaticSupportPolicy=AutomaticSupportPolicy {
 threshold_degrees:30,top_gap_um:micrometer(count: 200),bottom_gap_um:micrometer(count: 200),xy_gap_um:micrometer(count: 350),bed_only:true,
}
fn support_policy_json(p:AutomaticSupportPolicy) -> JsonValue {
 json_object(members:[
  json_kv(key:"algorithm",value:json_string(s:"normal(auto)")),
  json_kv(key:"threshold_degrees",value:json_int(n:p.threshold_degrees)),
  json_kv(key:"top_gap_um",value:json_int(n:micrometer_count(m: p.top_gap_um) as Int)),
  json_kv(key:"bottom_gap_um",value:json_int(n:micrometer_count(m: p.bottom_gap_um) as Int)),
  json_kv(key:"xy_gap_um",value:json_int(n:micrometer_count(m: p.xy_gap_um) as Int)),
  json_kv(key:"bed_only",value:json_bool(b:p.bed_only))
 ])
}

// Settings admission and the support artifact share this policy. A sidecar cannot
// claim one gap/algorithm while the sliced archive actually uses another.
fn support_settings(p:AutomaticSupportPolicy) -> List<JsonKeyValue> {
 [
  json_kv(key:"enable_support",value:json_string(s:"1")),
  json_kv(key:"support_type",value:json_string(s:"normal(auto)")),
  json_kv(key:"support_threshold_angle",value:json_string(s:to_string(p.threshold_degrees))),
  json_kv(key:"support_on_build_plate_only",value:json_string(s:if p.bed_only {"1"} else {"0"})),
  json_kv(key:"support_top_z_distance",value:json_string(s:exact_decimal_wire(d:ExactDecimal {units:micrometer_count(m: p.top_gap_um) as Int,fraction_digits:3}))),
  json_kv(key:"support_bottom_z_distance",value:json_string(s:exact_decimal_wire(d:ExactDecimal {units:micrometer_count(m: p.bottom_gap_um) as Int,fraction_digits:3}))),
  json_kv(key:"support_object_xy_distance",value:json_string(s:exact_decimal_wire(d:ExactDecimal {units:micrometer_count(m: p.xy_gap_um) as Int,fraction_digits:3})))
 ]
}

// Export already applies the part's modeled print plane. Packing may rotate in
// that plane, but tipping it needs a build-stage stability assessment we do not
// yet possess. Preserving the plane is a necessary guard, not a stability proof.
type OrientationStanding = ModeledPrintPlanePreserved | BuildStabilityReviewRequired
fn orientation_standing(rx:Int,ry:Int) -> OrientationStanding {
 if rx==0 && ry==0 {ModeledPrintPlanePreserved} else {BuildStabilityReviewRequired}
}
fn preserves_print_plane(rx:Int,ry:Int) -> Bool {
 match orientation_standing(rx:rx,ry:ry) {ModeledPrintPlanePreserved=>true BuildStabilityReviewRequired=>false}
}
