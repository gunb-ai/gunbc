module product.fabric.failure_scenario_admission

import std.types { Bool, Int, List, EpochSecs }
import v2.std.optional { Present, Absent }
import std.decl_ref { DeclarationRef, declaration_ref_eq }
import product.fabric.identity { FabricIdentity, OfferKey, WorkKey, DemandKey, fabric_identity_eq }
import product.fabric.capacity_admission { AdmittedCapacity }

// COMMITTED DEMAND IS ADMITTED ONLY IF IT SURVIVES THE FAILURES WE DECLARE WE WILL ABSORB.
//
// A cheap machine may be down; what the customer holds is a logical allocation, so availability is
// synthesized from a PORTFOLIO of interchangeable supply rather than inherited from any one host
// (operator, 2026-09-17). The fact that makes that true or false is this one: for each declared
// failure scenario - one node, one circuit, one site, one provider - does the supply that SURVIVES it
// still cover the committed demand plus its margin? If yes, a failure in that scenario is a capacity
// and cost event, never a customer outage and never an urgent repair visit. If no, the demand is not
// admitted, and the shortfall names the scenario that breaks it.
//
// WHAT COUNTS AS USABLE SUPPLY IS NOT DECIDED HERE AT ALL. This fold receives AdmittedCapacity
// values: product.fabric.capacity_admission has already run route correspondence, supply evidence,
// route readiness, provider-use admission and fungibility, and its sole constructor is the proof. An
// earlier revision screened a SUBSET of those itself, which made this module a second authority on
// the same question and let it disagree with the dispatch path in both directions - an unobserved
// offer could enter the candidate field, and an offer whose use admission denied it could still be
// counted as a reserve (DESIGN section 3, side review of this chain). What this fold decides, and all
// it decides, is which admitted capacity a declared failure removes and whether what survives still
// covers the committed demand.
//
// A FAILURE DOMAIN IS A CITED DECLARATION, the same grain as ProviderRoute's components. An offer's
// provider and region are domains it is always in, derived from its route; everything below that -
// site, circuit, switch, node - is OUR fact about where the capacity physically sits, so it is a
// roster the caller supplies, and an offer with no roster row REFUSES rather than defaulting to "in
// no finer domain". Defaulting would silently treat an owned node as surviving its own site's loss,
// which is exactly the correlated failure this fold exists to price.
type OfferFailureDomains<P> {
  offer: FabricIdentity<P, OfferKey>
  domains: List<DeclarationRef>
}

// A SCENARIO LOSES DECLARED DOMAINS, NAMED OFFERS, OR BOTH, AND THE TWO ARE DIFFERENT KINDS OF FACT.
//
// A domain is a CITED DECLARATION - a provider, a region, a site, a circuit - and it resolves to a
// symbol the namespace authority already checks. An individual host has no such declaration: it is
// one offer in a roster, and its identity is a FabricIdentity. Before this field, a caller wanting
// "lose one node" had to MINT a DeclarationRef for it, which is a dangling citation wearing the
// carrier that promises resolution (gunbc-private#141, review 67435: twenty field-grain refs against
// a declaration carrying no fields, which v2.std.decl_ref_resolution refuses as
// DeclarationRefFieldAbsent). Losing an offer by its own identity needs no synthetic name at all.
type FailureScenario<P> {
  scenario: DeclarationRef
  lost: List<DeclarationRef>
  lost_offers: List<FabricIdentity<P, OfferKey>>
}

// A COMMITTED DEMAND IS COMMITTED BY CONSTRUCTION, NOT BY A FIELD THAT COULD SAY OTHERWISE.
//
// An earlier revision gave this type a DemandStanding field with a DemandPlanned arm, so
// `CommittedDemand { standing: DemandPlanned { .. } }` was writable and a runtime refusal caught it.
// That is validation standing where construction was available, and it is also a meaning fork: one
// name covering both a commitment and a planning figure, with the difference carried in a field
// (DESIGN sections 3 and 5; review 67483). The name now means what it says - the receipt is what a
// caller must have to build one, and a demand assembled from planning figures cannot inhabit this
// type at all. Whoever wants the counterfactual answers it in a planning carrier of their own that
// names the assumptions it made, which is what gunbc-private#141 does.
//
// grants is committed concurrent grants of this work's requirements; margin is the operational
// headroom required above it. Both are in the unit of SupplierOffer.quantity_bound.
// NO requirements FIELD, AND THAT IS THE REPAIR RATHER THAN AN OMISSION. The requirements a capacity
// was admitted against live on the capacity that proved them (product.fabric.capacity_admission), so
// a second copy here could disagree with them - admitted at eight threads, counted against sixteen -
// and nothing in the join would see it. One fact, one home: this demand says WHO is asking and HOW
// MUCH, and the capacity says what it was proved for.
type CommittedDemand<P> {
  demand: FabricIdentity<P, DemandKey>
  work: FabricIdentity<P, WorkKey>
  receipt: DeclarationRef
  grants: Int
  margin: Int
}

type ScenarioShortfall<P> {
  scenario: DeclarationRef
  work: FabricIdentity<P, WorkKey>
  surviving: Int
  required: Int
}

// EACH REFUSAL IS A DIFFERENT THING TO GO AND DO. No scenarios: declare which failures you intend to
// absorb (an empty set would admit vacuously). Undeclared or ambiguous domains: record where that
// capacity physically sits. Shared offer: two demand classes draw on one offer, and summing it into
// both would sell it twice - joint allocation is not modeled here, so it refuses rather than
// double counting. Shortfall: buy, exercise or spread supply until the named scenario survives.
type FailureScenarioRefusal<P>
  = NoFailureScenariosDeclared
  | OfferFailureDomainsUndeclared { offer: FabricIdentity<P, OfferKey> }
  | OfferFailureDomainsAmbiguous { offer: FabricIdentity<P, OfferKey> }
  | OfferSharedAcrossDemands { offer: FabricIdentity<P, OfferKey> }
  | ScenarioNamesUnknownOffer { scenario: DeclarationRef, offer: FabricIdentity<P, OfferKey> }
  | ScenarioNotSurvived { shortfall: ScenarioShortfall<P> }

type FailureScenarioAdmission<P>
  = FailureScenariosSurvived { scenarios: List<FailureScenario<P>>, demands: List<CommittedDemand<P>> }
  | FailureScenariosRefused { refusals: List<FailureScenarioRefusal<P>> }

fn domain_rows_for<P>(roster: List<OfferFailureDomains<P>>, offer: FabricIdentity<P, OfferKey>) -> List<OfferFailureDomains<P>> {
  filter(roster, r => fabric_identity_eq(left: r.offer, right: offer))
}

fn domain_refusals<P>(roster: List<OfferFailureDomains<P>>, capacity: AdmittedCapacity<P>) -> List<FailureScenarioRefusal<P>> {
  let n = count(domain_rows_for(roster: roster, offer: capacity.offer.id))
  if n == 0 {
    [OfferFailureDomainsUndeclared { offer: capacity.offer.id }]
  } else if n > 1 {
    [OfferFailureDomainsAmbiguous { offer: capacity.offer.id }]
  } else {
    []
  }
}

// The route's provider and region, then the roster's finer domains. Only called once the roster is
// known to hold exactly one row for the offer.
fn capacity_domains<P>(roster: List<OfferFailureDomains<P>>, capacity: AdmittedCapacity<P>) -> List<DeclarationRef> {
  concat(
    [capacity.offer.route.provider, capacity.offer.route.region],
    flat_map(domain_rows_for(roster: roster, offer: capacity.offer.id), r => r.domains),
  )
}

// A capacity is admitted FOR one demand and one work, so the supply a demand may draw on is the
// capacity admitted for BOTH of its identities. Matching on work alone would count capacity whose
// permit was minted for another customer's demand that happens to share a work identity. Nothing is
// re-screened: the screens ran in capacity_admission.
fn eligible_capacity<P>(capacities: List<AdmittedCapacity<P>>, demand: CommittedDemand<P>) -> List<AdmittedCapacity<P>> {
  filter(capacities, c =>
    fabric_identity_eq(left: c.work, right: demand.work)
      && fabric_identity_eq(left: c.demand, right: demand.demand))
}

fn domain_is_lost(lost: List<DeclarationRef>, domain: DeclarationRef) -> Bool {
  count(filter(lost, l => declaration_ref_eq(a: l, b: domain))) > 0
}

// A HOST IS LOST BY ITS OWN IDENTITY OR BY A DOMAIN IT SITS IN, and either is enough to remove it.
fn capacity_is_named_lost<P>(scenario: FailureScenario<P>, capacity: AdmittedCapacity<P>) -> Bool {
  count(filter(scenario.lost_offers, o => fabric_identity_eq(left: o, right: capacity.offer.id))) > 0
}

fn capacity_survives<P>(roster: List<OfferFailureDomains<P>>, scenario: FailureScenario<P>, capacity: AdmittedCapacity<P>) -> Bool {
  count(filter(capacity_domains(roster: roster, capacity: capacity), d => domain_is_lost(lost: scenario.lost, domain: d))) == 0
    && !capacity_is_named_lost(scenario: scenario, capacity: capacity)
}

fn surviving_grants<P>(roster: List<OfferFailureDomains<P>>, scenario: FailureScenario<P>, eligible: List<AdmittedCapacity<P>>) -> Int {
  fold(
    filter(eligible, c => capacity_survives(roster: roster, scenario: scenario, capacity: c)),
    init: 0,
    f: (total, c) => total + c.offer.quantity_bound,
  )
}

// A DEMAND'S ELIGIBLE SUPPLY IS DECIDED ONCE, not once per scenario.
type DemandSupply<P> {
  demand: CommittedDemand<P>
  eligible: List<AdmittedCapacity<P>>
}

// EVERY NAMED CAPACITY MUST BE IN THE ROSTER, checked before any scenario is evaluated. This is the
// structural twin of the undeclared-domain refusal: both close the arm where a scenario silently
// applies less loss than it names.
fn unknown_offer_refusals<P>(
  capacities: List<AdmittedCapacity<P>>,
  scenario: FailureScenario<P>,
) -> List<FailureScenarioRefusal<P>> {
  flat_map(scenario.lost_offers, named =>
    if count(filter(capacities, c => fabric_identity_eq(left: c.offer.id, right: named))) == 0 {
      [ScenarioNamesUnknownOffer { scenario: scenario.scenario, offer: named }]
    } else {
      []
    })
}

fn scenario_refusals<P>(
  roster: List<OfferFailureDomains<P>>,
  supply: DemandSupply<P>,
  scenario: FailureScenario<P>,
) -> List<FailureScenarioRefusal<P>> {
  let surviving = surviving_grants(roster: roster, scenario: scenario, eligible: supply.eligible)
  let required = supply.demand.grants + supply.demand.margin
  if surviving >= required {
    []
  } else {
    [ScenarioNotSurvived {
      shortfall: ScenarioShortfall { scenario: scenario.scenario, work: supply.demand.work, surviving: surviving, required: required },
    }]
  }
}

fn capacity_is_in<P>(capacities: List<AdmittedCapacity<P>>, offer: FabricIdentity<P, OfferKey>) -> Bool {
  count(filter(capacities, c => fabric_identity_eq(left: c.offer.id, right: offer))) > 0
}

// ONE REFUSAL PER SHARED OFFER, NOT ONE PER CAPACITY THAT MENTIONS IT. A capacity is admitted FOR a
// work, so a roster serving two demands holds two capacities over the same offer - which is the
// sharing this refusal is about, and reporting it twice would make the count of refusals depend on
// how many demands happened to be asked rather than on how many offers are double-counted. The scan
// carries the offers it has already reported, so each is named once, in roster order.
fn shared_offer_scan<P>(
  remaining: List<AdmittedCapacity<P>>,
  reported: List<FabricIdentity<P, OfferKey>>,
  supplies: List<DemandSupply<P>>,
) -> List<FailureScenarioRefusal<P>> {
  match remaining.first() {
    Absent => []
    Present { value: c } => {
      let rest = remaining.skip(n: 1)
      if count(filter(reported, o => fabric_identity_eq(left: o, right: c.offer.id))) > 0 {
        shared_offer_scan(remaining: rest, reported: reported, supplies: supplies)
      } else {
        let seen = concat(reported, [c.offer.id])
        if count(filter(supplies, s => capacity_is_in(capacities: s.eligible, offer: c.offer.id))) > 1 {
          concat(
            [OfferSharedAcrossDemands { offer: c.offer.id }],
            shared_offer_scan(remaining: rest, reported: seen, supplies: supplies),
          )
        } else {
          shared_offer_scan(remaining: rest, reported: seen, supplies: supplies)
        }
      }
    }
  }
}

fn sharing_refusals<P>(capacities: List<AdmittedCapacity<P>>, supplies: List<DemandSupply<P>>) -> List<FailureScenarioRefusal<P>> {
  shared_offer_scan(remaining: capacities, reported: [], supplies: supplies)
}

// STRUCTURAL REFUSALS ARE DECIDED BEFORE ANY SCENARIO IS EVALUATED, because a shortfall computed over
// an undeclared domain, a planned demand or a double-counted capacity is a number that looks like an
// answer and is not.
fn admit_failure_scenarios<P>(
  capacities: List<AdmittedCapacity<P>>,
  domains: List<OfferFailureDomains<P>>,
  demands: List<CommittedDemand<P>>,
  scenarios: List<FailureScenario<P>>,
) -> FailureScenarioAdmission<P> {
  let supplies = map(demands, d => DemandSupply { demand: d, eligible: eligible_capacity(capacities: capacities, demand: d) })
  let structural = concat(
    if count(scenarios) == 0 { [NoFailureScenariosDeclared] } else { [] },
    concat(
      flat_map(capacities, c => domain_refusals(roster: domains, capacity: c)),
      concat(
        flat_map(scenarios, sc => unknown_offer_refusals(capacities: capacities, scenario: sc)),
        sharing_refusals(capacities: capacities, supplies: supplies),
      ),
    ),
  )
  if count(structural) > 0 {
    FailureScenariosRefused { refusals: structural }
  } else {
    let shortfalls = flat_map(supplies, sup =>
      flat_map(scenarios, sc => scenario_refusals(roster: domains, supply: sup, scenario: sc)))
    if count(shortfalls) > 0 {
      FailureScenariosRefused { refusals: shortfalls }
    } else {
      FailureScenariosSurvived { scenarios: scenarios, demands: demands }
    }
  }
}
