module product.fabric.provider_admission

import std.types { Bool, List, String }
import std.decl_ref { DeclarationRef, declaration_ref_eq }
import std.content_hash { ContentHash }
import std.access { AccessDecision, access_policy_refusal }
import product.fabric.identity { FabricIdentity, DemandKey, WorkKey, OfferKey }
import product.fabric.provider_route {
  ProviderRouteRef, CompliancePostureRevision, ProviderRouteFacts,
  data_path_closure_is_complete, downstream_is_assessed,
  first_unresolved_obligation, downstream_obligation,
}

// THE EXECUTABLE JOIN. strategy.compliance_posture already claims that regional admission
// covers object storage, logs, telemetry, backups, support access and spill - not merely the
// runner VM - and the code that actually places work admits on architecture, dedication,
// interruption and price. Two authorities answer "may this job run here" and the deciding one
// carries no compliance term, so the claim is prose over an unenforced path. This module is the
// missing relation: active posture revision x exact demand/work/customer/data scope x provider
// route -> provider-use admission, and only the admitted arm may enter fabric selection.
//
// WHERE IT SITS IN THE ORDER, which is load-bearing and not a performance detail. Route
// resolution and posture admission run FIRST, then executor capacity sanction, then fungibility,
// then affordability, then cheapest. product.fabric.supply already states why price is last -
// so price can never rescue an offer that cannot run the work. The same argument applies one
// step earlier and more strongly: a sufficiently cheap offer must never buy its way through a
// missing legal or data-handling authority. Compliance is not depleted by use, so it is not a
// budget, and it does not belong anywhere in a selection cost.

// A DISPOSITION IS A STANDING, NOT A POINTER. These were once bare DeclarationRef fields on the
// use scope, which meant the sanctions, export and prohibited-use programs could hand this
// decision anything at all and it would neither read it nor record it - dangling inputs on the
// subject of the decision (DESIGN section 3c), and worse, an unresolved sanctions case would
// have been indistinguishable from a cleared one. A standing has to say which it is.
type DispositionStanding
  = DispositionCleared { evidence: DeclarationRef }
  | DispositionRefused { cause: DeclarationRef }
  | DispositionUnresolved { obligation: DeclarationRef }

fn disposition_is_cleared(d: DispositionStanding) -> Bool {
  match d {
    DispositionCleared { evidence } => true,
    DispositionRefused { cause } => false,
    DispositionUnresolved { obligation } => false,
  }
}

// The located obligation a refusal must name: the refusal cause for a refused disposition, the
// outstanding obligation for an unresolved one. A cleared disposition has neither, so this is
// zero-or-one and the caller reaches it only on the non-cleared arms.
fn disposition_obligation(d: DispositionStanding) -> List<DeclarationRef> {
  match d {
    DispositionCleared { evidence } => [],
    DispositionRefused { cause } => [cause],
    DispositionUnresolved { obligation } => [obligation],
  }
}

fn disposition_evidence_or(d: DispositionStanding, fallback: DeclarationRef) -> DeclarationRef {
  match d {
    DispositionCleared { evidence } => evidence,
    DispositionRefused { cause } => fallback,
    DispositionUnresolved { obligation } => fallback,
  }
}

// OUR ROSTER, NOT THE SUPPLIER'S. gunbc.fabric_executor_class already establishes the shape: we
// keep the sanction, an unclassified executor refuses, and the sanction is evaluated before
// fungibility. A supplier does not get to declare what it is sanctioned to serve, and a
// provider module that imported this one would be that inversion.
//
// The sanction is per posture revision by construction: a row admits a scope on a route UNDER a
// stated posture, so re-posturing does not silently re-admit anything.
type RouteScopeSanction {
  route: ProviderRouteRef
  posture: CompliancePostureRevision
  customer_profile: DeclarationRef
  data_handling_profile: DeclarationRef
  requires_agreement: DeclarationRef
}

// THE USE SCOPE. Admission is never a property of a route alone - the same route is admissible
// for ordinary build source and refused for regulated data - so the subject of a decision is
// always a route AND a use. The work stays provider-neutral; the demand side supplies the
// organisation and agreement facts; the dispositions are the already-resolved outputs of the
// sanctions, export and prohibited-use programs, and each must be CLEARED for a permit to mint.
type ProviderUseScope<P> {
  demand: FabricIdentity<P, DemandKey>
  work: FabricIdentity<P, WorkKey>
  customer_profile: DeclarationRef
  data_handling_profile: DeclarationRef
  agreement: DeclarationRef
  prohibited_use_disposition: DispositionStanding
  sanctions_disposition: DispositionStanding
  export_disposition: DispositionStanding
}

// CapacityClass is deliberately NOT a field here, which is a stated divergence from the
// directive's sketch rather than an oversight. Capacity sanction and provider-use admission are
// two non-economic gates that refuse for different reasons and produce different remediation:
// one is answered by classifying an executor, the other by gathering route facts or changing
// posture. Folding them into one scope would give the partition a single refused population and
// lose which of the two a caller must go fix.

// Every revision and clearance the decision actually read, recorded on the permit. This is what
// makes a permit re-derivable rather than merely historical. The three disposition evidences are
// here because a permit that gated on them and did not record them would be unauditable - the
// gate would have run and left no trace of what it saw.
type ProviderUseEvidence {
  posture_revision: ContentHash
  route_facts_revision: ContentHash
  customer_profile: DeclarationRef
  agreement: DeclarationRef
  prohibited_use_evidence: DeclarationRef
  sanctions_evidence: DeclarationRef
  export_evidence: DeclarationRef
  decision_receipt: DeclarationRef
}

// SEALED. sole_constructor confines minting to admit_provider_use below, so a permit cannot be
// authored beside the decision that is supposed to produce it. DESIGN section 4b's ceiling
// applies unchanged: this establishes WHO may construct one and nothing about whether the route
// facts were honestly observed, which stays a boundary obligation on whoever produced them.
type ProviderUsePermit<P> sole_constructor {
  demand: FabricIdentity<P, DemandKey>
  work: FabricIdentity<P, WorkKey>
  offer: FabricIdentity<P, OfferKey>
  route: ProviderRouteRef
  posture: CompliancePostureRevision
  evidence: ProviderUseEvidence
}

// EVERY REFUSAL IS CONSTRUCTIBLE, NAMES ITS OWN REMEDY, AND HAS A PRODUCER. The spill policy
// this replaces could express exactly four rejections - architecture, dedication, interruption,
// cost - so a jurisdiction refusal had no spelling at all and was not merely unimplemented but
// unwritable. Each arm below is a different thing to go and do.
//
// TWO ARMS WERE DELETED RATHER THAN LEFT UNINHABITABLE. TransferOrLocationUnresolved and
// ProviderAccessPathUnsupported both require comparing a LOCATED path's jurisdiction against the
// jurisdictions a posture permits, and the posture revision carried here is an authority plus a
// hash with no jurisdiction population to compare against. An arm no producer can inhabit is
// decoration that will later be cited as coverage (DESIGN section 4b), which is exactly why
// extdeps.regulation's FindingStanding carries no cleared arm. RESTORATION TRIGGER: a posture
// revision that carries its permitted-jurisdiction population, at which point a located path in
// a non-permitted jurisdiction becomes authorable and both arms land with their reds.
type ProviderUseRefusal
  = ProviderRouteUnclassified { route: ProviderRouteRef }
  | ProviderRouteFactsIncomplete { route: ProviderRouteRef, obligation: DeclarationRef }
  | DownstreamProviderUnassessed { obligation: DeclarationRef }
  | PostureRevisionStale { evaluated: List<ContentHash>, active: ContentHash }
  | CustomerScopeUnsupported { cause: DeclarationRef }
  | DataHandlingUnsupported { cause: DeclarationRef }
  | RequiredAgreementAuthorityAbsent { accepted: List<DeclarationRef> }
  | ProhibitedUseNotCleared { obligation: DeclarationRef }
  | SanctionsNotCleared { obligation: DeclarationRef }
  | ExportNotCleared { obligation: DeclarationRef }

// std.access.AccessDecision stays the allow/deny authority. This coproduct transports the
// sealed positive permit and the typed domain cause; it deliberately does NOT make a second,
// independent policy decision, because two policy authorities for one question is the fork this
// whole module exists to close.
type ProviderUseAdmission<P>
  = ProviderUseAdmitted { permit: ProviderUsePermit<P> }
  | ProviderUseDenied { decision: AccessDecision, cause: ProviderUseRefusal }

// There is deliberately no UnknownButProceed arm and no default route. An unresolved input
// refuses; it never widens.

// access_policy_refusal already returns a Deny-shaped AccessDecision, so this names the
// location once rather than letting each call site invent a profile/subject/action/object tuple.
fn provider_use_denial(reason: String) -> AccessDecision {
  access_policy_refusal(
    profile: "provider-use",
    subject: "provider-route",
    action: "execute",
    object: "customer-work",
    reason: reason,
  )
}

fn deny<P>(reason: String, cause: ProviderUseRefusal) -> ProviderUseAdmission<P> {
  ProviderUseDenied { decision: provider_use_denial(reason: reason), cause: cause }
}

// THE ROUTE-AND-CUSTOMER MATCH IS SEPARATE FROM THE FULL MATCH, and that separation is the whole
// point. An empty full-match set has two materially different causes - this customer profile is
// not sanctioned on this route at all, or it is but THIS DATA CLASS is not - and they are
// different things to go and do. Reporting both as CustomerScopeUnsupported names the wrong
// remedy, which under DESIGN section 5 is a fabricated diagnosis rather than a located one.
fn sanctions_for_route_and_customer<P>(
  roster: List<RouteScopeSanction>,
  route: ProviderRouteRef,
  scope: ProviderUseScope<P>,
) -> List<RouteScopeSanction> {
  filter(roster, s =>
    s.route == route && declaration_ref_eq(a: s.customer_profile, b: scope.customer_profile))
}

fn sanctions_for_route<P>(
  roster: List<RouteScopeSanction>,
  route: ProviderRouteRef,
  scope: ProviderUseScope<P>,
) -> List<RouteScopeSanction> {
  filter(
    sanctions_for_route_and_customer(roster: roster, route: route, scope: scope),
    s => declaration_ref_eq(a: s.data_handling_profile, b: scope.data_handling_profile),
  )
}

fn route_is_classified(roster: List<RouteScopeSanction>, route: ProviderRouteRef) -> Bool {
  count(filter(roster, s => s.route == route)) > 0
}

// Posture staleness compares two revisions minted by our own posture pipeline, so they are the
// same hash family by construction. Cross-family ContentHash comparison is separately governed
// by std.content_hash - refused at R0 today, a typecheck refusal after its Phase B - and this
// call site never straddles families because both operands come from the same producer.
fn posture_is_current(evaluated: CompliancePostureRevision, active: CompliancePostureRevision) -> Bool {
  evaluated.revision == active.revision
}

// EVERY stale revision found, not one extracted through a fold that needed an unreachable seed.
// The seed was PostureRevisionStale with evaluated and active set to the SAME hash - a cause
// asserting staleness between a revision and itself, which is self-contradicting, and which this
// module's own rule about unreachable values ("even the unreachable value would not lie")
// forbids. A list has no seed to fabricate: empty reads as "none recorded" rather than as a
// false equality, and the guard below only builds this refusal when it is non-empty.
fn stale_revisions(
  matched: List<RouteScopeSanction>,
  active: CompliancePostureRevision,
) -> List<ContentHash> {
  map(
    filter(matched, s => !posture_is_current(evaluated: s.posture, active: active)),
    s => s.posture.revision,
  )
}

// The agreements that WOULD have bound, for the same reason stale_revisions is a list: reporting
// every accepted agreement needs no fabricated seed, and it tells the caller which agreement to
// present rather than merely that the one they brought was wrong.
fn accepted_agreements(sanctions: List<RouteScopeSanction>) -> List<DeclarationRef> {
  map(sanctions, s => s.requires_agreement)
}

// THE PROGRAM IS A CLOSED COPRODUCT, NOT A STRING. This dispatch was briefly a stringly-typed
// discriminator - if which == "prohibited-use" ... else if "sanctions" ... else Export - which is
// an undeclared sum whose illegal values are representable, and which FAILED OPEN in exactly the
// way this module condemns elsewhere: a typo or a future fourth program silently routed to
// ExportNotCleared, a refusal with the wrong cause and the wrong remedy. That is the fabricated
// diagnosis of DESIGN section 5, and it is the same defect the DataHandlingUnsupported split was
// written to fix. As a coproduct the match is exhaustive, so a fourth program fails to compile
// rather than quietly becoming an export refusal.
type DispositionProgram
  = ProhibitedUseProgram
  | SanctionsProgram
  | ExportProgram

fn disposition_program_refusal(p: DispositionProgram, obligation: DeclarationRef) -> ProviderUseRefusal {
  match p {
    ProhibitedUseProgram => ProhibitedUseNotCleared { obligation: obligation },
    SanctionsProgram => SanctionsNotCleared { obligation: obligation },
    ExportProgram => ExportNotCleared { obligation: obligation },
  }
}

// The zero-or-one obligation lists are folded into a refusal here. Each fold runs over a list
// the guard has already proven non-empty, so the init is unreachable; it names the same route or
// provider rather than a placeholder so that even the unreachable value would not lie.
fn path_incomplete_refusal(facts: ProviderRouteFacts) -> ProviderUseRefusal {
  fold(
    first_unresolved_obligation(c: facts.data_paths),
    init: ProviderRouteFactsIncomplete { route: facts.route, obligation: facts.provider },
    f: fn(acc, o) { ProviderRouteFactsIncomplete { route: facts.route, obligation: o } },
  )
}

fn downstream_unassessed_refusal(facts: ProviderRouteFacts) -> ProviderUseRefusal {
  fold(
    downstream_obligation(d: facts.downstream),
    init: DownstreamProviderUnassessed { obligation: facts.provider },
    f: fn(acc, o) { DownstreamProviderUnassessed { obligation: o } },
  )
}

fn disposition_refusal(
  d: DispositionStanding,
  fallback: DeclarationRef,
  program: DispositionProgram,
) -> ProviderUseRefusal {
  fold(
    disposition_obligation(d: d),
    init: disposition_program_refusal(p: program, obligation: fallback),
    f: fn(acc, o) { disposition_program_refusal(p: program, obligation: o) },
  )
}

// THE DECISION. The order of the conjuncts is the order of the remedies: classify the route,
// assess its downstream, gather its facts, match the customer scope, match the data class, clear
// the three use dispositions, reconcile posture, bind the agreement. Reporting the first failure
// rather than all of them is deliberate - a caller acts on one obligation at a time, and a
// refusal listing five causes invites picking the cheapest.
//
// THE POSTURE AND AGREEMENT CHECKS ARE GUARDS, NOT A FOLD. They were briefly a fold over the
// matched sanctions seeded with a self-contradicting PostureRevisionStale whose evaluated and
// active hashes were the same value. The fold was never needed: the permit reads no field of the
// matched sanction, so selecting one was pure control flow. As guards there is no seed to
// fabricate.
fn admit_provider_use<P>(
  roster: List<RouteScopeSanction>,
  facts: ProviderRouteFacts,
  active: CompliancePostureRevision,
  scope: ProviderUseScope<P>,
  offer: FabricIdentity<P, OfferKey>,
  decision_receipt: DeclarationRef,
) -> ProviderUseAdmission<P> {
  let by_customer = sanctions_for_route_and_customer(roster: roster, route: facts.route, scope: scope)
  let matched = sanctions_for_route(roster: roster, route: facts.route, scope: scope)
  let current = filter(matched, s => posture_is_current(evaluated: s.posture, active: active))
  let bound = filter(current, s => declaration_ref_eq(a: s.requires_agreement, b: scope.agreement))
  if !route_is_classified(roster: roster, route: facts.route) {
    deny(reason: "route unclassified", cause: ProviderRouteUnclassified { route: facts.route })
  } else if !downstream_is_assessed(d: facts.downstream) {
    deny(reason: "downstream unassessed", cause: downstream_unassessed_refusal(facts: facts))
  } else if !data_path_closure_is_complete(c: facts.data_paths) {
    deny(reason: "route facts incomplete", cause: path_incomplete_refusal(facts: facts))
  } else if count(by_customer) == 0 {
    deny(reason: "customer scope unsupported",
         cause: CustomerScopeUnsupported { cause: scope.customer_profile })
  } else if count(matched) == 0 {
    deny(reason: "data handling unsupported",
         cause: DataHandlingUnsupported { cause: scope.data_handling_profile })
  } else if !disposition_is_cleared(d: scope.prohibited_use_disposition) {
    deny(reason: "prohibited use not cleared",
         cause: disposition_refusal(d: scope.prohibited_use_disposition,
                                    fallback: scope.customer_profile, program: ProhibitedUseProgram))
  } else if !disposition_is_cleared(d: scope.sanctions_disposition) {
    deny(reason: "sanctions not cleared",
         cause: disposition_refusal(d: scope.sanctions_disposition,
                                    fallback: scope.customer_profile, program: SanctionsProgram))
  } else if !disposition_is_cleared(d: scope.export_disposition) {
    deny(reason: "export not cleared",
         cause: disposition_refusal(d: scope.export_disposition,
                                    fallback: scope.customer_profile, program: ExportProgram))
  } else if count(current) == 0 {
    deny(reason: "posture stale",
         cause: PostureRevisionStale {
           evaluated: stale_revisions(matched: matched, active: active),
           active: active.revision,
         })
  } else if count(bound) == 0 {
    deny(reason: "agreement absent",
         cause: RequiredAgreementAuthorityAbsent { accepted: accepted_agreements(sanctions: current) })
  } else {
    ProviderUseAdmitted {
      permit: ProviderUsePermit {
        demand: scope.demand,
        work: scope.work,
        offer: offer,
        route: facts.route,
        posture: active,
        evidence: ProviderUseEvidence {
          posture_revision: active.revision,
          route_facts_revision: facts.facts_revision,
          customer_profile: scope.customer_profile,
          agreement: scope.agreement,
          prohibited_use_evidence: disposition_evidence_or(
            d: scope.prohibited_use_disposition, fallback: scope.customer_profile),
          sanctions_evidence: disposition_evidence_or(
            d: scope.sanctions_disposition, fallback: scope.customer_profile),
          export_evidence: disposition_evidence_or(
            d: scope.export_disposition, fallback: scope.customer_profile),
          decision_receipt: decision_receipt,
        },
      },
    }
  }
}

fn admission_is_admitted<P>(a: ProviderUseAdmission<P>) -> Bool {
  match a {
    ProviderUseAdmitted { permit } => true,
    ProviderUseDenied { decision, cause } => false,
  }
}
