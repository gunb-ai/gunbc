module product.fabric.provider_admission

import std.types { Bool, List, String }
import std.decl_ref { DeclarationRef, declaration_ref_eq }
import std.content_hash { ContentHash }
import std.access { AccessDecision, access_policy_refusal }
import product.fabric.identity { FabricIdentity, DemandKey, WorkKey, OfferKey, fabric_identity_eq }
import product.fabric.provider_route {
  ProviderRoute, provider_route_eq, CompliancePostureRevision, ProviderRouteFacts,
  first_unresolved_obligation, downstream_obligation,
}

// THE MISSING NON-ECONOMIC GATE. The code in this tree that actually places work admits an offer
// on architecture, dedication, interruption and price - product.fabric.supply states the ordering
// and states why price is evaluated LAST, so that price can never rescue an offer that cannot run
// the work. That admission carries no term for whether we are authorised to send THIS work to
// THIS route at all, so no refusal for that question has a spelling in the deciding path: it is
// not merely unimplemented, it is unwritable, and an unwritable refusal is one that can never
// fire. This module supplies the relation the deciding path is missing: active posture revision x
// exact demand/work/customer/data scope x provider route -> provider-use admission.
//
// WHERE IT SITS IN THE ORDER, which is load-bearing and not a performance detail. Route
// resolution and posture admission run FIRST, then executor capacity sanction, then fungibility,
// then affordability, then cheapest. product.fabric.supply's own argument for price-last applies
// one step earlier and more strongly: a sufficiently cheap offer must never buy its way through a
// missing legal or data-handling authority. Compliance is not depleted by use, so it is not a
// budget, and it does not belong anywhere in a selection cost.
//
// WHO CONSUMES A PERMIT, AND AT WHICH RUNG (DESIGN section 3c, and section 4b(1) rung honesty).
// This replaced a declared frontier rather than outliving it: the frontier's trigger has fired, and
// a discharged declaration left standing is cited as a known gap while the gap is closed.
//
// SELECTION - STRUCTURAL. product.fabric.selection's CandidateOffer carries the permit and is
// sole_constructor, bind_candidate is its only constructor and refuses without an admitted permit,
// and selection ranks CandidateOffers. So "an unadmitted offer won the ranking" has no constructor:
// rung 4, not a check.
//
// ISSUANCE - CHECKED, AND SAID PLAINLY BECAUSE THE TWO ARE NOT THE SAME RUNG.
// product.fabric.grant_issue's issue_grant takes the permit as a PARAMETER and compares it against
// the offer, route, work and demand it was handed. That is validation, rung 2-to-3, and it is
// deliberate: taking a CandidateOffer there would satisfy a residual capability that module has
// declared open, which section 4b(3) names as the way a trigger gets retired while the capability
// stays dead. Reporting this module's class as structural on the strength of the selection path
// alone would be rung inflation, since a class's rung is the MINIMUM across its in-scope paths.
//
// CONSUMED ON THE GRANT. ExecutionGrant carries the permit as its own field, so an auditor
// reading a grant alone can re-derive the admitting posture revision, the route-facts revision and
// the route without consulting the candidate that produced it. product.fabric.execution names
// the three projections. Issuance still takes the permit as a parameter rather than a
// CandidateOffer: residual capability ONE in grant_issue remains open.

// STATED DIVERGENCE FROM std.scoped_authorization (DESIGN section 3b). That module already models
// a permit-shaped answer - AuthorizationDecision<Subject> is Permitted { grant } | Refused { cause }
// over a located AuthorizationRefusalCause, which is the same SHAPE as the admission below - and it
// is Subject-parametric precisely so a domain can bring its own payload. This module does not
// inhabit it, and the reason is that its enforcing authority is AuthorizationScope: verb x
// namespace position x named action, decided by an OPERATOR CLICKING on one escalation, bounded by
// expires_at, and single-use through AuthorizationClaimState. A route sanction has none of those
// facts. There is no escalation and no operator in the loop; it does not expire on a clock, it goes
// STALE against a posture revision, which is a different relation with a different remedy; and it is
// not depleted by use, so the claim lifecycle that module exists to make race-free has no subject
// here. Forcing a route sanction into an AuthorizationScope would put a jurisdiction into a
// namespace position and a posture revision into an expiry, which is nicknaming twice over. The
// shared part is the allow/deny authority, and that IS reused rather than re-coined:
// std.access.AccessDecision, through access_policy_refusal below. If a posture ever acquires an
// operator-approval step, that step is a ScopedAuthorization over this permit as its Subject, not a
// second set of arms grown here.

// A DISPOSITION IS A STANDING, NOT A POINTER. These were once bare DeclarationRef fields on the
// use scope, which meant the sanctions, export and prohibited-use programs could hand this
// decision anything at all and it would neither read it nor record it - dangling inputs on the
// subject of the decision (DESIGN section 3c), and worse, an unresolved sanctions case would have
// been indistinguishable from a cleared one. A standing has to say which it is.
// THE FOURTH ARM IS "THE PROGRAM HAS NO SUBJECT HERE", AND IT IS A DIFFERENT CLAIM FROM CLEARED.
// The distinction is the one product.fabric.provider_route already draws one type over, in the same
// vocabulary and for the same reason: ProviderPathAbsent (a fact that can support an admission) is
// kept apart from ProviderPathUnread (an obligation that must refuse), because collapsing them is
// how an unexamined path reads as a clean one. Cleared and NotEngaged are the two ADMITTING
// standings and they are equally not each other -- Cleared says a program ran and resolved in our
// favour, NotEngaged says the program has no subject on this route at all, which is the honest
// standing for a route with no counterparty, no transfer and no recipient.
//
// WITHOUT THIS ARM THE ONLY WAY TO ADMIT SUCH A ROUTE WAS TO WRITE A CLEARANCE NOBODY ISSUED, which
// is the fabricated legal finding this gate exists to close, arriving through the gate itself. It
// was written that way once, in gunbc.spark.first_party_serving, with the honesty carried in prose
// fields nothing matches on -- and prose cannot discharge a machine claim (DESIGN 4c), which is
// exactly review 63981's finding. With the arm, a not-engaged standing is expressible AS ITSELF, a
// future real clearance is distinguishable from it BY MATCHING rather than by reading a string, and
// a permit records which of the two admitted it.
//
// WHAT THE ARM DOES NOT DO. It does not establish that a program genuinely has no subject; that
// stays a boundary obligation on whoever writes the basis, exactly as the honesty of a clearance
// stays with whoever issued it. What it buys is that the two claims stop being one value.
type DispositionStanding
  = DispositionCleared { evidence: DeclarationRef }
  | DispositionNotEngaged { basis: DeclarationRef }
  | DispositionRefused { cause: DeclarationRef }
  | DispositionUnresolved { obligation: DeclarationRef }

// ONE MATCH, ZERO-OR-ONE OUT. There is deliberately no disposition_is_cleared returning Bool. A
// Bool predicate discards precisely the payload the refusal then needs, forcing the refusal
// builder to walk the same value a SECOND time - and it is that second walk which forces a seed
// to exist, which is where a fabricated obligation gets to live. Matching once dissolves the seed
// rather than improving it.
fn disposition_obligation(d: DispositionStanding) -> List<DeclarationRef> {
  match d {
    DispositionCleared { evidence } => [],
    DispositionNotEngaged { basis } => [],
    DispositionRefused { cause } => [cause],
    DispositionUnresolved { obligation } => [obligation],
  }
}

// disposition_evidence IS GONE, AND ITS DISSOLUTION IS THE CLIMB RATHER THAN A DELETION (DESIGN
// 4b(4)). It projected a zero-or-one DeclarationRef out of the standing so the permit could record
// "what the gate saw" without a fabricable seed, and the list shape was the right answer to that
// question. The question stops existing once the permit records the STANDING ITSELF: a reference
// alone cannot say which arm admitted the route, so two materially different admissions -- a
// clearance and a not-engaged -- reached ProviderUseEvidence as the same shape and an auditor
// reading a permit could not tell them apart. Carrying the standing is one value, not two
// representations of one, and it cannot lose the arm on the way.

// OUR ROSTER, NOT THE SUPPLIER'S. gunbc.fabric_executor_class already establishes the shape: we
// keep the sanction, an unclassified executor refuses, and the sanction is evaluated before
// fungibility. A supplier does not get to declare what it is sanctioned to serve, and a provider
// module that imported this one would be that inversion.
//
// The sanction is per posture revision by construction: a row admits a scope on a route UNDER a
// stated posture, so re-posturing does not silently re-admit anything.
type RouteScopeSanction {
  route: ProviderRoute
  posture: CompliancePostureRevision
  customer_profile: DeclarationRef
  data_handling_profile: DeclarationRef
  requires_agreement: DeclarationRef
}

// THE USE SCOPE. Admission is never a property of a route alone - the same route is admissible
// for ordinary build source and refused for regulated data - so the subject of a decision is
// always a route AND a use. The work stays provider-neutral; the demand side supplies the
// organisation and agreement facts; the dispositions are the already-resolved outputs of the
// sanctions, export and prohibited-use programs, and each must be CLEARED for a permit to mint.
type ProviderUseScope<P> {
  demand: FabricIdentity<P, DemandKey>
  work: FabricIdentity<P, WorkKey>
  customer_profile: DeclarationRef
  data_handling_profile: DeclarationRef
  agreement: DeclarationRef
  prohibited_use_disposition: DispositionStanding
  sanctions_disposition: DispositionStanding
  export_disposition: DispositionStanding
}

// CapacityClass is deliberately NOT a field here, which is a stated divergence from the
// directive's sketch rather than an oversight. Capacity sanction and provider-use admission are
// two non-economic gates that refuse for different reasons and produce different remediation: one
// is answered by classifying an executor, the other by gathering route facts or changing posture.
// Folding them into one scope would give the partition a single refused population and lose which
// of the two a caller must go fix.

// Every revision and standing the decision actually read, recorded on the permit. This is what
// makes a permit re-derivable rather than merely historical. The three dispositions are here
// because a permit that gated on them and did not record them would be unauditable - the gate would
// have run and left no trace of what it saw - and they are the STANDINGS rather than projections of
// them, so a permit says whether each program was cleared or had no subject. Only the two admitting
// arms are reachable here: a refused or unresolved standing cannot pass the gate above, and this
// type does not restate that, because restating it would be a second representation of the gate.
type ProviderUseEvidence {
  posture_revision: ContentHash
  route_facts_revision: ContentHash
  customer_profile: DeclarationRef
  agreement: DeclarationRef
  prohibited_use_standing: DispositionStanding
  sanctions_standing: DispositionStanding
  export_standing: DispositionStanding
  decision_receipt: DeclarationRef
}

// SEALED. sole_constructor confines minting to admit_provider_use below, so a permit cannot be
// authored beside the decision that is supposed to produce it. DESIGN section 4b's ceiling applies
// unchanged: this establishes WHO may construct one and nothing about whether the route facts were
// honestly observed, which stays a boundary obligation on whoever produced them.
type ProviderUsePermit<P> sole_constructor {
  demand: FabricIdentity<P, DemandKey>
  work: FabricIdentity<P, WorkKey>
  offer: FabricIdentity<P, OfferKey>
  route: ProviderRoute
  posture: CompliancePostureRevision
  evidence: ProviderUseEvidence
}

// EVERY REFUSAL IS CONSTRUCTIBLE, NAMES ITS OWN REMEDY, AND HAS A PRODUCER. Each arm below is a
// different thing to go and do, and each is built by exactly one producer that reached it by
// matching the coproduct that caused it.
//
// TWO ARMS WERE DELETED RATHER THAN LEFT UNINHABITABLE. TransferOrLocationUnresolved and
// ProviderAccessPathUnsupported both require comparing a LOCATED path's jurisdiction against the
// jurisdictions a posture permits, and the posture revision carried here is an authority plus a
// hash with no jurisdiction population to compare against. An arm no producer can inhabit is
// decoration that will later be cited as coverage (DESIGN section 4b). RESTORATION TRIGGER: a
// posture revision that carries its permitted-jurisdiction population, at which point a located
// path in a non-permitted jurisdiction becomes authorable and both arms land with their reds.
type ProviderUseRefusal
  = ProviderRouteUnclassified { route: ProviderRoute }
  | ProviderRouteFactsIncomplete { route: ProviderRoute, obligation: DeclarationRef }
  | DownstreamProviderUnassessed { obligation: DeclarationRef }
  | PostureRevisionStale { evaluated: List<ContentHash>, active: ContentHash }
  | CustomerScopeUnsupported { cause: DeclarationRef }
  | DataHandlingUnsupported { cause: DeclarationRef }
  | RequiredAgreementAuthorityAbsent { accepted: List<DeclarationRef> }
  | ProhibitedUseNotCleared { obligation: DeclarationRef }
  | SanctionsNotCleared { obligation: DeclarationRef }
  | ExportNotCleared { obligation: DeclarationRef }

// std.access.AccessDecision stays the allow/deny authority. This coproduct transports the sealed
// positive permit and the typed domain cause; it deliberately does NOT make a second, independent
// policy decision, because two policy authorities for one question is the fork this whole module
// exists to close.
type ProviderUseAdmission<P>
  = ProviderUseAdmitted { permit: ProviderUsePermit<P> }
  | ProviderUseDenied { decision: AccessDecision, cause: ProviderUseRefusal }

// There is deliberately no UnknownButProceed arm and no default route. An unresolved input
// refuses; it never widens.

// The reason string is derived from the cause by an exhaustive match, so a new refusal arm cannot
// be added without saying what it means to a reader. It is not a second discriminator: the typed
// cause travels beside it and is what any consumer matches on.
fn refusal_reason(c: ProviderUseRefusal) -> String {
  match c {
    ProviderRouteUnclassified { route } => "route unclassified",
    ProviderRouteFactsIncomplete { route, obligation } => "route facts incomplete",
    DownstreamProviderUnassessed { obligation } => "downstream unassessed",
    PostureRevisionStale { evaluated, active } => "posture stale",
    CustomerScopeUnsupported { cause } => "customer scope unsupported",
    DataHandlingUnsupported { cause } => "data handling unsupported",
    RequiredAgreementAuthorityAbsent { accepted } => "agreement absent",
    ProhibitedUseNotCleared { obligation } => "prohibited use not cleared",
    SanctionsNotCleared { obligation } => "sanctions not cleared",
    ExportNotCleared { obligation } => "export not cleared",
  }
}

// access_policy_refusal already returns a Deny-shaped AccessDecision, so this names the location
// once rather than letting each call site invent a profile/subject/action/object tuple.
fn provider_use_denial(reason: String) -> AccessDecision {
  access_policy_refusal(
    profile: "provider-use",
    subject: "provider-route",
    action: "execute",
    object: "customer-work",
    reason: reason,
  )
}

fn deny<P>(cause: ProviderUseRefusal) -> ProviderUseAdmission<P> {
  ProviderUseDenied { decision: provider_use_denial(reason: refusal_reason(c: cause)), cause: cause }
}

// THE ROUTE-AND-CUSTOMER MATCH IS SEPARATE FROM THE FULL MATCH, and that separation is the whole
// point. An empty full-match set has two materially different causes - this customer profile is
// not sanctioned on this route at all, or it is but THIS DATA CLASS is not - and they are
// different things to go and do. Reporting both as CustomerScopeUnsupported names the wrong
// remedy, which under DESIGN section 5 is a fabricated diagnosis rather than a located one.
fn sanctions_for_route_and_customer<P>(
  roster: List<RouteScopeSanction>,
  route: ProviderRoute,
  scope: ProviderUseScope<P>,
) -> List<RouteScopeSanction> {
  filter(roster, s =>
    provider_route_eq(a: s.route, b: route)
      && declaration_ref_eq(a: s.customer_profile, b: scope.customer_profile))
}

fn sanctions_for_route<P>(
  roster: List<RouteScopeSanction>,
  route: ProviderRoute,
  scope: ProviderUseScope<P>,
) -> List<RouteScopeSanction> {
  filter(
    sanctions_for_route_and_customer(roster: roster, route: route, scope: scope),
    s => declaration_ref_eq(a: s.data_handling_profile, b: scope.data_handling_profile),
  )
}

fn route_is_classified(roster: List<RouteScopeSanction>, route: ProviderRoute) -> Bool {
  count(filter(roster, s => provider_route_eq(a: s.route, b: route))) > 0
}

// Posture staleness compares two revisions minted by our own posture pipeline, so they are the
// same hash family by construction. Cross-family ContentHash comparison is separately governed by
// std.content_hash - refused at R0 today, a typecheck refusal after its Phase B - and this call
// site never straddles families because both operands come from the same producer.
fn posture_is_current(evaluated: CompliancePostureRevision, active: CompliancePostureRevision) -> Bool {
  evaluated.revision == active.revision
}

// EVERY stale revision found, not one extracted through a fold that needed a seed. A list has no
// seed to fabricate: empty reads as "none recorded" rather than as a false equality between a
// revision and itself.
fn stale_revisions(
  matched: List<RouteScopeSanction>,
  active: CompliancePostureRevision,
) -> List<ContentHash> {
  map(
    filter(matched, s => !posture_is_current(evaluated: s.posture, active: active)),
    s => s.posture.revision,
  )
}

// The agreements that WOULD have bound, for the same reason stale_revisions is a list: reporting
// every accepted agreement needs no fabricated seed, and it tells the caller which agreement to
// present rather than merely that the one they brought was wrong.
fn accepted_agreements(sanctions: List<RouteScopeSanction>) -> List<DeclarationRef> {
  map(sanctions, s => s.requires_agreement)
}

// THE PROGRAM IS A CLOSED COPRODUCT, NOT A STRING. This dispatch was briefly a stringly-typed
// discriminator - if which == "prohibited-use" ... else if "sanctions" ... else Export - which is
// an undeclared sum whose illegal values are representable, and which FAILED OPEN in exactly the
// way this module condemns elsewhere: a typo or a future fourth program silently routed to
// ExportNotCleared, a refusal with the wrong cause and the wrong remedy. As a coproduct the match
// is exhaustive, so a fourth program fails to compile rather than quietly becoming an export
// refusal.
type DispositionProgram
  = ProhibitedUseProgram
  | SanctionsProgram
  | ExportProgram

fn disposition_program_refusal(p: DispositionProgram, obligation: DeclarationRef) -> ProviderUseRefusal {
  match p {
    ProhibitedUseProgram => ProhibitedUseNotCleared { obligation: obligation },
    SanctionsProgram => SanctionsNotCleared { obligation: obligation },
    ExportProgram => ExportNotCleared { obligation: obligation },
  }
}

// THE REFUSAL BUILDERS. Each is a map over a zero-or-one obligation list produced by ONE match of
// the coproduct that caused the refusal, so there is no seed anywhere and no arm carries a value
// that had to be invented to fill a slot. An empty result means the condition does not hold; a
// one-element result IS the refusal, carrying the obligation its own arm named.
fn path_refusals(facts: ProviderRouteFacts) -> List<ProviderUseRefusal> {
  map(
    first_unresolved_obligation(c: facts.data_paths),
    o => ProviderRouteFactsIncomplete { route: facts.route, obligation: o },
  )
}

fn downstream_refusals(facts: ProviderRouteFacts) -> List<ProviderUseRefusal> {
  map(downstream_obligation(d: facts.downstream), o => DownstreamProviderUnassessed { obligation: o })
}

fn program_refusals(d: DispositionStanding, program: DispositionProgram) -> List<ProviderUseRefusal> {
  map(disposition_obligation(d: d), o => disposition_program_refusal(p: program, obligation: o))
}

fn unclassified_refusals(
  roster: List<RouteScopeSanction>,
  facts: ProviderRouteFacts,
) -> List<ProviderUseRefusal> {
  if route_is_classified(roster: roster, route: facts.route) {
    []
  } else {
    [ProviderRouteUnclassified { route: facts.route }]
  }
}

// The scope refusals carry the profile that was not supported as the CAUSE, which is not a
// fabricated payload standing in for a missing one: the unsupported profile is exactly what the
// caller must go and change or get sanctioned.
fn scope_refusals<P>(
  by_customer: List<RouteScopeSanction>,
  matched: List<RouteScopeSanction>,
  scope: ProviderUseScope<P>,
) -> List<ProviderUseRefusal> {
  if count(by_customer) == 0 {
    [CustomerScopeUnsupported { cause: scope.customer_profile }]
  } else if count(matched) == 0 {
    [DataHandlingUnsupported { cause: scope.data_handling_profile }]
  } else {
    []
  }
}

fn posture_refusals(
  matched: List<RouteScopeSanction>,
  current: List<RouteScopeSanction>,
  active: CompliancePostureRevision,
) -> List<ProviderUseRefusal> {
  if count(matched) > 0 && count(current) == 0 {
    [PostureRevisionStale {
      evaluated: stale_revisions(matched: matched, active: active),
      active: active.revision,
    }]
  } else {
    []
  }
}

fn agreement_refusals(
  current: List<RouteScopeSanction>,
  bound: List<RouteScopeSanction>,
) -> List<ProviderUseRefusal> {
  if count(current) > 0 && count(bound) == 0 {
    [RequiredAgreementAuthorityAbsent { accepted: accepted_agreements(sanctions: current) }]
  } else {
    []
  }
}

// THE DECISION, AND THE REASON ITS SEED IS THE PERMIT. The order of the concatenation is the order
// of the remedies: classify the route, assess its downstream, gather its facts, match the customer
// scope, match the data class, clear the three use dispositions, reconcile posture, bind the
// agreement. Reporting the FIRST refusal rather than all of them is deliberate - a caller acts on
// one obligation at a time, and a refusal listing five causes invites picking the cheapest.
//
// This was an if/else chain whose refusal builders folded zero-or-one lists seeded with an
// unreachable, fabricated cause: a route-facts obligation seeded with the provider row, a
// disposition obligation seeded with the customer profile. Those seeds were held unreachable only
// by call-order coupling to the guard immediately above them, which is validation standing where
// construction was available - move a guard and the lie becomes the answer. Folding a refusal LIST
// with the admitted permit as the init inverts it: the seed is now the honest answer to "what if
// nothing refused", it is reachable, and every non-seed value is built by a producer that matched
// the coproduct causing it. There is nowhere left to invent an obligation.
fn admit_provider_use<P>(
  roster: List<RouteScopeSanction>,
  facts: ProviderRouteFacts,
  active: CompliancePostureRevision,
  scope: ProviderUseScope<P>,
  offer: FabricIdentity<P, OfferKey>,
  decision_receipt: DeclarationRef,
) -> ProviderUseAdmission<P> {
  let by_customer = sanctions_for_route_and_customer(roster: roster, route: facts.route, scope: scope)
  let matched = sanctions_for_route(roster: roster, route: facts.route, scope: scope)
  let current = filter(matched, s => posture_is_current(evaluated: s.posture, active: active))
  let bound = filter(current, s => declaration_ref_eq(a: s.requires_agreement, b: scope.agreement))
  let refusals = concat(
    unclassified_refusals(roster: roster, facts: facts),
    concat(
      downstream_refusals(facts: facts),
      concat(
        path_refusals(facts: facts),
        concat(
          scope_refusals(by_customer: by_customer, matched: matched, scope: scope),
          concat(
            program_refusals(d: scope.prohibited_use_disposition, program: ProhibitedUseProgram),
            concat(
              program_refusals(d: scope.sanctions_disposition, program: SanctionsProgram),
              concat(
                program_refusals(d: scope.export_disposition, program: ExportProgram),
                concat(
                  posture_refusals(matched: matched, current: current, active: active),
                  agreement_refusals(current: current, bound: bound),
                ),
              ),
            ),
          ),
        ),
      ),
    ),
  )
  fold(
    refusals,
    init: ProviderUseAdmitted {
      permit: ProviderUsePermit {
        demand: scope.demand,
        work: scope.work,
        offer: offer,
        route: facts.route,
        posture: active,
        evidence: ProviderUseEvidence {
          posture_revision: active.revision,
          route_facts_revision: facts.facts_revision,
          customer_profile: scope.customer_profile,
          agreement: scope.agreement,
          prohibited_use_standing: scope.prohibited_use_disposition,
          sanctions_standing: scope.sanctions_disposition,
          export_standing: scope.export_disposition,
          decision_receipt: decision_receipt,
        },
      },
    },
    f: fn(acc, c) {
      match acc {
        ProviderUseAdmitted { permit } => deny(cause: c),
        ProviderUseDenied { decision, cause } => acc,
      }
    },
  )
}


// ONE AUTHORITY FOR "DOES THIS PERMIT AUTHORISE THIS USE", AND IT EXISTS BECAUSE THE SECOND COPY
// ALREADY DIVERGED. The judgement was written out twice - once in product.fabric.selection's
// bind_candidate and once in product.fabric.grant_issue's issue_grant - and the two copies did not
// agree: issuance compared all four of offer, route, work and demand, while binding compared only
// offer and route. That gap was not hypothetical. The production broker in gunbc.fabric
// .fabric_control_plane selects and reserves without ever issuing a grant, so the only copy on the
// path that actually places work was the SHORT one, and a permit admitted for work A could seal a
// candidate that was then ranked and reserved for work B.
//
// So this is DESIGN section 3 arriving exactly as it says it will: a fork gets consolidated later,
// which makes it a correctness concern rather than a style one. Adding the missing two comparisons
// to the second copy would have restored agreement for exactly as long as nobody edited either
// one, and would have made the third consumer - the broker - a third place to disagree. The
// judgement is therefore ONE function here, in the module that declares ProviderUsePermit and
// therefore owns what a permit means, and every site consumes it and maps the outcome into its own
// refusal vocabulary.
//
// It takes the offer's identity and route rather than a SupplierOffer so that this module keeps
// its current import surface: the two fields are the only ones the judgement reads, and importing
// the offer carrier to read two fields would couple the permit's authority to the supply model.
type PermitStanding<P>
  = PermitAuthorizesUse
  | PermitNamesAnotherOfferThan { permit_names: FabricIdentity<P, OfferKey> }
  | PermitNamesAnotherRouteThan
  | PermitNamesAnotherWorkThan {
      permit_work: FabricIdentity<P, WorkKey>,
      subject_work: FabricIdentity<P, WorkKey>,
    }
  | PermitNamesAnotherDemandThan {
      permit_demand: FabricIdentity<P, DemandKey>,
      subject_demand: FabricIdentity<P, DemandKey>,
    }

// The order is offer, route, work, demand and it is fixed, so two consumers asking the same
// question about the same permit cannot report different first causes.
fn permit_standing<P>(
  permit: ProviderUsePermit<P>,
  offer: FabricIdentity<P, OfferKey>,
  route: ProviderRoute,
  demand: FabricIdentity<P, DemandKey>,
  work: FabricIdentity<P, WorkKey>,
) -> PermitStanding<P> {
  if !fabric_identity_eq(left: offer, right: permit.offer) {
    PermitNamesAnotherOfferThan { permit_names: permit.offer }
  } else if !provider_route_eq(a: route, b: permit.route) {
    PermitNamesAnotherRouteThan
  } else if !fabric_identity_eq(left: work, right: permit.work) {
    PermitNamesAnotherWorkThan { permit_work: permit.work, subject_work: work }
  } else if !fabric_identity_eq(left: demand, right: permit.demand) {
    PermitNamesAnotherDemandThan { permit_demand: permit.demand, subject_demand: demand }
  } else {
    PermitAuthorizesUse
  }
}
