module product.fabric.job_admission

import std.types { List }
import std.roster_frontier { FrontierRow, frontier_row_decl }
import std.decl_ref { decl_ref }
import std.dissolution { unbound_dissolution }
import v2.std.optional { Present, Absent }
import product.fabric.identity { FabricIdentity, WorkKey, fabric_identity_eq }

// Customer declaration admission precedes provider-route selection. This is a
// stated divergence from product.fabric.provider_admission: its ProviderUseScope
// and data_handling_profile establish permission for a chosen route under a
// posture revision, with agreement and program dispositions. This fold has no
// route or posture and establishes only whether a declaration can advance to
// that gate. Its receipt is not a ProviderUsePermit and cannot replace one.
// Unresolved customer classification HOLDS before a route is selected; provider
// disposition uncertainty retains provider_admission's own refusal semantics.
// These are declarations at the customer boundary, not a compliance regime.
// No producer currently supplies authority to handle declared ePHI. A declaration
// of ordinary data is not evidence of a broader handling authority.
type JobClassification
  = DeclaredNonEphi
  | DeclaredEphi
  | ClassificationUnresolved

type JobAdmissionRefusal
  = EphiHandlingAuthorityHasNoProducer
  | ClassificationReceiptMissing
  | ClassificationReceiptSubjectMismatch

type JobClassificationReceipt<P> sole_constructor {
  subject: FabricIdentity<P, WorkKey>
  issuer_frontier: FrontierRow
}

// Explicitly deferred by cool-crane-190 for the pre-regime admission spine.
// Carried by each receipt so its missing authority cannot disappear in transport.
data classification_receipt_issuer_frontier: FrontierRow = frontier_row_decl(
  ref: decl_ref(module_path: "product.fabric.job_admission", decl_name: "JobClassificationReceipt"),
  reason: "This self-issued receipt establishes that classification was performed, not that an authenticated principal authorized admission. An independently authorized issuer is owed.",
  dissolution: unbound_dissolution(description: "An issuer authority binds admission evidence to an authenticated customer principal and refuses self-issued evidence on the deployed admission path. A declared issuer type alone does not discharge this frontier."),
)

data job_admission_billing_frontier: FrontierRow = frontier_row_decl(
  ref: decl_ref(module_path: "test.claim.job_admission_witness", decl_name: "submit_invoice_fixture"),
  reason: "The zero-net invoice join is exercised by a fixture; the real billing receipt is not yet its consumer.",
  dissolution: unbound_dissolution(description: "billing-receipts joins metered usage times founding price, promotional credit, and net due to the admission result for the same work identity, and executes controls proving a zero-net invoice preserves admission, hold, and refusal. A fixture or declared invoice type alone is insufficient."),
)

data job_admission_runner_frontier: FrontierRow = frontier_row_decl(
  ref: decl_ref(module_path: "product.fabric.job_admission", decl_name: "admit_job"),
  reason: "Pure witnesses execute this fold; they do not establish enforcement on the deployed runner launch path.",
  dissolution: unbound_dissolution(description: "The deployed runner calls admit_job before launch and only launches its admitted arm, with executed controls proving held and refused jobs cannot launch. The separate authenticated-issuer obligation must also be discharged before treating this result as authenticated admission authorization."),
)

// Known-red admission is temporary feature-gap quarantine, not permanent
// mutation evidence (gunbc.explicit_witness_admission.known_red_class_note).
// floor_expected_red likewise requires a row to be under repair. Neither is
// authority to quarantine an intentionally broken admission fixture forever.
data job_admission_mutation_harness_frontier: FrontierRow = frontier_row_decl(
  ref: decl_ref(module_path: "test.claim.job_admission_witness", decl_name: "zero_dollar_net_invoice_cannot_admit_a_job_with_another_jobs_receipt"),
  reason: "The invoice bypass is authorable as fixture source, but its mutation proof has no permanent expected-red consumer. Temporary known-red quarantine is for feature gaps that must become green; it cannot enroll this deliberately broken fixture as permanent evidence. The ordinary invoice witnesses do not establish that the mutation is executed.",
  dissolution: unbound_dissolution(description: "A scheduled permanent source-mutation consumer runs the unchanged invoice controls against submit_invoice_fixture with the net_due == money_amount_micro(count: 0) arm calling classify_job directly and the paid arm retaining admit_job. It requires the zero-dollar other-job-receipt control to fail by assertion and paid_invoice_does_not_supply_an_admission_receipt to pass in the same mutated run, refuses unexpected green or a pre-verdict failure, and runs the original controls on restored source. The mutation and both expectations remain enrolled after this frontier dissolves; a one-off run, copied receipt, temporary known-red row, or declared harness alone does not close it."),
)

data job_admission_frontier_rows: List<FrontierRow> = [
  classification_receipt_issuer_frontier,
  job_admission_billing_frontier,
  job_admission_runner_frontier,
  job_admission_mutation_harness_frontier,
]

type JobAdmission<P>
  = JobAdmitted { receipt: JobClassificationReceipt<P> }
  | JobHeld { subject: FabricIdentity<P, WorkKey> }
  | JobRefused { subject: FabricIdentity<P, WorkKey>, reason: JobAdmissionRefusal }

// The producer and the execution boundary share the classification fold. Hold
// remains distinguishable even if the caller has no receipt yet.
fn classify_job<P>(subject: FabricIdentity<P, WorkKey>, classification: JobClassification) -> JobAdmission<P> {
  match classification {
    DeclaredNonEphi => JobAdmitted { receipt: JobClassificationReceipt { subject: subject, issuer_frontier: classification_receipt_issuer_frontier } }
    DeclaredEphi => JobRefused { subject: subject, reason: EphiHandlingAuthorityHasNoProducer }
    ClassificationUnresolved => JobHeld { subject: subject }
  }
}

// An invoice is not an input to admission. This boundary rechecks the current
// declaration: a previously admitted subject does not authorize changed handling.
// sole_constructor confines receipt literals to this file. It does not establish
// caller identity or truth of a customer's declaration: classify_job is a public
// decision producer. This receipt records that decision, not authenticated consent.
// The issuer capability owed is carried in classification_receipt_issuer_frontier.
fn admit_job<P>(subject: FabricIdentity<P, WorkKey>, classification: JobClassification, receipt: JobClassificationReceipt<P>?) -> JobAdmission<P> {
  match classify_job(subject: subject, classification: classification) {
    JobHeld { subject: s } => JobHeld { subject: s }
    JobRefused { subject: s, reason: r } => JobRefused { subject: s, reason: r }
    JobAdmitted { receipt: _ } => match receipt {
      Absent => JobRefused { subject: subject, reason: ClassificationReceiptMissing }
      Present { value: r } => if fabric_identity_eq(left: subject, right: r.subject) {
        JobAdmitted { receipt: r }
      } else {
        JobRefused { subject: subject, reason: ClassificationReceiptSubjectMismatch }
      }
    }
  }
}
