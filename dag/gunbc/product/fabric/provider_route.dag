module product.fabric.provider_route

import std.types { List, Timestamp }
import std.decl_ref { DeclarationRef, declaration_ref_eq }
import std.content_hash { ContentHash }

// THE ADMITTED SUBJECT IS A ROUTE, NEVER A COMPANY. "Provider X is compliant" is not a fact
// this substrate can hold, because the same provider is admissible in one region and not
// another, for ordinary build source and not for regulated data, under one contract revision
// and not the next, and before a downstream-provider change but not after it. So the identity
// that carries an admission is provider x service x region x data-path closure x contract
// revision, and a price row naming only a company can never stand in for it.
//
// THE ROUTE IS A PRODUCT OF CITED DECLARATIONS, NOT A BRANDED STRING, and that is a correction
// the corpus had already ruled rather than a preference. gunbc.fabric_capacity_class_gap's
// capacity_class_refused_remedies rules out ClassEncodedInTrustDomain on the grounds that a
// branded NonEmptyStr "is a magic string agreed between producer and consumer - convention where
// necessity was available, and it reads as coverage while enforcing nothing". A branded
// ProviderRouteRef is that shape exactly: the adapter that mints one and the sanction roster that
// matches one agree by spelling, so a route that names a different real region than the offer runs
// in matches a sanction it should not, and nothing in the type can see it.
//
// Citing declarations instead reduces the convention to something the namespace authority already
// checks (DESIGN section 3: cite the symbol, and a stale name is decidable). Regions are ALREADY
// modeled this way - extdeps.cloud.hetzner carries HetznerCloudRegion as a closed coproduct - and
// DESIGN's external-upstream rule is why this type must not enumerate them itself: a generic hub
// "may not enumerate concrete products", so adding a provider must never widen a type every
// unrelated consumer recompiles against. A reference is the only shape that satisfies both.
//
// WHAT THIS STILL DOES NOT ESTABLISH, stated so the type is not read as more than it is. That the
// cited region is where the work ACTUALLY runs remains a fact about someone else's machine -
// DESIGN section 4b's outside-the-modeled-guarantee column, not a rung. It is observed at a
// declared boundary and carried with its evidence below; it is never fabricated here.
//
// AUTHORITY DIRECTION IS FIXED HERE AND IS THE REASON THIS MODULE EXISTS SEPARATELY. Provider
// modules under extdeps carry facts about the provider - its regions, its service terms, its
// published subprocessors, its data-handling representations. Whether we are presently willing
// and authorised to use those facts is a fact about US. An extdeps provider module that
// imported our posture would let the supplier declare what it is sanctioned to serve, which is
// exactly the inversion gunbc.fabric_executor_class refuses by keeping the executor sanction
// roster on our side and refusing an unclassified executor. This module holds only the
// provider-side route facts; the join against posture and use scope lives one layer up.
type ProviderRoute {
  provider: DeclarationRef
  service: DeclarationRef
  region: DeclarationRef
}

// Route identity is declaration-reference equality on all three components. There is no ordering
// and no prefix relation: a route is the same route or it is a different one, and a sanction for a
// sibling region inherits nothing.
fn provider_route_eq(a: ProviderRoute, b: ProviderRoute) -> Bool {
  declaration_ref_eq(a: a.provider, b: b.provider)
    && declaration_ref_eq(a: a.service, b: b.service)
    && declaration_ref_eq(a: a.region, b: b.region)
}

// The posture is a REVISION, never an ambient "current". A permit records the exact revision it
// was evaluated against, so a posture change makes standing permits STALE rather than silently
// tolerated - the difference between a decision that can be re-derived and one that merely
// happened to be true when nobody was looking.
//
// The authority is an open DeclarationRef because THE POSTURE PRODUCER IS NOT IN THIS TREE (see
// the frontier annotation on product.fabric.provider_admission). The generic fabric must not
// enumerate whose posture governs it any more than it enumerates jurisdictions.
type CompliancePostureRevision {
  authority: DeclarationRef
  revision: ContentHash
}

// ONE LOCATION IS NOT A DATA PATH. A Helsinki VM whose backups, telemetry or administrators sit
// elsewhere is not a Helsinki-contained path, and a vendor region label establishes none of
// those. Each path answers for itself.
//
// THE ABSENT AND UNREAD ARMS ARE SEPARATE AND THAT SEPARATION IS THE WHOLE POINT. An empty
// backup destination must never ambiguously mean either "backups are disabled" or "nobody
// examined backups" - the first is a fact that can support an admission and the second is an
// obligation that must refuse. Collapsing them is how an unexamined path reads as a clean one,
// which is the same move product.supplier.ubicloud refuses by carrying IsolationNotObserved
// beside its catalog rows rather than inventing a guarantee from a price list.
//
// THE UNREAD ARM CITES WHAT WAS READ, OR IT CITES NOTHING. Located already carries evidence: as
// the document that ANSWERED. Unread is the dual: documents were consulted and did not answer,
// or nobody looked. Those two states refuse the same way -- the path is unresolved -- and they
// are not the same fact. A single obligation slot cannot record the negative reading, so the
// citation leaked into prose and a reviewer correctly treated the prose as not a consumer.
// consulted: is the same DeclarationRef vocabulary evidence: already uses (DESIGN section 3:
// no second citation name). The empty list is NEVER-LOOKED. A nonempty list is RESEARCHED AND
// UNANSWERED. The production consumer of the SLOT, once filled, is product.fabric.provider_admission
// path_refusals, which matches first_unread_standing once and records obligation and consulted
// from that standing on ProviderRouteFactsIncomplete so a live denial can tell the two
// remedies apart. Filling the slot without that fold reaching admit_provider_use would be the
// gunbc#11194 shape under another name.
//
// DECLARED FRONTIER (DESIGN section 3c). Nonempty consulted is constructible and is refused with
// a different remedy, but no production ProviderDataPathClosure in THIS tree inhabits it: the
// only production Unread constructors here are gunbc.spark.first_party_serving, which honestly
// pass []. The named consumer is product.supplier.hetzner's nine-path closures (gunbc#11188),
// which already researched the TOM and data-protection-overview pages and currently cannot record
// that because the unread arm had no slot. TRIGGER: gunbc#11188 lands AFTER this carrier, fills
// consulted on those unread paths with decl_ref to extdeps.cloud.hetzner
// hetzner_technical_organizational_measures_reading and
// hetzner_data_protection_overview_reading, and drops its duplicate copies of those two rows.
// Until that fires, researched-and-unanswered on a rented route is a later-change inhabitant,
// not a dangling one.
type ProviderPathStanding
  = ProviderPathLocated {
      operator: DeclarationRef,
      jurisdiction: DeclarationRef,
      evidence: DeclarationRef,
    }
  | ProviderPathAbsent { evidence: DeclarationRef }
  | ProviderPathUnread { obligation: DeclarationRef, consulted: List<DeclarationRef> }

// CLOSED OVER THE PATHS WE PRESENTLY KNOW WE MUST GOVERN, and closed deliberately: adding a
// material path forces EVERY route to answer for it rather than letting existing rows stay
// silently incomplete. Object storage, logs, telemetry, backups, support access and spill - not
// merely the runner VM - plus the control plane and administrative access that reach customer
// material without appearing in any customer-visible topology.
type ProviderDataPathClosure {
  execution: ProviderPathStanding
  durable_storage: ProviderPathStanding
  backups: ProviderPathStanding
  logs: ProviderPathStanding
  telemetry: ProviderPathStanding
  control_plane: ProviderPathStanding
  support_access: ProviderPathStanding
  administrative_access: ProviderPathStanding
  spill: ProviderPathStanding
}

// A provider's own downstream providers are part of our data path whether or not they appear in
// its price list. The three arms carry the same discipline the path standing does: an
// enumerated population with its coverage evidence, an explicit and evidenced none, or an
// unread obligation that refuses.
type DownstreamProviderPopulation
  = NoDownstreamProviders { evidence: DeclarationRef }
  | DownstreamProvidersEnumerated {
      first: DeclarationRef,
      further: List<DeclarationRef>,
      coverage: DeclarationRef,
    }
  | DownstreamProvidersUnread { obligation: DeclarationRef }

// provider and service are NOT repeated here: they are components of the route above, and carrying
// them twice would let a facts row describe one route while naming another.
//
// JURISDICTIONS ARE OPEN DECLARATION REFERENCES AND THERE IS DELIBERATELY NO CENTRAL ENUM.
// "Asia" is not a jurisdiction, a US-or-EU-or-other kernel is a nickname for N distinct legal
// systems, and adding Germany must be a row in a provider population rather than an edit to a
// generic type every unrelated consumer recompiles against. The generic fabric knows that a
// jurisdiction is cited; which jurisdictions exist is not its fact to hold.
type ProviderRouteFacts {
  route: ProviderRoute
  contract_terms: DeclarationRef
  data_paths: ProviderDataPathClosure
  downstream: DownstreamProviderPopulation
  observed_at: Timestamp
  facts_revision: ContentHash
}

// THE COPRODUCT IS MATCHED ONCE AND YIELDS THE UNREAD STANDING DIRECTLY. There is deliberately no
// Bool predicate here. A path_is_resolved returning Bool DISCARDS exactly the payload a refusal
// then needs, so the refusal builder has to walk the same value a second time - and it is that
// second walk which forces a seed to exist, which is where a fabricated obligation gets to live.
// Matching once removes the seed rather than improving it: an empty list is "no unread path",
// a one-element list IS that standing, and neither can lie.
//
// The nine paths are visited in a FIXED order, so the reported unread path is deterministic
// rather than whichever arm a fold happened to reach last. obligation and consulted are both
// projected from this one value -- they are not independently walked. An unread path whose
// consulted list is empty still STOPS the walk, because the standing itself is the found
// signal, not count(consulted)>0.
fn first_unread_standing(c: ProviderDataPathClosure) -> List<ProviderPathStanding> {
  fold(
    [
      c.execution, c.durable_storage, c.backups, c.logs, c.telemetry,
      c.control_plane, c.support_access, c.administrative_access, c.spill,
    ],
    init: [],
    f: fn(acc, p) {
      if count(acc) > 0 {
        acc
      } else {
        match p {
          ProviderPathLocated { operator, jurisdiction, evidence } => acc,
          ProviderPathAbsent { evidence } => acc,
          ProviderPathUnread { obligation, consulted } => [p],
        }
      }
    },
  )
}

fn path_unread_consulted(p: ProviderPathStanding) -> List<DeclarationRef> {
  match p {
    ProviderPathLocated { operator, jurisdiction, evidence } => [],
    ProviderPathAbsent { evidence } => [],
    ProviderPathUnread { obligation, consulted } => consulted,
  }
}

// Same discipline for the downstream population: one match, and the unread arm's own obligation
// comes back rather than a provider row standing in for it.
fn downstream_obligation(d: DownstreamProviderPopulation) -> List<DeclarationRef> {
  match d {
    NoDownstreamProviders { evidence } => [],
    DownstreamProvidersEnumerated { first, further, coverage } => [],
    DownstreamProvidersUnread { obligation } => [obligation],
  }
}
