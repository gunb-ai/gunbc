module product.fabric.provider_route

import std.types { List, Timestamp }
import std.decl_ref { DeclarationRef, declaration_ref_eq }
import std.content_hash { ContentHash }

// THE ADMITTED SUBJECT IS A ROUTE, NEVER A COMPANY. "Provider X is compliant" is not a fact
// this substrate can hold, because the same provider is admissible in one region and not
// another, for ordinary build source and not for regulated data, under one contract revision
// and not the next, and before a downstream-provider change but not after it. So the identity
// that carries an admission is provider x service x region x data-path closure x contract
// revision, and a price row naming only a company can never stand in for it.
//
// THE ROUTE IS A PRODUCT OF CITED DECLARATIONS, NOT A BRANDED STRING, and that is a correction
// the corpus had already ruled rather than a preference. gunbc.fabric_capacity_class_gap's
// capacity_class_refused_remedies rules out ClassEncodedInTrustDomain on the grounds that a
// branded NonEmptyStr "is a magic string agreed between producer and consumer - convention where
// necessity was available, and it reads as coverage while enforcing nothing". A branded
// ProviderRouteRef is that shape exactly: the adapter that mints one and the sanction roster that
// matches one agree by spelling, so a route that names a different real region than the offer runs
// in matches a sanction it should not, and nothing in the type can see it.
//
// Citing declarations instead reduces the convention to something the namespace authority already
// checks (DESIGN section 3: cite the symbol, and a stale name is decidable). Regions are ALREADY
// modeled this way - extdeps.cloud.hetzner carries HetznerCloudRegion as a closed coproduct - and
// DESIGN's external-upstream rule is why this type must not enumerate them itself: a generic hub
// "may not enumerate concrete products", so adding a provider must never widen a type every
// unrelated consumer recompiles against. A reference is the only shape that satisfies both.
//
// WHAT THIS STILL DOES NOT ESTABLISH, stated so the type is not read as more than it is. That the
// cited region is where the work ACTUALLY runs remains a fact about someone else's machine -
// DESIGN section 4b's outside-the-modeled-guarantee column, not a rung. It is observed at a
// declared boundary and carried with its evidence below; it is never fabricated here.
//
// AUTHORITY DIRECTION IS FIXED HERE AND IS THE REASON THIS MODULE EXISTS SEPARATELY. Provider
// modules under extdeps carry facts about the provider - its regions, its service terms, its
// published subprocessors, its data-handling representations. Whether we are presently willing
// and authorised to use those facts is a fact about US. An extdeps provider module that
// imported our posture would let the supplier declare what it is sanctioned to serve, which is
// exactly the inversion gunbc.fabric_executor_class refuses by keeping the executor sanction
// roster on our side and refusing an unclassified executor. This module holds only the
// provider-side route facts; the join against posture and use scope lives one layer up.
type ProviderRoute {
  provider: DeclarationRef
  service: DeclarationRef
  region: DeclarationRef
}

// Route identity is declaration-reference equality on all three components. There is no ordering
// and no prefix relation: a route is the same route or it is a different one, and a sanction for a
// sibling region inherits nothing.
fn provider_route_eq(a: ProviderRoute, b: ProviderRoute) -> Bool {
  declaration_ref_eq(a: a.provider, b: b.provider)
    && declaration_ref_eq(a: a.service, b: b.service)
    && declaration_ref_eq(a: a.region, b: b.region)
}

// The posture is a REVISION, never an ambient "current". A permit records the exact revision it
// was evaluated against, so a posture change makes standing permits STALE rather than silently
// tolerated - the difference between a decision that can be re-derived and one that merely
// happened to be true when nobody was looking.
//
// The authority is an open DeclarationRef because THE POSTURE PRODUCER IS NOT IN THIS TREE (see
// the frontier annotation on product.fabric.provider_admission). The generic fabric must not
// enumerate whose posture governs it any more than it enumerates jurisdictions.
//
// A POSTURE NOW CARRIES THE JURISDICTIONS IT PERMITS, and that is what makes a located path's
// jurisdiction answerable at all. An authority plus a hash says WHOSE rule was in force and WHICH
// revision of it; it does not say what that rule allows, so "this path is in Germany" had nothing
// to be compared against and the two refusals that needed the comparison were deleted as
// uninhabitable rather than left as decoration (product.fabric.provider_admission stated the
// restoration trigger). This field IS that trigger: with the population here, a located path in a
// non-permitted jurisdiction is authorable, and both arms land with producers.
type CompliancePostureRevision {
  authority: DeclarationRef
  revision: ContentHash
  permitted_jurisdictions: PermittedJurisdictionPopulation
  jurisdiction_drop_enrollments: List<JurisdictionDropEnrollment>
}

// THE PERMITTED JURISDICTIONS ARE A POPULATION WITH THE SAME TWO-ARM DISCIPLINE THE REST OF THIS
// MODULE KEEPS, and the arms are what stop it being a list. A bare List<DeclarationRef> makes the
// empty list mean either "this posture permits nothing" or "nobody has written down what it
// permits", and a consumer cannot tell them apart -- the identical collapse ProviderPathAbsent and
// ProviderPathUnread are kept separate to avoid, one type up. The unread arm REFUSES; it never
// widens to "all permitted", because a posture whose permissions nobody has read admitting every
// jurisdiction on earth is the absorbing fallback DESIGN section 5 forbids by name.
//
// THE ENUMERATED ARM CANNOT BE EMPTY, and the first/further encoding is why. A posture permitting
// zero jurisdictions is not a posture with an empty list; it is a stop-work order, which is a
// different subject with a different remedy, and giving it a representation here would let it
// arrive as an ordinary posture that happens to refuse everything. The shape is deliberately
// DownstreamProviderPopulation's, since it answers the same kind of question about a different
// population, and reusing it is the point rather than a coincidence.
//
// JURISDICTIONS STAY OPEN DECLARATION REFERENCES. This type does not enumerate them and must not:
// "Asia" is not a jurisdiction, and adding Germany is a row in somebody's posture rather than an
// edit to a generic type every unrelated consumer recompiles against.
type PermittedJurisdictionPopulation
  = PermittedJurisdictionsEnumerated {
      first: DeclarationRef,
      further: List<DeclarationRef>,
      basis: DeclarationRef,
    }
  | PermittedJurisdictionsUnread { obligation: DeclarationRef }

// A DECLARED RUNG DROP MADE EXECUTABLE, BOUND TO ONE PATH AND ONE CITATION. DESIGN section 4b(3)
// admits a bounded, declared drop with a restoration trigger; what it does not admit is a drop
// whose population is a sentence nothing reads, because then the exception is whatever the code
// happens to do. This row is the executing half: the drop roster says which paths are enrolled in
// prose, and a posture that means it says so in a value the decision folds over.
//
// THE KEY IS THE PATH'S OWN EVIDENCE DECLARATION, AND THE CHOICE IS THE WHOLE SAFETY OF THE ROW.
// The tempting key is the offending jurisdiction citation itself, and it is catastrophic: a
// citation is a VALUE any route may carry, so enrolling one exempts every route that cites it,
// present and future, while looking like a single narrow exception. That converts a bounded
// population-scoped drop into an unbounded standing permission - DESIGN section 5's absorbing
// fallback exactly, the-value-as-answer conflated with the-value-as-ignorance. The path's evidence
// declaration is the opposite: it names WHICH path was examined and enrolled, so a second route
// citing the same thing is not enrolled and refuses, which is the discriminating red that proves
// the exception is bound to the path rather than to the value.
//
// THE JURISDICTION IS CARRIED TOO, so an enrolled path that later moves to a DIFFERENT
// non-permitted jurisdiction stops being enrolled and refuses. Without it the enrollment would
// excuse the path rather than the examined fact about it, and would keep excusing it after the
// fact changed.
//
// WHAT THE DROP REFERENCE DOES AND DOES NOT ESTABLISH TODAY, stated at its real strength because
// the field sits beside one that executes. Requiring it means an enrollment with NO drop row has no
// constructor, and because ProviderUsePermit records the whole posture, an auditor holding a permit
// reaches the cited row's reason, bounded population and restoration trigger.
//
// WHAT NO CODE READS: the reference itself. jurisdiction_drop_enrolled below matches path_evidence
// and jurisdiction and ignores drop, so nothing joins it to gunbc.rung_drop, nothing establishes
// that the named row EXISTS in the roster, and nothing establishes that the row's population names
// this path. An enrollment citing a row that resolves to nothing, or to a row describing something
// else, stands the wall down with no diagnostic and no count -- and an enrollment's whole effect IS
// that TransferOrLocationUnresolved does not fire, which is the shape DESIGN section 5 names as an
// escape hatch. The accounting is therefore ASSERTED HERE AND EXECUTED NOWHERE, and saying otherwise
// would be rung inflation (4b(1)) about this very field.
//
// NEXT-RUNG TRIGGER: a gate that REFUSES an enrollment whose drop does not resolve to a
// gunbc.rung_drop roster row whose own population names that path_evidence -- sufficient for the
// bounded, declared half of the 4b(3) exception to be checked rather than read, at which point this
// annotation states a guarantee instead of a gap.
type JurisdictionDropEnrollment {
  path_evidence: DeclarationRef
  jurisdiction: DeclarationRef
  drop: DeclarationRef
}

// One match per enrollment, and BOTH components must agree. The result is a count rather than a
// Bool over a projected list because the caller is a fold that wants "is this exact path, citing
// this exact thing, enrolled" and nothing else.
fn jurisdiction_drop_enrolled(
  enrollments: List<JurisdictionDropEnrollment>,
  path_evidence: DeclarationRef,
  jurisdiction: DeclarationRef,
) -> Bool {
  count(filter(
    enrollments,
    e => declaration_ref_eq(a: e.path_evidence, b: path_evidence)
      && declaration_ref_eq(a: e.jurisdiction, b: jurisdiction),
  )) > 0
}

// ONE LOCATION IS NOT A DATA PATH. A Helsinki VM whose backups, telemetry or administrators sit
// elsewhere is not a Helsinki-contained path, and a vendor region label establishes none of
// those. Each path answers for itself.
//
// THE ABSENT AND UNREAD ARMS ARE SEPARATE AND THAT SEPARATION IS THE WHOLE POINT. An empty
// backup destination must never ambiguously mean either "backups are disabled" or "nobody
// examined backups" - the first is a fact that can support an admission and the second is an
// obligation that must refuse. Collapsing them is how an unexamined path reads as a clean one,
// which is the same move product.supplier.ubicloud refuses by carrying IsolationNotObserved
// beside its catalog rows rather than inventing a guarantee from a price list.
type ProviderPathStanding
  = ProviderPathLocated {
      operator: DeclarationRef,
      jurisdiction: DeclarationRef,
      evidence: DeclarationRef,
    }
  | ProviderPathAbsent { evidence: DeclarationRef }
  | ProviderPathUnread { obligation: DeclarationRef }

// CLOSED OVER THE PATHS WE PRESENTLY KNOW WE MUST GOVERN, and closed deliberately: adding a
// material path forces EVERY route to answer for it rather than letting existing rows stay
// silently incomplete. Object storage, logs, telemetry, backups, support access and spill - not
// merely the runner VM - plus the control plane and administrative access that reach customer
// material without appearing in any customer-visible topology.
type ProviderDataPathClosure {
  execution: ProviderPathStanding
  durable_storage: ProviderPathStanding
  backups: ProviderPathStanding
  logs: ProviderPathStanding
  telemetry: ProviderPathStanding
  control_plane: ProviderPathStanding
  support_access: ProviderPathStanding
  administrative_access: ProviderPathStanding
  spill: ProviderPathStanding
}

// A provider's own downstream providers are part of our data path whether or not they appear in
// its price list. The three arms carry the same discipline the path standing does: an
// enumerated population with its coverage evidence, an explicit and evidenced none, or an
// unread obligation that refuses.
type DownstreamProviderPopulation
  = NoDownstreamProviders { evidence: DeclarationRef }
  | DownstreamProvidersEnumerated {
      first: DeclarationRef,
      further: List<DeclarationRef>,
      coverage: DeclarationRef,
    }
  | DownstreamProvidersUnread { obligation: DeclarationRef }

// provider and service are NOT repeated here: they are components of the route above, and carrying
// them twice would let a facts row describe one route while naming another.
//
// JURISDICTIONS ARE OPEN DECLARATION REFERENCES AND THERE IS DELIBERATELY NO CENTRAL ENUM.
// "Asia" is not a jurisdiction, a US-or-EU-or-other kernel is a nickname for N distinct legal
// systems, and adding Germany must be a row in a provider population rather than an edit to a
// generic type every unrelated consumer recompiles against. The generic fabric knows that a
// jurisdiction is cited; which jurisdictions exist is not its fact to hold.
type ProviderRouteFacts {
  route: ProviderRoute
  contract_terms: DeclarationRef
  data_paths: ProviderDataPathClosure
  downstream: DownstreamProviderPopulation
  observed_at: Timestamp
  facts_revision: ContentHash
}

// THE COPRODUCT IS MATCHED ONCE AND YIELDS THE OBLIGATION DIRECTLY. There is deliberately no
// Bool predicate here. A path_is_resolved returning Bool DISCARDS exactly the payload a refusal
// then needs, so the refusal builder has to walk the same value a second time - and that second
// walk is what forces a seed to exist, which is what made the seed a place to fabricate an
// obligation. Matching once removes the seed rather than improving it: an empty list is "no
// obligation", a one-element list IS the located obligation, and neither can lie.
//
// The nine paths are visited in a FIXED order, so the reported obligation is deterministic
// rather than whichever arm a fold happened to reach last. The order is now the two groups below
// concatenated rather than a third transcription of the same nine fields: one list that could
// disagree with the groups is exactly the fork section 3 consolidates later at interest. The
// relative order within each group is unchanged; spill now precedes the access paths, which moves
// nothing that any consumer reads, since determinism rather than the particular sequence is what
// this fold owes.
fn first_unresolved_obligation(c: ProviderDataPathClosure) -> List<DeclarationRef> {
  fold(
    concat(data_bearing_paths(c: c), provider_access_paths(c: c)),
    init: [],
    f: fn(acc, p) {
      if count(acc) > 0 {
        acc
      } else {
        match p {
          ProviderPathLocated { operator, jurisdiction, evidence } => acc,
          ProviderPathAbsent { evidence } => acc,
          ProviderPathUnread { obligation } => [obligation],
        }
      }
    },
  )
}

// Same discipline for the downstream population: one match, and the unread arm's own obligation
// comes back rather than a provider row standing in for it.
fn downstream_obligation(d: DownstreamProviderPopulation) -> List<DeclarationRef> {
  match d {
    NoDownstreamProviders { evidence } => [],
    DownstreamProvidersEnumerated { first, further, coverage } => [],
    DownstreamProvidersUnread { obligation } => [obligation],
  }
}

// THE TWO GROUPS, AND THE SPLIT IS THIS MODULE'S OWN DISTINCTION RATHER THAN A NEW ONE. The
// closure's annotation already draws it: object storage, logs, telemetry, backups and spill are
// where the route's material SITS, while the control plane, support access and administrative
// access are how the provider's own people REACH that material "without appearing in any
// customer-visible topology". The two groups are the same nine paths, partitioned, so no path is
// in both and none is in neither -- and the partition is what lets a non-permitted jurisdiction
// refuse with the right remedy, because the remedies are not the same thing at all.
//
// WHERE MATERIAL SITS IS SOMETHING WE CHOOSE. Placing a workload, a bucket or a backup in a
// permitted jurisdiction is a decision on our side of the boundary: pick another region, another
// storage class, another retention target.
fn data_bearing_paths(c: ProviderDataPathClosure) -> List<ProviderPathStanding> {
  [c.execution, c.durable_storage, c.backups, c.logs, c.telemetry, c.spill]
}

// WHO REACHES IT IS SOMETHING THE PROVIDER COMMITS TO, and no region choice moves it. A support
// desk and a control plane do not relocate because the workload did; they are where the provider
// runs them, so the only remedy is a commitment from that operator restricting privileged access
// to permitted jurisdictions -- which is why the refusal built over this group names the operator
// and the one built over the group above does not.
fn provider_access_paths(c: ProviderDataPathClosure) -> List<ProviderPathStanding> {
  [c.control_plane, c.support_access, c.administrative_access]
}
