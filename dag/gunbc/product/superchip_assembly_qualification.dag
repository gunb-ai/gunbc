module product.superchip_assembly_qualification

import std.types { Bool, List, NonEmptyStr, String }
import std.nat { Nat }
import std.measure { ByteSize, byte_size_count, gibibyte, gibibyte_to_byte_size, watt_count, volt_count }
import std.process { ProcessExit, ExitSuccess, exit_failure }
import extdeps.memory.types { MemoryKind, Hbm }
import extdeps.systems.types { CoherentSuperchipCatalogRow }
import extdeps.systems.nvidia_gh200 { nvidia_gh200_480gb_catalog, gh200_rail_variants, ModuleRailVariant }
import extdeps.external_authority { cited_figure_read_obligation }
import extdeps.systems.asrock_rack_mecai_gh200 { asrock_rack_mecai_gh200 }
import extdeps.systems.types { SuperchipServerCatalogRow, SuperchipCarrierBoardRow, BoardPowerInput }
import extdeps.boards.asrock_rack_arlington_mb { asrock_rack_arlington_mb }
import product.p4261_carrier_layout {
  CarrierLayoutObservation,
  p4261_k1_layout,
  carrier_input_reading,
  management_io_text,
  edge_connector_text,
}

// GH200-1 (2026-10-03). WHAT IT TAKES TO QUALIFY ONE MODULE-ON-CARRIER ASSEMBLY. The operator is buying
// two PG530 modules and two P4261 carriers and will qualify one pair before duplicating it -- and
// before any Spark is sold (product.node_platform_selection consumes this module's verdict as its hard
// constraint). A pair is not "compatible" by an authored flag: four results are DERIVED, each from the
// evidence that can actually establish it, in the order a bench reaches them:
//
//   MechanicallyMated  connector identity and geometry, mounting stack
//   SafeToEnergize     the complete power path, the site's AC, a thermal path for every heat region,
//                      protective shutdown
//   BootQualified      management/firmware path, boot storage, an observed boot of THIS module on THIS
//                      carrier, the unit's measured memory inventory
//   WorkloadQualified  module-scope power limit holding, the served model demonstrated
//
// Each requirement is Verified, Contradicted or Undetermined, and the three never substitute for one
// another: a photograph establishes a label or a connector layout, a datasheet a family figure, a
// seller's word provenance, and only a boot receipt the operation of a particular pair. Unknown stays
// Undetermined -- never an invented success, never an invented incompatibility.
//
// WHY NOT product.cooling_qualification: that module grades an installed CPU cooler against cited
// catalog rows (retention mount, supported-board population, design power vs TDP). A GH200 thermal
// assembly has no catalog row in this corpus and no socket mount, so its grade here is evidence about
// the assembly; the divergence ends when a cited GH200 thermal-assembly row exists to grade against.

// ── WHAT WAS OBSERVED, NOT WHAT NVIDIA PUBLISHES ──────────────────────────────────────────────
//
// Listing transcriptions the operator supplied. These are receipts in this layer (DESIGN §3,
// external upstream decomposition): NVIDIA publishes the GH200 product family, and nothing about any
// particular unit, revision suffix or carrier board. Three facts are kept apart because each settles a
// different question: the PUBLISHED family configuration (extdeps.systems.nvidia_gh200), the SELLER'S
// claims (listed_gpu_memory and listed_cpu_memory, kept as claims so they can be checked rather than
// believed), and the
// MEASURED inventory of a serial-numbered unit (measured_inventory), which only a running unit yields.
type ListedGpuMemoryClaim
  = GpuMemoryClaimed { capacity: ByteSize, memory_kind: MemoryKind, as_listed: NonEmptyStr }
  | GpuMemoryNotClaimed

// THE SELLER'S LPDDR5X CLAIM, at the grain it is stated: a usable size, with the listing's own wording
// beside it. The datasheet prints an LPDDR5X SIZE (120, 240 or 480GB) and no physical-versus-usable
// split, so a listing's "physical" figure has no published row to be compared with and stays in its
// wording rather than becoming a second number.
type ListedCpuMemoryClaim
  = CpuMemoryClaimed { usable: ByteSize, as_listed: NonEmptyStr }
  | CpuMemoryNotClaimed

// THE FACE A MODULE AND ITS CARRIER MEET ON, as far as a photograph shows it. A GH200 module mates to
// its carrier through high-density mezzanine connectors on its underside (ServeTheHome, below); what a
// photograph can establish is how many there are, how many contact rows each shows, and where they
// sit. It cannot establish pin count, pinout or keying, so a face read from a photograph is recorded at
// that grain and no finer.
type ConnectorArrangement
  = OneAtEachEndOfLongAxis
  | ArrangementOther { described: NonEmptyStr }

type MezzanineFaceObservation
  = MezzanineFacePhotographed {
      connector_count: Nat
      contact_rows_per_connector: Nat
      arrangement: ConnectorArrangement
      source: NonEmptyStr
    }
  | MezzanineFaceUnobserved { obligation: NonEmptyStr }

type UnitInventoryObservation
  = InventoryUnmeasured
  | InventoryMeasured { gpu_memory: ByteSize, cpu_memory: ByteSize, evidence: NonEmptyStr }

type SuperchipUnitObservation {
  board_designation: NonEmptyStr
  board_part_number: NonEmptyStr
  die_marking: NonEmptyStr
  listed_gpu_memory: ListedGpuMemoryClaim
  listed_cpu_memory: ListedCpuMemoryClaim
  mezzanine_face: MezzanineFaceObservation
  measured_inventory: UnitInventoryObservation
  source: NonEmptyStr
}

// Whether the carrier was ever SEEN running a module, and which one. A seller's "it came out of a
// working machine" is provenance, not this: it names no module and no boot, so it is carried as
// provenance and leaves the boot unobserved.
type CarrierBootObservation
  = CarrierBootUnobserved
  | CarrierBootObserved { module_part_number: NonEmptyStr, evidence: NonEmptyStr }

type CarrierUnitObservation {
  carrier_designation: NonEmptyStr
  carrier_part_number: NonEmptyStr
  revision: NonEmptyStr
  layout: CarrierLayoutObservation
  module_face: MezzanineFaceObservation
  provenance: NonEmptyStr
  boot: CarrierBootObservation
  source: NonEmptyStr
}

// The unit the operator is buying: listing title "NVIDIA GH200 699-2G530-0215-DV5 Grace Hopper Dev
// Superchip 96GB H100 SXM5", item specifics Memory Size 96GB / Memory Type HBM3; the die photograph
// reads "GH100-888K-A1 QUAL SAMPLE". The listing DESCRIPTION (operator transcription, 2026-10-04) also
// states "CPU Memory: 512GB physical LPDDR5X / roughly 480GB usable in the standard GH200 configuration"
// and "DV5 development/pre-production revision; compatibility not guaranteed".
data gh200_dv5_unit: SuperchipUnitObservation = SuperchipUnitObservation {
  board_designation: "PG530",
  board_part_number: "699-2G530-0215-DV5",
  die_marking: "GH100-888K-A1 QUAL SAMPLE",
  listed_gpu_memory: GpuMemoryClaimed {
    capacity: gibibyte_to_byte_size(g: gibibyte(count: 96)),
    memory_kind: Hbm,
    as_listed: "96GB HBM3",
  },
  listed_cpu_memory: CpuMemoryClaimed {
    usable: gibibyte_to_byte_size(g: gibibyte(count: 480)),
    as_listed: "512GB physical LPDDR5X / roughly 480GB usable",
  },
  mezzanine_face: MezzanineFacePhotographed {
    connector_count: 2,
    contact_rows_per_connector: 6,
    arrangement: OneAtEachEndOfLongAxis,
    source: "listing photograph of the module underside, label '699-2G530-0215-DV5 C1 Made in USA', model PG530",
  },
  measured_inventory: InventoryUnmeasured,
  source: "eBay item 298619132349, transcribed by the operator 2026-10-03 (title, item specifics) and 2026-10-04 (description)",
}


// The operator bought TWO units of this listing (2026-10-04). The second carries the same listing facts
// and no serial of its own yet, and it has no carrier: it is not an assembly until one is bought, so it
// is recorded as held rather than paired with anything.
data gh200_dv5_second_unit: SuperchipUnitObservation = SuperchipUnitObservation {
  board_designation: gh200_dv5_unit.board_designation,
  board_part_number: gh200_dv5_unit.board_part_number,
  die_marking: gh200_dv5_unit.die_marking,
  listed_gpu_memory: gh200_dv5_unit.listed_gpu_memory,
  listed_cpu_memory: gh200_dv5_unit.listed_cpu_memory,
  mezzanine_face: gh200_dv5_unit.mezzanine_face,
  measured_inventory: InventoryUnmeasured,
  source: "second unit bought from eBay item 298619132349; its own serial and photographs not yet recorded",
}

// Read off the seller's photographs: the sticker says "S/N 1582023110038 Model: P4261
// 694-24261-0000-100 K1 Made In USA" beside a "Rework 180-14261-DAAF-A01" silkscreen -- a printed
// marking; whether any rework was performed, and what, is unknown. The sticker's
// "0000-100" and the listing title's "000-100" differ by a digit; the sticker is what was read, and no
// consumer keys on the carrier part number. The module face is the two connectors silkscreened J3 and
// J4, one toward each short edge, each flanked by mounting holes.
data p4261_k1_carrier: CarrierUnitObservation = CarrierUnitObservation {
  carrier_designation: "P4261",
  carrier_part_number: "694-24261-0000-100",
  revision: "K1",
  layout: p4261_k1_layout,
  module_face: MezzanineFacePhotographed {
    connector_count: 2,
    contact_rows_per_connector: 6,
    arrangement: OneAtEachEndOfLongAxis,
    source: "seller photographs of the carrier: receptacles J3 and J4",
  },
  provenance: "seller: 'told when I purchased this board was out of a working machine'; untested, no visible damage",
  boot: CarrierBootUnobserved,
  source: "the operator's purchase, eBay item 168742238639 (titled 'Nvidia GH200 P4261 694-24261-000-100 K1 ...'), and its photographs; item 157373033242 is a different listing of the same title and was not bought; no NVIDIA document names P4261",
}



// ── WHAT A LISTING CLAIM IS CONSISTENT WITH ──────────────────────────────────────────────────
//
// A listing can only be compared on what it claims, and each tier is compared on its own claim. A
// "96GB HBM3" claim is CONSISTENT with the datasheet's GPU tier and establishes nothing about LPDDR5X,
// which the datasheet admits at 120, 240 or 480 GB; whether the LPDDR5X tier agrees is a SEPARATE match
// on the listing's separate CPU-memory claim (unit_cpu_memory_match below), never inferred from the GPU
// tier. (GH200-0 first named the GPU arm UnitMatchesCatalogRow, which read a GPU-tier claim as the
// whole 480GB row; the narrower name is the correction. GH200-5, 2026-10-04: an earlier revision of this
// note said these listings claim "the GPU tier and nothing else", which the DV5 listing's description
// contradicts -- the operator supplied it, and the CPU match is the repair.) A claim outside every published
// configuration is either a mis-titled listing or a pre-production configuration, and the remedy is the
// same -- measure the unit -- so both land in one arm that names the discriminator.
type UnitCatalogMatch
  = UnitGpuTierConsistentWithRow { row: CoherentSuperchipCatalogRow, as_listed: NonEmptyStr }
  | UnitDesignationOutsideRow { observed: NonEmptyStr, row_designation: NonEmptyStr }
  | UnitClaimOutsideCatalog { as_listed: NonEmptyStr }
  | UnitMemoryUnclaimed

fn unit_catalog_match(unit: SuperchipUnitObservation, row: CoherentSuperchipCatalogRow) -> UnitCatalogMatch {
  if unit.board_designation != row.board_designation {
    UnitDesignationOutsideRow { observed: unit.board_designation, row_designation: row.board_designation }
  } else {
    match unit.listed_gpu_memory {
      GpuMemoryNotClaimed => UnitMemoryUnclaimed
      GpuMemoryClaimed { capacity: c, memory_kind: k, as_listed: l } =>
        if byte_size_count(b: c) == byte_size_count(b: row.gpu.memory.capacity) && k == row.gpu.memory.memory_kind {
          UnitGpuTierConsistentWithRow { row: row, as_listed: l }
        } else {
          UnitClaimOutsideCatalog { as_listed: l }
        }
    }
  }
}

fn listing_claim_note(m: UnitCatalogMatch) -> String {
  match m {
    UnitGpuTierConsistentWithRow { row: _, as_listed: l } =>
      join(["the listing's '", l as String, "' is consistent with the datasheet GPU tier"], "")
    UnitClaimOutsideCatalog { as_listed: l } =>
      join(["the listing's '", l as String, "' is outside every published GH200 configuration (96GB HBM3, 144GB HBM3e)"], "")
    UnitDesignationOutsideRow { observed: o, row_designation: r } =>
      join(["the unit's designation ", o as String, " is not the row's ", r as String], "")
    UnitMemoryUnclaimed => "the listing claims no memory configuration"
  }
}

// THE LPDDR5X CLAIM AGAINST THE ROW'S LPDDR5X TIER. Consistency is a seller's claim agreeing with a
// published configuration -- it is not the unit's inventory, and a QUAL SAMPLE whose own listing says
// "compatibility not guaranteed" is exactly the unit for which the two may differ. Only
// measured_inventory settles it.
type UnitCpuMemoryMatch
  = UnitCpuTierConsistentWithRow { as_listed: NonEmptyStr }
  | UnitCpuClaimOutsideRow { as_listed: NonEmptyStr }
  | UnitCpuMemoryUnclaimed

fn unit_cpu_memory_match(unit: SuperchipUnitObservation, row: CoherentSuperchipCatalogRow) -> UnitCpuMemoryMatch {
  match unit.listed_cpu_memory {
    CpuMemoryNotClaimed => UnitCpuMemoryUnclaimed
    CpuMemoryClaimed { usable: u, as_listed: l } =>
      if byte_size_count(b: u) == byte_size_count(b: row.cpu_memory.memory.capacity) {
        UnitCpuTierConsistentWithRow { as_listed: l }
      } else {
        UnitCpuClaimOutsideRow { as_listed: l }
      }
  }
}

fn cpu_claim_note(m: UnitCpuMemoryMatch) -> String {
  match m {
    UnitCpuTierConsistentWithRow { as_listed: l } =>
      join(["the listing's '", l as String, "' is consistent with the row's LPDDR5X tier, as a seller's claim the unit's own inventory settles"], "")
    UnitCpuClaimOutsideRow { as_listed: l } =>
      join(["the listing's '", l as String, "' is not this row's LPDDR5X tier; the datasheet admits 120, 240 or 480 GB"], "")
    UnitCpuMemoryUnclaimed => "the listing claims no LPDDR5X size, which the datasheet admits at 120, 240 or 480 GB"
  }
}

// ── WILL THIS MODULE MATE WITH THAT CARRIER ─────────────────────────────────────────────────
//
// ServeTheHome's GH200 teardown (servethehome.com, 2023-11-06) establishes that a GH200 and a Grace
// CPU Superchip use different module connectors and that "the base carrier board and the NVIDIA module
// must be matched". It establishes nothing about revisions within the GH200 family, and no NVIDIA
// document names P4261.
// THE MECHANICAL HALF, decidable from two photographs. Agreement here is necessary and nowhere near
// sufficient: two faces with the same connector count, row count and placement can still differ in
// pin count, pinout, keying or the power and sideband signals behind them. So agreement is reported
// at the grain it was read at, with the next grain named, and only DISAGREEMENT is final.
type MechanicalInterfaceStanding
  = InterfaceConsistentAtPhotoGrain { basis: NonEmptyStr, next_grain: NonEmptyStr }
  | InterfaceMismatch { reason: NonEmptyStr }
  | InterfaceUnobserved { obligations: List<NonEmptyStr> }

data connector_part_grain_obligation: NonEmptyStr = "read the housing markings of one module connector and one carrier receptacle and confirm in the connector vendor's catalog that they are a mating plug/receptacle pair" as NonEmptyStr

fn arrangement_eq(a: ConnectorArrangement, b: ConnectorArrangement) -> Bool {
  match a {
    OneAtEachEndOfLongAxis => match b {
      OneAtEachEndOfLongAxis => true
      ArrangementOther { described: _ } => false
    }
    ArrangementOther { described: da } => match b {
      OneAtEachEndOfLongAxis => false
      ArrangementOther { described: db } => da == db
    }
  }
}

fn face_obligations(face: MezzanineFaceObservation) -> List<NonEmptyStr> {
  match face {
    MezzanineFaceUnobserved { obligation: o } => [o]
    MezzanineFacePhotographed { connector_count: _, contact_rows_per_connector: _, arrangement: _, source: _ } => []
  }
}

fn mechanical_interface(module_face: MezzanineFaceObservation, carrier_face: MezzanineFaceObservation) -> MechanicalInterfaceStanding {
  match module_face {
    MezzanineFaceUnobserved { obligation: _ } =>
      InterfaceUnobserved { obligations: concat(face_obligations(face: module_face), face_obligations(face: carrier_face)) }
    MezzanineFacePhotographed { connector_count: mc, contact_rows_per_connector: mr, arrangement: ma, source: ms } =>
      match carrier_face {
        MezzanineFaceUnobserved { obligation: o } => InterfaceUnobserved { obligations: [o] }
        MezzanineFacePhotographed { connector_count: cc, contact_rows_per_connector: cr, arrangement: ca, source: cs } =>
          if mc != cc {
            InterfaceMismatch { reason: join(["module shows ", to_string(mc), " connectors, carrier shows ", to_string(cc)], "") as NonEmptyStr }
          } else if mr != cr {
            InterfaceMismatch { reason: join(["module connectors show ", to_string(mr), " contact rows, carrier receptacles ", to_string(cr)], "") as NonEmptyStr }
          } else if !arrangement_eq(a: ma, b: ca) {
            InterfaceMismatch { reason: "module and carrier connectors are placed differently" as NonEmptyStr }
          } else {
            InterfaceConsistentAtPhotoGrain {
              basis: join([to_string(mc), " connectors of ", to_string(mr), " contact rows, one at each end, on both faces (", ms as String, "; ", cs as String, ")"], "") as NonEmptyStr,
              next_grain: connector_part_grain_obligation,
            }
          }
      }
  }
}


// ── THE LADDER ───────────────────────────────────────────────────────────────────────────────

type EvidenceStanding
  = EvidenceVerified { evidence: NonEmptyStr }
  | EvidenceContradicted { reason: NonEmptyStr }
  | EvidenceUndetermined { obligation: NonEmptyStr }

type QualificationRequirement {
  requirement: NonEmptyStr
  standing: EvidenceStanding
}

type QualificationStage = MechanicallyMated | SafeToEnergize | BootQualified | WorkloadQualified

fn qualification_stage_label(stage: QualificationStage) -> NonEmptyStr {
  match stage {
    MechanicallyMated => "mechanically mated" as NonEmptyStr
    SafeToEnergize => "safe to energize" as NonEmptyStr
    BootQualified => "boot-qualified" as NonEmptyStr
    WorkloadQualified => "workload-qualified" as NonEmptyStr
  }
}

type StageGate {
  stage: QualificationStage
  requirements: List<QualificationRequirement>
}

// WHAT THE BENCH HAS READ, one slot per requirement no photograph or listing can settle. Every slot
// starts NotYetRead, and that is what makes the ladder honest in both directions: an unread slot is an
// open requirement whose obligation text is derived from the parts, and a read slot -- verified or
// contradicted -- is what moves it. Without these slots the requirements could never be satisfied,
// and a gate whose green is unauthorable is decoration (DESIGN §4b).
type BenchReading
  = NotYetRead
  | ReadVerified { evidence: NonEmptyStr }
  | ReadContradicted { reason: NonEmptyStr }

type BenchRecord {
  connector_identity: BenchReading
  mounting_stack: BenchReading
  power_path: BenchReading
  site_ac_supply: BenchReading
  thermal_path: BenchReading
  protective_shutdown: BenchReading
  management_path: BenchReading
  boot_storage: BenchReading
  module_power_limit: BenchReading
  served_workload: BenchReading
}

data bench_unread: BenchRecord = BenchRecord {
  connector_identity: NotYetRead,
  mounting_stack: NotYetRead,
  power_path: NotYetRead,
  site_ac_supply: NotYetRead,
  thermal_path: NotYetRead,
  protective_shutdown: NotYetRead,
  management_path: NotYetRead,
  boot_storage: NotYetRead,
  module_power_limit: NotYetRead,
  served_workload: NotYetRead,
}

type SuperchipAssembly {
  unit: SuperchipUnitObservation
  carrier: CarrierUnitObservation
  row: CoherentSuperchipCatalogRow
  bench: BenchRecord
}

fn bench_requirement(requirement: NonEmptyStr, reading: BenchReading, obligation: String) -> QualificationRequirement {
  match reading {
    NotYetRead => undetermined(requirement: requirement, obligation: obligation)
    ReadVerified { evidence: e } => verified(requirement: requirement, evidence: e)
    ReadContradicted { reason: r } => contradicted(requirement: requirement, reason: r)
  }
}

fn verified(requirement: NonEmptyStr, evidence: NonEmptyStr) -> QualificationRequirement {
  QualificationRequirement { requirement: requirement, standing: EvidenceVerified { evidence: evidence } }
}

fn undetermined(requirement: NonEmptyStr, obligation: String) -> QualificationRequirement {
  QualificationRequirement { requirement: requirement, standing: EvidenceUndetermined { obligation: obligation as NonEmptyStr } }
}

fn contradicted(requirement: NonEmptyStr, reason: NonEmptyStr) -> QualificationRequirement {
  QualificationRequirement { requirement: requirement, standing: EvidenceContradicted { reason: reason } }
}

fn carrier_label(c: CarrierUnitObservation) -> String {
  join([c.carrier_designation as String, " ", c.carrier_part_number as String, " rev ", c.revision as String], "")
}

fn mating_requirement(a: SuperchipAssembly) -> QualificationRequirement {
  let name = "mating connectors" as NonEmptyStr
  match mechanical_interface(module_face: a.unit.mezzanine_face, carrier_face: a.carrier.module_face) {
    InterfaceMismatch { reason: r } => contradicted(requirement: name, reason: r)
    InterfaceUnobserved { obligations: os } => undetermined(requirement: name, obligation: join(map(os, o => o as String), "; "))
    InterfaceConsistentAtPhotoGrain { basis: b, next_grain: n } =>
      bench_requirement(requirement: name, reading: a.bench.connector_identity,
        obligation: join(["consistent at photo grain (", b as String, "); next: ", n as String], ""))
  }
}

// THE POWER FIGURES ARE THE ROW'S, not restated: the module's cited 450-1000 W configurable range sets
// what the supply path must deliver before any OS-applied limit exists, since a limit set by
// nvidia-smi cannot protect a boot that precedes it.
// THE MODULE'S RAIL LEAD, matched by part number. "0215" in a 699-2G530 part number is read as SKU215,
// and extdeps.systems.nvidia_gh200 carries the uncited lead that an earlier NVIDIA guide tied SKU215 to
// 54 V. Both steps are bets and the text says so; neither says what the carrier's connector takes.
fn module_rail_lead(unit: SuperchipUnitObservation) -> String {
  match (filter(gh200_rail_variants, v => contains(unit.board_part_number as String, join(["-0", v.sku as String, "-"], "")))).first() {
    Absent => "no rail-variant lead matches this module's part number"
    Present { value: v } =>
      join([
        "module ", unit.board_part_number as String, " reads as SKU", v.sku as String, ", which an earlier NVIDIA guide revision tied to a ",
        to_string(volt_count(v: v.rail)), " V module rail (unverified: ",
        match cited_figure_read_obligation(standing: v.standing) {
          Present { value: o } => o as String
          Absent => "cited"
        },
        ")",
      ], "")
  }
}

// A DOCUMENTED GH200 CARRIER, as a reference pattern for what P4261 leaves open: ASRock Rack's
// ARLINGTON-MB (extdeps.boards.asrock_rack_arlington_mb, from the MECAI-GH200 user manual). A pattern
// frames the questions; it says nothing about P4261's pinout, and ARLINGTON's parts are not assumed to
// fit P4261.
fn reference_management_pattern(c: SuperchipCarrierBoardRow) -> String {
  join([
    "reference: ", c.model as String, " carries ",
    match c.management_board {
      Present { value: m } => m as String
      Absent => "an unread management controller"
    },
    ", with ", join(map(c.on_board_devices, d => d as String), ", "), " on the carrier itself; the P4261 photographs show no comparable BMC slot, which fits a BMC on another board (the controller + HMC lead) without establishing it",
  ], "")
}

fn input_text(i: BoardPowerInput) -> String {
  match i.rail {
    Present { value: v } => join([i.designator as String, " ", to_string(volt_count(v: v)), " V"], "")
    Absent => join([i.designator as String, " (rail unprinted)"], "")
  }
}

fn reference_supply_pattern(server: SuperchipServerCatalogRow) -> String {
  match server.carrier {
    Absent => join(["reference: ", server.model as String, " documents no carrier inputs"], "")
    Present { value: c } => join([
      "reference: ", server.model as String, "'s carrier ", c.model as String, " takes ", join(map(c.power_inputs, i => input_text(i: i)), ", "),
      " from a power-distribution board fed by its ", server.power_supplies.form as String,
      " supplies -- a documented 12 V carrier; whether it supports a 0215 (possibly 54 V) module is a question for its vendor",
    ], "")
  }
}

fn power_path_obligation(a: SuperchipAssembly) -> String {
  join([
    "the complete power path for carrier ", carrier_label(c: a.carrier),
    ": rail voltages, connector pinout and orientation, standby rail, enable and power-good signals and sequencing, then AC supply, PSU, any distribution or conversion board and the exact harness, sized for this module's startup and default power behavior (not documented for this qualification sample) and the intended operating point within the cited ",
    to_string(watt_count(w: a.row.module_power_floor)), "-", to_string(watt_count(w: a.row.module_power_ceiling)),
    " W configurable range plus carrier, fan and storage load. What the photographs bound: ", carrier_input_reading(layout: a.carrier.layout),
    ". What the module suggests: ", module_rail_lead(unit: a.unit),
    ". ", reference_supply_pattern(server: asrock_rack_mecai_gh200),
    ". No P4261 power-input pinout or power-on sequence has been established: obtain the original system's PSU, distribution board and harness part numbers with connection photographs, connect nothing because its housing fits, and transfer no controller, pin function, signal level or timing from another NVIDIA platform",
  ], "")
}

fn thermal_obligation(a: SuperchipAssembly) -> String {
  join([
    "a GH200-specific thermal assembly with an identified cooling path for every heat region of ", a.unit.board_part_number as String,
    " -- the lidless Hopper/HBM package, the Grace package and the module power stages -- sized for the documented startup behavior and the intended operating envelope within the cited ",
    to_string(watt_count(w: a.row.module_power_floor)), "-", to_string(watt_count(w: a.row.module_power_ceiling)),
    " W range. Three interfaces to establish: mechanical and thermal (supported module revisions, contact heights, mounting stack, interface materials, preload, any supplementary airflow); liquid connections if liquid-cooled (fitting or quick-disconnect standard, coolant, pressure, flow at the intended inlet temperature, a pump sized against the measured loop resistance); and power and fault control for pumps and fans. The datasheet admits air or liquid cooling. Lead, fit unverified: CoolIT CP-NV-GH200-SUPERCHIP series",
  ], "")
}

fn boot_requirement(a: SuperchipAssembly) -> QualificationRequirement {
  let name = "observed boot of this module on this carrier" as NonEmptyStr
  match a.carrier.boot {
    CarrierBootObserved { module_part_number: m, evidence: e } =>
      if m == a.unit.board_part_number {
        verified(requirement: name, evidence: e)
      } else {
        undetermined(requirement: name, obligation: join(["carrier ", carrier_label(c: a.carrier), " was observed running ", m as String, ", not ", a.unit.board_part_number as String], ""))
      }
    CarrierBootUnobserved =>
      undetermined(requirement: name, obligation: join([
        "observe ", a.unit.board_part_number as String, " booting to BMC and OS on ", carrier_label(c: a.carrier),
        ", capturing console output, firmware versions and FRU identity (provenance so far: ", a.carrier.provenance as String, ")",
      ], ""))
  }
}

fn inventory_requirement(a: SuperchipAssembly) -> QualificationRequirement {
  let name = "measured memory inventory" as NonEmptyStr
  match a.unit.measured_inventory {
    InventoryMeasured { gpu_memory: _, cpu_memory: _, evidence: e } => verified(requirement: name, evidence: e)
    InventoryUnmeasured =>
      undetermined(requirement: name, obligation: join([
        "measure ", a.unit.board_part_number as String, "'s HBM and LPDDR5X on a running carrier (nvidia-smi -q, numactl -H, ipmitool fru print): ",
        listing_claim_note(m: unit_catalog_match(unit: a.unit, row: a.row)),
        "; ",
        cpu_claim_note(m: unit_cpu_memory_match(unit: a.unit, row: a.row)),
      ], ""))
  }
}

// THE SITE (operator, 2026-10-04): New York City, expected 120 V. NVIDIA's own MGX GH200 node lists
// "2x IEC C13 to NMEA 5-15P Power Cables (Standard 15A rated)" as required (GH200 SuperChip MGX System
// Quick Start Guide, DU-11592-001_04, Table 2), so 120 V operation is NVIDIA-supported for that
// system -- across TWO supplies on two cords. That is a different carrier and supply than this one, so
// it frames the question rather than answering it.
data site_ac_obligation: String = "confirm the outlet voltage and circuit rating at the operator's NYC site (expected 120 V; a 15 A circuit carries 1440 W continuous under the NEC 80% rule) and read the chosen PSU's output rating at 120 V, where server supplies commonly derate; this module's startup and default draw is not documented, so the circuit plan cannot rest on a limit applied by the OS after boot; NVIDIA's MGX GH200 node draws from two NEMA 5-15 cords"

// THE MANAGEMENT LEAD (operator-supplied photographs and a review, 2026-10-04): a separately sold
// "GH200控制器" (GH200 controller) I/O board, and a listing selling it together with a plug-in module
// labeled HMC. The P4261 has no network, USB, video or console connector. NVIDIA's MGX GH200 quick
// start describes a BMC with KVM and Serial-over-LAN and names no HMC, so which part of this pair is
// the management controller is open. Modular management is a recognized architecture (OCP DC-SCM; a
// Supermicro GH200 board lists DC-SCM support), which makes the lead plausible without showing that
// P4261 implements it. Kept as a lead inside the obligation: no part of the pair has been seen
// connected to a P4261.
data controller_card_lead: String = "Management dependency unresolved; boot not demonstrated -- the absence of a BMC on the carrier would not establish that the assembly cannot boot, and its presence elsewhere is not yet shown. Candidate: the 'GH200 controller' I/O board (RJ45, RJ45 + 2x USB 3, VGA, M.2, micro-USB) sold together with a separate heatsinked plug-in module labeled HMC (eBay item 398282181791, 'NVIDIA GH200 Controller & HMC Baseboard', no part number, no technical support); the management function may live on the plug-in module with the I/O board as its carrier. Owed: whether the set includes the HMC module and its firmware, which RJ45 serves which function, its power, and the cable and connector family (MCIO or SlimSAS) joining it to the slotless P4261. Do not buy the bare I/O board on the assumption that its RJ45 ports are a complete BMC"

fn assembly_gates(a: SuperchipAssembly) -> List<StageGate> {
  [
    StageGate { stage: MechanicallyMated, requirements: [
      mating_requirement(a: a),
      bench_requirement(requirement: "mounting and support stack", reading: a.bench.mounting_stack, obligation: "the module's standoffs, backing plate and fasteners with their preload, as fitted in its original system; no powered insertion or reseating"),
    ] },
    StageGate { stage: SafeToEnergize, requirements: [
      bench_requirement(requirement: "power path", reading: a.bench.power_path, obligation: power_path_obligation(a: a)),
      bench_requirement(requirement: "site AC supply", reading: a.bench.site_ac_supply, obligation: site_ac_obligation),
      bench_requirement(requirement: "thermal path for every heat region", reading: a.bench.thermal_path, obligation: thermal_obligation(a: a)),
      bench_requirement(requirement: "protective shutdown", reading: a.bench.protective_shutdown, obligation: "over-temperature shutdown, and loss-of-flow shutdown if liquid-cooled, verified before first power-on; default thermal trip settings retained; pumps and fans fed from a verified supply rather than an unidentified carrier header"),
    ] },
    StageGate { stage: BootQualified, requirements: [
      bench_requirement(requirement: "management and boot path", reading: a.bench.management_path, obligation: join(["whether ", carrier_label(c: a.carrier), " carries its own BMC, firmware storage, console and power-control path or needs boards from its original system: ", management_io_text(layout: a.carrier.layout), ", and carries ", edge_connector_text(layout: a.carrier.layout), ". ", reference_management_pattern(c: asrock_rack_arlington_mb), ". ", controller_card_lead], "")),
      bench_requirement(requirement: "boot storage", reading: a.bench.boot_storage, obligation: join(["a boot device the Grace CPU can reach through ", carrier_label(c: a.carrier), " (an M.2 slot, such as the controller card's, or NVMe behind one of the carrier's PCIe connectors) holding an arm64 OS image the module firmware accepts"], "")),
      boot_requirement(a: a),
      inventory_requirement(a: a),
    ] },
    StageGate { stage: WorkloadQualified, requirements: [
      bench_requirement(requirement: "module-scope power limit", reading: a.bench.module_power_limit, obligation: "nvidia-smi -q -d POWER reports module-scope readings and a module limit (-sc 1) is accepted and holds under load on this qualification-sample module"),
      bench_requirement(requirement: "served workload", reading: a.bench.served_workload, obligation: "the target model served at acceptable throughput, with its weight and KV placement across HBM and LPDDR5X observed rather than assumed; a second assembly reached over the network is a separate memory domain, not NVLink peer memory, and two-node behavior is its own demonstration"),
    ] },
  ]
}

type AssemblyQualification
  = AssemblyWorkloadQualified { evidence: List<NonEmptyStr> }
  | AssemblyBlockedAt { stage: QualificationStage, open_here: List<NonEmptyStr>, open_later: List<NonEmptyStr> }
  | AssemblyRefusedAt { stage: QualificationStage, reasons: List<NonEmptyStr> }

fn requirement_line(r: QualificationRequirement, detail: NonEmptyStr) -> NonEmptyStr {
  join([r.requirement as String, ": ", detail as String], "") as NonEmptyStr
}

fn gate_contradictions(g: StageGate) -> List<NonEmptyStr> {
  flat_map(g.requirements, r => match r.standing {
    EvidenceContradicted { reason: x } => [requirement_line(r: r, detail: x)]
    _ => []
  })
}

fn gate_open(g: StageGate) -> List<NonEmptyStr> {
  flat_map(g.requirements, r => match r.standing {
    EvidenceUndetermined { obligation: o } => [requirement_line(r: r, detail: o)]
    _ => []
  })
}

fn gate_evidence(g: StageGate) -> List<NonEmptyStr> {
  flat_map(g.requirements, r => match r.standing {
    EvidenceVerified { evidence: e } => [requirement_line(r: r, detail: e)]
    _ => []
  })
}

// A CONTRADICTION ANYWHERE REFUSES, at the earliest stage that carries one: an assembly whose cooling
// is shown impossible will not qualify however its connectors read. Otherwise the assembly stands at
// the first stage with an open requirement, and the later stages' open requirements are listed beside
// it -- they are the rest of the bench plan, not evidence that any later stage has passed.
fn assembly_qualification(a: SuperchipAssembly) -> AssemblyQualification {
  let gates = assembly_gates(a: a)
  match (filter(gates, g => count(gate_contradictions(g: g)) > 0)).first() {
    Present { value: g } => AssemblyRefusedAt { stage: g.stage, reasons: gate_contradictions(g: g) }
    Absent =>
      match (filter(gates, g => count(gate_open(g: g)) > 0)).first() {
        Present { value: g } => AssemblyBlockedAt {
          stage: g.stage,
          open_here: gate_open(g: g),
          open_later: flat_map(filter(gates, h => stage_after(a: h.stage, b: g.stage)), h => gate_open(g: h)),
        }
        Absent => AssemblyWorkloadQualified { evidence: flat_map(gates, g => gate_evidence(g: g)) }
      }
  }
}

fn stage_rank(s: QualificationStage) -> Nat {
  match s {
    MechanicallyMated => 0
    SafeToEnergize => 1
    BootQualified => 2
    WorkloadQualified => 3
  }
}

fn stage_after(a: QualificationStage, b: QualificationStage) -> Bool {
  stage_rank(s: a) > stage_rank(s: b)
}

// ── THE PURCHASE ─────────────────────────────────────────────────────────────────────────────
//
// As bought (operator, 2026-10-04): two DV5 96GB modules and one P4261 rev K1 carrier. One assembly
// exists, and it is the one the bench qualifies; the second module waits for a second carrier, which is
// not bought until this assembly has shown the carrier works. (The 80GB DV2 listing and the H1 carrier
// were considered and not bought, so they are not modeled.)
data first_assembly: SuperchipAssembly = SuperchipAssembly {
  unit: gh200_dv5_unit,
  carrier: p4261_k1_carrier,
  row: nvidia_gh200_480gb_catalog,
  bench: bench_unread,
}

data planned_assemblies: List<SuperchipAssembly> = [first_assembly]

// Modules held with no carrier. A second assembly is planned from these once a carrier is bought.
data unpaired_modules: List<SuperchipUnitObservation> = [gh200_dv5_second_unit]

fn assembly_report_lines(a: SuperchipAssembly) -> List<String> {
  let head = join([a.unit.board_part_number as String, " on ", carrier_label(c: a.carrier)], "")
  match assembly_qualification(a: a) {
    AssemblyWorkloadQualified { evidence: _ } => [join([head, ": workload-qualified"], "")]
    AssemblyRefusedAt { stage: s, reasons: rs } =>
      concat([join([head, ": REFUSED at ", qualification_stage_label(stage: s) as String], "")], map(rs, r => join(["  x ", r as String], "")))
    AssemblyBlockedAt { stage: s, open_here: here, open_later: later } =>
      concat(
        concat([join([head, ": blocked at ", qualification_stage_label(stage: s) as String], "")], map(here, o => join(["  - ", o as String], ""))),
        concat(["  then:"], map(later, o => join(["  - ", o as String], ""))),
      )
  }
}

// THE BENCH PLAN, for the operator:
//   gunbc run --source-root dag --source-root src/v2 --entry dag/gunbc/product/superchip_assembly_qualification.dag --function assembly_qualification_report
// Exit 0 only when some planned assembly is workload-qualified; otherwise exit 1 with every assembly's
// open requirements, stage by stage.
fn unpaired_line(u: SuperchipUnitObservation) -> String {
  join([u.board_part_number as String, ": held, no carrier yet (", u.source as String, ")"], "")
}

fn assembly_qualification_report() -> ProcessExit {
  let qualified = filter(planned_assemblies, a => match assembly_qualification(a: a) {
    AssemblyWorkloadQualified { evidence: _ } => true
    _ => false
  })
  if count(qualified) > 0 {
    ExitSuccess
  } else {
    exit_failure(reason: join(concat(flat_map(planned_assemblies, a => assembly_report_lines(a: a)), map(unpaired_modules, u => unpaired_line(u: u))), "\n"))
  }
}
