module product.node_power_envelope

import std.types { Bool, EpochMs, Int, List, NonEmptyStr }
import std.nat { Nat }
import std.measure {
  Bandwidth,
  ByteSize,
  MegatransfersPerSecond,
  Milliwatt,
  Percent,
  Watt,
  bandwidth_count,
  bit_width_count,
  bits_per_byte,
  byte_size,
  byte_size_count,
  mega_factor,
  megatransfers_per_second,
  megatransfers_per_second_count,
  milliwatt,
  milliwatt_count,
  milliwatt_to_watt_floor,
  percent,
  percent_count,
  watt,
  watt_count,
}
import extdeps.external_authority {
  ExternalAuthority,
  CitedFigureStanding,
  CeilingCitedToAuthority,
  CeilingTranscribedUncited,
  cited_figure_is_cited,
}
import extdeps.cpu.types { CpuModelCatalogRow }
import extdeps.memory.types {
  DramModuleCatalogRow,
  dram_chips_per_rank,
  dram_data_word_width,
}
import extdeps.cpu.ampere_altra_platform_hw_design.platform { dimms_per_channel_count }
import gunbc.memory_provisioning {
  FullChannel,
  MemoryChannelGeometry,
  PartialChannel,
  PopulationOption,
}

// WHAT A NODE DRAWS AND WHAT ITS MEMORY DELIVERS — the electrical and bandwidth half of a build,
// kept apart from what the build COSTS (product.build_fulfillment). They answer different questions;
// fusing them was the shape of the deleted product.hardware_selection, where a candidate record
// carried a synthetic price beside a real wall-draw and neither could be used without the other.
//
// RELOCATED, NOT REWRITTEN (2026-08-19). effective_data_rate_mts, memory_bandwidth, memory_power,
// the DC/AC wall-draw pair and psu_is_adequate came from product.hardware_selection when it was
// deleted at the root. What changed is their INPUTS: a cited PopulationOption from
// gunbc.memory_provisioning and a cited CpuModelCatalogRow replace the deleted module's
// hand-authored Platform/CpuCandidate/MemoryConfig records, so a population this repository refuses
// upstream cannot be priced electrically here. The physics and its witnesses did not change.
//
// NO PRICES LIVE HERE, and no candidate records. A power envelope is a fact about hardware; a
// candidate is a decision about buying it.

// --- the memory channel context this module needs ----------------------------------------------

// WHAT THIS MODULE ADDS TO THE UPSTREAM GEOMETRY, AND NOTHING ELSE. Channel count, admitted
// topology and DRAM generation are already gunbc.memory_provisioning's MemoryChannelGeometry, so
// they are referenced, not restated — a second channels field would be two authorities for one
// fact. The new fact is the platform's rated transfer rate, an electrical figure the population
// derivation has no reason to carry.
//
// The POPULATED depth is not a field either: it is a property of the chosen population, read from
// that population's coverage below. A board with two DIMMs per channel populated one-deep is
// electrically one-deep, and the only authority for which happened is the PopulationOption.
type MemoryElectricalContext {
  geometry: MemoryChannelGeometry
  max_data_rate: MegatransfersPerSecond
  two_dpc_ceilings: TwoDpcRateCeilingTable
}

// THE 2DPC DERATING TABLE, AND ITS EVIDENCE STANDING BESIDE IT. These ceilings arrived with the
// physics relocated from the deleted product.hardware_selection, where they were uncited literals.
// Moving them into extdeps/ under the citation duty needs an authority actually read, and the Altra
// platform module's coverage note says it transcribes running text and NOT tables — exactly what a
// derating table is. Minting a citation there would be the fabricated-symbol defect its notes exist
// to prevent.
//
// So the figures are carried where consumed, with their uncitedness TYPED rather than invisible: a
// consumer can ask whether the ceiling it used is grounded, and the read obligation names what
// would ground it. A declared boundary fact, not a silent constant.
type RateCeilingEvidence = CitedFigureStanding

type TwoDpcRateCeiling {
  min_rank_count: Nat
  ceiling: MegatransfersPerSecond
  evidence: RateCeilingEvidence
}

type TwoDpcRateCeilingTable {
  rows: List<TwoDpcRateCeiling>
}

fn ceiling_is_cited(evidence: RateCeilingEvidence) -> Bool {
  cited_figure_is_cited(standing: evidence)
}

// The ceilings held today, all uncited. One declaration so the population is countable and a later
// citation edits one row rather than hunting literals.
data altra_two_dpc_ceilings: TwoDpcRateCeilingTable = TwoDpcRateCeilingTable {
  rows: [
    TwoDpcRateCeiling {
      min_rank_count: 4,
      ceiling: megatransfers_per_second(count: 2400),
      evidence: CeilingTranscribedUncited {
        read_obligation: "cite the platform or JEDEC DDR4 two-DIMM-per-channel derating table for quad-rank modules; transcribed from the deleted product.hardware_selection, which carried it as a bare literal",
      },
    },
    TwoDpcRateCeiling {
      min_rank_count: 2,
      ceiling: megatransfers_per_second(count: 2933),
      evidence: CeilingTranscribedUncited {
        read_obligation: "cite the platform or JEDEC DDR4 two-DIMM-per-channel derating table for dual-rank modules; transcribed from the deleted product.hardware_selection, which carried it as a bare literal",
      },
    },
  ],
}

// A full-channel population is as deep as its topology says; a partial one has
// dark channels and the populated ones are single-deep, which is what
// documented_coverage means by PartialChannel.
fn populated_dimms_per_channel(population: PopulationOption) -> Nat {
  match population.coverage {
    FullChannel { topology: t } => dimms_per_channel_count(topology: t)
    PartialChannel { channels_populated: _, channels_dark: _ } => 1
  }
}

// THE 2DPC DOWNCLOCK, and it is rank-dependent. A second module on a channel loads the bus by an
// amount depending on how many ranks it presents: a single-rank pair keeps the platform's rated
// speed while a quad-rank pair falls to 2400 MT/s. These are the platform's published 2DPC table.
fn min_nat(a: Nat, b: Nat) -> Nat {
  if a < b { a } else { b }
}

fn min_rate(a: MegatransfersPerSecond, b: MegatransfersPerSecond) -> MegatransfersPerSecond {
  megatransfers_per_second(
    count: min_nat(a: megatransfers_per_second_count(r: a), b: megatransfers_per_second_count(r: b)),
  )
}

// The deepest ceiling any row applies to this rank count. A fold over the table, not a literal
// ladder, so a third derating row is data, not a new branch — and the table above is genuinely the
// authority for the numbers.
fn ceiling_for_ranks(
  table: TwoDpcRateCeilingTable,
  rated: MegatransfersPerSecond,
  rank_count: Nat,
) -> MegatransfersPerSecond {
  fold(table.rows, init: rated, f: fn(acc, row) {
    if rank_count >= row.min_rank_count { min_rate(a: acc, b: row.ceiling) } else { acc }
  })
}

fn effective_data_rate(
  context: MemoryElectricalContext,
  dimms_per_channel: Nat,
  rank_count: Nat,
) -> MegatransfersPerSecond {
  if dimms_per_channel <= 1 {
    context.max_data_rate
  } else {
    ceiling_for_ranks(
      table: context.two_dpc_ceilings,
      rated: context.max_data_rate,
      rank_count: rank_count,
    )
  }
}

fn dram_channel_bus_bytes() -> ByteSize {
  byte_size(count: bit_width_count(b: dram_data_word_width) / bits_per_byte())
}

// A second rank per channel lets the controller interleave, so a rank-starved
// population does not reach the bus's rated throughput even at its rated clock.
fn rank_interleave_percent(rank_count: Nat) -> Percent {
  if rank_count >= 2 { percent(count: 100) } else { percent(count: 90) }
}

// The platform downclocks to the SLOWEST module present, so the rated figure is
// the minimum of what the module can do and what the topology admits.
fn memory_bandwidth(
  context: MemoryElectricalContext,
  population: PopulationOption,
) -> Bandwidth {
  let module = population.module
  let rated = min_nat(
    a: module.data_rate_mts,
    b: megatransfers_per_second_count(
      r: effective_data_rate(
        context: context,
        dimms_per_channel: populated_dimms_per_channel(population: population),
        rank_count: module.rank_count,
      ),
    ),
  )
  let interleaved = rated * percent_count(p: rank_interleave_percent(rank_count: module.rank_count)) / 100
  Bandwidth {
    count: interleaved
      * mega_factor()
      * byte_size_count(b: dram_channel_bus_bytes())
      * context.geometry.channels,
  }
}

fn devices_per_stick(module: DramModuleCatalogRow) -> Nat {
  dram_chips_per_rank(module: module) * module.rank_count
}

fn memory_power(
  population: PopulationOption,
  power_per_chip: Milliwatt,
) -> Watt {
  milliwatt_to_watt_floor(
    w: milliwatt(
      count: milliwatt_count(w: power_per_chip)
        * devices_per_stick(module: population.module)
        * population.dimm_count,
    ),
  )
}

// --- the whole node --------------------------------------------------------------------------

type EfficiencyRating = Plus80 | Bronze | Silver | Gold | Platinum | Titanium

// 80 PLUS IS AN EXTERNAL PROGRAM AND THIS TABLE IS A SIMPLIFICATION OF IT. The program certifies
// efficiency at FOUR load points (10, 20, 50 and 100 percent) and two input voltages, so one figure
// per rating is at best the 50-percent-load 115 V column — the figures below arrived as uncited
// literals with the physics relocated from the deleted product.hardware_selection.
//
// The consequence is real: a node idling at 15 percent of its supply's rating is materially less
// efficient than this table says, so the derived wall figure is optimistic for a lightly loaded
// machine. That is why the measured arm of this module exists, and why the divergence is reported
// signed rather than reconciled.
//
// DISSOLVES ON: the 80 PLUS specification cited in extdeps/ with its load-point table, at which
// point efficiency becomes a function of load rather than of rating alone.
fn efficiency_percent(e: EfficiencyRating) -> Percent {
  match e {
    Plus80 => percent(count: 80)
    Bronze => percent(count: 85)
    Silver => percent(count: 88)
    Gold => percent(count: 90)
    Platinum => percent(count: 92)
    Titanium => percent(count: 94)
  }
}

// A POPULATION WHOSE EXACT PART IS NOT YET READ IS A REAL STATE OF A REAL PURCHASE — the state of
// the operator's pending configuration now: eight 64 GiB RDIMMs are arriving and the part number
// has not been read. Capacity is answerable (the sticks state it) but DRAW IS NOT, because chip
// count per rank comes from the module's data width and rank count, and a 64 GiB DDR4 module can be
// 2Rx4, 4Rx4 or a stacked-die part with materially different device counts.
//
// So this is a coproduct, not an optional field, and the unread arm carries what IS known plus the
// obligation that closes it. Assuming 2Rx4 to keep the arithmetic runnable would be fabricated
// plausible output at its most expensive: the figure feeds a power allocation, and a wrong one is
// not discovered until the rack is energised.
type MemoryPopulationEvidence
  = PopulationModuleRead { population: PopulationOption }
  | PopulationModuleUnread {
      stick_capacity: ByteSize
      dimm_count: Nat
      read_obligation: NonEmptyStr
    }

// A node's electrical inputs. Board idle draw and per-chip DRAM power are declared by the caller
// because this repository cites no row for either yet; naming them as fields keeps them visible as
// the two figures a reader must supply rather than a default buried in the arithmetic.
type NodeElectricalInputs {
  label: NonEmptyStr
  sockets: Nat
  cpu: CpuModelCatalogRow
  context: MemoryElectricalContext
  memory: MemoryPopulationEvidence
  dram_power_per_chip: Milliwatt
  board_idle_draw: Watt
  psu_rated_output: Watt
  psu_efficiency: EfficiencyRating
}

// WHY THE REFUSAL IS TYPED AND NOT A ZERO. A node whose memory draw could not be derived does not
// draw only its processor: a CPU-plus-board figure is an answer a placement decision would happily
// divide a power budget by. The refusal names the obligation, so the missing read is countable and
// actionable rather than absorbed.
type DrawRefusalCause
  = MemoryModuleUnread {
      stick_capacity: ByteSize
      dimm_count: Nat
      read_obligation: NonEmptyStr
    }

type NodeDrawReading
  = NodeDrawDerived { dc_load: Watt, wall_draw: Watt }
  | NodeDrawRefused { cause: DrawRefusalCause }

fn memory_evidence_refusal(memory: MemoryPopulationEvidence) -> DrawRefusalCause? {
  match memory {
    PopulationModuleRead { population: _ } => none
    PopulationModuleUnread { stick_capacity: c, dimm_count: n, read_obligation: o } =>
      Present {
        value: MemoryModuleUnread { stick_capacity: c, dimm_count: n, read_obligation: o },
      }
  }
}

// CPU draw is the catalog TDP, once per socket. An earlier home took a hand-authored 'typical_draw'
// beside the catalog row — a second representation of one fact; TDP is what the vendor states and
// what this reads.
fn cpu_draw_watts(inputs: NodeElectricalInputs) -> Watt {
  watt(count: watt_count(w: inputs.cpu.tdp_watts) * inputs.sockets)
}

// The arithmetic over a READ population. Total, and reached only through
// node_draw below, which is where the unread arm is refused.
fn dc_load_over_read_population(inputs: NodeElectricalInputs, population: PopulationOption) -> Watt {
  watt(
    count: watt_count(w: cpu_draw_watts(inputs: inputs))
      + watt_count(w: memory_power(population: population, power_per_chip: inputs.dram_power_per_chip)) * inputs.sockets
      + watt_count(w: inputs.board_idle_draw),
  )
}

fn wall_from_dc(dc: Watt, efficiency: EfficiencyRating) -> Watt {
  watt(count: watt_count(w: dc) * 100 / percent_count(p: efficiency_percent(e: efficiency)))
}

fn node_draw(inputs: NodeElectricalInputs) -> NodeDrawReading {
  match inputs.memory {
    PopulationModuleUnread { stick_capacity: c, dimm_count: n, read_obligation: o } =>
      NodeDrawRefused {
        cause: MemoryModuleUnread { stick_capacity: c, dimm_count: n, read_obligation: o },
      }
    PopulationModuleRead { population: p } => {
      let dc = dc_load_over_read_population(inputs: inputs, population: p)
      NodeDrawDerived { dc_load: dc, wall_draw: wall_from_dc(dc: dc, efficiency: inputs.psu_efficiency) }
    }
  }
}

// PSU ADEQUACY IS A TYPED VERDICT CARRYING BOTH NUMBERS, not a Bool. A false
// tells a buyer nothing about which supply to buy instead, and the headroom is
// exactly the figure the next decision needs.
type PsuAdequacy
  = PsuAdequate { dc_load: Watt, rated: Watt, headroom: Watt }
  | PsuUndersized { dc_load: Watt, rated: Watt, shortfall: Watt }
  | PsuUndecidable { cause: DrawRefusalCause }

fn psu_adequacy_for_load(load: Watt, rated: Watt) -> PsuAdequacy {
  if watt_count(w: load) <= watt_count(w: rated) {
    PsuAdequate {
      dc_load: load,
      rated: rated,
      headroom: watt(count: watt_count(w: rated) - watt_count(w: load)),
    }
  } else {
    PsuUndersized {
      dc_load: load,
      rated: rated,
      shortfall: watt(count: watt_count(w: load) - watt_count(w: rated)),
    }
  }
}

// A supply cannot be judged adequate for a load nobody could compute, and it
// must not be judged adequate for the load MINUS its memory either.
fn psu_adequacy(inputs: NodeElectricalInputs) -> PsuAdequacy {
  match node_draw(inputs: inputs) {
    NodeDrawRefused { cause: c } => PsuUndecidable { cause: c }
    NodeDrawDerived { dc_load: dc, wall_draw: _ } =>
      psu_adequacy_for_load(load: dc, rated: inputs.psu_rated_output)
  }
}

// --- derived and observed are two facts of the same shape --------------------------------------

// THE MEASUREMENT SEAM. Once a host is built and qualified, someone puts a meter on it, and that
// number is a DIFFERENT FACT from the one derived above — same units, same shape, different
// epistemic standing. Neither overwrites the other: a derived figure that disagrees with a
// measurement is not corrected by deletion; the disagreement locates a modelling error the next
// node will repeat.
//
// So a reading carries its provenance, and the comparison below reports the divergence rather than
// reconciling it. There is deliberately no function taking a measurement and returning a corrected
// derivation.
type WallPowerReading
  = WallPowerDerived { watts: Watt }
  | WallPowerMeasured { watts: Watt, host: NonEmptyStr, observed_at: EpochMs }

fn reading_watts(reading: WallPowerReading) -> Watt {
  match reading {
    WallPowerDerived { watts: w } => w
    WallPowerMeasured { watts: w, host: _, observed_at: _ } => w
  }
}

// The divergence is signed and named in both directions, because over- and under-prediction have
// different causes and remedies: reading high is usually a TDP standing in for a typical draw;
// reading low usually means a component the model does not carry at all.
type EnvelopeDivergence
  = EnvelopeAgrees { watts: Watt }
  | DerivationReadsHigh { derived: Watt, measured: Watt, excess: Watt }
  | DerivationReadsLow { derived: Watt, measured: Watt, shortfall: Watt }
  | DivergenceNotComparable

fn envelope_divergence(derived: WallPowerReading, measured: WallPowerReading) -> EnvelopeDivergence {
  match derived {
    WallPowerMeasured { watts: _, host: _, observed_at: _ } => DivergenceNotComparable
    WallPowerDerived { watts: d } =>
      match measured {
        WallPowerDerived { watts: _ } => DivergenceNotComparable
        WallPowerMeasured { watts: m, host: _, observed_at: _ } =>
          if watt_count(w: d) == watt_count(w: m) {
            EnvelopeAgrees { watts: d }
          } else if watt_count(w: d) > watt_count(w: m) {
            DerivationReadsHigh {
              derived: d,
              measured: m,
              excess: watt(count: watt_count(w: d) - watt_count(w: m)),
            }
          } else {
            DerivationReadsLow {
              derived: d,
              measured: m,
              shortfall: watt(count: watt_count(w: m) - watt_count(w: d)),
            }
          }
      }
  }
}

type DerivedWallPower
  = DerivedWallPowerReading { reading: WallPowerReading }
  | DerivedWallPowerRefused { cause: DrawRefusalCause }

fn derived_wall_power(inputs: NodeElectricalInputs) -> DerivedWallPower {
  match node_draw(inputs: inputs) {
    NodeDrawRefused { cause: c } => DerivedWallPowerRefused { cause: c }
    NodeDrawDerived { dc_load: _, wall_draw: w } =>
      DerivedWallPowerReading { reading: WallPowerDerived { watts: w } }
  }
}

// --- capacity, for the projector -----------------------------------------------------------------

// CAPACITY ANSWERS EVEN WHEN DRAW REFUSES, and the asymmetry is the point: a stick states its
// capacity on the label, so an unread part number costs nothing here — while the device count that
// decides draw is exactly what the part number carries. Two questions, two evidence requirements,
// answered independently.
fn node_memory_capacity(inputs: NodeElectricalInputs) -> ByteSize {
  match inputs.memory {
    PopulationModuleRead { population: p } =>
      byte_size(count: byte_size_count(b: p.total_bytes) * inputs.sockets)
    PopulationModuleUnread { stick_capacity: c, dimm_count: n, read_obligation: _ } =>
      byte_size(count: byte_size_count(b: c) * n * inputs.sockets)
  }
}
