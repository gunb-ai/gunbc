module product.acoustic_ceiling

import std.types { Bool, Int, List, NonEmptyStr }
import std.measure { FanCount, Percent, PublishedLevelCount, fan_count_value, measure_le }
import extdeps.units.iec_61672 { AWeightedLevelDifference, AWeightedSoundPressureLevel, dba_le, dba_level_minus }
import extdeps.fans.types {
  FanCatalogRow,
  FanPublishedOperatingPoint,
  fan_published_level_count,
}
import product.placement_supply { SiteIdentity }

// A CEILING ON HOW LOUD A SITE MAY GET, OWNED ABOVE ANY FLEET AND ABOVE ANY FAN.
//
// This module exists because the constraint it carries is not a fact about a machine. A room has an
// occupant, and what that occupant will tolerate is a policy they state, not a property anything
// measures. Modelling it as a field on a host would make it a machine attribute; modelling it inside
// the fan-policy module would make it reachable only through fans, when the same ceiling bounds
// anything in the room that moves air.

// WHERE A LEVEL IS STATED, AND WHY THE TWO POSITIONS MAY NOT BE COMPARED.
//
// THE DATASHEET ARM IS NAMED FOR THE DATASHEET AND NOT FOR A DISTANCE, DELIBERATELY. An earlier
// draft called it OneMetreFreeFieldDatasheet, which asserts a measurement condition that many
// vendors do not publish - extdeps.fans.dynatron records exactly that gap for the DF126025BU-PWMH.
// The arm's content is "this is the level the vendor printed, under whatever conditions the vendor
// used", and naming a distance inside it would have smuggled a condition into the type.
//
// extdeps.fans.types is explicit that a published fan level is NOT what a person would hear:
// ducting, grilles, panels, the chassis and the wall all sit between the fan and the ear. A vendor's
// figure is measured at one metre in a free field with nothing in the way; a ceiling an operator
// states is about the room they are standing in. Those are different quantities that share a unit,
// which is exactly the case where sharing a type produces a silently wrong comparison.
//
// So the position is part of the ceiling, and the comparison function below REFUSES a cross-position
// comparison rather than performing it. That is the whole structural content of this type: it exists
// to make the wrong comparison unwritable at the one place a consumer would write it.
type AcousticReferencePosition
  = FanDatasheetPosition
  | SiteListeningPosition

// HOW A CEILING CAME TO BE. An operator's tolerance is a POLICY: it is a decision, it can change,
// and no instrument produced it. A measured ceiling is a reading at a position with an instrument
// named. Keeping them in one type with a marker field would let a consumer drop the marker; keeping
// them as arms means a consumer that wants to treat them alike has to say so.
type AcousticCeilingBasis
  = OperatorStatedTolerance { statement: NonEmptyStr }
  | MeasuredAtPosition { instrument: NonEmptyStr }

type AcousticCeiling {
  site: SiteIdentity
  level: AWeightedSoundPressureLevel
  position: AcousticReferencePosition
  basis: AcousticCeilingBasis
}

// THE COMPARISON, AND ITS ONE REFUSAL. A level and a ceiling stated at different positions produce
// AcousticPositionsIncomparable, never a verdict. An optional Bool would have collapsed that into
// 'no answer', which reads to a caller as 'unknown' when the real content is 'you asked a question
// that has no answer as posed'.
type AcousticComparison
  = AcousticWithinCeiling
  | AcousticOverCeiling { over_by: AWeightedLevelDifference }
  | AcousticPositionsIncomparable

fn acoustic_positions_match(a: AcousticReferencePosition, b: AcousticReferencePosition) -> Bool {
  match a {
    FanDatasheetPosition => match b {
      FanDatasheetPosition => true
      SiteListeningPosition => false
    }
    SiteListeningPosition => match b {
      FanDatasheetPosition => false
      SiteListeningPosition => true
    }
  }
}

fn acoustic_level_against_ceiling(
  level: AWeightedSoundPressureLevel,
  at: AcousticReferencePosition,
  ceiling: AcousticCeiling,
) -> AcousticComparison {
  if !acoustic_positions_match(a: at, b: ceiling.position) {
    AcousticPositionsIncomparable
  } else if dba_le(a: level, b: ceiling.level) {
    AcousticWithinCeiling
  } else {
    AcousticOverCeiling { over_by: dba_level_minus(a: level, b: ceiling.level) }
  }
}

// DERIVING A DUTY CEILING FROM AN ACOUSTIC ONE, WITHOUT INVENTING A CURVE.
//
// A controller is set in duty, and a person hears dBA. The bridge between them is the fan's own
// published table, and extdeps.fans.types deliberately refuses to interpolate between published
// points because doing so needs a logarithm this substrate has no builtin for. This function
// inherits that refusal rather than working around it: it selects the HIGHEST published duty whose
// published level is at or below the ceiling, and if the table offers no such point it refuses.
//
// WHY THE HIGHEST AND NOT THE LOWEST. The ceiling is a bound, not a target. Answering with the
// quietest point would silently also answer a cooling question nobody asked, and would starve a
// machine of airflow it could have had inside the same acoustic budget.
//
// WHAT THIS DOES NOT ESTABLISH, and the reason the refusal arm names the count: the derived duty is
// admissible for ONE fan at the datasheet position. A chassis with six of them is louder than one of
// them, and combining levels is a power-domain fold with no builtin here - so a multi-fan site
// ceiling may not be discharged by this function, and DutyCeilingMultipleFansUnpriced says so
// instead of returning a number that would be wrong by the fan count.
type DutyCeilingResult
  = DutyCeilingPublished { duty: Percent, level: AWeightedSoundPressureLevel }
  | DutyCeilingNoPublishedPointWithin { published_level_count: PublishedLevelCount }
  | DutyCeilingPositionIncomparable
  | DutyCeilingMultipleFansUnpriced { fan_count: FanCount }

fn published_point_within_ceiling(
  point: FanPublishedOperatingPoint,
  ceiling: AcousticCeiling,
) -> Bool {
  match point.sound_pressure {
    none => false
    Present { value: level } => dba_le(a: level, b: ceiling.level)
  }
}

fn higher_duty_point(
  a: FanPublishedOperatingPoint,
  b: FanPublishedOperatingPoint,
) -> FanPublishedOperatingPoint {
  if measure_le(a: a.duty, b: b.duty) { b } else { a }
}

fn points_within_ceiling(
  row: FanCatalogRow,
  ceiling: AcousticCeiling,
) -> List<FanPublishedOperatingPoint> {
  filter(row.published_points, p => published_point_within_ceiling(point: p, ceiling: ceiling))
}

// THE none ARM TAKES THE ROW SO IT CANNOT FABRICATE A ZERO. It is unreachable today - every caller
// arrives through points_within_ceiling, which admits only points whose sound_pressure is Present -
// but an unreachable arm that reports "this row publishes no levels" about a row that publishes
// three is a wrong answer waiting for the filter to change, and the count is the one fact that arm
// exists to carry. Taking the row means the refusal reports the row's real evidence size whether or
// not anybody ever reaches it.
fn duty_ceiling_of_result(
  row: FanCatalogRow,
  point: FanPublishedOperatingPoint,
) -> DutyCeilingResult {
  match point.sound_pressure {
    none => DutyCeilingNoPublishedPointWithin { published_level_count: fan_published_level_count(row: row) }
    Present { value: level } => DutyCeilingPublished { duty: point.duty, level: level }
  }
}

// ONE FAN, ONE DATASHEET POSITION. The fan_count parameter is required rather than defaulted so a
// caller with six fans cannot reach the single-fan answer by omission.
fn duty_ceiling_for_fan(
  row: FanCatalogRow,
  ceiling: AcousticCeiling,
  fan_count: FanCount,
) -> DutyCeilingResult {
  if !acoustic_positions_match(a: FanDatasheetPosition, b: ceiling.position) {
    DutyCeilingPositionIncomparable
  } else if fan_count_value(c: fan_count) != 1 {
    DutyCeilingMultipleFansUnpriced { fan_count: fan_count }
  } else {
    let within = points_within_ceiling(row: row, ceiling: ceiling)
    if within.length() == 0 {
      DutyCeilingNoPublishedPointWithin { published_level_count: fan_published_level_count(row: row) }
    } else {
      match within.first() {
        Absent => DutyCeilingNoPublishedPointWithin { published_level_count: fan_published_level_count(row: row) }
        Present { value: head } => duty_ceiling_of_result(
          row: row,
          point: fold(within.skip(n: 1), init: head, f: (acc, p) => higher_duty_point(a: acc, b: p)),
        )
      }
    }
  }
}
