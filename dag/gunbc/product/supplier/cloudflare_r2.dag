import std.roster_frontier { FrontierRow, frontier_row_decl }
import std.dissolution { unbound_dissolution }
import std.content_hash { as_content_hash_structural, content_hash_atom, content_hash_combine_structural, Fnv1a64Structural }
import product.fabric.provider_route {
  ProviderRoute, ProviderRouteFacts,
  ProviderDataPathClosure, ProviderPathUnread,
  DownstreamProviderPopulation, DownstreamProvidersUnread,
  ProviderRegionObservation, ProviderRegionUnread,
  ProviderRouteStanding, ProviderRouteObserved, ProviderRouteRegionUnobserved,
  provider_route_from_region,
}
import extdeps.cloudflare.r2 {
  r2_published_location_readings,
  r2_published_location_citations,
  r2_tokens_doc_as_of,
}
import extdeps.vendor.cloudflare {
  cloudflare_company_document_readings,
  cloudflare_company_document_citations,
}

// THE DURABLE-ORIGIN THIS REPOSITORY ANSWERS THE NINE-PATH CLOSURE FOR. PRODUCTION DOES NOT MINT A ROUTE.
//
// WHAT WAS READ. Cloudflare's R2 data-location page, how-R2-works page, us-jurisdiction changelog,
// tokens page, subprocessors list, Customer DPA v6.4 (2026-09-12), and the Create Bucket /
// Get Bucket API method pages (2026-09-13) were transcribed in
// extdeps.cloudflare.r2. The durable origin in this fleet
// (gunbc.cloudflare.r2_origin fabric_durable_origin_standing, bucket gunbai-fabric-origin) carries
// R2JurisdictionDefault. That module already states that Default is not a data-residency
// commitment this fleet has made. Create Bucket's locationHint is a requested placement; Get
// Bucket's location is a reported location; cf-r2-jurisdiction / Jurisdictional Restrictions are
// the residency guarantee. Those three are not one field. This repository has not queried
// gunbai-fabric-origin's Get Bucket location, so no reported-location observation is minted here.
//
// WHAT PRODUCTION EXECUTES. cloudflare_r2_durable_origin_route_standing is
// ProviderRouteRegionUnobserved carrying cloudflare_r2_region_unread_obligation.
// cloudflare_r2_route_facts_population is therefore empty: there is no origin ProviderRoute, so
// there is no origin row for admit_provider_use. The nine-path closure and downstream population
// are still answered (every path Unread; Absent taken zero times). The admit_provider_use pair
// lives only in the witness, over a route minted in the ProviderRegionRead arm of the same
// coproduct — a synthetic observed region, not this origin.
//
// THE REGION SLOT IS NOT A PLACE TO RECORD AUTOMATIC. product.fabric.provider_route says the
// cited region is where the work actually runs, observed at a declared boundary and never
// fabricated. Automatic placement, as transcribed in r2_data_location_reading, is a CHOICE MECHANISM. product.supplier.ubicloud already
// ruled that shape out: a ProviderRoute is minted ONLY from a read region.

fn cloudflare_r2_provider_ref() -> DeclarationRef {
  decl_ref(module_path: "extdeps.vendor.cloudflare", decl_name: "cloudflare")
}

fn cloudflare_r2_service_ref() -> DeclarationRef {
  decl_ref(module_path: "extdeps.cloudflare.r2", decl_name: "R2S3Endpoint")
}

data cloudflare_r2_region_unread_obligation: NonEmptyStr = "Where this fleet's durable origin actually runs is UNREAD. gunbc.cloudflare.r2_origin fabric_durable_origin_standing places bucket gunbai-fabric-origin under R2JurisdictionDefault. Create Bucket locationHint (r2_create_bucket_location_hint_reading, read 2026-09-13) is a requested placement. Get Bucket location (r2_get_bucket_location_reading, read 2026-09-13) is a reported location. Those are two upstream fields that share location tokens; collapsing them is a section 3 meaning-fork. This repository has not queried gunbai-fabric-origin, so no Get Bucket location is an observation of ours. Automatic and R2JurisdictionDefault are not values of ProviderRoute.region. RESOLVED BY a Get Bucket (or equivalent) observation of this bucket's location field sufficient to name the operating region, or by recreating the origin under a Jurisdictional Restriction that names a jurisdiction — at which point this standing takes ProviderRegionRead with that named location as region. A reported location is not a residency guarantee and is not the nine-path closure. It is NOT resolved by citing r2_placement_automatic, R2JurisdictionDefault, a dashboard Location label, or Create Bucket locationHint."

fn cloudflare_r2_durable_origin_region() -> ProviderRegionObservation {
  ProviderRegionUnread {
    obligation: decl_ref(module_path: "product.supplier.cloudflare_r2", decl_name: "cloudflare_r2_region_unread_obligation"),
  }
}

fn cloudflare_r2_route(region: ProviderRegionObservation) -> ProviderRouteStanding {
  provider_route_from_region(
    provider: cloudflare_r2_provider_ref(),
    service: cloudflare_r2_service_ref(),
    region: region,
  )
}

fn cloudflare_r2_durable_origin_route_standing() -> ProviderRouteStanding {
  cloudflare_r2_route(region: cloudflare_r2_durable_origin_region())
}

// A LOCATION PATH IS CLOSED ONLY BY OPERATOR AND JURISDICTION TOGETHER (DESIGN section 4b(3)).
// Naming an operating entity leaves the jurisdiction unknown; naming a jurisdiction without who
// operates it leaves the operator unknown. Either conjunct can be fully satisfied while the
// question this obligation exists to close stays open — the same defect as a trigger retired by
// affordability alone when the real requirement was affordability AND a passing check. Either
// alone is therefore not a resolution.
data cloudflare_r2_execution_location_obligation: NonEmptyStr = "Where R2 executes object operations for a default-jurisdiction bucket is UNREAD. extdeps.cloudflare.r2 r2_how_r2_works_reading states that the R2 Gateway is deployed across Cloudflare's global network via Cloudflare Workers, close to the user, and that the Gateway then writes to a storage cluster within the location set for the bucket. That is an architecture of a CHOICE, not a location of this fleet's bucket. RESOLVED BY evidence sufficient for this path's OPERATOR AND JURISDICTION both — a Cloudflare statement that names who handles requests for a named default-jurisdiction bucket and the jurisdiction of that handling. Naming an operating entity without a jurisdiction, or a jurisdiction without an operator, does not close this path. It is NOT resolved by R2JurisdictionDefault, by Automatic placement, by Create Bucket locationHint, or by an unqueried Get Bucket location."

data cloudflare_r2_durable_storage_location_obligation: NonEmptyStr = "Where objects in this fleet's durable origin are stored is UNREAD. gunbc.cloudflare.r2_origin fabric_durable_origin_standing places bucket gunbai-fabric-origin under R2JurisdictionDefault. Requested placement, reported location, and residency guarantee are three facts: Create Bucket locationHint (r2_create_bucket_location_hint_reading) is requested placement; Get Bucket location (r2_get_bucket_location_reading) is reported location; Jurisdictional Restrictions / the Get Bucket jurisdiction field are the guarantee that objects are stored and processed within a jurisdiction. This repository has not queried gunbai-fabric-origin, so no Get Bucket location is an observation of ours. RESOLVED BY evidence sufficient for this path's OPERATOR AND JURISDICTION both — recreating the origin under a Jurisdictional Restriction that names a jurisdiction, or a Cloudflare statement that objects in gunbai-fabric-origin are stored and processed within a named jurisdiction by a named operator. A reported location is not that guarantee and is not the nine-path closure. It is NOT resolved by Create Bucket locationHint, by treating Get Bucket location as a hint, or by treating R2JurisdictionDefault as residency."

data cloudflare_r2_backups_location_obligation: NonEmptyStr = "Where R2 replicates objects for durability on a default-jurisdiction bucket is UNREAD. extdeps.cloudflare.r2 r2_how_r2_works_reading states that encrypted data is replicated within the region (e.g. ENAM) for durability, and it names no region for a default-jurisdiction bucket and no country for that replication. RESOLVED BY evidence sufficient for this path's OPERATOR AND JURISDICTION both — a Cloudflare statement of the operator and the region or jurisdiction inside which objects of a named default-jurisdiction bucket are replicated. It is NOT resolved by the example token ENAM in that sentence."

data cloudflare_r2_logs_location_obligation: NonEmptyStr = "Where R2 or the Cloudflare platform stores logs of access to a default-jurisdiction bucket is UNREAD. extdeps.cloudflare.r2 r2_data_location_reading states that Logpush does not interact with R2 resources with assigned jurisdictions, which is a fact about jurisdictional buckets and does not say where logs of a default-jurisdiction bucket go, nor that no such logs exist. THE ABSENT ARM IS DELIBERATELY NOT TAKEN. RESOLVED BY a Cloudflare statement about logging of R2 object access, in either direction: an explicit none makes this path Absent with that document as evidence, and a described store makes it Located with evidence sufficient for OPERATOR AND JURISDICTION both."

data cloudflare_r2_telemetry_location_obligation: NonEmptyStr = "Whether Cloudflare collects telemetry about a default-jurisdiction R2 bucket, what it carries, and where it goes, is UNREAD. Nothing in the documents read on 2026-09-12 describes a telemetry or usage-reporting path for R2 object storage as a located destination. THE ABSENT ARM IS DELIBERATELY NOT TAKEN: silence is not a denial. RESOLVED BY a Cloudflare statement about R2 telemetry, in either direction, sufficient for OPERATOR AND JURISDICTION both when the arm is Located."

data cloudflare_r2_control_plane_location_obligation: NonEmptyStr = "Where the R2 control plane -- the Dashboard, the S3 API, the REST API that powers Wrangler, and the Metadata Service -- runs for a default-jurisdiction bucket, and under whose jurisdiction, is UNREAD. r2_how_r2_works_reading places the Gateway on the global network and the Metadata Service on Durable Objects and names no country for either. RESOLVED BY evidence sufficient for this path's OPERATOR AND JURISDICTION both. Naming an operating entity without a jurisdiction, or a jurisdiction without an operator, does not close this path."

data cloudflare_r2_support_access_obligation: NonEmptyStr = "From which jurisdiction Cloudflare support reaches a default-jurisdiction R2 bucket is UNREAD. extdeps.vendor.cloudflare cloudflare_subprocessors_reading names Slack, Zendesk and Salesforce for customer support, with locations that include the United States and, for Zendesk, also the EEA, Japan and Australia. That is a company-wide support-tool list, not a statement that support access to THIS bucket's objects is exercised from those places or that it is not. RESOLVED BY evidence sufficient for this path's OPERATOR AND JURISDICTION both — a Cloudflare statement of where support access to a given R2 bucket's objects is exercised from and by whom."

data cloudflare_r2_administrative_access_obligation: NonEmptyStr = "From which jurisdiction administrative access to a default-jurisdiction R2 bucket is exercised is UNREAD. The subprocessors page states that Cloudflare Group companies may be sub-processors because employees of those affiliates may need to provide account and engineering support, and it lists subsidiaries in the United Kingdom, Singapore, Australia, Germany, Portugal, France, Japan, Canada, the Netherlands, the U.A.E., India, the United States, South Korea, Mexico, Malaysia, Sweden and Switzerland. That names WHO may provide support, not FROM WHERE administrative access to this bucket is exercised, and it does not locate this bucket. RESOLVED BY evidence sufficient for this path's OPERATOR AND JURISDICTION both."

data cloudflare_r2_spill_location_obligation: NonEmptyStr = "Where customer material may SPILL on an R2 default-jurisdiction route -- caches, diagnostic captures, undeleted replicas, Local Uploads, tiered read cache -- is UNREAD. r2_how_r2_works_reading describes a Tiered Read Cache and Local Uploads and names no country for either, and it does not say that no other spill surface exists. THE ABSENT ARM IS DELIBERATELY NOT TAKEN. RESOLVED BY a Cloudflare statement about host-side or cache-side copies of R2 object bytes for default-jurisdiction buckets, which may resolve this path in either direction, with Located requiring OPERATOR AND JURISDICTION both."

data cloudflare_r2_downstream_obligation: NonEmptyStr = "Which parties process objects stored in a default-jurisdiction R2 bucket on Cloudflare's behalf is UNREAD. The Customer DPA v6.4 (read 2026-09-12) authorizes Cloudflare Group members and third-party data center operators as sub-Processors, and cloudflare_subprocessors_reading transcribes the company-wide table. READER FINDING, not a Cloudflare sentence: that table is not keyed to a named R2 bucket or to the default jurisdiction, so it does not cover gunbai-fabric-origin and it does not establish an empty downstream population. Enumerating it as this route's downstream population would claim coverage the table does not give, and reporting none would claim the negative the table also does not give. RESOLVED BY a Cloudflare statement that names which subprocessors process objects in a named default-jurisdiction R2 bucket -- at which point this population takes Enumerated with that document as coverage -- or an explicit none for that bucket, which takes NoDownstreamProviders with that document as evidence."

fn cloudflare_r2_data_paths() -> ProviderDataPathClosure {
  ProviderDataPathClosure {
    execution: ProviderPathUnread {
      obligation: decl_ref(module_path: "product.supplier.cloudflare_r2", decl_name: "cloudflare_r2_execution_location_obligation"),
      consulted: [],
    },
    durable_storage: ProviderPathUnread {
      obligation: decl_ref(module_path: "product.supplier.cloudflare_r2", decl_name: "cloudflare_r2_durable_storage_location_obligation"),
      consulted: [],
    },
    backups: ProviderPathUnread {
      obligation: decl_ref(module_path: "product.supplier.cloudflare_r2", decl_name: "cloudflare_r2_backups_location_obligation"),
      consulted: [],
    },
    logs: ProviderPathUnread {
      obligation: decl_ref(module_path: "product.supplier.cloudflare_r2", decl_name: "cloudflare_r2_logs_location_obligation"),
      consulted: [],
    },
    telemetry: ProviderPathUnread {
      obligation: decl_ref(module_path: "product.supplier.cloudflare_r2", decl_name: "cloudflare_r2_telemetry_location_obligation"),
      consulted: [],
    },
    control_plane: ProviderPathUnread {
      obligation: decl_ref(module_path: "product.supplier.cloudflare_r2", decl_name: "cloudflare_r2_control_plane_location_obligation"),
      consulted: [],
    },
    support_access: ProviderPathUnread {
      obligation: decl_ref(module_path: "product.supplier.cloudflare_r2", decl_name: "cloudflare_r2_support_access_obligation"),
      consulted: [],
    },
    administrative_access: ProviderPathUnread {
      obligation: decl_ref(module_path: "product.supplier.cloudflare_r2", decl_name: "cloudflare_r2_administrative_access_obligation"),
      consulted: [],
    },
    spill: ProviderPathUnread {
      obligation: decl_ref(module_path: "product.supplier.cloudflare_r2", decl_name: "cloudflare_r2_spill_location_obligation"),
      consulted: [],
    },
  }
}

fn cloudflare_r2_downstream() -> DownstreamProviderPopulation {
  DownstreamProvidersUnread {
    obligation: decl_ref(module_path: "product.supplier.cloudflare_r2", decl_name: "cloudflare_r2_downstream_obligation"),
  }
}

fn cloudflare_r2_location_readings_digest() -> Fnv1a64Structural {
  let after_statements = fold(
    concat(r2_published_location_readings(), cloudflare_company_document_readings()),
    init: content_hash_atom(value: "product.supplier.cloudflare_r2.location-readings" as NonEmptyStr),
    f: fn(acc, statement) {
      content_hash_combine_structural(left: acc, right: content_hash_atom(value: statement))
    },
  )
  let after_citations = fold(
    concat(r2_published_location_citations(), cloudflare_company_document_citations()),
    init: after_statements,
    f: fn(acc, citation) {
      content_hash_combine_structural(
        left: acc,
        right: content_hash_atom(value: citation.authority.uri.locator as NonEmptyStr),
      )
    },
  )
  content_hash_combine_structural(
    left: after_citations,
    right: content_hash_atom(value: r2_tokens_doc_as_of as NonEmptyStr),
  )
}

fn cloudflare_r2_facts(route: ProviderRoute) -> ProviderRouteFacts {
  ProviderRouteFacts {
    route: route,
    contract_terms: decl_ref(module_path: "extdeps.vendor.cloudflare", decl_name: "cloudflare_customer_dpa_reading"),
    data_paths: cloudflare_r2_data_paths(),
    downstream: cloudflare_r2_downstream(),
    observed_at: "2026-09-12T00:00:00Z",
    facts_revision: as_content_hash_structural(structural: cloudflare_r2_location_readings_digest()),
  }
}

// THIS MODULE DECLARES NO SANCTION ROSTER AND NO POSTURE REVISION. Nobody has stated that we are
// willing to place work on this vendor's default-jurisdiction R2 under a named posture. Writing a
// roster row here to make the module look complete would be the fabricated authority the gate exists
// to close. Production standing is ProviderRouteRegionUnobserved; this function projects that
// standing to an empty facts list. admit_provider_use is not invoked here. The witness mints a
// synthetic ProviderRegionRead route and calls admit_provider_use on that pair.
data cloudflare_r2_supplier_frontier_rows: List<FrontierRow> = [
  frontier_row_decl(
    ref: decl_ref(module_path: "product.supplier.cloudflare_r2", decl_name: "cloudflare_r2_route_facts_population"),
    reason: "production does not consume this population; the executing consumer of the admission pair is the witness",
    dissolution: unbound_dissolution(
      description: "TRIGGER: a posture producer that mints a CompliancePostureRevision whose permitted_jurisdictions include or omit this origin by matching these facts. SUFFICIENT FOR: this population is read on an executing production path, not only by a witness."
    )
  )
]

fn cloudflare_r2_route_facts_population() -> List<ProviderRouteFacts> {
  match cloudflare_r2_durable_origin_route_standing() {
    ProviderRouteRegionUnobserved { obligation } => [],
    ProviderRouteObserved { route } => [cloudflare_r2_facts(route: route)],
  }
}
