import product.compute_board.article {
  BoardArticleIdentity,
  BoardPowerInterfaceArticle,
}

// SPICE AS A PROJECTION OF A LANGUAGE-NEUTRAL ANALOG INTENT. Every piece of SPICE spelling for this
// article lives in this module and nowhere upstream: element letter, node names, reference node
// '0', and the magnitude SUFFIXES. The last is the correction that mattered — an earlier revision
// carried value_lexeme: '10k' in the model, a SPICE spelling of a resistance, so the supposed
// authority held target syntax. The magnitude is now a typed measure and 'k' is derived here from
// the variant's declared scale. THE PRIOR SHAPE WAS WORSE THAN A STRAY STRING: the board article
// held a BoardSlice imported FROM this module, so the article depended on one of its own targets
// and 'the article feeds every interface' held only because that interface had already decided
// what the article looked like. WHAT THIS MODULE REFUSES BEFORE EMITTING A BYTE: an element with no
// model binding, an element whose vendor model this profile cannot render, and a TERMINAL ON NO
// NET — a floating terminal and a grounded one are different circuits, and defaulting the first to
// the second emits a deck that simulates cleanly and describes a different board.

type SpiceProjectionRefusal
  = ElectricalModelUnavailable { part: NonEmptyStr }
  | ModelFidelityNotEmittable { part: NonEmptyStr, model_card: NonEmptyStr }
  | ComponentModelBindingMissing { part: NonEmptyStr }
  | TerminalOnNoNet { part: NonEmptyStr }
  | TerminalOnMultipleNets { part: NonEmptyStr }
  | DuplicateModelBinding { component: NonEmptyStr }
  | IdentityNotSpellableInTarget { component: NonEmptyStr }
  | NetNotSpellableInTarget { net: NonEmptyStr }

// The receipt carries the article identity, so an emission is traceable to the root that produced
// it. Otherwise two unrelated articles with equal extracted fields produce indistinguishable output
// and 'one article feeds both projections' is a witness convention, not a property of the types.
type SpiceEmissionReceipt {
  source_article: BoardArticleIdentity
  source: String
}

type SpiceProjection
  = SpiceSliceProjected { receipt: SpiceEmissionReceipt }
  | SpiceSliceRefused { cause: SpiceProjectionRefusal }

// The element letter and the magnitude suffix come from ONE match, because kind and value are one
// constructor upstream. The earlier pair of matches over two independent fields could disagree — a
// PassiveResistor carrying nanofarads emitted "R... 100n", a deck that simulates and describes a
// part nobody specified.
// THE DECK IS BUILT AS A NETLIST AND SERIALIZED BY THE FORMAT MODULE. Every byte of SPICE spelling
// this module used to author — element letter, reference node "0", the space between fields, the
// newline between lines, the "k"/"n" suffixes — was a second SPICE authority in the product layer,
// the fork the Verilog side removed when its printer was deleted. What remains is the only genuine
// projection fact: which target scale each modelled quantity is spelled at.
fn component_node(
  intent: AnalogCircuitIntent,
  reference: NetIdentity,
  c: ElectricalComponentInstance,
  positive: Bool
) -> NodeRef {
  let t = if positive {
    terminal_ref(component: component_identity(c: c), terminal: component_positive_terminal(c: c))
  } else {
    terminal_ref(component: component_identity(c: c), terminal: component_negative_terminal(c: c))
  }
  match net_of_terminal(intent: intent, t: t) {
    Absent => Ground
    Present { value: n } =>
      if net_identity_eq(a: n, b: reference) {
        Ground
      } else {
        Named { node: NamedNode { name: net_local_label(n: n) as String } }
      }
  }
}

fn spice_component(
  intent: AnalogCircuitIntent,
  reference: NetIdentity,
  c: ElectricalComponentInstance
) -> Component {
  let plus = component_node(intent: intent, reference: reference, c: c, positive: true)
  let minus = component_node(intent: intent, reference: reference, c: c, positive: false)
  let name = component_local_label(c: component_identity(c: c)) as String
  match c {
    ResistorInstance { identity: _, part: _, positive_terminal: _, negative_terminal: _, resistance: m } =>
      Resistor { name: name, n_plus: plus, n_minus: minus, value: spice_scaled_value(magnitude: to_string(measure_count(m)), suffix: SpiceKilo) }
    CapacitorInstance { identity: _, part: _, positive_terminal: _, negative_terminal: _, capacitance: m } =>
      Capacitor { name: name, n_plus: plus, n_minus: minus, value: spice_scaled_value(magnitude: to_string(measure_count(m)), suffix: SpiceNano) }
    IndependentVoltageSourceInstance { identity: _, part: _, positive_terminal: _, negative_terminal: _, potential_difference: m } =>
      VoltageSource { name: name, n_plus: plus, n_minus: minus, value: spice_scaled_value(magnitude: to_string(measure_count(m)), suffix: SpiceUnitScale) }
  }
}

fn spice_netlist(intent: AnalogCircuitIntent, reference: NetIdentity) -> SpiceNetlist {
  SpiceNetlist {
    title: intent.title as String,
    body: fold(intent.components, init: Empty, f: fn(acc, c) {
      list_snoc_item(xs: acc, item: DeckComponent { component: spice_component(intent: intent, reference: reference, c: c) })
    }),
  }
}

fn binding_for(bindings: List<ComponentModelBinding>, c: ElectricalComponentInstance) -> ElectricalModelStanding? {
  fold(bindings, init: none, f: fn(acc, b) {
    match acc {
      Present { value: v } => Present { value: v }
      Absent =>
        if component_identity_eq(a: b.component, b: component_identity(c: c)) { Present { value: b.standing } } else { none }
    }
  })
}

// HOW MANY bindings claim this component. binding_for answers with the FIRST match, so two rows
// disagreeing about one component's model resolved silently by list order — an ideal-lumped row and
// a vendor-subcircuit row for the same part emit or refuse depending on which was authored first,
// a verdict decided by editing accident. Ambiguity is not a model standing; it is refused.
fn binding_count(bindings: List<ComponentModelBinding>, c: ElectricalComponentInstance) -> Nat {
  fold(bindings, init: 0, f: fn(acc, b) {
    if component_identity_eq(a: b.component, b: component_identity(c: c)) { acc + 1 } else { acc }
  })
}

fn standing_refusal(c: ElectricalComponentInstance, s: ElectricalModelStanding) -> SpiceProjectionRefusal? {
  match s {
    ElectricalModelAbsent => Present { value: ElectricalModelUnavailable { part: component_part(c: c) } }
    ElectricalModelCited { model_card: mc, fidelity: f } =>
      match f {
        IdealLumped => none
        VendorSubcircuit => Present { value: ModelFidelityNotEmittable { part: component_part(c: c), model_card: mc } }
      }
  }
}

// A terminal sits in exactly one of three states with DIFFERENT remedies: on no net (floating), on
// one net (netted), or on several (shorted between them). The earlier check was a Bool over "did
// net_of_terminal answer", collapsing the third into the second — a terminal shorting two nets
// emitted a deck naming whichever net was authored first, simulating cleanly while describing a
// board that is not the one modelled: the exact failure this module's note claims to prevent for
// the floating case, left open for the shorted one.
fn terminal_netting_refusal(
  intent: AnalogCircuitIntent,
  c: ElectricalComponentInstance,
  t: ElectricalTerminalRef
) -> SpiceProjectionRefusal? {
  let n = net_membership_count(intent: intent, t: t)
  if n == 0 {
    Present { value: TerminalOnNoNet { part: component_part(c: c) } }
  } else {
    if n == 1 { none } else { Present { value: TerminalOnMultipleNets { part: component_part(c: c) } } }
  }
}

fn terminals_netting_refusal(
  intent: AnalogCircuitIntent,
  c: ElectricalComponentInstance
) -> SpiceProjectionRefusal? {
  fold(component_terminals(c: c), init: none, f: fn(acc, t) {
    match acc {
      Present { value: r } => Present { value: r }
      Absent => terminal_netting_refusal(intent: intent, c: c, t: t)
    }
  })
}

fn component_refusal(
  intent: AnalogCircuitIntent,
  bindings: List<ComponentModelBinding>,
  c: ElectricalComponentInstance
) -> SpiceProjectionRefusal? {
  if binding_count(bindings: bindings, c: c) > 1 {
    Present { value: DuplicateModelBinding { component: component_local_label(c: component_identity(c: c)) } }
  } else {
    match binding_for(bindings: bindings, c: c) {
      Absent => Present { value: ComponentModelBindingMissing { part: component_part(c: c) } }
      Present { value: s } =>
        match standing_refusal(c: c, s: s) {
          Present { value: r } => Present { value: r }
          Absent => terminals_netting_refusal(intent: intent, c: c)
        }
    }
  }
}

fn first_refusal(
  intent: AnalogCircuitIntent,
  bindings: List<ComponentModelBinding>
) -> SpiceProjectionRefusal? {
  fold(intent.components, init: none, f: fn(acc, c) {
    match acc {
      Present { value: r } => Present { value: r }
      Absent => component_refusal(intent: intent, bindings: bindings, c: c)
    }
  })
}

// A NAME THIS FORMAT CANNOT SPELL IS REFUSED, not repaired. The format module admits an identifier
// or answers Absent, and an Absent name renders as the empty string inside the deck — so the
// refusal happens here, before a line is built, or a component silently loses its name and the
// deck describes a different circuit.
fn spelling_refusal(c: ElectricalComponentInstance) -> SpiceProjectionRefusal? {
  if spice_identifier_is_admissible(spelling: component_local_label(c: component_identity(c: c)) as String) {
    none
  } else {
    Present { value: IdentityNotSpellableInTarget { component: component_local_label(c: component_identity(c: c)) } }
  }
}

fn net_spelling_refusal(intent: AnalogCircuitIntent, reference: NetIdentity) -> SpiceProjectionRefusal? {
  fold(intent.nets, init: none, f: fn(acc, net) {
    match acc {
      Present { value: r } => Present { value: r }
      Absent =>
        if net_identity_eq(a: net.identity, b: reference) || spice_identifier_is_admissible(spelling: net_local_label(n: net.identity) as String) {
          none
        } else {
          Present { value: NetNotSpellableInTarget { net: net_local_label(n: net.identity) } }
        }
    }
  })
}

// THE RUNNABLE DECK IS A SECOND PROJECTION OF THE SAME NETLIST, not a second netlist. An analysis
// directive adds a question for the simulator — an operating point, here — a fact about a RUN, not
// the board, which is why the receipt's deck does not carry one. Both come from spice_netlist, so a
// run cannot exercise a circuit the receipt does not describe.
fn first_refusal_or_net_spelling(
  intent: AnalogCircuitIntent,
  bindings: List<ComponentModelBinding>,
  reference: NetIdentity
) -> SpiceProjectionRefusal? {
  match net_spelling_refusal(intent: intent, reference: reference) {
    Present { value: r } => Present { value: r }
    Absent => first_refusal(intent: intent, bindings: bindings)
  }
}

fn project_analog_to_spice(
  article_identity: BoardArticleIdentity,
  intent: AnalogCircuitIntent,
  bindings: List<ComponentModelBinding>,
  reference: NetIdentity
) -> SpiceProjection {
  match first_refusal_or_net_spelling(intent: intent, bindings: bindings, reference: reference) {
    Present { value: r } => SpiceSliceRefused { cause: r }
    Absent =>
      SpiceSliceProjected {
        receipt: SpiceEmissionReceipt {
          source_article: article_identity,
          source: spice_emit(netlist: spice_netlist(intent: intent, reference: reference)),
        },
      }
  }
}

// THE PRODUCTION ENTRY POINT, taking the whole article rather than its parts. Every caller of
// project_analog_to_spice supplies identity and circuit SEPARATELY, so one article's identity paired
// with another's circuit was constructible and the receipt would name a board it does not describe.
// Taking the article closes that by construction: one value, both facts read out of it here.
fn project_article_to_spice(admitted: AdmittedBoardPowerInterfaceArticle) -> SpiceProjection {
  let article = admitted_article(a: admitted)
  project_analog_to_spice(
    article_identity: article.identity,
    intent: article.analog,
    bindings: article.model_bindings,
    reference: article.reference_net
  )
}

// IT RETURNS THE SAME COPRODUCT, THROUGH THE SAME GATE. An earlier revision returned a bare String
// and built the netlist directly, so an article admission accepts and this module REFUSES could
// still hand a runnable deck to a simulator — the fail-open the netting refusals close, reopened on
// the second path: component_node maps a terminal on no net to Ground, so the bypassing deck would
// have simulated cleanly and described a different board. One refusal gate, both projections behind
// it; a String return made the bypass possible because a String has nowhere to put a refusal.
fn project_article_to_ngspice_run(admitted: AdmittedBoardPowerInterfaceArticle) -> SpiceProjection {
  let article = admitted_article(a: admitted)
  let intent = article.analog
  let reference = article.reference_net
  match first_refusal_or_net_spelling(intent: intent, bindings: article.model_bindings, reference: reference) {
    Present { value: r } => SpiceSliceRefused { cause: r }
    Absent =>
      SpiceSliceProjected {
        receipt: SpiceEmissionReceipt {
          source_article: article.identity,
          source: spice_emit_ngspice(netlist: SpiceNetlist {
            title: spice_netlist(intent: intent, reference: reference).title,
            body: list_snoc_item(
              xs: spice_netlist(intent: intent, reference: reference).body,
              item: DeckDirective { directive: Op }
            ),
          }),
        },
      }
  }
}
