module gunbc.chapman_which_path_observation


// Observing-layer receipts for Chapman et al. 1995 which-path distinguishability. Rows derive from extdeps.physics.chapman_et_al_1995_atom_interferometer_which_path.chapman_which_path_observations — sole population authority, no parallel copy.
fn chapman_row_is_cited_apparatus(row: extdeps.physics.chapman_et_al_1995_atom_interferometer_which_path.ChapmanWhichPathObservationRow) -> Bool {
  row.apparatus == extdeps.physics.chapman_et_al_1995_atom_interferometer_which_path.chapman_et_al_1995_atom_interferometer
}

fn chapman_row_is_ensemble_grain(row: extdeps.physics.chapman_et_al_1995_atom_interferometer_which_path.ChapmanWhichPathObservationRow) -> Bool {
  match row.grain {
    extdeps.physics.chapman_et_al_1995_atom_interferometer_which_path.EnsembleGrain => true
    extdeps.physics.chapman_et_al_1995_atom_interferometer_which_path.TrialGrain => false
  }
}

fn chapman_cited_observations_are_ensemble_grain() -> Bool {
  extdeps.physics.chapman_et_al_1995_atom_interferometer_which_path.chapman_which_path_observations |> all(row => chapman_row_is_ensemble_grain(row: row))
}

fn chapman_cited_observations_use_cited_apparatus() -> Bool {
  extdeps.physics.chapman_et_al_1995_atom_interferometer_which_path.chapman_which_path_observations |> all(row => chapman_row_is_cited_apparatus(row: row))
}

fn chapman_cited_row_matches_coherent_prediction(row: extdeps.physics.chapman_et_al_1995_atom_interferometer_which_path.ChapmanWhichPathObservationRow) -> Bool {
  gunbc.physics.which_path_four_model_comparison.cited_row_matches_coherent_prediction(
    record: row.which_path_distinguishability_record,
    visibility: row.interference_fringe_visibility,
  )
}

fn chapman_cited_row_matches_classical_prediction(row: extdeps.physics.chapman_et_al_1995_atom_interferometer_which_path.ChapmanWhichPathObservationRow) -> Bool {
  gunbc.physics.which_path_four_model_comparison.cited_row_matches_classical_prediction(
    record: row.which_path_distinguishability_record,
    visibility: row.interference_fringe_visibility,
  )
}

fn chapman_all_cited_rows_match_coherent_predictions() -> Bool {
  extdeps.physics.chapman_et_al_1995_atom_interferometer_which_path.chapman_which_path_observations
    |> all(row => chapman_cited_row_matches_coherent_prediction(row: row))
}

fn chapman_not_all_cited_rows_match_classical_predictions() -> Bool {
  !(extdeps.physics.chapman_et_al_1995_atom_interferometer_which_path.chapman_which_path_observations
    |> all(row => chapman_cited_row_matches_classical_prediction(row: row)))
}

fn chapman_four_model_comparison_holds() -> Bool {
  chapman_cited_observations_use_cited_apparatus()
    && chapman_cited_observations_are_ensemble_grain()
    && gunbc.physics.which_path_four_model_comparison.all_four_model_predictions_execute()
    && chapman_all_cited_rows_match_coherent_predictions()
    && chapman_not_all_cited_rows_match_classical_predictions()
    && gunbc.physics.which_path_four_model_comparison.single_axis_change_insufficient_for_cited_visibility_pair()
}

fn chapman_four_model_rejects_classical_for_passive_visible_row(
  row: extdeps.physics.chapman_et_al_1995_atom_interferometer_which_path.ChapmanWhichPathObservationRow,
) -> Bool {
  !gunbc.physics.which_path_four_model_comparison.cited_row_matches_classical_prediction(
    record: row.which_path_distinguishability_record,
    visibility: row.interference_fringe_visibility,
  )
}

fn chapman_four_model_rejects_coherent_for_row(
  row: extdeps.physics.chapman_et_al_1995_atom_interferometer_which_path.ChapmanWhichPathObservationRow,
) -> Bool {
  !gunbc.physics.which_path_four_model_comparison.cited_row_matches_coherent_prediction(
    record: row.which_path_distinguishability_record,
    visibility: row.interference_fringe_visibility,
  )
}

fn chapman_composition_axis_insufficient_alone() -> Bool {
  gunbc.physics.which_path_four_model_comparison.composition_axis_predictions_differ_at_passive_disclosure()
}

fn chapman_disclosure_axis_insufficient_alone() -> Bool {
  gunbc.physics.which_path_four_model_comparison.disclosure_axis_predictions_differ_at_coherent_composition()
}
