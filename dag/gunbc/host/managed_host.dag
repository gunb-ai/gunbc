module gunbc.managed_host

import std.types { List, NonEmptyStr }
import product.placement_supply { HostIdentity }
import extdeps.boards.types { BaseboardModel }
import extdeps.bmc.endpoint { BmcControllerEndpoint }
import extdeps.bmc.access_profile { BmcAccessObservationStanding, BmcAccessUnobserved }
import extdeps.bmc.capability { BmcFirmwareReleaseCapabilityRow }
import extdeps.network.ipv4 { render_ipv4_address }
import gunbc.machine_intake_bmc_first_contact_standing { BmcFirmwareFamilyStanding, FamilyObserved }
import gunbc.fleet_intent_network { operator_host_mtcollins1, operator_host_mtjade1 }
import gunbc.auth.fleet_secret_accessor_roster { FleetAccessorGrantRow, mtcollins1_bmc_accessor_row }
import gunbc.machine_intake_mtcollins1_access_observation {
  mtcollins1_access_standing,
  mtcollins1_capability_row,
  mtcollins1_identity,
}
import gunbc.machine_intake_mtcollins1_bmc_secure_observation { mtcollins1_secured_account }
import gunbc.machine_intake_mtcollins1_maintenance_hold { mtcollins1_unit_hold_key, mtcollins1_unit_hold_store_host }
import gunbc.machine_intake_mtjade1_access_observation {
  JadeManagedBmcSecretStanding,
  mtjade1_firmware_family_standing,
  mtjade1_managed_bmc_secret_standing,
}
import gunbc.machine_intake_mtjade1_factory_network { mtjade1_bmc_address }

// A HOST THIS FLEET DRIVES THROUGH ITS BASEBOARD CONTROLLER, and the one record a host-generic
// procedure takes instead of a unit's constants (docs/plans/managed-host-untangle.md, cut 0). It is
// not an executor fleet host: gunbc.fleet_runner_connectivity fleet_hosts() means "commits runner
// slots", and a managed host commits none.
//
// EVERY FIELD IS A STANDING, so a host can be a row before anything about it is observed, and a
// procedure that needs an unobserved fact refuses at the procedure rather than defaulting to another
// unit's value. The row values are imported from the unit's own layer-1 modules, never re-spelled.
//
// baseboard and capability are Option rather than a new standing type because their element types
// are existing upstream authorities that deliberately do not widen: extdeps.boards.types
// BaseboardModel has no Mt. Jade arm, and extdeps.ocp.mt_jade platform says it will not add one, so
// Absent is the honest reading for a board the catalog does not carry. A capability row exists only
// for a firmware release whose writes were exercised, so Absent is "no release row", not "no
// capability".
type ManagedHost {
  host: HostIdentity
  baseboard: BaseboardModel?
  bmc_stack: BmcFirmwareFamilyStanding
  access: BmcAccessObservationStanding
  capability: BmcFirmwareReleaseCapabilityRow?
  credential: ManagedCredentialStanding
  unit_hold: ResetUnitHold
}

// WHERE THE HOST'S MANAGED BMC CREDENTIAL STANDS. On the accessor roster it is the roster's own row
// (whose target is the SecretRef) plus the account the unit's BmcSecured standing names, Absent when
// the unit is not BmcSecured. Off the roster it is the reserved-locus standing the unit's intake
// module already carries; no second spelling of that locus is made here.
type ManagedCredentialStanding
  = CredentialOnAccessorRoster { accessor: FleetAccessorGrantRow, secured_account: NonEmptyStr? }
  | CredentialLocusReserved { locus: JadeManagedBmcSecretStanding }

// WHETHER DRIVING THIS HOST MUST TAKE ITS MAINTENANCE HOLD FIRST, and on which host the hold store
// lives. Mt. Collins unit 1 is serviced by hand (gunbc.machine_intake_mtcollins1_maintenance_hold),
// so a power cycle of it is gated by the same slot the boot takes; the reset may only run where that
// store is, or it would acquire a hold in an empty store the operator never sees.
//
// ResetUnitHoldUndeclared is the standing for a host nobody has decided about. It is not
// ResetNoUnitHold: that arm licenses a write without a hold, and asserting it for a unit on the
// bench would be the fabricated default this record exists to refuse.
type ResetUnitHold
  = ResetUnitHoldRequired { key: NonEmptyStr, store_host: NonEmptyStr }
  | ResetNoUnitHold
  | ResetUnitHoldUndeclared { reason: NonEmptyStr }

// THE FAMILY OF A HOST WHOSE CONTROLLER WAS READ is the family its observed release identity carries;
// it is a projection of that observation, not a second reading of the controller.
fn managed_host_mtcollins1() -> ManagedHost {
  ManagedHost {
    host: operator_host_mtcollins1,
    baseboard: Present { value: mtcollins1_identity.baseboard },
    bmc_stack: FamilyObserved { family: mtcollins1_identity.firmware.family },
    access: mtcollins1_access_standing,
    capability: Present { value: mtcollins1_capability_row },
    credential: CredentialOnAccessorRoster { accessor: mtcollins1_bmc_accessor_row, secured_account: mtcollins1_secured_account() },
    unit_hold: ResetUnitHoldRequired { key: mtcollins1_unit_hold_key, store_host: mtcollins1_unit_hold_store_host },
  }
}

// MT. JADE UNIT 1 FABRICATES NOTHING. Its family is the unit's FamilyUnobserved; its access is
// unobserved at the address the factory segment was observed to serve; its credential is the
// reserved locus; no catalog board, no capability row, and no hold decision.
fn managed_host_mtjade1() -> ManagedHost {
  ManagedHost {
    host: operator_host_mtjade1,
    baseboard: none,
    bmc_stack: mtjade1_firmware_family_standing,
    access: BmcAccessUnobserved { endpoint: BmcControllerEndpoint { host: render_ipv4_address(addr: mtjade1_bmc_address) } },
    capability: none,
    credential: CredentialLocusReserved { locus: mtjade1_managed_bmc_secret_standing },
    unit_hold: ResetUnitHoldUndeclared { reason: "Mt. Jade unit 1 has no maintenance hold modeled; whether a write to it must take one is undecided" },
  }
}

fn managed_hosts() -> List<ManagedHost> {
  [managed_host_mtcollins1(), managed_host_mtjade1()]
}
