// A HOST THIS FLEET DRIVES THROUGH ITS BASEBOARD CONTROLLER, and the one record a host-generic
// procedure takes instead of a unit's constants (docs/plans/managed-host-untangle.md, cut 0). It is
// not an executor fleet host: gunbc.fleet.fleet_runner_connectivity fleet_hosts() means "commits runner
// slots", and a managed host commits none. Every value in a row is imported from the unit's own
// layer-1 modules, never re-spelled. ManagedHost is sole_constructor: the host identity is joined to
// its secure standing (and so to the intake subject that standing sealed) only here, so no other
// module can author a row pairing one host's name with another unit's secured standing. The intake
// subject is not a field: secure.subject is the one
// home of it, and a second copy could disagree with the standing it was derived beside.
//
// access is the fact gunbc.machine_intake.oob_boot_handoff oob_boot_handoff_admission consumes: the
// controller's reported firmware release resolves its capability row through the release catalog
// (gunbc.host.host_capability_row), so no per-unit row is carried here. A per-unit row would be the
// reflash-staleness defect: a unit that moved 0.32 -> 0.45.3 would keep a row describing the old
// build. DECLARED FRONTIER: access becomes one gunbc.machine_intake.access
// BoundBmcAccessContextStanding, whose context binds through the profile it bound, and the trigger is
// the first production producer of that standing. No such producer exists yet
// (bind_bmc_access_context has no production caller and there is no profile catalog), so a bound
// context cannot be executed for any host and is not hand-built here.
type ManagedHost sole_constructor {
  host: HostIdentity
  access: BmcAccessObservationStanding
  secure: BmcSecureStanding
  unit_hold: ResetUnitHold
  // The platform verdict carries the site only where the platform has the interface, so a machine whose
  // silicon does not carry SMpro is a well-formed row without inventing an Ampere observation.
  smpro: SmproPlatformStanding
}

// WHETHER DRIVING THIS HOST MUST TAKE ITS MAINTENANCE HOLD FIRST, and on which host the hold store
// lives. Mt. Collins unit 1 is serviced by hand, so a power cycle of it is gated by the same slot the
// boot takes; a write may only run where that store is, or it would acquire a hold in an empty store
// the operator never sees. This decision is the row's; gunbc.host.managed_host_unit_hold admits a host to
// the hold procedure from it and is the only reader that turns it into a slot.
type ResetUnitHold
  = ResetUnitHoldRequired { key: NonEmptyStr, store_host: NonEmptyStr }
  | ResetNoUnitHold

// ── MANAGED-HOST ADMISSION (cut O1c-3 PR a) ────────────────────────────────────────────────────
//
// One committed record per unit, authored from that unit's arrival observations. The plan's fields:
// HostIdentity ↔ MachineIntakeSubject; access and capability standing; BmcSecureStanding; unit-hold
// decision; receipt identity. smpro is on the record because cut 1 put it on ManagedHost: every
// Ampere SMpro pass reads through managed_host_smpro_subject, and omitting it here would default a
// site in the projection and fork that join. Currency is NOT receipt.subject == record.subject;
// that would quietly call a superseded standing current. Currency is compare_qualification_subject
// of the record's standing subject against the unit's CURRENT subject (current BMC firmware as last
// observed). A superseded standing is a member only through MemberUnderDeclaredDrop, minted only
// where gunbc.rung_drop.mtcollins1_bmc_secure_standing_predates_reflash is standing and its
// population names the unit. Removing that drop makes the unit absent.

type ManagedHostAdmissionReceipt sole_constructor {
  host: HostIdentity
  access_host: NonEmptyStr
  secure_attempt: IntakeAttemptId
}

fn managed_host_admission_receipt(host: HostIdentity, access_host: NonEmptyStr, secure_attempt: IntakeAttemptId) -> ManagedHostAdmissionReceipt
  admit_callers: [
    decl_ref(module_path: "gunbc.host.managed_host", decl_name: "mtcollins1_managed_host_admission"),
    decl_ref(module_path: "gunbc.host.managed_host", decl_name: "managed_host_admission"),
    decl_ref(module_path: "test.claim.host.managed_host_admission_witness", decl_name: "w_a_record_whose_subject_is_current_is_an_ordinary_member"),
    decl_ref(module_path: "test.claim.host.managed_host_admission_witness", decl_name: "w_a_superseded_subject_with_no_declared_drop_is_absent"),
    decl_ref(module_path: "test.claim.host.managed_host_admission_witness", decl_name: "w_a_missing_hold_decision_is_absent"),
    decl_ref(module_path: "test.claim.host.managed_host_admission_witness", decl_name: "w_a_missing_host_allocation_is_absent"),
    decl_ref(module_path: "test.claim.host.managed_host_admission_witness", decl_name: "w_a_receipt_for_another_host_is_absent"),
    decl_ref(module_path: "test.claim.host.managed_host_admission_witness", decl_name: "w_without_the_drop_mtcollins1_is_absent_and_reset_roster_empties"),
  ]
{
  ManagedHostAdmissionReceipt { host: host, access_host: access_host, secure_attempt: secure_attempt }
}

type ManagedHostAdmissionHold
  = AdmissionHoldDecided { hold: ResetUnitHold }
  | AdmissionHoldMissing

type ManagedHostAdmission sole_constructor {
  host: HostIdentity
  subject: MachineIntakeSubject
  access: BmcAccessObservationStanding
  // NO capability row here. It used to be carried in and then silently dropped by row_from_admission,
  // because the row is a fact ABOUT A RELEASE that the catalog owns and resolves from the release the
  // controller REPORTED (gunbc.host.host_capability_row) -- a second, hand-supplied path to it was a
  // dead input and an attractor beside the catalog, able to disagree with the observation it described.
  secure: BmcSecureStanding
  hold: ManagedHostAdmissionHold
  // The machine's SMpro FACT AS A PLATFORM QUESTION, not an always-present site: only a platform that
  // carries the interface owes a site and an endpoint join, so an x86 machine is representable at all.
  smpro: SmproPlatformStanding
  receipt: ManagedHostAdmissionReceipt
  current_subject: MachineIntakeSubject?
  covering_drop: DeclarationRef?
}

fn managed_host_admission(
  host: HostIdentity,
  subject: MachineIntakeSubject,
  access: BmcAccessObservationStanding,
  secure: BmcSecureStanding,
  hold: ManagedHostAdmissionHold,
  smpro: SmproPlatformStanding,
  receipt: ManagedHostAdmissionReceipt,
  current_subject: MachineIntakeSubject?,
  covering_drop: DeclarationRef?,
) -> ManagedHostAdmission
  admit_callers: [
    decl_ref(module_path: "gunbc.host.managed_host", decl_name: "mtcollins1_managed_host_admission"),
    decl_ref(module_path: "test.claim.host.managed_host_admission_witness", decl_name: "w_a_record_whose_subject_is_current_is_an_ordinary_member"),
    decl_ref(module_path: "test.claim.host.managed_host_admission_witness", decl_name: "w_a_superseded_subject_with_no_declared_drop_is_absent"),
    decl_ref(module_path: "test.claim.host.managed_host_admission_witness", decl_name: "w_a_missing_hold_decision_is_absent"),
    decl_ref(module_path: "test.claim.host.managed_host_admission_witness", decl_name: "w_a_missing_host_allocation_is_absent"),
    decl_ref(module_path: "test.claim.host.managed_host_admission_witness", decl_name: "w_a_receipt_for_another_host_is_absent"),
    decl_ref(module_path: "test.claim.host.managed_host_admission_witness", decl_name: "w_without_the_drop_mtcollins1_is_absent_and_reset_roster_empties"),    // THE X86 REQUIRED-RED CLAIM mints a VARIANT of the committed admission record: only its
    // smpro arm differs from the committed one, and minting a variant is the whole point of the
    // claim (an x86 platform with no SMpro interface must still be admitted). The alternative --
    // reading the committed record and overriding one field -- is the bypass this seal exists to
    // refuse, so the claim comes through the door with its name on it, as the six admission-
    // witness claims above already do.
    decl_ref(module_path: "test.claim.host.managed_host_witness", decl_name: "w_admission_admits_a_platform_that_carries_no_smpro_interface"),

  ]
{
  ManagedHostAdmission {
    host: host,
    subject: subject,
    access: access,
    secure: secure,
    hold: hold,
    smpro: smpro,
    receipt: receipt,
    current_subject: current_subject,
    covering_drop: covering_drop,
  }
}

type ManagedHostMembership sole_constructor
  = OrdinaryMember { host: ManagedHost }
  | MemberUnderDeclaredDrop {
      drop: DeclarationRef
      standing_subject: MachineIntakeSubject
      current_subject: MachineIntakeSubject
      host: ManagedHost
    }

data mtcollins1_bmc_secure_standing_drop_ref: DeclarationRef = decl_ref(
  module_path: "gunbc.rung_drop.mtcollins1_bmc_secure_standing_predates_reflash",
  decl_name: "mtcollins1_bmc_secure_standing_predates_reflash",
)

// COVERING IS THE RECORD'S CITED DROP JOINED TO A STANDING ROW BY IDENTITY, NOT HOST EQUALITY
// INSIDE THIS FOLD AND NOT POPULATION PROSE. RungDrop.population is the 4b(3) English bound for
// the DESIGN projection; grepping it would admit any host whose name appears in a sentence.
// Which unit a drop covers is the covering_drop the unit's admission record cites; the generic
// join only checks that cited identity is standing in the drop list.
fn drop_is_standing_citation(drop: RungDrop, cited: DeclarationRef) -> Bool {
  match drop.standing {
    Retired { trigger_fired: _ } => false
    Superseded { ruling: _, decision_record: _, loss_holder: _ } => false
    Dissolved { ruling: _, decision_record: _, population_gone: _ } => dissolved_is_admissible(drop: drop) == false && (drop.identity as String) == (cited.decl_name as String)
    Standing => (drop.identity as String) == (cited.decl_name as String)
  }
}

fn covering_bmc_secure_drop(drops: List<RungDrop>, cited: DeclarationRef) -> RungDrop? {
  filter(drops, d => drop_is_standing_citation(drop: d, cited: cited)).first()
}

fn host_is_allocated(allocations: List<HostnameAllocation>, host: HostIdentity) -> Bool {
  any(allocations, a => (a.fleet_slot as String) == (host as String))
}

fn store_host_is_allocated(allocations: List<HostnameAllocation>, store_host: NonEmptyStr) -> Bool {
  any(allocations, a => (a.fleet_slot as String) == (store_host as String) || (allocated_canonical_hostname(allocation: a) as String) == (store_host as String))
}

fn access_controller_host(access: BmcAccessObservationStanding) -> NonEmptyStr? {
  match access {
    BmcAccessUnobserved { endpoint: _ } => none
    BmcAccessObserved { observation: o } => Present { value: o.endpoint.host }
  }
}

fn secure_controller_host(secure: BmcSecureStanding) -> NonEmptyStr? {
  match secure.outcome {
    BmcSecureRefused { cause: _ } => none
    BmcSecured { endpoint: e, reference: _, evidence: _, latest_admitted_probe_at: _, published_credential: _ } =>
      Present { value: e.host }
  }
}

fn receipt_matches_record(record: ManagedHostAdmission) -> Bool {
  (record.receipt.host as String) == (record.host as String)
    && (record.receipt.secure_attempt as NonEmptyStr) == (record.subject.attempt_id as NonEmptyStr)
    && match access_controller_host(access: record.access) {
      Absent => false
      Present { value: h } => (record.receipt.access_host as String) == (h as String)
    }
}

fn standings_bound_to_record_subject(record: ManagedHostAdmission) -> Bool {
  (record.secure.subject.subject.unit_key as NonEmptyStr) == (record.subject.subject.unit_key as NonEmptyStr)
    // NO well-formedness check on the SMpro arm any more. SmproPlatformCarried holds an admitted
    // SmproSite directly and a refused site got its own arm, so the states a validator would reject
    // (carried-without-a-read-site, not-carried-smuggling-a-site) are not writable at all -- DESIGN §5,
    // correctness by construction. A check that cannot fail is not a check; it is noise that reads as
    // coverage. What remains below is the join that CAN disagree: the endpoints a machine named.
    && match access_controller_host(access: record.access) {
      Absent => false
      Present { value: access_host } =>
        match secure_controller_host(secure: record.secure) {
          Absent => false
          Present { value: secure_host } =>
            (access_host as String) == (secure_host as String)
            // WHAT THE PLATFORM ARM OBLIGES, answered PER ARM rather than through one Optional.
            // Review 81478 caught the widen this replaces: the old join asked smpro_platform_controller_host
            // "which endpoint did you read?", three arms answered none, and the Absent branch then returned
            // true -- so a host whose SMpro READ FAILED joined the roster alongside a host whose platform
            // simply has no interface. DESIGN Sec 5: "a failure arm refuses, never widens".
            //   Carried        owes the endpoint join, exactly as before.
            //   NotCarried     joins with no site. This is the ONE arm the manager's blocker 2 opened, and
            //                  the only one that makes sense of it: an x86 unit must not have to fabricate
            //                  an Ampere site to be managed at all.
            //   SiteRefused    REFUSES, as it did on main. The platform carries SMpro and the read came
            //                  back refusing -- a failed read, not an absent interface.
            //   Unestablished  REFUSES. The silicon is unknown; a compatibility roster is not a place to
            //                  guess a platform into membership.
            // The pass subject still refuses the refused site later (SmproSubjectSiteRefused), and that
            // refusal is what the boot-run gauntlet row MUT-SITE-AS-NEGATIVE is measured against; but a
            // later refusal is not a licence to admit here, and the entry point's own comment still
            // promises unbound standings are Absent.
              && match smpro_platform_join_obligation(standing: record.smpro) {
                SmproJoinOwesEndpoint { host: smpro_host } => (secure_host as String) == (smpro_host as String)
                SmproJoinNoEndpointOwed => true
                SmproJoinRefused { cause: _ } => false
              }
        }
    }
}

fn decided_hold(record: ManagedHostAdmission, allocations: List<HostnameAllocation>) -> ResetUnitHold? {
  match record.hold {
    AdmissionHoldMissing => none
    AdmissionHoldDecided { hold: h } =>
      match h {
        ResetNoUnitHold => Present { value: h }
        ResetUnitHoldRequired { key: _, store_host: store } =>
          if store_host_is_allocated(allocations: allocations, store_host: store) {
            Present { value: h }
          } else {
            none
          }
      }
  }
}

fn row_from_admission(record: ManagedHostAdmission, hold: ResetUnitHold) -> ManagedHost {
  ManagedHost {
    host: record.host,
    access: record.access,
    secure: record.secure,
    unit_hold: hold,
    smpro: record.smpro,
  }
}

fn ordinary_member(host: ManagedHost) -> ManagedHostMembership
  admit_callers: [
    decl_ref(module_path: "gunbc.host.managed_host", decl_name: "project_managed_host_admission"),
  ]
{
  OrdinaryMember { host: host }
}

fn member_under_declared_drop(
  drop: DeclarationRef,
  standing_subject: MachineIntakeSubject,
  current_subject: MachineIntakeSubject,
  host: ManagedHost,
) -> ManagedHostMembership
  admit_callers: [
    decl_ref(module_path: "gunbc.host.managed_host", decl_name: "project_managed_host_admission"),
  ]
{
  MemberUnderDeclaredDrop {
    drop: drop,
    standing_subject: standing_subject,
    current_subject: current_subject,
    host: host,
  }
}

// THE PUBLIC ENTRY. Every parameter is consumed: a hard-coded current subject, drop list, or
// allocation list changes the arm. Incomplete records, unbound standings, a missing hold, a missing
// allocation, a mismatched receipt, or an unreadable current subject are Absent, never defaulted.
fn project_managed_host_admission(
  record: ManagedHostAdmission,
  current_subject: MachineIntakeSubject?,
  drops: List<RungDrop>,
  allocations: List<HostnameAllocation>,
) -> ManagedHostMembership? {
  if host_is_allocated(allocations: allocations, host: record.host) == false {
    none
  } else if receipt_matches_record(record: record) == false {
    none
  } else if standings_bound_to_record_subject(record: record) == false {
    none
  } else {
    match decided_hold(record: record, allocations: allocations) {
      Absent => none
      Present { value: hold } =>
        match current_subject {
          Absent => none
          Present { value: current } => {
            let row = row_from_admission(record: record, hold: hold)
            match compare_qualification_subject(admitted: record.subject.subject, observed: current.subject) {
              SubjectCurrent => Present { value: ordinary_member(host: row) }
              SubjectStale { axes: _ } =>
                match record.covering_drop {
                  Absent => none
                  Present { value: cited } =>
                    match covering_bmc_secure_drop(drops: drops, cited: cited) {
                      Absent => none
                      Present { value: _ } =>
                        Present {
                          value: member_under_declared_drop(
                            drop: cited,
                            standing_subject: record.subject,
                            current_subject: current,
                            host: row,
                          ),
                        }
                    }
                }
            }
          }
        }
    }
  }
}

fn membership_host(membership: ManagedHostMembership) -> ManagedHost {
  match membership {
    OrdinaryMember { host: h } => h
    MemberUnderDeclaredDrop { drop: _, standing_subject: _, current_subject: _, host: h } => h
  }
}

fn membership_is_host(membership: ManagedHostMembership, host: HostIdentity) -> Bool {
  match membership {
    OrdinaryMember { host: h } => (h.host as String) == (host as String)
    MemberUnderDeclaredDrop { drop: _, standing_subject: _, current_subject: _, host: h } => (h.host as String) == (host as String)
  }
}

fn mtcollins1_unit_hold() -> ResetUnitHold {
  ResetUnitHoldRequired { key: operator_host_mtcollins1 as NonEmptyStr, store_host: operator_host_srv1 as NonEmptyStr }
}

fn mtcollins1_managed_host_admission() -> ManagedHostAdmission? {
  match mtcollins1_bmc_secure_standing() {
    Absent => none
    Present { value: secure } =>
      match mtcollins1_intake_subject() {
        Absent => none
        Present { value: subject } =>
          match access_controller_host(access: mtcollins1_access_standing) {
            Absent => none
            Present { value: access_host } =>
              Present {
                value: managed_host_admission(
                  host: operator_host_mtcollins1,
                  subject: subject,
                  access: mtcollins1_access_standing,
                  secure: secure,
                  hold: AdmissionHoldDecided { hold: mtcollins1_unit_hold() },
                  smpro: smpro_platform_standing(access: mtcollins1_access_standing, site: mtcollins1_smpro_site()),
                  receipt: managed_host_admission_receipt(
                    host: operator_host_mtcollins1,
                    access_host: access_host,
                    secure_attempt: subject.attempt_id,
                  ),
                  current_subject: mtcollins1_current_intake_subject(),
                  covering_drop: Present { value: mtcollins1_bmc_secure_standing_drop_ref },
                ),
              }
          }
      }
  }
}

fn authored_managed_host_admissions() -> List<ManagedHostAdmission> {
  match mtcollins1_managed_host_admission() {
    Absent => []
    Present { value: r } => [r]
  }
}

fn current_subject_for_admission(record: ManagedHostAdmission) -> MachineIntakeSubject? {
  record.current_subject
}

fn managed_host_memberships_projected(
  records: List<ManagedHostAdmission>,
  drops: List<RungDrop>,
  allocations: List<HostnameAllocation>,
) -> List<ManagedHostMembership> {
  fold(records, init: [], f: (acc, record) =>
    match project_managed_host_admission(
      record: record,
      current_subject: current_subject_for_admission(record: record),
      drops: drops,
      allocations: allocations,
    ) {
      Absent => acc
      Present { value: m } => concat(acc, [m])
    })
}

fn managed_hosts_projected(
  records: List<ManagedHostAdmission>,
  drops: List<RungDrop>,
  allocations: List<HostnameAllocation>,
) -> List<ManagedHost> {
  fold(
    managed_host_memberships_projected(records: records, drops: drops, allocations: allocations),
    init: [],
    f: (acc, m) => concat(acc, [membership_host(membership: m)]),
  )
}

fn managed_host_memberships() -> List<ManagedHostMembership> {
  managed_host_memberships_projected(
    records: authored_managed_host_admissions(),
    drops: standing_rung_drops(),
    allocations: gunbc_fleet_hostname_allocations,
  )
}

fn managed_membership_for(host: HostIdentity) -> ManagedHostMembership? {
  fold(
    managed_host_memberships(),
    init: none,
    f: (acc, m) => match acc {
      Present { value: _ } => acc
      Absent => if membership_is_host(membership: m, host: host) { Present { value: m } } else { acc }
    },
  )
}

// A UNIT IS A MEMBER ONLY THROUGH A COMMITTED ManagedHostAdmission, projected here. Membership is
// evidence, never a source roster: the record lives in the unit's observations; this module joins
// completeness, the one-subject bind, allocation, hold, receipt identity, and currency against the
// CURRENT subject (docs/plans/managed-host-untangle.md, cut O1c-3 PR a). mtjade1 has no record.
// managed_hosts() is the host-row view of managed_host_memberships(); callers that read secure
// standing, binding, reset, hold, boot, or MegaRAC admission walk the memberships and match
// MemberUnderDeclaredDrop (DESIGN §4b(3): a declared drop may not reach consumers as silence).
fn managed_hosts() -> List<ManagedHost> {
  fold(managed_host_memberships(), init: [], f: (acc, m) => concat(acc, [membership_host(membership: m)]))
}

// A MANAGED HOST BY LABEL, AS ITS ROW PLUS ITS SECURED CONTROL ROUTE. The route is decided by
// gunbc.host.bmc_control_binding from the row's access observation and secure standing alone, and it is
// the ONLY standing a consumer reads to drive the controller: the bound arm carries the binding and the
// observation the join checked, and the account is read through the binding, so no caller pairs a
// secured account with some other row's access. A consumer that only needs to know whether it may drive
// a controller takes the control standing and never lifts the row; one that needs the row's own facts
// (its host identity, its access reading) takes them from the row beside it. The join and its
// endpoint-mismatch refusal live in gunbc.host.bmc_control_binding; there is no second binding standing.
type ManagedHostLookup
  = ManagedHostFound { host: ManagedHost, control: BmcControlStanding }
  | ManagedHostFoundUnderDeclaredDrop {
      host: ManagedHost
      control: BmcControlStanding
      drop: DeclarationRef
      standing_subject: MachineIntakeSubject
      current_subject: MachineIntakeSubject
    }
  | ManagedHostNotManaged { host: NonEmptyStr }

fn managed_host_binding_for(host: NonEmptyStr) -> ManagedHostLookup {
  match managed_membership_for(host: host as HostIdentity) {
    Absent => ManagedHostNotManaged { host: host }
    Present { value: m } =>
      match m {
        OrdinaryMember { host: h } =>
          ManagedHostFound {
            host: h,
            control: bmc_control_binding(observed: h.access, secured: h.secure),
          }
        MemberUnderDeclaredDrop { drop: d, standing_subject: standing, current_subject: current, host: h } =>
          ManagedHostFoundUnderDeclaredDrop {
            host: h,
            control: bmc_control_binding(observed: h.access, secured: h.secure),
            drop: d,
            standing_subject: standing,
            current_subject: current,
          }
      }
  }
}

// THE ACCOUNT, RELEASED ONLY TOGETHER WITH THE CONTROLLER IT WAS BOUND TO. A caller that is about to
// drive `endpoint` gets the bound account only when `endpoint` is the controller the route binds, so
// one host's account is never sent to another controller. The account is read through the binding
// (gunbc.host.bmc_control_binding bmc_control_account), never stored a second time beside it. Absent is
// every other case: the host is not managed, has no bound route, or is bound to a different controller
// than the one the caller drives.
fn account_driving_standing(standing: BmcControlStanding, endpoint: BmcControllerEndpoint) -> NonEmptyStr? {
  match standing {
    BmcControlBound { route: r } =>
      match bmc_control_route_account(route: r) {
        Present { value: a } =>
          if (bmc_control_route_endpoint(route: r).host as String) == (endpoint.host as String) {
            Present { value: a }
          } else {
            none
          }
        Absent => none
      }
    BmcControlAccessUnobserved { endpoint: _ } => none
    BmcControlNotSecured { cause: _ } => none
    BmcControlEndpointMismatch { observed: _, secured: _ } => none
  }
}

fn managed_host_account_driving(lookup: ManagedHostLookup, endpoint: BmcControllerEndpoint) -> NonEmptyStr? {
  match lookup {
    ManagedHostNotManaged { host: _ } => none
    ManagedHostFound { host: _, control: c } => account_driving_standing(standing: c, endpoint: endpoint)
    ManagedHostFoundUnderDeclaredDrop { host: _, control: c, drop: _, standing_subject: _, current_subject: _ } =>
      account_driving_standing(standing: c, endpoint: endpoint)
  }
}

// THE ONE OTHER WAY TO MINT A ROW, ADMITTED ONLY TO THE WITNESSES THAT NEED A CROSS-WIRED ONE. The
// reds in test.claim.host.managed_host_witness (and test.claim.host.megarac_managed_host_witness, test.claim.machine_intake.dimm_physical_orientation_witness) re-point a real row's access at another controller or
// another reported baseboard, or rename a real row to a host with no reset selection, boot selection or boot policy, to show the binding and the
// admissions refuse them; they cannot do that without a constructor, and admit_callers keeps every other caller out.
fn managed_host_fixture(
  host: HostIdentity,
  access: BmcAccessObservationStanding,
  secure: BmcSecureStanding,
  unit_hold: ResetUnitHold,
  smpro: SmproPlatformStanding,
) -> ManagedHost
  admit_callers: [
    decl_ref(module_path: "test.claim.host.managed_host_witness", decl_name: "w_a_secured_account_beside_another_controllers_access_is_not_bound_or_rostered"),
    decl_ref(module_path: "test.claim.host.managed_host_witness", decl_name: "w_a_capable_host_with_no_reset_selection_is_absent_from_the_roster"),
    decl_ref(module_path: "test.claim.host.managed_host_unit_hold_witness", decl_name: "w_a_managed_host_with_no_unit_hold_is_refused_and_has_no_store"),
    decl_ref(module_path: "test.claim.host.managed_host_unit_hold_witness", decl_name: "w_a_held_host_with_no_reason_variable_is_refused_for_maintenance"),
    decl_ref(module_path: "test.claim.host.managed_host_unit_hold_witness", decl_name: "w_a_store_host_with_no_allocated_hostname_refuses_the_executor"),
    decl_ref(module_path: "test.claim.auth.managed_host_boot_federation_witness", decl_name: "w_a_bound_host_with_no_boot_policy_is_unprovisioned"),
    decl_ref(module_path: "test.claim.host.managed_host_witness", decl_name: "w_a_row_whose_smpro_site_names_another_controller_mints_no_subject"),
    decl_ref(module_path: "test.claim.host.managed_host_witness", decl_name: "w_a_refused_smpro_site_on_a_bound_route_reports_a_refused_site_not_a_missing_controller"),
    // The two platform-arm claims: both re-point a real row's SMpro standing (not-carried, and the
    // supplied x86 specimen that carries no site at all), which needs a constructor for the same reason
    // the cross-wired rows above do — the admission cannot mint that shape through the admitted path.
    decl_ref(module_path: "test.claim.host.managed_host_witness", decl_name: "w_a_platform_that_does_not_carry_smpro_binds_no_pass_subject"),
    decl_ref(module_path: "test.claim.host.managed_host_witness", decl_name: "w_the_supplied_x86_specimen_is_managed_and_carries_no_smpro_site"),
    decl_ref(module_path: "test.claim.host.managed_host_boot_witness", decl_name: "w_a_boot_of_an_unbound_host_is_refused"),
    decl_ref(module_path: "test.claim.host.managed_host_boot_witness", decl_name: "w_a_bound_host_with_no_boot_selection_is_refused"),
    decl_ref(module_path: "test.claim.host.managed_host_boot_witness", decl_name: "w_the_handoff_admission_discriminates_on_every_managed_hosts_rows"),
    decl_ref(module_path: "test.claim.host.managed_host_boot_witness", decl_name: "w_a_second_machine_with_the_same_profile_gets_the_same_selection"),
    decl_ref(module_path: "test.claim.host.managed_host_boot_witness", decl_name: "w_a_reflash_resolves_the_new_builds_row_or_refuses_with_no_per_unit_edit"),
    decl_ref(module_path: "test.claim.host.managed_host_boot_witness", decl_name: "w_the_observed_reflash_to_0_45_3_resolves_that_builds_row_and_still_admits"),
    // The 0.45.3 attestation claim rebuilds the host fixture at that release, so it is an admitted caller too.
    decl_ref(module_path: "test.claim.host.managed_host_boot_witness", decl_name: "w_the_0_45_3_row_is_attested_and_never_rendered_as_machine_read"),
    decl_ref(module_path: "test.claim.host.megarac_managed_host_witness", decl_name: "w_a_controller_observed_as_openbmc_is_refused_for_every_megarac_operation"),
    decl_ref(module_path: "test.claim.host.megarac_managed_host_witness", decl_name: "w_a_controller_whose_family_is_unobserved_is_refused_for_every_megarac_operation"),
    decl_ref(module_path: "test.claim.host.megarac_managed_host_witness", decl_name: "w_a_megarac_build_no_operation_was_executed_on_is_refused_for_every_operation"),
    decl_ref(module_path: "test.claim.host.megarac_managed_host_witness", decl_name: "w_a_secured_account_beside_another_controllers_access_is_admitted_for_no_operation"),
    decl_ref(module_path: "test.claim.host.megarac_managed_host_witness", decl_name: "w_another_baseboard_at_the_same_megarac_build_is_refused_for_every_operation"),
    decl_ref(module_path: "test.claim.host.megarac_managed_host_witness", decl_name: "w_an_account_is_released_only_with_the_controller_it_was_bound_to"),
    decl_ref(module_path: "test.claim.machine_intake.dimm_physical_orientation_witness", decl_name: "w_the_same_anchors_on_another_reported_board_are_refused_unmodeled"),
    decl_ref(module_path: "test.claim.machine_intake.dimm_physical_orientation_witness", decl_name: "w_an_unobserved_controller_is_refused_at_the_binding_not_as_an_unmodeled_board"),
    decl_ref(module_path: "test.claim.machine_intake.fan_observe_witness", decl_name: "an_openbmc_bound_row_is_read_against_the_phosphor_policy"),
    decl_ref(module_path: "test.claim.machine_intake.fan_observe_witness", decl_name: "a_row_whose_family_is_unobserved_refuses_naming_the_missing_observation"),
    decl_ref(module_path: "test.claim.fleet_fan_converge_witness", decl_name: "variant_subject"),
  ]
{
  ManagedHost { host: host, access: access, secure: secure, unit_hold: unit_hold, smpro: smpro }
}

// THE SILICON STANDING OF A BOUND HOST: its SMpro site joined to the controller its bound route drives,
// minted by gunbc.machine_intake.ampere_smpro_observation smpro_pass_subject, which refuses a site that
// names another controller. The endpoint is read THROUGH the route's binding
// (gunbc.host.bmc_control_binding bmc_control_endpoint), never carried a second time, and a host with no
// bound route binds no subject. THE PLATFORM DECIDES WHETHER A PASS MAY BE TAKEN AT ALL: the subject is
// minted only where gunbc.host.smpro_platform_capability says the host's board admits an SoC family the
// cited carrying set names. A host whose family does not carry SMpro — or whose board admits no family at
// all, so nothing is known about its silicon — binds NO subject rather than an empty or refused one, which
// is what makes an x86 machine a valid controlled machine without needing to model an SMpro field it cannot
// have. (An earlier version carried a DECLARED FRONTIER here asserting every managed host was an Altra
// board and minting a subject for all of them: a host-name-shaped assumption sitting in generic code, and
// exactly the thing this cut's x86 RED exists to prevent.)
fn managed_host_smpro_subject(host: ManagedHost, control: BmcControlStanding) -> SmproSubjectOutcome {
  match control {
    BmcControlBound { route: r } =>
      match host.smpro {
        // The only arm that can take a pass, and the only one that reads a site.
        SmproPlatformCarried { family: _, site: site } =>
          match smpro_pass_subject(
            host: host.host,
            endpoint: bmc_control_route_endpoint(route: r),
            // The arm already holds an ADMITTED site; the mint's surface takes a standing, so it is
            // presented as admitted rather than the platform arm weakened back to a standing that
            // could hold a refusal.
            site: SmproSiteAdmitted { site: site },
          ) {
            SmproPassSubjectBound { subject: s } => SmproSubjectMinted { subject: s }
            SmproPassSiteRefused { cause: c } => SmproSubjectSiteRefused { cause: c }
            SmproPassEndpointMismatch { bound: b, site: st } => SmproSubjectEndpointMismatch { bound: b, site: st }
          }
        // Named, and named BY THE PLATFORM: the controller is bound and healthy here, so a message
        // claiming there is no controller would be false. The family is carried through so the reader
        // can see WHICH silicon was asked about.
        SmproPlatformSiteRefused { family: _, cause: cause } => SmproSubjectSiteRefused { cause: cause }
        SmproPlatformNotCarried { family: family } => SmproSubjectNotCarried { family: family }
        SmproPlatformUnestablished { cause: cause } => SmproSubjectUnestablished { cause: cause }
      }
    // No bound route, so there is nothing to read the interface through -- and WHICH route fact is
    // missing is carried as the cause, not restated as a sentence. Review 81287 F5: these three arms
    // used to mint prose claiming "no control route is bound to read SMpro through", which a witness
    // could only string-match, and which lost the difference between "never observed", "refused to
    // secure" and "the two ends name different machines". The BmcControlStanding arms already name
    // those facts precisely, so they ride through unchanged.
    BmcControlAccessUnobserved { endpoint: e } =>
      SmproSubjectUnestablished { cause: AccessUnobserved { endpoint: e } }
    BmcControlNotSecured { cause: c } =>
      SmproSubjectUnestablished { cause: ControlRouteNotSecured { cause: c } }
    BmcControlEndpointMismatch { observed: o, secured: sec } =>
      SmproSubjectUnestablished { cause: ControlEndpointMismatch { observed: o, secured: sec } }
  }
}

// WHETHER A HOST'S PLATFORM LICENCES AN SMpro PASS AT ALL, decided from the facility standing its bound
// board establishes. THE ROW ITSELF CARRIES THAT DECISION: ManagedHost.smpro is a SmproPlatformStanding,
// so the arms ARE the licensing -- Carried can take a pass, NotCarried and Unestablished bind no subject.
// The separate SmproPassLicensing standing that used to say this is DELETED: it was a second
// representation of the same three facts (parallel vocabulary, and one the mint could drift from), and the
// gate is falsified better by the outcome than by a shadow of it -- see managed_host_smpro_subject, whose
// SmproSubjectOutcome a mutation of the gate turns red.
