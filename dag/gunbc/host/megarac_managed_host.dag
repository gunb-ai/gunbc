module gunbc.megarac_managed_host

import std.types { Bool, List, NonEmptyStr, String }
import std.decl_ref { decl_ref }
import std.optional { Present, Absent }
import v2.std.algebra { filter }
import product.placement_supply { HostIdentity }
import extdeps.bmc.endpoint { AmiMegaRac, BmcControllerEndpoint, BmcFirmwareFamily, OpenBmc }
import extdeps.bmc.capability { BmcFirmwareReleaseIdentity, bmc_firmware_release_identity_eq }
import extdeps.bmc.access_profile { BmcObservedIdentity }
import gunbc.managed_host {
  ManagedHost, ManagedHostBinding, ManagedHostBindingStanding, ManagedHostBound, ManagedHostAccessUnobserved,
  ManagedHostNotSecured, ManagedHostEndpointMismatch, managed_host_binding, managed_hosts,
}
import gunbc.megarac_operation_standing {
  MegaRacOperation, MegaRacVirtualMediaAttach, MegaRacKvmCanvasStill, MegaRacSdrSocketNaming,
  MegaRacOperationEvidence, MegaRacCurrentBuild, CurrentBuildRead, CurrentBuildKnownUnread, CurrentBuildUnobserved,
  megarac_operation_executed_at, megarac_current_build,
}
import gunbc.machine_intake_megarac_operation_evidence { mtcollins1_megarac_operation_evidence }

// A MEGARAC-ONLY OPERATION ON A MANAGED HOST, ADMITTED FROM WHAT THE HOST'S CONTROLLER WAS OBSERVED TO
// BE (docs/plans/managed-host-untangle.md, cut 3). The BMC stack is read, never assumed: the family,
// baseboard and build come off the access observation gunbc.managed_host managed_host_binding bound,
// and a host whose binding refuses -- its access unobserved, its controller not secured, its observed
// endpoint not the secured one -- has no family to read and is refused here before any request. A bound
// controller of another family is refused by family.
//
// AN OPERATION IS ADMITTED ONLY WHERE IT IS GROUNDED. gunbc.megarac_operation_standing grounds an
// operation at an observed controller identity -- baseboard and firmware together -- from committed
// evidence (gunbc.machine_intake_megarac_operation_evidence): a receipt joined to a reading of that
// build. A MegaRAC appliance of another product line
// reporting the same raw version is refused, and so is Mt. Jade's MegaRAC at 2.11, which none of these
// operations was ever run on.
//
// TWO ADMISSIONS, AND ONE OF THEM IS A DECLARED RUNG DROP (gunbc.rung_drop
// megarac_operations_admitted_through_a_superseded_build_observation). admit_megarac_host grounds the
// operation at the build the binding's access observation read, and that observation can be historical:
// mtcollins1's reads 0.32 (2026-09-05) and the controller was reflashed to 0.45.3 on 2026-10-02.
// admit_megarac_host_at_current_build is the gate that closes it -- it admits only when the observation
// is the controller's CURRENT build and the operation is grounded at that build -- and it is built in
// shadow: cutting production over to it refuses mtcollins1's boot until a reading of 0.45.3 and
// executed evidence at it are committed, so the cut-over is one later transition (staging ruling C).
type AdmittedMegaRacHost sole_constructor {
  binding: ManagedHostBinding
  operation: MegaRacOperation
  firmware: BmcFirmwareReleaseIdentity
}

type MegaRacHostRefusal
  = MegaRacHostNotManaged { host: NonEmptyStr }
  | MegaRacHostNotBound { standing: ManagedHostBindingStanding }
  | MegaRacHostNotMegaRac { family: BmcFirmwareFamily }
  | MegaRacOperationNotGrounded { operation: MegaRacOperation, identity: BmcObservedIdentity }
  | MegaRacObservationNotCurrent { observed: BmcFirmwareReleaseIdentity, current: BmcFirmwareReleaseIdentity }
  | MegaRacCurrentBuildUnobserved { endpoint: BmcControllerEndpoint }

type MegaRacHostAdmission
  = MegaRacHostAdmitted { host: AdmittedMegaRacHost }
  | MegaRacHostRefused { cause: MegaRacHostRefusal }

// THE ROSTER OF COMMITTED OPERATION EVIDENCE, one unit's rows per line, as managed_hosts is one row per
// unit. The admission reads it and nothing else.
fn megarac_operation_evidence() -> MegaRacOperationEvidence {
  mtcollins1_megarac_operation_evidence()
}

// THE FAMILY AND BINDING STEP BOTH ADMISSIONS SHARE: a bound MegaRAC controller's binding, or the refusal.
type MegaRacBindingStep
  = MegaRacBindingAdmissible { binding: ManagedHostBinding }
  | MegaRacBindingRefused { cause: MegaRacHostRefusal }

fn megarac_binding_step(host: ManagedHost) -> MegaRacBindingStep {
  match managed_host_binding(host: host) {
    ManagedHostBound { binding: b } =>
      match b.observation.identity.firmware.family {
        AmiMegaRac => MegaRacBindingAdmissible { binding: b }
        OpenBmc => MegaRacBindingRefused { cause: MegaRacHostNotMegaRac { family: OpenBmc } }
      }
    ManagedHostAccessUnobserved { endpoint: e } => MegaRacBindingRefused { cause: MegaRacHostNotBound { standing: ManagedHostAccessUnobserved { endpoint: e } } }
    ManagedHostNotSecured { cause: c } => MegaRacBindingRefused { cause: MegaRacHostNotBound { standing: ManagedHostNotSecured { cause: c } } }
    ManagedHostEndpointMismatch { observed: o, secured: s } => MegaRacBindingRefused { cause: MegaRacHostNotBound { standing: ManagedHostEndpointMismatch { observed: o, secured: s } } }
  }
}

// THE ONE MINT OF AdmittedMegaRacHost, and it decides from the sealed evidence itself, never from a
// supplied verdict. It is admitted only to the two admissions below, each of which runs the binding and
// family step (and, for the gate, the current-build step) before reaching it.
fn megarac_grounded_admission(evidence: MegaRacOperationEvidence, binding: ManagedHostBinding, operation: MegaRacOperation, identity: BmcObservedIdentity) -> MegaRacHostAdmission
  admit_callers: [
    decl_ref(module_path: "gunbc.megarac_managed_host", decl_name: "admit_megarac_host_observed_in"),
    decl_ref(module_path: "gunbc.megarac_managed_host", decl_name: "admit_megarac_host_at_current_build"),
  ]
{
  if megarac_operation_executed_at(evidence: evidence, operation: operation, identity: identity) {
    MegaRacHostAdmitted { host: AdmittedMegaRacHost { binding: binding, operation: operation, firmware: identity.firmware } }
  } else {
    MegaRacHostRefused { cause: MegaRacOperationNotGrounded { operation: operation, identity: identity } }
  }
}

// PRODUCTION, FROZEN UNDER THE DECLARED DROP: grounded at the build the binding's observation read.
fn admit_megarac_host(host: ManagedHost, operation: MegaRacOperation) -> MegaRacHostAdmission {
  admit_megarac_host_observed_in(evidence: megarac_operation_evidence(), host: host, operation: operation)
}

fn admit_megarac_host_observed_in(evidence: MegaRacOperationEvidence, host: ManagedHost, operation: MegaRacOperation) -> MegaRacHostAdmission {
  match megarac_binding_step(host: host) {
    MegaRacBindingRefused { cause: c } => MegaRacHostRefused { cause: c }
    MegaRacBindingAdmissible { binding: b } => megarac_grounded_admission(evidence: evidence, binding: b, operation: operation, identity: b.observation.identity)
  }
}

// THE CURRENT-BUILD GATE (SHADOW). The controller's current build is the latest thing known of it: a
// reading, or a transition recorded after the latest reading. A binding whose observation reads any
// other build mints no carrier, and neither does a controller whose current build is known but unread
// or not known at all. Only then is the operation looked up, at the CURRENT reading's identity, and only
// an EXECUTED grounding admits: a route recovered from a served artifact is not evidence the operation
// ran, so the cut-over cannot stand on one.
fn admit_megarac_host_at_current_build(evidence: MegaRacOperationEvidence, host: ManagedHost, operation: MegaRacOperation) -> MegaRacHostAdmission {
  match megarac_binding_step(host: host) {
    MegaRacBindingRefused { cause: c } => MegaRacHostRefused { cause: c }
    MegaRacBindingAdmissible { binding: b } => {
      let observed = b.observation.identity.firmware
      match megarac_current_build(evidence: evidence, endpoint: b.observation.endpoint) {
        CurrentBuildUnobserved => MegaRacHostRefused { cause: MegaRacCurrentBuildUnobserved { endpoint: b.observation.endpoint } }
        CurrentBuildKnownUnread { transition: t } =>
          MegaRacHostRefused { cause: MegaRacObservationNotCurrent { observed: observed, current: t.to } }
        CurrentBuildRead { reading: r } =>
          if bmc_firmware_release_identity_eq(a: r.identity.firmware, b: observed) {
            megarac_grounded_admission(evidence: evidence, binding: b, operation: operation, identity: r.identity)
          } else {
            MegaRacHostRefused { cause: MegaRacObservationNotCurrent { observed: observed, current: r.identity.firmware } }
          }
      }
    }
  }
}

// THE SAME ADMISSION FOR A LABEL, over the rows it is given so the not-managed refusal has something to
// refuse: a caller that knows only a host's name reaches its row here and nowhere else.
fn megarac_host_admission_in(hosts: List<ManagedHost>, host: NonEmptyStr, operation: MegaRacOperation) -> MegaRacHostAdmission {
  match filter(hosts, h => (h.host as String) == (host as String)).first() {
    Absent => MegaRacHostRefused { cause: MegaRacHostNotManaged { host: host } }
    Present { value: h } => admit_megarac_host(host: h, operation: operation)
  }
}

fn megarac_host_admission_for(host: NonEmptyStr, operation: MegaRacOperation) -> MegaRacHostAdmission {
  megarac_host_admission_in(hosts: managed_hosts(), host: host, operation: operation)
}

fn megarac_operation_text(operation: MegaRacOperation) -> String {
  match operation {
    MegaRacVirtualMediaAttach => "virtual media attach"
    MegaRacKvmCanvasStill => "KVM canvas still"
    MegaRacSdrSocketNaming => "SDR socket naming"
  }
}

fn megarac_family_text(family: BmcFirmwareFamily) -> String {
  match family {
    AmiMegaRac => "AMI MegaRAC"
    OpenBmc => "OpenBMC"
  }
}

fn megarac_binding_refusal_text(standing: ManagedHostBindingStanding) -> String {
  match standing {
    ManagedHostBound { binding: _ } => "bound"
    ManagedHostAccessUnobserved { endpoint: e } => join(["the controller at ", e.host as String, " was never observed, so its BMC family is unread"], "")
    ManagedHostNotSecured { cause: _ } => "the controller is not BmcSecured, so there is no managed account to drive it with"
    ManagedHostEndpointMismatch { observed: o, secured: s } => join(["the observed controller ", o.host as String, " is not the secured one ", s.host as String], "")
  }
}

// THE TEXT A REFUSED CALLER PRINTS, naming the operation, so every refusal is located.
fn megarac_host_refusal_text(cause: MegaRacHostRefusal) -> NonEmptyStr {
  let why = match cause {
    MegaRacHostNotManaged { host: h } => join(["'", h as String, "' is not a managed host (gunbc.managed_host managed_hosts has no row for it)"], "")
    MegaRacHostNotBound { standing: s } => megarac_binding_refusal_text(standing: s)
    MegaRacHostNotMegaRac { family: f } => join(["the controller is observed as ", megarac_family_text(family: f), ", not AMI MegaRAC"], "")
    MegaRacOperationNotGrounded { operation: o, identity: i } =>
      join(["MegaRAC ", megarac_operation_text(operation: o), " is not grounded by committed evidence on this baseboard at firmware ", i.firmware.raw_version as String], "")
    MegaRacObservationNotCurrent { observed: o, current: c } =>
      join(["the access observation reads firmware ", o.raw_version as String, " but the controller's current build is ", c.raw_version as String], "")
    MegaRacCurrentBuildUnobserved { endpoint: e } => join(["no reading of the build of the controller at ", e.host as String, " is committed"], "")
  }
  concat(why, "; controller untouched") as NonEmptyStr
}

// THE HOST AN ADMITTED CARRIER IS FOR, so a caller holding another carrier (a unit-hold proof, a boot
// subject) can require the two name one host.
fn admitted_megarac_host_identity(host: AdmittedMegaRacHost) -> HostIdentity {
  host.binding.host.host
}
