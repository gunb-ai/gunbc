module gunbc.host.physical_machine_binding

// A SEALED JOIN OF THREE EXISTING AXES about one physical machine. It does not replace any of
// them with a bigger ManagedHost; it joins them so an EFFECT TARGET can name the exact physical
// subject (unit + current intake subject) plus the fleet and control standings that go with it,
// and REFUSES to seal that join when the axes point at different machines.
//
// A host label alone is insufficient to seal this join. A host identity can outlive a board
// swap, an arrival boots before any host identity exists, and a receipt taken before a DIMM or
// firmware change must not apply to the repaired assembly. Sealing requires the axes to agree on
// the physical unit:
//   axis 1  physical identity  = UnitKey + current MachineIntakeSubject
//                                (gunbc.machine_intake.subject)
//   axis 2  fleet binding      = PhysicalMachineFleetAxis? (the HostEnrollmentIntent and the
//                                allocation standing it sealed with; gunbc.fleet.fleet_enrollment;
//                                Absent before enrollment is valid)
//   axis 3  control standing   = BmcControlStanding?
//                                (gunbc.host.bmc_control_binding; the secured route keyed by
//                                controller endpoint + unit, never by host label)
//
// The operator supplies a HostIdentity; admission resolves it against the physical observation
// before any effect is permitted. See the ruling one_physical_machine_boot_transaction (one
// transaction surface, no label branching) and physical_and_guest_control_remain_distinct.
//
// AXIS 3 IS THE CONTROL STANDING, not a host label. It is cut 2's BmcControlStanding: the Bound arm
// carries a BmcControlBinding keyed by the observed controller endpoint and the unit whose credential
// secured it (never HostIdentity), and each refusal arm keeps its own cause uncoined. Like axis 2 it is
// present only when observed, and an UNENROLLED unit whose subject is valid still seals with a control
// standing present -- control does not require a HostIdentity.

import std.optional { Absent, Present }
import product.host_identity { HostIdentity, host_identity_eq }
import gunbc.machine_intake.subject {
  UnitKey,
  UnitKeyStanding,
  UnitKeyBound,
  UnitKeyRefused,
  UnitKeyRefusalCause,
  MachineIntakeSubject,
  compare_qualification_subject,
  SubjectCurrent,
  SubjectStale,
}
import gunbc.guarantee_stall { NextRungTrigger }
import gunbc.fleet.fleet_enrollment { HostEnrollmentIntent }
import gunbc.fleet.fleet_host_backing {
  HostUnitResolved,
  HostUnitRefused,
  HostUnitNotOwned,
  HostUnitUnobserved,
  resolve_host_unit,
}
import gunbc.host.bmc_control_binding { BmcControlStanding, BmcControlBound }

// THE SEALED JOIN. Every field names a separate existing axis; none is a ManagedHost.
type PhysicalMachineBinding sole_constructor {
  // axis 1: the physical unit + the CURRENT intake subject (the subject an effect must match).
  unit_key: UnitKey
  subject: MachineIntakeSubject
  // axis 2: the fleet enrollment for this host AND what its allocation check established, when
  // enrolled. Absent has ONE meaning: the machine is unenrolled (arrival, mtcollins1/mtjade1) --
  // RED3 -- so there is no allocation to check. An enrolled axis cannot be written without its
  // allocation standing, and an allocation standing cannot be written without an enrollment.
  fleet: PhysicalMachineFleetAxis?
  // axis 3: the control standing, when observed. Its presence needs no HostIdentity, and a
  // refusal-stance standing (NotSecured, AccessUnobserved, EndpointMismatch) is a HONEST observation
  // distinct from Absent (no observation taken) -- per dag_absence_is_one_meaning.
  control: BmcControlStanding?
}

// AXIS 2 AS ONE FACT: the enrollment and the allocation standing it sealed with travel together, so
// "enrolled" never reads as "allocation checked".
type PhysicalMachineFleetAxis {
  enrollment: HostEnrollmentIntent
  allocation: PhysicalMachineAllocationStanding
}

// WHAT RED2 ESTABLISHED FOR A SEALED, ENROLLED HOST. Only the two standings that seal are arms: a
// refused, not-owned or mismatched allocation refuses the join and never reaches a binding.
//   Verified    the allocation was read and resolved to THIS unit: RED2 ran and passed.
//   Unobserved  no board-serial observation yet: the seal stands (the frontier is not a
//               disagreement) and the DESIGN section 4b next-rung trigger travels inside the sealed
//               subject, so a consumer can report "admitted, allocation unverified until this read
//               lands" instead of mistaking the seal for a passed allocation check.
type PhysicalMachineAllocationStanding
  = PhysicalMachineAllocationVerified
  | PhysicalMachineAllocationUnobserved { trigger: NextRungTrigger }

// WHY THE JOIN WILL NOT SEAL. Each cause names the axis and the disagreement, so a consumer can
// report the exact refusal rather than a bare "no binding." NO ABSENT-UNIT CAUSE LIVES HERE, on
// purpose: UnitKeyStanding is the closed coproduct Bound|Refused, so "no unit at all" is not a
// fourth standing the fold could branch on -- the never-read state lives WHERE IT IS OBSERVED, as
// the Absent of HostBacking.unit (gunbc.fleet.fleet_host_backing), and it surfaces to this fold as
// PhysicalMachineAllocationUnobserved (the allocation frontier), not as a unit-key refusal.
//   PhysicalMachineUnitKeyRefused         axis 1: the unit was read but bind_unit_key refused it.
//   PhysicalMachineCurrentSubjectAbsent   axis 1: the unit is known but the subject was not observed.
//   PhysicalMachineSubjectUnitMismatch    axis 1: the supplied subject was built for another unit.
//   PhysicalMachineHostEnrollmentMismatch axis 2: the enrollment is for a different host than supplied.
//   PhysicalMachineHostAllocationNotOwned axis 2: the host's backing is a ProviderGuest (not physical).
//   PhysicalMachineHostAllocationRefused  axis 2: the backing unit read was refused.
//   PhysicalMachineHostAllocationMismatch axis 2: THE ALLOCATION POINTS AT ANOTHER UNIT (RED2).
//   PhysicalMachineControlSubjectMismatch axis 3: the bound control route secured another unit's credential.
type PhysicalMachineRefusalCause
  = PhysicalMachineUnitKeyRefused { cause: UnitKeyRefusalCause }
  | PhysicalMachineCurrentSubjectAbsent
  | PhysicalMachineSubjectUnitMismatch { physical_unit: UnitKey, subject_unit: UnitKey }
  | PhysicalMachineHostEnrollmentMismatch { supplied_host: HostIdentity, enrollment_host: HostIdentity }
  | PhysicalMachineHostAllocationNotOwned
  | PhysicalMachineHostAllocationRefused { cause: UnitKeyRefusalCause }
  | PhysicalMachineHostAllocationMismatch { physical_unit: UnitKey, allocated_unit: UnitKey }
  | PhysicalMachineControlSubjectMismatch { physical_unit: UnitKey, control_unit: UnitKey }

type PhysicalMachineAdmission
  = PhysicalMachineAdmitted { binding: PhysicalMachineBinding }
  | PhysicalMachineRefused { cause: PhysicalMachineRefusalCause }

// A host allocation whose unit has not yet been read seals fine: the fleet axis is present (the
// host is enrolled) and the hardware allocation is simply an unobserved frontier, not a machine
// identity the axes disagree on. Only an allocation that RESOLVES to a different unit refuses.
// axis 1: the physical unit; then the current subject; then (if enrolled) the host + allocation
// must agree on that unit (RED2); then axis 3.
fn physical_machine_admission(
  host: HostIdentity,
  unit_standing: UnitKeyStanding,
  current_subject: MachineIntakeSubject?,
  fleet: HostEnrollmentIntent?,
  control: BmcControlStanding?,
) -> PhysicalMachineAdmission {
  match unit_standing {
    UnitKeyRefused { cause } => PhysicalMachineRefused { cause: PhysicalMachineUnitKeyRefused { cause } }
    UnitKeyBound { key: unit } =>
      match current_subject {
        Absent => PhysicalMachineRefused { cause: PhysicalMachineCurrentSubjectAbsent }
        Present { value: subject } =>
          match (subject.subject.unit_key == unit) {
            true => physical_machine_fleet(unit: unit, host: host, subject: subject, fleet: fleet, control: control)
            false =>
              PhysicalMachineRefused {
                cause: PhysicalMachineSubjectUnitMismatch { physical_unit: unit, subject_unit: subject.subject.unit_key }
              }
          }
      }
  }
}

// axis 2: if enrolled, the enrollment must be for THIS host and its allocation must not point at a
// different unit. An allocation not yet read is an unobserved frontier, not a disagreement.
fn physical_machine_fleet(
  unit: UnitKey,
  host: HostIdentity,
  subject: MachineIntakeSubject,
  fleet: HostEnrollmentIntent?,
  control: BmcControlStanding?,
) -> PhysicalMachineAdmission {
  match fleet {
    Absent => physical_machine_axis3(unit: unit, subject: subject, fleet: Absent, control: control)
    Present { value: enrollment } =>
      match (host_identity_eq(a: host, b: enrollment.host)) {
        true => physical_machine_allocation(unit: unit, subject: subject, control: control, enrollment: enrollment)
        false =>
          PhysicalMachineRefused {
            cause: PhysicalMachineHostEnrollmentMismatch { supplied_host: host, enrollment_host: enrollment.host }
          }
      }
  }
}

// the enrolled host's allocation must resolve to THIS unit (RED2); not-owned refuses; refused
// serials refuse; an unobserved allocation seals with the fleet axis present.
fn physical_machine_allocation(
  unit: UnitKey,
  subject: MachineIntakeSubject,
  control: BmcControlStanding?,
  enrollment: HostEnrollmentIntent,
) -> PhysicalMachineAdmission {
  match resolve_host_unit(backing: enrollment.backing) {
    HostUnitNotOwned => PhysicalMachineRefused { cause: PhysicalMachineHostAllocationNotOwned }
    HostUnitRefused { cause } => PhysicalMachineRefused { cause: PhysicalMachineHostAllocationRefused { cause } }
    HostUnitUnobserved { trigger } =>
      physical_machine_axis3(
        unit: unit,
        subject: subject,
        fleet: Present {
          value: PhysicalMachineFleetAxis {
            enrollment,
            allocation: PhysicalMachineAllocationUnobserved { trigger },
          }
        },
        control: control,
      )
    HostUnitResolved { unit: allocated } =>
      match (allocated == unit) {
        true =>
          physical_machine_axis3(
            unit: unit,
            subject: subject,
            fleet: Present {
              value: PhysicalMachineFleetAxis { enrollment, allocation: PhysicalMachineAllocationVerified }
            },
            control: control,
          )
        false =>
          PhysicalMachineRefused {
            cause: PhysicalMachineHostAllocationMismatch { physical_unit: unit, allocated_unit: allocated }
          }
      }
  }
}

// axis 3 is checked last: a BOUND control route must secure THIS unit's credential. A refusal-stance
// standing (NotSecured / AccessUnobserved / EndpointMismatch) is an honest observation of the route,
// not a machine-identity disagreement -- it seals (the cause travels inside the standing, uncoined).
// Only a Bound route for ANOTHER unit refuses: that control fact belongs to a different machine.
fn physical_machine_axis3(
  unit: UnitKey,
  subject: MachineIntakeSubject,
  fleet: PhysicalMachineFleetAxis?,
  control: BmcControlStanding?,
) -> PhysicalMachineAdmission {
  match control {
    Absent =>
      PhysicalMachineAdmitted {
        binding: PhysicalMachineBinding {
          unit_key: unit,
          subject,
          fleet,
          control: Absent,
        }
      }
    Present { value: BmcControlBound { route } } =>
      match (route.binding.unit == unit) {
        true =>
          PhysicalMachineAdmitted {
            binding: PhysicalMachineBinding {
              unit_key: unit,
              subject,
              fleet,
              control: control,
            }
          }
        false =>
          PhysicalMachineRefused {
            cause: PhysicalMachineControlSubjectMismatch {
              physical_unit: unit,
              control_unit: route.binding.unit,
            }
          }
      }
    Present { value: standing } =>
      PhysicalMachineAdmitted {
        binding: PhysicalMachineBinding {
          unit_key: unit,
          subject,
          fleet,
          control: Present { value: standing },
        }
      }
  }
}

// RECEIPT CURRENCY FOR THE SEALED SUBJECT. A receipt taken against a subject (the MachineIntakeSubject
// it named at effect time) APPLIES to the sealed binding only when it names the same physical unit
// AND its qualification subject is still the current one -- i.e. compare_qualification_subject says
// SubjectCurrent. A receipt taken before a DIMM or firmware change is SubjectStale and does NOT apply
// to the repaired assembly (RED1). This reuses the existing subject-currency vocabulary, not a new
// join.
fn receipt_applies_to_binding(binding: PhysicalMachineBinding, receipt_subject: MachineIntakeSubject) -> Bool {
  let unit_ok = receipt_subject.subject.unit_key == binding.unit_key
  match compare_qualification_subject(admitted: receipt_subject.subject, observed: binding.subject.subject) {
    SubjectCurrent => unit_ok
    SubjectStale { axes: _ } => false
  }
}
