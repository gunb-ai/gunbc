// ── THE INTERLOCK THE PER-RUN APPROVAL WAS PROVIDING WITHOUT SAYING SO ────────────────────────
//
// Until 2026-09-23 every boot of a hand-serviced unit waited for one operator tap, and the operator tapped only
// when nobody had hands in the chassis. That consent carried two facts: "this effect may run" and
// "the unit is not under maintenance right now". The operator ruling of 2026-09-23 retired the
// first (the boot is a recurring automated effect; gunbc.auth.privileged_effect_census derives the
// federated pattern for it). The second is a physical-safety fact about the unit, not about who may
// authorize, so it does not dissolve with the approval stage: a boot that power-cycles a unit whose
// DIMMs are being reseated is the harm. It is carried here as ONE std.durable_exclusive_hold slot
// per unit, keyed by the key its gunbc.managed_host ManagedHost row declares (unit_hold). Nothing here
// names a unit: which hosts have a hold, under which key and on which store host, is read off the row.
//
// ONE SLOT, TWO KINDS OF HOLDER, AND THAT IS THE POINT. The operator takes the slot for
// maintenance; the boot run takes the SAME slot before any BMC actuation and frees it after. So
// the boot refuses while the operator holds it (FileHoldOccupied, typed, naming the holder), the
// operator cannot start maintenance mid-boot without seeing the run as holder, and two boot runs
// exclude each other -- the exclusion the grant-keyed authorization claim slot supplied, now keyed
// by the unit rather than by an approval that no longer exists.
//
// THE STORE IS THE FILE-BACKED CAS ON THE RUNNER HOST (gunbc.durable_exclusive_hold_file_store),
// where the boot job runs and where the operator's own session takes the hold. An undecodable slot
// or an unavailable store REFUSES the boot: an interlock that cannot be read is not released.

data unit_hold_store_root: NonEmptyStr = "/var/lib/gunbc/unit-holds" as NonEmptyStr

// ── THE ADMISSION: WHICH HOSTS HAVE A HOLD AT ALL ─────────────────────────────────────────────
// Taking, releasing or checking a unit hold is an operation on a managed host, and its policy is the
// row's own unit_hold decision. A host whose row says ResetNoUnitHold has no slot, and a label that
// names no row of managed_hosts() is not a host this fleet drives; both are typed refusals, and no
// arm falls back to a key spelled from the label. AdmittedUnitHoldSubject is sole_constructor and
// admit_unit_hold_subject is its only mint, so every acquire, release and proof check below is fed a
// key and a store host that came from a ManagedHost row and from nowhere else.
type AdmittedUnitHoldSubject sole_constructor {
  host: ManagedHost
  key: NonEmptyStr
  store_host: NonEmptyStr
}

type UnitHoldAdmission
  = UnitHoldSubjectAdmitted { subject: AdmittedUnitHoldSubject }
  | UnitHoldNotRequired { host: HostIdentity }

fn admit_unit_hold_subject(host: ManagedHost) -> UnitHoldAdmission {
  match host.unit_hold {
    ResetUnitHoldRequired { key: k, store_host: s } =>
      UnitHoldSubjectAdmitted { subject: AdmittedUnitHoldSubject { host: host, key: k, store_host: s } }
    ResetNoUnitHold => UnitHoldNotRequired { host: host.host }
  }
}

// THE SAME ADMISSION FOR A LABEL, over the rows it is given so the refusals have something to refuse:
// a caller that knows only a host's name (an operator's argument, a unit procedure's own identity)
// reaches the row here and nowhere else.
type UnitHoldHostAdmission
  = UnitHoldHostAdmitted { subject: AdmittedUnitHoldSubject }
  | UnitHoldHostNotManaged { host: NonEmptyStr }
  | UnitHoldHostNotRequired { host: HostIdentity }

fn unit_hold_admission_in(hosts: List<ManagedHost>, host: NonEmptyStr) -> UnitHoldHostAdmission {
  fold(
    hosts,
    init: UnitHoldHostNotManaged { host: host },
    f: (acc, h) => match acc {
      UnitHoldHostAdmitted { subject: _ } => acc
      UnitHoldHostNotRequired { host: _ } => acc
      UnitHoldHostNotManaged { host: _ } =>
        if (h.host as String) == (host as String) {
          match admit_unit_hold_subject(host: h) {
            UnitHoldSubjectAdmitted { subject: s } => UnitHoldHostAdmitted { subject: s }
            UnitHoldNotRequired { host: x } => UnitHoldHostNotRequired { host: x }
          }
        } else {
          acc
        }
    },
  )
}

fn unit_hold_admission_for(host: NonEmptyStr) -> UnitHoldHostAdmission {
  unit_hold_admission_in(hosts: managed_hosts(), host: host)
}

// Absent means the host was admitted; the text is what a refused caller prints.
fn unit_hold_host_admission_refusal(admission: UnitHoldHostAdmission) -> NonEmptyStr? {
  match admission {
    UnitHoldHostAdmitted { subject: _ } => none
    UnitHoldHostNotManaged { host: h } =>
      Present { value: join(["'", h as String, "' is not a managed host (gunbc.managed_host managed_hosts has no row for it), so it has no unit hold; nothing was taken, released or written"], "") as NonEmptyStr }
    UnitHoldHostNotRequired { host: h } =>
      Present { value: join(["managed host '", h as String, "' declares no unit hold (ResetNoUnitHold), so there is no hold slot for it; nothing was taken, released or written"], "") as NonEmptyStr }
  }
}

// THE HOSTS A HOLD STORE MUST EXIST ON: every store host some managed host's hold names, each once,
// in row order. gunbc.runner_host_grants provisions the store root on exactly these. The named hosts
// are gathered by prepending and reversed once, and std.list distinct_by_key removes repeats through
// its keyed map, so neither step copies an accumulator or scans one per row.
fn unit_hold_named_store_hosts_reversed(hosts: List<ManagedHost>) -> List<NonEmptyStr> {
  fold(
    hosts,
    init: [],
    f: (acc, h) => match admit_unit_hold_subject(host: h) {
      UnitHoldNotRequired { host: _ } => acc
      UnitHoldSubjectAdmitted { subject: s } => concat([s.store_host], acc)
    },
  )
}

fn unit_hold_store_hosts_of(hosts: List<ManagedHost>) -> List<NonEmptyStr> {
  distinct_by_key(xs: reverse(unit_hold_named_store_hosts_reversed(hosts: hosts)), key: fn(h) { h as String })
}

fn unit_hold_store_hosts() -> List<NonEmptyStr> {
  unit_hold_store_hosts_of(hosts: managed_hosts())
}

// ── THE STORE IS A LOCAL DIRECTORY, SO THE PROCESS MUST BE ON THE STORE HOST ───────────────────
// unit_hold_store_root is a path on whatever machine runs this code. An admitted subject names the
// host its store lives on, and a take, release or acquire run anywhere else would succeed against that
// other machine's empty directory while the real store stayed free: an interlock held where nobody
// looks. So every store effect below is fed a UnitHoldStoreExecutor, and that carrier exists only
// when THIS PROCESS OBSERVED its own short hostname (os.Hostname.ReadShort) and it equals the
// hostname gunbc.hostname_allocation allocates to the subject's store host -- the same two
// authorities gunbc.host_reset_return_run observer_self_corroboration reads to establish which
// machine a run is on. A label a caller supplies is not that observation, so there is no parameter
// for one: unit_hold_store_executor performs the read itself. A store host with no allocated
// hostname, and a hostname that cannot be read, refuse; neither is treated as a match.
type UnitHoldStoreExecutorDecision
  = UnitHoldExecutorIsStoreHost { observed: NonEmptyStr }
  | UnitHoldExecutorElsewhere { observed: NonEmptyStr, store_host: NonEmptyStr, allocated: NonEmptyStr }
  | UnitHoldStoreHostUnallocated { store_host: NonEmptyStr }
  | UnitHoldExecutorUnread { store_host: NonEmptyStr }

// THE DECISION IS A PURE FOLD OVER A SUPPLIED READING, so a witness can show both sides of it; it
// returns a decision and never the carrier. Absent means the hostname could not be read.
fn unit_hold_store_executor_decision(subject: AdmittedUnitHoldSubject, observed: String?) -> UnitHoldStoreExecutorDecision {
  match canonical_hostname_for_fleet_slot(fleet_slot: subject.store_host as HostIdentity) {
    Absent => UnitHoldStoreHostUnallocated { store_host: subject.store_host }
    Present { value: allocated } =>
      match observed {
        Absent => UnitHoldExecutorUnread { store_host: subject.store_host }
        Present { value: raw } =>
          if trim(s: raw) == "" {
            UnitHoldExecutorUnread { store_host: subject.store_host }
          } else if trim(s: raw) == (allocated as String) {
            UnitHoldExecutorIsStoreHost { observed: trim(s: raw) as NonEmptyStr }
          } else {
            UnitHoldExecutorElsewhere { observed: trim(s: raw) as NonEmptyStr, store_host: subject.store_host, allocated: allocated as String as NonEmptyStr }
          }
      }
  }
}

fn unit_hold_store_executor_refusal(key: NonEmptyStr, decision: UnitHoldStoreExecutorDecision) -> NonEmptyStr? {
  match decision {
    UnitHoldExecutorIsStoreHost { observed: _ } => none
    UnitHoldExecutorElsewhere { observed: o, store_host: h, allocated: a } =>
      Present { value: join(["the unit hold store for '", key as String, "' is on '", h as String, "' (hostname '", a as String, "'), and this process observes its own host as '", o as String, "'; a hold taken or released here would act on a store nobody reads; nothing was read or written"], "") as NonEmptyStr }
    UnitHoldStoreHostUnallocated { store_host: h } =>
      Present { value: join(["the unit hold store for '", key as String, "' is on '", h as String, "', which has no hostname allocated in gunbc.hostname_allocation, so this process cannot establish that it runs there; nothing was read or written"], "") as NonEmptyStr }
    UnitHoldExecutorUnread { store_host: h } =>
      Present { value: join(["the unit hold store for '", key as String, "' is on '", h as String, "', and this process could not read its own short hostname, so it cannot establish that it runs there; nothing was read or written"], "") as NonEmptyStr }
  }
}

type UnitHoldStoreExecutor sole_constructor {
  subject: AdmittedUnitHoldSubject
  observed_hostname: NonEmptyStr
}

type UnitHoldStoreExecutorStanding
  = UnitHoldOnStoreHost { executor: UnitHoldStoreExecutor }
  | UnitHoldNotOnStoreHost { reason: NonEmptyStr }

// THE ONE MINT OF THE EXECUTOR CARRIER, and it reads the hostname itself.
fn unit_hold_store_executor(subject: AdmittedUnitHoldSubject) -> UnitHoldStoreExecutorStanding {
  let read = os.Hostname.ReadShort()
  let observed = if read.success { Present { value: read.value } } else { none }
  let decision = unit_hold_store_executor_decision(subject: subject, observed: observed)
  match decision {
    UnitHoldExecutorIsStoreHost { observed: o } => UnitHoldOnStoreHost { executor: UnitHoldStoreExecutor { subject: subject, observed_hostname: o } }
    UnitHoldExecutorElsewhere { observed: _, store_host: _, allocated: _ } => unit_hold_not_on_store_host(key: subject.key, decision: decision)
    UnitHoldStoreHostUnallocated { store_host: _ } => unit_hold_not_on_store_host(key: subject.key, decision: decision)
    UnitHoldExecutorUnread { store_host: _ } => unit_hold_not_on_store_host(key: subject.key, decision: decision)
  }
}

fn unit_hold_not_on_store_host(key: NonEmptyStr, decision: UnitHoldStoreExecutorDecision) -> UnitHoldStoreExecutorStanding {
  match unit_hold_store_executor_refusal(key: key, decision: decision) {
    Present { value: r } => UnitHoldNotOnStoreHost { reason: r }
    Absent => UnitHoldNotOnStoreHost { reason: "unit hold store executor decision unclassified; nothing was read or written" as NonEmptyStr }
  }
}

// WHO HOLDS THE UNIT IS A DECLARED SUM (review 70459), each kind carrying its detail. The durable
// owner string is RENDERED from it and DECODED back to it here, in one place: nothing else builds an
// owner string or reads a kind out of one.
//
// A BOOT RUN IS A PROCESS, SO ITS OWNER NAMES THE PROCESS (gunbc#12533 finding 2). A run id alone
// says which attempt took the slot and nothing about whether that attempt is still running, so a
// worker killed while holding the unit left a hold nobody could ever show to be dead, and every later
// attempt refused on it. The boot's owner therefore carries the holding process's identity -- boot id,
// pid and start time, gunbc.build_cache_instance ProcessIdentity, the triple that survives pid reuse
// and reboots -- and the PID NAMESPACE it was read in (review 72326): a pid means something only in
// its namespace, and boot_id is shared by every namespace on a host, so a successor in another
// namespace would find NotFound for a holder that is alive. A successor recovers the slot only after
// OBSERVING that process gone FROM THE HOLDER'S OWN NAMESPACE; from any other it cannot look. An operator
// maintenance hold is deliberately not a process (it outlives the session that took it), so it is
// never recovered; a host reset-return hold names no process yet, so it is never recovered either.
type UnitHoldOwner
  = OperatorMaintenance { reason: NonEmptyStr }
  | BootRun { run_id: NonEmptyStr, process: ProcessIdentity, pid_namespace: NonEmptyStr }
  | HostResetReturn { attempt: NonEmptyStr }
  | KvmObserverProbe { run_id: NonEmptyStr, process: ProcessIdentity, pid_namespace: NonEmptyStr }

fn unit_hold_owner_tag(o: UnitHoldOwner) -> String {
  match o {
    OperatorMaintenance { reason: _ } => "operator-maintenance:"
    BootRun { run_id: _, process: _, pid_namespace: _ } => "boot-run:"
    HostResetReturn { attempt: _ } => "host-reset-return:"
    KvmObserverProbe { run_id: _, process: _, pid_namespace: _ } => "kvm-observer:"
  }
}

// THE PROCESS PART OF A BOOT OWNER, rendered after the run id and decoded back here and nowhere else:
// `@boot=<boot_id>,pid=<pid>,start=<starttime ticks>,pidns=<namespace link target>`.
data unit_hold_process_marker: String = "@boot="

fn unit_hold_process_text(p: ProcessIdentity, pid_namespace: NonEmptyStr) -> String {
  join([unit_hold_process_marker, p.boot_id as String, ",pid=", to_string(p.pid), ",start=", p.start_time as String, ",pidns=", pid_namespace as String], "")
}

type UnitHoldHolderProcess {
  process: ProcessIdentity
  pid_namespace: NonEmptyStr
}

fn text_at(xs: List<String>, i: Int) -> String {
  match xs.skip(n: i).first() {
    Present { value: v } => v
    Absent => ""
  }
}

fn unit_hold_process_decode(text: String) -> UnitHoldHolderProcess? {
  let parts = split(s: text, delimiter: ",")
  if count(parts) != 4 {
    none
  } else {
    let b = text_at(xs: parts, i: 0)
    let pid_text = text_at(xs: parts, i: 1)
    let start_text = text_at(xs: parts, i: 2)
    let ns_text = text_at(xs: parts, i: 3)
    if !starts_with(s: b, prefix: "boot=") || !starts_with(s: pid_text, prefix: "pid=") || !starts_with(s: start_text, prefix: "start=") || !starts_with(s: ns_text, prefix: "pidns=") {
      none
    } else {
      let boot = substring(s: b, start: 5, end: string_length(b))
      let start = substring(s: start_text, start: 6, end: string_length(start_text))
      let ns = substring(s: ns_text, start: 6, end: string_length(ns_text))
      match parse_int(s: substring(s: pid_text, start: 4, end: string_length(pid_text))) {
        Absent => none
        Present { value: n } =>
          match checked_int_to_nat(n: n) {
            Absent => none
            Present { value: pid } =>
              if boot == "" || start == "" || ns == "" { none } else { Present { value: UnitHoldHolderProcess { process: ProcessIdentity { boot_id: boot as NonEmptyStr, pid: pid, start_time: start as NonEmptyStr }, pid_namespace: ns as NonEmptyStr } } }
          }
      }
    }
  }
}

fn unit_hold_owner_detail(o: UnitHoldOwner) -> String {
  match o {
    OperatorMaintenance { reason: r } => r as String
    BootRun { run_id: r, process: p, pid_namespace: n } => concat(r as String, unit_hold_process_text(p: p, pid_namespace: n))
    HostResetReturn { attempt: a } => a as String
    KvmObserverProbe { run_id: r, process: p, pid_namespace: n } => concat(r as String, unit_hold_process_text(p: p, pid_namespace: n))
  }
}

fn unit_hold_owner_ref(o: UnitHoldOwner) -> DurableHoldOwnerRef {
  concat(unit_hold_owner_tag(o: o), unit_hold_owner_detail(o: o)) as DurableHoldOwnerRef
}

fn unit_hold_owner_label(o: UnitHoldOwner) -> String {
  match o {
    OperatorMaintenance { reason: r } => concat("operator maintenance: ", r as String)
    BootRun { run_id: r, process: p, pid_namespace: _ } => join(["the boot run ", r as String, " (process ", to_string(p.pid), " on boot ", p.boot_id as String, ")"], "")
    HostResetReturn { attempt: a } => concat("host reset-return attempt ", a as String)
    KvmObserverProbe { run_id: r, process: p, pid_namespace: _ } => join(["the KVM observer probe run ", r as String, " (process ", to_string(p.pid), " on boot ", p.boot_id as String, ")"], "")
  }
}

// THE DECODE IS TOTAL OVER THE FOUR TAGS AND REFUSES ANYTHING ELSE: an owner string written by
// something other than this module is not guessed into a kind.
type UnitHoldOwnerDecode
  = UnitHoldOwnerDecoded { owner: UnitHoldOwner }
  | UnitHoldOwnerUnrecognized { raw: String }

fn unit_hold_owner_detail_after(raw: String, tag: String) -> NonEmptyStr? {
  let rest = substring(s: raw, start: string_length(tag), end: string_length(raw))
  if rest == "" { none } else { Present { value: rest as NonEmptyStr } }
}

fn decode_unit_hold_owner(owner: DurableHoldOwnerRef) -> UnitHoldOwnerDecode {
  let raw = owner as String
  let op = unit_hold_owner_tag(o: OperatorMaintenance { reason: "x" as NonEmptyStr })
  let boot = unit_hold_owner_tag(o: BootRun { run_id: "x" as NonEmptyStr, process: ProcessIdentity { boot_id: "x" as NonEmptyStr, pid: 1, start_time: "x" as NonEmptyStr }, pid_namespace: "x" as NonEmptyStr })
  let reset = unit_hold_owner_tag(o: HostResetReturn { attempt: "x" as NonEmptyStr })
  let probe = unit_hold_owner_tag(o: KvmObserverProbe { run_id: "x" as NonEmptyStr, process: ProcessIdentity { boot_id: "x" as NonEmptyStr, pid: 1, start_time: "x" as NonEmptyStr }, pid_namespace: "x" as NonEmptyStr })
  if starts_with(s: raw, prefix: op) {
    match unit_hold_owner_detail_after(raw: raw, tag: op) { Present { value: d } => UnitHoldOwnerDecoded { owner: OperatorMaintenance { reason: d } }  Absent => UnitHoldOwnerUnrecognized { raw: raw } }
  } else if starts_with(s: raw, prefix: boot) {
    match unit_hold_owner_detail_after(raw: raw, tag: boot) {
      Absent => UnitHoldOwnerUnrecognized { raw: raw }
      Present { value: d } => {
        let halves = split(s: d as String, delimiter: unit_hold_process_marker)
        if count(halves) != 2 || text_at(xs: halves, i: 0) == "" {
          UnitHoldOwnerUnrecognized { raw: raw }
        } else {
          match unit_hold_process_decode(text: concat("boot=", text_at(xs: halves, i: 1))) {
            Present { value: h } => UnitHoldOwnerDecoded { owner: BootRun { run_id: text_at(xs: halves, i: 0) as NonEmptyStr, process: h.process, pid_namespace: h.pid_namespace } }
            Absent => UnitHoldOwnerUnrecognized { raw: raw }
          }
        }
      }
    }
  } else if starts_with(s: raw, prefix: probe) {
    match unit_hold_owner_detail_after(raw: raw, tag: probe) {
      Absent => UnitHoldOwnerUnrecognized { raw: raw }
      Present { value: d } => {
        let halves = split(s: d as String, delimiter: unit_hold_process_marker)
        if count(halves) != 2 || text_at(xs: halves, i: 0) == "" {
          UnitHoldOwnerUnrecognized { raw: raw }
        } else {
          match unit_hold_process_decode(text: concat("boot=", text_at(xs: halves, i: 1))) {
            Present { value: h } => UnitHoldOwnerDecoded { owner: KvmObserverProbe { run_id: text_at(xs: halves, i: 0) as NonEmptyStr, process: h.process, pid_namespace: h.pid_namespace } }
            Absent => UnitHoldOwnerUnrecognized { raw: raw }
          }
        }
      }
    }
  } else if starts_with(s: raw, prefix: reset) {
    match unit_hold_owner_detail_after(raw: raw, tag: reset) { Present { value: d } => UnitHoldOwnerDecoded { owner: HostResetReturn { attempt: d } }  Absent => UnitHoldOwnerUnrecognized { raw: raw } }
  } else {
    UnitHoldOwnerUnrecognized { raw: raw }
  }
}

fn host_reset_owner(attempt: NonEmptyStr) -> DurableHoldOwnerRef {
  unit_hold_owner_ref(o: HostResetReturn { attempt: attempt })
}

// The operator names why they hold the unit; the reason is the owner, so a refused boot prints it.
fn operator_maintenance_owner(reason: NonEmptyStr) -> DurableHoldOwnerRef {
  unit_hold_owner_ref(o: OperatorMaintenance { reason: reason })
}

fn boot_run_owner(run_id: NonEmptyStr, process: ProcessIdentity, pid_namespace: NonEmptyStr) -> DurableHoldOwnerRef {
  unit_hold_owner_ref(o: BootRun { run_id: run_id, process: process, pid_namespace: pid_namespace })
}

// ── THE PROOF: MINTED ONLY INSIDE THE LIVE ACQUIRE'S FileHoldAcquired ARM ──────────────────────
// Every function that performs a BMC write on a hold-gated unit takes a UnitHoldProof, and the
// proof is sole_constructor: the compiler refuses a UnitHoldProof literal anywhere but this module
// (SoleConstructorViolation), and this module mints one in exactly one place -- the FileHoldAcquired
// arm of unit_hold_minted, admitted only to unit_hold_acquire and fed only that call's own live
// compare-and-set outcomes. A supplied or authored
// acquire outcome therefore cannot become a proof: the pure refusal fold below reads outcomes, and
// it returns text, never a proof. The proof carries the admitted subject it was acquired for, so what
// it proves -- this host's slot is held -- is read from the row that admitted it.
// test.claim.machine_intake.mtcollins1_unit_hold_forged_probe_witness_test enrolls
// test.probe.unit_hold_proof_forged_probe, where a forged proof is refused at the literal.
type UnitHoldProof sole_constructor {
  subject: AdmittedUnitHoldSubject
  owner: DurableHoldOwnerRef
  generation: CasGeneration
}

type UnitHoldAcquisition
  = UnitHeld { proof: UnitHoldProof }
  | UnitHoldRefused { reason: NonEmptyStr }

// THE DECISION TEXT IS A PURE FOLD OVER THE STORE'S TYPED OUTCOME, and it is the only thing a
// supplied outcome may feed. Absent means the outcome was an acquisition; it never mints anything.
fn unit_hold_refusal(outcome: FileHoldAcquireOutcome) -> NonEmptyStr? {
  match outcome {
    FileHoldAcquired { slot_key: _, owner: _, generation: _ } => none
    FileHoldOccupied { slot_key: k, holder: h, generation: _ } =>
      Present { value: join(["unit ", k as String, " is held by '", h as String, "'; no BMC actuation until it is released; controller untouched"], "") as NonEmptyStr }
    FileHoldAcquireLost { slot_key: k } =>
      Present { value: join(["lost the race for unit hold ", k as String, "; controller untouched"], "") as NonEmptyStr }
    FileHoldAcquireStoreUnavailable { slot_key: k, cause: _ } =>
      Present { value: join(["unit hold store unavailable for ", k as String, "; an unreadable interlock is not a released one; controller untouched"], "") as NonEmptyStr }
    FileHoldSlotUndecodable { slot_key: k, generation: _, detail: d } =>
      Present { value: join(["unit hold ", k as String, " undecodable (", d as String, "); controller untouched"], "") as NonEmptyStr }
    FileHoldKeyNotSlotAddressable { slot_key: k } =>
      Present { value: join(["unit hold key ", k as String, " is not slot-addressable; controller untouched"], "") as NonEmptyStr }
  }
}

// ── WHETHER A HOLDING PROCESS STILL RUNS, OBSERVED ─────────────────────────────────────────────
// The store and every holder that can be recovered run on one host (the admitted subject's
// store_host; each hold-owning root refuses any other), so the holder's process is observable through this host's
// procfs. Three reads decide it, each typed by the host's own error kind:
//   - /proc/sys/kernel/random/boot_id differs from the holder's boot -> the host rebooted since, so
//     every process of that boot is gone: OBSERVED DEAD;
//   - same boot, /proc/<pid>/stat is ABSENT (the host answered NotFound) -> no such process: DEAD;
//   - same boot, the stat reads and its starttime differs -> the pid was reused: DEAD;
//   - same boot, same starttime -> the holder runs: LIVE.
// Any read the host refused for another reason, and any content that does not parse, is
// UNOBSERVABLE: the holder may well be alive, and nothing here concludes otherwise from a failed look.
data proc_boot_id_path: String = "/proc/sys/kernel/random/boot_id"

data proc_self_stat_path: String = "/proc/self/stat"

// THE READER'S PID NAMESPACE (namespaces(7), pid_namespaces(7)): /proc/self/ns/pid is a symbolic link
// whose target, `pid:[<inode>]`, identifies the namespace; two processes share a pid namespace exactly
// when the targets are equal. It is read with readlink(1), because the link is not a readable file.
data proc_self_pid_namespace_path: String = "/proc/self/ns/pid"

type PidNamespaceReading
  = PidNamespaceRead { namespace: NonEmptyStr }
  | PidNamespaceUnread { cause: NonEmptyStr }

fn own_pid_namespace() -> PidNamespaceReading {
  match run_shell_command_capture(command: readlink_command(path: proc_self_pid_namespace_path), transport: LocalExec) {
    ProcessOutputPresent { text: t } =>
      if trim(s: t) == "" { PidNamespaceUnread { cause: "readlink /proc/self/ns/pid printed nothing" as NonEmptyStr } }
      else { PidNamespaceRead { namespace: trim(s: t) as NonEmptyStr } }
    ProcessOutputAbsent => PidNamespaceUnread { cause: "readlink /proc/self/ns/pid printed nothing" as NonEmptyStr }
    ProcessRefused { exit_code: c, stderr: e } => PidNamespaceUnread { cause: join(["readlink /proc/self/ns/pid exited ", to_string(c), ": ", e], "") as NonEmptyStr }
  }
}

fn exact_read_of(path: String) -> FilesystemExactRead {
  let read = Filesystem.Read(path: path)
  filesystem_exact_read(path: path, content: read.content, success: read.success, error: read.error, error_kind: read.error_kind)
}

type ExactText
  = ExactTextRead { text: String }
  | ExactTextAbsent
  | ExactTextUnread { cause: NonEmptyStr }

fn exact_text(path: String) -> ExactText {
  match exact_read_of(path: path) {
    FilesystemExactPathRead { path: _, content: c } => ExactTextRead { text: c }
    FilesystemExactPathAbsent { path: _ } => ExactTextAbsent
    FilesystemExactPathUnreadable { path: _, kind: _, error: e } => ExactTextUnread { cause: join([path, " could not be read: ", e], "") as NonEmptyStr }
    FilesystemExactPathKindUnrecognized { path: _, observed: o, error: e } => ExactTextUnread { cause: join([path, " failed with an unrecognized error kind ", o, ": ", e], "") as NonEmptyStr }
  }
}

fn start_time_text(stat: String) -> String? {
  match proc_pid_stat_start_time(content: stat) {
    StartTimeObserved { ticks_since_boot: t } => Present { value: to_string(t) }
    _ => none
  }
}

// THE NAMESPACE GATE COMES FIRST: only a reader in the holder's own pid namespace can conclude
// anything from a pid, so a reader elsewhere -- or one that cannot name its namespace -- cannot look.
fn holder_process_liveness(p: ProcessIdentity, pid_namespace: NonEmptyStr) -> DurableHoldHolderLiveness {
  match own_pid_namespace() {
    PidNamespaceUnread { cause: c } => HolderLivenessUnobservable { cause: c }
    PidNamespaceRead { namespace: mine } =>
      if (mine as String) != (pid_namespace as String) {
        HolderLivenessUnobservable { cause: join(["the holder's pid namespace is ", pid_namespace as String, " and this reader's is ", mine as String, "; its pid cannot be looked up from here"], "") as NonEmptyStr }
      } else {
        holder_process_liveness_in_namespace(p: p)
      }
  }
}

fn holder_process_liveness_in_namespace(p: ProcessIdentity) -> DurableHoldHolderLiveness {
  match exact_text(path: proc_boot_id_path) {
    ExactTextAbsent => HolderLivenessUnobservable { cause: concat(proc_boot_id_path, " is absent on this host") as NonEmptyStr }
    ExactTextUnread { cause: c } => HolderLivenessUnobservable { cause: c }
    ExactTextRead { text: t } => {
      let now = trim(s: t)
      if now == "" {
        HolderLivenessUnobservable { cause: concat(proc_boot_id_path, " was empty") as NonEmptyStr }
      } else if now != (p.boot_id as String) {
        HolderObservedDead { evidence: join(["the host has booted since the holder started (boot ", p.boot_id as String, ", now ", now, ")"], "") as NonEmptyStr }
      } else {
        let stat_path = join(["/proc/", to_string(p.pid), "/stat"], "")
        match exact_text(path: stat_path) {
          ExactTextAbsent => HolderObservedDead { evidence: join(["no process ", to_string(p.pid), " on the holder's boot (", stat_path, " not found)"], "") as NonEmptyStr }
          ExactTextUnread { cause: c } => HolderLivenessUnobservable { cause: c }
          ExactTextRead { text: stat } =>
            match start_time_text(stat: stat) {
              Absent => HolderLivenessUnobservable { cause: concat(stat_path, " carried no readable starttime") as NonEmptyStr }
              Present { value: st } =>
                if st == (p.start_time as String) {
                  HolderObservedLive { evidence: join(["process ", to_string(p.pid), " started at tick ", st, " still runs"], "") as NonEmptyStr }
                } else {
                  HolderObservedDead { evidence: join(["pid ", to_string(p.pid), " now names another process (start tick ", st, ", holder's ", p.start_time as String, ")"], "") as NonEmptyStr }
                }
            }
        }
      }
    }
  }
}

// THIS PROCESS'S OWN IDENTITY, read from the same procfs a successor will read it back through: the
// boot id, and pid and starttime from ONE read of /proc/self/stat. A boot that cannot name itself does
// not take the unit -- a hold it could never be shown dead in is the lockout this replaces.
type SelfProcessIdentity
  = SelfIdentified { process: ProcessIdentity, pid_namespace: NonEmptyStr }
  | SelfUnidentified { cause: NonEmptyStr }

fn self_process_identity() -> SelfProcessIdentity {
  match exact_text(path: proc_boot_id_path) {
    ExactTextAbsent => SelfUnidentified { cause: concat(proc_boot_id_path, " is absent on this host") as NonEmptyStr }
    ExactTextUnread { cause: c } => SelfUnidentified { cause: c }
    ExactTextRead { text: b } => {
      let boot = trim(s: b)
      match exact_text(path: proc_self_stat_path) {
        ExactTextAbsent => SelfUnidentified { cause: concat(proc_self_stat_path, " is absent on this host") as NonEmptyStr }
        ExactTextUnread { cause: c } => SelfUnidentified { cause: c }
        ExactTextRead { text: stat } =>
          match proc_pid_stat_pid(content: stat) {
            PidUnparseable { field: f } => SelfUnidentified { cause: concat("/proc/self/stat carried no pid: ", f) as NonEmptyStr }
            PidObserved { pid: n } =>
              match start_time_text(stat: stat) {
                Absent => SelfUnidentified { cause: "/proc/self/stat carried no readable starttime" as NonEmptyStr }
                Present { value: st } =>
                  match checked_int_to_nat(n: n) {
                    Absent => SelfUnidentified { cause: "/proc/self/stat pid is not a natural number" as NonEmptyStr }
                    Present { value: pid } =>
                      if boot == "" { SelfUnidentified { cause: concat(proc_boot_id_path, " was empty") as NonEmptyStr } }
                      else {
                        match own_pid_namespace() {
                          PidNamespaceUnread { cause: c } => SelfUnidentified { cause: c }
                          PidNamespaceRead { namespace: n } => SelfIdentified { process: ProcessIdentity { boot_id: boot as NonEmptyStr, pid: pid, start_time: st as NonEmptyStr }, pid_namespace: n }
                        }
                      }
                  }
              }
          }
      }
    }
  }
}

// ── RECOVERING A HOLD WHOSE HOLDER WAS OBSERVED DEAD ───────────────────────────────────────────
// Only a holder whose owner names a process can be observed, so only a decoded BootRun or
// KvmObserverProbe is looked at;
// every other owner is reported as not recoverable. The liveness verdict is bound to the holder and
// generation the refused acquire saw, and the recovery re-reads the slot, so a hold that changed hands
// in between is not the one freed. Age is never an input.
// WHICH HOLDERS ARE OBSERVED, AS A PURE ROUTE: a holder whose decoded owner names a process -- a boot run
// or a KVM observer probe -- is observed by that process; every other owner is unobservable, with why.
type HolderLivenessRoute
  = HolderObserveProcess { process: ProcessIdentity, pid_namespace: NonEmptyStr }
  | HolderNotObservable { cause: NonEmptyStr }

fn holder_liveness_route(holder: DurableHoldOwnerRef) -> HolderLivenessRoute {
  match decode_unit_hold_owner(owner: holder) {
    UnitHoldOwnerDecoded { owner: BootRun { run_id: _, process: p, pid_namespace: n } } => HolderObserveProcess { process: p, pid_namespace: n }
    UnitHoldOwnerDecoded { owner: KvmObserverProbe { run_id: _, process: p, pid_namespace: n } } => HolderObserveProcess { process: p, pid_namespace: n }
    UnitHoldOwnerDecoded { owner: OperatorMaintenance { reason: _ } } =>
      HolderNotObservable { cause: "an operator maintenance hold is not bound to a process; only the operator releases it" as NonEmptyStr }
    UnitHoldOwnerDecoded { owner: HostResetReturn { attempt: _ } } =>
      HolderNotObservable { cause: "a host reset-return hold names no process, so its holder cannot be observed" as NonEmptyStr }
    UnitHoldOwnerUnrecognized { raw: _ } =>
      HolderNotObservable { cause: "the holder's owner names no process this module can observe (it was written without one, or not by this module)" as NonEmptyStr }
  }
}

fn holder_report(holder: DurableHoldOwnerRef, generation: CasGeneration) -> DurableHoldHolderReport {
  let liveness = match holder_liveness_route(holder: holder) {
    HolderObserveProcess { process: p, pid_namespace: n } => holder_process_liveness(p: p, pid_namespace: n)
    HolderNotObservable { cause: c } => HolderLivenessUnobservable { cause: c }
  }
  DurableHoldHolderReport { holder: holder, generation: generation, liveness: liveness }
}

type DeadHolderRecovery
  = DeadHolderRecovered { dead_holder: DurableHoldOwnerRef, evidence: NonEmptyStr }
  | DeadHolderNotRecovered { reason: NonEmptyStr }

fn recovery_refusal_text(key: NonEmptyStr, r: DurableHoldRecoveryRefusal) -> NonEmptyStr {
  let why = match r {
    HoldRecoveryNothingHeld => "the slot was released before recovery"
    HoldRecoveryHolderLive { generation: _, holder: h, evidence: e } => join(["is held by '", h as String, "', which is alive (", e as String, "); no BMC actuation until it is released"], "")
    HoldRecoveryHolderUnobservable { generation: _, holder: h, cause: c } => join(["is held by '", h as String, "', whose liveness could not be observed (", c as String, "); an unobserved holder is not a dead one, so the hold stands"], "")
    HoldRecoverySlotMoved { reported: _, observed: _ } => "moved while its holder was being observed; re-run"
    HoldRecoveryReportForAnotherHolder { holder: h, reported: _ } => join(["changed hands to '", h as String, "' while its holder was being observed; re-run"], "")
    HoldRecoverySlotUndecodable { generation: _, detail: d } => concat("became undecodable: ", d as String)
    HoldRecoveryObservationUnavailable { cause: _ } => "could not be re-read for recovery; an unreadable interlock is not a released one"
  }
  join(["unit ", key as String, " ", why, "; controller untouched"], "") as NonEmptyStr
}

fn unit_hold_recover_dead_holder(root: NonEmptyStr, key: NonEmptyStr, holder: DurableHoldOwnerRef, generation: CasGeneration) -> DeadHolderRecovery
  admit_callers: [
    decl_ref(module_path: "gunbc.managed_host_unit_hold", decl_name: "unit_hold_acquire_on_store_host"),
  ]
{
  let report = holder_report(holder: holder, generation: generation)
  let released_by = join(["recovered-dead-holder:", holder as String], "") as DurableHoldReleaseRef
  match file_hold_recovery_assess(root: root, slot_key: key, report: report, released_by: released_by) {
    FileHoldRecoveryNotEligible { slot_key: _, refusal: r } => DeadHolderNotRecovered { reason: recovery_refusal_text(key: key, r: r) }
    FileHoldRecoveryPlanned { plan: p, dead_holder: h, evidence: e } =>
      match file_hold_release_commit(plan: p) {
        FileHoldReleased { slot_key: _, generation: _ } => DeadHolderRecovered { dead_holder: h, evidence: e }
        FileHoldReleaseLost { slot_key: _ } => DeadHolderNotRecovered { reason: join(["unit ", key as String, " moved before the dead holder's hold was freed; re-run; controller untouched"], "") as NonEmptyStr }
        FileHoldReleaseStoreUnavailable { slot_key: _, cause: _ } => DeadHolderNotRecovered { reason: join(["unit hold store refused freeing the dead holder's hold on ", key as String, "; controller untouched"], "") as NonEmptyStr }
        FileHoldReleaseKeyNotSlotAddressable { slot_key: _ } => DeadHolderNotRecovered { reason: join(["unit hold key ", key as String, " is not slot-addressable; controller untouched"], "") as NonEmptyStr }
      }
  }
}

// The proof is built here, from an outcome only unit_hold_acquire's own live acquires produce: the
// admission is what keeps a supplied FileHoldAcquired from becoming a proof.
fn unit_hold_minted(subject: AdmittedUnitHoldSubject, outcome: FileHoldAcquireOutcome) -> UnitHoldAcquisition
  admit_callers: [
    decl_ref(module_path: "gunbc.managed_host_unit_hold", decl_name: "unit_hold_acquire_on_store_host"),
  ]
{
  match outcome {
    FileHoldAcquired { slot_key: _, owner: o, generation: g } =>
      UnitHeld { proof: UnitHoldProof { subject: subject, owner: o, generation: g } }
    FileHoldOccupied { slot_key: _, holder: _, generation: _ } => unit_hold_not_acquired(outcome: outcome)
    FileHoldAcquireLost { slot_key: _ } => unit_hold_not_acquired(outcome: outcome)
    FileHoldAcquireStoreUnavailable { slot_key: _, cause: _ } => unit_hold_not_acquired(outcome: outcome)
    FileHoldSlotUndecodable { slot_key: _, generation: _, detail: _ } => unit_hold_not_acquired(outcome: outcome)
    FileHoldKeyNotSlotAddressable { slot_key: _ } => unit_hold_not_acquired(outcome: outcome)
  }
}

fn unit_hold_not_acquired(outcome: FileHoldAcquireOutcome) -> UnitHoldAcquisition {
  match unit_hold_refusal(outcome: outcome) {
    Present { value: r } => UnitHoldRefused { reason: r }
    Absent => UnitHoldRefused { reason: "unit hold outcome unclassified; controller untouched" as NonEmptyStr }
  }
}

// THE ONE MINT. The live acquire and the proof are one boundary: the proof exists only when the
// compare-and-set this call performed committed a hold for this owner. An OCCUPIED slot is asked one
// further question -- is its holder observed dead? -- and only an observed-dead holder's hold is freed,
// after which this caller acquires once more like any acquirer. There is no loop: a slot taken by
// someone else in between refuses as occupied, naming them.
fn unit_hold_acquire(subject: AdmittedUnitHoldSubject, owner: DurableHoldOwnerRef) -> UnitHoldAcquisition
  admit_callers: [
    decl_ref(module_path: "gunbc.managed_host_unit_hold", decl_name: "boot_run_acquire_unit_hold"),
    decl_ref(module_path: "gunbc.host_reset_return_run", decl_name: "host_reset_return_wet"),
    decl_ref(module_path: "gunbc.managed_host_unit_hold", decl_name: "kvm_observer_acquire_unit_hold"),
  ]
{
  match unit_hold_store_executor(subject: subject) {
    UnitHoldNotOnStoreHost { reason: r } => UnitHoldRefused { reason: join([r as String, "; controller untouched"], "") as NonEmptyStr }
    UnitHoldOnStoreHost { executor: e } => unit_hold_acquire_on_store_host(executor: e, owner: owner)
  }
}

// The store effect itself, reachable only with the executor carrier and only from the mint above.
fn unit_hold_acquire_on_store_host(executor: UnitHoldStoreExecutor, owner: DurableHoldOwnerRef) -> UnitHoldAcquisition
  admit_callers: [
    decl_ref(module_path: "gunbc.managed_host_unit_hold", decl_name: "unit_hold_acquire"),
  ]
{
  let subject = executor.subject
  let outcome = file_hold_acquire(root: unit_hold_store_root, slot_key: subject.key, requested_owner: owner)
  match outcome {
    FileHoldOccupied { slot_key: _, holder: h, generation: g } =>
      match unit_hold_recover_dead_holder(root: unit_hold_store_root, key: subject.key, holder: h, generation: g) {
        DeadHolderNotRecovered { reason: r } => UnitHoldRefused { reason: r }
        DeadHolderRecovered { dead_holder: _, evidence: _ } =>
          unit_hold_minted(subject: subject, outcome: file_hold_acquire(root: unit_hold_store_root, slot_key: subject.key, requested_owner: owner))
      }
    FileHoldAcquired { slot_key: _, owner: _, generation: _ } => unit_hold_minted(subject: subject, outcome: outcome)
    FileHoldAcquireLost { slot_key: _ } => unit_hold_minted(subject: subject, outcome: outcome)
    FileHoldAcquireStoreUnavailable { slot_key: _, cause: _ } => unit_hold_minted(subject: subject, outcome: outcome)
    FileHoldSlotUndecodable { slot_key: _, generation: _, detail: _ } => unit_hold_minted(subject: subject, outcome: outcome)
    FileHoldKeyNotSlotAddressable { slot_key: _ } => unit_hold_minted(subject: subject, outcome: outcome)
  }
}

// A HOLD-OWNING RUN NAMES THE HOST IT DRIVES, AND THE ADMISSION IS HERE. The boot and the KVM probe
// know their unit by its HostIdentity; the label is admitted against the managed rows before anything
// touches the store, and a host that is not managed, or has no hold, refuses with that cause. The
// acquire itself takes only the admitted subject.
fn boot_run_acquire_unit_hold(host: HostIdentity, run_id: NonEmptyStr) -> UnitHoldAcquisition
  admit_callers: [
    decl_ref(module_path: "gunbc.machine_intake_mtcollins1_boot_run", decl_name: "mtcollins1_boot_under_live_unit_hold"),
  ]
{
  match unit_hold_admission_for(host: host as NonEmptyStr) {
    UnitHoldHostNotManaged { host: h } => unit_hold_not_admitted(admission: UnitHoldHostNotManaged { host: h })
    UnitHoldHostNotRequired { host: h } => unit_hold_not_admitted(admission: UnitHoldHostNotRequired { host: h })
    UnitHoldHostAdmitted { subject: subject } =>
      match self_process_identity() {
        SelfUnidentified { cause: c } =>
          UnitHoldRefused { reason: join(["this boot cannot name its own process (", c as String, "), and a hold it could never be shown dead in would lock the unit out if it died; controller untouched"], "") as NonEmptyStr }
        SelfIdentified { process: p, pid_namespace: n } =>
          unit_hold_acquire(subject: subject, owner: boot_run_owner(run_id: run_id, process: p, pid_namespace: n))
      }
  }
}

fn unit_hold_not_admitted(admission: UnitHoldHostAdmission) -> UnitHoldAcquisition {
  match unit_hold_host_admission_refusal(admission: admission) {
    Present { value: r } => UnitHoldRefused { reason: join([r as String, "; controller untouched"], "") as NonEmptyStr }
    Absent => UnitHoldRefused { reason: "unit hold admission unclassified; controller untouched" as NonEmptyStr }
  }
}

// THE KVM OBSERVER PROBE TAKES THE SAME SLOT (a unit's KVM observer probe, e.g. gunbc.machine_intake_mtcollins1_kvm_observer_observe).
// It writes nothing to the controller, but it takes the BMC's one KVM viewer seat, and the boot takes
// that seat under this hold and REFUSES its handoff when the seat is busy -- so a probe that did not
// hold the unit could make a concurrent boot refuse, and an operator's maintenance would see a viewer
// nobody accounted for. Holding the unit makes the probe, the boot and maintenance exclude each other.
fn kvm_observer_acquire_unit_hold(host: HostIdentity, run_id: NonEmptyStr) -> UnitHoldAcquisition
  admit_callers: [
    decl_ref(module_path: "gunbc.machine_intake_megarac_kvm_observer_observe", decl_name: "megarac_kvm_observer_observe"),
  ]
{
  match unit_hold_admission_for(host: host as NonEmptyStr) {
    UnitHoldHostNotManaged { host: h } => unit_hold_not_admitted(admission: UnitHoldHostNotManaged { host: h })
    UnitHoldHostNotRequired { host: h } => unit_hold_not_admitted(admission: UnitHoldHostNotRequired { host: h })
    UnitHoldHostAdmitted { subject: subject } =>
      match self_process_identity() {
        SelfUnidentified { cause: c } =>
          UnitHoldRefused { reason: join(["this probe cannot name its own process (", c as String, "), and a hold it could never be shown dead in would lock the unit out if it died; controller untouched"], "") as NonEmptyStr }
        SelfIdentified { process: p, pid_namespace: n } =>
          unit_hold_acquire(subject: subject, owner: unit_hold_owner_ref(o: KvmObserverProbe { run_id: run_id, process: p, pid_namespace: n }))
      }
  }
}

// THE PROBE'S always() RELEASE, SCOPED TO ITS OWN RUN (eager-owl-205, 2026-09-30). A cancel or a step
// timeout after the probe acquired leaves the hold with no proof in hand, so a separate step that runs
// under always() observes the slot and frees it ONLY when the holder decodes to
// KvmObserverProbe { run_id } for THIS run, releasing at the generation it observed (the store's
// compare-and-set). A free slot, another owner -- an operator, a boot, another probe run -- or an
// unreadable slot is a reported no-op, never a release; a slot that moved between the observation and
// the commit is stale, and is left as it is.
//
// A runner that dies, or a job cancelled at its backstop, runs no always() step. Its probe hold names
// the holding process (KvmObserverProbe's ProcessIdentity and pid namespace), so the next acquirer of
// the unit recovers it once that process is OBSERVED dead (unit_hold_acquire's observed-dead recovery,
// gunbc#12555), exactly as it recovers a dead boot run's.
type ProbeHoldReleaseDecision
  = ProbeHoldReleaseAt { owner: DurableHoldOwnerRef, generation: CasGeneration }
  | ProbeHoldFreeNoop
  | ProbeHoldForeignNoop { holder: String }
  | ProbeHoldUnobservable { cause: String }

fn probe_hold_release_decision(observed: DurableHoldObservation, run_id: NonEmptyStr) -> ProbeHoldReleaseDecision {
  match observed {
    HoldSlotAbsent => ProbeHoldFreeNoop
    HoldSlotFree { generation: _, released_by: _ } => ProbeHoldFreeNoop
    HoldSlotUndecodable { generation: _, detail: d } => ProbeHoldUnobservable { cause: concat("slot undecodable: ", d as String) }
    HoldObservationUnavailable { cause: _ } => ProbeHoldUnobservable { cause: "the store could not be read" }
    HoldSlotHeld { generation: g, owner: o } =>
      match decode_unit_hold_owner(owner: o) {
        UnitHoldOwnerDecoded { owner: KvmObserverProbe { run_id: r, process: p, pid_namespace: n } } =>
          if (r as String) == (run_id as String) { ProbeHoldReleaseAt { owner: o, generation: g } }
          else { ProbeHoldForeignNoop { holder: unit_hold_owner_label(o: KvmObserverProbe { run_id: r, process: p, pid_namespace: n }) } }
        UnitHoldOwnerDecoded { owner: other } => ProbeHoldForeignNoop { holder: unit_hold_owner_label(o: other) }
        UnitHoldOwnerUnrecognized { raw: raw } => ProbeHoldForeignNoop { holder: raw }
      }
  }
}

type ProbeHoldReleaseOutcome
  = ProbeHoldReleased
  | ProbeHoldAlreadyFree
  | ProbeHoldNotOurs { holder: String }
  | ProbeHoldStale { detail: String }
  | ProbeHoldUnreleased { cause: String }

// A RELEASE ASSESSED AGAINST THE OBSERVATION AND REFUSED: every refusal but the slot having been freed
// meanwhile means the slot moved since this run looked, so it is stale and left alone.
fn probe_hold_release_refused(refusal: DurableHoldReleaseRefusal) -> ProbeHoldReleaseOutcome {
  match refusal {
    HoldReleaseSlotAbsent => ProbeHoldAlreadyFree
    HoldReleaseAlreadyFree { generation: _, released_by: _ } => ProbeHoldAlreadyFree
    HoldReleaseHeldByAnotherOwner { generation: _, holder: h } => ProbeHoldNotOurs { holder: h as String }
    HoldReleaseAgainstAnotherGeneration { acquired: _, observed: _ } => ProbeHoldStale { detail: "the slot moved to another generation after it was observed" }
    HoldReleaseSlotUndecodable { generation: _, detail: d } => ProbeHoldUnreleased { cause: concat("slot undecodable: ", d as String) }
    HoldReleaseObservationUnavailable { cause: _ } => ProbeHoldUnreleased { cause: "the store could not be read" }
  }
}

fn probe_hold_release_committed(outcome: FileHoldReleaseOutcome) -> ProbeHoldReleaseOutcome {
  match outcome {
    FileHoldReleased { slot_key: _, generation: _ } => ProbeHoldReleased
    FileHoldReleaseLost { slot_key: _ } => ProbeHoldStale { detail: "the slot moved before the release committed" }
    FileHoldReleaseStoreUnavailable { slot_key: _, cause: _ } => ProbeHoldUnreleased { cause: "the store refused the release; the unit is STILL held" }
    FileHoldReleaseKeyNotSlotAddressable { slot_key: _ } => ProbeHoldUnreleased { cause: "the key is not slot-addressable" }
  }
}

fn probe_hold_release_outcome_text(o: ProbeHoldReleaseOutcome) -> String {
  match o {
    ProbeHoldReleased => "released this run's probe hold"
    ProbeHoldAlreadyFree => "no hold to release (the slot was free)"
    ProbeHoldNotOurs { holder: h } => concat("left alone: the unit is held by ", h)
    ProbeHoldStale { detail: d } => concat("left alone, stale: ", d)
    ProbeHoldUnreleased { cause: c } => concat("NOT released: ", c)
  }
}

fn kvm_observer_release_unit_hold(host: HostIdentity, run_id: NonEmptyStr) -> ProbeHoldReleaseOutcome
  admit_callers: [
    decl_ref(module_path: "gunbc.machine_intake_megarac_kvm_observer_observe", decl_name: "megarac_kvm_observer_release"),
  ]
{
  match unit_hold_admission_for(host: host as NonEmptyStr) {
    UnitHoldHostNotManaged { host: h } => kvm_observer_release_not_admitted(admission: UnitHoldHostNotManaged { host: h })
    UnitHoldHostNotRequired { host: h } => kvm_observer_release_not_admitted(admission: UnitHoldHostNotRequired { host: h })
    UnitHoldHostAdmitted { subject: subject } =>
      match unit_hold_store_executor(subject: subject) {
        UnitHoldNotOnStoreHost { reason: r } => ProbeHoldUnreleased { cause: r as String }
        UnitHoldOnStoreHost { executor: e } => kvm_observer_release_on_store_host(executor: e, run_id: run_id)
      }
  }
}

fn kvm_observer_release_on_store_host(executor: UnitHoldStoreExecutor, run_id: NonEmptyStr) -> ProbeHoldReleaseOutcome
  admit_callers: [
    decl_ref(module_path: "gunbc.managed_host_unit_hold", decl_name: "kvm_observer_release_unit_hold"),
  ]
{
  let key = executor.subject.key
  match probe_hold_release_decision(observed: observe_file_hold(root: unit_hold_store_root, key: key), run_id: run_id) {
    ProbeHoldFreeNoop => ProbeHoldAlreadyFree
    ProbeHoldForeignNoop { holder: h } => ProbeHoldNotOurs { holder: h }
    ProbeHoldUnobservable { cause: c } => ProbeHoldUnreleased { cause: c }
    ProbeHoldReleaseAt { owner: o, generation: g } =>
      match file_hold_release_assess(root: unit_hold_store_root, slot_key: key, owner: o, acquired_generation: g, released_by: concat("kvm-observer-always-release:", run_id as String) as DurableHoldReleaseRef) {
        FileHoldReleaseNotEligible { slot_key: _, refusal: r } => probe_hold_release_refused(refusal: r)
        FileHoldReleasePlanned { plan: p } => probe_hold_release_committed(outcome: file_hold_release_commit(plan: p))
      }
  }
}

fn kvm_observer_release_not_admitted(admission: UnitHoldHostAdmission) -> ProbeHoldReleaseOutcome {
  match unit_hold_host_admission_refusal(admission: admission) {
    Present { value: r } => ProbeHoldUnreleased { cause: r as String }
    Absent => ProbeHoldUnreleased { cause: "unit hold admission unclassified" }
  }
}

// THE RELEASE CONSUMES THE PROOF AND KEEPS THE STEP'S OWN OUTCOME, saying when the hold was left: a
// run that actuated and then failed to free the unit has still actuated, and an operator reading a
// bare success would not know the next run will refuse on a stale holder.
type UnitHoldReleaseOutcome
  = UnitHoldReleasedCleanly
  | UnitHoldLeftHeld { cause: NonEmptyStr }

fn unit_hold_release_outcome(proof: UnitHoldProof) -> UnitHoldReleaseOutcome {
  match file_hold_release_assess(root: unit_hold_store_root, slot_key: proof.subject.key, owner: proof.owner, acquired_generation: proof.generation, released_by: proof.owner as String as DurableHoldReleaseRef) {
    FileHoldReleaseNotEligible { slot_key: _, refusal: _ } => UnitHoldLeftHeld { cause: "the slot no longer showed this run's hold" as NonEmptyStr }
    FileHoldReleasePlanned { plan: p } =>
      match file_hold_release_commit(plan: p) {
        FileHoldReleased { slot_key: _, generation: _ } => UnitHoldReleasedCleanly
        FileHoldReleaseLost { slot_key: _ } => UnitHoldLeftHeld { cause: "the slot moved before the release committed" as NonEmptyStr }
        FileHoldReleaseStoreUnavailable { slot_key: _, cause: _ } => UnitHoldLeftHeld { cause: "the store refused the release" as NonEmptyStr }
        FileHoldReleaseKeyNotSlotAddressable { slot_key: _ } => UnitHoldLeftHeld { cause: "the key is not slot-addressable" as NonEmptyStr }
      }
  }
}

fn unit_hold_release(proof: UnitHoldProof, outcome: ProcessExit) -> ProcessExit {
  match unit_hold_release_outcome(proof: proof) {
    UnitHoldReleasedCleanly => outcome
    UnitHoldLeftHeld { cause: c } =>
      exit_failure(reason: join(["unit hold ", proof.subject.key as String, " left held (", c as String, "); step outcome was: ", match outcome {
        ExitSuccess => "success"
        ExitFailure { code: _, reason: r } => concat("failure: ", r)
      }], ""))
  }
}

// A BMC WRITE PATH ASKS THIS BEFORE ITS FIRST REQUEST: the proof must be for the host it is about to
// write to. A proof for another host is still a proof, so the host its subject was admitted from is
// compared rather than assumed.
fn unit_hold_proof_refusal(proof: UnitHoldProof, host: HostIdentity, label: String) -> String? {
  if host_identity_eq(a: proof.subject.host.host, b: host) {
    none
  } else {
    Present { value: join([label, ": unit hold proof is for '", proof.subject.host.host as String, "', not '", host as String, "'; controller untouched"], "") }
  }
}

// ── The operator's side: two entries run in the operator's own session on the store host ───────
// MAINTENANCE IS ITS OWN OPERATION WITH ITS OWN POLICY: beside the host's hold decision, the operator
// names why the unit is held, through the variable gunbc.host_maintenance_hold_reason declares for
// that host. A host with a hold and no declared reason variable is refused rather than given a
// default name. AdmittedMaintenanceHold is sole_constructor and admit_maintenance_hold_in its only
// mint, so the take and the release below act only on a host that passed both -- and, like every
// other store effect here, only from a process observed on the store host (UnitHoldStoreExecutor).
type AdmittedMaintenanceHold sole_constructor {
  subject: AdmittedUnitHoldSubject
  reason_env: NonEmptyStr
}

type MaintenanceHoldAdmission
  = MaintenanceHoldAdmitted { hold: AdmittedMaintenanceHold }
  | MaintenanceHoldHostRefused { admission: UnitHoldHostAdmission }
  | MaintenanceHoldNoReasonVariable { host: HostIdentity }

fn admit_maintenance_hold_in(hosts: List<ManagedHost>, host: NonEmptyStr) -> MaintenanceHoldAdmission {
  match unit_hold_admission_in(hosts: hosts, host: host) {
    UnitHoldHostNotManaged { host: h } => MaintenanceHoldHostRefused { admission: UnitHoldHostNotManaged { host: h } }
    UnitHoldHostNotRequired { host: h } => MaintenanceHoldHostRefused { admission: UnitHoldHostNotRequired { host: h } }
    UnitHoldHostAdmitted { subject: s } =>
      match maintenance_hold_reason_env(host: s.host) {
        Absent => MaintenanceHoldNoReasonVariable { host: s.host.host }
        Present { value: env } => MaintenanceHoldAdmitted { hold: AdmittedMaintenanceHold { subject: s, reason_env: env } }
      }
  }
}

fn maintenance_hold_admission_refusal(admission: MaintenanceHoldAdmission) -> String {
  match admission {
    MaintenanceHoldAdmitted { hold: _ } => ""
    MaintenanceHoldHostRefused { admission: a } =>
      match unit_hold_host_admission_refusal(admission: a) {
        Present { value: r } => concat("maintenance hold: ", r as String)
        Absent => "maintenance hold: unit hold admission unclassified"
      }
    MaintenanceHoldNoReasonVariable { host: h } =>
      join(["maintenance hold: managed host '", h as String, "' has a unit hold but gunbc.host_maintenance_hold_reason declares no reason variable for it; nothing was taken or released"], "")
  }
}

// THE HOST IS THE ENTRY'S ARGUMENT (`gunbc run ... --function maintenance_hold_take --arg host=<label>`),
// never a default: an empty or unknown label refuses.
fn maintenance_hold_take(host: String) -> ProcessExit {
  if trim(s: host) == "" {
    return exit_failure(reason: "maintenance hold: no host named; pass --arg host=<managed host>")
  }
  match admit_maintenance_hold_in(hosts: managed_hosts(), host: trim(s: host) as NonEmptyStr) {
    MaintenanceHoldAdmitted { hold: h } => maintenance_hold_take_admitted(hold: h)
    MaintenanceHoldHostRefused { admission: a } => exit_failure(reason: maintenance_hold_admission_refusal(admission: MaintenanceHoldHostRefused { admission: a }))
    MaintenanceHoldNoReasonVariable { host: x } => exit_failure(reason: maintenance_hold_admission_refusal(admission: MaintenanceHoldNoReasonVariable { host: x }))
  }
}

fn maintenance_hold_label(hold: AdmittedMaintenanceHold) -> String {
  concat("maintenance hold on ", hold.subject.key as String)
}

// THE EXECUTOR IS DERIVED HERE FROM THE HOLD'S OWN SUBJECT, NEVER SUPPLIED BESIDE IT. A function taking
// an admitted hold and an executor as two arguments could be handed hold A with an executor minted for
// subject B on the same store host, and would then write B's slot under A's reason. So neither helper
// below has an executor parameter: each mints it from hold.subject, and the slot key every store call
// uses is that executor's own subject's. Both are sealed to their entry. A process that is not on the
// store host refuses in the first arm, before the reason is read or the store touched.
fn maintenance_hold_take_admitted(hold: AdmittedMaintenanceHold) -> ProcessExit
  admit_callers: [
    decl_ref(module_path: "gunbc.managed_host_unit_hold", decl_name: "maintenance_hold_take"),
  ]
{
  let label = maintenance_hold_label(hold: hold)
  match unit_hold_store_executor(subject: hold.subject) {
    UnitHoldNotOnStoreHost { reason: r } => exit_failure(reason: concat("maintenance hold: ", r as String))
    UnitHoldOnStoreHost { executor: e } => {
      let reason = actions_variable_trimmed(name: hold.reason_env)
      if reason == "" {
        exit_failure(reason: concat(hold.reason_env as String, " is unset; a maintenance hold names why the unit is held"))
      } else {
        match file_hold_acquire(root: unit_hold_store_root, slot_key: e.subject.key, requested_owner: operator_maintenance_owner(reason: reason as NonEmptyStr)) {
          FileHoldAcquired { slot_key: _, owner: _, generation: _ } => ExitSuccess
          FileHoldOccupied { slot_key: _, holder: h, generation: _ } =>
            exit_failure(reason: join([label, ": unit already held by ", h as String], ""))
          FileHoldAcquireLost { slot_key: _ } => exit_failure(reason: concat(label, ": lost the race; re-run"))
          FileHoldAcquireStoreUnavailable { slot_key: _, cause: _ } => exit_failure(reason: concat(label, ": store unavailable; the unit is NOT held"))
          FileHoldSlotUndecodable { slot_key: _, generation: _, detail: d } => exit_failure(reason: join([label, ": slot undecodable: ", d as String], ""))
          FileHoldKeyNotSlotAddressable { slot_key: _ } => exit_failure(reason: concat(label, ": key not slot-addressable"))
        }
      }
    }
  }
}

// THE OPERATOR RELEASES ONLY AN OPERATOR HOLD: a boot's own hold is the boot's to free, and freeing
// it from outside would let a second boot start while the first still drives the BMC.
fn maintenance_hold_release(host: String) -> ProcessExit {
  if trim(s: host) == "" {
    return exit_failure(reason: "maintenance hold: no host named; pass --arg host=<managed host>")
  }
  match admit_maintenance_hold_in(hosts: managed_hosts(), host: trim(s: host) as NonEmptyStr) {
    MaintenanceHoldAdmitted { hold: h } => maintenance_hold_release_admitted(hold: h)
    MaintenanceHoldHostRefused { admission: a } => exit_failure(reason: maintenance_hold_admission_refusal(admission: MaintenanceHoldHostRefused { admission: a }))
    MaintenanceHoldNoReasonVariable { host: x } => exit_failure(reason: maintenance_hold_admission_refusal(admission: MaintenanceHoldNoReasonVariable { host: x }))
  }
}

fn maintenance_hold_release_admitted(hold: AdmittedMaintenanceHold) -> ProcessExit
  admit_callers: [
    decl_ref(module_path: "gunbc.managed_host_unit_hold", decl_name: "maintenance_hold_release"),
  ]
{
  match unit_hold_store_executor(subject: hold.subject) {
    UnitHoldNotOnStoreHost { reason: r } => exit_failure(reason: concat("maintenance hold: ", r as String))
    UnitHoldOnStoreHost { executor: e } => maintenance_hold_release_on_store_host(executor: e)
  }
}

// The release needs no maintenance policy beyond the admission its caller passed, so it takes the
// executor alone: the slot it reads and frees, and the name it prints, are that executor's subject's.
// Sealed to the helper above.
fn maintenance_hold_release_on_store_host(executor: UnitHoldStoreExecutor) -> ProcessExit
  admit_callers: [
    decl_ref(module_path: "gunbc.managed_host_unit_hold", decl_name: "maintenance_hold_release_admitted"),
  ]
{
  let label = concat("maintenance hold on ", executor.subject.key as String)
  match observe_file_hold(root: unit_hold_store_root, key: executor.subject.key) {
    HoldSlotAbsent => exit_failure(reason: concat(label, ": no hold was ever taken"))
    HoldSlotFree { generation: _, released_by: b } => exit_failure(reason: join([label, ": already free (released by ", b as String, ")"], ""))
    HoldSlotUndecodable { generation: _, detail: d } => exit_failure(reason: join([label, ": slot undecodable: ", d as String], ""))
    HoldObservationUnavailable { cause: _ } => exit_failure(reason: concat(label, ": store unavailable"))
    HoldSlotHeld { generation: g, owner: o } =>
      match decode_unit_hold_owner(owner: o) {
        UnitHoldOwnerUnrecognized { raw: r } =>
          exit_failure(reason: join([label, ": held by an owner this module did not write, so it is not released from here: ", r], ""))
        UnitHoldOwnerDecoded { owner: BootRun { run_id: r, process: p, pid_namespace: n } } =>
          exit_failure(reason: join([label, ": held by ", unit_hold_owner_label(o: BootRun { run_id: r, process: p, pid_namespace: n }), ", not by maintenance; that run frees its own hold, and the next boot recovers it if that run is observed dead"], ""))
        UnitHoldOwnerDecoded { owner: HostResetReturn { attempt: a } } =>
          exit_failure(reason: join([label, ": held by ", unit_hold_owner_label(o: HostResetReturn { attempt: a }), ", not by maintenance; that run frees its own hold"], ""))
        UnitHoldOwnerDecoded { owner: KvmObserverProbe { run_id: r, process: p, pid_namespace: n } } =>
          exit_failure(reason: join([label, ": held by ", unit_hold_owner_label(o: KvmObserverProbe { run_id: r, process: p, pid_namespace: n }), ", not by maintenance; that run frees its own hold, and the next acquirer recovers it if that run is observed dead"], ""))
        UnitHoldOwnerDecoded { owner: OperatorMaintenance { reason: _ } } =>
          match file_hold_release_assess(root: unit_hold_store_root, slot_key: executor.subject.key, owner: o, acquired_generation: g, released_by: "operator-maintenance-release" as DurableHoldReleaseRef) {
            FileHoldReleaseNotEligible { slot_key: _, refusal: _ } => exit_failure(reason: concat(label, ": slot moved before release; re-run"))
            FileHoldReleasePlanned { plan: p } =>
              match file_hold_release_commit(plan: p) {
                FileHoldReleased { slot_key: _, generation: _ } => ExitSuccess
                FileHoldReleaseLost { slot_key: _ } => exit_failure(reason: concat(label, ": lost the release race; re-run"))
                FileHoldReleaseStoreUnavailable { slot_key: _, cause: _ } => exit_failure(reason: concat(label, ": store refused the release; the unit is STILL held"))
                FileHoldReleaseKeyNotSlotAddressable { slot_key: _ } => exit_failure(reason: concat(label, ": key not slot-addressable"))
              }
          }
      }
  }
}
