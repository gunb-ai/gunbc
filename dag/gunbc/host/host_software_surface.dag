// PER-HOST SOFTWARE, KEYED BY THE SAME HostIdentity ComputeHost already carries (DESIGN 3: do not
// mint a second host authority). ComputeHost remains the host row; this module is its software
// side, which fleet_intent_os_surface left empty fleet-wide. Each fact is a HostResource so
// standing is CitedFigureStanding — not a parallel vocabulary. Upstream behaviour lives in
// extdeps; the host row says which version or setting THIS host has.

type OsReleaseRole = | OsRelease
type KernelReleaseRole = | KernelRelease
type SysctlRole = | Sysctl
type ToolVersionRole = | ToolVersion
type SudoPolicyRole = | SudoPolicy
type CgroupDelegationRole = | CgroupDelegation
type ToolchainPathsRole = | ToolchainPaths

type HostOsReleaseFact {
  version_id: NonEmptyStr?
  pretty_name: NonEmptyStr?
  distro: UbuntuDistribution?
  standing: CitedFigureStanding
}

type HostKernelReleaseFact {
  kernel_release_label: NonEmptyStr?
  standing: CitedFigureStanding
}

type HostSysctlFact {
  name: NonEmptyStr
  value: Int?
  standing: CitedFigureStanding
}

type HostProgramVersionFact {
  program: ProgramIdentity
  version_label: NonEmptyStr?
  package_version_label: NonEmptyStr?
  standing: CitedFigureStanding
}

type HostSudoPolicyFact {
  principal: GroundedPosixPrincipal
  observed_listing: NonEmptyStr?
  standing: CitedFigureStanding
}

type HostCgroupDelegationFact {
  user_manager_controllers: NonEmptyStr?
  standing: CitedFigureStanding
}

type HostToolchainPathFact {
  git: FilePath?
  jq: FilePath?
  timeout: FilePath?
  systemd_run: FilePath?
  standing: CitedFigureStanding
}

type HostSoftwareSurface {
  host: HostIdentity
  os_release: HostResource<OsReleaseRole, HostOsReleaseFact>
  kernel_release: HostResource<KernelReleaseRole, HostKernelReleaseFact>
  apparmor_userns: HostResource<SysctlRole, HostSysctlFact>
  programs: HostResource<ToolVersionRole, List<HostProgramVersionFact>>
  sudo_policy: HostResource<SudoPolicyRole, HostSudoPolicyFact>
  user_cgroup_delegation: HostResource<CgroupDelegationRole, HostCgroupDelegationFact>
  toolchain_paths: HostResource<ToolchainPathsRole, HostToolchainPathFact>
}

fn unobserved_standing(probe: NonEmptyStr) -> CitedFigureStanding {
  TranscribedUncited { read_obligation: probe }
}

// BOUNDARY TRANSCRIPTION (DESIGN 4b): the fold executes over committed inhabitance bytes from srv1
// (2026-10-15T01:17:54Z). It mints ObservedByReceipt only when those bytes still contain every
// discriminator the host row claims. Next-rung trigger: an executing inhabitance route that writes
// this receipt from the live probes rather than from a committed transcript.
fn srv1_software_inhabitance_receipt_holds() -> Bool {
  let t = srv1_software_inhabitance_receipt_text
  t.contains("VERSION_ID=\"24.04\"")
    && t.contains("6.8.0-138-generic")
    && t.contains("kill from procps-ng 4.0.4")
    && t.contains("1.102.2")
    && t.contains("/usr/bin/git")
    && t.contains("jq-1.7")
    && t.contains("cpu memory pids")
    && t.contains("(ALL) NOPASSWD: ALL")
}

fn srv1_software_inhabitance_ground() -> CitedFigureStanding {
  if srv1_software_inhabitance_receipt_holds() {
    ObservedByReceipt {
      observed: observed_receipt(receipt: decl_ref(
        module_path: "gunbc.host.srv1_software_inhabitance_receipt",
        decl_name: "srv1_software_inhabitance_receipt_text",
      ))
    }
  } else {
    TranscribedUncited {
      read_obligation: "the committed srv1 inhabitance transcript is missing a discriminator the host row claims" as NonEmptyStr
    }
  }
}

data srv1_os_release_probe: NonEmptyStr = "cat /etc/os-release"
data srv1_kernel_release_probe: NonEmptyStr = "uname -r"

fn srv1_apparmor_sysctl_probe() -> NonEmptyStr {
  join(["sysctl -n ", apparmor_restrict_unprivileged_userns_sysctl_name as String], "") as NonEmptyStr
}
data srv1_sudo_list_probe: NonEmptyStr = "sudo -n -l"
data srv1_procps_probe: NonEmptyStr = "/usr/bin/kill -V"
data srv1_timeout_probe: NonEmptyStr = "timeout --version"
data srv1_git_probe: NonEmptyStr = "git --version"
data srv1_jq_probe: NonEmptyStr = "jq --version"
data srv1_systemd_probe: NonEmptyStr = "systemctl --version"
data srv1_cgroup_delegation_probe: NonEmptyStr = "cat /sys/fs/cgroup/user.slice/user-$(id -u).slice/user@$(id -u).service/cgroup.controllers"
data srv1_tailscale_probe: NonEmptyStr = "tailscale version"
data srv1_toolchain_which_probe: NonEmptyStr = "command -v git; command -v jq; command -v timeout; command -v systemd-run"

fn srv1_software_inhabitance_probe_commands() -> List<NonEmptyStr> {
  [
    srv1_os_release_probe,
    srv1_kernel_release_probe,
    srv1_apparmor_sysctl_probe(),
    srv1_sudo_list_probe,
    srv1_procps_probe,
    srv1_timeout_probe,
    srv1_git_probe,
    srv1_jq_probe,
    srv1_systemd_probe,
    srv1_cgroup_delegation_probe,
    srv1_tailscale_probe,
    srv1_toolchain_which_probe,
  ]
}

fn occurrence_ids_for_host() -> List<ResourceOccurrenceId> {
  let a0 = resource_occurrence_allocator_initial()
  let m0 = alloc_resource_occurrence(alloc: a0)
  let m1 = alloc_resource_occurrence(alloc: m0.alloc)
  let m2 = alloc_resource_occurrence(alloc: m1.alloc)
  let m3 = alloc_resource_occurrence(alloc: m2.alloc)
  let m4 = alloc_resource_occurrence(alloc: m3.alloc)
  let m5 = alloc_resource_occurrence(alloc: m4.alloc)
  let m6 = alloc_resource_occurrence(alloc: m5.alloc)
  [m0.id, m1.id, m2.id, m3.id, m4.id, m5.id, m6.id]
}

fn occurrence_at(ids: List<ResourceOccurrenceId>, index: Int) -> ResourceOccurrenceId {
  match ids[index] {
    Present { value: id } => id
    Absent => alloc_resource_occurrence(alloc: resource_occurrence_allocator_initial()).id
  }
}

fn software_surface(
  host: HostIdentity,
  os: HostOsReleaseFact,
  kernel: HostKernelReleaseFact,
  apparmor: HostSysctlFact,
  programs: List<HostProgramVersionFact>,
  sudo_policy: HostSudoPolicyFact,
  cgroup: HostCgroupDelegationFact,
  toolchain: HostToolchainPathFact,
) -> HostSoftwareSurface {
  let ids = occurrence_ids_for_host()
  HostSoftwareSurface {
    host: host,
    os_release: HostResource {
      identity: HostResourceIdentity { host: host, occurrence: occurrence_at(ids: ids, index: 0) },
      role: OsRelease,
      value: os,
    },
    kernel_release: HostResource {
      identity: HostResourceIdentity { host: host, occurrence: occurrence_at(ids: ids, index: 1) },
      role: KernelRelease,
      value: kernel,
    },
    apparmor_userns: HostResource {
      identity: HostResourceIdentity { host: host, occurrence: occurrence_at(ids: ids, index: 2) },
      role: Sysctl,
      value: apparmor,
    },
    programs: HostResource {
      identity: HostResourceIdentity { host: host, occurrence: occurrence_at(ids: ids, index: 3) },
      role: ToolVersion,
      value: programs,
    },
    sudo_policy: HostResource {
      identity: HostResourceIdentity { host: host, occurrence: occurrence_at(ids: ids, index: 4) },
      role: SudoPolicy,
      value: sudo_policy,
    },
    user_cgroup_delegation: HostResource {
      identity: HostResourceIdentity { host: host, occurrence: occurrence_at(ids: ids, index: 5) },
      role: CgroupDelegation,
      value: cgroup,
    },
    toolchain_paths: HostResource {
      identity: HostResourceIdentity { host: host, occurrence: occurrence_at(ids: ids, index: 6) },
      role: ToolchainPaths,
      value: toolchain,
    },
  }
}

fn blank_os() -> HostOsReleaseFact {
  HostOsReleaseFact {
    version_id: none,
    pretty_name: none,
    distro: none,
    standing: unobserved_standing(probe: srv1_os_release_probe),
  }
}

fn blank_kernel() -> HostKernelReleaseFact {
  HostKernelReleaseFact {
    kernel_release_label: none,
    standing: unobserved_standing(probe: srv1_kernel_release_probe),
  }
}

fn blank_apparmor() -> HostSysctlFact {
  HostSysctlFact {
    name: apparmor_restrict_unprivileged_userns_sysctl_name,
    value: none,
    standing: unobserved_standing(probe: srv1_apparmor_sysctl_probe()),
  }
}

fn blank_program(program: ProgramIdentity, probe: NonEmptyStr) -> HostProgramVersionFact {
  HostProgramVersionFact {
    program: program,
    version_label: none,
    package_version_label: none,
    standing: unobserved_standing(probe: probe),
  }
}

fn unobserved_programs() -> List<HostProgramVersionFact> {
  [
    blank_program(program: kill_program(), probe: srv1_procps_probe),
    blank_program(program: timeout_program(), probe: srv1_timeout_probe),
    blank_program(program: git_program(), probe: srv1_git_probe),
    blank_program(program: jq_program(), probe: srv1_jq_probe),
    blank_program(program: systemctl_path_resolved_program(), probe: srv1_systemd_probe),
    blank_program(program: tailscale_program(), probe: srv1_tailscale_probe),
  ]
}

fn observed_program(
  program: ProgramIdentity,
  version_label: NonEmptyStr,
  package_version_label: NonEmptyStr?,
  standing: CitedFigureStanding,
) -> HostProgramVersionFact {
  HostProgramVersionFact {
    program: program,
    version_label: Present { value: version_label },
    package_version_label: package_version_label,
    standing: standing,
  }
}

fn blank_sudo() -> HostSudoPolicyFact {
  HostSudoPolicyFact {
    principal: fleet_posix_operator_principal(),
    observed_listing: none,
    standing: unobserved_standing(probe: srv1_sudo_list_probe),
  }
}

fn blank_cgroup() -> HostCgroupDelegationFact {
  HostCgroupDelegationFact {
    user_manager_controllers: none,
    standing: unobserved_standing(probe: srv1_cgroup_delegation_probe),
  }
}

fn blank_toolchain() -> HostToolchainPathFact {
  HostToolchainPathFact {
    git: none,
    jq: none,
    timeout: none,
    systemd_run: none,
    standing: unobserved_standing(probe: srv1_toolchain_which_probe),
  }
}

fn unobserved_software_surface(host: HostIdentity) -> HostSoftwareSurface {
  software_surface(
    host: host,
    os: blank_os(),
    kernel: blank_kernel(),
    apparmor: blank_apparmor(),
    programs: unobserved_programs(),
    sudo_policy: blank_sudo(),
    cgroup: blank_cgroup(),
    toolchain: blank_toolchain(),
  )
}

// srv1 values are readings of srv1_software_inhabitance_receipt_text (2026-10-15T01:17:54Z).
// jq version_label is the binary self-report (`jq --version` => jq-1.7), not the dpkg version
// (1.7.1-3ubuntu0.24.04.2) also in that receipt: lab deploy reads PATH and the binary.
fn srv1_software_surface() -> HostSoftwareSurface {
  let standing = srv1_software_inhabitance_ground()
  software_surface(
    host: operator_host_srv1,
    os: HostOsReleaseFact {
      version_id: Present { value: "24.04" },
      pretty_name: Present { value: "Ubuntu 24.04.4 LTS" },
      distro: Present { value: NobleNumbat2404Lts },
      standing: standing,
    },
    kernel: HostKernelReleaseFact {
      kernel_release_label: Present { value: "6.8.0-138-generic" },
      standing: standing,
    },
    apparmor: HostSysctlFact {
      name: apparmor_restrict_unprivileged_userns_sysctl_name,
      value: Present { value: apparmor_unprivileged_userns_restricted },
      standing: standing,
    },
    programs: [
      observed_program(program: kill_program(), version_label: procps_ng_4_0_4_label, package_version_label: Present { value: "2:4.0.4-4ubuntu3.2" }, standing: standing),
      observed_program(program: timeout_program(), version_label: "9.4", package_version_label: Present { value: "9.4-3ubuntu6.3" }, standing: standing),
      observed_program(program: git_program(), version_label: "2.43.0", package_version_label: Present { value: "1:2.43.0-1ubuntu7.3" }, standing: standing),
      observed_program(program: jq_program(), version_label: "jq-1.7", package_version_label: Present { value: "1.7.1-3ubuntu0.24.04.2" }, standing: standing),
      observed_program(program: systemctl_path_resolved_program(), version_label: "255 (255.4-1ubuntu8.17)", package_version_label: Present { value: "255.4-1ubuntu8.17" }, standing: standing),
      observed_program(program: tailscale_program(), version_label: "1.102.2", package_version_label: Present { value: "1.102.2" }, standing: standing),
    ],
    sudo_policy: HostSudoPolicyFact {
      principal: fleet_posix_operator_principal(),
      observed_listing: Present { value: "(ALL) NOPASSWD: ALL" },
      standing: standing,
    },
    cgroup: HostCgroupDelegationFact {
      user_manager_controllers: Present { value: "cpu memory pids" },
      standing: standing,
    },
    toolchain: HostToolchainPathFact {
      git: Present { value: "/usr/bin/git" as FilePath },
      jq: Present { value: "/usr/bin/jq" as FilePath },
      timeout: Present { value: "/usr/bin/timeout" as FilePath },
      systemd_run: Present { value: "/usr/bin/systemd-run" as FilePath },
      standing: standing,
    },
  )
}

fn host_software_surface_for_identity(identity: HostIdentity) -> HostSoftwareSurface {
  if host_identity_eq(a: identity, b: operator_host_srv1) {
    srv1_software_surface()
  } else if host_identity_eq(a: identity, b: operator_host_srv2) {
    unobserved_software_surface(host: identity)
  } else if host_identity_eq(a: identity, b: operator_host_srv3) {
    unobserved_software_surface(host: identity)
  } else if host_identity_eq(a: identity, b: operator_host_srv4) {
    unobserved_software_surface(host: identity)
  } else {
    unobserved_software_surface(host: identity)
  }
}

fn host_operating_system_surface(surface: HostSoftwareSurface) -> OperatingSystemSurface {
  match surface.os_release.value.distro {
    Absent => OperatingSystemSurface {
      kernel: Linux,
      distro_or_product: none,
      version: none,
      filesystem_semantics: Posix,
      process_semantics: PosixProcess,
    }
    Present { value: distro } => operating_system_surface_ubuntu(row: ubuntu_distribution_catalog_row(distro: distro))
  }
}

type HostPackageManagerReading
  = HostPackageManagerKnown { manager: OsPackageManager }
  | HostPackageManagerUnobserved { obligation: NonEmptyStr }

fn cited_figure_obligation(standing: CitedFigureStanding) -> NonEmptyStr? {
  match standing {
    TranscribedUncited { read_obligation: o } => Present { value: o }
    CitedToAuthority { authority: _ } => none
    ObservedByReceipt { observed: _ } => none
  }
}

fn host_os_package_manager(surface: HostSoftwareSurface) -> HostPackageManagerReading {
  match surface.os_release.value.distro {
    Absent => HostPackageManagerUnobserved {
      obligation: match cited_figure_obligation(standing: surface.os_release.value.standing) {
        Present { value: o } => o
        Absent => srv1_os_release_probe
      }
    }
    Present { value: distro } =>
      HostPackageManagerKnown { manager: ubuntu_distribution_catalog_row(distro: distro).package_manager }
  }
}

type UserManagerSandboxEnforcement
  = UserManagerEnforcesSandbox
  | UserManagerDoesNotEnforceSandbox
  | UserManagerSandboxUnobserved { obligation: NonEmptyStr }
  | UserManagerSandboxSysctlUnreadable { value: Int }

fn host_program_version(surface: HostSoftwareSurface, program: ProgramIdentity) -> HostProgramVersionFact? {
  fold(surface.programs.value, init: none, f: (acc, p) =>
    match acc {
      Present { value: v } => Present { value: v }
      Absent =>
        if p.program.invocation == program.invocation {
          Present { value: p }
        } else {
          none
        }
    }
  )
}

fn host_program_version_label(surface: HostSoftwareSurface, program: ProgramIdentity) -> NonEmptyStr? {
  match host_program_version(surface: surface, program: program) {
    Absent => none
    Present { value: fact } => fact.version_label
  }
}

// OBSERVATION PLUS A BET, NOT A CITED systemd FACT (DESIGN 4d). srv1 on 2026-10-14: a user-manager
// unit with ProtectHome wrote into home (github.com/gunb-ai/gunbc/issues/13942#issuecomment-6175000334).
// That this happens because Ubuntu's apparmor userns sysctl is 1 is the bet: systemd.exec does not
// state that coupling. Sysctl 1 on this host is DoesNotEnforce (observed). Sysctl 0 is treated as
// the enforcing variant as a bet, not as CitedToAuthority. Any other sysctl is unreadable.
data srv1_user_manager_protect_home_wrote_into_home_receipt: NonEmptyStr = "github.com/gunb-ai/gunbc/issues/13942#issuecomment-6175000334"

fn user_manager_sandbox_enforcement(surface: HostSoftwareSurface) -> UserManagerSandboxEnforcement {
  match surface.apparmor_userns.value.value {
    Absent => UserManagerSandboxUnobserved {
      obligation: match cited_figure_obligation(standing: surface.apparmor_userns.value.standing) {
        Present { value: o } => o
        Absent => srv1_apparmor_sysctl_probe()
      }
    }
    Present { value: n } =>
      if n == apparmor_unprivileged_userns_restricted {
        UserManagerDoesNotEnforceSandbox
      } else if n == 0 {
        UserManagerEnforcesSandbox
      } else {
        UserManagerSandboxSysctlUnreadable { value: n }
      }
  }
}

fn host_tailscale_client(surface: HostSoftwareSurface) -> TailscaleServeCapability {
  match host_program_version(surface: surface, program: tailscale_program()) {
    Absent => ScopedRemovalUnobserved { reason: srv1_tailscale_probe as String }
    Present { value: fact } =>
      match fact.version_label {
        Absent => ScopedRemovalUnobserved {
          reason: match cited_figure_obligation(standing: fact.standing) {
            Present { value: o } => o as String
            Absent => srv1_tailscale_probe as String
          }
        }
        Present { value: label } =>
          match semver_version_parse(cps: chars(s: label as String)) {
            Absent => ScopedRemovalUnobserved {
              reason: "the observed tailscale version label failed to parse"
            }
            Present { value: observed } => tailscale_scoped_removal_capability(observed: observed)
          }
      }
  }
}

fn host_procps_kill_term_pgid_argv(surface: HostSoftwareSurface, pgid: Int) -> List<String>? {
  match host_program_version_label(surface: surface, program: kill_program()) {
    Absent => none
    Present { value: _ } => Present { value: procps_ng_kill_term_pgid_argv(pgid: pgid) }
  }
}

fn host_coreutils_timeout_expired_exit_code(surface: HostSoftwareSurface) -> Int? {
  match host_program_version_label(surface: surface, program: timeout_program()) {
    Absent => none
    Present { value: _ } => Present { value: coreutils_timeout_expired_exit_code }
  }
}

// JOIN, NOT RESTATEMENT. The declared operator PosixSudoGrant roster stays hostnamectl-only
// (operator hold). The live listing `(ALL) NOPASSWD: ALL` is an observation of the dashboard
// service principal on this host; it is not copied into the grant roster.
fn host_sudo_observed_all_is_not_the_declared_roster(surface: HostSoftwareSurface) -> Bool {
  match surface.sudo_policy.value.observed_listing {
    Absent => false
    Present { value: listing } =>
      (listing as String).contains("(ALL) NOPASSWD: ALL")
        && fleet_posix_operator_sudo_grants().length() == 1
        && surface.sudo_policy.value.principal.posix.name as String == "briansrls"
  }
}

