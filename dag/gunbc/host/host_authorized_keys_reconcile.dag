module gunbc.host.host_authorized_keys_reconcile

import std.types { String, List, Bool, NonEmptyStr }
import std.dissolution { DissolutionCondition, unbound_dissolution }
import extdeps.ssh.keys { SshPublicKey, SshKeyAlgorithm, Ed25519, AuthorizedKeyOption, NoAgentForwardingOption, NoPortForwardingOption, NoX11ForwardingOption, ssh_key_algorithm_token }
import gunbc.fleet.fleet_ssh_access {
  fleet_authorized_keys,
  operator_macbook_ssh_key,
  fleet_automation_ssh_key,
  node_orch_ssh_key,
  authorized_keys_for_account,
}
import gunbc.fleet.fleet_posix_accounts { FleetAccountHostAdministrator }
import gunbc.fleet.fleet_host_identity { operator_host_srv1, operator_host_srv2 }
import gunbc.fleet.fleet_intent_network { operator_lan_segment, srv1_tailscale_endpoint, srv2_tailscale_endpoint }
import product.network_topology { NetworkSegment, NetworkEndpoint }
import product.host_identity { HostIdentity }
import gunbc.ownership { Ownership, Owned }
import extdeps.external_authority {
  CitedFigureStanding, CitedToAuthority, TranscribedUncited, ObservedByReceipt, ExternalAuthority,
  cited_figure_read_obligation,
}
import gunbc.machine_intake.supermicro_h11ssl_unit1_hand_install_receipt {
  HandInstallRecordedField, OperatorRelayed, NotRelayed, RelayedDay,
}
import gunbc.machine_intake.supermicro_h11ssl_unit_observation { H11sslReportedFigure }
import gunbc.membership_reconcile {
  MembershipPlan,
  membership_reconcile,
  membership_plan_admitting_outcome,
}

type HostAuthorizedKeysMemberAt = NonEmptyStr

// Instantiates the grain-agnostic gunbc.membership_reconcile spine for one host's
// ~/.ssh/authorized_keys, keyed by SSH key IDENTITY. This is the durable fix for the srv3
// first-contact gap (fleet_subsumption_manual_gaps A1/B2) AND for every future key rotation, both
// instances of the same silent drift: authorized_keys is materialized once at install and never
// re-converged against fleet_ssh_access.fleet_authorized_keys, so a key added to the model after a
// host was installed never reaches that host. srv3 is the live proof: installed via the pre-#7027
// lane before fleet_automation_ssh_key existed, so its ubuntu authorized_keys carries the operator
// macbook key (operator reach) but NOT fleet-automation (workflow reach) — observed 2026-07-24.
// This module does NOT fork the spine: member = SshPublicKey, and the (key_of, key_eq, value_eq,
// ownership_of) bundle below is passed to the ONE membership_reconcile fn (a Realization — one fn,
// N bundles; a forked reconcile would mean the genericity bought nothing). key_of returns the key
// MATERIAL (the cryptographic identity), never the whole line, so a comment-only drift is Modified
// (re-upsert the line), not Remove+Add (which would delete then re-add the key).

fn authorized_key_identity(k: SshPublicKey) -> NonEmptyStr {
  k.material
}

fn authorized_key_identity_eq(a: NonEmptyStr, b: NonEmptyStr) -> Bool {
  a == b
}

fn ssh_algorithm_eq(a: SshKeyAlgorithm, b: SshKeyAlgorithm) -> Bool {
  ssh_key_algorithm_token(a: a) == ssh_key_algorithm_token(a: b)
}

fn authorized_key_value_eq(a: SshPublicKey, b: SshPublicKey) -> Bool {
  ssh_algorithm_eq(a: a.algorithm, b: b.algorithm)
    && (a.material == b.material)
    && (a.comment == b.comment)
}

// The registry of key materials the FLEET manages — the ownership authority the R5
// teardown-owned-only wall reads for a Removed key. DERIVED from fleet_authorized_keys (single
// authority, never a hand-copied material list), so today it is exactly the two declared fleet
// keys. A key NOT in this registry (an out-of-band key like node-orch@srv2 or briansrls@srv1
// hand-added in the node-orch bootstrap era) has NO ownership record -> ownership_of returns Absent
// -> OwnershipUnknown -> the spine REFUSES to tear it down (fail-closed; we never delete a key we
// did not place). ROTATION EXTENSION (dissolution trigger, not built here): when a fleet key
// rotates, its retired material must be appended to a retired-owned list so the Removed old key
// resolves Owned -> teardown-eligible; until that lands, a rotated-out fleet key drops out of this
// derived registry and is REFUSED rather than removed — a safe leak, not a silent delete. That
// extension is what makes the Owned teardown arm non-degenerate; today every teardown-refusal is
// OwnershipUnknown by construction, which is honest for the srv3 case (zero teardowns needed).

fn fleet_owned_key_materials() -> List<NonEmptyStr> {
  map(fleet_authorized_keys, k => k.material)
}

fn authorized_key_ownership(k: SshPublicKey) -> Ownership? {
  if any(fleet_owned_key_materials(), m => m == k.material) {
    Present { value: Owned }
  } else {
    none
  }
}

// desired = fleet_authorized_keys (the model's declared key set); observed = a live read of the
// host's authorized_keys (an OBSERVATION effect, staged — the fixtures below are point-in-time
// reads, not the live provider). The apply-grain POLICY is deliberately NOT resolved in this
// module: authorized_keys is an EVERYTHING-ON-HOST observed scope (foreign keys are normal, not
// anomalies), which is exactly the scope where membership_reconcile's wholesale-refuse policy
// (membership_effects) would be wrong — a foreign key's refusal would block our owned upsert. That
// is the conscious wholesale-vs-siblings-continue call the spine reserves to a human
// (membership_effects_wholesale_refuse_policy_note); this module produces the PLAN grain only and
// leaves the apply projection to that decision.

fn host_authorized_keys_reconcile(observed: List<SshPublicKey>) -> MembershipPlan<SshPublicKey, HostAuthorizedKeysMemberAt> {
  host_authorized_keys_reconcile_with_ownership(
    observed: observed,
    ownership_of: authorized_key_ownership,
  )
}

fn host_authorized_keys_reconcile_with_ownership(
  observed: List<SshPublicKey>,
  ownership_of: fn(SshPublicKey) -> Ownership?,
) -> MembershipPlan<SshPublicKey, HostAuthorizedKeysMemberAt> {
  membership_plan_admitting_outcome(
    outcome: membership_reconcile(
      // The host's authorized_keys here is the HOST-ADMINISTRATOR account's file (the ubuntu account the
      // install provisions). Its desired set is that account's projection -- exactly the keys of the
      // principals granted to it (operator, node-orch, fleet-automation) -- not a flat fleet list. A key on
      // this account that no principal is granted to is therefore not desired, and (being unowned) refused.
      desired: authorized_keys_for_account(account: FleetAccountHostAdministrator),
      observed: observed,
      key_of: authorized_key_identity,
      key_eq: authorized_key_identity_eq,
      value_eq: authorized_key_value_eq,
      ownership_of: ownership_of,
    )
  )
}

// OBSERVED, not intended: a point-in-time read of ubuntu@192.168.1.221 ~/.ssh/authorized_keys, run
// by the operator from the macbook 2026-07-24 (the macbook key is the one credential that reaches
// srv3 today). node-orch@srv2 and briansrls@srv1 are out-of-band keys the fleet does not own;
// macbook-m4 is reused from fleet_ssh_access (single authority) since it is byte-identical to the
// declared operator key. This is a fixture standing in for the staged live observation provider,
// marked so it is never mistaken for a desired/intent row.

data srv3_observed_node_orch_srv2_key: SshPublicKey = node_orch_ssh_key

data srv3_observed_briansrls_srv1_key: SshPublicKey = SshPublicKey {
  algorithm: Ed25519,
  material: "AAAAC3NzaC1lZDI1NTE5AAAAIL28hOj+Q0ddJuX7OUslZpJOuHMZGDxoXCR8MA6iWpdQ",
  comment: "briansrls@srv1",
}

data srv3_observed_authorized_keys: List<SshPublicKey> = [
  srv3_observed_node_orch_srv2_key,
  srv3_observed_briansrls_srv1_key,
  operator_macbook_ssh_key,
]

// OBSERVED read of ubuntu@192.168.1.196 ~/.ssh/authorized_keys (operator, macbook, 2026-07-24).
// srv4 was installed via #7027 with fleet_authorized_keys in the seed, so it carries EXACTLY the
// two declared fleet keys and nothing foreign — the CONVERGED control: reconciling it against
// desired yields an empty plan (0 upsert / 0 teardown / 0 refusal). Both keys reused from
// fleet_ssh_access (single authority).

data srv4_observed_authorized_keys: List<SshPublicKey> = [
  operator_macbook_ssh_key,
  fleet_automation_ssh_key,
]

// ==================================================================================================
// OBSERVED (not intended) node-orch operator-account authorized_keys on srv1/srv2 -- OUT-OF-BAND
// residue. Verified live by gentle-crab-832 2026-11-20; each host's ~/.ssh/authorized_keys.bak-20261120
// holds the pre-edit form. The briansrls operator account on each host carries a node-orch PEER key with
// a per-host from= source-address and a forwarding posture, each admitted by a named consumer. gunbc.fleet
// .fleet_ssh_access grants the node-orch principal only to FleetAccountHostAdministrator (never
// FleetAccountOperator), so these operator-account lines are deliberately OUT OF BAND -- recorded here, in
// the module that owns authorized_keys ownership, as their declared home. srv1's node-orch@srv1 key is NOT
// in the roster; this is its only home in the model -- a hand-written OBSERVED fixture exactly like
// srv3_observed_briansrls_srv1_key above (an observed read, never a desired/intent row). Tailscale SSH was
// on for srv1/srv2 and admitted these by tailnet identity, so the LAN-only from= was never enforced; it is
// now off (sibling tailscale-ssh-off record), so from= is load-bearing and recorded before it is modeled.
//
// CONSUMPTION and the no-silent-undo guarantee: node_orch_operator_out_of_band_preserved() runs each
// recorded key through authorized_key_ownership -- the SAME route the reconcile spine uses to decide a
// teardown. A key the fleet does not own resolves Absent (none) -> OwnershipUnknown -> the spine REFUSES to
// remove it (membership_reconcile MemberRemovalRefused), so the srv2 account's node-orch@srv1 line (srv1's
// own key, absent from the roster) can never be silently torn down. srv1's line is the fleet-owned
// node-orch@srv2 (node_orch_ssh_key): the wall does not protect an OWNED key on an account it is not granted
// to, so srv1's line persists only while no converge is pointed at the operator account -- exactly the
// condition the typed retirement names on each entry. from= is recorded as references to the fleet's
// EXISTING address authorities (product.network_topology NetworkSegment/NetworkEndpoint rows in
// gunbc.fleet.fleet_intent_network), not as a hand-typed comma string and not as an extdeps
// AuthorizedKeyOption arm (a capability no executing route reads is speculative,
// gunbc.design_argument::consumption); it becomes a typed option when an operator-account converge (the
// first retirement trigger) actually consumes it. The admitting consumer and on-host backup path are
// recorded as // comments on each fixture: no generic typed systemd-unit carrier models an arbitrary user
// unit such as srv1-docker-tunnel.service, nor the srv2 docker-over-ssh sessions, so carrying them as
// String fields would be data whose only purpose is commentary (gunbc.design_argument::source_annotations).
// ==================================================================================================

type NodeOrchOperatorOutOfBandEntry {
  host: HostIdentity,
  key: SshPublicKey,
  current_options: List<AuthorizedKeyOption>,
  from_source_lan: NetworkSegment,
  from_source_tailnets: List<NetworkEndpoint>,
  retirement: DissolutionCondition,
}

// srv1's node-orch public key (node-orch@srv1, srv1's ~/.node-orch id_ed25519). NOT in fleet_ssh_access;
// this is its declared home, held as an observed out-of-band fixture.
data srv2_operator_observed_node_orch_srv1_key: SshPublicKey = SshPublicKey {
  algorithm: Ed25519,
  material: "AAAAC3NzaC1lZDI1NTE5AAAAIMIzI+97T4CY1FsAqAcZce4quloDCNAxLXFCoq16G17i",
  comment: "node-orch@srv1",
}

fn node_orch_operator_out_of_band_retirement() -> DissolutionCondition {
  unbound_dissolution(description: "Retires when EITHER trigger fires: (a) a modeled converge writes the briansrls operator account's authorized_keys on srv1/srv2 -- these entries then move into that converge's desired set and from=/forwarding become typed AuthorizedKeyOptions consumed over its executing route; or (b) gunbc.fleet.fleet_ssh_access grants the node-orch principal to FleetAccountOperator -- the lines then become roster-owned via authorized_keys_for_account(FleetAccountOperator) and this out-of-band record is redundant.")
}

// srv1 (LAN 192.168.1.203) operator account: the fleet-authorized node-orch@srv2 key (reused
// single-authority from fleet_ssh_access), observed out-of-band. from= widened 2026-11-20 to add srv2's
// tailnet address 100.73.169.40; no-port-forwarding REMOVED.
// ADMITTING CONSUMER: srv1-docker-tunnel.service -- srv2 user unit
// `ssh -N -L /run/user/1000/srv1-docker.sock:/home/briansrls/.run/docker.sock srv1` (a stream-local -L
// forward -- permitopen/permitlisten do not apply); backs the dashboard's srv1 docker context. It was
// broken ~19:13-19:20Z until no-port-forwarding was removed from this line.
// ON-HOST BACKUP: srv1:~/.ssh/authorized_keys.bak-20261120 (verified live by gentle-crab-832 2026-11-20).
// from= sources reference the fleet's own authorities: the operator LAN segment and srv2's tailnet
// endpoint (the peer that authenticates to srv1 with this key).
data srv1_operator_node_orch_out_of_band_entry: NodeOrchOperatorOutOfBandEntry = NodeOrchOperatorOutOfBandEntry {
  host: operator_host_srv1,
  key: node_orch_ssh_key,
  current_options: [NoAgentForwardingOption, NoX11ForwardingOption],
  from_source_lan: operator_lan_segment,
  from_source_tailnets: [srv2_tailscale_endpoint],
  retirement: node_orch_operator_out_of_band_retirement(),
}

// srv2 operator account: srv1's node-orch@srv1 key, observed out-of-band. from= widened 2026-11-20 to add
// srv1's tailnet address 100.69.18.126; no-port-forwarding KEPT.
// ADMITTING CONSUMER: sessions on srv1 reaching srv2 as srv2-lan -> srv2.tailecbe08.ts.net (ssh and
// `docker -H ssh://srv2-lan`); no port forwarding is performed, so no-port-forwarding is kept.
// ON-HOST BACKUP: srv2:~/.ssh/authorized_keys.bak-20261120 (verified live by gentle-crab-832 2026-11-20).
// from= sources reference the fleet's own authorities: the operator LAN segment and srv1's tailnet
// endpoint (the peer that authenticates to srv2 with this key).
data srv2_operator_node_orch_out_of_band_entry: NodeOrchOperatorOutOfBandEntry = NodeOrchOperatorOutOfBandEntry {
  host: operator_host_srv2,
  key: srv2_operator_observed_node_orch_srv1_key,
  current_options: [NoPortForwardingOption, NoAgentForwardingOption, NoX11ForwardingOption],
  from_source_lan: operator_lan_segment,
  from_source_tailnets: [srv1_tailscale_endpoint],
  retirement: node_orch_operator_out_of_band_retirement(),
}

fn node_orch_operator_out_of_band_entries() -> List<NodeOrchOperatorOutOfBandEntry> {
  [srv1_operator_node_orch_out_of_band_entry, srv2_operator_node_orch_out_of_band_entry]
}

// The consumer / no-silent-undo route. Runs each recorded out-of-band key through the reconcile's own
// ownership decision (authorized_key_ownership -> the membership spine's teardown gate) and returns the
// entries the fleet does NOT own: for those, OwnershipUnknown makes the spine REFUSE the removal, so they
// are structurally preserved against any future converge. srv1's fleet-owned line (node-orch@srv2) is
// excluded here -- its
// protection is the absence of an operator-account converge, which the typed retirement names.
fn node_orch_operator_out_of_band_preserved() -> List<NodeOrchOperatorOutOfBandEntry> {
  filter(
    node_orch_operator_out_of_band_entries(),
    e => authorized_key_ownership(e.key) == none,
  )
}

// ── THE INTAKE STANDING THE ACCESS DECISION READS BEFORE IT USES THE ROSTER ────────────────────────
//
// WHAT THIS ESTABLISHES, at the third site of gunbc.recurring_failure_mode.
// declared_uncitedness_ignored_by_admission (2026-11-21 receipt): the H11SSL unit-1 intake receipt
// (gunbc.machine_intake.supermicro_h11ssl_unit1_hand_install_receipt) carries accounts_and_ssh_keys_report
// as NotRelayed -- "the operator lists the accounts installed and which authorized keys they carry" is an
// OPEN obligation as of 2026-10-24 -- while that host's access was gated by a key sitting outside
// gunbc.fleet.fleet_ssh_access::fleet_authorized_keys. The 2026-11-23 CHECKED paragraph of that row put the
// remaining debt exactly here: "the access gate and the roster of keys still do not read it". The folds
// above decide ownership against the roster; nothing in this module consulted the record that states what
// accounts and keys the hand install put on the host in the first place.
//
// WHAT IS NOT CLAIMED, said plainly because the ledger row above says a claim of closure here would be the
// very defect it tracks ("Claiming the instance closed would be the reader-as-defect failure this very row
// names"). This block establishes that the standing CAN travel with the access verdict, that the two
// refusals are distinguishable by cause, and that a gap-declaring report can never be admitted whole. It
// does NOT close the instance, and it does not make the class dead: host_access_admission has no
// production caller at this commit -- git grep finds it called only from
// dag/test/claim/host/host_access_standing_witness.dag, which is an executing route but not the gate. THE
// NAMED CONSUMER AND ITS TRIGGER: the apply projection of this account's authorized_keys plan -- the first
// fold that turns a MembershipPlan from host_authorized_keys_reconcile into writes for the
// host-administrator account, whose apply-grain policy this module's own comment above reserves to a human
// (membership_effects_wholesale_refuse_policy_note) -- must call host_access_admission and carry its
// accounts_keys arm into the receipt it writes, exactly as gunbc.gpu_market.realization_join now calls
// board_comparison_admission. Until that fold exists, the rung this row reports stays where the ledger
// row left it, at mitigatable-caught-in-review: a standing can now travel with the decision it qualifies,
// which is the precondition the trigger needs, not the trigger met.
//
// WHY THE STANDING TRAVELS WITH THE VERDICT RATHER THAN BESIDE IT
// (gunbc.design_argument::epistemic_humility; the same rule the rate table already applies at
// product.node_power_envelope::rank_specific_2dpc_clock, and the comparison site at
// gunbc.gpu_market.comparison_standing). The fleet roster is the fleet's ONLY record of who may reach a
// host. When the intake record says its own accounts-and-keys report is unrelayed, the roster is not a
// complete description of that host -- and a consumer must not be able to produce a verdict that reads it
// as one. So:
//   - a key outside the roster while the accounts report declares itself incomplete (NotRelayed, or relayed
//     under a standing that says it is a transcription) is REFUSED with the cause naming that condition, and
//     the verdict carries the standing VALUE and the declaring record's obligation text verbatim;
//   - the same roster with nothing outside it is DOWNGRADED, not admitted: the roster covered everything
//     observed, and the fleet still may not state that the roster is the whole of what is on the host;
//   - only a report relayed AND cited to an authority admits, and that arm carries NO obligation -- the
//     negative shape, so a consumer that stuffed an obligation into every arm could not pass either
//     (gunbc.design_argument::fail_closed: a refusal is not a format, and neither is an apology).
//
// WHAT THIS DOES NOT DO, per the row's out_of_scope: it does not relay the accounts-and-keys report (that is
// its own owed receipt, the operator's to file), it does not source the citation that would ground a marked
// figure, and it does not decide the purchase. It also does not change host_authorized_keys_reconcile or
// authorized_key_ownership above: those folds stay as the membership spine's ownership decision, and this
// block is the standing read the consumer of THAT decision must make when the host has an intake receipt --
// and, as the paragraph above says, that consumer is named with its trigger rather than pretended.

// WHAT THE INTAKE RECORD DECLARES ABOUT ITS OWN accounts_and_ssh_keys_report. Three arms, and they are not
// interchangeable: the cited arm is the only one that lets the roster stand as the whole description, and
// the two marked arms carry the obligation the record itself states -- never a paraphrase, taken from
// extdeps.external_authority::cited_figure_read_obligation for a relayed figure and from the record's own
// NotRelayed field for an unrelayed one.
type HostAccountsKeysStanding
  = AccountsKeysRelayedCited { value: NonEmptyStr, authority: ExternalAuthority }
  | AccountsKeysRelayedMarked { value: NonEmptyStr, standing: CitedFigureStanding, read_obligation: NonEmptyStr }
  | AccountsKeysGroundedByReceipt { value: NonEmptyStr, standing: CitedFigureStanding }
  | AccountsKeysNotRelayed { as_of_relayed_day: NonEmptyStr, read_obligation: NonEmptyStr }

fn host_accounts_keys_standing(field: HandInstallRecordedField) -> HostAccountsKeysStanding {
  match field {
    OperatorRelayed { figure: reported } => match reported.standing {
      CitedToAuthority { authority: authority } => AccountsKeysRelayedCited { value: reported.value, authority: authority }
      ObservedByReceipt { observed: _ } => AccountsKeysGroundedByReceipt { value: reported.value, standing: reported.standing }
      _ => match cited_figure_read_obligation(standing: reported.standing) {
        Present { value: obligation } => AccountsKeysRelayedMarked {
          value: reported.value, standing: reported.standing, read_obligation: obligation,
        }
        Absent => AccountsKeysGroundedByReceipt { value: reported.value, standing: reported.standing }
      }
    }
    NotRelayed { as_of_relayed_day: day, read_obligation: obligation } =>
      AccountsKeysNotRelayed { as_of_relayed_day: day, read_obligation: obligation }
  }
}

// IS THIS STANDING ONE THAT DECLARES ITSELF INCOMPLETE? Named once here so no consumer writes its own
// arm-list and drifts. A relayed-and-cited report is complete for this purpose; everything else -- the
// transcription arm, the receipt-grounded arm, and the unrelayed arm -- says the record does not settle
// what accounts and keys the install left on the host.
fn host_accounts_keys_declares_gap(standing: HostAccountsKeysStanding) -> Bool {
  match standing {
    AccountsKeysRelayedCited { value: _, authority: _ } => false
    _ => true
  }
}

// THE CAUSE, TYPED: the two refusals are different events and must not be reported alike. A foreign key
// against a RELAYED, cited accounts report is an ordinary out-of-roster key -- the operator has told us
// what is on the host and this key is not what they named. A foreign key while the accounts report
// declares itself incomplete is undecidable: the fleet cannot tell a hand-added operator credential from
// an intruder's, because the record that would say is unrelayed. Collapsing the two is how a gap becomes a
// routine refusal and stops being visible.
type HostAccessRefusal
  = OutOfRosterKeyAgainstRelayedAccounts
  | OutOfRosterKeyUndecidableOnUndeclaredAccounts

// THE ACCESS DECISION, with the standing it was built on in its own text.
type HostAccessAdmission
  = AccessAdmitted { host: NonEmptyStr, rostered: List<SshPublicKey>, accounts_keys: HostAccountsKeysStanding }
  | AccessDowngraded { host: NonEmptyStr, rostered: List<SshPublicKey>, accounts_keys: HostAccountsKeysStanding }
  | AccessRefused {
      host: NonEmptyStr,
      out_of_roster: List<SshPublicKey>,
      cause: HostAccessRefusal,
      accounts_keys: HostAccountsKeysStanding,
    }

fn host_keys_in_roster(observed: List<SshPublicKey>) -> List<SshPublicKey> {
  filter(observed, k => any(fleet_authorized_keys, r => authorized_key_identity_eq(a: r.material, b: k.material)))
}

fn host_keys_out_of_roster(observed: List<SshPublicKey>) -> List<SshPublicKey> {
  filter(observed, k => any(fleet_authorized_keys, r => authorized_key_identity_eq(a: r.material, b: k.material)) == false)
}

fn host_access_admission(
  host: NonEmptyStr,
  observed: List<SshPublicKey>,
  accounts_report: HandInstallRecordedField,
) -> HostAccessAdmission {
  let standing = host_accounts_keys_standing(field: accounts_report)
  let out_of_roster = host_keys_out_of_roster(observed: observed)
  if count(out_of_roster) > 0 {
    AccessRefused {
      host: host,
      out_of_roster: out_of_roster,
      cause: if host_accounts_keys_declares_gap(standing: standing) {
        OutOfRosterKeyUndecidableOnUndeclaredAccounts
      } else {
        OutOfRosterKeyAgainstRelayedAccounts
      },
      accounts_keys: standing,
    }
  } else if host_accounts_keys_declares_gap(standing: standing) {
    AccessDowngraded { host: host, rostered: host_keys_in_roster(observed: observed), accounts_keys: standing }
  } else {
    AccessAdmitted { host: host, rostered: host_keys_in_roster(observed: observed), accounts_keys: standing }
  }
}
