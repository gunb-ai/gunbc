  bind: DeclarationRef {
    module_path: "gunbc.host.host_converge",
    decl_name: "gunbc_fleet_pinned_binary_digest",
    field: WholeDeclaration
  }
}

data gunbc_fleet_pinned_binary_name: String = "gunbc"

data gunbc_ctrl_read_pin_script: String = "scripts/session-dashboard/container/read-gunbc-pin.sh"

data gunbc_ctrl_placement_probe_script: String = "scripts/session-dashboard/lib/placement_query.mjs"

data gunbc_ctrl_green_place_marker_path: String = ".dashboard/converge-green-place.marker"

data gunbc_ctrl_green_place_marker_pin_prefix: String = "pin="

data gunbc_ctrl_green_place_marker_ts_prefix: String = "first_green_at="

data gunbc_ctrl_quiescent_reload_hook: String = "scripts/session-dashboard/bin/gunbc-pin-quiescent-reload.mjs"

data gunbc_spawn_retry_backstop_cadence: Second = second(count: 600)

type GreenPlaceReadinessMarker {
  path: String
  pin_prefix: String
  timestamp_prefix: String
}

type SpawnRetryBackstop {
  cadence: Second
  role: String
}

type GunbcPinnedTreeDriftReceipt {
  drift: Bool
  reason: String
  desired_gunbc_root: String
  target_sha: String
  dag_binding_mode: String
}

type ConvergeVerdict
  = VerdictConverged
  | Drifted
  | VerdictAbsent

fn converge_verdict(effective: String, expected: String) -> ConvergeVerdict {
  if effective == "" { VerdictAbsent }
  else { if effective == expected { VerdictConverged } else { Drifted } }
}

fn converge_verdict_label(v: ConvergeVerdict) -> String {
  match v {
    VerdictConverged => "converged"
    Drifted => "drifted"
    VerdictAbsent => "absent"
  }
}

// The convergence verdict lattice, meet: VerdictAbsent < Drifted < VerdictConverged. A host's
// verdict cannot outrank the WEAKEST evidence that grounds it — so a knob verdict is met
// with the revision standing before it is reported, and any not-converged evidence pulls
// the joint below converged. This is the construction that makes an empty-observation
// narrow unwritable: verdict=converged is only reachable when BOTH inputs are converged
// (fleet_converge_cli converge_cli_receipt_join_revision), never from applied=0/drifted=0
// alone when the desired revision was never observed.
fn converge_verdict_meet(a: ConvergeVerdict, b: ConvergeVerdict) -> ConvergeVerdict {
  match a {
    VerdictAbsent => VerdictAbsent
    Drifted => match b {
      VerdictAbsent => VerdictAbsent
      Drifted => Drifted
      VerdictConverged => Drifted
    }
    VerdictConverged => b
  }
}

type ConvergeSlice
  = GunbcSlice
  | RunnerSlice
  | SessionsSlice

fn converge_slice_label(s: ConvergeSlice) -> String {
  match s {
    GunbcSlice => "gunbc"
    RunnerSlice => "runner"
    SessionsSlice => "sessions"
  }
}

type ConvergeApplyMode
  = FreshStandup
  | ExistingHostQuiescentReload

type ConvergeEffectiveSource
  = FileOnDisk
  | ProcessEffective

type ConvergeDoneCondition
  = EffectiveEqualsDesired
  | PinCoherentAndGreenPlaceMarker

type ConvergeLiveApplyPolicy {
  restart: String
  quiescent_window: Bool
  backstop: SpawnRetryBackstop
  reload_hook: String
}

type ConvergeNoOpPolicy
  = BlindApply
  | SkipApplyWhenConverged {
      effective_source: ConvergeEffectiveSource
      done: ConvergeDoneCondition
    }

type DagRootBinding
  = DeferToSubmodule { submodule_path: String }
  | HardPin { path: String }

type GunbcBinaryProvenance
  = PublishedArtifactPull { registry_uri: String, digest: String }
  | BuildBinIfAbsent { bin_name: String }

type GunbcBinaryProvenancePolicy {
  steady: GunbcBinaryProvenance
  bootstrap_fallback: GunbcBinaryProvenance
}

// PerSlotMemoryCap is the per-slot systemd drop-in/property mechanism (dropin_path x
// instance_glob x property x value), and the per_slot_tasks_max knob (a pids-controller
// count; desired value owned by gunbc.runner.runner_slot_allocation) rides it because the mechanism is property-generic — forking a
// parallel variant per property class would be the §2 duplication the shape exists to
// avoid. The variant name and its bytes_value field over-narrow to the memory axis that
// landed first: a §3 mislabel carried knowingly rather than a ~96-site mechanical rename
// inside this change. dissolve-on: the HostAxisBundle axis framework
// (gunbc.plans.host_convergence_circuit_residue P3), whose landing renames the variant to
// the mechanism it names (PerSlotUnitProperty, value_raw) in one motion.
type ConvergeTarget
  = SliceProperty { unit: String, property: String, apply_value: String, expected_effective: String }
  | PerSlotMemoryCap { dropin_path: String, instance_glob: String, property: String, bytes_value: String }
  | RunnerWidth { instance_glob: String }
  | VerifyOnlyCap { slice_unit: String, property: String }
  | GunbcPinnedTree {
      gunbc_root_env_key: String
      gunbc_root_path: String
      dag_root: DagRootBinding
      ctrl_checkout_path: String
      binary: GunbcBinaryProvenancePolicy
      pin_read_script: String
      green_place_marker: GreenPlaceReadinessMarker
      live_apply: ConvergeLiveApplyPolicy
    }
  | CodexRuntimeBundle { host_identity: HostIdentity }

type ConvergeKnob {
  slice: ConvergeSlice
  name: String
  desired: String
  target: ConvergeTarget
  apply_mode: ConvergeApplyMode
  no_op: ConvergeNoOpPolicy
}

data gunbc_host_converge_knob_apply_semantics_marker: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.host.host_converge",
    decl_name: "ConvergeKnob",
    field: WholeDeclaration
  }
}

data gunbc_host_converge_runner_sessions_coupling_marker: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.host.host_converge",
    decl_name: "HostConverge",
    field: WholeDeclaration
  }
}

type SessionsMembershipProbe
  = MembershipProbe { slice_cgroup: String, legacy_cgroup: String }
  | NoMembershipProbe

type HostConverge {
  identity: HostIdentity
  knobs: List<ConvergeKnob>
  membership: SessionsMembershipProbe
}

fn find_by_identity<T>(items: List<T>, identity: HostIdentity, key: fn(T) -> HostIdentity) -> T? {
  fold(
    items,
    init: none,
    f: fn(acc, item) {
      match acc {
        Present { value: _ } => acc
        Absent =>
          if key(item) == identity {
            Present { value: item }
          } else {
            none
          }
      }
    }
  )
}

// THE MONOMORPHIC LOOKUP EVERY HostConverge CONSUMER GOES THROUGH, and it exists because of a
// compiler deficit, not a taste one: a generic `-> T?` loses its Optional through inference, so a
// `match` directly over find_by_identity's result sees bare HostConverge and reports Present as a
// missing variant of it -- at the type declaration, nowhere near the call. Naming the return type
// once here restores it for every consumer.
//
// DISSOLVE-ON, NAMED AS A CAPABILITY RATHER THAN AN EVENT: inference carrying the Optional through
// a generic return position, so that a `match` directly over `find_by_identity`'s result sees
// `Optional<HostConverge>` rather than bare `HostConverge`. That capability must be SUFFICIENT FOR
// every consumer to match on such a call with no monomorphic wrapper standing in front of it,
// because the loss this fn pays for is corpus-wide -- three call sites had each privately authored
// the same workaround -- and a trigger at a smaller grain would retire the row while the deficit
// still bites. Nothing smaller retires it: not a clearer diagnostic pointing at the real call site,
// not a fix holding only where the caller annotates the type, and not this wrapper acquiring more
// consumers, which is growth of the workaround and not its dissolution.
fn host_converge_for_identity(hosts: List<HostConverge>, identity: HostIdentity) -> HostConverge? {
  find_by_identity(hosts, identity: identity, key: fn(h) { h.identity })
}

type ConvergePolicy
  // `hosts` are converged in place; `image_baked` are the knobs of hosts that boot a RAM image, owed to the
  // image build input and never applied by a converge (gunbc.fleet.fleet_host_backing ConvergeRealization).
  = ConvergePolicyDerived { hosts: List<HostConverge>, image_baked: List<HostConverge> }
  | ConvergePolicyUnsound { reason: String }

fn runner_instance_glob(host: HostIdentity) -> String {
  runner_host_slots_unit_glob(host: host) as String
}

fn converge_apply_mode_label(m: ConvergeApplyMode) -> String {
  match m {
    FreshStandup => "fresh_standup"
    ExistingHostQuiescentReload => "existing_host_quiescent"
  }
}

fn converge_no_op_policy_label(p: ConvergeNoOpPolicy) -> String {
  match p {
    BlindApply => "blind_apply"
    SkipApplyWhenConverged { effective_source: ProcessEffective, done: PinCoherentAndGreenPlaceMarker } =>
      "skip_process_pin_coherent_and_marker"
    SkipApplyWhenConverged { effective_source: _, done: _ } => "skip_when_converged"
  }
}

fn converge_effective_source_label(s: ConvergeEffectiveSource) -> String {
  match s {
    FileOnDisk => "file_on_disk"
    ProcessEffective => "process_effective"
  }
}

fn converge_done_condition_label(d: ConvergeDoneCondition) -> String {
  match d {
    EffectiveEqualsDesired => "effective_equals_desired"
    PinCoherentAndGreenPlaceMarker => "pin_coherent_and_green_place_marker"
  }
}

fn gunbc_green_place_marker_spec() -> GreenPlaceReadinessMarker {
  GreenPlaceReadinessMarker {
    path: gunbc_ctrl_green_place_marker_path,
    pin_prefix: gunbc_ctrl_green_place_marker_pin_prefix,
    timestamp_prefix: gunbc_ctrl_green_place_marker_ts_prefix,
  }
}

fn gunbc_dashboard_live_apply_policy() -> ConvergeLiveApplyPolicy {
  ConvergeLiveApplyPolicy {
    restart: "quiescent_window_systemd",
    quiescent_window: true,
    backstop: SpawnRetryBackstop {
      cadence: gunbc_spawn_retry_backstop_cadence,
      role: "acknowledged_auto_spawn_retry",
    },
    reload_hook: gunbc_ctrl_quiescent_reload_hook,
  }
}

fn gunbc_sha_triple_coherent(binary_pin: String, dag_pin: String, ctrl_pin: String) -> Bool {
  gunbc_pin_match(read_pin: binary_pin, desired_pin: ctrl_pin)
    && gunbc_pin_match(read_pin: dag_pin, desired_pin: ctrl_pin)
    && gunbc_pin_match(read_pin: binary_pin, desired_pin: dag_pin)
}

fn gunbc_binary_dag_skewed(binary_pin: String, dag_pin: String) -> Bool {
  binary_pin != "" && dag_pin != "" && gunbc_pin_skewed(host_pin: binary_pin, ctrl_pin: dag_pin)
}

fn gunbc_pinned_drift_receipt(
  reason: String,
  gunbc_root_path: String,
  target_sha: String,
  dag_binding: DagRootBinding,
) -> GunbcPinnedTreeDriftReceipt {
  GunbcPinnedTreeDriftReceipt {
    drift: true,
    reason: reason,
    desired_gunbc_root: gunbc_root_path,
    target_sha: target_sha,
    dag_binding_mode: dag_root_binding_mode(binding: dag_binding),
  }
}

fn gunbc_process_effective_converged(process_pin: String, ctrl_pin: String) -> Bool {
  gunbc_pin_match(read_pin: process_pin, desired_pin: ctrl_pin)
}

fn gunbc_green_place_marker_satisfied(marker_line: String, marker_pin: String, desired_pin: String) -> Bool {
  marker_line != ""
    && gunbc_pin_match(read_pin: marker_pin, desired_pin: desired_pin)
    && string_contains(s: marker_line, pattern: gunbc_ctrl_green_place_marker_ts_prefix)
}

fn gunbc_pinned_noop_satisfied(
  binary_pin: String,
  dag_pin: String,
  ctrl_pin: String,
  process_pin: String,
  marker_line: String,
  marker_pin: String,
) -> Bool {
  gunbc_sha_triple_coherent(binary_pin: binary_pin, dag_pin: dag_pin, ctrl_pin: ctrl_pin)
    && gunbc_process_effective_converged(process_pin: process_pin, ctrl_pin: ctrl_pin)
    && gunbc_green_place_marker_satisfied(marker_line: marker_line, marker_pin: marker_pin, desired_pin: ctrl_pin)
}

fn dag_root_binding_mode(binding: DagRootBinding) -> String {
  match binding {
    DeferToSubmodule { submodule_path: _ } => "defer_submodule"
    HardPin { path: _ } => "hard_pin"
  }
}

fn dag_root_binding_path(binding: DagRootBinding) -> String {
  match binding {
    DeferToSubmodule { submodule_path: sp } => sp
    HardPin { path: p } => p
  }
}

fn gunbc_pinned_binary_provenance_policy() -> GunbcBinaryProvenancePolicy {
  GunbcBinaryProvenancePolicy {
    steady: PublishedArtifactPull {
      registry_uri: gunbc_fleet_pinned_binary_registry,
      digest: gunbc_fleet_pinned_binary_digest,
    },
    bootstrap_fallback: BuildBinIfAbsent { bin_name: gunbc_fleet_pinned_binary_name },
  }
}

fn gunbc_apply_mode_for_host(host: HostIdentity) -> ConvergeApplyMode {
  if host == operator_host_srv3 { FreshStandup } else { ExistingHostQuiescentReload }
}

fn gunbc_pinned_noop_policy() -> ConvergeNoOpPolicy {
  SkipApplyWhenConverged {
    effective_source: ProcessEffective,
    done: PinCoherentAndGreenPlaceMarker,
  }
}

fn legacy_converge_knob(slice: ConvergeSlice, name: String, desired: String, target: ConvergeTarget) -> ConvergeKnob {
  ConvergeKnob {
    slice: slice,
    name: name,
    desired: desired,
    target: target,
    apply_mode: ExistingHostQuiescentReload,
    no_op: BlindApply,
  }
}

fn slice_numeric_knob(slice: ConvergeSlice, name: String, unit: String, property: String, value: Int) -> ConvergeKnob {
  let v = to_string(value)
  legacy_converge_knob(
    slice: slice,
    name: name,
    desired: v,
    target: SliceProperty { unit: unit, property: property, apply_value: v, expected_effective: v }
  )
}

fn gunbc_pinned_tree_knob(host: HostIdentity) -> ConvergeKnob {
  ConvergeKnob {
    slice: GunbcSlice,
    name: "pinned_tree_sha",
    desired: gunbc_pinned_tree_desired_label,
    target: GunbcPinnedTree {
      gunbc_root_env_key: gunbc_root_env_key,
      gunbc_root_path: gunbc_host_gunbc_root_path,
      dag_root: DeferToSubmodule { submodule_path: gunbc_dag_root_submodule_path },
      ctrl_checkout_path: gunbc_host_ctrl_checkout_path,
      binary: gunbc_pinned_binary_provenance_policy(),
      pin_read_script: gunbc_ctrl_read_pin_script,
      green_place_marker: gunbc_green_place_marker_spec(),
      live_apply: gunbc_dashboard_live_apply_policy(),
    },
    apply_mode: gunbc_apply_mode_for_host(host: host),
    no_op: gunbc_pinned_noop_policy(),
  }
}

fn gunbc_pinned_tree_knobs(host: HostIdentity) -> List<ConvergeKnob> {
  [gunbc_pinned_tree_knob(host: host)]
}

// RECURRING reconcile for the pinned Codex provider-runtime bundle — absent materialize, wrong
// identity replace, present noop. Registered on every fleet compute host in fleet_converge_policy;
// EXECUTION AUTHORITY is gunbc.fleet.fleet_converge_cli converge_provider_runtime_codex_receipt
// (ProvisionCodexRuntime via realize_provision_codex_runtime), not host_converge_realize
// interpret_converge_knob — slice1/knob-frontier routes bypass converge_apply today. host_standup
// P1c remains assimilation-time ensure.

fn codex_runtime_bundle_knob(host: HostIdentity) -> ConvergeKnob {
  legacy_converge_knob(
    slice: GunbcSlice,
    name: "codex_runtime_bundle",
    desired: codex_runtime_version_identity_marker(),
    target: CodexRuntimeBundle { host_identity: host },
  )
}

fn codex_runtime_bundle_knobs(host: HostIdentity) -> List<ConvergeKnob> {
  [codex_runtime_bundle_knob(host: host)]
}

// THE CPU KNOB RIDES THE PER-SLOT MECHANISM RATHER THAN FORKING A VARIANT FOR IT. ConvergeTarget's
// PerSlotMemoryCap is (dropin_path x instance_glob x property x value) and is property-generic --
// per_slot_tasks_max already rides it with a pids-controller count -- so a CPU rider needs no new
// target. Its own declaration says forking a parallel variant per property class would be the
// DESIGN 2 duplication the shape exists to avoid, and declines the ~96-site rename to
// PerSlotUnitProperty/value_raw in favour of the HostAxisBundle P3 lane that owns it. This rider
// does not pre-empt that rename; it is the third value to arrive at a field still named
// bytes_value, which strengthens the case that lane already carries rather than adding a new one.
//
// EVERY REPRESENTABLE BOUNDARY EMITS A KNOB, INCLUDING THE ONE THAT MEANS NO CEILING. An arm that
// converges successfully while realizing nothing is the fail-open review 57675 found; NoCpuCeiling
// is not that arm, because "no ceiling" is a state a unit can fail to be in (one that was once
// given a quota keeps it), so it is represented as the affirmative empty assignment `CPUQuota=`
// that systemd reads as unset, through the same drop-in the ceiling would use.
//
// A KNOB IS THE DESIRED REPRESENTATION, NOT ITS APPLICATION OR READBACK (review F-R2, 2026-09-19).
// The write and the readback of this drop-in belong to gunbc.runner.runner_host_file_converge, the
// one writer of root-evaluated runner files (the fleet-converge workflow's runner_host_file_converge
// mode, as the administrator principal): it renders 60-fleet-cpu.conf from the same
// per_runner_cpu_boundary this knob reads, and judges every slot's CPUQuotaPerSecUSec against it.
// The deploy apply authority here does not also write it -- two writers of one root file is the
// fork the operator privilege hold (2026-08-13) already rules out for this principal.
fn runner_cpu_boundary_knobs(h: RunnerHostDeployment, glob: String) -> List<ConvergeKnob> {
  let value = runner_cpu_boundary_directive_value(b: h.per_runner_cpu_boundary)
  [
    legacy_converge_knob(
      slice: RunnerSlice,
      name: "per_slot_cpu_quota",
      desired: systemd_directive_value_wire(value: value),
      target: PerSlotMemoryCap {
        dropin_path: gunbc_runner_per_slot_cpu_dropin_path,
        instance_glob: glob,
        property: systemd_cpu_quota_property,
        bytes_value: systemd_directive_value_wire(value: value),
      }
    ),
  ]
}

fn runner_cpu_boundary_directive_value(b: RunnerCpuBoundary) -> SystemdDirectiveValue {
  match b {
    CapacityQuota { threads: t } => DirectiveCpuTime { threads: t }
    NoCpuCeiling => DirectiveReset
  }
}

fn runner_host_knobs(h: RunnerHostDeployment) -> List<ConvergeKnob> {
  let glob = runner_instance_glob(host: h.identity)
  concat(runner_cpu_boundary_knobs(h: h, glob: glob), [
    slice_numeric_knob(
      slice: RunnerSlice,
      name: "runner_slice_cap_bytes",
      unit: gunbc_runner_slot_unit_placeholder,
      property: systemd_memory_max_property,
      value: byte_size_count(b: h.runner_slice_cap)
    ),
    legacy_converge_knob(
      slice: RunnerSlice,
      name: "per_slot_memory_max_bytes",
      desired: to_string(byte_size_count(b: h.per_runner_memory_cap)),
      target: PerSlotMemoryCap {
        dropin_path: gunbc_runner_per_slot_dropin_path,
        instance_glob: glob,
        property: systemd_memory_max_property,
        bytes_value: to_string(byte_size_count(b: h.per_runner_memory_cap)),
      }
    ),
    legacy_converge_knob(
      slice: RunnerSlice,
      name: "per_slot_memory_swap_max_bytes",
      desired: to_string(byte_size_count(b: h.per_runner_memory_swap_cap)),
      target: PerSlotMemoryCap {
        dropin_path: gunbc_runner_per_slot_swap_dropin_path,
        instance_glob: glob,
        property: systemd_memory_swap_max_property,
        bytes_value: to_string(byte_size_count(b: h.per_runner_memory_swap_cap)),
      }
    ),
    legacy_converge_knob(
      slice: RunnerSlice,
      name: "per_slot_tasks_max",
      desired: to_string(h.per_runner_tasks_max),
      target: PerSlotMemoryCap {
        dropin_path: gunbc_runner_per_slot_tasks_dropin_path,
        instance_glob: glob,
        property: systemd_tasks_max_property,
        bytes_value: to_string(h.per_runner_tasks_max),
      }
    ),
    legacy_converge_knob(
      slice: RunnerSlice,
      name: "per_slot_memory_high_bytes",
      desired: to_string(byte_size_count(b: h.per_runner_memory_high_cap)),
      target: PerSlotMemoryCap {
        dropin_path: gunbc_runner_per_slot_high_dropin_path,
        instance_glob: glob,
        property: systemd_memory_high_property,
        bytes_value: to_string(byte_size_count(b: h.per_runner_memory_high_cap)),
      }
    ),
    slice_numeric_knob(
      slice: RunnerSlice,
      name: "cpu_weight",
      unit: gunbc_runner_slot_unit_placeholder,
      property: systemd_cpu_weight_property,
      value: workload_class_cpu_weight(wc: h.workload_class)
    ),
    legacy_converge_knob(
      slice: RunnerSlice,
      name: "runner_count",
      desired: to_string(h.runner_count),
      target: RunnerWidth { instance_glob: glob }
    ),
  ])
}

// pressure_value was named kill_value: it renders whatever the POLICY says,
// which is no longer necessarily kill. The old name read as a constant, and
// that is how the stale `desired: "true"` label survived the policy flip to
// ManagedOomAuto -- apply_value was already derived, the label was not.
fn session_host_knobs(slice_max: ByteSize, slice_high: ByteSize, per_session: ByteSize) -> List<ConvergeKnob> {
  let pressure_value = managed_oom_action_value(a: gunbc_oomd_sessions_policy.managed_oom_memory_pressure)
  let pressure_kill_desired = if pressure_is_kill(a: gunbc_oomd_sessions_policy.managed_oom_memory_pressure) { "true" } else { "false" }
  let pct = to_string(percent_count(p: gunbc_oomd_sessions_pressure_limit))
  [
    slice_numeric_knob(
      slice: SessionsSlice,
      name: "slice_max_bytes",
      unit: gunbc_oomd_sessions_slice,
      property: systemd_memory_max_property,
      value: byte_size_count(b: slice_max)
    ),
    slice_numeric_knob(
      slice: SessionsSlice,
      name: "slice_high_bytes",
      unit: gunbc_oomd_sessions_slice,
      property: systemd_memory_high_property,
      value: byte_size_count(b: slice_high)
    ),
    legacy_converge_knob(
      slice: SessionsSlice,
      name: "per_session_max_bytes",
      desired: to_string(byte_size_count(b: per_session)),
      target: VerifyOnlyCap {
        slice_unit: gunbc_oomd_sessions_slice,
        property: systemd_memory_max_property,
      }
    ),
    legacy_converge_knob(
      slice: SessionsSlice,
      name: "oom_pressure_kill",
      desired: pressure_kill_desired,
      target: SliceProperty {
        unit: gunbc_oomd_sessions_slice,
        property: oomd_managed_oom_memory_pressure_property,
        apply_value: pressure_value,
        expected_effective: pressure_value,
      }
    ),
    legacy_converge_knob(
      slice: SessionsSlice,
      name: "oom_pressure_limit_pct",
      desired: pct,
      target: SliceProperty {
        unit: gunbc_oomd_sessions_slice,
        property: oomd_managed_oom_memory_pressure_limit_property,
        apply_value: concat(pct, "%"),
        expected_effective: to_string(managed_oom_pressure_limit_show_value(p: gunbc_oomd_sessions_pressure_limit)),
      }
    ),
    slice_numeric_knob(
      slice: SessionsSlice,
      name: "cpu_weight",
      unit: gunbc_oomd_sessions_slice,
      property: systemd_cpu_weight_property,
      value: workload_class_cpu_weight(wc: InteractiveLatencySensitive)
    ),
  ]
}

// ONE KNOB LIST WAS BEING WRITTEN TO EVERY HOST, AND THAT IS THE SHARP END OF THE AUTHORITY FORK.
// The fleet-wide Regime-2 row carried a single 21474836480-byte aggregate, and this function handed
// it to map(hosts, ...) below -- so a converge would have set sessions.slice MemoryMax to 20 GiB on
// every host in the plan. srv1's live sessions.slice cap is 137438953472 and its slice has already
// peaked at 55216033792, so the projection would have driven the cap to roughly 40% of an
// already-observed peak on a host running 18 sessions. It was never applied, so this was latent
// rather than an incident.
//
// The knobs are now derived per host from the reservation that host actually owes.
//
// THE THREE EMPTY ANSWERS WERE ONE EMPTY LIST, AND THEY ARE NOT THE SAME FACT. This function
// returned [] for a host that legitimately owes no session knobs, for a host whose reservation is
// UNKNOWN, and for a fleet with no admission ceiling -- three states with three remedies, rendered
// identically. On the current plan path that was quiet: an unestablished host refuses upstream in
// host_deployment_standing and never reaches a converge target. But the function is total and
// public, so the next direct caller receives an empty knob list and cannot tell "nothing to write
// here" from "I could not work out what to write" -- the empty-observation narrow DESIGN names,
// the absorbing fallback's mirror, strictly worse than a widen because a narrow is silently
// uncovered rather than merely expensive.
//
// The standing is returned instead, so a new caller must decide. The plan path is unchanged: it
// converts the standing back to knobs and a non-derived standing contributes none.
type SessionKnobStanding
  = SessionKnobsDerived { knobs: List<ConvergeKnob> }
  | SessionKnobsNotOwed { cause: String }
  | SessionKnobsUngrounded { cause: String }

fn session_knob_standing_for(host: HostIdentity) -> SessionKnobStanding {
  match session_reservation_bytes(host: host) {
    ReservationBytesNotApplicable =>
      SessionKnobsNotOwed {
        cause: "this host carries no sessions.slice, so it owes no session knobs and its existing configuration is left untouched",
      }
    ReservationBytesUnestablished { cause: why } =>
      SessionKnobsUngrounded {
        cause: concat("the session reservation for this host is unestablished, so no slice_max can be grounded: ", why),
      }
    ReservationBytes { bytes: agg_bytes } =>
      match session_slice_memory_high_for(host: host) {
        Absent =>
          SessionKnobsUngrounded {
            cause: "sessions.slice MemoryHigh is not authored for this host, so a Max-only converge would leave the live High as a second authority",
          }
        Present { value: high } =>
          match session_admission_oomd_ceiling(p: gunbc_session_admission_policy) {
            Absent =>
              SessionKnobsUngrounded {
                cause: "the fleet admission policy declares no oomd eviction ceiling, so the per-session half of the slice cannot be written",
              }
            Present { value: ceiling } =>
              SessionKnobsDerived { knobs: session_host_knobs(slice_max: agg_bytes, slice_high: high, per_session: ceiling) }
          }
      }
  }
}

fn session_knobs_for(host: HostIdentity) -> List<ConvergeKnob> {
  match session_knob_standing_for(host: host) {
    SessionKnobsDerived { knobs: ks } => ks
    SessionKnobsNotOwed { cause: _ } => []
    SessionKnobsUngrounded { cause: _ } => []
  }
}

fn sessions_membership_probe(session_knobs: List<ConvergeKnob>) -> SessionsMembershipProbe {
  if session_knobs.length() > 0 {
    MembershipProbe {
      slice_cgroup: concat(concat(gunbc_cgroup_v2_root, "/"), gunbc_oomd_sessions_slice),
      legacy_cgroup: concat(concat(gunbc_cgroup_v2_root, "/"), gunbc_sessions_legacy_parent_slice),
    }
  } else {
    NoMembershipProbe
  }
}

fn user_manager_instance_unit() -> String {
  join(["user@", to_string(gunbc_service_uid), ".service"], "")
}

fn user_manager_backstop_knobs_from_slots(slots: Nat) -> List<ConvergeKnob> {
  let work_max = user_work_slice_memory_max_of(slots: slots)
  let backstop = user_slice_backstop_memory_max_of(work_slice_max: work_max)
  [
    slice_numeric_knob(
      slice: GunbcSlice,
      name: "user_manager_memory_max_bytes",
      unit: user_manager_instance_unit(),
      property: systemd_memory_max_property,
      value: byte_size_count(b: backstop)
    ),
    slice_numeric_knob(
      slice: GunbcSlice,
      name: "user_manager_memory_swap_max_bytes",
      unit: user_manager_instance_unit(),
      property: systemd_memory_swap_max_property,
      value: byte_size_count(b: user_slice_backstop_memory_swap_max())
    ),
  ]
}

type UserManagerBackstop
  = UserManagerBackstopNotOwed
  | UserManagerBackstopDerived { knobs: List<ConvergeKnob> }
  | UserManagerBackstopRefused { cause: String }

// THE BACKSTOP IS OWED WHERE THE --user WORK IS PLACED, not on every runner host.
// NotPlaced is not owed. Unmeasured and a non-natural belt concurrent are refusals: the
// fleet converge policy goes unsound rather than writing no knobs (review 79929).
fn user_manager_backstop_for(host: HostIdentity) -> UserManagerBackstop {
  match host_served_deployment_claim(host: host) {
    ServedDeploymentNotPlaced => UserManagerBackstopNotOwed
    ServedDeploymentClaimUnmeasured { cause } => UserManagerBackstopRefused { cause: cause }
    ServedDeploymentClaimResolved { memory: _ } =>
      match user_work_pool_slots() {
        UserWorkPoolSlotsDerived { slots } =>
          UserManagerBackstopDerived { knobs: user_manager_backstop_knobs_from_slots(slots: slots) }
      }
  }
}

fn approval_broker_runtime_cap_knobs() -> List<ConvergeKnob> {
  [
    slice_numeric_knob(
      slice: GunbcSlice,
      name: "approval_broker_memory_max_bytes",
      unit: gunbc_approval_broker_slice_unit_name as String,
      property: systemd_memory_max_property,
      value: byte_size_count(b: approval_broker_slice_memory_max)
    ),
    slice_numeric_knob(
      slice: GunbcSlice,
      name: "approval_broker_memory_high_bytes",
      unit: gunbc_approval_broker_slice_unit_name as String,
      property: systemd_memory_high_property,
      value: byte_size_count(b: approval_broker_slice_memory_high)
    ),
  ]
}

type ApprovalBrokerRuntimeCaps
  = ApprovalBrokerRuntimeCapsNotOwed
  | ApprovalBrokerRuntimeCapsDerived { knobs: List<ConvergeKnob> }
  | ApprovalBrokerRuntimeCapsRefused { cause: String }

// SAME PLACEMENT GATE AS THE USER-MANAGER BACKSTOP: the broker slice is a prod-role singleton,
// so a runner-only host owes no MemoryMax/High converge for it. The live 18/20 GiB figures are
// a /run/systemd/system.control set-property drop-in; desired is the model 16/14 GiB.
fn approval_broker_runtime_caps_for(host: HostIdentity) -> ApprovalBrokerRuntimeCaps {
  match host_served_deployment_claim(host: host) {
    ServedDeploymentNotPlaced => ApprovalBrokerRuntimeCapsNotOwed
    ServedDeploymentClaimUnmeasured { cause } => ApprovalBrokerRuntimeCapsRefused { cause: cause }
    ServedDeploymentClaimResolved { memory: _ } =>
      ApprovalBrokerRuntimeCapsDerived { knobs: approval_broker_runtime_cap_knobs() }
  }
}

type SliceControlCaps {
  unit: NonEmptyStr
  memory_max: ByteSize
  memory_high: ByteSize
}

// ONE STANDING FOR THE LIVE_DEPLOY SLICE-CONTROL MEMBER. Mapping Ungrounded / Unestablished /
// missing High / ApprovalBrokerRuntimeCapsRefused to [] made "cannot derive" look like "not
// owed", so apply_slice_control_converge_steps emitted no steps and live_deploy kept mutating
// other members (review 80054 side-chat / clever-crane-830). Only a genuine absent placement
// is NotOwed. A refused half refuses the whole member: converging one slice while leaving the
// other hand drop-in would be a second authority.
type SliceControl
  = SliceControlNotOwed
  | SliceControlDerived { caps: FreeSemigroup<SliceControlCaps> }
  | SliceControlRefused { cause: String }

fn join_slice_control(left: SliceControl, right: SliceControl) -> SliceControl {
  match left {
    SliceControlRefused { cause: c } => SliceControlRefused { cause: c }
    SliceControlNotOwed => right
    SliceControlDerived { caps: a } =>
      match right {
        SliceControlRefused { cause: c } => SliceControlRefused { cause: c }
        SliceControlNotOwed => SliceControlDerived { caps: a }
        SliceControlDerived { caps: b } => SliceControlDerived { caps: non_empty_append(left: a, right: b) }
      }
  }
}

fn session_slice_control_for(host: HostIdentity) -> SliceControl {
  match session_knob_standing_for(host: host) {
    SessionKnobsNotOwed { cause: _ } => SliceControlNotOwed
    SessionKnobsUngrounded { cause } => SliceControlRefused { cause: cause }
    SessionKnobsDerived { knobs: _ } =>
      match session_reservation_bytes(host: host) {
        ReservationBytesNotApplicable =>
          SliceControlRefused {
            cause: "session knobs derived but session reservation is not applicable",
          }
        ReservationBytesUnestablished { cause } => SliceControlRefused { cause: cause }
        ReservationBytes { bytes: max } =>
          match session_slice_memory_high_for(host: host) {
            Absent =>
              SliceControlRefused {
                cause: "sessions.slice MemoryHigh is not authored for this host, so a Max-only converge would leave the live High as a second authority",
              }
            Present { value: high } =>
              SliceControlDerived {
                caps: non_empty_singleton(
                  item: SliceControlCaps {
                    unit: gunbc_oomd_sessions_slice,
                    memory_max: max,
                    memory_high: high,
                  }
                )
              }
          }
      }
  }
}

fn approval_broker_slice_control_for(host: HostIdentity) -> SliceControl {
  match approval_broker_runtime_caps_for(host: host) {
    ApprovalBrokerRuntimeCapsNotOwed => SliceControlNotOwed
    ApprovalBrokerRuntimeCapsRefused { cause } => SliceControlRefused { cause: cause }
    ApprovalBrokerRuntimeCapsDerived { knobs: _ } =>
      SliceControlDerived {
        caps: non_empty_singleton(
          item: SliceControlCaps {
            unit: gunbc_approval_broker_slice_unit_name,
            memory_max: approval_broker_slice_memory_max,
            memory_high: approval_broker_slice_memory_high,
          }
        )
      }
  }
}

fn slice_control_caps_for(host: HostIdentity) -> SliceControl {
  join_slice_control(
    left: session_slice_control_for(host: host),
    right: approval_broker_slice_control_for(host: host),
  )
}

// THE SESSIONS SLICE'S CPU CAP RIDES ITS CONTROL SEQUENCE AND IS OWED, NOT OPTIONAL. The sessions'
// CPU share is their memory share, derived with the runner slots' quota in one fold
// (gunbc.ci.ci_runner_placement host_cpu_allocation; operator ruling 2026-10-14, "slots need a CPU
// cap"). The control sequence REVERTS the unit before setting it, so a sessions slice converged
// without its CPU cap would silently drop whatever cap it held: a sessions derivation that cannot
// produce the cap refuses the whole member, before any mutate, exactly as a memory half that cannot
// be derived does (slice_control_caps_for). The approval-broker slice has no CPU allocation in the
// model; that is a different fact, carried by a different arm, not an absent field.
type SliceControlUnit
  = SessionsSliceControl { caps: SliceControlCaps, cpu_quota: HardwareThreadCount }
  | UncappedSliceControl { caps: SliceControlCaps }

// THE ROSTER IS A FREE SEMIGROUP, NOT A LIST: nonemptiness is CONSTRUCTED, not validated
// (DESIGN §5 "correctness by construction, not validation"; §3b Cardinality/absence, which names
// std.algebra::FreeSemigroup as the canonical non-empty carrier under ruling
// nonemptiness_is_constructed_or_proved). A Derived plan that carried zero units was the whole
// fail-open: downstream, units: [] became an empty script, and an empty script applies cleanly and
// reports nothing -- the quietest possible way to not converge a host. `head: T` is the wall: this
// arm cannot be built empty, so no consumer needs an emptiness guard and no guard can be dropped.
type SliceControlPlan
  = SliceControlPlanNotOwed
  | SliceControlPlanDerived { units: FreeSemigroup<SliceControlUnit> }
  | SliceControlPlanRefused { cause: String }

type SessionsSliceCpuQuota
  = SessionsSliceCpuQuotaDerived { threads: HardwareThreadCount }
  | SessionsSliceCpuQuotaRefused { cause: String }

fn sessions_slice_cpu_quota_for(host: HostIdentity) -> SessionsSliceCpuQuota {
  match runner_host_deployment_for(p: runner_deployment_plan(), host: host) {
    HostRunnerDeploymentRefused { refusal: r } =>
      SessionsSliceCpuQuotaRefused {
        cause: concat("the sessions slice is owed a CPU cap and the host CPU allocation that derives it refuses: ", host_deployment_refusal_text(c: r.cause)),
      }
    HostRunnerDeploymentDerived { deployment: d } =>
      if hardware_thread_count_value(t: d.sessions_cpu_cap) == 0 {
        SessionsSliceCpuQuotaRefused { cause: "the sessions slice is owed a CPU cap and its derived share is zero threads, which systemd would read as no CPU at all" }
      } else {
        SessionsSliceCpuQuotaDerived { threads: d.sessions_cpu_cap }
      }
  }
}

// One unit, given the host's sessions CPU standing; the sessions unit is the one whose name is
// gunbc.oomd_install gunbc_oomd_sessions_slice, the same authority slice_control_caps_for builds it from.
fn slice_control_unit_of(caps: SliceControlCaps, cpu: SessionsSliceCpuQuota) -> SliceControlPlan {
  if (caps.unit as String) == (gunbc_oomd_sessions_slice as String) {
    match cpu {
      SessionsSliceCpuQuotaRefused { cause: c } => SliceControlPlanRefused { cause: c }
      SessionsSliceCpuQuotaDerived { threads: t } =>
        SliceControlPlanDerived { units: non_empty_singleton(item: SessionsSliceControl { caps: caps, cpu_quota: t }) }
    }
  } else {
    SliceControlPlanDerived { units: non_empty_singleton(item: UncappedSliceControl { caps: caps }) }
  }
}

// THE FOLD STARTS FROM THE HEAD, NOT FROM AN EMPTY ROSTER. `init: SliceControlPlanDerived { units: [] }`
// was the hole in another dress: it made the empty plan the fold's identity, so a caps list that
// folded zero times -- or a fold that was skipped -- reported a well-formed plan with nothing in it.
// fold_list over cs.tail seeds the accumulator from cs.head, so every reachable accumulator is a
// plan whose roster already has a member.
fn slice_control_plan_of(control: SliceControl, cpu: SessionsSliceCpuQuota) -> SliceControlPlan {
  match control {
    SliceControlNotOwed => SliceControlPlanNotOwed
    SliceControlRefused { cause: c } => SliceControlPlanRefused { cause: c }
    SliceControlDerived { caps: cs } =>
      fold_list(
        xs: cs.tail,
        empty: slice_control_unit_of(caps: cs.head, cpu: cpu),
        cons: fn(acc, c) {
          match acc {
            SliceControlPlanRefused { cause: _ } => acc
            SliceControlPlanNotOwed => acc
            SliceControlPlanDerived { units: us } =>
              match slice_control_unit_of(caps: c, cpu: cpu) {
                SliceControlPlanRefused { cause: why } => SliceControlPlanRefused { cause: why }
                SliceControlPlanNotOwed => acc
                SliceControlPlanDerived { units: more } =>
                  SliceControlPlanDerived { units: non_empty_append(left: us, right: more) }
              }
          }
        }
      )
  }
}

fn slice_control_plan_for(host: HostIdentity) -> SliceControlPlan {
  slice_control_plan_of(control: slice_control_caps_for(host: host), cpu: sessions_slice_cpu_quota_for(host: host))
}

fn host_converge_of(h: RunnerHostDeployment, session_knobs: List<ConvergeKnob>, backstop_knobs: List<ConvergeKnob>) -> HostConverge {
  HostConverge {
    identity: h.identity,
    knobs: concat(
      concat(
        concat(
          concat(gunbc_pinned_tree_knobs(host: h.identity), runner_host_knobs(h: h)),
          session_knobs,
        ),
        backstop_knobs,
      ),
      codex_runtime_bundle_knobs(host: h.identity),
    ),
    membership: sessions_membership_probe(session_knobs: session_knobs),
  }
}

// CONVERGENCE IS A HOST-TARGETED TRANSACTION, so it selects the hosts that derived rather than
// refusing the fleet because one host did not. The shape this replaces widened a fleet-level
// PlanUnsound into ConvergePolicyUnsound before any host was chosen -- so srv2's unestablished
// reservation would have blocked converging srv1, srv3 and srv4, none of which depend on it.
//
// A refused host contributes NO converge target: it is not converged, and not silently converged
// with a guessed size either. The refused roster stays readable through
// fleet_deployment_completion for a consumer that needs to know the fleet is incomplete.
type FleetConvergeAcc
  = FleetConvergeHosts { hosts: List<HostConverge> }
  | FleetConvergeUnsound { reason: String }

fn fleet_converge_policy_from(plan: RunnerDeploymentPlan, image_baked: RunnerDeploymentPlan) -> ConvergePolicy {
  match converge_hosts_of_plan(plan: plan) {
    FleetConvergeUnsound { reason } => ConvergePolicyUnsound { reason: reason }
    FleetConvergeHosts { hosts: applied } =>
      match converge_hosts_of_plan(plan: image_baked) {
        FleetConvergeUnsound { reason } => ConvergePolicyUnsound { reason: reason }
        FleetConvergeHosts { hosts: baked } => ConvergePolicyDerived { hosts: applied, image_baked: baked }
      }
  }
}

fn converge_hosts_of_plan(plan: RunnerDeploymentPlan) -> FleetConvergeAcc {
  fold(plan.hosts, init: FleetConvergeHosts { hosts: [] }, f: (acc, st) => match acc {
    FleetConvergeUnsound { reason } => FleetConvergeUnsound { reason: reason }
    FleetConvergeHosts { hosts } =>
      match st {
        HostRunnerDeploymentRefused { refusal: _ } => FleetConvergeHosts { hosts: hosts }
        HostRunnerDeploymentDerived { deployment: h } =>
          match user_manager_backstop_for(host: h.identity) {
            UserManagerBackstopRefused { cause } => FleetConvergeUnsound { reason: cause }
            UserManagerBackstopNotOwed =>
              FleetConvergeHosts {
                hosts: concat(hosts, [host_converge_of(h: h, session_knobs: session_knobs_for(host: h.identity), backstop_knobs: [])]),
              }
            UserManagerBackstopDerived { knobs } =>
              match approval_broker_runtime_caps_for(host: h.identity) {
                ApprovalBrokerRuntimeCapsRefused { cause } => FleetConvergeUnsound { reason: cause }
                ApprovalBrokerRuntimeCapsNotOwed =>
                  FleetConvergeHosts {
                    hosts: concat(hosts, [host_converge_of(h: h, session_knobs: session_knobs_for(host: h.identity), backstop_knobs: knobs)]),
                  }
                ApprovalBrokerRuntimeCapsDerived { knobs: broker } =>
                  FleetConvergeHosts {
                    hosts: concat(hosts, [host_converge_of(h: h, session_knobs: session_knobs_for(host: h.identity), backstop_knobs: concat(knobs, broker))]),
                  }
              }
          }
      }
  })
}

fn fleet_converge_policy() -> ConvergePolicy {
  fleet_converge_policy_from(plan: runner_deployment_plan(), image_baked: runner_image_baked_deployment_plan())
}
