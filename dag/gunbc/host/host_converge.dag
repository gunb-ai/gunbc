data gunbc_sessions_legacy_parent_slice: String = "system.slice"

// THE UNIT NAME AND ITS DROP-IN DIRECTORY COME FROM gunbc.runner.runner_unit AND ARE NO LONGER SPELLED
// HERE. Each of these six rows carried the template name as a literal -- four by embedding it in a
// path -- so the drop-in directory agreed with its unit by convention across six independent
// strings. Renaming the unit would have left four drop-ins writing into a directory systemd no
// longer reads, with nothing to refuse it: a drop-in in the wrong directory is not an error, it is
// simply never applied, so the caps would silently stop being enforced while every row here still
// read correctly.
//
// The ROW NAMES stay, because the drop-in FILE names -- which knob is 20, which is 30 -- are this
// module's own fact and not the unit contract's.
data gunbc_runner_unit_template: String = runner_unit_template_name as String
data gunbc_runner_all_slots_unit_glob: String = runner_all_slots_unit_glob as String
data gunbc_runner_per_slot_dropin_path: String = runner_unit_dropin_path(file_name: "20-fleet-width.conf" as NonEmptyStr) as String
data gunbc_runner_per_slot_swap_dropin_path: String = runner_unit_dropin_path(file_name: "30-fleet-swap.conf" as NonEmptyStr) as String
data gunbc_runner_per_slot_cpu_dropin_path: String = runner_unit_dropin_path(file_name: "60-fleet-cpu.conf" as NonEmptyStr) as String
data gunbc_runner_per_slot_high_dropin_path: String = runner_unit_dropin_path(file_name: "40-fleet-high.conf" as NonEmptyStr) as String
data gunbc_runner_per_slot_tasks_dropin_path: String = runner_unit_dropin_path(file_name: "50-fleet-tasks.conf" as NonEmptyStr) as String
data gunbc_runner_control_dropin_dir_prefix: String = "/etc/systemd/system.control/"
// `systemctl set-property --runtime` writes here (systemd 255); it shadows the persistent
// /etc/systemd/system.control drop-in until reboot or `systemctl revert`. Live 18/20 GiB on
// gunbc-approval-broker.slice (2026-09-30) is that runtime residue: no row produces it.
data gunbc_runtime_system_control_dropin_dir_prefix: String = "/run/systemd/system.control/"
data gunbc_runner_slot_unit_placeholder: NonEmptyStr = "system-actions-runner.slice"

data gunbc_root_env_key: String = "GUNBC_ROOT"

data gunbc_dag_root_submodule_path: String = "third_party/gunbc"

data gunbc_host_ctrl_checkout_path: String = "$HOME/ctrl"

data gunbc_host_gunbc_root_path: String = "$HOME/.local/share/gunbc/pinned"

data gunbc_pinned_tree_desired_label: String = "ctrl:third_party/gunbc"

data gunbc_fleet_pinned_binary_registry: String = "ghcr.io/gunb-ai/gunbc/bootstrap"

data gunbc_fleet_pinned_binary_digest: String = "sha256:BOOTSTRAP_DIGEST_PLACEHOLDER"

data gunbc_fleet_pinned_binary_digest_marker: Disposition = Scaffold {
